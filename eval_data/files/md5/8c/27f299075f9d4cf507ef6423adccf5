147": [{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Counts specific integer triples from a generated sequence whose sum is a multiple of 3.\n    It first generates array 'a', then counts elements by their remainder modulo 3, and finally calculates combinations.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    if n < 3:\n        return 0\n\n    # Generate array 'a' where a[i] = i * i - i + 1 for 1 <= i <= n.\n    a_values = []\n    for i in range(1, n + 1):\n        a_values.append(i * i - i + 1)\n\n    # Count occurrences of elements with remainder 0 and 1 modulo 3.\n    # Note: a[x] % 3 will never be 2.\n    remainder_counts = {0: 0, 1: 0}\n    for val in a_values:\n        remainder_counts[val % 3] += 1\n    \n    count_rem_0 = remainder_counts.get(0, 0)\n    count_rem_1 = remainder_counts.get(1, 0)\n\n    # Calculate combinations for triples (0, 0, 0) and (1, 1, 1).\n    # The sum of three elements is a multiple of 3 only if (rem_x + rem_y + rem_z) % 3 == 0.\n    total_triples = 0\n    \n    # Case 1: (0, 0, 0) - all three elements have remainder 0 mod 3.\n    if count_rem_0 >= 3:\n        total_triples += (count_rem_0 * (count_rem_0 - 1) * (count_rem_0 - 2)) // 6\n    \n    # Case 2: (1, 1, 1) - all three elements have remainder 1 mod 3.\n    if count_rem_1 >= 3:\n        total_triples += (count_rem_1 * (count_rem_1 - 1) * (count_rem_1 - 2)) // 6\n            \n    return total_triples", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/147", "solution": "import math\nfrom collections import defaultdict\ndef combinations(n: int, k: int) -> int:\n    \"\"\"Calculates n choose k (C(n, k)). Returns 0 if k < 0 or k > n.\"\"\"\n    if k < 0 or k > n:\n        return 0\n    return math.comb(n, k)\nclass ArrayGenerator:\n    def __init__(self):\n        pass\n\n    def generate_element(self, i: int) -> int:\n        \"\"\"Calculates a[i] = i * i - i + 1.\"\"\"\n        return i * i - i + 1\nclass RemainderCounter:\n    def __init__(self, array_generator: ArrayGenerator):\n        self.array_generator = array_generator\n\n    def count_remainders(self, n: int) -> dict[int, int]:\n        \"\"\"Counts elements based on their remainder modulo 3.\"\"\"\n        remainder_counts = defaultdict(int)\n        for i in range(1, n + 1):\n            element = self.array_generator.generate_element(i)\n            remainder_counts[element % 3] += 1\n        return dict(remainder_counts)\nclass TriplesCalculator:\n    def __init__(self):\n        self.array_generator = ArrayGenerator()\n        self.remainder_counter = RemainderCounter(self.array_generator)\n\n    def calculate_triples(self, n: int) -> int:\n        \"\"\"Calculates the number of triples from an array a whose sum is a multiple of 3.\"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise ValueError(\"Input 'n' must be a positive integer.\")\n\n        remainder_counts = self.remainder_counter.count_remainders(n)\n\n        count0 = remainder_counts.get(0, 0)\n        count1 = remainder_counts.get(1, 0)\n        # As a[i] = i*i - i + 1, a[i] % 3 will always be 0 or 1.\n        # Thus, count2 will always be 0, simplifying the triple combinations.\n\n        triples_000 = combinations(count0, 3)\n        triples_111 = combinations(count1, 3)\n\n        return triples_000 + triples_111\ndef get_max_triples(n: int) -> int:\n    \"\"\"Calculates the number of triples (a[i], a[j], a[k]) from an array a\n    where i < j < k, and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    calculator = TriplesCalculator()\n    return calculator.calculate_triples(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/140": [{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text: str) -> str:\n    \"\"\"\n    Normalizes spa