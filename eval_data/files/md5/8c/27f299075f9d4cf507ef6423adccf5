 i == 0:\n                is_n_prime = False\n                break\n    \n    if is_n_prime:\n        return x\n    else:\n        return y", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[-2, 0, 1]]}, {"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n    \"\"\"\n    import math\n\n    def is_prime(num: int) -> bool:\n        \"\"\"Checks if the input integer num is a prime number.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        # Check for divisibility by odd numbers from 3 up to sqrt(num)\n        for i in range(3, int(math.sqrt(num)) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\n\n    if is_prime(n):\n        return x\n    else:\n        return y", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/151": [{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Calculates the sum of squares for odd, positive integers in a list.\n    Ignores non-integer, negative, or zero numbers.\n    \"\"\"\n    total_sum_of_squares = 0\n    for num in lst:\n        # Check if the number is an integer, positive, and odd.\n        if isinstance(num, int) and num > 0 and num % 2 != 0:\n            total_sum_of_squares += num * num\n    return total_sum_of_squares", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/151", "solution": "def _is_odd_positive_integer(num):\n    \"\"\"\n    Checks if a given input is an odd, positive integer.\n    Returns True if valid, False otherwise.\n    \"\"\"\n    if not isinstance(num, int):\n        return False\n    if num <= 0:\n        return False\n    if num % 2 == 0:\n        return False\n    return True\ndef double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0  \n   \n    If the input list is empty, return 0.\n    '''\n    total_sum = 0\n    for num in lst:\n        if _is_odd_positive_integer(num):\n            total_sum += num * num\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/152": [{"task_id": "HumanEval/152", "solution": "def compare(game, guess):\n    \"\"\"\n    Determines how far off each guess was from the actual game score.\n    If a guess is correct, the difference is 0; otherwise, it's the absolute difference.\n    \"\"\"\n    if len(game) != len(guess):\n        # This case is constrained not to happen by the problem statement,\n        # but a robust implementation would handle it.\n        raise ValueError(\"Input arrays must be of equal length.\")\n\n    results = []\n    for i in range(len(game)):\n        game_score = game[i]\n        guess_score = guess[i]\n\n        if game_score == guess_score:\n            difference = 0\n        else:\n            difference = abs(game_score - guess_score)\n        \n        results.append(difference)\n            \n    return results", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/152", "solution": "def compare(game, guess):\n    \"\"\"Calculates the absolute difference between actual game scores and guessed scores.\n    Returns a list of these differences, with 0 for correct guesses.\n    \"\"\"\n    if len(game) != len(guess):\n        raise ValueError(\"Input arrays must be of equal length.\")\n\n    differences = []\n    for i in range(len(game)):\n        differences.append(abs(game[i] - guess[i]))\n    return differences", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/153": [{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Identifies the strongest extension from a list based on letter casing and formats the output.\n    Strength is calculated as (uppercase count - lowercase count), with ties broken by list order.\n    \"\"\"\n    if not isinstance(class_name, str):\n        raise TypeError(\"Class name must be a string.\")\n    if not isinstance(extensions, list):\n        raise TypeError(\"Extensions must be a list.\")\n    if not extensions:\n        raise ValueError(\"The list of extensions cannot be empty.\")\n    if not all(isinstance(ext, str) for ext in extensions):\n        raise TypeError(\"All extensions in the list must be strings.\")\n\n    def _calculate_strength(extension_name: str) -> int:\n        \"\"\"Calculates the strength of an extension based on uppercase and lowercase letter counts.\"\"\"\n        if not isinstance(extension_name, str):\n            raise TypeError(\"Extension name must be a string.\")\n        cap_count = sum(1 for char in extension_name if 'A' <= char <= 'Z')\n        sm_count = sum(1 for char in extension_name if 'a' <= char <= 'z')\n        return cap_count - sm_count\n\n    strongest_extension_name: str = \"\"\n    max_strength: int = float('-inf')\n\n    for i, ext_name in enumerate(extensions):\n        current_strength = _calculate_strength(ext_name)\n\n        if i == 0 or current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = ext_name\n        # Tie-breaking: If strengths are equal, the first one encountered is retained,\n        # which is implicitly handled by only updating on a strictly greater strength.\n\n    return f\"{class_name}.{strongest_extension_name}\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/153", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input scenarios.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nclass Extension:\n    \"\"\"A simple data transfer object (DTO) to hold an extension's name and its calculated strength.\"\"\"\n    def __init__(self, name: str, strength: int):\n        if not isinstance(name, str):\n            raise InvalidInputError(\"Extension name must be a string.\")\n        if not isinstance(strength, int):\n            raise InvalidInputError(\"Extension strength must be an integer.\")\n        self.name = name\n        self.strength = strength\n\n    def __repr__(self):\n        return f\"Extension(name='{self.name}', strength={self.strength})\"\n\n    def __eq__(self, other):\n        if not isinstance(other, Extension):\n            return NotImplemented\n        return self.name == other.name and self.strength == other.strength\nclass ExtensionStrengthCalculator:\n    \"\"\"Calculates the strength of a single extension string based on CAP - SM.\"\"\"\n    def calculate(self, extension_name: str) -> int:\n        if not isinstance(extension_name, str):\n            raise InvalidInputError(\"Extension name must be a string.\")\n\n        cap_count = sum(1 for char in extension_name if char.isupper())\n        sm_count = sum(1 for char in extension_name if char.islower())\n        return cap_count - sm_count\nclass StrongestExtensionFinder:\n    \"\"\"Identifies the strongest extension from a list, handling tie-breaking.\"\"\"\n    def __init__(self, calculator: ExtensionStrengthCalculator):\n        self._calculator = calculator\n\n    def find(self, extensions: list[str]) -> Extension:\n        if not isinstance(extensions, list):\n            raise InvalidInputError