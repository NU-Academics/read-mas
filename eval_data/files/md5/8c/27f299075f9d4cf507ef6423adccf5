 # Validate input 'k'.\n    if not isinstance(k, int):\n        raise ValueError(\"Input 'k' must be an integer.\")\n    if not (0 <= k <= len(arr)):\n        raise ValueError(f\"Input 'k' must be between 0 and {len(arr)} (inclusive), got {k}.\")\n\n    if k == 0:\n        return []\n\n    # Use a min-heap to keep track of the k largest elements.\n    # The smallest element in the heap will always be at the root (index 0).\n    min_heap = []\n    for num in arr:\n        if len(min_heap) < k:\n            heapq.heappush(min_heap, num)\n        elif num > min_heap[0]:\n            heapq.heapreplace(min_heap, num)\n\n    # The heap now contains the k largest numbers. Sort them for the final output.\n    return sorted(min_heap)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/121": [{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    Positions are 0-indexed.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list of integers.\")\n    if not lst:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    total_sum = 0\n    for i, element in enumerate(lst):\n        if not isinstance(element, int):\n            raise TypeError(\"Input must be a list of integers.\")\n        if i % 2 == 0 and element % 2 != 0:\n            total_sum += element\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a list of integers, returns the sum of odd elements at even positions.\n    It includes robust validation for input type, emptiness, and element types.\n    \"\"\"\n    ERROR_MSG_NOT_LIST = \"Input must be a list.\"\n    ERROR_MSG_EMPTY_LIST = \"Input list cannot be empty.\"\n    ERROR_MSG_NON_INT_ELEMENTS = \"All elements in the list must be integers.\"\n\n    if not isinstance(lst, list):\n        raise TypeError(ERROR_MSG_NOT_LIST)\n    if not lst:\n        raise ValueError(ERROR_MSG_EMPTY_LIST)\n    for element in lst:\n        if not isinstance(element, int):\n            raise TypeError(ERROR_MSG_NON_INT_ELEMENTS)\n\n    total_sum = 0\n    for i, element in enumerate(lst):\n        if i % 2 == 0 and element % 2 != 0:  # Check for even position and odd element\n            total_sum += element\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/122": [{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    total_sum = 0\n    for i in range(k):\n        element = arr[i]\n        # Check if the element has at most two digits based on its absolute value.\n        if -99 <= element <= 99:\n            total_sum += element\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Return the sum of elements with at most two digits from the first k elements of arr.\n    Includes validation for array emptiness and k's bounds.\n    \"\"\"\n    if not arr:\n        raise ValueError(\"Input array 'arr' cannot be empty.\")\n    if not (1 <= k <= len(arr)):\n        raise ValueError(f\"Input 'k' must be between 1 and {len(arr)} (inclusive).\")\n\n    running_sum = 0\n    for i in range(k):\n        element = arr[i]\n        if -99 <= element <= 99:\n            running_sum += element\n    return running_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/123": [{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n: int) -> list[int]:\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n\n    The Collatz conjecture is a conjecture in mathematics that concerns a sequence defined\n    as follows: start with any positive integer n. Then each term is obtained from the\n    previous term as follows: if the previous term is even, the next term is one half of\n    the previous term. If the previous term is odd, the next term is 3 times the previous\n    term plus 1. The conjecture is that no matter what value of n, the sequence will always reach 1.\n\n    Note:\n        1. Collatz(1) is [1].\n        2. returned list sorted in increasing order.\n\n    For example:\n    get_odd_collatz(5) returns [1, 5] # The collatz sequence for 5 is [5, 16, 8, 4, 2, 1], so the odd numbers are only 1, and 5.\n    \"\"\"\n    # Validate input 'n' as a positive integer.\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    # Generate the Collatz sequence.\n    sequence = []\n    current = n\n    while current != 1:\n        sequence.append(current)\n        if current % 2 == 0:\n            current //= 2\n        else:\n            current = 3 * current + 1\n    sequence.append(1) # Add the final 1 to the sequence.\n\n    # Identify unique odd numbers from the sequence and sort them.\n    odd_numbers = sorted(list(set(num for num in sequence if num % 2 != 0)))\n    return odd_numbers", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in Collatz sequence.\n    This function calculates the Collatz sequence, filters odd numbers, and returns them sorted.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    if n == 1:\n        return [1]\n\n    sequence = []\n    current = n\n    # Generate the Collatz sequence until the term reaches 1.\n    while current != 1:\n        sequence.append(current)\n        if current % 2 == 0:\n            current //= 2  # If even, divide by 2.\n        else:\n            current = 3 * current + 1  # If odd, multiply by 3 and add 1.\n    sequence.append(1) # Ensure 1 is always included in the sequence.\n\n    # Filter odd numbers, ensure uniqueness, and sort them in increasing order.\n    odd_numbers = sorted(list(set(num for num in sequence if num % 2 != 0)))\n    return odd_numbers", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/124": [{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"\n    Validates a date string in \\\"mm-dd-yyyy\\\" format based on specific rules.\n    Returns True if the date is valid, False otherwise.\n    \"\"\"\n    # FR1: The date string must not be empty.\n    if not date:\n        return False\n\n    # BR1.4: Define days in month (no class wrapper allowed).\n    DAYS_IN_MONTH = {\n        1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n        4: 30, 6: 30, 9: 30, 11: 30,\n        2: 29  # Month 2 (February) assumes a maximum of 29 days, no leap year logic.\n    }\n\n    # FR2: Validate format \\\"mm-dd-yyyy\\\" and parse components.\n    parts = date.split('-')\n    if len(parts) != 3:\n        return False # Date string must have three parts separated by hyphens.\n\n    try:\n        month = int(parts[0])\n        day = int(parts[1])\n        _ = int(parts[2]) # Year component is parsed but not further validated.\n    except ValueError:\n        return False # Month, day, or year components must be valid integers.\n\n    # FR3: Validate month component is between 1 and 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # FR4: Validate day component based on the month.\n    # This check ensures the month is a valid key in DAYS_IN_MONTH.\n    if month not in DAYS_IN_MONTH:\n        return False # This case should ideally not happen if month validation passed.\n\n    max_days_for_month = DAYS_IN_MONTH[month]\n    if not (1 <= day <= max_days_for_month):\n        return False\n\n    # FR5: All validation rules passed.\n    return True", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["06-04-202"]]}, {"task_id": "HumanEval/124", "solution": "import re\nDAYS_IN_MONTH = {\n    1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n    4: 30, 6: 30, 9: 30, 11: 30,\n    2: 29  # February is fixed at 29 days as per requirements, no leap year logic.\n}\nDATE_FORMAT_REGEX = r\"^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])-\\d{4}$\"\nclass InvalidDateFormatError(ValueError):\n    \"\"\"Exception raised for errors in the date format.\"\"\"\n    pass\ndef _is_not_empty(date_string: str) -> bool:\n    \"\"\"Checks if the input date string is not empty.\"\"\"\n    return bool(date_string)\ndef _parse_date_components(date_string: str) -> tuple[int, int, int]:\n    \"\"\"Parses the date string into month, day, and year integers based on the 'mm-dd-yyyy' format.\"\"\"\n    match = re.match(DATE_FORMAT_REGEX, date_string)\n    if not match:\n        raise InvalidDateFormatError(f\"Date string '{date_string}' does not match 'mm-dd-yyyy' format.\")\n\n    month = int(match.group(1))\n    day = int(match.group(2))\n    year = int(date_string[6:]) # Extract year from fixed position after 'mm-dd-'\n\n    return month, day, year\ndef _is_month_valid(month: int) -> bool:\n    \"\"\"Checks if the month component is between 1 and 12.\"\"\"\n    return 1 <= month <= 12\ndef _is_day_valid(day: int, month: int) -> bool:\n    \"\"\"Checks if the day component is valid for the given month, considering day limits.\"\"\"\n    if month not in DAYS_IN_MONTH:\n        # This case should ideally be caught by _is_month_valid or regex first.\n        return False\n    \n    max_days = DAYS_IN_MONTH[month]\n    return 1 <= day <= max_days\ndef valid_date(date: str) -> bool:\n    \"\"\"\n    Validates a given date string according to predefined rules and returns True if valid, otherwise False.\n    The date must be in 'mm-dd-yyyy' format, not empty, with valid month (1-12) and day ranges (1-31, 1-30, 1-29 for Feb).\n    \"\"\"\n    if not _is_not_empty(date):\n        return False\n\n    try:\n        month, day, year = _parse_date_components(date)\n    except InvalidDateFormatError:\n        return False\n\n    if not _is_month_valid(month):\n        return False\n\n    if not _is_day_valid(day, month):\n        return False\n\n    return True", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["06-04-2020\n"]]}], "HumanEval/126": [{"task_id": "HumanEval/126", "solution": "import collections\ndef is_sorted(lst):\n    \"\"\"\n    Checks if a list of non-negative integers is sorted ascendingly and contains at most one duplicate of any number.\n    Returns True if valid, False otherwise; raises ValueError for invalid input types.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise ValueError(\"Input must be a list.\")\n    for item in lst:\n        if not isinstance(item, int) or item < 0:\n            raise ValueError(\"All elements in the list must be non-negative integers.\")\n\n    if len(lst) <= 1:\n        return True\n\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    counts = collections.Counter(lst)\n    for count in counts.values():\n        if count > 2:  # Allows a number to appear twice, but not three or more times.\n            return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/126", "solution": "from collections import Counter\ndef is_sorted(lst):\n    \"\"\"\n    Checks if a list is sorted in ascending order and if no numb