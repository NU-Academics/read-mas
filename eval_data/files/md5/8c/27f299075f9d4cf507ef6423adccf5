from s that contain exactly n consonants.\n    Words are returned in their original order; an empty string input results in an empty list.\n    \"\"\"\n    selector = WordSelector()\n    return selector.select_words(s, n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"\n    Returns words from a string that contain exactly n consonants.\n    Words are separated by spaces; non-alphabetic characters are ignored in counting.\n    \"\"\"\n    if not s:\n        return []\n\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def _is_vowel(char: str) -> bool:\n        # Checks if a character is a vowel (case-insensitive).\n        return char.lower() in VOWELS\n\n    def _count_consonants(word: str) -> int:\n        # Counts consonants in a word, ignoring non-alphabetic characters.\n        count = 0\n        for char in word:\n            if char.isalpha() and not _is_vowel(char):\n                count += 1\n        return count\n\n    words = s.split()\n    result = []\n    for word in words:\n        if _count_consonants(word) == n:\n            result.append(word)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/119": [{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    '''\n    You are given a list of two strings, both strings consist of open\n    parentheses '(' or close parentheses ')' only.\n    Your job is to check if it is possible to concatenate the two strings in\n    some order, that the resulting string will be good.\n    A string S is considered to be good if and only if all parentheses in S\n    are balanced. For example: the string '(())()' is good, while the string\n    '())' is not.\n    Return 'Yes' if there's a way to make a good string, and return 'No' otherwise.\n\n    Examples:\n    match_parens(['()(', ')']) == 'Yes'\n    match_parens([')', ')']) == 'No'\n    '''\n    def _is_balanced(s: str) -> bool:\n        \"\"\"Checks if a given string of parentheses is balanced.\n        It uses a balance counter, ensuring it never drops below zero and ends at zero.\n        \"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else:\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    s1, s2 = lst[0], lst[1]\n\n    if _is_balanced(s1 + s2) or _is_balanced(s2 + s1):\n        return 'Yes'\n    return 'No'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/119", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to the parentheses matcher.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef match_parens(lst):\n    '''\n    Checks if concatenating two parentheses strings in any order\n    results in a balanced string.\n    Returns 'Yes' if possible, 'No' otherwise.\n    '''\n    def _is_balanced(s: str) -> bool:\n        \"\"\"Checks if a string of parentheses is balanced using a counter.\"\"\"\n        balance = 0\n        for char in s:\n            balance += 1 if char == '(' else -1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    def _validate_parens_string(s: str) -> bool:\n        \"\"\"Checks if a string contains only '(' or ')'.\"\"\"\n        return all(char in '()' for char in s)\n\n    def _validate_parens_list(input_list: list[str]) -> bool:\n        \"\"\"Validates if input is a list of two valid parentheses strings.\"\"\"\n        if not isinstance(input_list, list) or len(input_list) != 2:\n            return False\n        if not all(isinstance(s, str) for s in input_list):\n            return False\n        return all(_validate_parens_string(s) for s in input_list)\n\