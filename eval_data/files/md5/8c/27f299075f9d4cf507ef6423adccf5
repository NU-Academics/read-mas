: int) -> int:\n        \"\"\"\n        Counts '1' bits in the absolute binary representation of an integer.\n        Handles both positive and negative integers by using abs(n).\n        \"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input must be an integer.\")\n\n        if n == 0:\n            return 0\n\n        # Count '1's in the binary representation of the absolute value.\n        return bin(abs(n)).count('1')\nclass BitwiseSorter:\n    def __init__(self, bit_counter: BitCounter):\n        \"\"\"Initializes the sorter with a BitCounter instance.\"\"\"\n        self._bit_counter = bit_counter\n\n    def _get_sort_key(self, num: int) -> tuple[int, int]:\n        \"\"\"\n        Generates the sorting key: (count_of_set_bits, decimal_value).\n        Delegates bit counting to the BitCounter instance.\n        \"\"\"\n        bit_count = self._bit_counter.count_set_bits(num)\n        return (bit_count, num)\n\n    def sort(self, arr: list[int]) -> list[int]:\n        \"\"\"\n        Sorts the input array by set bit count, then by decimal value.\n        Performs basic input validation for list and integer types.\n        \"\"\"\n        if not isinstance(arr, list):\n            raise TypeError(\"Input must be a list.\")\n        if not all(isinstance(x, int) for x in arr):\n            raise TypeError(\"All elements in the list must be integers.\")\n\n        # Python's sorted() is stable, preserving relative order for equal keys.\n        return sorted(arr, key=self._get_sort_key)\ndef sort_array(arr: list[int]) -> list[int]:\n    \"\"\"\n    Sorts an array of integers primarily by the count of set bits (ascending).\n    For numbers with the same bit count, they are sorted by their decimal value (ascending).\n    \"\"\"\n    bit_counter = BitCounter()\n    sorter = BitwiseSorter(bit_counter)\n    return sorter.sort(arr)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEv