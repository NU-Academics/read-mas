y(gpa_threshold=3.0, letter_grade=\"B+\", operator=\">\"),\n    GradeScaleEntry(gpa_threshold=2.7, letter_grade=\"B\", operator=\">\"),\n    GradeScaleEntry(gpa_threshold=2.3, letter_grade=\"B-\", operator=\">\"),\n    GradeScaleEntry(gpa_threshold=2.0, letter_grade=\"C+\", operator=\">\"),\n    GradeScaleEntry(gpa_threshold=1.7, letter_grade=\"C\", operator=\">\"),\n    GradeScaleEntry(gpa_threshold=1.3, letter_grade=\"C-\", operator=\">\"),\n    GradeScaleEntry(gpa_threshold=1.0, letter_grade=\"D+\", operator=\">\"),\n    GradeScaleEntry(gpa_threshold=0.7, letter_grade=\"D\", operator=\">\"),\n    GradeScaleEntry(gpa_threshold=0.0, letter_grade=\"D-\", operator=\">\"),\n    GradeScaleEntry(gpa_threshold=0.0, letter_grade=\"E\", operator=\"==\"),\n]\nclass GradeConverter:\n    \"\"\"Converts a numerical GPA to a letter grade based on a predefined scale.\"\"\"\n\n    def __init__(self, grading_scale: List[GradeScaleEntry]):\n        self._grading_scale = grading_scale\n\n    def convert_gpa(self, gpa: float) -> str:\n        \"\"\"Converts a single GPA to its corresponding letter grade.\"\"\"\n        for entry in self._grading_scale:\n            if entry.operator == \"==\" and gpa == entry.gpa_threshold:\n                return entry.letter_grade\n            elif entry.operator == \">\" and gpa > entry.gpa_threshold:\n                return entry.letter_grade\n        return \"N/A\" # Default if no match found\ndef numerical_letter_grade(grades: List[float]) -> List[str]:\n    \"\"\"\n    Converts a list of GPAs to a list of letter grades using a predefined scale.\n    Initializes a GradeConverter and maps each GPA to its letter grade.\n    \"\"\"\n    converter = GradeConverter(GRADING_SCALE)\n    return [converter.convert_gpa(gpa) for gpa in grades]", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/83": [{"task_id": "HumanEval/83", "solution": "from typing import Any\ndef _count_starts_with_one(n: int) ->