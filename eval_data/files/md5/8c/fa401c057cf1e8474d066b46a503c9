m, int):\n                raise DuplicateProcessingError(f\"Non-int item found: {item} (type: {type(item).__name__})\")\n            counts[item] += 1\n        return dict(counts)\ndef validate_input_lists(input_data: Any) -> Tuple[List[List[int]], bool]:\n    \"\"\"\n    Normalizes input data into a list of lists of integers.\n    It returns the normalized lists and a flag indicating if the original input was a single flat list.\n    \"\"\"\n    normalized_lists: List[List[int]] = []\n    is_originally_flat_list = False\n\n    if isinstance(input_data, list):\n        if not input_data:\n            normalized_lists.append([])\n            is_originally_flat_list = True\n        elif all(isinstance(item, int) for item in input_data):\n            normalized_lists.append(input_data)\n            is_originally_flat_list = True\n        elif all(isinstance(item, list) for item in input_data):\n            for sublist in input_data:\n                if not all(isinstance(item, int) for item in sublist):\n                    raise DuplicateProcessingError(f\"Input list of lists contains a sublist with non-integer items: {sublist}\")\n                normalized_lists.append(sublist)\n            is_originally_flat_list = False\n        else:\n            raise DuplicateProcessingError(f\"Input list contains mixed types or non-list/non-int elements: {input_data}\")\n    elif isinstance(input_data, Iterable):\n        temp_lists: List[List[int]] = []\n        for i, item in enumerate(input_data):\n            if not isinstance(item, list):\n                raise DuplicateProcessingError(f\"Iterable input contains non-list element at index {i}: {item}\")\n            if not all(isinstance(sub_item, int) for sub_item in item):\n                raise DuplicateProcessingError(f\"Iterable of lists contains a sublist with non-integer items at index {i}: {item}\")\n            temp_lists.append(item)\n        normalized_lists = temp_lists\n        is_originally_flat_list = False\n    else:\n        raise DuplicateProcessingError(f\"Invalid input type: {type(input_data).__name__}. Expected a list of integers or an iterable of lists of integers.\")\n\n    return normalized_lists, is_originally_flat_list\nclass UniqueRequest:\n    \"\"\"Data Transfer Object for unique number processing requests.\"\"\"\n    def __init__(self, lists: List[List[int]], combine: bool = True, preserve_order: bool = True) -> None:\n        self.lists = lists\n        self.combine = combine\n        self.preserve_order = preserve_order\nclass UniqueResult:\n    \"\"\"Data Transfer Object for unique number processing results.\"\"\"\n    def __init__(self, uniques: Union[List[int], List[List[int]]]) -> None:\n        self.uniques = uniques\n\n    def to_list(self) -> Union[List[int], List[List[int]]]:\n        return self.uniques\nclass UniqueRepository:\n    \"\"\"Abstract interface for storing unique processing results.\"\"\"\n    pass\nclass InMemoryUniqueRepository(UniqueRepository):\n    \"\"\"In-memory implementation of UniqueRepository.\"\"\"\n    def __init__(self) -> None:\n        self._store: Dict[str, UniqueResult] = {}\n\n    def save_result(self, key: str, result: UniqueResult) -> None:\n        self._store[key] = result\n\n    def get_result(self, key: str) -> Optional[UniqueResult]:\n        return self._store.get(key)\nclass UniqueService:\n    \"\"\"Core business logic for computing unique numbers.\"\"\"\n    def __init__(self, repo: Optional[UniqueRepository] = None) -> None:\n        self._repo = repo\n\n    def find_uniques(self, request: UniqueRequest) -> UniqueResult:\n        result_uniques: Union[List[int], List[List[int]]]\n\n        if request.combine:\n            flat_list: List[int] = [item for sublist in request.lists for item in sublist]\n            result_uniques = self._compute_combined_uniques(flat_list, request.preserve_order)\n        else:\n            result_uniques = self._compute_per_list_uniques(request.lists, request.preserve_order)\n\n        result = UniqueResult(result_uniques)\n        return result\n\n    def _compute_combined_uniques(self, flat_list: List[int], preserve_order: bool) -> List[int]:\n        \"\"\"Computes unique numbers from a flattened list, preserving order if requested.\"\"\"\n        counter = ListCounter()\n        counts = counter.count(flat_list)\n\n        if preserve_order:\n            result = []\n            seen_for_order = set()\n            for x in flat_list:\n                if x not in seen_for_order:\n                    if counts.get(x) == 1:\n                        result.append(x)\n                    seen_for_order.add(x)\n            return result\n        else:\n            return sorted([k for k, v in counts.items() if v == 1])\n\n    def _compute_per_list_uniques(self, lists: List[List[int]], preserve_order: bool) -> List[List[int]]:\n        \"\"\"Computes unique numbers for each sublist independently, preserving order if requested.\"\"\"\n        all_uniques: List[List[int]] = []\n        for sublist in lists:\n            counter = ListCounter()\n            counts = counter.count(sublist)\n            \n            if preserve_order:\n                sublist_uniques = []\n                seen_for_order = set()\n                for x in sublist:\n                    if x not in seen_for_order:\n                        if counts.get(x) == 1:\n                            sublist_uniques.append(x)\n                        seen_for_order.add(x)\n                all_uniques.append(sublist_uniques)\n            else:\n                all_uniques.append(sorted([k for k, v in counts.items() if v == 1]))\n        return all_uniques\nclass UniqueController:\n    \"\"\"Handles external requests, delegates to service, and formats responses.\"\"\"\n    def __init__(self, service: UniqueService) -> None:\n        self._service = service\n\n    def find_and_return_uniques(\n        self,\n        lists_input: Any,\n        combine: bool = True,\n        preserve_order: bool = True\n    ) -> Union[List[int], List[List[int]]]:\n        normalized_lists, is_originally_flat_list = validate_input_lists(lists_input)\n\n        if not normalized_lists and not is_originally_flat_list:\n            return [] if combine else []\n\n        effective_combine = combine\n        if is_originally_flat_list:\n            # If the input was a single flat list, always treat it as combined.\n            effective_combine = True\n\n        request = UniqueRequest(\n            lists=normalized_lists,\n            combine=effective_combine,\n            preserve_order=preserve_order\n        )\n        result = self._service.find_uniques(request)\n        \n        return result.to_list()\ndef two_unique_nums(input_data: Union[List[int], Iterable[List[int]]], combine: bool = True, preserve_order: bool = True) -> Union[List[int], List[List[int]]]:\n    \"\"\"\n    Removes duplicate numbers from given list(s), returning numbers that appear exactly once.\n    This function acts as a convenience wrapper for the unique number processing logic.\n    \"\"\"\n    repo = InMemoryUniqueRepository()\n    service = UniqueService(repo=repo)\n    controller = UniqueController(service=service)\n    return controller.find_and_return_uniques(input_data, combine=combine, preserve_order=preserve_order)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[-0.9997483195812293, 8.805625175692413]]]}], "Mbpp/619": [{"task_id": "Mbpp/619", "solution": "def move_num(s: str) -> str:\n    \"\"\"Moves all numeric characters to the end of the string, preserving relative order.\"\"\"\n    non_digits = []\n    digits = []\n    for char in s:\n        if char.isdigit():\n            digits.append(char)\n        else:\n            non_digits.append(char)\n    return \"\".join(non_digits) + \"\".join(digits)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/622": [{"task_id": "Mbpp/622", "solution": "def get_median(a: list[int], b: list[int], n: int) -> float:\n    \"\"\"\n    Finds the median of two sorted lists of the same size n.\n    The median is the average of the n-th and (n+1)-th elements of the combined sorted list.\n    \"\"\"\n    i = 0  # Current index for list a\n    j = 0  # Current index for list b\n    m1 = 0.0  # Will store the element just before the median pair\n    m2 = 0.0  # Will store the first element of the median pair\n\n    # Iterate n+1 times to find the n-th and (n+1)-th smallest elements in the merged sequence.\n    # After (n) iterations, m2 will hold the n-th smallest element.\n    # After (n+1) iterations, m1 will hold the n-th and m2 will hold the (n+1)-th smallest element.\n    for _ in range(n + 1):\n        if i < n and (j >= n or a[i] <= b[j]):\n            m1 = m2\n            m2 = float(a[i])\n            i += 1\n        else:\n            m1 = m2\n            m2 = float(b[j])\n            j += 1\n    \n    return (m1 + m2) / 2.0", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1], [2], 0]]}], "Mbpp/624": [{"task_id": "Mbpp/624", "solution": "def is_upper(value: str) -> str:\n    \"\"\"Converts the given string to its uppercase equivalent.\"\"\"\n    return value.upper()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/626": [{"task_id": "Mbpp/626", "solution": "def triangle_area(radius):\n    \"\"\"\n    Calculates the area of the largest triangle inscribed in a semicircle with the given radius.\n    Returns None for invalid (negative, non-numeric, or non-finite) radius values.\n    \"\"\"\n    import math\n\n    def _is_finite_number(value_to_check) -> bool:\n        \"\"\"Checks if a value is a finite number (int or float, not infinity or NaN).\"\"\"\n        return isinstance(value_to_check, (int, float)) and math.isfinite(value_to_check)\n\n    def _to_float(value_to_convert) -> float or None:\n        \"\"\"Attempts to convert a value to a float, returning None if conversion fails or it's not a finite number.\"\"\"\n        try:\n            float_value = float(value_to_convert)\n            if _is_finite_number(float_value):\n                return float_value\n            return None\n        except (TypeError, ValueError):\n            return None\n\n    # Validate and convert radius using the inline helpers\n    float_radius = _to_float(radius)\n\n    if float_radius is None:\n        return None  # Input is not a valid, finite number or cannot be converted.\n    \n    if float_radius < 0:\n        return None  # Negative radius is invalid as per requirement.\n    \n    # The area of the largest triangle inscribed in a semicircle of radius R is R^2.\n    return float_radius * float_radius", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[999999999]]}], "Mbpp/587": [{"task_id": "Mbpp/587", "solution": "from .service import ConverterService\ndef list_tuple(list_: list) -> tuple:\n    \"\"\"Public helper to convert a list to a tuple (shallow).\"\"\"\n    svc = ConverterService()\n    return svc.convert(list_)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/628": [{"task_id": "Mbpp/628", "solution": "def replace_spaces(s: str) -> str:\n    \"\"\"\n    Replaces all space characters in the input string with '%20'.\n    This function uses the built-in string replace method for efficiency.\n    \"\"\"\n    return s.replace(' ', '%20')", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/620": [{"task_id": "Mbpp/620", "solution": "from typing import List, Tuple, Union, Any, Dict\nimport datetime\nimport uuid\nclass AppError(Exception):\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\nclass InvalidInputError(AppError):\n    pass\nclass DivisibleSubsetResult:\n    def __init__(self, size: int, subset: List[int]) -> None:\n        self.size = size\n        self.subset = subset\n\n    def to_dict(self) -> Dict:\n        return {\"size\": self.size, \"subset\": self.subset}\nclass InMemoryRepository:\n    def __init__(self, path: str = \"\") -> None:\n        self.path = path\n        self._runs = []\n\n    def save_run(self, run: Dict) -> None:\n        run_with_meta = {\n            \"id\": str(uuid.uuid4()),\n            \"timestamp\": datetime.datetime.now(datetime.timezone.utc).isoformat(),\n            **run\n        }\n        self._runs.append(run_with_meta)\n\n    def load_runs(self) -> List[Dict]:\n        return self._runs[:]\nclass Validator:\n    def validate_numbers(self, value: Any) -> List[int]:\n        if value is None:\n            raise InvalidInputError(\"Input is None\")\n        if isinstance(value, str):\n            parts = [p.strip() for p in value.replace(',', ' ').split()]\n            try:\n                return [int(p) for p in parts if p != \"\"]\n            except ValueError:\n                raise InvalidInputError(\"String contains non-integers\")\n        if isinstance(value, (list, tuple)):\n            try:\n                return [int(x) for x in value]\n            except (ValueError, TypeError):\n                raise InvalidInputError(\"List contains non-integers\")\n        raise InvalidInputError(\"Unsupported input type for numbers\")\nclass DivisibleSubsetService:\n    def __init__(self, repository: InMemoryRepository | None = None, validator: Validator | None = None):\n        self.repository = repository\n        self.validator = validator\n\n    def compute(self, nums: List[int], return_subset: bool=False) -> Union[int, DivisibleSubsetResult]:\n        if self.validator:\n            nums = self.validator.validate_numbers(nums)\n\n        size, subset = self._compute_dp(nums)\n\n        if self.repository:\n            self.repository.save_run({\"input\": nums, \"size\": size, \"subset\": subset})\n\n        if return_subset:\n            return DivisibleSubsetResult(size=size, subset=subset)\n        return size\n\n    def _compute_dp(self, nums: List[int]) -> Tuple[int, List[int]]:\n        \"\"\"\n        Internal O(n^2) DP algorithm that returns size and one reconstructed subset.\n        \"\"\"\n        if not nums:\n            return 0, []\n\n        nums_sorted = sorted(nums)\n        n = len(nums_sorted)\n\n        dp = [1] * n\n        parent = [-1] * n\n\n        max_i = 0\n\n        for i in range(n):\n            for j in range(i):\n                # Ensure divisor is not zero to prevent ZeroDivisionError.\n                # If nums_sorted[j] is 0, it cannot divide nums_sorted[i] in this context.\n                if nums_sorted[j] != 0 and nums_sorted[i] % nums_sorted[j] == 0 and dp[j] + 1 > dp[i]:\n                    dp[i] = dp[j] + 1\n                    parent[i] = j\n            \n            if dp[i] > dp[max_i]:\n                max_i = i\n\n        size = dp[max_i]\n        subset = []\n        i = max_i\n        while i != -1:\n            subset.append(nums_sorted[i])\n            i = parent[i]\n        subset.reverse()\n        return size, subset\ndef largest_subset(nums: List[int], return_subset: bool=False) -> Union[int, List[int]]:\n    \"\"\"\n    Finds the size of the largest divisible subset of a list of numbers.\n    Optionally returns the subset itself.\n    \"\"\"\n    service = DivisibleSubsetService(repository=None, validator=Validator())\n    result = service.compute(nums, return_subset=return_subset)\n    \n    if return_subset:\n        return result.subset\n    return result", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[9, 3, 12, 7, 16, 3, 11, 8, 4, 13, 13]]]}], "Mbpp/629": [{"task_id": "Mbpp/629", "solution": "from typing import List, Iterable, Optional, Any, Dict\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input to the s