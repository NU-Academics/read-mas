ge: str) -> None:\n        super().__init__(message)\nclass InputDTO:\n    \"\"\"Data Transfer Object holding validated and normalized input sequences.\"\"\"\n    def __init__(self, a: Tuple[Tuple[float,...], ...], b: Tuple[Tuple[float,...], ...]) -> None:\n        self.a = a\n        self.b = b\nclass TupleUtils:\n    \"\"\"Provides utility methods for tuple operations.\"\"\"\n    def elementwise_max(self, ta: Tuple[float,...], tb: Tuple[float,...]) -> Tuple[float,...]:\n        \"\"\"Computes the element-wise maximum of two numeric tuples.\"\"\"\n        if len(ta) != len(tb):\n            raise ValidationError(\"Inner tuple lengths differ\")\n        return tuple(max(x, y) for x, y in zip(ta, tb))\nclass InputValidator:\n    \"\"\"Validates the structure and types of input sequences.\"\"\"\n    def validate(self, a: object, b: object) -> InputDTO:\n        \"\"\"Ensures inputs are sequences of sequences, equal length, and contain numerics.\"\"\"\n        if not hasattr(a, '__len__') or not hasattr(b, '__len__'):\n            raise ValidationError(\"Inputs must be sequences\")\n        if len(a) != len(b):\n            raise ValidationError(\"Outer lengths differ\")\n        normalized_a = []\n        normalized_b = []\n        for i, (ia, ib) in enumerate(zip(a, b)):\n            try:\n                ta = tuple(float(x) for x in ia)\n                tb = tuple(float(x) for x in ib)\n            except Exception:\n                raise ValidationError(f\"Non-numeric element at index {i}\")\n            if len(ta) != len(tb):\n                raise ValidationError(f\"Inner lengths differ at index {i}\")\n            normalized_a.append(ta)\n            normalized_b.append(tb)\n        return InputDTO(tuple(normalized_a), tuple(normalized_b))\nclass MaximizerService:\n    \"\"\"Implements the core logic for maximizing elements between two tuple sequences.\"\"\"\n    def __init__(self, utils: TupleUtils | None = None) -> None:\n        self.utils = utils or TupleUtils()\n\n    def maximize_elements(self, a: Tuple[Tuple[float,...], ...], b: Tuple[Tuple[float,...], ...]) -> Tuple[Tuple[float,...], ...]:\n        \"\"\"Calculates element-wise maximums between corresponding inner tuples of two inputs.\"\"\"\n        if len(a) != len(b):\n            raise ValidationError(\"Outer lengths differ\")\n        result = []\n        try:\n            for ta, tb in zip(a, b):\n                result.append(self._max_pair(ta, tb))\n            return tuple(result)\n        except ValidationError:\n            raise\n        except Exception as exc:\n            raise MaximizeError(str(exc))\n\n    def _max_pair(self, ta: Tuple[float,...], tb: Tuple[float,...]) -> Tuple[float,...]:\n        \"\"\"A helper method to compute the element-wise maximum for a single pair of tuples.\"\"\"\n        return self.utils.elementwise_max(ta, tb)\ndef maximize_elements(a: Sequence[Sequence[float]], b: Sequence[Sequence[float]]) -> Tuple[Tuple[float,...], ...]:\n    \"\"\"\n    Maximizes elements of two tuple sequences by selecting element-wise maxima.\n    This function validates input shapes and types before applying the maximization logic.\n    \"\"\"\n    validator = InputValidator()\n    dto = validator.validate(a, b)\n    svc = MaximizerService()\n    return svc.maximize_elements(dto.a, dto.b)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/267": [{"task_id": "Mbpp/267", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"Calculates the sum of the squares of the first n odd natural numbers.\n    Uses a closed-form formula for O(1) performance.\"\"\"\n    # The formula for the sum of the squares of the first n odd numbers is n * (2n - 1) * (2n + 1) / 3\n    # Use integer division // as the result is always an integer.\n    return n * (2 * n - 1) * (2 * n + 1) // 3", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[123456789]]}], "Mbpp/269": [{"task_id": "