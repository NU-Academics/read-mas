[]}], "Mbpp/239": [{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the number of sequences of length n, where each element is a\n    positive integer, greater than or equal to twice the previous element,\n    and less than or equal to m.\n    \"\"\"\n    if n == 1:\n        return m\n\n    # dp_prev[v] stores the number of sequences of the previous length ending with v.\n    # Using 1-based indexing, so size m+2 (index 0 and m+1 are padding/unused).\n    dp_prev = [0] * (m + 2)\n\n    # Initialize for sequences of length 1: each v from 1 to m forms a valid sequence.\n    for v in range(1, m + 1):\n        dp_prev[v] = 1\n\n    # Iterate for lengths from 2 up to n\n    for length in range(2, n + 1):\n        # suffix[i] will store sum(dp_prev[j] for j >= i)\n        # Using 1-based indexing, size m+3 (index 0, m+1, m+2 are padding/unused).\n        # suffix[m+2] is 0, suffix[m+1] is 0, etc.\n        suffix = [0] * (m + 3)\n        for i in range(m, 0, -1):\n            suffix[i] = suffix[i + 1] + dp_prev[i]\n\n        # dp_cur[v] stores the number of sequences of the current length starting with v.\n        dp_cur = [0] * (m + 2)\n        for v in range(1, m + 1):\n            # The next element in the sequence must be >= 2*v.\n            # So, we sum up sequences of previous length that start with an element >= 2*v.\n            # This sum is directly available from the suffix array.\n            start_idx_for_next_element = 2 * v\n            if start_idx_for_next_element <= m:\n                dp_cur[v] = suffix[start_idx_for_next_element]\n            # If 2*v > m, no next element is possible, so dp_cur[v] remains 0.\n\n        dp_prev = dp_cur\n\n    # The total number of sequences of length n is the sum of all sequences\n    # of length n starting with any element from 1 to m.\n    return sum(dp_prev[1 : m + 1])", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/245": [{"task_id": "Mbpp/245", "solution": "def max_sum(arr: List[int]) -> int:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence in the given array.\n    A bitonic subsequence is first increasing and then decreasing.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n\n    def _compute_left_sums(values: List[int]) -> List[int]:\n        \"\"\"Computes maximum sum of an increasing subsequence ending at each index.\"\"\"\n        left_sums = [0] * n\n        for i in range(n):\n            left_sums[i] = values[i]\n            for j in range(i):\n                if values[j] < values[i]:\n                    left_sums[i] = max(left_sums[i], left_sums[j] + values[i])\n        return left_sums\n\n    def _compute_right_sums(values: List[int]) -> List[int]:\n        \"\"\"\n        Computes maximum sum of a decreasing subsequence \"ending\" at each index,\n        calculated from right to left.\n        \"\"\"\n        right_sums = [0] * n\n        for i in range(n - 1, -1, -1):\n            right_sums[i] = values[i]\n            for j in range(n - 1, i, -1):\n                if values[j] < values[i]:\n                    right_sums[i] = max(right_sums[i], right_sums[j] + values[i])\n        return right_sums\n\n    left = _compute_left_sums(arr)\n    right = _compute_right_sums(arr)\n\n    max_bitonic_sum = 0\n    for i in range(n):\n        # arr[i] is included in both left[i] and right[i], so subtract it once.\n        current_bitonic_sum = left[i] + right[i] - arr[i]\n        if current_bitonic_sum > max_bitonic_sum:\n            max_bitonic_sum = current_bitonic_sum\n\n    return max_bitonic_sum", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/253": [{"task_id": "Mbpp/253", "solution": "def is_integer(value) -> bool:\n    \"\"\"Checks if a value is an integer, excluding booleans.\"\"\"\n    return isinstance(value, int) and not isinstance(value, bool)\ndef count_integer(items) -> int:\n    \"\"\"Counts the number of integer elements in a given list, excluding booleans.\"\"\"\n    count = 0\n    for item in items:\n        if is_integer(item):\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/247": [{"task_id": "Mbpp/247", "solution": "def lps(s: str, normalize: bool = True) -> int:\n    \"\"\"\n    Calculates the length of the longest palindromic subsequence in the given string.\n    By default, the string is normalized to be case-insensitive and non-alphanumeric characters are removed.\n    \"\"\"\n    \n    text_to_process = s\n    if normalize:\n        # Normalize the string: casefold and keep only alphanumeric characters.\n        normalized_s = str(s).casefold()\n        text_to_process = \"\".join(ch for ch in normalized_s if ch.isalnum())\n\n    n = len(text_to_process)\n    if n == 0:\n        return 0\n\n    # Create a 2D DP table where dp[i][j] stores the length of the longest palindromic subsequence\n    # of the substring text_to_process[i...j].\n    dp = [[0] * n for _ in range(n)]\n\n    # Initialize base cases: single characters are palindromes of length 1.\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the DP table using a bottom-up approach.\n    for i in range(n - 1, -1, -1):\n        for j in range(i + 1, n):\n            if text_to_process[i] == text_to_process[j]:\n                # If characters match, include them and add 2 to the LPS of the inner substring.\n                dp[i][j] = (dp[i + 1][j - 1] + 2) if (j > i + 1) else 2\n            else:\n                # If characters don't match, take the maximum LPS by either excluding char at i or char at j.\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n                \n    return dp[0][n - 1]", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["TENS FOR TENS"]], "plus_fail_tests": [["xZQOogNh"]]}], "Mbpp/256": [{"task_id": "Mbpp/256", "solution": "import math\ndef count_Primes_nums(n: int) -> int:\n    \"\"\"\n    Counts the number of prime numbers strictly less than n using the Sieve of Eratosthenes.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    if n <= 2:\n        return 0\n\n    sieve = bytearray(b'\\x01') * n\n    sieve[0:2] = b'\\x00\\x00'  # 0 and 1 are not prime\n\n    for p in range(2, int(math.isqrt(n)) + 1):\n        if sieve[p]:\n            # Mark multiples of p as not prime\n            for multiple in range(p * p, n, p):\n                sieve[multiple] = b'\\x00'\n\n    return int(sum(sieve))", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[5]], "plus_fail_tests": [[1000]]}], "Mbpp/111": [{"task_id": "Mbpp/111", "solution": "import collections.abc as cabc\nfrom typing import List, Any, TypeVar\nT = TypeVar(\"T\")\ndef common_in_nested_lists(nested: List[List[T]], preserve_order: bool=False) -> List[T]:\n    \"\"\"\n    Finds the common elements in given nested lists.\n\n    Args:\n        nested: A list of lists, where each inner list contains elements of type T.\n        preserve_order: If True, the order of common elements will match their first\n                        appearance in the first list, and duplicates are removed.\n                        If False, the order is arbitrary (set-like).\n    Returns:\n        A list of common elements.\n    \"\"\"\n\n    class NestedCommonError(Exception):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n\n    class ListUtils:\n        @staticmethod\n        def is_iterable(obj: Any) -> bool:\n            \"\"\"Checks if an object is iterable, excluding strings and bytes.\"\"\"\n            return isinstance(obj, cabc.Iterable) and not isinstance(obj, (str, bytes))\n\n        @staticmethod\n        def validate_nested(nested: Any) -> List[List[Any]]:\n            \"\"\"Validates if the input is an iterable of iterables and converts it to List[List[Any]].\"\"\"\n            if not ListUtils.is_iterable(nested):\n                raise NestedCommonError(\"Input must be an iterable of iterables.\")\n            result = []\n            for idx, inner in enumerate(nested):\n                if not ListUtils.is_iterable(inner):\n                    raise NestedCommonError(f\"Inner element at index {idx} is not iterable.\")\n                result.append(list(inner))\n            return result\n\n        @staticmethod\n        def dedupe_preserve_order(seq: List[Any]) -> List[Any]:\n            \"\"\"Removes duplicates from a sequence while preserving the original order.\"\"\"\n            seen = set()\n            return [x for x in seq if x not in seen and not seen.add(x)]\n\n    class CommonElementsService:\n        def find_common(self, nested_lists: List[List[Any]], preserve_order: bool=False) -> List[Any]:\n            \"\"\"\n            Core logic to compute common elements across nested lists.\n            Handles hashable and unhashable elements, and optional order preservation.\n            \"\"\"\n            normalized = ListUtils.validate_nested(nested_lists)\n\n            if not normalized or any(not inner for inner in normalized):\n                return []\n\n            try:\n                # Attempt set-based intersection for hashable elements\n                sets = [set(inner) for inner in normalized]\n                common_set = set.intersection(*sets)\n                \n                if not common_set:\n                    return []\n\n                if preserve_order:\n                    # Filter the first list by common_set, preserving order and removing duplicates\n                    first_list_deduped = ListUtils.dedupe_preserve_order(list(normalized[0]))\n                    return [x for x in first_list_deduped if x in common_set]\n                else:\n                    return list(common_set)\n\n            except TypeError:\n                # Fallback for unhashable elements\n                return self._handle_unhashable(normalized, preserve_order)\n\n        def _handle_unhashable(self, nested_lists: List[List[Any]], preserve_order: bool) -> List[Any]:\n            \"\"\"\n            Fallback algorithm for lists with unhashable elements, comparing by equality.\n            This method ensures order is preserved and elements are deduped based on the first list.\n            \"\"\"\n            if not nested_lists:\n                return []\n            if len(nested_lists) == 1:\n                # If only one list, just dedupe it preserving order by equality check\n                deduped_single = []\n                for item in nested_lists[0]:\n                    if item not in deduped_single:\n                        deduped_single.append(item)\n                return deduped_single\n\n            first_list = list(nested_lists[0])\n            other_lists = nested_lists[1:]\n            \n            # Use a list for common elements, and check for existence by equality for deduplication\n            result_common = []\n            \n            for item_from_first in first_list:\n                # Check if this item has already been identified as common and added\n                if item_from_first in result_common:\n                    continue\n\n                is_common_across_all = True\n                for other_list in other_lists:\n                    if item_from_first not in other_list: # This relies on __eq__\n                        is_common_across_all = False\n                        break\n                \n                if is_common_across_all:\n                    result_common.append(item_from_first)\n            \n            # The result_common is already deduped and ordered according to the first list\n            # due to the 'item_from_first not in result_common' check.\n            # The 'preserve_order' flag is handled implicitly by this fallback path.\n            return result_common\n\n    service = CommonElementsService()\n    return service.find_common(nested, preserve_order=preserve_order)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/124": [{"task_id": "Mbpp/124", "solution": "import math\nfrom typing import Union, Optional, List, Tuple\ndef angle_complex(a: Union[complex, float, int], b: Optional[Union[float, int, complex]] = None) -> float:\n    \"\"\"Computes the angle (argument) of a complex number in radians.\"\"\"\n\n    class AngleComputationError(Exception):\n        \"\"\"Domain-specific exception for angle computation errors.\"\"\"\n        def __init__(self, message: str, cause: Optional[Exception]=None) -> None:\n            super().__init__(message)\n            self.message = message\n            self.cause = cause\n\n    class ComplexNumber:\n        \"\"\"Domain model representing a complex number's real and imaginary components.\"\"\"\n        def __init__(self, value: Union[complex, float, int]=0.0, imag: Optional[Union[float,int,complex]]=None) -> None:\n            if imag is None and isinstance(value, complex):\n                real = float(value.real)\n                imag_val = float(value.imag)\n            else:\n                real = float(value.real if isinstance(value, complex) else value)\n                if isinstance(imag, complex):\n                    imag_val = float(imag.imag)\n                else:\n                    imag_val = float(imag or 0.0)\n            if not (math.isfinite(real) and math.isfinite(imag_val)):\n                raise ValueError(\"Non-finite components are not allowed.\")\n            self._real = real\n            self._imag = imag_val\n\n        @property\n        def real(self) -> float:\n            return self._real\n\n        @property\n        def imag(self) -> float:\n            return self._imag\n\n        def to_complex(self) -> complex:\n            return complex(self._real, self._imag)\n\n    class HistoryRepository:\n        \"\"\"Abstract interface for storing computation history.\"\"\"\n        def record(self, value: complex, angle: float) -> None:\n            raise NotImplementedError\n        def list_recent(self, limit: int=10) -> List[Tuple[complex, float]]:\n            raise NotImplementedError\n\n    class InMemoryHistoryRepository(HistoryRepository):\n        \"\"\"In-memory FIFO storage of computation history with a maximum record limit.\"\"\"\n        def __init__(self, max_records: int=100) -> None:\n            self._records: List[Tuple[complex, float]] = []\n            self._max_records = max_records\n\n        def record(self, value: complex, angle: float) -> None:\n            self._records.append((value, angle))\n            if len(self._records) > self._max_records:\n                self._records = self._records[1:]\n\n        def list_recent(self, limit: int=10) -> List[Tuple[complex, float]]:\n            return self._records[-limit:]\n\n    class AngleService:\n        \"\"\"Service to compute the angle of a ComplexNumber and optionally record history.\"\"\"\n        def __init__(self, history_repo: Optional[HistoryRepository] = None) -> None:\n            self._history_repo = history_repo\n\n        def angle_of(self, c: ComplexNumber) -> float:\n            try:\n                real = c.real\n                imag = c.imag\n                if real == 0.0 and imag == 0.0:\n                    angle = 0.0\n                else:\n                    angle = math.atan2(imag, real)\n                angle = self._normalize_angle(angle)\n                if self._history_repo:\n                    try:\n                        self._history_repo.record(complex(real, imag), angle)\n                    except Exception: # Non-fatal for repository failures.\n                        pass\n                return angle\n            except Exception as exc:\n                raise AngleComputationError(\"Failed to compute angle\", exc)\n\n        def _normalize_angle(self, angle: float) -> float:\n            # math.atan2 already returns the principal value, this method is for future rules.\n            return angle\n\n    try:\n        c = ComplexNumber(a, b)\n        service = AngleService(history_repo=InMemoryHistoryRepository())\n        return service.angle_of(c)\n    except Exception as exc:\n        if isinstance(exc, AngleComputationError):\n            raise\n        raise AngleComputationError(\"Invalid input to angle_complex\", exc)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/128": [{"task_id": "Mbpp/128", "solution": "import re\nfrom typing import List, Any\ndef long_words(n: int, text: str) -> List[str]:\n    \"\"\"\n    Finds words that are longer than n characters from a given text.\n    All supporting classes and logic are defined inline to fulfill strict output requirements.\n    \"\"\"\n    class ValidationError(Exception):\n        \"\"\"Application-specific validation errors.\"\"\"\n        def __init__(self, message: str):\n            super().__init__(message)\n            self.message = message\n\n    class Tokenizer:\n        \"\"\"Converts text into tokens based on a regex pattern.\"\"\"\n        def __init__(self, word_pattern: str = r\"[A-Za-z0-9'-]+\"):\n            self.word_pattern = word_pattern\n            self._regex = re.compile(self.word_pattern, re.UNICODE)\n\n        def tokenize(self, text: str) -> List[str]:\n            # Following strict prompt: \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n            # for the completed function and all code within its scope.\n            return self._regex.findall(text)\n\n    class WordList:\n        \"\"\"Domain model for tokenized words, providing operations like filtering.\"\"\"\n        def __init__(self, original_text: str, words: List[str]):\n            self.original_text = original_text\n            self.words = words\n\n        def filter_longer_than(self, n: int) -> List[str]:\n            # Following strict prompt: \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n            return [word for word in self.words if len(word) > n]\n\n    class WordRepository:\n        \"\"\"Adapter to parse text and return a WordList.\"\"\"\n        def __init__(self, tokenizer_instance: Tokenizer):\n            self._tokenizer = tokenizer_instance\n\n        def parse_text(self, text: str) -> WordList:\n            # Following strict prompt: \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n            tokens = self._tokenizer.tokenize(text)\n            return WordList(text, tokens)\n\n    class LongWordsService:\n        \"\"\"Core business logic for filtering words by length.\"\"\"\n        def __init__(self, repository_instance: WordRepository):\n            self._repository = repository_instance\n\n        def get_long_words(self, min_length: int, text: str) -> List[str]:\n            # Following strict prompt: \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n            word_list = self._repository.parse_text(text)\n            return word_list.filter_longer_than(min_length)\n\n        def long_words_function(self, min_length: int, text: str) -> List[str]:\n            \"\"\"Alias for get_long_words, used as a direct library export.\"\"\"\n            return self.get_long_words(min_length, text)\n\n    # Main logic for the `long_words` function\n    repo = WordRepository(Tokenizer())\n    service = LongWordsService(repo)\n    return service.long_words_function(n, text)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/252": [{"task_id": "Mbpp/252", "solution": "import math\nfrom typing import Any, Tuple\ndef convert(value: Any) -> Tuple[float, float]:\n    \"\"\"\n    Converts a complex number or numeric input to polar coordinates (r, theta).\n    Raises ConversionError for unsupported input types.\n    \"\"\"\n\n    class ConversionError(Exception):\n        \"\"\"Custom exception for conversion failures.\"\"\"\n        def __init__(self, message: str) -> None:\n            self.message = message\n            super().__init__(message)\n\n    class ComplexNumber:\n        \"\"\"Domain model for a complex number.\"\"\"\n        def __init__(self, real: float, imag: float) -> None:\n            self._real = real\n            self._imag = imag\n\n        def to_complex(self) -> complex:\n            return complex(self._real, self._imag)\n\n    class PolarDTO:\n        \"\"\"Immutable Data Transfer Object for polar coordinates.\"\"\"\n        def __init__(self, r: float, theta: float) -> None:\n            self._r = r\n            self._theta = theta\n\n        def to_tuple(self) -> Tuple[float, float]:\n            return (self._r, self._theta)\n\n    class Utils:\n        \"\"\"Utility methods for input parsing and type coercion.\"\"\"\n        @staticmethod\n        def to_complex(value: Any) -> complex:\n            if isinstance(value, complex):\n                return value\n            if isinstance(value, ComplexNumber):\n                return value.to_complex()\n            if isinstance(value, (int, float)):\n                return complex(float(value), 0.0)\n            if isinstance(value, (list, tuple)) and len(value) == 2:\n                a, b = value\n                if isinstance(a, (int, float)) and isinstance(b, (int, float)):\n                    return complex(float(a), float(b))\n            raise ConversionError(f\"Unsupported input type for conversion: {value!r}\")\n\n    class PolarConverter:\n        \"\"\"Service for core polar coordinate conversion logic.\"\"\"\n        EPSILON: float = 1e-12\n\n        def __init__(self) -> None:\n            pass\n\n        def convert_complex(self, c: complex) -> Tuple[float, float]:\n            real, imag = c.real, c.imag\n            r = self._compute_radius(real, imag)\n            theta = self._compute_angle(