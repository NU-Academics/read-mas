essage\nclass NonNumericElementError(Exception):\n    def __init__(self, element: Any, message: str = None) -> None:\n        if message is None:\n            message = f\"Unsupported element encountered: {repr(element)}. Expected numeric or iterable.\"\n        super().__init__(message)\n        self.element = element\n        self.message = message\nSUPPORTED_NUMERIC_TYPES = (int, float, Decimal)\nclass ListSumRequest:\n    def __init__(self, input_data: Any) -> None:\n        self.input_data = input_data\nclass InputValidator:\n    SUPPORTED_STRING_TYPES = (str, bytes)\n\n    def validate_top_level(self, input_data: Any) -> None:\n        if isinstance(input_data, SUPPORTED_NUMERIC_TYPES):\n            return\n        if self.is_iterable(input_data):\n            return\n        raise InvalidInputError(\n            f\"Top-level input must be an iterable (list, tuple, set) or a numeric scalar, \"\n            f\"not {type(input_data).__name__}\"\n        )\n\n    def is_iterable(self, obj: Any) -> bool:\n        return isinstance(obj, collections.abc.Iterable) and not isinstance(obj, self.SUPPORTED_STRING_TYPES)\nclass IterableAdapter:\n    def __init__(self) -> None:\n        self._numeric_types = SUPPORTED_NUMERIC_TYPES\n\n    def flatten(self, obj: Any) -> Iterator[float]:\n        if self._is_numeric(obj):\n            yield float(obj)\n            return\n\n        if isinstance(obj, collections.abc.Iterable) and not isinstance(obj, (str, bytes)):\n            for item in obj:\n                yield from self.flatten(item)\n            return\n\n        raise NonNumericElementError(obj, f\"Unsupported element: {repr(obj)}\")\n\n    def _is_numeric(self, obj: Any) -> bool:\n        return isinstance(obj, self._numeric_types)\nclass RecursiveSumService:\n    def __init__(self, adapter: IterableAdapter) -> None:\n        self._adapter = adapter\n\n    def sum_nested(self, obj: Any) -> float:\n        total = 0.0\n        for value in self._adapter.flatten(obj):\n            total += value\n        return total\nclass ListSumController:\n    def __init__(self, service: RecursiveSumService, validator: InputValidator) -> None:\n        self._service = service\n        self._validator = validator\n\n    def handle(self, request: ListSumRequest) -> float:\n        self._validator.validate_top_level(request.input_data)\n        return self._service.sum_nested(request.input_data)\ndef recursive_list_sum(iterable: Any) -> float:\n    \"\"\"\n    Flattens a list and sums all of its numeric elements, handling nested iterables.\n    Raises InvalidInputError or NonNumericElementError for invalid inputs.\n    \"\"\"\n    adapter = IterableAdapter()\n    service = RecursiveSumService(adapter)\n    validator = InputValidator()\n    controller = ListSumController(service, validator)\n    req = ListSumRequest(iterable)\n    return controller.handle(req)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/74": [{"task_id": "Mbpp/74", "solution": "def is_samepatterns(seq, pattern):\n    \"\"\"\n    Checks if two sequences follow the same element-to-pattern mapping, ensuring consistency and injectivity.\n    Returns True if the sequences are isomorphic, False otherwise.\n    \"\"\"\n    if len(seq) != len(pattern):\n        return False\n\n    pat_to_seq = {}\n    seq_to_pat = {}\n\n    for s_elem, p_elem in zip(seq, pattern):\n        if p_elem in pat_to_seq:\n            # Check consistency: if pattern element seen, must map to same sequence element\n            if pat_to_seq[p_elem] != s_elem:\n                return False\n        else:\n            # Check injectivity: if sequence element seen, must be mapped by a new pattern element\n            if s_elem in seq_to_pat:\n                if seq_to_pat[s_elem] != p_elem: # This ensures a sequence element maps to only one pattern element\n                    return False\n            \n            # Establish new bijective mapping\n       