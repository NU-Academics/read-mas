tring.\"\"\"\n        pass\n\n    class AdverbNotFoundError(Exception):\n        \"\"\"Raised when no adverb is found in the given text.\"\"\"\n        pass\n\n    class ConfigurationError(Exception):\n        \"\"\"Raised for issues with lexicon loading or configuration.\"\"\"\n        pass\n\n    # Simplified config for inline implementation, using a default list of adverbs.\n    DEFAULT_ADVERBS = [\"clearly\", \"quickly\", \"slowly\", \"silently\", \"happily\", \"very\", \"always\", \"never\", \"often\", \"sometimes\", \"seldom\", \"almost\", \"just\", \"soon\", \"late\", \"early\", \"easily\", \"badly\", \"fully\", \"truly\", \"daily\", \"annually\", \"yearly\"]\n\n    class Token:\n        \"\"\"Represents a token with its original text, span, normalized form, and sequence index.\"\"\"\n        def __init__(self, text: str, start: int, end: int, normalized: str, index: int) -> None:\n            self.text = text\n            self.start = start\n            self.end = end\n            self.normalized = normalized\n            self.index = index\n\n    class AdverbMatch:\n        \"\"\"Encapsulates a found adverb with its character span and token index.\"\"\"\n        def __init__(self, adverb: str, start: int, end: int, token_index: int) -> None:\n            self.adverb = adverb\n            self.start = start\n            self.end = end\n            self.token_index = token_index\n\n        def as_tuple(self) -> tuple[int, int, str]:\n            \"\"\"Returns the adverb match as a (start_index, end_index, adverb) tuple.\"\"\"\n            return (self.start, self.end, self.adverb)\n\n    class TextNormalizer:\n        \"\"\"Provides methods to normalize tokens for consistent lexicon lookup.\"\"\"\n        def normalize_token(self, token: str) -> str:\n            \"\"\"Strips surrounding punctuation from a token and converts it to lowercase.\"\"\"\n            return re.sub(r\"^\\W+|\\W+$\", \"\", token).lower()\n\n    class Tokenizer:\n        \"\"\"Tokenize