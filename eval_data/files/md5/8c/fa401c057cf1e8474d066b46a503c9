th Python's heapq (which is a min-heap).\n            # The root (max_heap[0]) will be the tuple with the smallest (-value),\n            # which corresponds to the largest actual value among the k elements currently in the heap.\n            max_heap_elements = []\n            \n            for idx, (name, value) in enumerate(records_data):\n                if len(max_heap_elements) < k_val:\n                    heapq.heappush(max_heap_elements, (-value, idx, name))\n                else:\n                    # If current record's value is smaller than the largest value in the heap's root\n                    # (or same value but earlier index for stable tie-breaking), replace the root.\n                    root_neg_value, root_idx, _ = max_heap_elements[0]\n                    root_actual_value = -root_neg_value\n                    \n                    if value < root_actual_value or (value == root_actual_value and idx < root_idx):\n                        heapq.heapreplace(max_heap_elements, (-value, idx, name))\n            \n            # Convert heap elements back to (name, value) and sort them\n            # by value (ascending) then by original index (ascending) for final stable order.\n            # Sorting by (-x[0], x[1]) translates to (actual_value, original_index).\n            result = [\n                (name_item, -neg_value_item)\n                for neg_value_item, _, name_item in sorted(max_heap_elements, key=lambda x: (-x[0], x[1]))\n            ]\n            return result\n\n    # BaseRepository interface\n    class BaseRepository:\n        def get_all(self) -> List[Tuple[str, float]]:\n            raise NotImplementedError(\"Subclasses must implement get_all method\")\n\n    # InMemoryRepository implementation\n    class InMemoryRepository(BaseRepository):\n        def __init__(self, initial_records: Optional[Iterable[Tuple[str, float]]] = None) -> None:\n            self._records: List[Tuple[str, float]] = list(initial_records) if initial_records is not None else []\n\n        def get_all(self) -> List[Tuple[str, float]]:\n            return list(self._records) # Return a shallow copy of the stored records.\n\n    # MinKService orchestrates finding k smallest records.\n    class MinKService:\n        def __init__(self, repository_instance: BaseRepository, sorter_instance: BaseSorter) -> None:\n            self._repository = repository_instance\n            self._sorter = sorter_instance\n\n        def compute_min_k(self, source_records_param: Optional[Iterable[Tuple[str, float]]], k_param: int) -> List[Tuple[str, float]]:\n            \"\"\"\n            Computes the minimum k records, optionally using records from a repository.\n            \"\"\"\n            # Use provided records if available, otherwise fetch from the injected repository.\n            records_to_process = list(source_records_param) if source_records_param is not None else self._repository.get_all()\n            \n            return self._sorter.min_k(records_to_process, k_param)\n\n    # Main logic for the public min_k function:\n    # It acts as a facade, setting up the dependency graph.\n    \n    # Initialize InMemoryRepository with the input records.\n    # The 'records' parameter to this top-level function is always provided.\n    repo_instance = InMemoryRepository(records)\n    \n    # Determine which sorter to use: the provided one or the default HeapSorter.\n    chosen_sorter = sorter or HeapSorter()\n    \n    # Initialize the MinKService with the chosen repository and sorter.\n    service_instance = MinKService(repo_instance, chosen_sorter)\n    \n    # Call the service to compute the result.\n    # Pass the original records again to compute_min_k as per the design snippet.\n    return service_instance.compute_min_k(records, k)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[["Manjeet", 10], ["Akshat", 10, "Akshat"], ["Akash", 10], ["Nikhil", 10]], 1]]}], "Mbpp/760": [{"task_i