(SumError):\n    \"\"\"Raised when an element in the input is non-numeric.\"\"\"\n    pass\nDEFAULT_EMPTY_SUM: int = 0\ndef is_number(value: typing.Any) -> bool:\n    \"\"\"Checks if a value is an int or float.\"\"\"\n    return isinstance(value, numbers.Real)\ndef normalize_iterable(numbers_input: typing.Any) -> typing.Iterator[typing.Union[int, float]]:\n    \"\"\"Converts input to an iterator or raises an error.\"\"\"\n    if numbers_input is None:\n        raise InvalidInputError(\"Input is None\")\n    try:\n        return iter(numbers_input)\n    except TypeError:\n        raise InvalidInputError(\"Input is not iterable\")\nclass SumRepository:\n    \"\"\"Handles the low-level summation algorithm.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def sum_iterable(self, numbers_iter: typing.Iterator[typing.Union[int, float]]) -> typing.Union[int, float]:\n        \"\"\"Calculates the sum of an iterable of numbers.\"\"\"\n        acc: typing.Union[int, float] = DEFAULT_EMPTY_SUM\n        has_value = False\n        for v in numbers_iter:\n            acc = acc + v\n            has_value = True\n        return acc if has_value else DEFAULT_EMPTY_SUM\nclass SumService:\n    \"\"\"Validates input and orchestrates summation with the repository.\"\"\"\n    def __init__(self, repository: SumRepository) -> None:\n        self._repository = repository\n\n    def compute(self, numbers: typing.Sequence[typing.Union[int, float]]) -> typing.Union[int, float]:\n        \"\"\"Computes the sum after validating inputs.\"\"\"\n        number_iterator = normalize_iterable(numbers)\n        validated_numbers: typing.List[typing.Union[int, float]] = []\n        for element in number_iterator:\n            if not is_number(element):\n                raise InvalidElementError(f\"Element '{element}' is not a valid number.\")\n            validated_numbers.append(element)\n        \n        return self._repository.sum_iterable(iter(validated_numbers))\nclass SumController:\n    \"\"\"Adapts caller requests to the SumService.\"\"\"\n    def __init__(self, service: SumService) -> None:\n        self._service = service\n\n    def request_sum(self, numbers: typing.Sequence[typing.Union[int, float]]) -> typing.Union[int, float]:\n        \"\"\"Processes a request to sum a sequence of numbers.\"\"\"\n        return self._service.compute(numbers)\ndef _sum(numbers: typing.Sequence[typing.Union[int, float]]) -> typing.Union[int, float]:\n    \"\"\"Calculates the sum of an array of numbers.\"\"\"\n    repo = SumRepository()\n    service = SumService(repo)\n    controller = SumController(service)\n    return controller.request_sum(numbers)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/801": [{"task_id": "Mbpp/801", "solution": "def test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"Counts the number of equal integers among the three inputs.\n    Returns 3 if all are equal, 2 if exactly two are equal, and 0 if none are equal.\n    \"\"\"\n    if a == b == c:\n        return 3\n    if a == b or b == c or a == c:\n        return 2\n    return 0", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/804": [{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers: Sequence[Union[int, float]]) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even by checking for any even factor.\n    Assumes numbers are integers or floats representing integers.\n    \"\"\"\n    for num in numbers:\n        # Convert to an integer for the parity check.\n        # Based on preconditions, any float is guaranteed to be integer-like (e.g., 2.0).\n        int_val = int(num)\n        \n        # If any number in the list is even, their product will also be even.\n        if (int_val % 2) == 0:\n            return True\n            \n    # If no even numbers were found in the list, all numbers are odd,\n    # and therefore their product 