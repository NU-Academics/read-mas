t be an iterable of integers\")\n    return list(iterable)\nclass MulService:\n    \"\"\"Core business logic for finding and multiplying the first even and odd numbers.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def find_first_even_and_odd(self, numbers: List[int]) -> Tuple[int, int]:\n        \"\"\"Scans the list to find the first odd and first even numbers.\"\"\"\n        first_odd = None\n        first_even = None\n        for n in numbers:\n            if first_odd is None and n % 2 != 0:\n                first_odd = n\n            if first_even is None and n % 2 == 0:\n                first_even = n\n            if first_odd is not None and first_even is not None:\n                break\n        if first_odd is None:\n            raise MissingValueError(\"No odd number found in input\")\n        if first_even is None:\n            raise MissingValueError(\"No even number found in input\")\n        return first_odd, first_even\n\n    def find_first_even_odd_product(self, numbers: List[int]) -> int:\n        \"\"\"Finds the first odd and even numbers and returns their product.\"\"\"\n        odd, even = self.find_first_even_and_odd(numbers)\n        return odd * even\nclass MulController:\n    \"\"\"Facade for the service layer, handling input validation and delegation.\"\"\"\n    def __init__(self, service: MulService = None) -> None:\n        self._service = service or MulService()\n\n    def mul_even_odd(self, numbers: Iterable[int]) -> int:\n        \"\"\"Validates input, then calls the service to compute the product.\"\"\"\n        nums: List[int] = to_int_list(numbers)\n        return self._service.find_first_even_odd_product(nums)\ndef mul_even_odd(numbers: Iterable[int]) -> int:\n    \"\"\"Finds the product of the first even and first odd number in a list.\"\"\"\n    controller = MulController()\n    return controller.mul_even_odd(numbers)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/786": [{"task_id": "Mbpp/786", "solution": "def right_insertion(items, value):\n    \"\"\"\n    Locates the right insertion point for a specified value in sorted order using binary search.\n    This function assumes the input list `items` is already sorted in non-decreasing order.\n    \"\"\"\n    low = 0\n    high = len(items)\n    while low < high:\n        mid = (low + high) // 2\n        if items[mid] <= value:\n            low = mid + 1\n        else:\n            high = mid\n    return low", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/788": [{"task_id": "Mbpp/788", "solution": "def new_tuple(input_list, item):\n    \"\"\"\n    Creates a new tuple by concatenating elements from an input list and a single string item.\n    Assumes inputs are already validated to be iterable of strings and a string, respectively.\n    \"\"\"\n    return tuple(input_list) + (item,)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/785": [{"task_id": "Mbpp/785", "solution": "class TupleParseError(ValueError):\n    \"\"\"Exception raised for issues with tuple string format.\"\"\"\n    pass\nclass TupleConversionError(TupleParseError):\n    \"\"\"Exception raised when a tuple element cannot be converted to an integer.\"\"\"\n    pass\ndef strip_parens(s: str) -> str:\n    \"\"\"Trims whitespace and removes outer parentheses from a string.\"\"\"\n    t = s.strip()\n    if len(t) < 2 or t[0] != '(' or t[-1] != ')':\n        raise TupleParseError(\"missing surrounding parentheses\")\n    return t[1:-1].strip()\ndef safe_int(s: str) -> int:\n    \"\"\"Converts a string to an integer, raising TupleConversionError on failure.\"\"\"\n    try:\n        return int(s)\n    except ValueError as e:\n        raise TupleConversionError(f\"cannot convert '{s}' to int\") from e\nclass TupleDTO:\n    \"\"\"Data Transfer Object for a tuple of integers.\"\"\"\n    def __init__(self, values: tuple[int, ...]) -> None:\n        self.values = values\n\n    @classmethod\n    def from_list(cls, values: list[int]) -> 'TupleDTO':\n        \"\"\"Creates a TupleDTO from a list of integers.\"\"\"\n        return cls(tuple(values))\n\n    def as_tuple(self) -> tuple[int, ...]:\n        \"\"\"Returns the underlying tuple of integers.\"\"\"\n        return self.values\nclass TupleStringValidator:\n    \"\"\"Validates the high-level format of a tuple string.\"\"\"\n    def validate(self, s: str) -> bool:\n        \"\"\"Checks if the string starts and ends with parentheses.\"\"\"\n        t = s.strip()\n        if not (t.startswith(\"(\") and t.endswith(\")\")):\n            raise TupleParseError(\"tuple must start with '(' and end with ')'\")\n        return True\nclass TupleStringParser:\n    \"\"\"Parses a validated tuple string into a list of element strings.\"\"\"\n    def tokenize(self, s: str) -> list[str]:\n        \"\"\"Removes outer parentheses and splits the content by commas.\"\"\"\n        inner = strip_parens(s)\n        if inner == \"\":\n            return []\n        tokens = [tok.strip() for tok in inner.split(\",\")]\n        if any(tok == \"\" for tok in tokens):\n            raise TupleParseError(\"empty element detected (possible stray comma)\")\n        return tokens\nclass TupleConverterService:\n    \"\"\"Orchestrates validation, parsing, and conversion of a tuple string to an integer tuple.\"\"\"\n    def __init__(self, validator: TupleStringValidator=None, parser: TupleStringParser=None) -> None:\n        self._validator = validator or TupleStringValidator()\n        self._parser = parser or TupleStringParser()\n\n    def convert(self, s: str) -> tuple[int, ...]:\n        \"\"\"Converts a tuple string to a tuple of integers.\"\"\"\n        self._validator.validate(s)\n        tokens = self._parser.tokenize(s)\n        ints = []\n        for tok in tokens:\n            ints.append(safe_int(tok))\n        dto = TupleDTO.from_list(ints)\n        return dto.as_tuple()\n_default_service = TupleConverterService()\ndef tuple_str_int(s: str) -> tuple[int, ...]:\n    \"\"\"Converts a string representation of an integer tuple to an actual Python tuple of ints.\"\"\"\n    return _default_service.convert(s)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["((7, 8, 9)"]]}], "Mbpp/790": [{"task_id": "Mbpp/790", "solution": "def even_position(numbers):\n    \"\"\"\n    Checks if every number at an even index in the list is even.\n    Returns True for an empty list.\n    \"\"\"\n    for i in range(0, len(numbers), 2):\n        if numbers[i] % 2 != 0:\n            return False\n    return True", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[2, 1, 4, 2, 6, 1, 8, 2, 10, 1, 12]]]}], "Mbpp/787": [{"task_id": "Mbpp/787", "solution": "import re\nimport datetime\nimport logging\nimport sqlite3\nimport os\nfrom typing import Pattern, List, Dict\nclass ValidationError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass AppConfig:\n    DB_PATH: str = \"data/matches.db\"\n    PATTERN: str = r\"^ab{3}$\"\n    DB_TIMEOUT: float = 5.0\nclass TextMatcher:\n    def __init__(self, pattern: str) -> None:\n        self._pattern: str = pattern\n        self._compiled: Pattern = re.compile(pattern)\n\n    def matches(self, text: str) -> bool:\n        return self._compiled.fullmatch(text) is not None\nclass Validator:\n    def __init__(self) -> None:\n        pass\n\n    def validate_text(self, text: str) -> None:\n        if not isinstance(text, str):\n            raise ValidationError(\"text must be a str\")\n        if text == \"\":\n            raise ValidationError(\"text must be non-empty\")\ndef now_iso() -> str:\n    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='milliseconds')\nclass LoggerAdapter:\n    def __init__(self, name: str = \"textmatcher\") -> None:\n        logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n        self._logger = logging.getLogger(name)\n\n    def log(self, msg: str) -> None:\n        self._logger.info(msg)\n\n    def debug(self, msg: str) -> None:\n        self._logger.debug(msg)\n\n    def error(self, msg: str) -> None:\n        self._logger.error(msg)\nclass Migration:\n    def __init__(self, db_path: str) -> None:\n        self._db_path = db_path\n\n    def ensure_schema(self) -> None:\n        db_dir = os.path.dirname(self._db_path)\n        if db_dir and not os.path.exists(db_dir):\n            os.makedirs(db_dir, exist_ok=True)\n        conn = None\n        try:\n            conn = sqlite3.connect(self._db_path)\n            cur = conn.cursor()\n            cur.execute(\"\"\"\n                CREATE TABLE IF NOT EXISTS matches (\n                  id INTEGER PRIMARY KEY AUTOINCREMENT,\n                  text TEXT NOT NULL,\n                  matched INTEGER NOT NULL CHECK (matched IN (0,1)),\n                  timestamp TEXT NOT NULL\n                );\n            \"\"\")\n            cur.execute(\"CREATE INDEX IF NOT EXISTS idx_matches_text ON matches(text);\")\n            cur.execute(\"CREATE INDEX IF NOT EXISTS idx_matches_timestamp ON matches(timestamp);\")\n            conn.commit()\n        finally:\n            if conn:\n                conn.close()\nclass MatchRepository:\n    def __init__(self, db_path: str, timeout: float = 5.0) -> None:\n        self._db_path = db_path\n        self._timeout = timeout\n        Migration(db_path).ensure_schema()\n\n    def _connect(self) -> sqlite3.Connection:\n        return sqlite3.connect(self._db_path, timeout=self._timeout, check_same_thread=False)\n\n    def save(self, text: str, matched: bool, timestamp: str) -> int:\n        conn = self._connect()\n        cur = conn.cursor()\n        cur.execute(\"INSERT INTO matches (text, matched, timestamp) VALUES (?, ?, ?)\", (text, int(matched), timestamp))\n        conn.commit()\n        rowid = cur.lastrowid\n        conn.close()\n        return rowid\n\n    def get_recent(self, limit: int = 100) -> List[Dict]:\n        conn = self._connect()\n        cur = conn.cursor()\n        cur.execute(\"SELECT id, text, matched, timestamp FROM matches ORDER BY id DESC LIMIT ?\", (limit,))\n        rows = cur.fetchall()\n        conn.close()\n        return [{\"id\": r[0], \"text\": r[1], \"matched\": bool(r[2]), \"timestamp\": r[3]} for r in rows]\nclass MatchService:\n    def __init__(self, matcher: TextMatcher, validator: Validator, repository: MatchRepository, logger: LoggerAdapter, config: AppConfig) -> None:\n        self._matcher = matcher\n        self._validator = validator\n        self._repository = repository\n        self._logger = logger\n        self._config = config\n\n    def text_match_three(self, text: str) -> bool:\n        self._validator.validate_text(text)\n        matched = self._matcher.matches(text)\n        timestamp = now_iso()\n        try:\n            self._repository.save(text, matched, timestamp)\n        except Exception as e:\n            self._logger.error(f\"Failed to persist match: {e}\")\n            raise\n        self._logger.log(f\"text={text} matched={matched} at {timestamp}\")\n        return matched\n_config = AppConfig()\n_matcher = TextMatcher(_config.PATTERN)\n_validator = Validator()\n_repository = MatchRepository(_config.DB_PATH, timeout=_config.DB_TIMEOUT)\n_logger = LoggerAdapter()\n_service = MatchService(_matcher, _validator, _repository, _logger, _config)\ndef text_match_three(text: str) -> bool:\n    \"\"\"\n    Checks if the given string matches the pattern 'a' followed by exactly three 'b's (\"abbb\").\n    Persists the check result to a local database.\n    \"\"\"\n    return _service.text_match_three(text)", "base_status": "timeout", "plus_status": "timeout", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/791": [{"task_id": "Mbpp/791", "solution": "def remove_