Raised when input n is invalid.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass ComputationError(CatalanError):\n    \"\"\"Raised when a computation fails unexpectedly.\"\"\"\n    pass\nclass CacheError(CatalanError):\n    \"\"\"Raised when cache operations fail.\"\"\"\n    pass\ndef nCr(n: int, r: int) -> int:\n    \"\"\"Computes binomial coefficient C(n, r) efficiently using multiplicative method.\"\"\"\n    if r < 0 or r > n:\n        return 0\n    if r == 0 or r == n:\n        return 1\n    if r > n // 2:\n        r = n - r\n    \n    result = 1\n    for i in range(r):\n        result = result * (n - i) // (i + 1)\n    return result\ndef catalan_binomial(n: int) -> int:\n    \"\"\"Computes the nth Catalan number using the binomial coefficient formula.\"\"\"\n    if n < 0:\n        raise ComputationError(\"Catalan numbers are not defined for negative n.\")\n    # Catalan(n) = C(2n, n) / (n + 1)\n    return nCr(2 * n, n) // (n + 1)\nDEFAULT_CACHE_PATH: str = os.path.expanduser(\"~/.cache/catalan_cache.json\")\nclass CacheStore:\n    \"\"\"In-memory cache for Catalan numbers.\"\"\"\n    def __init__(self) -> None:\n        self._store: Dict[int, int] = {}\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a Catalan number from the in-memory cache.\"\"\"\n        return self._store.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a Catalan number in the in-memory cache.\"\"\"\n        self._store[n] = value\n\n    def contains(self, n: int) -> bool:\n        \"\"\"Checks if a Catalan number is in the in-memory cache.\"\"\"\n        return n in self._store\nclass FileCacheAdapter:\n    \"\"\"Disk-backed cache for Catalan numbers using a JSON file.\"\"\"\n    def __init__(self, path: str) -> None:\n        self.path: str = path\n        self._mapping: Dict[str, str] = {}\n        try:\n            self._mapping = self.load()\n        except CacheError:\n            self._mapping = {} \n\n    def load(self) -> Dict[str, str]:\n        \"\"\"Loads the cache from the file.\"\"\"\n        if not os.path.exists(self.path):\n            return {}\n        try:\n            with open(self.path, 'r', encoding='utf-8') as f:\n                return json.load(f)\n        except (IOError, json.JSONDecodeError) as e:\n            raise CacheError(f\"Failed to load cache from {self.path}: {e}\") from e\n\n    def save(self, mapping: Dict[str, str]) -> None:\n        \"\"\"Saves the cache to the file atomically.\"\"\"\n        try:\n            os.makedirs(os.path.dirname(self.path), exist_ok=True)\n            temp_path = self.path + \".tmp\"\n            with open(temp_path, 'w', encoding='utf-8') as f:\n                json.dump(mapping, f)\n            os.replace(temp_path, self.path)\n        except IOError as e:\n            raise CacheError(f\"Failed to save cache to {self.path}: {e}\") from e\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a Catalan number from the file cache.\"\"\"\n        str_n = str(n)\n        if str_n in self._mapping:\n            try:\n                return int(self._mapping[str_n])\n            except ValueError:\n                del self._mapping[str_n]\n        return None\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a Catalan number in the file cache and persists.\"\"\"\n        str_n = str(n)\n        self._mapping[str_n] = str(value)\n        try:\n            self.save(self._mapping)\n        except CacheError:\n            pass\nclass CatalanService:\n    \"\"\"Orchestrates validation, caching, and computation of Catalan numbers.\"\"\"\n    def __init__(self, cache: CacheStore, file_adapter: Optional[FileCacheAdapter] = None, max_n: int = 5000) -> None:\n        self.cache = cache\n        self.file_adapter = file_adapter\n        self.max_n = max_n\n\n    def _validate(self, n: int) -> None:\n        \"\"\"Validates the input n.\"\"\"\n        if not isinstance(n, int):\n            raise InvalidInputError(f\"Input must be an integer, got {type(n).__name__}.\")\n        if n < 0:\n            raise InvalidInputError(f\"Input n must be non-negative, got {n}.\")\n        if n > self.max_n:\n            raise InvalidInputError(f\"Input n exceeds maximum allowed value of {self.max_n}.\")\n\n    def _compute_via_strategy(self, n: int) -> int:\n        \"\"\"Decides which algorithm to use for computation.\"\"\"\n        try:\n            return catalan_binomial(n)\n        except Exception as e:\n            raise ComputationError(f\"Error computing Catalan({n}): {e}\") from e\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the nth Catalan number, using cache and persistence.\"\"\"\n        self._validate(n)\n\n        cached = self.cache.get(n)\n        if cached is not None:\n            return cached\n\n        if self.file_adapter:\n            cached = self.file_adapter.get(n)\n            if cached is not None:\n                self.cache.set(n, cached)\n                return cached\n        \n        value = self._compute_via_strategy(n)\n        \n        self.cache.set(n, value)\n        if self.file_adapter:\n            try:\n                self.file_adapter.set(n, value)\n            except CacheError:\n                pass\n        return value\n_global_cache_store = CacheStore()\n_global_file_cache_adapter = FileCacheAdapter(DEFAULT_CACHE_PATH)\n_global_catalan_service = CatalanService(\n    cache=_global_cache_store,\n    file_adapter=_global_file_cache_adapter,\n    max_n=5000\n)\ndef catalan_number(n: int) -> int:\n    \"\"\"\n    Returns the nth Catalan number, using an internally managed caching service.\n    \"\"\"\n    return _global_catalan_service.compute(n)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[10]], "plus_fail_tests": [[0]]}], "Mbpp/409": [{"task_id": "Mbpp/409", "solution": "from typing import Iterable, Tuple\nfrom dataclasses import dataclass\ndef min_product_tuple(pairs: Iterable[Tuple[int, int]]) -> int:\n    \"\"\"Calculates the minimum product from a list of 2-element tuples.\n    Each tuple contains two integers whose product is computed.\n    \"\"\"\n    @dataclass(frozen=True)\n    class Pair:\n        a: int\n        b: int\n\n        def product(self) -> int:\n            return self.a * self.b\n\n    # This implementation assumes the input `pairs` is well-formed\n    # (an iterable of 2-element tuples containing integers) and non-empty,\n    # as per the \"DO NOT add isinstance() checks or raise exceptions for edge cases\" constraint.\n    # It directly applies the core logic derived from the MinProductService.\n    products = [Pair(a, b).product() for a, b in pairs]\n    return min(products)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/568": [{"task_id": "Mbpp/568", "solution": "def empty_list(N):\n    \"\"\"\n    Creates a list of N empty dictionaries, where each dictionary is a distinct object.\n    \"\"\"\n    return [{} for _ in range(N)]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/462": [{"task_id": "Mbpp/462", "solution": "def combinations_list(items: list) -> list:\n    \"\"\"\n    Generates all possible combinations (power set) of elements in a list.\n    The combinations are generated in a specific iterative-prepend order.\n    \"\"\"\n    result = [[]]\n    for item in items:\n        new_subsets = [[item] + subset for subset in result]\n        result.extend(new_subsets)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/588": [{"task_id": "Mbpp/588", "solution": "from typing import Sequence\ndef big_diff(items: Sequence[int | float]) -> float:\n    \"\"\"\n    Calculates the difference between the largest and smallest value in a given list.\n    Returns the result as a float.\n    \"\"\"\n    largest =