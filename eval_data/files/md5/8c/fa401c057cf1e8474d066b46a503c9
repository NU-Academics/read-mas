o B_i,i\n        for i in range(1, n + 1):\n            # The first element of the next row is the last element of the current row\n            row = [bell[-1]]\n            for j in range(1, i + 1):\n                # B(i,j) = B(i,j-1) + B(i-1,j-1)\n                # row[-1] is B(i,j-1), bell[j-1] is B(i-1,j-1)\n                row.append(row[-1] + (bell[j-1])) # The design snippet had `if j-1 < len(bell) else 0`,\n                                                  # but given how `bell` is updated, `j-1` will always be in bounds for `bell`.\n            bell = row # Update bell to be the newly computed row\n        return bell[0] # The Bell number B_n is the first element of the computed row\ndef _validate_non_negative_int(value: any) -> int:\n    \"\"\"Validates that the input is a non-negative integer.\"\"\"\n    if not isinstance(value, int) or value < 0:\n        raise InvalidParameterError(\"Input 'n' must be a non-negative integer.\")\n    return value\n_cache = CacheRepository()\n_calc = BellNumberCalculator(cache_repo=_cache)\ndef bell_number(n: int) -> int:\n    \"\"\"\n    Finds the number of ways to partition an n-element set.\n    This function computes the nth Bell number using dynamic programming.\n    \"\"\"\n    return _calc.compute(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/79": [{"task_id": "Mbpp/79", "solution": "def word_len(word: str) -> bool:\n    \"\"\"Checks if the length of a word is odd.\n\n    Returns True if the length is odd, False otherwise.\n    \"\"\"\n    return len(word) % 2 != 0", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/85": [{"task_id": "Mbpp/85", "solution": "import math\ndef surfacearea_sphere(radius):\n    \"\"\"\n    Calculates the surface area of a sphere.\n    Formula: A = 4 * pi * r^2\n    \"\"\"\n    return 4 * math.pi * (radius ** 2)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [