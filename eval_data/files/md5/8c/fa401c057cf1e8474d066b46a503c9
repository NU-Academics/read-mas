ller:\n    \"\"\"Handles external requests and delegates to the TextMatcherService.\"\"\"\n    def __init__(self, service: TextMatcherService):\n        self.service = service\n\n    def validate(self, text: str) -> bool:\n        \"\"\"Validates input and checks if text contains a word with 'z'.\"\"\"\n        if not isinstance(text, str):\n            raise InvalidInputError(\"text must be a string\")\n        \n        result = self.service.match_wordz(text)\n        return result is not None\n_default_service = TextMatcherService(regex_factory=RegexFactory(), repository=MatchRepository())\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"Checks if the input text contains a word with the letter 'z' (case-insensitive).\"\"\"\n    controller = ValidatorController(_default_service)\n    return controller.validate(text)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/457": [{"task_id": "Mbpp/457", "solution": "def Find_Min(list_of_lists):\n    \"\"\"\n    Finds the sublist with the minimum length from a list of lists.\n    Returns the first encountered sublist in case of a tie in length.\n    \"\"\"\n    min_length = float('inf')\n    min_sublist = None\n\n    for sublist in list_of_lists:\n        current_length = len(sublist)\n        if current_length < min_length:\n            min_length = current_length\n            min_sublist = sublist\n            \n    return min_sublist", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/456": [{"task_id": "Mbpp/456", "solution": "def reverse_string_list(strings: list[str]) -> list[str]:\n    \"\"\"Reverses each string in the given list of string values.\n    Returns a new list with all strings reversed, preserving their original order.\n    \"\"\"\n    return [s[::-1] for s in strings]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/459": [{"task_id": "Mbpp/459", "