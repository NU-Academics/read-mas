nitializes the service, optionally with a custom repository.\n            self._repo = repo or EuclidRepository()\n\n        def find_solution(self, a_val: int, b_val: int, n_val: int) -> Optional[LinearSolution]:\n            # Finds a particular integer solution (x, y) for a*x + b*y = n.\n            g, xg, yg = self._repo.extended_gcd(a_val, b_val)\n\n            if n_val % g != 0:\n                return None\n\n            factor = n_val // g\n            x = xg * factor\n            y = yg * factor\n\n            return LinearSolution(x=x, y=y, a=a_val, b=b_val, n=n_val, gcd=g)\n\n    def make_service() -> DiophantineService:\n        # Factory function to create a DiophantineService with default dependencies.\n        return DiophantineService(repo=EuclidRepository())\n\n    svc = make_service()\n    sol = svc.find_solution(a, b, n)\n    return sol.to_tuple() if sol is not None else None", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[2, 3, 7]], "plus_fail_tests": [[25, 10, 500]]}], "Mbpp/162": [{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"Calculates the sum of the series n + (n-2) + (n-4) ... until the terms are non-positive.\"\"\"\n    if n <= 0:\n        return 0\n    # Calculate the number of terms (m) in the arithmetic progression.\n    # The last term is n - 2*k >= 0, so k <= n/2.\n    # The terms are for k=0, 1, ..., floor(n/2), so m = floor(n/2) + 1.\n    m = (n // 2) + 1\n    # Use the sum of an arithmetic series formula: Sum = m/2 * (first_term + last_term)\n    # The first term is 'n'. The last term is n - 2 * (m-1).\n    total = m * (2 * n + (m - 1) * (-2)) // 2\n    return total", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/167": [{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Handles non-negative integers.\n    \"\"\"\n    if n <= 1