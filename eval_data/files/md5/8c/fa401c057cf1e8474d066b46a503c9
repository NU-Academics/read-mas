or valid input 'n'\n    MAX_N: int = 10000\n\n    # --- Models (from models.py) ---\n    @dataclass\n    class BellResult:\n        n: int\n        value: int\n        computed_at: datetime\n\n        def to_dict(self) -> dict:\n            return {\"n\": self.n, \"value\": str(self.value), \"computed_at\": self.computed_at.isoformat()}\n\n    # --- Utils (from utils.py) ---\n    class MathUtils:\n        @staticmethod\n        def is_valid_n(n: int, max_n: int) -> bool:\n            return isinstance(n, int) and 0 <= n <= max_n\n\n        @staticmethod\n        def compute_bell_triangle(n: int) -> int:\n            \"\"\"Computes the nth Bell number using the Bell triangle algorithm.\"\"\"\n            if n == 0:\n                return 1\n            # The Bell triangle starts with B(0)=1. Each row's first element is B(i).\n            triangle: List[List[int]] = [[1]]\n            for i in range(1, n + 1):\n                # Start new row with the last element of the previous row.\n                row = [triangle[i - 1][-1]]\n                for j in range(1, i + 1):\n                    # Each subsequent element is the sum of the element to its left in the current row\n                    # and the element above-left in the previous row.\n                    row.append(row[j - 1] + triangle[i - 1][j - 1])\n                triangle.append(row)\n            return triangle[n][0] # The nth Bell number is the first element of the nth row.\n\n    # --- Repositories (from repositories.py) ---\n    class BellRepository(ABC):\n        \"\"\"Abstract base class defining the contract for Bell number repositories.\"\"\"\n        @abstractmethod\n        def get(self, n: int) -> Optional[int]:\n            pass\n\n        @abstractmethod\n        def set(self, n: int, value: int) -> None:\n            pass\n\n        @abstractmethod\n        def clear(self) -> None:\n            pass\n\n    class InMemoryBellRepository(BellRepository):\n        \"\"\"An in-memory cache implementation of the BellRepository.\"\"\"\n        def __init__(self) -> None:\n            self._cache: dict[int, int] = {}\n\n        def get(self, n: int) -> Optional[int]:\n            return self._cache.get(n)\n\n        def set(self, n: int, value: int) -> None:\n            self._cache[n] = value\n\n        def clear(self) -> None:\n            self._cache.clear()\n\n    # --- Services (from services.py) ---\n    class BellService:\n        \"\"\"Manages the computation and caching logic for Bell numbers.\"\"\"\n        def __init__(self, repo: BellRepository, utils: MathUtils, max_n: int) -> None:\n            self._repo = repo\n            self._utils = utils\n            self._max_n = max_n\n\n        def compute(self, n: int) -> BellResult:\n            \"\"\"Computes or retrieves the nth Bell number, handling validation and caching.\"\"\"\n            if not self._utils.is_valid_n(n, self._max_n):\n                raise InvalidInputError(f\"n must be an integer in [0, {self._max_n}], got {n}\")\n\n            cached = self._repo.get(n)\n            if cached is not None:\n                return BellResult(n=n, value=cached, computed_at=datetime.utcnow())\n            try:\n                val = self._compute_and_cache(n)\n                return BellResult(n=n, value=val, computed_at=datetime.utcnow())\n            except Exception as e:\n                raise BellComputationError(f\"Error computing Bell number for n={n}: {e}\")\n\n        def _compute_and_cache(self, n: int) -> int:\n            \"\"\"Computes the Bell number for n and stores it in the repository.\"\"\"\n            val = self._utils.compute_bell_triangle(n)\n            self._repo.set(n, val)\n            return val\n\n    # --- Controllers (from controllers.py) ---\n    class BellController:\n        \"\"\"A facade that exposes Bell number computation via the BellService.\"\"\"\n        def __init__(self, service: BellService) -> None:\n            self._service = service\n\n        def get_bell(self, n: int) -> int:\n            \"\"\"Retrieves the nth Bell number.\"\"\"\n            result = self._service.compute(n)\n            return result.value\n\n    # --- Dependency Initialization for the bell_Number function ---\n    # These instances serve as the default dependencies for the public API.\n    _default_repo = InMemoryBellRepository()\n    _default_utils = MathUtils()\n    _default_service = BellService(_default_repo, _default_utils, MAX_N)\n    _default_controller = BellController(_default_service)\n\n    # --- Public API Call ---\n    return _default_controller.get_bell(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/741": [{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(text: str) -> bool:\n    \"\"\"Checks if all characters in the given string are identical.\n    Returns True for empty or single-character strings.\n    \"\"\"\n    if len(text) <= 1:\n        return True\n\n    first_char = text[0]\n    for char in text:\n        if char != first_char:\n            return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/743": [{"task_id": "Mbpp/743", "solution": "def rotate_right(input_list, items_to_rotate):\n    \"\"\"\n    Rotates a list to the right by a specified number of items.\n    \"\"\"\n    n = len(input_list)\n    if n == 0:\n        return []\n\n    k = items_to_rotate % n\n\n    if k == 0:\n        return list(input_list)\n\n    return list(input_list[-k:]) + list(input_list[:-k])", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/740": [{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input_tuple: tuple) -> dict:\n    \"\"\"Converts a tuple of adjacent key-value pairs into a dictionary.\"\"\"\n    result = {}\n    for i in range(0, len(input_tuple), 2):\n        key = input_tuple[i]\n        value = input_tuple[i + 1]\n   