tion):\n        \"\"\"Raised for internal computation errors.\"\"\"\n        pass\n\n    def validate_input(input_a: Sequence[Any], input_b: Sequence[Any], input_k: int) -> None:\n        \"\"\"Validates the inputs for type and value correctness, raising InvalidInputError on failure.\"\"\"\n        if not isinstance(input_a, collections.abc.Sequence) or not isinstance(input_b, collections.abc.Sequence):\n            raise InvalidInputError(\"Input 'a' and 'b' must be sequences.\")\n\n        if not isinstance(input_k, int) or input_k <= 0:\n            raise InvalidInputError(\"Input 'k' must be a positive integer.\")\n\n        for lst, name in [(input_a, 'a'), (input_b, 'b')]:\n            for i, item in enumerate(lst):\n                if not isinstance(item, (int, float)):\n                    raise InvalidInputError(f\"Element at index {i} in list '{name}' is not a number: {item}\")\n\n    class Repository(Protocol):\n        \"\"\"Protocol for data persistence or audit.\"\"\"\n        def save_computation(self, input_a: Sequence[float], input_b: Sequence[float], k: int, results: Sequence[float]) -> None:\n            ...\n\n    class InMemoryRepository:\n        \"\"\"An in-memory implementation of the Repository protocol for audit logging.\"\"\"\n        def __init__(self) -> None:\n            self._store: List[Dict[str, Any]] = []\n            self._next_id = 1\n\n        def save_computation(self, input_a: Sequence[float], input_b: Sequence[float], k: int, results: Sequence[float]) -> None:\n            self._store.append({\n                \"id\": self._next_id,\n                \"timestamp\": datetime.datetime.now(datetime.timezone.utc).isoformat(),\n                \"input_a\": list(input_a),\n                \"input_b\": list(input_b),\n                \"k\": k,\n                \"results\": list(results)\n            })\n            self._next_id += 1\n\n        def get_all(self) -> List[Dict[str, Any]]:\n            return self._store\n\n    class MaxHeapCombiner:\n        \"\"\"\n        Efficiently generates top-k pairwise products using a max-heap strategy.\n        It sorts input lists descending by value and uses a min-heap to extract\n        the largest products by storing negated product values.\n        \"\"\"\n        def get_top_k(self, a_seq: Sequence[float], b_seq: Sequence[float], k_val: int) -> List[float]:\n            if not a_seq or not b_seq or k_val <= 0:\n                return []\n\n            A = sorted([float(x) for x in a_seq], reverse=True)\n            B = sorted([float(x) for x in b_seq], reverse=True)\n\n            m, n = len(A), len(B)\n            \n            heap: List[Tuple[float, int, int]] = []\n            visited: Set[Tuple[int, int]] = set()\n            results: List[float] = []\n\n            if m > 0 and n > 0:\n                initial_product = A[0] * B[0]\n                heapq.heappush(heap, (-initial_product, 0, 0))\n                visited.add((0, 0))\n\n            while heap and len(results) < k_val:\n                neg_prod, i, j = heapq.heappop(heap)\n                results.append(-neg_prod)\n\n                if i + 1 < m and (i + 1, j) not in visited:\n                    next_product_a = A[i+1] * B[j]\n                    heapq.heappush(heap, (-next_product_a, i + 1, j))\n                    visited.add((i + 1, j))\n\n                if j + 1 < n and (i, j + 1) not in visited:\n                    next_product_b = A[i] * B[j+1]\n                    heapq.heappush(heap, (-next_product_b, i, j + 1))\n                    visited.add((i, j + 1))\n            \n            return results\n\n    class LargeProductService:\n        \"\"\"\n        Provides business logic for computing top-k products, handling input validation,\n        applying a safety cap, and optionally auditing the computation results.\n        \"\"\"\n        DEFAULT_MAX_K: int = 100000 \n\n        def __init__(self, combiner: MaxHeapCombiner, repository: Optional[Repository] = None) -> None:\n            self._combiner = combiner\n            self._repo = repository\n\n        def compute_top_k(self, a_list: Sequence, b_list: Sequence, k_param: int) -> List[float]:\n            validate_input(a_list, b_list, k_param)\n\n            if k_param > self.DEFAULT_MAX_K:\n                raise InvalidInputError(f\"Value for 'k' is too large (>{self.DEFAULT_MAX_K}).\")\n\n            try:\n                results = self._combiner.get_top_k(a_list, b_list, k_param)\n                \n                if self._repo:\n                    self._repo.save_computation(a_list, b_list, k_param, results)\n                \n                return results\n            except Exception as exc:\n                raise ComputationError(f\"An error occurred during product computation: {exc}\") from exc\n\n    # Wire up the dependencies and execute the service\n    combiner_instance = MaxHeapCombiner()\n    repo_instance = InMemoryRepository() \n    service_instance = LargeProductService(combiner_instance, repository=repo_instance)\n\n    return service_instance.compute_top_k(a, b, k)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/390": [{"task_id": "Mbpp/390", "solution": "def add_string(values, fmt):\n    \"\"\"\n    Applies a given format string to all elements in a list.\n    Converts each value to a string before formatting.\n    \"\"\"\n    results = []\n    for value in values:\n        results.append(fmt.format(value))\n    return results", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/312": [{"task_id": "Mbpp/312", "solution": "import math\ndef volume_cone(radius: float, height: float) -> float:\n    \"\"\"\n    Calculates the volume of a right circular cone given its radius and height.\n    Assumes valid positive float inputs based on explicit constraints.\n    \"\"\"\n    return (1.0 / 3.0) * math.pi * (radius ** 2) * height", "base_status": "pass", "plus_