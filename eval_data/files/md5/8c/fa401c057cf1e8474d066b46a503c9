        self._store[name] = total\n\n    def get_aggregate(self, name: str) -> int | None:\n        return self._store.get(name)\n\n    def list_aggregates(self) -> dict[str, int]:\n        return dict(self._store)\n\n    def clear(self) -> None:\n        self._store.clear()\nclass EntryParser:\n    @staticmethod\n    def parse_list(raw: Iterable) -> list[AggregateEntry]:\n        entries = []\n        for item in raw:\n            if isinstance(item, AggregateEntry):\n                entries.append(item)\n            elif isinstance(item, tuple) and len(item) == 2:\n                name, value = item\n                try:\n                    entries.append(AggregateEntry(str(name), int(value)))\n                except Exception as exc:\n                    raise ValidationError(f\"Cannot parse tuple {item}: {exc}\")\n            elif isinstance(item, dict):\n                try:\n                    entries.append(AggregateEntry(str(item[\"name\"]), int(item[\"value\"])))\n                except Exception as exc:\n                    raise ValidationError(f\"Cannot parse dict {item}: {exc}\")\n            else:\n                raise ValidationError(f\"Unsupported entry type: {type(item)}\")\n        return entries\nclass EntryValidator:\n    @staticmethod\n    def validate(entry: AggregateEntry) -> None:\n        if not entry.name or not isinstance(entry.name, str):\n            raise ValidationError(\"Entry name must be non-empty string\")\n        if not isinstance(entry.value, int):\n            raise ValidationError(\"Entry value must be integer\")\nclass AggregatorService:\n    def __init__(self, repo: AggregatorRepository, tie_breaker: str = \"lexicographic\") -> None:\n        self._repo = repo\n        self._tie_breaker = tie_breaker\n\n    def compute_aggregates(self, entries: Iterable) -> dict[str, int]:\n        parsed = EntryParser.parse_list(entries)\n        totals: dict[str, int] = {}\n        for e in parsed:\n            EntryValidator.validate(e