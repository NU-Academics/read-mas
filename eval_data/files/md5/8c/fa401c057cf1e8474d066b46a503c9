floor - 1) // 2)\n    return candidate\nclass TriangularRepository:\n    def __init__(self, cache_enabled: bool = CACHE_ENABLED):\n        self.cache_by_digits: dict[int, int] = {}\n        self.cache_by_index: dict[int, int] = {}\n        self.cache_enabled = cache_enabled\n\n    def get_index_for_digits(self, n: int) -> int | None:\n        if not self.cache_enabled:\n            return None\n        return self.cache_by_digits.get(n)\n\n    def save_index_for_digits(self, n: int, k: int) -> None:\n        if self.cache_enabled:\n            self.cache_by_digits[n] = k\n\n    def get_triangular_by_index(self, k: int) -> int | None:\n        if not self.cache_enabled:\n            return None\n        return self.cache_by_index.get(k)\n\n    def save_triangular(self, k: int, value: int) -> None:\n        if self.cache_enabled:\n            self.cache_by_index[k] = value\n\n    def clear(self) -> None:\n        self.cache_by_digits.clear()\n        self.cache_by_index.clear()\nclass TriangularService:\n    def __init__(self, repo: 'TriangularRepository'):\n        self.repo = repo\n\n    def find_index_for_digits(self, n: int) -> int:\n        validate_digits(n)\n        cached = self.repo.get_index_for_digits(n)\n        if cached:\n            return cached\n        \n        candidate = minimal_index_lower_bound(n)\n        target_min_value_for_n_digits = pow10(n - 1)\n        \n        while True:\n            value = compute_triangular_value(candidate)\n            if value >= target_min_value_for_n_digits:\n                self.repo.save_index_for_digits(n, candidate)\n                self.repo.save_triangular(candidate, value)\n                return candidate\n            candidate += 1\nclass TriangularController:\n    def __init__(self, service: 'TriangularService' = None):\n        if service is None:\n            repo = TriangularRepository()\n            service = TriangularService(repo)\n        self.service = service\n\n    def find_Index(self, n: int) -> int:\n        return self.service.find_index_for_digits(n)\n_default_controller = TriangularController()\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    This function uses a cached service layer for efficiency.\n    \"\"\"\n    return _default_controller.find_Index(n)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[2]], "plus_fail_tests": [[5]]}], "Mbpp/748": [{"task_id": "Mbpp/748", "solution": "import re\nfrom typing import Pattern, Optional\ndef capital_words_spaces(text: str) -> str:\n    \"\"\"Inserts spaces between words in a string, where a new word starts with a capital letter.\"\"\"\n\n    DEFAULT_MAX_LENGTH: int = 10000\n    SPLIT_PATTERN_STR: str = r'(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z])(?=[A-Z][a-z])'\n\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception for invalid input.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    def default_split_regex() -> Pattern:\n        \"\"\"Compiles the default regex pattern for splitting words.\"\"\"\n        return re.compile(SPLIT_PATTERN_STR)\n\n    def apply_regex_split(text: str, pattern: Pattern) -> str:\n        \"\"\"Splits text by a regex pattern and joins parts with single spaces.\"\"\"\n        parts = [p for p in pattern.split(text) if p]\n        return \" \".join(parts)\n\n    class BaseSplitter:\n        \"\"\"Abstract base class for text splitting strategies.\"\"\"\n        def split(self, text: str) -> str:\n            raise NotImplementedError\n\n    class RegexCapitalWordSplitter(BaseSplitter):\n        \"\"\"A splitter that uses a regex pattern to insert spaces before capitalized words.\"\"\"\n        def __init__(self, pattern: Optional[Pattern] = None) -> None:\n            self._pattern = pattern or default_split_regex()\n\n        def split(self, text: str) -> str:\n            return apply_regex