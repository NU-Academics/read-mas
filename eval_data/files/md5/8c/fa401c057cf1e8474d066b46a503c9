po\n\n    def sum_amicable_numbers(self, max_n: int) -> int:\n        \"\"\"Calculates the sum of all amicable numbers up to max_n.\"\"\"\n        # The design document specifies InputValidationError for max_n < 1 within this method.\n        # Although the prompt suggests \"No isinstance() checks or raise exceptions for edge cases\"\n        # for the final function amicable_numbers_sum, this check is explicitly\n        # part of the AmicableService snippet in the design.\n        if max_n < 1:\n            raise InputValidationError(\"max_n must be >= 1\")\n\n        self.repo.ensure_up_to(max_n)\n        seen = set()\n        total = 0\n        for a in range(2, max_n + 1):\n            b = self.repo.cache.get(a, 0)\n            if b != a and b >= 2 and b <= max_n:\n                if self.repo.cache.get(b, 0) == a:\n                    if a not in seen:\n                        seen.add(a)\n                        total += a\n                    if b not in seen:\n                        seen.add(b)\n                        total += b\n        return total\ndef amicable_numbers_sum(n: int) -> int:\n    \"\"\"\n    Sums all amicable numbers from 1 to a specified number n.\n    An amicable pair (a, b) means sum_proper_divisors(a) = b and sum_proper_divisors(b) = a, with a != b.\n    \"\"\"\n    repo = NumberRepository()\n    svc = AmicableService(repo)\n    return svc.sum_amicable_numbers(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/165": [{"task_id": "Mbpp/165", "solution": "def count_char_position(text: str) -> int:\n    \"\"\"\n    Counts characters in a string that match their 1-based position in the English alphabet (case-insensitive).\n    Non-ASCII letters and non-alphabetical characters are ignored for matching.\n    \"\"\"\n    count = 0\n    # Iterate through the string with a 1-based index (position)\n    for idx, char_code in enumerate(text, start=1):\n        # Convert character to lowercase