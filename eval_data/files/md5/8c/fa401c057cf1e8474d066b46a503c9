nts occurrences of a value in a given list.\"\"\"\n        count = 0\n        for item in lst:\n            if safe_eq(item, value):\n                count += 1\n        return count\ndef frequency(lst, value):\n    \"\"\"Counts the number of occurrences of a number in a given list.\"\"\"\n    svc = FrequencyService()\n    return svc.count(lst, value)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/172": [{"task_id": "Mbpp/172", "solution": "def count_occurance(text: str) -> int:\n    \"\"\"Counts the number of non-overlapping occurrences of the string 'std' in the given text.\"\"\"\n    pattern = \"std\"\n    count = 0\n    start_index = 0\n    while True:\n        idx = text.find(pattern, start_index)\n        if idx == -1:\n            break\n        count += 1\n        start_index = idx + len(pattern)\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/223": [{"task_id": "Mbpp/223", "solution": "def is_majority(arr, n, x):\n    \"\"\"\n    Checks if an element x is the majority element in a sorted array.\n    A majority element occurs more than n/2 times.\n    \"\"\"\n    # Find the first occurrence of x using binary search\n    lo, hi = 0, n - 1\n    first_occurrence_idx = -1\n\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        if arr[mid] == x:\n            first_occurrence_idx = mid\n            hi = mid - 1  # Search in the left half for an earlier occurrence\n        elif arr[mid] < x:\n            lo = mid + 1\n        else:  # arr[mid] > x\n            hi = mid - 1\n\n    # If x is not found, it cannot be a majority element\n    if first_occurrence_idx == -1:\n        return False\n\n    # Check the element at index (first_occurrence_idx + n // 2)\n    # If this element is also x, it means x occurs at least (n // 2 + 1) times,\n    # thus satisfying the majority condition.\n    index_to_check = first_occurrence_idx + (n // 2)\