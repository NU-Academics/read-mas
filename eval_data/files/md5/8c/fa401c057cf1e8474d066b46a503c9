st of these common elements.\n    \"\"\"\n    common_elements = []\n    min_length = min(len(l1), len(l2), len(l3))\n\n    for i in range(min_length):\n        if l1[i] == l2[i] == l3[i]:\n            common_elements.append(l1[i])\n            \n    return common_elements", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/778": [{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(data):\n    \"\"\"\n    Packs consecutive duplicates of list elements into sublists.\n    This function processes an input sequence, grouping identical consecutive items.\n    \"\"\"\n    packed_list = []\n    if not data:\n        return packed_list\n\n    # Convert the input to a list to ensure indexability and consistent length.\n    items = list(data)\n    n = len(items)\n    i = 0\n\n    while i < n:\n        current_element = items[i]\n        run = [current_element]\n        j = i + 1\n        # Collect all consecutive duplicates of the current element\n        while j < n and items[j] == current_element:\n            run.append(items[j])\n            j += 1\n        packed_list.append(run)\n        i = j\n    return packed_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/782": [{"task_id": "Mbpp/782", "solution": "def odd_length_sum(nums: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of all odd-length subarrays for a given list of integers.\n    This function uses an O(n) combinatoric approach to determine each element's contribution.\n    \"\"\"\n    n = len(nums)\n    total_sum = 0\n    for i, val in enumerate(nums):\n        # Calculate the total number of subarrays `val` at index `i` is part of.\n        # (i + 1) represents choices for the start index (0 to i).\n        # (n - i) represents choices for the end index (i to n-1).\n        total_subarrays_containing_val = (i + 1) * (n - i)\n\n        # The number of odd-length subarrays containing 