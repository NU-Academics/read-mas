st[str]) -> None:\n        self.raw = raw\n        self.values = list(values)\n        self.count = len(self.values)\n\n    def to_list(self) -> List[str]:\n        return self.values\n\n    def to_json(self) -> str:\n        return json.dumps(self.values)\ndef unescape_value(s: str) -> str:\n    \"\"\"Converts common escape sequences like \\\\\" and \\\\' to their literal characters.\"\"\"\n    return s.encode('utf-8').decode('unicode_escape')\ndef has_unbalanced_quotes(s: str, allowed_quotes: Set[str]) -> bool:\n    \"\"\"Checks for an unclosed quote character in the string, ignoring escaped quotes.\"\"\"\n    open_quote_char: Optional[str] = None\n    i = 0\n    while i < len(s):\n        char = s[i]\n        if char == '\\\\':\n            i += 2\n            continue\n        \n        if char in allowed_quotes:\n            if open_quote_char is None:\n                open_quote_char = char\n            elif char == open_quote_char:\n                open_quote_char = None\n        i += 1\n    return open_quote_char is not None\nclass RegexParser:\n    DEFAULT_ALLOWED_QUOTES = {'\"', \"'\"}\n\n    def __init__(self, allowed_quotes: Optional[Set[str]] = None) -> None:\n        self.allowed_quotes = allowed_quotes or self.DEFAULT_ALLOWED_QUOTES\n        quotes_escaped = ''.join(re.escape(q) for q in sorted(self.allowed_quotes))\n        \n        self._pattern = rf'([{quotes_escaped}])((?:\\\\.|(?!\\1).)*?)\\1'\n        self._compiled = re.compile(self._pattern, re.DOTALL)\n\n    def parse(self, input_text: str) -> List[str]:\n        return [m.group(2) for m in self._compiled.finditer(input_text)]\nclass StringExtractor:\n    def __init__(self, strict: bool = False, allowed_quotes: Optional[Set[str]] = None) -> None:\n        self.strict = strict\n        self.allowed_quotes = allowed_quotes if allowed_quotes is not None else RegexParser.DEFAULT_ALLOWED_QUOTES\n        self.parser = RegexParser(allowed_quotes)\n\n    def extract(self, input_text: str) -> \"ExtractResult\":\n        raw_matches = self.parser.parse(input_text)\n        values = [unescape_value(m) for m in raw_matches]\n        \n        if self.strict:\n            self._validate(input_text, values)\n            \n        return ExtractResult(raw=input_text, values=values)\n\n    def _validate(self, input_text: str, values: List[str]) -> None:\n        \"\"\"Validates input string for unbalanced quotes in strict mode.\"\"\"\n        if has_unbalanced_quotes(input_text, self.parser.allowed_quotes):\n            raise ExtractionError(\"Unbalanced quotes detected\")\ndef extract_values(s: str, strict: bool = False) -> list:\n    extractor = StringExtractor(strict=strict)\n    result = extractor.extract(s)\n    return result.to_list()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/567": [{"task_id": "Mbpp/567", "solution": "def issort_list(seq: Iterable[Any]) -> bool:\n    \"\"\"\n    Checks if a sequence is sorted in non-decreasing order.\n    Handles empty and single-element sequences as sorted.\n    \"\"\"\n    items = list(seq)  # Convert to a list to ensure consistent indexing and length.\n\n    n = len(items)\n    if n < 2:\n        return True\n\n    for i in range(n - 1):\n        if items[i] > items[i+1]:\n            return False\n\n    return True", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/565": [{"task_id": "Mbpp/565", "solution": "def split(text):\n    \"\"\"\n    Splits a string into a list of its individual characters.\n    \"\"\"\n    return list(text)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/564": [{"task_id": "Mbpp/564", "solution": "from collections import Counter\nfrom typing import List, Optional\ndef count_Pairs(lst: List[int], n: Optional[int] = None) -> int:\n    \"\"\"\n    Counts the number of unordered pairs of unequal elements in a list of integers.\n    Uses fre