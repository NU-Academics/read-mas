{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    \"\"\"\n    if not l:\n        return []\n\n    # Extract elements at indices divisible by three\n    divisible_by_three_elements = []\n    divisible_by_three_indices = []\n    for i in range(len(l)):\n        if i % 3 == 0:\n            divisible_by_three_elements.append(l[i])\n            divisible_by_three_indices.append(i)\n    \n    # Sort the extracted elements\n    divisible_by_three_elements.sort()\n\n    # Reconstruct the list with sorted elements\n    result_list = list(l) # Create a mutable copy\n    for i, original_index in enumerate(divisible_by_three_indices):\n        result_list[original_index] = divisible_by_three_elements[i]\n\n    return result_list"}
{"task_id": "HumanEval/36", "solution": "import collections\nfrom typing import List\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n\n    def _is_divisible_by(number: int, divisor: int) -> bool:\n        \"\"\"Check if a number is divisible by a divisor.\"\"\"\n        return number % divisor == 0\n\n    def _find_divisible_numbers(upper_bound: int) -> List[int]:\n        \"\"\"Find all numbers less than upper_bound that are divisible by 11 or 13.\"\"\"\n        divisible_numbers = []\n        for i in range(upper_bound):\n            if _is_divisible_by(i, 11) or _is_divisible_by(i, 13):\n                divisible_numbers.append(i)\n        return divisible_numbers\n\n    def _count_digit_in_number(number: int, digit: int) -> int:\n        \"\"\"Count occurrences of a digit in a single number.\"\"\"\n        count = 0\n        for char_digit in str(number):\n            if int(char_digit) == digit:\n                count += 1\n        return count\n\n    def _count_digit_occurrences(numbers: List[int], digit: int) -> int:\n        \"\"\"Count occurrences of specified digit in a list of numbers.\"\"\"\n        total_count = 0\n        for number in numbers:\n            total_count += _count_digit_in_number(number, digit)\n        return total_count\n\n    qualifying_numbers = _find_divisible_numbers(n)\n    total_sevens_count = _count_digit_occurrences(qualifying_numbers, 7)\n    return total_sevens_count"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    # Extract elements from even indices and sort them.\n    even_elements = [l[i] for i in range(0, len(l), 2)]\n    even_elements.sort()\n\n    # Reconstruct the list with sorted even elements and original odd elements.\n    result = l[:]  # Create a mutable copy of the original list.\n    even_idx_counter = 0\n    for i in range(0, len(l), 2):\n        result[i] = even_elements[even_idx_counter]\n        even_idx_counter += 1\n\n    return result"}
{"task_id": "HumanEval/32", "solution": "import math\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    # Use bisection method to find a root. The input constraints guarantee a solution exists.\n    # Start with a search interval and expand if necessary to bracket a root.\n\n    low = -1000.0\n    high = 1000.0\n    tolerance = 1e-7\n\n    # Initialize function values at interval boundaries.\n    p_low = poly(xs, low)\n    p_high = poly(xs, high)\n\n    # Check if initial boundaries are roots.\n    if abs(p_low) < tolerance:\n        return low\n    if abs(p_high) < tolerance:\n        return high\n\n    # Expand the interval until poly(low) and poly(high) have opposite signs.\n    # For odd degree polynomials, a root is guaranteed to exist as x approaches +/- infinity.\n    while p_low * p_high > 0:\n        low *= 2\n        high *= 2\n        p_low = poly(xs, low)\n        p_high = poly(xs, high)\n        if abs(p_low) < tolerance: return low\n        if abs(p_high) < tolerance: return high\n        \n    # Bisection method to refine the root within the bracketed interval.\n    for _ in range(100):  # 100 iterations provide high precision for typical numerical problems\n        mid = (low + high) / 2\n        p_mid = poly(xs, mid)\n\n        if abs(p_mid) < tolerance:\n            return mid\n        \n        # If the root is in the left half [low, mid]\n        if p_low * p_mid < 0:\n            high = mid\n            p_high = p_mid\n        else:  # The root is in the right half [mid, high]\n            low = mid\n            p_low = p_mid\n            \n    return (low + high) / 2  # Return the midpoint of the final interval"}
{"task_id": "HumanEval/39", "solution": "import math\ndef is_prime(num: int) -> bool:\n    \"\"\"Tests if a number is prime.\"\"\"\n    if num <= 1:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(num)) + 1, 2):\n        if num % i == 0:\n            return False\n    return True\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    found_primes_count = 0\n    fib_generator = generate_fibonacci()\n    result = None\n\n    while found_primes_count < n:\n        fib_num = next(fib_generator)\n        if is_prime(fib_num):\n            found_primes_count += 1\n            if found_primes_count == n:\n                result = fib_num\n                break\n    return result"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # Split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # Reverse cycle elements in each group if it has 3 elements.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/40", "solution": "def _generate_triplets(lst: list) -> list:\n    \"\"\"Generate all possible three-element index combinations.\"\"\"\n    n = len(lst)\n    triplets = []\n    for i in range(n):\n        for j in range(i + 1, n):\n            for k in range(j + 1, n):\n                triplets.append((i, j, k))\n    return triplets\ndef _is_valid_triplet(triplet: tuple, lst: list) -> bool:\n    \"\"\"Validate triplet has distinct indices.\"\"\"\n    # This check ensures indices are distinct.\n    # Given _generate_triplets with i < j < k, this will always return True.\n    i, j, k = triplet\n    return i != j and j != k and i != k\ndef _triplet_sum(triplet: tuple, lst: list) -> int:\n    \"\"\"Calculate sum of elements at triplet indices.\"\"\"\n    i, j, k = triplet\n    return lst[i] + lst[j] + lst[k]\ndef triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    if len(l) < 3:\n        return False\n\n    all_triplet_indices = _generate_triplets(l)\n\n    for triplet_indices in all_triplet_indices:\n        if _is_valid_triplet(triplet_indices, l):\n            current_sum = _triplet_sum(triplet_indices, l)\n            if current_sum == 0:\n                return True\n                \n    return False"}
{"task_id": "HumanEval/42", "solution": "def incr_list(l: list) -> list:\n    \"\"\"Return list with elements incremented by 1.\n    >>> incr_list([1, 2, 3])\n    [2, 3, 4]\n    >>> incr_list([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [6, 4, 6, 3, 4, 4, 10, 1, 124]\n    \"\"\"\n    return [x + 1 for x in l]"}
