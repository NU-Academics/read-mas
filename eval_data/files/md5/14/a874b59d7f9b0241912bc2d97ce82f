{"task_id": "Mbpp/14", "solution": "def find_Volume(base, height, length):\n    \"\"\"Compute triangular prism volume: 0.5 * base * height * length.\n\n    Returns numeric (int or float) result of the computation.\n    \"\"\"\n    area_of_base = 0.5 * base * height\n    volume = area_of_base * length\n    return volume"}
{"task_id": "Mbpp/12", "solution": "from typing import List, Union\n\n# Define the number type as Union[int, float]\nNumber = Union[int, float]\n\nclass Row:\n    \"\"\"Represents a row of numeric elements.\"\"\"\n    def __init__(self, elements: List[Number]) -> None:\n        self.elements = elements\n\n    def sum(self) -> Number:\n        \"\"\"Computes the numeric sum of the row's elements.\"\"\"\n        return sum(self.elements)\n\nclass Matrix:\n    \"\"\"Represents a matrix as a list of rows.\"\"\"\n    def __init__(self, rows: List[List[Number]]) -> None:\n        self.rows = rows\n\n    def get_row_sums(self) -> List[Number]:\n        \"\"\"Computes the sum for each row in the matrix.\"\"\"\n        return [Row(row).sum() for row in self.rows]\n\ndef _validate_matrix(matrix: List[List[Number]]) -> None:\n    \"\"\"\n    Validates the input matrix structure and element types.\n    Raises TypeError or ValueError on invalid input.\n    \"\"\"\n    if not isinstance(matrix, list):\n        raise TypeError(\"Input must be a list of lists.\")\n    \n    for i, row in enumerate(matrix):\n        if not isinstance(row, list):\n            raise ValueError(f\"Row at index {i} is not a list.\")\n        for j, element in enumerate(row):\n            if not isinstance(element, (int, float)):\n                raise ValueError(f\"Element at [{i}][{j}] is not numeric.\")\n\ndef _row_sum(row: List[Number]) -> Number:\n    \"\"\"Computes the numeric sum for a given row.\"\"\"\n    return sum(row)\n\n\ndef sort_matrix(matrix: List[List[Number]]) -> List[List[Number]]:\n    \"\"\"\n    Sorts a given matrix in ascending order according to the sum of its rows.\n    The original relative order of rows with equal sums is preserved.\n    \"\"\"\n    _validate_matrix(matrix)\n\n    if not matrix:\n        return []\n\n    matrix_obj = Matrix(matrix)\n    row_sums = matrix_obj.get_row_sums()\n\n    # Create a list of tuples: (row_sum, original_index, row)\n    # The original_index ensures stable sort behavior for rows with equal sums.\n    indexed_rows = []\n    for i, row in enumerate(matrix):\n        indexed_rows.append((row_sums[i], i, row))\n\n    # Sort the list of tuples based on row_sum, then original_index for stability.\n    # Python's sorted() is stable; the original_index explicitly handles ties.\n    sorted_indexed_rows = sorted(indexed_rows, key=lambda t: (t[0], t[1]))\n\n    # Extract and return the sorted rows.\n    return [t[2] for t in sorted_indexed_rows]"}
{"task_id": "Mbpp/16", "solution": "import re\n\nPATTERN_REGEX: str = r\"^[a-z]+_[a-z]+$\"\n\ndef text_lowercase_underscore(input: str) -> bool:\n    \"\"\"\n    Checks if the input string contains sequences of lowercase letters\n    joined by a single underscore, matching the entire string.\n    \"\"\"\n    return bool(re.fullmatch(PATTERN_REGEX, input))"}
{"task_id": "Mbpp/20", "solution": "def _value_for_k(k: int) -> int:\n    \"\"\"Computes k * (2^k) - 1.\"\"\"\n    return k * (2 ** k) - 1\n\ndef is_woodall(n: int) -> bool:\n    \"\"\"\n    Checks if the given number n is a Woodall number.\n    A number n is Woodall if there exists a positive integer k such that n = k * 2^k - 1.\n    \"\"\"\n    if n < 1:\n        # Woodall numbers are positive integers (k * 2^k - 1 for k >= 1).\n        return False\n\n    k = 1\n    while True:\n        computed = _value_for_k(k)\n        if computed == n:\n            return True\n        if computed > n:\n            # Since k * 2^k - 1 is strictly increasing for k >= 1,\n            # we can stop searching if the computed value exceeds n.\n            return False\n        k += 1"}
{"task_id": "Mbpp/19", "solution": "class IntegerArray:\n    \"\"\"A data-holder for an array of integers with a length helper.\"\"\"\n    def __init__(self, values: list[int]) -> None:\n        self.values = values\n\n    def length(self) -> int:\n        return len(self.values)\n\nclass DuplicateCheckResult:\n    \"\"\"A value object to hold the boolean result of a duplicate check.\"\"\"\n    def __init__(self, has_duplicate: bool) -> None:\n        self.has_duplicate = has_duplicate\n\nclass TestDuplicateService:\n    \"\"\"Provides stateless duplicate detection logic for an array of integers.\"\"\"\n    @staticmethod\n    def test_duplicate(arr: list[int]) -> bool:\n        \"\"\"\n        Checks if the given array contains any duplicate elements.\n        Uses a set to track seen elements for efficient lookup.\n        \"\"\"\n        seen = set()\n        for num in arr:\n            if num in seen:\n                return True\n            seen.add(num)\n        return False\n\ndef test_duplicate(arr: list[int]) -> bool:\n    \"\"\"\n    Determines if an array of integers contains any duplicate element.\n    This function delegates the core logic to the TestDuplicateService.\n    \"\"\"\n    return TestDuplicateService.test_duplicate(arr)"}
