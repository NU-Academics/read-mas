{"task_id": "Mbpp/9", "solution": "def _rotate_left(s: str, k: int) -> str:\n    \"\"\"Rotates a string left by k positions.\n    Moves the first k characters to the end.\"\"\"\n    n = len(s)\n    if n == 0:\n        return s\n    k = k % n\n    return s[k:] + s[:k]\n\ndef find_Rotations(s: str) -> int:\n    \"\"\"Finds the minimum number of rotations (greater than 0) required to get the same string.\n    Returns the length of the string if no smaller rotation produces the original.\"\"\"\n    n = len(s)\n    if n == 0:\n        return 0\n\n    for k in range(1, n + 1):\n        rotated = _rotate_left(s, k)\n        if rotated == s:\n            return k\n    return n"}
{"task_id": "Mbpp/7", "solution": "from typing import List, Optional\n\nclass InputString:\n    def __init__(self, text: str):\n        self.text = text\n\nclass Word:\n    def __init__(self, text: str):\n        self.text = text\n    def length(self) -> int:\n        return len(self.text)\n\nclass ResultList:\n    def __init__(self, words: Optional[List[str]] = None):\n        self.words = words if words is not None else []\n    def to_list(self) -> List[str]:\n        return self.words\n\nclass Parser:\n    def split_on_whitespace(self, text: str) -> List[str]:\n        \"\"\"Splits the input string into words using whitespace as a delimiter.\"\"\"\n        return text.split()\n\nclass Filter:\n    def filter_min_length(self, words: List[str], min_len: int) -> List[str]:\n        \"\"\"Filters a list of words, keeping only those at least min_len characters long.\"\"\"\n        return [word for word in words if len(word) >= min_len]\n\nclass FindCharLong:\n    \"\"\"Coordinates parsing and filtering to find words of a minimum length.\"\"\"\n    def __init__(self, parser: Parser, text_filter: Filter, min_len: int = 4):\n        self.parser = parser\n        self.filter = text_filter\n        self.min_len = min_len\n\n    def find_char_long(self, input_string: str) -> List[str]:\n        \"\"\"Finds all words at least min_len characters long in the given string.\"\"\"\n        tokens = self.parser.split_on_whitespace(input_string)\n        filtered_words = self.filter.filter_min_length(tokens, self.min_len)\n        _ = ResultList(filtered_words)\n        return filtered_words\n\ndef find_char_long(input_string: str) -> List[str]:\n    \"\"\"\n    Finds all words which are at least 4 characters long in a string.\n    \"\"\"\n    parser = Parser()\n    text_filter = Filter()\n    finder = FindCharLong(parser, text_filter, min_len=4)\n    return finder.find_char_long(input_string)"}
{"task_id": "Mbpp/11", "solution": "class StringProcessor:\n    @staticmethod\n    def _remove_at_indices(s: str, indices_to_remove: list[int]) -> str:\n        \"\"\"Removes characters from string s at the specified indices.\"\"\"\n        indices_to_remove_set = set(indices_to_remove)\n        result_chars = []\n        for i, char_s in enumerate(s):\n            if i not in indices_to_remove_set:\n                result_chars.append(char_s)\n        return \"\".join(result_chars)\n\n    @staticmethod\n    def remove_Occ(s: str, ch: str) -> str:\n        \"\"\"Core logic to remove first and last occurrences of a character.\"\"\"\n        occurrence_indices = []\n        for i, char_s in enumerate(s):\n            if char_s == ch:\n                occurrence_indices.append(i)\n\n        count = len(occurrence_indices)\n\n        if count == 0:\n            return s\n        elif count == 1:\n            return StringProcessor._remove_at_indices(s, [occurrence_indices[0]])\n        else:  # count >= 2\n            return StringProcessor._remove_at_indices(s, [occurrence_indices[0], occurrence_indices[-1]])\n\ndef remove_Occ(s: str, ch: str) -> str:\n    \"\"\"Removes the first and last occurrence of a given character from the string.\"\"\"\n    return StringProcessor.remove_Occ(s, ch)"}
{"task_id": "Mbpp/3", "solution": "import math\n\nclass Number:\n    \"\"\"Lightweight data holder for input number and computed primality state.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n        self.is_prime = None\n\nclass PrimeCheckResult:\n    \"\"\"Encapsulate the boolean result (not_prime) and an optional reason message.\"\"\"\n    def __init__(self, not_prime: bool, reason: str = None):\n        self.not_prime = not_prime\n        self.reason = reason\n\nclass PrimeChecker:\n    \"\"\"Contain the primality determination algorithm and provide the is_not_prime(n) operation.\"\"\"\n    @staticmethod\n    def is_not_prime(n) -> bool:\n        \"\"\"\n        Validate input type, apply edge-case rules (n < 2 -> True), compute primality\n        for n >= 2 and return True when n is not prime, False when n is prime.\n        \"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input must be an integer.\")\n\n        if n < 2:\n            return True\n\n        if n == 2:\n            return False\n\n        if n % 2 == 0:\n            return True\n\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return True\n\n        return False\n\ndef is_not_prime(n):\n    \"\"\"Public function required by SRS: is_not_prime(n) -> bool.\n    Validates input and delegates to PrimeChecker.is_not_prime.\n    \"\"\"\n    return PrimeChecker.is_not_prime(n)"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(seq1, seq2):\n    \"\"\"\n    Finds the shared unique elements between two sequences.\n    Converts inputs to sets, computes their intersection, and returns the result as a list.\n    \"\"\"\n    set1 = set(seq1)\n    set2 = set(seq2)\n    return list(set1.intersection(set2))"}
{"task_id": "Mbpp/8", "solution": "from src.domain import SquareNumsFunction, InputList, IntegerElement, OutputList\n\ndef _to_input_list(values: list[int]) -> InputList:\n    \"\"\"Helper to convert a list of integers to an InputList of IntegerElement objects.\"\"\"\n    integer_elements = [IntegerElement(value=v, position=i) for i, v in enumerate(values)]\n    return InputList(elements=integer_elements)\n\ndef square_nums(input_list: list[int]) -> list[int]:\n    \"\"\"\n    Finds squares of individual elements in a list.\n    \"\"\"\n    input_obj = _to_input_list(input_list)\n    func = SquareNumsFunction()\n    output_obj = func.execute(input_obj)\n    return output_obj.to_list()"}
{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import List\n\ndef heap_queue_largest(list: List[int], n: int) -> List[int]:\n    \"\"\"\n    Finds the n largest integers from a list and returns them in descending order.\n    Handles edge cases for n <= 0 and n greater than or equal to list length.\n    \"\"\"\n    if n <= 0:\n        return []\n\n    if n >= len(list):\n        return sorted(list, reverse=True)\n\n    # Use heapq.nlargest to find the n largest elements, which returns them in descending order.\n    return heapq.nlargest(n, list)"}
{"task_id": "Mbpp/6", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass IntegerValue:\n    \"\"\"A simple data holder for an integer value.\"\"\"\n    value: int\n\n@dataclass\nclass XORResult:\n    \"\"\"Holds the XOR result and its set bit count.\"\"\"\n    xor_value: int\n    set_bits_count: int\n\nclass BitwiseComparator:\n    \"\"\"Provides methods for bitwise operations and counting set bits.\"\"\"\n\n    def compute_xor(self, a: IntegerValue, b: IntegerValue) -> XORResult:\n        \"\"\"Computes the XOR of two IntegerValue objects and counts set bits.\"\"\"\n        x = a.value ^ b.value\n        count = self.count_set_bits(x)\n        return XORResult(xor_value=x, set_bits_count=count)\n\n    def count_set_bits(self, x: int) -> int:\n        \"\"\"Counts the number of set bits in an integer x.\"\"\"\n        try:\n            return x.bit_count()  # Python 3.10+\n        except AttributeError:\n            # Fallback for older Python versions using Kernighan's algorithm\n            count = 0\n            # Work with a positive copy for Kernighan's if x is negative\n            # Python's bitwise ops handle negative numbers, but bit_count usually implies positive.\n            # However, x ^ y is always non-negative if x and y are positive.\n            # If x could be negative from other sources, abs(x) is safer for Kernighan's.\n            # Here, x comes from a XOR operation, so its set bits are counted directly.\n            y = x\n            while y:\n                y &= (y - 1)\n                count += 1\n            return count\n\ndef differ_At_One_Bit_Pos(a: int, b: int) -> bool:\n    \"\"\"\n    Checks if two integers differ at exactly one bit position.\n    This is true if their XOR result has exactly one set bit.\n    \"\"\"\n    ia = IntegerValue(a)\n    ib = IntegerValue(b)\n    comparator = BitwiseComparator()\n    result = comparator.compute_xor(ia, ib)\n    return result.set_bits_count == 1"}
