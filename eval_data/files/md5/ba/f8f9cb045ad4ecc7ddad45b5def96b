recedence and operators_stack[-1] != '**'))):\n                    perform_operation()\n                operators_stack.append(token)\n\n        while operators_stack:\n            perform_operation()\n\n        return values_stack[0]\n\n    def evaluate_expression(expression_string):\n        \"\"\"Main evaluation function delegating to precedence handling.\"\"\"\n        return apply_precedence(expression_string)\n\n    # --- Main do_algebra orchestration ---\n    # 1. Input Validation (simplified as per critical requirements)\n    validate_inputs(operator, operand)\n\n    # 2. Expression Building\n    expression_string = build_expression(operator, operand)\n\n    # 3. Expression Evaluation\n    numerical_result = evaluate_expression(expression_string)\n\n    return numerical_result\n```"}
