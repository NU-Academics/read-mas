{"task_id": "HumanEval/33", "solution": "def _is_divisible_by_three(index: int) -> bool:\n    \"\"\"Checks if an index is divisible by three.\"\"\"\n    return index % 3 == 0\n\ndef _extract_divisible_values(l: list) -> list:\n    \"\"\"Extracts values from a list at indices divisible by three.\"\"\"\n    extracted = []\n    for i, val in enumerate(l):\n        if _is_divisible_by_three(i):\n            extracted.append(val)\n    return extracted\n\ndef _sort_values(values: list) -> list:\n    \"\"\"Sorts a list of values in ascending order.\"\"\"\n    return sorted(values)\n\ndef _reconstruct_list(original: list, sorted_values: list) -> list:\n    \"\"\"Reconstructs the original list with sorted values at specific indices.\"\"\"\n    result = list(original)\n    sorted_idx = 0\n    for i in range(len(result)):\n        if _is_divisible_by_three(i):\n            result[i] = sorted_values[sorted_idx]\n            sorted_idx += 1\n    return result\n\ndef sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\n        return []\n\n    divisible_values = _extract_divisible_values(l)\n    sorted_divisible_values = _sort_values(divisible_values)\n    \n    return _reconstruct_list(l, sorted_divisible_values)"}
{"task_id": "HumanEval/33", "solution": "```python\ndef sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    \n    # Create a mutable copy of the input list to ensure the function is pure.\n    result = list(l)\n\n    # Collect values and their original indices that are divisible by three.\n    values_to_sort = []\n    divisible_indices = []\n\n    for i, value in enumerate(l):\n        if i % 3 == 0:\n            values_to_sort.append(value)\n            divisible_indices.append(i)\n    \n    # Sort the collected values in ascending order.\n    sorted_values = sorted(values_to_sort)\n    \n    # Place the sorted values back into their original positions in the result list.\n    for i, original_index in enumerate(divisible_indices):\n        result[original_index] = sorted_values[i]\n        \n    return result\n```"}
{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    max_val = l[0]\n    for element in l[1:]:\n        if element > max_val:\n            max_val = element\n    return max_val"}
{"task_id": "HumanEval/36", "solution": "def _is_divisible(number: int, divisor: int) -> bool:\n    \"\"\"Check if number is divisible by divisor.\"\"\"\n    return number % divisor == 0\n\ndef _count_digit_7(number: int) -> int:\n    \"\"\"Count occurrences of digit 7 in the given number.\"\"\"\n    return str(number).count('7')\n\ndef _find_divisible_numbers(n: int) -> list[int]:\n    \"\"\"Find all numbers less than n that are divisible by 11 or 13.\"\"\"\n    divisible_numbers = []\n    for i in range(1, n):\n        if _is_divisible(i, 11) or _is_divisible(i, 13):\n            divisible_numbers.append(i)\n    return divisible_numbers\n\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_sevens = 0\n    qualifying_numbers = _find_divisible_numbers(n)\n    for number in qualifying_numbers:\n        total_sevens += _count_digit_7(number)\n    return total_sevens"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n\n    # Checks if a number is divisible by 11 or 13.\n    def _is_divisible(num: int) -> bool:\n        return num % 11 == 0 or num % 13 == 0\n\n    # Counts occurrences of the digit '7' in a number.\n    def _count_digit_7(num: int) -> int:\n        return str(num).count('7')\n\n    total_sevens_count = 0\n    for num in range(1, n):\n        if _is_divisible(num):\n            total_sevens_count += _count_digit_7(num)\n\n    return total_sevens_count"}
{"task_id": "HumanEval/37", "solution": "def extract_even_elements(l: list) -> list:\n    \"\"\"Extract elements at even indices (0, 2, 4, ...).\n    Returns a new list containing only these elements.\"\"\"\n    even_elements = []\n    for i in range(0, len(l), 2):\n        even_elements.append(l[i])\n    return even_elements\n\ndef sort_elements(elements: list) -> list:\n    \"\"\"Sort elements in ascending order using Python's sorted().\n    Returns a new list with the elements sorted.\"\"\"\n    return sorted(elements)\n\ndef reconstruct_list(original: list, sorted_even: list) -> list:\n    \"\"\"Reconstruct list with sorted even elements and preserved odd elements.\n    Creates a new list based on original and the sorted even elements.\"\"\"\n    result = list(original) # Create a mutable copy of the original list\n    even_idx_counter = 0\n    for i in range(len(result)):\n        if i % 2 == 0: # Even index\n            result[i] = sorted_even[even_idx_counter]\n            even_idx_counter += 1\n    return result\n\ndef sort_even(l: list) -> list:\n    \"\"\"Main function implementing the sort_even algorithm.\n    Sorts elements at even indices while preserving odd-indexed elements.\"\"\"\n    if not l:\n        return []\n\n    even_elements = extract_even_elements(l)\n    sorted_even_elements = sort_elements(even_elements)\n    \n    return reconstruct_list(l, sorted_even_elements)"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    original_length = len(l)\n\n    # Handle edge cases: empty list and single-element list directly.\n    if original_length <= 1:\n        return l\n\n    def _extract_even_elements(input_list: list) -> list:\n        \"\"\"Extracts elements from the input list that are at even indices.\"\"\"\n        return [input_list[i] for i in range(len(input_list)) if i % 2 == 0]\n\n    def _extract_odd_elements(input_list: list) -> list:\n        \"\"\"Extracts (index, value) pairs for elements at odd indices.\"\"\"\n        return [(i, input_list[i]) for i in range(len(input_list)) if i % 2 != 0]\n\n    def _merge_lists(sorted_even_elements: list, odd_pairs: list, length: int) -> list:\n        \"\"\"Reconstructs the list from sorted even elements and preserved odd elements.\"\"\"\n        result = [None] * length\n        for index, value in odd_pairs:\n            result[index] = value\n\n        even_idx_counter = 0\n        for i in range(length):\n            if i % 2 == 0:\n                result[i] = sorted_even_elements[even_idx_counter]\n                even_idx_counter += 1\n        return result\n\n    # Extract even-indexed elements and odd-indexed elements with their positions.\n    even_elements = _extract_even_elements(l)\n    odd_elements_with_indices = _extract_odd_elements(l)\n\n    # Sort the collected even-indexed elements in ascending order.\n    even_elements.sort()\n\n    # Merge the sorted even elements and preserved odd elements into the final list.\n    return _merge_lists(even_elements, odd_elements_with_indices, original_length)"}
{"task_id": "HumanEval/38", "solution": "```python\nfrom typing import List\n\ndef _split_into_groups(s: str) -> List[str]:\n    \"\"\"\n    Splits a string into groups of maximum 3 characters.\n    The last group may have fewer than 3 characters.\n    \"\"\"\n    return [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n\ndef _cycle_group(group: str) -> str:\n    \"\"\"\n    Cycles characters in a 3-character group by moving the first to the end.\n    Groups with fewer than 3 characters are returned unchanged.\n    \"\"\"\n    return (group[1:] + group[0]) if len(group) == 3 else group\n\ndef _reverse_cycle_group(group: str) -> str:\n    \"\"\"\n    Reverses character cycling in a 3-character group by moving the last to the front.\n    Groups with fewer than 3 characters are returned unchanged.\n    \"\"\"\n    return (group[-1] + group[:-1]) if len(group) == 3 else group\n\ndef _join_groups(groups: List[str]) -> str:\n    \"\"\"\n    Concatenates a list of string groups into a single string.\n    No separators are added between the groups.\n    \"\"\"\n    return \"\".join(groups)\n\ndef encode_cyclic(s: str) -> str:\n    \"\"\"\n    Encodes a string by cyclically rotating characters within groups of three.\n    It uses helper functions to split, cycle, and join groups.\n    \"\"\"\n    groups = _split_into_groups(s)\n    cycled_groups = [_cycle_group(group) for group in groups]\n    return _join_groups(cycled_groups)\n\ndef decode_cyclic(s: str) -> str:\n    \"\"\"\n    Decodes a string previously encoded with encode_cyclic.\n    It reverses the cyclic rotation for each group of three characters.\n    \"\"\"\n    groups = _split_into_groups(s)\n    reverse_cycled_groups = [_reverse_cycle_group(group) for group in groups]\n    return _join_groups(reverse_cycled_groups)\n```"}
{"task_id": "HumanEval/38", "solution": "def _split_into_groups(s: str):\n    \"\"\"Split string into groups of up to 3 characters for processing.\"\"\"\n    return [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n\n\ndef _cycle_group_forward(group: str):\n    \"\"\"Apply forward cyclic rotation to a 3-character group.\"\"\"\n    return (group[1:] + group[0]) if len(group) == 3 else group\n\n\ndef _cycle_group_backward(group: str):\n    \"\"\"Apply backward cyclic rotation to a 3-character group.\"\"\"\n    return (group[-1] + group[:-1]) if len(group) == 3 else group\n\n\ndef encode_cyclic(s: str):\n    \"\"\"Encodes string by cycling groups of three characters using helper functions.\"\"\"\n    groups = _split_into_groups(s)\n    cycled_groups = [_cycle_group_forward(group) for group in groups]\n    return \"\".join(cycled_groups)\n\n\ndef decode_cyclic(s: str):\n    \"\"\"Decodes a string previously encoded with encode_cyclic by reversing the process.\"\"\"\n    groups = _split_into_groups(s)\n    reverse_cycled_groups = [_cycle_group_backward(group) for group in groups]\n    return \"\".join(reverse_cycled_groups)"}
{"task_id": "HumanEval/39", "solution": "import math\nfrom typing import Generator\n\ndef validate_input(n: int) -> bool:\n    \"\"\"\n    Validates the input parameter n.\n    This implementation always returns True, trusting the caller's input as per critical requirements.\n    \"\"\"\n    return True\n\ndef is_prime(number: int) -> bool:\n    \"\"\"\n    Determines if a given number is prime.\n    Checks for primality using trial division up to its square root.\n    \"\"\"\n    if number < 2:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(number)) + 1, 2):\n        if number % i == 0:\n            return False\n    return True\n\ndef generate_fibonacci() -> Generator[int, None, None]:\n    \"\"\"\n    Generates Fibonacci numbers starting from F(3)=2.\n    It yields successive Fibonacci numbers suitable for primality testing.\n    \"\"\"\n    a, b = 1, 1\n    while True:\n        next_fib = a + b\n        yield next_fib\n        a, b = b, next_fib\n\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    validate_input(n) # Called as per design, but does not raise exceptions due to critical requirements.\n\n    prime_count = 0\n    fib_gen = generate_fibonacci()\n\n    while True:\n        fib_num = next(fib_gen)\n        if is_prime(fib_num):\n            prime_count += 1\n            if prime_count == n:\n                return fib_num"}
{"task_id": "HumanEval/39", "solution": "from typing import Iterator\n\ndef input_validator(n: int) -> bool:\n    \"\"\"\n    Validates if the input n is a positive integer.\n    Returns True if n is positive.\n    \"\"\"\n    return n > 0\n\ndef fibonacci_generator() -> Iterator[int]:\n    \"\"\"\n    Generates Fibonacci numbers starting from F(1)=1, F(2)=1.\n    Yields 1, 1, 2, 3, 5, ...\n    \"\"\"\n    a, b = 0, 1\n    yield b\n    while True:\n        a, b = b, a + b\n        yield b\n\ndef is_prime(number: int) -> bool:\n    \"\"\"\n    Checks if a given number is a prime number.\n    Returns True if the number is prime, False otherwise.\n    \"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True\n\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    _ = input_validator(n) # Validates input n; per requirements, assumes n is a positive integer.\n\n    found_primes_count = 0\n    fib_gen = fibonacci_generator()\n\n    while True:\n        fib_num = next(fib_gen)\n        if is_prime(fib_num):\n            found_primes_count += 1\n            if found_primes_count == n:\n                return fib_num"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list) -> bool:\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            for k in range(j + 1, n):\n                if l[i] + l[j] + l[k] == 0:\n                    return True\n    return False"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    It returns True if three distinct elements sum to zero, and False otherwise.\n    \"\"\"\n\n    class InputValidator:\n        \"\"\"Responsible for validating properties of the input list.\"\"\"\n        @staticmethod\n        def validate_list_size(lst: list) -> bool:\n            \"\"\"Checks if the list has at least three elements.\"\"\"\n            return len(lst) >= 3\n\n        @staticmethod\n        def validate_list_type(lst: list) -> bool:\n            \"\"\"Verifies the input is a list, trusting its elements are integers.\"\"\"\n            return True # As per constraint, no specific element type check.\n\n    class TripleGenerator:\n        \"\"\"Generates all unique combinations of three distinct indices.\"\"\"\n        @staticmethod\n        def generate_combinations(list_size: int) -> 'collections.abc.Iterator[tuple]':\n            \"\"\"Iterates through all possible combinations of three distinct indices.\"\"\"\n            for i in range(list_size):\n                for j in range(i + 1, list_size):\n                    for k in range(j + 1, list_size):\n                        yield (i, j, k)\n\n    class SumCalculator:\n        \"\"\"Handles calculation of sums and checking for zero.\"\"\"\n        @staticmethod\n        def calculate_triple_sum(lst: list, positions: tuple) -> int:\n            \"\"\"Calculates the sum of elements at the given positions.\"\"\"\n            return lst[positions[0]] + lst[positions[1]] + lst[positions[2]]\n\n        @staticmethod\n        def check_zero_sum(sum_value: int) -> bool:\n            \"\"\"Determines if the calculated sum is equal to zero.\"\"\"\n            return sum_value == 0\n\n    # Interface Layer: Input validation (FR-004)\n    if not InputValidator.validate_list_size(l):\n        return False\n    InputValidator.validate_list_type(l) # Call validator, return value not explicitly used per constraint.\n\n    # Processing Layer: Generate triples and calculate sums (FR-002, FR-005)\n    list_size = len(l)\n    for i, j, k in TripleGenerator.generate_combinations(list_size):\n        triple_sum = SumCalculator.calculate_triple_sum(l, (i, j, k))\n        if SumCalculator.check_zero_sum(triple_sum):\n            return True # Result Layer: Found zero sum\n\n    # Result Layer: No zero sum found (FR-003)\n    return False"}
