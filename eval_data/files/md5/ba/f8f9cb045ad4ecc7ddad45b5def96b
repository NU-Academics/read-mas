{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(1, len(l)):\n        if l[i] < l[i-1]:\n            is_increasing = False\n        if l[i] > l[i-1]:\n            is_decreasing = False\n\n    return is_increasing or is_decreasing"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list) -> list:\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n    \"\"\"\n    # Convert lists to sets to find unique common elements efficiently.\n    # Then convert the resulting set to a list and sort it in ascending order.\n    set1 = set(l1)\n    set2 = set(l2)\n    common_elements_set = set1.intersection(set2)\n    return sorted(list(common_elements_set))"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    The function uses set intersection for efficiency and built-in sorted() for ordering.\n    \"\"\"\n    common_elements_set = set(l1) & set(l2)\n    return sorted(list(common_elements_set))"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int) -> int:\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        total_sum += i\n    return total_sum"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n\n    >>> correct_bracketing(\"<\")\n    False\n    >>> correct_bracketing(\"<>\")\n    True\n    >>> correct_bracketing(\"<<><>>\")\n    True\n    >>> correct_bracketing(\"><<>\")\n    False\n    >>> correct_bracketing(\"\")\n    True\n    \"\"\"\n    counter = 0\n    for char in brackets:\n        if char == '<':\n            counter += 1\n        elif char == '>':\n            counter -= 1\n        # If counter drops below zero, a closing bracket appeared without a corresponding opening bracket.\n        if counter < 0:\n            return False\n    # After iterating, if counter is zero, all brackets are balanced.\n    return counter == 0"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int) -> int:\n    \"\"\"sum_to_n calculates the sum of integers from 1 to n inclusive.\n    It uses the arithmetic series formula n * (n + 1) / 2.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    # Calculate the sum using the direct formula for arithmetic series.\n    # Integer division ensures the result remains an integer.\n    return (n * (n + 1)) // 2"}
{"task_id": "HumanEval/59", "solution": "from typing import List\n\ndef _find_prime_factors(n: int) -> List[int]:\n    \"\"\"Calculates all prime factors for a given number.\n    It iteratively divides the number by increasing integers to find its prime factors.\n    \"\"\"\n    factors: List[int] = []\n    current_num = n\n    divisor = 2\n    while divisor * divisor <= current_num:\n        while current_num % divisor == 0:\n            factors.append(divisor)\n            current_num //= divisor\n        divisor += 1\n    if current_num > 1:\n        factors.append(current_num)\n    return factors\n\ndef _get_largest_factor(factors: List[int]) -> int:\n    \"\"\"Retrieves the largest integer from a list of factors.\n    This function assumes the input list is not empty.\n    \"\"\"\n    return max(factors)\n\ndef largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    prime_factors = _find_prime_factors(n)\n    return _get_largest_factor(prime_factors)"}
{"task_id": "HumanEval/59", "solution": "def _is_prime(num: int) -> bool:\n    \"\"\"Checks if a number is prime.\n    It efficiently tests divisibility up to the square root of the number.\"\"\"\n    if num <= 1:\n        return False\n    if num <= 3:\n        return True\n    if num % 2 == 0 or num % 3 == 0:\n        return False\n    i = 5\n    while i * i <= num:\n        if num % i == 0 or num % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\n\ndef _find_prime_factors(n: int) -> list[int]:\n    \"\"\"Finds all distinct prime factors of a given number.\n    It iteratively divides the number and verifies factors are prime using _is_prime.\"\"\"\n    prime_factors = []\n    d = 2\n    temp_n = n\n\n    while d * d <= temp_n:\n        if temp_n % d == 0:\n            if _is_prime(d):\n                prime_factors.append(d)\n            while temp_n % d == 0:\n                temp_n //= d\n        d += 1\n\n    if temp_n > 1:\n        if _is_prime(temp_n):\n            prime_factors.append(temp_n)\n\n    return prime_factors\n\n\ndef largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    It delegates to _find_prime_factors and then finds the maximum.\"\"\"\n    factors = _find_prime_factors(n)\n    return max(factors)"}
{"task_id": "HumanEval/57", "solution": "def _is_increasing(l: list) -> bool:\n    \"\"\"Checks if a list is monotonically increasing.\n    Each element must be less than or equal to the next element.\"\"\"\n    # The list is guaranteed to have at least two elements when this is called by monotonic.\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            return False\n    return True\n\ndef _is_decreasing(l: list) -> bool:\n    \"\"\"Checks if a list is monotonically decreasing.\n    Each element must be greater than or equal to the next element.\"\"\"\n    # The list is guaranteed to have at least two elements when this is called by monotonic.\n    for i in range(len(l) - 1):\n        if l[i] < l[i+1]:\n            return False\n    return True\n\ndef monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    # Handles edge cases: empty lists and single-element lists are considered monotonic.\n    if len(l) <= 1:\n        return True\n\n    # Check if the list satisfies either increasing or decreasing conditions.\n    return _is_increasing(l) or _is_decreasing(l)"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    open_count = 0\n    for char in brackets:\n        if char == '(':\n            open_count += 1\n        elif char == ')':\n            if open_count > 0:\n                open_count -= 1\n            else:\n                return False  # Unmatched closing bracket\n    return open_count == 0"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\" brackets is a string of \"(\" and \")\".\n    Returns True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0"}
{"task_id": "HumanEval/62", "solution": "```python\ndef derivative(xs: list) -> list:\n    \"\"\"Calculates the derivative of a polynomial represented by coefficients.\n    The input list xs defines xs[0] + xs[1]*x + xs[2]*x^2 + ..., and the derivative is returned in the same format.\n    \"\"\"\n    derived_coefficients = []\n    for i in range(1, len(xs)):\n        derived_coefficients.append(i * xs[i])\n    \n    return derived_coefficients\n```"}
