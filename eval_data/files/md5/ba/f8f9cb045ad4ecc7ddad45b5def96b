{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n    \n    # Initialize the first four values to handle the base cases for iteration\n    # current_fib4_values[0] = fib4(i-4), [1] = fib4(i-3), [2] = fib4(i-2), [3] = fib4(i-1)\n    current_fib4_values = [0, 0, 2, 0] # Represents fib4(0), fib4(1), fib4(2), fib4(3)\n\n    for i in range(4, n + 1):\n        next_fib = sum(current_fib4_values)\n        current_fib_values.pop(0) # Remove the oldest value\n        current_fib_values.append(next_fib) # Add the newly computed value\n\n    return current_fib_values[3] # The last element in the list is fib4(n)"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"Computes the n-th element of the Fib4 number sequence iteratively.\n    Handles base cases for n < 4 and uses a sliding window for n >= 4.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n    \n    # For n >= 4, use an iterative approach\n    # Initialize with base values: fib4(0), fib4(1), fib4(2), fib4(3)\n    a, b, c, d = 0, 0, 2, 0 \n\n    for _ in range(4, n + 1):\n        next_fib4 = a + b + c + d\n        a = b\n        b = c\n        c = d\n        d = next_fib4\n        \n    return d"}
{"task_id": "HumanEval/47", "solution": "from typing import Union\n\ndef median(l: list) -> Union[int, float]:\n    \"\"\"Return median of elements in the list l.\n\n    Args:\n        l: List of numeric elements\n\n    Returns:\n        int: Median value for odd-length lists\n        float: Median value for even-length lists requiring averaging\n\n    Examples:\n        >>> median([3, 1, 2, 4, 5])\n        3\n        >>> median([-10, 4, 6, 1000, 10, 20])\n        15.0\n    \"\"\"\n    sorted_list = sorted(l)\n    n = len(sorted_list)\n\n    if n % 2 == 1:\n        # For odd-length lists, return the middle element.\n        return sorted_list[n // 2]\n    else:\n        # For even-length lists, average the two middle elements.\n        mid1 = sorted_list[n // 2 - 1]\n        mid2 = sorted_list[n // 2]\n        return (mid1 + mid2) / 2"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_l = sorted(l) # Sorts the input list to correctly identify middle elements.\n    n = len(sorted_l)    # Determines the total number of elements in the sorted list.\n\n    if n % 2 == 1:\n        # For an odd number of elements, the median is the single middle element.\n        return sorted_l[n // 2]\n    else:\n        # For an even number of elements, the median is the average of the two middle elements.\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2"}
