{"task_id": "HumanEval/91", "solution": "import re\n\ndef _split_sentences(text: str) -> list:\n    \"\"\"Split text into sentences using delimiters '.', '?', '!'.\n    Filters out any empty strings resulting from the split.\n    \"\"\"\n    delimiters = r'[.?!]'\n    # Split by delimiters, keeping delimiters as part of the split if needed for context,\n    # but here we just want to split and discard them.\n    # re.split creates empty strings if delimiters are at the start/end or consecutive.\n    parts = re.split(delimiters, text)\n    sentences = []\n    for part in parts:\n        stripped_part = part.strip()\n        if stripped_part:\n            sentences.append(stripped_part)\n    return sentences\n\ndef _get_first_word(sentence: str) -> str:\n    \"\"\"Extract the first word from a sentence.\n    Returns an empty string if the sentence is empty or only whitespace.\n    \"\"\"\n    trimmed_sentence = sentence.strip()\n    if not trimmed_sentence:\n        return \"\"\n    return trimmed_sentence.split(maxsplit=1)[0]\n\ndef _count_boredoms(sentences: list) -> int:\n    \"\"\"Count sentences that start with the exact word 'I'.\n    Compares the first word of each sentence to \"I\".\n    \"\"\"\n    boredom_count = 0\n    for sentence in sentences:\n        first_word = _get_first_word(sentence)\n        if first_word == \"I\":\n            boredom_count += 1\n    return boredom_count\n\ndef is_bored(S: str) -> int:\n    \"\"\"\n    Count the number of boredoms in a string.\n    A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    sentences = _split_sentences(S)\n    return _count_boredoms(sentences)"}
{"task_id": "HumanEval/91", "solution": "```python\ndef is_bored(S):\n    \"\"\"\n    Count the number of boredoms in a string.\n    A boredom is a sentence that starts with the word \"I\".\n    \"\"\"\n\n    def _split_sentences(text: str) -> list:\n        \"\"\"Split text into sentences using delimiters '.', '?', '!'\"\"\"\n        sentences = []\n        current_sentence_parts = []\n        delimiters = ('.', '?', '!')\n\n        for char in text:\n            if char in delimiters:\n                if current_sentence_parts:\n                    sentences.append(\"\".join(current_sentence_parts).strip())\n                    current_sentence_parts = []\n            else:\n                current_sentence_parts.append(char)\n\n        if current_sentence_parts:\n            sentences.append(\"\".join(current_sentence_parts).strip())\n\n        return [s for s in sentences if s]\n\n    def _starts_with_I(sentence: str) -> bool:\n        \"\"\"Check if sentence starts with the word 'I'\"\"\"\n        cleaned_sentence = sentence.strip()\n        if not cleaned_sentence:\n            return False\n        \n        words = cleaned_sentence.split(maxsplit=1)\n        return len(words) > 0 and words[0] == 'I'\n\n    def _count_boredoms(sentences: list) -> int:\n        \"\"\"Count sentences that start with 'I'.\"\"\"\n        count = 0\n        for sentence in sentences:\n            if _starts_with_I(sentence):\n                count += 1\n        return count\n\n    if not S:\n        return 0\n\n    sentences = _split_sentences(S)\n    return _count_boredoms(sentences)\n```"}
{"task_id": "HumanEval/92", "solution": "```python\ndef _is_integer(value):\n    \"\"\"Checks if a value is of type int.\n    Returns True for integers, False otherwise.\"\"\"\n    return type(value) is int\n\ndef _check_sum_conditions(x, y, z):\n    \"\"\"Evaluates if one number is the sum of the other two.\n    Assumes inputs are already validated as integers.\"\"\"\n    return (x == y + z) or (y == x + z) or (z == x + y)\n\ndef any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n    '''\n    # Validate that all inputs are integers. Early exit if any is not.\n    if not _is_integer(x) or not _is_integer(y) or not _is_integer(z):\n        return False\n    \n    # If all inputs are integers, check the sum conditions.\n    return _check_sum_conditions(x, y, z)\n```"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Determines if one of three numbers equals the sum of the other two,\n    given that all inputs are integers.\n    '''\n\n    def _is_integer(value):\n        '''\n        Checks if the given value represents an integer.\n        This handles rejection of floating-point numbers.\n        '''\n        # This implementation avoids isinstance() as per constraints\n        # while correctly distinguishing integers from other numeric types.\n        return value == int(value)\n\n    def _check_sum_conditions(a, b, c):\n        '''\n        Checks if any number is the sum of the other two.\n        This assumes all inputs are already validated as integers.\n        '''\n        return (a == b + c) or \\\n               (b == a + c) or \\\n               (c == a + b)\n\n    # First, validate that all inputs are integers\n    if not (_is_integer(x) and _is_integer(y) and _is_integer(z)):\n        return False\n\n    # If all inputs are integers, then check the sum conditions\n    return _check_sum_conditions(x, y, z)"}
{"task_id": "HumanEval/93", "solution": "def _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is an English vowel.\"\"\"\n    return char.lower() in 'aeiou'\n\ndef _replace_vowel(char: str) -> str:\n    \"\"\"Replaces a vowel with the letter two positions ahead, preserving original case.\"\"\"\n    replacements = {'a': 'c', 'e': 'g', 'i': 'k', 'o': 'q', 'u': 'w'}\n    if char.islower():\n        return replacements[char]\n    else: # char.isupper()\n        return replacements[char.lower()].upper()\n\ndef _swap_case(char: str) -> str:\n    \"\"\"Swaps the case of an alphabetic character, returning non-letters unchanged.\"\"\"\n    return char.swapcase()\n\ndef encode(message: str) -> str:\n    \"\"\"\n    Encodes a message by swapping case of all letters and replacing vowels with \n    the letter that appears 2 places ahead in the English alphabet.\n    \"\"\"\n    encoded_chars = []\n    for char in message:\n        if char.isalpha():\n            if _is_vowel(char):\n                # Replace vowel, then swap case of the replaced character\n                replaced_char = _replace_vowel(char)\n                encoded_chars.append(_swap_case(replaced_char))\n            else:\n                # Just swap case for consonants\n                encoded_chars.append(_swap_case(char))\n        else:\n            # Preserve non-alphabetic characters\n            encoded_chars.append(char)\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/93", "solution": "def is_letter(char: str) -> bool:\n    \"\"\"Checks if a character is an English alphabet letter.\"\"\"\n    return char.isalpha()\n\ndef swap_case(char: str) -> str:\n    \"\"\"Swaps the case of an alphabetic character.\"\"\"\n    return char.swapcase()\n\ndef is_vowel(char: str) -> bool:\n    \"\"\"Determines if a character is a vowel (case-insensitive).\"\"\"\n    return char.lower() in 'aeiou'\n\ndef replace_vowel(char: str) -> str:\n    \"\"\"Replaces a vowel with the letter 2 positions ahead in the alphabet.\"\"\"\n    vowel_map_lower = {'a': 'c', 'e': 'g', 'i': 'k', 'o': 'q', 'u': 'w'}\n    if char.islower():\n        return vowel_map_lower.get(char, char)\n    else: # char is uppercase\n        return vowel_map_lower.get(char.lower(), char.lower()).upper()\n\ndef encode(message: str) -> str:\n    \"\"\"\n    Encodes a message by swapping letter cases and replacing specific vowels.\n    Spaces and non-letters are preserved in their original positions.\n    \"\"\"\n    encoded_chars = []\n    for char in message:\n        if is_letter(char):\n            # Apply case transformation before vowel replacement\n            swapped_char = swap_case(char)\n            if is_vowel(swapped_char):\n                final_char = replace_vowel(swapped_char)\n            else:\n                final_char = swapped_char\n        else:\n            # Preserve spaces and non-letter characters\n            final_char = char\n        encoded_chars.append(final_char)\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "```python\ndef skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if a given integer is prime. Checks divisibility up to sqrt(n).\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of all digits in a number by converting it to a string.\"\"\"\n        total_sum = 0\n        for digit_char in str(n):\n            total_sum += int(digit_char)\n        return total_sum\n\n    largest_prime = 0\n\n    for num in lst:\n        if is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n\n    return sum_digits(largest_prime)\n```"}
{"task_id": "HumanEval/94", "solution": "import math\n\ndef is_prime(n: int) -> bool:\n    \"\"\"Determines if a given number is prime.\n    Checks for divisibility from 2 up to the square root of n.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0: # Handle even numbers greater than 2\n        return False\n    for i in range(3, int(math.sqrt(n)) + 1, 2): # Check only odd divisors\n        if n % i == 0:\n            return False\n    return True\n\ndef sum_digits(n: int) -> int:\n    \"\"\"Calculates the sum of all digits in a number.\n    For non-positive numbers, it returns 0, which handles the largest_prime = -1 edge case.\n    \"\"\"\n    total = 0\n    # The loop `while n > 0` correctly handles n=0 (returns 0) and negative n (returns 0).\n    while n > 0:\n        total += n % 10\n        n //= 10\n    return total\n\ndef skjkasdkd(lst: list[int]) -> int:\n    \"\"\"Finds the largest prime number in a list and returns the sum of its digits.\n    Iterates through the list, identifies primes, selects the largest, and calculates its digit sum.\n    \"\"\"\n    largest_prime = -1 # Initialize with a value that is not prime and smaller than any prime\n\n    for number in lst:\n        if is_prime(number):\n            if number > largest_prime:\n                largest_prime = number\n    \n    # If no primes were found (e.g., lst = [0, 1, 4, 6]), largest_prime remains -1.\n    # The sum_digits function will return 0 for -1, which is a sensible default.\n    return sum_digits(largest_prime)"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"\n    Validates if all dictionary keys are consistently lowercase or uppercase strings.\n    Returns False for empty dictionaries or those with non-string/mixed-case keys.\n    \"\"\"\n    if not dict:\n        return False\n\n    all_lowercase_keys = True\n    all_uppercase_keys = True\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n        \n        if not key.islower():\n            all_lowercase_keys = False\n        \n        if not key.isupper():\n            all_uppercase_keys = False\n            \n    return all_lowercase_keys or all_uppercase_keys\n```"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"\n    Validates if all dictionary keys are consistently lowercase or uppercase strings.\n    Returns False for empty dictionaries or dictionaries with non-string or mixed-case keys.\n    \"\"\"\n    keys = list(dict.keys())\n\n    if not keys:\n        return False\n\n    # First, ensure all keys are strings.\n    for key in keys:\n        if not isinstance(key, str):\n            return False\n\n    # Check if all keys are lowercase.\n    all_lowercase = True\n    for key in keys:\n        if not key.islower():\n            all_lowercase = False\n            break\n\n    # Check if all keys are uppercase.\n    all_uppercase = True\n    for key in keys:\n        if not key.isupper():\n            all_uppercase = False\n            break\n\n    # Return True if all keys are either consistently lowercase OR consistently uppercase.\n    return all_lowercase or all_uppercase\n```"}
{"task_id": "HumanEval/96", "solution": "import math\n\ndef is_prime(num):\n    \"\"\"Checks if a given number is prime.\n    Optimized by checking divisors only up to its square root.\n    \"\"\"\n    if num < 2:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(num)) + 1, 2):\n        if num % i == 0:\n            return False\n    return True\n\ndef count_up_to(n):\n    \"\"\"Implements a function that takes a non-negative integer n and returns an array\n    of prime numbers less than n, in ascending order.\n    \"\"\"\n    if n <= 1:\n        return []\n\n    primes = []\n    for i in range(2, n):\n        if is_prime(i):\n            primes.append(i)\n    return primes"}
{"task_id": "HumanEval/96", "solution": "def validate_non_negative(n: int) -> bool:\n    \"\"\"Checks if the input integer is non-negative.\"\"\"\n    return n >= 0\n\ndef is_prime(number: int) -> bool:\n    \"\"\"Determines if a given number is prime using trial division.\"\"\"\n    if number <= 1:\n        return False\n    if number <= 3:\n        return True\n    if number % 2 == 0 or number % 3 == 0:\n        return False\n    i = 5\n    while i * i <= number:\n        if number % i == 0 or number % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef generate_primes_up_to(limit: int) -> list[int]:\n    \"\"\"Generates all prime numbers less than the given limit.\"\"\"\n    primes = []\n    for number in range(2, limit):\n        if is_prime(number):\n            primes.append(number)\n    return primes\n\ndef format_result(primes: list[int]) -> list[int]:\n    \"\"\"Ensures the list of primes is in ascending order.\n    The prime generation logic already produces numbers in this order.\"\"\"\n    return primes\n\ndef count_up_to(n):\n    \"\"\"Implement a function that takes an non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    for example:\n    count_up_to(5) => [2,3]\n    count_up_to(11) => [2,3,5,7]\n    count_up_to(0) => []\n    count_up_to(20) => [2,3,5,7,11,13,17,19]\n    count_up_to(1) => []\n    count_up_to(18) => [2,3,5,7,11,13,17]\n    \"\"\"\n    _ = validate_non_negative(n)\n\n    if n <= 1:\n        return []\n\n    prime_list = generate_primes_up_to(n)\n    sorted_primes = format_result(prime_list)\n    return sorted_primes"}
