{"task_id": "HumanEval/0", "solution": "```python\nfrom typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    n = len(numbers)\n\n    # Handle edge cases for lists with fewer than two elements\n    if n < 2:\n        return False\n\n    # Iterate through all unique pairs of numbers to check their proximity.\n    # Returns True immediately if any pair is closer than the threshold.\n    for i in range(n):\n        for j in range(i + 1, n):\n            distance = abs(numbers[i] - numbers[j])\n            if distance < threshold:\n                return True\n\n    # If no close elements were found after checking all pairs, return False.\n    return False\n```"}
{"task_id": "HumanEval/3", "solution": "```python\nfrom typing import List\n\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    balance: int = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False\n```"}
{"task_id": "HumanEval/0", "solution": "from typing import List\n\n\ndef _calculate_distance(num1: float, num2: float) -> float:\n    \"\"\"Calculates the absolute difference between two numbers.\n    This utility function determines the proximity.\"\"\"\n    return abs(num1 - num2)\n\n\ndef _validate_inputs(numbers: List[float], threshold: float) -> None:\n    \"\"\"Validates the input parameters for the main function.\n    Per critical requirements, this function performs no active validation.\"\"\"\n    # The design specified validation and error raising, but critical requirements forbid it.\n    # Therefore, this function is a no-op to comply with the critical constraints.\n    pass\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    _validate_inputs(numbers, threshold)\n\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            distance = _calculate_distance(numbers[i], numbers[j])\n            if distance < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    cleaned_input = \"\".join(char for char in paren_string if char != ' ')\n    \n    result = []\n    current_group = []\n    balance_count = 0\n    \n    for char in cleaned_input:\n        current_group.append(char)\n        if char == '(':\n            balance_count += 1\n        elif char == ')':\n            balance_count -= 1\n        \n        if balance_count == 0:\n            result.append(\"\".join(current_group))\n            current_group = []\n\n    return result"}
{"task_id": "HumanEval/1", "solution": "```python\nfrom typing import List, Tuple\n\nclass ParenthesesGroup:\n    \"\"\"Encapsulates group data and validation logic for a single parentheses group.\"\"\"\n    def __init__(self, content: str):\n        \"\"\"Initializes the group with its string content and determines if it is balanced.\"\"\"\n        self.content: str = content\n        self.is_balanced: bool = self._static_validate_balance(content)\n\n    def validate(self) -> bool:\n        \"\"\"Checks and returns whether the group's content is balanced.\"\"\"\n        return self.is_balanced\n\n    def to_string(self) -> str:\n        \"\"\"Returns the string representation of the group's content.\"\"\"\n        return self.content\n\n    @staticmethod\n    def _static_validate_balance(group_content: str) -> bool:\n        \"\"\"An internal static method to perform the core balance check on a given string.\"\"\"\n        balance = 0\n        for char in group_content:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n\nclass InputString:\n    \"\"\"Handles preprocessing of the raw input string, primarily by removing spaces.\"\"\"\n    def __init__(self, raw_input: str):\n        \"\"\"Initializes with the original raw input string.\"\"\"\n        self._raw_input: str = raw_input\n        self._cleaned_input: str = \"\"\n\n    def remove_spaces(self) -> str:\n        \"\"\"Processes the raw input to remove all spaces and stores the result.\"\"\"\n        self._cleaned_input = self._raw_input.replace(' ', '')\n        return self._cleaned_input\n\n    def get_cleaned(self) -> str:\n        \"\"\"Returns the input string after space removal.\"\"\"\n        return self._cleaned_input\n\n\nclass ParenthesesParser:\n    \"\"\"Implements the core parsing and group separation algorithms.\"\"\"\n    @staticmethod\n    def parse(input_str: str) -> List[str]:\n        \"\"\"The main entry point for the parser, delegating to the group separation logic.\"\"\"\n        return ParenthesesParser.separate_groups(input_str)\n\n    @staticmethod\n    def separate_groups(cleaned_input: str) -> List[str]:\n        \"\"\"Identifies and extracts all top-level balanced parentheses groups from the cleaned input.\"\"\"\n        groups: List[str] = []\n        boundaries = ParenthesesParser._find_group_boundaries(cleaned_input)\n        for start, end in boundaries:\n            group_content = cleaned_input[start:end]\n            current_group = ParenthesesGroup(group_content)\n            # The boundary finding logic already ensures top-level balance.\n            # This check ensures adherence to the ParenthesesGroup class design.\n            if current_group.validate():\n                groups.append(current_group.to_string())\n        return groups\n\n    @staticmethod\n    def validate_balance(group: str) -> bool:\n        \"\"\"Checks if a given string represents a balanced group of parentheses.\"\"\"\n        return ParenthesesGroup(group).validate()\n\n    @staticmethod\n    def _find_group_boundaries(input_str: str) -> List[Tuple[int, int]]:\n        \"\"\"Locates the start and end indices of all independent, top-level balanced parentheses groups.\"\"\"\n        boundaries: List[Tuple[int, int]] = []\n        balance = 0\n        start_index = -1\n\n        for i, char in enumerate(input_str):\n            if char == '(':\n                if balance == 0:  # Mark start of a new top-level group\n                    start_index = i\n                balance += 1\n            elif char == ')':\n                balance -= 1\n\n            # If balance returns to 0 and we had an active start_index, a top-level group is complete\n            if balance == 0 and start_index != -1:\n                boundaries.append((start_index, i + 1))\n                start_index = -1  # Reset for the next top-level group\n        return boundaries\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    input_handler = InputString(paren_string)\n    cleaned_input = input_handler.remove_spaces()\n    \n    return ParenthesesParser.parse(cleaned_input)\n```"}
{"task_id": "HumanEval/4", "solution": "```python\nfrom typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation around the mean.\n    MAD is the average absolute difference between each element and the dataset's mean.\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    # Calculate the arithmetic mean of the input numbers.\n    data_mean = sum(numbers) / len(numbers)\n\n    # Calculate absolute differences between each number and the mean.\n    absolute_differences = [abs(x - data_mean) for x in numbers]\n\n    # Calculate the average of all absolute differences.\n    mad = sum(absolute_differences) / len(absolute_differences)\n\n    return mad\n```"}
{"task_id": "HumanEval/5", "solution": "from typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'.\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result: List[int] = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    MAD = average | x - x_mean |.\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    # Calculate the arithmetic mean of the dataset.\n    x_mean = sum(numbers) / len(numbers)\n\n    # Compute absolute differences between each value and the mean.\n    absolute_differences = [abs(x - x_mean) for x in numbers]\n\n    # Calculate the average of all absolute differences to get MAD.\n    mad = sum(absolute_differences) / len(absolute_differences)\n\n    return mad"}
{"task_id": "HumanEval/5", "solution": "```python\nfrom typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"Insert a number 'delimeter' between every two consecutive elements of input list `numbers'.\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    >>> intersperse([1], 4)\n    [1]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result\n```"}
{"task_id": "HumanEval/7", "solution": "from typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring.\n    The filtering is case-sensitive and preserves the original order of matching strings.\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\ndef split_groups(input_string: str) -> List[str]:\n    \"\"\"Split input string by spaces into groups.\"\"\"\n    return input_string.split(' ')\n\n\ndef calculate_depth(group: str) -> int:\n    \"\"\"Calculate maximum nesting depth for single group.\"\"\"\n    current_depth = 0\n    max_depth = 0\n    for char in group:\n        if char == '(':\n            current_depth += 1\n            if current_depth > max_depth:\n                max_depth = current_depth\n        elif char == ')':\n            current_depth -= 1\n    return max_depth\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Main parsing function as specified in SRS.\"\"\"\n    groups = split_groups(paren_string)\n    depths = []\n    for group in groups:\n        depths.append(calculate_depth(group))\n    return depths"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\nclass DepthTracker:\n    \"\"\"Tracks current and maximum nesting depth during character processing.\n    It updates depths as parentheses characters are processed.\n    \"\"\"\n    def __init__(self) -> None:\n        self.current_depth: int = 0\n        self.max_depth: int = 0\n\n    def process_char(self, char: str) -> None:\n        \"\"\"Processes a single character, updating current and maximum depth.\"\"\"\n        if char == '(':\n            self.current_depth += 1\n            if self.current_depth > self.max_depth:\n                self.max_depth = self.current_depth\n        elif char == ')':\n            self.current_depth -= 1\n\n    def get_max_depth(self) -> int:\n        \"\"\"Returns the maximum depth reached.\"\"\"\n        return self.max_depth\n\n\ndef _split_groups(input_string: str) -> List[str]:\n    \"\"\"Splits the input string into individual parentheses groups by spaces.\n    It handles flexible space separation and ignores empty segments.\n    \"\"\"\n    return input_string.split()\n\n\ndef _calculate_depth(group: str) -> int:\n    \"\"\"Calculates the maximum nesting depth for a single parentheses group.\n    It uses a DepthTracker to process each character linearly.\n    \"\"\"\n    tracker = DepthTracker()\n    for char in group:\n        tracker.process_char(char)\n    return tracker.get_max_depth()\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    paren_groups = _split_groups(paren_string)\n    depth_results: List[int] = []\n    for group in paren_groups:\n        # _calculate_depth handles empty groups correctly by returning 0.\n        depth_results.append(_calculate_depth(group))\n    return depth_results"}
{"task_id": "HumanEval/7", "solution": "from typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring.\n    The matching is case-sensitive and preserves the original order.\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    filtered_strings = []\n    for s in strings:\n        if substring in s:\n            filtered_strings.append(s)\n    return filtered_strings"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    total_sum = sum(numbers)\n    total_product = 1\n    for num in numbers:\n        total_product *= num\n\n    return (total_sum, total_product)"}
{"task_id": "HumanEval/8", "solution": "```python\nfrom typing import List, Tuple\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n    return (current_sum, current_product)\n```"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Out of a list of strings, return the longest one.\n    Returns the first one in case of multiple strings of the same length, or None if the list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    current_longest_string = strings[0]\n\n    for s in strings[1:]:\n        if len(s) > len(current_longest_string):\n            current_longest_string = s\n\n    return current_longest_string"}
{"task_id": "HumanEval/11", "solution": "```python\nfrom typing import List\n\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    result_chars = []\n    # Iterate through both strings, assuming they are of equal length.\n    for i in range(len(a)):\n        # Perform XOR logic: '0' if bits are the same, '1' if different.\n        if a[i] == b[i]:\n            result_chars.append('0')\n        else:\n            result_chars.append('1')\n    return \"\".join(result_chars)\n```"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    >>> longest(['aa', 'bb', 'cc'])\n    'aa'\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_found = strings[0]\n    max_len = len(strings[0])\n\n    for s in strings[1:]:\n        current_len = len(s)\n        if current_len > max_len:\n            max_len = current_len\n            longest_found = s\n\n    return longest_found"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    current_max = numbers[0]\n    result.append(current_max)\n\n    for num in numbers[1:]:\n        current_max = max(current_max, num)\n        result.append(current_max)\n\n    return result"}
{"task_id": "HumanEval/9", "solution": "```python\nfrom typing import List, Tuple\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    result: List[int] = []\n    current_max: float = float('-inf') # Initialize current_max to a very small number to correctly handle the first element.\n\n    for number in numbers:\n        if number > current_max:\n            current_max = number\n        result.append(int(current_max)) # Append the current maximum to the result list.\n    return result\n```"}
{"task_id": "HumanEval/11", "solution": "```python\nfrom typing import List\n\ndef _validate_binary_string(s: str) -> bool:\n    \"\"\"Validate that string contains only '1' and '0' characters.\"\"\"\n    for char in s:\n        if char not in ('0', '1'):\n            return False\n    return True\n\ndef _validate_equal_length(a: str, b: str) -> bool:\n    \"\"\"Validate that both strings have equal length.\"\"\"\n    return len(a) == len(b)\n\ndef _xor_characters(char1: str, char2: str) -> str:\n    \"\"\"Perform XOR operation on two character bits.\"\"\"\n    if char1 == char2:\n        return '0'\n    return '1'\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\"Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    result_bits = []\n    for char_a, char_b in zip(a, b):\n        result_bits.append(_xor_characters(char_a, char_b))\n    return \"\".join(result_bits)\n```"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\"Test if given string is a palindrome\"\"\"\n    return string == string[::-1]\n\ndef make_palindrome(string: str) -> str:\n    \"\"\"Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    n = len(string)\n    if n == 0:\n        return \"\"\n\n    for i in range(n):\n        # Check if the postfix string[i:] is a palindrome\n        if string[i:] == string[i:][::-1]:\n            # The part of the string before the palindromic postfix is string[:i]\n            # We append the reverse of this prefix to the original string\n            return string + string[:i][::-1]\n\n    # This line should ideally not be reached for non-empty strings\n    # because at least a single character (the last char) is a palindrome.\n    # However, for completeness and robustness, it implies the string itself\n    # was already a palindrome (i=0) or an empty string (already handled).\n    return string"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\"Test if given string is a palindrome (FR-001)\"\"\"\n    return string == string[::-1]\n\ndef _reverse_string(string: str) -> str:\n    \"\"\"Internal: Reverse string for prefix creation (FR-006)\"\"\"\n    return string[::-1]\n\ndef _find_longest_palindromic_postfix(string: str) -> int:\n    \"\"\"Internal: Find longest palindromic postfix position (FR-005)\"\"\"\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            return i\n    return len(string) # Should not be reached for non-empty string, for empty string returns 0\n\ndef make_palindrome(string: str) -> str:\n    \"\"\"Find shortest palindrome beginning with supplied string (FR-004)\"\"\"\n    if not string:\n        return \"\"\n\n    postfix_start_index = _find_longest_palindromic_postfix(string)\n    prefix_to_reverse = string[:postfix_start_index]\n    reversed_prefix = _reverse_string(prefix_to_reverse)\n    \n    return string + reversed_prefix"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    a = abs(a)\n    b = abs(b)\n    while b:\n        a, b = b, a % b\n    return a"}
