{"task_id": "HumanEval/63", "solution": "_fibfib_memo_cache = {}\n\ndef fibfib(n: int) -> int:\n    \"\"\"Computes the n-th FibFib number using memoization.\n    The sequence is defined by fibfib(0)=0, fibfib(1)=0, fibfib(2)=1, and fibfib(n) = fibfib(n-1) + fibfib(n-2) + fibfib(n-3) for n > 2.\n    >>> fibfib(1)\n    0\n    >>> fibfib(5)\n    4\n    >>> fibfib(8)\n    24\n    \"\"\"\n    if n in _fibfib_memo_cache:\n        return _fibfib_memo_cache[n]\n\n    if n == 0:\n        result = 0\n    elif n == 1:\n        result = 0\n    elif n == 2:\n        result = 1\n    else:\n        result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n    \n    _fibfib_memo_cache[n] = result\n    return result"}
{"task_id": "HumanEval/63", "solution": "_memo_cache = {\n    0: 0,\n    1: 0,\n    2: 1\n}\n\ndef fibfib(n: int) -> int:\n    \"\"\"The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    >>> fibfib(1)\n    0\n    >>> fibfib(5)\n    4\n    >>> fibfib(8)\n    24\n    \"\"\"\n    if n in _memo_cache:\n        return _memo_cache[n]\n\n    result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n    _memo_cache[n] = result\n    return result"}
{"task_id": "HumanEval/64", "solution": "```python\ndef vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n    \"\"\"\n    vowels = {'a', 'e', 'i', 'o', 'u'}\n    count = 0\n    for i, char in enumerate(s):\n        char_lower = char.lower()\n        if char_lower in vowels:\n            count += 1\n        elif char_lower == 'y' and i == len(s) - 1:\n            count += 1\n    return count\n```"}
{"task_id": "HumanEval/64", "solution": "```python\ndef vowels_count(s):\n    \"\"\"Counts the number of vowels in a string, including 'y' when at the end of the word.\n    Standard vowels are 'a', 'e', 'i', 'o', 'u' (case-insensitive).\n    \"\"\"\n    count = 0\n    vowels = {'a', 'e', 'i', 'o', 'u'}\n    \n    for i, char in enumerate(s):\n        lower_char = char.lower()\n        \n        if lower_char in vowels:\n            count += 1\n        elif lower_char == 'y' and i == len(s) - 1:\n            count += 1\n            \n    return count\n```"}
{"task_id": "HumanEval/65", "solution": "def _extract_digits(x):\n    \"\"\"Converts an integer to its string representation of digits.\"\"\"\n    return str(x)\n\ndef _perform_shift(digits, shift):\n    \"\"\"Performs a circular right shift on a digit string.\"\"\"\n    num_digits = len(digits)\n    if num_digits == 0:\n        return \"\"\n    actual_shift = shift % num_digits\n    return digits[-actual_shift:] + digits[:-actual_shift]\n\ndef _reverse_digits(digits):\n    \"\"\"Reverses the order of digits in a string.\"\"\"\n    return digits[::-1]\n\ndef circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    \"\"\"\n    digits_str = _extract_digits(x)\n    num_digits = len(digits_str)\n\n    if shift > num_digits:\n        return _reverse_digits(digits_str)\n    else:\n        return _perform_shift(digits_str, shift)"}
{"task_id": "HumanEval/65", "solution": "def _extract_digits(x: int) -> str:\n    \"\"\"Converts an integer to its string representation.\n    This extracts the digits for further processing.\n    \"\"\"\n    return str(x)\n\ndef _perform_circular_shift(digits: str, shift: int) -> str:\n    \"\"\"Performs a circular right shift on a string of digits.\n    The shift wraps around the string's length.\n    \"\"\"\n    if not digits:\n        return \"\"\n    num_digits = len(digits)\n    effective_shift = shift % num_digits\n    shifted_digits = digits[-effective_shift:] + digits[:-effective_shift]\n    return shifted_digits\n\ndef _reverse_digits(digits: str) -> str:\n    \"\"\"Reverses the order of digits in a string.\n    This is used when the shift amount exceeds the digit count.\n    \"\"\"\n    return digits[::-1]\n\ndef circular_shift(x: int, shift: int) -> str:\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    digits = _extract_digits(x)\n    num_digits = len(digits)\n\n    if shift <= num_digits:\n        return _perform_circular_shift(digits, shift)\n    else:\n        return _reverse_digits(digits)"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s: str) -> int:\n    \"\"\"Calculate sum of ASCII values for uppercase characters only.\n    Iterates through the string, adding the ASCII value of each uppercase character to a running total.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if 'A' <= char <= 'Z':  # Check if character is an uppercase letter\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s: str) -> int:\n    \"\"\"\n    Calculate sum of ASCII values for uppercase characters only.\n    Iterates through the string, summing ASCII values of uppercase letters found.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/67", "solution": "def extract_apples(s: str) -> int:\n    \"\"\"Extracts the count of apples from the formatted string.\"\"\"\n    # Find the substring before \" apples\" and convert to integer.\n    part_before_apples = s.split(' apples and ')[0]\n    return int(part_before_apples)\n\ndef extract_oranges(s: str) -> int:\n    \"\"\"Extracts the count of oranges from the formatted string.\"\"\"\n    # Find the substring between \" and \" and \" oranges\" and convert to integer.\n    part_after_apples_and = s.split(' apples and ')[1]\n    part_before_oranges = part_after_apples_and.split(' oranges')[0]\n    return int(part_before_oranges)\n\ndef parse_fruit_string(s: str) -> tuple[int, int]:\n    \"\"\"Parses the fruit distribution string to extract apple and orange counts.\"\"\"\n    # Calls helper functions to get individual fruit counts.\n    apples = extract_apples(s)\n    oranges = extract_oranges(s)\n    return apples, oranges\n\ndef validate_inputs(total: int, apples: int, oranges: int) -> bool:\n    \"\"\"Validates input parameters for correctness.\"\"\"\n    # As per design constraints, this function always returns True.\n    return True\n\ndef calculate_mangoes(total: int, apples: int, oranges: int) -> int:\n    \"\"\"Calculates the mango count by subtracting apples and oranges from the total.\"\"\"\n    # Performs the simple subtraction to find the remaining mangoes.\n    return total - apples - oranges\n\ndef fruit_distribution(s: str, n: int) -> int:\n    \"\"\"\n    Calculates the number of mango fruits in a basket given apple and orange counts.\n    It parses a string and performs a simple subtraction.\n    \"\"\"\n    # Use the parsing functions to get apple and orange counts.\n    apples_count, oranges_count = parse_fruit_string(s)\n\n    # Validate inputs (always returns True as per design constraints).\n    _ = validate_inputs(n, apples_count, oranges_count)\n\n    # Calculate and return the number of mangoes.\n    mango_count = calculate_mangoes(n, apples_count, oranges_count)\n    return mango_count"}
{"task_id": "HumanEval/67", "solution": "import re\n\ndef _extract_apple_count(s: str) -> int:\n    \"\"\"Extract apple count from distribution string using regex.\n    It expects the number to precede \"apples\".\n    \"\"\"\n    match = re.search(r'(\\d+)\\s+apples', s)\n    return int(match.group(1))\n\ndef _extract_orange_count(s: str) -> int:\n    \"\"\"Extract orange count from distribution string using regex.\n    It expects the number to precede \"oranges\".\n    \"\"\"\n    match = re.search(r'(\\d+)\\s+oranges', s)\n    return int(match.group(1))\n\ndef _calculate_mangos(apples: int, oranges: int, total: int) -> int:\n    \"\"\"Calculate mango count using the formula: total - apples - oranges.\"\"\"\n    return total - apples - oranges\n\ndef fruit_distribution(s: str, n: int) -> int:\n    \"\"\"\n    Calculate the number of mango fruits in a basket.\n    It parses apple and orange counts from the input string and subtracts them from the total.\n    \"\"\"\n    apple_count = _extract_apple_count(s)\n    orange_count = _extract_orange_count(s)\n    mango_count = _calculate_mangos(apple_count, orange_count, n)\n    return mango_count"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr: list[int]) -> list[int]:\n    \"\"\"\n    Find the smallest even value in array and return [value, index].\n    Returns [] if no even values or empty array.\n    \"\"\"\n    min_even = None\n    min_index = None\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even\n            if min_even is None or value < min_even:\n                min_even = value\n                min_index = i\n            # If value == min_even, we do not update to ensure leftmost occurrence is kept.\n\n    if min_even is None:\n        return []\n    else:\n        return [min_even, min_index]"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting alternates between minimum and maximum values.\n    '''\n    result = []\n    # Create a mutable copy of the input list to modify\n    remaining_elements = sorted(list(lst)) # Sorting initially simplifies min/max finding significantly\n\n    # True for minimum turn, False for maximum turn\n    is_min_turn = True\n\n    while remaining_elements:\n        if is_min_turn:\n            # For minimum turn, pick the smallest element remaining\n            # Since remaining_elements is sorted, the smallest is always at index 0\n            selected_value = remaining_elements.pop(0)\n        else:\n            # For maximum turn, pick the largest element remaining\n            # Since remaining_elements is sorted, the largest is always at the last index\n            selected_value = remaining_elements.pop(-1)\n        \n        result.append(selected_value)\n        is_min_turn = not is_min_turn # Alternate the turn\n\n    return result"}
{"task_id": "HumanEval/70", "solution": "from typing import List\n\ndef strange_sort_list(lst: List[int]) -> List[int]:\n    \"\"\"\n    Given list of integers, return list in strange order.\n    Strange sorting starts with the minimum value, then maximum of the remaining integers, and so on.\n    \"\"\"\n    if not lst:\n        return []\n\n    remaining_elements = list(lst)  # Create a mutable copy of the input list\n    result = []\n    is_min_turn = True\n\n    while remaining_elements:\n        if is_min_turn:\n            current_selection = min(remaining_elements)\n        else:\n            current_selection = max(remaining_elements)\n\n        result.append(current_selection)\n        remaining_elements.remove(current_selection)\n        is_min_turn = not is_min_turn\n\n    return result"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Given an array of non-negative integers, find the smallest even value and its index.\n    Handles empty arrays, no even values, and tie-breaking by smallest index.\n    \"\"\"\n\n    class ArrayProcessor:\n        \"\"\"Handles input array validation for non-emptiness.\"\"\"\n        def validate_input(self, arr_data: list) -> bool:\n            \"\"\"Checks if the input array is not empty.\"\"\"\n            return len(arr_data) > 0\n\n    class EvenValueFinder:\n        \"\"\"Core logic for identifying and finding the smallest even value and its index.\"\"\"\n        def find_smallest_even_with_index(self, arr_data: list) -> tuple:\n            \"\"\"Iterates to find the smallest even value with the smallest index.\"\"\"\n            smallest_even_val = float('inf')\n            smallest_even_idx = -1\n\n            for i, value in enumerate(arr_data):\n                if value % 2 == 0:  # Check if the value is even\n                    if value < smallest_even_val:\n                        smallest_even_val = value\n                        smallest_even_idx = i\n                    elif value == smallest_even_val:\n                        # Tie-breaking: if values are equal, the first encountered (smallest index) wins.\n                        # Since iteration is left-to-right, smallest_even_idx naturally holds the smallest index.\n                        pass \n            \n            if smallest_even_idx != -1:\n                return (smallest_even_val, smallest_even_idx)\n            return None\n\n    class ResultFormatter:\n        \"\"\"Formats the output result as a list or an empty list.\"\"\"\n        def format_result(self, value: int, index: int) -> list:\n            \"\"\"Creates a result list in the format [value, index].\"\"\"\n            return [value, index]\n\n        def create_empty_result(self) -> list:\n            \"\"\"Returns an empty list for cases with no valid results.\"\"\"\n            return []\n\n    # Orchestration of the pluck function using internal components\n    array_processor = ArrayProcessor()\n    even_value_finder = EvenValueFinder()\n    result_formatter = ResultFormatter()\n\n    if not array_processor.validate_input(arr):\n        return result_formatter.create_empty_result()\n\n    smallest_even_node = even_value_finder.find_smallest_even_with_index(arr)\n\n    if smallest_even_node is None:\n        return result_formatter.create_empty_result()\n    else:\n        value, index = smallest_even_node\n        return result_formatter.format_result(value, index)"}
{"task_id": "HumanEval/69", "solution": "from typing import List, Dict\n\n# Helper function 1: Calculate frequency distribution\ndef _calculate_frequencies(lst: List[int]) -> Dict[int, int]:\n    \"\"\"Calculates the frequency of each integer in the input list.\n    Returns a dictionary mapping integers to their counts.\"\"\"\n    frequencies = {}\n    for item in lst:\n        frequencies[item] = frequencies.get(item, 0) + 1\n    return frequencies\n\n# Helper function 2: Identify integers where frequency >= value\ndef _find_qualifying_integers(frequencies: Dict[int, int]) -> List[int]:\n    \"\"\"Identifies integers whose frequency is greater than or equal to their value.\n    Returns a list of these qualifying integers.\"\"\"\n    qualifying_list = []\n    for number, frequency in frequencies.items():\n        if frequency >= number:\n            qualifying_list.append(number)\n    return qualifying_list\n\n# Helper function 3: Find maximum value from qualifying candidates\ndef _get_maximum(candidates: List[int]) -> int:\n    \"\"\"Finds the maximum value from a list of qualifying integers.\n    Returns -1 if the list is empty.\"\"\"\n    if not candidates:\n        return -1\n    return max(candidates)\n\ndef search(lst: List[int]) -> int:\n    '''\n    Returns the greatest integer from a list where its frequency is greater than or equal to its value.\n    If no such value exists, returns -1.\n    '''\n    \n    # Calculate frequency of each integer in the input list.\n    frequencies = _calculate_frequencies(lst)\n    \n    # Identify integers where frequency >= value.\n    qualifying_candidates = _find_qualifying_integers(frequencies)\n    \n    # Find maximum value from qualifying candidates or return -1 if none.\n    result = _get_maximum(qualifying_candidates)\n    \n    return result"}
{"task_id": "HumanEval/71", "solution": "import math\n\ndef _validate_triangle(a, b, c):\n    \"\"\"\n    Validates if three side lengths can form a valid triangle.\n    Checks for positive side lengths and triangle inequality constraints.\n    \"\"\"\n    if a <= 0 or b <= 0 or c <= 0:\n        return False\n    # Sum of any two sides must be greater than the third side.\n    if not (a + b > c and a + c > b and b + c > a):\n        return False\n    return True\n\ndef _calculate_area_heron(a, b, c):\n    \"\"\"\n    Calculates the area of a triangle using Heron's formula.\n    Assumes valid triangle side lengths, handling floating point precision for degenerate cases.\n    \"\"\"\n    s = (a + b + c) / 2\n    # Heron's formula for triangle area. `max(0, ...)` handles potential tiny negative values due to float precision.\n    area_squared = s * (s - a) * (s - b) * (s - c)\n    return math.sqrt(max(0, area_squared))\n\ndef _round_to_two_decimals(value):\n    \"\"\"\n    Rounds a numeric value to exactly two decimal places.\n    The result is a float.\n    \"\"\"\n    # Python's built-in round function is used for specified decimal precision.\n    return round(value, 2)\n\ndef triangle_area(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle, returns its area\n    rounded to 2 decimal points if valid, otherwise returns -1.\n    \"\"\"\n    if not _validate_triangle(a, b, c):\n        return -1\n    \n    area = _calculate_area_heron(a, b, c)\n    return _round_to_two_decimals(area)"}
{"task_id": "HumanEval/69", "solution": "from typing import List, Dict\n\ndef validate_input(lst: List[int]) -> bool:\n    \"\"\"Validate input list.\n    Always returns True assuming caller provides valid input.\"\"\"\n    # Per requirements, we trust the caller provides a non-empty list of positive integers.\n    return True\n\ndef count_frequencies(lst: List[int]) -> Dict[int, int]:\n    \"\"\"Count frequency of each integer in the list.\n    Returns a dictionary mapping integers to their counts.\"\"\"\n    frequencies = {}\n    for num in lst:\n        frequencies[num] = frequencies.get(num, 0) + 1\n    return frequencies\n\ndef find_qualifying_integers(frequencies: Dict[int, int]) -> List[int]:\n    \"\"\"Find integers where frequency is greater than or equal to the integer's value.\n    Returns a list of such integers.\"\"\"\n    qualifying_integers = []\n    for num, freq in frequencies.items():\n        if freq >= num:\n            qualifying_integers.append(num)\n    return qualifying_integers\n\ndef get_maximum(candidates: List[int]) -> int:\n    \"\"\"Return maximum value from candidates.\n    Assumes candidates list is not empty per design flow.\"\"\"\n    return max(candidates)\n\ndef handle_no_match() -> int:\n    \"\"\"Return -1 when no qualifying integers exist.\"\"\"\n    return -1\n\ndef _orchestrate_search(lst: List[int]) -> int:\n    \"\"\"Internal workflow coordination for the search algorithm.\n    Processes the list to find the greatest qualifying integer.\"\"\"\n    frequencies = count_frequencies(lst)\n    qualifying_integers = find_qualifying_integers(frequencies)\n\n    if qualifying_integers:\n        return get_maximum(qualifying_integers)\n    else:\n        return handle_no_match()\n\ndef search(lst: List[int]) -> int:\n    \"\"\"Main search function implementing the algorithm.\n    Identifies the greatest integer in a list whose frequency meets or exceeds its own value.\"\"\"\n    # The input is trusted to be a non-empty list of positive integers.\n    # `validate_input` is called to adhere to the architectural flow.\n    _ = validate_input(lst)\n    return _orchestrate_search(lst)"}
{"task_id": "HumanEval/71", "solution": "import math\n\ndef _sqrt(value):\n    \"\"\"Calculates the square root of a given value.\"\"\"\n    return math.sqrt(value)\n\ndef _abs(value):\n    \"\"\"Calculates the absolute value of a given number.\"\"\"\n    return abs(value)\n\ndef _validate_triangle_inequality(side1, side2, side3):\n    \"\"\"Checks if three sides satisfy the triangle inequality and are positive.\"\"\"\n    # All sides must be positive\n    if not (side1 > 0 and side2 > 0 and side3 > 0):\n        return False\n    # Sum of any two sides must be greater than the third side\n    return (side1 + side2 > side3) and \\\n           (side1 + side3 > side2) and \\\n           (side2 + side3 > side1)\n\ndef _is_valid_triangle(a, b, c):\n    \"\"\"Determines if the given side lengths form a valid triangle.\"\"\"\n    return _validate_triangle_inequality(a, b, c)\n\ndef _calculate_semi_perimeter(a, b, c):\n    \"\"\"Calculates the semi-perimeter of a triangle.\"\"\"\n    return (a + b + c) / 2.0\n\ndef _calculate_area_herons(a, b, c):\n    \"\"\"Calculates the triangle area using Heron's formula.\"\"\"\n    s = _calculate_semi_perimeter(a, b, c)\n    area_squared_term = s * (s - a) * (s - b) * (s - c)\n    # The _is_valid_triangle check ensures area_squared_term will be non-negative.\n    return _sqrt(area_squared_term)\n\ndef _round_to_two_decimals(value):\n    \"\"\"Rounds a floating-point number to two decimal places.\"\"\"\n    return round(value, 2)\n\ndef _format_result(area):\n    \"\"\"Formats the calculated area by rounding to two decimal places.\"\"\"\n    return _round_to_two_decimals(area)\n\ndef triangle_area(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    \"\"\"\n    if _is_valid_triangle(a, b, c):\n        area = _calculate_area_herons(a, b, c)\n        return _format_result(area)\n    else:\n        return -1"}
{"task_id": "HumanEval/72", "solution": "def is_palindromic(q):\n    \"\"\"Check if list is palindromic (reads same forwards and backwards).\n    This function handles empty and single-element lists correctly.\n    \"\"\"\n    return q == q[::-1]\n\ndef calculate_sum(q):\n    \"\"\"Calculate sum of all elements in the list.\n    This uses Python's built-in sum() for efficiency.\n    \"\"\"\n    return sum(q)\n\ndef validate_weight(sum_value, max_weight):\n    \"\"\"Check if sum is less than or equal to maximum weight.\n    Returns True if sum_value <= max_weight, False otherwise.\n    \"\"\"\n    return sum_value <= max_weight\n\ndef will_it_fly(q, w):\n    \"\"\"Main function that returns True if object will fly, False otherwise.\n    Object flies if balanced (palindromic) and within weight limit.\n    \"\"\"\n    balanced = is_palindromic(q)\n    total_weight = calculate_sum(q)\n    weight_valid = validate_weight(total_weight, w)\n    \n    return balanced and weight_valid"}
{"task_id": "HumanEval/73", "solution": "def _compare_positions(arr: list[int], left: int, right: int) -> bool:\n    \"\"\"Helper to compare elements at symmetric positions.\"\"\"\n    return arr[left] == arr[right]\n\ndef _count_mismatches(arr: list[int]) -> int:\n    \"\"\"Helper to count mismatched pairs requiring changes for palindrome transformation.\"\"\"\n    mismatch_count = 0\n    left, right = 0, len(arr) - 1\n    while left < right:\n        if not _compare_positions(arr, left, right):\n            mismatch_count += 1\n        left += 1\n        right -= 1\n    return mismatch_count\n\ndef smallest_change(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the minimum number of element changes required to transform an integer array into a palindromic array.\n    Returns 0 for arrays that are already palindromic or have one or zero elements.\n    \"\"\"\n    if len(arr) <= 1:\n        return 0\n    return _count_mismatches(arr)"}
{"task_id": "HumanEval/72", "solution": "def is_palindrome(lst):\n    \"\"\"\n    Checks if a list is palindromic using a two-pointer approach.\n    It returns True if the list reads the same forwards and backwards, False otherwise.\n    \"\"\"\n    left, right = 0, len(lst) - 1\n    while left < right:\n        if lst[left] != lst[right]:\n            return False\n        left += 1\n        right -= 1\n    return True\n\ndef calculate_sum(lst):\n    \"\"\"\n    Calculates the sum of all numeric elements in a list.\n    This function processes each element once to compute the total sum.\n    \"\"\"\n    total = 0\n    for item in lst:\n        total += item\n    return total\n\ndef will_it_fly(q, w):\n    \"\"\"\n    Determines if an object q will fly based on its balance and weight.\n    It flies if it's a palindromic list and its total weight is within the limit w.\n    \"\"\"\n    is_balanced = is_palindrome(q)\n    total_weight = calculate_sum(q)\n    \n    return is_balanced and (total_weight <= w)"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    '''\n    Compares two lists of strings by their total character count and returns the one with fewer characters.\n    Returns the first list if counts are equal.\n    '''\n    def _calculate_total_chars(string_list):\n        '''\n        Calculates the total number of characters across all strings in a list.\n        Iterates through the list, summing the length of each string.\n        '''\n        total_chars = 0\n        for s in string_list:\n            total_chars += len(s)\n        return total_chars\n\n    count1 = _calculate_total_chars(lst1)\n    count2 = _calculate_total_chars(lst2)\n\n    if count1 <= count2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/73", "solution": "def _validate_input(arr: list) -> bool:\n    \"\"\"Validates input array structure. Assumes valid integer array input based on requirements.\"\"\"\n    # As per CRITICAL REQUIREMENTS, \"Trust the caller's inputs\" and \"Do NOT add isinstance() checks\".\n    # This function conceptually validates but performs no actual runtime checks to meet constraints.\n    return True\n\ndef _is_palindromic(arr: list) -> bool:\n    \"\"\"Checks if the array is already palindromic using a two-pointer approach.\"\"\"\n    left, right = 0, len(arr) - 1\n    while left < right:\n        if arr[left] != arr[right]:\n            return False\n        left += 1\n        right -= 1\n    return True\n\ndef _calculate_changes(arr: list) -> int:\n    \"\"\"Calculates the minimum changes needed to make the array palindromic.\"\"\"\n    changes = 0\n    left, right = 0, len(arr) - 1\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes\n\ndef smallest_change(arr: list) -> int:\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic.\n    \"\"\"\n    _validate_input(arr) # Conceptual validation, always returns True per design constraints.\n\n    if _is_palindromic(arr):\n        return 0\n    else:\n        return _calculate_changes(arr)"}
{"task_id": "HumanEval/74", "solution": "def _calculate_total_chars(lst: list) -> int:\n    \"\"\"Calculate total number of characters in all strings of a list.\n    This helper sums the lengths of all strings in the provided list.\"\"\"\n    total_chars = 0\n    for s in lst:\n        total_chars += len(s)\n    return total_chars\n\ndef _compare_lists(count1: int, count2: int, lst1: list, lst2: list) -> list:\n    \"\"\"Compare character counts and return appropriate list based on business rules.\n    If counts are equal, the first list (lst1) is returned as per tie-breaking logic.\"\"\"\n    if count1 <= count2:\n        return lst1\n    else:\n        return lst2\n\ndef total_match(lst1: list, lst2: list) -> list:\n    \"\"\"\n    Write a function that accepts two lists of strings and returns the list that has\n    total number of chars in the all strings of the list less than the other list.\n\n    if the two lists have the same number of chars, return the first list.\n\n    Examples\n    total_match([], []) \u279e []\n    total_match(['hi', 'admin'], ['hI', 'Hi']) \u279e ['hI', 'Hi']\n    total_match(['hi', 'admin'], ['hi', 'hi', 'admin', 'project']) \u279e ['hi', 'admin']\n    total_match(['hi', 'admin'], ['hI', 'hi', 'hi']) \u279e ['hI', 'hi', 'hi']\n    total_match(['4'], ['1', '2', '3', '4', '5']) \u279e ['4']\n    \"\"\"\n    char_count1 = _calculate_total_chars(lst1)\n    char_count2 = _calculate_total_chars(lst2)\n    return _compare_lists(char_count1, char_count2, lst1, lst2)"}
{"task_id": "HumanEval/75", "solution": "```python\ndef is_multiply_prime(a):\n    \"\"\"\n    Checks if a number is the product of exactly three prime numbers.\n    The number 'a' is assumed to be an integer less than 100.\n    \"\"\"\n\n    def is_valid_range(num: int) -> bool:\n        \"\"\"\n        Checks if the input number is within the valid range (1 < num < 100).\n        Numbers outside this range cannot be a product of three positive primes.\n        \"\"\"\n        return 1 < num < 100\n\n    def is_prime(num: int) -> bool:\n        \"\"\"\n        Determines if a given number is prime.\n        It checks for divisibility from 2 up to the square root of the number.\n        \"\"\"\n        if num < 2:\n            return False\n        i = 2\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 1\n        return True\n\n    def get_prime_factors(num: int) -> list[int]:\n        \"\"\"\n        Returns a list of prime factors for a given number, including repetitions.\n        This function efficiently finds all prime factors.\n        \"\"\"\n        factors = []\n        d = 2\n        temp_num = num\n        while d * d <= temp_num:\n            while temp_num % d == 0:\n                factors.append(d)\n                temp_num //= d\n            d += 1\n        if temp_num > 1:\n            factors.append(temp_num)\n        return factors\n\n    # Main logic of is_multiply_prime\n    if not is_valid_range(a):\n        return False\n\n    prime_factors = get_prime_factors(a)\n    return len(prime_factors) == 3\n```"}
{"task_id": "HumanEval/75", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"Determine if a number is prime.\n    Returns True if prime, False otherwise.\"\"\"\n    if n < 2:\n        return False\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            return False\n    return True\n\ndef get_prime_factors(n: int) -> list[int]:\n    \"\"\"Find all prime factors of a number (with repetition).\n    Returns a list of prime factors.\"\"\"\n    factors = []\n    temp_n = n\n    d = 2\n    while d * d <= temp_n:\n        if is_prime(d):\n            while temp_n % d == 0:\n                factors.append(d)\n                temp_n //= d\n        d += 1\n    if temp_n > 1:\n        factors.append(temp_n)\n    return factors\n\ndef count_prime_factors(n: int) -> int:\n    \"\"\"Count total number of prime factors (with repetition).\n    Delegates to get_prime_factors and returns the list's length.\"\"\"\n    return len(get_prime_factors(n))\n\ndef is_multiply_prime(a: int) -> bool:\n    \"\"\"Returns true if the given number is the multiplication of 3 prime numbers,\n    and false otherwise, for a < 100.\"\"\"\n    if a < 2 or a >= 100:\n        return False\n    \n    factor_count = count_prime_factors(a)\n    \n    return factor_count == 3"}
{"task_id": "HumanEval/76", "solution": "import math\n\ndef is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n (n**i = x for some integer i).\n    Handles various edge cases for x and n, ensuring no exceptions for math.log.\n    \"\"\"\n    if x == 1:\n        return True\n    if n == 1:\n        return False\n    if n == 0:\n        return x == 0\n    if x == 0:\n        return False\n\n    # Calculate exponent using logarithm; valid for x > 0 and n > 1.\n    exponent = math.log(x, n)\n\n    # Check if the exponent is an integer within a small tolerance.\n    return abs(exponent - round(exponent)) < 1e-9"}
{"task_id": "HumanEval/77", "solution": "import math\n\ndef iscube(a):\n    '''\n    Checks if an integer is a perfect cube.\n    Handles positive, negative, and zero inputs according to the design.\n    '''\n    if a == 0:\n        return True\n\n    # Helper function for cube root calculation as per design.\n    def _calculate_cube_root(value):\n        # Uses math.pow which correctly handles negative bases for cubic roots.\n        return math.pow(value, 1/3)\n\n    # Helper function for integer cube root validation as per design.\n    def _is_integer_cube_root(cube_root_float, original_value):\n        # Rounds the floating-point cube root to the nearest integer.\n        rounded_root = round(cube_root_float)\n        # Checks if cubing the rounded integer yields the original value for accuracy.\n        return int(rounded_root)**3 == original_value\n\n    cube_root_value = _calculate_cube_root(a)\n    return _is_integer_cube_root(cube_root_value, a)"}
{"task_id": "HumanEval/76", "solution": "import math\n\ndef is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n (n^integer = x).\n    Uses logarithmic calculations for efficiency.\n    \"\"\"\n\n    # Handle x == 1: Any non-zero n raised to the power of 0 is 1.\n    # (0^0 is conventionally 1, so this covers n=0 as well).\n    if x == 1:\n        return True\n\n    # Handle n == 1: If x is not 1 (covered above), then 1^integer cannot equal x.\n    if n == 1:\n        return False\n\n    # Handle n == 0: If x is not 1 (covered above), then 0^integer can only be 0.\n    if n == 0:\n        return x == 0\n\n    # Handle x == 0: If n is not 0 (covered above), n^integer can only be 0 if n=0.\n    if x == 0:\n        return False\n\n    # At this point: x != 0, x != 1. Also, n != 0, n != 1.\n    # The logarithmic approach (math.log) requires both x and n to be positive.\n    # If either is negative, and they haven't been handled by the above specific cases,\n    # they cannot form a simple power in the way intended for the log method.\n    if x < 0 or n < 0:\n        return False\n\n    # Now, x > 0 (and x != 1), n > 0 (and n != 1). It's safe to use math.log.\n    # If x = n^i, then i = log(x) / log(n).\n    exponent = math.log(x) / math.log(n)\n    rounded_exponent = round(exponent)\n\n    # Check if the calculated exponent is an integer within a small tolerance for floating-point precision.\n    if not math.isclose(exponent, rounded_exponent, rel_tol=1e-9, abs_tol=1e-9):\n        return False\n\n    # Verify by computing n raised to the integer exponent and comparing with x.\n    # Cast to int to ensure the power operation uses an integer exponent, as per the definition.\n    int_exponent = int(rounded_exponent)\n    return math.isclose(n**int_exponent, x, rel_tol=1e-9, abs_tol=1e-9)"}
{"task_id": "HumanEval/77", "solution": "```python\nimport math\n\ndef iscube(a: int) -> bool:\n    \"\"\"\n    Determines if an integer is a perfect cube.\n    It handles positive, negative, and zero inputs by calculating the cube root and verifying.\n    \"\"\"\n    root = math.cbrt(a)\n    rounded_root = round(root)\n    return rounded_root ** 3 == a\n```"}
{"task_id": "HumanEval/78", "solution": "def hex_key(num):\n    \"\"\"Counts prime hexadecimal digits (2, 3, 5, 7, B, D) in a given string.\n    Handles empty string input by returning 0.\n    \"\"\"\n    PRIME_HEX_DIGITS = {'2', '3', '5', '7', 'B', 'D'}\n\n    if not num:\n        return 0\n\n    count = 0\n    for char in num:\n        if char in PRIME_HEX_DIGITS:\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/78", "solution": "def hex_key(num: str) -> int:\n    \"\"\"Counts the number of prime hexadecimal digits in the input string.\n    Prime hexadecimal digits are 2, 3, 5, 7, B (11), D (13).\"\"\"\n\n    prime_hex_digits_set = {'2', '3', '5', '7', 'B', 'D'}\n\n    def _is_prime_hex_digit(digit: str) -> bool:\n        \"\"\"Checks if a single hexadecimal digit is one of the recognized prime digits.\"\"\"\n        return digit in prime_hex_digits_set\n\n    count = 0\n    for char in num:\n        if _is_prime_hex_digit(char):\n            count += 1\n    return count"}
{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal):\n    \"\"\"Convert a decimal number to its binary representation with 'db' prefix and suffix.\n\n    This function uses Python's built-in bin() to convert and then formats the string.\n    \"\"\"\n    binary_string = bin(decimal)[2:]\n    return \"db\" + binary_string + \"db\""}
{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal):\n    \"\"\"Converts a decimal number to its binary representation.\n    The output string is formatted with 'db' delimiters at the beginning and end.\"\"\"\n    binary_string = bin(decimal)\n    # Remove the \"0b\" prefix from the standard binary representation\n    clean_binary = binary_string[2:]\n    return f\"db{clean_binary}db\""}
{"task_id": "HumanEval/80", "solution": "def is_happy(s: str) -> bool:\n    \"\"\"Checks if a string is happy: length is at least 3, and every 3 consecutive characters are distinct.\n    This implementation achieves O(n) time and O(1) space complexity, supporting Unicode characters.\n    \"\"\"\n    if len(s) < 3:\n        return False\n\n    # Iterate through the string with a sliding window of three characters.\n    for i in range(len(s) - 2):\n        # Check if all three characters in the current window are distinct.\n        if s[i] == s[i+1] or s[i] == s[i+2] or s[i+1] == s[i+2]:\n            return False\n\n    return True"}
{"task_id": "HumanEval/80", "solution": "def extract_groups(s: str) -> list:\n    \"\"\"Extracts all overlapping 3-character groups from string.\"\"\"\n    groups = []\n    # Iterate up to len(s) - 2 to ensure s[i+2] is a valid index.\n    for i in range(len(s) - 2):\n        groups.append((s[i], s[i+1], s[i+2]))\n    return groups\n\ndef are_distinct(group: tuple) -> bool:\n    \"\"\"Checks if all characters in 3-character group are distinct.\"\"\"\n    # Convert the tuple to a set to easily check for unique characters.\n    return len(set(group)) == len(group)\n\ndef validate_minimum_length(s: str) -> bool:\n    \"\"\"Validates if string meets minimum length requirement of 3 characters.\"\"\"\n    return len(s) >= 3\n\ndef validate_consecutive_distinctness(s: str) -> bool:\n    \"\"\"Validates that all 3-character groups have distinct characters.\"\"\"\n    # Extract all consecutive 3-character groups from the string.\n    groups = extract_groups(s)\n    # Check if every extracted group consists of distinct characters.\n    for group in groups:\n        if not are_distinct(group):\n            return False\n    return True\n\ndef is_happy(s: str) -> bool:\n    \"\"\"Checks if a string is happy based on length and consecutive character distinctness.\n    A string is happy if its length is at least 3 and every 3 consecutive letters are distinct.\"\"\"\n    # First, validate the string's minimum length requirement.\n    if not validate_minimum_length(s):\n        return False\n    \n    # If the length is sufficient, proceed to validate consecutive character distinctness.\n    return validate_consecutive_distinctness(s)"}
{"task_id": "HumanEval/82", "solution": "import math\n\ndef is_prime(n: int) -> bool:\n    \"\"\"Check if a number is prime using an O(\u221an) algorithm.\n    It handles edge cases for numbers less than or equal to 1 efficiently.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:  # 2 and 3 are prime\n        return True\n    if n % 2 == 0 or n % 3 == 0: # Exclude multiples of 2 and 3\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef prime_length(string: str) -> bool:\n    \"\"\"Checks if the length of an input string is a prime number.\n    This function utilizes a helper to determine primality with O(\u221an) complexity.\n    \"\"\"\n    length = len(string)\n    return is_prime(length)"}
{"task_id": "HumanEval/82", "solution": "def _is_prime(n):\n    \"\"\"Checks if a number is prime using an O(\u221an) algorithm.\n    It efficiently handles edge cases for numbers less than or equal to 1.\"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:  # 2 and 3 are prime numbers\n        return True\n    if n % 2 == 0 or n % 3 == 0: # Exclude multiples of 2 and 3\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef prime_length(string):\n    \"\"\"Checks if the length of an input string is a prime number.\n    It calculates the string length and then uses a helper function for primality testing.\"\"\"\n    length = len(string)\n    return _is_prime(length)"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Calculates the count of n-digit positive integers that start or end with 1.\n    Uses combinatorial formulas for O(1) performance and the inclusion-exclusion principle.\n    \"\"\"\n    \n    # Calculate count of n-digit numbers starting with 1.\n    # For n=1, '1' (1 count). For n>1, '1' followed by (n-1) digits (10^(n-1) counts).\n    # The formula 10**(n-1) correctly covers both n=1 (10^0=1) and n>1.\n    count_starts_with_1 = 10**(n - 1)\n\n    # Calculate count of n-digit numbers ending with 1.\n    # For n=1, '1' (1 count).\n    # For n>1, first digit can be 1-9 (9 options), remaining (n-2) digits can be 0-9 (10^(n-2) options).\n    if n == 1:\n        count_ends_with_1 = 1\n    else:\n        count_ends_with_1 = 9 * (10**(n - 2))\n\n    # Calculate count of n-digit numbers both starting and ending with 1.\n    # For n=1, '1' (1 count).\n    # For n>=2, '1' followed by (n-2) digits (0-9) then '1'. The formula 10**(n-2) covers n>=2.\n    # For n=2, '11' (1 count) --> 10^(2-2) = 1. For n=3, '1_1' (10 counts) --> 10^(3-2) = 10.\n    if n == 1:\n        count_both_start_end_with_1 = 1\n    else: # n >= 2\n        count_both_start_end_with_1 = 10**(n - 2)\n\n    # Apply the Inclusion-Exclusion Principle: |A U B| = |A| + |B| - |A intersection B|\n    total_count = count_starts_with_1 + count_ends_with_1 - count_both_start_end_with_1\n\n    return total_count"}
{"task_id": "HumanEval/83", "solution": "```python\ndef starts_one_ends(n):\n    \"\"\"\n    Calculates the count of n-digit positive integers that start or end with 1.\n    Applies inclusion-exclusion principle for numbers greater than 1 digit.\n    \"\"\"\n\n    def _count_starting_with_1(num_digits: int) -> int:\n        \"\"\"\n        Calculates count of n-digit numbers starting with digit 1.\n        This uses the formula 10^(n-1) for n > 1, and 1 for n = 1.\n        \"\"\"\n        if num_digits == 1:\n            return 1\n        return 10**(num_digits - 1)\n\n    def _count_ending_with_1(num_digits: int) -> int:\n        \"\"\"\n        Calculates count of n-digit numbers ending with digit 1.\n        This uses the formula 9 * 10^(n-2) for n > 1, and 1 for n = 1.\n        \"\"\"\n        if num_digits == 1:\n            return 1\n        return 9 * (10**(num_digits - 2))\n\n    def _count_both_start_end_with_1(num_digits: int) -> int:\n        \"\"\"\n        Calculates count of n-digit numbers both starting and ending with 1.\n        This uses the formula 10^(n-2) for n > 2, 1 for n = 1, and 0 for n = 2.\n        \"\"\"\n        if num_digits == 1:\n            return 1\n        if num_digits == 2:\n            return 0\n        return 10**(num_digits - 2)\n\n    if n == 1:\n        return 1\n    \n    count_start = _count_starting_with_1(n)\n    count_end = _count_ending_with_1(n)\n    count_both = _count_both_start_end_with_1(n)\n    \n    return count_start + count_end - count_both\n```"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPA values to corresponding letter grades.\n    Uses a 13-tier grading scale based on specific GPA thresholds.\"\"\"\n\n    def _convert_single_gpa(gpa: float) -> str:\n        \"\"\"Converts a single GPA value to its corresponding letter grade.\"\"\"\n        if gpa == 4.0:\n            return 'A+'\n        elif gpa > 3.7:\n            return 'A'\n        elif gpa > 3.3:\n            return 'A-'\n        elif gpa > 3.0:\n            return 'B+'\n        elif gpa > 2.7:\n            return 'B'\n        elif gpa > 2.3:\n            return 'B-'\n        elif gpa > 2.0:\n            return 'C+'\n        elif gpa > 1.7:\n            return 'C'\n        elif gpa > 1.3:\n            return 'C-'\n        elif gpa > 1.0:\n            return 'D+'\n        elif gpa > 0.7:\n            return 'D'\n        elif gpa > 0.0:\n            return 'D-'\n        elif gpa == 0.0:\n            return 'E'\n        # All valid GPA ranges from 0.0 to 4.0 are covered; no further else is needed.\n\n    return [_convert_single_gpa(gpa) for gpa in grades]"}
