ist)\n\n    def build_expression(operator_list: list, operand_list: list) -> str:\n        # Constructs a basic algebraic expression string from given operator and operand lists.\n        expression_parts = []\n        for i in range(len(operator_list)):\n            expression_parts.append(str(operand_list[i]))\n            expression_parts.append(operator_list[i])\n        expression_parts.append(str(operand_list[len(operator_list)]))\n        return \" \".join(expression_parts)\n\n    def evaluate_expression(expression_str: str) -> int:\n        # Evaluates a mathematical expression string using Python's built-in eval().\n        return eval(expression_str)\n\n    # --- Main do_algebra logic ---\n    \n    # Input validation functions (validate_inputs, validate_operators, etc.)\n    # are omitted per critical requirement: \"FORBIDDEN: Do NOT add isinstance() checks,\n    # type guards, or raise exceptions for edge cases. Trust the caller's inputs...\"\n\n    # 1. Build the initial flat expression string\n    raw_expression_string = build_expression(operator, operand)\n\n    # 2. Insert parentheses to explicitly handle operator precedence\n    final_expression_string = insert_precedence_parentheses(raw_expression_string)\n\n    # 3. Evaluate the resulting expression\n    result = evaluate_expression(final_expression_string)\n\n    return result"}
{"task_id": "HumanEval/163", "solution": "def _validate_inputs(a: int, b: int) -> bool:\n    \"\"\"\n    Validates that input parameters are positive integers.\n    Per critical requirements, this assumes inputs are always valid.\n    \"\"\"\n    return True\n\ndef _determine_range(a: int, b: int) -> tuple:\n    \"\"\"\n    Determines the minimum and maximum values from two inputs.\n    Handles parameter order independence by always returning (min, max).\n    \"\"\"\n    return min(a, b), max(a, b)\n\ndef _find_even_digits_in_range(min_val: int, max_val: int) -> list:\n    \"\"\"\n    Identifies all single-digit even numbers within the inclusive range.\n    Results are returned in ascending order.\n    \"\"\"\n    even_digits = []\n    for digit in [0, 2, 4, 6, 8]:\n        if min_val <= digit <= max_val:\n            even_digits.append(digit)\n    return even_digits\n\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    _validate_inputs(a, b)\n    min_val, max_val = _determine_range(a, b)\n    result = _find_even_digits_in_range(min_val, max_val)\n    return result"}
{"task_id": "HumanEval/163", "solution": "def _is_positive_integer(value):\n    \"\"\"Checks if a value is positive.\"\"\"\n    return value > 0\n\ndef _validate_inputs(a, b):\n    \"\"\"Validates both input parameters for positivity.\"\"\"\n    return _is_positive_integer(a) and _is_positive_integer(b)\n\ndef _normalize_range(a, b):\n    \"\"\"Normalizes the range to ensure start <= end.\"\"\"\n    return (min(a, b), max(a, b))\n\ndef _is_even_digit(digit):\n    \"\"\"Checks if a digit is even.\"\"\"\n    return digit % 2 == 0\n\ndef _is_single_digit(value):\n    \"\"\"Checks if a value is a single digit (0-9).\"\"\"\n    return 0 <= value <= 9\n\ndef _extract_digits_from_range(start, end):\n    \"\"\"Extracts unique even single-digits from the specified range.\"\"\"\n    extracted_digits = set()\n    for num in range(start, end + 1):\n        if _is_single_digit(num) and _is_even_digit(num):\n            extracted_digits.add(num)\n    return list(extracted_digits)\n\ndef _sort_ascending(digits):\n    \"\"\"Sorts a list of digits in ascending order.\"\"\"\n    return sorted(digits)\n\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    if not _validate_inputs(a, b):\n        return []\n\n    start, end = _normalize_range(a, b)\n    digit_list = _extract_digits_from_range(start, end)\n    sorted_list = _sort_ascending(digit_list)\n    \n    return sorted_list"}
