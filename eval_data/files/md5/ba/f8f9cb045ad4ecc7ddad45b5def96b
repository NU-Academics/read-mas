{"task_id": "HumanEval/26", "solution": "from typing import List, Dict\n\n\ndef _count_occurrences(numbers: List[int]) -> Dict[int, int]:\n    \"\"\"Count occurrences of each element in the list.\n    This creates a frequency map for all numbers.\"\"\"\n    counts = {}\n    for number in numbers:\n        counts[number] = counts.get(number, 0) + 1\n    return counts\n\n\ndef _filter_unique_elements(numbers: List[int], counts: Dict[int, int]) -> List[int]:\n    \"\"\"Filter elements that appear exactly once, preserving original order.\n    It iterates through the original list and checks element counts.\"\"\"\n    result = []\n    for number in numbers:\n        if counts[number] == 1:\n            result.append(number)\n    return result\n\n\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    counts = _count_occurrences(numbers)\n    return _filter_unique_elements(numbers, counts)"}
