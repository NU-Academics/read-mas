s]\n```"}
{"task_id": "HumanEval/84", "solution": "def calculate_digit_sum(N: int) -> int:\n    \"\"\"Calculates the sum of all decimal digits in a given integer.\n    Converts the number to a string and iterates through its characters to sum them.\n    \"\"\"\n    total_sum = 0\n    for digit_char in str(N):\n        total_sum += int(digit_char)\n    return total_sum\n\ndef convert_to_binary(decimal: int) -> str:\n    \"\"\"Converts a decimal number to its binary representation as a string.\n    Uses Python's built-in bin() function and slices off the \"0b\" prefix.\n    \"\"\"\n    if decimal == 0:\n        return \"0\"\n    return bin(decimal)[2:]\n\ndef validate_input(N: int) -> bool:\n    \"\"\"Checks if the input integer N is within the valid range 0 <= N <= 10000.\n    Returns True if N is valid, False otherwise.\n    \"\"\"\n    return 0 <= N <= 10000\n\ndef solve(N: int) -> str:\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    It processes N by summing its decimal digits and converting that sum to a binary string.\n    \"\"\"\n    # As per design, validate_input is called.\n    # Per critical requirements, assume N is valid and do not raise exceptions.\n    _ = validate_input(N) \n\n    digit_sum = calculate_digit_sum(N)\n    binary_string = convert_to_binary(digit_sum)\n    return binary_string"}
{"task_id": "HumanEval/85", "solution": "from typing import List\n\ndef _is_odd_index(index: int) -> bool:\n    \"\"\"Helper function to check if an index is odd using zero-based indexing.\n    Returns True for indices 1, 3, 5, etc.\"\"\"\n    return index % 2 != 0\n\ndef _is_even(element: int) -> bool:\n    \"\"\"Helper function to check if an integer element is even.\n    An even number is perfectly divisible by 2.\"\"\"\n    return element % 2 == 0\n\ndef _calculate_sum(elements: List[int]) -> int:\n    \"\"\"Helper function to calculate the sum of all integers in a list.\n    If the list is empty, the sum is 0.\"\"\"\n    return sum(elements)\n\ndef add(lst: List[int]) -> int:\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices.\n    This function processes the list by first identifying elements at odd indices, then filtering for even numbers, and finally summing them up.\"\"\"\n    \n    even_elements_at_odd_indices = []\n    for index, element in enumerate(lst):\n        if _is_odd_index(index):\n            if _is_even(element):\n                even_elements_at_odd_indices.append(element)\n    \n    return _calculate_sum(even_elements_at_odd_indices)"}
{"task_id": "HumanEval/84", "solution": "# InputValidator: Handles checking if an input integer N is within a valid range.\nclass InputValidator:\n    MIN_VALUE = 0\n    MAX_VALUE = 10000\n\n    # Validates input N by checking its range against predefined constants.\n    def validate_input(self, N: int) -> bool:\n        return self.check_range(N)\n\n    # Checks if N falls within the acceptable minimum and maximum values.\n    def check_range(self, N: int) -> bool:\n        return self.MIN_VALUE <= N <= self.MAX_VALUE\n\n# DigitExtractor: Provides methods to extract digits from a number and sum them.\nclass DigitExtractor:\n    # Extracts individual decimal digits from the integer N.\n    # Returns a list of integers, handling N=0 specifically.\n    def extract_digits(self, N: int) -> list[int]:\n        if N == 0:\n            return [0]\n        digits = []\n        temp_N = N\n        while temp_N > 0:\n            digits.append(temp_N % 10)\n            temp_N //= 10\n        return digits[::-1]\n\n    # Calculates the sum of a given list of digits.\n    def sum_digits(self, digits: list[int]) -> int:\n        return sum(digits)\n\n# BinaryConverter: Converts an integer to its binary string representation.\nclass BinaryConverter:\n    # Converts a non-negative integer value to its binary string form.\n    # Handles the special case where the value is zero.\n    def to_binary_string(self, value: int) -> str:\n        if value == 0:\n            return \"0\"\n        return bin(value)[2:]\n\n# DigitSumCalculator: Orchestrates the process of calculating digit sum and converting it to binary.\nclass DigitSumCalculator:\n    # Initializes the calculator with instances of its dependent components.\n    def __init__(self):\n        self.validator = InputValidator()\n        self.extractor = DigitExtractor()\n        self.converter = BinaryConverter()\n\n    # Performs the full digit sum to binary conversion workflow for input N.\n    # It first validates N, then extracts and sums digits, and finally converts the sum to binary.\n    def calculate_digit_sum_binary(self, N: int) -> str:\n        self.validator.validate_input(N) \n        \n        digits = self.extractor.extract_digits(N)\n        digit_sum = self.extractor.sum_digits(digits)\n        binary_result = self.converter.to_binary_string(digit_sum)\n        return binary_result\n\ndef solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    \n    This is the main entry point, using DigitSumCalculator to perform the task.\n    \"\"\"\n    calculator = DigitSumCalculator()\n    return calculator.calculate_digit_sum_binary(N)"}
{"task_id": "HumanEval/85", "solution": "```python\ndef _get_odd_indexed_elements(lst):\n    \"\"\"Extract elements at odd indices (1, 3, 5, ...).\"\"\"\n    return [lst[i] for i in range(1, len(lst), 2)]\n\ndef _filter_even_numbers(elements):\n    \"\"\"Filter list to include only even numbers.\"\"\"\n    return [e for e in elements if e % 2 == 0]\n\ndef _calculate_sum(numbers):\n    \"\"\"Calculate sum of integer list.\"\"\"\n    return sum(numbers)\n\ndef add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\"\"\"\n    # 1. Identify elements at odd indices\n    odd_indexed_elements = _get_odd_indexed_elements(lst)\n    \n    # 2. Filter for even numbers\n    even_numbers_at_odd_indices = _filter_even_numbers(odd_indexed_elements)\n    \n    # 3. Calculate and return sum\n    return _calculate_sum(even_numbers_at_odd_indices)\n\n```"}
{"task_id": "HumanEval/86", "solution": "def _sort_word_characters(word: str) -> str:\n    \"\"\"Sorts characters within a single word by their ASCII value.\"\"\"\n    return \"\".join(sorted(word))\n\ndef _split_preserving_spaces(s: str) -> list[str]:\n    \"\"\"Splits a string into words and sequences of spaces, preserving their order.\"\"\"\n    if not s:\n        return []\n\n    parts = []\n    current_part_chars = []\n    is_current_part_space = s[0].isspace()\n\n    for char in s:\n        if char.isspace() == is_current_part_space:\n            current_part_chars.append(char)\n        else:\n            parts.append(\"\".join(current_part_chars))\n            current_part_chars = [char]\n            is_current_part_space = not is_current_part_space\n    parts.append(\"\".join(current_part_chars))\n    return parts\n\ndef _reconstruct_string(parts: list[str]) -> str:\n    \"\"\"Rebuilds a string from a list of its component parts.\"\"\"\n    return \"\".join(parts)\n\ndef anti_shuffle(s):\n    \"\"\"\n    Takes a string and returns an ordered version where characters within each word are sorted.\n    Preserves word order and all blank spaces from the original string.\n    \"\"\"\n    parts = _split_preserving_spaces(s)\n    processed_parts = []\n    for part in parts:\n        if part.isspace():\n            processed_parts.append(part)\n        else:\n            processed_parts.append(_sort_word_characters(part))\n    return _reconstruct_string(processed_parts)"}
{"task_id": "HumanEval/86", "solution": "from typing import List, Tuple\n\ndef split_into_segments(s: str) -> List[Tuple[str, bool]]:\n    \"\"\"Parse input string into word and space segments.\n    Segments are returned with a type indicator (True=word, False=space).\"\"\"\n    segments = []\n    if not s:\n        return []\n\n    current_segment_chars = []\n    # Determine the type of the first character and initialize\n    is_current_segment_word = (s[0] != ' ')\n    current_segment_chars.append(s[0])\n\n    for char in s[1:]: # Start from the second character\n        char_is_word = (char != ' ')\n        \n        if char_is_word != is_current_segment_word: # Type change detected\n            segments.append((\"\".join(current_segment_chars), is_current_segment_word))\n            current_segment_chars = [char]\n            is_current_segment_word = char_is_word\n        else: # Same type, extend current segment\n            current_segment_chars.append(char)\n\n    # Add the last segment after the loop finishes\n    if current_segment_chars:\n        segments.append((\"\".join(current_segment_chars), is_current_segment_word))\n\n    return segments\n\ndef sort_word_characters(word: str) -> str:\n    \"\"\"Sort characters within a single word by ASCII value.\n    Returns the word with characters sorted in ascending order.\"\"\"\n    return \"\".join(sorted(list(word)))\n\ndef reconstruct_string(segments: List[Tuple[str, bool]]) -> str:\n    \"\"\"Rebuild string from processed segments.\n    Maintains original spacing and order of segments.\"\"\"\n    return \"\".join(segment_str for segment_str, _ in segments)\n\ndef anti_shuffle(s: str) -> str:\n    \"\"\"Main entry point for string processing, coordinates all operations.\n    Returns processed string with sorted characters within words.\"\"\"\n    parsed_segments = split_into_segments(s)\n    processed_output_segments = []\n\n    for segment_content, is_word_segment in parsed_segments:\n        if is_word_segment:\n            processed_output_segments.append((sort_word_characters(segment_content), True))\n        else:\n            processed_output_segments.append((segment_content, False))\n\n    return reconstruct_string(processed_output_segments)"}
{"task_id": "HumanEval/87", "solution": "```python\n# src/coordinate.py\nfrom typing import Tuple\n\ndef create_coordinate(row: int, column: int) -> Tuple[int, int]:\n    \"\"\"\n    Creates a coordinate tuple (row, column).\n    Assumes valid integer inputs for row and column.\n    \"\"\"\n    return (row, column)\n```\n```python\n# src/search_engine.py\nfrom typing import List, Tuple\nfrom coordinate import create_coordinate\n\ndef find_occurrences(nested_list: List[List[int]], target_value: int) -> List[Tuple[int, int]]:\n    \"\"\"\n    Finds all occurrences of a target value in a 2D nested list.\n    Returns a list of (row, column) coordinate tuples.\n    \"\"\"\n    found_coordinates = []\n    for row_idx, row_list in enumerate(nested_list):\n        for col_idx, item in enumerate(row_list):\n            if item == target_value:\n                found_coordinates.append(create_coordinate(row_idx, col_idx))\n    return found_coordinates\n```\n```python\n# src/sort_engine.py\nfrom typing import List, Tuple\n\ndef sort_coordinates(coordinates: List[Tuple[int, int]]) -> List[Tuple[int, int]]:\n    \"\"\"\n    Sorts a list of (row, column) coordinates.\n    Sorts by row ascending, then by column descending.\n    \"\"\"\n    # Sort by row ascending, then by column descending.\n    # Negating the column value ensures descending order for columns within the same row.\n    return sorted(coordinates, key=lambda coord: (coord[0], -coord[1]))\n```\n```python\n# src/get_row.py\nfrom typing import List, Tuple\nfrom search_engine import find_occurrences\nfrom sort_engine import sort_coordinates\n\ndef get_row(lst: List[List[int]], x: int) -> List[Tuple[int, int]]:\n    \"\"\"\n    Searches for an integer x in a 2D jagged list and returns sorted coordinates.\n    Coordinates are (row, column), sorted by row ascending, then column descending.\n    \"\"\"\n    if not lst:\n        return []\n\n    # Find all occurrences of the target value.\n    raw_coordinates = find_occurrences(lst, x)\n    # Sort the found coordinates according to the specified criteria.\n    sorted_results = sort_coordinates(raw_coordinates)\n\n    return sorted_results\n```"}
{"task_id": "HumanEval/88", "solution": "```python\nfrom typing import List\n\ndef _calculate_sum(first: int, last: int) -> int:\n    \"\"\"Calculates the sum of two integers.\"\"\"\n    return first + last\n\ndef _is_odd(value: int) -> bool:\n    \"\"\"Determines if a number is odd.\"\"\"\n    return value % 2 != 0\n\ndef _sort_ascending(array: List[int]) -> List[int]:\n    \"\"\"Returns a new array sorted in ascending order.\"\"\"\n    return sorted(array)\n\ndef _sort_descending(array: List[int]) -> List[int]:\n    \"\"\"Returns a new array sorted in descending order.\"\"\"\n    return sorted(array, reverse=True)\n\ndef sort_array(array: List[int]) -> List[int]:\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n    \"\"\"\n    n = len(array)\n\n    if n == 0:\n        return []\n    if n == 1:\n        return array[:]\n\n    first_element = array[0]\n    last_element = array[n - 1]\n\n    sum_first_last = _calculate_sum(first_element, last_element)\n\n    if _is_odd(sum_first_last):\n        return _sort_ascending(array)\n    else:\n        return _sort_descending(array)\n```"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Main encryption function for rotating alphabet letters by 4 positions.\n    Non-lowercase letters are preserved in their original positions.\"\"\"\n    \n    def _is_lowercase_letter(char):\n        \"\"\"Determines if a character is a lowercase letter (a-z).\"\"\"\n        return 'a' <= char <= 'z'\n\n    def _shift_character(char):\n        \"\"\"Shifts a single lowercase letter by 4 positions with wrap-around.\"\"\"\n        if not _is_lowercase_letter(char):\n            return char # Should not happen if called correctly, but for safety\n        \n        start_ord = ord('a')\n        current_ord = ord(char)\n        \n        # Calculate new position relative to 'a'\n        # (current_ord - start_ord) gives 0 for 'a', 1 for 'b', etc.\n        # Add shift (4) and apply modulo 26 for wrap-around\n        shifted_position = (current_ord - start_ord + 4) % 26\n        \n        # Convert back to character's ASCII value\n        shifted_ord = start_ord + shifted_position\n        return chr(shifted_ord)\n\n    encrypted_chars = []\n    for char in s:\n        if _is_lowercase_letter(char):\n            encrypted_chars.append(_shift_character(char))\n        else:\n            encrypted_chars.append(char)\n            \n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/88", "solution": "def _create_array_copy(array: list) -> list:\n    \"\"\"Creates a shallow copy of the input list.\n    This ensures the original array remains unmodified.\n    \"\"\"\n    return list(array)\n\ndef _sort_ascending(array: list) -> list:\n    \"\"\"Sorts the given list in ascending order.\n    It uses Python's built-in sorted() for O(n log n) performance.\n    \"\"\"\n    return sorted(array)\n\ndef _sort_descending(array: list) -> list:\n    \"\"\"Sorts the given list in descending order.\n    It leverages Python's built-in sorted() with the reverse flag.\n    \"\"\"\n    return sorted(array, reverse=True)\n\ndef _calculate_sum_condition(array: list) -> bool:\n    \"\"\"Calculates if the sum of the first and last elements is odd.\n    Returns True if the sum is odd (for ascending sort), False if even (for descending sort).\n    \"\"\"\n    # This function is called only when the array has at least two elements.\n    first_element = array[0]\n    last_element = array[-1]\n    return (first_element + last_element) % 2 != 0\n\ndef sort_array(array: list) -> list:\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n    \"\"\"\n    if not array:\n        return []\n\n    if len(array) == 1:\n        return _create_array_copy(array)\n\n    # Determine the sorting order based on the sum of the first and last elements\n    is_sum_odd = _calculate_sum_condition(array)\n\n    # Create a copy of the array to maintain immutability of the original input\n    array_to_sort = _create_array_copy(array)\n\n    if is_sum_odd:\n        return _sort_ascending(array_to_sort)\n    else:\n        return _sort_descending(array_to_sort)"}
{"task_id": "HumanEval/89", "solution": "def _is_lowercase(char: str) -> bool:\n    \"\"\"Checks if a character is a lowercase letter from 'a' to 'z'.\"\"\"\n    return 'a' <= char <= 'z'\n\ndef _get_alphabet_position(char: str) -> int:\n    \"\"\"Calculates the 0-based alphabet position of a lowercase character.\"\"\"\n    return ord(char) - ord('a')\n\ndef _wrap_position(position: int) -> int:\n    \"\"\"Applies modulo 26 to handle alphabet wrap-around.\"\"\"\n    return position % 26\n\ndef _shift_char(char: str) -> str:\n    \"\"\"Shifts a lowercase character by 4 positions with wrap-around.\"\"\"\n    initial_pos = _get_alphabet_position(char)\n    shifted_pos = initial_pos + 4\n    wrapped_pos = _wrap_position(shifted_pos)\n    return chr(ord('a') + wrapped_pos)\n\ndef encrypt(s: str) -> str:\n    \"\"\"Encrypts a string by rotating lowercase letters by 4 positions.\n    Non-lowercase characters are preserved, and rotation handles wrap-around.\n    \"\"\"\n    encrypted_chars = []\n    for char in s:\n        if _is_lowercase(char):\n            encrypted_chars.append(_shift_char(char))\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/87", "solution": "```python\nfrom typing import List, Tuple, Any\n\ndef _validate_input(lst: Any, x: Any) -> bool:\n    \"\"\"\n    Validates input parameters as per design.\n    Per critical requirements, this trusts the caller's inputs and performs no checks.\n    \"\"\"\n    return True\n\ndef _search_coordinates(lst: List[List[int]], x: int) -> List[Tuple[int, int]]:\n    \"\"\"\n    Locates all occurrences of the target value in the nested list.\n    It collects all matching coordinates without sorting.\n    \"\"\"\n    found_coordinates = []\n    for row_idx, row in enumerate(lst):\n        for col_idx, element in enumerate(row):\n            if element == x:\n                found_coordinates.append((row_idx, col_idx))\n    return found_coordinates\n\ndef _sort_results(coordinates: List[Tuple[int, int]]) -> List[Tuple[int, int]]:\n    \"\"\"\n    Sorts coordinates primarily by row ascending, then by column descending.\n    This uses a lambda function for a custom sort key.\n    \"\"\"\n    return sorted(coordinates, key=lambda coord: (coord[0], -coord[1]))\n\ndef get_row(lst: List[List[int]], x: int) -> List[Tuple[int, int]]:\n    \"\"\"\n    Searches for an integer in a 2D nested list and returns its coordinates.\n    Results are sorted by row ascending, then column descending.\n    \"\"\"\n    _validate_input(lst, x) # Adheres to design's call, but actual validation is skipped per critical requirements.\n\n    if not lst:\n        return [] # Handles empty list edge case gracefully.\n\n    unsorted_coordinates = _search_coordinates(lst, x)\n    sorted_coordinates = _sort_results(unsorted_coordinates)\n\n    return sorted_coordinates\n```"}
