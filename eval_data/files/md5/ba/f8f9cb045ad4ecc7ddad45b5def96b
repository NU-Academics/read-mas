f._check_min_size(grid)\n\n    def validate_unique_values(self, grid: List[List[int]]) -> bool:\n        \"\"\"Validates grid values: unique and within expected range.\"\"\"\n        n = len(grid)\n        values = self._extract_values(grid)\n        return self._check_value_range(values, n)\n\n    def validate_grid(self, grid: List[List[int]]) -> bool:\n        \"\"\"Performs comprehensive validation of the grid.\"\"\"\n        return self.validate_dimensions(grid) and self.validate_unique_values(grid)\n\n\nclass GridOperations:\n    \"\"\"Provides utility operations for interacting with the grid.\"\"\"\n    def __init__(self, grid: List[List[int]]):\n        \"\"\"Initializes with the grid and its dimensions.\"\"\"\n        self._grid = grid\n        self._n = len(grid)\n\n    def get_dimensions(self) -> int:\n        \"\"\"Returns the dimension N of the N x N grid.\"\"\"\n        return self._n\n\n    def is_valid_position(self, row: int, col: int) -> bool:\n        \"\"\"Checks if a given (row, col) position is within grid boundaries.\"\"\"\n        return 0 <= row < self._n and 0 <= col < self._n\n\n    def get_value(self, row: int, col: int) -> int:\n        \"\"\"Returns the integer value at the specified grid position.\"\"\"\n        return self._grid[row][col]\n\n    def _get_adjacent_positions(self, row: int, col: int) -> List[Tuple[int, int]]:\n        \"\"\"Returns raw (potentially invalid) adjacent positions.\"\"\"\n        moves = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n        adjacent = []\n        for dr, dc in moves:\n            adjacent.append((row + dr, col + dc))\n        return adjacent\n\n    def get_neighbors(self, row: int, col: int) -> List[Tuple[int, int]]:\n        \"\"\"Returns a list of valid adjacent neighbor positions.\"\"\"\n        neighbors = []\n        for r, c in self._get_adjacent_positions(row, col):\n            if self.is_valid_position(r, c):\n                neighbors.append((r, c))\n        return neighbors\n\n\nclass MovementNavigator:\n    \"\"\"Handles movement rules and boundary checks using GridOperations.\"\"\"\n    def __init__(self, grid_ops: GridOperations):\n        \"\"\"Initializes with a GridOperations instance.\"\"\"\n        self._grid_ops = grid_ops\n\n    def _calculate_manhattan_distance(self, pos1: Tuple[int, int], pos2: Tuple[int, int]) -> int:\n        \"\"\"Calculates the Manhattan distance between two positions.\"\"\"\n        return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n    def _is_adjacent(self, pos1: Tuple[int, int], pos2: Tuple[int, int]) -> bool:\n        \"\"\"Checks if two positions are adjacent (Manhattan distance of 1).\"\"\"\n        return self._calculate_manhattan_distance(pos1, pos2) == 1\n\n    def is_valid_move(self, from_pos: Tuple[int, int], to_pos: Tuple[int, int]) -> bool:\n        \"\"\"Determines if a move from one position to another is valid.\"\"\"\n        return self._is_adjacent(from_pos, to_pos) and self._grid_ops.is_valid_position(to_pos[0], to_pos[1])\n\n    def get_valid_moves(self, current_pos: Tuple[int, int]) -> List[Tuple[int, int]]:\n        \"\"\"Returns all valid adjacent positions from the current position.\"\"\"\n        return self._grid_ops.get_neighbors(current_pos[0], current_pos[1])\n\n\nclass Path:\n    \"\"\"Represents a path in the grid, storing cell values and positions.\"\"\"\n    def __init__(self):\n        \"\"\"Initializes an empty path.\"\"\"\n        self._cell_values: List[int] = []\n        self._positions: List[Tuple[int, int]] = []\n\n    def add_cell(self, value: int, position: Tuple[int, int]) -> None:\n        \"\"\"Adds a cell's value and position to the path.\"\"\"\n        self._cell_values.append(value)\n        self._positions.append(position)\n\n    def get_length(self) -> int:\n        \"\"\"Returns the current length of the path.\"\"\"\n        return len(self._cell_values)\n\n    def get_values(self) -> List[int]:\n        \"\"\"Returns the ordered list of cell values in the path.\"\"\"\n        return self._cell_values\n\n    def get_positions(self) -> List[Tuple[int, int]]:\n        \"\"\"Returns the ordered list of cell positions in the path.\"\"\"\n        return self._positions\n\n    def copy(self) -> 'Path':\n        \"\"\"Creates and returns a deep copy of the current path.\"\"\"\n        new_path = Path()\n        new_path._cell_values = list(self._cell_values)\n        new_path._positions = list(self._positions)\n        return new_path\n\n    def __eq__(self, other: object) -> bool:\n        \"\"\"Compares two paths for equality based on their values and positions.\"\"\"\n        if not isinstance(other, Path): return NotImplemented\n        return self._cell_values == other._cell_values and self._positions == other._positions\n\n    def __str__(self) -> str:\n        \"\"\"Returns a string representation of the path.\"\"\"\n        return f\"Path values: {self._cell_values}, positions: {self._positions}\"\n\n\nclass PathComparator:\n    \"\"\"Compares paths lexicographically to find the minimum.\"\"\"\n\n    def _compare_values_at_index(self, values1: List[int], values2: List[int], index: int) -> int:\n        \"\"\"Compares values at a specific index for two lists.\"\"\"\n        if values1[index] < values2[index]: return -1\n        if values1[index] > values2[index]: return 1\n        return 0\n\n    def compare_lexicographically(self, path1: Path, path2: Path) -> int:\n        \"\"\"Compares two paths lexicographically, returning -1, 0, or 1.\"\"\"\n        values1 = path1.get_values()\n        values2 = path2.get_values()\n        \n        min_len = min(len(values1), len(values2))\n        for i in range(min_len):\n            comparison = self._compare_values_at_index(values1, values2, i)\n            if comparison != 0:\n                return comparison\n        \n        if len(values1) < len(values2): return -1\n        if len(values1) > len(values2): return 1\n        return 0 # Paths are identical\n\n    def is_lexicographically_smaller(self, path1: Path, path2: Path) -> bool:\n        \"\"\"Checks if path1 is lexicographically smaller than path2.\"\"\"\n        return self.compare_lexicographically(path1, path2) == -1\n\n    def find_minimum_path(self, paths: List[Path]) -> Path:\n        \"\"\"Finds the lexicographically minimum path from a list of paths.\"\"\"\n        if not paths: \n            # Per CRITICAL REQUIREMENT: \"Do NOT add ... raise exceptions for edge cases.\"\n            # In a real scenario, this would raise an error. For this problem,\n            # we assume paths will always be found for valid inputs.\n            return Path() \n        \n        min_path = paths[0]\n        for i in range(1, len(paths)):\n            if self.is_lexicographically_smaller(paths[i], min_path):\n                min_path = paths[i]\n        return min_path\n\n\nclass PathFindingEngine:\n    \"\"\"Orchestrates the pathfinding algorithm to find the minimum lexicographical path.\"\"\"\n\n    def __init__(self, grid: List[List[int]], k: int):\n        \"\"\"Initializes the engine with grid, path length, and component instances.\"\"\"\n        self._grid_ops = GridOperations(grid)\n        self._navigator = MovementNavigator(self._grid_ops)\n        self._comparator = PathComparator()\n        self._k = k\n        self._n = self._grid_ops.get_dimensions()\n        self._all_paths: List[Path] = []\n\n    def _dfs_generate_paths(self, current_path: Path, current_length: int):\n        \"\"\"Recursively generates all paths of length k starting from a given point.\"\"\"\n        if current_length == self._k:\n            self._all_paths.append(current_path)\n            return\n\n        last_pos = current_path.get_positions()[-1]\n        valid_moves = self._navigator.get_valid_moves(last_pos)\n\n        for next_row, next_col in valid_moves:\n            next_path = current_path.copy()\n            next_value = self._grid_ops.get_value(next_row, next_col)\n            next_path.add_cell(next_value, (next_row, next_col))\n            self._dfs_generate_paths(next_path, current_length + 1)\n\n    def explore_from_cell(self, start_row: int, start_col: int) -> None:\n        \"\"\"Initiates path generation starting from a specific grid cell.\"\"\"\n        initial_path = Path()\n        initial_value = self._grid_ops.get_value(start_row, start_col)\n        initial_path.add_cell(initial_value, (start_row, start_col))\n        \n        if self._k == 1:\n            self._all_paths.append(initial_path)\n        else:\n            self._dfs_generate_paths(initial_path, 1)\n\n    def _generate_all_paths(self) -> List[Path]:\n        \"\"\"Generates all possible paths of length k from every starting cell.\"\"\"\n        self._all_paths = []\n        for r in range(self._n):\n            for c in range(self._n):\n                self.explore_from_cell(r, c)\n        return self._all_paths\n\n    def _find_minimum_among_paths(self, paths: List[Path]) -> Path:\n        \"\"\"Identifies the lexicographically minimum path from a list.\"\"\"\n        return self._comparator.find_minimum_path(paths)\n\n    def find_minimum_path(self) -> List[int]:\n        \"\"\"Executes the complete pathfinding process and returns the minimum path values.\"\"\"\n        all_candidate_paths = self._generate_all_paths()\n        min_path = self._find_minimum_among_paths(all_candidate_paths)\n        return min_path.get_values()\n\n\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Finds the lexicographically minimum path of length k in an N x N grid.\n    Moves are 4-directional to adjacent cells; cells can be revisited.\n    \"\"\"\n    param_validator = ParameterValidator()\n    grid_validator = GridValidator()\n\n    # Per critical requirement: Do NOT raise exceptions or add type guards.\n    # We trust the caller's inputs, so validation calls proceed without error handling.\n    _ = param_validator.validate_parameters(grid, k)\n    _ = grid_validator.validate_grid(grid)\n\n    engine = PathFindingEngine(grid, k)\n    result_path_values = engine.find_minimum_path()\n    \n    return result_path_values\n```"}
{"task_id": "HumanEval/131", "solution": "def digits(n: int) -> int:\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    def _extract_digits(num: int) -> list[int]:\n        \"\"\"Extracts individual digits from an integer.\"\"\"\n        return [int(d) for d in str(num)]\n\n    def _calculate_odd_product(digit_list: list[int]) -> int:\n        \"\"\"Calculates the product of odd digits in a list, returning 0 if none are found.\"\"\"\n        odd_product = 1\n        found_odd = False\n        for digit in digit_list:\n            if digit % 2 != 0:\n                odd_product *= digit\n                found_odd = True\n        return odd_product if found_odd else 0\n\n    extracted_digits = _extract_digits(n)\n    return _calculate_odd_product(extracted_digits)"}
{"task_id": "HumanEval/132", "solution": "```python\n# src/is_nested.py\n\ndef _validate_input(string):\n    \"\"\"\n    Validates the input string contains only square bracket characters.\n    It returns False if any invalid character is found.\n    \"\"\"\n    for char in string:\n        if char not in ['[', ']']:\n            return False\n    return True\n\ndef _find_nested_subsequence(string):\n    \"\"\"\n    Analyzes bracket sequences to detect the [[ ]] nesting pattern as a subsequence.\n    It returns True if such a pattern is found, False otherwise.\n    \"\"\"\n    open1_idx = -1\n    for i, char in enumerate(string):\n        if char == '[':\n            open1_idx = i\n            break\n    if open1_idx == -1:\n        return False\n\n    open2_idx = -1\n    for i in range(open1_idx + 1, len(string)):\n        if string[i] == '[':\n            open2_idx = i\n            break\n    if open2_idx == -1:\n        return False\n\n    close1_idx = -1\n    for i in range(open2_idx + 1, len(string)):\n        if string[i] == ']':\n            close1_idx = i\n            break\n    if close1_idx == -1:\n        return False\n\n    close2_idx = -1\n    for i in range(close1_idx + 1, len(string)):\n        if string[i] == ']':\n            close2_idx = i\n            break\n    \n    return close2_idx != -1\n\ndef is_nested(string):\n    \"\"\"\n    Detects if there is a valid subsequence of brackets where at least one bracket is nested.\n    It returns True if a '[[ ]]' pattern is found as a subsequence, False if not or input is invalid.\n    \"\"\"\n    if not _validate_input(string):\n        return False\n\n    return _find_nested_subsequence(string)\n\n```\n```python\n# src/main.py\n\nimport sys\nimport os\nimport argparse\n\n# Add the 'src' directory to sys.path to allow importing sibling modules.\n# This makes the script executable directly from the project root or its own directory.\nscript_dir = os.path.dirname(__file__)\nsys.path.insert(0, script_dir)\n\nfrom is_nested import is_nested\n\ndef run_examples():\n    \"\"\"Executes and displays results for example test cases demonstrating is_nested.\"\"\"\n    examples = {\n        '[[]]': True,\n        '[[][]]': True,\n        '[[]][[': True,\n        '[]]]]]]][[[[[]': False,\n        '[][]': False,\n        '[]': False,\n        '': False,  # Edge case: empty string\n        '[': False,  # Edge case: single open bracket\n        ']': False,  # Edge case: single close bracket\n        'abc': False,  # Edge case: invalid characters\n        '[a]': False,  # Edge case: invalid characters\n    }\n\n    print(\"--- Running Examples ---\")\n    for input_str, expected in examples.items():\n        result = is_nested(input_str)\n        status = \"PASSED\" if result == expected else f\"FAILED (Expected: {expected}, Got: {result})\"\n        print(f\"Input: '{input_str.ljust(20)}' | Result: {str(result).ljust(5)} | Expected: {str(expected).ljust(5)} | Status: {status}\")\n    print(\"------------------------\")\n\ndef main():\n    \"\"\"Provides a command-line interface for the is_nested function.\"\"\"\n    parser = argparse.ArgumentParser(description=\"Detects nested square brackets in a string.\")\n    parser.add_argument('bracket_string', nargs='?', help=\"The string containing only square brackets to analyze.\")\n    parser.add_argument('--examples', action='store_true', help=\"Run and display predefined examples.\")\n\n    args = parser.parse_args()\n\n    if args.examples:\n        run_examples()\n    elif args.bracket_string is not None:\n        result = is_nested(args.bracket_string)\n        print(f\"Input: '{args.bracket_string}'\")\n        print(f\"Is nested: {result}\")\n    else:\n        print(\"Please provide a bracket string as an argument or use --examples to see demonstrations.\")\n        parser.print_help()\n\nif __name__ == \"__main__\":\n    main()\n\n```"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Determines if a string contains valid nested bracket subsequences.\n    A subsequence is nested if it's of the form '[X]' where X is a non-empty valid bracket sequence.\n    \"\"\"\n\n    def validate_input(s: str) -> bool:\n        \"\"\"Checks if the input string contains only square bracket characters.\"\"\"\n        return all(char in '[]' for char in s)\n\n    # The parse_brackets function from design is effectively integrated into the detection logic.\n    # It doesn't need to return a separate structure for this O(N) solution.\n\n    def detect_nesting(s: str) -> bool:\n        \"\"\"\n        Detects if a valid nested bracket subsequence exists using a single pass and stack.\n        A stack stores (open_bracket_index, has_valid_non_empty_inner_sequence_flag).\n        \"\"\"\n        stack = []  # Stores (index of '[', boolean indicating if a valid '[]' has formed within its scope)\n\n        for idx, char in enumerate(s):\n            if char == '[':\n                stack.append((idx, False))  # Push with flag False (no inner valid sequence yet)\n            elif char == ']':\n                if not stack:\n                    # Unmatched closing bracket, not part of a valid sequence, ignore for nesting.\n                    continue\n\n                open_idx, inner_nested_flag = stack.pop()\n                \n                # If the popped bracket had inner_nested_flag True, it means\n                # string[open_idx...idx] is of the form [X] where X is a valid non-empty sequence.\n                # This is a valid nested subsequence.\n                if inner_nested_flag:\n                    return True\n\n                # The current pair (open_idx, idx) is '[]' (empty inner).\n                # If it's inside another open bracket, mark that outer bracket's flag as True.\n                if stack:\n                    outer_open_idx, _ = stack[-1]\n                    stack[-1] = (outer_open_idx, True)\n        \n        # No valid nested subsequence found after processing the entire string.\n        return False\n\n    # Main is_nested function logic\n    if not validate_input(string):\n        return False\n\n    return detect_nesting(string)"}
{"task_id": "HumanEval/133", "solution": "```python\nimport math\n\ndef handle_empty_list():\n    \"\"\"Returns 0 as specified for empty lists.\"\"\"\n    return 0\n\ndef ceiling_round(number: float) -> int:\n    \"\"\"Applies the mathematical ceiling function to a number.\"\"\"\n    return math.ceil(number)\n\ndef square_number(number: int) -> int:\n    \"\"\"Squares an integer.\"\"\"\n    return number * number\n\ndef sum_values(numbers: list) -> int:\n    \"\"\"Sums a list of numbers.\"\"\"\n    return sum(numbers)\n\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\"\"\"\n\n    if not lst:\n        return handle_empty_list()\n\n    processed_values = []\n    for num in lst:\n        rounded_num = ceiling_round(num)\n        squared_num = square_number(rounded_num)\n        processed_values.append(squared_num)\n\n    return sum_values(processed_values)\n```"}
{"task_id": "HumanEval/133", "solution": "import math\nfrom typing import List, Union\n\ndef sum_squares(lst: List[Union[int, float]]) -> int:\n    \"\"\"\n    Calculate sum of squared numbers after ceiling rounding each element.\n    It processes positive, negative, decimal, and zero values correctly.\n    \"\"\"\n    return sum(math.ceil(num) ** 2 for num in lst)"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt: str) -> bool:\n    \"\"\"\n    Returns True if the last character of a given string is an alphabetical\n    character and is not a part of a word, and False otherwise.\n    \"\"\"\n    if not txt:\n        return False\n    \n    if txt.endswith(' '):\n        return False\n    \n    last_char = txt[-1]\n    \n    if not last_char.isalpha():\n        return False\n    \n    # A character is standalone if it's preceded by a space.\n    # This requires the string to have at least two characters.\n    if len(txt) > 1 and txt[-2] == ' ':\n        return True\n    else:\n        return False"}
{"task_id": "HumanEval/134", "solution": "```python\ndef _is_alphabetical(char):\n    \"\"\"Checks if a given character is an alphabetical letter.\"\"\"\n    return char.isalpha()\n\ndef _is_empty_string(txt):\n    \"\"\"Checks if the input string is empty.\"\"\"\n    return not txt\n\ndef _is_preceded_by_space(txt):\n    \"\"\"Checks if the last character in the string is preceded by a space.\"\"\"\n    return len(txt) > 1 and txt[-2] == ' '\n\ndef check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Returns True if the last character of a given string is an alphabetical\n    character and is not part of a word, and False otherwise.\n    \"\"\"\n    if _is_empty_string(txt):\n        return False\n\n    last_char = txt[-1]\n\n    if not _is_alphabetical(last_char):\n        return False\n\n    if not _is_preceded_by_space(txt):\n        return False\n\n    return True\n```"}
