{"task_id": "HumanEval/25", "solution": "```python\nfrom typing import List\n\n\ndef factorize(n: int) -> List[int]:\n    \"\"\"Return list of prime factors of given integer from smallest to largest.\n    Each factor is listed as many times as it appears in the factorization.\n    \"\"\"\n    factors = []\n    d = 2\n\n    # Iterate through potential divisors starting from 2\n    while d * d <= n:\n        # If n is divisible by d, add d to factors and divide n by d\n        while n % d == 0:\n            factors.append(d)\n            n //= d\n        d += 1\n\n    # If n is still greater than 1, it must be a prime factor itself\n    if n > 1:\n        factors.append(n)\n\n    return factors\n```"}
{"task_id": "HumanEval/25", "solution": "```python\nfrom typing import List\n\n\ndef _validate_input(n: int) -> bool:\n    \"\"\"Validate that the input number is appropriate for factorization.\n    Returns True if n is a positive integer (n >= 1), False otherwise.\n    \"\"\"\n    return n >= 1\n\n\ndef _find_factors(n: int) -> List[int]:\n    \"\"\"Core algorithm to find prime factors for a given number.\n    Returns a list of prime factors in ascending order.\n    \"\"\"\n    factors = []\n    if n <= 1:\n        return factors\n\n    temp_n = n\n    d = 2\n    while temp_n % d == 0:\n        factors.append(d)\n        temp_n //= d\n\n    d = 3\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 2\n\n    if temp_n > 1:\n        factors.append(temp_n)\n\n    return factors\n\n\ndef _validate_output(factors: List[int], original: int) -> bool:\n    \"\"\"Validate the correctness of the factorization.\n    Ensures the product of factors equals the original number.\n    \"\"\"\n    product = 1\n    for factor in factors:\n        product *= factor\n    return product == original\n\n\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    if not _validate_input(n):\n        return []\n\n    result_factors = _find_factors(n)\n    _validate_output(result_factors, n)\n    return result_factors\n```"}
{"task_id": "HumanEval/27", "solution": "def flip_case(string: str) -> str:\n    \"\"\" For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    >>> flip_case('Hello')\n    'hELLO'\n    \"\"\"\n    flipped_chars = []\n    for char in string:\n        if char.islower():\n            flipped_chars.append(char.upper())\n        elif char.isupper():\n            flipped_chars.append(char.lower())\n        else:\n            flipped_chars.append(char)\n    return \"\".join(flipped_chars)"}
{"task_id": "HumanEval/26", "solution": "from typing import List\n\n\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    \"\"\"\n    counts = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    result = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n\n    return result"}
