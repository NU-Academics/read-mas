, 13, 21]\n        The only valid triple is (1, 7, 13).\n    \"\"\"\n    if n < 3:\n        return 0\n\n    count_rem0 = 0\n    count_rem1 = 0\n\n    # Determine remainders of a[i] = i * i - i + 1 modulo 3.\n    # a[i] = i * (i - 1) + 1\n    # If i % 3 == 0: a[i] % 3 = (0 * (-1) + 1) % 3 = 1 % 3 = 1\n    # If i % 3 == 1: a[i] % 3 = (1 * (0) + 1) % 3 = 1 % 3 = 1\n    # If i % 3 == 2: a[i] % 3 = (2 * (1) + 1) % 3 = 3 % 3 = 0\n    # So, a[i] % 3 is 0 if i % 3 == 2, and 1 otherwise.\n    for i in range(1, n + 1):\n        if i % 3 == 2:\n            count_rem0 += 1\n        else:\n            count_rem1 += 1\n\n    # A sum of three numbers is a multiple of 3 if their remainders modulo 3 sum to a multiple of 3.\n    # Given a[i]%3 can only be 0 or 1, valid combinations of remainders are (0,0,0) or (1,1,1).\n    triples_from_rem0 = _combinations(count_rem0, 3)\n    triples_from_rem1 = _combinations(count_rem1, 3)\n\n    return triples_from_rem0 + triples_from_rem1", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/152": [{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"Return an array of the same length denoting how far off each guess was.\n    If they have guessed correctly, the value is 0, and if not, the value is the\n    absolute difference between the guess and the score.\n    \"\"\"\n    return [abs(g - s) for g, s in zip(game, guess)]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/155": [{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    abs_num_str = str(abs(num))\n    even_count = 0\n    odd_count = 0\n\n    for char_digit in abs_num_str:\n        digit = int(char_digit)\n        if digit % 2 =