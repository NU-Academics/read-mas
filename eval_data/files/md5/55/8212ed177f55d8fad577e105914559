ats:\n        \"\"\"A data transfer object to hold a word and its calculated unique character count.\"\"\"\n        def __init__(self, word: str, unique_char_count: int):\n            self.word = word\n            self.unique_char_count = unique_char_count\n\n        def __lt__(self, other: '_WordStats') -> bool:\n            # Primary sort: unique_char_count (descending), then word (lexicographical ascending).\n            if self.unique_char_count != other.unique_char_count:\n                return self.unique_char_count > other.unique_char_count\n            return self.word < other.word\n\n        def __eq__(self, other: object) -> bool:\n            if not isinstance(other, _WordStats):\n                return NotImplemented\n            return self.word == other.word and self.unique_char_count == other.unique_char_count\n\n    word_stats_list = []\n    for word in words:\n        unique_count = _count_unique_chars(word)\n        word_stats_list.append(_WordStats(word, unique_count))\n\n    word_stats_list.sort()\n\n    return word_stats_list[0].word", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/157": [{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # Side lengths must be positive.\n    if not (a > 0 and b > 0 and c > 0):\n        return False\n\n    # Check for triangle inequality theorem.\n    if not ((a + b > c) and (a + c > b) and (b + c > a)):\n        return False\n\n    # Use a small epsilon for floating-point comparison.\n    EPSILON = 1e-9\n\n    # Sort the sides to easily identify the longest side as s3.\n    sides = sorted([a, b, c])\n    s1, s2, s3 = sides[0], sides[1], sides[2]\n\n    # Apply the Pythagorean theorem: a^2 + b^2 = c^2.\n    return abs(s1**2 + s2**2 - s3**2) < EPSILON", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/162": [{"task_id": "HumanEval/162", "solution": "def string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    import hashlib\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/163": [{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    start = min(a, b)\n    end = max(a, b)\n\n    result = []\n    # The examples indicate that \"even digits\" refers to single-digit even numbers\n    # that fall within the specified range [a, b].\n    for digit in [2, 4, 6, 8]:\n        if start <= digit <= end:\n            result.append(digit)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/160": [{"task_id": "HumanEval/160", "solution": "from typing import List, Union\nclass InvalidInputError(ValueError):\n    \"\"\"Raised when the input lists have incorrect lengths or structure.\"\"\"\n    pass\nclass InvalidOperatorError(ValueError):\n    \"\"\"Raised when an unsupported operator is provided.\"\"\"\n    pass\nclass InvalidOperandError(ValueError):\n    \"\"\"Raised when an operand is not a non-negative integer.\"\"\"\n    pass\nclass EvaluationError(Exception):\n    \"\"\