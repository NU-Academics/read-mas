lue\n            # Replace comma with dot if it appears to be the decimal separator\n            if ',' in value and '.' not in value:\n                processed_value_str = value.replace(',', '.')\n            return float(processed_value_str)\n        else:\n            # Direct conversion for int, float, or other types float() can handle\n            return float(value)\n\n    parsed_a = _parse_numeric_value(a)\n    parsed_b = _parse_numeric_value(b)\n\n    if parsed_a > parsed_b:\n        return a\n    elif parsed_b > parsed_a:\n        return b\n    else:\n        return None", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/140": [{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n    \"\"\"\n    # First, replace sequences of 3 or more spaces with a single hyphen.\n    processed_text = re.sub(r' {3,}', '-', text)\n    # Then, replace any remaining single spaces with underscores.\n    processed_text = processed_text.replace(' ', '_')\n    return processed_text", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "import heapq\nfrom typing import List, Tuple\ndef minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k,\n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n\n    class Path:\n        \"\"\"\n        Represents a path in the grid, storing the sequence of visited cell values\n        and its current end position.\n        \"\"\"\n        def __init__(self, values: List[int], r: int, c: int):\n            self.values = values\n            self.r = r\n            self.c = c\n\n        def __lt__(self, other: 'Path') -> bool:\n            \"\"\"Compares two paths lexicographically.\"\"\"\n            return self.values < other.values\n\n    class GridUtils:\n        \"\"\"Provides static utility methods for common grid operations.\"\"\"\n        DIRECTIONS: List[Tuple[int, int]] = [(0, 1), (0, -1), (1, 0), (-1, 0)] # Right, Left, Down, Up\n\n        @staticmethod\n        def get_neighbors(grid_ref: List[List[int]], r: int, c: int) -> List[Tuple[int, int]]:\n            \"\"\"\n            Returns a list of (row, col) tuples for valid adjacent cells\n            from (r, c) within the grid boundaries.\n            \"\"\"\n            N_ref = len(grid_ref)\n            neighbors = []\n            for dr, dc in GridUtils.DIRECTIONS:\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < N_ref and 0 <= nc < N_ref:\n                    neighbors.append((nr, nc))\n            return neighbors\n\n    class MinPathFinder:\n        \"\"\"\n        Encapsulates the core algorithm to find the lexicographically smallest\n        path of length k in a grid.\n        \"\"\"\n        def __init__(self, grid_finder: List[List[int]], k_finder: int):\n            self._grid = grid_finder\n            self._N = len(grid_finder)\n            self._k = k_finder\n\n        def find_min_path(self) -> List[int]:\n            \"\"\"\n            Executes the priority queue-based search to find the lexicographically\n            smallest path of length k.\n            \"\"\"\n            min_heap: List[Path] = []\n\n            # Initialize with all possible starting cells\n            for r in range(self._N):\n                for c in range(self._N):\n                    initial_path = Path([self._grid[r][c]], r, c)\n                    heapq.heappush(min_heap, initial_path)\n\n            while min_heap:\n                current_path = heapq.heappop(min_heap)\n\n                if len(current_path.values) == self._k:\n                    return current_path.values\n\n                # Explore neighbors\n                neighbors = GridUtils.get_neighbors(self._grid, current_path.r, current_path.c)\n                for nr, nc in neighbors:\n                    new_values = current_path.values + [self._grid[nr][nc]]\n                    new_path = Path(new_values, nr, nc)\n                    heapq.heappush(min_heap, new_path)\n\n            # This part should ideally not be reached due to problem guarantee.\n            return []\n\n    finder = MinPathFinder(grid, k)\n    return finder.find_min_path()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/141": [{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on several conditions.\n    Returns 'Yes' for a valid name, 'No' otherwise.\"\"\"\n\n    # Condition 1: No more than three digits\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    # Condition 2: Exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    parts = file_name.split('.')\n    prefix = parts[0]\n    extension = parts[1]\n\n    # Condition 3: Substring before dot not empty and starts with a letter\n    if not prefix:\n        return 'No'\n    if not ('a' <= prefix[0] <= 'z' or 'A' <= prefix[0] <= 'Z'):\n        return 'No'\n\n    # Condition 4: Substring after dot is one of ['txt', 'exe', 'dll']\n    allowed_extensions = ['txt', 'exe', 'dll']\n    if extension not in allowed_extensions:\n        return 'No'\n\n    return 'Yes'", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["\u00e9xample.exe"]]}], "HumanEval/142": [{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n\n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    if not lst:\n        return 0\n\n    processed_values = []\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            processed_values.append(num * num)\n        elif i % 4 == 0:  # This condition implies i % 3 != 0 because of the preceding 'if'\n            processed_values.append(num * num * num)\n        else:\n            processed