 SHIFT_AMOUNT = 4\n    UPPERCASE_START = ord('A')\n    LOWERCASE_START = ord('a')\n    ALPHABET_SIZE = 26\n\n    def _rotate_char(char: str) -> str:\n        if 'a' <= char <= 'z':\n            start = LOWERCASE_START\n            return chr(start + (ord(char) - start + SHIFT_AMOUNT) % ALPHABET_SIZE)\n        elif 'A' <= char <= 'Z':\n            start = UPPERCASE_START\n            return chr(start + (ord(char) - start + SHIFT_AMOUNT) % ALPHABET_SIZE)\n        else:\n            return char\n\n    encrypted_chars = [_rotate_char(char) for char in s]\n    return \"\".join(encrypted_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/91": [{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    You'll be given a string of words, and your task is to count the number\n    of boredoms. A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n\n    For example:\n    >>> is_bored(\"Hello world\")\n    0\n    >>> is_bored(\"The sky is blue. The sun is shining. I love this weather\")\n    1\n    \"\"\"\n    import re\n\n    def _split_sentences(text: str) -> list[str]:\n        \"\"\"Splits text into sentences based on delimiters and cleans them.\"\"\"\n        SENTENCE_DELIMITERS = ['.', '?', '!']\n\n        # Prepare text for splitting: replace delimiters with themselves followed by a space\n        # This helps re.split treat consecutive delimiters correctly (e.g., \"Hello...World\" -> \"Hello. . . World\")\n        for delim in SENTENCE_DELIMITERS:\n            text = text.replace(delim, delim + ' ')\n\n        # Split by any of the delimiters followed by zero or more spaces.\n        sentences = re.split(r'[.?!]\\s*', text)\n\n        # Filter out empty strings and strip leading/trailing whitespace from each sentence.\n        return [s.strip() for s in sentences if s.strip()]\n\n    def _starts_with_i(sentence: str) -> bool:\n        \"\"\