l2):\n    \"\"\"Determines whether the length of the intersection of two intervals is a prime number.\n    Returns \"YES\" if the length is prime, \"NO\" otherwise, including if there's no intersection.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a non-negative integer is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    max_start = max(start1, start2)\n    min_end = min(end1, end2)\n\n    if max_start > min_end:\n        return \"NO\" # No intersection\n\n    intersection_length = min_end - max_start + 1\n\n    if is_prime(intersection_length):\n        return \"YES\"\n    else:\n        return \"NO\"", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[-1, 1], [0, 4]]], "plus_fail_tests": [[[10, 20], [15, 25]]]}], "HumanEval/39": [{"task_id": "HumanEval/39", "solution": "import math\nfrom typing import Iterator\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    \"\"\"\n    _prime_cache = {}\n\n    def is_prime(num: int) -> bool:\n        if num in _prime_cache:\n            return _prime_cache[num]\n\n        if num < 2:\n            _prime_cache[num] = False\n            return False\n\n        # Check for divisibility up to the square root of num.\n        for i in range(2, int(math.sqrt(num)) + 1):\n            if num % i == 0:\n                _prime_cache[num] = False\n                return False\n\n        _prime_cache[num] = True\n        return True\n\n    def generate_fibonacci() -> Iterator[int]:\n        a, b = 0, 1\n        while True:\n            yield a\n            a, b = b, a + b\n\n    fib_gen = generate_fibonacci()\n    prime_found_count = 0\n    current_fib_num = 0\n\n    # Skip F_0=0, F_1=1, F_2=1 as they are not prime and the problem implies F_3=2 is the 1st.\n    next(fib_gen)  # yields 0\n    next(fib_gen)  # yields 1\n    next(fib_gen)  # yields 1\n\n    while prime_found_count < n:\n        current_fib_num = next(fib_gen)\n        if is_prime(current_fib_num):\n            prime_found_count += 1\n\n    return current_fib_num", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[12]]}], "HumanEval/131": [{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n\n    def _is_odd(digit: int) -> bool:\n        \"\"\"Checks if a given digit is odd.\"\"\"\n        return digit % 2 != 0\n\n    product = 1\n    has_odd_digit = False\n\n    for char_digit in str(n):\n        digit = int(char_digit)\n        if _is_odd(digit):\n            product *= digit\n            has_odd_digit = True\n\n    return product if has_odd_digit else 0", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/132": [{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Checks if the input string contains a subsequence of the form `[[...]]`.\n    This means finding two opening brackets followed by two closing brackets in order.\n    '''\n    # Find the index of the first opening bracket '['\n    first_open = string.find('[')\n    if first_open == -1:\n        return False\n\n    # Find the index of the second opening bracket '[' after the first\n    second_open = string.find('[', first_open + 1)\n    if second_open == -1:\n        return False\n\n    # Find the index of the first closing bracket ']' after the second opening bracket\n    first_close = string.find(']', second_open + 1)\n    if first_close == -1:\n        return False\n\n    # Find the index o