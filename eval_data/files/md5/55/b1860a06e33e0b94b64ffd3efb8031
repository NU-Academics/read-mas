{"task_id": "HumanEval/1", "solution": "```python\nfrom typing import List\n\n\ndef _remove_spaces(s: str) -> str:\n    \"\"\"Removes all space characters from the input string.\"\"\"\n    return s.replace(' ', '')\n\n\ndef _is_balanced(s: str) -> bool:\n    \"\"\"Checks if a string containing parentheses is balanced.\"\"\"\n    balance = 0\n    for char in s:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0\n\n\ndef _find_groups(processed_string: str) -> List[str]:\n    \"\"\"Identifies all balanced and non-nested parenthesis groups.\"\"\"\n    groups = []\n    balance = 0\n    start_index = -1\n\n    for i, char in enumerate(processed_string):\n        if char == '(':\n            if balance == 0:  # Start of a new potential top-level group\n                start_index = i\n            balance += 1\n        elif char == ')':\n            balance -= 1\n\n            if balance == 0 and start_index != -1:  # End of a top-level group\n                group_candidate = processed_string[start_index : i + 1]\n                if _is_balanced(group_candidate): # Verify balance as per design.\n                    groups.append(group_candidate)\n                start_index = -1  # Reset for the next top-level group\n    return groups\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Separates distinct, balanced, and non-nested parenthesis groups. \"\"\"\n    processed_string = _remove_spaces(paren_string)\n    identified_groups_list = _find_groups(processed_string)\n    return identified_groups_list\n```"}
{"task_id": "HumanEval/4", "solution": "```python\nfrom typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"Input list of numbers cannot be empty.\")\n\n    mean = sum(numbers) / len(numbers)\n    absolute_differences = [abs(num - mean) for num in numbers]\n    mad = sum(absolute_differences) / len(absolute_differences)\n    return mad\n```"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\n\ndef _calculate_mean(numbers: List[float]) -> float:\n    \"\"\"Calculates the arithmetic mean of a list of numbers.\n    Assumes the input list is non-empty for a valid mathematical result.\n    \"\"\"\n    return sum(numbers) / len(numbers)\n\n\ndef _calculate_absolute_differences(numbers: List[float], mean_value: float) -> List[float]:\n    \"\"\"Calculates the absolute difference of each number from a given mean value.\n    This generates a list of positive differences ready for averaging.\n    \"\"\"\n    return [abs(x - mean_value) for x in numbers]\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    mean_value = _calculate_mean(numbers)\n    absolute_differences = _calculate_absolute_differences(numbers, mean_value)\n    # Calculates the average of the absolute differences.\n    return sum(absolute_differences) / len(absolute_differences)"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\ndef _split_groups(paren_string: str) -> List[str]:\n    \"\"\"Splits the input string into individual parenthesis groups by spaces.\n    Empty strings resulting from multiple spaces or leading/trailing spaces are removed.\"\"\"\n    return [group for group in paren_string.split(' ') if group]\n\n\ndef _calculate_group_depth(group_string: str) -> int:\n    \"\"\"Calculates the maximum nesting depth for a single group of parentheses.\n    It iterates through characters, tracking current and maximum depths.\"\"\"\n    max_depth = 0\n    current_depth = 0\n    for char in group_string:\n        if char == '(':\n            current_depth += 1\n            max_depth = max(max_depth, current_depth)\n        elif char == ')':\n            current_depth -= 1\n    return max_depth\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    group_strings = _split_groups(paren_string)\n    nesting_depths = []\n    for group in group_strings:\n        depth = _calculate_group_depth(group)\n        nesting_depths.append(depth)\n    return nesting_depths```"}
{"task_id": "HumanEval/5", "solution": "```python\nfrom typing import List\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"\n    Inserts a number 'delimeter' between every two consecutive elements of input list `numbers`.\n    Returns an empty list if the input list `numbers` is empty.\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result\n```"}
{"task_id": "HumanEval/5", "solution": "```python\nfrom typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'.\n    Returns an empty list if the input `numbers` list is empty.\n    \"\"\"\n    if not numbers:\n        return []\n\n    result_list = []\n    for i, num in enumerate(numbers):\n        result_list.append(num)\n        if i < len(numbers) - 1:\n            result_list.append(delimeter)\n    return result_list\n```"}
