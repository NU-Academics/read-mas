{"task_id": "Mbpp/113", "solution": "def _strip_whitespace(value: str) -> str:\n    \"\"\"Removes leading/trailing whitespace from a string.\"\"\"\n    return value.strip()\n\ndef _is_valid_integer(value: str) -> bool:\n    \"\"\"Internal helper to validate if a string represents an integer format.\"\"\"\n    if not value:\n        return False\n\n    if value[0] == '-' or value[0] == '+':\n        # If there's a sign, the rest of the string must be digits and non-empty.\n        return value[1:].isdigit()\n    else:\n        # Otherwise, the entire string must be digits.\n        return value.isdigit()\n\ndef check_integer(input_string: str) -> bool:\n    \"\"\"\n    Check if a string represents a valid integer.\n    \"\"\"\n    processed_string = _strip_whitespace(input_string)\n\n    if not processed_string:\n        # Handles empty strings and strings with only whitespace after stripping.\n        return False\n\n    return _is_valid_integer(processed_string)"}
{"task_id": "Mbpp/116", "solution": "def tuple_to_int(input_tuple: tuple) -> int:\n    \"\"\"\n    Converts a tuple of positive integers into a single integer by concatenating their digits.\n    Handles an empty tuple by returning 0.\n    \"\"\"\n    if not input_tuple:\n        return 0\n    \n    # Convert each integer to its string representation and join them\n    concatenated_str = \"\".join(str(num) for num in input_tuple)\n    \n    # Convert the combined string back to an integer\n    return int(concatenated_str)"}
{"task_id": "Mbpp/119", "solution": "def search(array: list) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array using binary search.\n    All other elements in the array appear exactly twice.\n    \"\"\"\n    left, right = 0, len(array) - 1\n\n    while left < right:\n        mid = (left + right) // 2\n        # Ensure mid is even for consistent pairing checks\n        if mid % 2 == 1:\n            mid -= 1\n\n        # Check if the pair at mid and mid+1 is valid\n        if array[mid] == array[mid + 1]:\n            # The unique element is in the right half\n            left = mid + 2\n        else:\n            # The unique element is in the left half or is array[mid]\n            right = mid\n\n    return array[left]"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(tuples: list) -> float:\n    # Initialize the maximum absolute product found so far to zero.\n    # This value will be updated as we find larger absolute products.\n    max_abs_product = 0.0\n\n    # Iterate through each tuple in the input list.\n    # Each tuple is expected to contain exactly two numeric values.\n    for num1, num2 in tuples:\n        # Calculate the absolute product of the two numbers within the current tuple.\n        current_abs_product = abs(num1 * num2)\n        \n        # Update the overall maximum absolute product if the current tuple's product is greater.\n        max_abs_product = max(max_abs_product, current_abs_product)\n            \n    return max_abs_product"}
{"task_id": "Mbpp/123", "solution": "import math\n\ndef amicable_numbers_sum(upper_limit: int) -> int:\n    \"\"\"\n    Calculates the sum of all amicable numbers up to a specified upper_limit.\n    This function utilizes helper functions to determine proper divisor sums and validate amicable pairs.\n    \"\"\"\n\n    def get_proper_divisors_sum(number: int) -> int:\n        \"\"\"Calculates the sum of proper divisors for a given number efficiently.\"\"\"\n        if number <= 1:\n            return 0\n        s = 1\n        for i in range(2, int(math.sqrt(number)) + 1):\n            if number % i == 0:\n                s += i\n                if i * i != number:\n                    s += number // i\n        return s\n\n    def is_amicable_pair(a: int, b: int) -> bool:\n        \"\"\"Validates if two numbers form an amicable pair by checking their proper divisor sums.\"\"\"\n        return a != b and get_proper_divisors_sum(a) == b and get_proper_divisors_sum(b) == a\n\n    def find_amicable_numbers(upper_limit: int) -> list:\n        \"\"\"Identifies all amicable numbers within the specified range from 1 to upper_limit.\"\"\"\n        amicable_numbers_found = set()\n        for n in range(1, upper_limit + 1):\n            sum_div_n = get_proper_divisors_sum(n)\n\n            # Check if sum_div_n is a valid candidate for an amicable pair partner\n            if sum_div_n > 0 and sum_div_n <= upper_limit and n != sum_div_n:\n                if is_amicable_pair(n, sum_div_n):\n                    amicable_numbers_found.add(n)\n                    amicable_numbers_found.add(sum_div_n)\n        return list(amicable_numbers_found)\n\n    amicable_list = find_amicable_numbers(upper_limit)\n    return sum(amicable_list)"}
