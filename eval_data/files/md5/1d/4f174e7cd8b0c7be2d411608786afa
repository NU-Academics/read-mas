{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_string: str) -> str:\n    \"\"\"\n    Inserts spaces between words in a string where a word is identified by a leading capital letter\n    following a lowercase letter or a digit.\n    \"\"\"\n    if not input_string:\n        return \"\"\n\n    result = [input_string[0]]\n    for i in range(1, len(input_string)):\n        current_char = input_string[i]\n        previous_char = input_string[i - 1]\n\n        # Insert a space if the current character is uppercase AND it follows\n        # either a lowercase letter or a digit.\n        if current_char.isupper() and (previous_char.islower() or previous_char.isdigit()):\n            result.append(' ')\n        result.append(current_char)\n\n    return \"\".join(result)"}
{"task_id": "Mbpp/749", "solution": "from typing import List\n\ndef sort_numeric_strings(string_list: List[str]) -> List[int]:\n    \"\"\"\n    Sort a list of string representations of numbers numerically.\n    It converts strings to integers and sorts them in ascending order.\n    \"\"\"\n    integer_list = [int(s) for s in string_list]\n    sorted_integers = sorted(integer_list)\n    return sorted_integers"}
{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    Numbers containing the digit 0 are excluded.\n    \"\"\"\n    def contains_zero(number: int) -> bool:\n        \"\"\"Checks if a number contains the digit zero.\"\"\"\n        return '0' in str(number)\n\n    def extract_digits(number: int) -> list[int]:\n        \"\"\"Extracts individual digits from a number.\"\"\"\n        return [int(d) for d in str(number)]\n\n    def is_divisible_by_digits(number: int) -> bool:\n        \"\"\"Validates if a number is divisible by all its digits.\"\"\"\n        if contains_zero(number):\n            return False\n        digits = extract_digits(number)\n        for digit in digits:\n            if number % digit != 0:\n                return False\n        return True\n\n    result = []\n    for num in range(startnum, endnum + 1):\n        if is_divisible_by_digits(num):\n            result.append(num)\n    return result"}
{"task_id": "Mbpp/751", "solution": "import math\nfrom typing import List\n\ndef check_min_heap(array: List[int]) -> bool:\n    \"\"\"\n    Validates if the given array represents a min heap.\n    \"\"\"\n    n = len(array)\n\n    if n <= 1:\n        return True\n\n    # Iterate only through parent nodes, which are from index 0 to n//2 - 1\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n and array[i] > array[left_child_idx]:\n            return False\n\n        # Check right child\n        if right_child_idx < n and array[i] > array[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"Calculates the nth Jacobsthal number using an iterative approach.\n    It follows the recurrence relation J(n) = J(n-1) + 2*J(n-2) with J(0)=0, J(1)=1.\"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    # For n >= 2, we use an iterative approach\n    # Initialize with J(0) and J(1)\n    j_n_minus_2 = 0  # Represents J(i-2)\n    j_n_minus_1 = 1  # Represents J(i-1)\n\n    for _ in range(2, n + 1):\n        j_current = j_n_minus_1 + 2 * j_n_minus_2\n        j_n_minus_2 = j_n_minus_1\n        j_n_minus_1 = j_current\n\n    return j_n_minus_1"}
{"task_id": "Mbpp/753", "solution": "def min_k(tuple_list, k):\n    \"\"\"\n    Finds the minimum k records from a list of tuples based on their second element.\n    Returns an empty list if inputs are invalid or k is zero.\n    \"\"\"\n    def validate_inputs(lst, num_k):\n        \"\"\"Validates input list and k value.\"\"\"\n        if not lst or not isinstance(lst, list) or num_k <= 0:\n            return False\n        return True\n\n    def sort_by_second_element(lst):\n        \"\"\"Sorts the list of tuples by their second element.\"\"\"\n        return sorted(lst, key=lambda x: x[1])\n\n    def extract_k_elements(sorted_lst, num_k):\n        \"\"\"Extracts the first k elements from a sorted list.\"\"\"\n        return sorted_lst[:num_k]\n\n    if not validate_inputs(tuple_list, k):\n        return []\n\n    sorted_list = sort_by_second_element(tuple_list)\n    result_list = extract_k_elements(sorted_list, k)\n\n    return result_list"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(numbers: list):\n    \"\"\"\n    Finds the second smallest unique number in a list.\n    Handles various cases including negative numbers, zero, and duplicates.\n    \"\"\"\n    if not numbers:\n        return None\n\n    # Use a set to get unique values, then convert to a list\n    unique_numbers = sorted(list(set(numbers)))\n\n    if len(unique_numbers) < 2:\n        return None  # Or handle as an error, but problem implies None for insufficient elements\n\n    return unique_numbers[1]"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(list1, list2, list3):\n    \"\"\"\n    Find common elements at same indices across three lists.\n\n    Args:\n        list1: First input list\n        list2: Second input list\n        list3: Third input list\n\n    Returns:\n        List containing elements that appear at same indices in all three lists\n    \"\"\"\n    \n    common_elements = []\n    min_length = min(len(list1), len(list2), len(list3))\n\n    for i in range(min_length):\n        if list1[i] == list2[i] == list3[i]:\n            common_elements.append(list1[i])\n            \n    return common_elements"}
{"task_id": "Mbpp/757", "solution": "from typing import List\n\ndef count_reverse_pairs(strings: List[str]) -> int:\n    \"\"\"\n    Counts pairs of strings where one is the reverse of the other in the given list.\n    Each unique pair of indices (i, j) with i < j is considered.\n    \"\"\"\n    count = 0\n    n = len(strings)\n\n    # Helper function to check if two strings are reverses of each other.\n    def _is_reverse(s1: str, s2: str) -> bool:\n        return s1 == s2[::-1]\n\n    for i in range(n):\n        for j in range(i + 1, n): # Iterate through unique pairs (strings[i], strings[j])\n            if _is_reverse(strings[i], strings[j]):\n                count += 1\n    return count"}
{"task_id": "Mbpp/758", "solution": "from collections import Counter\n\ndef unique_sublists(input_list):\n    \"\"\"\n    Counts the occurrences of sublists within a list, returning a dictionary\n    with tuple keys representing the sublists and their counts.\n    \"\"\"\n    # Convert each sublist into a tuple and count their occurrences using Counter.\n    tuple_counts = Counter(tuple(sublist) for sublist in input_list)\n    return dict(tuple_counts)"}
{"task_id": "Mbpp/759", "solution": "def is_decimal(input_string: str) -> bool:\n    \"\"\"\n    Checks if the given string represents a decimal number with exactly two decimal places.\n    \"\"\"\n    if not input_string:\n        return False\n\n    parts = input_string.split('.')\n\n    # A valid decimal with precision must have exactly two parts: integer and fractional.\n    if len(parts) != 2:\n        return False\n\n    integer_part = parts[0]\n    fractional_part = parts[1]\n\n    # The fractional part must exist, have a length of exactly 2, and contain only digits.\n    if not fractional_part or len(fractional_part) != 2 or not fractional_part.isdigit():\n        return False\n\n    # The integer part cannot be empty.\n    if not integer_part:\n        return False\n\n    # Check for an optional leading minus sign in the integer part.\n    start_index = 0\n    if integer_part[0] == '-':\n        if len(integer_part) == 1:  # A string with just '-' is not a valid number.\n            return False\n        start_index = 1\n\n    # The rest of the integer part must contain only digits.\n    if not integer_part[start_index:].isdigit():\n        return False\n\n    return True"}
