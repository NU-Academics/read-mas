{"task_id": "Mbpp/589", "solution": "import math\n\ndef perfect_squares(lower_bound, upper_bound):\n    \"\"\"\n    Finds all perfect squares within the inclusive range [lower_bound, upper_bound].\n    The result is a sorted list of integers.\n    \"\"\"\n    # Calculate the smallest integer 'k' whose square is greater than or equal to lower_bound.\n    # We use max(1, lower_bound) to ensure a positive argument for sqrt,\n    # and to correctly handle lower_bound values of 0 or less, as 1 is the smallest perfect square.\n    start_root = math.ceil(math.sqrt(max(1, lower_bound)))\n\n    squares = []\n    # Iterate from start_root upwards, calculating squares.\n    k = int(start_root)\n    while True:\n        square = k * k\n        if square > upper_bound:\n            # If the current square exceeds the upper_bound, no more perfect squares will be found.\n            break\n        squares.append(square)\n        k += 1\n\n    return squares"}
{"task_id": "Mbpp/590", "solution": "import math\n\ndef polar_rect(radius, angle):\n    \"\"\"\n    Converts polar coordinates (radius, angle) to rectangular coordinates (x, y),\n    returning both magnitude-phase and complex number representations.\n    \"\"\"\n    # Calculate rectangular coordinates\n    x = radius * math.cos(angle)\n    y = radius * math.sin(angle)\n\n    # Calculate magnitude from x, y\n    magnitude = math.sqrt(x**2 + y**2)\n\n    # Calculate phase from x, y\n    phase = math.atan2(y, x)\n\n    # Create complex number representation\n    complex_number = complex(x, y)\n\n    return ((magnitude, phase), complex_number)"}
{"task_id": "Mbpp/591", "solution": "def swap_List(input_list: list) -> list:\n    \"\"\"\n    Interchange the first and last elements in a list.\n\n    Args:\n        input_list (list): Input list with at least 2 elements\n\n    Returns:\n        list: New list with first and last elements swapped\n\n    Raises:\n        ValueError: If input list has fewer than 2 elements\n    \"\"\"\n    if not _validate_input(input_list):\n        raise ValueError(\"Input list must have at least 2 elements to swap.\")\n    return _create_swapped_list(input_list)\n\ndef _validate_input(input_list: list) -> bool:\n    \"\"\"Validate that input list has at least 2 elements.\"\"\"\n    return len(input_list) >= 2\n\ndef _create_swapped_list(input_list: list) -> list:\n    \"\"\"Create new list with first and last elements swapped.\"\"\"\n    new_list = input_list.copy()\n    new_list[0], new_list[-1] = new_list[-1], new_list[0]\n    return new_list"}
{"task_id": "Mbpp/592", "solution": "def factorial(n: int) -> int:\n    \"\"\"Calculates the factorial of a non-negative integer.\"\"\"\n    if n == 0:\n        return 1\n    res = 1\n    for i in range(1, n + 1):\n        res *= i\n    return res\n\ndef binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient C(n, k).\"\"\"\n    if k < 0 or k > n:\n        return 0\n    numerator = factorial(n)\n    denominator = factorial(k) * factorial(n - k)\n    return numerator // denominator\n\ndef sum_Of_product(n: int) -> int:\n    \"\"\"Calculates the sum of the product of consecutive binomial coefficients C(n, k) * C(n, k+1).\"\"\"\n    total_sum = 0\n    for k in range(n):\n        coeff1 = binomial_coefficient(n, k)\n        coeff2 = binomial_coefficient(n, k + 1)\n        total_sum += coeff1 * coeff2\n    return total_sum"}
{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip_string: str) -> str:\n    \"\"\"Removes leading zeros from each octet of an IP address string.\"\"\"\n    octets = ip_string.split('.')\n    processed_octets = []\n    for octet in octets:\n        # Convert to int and back to string to remove leading zeros.\n        # This also handles the '0' case correctly (e.g., '00' becomes '0').\n        processed_octets.append(str(int(octet)))\n    return '.'.join(processed_octets)"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers):\n    \"\"\"\n    Finds the difference between the first even and first odd number in a list.\n    \"\"\"\n    def find_first_even(nums):\n        \"\"\"Finds the first even number in the list.\"\"\"\n        for num in nums:\n            if num % 2 == 0:\n                return num\n        return None\n\n    def find_first_odd(nums):\n        \"\"\"Finds the first odd number in the list.\"\"\"\n        for num in nums:\n            if num % 2 != 0:\n                return num\n        return None\n\n    def calculate_difference(even, odd):\n        \"\"\"Calculates the difference between two numbers.\"\"\"\n        return even - odd\n\n    first_even = find_first_even(numbers)\n    first_odd = find_first_odd(numbers)\n\n    return calculate_difference(first_even, first_odd)"}
