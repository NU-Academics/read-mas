{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string, character):\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    If the character is not found or appears only once, the string is returned unchanged or with one removal respectively.\n    \"\"\"\n\n    def _find_first_occurrence(s, char):\n        \"\"\"Locates the first occurrence of character in string, returns index or -1.\"\"\"\n        try:\n            return s.index(char)\n        except ValueError:\n            return -1\n\n    def _find_last_occurrence(s, char):\n        \"\"\"Locates the last occurrence of character in string, returns index or -1.\"\"\"\n        try:\n            return s.rindex(char)\n        except ValueError:\n            return -1\n\n    def _remove_characters(s, positions):\n        \"\"\"Removes characters at specified positions from string.\"\"\"\n        if not positions:\n            return s\n        \n        # Sort positions in descending order to avoid index shifting issues\n        sorted_positions = sorted(list(set(positions)), reverse=True)\n        \n        mutable_string = list(s)\n        for pos in sorted_positions:\n            if 0 <= pos < len(mutable_string):\n                del mutable_string[pos]\n        return \"\".join(mutable_string)\n\n    first_index = _find_first_occurrence(input_string, character)\n    last_index = _find_last_occurrence(input_string, character)\n\n    if first_index == -1:  # Character not found\n        return input_string\n    \n    positions_to_remove = []\n    if first_index != -1:\n        positions_to_remove.append(first_index)\n    if last_index != -1 and last_index != first_index:\n        positions_to_remove.append(last_index)\n\n    return _remove_characters(input_string, positions_to_remove)"}
{"task_id": "Mbpp/9", "solution": "def _find_repeating_unit(s: str) -> int:\n    \"\"\"\n    Finds the length of the shortest repeating unit in a string.\n    For example, \"abcabc\" has a repeating unit \"abc\" of length 3.\n    \"\"\"\n    n = len(s)\n    # Iterate through all possible lengths of repeating units, from 1 up to n.\n    for i in range(1, n + 1):\n        if n % i == 0:  # If n is divisible by i, then i could be a unit length.\n            # Check if the string is formed by repeating the prefix of length i.\n            if s[0:i] * (n // i) == s:\n                return i\n    # This line should ideally not be reached if n > 0, as i=n will always be a valid unit.\n    return n\n\ndef _calculate_minimum_rotations(s: str, pattern_length: int) -> int:\n    \"\"\"\n    Calculates the minimum rotations needed, which is simply the length of the shortest repeating pattern.\n    \"\"\"\n    # The minimum number of single-character rotations required to get the string\n    # back to its original form is equal to the length of its shortest repeating unit.\n    return pattern_length\n\ndef find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    \"\"\"\n    # Per design context, assume input string length > 0, so rotations will be > 0.\n    # Step 1: Find the length of the shortest repeating unit in the string.\n    pattern_length = _find_repeating_unit(s)\n\n    # Step 2: The minimum number of rotations is equivalent to this pattern length.\n    min_rotations = _calculate_minimum_rotations(s, pattern_length)\n\n    return min_rotations"}
{"task_id": "Mbpp/7", "solution": "def _split_words(text: str) -> list:\n    \"\"\"Splits an input string into a list of words based on whitespace.\"\"\"\n    return text.split()\n\ndef _filter_by_length(words: list, min_length: int) -> list:\n    \"\"\"Filters a list of words, keeping only those at least min_length long.\"\"\"\n    return [word for word in words if len(word) >= min_length]\n\ndef find_char_long(input_string: str) -> list:\n    \"\"\"\n    Finds all words in a string that are at least 4 characters long.\n    Words are split by whitespace, and their original case is preserved.\n    \"\"\"\n    words = _split_words(input_string)\n    long_words = _filter_by_length(words, 4)\n    return long_words"}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(number: int) -> bool:\n    \"\"\"\n    Determines if a given number is not prime.\n    Returns True if the number is not prime, False if it is prime.\n    \"\"\"\n    if number < 2:\n        return True  # Numbers less than 2 (including 1) are not prime.\n    if number == 2:\n        return False # 2 is the only even prime number.\n\n    # Check for even numbers greater than 2\n    if number % 2 == 0:\n        return True\n\n    # Check for odd divisors from 3 up to the square root of the number\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return True  # Found a divisor, so it's not prime\n        i += 2\n\n    return False # No divisors found, so it is a prime number"}
{"task_id": "Mbpp/14", "solution": "def find_Volume(param1, param2, param3):\n    \"\"\"\n    Calculates the volume of a triangular prism given three dimensions.\n    The parameters represent the base, height of the triangular face, and the length of the prism.\n    \"\"\"\n    # The formula for the volume of a triangular prism is (base * height / 2) * length\n    # Here, param1 can be considered the base, param2 the height, and param3 the length.\n    volume = (param1 * param2 * param3) / 2\n    return volume"}
