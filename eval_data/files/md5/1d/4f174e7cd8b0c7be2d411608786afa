{"task_id": "Mbpp/785", "solution": "def tuple_str_int(tuple_string: str) -> tuple:\n    \"\"\"\n    Converts a string representation of a tuple of integers to an actual Python integer tuple.\n    Assumes the input string is in a valid format like \"(7, 8, 9)\".\n    \"\"\"\n    if tuple_string == \"()\":\n        return ()\n\n    # Remove the outer parentheses\n    content = tuple_string[1:-1]\n\n    # If the content inside the parentheses is empty or just whitespace, return an empty tuple.\n    if not content.strip():\n        return ()\n\n    # Split the content by comma, strip whitespace from each part, and convert to integer.\n    # Then collect them into a tuple.\n    elements = [int(s.strip()) for s in content.split(',')]\n    return tuple(elements)"}
{"task_id": "Mbpp/784", "solution": "from typing import List\n\ndef mul_even_odd(numbers: List[int]) -> int:\n    \"\"\"\n    Find the product of the first even and first odd number in a given list.\n    If either number is not found, the function returns 0.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        if first_even is None and num % 2 == 0:\n            first_even = num\n\n        # If both are found, we can stop iterating\n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is not None and first_odd is not None:\n        return first_even * first_odd\n    else:\n        # Return 0 if either the first even or first odd number is not found\n        return 0"}
{"task_id": "Mbpp/790", "solution": "def even_position(lst: list) -> bool:\n    \"\"\"\n    Checks if every element at an even index in the given list is an even number.\n    Returns True if all such elements are even, False otherwise.\n    \"\"\"\n    for i in range(0, len(lst), 2):\n        if lst[i] % 2 != 0:\n            return False\n    return True"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(array, target):\n    \"\"\"\n    Locate the right insertion point for a specified value in sorted order using binary search.\n    This function finds the index where the target can be inserted while maintaining sorted order,\n    and for duplicates, it returns the index *after* all existing occurrences.\n    \"\"\"\n    low = 0\n    high = len(array)\n\n    while low < high:\n        mid = low + (high - low) // 2\n        if array[mid] <= target:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
