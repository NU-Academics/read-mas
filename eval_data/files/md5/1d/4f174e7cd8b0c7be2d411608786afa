{"task_id": "Mbpp/223", "solution": "def is_majority(array: list[int], n: int, element: int) -> bool:\n    \"\"\"\n    Checks if a given element is the majority element in a sorted array.\n    A majority element occurs more than n/2 times.\n    \"\"\"\n\n    def _first_occurrence(arr: list[int], target: int) -> int:\n        \"\"\"Finds the index of the first occurrence of the target in a sorted array using binary search.\"\"\"\n        low, high = 0, len(arr) - 1\n        result = -1\n        while low <= high:\n            mid = low + (high - low) // 2\n            if arr[mid] == target:\n                result = mid\n                high = mid - 1  # Search in the left half for an earlier occurrence\n            elif arr[mid] < target:\n                low = mid + 1\n            else:\n                high = mid - 1\n        return result\n\n    def _last_occurrence(arr: list[int], target: int) -> int:\n        \"\"\"Finds the index of the last occurrence of the target in a sorted array using binary search.\"\"\"\n        low, high = 0, len(arr) - 1\n        result = -1\n        while low <= high:\n            mid = low + (high - low) // 2\n            if arr[mid] == target:\n                result = mid\n                low = mid + 1  # Search in the right half for a later occurrence\n            elif arr[mid] < target:\n                low = mid + 1\n            else:\n                high = mid - 1\n        return result\n\n    def count_occurrences(arr: list[int], target: int) -> int:\n        \"\"\"Counts the total occurrences of an element in a sorted array.\"\"\"\n        first_idx = _first_occurrence(arr, target)\n        if first_idx == -1:\n            return 0  # Element not found\n        last_idx = _last_occurrence(arr, target)\n        return last_idx - first_idx + 1\n\n    def validate_majority(count: int, total_length: int) -> bool:\n        \"\"\"Checks if the count of an element exceeds the majority threshold.\"\"\"\n        return count > total_length / 2\n\n    if n == 0:\n        return False\n    \n    occurrence_count = count_occurrences(array, element)\n    return validate_majority(occurrence_count, n)"}
