{"task_id": "Mbpp/440", "solution": "import string\nimport re\n\n_COMMON_ADVERBS = {\n    \"always\", \"never\", \"usually\", \"often\", \"sometimes\", \"rarely\", \"soon\", \"now\",\n    \"yesterday\", \"today\", \"tomorrow\", \"here\", \"there\", \"everywhere\", \"anywhere\",\n    \"nowhere\", \"well\", \"badly\", \"very\", \"really\", \"almost\", \"just\", \"still\",\n    \"yet\", \"ago\", \"already\", \"ever\", \"seldom\", \"generally\", \"frequently\",\n    \"normally\", \"constantly\", \"nearly\", \"altogether\", \"away\", \"back\", \"down\",\n    \"elsewhere\", \"far\", \"forth\", \"home\", \"in\", \"inside\", \"near\", \"off\", \"on\",\n    \"out\", \"outside\", \"over\", \"round\", \"through\", \"under\", \"up\", \"where\", \"why\",\n    \"how\", \"when\", \"too\", \"enough\", \"quite\", \"rather\", \"so\", \"such\", \"then\",\n    \"thus\", \"accordingly\", \"consequently\", \"furthermore\", \"hence\", \"however\",\n    \"indeed\", \"moreover\", \"nevertheless\", \"otherwise\", \"therefore\", \"thereby\",\n    \"wherefore\", \"wherein\", \"whereupon\", \"whilst\", \"whither\", \"likewise\",\n    \"meanwhile\", \"nonetheless\", \"notwithstanding\", \"subsequently\", \"thereafter\",\n    \"thereof\", \"thereon\", \"thereto\", \"thereupon\", \"whereby\", \"whereof\", \"whereon\",\n    \"whereunto\", \"wherewith\", \"yonder\", \"only\", \"even\", \"least\", \"much\", \"more\",\n    \"most\", \"less\", \"pretty\", \"clearly\", \"quickly\", \"slowly\", \"loudly\", \"softly\",\n    \"exactly\", \"hardly\", \"smoothly\", \"lightly\", \"brightly\", \"calmly\", \"deeply\",\n    \"eagerly\", \"easily\", \"firmly\", \"freely\", \"fully\", \"gently\", \"happily\", \"highly\",\n    \"honestly\", \"kindly\", \"lazily\", \"likely\", \"madly\", \"neatly\", \"openly\", \"poorly\",\n    \"proudly\", \"quickly\", \"quietly\", \"rarely\", \"readily\", \"safely\", \"sadly\", \"secretly\",\n    \"sharply\", \"sincerely\", \"sleepily\", \"slowly\", \"smartly\", \"softly\", \"soon\", \"swiftly\",\n    \"tightly\", \"truly\", \"urgently\", \"warmly\", \"wearily\", \"wildly\", \"wisely\", \"yearly\",\n    \"daily\", \"weekly\", \"monthly\"\n}\n\ndef _strip_punctuation(word: str) -> str:\n    \"\"\"Removes leading and trailing punctuation from a word.\"\"\"\n    return word.strip(string.punctuation)\n\ndef _extract_clean_word(word: str) -> str:\n    \"\"\"Cleans a word by stripping punctuation and converting to lowercase.\"\"\"\n    return _strip_punctuation(word).lower()\n\ndef _is_common_adverb(word: str) -> bool:\n    \"\"\"Checks if a given word is in the predefined list of common adverbs.\"\"\"\n    return word in _COMMON_ADVERBS\n\ndef _identify_adverb(word: str) -> bool:\n    \"\"\"Determines if a cleaned, lowercased word is likely an adverb.\"\"\"\n    if _is_common_adverb(word):\n        return True\n    # Check for words ending in -ly, but only if they are not too short (e.g., \"fly\")\n    if len(word) > 2 and word.endswith('ly'):\n        return True\n    return False\n\ndef _calculate_positions(sentence: str, raw_word_original_case: str, cleaned_adverb: str, raw_word_start_index: int) -> tuple:\n    \"\"\"Calculates the start and end positions of the cleaned adverb within the original sentence.\"\"\"\n    # Find the starting offset of the cleaned adverb within the raw, lowercased word.\n    offset_in_raw_word = raw_word_original_case.lower().find(cleaned_adverb)\n    \n    start_pos = raw_word_start_index + offset_in_raw_word\n    end_pos = start_pos + len(cleaned_adverb)\n    return (start_pos, end_pos)\n\ndef find_adverb_position(sentence: str) -> tuple | None:\n    \"\"\"Finds the first adverb and its positions in a given sentence.\"\"\"\n    for match in re.finditer(r'\\S+', sentence):\n        raw_word = match.group(0)\n        original_start_index = match.start()\n\n        cleaned_word = _extract_clean_word(raw_word)\n\n        if cleaned_word and _identify_adverb(cleaned_word):\n            start_pos, end_pos = _calculate_positions(sentence, raw_word, cleaned_word, original_start_index)\n            return (start_pos, end_pos, cleaned_word)\n\n    return None"}
