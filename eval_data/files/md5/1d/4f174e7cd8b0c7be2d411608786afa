{"task_id": "Mbpp/71", "solution": "def comb_sort(arr: list) -> list:\n    \"\"\"Sorts a list of elements in ascending order using the comb sort algorithm.\"\"\"\n    n = len(arr)\n    if n <= 1:\n        return arr\n\n    gap = n\n    swapped = True \n\n    # Loop until the gap is 1 and no swaps occur in a pass (fully sorted)\n    while gap > 1 or swapped:\n        # Reduce gap by a factor of 1.3, ensuring it remains at least 1\n        gap = max(1, int(gap / 1.3))\n        \n        swapped = False \n\n        # Traverse the array and compare elements at current gap distance\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    \n    return arr"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list: list, sublist: list) -> bool:\n    \"\"\"\n    Check if sublist appears as contiguous subsequence in main_list.\n    \"\"\"\n    if not sublist:\n        return True\n    if not main_list or len(sublist) > len(main_list):\n        return False\n\n    n = len(main_list)\n    m = len(sublist)\n\n    for i in range(n - m + 1):\n        match = True\n        for j in range(m):\n            if main_list[i + j] != sublist[j]:\n                match = False\n                break\n        if match:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(array1: list, array2: list) -> bool:\n    \"\"\"Checks if two arrays follow the same structural pattern.\n    This function compares the canonical pattern representations of both arrays.\"\"\"\n    if len(array1) != len(array2):\n        return False\n\n    def _extract_pattern_structure(arr: list) -> list:\n        \"\"\"Extracts a canonical pattern representation from an array.\"\"\"\n        mapping = {}\n        pattern = []\n        next_id = 0\n        for item in arr:\n            if item not in mapping:\n                mapping[item] = next_id\n                next_id += 1\n            pattern.append(mapping[item])\n        return pattern\n\n    pattern1 = _extract_pattern_structure(array1)\n    pattern2 = _extract_pattern_structure(array2)\n\n    return pattern1 == pattern2"}
{"task_id": "Mbpp/75", "solution": "def find_tuples(tuple_list, k):\n    \"\"\"\n    Filters a list of tuples, returning only those where all elements are divisible by k.\n    Raises ZeroDivisionError if k is 0.\n    \"\"\"\n    if k == 0:\n        raise ZeroDivisionError(\"Division by zero is not allowed.\")\n\n    def _is_element_divisible(element, divisor):\n        \"\"\"Checks if a single element is divisible by the divisor.\"\"\"\n        return element % divisor == 0\n\n    def _check_divisibility(tuple_item, divisor):\n        \"\"\"Checks if all elements in a tuple are divisible by the divisor.\"\"\"\n        return all(_is_element_divisible(element, divisor) for element in tuple_item)\n\n    return [tup for tup in tuple_list if _check_divisibility(tup, k)]"}
