{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr: list) -> int:\n    # Counts inversions in an array using a nested loop approach.\n    # An inversion exists if arr[i] > arr[j] for i < j.\n    n = len(arr)\n    inversion_count = 0\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            if arr[i] > arr[j]:\n                inversion_count += 1\n    return inversion_count"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(tuple_list):\n    \"\"\"\n    Calculates the maximum aggregate sum for names from a list of (name, value) tuples.\n    Aggregates values for duplicate names and returns the name with the highest total sum.\n    \"\"\"\n    if not tuple_list:\n        return None, 0 # Return None for name and 0 for sum for an empty list, consistent with no max found.\n\n    # Step 1: Aggregate values by name\n    aggregates = {}\n    for name, value in tuple_list:\n        aggregates[name] = aggregates.get(name, 0) + value\n\n    # Step 2: Find the maximum aggregate\n    max_name = None\n    max_sum = 0\n\n    # Initialize with the first item in aggregates if available\n    # This handles the case where all sums are negative.\n    if aggregates:\n        first_name = next(iter(aggregates))\n        max_name = first_name\n        max_sum = aggregates[first_name]\n\n        for name, current_sum in aggregates.items():\n            if current_sum > max_sum:\n                max_sum = current_sum\n                max_name = name\n\n    return (max_name, max_sum)"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(nested_list: list) -> list:\n    \"\"\"\n    Recursively flattens a nested list structure into a single-level list, preserving element order.\n    \"\"\"\n    result = []\n    for item in nested_list:\n        if isinstance(item, list):\n            result.extend(flatten_list(item))\n        else:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/305", "solution": "def start_withp(input_list: list) -> tuple:\n    \"\"\"\n    Orchestrates the word filtering process to find two words starting with 'P'.\n    Extracts, filters, and returns the first two such words as a tuple.\n    \"\"\"\n    all_words = []\n    for text in input_list:\n        all_words.extend(text.split())\n\n    p_words = []\n    for word in all_words:\n        if word.startswith('P'):\n            p_words.append(word)\n            if len(p_words) == 2:\n                break\n    return (p_words[0], p_words[1])"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(dictionary: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of a dictionary.\n    The depth starts from 1 for the root level.\n    \"\"\"\n    if not isinstance(dictionary, dict):\n        return 0\n\n    max_depth = 1\n    for value in dictionary.values():\n        if isinstance(value, dict):\n            max_depth = max(max_depth, 1 + dict_depth(value))\n    return max_depth"}
{"task_id": "Mbpp/300", "solution": "import itertools\n\ndef count_binary_seq(n: int) -> float:\n    \"\"\"\n    Counts binary sequences of length 2n where the sum of the first n bits\n    is the same as the sum of the last n bits.\n    \"\"\"\n    total_length = 2 * n\n    valid_sequences_count = 0\n\n    # Generate all possible binary sequences of length 2n.\n    for sequence_tuple in itertools.product('01', repeat=total_length):\n        sequence = \"\".join(sequence_tuple)\n\n        # Calculate the sum of '1's in the first half of the sequence.\n        first_half_sum = sequence[0:n].count('1')\n\n        # Calculate the sum of '1's in the second half of the sequence.\n        second_half_sum = sequence[n:total_length].count('1')\n\n        # If the sums are equal, increment the valid sequences counter.\n        if first_half_sum == second_half_sum:\n            valid_sequences_count += 1\n\n    return float(valid_sequences_count)"}
