{"task_id": "Mbpp/626", "solution": "def _validate_radius(radius: float) -> bool:\n    \"\"\"Validates if the given radius is non-negative.\"\"\"\n    return radius >= 0\n\ndef _calculate_area(radius: float) -> float:\n    \"\"\"Calculates the area of the largest inscribed triangle (radius squared).\"\"\"\n    return radius * radius\n\ndef triangle_area(radius: float) -> float | None:\n    \"\"\"\n    Calculates the area of the largest triangle that can be inscribed in a semicircle\n    with the given radius. Returns None for invalid (negative) radii.\n    \"\"\"\n    if not _validate_radius(radius):\n        return None\n    return _calculate_area(radius)"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1, list2, size):\n    \"\"\"\n    Finds the median of two sorted lists of the same size.\n    Uses a binary search-based approach to achieve O(log n) time complexity.\n    \"\"\"\n\n    def find_kth_element(nums1, i, nums2, j, k):\n        \"\"\"\n        Recursively finds the k-th smallest element from two sorted lists,\n        starting comparison from indices i and j respectively.\n        \"\"\"\n        # Base cases\n        if i == len(nums1):\n            return nums2[j + k - 1]\n        if j == len(nums2):\n            return nums1[i + k - 1]\n        if k == 1:\n            return min(nums1[i], nums2[j])\n\n        # Determine how many elements to consider/skip from each list\n        # We try to eliminate k/2 elements in each step\n        amount1 = min(k // 2, len(nums1) - i)\n        amount2 = min(k // 2, len(nums2) - j)\n\n        # Compare elements at the end of these potential skip segments\n        val1_to_compare = nums1[i + amount1 - 1] if amount1 > 0 else float('inf')\n        val2_to_compare = nums2[j + amount2 - 1] if amount2 > 0 else float('inf')\n\n        if val1_to_compare <= val2_to_compare:\n            # If element from nums1 is smaller or equal, discard `amount1` elements from nums1\n            return find_kth_element(nums1, i + amount1, nums2, j, k - amount1)\n        else:\n            # Otherwise, discard `amount2` elements from nums2\n            return find_kth_element(nums1, i, nums2, j + amount2, k - amount2)\n\n    # For two lists of size 'size', there are 2 * size elements in total.\n    # The median is the average of the (size)-th and (size + 1)-th elements\n    # when considering the combined 1-indexed sorted list.\n    median1 = find_kth_element(list1, 0, list2, 0, size)\n    median2 = find_kth_element(list1, 0, list2, 0, size + 1)\n\n    return (median1 + median2) / 2.0"}
{"task_id": "Mbpp/620", "solution": "import itertools\nfrom typing import List, Iterator\n\nclass NumberList:\n    \"\"\"Manages and validates input number collections.\"\"\"\n    def __init__(self, numbers: List[int]) -> None:\n        \"\"\"Initializes with a list of numbers.\"\"\"\n        self._numbers = numbers\n\n    def validate_input(self) -> bool:\n        \"\"\"Validates that numbers are positive integers.\"\"\"\n        # Per design constraints, specific type/value checks and exceptions are omitted.\n        return True \n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the list is empty.\"\"\"\n        return not self._numbers\n\n    def size(self) -> int:\n        \"\"\"Gets the list size.\"\"\"\n        return len(self._numbers)\n\n    def get_numbers(self) -> List[int]:\n        \"\"\"Gets the validated numbers.\"\"\"\n        return self._numbers\n\nclass Subset:\n    \"\"\"Represents and manages number subsets.\"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        \"\"\"Initializes the subset with a list of elements.\"\"\"\n        self._elements = sorted(elements)\n        self._size = len(elements)\n\n    def add_element(self, element: int) -> None:\n        \"\"\"Adds an element to the subset.\"\"\"\n        self._elements.append(element)\n        self._elements.sort()\n        self._size += 1\n\n    def remove_element(self, element: int) -> None:\n        \"\"\"Removes an element from the subset.\"\"\"\n        if element in self._elements:\n            self._elements.remove(element)\n            self._size -= 1\n\n    def size(self) -> int:\n        \"\"\"Gets the subset size.\"\"\"\n        return self._size\n\n    def get_elements(self) -> List[int]:\n        \"\"\"Gets the subset elements.\"\"\"\n        return self._elements\n\nclass DivisibilityChecker:\n    \"\"\"Validates divisibility relationships between numbers.\"\"\"\n    def __init__(self) -> None:\n        \"\"\"Initializes the divisibility checker.\"\"\"\n        pass \n\n    def check_pair_divisibility(self, a: int, b: int) -> bool:\n        \"\"\"Checks if one number divides the other.\"\"\"\n        return a % b == 0 or b % a == 0\n\n    def validate_subset_divisibility(self, subset: 'Subset') -> bool:\n        \"\"\"Validates if all pairs in a subset are divisible.\"\"\"\n        elements = subset.get_elements()\n        n = len(elements)\n        if n <= 1:\n            return True\n        \n        for i in range(n):\n            for j in range(i + 1, n):\n                if not self.check_pair_divisibility(elements[i], elements[j]):\n                    return False\n        return True\n\nclass Result:\n    \"\"\"Encapsulates computation results.\"\"\"\n    def __init__(self, max_size: int, largest_subset: 'Subset') -> None:\n        \"\"\"Initializes the result with max size and the largest subset.\"\"\"\n        self.max_size = max_size\n        self.largest_subset = largest_subset\n\n    def get_size(self) -> int:\n        \"\"\"Gets the maximum size.\"\"\"\n        return self.max_size\n\nclass SubsetFinder:\n    \"\"\"Finds the largest valid subset using optimization algorithms.\"\"\"\n    def __init__(self) -> None:\n        \"\"\"Initializes the subset finder with a divisibility checker.\"\"\"\n        self._checker = DivisibilityChecker()\n\n    def _generate_subsets(self, numbers: List[int]) -> Iterator[Subset]:\n        \"\"\"Generates all possible subsets as Subset objects.\"\"\"\n        for i in range(1, len(numbers) + 1):\n            for combo in itertools.combinations(numbers, i):\n                yield Subset(list(combo))\n\n    def find_largest_subset(self, number_list: NumberList) -> Result:\n        \"\"\"Finds the largest subset where every pair is divisible.\"\"\"\n        numbers = number_list.get_numbers()\n        \n        if number_list.is_empty():\n            return Result(0, None)\n        \n        max_size = 0\n        largest_subset_found = None\n\n        sorted_numbers = sorted(numbers)\n\n        for current_subset_obj in self._generate_subsets(sorted_numbers):\n            if self._checker.validate_subset_divisibility(current_subset_obj):\n                if current_subset_obj.size() > max_size:\n                    max_size = current_subset_obj.size()\n                    largest_subset_found = current_subset_obj\n        \n        return Result(max_size, largest_subset_found)\n\ndef largest_subset(numbers: List[int]) -> int:\n    \"\"\"Finds the size of the largest subset where every pair is divisible.\"\"\"\n    number_list = NumberList(numbers)\n\n    if number_list.is_empty():\n        return 0\n    if number_list.size() == 1:\n        return 1\n\n    finder = SubsetFinder()\n    result = finder.find_largest_subset(number_list)\n    return result.get_size()"}
