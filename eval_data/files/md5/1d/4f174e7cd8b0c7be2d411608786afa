{"task_id": "Mbpp/724", "solution": "def power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of all digits of the base raised to the specified power.\n    This function orchestrates the power calculation and digit summation.\n    \"\"\"\n\n    def _calculate_power(b: int, p: int) -> int:\n        \"\"\"Performs exponential calculation for base to the power.\"\"\"\n        return b ** p\n\n    def _extract_digits(number: int) -> list[int]:\n        \"\"\"Converts a number to a list of its individual digit integers.\"\"\"\n        return [int(digit) for digit in str(number)]\n\n    def _sum_digits(digits_list: list[int]) -> int:\n        \"\"\"Sums all values within a list of integers.\"\"\"\n        return sum(digits_list)\n\n    # 1. Calculate the base raised to the power.\n    result = _calculate_power(base, power)\n\n    # 2. Extract the individual digits from the result.\n    digits = _extract_digits(result)\n\n    # 3. Sum the extracted digits.\n    digit_sum = _sum_digits(digits)\n\n    return digit_sum"}
{"task_id": "Mbpp/725", "solution": "def extract_quotation(input_string: str) -> list[str]:\n    \"\"\"\n    Extracts values enclosed within double quotation marks from the given string.\n    Returns a list of extracted strings in their original order.\n    \"\"\"\n    extracted_values = []\n    in_quote = False\n    start_index = -1\n\n    for i, char in enumerate(input_string):\n        if char == '\"':\n            if not in_quote:\n                # Found an opening quote\n                in_quote = True\n                start_index = i + 1\n            else:\n                # Found a closing quote\n                in_quote = False\n                extracted_values.append(input_string[start_index:i])\n                start_index = -1 # Reset for next quote pair\n\n    return extracted_values"}
{"task_id": "Mbpp/721", "solution": "from typing import List, Tuple\n\nclass Cell:\n    \"\"\"Represents a cell in the matrix with its position and cost.\"\"\"\n    def __init__(self, row: int, column: int, cost: float):\n        self._row = row\n        self._column = column\n        self._cost = cost\n\n    def get_position(self) -> Tuple[int, int]:\n        return (self._row, self._column)\n\n    def get_cost(self) -> float:\n        return self._cost\n\nclass Path:\n    \"\"\"Represents a sequence of cells forming a path, capable of calculating its average cost.\"\"\"\n    def __init__(self):\n        self._cells: List[Cell] = []\n        self._total_cost: float = 0.0\n        self._cell_count: int = 0\n\n    def add_cell(self, cell: Cell):\n        \"\"\"Adds a cell to the path and updates total cost and cell count.\"\"\"\n        self._cells.append(cell)\n        self._total_cost += cell.get_cost()\n        self._cell_count += 1\n\n    def calculate_average(self) -> float:\n        \"\"\"Calculates the average cost of the path.\"\"\"\n        if self._cell_count == 0:\n            return 0.0\n        return self._total_cost / self._cell_count\n\n    def get_cells(self) -> List[Cell]:\n        return self._cells\n\n    def get_total_cost(self) -> float:\n        return self._total_cost\n\n    def get_cell_count(self) -> int:\n        return self._cell_count\n\nclass Matrix:\n    \"\"\"Represents the square matrix, providing access to its cells and size.\"\"\"\n    def __init__(self, cells_data: List[List]):\n        self._size = len(cells_data)\n        self._cells_data = cells_data\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        \"\"\"Returns a Cell object for the given row and column.\"\"\"\n        return Cell(row, col, float(self._cells_data[row][col]))\n\n    def get_size(self) -> int:\n        return self._size\n\nclass MatrixValidator:\n    \"\"\"Handles input matrix validation (simplified per problem constraints).\"\"\"\n    def validate_input(self, cells: List[List]) -> bool:\n        \"\"\"Assumes input is always valid as per instructions.\"\"\"\n        return True\n\nclass PathGenerator:\n    \"\"\"Generates all valid paths from top-left to bottom-right in a matrix.\"\"\"\n    def __init__(self, matrix: Matrix):\n        self._matrix = matrix\n        self._N = matrix.get_size()\n\n    def generate_all_paths(self) -> List[Path]:\n        \"\"\"Initiates the recursive path generation process.\"\"\"\n        all_paths: List[Path] = []\n        start_cell = self._matrix.get_cell(0, 0)\n        initial_path = Path()\n        initial_path.add_cell(start_cell)\n        self._generate_paths_recursive(0, 0, initial_path, all_paths)\n        return all_paths\n\n    def _generate_paths_recursive(self, row: int, col: int, current_path: Path, all_paths: List[Path]):\n        \"\"\"Recursively explores paths by moving right or down.\"\"\"\n        if row == self._N - 1 and col == self._N - 1:\n            all_paths.append(current_path)\n            return\n\n        # Try moving right\n        if col + 1 < self._N:\n            next_cell_right = self._matrix.get_cell(row, col + 1)\n            new_path_right = Path()\n            for cell in current_path.get_cells():\n                new_path_right.add_cell(cell)\n            new_path_right.add_cell(next_cell_right)\n            self._generate_paths_recursive(row, col + 1, new_path_right, all_paths)\n\n        # Try moving down\n        if row + 1 < self._N:\n            next_cell_down = self._matrix.get_cell(row + 1, col)\n            new_path_down = Path()\n            for cell in current_path.get_cells():\n                new_path_down.add_cell(cell)\n            new_path_down.add_cell(next_cell_down)\n            self._generate_paths_recursive(row + 1, col, new_path_down, all_paths)\n\nclass MaxAverageCalculator:\n    \"\"\"Calculates the maximum average from a list of paths.\"\"\"\n    def find_max_average(self, paths: List[Path]) -> float:\n        \"\"\"Iterates through paths and finds the one with the highest average cost.\"\"\"\n        max_avg = 0.0\n        if not paths:\n            return max_avg\n\n        for path in paths:\n            avg = path.calculate_average()\n            if avg > max_avg:\n                max_avg = avg\n        return max_avg\n\ndef maxAverageOfPath(matrix_input: List[List]) -> float:\n    \"\"\"\n    Given a square matrix, finds a path from top-left to bottom-right\n    moving only right or down, that has the maximum average cost.\n    \"\"\"\n    validator = MatrixValidator()\n    # As per instructions, validation is assumed to pass.\n    validator.validate_input(matrix_input)\n\n    matrix_instance = Matrix(matrix_input)\n\n    generator_instance = PathGenerator(matrix_instance)\n    all_valid_paths = generator_instance.generate_all_paths()\n\n    calculator = MaxAverageCalculator()\n    maximum_average = calculator.find_max_average(all_valid_paths)\n\n    return maximum_average"}
{"task_id": "Mbpp/726", "solution": "def multiply_elements(input_tuple):\n    \"\"\"\n    Takes a tuple of numbers and returns a tuple where each element\n    is the product of two consecutive elements from the input.\n    \"\"\"\n    products = []\n    for i in range(len(input_tuple) - 1):\n        products.append(input_tuple[i] * input_tuple[i + 1])\n    return tuple(products)"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list):\n    \"\"\"\n    Removes consecutive duplicate elements from a list, preserving the first occurrence\n    of each consecutive group and maintaining original order.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = [input_list[0]]\n    for i in range(1, len(input_list)):\n        if input_list[i] != input_list[i-1]:\n            result.append(input_list[i])\n    return result"}
