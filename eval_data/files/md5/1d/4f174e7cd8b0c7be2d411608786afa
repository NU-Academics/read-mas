{"task_id": "Mbpp/731", "solution": "import math\n\ndef lateralsurface_cone(radius: float, height: float) -> float:\n    \"\"\"Calculate the lateral surface area of a cone.\n    Uses the formula \u03c0 \u00d7 r \u00d7 \u221a(r\u00b2 + h\u00b2).\"\"\"\n    slant_height = math.sqrt(radius**2 + height**2)\n    lateral_area = math.pi * radius * slant_height\n    return lateral_area"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array: list[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array using binary search.\n    Returns -1 if the target is not found.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            result = mid\n            high = mid - 1  # Continue searching in the left half for the first occurrence\n        elif array[mid] < target:\n            low = mid + 1\n        else:  # array[mid] > target\n            high = mid - 1\n    return result"}
{"task_id": "Mbpp/734", "solution": "def calculate_product(sublist: list) -> int:\n    \"\"\"Calculate product of elements in sublist.\n    Returns 1 for an empty sublist.\"\"\"\n    product = 1\n    for x in sublist:\n        product *= x\n    return product\n\ndef generate_all_sublists(lst: list) -> list:\n    \"\"\"Generate all possible contiguous sublists.\"\"\"\n    sublists = []\n    n = len(lst)\n    for i in range(n):\n        for j in range(i, n):\n            sublists.append(lst[i : j + 1])\n    return sublists\n\ndef sum_Of_Subarray_Prod(lst: list) -> int:\n    \"\"\"Calculate sum of products of all possible sublists.\"\"\"\n    all_sublists = generate_all_sublists(lst)\n    total_sum_of_products = 0\n    for sublist in all_sublists:\n        total_sum_of_products += calculate_product(sublist)\n    return total_sum_of_products"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"Toggles bits of the number except the first (MSB) and the last (LSB) bit.\"\"\"\n    if number == 0:\n        return 0\n\n    # Determine the number of bits required to represent the number.\n    bit_length = number.bit_length()\n\n    # Create a mask that has 1s only for the middle bits.\n    if bit_length <= 2:\n        # If length is 0, 1, or 2, there are no middle bits to toggle.\n        middle_mask = 0\n    else:\n        # Create a mask with all bits set to 1 for the given bit_length.\n        all_ones_mask = (1 << bit_length) - 1\n        \n        # Create a mask to identify the most significant bit (MSB) position.\n        msb_position_mask = (1 << (bit_length - 1))\n        \n        # The least significant bit (LSB) position is always 1.\n        lsb_position_mask = 1\n        \n        # Combine the MSB and LSB position masks to identify the bits to preserve.\n        edges_mask = msb_position_mask | lsb_position_mask\n        \n        # The middle_mask is derived by XORing all_ones_mask with edges_mask.\n        # This results in 1s for middle bits and 0s for MSB and LSB.\n        middle_mask = all_ones_mask ^ edges_mask\n    \n    # Toggle the middle bits of the number using the XOR operation.\n    result = number ^ middle_mask\n    \n    return result"}
