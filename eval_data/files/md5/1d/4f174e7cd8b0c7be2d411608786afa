{"task_id": "Mbpp/554", "solution": "def Split(input_list: list[int]) -> list[int]:\n    \"\"\"\n    Filters a list of integers, returning only the odd numbers.\n    Maintains the original order of odd numbers.\n    \"\"\"\n    def _is_odd(number: int) -> bool:\n        \"\"\"Helper function to check if a number is odd.\"\"\"\n        return number % 2 != 0\n\n    odd_numbers = []\n    for number in input_list:\n        if _is_odd(number):\n            odd_numbers.append(number)\n    return odd_numbers"}
{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Calculate the difference between the sum of cubes of the first n natural numbers and the sum of the first n natural numbers.\n    \"\"\"\n    sum_of_naturals = n * (n + 1) // 2\n    sum_of_cubes = sum_of_naturals ** 2\n    return sum_of_cubes - sum_of_naturals"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(array, size):\n    \"\"\"\n    Counts the number of pairs in an array whose XOR value is odd.\n    An XOR operation results in an odd value if one number is even and the other is odd.\n    \"\"\"\n    count = 0\n    for i in range(size):\n        for j in range(i + 1, size):\n            # Check if one number is even and the other is odd\n            # This is equivalent to checking if (array[i] ^ array[j]) is odd\n            if (array[i] % 2) != (array[j] % 2):\n                count += 1\n    return count"}
{"task_id": "Mbpp/557", "solution": "def is_uppercase(char: str) -> bool:\n    \"\"\"Checks if a character is an uppercase letter.\"\"\"\n    return char.isupper()\n\ndef is_lowercase(char: str) -> bool:\n    \"\"\"Checks if a character is a lowercase letter.\"\"\"\n    return char.islower()\n\ndef is_alphabetic(char: str) -> bool:\n    \"\"\"Checks if a character is an alphabetic letter.\"\"\"\n    return char.isalpha()\n\ndef to_uppercase(char: str) -> str:\n    \"\"\"Converts a character to its uppercase equivalent.\"\"\"\n    return char.upper()\n\ndef to_lowercase(char: str) -> str:\n    \"\"\"Converts a character to its lowercase equivalent.\"\"\"\n    return char.lower()\n\ndef toggle_string(input_string: str) -> str:\n    \"\"\"Toggles the case of all alphabetic characters in a string, preserving non-alphabetic characters.\"\"\"\n    toggled_chars = []\n    for char in input_string:\n        if is_alphabetic(char):\n            if is_uppercase(char):\n                toggled_chars.append(to_lowercase(char))\n            elif is_lowercase(char):\n                toggled_chars.append(to_uppercase(char))\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculate the sum of per-digit absolute differences between two integers.\n    Processes digits from right to left, treating missing digits as zero.\n    \"\"\"\n    total_distance = 0\n    while num1 > 0 or num2 > 0:\n        digit1 = num1 % 10\n        digit2 = num2 % 10\n        total_distance += abs(digit1 - digit2)\n        num1 //= 10\n        num2 //= 10\n    return total_distance"}
{"task_id": "Mbpp/560", "solution": "def union_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Computes the union of elements from two tuples, removes duplicates, sorts them, and returns a new tuple.\n    \"\"\"\n    combined_set = set(tuple1).union(set(tuple2))\n    sorted_list = sorted(list(combined_set))\n    return tuple(sorted_list)"}
{"task_id": "Mbpp/559", "solution": "def kadane_algorithm(arr: list) -> int:\n    \"\"\"Implement Kadane's algorithm to find the maximum sum of a contiguous subarray.\"\"\"\n    max_so_far = arr[0]\n    current_max = arr[0]\n    for i in range(1, len(arr)):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n    return max_so_far\n\ndef max_sub_array_sum(arr: list, n: int) -> int:\n    \"\"\"Find the sum of the largest contiguous sublist in the given list.\"\"\"\n    return kadane_algorithm(arr)"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(sublists):\n    \"\"\"\n    Finds the length of the longest sublist within a list of sublists.\n    Returns 0 if the input list is empty or contains only empty sublists.\n    \"\"\"\n    if not sublists:\n        return 0\n\n    max_length = 0\n    for sublist in sublists:\n        if len(sublist) > max_length:\n            max_length = len(sublist)\n    return max_length"}
{"task_id": "Mbpp/564", "solution": "def count_Pairs(elements: list[int], length: int) -> int:\n    \"\"\"\n    Counts the number of possible unordered pairs where both elements are unequal.\n    The 'length' parameter is provided for signature compliance and is not used in the core logic.\n    \"\"\"\n\n    def _generate_pairs(elements_list: list[int]) -> list[tuple[int, int]]:\n        \"\"\"Generates all unique pairs of elements based on their positions in the input list.\"\"\"\n        pairs = []\n        n = len(elements_list)\n        for i in range(n):\n            for j in range(i + 1, n):\n                pairs.append((elements_list[i], elements_list[j]))\n        return pairs\n\n    def _filter_unequal_pairs(pairs_list: list[tuple[int, int]]) -> list[tuple[int, int]]:\n        \"\"\"Filters a list of pairs to include only those where the two elements are unequal.\"\"\"\n        return [pair for pair in pairs_list if pair[0] != pair[1]]\n\n    def _count_pairs(pairs_list: list[tuple[int, int]]) -> int:\n        \"\"\"Counts the total number of pairs present in the given list.\"\"\"\n        return len(pairs_list)\n\n    all_generated_pairs = _generate_pairs(elements)\n    filtered_unequal_pairs = _filter_unequal_pairs(all_generated_pairs)\n    final_count = _count_pairs(filtered_unequal_pairs)\n\n    return final_count"}
