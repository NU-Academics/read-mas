{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1, list2, list3):\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Elements are taken in a round-robin fashion, preserving their original order within each list.\n    \"\"\"\n    result = []\n    # Assumes all lists are of the same length based on the problem description.\n    for i in range(len(list1)):\n        result.append(list1[i])\n        result.append(list2[i])\n        result.append(list3[i])\n    return result"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(number: int) -> int:\n    \"\"\"\n    Calculates the last digit of the factorial of a given number.\n    Uses helper functions to compute factorial and then extract its last digit.\n    \"\"\"\n    def _calculate_factorial(n: int) -> int:\n        \"\"\"Helper to calculate the factorial of a number.\"\"\"\n        if n == 0 or n == 1:\n            return 1\n        \n        # Optimization: For n >= 5, n! will always end in 0.\n        # However, the design context specifies returning the full factorial first.\n        # So we calculate the full factorial for now.\n        # A more optimized version for only the *last digit* could return 0 directly for n >= 5.\n        \n        factorial_result = 1\n        for i in range(2, n + 1):\n            factorial_result *= i\n        return factorial_result\n\n    def _extract_last_digit(value: int) -> int:\n        \"\"\"Helper to extract the last digit of a number.\"\"\"\n        return value % 10\n\n    # Main logic of last_Digit_Factorial\n    if number >= 5:\n        # Optimization: For any integer n >= 5, n! will always end in 0.\n        # This avoids calculating large factorials for no benefit to the last digit.\n        return 0\n    \n    factorial_value = _calculate_factorial(number)\n    return _extract_last_digit(factorial_value)"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list: list, sub_list: list) -> bool:\n    \"\"\"\n    Checks if `sub_list` is a contiguous sublist of `main_list`.\n    An empty list is considered a sublist of any list.\n    \"\"\"\n    n = len(main_list)\n    m = len(sub_list)\n\n    if m == 0:\n        return True  # An empty list is a sublist of any list\n\n    if m > n:\n        return False # A non-empty sublist cannot be found in a shorter main_list\n\n    for i in range(n - m + 1):\n        if main_list[i : i + m] == sub_list:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Finds elements that are unique to each of the two input tuples while maintaining their original order.\n    It identifies the symmetric difference between the tuples.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n    result = []\n\n    # Add elements from tuple1 that are not in tuple2\n    for item in tuple1:\n        if item not in set2:\n            result.append(item)\n\n    # Add elements from tuple2 that are not in tuple1\n    for item in tuple2:\n        if item not in set1:\n            result.append(item)\n\n    return tuple(result)"}
{"task_id": "Mbpp/581", "solution": "import math\n\ndef surface_Area(baseEdge, height):\n    \"\"\"\n    Calculates the total surface area of a square pyramid.\n    This includes the area of the square base and the four triangular faces.\n    \"\"\"\n    base_area = baseEdge * baseEdge\n    # Calculate slant height using Pythagorean theorem: l = sqrt(h^2 + (b/2)^2)\n    slant_height = math.sqrt(height**2 + (baseEdge / 2)**2)\n    # Area of one triangular face: 0.5 * base * slant_height\n    triangular_area = 0.5 * baseEdge * slant_height\n    total_surface_area = base_area + (4 * triangular_area)\n    return total_surface_area"}
{"task_id": "Mbpp/580", "solution": "def _is_even(element: int) -> bool:\n    \"\"\"Check if an integer is even.\"\"\"\n    return element % 2 == 0\n\ndef _process_element(element):\n    \"\"\"Process individual element recursively, filtering odd integers.\"\"\"\n    if isinstance(element, int):\n        if _is_even(element):\n            return element\n        else:\n            return None\n    elif isinstance(element, tuple):\n        processed_sub_elements = []\n        for sub_elem in element:\n            processed = _process_element(sub_elem)\n            if processed is not None:\n                processed_sub_elements.append(processed)\n        return tuple(processed_sub_elements)\n    else:\n        # Elements not integers or tuples are filtered out.\n        return None\n\ndef extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"Remove odd elements from nested mixed tuple while preserving structure.\"\"\"\n    result_elements = []\n    for element in input_tuple:\n        processed = _process_element(element)\n        if processed is not None:\n            result_elements.append(processed)\n    return tuple(result_elements)"}
