{"task_id": "Mbpp/597", "solution": "import math\n\ndef find_kth(array1, array2, k):\n    \"\"\"\n    Finds the kth smallest element from two sorted arrays using binary search.\n    Assumes arrays are sorted and k is 1-indexed and valid.\n    \"\"\"\n    m, n = len(array1), len(array2)\n\n    # Ensure array1 is the smaller array to optimize the binary search.\n    if m > n:\n        array1, array2 = array2, array1\n        m, n = n, m\n\n    # Define the search space for partition1 (number of elements to take from array1).\n    # 'low' is the minimum possible elements from array1, 'high' is the maximum.\n    low = max(0, k - n)\n    high = min(k, m)\n\n    while low <= high:\n        partition1 = (low + high) // 2\n        partition2 = k - partition1\n\n        # Determine the elements at the partition boundaries.\n        # Use -infinity or +infinity for boundary cases (partition at 0 or array length).\n        max_left_1 = array1[partition1 - 1] if partition1 != 0 else -math.inf\n        min_right_1 = array1[partition1] if partition1 != m else math.inf\n\n        max_left_2 = array2[partition2 - 1] if partition2 != 0 else -math.inf\n        min_right_2 = array2[partition2] if partition2 != n else math.inf\n\n        # Check if the partitions are correctly placed.\n        # This condition means all elements on the left are less than or equal to all elements on the right.\n        if max_left_1 <= min_right_2 and max_left_2 <= min_right_1:\n            return int(max(max_left_1, max_left_2))\n        elif max_left_1 > min_right_2:\n            # We took too many elements from array1, shift search space to the left.\n            high = partition1 - 1\n        else: # max_left_2 > min_right_1\n            # We took too few elements from array1, shift search space to the right.\n            low = partition1 + 1\n\n    # This line should ideally not be reached if k is within valid bounds (1 to m+n).\n    return -1 # Indicating an error, though problem context implies valid inputs."}
{"task_id": "Mbpp/598", "solution": "def extract_digits(number: int) -> list:\n    \"\"\"Extracts individual digits from a number into a list.\"\"\"\n    return [int(d) for d in str(abs(number))]\n\ndef count_digits(number: int) -> int:\n    \"\"\"Counts total number of digits in a number.\"\"\"\n    if number == 0:\n        return 1\n    return len(str(abs(number)))\n\ndef calculate_power_sum(digits: list, power: int) -> int:\n    \"\"\"Calculates sum of digits raised to specified power.\"\"\"\n    total_sum = 0\n    for digit in digits:\n        total_sum += digit ** power\n    return total_sum\n\ndef armstrong_number(number: int) -> bool:\n    \"\"\"Checks whether the given number is an Armstrong number.\"\"\"\n    if number < 0:\n        return False\n    digits = extract_digits(number)\n    num_digits = count_digits(number)\n    calculated_sum = calculate_power_sum(digits, num_digits)\n    return calculated_sum == number"}
