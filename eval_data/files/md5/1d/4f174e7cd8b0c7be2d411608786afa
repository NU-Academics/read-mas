{"task_id": "Mbpp/141", "solution": "def pancake_sort(arr):\n    \"\"\"\n    Sorts a list of elements using the pancake sorting algorithm.\n    This function modifies a copy of the input list.\n    \"\"\"\n    n = len(arr)\n    # Create a copy to avoid modifying the original list directly, as per functional design.\n    # The helper functions will operate on this copy.\n    current_arr = list(arr) \n\n    def flip(sub_arr, k):\n        \"\"\"Reverses elements from start of sub_arr to position k (inclusive).\"\"\"\n        left = 0\n        while left < k:\n            sub_arr[left], sub_arr[k] = sub_arr[k], sub_arr[left]\n            left += 1\n            k -= 1\n\n    def find_max_index(sub_arr, search_n):\n        \"\"\"Finds the index of the maximum element in the first 'search_n' elements of sub_arr.\"\"\"\n        max_idx = 0\n        for i in range(search_n):\n            if sub_arr[i] > sub_arr[max_idx]:\n                max_idx = i\n        return max_idx\n\n    # Start from the largest element and move it to its correct position\n    for current_size in range(n, 1, -1):\n        # Find the index of the maximum element in the current unsorted portion\n        max_idx = find_max_index(current_arr, current_size)\n\n        # If the maximum element is not already at the end of the current unsorted portion\n        if max_idx != current_size - 1:\n            # Move the maximum element to the front\n            flip(current_arr, max_idx)\n\n            # Move the maximum element to its correct position at the end of the current unsorted portion\n            flip(current_arr, current_size - 1)\n            \n    return current_arr"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1, list2, list3):\n    \"\"\"\n    Counts the number of positions where items are identical in all three given lists.\n    \"\"\"\n    def _get_min_length(l1, l2, l3):\n        \"\"\"Calculates the minimum length among three input lists.\"\"\"\n        return min(len(l1), len(l2), len(l3))\n\n    def _elements_match(elem1, elem2, elem3):\n        \"\"\"Checks if three elements are all identical.\"\"\"\n        return elem1 == elem2 and elem2 == elem3\n\n    min_length = _get_min_length(list1, list2, list3)\n    count = 0\n    for i in range(min_length):\n        if _elements_match(list1[i], list2[i], list3[i]):\n            count += 1\n    return count"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(array):\n    \"\"\"\n    Finds the maximum difference between any two elements in the given array.\n    This is equivalent to the difference between the maximum and minimum elements.\n    \"\"\"\n    min_val = min(array)\n    max_val = max(array)\n    return max_val - min_val"}
{"task_id": "Mbpp/161", "solution": "from typing import List\n\ndef remove_elements(source_list: List[int], removal_list: List[int]) -> List[int]:\n    \"\"\"\n    Removes all elements from the source list that are present in the removal list,\n    preserving the order of the remaining elements.\n    \"\"\"\n    removal_set = set(removal_list)\n    result_list = []\n    for element in source_list:\n        if element not in removal_set:\n            result_list.append(element)\n    return result_list"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) from i=0 up to n // 2,\n    stopping when the term becomes less than or equal to 0.\n    \"\"\"\n    current_sum = 0\n    # The loop iterates from i = 0 up to n // 2 (inclusive)\n    for i in range(n // 2 + 1):\n        term = n - 2 * i\n        if term > 0:\n            current_sum += term\n        else:\n            # Stop summing when the term is 0 or negative\n            break\n    return current_sum"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string):\n    \"\"\"\n    Counts characters in a string that match their 0-indexed position in the English alphabet (case-insensitive).\n    For example, 'a' at index 0, 'b' at index 1, etc.\n    \"\"\"\n    count = 0\n    for i, char in enumerate(input_string):\n        lower_char = char.lower()\n        if 'a' <= lower_char <= 'z':\n            alphabet_position = ord(lower_char) - ord('a')\n            if i == alphabet_position:\n                count += 1\n    return count"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(numbers):\n    \"\"\"\n    Counts pairs of integers in a list whose XOR sum is even.\n    Returns 0 for empty or single-element lists.\n    \"\"\"\n    if len(numbers) < 2:\n        return 0\n\n    even_count = 0\n    for i in range(len(numbers)):\n        for j in range(i + 1, len(numbers)):\n            # The XOR of two numbers is even if both are even or both are odd.\n            # This is equivalent to checking if (num1 % 2) == (num2 % 2).\n            # If the XOR result is even, its last bit is 0.\n            # (numbers[i] ^ numbers[j]) % 2 == 0\n            # A more efficient check for (XOR result) % 2 == 0 is to check\n            # if the parity of numbers[i] is the same as the parity of numbers[j].\n            if (numbers[i] % 2) == (numbers[j] % 2):\n                even_count += 1\n    return even_count"}
{"task_id": "Mbpp/167", "solution": "import math\n\ndef next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Handles n=0 as a special case, returning 1.\n    \"\"\"\n    if n == 0:\n        return 1\n    # Calculate the smallest integer exponent 'e' such that 2^e >= n.\n    exponent = math.ceil(math.log2(n))\n    return 2 ** int(exponent)"}
{"task_id": "Mbpp/160", "solution": "def _extended_gcd(a, b):\n    \"\"\"Computes gcd(a, b) and coefficients x, y such that ax + by = gcd(a, b).\"\"\"\n    if b == 0:\n        # Base case: gcd(a, 0) = |a|. For ax + 0y = |a|, x is 1 or -1 and y is 0.\n        return abs(a), (1 if a >= 0 else -1), 0\n    else:\n        # Recursive step using properties of Euclidean algorithm.\n        g, x_prev, y_prev = _extended_gcd(b, a % b)\n        x = y_prev\n        y = x_prev - (a // b) * y_prev\n        return g, x, y\n\ndef find_solution(a, b, n):\n    \"\"\"Returns integers x and y satisfying ax + by = n as a tuple, or None if no solution exists.\"\"\"\n    # Handle special cases where a or b (or both) are zero.\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n    elif a == 0: # Equation is by = n\n        if n % b == 0:\n            return (0, n // b)\n        else:\n            return None\n    elif b == 0: # Equation is ax = n\n        if n % a == 0:\n            return (n // a, 0)\n        else:\n            return None\n\n    # General case using the Extended Euclidean Algorithm.\n    # We find g = gcd(a, b) and x_g, y_g such that a*x_g + b*y_g = g.\n    g, x_g, y_g = _extended_gcd(a, b)\n\n    # A solution exists only if n is divisible by g.\n    if n % g != 0:\n        return None\n\n    # Calculate a particular solution (x_p, y_p).\n    # Multiply x_g, y_g by (n / g) to scale the equation a*x_g + b*y_g = g to a*x + b*y = n.\n    factor = n // g\n    x_p_initial = x_g * factor\n\n    # Normalize x to match typical expected solutions (e.g., smallest non-negative x).\n    # The step for x in the general solution is b/g.\n    x_step = abs(b // g)\n    x_final = x_p_initial % x_step\n\n    # Calculate the corresponding y value for the normalized x.\n    y_final = (n - a * x_final) // b\n\n    return (x_final, y_final)"}
