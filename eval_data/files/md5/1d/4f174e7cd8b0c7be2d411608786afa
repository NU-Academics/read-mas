{"task_id": "Mbpp/125", "solution": "def find_length(binary_string: str) -> int:\n    \"\"\"\n    Calculates the maximum difference between the number of 0s and 1s\n    in any contiguous sub-string of the given binary string.\n    \"\"\"\n    if not binary_string:\n        return 0\n\n    max_so_far = float('-inf')\n    current_max = 0\n\n    for char in binary_string:\n        # Map '0' to 1 and '1' to -1 to find maximum sum of a subarray\n        val = 1 if char == '0' else -1\n\n        # Kadane's algorithm to find the maximum sum of a contiguous subarray\n        current_max = max(val, current_max + val)\n        max_so_far = max(max_so_far, current_max)\n    \n    return max_so_far"}
{"task_id": "Mbpp/129", "solution": "from typing import List\n\ndef magic_square_test(matrix: List[List[int]]) -> bool:\n    \"\"\"\n    Determines if a given 2D matrix is a magic square.\n    A magic square has all rows, columns, and diagonals sum to the same value.\n    \"\"\"\n\n    def _is_square_matrix(matrix: List[List]) -> bool:\n        \"\"\"Checks if the input matrix is square and non-empty.\"\"\"\n        if not matrix or not matrix[0]:\n            return False\n        n = len(matrix)\n        for row in matrix:\n            if len(row) != n:\n                return False\n        return True\n\n    def _calculate_row_sums(matrix: List[List[int]]) -> List[int]:\n        \"\"\"Calculates the sum of elements for each row.\"\"\"\n        return [sum(row) for row in matrix]\n\n    def _calculate_column_sums(matrix: List[List[int]]) -> List[int]:\n        \"\"\"Calculates the sum of elements for each column.\"\"\"\n        n = len(matrix)\n        column_sums = [0] * n\n        for i in range(n):\n            for j in range(n):\n                column_sums[j] += matrix[i][j]\n        return column_sums\n\n    def _calculate_main_diagonal_sum(matrix: List[List[int]]) -> int:\n        \"\"\"Calculates the sum of elements along the main diagonal.\"\"\"\n        n = len(matrix)\n        main_diag_sum = 0\n        for i in range(n):\n            main_diag_sum += matrix[i][i]\n        return main_diag_sum\n\n    def _calculate_anti_diagonal_sum(matrix: List[List[int]]) -> int:\n        \"\"\"Calculates the sum of elements along the anti-diagonal.\"\"\"\n        n = len(matrix)\n        anti_diag_sum = 0\n        for i in range(n):\n            anti_diag_sum += matrix[i][n - 1 - i]\n        return anti_diag_sum\n\n    def _all_sums_equal(sums: List[int]) -> bool:\n        \"\"\"Checks if all sums in a list are equal.\"\"\"\n        if not sums:\n            return True\n        first_sum = sums[0]\n        for s in sums:\n            if s != first_sum:\n                return False\n        return True\n\n    if not _is_square_matrix(matrix):\n        return False\n\n    row_sums = _calculate_row_sums(matrix)\n    column_sums = _calculate_column_sums(matrix)\n    main_diag_sum = _calculate_main_diagonal_sum(matrix)\n    anti_diag_sum = _calculate_anti_diagonal_sum(matrix)\n\n    all_sums = []\n    all_sums.extend(row_sums)\n    all_sums.extend(column_sums)\n    all_sums.append(main_diag_sum)\n    all_sums.append(anti_diag_sum)\n\n    return _all_sums_equal(all_sums)"}
{"task_id": "Mbpp/130", "solution": "import collections\n\nclass FrequencyCounter:\n    \"\"\"Counts item occurrences in a list.\"\"\"\n    def __init__(self):\n        self._frequency_map = {}\n\n    def count_frequencies(self, input_list: list) -> dict:\n        \"\"\"Calculates and returns a frequency map for the given list.\"\"\"\n        self._frequency_map = collections.Counter(input_list)\n        return self._frequency_map\n\n    def get_frequency_map(self) -> dict:\n        \"\"\"Returns the current frequency map.\"\"\"\n        return self._frequency_map\n\nclass MaxFinder:\n    \"\"\"Identifies the item with the maximum frequency from a frequency map.\"\"\"\n    def __init__(self):\n        pass\n\n    def find_max_frequency_item(self, frequency_map: dict):\n        \"\"\"Finds and returns the item with the highest frequency.\"\"\"\n        if not frequency_map:\n            return None # Handle empty frequency map gracefully\n\n        max_item = None\n        max_frequency = -1\n\n        for item, frequency in frequency_map.items():\n            if frequency > max_frequency:\n                max_frequency = frequency\n                max_item = item\n        return max_item\n\n    def get_max_frequency(self, frequency_map: dict) -> int:\n        \"\"\"Returns the maximum frequency count from the frequency map.\"\"\"\n        if not frequency_map:\n            return 0 # No items, so max frequency is 0\n        return max(frequency_map.values())\n\ndef max_occurrences(input_list: list):\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    Utilizes FrequencyCounter to count frequencies and MaxFinder to find the most frequent item.\n    \"\"\"\n    if not input_list:\n        return None # Return None for an empty list\n\n    freq_counter = FrequencyCounter()\n    frequency_map = freq_counter.count_frequencies(input_list)\n\n    max_finder = MaxFinder()\n    most_frequent_item = max_finder.find_max_frequency_item(frequency_map)\n\n    return most_frequent_item"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(input_string: str) -> str:\n    \"\"\"Reverses only the vowels of a given string (where y is not a vowel).\"\"\"\n\n    VOWELS = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\n    def _identify_vowels(text: str) -> tuple[list[str], list[int]]:\n        \"\"\"Extracts vowels and their positions from the input string.\"\"\"\n        found_vowels = []\n        vowel_positions = []\n        for i, char in enumerate(text):\n            if char in VOWELS:\n                found_vowels.append(char)\n                vowel_positions.append(i)\n        return found_vowels, vowel_positions\n\n    def _reverse_vowel_positions(vowels_list: list[str]) -> list[str]:\n        \"\"\"Reverses the order of extracted vowels.\"\"\"\n        return vowels_list[::-1]\n\n    def _reconstruct_string(original: str, reversed_vowels_list: list[str], positions_list: list[int]) -> str:\n        \"\"\"Builds the output string with reversed vowels in original positions.\"\"\"\n        char_list = list(original)\n        for i, pos in enumerate(positions_list):\n            char_list[pos] = reversed_vowels_list[i]\n        return \"\".join(char_list)\n\n    vowels_found, vowel_indices = _identify_vowels(input_string)\n\n    if not vowels_found:\n        return input_string\n\n    reversed_vowels_order = _reverse_vowel_positions(vowels_found)\n    return _reconstruct_string(input_string, reversed_vowels_order, vowel_indices)"}
