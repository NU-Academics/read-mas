{"task_id": "Mbpp/762", "solution": "def check_monthnumber_number(month_number: int) -> bool:\n    \"\"\"\n    Check if given month number has exactly 30 days.\n\n    Args:\n        month_number (int): Month number from 1 to 12\n\n    Returns:\n        bool: True if month has 30 days, False otherwise\n    \"\"\"\n    if not (1 <= month_number <= 12):\n        return False\n    return month_number in (4, 6, 9, 11)"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(array, length):\n    \"\"\"\n    Finds the minimum absolute difference between any two elements in the given array.\n    It compares all unique pairs of elements to determine the smallest difference.\n    \"\"\"\n    if length < 2:\n        # According to the problem context, inputs will be valid.\n        # For an array with less than two elements, a minimum difference between two elements cannot be found.\n        # Returning a large value or raising an error could be options, but problem states not to raise exceptions.\n        # The nested loops below will not execute, leaving min_diff as its initial value.\n        return float('inf') # Or 0, or handle as per specific undefined behavior requirements.\n                            # For the given problem, it's expected length >= 2.\n\n    min_diff = float('inf')\n\n    for i in range(length):\n        for j in range(i + 1, length):\n            diff = abs(array[i] - array[j])\n            if diff < min_diff:\n                min_diff = diff\n\n    return min_diff"}
{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number.\n    A polite number is a positive integer that is not a power of two.\n    \"\"\"\n    def is_power_of_two(num: int) -> bool:\n        \"\"\"Checks if a number is a power of 2.\"\"\"\n        return num > 0 and (num & (num - 1)) == 0\n\n    polite_count = 0\n    current_num = 1\n    while True:\n        if not is_power_of_two(current_num):\n            polite_count += 1\n            if polite_count == n:\n                return current_num\n        current_num += 1"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list, target_sum) -> int:\n    \"\"\"\n    Count pairs of numbers whose sum equals target_sum.\n    This implementation uses a nested loop to check all unique pairs by index.\n    \"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n    return count"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list: list) -> list:\n    \"\"\"\n    Returns a list of all pairs of consecutive items in the given list.\n    Handles empty or single-element lists by returning an empty list.\n    \"\"\"\n    return [(input_list[i], input_list[i+1]) for i in range(len(input_list) - 1)]"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculate sum of fourth powers of first n odd natural numbers.\n    \"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        odd_number = 2 * i - 1\n        total_sum += odd_number ** 4\n    return total_sum"}
{"task_id": "Mbpp/769", "solution": "def Diff(first_list: list, second_list: list) -> list:\n    \"\"\"\n    Calculates the difference between two lists, returning elements from the first list\n    that are not in the second, while preserving their original order.\n    \"\"\"\n    # Convert the second list to a set for efficient O(1) average time complexity lookups.\n    second_list_set = set(second_list)\n    \n    # Initialize an empty list to store the elements unique to first_list, maintaining order.\n    result = []\n    \n    # Iterate through each element in the first list.\n    for item in first_list:\n        # If the element is not found in the set of the second list, add it to the result.\n        if item not in second_list_set:\n            result.append(item)\n            \n    return result"}
{"task_id": "Mbpp/772", "solution": "def split_words(text: str) -> list[str]:\n    \"\"\"Split text into words using whitespace as separators.\"\"\"\n    return text.split()\n\ndef filter_by_length(words: list[str], length: int) -> list[str]:\n    \"\"\"Filter out words that have exactly 'length' characters.\"\"\"\n    return [word for word in words if len(word) != length]\n\ndef join_words(words: list[str]) -> str:\n    \"\"\"Join words with single spaces and trim whitespace.\"\"\"\n    return ' '.join(words)\n\ndef remove_length(input_string: str, k: int) -> str:\n    \"\"\"Remove all words with exactly k characters from input string.\"\"\"\n    words = split_words(input_string)\n    filtered_words = filter_by_length(words, k)\n    result_string = join_words(filtered_words)\n    return result_string"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(source_string: str, search_substring: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Finds the first occurrence of a substring within a string.\n    Returns a tuple (substring, start_position, end_position) or None if no match.\n    \"\"\"\n    if not source_string:\n        return None\n\n    start_index = source_string.find(search_substring)\n\n    if start_index == -1:\n        return None\n    else:\n        end_index = start_index + len(search_substring)\n        return (search_substring, start_index, end_index)"}
{"task_id": "Mbpp/775", "solution": "from typing import List\n\ndef odd_position(input_list: List[int]) -> bool:\n    \"\"\"\n    Checks if every odd index in the list contains an odd number.\n    Returns True for empty lists or lists with one element.\n    \"\"\"\n    if len(input_list) <= 1:\n        return True\n\n    for i in range(1, len(input_list), 2):\n        if input_list[i] % 2 == 0:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/777", "solution": "def find_sum(input_list):\n    \"\"\"\n    Calculate the sum of non-repeated elements in a list.\n\n    Args:\n        input_list (list): List of integers\n\n    Returns:\n        int: Sum of elements that appear exactly once\n    \"\"\"\n    element_counts = {}\n    for item in input_list:\n        element_counts[item] = element_counts.get(item, 0) + 1\n\n    total_sum = 0\n    for element, count in element_counts.items():\n        if count == 1:\n            total_sum += element\n    \n    return total_sum"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets.\n    Supports parentheses, square brackets, and curly braces.\n    \"\"\"\n    stack = []\n    \n    opening_brackets = \"({[\"\n    closing_brackets = \")}]\"\n    bracket_map = {\")\": \"(\", \"}\": \"{\", \"]\": \"[\"}\n\n    for char in expression:\n        if char in opening_brackets:\n            stack.append(char)\n        elif char in closing_brackets:\n            if not stack:\n                return False  # Closing bracket without a matching opening bracket\n            \n            last_opening_bracket = stack.pop()\n            if bracket_map[char] != last_opening_bracket:\n                return False  # Mismatched opening and closing brackets\n        # Non-bracket characters are ignored as per design context\n\n    return not stack # True if stack is empty (all brackets matched), False otherwise"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks if the count of divisors for a given integer n is even.\n    This function calculates the number of divisors and returns True if the count is even, False otherwise.\n    \"\"\"\n    count = 0\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count % 2 == 0"}
{"task_id": "Mbpp/780", "solution": "import itertools\n\ndef find_combinations(tuple_list):\n    \"\"\"\n    Finds all pairwise combinations of tuples in the given list and computes their element-wise sums.\n    Results are returned in a sorted order to ensure consistency.\n    \"\"\"\n    if not tuple_list:\n        return []\n\n    # Generate all unique pairwise combinations\n    # Using combinations instead of product to avoid (A, B) and (B, A) and (A, A)\n    # The requirement example implies combinations where A and B can be the same tuple instance from the input list,\n    # but (A,B) and (B,A) are not both present. It seems to imply `itertools.combinations_with_replacement`\n    # if it's combinations of indices, or just `itertools.combinations` if it's combinations of distinct tuple values.\n    # Given the example `[(2, 4), (6, 7), (5, 1), (6, 10)]`, the output `(8, 14)` from `(2,4)` and `(6,10)` means it should be `combinations`.\n    # However, `(8, 11)` means `(2,4) + (6,7)`. If (6,7) and (6,7) were combined, it'd be (12,14)\n    # The example result `[(8, 11), (7, 5), (8, 14), (11, 8), (12, 17), (11, 11)]` indicates combinations without replacement.\n    # E.g., for `[(2,4), (6,7)]` the result is `(8,11)`. The output only includes 6 results for 4 input tuples, `4C2 = 6`.\n    # This clearly indicates `itertools.combinations`.\n    \n    combinations = itertools.combinations(tuple_list, 2)\n\n    results = []\n    for t1, t2 in combinations:\n        sum_tuple = (t1[0] + t2[0], t1[1] + t2[1])\n        results.append(sum_tuple)\n\n    # Sort results for consistent, deterministic order\n    # The example output is sorted first by the first element, then by the second.\n    results.sort()\n    return results"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list):\n    \"\"\"\n    Packs consecutive duplicates of list elements into sublists.\n    Processes the list in a single pass to group elements efficiently.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = []\n    current_group = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] == current_group[0]:\n            current_group.append(input_list[i])\n        else:\n            result.append(current_group)\n            current_group = [input_list[i]]\n\n    result.append(current_group) # Append the last group\n    return result"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(array):\n    \"\"\"\n    Calculates the sum of all odd-length subarrays from the input array.\n    This function utilizes helper functions for clarity and modularity.\n    \"\"\"\n    def _generate_subarrays(arr):\n        \"\"\"Generates all contiguous subarrays of the given array.\"\"\"\n        subarrays = []\n        n = len(arr)\n        for i in range(n):\n            for j in range(i, n):\n                subarrays.append(arr[i : j + 1])\n        return subarrays\n\n    def _is_odd_length(length):\n        \"\"\"Checks if a given length is an odd number.\"\"\"\n        return length % 2 != 0\n\n    def _calculate_subarray_sum(subarray):\n        \"\"\"Calculates the sum of elements in a given subarray.\"\"\"\n        return sum(subarray)\n\n    total_sum = 0\n    all_subarrays = _generate_subarrays(array)\n\n    for subarray in all_subarrays:\n        if _is_odd_length(len(subarray)):\n            total_sum += _calculate_subarray_sum(subarray)\n\n    return total_sum"}
