{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists):\n    \"\"\"\n    Finds the length of the smallest list in a list of lists.\n    Initializes min_length to infinity and iterates through sublists to find the minimum length.\n    \"\"\"\n    min_length = float('inf')\n    for sublist in list_of_lists:\n        current_length = len(sublist)\n        if current_length < min_length:\n            min_length = current_length\n    return int(min_length)"}
{"task_id": "Mbpp/92", "solution": "def extract_digits(number: int) -> list[int]:\n    \"\"\"Converts an integer to a list of its individual digits.\"\"\"\n    return [int(d) for d in str(abs(number))]\n\ndef has_minimum_digits(digits: list[int]) -> bool:\n    \"\"\"Checks if the number of digits is at least 3.\"\"\"\n    return len(digits) >= 3\n\ndef has_exactly_two_unique_digits(digits: list[int]) -> bool:\n    \"\"\"Checks if there are exactly two unique digits in the number.\"\"\"\n    return len(set(digits)) == 2\n\ndef check_alternating_pattern(digits: list[int]) -> bool:\n    \"\"\"Verifies that digits alternate strictly between two values.\"\"\"\n    # An undulating number must alternate between two *different* digits.\n    # So, the first two digits (if they exist) must be different.\n    if len(digits) < 2 or digits[0] == digits[1]:\n        return False\n        \n    for i in range(2, len(digits)):\n        if digits[i] != digits[i - 2]:\n            return False\n    return True\n\ndef is_undulating(number: int) -> bool:\n    \"\"\"Checks if the given number is undulating (alternating between exactly two different digits with minimum 3 digits).\"\"\"\n    digits = extract_digits(number)\n\n    if not has_minimum_digits(digits):\n        return False\n\n    if not has_exactly_two_unique_digits(digits):\n        return False\n\n    return check_alternating_pattern(digits)"}
{"task_id": "Mbpp/91", "solution": "def find_substring(string_list, search_string):\n    \"\"\"\n    Checks if a search_string is present as a substring in any element of string_list.\n    Returns True on the first match, False otherwise.\n    \"\"\"\n    if not string_list:\n        return False\n    \n    if not search_string:\n        # As per design: an empty string is considered a substring if the list itself is not empty.\n        return True\n\n    for s in string_list:\n        if search_string in s:\n            return True\n    return False"}
{"task_id": "Mbpp/94", "solution": "from typing import List, Tuple, Any\n\ndef index_minimum(tuple_list: List[Tuple]) -> Any:\n    \"\"\"\n    Returns the first value of the tuple with the smallest second value.\n    If multiple tuples share the smallest second value, the first encountered tuple's first value is returned.\n    \"\"\"\n    min_value = float('inf')\n    min_tuple = None\n\n    for current_tuple in tuple_list:\n        # The design context indicates tuples will have at least two elements.\n        if current_tuple[1] < min_value:\n            min_value = current_tuple[1]\n            min_tuple = current_tuple\n    \n    # Based on design context, tuple_list is assumed non-empty and min_tuple will be set.\n    return min_tuple[0]"}
{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"\n    Calculate the number of divisors of a given integer.\n    This implementation iterates up to the square root of n for efficiency.\n    \"\"\"\n    count = 0\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count"}
{"task_id": "Mbpp/97", "solution": "def _flatten_lists(list_of_lists):\n    \"\"\"\n    Flattens a list of lists into a single list.\n    Iterates through each sublist and extends the result list with its elements.\n    \"\"\"\n    flattened = []\n    for sublist in list_of_lists:\n        flattened.extend(sublist)\n    return flattened\n\ndef _count_frequencies(flattened_list):\n    \"\"\"\n    Counts the occurrences of each element in a flattened list.\n    Uses a dictionary to store and increment frequency counts for each element.\n    \"\"\"\n    frequency_dict = {}\n    for element in flattened_list:\n        frequency_dict[element] = frequency_dict.get(element, 0) + 1\n    return frequency_dict\n\ndef frequency_lists(list_of_lists):\n    \"\"\"\n    Finds the frequency of each element in a flattened list of lists.\n    Returns a dictionary where keys are elements and values are their frequencies.\n    \"\"\"\n    flattened_elements = _flatten_lists(list_of_lists)\n    element_frequencies = _count_frequencies(flattened_elements)\n    return element_frequencies"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(numbers):\n    \"\"\"\n    Multiplies all numbers in a list or tuple and divides by its length.\n    \"\"\"\n    if not numbers:\n        return 0.0 # Or raise an error, but the prompt says not to add error handling. Returning 0.0 is a reasonable default for an empty list's product, leading to 0.0/0 which isn't well-defined. However, the problem statement implies numbers are present. Let's assume non-empty for simplicity.\n\n    product = 1\n    for num in numbers:\n        product *= num\n\n    length = len(numbers)\n    # The problem implies non-empty lists where length > 0, avoiding division by zero.\n    result = product / length\n    return float(result)"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"Convert decimal number to binary string without leading zeros.\"\"\"\n    if decimal_number == 0:\n        return '0'\n    \n    # Use built-in bin() function which returns a string prefixed with \"0b\"\n    binary_string = bin(decimal_number)\n    \n    # Remove the \"0b\" prefix.\n    # The slice [2:] effectively removes the first two characters.\n    result = binary_string[2:]\n    \n    return result"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome number greater than the given integer.\n    \"\"\"\n    def is_palindrome(num: int) -> bool:\n        \"\"\"\n        Checks if a given integer is a palindrome.\n        \"\"\"\n        s_num = str(num)\n        return s_num == s_num[::-1]\n\n    current_num = n + 1\n    while True:\n        if is_palindrome(current_num):\n            return current_num\n        current_num += 1"}
