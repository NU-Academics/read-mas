{"task_id": "Mbpp/20", "solution": "def _calculate_woodall_value(n: int) -> int:\n    \"\"\"Calculates the Woodall number for a given positive integer n.\"\"\"\n    return n * (2**n) - 1\n\ndef _find_woodall_n(target: int) -> int | None:\n    \"\"\"\n    Finds the 'n' value that produces the target Woodall number, if it exists.\n    Returns n if target is a Woodall number, None otherwise.\n    \"\"\"\n    if target < 1:\n        return None\n\n    n = 1\n    while True:\n        calculated_woodall = _calculate_woodall_value(n)\n        if calculated_woodall == target:\n            return n\n        elif calculated_woodall > target:\n            return None\n        n += 1\n\ndef is_woodall(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is a Woodall number.\n    A Woodall number is of the form n * 2^n - 1 for a positive integer n.\n    \"\"\"\n    if number < 1:\n        return False\n    \n    return _find_woodall_n(number) is not None"}
{"task_id": "Mbpp/18", "solution": "def create_filter_set(filter_chars: str) -> set:\n    \"\"\"Creates a set of characters from a string for efficient lookup.\"\"\"\n    return set(filter_chars)\n\ndef apply_filter(source_string: str, filter_set: set) -> str:\n    \"\"\"Builds a new string by excluding characters present in the filter set.\"\"\"\n    result_chars = []\n    for char in source_string:\n        if char not in filter_set:\n            result_chars.append(char)\n    return \"\".join(result_chars)\n\ndef remove_dirty_chars(source_string: str, filter_chars: str) -> str:\n    \"\"\"\n    Removes characters from the first string that are present in the second string.\n    The order of the remaining characters is preserved.\n    \"\"\"\n    filter_set = create_filter_set(filter_chars)\n    filtered_string = apply_filter(source_string, filter_set)\n    return filtered_string"}
