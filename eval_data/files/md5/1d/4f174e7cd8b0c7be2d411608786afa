{"task_id": "Mbpp/797", "solution": "def sum_in_range(l, r):\n    \"\"\"\n    Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n    Natural numbers are considered to be positive integers (1, 2, 3, ...).\n    \"\"\"\n    total_sum = 0\n    for num in range(l, r + 1):\n        if num >= 1 and num % 2 != 0:\n            total_sum += num\n    return total_sum"}
{"task_id": "Mbpp/798", "solution": "def _sum(array):\n    \"\"\"\n    Calculates the sum of all numeric elements in a given array.\n    \"\"\"\n    return sum(array)"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(number: int, d: int) -> int:\n    \"\"\"\n    Rotates the bits of a 32-bit number to the left by d positions.\n    Bits shifted out from the left re-enter from the right.\n    \"\"\"\n    BITS = 32\n    # Ensure d is within the range [0, BITS-1] for effective rotation\n    # Rotating by BITS bits is equivalent to rotating by 0 bits.\n    d_effective = d % BITS\n\n    # Part 1: Bits that remain within the 32-bit window after shifting left.\n    # We apply a mask to keep only the lower 32 bits, discarding any overflow.\n    left_shifted_part = (number << d_effective) & ((1 << BITS) - 1)\n\n    # Part 2: Bits that wrap around from the most significant end to the least significant end.\n    # These are the bits that would have been shifted out from the left.\n    wrapped_around_part = (number >> (BITS - d_effective))\n\n    # Combine the two parts using a bitwise OR operation.\n    return left_shifted_part | wrapped_around_part"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"\n    Count the number of equal values among three integers.\n    Returns 3 if all three are equal, 2 if exactly two are equal, and 0 otherwise.\n    \"\"\"\n    if a == b == c:\n        return 3\n    elif a == b or a == c or b == c:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/803", "solution": "import math\n\ndef is_perfect_square(number):\n    \"\"\"\n    Determines if the given number is a perfect square.\n    Returns True if number is perfect square, False otherwise.\n    \"\"\"\n    if number < 0:\n        return False\n    \n    # Calculate the square root\n    sqrt_val = math.sqrt(number)\n    \n    # Check if the square root is an integer\n    return sqrt_val % 1 == 0"}
{"task_id": "Mbpp/807", "solution": "def first_odd(numbers: list) -> int:\n    \"\"\"\n    Find and return the first odd number in the given list.\n    \"\"\"\n    for number in numbers:\n        if number % 2 != 0:\n            return number"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Finds the maximum run of consecutive uppercase characters in a string.\n    Iterates through the string once, tracking current and maximum runs.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in input_string:\n        if char.isupper():\n            current_run += 1\n            max_run = max(max_run, current_run)\n        else:\n            current_run = 0\n    return max_run"}
{"task_id": "Mbpp/808", "solution": "def check_K(input_tuple, k):\n    \"\"\"\n    Checks if the value k is present in the given tuple.\n    It performs a linear search through the tuple elements.\n    \"\"\"\n    for element in input_tuple:\n        if element == k:\n            return True\n    return False"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(list_of_lists):\n    \"\"\"\n    Returns the list with the highest sum of elements.\n\n    Args:\n        list_of_lists: List[List[Number]] - A list containing sublists of numeric elements\n\n    Returns:\n        List[Number] - The inner list with the maximum sum of elements\n    \"\"\"\n    return max(list_of_lists, key=sum)"}
{"task_id": "Mbpp/804", "solution": "from typing import List, Union\n\ndef is_product_even(numbers: List[Union[int, float]]) -> bool:\n    \"\"\"\n    Check whether the product of numbers in a list is even.\n\n    Args:\n        numbers: List of numeric values (int or float)\n\n    Returns:\n        bool: True if product is even, False if odd\n    \"\"\"\n    if not numbers:\n        return False\n\n    for num in numbers:\n        if num == 0:\n            return True # Product will be 0, which is even.\n        if num % 2 == 0:\n            return True # An even factor makes the entire product even.\n\n    # If no 0 or even number was found, all numbers must be odd (or non-whole floats).\n    # The product of odd numbers is odd.\n    return False"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(tuple1: tuple, tuple2: tuple) -> bool:\n    \"\"\"\n    Checks if each element of the second tuple is strictly smaller than its corresponding element in the first tuple.\n    Returns False immediately if any element in tuple2 is not smaller than its counterpart in tuple1.\n    \"\"\"\n    for elem1, elem2 in zip(tuple1, tuple2):\n        if elem2 >= elem1:\n            return False\n    return True"}
