{"task_id": "Mbpp/245", "solution": "import math\n\ndef max_sum(array: list) -> int:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence in the given array.\n    A bitonic subsequence is first increasing and then decreasing.\n    \"\"\"\n    n = len(array)\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return array[0]\n\n    # Calculate increasing subsequence sums ending at each position\n    inc_sum = [array[i] for i in range(n)]\n    for i in range(1, n):\n        for j in range(i):\n            if array[i] > array[j]:\n                inc_sum[i] = max(inc_sum[i], inc_sum[j] + array[i])\n\n    # Calculate decreasing subsequence sums starting at each position\n    dec_sum = [array[i] for i in range(n)]\n    for i in range(n - 2, -1, -1):\n        for j in range(n - 1, i, -1):\n            if array[i] > array[j]:\n                dec_sum[i] = max(dec_sum[i], dec_sum[j] + array[i])\n\n    # Combine increasing and decreasing sums to find bitonic sums\n    # A bitonic subsequence must have at least one element, which acts as the peak.\n    # The peak element is counted twice if we simply add inc_sum[i] + dec_sum[i].\n    # So, we subtract array[i] to count it only once.\n    max_bitonic_sum = 0\n    for i in range(n):\n        current_bitonic_sum = inc_sum[i] + dec_sum[i] - array[i]\n        max_bitonic_sum = max(max_bitonic_sum, current_bitonic_sum)\n\n    return max_bitonic_sum"}
{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"\n    Calculates the length of the longest palindromic subsequence in the given string.\n    Uses dynamic programming for optimal performance.\n    \"\"\"\n\n    def _validate_input(s_input: any) -> bool:\n        \"\"\"Validates if the input is a string.\"\"\"\n        return isinstance(s_input, str)\n\n    def _handle_edge_cases(s_input: str) -> int | None:\n        \"\"\"Handles empty and single-character strings.\"\"\"\n        n = len(s_input)\n        if n == 0:\n            return 0\n        if n == 1:\n            return 1\n        return None\n\n    def _compute_lps_dp(s_input: str) -> int:\n        \"\"\"Core dynamic programming algorithm for LPS calculation.\"\"\"\n        n = len(s_input)\n        \n        # dp[i][j] stores the length of the longest palindromic subsequence\n        # of the substring s[i...j]\n        dp = [[0] * n for _ in range(n)]\n\n        # Every single character is a palindrome of length 1\n        for i in range(n):\n            dp[i][i] = 1\n\n        # Fill the dp table for gaps (lengths) from 2 to n\n        for length in range(2, n + 1):\n            for i in range(n - length + 1):\n                j = i + length - 1\n                if s_input[i] == s_input[j]:\n                    if length == 2:\n                        dp[i][j] = 2\n                    else:\n                        dp[i][j] = 2 + dp[i + 1][j - 1]\n                else:\n                    dp[i][j] = max(dp[i][j - 1], dp[i + 1][j])\n        \n        return dp[0][n - 1]\n\n    # Main logic of the lps function\n    if not _validate_input(s):\n        # As per design context, no exception raising for invalid input type\n        # The assert in the problem description implies input will be a string.\n        # Returning 0 or handling as per specific requirement if not a string.\n        # For now, following the spirit of \"no isinstance() checks\" in the requirements\n        # which means we assume the input is always a string as per `s: str` type hint.\n        pass \n\n    edge_case_result = _handle_edge_cases(s)\n    if edge_case_result is not None:\n        return edge_case_result\n    \n    return _compute_lps_dp(s)"}
{"task_id": "Mbpp/252", "solution": "import math\nfrom typing import Union, Tuple\n\ndef convert(input: Union[int, float, complex]) -> Tuple[float, float]:\n    \"\"\"Convert complex number to polar coordinates.\n\n    Args:\n        input: Complex number, real number, or integer to convert.\n\n    Returns:\n        Tuple of (magnitude, angle_in_radians).\n    \"\"\"\n    complex_num = complex(input)\n    real_part = complex_num.real\n    imaginary_part = complex_num.imag\n\n    magnitude = math.sqrt(real_part**2 + imaginary_part**2)\n    angle = math.atan2(imaginary_part, real_part)\n\n    return (magnitude, angle)"}
