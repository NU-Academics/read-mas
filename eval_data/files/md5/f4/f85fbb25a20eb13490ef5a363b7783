{"task_id": "HumanEval/39", "solution": "import math\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\n\nclass PrimeChecker:\n    def is_prime(self, num: int) -> bool:\n        \"\"\"Determines if the input num is a prime number using trial division up to its square root.\"\"\"\n        if num < 2:\n            return False\n        i = 2\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 1\n        return True\n\nclass FibonacciGenerator:\n    def generate(self):\n        \"\"\"Returns a generator that yields Fibonacci numbers (0, 1, 1, 2, 3, 5, ...).\"\"\"\n        a, b = 0, 1\n        yield a\n        yield b\n        while True:\n            next_fib = a + b\n            a = b\n            b = next_fib\n            yield next_fib\n\nclass PrimeFibService:\n    def __init__(self, prime_checker: PrimeChecker, fibonacci_generator: FibonacciGenerator):\n        self.prime_checker = prime_checker\n        self.fibonacci_generator = fibonacci_generator\n\n    def find_nth_prime_fib(self, n: int) -> int:\n        \"\"\"Finds and returns the n-th number that is both a Fibonacci number and a prime.\"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n\n        fib_gen = self.fibonacci_generator.generate()\n        prime_fib_count = 0\n\n        # Advance generator past 0 and 1 (F(0), F(1)) and the first F(2)=1\n        next(fib_gen) # 0\n        next(fib_gen) # 1\n        next(fib_gen) # 1\n\n        while True:\n            current_fib = next(fib_gen)\n            if self.prime_checker.is_prime(current_fib):\n                prime_fib_count += 1\n                if prime_fib_count == n:\n                    return current_fib\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    service = PrimeFibService(PrimeChecker(), FibonacciGenerator())\n    return service.find_nth_prime_fib(n)"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    seen_numbers = set()\n    for num in l:\n        complement = -num\n        if complement in seen_numbers:\n            # If the complement is found, we have two distinct elements that sum to zero.\n            # This covers cases like (5, -5) and (0, 0) where '0' was seen earlier.\n            return True\n        seen_numbers.add(num)\n    return False"}
{"task_id": "HumanEval/44", "solution": "class InvalidBaseError(ValueError):\n    \"\"\"Custom exception for invalid base values.\"\"\"\n    pass\n\nclass InvalidNumberError(ValueError):\n    \"\"\"Custom exception for invalid number values (e.g., negative).\"\"\"\n    pass\n\nclass BaseConverter:\n    \"\"\"Encapsulates the logic for converting a base-10 integer to a specified base (2-9).\"\"\"\n    def __init__(self, x: int, base: int) -> None:\n        self._validate_inputs(x, base)\n        self._x = x\n        self._base = base\n\n    def _validate_inputs(self, x: int, base: int) -> None:\n        if not isinstance(x, int) or x < 0:\n            raise InvalidNumberError(\"Input number 'x' must be a non-negative integer.\")\n        if not isinstance(base, int) or not (2 <= base <= 9):\n            raise InvalidBaseError(\"Base must be an integer between 2 and 9, inclusive.\")\n\n    def convert(self) -> str:\n        \"\"\"Performs the base conversion and returns the result as a string.\"\"\"\n        if self._x == 0:\n            return \"0\"\n\n        result = []\n        n = self._x\n        while n > 0:\n            remainder = n % self._base\n            result.append(str(remainder))\n            n //= self._base\n        return \"\".join(result[::-1])\n\ndef change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    converter = BaseConverter(x, base)\n    return converter.convert()"}
