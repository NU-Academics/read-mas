{"task_id": "HumanEval/55", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input to Fibonacci functions.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nMAX_FIB_N = 92 # Max n for fibonacci that fits in a 64-bit signed integer\n\ndef fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if n < 0:\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n    if n > MAX_FIB_N:\n        # This limit prevents integer overflow for standard 64-bit types.\n        raise ValueError(f\"Input 'n' exceeds practical limit of {MAX_FIB_N} for standard integer types.\")\n\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    else:\n        a, b = 0, 1\n        for _ in range(2, n + 1):\n            a, b = b, a + b\n        return b"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\"\"\"\n    largest_factor = 1\n    d = 2\n    temp_n = n\n\n    while d * d <= temp_n:\n        if temp_n % d == 0:\n            largest_factor = d\n            while temp_n % d == 0:\n                temp_n //= d\n        d += 1\n\n    if temp_n > 1:\n        largest_factor = temp_n\n\n    return largest_factor"}
