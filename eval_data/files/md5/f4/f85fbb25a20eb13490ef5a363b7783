{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n\n    \"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n    common_set = set1.intersection(set2)\n    return sorted(list(common_set))"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\"\"\"\n    if len(l) <= 1:\n        return True\n\n    def _is_increasing(lst: list) -> bool:\n        \"\"\"Checks if the list is monotonically non-decreasing.\"\"\"\n        for i in range(len(lst) - 1):\n            if lst[i] > lst[i+1]:\n                return False\n        return True\n\n    def _is_decreasing(lst: list) -> bool:\n        \"\"\"Checks if the list is monotonically non-increasing.\"\"\"\n        for i in range(len(lst) - 1):\n            if lst[i] < lst[i+1]:\n                return False\n        return True\n\n    return _is_increasing(l) or _is_decreasing(l)"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    derived_coeffs = []\n    # The derivative of c * x^n is c * n * x^(n-1).\n    # The constant term xs[0] differentiates to 0 and is dropped.\n    # The coefficient for x^i is xs[i], and its derivative contributes\n    # xs[i] * i to the (i-1)-th term of the derivative polynomial.\n    for i in range(1, len(xs)):\n        derived_coeffs.append(xs[i] * i)\n    \n    return derived_coeffs"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    count = 0\n    for char in brackets:\n        if char == '(':\n            count += 1\n        elif char == ')':\n            count -= 1\n        \n        # If count drops below zero, a closing bracket appeared without a matching open bracket\n        if count < 0:\n            return False\n            \n    # For correct bracketing, the final count must be zero\n    return count == 0"}
