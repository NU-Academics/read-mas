{"task_id": "HumanEval/136", "solution": "from typing import List, Optional, Tuple\n\ndef largest_smallest_integers(lst: List[int]) -> Tuple[Optional[int], Optional[int]]:\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n\n    Examples:\n    largest_smallest_integers([2, 4, 1, 3, 5, 7]) == (None, 1)\n    largest_smallest_integers([]) == (None, None)\n    largest_smallest_integers([0]) == (None, None)\n    '''\n    largest_negative: Optional[int] = None\n    smallest_positive: Optional[int] = None\n\n    for num in lst:\n        if num < 0:\n            if largest_negative is None or num > largest_negative:\n                largest_negative = num\n        elif num > 0:\n            if smallest_positive is None or num < smallest_positive:\n                smallest_positive = num\n    \n    return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Create a function that takes a string as input which contains only square brackets.\n    The function should return True if and only if there is a valid subsequence of brackets \n    where at least one bracket in the subsequence is nested.\n    '''\n    open_brackets_count = 0\n    has_seen_two_open = False\n\n    for char in string:\n        if char == '[':\n            open_brackets_count += 1\n            if open_brackets_count >= 2:\n                has_seen_two_open = True\n        elif char == ']':\n            if open_brackets_count > 0:\n                open_brackets_count -= 1\n                # If we've seen at least two open brackets and we're closing one,\n                # it means nesting occurred.\n                if has_seen_two_open:\n                    return True\n    return False"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    def _factorial(k):\n        \"\"\"Calculates the standard factorial of a non-negative integer k.\"\"\"\n        res = 1\n        for x in range(1, k + 1):\n            res *= x\n        return res\n\n    special_fact_result = 1\n    for i in range(1, n + 1):\n        special_fact_result *= _factorial(i)\n    return special_fact_result"}
{"task_id": "HumanEval/137", "solution": "from typing import Union, Optional\n\ndef compare_one(a, b):\n    \"\"\"\n    Compares two values (int, float, or string representing real numbers)\n    and returns the larger one in its original type, or None if equal.\n    \"\"\"\n\n    def _to_numeric(value: Union[int, float, str]) -> Optional[float]:\n        \"\"\"Converts the input value to a float, handling string formats and returning None on failure.\"\"\"\n        if isinstance(value, (int, float)):\n            return float(value)\n        elif isinstance(value, str):\n            try:\n                # Normalize comma to period for float conversion\n                normalized_value = value.replace(',', '.')\n                return float(normalized_value)\n            except ValueError:\n                return None\n        return None\n\n    numeric_a = _to_numeric(a)\n    numeric_b = _to_numeric(b)\n\n    # If either value could not be converted to a comparable number, return None\n    if numeric_a is None or numeric_b is None:\n        return None\n\n    if numeric_a > numeric_b:\n        return a\n    elif numeric_b > numeric_a:\n        return b\n    else: # numeric_a == numeric_b\n        return None"}
{"task_id": "HumanEval/129", "solution": "from typing import List, Tuple, Optional\n\n# Type aliases for better readability and type hinting.\nGrid = List[List[int]]\nPath = List[int]\n\nclass GridUtils:\n    \"\"\"Provides static utility methods for grid operations.\"\"\"\n    @staticmethod\n    def is_valid(r: int, c: int, N: int) -> bool:\n        \"\"\"Checks if the given coordinates are within the N x N grid boundaries.\"\"\"\n        return 0 <= r < N and 0 <= c < N\n\n    @staticmethod\n    def get_neighbors(r: int, c: int, N: int) -> List[Tuple[int, int]]:\n        \"\"\"Returns a list of valid (row, col) tuples for cells that share an edge with (r, c).\"\"\"\n        neighbors = []\n        directions = [(0, 1), (0, -1), (1, 0), (-1, 0)] # Right, Left, Down, Up\n        for dr, dc in directions:\n            nr, nc = r + dr, c + dc\n            if GridUtils.is_valid(nr, nc, N):\n                neighbors.append((nr, nc))\n        return neighbors\n\nclass MinPathFinderService:\n    \"\"\"Encapsulates the dynamic programming algorithm to find the lexicographically smallest path.\"\"\"\n    def __init__(self, grid: Grid, k: int):\n        self._grid = grid\n        self._N = len(grid)\n        self._k = k\n        # _dp[length][row][col] stores the lexicographically smallest Path of 'length' ending at (row, col).\n        self._dp: List[List[List[Optional[Path]]]] = []\n\n    def find_min_path(self) -> Path:\n        \"\"\"Orchestrates the path-finding process and returns the overall minimum path.\"\"\"\n        self._initialize_dp()\n        self._fill_dp_table()\n        return self._get_overall_min_path()\n\n    def _initialize_dp(self) -> None:\n        \"\"\"Initializes the DP table, setting base cases for paths of length 1.\"\"\"\n        self._dp = [[[None for _ in range(self._N)] for _ in range(self._N)] for _ in range(self._k + 1)]\n\n        # Base case: paths of length 1 simply contain the value of the starting cell.\n        for r in range(self._N):\n            for c in range(self._N):\n                self._dp[1][r][c] = [self._grid[r][c]]\n\n    def _fill_dp_table(self) -> None:\n        \"\"\"Fills the DP table iteratively for path lengths from 2 up to k.\"\"\"\n        for l in range(2, self._k + 1):\n            for r in range(self._N):\n                for c in range(self._N):\n                    current_cell_value = self._grid[r][c]\n                    min_path_for_current_cell: Optional[Path] = None\n\n                    # To find the min path of length 'l' ending at (r,c),\n                    # consider paths of length 'l-1' ending at any neighbor (nr, nc) of (r,c).\n                    for nr, nc in GridUtils.get_neighbors(r, c, self._N):\n                        prev_path = self._dp[l-1][nr][nc]\n                        if prev_path is not None:\n                            # Form a candidate path by extending the previous path with the current cell's value.\n                            candidate_path = prev_path + [current_cell_value]\n                            if min_path_for_current_cell is None or \\\n                               self._is_lexicographically_smaller(candidate_path, min_path_for_current_cell):\n                                min_path_for_current_cell = candidate_path\n                    self._dp[l][r][c] = min_path_for_current_cell\n\n    def _get_overall_min_path(self) -> Path:\n        \"\"\"Retrieves the lexicographically smallest path of length k from the completed DP table.\"\"\"\n        overall_min_path: Optional[Path] = None\n        for r in range(self._N):\n            for c in range(self._N):\n                path_at_end_cell = self._dp[self._k][r][c]\n                if path_at_end_cell is not None:\n                    if overall_min_path is None or \\\n                       self._is_lexicographically_smaller(path_at_end_cell, overall_min_path):\n                        overall_min_path = path_at_end_cell\n        return overall_min_path\n\n    def _is_lexicographically_smaller(self, path1: Path, path2: Path) -> bool:\n        \"\"\"Compares two paths lexicographically.\"\"\"\n        return path1 < path2\n\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k,\n    find the minimum path of length k in the grid.\n    \"\"\"\n    finder = MinPathFinderService(grid, k)\n    return finder.find_min_path()"}
{"task_id": "HumanEval/140", "solution": "import re\n\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \"\"\"\n    # Rule 1: Replace 3 or more consecutive spaces with a single hyphen\n    fixed_text = re.sub(r'\\s{3,}', '-', text)\n\n    # Rule 2: Replace any remaining single spaces (including original two-space sequences) with underscores\n    fixed_text = re.sub(r'\\s', '_', fixed_text)\n\n    return fixed_text"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, keeping only those with prime lengths.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a given integer n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    words = sentence.split(' ')\n    filtered_words = []\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n    return ' '.join(filtered_words)"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions \n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from \n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n    # Condition 1: There should not be more than three digits.\n    digit_count = sum(1 for char in file_name if char.isdigit())\n    if digit_count > 3:\n        return 'No'\n\n    # Condition 2: The file's name contains exactly one dot.\n    if file_name.count('.') != 1:\n        return 'No'\n\n    parts = file_name.split('.', 1)\n    prefix = parts[0]\n    extension = parts[1]\n\n    # Condition 3: The substring before the dot should not be empty,\n    # and it starts with a letter from the latin alphabet.\n    if not prefix:\n        return 'No'\n    if not prefix[0].isalpha():\n        return 'No'\n\n    # Condition 4: The substring after the dot should be one of these.\n    allowed_extensions = ['txt', 'exe', 'dll']\n    if extension not in allowed_extensions:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    processed_elements = []\n    for i, x in enumerate(lst):\n        if i % 3 == 0:\n            processed_elements.append(x * x)\n        elif i % 4 == 0:\n            processed_elements.append(x * x * x)\n        else:\n            processed_elements.append(x)\n    \n    return sum(processed_elements)"}
{"task_id": "HumanEval/145", "solution": "from dataclasses import dataclass\nfrom typing import List\n\ndef calculate_digit_sum(num: int) -> int:\n    \"\"\"Calculates the sum of the absolute digits of an integer.\"\"\"\n    s = 0\n    abs_num = abs(num)\n    if abs_num == 0:\n        return 0\n    while abs_num > 0:\n        s += abs_num % 10\n        abs_num //= 10\n    return s\n\n@dataclass(order=True)\nclass NumberedInteger:\n    \"\"\"Holds an integer, its original index, and its digit sum for custom sorting.\"\"\"\n    digit_sum: int\n    original_index: int\n    value: int\n\ndef order_by_points(nums: List[int]) -> List[int]:\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    Note: if there are several items with similar sum of their digits,\n    order them based on their index in original list.\n    \"\"\"\n    if not nums:\n        return []\n\n    numbered_integers = []\n    for i, num in enumerate(nums):\n        digit_sum = calculate_digit_sum(num)\n        numbered_integers.append(NumberedInteger(digit_sum=digit_sum, original_index=i, value=num))\n\n    sorted_numbered_integers = sorted(numbered_integers)\n\n    return [ni.value for ni in sorted_numbered_integers]"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Counts numbers in the array that are greater than 10 and have both \n    their first and last digits odd.\n    \"\"\"\n    count = 0\n    for num in nums:\n        # Condition 1: Number must be greater than 10\n        if num <= 10:\n            continue\n\n        # Convert the absolute value of the number to a string to extract digits\n        num_str = str(abs(num))\n        \n        # Condition 2: First digit must be odd\n        first_digit = int(num_str[0])\n        if first_digit % 2 == 0:\n            continue\n        \n        # Condition 3: Last digit must be odd\n        last_digit = int(num_str[-1])\n        if last_digit % 2 == 0:\n            continue\n            \n        # If all conditions are met, increment the count\n        count += 1\n        \n    return count"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"\n    Filters a list of strings to retain only those with even lengths,\n    then sorts the remaining strings by length (ascending) and alphabetically (ascending).\n    \"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    sorted_list = sorted(even_length_strings, key=lambda s: (len(s), s))\n    return sorted_list"}
{"task_id": "HumanEval/148", "solution": "PLANETS = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\n\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    try:\n        idx1 = PLANETS.index(planet1)\n        idx2 = PLANETS.index(planet2)\n    except ValueError:\n        return ()\n\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    # If the planets are adjacent or the same, there are no planets between them.\n    if end_idx - start_idx <= 1:\n        return ()\n\n    # Slice the list to get planets strictly between planet1 and planet2.\n    intermediate_planets = PLANETS[start_idx + 1:end_idx]\n    return tuple(intermediate_planets)"}
{"task_id": "HumanEval/144", "solution": "import math\n\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    class Fraction:\n        def __init__(self, numerator: int, denominator: int):\n            self._numerator = numerator\n            self._denominator = denominator\n\n        @property\n        def numerator(self) -> int:\n            return self._numerator\n\n        @property\n        def denominator(self) -> int:\n            return self._denominator\n\n        def __mul__(self, other: 'Fraction') -> 'Fraction':\n            new_numerator = self.numerator * other.numerator\n            new_denominator = self.denominator * other.denominator\n            return Fraction(new_numerator, new_denominator)\n\n        def simplify(self) -> 'Fraction':\n            if self.numerator == 0:\n                return Fraction(0, 1)\n            common_divisor = math.gcd(self.numerator, self.denominator)\n            return Fraction(self.numerator // common_divisor, self.denominator // common_divisor)\n\n        def is_whole_number(self) -> bool:\n            simplified = self.simplify()\n            return simplified.denominator == 1\n\n    class FractionParser:\n        @staticmethod\n        def parse_fraction(fraction_str: str) -> Fraction:\n            parts = fraction_str.split('/')\n            numerator = int(parts[0])\n            denominator = int(parts[1])\n            return Fraction(numerator, denominator)\n\n    class FractionService:\n        def multiply(self, f1: Fraction, f2: Fraction) -> Fraction:\n            return f1 * f2\n\n        def is_whole_number(self, f: Fraction) -> bool:\n            return f.is_whole_number()\n\n    fraction_parser = FractionParser()\n    fraction_service = FractionService()\n\n    fraction_x = fraction_parser.parse_fraction(x)\n    fraction_n = fraction_parser.parse_fraction(n)\n\n    product_fraction = fraction_service.multiply(fraction_x, fraction_n)\n\n    return fraction_service.is_whole_number(product_fraction)"}
{"task_id": "HumanEval/147", "solution": "import math\n\ndef get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from array a where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    # a[x] = x*x - x + 1\n    # Analyze a[x] % 3:\n    # If x % 3 == 0, then a[x] % 3 = (0*0 - 0 + 1) % 3 = 1\n    # If x % 3 == 1, then a[x] % 3 = (1*1 - 1 + 1) % 3 = 1\n    # If x % 3 == 2, then a[x] % 3 = (2*2 - 2 + 1) % 3 = (4 - 2 + 1) % 3 = 3 % 3 = 0\n    # Therefore, a[x] % 3 is 0 if x % 3 == 2, and 1 if x % 3 == 0 or x % 3 == 1.\n    # a[x] % 3 is never 2.\n\n    # A sum of three numbers a[i] + a[j] + a[k] is a multiple of 3 if:\n    # 1. All three a values have remainder 0 when divided by 3 (0+0+0 = 0 mod 3)\n    # 2. All three a values have remainder 1 when divided by 3 (1+1+1 = 3 = 0 mod 3)\n\n    # Count occurrences of i % 3 for i from 1 to n\n    count_i_rem0 = 0  # for i such that i % 3 == 0\n    count_i_rem1 = 0  # for i such that i % 3 == 1\n    count_i_rem2 = 0  # for i such that i % 3 == 2\n\n    for i in range(1, n + 1):\n        remainder = i % 3\n        if remainder == 0:\n            count_i_rem0 += 1\n        elif remainder == 1:\n            count_i_rem1 += 1\n        else:  # remainder == 2\n            count_i_rem2 += 1\n\n    # Map i % 3 counts to a[i] % 3 counts\n    # Number of a[i] values that are 0 mod 3\n    count_a_rem0 = count_i_rem2\n    # Number of a[i] values that are 1 mod 3\n    count_a_rem1 = count_i_rem0 + count_i_rem1\n\n    # Calculate combinations using math.comb (nCr)\n    # nCr returns 0 if r > n or r < 0, which is desired behavior here.\n    triples_from_a_rem0 = math.comb(count_a_rem0, 3)\n    triples_from_a_rem1 = math.comb(count_a_rem1, 3)\n\n    return triples_from_a_rem0 + triples_from_a_rem1"}
{"task_id": "HumanEval/150", "solution": "import math\nfrom typing import Any\n\ndef x_or_y(n: int, x: Any, y: Any) -> Any:\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n    \"\"\"\n    \n    # Determine if n is a prime number\n    is_prime_n = False\n    if n <= 1:\n        is_prime_n = False\n    elif n == 2:\n        is_prime_n = True\n    elif n % 2 == 0:\n        is_prime_n = False\n    else:\n        # Check for odd divisors up to the square root of n\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                is_prime_n = False\n                break\n            i += 2\n        else:\n            is_prime_n = True\n\n    # Return x if prime, y otherwise\n    if is_prime_n:\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd, positive integers.\n    Ignore numbers that are negative, zero, even, or not integers.\n    \"\"\"\n    total_sum_of_squares = 0\n    if not lst:\n        return 0\n\n    for item in lst:\n        # Check if the item is an integer\n        if isinstance(item, int):\n            # Check if the integer is positive\n            if item > 0:\n                # Check if the positive integer is odd\n                if item % 2 != 0:\n                    total_sum_of_squares += item * item\n    return total_sum_of_squares"}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"Calculates the absolute difference between corresponding elements of two lists.\n    Returns a new list with these differences.\n    \"\"\"\n    result = []\n    for i in range(len(game)):\n        result.append(abs(game[i] - guess[i]))\n    return result"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"Checks if the second word or any of its rotations is a substring in the first word.\"\"\"\n    if not a or not b:\n        return False\n\n    rotations = set()\n    n = len(b)\n    for i in range(n):\n        rotated_b = b[i:] + b[:i]\n        rotations.add(rotated_b)\n\n    for rotation in rotations:\n        if rotation in a:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    if num == 0:\n        return (1, 0)\n\n    even_count = 0\n    odd_count = 0\n\n    # Convert the absolute value of the number to a string to iterate through digits.\n    num_str = str(abs(num))\n\n    for char_digit in num_str:\n        digit = int(char_digit)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on CAP - SM strength calculation.\n    Returns the class name concatenated with the strongest extension name, choosing the first if strengths are tied.\n    \"\"\"\n    max_strength = -float('inf')\n    strongest_extension_name = \"\"\n\n    for ext_name in extensions:\n        cap_count = sum(1 for char in ext_name if char.isupper())\n        sm_count = sum(1 for char in ext_name if char.islower())\n        \n        current_strength = cap_count - sm_count\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = ext_name\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/162", "solution": "import hashlib\n\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    ROMAN_MAP = {\n        1000: 'm', 900: 'cm', 500: 'd', 400: 'cd', 100: 'c',\n        90: 'xc', 50: 'l', 40: 'xl', 10: 'x', 9: 'ix',\n        5: 'v', 4: 'iv', 1: 'i'\n    }\n    \n    roman_numeral_parts = []\n    # Iterate through values from largest to smallest\n    for value, symbol in sorted(ROMAN_MAP.items(), reverse=True):\n        while number >= value:\n            roman_numeral_parts.append(symbol)\n            number -= value\n            \n    return \"\".join(roman_numeral_parts)"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n    has_letters = any(char.isalpha() for char in s)\n\n    if not has_letters:\n        return s[::-1]\n    else:\n        transformed_chars = []\n        for char in s:\n            if char.isalpha():\n                transformed_chars.append(char.swapcase())\n            else:\n                transformed_chars.append(char)\n        return \"\".join(transformed_chars)"}
{"task_id": "HumanEval/157", "solution": "EPSILON = 1e-9\n\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    '''\n    \n    # Sort sides to easily identify the potential hypotenuse (the longest side).\n    sides = sorted([a, b, c])\n    x, y, z = sides[0], sides[1], sides[2]\n\n    # Check if x^2 + y^2 = z^2, accounting for floating-point precision.\n    return abs(x*x + y*y - z*z) < EPSILON"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Tie-breaking: lexicographical order\n            if word < result_word:\n                result_word = word\n    return result_word"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten and remaining carrots after a rabbit's meal.\n    The rabbit eats as much as needed from remaining, or all remaining if insufficient.\n    \"\"\"\n    if remaining >= need:\n        carrots_eaten_now = need\n        carrots_left = remaining - need\n    else:\n        carrots_eaten_now = remaining\n        carrots_left = 0\n    \n    total_eaten = number + carrots_eaten_now\n    \n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    start = min(a, b)\n    end = max(a, b)\n    \n    even_numbers = []\n    # Determine the first even number within the range [start, end]\n    current = start if start % 2 == 0 else start + 1\n\n    while current <= end:\n        even_numbers.append(current)\n        current += 2\n        \n    return even_numbers"}
{"task_id": "HumanEval/160", "solution": "from dataclasses import dataclass\n\nclass InputValidationError(ValueError):\n    \"\"\"Custom exception for invalid input to the algebra evaluator.\"\"\"\n    pass\n\nclass EvaluationError(RuntimeError):\n    \"\"\"Custom exception for errors during expression evaluation.\"\"\"\n    pass\n\n@dataclass(frozen=True)\nclass ExpressionInput:\n    \"\"\"A data transfer object to encapsulate operators and operands.\"\"\"\n    operators: list[str]\n    operands: list[int]\n\nclass InputValidator:\n    \"\"\"Utility class for validating input lists for algebraic expressions.\"\"\"\n    _ALLOWED_OPERATORS = {'+', '-', '*', '//', '**'}\n\n    @staticmethod\n    def validate_inputs(operators: list[str], operands: list[int]) -> None:\n        \"\"\"Validates the operator and operand lists according to business rules.\"\"\"\n        if not isinstance(operators, list) or not isinstance(operands, list):\n            raise InputValidationError(\"Inputs must be lists.\")\n        InputValidator._validate_lengths(operators, operands)\n        InputValidator._validate_min_lengths(operators, operands)\n        InputValidator._validate_operand_types(operands)\n        InputValidator._validate_operator_types(operators)\n        InputValidator._validate_operator_values(operators)\n\n    @staticmethod\n    def _validate_lengths(operators: list[str], operands: list[int]) -> None:\n        \"\"\"Checks if the length of operator list is correct relative to operands.\"\"\"\n        if len(operators) != len(operands) - 1:\n            raise InputValidationError(\n                \"Length of operator list must be equal to length of operand list minus one.\"\n            )\n\n    @staticmethod\n    def _validate_operand_types(operands: list[int]) -> None:\n        \"\"\"Checks if all operands are non-negative integers.\"\"\"\n        for operand in operands:\n            if not isinstance(operand, int) or operand < 0:\n                raise InputValidationError(\n                    \"All operands must be non-negative integers.\"\n                )\n\n    @staticmethod\n    def _validate_operator_types(operators: list[str]) -> None:\n        \"\"\"Checks if all operators are strings.\"\"\"\n        for operator in operators:\n            if not isinstance(operator, str):\n                raise InputValidationError(\"All operators must be strings.\")\n\n    @staticmethod\n    def _validate_operator_values(operators: list[str]) -> None:\n        \"\"\"Checks if all operator strings are allowed values.\"\"\"\n        for operator in operators:\n            if operator not in InputValidator._ALLOWED_OPERATORS:\n                raise InputValidationError(\n                    f\"Unsupported operator found: '{operator}'. \"\n                    f\"Allowed operators are: {', '.join(InputValidator._ALLOWED_OPERATORS)}\"\n                )\n\n    @staticmethod\n    def _validate_min_lengths(operators: list[str], operands: list[int]) -> None:\n        \"\"\"Checks minimum lengths for operator and operand lists.\"\"\"\n        if not operators:\n            raise InputValidationError(\"Operator list must have at least one operator.\")\n        if len(operands) < 2:\n            raise InputValidationError(\"Operand list must have at least two operands.\")\n\nclass AlgebraEvaluatorService:\n    \"\"\"Service for building and evaluating algebraic expressions.\"\"\"\n    @staticmethod\n    def evaluate_expression(expression_input: ExpressionInput) -> int:\n        \"\"\"Builds an expression string and evaluates it.\"\"\"\n        expression_string = AlgebraEvaluatorService._build_expression_string(expression_input)\n        return AlgebraEvaluatorService._evaluate_string(expression_string)\n\n    @staticmethod\n    def _build_expression_string(expression_input: ExpressionInput) -> str:\n        \"\"\"Interleaves operands and operators to form an expression string.\"\"\"\n        parts = []\n        for i in range(len(expression_input.operands)):\n            parts.append(str(expression_input.operands[i]))\n            if i < len(expression_input.operators):\n                parts.append(expression_input.operators[i])\n        return \" \".join(parts)\n\n    @staticmethod\n    def _evaluate_string(expression_string: str) -> int:\n        \"\"\"Evaluates the given expression string using Python's built-in eval().\"\"\"\n        try:\n            result = eval(expression_string)\n            if not isinstance(result, (int, float)):\n                raise EvaluationError(\"Expression did not evaluate to a numeric type.\")\n            return int(result)\n        except Exception as e:\n            raise EvaluationError(f\"Failed to evaluate expression '{expression_string}': {e}\") from e\n\ndef do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n\n    The basic algebra operations:\n    Addition ( + ) \n    Subtraction ( - ) \n    Multiplication ( * ) \n    Floor division ( // ) \n    Exponentiation ( ** ) \n\n    Example:\n    operator['+', '*', '-']\n    array = [2, 3, 4, 5]\n    result = 2 + 3 * 4 - 5\n    => result = 9\n\n    Note:\n        The length of operator list is equal to the length of operand list minus one.\n        Operand is a list of of non-negative integers.\n        Operator list has at least one operator, and operand list has at least two operands.\n\n    \"\"\"\n    InputValidator.validate_inputs(operator, operand)\n    expression_input = ExpressionInput(operators=operator, operands=operand)\n    return AlgebraEvaluatorService.evaluate_expression(expression_input)"}
