{"task_id": "HumanEval/87", "solution": "import operator\n\ndef get_row(lst, x):\n    \"\"\"\n    Finds integers x in the list and returns a list of tuples (row, column).\n    Coordinates are sorted initially by rows in ascending order,\n    then by columns in descending order for coordinates of the same row.\n    \"\"\"\n    found_coordinates = []\n\n    for row_idx, row_list in enumerate(lst):\n        for col_idx, item in enumerate(row_list):\n            if item == x:\n                found_coordinates.append((row_idx, col_idx))\n\n    # Sort primarily by row (ascending), secondarily by column (descending)\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return found_coordinates"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Sorts characters within words of a string based on ASCII values, preserving word order and spaces.\n    Words are sequences of non-space characters.\n    \"\"\"\n    result_parts = []\n    current_word_chars = []\n    \n    for char in s:\n        if char == ' ':\n            if current_word_chars:\n                result_parts.append(\"\".join(sorted(current_word_chars)))\n                current_word_chars = []\n            result_parts.append(' ')\n        else:\n            current_word_chars.append(char)\n    \n    if current_word_chars:\n        result_parts.append(\"\".join(sorted(current_word_chars)))\n        \n    return \"\".join(result_parts)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n\n    Note:\n    * don't change the given array.\n\n    Examples:\n    * sort_array([]) => []\n    * sort_array([5]) => [5]\n    * sort_array([2, 4, 3, 0, 1, 5]) => [0, 1, 2, 3, 4, 5]\n    * sort_array([2, 4, 3, 0, 1, 5, 6]) => [6, 5, 4, 3, 2, 1, 0]\n    \"\"\"\n    if not array or len(array) == 1:\n        return list(array)\n\n    first_element = array[0]\n    last_element = array[-1]\n    sum_first_last = first_element + last_element\n\n    if sum_first_last % 2 != 0:  # Odd sum, sort ascending\n        return sorted(array)\n    else:  # Even sum, sort descending\n        return sorted(array, reverse=True)"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of GPAs to a list of letter grades based on a predefined scale.\"\"\"\n\n    # The grading scale defines GPA thresholds and their corresponding letter grades.\n    # Each entry is (gpa_threshold, letter_grade, is_exact_match).\n    _GRADING_SCALE_DATA = [\n        (4.0, \"A+\", True),  # GPA 4.0 results in A+\n        (3.7, \"A\", False),  # GPA > 3.7 results in A\n        (3.3, \"A-\", False), # GPA > 3.3 results in A-\n        (3.0, \"B+\", False), # GPA > 3.0 results in B+\n        (2.7, \"B\", False),  # GPA > 2.7 results in B\n        (2.3, \"B-\", False), # GPA > 2.3 results in B-\n        (2.0, \"C+\", False), # GPA > 2.0 results in C+\n        (1.7, \"C\", False),  # GPA > 1.7 results in C\n        (1.3, \"C-\", False), # GPA > 1.3 results in C-\n        (1.0, \"D+\", False), # GPA > 1.0 results in D+\n        (0.7, \"D\", False),  # GPA > 0.7 results in D\n        (0.0, \"D-\", False)  # GPA > 0.0 results in D-\n    ]\n\n    def _convert_single_gpa(gpa_value):\n        \"\"\"Converts a single GPA value to its corresponding letter grade.\"\"\"\n        # GPAs above 4.0 are also considered A+\n        if gpa_value > 4.0:\n            return \"A+\"\n\n        for threshold, letter_grade, is_exact in _GRADING_SCALE_DATA:\n            if is_exact:\n                if gpa_value == threshold:\n                    return letter_grade\n            else:\n                if gpa_value > threshold:\n                    return letter_grade\n        \n        # If no other rule matched, the GPA is 0.0 or less, which corresponds to 'E'.\n        return \"E\"\n\n    result_grades = []\n    for gpa in grades:\n        result_grades.append(_convert_single_gpa(gpa))\n    \n    return result_grades"}
{"task_id": "HumanEval/83", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n    \n    # Calculate numbers starting with 1.\n    count_starts_with_1 = 10**(n - 1)\n    \n    # Calculate numbers ending with 1 for n > 1.\n    count_ends_with_1 = 9 * 10**(n - 2)\n    \n    # Sum the counts, as per the interpretation of \"start or end\" for n > 1.\n    return count_starts_with_1 + count_ends_with_1"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Create a function encrypt that takes a string as an argument and\n    returns a string encrypted with the alphabet being rotated. \n    The alphabet should be rotated in a manner such that the letters \n    shift down by two multiplied to two places.\n    For example:\n    encrypt('hi') returns 'lm'\n    encrypt('asdfghjkl') returns 'ewhjklnop'\n    encrypt('gf') returns 'kj'\n    encrypt('et') returns 'ix'\n    \"\"\"\n    encrypted_chars = []\n    shift = 4  # Two multiplied by two places\n    for char in s:\n        if 'a' <= char <= 'z':\n            start = ord('a')\n            encrypted_chars.append(chr((ord(char) - start + shift) % 26 + start))\n        elif 'A' <= char <= 'Z':\n            start = ord('A')\n            encrypted_chars.append(chr((ord(char) - start + shift) % 26 + start))\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
