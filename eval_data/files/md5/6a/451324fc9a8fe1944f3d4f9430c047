here are two or more extensions with the same strength, you should\n    choose the one that comes first in the list.\n    For example, if you are given \"Slices\" as the class and a list of the\n    extensions: ['SErviNGSliCes', 'Cheese', 'StuFfed'] then you should\n    return 'Slices.SErviNGSliCes' since 'SErviNGSliCes' is the strongest extension\n    (its strength is -1).\n    Example:\n    for Strongest_Extension('my_class', ['AA', 'Be', 'CC']) == 'my_class.AA'\n    \"\"\"\n    class ExtensionInfo:\n        \"\"\"A data structure to hold an extension's name and its calculated strength components.\"\"\"\n        def __init__(self, name: str, uppercase_count: int, lowercase_count: int, strength: int):\n            self.name = name\n            self.uppercase_count = uppercase_count\n            self.lowercase_count = lowercase_count\n            self.strength = strength\n\n    def _calculate_strength(extension_name: str) -> tuple[int, int, int]:\n        \"\"\"Calculates uppercase count, lowercase count, and strength for an extension name.\"\"\"\n        uppercase_count = 0\n        lowercase_count = 0\n        for char in extension_name:\n            if 'A' <= char <= 'Z':\n                uppercase_count += 1\n            elif 'a' <= char <= 'z':\n                lowercase_count += 1\n        strength = uppercase_count - lowercase_count\n        return uppercase_count, lowercase_count, strength\n\n    if not extensions:\n        return f\"{class_name}.\"\n\n    extension_infos = []\n    for extension_name in extensions:\n        uc, lc, strength = _calculate_strength(extension_name)\n        extension_infos.append(ExtensionInfo(extension_name, uc, lc, strength))\n\n    # Identifies the strongest extension, using the first encountered for ties.\n    strongest_info = max(extension_infos, key=lambda info: info.strength)\n\n    return f\"{class_name}.{strongest_info.name}\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []},