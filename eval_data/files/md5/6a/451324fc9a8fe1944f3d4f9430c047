nant(self) -> bool:\n            \"\"\"Checks if the character is a consonant.\"\"\"\n            return not self.is_vowel()\n\n    class Word:\n        \"\"\"Represents a sequence of characters and provides access to individual characters and its length.\"\"\"\n        def __init__(self, text: str):\n            self.text = text\n\n        def get_character_at(self, index: int) -> 'Character':\n            \"\"\"Returns the Character object at the specified index.\"\"\"\n            return Character(self.text[index])\n\n        def get_length(self) -> int:\n            \"\"\"Returns the length of the word.\"\"\"\n            return len(self.text)\n\n    word_obj = Word(word)\n    length = word_obj.get_length()\n\n    # Iterate from right to left, excluding the first and last characters (indices 0 and length-1)\n    for i in range(length - 2, 0, -1):\n        vowel_candidate = word_obj.get_character_at(i)\n\n        if vowel_candidate.is_vowel():\n            left_char = word_obj.get_character_at(i - 1)\n            right_char = word_obj.get_character_at(i + 1)\n\n            if left_char.is_consonant() and right_char.is_consonant():\n                return vowel_candidate.value\n\n    return \"\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/119": [{"task_id": "HumanEval/119", "solution": "def _check_balance(s):\n    \"\"\"Checks if a given string of parentheses is balanced.\"\"\"\n    balance = 0\n    for char in s:\n        if char == '(':\n            balance += 1\n        else:\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0\ndef match_parens(lst):\n    \"\"\"Determines if two strings can form a balanced parentheses string by concatenation.\"\"\"\n    s1, s2 = lst[0], lst[1]\n\n    # Check s1 + s2\n    if _check_balance(s1 + s2):\n        return 'Yes'\n\n    # Check s2 + s1\n    if _check_balance(s2 + s1):\n        return 'Yes'\n\n    return 'No'",