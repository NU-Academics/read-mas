   def get_grade(self) -> str:\n        \"\"\"Returns the assigned letter grade for this mapping.\"\"\"\n        return self._assignedGrade\nclass GPAConverterModule:\n    \"\"\"Core logic for converting a list of GPAs to letter grades.\n    It holds the complete GRADE_SCALE as a class-level constant.\"\"\"\n    GRADE_SCALE = [\n        GradeMapping('A+', 4.0, 4.0),       # Exact 4.0 GPA\n        GradeMapping('A', 3.7, 4.0),        # > 3.7 to <= 4.0\n        GradeMapping('A-', 3.3, 3.7),       # > 3.3 to <= 3.7\n        GradeMapping('B+', 3.0, 3.3),       # > 3.0 to <= 3.3\n        GradeMapping('B', 2.7, 3.0),        # > 2.7 to <= 3.0\n        GradeMapping('B-', 2.3, 2.7),       # > 2.3 to <= 2.7\n        GradeMapping('C+', 2.0, 2.3),       # > 2.0 to <= 2.3\n        GradeMapping('C', 1.7, 2.0),        # > 1.7 to <= 2.0\n        GradeMapping('C-', 1.3, 1.7),       # > 1.3 to <= 1.7\n        GradeMapping('D+', 1.0, 1.3),       # > 1.0 to <= 1.3\n        GradeMapping('D', 0.7, 1.0),        # > 0.7 to <= 1.0\n        GradeMapping('D-', 0.0, 0.7),       # > 0.0 to <= 0.7\n        GradeMapping('E', 0.0, 0.0)         # Exact 0.0 GPA\n    ]\n\n    @staticmethod\n    def numerical_letter_grade(grades: list[float]) -> list[str]:\n        \"\"\"Converts a list of numerical GPAs into corresponding letter grades.\n        It iterates through a predefined grading scale to find the first matching range.\"\"\"\n        letter_grades_list = []\n        for gpa in grades:\n            found_grade = 'N/A' # Default for GPAs that don't match any rule.\n            for mapping in GPAConverterModule.GRADE_SCALE:\n                if mapping.is_gpa_in_range(gpa):\n                    found_grade = mapping.get_grade()\n                    break\n            letter_grades_list.append(found_grade)\n        return letter_grades_list\ndef numerical_letter_grade(grades: list[float]) -> list[str]:\n    \"\"\"Converts a list of numerical GPAs into corresponding letter grades.\n    The grading use