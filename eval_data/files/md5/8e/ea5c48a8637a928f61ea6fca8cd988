{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    \"\"\"\n    ROMAN_MAP = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n\n    roman_numeral = []\n    temp_num = number\n    for value, symbol in ROMAN_MAP:\n        while temp_num >= value:\n            roman_numeral.append(symbol)\n            temp_num -= value\n    return \"\".join(roman_numeral).lower()"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    '''\n    # Validate that all input side lengths are positive numbers (FR1).\n    if not (a > 0 and b > 0 and c > 0):\n        return False\n\n    # Sort the three side lengths in ascending order (FR2).\n    sides = sorted([a, b, c])\n    s1, s2, s3 = sides[0], sides[1], sides[2]\n\n    # Apply the Pythagorean theorem with a tolerance for floating-point comparison (FR3, FR4).\n    tolerance = 1e-9\n    return abs(s1**2 + s2**2 - s3**2) < tolerance"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Finds the word with the maximum number of unique characters.\n    If tied, returns the lexicographically smallest string.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        # Count unique characters inline as per critical requirement.\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Tie-breaking: lexicographical order.\n            if word < result_word:\n                result_word = word\n\n    return result_word"}
{"task_id": "HumanEval/157", "solution": "import math\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # Validate numeric input\n    if not all(isinstance(x, (int, float)) for x in [a, b, c]):\n        raise TypeError(\"All side lengths must be numeric.\")\n\n    # Validate positive side lengths\n    if not (a > 0 and b > 0 and c > 0):\n        raise ValueError(\"All side lengths must be positive.\")\n\n    # Validate triangle inequality theorem\n    if not (a + b > c and a + c > b and b + c > a):\n        raise ValueError(\"The given side lengths do not form a valid triangle.\")\n\n    # Sort the sides to easily identify the potential hypotenuse (longest side)\n    sides = sorted([a, b, c])\n    s1, s2, s3 = sides[0], sides[1], sides[2]\n\n    # Check Pythagorean theorem: s1^2 + s2^2 = s3^2\n    # Use math.isclose for robust floating-point comparison with a relative tolerance\n    # A relative tolerance of 1e-9 is a common choice for general purpose comparisons.\n    return math.isclose(s1**2 + s2**2, s3**2, rel_tol=1e-9)"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates carrots eaten and remaining after a rabbit's meal.\n    Returns a list: [total eaten, carrots left].\n    \"\"\"\n    carrots_eaten_this_meal = min(need, remaining)\n    total_eaten = number + carrots_eaten_this_meal\n    carrots_left = remaining - carrots_eaten_this_meal\n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"\n    Finds the word with the maximum number of unique characters.\n    If multiple strings tie, returns the one that comes first lexicographically.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            if result_word == \"\" or word < result_word:\n                result_word = word\n    return result_word"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten and remaining carrots after a meal.\n    Returns a list of [total_eaten, carrots_left].\n    \"\"\"\n    carrots_eaten_now = min(need, remaining)\n    total_eaten = number + carrots_eaten_now\n    carrots_left = remaining - carrots_eaten_now\n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Reverses case of letters or reverses the whole string if no letters are present.\n    Non-letter characters are preserved unless the whole string is reversed.\"\"\"\n\n    def is_letter(char: str) -> bool:\n        \"\"\"Checks if a character is an alphabetic letter using range comparison.\"\"\"\n        return 'a' <= char <= 'z' or 'A' <= char <= 'Z'\n\n    def reverse_case(char: str) -> str:\n        \"\"\"Reverses the case of a single letter character if it is a letter.\"\"\"\n        if 'a' <= char <= 'z':\n            return char.upper()\n        elif 'A' <= char <= 'Z':\n            return char.lower()\n        return char\n\n    # Determine if the string contains any letters\n    has_any_letters = False\n    for char_s in s:\n        if is_letter(char_s):\n            has_any_letters = True\n            break\n\n    if not has_any_letters:\n        # If no letters, reverse the entire string\n        return s[::-1]\n    else:\n        # If letters are present, transform case of letters and preserve others\n        transformed_chars = []\n        for char_s in s:\n            if is_letter(char_s):\n                transformed_chars.append(reverse_case(char_s))\n            else:\n                transformed_chars.append(char_s)\n        return \"\".join(transformed_chars)"}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Reverses case of letters, preserves others, or reverses entire string if no letters.\"\"\"\n\n    def is_letter_helper(char):\n        \"\"\"Checks if a character is an alphabetic letter.\"\"\"\n        return char.isalpha()\n\n    def reverse_case_helper(char):\n        \"\"\"Reverses the case of a single alphabetic character.\"\"\"\n        if char.islower():\n            return char.upper()\n        elif char.isupper():\n            return char.lower()\n        return char\n\n    # Check if the string contains any letters as per FR3.\n    contains_letters = False\n    for char in s:\n        if is_letter_helper(char):\n            contains_letters = True\n            break\n\n    if not contains_letters:\n        # If no letters, reverse the entire string.\n        return s[::-1]\n    else:\n        # Process character cases as per FR1 and FR2.\n        result_chars = []\n        for char in s:\n            if is_letter_helper(char):\n                result_chars.append(reverse_case_helper(char))\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars) # Return the processed string as per FR4."}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n\n    >>> string_to_md5('Hello world') == '3e25960a79dbc69b674cd4ec67a72c62'\n    \"\"\"\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Evaluates an algebraic expression built from lists of operators and operands.\n    It follows standard operator precedence and returns the computed integer result.\n    \"\"\"\n\n    def _apply_operator(op, val1, val2):\n        \"\"\"Performs the specified arithmetic operation.\"\"\"\n        if op == '+':\n            return val1 + val2\n        elif op == '-':\n            return val1 - val2\n        elif op == '*':\n            return val1 * val2\n        elif op == '//':\n            return val1 // val2\n        elif op == '**':\n            return val1 ** val2\n\n    # Operator precedence: higher number means higher precedence.\n    _precedence = {\n        '+': 1, '-': 1,\n        '*': 2, '//': 2,\n        '**': 3\n    }\n\n    output_queue = []\n    operator_stack = []\n\n    # Start by pushing the first operand to the output queue.\n    output_queue.append(operand[0])\n\n    # Process remaining operands and operators to convert to Reverse Polish Notation (RPN).\n    for i in range(len(operator)):\n        current_op = operator[i]\n        next_operand = operand[i+1]\n\n        # Pop operators from stack to output queue based on precedence.\n        while (operator_stack and\n               _precedence[operator_stack[-1]] >= _precedence[current_op]):\n            output_queue.append(operator_stack.pop())\n\n        # Push the current operator onto the stack.\n        operator_stack.append(current_op)\n\n        # Push the next operand to the output queue.\n        output_queue.append(next_operand)\n\n    # Pop any remaining operators from the stack to the output queue.\n    while operator_stack:\n        output_queue.append(operator_stack.pop())\n\n    # Evaluate the RPN expression using a stack.\n    evaluation_stack = []\n    for token in output_queue:\n        if isinstance(token, int):\n            evaluation_stack.append(token)\n        else:  # Token is an operator.\n            val2 = evaluation_stack.pop()\n            val1 = evaluation_stack.pop()\n            result = _apply_operator(token, val1, val2)\n            evaluation_stack.append(result)\n\n    return evaluation_stack[0]"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even integers between them, inclusive,\n    in ascending order.\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    even_numbers = []\n    for i in range(min_val, max_val + 1):\n        if i % 2 == 0:\n            even_numbers.append(i)\n    return even_numbers"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even integers between a and b, in ascending order.\n    For example: generate_integers(2, 8) => [2, 4, 6, 8].\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    even_numbers = []\n    for num in range(min_val, max_val + 1):\n        if num % 2 == 0:\n            even_numbers.append(num)\n\n    return even_numbers"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator: list[str], operand: list[int]) -> int:\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and\n    the second list is a list of integers. Use the two given lists to build the algebric\n    expression and return the evaluation of this expression.\n\n    The basic algebra operations:\n    Addition ( + )\n    Subtraction ( - )\n    Multiplication ( * )\n    Floor division ( // )\n    Exponentiation ( ** )\n\n    Example:\n    operator['+', '*', '-']\n    array = [2, 3, 4, 5]\n    result = 2 + 3 * 4 - 5\n    => result = 9\n\n    Note:\n        The length of operator list is equal to the length of operand list minus one.\n        Operand is a list of of non-negative integers.\n        Operator list has at least one operator, and operand list has at least two operands.\n\n    \"\"\"\n    # --- Input Validation ---\n    SUPPORTED_OPERATORS = {'+', '-', '*', '//', '**'}\n\n    if not operator and not operand:\n        raise ValueError(\"Operator and operand lists cannot be empty.\")\n    if not operator or not operand:\n        # This covers cases like ([], [1,2]) or (['+'], [])\n        raise ValueError(\"Operator and operand lists cannot be empty.\")\n    if len(operator) != len(operand) - 1:\n        raise ValueError(\"Length of operator list must be one less than operand list.\")\n    if len(operand) < 2:\n        raise ValueError(\"Operand list must have at least two operands.\")\n\n    for op_item in operator:\n        if op_item not in SUPPORTED_OPERATORS:\n            raise ValueError(f\"Unsupported operator: {op_item}\")\n\n    for op_val in operand:\n        if not isinstance(op_val, int) or op_val < 0:\n            raise ValueError(\"All operands must be non-negative integers.\")\n    # --- End Input Validation ---\n\n    _OPERATOR_PRECEDENCE = {\n        '**': 3,\n        '*': 2,\n        '//': 2,\n        '+': 1,\n        '-': 1\n    }\n\n    def _apply_operation(op: str, val1: int, val2: int) -> int:\n        \"\"\"Performs a single arithmetic operation between two values.\"\"\"\n        if op == '+':\n            return val1 + val2\n        elif op == '-':\n            return val1 - val2\n        elif op == '*':\n            return val1 * val2\n        elif op == '//':\n            if val2 == 0:\n                raise ZeroDivisionError(\"Cannot perform floor division by zero.\")\n            return val1 // val2\n        elif op == '**':\n            return val1 ** val2\n        # This case should ideally be caught by initial validation, but acts as a safeguard.\n        raise ValueError(f\"Unknown operator during evaluation: {op}\")\n\n    def _find_next_operation_index(current_operators_list: list[str]) -> int:\n        \"\"\"Determines the index of the next operator to apply based on precedence rules.\"\"\"\n        highest_precedence = -1\n        next_op_idx = -1\n\n        for i, op in enumerate(current_operators_list):\n            precedence = _OPERATOR_PRECEDENCE[op] # We know op is valid due to initial validation\n            if precedence > highest_precedence:\n                highest_precedence = precedence\n                next_op_idx = i\n            # For operators with same precedence, left-to-right evaluation is implicitly\n            # handled by iterating from left to right and updating `next_op_idx` only\n            # if precedence is strictly higher.\n        return next_op_idx\n\n    current_operators = list(operator)\n    current_operands = list(operand)\n\n    while len(current_operators) > 0:\n        op_idx = _find_next_operation_index(current_operators)\n\n        op = current_operators.pop(op_idx)\n        val1 = current_operands.pop(op_idx)\n        val2 = current_operands.pop(op_idx)\n\n        result = _apply_operation(op, val1, val2)\n        current_operands.insert(op_idx, result)\n\n    return current_operands[0]"}
