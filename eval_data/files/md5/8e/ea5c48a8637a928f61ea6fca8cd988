{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst: list[int]) -> int:\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n\n    def is_prime_inner(n: int) -> bool:\n        \"\"\"Checks if a given integer n is a prime number.\n        Uses an optimized trial division method.\n        \"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def sum_digits_inner(n: int) -> int:\n        \"\"\"Calculates the sum of the digits of a given integer n.\n        Converts the number to a string and sums its integer characters.\n        \"\"\"\n        s = 0\n        n_str = str(n)\n        for digit_char in n_str:\n            s += int(digit_char)\n        return s\n\n    largest_prime = None\n\n    for number in lst:\n        if is_prime_inner(number):\n            if largest_prime is None or number > largest_prime:\n                largest_prime = number\n\n    if largest_prime is None:\n        return 0\n    else:\n        return sum_digits_inner(largest_prime)"}
{"task_id": "HumanEval/98", "solution": "def count_upper(s):\n    \"\"\"\n    Given a string s, count the number of uppercase vowels in even indices.\n    For example: count_upper('aBCdEf') returns 1.\n    \"\"\"\n    UPPERCASE_VOWELS = {'A', 'E', 'I', 'O', 'U'}\n    count = 0\n    for i, char in enumerate(s):\n        if i % 2 == 0 and char in UPPERCASE_VOWELS:\n            count += 1\n    return count"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"Implement a function that takes an non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    for example:\n    count_up_to(5) => [2,3]\n    count_up_to(11) => [2,3,5,7]\n    count_up_to(0) => []\n    count_up_to(20) => [2,3,5,7,11,13,17,19]\n    count_up_to(1) => []\n    count_up_to(18) => [2,3,5,7,11,13,17]\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n <= 2:\n        return []\n\n    # Use Sieve of Eratosthenes for efficiency as mentioned in NFR1 for larger n\n    is_prime_sieve = [True] * n\n    is_prime_sieve[0] = False\n    is_prime_sieve[1] = False\n\n    for p in range(2, int(n**0.5) + 1):\n        if is_prime_sieve[p]:\n            for multiple in range(p * p, n, p):\n                is_prime_sieve[multiple] = False\n\n    primes = []\n    for num in range(2, n):\n        if is_prime_sieve[num]:\n            primes.append(num)\n\n    return primes"}
{"task_id": "HumanEval/98", "solution": "UPPERCASE_VOWELS = {'A', 'E', 'I', 'O', 'U'}\ndef count_upper(s):\n    \"\"\"\n    Counts the number of uppercase English vowels found at even indices (0, 2, 4, ...) within the input string s.\n    \"\"\"\n    count = 0\n    for i in range(0, len(s), 2):\n        if s[i] in UPPERCASE_VOWELS:\n            count += 1\n    return count"}
