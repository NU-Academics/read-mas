{"task_id": "HumanEval/148", "solution": "SOLAR_SYSTEM_PLANETS = [\n    \"Mercury\", \"Venus\", \"Earth\", \"Mars\",\n    \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n]\nclass PlanetUtils:\n    @staticmethod\n    def is_valid_planet(planet_name: str) -> bool:\n        \"\"\"Checks if a given string is a valid planet name.\"\"\"\n        return planet_name in SOLAR_SYSTEM_PLANETS\nclass PlanetService:\n    def __init__(self) -> None:\n        \"\"\"Initializes the PlanetService instance, loading the planet order.\"\"\"\n        self._planet_order: list[str] = SOLAR_SYSTEM_PLANETS\n\n    def get_planets_between(self, planet1: str, planet2: str) -> tuple[str, ...]:\n        \"\"\"Calculates and returns a tuple of planets located between planet1 and planet2.\"\"\"\n        if not PlanetUtils.is_valid_planet(planet1) or not PlanetUtils.is_valid_planet(planet2):\n            return ()\n\n        idx1 = self._planet_order.index(planet1)\n        idx2 = self._planet_order.index(planet2)\n\n        start_idx = min(idx1, idx2)\n        end_idx = max(idx1, idx2)\n\n        if end_idx - start_idx <= 1:\n            return ()\n\n        intermediate_planets = self._planet_order[start_idx + 1:end_idx]\n        return tuple(intermediate_planets)\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun\n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn,\n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2.\n    The function should return a tuple containing all planets whose orbits are\n    located between the orbit of planet1 and the orbit of planet2, sorted by\n    the proximity to the sun.\n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names.\n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    planet_service = PlanetService()\n    return planet_service.get_planets_between(planet1, planet2)"}
{"task_id": "HumanEval/150", "solution": "def is_prime(n):\n    \"\"\"Determines if an integer n is a prime number.\n    Assumes n is an integer for input.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n    Relies on the `is_prime` helper function.\n    \"\"\"\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/148", "solution": "from typing import Tuple, List, Dict\ndef bf(planet1: str, planet2: str) -> Tuple[str, ...]:\n    \"\"\"\n    Returns planets between planet1 and planet2, sorted by proximity to the sun.\n    Returns an empty tuple for invalid planet names or if no planets are between them.\n    \"\"\"\n    SOLAR_SYSTEM_PLANETS: List[str] = [\n        \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n    ]\n    planet_to_index: Dict[str, int] = {\n        planet_name: index for index, planet_name in enumerate(SOLAR_SYSTEM_PLANETS)\n    }\n\n    idx1 = planet_to_index.get(planet1, -1)\n    idx2 = planet_to_index.get(planet2, -1)\n\n    if idx1 == -1 or idx2 == -1:\n        return ()\n\n    if idx1 == idx2:\n        return ()\n\n    start_idx, end_idx = min(idx1, idx2), max(idx1, idx2)\n\n    intermediate_planets = SOLAR_SYSTEM_PLANETS[start_idx + 1:end_idx]\n\n    return tuple(intermediate_planets)"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n: int) -> int:\n    \"\"\"\n    Counts triples (a[i], a[j], a[k]) where i < j < k and their sum is a multiple of 3.\n    Values a[i] are defined as i*i - i + 1.\n    \"\"\"\n\n    def combinations(n_val, k_val):\n        \"\"\"Calculates n choose k, returning 0 if k is invalid.\"\"\"\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0 or k_val == n_val:\n            return 1\n        if k_val > n_val // 2:\n            k_val = n_val - k_val\n\n        res = 1\n        for i in range(k_val):\n            res = res * (n_val - i) // (i + 1)\n        return res\n\n    count_rem0 = 0\n    count_rem1 = 0\n\n    # Determine a[i] % 3 based on i % 3:\n    # If i % 3 == 0 or i % 3 == 1, then a[i] % 3 == 1.\n    # If i % 3 == 2, then a[i] % 3 == 0.\n    for i in range(1, n + 1):\n        if i % 3 == 2:\n            count_rem0 += 1\n        else:\n            count_rem1 += 1\n\n    # Triples sum to a multiple of 3 if all three remainders are 0, or all three are 1.\n    triples_from_rem0 = combinations(count_rem0, 3)\n    triples_from_rem1 = combinations(count_rem1, 3)\n\n    return triples_from_rem0 + triples_from_rem1"}
{"task_id": "HumanEval/150", "solution": "def is_prime(n):\n    \"\"\"\n    Determines if a given number is prime.\n    Numbers less than 2 are not considered prime.\n    \"\"\"\n    if n < 2:\n        return False\n    # Check for factors from 2 up to the square root of n.\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            return False\n    return True\ndef x_or_y(n, x, y):\n    \"\"\"\n    Returns x if n is a prime number, and y otherwise.\n    This function leverages an internal primality test.\n    \"\"\"\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/152", "solution": "def compare(game, guess):\n    \"\"\"Compares actual game scores against guessed scores.\n    Returns a list of absolute differences, with 0 for correct guesses.\"\"\"\n    results = []\n    for i in range(len(game)):\n        game_score = game[i]\n        guess_score = guess[i]\n\n        if game_score == guess_score:\n            results.append(0)\n        else:\n            results.append(abs(game_score - guess_score))\n    return results"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd, positive integers. Negative numbers and non-integers are ignored.\n    '''\n    total_sum = 0\n    for num in lst:\n        if isinstance(num, int):\n            if num > 0:\n                if num % 2 != 0:\n                    total_sum += num * num\n    return total_sum"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n\n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0\n\n    If the input list is empty, return 0.\n    '''\n    if not lst:\n        return 0\n\n    total_sum_of_squares = 0\n    for num in lst:\n        # Check if the number is an integer\n        if isinstance(num, int):\n            # Check if the number is positive\n            if num > 0:\n                # Check if the number is odd\n                if num % 2 != 0:\n                    total_sum_of_squares += num * num"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"You will be given the name of a class (a string) and a list of extensions.\n    The extensions are to be used to load additional classes to the class. The\n    strength of the extension is as follows: Let CAP be the number of the uppercase\n    letters in the extension's name, and let SM be the number of lowercase letters\n    in the extension's name, the strength is given by the fraction CAP - SM.\n    You should find the strongest extension and return a string in this\n    format: ClassName.StrongestExtensionName.\n    If there are two or more extensions with the same strength, you should\n    choose the one that comes first in the list.\n    For example, if you are given \"Slices\" as the class and a list of the\n    extensions: ['SErviNGSliCes', 'Cheese', 'StuFfed'] then you should\n    return 'Slices.SErviNGSliCes' since 'SErviNGSliCes' is the strongest extension\n    (its strength is -1).\n    Example:\n    for Strongest_Extension('my_class', ['AA', 'Be', 'CC']) == 'my_class.AA'\n    \"\"\"\n\n    def _calculate_strength(extension_name):\n        \"\"\"Calculates the strength of an extension name. Strength = CAP - SM.\"\"\"\n        cap_count = sum(1 for char in extension_name if 'A' <= char <= 'Z')\n        sm_count = sum(1 for char in extension_name if 'a' <= char <= 'z')\n        return cap_count - sm_count\n\n    if not extensions:\n        return class_name\n\n    strongest_ext_name = extensions[0]\n    max_strength = _calculate_strength(extensions[0])\n\n    for i in range(1, len(extensions)):\n        current_ext_name = extensions[i]\n        current_strength = _calculate_strength(current_ext_name)\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_ext_name = current_ext_name\n\n    return f\"{class_name}.{strongest_ext_name}\""}
{"task_id": "HumanEval/152", "solution": "def compare(game, guess):\n    \"\"\"\n    Calculates the absolute difference between corresponding elements of game scores and user guesses.\n    Returns a new list indicating how far off each guess was.\n    \"\"\"\n    result = []\n    for i in range(len(game)):\n        diff = abs(game[i] - guess[i])\n        result.append(diff)\n    return result"}
{"task_id": "HumanEval/153", "solution": "class Extension:\n    \"\"\"A data model to hold an extension's name and its calculated strength.\n    Immutable after creation, providing methods to access its attributes.\"\"\"\n    def __init__(self, name, strength):\n        self._name = name\n        self._strength = strength\n\n    def get_name(self):\n        return self._name\n\n    def get_strength(self):\n        return self._strength\nclass ExtensionStrengthCalculator:\n    \"\"\"Calculates the strength of a single extension string.\"\"\"\n    def calculate(self, extension_name):\n        cap_count = sum(1 for char in extension_name if 'A' <= char <= 'Z')\n        sm_count = sum(1 for char in extension_name if 'a' <= char <= 'z')\n        return cap_count - sm_count\nclass StrongestExtensionService:\n    \"\"\"Orchestrates finding the strongest extension and formatting the output.\"\"\"\n    def __init__(self, calculator):\n        self._calculator = calculator\n\n    def find_strongest_extension(self, class_name, extensions):\n        strongest_ext_obj = None\n\n        for ext_name in extensions:\n            strength = self._calculator.calculate(ext_name)\n            current_ext = Extension(ext_name, strength)\n\n            if strongest_ext_obj is None or current_ext.get_strength() > strongest_ext_obj.get_strength():\n                strongest_ext_obj = current_ext\n\n        return f\"{class_name}.{strongest_ext_obj.get_name()}\"\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension for a given class name and returns a formatted string.\n    Strength is calculated as (uppercase count - lowercase count), with ties broken by first appearance.\"\"\"\n    calculator = ExtensionStrengthCalculator()\n    service = StrongestExtensionService(calculator)\n    return service.find_strongest_extension(class_name, extensions)"}
{"task_id": "HumanEval/154", "solution": "def _generate_rotations(s: str) -> list[str]:\n    \"\"\"Generates all unique cyclic rotations of a string.\n    Handles empty string by returning `[\"\"]`.\"\"\"\n    if not s:\n        return [\"\"]\n\n    rotations = set()\n    n = len(s)\n    for i in range(n):\n        rotated_s = s[i:] + s[:i]\n        rotations.add(rotated_s)\n    return list(rotations)\ndef cycpattern_check(a , b):\n    \"\"\"Checks if the second word or any of its rotations is a substring in the first word.\n    Handles various edge cases like empty strings or `b` being longer than `a`.\"\"\"\n    if not b:\n        return True  # An empty string is a substring of any string.\n    if not a:\n        return False # If 'a' is empty and 'b' is not, no match.\n    if len(b) > len(a):\n        return False # A longer string cannot be a substring of a shorter one.\n\n    rotations_of_b = _generate_rotations(b)\n\n    for rotation in rotations_of_b:\n        if rotation in a:\n            return True\n\n    return False"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a, b):\n    \"\"\"\n    Checks if b or any of its cyclic rotations is a substring of a.\n    \"\"\"\n\n    def _generate_rotations(s):\n        \"\"\"Generates all unique cyclic rotations of string s.\"\"\"\n        if not s:\n            return [\"\"]\n\n        rotations = set()\n        n = len(s)\n        for i in range(n):\n            rotated_s = s[i:] + s[:i]\n            rotations.add(rotated_s)\n        return list(rotations)\n\n    if not b: # An empty string is a substring of any string.\n        return True\n\n    if len(b) > len(a): # A longer string cannot be a substring of a shorter one.\n        return False\n\n    rotations_of_b = _generate_rotations(b)\n    for rotation in rotations_of_b:\n        if rotation in a:\n            return True\n\n    return False"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    \"\"\"\n    ROMAN_MAP = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n\n    result = []\n    for value, symbol in ROMAN_MAP:\n        while number >= value:\n            result.append(symbol)\n            number -= value\n\n    return \"\".join(result).lower()"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Convert the absolute value of the number to a string to iterate through its digits.\n    abs_num_str = str(abs(num))\n\n    for digit_char in abs_num_str:\n        digit = int(digit_char)\n        # Determine if the digit is even or odd and increment the respective counter.\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
