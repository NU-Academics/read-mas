{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts vowels ('a','e','i','o','u') in a string, case-insensitively.\n    'y' is counted only if it's the last character.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    \"\"\"\n    STANDARD_VOWELS = {'a', 'e', 'i', 'o', 'u'}\n    Y_CHAR = 'y'\n\n    count = 0\n    lower_s = s.lower()\n\n    for char in lower_s:\n        if char in STANDARD_VOWELS:\n            count += 1\n\n    if s and lower_s.endswith(Y_CHAR):\n        count += 1\n\n    return count"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"\n    Circularly shifts digits of an integer to the right or reverses them if shift is too large.\n    Uses the absolute value of x for digit manipulation.\n    \"\"\"\n    s = str(abs(x))\n    n = len(s)\n\n    if shift > n:\n        return s[::-1]\n    else:\n        # Calculate the effective shift amount, handling cases like shift = 0 or shift = n.\n        actual_shift = shift % n\n        return s[n - actual_shift:] + s[:n - actual_shift]"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int):\n    \"\"\"The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    >>> fibfib(1)\n    0\n    >>> fibfib(5)\n    4\n    >>> fibfib(8)\n    24\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    # Initialize a dynamic programming array to store computed values.\n    # This ensures O(n) time complexity by avoiding re-computation.\n    dp = [0] * (n + 1)\n    dp[0] = 0\n    dp[1] = 0\n    dp[2] = 1\n\n    for i in range(3, n + 1):\n        dp[i] = dp[i - 1] + dp[i - 2] + dp[i - 3]\n\n    return dp[n]"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int) -> int:\n    \"\"\"Computes the n-th FibFib number using memoization.\n    The cache is stored as a function attribute for persistence across calls.\n\n    >>> fibfib(1)\n    0\n    >>> fibfib(5)\n    4\n    >>> fibfib(8)\n    24\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if not hasattr(fibfib, '_cache'):\n        fibfib._cache = {0: 0, 1: 0, 2: 1}\n\n    if n in fibfib._cache:\n        return fibfib._cache[n]\n\n    result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n    fibfib._cache[n] = result\n    return result"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculates the sum of ASCII values for all uppercase characters in a string.\n    It iterates through the string, summing the ordinal values of 'A' through 'Z'.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if 'A' <= char <= 'Z':  # Check if the character is an uppercase letter\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    s = str(x)\n    n = len(s)\n\n    if shift > n:\n        return s[::-1]\n    else:\n        effective_shift = shift % n\n        return s[-effective_shift:] + s[:-effective_shift]"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts vowels (a, e, i, o, u) case-insensitively, and 'y' if it's the last character.\n    Iterates through the string to apply vowel counting rules and returns the total.\n    \"\"\"\n    count = 0\n    standard_vowels = \"aeiou\"\n\n    for i, char in enumerate(s):\n        lower_char = char.lower()\n        if lower_char in standard_vowels:\n            count += 1\n        elif lower_char == 'y' and i == len(s) - 1:\n            count += 1\n    return count"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculates the sum of ASCII codes of only the uppercase characters in a string.\n    Returns the sum of ASCII values of uppercase characters.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/69", "solution": "def search(lst: list[int]) -> int:\n    \"\"\"\n    Finds the greatest integer in a list whose frequency is greater than or equal to its value.\n    Returns -1 if no such integer exists.\n    \"\"\"\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n\n    candidates = []\n    for num, freq in counts.items():\n        if freq >= num:\n            candidates.append(num)\n\n    if not candidates:\n        return -1\n\n    return max(candidates)"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr: list[int]) -> list[int]:\n    \"\"\"\n    Identifies and returns the smallest even value and its smallest index from a list of non-negative integers.\n    If no even values or the array is empty, an empty list is returned.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n            elif value == smallest_even_value and i < smallest_even_index:\n                smallest_even_index = i\n\n    if smallest_even_index != -1:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    \"\"\"\n    Finds the greatest positive integer x whose frequency in the list is greater than or equal to x.\n    Returns -1 if no such integer exists.\n    \"\"\"\n    frequency_map = {}\n    for item in lst:\n        frequency_map[item] = frequency_map.get(item, 0) + 1\n\n    candidates = []\n    for num, freq in frequency_map.items():\n        if num > 0 and freq >= num:\n            candidates.append(num)\n\n    if not candidates:\n        return -1\n    return max(candidates)"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Given an array of non-negative integer nodes, returns the smallest even-valued node and its index.\n    If multiple nodes share the smallest even value, the node with the smallest index is chosen.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = None\n    smallest_even_index = None\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even\n            if smallest_even_value is None or value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n            elif value == smallest_even_value:\n                # The first occurrence (smallest index) is naturally prioritized by iteration order.\n                pass\n\n    if smallest_even_value is not None and smallest_even_index is not None:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst: list[int]) -> list[int]:\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    if not lst:\n        return []\n\n    mutable_list = sorted(lst) # A sorted copy simplifies finding min/max.\n    result_list = []\n    is_min_turn = True\n\n    while mutable_list:\n        if is_min_turn:\n            result_list.append(mutable_list.pop(0)) # Remove smallest remaining.\n        else:\n            result_list.append(mutable_list.pop()) # Remove largest remaining.\n        is_min_turn = not is_min_turn\n\n    return result_list"}
{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s: str, n: int) -> int:\n    \"\"\"\n    Extracts apple and orange counts from a string and calculates the number of mangoes.\n    Assumes valid input string format and non-negative counts based on critical requirements.\n    \"\"\"\n    # Extract the number of apples using regex.\n    match_apples = re.search(r'(\\d+)\\s*apples', s)\n    apples = int(match_apples.group(1))\n\n    # Extract the number of oranges using regex.\n    match_oranges = re.search(r'(\\d+)\\s*oranges', s)\n    oranges = int(match_oranges.group(1))\n\n    # Calculate the number of mangoes.\n    mangoes = n - (apples + oranges)\n\n    return mangoes"}
{"task_id": "HumanEval/67", "solution": "def fruit_distribution(s, n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket given apple and orange counts and total fruits.\n    It parses the input string for apple and orange counts and subtracts them from the total.\n    \"\"\"\n    # Parse the input string `s` to extract apple and orange counts.\n    # The string is in the format \"X apples and Y oranges\".\n    parts = s.split(\" apples and \")\n\n    # Convert extracted apple count to an integer.\n    apples_str = parts[0]\n    apples = int(apples_str)\n\n    # Convert extracted orange count to an integer.\n    oranges_part = parts[1]\n    oranges_str = oranges_part.replace(\" oranges\", \"\")\n    oranges = int(oranges_str)\n\n    # Calculate the total number of apples and oranges.\n    total_apples_oranges = apples + oranges\n\n    # Calculate the number of mango fruits by subtracting apples and oranges from the total fruits.\n    mango_fruits = n - total_apples_oranges\n\n    # Return the final calculated value.\n    return mango_fruits"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Sorts a list of integers in a specific strange order (min, max, next min, next max, ...).\n    Returns a new list with elements from the input list sorted this way.\n    \"\"\"\n    if not lst:\n        return []\n\n    # Create a sorted copy of the input list to efficiently access min and max.\n    working_list = sorted(lst)\n    result_list = []\n\n    # While elements remain, alternately take the smallest and largest.\n    while working_list:\n        result_list.append(working_list.pop(0))  # Append the current minimum (first element).\n        if working_list:\n            result_list.append(working_list.pop())  # Append the current maximum (last element).\n\n    return result_list"}
{"task_id": "HumanEval/71", "solution": "def triangle_area(a, b, c):\n    \"\"\"\n    Calculates the area of a triangle given its three side lengths.\n    Returns the rounded area or -1 if the sides do not form a valid triangle.\n    \"\"\"\n    import math\n\n    def _is_valid_triangle(s1: float, s2: float, s3: float) -> bool:\n        \"\"\"Checks if the given side lengths form a valid triangle.\"\"\"\n        if s1 <= 0 or s2 <= 0 or s3 <= 0:\n            return False\n        return (s1 + s2 > s3) and (s1 + s3 > s2) and (s2 + s3 > s1)\n\n    def _calculate_triangle_area(s1: float, s2: float, s3: float) -> float:\n        \"\"\"Computes the area using Heron's formula for valid triangle sides.\"\"\"\n        s = (s1 + s2 + s3) / 2\n        area_squared = s * (s - s1) * (s - s2) * (s - s3)\n        # Handle potential floating point inaccuracies that might make area_squared slightly negative\n        if area_squared < 0:\n            area_squared = 0\n        return math.sqrt(area_squared)\n\n    if not _is_valid_triangle(a, b, c):\n        return -1.00\n\n    area = _calculate_triangle_area(a, b, c)\n    return round(area, 2)"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q, w):\n    \"\"\"\n    Determines if the object q will fly based on balance and weight.\n    An object q will fly if it's a palindromic list and its sum is less than or equal to w.\n    \"\"\"\n    is_balanced = (q == q[::-1])\n    total_weight = sum(q)\n    return is_balanced and (total_weight <= w)"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Finds the minimum number of elements that need to be changed to make the array palindromic.\n    It counts mismatches between elements at symmetric positions from the ends.\n    \"\"\"\n    changes = 0\n    left = 0\n    right = len(arr) - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    '''\n    Calculates the area of a triangle given three side lengths.\n    Returns the area rounded to 2 decimal places or -1.0 for invalid triangles.\n    '''\n\n    class TriangleValidator:\n        # Checks if three side lengths form a valid triangle.\n        # Returns True if valid, False otherwise.\n        def is_valid(self, side_a: float, side_b: float, side_c: float) -> bool:\n            if not (side_a > 0 and side_b > 0 and side_c > 0):\n                return False\n            return (side_a + side_b > side_c) and \\\n                   (side_a + side_c > side_b) and \\\n                   (side_b + side_c > side_a)\n\n    class TriangleCalculator:\n        # Calculates the area of a triangle using Heron's formula and rounds it.\n        # Assumes the input sides form a valid triangle.\n        def calculate_area(self, side_a: float, side_b: float, side_c: float) -> float:\n            s = (side_a + side_b + side_c) / 2\n            area_squared = s * (s - side_a) * (s - side_b) * (s - side_c)\n            # Handle potential floating point errors near zero which could result in negative area_squared\n            if area_squared < 0:\n                area_squared = 0\n            area = math.sqrt(area_squared)\n            return round(area, 2)\n\n    INVALID_TRIANGLE_CODE: float = -1.0\n\n    validator = TriangleValidator()\n    if not validator.is_valid(a, b, c):\n        return INVALID_TRIANGLE_CODE\n\n    calculator = TriangleCalculator()\n    area = calculator.calculate_area(a, b, c)\n    return area"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum changes needed to make an array palindromic.\n    It counts differing elements from both ends inwards.\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return 0\n\n    changes = 0\n    left = 0\n    right = n - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q, w):\n    \"\"\"\n    Returns True if the object q will fly, and False otherwise.\n    An object flies if it's palindromic and its sum of elements is less than or equal to w.\n    \"\"\"\n    is_balanced = (q == q[::-1])\n    total_weight = sum(q)\n    is_within_weight = (total_weight <= w)\n    return is_balanced and is_within_weight"}
