{"task_id": "HumanEval/75", "solution": "import itertools\ndef _is_prime(num: int) -> bool:\n    \"\"\"Checks if a number is prime.\n    Returns True for prime numbers, False otherwise.\"\"\"\n    if num < 2:\n        return False\n    for i in range(2, int(num**0.5) + 1):\n        if num % i == 0:\n            return False\n    return True\ndef _generate_primes_up_to(limit: int) -> list[int]:\n    \"\"\"Generates a list of prime numbers up to and including the limit.\"\"\"\n    primes = []\n    for num in range(2, limit + 1):\n        if _is_prime(num):\n            primes.append(num)\n    return primes\ndef is_multiply_prime(a: int) -> bool:\n    \"\"\"Checks if 'a' is the product of exactly three distinct prime numbers.\n    The function assumes 'a' is an integer such that 0 < a < 100.\n    \"\"\"\n    # The smallest product of three distinct primes is 2 * 3 * 5 = 30.\n    if a < 30:\n        return False\n\n    # For a < 100, the largest possible prime factor must be less than 100 / (2 * 3) = 16.66.\n    # So, we only need to consider primes up to 16 or 17.\n    # Generating primes up to (a // 6) + 1 ensures all relevant primes are included.\n    primes = _generate_primes_up_to((a // 6) + 1)\n\n    for p1, p2, p3 in itertools.combinations(primes, 3):\n        if p1 * p2 * p3 == a:\n            return True\n    return False"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Checks if the given number is the multiplication of 3 distinct prime numbers\n    and false otherwise, for inputs (a) less than 100.\n    \"\"\"\n\n    def is_prime_local(n):\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    primes = []\n    # Generate all prime numbers up to 'a', as factors cannot exceed 'a'.\n    # The problem statement guarantees 0 < a < 100.\n    for num in range(2, a + 1):\n        if is_prime_local(num):\n            primes.append(num)\n\n    n_primes = len(primes)\n    # Iterate through all unique combinations of three distinct primes\n    for i in range(n_primes):\n        for j in range(i + 1, n_primes): # Ensure j > i for distinct primes\n            for k in range(j + 1, n_primes): # Ensure k > j for distinct primes\n                product = primes[i] * primes[j] * primes[k]\n                if product == a:\n                    return True\n                if product > a: # Optimization: if product exceeds 'a', no need to check larger k\n                    break\n    return False"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"\n    Your task is to write a function that returns true if a number x is a simple\n    power of n and false in other cases.\n    x is a simple power of n if n**int=x\n    For example:\n    is_simple_power(1, 4) => true\n    is_simple_power(2, 2) => true\n    is_simple_power(8, 2) => true\n    is_simple_power(3, 2) => false\n    is_simple_power(3, 1) => false\n    is_simple_power(5, 3) => false\n    \"\"\"\n    if x == 1:\n        return True\n\n    if n == 1:\n        return False\n\n    if n == 0:\n        return x == 0\n\n    # For x > 1 and n > 1, repeatedly divide x by n.\n    current_x = x\n    while current_x > 1:\n        if current_x % n != 0:\n            return False\n        current_x //= n\n    return current_x == 1"}
{"task_id": "HumanEval/78", "solution": "class Constants:\n    \"\"\"Provides a centralized location for application-wide constants.\"\"\"\n    PRIME_HEX_DIGITS = {'2', '3', '5', '7', 'B', 'D'}\nclass HexKeyCounter:\n    \"\"\"Encapsulates the core business logic for identifying and counting prime hexadecimal digits.\"\"\"\n\n    @staticmethod\n    def count_prime_hex_digits(hex_string: str) -> int:\n        \"\"\"Counts prime hexadecimal digits in a string.\n        Iterates through the string and checks each character against predefined prime digits.\"\"\"\n        count = 0\n        for digit in hex_string:\n            if digit in Constants.PRIME_HEX_DIGITS:\n                count += 1\n        return count\ndef hex_key(num: str) -> int:\n    \"\"\"Serves as the public entry point to count prime hexadecimal digits.\n    It delegates the core counting logic to HexKeyCounter.\"\"\"\n    return HexKeyCounter.count_prime_hex_digits(num)"}
{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"\n    Checks if a string is happy.\n    A string is happy if its length is at least 3 and every 3 consecutive letters are distinct.\n    \"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        # Check if the three consecutive characters are distinct\n        if not (s[i] != s[i+1] and s[i] != s[i+2] and s[i+1] != s[i+2]):\n            return False\n    return True"}
