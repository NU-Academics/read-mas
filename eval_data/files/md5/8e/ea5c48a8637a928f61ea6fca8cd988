{"task_id": "HumanEval/99", "solution": "import math\ndef closest_integer(value):\n    '''\n    Create a function that takes a value (string) representing a number\n    and returns the closest integer to it. If the number is equidistant\n    from two integers, round it away from zero.\n    '''\n    num_float = float(value)\n\n    floor_num = math.floor(num_float)\n    ceil_num = math.ceil(num_float)\n\n    # Check if equidistant (fractional part is exactly 0.5)\n    if abs(num_float - floor_num) == 0.5:\n        if num_float >= 0:\n            return int(ceil_num)  # Round up for positive .5 (away from zero)\n        else:\n            return int(floor_num) # Round down for negative .5 (away from zero)\n    else:\n        # Standard rounding to the nearest integer for other cases\n        return int(round(num_float))"}
{"task_id": "HumanEval/99", "solution": "import math\ndef closest_integer(value):\n    \"\"\"\n    Create a function that takes a value (string) representing a number\n    and returns the closest integer to it. If the number is equidistant\n    from two integers, round it away from zero.\n\n    Examples\n    >>> closest_integer(\"10\")\n    10\n    >>> closest_integer(\"15.3\")\n    15\n\n    Note:\n    Rounding away from zero means that if the given number is equidistant\n    from two integers, the one you should return is the one that is the\n    farthest from zero. For example closest_integer(\"14.5\") should\n    return 15 and closest_integer(\"-14.5\") should return -15.\n    \"\"\"\n    num_float = float(value)\n\n    floor_num = math.floor(num_float)\n    ceil_num = math.ceil(num_float)\n\n    # Check if equidistant from two integers (fractional part is exactly 0.5)\n    if abs(num_float - floor_num) == 0.5:\n        if num_float >= 0:\n            return int(ceil_num)  # Positive X.5 rounds up (e.g., 14.5 -> 15)\n        else:\n            return int(floor_num) # Negative X.5 rounds down (e.g., -14.5 -> -15)\n    else:\n        # Standard rounding to the closest integer\n        if abs(num_float - floor_num) < abs(num_float - ceil_num):\n            return int(floor_num)\n        else:\n            return int(ceil_num)"}
{"task_id": "HumanEval/102", "solution": "def choose_num(x, y):\n    \"\"\"\n    Finds the largest even integer in the inclusive range [x, y].\n    Returns -1 if no such number exists, including when x > y.\n    \"\"\"\n    if x > y:\n        return -1\n\n    # Iterate downwards from y to x to find the biggest even number first.\n    for num in range(y, x - 1, -1):\n        if num % 2 == 0:\n            return num\n\n    return -1"}
{"task_id": "HumanEval/102", "solution": "def choose_num(x: int, y: int) -> int:\n    \"\"\"\n    This function finds the biggest even integer within the range [x, y] inclusive.\n    If no such number exists, the function returns -1.\n    \"\"\"\n    if x > y:\n        return -1\n\n    if y % 2 == 0:\n        return y\n    elif (y - 1) >= x:\n        return y - 1\n    else:\n        return -1"}
{"task_id": "HumanEval/103", "solution": "def rounded_avg(n, m):\n    \"\"\"Computes the rounded binary average of integers in a range.\n    Returns -1 if n is greater than m.\"\"\"\n\n    if n > m:\n        return -1\n\n    count = m - n + 1\n    total_sum = sum(range(n, m + 1))\n    float_average = total_sum / count\n    rounded_int_average = round(float_average)\n    binary_string = bin(rounded_int_average)\n\n    return binary_string"}
{"task_id": "HumanEval/104", "solution": "def unique_digits(x):\n    \"\"\"Given a list of positive integers x. return a sorted list of all\n    elements that hasn't any even digit.\n    Note: Returned list should be sorted in increasing order.\n    \"\"\"\n\n    filtered_list = []\n\n    # Define a set of even digit characters for efficient lookup.\n    even_digits_chars = {'0', '2', '4', '6', '8'}\n\n    for number in x:\n        # Skip non-positive integers as per business rule BR1.\n        if number <= 0:\n            continue\n\n        # Check if the number contains any even digit.\n        s_num = str(number)\n        contains_even_digit = False\n        for digit_char in s_num:\n            if digit_char in even_digits_chars:\n                contains_even_digit = True\n                break  # Found an even digit, no need to check further for this number\n\n        # If no even digits were found, add the number to the result list.\n        if not contains_even_digit:\n            filtered_list.append(number)\n\n    # Sort the collected numbers in increasing order as per FR4.\n    filtered_list.sort()\n\n    return filtered_list"}
{"task_id": "HumanEval/106", "solution": "def _calculate_factorial(num: int) -> int:\n    \"\"\"Calculates the factorial of a non-negative integer.\"\"\"\n    if num == 0:\n        return 1\n    result = 1\n    for i in range(1, num + 1):\n        result *= i\n    return result\ndef _calculate_sum_up_to(num: int) -> int:\n    \"\"\"Calculates the sum of integers from 1 up to num.\"\"\"\n    return num * (num + 1) // 2\ndef f(n: int) -> list[int]:\n    \"\"\"\n    Implement the function f that takes n as a parameter,\n    and returns a list of size n, such that the value of the element at index i is the factorial of i if i is even\n    or the sum of numbers from 1 to i otherwise.\n    i starts from 1.\n    the factorial of i is the multiplication of the numbers from 1 to i (1 * 2 * ... * i).\n    Example:\n    f(5) == [1, 2, 6, 24, 15]\n    \"\"\"\n    results = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:  # Even 1-based index\n            results.append(_calculate_factorial(i))\n        else:  # Odd 1-based index\n            results.append(_calculate_sum_up_to(i))\n    return results"}
{"task_id": "HumanEval/103", "solution": "def rounded_avg(n, m):\n    \"\"\"Computes the rounded average of a range of integers and converts it to binary.\n    Returns \"-1\" if n is greater than m.\"\"\"\n    if n > m:\n        return \"-1\"\n\n    count = m - n + 1\n    # Calculate sum using the arithmetic series formula.\n    sum_val = count * (n + m) // 2\n\n    # Calculate the floating-point average.\n    avg_val = sum_val / count\n\n    # Round the average to the nearest integer (round half to even).\n    rounded_avg_val = round(avg_val)\n\n    # Convert the rounded integer to its binary string representation.\n    return bin(rounded_avg_val)"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Transforms a list of integers: filters 1-9, sorts, reverses, and converts to words.\n    Ignores numbers outside the 1-9 range and processes valid integers.\n    \"\"\"\n    NUMBER_WORDS = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    # FR5: Return empty if input array is empty.\n    if not arr:\n        return []\n\n    # FR1: Filter numbers between 1 and 9 inclusive.\n    # Elements outside this range are silently ignored, as are non-comparable types.\n    valid_numbers = [n for n in arr if 1 <= n <= 9]\n\n    # FR5: Return empty if no valid numbers after filtering.\n    if not valid_numbers:\n        return []\n\n    # FR2: Sort filtered integers in ascending order.\n    valid_numbers.sort()\n\n    # FR3: Reverse the sorted array.\n    valid_numbers.reverse()\n\n    # FR4: Convert each integer to its corresponding English word.\n    result_words = [NUMBER_WORDS[n] for n in valid_numbers]\n\n    return result_words"}
{"task_id": "HumanEval/104", "solution": "def unique_digits(x):\n    \"\"\"Given a list of positive integers x. return a sorted list of all\n    elements that hasn't any even digit.\n\n    Note: Returned list should be sorted in increasing order.\n    \"\"\"\n\n    def _has_even_digit(number: int) -> bool:\n        \"\"\"Checks if a positive integer contains any even digit (0, 2, 4, 6, 8).\"\"\"\n        temp_num = number\n        while temp_num > 0:\n            digit = temp_num % 10\n            if digit % 2 == 0:\n                return True\n            temp_num //= 10\n        return False\n\n    filtered_numbers = []\n    for num in x:\n        if not _has_even_digit(num):\n            filtered_numbers.append(num)\n\n    filtered_numbers.sort()\n    return filtered_numbers"}
{"task_id": "HumanEval/106", "solution": "def f(n):\n    \"\"\"Implement the function f that takes n as a parameter.\n    It returns a list where elements are factorial of i if i is even, or sum of 1 to i if i is odd.\"\"\"\n    result_list = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:  # i is even, calculate factorial\n            current_factorial = 1\n            for j in range(1, i + 1):\n                current_factorial *= j\n            result_list.append(current_factorial)\n        else:  # i is odd, calculate sum from 1 to i\n            current_sum = i * (i + 1) // 2\n            result_list.append(current_sum)\n    return result_list"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Transforms an array of integers by filtering, sorting, reversing,\n    and converting specific numbers to their English word representations.\n    \"\"\"\n    if not arr:\n        return []\n\n    # Number-to-word mapping (within the function's scope)\n    NUMBER_WORDS = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\",\n        5: \"Five\", 6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    # FR1 & FR6: Filter to include only numbers between 1 and 9\n    # FR2: Sort the filtered integers in ascending order\n    # Per critical requirement, no isinstance() check is performed.\n    filtered_sorted_numbers = [n for n in arr if 1 <= n <= 9]\n    filtered_sorted_numbers.sort()\n\n    # FR3: Reverse the sorted array\n    reversed_numbers = filtered_sorted_numbers[::-1]\n\n    # FR4: Convert each integer to its corresponding English word\n    result_words = [NUMBER_WORDS.get(num) for num in reversed_numbers if NUMBER_WORDS.get(num)]\n\n    return result_words"}
{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n\n    # Helper function to check if a number is a palindrome.\n    def is_palindrome(num: int) -> bool:\n        return str(num) == str(num)[::-1]\n\n    # Helper function to check if a number is even.\n    def is_even(num: int) -> bool:\n        return num % 2 == 0\n\n    even_count = 0\n    odd_count = 0\n    for i in range(1, n + 1):\n        if is_palindrome(i):\n            if is_even(i):\n                even_count += 1\n            else:\n                odd_count += 1\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n\n    def is_palindrome(num: int) -> bool:\n        \"\"\"\n        Checks if an integer is a palindrome.\n        It converts the number to a string and checks if it reads the same forwards and backwards.\n        \"\"\"\n        return str(num) == str(num)[::-1]\n\n    even_count = 0\n    odd_count = 0\n\n    for i in range(1, n + 1):\n        if is_palindrome(i):\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Counts integers in an array whose sum of digits is positive, with special rules for negative numbers.\n    The most significant digit of a negative number is treated as negative.\n    \"\"\"\n\n    def _calculate_digit_sum(num: int) -> int:\n        \"\"\"\n        Calculates the sum of digits for an integer, applying special rules for negative numbers.\n        The first digit of a negative number is treated as negative.\n        \"\"\"\n        if num == 0:\n            return 0\n\n        s_num = str(num)\n        digit_sum = 0\n        is_negative = False\n\n        if s_num[0] == '-':\n            is_negative = True\n            s_num = s_num[1:] # Remove the minus sign\n\n        for i, digit_char in enumerate(s_num):\n            digit_value = int(digit_char)\n            if is_negative and i == 0:\n                digit_sum -= digit_value # First digit contributes its negative value.\n            else:\n                digit_sum += digit_value # Subsequent digits contribute their positive value.\n        return digit_sum\n\n    total_count = 0\n    for num in arr:\n        if _calculate_digit_sum(num) > 0:\n            total_count += 1\n    return total_count"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr: list[int]) -> bool:\n    \"\"\"Determines if an array can be sorted in non-decreasing order by performing\n    right shift operations. It checks all possible shifted versions of the array.\n    \"\"\"\n    if not arr:\n        return True\n\n    def is_sorted(current_arr: list[int]) -> bool:\n        \"\"\"Checks if the given array is sorted in non-decreasing order.\"\"\"\n        for i in range(len(current_arr) - 1):\n            if current_arr[i] > current_arr[i+1]:\n                return False\n        return True\n\n    def right_shift(current_arr: list[int]) -> list[int]:\n        \"\"\"Performs a single right shift operation, moving the last element to the front.\"\"\"\n        if not current_arr:\n            return []\n        return [current_arr[-1]] + current_arr[:-1]\n\n    n = len(arr)\n    current_arr_state = list(arr) # Create a copy to perform shifts\n\n    # Iterate through all 'n' possible distinct shifts\n    for _ in range(n):\n        if is_sorted(current_arr_state):\n            return True\n        current_arr_state = right_shift(current_arr_state)\n\n    return False"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr: list[int]) -> int:\n    \"\"\"\n    Counts numbers in an array where the sum of their 'signed digits' is greater than 0.\n    For negative numbers, the first digit is negative and the rest are positive.\n    >>> count_nums([]) == 0\n    >>> count_nums([-1, 11, -11]) == 1\n    >>> count_nums([1, 1, 2]) == 3\n    \"\"\"\n\n    def _extract_digits(num: int) -> list[int]:\n        \"\"\"Extracts the absolute digits of an integer as a list.\"\"\"\n        if num == 0:\n            return [0]\n        return [int(d) for d in str(abs(num))]\n\n    def _calculate_positive_sum(num: int) -> int:\n        \"\"\"Calculates the sum of digits for a non-negative number.\"\"\"\n        digits = _extract_digits(num)\n        return sum(digits)\n\n    def _calculate_negative_sum(num: int) -> int:\n        \"\"\"Calculates the signed digit sum for a negative number.\"\"\"\n        digits = _extract_digits(abs(num))\n        # The first digit (after the minus sign) is considered negative\n        first_digit_signed = -digits[0]\n        # The remaining digits are summed as positive\n        remaining_sum = sum(digits[1:])\n        return first_digit_signed + remaining_sum\n\n    def _calculate_signed_sum(num: int) -> int:\n        \"\"\"Calculates the signed digit sum based on the number's sign.\"\"\"\n        if num >= 0:\n            return _calculate_positive_sum(num)\n        else:\n            return _calculate_negative_sum(num)\n\n    total_count = 0\n    for num in arr:\n        signed_sum = _calculate_signed_sum(num)\n        if signed_sum > 0:\n            total_count += 1\n    return total_count"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"Determines if an array can be sorted in non-decreasing order by repeatedly applying a right-shift operation.\n    Returns True if sortable, False otherwise; an empty array is considered sorted.\n    \"\"\"\n    if not arr:\n        return True\n\n    n = len(arr)\n    sorted_arr = sorted(arr)\n\n    for i in range(n):\n        # Perform 'i' right shifts by slicing and concatenating the list.\n        # This moves the last 'i' elements to the beginning.\n        # For i=0, arr[-0:] is equivalent to arr[:], and arr[:-0] is equivalent to arr[:].\n        # So arr[-0:] + arr[:-0] would incorrectly result in arr + arr.\n        # The correct shifting for 'i' right shifts (moving the last 'i' elements to the front) is:\n        # arr[n-i:] + arr[:n-i]\n        shifted_arr = arr[n-i:] + arr[:n-i]\n        if shifted_arr == sorted_arr:\n            return True\n    return False"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"Determines if lst1 can be made all even by exchanging elements with lst2. Returns \"YES\" if possible, \"NO\" otherwise.\"\"\"\n    odds_in_lst1_count = 0\n    for num in lst1:\n        if num % 2 != 0:\n            odds_in_lst1_count += 1\n\n    evens_in_lst2_count = 0\n    for num in lst2:\n        if num % 2 == 0:\n            evens_in_lst2_count += 1\n\n    if odds_in_lst1_count <= evens_in_lst2_count:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"In this problem, you will implement a function that takes two lists of numbers,\n    and determines whether it is possible to perform an exchange of elements\n    between them to make lst1 a list of only even numbers.\n    There is no limit on the number of exchanged elements between lst1 and lst2.\n    If it is possible to exchange elements between the lst1 and lst2 to make\n    all the elements of lst1 to be even, return \"YES\".\n    Otherwise, return \"NO\".\n    For example:\n    exchange([1, 2, 3, 4], [1, 2, 3, 4]) => \"YES\"\n    exchange([1, 2, 3, 4], [1, 5, 3, 4]) => \"NO\"\n    It is assumed that the input lists will be non-empty.\n    \"\"\"\n    odd_count_lst1 = sum(1 for x in lst1 if x % 2 != 0)\n    even_count_lst2 = sum(1 for x in lst2 if x % 2 == 0)\n\n    if odd_count_lst1 == 0:\n        return \"YES\"\n    elif even_count_lst2 >= odd_count_lst1:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s,c):\n    \"\"\"Task\n    We are given two strings s and c, you have to deleted all the characters in s that are equal to any character in c\n    then check if the result string is palindrome.\n    A string is called palindrome if it reads the same backward as forward.\n    You should return a tuple containing the result string and True/False for the check.\n    Example\n    For s = \"abcde\", c = \"ae\", the result should be ('bcd',False)\n    For s = \"abcdef\", c = \"b\"  the result should be ('acdef',False)\n    For s = \"abcdedcba\", c = \"ab\", the result should be ('cdedc',True)\n    \"\"\"\n\n    # Convert c to a set for efficient character lookups\n    chars_to_delete = set(c)\n\n    modified_s_chars = []\n    for char_s in s:\n        if char_s not in chars_to_delete:\n            modified_s_chars.append(char_s)\n\n    modified_s = \"\".join(modified_s_chars)\n\n    # Check if the resulting string is a palindrome\n    is_palindrome_result = modified_s == modified_s[::-1]\n\n    return (modified_s, is_palindrome_result)"}
{"task_id": "HumanEval/111", "solution": "import collections\nfrom typing import Dict\ndef histogram(test: str) -> Dict[str, int]:\n    \"\"\"Given a string representing space-separated lowercase letters, returns a dictionary\n    of letters with the most repetitions and their counts. If the input is empty or contains\n    only spaces, an empty dictionary is returned.\n    \"\"\"\n    if not test:\n        return {}\n\n    # Split the input string and filter out any non-letter elements (like empty strings from multiple spaces).\n    # This ensures only actual letters are considered for counting as per BRule3.\n    valid_letters = [char for char in test.split(' ') if char.isalpha()]\n\n    # If no valid letters are found after filtering (e.g., input was \"   \"), return an empty dictionary.\n    if not valid_letters:\n        return {}\n\n    # Count the occurrences of each valid letter.\n    letter_counts = collections.Counter(valid_letters)\n\n    # Find the maximum frequency among all counted letters.\n    max_frequency = max(letter_counts.values())\n\n    # Collect all letters that have the maximum frequency into the result dictionary.\n    result = {letter: count for letter, count in letter_counts.items() if count == max_frequency}\n\n    return result"}
{"task_id": "HumanEval/111", "solution": "def histogram(test):\n    \"\"\"Given a string representing space-separated lowercase letters, return a dictionary\n    of the letter with the most repetition and containing the corresponding count.\n    If several letters have the same occurrence, return all of them.\"\"\"\n\n    letters = test.split() # Split the input string into individual letter strings.\n\n    # Count the occurrences of each unique letter.\n    frequencies = {}\n    for letter in letters:\n        frequencies[letter] = frequencies.get(letter, 0) + 1\n\n    # Handle the case of an empty input string gracefully.\n    if not frequencies:\n        return {}\n\n    # Identify the maximum frequency among all letters.\n    max_count = max(frequencies.values())\n\n    # Filter the frequencies to include only the letters that match the maximum frequency.\n    most_frequent_letters = {}\n    for letter, count in frequencies.items():\n        if count == max_count:\n            most_frequent_letters[letter] = count\n\n    return most_frequent_letters"}
{"task_id": "HumanEval/112", "solution": "def _delete_chars(s, chars_to_delete):\n    \"\"\"Deletes all characters in s that are present in chars_to_delete.\n    Returns a new string with the remaining characters.\"\"\"\n    chars_set = set(chars_to_delete)\n    result_chars = [char_s for char_s in s if char_s not in chars_set]\n    return \"\".join(result_chars)\ndef _is_palindrome(s):\n    \"\"\"Checks if a string is a palindrome.\n    A palindrome reads the same forwards and backward.\"\"\"\n    return s == s[::-1]\ndef reverse_delete(s, c):\n    \"\"\"Deletes characters from string 's' that are in string 'c',\n    then checks if the resulting string is a palindrome.\"\"\"\n    modified_s = _delete_chars(s, c)\n    is_palindrome_result = _is_palindrome(modified_s)\n    return (modified_s, is_palindrome_result)"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Counts odd digits in each string and formats the output string as per example.\"\"\"\n    results = []\n    for item in lst:\n        current_odd_count = 0\n        for digit_char in item:\n            digit = int(digit_char)\n            if digit % 2 != 0:\n                current_odd_count += 1\n\n        formatted_string = (\n            f\"the number of odd elements {current_odd_count}n the str\"\n            f\"{current_odd_count}ng {current_odd_count} of the {current_odd_count}nput.\"\n        )\n        results.append(formatted_string)\n    return results"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Finds the minimum sum of any non-empty sub-array in a list of integers.\n    Uses an adaptation of Kadane's algorithm for O(n) time complexity.\n    \"\"\"\n    min_so_far = nums[0]\n    current_min = nums[0]\n\n    for i in range(1, len(nums)):\n        # Calculate the minimum sum ending at the current position\n        current_min = min(nums[i], current_min + nums[i])\n        # Update the overall minimum sum found so far\n        min_so_far = min(min_so_far, current_min)\n\n    return min_so_far"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array\n    of nums.\n    \"\"\"\n    current_min = nums[0]\n    global_min = nums[0]\n\n    for i in range(1, len(nums)):\n        current_min = min(nums[i], current_min + nums[i])\n        global_min = min(global_min, current_min)\n\n    return global_min"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst: list[str]) -> list[str]:\n    \"\"\"Given a list of strings, count odd digits and format output.\n    All 'i's in the output string are replaced by the count of odd digits.\n    \"\"\"\n    results = []\n    for digit_string in lst:\n        # Count odd digits in the current string\n        odd_digit_count = 0\n        for char_digit in digit_string:\n            if int(char_digit) % 2 != 0:\n                odd_digit_count += 1\n\n        # Format the output string using the count\n        formatted_string = f\"the number of odd elements {odd_digit_count}n the str{odd_digit_count}ng {odd_digit_count} of the {odd_digit_count}nput.\"\n        results.append(formatted_string)\n    return results"}
{"task_id": "HumanEval/115", "solution": "import math\nclass Well:\n    \"\"\"Represents a single well with its water units.\"\"\"\n    def __init__(self, water_units: list[int]):\n        self._water_units = water_units\n\n    def get_water_count(self) -> int:\n        \"\"\"Calculates the total water units in this well.\"\"\"\n        return sum(self._water_units)\nclass Grid:\n    \"\"\"Represents the entire grid of wells.\"\"\"\n    def __init__(self, grid_data: list[list[int]]):\n        self._wells = [Well(row) for row in grid_data]\n\n    def get_wells(self) -> list[Well]:\n        \"\"\"Returns the list of Well objects in the grid.\"\"\"\n        return self._wells\ndef ceil_division(numerator: int, denominator: int) -> int:\n    \"\"\"Performs division and rounds the result up to the nearest whole number.\"\"\"\n    return (numerator + denominator - 1) // denominator\nclass MaxFillCalculator:\n    \"\"\"Calculates the total number of bucket lowers for a given grid and capacity.\"\"\"\n    def calculate_bucket_lowers(self, grid_obj: Grid, capacity: int) -> int:\n        \"\"\"Calculates total bucket lowers required for all wells in the grid.\"\"\"\n        total_lowers = 0\n        for well in grid_obj.get_wells():\n            water_count = well.get_water_count()\n            if water_count > 0:\n                lowers_for_well = ceil_division(water_count, capacity)\n                total_lowers += lowers_for_well\n        return total_lowers\ndef max_fill(grid: list[list[int]], capacity: int) -> int:\n    \"\"\"\n    Calculates the number of times buckets must be lowered to empty all wells.\n    Each 1 is a water unit; partial fills count as one lowering operation.\n    \"\"\"\n    grid_instance = Grid(grid)\n    calculator = MaxFillCalculator()\n    return calculator.calculate_bucket_lowers(grid_instance, capacity)"}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"Sorts an array of integers using a custom comparison logic.\n    Non-negative numbers are sorted by set bit count, then decimal; negative numbers by decimal after all non-negatives.\"\"\"\n\n    def _count_set_bits(n: int) -> int:\n        \"\"\"\n        Counts the number of '1' bits in the binary representation of a non-negative integer.\n        \"\"\"\n        if n == 0:\n            return 0\n        return bin(n).count('1')\n\n    def custom_sort_key(num: int):\n        \"\"\"\n        Generates a sort key for an integer based on its sign and bit count.\n        \"\"\"\n        if num < 0:\n            # Negative numbers are sorted by decimal value and placed after all non-negative numbers.\n            return (float('inf'), num)\n        else:\n            # Non-negative numbers are sorted by (count of set bits, decimal value).\n            return (_count_set_bits(num), num)\n\n    return sorted(arr, key=custom_sort_key)"}
{"task_id": "HumanEval/115", "solution": "import math\ndef max_fill(grid, capacity):\n    \"\"\"\n    Calculates the total bucket lowering operations needed to empty all wells.\n    Each '1' in the grid represents a water unit, and buckets have a fixed capacity.\n    \"\"\"\n    total_bucket_operations = 0\n\n    for well_row in grid:\n        # Sums all '1's in the well row to get total water units.\n        water_units = sum(unit for unit in well_row if unit == 1)\n\n        # Calculate operations for the current well, treating empty wells as 0 operations.\n        if water_units == 0:\n            operations_for_well = 0\n        else:\n            operations_for_well = math.ceil(water_units / capacity)\n\n        total_bucket_operations += operations_for_well\n\n    return total_bucket_operations"}
{"task_id": "HumanEval/116", "solution": "from functools import cmp_to_key\ndef count_set_bits(n: int) -> int:\n    \"\"\"Counts set bits in a non-negative integer using Brian Kernighan's algorithm.\"\"\"\n    count = 0\n    while n > 0:\n        n &= (n - 1)\n        count += 1\n    return count\ndef _custom_compare(a: int, b: int) -> int:\n    \"\"\"Compares two integers for sorting: negatives first, then non-negatives by bit count then value.\"\"\"\n    if a < 0 and b >= 0:\n        return -1\n    if a >= 0 and b < 0:\n        return 1\n\n    if a < 0 and b < 0:\n        # Both negative, sort by decimal value.\n        return a - b\n\n    # Both non-negative.\n    bit_count_a = count_set_bits(a)\n    bit_count_b = count_set_bits(b)\n\n    if bit_count_a != bit_count_b:\n        return bit_count_a - bit_count_b\n    else:\n        return a - b\ndef sort_array(arr):\n    \"\"\"Sorts an array of integers according to specific bit count and decimal value criteria.\"\"\"\n    # Create a copy to avoid modifying the original list in-place.\n    sorted_arr = list(arr)\n    sorted_arr.sort(key=cmp_to_key(_custom_compare))\n    return sorted_arr"}
{"task_id": "HumanEval/117", "solution": "def select_words(s: str, n: int) -> list[str]:\n    \"\"\"\n    Selects words from a string that have exactly 'n' consonants, maintaining order.\n    Consonants are all letters that are not 'a', 'e', 'i', 'o', 'u', case-insensitive.\n    \"\"\"\n    _VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def _count_consonants(word: str) -> int:\n        \"\"\"Counts the number of consonants in a given word.\"\"\"\n        consonant_count = 0\n        word_lower = word.lower()\n        for char in word_lower:\n            if 'a' <= char <= 'z' and char not in _VOWELS:\n                consonant_count += 1\n        return consonant_count\n\n    if not s:\n        return []\n\n    words = s.split()\n\n    result_words = []\n    for word in words:\n        consonant_count = _count_consonants(word)\n        if consonant_count == n:\n            result_words.append(word)\n\n    return result_words"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, returns a list of words with exactly n consonants.\n    Words are returned in their original order, handling an empty input string.\n    \"\"\"\n\n    if not s:\n        return []\n\n    # Helper function to count consonants in a word, defined inline.\n    def _count_consonants(word):\n        VOWELS = {'a', 'e', 'i', 'o', 'u'}\n        count = 0\n        for char in word:\n            lower_char = char.lower()\n            # Check if character is an alphabet letter and not a vowel.\n            if 'a' <= lower_char <= 'z' and lower_char not in VOWELS:\n                count += 1\n        return count\n\n    words = s.split()\n    result = []\n\n    for word in words:\n        consonant_count = _count_consonants(word)\n        if consonant_count == n:\n            result.append(word)\n\n    return result"}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel between two consonants from the right side of the word.\n    Vowels at the beginning and ending of the word do not count.\n    \"\"\"\n    VOWELS_SET = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\n    def is_vowel(char):\n        return char in VOWELS_SET\n\n    def is_consonant(char):\n        # Assumes char is an English letter as per problem constraints.\n        return char.isalpha() and not is_vowel(char)\n\n    if len(word) < 3:\n        return \"\"\n\n    # Iterate from right to left, excluding the first and last characters.\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        prev_char = word[i-1]\n        next_char = word[i+1]\n\n        if (is_vowel(current_char) and\n            is_consonant(prev_char) and\n            is_consonant(next_char)):\n            return current_char\n\n    return \"\""}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    '''\n    Checks if concatenating two strings in any order forms a balanced parentheses string.\n    Returns 'Yes' if balanced, 'No' otherwise.\n    '''\n    def _is_balanced(s: str) -> bool:\n        \"\"\"\n        Determines if a given parentheses string is balanced.\n        It uses a counter, returning False if balance ever drops below zero or isn't zero at the end.\n        \"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    s1 = lst[0] + lst[1]\n    s2 = lst[1] + lst[0]\n\n    if _is_balanced(s1) or _is_balanced(s2):\n        return 'Yes'\n    else:\n        return 'No'"}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel from the right side of a word.\n    The vowel must be surrounded by two consonants, excluding word ends.\"\"\"\n\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n        return char.lower() in VOWELS\n\n    def _is_consonant(char: str) -> bool:\n        \"\"\"Checks if a character is a consonant.\"\"\"\n        return char.isalpha() and not _is_vowel(char)\n\n    if len(word) < 3:\n        return \"\"\n\n    # Iterate from right to left, skipping the first and last characters.\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        left_neighbor = word[i - 1]\n        right_neighbor = word[i + 1]\n\n        if (_is_vowel(current_char) and\n                _is_consonant(left_neighbor) and\n                _is_consonant(right_neighbor)):\n            return current_char\n\n    return \"\""}
{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a non-negative integer k,\n    return a sorted list of length k with the maximum k numbers in arr.\n    \"\"\"\n    if k == 0:\n        return []\n\n    # Create a copy to avoid modifying the original input array.\n    arr_copy = list(arr)\n    arr_copy.sort(reverse=True)\n\n    # Select the first k elements and sort them in ascending order.\n    k_largest = arr_copy[:k]\n    k_largest.sort()\n\n    return k_largest"}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"Checks if two parentheses strings can form a balanced string when concatenated in any order.\n    Returns 'Yes' if possible, 'No' otherwise.\"\"\"\n\n    def _is_balanced(s: str) -> bool:\n        \"\"\"Determines if a string of parentheses is balanced.\"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    s1, s2 = lst[0], lst[1]\n\n    # Check s1 + s2 concatenation\n    if _is_balanced(s1 + s2):\n        return 'Yes'\n\n    # Check s2 + s1 concatenation\n    if _is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'"}
{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a non-negative integer k,\n    return a sorted list of length k with the maximum k numbers in arr.\n    \"\"\"\n    if k == 0:\n        return []\n\n    # Sort the array in ascending order\n    arr.sort()\n\n    # Return the last k elements, which are the k largest, already sorted\n    return arr[len(arr) - k:]"}
{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a list of integers, return the sum of all odd elements at even positions.\n    Positions are 0-indexed.\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 2 == 0:\n            if num % 2 != 0:\n                total_sum += num\n    return total_sum"}
