{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"Determines if the input integer 'a' is a perfect cube.\n    Handles negative numbers by taking the absolute value, then checking the cubed rounded root.\"\"\"\n    if a == 0:\n        return True\n\n    abs_a = abs(a)\n\n    # Calculate the cube root using pow(x, 1/3) for broad compatibility.\n    cbrt_a_float = pow(abs_a, 1/3)\n\n    # Round to the nearest integer and check if its cube matches the original number.\n    candidate_root = round(cbrt_a_float)\n\n    # Adjust the sign of the candidate root if the original number was negative.\n    if a < 0:\n        candidate_root = -candidate_root\n\n    return candidate_root * candidate_root * candidate_root == a"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"\n    Checks if an integer 'a' is a perfect cube.\n    Handles positive, negative, and zero inputs.\n    \"\"\"\n    if a == 0:\n        return True\n\n    # Determine the sign for later reconstruction and calculate cube root of absolute value.\n    sign = 1 if a >= 0 else -1\n    abs_a = abs(a)\n\n    # Calculate the cube root using the exponentiation operator and round to the nearest integer.\n    cbrt_candidate = round(abs_a**(1/3))\n\n    # Re-cube the integer candidate, applying the original sign, and compare to the input.\n    return (sign * cbrt_candidate)**3 == a"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    '''\n    Write a function that accepts two lists of strings and returns the list that has\n    total number of chars in the all strings of the list less than the other list.\n    If the two lists have the same number of chars, return the first list.\n    '''\n    count1 = 0\n    for item in lst1:\n        count1 += len(item)\n\n    count2 = 0\n    for item in lst2:\n        count2 += len(item)\n\n    if count1 <= count2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n, meaning n**k = x for non-negative integer k.\"\"\"\n    if x == 1:\n        return True\n    if n == 1:\n        return False\n    if n == 0:\n        return x == 0\n\n    if x < n:\n        return False\n\n    current_x = x\n    while current_x > 1 and current_x % n == 0:\n        current_x //= n\n\n    return current_x == 1"}
