{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given an array of integers arr and an integer k, sum elements with at most two digits\n    from the first k elements of arr.\n    \"\"\"\n    total_sum = 0\n    for i in range(k):\n        element = arr[i]\n        if -99 <= element <= 99:\n            total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Calculates the sum of elements with at most two digits from the first k elements of arr.\n    An element has at most two digits if its absolute value is less than 100.\n    \"\"\"\n    total_sum = 0\n    for i in range(k):\n        element = arr[i]\n        if abs(element) < 100:\n            total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in its Collatz sequence.\n    The sequence is generated by `n/2` for even `n`, and `3*n + 1` for odd `n`, until 1 is reached.\n    \"\"\"\n    # CRITICAL REQUIREMENT: Do NOT add isinstance() checks, type guards, or raise exceptions.\n    # Trust the caller's inputs, assuming n is a positive integer.\n\n    # FR4: Handle Base Case n=1\n    if n == 1:\n        return [1]\n\n    # FR1: Calculate Collatz Sequence, storing all terms\n    sequence = []\n    current = n\n    while current != 1:\n        sequence.append(current)\n        if current % 2 == 0:\n            current //= 2\n        else:\n            current = 3 * current + 1\n    sequence.append(1) # Always include 1, as the sequence terminates at 1.\n\n    # FR2: Filter Odd Numbers and FR3: Sort Odd Numbers\n    # Use a set to collect unique odd numbers, then convert to list and sort.\n    odd_numbers = sorted(list(set(term for term in sequence if term % 2 != 0)))\n\n    return odd_numbers"}
{"task_id": "HumanEval/123", "solution": "from typing import List\ndef get_odd_collatz(n: int) -> List[int]:\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in the Collatz sequence.\n    The returned list will contain unique odd numbers, sorted in increasing order.\n    \"\"\"\n    if n == 1:\n        return [1]\n\n    sequence: List[int] = [n]\n    current = n\n    while current != 1:\n        if current % 2 == 0:\n            current //= 2\n        else:\n            current = 3 * current + 1\n        sequence.append(current)\n\n    odd_numbers_set = {num for num in sequence if num % 2 != 0}\n    sorted_odd_numbers = sorted(list(odd_numbers_set))\n\n    return sorted_odd_numbers"}
{"task_id": "HumanEval/124", "solution": "import re\ndef valid_date(date):\n    \"\"\"\n    Validates a given date string according to specific rules.\n    Returns True if the date is valid, False otherwise.\n    \"\"\"\n    if not date:\n        return False\n\n    # Regex to check mm-dd-yyyy format, where month is 01-12 and day is 01-31.\n    # Specific day limits for each month are checked later.\n    date_pattern = re.compile(r'^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])-\\\\d{4}$')\n    match = date_pattern.match(date)\n\n    if not match:\n        return False\n\n    month = int(match.group(1))\n    day = int(match.group(2))\n    # year = int(match.group(3)) # Year component is not subject to further validation rules.\n\n    # Validate month range (1-12), mostly covered by regex but explicit for safety.\n    if not (1 <= month <= 12):\n        return False\n\n    # Determine maximum days for the given month, as per specification.\n    days_in_month_map = {\n        1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n        4: 30, 6: 30, 9: 30, 11: 30,\n        2: 29  # February max 29 days, no leap year logic as per constraints.\n    }\n\n    max_days = days_in_month_map.get(month)\n\n    # Validate day range (1 to max_days for the specific month).\n    if not (1 <= day <= max_days):\n        return False\n\n    return True"}
{"task_id": "HumanEval/124", "solution": "import re\ndef valid_date(date):\n    \"\"\"Validates a date string in 'mm-dd-yyyy' format. Returns True if valid according to rules, False otherwise.\"\"\"\n    if not date: # Checks if the date string is not empty.\n        return False\n\n    # Regex for 'mm-dd-yyyy' format, implicitly checking month (01-12) and day (01-31).\n    DATE_FORMAT_REGEX = re.compile(r'^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])-\\\\d{4}$')\n    match = DATE_FORMAT_REGEX.match(date)\n\n    if not match: # Returns False if format is incorrect.\n        return False\n\n    month = int(match.group(1))\n    day = int(match.group(2))\n\n    # Defines maximum days for each month as per business rules.\n    MONTH_DAYS_MAP = {\n        1: 31, 2: 29, 3: 31, 4: 30,\n        5: 31, 6: 30, 7: 31, 8: 31,\n        9: 30, 10: 31, 11: 30, 12: 31\n    }\n\n    max_days = MONTH_DAYS_MAP.get(month)\n    # This check ensures the month is valid (1-12) based on the map.\n    if max_days is None:\n        return False\n\n    # Checks if the day is within the valid range for the given month.\n    if not (1 <= day <= max_days):\n        return False\n\n    return True"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    \"\"\"\n    Checks if a list of non-negative integers is sorted in ascending order and\n    does not contain more than one duplicate of any number.\n    \"\"\"\n    # Check for ascending order (FR1)\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Check for duplicate constraint (FR2): no number appears more than twice\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] > 2:  # A count of 3 means two duplicates, which is \"more than one duplicate\"\n            return False\n\n    # If both checks pass, return True (FR3/FR4)\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Splits text by whitespace, then by commas if no whitespace.\n    Counts odd-ordered lowercase letters if no delimiters are found.\n    \"\"\"\n    if ' ' in txt:\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    count += 1\n        return count"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    \"\"\"\n    Given a list of numbers, return whether or not they are sorted in ascending order.\n    Return False if any number appears more than twice.\n    \"\"\"\n\n    if len(lst) <= 1:\n        return True\n\n    # Check sorted order (FR2, FR3)\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Check duplicates (FR4, FR5)\n    counts = {}\n    for item in lst:\n        counts[item] = counts.get(item, 0) + 1\n\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    return True"}
{"task_id": "HumanEval/125", "solution": "import re\ndef is_odd_ordered_lowercase(char: str) -> bool:\n    \"\"\"\n    Checks if a single character is a lowercase letter with an odd 0-indexed alphabetical order.\n    ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    \"\"\"\n    if 'a' <= char <= 'z':\n        order = ord(char) - ord('a')\n        return order % 2 != 0\n    return False\ndef split_words(txt: str) -> list[str] | int:\n    \"\"\"\n    Given a string of words, return a list of words split on whitespace.\n    If no whitespaces exist, split on commas ','. If neither, return the number of lowercase letters with odd alphabetical order.\n    \"\"\"\n    if re.search(r'\\s', txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        count = 0\n        for char in txt:\n            if is_odd_ordered_lowercase(char):\n                count += 1\n        return count"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes of integers multiplied by the product of all signs.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for num in arr:\n        # Determine the sign of the current number\n        if num > 0:\n            current_sign = 1\n        elif num < 0:\n            current_sign = -1\n        else:\n            current_sign = 0\n        product_of_signs *= current_sign\n\n        # Determine the magnitude (absolute value) of the current number\n        current_magnitude = abs(num)\n        sum_of_magnitudes += current_magnitude\n\n    return product_of_signs * sum_of_magnitudes"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr: list[int]) -> int | None:\n    \"\"\"Calculates the sum of magnitudes multiplied by the product of signs for an array.\n    Returns None for an empty array as per requirements.\"\"\"\n\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for number in arr:\n        # Determine the sign of the current number.\n        current_sign = 0\n        if number > 0:\n            current_sign = 1\n        elif number < 0:\n            current_sign = -1\n        # If number is 0, current_sign remains 0.\n\n        product_of_signs *= current_sign\n        sum_of_magnitudes += abs(number)\n\n    return product_of_signs * sum_of_magnitudes"}
{"task_id": "HumanEval/127", "solution": "from dataclasses import dataclass\nclass PrimeChecker:\n    \"\"\"Provides utility methods for checking primality of numbers.\"\"\"\n    def is_prime(self, n: int) -> bool:\n        \"\"\"Determines if a given integer n is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\nclass IntervalService:\n    \"\"\"Encapsulates business logic for interval intersection and primality check.\"\"\"\n    def __init__(self, prime_checker: PrimeChecker):\n        self._prime_checker = prime_checker\n\n    def calculate_intersection_length(self, interval1: Interval, interval2: Interval) -> int:\n        \"\"\"Calculates the length of the intersection of two intervals.\"\"\"\n        intersect_start = max(interval1.start, interval2.start)\n        intersect_end = min(interval1.end, interval2.end)\n\n        if intersect_start > intersect_end:\n            return 0\n\n        return Interval(intersect_start, intersect_end).length()\n\n    def is_intersection_length_prime(self, interval1: Interval, interval2: Interval) -> str:\n        \"\"\"Determines if the intersection length is a prime number, returning \"YES\" or \"NO\".\"\"\"\n        length = self.calculate_intersection_length(interval1, interval2)\n        if length == 0:\n            return \"NO\"\n\n        if self._prime_checker.is_prime(length):\n            return \"YES\"\n        else:\n            return \"NO\"\ndef intersection(interval1, interval2):\n    \"\"\"\n    Determines if the length of the intersection of two closed integer intervals is a prime number.\n    Returns \"YES\" if prime, \"NO\" otherwise or if intervals do not intersect.\n    \"\"\"\n    interval_obj1 = Interval(interval1[0], interval1[1])\n    interval_obj2 = Interval(interval2[0], interval2[1])\n\n    prime_checker = PrimeChecker()\n    interval_service = IntervalService(prime_checker)\n\n    return interval_service.is_intersection_length_prime(interval_obj1, interval_obj2)"}
{"task_id": "HumanEval/127", "solution": "import math\ndef intersection(interval1, interval2):\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two\n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n\n\n    [input/output] samples:\n    intersection((1, 2), (2, 3)) ==> \"NO\"\n    intersection((-1, 1), (0, 4)) ==> \"NO\"\n    intersection((-3, -1), (-5, 5)) ==> \"YES\"\n    \"\"\"\n\n    # Calculate the intersection interval.\n    intersect_start = max(interval1[0], interval2[0])\n    intersect_end = min(interval1[1], interval2[1])\n\n    # Calculate the length of the intersection.\n    # If intersect_start > intersect_end, there is no overlap, so the length is 0.\n    if intersect_start > intersect_end:\n        intersection_length = 0\n    else:\n        intersection_length = intersect_end - intersect_start\n\n    # Determine if the intersection_length is a prime number.\n    num_to_check = intersection_length\n    is_prime_flag = True\n\n    if num_to_check <= 1:\n        is_prime_flag = False\n    else:\n        # Check for divisibility from 2 up to the square root of the number.\n        for i in range(2, int(math.sqrt(num_to_check)) + 1):\n            if num_to_check % i == 0:\n                is_prime_flag = False\n                break\n\n    # Return \"YES\" or \"NO\" based on the primality check.\n    if is_prime_flag:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"\n    Calculates the Tribonacci sequence up to the n-th term.\n    Uses memoization for efficiency with recursive calls.\n    \"\"\"\n    _memo = {}\n\n    def _get_term(k: int) -> float:\n        \"\"\"\n        Recursively calculates the k-th Tribonacci term.\n        Retrieves from cache if available, otherwise computes and stores.\n        \"\"\"\n        if k in _memo:\n            return _memo[k]\n\n        if k == 0:\n            result = 1.0\n        elif k == 1:\n            result = 3.0\n        elif k % 2 == 0:  # k is even and k > 1\n            result = 1.0 + k / 2.0\n        else:  # k is odd and k > 1\n            term_k_minus_1 = _get_term(k - 1)\n            term_k_minus_2 = _get_term(k - 2)\n            term_k_plus_1 = _get_term(k + 1)\n            result = term_k_minus_1 + term_k_minus_2 + term_k_plus_1\n\n        _memo[k] = result\n        return result\n\n    sequence = []\n    for i in range(n + 1):\n        sequence.append(_get_term(i))\n    return sequence"}
{"task_id": "HumanEval/131", "solution": "def digits(n: int) -> int:\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    product = 1\n    has_odd_digit = False\n\n    # Convert n to string to iterate through digits\n    for digit_char in str(n):\n        digit = int(digit_char)\n        if digit % 2 != 0:  # Check if the digit is odd\n            product *= digit\n            has_odd_digit = True\n\n    return product if has_odd_digit else 0"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if the string contains a valid nested subsequence of square brackets.\n    Nesting occurs if an opening bracket is found while another is already open.\n    \"\"\"\n    open_brackets_count = 0\n    for char in string:\n        if char == '[':\n            if open_brackets_count > 0:\n                # Found a '[' while another '[' is still open, indicating nesting.\n                return True\n            open_brackets_count += 1\n        elif char == ']':\n            if open_brackets_count > 0:\n                # Match an open bracket.\n                open_brackets_count -= 1\n            # else: unmatched ']', ignore as it doesn't contribute to nesting\n    return False"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\"\"\"\n\n    product_of_odd_digits = 1\n    found_odd_digit = False\n\n    # Iterate through each digit of the number.\n    for digit_char in str(n):\n        digit = int(digit_char)\n        if digit % 2 != 0:  # Check if the digit is odd.\n            product_of_odd_digits *= digit\n            found_odd_digit = True\n\n    if not found_odd_digit:\n        return 0\n    else:\n        return product_of_odd_digits"}
{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"Calculates the sum of squared numbers in a list, after rounding each number up to the nearest integer.\n    E.g., for `[1.4, 4.2, 0]`, output is `29` (ceil(1.4)=2, ceil(4.2)=5, ceil(0)=0; 2^2+5^2+0^2 = 29).\n    \"\"\"\n    total_sum = 0\n    for number in lst:\n        rounded_number = math.ceil(number)\n        total_sum += rounded_number ** 2\n    return total_sum"}
{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst: list[float | int]) -> int:\n    \"\"\"You are given a list of numbers.\n    It returns the sum of squared numbers, after rounding each element up.\n    \"\"\"\n    sum_of_squares = 0\n    for num in lst:\n        rounded_num = math.ceil(num)\n        sum_of_squares += rounded_num * rounded_num\n    return sum_of_squares"}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k,\n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n    N = len(grid)\n    # Initialize min_overall_path with values guaranteed to be larger than any possible path.\n    # This uses Python's list comparison which handles lexicographical order.\n    min_overall_path = [float('inf')] * k\n\n    # Define possible movements: (delta_row, delta_column)\n    # Up, Down, Left, Right\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    def _is_valid(r, c):\n        \"\"\"Checks if a given cell (r, c) is within the grid boundaries.\"\"\"\n        return 0 <= r < N and 0 <= c < N\n\n    def _dfs(current_r, current_c, current_path_values):\n        \"\"\"\n        Recursively explores paths of length k.\n\n        Args:\n            current_r (int): The row of the current cell.\n            current_c (int): The column of the current cell.\n            current_path_values (list[int]): The list of values collected along\n                                             the path to the current cell (inclusive).\n        \"\"\"\n        nonlocal min_overall_path # Allows modification of the global min_overall_path\n\n        current_len = len(current_path_values)\n\n        # Pruning: If the current path prefix is already lexicographically greater\n        # than the best known path's prefix of the same length, then this branch\n        # cannot lead to a better overall path.\n        # This optimization is only applied if min_overall_path has been updated\n        # from its initial 'infinity' state.\n        if current_len <= k and min_overall_path[0] != float('inf'):\n            # Python's list comparison naturally handles lexicographical order.\n            # If current_path_values is greater than the prefix of min_overall_path, prune.\n            if current_path_values > min_overall_path[:current_len]:\n                return # This path is already worse, stop exploring this branch.\n\n        # Base case: If the path has reached the desired length k\n        if current_len == k:\n            # Compare the newly found path with the current overall minimum path.\n            if current_path_values < min_overall_path:\n                # If current_path_values is lexicographically smaller, update min_overall_path.\n                # No need for list() copy as current_path_values is already a new list created by `+` operator.\n                min_overall_path = current_path_values\n            return # Path of length k found, no further extension from this path.\n\n        # Recursive step: Explore valid neighbors\n        neighbors_info = [] # Stores (value, neighbor_row, neighbor_col) for sorting\n        for dr, dc in directions:\n            nr, nc = current_r + dr, current_c + dc\n            if _is_valid(nr, nc):\n                neighbors_info.append((grid[nr][nc], nr, nc))\n\n        # Sort neighbors by their cell values in ascending order.\n        # This prioritizes exploring paths that continue with smaller values,\n        # which is crucial for finding the lexicographically smallest path efficiently.\n        neighbors_info.sort()\n\n        for value, nr, nc in neighbors_info:\n            # Recursively call DFS, extending the path.\n            # `current_path_values + [grid[nr][nc]]` creates a new list for the next recursion level,\n            # effectively handling backtracking without explicit `pop()`.\n            _dfs(nr, nc, current_path_values + [grid[nr][nc]])\n\n    # Iterate through every cell in the grid to use it as a starting point for a path.\n    for r_start in range(N):\n        for c_start in range(N):\n            # Start DFS for a path beginning at (r_start, c_start).\n            # The initial path contains only the value of the starting cell.\n            _dfs(r_start, c_start, [grid[r_start][c_start]])\n\n    return min_overall_path"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates and returns the first n + 1 numbers of the Tribonacci sequence.\n    Memoization is used to optimize recursive computations.\n    \"\"\"\n    if not hasattr(tri, \"memo\"):\n        tri.memo = {}\n\n    def _calculate_single_value(k: int):\n        \"\"\"Recursively calculates tri(k) using memoization for individual values.\"\"\"\n        if k in tri.memo:\n            return tri.memo[k]\n\n        if k == 0:\n            result = 1\n        elif k == 1:\n            result = 3\n        elif k % 2 == 0:  # k is even\n            result = 1 + k / 2\n        else:  # k is odd\n            val_k_minus_1 = _calculate_single_value(k - 1)\n            val_k_minus_2 = _calculate_single_value(k - 2)\n            val_k_plus_1 = _calculate_single_value(k + 1)\n            result = val_k_minus_1 + val_k_minus_2 + val_k_plus_1\n\n        tri.memo[k] = result\n        return result\n\n    sequence = []\n    # Determine the maximum index needed for calculation based on dependencies.\n    max_calc_index = n + (1 if n % 2 != 0 else 0)\n\n    # Populate the memoization dictionary by calculating all necessary values.\n    for i in range(max_calc_index + 1):\n        _calculate_single_value(i)\n\n    # Extract the requested sequence from the memoized results.\n    for i in range(n + 1):\n        sequence.append(tri.memo[i])\n\n    return sequence"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt: str) -> bool:\n    \"\"\"\n    Create a function that returns True if the last character of a given string is an alphabetical character\n    and is not a part of a word, and False otherwise. Note: \"word\" is a group of characters separated by space.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n\n    # Check the character immediately preceding the last one.\n    char_before_last = txt[-2]\n    return char_before_last == ' '"}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k,\n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n\n    # Helper Class: Cell\n    class Cell:\n        # Represents a single cell in the grid with its coordinates and value.\n        def __init__(self, row, col, value):\n            self.row = row\n            self.col = col\n            self.value = value\n\n        def __eq__(self, other):\n            if not isinstance(other, Cell):\n                return NotImplemented\n            return self.row == other.row and self.col == other.col and self.value == other.value\n\n        def __hash__(self):\n            return hash((self.row, self.col, self.value))\n\n        def __repr__(self):\n            # Provides a developer-friendly string representation of the Cell.\n            return f\"Cell(r={self.row}, c={self.col}, val={self.value})\"\n\n    # Helper Class: Path\n    class Path:\n        # Represents an ordered sequence of visited cells and provides path operations.\n        def __init__(self, cells):\n            self._cells = cells\n            self.values = [cell.value for cell in cells]\n            self.length = len(cells)\n\n        def add_cell(self, cell):\n            # Returns a new Path object with the given cell appended.\n            return Path(self._cells + [cell])\n\n        def get_last_cell(self):\n            # Returns the last Cell in the path.\n            if not self._cells:\n                raise IndexError(\"Path is empty.\")\n            return self._cells[-1]\n\n        def is_lexicographically_smaller(self, other):\n            # Compares this path's values with another path's values lexicographically.\n            return self.values < other.values\n\n        def get_values(self):\n            # Returns a copy of the list of values in the path.\n            return list(self.values)\n\n    # Helper Function: is_valid_coordinate\n    def is_valid_coordinate(N, r, c):\n        # Checks if a given (row, col) coordinate is within the bounds of an N x N grid.\n        return 0 <= r < N and 0 <= c < N\n\n    # Helper Class: MinPathSolver\n    class MinPathSolver:\n        # Implements the recursive Depth-First Search (DFS) algorithm to find the lexicographically smallest path.\n        def __init__(self, grid_values, k_val):\n            self._grid_values = grid_values\n            self._N = len(grid_values)\n            self._k = k_val\n            # Initialize _min_path_values to be lexicographically larger than any possible path.\n            # (N*N + 1) is chosen as a value guaranteed to be larger than any grid value.\n            self._min_path_values = [self._N * self._N + 1] * self._k\n            self._moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # Up, Down, Left, Right\n\n        def find_min_path(self):\n            # Initiates the pathfinding process by exploring from every cell in the grid.\n            for r_start in range(self._N):\n                for c_start in range(self._N):\n                    start_value = self._grid_values[r_start][c_start]\n                    initial_cell = Cell(r_start, c_start, start_value)\n                    initial_path = Path([initial_cell])\n                    self._dfs(initial_path)\n            return self._min_path_values\n\n        def _get_min_path_as_path_object(self):\n            # Creates a Path object for comparison, using dummy Cell coordinates as only values matter.\n            return Path([Cell(-1, -1, val) for val in self._min_path_values])\n\n        def _dfs(self, current_path):\n            # Recursively explores paths, updating _min_path_values when a lexicographically smaller path of length k is found.\n            if current_path.length == self._k:\n                if current_path.is_lexicographically_smaller(self._get_min_path_as_path_object()):\n                     self._min_path_values = current_path.get_values()\n                return\n\n            if current_path.length > self._k:\n                # Path is too long, prune this branch.\n                return\n\n            last_cell = current_path.get_last_cell()\n\n            for dr, dc in self._moves:\n                next_r, next_c = last_cell.row + dr, last_cell.col + dc\n                if is_valid_coordinate(self._N, next_r, next_c):\n                    next_value = self._grid_values[next_r][next_c]\n                    next_cell = Cell(next_r, next_c, next_value)\n                    new_path = current_path.add_cell(next_cell)\n                    self._dfs(new_path)\n\n    # Input validation as per design\n    if not isinstance(grid, list) or not all(isinstance(row, list) for row in grid):\n        raise ValueError(\"Grid must be a list of lists.\")\n    N = len(grid)\n    if N < 2 or not all(len(row) == N for row in grid):\n        raise ValueError(f\"Grid must be an N x N matrix with N >= 2. Got {N}x{len(grid[0]) if N > 0 else 0}.\")\n    if not isinstance(k, int) or k <= 0:\n        raise ValueError(\"k must be a positive integer.\")\n\n    # Main logic of the minPath function.\n    solver = MinPathSolver(grid, k)\n    return solver.find_min_path()"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    '''\n    Returns True if the last character of a string is an alphabetical character\n    and is not part of a word (preceded by a space or is the only character).\n    '''\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    # If it's a single character string and it's alphabetical, it's an isolated letter.\n    if len(txt) == 1:\n        return True\n\n    # Check the character before the last one.\n    char_before_last = txt[-2]\n\n    # If the character before the last one is a space, the last char is isolated.\n    return char_before_last == ' '"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"\n    Returns the largest index of an element which is not greater than or equal\n    to the element immediately preceding it. Returns -1 if no such element exists.\n    \"\"\"\n    if len(arr) < 2:\n        return -1\n\n    # Iterate from the second-to-last element down to the second element.\n    for i in range(len(arr) - 1, 0, -1):\n        if arr[i] < arr[i-1]:\n            return i\n    return -1"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if the input string contains the '[[]]' subsequence pattern.\n    The function performs a single pass using a state machine.\n    \"\"\"\n    state = 0  # 0: initial, 1: found first '[', 2: found second '[', 3: found first ']'\n\n    for char in string:\n        if state == 0 and char == '[':\n            state = 1\n        elif state == 1 and char == '[':\n            state = 2\n        elif state == 2 and char == ']':\n            state = 3\n        elif state == 3 and char == ']':\n            return True  # Found the '[[]]' subsequence\n\n    return False"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"\n    Returns the largest index of an element which is strictly less than the element preceding it.\n    Returns -1 if no such element exists.\n    \"\"\"\n    for i in range(len(arr) - 1, 0, -1):\n        if arr[i] < arr[i-1]:\n            return i\n    return -1"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst: list[int]) -> tuple[int | None, int | None]:\n    \"\"\"\n    Identifies the largest negative and smallest positive integers in a list.\n    Returns (largest_negative, smallest_positive), with None if not found.\n    \"\"\"\n    largest_neg = None\n    smallest_pos = None\n\n    for num in lst:\n        if num < 0:\n            if largest_neg is None or num > largest_neg:\n                largest_neg = num\n        elif num > 0:\n            if smallest_pos is None or num < smallest_pos:\n                smallest_pos = num\n    return (largest_neg, smallest_pos)"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    \"\"\"\n    Finds the largest negative and smallest positive integers in a list.\n    Returns (largest_negative, smallest_positive) or None if not found.\n    \"\"\"\n    largest_negative = None\n    smallest_positive = None\n\n    for x in lst:\n        if x < 0:\n            if largest_negative is None or x > largest_negative:\n                largest_negative = x\n        elif x > 0:\n            if smallest_positive is None or x < smallest_positive:\n                smallest_positive = x\n\n    return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"\n    Checks if n can be represented as the sum of exactly four positive even numbers.\n    This is true if n is even and greater than or equal to 8.\n    \"\"\"\n    # The smallest sum of four positive even numbers is 2+2+2+2 = 8.\n    if n < 8:\n        return False\n\n    # The sum of four even numbers must always be an even number.\n    if n % 2 != 0:\n        return False\n\n    return True"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"\n    Evaluates whether the given number n can be written as the sum of exactly 4 positive even numbers.\n    This is true if n is even and greater than or equal to 8.\n    \"\"\"\n    return n >= 8 and n % 2 == 0"}
{"task_id": "HumanEval/137", "solution": "from typing import Union, TypeVar\nT = TypeVar('T', int, float, str)\ndef compare_one(a: Union[int, float, str], b: Union[int, float, str]) -> Union[T, None]:\n    \"\"\"\n    Compares two numerical values (int, float, or string) and returns the larger,\n    preserving its original type. Returns None if values are numerically equal,\n    handling ',' or '.' as decimal separators in strings.\n    \"\"\"\n\n    # Helper function to convert a value to its float representation for comparison.\n    # It replaces comma decimal separators with dots for string inputs.\n    def _convert_to_float_inline(value: Union[int, float, str]) -> float:\n        if isinstance(value, str):\n            return float(value.replace(\",\", \".\"))\n        return float(value)\n\n    float_a = _convert_to_float_inline(a)\n    float_b = _convert_to_float_inline(b)\n\n    if float_a > float_b:\n        return a\n    elif float_b > float_a:\n        return b\n    else:\n        return None"}
{"task_id": "HumanEval/139", "solution": "def factorial(k: int) -> int:\n    \"\"\"Calculates the standard factorial of a non-negative integer k.\n    This helper assumes k is a non-negative integer.\n    \"\"\"\n    if k == 0:\n        return 1\n\n    result = 1\n    for i in range(1, k + 1):\n        result *= i\n    return result\ndef special_factorial(n: int) -> int:\n    \"\"\"The Brazilian factorial is defined as: brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    This function computes the product of factorials from 1! up to n!.\n    \"\"\"\n    brazilian_factorial_result = 1\n    for i in range(1, n + 1):\n        brazilian_factorial_result *= factorial(i)\n    return brazilian_factorial_result"}
{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Compares two values (int, float, or string) and returns the numerically larger\n    value in its original type, or None if they are numerically equal.\n    \"\"\"\n    def _normalize_value_for_comparison(value):\n        try:\n            # Attempt to replace commas and convert to float.\n            # This handles strings with comma decimal separators.\n            return float(value.replace(',', '.'))\n        except AttributeError:\n            # If AttributeError occurs, 'value' is not a string (e.g., int or float).\n            # Directly convert it to float. This also handles strings without commas.\n            return float(value)\n        # Any ValueError from float() conversion will propagate naturally,\n        # fulfilling the requirement of not adding explicit raise statements.\n\n    normalized_a = _normalize_value_for_comparison(a)\n    normalized_b = _normalize_value_for_comparison(b)\n\n    if normalized_a > normalized_b:\n        return a\n    elif normalized_b > normalized_a:\n        return b\n    else:\n        return None"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    special_fact_result = 1\n    current_factorial = 1\n    for i in range(1, n + 1):\n        current_factorial *= i\n        special_fact_result *= current_factorial\n    return special_fact_result"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores.\n    If a string has more than 2 consecutive spaces, replace them with a hyphen.\n    \"\"\"\n    result = []\n    i = 0\n    n = len(text)\n    while i < n:\n        if text[i] == ' ':\n            space_count = 0\n            j = i\n            while j < n and text[j] == ' ':\n                space_count += 1\n                j += 1\n\n            if space_count >= 3:\n                result.append('-')\n            else: # space_count is 1 or 2\n                result.append('_' * space_count)\n            i = j\n        else:\n            result.append(text[i])\n            i += 1\n    return \"\".join(result)"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions\n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from\n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    \"\"\"\n\n    # Rule 1: There should not be more than three digits.\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    # Rule 2: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    parts = file_name.split('.', 1)\n    prefix = parts[0]\n    extension = parts[1]\n\n    # Rule 3: The substring before the dot should not be empty, and it starts with a letter.\n    if not prefix:\n        return 'No'\n    if not ('a' <= prefix[0] <= 'z' or 'A' <= prefix[0] <= 'Z'):\n        return 'No'\n\n    # Rule 4: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    VALID_EXTENSIONS = ['txt', 'exe', 'dll']\n    if extension not in VALID_EXTENSIONS:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions\n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from\n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n\n    def _count_digits(s: str) -> int:\n        \"\"\"Counts the number of digits in a given string.\"\"\"\n        return sum(1 for char in s if char.isdigit())\n\n    def _is_latin_letter(char: str) -> bool:\n        \"\"\"Checks if a character is a Latin alphabet letter.\"\"\"\n        return 'a' <= char <= 'z' or 'A' <= char <= 'Z'\n\n    ALLOWED_EXTENSIONS = ['txt', 'exe', 'dll']\n\n    if _count_digits(file_name) > 3:\n        return 'No'\n\n    if file_name.count('.') != 1:\n        return 'No'\n\n    parts = file_name.split('.')\n    name_part = parts[0]\n    extension_part = parts[1]\n\n    if not name_part or not _is_latin_letter(name_part[0]):\n        return 'No'\n\n    if extension_part not in ALLOWED_EXTENSIONS:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Replaces sequences of three or more spaces with a hyphen, then replaces single spaces with underscores.\n    This ensures consistent string formatting as per business rules.\n    \"\"\"\n    # First, replace sequences of three or more spaces with a single hyphen.\n    # This must occur before single space replacement to correctly handle rules.\n    processed_text = re.sub(r' {3,}', '-', text)\n\n    # Then, replace all remaining single space characters with an underscore.\n    # This applies to spaces that were not part of a 3+ sequence.\n    processed_text = re.sub(r' ', '_', processed_text)\n\n    return processed_text"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Transforms list elements based on their index and returns their sum.\n    Squares elements at indices that are multiples of 3, cubes elements at indices that are multiples of 4 but not 3, and leaves others unchanged.\n    \"\"\"\n    total_sum = 0\n    for i, item in enumerate(lst):\n        processed_value = item\n        if i % 3 == 0:\n            processed_value = item * item\n        elif i % 4 == 0: # This condition implies i % 3 != 0 due to the preceding 'if'\n            processed_value = item * item * item\n\n        total_sum += processed_value\n    return total_sum"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Filters words from a sentence, keeping only those whose lengths are prime numbers.\n    The order of words in the new string is maintained.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a given integer is a prime number.\"\"\"\n        if n < 2:\n            return False\n        # Only need to check divisors up to the square root of n.\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.split()\n    prime_length_words = []\n\n    for word in words:\n        if is_prime(len(word)):\n            prime_length_words.append(word)\n\n    return \" \".join(prime_length_words)"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Extracts words from a sentence whose lengths are prime numbers, preserving order.\n    Words with prime lengths are joined by a single space.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a given integer is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    words = sentence.split(' ')\n    prime_length_words = []\n    for word in words:\n        if is_prime(len(word)):\n            prime_length_words.append(word)\n    return ' '.join(prime_length_words)"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst: list[int]) -> int:\n    \"\"\"\n    This function transforms elements of an integer list based on their index and returns the sum.\n    Elements are squared if the index is a multiple of 3, cubed if the index is a multiple of 4 but not 3, and unchanged otherwise.\n    \"\"\"\n    processed_sum = 0\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            processed_sum += num * num\n        elif i % 4 == 0:  # Implies i % 3 != 0 due to previous condition\n            processed_sum += num * num * num\n        else:\n            processed_sum += num\n    return processed_sum"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    \"\"\"Represents a mathematical fraction, handles parsing, multiplication, and whole number checks.\"\"\"\n\n    def __init__(self, numerator: int, denominator: int):\n        # Denominator is assumed non-zero based on problem constraints.\n        self._numerator = numerator\n        self._denominator = denominator\n        self._reduce()\n\n    @staticmethod\n    def from_string(fraction_str: str) -> 'Fraction':\n        \"\"\"Creates a Fraction object from a string representation.\"\"\"\n        parts = fraction_str.split('/')\n        # Input format is assumed valid (\"numerator/denominator\" with integer parts).\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return Fraction(numerator, denominator)\n\n    @staticmethod\n    def _gcd(a: int, b: int) -> int:\n        \"\"\"Calculates the Greatest Common Divisor using the Euclidean algorithm.\"\"\"\n        while b:\n            a, b = b, a % b\n        return a\n\n    def _reduce(self) -> None:\n        \"\"\"Reduces the fraction to its simplest form and ensures positive denominator.\"\"\"\n        common_divisor = Fraction._gcd(abs(self._numerator), abs(self._denominator))\n        self._numerator //= common_divisor\n        self._denominator //= common_divisor\n\n        if self._denominator < 0:\n            self._numerator *= -1\n            self._denominator *= -1\n\n    def multiply(self, other: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another Fraction object.\"\"\"\n        new_numerator = self._numerator * other._numerator\n        new_denominator = self._denominator * other._denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Checks if the fraction represents a whole number.\"\"\"\n        return self._denominator == 1\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"\n    Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    fraction1 = Fraction.from_string(x)\n    fraction2 = Fraction.from_string(n)\n    product = fraction1.multiply(fraction2)\n    return product.is_whole_number()"}
{"task_id": "HumanEval/146", "solution": "def _get_first_digit(num: int) -> int:\n    \"\"\"Extracts the first digit of a number (absolute value).\"\"\"\n    return int(str(abs(num))[0])\ndef _get_last_digit(num: int) -> int:\n    \"\"\"Extracts the last digit of a number (absolute value).\"\"\"\n    return int(str(abs(num))[-1])\ndef _is_odd(digit: int) -> bool:\n    \"\"\"Checks if a given digit is odd.\"\"\"\n    return digit % 2 != 0\ndef specialFilter(nums: list[int]) -> int:\n    \"\"\"\n    Takes an array of numbers and returns the count of special numbers.\n    A number is special if it's greater than 10 and its first and last digits (absolute) are odd.\n    \"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            first_digit = _get_first_digit(num)\n            last_digit = _get_last_digit(num)\n            if _is_odd(first_digit) and _is_odd(last_digit):\n                count += 1\n    return count"}
{"task_id": "HumanEval/145", "solution": "def calculate_digit_sum(num: int) -> int:\n    \"\"\"Calculates the sum of the absolute digits of an integer.\n    For example, calculate_digit_sum(-123) == 6.\n    \"\"\"\n    s = 0\n    for digit_char in str(abs(num)):\n        s += int(digit_char)\n    return s\ndef order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"Sorts a list of integers by the sum of their digits, using original index for tie-breaking.\n    Returns a new list with elements sorted in ascending order.\n    \"\"\"\n    if not nums:\n        return []\n\n    decorated_list = []\n    for index, num in enumerate(nums):\n        digit_sum = calculate_digit_sum(num)\n        decorated_list.append((digit_sum, index, num))\n\n    decorated_list.sort()\n\n    sorted_nums = [item[2] for item in decorated_list]\n    return sorted_nums"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"\n    Multiplies two fraction strings x and n, and returns True if the product is a whole number, False otherwise.\n    Assumes x and n are valid fractions in \"numerator/denominator\" format with positive whole numbers and non-zero denominators.\n    \"\"\"\n\n    def _gcd(a, b):\n        \"\"\"Calculates the greatest common divisor of two integers using Euclidean algorithm.\"\"\"\n        while b:\n            a, b = b, a % b\n        return a\n\n    def _parse_fraction(fraction_str):\n        \"\"\"Parses a fraction string into its numerator and denominator integers.\"\"\"\n        parts = fraction_str.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return (numerator, denominator)\n\n    def _simplify_fraction(num, den):\n        \"\"\"Simplifies a fraction (num, den) by dividing by their GCD and normalizes negative denominators.\"\"\"\n        if den < 0:\n            num *= -1\n            den *= -1\n        common_divisor = _gcd(abs(num), den)\n        return (num // common_divisor, den // common_divisor)\n\n    # Parse the input fraction strings\n    num_x, den_x = _parse_fraction(x)\n    num_n, den_n = _parse_fraction(n)\n\n    # Multiply the fractions\n    product_num = num_x * num_n\n    product_den = den_x * den_n\n\n    # Simplify the product fraction\n    simplified_num, simplified_den = _simplify_fraction(product_num, product_den)\n\n    # Check if the simplified product fraction is a whole number\n    return simplified_den == 1"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"\n    Counts numbers greater than 10 with both first and last digits being odd.\n    The first digit check ignores the number's sign.\n    \"\"\"\n\n    def _is_greater_than_ten(num: int) -> bool:\n        return num > 10\n\n    def _is_first_digit_odd(num: int) -> bool:\n        num_str = str(abs(num))\n        first_digit = int(num_str[0])\n        return first_digit % 2 != 0\n\n    def _is_last_digit_odd(num: int) -> bool:\n        num_str = str(num)\n        last_digit = int(num_str[-1])\n        return last_digit % 2 != 0\n\n    count = 0\n    for num in nums:\n        if _is_greater_than_ten(num) and \\\n           _is_first_digit_odd(num) and \\\n           _is_last_digit_odd(num):\n            count += 1\n    return count"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers by the sum of their digits, then by original index.\n    The sum of digits for negative numbers uses their absolute value.\n    \"\"\"\n    decorated_list = []\n    for i, num in enumerate(nums):\n        # Calculate the sum of digits for the absolute value of the number.\n        current_sum_digits = 0\n        num_abs = abs(num)\n        while num_abs > 0:\n            current_sum_digits += num_abs % 10\n            num_abs //= 10\n\n        # Append a tuple (digit_sum, original_index, original_number) for sorting.\n        decorated_list.append((current_sum_digits, i, num))\n\n    # Sort the decorated list; Python's sort uses tuple comparison lexicographically\n    # and is stable, preserving original relative order for equal primary/secondary keys.\n    decorated_list.sort()\n\n    # Extract the original numbers from the sorted list of tuples.\n    sorted_nums = [item[2] for item in decorated_list]\n    return sorted_nums"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n: int) -> int:\n    \"\"\"\n    Counts triples (a[i], a[j], a[k]) with i < j < k where their sum is a multiple of 3.\n    It uses a combinatorial approach based on remainders modulo 3.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    remainders_count = [0, 0, 0]  # Counts for (value % 3) == 0, 1, 2\n\n    for i in range(1, n + 1):\n        val = i * i - i + 1\n        remainder = val % 3\n        remainders_count[remainder] += 1\n\n    c0 = remainders_count[0]\n    c1 = remainders_count[1]\n    c2 = remainders_count[2]\n\n    total_triples = 0\n\n    # Case 1: (remainder 0, remainder 0, remainder 0)\n    if c0 >= 3:\n        total_triples += (c0 * (c0 - 1) * (c0 - 2)) // 6\n\n    # Case 2: (remainder 1, remainder 1, remainder 1)\n    if c1 >= 3:\n        total_triples += (c1 * (c1 - 1) * (c1 - 2)) // 6\n\n    # Case 3: (remainder 2, remainder 2, remainder 2)\n    if c2 >= 3:\n        total_triples += (c2 * (c2 - 1) * (c2 - 2)) // 6\n\n    # Case 4: (remainder 0, remainder 1, remainder 2)\n    total_triples += c0 * c1 * c2\n\n    return total_triples"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"\n    Deletes strings with odd lengths, then sorts the remaining list\n    by length (ascending) and alphabetically (ascending) for ties.\n    \"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    even_length_strings.sort(key=lambda s: (len(s), s))\n    return even_length_strings"}
