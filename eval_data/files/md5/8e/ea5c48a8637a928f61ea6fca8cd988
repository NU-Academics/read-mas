{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating alphabetic characters by a fixed shift value.\n    Non-alphabetic characters remain unchanged, and case is preserved.\"\"\"\n\n    # The alphabet rotation shift value is fixed at 4.\n    SHIFT_VALUE = 4\n\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            offset = ord(char) - ord('a')\n            shifted_offset = (offset + SHIFT_VALUE) % 26\n            encrypted_chars.append(chr(ord('a') + shifted_offset))\n        elif 'A' <= char <= 'Z':\n            offset = ord(char) - ord('A')\n            shifted_offset = (offset + SHIFT_VALUE) % 26\n            encrypted_chars.append(chr(ord('A') + shifted_offset))\n        else:\n            encrypted_chars.append(char)\n\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Returns an ordered version of the string where characters within words are sorted.\n    The order of words and blank spaces is preserved.\n    \"\"\"\n\n    def _split_into_segments(s_inner: str) -> list[tuple[str, bool]]:\n        \"\"\"Splits string into segments, distinguishing words from whitespace.\"\"\"\n        segments = []\n        current_segment_chars = []\n\n        # Determine if the string starts with a word or whitespace\n        is_current_segment_word = False\n        if s_inner and not s_inner[0].isspace():\n            is_current_segment_word = True\n\n        for char in s_inner:\n            char_is_space = char.isspace()\n\n            if char_is_space == is_current_segment_word:\n                # Character type is different from current segment type, so end current segment\n                if current_segment_chars:\n                    segments.append(\"\".join(current_segment_chars), is_current_segment_word)\n                current_segment_chars = [char]\n                is_current_segment_word = not is_current_segment_word # Flip segment type\n            else:\n                # Character type is same as current segment type, continue segment\n                current_segment_chars.append(char)\n\n        # Add the last segment if any characters were collected\n        if current_segment_chars:\n            segments.append(\"\".join(current_segment_chars), is_current_segment_word)\n\n        return segments\n\n    def _sort_word_characters(word: str) -> str:\n        \"\"\"Sorts characters of a word in ascending ASCII order.\"\"\"\n        return \"\".join(sorted(word))\n\n    segments = _split_into_segments(s)\n    result_parts = []\n\n    for segment_value, is_word in segments:\n        if is_word:\n            result_parts.append(_sort_word_characters(segment_value))\n        else:\n            result_parts.append(segment_value)\n\n    return \"\".join(result_parts)"}
