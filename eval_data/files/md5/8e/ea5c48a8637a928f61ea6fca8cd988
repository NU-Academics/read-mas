{"task_id": "HumanEval/91", "solution": "import re\ndef is_bored(S):\n    \"\"\"\n    Counts sentences starting with \"I\", delimited by '.', '?' or '!'.\n    \"I\" must be case-sensitive and a standalone word.\n    \"\"\"\n    if not S:\n        return 0\n\n    SENTENCE_DELIMITERS = r'[.?!]'\n    sentences_raw = re.split(SENTENCE_DELIMITERS, S)\n\n    cleaned_sentences = []\n    for sentence_part in sentences_raw:\n        trimmed_sentence = sentence_part.strip()\n        if trimmed_sentence:\n            cleaned_sentences.append(trimmed_sentence)\n\n    boredom_count = 0\n    for sentence in cleaned_sentences:\n        if sentence.startswith(\"I \") or sentence == \"I\":\n            boredom_count += 1\n\n    return boredom_count"}
{"task_id": "HumanEval/91", "solution": "import re\ndef is_bored(S):\n    \"\"\"\n    Counts the number of sentences starting with \"I\" in a given text.\n    Sentences are delimited by '.', '?', or '!'.\n    \"\"\"\n    if not S:\n        return 0\n\n    SENTENCE_DELIMITERS = ['.', '?', '!']\n\n    # Create a regex pattern to split by delimiters, keeping the delimiters.\n    # The parentheses ensure that the delimiters themselves are included in the resulting list of parts.\n    pattern = '|'.join(re.escape(d) for d in SENTENCE_DELIMITERS)\n    parts = re.split(f'({pattern})', S)\n\n    sentences = []\n    current_sentence_parts = []\n\n    for part in parts:\n        # Skip empty strings or parts that are just whitespace, which can result from split.\n        if not part.strip():\n            continue\n\n        current_sentence_parts.append(part)\n\n        # If the current part is a recognized delimiter, it signifies the end of a sentence.\n        if part in SENTENCE_DELIMITERS:\n            sentence = \"\".join(current_sentence_parts).strip()\n            if sentence: # Only add non-empty sentences.\n                sentences.append(sentence)\n            current_sentence_parts = [] # Reset for the next sentence.\n\n    # After the loop, if there are any remaining parts, they form the last sentence.\n    if current_sentence_parts:\n        sentence = \"\".join(current_sentence_parts).strip()\n        if sentence:\n            sentences.append(sentence)\n\n    boredom_count = 0\n    for sentence in sentences:\n        # Trim leading/trailing whitespace from the sentence before checking its start.\n        trimmed_sentence = sentence.strip()\n        # Use a regex to check if the sentence starts with the *word* \"I\" (case-insensitive).\n        # '\\b' ensures it's a word boundary, preventing \"Imagine\" from matching.\n        if re.match(r'^i\\b', trimmed_sentence.lower()):\n            boredom_count += 1\n\n    return boredom_count"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n\n    Examples\n    any_int(5, 2, 7) \u279e True\n\n    any_int(3, 2, 2) \u279e False\n\n    any_int(3, -2, 1) \u279e True\n\n    any_int(3.6, -2.2, 2) \u279e False\n\n\n\n    '''\n    if not (isinstance(x, int) and isinstance(y, int) and isinstance(z, int)):\n        return False\n\n    return (x == y + z) or (y == x + z) or (z == x + y)"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"Encodes a message by swapping letter cases and replacing vowels.\n    Vowels are replaced by the letter two places ahead in the alphabet, preserving the new case.\n    \"\"\"\n    ALPHABET_LOWER = 'abcdefghijklmnopqrstuvwxyz'\n    ALPHABET_UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'\n\n    VOWELS_LOWER = {'a', 'e', 'i', 'o', 'u'}\n    VOWELS_UPPER = {'A', 'E', 'I', 'O', 'U'}\n\n    VOWEL_MAP_LOWER = {v: ALPHABET_LOWER[ALPHABET_LOWER.index(v) + 2] for v in VOWELS_LOWER}\n    VOWEL_MAP_UPPER = {v: ALPHABET_UPPER[ALPHABET_UPPER.index(v) + 2] for v in VOWELS_UPPER}\n\n    encoded_chars = []\n    for char in message:\n        final_char = char\n\n        # Check if character is an English letter (A-Z, a-z)\n        if 'a' <= char <= 'z' or 'A' <= char <= 'Z':\n            # FR1: Swap case of alphabetic characters\n            processed_char = char.swapcase()\n\n            # FR2: Replace vowels with the letter two places ahead, maintaining case\n            if processed_char in VOWEL_MAP_LOWER:\n                final_char = VOWEL_MAP_LOWER[processed_char]\n            elif processed_char in VOWEL_MAP_UPPER:\n                final_char = VOWEL_MAP_UPPER[processed_char]\n            else:\n                # Not a vowel, keep the case-swapped character\n                final_char = processed_char\n        # BRule2: Non-alphabetic characters remain unchanged, already handled by `final_char = char` default.\n\n        encoded_chars.append(final_char)\n\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        # Checks if an integer is a prime number.\n        # Uses primality test up to square root.\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    def sum_digits(n: int) -> int:\n        # Calculates the sum of the absolute value of digits of an integer.\n        # Extracts digits using modulo and integer division.\n        s = 0\n        n = abs(n)\n        while n > 0:\n            s += n % 10\n            n //= 10\n        return s\n\n    largest_prime = 0\n    for num in lst:\n        if is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n\n    return sum_digits(largest_prime)"}
{"task_id": "HumanEval/93", "solution": "def encode(message: str) -> str:\n    \"\"\"\n    Encodes a message by swapping letter cases and shifting vowels.\n    Non-alphabetic characters remain unchanged.\n    \"\"\"\n    VOWELS_LOWER = \"aeiou\"\n    VOWELS_UPPER = \"AEIOU\"\n    ALPHABET_LOWER = \"abcdefghijklmnopqrstuvwxyz\"\n    ALPHABET_UPPER = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n\n    encoded_chars = []\n    for char in message:\n        if not char.isalpha():\n            encoded_chars.append(char)\n            continue\n\n        processed_char = char\n\n        # Check if the character is a vowel (case-insensitive)\n        is_vowel_flag = char in VOWELS_LOWER or char in VOWELS_UPPER\n\n        if is_vowel_flag:\n            # Determine which alphabet to use based on original character's case\n            if char.islower():\n                alphabet = ALPHABET_LOWER\n            else:\n                alphabet = ALPHABET_UPPER\n\n            # Shift letter two places ahead, with wrap-around\n            index = alphabet.index(char)\n            shifted_index = (index + 2) % len(alphabet)\n            processed_char = alphabet[shifted_index]\n\n        # Swap the case of the processed character (which is either original or shifted vowel)\n        final_char = processed_char.swapcase()\n        encoded_chars.append(final_char)\n\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    Examples:\n    check_dict_case({\"a\":\"apple\", \"b\":\"banana\"}) should return True.\n    check_dict_case({\"a\":\"apple\", \"A\":\"banana\", \"B\":\"banana\"}) should return False.\n    check_dict_case({\"a\":\"apple\", 8:\"banana\", \"a\":\"apple\"}) should return False.\n    check_dict_case({\"Name\":\"John\", \"Age\":\"36\", \"City\":\"Houston\"}) should return False.\n    check_dict_case({\"STATE\":\"NC\", \"ZIP\":\"12345\" }) should return True.\n    \"\"\"\n    if not dict:\n        return False\n\n    keys = list(dict.keys())\n\n    # Check if all keys are strings\n    if not all(isinstance(key, str) for key in keys):\n        return False\n\n    # Check if all string keys are lowercase\n    all_lower = all(key.islower() for key in keys)\n    if all_lower:\n        return True\n\n    # Check if all string keys are uppercase\n    all_upper = all(key.isupper() for key in keys)\n    if all_upper:\n        return True\n\n    return False"}
