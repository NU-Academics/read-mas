{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Separates top-level balanced parenthesis groups from a string, ignoring spaces.\n    Each returned group is a complete balanced string including its parentheses.\n    \"\"\"\n    cleaned_string = paren_string.replace(\" \", \"\")\n    groups: List[str] = []\n    i = 0\n    while i < len(cleaned_string):\n        if cleaned_string[i] == '(':\n            start_group_index = i\n            balance = 0\n            j = i\n            while j < len(cleaned_string):\n                if cleaned_string[j] == '(':\n                    balance += 1\n                elif cleaned_string[j] == ')':\n                    balance -= 1\n\n                if balance == 0:\n                    # Found a balanced group\n                    groups.append(cleaned_string[start_group_index : j + 1])\n                    i = j + 1  # Move past this group\n                    break\n                j += 1\n            else:\n                # If inner loop completes without finding a balance=0,\n                # it means the group starting at i was unbalanced.\n                # Advance i to continue scanning from the next character.\n                i += 1\n        else:\n            i += 1\n    return groups"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    cleaned_string = paren_string.replace(\" \", \"\")\n\n    groups: List[str] = []\n    balance = 0\n    start_index = -1\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            if balance == 0:\n                start_index = i\n            balance += 1\n        elif char == ')':\n            balance -= 1\n\n        if balance == 0 and start_index != -1:\n            groups.append(cleaned_string[start_index : i + 1])\n            start_index = -1\n\n    return groups"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"\n    Checks if any two distinct numbers in the list are closer than the threshold.\n    Returns True if found, False otherwise.\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    if threshold <= 0:\n        return False\n\n    sorted_numbers = sorted(numbers)\n\n    left = 0\n    for right in range(1, len(sorted_numbers)):\n        # Shrink the window from the left if the difference is too large.\n        while sorted_numbers[right] - sorted_numbers[left] >= threshold:\n            left += 1\n            if left == right: # Ensure distinct elements are always compared\n                break\n\n        # If a valid window exists and the difference is less than threshold, return True.\n        if left < right and sorted_numbers[right] - sorted_numbers[left] < threshold:\n            return True\n\n    return False"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    data_mean = sum(numbers) / len(numbers)\n    absolute_differences = [abs(x - data_mean) for x in numbers]\n    return sum(absolute_differences) / len(numbers)"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"For a given list of input numbers, calculate Mean Absolute Deviation around its mean.\n    MAD is the average absolute difference between each element and the dataset's mean.\n    \"\"\"\n    data_mean = sum(numbers) / len(numbers)\n    absolute_differences = [abs(x - data_mean) for x in numbers]\n    mad = sum(absolute_differences) / len(absolute_differences)\n    return mad"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"\n    Inserts a number 'delimeter' between every two consecutive elements of input list `numbers`.\n    A new list is returned without modifying the original.\n    \"\"\"\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Input is a string of parentheses groups. Output is the deepest nesting level for each group.\"\"\"\n\n    def _calculate_max_nesting_for_group(group: str) -> int:\n        \"\"\"Calculates the maximum nesting level within a single parentheses group string.\"\"\"\n        current_nesting = 0\n        max_nesting = 0\n        for char in group:\n            if char == '(':\n                current_nesting += 1\n                max_nesting = max(max_nesting, current_nesting)\n            elif char == ')':\n                current_nesting -= 1\n        return max_nesting\n\n    groups = paren_string.strip().split(' ')\n    results = []\n    for group in groups:\n        if group:\n            results.append(_calculate_max_nesting_for_group(group))\n    return results"}
{"task_id": "HumanEval/7", "solution": "from typing import List\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring.\n    The comparison is case-sensitive and preserves the relative order of matching strings.\n    \"\"\"\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef _calculate_deepest_level(group: str) -> int:\n    \"\"\"Calculates the deepest nesting level for a single group of parentheses.\n    It tracks the maximum level achieved even with malformed groups.\n    \"\"\"\n    current_level = 0\n    max_level = 0\n    for char in group:\n        if char == '(':\n            current_level += 1\n            max_level = max(max_level, current_level)\n        elif char == ')':\n            if current_level > 0: # Decrement only if there's an open parenthesis to match.\n                current_level -= 1\n    return max_level\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    \"\"\"\n    if not paren_string.strip():\n        return []\n\n    groups = [g for g in paren_string.split(' ') if g] # Split string into groups, filtering empty ones.\n\n    results = []\n    for group in groups:\n        results.append(_calculate_deepest_level(group))\n    return results"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\"For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    current_sum = 0\n    current_product = 1\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/7", "solution": "from typing import List\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    if not substring:\n        return list(strings) # Return a copy to ensure a new list object is always returned as per postconditions.\n\n    filtered_strings: List[str] = []\n    for s in strings:\n        if substring in s:\n            filtered_strings.append(s)\n    return filtered_strings"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_max_list = []\n    current_max = float('-inf')\n\n    for number in numbers:\n        if number > current_max:\n            current_max = number\n        rolling_max_list.append(current_max)\n    return rolling_max_list"}
{"task_id": "HumanEval/9", "solution": "from typing import List\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element\n    found until given moment in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_max_list: List[int] = []\n    current_max: int = float('-inf')\n\n    for number in numbers:\n        current_max = max(current_max, number)\n        rolling_max_list.append(current_max)\n\n    return rolling_max_list"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\"Test if a given string is a palindrome.\n    It returns True if the string reads the same forwards and backward.\"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\"Find the shortest palindrome that begins with a supplied string.\n    This uses the algorithm of finding the longest palindromic postfix.\"\"\"\n    longest_palindrome_start_index = len(string)\n    for i in range(len(string) + 1):\n        postfix = string[i:]\n        if is_palindrome(postfix):\n            longest_palindrome_start_index = i\n            break\n\n    prefix_to_reverse = string[:longest_palindrome_start_index]\n    reversed_prefix = prefix_to_reverse[::-1]\n    return string + reversed_prefix"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\"\n    Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    _validate_binary_string(a)\n    _validate_binary_string(b)\n    _validate_equal_length(a, b)\n\n    result_chars = []\n    for i in range(len(a)):\n        if a[i] == b[i]:\n            result_chars.append('0')\n        else:\n            result_chars.append('1')\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Returns the longest string from a list, prioritizing the first one encountered if lengths are equal.\n    Returns `None` if the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_str = None\n    max_len = -1\n\n    for s in strings:\n        if len(s) > max_len:\n            max_len = len(s)\n            longest_str = s\n    return longest_str"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b.\n    Applies the Euclidean algorithm to absolute values of inputs.\n    \"\"\"\n    x, y = abs(a), abs(b)\n    while y:\n        x, y = y, x % y\n    return x"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"\n    Returns the longest string from a list, prioritizing the first encountered in ties.\n    Returns None if the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_found: Optional[str] = None\n    max_length: int = -1\n\n    for s in strings:\n        if len(s) > max_length:\n            max_length = len(s)\n            longest_found = s\n    return longest_found"}
