{"task_id": "HumanEval/82", "solution": "import math\ndef is_prime(n):\n    \"\"\"Checks if a given integer is a prime number.\n    A prime number is a natural number greater than 1.\"\"\"\n    if n < 2:\n        return False\n    # Check for divisibility from 2 up to the square root of n.\n    for i in range(2, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            return False\n    return True\ndef prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    Examples\n    prime_length('Hello') == True\n    prime_length('abcdcba') == True\n    prime_length('kittens') == True\n    prime_length('orange') == False\n    \"\"\"\n    length = len(string)\n    return is_prime(length)"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    The input N is guaranteed to be within 0 <= N <= 10000.\n    \"\"\"\n\n    # Calculate the sum of the decimal digits of N.\n    digit_sum = 0\n    # Convert N to a string to iterate through its digits.\n    for digit_char in str(N):\n        digit_sum += int(digit_char)\n\n    # Convert the calculated sum into its binary string representation.\n    # Uses Python's built-in bin() function, slicing to remove the \"0b\" prefix.\n    binary_string = bin(digit_sum)[2:]\n\n    return binary_string"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of n-digit positive integers that start or end with 1.\n    This function implements the inclusion-exclusion principle.\n    \"\"\"\n    if n == 1:\n        # For n=1, the only 1-digit number starting or ending with 1 is '1'.\n        return 1\n    else:\n        # Count of n-digit numbers starting with 1.\n        # The first digit is 1, and the remaining n-1 digits can be any of 0-9.\n        count_starts_with_1 = 10**(n - 1)\n\n        # Count of n-digit numbers ending with 1.\n        # The first digit can be any of 1-9 (9 options), the last digit is 1,\n        # and the middle n-2 digits can be any of 0-9 (10 options each).\n        count_ends_with_1 = 9 * (10**(n - 2))\n\n        # Count of n-digit numbers starting with 1 AND ending with 1.\n        # The first digit is 1, the last digit is 1,\n        # and the middle n-2 digits can be any of 0-9.\n        count_starts_and_ends_with_1 = 10**(n - 2)\n\n        # Apply Inclusion-Exclusion Principle:\n        # P(A or B) = P(A) + P(B) - P(A and B)\n        # where A is \"starts with 1\" and B is \"ends with 1\".\n        total_count = count_starts_with_1 + count_ends_with_1 - count_starts_and_ends_with_1\n        return total_count"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades: list[float]) -> list[str]:\n    \"\"\"Converts a list of numerical GPAs into letter grades based on a predefined scale.\n    This helps teachers quickly assign letter grades to students.\n    \"\"\"\n    converted_grades = []\n    for gpa_value in grades:\n        # Evaluate conditions in descending GPA order as per the grading scale.\n        if gpa_value == 4.0:\n            converted_grades.append('A+')\n        elif gpa_value > 3.7:\n            converted_grades.append('A')\n        elif gpa_value > 3.3:\n            converted_grades.append('A-')\n        elif gpa_value > 3.0:\n            converted_grades.append('B+')\n        elif gpa_value > 2.7:\n            converted_grades.append('B')\n        elif gpa_value > 2.3:\n            converted_grades.append('B-')\n        elif gpa_value > 2.0:\n            converted_grades.append('C+')\n        elif gpa_value > 1.7:\n            converted_grades.append('C')\n        elif gpa_value > 1.3:\n            converted_grades.append('C-')\n        elif gpa_value > 1.0:\n            converted_grades.append('D+')\n        elif gpa_value > 0.7:\n            converted_grades.append('D')\n        elif gpa_value > 0.0:\n            converted_grades.append('D-')\n        else:  # This covers gpa_value == 0.0 and any gpa_value < 0.0\n            converted_grades.append('E')\n    return converted_grades"}
{"task_id": "HumanEval/81", "solution": "from dataclasses import dataclass\nfrom typing import List\nGRADING_SCALE: List[GPAScaleEntry] = [\n    GPAScaleEntry(gpa_threshold=4.0, letter_grade='A+'),\n    GPAScaleEntry(gpa_threshold=3.7 + 1e-9, letter_grade='A'),\n    GPAScaleEntry(gpa_threshold=3.3 + 1e-9, letter_grade='A-'),\n    GPAScaleEntry(gpa_threshold=3.0 + 1e-9, letter_grade='B+'),\n    GPAScaleEntry(gpa_threshold=2.7 + 1e-9, letter_grade='B'),\n    GPAScaleEntry(gpa_threshold=2.3 + 1e-9, letter_grade='B-'),\n    GPAScaleEntry(gpa_threshold=2.0 + 1e-9, letter_grade='C+'),\n    GPAScaleEntry(gpa_threshold=1.7 + 1e-9, letter_grade='C'),\n    GPAScaleEntry(gpa_threshold=1.3 + 1e-9, letter_grade='C-'),\n    GPAScaleEntry(gpa_threshold=1.0 + 1e-9, letter_grade='D+'),\n    GPAScaleEntry(gpa_threshold=0.7 + 1e-9, letter_grade='D'),\n    GPAScaleEntry(gpa_threshold=0.0 + 1e-9, letter_grade='D-'),\n    GPAScaleEntry(gpa_threshold=0.0, letter_grade='E')\n]\ndef numerical_letter_grade(grades: List[float]) -> List[str]:\n    \"\"\"Converts a list of GPAs into a list of corresponding letter grades.\"\"\"\n\n    def get_letter_grade(gpa: float) -> str:\n        \"\"\"Determines the letter grade for a single GPA.\"\"\"\n        for entry in GRADING_SCALE:\n            if gpa >= entry.gpa_threshold:\n                return entry.letter_grade\n        return 'E' # Fallback, should be caught by 0.0 threshold if scale is correct.\n\n    letter_grades = []\n    for gpa in grades:\n        letter_grades.append(get_letter_grade(gpa))\n    return letter_grades"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    Constraints: 0 <= N <= 10000.\n    \"\"\"\n    digit_sum = 0\n    # Iterate through the decimal digits of N to sum them.\n    for digit_char in str(N):\n        digit_sum += int(digit_char)\n\n    # Convert the sum of digits into its binary string representation.\n    return bin(digit_sum)[2:]"}
