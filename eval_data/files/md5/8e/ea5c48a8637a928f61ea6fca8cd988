{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting.\n    Sorts based on the parity of the sum of the first and last elements.\n    \"\"\"\n    if not array:\n        return []\n\n    if len(array) == 1:\n        return list(array)\n\n    first_element = array[0]\n    last_element = array[-1]\n    elements_sum = first_element + last_element\n\n    array_copy = list(array)\n\n    if elements_sum % 2 != 0:  # Odd sum, sort ascending\n        return sorted(array_copy)\n    else:  # Even sum, sort descending\n        return sorted(array_copy, reverse=True)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts a copy of the array based on the parity of the sum of its first and last elements.\n    If the sum is odd, it sorts in ascending order; if even, in descending order.\n    \"\"\"\n    copied_array = list(array)\n\n    if len(copied_array) <= 1:\n        return copied_array\n\n    first_element = copied_array[0]\n    last_element = copied_array[-1]\n    sum_of_elements = first_element + last_element\n\n    if sum_of_elements % 2 != 0:  # Sum is odd, sort ascending\n        copied_array.sort()\n    else:  # Sum is even, sort descending\n        copied_array.sort(reverse=True)\n\n    return copied_array"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating lowercase English letters by 4 positions, wrapping around.\n    Other characters remain unchanged.\"\"\"\n\n    SHIFT_AMOUNT = 4\n    ALPHABET_LOWER_START_ORD = 97  # ord('a')\n    ALPHABET_SIZE = 26\n\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            char_offset = ord(char) - ALPHABET_LOWER_START_ORD\n            shifted_offset = (char_offset + SHIFT_AMOUNT) % ALPHABET_SIZE\n            encrypted_char = chr(ALPHABET_LOWER_START_ORD + shifted_offset)\n            encrypted_chars.append(encrypted_char)\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/87", "solution": "class Coordinate:\n    def __init__(self, row: int, col: int):\n        self.row = row\n        self.col = col\n\n    def __repr__(self) -> str:\n        return f\"Coordinate(row={self.row}, col={self.col})\"\n\n    def __eq__(self, other) -> bool:\n        # Trust 'other' is also a Coordinate based on critical requirements.\n        return self.row == other.row and self.col == other.col\n\n    def __lt__(self, other) -> bool:\n        # Trust 'other' is also a Coordinate based on critical requirements.\n        if self.row != other.row:\n            return self.row < other.row\n        # For same row, sort by column in descending order\n        return self.col > other.col\nclass CoordinateFinder:\n    def find_coordinates(self, data: list[list[int]], target: int) -> list[tuple[int, int]]:\n        found_coords: list[Coordinate] = []\n        for r_idx, row_list in enumerate(data):\n            for c_idx, item in enumerate(row_list):\n                if item == target:\n                    found_coords.append(Coordinate(r_idx, c_idx))\n\n        # Sort using the custom __lt__ method of Coordinate\n        found_coords.sort()\n\n        return [(coord.row, coord.col) for coord in found_coords]\ndef get_row(lst, x):\n    \"\"\"\n    You are given a 2 dimensional data, as a nested lists,\n    which is similar to matrix, however, unlike matrices,\n    each row may contain a different number of columns.\n    Given lst, and integer x, find integers x in the list,\n    and return list of tuples, [(x1, y1), (x2, y2) ...] such that\n    each tuple is a coordinate - (row, columns), starting with 0.\n    Sort coordinates initially by rows in ascending order.\n    Also, sort coordinates of the row by columns in descending order.\n\n    Examples:\n    get_row([\n      [1,2,3,4,5,6],\n      [1,2,3,4,1,6],\n      [1,2,3,4,5,1]\n    ], 1) == [(0, 0), (1, 4), (1, 0), (2, 5), (2, 0)]\n    get_row([], 1) == []\n    get_row([[], [1], [1, 2, 3]], 3) == [(2, 2)]\n    \"\"\"\n    finder = CoordinateFinder()\n    return finder.find_coordinates(lst, x)"}
