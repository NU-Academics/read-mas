et(planet_name):\n        return planet_name in PlanetOrder._PLANET_ORDER\nclass PlanetService:\n    @staticmethod\n    def get_planets_between(planet1, planet2):\n        if not (PlanetOrder.is_valid_planet(planet1) and PlanetOrder.is_valid_planet(planet2)):\n            return ()\n\n        index1 = PlanetOrder.get_planet_index(planet1)\n        index2 = PlanetOrder.get_planet_index(planet2)\n\n        start_index = min(index1, index2)\n        end_index = max(index1, index2)\n\n        intermediate_planets = PlanetOrder.get_all_planets()[start_index + 1:end_index]\n\n        return intermediate_planets\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun\n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn,\n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2.\n    The function should return a tuple containing all planets whose orbits are\n    located between the orbit of planet1 and the orbit of planet2, sorted by\n    the proximity to the sun.\n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names.\n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    return PlanetService.get_planets_between(planet1, planet2)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/153": [{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on CAP - SM strength and formats the output string.\"\"\"\n\n    def _count_uppercase(s: str) -> int:\n        \"\"\"Counts the number of uppercase letters in a string.\"\"\"\n        return sum(1 for char in s if char.isupper())\n\n    def _count_lowercase(s: str) -> int:\n        \"\"\"Counts the number of lowercase letters in a string.\"\"\"\n        return sum(1 for char in s if char.islower())\n\n    def _calculate_strength(extension_name: str) -> int:\n        \"\"\"Calculates the strength of an extension name.\"\"\"\n        cap = _count_uppercase(extension_name)\n        sm = _count_lowercase(extension_name)\n        return cap - sm\n\n    strongest_ext_name = \"\"\n    max_strength = float('-inf') # Initialize with a very low number\n\n    for ext_name in extensions:\n        current_strength = _calculate_strength(ext_name)\n\n        # If current_strength is greater than max_strength, or it's the very first extension,\n        # update strongest_ext_name and max_strength.\n        # The tie-breaking rule (choose the first one) is naturally handled\n        # by only updating if current_strength is strictly greater.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_ext_name = ext_name\n\n    return f\"{class_name}.{strongest_ext_name}\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/156": [{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    ROMAN_MAP = {\n        1000: 'm', 900: 'cm', 500: 'd', 400: 'cd', 100: 'c',\n        90: 'xc', 50: 'l', 40: 'xl', 10: 'x', 9: 'ix', 5: 'v',\n        4: 'iv', 1: 'i'\n    }\n\n    roman_numeral = []\n    temp_num = number\n    for value, symbol in ROMAN_MAP.items():\n        while temp_num >= value:\n            roman_numeral.append(symbol)\n            temp_num -= value\n    return \"\".join(roman_numeral)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/154": [{"task_id": "HumanEval/154", "solution": "