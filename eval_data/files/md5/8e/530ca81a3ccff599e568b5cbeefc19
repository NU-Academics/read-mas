at (a) is less then 100.\n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    MAX_NUMBER_CONSTRAINT = 100\n\n    def find_prime_factors(num: int) -> list[int]:\n        \"\"\"Finds all prime factors of a given integer, including multiplicity.\"\"\"\n        factors = []\n        d = 2\n        temp_num = num\n        while d * d <= temp_num:\n            if temp_num % d == 0:\n                factors.append(d)\n                temp_num //= d\n            else:\n                d += 1\n        if temp_num > 1:\n            factors.append(temp_num)\n        return factors\n\n    if not (0 < a < MAX_NUMBER_CONSTRAINT):\n        return False\n\n    factors = find_prime_factors(a)\n    return len(factors) == 3", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/71": [{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1\n    \"\"\"\n    # Validate if all side lengths are positive\n    if not (a > 0 and b > 0 and c > 0):\n        return -1.0\n\n    # Validate the triangle inequality theorem\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1.0\n\n    # Calculate the semi-perimeter\n    s = (a + b + c) / 2\n\n    # Calculate the area using Heron's formula\n    area_squared = s * (s - a) * (s - b) * (s - c)\n\n    # Handle potential floating-point inaccuracies where area_squared might be slightly negative\n    if area_squared < 0:\n        area_squared = 0\n\n    area = math.sqrt(area_squared)\n\n    # Round the area to 2 decimal places\n    return round(area, 2)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/73": [{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n  