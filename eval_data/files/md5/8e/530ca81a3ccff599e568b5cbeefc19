''\n    # Side lengths must be positive.\n    if not (a > 0 and b > 0 and c > 0):\n        return False\n\n    # Check the triangle inequality theorem.\n    if not (a + b > c and a + c > b and b + c > a):\n        return False\n\n    # Sort the sides to identify the longest side (hypotenuse candidate).\n    sides = sorted([a, b, c])\n\n    # Use a small tolerance for floating-point comparison as per design.\n    EPSILON = 1e-9\n\n    # Apply the Pythagorean theorem.\n    return math.isclose(sides[0]**2 + sides[1]**2, sides[2]**2, rel_tol=EPSILON)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/158": [{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Finds the word with the maximum number of unique characters.\n    If multiple strings have the maximum number of unique characters,\n    returns the one which comes first in lexicographical order.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Tie-break by lexicographical order\n            if word < result_word:\n                result_word = word\n\n    return result_word", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/161": [{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    If s[i] is a letter, reverse its case from lower to upper or vise versa,\n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    \"\"\"\n\n    # Determine if the string contains any letters\n    contains_letters = False\n    for char_check in s:\n        if char_check.isalpha():\n     