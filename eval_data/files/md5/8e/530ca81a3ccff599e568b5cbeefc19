h\nclass FibonacciGenerator:\n    \"\"\"Generates Fibonacci numbers sequentially.\"\"\"\n    def __init__(self):\n        self.current_fib = 0\n        self.next_fib = 1\n\n    def get_next(self) -> int:\n        \"\"\"Returns the next Fibonacci number and updates internal state.\"\"\"\n        result = self.current_fib\n        self.current_fib, self.next_fib = self.next_fib, self.current_fib + self.next_fib\n        return result\n\n    def reset(self) -> None:\n        \"\"\"Resets the generator to its initial state (0, 1).\"\"\"\n        self.current_fib = 0\n        self.next_fib = 1\nclass PrimeChecker:\n    \"\"\"Determines if a given integer is a prime number.\"\"\"\n    def is_prime(self, num: int) -> bool:\n        \"\"\"Checks if num is a prime number using trial division.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(num)) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\nclass PrimeFibonacciFinder:\n    \"\"\"Orchestrates finding the n-th number that is both Fibonacci and prime.\"\"\"\n    def __init__(self, fib_generator: FibonacciGenerator, prime_checker: PrimeChecker):\n        self.fib_generator = fib_generator\n        self.prime_checker = prime_checker\n\n    def find_nth(self, n: int) -> int:\n        \"\"\"Finds the n-th prime Fibonacci number.\"\"\"\n        prime_fib_count = 0\n        self.fib_generator.reset()\n\n        # Get F0 (0), F1 (1), F2 (1) which are not prime or not counted as per examples.\n        self.fib_generator.get_next()\n        self.fib_generator.get_next()\n        self.fib_generator.get_next()\n\n        while True:\n            fib_num = self.fib_generator.get_next()\n            if self.prime_checker.is_prime(fib_num):\n                prime_fib_count += 1\n                if prime_fib_count == n:\n                    return fib_num\