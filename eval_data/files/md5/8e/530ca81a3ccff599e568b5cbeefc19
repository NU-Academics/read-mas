(of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n\n    # Helper function to check if coordinates are within grid bounds.\n    def is_valid_coordinate(row: int, col: int, N: int) -> bool:\n        return 0 <= row < N and 0 <= col < N\n\n    # Represents the grid, providing safe access to values and neighbors.\n    class Grid:\n        DIRECTIONS = [(0, 1), (0, -1), (1, 0), (-1, 0)] # Right, Left, Down, Up\n\n        def __init__(self, grid_data: list[list[int]]) -> None:\n            self._grid_data = grid_data\n            self._N = len(grid_data)\n\n        def get_value(self, row: int, col: int) -> int:\n            return self._grid_data[row][col]\n\n        def get_N(self) -> int:\n            return self._N\n\n        def get_neighbors(self, row: int, col: int) -> list[tuple[int, int]]:\n            neighbors = []\n            for dr, dc in Grid.DIRECTIONS:\n                n_row, n_col = row + dr, col + dc\n                if is_valid_coordinate(n_row, n_col, self._N):\n                    neighbors.append((n_row, n_col))\n            return neighbors\n\n    # Represents a path taken in the grid, allowing lexicographical comparison.\n    class Path:\n        def __init__(self, values: list[int], current_pos: tuple[int, int]) -> None:\n            self._values = values\n            self._current_pos = current_pos\n\n        def get_values(self) -> list[int]:\n            return self._values\n\n        def get_current_pos(self) -> tuple[int, int]:\n            return self._current_pos\n\n        def add_step(self, value: int, new_pos: tuple[int, int]) -> 'Path':\n            return Path(self._values + [value], new_pos)\n\n        def get_length(self) -> int:\n            return len(self._values)\n\n        def __lt__(self, other: 'Path') -> bool:\n            return self._values < other._values\n\n    # Service to find the minimum path using a priority queue (min-heap).\\\n    class PathfindingService:\n        def find_min_path(self, grid_obj: Grid, k_val: int) -> list[int]:\n            min_heap: list[Path] = []\n            N = grid_obj.get_N()\n\n            # Initialize heap with all possible starting positions.\\\n            for r in range(N):\n                for c in range(N):\n                    start_value = grid_obj.get_value(r, c)\n                    heapq.heappush(min_heap, Path([start_value], (r, c)))\n\n            # Explore paths using a min-heap until a path of length k is found.\\\n            while min_heap:\n                current_path = heapq.heappop(min_heap)\n\n                if current_path.get_length() == k_val:\n                    return current_path.get_values()\n\n                current_r, current_c = current_path.get_current_pos()\n                neighbors = grid_obj.get_neighbors(current_r, current_c)\n\n                for next_r, next_c in neighbors:\n                    next_value = grid_obj.get_value(next_r, next_c)\n                    new_path = current_path.add_step(next_value, (next_r, next_c))\n                    heapq.heappush(min_heap, new_path)\n\n            return [] # This return should ideally not be reached due to problem guarantees.\\\n\n    # Main logic for minPath function.\\\n    grid_obj = Grid(grid)\n    service = PathfindingService()\n    return service.find_min_path(grid_obj, k)", "base_