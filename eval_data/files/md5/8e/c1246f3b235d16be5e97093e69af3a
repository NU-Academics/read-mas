{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',', if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3\n    '''\n    if ' ' in txt:\n        return txt.split(' ')\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    count += 1\n        return count"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n    if n == 1:\n        return [1]\n\n    sequence = []\n    current_term = n\n    while True:\n        sequence.append(current_term)\n        if current_term == 1:\n            break\n        if current_term % 2 == 0:\n            current_term //= 2\n        else:\n            current_term = 3 * current_term + 1\n\n    odd_numbers_set = set()\n    for num in sequence:\n        if num % 2 != 0:\n            odd_numbers_set.add(num)\n\n    return sorted(list(odd_numbers_set))"}
{"task_id": "HumanEval/126", "solution": "```python\nimport collections\n\ndef is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    '''\n    # Check for the duplicate constraint: no number appears more than twice.\n    counts = collections.Counter(lst)\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    # Check if the list is sorted in ascending order.\n    # An empty list or a single-element list is considered sorted.\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    return True\n```"}
{"task_id": "HumanEval/124", "solution": "```python\ndef valid_date(date):\n    \"\"\"Validates a given date string and returns True if the date is valid, otherwise False.\n    Checks for non-empty string, 'mm-dd-yyyy' format, valid month range, and correct day range per month.\"\"\"\n\n    # Rule 1: The date string is not empty.\n    if not date:\n        return False\n\n    # Rule 4: The date should be in the format: mm-dd-yyyy\n    parts = date.split('-')\n    if len(parts) != 3:\n        return False\n\n    month_str, day_str, year_str = parts\n\n    # Ensure each part has the correct length for 'mm-dd-yyyy'\n    # Month and Day must be two digits, Year must be four digits.\n    if not (len(month_str) == 2 and len(day_str) == 2 and len(year_str) == 4):\n        return False\n\n    # Attempt to convert parts to integers. If non-numeric, return False.\n    try:\n        month = int(month_str)\n        day = int(day_str)\n        # Year validation not explicitly requested beyond format check,\n        # but converting it to int helps confirm it's numeric.\n        int(year_str)\n    except ValueError:\n        return False\n\n    # Rule 3: The months should not be less than 1 or higher than 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # Rule 2: Validate day range based on the month.\n    # Day cannot be less than 1 for any month.\n    if day < 1:\n        return False\n\n    months_31_days = [1, 3, 5, 7, 8, 10, 12]\n    months_30_days = [4, 6, 9, 11]\n    month_february = 2\n\n    if month in months_31_days:\n        if not (1 <= day <= 31):\n            return False\n    elif month in months_30_days:\n        if not (1 <= day <= 30):\n            return False\n    elif month == month_february:\n        # Rule explicitly states max 29 for February, no leap year logic needed.\n        if not (1 <= day <= 29):\n            return False\n    # No 'else' needed here for month, as it's already validated to be 1-12.\n    # If it falls into none of the above month categories, it would be an invalid state\n    # but given 1 <= month <= 12, it must fall into one of them.\n\n    # If all checks pass, the date is valid.\n    return True\n```"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n\n    Example:\n    >>> prod_signs([1, 2, 2, -4]) == -9\n    >>> prod_signs([0, 1]) == 0\n    >>> prod_signs([]) == None\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for num in arr:\n        # Determine the sign of the current number\n        if num > 0:\n            current_sign = 1\n        elif num < 0:\n            current_sign = -1\n        else:\n            current_sign = 0\n\n        # Multiply into the running product of signs\n        product_of_signs *= current_sign\n\n        # Add the magnitude (absolute value) to the running sum\n        sum_of_magnitudes += abs(num)\n\n    # Return the product of the total signs and the total magnitudes\n    return product_of_signs * sum_of_magnitudes"}
{"task_id": "HumanEval/127", "solution": "```python\nimport math\nfrom dataclasses import dataclass\nfrom typing import Optional\n\n@dataclass\nclass Interval:\n    \"\"\"Represents a closed integer interval [start, end].\"\"\"\n    start: int\n    end: int\n\nclass PrimeChecker:\n    \"\"\"Utility class for checking if a number is prime.\"\"\"\n    def is_prime(self, n: int) -> bool:\n        if n < 2:\n            return False\n        for i in range(2, int(math.sqrt(n)) + 1):\n            if n % i == 0:\n                return False\n        return True\n\nclass IntervalService:\n    \"\"\"Provides business logic for interval operations and prime length determination.\"\"\"\n    def __init__(self, prime_checker: PrimeChecker):\n        self._prime_checker = prime_checker\n\n    def calculate_intersection(self, interval1: Interval, interval2: Interval) -> Optional[Interval]:\n        start = max(interval1.start, interval2.start)\n        end = min(interval1.end, interval2.end)\n\n        if start <= end:\n            return Interval(start, end)\n        else:\n            return None\n\n    def calculate_length(self, interval: Interval) -> int:\n        return interval.end - interval.start + 1\n\n    def determine_prime_intersection(self, interval1: Interval, interval2: Interval) -> str:\n        intersection_interval = self.calculate_intersection(interval1, interval2)\n\n        if intersection_interval is None:\n            return \"NO\"\n\n        length = self.calculate_length(intersection_interval)\n        if self._prime_checker.is_prime(length):\n            return \"YES\"\n        else:\n            return \"NO\"\n\ndef intersection(interval1, interval2):\n    \"\"\"\n    You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two\n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n    \"\"\"\n    prime_checker = PrimeChecker()\n    interval_service = IntervalService(prime_checker)\n\n    int1_obj = Interval(interval1[0], interval1[1])\n    int2_obj = Interval(interval2[0], interval2[1])\n\n    return interval_service.determine_prime_intersection(int1_obj, int2_obj)\n```"}
{"task_id": "HumanEval/131", "solution": "```python\ndef digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\"\"\"\n    product = 1\n    has_odd_digit = False\n    for digit_char in str(n):\n        digit = int(digit_char)\n        if digit % 2 != 0:\n            product *= digit\n            has_odd_digit = True\n\n    return product if has_odd_digit else 0\n```"}
