{"task_id": "HumanEval/119", "solution": "```python\ndef match_parens(lst):\n    def is_balanced(s):\n        \"\"\"Checks if the input string 's' is a balanced parentheses string.\"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    s1, s2 = lst[0], lst[1]\n\n    if is_balanced(s1 + s2):\n        return 'Yes'\n\n    if is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'\n```"}
{"task_id": "HumanEval/116", "solution": "```python\nimport functools\n\ndef sort_array(arr):\n    \"\"\"\n    Sorts an array of non-negative integers according to number of ones in their binary\n    representation in ascending order, with decimal value as a tie-breaker.\n    Negative integers are sorted purely by decimal value and come before non-negative ones.\n    \"\"\"\n\n    class BitCounter:\n        def count_set_bits(self, n: int) -> int:\n            \"\"\"Counts the number of '1' bits in the binary representation of a non-negative integer.\"\"\"\n            if n < 0:\n                return 0\n            count = 0\n            while n > 0:\n                n &= (n - 1)\n                count += 1\n            return count\n\n    @functools.total_ordering\n    class SortableInteger:\n        \"\"\"\n        Wraps an integer and its calculated bit count for custom comparison logic.\n        \"\"\"\n        def __init__(self, value: int, bit_count: int):\n            self._value = value\n            self._bit_count = bit_count\n\n        def get_value(self) -> int:\n            \"\"\"Returns the original integer value.\"\"\"\n            return self._value\n\n        def __lt__(self, other: 'SortableInteger') -> bool:\n            if not isinstance(other, SortableInteger):\n                return NotImplemented\n\n            if self._value < 0 and other._value < 0:\n                return self._value < other._value\n            if self._value < 0 and other._value >= 0:\n                return True\n            if self._value >= 0 and other._value < 0:\n                return False\n\n            if self._bit_count != other._bit_count:\n                return self._bit_count < other._bit_count\n            return self._value < other._value\n\n        def __eq__(self, other: object) -> bool:\n            if not isinstance(other, SortableInteger):\n                return NotImplemented\n            return self._value == other._value and self._bit_count == other._bit_count\n\n    class ArraySorter:\n        \"\"\"\n        Orchestrates the sorting of an array of integers based on custom rules.\n        \"\"\"\n        def __init__(self):\n            self._bit_counter = BitCounter()\n\n        def sort_array(self, arr_to_sort: list[int]) -> list[int]:\n            sortable_items = []\n            for item in arr_to_sort:\n                if item >= 0:\n                    bit_count = self._bit_counter.count_set_bits(item)\n                    sortable_items.append(SortableInteger(item, bit_count))\n                else:\n                    sortable_items.append(SortableInteger(item, 0))\n\n            sortable_items.sort()\n            return [item.get_value() for item in sortable_items]\n\n    sorter = ArraySorter()\n    return sorter.sort_array(arr)\n```"}
{"task_id": "HumanEval/117", "solution": "```python\ndef select_words(s, n):\n    \"\"\"Given a string s and a natural number n, you have been tasked to implement\n    a function that returns a list of all words from string s that contain exactly\n    n consonants, in order these words appear in the string s.\n    If the string s is empty then the function should return an empty list.\n    \"\"\"\n    if not s:\n        return []\n\n    VOWELS_LOWERCASE = {'a', 'e', 'i', 'o', 'u'}\n\n    result_words = []\n    words = s.split()\n\n    for word in words:\n        consonant_count = 0\n        for char in word:\n            char_lower = char.lower()\n            if 'a' <= char_lower <= 'z' and char_lower not in VOWELS_LOWERCASE:\n                consonant_count += 1\n\n        if consonant_count == n:\n            result_words.append(word)\n\n    return result_words\n```"}
