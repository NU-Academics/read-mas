{"task_id": "HumanEval/103", "solution": "```python\ndef rounded_avg(n, m):\n    \"\"\"Computes the rounded average of integers from n to m, converts it to binary.\n    Returns -1 if n is greater than m.\"\"\"\n    if n > m:\n        return -1\n\n    # Calculate sum using arithmetic series formula: count * (first + last) / 2\n    count = m - n + 1\n    sum_of_range = (count * (n + m)) / 2\n\n    average = sum_of_range / count\n    rounded_value = round(average)\n\n    return bin(rounded_value)\n```"}
{"task_id": "HumanEval/104", "solution": "```python\ndef unique_digits(x):\n    \"\"\"Given a list of positive integers x. return a sorted list of all\n    elements that hasn't any even digit.\n    \"\"\"\n\n    def _has_even_digit(number):\n        \"\"\"Checks if a positive integer contains any even digit (0, 2, 4, 6, 8).\"\"\"\n        temp_num = number\n        while temp_num > 0:\n            digit = temp_num % 10\n            if digit % 2 == 0:\n                return True\n            temp_num //= 10\n        return False\n\n    filtered_list = []\n    for num in x:\n        if not _has_even_digit(num):\n            filtered_list.append(num)\n\n    filtered_list.sort()\n    return filtered_list\n```"}
{"task_id": "HumanEval/106", "solution": "```python\ndef f(n):\n    \"\"\" Implement the function f that takes n as a parameter,\n    and returns a list of size n, such that the value of the element at index i is the factorial of i if i is even\n    or the sum of numbers from 1 to i otherwise.\n    i starts from 1.\n    the factorial of i is the multiplication of the numbers from 1 to i (1 * 2 * ... * i).\n    Example:\n    f(5) == [1, 2, 6, 24, 15]\n    \"\"\"\n\n    def calculate_factorial(i: int) -> int:\n        \"\"\"Calculates the factorial of a given integer i.\"\"\"\n        if i == 0:\n            return 1\n        result = 1\n        for num in range(1, i + 1):\n            result *= num\n        return result\n\n    def calculate_sum_up_to(i: int) -> int:\n        \"\"\"Calculates the sum of all integers from 1 up to i.\"\"\"\n        return i * (i + 1) // 2\n\n    result_list = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:  # Even index\n            result_list.append(calculate_factorial(i))\n        else:  # Odd index\n            result_list.append(calculate_sum_up_to(i))\n    return result_list\n```"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Counts the number of elements in an array of integers which have a sum of digits > 0.\n    For negative numbers, the first signed digit is negative (e.g., -123 has signed digits -1, 2, 3).\n    \"\"\"\n    def _calculate_digit_sum(num: int) -> int:\n        \"\"\"Calculates the sum of digits for an integer, treating the first digit of a negative number as negative.\"\"\"\n        if num == 0:\n            return 0\n\n        s = str(abs(num))\n        digits = [int(d) for d in s]\n\n        if num < 0:\n            digits[0] = -digits[0]\n\n        return sum(digits)\n\n    count = 0\n    for num in arr:\n        if _calculate_digit_sum(num) > 0:\n            count += 1\n    return count"}
{"task_id": "HumanEval/105", "solution": "```python\ndef by_length(arr):\n    \"\"\"\n    Given an array of integers, sort the integers that are between 1 and 9 inclusive,\n    reverse the resulting array, and then replace each digit by its corresponding name from\n    \"One\", \"Two\", \"Three\", \"Four\", \"Five\", \"Six\", \"Seven\", \"Eight\", \"Nine\".\n    \"\"\"\n\n    # Define the mapping from digits to words.\n    number_words = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    # Filter the input array to include only integers between 1 and 9 (inclusive).\n    # Then sort these numbers in ascending order.\n    filtered_and_sorted_numbers = []\n    for num in arr:\n        # Assuming arr contains only integers as per docstring, no isinstance check needed.\n        if 1 <= num <= 9:\n            filtered_and_sorted_numbers.append(num)\n    filtered_and_sorted_numbers.sort()\n\n    # If no valid numbers were found, return an empty array.\n    if not filtered_and_sorted_numbers:\n        return []\n\n    # Reverse the sorted array.\n    reversed_numbers = filtered_and_sorted_numbers[::-1]\n\n    # Replace each digit with its corresponding word.\n    result_words = []\n    for num in reversed_numbers:\n        result_words.append(number_words.get(num))\n\n    return result_words\n```"}
{"task_id": "HumanEval/110", "solution": "```python\ndef exchange(lst1, lst2):\n    \"\"\"Determines whether it is possible to exchange elements to make lst1 a list of only even numbers.\"\"\"\n    odd_count_lst1 = sum(1 for x in lst1 if x % 2 != 0)\n    even_count_lst2 = sum(1 for x in lst2 if x % 2 == 0)\n\n    if odd_count_lst1 <= even_count_lst2:\n        return \"YES\"\n    else:\n        return \"NO\"\n```"}
{"task_id": "HumanEval/107", "solution": "```python\ndef even_odd_palindrome(n):\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n    def is_palindrome(num: int) -> bool:\n        \"\"\"Checks if an integer is a palindrome.\"\"\"\n        if num < 0:\n            return False\n        s_num = str(num)\n        return s_num == s_num[::-1]\n\n    even_count = 0\n    odd_count = 0\n\n    for i in range(1, n + 1):\n        if is_palindrome(i):\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n\n    return (even_count, odd_count)\n```"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"We have an array 'arr' of N integers arr[1], arr[2], ..., arr[N].The\n    numbers in the array will be randomly ordered. Your task is to determine if\n    it is possible to get an array sorted in non-decreasing order by performing\n    the following operation on the given array:\n        You are allowed to perform right shift operation any number of times.\n\n    One right shift operation means shifting all elements of the array by one\n    position in the right direction. The last element of the array will be moved to\n    the starting position in the array i.e. 0th index.\n\n    If it is possible to obtain the sorted array by performing the above operation\n    then return True else return False.\n    If the given array is empty then return True.\n\n    Note: The given list is guaranteed to have unique elements.\n\n    For Example:\n\n    move_one_ball([3, 4, 5, 1, 2])==>True\n    Explanation: By performin 2 right shift operations, non-decreasing order can\n                 be achieved for the given array.\n    move_one_ball([3, 5, 4, 1, 2])==>False\n    Explanation:It is not possible to get non-decreasing order for the given\n                array by performing any number of right shift operations.\n\n    \"\"\"\n    if not arr:\n        return True\n\n    def is_sorted(sub_arr):\n        \"\"\"Checks if a sub-array is sorted in non-decreasing order.\"\"\"\n        if not sub_arr:\n            return True\n        return all(sub_arr[i] <= sub_arr[i+1] for i in range(len(sub_arr) - 1))\n\n    def find_break_points(sub_arr):\n        \"\"\"Finds indices where sub_arr[i] > sub_arr[i+1].\"\"\"\n        break_points = []\n        for i in range(len(sub_arr) - 1):\n            if sub_arr[i] > sub_arr[i+1]:\n                break_points.append(i)\n        return break_points\n\n    break_points = find_break_points(arr)\n\n    if not break_points:\n        return True\n    elif len(break_points) > 1:\n        return False\n    else:\n        break_idx = break_points[0]\n        # Check if segments before and after the breakpoint are sorted,\n        # and if the \"wrapped\" element (last to first) maintains order.\n        return (is_sorted(arr[break_idx+1:]) and\n                is_sorted(arr[:break_idx+1]) and\n                arr[-1] <= arr[0])"}
{"task_id": "HumanEval/112", "solution": "```python\ndef reverse_delete(s,c):\n    \"\"\"Deletes characters from s present in c and checks if the resulting string is a palindrome.\"\"\"\n\n    # FR1: Delete characters\n    # Convert c to a set for efficient lookup\n    c_set = set(c)\n    result_string_list = []\n    for char_s in s:\n        if char_s not in c_set:\n            result_string_list.append(char_s)\n    result_string = \"\".join(result_string_list)\n\n    # FR2: Check if the result string is a palindrome\n    is_palindrome = result_string == result_string[::-1]\n\n    # FR3: Return the tuple\n    return (result_string, is_palindrome)\n```"}
{"task_id": "HumanEval/111", "solution": "```python\ndef histogram(test):\n    \"\"\"Given a string representing a space separated lowercase letters, return a dictionary\n    of the letter with the most repetition and containing the corresponding count.\n    If several letters have the same occurrence, return all of them.\n    \"\"\"\n    if not test:\n        return {}\n\n    # Split the string by spaces and filter out any empty strings resulting from multiple spaces.\n    letters = [char for char in test.split(' ') if char]\n\n    # If, after splitting and filtering, there are no letters (e.g., input was '   '), return an empty dict.\n    if not letters:\n        return {}\n\n    # Count the frequencies of each letter using a dictionary.\n    frequency_map = {}\n    for letter in letters:\n        frequency_map[letter] = frequency_map.get(letter, 0) + 1\n\n    # Find the maximum occurrence count among all letters.\n    max_count = 0\n    if frequency_map: # Check if frequency_map is not empty before calling max()\n        max_count = max(frequency_map.values())\n\n    # Build the result dictionary containing only letters with the maximum count.\n    result = {\n        letter: count\n        for letter, count in frequency_map.items()\n        if count == max_count\n    }\n    return result\n```"}
{"task_id": "HumanEval/113", "solution": "```python\ndef odd_count(lst):\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\n    \"\"\"\n    ODD_DIGITS = {'1', '3', '5', '7', '9'}\n    OUTPUT_TEMPLATE = \"the number of odd elements {}n the str{}ng {} of the {}nput.\"\n\n    results = []\n    for s in lst:\n        odd_digit_count = 0\n        for char in s:\n            if char in ODD_DIGITS:\n                odd_digit_count += 1\n\n        formatted_string = OUTPUT_TEMPLATE.format(odd_digit_count, odd_digit_count, odd_digit_count, odd_digit_count)\n        results.append(formatted_string)\n\n    return results\n```"}
{"task_id": "HumanEval/114", "solution": "```python\ndef minSubArraySum(nums):\n    \"\"\"\n    Finds the minimum sum of any non-empty sub-array using Kadane's algorithm.\n    It iterates through the array, keeping track of the current minimum sum ending at the current position and the overall minimum sum found so far.\n    \"\"\"\n    min_so_far = nums[0]\n    current_min = nums[0]\n\n    for i in range(1, len(nums)):\n        current_min = min(nums[i], current_min + nums[i])\n        min_so_far = min(min_so_far, current_min)\n    return min_so_far\n```"}
{"task_id": "HumanEval/115", "solution": "import math\n\ndef max_fill(grid, capacity):\n    \"\"\"\n    Calculates the total number of times buckets need to be lowered to empty all wells.\n    Each '1' in the grid represents a unit of water, and capacity is the bucket size.\n    \"\"\"\n    total_bucket_lowers = 0\n    for well_row in grid:\n        water_in_well = sum(well_row)\n        if water_in_well > 0:\n            lowers_for_well = math.ceil(water_in_well / capacity)\n            total_bucket_lowers += lowers_for_well\n    return total_bucket_lowers"}
{"task_id": "HumanEval/118", "solution": "```python\ndef get_closest_vowel(word):\n    \"\"\"Finds the closest vowel that stands between two consonants from the right side of the word.\n    Vowels at the beginning and ending don't count.\"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def _is_vowel(char):\n        return char.lower() in VOWELS\n\n    def _is_consonant(char):\n        # Assumes char is an English letter as per problem statement.\n        return char.isalpha() and not _is_vowel(char)\n\n    n = len(word)\n    if n < 3:\n        return \"\"\n\n    # Iterate from right to left, checking characters from index n-2 down to 1.\n    # This ensures the vowel itself is not at the beginning (index 0) or end (index n-1).\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i - 1]\n        right_char = word[i + 1]\n\n        if _is_vowel(current_char) and \\\n           _is_consonant(left_char) and \\\n           _is_consonant(right_char):\n            return current_char\n\n    return \"\"\n```\n"}
