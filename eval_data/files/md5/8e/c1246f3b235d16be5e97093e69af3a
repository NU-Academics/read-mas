{"task_id": "HumanEval/136", "solution": "```python\ndef largest_smallest_integers(lst):\n    '''\n    Finds the largest negative and smallest positive integers in a list.\n    Returns (largest_negative, smallest_positive), using None if a category is missing.\n    '''\n    largest_neg = None\n    smallest_pos = None\n\n    for num in lst:\n        if num < 0:\n            if largest_neg is None or num > largest_neg:\n                largest_neg = num\n        elif num > 0:\n            if smallest_pos is None or num < smallest_pos:\n                smallest_pos = num\n\n    return (largest_neg, smallest_pos)\n```"}
{"task_id": "HumanEval/140", "solution": "```python\nimport re\n\ndef fix_spaces(text):\n    \"\"\"\n    Replaces sequences of 3 or more spaces with a hyphen, and single spaces with an underscore.\n    The rule for 3+ consecutive spaces takes precedence.\n    \"\"\"\n    # First, replace sequences of 3 or more spaces with a single hyphen\n    modified_text = re.sub(r' {3,}', '-', text)\n\n    # Then, replace any remaining single spaces (which were originally 1 or 2 spaces) with underscores\n    modified_text = modified_text.replace(' ', '_')\n\n    return modified_text\n```"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    def _calculate_simple_factorial(k):\n        \"\"\"Calculates the standard factorial of a non-negative integer k.\"\"\"\n        if k == 0:\n            return 1\n        result = 1\n        for j in range(1, k + 1):\n            result *= j\n        return result\n\n    special_fact_result = 1\n    for i in range(1, n + 1):\n        special_fact_result *= _calculate_simple_factorial(i)\n\n    return special_fact_result```"}
{"task_id": "HumanEval/137", "solution": "```python\ndef compare_one(a, b):\n    \"\"\"\n    Compares two values (int, float, or string representing a real number) and returns the larger one.\n    Returns None if the values are numerically equal, preserving the original type of the returned value.\n    \"\"\"\n\n    # Helper function to convert any input to a float for consistent numerical comparison.\n    # It handles string inputs by replacing commas with periods before conversion.\n    def _to_float(val):\n        if isinstance(val, str):\n            return float(val.replace(',', '.'))\n        return float(val)\n\n    float_a = _to_float(a)\n    float_b = _to_float(b)\n\n    if float_a > float_b:\n        return a\n    elif float_b > float_a:\n        return b\n    else:\n        return None\n```"}
{"task_id": "HumanEval/141", "solution": "```python\ndef file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on specific rules.\"\"\"\n\n    # Condition 2: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    parts = file_name.split('.')\n    prefix = parts[0]\n    extension = parts[1]\n\n    # Condition 3: The substring before the dot should not be empty, and it starts with a letter.\n    if not prefix or not prefix[0].isalpha():\n        return 'No'\n\n    # Condition 4: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    VALID_EXTENSIONS = ['txt', 'exe', 'dll']\n    if extension not in VALID_EXTENSIONS:\n        return 'No'\n\n    # Condition 1: There should not be more than three digits ('0'-'9') in the file's name.\n    digit_count = 0\n    for char in file_name:\n        if char.isdigit():\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    # If all conditions are met\n    return 'Yes'\n```\n"}
{"task_id": "HumanEval/144", "solution": "```python\nimport math\n\nclass Fraction:\n    def __init__(self, numerator: int, denominator: int):\n        \"\"\"Initializes a Fraction object with given numerator and denominator.\"\"\"\n        self.numerator = numerator\n        self.denominator = denominator\n\n    def multiply(self, other: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another fraction, returning a new product fraction.\"\"\"\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def simplify(self) -> None:\n        \"\"\"Reduces the fraction to its simplest form by dividing by their GCD.\"\"\"\n        common_divisor = math.gcd(self.numerator, self.denominator)\n        self.numerator //= common_divisor\n        self.denominator //= common_divisor\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Checks if the simplified fraction represents a whole number.\"\"\"\n        self.simplify()\n        return self.denominator == 1\n\nclass FractionParser:\n    @staticmethod\n    def parse_fraction(fraction_str: str) -> Fraction:\n        \"\"\"Parses a fraction string into a Fraction object.\"\"\"\n        parts = fraction_str.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return Fraction(numerator, denominator)\n\ndef simplify(x, n):\n    \"\"\"\n    Checks if the product of two fractions, x and n, is a whole number.\n    Returns True if x * n evaluates to a whole number, False otherwise.\n    \"\"\"\n    fraction_x = FractionParser.parse_fraction(x)\n    fraction_n = FractionParser.parse_fraction(n)\n\n    product_fraction = fraction_x.multiply(fraction_n)\n\n    return product_fraction.is_whole_number()\n```"}
{"task_id": "HumanEval/142", "solution": "```python\ndef sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n\n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    modified_list = []\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            modified_list.append(num * num)\n        elif i % 4 == 0:\n            modified_list.append(num * num * num)\n        else:\n            modified_list.append(num)\n    return sum(modified_list)\n```"}
{"task_id": "HumanEval/143", "solution": "```python\ndef words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, returning only those with prime lengths.\n    Maintains original word order and separates results with spaces.\n    \"\"\"\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if an integer n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.split()\n    filtered_words = []\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n\n    return \" \".join(filtered_words)\n```"}
{"task_id": "HumanEval/146", "solution": "```python\ndef specialFilter(nums):\n    \"\"\"\n    Counts numbers in the array that are greater than 10 and have both\n    first and last digits (absolute value) as odd.\n    \"\"\"\n    def is_odd(digit):\n        return digit in (1, 3, 5, 7, 9)\n\n    count = 0\n    for num in nums:\n        if num > 10:\n            abs_num_str = str(abs(num))\n\n            first_digit = int(abs_num_str[0])\n            last_digit = int(abs_num_str[-1])\n\n            if is_odd(first_digit) and is_odd(last_digit):\n                count += 1\n    return count\n```"}
{"task_id": "HumanEval/145", "solution": "def _calculate_digit_sum(n: int) -> int:\n    \"\"\"Calculates the sum of the absolute value of digits of an integer.\"\"\"\n    return sum(int(digit) for digit in str(abs(n)))\n\nclass SortableNumber:\n    \"\"\"\n    A data class to encapsulate an integer, its sum of digits, and its original index\n    for custom sorting.\n    \"\"\"\n    def __init__(self, value: int, original_index: int):\n        self.value = value\n        self.original_index = original_index\n        self.digit_sum = _calculate_digit_sum(value)\n\n    def __lt__(self, other: 'SortableNumber') -> bool:\n        \"\"\"\n        Compares two SortableNumber instances.\n        Primary sort key: digit_sum (ascending)\n        Secondary sort key: original_index (ascending)\n        \"\"\"\n        if self.digit_sum != other.digit_sum:\n            return self.digit_sum < other.digit_sum\n        return self.original_index < other.original_index\n\n    def __repr__(self) -> str:\n        return f\"SortableNumber(value={self.value}, sum={self.digit_sum}, index={self.original_index})\"\n\ndef order_by_points(nums):\n    \"\"\"\n    Write a function which sorts the given list of integers\n    in ascending order according to the sum of their digits.\n    Note: if there are several items with similar sum of their digits,\n    order them based on their index in original list.\n\n    For example:\n    >>> order_by_points([1, 11, -1, -11, -12]) == [-1, -11, 1, -12, 11]\n    >>> order_by_points([]) == []\n    \"\"\"\n    if not isinstance(nums, list):\n        raise TypeError(\"Input 'nums' must be a list.\")\n    if not all(isinstance(n, int) for n in nums):\n        raise TypeError(\"All elements in 'nums' must be integers.\")\n\n    sortable_items = [\n        SortableNumber(value=num, original_index=i)\n        for i, num in enumerate(nums)\n    ]\n\n    sortable_items.sort()\n\n    return [item.value for item in sortable_items]"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n\n    Example :\n        Input: n = 5\n        Output: 1\n        Explanation:\n        a = [1, 3, 7, 13, 21]\n        The only valid triple is (1, 7, 13).\n    \"\"\"\n\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    def _combinations(n_val: int, k_val: int) -> int:\n        \"\"\"Calculates n choose k (combinations).\"\"\"\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0 or k_val == n_val:\n            return 1\n        if k_val > n_val // 2:\n            k_val = n_val - k_val\n\n        res = 1\n        for i in range(k_val):\n            res = res * (n_val - i) // (i + 1)\n        return res\n\n    def _get_remainder_counts(n_limit: int) -> tuple[int, int]:\n        \"\"\"Counts elements by their remainder modulo 3 for a[i] = i*i - i + 1.\"\"\"\n        count_rem0 = 0  # Count of i where (i*i - i + 1) % 3 == 0\n        count_rem1 = 0  # Count of i where (i*i - i + 1) % 3 == 1\n\n        for i in range(1, n_limit + 1):\n            # Analyze (i*i - i + 1) % 3:\n            # If i % 3 == 0: (0 - 0 + 1) % 3 = 1\n            # If i % 3 == 1: (1 - 1 + 1) % 3 = 1\n            # If i % 3 == 2: (4 - 2 + 1) % 3 = 3 % 3 = 0\n            if i % 3 == 2:\n                count_rem0 += 1\n            else:\n                count_rem1 += 1\n        return count_rem0, count_rem1\n\n    count_rem0, count_rem1 = _get_remainder_counts(n)\n\n    # A triple (a[i], a[j], a[k]) sums to a multiple of 3 if:\n    # 1. All three elements have a remainder of 0 when divided by 3. (0 + 0 + 0 = 0)\n    # 2. All three elements have a remainder of 1 when divided by 3. (1 + 1 + 1 = 3)\n    # No other combination of remainders (e.g., 0+0+1, 0+1+1) will sum to a multiple of 3.\n    combinations_0 = _combinations(count_rem0, 3)\n    combinations_1 = _combinations(count_rem1, 3)\n\n    return combinations_0 + combinations_1"}
{"task_id": "HumanEval/150", "solution": "```python\nimport math\n\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n    \"\"\"\n    is_n_prime = True\n    if n < 2:\n        is_n_prime = False\n    else:\n        for i in range(2, int(math.sqrt(n)) + 1):\n            if n % i == 0:\n                is_n_prime = False\n                break\n\n    if is_n_prime:\n        return x\n    else:\n        return y\n```"}
{"task_id": "HumanEval/148", "solution": "```python\nfrom typing import List, Tuple\n\nclass PlanetOrder:\n    PLANET_ORDER: List[str] = [\n        \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n    ]\n\n    def get_planet_index(self, planet_name: str) -> int:\n        # Returns the 0-based index of a given planet name.\n        try:\n            return self.PLANET_ORDER.index(planet_name)\n        except ValueError:\n            # This should ideally not be reached if is_valid_planet is checked first.\n            return -1 # Indicate not found without raising, consistent with service logic.\n\n    def get_planet_by_index(self, index: int) -> str:\n        # Returns the planet name at a specific index.\n        if 0 <= index < len(self.PLANET_ORDER):\n            return self.PLANET_ORDER[index]\n        return \"\" # Indicate not found.\n\n    def get_all_planets(self) -> List[str]:\n        # Returns a copy of the entire ordered list of planet names.\\\n        return list(self.PLANET_ORDER)\n\n    def is_valid_planet(self, planet_name: str) -> bool:\n        # Checks if a given string is a valid planet name.\\\n        return planet_name in self.PLANET_ORDER\n\nclass PlanetService:\n    def __init__(self, planet_order: PlanetOrder):\\\n        # Initializes the service with a PlanetOrder instance.\\\n        self._planet_order = planet_order\n\n    def get_planets_between(self, planet1: str, planet2: str) -> Tuple[str, ...]:\n        # Calculates and returns a tuple of planets between planet1 and planet2.\\\n        if not self._planet_order.is_valid_planet(planet1) or \\\n           not self._planet_order.is_valid_planet(planet2):\n            return ()\n\n        idx1 = self._planet_order.get_planet_index(planet1)\n        idx2 = self._planet_order.get_planet_index(planet2)\n\n        start_idx = min(idx1, idx2)\n        end_idx = max(idx1, idx2)\n\n        if end_idx - start_idx <= 1: # No planets between them.\n            return ()\n\n        between_planets = self._planet_order.get_all_planets()[start_idx + 1:end_idx]\n        return tuple(between_planets)\n\n# Initialize dependencies for the bf function.\n_planet_order_instance = PlanetOrder()\n_planet_service_instance = PlanetService(planet_order=_planet_order_instance)\n\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun\n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn,\n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2.\n    The function should return a tuple containing all planets whose orbits are\n    located between the orbit of planet1 and the orbit of planet2, sorted by\n    the proximity to the sun.\n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names.\n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    return _planet_service_instance.get_planets_between(planet1, planet2)\n```"}
{"task_id": "HumanEval/151", "solution": "```python\ndef double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n\n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0\n\n    If the input list is empty, return 0.\n    '''\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for item in lst:\n        # Ignore numbers that are not integers.\n        if isinstance(item, int):\n            # Ignore numbers that are negative.\n            if item >= 0:\n                # Select numbers that are odd.\n                if item % 2 != 0:\n                    # Square the odd, non-negative integer and add to the sum.\n                    total_sum += item * item\n    return total_sum\n```"}
{"task_id": "HumanEval/149", "solution": "```python\ndef sorted_list_sum(lst):\n    \"\"\"\n    Filters a list of strings, removing those with odd lengths,\n    then sorts the remaining strings by length (ascending) and then alphabetically (ascending).\n    \"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    sorted_result = sorted(even_length_strings, key=lambda s: (len(s), s))\n    return sorted_result\n```"}
{"task_id": "HumanEval/152", "solution": "```python\ndef compare(game,guess):\n    \"\"\"Return an array of the same length denoting how far off each guess was.\n    If they have guessed correctly, the value is 0, and if not, the value is the absolute difference.\n    \"\"\"\n    if len(game) != len(guess):\n        raise ValueError(\"Input lists 'game' and 'guess' must be of equal length.\")\n\n    result = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            result.append(0)\n        else:\n            result.append(abs(game[i] - guess[i]))\n    return result\n```"}
{"task_id": "HumanEval/155", "solution": "```python\ndef even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Process the absolute value of the number to handle negative inputs.\n    abs_num = abs(num)\n\n    # Special case: If the number is 0, it contains one even digit.\n    if abs_num == 0:\n        return (1, 0)\n\n    # Convert the absolute number to a string to iterate through its digits.\n    num_str = str(abs_num)\n    for digit_char in num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)\n```"}
{"task_id": "HumanEval/156", "solution": "```python\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    ROMAN_MAP = [\n        (1000, \"m\"), (900, \"cm\"), (500, \"d\"), (400, \"cd\"),\n        (100, \"c\"), (90, \"xc\"), (50, \"l\"), (40, \"xl\"),\n        (10, \"x\"), (9, \"ix\"), (5, \"v\"), (4, \"iv\"), (1, \"i\")\n    ]\n\n    result = []\n    for value, numeral in ROMAN_MAP:\n        while number >= value:\n            result.append(numeral)\n            number -= value\n    return \"\".join(result)\n```"}
{"task_id": "HumanEval/153", "solution": "```python\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension based on the difference between uppercase and lowercase letters.\n    Returns the class name combined with the strongest extension name.\n    \"\"\"\n    strongest_extension_name = \"\"\n    max_strength = -float('inf') # Initialize with a very low number to ensure any valid strength is greater\n\n    for current_ext_name in extensions:\n        cap_count = 0\n        sm_count = 0\n        for char in current_ext_name:\n            if 'A' <= char <= 'Z':\n                cap_count += 1\n            elif 'a' <= char <= 'z':\n                sm_count += 1\n\n        current_strength = cap_count - sm_count\n\n        # If current strength is strictly greater, it's the new strongest.\n        # This naturally handles the tie-breaking rule: if strengths are equal,\n        # the first one encountered (which is already stored) is kept.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = current_ext_name\n\n    return f\"{class_name}.{strongest_extension_name}\"\n```"}
{"task_id": "HumanEval/154", "solution": "```python\ndef cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    \"\"\"\n    if not b:\n        return True\n    if not a:\n        return False\n    if len(b) > len(a):\n        return False\n\n    # Generate all unique cyclic rotations of string b\n    rotations = []\n    n_b = len(b)\n    for i in range(n_b):\n        rotated_b = b[i:] + b[:i]\n        rotations.append(rotated_b)\n    unique_rotations = list(set(rotations))\n\n    # Check if any of the generated rotations of b are substrings of a\n    for rotation in unique_rotations:\n        if rotation in a:\n            return True\n\n    return False\n```"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n\n    find_max([\"name\", \"of\", \"string\"]) == \"string\"\n    find_max([\"name\", \"enam\", \"game\"]) == \"enam\"\n    find_max([\"aaaaaaa\", \"bb\" ,\"cc\"]) == \"\"aaaaaaa\"\n    \"\"\"\n\n    def _count_unique_chars(word: str) -> int:\n        \"\"\"Counts the number of unique characters in a given string.\"\"\"\n        return len(set(word))\n\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = _count_unique_chars(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Tie-breaker: lexicographical order\n            if word < result_word:\n                result_word = word\n\n    return result_word"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten and remaining carrots after a rabbit's meal.\n    The rabbit eats as many carrots as it needs, or all remaining carrots if not enough.\n    \"\"\"\n\n    # Calculate how many carrots the rabbit actually eats from the remaining stock\n    actual_eaten = min(need, remaining)\n\n    # Calculate the total number of carrots eaten by the rabbit\n    total_eaten = number + actual_eaten\n\n    # Calculate the number of carrots left in stock\n    carrots_left = remaining - actual_eaten\n\n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/161", "solution": "```python\ndef solve(s):\n    \"\"\"Processes a string: reverses letter cases if letters are present, otherwise reverses the entire string.\"\"\"\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    if not has_letters:\n        return s[::-1]\n    else:\n        result_chars = []\n        for char in s:\n            if char.isalpha():\n                if char.islower():\n                    result_chars.append(char.upper())\n                else:\n                    result_chars.append(char.lower())\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)\n```"}
{"task_id": "HumanEval/162", "solution": "import hashlib\n\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    # MD5 hash requires bytes, so encode the string (UTF-8 is a common choice).\n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
{"task_id": "HumanEval/160", "solution": "```python\ndef do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and\n    the second list is a list of integers. Use the two given lists to build the algebric\n    expression and return the evaluation of this expression.\n    \"\"\"\n    expression_parts = []\n    for i in range(len(operand)):\n        expression_parts.append(str(operand[i]))\n        if i < len(operator):\n            expression_parts.append(operator[i])\n\n    expression_string = \" \".join(expression_parts)\n\n    # Use eval with a restricted scope to safely evaluate the expression.\n    # The problem context ensures operators and operands are controlled.\n    result = eval(expression_string, {\"__builtins__\": {}}, {})\n    return int(result)\n```"}
{"task_id": "HumanEval/163", "solution": "```python\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    start = min(a, b)\n    end = max(a, b)\n\n    result = []\n    # According to the examples, \"even digits\" refers to the single-digit even numbers (2, 4, 6, 8).\n    # The output should only include these digits if they fall within the given range [start, end].\n    even_digits = [2, 4, 6, 8]\n\n    for digit in even_digits:\n        if start <= digit <= end:\n            result.append(digit)\n\n    return result\n```"}
{"task_id": "HumanEval/157", "solution": "```python\nimport math\n\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # Validate that all side lengths are numeric.\n    if not all(isinstance(side, (int, float)) for side in [a, b, c]):\n        raise TypeError(\"Side lengths must be numeric.\")\n\n    # Validate that all side lengths are positive.\n    if not all(side > 0 for side in [a, b, c]):\n        raise ValueError(\"Side lengths must be positive.\")\n\n    # Sort the sides to easily identify the two shorter sides and the longest side (potential hypotenuse).\n    sides = sorted([a, b, c])\n\n    # Define a tolerance for floating-point comparisons to account for precision issues.\n    FLOAT_TOLERANCE = 1e-9\n\n    # Apply the Pythagorean theorem: a^2 + b^2 = c^2, using math.isclose for robust comparison.\n    return math.isclose(sides[0]**2 + sides[1]**2, sides[2]**2, rel_tol=FLOAT_TOLERANCE)\n```\n"}
