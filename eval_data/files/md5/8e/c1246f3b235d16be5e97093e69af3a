{"task_id": "HumanEval/37", "solution": "```python\ndef sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    # Create a copy of the list to modify\n    result = l[:]\n\n    # Extract elements at even indices\n    even_indexed_elements = [l[i] for i in range(0, len(l), 2)]\n\n    # Sort these extracted elements\n    sorted_even_elements = sorted(even_indexed_elements)\n\n    # Place sorted even elements back into their original even positions in the result list\n    even_idx_ptr = 0\n    for i in range(0, len(l), 2):\n        result[i] = sorted_even_elements[even_idx_ptr]\n        even_idx_ptr += 1\n\n    return result\n```"}
{"task_id": "HumanEval/38", "solution": "```python\ndef decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # uncycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)\n```"}
{"task_id": "HumanEval/39", "solution": "```python\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    \"\"\"\n\n    def _is_prime(num: int) -> bool:\n        \"\"\"Checks if a number is prime.\"\"\"\n        if num < 2:\n            return False\n        for i in range(2, int(num**0.5) + 1):\n            if num % i == 0:\n                return False\n        return True\n\n    def _fibonacci_generator():\n        \"\"\"Generates Fibonacci numbers indefinitely, starting from 0.\"\"\"\n        a, b = 0, 1\n        while True:\n            yield a\n            a, b = b, a + b\n\n    prime_fib_count = 0\n    fib_gen = _fibonacci_generator()\n    while True:\n        fib_num = next(fib_gen)\n        # 0 and 1 are not prime, so skip them directly.\n        if fib_num < 2:\n            continue\n\n        if _is_prime(fib_num):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                return fib_num\n```"}
{"task_id": "HumanEval/32", "solution": "import math\n\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    DEFAULT_TOLERANCE: float = 1e-6\n    MAX_ITERATIONS: int = 1000\n    SEARCH_RANGE_START: float = -1000.0\n    SEARCH_RANGE_END: float = 1000.0\n\n    def bisection_helper(func, a: float, b: float, tol: float, max_iter: int) -> float:\n        \"\"\"\n        Finds a root of func within [a, b] using the bisection method.\n        It iterates until tolerance is met or max iterations are reached.\n        \"\"\"\n        fa = func(a)\n        fb = func(b)\n\n        # Check for immediate roots at the boundaries\n        if abs(fa) < tol:\n            return a\n        if abs(fb) < tol:\n            return b\n\n        # Initialize c for the case where max_iter is 0 or loop doesn't run\n        c = (a + b) / 2.0\n\n        for _ in range(max_iter):\n            c = (a + b) / 2.0\n            fc = func(c)\n\n            if abs(fc) < tol:\n                return c\n\n            # If the interval becomes too small, return the current midpoint as approximation\n            if abs(b - a) < tol:\n                return c\n\n            if fa * fc < 0:  # Root is in [a, c]\n                b = c\n                fb = fc\n            else:  # Root is in [c, b]\n                a = c\n                fa = fc\n\n        # If max_iter is reached, return the last calculated midpoint\n        return c\n\n    # Create a lambda function to pass the polynomial evaluation to the bisection helper\n    func_to_solve = lambda val: poly(xs, val)\n\n    return bisection_helper(func_to_solve, SEARCH_RANGE_START, SEARCH_RANGE_END, DEFAULT_TOLERANCE, MAX_ITERATIONS)"}
{"task_id": "HumanEval/40", "solution": "```python\ndef triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    l.sort()  # Sort the list to enable the two-pointer technique.\n\n    for i in range(n - 2):\n        # Skip duplicate elements for l[i] to avoid redundant calculations.\n        if i > 0 and l[i] == l[i-1]:\n            continue\n\n        left, right = i + 1, n - 1\n        while left < right:\n            current_sum = l[i] + l[left] + l[right]\n\n            if current_sum == 0:\n                return True # Found a triplet that sums to zero.\n            elif current_sum < 0:\n                left += 1\n            else:\n                right -= 1\n\n    return False # No triplet found after checking all possibilities.\n```"}
