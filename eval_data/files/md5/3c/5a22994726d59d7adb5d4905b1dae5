   if char.islower():\n            return char.upper()\n        elif char.isupper():\n            return char.lower()\n        return char\n\n    def _contains_letters(s: str) -> bool:\n        # Checks if the entire string contains any alphabetic letters.\n        for char in s:\n            if _is_letter(char):\n                return True\n        return False\n\n    def _reverse_string(s: str) -> str:\n        # Reverses the order of characters in a given string.\n        return s[::-1]\n\n    if not _contains_letters(s):\n        return _reverse_string(s)\n    else:\n        result_chars = []\n        for char in s:\n            if _is_letter(char):\n                result_chars.append(_reverse_char_case(char))\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/15": [{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    >>> string_sequence(0)\n    '0'\n    >>> string_sequence(5)\n    '0 1 2 3 4 5'\n    \"\"\"\n    # Generate numbers from 0 to n, convert them to strings, and join with spaces.\n    return ' '.join(str(i) for i in range(n + 1))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/163": [{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n    result = []\n    for i in range(min_val, max_val + 1):\n        if i % 2 == 0 and i >= 0 and i <= 9: # Check for even and single digit\n            result.append(i)\n    return result", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[9876543