": [{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            is_increasing = False\n        if l[i] < l[i+1]:\n            is_decreasing = False\n        \n        # Optimization: if both flags become False, it's not monotonic\n        if not is_increasing and not is_decreasing:\n            return False\n\n    return is_increasing or is_decreasing", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/64": [{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts the number of vowels in a string, including 'y' if it's at the end.\n    Vowel checking is case-insensitive.\n    \"\"\"\n    vowels = {'a', 'e', 'i', 'o', 'u'}\n    count = 0\n    s_lower = s.lower()\n    n = len(s_lower)\n\n    for i, char in enumerate(s_lower):\n        if char in vowels:\n            count += 1\n        elif char == 'y' and i == n - 1:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/65": [{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    digits_str = str(x)\n    digits = [int(d) for d in digits_str]\n    num_digits = len(digits)\n\n    if shift > num_digits:\n        # If shift is greater than the number of digits, reverse the digits.\n        shifted_digits = digits[::-1]\n    else:\n        # Perform a circular right shift.\n        # Calculate the effective shift amount.\n        effective_shift = shift % num_digits\n        \n        # Split the list and reassemble for the circular shift.\n        shifted_digits = digits[-effective_shift:] + digits[:-effective_shift]\n    \n    return \"\".join(str(d) for d in shifted_digits)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/68": [{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even non-negative integer and its corresponding smallest index.\n    Returns [value, index] or an empty list if no even numbers or the array is empty.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n            elif value == smallest_even_value and index < smallest_even_index:\n                # If values are equal, prioritize the smaller index\n                smallest_even_index = index\n    \n    if smallest_even_index != -1:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/66": [{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Task\n    Write a function that takes a string as input and returns the sum of the upper characters only'\n    ASCII codes.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/69": [{"task_id": "HumanEval/69", "solution": "def search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    frequencies = {}\n    for num in lst:\n        frequencies[num] = frequencies.get(num, 0) + 1\n\n    qualifying_integers = []\n    for value, freq in frequencies.items():\n        if freq >= value:\n            qualifying_integers.append(value)\n\n    if not qualifying_integers:\n        return -1\n    else:\n        return max(qualifying_integers)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/70": [{"task_id": "HumanEval/70", "solution": "from typing import List\nclass ListUtils:\n    \"\"\"Utility methods for list manipulations.\"\"\"\n\n    @staticmethod\n    def sort_and_copy(lst: List[int]) -> List[int]:\n        \"\"\"Creates a sorted copy of the input list.\"\"\"\n        return sorted(lst)\n\n    @staticmethod\n    def remove_min(lst: List[int]) -> int:\n        \"\"\"Removes and returns the minimum element from a list.\"\"\"\n        if not lst:\n            raise IndexError(\"remove_min called on empty list\")\n        return lst.pop(0)\n\n    @staticmethod\n    def remove_max(lst: List[int]) -> int:\n        \"\"\"Removes and returns the maximum element from a list.\"\"\"\n        if not lst:\n            raise IndexError(\"remove_max called on empty list\")\n        return lst.pop(-1)\nclass StrangeSorter:\n    \"\"\"Encapsulates the logic for strange sorting.\"\"\"\n\n    def sort(self, lst: List[int]) -> List[int]:\n        \"\"\"\