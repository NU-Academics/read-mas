 1\n        for i in range(k_val):\n            res = res * (n_val - i) // (i + 1)\n        return res\n\n    def _calculate_remainder_counts_inlined(n_param: int) -> tuple[int, int]:\n        \"\"\"Counts elements whose value a[i] = i*i - i + 1 has a remainder of 0 or 1 when divided by 3.\"\"\"\n        count_rem_0 = 0 # a[i] % 3 == 0 when i % 3 == 2\n        count_rem_1 = 0 # a[i] % 3 == 1 when i % 3 == 0 or i % 3 == 1\n        for i in range(1, n_param + 1):\n            if i % 3 == 2:\n                count_rem_0 += 1\n            else:\n                count_rem_1 += 1\n        return count_rem_0, count_rem_1\n\n    if n < 3:\n        return 0\n\n    count_rem_0, count_rem_1 = _calculate_remainder_counts_inlined(n)\n\n    triples_000 = combinations(count_rem_0, 3)\n    triples_111 = combinations(count_rem_1, 3)\n\n    return triples_000 + triples_111", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/151": [{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \"\"\"\n    total_sum_of_squares = 0\n\n    for item in lst:\n        # Check if it's an integer\n        if isinstance(item, int):\n            # Check if it's positive and odd\n            if item > 0 and item % 2 != 0:\n                total_sum_of_squares += item * item\n    return total_sum_of_squares", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/94": [{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    import math\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if an integer n is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    def sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the digits of a non-negative integer.\"\"\"\n        s = 0\n        while n > 0:\n            s += n % 10\n            n //= 10\n        return s\n\n    largest_prime = None\n    for num in lst:\n        if is_prime(num):\n            if largest_prime is None or num > largest_prime:\n                largest_prime = num\n\n    if largest_prime is None:\n        return 0\n    else:\n        return sum_digits(largest_prime)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/144": [{"task_id": "HumanEval/144", "solution": "import math\nclass Fraction:\n    def __init__(self, numerator: int, denominator: int):\n        if not isinstance(numerator, int) or not isinstance(denominator, int):\n            raise ValueError(\"Numerator and denominator must be integers.\")\n        if denominator == 0:\n            raise ValueError(\"Denominator cannot be zero.\")\n        if numerator <= 0 or denominator <= 0:\n            raise ValueError(\"Numerator and denominator must be positive whole numbers.\")\n        self.numerator = numerator\n        self.denominator = denominator\n\n    def __mul__(self, other: 'Fraction') -> 'Fraction':\n        # Multiplies this fraction by another and simplifies the result.\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator).simplify()\n\n    def is_whole(self) -> bool:\n        # Checks if the fraction represents a whole number.\n        return self.numerator % self.denominator == 0\n\n    def simplify(self) -> 'Fraction':\n        # Simplifies the fraction to its lowest terms.\n        common_divisor = math.gcd(self.numerator, self.denominator)\n        return Fraction(self.numerator // common_divisor, self.denominator // common_divisor)\n\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, Fraction):\n            return NotImplemented\n        self_simplified = self.simplify()\n        other_simplified = other.simplify()\n        return self_simplified.numerator == other_simplified.numerator and \\\n               self_simplified.denominator == other_simplified.denominator\n\n    def __repr__(self) -> str:\n        return f\"Fraction({self.numerator}/{self.denominator})\"\nclass FractionParser:\n    def parse_fraction(self, fraction_str: str) -> Fraction:\n        # Parses a string like \"num/den\" into a Fraction object.\n        parts = fraction_str.split('/')\n        if len(parts) != 2:\n            raise ValueError(f\"Invalid fraction format: {fraction_str}. Expected 'numerator/denominator'.\")\n        try:\n            numerator = int(parts[0])\n            denominator = int(parts[1])\n        except ValueError as e:\n            raise ValueError(f\"Invalid number in fraction: {fraction_str}. Numerator and denominator must be integers.\") from e\n\n        return Fraction(numerator, denominator)\nclass FractionSimplifierService:\n    def __init__(self, parser: FractionParser):\n        # Initializes the service with a FractionParser instance.\n        self.parser = parser\n\n    def simplify(self, x: str, n: str) -> bool:\n        # Parses two fraction strings, multiplies them, and checks if the product is a whole number.\n        fraction_x = self.parser.parse_fraction(x)\n        fraction_n = self.parser.parse_fraction(n)\n        \n        product_fraction = fraction_x * fraction_n\n        \n        return product_fraction.is_whole()\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n