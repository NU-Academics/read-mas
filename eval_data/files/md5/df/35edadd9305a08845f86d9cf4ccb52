 \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n    \n    # Check if the string contains any alphabetic characters\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    # If no letters, reverse the entire string\n    if not has_letters:\n        return s[::-1]\n\n    # If letters are present, process each character\n    result_chars = []\n    for char in s:\n        if char.isalpha():\n            # Reverse the case of the letter\n            result_chars.append(char.swapcase())\n        else:\n            # Keep non-alphabetic characters as they are\n            result_chars.append(char)\n            \n    return \"\".join(result_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/162": [{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/160": [{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n    \"\"\"\n    from collections import deque\n\n    OPERATOR_PRECEDENCE = {\n        '**': 3,\n        '*': 2,\n        '//': 2,\n        '+': 1,\n        '-': 1\n    }\n\n    # Helper to check if an operator is right-associative (only '**' for this problem)\n    def _is_right_associative(op):\n        return op == '**'\n\n    # Shunting-yard algorithm to convert infix to postfix (RPN)\n    output_queue = deque()\n    operator_stack = deque()\n\n    # Start by pushing the first operand\n    output_queue.append(operand[0])\n\n    for i in range(len(operator)):\n        op_str = operator[i]\n        current_op_precedence = OPERATOR_PRECEDENCE[op_str]\n\n        # Process operators on stack based on precedence and associativity\n        while (operator_stack and\n               (OPERATOR_PRECEDENCE[operator_stack[-1]] > current_op_precedence or\n                (OPERATOR_PRECEDENCE[operator_stack[-1]] == current_op_precedence and\n                 not _is_right_associative(operator_stack[-1])))):\n            output_queue.append(operator_stack.pop())\n        \n        operator_stack.append(op_str)\n        \n        # Push the next operand\n        output_queue.append(operand[i+1])\n\n    # Pop any remaining operators from the stack to the output queue\n    while operator_stack:\n        output_queue.append(operator_stack.pop())\n\n    # Evaluate the postfix expression (RPN)\n    evaluation_stack = deque()\n    for token in output_queue:\n        if token in OPERATOR_PRECEDENCE: # It's an operator string\n            val2 = evaluation_stack.pop()\n            val1 = evaluation_stack.pop()\n\n            result = 0\n            if token == '+':\n                result = val1 + val2\n            elif token == '-':\n                result = val1 - val2\n            elif token == '*':\n                result = val1 * val2\n            elif token == '//':\n                if val2 == 0:\n                    raise ValueError(\"Division by zero is not allowed.\")\n                result = val1 // val2\n            elif token == '**':\n                result = val1 ** val2\n            \n            evaluation_stack.append(result)\n        else: # It's an operand (an integer)\n            evaluation_stack.append(token)\n\n    return evaluation_stack.pop()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/163": [{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    start = min(a, b)\n    end = max(a, b)\n\n    even_digits_in_range = []\n    # The relevant \"even digits\" are 2, 4, 6, 8, as inputs are positive.\n    for digit in [2, 4, 6, 8]:\n        if start <= digit <= end:\n            even_digits_in_range.append(digit)\n\n    return even_digits_in_range", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/15": [{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    >>> string_sequence(0)\n    '0'\n    >>> string_sequence(5)\n    '0 1 2 3 4 5'\n    \"\"\"\n    return \" \".join(str(i) for i in range(n + 1))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n    N = len(grid)\n\n    def get_value(r, c):\n        # Retrieves the value at the specified grid coordinates.\n        return grid[r][c]\n\n    def is_valid_coord(r, c):\n        # Checks if the given coordinates are within the grid boundaries.\n        return 0 <= r < N and 0 <= c < N\n\n    def get_neighbors(r, c):\n        # Returns a list of valid (row, col) tuples for adjacent cells (up, down, left, right).\n        neighbors = []\n        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # Up, Down, Left, Right\n        for dr, dc in directions:\n            new_row, new_col = r + dr, c + dc\n            if is_valid_coord(new_row, new_col):\n                neighbors.append((new_row, new_col))\n        return neighbors\n\n    def is_lexicographically_smaller(path_a, path_b):\n        # Compares two paths lexicographically. Python's list comparison inherently handles this.\n        return path_a < path_b\n\n    # Initialize min_path with values larger than any possible grid value to ensure any valid path is smaller.\n    max_grid_value = N * N\n    current_min_path = [max_grid_value + 1] * k\n\n    # Depth-First Search (DFS) function to explore all paths of length k.\n    def dfs(r, c, path_accumulator):\n        nonlocal current_min_path\n\n        # Add the current cell's value to the path being built.\n        path_accumulator.append(get_value(r, c))\n\n        # If the path has reached the desired length k, compare it with the current minimum path.\n        if len(path_accumulator) == k:\n            if is_lexicographically_smaller(path_accumulator, current_min_path):\n                current_min_path = list(path_accumulator)  # Update min_path if a smaller one is found.\n            path_accumulator.pop()  # Backtrack: remove the last cell to explore other path branches.\n            return\n\n        # Recursively explore neighbor cells for the next step in the path.\n        for next_r, next_c in get_neighbors(r, c):\n            dfs(next_r, next_c, path_accumulator)\n\n        path_accumulator.pop()  # Backtrack: remove the current cell after all its branches have been explored.\n\n    # Iterate through every cell in the grid to use it as a starting point for a path.\n    for r_start in range(N):\n        for c_start in range(N):\n            dfs(r_start, c_start, [])  # Start DFS with an empty path accumulator.\n\n    return current_min_path", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[12, 13, 10, 1], [9, 3, 15, 6], [5, 16, 14, 4], [11, 8, 7, 2]], 12]], "plus_fail_tests": [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], 15]]}], "HumanEval/130": [{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the first n + 1 numbers of the Tribonacci sequence.\n    The sequence is defined with tri(0)=1, tri(1)=3, tri(k)=1+k/2 for even k,\n    and tri(k)=tri(k-1)+tri(k-2)+tri(k+1) for odd k.\n    \"\"\"\n    memo = {}\n\n    def _get_tri_val(k):\n        if k in memo:\n            return memo[k]\n\n        if k == 0:\n            result = 1\n        elif k == 1:\n            result = 3\n        elif k % 2 == 0: # n is even\n            result = 1 + k // 2\n        else: # n is odd\n            result = _get_tri_val(k - 1) + _get_tri_val(k - 2) + _get_tri_val(k + 1)\n        \n        memo[k] = result\n        return result\n\n    sequence = []\n    for i in range(n + 1):\n        sequence.append(_get_tri_val(i))\n    \n    return sequence", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/83": [{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n\n    # Count of n-digit numbers that start with 1.\n    count_starts_with_one = 10**(n - 1)\n\n    # Count of n-digit numbers that end with 1 (first digit cannot be zero).\n    count_ends_with_one = 9 * (10**(n - 2))\n\n    # Count of n-digit numbers that start AND end with 1.\n    count_starts_and_ends_with_one = 10**(n - 2)\n\n    # Apply the principle of inclusion-exclusion.\n    return count_starts_with_one + count_ends_with_one - count_starts_and_ends_with_one", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/139": [{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    # Helper function to calculate the standard factorial k!\n    def _factorial(k):\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    special_fact_result = 1\n    # Calculate n! * (n-1)! * ... * 1!\n    for i in range(1, n + 1):\n        current_factorial = _factorial(i)\n        special_fact_result *= current_factorial\n    return special_fact_re