st_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on CAP - SM strength calculation and formats the output string.\"\"\"\n    if not extensions:\n        return class_name\n\n    def _calculate_strength(extension_name: str) -> int:\n        \"\"\"Calculates the strength of a single extension (Uppercase - Lowercase count).\"\"\"\n        cap_count = sum(1 for char in extension_name if char.isupper())\n        sm_count = sum(1 for char in extension_name if char.islower())\n        return cap_count - sm_count\n\n    strongest_extension_name = extensions[0]\n    max_strength = _calculate_strength(extensions[0])\n\n    for i in range(1, len(extensions)):\n        current_extension_name = extensions[i]\n        current_strength = _calculate_strength(current_extension_name)\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = current_extension_name\n        # Tie-breaking rule: if strength is equal, the one that came first is kept,\n        # which is implicitly handled by the `>` comparison.\n\n    return f\"{class_name}.{strongest_extension_name}\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/156": [{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n\n    result = []\n    temp_num = number\n\n    for value, numeral in roman_map:\n        while temp_num >= value:\n            result.append(numeral)\n            temp_num -= value\n\n    return \"\".join(result).lower()", "base_status": "pass", "plus_status": "