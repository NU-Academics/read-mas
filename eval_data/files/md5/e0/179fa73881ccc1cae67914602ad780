{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    # Parameters for numerical methods\n    tolerance = 1e-7  # Tolerance for determining if a value is close to zero or for interval width\n    max_bisection_iterations = 1000\n    max_bracket_search_iterations = 100\n    max_search_range_bound = 1e12 # A very large number to limit bracket search\n\n    # --- Step 1: Find an initial bracket [a, b] such that poly(a) and poly(b) have opposite signs ---\n    # Or, if an exact root is found during this search, return it immediately.\n    a = -1.0\n    b = 1.0\n\n    for _ in range(max_bracket_search_iterations):\n        val_a = poly(xs, a)\n        val_b = poly(xs, b)\n\n        # Check if one of the current bounds is already a root\n        if abs(val_a) < tolerance:\n            return a\n        if abs(val_b) < tolerance:\n            return b\n\n        # Check if a bracket is found\n        if val_a * val_b < 0:\n            break\n        else:\n            # Expand the search range symmetrically\n            a *= 2.0\n            b *= 2.0\n            # If the search range becomes extremely large, cap it.\n            # This case should ideally not be reached due to problem guarantees (solution exists).\n            if abs(a) > max_search_range_bound or abs(b) > max_search_range_bound:\n                a = -max_search_range_bound\n                b = max_search_range_bound\n                break\n    \n    # --- Step 2: Apply Bisection Method using the found bracket [a, b] ---\n    for _ in range(max_bisection_iterations):\n        c = (a + b) / 2.0\n        val_c = poly(xs, c)\n\n        # If the midpoint is close enough to zero, it's our root\n        if abs(val_c) < tolerance:\n            return c\n\n        # Re-evaluate poly(a) for safety against floating point issues or just use val_a\n        # We need the sign of val_a and val_c to decide which half to pick\n        val_a = poly(xs, a) \n\n        if val_a * val_c < 0: # Root is in the interval [a, c]\n            b = c\n        else: # Root is in the interval [c, b]\n            a = c\n        \n        # If the interval width is smaller than tolerance, return the midpoint\n        if (b - a) < tolerance:\n            return (a + b) / 2.0\n\n    # If max iterations are reached, return the midpoint of the final interval\n    return (a + b) / 2.0"}
{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    if not l:\n        # Per design context, assume non-empty list or let Python handle error for empty list.\n        # Python's built-in max() raises ValueError for an empty sequence.\n        # This implementation will raise IndexError if accessed l[0] on an empty list.\n        pass\n\n    max_value = l[0]\n    for element in l:\n        if element > max_value:\n            max_value = element\n    return max_value"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\n        return []\n\n    # Create a mutable copy of the input list to build the result.\n    result = list(l)\n\n    # Collect elements from indices divisible by three.\n    elements_to_sort = []\n    for i in range(len(l)):\n        if i % 3 == 0:\n            elements_to_sort.append(l[i])\n\n    # Sort the collected elements.\n    sorted_elements = sorted(elements_to_sort)\n\n    # Reconstruct the list by placing sorted elements back into their original positions.\n    sorted_elements_idx = 0\n    for i in range(len(result)):\n        if i % 3 == 0:\n            result[i] = sorted_elements[sorted_elements_idx]\n            sorted_elements_idx += 1\n\n    return result"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_count = 0\n    for number in range(n):\n        if (number % 11 == 0) or (number % 13 == 0):\n            total_count += str(number).count('7')\n    return total_count"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3, same as encoding.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group if it has 3 elements.\n    # The encoding moves group[0] to the end, so decoding moves group[-1] to the front.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    even_values = []\n    # Extract values from even indices.\n    for i in range(0, len(l), 2):\n        even_values.append(l[i])\n\n    # Sort the extracted even values.\n    even_values.sort()\n\n    result = list(l) # Create a mutable copy of the input list.\n    even_values_idx = 0\n    # Reconstruct the list by placing sorted values back into even positions.\n    for i in range(0, len(l), 2):\n        result[i] = even_values[even_values_idx]\n        even_values_idx += 1\n\n    return result"}
{"task_id": "HumanEval/39", "solution": "import math\ndef is_prime(num: int) -> bool:\n    \"\"\"\n    Checks if a number is prime.\n    Numbers less than or equal to 1 are not prime.\n    \"\"\"\n    if num <= 1:\n        return False\n    if num <= 3:\n        return True\n    if num % 2 == 0 or num % 3 == 0:\n        return False\n    i = 5\n    while i * i <= num:\n        if num % i == 0 or num % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef input_validator(n: int) -> bool:\n    \"\"\"\n    Validates the input n, ensuring it's a positive integer.\n    Assumes n is an integer as per type hint.\n    \"\"\"\n    return n >= 1\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    # The input_validator is called as per design, but no exception is raised\n    # for invalid input as per problem constraints.\n    # It is assumed that n will be a positive integer per the problem description and examples.\n    if not input_validator(n):\n        # For an invalid n (e.g., n < 1), this loop would run indefinitely,\n        # adhering to \"DO NOT add isinstance() checks or raise exceptions for edge cases\".\n        pass\n\n    found_primes_count = 0\n    fib_gen = fibonacci_generator()\n\n    while True:\n        fib_num = next(fib_gen)\n        if is_prime(fib_num):\n            found_primes_count += 1\n            if found_primes_count == n:\n                return fib_num"}
{"task_id": "HumanEval/41", "solution": "def car_race_collision(n: int):\n    \"\"\"\n    Imagine a road that's a perfectly straight infinitely long line.\n    n cars are driving left to right;  simultaneously, a different set of n cars\n    are driving right to left.   The two sets of cars start out being very far from\n    each other.  All cars move in the same speed.  Two cars are said to collide\n    when a car that's moving left to right hits a car that's moving right to left.\n    However, the cars are infinitely sturdy and strong; as a result, they continue moving\n    in their trajectory as if they did not collide.\n\n    This function outputs the number of such collisions.\n    \"\"\"\n    return n * n"}
