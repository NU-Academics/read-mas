{"task_id": "HumanEval/20", "solution": "from typing import List, Tuple\n\n\ndef find_closest_elements(numbers: List[float]) -> Tuple[float, float]:\n    \"\"\" From a supplied list of numbers (of length at least two) select and return two that are the closest to each\n    other and return them in order (smaller number, larger number).\n    \"\"\"\n\n    def _validate_input(nums: List[float]) -> None:\n        \"\"\"Validates that the input list has at least two elements.\"\"\"\n        if len(nums) < 2:\n            raise ValueError(\"Input list must contain at least two numbers.\")\n\n    def _generate_pairs(nums: List[float]) -> List[Tuple[float, float]]:\n        \"\"\"Generates all unique pairs of numbers from the input list.\"\"\"\n        pairs = []\n        n = len(nums)\n        for i in range(n):\n            for j in range(i + 1, n):\n                pairs.append((nums[i], nums[j]))\n        return pairs\n\n    def _find_minimum_pair(pairs_list: List[Tuple[float, float]]) -> Tuple[float, float]:\n        \"\"\"Identifies the pair with the minimum absolute difference.\"\"\"\n        min_diff = float('inf')\n        closest_pair = (0.0, 0.0) # Initialize with arbitrary values, will be overwritten\n\n        for num1, num2 in pairs_list:\n            current_diff = abs(num1 - num2)\n            if current_diff < min_diff:\n                min_diff = current_diff\n                closest_pair = (num1, num2)\n        return closest_pair\n\n    def _order_tuple(pair: Tuple[float, float]) -> Tuple[float, float]:\n        \"\"\"Orders the elements within a tuple in ascending order.\"\"\"\n        return (min(pair[0], pair[1]), max(pair[0], pair[1]))\n\n    _validate_input(numbers)\n    all_pairs = _generate_pairs(numbers)\n    un_ordered_closest_pair = _find_minimum_pair(all_pairs)\n    ordered_closest_pair = _order_tuple(un_ordered_closest_pair)\n    return ordered_closest_pair"}
{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    if n < 2:  # Divisors are typically for numbers greater than 1\n        return 1  # For n=1, the largest divisor smaller than n is effectively 1 (though not a proper divisor)\n\n    for i in range(n // 2, 0, -1):\n        if n % i == 0:\n            return i\n    return 1  # Fallback for prime numbers (largest divisor smaller than n is 1)"}
{"task_id": "HumanEval/25", "solution": "```python\nfrom typing import List\n\n\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    factors = []\n    d = 2\n    temp_n = n\n\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 1\n\n    if temp_n > 1:\n        factors.append(temp_n)\n    \n    return factors\n```"}
{"task_id": "HumanEval/29", "solution": "from typing import List\n\n\ndef filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n    >>> filter_by_prefix([], 'a')\n    []\n    >>> filter_by_prefix(['abc', 'bcd', 'cde', 'array'], 'a')\n    ['abc', 'array']\n    \"\"\"\n    return [s for s in strings if s.startswith(prefix)]"}
