e same length as *a* and *b* that contains the\n        bitwise XOR of the two input strings.\n\n    Raises\n    ------\n    ValueError\n        If *a* and *b* are of different lengths or contain characters other\n        than ``'0'`` or ``'1'``.\n\n    Examples\n    --------\n    >>> string_xor('010', '110')\n    '100'\n    >>> string_xor('111', '000')\n    '111'\n    >>> string_xor('101010', '101010')\n    '000000'\n    \"\"\"\n\n    # Ensure the inputs are binary strings of equal length\n    if len(a) != len(b):\n        raise ValueError(\"Input strings must have the same length\")\n\n    valid_bits = {'0', '1'}\n    if not (set(a) <= valid_bits and set(b) <= valid_bits):\n        raise ValueError(\"Input strings must contain only '0' and '1' characters\")\n\n    # Compute XOR for each pair of bits\n    result_bits: List[str] = []\n    for bit_a, bit_b in zip(a, b):\n        result_bits.append('0' if bit_a == bit_b else '1')\n\n    return ''.join(result_bits)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/12": [{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"\n    Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    \n    >>> longest([])\n    None\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    max_len = -1\n    longest_str = None\n    for s in strings:\n        if len(s) > max_len:\n            max_len = len(s)\n            longest_str = s\n\n    return longest_str", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/13": [{"task_id": "HumanEval/13", "solution": "import doctest\nfrom typing import Any\ndef greatest_common_divisor(a: int, b: int