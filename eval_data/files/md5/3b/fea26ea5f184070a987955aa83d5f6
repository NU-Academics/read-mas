rec'] < top_info['prec']):\n                output.append(op_stack.pop())\n            else:\n                break\n        op_stack.append(op)\n        output.append(operand[idx + 1])\n    while op_stack:\n        output.append(op_stack.pop())\n    return output\ndef _evaluate_postfix(tokens):\n    stack = []\n    for token in tokens:\n        if isinstance(token, int):\n            stack.append(token)\n        else:\n            if len(stack) < 2:\n                raise ValueError(\"Malformed expression: insufficient operands for operator\")\n            b = stack.pop()\n            a = stack.pop()\n            if token == '+':\n                stack.append(a + b)\n            elif token == '-':\n                stack.append(a - b)\n            elif token == '*':\n                stack.append(a * b)\n            elif token == '//':\n                if b == 0:\n                    raise ZeroDivisionError(\"Integer division by zero\")\n                stack.append(a // b)\n            elif token == '**':\n                stack.append(a ** b)\n            else:\n                raise ValueError(f\"Unsupported operator '{token}'\")\n    if len(stack) != 1:\n        raise ValueError(\"Malformed expression: stack has more than one value after evaluation\")\n    return stack[0]\ndef do_algebra(operator, operand):\n    \"\"\"\n    Evaluate an algebraic expression defined by two lists.\n\n    Parameters\n    ----------\n    operator : list[str]\n        List of operators in the expression. Allowed values are '+', '-', '*', '//', '**'.\n    operand : list[int]\n        List of non\u2011negative integer operands. Length must be one more than the operator list.\n\n    Returns\n    -------\n    int\n        The integer result of evaluating the expression.\n    \"\"\"\n    _validate_inputs(operator, operand)\n    postfix = _infix_to_postfix(operator, operand)\n    return _evaluate_postfix(postfix)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[["**", "*",