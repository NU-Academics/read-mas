['', ''])\n    'Yes'\n    \"\"\"\n    if len(lst) != 2:\n        raise ValueError(\"Input must be a list of two strings\")\n\n    # Compute total balance and minimum prefix balance for a string\n    def _stats(s: str):\n        bal = 0          # current balance (#( minus #))\n        min_bal = 0     # minimum prefix balance\n        for ch in s:\n            bal += 1 if ch == '(' else -1\n            if bal < min_bal:\n                min_bal = bal\n        return bal, min_bal\n\n    # Check whether concatenating `a` then `b` yields a balanced string\n    def _can_concat(a_bal, a_min, b_bal, b_min):\n        # `a` must never go negative\n        if a_min < 0:\n            return False\n        # While scanning `b`, the running balance is shifted by `a_bal`\n        if a_bal + b_min < 0:\n            return False\n        # Final overall balance must be zero\n        return a_bal + b_bal == 0\n\n    a, b = lst\n    bal_a, min_a = _stats(a)\n    bal_b, min_b = _stats(b)\n\n    if _can_concat(bal_a, min_a, bal_b, min_b) or _can_concat(bal_b, min_b, bal_a, min_a):\n        return 'Yes'\n    return 'No'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/120": [{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Return a sorted list of the k largest integers in `arr`.\n\n    Parameters\n    ----------\n    arr : list[int]\n        List of integers to search.\n    k : int\n        Number of maximum values to return. 0 <= k <= len(arr).\n\n    Returns\n    -------\n    list[int]\n        Sorted list containing the k largest elements from `arr`.\n        If k == 0 the function returns an empty list.\n\n    Examples\n    --------\n    >>> maximum([-3, -4, 5], 3)\n    [-4, -3, 5]\n    >>> maximum([4, -4, 4], 2)\n    [4, 4]\n    >>> maximum([-3, 2, 1, 2, -1, -2, 1], 1)\n    [2]\n    \"\"\"\n    if k <= 0:\n        return []\n\n    # Using a heap to keep only the k largest elements\n    import heapq\n    # The negative values transform the min-heap into a max-heap\n    max_heap = [-x for x in arr[:k]]\n    heapq.heapify(max_heap)\n\n    for num in arr[k:]:\n        if num > -max_heap[0]:\n            heapq.heapreplace(max_heap, -num)\n\n    # Convert back to positive and sort\n    result = sorted([-x for x in max_heap])\n    return result", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[4, -4, 4], 2]], "plus_fail_tests": [[[1, 2, 3, 4, 5], 3]]}], "HumanEval/121": [{"task_id": "HumanEval/121", "solution": "from dataclasses import dataclass\nfrom typing import List\nfrom typing import Iterable\nfrom .value_objects import NumberSequence, SumResult\nfrom abc import ABC, abstractmethod\nfrom typing import List\nfrom typing import Protocol\nfrom abc import abstractmethod\nfrom typing import Protocol\nfrom odd_sum.domain.value_objects import SumResult\nfrom odd_sum.infrastructure.input_provider import InputProvider\nfrom odd_sum.infrastructure.output_handler import OutputHandler\nfrom odd_sum.domain.value_objects import NumberSequence\nfrom odd_sum.domain.odd_sum_service import OddSumService\nimport argparse\nimport sys\nfrom odd_sum.infrastructure.input_provider import ListInputProvider\nfrom odd_sum.infrastructure.output_handler import PrintOutputHandler\nfrom odd_sum.presentation.controller import OddSumController", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/122": [{"task_id": "HumanEval/122", "solution": "from typing import Iterable, List\ndef add_elements(arr: List[int], k: int) -> int:\n    \"\"\"\n    Return the sum of elements that contain at most two digits\n    from the first *k* items of *arr*.\n\n    Parameters\n    ----------\n    arr : List[int]\n        Non\u2011empty list of integers.\n    k : int\n        Number of starting elements to consider. Must satisfy\n        ``1 <= k <= len(arr)``.\n\n    Returns\n    -------\n    int\n        Sum of all *x* in ``arr[:k]``