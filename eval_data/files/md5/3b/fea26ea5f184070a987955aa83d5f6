ot be empty.\n    2. The month must be between 01 and 12.\n    3. The day must be between 01 and the maximum number of days for the\n       given month:\n       - 31 days for months 01,03,05,07,08,10,12\n       - 30 days for months 04,06,09,11\n       - 29 days for month 02\n    4. The year must be a 4\u2011digit number.\n\n    Args:\n        date: Date string to validate.\n\n    Returns:\n        True if the date is valid, False otherwise.\n    \"\"\"\n    if not date or not isinstance(date, str):\n        return False\n\n    # Regex to ensure the date is in mm-dd-yyyy format with 2-digit month and day\n    # and a 4-digit year.\n    pattern = r\"^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])-(\\d{4})$\"\n    match = re.match(pattern, date)\n    if not match:\n        return False\n\n    month_str, day_str, year_str = match.groups()\n    month, day = int(month_str), int(day_str)\n\n    # Day bounds per month\n    months_31 = {1, 3, 5, 7, 8, 10, 12}\n    months_30 = {4, 6, 9, 11}\n\n    if month in months_31 and day > 31:\n        return False\n    if month in months_30 and day > 30:\n        return False\n    if month == 2 and day > 29:\n        return False\n\n    return True", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["06-04-2020\n"]]}], "HumanEval/125": [{"task_id": "HumanEval/125", "solution": "from typing import List, Union\nimport unittest\ndef split_words(txt: str) -> Union[List[str], int]:\n    \"\"\"\n    Splits the input text based on delimiter priority, or counts specific lowercase letters.\n\n    The function behaves as follows:\n\n    1. If any whitespace character exists in *txt* (spaces, tabs, newlines, etc.),\n       the string is split on whitespace using :py:meth:`str.split`.  Consecutive\n       whitespace is treated as a single separator and leading/trailing whitespace\n       is discarded.\n    2. If the string contains no whitespace but contains at least one comma ',',\n       it is split on commas.  The surrounding whitespace (if any) is preserved\n       in the resulting substrings.\n    3. If neither whitespace nor comma is present, the function counts how many\n       lowercase alphabetic characters appear at odd positions in the alphabet.\n       Positions are zero\u2011based: ``a`` \u2192 0, ``b`` \u2192 1, ``c`` \u2192 2, \u2026,\n       ``z`` \u2192 25.  Only letters with an odd index contribute to the count.\n\n    Parameters\n    ----------\n    txt : str\n        The input string to be processed.\n\n    Returns\n    -------\n    Union[List[str], int]\n        A list of split substrings if step 1 or 2 applies, otherwise an integer\n        count according to step 3.\n\n    Examples\n    --------\n    >>> split_words(\"Hello world!\")\n    ['Hello', 'world!']\n    >>> split_words(\"Hello,world!\")\n    ['Hello', 'world!']\n    >>> split_words(\"abcdef\")\n    3\n    >>> split_words(\"\")\n    0\n    >>> split_words(\"A B,C\")\n    ['A', 'B,C']\n    >>> split_words(\"XYZ\")\n    0\n    \"\"\"\n    # Step 1: whitespace split\n    if any(ch.isspace() for ch in txt):\n        return txt.split()\n\n    # Step 2: comma split\n    if ',' in txt:\n        return txt.split(',')\n\n    # Step 3: count lowercase letters at odd alphabet positions\n    counter = 0\n    for ch in txt:\n        if 'a' <= ch <= 'z':\n            if ((ord(ch) - ord('a')) & 1) == 1:  # odd index\n                counter += 1\n    return counter", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/127": [{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"Return \"YES\" if the length of the intersection of two closed intervals\n    is a prime number, otherwise return \"NO\". The intervals are given as\n    tuples (start, end) with start <= end.\"\"\"\n    # Compute intersection bounds\n    start = max(interval1[0], interval2[0])\n    end = min(interval1[1], interval2[1])\n\n    # No intersection