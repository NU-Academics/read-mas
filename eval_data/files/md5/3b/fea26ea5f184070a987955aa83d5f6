rns\n    -------\n    list[int]\n        A two\u2011element list ``[value, index]`` or an empty list.\n\n    Examples\n    --------\n    >>> pluck([4, 2, 3])\n    [2, 1]\n    >>> pluck([1, 2, 3])\n    [2, 1]\n    >>> pluck([])\n    []\n    >>> pluck([5, 0, 3, 0, 4, 2])\n    [0, 1]\n    \"\"\"\n    best_val = None\n    best_index = None\n\n    for idx, val in enumerate(arr):\n        if val % 2 != 0:\n            continue  # Skip odd numbers\n        if best_val is None or val < best_val:\n            best_val = val\n            best_index = idx\n        # If the same minimal even value already found, we keep the first index\n        # because we never update when val == best_val\n\n    return [best_val, best_index] if best_val is not None else []", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/70": [{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst: list[int]) -> list[int]:\n    \"\"\"\n    Returns a list sorted in \"strange\" order: beginning with the\n    smallest element, then the largest remaining element, then the\n    next smallest, and so on.\n\n    The original list is left untouched; a new list is returned.\n\n    Args:\n        lst: A list of integers.\n\n    Returns:\n        A new list of integers sorted in strange order.\n\n    Examples:\n        >>> strange_sort_list([1, 2, 3, 4])\n        [1, 4, 2, 3]\n        >>> strange_sort_list([5, 5, 5, 5])\n        [5, 5, 5, 5]\n        >>> strange_sort_list([])\n        []\n    \"\"\"\n    if not lst:\n        return []\n\n    sorted_list = sorted(lst)\n    result: list[int] = []\n    left, right = 0, len(sorted_list) - 1\n    flag = True  # True -> take from left (min), False -> take from right (max)\n\n    while left <= right:\n        if flag:\n            result.append(sorted_list[left])\n            left += 1\n        else:\n            result.append(sorted_list[right])\n            right -= 1\n        flag = not flag\n\n    return