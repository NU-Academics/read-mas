us_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/137": [{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Return the larger value between *a* and *b* where each can be an integer,\n    float, or string representation of a real number. If both values are\n    numerically equal (within a floating point tolerance) ``None`` is returned.\n\n    Parameters\n    ----------\n    a, b : int | float | str\n        Values to compare. For strings, the decimal separator may be ``.`` or\n        ```,``\n\n    Returns\n    -------\n    int | float | str | None\n        The value that is larger in its original type, or ``None`` if the\n        numerical values are equal.\n    \"\"\"\n    def _to_float(x):\n        \"\"\"Convert *x* to a float for comparison.\n\n        Strings may contain a comma or period as the decimal separator.\n        Integers and floats are accepted as-is. Other types raise\n        ``TypeError``.\n        \"\"\"\n        if isinstance(x, str):\n            cleaned = x.strip().replace(',', '.')\n            try:\n                return float(cleaned)\n            except ValueError as exc:\n                raise ValueError(f\"Cannot interpret string as number: {x}\") from exc\n        if isinstance(x, (int, float)):\n            return float(x)\n        raise TypeError(f\"Unsupported type: {type(x).__name__}\")\n\n    a_val = _to_float(a)\n    b_val = _to_float(b)\n\n    eps = 1e-12\n    if abs(a_val - b_val) <= eps:\n        return None\n\n    return a if a_val > b_val else b", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/138": [{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n: int) -> bool:\n    \"\"\"\n    Determine whether an integer ``n`` can be expressed as the sum of exactly four\n    positive even numbers.\n\n    The smallest possible sum of four positive even numbers is\n    ``2 + 2 + 2 + 2 = 8``.  Therefore, any integer less than 8 cannot satisfy the\n    requirement.  For any even integer ``n >= 8`` you can choose the first three\n    numbers to be ``2``; the fourth number is ``n - 6`` which is positive, even,\n    and at least ``2``.\n\n    Parameters\n    ----------\n    n : int\n        The candidate integer to test.\n\n    Returns\n    -------\n    bool\n        ``True`` if ``n`` can be written as the sum of four positive even\n        integers; ``False`` otherwise.\n\n    Examples\n    --------\n    >>> is_equal_to_sum_even(4)\n    False\n    >>> is_equal_to_sum_even(6)\n    False\n    >>> is_equal_to_sum_even(8)\n    True\n    >>> is_equal_to_sum_even(10)\n    True\n    >>> is_equal_to_sum_even(12)\n    True\n    \"\"\"\n    if not isinstance(n, int):\n        return False\n    return n >= 8 and n % 2 == 0", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/140": [{"task_id": "HumanEval/140", "solution": "def fix_spaces(text: str) -> str:\n    \"\"\"\n    Replace all spaces in *text* with underscores, except when there is a\n    sequence of more than two consecutive spaces. In that case the entire\n    sequence is replaced by a single hyphen.\n\n    Parameters\n    ----------\n    text : str\n        The input string to normalise.\n\n    Returns\n    -------\n    str\n        The string after normalising spaces.\n\n    Examples\n    --------\n    >>> fix_spaces(\"Example\")\n    'Example'\n    >>> fix_spaces(\"Example 1\")\n    'Example_1'\n    >>> fix_spaces(\" Example 2\")\n    '_Example_2'\n    >>> fix_spaces(\" Example   3\")\n    '_Example-3'\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(f\"text must be a str, got {type(text).__name__}\")\n\n    result = []\n    space_count = 0\n\n    for ch in text:\n        if ch == \" \":\n            space_count += 1\n        else:\n            if space_count:\n                if space_count == 1:\n                    result.append(\"_\")\n                elif space_count == 2:\n                    result.append(\"__\")\n                else:\n                    result.append(\"-\")\n                space_count = 0\n            result.append(ch)\n\n    # Handle trailing spaces\n    if space_count:\n        if space_count == 1:\n            result.append(\"_\")\n        elif space_count == 2:\n            result.append(\"__\")\n        else:\n            result.append(\"-\")\n\n    return \"\".join(result)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/141": [{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name: str) -> str:\n    \"\"\"Return 'Yes' if *file_name* satisfies all validation rules, otherwise 'No'.\n\n    Validation rules:\n        1. Total digit count in the entire string must not exceed 3.\n        2. Must contain exactly one '.' character.\n        3. The part before the dot cannot be empty and must start with an ASCII letter.\n        4. The part after the dot must be one of: 'txt', 'exe', 'dll'.\n    \"\"\"\n    # rule 2: exactly one dot\n    if file_name.count('.') != 1:\n        return \"No\"\n\n    base, ext = file_name.split('.', 1)\n\n    # rule 3: non\u2011empty base starting with a letter\n    if not base or not base[0].isalpha() or not base[0].isascii():\n        return \"No\"\n\n    # rule 4: valid extension\n    if ext not in {\"txt\", \"exe\", \"dll\"}:\n        return \"No\"\n\n    # rule 1: at most three digits\n    if sum(ch.isdigit() for ch in file_name) > 3:\n        return \"No\"\n\n    return \"Yes\"", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["\u00e9xample.exe"]]}], "HumanEval/142": [{"task_id": "HumanEval/142", "solution": "import logging\nfrom typing import Sequence\ndef sum_squares(lst: Sequence[int]) -> int:\n    \"\"\"\n    Return the sum of elements after selectively squaring or cubing.\n\n    The elements are processed based on their zero\u2011based indices:\n      * Index divisible by 3: the element is squared.\n      * Index divisible by 4 and not by 3: the element is cubed.\n      * All other indices: the element is left unchanged.\n\n    Parameters\n    ----------\n    lst : Sequence[int]\n        The input sequence of integers.\n\n    Returns\n    -------\n    int\n        The sum of the processed elements.\n\n    Examples\n    --------\n    >>> sum_squares([1, 2, 3])\n    6\n    >>> sum_squares([])\n    0\n    >>> sum_squares([-1, -5, 2, -1, -5])\n    -126\n    \"\"\"\n    total = 0\n    for index, value in enumerate(lst):\n        if index % 3 == 0:\n            processed = value ** 2\n        elif index % 4 == 0:\n            processed = value ** 3\n        else:\n            processed = value\n        total += processed\n    return total", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/143": [{"task_id": "HumanEval/143", "solution": "def _is_prime(n: int) -> bool:\n    \"\"\"Return True if n is a prime number.\"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n_PRIMES_UPTO_100 = {p for p in range(2, 101) if _is_prime(p)}\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Return words from ``sentence`` whose lengths are prime numbers,\n    preserving the original order.\n\n    Parameters\n    ----------\n    sentence : str\n        A space-separated string of words containing only letters.\n\n    Returns\n    -------\n    str\n        Space-separated string of prime-length words. If no such words exist,\n        an empty string is returned.\n    \"\"\"\n    if not sentence:\n        return \"\"\n    return \" \".join(word for word in sentence.split() if len(word) in _PRIMES_UPTO_100)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/144": [{"task_id": "HumanEval/144", "solution": "def simplify(x: str, n: str) -> bool:\n    \"\"\"\n    Return True if the product of the two fractions x and n is an integer.\n    \n    Both x and n are strings of the form \"<numerator>/<denominator>\", with\n    positive whole numbers for numerator and denominator and a non\u2011zero\n    denominator.\n    \"\"\"\n    try:\n        num_x, den_x = map(int, x.split(\"/\"))\n        num_n, den_n = map(int, n.split(\"/\"))\n    except ValueError:\n        raise ValueError(\"Both x and n must be fractions of the form 'numerator/denominator'\")\n\n    product_num = num_x * num_n\n    product_den = den_x * den_n\n\n    return product_num % product_den == 0", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/145": [{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Return list of ints sorted by the sum of their decimal digits (ascending).\n    Ties are broken by original order (stable sort).\n\n    A negative sign does not contribute to the sum of digits.\n\n    Examples\n    --------\n    >>> order_by_points([1, 11, -1, -11, -12])\n    [-1, -11, 1, -12, 11]\n    >>> order_by_points([])\n    []\n    \"\"\"\n    if not isinstance(nums, list):\n        raise TypeError(\"Input must be a list\")\n    # compute tuple (digit_sum, original_index, value)\n    def digit_sum(n: int) -> int:\n        s = 0\n        for ch in str(abs(n)):\n            s += ord(ch) - 48\n        return s\n\n    indexed = [(digit_sum(n), i, n) for i, n in enumerate(nums)]\n    # sorted is stable; key ensures digit_sum ascending, then index ascending\n    sorted_tuples = sorted(indexed, key=lambda t: (t[0], t[1]))\n    return [t[2] for t in sorted_tuples]", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 11, -1, -11, -12]]], "plus_fail_tests": [[[-5, -12, 9, 15]]]}], "HumanEval/146": [{"task_id": "HumanEval/146", "solution": "from typing import List\ndef specialFilter(nums: List[int]) -> int:\n    \"\"\"Return the count of numbers in *nums* that satisfy all of the following:\n\n    1. The number is strictly greater than 10.\n    2. The first digit (most\u2011significant) of the absolute value is odd\n       (1, 3, 5, 7, 9).\n    3. The last digit (least\u2011significant) of the absolute value is odd\n       (1, 3, 5, 7, 9).\n\n    Parameters\n    ----------\n    nums : List[int]\n        The list of integers to evaluate.\n\n    Returns\n    -------\n    int\n        The number of elements that meet the criteria.\n\n    Examples\n    --------\n    >>> specialFilter([15, -73, 14, -15])\n    1\n    >>> specialFilter([33, -2, -3, 45, 21, 109])\n    2\n    \"\"\"\n    odd_digits = {1, 3, 5, 7, 9}\n    count = 0\n    for n in nums:\n        if n <= 10:\n            continue\n        s = str(abs(n))\n        first = int(s[0])\n        last = int(s[-1])\n        if first in odd_digits and last in odd_digits:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/147": [{"task_id": "HumanEval/147", "solution": "def get_max_triples(n: int) -> int:\n    \"\"\"\n    You are given a positive integer n. Build an integer array a of length n\n    where a[i] = i * i - i + 1 (with 1-based indexing).\n    Return the number of triples (a[i], a[j], a[k]) with i < j < k\n    such that a[i] + a[j] + a[k] is a multiple of 3.\n\n    The key insight is that a[i] modulo 3 can only be 0 or 1:\n        - a[i] % 3 == 0 when i % 3 == 2\n        - a[i] % 3 == 1 otherwise\n\n    Therefore, the sum of any triple is divisible by 3 only when all three\n    elements share the same residue modulo 3. Hence, the answer is simply\n    the number of ways to choose 3 indices from the group where a[i] % 3 == 0\n    plus the number of ways to choose 3 indices from the group where a[i] % 3 == 1.\n    \"\"\"\n    # Count indices where i % 3 == 2 (i.e., a[i] % 3 == 0)\n    cnt0 = (n + 1) // 3\n    # Remaining indices have a[i] % 3 == 1\n    cnt1 = n - cnt0\n\n    def comb3(k: int) -> int:\n        return k * (k - 1) * (k - 2) // 6 if k >= 3 else 0\n\n    return comb3(cnt0) + comb3(cnt1)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/148": [{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    planets = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\",\n               \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\n    try:\n        idx1 = planets.index(planet1)\n        idx2 = planets.index(planet2)\n    except ValueError:\n        return tuple()\n    if idx1 == idx2:\n        return tuple()\n    start, end = sorted((idx1, idx2))\n    return tuple(planets[start + 1:end])", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/149": [{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"\n    Return a sorted list of strings after removing words with odd lengths.\n\n    Parameters\n    ----------\n    lst : list[str]\n        A list of strings. Duplicates are preserved.\n\n    Returns\n    -------\n    list[str]\n        A new list containing only the even\u2011length words from *lst*,\n        sorted first by length (ascending) and then alphabetically\n        for words of the same length.\n\n    Examples\n    --------\n    >>> sorted_list_sum([\\\"aa\\\", \\\"a\\\", \\\"aaa\\\"])\n    ['aa']\n\n    >>> sorted_list_sum([\\\"ab\\\", \\\"a\\\", \\\"aaa\\\", \\\"cd\\\"])\n    ['ab', 'cd']\n    \"\"\"\n    # Filter out words with odd length\n    even_words = [word for word in lst if len(word) % 2 == 0]\n    # Sort by length, then alphabetically\n    return sorted(even_words, key=lambda w: (len(w), w))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/150": [{"task_id": "HumanEval/150", "solution": "from typing import Any\ndef _is_prime(n: int) -> bool:\n    \"\"\"Return True if n is a prime number, False otherwise.\"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef x_or_y(n: int, x: Any, y: Any) -> Any:\n    \"\"\"\n    Return `x` if `n` is a prime number, otherwise return `y`.\n\n    Parameters\n    ----------\n    n : int\n        The integer to test for primality.\n    x : Any\n        Value to return if `n` is prime.\n    y : Any\n        Value to return if `n` is not prime.\n\n    Examples\n    --------\n    >>> x_or_y(7, 34, 12)\n    34\n    >>> x_or_y(15, 8, 5)\n    5\n    \"\"\"\n    return x if _is_prime(n) else y", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/151": [{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Return the sum of squares of the odd integers in the provided list,\n    ignoring negative values, non\u2011integers, and zero (zero contributes 0).\n    \n    Parameters\n    ----------\n    lst : list\n        A list that may contain any types of elements.\n    \n    Returns\n    -------\n    int\n        The sum of squares of the qualifying elements.\n    \"\"\"\n    if not lst:\n        return 0\n    total = 0\n    for val in lst:\n        if isinstance(val, int) and val >= 0 and val % 2 == 1:\n            total += val * val\n    return total", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/152": [{"task_id": "HumanEval/152", "solution": "def compare(game, guess):\n    \"\"\"\n    Returns a list indicating how far each guess deviates from the actual score.\n    \n    Parameters\n    ----------\n    game : list[int]\n        List of actual scores.\n    guess : list[int]\n        List of guesses.\n    \n    Returns\n    -------\n    list[int]\n        List where each element is 0 if the guess matches the score,\n        otherwise the absolute difference between the guess and the score.\n    \"\"\"\n    return [abs(g - s) if g != s else 0 for s, g in zip(game, guess)]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/153": [{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Return the strongest extension for the given class name.\n\n    The strength of an extension is defined as the number of uppercase\n    letters minus the number of lowercase letters in the extension string.\n    The function returns a string of the form:\n\n        ClassName.StrongestExtensionName\n\n    If multiple extensions have the same strength, the one that appears\n    first in the list is chosen.\n\n    Parameters\n    ----------\n    class_name : str\n        The name of the class for which extensions are considered.\n    extensions : Iterable[str]\n        A list (or any iterable) of extension names.\n\n    Returns\n    -------\n    str\n        ``f\"{class_name}.{best_extension}\"`` where ``best_extension`` is the\n        strongest extension according to the rule above.\n    \"\"\"\n    max_strength = None\n    best_extension = None\n\n    for ext in extensions:\n        # Count uppercase and lowercase letters only\n        cap = sum(1 for c in ext if c.isupper())\n        sm = sum(1 for c in ext if c.islower())\n        strength = cap - sm\n\n        # Choose the first extension in case of ties\n        if max_strength is None or strength > max_strength:\n            max_strength = strength\n            best_extension = ext\n\n    # In the unlikely case that extensions is empty, just return the class name\n    if best_extension is None:\n        return class_name\n    return f\"{class_name}.{best_extension}\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/154": [{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a: str, b: str) -> bool:\n    \"\"\"Return ``True`` if any rotation of *b* is a substring of *a*.\n\n    Parameters\n    ----------\n    a : str\n        The string to search within.\n    b : str\n        The string whose rotations are considered.\n\n    Returns\n    -------\n    bool\n        ``True`` if a rotation of *b* is found in *a*, otherwise ``False``.\n\n    Notes\n    -----\n    The function treats the strings literally, i.e. case\u2011sensitive and\n    without trimming whitespace.  If *b* is empty the function returns\n    ``False`` because there is no meaningful rotation.\n    \"\"\"\n    # Quick rejection: b longer than a cannot be a substring of a\n    if not a or not b or len(b) > len(a):\n        return False\n    # Generate all rotations of b by looking at b+b\n    double_b = b + b\n    for start in range(len(b)):\n        rotation = double_b[start : start + len(b)]\n        if rotation in a:\n            return True\n    return False", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["", ""]]}], "HumanEval/155": [{"task_id": "HumanEval/155", "solution": "def even_odd_count(num: int) -> tuple[int, int]:\n    \"\"\"Given an integer, return a tuple containing the count of even and odd digits, respectively.\n\n    Parameters\n    ----------\n    num : int\n        The integer to inspect.\n\n    Returns\n    -------\n    tuple[int, int]\n        A tuple where the first element is the number of even digits and the second element is\n        the number of odd digits.\n\n    Examples\n    --------\n    >>> even_odd_count(-12)\n    (1, 1)\n    >>> even_odd_count(123)\n    (1, 2)\n    \"\"\"\n    # Use absolute value to ignore the sign\n    n = abs(num)\n    # Handle 0 explicitly; it has one digit which is even\n    if n == 0:\n        return 1, 0\n\n    even = odd = 0\n    while n > 0:\n        digit = n % 10\n        if digit % 2 == 0:\n            even += 1\n        else:\n            odd += 1\n        n //= 10\n\n    return even, odd", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/156": [{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number: int) -> str:\n    \"\"\"\n    Convert a positive integer (1 <= number <= 1000) to a lowercase Roman numeral.\n\n    Uses the greedy algorithm with the standard Roman numeral symbols.\n\n    Parameters\n    ----------\n    number : int\n        The integer to convert.\n\n    Returns\n    -------\n    str\n        The Roman numeral representation of the number in lowercase.\n\n    Examples\n    --------\n    >>> int_to_mini_roman(19)\n    'xix'\n    >>> int_to_mini_roman(152)\n    'clii'\n    >>> int_to_mini_roman(426)\n    'cdxxvi'\n    \"\"\"\n    if not (1 <= number <= 1000):\n        raise ValueError(\"Number must be within 1 and 1000 inclusive\")\n\n    roman_mappings = [\n        (1000, \"m\"),\n        (900,  \"cm\"),\n        (500,  \"d\"),\n        (400,  \"cd\"),\n        (100,  \"c\"),\n        (90,   \"xc\"),\n        (50,   \"l\"),\n        (40,   \"xl\"),\n        (10,   \"x\"),\n        (9,    \"ix\"),\n        (5,    \"v\"),\n        (4,    \"iv\"),\n        (1,    \"i\"),\n    ]\n\n    result = []\n    remaining = number\n    for value, symbol in roman_mappings:\n        while remaining >= value:\n            result.append(symbol)\n            remaining -= value\n    return \"\".join(result)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/157": [{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a: float, b: float, c: float) -> bool:\n    \"\"\"\n    Return True if the three sides form a right-angled triangle, False otherwise.\n    \n    The function accepts three positive numbers representing the lengths of the sides.\n    It first checks that the numbers satisfy the triangle inequality, then sorts the\n    sides to identify the longest side as the potential hypotenuse. The Pythagorean\n    theorem is verified using ``math.isclose`` to account for floating-point\n    rounding errors.\n    \"\"\"\n    from math import isclose\n\n    # Validate that all sides are positive\n    if a <= 0 or b <= 0 or c <= 0:\n        return False\n\n    # Triangle inequality: sum of any two sides must be greater than the third\n    if a + b <= c or a + c <= b or b + c <= a:\n        return False\n\n    # Sort sides so that the largest side is last\n    sides = sorted([a, b, c])\n    a, b, c = sides\n\n    # Verify Pythagorean theorem with a tolerance\n    return isclose(a * a + b * b, c * c, rel_tol=1e-9, abs_tol=0.0)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/158": [{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Return the word with the maximum number of unique characters.\n    \n    If multiple words share the maximum count, return the one that is\n    first in lexicographical order.  If the input list is empty, an empty\n    string is returned.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    def unique_count(word: str) -> int:\n        return len(set(word))\n\n    # Compute the unique character counts for each word\n    counts = [(unique_count(word), word) for word in words]\n\n    # Find the maximum count\n    max_count = max(count[0] for count in counts)\n\n    # Filter words that have the maximum count\n    candidates = [word for cnt, word in counts if cnt == max_count]\n\n    # Return the lexicographically smallest candidate\n    return min(candidates) if candidates else \"\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/159": [{"task_id": "HumanEval/159", "s