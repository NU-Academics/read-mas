r bound\n        and the larger as the upper bound.\n\n    Returns\n    -------\n    list[int]\n        A list containing the even digits (0, 2, 4, 6, 8) that are within the\n        inclusive interval ``[min(a, b), max(a, b)]``.  The list is sorted in\n        ascending order.  If the interval does not touch any single\u2011digit\n        integer, an empty list is returned.\n\n    Examples\n    --------\n    >>> generate_integers(2, 8)\n    [2, 4, 6, 8]\n    >>> generate_integers(8, 2)\n    [2, 4, 6, 8]\n    >>> generate_integers(10, 14)\n    []\n    \"\"\"\n    # Normalise the bounds.\n    low, high = sorted((a, b))\n\n    # Only single\u2011digit values are relevant for this problem.\n    if high < 0 or low > 9:\n        return []\n\n    # Clamp the interval to the digit range 0-9.\n    start = max(low, 0)\n    end = min(high, 9)\n\n    # Generate even numbers in the clamped interval.\n    return [n for n in range(start, end + 1) if n % 2 == 0]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/90": [{"task_id": "HumanEval/90", "solution": "import heapq\nfrom typing import List, Optional\ndef next_smallest(lst: List[int]) -> Optional[int]:\n    \"\"\"\n    Return the second smallest distinct element in `lst`.\n    If `lst` has fewer than two distinct elements, returns None.\n    \"\"\"\n    unique_values = set(lst)\n    if len(unique_values) < 2:\n        return None\n    # Get the two smallest values from the unique set\n    smallest_two = heapq.nsmallest(2, unique_values)\n    return smallest_two[1]  # second smallest", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/139": [{"task_id": "HumanEval/139", "solution": "import math\nfrom typing import Union\ndef special_factorial(n: int) -> int:\n    \"\"\"\n    Compute the Brazilian factorial of a positive integer n.\n\n    The Brazilian factorial is defined as:\n        brazilian_factorial(n) = n! \u00d7 (n-1)! \u00d7 (n-2)! \u00d7 \u2026 \u00d7 1!\n\n    Parameters:\n        n (int): A positive integer.\n\n    Returns:\n        int: The Brazilian factorial of n.\n\n    Raises:\n        TypeError: If n is not an integer.\n        ValueError: If n is less than 1.\n\n    Examples:\n        >>> special_factorial(4)\n        288\n        >>> special_factorial(1)\n        1\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 1:\n        raise ValueError(\"n must be a positive integer\")\n\n    result = 1\n    current_factorial = 1\n    for i in range(1, n + 1):\n        current_factorial *= i           # i!\n        result *= current_factorial       # Multiply by i!\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/130": [{"task_id": "HumanEval/130", "solution": "from typing import List\ndef tri(n: int) -> List[int]:\n    \"\"\"\n    Compute the first n + 1 values of a custom Tribonacci-like sequence.\n\n    Sequence definition:\n        tri(0) = 1\n        tri(1) = 3\n        tri(2k) = 1 + k  (for k \u2265 1)\n        tri(2k + 1) = tri(2k) + tri(2k - 1) + tri(2k + 2)\n\n    Parameters\n    ----------\n    n : int\n        Non\u2011negative integer representing the highest index to compute\n        (0\u2011based). The returned list contains values for indices 0 \u2026 n.\n\n    Returns\n    -------\n    List[int]\n        List containing the sequence values from tri(0) up to tri(n).\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be a non\u2011negative integer\")\n\n    # The maximum index we need to pre\u2011compute.\n    # For odd n, tri(n) depends on tri(n+1), which is even.\n    max_compute = n if n % 2 == 0 else n + 1\n\n    seq: List[int] = [0] * (max_compute + 1)\n\n    # Base cases\n    seq[0] = 1\n    if max_compute >= 1:\n        seq[1] = 3\n\n    # Pre\u2011compute all even indices\n    for i in range(2, max_compute + 1, 2):\n        seq[i] = 1 + i // 2\n\n    # Compute odd indices using already available even terms\n    for i in range(3, max_compute + 1, 2):\n        seq[i] = seq[i - 1] + seq[i - 2] + seq[i + 1]\n\n    # Return the first n + 1 values\n    return seq[: n + 1]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]}}