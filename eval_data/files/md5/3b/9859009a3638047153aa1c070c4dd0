{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of squares of the first n even natural numbers using a closed-form formula.\n    The formula is 4 * (n * (n + 1) * (2*n + 1) / 6).\n    \"\"\"\n    # The sum of squares of the first n natural numbers is n*(n+1)*(2n+1)/6\n    # The sum of squares of the first n even natural numbers is 4 * (sum of squares of first n natural numbers)\n    # This simplifies to 4 * n * (n + 1) * (2*n + 1) // 6, using integer division.\n    return 4 * n * (n + 1) * (2 * n + 1) // 6"}
{"task_id": "Mbpp/290", "solution": "def max_length(lists):\n    \"\"\"\n    Finds the list with the maximum length in a list of lists.\n    Returns a tuple containing the maximum length and the first list found with that length.\n    \"\"\"\n    if not lists:\n        return (0, [])\n\n    max_len = 0\n    max_list = []\n\n    for sublist in lists:\n        current_len = len(sublist)\n        if current_len > max_len:\n            max_len = current_len\n            max_list = list(sublist) # Copy the list to avoid aliasing issues\n\n    return (max_len, max_list)"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr):\n    \"\"\"Counts inversions in an array using a merge sort based approach.\"\"\"\n\n    def _merge_count(left, right):\n        \"\"\"Merges two sorted lists and counts cross inversions.\"\"\"\n        i = j = 0\n        merged = []\n        inv_count = 0\n        while i < len(left) and j < len(right):\n            if left[i] <= right[j]:\n                merged.append(left[i])\n                i += 1\n            else:\n                merged.append(right[j])\n                j += 1\n                # If an element from right is taken, it implies it is smaller\n                # than all remaining elements in the left array, contributing to inversions.\n                inv_count += len(left) - i\n        merged.extend(left[i:])\n        merged.extend(right[j:])\n        return merged, inv_count\n\n    def _sort_count(sub_arr):\n        \"\"\"Recursively sorts a sub-array and calculates its inversions.\"\"\"\n        if len(sub_arr) <= 1:\n            return sub_arr, 0\n\n        mid = len(sub_arr) // 2\n        left_half, left_inv = _sort_count(sub_arr[:mid])\n        right_half, right_inv = _sort_count(sub_arr[mid:])\n\n        merged_arr, merge_inv = _merge_count(left_half, right_half)\n\n        return merged_arr, left_inv + right_inv + merge_inv\n\n    # Ensure a mutable list is passed to the recursive function, defensive copy.\n    _, total_inversions = _sort_count(list(arr))\n    return total_inversions"}
