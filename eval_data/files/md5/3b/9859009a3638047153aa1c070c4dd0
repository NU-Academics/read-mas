{"task_id": "Mbpp/62", "solution": "import math\nfrom typing import Any, List, Union\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation errors.\n    Raised when input data does not meet expected criteria.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n    def __str__(self) -> str:\n        return self.message\n\nNumber = Union[int, float]\n\nclass Validator:\n    \"\"\"Validates input lists to ensure they contain only numbers.\n    Rejects non-list types, empty lists, non-numeric elements, NaN, and infinity.\"\"\"\n    def validate_numbers(self, numbers: Any) -> List[Number]:\n        if numbers is None:\n            raise ValidationError(\"numbers is required\")\n        if isinstance(numbers, (list, tuple)):\n            nums = list(numbers)\n        else:\n            raise ValidationError(\"numbers must be a list or tuple of numeric values\")\n        if not nums:\n            raise ValidationError(\"numbers list must not be empty\")\n        for i, v in enumerate(nums):\n            if not self._is_number(v):\n                raise ValidationError(f\"element at index {i} is not a valid number: {v!r}\")\n        return nums\n\n    def _is_number(self, value: Any) -> bool:\n        \"\"\"Helper to check if a value is a valid number, excluding booleans, NaN, and infinity.\"\"\"\n        if isinstance(value, bool):\n            return False\n        if not isinstance(value, (int, float)):\n            return False\n        if isinstance(value, float) and (math.isnan(value) or math.isinf(value)):\n            return False\n        return True\n\nclass SmallestFinder:\n    \"\"\"Finds the smallest number in a list of validated numbers.\n    Assumes input `numbers` is a non-empty list of int or float.\"\"\"\n    def find_smallest(self, numbers: List[Number]) -> Number:\n        # Defensive check, but Validator should ensure non-empty list.\n        if not numbers:\n            raise ValidationError(\"numbers list must not be empty\")\n        smallest = numbers[0]\n        for n in numbers[1:]:\n            if n < smallest:\n                smallest = n\n        return smallest\n\n_validator = Validator()\n_finder = SmallestFinder()\n\ndef smallest_num(numbers: List[Number]) -> Number:\n    \"\"\"Finds the smallest number in a list of numbers.\n    It validates the input and then finds the minimum value.\"\"\"\n    validated = _validator.validate_numbers(numbers)\n    return _finder.find_smallest(validated)"}
{"task_id": "Mbpp/63", "solution": "def max_difference(pairs):\n    \"\"\"\n    Calculates the maximum absolute difference between elements within each pair in a list of tuples.\n    Assumes input pairs contain numeric values.\n    \"\"\"\n    max_diff = 0\n    for a, b in pairs:\n        current_diff = abs(a - b)\n        if current_diff > max_diff:\n            max_diff = current_diff\n    return max_diff"}
{"task_id": "Mbpp/58", "solution": "def opposite_Signs(a, b) -> bool:\n    \"\"\"\n    Checks if two integers have opposite signs.\n    Zero is considered neither positive nor negative; comparisons involving zero return False.\n    \"\"\"\n    if a == 0 or b == 0:\n        return False\n    # Use bitwise XOR to determine if the numbers have different signs.\n    # The result of (a ^ b) will be negative if and only if a and b have opposite signs.\n    return (a ^ b) < 0"}
