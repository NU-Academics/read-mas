{"task_id": "Mbpp/453", "solution": "def sumofFactors(n):\n    \"\"\"\n    Finds the sum of even factors of a given positive integer n.\n    Factors are iterated up to the square root of n for efficiency.\n    \"\"\"\n    if n % 2 != 0:\n        return 0\n\n    total_sum = 0\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            # i is a factor\n            if i % 2 == 0:\n                total_sum += i\n            \n            # n/i is a factor\n            if i * i != n:  # Avoid double counting for perfect squares\n                other_factor = n // i\n                if other_factor % 2 == 0:\n                    total_sum += other_factor\n        i += 1\n    return total_sum"}
{"task_id": "Mbpp/451", "solution": "def remove_whitespaces(s: str) -> str:\n    \"\"\"\n    Removes all Unicode whitespace characters from the given string.\n    Uses str.isspace() for comprehensive whitespace detection.\n    \"\"\"\n    return ''.join(ch for ch in s if not ch.isspace())"}
{"task_id": "Mbpp/448", "solution": "class InvalidParameterError(Exception):\n    \"\"\"Custom exception for invalid function parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\ndef validate_non_negative_int(x) -> int:\n    \"\"\"Validates if input is a non-negative integer.\"\"\"\n    try:\n        val = int(x)\n    except (TypeError, ValueError):\n        raise InvalidParameterError(\"Input must be an integer >= 0\")\n    if val < 0:\n        raise InvalidParameterError(\"Input must be >= 0\")\n    return val\n\nclass CacheRepository:\n    \"\"\"Manages in-memory cache for Perrin terms and sums.\"\"\"\n    def __init__(self, enable_file_cache: bool = False, file_path: str = None):\n        self._term_cache = {}\n        self._sum_cache = {}\n        # File caching logic (load/persist) is omitted as per default CACHE_ENABLED = False\n        # and to simplify the inline implementation according to problem constraints.\n\n    def get_term(self, k: int) -> int | None:\n        return self._term_cache.get(k)\n\n    def set_term(self, k: int, value: int) -> None:\n        self._term_cache[k] = value\n\n    def get_sum(self, n: int) -> int | None:\n        return self._sum_cache.get(n)\n\n    def set_sum(self, n: int, value: int) -> None:\n        self._sum_cache[n] = value\n\nclass PerrinGenerator:\n    \"\"\"Generates Perrin sequence terms using iteration and caching.\"\"\"\n    INITIAL_TERMS = (3, 0, 2) # P(0), P(1), P(2)\n\n    def __init__(self, cache=None):\n        self._cache = cache\n\n    def get_term(self, k: int) -> int:\n        # Input k is assumed valid (non-negative integer) as it is validated by PerrinService.\n        \n        if self._cache:\n            cached = self._cache.get_term(k)\n            if cached is not None:\n                return cached\n        \n        if k < 3:\n            value = self.INITIAL_TERMS[k]\n            if self._cache:\n                self._cache.set_term(k, value)\n            return value\n        \n        # Calculate iteratively if not cached, storing intermediate terms in the local list and cache.\n        a, b, c = self.INITIAL_TERMS\n        terms = [a, b, c]\n        for i in range(3, k + 1):\n            val = terms[i - 2] + terms[i - 3]\n            terms.append(val)\n            if self._cache:\n                self._cache.set_term(i, val)\n        return terms[k]\n\nclass PerrinService:\n    \"\"\"Orchestrates Perrin number generation and sums them up to a given 'n'.\"\"\"\n    def __init__(self, generator, cache=None):\n        self.generator = generator\n        self.cache = cache\n\n    def sum_up_to(self, n: int) -> int:\n        n = validate_non_negative_int(n) # Validate input 'n' before computation.\n\n        if self.cache:\n            cached = self.cache.get_sum(n)\n            if cached is not None:\n                return cached\n\n        total = 0\n        for k in range(0, n + 1):\n            total += self.generator.get_term(k) # Accumulate terms from the generator.\n\n        if self.cache:\n            self.cache.set_sum(n, total)\n        return total\n\n# Global instances for default behavior, allowing state (caching) across function calls.\n_default_cache = CacheRepository(enable_file_cache=False)\n_default_generator = PerrinGenerator(cache=_default_cache)\n_default_service = PerrinService(generator=_default_generator, cache=_default_cache)\n\ndef cal_sum(n: int) -> int:\n    \"\"\"Calculates the sum of Perrin numbers from P(0) to P(n).\"\"\"\n    return _default_service.sum_up_to(n)"}
{"task_id": "Mbpp/456", "solution": "def reverse_string_list(string_list):\n    \"\"\"Reverses each string in the given list of string values.\n    Non-string elements are converted to strings before reversal.\n    \"\"\"\n    reversed_list = []\n    for s in string_list:\n        reversed_list.append(str(s)[::-1])\n    return reversed_list"}
