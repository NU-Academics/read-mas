{"task_id": "Mbpp/454", "solution": "import re\nfrom typing import List, Union, Optional, Any, Dict\nfrom pathlib import Path\n\n# --- Exceptions ---\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\n\nclass TextSourceError(Exception):\n    \"\"\"Custom exception for issues resolving text sources.\"\"\"\n    pass\n\n# --- Models ---\nclass MatchResult:\n    \"\"\"Domain model to encapsulate match outcome.\"\"\"\n    def __init__(self, matched: bool, matched_words: List[str], pattern: str):\n        self.matched = matched\n        self.matched_words = matched_words\n        self.pattern = pattern\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Returns a JSON-serializable representation of the result.\"\"\"\n        return {\n            \"matched\": self.matched,\n            \"matched_words\": self.matched_words,\n            \"pattern\": self.pattern\n        }\n\n    def __repr__(self) -> str:\n        \"\"\"Provides a short readable representation.\"\"\"\n        return f\"MatchResult(matched={self.matched}, words={len(self.matched_words)}, pattern='{self.pattern}')\"\n\n# --- Repository ---\nclass TextRepository:\n    \"\"\"Provides text content from different sources.\"\"\"\n    READ_BUFFER_SIZE = 8192 # Buffer size for file reads.\n\n    def resolve(self, source: Union[str, Path], from_file: bool = False) -> str:\n        \"\"\"Resolves the text source to a string.\"\"\"\n        if from_file:\n            path = Path(source) if isinstance(source, str) else source\n            if not isinstance(path, Path):\n                raise TypeError(\"File source must be a string path or Path object.\")\n            return self._read_file(path)\n        if isinstance(source, str):\n            return source\n        raise TypeError(f\"Unsupported source type for text: {type(source)}\")\n\n    def _read_file(self, path: Path) -> str:\n        \"\"\"Reads content from a specified file path.\"\"\"\n        try:\n            with open(path, 'r', encoding='utf-8') as f:\n                return f.read()\n        except IOError as e:\n            raise TextSourceError(f\"Error reading file {path}: {e}\")\n\n# --- Utilities ---\nclass RegexFactory:\n    \"\"\"Constructs compiled regex patterns based on configuration.\"\"\"\n    def __init__(self, template: str = r\"\\b\\w*z\\w*\\b\"):\n        self._template = template\n\n    def build_pattern(self, ignore_case: bool = True) -> re.Pattern[str]:\n        \"\"\"Returns a compiled regex pattern with specified flags.\"\"\"\n        if not isinstance(ignore_case, bool):\n            raise InvalidInputError(\"ignore_case must be a boolean.\")\n        flags = re.IGNORECASE if ignore_case else 0\n        return re.compile(self._template, flags=flags)\n\n    def explain_pattern(self) -> str:\n        \"\"\"Returns a human-friendly explanation of the pattern template.\"\"\"\n        return f\"Matches any word containing 'z' using template: {self._template}\"\n\n# --- Service ---\nclass TextMatchService:\n    \"\"\"Core business logic for finding words containing 'z'.\"\"\"\n    def __init__(self, repo: TextRepository, regex_factory: RegexFactory):\n        self._repo = repo\n        self._regex_factory = regex_factory\n\n    def match_wordz(self, source: Union[str, Path], from_file: bool = False, ignore_case: Optional[bool] = None) -> MatchResult:\n        \"\"\"Finds words containing 'z' in the given text source.\"\"\"\n        text = self._repo.resolve(source, from_file=from_file)\n\n        if ignore_case is None:\n            ignore_case = True # Default to case-insensitive matching.\n        \n        pattern = self._regex_factory.build_pattern(ignore_case=ignore_case)\n        words = self._find_matches(text, pattern)\n        \n        return MatchResult(matched=bool(words), matched_words=words, pattern=pattern.pattern)\n\n    def _find_matches(self, text: str, pattern: re.Pattern[str]) -> List[str]:\n        \"\"\"Finds all unique matches of the pattern in the text, preserving order.\"\"\"\n        matched_words = []\n        seen_words = set()\n        for match in pattern.finditer(text):\n            word = match.group(0) # The pattern handles word boundaries, so group(0) is the word.\n            if word not in seen_words:\n                matched_words.append(word)\n                seen_words.add(word)\n        return matched_words\n\n# --- Controller ---\nclass TextController:\n    \"\"\"Orchestrates calls from higher-level clients and validates inputs.\"\"\"\n    def __init__(self, service: TextMatchService):\n        self._service = service\n\n    def handle_match_text(self, text: str, ignore_case: Optional[bool] = None) -> MatchResult:\n        \"\"\"Handles matching 'z' words for a direct text input string.\"\"\"\n        if not isinstance(text, str):\n            raise TypeError(\"Input 'text' must be a string.\")\n        return self._service.match_wordz(source=text, from_file=False, ignore_case=ignore_case)\n\n    def handle_match_file(self, path: Union[str, Path], ignore_case: Optional[bool] = None) -> MatchResult:\n        \"\"\"Handles matching 'z' words from a file path.\"\"\"\n        return self._service.match_wordz(source=path, from_file=True, ignore_case=ignore_case)\n\n# --- Module-level singletons (as per design context) ---\n_repo = TextRepository()\n_regex_factory = RegexFactory()\n_service = TextMatchService(_repo, _regex_factory)\n_controller = TextController(_service)\n\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"\n    Checks if the given text contains a word with 'z'.\n    The match is case-insensitive by default.\n    \"\"\"\n    result = _controller.handle_match_text(text)\n    return result.matched"}
