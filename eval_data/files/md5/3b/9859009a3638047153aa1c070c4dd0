{"task_id": "Mbpp/20", "solution": "def is_woodall(n: int) -> bool:\n    \"\"\"Checks if a given number is a Woodall number (k * 2^k - 1).\"\"\"\n\n    def _compute_woodall(k: int) -> int:\n        \"\"\"Computes k * 2^k - 1 efficiently using bit shifts.\"\"\"\n        return (k << k) - 1\n\n    def _suggested_max_k(num: int) -> int:\n        \"\"\"Determines a conservative upper bound for k in the search.\"\"\"\n        # Woodall numbers grow quickly; (num + 1).bit_length() approximates k + log2(k).\n        # A margin is added, and the search is capped to prevent excessive iteration.\n        return min((num + 1).bit_length() + 5, 2000)\n\n    def _find_k_for_woodall(num: int) -> int | None:\n        \"\"\"Finds k such that num == k * 2^k - 1, or None if it's not one.\"\"\"\n        if num < 1:\n            # Woodall numbers are defined for k >= 1, so W_k >= 1*2^1-1 = 1.\n            return None\n\n        max_k_search = _suggested_max_k(num)\n\n        for k_val in range(1, max_k_search + 1):\n            woodall_val = _compute_woodall(k_val)\n            if woodall_val == num:\n                return k_val\n            if woodall_val > num:\n                # Since Woodall numbers are strictly increasing, we won't find num for larger k_val.\n                return None\n        return None\n\n    return _find_k_for_woodall(n) is not None"}
{"task_id": "Mbpp/57", "solution": "def find_Max_Num(digits):\n    \"\"\"\n    Finds the largest number that can be formed with the given list of digits.\n    Sorts digits in descending order and concatenates them to form an integer.\n    \"\"\"\n    # Convert digits to strings for sorting and concatenation\n    digit_strings = [str(d) for d in digits]\n\n    # Sort the digit strings in reverse (descending) order\n    digit_strings.sort(reverse=True)\n\n    # Join the sorted digit strings to form the largest number string\n    largest_num_str = \"\".join(digit_strings)\n\n    # Convert the string back to an integer\n    return int(largest_num_str)"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts substrings where the sum of digits equals their length.\n    \"\"\"\n    from collections import defaultdict\n\n    digits = [int(ch) for ch in s]\n    \n    # freq stores the frequency of (prefix_sum - index) values.\n    # A value of (prefix_sum - index) at current_index means the sum of digits\n    # from some previous index 'j' to current index 'i-1' equals the length (i-j).\n    freq = defaultdict(int)\n    \n    # The base case: before processing any digits, prefix_sum is 0, index is 0.\n    # This accounts for valid substrings starting from index 0.\n    freq[0] = 1 \n    \n    prefix_sum = 0\n    count = 0\n    \n    # Enumerate with 1-based index 'i' to correctly represent the length of prefixes\n    for i, digit in enumerate(digits, start=1):\n        prefix_sum += digit\n        delta = prefix_sum - i\n        \n        # If this delta has been seen before, it means we found a substring\n        # whose sum of digits equals its length.\n        count += freq[delta]\n        \n        # Increment the frequency for the current delta\n        freq[delta] += 1\n        \n    return count"}
