{"task_id": "Mbpp/412", "solution": "class MemoryRepository:\n    def __init__(self) -> None:\n        self._store: list[tuple[list[int], list[int]]] = []\n\n    def save_run(self, input_numbers: list[int], output_numbers: list[int]) -> None:\n        self._store.append((list(input_numbers), list(output_numbers)))\n\nclass ListInput:\n    def __init__(self, numbers: list[int]) -> None:\n        self.numbers = numbers\n\n    def validate(self, ignore_non_int: bool = False) -> list[int]:\n        if not hasattr(self.numbers, '__iter__'):\n            raise TypeError(\"Input 'numbers' must be an iterable.\")\n        \n        validated_numbers = []\n        for item in self.numbers:\n            if isinstance(item, int):\n                validated_numbers.append(item)\n            elif ignore_non_int:\n                pass\n            else:\n                raise ValueError(f\"Non-integer value '{item}' found in list. Set ignore_non_int=True to skip.\")\n        return validated_numbers\n\nclass FilterService:\n    def __init__(self, repo: MemoryRepository | None = None) -> None:\n        self._repo = repo\n\n    def filter_even(self, numbers: list[int], ignore_non_int: bool = False) -> list[int]:\n        validated = ListInput(numbers).validate(ignore_non_int=ignore_non_int)\n        result = [n for n in validated if (n % 2) == 0]\n        if self._repo:\n            self._repo.save_run(validated, result)\n        return result\n\nclass APIController:\n    def __init__(self, service: FilterService) -> None:\n        self.service = service\n\n    def remove_odd(self, numbers: list[int], ignore_non_int: bool = False) -> list[int]:\n        return self.service.filter_even(numbers, ignore_non_int=ignore_non_int)\n\n_default_service = FilterService()\n_default_controller = APIController(_default_service)\n\ndef remove_odd(numbers: list[int], ignore_non_int: bool = False) -> list[int]:\n    \"\"\"\n    Removes odd numbers from a list of integers, returning a new list of even numbers.\n    Preserves the order of even numbers from the original list.\n    \"\"\"\n    return _default_controller.remove_odd(numbers, ignore_non_int=ignore_non_int)"}
{"task_id": "Mbpp/404", "solution": "def minimum(a: float, b: float) -> float:\n    \"\"\"Finds the minimum of two numbers.\n    Compares a and b and returns the smaller value.\"\"\"\n    return a if a <= b else b"}
{"task_id": "Mbpp/409", "solution": "def min_product_tuple(pairs: list) -> int:\n    \"\"\"Calculates the minimum product from pairs of integers in a list of tuples.\n    Assumes valid, non-empty input as per design constraints.\"\"\"\n    products = (pair[0] * pair[1] for pair in pairs)\n    return min(products)"}
{"task_id": "Mbpp/413", "solution": "def extract_nth_element(list_of_tuples, n):\n    \"\"\"\n    Extracts the nth element from each tuple in a list of tuples.\n    The function extracts elements based on standard Python indexing, supporting negative indices.\n    \"\"\"\n    result = []\n    for item_tuple in list_of_tuples:\n        result.append(item_tuple[n])\n    return result"}
{"task_id": "Mbpp/410", "solution": "from typing import Iterable, List, Any, Union, Optional\nfrom dataclasses import dataclass\nfrom decimal import Decimal\n\nclass MinFinderError(Exception):\n    \"\"\"Base exception for MinFinder library.\"\"\"\n    pass\n\nclass NoNumericError(MinFinderError):\n    \"\"\"Raised when no numeric items are found in the input.\"\"\"\n    pass\n\nclass InvalidInputError(MinFinderError):\n    \"\"\"Raised when the input is not a valid iterable.\"\"\"\n    pass\n\n@dataclass\nclass NumericValue:\n    \"\"\"Represents a normalized numeric item with its original context.\"\"\"\n    index: int\n    value: Union[int, float]\n    original: Any\n\n    def as_number(self) -> Union[int, float]:\n        \"\"\"Returns the numeric value of the item.\"\"\"\n        return self.value\n\nMAX_PARSE_LENGTH = 256\n\ndef _parse_numeric_inline(obj: Any) -> Optional[Union[int, float]]:\n    \"\"\"Parses an object to a numeric type (int or float) if possible.\"\"\"\n    if isinstance(obj, int):\n        return obj\n    if isinstance(obj, float):\n        return obj\n    if isinstance(obj, Decimal):\n        return float(obj)\n\n    if isinstance(obj, str) and len(obj) <= MAX_PARSE_LENGTH:\n        s = obj.strip()\n        try:\n            return int(s)\n        except ValueError:\n            try:\n                return float(s)\n            except ValueError:\n                return None\n    return None\n\ndef _collect_numeric_inline(items: Iterable[Any]) -> List[NumericValue]:\n    \"\"\"Collects all numeric values and numeric strings into NumericValue objects.\"\"\"\n    numeric_items = []\n    for i, item in enumerate(items):\n        parsed_value = _parse_numeric_inline(item)\n        if parsed_value is not None:\n            numeric_items.append(NumericValue(index=i, value=parsed_value, original=item))\n    return numeric_items\n\ndef _reduce_min_inline(numeric_items: List[NumericValue]) -> Union[int, float]:\n    \"\"\"Finds the minimum value among collected numeric items, preserving int type if possible.\"\"\"\n    min_val_obj = min(numeric_items, key=lambda nv: nv.value)\n    \n    has_float = any(isinstance(nv.value, float) for nv in numeric_items)\n    \n    if has_float:\n        return float(min_val_obj.value)\n    else:\n        return int(min_val_obj.value)\n\ndef min_val(items: Iterable[Any]) -> Union[int, float]:\n    \"\"\"Finds the minimum numeric value in a heterogeneous list.\"\"\"\n    if not hasattr(items, \"__iter__\"):\n        raise InvalidInputError(\"Input must be an iterable.\")\n\n    numeric_items = _collect_numeric_inline(items)\n\n    if not numeric_items:\n        raise NoNumericError(\"No numeric items found.\")\n\n    return _reduce_min_inline(numeric_items)"}
{"task_id": "Mbpp/406", "solution": "from typing import Any, Optional, Dict\nfrom datetime import datetime\nimport os\nimport sqlite3\nfrom dataclasses import dataclass\n\nclass ParityError(Exception):\n    \"\"\"Domain-specific exception for parity-related errors.\"\"\"\n    def __init__(self, message: str, cause: Optional[Exception] = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.cause = cause\n\nclass Validator:\n    \"\"\"Input validation and safe parsing utilities.\"\"\"\n    @staticmethod\n    def parse_int(value: Any) -> int:\n        if isinstance(value, int):\n            return value\n        if isinstance(value, float):\n            if value.is_integer():\n                return int(value)\n            raise ParityError(f\"Float value {value} is not integral\")\n        if isinstance(value, str):\n            try:\n                return int(value.strip())\n            except ValueError as e:\n                raise ParityError(f\"String value '{value}' is not an integer\", cause=e)\n        raise ParityError(f\"Unsupported type for parity check: {type(value)}\")\n\nDEFAULT_AUDIT_ENABLED = False\nDEFAULT_DB_PATH = \"./parity_checks.db\"\n\n@dataclass\nclass Config:\n    \"\"\"Runtime configuration for the parity application.\"\"\"\n    audit_enabled: bool\n    audit_db_path: str\n\n    @staticmethod\n    def from_env() -> \"Config\":\n        \"\"\"Builds a Config instance from environment variables or defaults.\"\"\"\n        audit_enabled = os.getenv(\"PARITY_AUDIT_ENABLED\", str(DEFAULT_AUDIT_ENABLED)).lower() in (\"1\",\"true\",\"yes\")\n        db_path = os.getenv(\"PARITY_DB_PATH\", DEFAULT_DB_PATH)\n        return Config(audit_enabled=audit_enabled, audit_db_path=db_path)\n\n@dataclass\nclass NumberDTO:\n    \"\"\"Data transfer object for an audit record of a parity check.\"\"\"\n    number: int\n    is_odd: bool\n    checked_at: datetime\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Converts the DTO to a dictionary.\"\"\"\n        return {\"number\": self.number, \"is_odd\": int(self.is_odd), \"checked_at\": self.checked_at.isoformat()}\n\nCREATE_TABLE_SQL = \"\"\"\nCREATE TABLE IF NOT EXISTS parity_checks (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  number INTEGER NOT NULL,\n  is_odd INTEGER NOT NULL,\n  checked_at TEXT NOT NULL\n);\n\"\"\"\nINSERT_SQL = \"INSERT INTO parity_checks (number, is_odd, checked_at) VALUES (?, ?, ?);\"\n\nclass ParityRepository:\n    \"\"\"Provides persistence for parity checks to an SQLite database.\"\"\"\n    def __init__(self, db_path: str) -> None:\n        self._db_path = db_path\n        self._conn = sqlite3.connect(self._db_path, check_same_thread=False)\n        self.ensure_schema()\n\n    def ensure_schema(self) -> None:\n        \"\"\"Ensures the required database schema exists.\"\"\"\n        try:\n            self._conn.execute(CREATE_TABLE_SQL)\n            self._conn.commit()\n        except sqlite3.Error as e:\n            raise ParityError(\"Failed to ensure schema\", cause=e)\n\n    def insert_check(self, dto: NumberDTO) -> None:\n        \"\"\"Inserts a parity check record into the database.\"\"\"\n        try:\n            self._conn.execute(INSERT_SQL, (dto.number, int(dto.is_odd), dto.checked_at.isoformat()))\n            self._conn.commit()\n        except sqlite3.Error as e:\n            raise ParityError(\"Failed to insert parity check\", cause=e)\n\n    def close(self) -> None:\n        \"\"\"Closes the database connection.\"\"\"\n        try:\n            self._conn.close()\n        except Exception:\n            pass\n\nclass ParityService:\n    \"\"\"Orchestrates parity computation and optional persistence.\"\"\"\n    def __init__(self, config: Config, repository: Optional[ParityRepository] = None) -> None:\n        self._config = config\n        self._repository = repository\n\n    def check(self, number: int) -> bool:\n        \"\"\"Computes if the given number is odd and optionally logs the check.\"\"\"\n        is_odd = (number % 2) != 0\n        if self._config.audit_enabled and self._repository:\n            try:\n                dto = NumberDTO(number=number, is_odd=is_odd, checked_at=datetime.utcnow())\n                self._repository.insert_check(dto)\n            except ParityError:\n                # Swallowing persistence errors to keep functional behavior reliable.\n                pass\n        return is_odd\n\ndef _make_default_service() -> ParityService:\n    \"\"\"Factory function to create a default ParityService instance.\"\"\"\n    config = Config.from_env()\n    repo = ParityRepository(config.audit_db_path) if config.audit_enabled else None\n    return ParityService(config=config, repository=repo)\n\ndef find_Parity(number: Any) -> bool:\n    \"\"\"\n    Return True if the parity of a given number is odd, False otherwise.\n    Raises ParityError on invalid input types.\n    \"\"\"\n    parsed = Validator.parse_int(number)\n    service = _make_default_service()\n    return service.check(parsed)"}
{"task_id": "Mbpp/414", "solution": "from typing import Iterable, Any, Set\n\ndef overlapping(seq_a: Iterable[Any], seq_b: Iterable[Any]) -> bool:\n    \"\"\"\n    Checks if any value in sequence 'seq_a' exists in sequence 'seq_b'.\n    Attempts to use sets for efficiency, falling back to nested loops for unhashable items.\n    \"\"\"\n    list_a = list(seq_a)\n    list_b = list(seq_b)\n\n    if not list_a or not list_b:\n        return False\n\n    # Determine which list to attempt converting to a set first (the smaller one).\n    # This minimizes memory usage for the set and potentially speeds up lookup.\n    if len(list_a) <= len(list_b):\n        candidate_for_set = list_a\n        other_list = list_b\n    else:\n        candidate_for_set = list_b\n        other_list = list_a\n\n    try:\n        # Attempt the most efficient method: convert candidate list to a set.\n        candidate_set: Set[Any] = set(candidate_for_set)\n        return any(item in candidate_set for item in other_list)\n    except TypeError:\n        # The `candidate_for_set` list contains unhashable elements.\n        # Now, try to create a set from the `other_list`.\n        try:\n            other_set: Set[Any] = set(other_list)\n            # Check the items from the original `candidate_for_set` against the `other_set`.\n            return any(item in other_set for item in candidate_for_set)\n        except TypeError:\n            # Both lists contain unhashable elements. Fallback to O(N*M) nested loop comparison.\n            for item_a in list_a:\n                for item_b in list_b:\n                    if item_a == item_b:\n                        return True\n            return False"}
{"task_id": "Mbpp/415", "solution": "def max_Product(arr):\n    # Tracks the two largest and two smallest numbers in the array.\n    max1 = float('-inf')\n    max2 = float('-inf')\n    min1 = float('inf')\n    min2 = float('inf')\n\n    for x in arr:\n        if x > max1:\n            max2, max1 = max1, x\n        elif x > max2:\n            max2 = x\n\n        if x < min1:\n            min2, min1 = min1, x\n        elif x < min2:\n            min2 = x\n    \n    # Compare the product of the two largest vs. the product of the two smallest (most negative) numbers.\n    if max1 * max2 >= min1 * min2:\n        return (min(max1, max2), max(max1, max2))\n    else:\n        return (min(min1, min2), max(min1, min2))"}
{"task_id": "Mbpp/420", "solution": "from typing import Iterator\n\nclass CubeSumError(Exception):\n    \"\"\"Custom exception for cube sum related errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass MathUtils:\n    \"\"\"Utility class for mathematical computations.\"\"\"\n    SAFE_MAX_N = 10_000_000\n\n    @staticmethod\n    def closed_form_cube_sum_even(n: int) -> int:\n        \"\"\"Computes the sum of cubes of the first n even natural numbers using a closed-form formula.\"\"\"\n        return 2 * (n**2) * ((n+1)**2)\n\nclass EvenNumberGenerator:\n    \"\"\"Generates even numbers and computes their cube sum iteratively.\"\"\"\n    @staticmethod\n    def generate(n: int) -> Iterator[int]:\n        \"\"\"Yields the first n even natural numbers.\"\"\"\n        for k in range(1, n + 1):\n            yield 2 * k\n\n    @staticmethod\n    def cube_sum(n: int) -> int:\n        \"\"\"Computes the sum of cubes for the first n even natural numbers iteratively.\"\"\"\n        return sum(x**3 for x in EvenNumberGenerator.generate(n))\n\nclass CubeSumService:\n    \"\"\"Service layer for cube sum computation logic.\"\"\"\n    def compute(self, n: int, method: str = \"auto\") -> int:\n        \"\"\"Dispatches to the chosen computation method.\"\"\"\n        if method == \"auto\" or method == \"formula\":\n            return self.compute_via_formula(n)\n        if method == \"generator\":\n            return self.compute_via_generator(n)\n        # As per instructions, explicit error raising for unknown method (an \"edge case\" for 'method') is omitted.\n        # This implies that the 'method' parameter is expected to be valid.\n        return self.compute_via_formula(n) # Fallback to default behavior if unknown method\n\n    def compute_via_formula(self, n: int) -> int:\n        \"\"\"Computes the cube sum using the optimized formula.\"\"\"\n        return MathUtils.closed_form_cube_sum_even(n)\n\n    def compute_via_generator(self, n: int) -> int:\n        \"\"\"Computes the cube sum using an iterative generator.\"\"\"\n        return EvenNumberGenerator.cube_sum(n)\n\nclass CubeSumController:\n    \"\"\"Controller layer for input validation and public API exposure.\"\"\"\n    DEFAULT_METHOD = \"auto\"\n    MAX_N = 10_000_000\n\n    @classmethod\n    def validate_input(cls, n: int) -> None:\n        \"\"\"Per instructions, validation checks and error raising for 'n' are omitted.\"\"\"\n        pass\n\n    @classmethod\n    def cube_sum(cls, n: int, method: str = DEFAULT_METHOD) -> int:\n        \"\"\"Public entrypoint to calculate the cube sum.\"\"\"\n        cls.validate_input(n)\n        service = CubeSumService()\n        return service.compute(n, method=method)\n\ndef cube_Sum(n: int) -> int:\n    \"\"\"\n    Finds the cube sum of the first n even natural numbers.\n    \"\"\"\n    return CubeSumController.cube_sum(n)"}
{"task_id": "Mbpp/418", "solution": "def Find_Max(input_list):\n    \"\"\"\n    Finds the element in a list that has the maximum length.\n    If multiple elements have the same maximum length, the first one encountered is returned.\n    \"\"\"\n    if not input_list:\n        return None # Or raise an error, but the prompt says no exceptions for edge cases\n\n    max_element = None\n    max_length = -1\n\n    for element in input_list:\n        current_length = len(element)\n        if current_length > max_length:\n            max_length = current_length\n            max_element = element\n            \n    return max_element"}
{"task_id": "Mbpp/419", "solution": "def round_and_sum(numbers: list) -> int:\n    \"\"\"\n    Rounds each number in the list, sums the rounded integers, and multiplies\n    the sum by the length of the original list.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    rounded_sum = sum(int(round(num)) for num in numbers)\n    return rounded_sum * len(numbers)"}
{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n: int) -> float:\n    \"\"\"\n    Finds the average of cubes of the first n natural numbers.\n    Assumes n is a positive integer (n >= 1).\n    \"\"\"\n    sum_of_cubes = (n * (n + 1) // 2) ** 2\n    average = sum_of_cubes / n\n    return average"}
