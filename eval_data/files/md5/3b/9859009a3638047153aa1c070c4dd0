{"task_id": "Mbpp/93", "solution": "import math\n\nclass PowerError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass InputValidator:\n    @staticmethod\n    def validate_base(a: object) -> float:\n        try:\n            val = float(a)\n        except Exception:\n            raise PowerError(f\"Invalid base: {a!r}\")\n        if math.isinf(val) or math.isnan(val):\n            raise PowerError(\"Base must be finite\")\n        return val\n\n    @staticmethod\n    def validate_exponent(b: object) -> int:\n        if isinstance(b, int):\n            return b\n        try:\n            as_float = float(b)\n        except Exception:\n            raise PowerError(f\"Invalid exponent: {b!r}\")\n        if not as_float.is_integer():\n            raise PowerError(\"Exponent must be an integer\")\n        return int(as_float)\n\n    @staticmethod\n    def validate_inputs(a: object, b: object) -> tuple[float, int]:\n        return InputValidator.validate_base(a), InputValidator.validate_exponent(b)\n\nclass PowerCalculator:\n    def __init__(self, base: float, exponent: int) -> None:\n        self.base = base\n        self.exponent = exponent\n\n    def power(self) -> float:\n        if self.exponent == 0:\n            return 1.0\n        if self.base == 0.0 and self.exponent < 0:\n            raise PowerError(\"0 cannot be raised to a negative exponent\")\n        if self.exponent < 0:\n            return 1.0 / self._positive_power(self.base, -self.exponent)\n        return self._positive_power(self.base, self.exponent)\n\n    def _positive_power(self, base: float, exponent: int) -> float:\n        result = 1.0\n        b = base\n        e = exponent\n        while e > 0:\n            if e & 1:\n                result *= b\n            b *= b\n            e >>= 1\n        return result\n\ndef power(a: float, b: int) -> float:\n    base, exponent = InputValidator.validate_inputs(a, b)\n    calc = PowerCalculator(base, exponent)\n    return calc.power()"}
{"task_id": "Mbpp/91", "solution": "from typing import List, Protocol\n\ndef find_substring(values: list[str], query: str, case_sensitive: bool = True) -> bool:\n    \"\"\"\n    Checks if a string is present as a substring in a given list of string values.\n    \"\"\"\n\n    class SubstringQuery:\n        \"\"\"Data transfer object for substring queries.\"\"\"\n        def __init__(self, values: List[str], query: str, case_sensitive: bool = True) -> None:\n            self.values = values\n            self.query = query\n            self.case_sensitive = case_sensitive\n\n    class Repository(Protocol):\n        \"\"\"Interface for data repositories providing lists of strings.\"\"\"\n        def get_values(self) -> List[str]:\n            ...\n\n    class ListRepository:\n        \"\"\"A repository implementation for in-memory lists of strings.\"\"\"\n        def __init__(self, values: List[str]) -> None:\n            self._values = list(values)\n        def get_values(self) -> List[str]:\n            return list(self._values)\n\n    class StringUtils:\n        \"\"\"Utility methods for string operations.\"\"\"\n        @staticmethod\n        def normalize_string(s: str) -> str:\n            \"\"\"Returns the string as is for direct use, or for future normalization.\"\"\"\n            return s\n\n        @staticmethod\n        def contains(subj: str, query: str, case_sensitive: bool = True) -> bool:\n            \"\"\"Checks if query is a substring of subj, respecting case sensitivity.\"\"\"\n            if not case_sensitive:\n                subj = subj.lower()\n                query = query.lower()\n            return query in subj\n\n    class SubstringService:\n        \"\"\"Core business logic for finding substrings in a list.\"\"\"\n        def __init__(self, repo: Repository, utils: type = StringUtils) -> None:\n            self._repo = repo\n            self._utils = utils\n\n        def find(self, query: str, case_sensitive: bool = True) -> bool:\n            \"\"\"Searches for the query string within the repository's values.\"\"\"\n            values = self._repo.get_values()\n            for item in values:\n                if self._utils.contains(item, query, case_sensitive):\n                    return True\n            return False\n\n    class SubstringController:\n        \"\"\"API layer to handle substring check requests.\"\"\"\n        def __init__(self, service: SubstringService) -> None:\n            self._service = service\n\n        def check(self, request: SubstringQuery) -> bool:\n            \"\"\"Performs the substring check using a SubstringQuery object.\"\"\"\n            return self._service.find(request.query, request.case_sensitive)\n\n    repo = ListRepository(values)\n    service = SubstringService(repo)\n    controller = SubstringController(service)\n    request = SubstringQuery(values, query, case_sensitive)\n    return controller.check(request)"}
{"task_id": "Mbpp/92", "solution": "def is_undulating(number):\n    \"\"\"\n    Checks if a given number is undulating.\n    An undulating number alternates between exactly two different digits and has a length of at least two.\n    \"\"\"\n    s = str(number).strip()\n\n    if s.startswith('+'):\n        s = s[1:]\n\n    # Ensure the string consists only of digits. This handles negative numbers, floats, and non-numeric strings.\n    if not s.isdigit():\n        return False\n\n    if len(s) < 2:\n        return False\n\n    first_digit = s[0]\n    second_digit = s[1]\n\n    # The two alternating digits must be different\n    if first_digit == second_digit:\n        return False\n\n    # Check for the alternating pattern\n    for i, char_digit in enumerate(s):\n        expected_digit = first_digit if i % 2 == 0 else second_digit\n        if char_digit != expected_digit:\n            return False\n            \n    # Explicitly ensure only these two distinct digits appear, as per design.\n    # While the loop above mostly covers this, this provides an explicit check.\n    if len(set(s)) != 2 or not (first_digit in set(s) and second_digit in set(s)):\n        return False\n\n    return True"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(items):\n    \"\"\"\n    Given a list of tuples, returns the first value of the tuple with the smallest second value.\n    The comparison is stable, returning the first encountered tuple in case of a tie.\n    \"\"\"\n    min_val_tuple = items[0]\n\n    for current_tuple in items[1:]:\n        if current_tuple[1] < min_val_tuple[1]:\n            min_val_tuple = current_tuple\n\n    return min_val_tuple[0]"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(numbers):\n    \"\"\"\n    Multiplies all numbers in a list and divides the product by the list's length.\n    Assumes `numbers` is a non-empty sequence of numeric values (int or float).\n    \"\"\"\n    product = 1.0\n    for num in numbers:\n        product *= float(num)\n    \n    list_length = len(numbers)\n    return product / list_length"}
{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer n.\n    The function finds the prime factorization of n and then applies the formula for the number of divisors.\n    \"\"\"\n    if n == 1:\n        return 1\n\n    factors = {}\n    temp_n = n\n\n    # Handle factor 2\n    while temp_n % 2 == 0:\n        factors[2] = factors.get(2, 0) + 1\n        temp_n //= 2\n\n    # Handle odd factors starting from 3\n    d = 3\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors[d] = factors.get(d, 0) + 1\n            temp_n //= d\n        d += 2\n\n    # If temp_n is still greater than 1, it must be a prime factor itself\n    if temp_n > 1:\n        factors[temp_n] = factors.get(temp_n, 0) + 1\n\n    # Calculate the number of divisors using the exponents from prime factorization.\n    # For n = p1^a1 * p2^a2 * ... * pk^ak, the number of divisors is (a1+1)*(a2+1)*...*(ak+1).\n    num_divisors = 1\n    for exponent in factors.values():\n        num_divisors *= (exponent + 1)\n\n    return num_divisors"}
{"task_id": "Mbpp/97", "solution": "from typing import Iterable, Iterator, Any, List, Dict\nfrom collections import Counter\n\nclass FrequencyError(Exception):\n    \"\"\"Custom exception for frequency calculation errors.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\n\nclass FlattenUtil:\n    \"\"\"Utility to flatten a single level of nested iterables.\"\"\"\n    def flatten(self, nested: Iterable[Iterable[Any]]) -> Iterator[Any]:\n        for inner in nested:\n            for item in inner:\n                yield item\n\nclass ListRepository:\n    \"\"\"Validates and normalizes input lists for frequency calculation.\"\"\"\n    def validate_and_normalize(self, lists: Iterable[Iterable[Any]]) -> List[List[Any]]:\n        try:\n            outer = list(lists)\n        except TypeError:\n            raise FrequencyError(\"Input must be an iterable of iterables.\")\n        normalized = []\n        for i, inner in enumerate(outer):\n            try:\n                normalized.append(list(inner))\n            except TypeError:\n                raise FrequencyError(f\"Element at index {i} is not iterable.\")\n        return normalized\n\nclass FrequencyService:\n    \"\"\"Core service for computing element frequencies in nested lists.\"\"\"\n    def __init__(self, repository: ListRepository, flattener: FlattenUtil):\n        self._repo = repository\n        self._flattener = flattener\n\n    def frequency_lists(self, lists: Iterable[Iterable[Any]]) -> Dict[Any,int]:\n        \"\"\"Calculates the frequency of each element in a flattened list of lists.\"\"\"\n        normalized = self._repo.validate_and_normalize(lists)\n        items = self._flattener.flatten(normalized)\n        return self._count(items)\n\n    def _count(self, items: Iterable[Any]) -> Dict[Any,int]:\n        \"\"\"Counts the occurrences of each item in an iterable.\"\"\"\n        counter = Counter()\n        for item in items:\n            try:\n                counter[item] += 1\n            except TypeError as e:\n                raise TypeError(\"Unhashable element encountered: {}\".format(item)) from e\n        return dict(counter)\n\ndef frequency_lists(lists):\n    \"\"\"\n    Finds the frequency of each element in a flattened list of lists, returned in a dictionary.\n    \"\"\"\n    svc = FrequencyService(ListRepository(), FlattenUtil())\n    return svc.frequency_lists(lists)"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(lists):\n    \"\"\"\n    Finds the length of the smallest list in a list of lists.\n    Assumes the input 'lists' is a non-empty list of lists.\n    \"\"\"\n    min_len = len(lists[0])\n\n    for sublist in lists[1:]:\n        current_len = len(sublist)\n        if current_len < min_len:\n            min_len = current_len\n            if min_len == 0:\n                break\n    return min_len"}
