{"task_id": "Mbpp/268", "solution": "def find_star_num(n):\n    \"\"\"\n    Calculates the n'th star number using the formula S(n) = 6*n*(n-1) + 1.\n    Assumes n is an integer greater than or equal to 1.\n    \"\"\"\n    return 6 * n * (n - 1) + 1"}
{"task_id": "Mbpp/271", "solution": "def even_Power_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the first n even natural numbers, each raised to the fifth power,\n    using a closed-form formula for the sum of fifth powers.\n    \"\"\"\n    if n == 0:\n        return 0\n    \n    # Calculate sum_k_5 = sum_{k=1..n} k^5 using the closed-form formula:\n    # (n^2 * (n+1)^2 * (2n^2 + 2n - 1)) // 12\n    n_squared = n * n\n    n_plus_1 = n + 1\n    n_plus_1_squared = n_plus_1 * n_plus_1\n    \n    term_3 = (2 * n_squared) + (2 * n) - 1\n    \n    sum_k_5 = (n_squared * n_plus_1_squared * term_3) // 12\n    \n    # The sum of the first n even natural numbers raised to the fifth power is:\n    # sum_{k=1..n} (2k)^5 = sum_{k=1..n} (2^5 * k^5) = 2^5 * sum_{k=1..n} k^5\n    EVEN_MULTIPLIER = 32 # 2**5\n    \n    return EVEN_MULTIPLIER * sum_k_5"}
{"task_id": "Mbpp/272", "solution": "def rear_extract(items):\n    \"\"\"\n    Extracts the rear element from each tuple in a list of tuples.\n    This function assumes `items` is a list of non-empty tuples.\n    \"\"\"\n    return [t[-1] for t in items]"}
{"task_id": "Mbpp/273", "solution": "def substract_elements(a: tuple[int, ...], b: tuple[int, ...]) -> tuple[int, ...]:\n    \"\"\"\n    Subtracts elements of the first tuple by elements of the second tuple at the same index.\n    It expects inputs to be tuples with subtractable integer elements.\n    \"\"\"\n    return tuple(x - y for x, y in zip(a, b))"}
{"task_id": "Mbpp/274", "solution": "def even_binomial_Coeff_Sum(n: int) -> int:\n    \"\"\"Calculates the sum of even-indexed binomial coefficients for a positive integer n.\n\n    Utilizes the mathematical identity that the sum of even-indexed binomial coefficients C(n,k) for k=0,2,4,... is 2^(n-1) for n >= 1.\n    \"\"\"\n    return 2**(n - 1)"}
{"task_id": "Mbpp/277", "solution": "def dict_filter(data: dict, n: int) -> dict:\n    \"\"\"\n    Filters a dictionary to include only entries where the value is greater than or equal to n.\n    Returns a new dictionary preserving the original insertion order.\n    \"\"\"\n    return {key: value for key, value in data.items() if value >= n}"}
{"task_id": "Mbpp/276", "solution": "import math\nfrom typing import Any\n\nclass ValidationError(ValueError):\n    \"\"\"Exception raised for invalid input values.\n    It carries a message and an error code.\n    \"\"\"\n    def __init__(self, message: str, error_code: int = 400) -> None:\n        super().__init__(message)\n        self.message = message\n        self.error_code = error_code\n\nclass Cylinder:\n    \"\"\"Represents a cylinder's dimensions (radius and height).\n    Instances are treated as immutable value objects.\n    \"\"\"\n    def __init__(self, radius: float, height: float) -> None:\n        self.radius = float(radius)\n        self.height = float(height)\n\n    def volume(self) -> float:\n        \"\"\"Calculates the volume of this cylinder.\n        This is a convenience method using math.pi.\n        \"\"\"\n        return math.pi * (self.radius ** 2) * self.height\n\nclass InputValidator:\n    \"\"\"Validates numeric input values for cylinder computations.\n    It checks for type, finiteness, and non-negativity.\n    \"\"\"\n    def validate(self, radius: float, height: float) -> None:\n        \"\"\"Verifies radius and height are valid.\n        Raises ValidationError for invalid inputs.\n        \"\"\"\n        if not self._is_number(radius) or not self._is_number(height):\n            raise ValidationError(\"Radius and height must be numbers.\", error_code=400)\n        if radius < 0 or height < 0:\n            raise ValidationError(\"Radius and height must be non-negative.\", error_code=400)\n        if math.isinf(radius) or math.isinf(height) or math.isnan(radius) or math.isnan(height):\n            raise ValidationError(\"Radius and height must be finite numbers.\", error_code=400)\n\n    def _is_number(self, value: Any) -> bool:\n        \"\"\"Helper to check if a value is a non-boolean int or float.\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\nclass VolumeCalculator:\n    \"\"\"Encapsulates the cylinder volume computation logic.\n    Allows injection of a custom PI value for flexibility.\n    \"\"\"\n    def __init__(self, pi: float = None) -> None:\n        self._pi = math.pi if pi is None else float(pi)\n\n    def calculate(self, cylinder: Cylinder) -> float:\n        \"\"\"Computes the volume of the given cylinder object.\"\"\"\n        return self._pi * (cylinder.radius ** 2) * cylinder.height\n\ndef volume_cylinder(radius: float, height: float) -> float:\n    \"\"\"Calculates the volume of a cylinder given its radius and height.\n    Inputs are validated before computation.\n    \"\"\"\n    validator = InputValidator()\n    validator.validate(radius, height)\n    \n    cyl = Cylinder(radius, height)\n    \n    calc = VolumeCalculator()\n    return calc.calculate(cyl)"}
{"task_id": "Mbpp/279", "solution": "def is_num_decagonal(n: int) -> int:\n    \"\"\"\n    Calculates the nth decagonal number using the formula D(n) = 4*n^2 - 3*n.\n    \"\"\"\n    return 4 * n * n - 3 * n"}
{"task_id": "Mbpp/280", "solution": "def sequential_search(array: list, element: object) -> tuple[bool, int]:\n    \"\"\"\n    Searches for an element in an array using sequential search.\n    Returns a tuple indicating if the element was found and its index, or -1 if not found.\n    \"\"\"\n    for i, item in enumerate(array):\n        if item == element:\n            return (True, i)\n    return (False, -1)"}
{"task_id": "Mbpp/281", "solution": "def all_unique(items):\n    \"\"\"\n    Checks if all elements in the given list are unique.\n    It uses a hash-based approach for performance, falling back to equality comparison for unhashable items.\n    \"\"\"\n    try:\n        seen = set()\n        for item in items:\n            if item in seen:\n                return False\n            seen.add(item)\n        return True\n    except TypeError:\n        # Fallback to O(n^2) equality comparison for unhashable items\n        n = len(items)\n        for i in range(n):\n            for j in range(i + 1, n):\n                if items[i] == items[j]:\n                    return False\n        return True"}
