{"task_id": "Mbpp/75", "solution": "from typing import Sequence, Tuple, List\n\ndef find_tuples(data: Sequence[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n    \"\"\"\n    Finds tuples from a list where all elements are divisible by k.\n    Empty tuples are excluded from the results.\n    \"\"\"\n    result = []\n    for t in data:\n        if len(t) > 0 and all(x % k == 0 for x in t):\n            result.append(t)\n    return result"}
{"task_id": "Mbpp/77", "solution": "def is_Diff(number: int) -> bool:\n    \"\"\"Checks if an integer is divisible by 11 using the alternating-sum rule.\"\"\"\n    n_abs = abs(number)\n    digits = [int(ch) for ch in str(n_abs)]\n\n    # Calculate the alternating sum of digits, starting with a positive for the first digit.\n    # If the absolute difference of the sums of alternating digits is divisible by 11,\n    # then the number is divisible by 11.\n    alternating_sum = 0\n    for idx, digit in enumerate(digits):\n        if idx % 2 == 0:  # Add digits at even indices (0, 2, 4...)\n            alternating_sum += digit\n        else:  # Subtract digits at odd indices (1, 3, 5...)\n            alternating_sum -= digit\n\n    return abs(alternating_sum) % 11 == 0"}
{"task_id": "Mbpp/80", "solution": "def tetrahedral_number(n: int) -> int:\n    \"\"\"Calculates the nth tetrahedral number using the binomial coefficient formula.\"\"\"\n\n    def safe_binomial(n_val: int, k_val: int) -> int:\n        \"\"\"Computes n choose k using a multiplicative formula to ensure integer results.\"\"\"\n        if k_val < 0 or k_val > n_val:\n            return 0\n        k_val = min(k_val, n_val - k_val)\n        result = 1\n        for i in range(1, k_val + 1):\n            result = result * (n_val - (k_val - i)) // i\n        return result\n\n    # The nth tetrahedral number is given by the binomial coefficient (n + 2 choose 3).\n    return safe_binomial(n + 2, 3)"}
{"task_id": "Mbpp/82", "solution": "import math\n\nclass InvalidRadiusError(ValueError):\n    \"\"\"Custom exception for invalid radius values.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass RadiusValidator:\n    \"\"\"Validates radius input against business rules.\"\"\"\n    def validate(self, radius: float) -> None:\n        if not isinstance(radius, (int, float)) or math.isnan(radius):\n            raise InvalidRadiusError(\"Radius must be a number\")\n        if radius < 0:\n            raise InvalidRadiusError(\"Radius must be >= 0\")\n\nclass MathAdapter:\n    \"\"\"Provides math primitives for calculation, allowing DI.\"\"\"\n    def __init__(self, pi: float = math.pi) -> None:\n        self._pi = float(pi)\n\n    def pi(self) -> float:\n        return self._pi\n\n    def pow(self, base: float, exp: float) -> float:\n        return base ** exp\n\n    def cubic(self, value: float) -> float:\n        return self.pow(value, 3)\n\nclass VolumeService:\n    \"\"\"Computes sphere volume using injected math adapter and validator.\"\"\"\n    def __init__(self, math_adapter: MathAdapter, validator: RadiusValidator) -> None:\n        self._math = math_adapter\n        self._validator = validator\n\n    def compute_volume(self, radius: float) -> float:\n        self._validator.validate(radius)\n        r3 = self._math.cubic(radius)\n        return (4.0 / 3.0) * self._math.pi() * r3\n\ndef volume_sphere(radius: float) -> float:\n    \"\"\"\n    Calculates the volume of a sphere given its radius.\n    This function validates the radius and uses a mathematical adapter for computation.\n    \"\"\"\n    service = VolumeService(MathAdapter(), RadiusValidator())\n    return service.compute_volume(radius)"}
{"task_id": "Mbpp/85", "solution": "import math\n\nclass NegativeRadiusError(Exception):\n    \"\"\"Raised when the radius is negative.\"\"\"\n    def __init__(self, radius: float):\n        super().__init__(f\"Radius must be non-negative; got {radius}\")\n\nclass InvalidTypeError(Exception):\n    \"\"\"Raised when the input value cannot be converted to a float.\"\"\"\n    def __init__(self, value: any):\n        super().__init__(f\"Invalid radius type: '{value}' (type: {type(value).__name__})\")\n\ndef surfacearea_sphere(radius: float) -> float:\n    \"\"\"\n    Calculates the surface area of a sphere given its radius.\n    Validates input for type and non-negativity.\n    \"\"\"\n    try:\n        r = float(radius)\n    except (TypeError, ValueError):\n        raise InvalidTypeError(radius)\n\n    if r < 0:\n        raise NegativeRadiusError(r)\n\n    return 4 * math.pi * (r ** 2)"}
{"task_id": "Mbpp/86", "solution": "def centered_hexagonal_number(n: int) -> int:\n    \"\"\"Calculates the nth centered hexagonal number using the formula Hc(n) = 3n(n-1) + 1.\n    This function assumes n is a positive integer and performs no input validation.\"\"\"\n    return 3 * n * (n - 1) + 1"}
{"task_id": "Mbpp/84", "solution": "_newman_conway_cache = {1: 1, 2: 1}\n\ndef sequence(n: int) -> int:\n    \"\"\"\n    Computes the nth number in the Newman-Conway sequence using memoization.\n    Values are cached to optimize repeated calculations.\n    \"\"\"\n    if n in _newman_conway_cache:\n        return _newman_conway_cache[n]\n\n    current_max_n = max(_newman_conway_cache.keys())\n    for i in range(current_max_n + 1, n + 1):\n        # Newman-Conway recurrence: a(i) = a(a(i-1)) + a(i-a(i-1))\n        # All required preceding terms are guaranteed to be in the cache.\n        val_at_i_minus_1 = _newman_conway_cache[i - 1]\n        \n        term1_index = val_at_i_minus_1\n        term2_index = i - val_at_i_minus_1\n        \n        _newman_conway_cache[i] = _newman_conway_cache[term1_index] + _newman_conway_cache[term2_index]\n        \n    return _newman_conway_cache[n]"}
{"task_id": "Mbpp/90", "solution": "from typing import List, Iterable, Any\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input types.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass Validator:\n    \"\"\"Validates that inputs are correct types for processing.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def validate_iterable_of_strings(self, it: Iterable[Any]) -> None:\n        if not isinstance(it, Iterable):\n            raise InvalidInputError(\"Input must be an iterable.\")\n        for i, item in enumerate(it):\n            if not self.is_string(item):\n                raise InvalidInputError(f\"Item at index {i} is not a string: {type(item)}\")\n\n    def is_string(self, value: Any) -> bool:\n        return isinstance(value, str)\n\nclass LongestWordService:\n    \"\"\"Core algorithm to compute longest word length.\"\"\"\n    def __init__(self, validator: Validator) -> None:\n        self._validator = validator\n\n    def find_longest_length(self, words: Iterable[str]) -> int:\n        self._validator.validate_iterable_of_strings(words)\n        max_len = 0\n        for w in words:\n            norm = self._normalize_word(w)\n            if len(norm) > max_len:\n                max_len = len(norm)\n        return max_len\n\n    def _normalize_word(self, word: str) -> str:\n        return word.strip()\n\ndef len_log(words: List[str]) -> int:\n    \"\"\"Calculates the length of the longest word in a list of strings.\"\"\"\n    service = LongestWordService(Validator())\n    return service.find_longest_length(words)"}
