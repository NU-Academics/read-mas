{"task_id": "Mbpp/118", "solution": "def string_to_list(text: str, separator: str = ' ', compress: bool = False):\n    \"\"\"\n    Converts a string to a list of strings by splitting on a specified separator.\n    Optionally compresses consecutive separators.\n    \"\"\"\n    import re\n\n    if compress:\n        # Normalize all sequences of whitespace into a single space.\n        processed_text = re.sub(r'\\s+', ' ', text)\n\n        # If the separator is not a single space, also compress runs of that specific separator.\n        if separator != ' ':\n            while separator * 2 in processed_text:\n                processed_text = processed_text.replace(separator * 2, separator)\n        \n        # Split the processed text by the (potentially compressed) separator.\n        return processed_text.split(separator)\n    else:\n        # Split by the exact separator, preserving empty tokens for consecutive separators.\n        return text.split(separator)"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(pairs):\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples.\n    Returns an int if the result is integral, otherwise a float.\n    \"\"\"\n\n    class InvalidInputError(ValueError):\n        pass\n\n    class EmptyInputError(ValueError):\n        pass\n\n    class TuplePair:\n        \"\"\"Internal model for a two-element numeric pair.\"\"\"\n        def __init__(self, value1: float, value2: float) -> None:\n            self.value1: float = value1\n            self.value2: float = value2\n\n    def is_number(x: object) -> bool:\n        \"\"\"Checks if an object is an int or float, but not bool.\"\"\"\n        return isinstance(x, (int, float)) and not isinstance(x, bool)\n\n    def validate_and_create_tuple_pair(item: object) -> TuplePair:\n        \"\"\"Validates a raw item and converts it to a TuplePair instance.\"\"\"\n        if not (isinstance(item, (list, tuple)) and len(item) == 2):\n            raise InvalidInputError(\"Each item must be a 2-element tuple or list.\")\n        a, b = item\n        if not is_number(a) or not is_number(b):\n            raise InvalidInputError(\"Pair elements must be numeric.\")\n        return TuplePair(float(a), float(b))\n\n    def compute_cross_pair_max(a: TuplePair, b: TuplePair) -> float:\n        \"\"\"Computes the maximum absolute product between two TuplePair instances.\"\"\"\n        products = [\n            abs(a.value1 * b.value1),\n            abs(a.value1 * b.value2),\n            abs(a.value2 * b.value1),\n            abs(a.value2 * b.value2),\n        ]\n        return max(products)\n\n    processed_pairs = []\n    for item in pairs:\n        processed_pairs.append(validate_and_create_tuple_pair(item))\n\n    n = len(processed_pairs)\n    if n < 2:\n        raise EmptyInputError(\"At least two tuple pairs are required.\")\n\n    global_max = 0.0\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            val = compute_cross_pair_max(processed_pairs[i], processed_pairs[j])\n            if val > global_max:\n                global_max = val\n\n    if global_max.is_integer():\n        return int(global_max)\n    return global_max"}
{"task_id": "Mbpp/119", "solution": "def search(nums: list[int]) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array\n    where all other elements appear exactly twice.\n    \"\"\"\n    low, high = 0, len(nums) - 1\n    while low < high:\n        mid = (low + high) // 2\n        # Ensure mid is an even index to compare with mid+1 as a pair.\n        if mid % 2 == 1:\n            mid -= 1\n        \n        if nums[mid] == nums[mid + 1]:\n            # If nums[mid] and nums[mid+1] form a pair,\n            # the unique element must be in the right half (after this pair).\n            low = mid + 2\n        else:\n            # If nums[mid] and nums[mid+1] are not a pair,\n            # nums[mid] is either the unique element or it's to its left.\n            high = mid\n            \n    return nums[low]"}
{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(limit: int) -> int:\n    \"\"\"\n    Sums all amicable numbers up to the specified limit.\n    An amicable pair (a, b) consists of two distinct positive integers such that the sum of the proper divisors of a (excluding a itself) is equal to b and the sum of the proper divisors of b is equal to a.\n    \"\"\"\n    if not isinstance(limit, int) or limit < 2:\n        raise ValueError(\"limit must be an integer >= 2\")\n\n    _cache = {} # Cache for sum_proper_divisors results within this function call\n\n    def _sum_proper_divisors_cached(n: int) -> int:\n        \"\"\"\n        Computes the sum of proper divisors for a given number, using a cache.\n        Proper divisors include 1 but exclude the number itself.\n        \"\"\"\n        if n in _cache:\n            return _cache[n]\n\n        # For n=1, sum of proper divisors is 0\n        if n == 1:\n            _cache[n] = 0\n            return 0\n        \n        # Calculate sum of proper divisors for n > 1\n        divs_sum = 1 # 1 is always a proper divisor for n > 1\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                divs_sum += i\n                if i * i != n: # Add the complementary divisor if it's not the same as i\n                    divs_sum += (n // i)\n            i += 1\n        \n        _cache[n] = divs_sum\n        return divs_sum\n\n    total_amicable_sum = 0\n    # Use a set to store individual amicable numbers found to prevent double counting within pairs\n    found_amicable_numbers_set = set()\n\n    # Iterate through numbers from 2 up to the limit (inclusive)\n    for a in range(2, limit + 1):\n        # If 'a' has already been identified and summed as part of a pair, skip it\n        if a in found_amicable_numbers_set:\n            continue\n\n        sum_div_a = _sum_proper_divisors_cached(a)\n\n        # Skip if sum_div_a is not a candidate for an amicable pair:\n        # 1. It must be positive.\n        # 2. It must not be equal to a (perfect number check).\n        if sum_div_a <= 1 or sum_div_a == a:\n            continue\n        \n        b = sum_div_a # 'b' is the potential amicable partner\n        \n        sum_div_b = _sum_proper_divisors_cached(b)\n\n        # Check if 'b' is indeed amicable with 'a' (i.e., sum of b's proper divisors is a)\n        if sum_div_b == a:\n            # We found an amicable pair (a, b) where a != b\n            # Now, add them to the total sum if they are within the specified limit\n            if a <= limit:\n                if a not in found_amicable_numbers_set:\n                    total_amicable_sum += a\n                    found_amicable_numbers_set.add(a)\n            if b <= limit: # Check b also, it might be outside `limit` even if `a` is inside\n                if b not in found_amicable_numbers_set:\n                    total_amicable_sum += b\n                    found_amicable_numbers_set.add(b)\n            \n    return total_amicable_sum"}
{"task_id": "Mbpp/126", "solution": "import math\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\n\n    def __str__(self) -> str:\n        return f\"InvalidInputError: {self.message}\"\n\nclass NumberPair:\n    \"\"\"Holds two integers and provides validation for them.\"\"\"\n    def __init__(self, a: int, b: int):\n        self.a = a\n        self.b = b\n        self.validate()\n\n    def validate(self) -> None:\n        \"\"\"Raises InvalidInputError if inputs are not integers.\"\"\"\n        if not isinstance(self.a, int) or not isinstance(self.b, int):\n            raise InvalidInputError(\"Inputs must be integers.\")\n\ndef gcd(a: int, b: int) -> int:\n    \"\"\"Compute the greatest common divisor of two integers using the Euclidean algorithm.\"\"\"\n    a, b = abs(a), abs(b)\n    while b:\n        a, b = b, a % b\n    return a\n\ndef divisors(n: int) -> list[int]:\n    \"\"\"Return a sorted list of positive divisors of the absolute value of n.\"\"\"\n    if n == 0:\n        return []\n    n_abs = abs(n)\n    divs = set()\n    for i in range(1, int(math.sqrt(n_abs)) + 1):\n        if n_abs % i == 0:\n            divs.add(i)\n            divs.add(n_abs // i)\n    return sorted(list(divs))\n\nclass SumCalculator:\n    \"\"\"Calculates the sum of common divisors of two numbers.\"\"\"\n    def compute_sum_common_divisors(self, a: int, b: int) -> int:\n        \"\"\"Computes the sum of common positive divisors for two integers.\"\"\"\n        pair = NumberPair(a, b) \n\n        common_divisor = gcd(pair.a, pair.b)\n\n        if common_divisor == 0:\n            return 0\n\n        return self._sum_divisors_of_gcd(common_divisor)\n\n    def _sum_divisors_of_gcd(self, g: int) -> int:\n        \"\"\"Helper to get and sum divisors of a given GCD.\"\"\"\n        return sum(divisors(g))\n\ndef sum(a: int, b: int) -> int:\n    \"\"\"Finds the sum of common divisors of two given numbers.\"\"\"\n    calculator = SumCalculator()\n    return calculator.compute_sum_common_divisors(a, b)"}
