{"task_id": "Mbpp/237", "solution": "def check_occurences(list_of_tuples):\n    \"\"\"\n    Counts the occurrences of unordered 2-element tuples in a list,\n    treating (a, b) and (b, a) as the same logical pair.\n    \"\"\"\n    counts = {}\n    for item_tuple in list_of_tuples:\n        # Canonicalize the tuple by sorting its elements to treat (a,b) and (b,a) as identical.\n        canonical_tuple = tuple(sorted(item_tuple))\n        counts[canonical_tuple] = counts.get(canonical_tuple, 0) + 1\n    return counts"}
{"task_id": "Mbpp/234", "solution": "import os\nimport json\nimport threading\nfrom typing import Any, Optional, Dict\n\nclass InvalidSideLengthError(Exception):\n    \"\"\"Custom exception for invalid side length inputs.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass RepositoryError(Exception):\n    \"\"\"Custom exception for repository (cache) I/O issues.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass Config:\n    \"\"\"Centralized configuration for the geometry cube package.\"\"\"\n    CACHE_FILE_PATH: str = \"~/.geometry_cube_cache.json\"\n    PRECISION: Optional[int] = None # No rounding by default\n\nclass ValidationUtils:\n    \"\"\"Provides static utility methods for input validation.\"\"\"\n    @staticmethod\n    def is_valid_side(side: Any) -> bool:\n        \"\"\"Checks if a side length is a valid non-negative number.\"\"\"\n        try:\n            val = float(side)\n        except (TypeError, ValueError):\n            return False\n        return val >= 0\n\n    @staticmethod\n    def to_float(side: Any) -> float:\n        \"\"\"Converts input to float, raising InvalidSideLengthError if invalid.\"\"\"\n        try:\n            val = float(side)\n        except (TypeError, ValueError):\n            raise InvalidSideLengthError(\"Side length must be a number.\")\n        if val < 0:\n            raise InvalidSideLengthError(\"Side length must be non-negative.\")\n        return val\n\nclass Cube:\n    \"\"\"Represents a cube domain object with a given side length.\"\"\"\n    def __init__(self, side_length: float) -> None:\n        # Validation is typically handled by ValidationUtils before Cube instantiation.\n        self.side_length: float = float(side_length)\n\n    def volume(self) -> float:\n        \"\"\"Calculates and returns the volume of the cube.\"\"\"\n        return self.side_length ** 3\n\nclass VolumeCacheRepository:\n    \"\"\"Persists and retrieves cached volumes to/from a JSON file.\"\"\"\n    def __init__(self, file_path: str) -> None:\n        self._file_path = os.path.expanduser(file_path)\n        self._lock = threading.Lock()\n        os.makedirs(os.path.dirname(self._file_path), exist_ok=True)\n\n    def _read(self) -> Dict[str, float]:\n        \"\"\"Reads the cache data from the JSON file.\"\"\"\n        if not os.path.exists(self._file_path):\n            return {}\n        try:\n            with open(self._file_path, \"r\", encoding=\"utf-8\") as f:\n                if os.path.getsize(self._file_path) == 0: # Handle empty file\n                    return {}\n                return {k: float(v) for k, v in json.load(f).items()}\n        except json.JSONDecodeError as e:\n            raise RepositoryError(f\"Cache file is malformed: {e}\")\n        except Exception as e:\n            raise RepositoryError(f\"Failed to read cache: {e}\")\n\n    def _write(self, data: Dict[str, float]) -> None:\n        \"\"\"Writes the cache data to the JSON file.\"\"\"\n        try:\n            with open(self._file_path, \"w\", encoding=\"utf-8\") as f:\n                json.dump(data, f, indent=4)\n        except Exception as e:\n            raise RepositoryError(f\"Failed to write cache: {e}\")\n\n    def get(self, side: float) -> Optional[float]:\n        \"\"\"Retrieves a cached volume for a given side length.\"\"\"\n        with self._lock:\n            data = self._read()\n            return data.get(str(side))\n\n    def set(self, side: float, volume: float) -> None:\n        \"\"\"Stores a computed volume for a given side length in the cache.\"\"\"\n        with self._lock:\n            data = self._read()\n            data[str(side)] = volume\n            self._write(data)\n\n    def all(self) -> Dict[str, float]:\n        \"\"\"Returns all cached entries as a dictionary.\"\"\"\n        with self._lock:\n            return self._read()\n\nclass GeometryService:\n    \"\"\"Implements core business logic for geometry calculations, including caching.\"\"\"\n    def __init__(self, repo: VolumeCacheRepository, precision: Optional[int] = None) -> None:\n        self._repo = repo\n        self._precision = precision\n\n    def calculate_volume(self, side: float) -> float:\n        \"\"\"Calculates the volume of a cube, utilizing cache and applying precision.\"\"\"\n        side_f = ValidationUtils.to_float(side)\n\n        cached = self._repo.get(side_f)\n        if cached is not None:\n            return self._apply_precision(cached)\n\n        cube = Cube(side_f)\n        volume = cube.volume()\n\n        try:\n            self._repo.set(side_f, volume)\n        except Exception as e:\n            raise RepositoryError(f\"Error caching volume for side {side_f}: {e}\")\n\n        return self._apply_precision(volume)\n\n    def _apply_precision(self, value: float) -> float:\n        \"\"\"Applies configured rounding precision to a float value.\"\"\"\n        if self._precision is None:\n            return value\n        return round(value, self._precision)\n\nclass CubeController:\n    \"\"\"Serves as a facade, exposing high-level operations for cube calculations.\"\"\"\n    def __init__(self, service: GeometryService) -> None:\n        self._service = service\n\n    def compute_volume(self, side: float) -> float:\n        \"\"\"Computes the volume of a cube by delegating to the geometry service.\"\"\"\n        return self._service.calculate_volume(side)\n\ndef volume_cube(side: float) -> float:\n    \"\"\"\n    Calculates the volume of a cube given its side length.\n    Uses a layered architecture with caching and validation.\n    \"\"\"\n    repo = VolumeCacheRepository(Config.CACHE_FILE_PATH)\n    service = GeometryService(repo, precision=Config.PRECISION)\n    controller = CubeController(service)\n    return controller.compute_volume(side)"}
{"task_id": "Mbpp/235", "solution": "def even_bit_set_number(n: int) -> int:\n    \"\"\"Sets all even bit positions of a given number to 1.\"\"\"\n    DEFAULT_MAX_BITS = 64\n\n    # Determine the effective number of bits needed.\n    # If n is 0, its bit_length is 0, but we need to consider bit 0.\n    highest_bit_length = n.bit_length() if n > 0 else 1\n\n    # The mask width is either DEFAULT_MAX_BITS or the number's highest bit length, whichever is greater.\n    width = max(highest_bit_length, DEFAULT_MAX_BITS)\n\n    # Construct a mask with 1s at all even bit positions (0, 2, 4, ...) up to the determined width.\n    mask = 0\n    for i in range(0, width, 2):\n        mask |= (1 << i)\n    \n    # Apply the mask using bitwise OR to set the even bits in n.\n    return n | mask"}
