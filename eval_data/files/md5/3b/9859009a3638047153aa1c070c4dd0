{"task_id": "Mbpp/395", "solution": "def first_non_repeating_character(s: str) -> Optional[str]:\n    \"\"\"\n    Finds the first non-repeated character in a string.\n    \"\"\"\n    from typing import Dict, Any, Optional\n    import unicodedata\n\n    class Config:\n        DEFAULT_NORMALIZATION: str = \"NFC\"\n\n    class InvalidInputError(Exception):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class StringUtils:\n        def normalize(self, s: str, form: str = Config.DEFAULT_NORMALIZATION) -> str:\n            return unicodedata.normalize(form, s)\n\n        def is_valid_string(self, s: Any) -> bool:\n            return isinstance(s, str)\n\n    class CharFrequencyRepository:\n        def build_frequency_map(self, s: str) -> Dict[str, int]:\n            freq: Dict[str, int] = {}\n            for ch in s:\n                freq[ch] = freq.get(ch, 0) + 1\n            return freq\n\n    class FirstNonRepeatingService:\n        def __init__(self, repo: CharFrequencyRepository, utils: StringUtils) -> None:\n            self._repo = repo\n            self._utils = utils\n\n        def find_first_non_repeating(self, s: str) -> Optional[str]:\n            if not self._utils.is_valid_string(s):\n                raise InvalidInputError(\"input must be a str\")\n            normalized = self._utils.normalize(s)\n            freq = self._repo.build_frequency_map(normalized)\n            for ch in normalized:\n                if freq.get(ch, 0) == 1:\n                    return ch\n            return None\n\n    _repo = CharFrequencyRepository()\n    _utils = StringUtils()\n    _service = FirstNonRepeatingService(_repo, _utils)\n\n    return _service.find_first_non_repeating(s)"}
{"task_id": "Mbpp/398", "solution": "def sum_of_digits(numbers):\n    \"\"\"\n    Computes the sum of digits of each number in a list and returns the total sum.\n    Handles integers, floats, and numeric strings by extracting their digits.\n    \"\"\"\n    total_sum = 0\n    for item in numbers:\n        s = str(item)\n        current_item_sum = 0\n        for char in s:\n            if char.isdigit():\n                current_item_sum += int(char)\n        total_sum += current_item_sum\n    return total_sum"}
