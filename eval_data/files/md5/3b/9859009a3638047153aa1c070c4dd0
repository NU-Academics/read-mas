{"task_id": "Mbpp/11", "solution": "def remove_Occ(s: str, ch: str) -> str:\n    \"\"\"\n    Removes the first and last occurrence of a given character/substring from the string.\n    If the character/substring occurs only once, that single occurrence is removed.\n    \"\"\"\n    first_idx = s.find(ch)\n    last_idx = s.rfind(ch)\n\n    if first_idx == -1:\n        return s  # Character/substring not found\n    \n    if first_idx == last_idx:\n        # Only one occurrence, remove it once\n        return s[:first_idx] + s[first_idx + len(ch):]\n    \n    # Remove first and last occurrences\n    return s[:first_idx] + s[first_idx + len(ch):last_idx] + s[last_idx + len(ch):]"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(a, b):\n    \"\"\"\n    Checks if two integers differ at exactly one bit position.\n    Negative numbers are treated as their absolute values for bit comparison.\n    \"\"\"\n    # Normalize numbers to their absolute values as per design assumptions for bit-difference semantics.\n    # Compute the XOR result of the normalized numbers.\n    xor_result = abs(a) ^ abs(b)\n\n    # A number has exactly one bit set (i.e., is a power of two) if it's greater than zero\n    # and the bitwise AND of the number and (number - 1) is zero.\n    return xor_result > 0 and (xor_result & (xor_result - 1)) == 0"}
{"task_id": "Mbpp/9", "solution": "```python\ndef find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    Uses the string search trick by concatenating the string with itself.\n    \"\"\"\n    n = len(s)\n    if n == 0:\n        return 0  # Or raise an error, but based on assert for \"aaaa\", this path not covered.\n    \n    # The smallest rotation period k can be found by searching for the original string\n    # within the concatenated string (s + s), starting from the second character (index 1).\n    # If 's' is \"abcd\", then \"abcdabcd\".find(\"abcd\", 1) will be 4.\n    # If 's' is \"abab\", then \"abababab\".find(\"abab\", 1) will be 2.\n    # If 's' is \"aaaa\", then \"aaaaaaaa\".find(\"aaaa\", 1) will be 1.\n    \n    # We are looking for the smallest k > 0 such that s[k:] + s[:k] == s.\n    # This is equivalent to finding the first occurrence of 's' in 's + s'\n    # starting from index 1.\n    \n    # Example: s = \"abab\"\n    # s+s = \"abababab\"\n    # (s+s).find(s, 1) will return 2.\n    # This means rotating \"abab\" by 2 positions gives \"abab\" (ab -> ba, ab -> ba, result ba + ba = abab) WRONG -> abab.rotate(2) -> abab\n    \n    # Let's clarify the logic from the design context:\n    # \"compute (s + s).find(s, 1) and if found and < len(s) return index; else return len(s).\"\n    # This is a standard algorithm for finding the smallest period of a string.\n    \n    # For \"aaaa\": (s+s) = \"aaaaaaaa\". \"aaaaaaaa\".find(\"aaaa\", 1) = 1.\n    # For \"abab\": (s+s) = \"abababab\". \"abababab\".find(\"abab\", 1) = 2.\n    # For \"abcd\": (s+s) = \"abcdabcd\". \"abcdabcd\".find(\"abcd\", 1) = 4.\n    \n    idx = (s + s).find(s, 1)\n    \n    # The `find` method returns -1 if not found. However, 's' will always be found in 's+s'\n    # at least at index n (the second occurrence of s).\n    # The problem asks for positive rotations.\n    # If idx is 0, it means no rotation works other than 0 rotations, which is not allowed.\n    # However, `find(s, 1)` ensures we start searching from index 1, so idx will never be 0.\n    \n    # If the string is periodic, `idx` will be the smallest period (k).\n    # If the string is not periodic (e.g., \"abcd\"), then the first occurrence of 's' in 's+s'\n    # starting from index 1 will be at index `n` (the start of the second 's').\n    # In this case, the string is only identical to itself after `n` rotations.\n    \n    if idx < n:\n        # idx is the smallest positive rotation count that returns the original string\n        return idx\n    else:\n        # If idx == n (or not found before n, which implies idx == n),\n        # it means the string is not periodic with a period smaller than its length.\n        # In this case, the minimum positive rotation is the full length of the string.\n        return n\n\n```"}
{"task_id": "Mbpp/7", "solution": "from typing import List, Optional\nfrom datetime import datetime\n\n# Assuming these imports are available in the context where this function is placed\n# (e.g., in src/wordfilter/word_controller.py)\nfrom .tokenizer import Tokenizer\nfrom .word_filter_service import WordFilterService\nfrom .result_repository import ResultRepository\nfrom .models.word_result import WordResult\nfrom .config import DEFAULT_MIN_LENGTH\n\ndef find_char_long(text: str, min_length: Optional[int] = None, persist_path: Optional[str] = None) -> List[str]:\n    \"\"\"\n    Finds all words at least min_length characters long in the given text, with optional persistence.\n    \"\"\"\n    tokenizer = Tokenizer()\n    service = WordFilterService(tokenizer)\n\n    actual_min_length = min_length if min_length is not None else DEFAULT_MIN_LENGTH\n    \n    results = service.find_char_long(text, actual_min_length)\n    \n    if persist_path:\n        repo = ResultRepository(persist_path)\n        result_obj = WordResult(input_text=text, min_length=actual_min_length, results=results, timestamp=datetime.utcnow())\n        repo.save(result_obj)\n        \n    return results"}
{"task_id": "Mbpp/2", "solution": "from typing import Iterable, Any, List\n\ndef similar_elements(iter1: Iterable[Any], iter2: Iterable[Any]) -> List[Any]:\n    \"\"\"Finds the shared elements between two iterables, returning them as a sorted list with no duplicates.\"\"\"\n    try:\n        # Attempt to use set intersection for efficiency if elements are hashable\n        set1 = set(iter1)\n        set2 = set(iter2)\n        result_list = list(set1.intersection(set2))\n    except TypeError:\n        # Fallback for unhashable elements: O(n*m) comparison\n        # Find all matching elements first\n        intermediate_matches = []\n        for x in iter1:\n            for y in iter2:\n                if x == y:\n                    intermediate_matches.append(x)\n                    break # Move to the next element in iter1 once a match is found\n        \n        # Deduplicate while preserving order, which works even for unhashable types\n        unique_result = []\n        for item in intermediate_matches:\n            if item not in unique_result:\n                unique_result.append(item)\n        result_list = unique_result\n\n    # Sort the result if elements are comparable for deterministic output\n    try:\n        return sorted(result_list)\n    except TypeError:\n        # If elements are not comparable (e.g., mixed types or unorderable types), return as-is\n        return result_list"}
{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import List, Sequence\n\ndef heap_queue_largest(nums: Sequence[int], n: int) -> List[int]:\n    \"\"\"\n    Finds the n largest integers from a list and returns them in descending order.\n    Handles n <= 0 by returning an empty list.\n    \"\"\"\n    if n <= 0:\n        return []\n    return heapq.nlargest(n, nums)"}
