{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(n: int) -> str:\n    \"\"\"\n    Convert a non-negative integer to its binary equivalent, represented as a string with no leading zeros.\n    \"\"\"\n    if n == 0:\n        return \"0\"\n\n    bits = []\n    # Repeatedly divide the number by 2 and collect the remainder (0 or 1)\n    # until the number becomes 0. The remainders, in reverse order, form the binary representation.\n    while n > 0:\n        # (n & 1) checks the last bit: 1 if odd, 0 if even\n        bits.append(\"1\" if (n & 1) else \"0\")\n        # Right shift n by 1 is equivalent to integer division by 2\n        n >>= 1\n    \n    # The bits are collected from LSB to MSB, so reverse the list and join them.\n    return \"\".join(reversed(bits))"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome strictly greater than the given integer n.\n    \"\"\"\n\n    # Handle negative inputs: The smallest palindrome strictly greater than any negative integer is 0.\n    if n < 0:\n        return 0\n\n    def _mirror_left_to_right(s: str) -> str:\n        \"\"\"\n        Creates a palindrome by mirroring the left half of a string s to its right half.\n        \"\"\"\n        length = len(s)\n        left_half = s[:length // 2]\n        mid_digit = s[length // 2] if length % 2 else ''\n        return left_half + mid_digit + left_half[::-1]\n\n    def _increment_and_form_base_for_mirror(s: str) -> str:\n        \"\"\"\n        Increments the \"prefix\" part of a number string that defines its palindrome form,\n        handling carry and digit expansion (e.g., \"99\" -> \"100\").\n        \"\"\"\n        length = len(s)\n        half_len_for_inc = (length + 1) // 2\n        prefix_to_inc_str = s[:half_len_for_inc]\n        \n        inc_prefix_val = int(prefix_to_inc_str) + 1\n        inc_prefix_str = str(inc_prefix_val)\n\n        # If the incremented prefix has more digits, it implies an \"all 9s\" scenario\n        # (e.g., \"9\" -> \"10\", \"99\" -> \"100\"). The new palindrome will have `length + 1` digits.\n        if len(inc_prefix_str) > half_len_for_inc:\n            return \"1\" + \"0\" * (length - 1) + \"1\"\n        else:\n            # Otherwise, use the incremented prefix and the remainder of the original string's suffix.\n            padded_inc_prefix_str = inc_prefix_str.zfill(half_len_for_inc)\n            return padded_inc_prefix_str + s[half_len_for_inc:]\n\n    s = str(n)\n\n    # 1. Generate an initial palindrome candidate by mirroring the left half of s.\n    candidate1_str = _mirror_left_to_right(s)\n    \n    # 2. Check if this candidate is strictly greater than the original input n.\n    if int(candidate1_str) > n:\n        return int(candidate1_str)\n    else:\n        # 3. If the first candidate is not strictly greater than n,\n        # increment the \"middle\" part of the number and then mirror again.\n        s_after_middle_inc = _increment_and_form_base_for_mirror(s)\n        candidate2_str = _mirror_left_to_right(s_after_middle_inc)\n        \n        return int(candidate2_str)"}
{"task_id": "Mbpp/104", "solution": "def sort_sublists(lists: list[list[str]]) -> list[list[str]]:\n    \"\"\"Sorts each sublist of strings in a given list of lists lexicographically.\n    Returns a new list of lists with sorted sublists, without mutating the original input.\n    \"\"\"\n    def _deep_copy_lists(original_lists: list[list[str]]) -> list[list[str]]:\n        \"\"\"Creates a deep copy of a list of lists of strings.\"\"\"\n        return [list(sublist) for sublist in original_lists]\n\n    def _canonical_sort_sublist(sublist: list[str]) -> list[str]:\n        \"\"\"Sorts a single list of strings lexicographically.\"\"\"\n        return sorted(sublist)\n\n    # Create a deep copy to ensure the original input list of lists is not modified.\n    copied_lists = _deep_copy_lists(lists)\n\n    # Sort each sublist within the copied structure.\n    sorted_result = [_canonical_sort_sublist(sublist) for sublist in copied_lists]\n\n    return sorted_result"}
