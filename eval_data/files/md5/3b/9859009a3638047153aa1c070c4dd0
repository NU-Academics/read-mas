{"task_id": "Mbpp/305", "solution": "import re\nfrom typing import List, Tuple\n\ndef start_withp(words: List[str]) -> Tuple[str, str]:\n    \"\"\"\n    Finds two words from a list of strings that start with the letter 'p' (case-insensitive).\n    Returns the first two such words, preserving their original casing.\n    \"\"\"\n    def _normalize_word(token: str) -> str:\n        # Strips common punctuation from the edges and converts to lowercase for comparison.\n        token = token.strip(\" \\t\\n\\r\\\"'()[]{}.,;:!?\")\n        return token.lower()\n\n    _TOKEN_SPLIT_RE = r\"\\s+\" # Regex to split words by whitespace\n\n    p_starting_words: List[str] = []\n    \n    for line in words:\n        parts = re.split(_TOKEN_SPLIT_RE, line.strip())\n        for part in parts:\n            if part: # Ensure the part is not an empty string\n                normalized_part = _normalize_word(part)\n                if normalized_part.startswith('p'):\n                    p_starting_words.append(part)\n                    if len(p_starting_words) == 2:\n                        return (p_starting_words[0], p_starting_words[1])\n\n    # Per the design context and example, this function assumes two such words will be found.\n    # No exception handling for fewer than two words as per completion instructions.\n    return (p_starting_words[0], p_starting_words[1]) # This line would only be reached if exactly two words were found,\n                                                    # but the explicit return above handles that.\n                                                    # If less than 2 words are found, this might cause an IndexError,\n                                                    # but instructions forbid adding checks/exceptions."}
{"task_id": "Mbpp/308", "solution": "import heapq\nfrom typing import List, Iterable, Iterator, Any, Tuple, Set\n\nclass InputValidationError(Exception):\n    \"\"\"Custom exception for invalid input.\"\"\"\n    pass\n\nclass InputValidator:\n    \"\"\"\n    Validates and normalizes input lists.\n    NOTE: Validation logic for error cases is omitted to adhere to prompt constraints\n    \"DO NOT add isinstance() checks or raise exceptions for edge cases\".\n    It assumes inputs are valid as per the problem description.\n    \"\"\"\n    @staticmethod\n    def _to_number_list(seq: Iterable[Any]) -> List[float]:\n        # Assumes elements in seq are numeric (int or float) and converts them to float.\n        return [float(x) for x in seq]\n\n    @staticmethod\n    def validate_lists(a: Iterable[Any], b: Iterable[Any], k: int) -> Tuple[List[float], List[float], int]:\n        # Assumes a, b are non-empty iterables of numbers, and k is a non-negative int.\n        # This method is a pass-through due to prompt constraints.\n        a_list = InputValidator._to_number_list(a)\n        b_list = InputValidator._to_number_list(b)\n        return a_list, b_list, k\n\nclass HeapTopK:\n    \"\"\"\n    Provides an iterator that yields the top-k products from two descending sorted lists.\n    It uses a max-heap to efficiently retrieve products without materializing all pairs.\n    \"\"\"\n    @staticmethod\n    def top_k_products_sorted(a_sorted: List[float], b_sorted: List[float], k: int) -> Iterator[float]:\n        if not a_sorted or not b_sorted or k <= 0:\n            return\n\n        # Use a min-heap to simulate a max-heap by storing negative product values.\n        # Each element in the heap is a tuple: (-product_value, a_index, b_index).\n        heap: List[Tuple[float, int, int]] = []\n        \n        # Keep track of visited index pairs (a_index, b_index) to avoid re-adding duplicate combinations.\n        visited: Set[Tuple[int, int]] = set()\n\n        # Start by adding the product of the largest elements from both sorted lists.\n        initial_product = a_sorted[0] * b_sorted[0]\n        heapq.heappush(heap, (-initial_product, 0, 0))\n        visited.add((0, 0))\n\n        products_yielded_count = 0\n        while heap and products_yielded_count < k:\n            neg_product, i, j = heapq.heappop(heap)\n            yield -neg_product\n            products_yielded_count += 1\n\n            # Explore the next possible product by incrementing the index in list 'a'.\n            if i + 1 < len(a_sorted) and (i + 1, j) not in visited:\n                next_product_a = a_sorted[i+1] * b_sorted[j]\n                heapq.heappush(heap, (-next_product_a, i + 1, j))\n                visited.add((i + 1, j))\n\n            # Explore the next possible product by incrementing the index in list 'b'.\n            if j + 1 < len(b_sorted) and (i, j + 1) not in visited:\n                next_product_b = a_sorted[i] * b_sorted[j+1]\n                heapq.heappush(heap, (-next_product_b, i, j + 1))\n                visited.add((i, j + 1))\n\nclass ProductService:\n    \"\"\"\n    Service responsible for computing the top-k products using different strategies.\n    It dispatches to a brute-force method for small inputs or a heap-based method for large inputs.\n    \"\"\"\n    def compute_top_k(self, a: List[float], b: List[float], k: int) -> List[float]:\n        total_pairs = len(a) * len(b)\n\n        # For a small number of total possible pairs (e.g., <= 10,000 as per design),\n        # generate all products and sort them. This is simpler and often faster for small N.\n        if total_pairs <= 10000:\n            products = [x * y for x in a for y in b]\n            products.sort(reverse=True)\n            return products[:k]\n        \n        # For a larger number of pairs, sort the individual lists and use the heap-based approach\n        # to efficiently find the top-k products without generating all N*M pairs.\n        a_sorted = sorted(a, reverse=True)\n        b_sorted = sorted(b, reverse=True)\n        return self._compute_top_k_sorted(a_sorted, b_sorted, k)\n\n    def _compute_top_k_sorted(self, a_sorted: List[float], b_sorted: List[float], k: int) -> List[float]:\n        # Collect the products generated by the HeapTopK iterator into a list.\n        return list(HeapTopK.top_k_products_sorted(a_sorted, b_sorted, k))\n\ndef large_product(a: List[int], b: List[int], k: int) -> List[int]:\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list.\n    \"\"\"\n    # Validate and normalize inputs through InputValidator (acting as a pass-through).\n    a_list, b_list, k_valid = InputValidator.validate_lists(a, b, k)\n\n    # Compute the top-k products using ProductService. The service returns float results.\n    float_results = ProductService().compute_top_k(a_list, b_list, k_valid)\n\n    # Convert the float results to integers to match the function's return type hint.\n    return [int(x) for x in float_results]"}
{"task_id": "Mbpp/312", "solution": "import math\n\ndef volume_cone(radius, height):\n    \"\"\"\n    Calculates the volume of a right circular cone.\n    The formula used is V = (1/3) * pi * radius^2 * height.\n    \"\"\"\n    return (1/3) * math.pi * (radius ** 2) * height"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Computes the maximum sum of an increasing subsequence from arr[0...i]\n    whose last element is strictly less than arr[k], then adds arr[k].\n    \"\"\"\n\n    def _compute_msis(current_arr: list[int]) -> list[int]:\n        \"\"\"Calculates the maximum sum of an increasing subsequence ending at each index.\"\"\"\n        n_current_arr = len(current_arr)\n        msis = list(current_arr)  # Initialize msis[j] = current_arr[j]\n        for j_idx in range(n_current_arr):\n            for t_idx in range(j_idx):\n                if current_arr[t_idx] < current_arr[j_idx] and msis[t_idx] + current_arr[j_idx] > msis[j_idx]:\n                    msis[j_idx] = msis[t_idx] + current_arr[j_idx]\n        return msis\n\n    def _find_best_prefix_sum(msis_values: list[int], current_arr: list[int], prefix_end_idx: int, k_value: int) -> int:\n        \"\"\"Finds the maximum MSIS sum in the prefix (0 to prefix_end_idx) where the element is less than k_value.\"\"\"\n        max_prefix_sum = 0\n        for j_idx in range(prefix_end_idx + 1):\n            if current_arr[j_idx] < k_value:\n                max_prefix_sum = max(max_prefix_sum, msis_values[j_idx])\n        return max_prefix_sum\n\n    msis = _compute_msis(arr)\n    k_val = arr[k]\n    best_sum_from_prefix = _find_best_prefix_sum(msis, arr, i, k_val)\n\n    # If no prefix element satisfies the condition, best_sum_from_prefix will be 0.\n    # The result is the best prefix sum plus the value of arr[k].\n    return best_sum_from_prefix + k_val"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    \"\"\"\n    Sets the left-most unset bit in the binary representation of n.\n    If all bits up to the MSB are set, the next higher bit is set.\n    \"\"\"\n    msb_index = n.bit_length() - 1\n\n    # Scan from the most significant bit (msb_index) down to 0\n    for i in range(msb_index, -1, -1):\n        # Check if the i-th bit is unset (0)\n        if ((n >> i) & 1) == 0:\n            # Set the i-th bit\n            return n | (1 << i)\n\n    # If all bits from 0 to msb_index are set (e.g., n = 7 which is 0b111),\n    # set the bit at position (msb_index + 1).\n    return n | (1 << (msb_index + 1))"}
