{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"Computes the Eulerian number A(n, m) using dynamic programming.\"\"\"\n    # Base case: A(0,0) = 1.\n    if n == 0 and m == 0:\n        return 1\n    \n    # Eulerian numbers A(n, m) are defined for 0 <= m < n. For other m values, it's 0.\n    # Also if n=0 and m!=0, it should be 0.\n    if n == 0 or m < 0 or m >= n:\n        return 0\n\n    # dp_rows stores rows of Eulerian numbers.\n    # dp_rows[i] will contain [A(i, 0), A(i, 1), ..., A(i, i-1)].\n    # Initialize with A(0,0) = 1.\n    dp_rows = [[1]] \n\n    # Iterate from n=1 up to the target n\n    for i in range(1, n + 1):\n        current_row = [0] * i  # A(i, k) for k from 0 to i-1. Length is i.\n        prev_row = dp_rows[i - 1] # A(i-1, k) for k from 0 to i-2. Length is i-1.\n\n        # Apply the recurrence relation: A(i, k) = (k+1)A(i-1, k) + (i-k)A(i-1, k-1)\n        for k in range(i): # k goes from 0 to i-1\n            # Term (k+1)A(i-1, k)\n            term1 = (k + 1) * (prev_row[k] if k < len(prev_row) else 0)\n            \n            # Term (i-k)A(i-1, k-1)\n            term2 = (i - k) * (prev_row[k - 1] if k - 1 >= 0 and k - 1 < len(prev_row) else 0)\n            \n            current_row[k] = term1 + term2\n        \n        dp_rows.append(current_row)\n        \n    return dp_rows[n][m]"}
{"task_id": "Mbpp/102", "solution": "import logging\nfrom typing import Any, List, Optional\n\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input strings.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass Utils:\n    \"\"\"Provides utility methods for string manipulation.\"\"\"\n    @staticmethod\n    def safe_strip(s: Optional[str]) -> str:\n        \"\"\"Strips leading/trailing whitespace from a string, treating None as an empty string.\"\"\"\n        return \"\" if s is None else s.strip()\n\nclass LoggerAdapter:\n    \"\"\"Adapts the standard logging module for consistent use within the application.\"\"\"\n    def __init__(self, logger_name: str = \"snake2camel\") -> None:\n        self._logger = logging.getLogger(logger_name)\n        if not self._logger.handlers:\n            handler = logging.StreamHandler()\n            self._logger.addHandler(handler)\n        self._logger.setLevel(logging.INFO)\n\n    def info(self, msg: str) -> None:\n        \"\"\"Logs an informational message.\"\"\"\n        self._logger.info(msg)\n\n    def error(self, msg: str) -> None:\n        \"\"\"Logs an error message.\"\"\"\n        self._logger.error(msg)\n\n    def debug(self, msg: str) -> None:\n        \"\"\"Logs a debug message.\"\"\"\n        self._logger.debug(msg)\n\nclass InputValidator:\n    \"\"\"Validates the type and content of input strings for conversion.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def validate_type(self, value: Any) -> None:\n        \"\"\"Ensures the provided value is a string, raising an error otherwise.\"\"\"\n        if not isinstance(value, str):\n            raise InvalidInputError(\"Input must be a string\")\n\n    def validate_non_empty(self, value: str) -> None:\n        \"\"\"Ensures the string is not empty after stripping whitespace, raising an error if it is.\"\"\"\n        if value.strip() == \"\":\n            raise InvalidInputError(\"Input must not be empty\")\n\nclass StringNormalizer:\n    \"\"\"Implements the core logic for converting snake_case segments to CamelCase.\"\"\"\n    def __init__(self, preserve_digits: bool = True) -> None:\n        self._preserve_digits = preserve_digits\n\n    def normalize(self, s: str) -> str:\n        \"\"\"Converts a snake_case string to CamelCase by splitting, filtering, and capitalizing segments.\"\"\"\n        s_stripped = Utils.safe_strip(s)\n        parts = self._split_and_filter(s_stripped)\n        if not parts:\n            raise InvalidInputError(\"No valid segments to convert\")\n        return \"\".join(self._capitalize_segment(p) for p in parts)\n\n    def _split_and_filter(self, s: str) -> List[str]:\n        \"\"\"Splits the string by underscores and removes any empty segments.\"\"\"\n        parts = s.split(\"_\")\n        return [p for p in parts if p != \"\"]\n\n    def _capitalize_segment(self, segment: str) -> str:\n        \"\"\"Capitalizes the first character of a segment and lowercases the rest.\"\"\"\n        if len(segment) == 0:\n            return \"\"\n        return segment[0].upper() + segment[1:].lower()\n\nclass SnakeToCamelService:\n    \"\"\"Orchestrates the validation and normalization process for snake_case to CamelCase conversion.\"\"\"\n    def __init__(self, validator: InputValidator, normalizer: StringNormalizer, logger: LoggerAdapter) -> None:\n        self._validator = validator\n        self._normalizer = normalizer\n        self._logger = logger\n\n    def convert(self, s: str) -> str:\n        \"\"\"Performs the conversion of a snake_case string to CamelCase, including input validation.\"\"\"\n        try:\n            self._validator.validate_type(s)\n            self._validator.validate_non_empty(s)\n            result = self._normalizer.normalize(s)\n            self._logger.info(f\"Converted {s!r} -> {result!r}\")\n            return result\n        except InvalidInputError:\n            self._logger.error(f\"Invalid input for conversion: {s!r}\")\n            raise\n\ndef snake_to_camel(s: str) -> str:\n    \"\"\"\n    Converts a snake_case string to a CamelCase string.\n\n    This function validates the input, splits it into segments, capitalizes each segment,\n    and then joins them to form the CamelCase string.\n    \"\"\"\n    logger = LoggerAdapter()\n    svc = SnakeToCamelService(InputValidator(), StringNormalizer(), logger)\n    return svc.convert(s)"}
