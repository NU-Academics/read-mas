{"task_id": "Mbpp/125", "solution": "def find_length(s: str) -> int:\n    \"\"\"\n    Calculates the maximum difference between the count of '0's and '1's\n    in any sub-string of the given binary string using Kadane's algorithm.\n    \"\"\"\n    n = len(s)\n    if n == 0:\n        return 0\n\n    def get_value(char: str) -> int:\n        # Map '0' to +1 and '1' to -1 for the difference calculation.\n        return 1 if char == \"0\" else -1\n\n    max_so_far = get_value(s[0])\n    current_max = get_value(s[0])\n\n    for i in range(1, n):\n        char_value = get_value(s[i])\n        # Kadane's algorithm: decide whether to extend the current subarray or start a new one.\n        # If adding the current value makes the sum smaller than the current value itself,\n        # it means the current subarray sum was negative and it's better to start fresh.\n        if current_max + char_value < char_value:\n            current_max = char_value\n        else:\n            current_max += char_value\n        \n        # Update the overall maximum sum found across all subarrays.\n        if current_max > max_so_far:\n            max_so_far = current_max\n            \n    return max_so_far"}
{"task_id": "Mbpp/124", "solution": "import math\nfrom typing import Union, Optional, Any\n\n# Custom exception for invalid complex number inputs.\nclass InvalidComplexError(Exception):\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\n# Checks if x is a finite integer or float.\ndef _is_finite_number(x: Any) -> bool:\n    return isinstance(x, (int, float)) and math.isfinite(x)\n\n# Normalizes an angle from [-pi, pi] to the principal range (-pi, pi].\ndef _normalize_angle_principal(angle: float) -> float:\n    if angle == -math.pi:\n        return math.pi\n    return angle\n\ndef angle_complex(value: Union[complex, float, int], imag: Optional[Union[float, int, complex]] = None) -> float:\n    \"\"\"\n    Computes the principal argument (angle) of a complex number in radians, in the range (-pi, pi].\n    Handles single complex, or real and imaginary components.\n    \"\"\"\n    real_component: float\n    imag_component: float\n\n    if imag is None:\n        if isinstance(value, complex):\n            real_component = value.real\n            imag_component = value.imag\n        elif isinstance(value, (int, float)):\n            real_component = float(value)\n            imag_component = 0.0\n        else:\n            raise InvalidComplexError(f\"Invalid type for value: {type(value)}. Expected complex, float, or int.\")\n    else:\n        if isinstance(value, (int, float)):\n            real_component = float(value)\n        else:\n            raise InvalidComplexError(f\"Invalid type for real component: {type(value)}. Expected float or int.\")\n\n        if isinstance(imag, complex):\n            imag_component = imag.imag\n        elif isinstance(imag, (int, float)):\n            imag_component = float(imag)\n        else:\n            raise InvalidComplexError(f\"Invalid type for imag component: {type(imag)}. Expected complex, float, or int.\")\n\n    if not _is_finite_number(real_component) or not _is_finite_number(imag_component):\n        raise InvalidComplexError(\"Real and imaginary components must be finite numbers.\")\n\n    raw_angle = math.atan2(imag_component, real_component)\n\n    return _normalize_angle_principal(raw_angle)"}
{"task_id": "Mbpp/128", "solution": "import re\n\ndef long_words(n, text):\n    \"\"\"\n    Finds words longer than n characters from the given text.\n    Words are considered as sequences of alphanumeric characters.\n    \"\"\"\n    words = re.findall(r\"[A-Za-z0-9]+\", text)\n    filtered_words = [word for word in words if len(word) > n]\n    return filtered_words"}
{"task_id": "Mbpp/130", "solution": "import collections\nfrom typing import Sequence, TypeVar\n\nT = TypeVar(\"T\")\n\ndef max_occurrences(items: Sequence[T]) -> T:\n    \"\"\"\n    Finds the item with the maximum frequency in a given list,\n    using earliest occurrence as a tie-breaker.\n    \"\"\"\n    counts = collections.Counter(items)\n    \n    # Per design, input is guaranteed non-empty, so counts will not be empty.\n    max_count = max(counts.values())\n    \n    # Iterate through the original list to find the first item\n    # that has the maximum frequency. This handles the tie-breaker.\n    for item in items:\n        if counts[item] == max_count:\n            return item"}
{"task_id": "Mbpp/129", "solution": "from typing import List\n\ndef magic_square_test(matrix: List[List[int]]) -> bool:\n    \"\"\"\n    Calculates whether the given square matrix is a magic square.\n    A matrix is a magic square if the sum of numbers in each row,\n    each column, and both main diagonals are the same.\n    \"\"\"\n    n = len(matrix)\n\n    # An empty matrix is not considered a magic square.\n    if n == 0:\n        return False\n\n    # Calculate the target sum from the first row.\n    # We assume the matrix is square and contains integers based on problem constraints.\n    target_sum = sum(matrix[0])\n\n    # Check all row sums\n    for i in range(n):\n        if sum(matrix[i]) != target_sum:\n            return False\n\n    # Check all column sums\n    for j in range(n):\n        col_sum = 0\n        for i in range(n):\n            col_sum += matrix[i][j]\n        if col_sum != target_sum:\n            return False\n\n    # Check primary diagonal sum (top-left to bottom-right)\n    primary_diag_sum = 0\n    for i in range(n):\n        primary_diag_sum += matrix[i][i]\n    if primary_diag_sum != target_sum:\n        return False\n\n    # Check secondary diagonal sum (top-right to bottom-left)\n    secondary_diag_sum = 0\n    for i in range(n):\n        secondary_diag_sum += matrix[i][n - 1 - i]\n    if secondary_diag_sum != target_sum:\n        return False\n\n    # If all sums match the target sum, it is a magic square\n    return True"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels in a given string. 'y' is not considered a vowel.\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n    chars = list(s)\n    left, right = 0, len(chars) - 1\n\n    while left < right:\n        # Move left pointer until a vowel is found\n        while left < right and chars[left] not in VOWELS:\n            left += 1\n        # Move right pointer until a vowel is found\n        while left < right and chars[right] not in VOWELS:\n            right -= 1\n\n        # If both pointers found vowels and haven't crossed, swap them\n        if left < right:\n            chars[left], chars[right] = chars[right], chars[left]\n            left += 1\n            right -= 1\n\n    return \"\".join(chars)"}
