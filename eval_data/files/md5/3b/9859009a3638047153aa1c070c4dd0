{"task_id": "Mbpp/87", "solution": "import json\nimport os\nimport tempfile\nfrom typing import Optional, Any\n\nclass MergeError(Exception):\n    \"\"\"Exception raised for errors in the merge strategy.\"\"\"\n    pass\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for input validation failures.\"\"\"\n    pass\n\nclass MergeRequest:\n    \"\"\"Typed container for merge inputs and options.\"\"\"\n    def __init__(self, d1: dict, d2: dict, d3: dict, persist: bool = False, output_path: Optional[str] = None) -> None:\n        self.d1 = d1\n        self.d2 = d2\n        self.d3 = d3\n        self.persist = persist\n        self.output_path = output_path\n\nclass MergeResult:\n    \"\"\"Typed container for merge outputs.\"\"\"\n    def __init__(self, result: dict) -> None:\n        self.result = result\n\n    def to_json(self) -> str:\n        \"\"\"Returns the merged dictionary as a JSON string.\"\"\"\n        return json.dumps(self.result, ensure_ascii=False, indent=2)\n\nclass Validator:\n    \"\"\"Provides utility methods for validating dictionary inputs.\"\"\"\n\n    @staticmethod\n    def validate_dict_like(obj: Any) -> dict:\n        \"\"\"Ensures the object is a dictionary, raising ValidationError if not.\"\"\"\n        if not isinstance(obj, dict):\n            raise ValidationError(f\"Expected a dictionary, but got {type(obj).__name__}\")\n        return obj\n\n    @staticmethod\n    def ensure_hashable_keys(d: dict) -> None:\n        \"\"\"Ensures all keys in the dictionary are hashable, raising ValidationError if not.\"\"\"\n        for key in d.keys():\n            try:\n                hash(key)\n            except TypeError as e:\n                raise ValidationError(f\"Key '{key}' is not hashable: {e}\") from e\n\nclass DictRepository:\n    \"\"\"Handles saving and loading dictionaries as JSON files.\"\"\"\n    DEFAULT_ENCODING = \"utf-8\"\n\n    def save(self, result: dict, path: str) -> None:\n        \"\"\"Saves the given dictionary as a JSON file to the specified path atomically.\"\"\"\n        dirpath = os.path.dirname(path) or \".\"\n        os.makedirs(dirpath, exist_ok=True)\n        fd, tmp = tempfile.mkstemp(dir=dirpath)\n        try:\n            with os.fdopen(fd, \"w\", encoding=self.DEFAULT_ENCODING) as f:\n                json.dump(result, f, ensure_ascii=False, indent=2)\n            os.replace(tmp, path)\n        finally:\n            if os.path.exists(tmp):\n                try:\n                    os.remove(tmp)\n                except OSError:\n                    pass\n\n    def load(self, path: str) -> dict:\n        \"\"\"Loads a dictionary from a JSON file at the specified path.\"\"\"\n        with open(path, \"r\", encoding=self.DEFAULT_ENCODING) as f:\n            return json.load(f)\n\nclass MergeStrategy:\n    \"\"\"Abstract interface for defining dictionary merge policies.\"\"\"\n    def merge(self, a: dict, b: dict, c: dict) -> dict:\n        raise NotImplementedError(\"MergeStrategy.merge must be implemented by subclasses.\")\n\nclass DefaultMergeStrategy(MergeStrategy):\n    \"\"\"Implements a 'rightmost wins' merge strategy for dictionaries.\"\"\"\n    DEFAULT_DOC = \"Rightmost-wins merge: equivalent to {**a, **b, **c}.\"\n\n    def merge(self, a: dict, b: dict, c: dict) -> dict:\n        merged = {}\n        merged.update(a)\n        merged.update(b)\n        merged.update(c)\n        return merged\n\nclass DictionaryMerger:\n    \"\"\"Orchestrates dictionary merging using a provided strategy and optional persistence.\"\"\"\n    def __init__(self, strategy: MergeStrategy, repository: Optional[DictRepository] = None) -> None:\n        self.strategy = strategy\n        self.repository = repository\n\n    def merge(self, request: MergeRequest) -> MergeResult:\n        \"\"\"Validates inputs, merges dictionaries, and optionally persists the result.\"\"\"\n        Validator.validate_dict_like(request.d1)\n        Validator.validate_dict_like(request.d2)\n        Validator.validate_dict_like(request.d3)\n        \n        Validator.ensure_hashable_keys(request.d1)\n        Validator.ensure_hashable_keys(request.d2)\n        Validator.ensure_hashable_keys(request.d3)\n\n        merged = self.strategy.merge(request.d1, request.d2, request.d3)\n\n        if request.persist and self.repository and request.output_path:\n            self.repository.save(merged, request.output_path)\n\n        return MergeResult(merged)\n\ndef merge_dictionaries_three(d1: dict, d2: dict, d3: dict, strategy: Optional[MergeStrategy] = None, persist: bool = False, output_path: Optional[str] = None) -> dict:\n    \"\"\"Merges three dictionaries into a single dictionary using a specified or default strategy.\"\"\"\n    chosen_strategy = strategy or DefaultMergeStrategy()\n    \n    repo: Optional[DictRepository] = None\n    if persist and output_path:\n        repo = DictRepository()\n    \n    merger = DictionaryMerger(strategy=chosen_strategy, repository=repo)\n    req = MergeRequest(d1=d1, d2=d2, d3=d3, persist=persist, output_path=output_path)\n    result = merger.merge(req)\n    return result.result"}
