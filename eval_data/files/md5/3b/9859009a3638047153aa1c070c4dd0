{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"Calculates the sum of per-digit absolute differences between two integers.\"\"\"\n\n    # Helper to split an integer into a list of its digits (least significant first).\n    def _split_digits(n: int) -> list[int]:\n        if n == 0:\n            return [0]\n        digits = []\n        while n > 0:\n            digits.append(n % 10)\n            n //= 10\n        return digits\n\n    # Helper to pad two digit lists with zeros so they have the same length.\n    def _pad_digits(a_digits: list[int], b_digits: list[int]) -> tuple[list[int], list[int]]:\n        maxlen = max(len(a_digits), len(b_digits))\n        a_padded = a_digits + [0] * (maxlen - len(a_digits))\n        b_padded = b_digits + [0] * (maxlen - len(b_digits))\n        return a_padded, b_padded\n\n    # Use absolute values of the input numbers for digit extraction.\n    a_abs = abs(a)\n    b_abs = abs(b)\n\n    # Split numbers into lists of digits.\n    a_digits = _split_digits(a_abs)\n    b_digits = _split_digits(b_abs)\n\n    # Pad the digit lists to ensure they are of equal length for pairwise comparison.\n    a_padded, b_padded = _pad_digits(a_digits, b_digits)\n\n    # Calculate the sum of absolute differences between corresponding digits.\n    total_difference = sum(abs(x - y) for x, y in zip(a_padded, b_padded))\n\n    return total_difference"}
{"task_id": "Mbpp/554", "solution": "def Split(numbers: list[int]) -> list[int]:\n    \"\"\"\n    Filters a list of integers, returning only the odd ones while preserving order.\n    Assumes input `numbers` is a list of integers.\n    \"\"\"\n    return [n for n in numbers if n % 2 != 0]"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr, n):\n    \"\"\"\n    Finds the sum of the largest contiguous sublist using Kadane's algorithm.\n    Assumes the input list 'arr' is non-empty and contains integers, and n is its valid length.\n    \"\"\"\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, n):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
