{"task_id": "Mbpp/3", "solution": "import math\nfrom collections import OrderedDict\nfrom typing import Optional, Any\nfrom abc import ABC, abstractmethod\n\nclass MathUtils:\n    \"\"\"Provides utility methods for mathematical operations.\"\"\"\n    @staticmethod\n    def isqrt(n: int) -> int:\n        \"\"\"Calculates the integer square root of a non-negative integer.\"\"\"\n        return math.isqrt(n)\n\nclass IPrimeChecker(ABC):\n    \"\"\"Abstract base class for prime checking strategies.\"\"\"\n    @abstractmethod\n    def is_prime(self, n: int) -> bool:\n        pass\n\nclass SimplePrimeChecker(IPrimeChecker):\n    \"\"\"\n    A prime checker implementation using trial division with small optimizations.\n    Handles small primes, even numbers, and performs checks up to the square root.\n    \"\"\"\n    _SMALL_PRIMES = (2, 3, 5, 7, 11, 13)\n\n    def is_prime(self, n: int) -> bool:\n        if n < 2:\n            return False\n        if n in self._SMALL_PRIMES:\n            return True\n        if n % 2 == 0:\n            return False\n        r = MathUtils.isqrt(n)\n        for d in range(3, r + 1, 2):\n            if n % d == 0:\n                return False\n        return True\n\nclass PrimeCache:\n    \"\"\"A simple bounded in-memory cache for primality test results.\"\"\"\n    def __init__(self, max_size: int = 1024):\n        self._store: OrderedDict[int, bool] = OrderedDict()\n        self._max_size = max_size\n\n    def get(self, n: int) -> Optional[bool]:\n        \"\"\"Retrieves a cached primality result for n.\"\"\"\n        if n in self._store:\n            self._store.move_to_end(n)\n            return self._store[n]\n        return None\n\n    def set(self, n: int, is_prime: bool) -> None:\n        \"\"\"Stores a primality result for n in the cache.\"\"\"\n        self._store[n] = is_prime\n        self._store.move_to_end(n)\n        if len(self._store) > self._max_size:\n            self._store.popitem(last=False)\n\n    def clear(self) -> None:\n        \"\"\"Clears all entries from the cache.\"\"\"\n        self._store.clear()\n\nclass PrimeService:\n    \"\"\"Orchestrates primality checks, handling caching and checker delegation.\"\"\"\n    def __init__(self, checker: IPrimeChecker, cache: Optional[PrimeCache] = None):\n        self._checker = checker\n        self._cache = cache\n\n    def is_not_prime(self, n: int, strict_input: bool = False) -> bool:\n        # Input 'n' is assumed to be an integer. Strict input validation\n        # that raises exceptions for n < 2 is omitted as per constraints.\n        \n        if self._cache:\n            cached = self._cache.get(n)\n            if cached is not None:\n                return not cached\n\n        is_prime = self._checker.is_prime(n)\n\n        if self._cache:\n            try:\n                self._cache.set(n, is_prime)\n            except Exception:\n                # Cache failures should degrade gracefully without crashing.\n                pass\n        return not is_prime\n\nclass PrimeAPI:\n    \"\"\"Public facade for primality checking, providing a simple interface.\"\"\"\n    def __init__(self, checker: Optional[IPrimeChecker] = None, cache: Optional[PrimeCache] = None):\n        self._checker = checker if checker is not None else SimplePrimeChecker()\n        self._cache = cache if cache is not None else PrimeCache()\n        self._service = PrimeService(checker=self._checker, cache=self._cache)\n\n    def is_not_prime(self, n: int, strict_input: bool = False) -> bool:\n        \"\"\"Determines if the given integer n is a non-prime number.\"\"\"\n        return self._service.is_not_prime(n, strict_input=strict_input)\n\n# Initialize a default API instance for the top-level function.\n_default_api = PrimeAPI()\n\ndef is_not_prime(n: int, strict_input: bool = False) -> bool:\n    \"\"\"\n    Identifies if a number is non-prime.\n    It returns True if n is not prime, and False if n is prime.\n    \"\"\"\n    return _default_api.is_not_prime(n, strict_input=strict_input)"}
{"task_id": "Mbpp/12", "solution": "def sort_matrix(matrix: list[list[int]]) -> list[list[int]]:\n    \"\"\"\n    Sorts a matrix by the sum of its rows in ascending order, maintaining stability.\n    \"\"\"\n    if not matrix:\n        return []\n\n    # Pair each row with its original index and its sum\n    # (original_index, row, row_sum)\n    indexed_rows_with_sums = []\n    for idx, row in enumerate(matrix):\n        row_sum = sum(row)\n        indexed_rows_with_sums.append((idx, row, row_sum))\n\n    # Sort primarily by row_sum, secondarily by original_index for stability\n    sorted_triplets = sorted(indexed_rows_with_sums, key=lambda t: (t[2], t[0]))\n\n    # Extract the sorted rows\n    sorted_matrix = [t[1] for t in sorted_triplets]\n\n    return sorted_matrix"}
