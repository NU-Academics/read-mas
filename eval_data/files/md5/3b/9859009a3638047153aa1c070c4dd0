{"task_id": "Mbpp/436", "solution": "import collections.abc\nfrom typing import Iterable, List, Any, Optional\n\nclass NegativeFilterError(Exception):\n    \"\"\"Custom exception for errors during negative number filtering.\"\"\"\n    def __init__(self, message: str, cause: Optional[Exception] = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.__cause__ = cause\n\ndef parse_number(value: Any) -> float:\n    \"\"\"Converts a value to float, handling int, float, and numeric strings.\"\"\"\n    if isinstance(value, (int, float)):\n        return float(value)\n    if isinstance(value, str):\n        try:\n            return float(value.strip())\n        except ValueError:\n            pass # Fall through to raise generic ValueError\n    raise ValueError(f\"Value '{value}' is not numeric\")\n\nclass ListValidator:\n    \"\"\"Validates and converts an iterable of values into a list of floats.\"\"\"\n    def validate(self, numbers: Iterable[Any]) -> List[float]:\n        \"\"\"Converts each element to float, raising NegativeFilterError on failure.\"\"\"\n        if not self.is_iterable(numbers):\n            raise NegativeFilterError(\"Input is not an iterable of numbers\")\n        \n        result = []\n        for i, v in enumerate(numbers):\n            try:\n                result.append(parse_number(v))\n            except ValueError as e:\n                raise NegativeFilterError(f\"Element at index {i} is not numeric: {v}\", cause=e) from e\n        return result\n\n    def is_iterable(self, obj: Any) -> bool:\n        \"\"\"Checks if an object is iterable but not a string or bytes.\"\"\"\n        return isinstance(obj, collections.abc.Iterable) and not isinstance(obj, (str, bytes))\n\nclass NegNumbersService:\n    \"\"\"Business logic for filtering negative numbers.\"\"\"\n    def __init__(self, validator: ListValidator) -> None:\n        self._validator = validator\n\n    def filter_negative(self, numbers: Iterable[Any]) -> List[float]:\n        \"\"\"Validates input and returns a list of strictly negative numbers.\"\"\"\n        validated = self._validator.validate(numbers)\n        return [x for x in validated if x < 0]\n\ndef neg_nos(numbers: Iterable[float]) -> List[float]:\n    \"\"\"\n    Returns a list containing only the negative numbers from the input list.\n    Handles numeric strings and raises NegativeFilterError for invalid inputs.\n    \"\"\"\n    validator = ListValidator()\n    service = NegNumbersService(validator)\n    return service.filter_negative(numbers)"}
{"task_id": "Mbpp/439", "solution": "from typing import List, Optional\nimport math\n\nclass InputValidationError(Exception):\n    \"\"\"Custom exception for invalid input.\"\"\"\n    def __init__(self, message: str, index: Optional[int] = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.index = index\n\ndef digit_length(n: int) -> int:\n    \"\"\"Returns the number of decimal digits of abs(n). For n=0, returns 1.\"\"\"\n    if n == 0:\n        return 1\n    return int(math.log10(abs(n))) + 1\n\ndef safe_pow10(exp: int) -> int:\n    \"\"\"Computes 10 to the power of exp.\"\"\"\n    if exp < 0:\n        raise ValueError(\"Exponent must be non-negative for safe_pow10.\")\n    return 10**exp\n\nclass IntegerFormatter:\n    \"\"\"Handles the core logic of concatenating integers using arithmetic.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def _concat_positive(self, a: int, b: int) -> int:\n        \"\"\"Helper to compute a * 10^{digits(b)} + b for positive a and b.\"\"\"\n        dn = digit_length(b)\n        return a * safe_pow10(dn) + b\n\n    def concatenate(self, numbers: List[int]) -> int:\n        \"\"\"Combines a list of integers into a single integer, handling signs.\"\"\"\n        if not numbers:\n            return 0\n\n        sign = -1 if numbers[0] < 0 else 1\n        result = abs(numbers[0])\n\n        for n in numbers[1:]:\n            result = self._concat_positive(result, abs(n))\n\n        return sign * result\n\nclass InputValidator:\n    \"\"\"Validates the input list and its elements.\"\"\"\n    def __init__(self, allow_empty: bool = False) -> None:\n        self.allow_empty = allow_empty\n\n    def validate(self, numbers: List[int]) -> None:\n        \"\"\"Ensures the input is a list/tuple of integers (not bools).\"\"\"\n        if not isinstance(numbers, (list, tuple)):\n            raise InputValidationError(\"Input must be a list or tuple.\")\n        if not self.allow_empty and len(numbers) == 0:\n            raise InputValidationError(\"Input list must not be empty.\")\n        for i, x in enumerate(numbers):\n            if not isinstance(x, int) or isinstance(x, bool): # bool is a subclass of int\n                raise InputValidationError(f\"Element at index {i} is not an integer.\", index=i)\n\nclass JoinService:\n    \"\"\"Orchestrates the integer joining process.\"\"\"\n    def __init__(self, formatter: IntegerFormatter) -> None:\n        self.formatter = formatter\n\n    def join_list(self, numbers: List[int]) -> int:\n        \"\"\"Calls the formatter to concatenate the numbers.\"\"\"\n        return self.formatter.concatenate(numbers)\n\nclass MultipleJoinController:\n    \"\"\"Public API facade for joining multiple integers into one.\"\"\"\n    def __init__(self, service: JoinService, validator: InputValidator, logger=None) -> None:\n        self.service = service\n        self.validator = validator\n        self.logger = logger\n\n    def multiple_to_single(self, numbers: List[int]) -> int:\n        \"\"\"Validates input, calls service to join, and returns the result.\"\"\"\n        self.validator.validate(numbers)\n        result = self.service.join_list(numbers)\n        return result\n\n_default_controller = MultipleJoinController(\n    service=JoinService(formatter=IntegerFormatter()),\n    validator=InputValidator(),\n    logger=None\n)\n\ndef multiple_to_single(numbers: List[int]) -> int:\n    \"\"\"Joins a list of integers into a single integer by concatenating their decimal representations.\"\"\"\n    return _default_controller.multiple_to_single(numbers)"}
{"task_id": "Mbpp/440", "solution": "def find_adverb_position(sentence: str) -> Optional[Tuple[int, int, str]]:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    \"\"\"\n    import string\n    import unicodedata\n    from typing import Optional, List, Tuple, Set\n\n    # --- Configuration Constants ---\n    DEFAULT_ADVERB_SUFFIXES: List[str] = [\"ly\"]\n    DEFAULT_ADVERBS: List[str] = [\"very\", \"quite\", \"just\", \"really\", \"already\"]\n    PUNCTUATION_CHARS: str = string.punctuation\n\n    # --- Data Models ---\n    class Token:\n        def __init__(self, text: str, start: int, end: int):\n            self.text = text\n            self.start = start\n            self.end = end\n\n        def __repr__(self) -> str:\n            return f\"Token(text='{self.text}', start={self.start}, end={self.end})\"\n\n    class AdverbMatch:\n        def __init__(self, text: str, start: int, end: int):\n            self.text = text\n            self.start = start\n            self.end = end\n\n        def as_tuple(self) -> Tuple[int, int, str]:\n            return (self.start, self.end, self.text)\n\n    # --- Utility Classes ---\n    class TextNormalizer:\n        def normalize(self, sentence: str) -> str:\n            \"\"\"Normalizes the input sentence using NFKC, keeping punctuation for indexing.\"\"\"\n            # Performs unicode NFKC normalization without removing punctuation,\n            # as tokenizer needs original structure for precise indexing.\n            return unicodedata.normalize(\"NFKC\", sentence)\n\n    class Tokenizer:\n        def tokenize(self, sentence: str) -> List[Token]:\n            \"\"\"\n            Tokenizes a sentence into words, preserving original indices and handling internal apostrophes.\n            Trailing punctuation is excluded from the token text and end index.\n            \"\"\"\n            tokens = []\n            current_word_start = -1\n\n            for i, char in enumerate(sentence):\n                is_word_part = char.isalpha()\n                if not is_word_part and char == \"'\":\n                    # Check if it's an internal apostrophe:\n                    # Must not be at the very start of a word part and must be surrounded by letters.\n                    if current_word_start != -1 and \\\n                       (i > 0 and sentence[i-1].isalpha()) and \\\n                       (i + 1 < len(sentence) and sentence[i+1].isalpha()):\n                        is_word_part = True\n                \n                if is_word_part:\n                    if current_word_start == -1:\n                        current_word_start = i\n                else: # Not a word part\n                    if current_word_start != -1: # End of a word segment\n                        word_end_idx = i\n                        # Adjust word_end_idx to exclude any trailing non-word_part characters\n                        while word_end_idx > current_word_start:\n                            last_char_in_segment = sentence[word_end_idx-1]\n                            is_last_char_valid = last_char_in_segment.isalpha() or \\\n                                                 (last_char_in_segment == \"'\" and \\\n                                                  (word_end_idx-1 > current_word_start and sentence[word_end_idx-2].isalpha()))\n                            if is_last_char_valid:\n                                break\n                            word_end_idx -= 1\n                        \n                        if word_end_idx > current_word_start:\n                            tokens.append(Token(sentence[current_word_start:word_end_idx], current_word_start, word_end_idx))\n                        current_word_start = -1 # Reset for next token\n\n            # Handle the last token if the sentence ends with a word\n            if current_word_start != -1:\n                word_end_idx = len(sentence)\n                while word_end_idx > current_word_start:\n                    last_char_in_segment = sentence[word_end_idx-1]\n                    is_last_char_valid = last_char_in_segment.isalpha() or \\\n                                         (last_char_in_segment == \"'\" and \\\n                                          (word_end_idx-1 > current_word_start and sentence[word_end_idx-2].isalpha()))\n                    if is_last_char_valid:\n                        break\n                    word_end_idx -= 1\n                if word_end_idx > current_word_start:\n                    tokens.append(Token(sentence[current_word_start:word_end_idx], current_word_start, word_end_idx))\n            return tokens\n\n    class AdverbRepository:\n        def __init__(self, adverbs: Optional[List[str]] = None, suffixes: Optional[List[str]] = None):\n            \"\"\"Initializes with default or provided adverbs and suffixes.\"\"\"\n            self._adverbs: Set[str] = set(s.lower() for s in (adverbs if adverbs is not None else DEFAULT_ADVERBS))\n            self._suffixes: List[str] = [s.lower() for s in (suffixes if suffixes is not None else DEFAULT_ADVERB_SUFFIXES)]\n\n        def is_adverb(self, word: str) -> bool:\n            \"\"\"Checks if a word is an adverb based on internal lists and suffixes.\"\"\"\n            lower_word = word.lower()\n            if lower_word in self._adverbs:\n                return True\n            for suffix in self._suffixes:\n                if lower_word.endswith(suffix):\n                    return True\n            return False\n\n        def get_first_adverb(self, tokens: List[Token]) -> Optional[AdverbMatch]:\n            \"\"\"Finds the first adverb from a list of tokens.\"\"\"\n            for token in tokens:\n                if self.is_adverb(token.text):\n                    return AdverbMatch(token.text, token.start, token.end)\n            return None\n\n    # --- Service Layer ---\n    class AdverbFinderService:\n        def __init__(self, normalizer: Optional[TextNormalizer] = None, \n                     tokenizer: Optional[Tokenizer] = None, \n                     repository: Optional[AdverbRepository] = None):\n            \"\"\"Initializes the service with optional dependency injection for components.\"\"\"\n            self._normalizer = normalizer if normalizer is not None else TextNormalizer()\n            self._tokenizer = tokenizer if tokenizer is not None else Tokenizer()\n            self._repository = repository if repository is not None else AdverbRepository()\n\n        def find_first_adverb(self, sentence: str) -> Optional[AdverbMatch]:\n            \"\"\"Orchestrates finding the first adverb in a sentence.\"\"\"\n            # Normalize sentence (e.g., NFKC) while preserving its structure for tokenizer\n            # The normalizer here primarily handles unicode normalization;\n            # punctuation stripping and index mapping are handled by the tokenizer.\n            normalized_sentence = self._normalizer.normalize(sentence)\n            \n            # Tokenize the normalized sentence to get word segments with their original indices\n            tokens = self._tokenizer.tokenize(normalized_sentence)\n            \n            # Find the first adverb from the tokens\n            return self._repository.get_first_adverb(tokens)\n\n    # --- Function Implementation ---\n    # Instantiate the service with default components\n    service = AdverbFinderService()\n    \n    # Call the service method to find the first adverb match\n    match = service.find_first_adverb(sentence)\n    \n    # If a match is found, return it as a tuple; otherwise, return None\n    if match:\n        return match.as_tuple()\n    return None"}
