{"task_id": "Mbpp/227", "solution": "import math\nfrom typing import Any\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass ServiceError(Exception):\n    \"\"\"Exception raised for unexpected service failures.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass MinRequest:\n    \"\"\"Data Transfer Object for minimum computation request.\"\"\"\n    def __init__(self, a: float, b: float, c: float) -> None:\n        self.a = a\n        self.b = b\n        self.c = c\n\nclass NumericValidator:\n    \"\"\"Validates and normalizes numeric inputs.\"\"\"\n    def __init__(self, reject_nan: bool = True) -> None:\n        self.reject_nan = reject_nan\n\n    def validate(self, a: Any, b: Any, c: Any) -> MinRequest:\n        try:\n            fa, fb, fc = float(a), float(b), float(c)\n        except (TypeError, ValueError):\n            raise ValidationError(\"All inputs must be numeric or numeric strings\")\n        if self.reject_nan:\n            for v in (fa, fb, fc):\n                if math.isnan(v) or math.isinf(v):\n                    raise ValidationError(\"NaN or Infinity not allowed\")\n        return MinRequest(fa, fb, fc)\n\nclass MinService:\n    \"\"\"Business logic for computing the minimum of three numbers.\"\"\"\n    def __init__(self, validator: NumericValidator) -> None:\n        self.validator = validator\n\n    def compute_min(self, a: float, b: float, c: float) -> float:\n        # Validate inputs via the injected validator, converting to MinRequest.\n        req = self.validator.validate(a, b, c)\n        try:\n            return min(req.a, req.b, req.c)\n        except Exception as e:\n            raise ServiceError(str(e))\n\ndef min_of_three(a: float, b: float, c: float) -> float:\n    \"\"\"Finds the minimum of three numbers, handling validation and conversion.\"\"\"\n    validator = NumericValidator()\n    service = MinService(validator)\n    return service.compute_min(a, b, c)"}
