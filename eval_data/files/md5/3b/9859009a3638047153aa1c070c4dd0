{"task_id": "Mbpp/294", "solution": "def max_val(list_param):\n    \"\"\"\n    Finds the maximum numeric value in a heterogeneous list, ignoring non-numeric items.\n    Non-numeric items like strings are skipped in the aggregation.\n    \"\"\"\n    numeric_values = []\n\n    # Helper to determine if a value is numeric (int or float, excluding bool).\n    def _is_numeric(value):\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n    for item in list_param:\n        if _is_numeric(item):\n            numeric_values.append(item)\n\n    return max(numeric_values)"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(nested_list):\n    \"\"\"\n    Flattens a given nested list structure into a single-level list.\n    Recursively traverses the input, appending atomic elements to the result list while preserving order.\n    \"\"\"\n    result = []\n\n    def _flatten_recursive_helper(current_list):\n        for item in current_list:\n            if isinstance(item, (list, tuple)):\n                _flatten_recursive_helper(item)\n            else:\n                result.append(item)\n\n    _flatten_recursive_helper(nested_list)\n    return result"}
{"task_id": "Mbpp/293", "solution": "def otherside_rightangle(a: float, b: float, *, hypotenuse: Optional[str] = None) -> float:\n    import math\n    from typing import Any, List, Optional, Tuple\n\n    class InvalidSideError(ValueError):\n        def __init__(self, message: str):\n            super().__init__(message)\n            self.message = message\n\n    class Triangle:\n        def __init__(self, s1: float, s2: float, hypotenuse: Optional[str] = None) -> None:\n            self.s1 = s1\n            self.s2 = s2\n            self.hypotenuse = hypotenuse\n\n        def as_tuple(self) -> Tuple[float, float, Optional[str]]:\n            return (self.s1, self.s2, self.hypotenuse)\n\n    class InputValidator:\n        @staticmethod\n        def validate_side(value: Any) -> float:\n            try:\n                v = float(value)\n            except (TypeError, ValueError):\n                raise InvalidSideError(f\"Side value {value!r} is not numeric\")\n            if v <= 0:\n                raise InvalidSideError(\"Triangle sides must be positive\")\n            return v\n\n        @staticmethod\n        def validate_triangle(tri: Triangle) -> None:\n            if tri.hypotenuse not in (None, 's1', 's2'):\n                raise InvalidSideError(\"hypotenuse must be 's1', 's2', or None\")\n            if tri.hypotenuse == 's1' and tri.s1 <= tri.s2:\n                raise InvalidSideError(\"s1 declared as hypotenuse must be greater than s2\")\n            if tri.hypotenuse == 's2' and tri.s2 <= tri.s1:\n                raise InvalidSideError(\"s2 declared as hypotenuse must be greater than s1\")\n\n        @staticmethod\n        def parse_hypotenuse_flag(argv: List[str]) -> Optional[str]:\n            if '--hypotenuse-a' in argv:\n                return 's1'\n            if '--hypotenuse-b' in argv:\n                return 's2'\n            return None\n\n    class TriangleService:\n        def compute_third_side(self, triangle: Triangle) -> float:\n            InputValidator.validate_triangle(triangle)\n            if triangle.hypotenuse is None:\n                return self._compute_hypotenuse(triangle.s1, triangle.s2)\n            if triangle.hypotenuse == 's1':\n                return self._compute_missing_leg(triangle.s1, triangle.s2)\n            return self._compute_missing_leg(triangle.s2, triangle.s1)\n\n        def _compute_hypotenuse(self, a: float, b: float) -> float:\n            return math.hypot(a, b)\n\n        def _compute_missing_leg(self, hyp: float, leg: float) -> float:\n            diff = hyp*hyp - leg*leg\n            if diff <= 0:\n                raise InvalidSideError(\"Hypotenuse must be greater than the leg.\")\n            return math.sqrt(diff)\n\n    a_f = InputValidator.validate_side(a)\n    b_f = InputValidator.validate_side(b)\n    tri = Triangle(a_f, b_f, hypotenuse)\n    svc = TriangleService()\n    return svc.compute_third_side(tri)"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(items):\n    totals = {}\n    for name, score in items:\n        totals[name] = totals.get(name, 0) + score\n\n    if not totals:\n        return (\"\", 0)\n\n    max_total = max(totals.values())\n\n    candidates = []\n    for name, total in totals.items():\n        if total == max_total:\n            candidates.append((name, total))\n\n    # Tie-breaker: lexicographically smallest name\n    winner = min(candidates, key=lambda item: item[0])\n\n    return winner"}
{"task_id": "Mbpp/300", "solution": "import math\n\ndef count_binary_seq(n):\n    \"\"\"\n    Calculates the count of binary sequences of length 2n where the sum of the\n    first n bits is the same as the sum of the last n bits.\n    This count is given by the central binomial coefficient C(2n, n).\n    \"\"\"\n    # The number of such sequences is given by the central binomial coefficient C(2n, n).\n    return float(math.comb(2 * n, n))"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(d):\n    \"\"\"\n    Computes the maximum nesting depth of dictionaries.\n    An empty dictionary or a dictionary with only non-dict values has a depth of 1.\n    \"\"\"\n    def _get_depth(node, current_depth):\n        if not isinstance(node, dict):\n            return current_depth\n        \n        max_seen_depth = current_depth\n        for value in node.values():\n            if isinstance(value, dict):\n                depth_from_child = _get_depth(value, current_depth + 1)\n                if depth_from_child > max_seen_depth:\n                    max_seen_depth = depth_from_child\n        return max_seen_depth\n\n    return _get_depth(d, 1)"}
