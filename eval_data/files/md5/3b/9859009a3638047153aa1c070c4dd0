{"task_id": "Mbpp/463", "solution": "def max_subarray_product(nums: List[int]) -> int:\n    \"\"\"\n    Finds the maximum product of a contiguous subarray within the given list of integers.\n    Handles positive, negative, and zero numbers efficiently.\n    \"\"\"\n    if not nums:\n        return 0\n\n    best_product = nums[0]\n    current_max = nums[0]\n    current_min = nums[0]\n\n    for i in range(1, len(nums)):\n        n = nums[i]\n\n        if n == 0:\n            # If current best product is negative, 0 is better.\n            # Reset current_max/min for next sequence as 0 terminates current product.\n            best_product = max(best_product, 0)\n            current_max, current_min = 1, 1\n            continue\n\n        # Store current_max before it's updated, as it's needed for current_min calculation\n        temp_max_for_min_calc = current_max \n        \n        # Calculate new current_max and current_min ending at nums[i]\n        current_max = max(n, n * current_max, n * current_min)\n        current_min = min(n, n * temp_max_for_min_calc, n * current_min)\n\n        # Update the overall best product found so far\n        best_product = max(best_product, current_max)\n\n    return best_product"}
{"task_id": "Mbpp/468", "solution": "def max_product(arr: list[int]) -> int:\n    # Finds the maximum product of a strictly increasing contiguous subsequence.\n    # Assumes 'arr' is a non-empty list of integers, as per general instructions to skip validation.\n    \n    best_product = arr[0]\n    current_product = arr[0]\n    prev = arr[0]\n\n    for v in arr[1:]:\n        if v > prev:\n            current_product *= v\n        else:\n            current_product = v\n        \n        if current_product > best_product:\n            best_product = current_product\n        \n        prev = v\n    \n    return best_product"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple: tuple[int, ...]) -> tuple[int, ...]:\n    \"\"\"Calculates the pairwise sum of neighboring elements in a tuple of integers.\"\"\"\n    return tuple(input_tuple[i] + input_tuple[i + 1] for i in range(len(input_tuple) - 1))"}
{"task_id": "Mbpp/465", "solution": "from typing import Any, Dict, Mapping\n\ndef drop_empty(data: Dict[str, Any], deep: bool=True, remove_none: bool=True, remove_empty_strings: bool=True, remove_empty_collections: bool=True) -> Dict[str, Any]:\n    \"\"\"\n    Recursively removes empty items from a dictionary based on configurable rules.\n    Returns a new dictionary without mutating the original input.\n    \"\"\"\n\n    def _is_empty(value: Any) -> bool:\n        \"\"\"Determines if a value is considered empty based on the function's configuration flags.\"\"\"\n        if value is None and remove_none:\n            return True\n        if isinstance(value, str) and value == \"\" and remove_empty_strings:\n            return True\n        if remove_empty_collections and isinstance(value, (list, tuple, set, dict)) and not value:\n            return True\n        return False\n\n    def _clean_mapping(mapping: Mapping[str, Any]) -> Dict[str, Any]:\n        \"\"\"Performs the recursive cleaning of the dictionary.\"\"\"\n        cleaned = {}\n        for k, v in mapping.items():\n            if deep and isinstance(v, dict):\n                v_clean = _clean_mapping(v)\n                # If the cleaned nested dictionary is not empty (by _is_empty rules), include it.\n                if not _is_empty(v_clean):\n                    cleaned[k] = v_clean\n                continue\n\n            if _is_empty(v):\n                continue\n            \n            cleaned[k] = v\n        return cleaned\n\n    return _clean_mapping(data)"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(arr, n):\n    \"\"\"\n    Calculates the product of array elements modulo n.\n    It applies modular multiplication at each step to prevent overflow.\n    \"\"\"\n    # Initialize the product with 1, as per the mathematical convention for an empty product.\n    current_product = 1\n\n    def _safe_mod_mul(a: int, b: int, modulus: int) -> int:\n        \"\"\"Helper to compute (a * b) % modulus using properties of modular arithmetic.\"\"\"\n        return (a % modulus * (b % modulus)) % modulus\n\n    for x in arr:\n        current_product = _safe_mod_mul(current_product, x, n)\n\n    # Ensure the final result is in the range [0, n-1].\n    return current_product % n"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(lst):\n    # An empty list cannot contain consecutive numbers.\n    if not lst:\n        return False\n\n    # Convert the list to a set to get unique elements.\n    unique_elements = set(lst)\n\n    # If the original list length is different from the number of unique elements,\n    # it implies there are duplicate numbers, making the list non-consecutive by default.\n    if len(lst) != len(unique_elements):\n        return False\n\n    # If all elements are unique, check for consecutiveness using the range and count.\n    # For a list of unique consecutive integers, the difference between the maximum and minimum\n    # value, plus one, must equal the total count of unique elements.\n    min_val = min(unique_elements)\n    max_val = max(unique_elements)\n\n    return (max_val - min_val + 1) == len(unique_elements)"}
