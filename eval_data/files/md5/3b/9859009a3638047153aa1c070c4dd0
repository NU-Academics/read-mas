{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n):\n    \"\"\"\n    Finds the highest power of 2 that is less than or equal to n.\n    Assumes n is an integer greater than or equal to 1.\n    \"\"\"\n    return 1 << (n.bit_length() - 1)"}
{"task_id": "Mbpp/392", "solution": "_memo_cache = {}\n\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Calculates the maximum sum for n using f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n    Results are memoized to optimize performance for repeated subproblems.\n    \"\"\"\n    if n in _memo_cache:\n        return _memo_cache[n]\n\n    if n == 0:\n        result = 0\n    else:\n        children_sum = (get_max_sum(n // 2) +\n                        get_max_sum(n // 3) +\n                        get_max_sum(n // 4) +\n                        get_max_sum(n // 5))\n        result = max(n, children_sum)\n\n    _memo_cache[n] = result\n    return result"}
{"task_id": "Mbpp/391", "solution": "from typing import List, Tuple, Any, Iterable, Type\n\nclass ValidationError(Exception):\n    pass\n\nclass ConversionError(Exception):\n    pass\n\nclass Utils:\n    @staticmethod\n    def try_cast_int(value: Any) -> Any:\n        \"\"\"\n        Attempts to cast a value to an integer if it represents a whole number string.\n        Returns the original value otherwise, including if it's already an int.\n        \"\"\"\n        if isinstance(value, str):\n            if value.isdigit() or (value.startswith('-') and len(value) > 1 and value[1:].isdigit()):\n                try:\n                    return int(value)\n                except ValueError:\n                    pass # Fall through to return original value\n        return value\n\nclass ConvertRequest:\n    def __init__(self, ids: List[str], names: List[str], values: List[Any]):\n        self.ids = ids\n        self.names = names\n        self.values = values\n\n    def to_tuples(self) -> List[Tuple[str, str, Any]]:\n        return list(zip(self.ids, self.names, self.values))\n\nclass ConvertResult:\n    def __init__(self, items: List[dict]):\n        self.items = items\n\n    def to_list(self) -> List[dict]:\n        return self.items\n\nclass ListValidator:\n    def validate_lengths(self, *lists: Iterable[Any]) -> None:\n        \"\"\"\n        Validates that all provided lists have the same length.\n        \"\"\"\n        if not lists:\n            return\n        lengths = [len(l) for l in lists]\n        if not all(l == lengths[0] for l in lengths):\n            raise ValidationError(f\"All lists must be same length: {lengths}\")\n\nclass ConverterService:\n    def __init__(self, validator: ListValidator):\n        self._validator = validator\n\n    def convert(self, request: ConvertRequest) -> ConvertResult:\n        \"\"\"\n        Converts the request's lists into a list of nested dictionaries.\n        \"\"\"\n        self._validator.validate_lengths(request.ids, request.names, request.values)\n        items = []\n        for id_, name, value in request.to_tuples():\n            try:\n                processed = Utils.try_cast_int(value)\n                items.append({id_: {name: processed}})\n            except Exception as exc:\n                raise ConversionError(\"Failed to convert item\") from exc\n        return ConvertResult(items)\n\ndef convert_list_dictionary(ids: List[str], names: List[str], values: List[Any]) -> List[dict]:\n    \"\"\"\n    Converts three parallel lists into a list of nested dictionaries.\n    \"\"\"\n    service = ConverterService(ListValidator())\n    req = ConvertRequest(ids, names, values)\n    return service.convert(req).to_list()"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    \"\"\"\n    Computes the n'th Lucas number using the fast doubling method for Fibonacci numbers.\n    L0=2, L1=1, Ln = Ln-1 + Ln-2 for n >= 2.\n    \"\"\"\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n\n    def _fib_pair_fast_doubling(k: int) -> tuple[int, int]:\n        \"\"\"\n        Helper function to compute the k-th and (k+1)-th Fibonacci numbers (F_k, F_{k+1})\n        using the fast doubling method, where F0=0 and F1=1.\n        \"\"\"\n        if k == 0:\n            return (0, 1)\n\n        # Recursively calculate (F_m, F_{m+1}) for m = k // 2\n        a, b = _fib_pair_fast_doubling(k // 2)\n\n        # Use identities: F_{2m} = F_m * (2*F_{m+1} - F_m) and F_{2m+1} = F_m^2 + F_{m+1}^2\n        F_2m = a * (2 * b - a)\n        F_2m_plus_1 = a*a + b*b\n\n        if k % 2 == 0:  # If k is even, then k = 2m\n            return (F_2m, F_2m_plus_1)\n        else:  # If k is odd, then k = 2m + 1\n            # We need (F_{2m+1}, F_{2m+2}), where F_{2m+2} = F_{2m+1} + F_{2m}\n            return (F_2m_plus_1, F_2m + F_2m_plus_1)\n\n    # For n >= 2, Lucas numbers L_n can be derived from Fibonacci numbers F_n and F_{n+1}\n    # using the identity L_n = 2 * F_{n+1} - F_n.\n    F_n, F_n_plus_1 = _fib_pair_fast_doubling(n)\n\n    return 2 * F_n_plus_1 - F_n"}
