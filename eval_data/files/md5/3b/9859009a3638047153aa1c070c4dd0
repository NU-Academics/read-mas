{"task_id": "Mbpp/427", "solution": "from dataclasses import dataclass\nimport datetime\n\nclass InvalidDateError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass InvalidDateFormatError(InvalidDateError):\n    def __init__(self, message: str = \"Invalid date format\") -> None:\n        super().__init__(message)\n\nclass InvalidDateValueError(InvalidDateError):\n    def __init__(self, message: str = \"Invalid date value\") -> None:\n        super().__init__(message)\n\n@dataclass(frozen=True)\nclass DateParts:\n    \"\"\"Holds parsed date components.\"\"\"\n    year: int\n    month: int\n    day: int\n\n    @staticmethod\n    def from_components(year: int, month: int, day: int) -> \"DateParts\":\n        \"\"\"Factory method to create a DateParts instance.\"\"\"\n        return DateParts(year=year, month=month, day=day)\n\ndef split_date_str(date_str: str) -> tuple[int, int, int]:\n    \"\"\"Splits a 'YYYY-MM-DD' string into integer year, month, and day components.\"\"\"\n    parts = date_str.split(\"-\")\n    if len(parts) != 3:\n        raise InvalidDateFormatError(\"expected YYYY-MM-DD format with three parts\")\n    year_s, month_s, day_s = parts\n    try:\n        return int(year_s), int(month_s), int(day_s)\n    except ValueError:\n        raise InvalidDateFormatError(\"date components must be integers\")\n\nclass DateValidator:\n    \"\"\"Validates date string format and calendar correctness.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def validate(self, date_str: str) -> None:\n        \"\"\"Ensures the date string is in YYYY-MM-DD format and represents a valid date.\"\"\"\n        parts = date_str.split(\"-\")\n        if len(parts) != 3:\n            raise InvalidDateFormatError(\"expected format YYYY-MM-DD\")\n        y_str, m_str, d_str = parts\n        if not (len(y_str) == 4 and len(m_str) == 2 and len(d_str) == 2 and y_str.isdigit() and m_str.isdigit() and d_str.isdigit()):\n            raise InvalidDateFormatError(\"expected digits in YYYY-MM-DD format\")\n        try:\n            datetime.date(int(y_str), int(m_str), int(d_str))\n        except ValueError as e:\n            raise InvalidDateValueError(str(e))\n\nclass DateFormatter:\n    \"\"\"Converts and formats date components.\"\"\"\n    def __init__(self, validator: \"DateValidator\") -> None:\n        self._validator = validator\n\n    def change_date_format(self, date_str: str) -> str:\n        \"\"\"Validates and converts a 'YYYY-MM-DD' date string to 'DD-MM-YYYY'.\"\"\"\n        self._validator.validate(date_str)\n        year, month, day = split_date_str(date_str)\n        parts = DateParts.from_components(year, month, day)\n        return self._format_parts(parts)\n\n    def _format_parts(self, parts: DateParts) -> str:\n        \"\"\"Formats DateParts object into 'DD-MM-YYYY' string.\"\"\"\n        return f\"{parts.day:02d}-{parts.month:02d}-{parts.year:04d}\"\n\nclass DateController:\n    \"\"\"Manages the date conversion process.\"\"\"\n    def __init__(self, formatter: \"DateFormatter\") -> None:\n        self._formatter = formatter\n\n    def change_date_format(self, date_str: str) -> str:\n        \"\"\"Delegates date string conversion to the formatter.\"\"\"\n        return self._formatter.change_date_format(date_str)\n\n\ndef change_date_format(date_str: str) -> str:\n    \"\"\"Converts a date string from 'YYYY-MM-DD' to 'DD-MM-YYYY' format.\"\"\"\n    validator_instance = DateValidator()\n    formatter_instance = DateFormatter(validator_instance)\n    controller_instance = DateController(formatter_instance)\n    return controller_instance.change_date_format(date_str)"}
{"task_id": "Mbpp/428", "solution": "from typing import List, Sequence, Callable, Optional\n\ndef shell_sort(items: Sequence[int], gap_sequence: Optional[Callable[[int], List[int]]] = None, in_place: bool = False) -> List[int]:\n    \"\"\"Sorts a sequence of integers using the Shell Sort algorithm.\n    Optionally allows custom gap sequences and in-place sorting for mutable sequences.\n    \"\"\"\n\n    def _default_gap_sequence(n: int) -> List[int]:\n        \"\"\"Generates the default halving gap sequence for Shell Sort.\"\"\"\n        gaps = []\n        gap = n // 2\n        while gap > 0:\n            gaps.append(gap)\n            gap //= 2\n        return gaps\n\n    def _insertion_with_gap(arr: List[int], start: int, gap: int) -> None:\n        \"\"\"Performs gapped insertion sort on a sub-array.\"\"\"\n        for i in range(start + gap, len(arr), gap):\n            current_value = arr[i]\n            position = i\n            while position >= start + gap and arr[position - gap] > current_value:\n                arr[position] = arr[position - gap]\n                position -= gap\n            arr[position] = current_value\n\n    arr: List[int]\n    if in_place:\n        arr = items  # type: ignore # Assume items is mutable if in_place is True\n    else:\n        arr = list(items) # Create a mutable copy\n\n    n = len(arr)\n    \n    if n <= 1:\n        return arr\n\n    gaps = gap_sequence(n) if gap_sequence is not None else _default_gap_sequence(n)\n    \n    for gap in gaps:\n        for start in range(gap):\n            _insertion_with_gap(arr, start, gap)\n            \n    return arr"}
{"task_id": "Mbpp/432", "solution": "def median_trapezium(base1, base2, base3):\n    \"\"\"Calculates the median length of a trapezium, ignoring the third parameter.\"\"\"\n    return (base1 + base2) / 2.0"}
{"task_id": "Mbpp/430", "solution": "def parabola_directrix(a: float, b: float, c: float) -> float:\n    # Computes the y-coordinate of the directrix for a parabola given by y = a x^2 + b x + c.\n    # The formula for the directrix is y = c - (b^2 + 1) / (4a).\n    return c - ((b * b) + 1.0) / (4.0 * a)"}
