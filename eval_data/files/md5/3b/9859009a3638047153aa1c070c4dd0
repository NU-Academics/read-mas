{"task_id": "Mbpp/473", "solution": "from collections import Counter\n\ndef tuple_intersection(a, b):\n    \"\"\"\n    Finds the tuple intersection of elements in the given tuple lists,\n    irrespective of their order within tuples.\n    \"\"\"\n    def _canonical_by_counter(items):\n        \"\"\"Returns a canonical tuple representation using element counts for unorderable items.\"\"\"\n        counts = Counter(items)\n        # Sort by item's string representation and then by count for deterministic order\n        ordered = sorted(counts.items(), key=lambda kv: (repr(kv[0]), kv[1]))\n        result = []\n        for val, cnt in ordered:\n            result.extend([val] * cnt)\n        return tuple(result)\n\n    def _normalize_single_tuple(items):\n        \"\"\"Normalizes a single tuple to its canonical form (sorted elements or Counter-based).\"\"\"\n        try:\n            # Attempt to sort tuple elements if they are orderable\n            normalized = tuple(sorted(items))\n        except TypeError:\n            # Fallback for unorderable elements, using Counter-based canonicalization\n            normalized = _canonical_by_counter(items)\n        return normalized\n\n    # Normalize all tuples in both input lists and convert to sets\n    canonical_set_a = {_normalize_single_tuple(t) for t in a}\n    canonical_set_b = {_normalize_single_tuple(t) for t in b}\n\n    # Compute the intersection of the sets of canonical tuples\n    return canonical_set_a & canonical_set_b"}
{"task_id": "Mbpp/474", "solution": "import os\nimport json\nfrom datetime import datetime\n\nclass ReplaceError(Exception):\n    \"\"\"Exception raised for replacement-related errors.\"\"\"\n\nclass AuditError(Exception):\n    \"\"\"Exception raised for audit logging errors.\"\"\"\n\nclass ReplaceRequest:\n    \"\"\"Data Transfer Object for replace function requests.\"\"\"\n    def __init__(self, text: str, old: str, new: str) -> None:\n        self.text = text\n        self.old = old\n        self.new = new\n\n    @staticmethod\n    def from_args(text: str, old: str, new: str) -> 'ReplaceRequest':\n        \"\"\"Factory method to create a ReplaceRequest from arguments.\"\"\"\n        return ReplaceRequest(text, old, new)\n\nclass ReplaceResult:\n    \"\"\"Data Transfer Object for replace function results.\"\"\"\n    def __init__(self, original: str, result: str, replaced_count: int) -> None:\n        self.original = original\n        self.result = result\n        self.replaced_count = replaced_count\n\n    def to_dict(self) -> dict:\n        \"\"\"Converts the result object to a dictionary for audit logging.\"\"\"\n        return {\n            \"original\": self.original,\n            \"result\": self.result,\n            \"replaced_count\": self.replaced_count,\n        }\n\ndef sanitize_for_audit(s: str) -> str:\n    \"\"\"Truncates long strings for audit logs.\"\"\"\n    return s[:1000] + \"...\" if len(s) > 1000 else s\n\nclass Validator:\n    \"\"\"Validates ReplaceRequest objects.\"\"\"\n    def validate_request(self, request: ReplaceRequest) -> None:\n        \"\"\"Ensures request inputs are valid for replacement.\"\"\"\n        if not isinstance(request.text, str):\n            raise ReplaceError(\"Input 'text' must be a string.\")\n        if not isinstance(request.old, str):\n            raise ReplaceError(\"Input 'old' must be a string.\")\n        if not isinstance(request.new, str):\n            raise ReplaceError(\"Input 'new' must be a string.\")\n        if not request.old:\n            raise ReplaceError(\"'old' character cannot be an empty string.\")\n\nclass FileAdapter:\n    \"\"\"Handles low-level file operations for appending JSON lines.\"\"\"\n    def append_json_line(self, path: str, obj: dict) -> None:\n        \"\"\"Appends a JSON object as a new line to the specified file.\"\"\"\n        try:\n            dirname = os.path.dirname(path)\n            if dirname and not os.path.exists(dirname):\n                os.makedirs(dirname, exist_ok=True)\n            with open(path, 'a', encoding='utf-8') as f:\n                f.write(json.dumps(obj) + '\\n')\n        except IOError as e:\n            raise AuditError(f\"Failed to write to audit log file: {e}\")\n\nclass AuditRepository:\n    \"\"\"Manages the persistence of audit entries.\"\"\"\n    def __init__(self, adapter: 'FileAdapter', path: str) -> None:\n        self.adapter = adapter\n        self.path = path\n\n    def record(self, audit: dict) -> None:\n        \"\"\"Records an audit dictionary using the file adapter.\"\"\"\n        self.adapter.append_json_line(self.path, audit)\n\nclass StringService:\n    \"\"\"Provides business logic for string replacement operations.\"\"\"\n    def __init__(self, validator: 'Validator', audit_repo: 'AuditRepository') -> None:\n        self.validator = validator\n        self.audit_repo = audit_repo\n\n    def replace(self, request: 'ReplaceRequest') -> 'ReplaceResult':\n        \"\"\"Performs string replacement, validates inputs, and records an audit log.\"\"\"\n        self.validator.validate_request(request)\n        new_text, replaced_count = self._perform_replace(request.text, request.old, request.new)\n        result = ReplaceResult(original=request.text, result=new_text, replaced_count=replaced_count)\n        audit_entry = {\n            \"timestamp\": datetime.utcnow().isoformat() + \"Z\",\n            \"old\": request.old,\n            \"new\": request.new,\n            \"input_length\": len(request.text),\n            \"result_length\": len(new_text),\n            \"replaced_count\": replaced_count,\n            \"original_snippet\": sanitize_for_audit(request.text),\n            \"result_snippet\": sanitize_for_audit(new_text),\n            \"success\": True,\n            \"error\": None\n        }\n        self.audit_repo.record(audit_entry)\n        return result\n\n    def _perform_replace(self, text: str, old: str, new: str) -> tuple[str, int]:\n        \"\"\"Executes the actual string replacement and counts occurrences.\"\"\"\n        count = text.count(old)\n        return text.replace(old, new), count\n\nclass ReplaceController:\n    \"\"\"Acts as a facade between external calls and the StringService.\"\"\"\n    def __init__(self, service: 'StringService') -> None:\n        self.service = service\n\n    def handle_replace(self, request: 'ReplaceRequest') -> 'ReplaceResult':\n        \"\"\"Delegates replacement logic to the StringService.\"\"\"\n        return self.service.replace(request)\n\n_default_adapter = FileAdapter()\n_default_repo = AuditRepository(adapter=_default_adapter, path=\"data/audit_log.jsonl\")\n_default_service = StringService(validator=Validator(), audit_repo=_default_repo)\n_default_controller = ReplaceController(service=_default_service)\n\ndef replace_char(text: str, old: str, new: str) -> str:\n    \"\"\"Replaces all occurrences of 'old' with 'new' in the 'text' string.\"\"\"\n    req = ReplaceRequest.from_args(text, old, new)\n    result = _default_controller.handle_replace(req)\n    return result.result"}
{"task_id": "Mbpp/475", "solution": "from typing import Dict, Any, List, Tuple, Optional\n\nclass SortError(Exception):\n    \"\"\"Custom exception for sorting-related errors.\"\"\"\n    def __init__(self, message: str, error_code: int = 1) -> None:\n        super().__init__(message)\n        self.message = message\n        self.error_code = error_code\n\nclass Validator:\n    \"\"\"Validates and coerces input counters into Dict[str,int].\"\"\"\n    MAX_ITEMS = 100000\n\n    def validate_counter(self, counter: Any) -> Dict[str,int]:\n        if not isinstance(counter, dict):\n            raise SortError(\"Input must be a dict mapping\", 100)\n        if len(counter) > self.MAX_ITEMS:\n            raise SortError(\"Too many items\", 101)\n        result = {}\n        for k, v in counter.items():\n            if not isinstance(k, str):\n                raise SortError(f\"Key {k!r} must be a string\", 102)\n            result[k] = self._coerce_value(v)\n        return result\n\n    def _coerce_value(self, value: Any) -> int:\n        if isinstance(value, int):\n            return value\n        if isinstance(value, str) and value.isdigit():\n            return int(value)\n        raise SortError(f\"Value {value!r} is not an int\", 103)\n\nclass SortService:\n    \"\"\"Core business logic for sorting dictionaries by value.\"\"\"\n    DEFAULT_REVERSE = True\n\n    def __init__(self, validator: Validator, repository: Optional[Any]=None) -> None:\n        self._validator = validator\n        self._repo = repository\n\n    def sort_counter(self, counter: Dict[str, Any], reverse: bool = True) -> List[Tuple[str,int]]:\n        validated = self._validator.validate_counter(counter)\n        return self._sort_items(validated, reverse)\n\n    def _sort_items(self, validated: Dict[str,int], reverse: bool) -> List[Tuple[str,int]]:\n        # Sorts by value, then by key to ensure deterministic order for ties.\n        items = list(validated.items())\n        items.sort(key=lambda kv: (kv[1], kv[0]), reverse=reverse)\n        return items\n\ndef sort_counter(counter: dict, reverse: bool = True) -> List[Tuple[str, int]]:\n    \"\"\"Sorts a dictionary by its values, then by keys for ties, returning a list of (key, value) tuples.\"\"\"\n    validator = Validator()\n    service = SortService(validator)\n    return service.sort_counter(counter, reverse=reverse)"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr,n):\n    # Counts pairs where one element is even and the other is odd, as their XOR is odd.\n    # The 'n' parameter is not used as the length can be derived from 'arr'.\n    even_count = 0\n    odd_count = 0\n    for x in arr:\n        if x % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n    return even_count * odd_count"}
{"task_id": "Mbpp/479", "solution": "def first_Digit(number):\n    \"\"\"\n    Finds the first (most significant) digit of a given number,\n    handling integers, floats, and numeric strings by normalizing to an absolute integer value.\n    \"\"\"\n    # Convert the number to its absolute integer representation.\n    # This implicitly handles int, float (by truncating decimals),\n    # and numeric strings (by parsing and then truncating decimals).\n    n = abs(int(float(number)))\n\n    # If the number is zero, its first digit is 0.\n    if n == 0:\n        return 0\n    \n    # Repeatedly divide by 10 until only the first digit remains.\n    while n >= 10:\n        n //= 10\n    \n    return n"}
{"task_id": "Mbpp/476", "solution": "def big_sum(values):\n    \"\"\"\n    Finds the sum of the largest and smallest value in a given array.\n    Assumes the input array is non-empty and contains only numeric values.\n    \"\"\"\n    smallest_value = min(values)\n    largest_value = max(values)\n    return float(smallest_value) + float(largest_value)"}
{"task_id": "Mbpp/478", "solution": "```python\ndef remove_lowercase(text: str) -> str:\n    \"\"\"Removes all lowercase letter characters (Unicode category Ll) from a string.\n\n    This function iterates through the input string and builds a new string\n    containing only characters that are not lowercase letters according to\n    Unicode rules.\n    \"\"\"\n    import unicodedata\n\n    out_chars = []\n    for ch in text:\n        # Check if the character is lowercase and specifically a letter (category 'Ll')\n        if not (ch.islower() and unicodedata.category(ch).startswith('L')):\n            out_chars.append(ch)\n    return ''.join(out_chars)\n```"}
{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers using O(1) formulas.\n    \"\"\"\n    sum_of_first_n_numbers = n * (n + 1) // 2\n    sum_of_cubes_of_first_n_numbers = sum_of_first_n_numbers * sum_of_first_n_numbers\n    return sum_of_cubes_of_first_n_numbers - sum_of_first_n_numbers"}
