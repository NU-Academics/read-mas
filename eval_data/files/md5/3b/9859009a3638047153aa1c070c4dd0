{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array):\n    # An array is monotonic if it is either monotonically increasing or monotonically decreasing.\n    # An empty array or a single-element array is considered monotonic.\n    if len(array) <= 1:\n        return True\n\n    increasing = True\n    decreasing = True\n\n    for i in range(len(array) - 1):\n        if array[i] < array[i+1]:\n            decreasing = False\n        elif array[i] > array[i+1]:\n            increasing = False\n        \n        # Optimization: if both flags become false, it's not monotonic.\n        if not increasing and not decreasing:\n            return False\n\n    return increasing or decreasing"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Computes the nth Bell number using the Bell triangle dynamic programming method.\n    The Bell number B(n) represents the number of partitions of a set with n elements.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Initialize the first row of the Bell triangle, which corresponds to B(0)\n    # 'prev_row' stores the elements of the (i-1)th row of the triangle\n    prev_row = [1]\n\n    # Iterate to build the triangle row by row up to n\n    for i in range(1, n + 1):\n        # The first element of the current row is the last element of the previous row\n        current_row = [prev_row[-1]]\n        # Fill the remaining elements of the current row using the recurrence relation\n        for j in range(1, i + 1):\n            # C(i, j) = C(i, j-1) + C(i-1, j-1)\n            # current_row[j-1] is C(i, j-1)\n            # prev_row[j-1] is C(i-1, j-1)\n            current_row.append(current_row[j-1] + prev_row[j-1])\n        prev_row = current_row # Set the current row as the previous row for the next iteration\n\n    # The first element of the nth row is the nth Bell number, B(n)\n    return prev_row[0]"}
{"task_id": "Mbpp/70", "solution": "def get_equal(tuples: Sequence[Tuple[Any, ...]]) -> bool:\n    \"\"\"\n    Checks if all tuples in the given sequence have the same length.\n    Returns True if all tuples are of equal length, or if the sequence is empty.\n    \"\"\"\n    if not tuples:\n        return True\n\n    # Get the length of the first tuple in the sequence.\n    first_len = len(tuples[0])\n\n    # Iterate through all tuples and compare their lengths to the first.\n    for t in tuples:\n        if len(t) != first_len:\n            return False\n\n    return True"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(container, candidate):\n    \"\"\"\n    Checks if a list contains the given sublist contiguously.\n    An empty candidate list is considered a sublist of any container.\n    \"\"\"\n    len_container = len(container)\n    len_candidate = len(candidate)\n\n    if len_candidate == 0:\n        return True\n    if len_candidate > len_container:\n        return False\n\n    for i in range(len_container - len_candidate + 1):\n        if container[i : i + len_candidate] == candidate:\n            return True\n    return False"}
