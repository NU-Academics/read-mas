{"task_id": "Mbpp/71", "solution": "def comb_sort(data: list) -> list:\n    \"\"\"Sorts a list of elements using the Comb Sort algorithm.\n    Returns a new sorted list, leaving the original list unchanged.\n    \"\"\"\n    n = len(data)\n    arr = data.copy()\n    gap = n\n    swapped = True\n    shrink_factor = 1.3\n\n    while gap > 1 or swapped:\n        gap = int(gap / shrink_factor)\n        if gap < 1:\n            gap = 1\n\n        swapped = False\n        for i in range(0, n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    return arr"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(patterns: list, template: list) -> bool:\n    \"\"\"\n    Checks if two sequences follow the same pattern, enforcing a consistent one-to-one mapping.\n    \"\"\"\n    if len(patterns) != len(template):\n        return False\n\n    pattern_to_template_map = {}\n    template_to_pattern_map = {}\n\n    for p_item, t_item in zip(patterns, template):\n        if p_item not in pattern_to_template_map:\n            # If p_item is new, ensure t_item is also new or consistently mapped\n            if t_item in template_to_pattern_map:\n                # t_item is already mapped to a different p_item, violating one-to-one\n                return False\n            pattern_to_template_map[p_item] = t_item\n            template_to_pattern_map[t_item] = p_item\n        else:\n            # If p_item is seen before, ensure its mapping is consistent\n            if pattern_to_template_map[p_item] != t_item:\n                return False\n    return True"}
