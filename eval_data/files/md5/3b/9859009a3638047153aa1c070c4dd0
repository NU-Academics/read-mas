{"task_id": "Mbpp/283", "solution": "def validate(n: int) -> bool:\n    \"\"\"\n    Checks if the frequency of each digit in the integer is less than or equal to the digit itself.\n    The check is performed on the absolute value of the input integer.\n    \"\"\"\n    num_str = str(abs(n))\n    digit_counts = {}\n\n    for char_digit in num_str:\n        digit_counts[char_digit] = digit_counts.get(char_digit, 0) + 1\n\n    for char_digit, count in digit_counts.items():\n        digit_value = int(char_digit)\n        if count > digit_value:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/282", "solution": "def sub_list(a, b):\n    \"\"\"Subtracts two lists element-wise after internal validation and adaptation.\"\"\"\n\n    # Imports for type hints and optional numpy\n    import sys\n    from typing import Any, List, Sequence, Tuple\n\n    # 1. Define Custom Exceptions\n    class SublistError(Exception):\n        pass\n\n    class InvalidInputError(SublistError):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class LengthMismatchError(SublistError):\n        def __init__(self, expected: int, actual: int) -> None:\n            super().__init__(f\"Length mismatch: expected {expected}, got {actual}\")\n            self.expected = expected\n            self.actual = actual\n\n    # 2. Define ListAdapter\n    class ListAdapter:\n        \"\"\"Adapts various sequence types to a standard Python list.\"\"\"\n        def __init__(self) -> None:\n            try:\n                import numpy as _np\n                self._np = _np\n                self.supports_numpy = True\n            except ImportError:\n                self._np = None\n                self.supports_numpy = False\n\n        def to_list(self, seq: Any) -> List[Any]:\n            \"\"\"Converts the input sequence to a Python list.\"\"\"\n            if self.supports_numpy and isinstance(seq, self._np.ndarray):\n                return seq.tolist()\n            if isinstance(seq, (list, tuple)):\n                return list(seq)\n            if hasattr(seq, \"__iter__\"):\n                return list(seq)\n            raise InvalidInputError(\"Unsupported input type for conversion to list.\")\n\n    # 3. Define InputValidator\n    class InputValidator:\n        \"\"\"Validates input sequences for numeric content and equal lengths.\"\"\"\n        ALLOWED_NUMERIC_TYPES = (int, float)\n\n        def __init__(self) -> None:\n            pass\n\n        def validate_sequences(self, a: Any, b: Any) -> Tuple[List[float], List[float]]:\n            \"\"\"Validates two sequences, ensuring they are lists of numbers and have equal lengths.\"\"\"\n            if len(a) != len(b):\n                raise LengthMismatchError(expected=len(a), actual=len(b))\n            \n            normalized_a = []\n            for idx, val in enumerate(a):\n                if not self._is_number(val):\n                    raise InvalidInputError(f\"Element at index {idx} in 'a' is not numeric: {val}\")\n                normalized_a.append(float(val))\n\n            normalized_b = []\n            for idx, val in enumerate(b):\n                if not self._is_number(val):\n                    raise InvalidInputError(f\"Element at index {idx} in 'b' is not numeric: {val}\")\n                normalized_b.append(float(val))\n            \n            return normalized_a, normalized_b\n\n        def _is_number(self, value: Any) -> bool:\n            \"\"\"Checks if a value is an allowed numeric type.\"\"\"\n            return isinstance(value, self.ALLOWED_NUMERIC_TYPES)\n\n    # 4. Define SubtractorService\n    class SubtractorService:\n        \"\"\"Provides element-wise list subtraction with validation and adaptation.\"\"\"\n        def __init__(self, validator: InputValidator, adapter: ListAdapter) -> None:\n            self._validator = validator\n            self._adapter = adapter\n\n        def subtract(self, a: Sequence, b: Sequence) -> List[float]:\n            \"\"\"Subtracts two sequences element-wise after validation and adaptation.\"\"\"\n            a_list = self._adapter.to_list(a)\n            b_list = self._adapter.to_list(b)\n            \n            a_validated, b_validated = self._validator.validate_sequences(a_list, b_list)\n            \n            return self._compute(a_validated, b_validated)\n\n        def _compute(self, a_list: List[float], b_list: List[float]) -> List[float]:\n            \"\"\"Performs the actual element-wise subtraction.\"\"\"\n            return [ai - bi for ai, bi in zip(a_list, b_list)]\n\n    # 5. Initialize _default_service once using a function attribute for memoization\n    if not hasattr(sub_list, '_memoized_default_service'):\n        sub_list._memoized_default_service = SubtractorService(InputValidator(), ListAdapter())\n    \n    _default_service = sub_list._memoized_default_service\n\n    # Call the subtract method of the default service\n    return _default_service.subtract(a, b)"}
{"task_id": "Mbpp/286", "solution": "def max_sub_array_sum_repeated(arr: list[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in an array\n    formed by repeating the given array k times.\n    \"\"\"\n\n    def _kadane(data: list[int]) -> int:\n        \"\"\"Calculates the maximum subarray sum for a single array.\"\"\"\n        max_ending_here = data[0]\n        max_so_far = data[0]\n        for x in data[1:]:\n            max_ending_here = max(x, max_ending_here + x)\n            max_so_far = max(max_so_far, max_ending_here)\n        return max_so_far\n\n    def _prefix_max(data: list[int]) -> int:\n        \"\"\"Calculates the maximum sum of any prefix of the array.\"\"\"\n        current_sum = 0\n        max_prefix_sum = -float('inf')\n        for x in data:\n            current_sum += x\n            max_prefix_sum = max(max_prefix_sum, current_sum)\n        return max_prefix_sum\n\n    def _suffix_max(data: list[int]) -> int:\n        \"\"\"Calculates the maximum sum of any suffix of the array.\"\"\"\n        current_sum = 0\n        max_suffix_sum = -float('inf')\n        for x in reversed(data):\n            current_sum += x\n            max_suffix_sum = max(max_suffix_sum, current_sum)\n        return max_suffix_sum\n\n    def _max_for_two_concats(data: list[int]) -> int:\n        \"\"\"Runs Kadane's algorithm over two conceptual concatenations of the array.\"\"\"\n        length = len(data)\n        max_ending_here = data[0]\n        max_so_far = data[0]\n        for i in range(1, 2 * length):\n            x = data[i % length]\n            max_ending_here = max(x, max_ending_here + x)\n            max_so_far = max(max_so_far, max_ending_here)\n        return max_so_far\n\n    if k == 1:\n        return _kadane(arr)\n\n    total_sum = sum(arr)\n    best_two_concats_sum = _max_for_two_concats(arr)\n\n    if total_sum > 0 and k > 2:\n        max_prefix_sum = _prefix_max(arr)\n        max_suffix_sum = _suffix_max(arr)\n        # The sum might span across multiple full array repetitions.\n        return max(best_two_concats_sum, max_prefix_sum + max_suffix_sum + total_sum * (k - 2))\n    else:\n        # If total_sum is not positive, or k is small, full repetitions don't add value.\n        return best_two_concats_sum"}
