{"task_id": "Mbpp/141", "solution": "from typing import Any, Callable, Optional, List\n\ndef pancake_sort(items: List[Any], key: Optional[Callable[[Any], Any]] = None) -> List[Any]:\n    \"\"\"\n    Sorts a list of elements using the pancake sort algorithm.\n    Returns a new sorted list without modifying the original.\n    \"\"\"\n    arr = list(items)  # Create a mutable copy to perform in-place flips\n\n    def _find_max_index(arr_slice: List[Any], n: int, current_key: Optional[Callable[[Any], Any]]) -> int:\n        \"\"\"Finds the index of the maximum element in the prefix arr_slice[0:n].\"\"\"\n        transform = (lambda x: x) if current_key is None else current_key\n        max_idx = 0\n        for i in range(1, n):\n            if transform(arr_slice[i]) > transform(arr_slice[max_idx]):\n                max_idx = i\n        return max_idx\n\n    def _flip(arr_slice: List[Any], k: int) -> None:\n        \"\"\"Reverses the prefix arr_slice[0:k+1] in-place.\"\"\"\n        arr_slice[:k+1] = arr_slice[:k+1][::-1]\n\n    n = len(arr)\n    for curr_size in range(n, 1, -1):\n        # Find index of the maximum element in arr[0...curr_size-1]\n        max_idx = _find_max_index(arr, curr_size, key)\n\n        # If the maximum element is not already at its correct position\n        if max_idx != curr_size - 1:\n            # Move the maximum element to the beginning if it's not already there\n            if max_idx != 0:\n                _flip(arr, max_idx)\n            \n            # Move the maximum element to its correct position at the end of the current part\n            _flip(arr, curr_size - 1)\n\n    return arr"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a: int, b: int, n: int) -> Optional[tuple[int, int]]:\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple, or return None if no solution exists.\n    \"\"\"\n\n    class ExtendedGCD:\n        @staticmethod\n        def compute(a_val: int, b_val: int) -> tuple[int, int, int]:\n            \"\"\"\n            Computes (g, x, y) such that g is the greatest common divisor of a_val and b_val,\n            and a_val*x + b_val*y = g.\n            \"\"\"\n            old_r, r = abs(a_val), abs(b_val)\n            old_s, s = 1, 0\n            old_t, t = 0, 1\n\n            while r != 0:\n                q = old_r // r\n                old_r, r = r, old_r - q * r\n                old_s, s = s, old_s - q * s\n                old_t, t = t, old_t - q * t\n\n            # Adjust signs of x and y based on original a_val and b_val\n            x = old_s if a_val >= 0 else -old_s\n            y = old_t if b_val >= 0 else -old_t\n            return old_r, x, y\n\n    class SolutionDTO:\n        \"\"\"A simple data transfer object for solution (x, y).\"\"\"\n        def __init__(self, x: int, y: int) -> None:\n            self.x = x\n            self.y = y\n\n        def as_tuple(self) -> tuple[int, int]:\n            return (self.x, self.y)\n\n    class SolverService:\n        \"\"\"Orchestrates the solution finding logic.\"\"\"\n        def find_solution(self, a_val: int, b_val: int, n_val: int) -> Optional[SolutionDTO]:\n            # Compute gcd(a, b) and coefficients xg, yg for Bezout's identity\n            g, xg, yg = ExtendedGCD.compute(a_val, b_val)\n\n            # Handle the special case where a and b are both zero\n            if g == 0:  # This implies a_val=0 and b_val=0\n                return SolutionDTO(0, 0) if n_val == 0 else None\n\n            # A solution exists only if n is divisible by g\n            if n_val % g != 0:\n                return None\n\n            # Scale the Bezout coefficients to find a particular solution for n\n            multiplier = n_val // g\n            return SolutionDTO(xg * multiplier, yg * multiplier)\n\n    solver_service = SolverService()\n    result_dto = solver_service.find_solution(a, b, n)\n\n    return result_dto.as_tuple() if result_dto is not None else None"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(source, remove_list):\n    \"\"\"\n    Removes elements from `source` that are present in `remove_list`, preserving relative order.\n    Uses a set for efficient lookup if elements are hashable, otherwise falls back to linear comparison.\n    \"\"\"\n    result = []\n\n    # Attempt to convert remove_list to a set for O(1) average time complexity lookup.\n    # If conversion fails (due to unhashable elements), fall back to using the list directly.\n    remove_set = None\n    try:\n        remove_set = set(remove_list)\n    except TypeError:\n        pass  # remove_set remains None, indicating fallback is needed\n\n    if remove_set is not None:\n        # Use set for efficient membership testing\n        for item in source:\n            if item not in remove_set:\n                result.append(item)\n    else:\n        # Fallback to linear search for each item if elements are unhashable.\n        # This ensures the order of `source` elements is preserved.\n        remove_list_as_list = list(remove_list) # Convert to list for efficient multiple linear searches\n        for item_source in source:\n            found_in_remove = False\n            for item_remove in remove_list_as_list:\n                if item_source == item_remove:\n                    found_in_remove = True\n                    break\n            if not found_in_remove:\n                result.append(item_source)\n                \n    return result"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(text: str) -> int:\n    \"\"\"Counts characters in a string that match their 1-based alphabetical position (case-insensitive).\"\"\"\n\n    ALPHABET = \"abcdefghijklmnopqrstuvwxyz\"\n\n    class Alphabet:\n        def __init__(self, letters: str = ALPHABET) -> None:\n            self.letters = letters\n\n        def index_of(self, letter: str) -> int:\n            \"\"\"Returns the 1-based position of a letter in the alphabet, or 0 if not found.\"\"\"\n            try:\n                return self.letters.index(letter) + 1\n            except ValueError:\n                return 0\n\n    alpha = Alphabet()\n    count = 0\n    for idx, ch in enumerate(text.lower()):\n        if alpha.index_of(ch) == idx + 1:\n            count += 1\n    return count"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"Calculates the sum of the series n + (n-2) + (n-4) + ... until the term is <= 0 using a closed-form formula.\"\"\"\n    if n < 0:\n        return 0\n    # The number of terms in the series is floor(n/2) + 1.\n    # The last term is n % 2.\n    # This is an arithmetic progression sum: count * (first + last) / 2\n    term_count = n // 2 + 1\n    last_term = n % 2\n    return term_count * (n + last_term) // 2"}
{"task_id": "Mbpp/168", "solution": "from collections.abc import Iterable\nfrom typing import Any, List, Optional\n\nclass FrequencyError(Exception):\n    \"\"\"Base exception for frequency-related errors.\"\"\"\n    def __init__(self, message: str = \"\") -> None:\n        super().__init__(message)\n        self.message = message\n\nclass FrequencyValidationError(FrequencyError):\n    \"\"\"Exception for invalid input data.\"\"\"\n    pass\n\nclass RepositoryError(FrequencyError):\n    \"\"\"Exception for repository-related issues.\"\"\"\n    pass\n\ndef is_iterable(obj: Any) -> bool:\n    \"\"\"Checks if an object is iterable.\"\"\"\n    return isinstance(obj, Iterable)\n\ndef validate_list_input(list_: Any) -> None:\n    \"\"\"Validates the input list for being non-None and iterable.\"\"\"\n    if list_ is None:\n        raise FrequencyValidationError(\"Input list cannot be None\")\n    if not is_iterable(list_):\n        raise FrequencyValidationError(\"Input must be iterable\")\n\nclass IListRepository:\n    \"\"\"Interface for list data repositories.\"\"\"\n    def get_all(self) -> List[Any]:\n        raise NotImplementedError\n\nclass InMemoryListRepository(IListRepository):\n    \"\"\"An in-memory implementation of a list repository.\"\"\"\n    def __init__(self, initial: Optional[List[Any]] = None) -> None:\n        self._data = list(initial) if initial is not None else []\n\n    def get_all(self) -> List[Any]:\n        return list(self._data)\n\n    def set_data(self, data: List[Any]) -> None:\n        self._data = list(data)\n\nclass FrequencyService:\n    \"\"\"Service class encapsulating the core frequency counting logic.\"\"\"\n    def __init__(self, repository: Optional[IListRepository] = None) -> None:\n        self._repository = repository\n\n    def count_from_list(self, list_: List[Any], value: Any) -> int:\n        \"\"\"Counts occurrences of a value in a provided list.\"\"\"\n        validate_list_input(list_)\n        count = 0\n        try:\n            for el in list_:\n                if el == value:\n                    count += 1\n            return count\n        except FrequencyValidationError:\n            raise\n        except Exception as e:\n            raise FrequencyError(f\"Error while counting occurrences: {e}\") from e\n\n    def count_from_repository(self, value: Any) -> int:\n        \"\"\"Counts occurrences of a value using data from the configured repository.\"\"\"\n        if self._repository is None:\n            raise RepositoryError(\"No repository configured\")\n        try:\n            data = self._repository.get_all()\n            return self.count_from_list(data, value)\n        except RepositoryError:\n            raise\n        except Exception as e:\n            raise FrequencyError(f\"Repository error: {e}\") from e\n\ndef frequency(list_: List[Any], value: Any) -> int:\n    \"\"\"Counts the number of occurrences of a value in a given list.\"\"\"\n    repo = InMemoryListRepository(initial=list_)\n    service = FrequencyService(repository=repo)\n    return service.count_from_repository(value)"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(numbers: list[int]) -> int:\n    \"\"\"Counts pairs of integers in a list whose XOR is an even number.\"\"\"\n    n_even = 0\n    n_odd = 0\n\n    for n in numbers:\n        # A number's parity determines if its XOR with another number is even.\n        # XOR is even if both numbers have the same parity (both even or both odd).\n        # Check parity using bitwise AND with 1.\n        if (n & 1) == 0:  # n is even\n            n_even += 1\n        else:  # n is odd\n            n_odd += 1\n\n    # Calculate combinations: n_even choose 2 plus n_odd choose 2.\n    # The number of ways to choose 2 items from n is n * (n - 1) // 2.\n    even_even_pairs = n_even * (n_even - 1) // 2\n    odd_odd_pairs = n_odd * (n_odd - 1) // 2\n\n    return even_even_pairs + odd_odd_pairs"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n):\n    \"\"\"Finds the smallest power of 2 greater than or equal to n.\"\"\"\n    if n == 0:\n        return 1\n    # If n is already a power of two, return n.\n    if (n & (n - 1)) == 0:\n        return n\n    # Otherwise, return the next power of two using bit_length.\n    return 1 << n.bit_length()"}
{"task_id": "Mbpp/171", "solution": "import math\nfrom typing import Any\n\nclass InvalidSideLengthError(ValueError):\n    \"\"\"Custom exception for invalid side length values.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass SideValidator:\n    \"\"\"Validates the input for a pentagon's side length.\"\"\"\n    def validate(self, side_length: Any) -> float:\n        try:\n            value = float(side_length)\n        except (TypeError, ValueError) as exc:\n            raise TypeError(\"Side length must be numeric\") from exc\n        if not math.isfinite(value) or value <= 0.0:\n            raise InvalidSideLengthError(\"Side length must be a positive finite number\")\n        return value\n\nclass Pentagon:\n    \"\"\"Represents a regular pentagon and can compute its perimeter.\"\"\"\n    def __init__(self, side_length: float) -> None:\n        self._side_length = side_length\n\n    @property\n    def side_length(self) -> float:\n        return self._side_length\n\n    def compute_perimeter(self) -> float:\n        return 5.0 * self._side_length\n\nclass PerimeterService:\n    \"\"\"Orchestrates validation and perimeter calculation.\"\"\"\n    def __init__(self, validator: SideValidator) -> None:\n        self._validator = validator\n\n    def calculate(self, side_length: float) -> float:\n        valid_side = self._validator.validate(side_length)\n        pent = Pentagon(valid_side)\n        result = pent.compute_perimeter()\n        return float(result)\n\ndef perimeter_pentagon(side_length: float) -> float:\n    \"\"\"Calculates the perimeter of a regular pentagon given its side length.\"\"\"\n    validator = SideValidator()\n    service = PerimeterService(validator)\n    return service.calculate(side_length)"}
{"task_id": "Mbpp/170", "solution": "import typing\n\ndef sum_range_list(nums: typing.Sequence[typing.Union[int, float]], start: int, end: int) -> typing.Union[int, float]:\n    \"\"\"Calculates the sum of numbers in a list within a specified range (inclusive).\n    It ensures index validity and numeric types of elements as per design requirements.\"\"\"\n\n    Number = typing.Union[int, float]\n\n    class SumRangeError(Exception):\n        \"\"\"Domain-specific error for sum range operations.\n        Carries a descriptive message for the error encountered.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class RangeValidator:\n        \"\"\"Validates and normalizes start and end indices against a sequence's length.\n        Also provides a utility to check if a value is numeric.\"\"\"\n        def normalize_and_validate(self, start: int, end: int, length: int) -> typing.Tuple[int, int]:\n            \"\"\"Normalizes negative indices and validates bounds and order of indices.\n            Raises SumRangeError for invalid inputs or out-of-bounds access.\"\"\"\n            if not isinstance(start, int) or not isinstance(end, int):\n                raise SumRangeError(\"Indices 'start' and 'end' must be integers.\")\n\n            norm_start = start + length if start < 0 else start\n            norm_end = end + length if end < 0 else end\n\n            if not (0 <= norm_start < length and 0 <= norm_end < length):\n                raise SumRangeError(\n                    f\"Indices {start} and {end} (normalized to {norm_start} and {norm_end}) are out of bounds for sequence of length {length}.\"\n                )\n            if norm_start > norm_end:\n                raise SumRangeError(\n                    f\"Start index {start} (normalized to {norm_start}) cannot be greater than end index {end} (normalized to {norm_end}).\"\n                )\n\n            return norm_start, norm_end\n\n        def is_numeric(self, value: typing.Any) -> bool:\n            \"\"\"Checks if a value is an integer or float, explicitly excluding booleans.\"\"\"\n            return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n    class ListRepository:\n        \"\"\"Manages access to the underlying numeric sequence.\n        Provides its length and a method to retrieve a validated slice.\"\"\"\n        def __init__(self, nums: typing.Sequence[Number]) -> None:\n            self._nums = nums\n            self._validator = RangeValidator()\n\n        def length(self) -> int:\n            \"\"\"Returns the total number of elements in the sequence.\"\"\"\n            return len(self._nums)\n\n        def get_slice(self, start: int, end: int) -> typing.List[Number]:\n            \"\"\"Extracts and returns a list of elements from `start` to `end` (inclusive).\n            It validates that each element within the slice is numeric.\"\"\"\n            result_slice: typing.List[Number] = []\n            for i in range(start, end + 1):\n                if i < 0 or i >= len(self._nums):\n                    raise SumRangeError(\"Internal error: Index out of bounds during slice retrieval.\")\n                \n                element = self._nums[i]\n                if not self._validator.is_numeric(element):\n                    raise SumRangeError(f\"Non-numeric element found at index {i}: {element}\")\n                result_slice.append(typing.cast(Number, element))\n            return result_slice\n\n    class SumService:\n        \"\"\"Encapsulates the core business logic for calculating sums.\n        It orchestrates validation and data retrieval using its dependencies.\"\"\"\n        def __init__(self, repo_factory: typing.Callable[[typing.Sequence[Number]], 'ListRepository'] = ListRepository) -> None:\n            self._repo_factory = repo_factory\n            self._validator = RangeValidator()\n\n        def sum_range(self, nums: typing.Sequence[Number], start: int, end: int) -> Number:\n            \"\"\"Computes the sum of elements within the specified inclusive range of the input sequence.\n            It performs index validation and ensures all summed elements are numeric.\"\"\"\n            repo = self._repo_factory(nums)\n            length = repo.length()\n            \n            norm_start, norm_end = self._validator.normalize_and_validate(start, end, length)\n            elements = repo.get_slice(norm_start, norm_end)\n\n            total: Number = 0\n            for v in elements:\n                total += v\n            return total\n\n    class SumController:\n        \"\"\"Serves as the public API facade for the sum range functionality.\n        It delegates the actual computation to the SumService.\"\"\"\n        def __init__(self, service: SumService = None) -> None:\n            self._service = service or SumService()\n\n        def sum_range_list(self, nums: typing.Sequence[Number], start: int, end: int) -> Number:\n            \"\"\"Public method to calculate the sum of numbers in a list within an inclusive range.\"\"\"\n            return self._service.sum_range(nums, start, end)\n\n    # Instantiate the controller and invoke the primary method to get the result.\n    controller = SumController()\n    return controller.sum_range_list(nums, start, end)"}
{"task_id": "Mbpp/223", "solution": "def is_majority(array: list, n: int, element: int) -> bool:\n    \"\"\"\n    Checks if an element is the majority element in a sorted array.\n    A majority element occurs more than n/2 times.\n    \"\"\"\n    n = len(array)\n\n    if n == 0:\n        return False\n\n    low, high = 0, n - 1\n    first_occurrence_idx = -1\n\n    # Binary search to find the first occurrence of the element\n    while low <= high:\n        mid = (low + high) // 2\n        if array[mid] == element:\n            first_occurrence_idx = mid\n            high = mid - 1\n        elif array[mid] < element:\n            low = mid + 1\n        else:\n            high = mid - 1\n\n    # If the element is not found, it cannot be a majority element\n    if first_occurrence_idx == -1:\n        return False\n\n    # Check if the element at first_occurrence_idx + n // 2 is also the element.\n    # This implies there are at least (n // 2 + 1) occurrences.\n    majority_check_idx = first_occurrence_idx + n // 2\n\n    return majority_check_idx < n and array[majority_check_idx] == element"}
