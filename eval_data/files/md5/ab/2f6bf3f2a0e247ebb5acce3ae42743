{"task_id": "HumanEval/158", "solution": "def find_max(words: list[str]) -> str:\n    \"\"\"Finds the word with the maximum number of unique characters, applying lexicographical tie-breaking for words with equal unique character counts.\n    Assumes a non-empty list of strings as input and returns the best matching word.\"\"\"\n    if not words:\n        # Input list 'words' is expected to be non-empty as per problem examples.\n        # A ValueError is raised for an empty list to indicate invalid input.\n        raise ValueError(\"Input list 'words' cannot be empty.\")\n\n    # Initialize with the first word in the list.\n    result_word = words[0]\n    max_unique_count = len(set(words[0]))\n\n    # Iterate through the rest of the words starting from the second element.\n    for i in range(1, len(words)):\n        current_word = words[i]\n        current_unique_count = len(set(current_word))\n\n        if current_unique_count > max_unique_count:\n            # Found a new word with strictly more unique characters.\n            max_unique_count = current_unique_count\n            result_word = current_word\n        elif current_unique_count == max_unique_count:\n            # Same number of unique characters, apply lexicographical tie-breaking.\n            if current_word < result_word:\n                # Current_word comes first alphabetically.\n                result_word = current_word\n    \n    return result_word"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten and remaining after a rabbit's meal.\n    The rabbit eats as many carrots as needed, or all remaining if not enough.\n    \"\"\"\n    \n    # Determine how many carrots the rabbit actually eats from the stock.\n    carrots_eaten_from_stock = min(need, remaining)\n    \n    # Calculate the total carrots eaten and the carrots left in stock.\n    total_eaten_carrots = number + carrots_eaten_from_stock\n    carrots_left = remaining - carrots_eaten_from_stock\n    \n    return [total_eaten_carrots, carrots_left]"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Builds and evaluates an algebraic expression from a list of operators and operands.\n    Python's eval() function handles operator precedence correctly.\n    \"\"\"\n    expression_str = str(operand[0])\n\n    for i in range(len(operator)):\n        expression_str += operator[i]\n        expression_str += str(operand[i+1])\n\n    return eval(expression_str)"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Processes a string: reverses case for letters if present, otherwise reverses the whole string.\n    Returns the modified string based on the rules.\n    \"\"\"\n    \n    # First, check if the string contains any letters.\n    # Iterate through the string and use the isalpha() method.\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n            \n    # If the string contains letters, apply the case-reversal rule.\n    if has_letters:\n        modified_chars = []\n        for char in s:\n            if char.isalpha():\n                # If it's a letter, reverse its case.\n                if char.islower():\n                    modified_chars.append(char.upper())\n                else: \n                    modified_chars.append(char.lower())\n            else:\n                # If it's not a letter, keep it as is.\n                modified_chars.append(char)\n        return \"\".join(modified_chars)\n    # If the string contains no letters, reverse the entire string.\n    else:\n        return s[::-1]"}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text: str) -> str | None:\n    \"\"\"Computes the MD5 hash of a given string. Returns None for an empty string.\"\"\"\n    if not text:\n        return None\n\n    encoded_text = text.encode('utf-8')\n    m = hashlib.md5()\n    m.update(encoded_text)\n    return m.hexdigest()"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    lower_bound = min(a, b)\n    upper_bound = max(a, b)\n\n    all_even_digits = [0, 2, 4, 6, 8]\n\n    result = []\n\n    for digit in all_even_digits:\n        if lower_bound <= digit <= upper_bound:\n            result.append(digit)\n\n    return result"}
