{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l: list[int]) -> bool:\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    # Use a set to store numbers encountered so far.\n    # This allows for O(1) average time complexity for lookups and insertions,\n    # making the overall algorithm more efficient than a brute-force O(n^2) approach.\n    seen_numbers = set()\n\n    for num in l:\n        # For each number, calculate its \"complement\" needed to sum to zero.\n        # If the current number is 'x', we are looking for '-x'.\n        complement = -num\n\n        # Check if this complement has already been seen in the list.\n        # If found, we have a pair of distinct elements that sum to zero.\n        if complement in seen_numbers:\n            return True\n\n        # If the complement is not found, add the current number to the set\n        # for future comparisons. This ensures that if its complement appears\n        # later in the list, we can identify the pair.\n        seen_numbers.add(num)\n\n    # If the loop completes without finding any such pair, return False.\n    return False"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int) -> str:\n    \"\"\"Change numerical base of input number x to base.\n    Return string representation after the conversion.\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    digits = []\n    while x > 0:\n        remainder = x % base\n        digits.append(str(remainder))\n        x //= base\n\n    return \"\".join(digits[::-1])"}
