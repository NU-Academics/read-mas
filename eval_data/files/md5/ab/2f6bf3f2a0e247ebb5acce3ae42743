{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\n        return []\n\n    # Collect elements from 'l' at indices divisible by three, storing their values and original positions.\n    third_elements = []\n    third_indices = []\n\n    for i in range(len(l)):\n        if i % 3 == 0:\n            third_elements.append(l[i])\n            third_indices.append(i)\n\n    # Sort the collected elements.\n    third_elements.sort()\n\n    # Create a copy of the original list. Elements at other indices will remain unchanged.\n    result_list = list(l)\n\n    # Replace elements in the result list at the stored 'third_indices' with their sorted counterparts.\n    for j in range(len(third_indices)):\n        original_index = third_indices[j]\n        sorted_value = third_elements[j]\n        result_list[original_index] = sorted_value\n    \n    return result_list"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list):\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    # Convert the list to a set to get unique elements.\n    # Sets inherently do not allow duplicate elements.\n    unique_elements_set = set(l)\n\n    # Convert the set back to a list.\n    unique_elements_list = list(unique_elements_set)\n\n    # Sort the list of unique elements.\n    unique_elements_list.sort()\n\n    return unique_elements_list"}
{"task_id": "HumanEval/35", "solution": "def max_element(l: list) -> int:\n    \"\"\"\n    Identifies and returns the largest integer element from a given input list l.\n    Handles empty lists by raising a ValueError.\n    \"\"\"\n    if not l:\n        raise ValueError(\"max_element() arg is an empty sequence\")\n\n    current_max = l[0]\n    for element in l[1:]:\n        if element > current_max:\n            current_max = element\n            \n    return current_max"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int) -> int:\n    \"\"\"Calculates the total occurrences of the digit '7' in numbers less than n,\n    which are divisible by 11 or 13.\n    \"\"\"\n    total_sevens_count = 0\n\n    for i in range(1, n):\n        if i % 11 == 0 or i % 13 == 0:\n            s_i = str(i)\n            total_sevens_count += s_i.count('7')\n\n    return total_sevens_count"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\"\"\"\n    if not l:\n        return []\n\n    # Extract elements at even indices.\n    even_elements = []\n    for i in range(len(l)):\n        if i % 2 == 0:\n            even_elements.append(l[i])\n\n    # Sort the extracted even elements.\n    even_elements.sort()\n\n    # Create the result list with initial placeholders.\n    result = [None] * len(l)\n    \n    # Use a pointer for the sorted even elements.\n    sorted_even_ptr = 0\n\n    # Populate the result list based on the original and sorted even elements.\n    for i in range(len(l)):\n        if i % 2 == 0:\n            result[i] = even_elements[sorted_even_ptr]\n            sorted_even_ptr += 1\n        else:\n            result[i] = l[i]\n\n    return result"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str) -> str:\n    \"\"\"\n    Decodes a string that was encoded using the `encode_cyclic` method by reversing cyclic shifts.\n    Groups of three characters are reverse-shifted ('e0 e1 e2' becomes 'e2 e0 e1'), while shorter groups remain unchanged.\n    \"\"\"\n    decoded_parts = []\n    n = len(s)\n\n    for i in range(0, n, 3):\n        chunk = s[i : i + 3]\n        if len(chunk) == 3:\n            # Apply the reverse cyclic shift: 'e0 e1 e2' becomes 'e2 e0 e1'\n            decoded_chunk = chunk[2] + chunk[0] + chunk[1]\n            decoded_parts.append(decoded_chunk)\n        else:\n            # Chunks with fewer than 3 characters were not modified during encoding.\n            decoded_parts.append(chunk)\n\n    return \"\".join(decoded_parts)"}
{"task_id": "HumanEval/39", "solution": "import math\ndef is_prime(num: int) -> bool:\n    \"\"\"\n    Checks if a number is prime.\n    Efficiently checks for primality by testing divisibility only up to its square root.\n    \"\"\"\n    if num < 2:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    # Checks for odd divisors from 3 up to the square root of num.\n    for i in range(3, int(math.sqrt(num)) + 1, 2):\n        if num % i == 0:\n            return False\n    return True\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    The sequence starts with F_0=0, F_1=1, and generates subsequent Fibonacci numbers until the n-th prime Fibonacci is found.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input n must be a positive integer.\")\n\n    count = 0\n    current_fib = 0\n    next_fib = 1\n\n    while True:\n        current_fib, next_fib = next_fib, current_fib + next_fib\n\n        if current_fib > 1:\n            if is_prime(current_fib):\n                count += 1\n                if count == n:\n                    return current_fib"}
