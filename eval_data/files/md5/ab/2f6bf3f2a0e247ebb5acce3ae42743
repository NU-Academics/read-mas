{"task_id": "HumanEval/54", "solution": "import collections\ndef same_chars(s0: str, s1: str) -> bool:\n    \"\"\"\n    Check if two words have the same characters.\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddeddabc')\n    True\n    >>> same_chars('abcd', 'dddddddabc')\n    True\n    >>> same_chars('dddddddabc', 'abcd')\n    True\n    >>> same_chars('eabcd', 'dddddddabc')\n    False\n    >>> same_chars('abcd', 'dddddddabce')\n    False\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddddabc')\n    False\n    \"\"\"\n    if len(s0) != len(s1):\n        return False\n    return collections.Counter(s0) == collections.Counter(s1)"}
{"task_id": "HumanEval/55", "solution": "def fib(n: int) -> int:\n    \"\"\"Return n-th Fibonacci number using an iterative approach.\n    Handles base cases for n <= 1 and iterates for n > 1.\n    \"\"\"\n    if n <= 0:\n        return 0\n    elif n == 1:\n        return 1\n    \n    a, b = 0, 1\n    \n    for _ in range(2, n + 1):\n        next_fib = a + b\n        a = b\n        b = next_fib\n        \n    return b"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for bracket in brackets:\n        if bracket == '<':\n            balance += 1\n        elif bracket == '>':\n            balance -= 1\n        \n        # If balance drops below zero, a closing bracket appeared without a corresponding opening bracket.\n        if balance < 0:\n            return False\n            \n    # After checking all brackets, balance must be zero for correct matching.\n    return balance == 0"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list) -> bool:\n    \"\"\"\n    Checks if a list of elements is monotonically increasing or decreasing.\n    A list is monotonic if it is either entirely non-decreasing or entirely non-increasing.\n    \"\"\"\n    n = len(l)\n\n    # An empty list or a list with one element is always monotonic.\n    if n <= 1:\n        return True\n\n    is_non_decreasing = True\n    for i in range(n - 1):\n        if l[i] > l[i+1]:\n            is_non_decreasing = False\n            break\n\n    is_non_increasing = True\n    for i in range(n - 1):\n        if l[i] < l[i+1]:\n            is_non_increasing = False\n            break\n\n    # The list is monotonic if it is either non-decreasing or non-increasing.\n    return is_non_decreasing or is_non_increasing"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list) -> list:\n    \"\"\"\n    Finds unique common elements between two lists and returns them sorted.\n    This function converts lists to sets, finds their intersection, and then sorts the result.\n    \"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n\n    common_elements_set = set1 & set2\n\n    result_list = sorted(list(common_elements_set))\n\n    return result_list"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int) -> int:\n    \"\"\"\n    Finds the largest prime factor of a given integer n using trial division.\n    Handles n > 1 and n not being a prime number as per design.\n    \"\"\"\n    largest_prime = 1\n    current_n = n\n\n    # Handle factor 2\n    while current_n % 2 == 0:\n        largest_prime = 2\n        current_n //= 2\n\n    # Handle odd factors starting from 3\n    i = 3\n    while i * i <= current_n:\n        while current_n % i == 0:\n            largest_prime = i\n            current_n //= i\n        i += 2\n\n    # If current_n is still greater than 1, it must be the largest prime factor\n    if current_n > 1:\n        largest_prime = current_n\n\n    return largest_prime"}
