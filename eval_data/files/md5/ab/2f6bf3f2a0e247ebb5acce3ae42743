{"task_id": "HumanEval/24", "solution": "import math\ndef largest_divisor(n: int) -> int:\n    \"\"\"Finds the largest divisor of n that is strictly less than n.\n    Raises ValueError if n is 1 or less.\"\"\"\n    if n <= 1:\n        raise ValueError(\"n must be an integer greater than 1 to have a divisor strictly smaller than n.\")\n\n    # Iterate from 2 up to the square root of n to find the smallest factor.\n    for i in range(2, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            # If a factor 'i' is found, 'n // i' is the largest divisor.\n            return n // i\n    \n    # If no factors were found, n must be prime, so its largest divisor is 1.\n    return 1"}
{"task_id": "HumanEval/25", "solution": "from typing import List\ndef factorize(n: int) -> List[int]:\n    \"\"\"Return list of prime factors of given integer in the order from smallest to largest.\n    Each factor is listed as many times as it appears in the factorization.\"\"\"\n    factors = []\n\n    # Handle non-positive integers, as prime factorization is usually defined for positive integers > 1.\n    if n <= 1:\n        return []\n\n    # Handle factors of 2.\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    # Handle odd factors.\n    d = 3\n    while d * d <= n:\n        while n % d == 0:\n            factors.append(d)\n            n //= d\n        d += 2\n\n    # If n is still greater than 1, it means the remaining n is a prime number itself.\n    if n > 1:\n        factors.append(n)\n\n    return factors"}
{"task_id": "HumanEval/26", "solution": "from typing import List\nfrom collections import Counter\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\"Remove elements that occur more than once from a list of integers.\n    The order of the remaining elements is preserved.\n    \"\"\"\n    counts = Counter(numbers)\n    result = []\n    for number in numbers:\n        if counts[number] == 1:\n            result.append(number)\n    return result"}
{"task_id": "HumanEval/27", "solution": "def flip_case(text: str) -> str:\n    \"\"\"\n    Flips the case of alphabetic characters in a given string.\n    Lowercase letters become uppercase, and uppercase letters become lowercase.\n    \"\"\"\n    flipped_chars = []\n    for char in text:\n        if char.islower():\n            flipped_chars.append(char.upper())\n        elif char.isupper():\n            flipped_chars.append(char.lower())\n        else:\n            flipped_chars.append(char)\n    return \"\".join(flipped_chars)"}
