{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if concatenating the two input strings in either order results in a balanced parentheses string.\n    Returns 'Yes' if a balanced string can be formed, otherwise returns 'No'.\n    \"\"\"\n\n    def is_balanced(s: str) -> bool:\n        \"\"\"\n        Helper function to determine if a string of parentheses is balanced.\n        It ensures the running balance never drops below zero and the final balance is zero.\n        \"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    s1 = lst[0]\n    s2 = lst[1]\n\n    if is_balanced(s1 + s2):\n        return 'Yes'\n\n    if is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'"}
{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list \n    of length k with the maximum k numbers in arr.\n\n    Example 1:\n\n        Input: arr = [-3, -4, 5], k = 3\n        Output: [-4, -3, 5]\n\n    Example 2:\n\n        Input: arr = [4, -4, 4], k = 2\n        Output: [4, 4]\n\n    Example 3:\n\n        Input: arr = [-3, 2, 1, 2, -1, -2, 1], k = 1\n        Output: [2]\n\n    Note:\n        1. The length of the array will be in the range of [1, 1000].\n        2. The elements in the array will be in the range of [-1000, 1000].\n        3. 0 <= k <= len(arr)\n    \"\"\"\n    # If k is 0, return an empty list as no numbers are required.\n    if k == 0:\n        return []\n\n    # Sort the array in ascending order in-place.\n    arr.sort()\n\n    # Return the last k elements, which are the k maximum numbers and already sorted.\n    return arr[-k:]"}
{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    \"\"\"\n    total_sum = 0\n    # Iterate through the list using enumerate to get both the index and the value.\n    for index, value in enumerate(lst):\n        # Check if the current position (index) is even (0-based).\n        if index % 2 == 0:\n            # If the position is even, then check if the element (value) itself is odd.\n            if value % 2 != 0:\n                total_sum += value\n    return total_sum"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    total_sum = 0\n\n    # Iterate through the first k elements of the array.\n    for i in range(k):\n        num = arr[i]\n\n        # Check if the current number has at most two digits (absolute value <= 99).\n        if abs(num) <= 99:\n            total_sum += num\n            \n    return total_sum"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n: int) -> list[int]:\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    This function collects all unique odd numbers encountered during the Collatz sequence and returns them sorted.\n    \"\"\"\n    \n    # Use a set to store odd numbers to automatically handle uniqueness.\n    odd_numbers = set()\n    current_n = n\n\n    while True:\n        # Check if the current number is odd and add it to the set.\n        if current_n % 2 != 0:\n            odd_numbers.add(current_n)\n        \n        # If the sequence has reached 1, we stop.\n        if current_n == 1:\n            break\n        \n        # Apply the Collatz rule to get the next term.\n        if current_n % 2 == 0:  # If current_n is even\n            current_n = current_n // 2\n        else:  # If current_n is odd\n            current_n = 3 * current_n + 1\n            \n    # Convert the set of unique odd numbers to a list and sort it in increasing order.\n    result = sorted(list(odd_numbers))\n    \n    return result"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"Validates a date string against specific rules and format.\n    Returns True if the date is valid, otherwise False.\"\"\"\n    # Rule 1: The date string is not empty.\n    if not date:\n        return False\n\n    # Rule 4: The date should be in the format: mm-dd-yyyy\n    parts = date.split('-')\n    if len(parts) != 3:\n        return False\n\n    month_str, day_str, year_str = parts\n\n    # Check length of each part for correct format (e.g., '0' instead of '00' is invalid)\n    if not (len(month_str) == 2 and len(day_str) == 2 and len(year_str) == 4):\n        return False\n\n    try:\n        month = int(month_str)\n        day = int(day_str)\n        year = int(year_str)\n    except ValueError:\n        # If any part cannot be converted to an integer, it's an invalid format.\n        return False\n\n    # Rule 3: The months should not be less than 1 or higher than 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # Rule 2: Validate days based on month and leap year.\n    # Months with 31 days\n    if month in [1, 3, 5, 7, 8, 10, 12]:\n        if not (1 <= day <= 31):\n            return False\n    # Months with 30 days\n    elif month in [4, 6, 9, 11]:\n        if not (1 <= day <= 30):\n            return False\n    # February (month 2)\n    elif month == 2:\n        # Check for leap year\n        is_leap_year = (year % 4 == 0 and (year % 100 != 0 or year % 400 == 0))\n        if is_leap_year:\n            if not (1 <= day <= 29):\n                return False\n        else:\n            if not (1 <= day <= 28):\\\n                return False\n    # This 'else' block should not be reached if Rule 3 is handled, but included for robustness.\n    else:\n        return False \n\n    # If all rules are satisfied\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    # If any whitespace is present, split the text by whitespace.\n    if any(c.isspace() for c in txt):\n        return txt.split()\n\n    # If no whitespace, check for commas and split by them.\n    if ',' in txt:\n        return txt.split(',')\n\n    # If neither, count lowercase letters with an odd alphabetical order (0-indexed).\n    count = 0\n    ord_a = ord('a')\n    for char in txt:\n        if 'a' <= char <= 'z':\n            if (ord(char) - ord_a) % 2 != 0:\n                count += 1\n    return count"}
{"task_id": "HumanEval/126", "solution": "import collections\ndef is_sorted(lst):\n    \"\"\"\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False.\n    \"\"\"\n    # Handle empty or single-element lists, which are trivially sorted and valid.\n    if len(lst) <= 1:\n        return True\n\n    # Use a defaultdict to efficiently count occurrences of each number.\n    counts = collections.defaultdict(int)\n\n    # Iterate through the list to check both conditions in a single pass.\n    for i, num in enumerate(lst):\n        # Check ascending order by comparing current with previous element.\n        if i > 0 and lst[i] < lst[i-1]:\n            return False\n        \n        # Increment count for the current number and check for excessive duplicates.\n        counts[num] += 1\n        if counts[num] > 2:\n            return False\n            \n    return True"}
