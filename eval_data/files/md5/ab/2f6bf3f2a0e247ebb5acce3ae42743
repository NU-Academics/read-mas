{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes of integers multiplied by the product of their signs (1, -1, or 0).\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_magnitudes = 0\n    product_signs = 1\n\n    for x in arr:\n        # Calculate sum of magnitudes\n        sum_magnitudes += abs(x)\n\n        # Update product of signs\n        if x == 0:\n            # If any number is 0, the product of signs becomes 0\n            # and will remain 0, so we can set it and continue.\n            product_signs = 0\n        elif x < 0:\n            # If the number is negative, flip the sign of product_signs\n            product_signs *= -1\n        # If x > 0, product_signs remains unchanged (effectively multiplied by 1)\n\n    return sum_magnitudes * product_signs"}
{"task_id": "HumanEval/129", "solution": "class Path:\n    \"\"\"Represents a path as a tuple of cell values for lexicographical comparison.\"\"\"\n    def __init__(self, values_tuple):\n        self.values = values_tuple\n\n    def __lt__(self, other):\n        return self.values < other.values\n\n    def __gt__(self, other):\n        return self.values > other.values\n\n    def __eq__(self, other):\n        return self.values == other.values\ndef minPath(grid: list[list[int]], k: int) -> list[int]:\n    N = len(grid)\n\n    # INF_VAL is greater than any possible grid value, used for \"infinity\" paths.\n    INF_VAL = N * N + 1 \n\n    # dp[r][c] stores the best path of current length ending at (r, c).\n    min_paths = [[None for _ in range(N)] for _ in range(N)]\n\n    # Initialize for length L = 1 with paths containing a single cell's value.\n    for r in range(N):\n        for c in range(N):\n            min_paths[r][c] = Path((grid[r][c],))\n\n    # Define possible moves: up, down, left, right.\n    dr = [-1, 1, 0, 0]\n    dc = [0, 0, -1, 1]\n\n    # Iterate for path lengths from 2 up to k.\n    for current_len in range(2, k + 1):\n        # next_min_paths will store paths of length 'current_len'.\n        next_min_paths = [[Path((INF_VAL,) * current_len) for _ in range(N)] for _ in range(N)]\n\n        for r in range(N):\n            for c in range(N):\n                current_cell_value = grid[r][c]\n                \n                # Initialize best_path_for_rc for this cell at current_len.\n                best_path_for_rc = Path((INF_VAL,) * current_len)\n\n                # Consider all four neighbors (pr, pc) as the previous cell.\n                for i in range(4):\n                    pr, pc = r + dr[i], c + dc[i]\n\n                    # Check if the previous cell is within grid boundaries.\n                    if 0 <= pr < N and 0 <= pc < N:\n                        prev_path = min_paths[pr][pc]\n\n                        # If prev_path is a valid path (not an infinity path).\n                        if prev_path.values[0] != INF_VAL:\n                            candidate_values = prev_path.values + (current_cell_value,)\n                            candidate_path = Path(candidate_values)\n\n                            # Update best_path_for_rc if the candidate is lexicographically smaller.\n                            if candidate_path < best_path_for_rc:\n                                best_path_for_rc = candidate_path\n                \n                # Store the best path found for (r, c) of current_len.\n                next_min_paths[r][c] = best_path_for_rc\n\n        min_paths = next_min_paths # Update min_paths for the next length iteration.\n\n    # After iterating for all lengths, find the overall minimum path among all\n    # paths of length k ending at any cell.\n    final_best_path = Path((INF_VAL,) * k)\n\n    for r in range(N):\n        for c in range(N):\n            path_ending_at_rc = min_paths[r][c]\n            # If the path is a valid one (not an infinity path) and is smaller.\n            if path_ending_at_rc.values[0] != INF_VAL and path_ending_at_rc < final_best_path:\n                final_best_path = path_ending_at_rc\n    \n    # Return the values of the final best path as a list.\n    return list(final_best_path.values)"}
{"task_id": "HumanEval/130", "solution": "def tri(n: int) -> list[int]:\n    \"\"\"Calculates the first n + 1 numbers of a modified Tribonacci sequence.\n    It uses specific recurrence relations for even and odd indices, and inferred base values.\"\"\"\n\n    if n == 0:\n        return [1]\n\n    sequence = [0] * (n + 1)\n    sequence[0] = 1\n    sequence[1] = 3\n\n    for i in range(2, n + 1):\n        if i % 2 == 0:\n            sequence[i] = 1 + i // 2\n        else:\n            sequence[i] = sequence[i - 1] + sequence[i - 2] + (1 + (i + 1) // 2)\n            \n    return sequence"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Returns the product of the odd digits in a positive integer n.\n    Returns 0 if all digits are even.\n    \"\"\"\n    product_of_odd_digits = 1\n    found_odd_digit = False\n\n    # Iterate through the digits of n\n    while n > 0:\n        digit = n % 10  # Get the last digit\n        if digit % 2 != 0:  # Check if the digit is odd\n            product_of_odd_digits *= digit\n            found_odd_digit = True\n        n //= 10  # Remove the last digit\n\n    # If no odd digits were found, return 0\n    if not found_odd_digit:\n        return 0\n    else:\n        return product_of_odd_digits"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string: str) -> bool:\n    \"\"\"\n    Determines if a string contains a contiguous substring that is a valid bracket sequence\n    with a nesting depth greater than 1 (e.g., '[[[]]]' but not '[]' or '[][').\n    \"\"\"\n    n = len(string)\n\n    for i in range(n):\n        for j in range(i + 1, n + 1):\n            sub = string[i:j]\n            balance = 0\n            max_depth = 0\n            is_valid_candidate = True\n\n            for char in sub:\n                if char == '[':\n                    balance += 1\n                    max_depth = max(max_depth, balance)\n                elif char == ']':\n                    balance -= 1\n                if balance < 0:\n                    is_valid_candidate = False\n                    break\n            \n            if is_valid_candidate and balance == 0 and max_depth > 1:\n                return True\n                \n    return False"}
{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"Given a list of numbers, return the sum of squared numbers after\n    rounding each element to its ceiling.\"\"\"\n    total_sum_of_squares = 0\n    for num in lst:\n        ceiled_num = math.ceil(num)\n        squared_num = ceiled_num ** 2\n        total_sum_of_squares += squared_num\n    return total_sum_of_squares"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"Checks if the last character is an isolated alphabetical letter, not part of a word.\"\"\"\n    \n    # Return False if the string is empty, as there's no last character.\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    # Return False if the last character is not an alphabetical character.\n    if not last_char.isalpha():\n        return False\n\n    # Check if the letter is isolated, meaning it's not part of a preceding word.\n    # This occurs if it's the only character or if the character before it is a space.\n    if len(txt) == 1 or txt[-2] == ' ':\n        return True\n    else:\n        # The last character is a letter but is directly preceded by another non-space character.\n        return False"}
