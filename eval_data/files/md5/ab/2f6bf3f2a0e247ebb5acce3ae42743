{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers\n    Example\n    is_equal_to_sum_even(4) == False\n    is_equal_to_sum_even(6) == False\n    is_equal_to_sum_even(8) == True\n    \"\"\"\n    # n must be at least 8 to be the sum of 4 positive even numbers (minimum is 2+2+2+2).\n    if n < 8:\n        return False\n\n    # The sum of 4 even numbers must itself be an even number.\n    if n % 2 != 0:\n        return False\n\n    # If n is even and >= 8, it can always be expressed as 2 + 2 + 2 + (n-6).\n    return True"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n: int) -> int:\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    if n <= 0:\n        # As per the problem description, n is always > 0.\n        # This guard is for robustness if called with invalid input.\n        raise ValueError(\"Input n must be a positive integer.\")\n\n    total_product = 1\n    current_factorial = 1 # This will store i! for the current iteration i\n\n    # Iterate from 1 up to n (inclusive)\n    for i in range(1, n + 1):\n        # Calculate i! iteratively\n        # current_factorial will hold (i-1)! from previous iteration,\n        # so multiply by i to get i!\n        current_factorial *= i\n        \n        # Multiply the calculated i! into the total product\n        total_product *= current_factorial\n\n    return total_product"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n\n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    # First, replace sequences of 3 or more spaces with a hyphen.\n    text = re.sub(r' {3,}', '-', text)\n    \n    # Then, replace all remaining single or double spaces with underscores.\n    text = re.sub(r' ', '_', text)\n    \n    return text"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on several criteria. Returns 'Yes' if valid, 'No' otherwise.\"\"\"\n    \n    digit_count = sum(1 for char in file_name if char.isdigit())\n    if digit_count > 3:\n        return 'No'\n\n    if file_name.count('.') != 1:\n        return 'No'\n\n    parts = file_name.split('.')\n    name_part = parts[0]\n    extension_part = parts[1]\n\n    if not name_part:\n        return 'No'\n    if not name_part[0].isalpha():\n        return 'No'\n\n    valid_extensions = ['txt', 'exe', 'dll']\n    if extension_part not in valid_extensions:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    This function processes a list of integers, modifying entries based on their index. It squares entries at indices multiple of 3, cubes entries at indices multiple of 4 (but not 3), and leaves others unchanged, then returns the total sum.\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            # Square the entry if its index is a multiple of 3.\n            total_sum += num ** 2\n        elif i % 4 == 0:\n            # Cube the entry if its index is a multiple of 4 and not a multiple of 3.\n            total_sum += num ** 3\n        else:\n            # Keep the entry unchanged otherwise.\n            total_sum += num\n    return total_sum"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    You are given a string representing a sentence,\n    the sentence contains some words separated by a space,\n    and you have to return a string that contains the words from the original sentence,\n    whose lengths are prime numbers,\n    the order of the words in the new string should be the same as the original one.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"\n        Helper function to check if a number is prime.\n        A prime number is a natural number greater than 1 that has no positive divisors other than 1 and itself.\n        \"\"\"\n        if n <= 1:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    words = sentence.split()\n\n    prime_length_words = []\n    for word in words:\n        if is_prime(len(word)):\n            prime_length_words.append(word)\n\n    return \" \".join(prime_length_words)"}
{"task_id": "HumanEval/144", "solution": "def simplify(x: str, n: str) -> bool:\n    \"\"\"\n    Simplifies the expression x * n and returns True if the result is a whole number,\n    False otherwise. Both x and n are string representations of fractions.\n    \"\"\"\n\n    def parse_fraction(fraction_str: str) -> tuple[int, int]:\n        \"\"\"Parses a fraction string into its numerator and denominator.\"\"\"\n        parts = fraction_str.split('/')\n        return int(parts[0]), int(parts[1])\n\n    x_numerator, x_denominator = parse_fraction(x)\n    n_numerator, n_denominator = parse_fraction(n)\n\n    product_numerator = x_numerator * n_numerator\n    product_denominator = x_denominator * n_denominator\n\n    # A fraction A/B is a whole number if A is perfectly divisible by B.\n    return product_numerator % product_denominator == 0"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers based on the sum of their digits and original index.\n    The primary key is the sum of digits (ascending), and the secondary key is the original index (ascending).\n    \"\"\"\n\n    def get_digit_sum(n):\n        \"\"\"\n        Calculates the sum of the absolute values of digits for an integer.\n        \"\"\"\n        s = 0\n        n_abs = abs(n)\n        if n_abs == 0:\n            return 0\n        while n_abs > 0:\n            s += n_abs % 10\n            n_abs //= 10\n        return s\n\n    indexed_nums = list(enumerate(nums))\n\n    sorted_indexed_nums = sorted(indexed_nums, key=lambda item: (get_digit_sum(item[1]), item[0]))\n\n    result = [num for index, num in sorted_indexed_nums]\n\n    return result"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"\n    Counts numbers in a list that are greater than 10 and whose first and last digits are both odd.\n    It iterates through the list, applying two conditions to each number.\n    \"\"\"\n    count = 0\n    for num in nums:\n        # Condition 1: Check if the number is greater than 10.\n        if num > 10:\n            # Convert to string to easily access digits.\n            s_num = str(num)\n            \n            # Extract first and last digits.\n            first_digit = int(s_num[0])\n            last_digit = int(s_num[-1])\n            \n            # Condition 2: Check if both digits are odd.\n            if first_digit % 2 != 0 and last_digit % 2 != 0:\n                count += 1\n    return count"}
{"task_id": "HumanEval/147", "solution": "def combinations_3(n_val):\n    \"\"\"\n    Calculates C(n_val, 3), the number of ways to choose 3 items from n_val.\n    Returns 0 if n_val is less than 3, as it's impossible to choose three items.\n    \"\"\"\n    if n_val < 3:\n        return 0\n    return n_val * (n_val - 1) * (n_val - 2) // 6\ndef get_max_triples(n: int) -> int:\n    \"\"\"\n    Counts triples (a[i], a[j], a[k]) with i < j < k where a[i]+a[j]+a[k] is a multiple of 3.\n    The values a[x] = x*x - x + 1 are analyzed modulo 3 to find suitable combinations.\n    \"\"\"\n    # a[x] % 3 is 0 if x % 3 == 2.\n    # a[x] % 3 is 1 if x % 3 == 0 or x % 3 == 1.\n    \n    # Count of x in [1, n] such that x % 3 == 2 (making a[x] % 3 == 0).\n    c0 = (n + 1) // 3\n    \n    # Count of x in [1, n] such that x % 3 == 0 or x % 3 == 1 (making a[x] % 3 == 1).\n    c1 = (n // 3) + ((n + 2) // 3)\n    \n    # Valid sums modulo 3 are (0,0,0) or (1,1,1).\n    # Calculate combinations for each case and sum them up.\n    total_triples = combinations_3(c0) + combinations_3(c1)\n    \n    return total_triples"}
