{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"\n    Accepts a list of strings, deletes strings with odd lengths,\n    and returns the result sorted by length (ascending) then alphabetically (ascending).\n\n    Args:\n        lst (list[str]): A list of strings.\n\n    Returns:\n        list[str]: The filtered and sorted list of strings.\n\n    Examples:\n        >>> sorted_list_sum([\"aa\", \"a\", \"aaa\"])\n        ['aa']\n        >>> sorted_list_sum([\"ab\", \"a\", \"aaa\", \"cd\"])\n        ['ab', 'cd']\n        >>> sorted_list_sum([\"abc\", \"abcd\", \"a\", \"aa\", \"abcde\"])\n        ['aa', 'abcd']\n        >>> sorted_list_sum([\"hello\", \"world\", \"python\", \"java\"])\n        ['java', 'world', 'python']\n        >>> sorted_list_sum([])\n        []\n        >>> sorted_list_sum([\"odd\", \"even\", \"five\", \"four\"])\n        ['four', 'even']\n    \"\"\"\n    # Filter out strings with odd lengths, creating a new list of only even-length strings.\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n\n    # Sort the filtered list primarily by length, then alphabetically.\n    # A tuple (len(s), s) as the key enables this two-level sort.\n    sorted_result = sorted(even_length_strings, key=lambda s: (len(s), s))\n\n    return sorted_result"}
{"task_id": "HumanEval/150", "solution": "import math\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n    \"\"\"\n    def is_prime(num):\n        \"\"\"Helper function to check if a number is prime.\n        It efficiently checks for divisibility up to the square root of num.\n        \"\"\"\n        if num <= 1:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(num)) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\n\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0  \n   \n    If the input list is empty, return 0.\n    '''\n    \n    # Initializes sum of squares.\n    total_sum_of_squares = 0\n    \n    # Iterates through numbers, checks if integer, positive, and odd.\n    for num in lst:\n        if isinstance(num, int) and num > 0 and num % 2 != 0:\n            # Squares valid numbers and adds to sum.\n            total_sum_of_squares += num * num\n            \n    return total_sum_of_squares"}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"Calculates the difference between actual game scores and guesses for multiple matches.\n    Returns a list of absolute differences, with 0 for correct guesses.\"\"\"\n    differences = []\n    for actual_score, guessed_score in zip(game, guess):\n        if actual_score == guessed_score:\n            differences.append(0)\n        else:\n            differences.append(abs(actual_score - guessed_score))\n    return differences"}
{"task_id": "HumanEval/153", "solution": "import math\ndef Strongest_Extension(class_name: str, extensions: list[str]) -> str:\n    \"\"\"\n    Finds the strongest extension based on uppercase minus lowercase letters,\n    returning the class name concatenated with the strongest extension. Ties are\n    broken by choosing the extension that appears first in the list.\n    \"\"\"\n    \n    max_strength = -math.inf\n    strongest_extension_name = \"\"\n\n    for extension in extensions:\n        cap_count = 0\n        sm_count = 0\n        \n        for char in extension:\n            if char.isupper():\n                cap_count += 1\n            elif char.islower():\n                sm_count += 1\n        \n        current_strength = cap_count - sm_count\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension\n            \n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"Checks if the second word or any of its cyclic rotations is a substring of the first word.\"\"\"\n    len_b = len(b)\n    len_a = len(a)\n\n    if len_b > len_a: # Returns False if 'b' is longer than 'a'.\n        return False\n\n    for i in range(len_b):\n        rotated_b = b[i:] + b[:i] # Generates each cyclic rotation of 'b'.\n        if rotated_b in a:\n            return True # Returns True if any rotation is found as a substring.\n            \n    return False # No cyclic rotation of 'b' was found in 'a'."}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num: int) -> tuple[int, int]:\n    \"\"\"Calculates the number of even and odd digits in an integer.\n    Considers the absolute value of the number, and 0 is an even digit.\"\"\"\n    even_count = 0\n    odd_count = 0\n\n    str_num = str(abs(num))\n\n    for digit_char in str_num:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    # Define Roman numeral symbols and their values, including subtractive notations.\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'),\n        (1, 'I')\n    ]\n\n    result = []\n    # Iterate through the roman_map to build the numeral.\n    for value, symbol in roman_map:\n        while number >= value:\n            result.append(symbol)\n            number -= value\n    \n    # Join symbols and convert the final string to lowercase.\n    return \"\".join(result).lower()"}
