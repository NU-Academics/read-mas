{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase. Restrictions: 1 <= num <= 1000.\n    \"\"\"\n    roman_map = [\n        (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n        (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n        (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'), (1, 'i')\n    ]\n\n    result = []\n    for value, symbol in roman_map:\n        while number >= value:\n            result.append(symbol)\n            number -= value\n    return \"\".join(result)"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word.\"\"\"\n\n    # Handle empty string edge cases based on the provided design's example snippet and tests.\n    if not b:\n        # If the pattern 'b' is empty: True if 'a' is also empty, False otherwise.\n        return True if not a else False\n    if not a:\n        # If 'a' is empty, a non-empty pattern 'b' cannot be a substring.\n        return False\n\n    # Generate all unique cyclic rotations of the pattern string 'b'.\n    rotations = set()\n    n = len(b)\n    for i in range(n):\n        rotated_b = b[i:] + b[:i]\n        rotations.add(rotated_b)\n    \n    # Check if any generated rotation is a substring of 'a'.\n    for rotation in rotations:\n        if rotation in a:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/158", "solution": "```python\ndef _count_unique_chars(word: str) -> int:\n    \"\"\"Calculates the number of unique characters in a string.\"\"\"\n    return len(set(word))\n\ndef find_max(words: list[str]) -> str:\n    \"\"\"\n    Returns the word with the maximum number of unique characters from a list of strings.\n    If multiple words share the maximum, the one first in lexicographical order is returned.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = _count_unique_chars(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Tie-breaking: lexicographical order\n            if result_word == \"\" or word < result_word:\n                result_word = word\n    return result_word\n```"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"\n    Finds the word with the maximum unique characters from a list,\n    prioritizing lexicographical order in case of ties.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    word_data = []\n    for word in words:\n        unique_count = len(set(word))\n        word_data.append((unique_count, word))\n\n    # Sort by unique character count (descending) then by word (lexicographical ascending).\n    word_data.sort(key=lambda x: (-x[0], x[1]))\n\n    return word_data[0][1]"}
{"task_id": "HumanEval/157", "solution": "FLOAT_COMPARISON_EPSILON = 1e-9\n\ndef is_close(val1: float, val2: float, epsilon: float) -> bool:\n    \"\"\"Compares two floats for approximate equality.\n    It returns True if the absolute difference is less than epsilon.\n    \"\"\"\n    return abs(val1 - val2) < epsilon\n\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle, determine if they form a right-angled triangle.\n    Validates side lengths and triangle inequality before checking the Pythagorean theorem.\n    '''\n    # Check if side lengths are positive (FR4, modified to return False instead of raising error)\n    if not (a > 0 and b > 0 and c > 0):\n        return False\n\n    # Check triangle inequality (FR5, modified to return False instead of raising error)\n    if not (a + b > c and a + c > b and b + c > a):\n        return False\n\n    # Check Pythagorean theorem (FR2/FR3)\n    # Sort squares to find the two legs and the hypotenuse, then compare with tolerance.\n    sides_squared = sorted([a*a, b*b, c*c])\n    return is_close(sides_squared[0] + sides_squared[1], sides_squared[2], FLOAT_COMPARISON_EPSILON)"}
