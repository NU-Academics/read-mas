{"task_id": "HumanEval/39", "solution": "import math\n\nclass FibonacciGenerator:\n    \"\"\"Generates Fibonacci numbers, caching previously computed values.\"\"\"\n    def __init__(self):\n        self._cache = {0: 0, 1: 1}\n        self._a, self._b = 0, 1\n        self._current_index = 0\n\n    def generate_sequence(self):\n        \"\"\"An infinite generator that yields Fibonacci numbers starting from F(0).\"\"\"\n        while self._current_index < len(self._cache):\n            yield self._cache[self._current_index]\n            self._current_index += 1\n\n        while True:\n            next_fib = self._a + self._b\n            self._cache[self._current_index] = next_fib\n            self._a = self._b\n            self._b = next_fib\n            yield next_fib\n            self._current_index += 1\n\n    def get_fibonacci(self, index: int) -> int:\n        \"\"\"Returns the Fibonacci number at a specific index, computing it if not already cached.\"\"\"\n        # No error checks for negative index due to critical requirements.\n        if index in self._cache:\n            return self._cache[index]\n        \n        # Iteratively calculate and cache Fibonacci numbers up to the required index.\n        a, b = 0, 1\n        if index == 0:\n            self._cache[0] = 0\n            return 0\n        if index == 1:\n            self._cache[1] = 1\n            return 1\n        for i in range(2, index + 1):\n            a, b = b, a + b\n            self._cache[i] = b\n        self._current_index = max(self._current_index, index + 1)\n        return b\n\n\nclass PrimeChecker:\n    \"\"\"Checks if a number is prime, using a cache and optimized primality test.\"\"\"\n    def __init__(self):\n        self._prime_cache = {2, 3, 5}\n        self._max_checked = 5\n\n    def _sieve_up_to(self, limit: int):\n        \"\"\"Populates the internal prime_cache with all prime numbers up to limit using Sieve of Eratosthenes.\"\"\"\n        if limit <= self._max_checked:\n            return\n\n        is_prime_array = [True] * (limit + 1)\n        is_prime_array[0] = is_prime_array[1] = False\n\n        for p in range(2, int(math.sqrt(limit)) + 1):\n            if is_prime_array[p]:\n                for multiple in range(p * p, limit + 1, p):\n                    is_prime_array[multiple] = False\n        \n        for p in range(self._max_checked + 1, limit + 1):\n            if is_prime_array[p]:\n                self._prime_cache.add(p)\n        self._max_checked = limit\n\n    def is_prime(self, num: int) -> bool:\n        \"\"\"Checks if num is a prime number, utilizing a cache and trial division.\"\"\"\n        if num <= 1:\n            return False\n        if num in self._prime_cache:\n            return True\n        \n        # Check divisibility by small primes from cache.\n        for prime in sorted(list(self._prime_cache)):\n            if prime * prime > num:\n                break\n            if num % prime == 0:\n                return False\n        \n        # Continue trial division for numbers not covered by initial checks.\n        start_divisor = self._max_checked + 1\n        if start_divisor % 2 == 0:\n            start_divisor += 1\n        if start_divisor < 7:\n            start_divisor = 7\n        \n        for i in range(start_divisor, int(math.sqrt(num)) + 1, 2):\n            if num % i == 0:\n                return False\n        \n        self._prime_cache.add(num)\n        self._max_checked = max(self._max_checked, num)\n        return True\n\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    fib_generator = FibonacciGenerator()\n    prime_checker = PrimeChecker()\n\n    prime_fib_count = 0\n    fib_sequence = fib_generator.generate_sequence()\n    \n    # Skip F(0), F(1), F(2) to align with problem's first prime Fibonacci number (F(3)=2).\n    next(fib_sequence)\n    next(fib_sequence)\n    next(fib_sequence)\n\n    while True:\n        fib_num = next(fib_sequence)\n        if prime_checker.is_prime(fib_num):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                return fib_num"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int) -> str:\n    \"\"\"Converts an integer x to its string representation in the specified base.\n    The target base is assumed to be less than 10.\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    result = []\n    while x > 0:\n        remainder = x % base\n        result.append(str(remainder))\n        x //= base\n    return \"\".join(result[::-1])"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int) -> int:\n    \"\"\"Computes the n-th element of the Fib4 number sequence iteratively.\n    The sequence is defined by base cases for n=0, 1, 2, 3 and fib4(n) = fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4) for n >= 4.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize the last four values for n=0, 1, 2, 3\n    # d = fib4(i-4), c = fib4(i-3), b = fib4(i-2), a = fib4(i-1)\n    d, c, b, a = 0, 0, 2, 0\n\n    for _ in range(4, n + 1):\n        next_fib = a + b + c + d\n        d, c, b, a = c, b, a, next_fib\n    return a"}
{"task_id": "HumanEval/46", "solution": "```python\ndef fib4(n: int) -> int:\n    \"\"\"Computes the n-th element of the Fib4 number sequence iteratively.\n    The sequence is defined with fib4(0)=0, fib4(1)=0, fib4(2)=2, fib4(3)=0, and fib4(n) = fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4) for n > 3.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize with the first four Fib4 numbers: fib4(0), fib4(1), fib4(2), fib4(3).\n    # This list maintains a sliding window of the last four computed values.\n    last_four = [0, 0, 2, 0]\n\n    for i in range(4, n + 1):\n        next_fib4 = sum(last_four)\n        last_four.pop(0)  # Remove the oldest value\n        last_four.append(next_fib4) # Add the new value\n\n    return last_four[3]\n```"}
