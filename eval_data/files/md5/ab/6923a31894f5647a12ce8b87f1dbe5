{"task_id": "HumanEval/94", "solution": "import math\n\ndef skjkasdkd(lst):\n    \"\"\"Finds the largest prime number in a list and returns the sum of its digits.\n    Returns 0 if no prime numbers are found.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if an integer n is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    def sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the digits of an integer (absolute value).\"\"\"\n        s = 0\n        n_abs = abs(n)\n        while n_abs > 0:\n            s += n_abs % 10\n            n_abs //= 10\n        return s\n\n    largest_prime = None\n    for num in lst:\n        if is_prime(num):\n            if largest_prime is None or num > largest_prime:\n                largest_prime = num\n    \n    if largest_prime is None:\n        return 0\n    else:\n        return sum_digits(largest_prime)"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping letter cases and shifting vowels two places ahead.\n    Assumes input contains only English alphabetic characters and potentially spaces.\n    \"\"\"\n    encoded_chars = []\n    VOWELS_LOWER = \"aeiou\"\n    ALPHABET_OFFSET = 2\n\n    for char in message:\n        processed_char = char\n\n        # Swap case logic\n        if 'a' <= processed_char <= 'z':\n            processed_char = processed_char.upper()\n        elif 'A' <= processed_char <= 'Z':\n            processed_char = processed_char.lower()\n        # If not an alphabet, processed_char remains unchanged.\n\n        # Check if the character (after case swap) is a vowel and replace if true\n        if processed_char.lower() in VOWELS_LOWER:\n            if 'a' <= processed_char <= 'z':\n                start = ord('a')\n                processed_char = chr(start + (ord(processed_char) - start + ALPHABET_OFFSET) % 26)\n            elif 'A' <= processed_char <= 'Z':\n                start = ord('A')\n                processed_char = chr(start + (ord(processed_char) - start + ALPHABET_OFFSET) % 26)\n            # If not an alphabet (and it was in VOWELS_LOWER, implies an error if hit), it remains unchanged.\n\n        encoded_chars.append(processed_char)\n        \n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"Finds the largest prime in a list and returns the sum of its digits.\n    If no primes are found, it returns 0.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a given integer n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    def sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the digits of any integer n.\"\"\"\n        s = 0\n        current_n = abs(n)\n        while current_n > 0:\n            s += current_n % 10\n            current_n //= 10\n        return s\n\n    largest_prime = 0\n    for num in lst:\n        if is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n    \n    return sum_digits(largest_prime)"}
