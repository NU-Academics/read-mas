{"task_id": "HumanEval/91", "solution": "import re\n\nclass SentenceSplitter:\n    \"\"\"Utility to split text into sentences using common delimiters.\"\"\"\n    SENTENCE_DELIMITERS = ['.', '?', '!']\n\n    def split_sentences(self, text: str) -> list[str]:\n        # Split by one or more delimiters and clean up resulting sentence strings.\n        pattern = '|'.join(re.escape(d) for d in self.SENTENCE_DELIMITERS)\n        sentences = re.split(f'[{pattern}]+', text)\n        \n        # Strip whitespace from each sentence and filter out any empty strings.\n        cleaned_sentences = [s.strip() for s in sentences if s.strip()]\n        return cleaned_sentences\n\nclass WordChecker:\n    \"\"\"Utility to check if a sentence starts with the word \"I\".\"\"\"\n    def starts_with_i(self, sentence: str) -> bool:\n        # Trim leading/trailing whitespace from the sentence.\n        trimmed_sentence = sentence.strip()\n        if not trimmed_sentence:\n            return False\n        \n        # Check if the sentence starts with the exact word \"I\" (case-sensitive).\n        # '\\b' ensures 'I' is a whole word, handling cases like \"I!\" or \"I.\" correctly.\n        return bool(re.match(r'^I\\b', trimmed_sentence))\n\nclass BoredomCounter:\n    \"\"\"Orchestrates counting \"boredom\" sentences using SentenceSplitter and WordChecker.\"\"\"\n    def __init__(self, sentence_splitter: SentenceSplitter, word_checker: WordChecker):\n        self._sentence_splitter = sentence_splitter\n        self._word_checker = word_checker\n\n    def count_boredoms(self, text: str) -> int:\n        sentences = self._sentence_splitter.split_sentences(text)\n        boredom_count = 0\n        for sentence in sentences:\n            if self._word_checker.starts_with_i(sentence):\n                boredom_count += 1\n        return boredom_count\n\ndef is_bored(S: str) -> int:\n    \"\"\"\n    Counts sentences starting with \"I\" (boredoms) in a given string.\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    splitter = SentenceSplitter()\n    checker = WordChecker()\n    counter = BoredomCounter(splitter, checker)\n    return counter.count_boredoms(S)"}
{"task_id": "HumanEval/91", "solution": "import re\n\nclass TextProcessor:\n    def split_sentences(self, text: str) -> list[str]:\n        # Splits text into sentences using common punctuation.\n        sentences = re.split(r'[.?!]\\s*', text)\n        return [s.strip() for s in sentences if s.strip()]\n\n    def starts_with_i(self, sentence: str) -> bool:\n        # Checks if a sentence starts with \"I\", case-insensitive and word-bound.\n        cleaned_sentence = sentence.strip()\n        if not cleaned_sentence:\n            return False\n        return re.match(r\"^[Ii]\\b\", cleaned_sentence) is not None\n\nclass BoredomCounter:\n    def __init__(self, text_processor: TextProcessor = None):\n        self.text_processor = text_processor if text_processor else TextProcessor()\n\n    def count_boredoms(self, text: str) -> int:\n        # Counts sentences starting with \"I\" using the text processor.\n        sentences = self.text_processor.split_sentences(text)\n        boredom_count = 0\n        for sentence in sentences:\n            if self.text_processor.starts_with_i(sentence):\n                boredom_count += 1\n        return boredom_count\n\ndef is_bored(S: str) -> int:\n    \"\"\"\n    Counts sentences where the first word is \"I\". Sentences are delimited\n    by '.', '?', or '!'.\n    \"\"\"\n    counter = BoredomCounter()\n    return counter.count_boredoms(S)"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping letter cases and replacing vowels with a letter two places ahead.\n    Assumes input contains only English alphabet letters.\n    \"\"\"\n    VOWELS_LOWER = \"aeiou\"\n    VOWELS_UPPER = \"AEIOU\"\n    encoded_chars = []\n\n    for char in message:\n        # First, swap case of the character\n        swapped_char = ''\n        if char.islower():\n            swapped_char = char.upper()\n        elif char.isupper():\n            swapped_char = char.lower()\n        else:\n            # According to precondition, this case implies char is not a letter.\n            # However, we must trust the input and directly return the char.\n            swapped_char = char\n\n        # Then, replace vowel if applicable based on the swapped case\n        final_char = swapped_char\n        if swapped_char in VOWELS_LOWER:\n            final_char = chr(ord(swapped_char) + 2)\n        elif swapped_char in VOWELS_UPPER:\n            final_char = chr(ord(swapped_char) + 2)\n        \n        encoded_chars.append(final_char)\n    \n    return \"\".join(encoded_chars)"}
