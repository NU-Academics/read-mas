{"task_id": "HumanEval/161", "solution": "```python\ndef solve(s):\n    \"\"\"Reverses letter case or the entire string based on content. Non-letter characters keep their original form unless the string has no letters, in which case the whole string is reversed.\"\"\"\n\n    has_letters = any(char.isalpha() for char in s)\n\n    if not has_letters:\n        return s[::-1]\n\n    transformed_chars = []\n    for char in s:\n        if char.isalpha():\n            if char.islower():\n                transformed_chars.append(char.upper())\n            else:\n                transformed_chars.append(char.lower())\n        else:\n            transformed_chars.append(char)\n            \n    return \"\".join(transformed_chars)\n```"}
{"task_id": "HumanEval/160", "solution": "```python\nimport operator as op_module\nfrom typing import Callable, List, Dict\n\nclass Token:\n    \"\"\"Base class for expression tokens.\"\"\"\n    pass\n\nclass OperandToken(Token):\n    \"\"\"Represents a numeric operand.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass OperatorToken(Token):\n    \"\"\"Represents an operator with its properties.\"\"\"\n    def __init__(self, symbol: str, precedence: int, operation: Callable[[int, int], int]):\n        self.symbol = symbol\n        self.precedence = precedence\n        self.operation = operation\n\n    def is_left_associative(self) -> bool:\n        \"\"\"Checks if the operator is left-associative.\"\"\"\n        return self.symbol != '**'\n\n_OPERATOR_PRECEDENCE: Dict[str, int] = {\n    '**': 3,\n    '*': 2,\n    '//': 2,\n    '+': 1,\n    '-': 1,\n}\n\n_OPERATOR_FUNCTIONS: Dict[str, Callable[[int, int], int]] = {\n    '+': op_module.add,\n    '-': op_module.sub,\n    '*': op_module.mul,\n    '//': op_module.floordiv,\n    '**': op_module.pow,\n}\n\ndef _get_operator_info(symbol: str) -> OperatorToken:\n    \"\"\"Retrieves OperatorToken for a given symbol.\"\"\"\n    precedence = _OPERATOR_PRECEDENCE[symbol]\n    operation = _OPERATOR_FUNCTIONS[symbol]\n    return OperatorToken(symbol, precedence, operation)\n\ndef _tokenize(operator: List[str], operand: List[int]) -> List[Token]:\n    \"\"\"Converts raw input lists into a list of Token objects.\"\"\"\n    tokens: List[Token] = []\n    for i in range(len(operand)):\n        tokens.append(OperandToken(operand[i]))\n        if i < len(operator):\n            tokens.append(_get_operator_info(operator[i]))\n    return tokens\n\ndef _infix_to_rpn(tokens: List[Token]) -> List[Token]:\n    \"\"\"Converts an infix expression to Reverse Polish Notation.\"\"\"\n    output_queue: List[Token] = []\n    operator_stack: List[OperatorToken] = []\n\n    for token in tokens:\n        if isinstance(token, OperandToken):\n            output_queue.append(token)\n        elif isinstance(token, OperatorToken):\n            while (operator_stack and\n                   isinstance(operator_stack[-1], OperatorToken) and\n                   ((token.is_left_associative() and token.precedence <= operator_stack[-1].precedence) or\n                    (not token.is_left_associative() and token.precedence < operator_stack[-1].precedence))):\n                output_queue.append(operator_stack.pop())\n            operator_stack.append(token)\n\n    while operator_stack:\n        output_queue.append(operator_stack.pop())\n    return output_queue\n\ndef _evaluate_rpn(rpn_tokens: List[Token]) -> int:\n    \"\"\"Evaluates an expression in Reverse Polish Notation.\"\"\"\n    operand_stack: List[int] = []\n\n    for token in rpn_tokens:\n        if isinstance(token, OperandToken):\n            operand_stack.append(token.value)\n        elif isinstance(token, OperatorToken):\n            right_operand = operand_stack.pop()\n            left_operand = operand_stack.pop()\n            try:\n                result = token.operation(left_operand, right_operand)\n                operand_stack.append(result)\n            except ZeroDivisionError:\n                raise ZeroDivisionError(\"Division by zero occurred.\")\n    return operand_stack[0]\n\ndef do_algebra(operator, operand):\n    \"\"\"\n    Evaluates an algebraic expression from operator and operand lists.\n    It applies standard mathematical operator precedence for supported operations.\n    \"\"\"\n    infix_tokens = _tokenize(operator, operand)\n    rpn_tokens = _infix_to_rpn(infix_tokens)\n    result = _evaluate_rpn(rpn_tokens)\n    return result\n```"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    EVEN_DIGITS = [2, 4, 6, 8]\n\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    result = []\n    for digit in EVEN_DIGITS:\n        if min_val <= digit <= max_val:\n            result.append(digit)\n    \n    return sorted(result)"}
