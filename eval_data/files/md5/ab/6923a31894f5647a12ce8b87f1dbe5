{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise.\n    \"\"\"\n\n    def _is_prime(n):\n        \"\"\"Checks if a given integer is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    string_length = len(string)\n    return _is_prime(string_length)"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"\n    Checks if the length of a string is a prime number.\n    Returns True if the length is prime, False otherwise.\n    \"\"\"\n    def _is_prime(n: int) -> bool:\n        # Implements the primality test using trial division.\n        # It assumes n is a non-negative integer.\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    length = len(string)\n    return _is_prime(length)"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"It is the last week of the semester and the teacher has to give the grades\n    to students. The teacher has been making her own algorithm for grading.\n    \"\"\"\n    result = []\n    for gpa in grades:\n        if gpa == 4.0:\n            letter_grade = \"A+\"\n        elif gpa > 3.7:\n            letter_grade = \"A\"\n        elif gpa > 3.3:\n            letter_grade = \"A-\"\n        elif gpa > 3.0:\n            letter_grade = \"B+\"\n        elif gpa > 2.7:\n            letter_grade = \"B\"\n        elif gpa > 2.3:\n            letter_grade = \"B-\"\n        elif gpa > 2.0:\n            letter_grade = \"C+\"\n        elif gpa > 1.7:\n            letter_grade = \"C\"\n        elif gpa > 1.3:\n            letter_grade = \"C-\"\n        elif gpa > 1.0:\n            letter_grade = \"D+\"\n        elif gpa > 0.7:\n            letter_grade = \"D\"\n        elif gpa > 0.0:\n            letter_grade = \"D-\"\n        elif gpa == 0.0:\n            letter_grade = \"E\"\n        else:\n            letter_grade = \"E\"  # Fallback for negative GPAs, as per specifications.\n        result.append(letter_grade)\n    return result"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n: int) -> int:\n    \"\"\"\n    Calculates the count of n-digit positive integers that start or end with 1.\n    Assumes n is a positive integer based on critical requirements.\n    \"\"\"\n\n    if n == 1:\n        # For n=1, the only number is '1', which starts and ends with 1.\n        return 1\n    \n    # For n > 1:\n\n    # Count of n-digit numbers starting with 1 (A):\n    # The first digit is fixed as 1. The remaining (n-1) digits can be any of 0-9.\n    count_starts_with_one = 10**(n - 1)\n\n    # Count of n-digit numbers ending with 1 (B):\n    # The last digit is fixed as 1. The first digit can be any of 1-9 (9 choices).\n    # The middle (n-2) digits can be any of 0-9 (10 choices each).\n    count_ends_with_one = 9 * (10**(n - 2))\n\n    # Count of n-digit numbers starting AND ending with 1 (A intersect B):\n    # The first digit is 1, and the last digit is 1.\n    # The middle (n-2) digits can be any of 0-9.\n    count_starts_and_ends_with_one = 10**(n - 2)\n\n    # Total count using the principle of inclusion-exclusion: A + B - (A intersect B).\n    total_count = count_starts_with_one + count_ends_with_one - count_starts_and_ends_with_one\n    \n    return total_count"}
{"task_id": "HumanEval/81", "solution": "```python\ndef numerical_letter_grade(grades):\n    \"\"\"\n    Converts a list of numerical GPAs to a list of letter grades.\n    The conversion follows a specific grading scale based on GPA thresholds.\n    \"\"\"\n    letter_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            letter_grades.append(\"A+\")\n        elif gpa > 3.7:\n            letter_grades.append(\"A\")\n        elif gpa > 3.3:\n            letter_grades.append(\"A-\")\n        elif gpa > 3.0:\n            letter_grades.append(\"B+\")\n        elif gpa > 2.7:\n            letter_grades.append(\"B\")\n        elif gpa > 2.3:\n            letter_grades.append(\"B-\")\n        elif gpa > 2.0:\n            letter_grades.append(\"C+\")\n        elif gpa > 1.7:\n            letter_grades.append(\"C\")\n        elif gpa > 1.3:\n            letter_grades.append(\"C-\")\n        elif gpa > 1.0:\n            letter_grades.append(\"D+\")\n        elif gpa > 0.7:\n            letter_grades.append(\"D\")\n        elif gpa > 0.0:\n            letter_grades.append(\"D-\")\n        else:\n            letter_grades.append(\"E\")\n    return letter_grades\n```"}
{"task_id": "HumanEval/84", "solution": "def _sum_digits(n: int) -> int:\n    \"\"\"Calculates the sum of decimal digits of an integer.\n    Handles non-negative integers as per problem constraints.\"\"\"\n    total_sum = 0\n    # Iteratively add each digit to the total sum.\n    while n > 0:\n        total_sum += n % 10\n        n //= 10\n    return total_sum\n\ndef _to_binary_string(num: int) -> str:\n    \"\"\"Converts a non-negative integer to its binary string representation.\n    Leverages Python's built-in bin() function for conversion.\"\"\"\n    if num == 0:\n        return \"0\"\n    return bin(num)[2:] # `bin()` returns '0b...', so slice it.\n\ndef solve(N: int) -> str:\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    This function orchestrates digit summation and binary conversion.\"\"\"\n    sum_of_digits = _sum_digits(N)\n    return _to_binary_string(sum_of_digits)"}
