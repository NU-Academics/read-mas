{"task_id": "HumanEval/63", "solution": "```python\n_fibfib_memo = {}\n\ndef fibfib(n: int):\n    \"\"\"The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    \"\"\"\n    if n in _fibfib_memo:\n        return _fibfib_memo[n]\n\n    if n == 0 or n == 1:\n        result = 0\n    elif n == 2:\n        result = 1\n    else:\n        result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n\n    _fibfib_memo[n] = result\n    return result\n```"}
{"task_id": "HumanEval/63", "solution": "```python\n_fibfib_memo = {\n    0: 0,\n    1: 0,\n    2: 1\n}\n\ndef fibfib(n: int):\n    \"\"\"The FibFib number sequence is defined as fibfib(0)=0, fibfib(1)=0, fibfib(2)=1, and fibfib(n)=fibfib(n-1)+fibfib(n-2)+fibfib(n-3) for n > 2. This function efficiently computes the n-th element.\n    >>> fibfib(1)\n    0\n    >>> fibfib(5)\n    4\n    >>> fibfib(8)\n    24\n    \"\"\"\n    if n in _fibfib_memo:\n        return _fibfib_memo[n]\n\n    # Compute recursively and store in memo for efficiency.\n    result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n    _fibfib_memo[n] = result\n    return result\n```"}
{"task_id": "HumanEval/64", "solution": "```python\ndef vowels_count(s):\n    \"\"\"Counts the number of vowels in a string, including 'y' at the end of the word.\n    Vowels are 'a', 'e', 'i', 'o', 'u' (case-insensitive), and 'y' (case-insensitive) if it is the last character.\n    \"\"\"\n    if not s:\n        return 0\n\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n    vowel_count = 0\n    word_length = len(s)\n\n    for i, char in enumerate(s):\n        lower_char = char.lower()\n        is_last_char = (i == word_length - 1)\n\n        if lower_char in standard_vowels:\n            vowel_count += 1\n        elif lower_char == 'y' and is_last_char:\n            vowel_count += 1\n            \n    return vowel_count\n```"}
{"task_id": "HumanEval/65", "solution": "```python\ndef circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string. If shift > number of digits, return digits reversed.\n    \"\"\"\n    x_str = str(x)\n    n = len(x_str)\n\n    if shift > n:\n        # If shift is greater than the number of digits, reverse the digits.\n        return x_str[::-1]\n    else:\n        # Perform circular right shift by the effective amount.\n        effective_shift = shift % n\n        return x_str[-effective_shift:] + x_str[:-effective_shift]\n```"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s: str) -> int:\n    \"\"\"Calculates the sum of ASCII codes of only the uppercase characters in a string.\n    Only English uppercase letters (A-Z) contribute to the sum.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if 'A' <= char <= 'Z':\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/64", "solution": "```python\nclass VowelUtils:\n    \"\"\"Utility class for checking if a character is a vowel.\"\"\"\n    @staticmethod\n    def is_standard_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is a standard vowel (a, e, i, o, u), case-insensitive.\"\"\"\n        return char.lower() in {'a', 'e', 'i', 'o', 'u'}\n\n    @staticmethod\n    def is_y_vowel(char: str, is_last_char: bool) -> bool:\n        \"\"\"Checks if a character is 'y' and is the last character of the word, case-insensitive.\"\"\"\n        return char.lower() == 'y' and is_last_char\n\nclass VowelCounter:\n    \"\"\"Counts vowels in a word using VowelUtils for character checks.\"\"\"\n    def __init__(self, vowel_utils: VowelUtils = None):\n        \"\"\"Initializes VowelCounter with an optional VowelUtils instance.\"\"\"\n        self._vowel_utils = vowel_utils if vowel_utils else VowelUtils()\n\n    def count_vowels(self, word: str) -> int:\n        \"\"\"Iterates through the word and counts vowels based on defined rules.\"\"\"\n        if not word:\n            return 0\n\n        vowel_count = 0\n        for i, char in enumerate(word):\n            if not char.isalpha():\n                continue\n\n            is_last_char = (i == len(word) - 1)\n\n            if self._vowel_utils.is_standard_vowel(char):\n                vowel_count += 1\n            elif self._vowel_utils.is_y_vowel(char, is_last_char):\n                vowel_count += 1\n        return vowel_count\n\ndef vowels_count(s):\n    \"\"\"Counts the number of vowels in a string, considering 'y' as a vowel\n    only when it is at the end of the given word.\n    \"\"\"\n    vowel_utils = VowelUtils()\n    counter = VowelCounter(vowel_utils)\n    return counter.count_vowels(s)\n```"}
