{"task_id": "HumanEval/65", "solution": "class DigitManipulator:\n    \"\"\"Utility for digit-level operations.\"\"\"\n\n    def int_to_digits(self, num: int) -> list[int]:\n        \"\"\"Converts an integer into a list of its individual digits.\"\"\"\n        if num == 0:\n            return [0]\n        return [int(d) for d in str(num)]\n\n    def digits_to_int(self, digits: list[int]) -> int:\n        \"\"\"Converts a list of digits back into an integer.\"\"\"\n        if not digits:\n            return 0\n        return int(\"\".join(map(str, digits)))\n\n    def perform_circular_shift(self, digits: list[int], shift_amount: int) -> list[int]:\n        \"\"\"Performs a circular right shift on a list of digits.\"\"\"\n        if not digits:\n            return []\n        num_digits = len(digits)\n        actual_shift = shift_amount % num_digits\n        return digits[-actual_shift:] + digits[:-actual_shift]\n\n    def reverse_digits(self, digits: list[int]) -> list[int]:\n        \"\"\"Reverses the order of digits in a list.\"\"\"\n        return digits[::-1]\n\ndef circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    \"\"\"\n    \n    _digit_manipulator = DigitManipulator()\n\n    digits = _digit_manipulator.int_to_digits(x)\n    num_digits = len(digits)\n\n    if shift > num_digits:\n        shifted_digits = _digit_manipulator.reverse_digits(digits)\n    else:\n        shifted_digits = _digit_manipulator.perform_circular_shift(digits, shift)\n\n    result_int = _digit_manipulator.digits_to_int(shifted_digits)\n    return str(result_int)"}
{"task_id": "HumanEval/67", "solution": "```python\nimport re\n\ndef fruit_distribution(s,n):\n    \"\"\"\n    Given a string describing apple and orange counts and an integer for total fruits,\n    calculate the number of mango fruits.\n    \"\"\"\n    match = re.match(r\"(\\d+)\\s*apples\\s*and\\s*(\\d+)\\s*oranges\", s)\n    \n    apples = int(match.group(1))\n    oranges = int(match.group(2))\n    \n    total_known_fruits = apples + oranges\n    mangoes = n - total_known_fruits\n    \n    return mangoes\n```"}
{"task_id": "HumanEval/67", "solution": "```python\nimport re\n\ndef fruit_distribution(s,n):\n    \"\"\"\n    In this task, you will be given a string that represents a number of apples and oranges \n    that are distributed in a basket of fruit this basket contains \n    apples, oranges, and mango fruits. Given the string that represents the total number of \n    the oranges and apples and an integer that represent the total number of the fruits \n    in the basket return the number of the mango fruits in the basket.\n    for examble:\n    fruit_distribution(\"5 apples and 6 oranges\", 19) ->19 - 5 - 6 = 8\n    fruit_distribution(\"0 apples and 1 oranges\",3) -> 3 - 0 - 1 = 2\n    fruit_distribution(\"2 apples and 3 oranges\", 100) -> 100 - 2 - 3 = 95\n    fruit_distribution(\"100 apples and 1 oranges\",120) -> 120 - 100 - 1 = 19\n    \"\"\"\n    \n    apple_pattern = r\"(\\d+)\\s*apples\"\n    orange_pattern = r\"(\\d+)\\s*oranges\"\n\n    apples_match = re.search(apple_pattern, s)\n    oranges_match = re.search(orange_pattern, s)\n\n    apples = int(apples_match.group(1))\n    oranges = int(oranges_match.group(1))\n\n    total_known_fruits = apples + oranges\n    mangoes = n - total_known_fruits\n    \n    return mangoes\n```"}
{"task_id": "HumanEval/68", "solution": "```python\ndef pluck(arr):\n    \"\"\"\n    Finds the smallest even-valued node and its index from an array of non-negative integers.\n    Returns `[value, index]` or `[]` if no even values are found.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n            # If value == smallest_even_value, the first encountered index (smallest) is already stored.\n\n    if smallest_even_index != -1:\n        return [int(smallest_even_value), smallest_even_index]\n    else:\n        return []\n```"}
{"task_id": "HumanEval/70", "solution": "```python\ndef strange_sort_list(lst: list[int]) -> list[int]:\n    '''\n    Given a list of integers, return a new list sorted in 'strange order'.\n    This order alternates between picking the minimum and then the maximum of the remaining elements.\n    '''\n    if not lst:\n        return []\n\n    sorted_lst = sorted(lst)\n    result = []\n    left, right = 0, len(sorted_lst) - 1\n    is_min_turn = True\n\n    while left <= right:\n        if is_min_turn:\n            result.append(sorted_lst[left])\n            left += 1\n        else:\n            result.append(sorted_lst[right])\n            right -= 1\n        is_min_turn = not is_min_turn\n    return result\n```"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even non-negative integer in an array, returning its value and smallest index.\n    If no even values are found or the array is empty, an empty list is returned.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        # Check if the number is even\n        if value % 2 == 0:\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n            elif value == smallest_even_value and index < smallest_even_index:\n                # If values are equal, prioritize the smallest index\n                smallest_even_index = index\n        \n    if smallest_even_index == -1:\n        # No even numbers were found in the array\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/69", "solution": "```python\nfrom collections import Counter\n\ndef search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    '''\n    frequency_map = Counter(lst)\n    \n    qualifying_integers = []\n    for num, freq in frequency_map.items():\n        if num > 0 and freq >= num:\n            qualifying_integers.append(num)\n    \n    if not qualifying_integers:\n        return -1\n    \n    return max(qualifying_integers)\n```"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Sorts a list of integers in a strange order: min, max of remaining, min of remaining, etc.\n    E.g., `[1, 2, 3, 4]` becomes `[1, 4, 2, 3]` and `[]` remains `[]`.\n    \"\"\"\n    if not lst:\n        return []\n\n    # Create a sorted copy of the input list.\n    sorted_copy = sorted(lst)\n    result = []\n    \n    # Use two pointers for the smallest and largest remaining elements.\n    left, right = 0, len(sorted_copy) - 1\n\n    while left <= right:\n        # Append the current minimum element.\n        result.append(sorted_copy[left])\n        left += 1\n        \n        # If elements still remain, append the current maximum element.\n        if left <= right:\n            result.append(sorted_copy[right])\n            right -= 1\n            \n    return result"}
{"task_id": "HumanEval/71", "solution": "import math\n\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1.\n    '''\n    if not (a > 0 and b > 0 and c > 0):\n        return -1\n\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1\n\n    s = (a + b + c) / 2\n    \n    area_squared = s * (s - a) * (s - b) * (s - c)\n    # Handle potential floating point inaccuracies that might make area_squared slightly negative.\n    if area_squared < 0:\n        area = 0.0\n    else:\n        area = math.sqrt(area_squared)\n\n    return round(area, 2)"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\n\ndef search(lst: list[int]) -> int:\n    \"\"\"\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than\n    zero, and has a frequency greater than or equal to the value of the integer itself.\n    If no such a value exist, return -1.\n    \"\"\"\n    frequencies = Counter(lst)\n\n    candidates = []\n    for num, freq in frequencies.items():\n        if freq >= num:  # Per FR3 and business rules, an integer n must be positive (guaranteed by input spec) and freq >= n.\n            candidates.append(num)\n\n    if not candidates:\n        return -1\n    else:\n        return max(candidates)"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    '''\n    Write a function that returns True if the object q will fly, and False otherwise.\n    The object q will fly if it's balanced (it is a palindromic list) and the sum of its elements is less than or equal the maximum possible weight w.\n    '''\n    is_balanced = (q == q[::-1])\n    total_weight = sum(q)\n    return is_balanced and (total_weight <= w)"}
{"task_id": "HumanEval/71", "solution": "import math\n\ndef triangle_area(a, b, c):\n    \"\"\"\n    Calculates the area of a triangle given its side lengths, rounded to two decimal places.\n    Returns -1 if the sides do not form a valid triangle.\n    \"\"\"\n    # Check if sides are positive and satisfy the triangle inequality theorem.\n    if not (a > 0 and b > 0 and c > 0 and\n            a + b > c and a + c > b and b + c > a):\n        return -1\n\n    # Calculate the semi-perimeter.\n    s = (a + b + c) / 2\n\n    # Calculate the term under the square root for Heron's formula.\n    term_under_sqrt = s * (s - a) * (s - b) * (s - c)\n\n    # Due to floating point inaccuracies, this term might be slightly negative for valid triangles.\n    # If it's negative, treat it as an invalid or numerically unstable case.\n    if term_under_sqrt < 0:\n        return -1\n\n    # Calculate the area using Heron's formula and round to two decimal places.\n    area = math.sqrt(term_under_sqrt)\n    return round(area, 2)"}
{"task_id": "HumanEval/73", "solution": "```python\ndef smallest_change(arr):\n    \"\"\"\n    Finds the minimum changes to make an array palindromic.\n    Compares elements from both ends, incrementing a counter for each mismatch.\n    \"\"\"\n    changes = 0\n    left, right = 0, len(arr) - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes\n```"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q, w):\n    \"\"\"\n    Determines if an object q will fly.\n    An object flies if it's a palindromic list and its element sum is less than or equal to w.\n    \"\"\"\n    is_palindromic = (q == q[::-1])\n    total_weight = sum(q)\n    return is_palindromic and total_weight <= w"}
