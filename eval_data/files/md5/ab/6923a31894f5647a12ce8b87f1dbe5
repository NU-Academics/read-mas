{"task_id": "HumanEval/1", "solution": "from typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"\n    Separates multiple groups of nested parentheses into a list of strings.\n    Each returned string is a balanced, top-level parenthesis group; spaces are ignored.\n    \"\"\"\n    cleaned_string = paren_string.replace(\" \", \"\")\n    \n    groups: List[str] = []\n    balance = 0\n    start_index = 0\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        \n        # Check if a balanced top-level group is complete\n        # The condition `i > start_index - 1` ensures that we don't count an empty string\n        # as a group if balance is 0 at the very beginning (e.g., if start_index is 0 and i is -1, which never happens)\n        # or if start_index and i point to the same character after a reset.\n        if balance == 0 and i >= start_index:\n            groups.append(cleaned_string[start_index : i + 1])\n            start_index = i + 1\n        elif balance < 0:\n            # If balance drops below zero, it means we have an unmatched ')'\n            # Reset balance and start_index to look for a new group from the next character\n            balance = 0\n            start_index = i + 1\n\n    return groups"}
{"task_id": "HumanEval/1", "solution": "```python\nfrom typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    cleaned_string = paren_string.replace(\" \", \"\")\n    \n    balance = 0\n    current_group_start = -1\n    groups: List[str] = []\n    \n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            balance += 1\n            if balance == 1:\n                current_group_start = i\n        elif char == ')':\n            balance -= 1\n            if balance == 0 and current_group_start != -1:\n                group = cleaned_string[current_group_start : i + 1]\n                groups.append(group)\n                current_group_start = -1\n    \n    return groups\n```"}
{"task_id": "HumanEval/5", "solution": "```python\nfrom typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"\n    Inserts a number 'delimeter' between every two consecutive elements of input list `numbers`.\n    Returns a new list, handling empty and single-element inputs as specified.\n    \"\"\"\n    if not numbers:\n        return []\n\n    if len(numbers) == 1:\n        return list(numbers) # Return a new list as per FR3 postcondition\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result\n```"}
{"task_id": "HumanEval/0", "solution": "```python\nfrom typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    # Iterate through all unique pairs to find if their absolute difference is less than the threshold.\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False\n```"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"Calculates the Mean Absolute Deviation for a list of floating-point numbers.\n    MAD is the average absolute difference between each data point and the mean of the dataset.\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    mean = sum(numbers) / len(numbers)\n    absolute_differences = [abs(x - mean) for x in numbers]\n    mad = sum(absolute_differences) / len(absolute_differences)\n    return mad"}
{"task_id": "HumanEval/4", "solution": "```python\nfrom typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"Calculates the Mean Absolute Deviation (MAD) for a given dataset.\n    MAD is the average absolute difference between each element and the dataset's mean.\n    \"\"\"\n    if not numbers:\n        return 0.0\n\n    mean_value = sum(numbers) / len(numbers)\n    absolute_differences = [abs(x - mean_value) for x in numbers]\n\n    return sum(absolute_differences) / len(absolute_differences)\n```"}
{"task_id": "HumanEval/5", "solution": "from typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"Inserts a number `delimeter` between every two consecutive elements of input list `numbers`.\n    Returns a new list with the `delimeter` interspersed, handling empty or single-element lists gracefully.\n    \"\"\"\n    if not numbers:\n        return []\n    if len(numbers) == 1:\n        return list(numbers)\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
