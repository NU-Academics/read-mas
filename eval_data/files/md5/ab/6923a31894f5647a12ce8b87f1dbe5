{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Analyzes a string of space-separated parenthesis groups to find the deepest nesting level for each.\n    Returns a list of integers, where each represents the maximum nesting depth for its corresponding group.\n    \"\"\"\n\n    def _calculate_deepest_nesting(group: str) -> int:\n        \"\"\"Computes the maximum nesting depth within a single parenthesis group.\"\"\"\n        max_depth = 0\n        current_depth = 0\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n            # Handle unbalanced closing parens by resetting depth\n            if current_depth < 0:\n                current_depth = 0\n        return max_depth\n\n    if not paren_string.strip():\n        return []\n\n    groups = paren_string.split(' ')\n    results = []\n    for group in groups:\n        results.append(_calculate_deepest_nesting(group))\n    return results"}
{"task_id": "HumanEval/9", "solution": "```python\nfrom typing import List, Tuple\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\"From a given list of integers, generate a list of rolling maximum elements found until the given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_max_values = []\n    current_max = float('-inf') # Initialize with negative infinity to handle all integer ranges correctly.\n\n    for number in numbers:\n        current_max = max(current_max, number)\n        rolling_max_values.append(current_max)\n    \n    return rolling_max_values\n```"}
{"task_id": "HumanEval/9", "solution": "from typing import List\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\"\n    Computes the rolling maximum for a given list of integers.\n    The output list has the same length as the input list.\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_max_list: List[int] = []\n    current_max: int = numbers[0]\n    rolling_max_list.append(current_max)\n\n    for num in numbers[1:]:\n        current_max = max(current_max, num)\n        rolling_max_list.append(current_max)\n\n    return rolling_max_list"}
{"task_id": "HumanEval/12", "solution": "```python\nfrom typing import List, Optional\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"\n    Returns the longest string from a list, or `None` if the list is empty.\n    If multiple strings share the maximum length, the first one encountered is returned.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_str: Optional[str] = None\n    max_len: int = -1\n\n    for s in strings:\n        if longest_str is None or len(s) > max_len:\n            longest_str = s\n            max_len = len(s)\n    return longest_str\n```"}
{"task_id": "HumanEval/11", "solution": "```python\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    \"\"\"\n    result_chars = []\n    for i in range(len(a)):\n        if a[i] == b[i]:\n            result_chars.append('0')\n        else:\n            result_chars.append('1')\n    return \"\".join(result_chars)\n```"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"\n    Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_so_far: Optional[str] = None\n    max_length = -1\n\n    for s in strings:\n        if longest_so_far is None or len(s) > max_length:\n            longest_so_far = s\n            max_length = len(s)\n    return longest_so_far"}
{"task_id": "HumanEval/11", "solution": "```python\nfrom typing import List\n\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\"Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    \"\"\"\n    _XOR_MAP = {\n        '00': '0',\n        '01': '1',\n        '10': '1',\n        '11': '0'\n    }\n\n    result_chars: List[str] = []\n    # Trust the caller's inputs to be valid binary strings of equal length.\n    for i in range(len(a)):\n        result_chars.append(_XOR_MAP[a[i] + b[i]])\n    return \"\".join(result_chars)\n```"}
