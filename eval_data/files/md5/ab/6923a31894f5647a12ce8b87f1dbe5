{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    \"\"\"\n    cache = {0: 1, 1: 1}\n\n    def calculate_single_factorial(k):\n        \"\"\"Calculates the factorial of a non-negative integer k using memoization.\"\"\"\n        if k in cache:\n            return cache[k]\n\n        result = 1\n        for i in range(2, k + 1):\n            result *= i\n        cache[k] = result\n        return result\n\n    special_fact_result = 1\n    for i in range(1, n + 1):\n        special_fact_result *= calculate_single_factorial(i)\n    return special_fact_result"}
{"task_id": "HumanEval/137", "solution": "```python\ndef compare_one(a, b):\n    \"\"\"\n    Compares two values (int, float, or string representing real numbers)\n    and returns the numerically larger one in its original type, or None if equal.\n    \"\"\"\n\n    def _convert_to_float(value):\n        \"\"\"Converts a value to float, handling string representations with comma decimal separators.\"\"\"\n        try:\n            return float(value)\n        except ValueError:\n            # If direct conversion fails, assume it's a string with a comma and try replacing it.\n            return float(str(value).replace(',', '.'))\n\n    float_a = _convert_to_float(a)\n    float_b = _convert_to_float(b)\n\n    if float_a > float_b:\n        return a\n    elif float_b > float_a:\n        return b\n    else:\n        return None\n```"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Calculates a conditional sum: elements at indices multiple of 3 are squared, and elements at indices multiple of 4 (but not 3) are cubed.\n    Unchanged elements at other indices are also included in the final sum.\n    \"\"\"\n    modified_list = list(lst)\n    for i, val in enumerate(modified_list):\n        if i % 3 == 0:\n            modified_list[i] = val * val\n        elif i % 4 == 0:\n            modified_list[i] = val * val * val\n\n    return sum(modified_list)"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"\n    Checks if a file's name is valid based on predefined conditions.\n    Returns 'Yes' if valid, 'No' otherwise.\n    \"\"\"\n    # BR1.1: Not more than three digits ('0'-'9') in the file's name.\n    digit_count = sum(1 for char in file_name if '0' <= char <= '9')\n    if digit_count > 3:\n        return 'No'\n\n    # BR1.2: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # Split the file_name into prefix and suffix\n    # rsplit ensures correct behavior if a malicious string has multiple dots,\n    # though BR1.2 already filters that.\n    parts = file_name.rsplit('.', 1)\n    prefix = parts[0]\n    suffix = parts[1]\n\n    # BR1.3: The substring before the dot must not be empty.\n    if not prefix:\n        return 'No'\n\n    # BR1.4: The substring before the dot must start with a letter from the Latin alphabet.\n    # Checks if the first character of the prefix is an alphabet letter.\n    if not ('a' <= prefix[0] <= 'z' or 'A' <= prefix[0] <= 'Z'):\n        return 'No'\n\n    # BR1.5: The substring after the dot must be one of these: ['txt', 'exe', 'dll'].\n    allowed_extensions = ['txt', 'exe', 'dll']\n    if suffix not in allowed_extensions:\n        return 'No'\n\n    # If all conditions are met, the file name is valid.\n    return 'Yes'"}
{"task_id": "HumanEval/143", "solution": "```python\ndef words_in_sentence(sentence):\n    \"\"\"Filters words from a sentence, returning only those with prime lengths.\n    Preserves the order of words from the original sentence.\"\"\"\n\n    def is_prime(n):\n        # Checks if a given integer n is a prime number.\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.split(' ')\n    filtered_words = []\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n\n    return ' '.join(filtered_words)\n```"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, keeping only those whose lengths are prime numbers.\n    The original order of words is preserved in the output string.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if an integer is a prime number.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.split(' ')\n    filtered_words = []\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n    return ' '.join(filtered_words)"}
{"task_id": "HumanEval/141", "solution": "```python\ndef file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on specific criteria, returning 'Yes' or 'No'.\n    A file name is valid if it meets digit count, dot count, prefix, and suffix rules.\"\"\"\n\n    # Rule 1: No more than three digits ('0'-'9').\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    # Rule 2: Exactly one dot ('.').\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # Split into prefix and suffix.\n    parts = file_name.split('.', 1)\n    prefix = parts[0]\n    suffix = parts[1]\n\n    # Rule 3: Prefix not empty and starts with a Latin letter.\n    if not prefix:\n        return 'No'\n    # Check if the first character is a Latin alphabet letter\n    if not ('a' <= prefix[0] <= 'z' or 'A' <= prefix[0] <= 'Z'):\n        return 'No'\n\n    # Rule 4: Suffix is one of ['txt', 'exe', 'dll'].\n    allowed_extensions = ['txt', 'exe', 'dll']\n    if suffix not in allowed_extensions:\n        return 'No'\n\n    # If all rules pass\n    return 'Yes'\n```"}
{"task_id": "HumanEval/142", "solution": "```python\ndef sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \"\"\"\n    transformed_elements = []\n    for index, value in enumerate(lst):\n        if index % 3 == 0:\n            transformed_elements.append(value * value)\n        elif index % 4 == 0: # This condition implies index % 3 != 0 due to the 'elif'\n            transformed_elements.append(value * value * value)\n        else:\n            transformed_elements.append(value)\n    return sum(transformed_elements)\n```"}
{"task_id": "HumanEval/140", "solution": "```python\nimport re\n\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    # Prioritize replacing sequences of three or more spaces with a single hyphen.\n    processed_text = re.sub(r' {3,}', '-', text)\n\n    # Then, replace all remaining single spaces (including those from two-space sequences) with underscores.\n    final_text = processed_text.replace(' ', '_')\n\n    return final_text\n```"}
{"task_id": "HumanEval/144", "solution": "import math\n\ndef simplify(x, n):\n    \"\"\"Checks if the product of two fractions results in a whole number.\n    Inputs are fraction strings like \"numerator/denominator\".\"\"\"\n\n    class Fraction:\n        def __init__(self, numerator: int, denominator: int):\n            # Fractions are simplified upon creation.\n            common_divisor = math.gcd(numerator, denominator)\n            self._numerator = numerator // common_divisor\n            self._denominator = denominator // common_divisor\n\n        @property\n        def numerator(self) -> int:\n            return self._numerator\n\n        @property\n        def denominator(self) -> int:\n            return self._denominator\n\n        def __mul__(self, other: 'Fraction') -> 'Fraction':\n            new_numerator = self.numerator * other.numerator\n            new_denominator = self.denominator * other.denominator\n            return Fraction(new_numerator, new_denominator)\n\n        def is_whole_number(self) -> bool:\n            return self.denominator == 1\n\n        def __repr__(self) -> str:\n            \"\"\"Returns a string representation of the fraction.\"\"\"\n            return f\"Fraction({self.numerator}/{self.denominator})\"\n\n    class FractionParser:\n        @classmethod\n        def parse_fraction_string(cls, fraction_str: str) -> Fraction:\n            # Assumes valid input string as per problem statement.\n            parts = fraction_str.split('/')\n            numerator = int(parts[0])\n            denominator = int(parts[1])\n            return Fraction(numerator, denominator)\n\n    class FractionService:\n        def multiply_fractions(self, f1: Fraction, f2: Fraction) -> Fraction:\n            return f1 * f2\n\n        def is_whole_number(self, fraction: Fraction) -> bool:\n            return fraction.is_whole_number()\n\n    fraction_service = FractionService()\n\n    fraction_x = FractionParser.parse_fraction_string(x)\n    fraction_n = FractionParser.parse_fraction_string(n)\n    \n    product_fraction = fraction_service.multiply_fractions(fraction_x, fraction_n)\n    \n    return fraction_service.is_whole_number(product_fraction)"}
{"task_id": "HumanEval/146", "solution": "```python\ndef specialFilter(nums):\n    \"\"\"Write a function that takes an array of numbers as input and returns \n    the number of elements in the array that are greater than 10 and both \n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    \"\"\"\n\n    def is_odd(digit):\n        \"\"\"Checks if a given digit is odd.\"\"\"\n        return digit % 2 != 0\n\n    def get_first_digit(num):\n        \"\"\"Extracts the first digit of an integer using its absolute value.\"\"\"\n        abs_num = abs(num)\n        if abs_num == 0:\n            return 0\n        while abs_num >= 10:\n            abs_num //= 10\n        return abs_num\n\n    def get_last_digit(num):\n        \"\"\"Extracts the last digit of an integer using its absolute value.\"\"\"\n        return abs(num) % 10\n\n    count = 0\n    for num in nums:\n        if num > 10:\n            first_digit = get_first_digit(num)\n            last_digit = get_last_digit(num)\n            if is_odd(first_digit) and is_odd(last_digit):\n                count += 1\n    return count\n```"}
{"task_id": "HumanEval/145", "solution": "def _calculate_digit_sum(num: int) -> int:\n    \"\"\"\n    Calculates the sum of the absolute digits of an integer.\n    For example, the sum of digits for -123 is 6.\n    \"\"\"\n    s = str(abs(num))\n    digit_sum = 0\n    for digit_char in s:\n        digit_sum += int(digit_char)\n    return digit_sum\n\ndef order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of integers by the ascending sum of their digits.\n    Preserves original order for ties using the original index.\n    \"\"\"\n    if not nums:\n        return []\n\n    # Create a list of tuples: (digit_sum, original_index, original_number)\n    decorated_list = []\n    for i, num in enumerate(nums):\n        digit_sum = _calculate_digit_sum(num)\n        decorated_list.append((digit_sum, i, num))\n\n    # Sort the decorated list; Python's tuple sorting handles tie-breaking automatically.\n    decorated_list.sort()\n\n    # Extract the original numbers in the sorted order.\n    sorted_nums = [item[2] for item in decorated_list]\n    return sorted_nums"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    \"\"\"Represents a mathematical fraction and provides arithmetic operations.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        # Simplifies the fraction upon creation using GCD.\n        common_divisor = Fraction._gcd(numerator, denominator)\n        self._numerator = numerator // common_divisor\n        self._denominator = denominator // common_divisor\n\n    @property\n    def numerator(self) -> int:\n        \"\"\"Returns the numerator of the fraction.\"\"\"\n        return self._numerator\n\n    @property\n    def denominator(self) -> int:\n        \"\"\"Returns the denominator of the fraction.\"\"\"\n        return self._denominator\n\n    def __mul__(self, other: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another Fraction object.\"\"\"\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Checks if the fraction represents a whole number.\"\"\"\n        return self.denominator == 1\n    \n    @staticmethod\n    def _gcd(a: int, b: int) -> int:\n        \"\"\"Calculates the greatest common divisor using the Euclidean algorithm.\"\"\"\n        while b:\n            a, b = b, a % b\n        return a\n\n\nclass FractionParser:\n    \"\"\"Utility for parsing fraction strings into numerator and denominator.\"\"\"\n    @staticmethod\n    def parse(fraction_str: str) -> tuple[int, int]:\n        \"\"\"Parses a fraction string (e.g., \"1/2\") into (numerator, denominator) integers.\"\"\"\n        parts = fraction_str.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return numerator, denominator\n\n\nclass FractionService:\n    \"\"\"Orchestrates fraction operations to check for whole number products.\"\"\"\n    def simplify(self, x_str: str, n_str: str) -> bool:\n        \"\"\"Takes two fraction strings, multiplies them, and checks if the product is a whole number.\"\"\"\n        num_x, den_x = FractionParser.parse(x_str)\n        num_n, den_n = FractionParser.parse(n_str)\n\n        fraction_x = Fraction(num_x, den_x)\n        fraction_n = Fraction(num_n, den_n)\n\n        product_fraction = fraction_x * fraction_n\n        return product_fraction.is_whole_number()\n\n\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"Checks if the product of two fractions is a whole number.\n    Inputs x and n are string representations of fractions.\n    \"\"\"\n    service = FractionService()\n    return service.simplify(x, n)"}
{"task_id": "HumanEval/146", "solution": "```python\ndef specialFilter(nums):\n    \"\"\"Filters a list of numbers, counting those greater than 10 with both first and last digits odd.\n    The first digit check considers the absolute value of the number.\n    \"\"\"\n    count = 0\n    for num in nums:\n        # Check if number is greater than 10 (FR2)\n        is_greater_than_10 = num > 10\n\n        # Check if the first digit is odd (FR3, BR2)\n        # Convert to string considering absolute value for the first digit\n        num_str_abs = str(abs(num))\n        first_digit_char = num_str_abs[0]\n        first_digit = int(first_digit_char)\n        is_first_digit_odd = first_digit in [1, 3, 5, 7, 9]\n\n        # Check if the last digit is odd (FR4)\n        # Convert to string (no abs for last digit)\n        num_str = str(num)\n        last_digit_char = num_str[-1]\n        last_digit = int(last_digit_char)\n        is_last_digit_odd = last_digit in [1, 3, 5, 7, 9]\n\n        # Increment count if all conditions are met (FR5)\n        if is_greater_than_10 and is_first_digit_odd and is_last_digit_odd:\n            count += 1\n    return count\n```"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Counts unique integer triples (a[i], a[j], a[k]) where i < j < k from array a,\n    such that their sum a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n\n    # Helper function to calculate combinations (n choose k).\n    def _combinations(num_items: int, k_chosen: int) -> int:\n        if k_chosen < 0 or k_chosen > num_items:\n            return 0\n        if k_chosen == 0 or k_chosen == num_items:\n            return 1\n        if k_chosen > num_items // 2:\n            k_chosen = num_items - k_chosen\n        \n        res = 1\n        for i in range(k_chosen):\n            res = res * (num_items - i) // (i + 1)\n        return res\n\n    # Helper function to count elements by their remainder modulo 3.\n    # a[i] % 3 == 0 when i % 3 == 2; a[i] % 3 == 1 when i % 3 == 0 or i % 3 == 1.\n    def _calculate_a_mod_3_counts(length_n: int) -> tuple[int, int]:\n        count_rem0 = 0\n        count_rem1 = 0\n        for i_val in range(1, length_n + 1):\n            if i_val % 3 == 2: # i*i - i + 1 is 0 mod 3 if i is 2 mod 3\n                count_rem0 += 1\n            else: # i*i - i + 1 is 1 mod 3 if i is 0 or 1 mod 3\n                count_rem1 += 1\n        return count_rem0, count_rem1\n\n    # Main logic starts here.\n    if n < 3:\n        return 0\n\n    count_rem0, count_rem1 = _calculate_a_mod_3_counts(n)\n\n    total_triples = 0\n    # Triples with (0, 0, 0) remainders modulo 3.\n    total_triples += _combinations(count_rem0, 3)\n    \n    # Triples with (1, 1, 1) remainders modulo 3.\n    total_triples += _combinations(count_rem1, 3)\n    \n    return total_triples"}
{"task_id": "HumanEval/148", "solution": "PLANET_ORDER = [\n    \"Mercury\", \"Venus\", \"Earth\", \"Mars\",\n    \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n]\nPLANET_MAP = {planet.lower(): i for i, planet in enumerate(PLANET_ORDER)}\n\ndef bf(planet1, planet2):\n    \"\"\"\n    Identifies planets located between two specified planets in our solar system.\n    Returns a tuple of planets sorted by proximity to the Sun, or an empty tuple for invalid inputs.\n    \"\"\"\n    p1_lower = planet1.lower()\n    p2_lower = planet2.lower()\n\n    if p1_lower not in PLANET_MAP or p2_lower not in PLANET_MAP:\n        return ()\n\n    idx1 = PLANET_MAP[p1_lower]\n    idx2 = PLANET_MAP[p2_lower]\n\n    if idx1 > idx2:\n        idx1, idx2 = idx2, idx1\n\n    between_planets = PLANET_ORDER[idx1 + 1:idx2]\n\n    return tuple(between_planets)"}
