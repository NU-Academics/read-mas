{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array: list) -> bool:\n    \"\"\"\n    Checks if the given array (list) of numbers is monotonic.\n\n    An array is monotonic if it is either monotonically increasing or\n    monotonically decreasing.\n    \"\"\"\n    if len(array) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(len(array) - 1):\n        if array[i] > array[i+1]:\n            is_increasing = False\n        if array[i] < array[i+1]:\n            is_decreasing = False\n\n    return is_increasing or is_decreasing"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list: list, sublist: list) -> bool:\n    \"\"\"\n    Checks if a sublist is contiguously present within a main list.\n    Handles empty sublists, which are always considered present.\n    \"\"\"\n    len_main = len(main_list)\n    len_sub = len(sublist)\n\n    if len_sub == 0:\n        return True\n    if len_sub > len_main:\n        return False\n\n    for i in range(len_main - len_sub + 1):\n        if main_list[i : i + len_sub] == sublist:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(elements: list) -> list:\n    \"\"\"\n    Sorts a list of elements in ascending order using the Comb Sort algorithm.\n    Returns a new list containing the sorted elements.\n    \"\"\"\n    arr = elements[:]\n    n = len(arr)\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        gap = int(gap / shrink_factor)\n        if gap < 1:\n            gap = 1\n\n        swapped = False\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    return arr"}
{"task_id": "Mbpp/74", "solution": "class ElementMapper:\n    \"\"\"\n    Manages and validates the one-to-one mapping between pattern and sequence elements.\n    It ensures consistency according to business rules.\n    \"\"\"\n    def __init__(self):\n        self._pattern_to_sequence_map = {}\n        self._sequence_to_pattern_map = {}\n\n    def add_mapping(self, pattern_element: str, sequence_element: str) -> bool:\n        \"\"\"\n        Attempts to add a mapping between a pattern element and a sequence element.\n        Returns True if successful, False if the mapping is inconsistent.\n        \"\"\"\n        # Check if pattern_element already has a mapping\n        if self.has_pattern_mapping(pattern_element):\n            if self.get_sequence_mapping(pattern_element) != sequence_element:\n                return False  # Inconsistent mapping for pattern_element\n        \n        # Check if sequence_element already has a mapping\n        if self.has_sequence_mapping(sequence_element):\n            if self.get_pattern_mapping(sequence_element) != pattern_element:\n                return False  # Inconsistent mapping for sequence_element\n\n        # If no conflicts, add the mapping in both directions\n        self._pattern_to_sequence_map[pattern_element] = sequence_element\n        self._sequence_to_pattern_map[sequence_element] = pattern_element\n        return True\n\n    def get_sequence_mapping(self, pattern_element: str) -> str | None:\n        \"\"\"Returns the sequence element mapped to a given pattern element, or None if no mapping exists.\"\"\"\n        return self._pattern_to_sequence_map.get(pattern_element)\n\n    def get_pattern_mapping(self, sequence_element: str) -> str | None:\n        \"\"\"Returns the pattern element mapped to a given sequence element, or None if no mapping exists.\"\"\"\n        return self._sequence_to_pattern_map.get(sequence_element)\n\n    def has_pattern_mapping(self, pattern_element: str) -> bool:\n        \"\"\"Checks if a pattern element already has a mapping.\"\"\"\n        return pattern_element in self._pattern_to_sequence_map\n\n    def has_sequence_mapping(self, sequence_element: str) -> bool:\n        \"\"\"Checks if a sequence element already has a mapping.\"\"\"\n        return sequence_element in self._sequence_to_pattern_map\ndef is_samepatterns(sequence: list[str], pattern: list[str]) -> bool:\n    \"\"\"\n    Checks whether a given sequence of strings follows the sequence given in the patterns array.\n    It establishes a consistent one-to-one mapping between unique elements.\n    \"\"\"\n    if len(sequence) != len(pattern):\n        return False\n\n    mapper = ElementMapper()\n    for p_elem, s_elem in zip(pattern, sequence):\n        if not mapper.add_mapping(p_elem, s_elem):\n            return False\n            \n    return True"}
