{"task_id": "Mbpp/453", "solution": "import math\ndef _get_factors(number: int) -> list[int]:\n    \"\"\"\n    Finds all factors of a given positive integer.\n    \"\"\"\n    factors = []\n    for i in range(1, int(math.sqrt(number)) + 1):\n        if number % i == 0:\n            factors.append(i)\n            if i * i != number:\n                factors.append(number // i)\n    return sorted(factors)\ndef _is_even(number: int) -> bool:\n    \"\"\"\n    Checks if a given integer is an even number.\n    \"\"\"\n    return number % 2 == 0\ndef sumofFactors(number: int) -> int:\n    \"\"\"\n    Calculates the sum of all even factors for a given positive integer.\n    \"\"\"\n    all_factors = _get_factors(number)\n    even_factors_sum = 0\n\n    for factor in all_factors:\n        if _is_even(factor):\n            even_factors_sum += factor\n\n    return even_factors_sum"}
