{"task_id": "Mbpp/129", "solution": "import math\nclass Matrix:\n    \"\"\"\n    Encapsulates matrix data and provides methods for checking squareness and calculating various sums.\n    \"\"\"\n    def __init__(self, elements: list[list[int]]):\n        self._elements = elements\n        self._rows = len(elements)\n        self._columns = len(elements[0]) if self._rows > 0 else 0\n\n    def is_square(self) -> bool:\n        \"\"\"Determines if the matrix is a square matrix (rows == columns).\"\"\"\n        return self._rows == self._columns\n\n    def get_size(self) -> int:\n        \"\"\"Returns the dimension 'n' for an n x n square matrix. Raises ValueError if not square.\"\"\"\n        if not self.is_square():\n            raise ValueError(\"Matrix is not square.\")\n        return self._rows\n\n    def get_row_sum(self, row_index: int) -> int:\n        \"\"\"Calculates the sum of elements in a specified row.\"\"\"\n        return sum(self._elements[row_index])\n\n    def get_column_sum(self, col_index: int) -> int:\n        \"\"\"Calculates the sum of elements in a specified column.\"\"\"\n        col_sum = 0\n        for i in range(self._rows):\n            col_sum += self._elements[i][col_index]\n        return col_sum\n\n    def get_main_diagonal_sum(self) -> int:\n        \"\"\"Calculates the sum of elements along the main diagonal (top-left to bottom-right).\"\"\"\n        diag_sum = 0\n        for i in range(self._rows):\n            diag_sum += self._elements[i][i]\n        return diag_sum\n\n    def get_anti_diagonal_sum(self) -> int:\n        \"\"\"Calculates the sum of elements along the anti-diagonal (top-right to bottom-left).\"\"\"\n        anti_diag_sum = 0\n        size = self._rows\n        for i in range(size):\n            anti_diag_sum += self._elements[i][size - 1 - i]\n        return anti_diag_sum\ndef magic_square_test(matrix_data: list[list[int]]) -> bool:\n    \"\"\"\n    Checks if the input matrix_data represents a magic square.\n    A magic square is a square matrix where the sum of each row, each column,\n    and both main and anti-diagonals are all equal.\n    \"\"\"\n    matrix = Matrix(matrix_data)\n\n    if not matrix.is_square():\n        return False\n\n    size = matrix.get_size()\n\n    # A 0x0 matrix cannot be a magic square.\n    if size == 0:\n        return False\n\n    # Calculate the expected sum from the first row\n    expected_sum = matrix.get_row_sum(0)\n\n    # Check all row sums\n    for i in range(size):\n        if matrix.get_row_sum(i) != expected_sum:\n            return False\n\n    # Check all column sums\n    for j in range(size):\n        if matrix.get_column_sum(j) != expected_sum:\n            return False\n\n    # Check main diagonal sum\n    if matrix.get_main_diagonal_sum() != expected_sum:\n        return False\n\n    # Check anti-diagonal sum\n    if matrix.get_anti_diagonal_sum() != expected_sum:\n        return False\n\n    return True"}
