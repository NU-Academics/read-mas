{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, char_to_remove: str) -> str:\n    \"\"\"Removes the first and last occurrences of a given character from the string.\n    It constructs a new string by skipping characters at the identified first and last indices.\n    \"\"\"\n    first_idx = input_string.find(char_to_remove)\n    last_idx = input_string.rfind(char_to_remove)\n\n    # If the character is not found, or if it's found but first_idx is -1, return original string\n    if first_idx == -1:\n        return input_string\n\n    result_string = []\n    for i, char in enumerate(input_string):\n        if i == first_idx:\n            # Skip the first occurrence\n            first_idx = -1 # Mark as processed, in case first_idx == last_idx\n            continue\n        if i == last_idx:\n            # Skip the last occurrence\n            continue\n        result_string.append(char)\n\n    return \"\".join(result_string)"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks if two integers differ at exactly one bit position.\n    This is determined by XORing the numbers and counting the set bits in the result.\n    \"\"\"\n    xor_result = num1 ^ num2\n    return bin(xor_result).count('1') == 1"}
{"task_id": "Mbpp/3", "solution": "import math\ndef is_not_prime(number: int) -> bool:\n    \"\"\"Determines if an integer is a non-prime number.\n\n    Returns True if the number is non-prime, False if it is prime or not a non-prime (e.g., <= 1).\n    \"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return False\n    if number % 2 == 0:\n        return True\n    \n    # Check for odd divisors from 3 up to the square root of the number\n    for i in range(3, int(math.sqrt(number)) + 1, 2):\n        if number % i == 0:\n            return True\n    return False"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(list1: tuple, list2: tuple) -> set:\n    \"\"\"Finds shared elements between two input tuples/iterables.\n    A common approach is to convert both inputs to sets and find their intersection.\n    \"\"\"\n    set1 = set(list1)\n    set2 = set(list2)\n    return set1.intersection(set2)"}
