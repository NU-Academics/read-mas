{"task_id": "Mbpp/448", "solution": "_perrin_cache = {}\ndef _calculate_perrin_number(k: int) -> int:\n    \"\"\"\n    Calculates the k-th Perrin number.\n    Uses P(n) = P(n-2) + P(n-3) for n > 2 and base cases P(0)=3, P(1)=0, P(2)=2.\n    \"\"\"\n    if k in _perrin_cache:\n        return _perrin_cache[k]\n\n    if k == 0:\n        result = 3\n    elif k == 1:\n        result = 0\n    elif k == 2:\n        result = 2\n    else:\n        result = _calculate_perrin_number(k - 2) + _calculate_perrin_number(k - 3)\n\n    _perrin_cache[k] = result\n    return result\ndef cal_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of Perrin numbers from P(0) to P(n).\n    Iterates from 0 to n, calling _calculate_perrin_number for each index and summing the results.\n    \"\"\"\n    total_sum = 0\n    _perrin_cache.clear()\n    for i in range(n + 1):\n        total_sum += _calculate_perrin_number(i)\n    return total_sum"}
