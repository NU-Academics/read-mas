{"task_id": "Mbpp/286", "solution": "def max_sub_array_sum_repeated(arr: list[int], k: int) -> int:\n    \"\"\"\n    Calculates the largest sum of a contiguous subarray in the modified array\n    formed by repeating the given array `k` times.\n    \"\"\"\n    if not arr or k == 0:\n        return 0\n\n    def _kadane(sub_arr: list[int]) -> int:\n        \"\"\"Applies Kadane's algorithm to find the maximum contiguous subarray sum.\"\"\"\n        max_so_far = float('-inf')\n        current_max = 0\n        has_positive = False\n        for x in sub_arr:\n            if x >= 0:\n                has_positive = True\n            current_max += x\n            max_so_far = max(max_so_far, current_max)\n            if current_max < 0:\n                current_max = 0\n        \n        # If all numbers are negative, Kadane's algorithm as implemented above might return 0.\n        # We need to return the largest single element if all are negative.\n        if not has_positive and all(x < 0 for x in sub_arr):\n            return max(sub_arr)\n        \n        return max_so_far if max_so_far != float('-inf') else 0\n\n\n    def _get_array_properties(sub_arr: list[int]) -> tuple[int, int, int]:\n        \"\"\"\n        Calculates the total sum, maximum prefix sum, and maximum suffix sum of an array.\n        \"\"\"\n        total_sum = sum(sub_arr)\n\n        max_prefix_sum = 0\n        current_prefix_sum = 0\n        for x in sub_arr:\n            current_prefix_sum += x\n            max_prefix_sum = max(max_prefix_sum, current_prefix_sum)\n\n        max_suffix_sum = 0\n        current_suffix_sum = 0\n        for x in reversed(sub_arr):\n            current_suffix_sum += x\n            max_suffix_sum = max(max_suffix_sum, current_suffix_sum)\n\n        return total_sum, max_prefix_sum, max_suffix_sum\n\n    max_single_kadane_sum = _kadane(arr)\n\n    if k == 1:\n        return max_single_kadane_sum\n\n    total_arr_sum, max_prefix_sum, max_suffix_sum = _get_array_properties(arr)\n\n    # Case 1: The maximum sum is entirely within one of the original arrays.\n    # This is handled by max_single_kadane_sum.\n\n    # Case 2: The maximum sum spans across repetitions.\n    # It can be formed by max suffix sum of first array + (k-2)*total_sum + max prefix sum of last array.\n    # Or it can be formed by a sum across two concatenated arrays (arr + arr).\n    \n    # Calculate for `arr + arr` to cover cases where total_arr_sum is negative\n    # but a prefix and suffix combine to a larger sum, or max_single_kadane_sum is in the second array.\n    max_double_kadane_sum = _kadane(arr + arr)\n    \n    # If total sum is non-negative, repeating it `k-2` times can increase the sum.\n    # Otherwise, we mainly care about segments spanning at most two original arrays.\n    if total_arr_sum >= 0:\n        result = max(max_single_kadane_sum, max_prefix_sum + max_suffix_sum + (k - 2) * total_arr_sum)\n    else:\n        # If total_arr_sum is negative, we only care about sums that span at most two arrays.\n        # Further repetitions with negative total_arr_sum would only decrease the sum.\n        result = max(max_single_kadane_sum, max_double_kadane_sum)\n    \n    return result"}
{"task_id": "Mbpp/292", "solution": "import math\nclass Number:\n    \"\"\"Represents a numerical value.\"\"\"\n    def __init__(self, value: float):\n        self.value = value\nclass Calculator:\n    \"\"\"Provides the core logic for calculating the integer quotient with floor rounding.\"\"\"\n    def calculate_integer_quotient(self, dividend: Number, divisor: Number) -> int:\n        \"\"\"Calculates the quotient and rounds it down to the nearest integer, handling division by zero.\"\"\"\n        if divisor.value == 0:\n            raise ZeroDivisionError(\"Divisor cannot be zero.\")\n        raw_quotient = dividend.value / divisor.value\n        return math.floor(raw_quotient)\ndef find(dividend: float, divisor: float) -> int:\n    \"\"\"\n    Calculates the integer quotient of two numbers, rounded down to the nearest integer.\n    \"\"\"\n    dividend_obj = Number(dividend)\n    divisor_obj = Number(divisor)\n    calculator = Calculator()\n    return calculator.calculate_integer_quotient(dividend_obj, divisor_obj)"}
{"task_id": "Mbpp/293", "solution": "import math\ndef otherside_rightangle(leg1, leg2):\n    \"\"\"\n    Calculates the hypotenuse of a right-angled triangle given its two legs.\n    Uses the Pythagorean theorem to compute the length.\n    \"\"\"\n    hypotenuse_squared = leg1**2 + leg2**2\n    hypotenuse = math.sqrt(hypotenuse_squared)\n    return hypotenuse"}
{"task_id": "Mbpp/290", "solution": "def max_length(list_of_lists: list[list[any]]) -> tuple[int, list[any]]:\n    \"\"\"\n    Finds the sublist with the maximum length in a list of lists.\n\n    Args:\n        list_of_lists: A list of lists, where each inner list can contain elements of any type.\n\n    Returns:\n        A tuple where the first element is the length of the maximum length sublist\n        and the second element is the maximum length sublist itself.\n    \"\"\"\n    max_len = 0\n    max_sublist = []\n\n    if not list_of_lists:\n        return (max_len, max_sublist)\n\n    for sublist in list_of_lists:\n        current_len = len(sublist)\n        if current_len > max_len:\n            max_len = current_len\n            max_sublist = sublist\n\n    return (max_len, max_sublist)"}
{"task_id": "Mbpp/294", "solution": "def _is_numerical(value: any) -> bool:\n    \"\"\"\n    Identifies if a given value is a numerical type (int or float).\n    \"\"\"\n    return isinstance(value, (int, float))\ndef max_val(heterogeneous_list: list) -> int | float | None:\n    \"\"\"\n    Finds the maximum numerical value in a given heterogeneous list, ignoring non-numerical elements.\n    Returns None if the list is empty or contains no numerical values.\n    \"\"\"\n    if not heterogeneous_list:\n        return None\n\n    numerical_values = []\n    for element in heterogeneous_list:\n        if _is_numerical(element):\n            numerical_values.append(element)\n\n    if not numerical_values:\n        return None\n\n    return max(numerical_values)"}
{"task_id": "Mbpp/296", "solution": "from typing import List, Union\ndef get_Inv_Count(arr: List[Union[int, float]]) -> int:\n    \"\"\"\n    Calculates the number of inversions in the input array.\n    An inversion is defined as a pair of elements (arr[i], arr[j]) such that i < j and arr[i] > arr[j].\n    \"\"\"\n    inv_count = 0\n    n = len(arr)\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            if arr[i] > arr[j]:\n                inv_count += 1\n    return inv_count"}
