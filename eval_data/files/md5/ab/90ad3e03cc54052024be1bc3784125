{"task_id": "Mbpp/562", "solution": "from typing import List, Any\nclass List_of_Lists:\n    \"\"\"Encapsulates the input list of lists and provides access to its sublists.\"\"\"\n    def __init__(self, input_data: List[List[Any]]):\n        self._sublists = input_data\n\n    def get_sublists(self) -> List[List[Any]]:\n        \"\"\"Returns the encapsulated list of sublists.\"\"\"\n        return self._sublists\nclass Sublist:\n    \"\"\"Represents an individual sublist and can calculate its own length.\"\"\"\n    def __init__(self, elements: List[Any]):\n        self._elements = elements\n        self._length = 0\n\n    def calculate_length(self) -> int:\n        \"\"\"Calculates and returns the length of the sublist.\"\"\"\n        self._length = len(self._elements)\n        return self._length\n\n    def get_length(self) -> int:\n        \"\"\"Returns the stored length of the sublist.\"\"\"\n        return self._length\nclass Length_Calculator:\n    \"\"\"Manages the process of determining all sublist lengths and finding the maximum among them.\"\"\"\n    def __init__(self, list_of_lists_obj: List_of_Lists):\n        self._list_of_lists_obj = list_of_lists_obj\n        self._sublist_lengths: List[int] = []\n        self._max_length = 0\n\n    def determine_sublist_lengths(self) -> None:\n        \"\"\"Iterates through sublists, calculates their lengths using Sublist objects, and stores them.\"\"\"\n        for sublist_elements in self._list_of_lists_obj.get_sublists():\n            sublist_obj = Sublist(sublist_elements)\n            self._sublist_lengths.append(sublist_obj.calculate_length())\n\n    def identify_maximum_length(self) -> None:\n        \"\"\"Compares the stored sublist lengths to find and set the maximum.\"\"\"\n        if self._sublist_lengths:\n            self._max_length = max(self._sublist_lengths)\n        else:\n            self._max_length = 0 # Handle case of an empty list of lists\n\n    def return_maximum_length(self) -> int:\n        \"\"\"Returns the identified maximum length.\"\"\"\n        return self._max_length\ndef Find_Max_Length(input_data: List[List[Any]]) -> int:\n    \"\"\"\n    Finds the length of the longest sublists within a given list of lists.\n    It orchestrates List_of_Lists and Length_Calculator objects to compute the result.\n    \"\"\"\n    list_of_lists_obj = List_of_Lists(input_data)\n    length_calculator_obj = Length_Calculator(list_of_lists_obj)\n    \n    length_calculator_obj.determine_sublist_lengths()\n    length_calculator_obj.identify_maximum_length()\n    \n    return length_calculator_obj.return_maximum_length()"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"Calculates the sum of absolute per-digit differences between two integers.\"\"\"\n    s_num1 = str(num1)\n    s_num2 = str(num2)\n\n    max_len = max(len(s_num1), len(s_num2))\n\n    # Pad the shorter string with leading zeros to align digits\n    s_num1 = s_num1.zfill(max_len)\n    s_num2 = s_num2.zfill(max_len)\n\n    total_sum = 0\n    for i in range(max_len):\n        digit1 = int(s_num1[i])\n        digit2 = int(s_num2[i])\n        total_sum += abs(digit1 - digit2)\n\n    return total_sum"}
{"task_id": "Mbpp/560", "solution": "def union_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Computes the union of elements from two given tuples and outputs them in sorted order.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n    union_set = set1.union(set2)\n    sorted_union_list = sorted(list(union_set))\n    return tuple(sorted_union_list)"}
