{"task_id": "Mbpp/589", "solution": "def perfect_squares(lower_bound: int, upper_bound: int) -> list[int]:\n    \"\"\"\n    Finds perfect squares within a given inclusive range.\n    Uses a helper function to determine if a number is a perfect square.\n    \"\"\"\n    def _is_perfect_square(n: int) -> bool:\n        \"\"\"\n        Determines if a given number is a perfect square.\n        Calculates the integer square root and checks its square.\n        \"\"\"\n        if n < 0:\n            return False\n        if n == 0:\n            return True\n        root = int(n**0.5)\n        return root * root == n\n\n    perfect_squares_list = []\n    for num in range(lower_bound, upper_bound + 1):\n        if _is_perfect_square(num):\n            perfect_squares_list.append(num)\n    return perfect_squares_list"}
{"task_id": "Mbpp/588", "solution": "def big_diff(numbers: list) -> int:\n    \"\"\"\n    Calculates the difference between the largest and smallest values in a given list.\n    Returns 0 if the list is empty or contains only one element.\n    \"\"\"\n    if not numbers or len(numbers) < 2:\n        return 0\n\n    largest_value = max(numbers)\n    smallest_value = min(numbers)\n\n    return int(largest_value - smallest_value)"}
{"task_id": "Mbpp/591", "solution": "def swap_List(input_list: list) -> list:\n    \"\"\"\n    Interchanges the first and last elements of a list in-place and returns the modified list.\n    If the list has fewer than two elements, no swap is performed.\n    \"\"\"\n    if len(input_list) >= 2:\n        # Swap the first and last elements using tuple assignment for conciseness\n        input_list[0], input_list[-1] = input_list[-1], input_list[0]\n    return input_list"}
