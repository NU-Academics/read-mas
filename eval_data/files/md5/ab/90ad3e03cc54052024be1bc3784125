{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(input_list: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of the largest contiguous sublist within the given list.\n\n    Returns 0 if the input list is empty.\n    \"\"\"\n    if not input_list:\n        return 0\n\n    max_so_far = input_list[0]\n    current_sum = input_list[0]\n\n    for i in range(1, len(input_list)):\n        current_sum = max(input_list[i], current_sum + input_list[i])\n        max_so_far = max(max_so_far, current_sum)\n\n    return max_so_far"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string: str) -> str:\n    \"\"\"\n    Toggles the case of all alphabetic characters in the input string.\n    Non-alphabetic characters remain unchanged.\n    \"\"\"\n    toggled_chars = []\n    for char in input_string:\n        if 'a' <= char <= 'z':\n            toggled_chars.append(chr(ord(char) - 32))\n        elif 'A' <= char <= 'Z':\n            toggled_chars.append(chr(ord(char) + 32))\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(numbers: list[int]) -> int:\n    \"\"\"\n    Counts the number of unique pairs in a list whose bitwise XOR value is odd.\n    \"\"\"\n    odd_xor_pair_count = 0\n    n = len(numbers)\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            num1 = numbers[i]\n            num2 = numbers[j]\n            xor_value = num1 ^ num2\n            if xor_value % 2 != 0:  # Check if the XOR value is odd\n                odd_xor_pair_count += 1\n\n    return odd_xor_pair_count"}
