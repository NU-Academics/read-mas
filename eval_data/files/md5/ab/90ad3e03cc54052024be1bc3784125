{"task_id": "Mbpp/63", "solution": "class Element:\n    def __init__(self, value: int):\n        self.value = value\nclass AbsoluteDifference:\n    def __init__(self, value: int):\n        self.value = value\nclass Pair:\n    def __init__(self, val1: int, val2: int):\n        self.element1 = Element(val1)\n        self.element2 = Element(val2)\n\n    def calculate_absolute_difference(self) -> AbsoluteDifference:\n        \"\"\"Calculates and returns the absolute difference between its elements.\"\"\"\n        diff_value = abs(self.element1.value - self.element2.value)\n        return AbsoluteDifference(diff_value)\ndef max_difference(tuple_list: list[tuple[int, int]]) -> int:\n    \"\"\"Finds the maximum absolute difference between elements in 2-element tuples.\"\"\"\n    if not tuple_list:\n        return 0\n\n    all_differences = []\n    for val1, val2 in tuple_list:\n        pair = Pair(val1, val2)\n        abs_diff_obj = pair.calculate_absolute_difference()\n        all_differences.append(abs_diff_obj.value)\n\n    max_val = max(all_differences)\n    # The design specifies returning the integer value directly rather than a MaximumDifference object.\n    return max_val"}
{"task_id": "Mbpp/59", "solution": "def is_octagonal(n: int) -> int:\n    \"\"\"\n    Calculates the nth octagonal number.\n    Raises ValueError if n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n    return n * (3 * n - 2)"}
{"task_id": "Mbpp/62", "solution": "def smallest_num(numbers):\n    \"\"\"\n    Finds the smallest number in a list of numbers.\n    Assumes the input list is not empty.\n    \"\"\"\n    min_value = numbers[0]\n    for num in numbers[1:]:\n        if num < min_value:\n            min_value = num\n    return min_value"}
{"task_id": "Mbpp/61", "solution": "def _calculate_sum_of_digits(substring_value: str) -> int:\n    \"\"\"Calculates the sum of digits for a given string.\"\"\"\n    return sum(int(digit) for digit in substring_value)\ndef _get_substring_length(substring_value: str) -> int:\n    \"\"\"Calculates the length of a given string.\"\"\"\n    return len(substring_value)\ndef count_Substrings(input_string: str) -> int:\n    \"\"\"\n    Counts the number of substrings with the sum of digits equal to their length.\n    Iterates through all possible substrings and checks the condition.\n    \"\"\"\n    count = 0\n    n = len(input_string)\n\n    for i in range(n):\n        for j in range(i, n):\n            current_substring = input_string[i:j+1]\n            sum_of_digits = _calculate_sum_of_digits(current_substring)\n            length = _get_substring_length(current_substring)\n\n            if sum_of_digits == length:\n                count += 1\n    return count"}
{"task_id": "Mbpp/70", "solution": "def get_equal(collection_of_tuples: list[tuple]) -> bool:\n    \"\"\"\n    Determines if all tuples in the given collection have equal length.\n    Returns True for empty or single-tuple collections.\n    \"\"\"\n    if len(collection_of_tuples) <= 1:\n        return True\n\n    reference_length = len(collection_of_tuples[0])\n    for i in range(1, len(collection_of_tuples)):\n        if len(collection_of_tuples[i]) != reference_length:\n            return False\n    return True"}
{"task_id": "Mbpp/67", "solution": "import math\n_bell_cache = {}\ndef _combinations(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient 'n choose k'.\"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2: # Optimization: C(n, k) = C(n, n-k)\n        k = n - k\n    \n    numerator = math.factorial(n)\n    denominator = math.factorial(k) * math.factorial(n - k)\n    return numerator // denominator\ndef bell_number(n: int) -> int:\n    \"\"\"Calculates the n-th Bell number using memoization and its recurrence relation.\"\"\"\n    if n in _bell_cache:\n        return _bell_cache[n]\n\n    if n == 0:\n        _bell_cache[0] = 1\n        return 1\n\n    # B_n = sum(k=0 to n-1) C(n-1, k) * B_k\n    sum_val = 0\n    for k in range(n):\n        term = _combinations(n - 1, k) * bell_number(k)\n        sum_val += term\n\n    _bell_cache[n] = sum_val\n    return sum_val"}
{"task_id": "Mbpp/66", "solution": "from typing import List, Union\ndef _is_positive(number: Union[int, float]) -> bool:\n    \"\"\"Checks if a given number is strictly positive.\"\"\"\n    return number > 0\ndef pos_count(numbers: List[Union[int, float]]) -> int:\n    \"\"\"Counts the number of positive numbers in a list.\"\"\"\n    positive_count = 0\n    for num in numbers:\n        if _is_positive(num):\n            positive_count += 1\n    return positive_count"}
