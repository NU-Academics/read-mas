{"task_id": "Mbpp/271", "solution": "def even_Power_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the first n even natural numbers, each raised to the fifth power.\n    Raises a ValueError if n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    total_sum = 0\n    for i in range(1, n + 1):\n        even_number = 2 * i\n        total_sum += even_number ** 5\n    return total_sum"}
{"task_id": "Mbpp/274", "solution": "import math\ndef _calculate_binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"\n    Computes the binomial coefficient C(n, k).\n    Assumes n and k are non-negative integers with k <= n.\n    \"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n\n    return math.comb(n, k)\ndef even_binomial_Coeff_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of binomial coefficients C(n, k) for all even indices k\n    where 0 <= k <= n.\n    \"\"\"\n    _validate_positive_integer(n)\n\n    total_sum = 0\n    for k in range(0, n + 1, 2):\n        total_sum += _calculate_binomial_coefficient(n, k)\n\n    return total_sum"}
