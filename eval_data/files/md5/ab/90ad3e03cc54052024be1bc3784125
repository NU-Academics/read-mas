{"task_id": "Mbpp/415", "solution": "def max_Product(arr: list[int]) -> tuple[int, int]:\n    \"\"\"\n    Finds a pair of integers from the input array with the highest product.\n    This handles both positive and negative numbers by tracking the two largest\n    and two smallest values.\n    \"\"\"\n    max1 = float('-inf')  # Stores the largest number\n    max2 = float('-inf')  # Stores the second largest number\n    min1 = float('inf')   # Stores the smallest number\n    min2 = float('inf')   # Stores the second smallest number\n\n    for num in arr:\n        # Update the two largest numbers\n        if num > max1:\n            max2 = max1\n            max1 = num\n        elif num > max2:\n            max2 = num\n        \n        # Update the two smallest numbers\n        if num < min1:\n            min2 = min1\n            min1 = num\n        elif num < min2:\n            min2 = num\n    \n    # The highest product can either be from the two largest positive numbers\n    # or from the two smallest negative numbers (since negative * negative = positive).\n    if max1 * max2 > min1 * min2:\n        return (max2, max1) if max2 < max1 else (max1, max2)\n    else:\n        return (min1, min2) if min1 < min2 else (min2, min1)"}
{"task_id": "Mbpp/421", "solution": "def concatenate_tuple(input_tuple: tuple, delimiter: str = '-') -> str:\n    \"\"\"\n    Concatenates each element of the input_tuple into a single string,\n    using the specified delimiter between elements.\n    Each element is converted to its string representation.\n    \"\"\"\n    if not input_tuple:\n        return \"\"\n\n    string_elements = map(str, input_tuple)\n    return delimiter.join(string_elements)"}
{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n: int) -> float:\n    \"\"\"Computes the average of cubes of the first 'n' natural numbers.\n    Assumes n is a positive integer.\n    \"\"\"\n    sum_of_cubes = 0.0\n    for i in range(1, n + 1):\n        sum_of_cubes += i * i * i\n    \n    return sum_of_cubes / n"}
