{"task_id": "Mbpp/603", "solution": "def _sieve_primes(limit: int) -> list[int]:\n    \"\"\"Generates a list of prime numbers up to a given limit using the Sieve of Eratosthenes algorithm.\"\"\"\n    if limit < 2:\n        return []\n\n    is_prime = [True] * (limit + 1)\n    is_prime[0] = is_prime[1] = False\n\n    p = 2\n    while p * p <= limit:\n        if is_prime[p]:\n            for multiple in range(p * p, limit + 1, p):\n                is_prime[multiple] = False\n        p += 1\n\n    primes = [i for i, prime_check in enumerate(is_prime) if prime_check]\n    return primes\ndef get_ludic(n: int) -> list[int]:\n    \"\"\"Calculates and returns a sorted list containing 1 and all prime numbers less than or equal to a given integer n.\"\"\"\n    # Ensure 1 is always included as per requirements if n >= 1.\n    # For n < 1, the sieve yields no primes, so only 1 is returned.\n    if n < 1:\n        return [1]\n\n    prime_numbers = _sieve_primes(n)\n    \n    # Prepend 1 to the list of prime numbers.\n    # Since _sieve_primes returns an already sorted list,\n    # prepending 1 maintains the sorted order.\n    return [1] + prime_numbers"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number using dynamic programming.\n    The Bell numbers count the number of partitions of a set with n elements.\n    \"\"\"\n    # Create a 2D list to store the Bell triangle values.\n    # bell[i][j] represents the j-th value in the i-th row of the Bell triangle.\n    # bell[i][0] will store the i-th Bell number, B(i).\n    bell = [[0 for _ in range(n + 1)] for _ in range(n + 1)]\n\n    # Initialize the first Bell number B(0) = 1.\n    bell[0][0] = 1\n\n    # Fill the Bell triangle using the recurrence relations.\n    # B(i) = bell[i][0]\n    # bell[i][0] = bell[i-1][i-1] (the last element of the previous row)\n    # bell[i][j] = bell[i-1][j-1] + bell[i][j-1] (for j > 0)\n    for i in range(1, n + 1):\n        # The first element of the current row is the last element of the previous row.\n        bell[i][0] = bell[i - 1][i - 1]\n        # Fill the rest of the current row.\n        for j in range(1, i + 1):\n            bell[i][j] = bell[i - 1][j - 1] + bell[i][j - 1]\n\n    # The nth Bell number is stored at bell[n][0].\n    return bell[n][0]"}
{"task_id": "Mbpp/607", "solution": "import re\ndef find_literals(target_string: str, pattern: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Searches a string for a regex pattern and returns the matching substring, start, and end indices.\n    Returns None if no match is found.\n    \"\"\"\n    match = re.search(pattern, target_string)\n    if match:\n        return (match.group(0), match.start(), match.end())\n    return None"}
{"task_id": "Mbpp/611", "solution": "import math\nfrom typing import List\ndef max_of_nth(matrix: List[List[int]], n: int) -> int:\n    \"\"\"\n    Computes the maximum value of the n'th column in a matrix.\n    Assumes valid input for matrix and n, and that the column exists and contains elements.\n    \"\"\"\n    column_elements = []\n    for row in matrix:\n        column_elements.append(row[n])\n    return max(column_elements)"}
{"task_id": "Mbpp/612", "solution": "def merge(list_of_pairs: list) -> list:\n    \"\"\"\n    Separates elements from a list of two-element sublists into two distinct lists.\n    Collects first elements into one list and second elements into another, preserving order.\n    \"\"\"\n    first_elements_list = []\n    second_elements_list = []\n    for pair in list_of_pairs:\n        first_elements_list.append(pair[0])\n        second_elements_list.append(pair[1])\n    return [first_elements_list, second_elements_list]"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list: list, k: int) -> list:\n    \"\"\"\n    Returns a new list with the k-th (1-indexed) element removed.\n\n    Raises:\n        IndexError: If k is out of the valid 1-indexed range for the input_list.\n    \"\"\"\n    if not (1 <= k <= len(input_list)):\n        raise IndexError(f\"k ({k}) is out of 1-indexed range for list of length {len(input_list)}\")\n\n    zero_indexed_k = k - 1\n    new_list = input_list[:zero_indexed_k] + input_list[zero_indexed_k + 1:]\n\n    return new_list"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(data):\n    \"\"\"\n    Calculates the average value for each inner tuple in a tuple of tuples.\n    Returns 0.0 for an empty inner tuple.\n    \"\"\"\n    averages = []\n    for inner_tuple in data:\n        if not inner_tuple:\n            averages.append(0.0)\n            continue\n\n        current_sum = sum(inner_tuple)\n        average = current_sum / len(inner_tuple)\n        averages.append(average)\n\n    return averages"}
