{"task_id": "Mbpp/395", "solution": "from typing import Optional\ndef first_non_repeating_character(input_string: str) -> Optional[str]:\n    # Use a dictionary to store character frequencies.\n    char_counts = {}\n\n    # First pass: Populate character frequencies.\n    for char in input_string:\n        char_counts[char] = char_counts.get(char, 0) + 1\n\n    # Second pass: Iterate through the string in original order to find the first non-repeating character.\n    for char in input_string:\n        if char_counts[char] == 1:\n            return char\n\n    # If the loop completes, no non-repeating character was found.\n    return None"}
{"task_id": "Mbpp/397", "solution": "class Number:\n    \"\"\"Encapsulates a numerical value and provides comparison methods.\"\"\"\n    def __init__(self, value: float):\n        self._value = float(value)\n\n    def get_value(self) -> float:\n        \"\"\"Returns the encapsulated float value.\"\"\"\n        return self._value\n\n    def __lt__(self, other) -> bool:\n        if isinstance(other, Number):\n            return self._value < other._value\n        return self._value < other\n\n    def __gt__(self, other) -> bool:\n        if isinstance(other, Number):\n            return self._value > other._value\n        return self._value > other\n\n    def __eq__(self, other) -> bool:\n        if isinstance(other, Number):\n            return self._value == other._value\n        return self._value == other\nclass MedianCalculator:\n    \"\"\"Calculates the median of three Number objects.\"\"\"\n    def calculate(self, num1: Number, num2: Number, num3: Number) -> Number:\n        \"\"\"Determines and returns the median of the three input numbers.\"\"\"\n        numbers = [num1, num2, num3]\n        numbers.sort(key=lambda x: x.get_value())\n        return numbers[1]\ndef median_numbers(num1: float, num2: float, num3: float) -> float:\n    \"\"\"Finds the median of three numbers.\"\"\"\n    number1_obj = Number(num1)\n    number2_obj = Number(num2)\n    number3_obj = Number(num3)\n\n    calculator = MedianCalculator()\n    median_number_obj = calculator.calculate(number1_obj, number2_obj, number3_obj)\n\n    return median_number_obj.get_value()"}
{"task_id": "Mbpp/392", "solution": "class MaxSumCalculator:\n    \"\"\"Manages the memoization cache and performs recursive sum calculation.\"\"\"\n    def __init__(self):\n        self._memoization_cache = {}\n\n    def _calculate_max_sum_recursive(self, n: int) -> int:\n        \"\"\"Performs the recursive calculation for max sum, applying memoization.\"\"\"\n        if n in self._memoization_cache:\n            return self._memoization_cache[n]\n\n        if n < 2:\n            self._memoization_cache[n] = n\n            return n\n\n        sum_of_parts = (\n            self._calculate_max_sum_recursive(n // 2) +\n            self._calculate_max_sum_recursive(n // 3) +\n            self._calculate_max_sum_recursive(n // 4) +\n            self._calculate_max_sum_recursive(n // 5)\n        )\n\n        max_val = max(sum_of_parts, n)\n        self._memoization_cache[n] = max_val\n        return max_val\n_calculator_instance = MaxSumCalculator()\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Calculates the maximum sum for n using f(n) = max((f(n/2) + f(n/3) + f(n/4) + f(n/5)), n),\n    with memoization for efficiency.\n    \"\"\"\n    return _calculator_instance._calculate_max_sum_recursive(n)"}
{"task_id": "Mbpp/391", "solution": "from typing import List, Any, Dict\ndef convert_list_dictionary(list1: List[Any], list2: List[Any], list3: List[Any]) -> List[Dict[Any, Dict[Any, Any]]]:\n    \"\"\"\n    Converts three input lists into a list of nested dictionaries.\n    Each element from list1 becomes an outer dictionary key, list2 an inner key, and list3 an inner value.\n    \"\"\"\n    if not (len(list1) == len(list2) == len(list3)):\n        raise ValueError(\"All input lists must be of equal length.\")\n\n    result_list = []\n    for i in range(len(list1)):\n        outer_key = list1[i]\n        inner_key = list2[i]\n        inner_value = list3[i]\n\n        inner_dict = {inner_key: inner_value}\n        outer_dict = {outer_key: inner_dict}\n        result_list.append(outer_dict)\n    return result_list"}
{"task_id": "Mbpp/398", "solution": "class Number:\n    \"\"\"Represents an integer and provides a method to calculate the sum of its digits.\"\"\"\n\n    def __init__(self, value: int):\n        self._value = value\n\n    def getDigitSum(self) -> int:\n        \"\"\"Computes and returns the sum of the digits of the number.\"\"\"\n        abs_value = abs(self._value)\n        digit_sum = 0\n        for digit_char in str(abs_value):\n            digit_sum += int(digit_char)\n        return digit_sum\ndef sum_of_digits(numbers: list[int]) -> int:\n    \"\"\"Computes the total sum of digits for a list of numbers.\n    It aggregates individual sums to return a single total sum.\n    \"\"\"\n    total_sum = 0\n    for num_value in numbers:\n        number_obj = Number(num_value)\n        total_sum += number_obj.getDigitSum()\n    return total_sum"}
