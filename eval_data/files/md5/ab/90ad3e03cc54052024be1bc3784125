{"task_id": "Mbpp/299", "solution": "def max_aggregate(entries: list[tuple[str, int]]) -> tuple[str, int]:\n    \"\"\"Calculates the maximum aggregate score from a list of name-score entries.\n\n    Returns a tuple containing the name with the highest total score and their total score.\n    \"\"\"\n    if not entries:\n        return ('', 0)\n\n    aggregated_scores = {}\n    for name, score in entries:\n        aggregated_scores[name] = aggregated_scores.get(name, 0) + score\n\n    max_name = ''\n    max_total_score = 0\n\n    # Initialize with the first entry if available, to handle negative scores correctly if needed\n    # The current assertion implies scores are positive, but this is a more robust initialization.\n    # However, for simplicity and matching the problem's implied positive scores,\n    # initializing with 0 and empty string is fine as it will be overwritten.\n    if aggregated_scores:\n        # Find the name with the maximum total score\n        max_name = max(aggregated_scores, key=aggregated_scores.get)\n        max_total_score = aggregated_scores[max_name]\n\n    return (max_name, max_total_score)"}
{"task_id": "Mbpp/305", "solution": "class Word:\n    \"\"\"Encapsulates a string value and provides a method to determine if it starts with 'P'.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def startsWithP(self) -> bool:\n        \"\"\"Returns True if the word's value starts with 'P' (case-sensitive), False otherwise.\"\"\"\n        return self.value.startswith('P')\ndef start_withp(input_list_of_strings: list[str]) -> tuple[str, str]:\n    \"\"\"\n    Extracts and returns the first two words starting with 'P' from the input list of strings.\n    If fewer than two P-words are found, empty strings are used as placeholders for missing words.\n    \"\"\"\n    p_words_found = []\n    for line_string in input_list_of_strings:\n        words_in_line = line_string.split()\n        for word_str in words_in_line:\n            current_word = Word(word_str)\n            if current_word.startsWithP():\n                p_words_found.append(word_str)\n                if len(p_words_found) == 2:\n                    return (p_words_found[0], p_words_found[1])\n    \n    # Pad the list with empty strings if fewer than two P-words were found\n    while len(p_words_found) < 2:\n        p_words_found.append(\"\") \n        \n    return (p_words_found[0], p_words_found[1])"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(dictionary: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of dictionaries.\n    The outermost dictionary is considered level 1.\n    \"\"\"\n    max_depth = 1\n    for key, value in dictionary.items():\n        if isinstance(value, dict):\n            # Recursively call for nested dictionaries and add 1 for the current level\n            depth = dict_depth(value) + 1\n            max_depth = max(max_depth, depth)\n    return max_depth"}
