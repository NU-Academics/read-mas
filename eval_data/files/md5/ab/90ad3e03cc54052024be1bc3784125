{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(listOfLists: list) -> int:\n    \"\"\"Calculates and returns the length of the smallest sub-list from a given list of lists.\n    It raises ValueError if the input list is empty or TypeError if an element is not a list.\n    \"\"\"\n    if not listOfLists:\n        raise ValueError(\"Input list of lists cannot be empty.\")\n\n    min_length = float('inf')\n    for sublist in listOfLists:\n        if not isinstance(sublist, list):\n            raise TypeError(f\"Expected a list of lists, but found non-list element: {type(sublist)}\")\n        min_length = min(min_length, len(sublist))\n    return int(min_length)"}
{"task_id": "Mbpp/94", "solution": "from typing import List, Tuple, Any, TypeVar\n_Comparable = TypeVar('_Comparable')\ndef index_minimum(tuple_list: List[Tuple[Any, _Comparable]]) -> Any:\n    \"\"\"\n    Given a list of tuples, returns the first value of the tuple with the smallest second value.\n    In case of ties for the smallest second value, the tuple appearing earliest in the list is prioritized.\n    \"\"\"\n    min_tuple = tuple_list[0]\n    min_second_value = tuple_list[0][1]\n\n    for current_tuple in tuple_list[1:]:\n        current_second_value = current_tuple[1]\n\n        if current_second_value < min_second_value:\n            min_second_value = current_second_value\n            min_tuple = current_tuple\n\n    return min_tuple[0]"}
{"task_id": "Mbpp/97", "solution": "from typing import List, Dict, Any\nfrom collections import Counter\ndef frequency_lists(list_of_lists: List[List[Any]]) -> Dict[Any, int]:\n    \"\"\"\n    Calculates the frequency of each element in a flattened list of lists.\n\n    Args:\n        list_of_lists: A list where each element is itself a list of hashable elements.\n\n    Returns:\n        A dictionary where keys are unique elements and values are their frequencies.\n    \"\"\"\n    frequency_map = Counter()\n    for sublist in list_of_lists:\n        for element in sublist:\n            frequency_map[element] += 1\n    return dict(frequency_map)"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(numbers: tuple | list) -> float:\n    \"\"\"\n    Multiplies all numbers in a list and divides the product by the list's length.\n    Returns 0.0 if the input list is empty.\n    \"\"\"\n    if not numbers:\n        return 0.0\n\n    product = 1.0\n    for num in numbers:\n        product *= num\n\n    return product / len(numbers)"}
{"task_id": "Mbpp/101", "solution": "def kth_element(array: list, k_index: int):\n    \"\"\"\n    Finds the kth element in the given array using 1-based indexing.\n    Raises ValueError for invalid k_index or empty array, IndexError for out-of-bounds k_index.\n    \"\"\"\n    if not array:\n        raise ValueError(\"Array cannot be empty.\")\n    if k_index <= 0:\n        raise ValueError(\"K_Index must be a positive integer (1-based).\")\n    if k_index > len(array):\n        raise IndexError(f\"K_Index {k_index} is out of bounds for array of size {len(array)}.\")\n\n    return array[k_index - 1]"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_num: int) -> str:\n    \"\"\"\n    Converts a decimal integer to its binary string representation.\n    Ensures no leading zeros, except for '0' itself.\n    \"\"\"\n    if decimal_num == 0:\n        return '0'\n    \n    # Use built-in bin() function, then remove the \"0b\" prefix.\n    # The slicing handles both positive and negative numbers correctly if needed,\n    # but the problem implies positive integers.\n    return bin(decimal_num)[2:]"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome integer strictly greater than the input n.\n    This function handles both positive and non-positive integers.\n    \"\"\"\n    def is_palindrome(num: int) -> bool:\n        \"\"\"Checks if a given integer is a palindrome.\"\"\"\n        s = str(num)\n        return s == s[::-1]\n\n    current_number = n + 1\n    if n < 0:\n        current_number = 1\n\n    while True:\n        if is_palindrome(current_number):\n            return current_number\n        current_number += 1"}
