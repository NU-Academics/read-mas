{"task_id": "Mbpp/166", "solution": "def _is_even(number: int) -> bool:\n    \"\"\"Checks if an integer is even.\"\"\"\n    return number % 2 == 0\ndef find_even_pair(numbers: list[int]) -> int:\n    \"\"\"\n    Counts the number of pairs of integers in a list that XOR to an even number.\n    Pairs are counted if both numbers are even or both are odd.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for number in numbers:\n        if _is_even(number):\n            even_count += 1\n        else:\n            odd_count += 1\n    \n    # Calculate combinations of 2 even numbers\n    even_even_pairs = (even_count * (even_count - 1)) // 2\n    # Calculate combinations of 2 odd numbers\n    odd_odd_pairs = (odd_count * (odd_count - 1)) // 2\n    \n    return even_even_pairs + odd_odd_pairs"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Calculates the smallest power of 2 that is greater than or equal to n.\n    For n=0, it returns 1.\n    \"\"\"\n    if n == 0:\n        return 1\n    # For n > 0, (n - 1).bit_length() gives the number of bits required to represent n-1.\n    # Left-shifting 1 by this amount yields the smallest power of 2 greater than or equal to n.\n    return 1 << (n - 1).bit_length()"}
{"task_id": "Mbpp/170", "solution": "def sum_range_list(numbers: list, startIndex: int, endIndex: int) -> (int | float):\n    \"\"\"\n    Calculates the sum of numbers in a list within a specified inclusive range.\n    Returns 0 if the list is empty, indices are out of bounds, or startIndex > endIndex.\n    \"\"\"\n    if not numbers:\n        return 0\n    \n    list_length = len(numbers)\n    if not (0 <= startIndex < list_length and 0 <= endIndex < list_length):\n        return 0\n    \n    if startIndex > endIndex:\n        return 0\n    \n    total_sum = 0\n    for i in range(startIndex, endIndex + 1):\n        total_sum += numbers[i]\n        \n    return total_sum"}
