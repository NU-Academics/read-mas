{"task_id": "Mbpp/743", "solution": "def rotate_right(input_list: list, rotation_count: int) -> list:\n    \"\"\"Rotates a list to the right by a specified number of items.\"\"\"\n    if not input_list:\n        return []\n\n    if rotation_count < 0:\n        raise ValueError(\"rotation_count must be a non-negative integer.\")\n\n    list_length = len(input_list)\n    effective_rotation_count = rotation_count % list_length\n\n    if effective_rotation_count == 0:\n        return list(input_list) # Return a copy if no effective rotation\n\n    suffix = input_list[-effective_rotation_count:]\n    prefix = input_list[:-effective_rotation_count]\n\n    return suffix + prefix"}
{"task_id": "Mbpp/745", "solution": "import math\nfrom typing import List\nclass Number:\n    \"\"\"\n    Represents an integer and provides methods to check its digits and divisibility properties.\n    \"\"\"\n    def __init__(self, value: int):\n        self._value = value\n        self._digits = self._extract_digits()\n\n    def _extract_digits(self) -> List[int]:\n        \"\"\"Extracts individual digits from the number.\"\"\"\n        if self._value == 0:\n            return [0]\n        digits = []\n        temp_value = self._value\n        while temp_value > 0:\n            digits.append(temp_value % 10)\n            temp_value //= 10\n        return digits[::-1] # Reverse to get digits in order\n\n    def get_value(self) -> int:\n        \"\"\"Returns the integer value of the number.\"\"\"\n        return self._value\n\n    def contains_zero(self) -> bool:\n        \"\"\"Checks if any digit in the number is '0'.\"\"\"\n        return 0 in self._digits\n\n    def is_divisible_by_all_digits(self) -> bool:\n        \"\"\"Verifies if the number is perfectly divisible by all its non-zero constituent digits.\"\"\"\n        for digit in self._digits:\n            if digit == 0:  # Already handled by contains_zero, but defensive check\n                return False\n            if self._value % digit != 0:\n                return False\n        return True\ndef divisible_by_digits(startnum: int, endnum: int) -> List[int]:\n    \"\"\"\n    Finds numbers within a given range (startnum to endnum) where every number is divisible by every digit it contains.\n    Numbers containing the digit '0' are excluded.\n    \"\"\"\n    result_list = []\n    for num_value in range(startnum, endnum + 1):\n        number_obj = Number(num_value)\n        if not number_obj.contains_zero():\n            if number_obj.is_divisible_by_all_digits():\n                result_list.append(number_obj.get_value())\n    return result_list"}
{"task_id": "Mbpp/750", "solution": "def add_tuple(list_arg: list, tuple_arg: tuple) -> list:\n    \"\"\"\n    Appends all elements from 'tuple_arg' to the end of 'list_arg' and returns the modified list.\n    \"\"\"\n    list_arg.extend(tuple_arg)\n    return list_arg"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_string: str) -> str:\n    \"\"\"\n    Inserts spaces before words starting with capital letters in a string,\n    excluding the first character.\n    \"\"\"\n    if not input_string:\n        return \"\"\n\n    result_string = input_string[0]\n    for char in input_string[1:]:\n        if char.isupper():\n            result_string += \" \"\n        result_string += char\n    return result_string"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr: list[int | float]) -> bool:\n    \"\"\"Checks if the given array represents a min-heap.\n    An array satisfies the min-heap property if, for every non-leaf node, its value is less than or equal to its children's values.\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    # Iterate only through non-leaf nodes, the last non-leaf node is at index (n // 2) - 1\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n and arr[i] > arr[left_child_idx]:\n            return False\n\n        # Check right child\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n    return True"}
{"task_id": "Mbpp/749", "solution": "def sort_numeric_strings(string_numbers: list[str]) -> list[int]:\n    \"\"\"\n    Converts a list of string representations of numbers to integers and sorts them numerically in ascending order.\n    \"\"\"\n    numeric_list = []\n    for string_num in string_numbers:\n        numeric_list.append(int(string_num))\n    numeric_list.sort()\n    return numeric_list"}
{"task_id": "Mbpp/753", "solution": "def min_k(tuple_list: list[tuple[str, int]], k: int) -> list[tuple[str, int]]:\n    \"\"\"\n    Finds the minimum k records from a list of tuples based on their second element.\n    Returns the k tuples with the smallest second element, sorted.\n    \"\"\"\n    # Sort the list of tuples based on the second element (integer value)\n    sorted_list = sorted(tuple_list, key=lambda x: x[1])\n\n    # Return the first k elements from the sorted list\n    return sorted_list[:k]"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth Jacobsthal number using a recursive approach.\n    The sequence is defined by J(0)=0, J(1)=1, and J(n) = J(n-1) + 2 * J(n-2) for n > 1.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    else:\n        return jacobsthal_num(n - 1) + 2 * jacobsthal_num(n - 2)"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(list1: list, list2: list, list3: list) -> list:\n    \"\"\"Finds elements common to three input lists at the same index and returns them in a new list.\"\"\"\n    common_elements = []\n    min_length = min(len(list1), len(list2), len(list3))\n\n    for i in range(min_length):\n        if list1[i] == list2[i] == list3[i]:\n            common_elements.append(list1[i])\n            \n    return common_elements"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(numbers_list: list[int | float]) -> int | float:\n    \"\"\"\n    Finds the second smallest number in a list.\n    Raises ValueError if the list has fewer than two elements.\n    \"\"\"\n    if len(numbers_list) < 2:\n        raise ValueError(\"List must contain at least two elements to find the second smallest.\")\n    \n    # Sort the list in ascending order to easily find the second smallest element.\n    numbers_list.sort()\n    \n    # After sorting, the second smallest element will be at index 1.\n    return numbers_list[1]"}
{"task_id": "Mbpp/758", "solution": "def unique_sublists(input_list: list[list]) -> dict[tuple, int]:\n    \"\"\"\n    Counts occurrences of unique sublists within a list of lists.\n    Returns a dictionary mapping unique sublist tuples to their counts.\n    \"\"\"\n    counts = {}\n    for sublist in input_list:\n        sublist_tuple = tuple(sublist)\n        counts[sublist_tuple] = counts.get(sublist_tuple, 0) + 1\n    return counts"}
{"task_id": "Mbpp/757", "solution": "def _reverse_string(s: str) -> str:\n    \"\"\"Reverses a given string. Case-sensitive comparison.\"\"\"\n    return s[::-1]\ndef count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"Counts unique pairs of reverse strings in the given list.\"\"\"\n    if not string_list:\n        return 0\n\n    unprocessed_strings = set(string_list)\n    pair_count = 0\n\n    for s1 in list(unprocessed_strings):\n        if s1 not in unprocessed_strings:\n            continue\n\n        reversed_s1 = _reverse_string(s1)\n\n        if reversed_s1 in unprocessed_strings and reversed_s1 != s1:\n            pair_count += 1\n            unprocessed_strings.remove(s1)\n            unprocessed_strings.remove(reversed_s1)\n\n    return pair_count"}
{"task_id": "Mbpp/759", "solution": "import re\nclass DecimalNumber:\n    # Regex for a decimal number with optional sign, any number of digits (can be empty before '.'),\n    # a decimal point, and exactly two digits after it.\n    _DECIMAL_REGEX = re.compile(r\"^(?P<sign>[+-])?(?P<integer>\\d*)\\.(?P<decimal>\\d{2})$\")\n\n    def __init__(self, value: str):\n        \"\"\"Parses the input string to extract integer and decimal parts, and validates basic format.\"\"\"\n        match = self._DECIMAL_REGEX.match(value)\n        if match:\n            self._is_valid_format = True\n            self._integer_part = match.group('integer')\n            self._decimal_part = match.group('decimal')\n        else:\n            self._is_valid_format = False\n            self._integer_part = ''\n            self._decimal_part = ''\n\n    def is_valid_precision2(self) -> bool:\n        \"\"\"Checks if the parsed decimal number has exactly two digits in its fractional part and is valid.\"\"\"\n        return self._is_valid_format\ndef is_decimal(input_string: str) -> bool:\n    \"\"\"Checks if the input_string is a decimal number with exactly 2 digits of precision.\"\"\"\n    decimal_obj = DecimalNumber(input_string)\n    return decimal_obj.is_valid_precision2()"}
{"task_id": "Mbpp/760", "solution": "def unique_Element(numbers: list) -> bool:\n    \"\"\"\n    Checks if a list of numbers contains only one distinct element.\n    This is achieved by converting the list to a set and checking its length.\n    \"\"\"\n    return len(set(numbers)) == 1"}
{"task_id": "Mbpp/762", "solution": "def check_monthnumber_number(month_number: int) -> bool:\n    \"\"\"\n    Checks if the given month number contains 30 days.\n\n    Args:\n        month_number (int): The month number (1-12).\n\n    Returns:\n        bool: True if the month has 30 days (April, June, September, November),\n              False otherwise.\n\n    Raises:\n        ValueError: If month_number is not between 1 and 12.\n    \"\"\"\n    if not 1 <= month_number <= 12:\n        raise ValueError(\"Month number must be between 1 and 12, inclusive.\")\n\n    # Months with 30 days: April (4), June (6), September (9), November (11)\n    months_with_30_days = {4, 6, 9, 11}\n\n    return month_number in months_with_30_days"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(input_string: str) -> int:\n    \"\"\"Counts the number of digit characters in the given string.\n\n    Iterates through each character and increments a counter if the character is a digit.\n    \"\"\"\n    digit_count = 0\n    for char in input_string:\n        if char.isdigit():\n            digit_count += 1\n    return digit_count"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(arr: tuple) -> int:\n    \"\"\"\n    Calculates the minimum absolute difference between any two distinct elements in a given array.\n    The array must contain at least two elements.\n    \"\"\"\n    if len(arr) < 2:\n        raise ValueError(\"Input array must contain at least two elements.\")\n\n    # Convert to list and sort to find minimum difference between adjacent elements\n    # which will be the overall minimum difference.\n    sorted_arr = sorted(list(arr))\n    min_diff = float('inf')\n\n    for i in range(len(sorted_arr) - 1):\n        diff = sorted_arr[i+1] - sorted_arr[i]\n        if diff < min_diff:\n            min_diff = diff\n            \n    return min_diff"}
{"task_id": "Mbpp/765", "solution": "def find_nth_polite_number(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number. A polite number is a positive integer\n    that is not a power of 2.\n    \"\"\"\n    count = 0\n    num = 1\n\n    while True:\n        # A positive integer is a power of 2 if (num > 0) and ((num & (num - 1)) == 0).\n        # Polite numbers are those that are NOT powers of 2.\n        if not (num > 0 and (num & (num - 1)) == 0):\n            count += 1\n            if count == n:\n                return num\n        num += 1"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"Calculates the sum of the fourth power of the first 'n' odd natural numbers.\"\"\"\n    total_sum = 0\n    for i in range(n):\n        # The i-th odd natural number is 2*i + 1\n        odd_num = 2 * i + 1\n        total_sum += odd_num ** 4\n    return total_sum"}
{"task_id": "Mbpp/772", "solution": "def remove_length(input_string: str, k: int) -> str:\n    \"\"\"Removes all words of length 'k' from the given input_string.\n\n    Filters words based on length and joins the remaining words into a new string.\n    \"\"\"\n    words = input_string.split(' ')\n    filtered_words = [word for word in words if len(word) != k]\n    return ' '.join(filtered_words)"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression_string: str) -> bool:\n    \"\"\"\n    Checks if the given expression string has balanced and correctly nested brackets.\n    Uses a stack to track opening brackets and match them with closing brackets.\n    \"\"\"\n    OPENING_BRACKETS = \"({[\"\n    BRACKET_MAP = {\")\": \"(\", \"}\": \"{\", \"]\": \"[\"}\n    \n    stack = []\n    \n    for char in expression_string:\n        if char in OPENING_BRACKETS:\n            stack.append(char)\n        elif char in BRACKET_MAP:\n            if not stack:\n                return False\n            top_char = stack.pop()\n            if BRACKET_MAP[char] != top_char:\n                return False\n    \n    return not stack"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list: list) -> list[tuple]:\n    \"\"\"\n    Returns a list of all pairs of consecutive items in a given list.\n    \"\"\"\n    if len(input_list) < 2:\n        return []\n\n    result = []\n    for i in range(len(input_list) - 1):\n        result.append((input_list[i], input_list[i+1]))\n    return result"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list[int], target_sum: int) -> int:\n    \"\"\"\n    Counts the number of unique pairs in a list of numbers whose sum equals 'target_sum'.\n    Pairs are considered unique based on their distinct original indices (i, j) where i < j.\n    \"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n    return count"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1: list, list2: list) -> list:\n    \"\"\"\n    Calculates the difference between two lists, returning elements from list1 not in list2.\n    The order of elements from list1 is preserved in the result.\n    \"\"\"\n    set2 = set(list2)\n    result = []\n    for item in list1:\n        if item not in set2:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/775", "solution": "def is_odd(number: int) -> bool:\n    \"\"\"Checks if a given integer is an odd number.\"\"\"\n    return number % 2 != 0\ndef odd_position(input_list: list) -> bool:\n    \"\"\"\n    Checks whether every odd index in the given list contains an odd number.\n    Returns True for an empty list or a list with no odd indices.\n    \"\"\"\n    for index, number in enumerate(input_list):\n        if index % 2 != 0:  # Check if the current index is odd\n            if not is_odd(number):\n                return False\n    return True"}
{"task_id": "Mbpp/773", "solution": "from typing import Optional, Tuple\ndef occurance_substring(main_string: str, sub_string: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Finds the first occurrence and position of a substring within a string.\n    Returns a tuple (matched_substring, start_index, length) if found, otherwise None.\n    \"\"\"\n    start_index = main_string.find(sub_string)\n    if start_index == -1:\n        return None\n    else:\n        length = len(sub_string)\n        return (sub_string, start_index, length)"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list) -> list:\n    \"\"\"\n    Packs consecutive duplicates of a given list elements into sublists.\n    \"\"\"\n    if not input_list:\n        return []\n\n    packed_list = []\n    i = 0\n    while i < len(input_list):\n        current_element = input_list[i]\n        sublist = [current_element]\n        j = i + 1\n        while j < len(input_list) and input_list[j] == current_element:\n            sublist.append(input_list[j])\n            j += 1\n        packed_list.append(sublist)\n        i = j\n    return packed_list"}
{"task_id": "Mbpp/780", "solution": "def find_combinations(tuple_list: list[tuple[int, int]]) -> list[tuple[int, int]]:\n    \"\"\"\n    Finds all unique combinations of sums from a list of 2-element integer tuples.\n    It sums distinct pairs of tuples and stores unique results in a set.\n    \"\"\"\n    unique_sums = set()\n    n = len(tuple_list)\n\n    for i in range(n):\n        for j in range(i + 1, n):  # Ensure distinct tuples and avoid duplicates like (t1, t2) and (t2, t1)\n            t1 = tuple_list[i]\n            t2 = tuple_list[j]\n            sum_tuple = (t1[0] + t2[0], t1[1] + t2[1])\n            unique_sums.add(sum_tuple)\n\n    return list(unique_sums)"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int | float]) -> int | float:\n    \"\"\"Calculates the sum of all elements within all contiguous subarrays of odd length from the input list.\"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):\n        for j in range(i, n):\n            subarray_length = j - i + 1\n            if subarray_length % 2 == 1:\n                total_sum += sum(arr[i : j + 1])\n    return total_sum"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(number: int) -> bool:\n    \"\"\"\n    Checks if the count of divisors for a given integer is an even number.\n    Uses a helper function to calculate the total divisor count.\n    \"\"\"\n    def _calculate_divisor_count(n: int) -> int:\n        \"\"\"Calculates the total number of divisors for a given integer.\"\"\"\n        if n == 1:\n            return 1\n        count = 0\n        i = 1\n        while i * i <= n:\n            if n % i == 0:\n                if i * i == n:\n                    count += 1\n                else:\n                    count += 2\n            i += 1\n        return count\n\n    divisor_count = _calculate_divisor_count(number)\n    return divisor_count % 2 == 0"}
{"task_id": "Mbpp/777", "solution": "import collections\nfrom typing import List, Union\ndef find_sum(input_list: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the sum of non-repeated elements in a given list.\n    A non-repeated element is defined as an element that occurs exactly once.\n    \"\"\"\n    element_counts = collections.Counter(input_list)\n    total_sum = 0\n    for element, count in element_counts.items():\n        if count == 1:\n            total_sum += element\n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(numbers: list) -> int | None:\n    \"\"\"\n    Finds the product of the first even and first odd number in a list.\n    Returns None if either number is not found.\n    \"\"\"\n    def _is_even(number: int) -> bool:\n        return number % 2 == 0\n\n    def _is_odd(number: int) -> bool:\n        return number % 2 != 0\n\n    def _find_first_even(numbers: list) -> int | None:\n        for number in numbers:\n            if _is_even(number):\n                return number\n        return None\n\n    def _find_first_odd(numbers: list) -> int | None:\n        for number in numbers:\n            if _is_odd(number):\n                return number\n        return None\n\n    first_even = _find_first_even(numbers)\n    first_odd = _find_first_odd(numbers)\n\n    if first_even is None or first_odd is None:\n        return None\n    else:\n        return first_even * first_odd"}
{"task_id": "Mbpp/787", "solution": "import re\ndef text_match_three(input_string: str) -> bool:\n    \"\"\"\n    Checks if the input_string contains the pattern 'a' followed by three 'b's ('abbb').\n    \"\"\"\n    return bool(re.search(r\"abbb\", input_string))"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(tuple_string: str) -> tuple[int, ...]:\n    \"\"\"Converts a string representation of a tuple of integers into an actual tuple of integers.\n    This function processes the string by removing parentheses, splitting by comma, and converting each part to an integer.\n    \"\"\"\n    if not tuple_string.startswith('(') or not tuple_string.endswith(')'):\n        raise ValueError(\"Input string must start and end with parentheses.\")\n\n    # Remove leading/trailing parentheses\n    content = tuple_string[1:-1]\n\n    # Handle empty tuple case\n    if not content.strip():\n        return ()\n\n    # Split the string by comma and strip whitespace from each element\n    elements_str = [element.strip() for element in content.split(',')]\n\n    # Convert each element to an integer\n    try:\n        elements_int = [int(element) for element in elements_str]\n    except ValueError as e:\n        raise ValueError(f\"Invalid integer found in tuple string: {e}\") from e\n\n    # Return as a tuple\n    return tuple(elements_int)"}
{"task_id": "Mbpp/786", "solution": "from typing import List, Any\ndef right_insertion(sorted_list: List[Any], value: Any) -> int:\n    \"\"\"\n    Locates the right insertion point for a specified value in a sorted list.\n    This function performs a binary search to find the index where 'value' can be inserted\n    to maintain sorted order, ensuring elements to its left are less than or equal to 'value'\n    and elements to its right are strictly greater than 'value'.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if value < sorted_list[mid]:\n            high = mid\n        else:\n            low = mid + 1\n            \n    return low"}
{"task_id": "Mbpp/792", "solution": "from typing import Iterable\ndef count_list(input_collection: Iterable) -> int:\n    \"\"\"Counts the number of top-level list elements in an iterable collection.\n\n    Args:\n        input_collection: An iterable collection (e.g., list, tuple).\n\n    Returns:\n        An integer representing the count of top-level lists.\n    \"\"\"\n    count = 0\n    for element in input_collection:\n        if isinstance(element, list):\n            count += 1\n    return count"}
{"task_id": "Mbpp/791", "solution": "def remove_nested(input_tuple: tuple) -> tuple:\n    \"\"\"Removes any tuple elements from the given input tuple.\"\"\"\n    result_list = []\n    for element in input_tuple:\n        if not isinstance(element, tuple):\n            result_list.append(element)\n    return tuple(result_list)"}
{"task_id": "Mbpp/788", "solution": "def new_tuple(input_list: list, input_string: str) -> tuple:\n    \"\"\"Creates a new tuple by combining elements from the input list and appending the input string.\"\"\"\n    return tuple(input_list) + (input_string,)"}
{"task_id": "Mbpp/790", "solution": "def even_position(input_list: list) -> bool:\n    \"\"\"\n    Checks if every even index in a list contains an even number.\n    Returns False on the first violation, True otherwise.\n    \"\"\"\n    for i in range(len(input_list)):\n        if i % 2 == 0:  # Check if the current index is even\n            if input_list[i] % 2 != 0:  # Check if the element at the even index is odd\n                return False\n    return True"}
{"task_id": "Mbpp/793", "solution": "def find_last_position(array: list[int], element: int) -> int:\n    \"\"\"\n    Finds the last position (index) of an element in a sorted array.\n    Returns -1 if the element is not found.\n    \"\"\"\n    for i in range(len(array) - 1, -1, -1):\n        if array[i] == element:\n            return i\n    return -1"}
{"task_id": "Mbpp/796", "solution": "def return_sum(input_dict: dict) -> float:\n    \"\"\"\n    Calculates the sum of all numeric values in the given dictionary.\n    Non-numeric values are ignored during the summation.\n    \"\"\"\n    total_sum = 0.0\n    for value in input_dict.values():\n        if isinstance(value, (int, float)):\n            total_sum += value\n    return total_sum"}
{"task_id": "Mbpp/794", "solution": "import re\n_PATTERN: str = r\"^a.*b$\"\ndef text_starta_endb(input_string: str) -> bool:\n    \"\"\"\n    Matches a string that starts with 'a', is followed by anything (zero or more characters),\n    and ends with 'b'.\n    \"\"\"\n    return bool(re.match(_PATTERN, input_string))"}
{"task_id": "Mbpp/797", "solution": "def sum_in_range(l: int, r: int) -> int:\n    \"\"\"Calculates the sum of all odd natural numbers within the inclusive range [l, r].\"\"\"\n    current_sum = 0\n    start = max(1, l)  # Start from 1 if l is less than 1, otherwise from l.\n\n    for num in range(start, r + 1):\n        if num % 2 != 0:  # Check if the number is odd.\n            current_sum += num\n    return current_sum"}
{"task_id": "Mbpp/800", "solution": "def remove_all_spaces(input_string: str) -> str:\n    \"\"\"\n    Removes all whitespace characters from the input string.\n    Returns a new string with all whitespace characters omitted.\n    \"\"\"\n    return ''.join(char for char in input_string if not char.isspace())"}
{"task_id": "Mbpp/798", "solution": "from typing import List, Union\ndef _sum(array: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the sum of numerical elements in a list. Returns 0 if the list is empty.\n    \"\"\"\n    total = 0\n    for element in array:\n        total += element\n    return total"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(number: int, d_bits: int) -> int:\n    \"\"\"\n    Rotates the bits of a 32-bit integer to the left by d_bits positions.\n    The overflowed bits are wrapped around to the right.\n    \"\"\"\n    BITS = 32\n    # Ensure d_bits is normalized within the range [0, BITS-1]\n    d_bits %= BITS\n    \n    # Perform the left shift and capture the bits that wrap around\n    return ((number << d_bits) | (number >> (BITS - d_bits))) & 0xFFFFFFFF"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(integer1: int, integer2: int, integer3: int) -> int:\n    \"\"\"\n    Counts the number of equal integers from three given inputs.\n    Returns 3 if all three integers are equal, 2 if exactly two are equal, and 0 otherwise.\n    \"\"\"\n    if integer1 == integer2 == integer3:\n        return 3\n    elif integer1 == integer2 or integer1 == integer3 or integer2 == integer3:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/804", "solution": "from typing import List\nclass Number:\n    \"\"\"Represents an integer value and provides a method to check if it's even.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def is_even(self) -> bool:\n        \"\"\"Returns True if the number is even, False otherwise.\"\"\"\n        return self._value % 2 == 0\nclass NumberList:\n    \"\"\"Manages a list of Number objects and determines if their product is even.\"\"\"\n    def __init__(self, numbers: List[int]):\n        self._numbers = [Number(num) for num in numbers]\n\n    def is_product_even(self) -> bool:\n        \"\"\"Returns True if the product of numbers in the list is even, False otherwise.\"\"\"\n        # The product of a list of numbers is even if at least one number in the list is even.\n        for number_obj in self._numbers:\n            if number_obj.is_even():\n                return True\n        # If no even numbers are found, the product is odd (including for an empty list, product is 1).\n        return False\ndef is_product_even(numbers: List[int]) -> bool:\n    \"\"\"Checks if the product of numbers in a list is even.\"\"\"\n    number_list_instance = NumberList(numbers)\n    return number_list_instance.is_product_even()"}
{"task_id": "Mbpp/805", "solution": "from typing import List, Any\ndef max_sum_list(list_of_lists: List[List[Any]]) -> List[Any]:\n    \"\"\"\n    Identifies and returns the inner list with the highest sum of elements\n    from a given collection of lists.\n    \"\"\"\n    if not list_of_lists:\n        return []\n\n    max_sum = -float('inf')\n    highest_sum_list = []\n\n    for inner_list in list_of_lists:\n        current_sum = sum(inner_list)\n\n        if current_sum > max_sum:\n            max_sum = current_sum\n            highest_sum_list = inner_list\n\n    return highest_sum_list"}
{"task_id": "Mbpp/803", "solution": "import math\ndef is_perfect_square(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is a perfect square.\n    \"\"\"\n    if number < 0:\n        return False\n    if number == 0:\n        return True\n\n    sqrt_num = math.isqrt(number)\n    return sqrt_num * sqrt_num == number"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Calculates the maximum consecutive run of uppercase characters in a given string.\n    Returns 0 if the input string is empty or contains no uppercase characters.\n    \"\"\"\n    max_run_count = 0\n    current_run_count = 0\n\n    for char in input_string:\n        if char.isupper():\n            current_run_count += 1\n        else:\n            current_run_count = 0\n        max_run_count = max(max_run_count, current_run_count)\n\n    return max_run_count"}
{"task_id": "Mbpp/807", "solution": "class Number:\n    \"\"\"Encapsulates an integer value and provides a method to determine if it is odd.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_odd(self) -> bool:\n        \"\"\"Returns True if the number is odd, False otherwise.\"\"\"\n        return self.value % 2 != 0\ndef first_odd(number_list: list[int]) -> int | None:\n    \"\"\"\n    Finds the first odd number in a given list of numbers.\n    Iterates through the list sequentially, returning the first odd number found or None.\n    \"\"\"\n    for num in number_list:\n        number_instance = Number(num)\n        if number_instance.is_odd():\n            return num\n    return None"}
