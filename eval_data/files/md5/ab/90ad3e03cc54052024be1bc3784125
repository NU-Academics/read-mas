{"task_id": "Mbpp/119", "solution": "import collections\nfrom typing import List, Any\ndef search(arr: List[Any]) -> Any:\n    \"\"\"\n    Identifies the single unique element in a sorted array using binary search.\n    It leverages the property that elements appear twice, except for one.\n    \"\"\"\n    left = 0\n    right = len(arr) - 1\n\n    if len(arr) == 1:\n        return arr[0]\n\n    while left <= right:\n        mid = (left + right) // 2\n\n        # Check if mid is the unique element\n        # If mid is even, compare with mid+1\n        # If mid is odd, compare with mid-1\n        if mid % 2 == 0:\n            if mid + 1 < len(arr) and arr[mid] == arr[mid+1]:\n                # Pair found, unique element is to the right\n                left = mid + 2\n            else:\n                # Either mid is the unique element, or the unique element is to its left\n                # In this case, mid could be the start of the unique element's pair, or the unique element itself\n                # We need to narrow the search to include mid\n                right = mid\n        else: # mid is odd\n            if mid - 1 >= 0 and arr[mid] == arr[mid-1]:\n                # Pair found, unique element is to the right\n                left = mid + 1\n            else:\n                # Either mid is the unique element, or the unique element is to its left\n                # In this case, mid could be the start of the unique element's pair, or the unique element itself\n                # We need to narrow the search to include mid\n                right = mid\n\n        # If left and right pointers meet, that's the unique element\n        if left == right:\n            return arr[left]\n\n    # This part should ideally not be reached given the SRS assumptions\n    # that exactly one unique element will always be present.\n    return None"}
{"task_id": "Mbpp/123", "solution": "def _get_sum_of_proper_divisors(n: int) -> int:\n    \"\"\"Calculates the sum of proper divisors for a given positive integer n.\"\"\"\n    if n <= 1:\n        return 0\n    s = 1 # 1 is always a proper divisor for n > 1\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            s += i\n            if i * i != n:\n                s += n // i\n    return s\ndef _is_amicable_pair(a: int, b: int, limit: int, sum_div_cache: dict) -> bool:\n    \"\"\"Checks if a and b form an amicable pair within the specified limit.\"\"\"\n    if a == b:\n        return False\n    \n    sum_div_b = sum_div_cache.get(b)\n    if sum_div_b is None:\n        sum_div_b = _get_sum_of_proper_divisors(b)\n        sum_div_cache[b] = sum_div_b\n    \n    return sum_div_b == a\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"\n    Sums all amicable numbers from 1 to a specified number.\n    It identifies amicable pairs (a, b) where the sum of proper divisors of a equals b and vice-versa.\n    \"\"\"\n    amicable_numbers_set = set()\n    sum_div_cache = {}\n\n    for n in range(1, limit + 1):\n        sum_div_n = _get_sum_of_proper_divisors(n)\n        sum_div_cache[n] = sum_div_n\n\n        if sum_div_n > n and sum_div_n <= limit:\n            if _is_amicable_pair(n, sum_div_n, limit, sum_div_cache):\n                amicable_numbers_set.add(n)\n                amicable_numbers_set.add(sum_div_n)\n    \n    return sum(amicable_numbers_set)"}
{"task_id": "Mbpp/120", "solution": "import math\nfrom typing import List, Union\nclass Tuple:\n    \"\"\"Encapsulates two numerical elements and provides methods for product calculations.\"\"\"\n    def __init__(self, element1: Union[int, float], element2: Union[int, float]):\n        self.element1 = element1\n        self.element2 = element2\n\n    def calculate_product(self) -> Union[int, float]:\n        \"\"\"Calculates the product of the two elements.\"\"\"\n        return self.element1 * self.element2\n\n    def calculate_absolute_product(self) -> Union[int, float]:\n        \"\"\"Calculates the absolute product of the two elements.\"\"\"\n        return abs(self.element1 * self.element2)\nclass TupleList:\n    \"\"\"Manages a collection of Tuple objects and finds the maximum absolute product.\"\"\"\n    def __init__(self, raw_tuples: List[tuple]):\n        self._tuples: List[Tuple] = []\n        for e1, e2 in raw_tuples:\n            self._tuples.append(Tuple(e1, e2))\n\n    def find_max_absolute_product(self) -> Union[int, float]:\n        \"\"\"Finds the maximum absolute product among all contained Tuple objects.\"\"\"\n        # Initialize with 0.0, as absolute products are non-negative.\n        # This handles an empty list of tuples by returning 0.0.\n        max_abs_product: Union[int, float] = 0.0\n\n        for single_tuple in self._tuples:\n            current_abs_product = single_tuple.calculate_absolute_product()\n            if current_abs_product > max_abs_product:\n                max_abs_product = current_abs_product\n        return max_abs_product\ndef max_product_tuple(list_of_tuples: List[tuple]) -> Union[int, float]:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    It processes a list of (num1, num2) tuples to find the largest abs(num1 * num2).\n    \"\"\"\n    tuple_list_processor = TupleList(list_of_tuples)\n    return tuple_list_processor.find_max_absolute_product()"}
