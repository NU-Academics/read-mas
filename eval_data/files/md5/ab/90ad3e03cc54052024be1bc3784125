{"task_id": "Mbpp/426", "solution": "def filter_oddnumbers(numbers: list[int]) -> list[int]:\n    \"\"\"\n    Filters a list of integers, returning a new list containing only the odd numbers.\n\n    Args:\n        numbers: A list of integers.\n\n    Returns:\n        A new list containing only the odd numbers from the input list,\n        preserving their original order.\n    \"\"\"\n    odd_numbers_list = []\n    for number in numbers:\n        # An odd number is an integer that is not divisible by 2.\n        if number % 2 != 0:\n            odd_numbers_list.append(number)\n    # The output list must only contain numbers identified as odd and their order must be preserved.\n    return odd_numbers_list"}
{"task_id": "Mbpp/427", "solution": "def change_date_format(input_date_string: str) -> str:\n    \"\"\"\n    Converts a date string from 'yyyy-mm-dd' format to 'dd-mm-yyyy' format.\n    Assumes valid input format.\n    \"\"\"\n    parts = input_date_string.split('-')\n    year = parts[0]\n    month = parts[1]\n    day = parts[2]\n    return f\"{day}-{month}-{year}\""}
{"task_id": "Mbpp/428", "solution": "def shell_sort(arr: list) -> list:\n    \"\"\"Sorts a list of comparable elements in ascending order using the Shell Sort algorithm.\n    It uses a simple gap sequence where the gap is halved in each iteration.\"\"\"\n    n = len(arr)\n    gap = n // 2\n\n    while gap > 0:\n        for i in range(gap, n):\n            temp = arr[i]\n            j = i\n            while j >= gap and arr[j - gap] > temp:\n                arr[j] = arr[j - gap]\n                j -= gap\n            arr[j] = temp\n        gap //= 2\n    return arr"}
{"task_id": "Mbpp/425", "solution": "def count_element_in_list(main_list: list[list[any]], target_element: any) -> int:\n    \"\"\"\n    Counts the number of sublists in main_list that contain the target_element.\n    Each sublist is counted at most once, even if the element appears multiple times within it.\n    \"\"\"\n    count = 0\n    for sublist in main_list:\n        if target_element in sublist:\n            count += 1\n    return count"}
