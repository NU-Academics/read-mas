{"task_id": "Mbpp/462", "solution": "def combinations_list(input_list: list) -> list[list]:\n    \"\"\"\n    Generates all possible unique combinations of elements from a given list,\n    adhering to specific ordering rules for elements within combinations and for the overall output.\n    \"\"\"\n    combinations = [[]]\n    for item in input_list:\n        new_combinations_to_add = []\n        for current_combination in combinations:\n            # Prepend the current item to each existing combination\n            # to achieve reverse order of appearance within combinations.\n            new_combinations_to_add.append([item] + current_combination)\n        # Extend the main list with new combinations, maintaining the specified output order.\n        combinations.extend(new_combinations_to_add)\n    return combinations"}
{"task_id": "Mbpp/472", "solution": "from typing import List\ndef check_Consecutive(numbers: List[int]) -> bool:\n    \"\"\"\n    Checks whether the given list contains consecutive numbers.\n    An empty list or a list with a single element is considered to contain consecutive numbers.\n    \"\"\"\n    if not numbers or len(numbers) == 1:\n        return True\n\n    sorted_numbers = sorted(numbers)\n\n    for i in range(1, len(sorted_numbers)):\n        if sorted_numbers[i] != sorted_numbers[i-1] + 1:\n            return False\n\n    return True"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Computes the pairwise addition of neighboring elements of the given tuple.\n    Returns an empty tuple if input_tuple has fewer than two elements.\n    \"\"\"\n    if len(input_tuple) < 2:\n        return ()\n\n    sums = []\n    for i in range(len(input_tuple) - 1):\n        sums.append(input_tuple[i] + input_tuple[i + 1])\n    \n    return tuple(sums)"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(arr: list[int], n: int) -> int:\n    \"\"\"\n    Calculates the product of array elements modulo n.\n    Raises ValueError if n is not a positive integer.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"Modulus n must be a positive integer.\")\n\n    product_val = 1\n    for element in arr:\n        product_val = (product_val * element) % n\n    \n    return product_val"}
{"task_id": "Mbpp/468", "solution": "def _calculate_product(subsequence: list[int]) -> int:\n    \"\"\"\n    Calculates the product of numbers within a single provided subsequence.\n    \"\"\"\n    product = 1\n    for num in subsequence:\n        product *= num\n    return product\ndef _get_all_increasing_subsequences(arr: list[int]) -> list[list[int]]:\n    \"\"\"\n    Recursively identifies and generates all possible increasing subsequences from a given array.\n    \"\"\"\n    all_subsequences = []\n    _generate_increasing_subsequences_recursive(arr, 0, [], all_subsequences)\n    return all_subsequences\ndef max_product(arr: list[int]) -> int:\n    \"\"\"\n    Orchestrates the entire process of finding the maximum product of an increasing subsequence.\n    \"\"\"\n    all_increasing_subsequences = _get_all_increasing_subsequences(arr)\n    \n    if not all_increasing_subsequences:\n        return 0\n\n    max_prod = 0\n    for subsequence in all_increasing_subsequences:\n        current_product = _calculate_product(subsequence)\n        if current_product > max_prod:\n            max_prod = current_product\n            \n    return max_prod"}
{"task_id": "Mbpp/476", "solution": "def big_sum(numbers: list) -> float:\n    \"\"\"Calculates the sum of the largest and smallest values in a list of numbers.\n\n    Raises:\n        ValueError: If the input list is empty.\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    min_val = min(numbers)\n    max_val = max(numbers)\n    return float(min_val + max_val)"}
{"task_id": "Mbpp/473", "solution": "def _to_canonical_tuple(input_tuple: tuple) -> tuple:\n    \"\"\"Converts a tuple into its canonical (sorted) form.\"\"\"\n    return tuple(sorted(input_tuple))\ndef tuple_intersection(list1: list[tuple], list2: list[tuple]) -> set[tuple]:\n    \"\"\"Finds the tuple intersection of elements in the given tuple lists irrespective of their order.\n    Returns a set of unique tuples in canonical form.\n    \"\"\"\n    canonical_set1 = {_to_canonical_tuple(tup) for tup in list1}\n    canonical_set2 = {_to_canonical_tuple(tup) for tup in list2}\n    return canonical_set1.intersection(canonical_set2)"}
