{"task_id": "Mbpp/630", "solution": "def get_coordinates(coordinate: tuple[int, int]) -> list[list[int]]:\n    \"\"\"\n    Extracts all adjacent coordinates of the given coordinate tuple, including itself.\n\n    Args:\n        coordinate (tuple[int, int]): A tuple representing the (x, y) coordinate.\n\n    Returns:\n        list[list[int]]: A list of lists, where each inner list is [x', y']\n                        representing an adjacent coordinate.\n    \"\"\"\n    x, y = coordinate\n    adjacent_coords = []\n    for dx in [-1, 0, 1]:\n        for dy in [-1, 0, 1]:\n            adjacent_coords.append([x + dx, y + dy])\n    return adjacent_coords"}
{"task_id": "Mbpp/632", "solution": "def move_zero(nums: list[int]) -> list[int]:\n    \"\"\"Moves all zeroes to the end of the given list while preserving the relative order of non-zero elements.\"\"\"\n    non_zeros = []\n    zero_count = 0\n    for num in nums:\n        if num != 0:\n            non_zeros.append(num)\n        else:\n            zero_count += 1\n    non_zeros.extend([0] * zero_count)\n    return non_zeros"}
{"task_id": "Mbpp/631", "solution": "def replace_spaces(input_string):\n    \"\"\"\n    Replaces spaces with underscores and vice versa in the given string.\n    If a character is neither a space nor an underscore, it remains unchanged.\n    \"\"\"\n    result = []\n    for char in input_string:\n        if char == ' ':\n            result.append('_')\n        elif char == '_':\n            result.append(' ')\n        else:\n            result.append(char)\n    return \"\".join(result)"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers: list[int]) -> int:\n    \"\"\"Calculates the sum of XOR of all unique pairs of numbers in the given list.\"\"\"\n    total_xor_sum = 0\n    n = len(numbers)\n\n    # Iterate through all unique pairs\n    for i in range(n):\n        for j in range(i + 1, n):\n            total_xor_sum += (numbers[i] ^ numbers[j])\n\n    return total_xor_sum"}
{"task_id": "Mbpp/637", "solution": "class Transaction:\n    \"\"\"Represents a financial transaction with a cost price and a selling price.\"\"\"\n    def __init__(self, cost_price: float, selling_price: float):\n        self.cost_price = float(cost_price)\n        self.selling_price = float(selling_price)\n\n    def is_no_profit_no_loss(self) -> bool:\n        \"\"\"Checks if the transaction results in no profit and no loss.\"\"\"\n        return self.cost_price == self.selling_price\ndef noprofit_noloss(cost_price: float, selling_price: float) -> bool:\n    \"\"\"Checks if a given cost price and selling price result in no profit and no loss.\"\"\"\n    transaction = Transaction(cost_price, selling_price)\n    return transaction.is_no_profit_no_loss()"}
{"task_id": "Mbpp/635", "solution": "def heap_sort(input_list: list) -> list:\n    \"\"\"\n    Sorts a list of comparable elements using the Heap Sort algorithm.\n    Returns a new list containing the sorted elements.\n    \"\"\"\n    arr = list(input_list)\n    n = len(arr)\n\n    _heapify(arr, n)\n\n    for i in range(n - 1, 0, -1):\n        arr[i], arr[0] = arr[0], arr[i]\n        _sift_down(arr, i, 0)\n\n    return arr"}
{"task_id": "Mbpp/639", "solution": "from typing import List\nclass Name:\n    \"\"\"Represents a single name string and provides methods to check its validity and determine its length.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the name string.\"\"\"\n        return len(self._value)\n\n    def starts_with_lowercase(self) -> bool:\n        \"\"\"Checks if the name starts with a lowercase letter.\"\"\"\n        return len(self._value) > 0 and self._value[0].islower()\nclass NameList:\n    \"\"\"Manages a collection of Name objects, providing methods to add names, filter valid ones, and calculate the total length of valid names.\"\"\"\n    def __init__(self):\n        self._names: List[Name] = []\n\n    def add_name(self, name: Name):\n        \"\"\"Adds a Name object to the list.\"\"\"\n        self._names.append(name)\n\n    def get_valid_names(self) -> List[Name]:\n        \"\"\"Returns a new list containing only names that do not start with a lowercase letter.\"\"\"\n        return [name for name in self._names if not name.starts_with_lowercase()]\n\n    def calculate_total_length(self) -> int:\n        \"\"\"Calculates the sum of lengths of all valid names in the list.\"\"\"\n        valid_names = self.get_valid_names()\n        total_length = 0\n        for name_obj in valid_names:\n            total_length += name_obj.length()\n        return total_length\ndef sample_nam(name_list_strings: List[str]) -> int:\n    \"\"\"\n    Sums the length of names after removing those that start with a lowercase letter.\n    \"\"\"\n    name_list = NameList()\n    for name_str in name_list_strings:\n        name_obj = Name(name_str)\n        name_list.add_name(name_obj)\n    \n    return name_list.calculate_total_length()"}
