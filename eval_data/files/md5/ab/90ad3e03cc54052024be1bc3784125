{"task_id": "Mbpp/644", "solution": "import typing\ndef reverse_Array_Upto_K(array: typing.List[typing.Any], k: int) -> typing.List[typing.Any]:\n    \"\"\"\n    Reverses the elements of an array from index 0 up to (K-1) inclusive.\n    The function modifies the array in-place and returns it.\n    \"\"\"\n    if k <= 1:\n        return array\n\n    left, right = 0, k - 1\n    while left < right:\n        array[left], array[right] = array[right], array[left]\n        left += 1\n        right -= 1\n\n    return array"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of all digits of 'base' raised to 'power'.\n    Python's int type handles arbitrary precision automatically for the intermediate result.\n    \"\"\"\n    resulting_number = base ** power\n\n    sum_of_digits = 0\n    # Convert to string to iterate over digits and sum them up.\n    for digit_char in str(resulting_number):\n        sum_of_digits += int(digit_char)\n\n    return sum_of_digits"}
{"task_id": "Mbpp/722", "solution": "class Student:\n    \"\"\"Encapsulates a student's name, height, and weight, and provides a method to check if they meet specific criteria.\"\"\"\n    def __init__(self, name: str, height: float, weight: float):\n        self.name = name\n        self.height = height\n        self.weight = weight\n\n    def meets_criteria(self, min_height: float, min_weight: float) -> bool:\n        \"\"\"Checks if the student's height is greater than or equal to min_height AND their weight is greater than or equal to min_weight.\"\"\"\n        return self.height >= min_height and self.weight >= min_weight\ndef filter_data(student_data: dict[str, tuple[float, float]], min_height: float, min_weight: float) -> dict[str, tuple[float, float]]:\n    \"\"\"Filters a dictionary of student data based on provided minimal height and weight criteria.\"\"\"\n    filtered_students = {}\n    for name, (height, weight) in student_data.items():\n        student = Student(name, height, weight)\n        if student.meets_criteria(min_height, min_weight):\n            filtered_students[name] = (height, weight)\n    return filtered_students"}
