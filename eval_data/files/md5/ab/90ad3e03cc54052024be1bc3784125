{"task_id": "Mbpp/731", "solution": "import math\ndef lateralsurface_cone(radius: float, height: float) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cone given its radius and height.\n    \"\"\"\n    slant_height = math.sqrt(radius**2 + height**2)\n    return math.pi * radius * slant_height"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array: list[int], target_number: int) -> int:\n    \"\"\"\n    Finds the 0-based index of the first occurrence of a target number in a sorted array.\n    Returns -1 if the target number is not found.\n    \"\"\"\n    low, high = 0, len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target_number:\n            result = mid\n            high = mid - 1  # Try to find an earlier occurrence\n        elif array[mid] < target_number:\n            low = mid + 1\n        else: # array[mid] > target_number\n            high = mid - 1\n    return result"}
{"task_id": "Mbpp/732", "solution": "def replace_specialchar(input_string: str) -> str:\n    \"\"\"\n    Replaces all occurrences of spaces, commas, or dots with a colon.\n    \"\"\"\n    processed_string = input_string\n    target_chars = [' ', ',', '.']\n    replacement_char = ':'\n\n    for char_to_replace in target_chars:\n        processed_string = processed_string.replace(char_to_replace, replacement_char)\n\n    return processed_string"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sorted_list: list[float | int], value: float | int) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted list.\n    Uses binary search to find the lowest index 'i' where sorted_list[i] >= value.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/734", "solution": "from typing import Union\ndef sum_Of_Subarray_Prod(input_list: list) -> Union[int, float]:\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists\n    of a given list of numerical elements.\n    \"\"\"\n    total_sum: Union[int, float] = 0\n    n = len(input_list)\n\n    for i in range(n):\n        current_product: Union[int, float] = 1\n        for j in range(i, n):\n            current_product *= input_list[j]\n            total_sum += current_product\n            \n    return total_sum"}
{"task_id": "Mbpp/737", "solution": "import re\ndef check_str(input_string: str) -> bool:\n    \"\"\"\n    Checks if the given string starts with a vowel (case-insensitive) using regex.\n    \"\"\"\n    vowel_pattern = r\"^[aeiou]\"\n    return bool(re.match(vowel_pattern, input_string, re.IGNORECASE))"}
{"task_id": "Mbpp/735", "solution": "def _int_to_binary_string(n: int) -> str:\n    \"\"\"Converts a non-negative integer to its binary string representation.\"\"\"\n    if n == 0:\n        return \"0\"\n    return bin(n)[2:]\ndef _binary_string_to_int(binary_str: str) -> int:\n    \"\"\"Converts a binary string to its integer equivalent.\"\"\"\n    return int(binary_str, 2)\ndef _get_msb_position(binary_str: str) -> int:\n    \"\"\"Returns the 0-indexed position of the MSB (leftmost '1').\"\"\"\n    return binary_str.find('1')\ndef _get_lsb_position(binary_str: str) -> int:\n    \"\"\"Returns the 0-indexed position of the LSB (rightmost '1').\"\"\"\n    return binary_str.rfind('1')\ndef toggle_middle_bits(n: int) -> int:\n    \"\"\"\n    Toggles bits of the number except the first (MSB) and the last (LSB) bit.\n    Preserves MSB and LSB while inverting all bits strictly between them.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    binary_str = _int_to_binary_string(n)\n    \n    msb_pos = _get_msb_position(binary_str)\n    lsb_pos = _get_lsb_position(binary_str)\n\n    binary_list = list(binary_str)\n\n    # Iterate through bits strictly between MSB and LSB\n    # The range covers indices from msb_pos + 1 up to lsb_pos - 1.\n    for i in range(msb_pos + 1, lsb_pos):\n        binary_list[i] = '1' if binary_list[i] == '0' else '0'\n    \n    new_binary_str = \"\".join(binary_list)\n    return _binary_string_to_int(new_binary_str)"}
{"task_id": "Mbpp/742", "solution": "import math\ndef area_tetrahedron(side_length: float) -> float:\n    \"\"\"\n    Calculates the total surface area of a regular tetrahedron.\n    Raises ValueError if side_length is not a positive number.\n    \"\"\"\n    if side_length <= 0:\n        raise ValueError(\"Side length must be a positive number.\")\n    \n    area = math.sqrt(3) * (side_length ** 2)\n    return area"}
{"task_id": "Mbpp/739", "solution": "import math\ndef _calculate_triangular_number(k: int) -> int:\n    \"\"\"\n    Calculates the k-th triangular number.\n    \"\"\"\n    return k * (k + 1) // 2\ndef _get_digit_count(number: int) -> int:\n    \"\"\"\n    Counts the number of digits in an integer.\n    \"\"\"\n    if number == 0:\n        return 1\n    return int(math.log10(number)) + 1\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Determines the index `k` of the smallest triangular number `T_k`\n    such that `T_k` has exactly `n` digits.\n    \"\"\"\n    k = max(1, int(math.sqrt(2 * (10**(n - 1)))) - 2)\n\n    while True:\n        triangular_number = _calculate_triangular_number(k)\n        digit_count = _get_digit_count(triangular_number)\n\n        if digit_count == n:\n            return k\n        \n        k += 1"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input_tuple: tuple) -> dict:\n    \"\"\"\n    Converts the given tuple to a key-value dictionary using adjacent elements.\n    Adjacent elements from the input_tuple form key-value pairs.\n    \"\"\"\n    result_dict = {}\n    for i in range(0, len(input_tuple), 2):\n        key = input_tuple[i]\n        value = input_tuple[i+1]\n        result_dict[key] = value\n    return result_dict"}
