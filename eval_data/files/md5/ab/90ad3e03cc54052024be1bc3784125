{"task_id": "Mbpp/593", "solution": "class Octet:\n    \"\"\"Represents a single IP address octet, removing leading zeros upon initialization.\"\"\"\n    def __init__(self, raw_value: str):\n        self.raw_value = raw_value\n        self._numeric_value = int(raw_value) # Implicitly removes leading zeros\n\n    def to_string(self) -> str:\n        \"\"\"Returns the processed string representation of the octet (without leading zeros).\"\"\"\n        return str(self._numeric_value)\nclass IPAddress:\n    \"\"\"Encapsulates an entire IP address, orchestrating splitting, processing, and reconstructing.\"\"\"\n    def __init__(self, raw_input: str):\n        self.raw_input = raw_input\n        self._octets: list[Octet] = []\n        self.processed_output: str = \"\"\n        self._split_and_process_octets()\n        self._reconstruct_ip()\n\n    def _split_and_process_octets(self):\n        \"\"\"Splits the raw_input into octet strings and creates Octet objects for each.\"\"\"\n        octet_strings = self.raw_input.split('.')\n        for octet_str in octet_strings:\n            self._octets.append(Octet(octet_str))\n\n    def _reconstruct_ip(self):\n        \"\"\"Reconstructs the processed_output string from the processed Octet values.\"\"\"\n        processed_octet_strings = [octet.to_string() for octet in self._octets]\n        self.processed_output = \".\".join(processed_octet_strings)\ndef removezero_ip(ip_address_str: str) -> str:\n    \"\"\"Removes leading zeros from each octet of an IPv4 address string.\"\"\"\n    ip_address = IPAddress(ip_address_str)\n    return ip_address.processed_output"}
{"task_id": "Mbpp/592", "solution": "import math\ndef _binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient C(n, k).\n    Requires n >= 0 and 0 <= k <= n.\"\"\"\n    if not (0 <= k <= n):\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\ndef sum_Of_product(n: int) -> int:\n    \"\"\"Calculates the sum of the product of consecutive binomial coefficients.\n    C(n, k) * C(n, k+1) for k from 0 to n-1.\"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n == 0:\n        return 0\n\n    total_sum = 0\n    for k in range(n):\n        coeff1 = _binomial_coefficient(n, k)\n        coeff2 = _binomial_coefficient(n, k + 1)\n        total_sum += (coeff1 * coeff2)\n\n    return total_sum"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(number):\n    \"\"\"Checks if the given number is an Armstrong number.\"\"\"\n    str_num = str(number)\n    num_digits = len(str_num)\n    sum_of_powers = 0\n    for digit_char in str_num:\n        digit = int(digit_char)\n        sum_of_powers += digit ** num_digits\n    return sum_of_powers == number"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the difference of the first even and first odd number in a list.\n    Raises ValueError if no even or no odd number is found.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for number in numbers:\n        if first_even is None and number % 2 == 0:\n            first_even = number\n        if first_odd is None and number % 2 != 0:\n            first_odd = number\n\n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is None:\n        raise ValueError(\"No even number found\")\n    if first_odd is None:\n        raise ValueError(\"No odd number found\")\n\n    return first_even - first_odd"}
