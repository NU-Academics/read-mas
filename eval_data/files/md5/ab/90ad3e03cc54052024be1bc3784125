{"task_id": "Mbpp/572", "solution": "import collections\ndef two_unique_nums(numbers: list) -> list:\n    \"\"\"Removes duplicate numbers from a list, returning only those that appear exactly once, preserving order.\"\"\"\n    # Count occurrences of each number in the input list.\n    counts = collections.Counter(numbers)\n    result = []\n    # Iterate through the original list to maintain order and filter for unique numbers.\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n    return result"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Finds elements present in one of two tuples but not in the other.\n    Leverages set operations for efficient comparison and combination.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n\n    # Elements unique to tuple1\n    unique_to_tuple1 = set1 - set2\n    # Elements unique to tuple2\n    unique_to_tuple2 = set2 - set1\n\n    # Combine all dissimilar elements\n    dissimilar_elements = unique_to_tuple1 | unique_to_tuple2\n\n    return tuple(dissimilar_elements)"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list: list, sublist_candidate: list) -> bool:\n    \"\"\"\n    Checks if sublist_candidate is a contiguous sublist of main_list.\n    Handles an empty sublist_candidate as a sublist of any main_list.\n    \"\"\"\n    if not sublist_candidate:\n        return True\n\n    len_main = len(main_list)\n    len_sub = len(sublist_candidate)\n\n    if len_sub > len_main:\n        return False\n\n    for i in range(len_main - len_sub + 1):\n        if main_list[i:i+len_sub] == sublist_candidate:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/578", "solution": "from typing import List, Any\ndef interleave_lists(list1: List[Any], list2: List[Any], list3: List[Any]) -> List[Any]:\n    \"\"\"\n    Interleaves three input lists of the same length into a single flat list.\n    Elements are taken sequentially from each list: list1[i], then list2[i], then list3[i].\n    \"\"\"\n    result_list = []\n    # All lists are guaranteed to be of the same length as per design context.\n    length = len(list1)\n    for i in range(length):\n        result_list.append(list1[i])\n        result_list.append(list2[i])\n        result_list.append(list3[i])\n    return result_list"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Calculates the last digit of the factorial of a given non-negative integer.\n    This function implements specific business rules for factorials 0! through 4!, and 0 for n >= 5.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    if n == 0:\n        return 1\n    elif n == 1:\n        return 1\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 6\n    elif n == 4:\n        return 4\n    else:  # n >= 5\n        return 0"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Recursively processes a nested tuple to extract only even numbers,\n    preserving the hierarchical structure.\n    \"\"\"\n    result_elements = []\n    for element in input_tuple:\n        if isinstance(element, int):\n            if element % 2 == 0:\n                result_elements.append(element)\n        elif isinstance(element, tuple):\n            processed_nested_tuple = extract_even(element)\n            result_elements.append(processed_nested_tuple)\n    return tuple(result_elements)"}
{"task_id": "Mbpp/581", "solution": "import math\ndef surface_Area(base_edge: float, height: float) -> float:\n    \"\"\"Calculates the surface area of a square pyramid with a given base edge and height.\"\"\"\n    \n    half_base_edge = base_edge / 2\n    slant_height = math.sqrt(half_base_edge**2 + height**2)\n    \n    base_area = base_edge**2\n    \n    lateral_surface_area = 2 * base_edge * slant_height\n    \n    total_surface_area = base_area + lateral_surface_area\n    \n    return total_surface_area"}
{"task_id": "Mbpp/583", "solution": "import math\ndef catalan_number(n: int) -> int:\n    \"\"\"\n    Computes the nth Catalan number using the formula C_n = (1 / (n + 1)) * (2n choose n).\n    Requires n to be a non-negative integer.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    if n == 0:\n        return 1\n    # This formula uses integer division for C_n = (2n choose n) / (n + 1), avoiding floating-point issues.\n    return math.comb(2 * n, n) // (n + 1)"}
