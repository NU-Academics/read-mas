{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Calculates the minimum number of rotations (greater than 0) required\n    for a given string to return to its original form.\n    \"\"\"\n    if not s:\n        return 0\n\n    n = len(s)\n    if n == 1:\n        return 1\n\n    temp = s + s\n    for i in range(1, n + 1):\n        rotated_s = temp[i : i + n]\n        if rotated_s == s:\n            return i\n    return n"}
{"task_id": "Mbpp/7", "solution": "def find_char_long(input_string: str) -> set[str]:\n    \"\"\"\n    Finds all words in the input string that are at least 4 characters long.\n    Splits the string into words and filters based on length.\n    \"\"\"\n    words = input_string.split()\n    long_words = {word for word in words if len(word) >= 4}\n    return long_words"}
{"task_id": "Mbpp/12", "solution": "class Row:\n    \"\"\"Represents a row in a matrix, capable of calculating and caching its sum for comparisons.\"\"\"\n    def __init__(self, elements: list[int | float]):\n        self._elements = elements\n        self._cached_sum: int | float | None = None\n\n    def calculate_sum(self) -> int | float:\n        \"\"\"Computes and returns the sum of elements in the row, caching the result.\"\"\"\n        if self._cached_sum is None:\n            self._cached_sum = sum(self._elements)\n        return self._cached_sum\n\n    def get_elements(self) -> list[int | float]:\n        \"\"\"Returns the original list of elements for this row.\"\"\"\n        return self._elements\n\n    def __lt__(self, other: 'Row') -> bool:\n        \"\"\"Enables comparison of Row objects based on their sums.\"\"\"\n        return self.calculate_sum() < other.calculate_sum()\nclass Matrix:\n    \"\"\"Manages a collection of Row objects and provides sorting capabilities.\"\"\"\n    def __init__(self, matrix_data: list[list[int | float]]):\n        self._rows: list[Row] = [Row(row_data) for row_data in matrix_data]\n\n    def sort_by_row_sum(self) -> None:\n        \"\"\"Sorts the internal list of Row objects in ascending order based on their sums.\"\"\"\n        self._rows.sort()\n\n    def get_matrix_data(self) -> list[list[int | float]]:\n        \"\"\"Converts the internal list of Row objects back to a list of lists format.\"\"\"\n        return [row.get_elements() for row in self._rows]\ndef sort_matrix(matrix_data: list[list[int | float]]) -> list[list[int | float]]:\n    \"\"\"\n    Sorts a given matrix in ascending order according to the sum of its rows.\n    \"\"\"\n    matrix_obj = Matrix(matrix_data)\n    matrix_obj.sort_by_row_sum()\n    return matrix_obj.get_matrix_data()"}
{"task_id": "Mbpp/17", "solution": "class Square:\n    \"\"\"\n    Represents a square with a given side length.\n    Provides methods to calculate its perimeter.\n    \"\"\"\n    def __init__(self, side_length: float):\n        self.side_length = side_length\n\n    def calculate_perimeter(self) -> float:\n        \"\"\"Calculates and returns the perimeter of the square.\"\"\"\n        return self.side_length * 4\ndef square_perimeter(side_length: float) -> float:\n    \"\"\"\n    Calculates the perimeter of a square given its side length.\n    This function acts as a facade to the Square class.\n    \"\"\"\n    square_obj = Square(side_length)\n    return square_obj.calculate_perimeter()"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"Checks if the given number is a Woodall number.\"\"\"\n    n = 1\n    while True:\n        woodall_num = n * (2**n) - 1\n        if woodall_num == number:\n            return True\n        elif woodall_num > number:\n            return False\n        n += 1"}
{"task_id": "Mbpp/14", "solution": "def find_Volume(base: float, height: float, length: float) -> float:\n    \"\"\"\n    Calculates the volume of a triangular prism.\n\n    Args:\n        base (float): The length of the base of the triangular face.\n        height (float): The perpendicular height of the triangular face.\n        length (float): The length of the prism.\n\n    Returns:\n        float: The calculated volume of the triangular prism.\n    \"\"\"\n    volume = 0.5 * base * height * length\n    return volume"}
{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(primary_string: str, chars_to_remove_string: str) -> str:\n    \"\"\"\n    Removes all characters present in chars_to_remove_string from primary_string, preserving order.\n    \"\"\"\n    chars_to_remove_set = set(chars_to_remove_string)\n    result_chars = []\n    for char in primary_string:\n        if char not in chars_to_remove_set:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/56", "solution": "def _get_reverse(n: int) -> int:\n    \"\"\"Calculates the reverse of a given integer.\n    For example, _get_reverse(70) returns 7.\n    \"\"\"\n    if n == 0:\n        return 0\n    reversed_num = 0\n    temp_n = abs(n) # Handle negative numbers by reversing positive, then applying sign\n    while temp_n > 0:\n        digit = temp_n % 10\n        reversed_num = reversed_num * 10 + digit\n        temp_n //= 10\n    return reversed_num * (-1 if n < 0 else 1)\ndef check(number: int) -> bool:\n    \"\"\"Checks if a given number is one less than twice its reverse.\"\"\"\n    reversed_number = _get_reverse(number)\n    return number == (2 * reversed_number) - 1"}
{"task_id": "Mbpp/16", "solution": "import re\ndef text_lowercase_underscore(input_string: str) -> bool:\n    \"\"\"Checks if the input string contains sequences of lowercase letters\n    joined with an underscore (e.g., 'abc_def').\"\"\"\n    # The pattern requires at least one lowercase letter before and after a single underscore.\n    PATTERN_REGEX = r\"[a-z]+_[a-z]+\"\n    return re.search(PATTERN_REGEX, input_string) is not None"}
{"task_id": "Mbpp/19", "solution": "def test_duplicate(arr: list[int]) -> bool:\n    \"\"\"\n    Determines if the given array of integers contains any duplicate element.\n    Uses a set for efficient duplicate checking.\n    \"\"\"\n    seen_elements = set()\n    for element in arr:\n        if element in seen_elements:\n            return True\n        seen_elements.add(element)\n    return False"}
{"task_id": "Mbpp/57", "solution": "import functools\ndef find_Max_Num(digits: list[int]) -> str:\n    \"\"\"\n    Finds the largest number that can be formed with the given list of digits.\n    Orchestrates conversion, custom sorting, and concatenation.\n    \"\"\"\n    def _compare_digits(digit_str1: str, digit_str2: str) -> int:\n        \"\"\"\n        Compares two digit strings to determine their order for forming the largest number.\n        Returns -1 if digit_str1 should come before digit_str2, 1 if after, 0 if equivalent.\n        \"\"\"\n        if digit_str1 + digit_str2 > digit_str2 + digit_str1:\n            return -1\n        elif digit_str1 + digit_str2 < digit_str2 + digit_str1:\n            return 1\n        else:\n            return 0\n\n    if not digits:\n        return \"0\"\n\n    # Convert integers to strings\n    digit_strings = [str(d) for d in digits]\n\n    # Sort using custom comparison logic\n    # functools.cmp_to_key converts a comparison function (cmp) into a key function\n    sorted_digits = sorted(digit_strings, key=functools.cmp_to_key(_compare_digits))\n\n    # Join sorted strings to form the largest number\n    result = \"\".join(sorted_digits)\n\n    # Handle cases where the largest number could be '0' (e.g., input was [0,0,0])\n    if result[0] == '0' and len(result) > 1:\n        return \"0\"\n\n    return result"}
{"task_id": "Mbpp/58", "solution": "def opposite_Signs(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks if two integers have opposite signs.\n    Returns True if num1 and num2 have opposite signs, False otherwise.\n    \"\"\"\n    return (num1 > 0 and num2 < 0) or (num1 < 0 and num2 > 0)"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(input_list: list) -> (int | float):\n    \"\"\"\n    Flattens a list and sums all of its numeric elements.\n    This function orchestrates the flattening and summing operations.\n    \"\"\"\n\n    def _flatten_list_recursive(current_list: list) -> list:\n        \"\"\"Recursively flattens a nested list into a single-level list.\"\"\"\n        flattened = []\n        for element in current_list:\n            if isinstance(element, list):\n                flattened.extend(_flatten_list_recursive(element))\n            else:\n                flattened.append(element)\n        return flattened\n\n    def _sum_numeric_elements(flat_list: list) -> (int | float):\n        \"\"\"Iterates through a flat list and sums only numeric elements.\"\"\"\n        total_sum = 0\n        for element in flat_list:\n            if isinstance(element, (int, float)):\n                total_sum += element\n        return total_sum\n\n    flattened_list = _flatten_list_recursive(input_list)\n    total_sum = _sum_numeric_elements(flattened_list)\n    return total_sum"}
