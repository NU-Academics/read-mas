{"task_id": "Mbpp/131", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\ndef reverse_vowels(input_string: str) -> str:\n    \"\"\"\n    Reverses only the vowels in a given string.\n    Vowels are 'a', 'e', 'i', 'o', 'u' (case-insensitive), 'y' is not a vowel.\n    \"\"\"\n    char_list = list(input_string)\n    vowel_indices = []\n    extracted_vowels = []\n\n    for i, char in enumerate(char_list):\n        if char in VOWELS:\n            vowel_indices.append(i)\n            extracted_vowels.append(char)\n\n    extracted_vowels.reverse()\n\n    for i, index in enumerate(vowel_indices):\n        char_list[index] = extracted_vowels[i]\n\n    return \"\".join(char_list)"}
