{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) for i from 0 to n // 2, inclusive.\n    \"\"\"\n    total_sum = 0\n    # Iterate from i = 0 up to and including n // 2\n    for i in range(n // 2 + 1):\n        term = n - 2 * i\n        total_sum += term\n    return total_sum"}
{"task_id": "Mbpp/160", "solution": "def extended_gcd(a, b):\n    \"\"\"\n    Implements the Extended Euclidean Algorithm to find gcd(a, b)\n    and coefficients x, y such that ax + by = gcd(a, b).\n    Returns (gcd_val, x, y).\n    \"\"\"\n    # This iterative implementation computes g = gcd(|a|, |b|)\n    # and returns coefficients x, y for the original a, b.\n    \n    # Store original signs for adjustment\n    sign_a = 1 if a >= 0 else -1\n    sign_b = 1 if b >= 0 else -1\n\n    # Initialize coefficients for a and b in the Euclidean algorithm\n    u0, v0 = 1, 0  # Coefficients for current 'a' (initially original 'a')\n    u1, v1 = 0, 1  # Coefficients for current 'b' (initially original 'b')\n    \n    # Work with absolute values for the main Euclidean algorithm loop\n    a_abs = abs(a)\n    b_abs = abs(b)\n\n    while b_abs != 0:\n        q = a_abs // b_abs\n        a_abs, b_abs = b_abs, a_abs - q * b_abs\n        u0, u1 = u1, u0 - q * u1\n        v0, v1 = v1, v0 - q * v1\n\n    # At this point, a_abs holds gcd(|a|, |b|).\n    # u0 and v0 are the coefficients for abs(a) and abs(b) such that abs(a)*u0 + abs(b)*v0 = g.\n    # Adjust coefficients to correspond to the original 'a' and 'b'.\n    x_final = u0 * sign_a\n    y_final = v0 * sign_b\n\n    return a_abs, x_final, y_final\ndef find_solution(a, b, n):\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple,\n    or returns None if no solution exists.\n    \"\"\"\n    g, x0, y0 = extended_gcd(a, b)\n\n    if g == 0:  # This implies a=0 and b=0.\n        if n == 0:\n            return (0, 0)  # Any (x,y) is a solution for 0*x + 0*y = 0; (0,0) is one such solution.\n        else:\n            return None    # No solution for 0*x + 0*y = n when n != 0.\n\n    # If g != 0 (at least one of a, b is non-zero), check divisibility.\n    if n % g != 0:\n        return None  # No integer solution if n is not divisible by gcd(a,b).\n\n    # A solution exists. Scale the coefficients from extended_gcd.\n    k = n // g\n    x = x0 * k\n    y = y0 * k\n    return (x, y)"}
{"task_id": "Mbpp/165", "solution": "def _is_english_alphabet(char_code: int) -> bool:\n    \"\"\"Checks if a character (represented by its Unicode code point) is an English letter (a-z or A-Z).\"\"\"\n    return ord('a') <= char_code <= ord('z')\ndef _get_alphabetical_position(char_code: int) -> int:\n    \"\"\"Returns 0 for 'a', 1 for 'b', etc. Assumes input char_code corresponds to a lowercase English letter.\"\"\"\n    return char_code - ord('a')\ndef count_char_position(input_string: str) -> int:\n    \"\"\"Counts characters in input_string where the 0-based alphabetical position matches the 0-based string index.\"\"\"\n    count = 0\n    for index, char in enumerate(input_string):\n        lower_char_code = ord(char.lower())\n        if _is_english_alphabet(lower_char_code):\n            alphabetical_pos = _get_alphabetical_position(lower_char_code)\n            if alphabetical_pos == index:\n                count += 1\n    return count"}
