{"task_id": "Mbpp/141", "solution": "def pancake_sort(input_list):\n    \"\"\"\n    Sorts a list of comparable elements in ascending order using the pancake sort algorithm.\n    Returns a new sorted list, leaving the original input list unchanged.\n    \"\"\"\n    arr = list(input_list)\n    n = len(arr)\n\n    def _flip(arr_to_flip, k):\n        \"\"\"Reverses the order of elements in a prefix of a list up to a given index.\"\"\"\n        start = 0\n        while start < k:\n            arr_to_flip[start], arr_to_flip[k] = arr_to_flip[k], arr_to_flip[start]\n            start += 1\n            k -= 1\n\n    def _find_max_index(arr_to_search, size):\n        \"\"\"Finds the index of the maximum element within a given prefix of a list.\"\"\"\n        max_idx = 0\n        for i in range(1, size):\n            if arr_to_search[i] > arr_to_search[max_idx]:\n                max_idx = i\n        return max_idx\n\n    for current_size in range(n, 1, -1):\n        # Find index of the maximum element in the current sub-array\n        max_idx = _find_max_index(arr, current_size)\n\n        # If max element is not already at its correct position\n        if max_idx != current_size - 1:\n            # Move the maximum element to the beginning of the sub-array\n            _flip(arr, max_idx)\n            # Move the maximum element to its correct position at the end of the sub-array\n            _flip(arr, current_size - 1)\n            \n    return arr"}
{"task_id": "Mbpp/161", "solution": "from typing import List, Any\ndef remove_elements(primary_list: List[Any], exclusion_list: List[Any]) -> List[Any]:\n    \"\"\"\n    Removes all elements from primary_list that are present in exclusion_list.\n    The order of the remaining elements in the primary_list is preserved.\n    \"\"\"\n    exclusion_set = set(exclusion_list)\n    resultant_list = []\n    for element in primary_list:\n        if element not in exclusion_set:\n            resultant_list.append(element)\n    return resultant_list"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1: list, list2: list, list3: list) -> int:\n    \"\"\"\n    Counts the number of positions where items are identical in the same position of three given lists.\n\n    Args:\n        list1: The first input list.\n        list2: The second input list.\n        list3: The third input list.\n\n    Returns:\n        The total count of positions where items are identical across all three lists.\n    \"\"\"\n    min_length = min(len(list1), len(list2), len(list3))\n    count = 0\n    for i in range(min_length):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
