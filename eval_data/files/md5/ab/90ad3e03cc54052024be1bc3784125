{"task_id": "Mbpp/440", "solution": "import re\nimport string\ndef _strip_punctuation(word: str) -> str:\n    \"\"\"Removes trailing punctuation from a word.\"\"\"\n    while word and word[-1] in string.punctuation:\n        word = word[:-1]\n    return word\ndef _is_adverb(word: str) -> bool:\n    \"\"\"Determines if a given word (case-insensitively) is an adverb.\"\"\"\n    lower_word = word.lower()\n\n    # Hardcoded list of common adverbs that do not follow typical suffix patterns\n    common_adverbs = {\n        'very', 'well', 'always', 'never', 'here', 'there', 'now', 'then',\n        'often', 'seldom', 'soon', 'fast', 'slow', 'hard', 'early', 'late',\n        'rather', 'quite', 'almost', 'just', 'too', 'enough', 'ago', 'today',\n        'tomorrow', 'yesterday', 'down', 'up', 'in', 'out', 'away', 'back',\n        'forth', 'only', 'even'\n    }\n    if lower_word in common_adverbs:\n        return True\n\n    # Regular expression for common adverb suffixes: -ly, -ward, -wards, -wise\n    if re.fullmatch(r\".*(ly|ward|wards|wise)$\", lower_word):\n        return True\n\n    return False\ndef find_adverb_position(sentence: str) -> tuple[int, int, str]:\n    \"\"\"\n    Finds the first adverb and its 0-indexed start/end positions in a sentence.\n    Returns (-1, -1, '') if no adverb is found.\n    \"\"\"\n    current_pos = 0\n    words_in_sentence = sentence.split()\n\n    for token in words_in_sentence:\n        # Find the start index of the current token in the original sentence\n        start_index_in_sentence = sentence.find(token, current_pos)\n        \n        # If the token is not found (e.g., due to complex whitespace/unicode issues), skip.\n        # This is a defensive check, as split() and find() usually work well together.\n        if start_index_in_sentence == -1:\n            current_pos += len(token) + 1 # Approximate next position for continued search\n            continue\n\n        stripped_word = _strip_punctuation(token)\n\n        if _is_adverb(stripped_word):\n            # The end index is the start of the token plus the length of the *stripped* adverb.\n            end_index_in_sentence = start_index_in_sentence + len(stripped_word)\n            return (start_index_in_sentence, end_index_in_sentence, stripped_word)\n\n        # Update current_pos to search for the next token after the current one has ended.\n        # This handles cases where the same word appears multiple times.\n        current_pos = start_index_in_sentence + len(token)\n\n    return (-1, -1, '')"}
{"task_id": "Mbpp/445", "solution": "def index_multiplication(tuple1: tuple[tuple[int, int], ...], tuple2: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:\n    \"\"\"\n    Performs index-wise multiplication of elements within two input tuples of nested tuples.\n    Each corresponding inner tuple's first and second elements are multiplied.\n    \"\"\"\n    result_list = []\n    for inner_t1, inner_t2 in zip(tuple1, tuple2):\n        product_first = inner_t1[0] * inner_t2[0]\n        product_second = inner_t1[1] * inner_t2[1]\n        result_list.append((product_first, product_second))\n    return tuple(result_list)"}
