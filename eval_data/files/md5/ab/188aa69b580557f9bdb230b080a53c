{"task_id": "HumanEval/62", "solution": "class Polynomial:\n    \"\"\"Represents a polynomial with a list of coefficients.\"\"\"\n    def __init__(self, coefficients: list):\n        self.coefficients = coefficients\n\nclass Derivative:\n    \"\"\"Represents the derivative of a polynomial with a list of coefficients.\"\"\"\n    def __init__(self, coefficients: list):\n        self.coefficients = coefficients\n\nclass DerivativeCalculator:\n    \"\"\"Calculates the derivative of a polynomial.\"\"\"\n    def compute(self, poly: Polynomial) -> Derivative:\n        result_coeffs = []\n        # The derivative of c_k * x^k is k * c_k * x^(k-1).\n        # We iterate from the second coefficient (x^1 term) and apply the power rule.\n        for i in range(1, len(poly.coefficients)):\n            result_coeffs.append(i * poly.coefficients[i])\n        return Derivative(result_coeffs)\n\ndef derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    # Construct a Polynomial instance from the input coefficients.\n    poly = Polynomial(xs)\n    # Use DerivativeCalculator to compute the derivative.\n    calculator = DerivativeCalculator()\n    deriv_obj = calculator.compute(poly)\n    # Return the coefficients of the resulting derivative.\n    return deriv_obj.coefficients"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int):\n    \"\"\"Computes the n-th element of the fibfib number sequence efficiently.\n    Uses dynamic programming to achieve O(n) time complexity.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    # Initialize an array to store computed fibfib numbers up to n\n    fib_values = [0] * (n + 1)\n    fib_values[0] = 0\n    fib_values[1] = 0\n    fib_values[2] = 1\n\n    # Iterate from 3 up to n to compute subsequent fibfib numbers\n    for i in range(3, n + 1):\n        fib_values[i] = fib_values[i-1] + fib_values[i-2] + fib_values[i-3]\n\n    return fib_values[n]"}
{"task_id": "HumanEval/65", "solution": "class Number:\n    \"\"\"Represents a number's digits for circular shifting operations.\"\"\"\n    def __init__(self, value):\n        # Converts the integer value to its absolute string representation for digit manipulation.\n        self._value_str = str(abs(value))\n\n    def digit_count(self):\n        \"\"\"Returns the count of digits.\"\"\"\n        return len(self._value_str)\n\n    def to_string(self):\n        \"\"\"Returns the string representation of the digits.\"\"\"\n        return self._value_str\n\n\nclass CircularShiftService:\n    \"\"\"Provides the core logic for performing circular shifts.\"\"\"\n    def shift(self, x_val, shift_val):\n        \"\"\"Performs a circular shift or reversal based on defined rules.\"\"\"\n        number_obj = Number(x_val)\n        number_str = number_obj.to_string()\n        digit_count = number_obj.digit_count()\n\n        if shift_val > digit_count:\n            # Rule: If shift > number of digits, return digits reversed.\n            return number_str[::-1]\n        else:\n            # Rule: If shift <= number of digits, perform a right circular shift.\n            return number_str[-shift_val:] + number_str[:-shift_val]\n\n\ndef circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    \"\"\"\n    service = CircularShiftService()\n    return service.shift(x, shift)"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n    \"\"\"\n    count = 0\n    standard_vowels = \"aeiouAEIOU\"\n\n    for i, char in enumerate(s):\n        if char in standard_vowels:\n            count += 1\n        elif (char == 'y' or char == 'Y') and (i == len(s) - 1):\n            count += 1\n    return count"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculates the sum of ASCII codes of only the uppercase characters in the input string.\n    Non-uppercase characters are ignored.\"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/67", "solution": "import re\n\ndef fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket given apple and orange counts in a string\n    and the total number of fruits.\n    \"\"\"\n    \n    # Use regular expression to find the number of apples and oranges\n    match = re.search(r\"(\\d+)\\s*apples\\s*and\\s*(\\d+)\\s*oranges\", s)\n    \n    # Extract the numbers; the problem statement implies valid input strings.\n    apples = int(match.group(1))\n    oranges = int(match.group(2))\n    \n    # Calculate the number of mangoes\n    mangoes = n - apples - oranges\n    \n    return mangoes"}
{"task_id": "HumanEval/68", "solution": "import math\nfrom typing import List\n\n\ndef pluck(arr):\n    \"\"\"\n    Finds the smallest even value and its first index in the array.\n    Returns an empty list if no even values exist or the array is empty.\n    \"\"\"\n    min_even_value = math.inf\n    min_even_index = -1\n\n    for i, num in enumerate(arr):\n        if num % 2 == 0:  # Check if the number is even\n            if num < min_even_value:\n                min_even_value = num\n                min_even_index = i\n            elif num == min_even_value and i < min_even_index:\n                # If values are equal, choose the one with the smaller index\n                min_even_index = i\n\n    if min_even_value == math.inf:\n        return []\n    else:\n        return [min_even_value, min_even_index]"}
{"task_id": "HumanEval/69", "solution": "import collections\n\ndef search(lst):\n    \"\"\"\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    \"\"\"\n    freq_map = collections.Counter(lst)\n    \n    candidates = []\n    for num, freq in freq_map.items():\n        if num > 0 and freq >= num:\n            candidates.append(num)\n            \n    if not candidates:\n        return -1\n    \n    return max(candidates)"}
{"task_id": "HumanEval/71", "solution": "import math\n\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    if not (a > 0 and b > 0 and c > 0 and\n            a + b > c and\n            a + c > b and\n            b + c > a):\n        return -1\n    \n    s = (a + b + c) / 2\n    area_squared = s * (s - a) * (s - b) * (s - c)\n    \n    # Due to floating point inaccuracies, area_squared might be slightly negative for valid triangles.\n    # Take max(0, area_squared) to prevent math.sqrt from raising a ValueError.\n    area = math.sqrt(max(0, area_squared))\n    \n    return round(area, 2)"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    if not lst:\n        return []\n\n    sorted_lst = sorted(lst)\n    result = []\n    left = 0\n    right = len(sorted_lst) - 1\n    \n    turn = 0\n    while left <= right:\n        if turn % 2 == 0:\n            result.append(sorted_lst[left])\n            left += 1\n        else:\n            result.append(sorted_lst[right])\n            right -= 1\n        turn += 1\n            \n    return result"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    '''\n    Checks if the object q will fly based on balance (palindromic list) and total weight.\n    Delegates logic to helper functions for clarity.\n    '''\n    def is_palindromic(lst):\n        return lst == lst[::-1]\n\n    def sum_elements(lst):\n        return sum(lst)\n\n    return is_palindromic(q) and sum_elements(q) <= w"}
{"task_id": "HumanEval/74", "solution": "import typing\n\nclass StringList:\n    \"\"\"\n    Represents a list of strings and provides methods to calculate its total character count.\n    \"\"\"\n    def __init__(self, strings: typing.List[str]):\n        self.strings = strings\n\n    def total_characters(self) -> int:\n        \"\"\"\n        Calculates the sum of the lengths of all strings in the list.\n        \"\"\"\n        return sum(len(s) for s in self.strings)\n\n    def get_original_list(self) -> typing.List[str]:\n        \"\"\"\n        Returns the original list of strings.\n        \"\"\"\n        return self.strings\n\nclass TotalMatchService:\n    \"\"\"\n    Compares two StringList instances to determine which has fewer total characters.\n    \"\"\"\n    def compare(self, list1: StringList, list2: StringList) -> typing.List[str]:\n        \"\"\"\n        Compares two StringList objects and returns the list with fewer characters,\n        or the first list if character counts are equal.\n        \"\"\"\n        total_chars1 = list1.total_characters()\n        total_chars2 = list2.total_characters()\n\n        if total_chars1 <= total_chars2:\n            return list1.get_original_list()\n        else:\n            return list2.get_original_list()\n\ndef total_match(lst1, lst2):\n    \"\"\"\n    Returns the list with fewer total characters, or the first list if counts are equal.\n    \"\"\"\n    string_list1 = StringList(lst1)\n    string_list2 = StringList(lst2)\n    \n    service = TotalMatchService()\n    return service.compare(string_list1, string_list2)"}
{"task_id": "HumanEval/73", "solution": "import math\n\ndef smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic.\n    \"\"\"\n    n = len(arr)\n    changes = 0\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            changes += 1\n    return changes"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100. \n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    if a < 1 or a >= 100:\n        return False\n\n    def is_prime(num):\n        if num < 2:\n            return False\n        for i in range(2, int(num**0.5) + 1):\n            if num % i == 0:\n                return False\n        return True\n\n    prime_factors = []\n    temp_a = a\n    for i in range(2, temp_a + 1):\n        if is_prime(i):\n            while temp_a % i == 0:\n                prime_factors.append(i)\n                temp_a //= i\n        if temp_a == 1:\n            break\n    \n    return len(prime_factors) == 3"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if a number x is a simple power of n.\n    Returns true if there exists an integer k such that n**k = x.\"\"\"\n    if x == 1:\n        return True\n    \n    if x <= 0 or n <= 1:\n        return False\n    \n    current_x = x\n    while current_x % n == 0:\n        current_x //= n\n    \n    return current_x == 1"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"\n    Checks if an integer 'a' is a perfect cube.\n    \"\"\"\n    if a == 0:\n        return True\n\n    if a < 0:\n        # For negative numbers, calculate the cube root of the absolute value\n        # and then apply the negative sign to the result.\n        # Python's `a**(1/3)` for negative 'a' can yield complex numbers.\n        root_abs = abs(a) ** (1/3)\n        n = round(root_abs)\n        n = -n\n    else:\n        # For non-negative numbers, directly calculate and round the cube root.\n        n = round(a ** (1/3))\n    \n    return n ** 3 == a"}
{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal):\n    \"\"\"Converts a decimal number to its binary string representation,\n    prefixed and suffixed with 'db'.\n    \"\"\"\n    binary_representation = bin(decimal)[2:]\n    return \"db\" + binary_representation + \"db\""}
{"task_id": "HumanEval/78", "solution": "def hex_key(num):\n    \"\"\"Counts the number of prime hexadecimal digits in a given string.\n    Prime hex digits are 2, 3, 5, 7, B (11), D (13).\n    \"\"\"\n    prime_hex_digits = {'2', '3', '5', '7', 'B', 'D'}\n    count = 0\n    for digit in num:\n        if digit in prime_hex_digits:\n            count += 1\n    return count"}
