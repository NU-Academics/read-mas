{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    def is_prime(num):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if num <= 1:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    count = 0\n    a, b = 0, 1\n\n    while True:\n        next_fib = a + b\n        a, b = b, next_fib\n\n        if is_prime(next_fib):\n            count += 1\n            if count == n:\n                return next_fib"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    even_indexed_values = []\n    for i, val in enumerate(l):\n        if i % 2 == 0:\n            even_indexed_values.append(val)\n\n    even_indexed_values.sort()\n\n    result = []\n    even_ptr = 0\n    for i in range(len(l)):\n        if i % 2 == 0:\n            result.append(even_indexed_values[even_ptr])\n            even_ptr += 1\n        else:\n            result.append(l[i])\n    return result"}
{"task_id": "HumanEval/36", "solution": "class DigitCounter:\n    def countSevenIn(self, number: int) -> int:\n        \"\"\"Counts occurrences of the digit 7 in a number.\"\"\"\n        return str(number).count('7')\n\nclass Number:\n    def __init__(self, value: int):\n        self.value = value\n\n    def isDivisibleBy(self, divisor: int) -> bool:\n        \"\"\"Checks if the number is divisible by a given divisor.\"\"\"\n        return self.value % divisor == 0\n\n    def countDigit(self, digit: int) -> int:\n        \"\"\"Counts occurrences of a specific digit in the number, delegating to DigitCounter.\"\"\"\n        digit_counter = DigitCounter()\n        return digit_counter.countSevenIn(self.value)\n\nclass FizzBuzzService:\n    def __init__(self, n: int):\n        self.n = n\n\n    def countSevenOccurrences(self) -> int:\n        \"\"\"Calculates the total count of digit 7 in numbers satisfying the criteria.\"\"\"\n        total_sevens = 0\n        for i in range(1, self.n):\n            number_obj = Number(i)\n            if number_obj.isDivisibleBy(11) or number_obj.isDivisibleBy(13):\n                total_sevens += number_obj.countDigit(7)\n        return total_sevens\n\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    service = FizzBuzzService(n)\n    return service.countSevenOccurrences()"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    # Iterate through each element l[i] as the first number of a potential triplet.\n    for i in range(n - 2):\n        # Use a hash set to store numbers encountered after l[i] for efficient lookups.\n        # This set is re-initialized for each new 'i' to ensure distinct indices for the second and third numbers.\n        seen_elements_for_this_i = set()\n        \n        # Iterate through elements l[j] after l[i] as the second number.\n        for j in range(i + 1, n):\n            num1 = l[i]\n            num2 = l[j]\n            \n            # Calculate the value the third number must have to make the sum zero.\n            complement = -(num1 + num2)\n            \n            # If the complement is found in the set of elements already processed\n            # (i.e., some l[k] where i < k < j), then we have found three distinct\n            # elements (l[i], l[j], and l[k]) that sum to zero.\n            if complement in seen_elements_for_this_i:\n                return True\n            \n            # Add the current element l[j] to the set for subsequent checks within this inner loop.\n            seen_elements_for_this_i.add(num2)\n            \n    # If no such triplet is found after checking all combinations, return False.\n    return False"}
