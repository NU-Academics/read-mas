{"task_id": "HumanEval/49", "solution": "```python\ndef modp(n: int, p: int):\n    \"\"\"Calculates 2^n modulo p using exponentiation by squaring. Raises ValueError for invalid n or p.\"\"\"\n    if n < 0:\n        raise ValueError(\"Exponent 'n' must be a non-negative integer.\")\n    if p <= 0:\n        raise ValueError(\"Modulus 'p' must be a positive integer.\")\n\n    if n == 0:\n        return 1 % p\n\n    base = 2\n    result = 1\n    base %= p\n\n    while n > 0:\n        if n % 2 == 1:\n            result = (result * base) % p\n        base = (base * base) % p\n        n //= 2\n    return result\n```"}
{"task_id": "HumanEval/46", "solution": "```python\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to Fib4 calculation.\"\"\"\n    pass\n\n\ndef fib4(n: int) -> int:\n    \"\"\"Computes the n-th element of the Fib4 number sequence iteratively and efficiently.\n    The sequence is defined by fib4(0)=0, fib4(1)=0, fib4(2)=2, fib4(3)=0, and fib4(n) = fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4) for n > 3.\"\"\"\n\n    # Input validation: check if n is an integer and non-negative.\n    if not isinstance(n, int):\n        raise InvalidInputError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n\n    # Handle base cases directly as per the sequence definition.\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Iterative calculation for n > 3, avoiding recursion.\n    # `last_four` stores [fib4(i-4), fib4(i-3), fib4(i-2), fib4(i-1)] for the current iteration `i`.\n    last_four = [0, 0, 2, 0]  # Corresponds to fib4(0), fib4(1), fib4(2), fib4(3)\n\n    for i in range(4, n + 1):\n        next_fib4 = sum(last_four)\n        # Shift values: remove the oldest element and append the newly calculated one.\n        last_four.pop(0)\n        last_four.append(next_fib4)\n\n    # After the loop, the last element in `last_four` is fib4(n).\n    return last_four[3]\n```"}
{"task_id": "HumanEval/47", "solution": "```python\nclass EmptyListError(ValueError):\n    \"\"\"Custom exception for operations requiring a non-empty list.\n    It indicates that the input list provided was empty.\"\"\"\n    def __init__(self, message=\"Input list cannot be empty.\"):\n        self.message = message\n        super().__init__(self.message)\n\ndef median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    if not l:\n        raise EmptyListError(\"Cannot calculate median of an empty list.\")\n\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        return sorted_l[n // 2]\n    else:\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2.0\n```"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    if not l:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    for x in l:\n        if not isinstance(x, (int, float)):\n            raise TypeError(\"Input list must contain only numbers.\")\n\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # Odd number of elements: return the middle element.\n        return sorted_l[n // 2]\n    else:\n        # Even number of elements: return the average of the two middle elements.\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2.0"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    elif n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n    else:\n        # Initialize the last four values: fib4(0), fib4(1), fib4(2), fib4(3)\n        # a = fib4(i-4), b = fib4(i-3), c = fib4(i-2), d = fib4(i-1)\n        a, b, c, d = 0, 0, 2, 0\n\n        for _ in range(4, n + 1):\n            next_fib4 = a + b + c + d\n            a, b, c, d = b, c, d, next_fib4\n        return d"}
