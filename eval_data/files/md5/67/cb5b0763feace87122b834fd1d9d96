{"task_id": "HumanEval/92", "solution": "```python\ndef any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    \n    Examples\n    any_int(5, 2, 7) \u279e True\n    \n    any_int(3, 2, 2) \u279e False\n\n    any_int(3, -2, 1) \u279e True\n    \n    any_int(3.6, -2.2, 2) \u279e False\n    '''\n    if not all(isinstance(arg, int) for arg in [x, y, z]):\n        return False\n    \n    return (x == y + z) or (y == x + z) or (z == x + y)\n```"}
{"task_id": "HumanEval/91", "solution": "import re\n\n# Define sentence delimiters as specified in the design.\nSENTENCE_DELIMITERS = ['.', '?', '!']\n\ndef _split_into_sentences(text: str) -> list[str]:\n    \"\"\"Splits the input text into a list of cleaned sentence strings.\n    Sentences are delimited by specified punctuation, with whitespace trimmed.\"\"\"\n    # Create a regex pattern to split by any of the delimiters, treating multiple as one.\n    delimiter_pattern = '|'.join(re.escape(d) for d in SENTENCE_DELIMITERS)\n    sentences = re.split(f'[{delimiter_pattern}]+', text)\n    \n    # Clean up each sentence by stripping whitespace and filtering out empty strings.\n    return [s.strip() for s in sentences if s.strip()]\n\ndef _starts_with_i(sentence: str) -> bool:\n    \"\"\"Checks if a given sentence starts with the single uppercase word 'I'.\n    This means \"I \" (I followed by a space) or the entire sentence is \"I\".\"\"\"\n    # The check is case-sensitive, matching \"I \" or \"I\" exactly.\n    return sentence.startswith(\"I \") or sentence == \"I\"\n\ndef is_bored(S):\n    \"\"\"\n    Counts sentences starting with the word \"I\" (boredoms).\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    if not isinstance(S, str):\n        raise TypeError(\"Input must be a string.\")\n\n    boredom_count = 0\n    sentences = _split_into_sentences(S)\n    for sentence in sentences:\n        if _starts_with_i(sentence):\n            boredom_count += 1\n            \n    return boredom_count"}
{"task_id": "HumanEval/93", "solution": "```python\ndef encode(message):\n    \"\"\"\n    Encodes a message by swapping letter case and replacing vowels.\n    Vowels are replaced by the letter two places ahead in the alphabet.\n    \"\"\"\n    VOWELS = \"aeiouAEIOU\"\n    ALPHABET_LOWER = \"abcdefghijklmnopqrstuvwxyz\"\n    ALPHABET_UPPER = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n\n    def _swap_case_char(char: str) -> str:\n        \"\"\"Helper to swap the case of a single character.\"\"\"\n        if 'a' <= char <= 'z':\n            return char.upper()\n        elif 'A' <= char <= 'Z':\n            return char.lower()\n        return char\n\n    def _replace_vowel_char(char: str) -> str:\n        \"\"\"Helper to replace a vowel character with the letter two places ahead.\"\"\"\n        if char in VOWELS:\n            is_lower = char.islower()\n            char_lower = char.lower()\n            \n            # Calculate the new index and get the replaced character.\n            if char_lower in ALPHABET_LOWER:\n                idx = ALPHABET_LOWER.find(char_lower)\n                new_idx = (idx + 2) % len(ALPHABET_LOWER) \n                replaced_char = ALPHABET_LOWER[new_idx]\n                return replaced_char if is_lower else replaced_char.upper()\n        return char\n\n    encoded_chars = []\n    for char in message:\n        swapped_char = _swap_case_char(char)\n        final_char = _replace_vowel_char(swapped_char)\n        encoded_chars.append(final_char)\n    return \"\".join(encoded_chars)\n```"}
{"task_id": "HumanEval/94", "solution": "```python\ndef skjkasdkd(lst):\n    \"\"\"Finds the largest prime number in a list and returns the sum of its digits.\n    Returns 0 if the list is empty or contains no prime numbers.\"\"\"\n\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if an integer is prime using an optimized trial division method.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of digits for the absolute value of an integer.\"\"\"\n        return sum(int(digit) for digit in str(abs(n)))\n\n    largest_prime = None\n\n    for item in lst:\n        if not isinstance(item, int):\n            raise ValueError(\"List elements must be integers.\")\n            \n        if is_prime(item):\n            if largest_prime is None or item > largest_prime:\n                largest_prime = item\n    \n    if largest_prime is not None:\n        return sum_digits(largest_prime)\n    else:\n        return 0\n```"}
{"task_id": "HumanEval/94", "solution": "```python\nimport math\n\ndef _is_prime(n: int) -> bool:\n    \"\"\"Checks if a number is prime using trial division up to its square root.\"\"\"\n    if n < 2:\n        return False\n    for i in range(2, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            return False\n    return True\n\ndef _sum_digits(n: int) -> int:\n    \"\"\"Calculates the sum of the digits of a number's absolute value.\"\"\"\n    s = 0\n    n_abs = abs(n)\n    while n_abs > 0:\n        s += n_abs % 10\n        n_abs //= 10\n    return s\n\ndef skjkasdkd(lst: list[int]) -> int:\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n\n    Examples:\n    For lst = [0,3,2,1,3,5,7,4,5,5,5,2,181,32,4,32,3,2,32,324,4,3] the output should be 10\n    For lst = [1,0,1,8,2,4597,2,1,3,40,1,2,1,2,4,2,5,1] the output should be 25\n    For lst = [1,3,1,32,5107,34,83278,109,163,23,2323,32,30,1,9,3] the output should be 13\n    For lst = [0,724,32,71,99,32,6,0,5,91,83,0,5,6] the output should be 11\n    For lst = [0,81,12,3,1,21] the output should be 3\n    For lst = [0,8,1,2,1,7] the output should be 7\n    \"\"\"\n    largest_prime = None\n    for num in lst:\n        if _is_prime(num):\n            if largest_prime is None or num > largest_prime:\n                largest_prime = num\n\n    if largest_prime is None:\n        return 0\n    \n    return _sum_digits(largest_prime)\n```"}
{"task_id": "HumanEval/93", "solution": "```python\ndef encode(message):\n    \"\"\"\n    Encodes a message by swapping case and replacing vowels.\n    Vowels are replaced by the letter two places ahead in the alphabet.\n    \"\"\"\n    VOWELS_LOWER = {'a', 'e', 'i', 'o', 'u'}\n    VOWELS_UPPER = {'A', 'E', 'I', 'O', 'U'}\n    ALPHABET_LOWER = 'abcdefghijklmnopqrstuvwxyz'\n    ALPHABET_UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'\n\n    def _replace_vowel(char: str) -> str:\n        # Replaces a vowel with the letter two places ahead in the alphabet, maintaining case.\n        # Modulo arithmetic handles potential wrap-around, though not strictly needed for current vowels.\n        if char in VOWELS_LOWER:\n            idx = ALPHABET_LOWER.index(char)\n            return ALPHABET_LOWER[(idx + 2) % len(ALPHABET_LOWER)]\n        elif char in VOWELS_UPPER:\n            idx = ALPHABET_UPPER.index(char)\n            return ALPHABET_UPPER[(idx + 2) % len(ALPHABET_UPPER)]\n        return char\n\n    encoded_chars = []\n    for char in message:\n        # First, swap the case of the character. Non-letters are returned unchanged by swapcase().\n        swapped_char = char.swapcase()\n        \n        # If the swapped character is a vowel, apply the vowel replacement rule.\n        if swapped_char in VOWELS_LOWER or swapped_char in VOWELS_UPPER:\n            encoded_chars.append(_replace_vowel(swapped_char))\n        else:\n            encoded_chars.append(swapped_char)\n            \n    return \"\".join(encoded_chars)\n```"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"\n    Checks if all string keys in the dictionary are consistently lowercase or uppercase.\n    Returns False if the dictionary is empty, has non-string keys, or mixed-case string keys.\n    \"\"\"\n    if not dict:\n        return False\n\n    expected_case = None\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n\n        is_current_key_lower = key.islower()\n        is_current_key_upper = key.isupper()\n\n        if not is_current_key_lower and not is_current_key_upper:\n            return False\n\n        if expected_case is None:\n            # Set the expected case based on the first valid string key encountered.\n            if is_current_key_lower:\n                expected_case = \"lower\"\n            elif is_current_key_upper:\n                expected_case = \"upper\"\n        else:\n            # Validate subsequent keys against the established expected case.\n            if expected_case == \"lower\" and not is_current_key_lower:\n                return False\n            if expected_case == \"upper\" and not is_current_key_upper:\n                return False\n    \n    return True\n```"}
{"task_id": "HumanEval/96", "solution": "def is_prime(num: int) -> bool:\n    \"\"\"\n    Determines if a given integer num is a prime number.\n    Returns True if num is prime, False otherwise.\n    \"\"\"\n    if not isinstance(num, int):\n        raise ValueError(\"Input must be an integer.\")\n    if num < 2:\n        return False\n    # Checks for divisors from 2 up to the square root of num.\n    for i in range(2, int(num**0.5) + 1):\n        if num % i == 0:\n            return False\n    return True\n\ndef count_up_to(n: int) -> list[int]:\n    \"\"\"\n    Calculates and returns a list of all prime numbers strictly less than n.\n    Raises ValueError for invalid input n.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    primes = []\n    # Iterates from 2 up to n-1 to find primes using the helper function.\n    for num in range(2, n):\n        if is_prime(num):\n            primes.append(num)\n    return primes"}
