{"task_id": "HumanEval/125", "solution": "```python\ndef split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3\n    '''\n    \n    has_whitespace = False\n    for char in txt:\n        if char.isspace():\n            has_whitespace = True\n            break\n\n    if has_whitespace:\n        return txt.split()\n    else:\n        if ',' in txt:\n            return txt.split(',')\n        else:\n            count = 0\n            for char in txt:\n                if 'a' <= char <= 'z':\n                    order = ord(char) - ord('a')\n                    if order % 2 != 0:\n                        count += 1\n            return count\n\n```"}
{"task_id": "HumanEval/124", "solution": "```python\nimport re\n\ndef valid_date(date):\n    \"\"\"Validates a date string according to specified rules and format 'mm-dd-yyyy'.\n    Returns True if the date is valid, otherwise False.\n    \"\"\"\n    # 1. The date string is not empty and is a string.\n    if not isinstance(date, str) or not date:\n        return False\n\n    # 4. The date should be in the format: mm-dd-yyyy.\n    # Regex to match mm-dd-yyyy format and capture components.\n    match = re.fullmatch(r'(\\d{2})-(\\d{2})-(\\d{4})', date)\n    if not match:\n        return False\n\n    try:\n        month = int(match.group(1))\n        day = int(match.group(2))\n        # Year is parsed to confirm format but not used for specific validity checks.\n        # year = int(match.group(3)) \n    except ValueError:\n        # This catch adds robustness for unexpected non-integer parts.\n        return False\n\n    # 3. Months should not be less than 1 or higher than 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # Define maximum days for each month, with February allowing 29 days.\n    MONTH_DAYS = {\n        1: 31, 2: 29, 3: 31, 4: 30, 5: 31,\n        6: 30, 7: 31, 8: 31, 9: 30, 10: 31,\n        11: 30, 12: 31\n    }\n\n    # 2. Validate day component based on the month.\n    # Day must be between 1 and the maximum allowed for the given month.\n    if not (1 <= day <= MONTH_DAYS.get(month, 0)):\n        return False\n            \n    return True\n```"}
{"task_id": "HumanEval/127", "solution": "```python\ndef is_prime(n: int) -> bool:\n    \"\"\"Checks if a non-negative integer is a prime number.\n    Returns True if n is prime, False otherwise.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef intersection(interval1: tuple[int, int], interval2: tuple[int, int]) -> str:\n    \"\"\"Determines if the length of the intersection of two intervals is a prime number.\n    Returns \"YES\" if prime, \"NO\" otherwise.\"\"\"\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    # Calculate intersection bounds\n    inter_start = max(start1, start2)\n    inter_end = min(end1, end2)\n\n    # Calculate intersection length\n    if inter_start > inter_end:\n        intersection_length = 0\n    else:\n        intersection_length = inter_end - inter_start + 1\n\n    # Check if the length is a prime number\n    if is_prime(intersection_length):\n        return \"YES\"\n    else:\n        return \"NO\"\n```"}
