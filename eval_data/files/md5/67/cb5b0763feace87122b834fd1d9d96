{"task_id": "HumanEval/70", "solution": "```python\nfrom typing import List\n\ndef strange_sort_list(lst: List[int]) -> List[int]:\n    \"\"\"\n    Given list of integers, return list in strange order.\n    Starts with the minimum value, then maximum of the remaining, then minimum, and so on.\n    \"\"\"\n    if not lst:\n        return []\n\n    # Create a mutable, sorted copy of the input list to process elements.\n    # The loop alternates between finding and removing the minimum or maximum element.\n    mutable_list = sorted(lst)\n    result_list = []\n    is_min_turn = True\n\n    while mutable_list:\n        if is_min_turn:\n            element = min(mutable_list)\n            mutable_list.remove(element)\n        else:\n            element = max(mutable_list)\n            mutable_list.remove(element)\n        \n        result_list.append(element)\n        is_min_turn = not is_min_turn\n    \n    return result_list\n```"}
{"task_id": "HumanEval/71", "solution": "```python\nimport math\n\nclass TriangleValidator:\n    def is_valid(self, a: float, b: float, c: float) -> bool:\n        \"\"\"Checks if side lengths form a valid triangle, ensuring positive sides and triangle inequality.\"\"\"\n        if not (a > 0 and b > 0 and c > 0):\n            return False\n        return (a + b > c) and (a + c > b) and (b + c > a)\n\nclass AreaCalculator:\n    def calculate_herons_area(self, a: float, b: float, c: float) -> float:\n        \"\"\"Computes the area of a triangle using Heron's formula for valid side lengths.\"\"\"\n        s = (a + b + c) / 2\n        area_squared = s * (s - a) * (s - b) * (s - c)\n        # Handle potential floating point inaccuracies that might make area_squared slightly negative.\n        if area_squared < 0:\n            area_squared = 0\n        return math.sqrt(area_squared)\n\nclass TriangleService:\n    def __init__(self, validator: TriangleValidator, calculator: AreaCalculator):\n        \"\"\"Initializes the service with validator and calculator dependencies.\"\"\"\n        self.validator = validator\n        self.calculator = calculator\n\n    def get_area(self, a: float, b: float, c: float) -> float:\n        \"\"\"Validates a triangle and calculates its area, returning -1.0 if invalid.\"\"\"\n        if not self.validator.is_valid(a, b, c):\n            return -1.0\n        \n        area = self.calculator.calculate_herons_area(a, b, c)\n        return round(area, 2)\n\ndef triangle_area(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    \"\"\"\n    validator = TriangleValidator()\n    calculator = AreaCalculator()\n    service = TriangleService(validator, calculator)\n    return service.get_area(a, b, c)\n```"}
{"task_id": "HumanEval/71", "solution": "import math\n\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    \n    # TriangleValidator logic\n    if not all(isinstance(side, (int, float)) and side > 0 for side in [a, b, c]):\n        return -1\n    if not ((a + b > c) and (a + c > b) and (b + c > a)):\n        return -1\n\n    # TriangleCalculator logic (Heron's formula)\n    s = (a + b + c) / 2\n    # Use max(0, ...) to prevent math domain error due to floating point inaccuracies\n    # for nearly degenerate triangles, ensuring a non-negative value under the square root.\n    area_squared = s * (s - a) * (s - b) * (s - c)\n    area = math.sqrt(max(0, area_squared))\n    \n    # Round the area to 2 decimal points\n    return round(area, 2)"}
{"task_id": "HumanEval/73", "solution": "```python\ndef smallest_change(arr):\n    \"\"\"\n    Calculates the minimum changes to make an array palindromic.\n    Compares elements from both ends and increments a counter for mismatches.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list.\")\n\n    for item in arr:\n        if not isinstance(item, int):\n            raise ValueError(\"All elements in the list must be integers.\")\n\n    changes = 0\n    left = 0\n    right = len(arr) - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes\n```"}
{"task_id": "HumanEval/70", "solution": "```python\ndef strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n\n    Examples:\n    strange_sort_list([1, 2, 3, 4]) == [1, 4, 2, 3]\n    strange_sort_list([5, 5, 5, 5]) == [5, 5, 5, 5]\n    strange_sort_list([]) == []\n    '''\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n    for item in lst:\n        if not isinstance(item, int):\n            raise TypeError(f\"All elements in the list must be integers. Found type {type(item).__name__}.\")\n\n    if not lst:\n        return []\n\n    current_list = list(lst)  # Create a mutable copy to avoid modifying the original list.\n    result_list = []\n\n    while current_list:\n        # Find, append, and remove the minimum value\n        min_val = min(current_list)\n        result_list.append(min_val)\n        current_list.remove(min_val)\n\n        # If elements still remain, find, append, and remove the maximum value\n        if current_list:\n            max_val = max(current_list)\n            result_list.append(max_val)\n            current_list.remove(max_val)\n\n    return result_list\n```"}
{"task_id": "HumanEval/73", "solution": "```python\ndef smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n    for item in arr:\n        if not isinstance(item, int):\n            raise TypeError(\"All elements in 'arr' must be integers.\")\n\n    changes = 0\n    left, right = 0, len(arr) - 1\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes\n```"}
