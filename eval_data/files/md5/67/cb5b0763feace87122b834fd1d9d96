{"task_id": "HumanEval/0", "solution": "from typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"Checks if any two distinct numbers in a list are closer than a threshold.\n    Returns True if such a pair exists, False otherwise.\"\"\"\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    # Sort the list to optimize the search. If two numbers are close, they must be adjacent after sorting.\n    sorted_numbers = sorted(numbers)\n\n    for i in range(n - 1):\n        if abs(sorted_numbers[i+1] - sorted_numbers[i]) < threshold:\n            return True\n\n    return False"}
{"task_id": "HumanEval/0", "solution": "```python\nfrom typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise ValueError(\"Input 'numbers' must be a list.\")\n    if not all(isinstance(n, (int, float)) for n in numbers):\n        raise ValueError(\"All elements in 'numbers' must be numeric.\")\n    if not isinstance(threshold, (int, float)):\n        raise ValueError(\"Input 'threshold' must be a numeric value.\")\n    if threshold < 0:\n        raise ValueError(\"Threshold cannot be negative.\")\n\n    # Convert all numbers to float for consistent comparison and to handle int inputs gracefully.\n    numbers = [float(n) for n in numbers]\n    threshold = float(threshold)\n\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False\n```"}
{"task_id": "HumanEval/2", "solution": "import math\n\ndef truncate_number(number: float) -> float:\n    \"\"\"Given a positive floating point number, it returns its decimal part.\n    The decimal part is always a float value between 0 (inclusive) and 1 (exclusive).\n    \"\"\"\n    if not isinstance(number, float):\n        raise TypeError(\"Input 'number' must be a float.\")\n    \n    return number - math.floor(number)"}
{"task_id": "HumanEval/1", "solution": "```python\nfrom typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Separates distinct, balanced, and non-nested parenthesis groups from an input string, ignoring spaces.\n    Returns a list of these individual, separated groups.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    cleaned_string = paren_string.replace(\" \", \"\")\n    groups: List[str] = []\n    current_group_start = 0\n    balance = 0\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n\n        if balance == 0 and i >= current_group_start:\n            # Found a balanced group, add it to the list.\n            groups.append(cleaned_string[current_group_start : i + 1])\n            current_group_start = i + 1\n        elif balance < 0:\n            # Unbalanced closing parenthesis, reset to find a new group.\n            current_group_start = i + 1\n            balance = 0\n    \n    return groups\n```"}
{"task_id": "HumanEval/5", "solution": "```python\nfrom typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers`.\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result\n```"}
{"task_id": "HumanEval/5", "solution": "```python\nfrom typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"Insert a number 'delimeter' between every two consecutive elements of input list `numbers`.\n    Returns an empty list if `numbers` is empty, or the original list if it has one element.\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result\n```"}
{"task_id": "HumanEval/1", "solution": "```python\nfrom typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separates multiple balanced, non-nested parenthesis groups from an input string, ignoring spaces.\n    Returns a list of these distinct, top-level groups.\n    \"\"\"\n    \n    cleaned_string = paren_string.replace(\" \", \"\")\n    \n    result_groups: List[str] = []\n    balance = 0\n    current_group_start_index = -1 \n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            # If balance is 0, this '(' marks the beginning of a potential new top-level group.\n            if balance == 0:\n                current_group_start_index = i\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        # Non-parenthesis characters contribute to the group content but do not affect balance.\n\n        # When balance returns to 0, a complete, top-level balanced group has been found.\n        if balance == 0 and current_group_start_index != -1:\n            group = cleaned_string[current_group_start_index : i + 1]\n            result_groups.append(group)\n            current_group_start_index = -1 # Reset to find the next independent group\n\n        # If balance drops below zero, it indicates an unmatched closing parenthesis.\n        # The current sequence is considered broken; reset to search for new groups.\n        if balance < 0:\n            balance = 0 \n            current_group_start_index = -1\n            \n    return result_groups\n```"}
{"task_id": "HumanEval/4", "solution": "```python\nfrom typing import List\nimport math\n\nclass EmptyInputError(Exception):\n    \"\"\"Custom exception raised when an input list is empty.\"\"\"\n    def __init__(self, message: str = \"Input list cannot be empty.\"):\n        self.message = message\n        super().__init__(self.message)\n\nclass MeanAbsoluteDeviationCalculator:\n    \"\"\"Provides methods to calculate components of Mean Absolute Deviation.\"\"\"\n    @staticmethod\n    def calculate_mean(numbers: List[float]) -> float:\n        \"\"\"Computes the arithmetic mean of a list of numbers.\"\"\"\n        if not numbers:\n            raise EmptyInputError(\"Cannot calculate mean of an empty list.\")\n        return sum(numbers) / len(numbers)\n\n    @staticmethod\n    def calculate_absolute_differences(numbers: List[float], mean: float) -> List[float]:\n        \"\"\"Calculates the absolute difference between each number and the provided mean.\"\"\"\n        return [math.fabs(x - mean) for x in numbers]\n\n    @staticmethod\n    def calculate_mad(numbers: List[float]) -> float:\n        \"\"\"Orchestrates the calculation of the Mean Absolute Deviation.\"\"\"\n        if not numbers:\n            raise EmptyInputError(\"Cannot calculate Mean Absolute Deviation of an empty list.\")\n        \n        mean = MeanAbsoluteDeviationCalculator.calculate_mean(numbers)\n        abs_diffs = MeanAbsoluteDeviationCalculator.calculate_absolute_differences(numbers, mean)\n        \n        # Calculate mean of absolute differences. abs_diffs cannot be empty if numbers wasn't.\n        return sum(abs_diffs) / len(abs_diffs)\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"Calculates the Mean Absolute Deviation for a list of numbers around their mean.\n    MAD is the average of the absolute differences between each data point and the mean.\n    \"\"\"\n    return MeanAbsoluteDeviationCalculator.calculate_mad(numbers)\n```"}
