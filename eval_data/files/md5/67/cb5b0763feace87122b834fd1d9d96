{"task_id": "HumanEval/68", "solution": "```python\nimport math\n\ndef pluck(arr: list[int]) -> list[int | int]:\n    \"\"\"\n    Finds the smallest even non-negative integer and its index in `arr`, prioritizing the smallest index if values are equal.\n    Returns `[]` if no even values are found or the array is empty.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = math.inf\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even.\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n            elif value == smallest_even_value:\n                # If values are equal, we already have the smallest index from an earlier check.\n                pass\n\n    if smallest_even_index == -1:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]\n\n```"}
{"task_id": "HumanEval/67", "solution": "```python\nimport re\n\ndef fruit_distribution(s,n):\n    \"\"\"\n    In this task, you will be given a string that represents a number of apples and oranges \n    that are distributed in a basket of fruit this basket contains \n    apples, oranges, and mango fruits. Given the string that represents the total number of \n    the oranges and apples and an integer that represent the total number of the fruits \n    in the basket return the number of the mango fruits in the basket.\n    for examble:\n    fruit_distribution(\"5 apples and 6 oranges\", 19) ->19 - 5 - 6 = 8\n    fruit_distribution(\"0 apples and 1 oranges\",3) -> 3 - 0 - 1 = 2\n    fruit_distribution(\"2 apples and 3 oranges\", 100) -> 100 - 2 - 3 = 95\n    fruit_distribution(\"100 apples and 1 oranges\",120) -> 120 - 100 - 1 = 19\n    \"\"\"\n    \n    apple_count = 0\n    orange_count = 0\n\n    # Extract apple count\n    apple_match = re.search(r'(\\d+)\\s+apples', s, re.IGNORECASE)\n    if apple_match:\n        apple_count = int(apple_match.group(1))\n\n    # Extract orange count\n    orange_match = re.search(r'(\\d+)\\s+oranges', s, re.IGNORECASE)\n    if orange_match:\n        orange_count = int(orange_match.group(1))\n\n    # Calculate remaining fruits (mangoes)\n    remaining_fruits = n - apple_count - orange_count\n    \n    return remaining_fruits\n```"}
{"task_id": "HumanEval/68", "solution": "```python\ndef pluck(arr):\n    \"\"\"\n    Finds the smallest even non-negative integer in an array, breaking ties by smallest index.\n    Returns [value, index] or an empty list if no even numbers are found or input is invalid.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        # Skip elements that are not non-negative integers as per FR2 error handling.\n        if not isinstance(value, int) or value < 0:\n            continue\n\n        if value % 2 == 0:  # Check if the number is even\n            if value < smallest_even_value:\n                # Found a new smallest even value, update both value and index.\n                smallest_even_value = value\n                smallest_even_index = index\n            elif value == smallest_even_value:\n                # Found an even value equal to the current smallest; apply index tie-breaker.\n                if index < smallest_even_index:\n                    smallest_even_index = index\n\n    # Return the identified node or an empty list if no even numbers were found.\n    if smallest_even_index != -1:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []\n\n```"}
{"task_id": "HumanEval/69", "solution": "```python\nfrom collections import Counter\n\ndef search(lst: list[int]) -> int:\n    \"\"\"\n    Returns the greatest integer that is greater than zero, and has a\n    frequency greater than or equal to the value of the integer itself.\n    Returns -1 if no such value exists.\n    \"\"\"\n    frequencies = Counter(lst)\n\n    candidates = []\n    for num, freq in frequencies.items():\n        if num > 0 and freq >= num:\n            candidates.append(num)\n\n    if not candidates:\n        return -1\n\n    return max(candidates)\n```"}
{"task_id": "HumanEval/69", "solution": "```python\nfrom collections import Counter\n\ndef search(lst):\n    \"\"\"\n    Finds the greatest integer in a list whose frequency is greater than or equal to its value.\n    Returns -1 if no such integer exists.\n    \"\"\"\n    frequencies = Counter(lst)\n    \n    qualifying_integers = []\n    for num, freq in frequencies.items():\n        if freq >= num:\n            qualifying_integers.append(num)\n            \n    if not qualifying_integers:\n        return -1\n    \n    return max(qualifying_integers)\n```"}
{"task_id": "HumanEval/67", "solution": "```python\nimport re\n\nclass ParsingError(Exception):\n    \"\"\"Custom exception for errors encountered during string parsing.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\nclass CalculationError(Exception):\n    \"\"\"Custom exception for errors encountered during mango calculation.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\nclass FruitCounts:\n    \"\"\"A simple data transfer object to hold the parsed counts of apples and oranges.\"\"\"\n    def __init__(self, apples: int, oranges: int):\n        if not isinstance(apples, int) or apples < 0:\n            raise ValueError(\"Apples must be a non-negative integer.\")\n        if not isinstance(oranges, int) or oranges < 0:\n            raise ValueError(\"Oranges must be a non-negative integer.\")\n        self.apples = apples\n        self.oranges = oranges\n\nclass FruitStringParser:\n    \"\"\"Parses an input string to extract the number of apples and oranges.\"\"\"\n    def parse(self, s: str) -> FruitCounts:\n        \"\"\"Extracts apple and orange counts from the input string `s` using regular expressions.\"\"\"\n        apple_match = re.search(r'(\\d+)\\s+apples', s, re.IGNORECASE)\n        orange_match = re.search(r'(\\d+)\\s+oranges', s, re.IGNORECASE)\n\n        if not apple_match or not orange_match:\n            raise ParsingError(\"Input string must contain counts for both 'apples' and 'oranges'.\")\n\n        try:\n            apples = int(apple_match.group(1))\n            oranges = int(orange_match.group(1))\n        except ValueError:\n            raise ParsingError(\"Could not convert extracted fruit counts to integers.\")\n        \n        return FruitCounts(apples, oranges)\n\nclass FruitCalculator:\n    \"\"\"Performs the calculation of mango fruits based on provided fruit counts.\"\"\"\n    def calculate_mangoes(self, fruit_counts: FruitCounts, total_fruits: int) -> int:\n        \"\"\"Calculates the number of mangoes by subtracting the sum of apples and oranges from the total fruits.\"\"\"\n        if not isinstance(total_fruits, int):\n            raise ValueError(\"Total fruits must be an integer.\")\n        if total_fruits < 0:\n            raise CalculationError(\"Total fruits cannot be negative.\")\n\n        sum_apples_oranges = fruit_counts.apples + fruit_counts.oranges\n        \n        if total_fruits < sum_apples_oranges:\n            raise CalculationError(\"Total fruits cannot be less than the sum of apples and oranges.\")\n        \n        mango_count = total_fruits - sum_apples_oranges\n        return mango_count\n\ndef fruit_distribution(s, n):\n    \"\"\"Calculates the number of mangoes given a string of apple/orange counts and a total.\"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Total fruits 'n' must be an integer.\")\n\n    parser = FruitStringParser()\n    fruit_counts = parser.parse(s)\n\n    calculator = FruitCalculator()\n    mango_count = calculator.calculate_mangoes(fruit_counts, n)\n\n    return mango_count\n```"}
