{"task_id": "HumanEval/116", "solution": "```python\ndef sort_array(arr):\n    \"\"\"\n    Sorts an array of integers first by the number of set bits (absolute value),\n    then by their decimal value, both in ascending order.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise TypeError(\"All elements in the list must be integers.\")\n\n    def _count_set_bits(n: int) -> int:\n        \"\"\"\n        Counts set bits using Brian Kernighan's algorithm on the absolute value of n.\n        This handles negative numbers by using their magnitude for bit counting.\n        \"\"\"\n        count = 0\n        val = abs(n)\n        while val > 0:\n            val &= (val - 1)\n            count += 1\n        return count\n\n    return sorted(arr, key=lambda n: (_count_set_bits(n), n))\n```"}
{"task_id": "HumanEval/117", "solution": "```python\ndef select_words(s: str, n: int) -> list[str]:\n    \"\"\"Given a string s and a natural number n, returns a list of words from s \n    that contain exactly n consonants, in order these words appear in the string s.\"\"\"\n\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def is_vowel(char: str) -> bool:\n        \"\"\"Determines if a given character is a vowel (case-insensitive).\"\"\"\n        return char.lower() in VOWELS\n\n    def count_consonants(word: str) -> int:\n        \"\"\"Counts the number of consonants in a given word.\"\"\"\n        consonant_count = 0\n        for char in word:\n            # Consonants are letters that are not vowels.\n            if char.isalpha() and not is_vowel(char):\n                consonant_count += 1\n        return consonant_count\n\n    if not s:\n        return []\n\n    result_words = []\n    words = s.split()\n    for word in words:\n        if count_consonants(word) == n:\n            result_words.append(word)\n    return result_words\n```\n"}
{"task_id": "HumanEval/115", "solution": "import math\n\nclass Well:\n    \"\"\"Represents a single well, storing its water content. It can be created from a list of 0s and 1s representing a row.\"\"\"\n    def __init__(self, water_units: int):\n        if not isinstance(water_units, int) or water_units < 0:\n            raise ValueError(\"Water units must be a non-negative integer.\")\n        self._water_units = water_units\n\n    @classmethod\n    def from_row(cls, row_data: list[int]) -> 'Well':\n        \"\"\"Factory method to create a Well from a row of integers. It calculates and stores the total water units.\"\"\"\n        if not all(isinstance(unit, int) and unit in (0, 1) for unit in row_data):\n            raise ValueError(\"Row data must contain only 0s and 1s.\")\n        water_units = sum(row_data)\n        return cls(water_units)\n\n    def get_water_units(self) -> int:\n        \"\"\"Returns the total water units contained within this well.\"\"\"\n        return self._water_units\n\nclass Grid:\n    \"\"\"Represents the entire grid, containing a list of Well objects. It provides a way to construct itself from raw grid data.\"\"\"\n    def __init__(self, wells: list[Well]):\n        if not all(isinstance(well, Well) for well in wells):\n            raise ValueError(\"All elements in wells must be Well objects.\")\n        self._wells = wells\n\n    @classmethod\n    def from_list(cls, grid_data: list[list[int]]) -> 'Grid':\n        \"\"\"Factory method to create a Grid object from a raw list of lists. It converts each inner list into a Well object.\"\"\"\n        if not isinstance(grid_data, list) or not all(isinstance(row, list) for row in grid_data):\n            raise ValueError(\"Grid data must be a list of lists.\")\n        wells = [Well.from_row(row) for row in grid_data]\n        return cls(wells)\n\n    def get_wells(self) -> list[Well]:\n        \"\"\"Returns the list of Well objects contained within the grid.\"\"\"\n        return self._wells\n\nclass Utils:\n    \"\"\"Provides general utility functions for mathematical calculations. It is a stateless class with static methods.\"\"\"\n    @staticmethod\n    def calculate_bucket_operations(water_units: int, capacity: int) -> int:\n        \"\"\"Calculates the minimum number of bucket operations needed. It uses ceiling division for precision.\"\"\"\n        if not isinstance(water_units, int) or water_units < 0:\n            raise ValueError(\"Water units must be a non-negative integer.\")\n        if not isinstance(capacity, int) or capacity <= 0:\n            raise ValueError(\"Capacity must be a positive integer.\")\n        \n        if water_units == 0:\n            return 0\n        return math.ceil(water_units / capacity)\n\ndef max_fill(grid: list[list[int]], capacity: int) -> int:\n    \"\"\"Calculates the total number of bucket lowering operations to empty all wells.\n    It processes a grid and a bucket capacity to find the total operations.\"\"\"\n    \n    if not isinstance(capacity, int) or not (1 <= capacity <= 10):\n        raise ValueError(\"Capacity must be an integer between 1 and 10.\")\n    \n    grid_object = Grid.from_list(grid)\n    total_operations = 0\n    for well in grid_object.get_wells():\n        water_units = well.get_water_units()\n        total_operations += Utils.calculate_bucket_operations(water_units, capacity)\n    return total_operations\n```"}
{"task_id": "HumanEval/117", "solution": "```python\ndef select_words(s, n):\n    \"\"\"Filters words from string s that have exactly n consonants.\n    Words are returned in their original order.\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    if not s:\n        return []\n\n    def is_vowel(char):\n        \"\"\"Checks if a given character is a vowel (case-insensitive).\"\"\"\n        return char.lower() in VOWELS\n\n    def count_consonants(word):\n        \"\"\"Counts the number of consonants in a given word.\"\"\"\n        count = 0\n        for char in word:\n            if char.isalpha() and not is_vowel(char):\n                count += 1\n        return count\n\n    words = s.split()\n    result = []\n\n    for word in words:\n        if count_consonants(word) == n:\n            result.append(word)\n\n    return result\n```"}
{"task_id": "HumanEval/116", "solution": "```python\ndef sort_array(arr):\n    \"\"\"\n    In this Kata, you have to sort an array of non-negative integers according to\n    number of ones in their binary representation in ascending order.\n    For similar number of ones, sort based on decimal value.\n    \"\"\"\n\n    def _count_set_bits(n: int) -> int:\n        # Counts '1' bits in the binary representation of a non-negative integer.\n        # This uses Brian Kernighan's algorithm; for negative numbers, it yields 0.\n        count = 0\n        current_n = n\n        while current_n > 0:\n            current_n &= (current_n - 1)\n            count += 1\n        return count\n\n    def _comparison_key(num: int) -> tuple[int, int]:\n        # Generates a tuple (count_of_set_bits, decimal_value) for sorting.\n        # It uses the internal _count_set_bits helper for the primary key.\n        set_bit_count = _count_set_bits(num)\n        return (set_bit_count, num)\n\n    return sorted(arr, key=_comparison_key)\n```"}
{"task_id": "HumanEval/119", "solution": "```python\ndef is_balanced(s: str) -> bool:\n    \"\"\"\n    Checks if a string of parentheses is balanced.\n    This involves tracking a balance counter and ensuring it never drops below zero.\n    \"\"\"\n    balance = 0\n    for char in s:\n        if char == '(':\n            balance += 1\n        else:  # char == ')'\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0\n\ndef validate_parentheses_string(s: str) -> None:\n    \"\"\"\n    Validates that a string contains only '(' and ')' characters.\n    Raises ValueError if the input is not a string or contains invalid characters.\n    \"\"\"\n    if not isinstance(s, str):\n        raise ValueError(\"Input must be a string.\")\n    for char in s:\n        if char not in ('(', ')'):\n            raise ValueError(f\"Invalid character '{char}' found in string. Only '(' and ')' are allowed.\")\n\ndef match_parens(lst: list[str]) -> str:\n    \"\"\"\n    You are given a list of two strings, both strings consist of open\n    parentheses '(' or close parentheses ')' only.\n    Your job is to check if it is possible to concatenate the two strings in\n    some order, that the resulting string will be good.\n    A string S is considered to be good if and only if all parentheses in S\n    are balanced. For example: the string '(())()' is good, while the string\n    '())' is not.\n    Return 'Yes' if there's a way to make a good string, and return 'No' otherwise.\n\n    Examples:\n    match_parens(['()(', ')']) == 'Yes'\n    match_parens([')', ')']) == 'No'\n    \"\"\"\n    if not isinstance(lst, list) or len(lst) != 2:\n        raise ValueError(\"Input must be a list containing exactly two strings.\")\n\n    s1, s2 = lst[0], lst[1]\n\n    validate_parentheses_string(s1)\n    validate_parentheses_string(s2)\n\n    # Try s1 + s2\n    if is_balanced(s1 + s2):\n        return 'Yes'\n\n    # Try s2 + s1\n    if is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'\n\n```"}
{"task_id": "HumanEval/118", "solution": "```python\ndef get_closest_vowel(word):\n    \"\"\"Finds the closest vowel surrounded by consonants from the right side of the word.\n    Vowels at the beginning or end of the word do not count.\n    \"\"\"\n\n    # Helper functions for character classification, derived from VowelUtils.\n    _VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def is_vowel(char: str) -> bool:\n        return char.lower() in _VOWELS\n\n    def is_consonant(char: str) -> bool:\n        # A consonant is any English letter that is not a vowel.\n        return char.isalpha() and not is_vowel(char)\n\n    n = len(word)\n    # A vowel between two consonants requires at least 3 characters (CVC).\n    # Vowels at the beginning (index 0) or end (index n-1) are ignored.\n    if n < 3:\n        return \"\"\n\n    # Iterate from right to left, considering only internal characters (index 1 to n-2).\n    # This aligns with FR4, BR4, and FR6.\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        prev_char = word[i-1]\n        next_char = word[i+1]\n\n        # Check for the CVC pattern: Consonant, Vowel, Consonant.\n        # This aligns with FR5.\n        if (is_vowel(current_char) and\n            is_consonant(prev_char) and\n            is_consonant(next_char)):\n            # FR7: Return the first such vowel found from the right.\n            return current_char\n    \n    # FR8: If the loop completes without finding a match, return an empty string.\n    return \"\"\n```"}
{"task_id": "HumanEval/118", "solution": "```python\ndef get_closest_vowel(word):\n    \"\"\"Finds the closest vowel from the right surrounded by two consonants, excluding word boundaries.\n    Returns the vowel (preserving case) or an empty string if not found.\"\"\"\n    \n    vowels_set = {'a', 'e', 'i', 'o', 'u'}\n    n = len(word)\n\n    # Words shorter than 3 characters cannot form a CVC pattern (Business Rule).\n    if n < 3:\n        return \"\"\n\n    # Iterate from right to left, skipping first and last characters (FR3, FR5).\n    # The loop range (n - 2, 0, -1) starts from the third to last char and goes to the second char.\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n\n        # Check if current_char is a vowel (case-insensitive, FR2, FR8).\n        if current_char.lower() in vowels_set:\n            left_char = word[i - 1]\n            right_char = word[i + 1]\n\n            # Check if neighbors are consonants (case-insensitive, FR2, FR8).\n            is_left_consonant = left_char.isalpha() and left_char.lower() not in vowels_set\n            is_right_consonant = right_char.isalpha() and right_char.lower() not in vowels_set\n\n            # If both neighbors are consonants, this is the vowel we're looking for (FR4).\n            if is_left_consonant and is_right_consonant:\n                return current_char # Return the vowel, preserving its original case (FR6).\n    \n    return \"\" # If loop completes without finding a vowel, return empty string (FR7).\n```"}
{"task_id": "HumanEval/119", "solution": "```python\ndef match_parens(lst):\n    \"\"\"\n    Checks if two strings of parentheses can be concatenated in any order\n    to form a balanced parentheses string.\n    \"\"\"\n\n    class InvalidInputError(ValueError):\n        \"\"\"Custom exception for invalid input to the parentheses matching function.\"\"\"\n        pass\n\n    class ParenthesesBalancer:\n        \"\"\"Checks if a string of parentheses is balanced.\"\"\"\n        def is_balanced(self, s: str) -> bool:\n            balance = 0\n            for char in s:\n                if char == '(':\n                    balance += 1\n                else:  # char == ')'\n                    balance -= 1\n                if balance < 0:\n                    return False  # An unmatched closing parenthesis occurred.\n            return balance == 0  # Final balance must be zero for a good string.\n\n    class ParenthesesValidator:\n        \"\"\"Validates the format and content of input strings.\"\"\"\n        VALID_PAREN_CHARS = {'(', ')'}\n\n        def validate_input(self, input_list: list[str]) -> None:\n            if not isinstance(input_list, list):\n                raise InvalidInputError(\"Input must be a list.\")\n            if len(input_list) != 2:\n                raise InvalidInputError(\"Input list must contain exactly two strings.\")\n            for item in input_list:\n                if not isinstance(item, str):\n                    raise InvalidInputError(\"All elements in the input list must be strings.\")\n                self.validate_string_chars(item)\n\n        def validate_string_chars(self, s: str) -> None:\n            for char in s:\n                if char not in self.VALID_PAREN_CHARS:\n                    raise InvalidInputError(f\"String contains invalid characters: '{char}'. Only '(' and ')' are allowed.\")\n\n    class ParenthesesMatcher:\n        \"\"\"Orchestrates validation and balance checks for parentheses strings.\"\"\"\n        def __init__(self, validator: ParenthesesValidator, balancer: ParenthesesBalancer) -> None:\n            self.validator = validator\n            self.balancer = balancer\n\n        def check_concatenations(self, input_list: list[str]) -> str:\n            \"\"\"Determines if a balanced string can be formed from two input strings.\"\"\"\n            try:\n                self.validator.validate_input(input_list)\n            except InvalidInputError as e:\n                raise e # Re-raise validation errors for the caller.\n\n            s1, s2 = input_list[0], input_list[1]\n\n            # Check string1 + string2 concatenation.\n            if self.balancer.is_balanced(s1 + s2):\n                return 'Yes'\n\n            # Check string2 + string1 concatenation.\n            if self.balancer.is_balanced(s2 + s1):\n                return 'Yes'\n\n            return 'No'\n\n    # Instantiate the necessary components and run the logic.\n    validator = ParenthesesValidator()\n    balancer = ParenthesesBalancer()\n    matcher = ParenthesesMatcher(validator, balancer)\n    return matcher.check_concatenations(lst)\n```\n"}
