{"task_id": "HumanEval/96", "solution": "```python\ndef _is_prime(num):\n    \"\"\"Determines if a given number is prime. It uses an optimized trial division algorithm.\"\"\"\n    if num <= 1:\n        return False\n    if num <= 3:  # 2 and 3 are prime\n        return True\n    if num % 2 == 0 or num % 3 == 0:\n        return False\n    i = 5\n    while i * i <= num:\n        if num % i == 0 or num % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef count_up_to(n):\n    \"\"\"Implement a function that takes an non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    for example:\n    count_up_to(5) => [2,3]\n    count_up_to(11) => [2,3,5,7]\n    count_up_to(0) => []\n    count_up_to(20) => [2,3,5,7,11,13,17,19]\n    count_up_to(1) => []\n    count_up_to(18) => [2,3,5,7,11,13,17]\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n <= 1:\n        return []\n\n    primes = []\n    for num in range(2, n):\n        if _is_prime(num):\n            primes.append(num)\n    return primes\n```"}
{"task_id": "HumanEval/98", "solution": "```python\ndef count_upper(s):\n    \"\"\"\n    Given a string s, count the number of uppercase vowels in even indices.\n    For example: count_upper('aBCdEf') returns 1, count_upper('abcdefg') returns 0, count_upper('dBBE') returns 0\n    \"\"\"\n    if not isinstance(s, str):\\\n        raise TypeError(\"Input must be a string.\")\n\n    # A set for efficient lookup of uppercase vowels.\n    UPPERCASE_VOWELS = {'A', 'E', 'I', 'O', 'U'}\n    count = 0\n    for i in range(0, len(s), 2):\n        if s[i] in UPPERCASE_VOWELS:\n            count += 1\n    return count\n```"}
{"task_id": "HumanEval/99", "solution": "```python\nimport math\n\ndef closest_integer(value: str) -> int:\n    \"\"\"\n    Converts a string to a float and returns the closest integer.\n    Equidistant values (X.5) are rounded away from zero.\n    \"\"\"\n    num_float = float(value)\n    \n    floor_num = math.floor(num_float)\n    ceil_num = math.ceil(num_float)\n    \n    if abs(num_float - floor_num) == abs(num_float - ceil_num):\n        if num_float >= 0:\n            return int(ceil_num)\n        else:\n            return int(floor_num)\n    else:\n        if abs(num_float - floor_num) < abs(num_float - ceil_num):\n            return int(floor_num)\n        else:\n            return int(ceil_num)\n```"}
{"task_id": "HumanEval/99", "solution": "```python\ndef closest_integer(value: str) -> int:\n    \"\"\"\n    Create a function that takes a value (string) representing a number\n    and returns the closest integer to it. If the number is equidistant\n    from two integers, round it away from zero.\n    \"\"\"\n    try:\n        num_float = float(value)\n    except ValueError:\n        raise ValueError(f\"Invalid input: '{value}' is not a valid number string.\")\n\n    if num_float >= 0:\n        # For positive numbers, add 0.5 and convert to integer.\n        # This rounds positive X.5 values up (away from zero) and other decimals to the nearest.\n        return int(num_float + 0.5)\n    else:\n        # For negative numbers, subtract 0.5 and convert to integer.\n        # This rounds negative X.5 values down (away from zero) and other decimals to the nearest.\n        return int(num_float - 0.5)\n```"}
{"task_id": "HumanEval/100", "solution": "```python\ndef make_a_pile(n: int) -> list[int]:\n    \"\"\"Calculates a sequence of stone counts for a pile with `n` levels.\n    The first level has `n` stones, and subsequent levels increase by 2.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    pile = []\n    current_stones = n\n    for _ in range(n):\n        pile.append(current_stones)\n        current_stones += 2\n    return pile\n```"}
{"task_id": "HumanEval/100", "solution": "def make_a_pile(n):\n    \"\"\"\n    Given a positive integer n, you have to make a pile of n levels of stones.\n    The first level has n stones.\n    The number of stones in the next level is:\n        - the next odd number if n is odd.\n        - the next even number if n is even.\n    Return the number of stones in each level in a list, where element at index\n    i represents the number of stones in the level (i+1).\n\n    Examples:\n    >>> make_a_pile(3)\n    [3, 5, 7]\n    \"\"\"\n    pile_levels = [n]\n    current_stones = n\n\n    for _ in range(n - 1):\n        current_stones += 2\n        pile_levels.append(current_stones)\n\n    return pile_levels"}
