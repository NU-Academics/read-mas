{"task_id": "HumanEval/131", "solution": "```python\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values.\n    It inherits from ValueError to signify input-related issues.\n    \"\"\"\n    pass\n\ndef _validate_positive_integer(n: int) -> None:\n    \"\"\"Validates if the input `n` is a positive integer.\n    Raises InvalidInputError if `n` is not an integer or is not positive.\n    \"\"\"\n    if not isinstance(n, int):\n        raise InvalidInputError(\"Input must be an integer.\")\n    if n <= 0:\n        raise InvalidInputError(\"Input must be a positive integer.\")\n\ndef digits(n: int) -> int:\n    \"\"\"Given a positive integer n, return the product of its odd digits.\n    Returns 0 if no odd digits are found, raising InvalidInputError for invalid inputs.\n    \"\"\"\n    _validate_positive_integer(n)\n\n    product = 1\n    found_odd_digit = False\n\n    temp_n = n\n    while temp_n > 0:\n        digit = temp_n % 10\n        if digit % 2 != 0:  # Check if the current digit is odd.\n            product *= digit\n            found_odd_digit = True\n        temp_n //= 10\n\n    if not found_odd_digit:\n        return 0\n    return product\n```"}
{"task_id": "HumanEval/130", "solution": "```python\ndef tri(n: int) -> list[int]:\n    \"\"\"\n    Calculates the first n + 1 numbers of the Tribonacci sequence.\n    Memoization is used for efficient recursive calculations.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input n must be non-negative.\")\n\n    memo: dict[int, int] = {0: 1, 1: 3}\n\n    def _get_tribonacci_value(k: int) -> int:\n        \"\"\"Calculates the k-th Tribonacci number, utilizing memoization.\"\"\"\n        if k in memo:\n            return memo[k]\n\n        if k % 2 == 0:  # Applies the even number rule\n            result = 1 + k // 2\n        else:  # Applies the odd number rule\n            val_k_minus_1 = _get_tribonacci_value(k - 1)\n            val_k_minus_2 = _get_tribonacci_value(k - 2)\n            val_k_plus_1 = _get_tribonacci_value(k + 1)\n            result = val_k_minus_1 + val_k_minus_2 + val_k_plus_1\n\n        memo[k] = result\n        return result\n\n    # Determine the maximum index that needs to be computed to ensure all\n    # values up to n are available, considering the forward dependency.\n    max_idx_to_compute = n\n    if n % 2 != 0:  # If n is odd, tri(n) depends on tri(n+1)\n        max_idx_to_compute = n + 1\n    \n    # Ensure all values up to max_idx_to_compute are in the memoization table.\n    # This call will recursively populate the memo.\n    _get_tribonacci_value(max_idx_to_compute)\n    \n    # Collect the sequence from the memoization table.\n    sequence = [memo[i] for i in range(n + 1)]\n    return sequence\n```"}
{"task_id": "HumanEval/129", "solution": "import collections\nfrom typing import List, Tuple\n\nclass Cell:\n    \"\"\"Represents a single cell in the grid with its coordinates and value.\"\"\"\n    def __init__(self, row: int, col: int, value: int):\n        self.row = row\n        self.col = col\n        self.value = value\n\n    def __repr__(self):\n        return f\"Cell({self.row},{self.col},{self.value})\"\n\nclass Path:\n    \"\"\"Represents a sequence of visited cells and their corresponding values.\"\"\"\n    def __init__(self, initial_cells: List[Cell]):\n        self.cells = list(initial_cells)\n        self.values = [cell.value for cell in initial_cells]\n        self.length = len(self.cells)\n\n    def add_cell(self, cell: Cell) -> None:\n        \"\"\"Appends a Cell to the path and updates its properties.\"\"\"\n        self.cells.append(cell)\n        self.values.append(cell.value)\n        self.length += 1\n\n    def get_values(self) -> List[int]:\n        \"\"\"Returns the ordered list of values in the path.\"\"\"\n        return self.values\n\n    def get_last_cell(self) -> Cell:\n        \"\"\"Returns the last Cell added to the path.\"\"\"\n        return self.cells[-1]\n\n    def copy(self) -> 'Path':\n        \"\"\"Returns a deep copy of the path for branching exploration.\"\"\"\n        return Path(list(self.cells))\n\nclass Grid:\n    \"\"\"Represents the N x N grid, providing access to individual cells.\"\"\"\n    def __init__(self, grid_values: List[List[int]]):\n        self.N = len(grid_values)\n        if self.N == 0 or any(len(row) != self.N for row in grid_values):\n            raise ValueError(\"Grid must be an N x N matrix.\")\n        self.cells: List[List[Cell]] = []\n        for r in range(self.N):\n            row_cells = []\n            for c in range(self.N):\n                row_cells.append(Cell(r, c, grid_values[r][c]))\n            self.cells.append(row_cells)\n\n    def get_cell(self, r: int, c: int) -> Cell:\n        \"\"\"Returns the Cell object at the specified row and column.\"\"\"\n        # Boundary check is typically done by PathUtils before calling this.\n        return self.cells[r][c]\n\n    def get_N(self) -> int:\n        \"\"\"Returns the dimension N of the grid.\"\"\"\n        return self.N\n\nclass PathUtils:\n    \"\"\"Provides static helper methods for grid operations and path comparisons.\"\"\"\n    @staticmethod\n    def is_valid_coord(N: int, r: int, c: int) -> bool:\n        \"\"\"Checks if given coordinates are within the grid boundaries.\"\"\"\n        return 0 <= r < N and 0 <= c < N\n\n    @staticmethod\n    def get_neighbors(N: int, r: int, c: int) -> List[Tuple[int, int]]:\n        \"\"\"Returns a list of valid adjacent coordinates (up, down, left, right).\"\"\"\n        neighbors = []\n        moves = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n        for dr, dc in moves:\n            nr, nc = r + dr, c + dc\n            if PathUtils.is_valid_coord(N, nr, nc):\n                neighbors.append((nr, nc))\n        return neighbors\n\n    @staticmethod\n    def compare_paths_lexicographically(path_a: List[int], path_b: List[int]) -> int:\n        \"\"\"Compares two paths lexicographically, returning -1 if a<b, 1 if a>b, 0 if a==b.\"\"\"\n        for val_a, val_b in zip(path_a, path_b):\n            if val_a < val_b:\n                return -1\n            if val_a > val_b:\n                return 1\n        return 0\n\nclass PathFinderService:\n    \"\"\"Implements the core logic for finding the lexicographically smallest path of length k.\"\"\"\n    def find_min_path(self, grid_values: List[List[int]], k: int) -> List[int]:\n        \"\"\"Main entry point to find the minimum path, iterating all start cells.\"\"\"\n        grid = Grid(grid_values)\n        N = grid.get_N()\n        \n        # Initialize min_path_values with a path guaranteed to be lexicographically larger.\n        max_grid_value = N * N\n        min_path_values = [max_grid_value + 1] * k \n\n        for r_start in range(N):\n            for c_start in range(N):\n                starting_cell = grid.get_cell(r_start, c_start)\n                initial_path = Path([starting_cell])\n                \n                self._explore_paths(initial_path, k, grid, min_path_values)\n        \n        return min_path_values\n\n    def _explore_paths(self, current_path: Path, k: int, grid: Grid, min_path_values: List[int]) -> None:\n        \"\"\"Recursive helper for Depth-First Search to explore paths.\"\"\"\n        if current_path.length == k:\n            current_path_values = current_path.get_values()\n            if PathUtils.compare_paths_lexicographically(current_path_values, min_path_values) == -1:\n                min_path_values[:] = current_path_values # Update min_path_values in place.\n            return\n\n        last_cell = current_path.get_last_cell()\n        neighbors = PathUtils.get_neighbors(grid.get_N(), last_cell.row, last_cell.col)\n\n        for nr, nc in neighbors:\n            neighbor_cell = grid.get_cell(nr, nc)\n            new_path = current_path.copy() # Create a copy to explore this branch.\n            new_path.add_cell(neighbor_cell)\n            self._explore_paths(new_path, k, grid, min_path_values)\n\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n    service = PathFinderService()\n    return service.find_min_path(grid, k)"}
{"task_id": "HumanEval/132", "solution": "```python\ndef is_nested(string):\n    \"\"\"\n    Checks if the input string contains a valid nested subsequence like `[[]]`.\n    It identifies this by finding '[', then '[', then ']', then ']' in order.\n    \"\"\"\n    state = 0  # 0: first '[', 1: second '[', 2: first ']', 3: second ']'\n\n    for char in string:\n        if state == 0 and char == '[':\n            state = 1\n        elif state == 1 and char == '[':\n            state = 2\n        elif state == 2 and char == ']':\n            state = 3\n        elif state == 3 and char == ']':\n            return True\n    return False\n```"}
{"task_id": "HumanEval/129", "solution": "```python\nimport heapq\n\ndef minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically smallest path of length k in the grid.\n    Uses a priority queue to explore paths, prioritizing smaller value sequences.\n    \"\"\"\n\n    class PathState:\n        \"\"\"Represents a path's current state: position, length, and values.\"\"\"\n        def __init__(self, row: int, col: int, length: int, values: list[int]):\n            self.row = row\n            self.col = col\n            self.length = length\n            self.values = values\n\n        def __lt__(self, other: 'PathState') -> bool:\n            \"\"\"Compares path states lexicographically based on their values.\"\"\"\n            return self.values < other.values\n\n    class GridValidator:\n        \"\"\"Utility for checking if coordinates are within grid boundaries.\"\"\"\n        @staticmethod\n        def is_valid_move(row: int, col: int, N: int) -> bool:\n            return 0 <= row < N and 0 <= col < N\n\n    N = len(grid)\n    priority_queue = [] # Stores PathState objects.\n\n    # Directions for movement: Right, Left, Down, Up.\n    DIRECTIONS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n\n    # Initialize the priority queue with all possible starting cells.\n    for r in range(N):\n        for c in range(N):\n            initial_state = PathState(r, c, 1, [grid[r][c]])\n            heapq.heappush(priority_queue, initial_state)\n\n    while priority_queue:\n        current_state = heapq.heappop(priority_queue)\n\n        # If the path has reached the desired length k, it is the smallest.\n        if current_state.length == k:\n            return current_state.values\n\n        # Explore adjacent cells.\n        for dr, dc in DIRECTIONS:\n            next_row, next_col = current_state.row + dr, current_state.col + dc\n            if GridValidator.is_valid_move(next_row, next_col, N):\n                next_values = current_state.values + [grid[next_row][next_col]]\n                next_state = PathState(next_row, next_col, current_state.length + 1, next_values)\n                heapq.heappush(priority_queue, next_state)\n\n    # This part should not be reached as an answer is guaranteed by the problem.\n    return []\n\n```"}
{"task_id": "HumanEval/133", "solution": "```python\nimport math\n\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    It returns the sum of squared numbers, rounding each element up first.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n\n    total_sum = 0\n    for num in lst:\n        if not isinstance(num, (int, float)):\n            raise TypeError(f\"List elements must be numbers, got {type(num).__name__}.\")\n        rounded_up = math.ceil(num)\n        total_sum += rounded_up * rounded_up\n    return total_sum\n```"}
{"task_id": "HumanEval/134", "solution": "```python\ndef check_if_last_char_is_a_letter(txt: str) -> bool:\n    \"\"\"\n    Returns True if the last character of a given string is an alphabetical character\n    and is not a part of a word, and False otherwise.\n    Note: \"word\" is a group of characters separated by space.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    # Check if the character is not part of a word.\n    # This occurs if it is the only character or is preceded by a space.\n    if len(txt) == 1:\n        return True\n    else:\n        char_before_last = txt[-2]\n        return char_before_last == ' '\n```"}
