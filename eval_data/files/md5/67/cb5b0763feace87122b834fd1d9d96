{"task_id": "HumanEval/104", "solution": "```python\ndef _has_even_digit(n: int) -> bool:\n    \"\"\"Checks if a positive integer contains any even digit.\n    This helper function processes each digit using modulo arithmetic.\"\"\"\n    if n == 0: \n        return True\n    \n    temp_n = n\n    while temp_n > 0:\n        digit = temp_n % 10\n        if digit % 2 == 0:\n            return True\n        temp_n //= 10\n    return False\n\ndef unique_digits(x):\n    \"\"\"Given a list of positive integers x, return a sorted list of all \n    elements that hasn't any even digit.\n    The returned list is sorted in increasing order.\"\"\"\n    result = []\n    for number in x:\n        if not _has_even_digit(number):\n            result.append(number)\n    return sorted(result)\n```"}
{"task_id": "HumanEval/104", "solution": "```python\nfrom typing import List, Set\n\ndef unique_digits(x: List[int]) -> List[int]:\n    \"\"\"Given a list of positive integers x, return a sorted list of all \n    elements that have no even digits.\n\n    The returned list is sorted in increasing order.\n    \"\"\"\n\n    EVEN_DIGITS: Set[int] = {0, 2, 4, 6, 8}\n\n    def _has_even_digit(n: int) -> bool:\n        \"\"\"Checks if a positive integer contains any even digit.\n        Returns True if an even digit is found, False otherwise.\n        \"\"\"\n        # Convert the integer to its string representation to iterate over digits.\n        s_n = str(n)\n        for digit_char in s_n:\n            if int(digit_char) in EVEN_DIGITS:\n                return True\n        return False\n\n    filtered_list: List[int] = []\n    for num in x:\n        if not _has_even_digit(num):\n            filtered_list.append(num)\n    \n    filtered_list.sort()\n    return filtered_list\n```"}
{"task_id": "HumanEval/106", "solution": "```python\ndef f(n: int) -> list[int]:\n    \"\"\"\n    Implement the function f that takes n as a parameter,\n    and returns a list of size n based on specific rules for each element.\n    \"\"\"\n\n    def _factorial(k: int) -> int:\n        \"\"\"Calculates the factorial of a non-negative integer k.\n        Raises ValueError if k is negative or not an integer.\"\"\"\n        if not isinstance(k, int) or k < 0:\n            raise ValueError(\"Input for factorial must be a non-negative integer.\")\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    def _sum_up_to(k: int) -> int:\n        \"\"\"Calculates the sum of integers from 1 to k.\n        Raises ValueError if k is negative or not an integer.\"\"\"\n        if not isinstance(k, int) or k < 0:\n            raise ValueError(\"Input for sum_up_to must be a non-negative integer.\")\n        return k * (k + 1) // 2\n\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    result_list = []\n    for i in range(1, n + 1):  # i starts from 1\n        if i % 2 == 0:  # Even index: calculate factorial of i\n            result_list.append(_factorial(i))\n        else:  # Odd index: calculate sum of numbers from 1 to i\n            result_list.append(_sum_up_to(i))\n    return result_list\n```"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr: List[int]) -> List[str]:\n    \"\"\"\n    Transforms an array of integers by filtering, sorting, reversing, and converting valid digits to words.\n    It processes numbers between 1 and 9, ignoring others, and returns an empty list for no valid inputs.\n    \"\"\"\n    DIGIT_WORDS: Dict[int, str] = {\n        1: \"One\",\n        2: \"Two\",\n        3: \"Three\",\n        4: \"Four\",\n        5: \"Five\",\n        6: \"Six\",\n        7: \"Seven\",\n        8: \"Eight\",\n        9: \"Nine\",\n    }\n\n    class NumberConverter:\n        \"\"\"\n        Encapsulates the logic for filtering, sorting, reversing, and converting\n        integers to their word representations according to specified rules.\n        \"\"\"\n        def __init__(self):\n            \"\"\"Initializes the converter with the digit-to-word mapping.\"\"\"\n            self._digit_words = DIGIT_WORDS\n\n        def process(self, arr: List[int]) -> List[str]:\n            \"\"\"\n            Orchestrates the filtering, sorting, reversing, and word conversion of the input array.\n            Returns the final list of word strings.\n            \"\"\"\n            filtered_sorted = self._filter_and_sort(arr)\n            reversed_arr = self._reverse_array(filtered_sorted)\n            word_array = self._convert_to_words(reversed_arr)\n            return word_array\n\n        def _filter_and_sort(self, arr: List[int]) -> List[int]:\n            \"\"\"\n            Filters the input to include only integers between 1 and 9, then sorts them ascending.\n            Non-integer elements are gracefully ignored.\n            \"\"\"\n            # Ensure 'n' is an integer before checking its range, as per FR1 and error handling.\n            valid_numbers = [n for n in arr if isinstance(n, int) and 1 <= n <= 9]\n            valid_numbers.sort()\n            return valid_numbers\n\n        def _reverse_array(self, arr: List[int]) -> List[int]:\n            \"\"\"\n            Reverses the order of elements in the provided list.\n            This creates a new list with elements in reverse order.\n            \"\"\"\n            return arr[::-1]\n\n        def _convert_to_words(self, arr: List[int]) -> List[str]:\n            \"\"\"\n            Converts each integer in the array to its corresponding English word name.\n            It uses a predefined mapping for digits 1-9.\n            \"\"\"\n            return [self._digit_words[n] for n in arr]\n\n    converter = NumberConverter()\n    return converter.process(arr)"}
{"task_id": "HumanEval/106", "solution": "```python\ndef _factorial(k: int) -> int:\n    \"\"\"Calculates the factorial of a non-negative integer k.\n    Raises ValueError if k is negative or not an integer.\"\"\"\n    if not isinstance(k, int) or k < 0:\n        raise ValueError(\"Factorial input must be a non-negative integer.\")\n    if k == 0:\n        return 1\n    res = 1\n    for i in range(1, k + 1):\n        res *= i\n    return res\n\ndef _sum_up_to(k: int) -> int:\n    \"\"\"Calculates the sum of positive integers from 1 up to k.\n    Raises ValueError if k is negative or not an integer.\"\"\"\n    if not isinstance(k, int) or k < 0:\n        raise ValueError(\"Sum input must be a non-negative integer.\")\n    return k * (k + 1) // 2\n\ndef f(n):\n    \"\"\" Implement the function f that takes n as a parameter,\n    and returns a list of size n, such that the value of the element at index i is the factorial of i if i is even\n    or the sum of numbers from 1 to i otherwise.\n    i starts from 1.\n    the factorial of i is the multiplication of the numbers from 1 to i (1 * 2 * ... * i).\n    Example:\n    f(5) == [1, 2, 6, 24, 15]\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    result_list = []\n    for i in range(1, n + 1):  # i starts from 1\n        if i % 2 == 0:  # Even 1-based index\n            result_list.append(_factorial(i))\n        else:  # Odd 1-based index\n            result_list.append(_sum_up_to(i))\n    return result_list\n```"}
