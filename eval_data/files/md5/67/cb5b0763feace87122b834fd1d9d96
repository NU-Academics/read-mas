{"task_id": "HumanEval/105", "solution": "```python\nclass NumberConverter:\n    NUMBER_WORDS = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    def to_word(self, number: int) -> str:\n        \"\"\"\n        Converts a single digit integer (1-9) to its English word representation.\n        Returns an empty string if the number is out of the valid range.\n        \"\"\"\n        return self.NUMBER_WORDS.get(number, \"\")\n\n\nclass ArrayProcessor:\n    def __init__(self, number_converter: NumberConverter):\n        self._number_converter = number_converter\n\n    def process_array(self, arr: list[int]) -> list[str]:\n        \"\"\"\n        Filters, sorts, reverses, and converts an array of integers to words.\n        Returns an empty list if no valid numbers are found after filtering.\n        \"\"\"\n        filtered_arr = self._filter_and_validate(arr)\n        if not filtered_arr:\n            return []\n        \n        sorted_reversed_arr = self._sort_and_reverse(filtered_arr)\n        word_arr = self._convert_to_words(sorted_reversed_arr)\n        return word_arr\n\n    def _filter_and_validate(self, arr: list[int]) -> list[int]:\n        \"\"\"\n        Filters the input array, keeping only integers between 1 and 9 inclusive.\n        Non-integer elements or numbers outside the range are ignored.\n        \"\"\"\n        return [n for n in arr if isinstance(n, int) and 1 <= n <= 9]\n\n    def _sort_and_reverse(self, arr: list[int]) -> list[int]:\n        \"\"\"\n        Sorts the array in ascending order and then reverses it.\n        This results in a descending order of numbers.\n        \"\"\"\n        arr.sort()\n        arr.reverse()\n        return arr\n\n    def _convert_to_words(self, arr: list[int]) -> list[str]:\n        \"\"\"\n        Converts each integer in the array to its English word.\n        Assumes numbers are within the 1-9 range as per filtering.\n        \"\"\"\n        return [self._number_converter.to_word(n) for n in arr]\n\n\ndef by_length(arr: list[int]) -> list[str]:\n    \"\"\"\n    Given an array of integers, sort the integers that are between 1 and 9 inclusive,\n    reverse the resulting array, and then replace each digit by its corresponding name.\n\n    For example:\n      arr = [2, 1, 1, 4, 5, 8, 2, 3]\n            -> sort arr -> [1, 1, 2, 2, 3, 4, 5, 8]\n            -> reverse arr -> [8, 5, 4, 3, 2, 2, 1, 1]\n      return [\"Eight\", \"Five\", \"Four\", \"Three\", \"Two\", \"Two\", \"One\", \"One\"]\n\n      If the array is empty, return an empty array:\n      arr = []\n      return []\n\n      If the array has any strange number ignore it:\n      arr = [1, -1 , 55]\n            -> sort arr -> [-1, 1, 55]\n            -> reverse arr -> [55, 1, -1]\n      return = ['One']\n    \"\"\"\n    number_converter = NumberConverter()\n    processor = ArrayProcessor(number_converter)\n    return processor.process_array(arr)\n```"}
