{"task_id": "HumanEval/77", "solution": "```python\nimport math\n\ndef iscube(a):\n    \"\"\"\n    Determines if the input integer 'a' is a perfect cube.\n    Handles positive, negative, and zero inputs correctly using floating-point root calculation.\n    \"\"\"\n    if a == 0:\n        return True\n    \n    # Calculate the approximate cube root of the absolute value, then round and restore sign.\n    # This addresses floating-point precision by rounding to the nearest integer.\n    cbrt = round(math.copysign(abs(a)**(1/3), a))\n    \n    # Check if cubing the rounded root yields the original number.\n    return cbrt * cbrt * cbrt == a\n```"}
{"task_id": "HumanEval/76", "solution": "```python\ndef is_simple_power(x: int, n: int) -> bool:\n    \"\"\"Checks if a number x is a simple power of n.\n    x is a simple power of n if n**k = x for some non-negative integer k.\n    \"\"\"\n    if x == 1:\n        return True\n    if n == 1:\n        return False\n    \n    current_x = x\n    while current_x > 1:\n        if current_x % n != 0:\n            return False\n        current_x //= n\n    return current_x == 1\n```"}
{"task_id": "HumanEval/77", "solution": "```python\ndef iscube(a: int) -> bool:\n    \"\"\"\n    Determines if an integer 'a' is a perfect cube.\n    It calculates the cube root and checks if cubing the rounded result returns the original number.\n    \"\"\"\n    if a == 0:\n        return True\n\n    # Calculate the cube root. Python's ** operator handles negative bases correctly for odd fractional exponents.\n    # Rounding to the nearest integer helps mitigate floating-point inaccuracies.\n    root = round(a**(1/3))\n    \n    # Check if cubing the rounded root yields the original number.\n    return root * root * root == a\n```"}
{"task_id": "HumanEval/76", "solution": "```python\ndef is_simple_power(x: int, n: int) -> bool:\n    \"\"\"\n    Checks if a number x is a simple power of n.\n    x is a simple power of n if n**k = x for some integer k.\n    \"\"\"\n    if not isinstance(x, int) or not isinstance(n, int):\n        raise ValueError(\"Both x and n must be integers.\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n\n    if n == 1:\n        return x == 1\n    \n    if x == 1:\n        return True\n\n    if x < n:\n        return False\n\n    while x % n == 0:\n        x //= n\n    \n    return x == 1\n```"}
{"task_id": "HumanEval/75", "solution": "```python\ndef is_multiply_prime(a: int) -> bool:\n    \"\"\"\n    Checks if the given number is the product of exactly three prime numbers.\n    Input 'a' must be an integer within the range (0, 100).\n    \"\"\"\n    if not isinstance(a, int):\n        raise TypeError(\"Input 'a' must be an integer.\")\n    if not (0 < a < 100):\n        raise ValueError(\"Input 'a' must be less than 100 and greater than 0.\")\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if an integer is a prime number.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    def generate_primes_up_to(limit: int) -> list[int]:\n        \"\"\"Generates all prime numbers up to and including the limit.\"\"\"\n        primes_list = []\n        for num in range(2, limit + 1):\n            if is_prime(num):\n                primes_list.append(num)\n        return primes_list\n\n    # Generate primes up to 99, as 'a' is less than 100.\n    # The largest possible prime factor for a product of 3 primes < 100 is 23 (e.g., 2*2*23=92).\n    primes = generate_primes_up_to(99)\n\n    # Iterate through all combinations of three primes (allowing repetition).\n    n_primes = len(primes)\n    for i in range(n_primes):\n        p1 = primes[i]\n        # Optimization: If p1 cubed is already greater than 'a', further products will also be too large.\n        if p1 * p1 * p1 > a:\n            break\n        for j in range(i, n_primes): # p2 can be the same as p1 or larger.\n            p2 = primes[j]\n            # Optimization: If p1 * p2 squared is greater than 'a', further products will also be too large.\n            if p1 * p2 * p2 > a:\n                break\n            for k in range(j, n_primes): # p3 can be the same as p2 or larger.\n                p3 = primes[k]\n                product = p1 * p2 * p3\n                # Optimization: If the current product exceeds 'a', no need to check larger p3.\n                if product > a:\n                    break\n                if product == a:\n                    return True\n    return False\n```"}
{"task_id": "HumanEval/78", "solution": "```python\nPRIME_HEX_DECIMAL_VALUES: set[int] = {2, 3, 5, 7, 11, 13}\n\nclass HexDigitConverter:\n    @staticmethod\n    def hex_to_decimal(hex_char: str) -> int:\n        \"\"\"Converts a single hexadecimal character to its decimal equivalent.\n        This method leverages Python's built-in `int` conversion with base 16.\n        \"\"\"\n        return int(hex_char, 16)\n\nclass HexCounterService:\n    def __init__(self):\n        \"\"\"Initializes the service with predefined prime decimal values.\"\"\"\n        self._prime_decimal_values = PRIME_HEX_DECIMAL_VALUES\n\n    def count_prime_hex_digits(self, hex_string: str) -> int:\n        \"\"\"Counts prime hexadecimal digits in a string by converting each to decimal.\n        It iterates through the string, converts each character, and checks for primality.\n        \"\"\"\n        count = 0\n        for char in hex_string:\n            decimal_value = HexDigitConverter.hex_to_decimal(char)\n            if decimal_value in self._prime_decimal_values:\n                count += 1\n        return count\n\ndef hex_key(num: str) -> int:\n    \"\"\"\n    Counts the number of prime hexadecimal digits in a given hexadecimal string.\n    It assumes valid hexadecimal input and uppercase letters for A-F.\n    \"\"\"\n    service = HexCounterService()\n    return service.count_prime_hex_digits(num)\n```"}
