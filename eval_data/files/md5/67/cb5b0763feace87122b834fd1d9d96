{"task_id": "HumanEval/8", "solution": "```python\nfrom typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\"For a given list of integers, return their aggregate sum and product.\n    An empty list yields a sum of 0 and a product of 1.\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)\n```"}
{"task_id": "HumanEval/6", "solution": "```python\nfrom typing import List\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    \"\"\"\n    if not isinstance(paren_string, str):\n        raise TypeError(\"Input 'paren_string' must be a string.\")\n\n    if not paren_string.strip():\n        return []\n\n    groups = paren_string.split(' ')\n    results: List[int] = []\n\n    for group_string in groups:\n        if group_string: # Process only non-empty group strings.\n            current_depth = 0\n            max_depth = 0\n            for char in group_string:\n                if char == '(':\n                    current_depth += 1\n                    max_depth = max(max_depth, current_depth)\n                elif char == ')':\n                    current_depth -= 1\n            results.append(max_depth)\n            \n    return results\n```"}
{"task_id": "HumanEval/8", "solution": "```python\nfrom typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\"For a given list of integers, return a tuple consisting of a sum and a product.\n    Empty sum should be 0 and empty product should be 1.\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)\n```\n"}
{"task_id": "HumanEval/6", "solution": "```python\nfrom typing import List\n\n\nclass InvalidParenthesesError(Exception):\n    \"\"\"Custom exception for invalid or malformed parentheses strings.\n    It carries a descriptive message about the error.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\n\ndef _calculate_group_nesting(group: str) -> int:\n    \"\"\"Calculates the deepest nesting level for a single parenthesis group.\n    Raises InvalidParenthesesError for malformed groups or invalid characters.\"\"\"\n    current_level = 0\n    max_level = 0\n\n    for char in group:\n        if char == '(':\n            current_level += 1\n            max_level = max(max_level, current_level)\n        elif char == ')':\n            current_level -= 1\n        else:\n            raise InvalidParenthesesError(f\"Invalid character '{char}' found in group '{group}'. Only '(' and ')' are allowed.\")\n\n        if current_level < 0:\n            raise InvalidParenthesesError(f\"Mismatched closing parenthesis in group '{group}'.\")\n\n    if current_level != 0:\n        raise InvalidParenthesesError(f\"Unmatched opening parenthesis in group '{group}'.\")\n\n    return max_level\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    if not isinstance(paren_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    if not paren_string.strip():\n        # Handle empty or whitespace-only input as a single group with 0 nesting\n        return [0]\n\n    groups = paren_string.split(' ')\n    results = []\n    for group in groups:\n        if not group: # Handle multiple spaces resulting in empty strings from split\n            results.append(0)\n            continue\n        results.append(_calculate_group_nesting(group))\n    return results\n```"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\nclass EmptyInputError(ValueError):\n    \"\"\"Custom exception for when an empty list is provided to a calculation.\"\"\"\n    def __init__(self, message: str = \"Input list cannot be empty.\"):\n        super().__init__(message)\n\ndef _calculate_mean(numbers: List[float]) -> float:\n    \"\"\"Calculates the arithmetic mean of a list of numbers.\n    Raises EmptyInputError if the list is empty.\"\"\"\n    if not numbers:\n        raise EmptyInputError(\"Cannot calculate mean of an empty list.\")\n    return sum(numbers) / len(numbers)\n\ndef _calculate_absolute_differences(numbers: List[float], mean: float) -> List[float]:\n    \"\"\"Computes the absolute differences between each number and the provided mean.\"\"\"\n    return [abs(x - mean) for x in numbers]\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        raise EmptyInputError(\"Cannot calculate Mean Absolute Deviation for an empty list.\")\n\n    mean_val = _calculate_mean(numbers)\n    abs_diffs = _calculate_absolute_differences(numbers, mean_val)\n\n    # This ensures FR3's error handling for an empty list of differences is met.\n    if not abs_diffs:\n        raise EmptyInputError(\"Internal error: Absolute differences list is empty after non-empty input.\")\n\n    return sum(abs_diffs) / len(abs_diffs)"}
{"task_id": "HumanEval/9", "solution": "```python\nfrom typing import List\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_max_list: List[int] = []\n    current_max: int = numbers[0]\n\n    for number in numbers:\n        if number > current_max:\n            current_max = number\n        rolling_max_list.append(current_max)\n\n    return rolling_max_list\n```"}
{"task_id": "HumanEval/9", "solution": "```python\nfrom typing import List\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\"Generates a list of rolling maximums from a given sequence of integers.\n    Each element in the output is the maximum value encountered up to that point in the input sequence.\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_max_list = []\n    max_so_far = float('-inf')\n\n    for number in numbers:\n        if number > max_so_far:\n            max_so_far = number\n        rolling_max_list.append(max_so_far)\n\n    return rolling_max_list\n```"}
{"task_id": "HumanEval/13", "solution": "```python\ndef greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\"Return the greatest common divisor of two integers a and b using the Euclidean algorithm. It handles zero and negative inputs correctly.\"\"\"\n    a = abs(a)\n    b = abs(b)\n\n    while b:\n        a, b = b, a % b\n    return a\n```"}
{"task_id": "HumanEval/10", "solution": "```python\ndef is_palindrome(string: str) -> bool:\n    \"\"\"Test if given string is a palindrome.\n    Raises TypeError if input is not a string.\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n    return string == string[::-1]\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\"Find the shortest palindrome that begins with a supplied string.\n    Appends the reverse of the non-palindromic prefix to the original string.\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n    \n    if not string:\n        return \"\"\n\n    n = len(string)\n    for i in range(n):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            prefix_to_reverse = string[:i]\n            return string + prefix_to_reverse[::-1]\n    \n    # This point should theoretically not be reached for non-empty strings,\n    # as a single character (the last character) is always a palindrome suffix.\n    # The loop will always find a suffix and return.\n```\n"}
