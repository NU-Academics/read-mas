{"task_id": "HumanEval/32", "solution": "```python\nimport math\n\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    Calculates xs[0] + xs[1] * x + xs[2] * x^2 + ... + xs[n] * x^n.\n    \"\"\"\n    if not isinstance(xs, list) or not all(isinstance(c, (int, float)) for c in xs):\n        raise ValueError(\"Coefficients 'xs' must be a list of numeric values.\")\n    if not isinstance(x, (int, float)):\n        raise ValueError(\"Point 'x' must be a numeric value.\")\n    if not xs:\n        raise ValueError(\"Coefficient list 'xs' cannot be empty.\")\n\n    result = 0.0\n    for i, coeff in enumerate(xs):\n        result += float(coeff) * math.pow(x, i)\n    return result\n\n\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero finds x such that poly(x) = 0.\n    find_zero returns only one zero point, even if there are many.\n    \"\"\"\n    DEFAULT_TOLERANCE: float = 1e-6\n    MAX_ITERATIONS: int = 100\n    LOWER_BOUND: float = -100.0\n    UPPER_BOUND: float = 100.0\n\n    # Validate input coefficients 'xs'.\n    if not isinstance(xs, list) or not all(isinstance(c, (int, float)) for c in xs):\n        raise ValueError(\"Coefficients 'xs' must be a list of numeric values.\")\n    \n    n = len(xs)\n    if n == 0:\n        raise ValueError(\"Cannot find zero for an empty polynomial.\")\n    \n    # Precondition: 'xs' must have an even number of coefficients.\n    # This implies an odd-degree polynomial, which guarantees at least one real root.\n    if n % 2 != 0:\n        raise ValueError(\"find_zero only takes polynomials with an even number of coefficients.\")\n    \n    # Precondition: Cannot find a unique zero for a zero polynomial.\n    if all(c == 0 for c in xs):\n        raise ValueError(\"Cannot find zero for a zero polynomial (infinite solutions).\")\n\n    a, b = LOWER_BOUND, UPPER_BOUND\n    f_a = poly(xs, a)\n    f_b = poly(xs, b)\n\n    # Ensure there is a sign change within the initial interval for bisection.\n    # If not, attempt to expand the search range.\n    # The problem statement guarantees a solution for the specified input,\n    # so a sign change is expected within a sufficiently large range.\n    search_range_expansion_limit = 10  # Max times to double the range\n    current_expansion = 0\n\n    while f_a * f_b > 0 and current_expansion < search_range_expansion_limit:\n        a *= 2.0\n        b *= 2.0\n        f_a = poly(xs, a)\n        f_b = poly(xs, b)\n        current_expansion += 1\n\n    if f_a * f_b > 0:\n        raise RuntimeError(f\"Could not find a bracketing interval for the root \"\n                           f\"within an expanded range up to [{a}, {b}].\")\n    \n    for _ in range(MAX_ITERATIONS):\n        c = (a + b) / 2\n        f_c = poly(xs, c)\n\n        # If the absolute value of f(c) is within tolerance, we found a zero.\n        if abs(f_c) < DEFAULT_TOLERANCE:\n            return c\n\n        # Update the interval [a, b] based on the sign of f(c).\n        # We re-evaluate f_a if 'a' changes to ensure the product 'f_a * f_c' is current.\n        # Alternatively, f_a and f_b should be updated in a consistent manner to reduce `poly` calls.\n        if f_a * f_c < 0:  # Root is in [a, c]\n            b = c\n            # f_b = f_c  # Optimization: update f_b directly\n        else:  # Root is in [c, b]\n            a = c\n            f_a = f_c  # Optimization: update f_a directly\n            \n    # If convergence is not achieved within max iterations, raise an error.\n    raise RuntimeError(\"Bisection method did not converge within max iterations.\")\n\n```"}
{"task_id": "HumanEval/19", "solution": "```python\nfrom typing import List\n\nWORD_TO_INT_MAP = {\n    \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n    \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9\n}\nINT_TO_WORD_MAP = {\n    0: \"zero\", 1: \"one\", 2: \"two\", 3: \"three\", 4: \"four\",\n    5: \"five\", 6: \"six\", 7: \"seven\", 8: \"eight\", 9: \"nine\"\n}\n\ndef sort_numbers(numbers: str) -> str:\n    \"\"\"Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Return the string with numbers sorted from smallest to largest.\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"Input string cannot be empty.\")\n\n    words = numbers.split(' ')\n\n    # Convert words to integers, raising ValueError for invalid words.\n    int_values = []\n    for word in words:\n        if word not in WORD_TO_INT_MAP:\n            raise ValueError(f\"Invalid number word: {word}\")\n        int_values.append(WORD_TO_INT_MAP[word])\n\n    # Sort the integer values in ascending order.\n    int_values.sort()\n\n    # Convert sorted integers back to their corresponding words.\n    sorted_words = [INT_TO_WORD_MAP[num] for num in int_values]\n\n    return ' '.join(sorted_words)\n```\n"}
