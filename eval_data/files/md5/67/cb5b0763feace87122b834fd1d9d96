{"task_id": "HumanEval/107", "solution": "```python\ndef even_odd_palindrome(n: int) -> tuple[int, int]:\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n\n    if not isinstance(n, int) or not (1 <= n <= 1000):\n        raise ValueError(\"Input 'n' must be an integer between 1 and 1000, inclusive.\")\n\n    def _is_palindrome(num: int) -> bool:\n        \"\"\"Checks if a given integer is a palindrome.\"\"\"\n        s_num = str(num)\n        return s_num == s_num[::-1]\n\n    even_count = 0\n    odd_count = 0\n\n    for i in range(1, n + 1):\n        if _is_palindrome(i):\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n\n    return (even_count, odd_count)\n```"}
{"task_id": "HumanEval/108", "solution": "```python\ndef count_nums(arr: list[int]) -> int:\n    \"\"\"Counts numbers in an array whose digit sum is positive.\n    Negative numbers treat the first digit as negative for the sum calculation.\"\"\"\n\n    def _calculate_digit_sum(num: int) -> int:\n        \"\"\"Calculates the sum of digits for a number, handling negative first digits.\"\"\"\n        if num == 0:\n            return 0\n\n        s_num = str(num)\n        digit_sum = 0\n\n        if s_num[0] == '-':\n            # First digit after '-' is negative.\n            digit_sum -= int(s_num[1])\n            # Subsequent digits are positive.\n            for digit_char in s_num[2:]:\n                digit_sum += int(digit_char)\n        else:\n            # All digits are positive.\n            for digit_char in s_num:\n                digit_sum += int(digit_char)\n        return digit_sum\n\n    count = 0\n    for num in arr:\n        if _calculate_digit_sum(num) > 0:\n            count += 1\n    return count\n```"}
{"task_id": "HumanEval/110", "solution": "```python\ndef exchange(lst1, lst2):\n    \"\"\"Determines if lst1 can be made entirely even by exchanging elements with lst2.\n    Returns \"YES\" if possible, \"NO\" otherwise.\"\"\"\n\n    # Count the number of odd elements in lst1.\n    odd_count_lst1 = sum(1 for num in lst1 if num % 2 != 0)\n\n    # Count the number of even elements in lst2.\n    even_count_lst2 = sum(1 for num in lst2 if num % 2 == 0)\n\n    # If enough even numbers are available in lst2 to replace odd numbers in lst1.\n    if odd_count_lst1 <= even_count_lst2:\n        return \"YES\"\n    else:\n        return \"NO\"\n```"}
{"task_id": "HumanEval/108", "solution": "```python\ndef count_nums(arr: list[int]) -> int:\n    \"\"\"\n    Counts elements in an array where the sum of digits is > 0.\n    For negative numbers, the first digit is negative (e.g., -123 -> -1 + 2 + 3 = 4).\n    \"\"\"\n\n    def _sum_digits(num: int) -> int:\n        \"\"\"\n        Calculates the sum of digits for an integer, handling negative numbers as specified.\n        The first digit of a negative number is treated as negative (e.g., -123 -> -1 + 2 + 3 = 4).\n        \"\"\"\n        if num == 0:\n            return 0\n\n        s = str(abs(num))\n        digit_sum = 0\n        if num < 0:\n            digit_sum -= int(s[0])\n            s = s[1:]\n        \n        for digit_char in s:\n            digit_sum += int(digit_char)\n        \n        return digit_sum\n\n    count = 0\n    # FR6: If arr is empty, the loop won't run, and 0 will be returned.\n    for num in arr:\n        # FR1 Error Handling: Validate that each element is an integer.\n        if not isinstance(num, int):\n            raise TypeError(f\"Expected an integer, but got {type(num)}: {num}\")\n        \n        # FR2, FR3: Calculate the sum of digits for the current number.\n        # FR4: Increment count if the sum of digits is greater than 0.\n        if _sum_digits(num) > 0:\n            count += 1\n    \n    # FR5: Return the final count.\n    return count\n```"}
{"task_id": "HumanEval/110", "solution": "```python\ndef exchange(lst1, lst2):\n    \"\"\"\n    Determines if lst1 can be made entirely of even numbers by exchanging elements with lst2.\n    Returns \"YES\" if possible, \"NO\" otherwise.\n    \"\"\"\n    odd_count_lst1 = 0\n    for num in lst1:\n        if num % 2 != 0:\n            odd_count_lst1 += 1\n\n    even_count_lst2 = 0\n    for num in lst2:\n        if num % 2 == 0:\n            even_count_lst2 += 1\n\n    if even_count_lst2 >= odd_count_lst1:\n        return \"YES\"\n    else:\n        return \"NO\"\n```"}
{"task_id": "HumanEval/109", "solution": "```python\ndef move_one_ball(arr):\n    \"\"\"\n    Determines if it is possible to get an array sorted in non-decreasing order\n    by performing right shift operations. It leverages a helper to check sortability.\n    \"\"\"\n    def _is_sorted(current_arr):\n        \"\"\"Checks if the given array is sorted in non-decreasing order.\"\"\"\n        if not current_arr:\n            return True\n        for i in range(len(current_arr) - 1):\n            if current_arr[i] > current_arr[i+1]:\n                return False\n        return True\n\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    current_arr = list(arr) # Work on a copy to simulate shifts.\n\n    # Check if the array is already sorted.\n    if _is_sorted(current_arr):\n        return True\n\n    # Try all possible right shifts to find a sorted configuration.\n    for _ in range(n):\n        current_arr = [current_arr[-1]] + current_arr[:-1] # Perform one right shift.\n        if _is_sorted(current_arr):\n            return True\n    \n    return False\n```"}
{"task_id": "HumanEval/109", "solution": "```python\ndef move_one_ball(arr):\n    \"\"\"Determines if an array can be sorted in non-decreasing order by right shift operations.\n    Returns True if sortable or empty, False otherwise, raising errors for invalid input.\n    \"\"\"\n    # Validate input type and elements.\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list.\")\n    for item in arr:\n        if not isinstance(item, int):\n            raise ValueError(\"All elements in the list must be integers.\")\n\n    # An empty array is considered sorted.\n    if not arr:\n        return True\n\n    n = len(arr)\n    sorted_arr = sorted(arr)\n    current_arr = list(arr) # Use a mutable copy for shifting.\n\n    # Check if the array is already sorted (zero shifts).\n    if current_arr == sorted_arr:\n        return True\n\n    # Perform up to N-1 right shifts and check if any configuration is sorted.\n    for _ in range(n - 1):\n        # Perform one right shift operation.\n        current_arr = [current_arr[-1]] + current_arr[:-1]\n        if current_arr == sorted_arr:\n            return True\n    \n    # If no sorted configuration is found after all possible shifts.\n    return False\n```"}
{"task_id": "HumanEval/111", "solution": "```python\nfrom collections import Counter\nfrom typing import Dict\n\ndef histogram(test: str) -> Dict[str, int]:\n    \"\"\"\n    Analyzes letter frequency in a space-separated string to find the most frequent letters.\n    Returns a dictionary of letters and their counts, or an empty dictionary if the input is empty.\n    \"\"\"\n    if not test:\n        return {}\n\n    letters = test.split(' ')\n    letter_counts = Counter(letters)\n\n    max_count = max(letter_counts.values())\n\n    result = {letter: count for letter, count in letter_counts.items() if count == max_count}\n    return result\n```"}
{"task_id": "HumanEval/112", "solution": "```python\ndef reverse_delete(s,c):\n    \"\"\"Deletes characters from s found in c, then checks if the resulting string is a palindrome.\n    Returns a tuple of the processed string and a boolean indicating if it's a palindrome.\"\"\"\n    chars_to_delete = set(c)\n    processed_chars = [char for char in s if char not in chars_to_delete]\n    processed_string = \"\".join(processed_chars)\n\n    is_palindrome = processed_string == processed_string[::-1]\n\n    return (processed_string, is_palindrome)\n```"}
