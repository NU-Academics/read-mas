{"task_id": "HumanEval/39", "solution": "```python\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\n\n\nclass FibonacciGenerator:\n    \"\"\"Generates Fibonacci numbers sequentially, starting from 0, 1.\"\"\"\n    def __init__(self):\n        self.a = 0\n        self.b = 1\n\n    def generate_next_fib(self) -> int:\n        \"\"\"Generates and returns the next Fibonacci number in the sequence.\"\"\"\n        current_fib = self.a\n        self.a, self.b = self.b, self.a + self.b\n        return current_fib\n\n    def reset(self) -> None:\n        \"\"\"Resets the generator to its initial state (0, 1).\"\"\"\n        self.a = 0\n        self.b = 1\n\n\nclass PrimeChecker:\n    \"\"\"Determines if a given number is prime using a cached trial division method.\"\"\"\n    def __init__(self):\n        self.prime_cache = {0: False, 1: False, 2: True, 3: True}\n\n    def is_prime(self, num: int) -> bool:\n        \"\"\"Checks if a number is prime and caches the result.\"\"\"\n        if num in self.prime_cache:\n            return self.prime_cache[num]\n        if num < 2:\n            self.prime_cache[num] = False\n            return False\n        for i in range(2, int(num**0.5) + 1):\n            if num % i == 0:\n                self.prime_cache[num] = False\n                return False\n        self.prime_cache[num] = True\n        return True\n\n\nclass PrimeFibService:\n    \"\"\"Orchestrates finding the Nth number that is both a Fibonacci number and a prime.\"\"\"\n    def __init__(self):\n        self.fib_generator = FibonacciGenerator()\n        self.prime_checker = PrimeChecker()\n\n    def find_nth_prime_fib(self, n: int) -> int:\n        \"\"\"Finds and returns the Nth prime Fibonacci number.\"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n\n        self.fib_generator.reset()\n        prime_fib_count = 0\n        \n        # We iterate through Fibonacci numbers, checking for primality.\n        # The sequence starts with F(0)=0, F(1)=1. We skip 0 and 1 as they are not prime.\n        while True:\n            fib_num = self.fib_generator.generate_next_fib()\n            \n            if fib_num <= 1:\n                continue\n\n            if self.prime_checker.is_prime(fib_num):\n                prime_fib_count += 1\n                if prime_fib_count == n:\n                    return fib_num\n\n\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    service = PrimeFibService()\n    return service.find_nth_prime_fib(n)\n```"}
{"task_id": "HumanEval/40", "solution": "```python\ndef triples_sum_to_zero(l: list):\n    \"\"\"\n    Checks if there are three distinct elements in the list that sum to zero.\n    Uses a sorting and two-pointer approach for efficiency.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    l.sort()  # Sort the list to enable the two-pointer approach.\n\n    for i in range(n - 2):\n        # Optimization: skip current element if its value is the same as the previous one,\n        # to avoid redundant calculations for the outer loop.\n        if i > 0 and l[i] == l[i-1]:\n            continue\n\n        left, right = i + 1, n - 1\n        while left < right:\n            current_sum = l[i] + l[left] + l[right]\n\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n            else: # current_sum > 0\n                right -= 1\n    return False\n```"}
{"task_id": "HumanEval/39", "solution": "```python\nfrom typing import Iterator\n\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass FibonacciGenerator:\n    def __init__(self):\n        self.current_a = 0\n        self.current_b = 1\n\n    def generate(self) -> Iterator[int]:\n        \"\"\"Generates an infinite sequence of Fibonacci numbers.\"\"\"\n        while True:\n            yield self.current_a\n            self.current_a, self.current_b = self.current_b, self.current_a + self.current_b\n\nclass PrimeChecker:\n    def is_prime(self, num: int) -> bool:\n        \"\"\"Checks if a number is prime.\"\"\"\n        if num < 2:\n            return False\n        for i in range(2, int(num**0.5) + 1):\n            if num % i == 0:\n                return False\n        return True\n\nMAX_FIB_SEARCH_LIMIT = 1000000 # Arbitrary limit to prevent infinite loops for very large n.\n\nclass PrimeFibFinder:\n    def __init__(self, fib_generator: FibonacciGenerator, prime_checker: PrimeChecker):\n        self.fib_generator = fib_generator\n        self.prime_checker = prime_checker\n\n    def find_nth_prime_fib(self, n: int) -> int:\n        \"\"\"\n        Finds the n-th number that is a Fibonacci number and it's also prime.\n        This method iterates through Fibonacci numbers until the n-th prime is found.\n        \"\"\"\n        if n <= 0:\n            raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n\n        prime_fib_count = 0\n        fib_gen = self.fib_generator.generate()\n\n        # Skip 0 and 1 as they are not prime.\n        next(fib_gen) # yields 0\n        next(fib_gen) # yields 1\n\n        for _ in range(MAX_FIB_SEARCH_LIMIT):\n            fib_num = next(fib_gen)\n            if self.prime_checker.is_prime(fib_num):\n                prime_fib_count += 1\n                if prime_fib_count == n:\n                    return fib_num\n        \n        raise RuntimeError(f\"Could not find the {n}-th prime Fibonacci number within the search limit.\")\n\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    \"\"\"\n    finder = PrimeFibFinder(FibonacciGenerator(), PrimeChecker())\n    return finder.find_nth_prime_fib(n)\n```"}
