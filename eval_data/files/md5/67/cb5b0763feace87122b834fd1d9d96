{"task_id": "HumanEval/143", "solution": "```python\nimport math\n\ndef words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, returning only those with prime lengths.\n    Words are separated by spaces, and their original order is preserved.\n    \"\"\"\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a number is prime, following the specified algorithm.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        # Iterate from 3 up to the square root of n, checking only odd divisors.\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.split(' ')\n    filtered_words = []\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n    return ' '.join(filtered_words)\n```"}
{"task_id": "HumanEval/145", "solution": "```python\ndef _sum_digits(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the absolute digits of an integer.\n    For example: _sum_digits(-12) == 3.\n    \"\"\"\n    s = 0\n    n_abs = abs(n)\n    while n_abs > 0:\n        s += n_abs % 10\n        n_abs //= 10\n    return s\n\ndef order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of integers by the sum of their digits,\n    using original index as a tie-breaker.\n    \"\"\"\n    if not nums:\n        return []\n\n    decorated_list = []\n    for i, num in enumerate(nums):\n        sum_of_digits = _sum_digits(num)\n        decorated_list.append((sum_of_digits, i, num))\n\n    decorated_list.sort() # Python's sort is stable, handling tie-breaking by original_index.\n\n    sorted_nums = [item[2] for item in decorated_list]\n    return sorted_nums\n```"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    \"\"\"Represents a mathematical fraction with a numerator and a denominator.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        if not isinstance(numerator, int) or not isinstance(denominator, int):\n            raise TypeError(\"Numerator and denominator must be integers.\")\n        if denominator == 0:\n            raise ValueError(\"Denominator cannot be zero.\")\n        self._numerator = numerator\n        self._denominator = denominator\n\n    @property\n    def numerator(self) -> int:\n        return self._numerator\n\n    @property\n    def denominator(self) -> int:\n        return self._denominator\n\n    def multiply(self, other: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another fraction.\"\"\"\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Checks if the fraction represents a whole number.\"\"\"\n        return self.numerator % self.denominator == 0\n\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, Fraction):\n            return NotImplemented\n        # Compare fractions by cross-multiplication to avoid floating point issues.\n        return self.numerator * other.denominator == other.numerator * self.denominator\n\n    def __repr__(self) -> str:\n        return f\"Fraction({self.numerator}/{self.denominator})\"\n\n\nclass FractionParser:\n    \"\"\"Parses a string representation of a fraction into a Fraction object.\"\"\"\n    @staticmethod\n    def parse_fraction(fraction_str: str) -> Fraction:\n        \"\"\"Converts a string like \"1/5\" into a Fraction(1, 5) object.\"\"\"\n        parts = fraction_str.split('/')\n        if len(parts) != 2:\n            raise ValueError(\"Invalid fraction string format. Expected 'numerator/denominator'.\")\n        try:\n            numerator = int(parts[0])\n            denominator = int(parts[1])\n        except ValueError:\n            raise ValueError(\"Numerator and denominator must be integers.\")\n        return Fraction(numerator, denominator)\n\n\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"Checks if the product of two fractions, x and n, is a whole number.\n    x and n are string representations of fractions.\"\"\"\n    fraction_x = FractionParser.parse_fraction(x)\n    fraction_n = FractionParser.parse_fraction(n)\n\n    product_fraction = fraction_x.multiply(fraction_n)\n\n    return product_fraction.is_whole_number()"}
{"task_id": "HumanEval/145", "solution": "```python\nfrom dataclasses import dataclass\nfrom typing import List\n\n@dataclass(order=False)\nclass SortableNumber:\n    \"\"\"\n    A data class to encapsulate an integer, its sum of digits, and its original index.\n    Implements custom comparison logic for sorting.\n    \"\"\"\n    value: int\n    digit_sum: int\n    original_index: int\n\n    def __lt__(self, other: 'SortableNumber') -> bool:\n        \"\"\"\n        Defines the less-than comparison for sorting.\n        Primary key: digit_sum (ascending), Secondary key: original_index (ascending).\n        \"\"\"\n        if self.digit_sum != other.digit_sum:\n            return self.digit_sum < other.digit_sum\n        return self.original_index < other.original_index\n\nclass DigitSumSorter:\n    \"\"\"\n    Handles the core logic for calculating digit sums and sorting numbers\n    based on the custom criteria.\n    \"\"\"\n    def calculate_digit_sum(self, n: int) -> int:\n        \"\"\"\n        Calculates the sum of the absolute digits of an integer.\n        \"\"\"\n        s = str(abs(n))\n        return sum(int(digit) for digit in s)\n\n    def sort(self, sortable_numbers: List[SortableNumber]) -> List[SortableNumber]:\n        \"\"\"\n        Sorts a list of SortableNumber objects using their custom comparison logic.\n        \"\"\"\n        return sorted(sortable_numbers)\n\ndef order_by_points(nums) -> List[int]:\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    If several items have similar sum of digits, order them based on their original index.\n    \"\"\"\n    if not isinstance(nums, list):\n        raise TypeError(\"Input must be a list.\")\n\n    sorter = DigitSumSorter()\n    sortable_items: List[SortableNumber] = []\n\n    for i, num in enumerate(nums):\n        if not isinstance(num, int):\n            raise ValueError(f\"List elements must be integers, found {type(num)} at index {i}.\")\n        digit_sum = sorter.calculate_digit_sum(num)\n        sortable_items.append(SortableNumber(value=num, digit_sum=digit_sum, original_index=i))\n\n    sorted_sortable_items = sorter.sort(sortable_items)\n\n    return [item.value for item in sorted_sortable_items]\n```"}
{"task_id": "HumanEval/144", "solution": "import math\n\ndef _gcd(a: int, b: int) -> int:\n    \"\"\"Calculates the greatest common divisor of two integers.\"\"\"\n    return math.gcd(a, b)\n\nclass Fraction:\n    \"\"\"Represents a mathematical fraction.\"\"\"\n\n    def __init__(self, numerator: int, denominator: int):\n        if denominator == 0:\n            raise ValueError(\"Denominator cannot be zero.\")\n        \n        # Normalize sign so denominator is always positive.\n        if denominator < 0:\n            numerator *= -1\n            denominator *= -1\n            \n        common = _gcd(abs(numerator), abs(denominator))\n        self._numerator = numerator // common\n        self._denominator = denominator // common\n\n    @classmethod\n    def from_string(cls, fraction_str: str) -> 'Fraction':\n        \"\"\"Parses a string representation of a fraction into a Fraction object.\"\"\"\n        parts = fraction_str.split('/')\n        if len(parts) != 2:\n            raise ValueError(\"Invalid fraction string format. Expected 'numerator/denominator'.\")\n        \n        try:\n            numerator = int(parts[0])\n            denominator = int(parts[1])\n        except ValueError:\n            raise ValueError(\"Numerator and denominator must be integers.\")\n        \n        return cls(numerator, denominator)\n\n    def multiply(self, other: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another Fraction object.\"\"\"\n        new_numerator = self._numerator * other._numerator\n        new_denominator = self._denominator * other._denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Checks if the fraction represents a whole number.\"\"\"\n        # After simplification, if denominator is 1, it's a whole number.\n        # Or if numerator is perfectly divisible by denominator.\n        return self._denominator == 1 or (self._numerator % self._denominator == 0)\n\n    def __str__(self) -> str:\n        return f\"{self._numerator}/{self._denominator}\"\n\n    def __repr__(self) -> str:\n        return f\"Fraction({self._numerator}, {self._denominator})\"\n\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"\n    Determines if the product of two fraction strings `x` and `n` is a whole number.\n    It returns `True` if it is, `False` otherwise.\n    \"\"\"\n    fraction_x = Fraction.from_string(x)\n    fraction_n = Fraction.from_string(n)\n    product = fraction_x.multiply(fraction_n)\n    return product.is_whole_number()"}
