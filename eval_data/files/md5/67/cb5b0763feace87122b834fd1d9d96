{"task_id": "HumanEval/31", "solution": "```python\nfrom math import isqrt\n\ndef is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    This function implements trial division up to the square root of n.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input must be an integer.\")\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    \n    # Check for divisors from 3 up to the square root of n, stepping by 2.\n    for i in range(3, isqrt(n) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\n```"}
{"task_id": "HumanEval/31", "solution": "```python\ndef is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n < 1:\n        raise ValueError(\"Input must be a positive integer.\")\n    if n == 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n```"}
{"task_id": "HumanEval/33", "solution": "```python\ndef sort_third(l: list):\n    \"\"\"This function takes a list l and returns a new list where elements at indices divisible by three are sorted, preserving other elements.\n    It raises TypeError if input l is not a list, or during sorting for non-comparable elements.\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input 'l' must be a list.\")\n\n    result_list = list(l)  # Create a shallow copy to avoid modifying the original list.\n    elements_to_sort = []\n    third_indices = []\n\n    for i in range(len(result_list)):\n        if i % 3 == 0:\n            elements_to_sort.append(result_list[i])\n            third_indices.append(i)\n\n    elements_to_sort.sort()  # Sort the extracted elements in ascending order.\n\n    for i, index in enumerate(third_indices):\n        result_list[index] = elements_to_sort[i]\n\n    return result_list\n```"}
{"task_id": "HumanEval/16", "solution": "```python\ndef count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of\n    >>> count_distinct_characters('xyzXYZ')\n    3\n    >>> count_distinct_characters('Jerry')\n    4\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    distinct_chars = set()\n    for char in string:\n        distinct_chars.add(char.lower())\n\n    return len(distinct_chars)\n```"}
{"task_id": "HumanEval/33", "solution": "```python\nclass InvalidListTypeError(TypeError):\n    \"\"\"Custom exception for invalid list input type.\"\"\"\n    def __init__(self, message: str = \"Input must be a list.\"):\n        self.message = message\n        super().__init__(self.message)\n\ndef sort_third(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    \"\"\"\n    # Validate that the input is a list, raising a custom error if not.\n    if not isinstance(l, list):\n        raise InvalidListTypeError(\"Input must be a list.\")\n\n    # Return an empty list if the input is empty, as there are no elements to sort.\n    if not l:\n        return []\n\n    # Extract elements at indices divisible by three.\n    elements_at_third_indices = []\n    for i in range(len(l)):\n        if i % 3 == 0:\n            elements_at_third_indices.append(l[i])\n\n    # Sort the extracted elements in ascending order.\n    elements_at_third_indices.sort()\n\n    # Create a new list as a copy of the original for modification.\n    result_list = list(l)\n    \n    # Place the sorted elements back into their original divisible-by-three positions.\n    sorted_elements_idx = 0\n    for i in range(len(result_list)):\n        if i % 3 == 0:\n            result_list[i] = elements_at_third_indices[sorted_elements_idx]\n            sorted_elements_idx += 1\n            \n    return result_list\n```"}
