{"task_id": "HumanEval/113", "solution": "```python\ndef odd_count(lst):\n    \"\"\"Given a list of digit strings, returns a list of descriptive strings.\n    Each output string reports the count of odd digits in its corresponding input.\n    \"\"\"\n    ODD_DIGIT_TEMPLATE = \"the number of odd elements {count}n the str{count}ng {count} of the {count}nput.\"\n    \n    results = []\n    for s in lst:\n        odd_digit_count = 0\n        for char_digit in s:\n            if int(char_digit) % 2 != 0:\n                odd_digit_count += 1\n        \n        formatted_string = ODD_DIGIT_TEMPLATE.format(count=odd_digit_count)\n        results.append(formatted_string)\n        \n    return results\n```"}
{"task_id": "HumanEval/111", "solution": "```python\nfrom collections import Counter\nfrom typing import Dict\n\ndef histogram(test: str) -> Dict[str, int]:\n    \"\"\"Given a string representing space-separated lowercase letters, returns a dictionary\n    of the letter(s) with the most repetition and containing the corresponding count.\n    If several letters have the same occurrence, return all of them.\n    \"\"\"\n    if not test:\n        return {}\n\n    # Split the string into individual letters, filtering out any empty strings.\n    letters = test.split(' ')\n    valid_letters = [letter for letter in letters if letter]\n\n    if not valid_letters:\n        return {}\n\n    # Count occurrences of each letter, then find the maximum count.\n    letter_counts = Counter(valid_letters)\n    max_count = max(letter_counts.values())\n\n    # Collect all letters that have the maximum count.\n    result = {\n        letter: count\n        for letter, count in letter_counts.items()\n        if count == max_count\n    }\n    return result\n```"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, returns True if all keys are strings and uniformly cased (all lowercase or all uppercase).\n    Returns False if empty, contains non-string keys, or has mixed casing.\n    \"\"\"\n    if not dict:\n        return False\n\n    keys = list(dict.keys())\n\n    # Check if all keys are strings.\n    if not all(isinstance(key, str) for key in keys):\n        return False\n\n    # Check if all keys are lowercase.\n    all_lower = all(key.islower() for key in keys)\n    if all_lower:\n        return True\n\n    # Check if all keys are uppercase.\n    all_upper = all(key.isupper() for key in keys)\n    if all_upper:\n        return True\n\n    # If neither all lower nor all upper, it's a mix.\n    return False\n```"}
{"task_id": "HumanEval/114", "solution": "```python\ndef minSubArraySum(nums: list[int]) -> int:\n    \"\"\"\n    Finds the minimum sum of any non-empty contiguous sub-array in the given array of integers.\n    Raises ValueError if the input list `nums` is empty.\n    \"\"\"\n    if not nums:\n        raise ValueError(\"Input array cannot be empty.\")\n\n    min_so_far = nums[0]\n    current_min = nums[0]\n\n    for i in range(1, len(nums)):\n        current_min = min(nums[i], current_min + nums[i])\n        min_so_far = min(min_so_far, current_min)\n\n    return min_so_far\n```"}
{"task_id": "HumanEval/114", "solution": "```python\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to minSubArraySum.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\n\nclass MinSubarraySumService:\n    \"\"\"\n    Service to calculate the minimum sum of any non-empty sub-array.\n    It implements an adapted Kadane's algorithm for efficiency.\n    \"\"\"\n    def find_min_sum(self, nums: list[int]) -> int:\n        \"\"\"\n        Finds the minimum sum of any non-empty sub-array in the given list.\n        The algorithm iterates through the array, tracking current and overall minimums.\n        \"\"\"\n        min_so_far = nums[0]\n        current_min = nums[0]\n\n        for num in nums[1:]:\n            current_min = min(num, current_min + num)\n            min_so_far = min(min_so_far, current_min)\n\n        return min_so_far\n\n\ndef minSubArraySum(nums: list[int]) -> int:\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array\n    of nums.\n    This function validates input and delegates the core computation.\n\n    Args:\n        nums: A non-empty list of integers.\n\n    Returns:\n        The minimum sum of any non-empty sub-array.\n\n    Raises:\n        InvalidInputError: If nums is not a list, is empty, or contains non-integer elements.\n\n    Example:\n        minSubArraySum([2, 3, 4, 1, 2, 4]) == 1\n        minSubArraySum([-1, -2, -3]) == -6\n    \"\"\"\n    if not isinstance(nums, list):\n        raise InvalidInputError(\"Input 'nums' must be a list.\")\n    if not nums:\n        raise InvalidInputError(\"Input 'nums' cannot be an empty list.\")\n    for i, item in enumerate(nums):\n        if not isinstance(item, int):\n            raise InvalidInputError(f\"All elements in 'nums' must be integers. Found non-integer at index {i}.\")\n\n    service = MinSubarraySumService()\n    return service.find_min_sum(nums)\n```"}
{"task_id": "HumanEval/113", "solution": "```python\ndef odd_count(lst):\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\n\n    >>> odd_count(['1234567'])\n    [\"the number of odd elements 4n the str4ng 4 of the 4nput.\"]\n    >>> odd_count(['3',\"11111111\"])\n    [\"the number of odd elements 1n the str1ng 1 of the 1nput.\",\n     \"the number of odd elements 8n the str8ng 8 of the 8nput.\"]\n    \"\"\"\n    results = []\n    for digit_string in lst:\n        odd_digit_count = 0\n        for char_digit in digit_string:\n            if int(char_digit) % 2 != 0:\n                odd_digit_count += 1\n        \n        formatted_output_string = f\"the number of odd elements {odd_digit_count}n the str{odd_digit_count}ng {odd_digit_count} of the {odd_digit_count}nput.\"\n        results.append(formatted_output_string)\n    return results\n```"}
