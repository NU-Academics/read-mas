{"task_id": "Mbpp/286", "solution": "def max_sub_array_sum_repeated(arr: list, n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in an array repeated k times.\n    Applies Kadane's algorithm and optimizes for repeated arrays.\n    \"\"\"\n    def kadane(current_arr: list) -> int:\n        \"\"\"Standard Kadane's algorithm for finding the maximum subarray sum in a single array.\"\"\"\n        max_so_far = current_arr[0]\n        current_max = current_arr[0]\n        \n        for i in range(1, len(current_arr)):\n            current_max = max(current_arr[i], current_max + current_arr[i])\n            max_so_far = max(max_so_far, current_max)\n        \n        return max_so_far\n\n    # If k is 1, simply apply Kadane's algorithm to the original array.\n    if k == 1:\n        return kadane(arr)\n\n    # Calculate the maximum subarray sum for a single instance of the array.\n    best_single = kadane(arr)\n    \n    # Calculate the total sum of the array.\n    total_sum = sum(arr)\n\n    # Calculate the maximum prefix sum.\n    prefix_max = float('-inf')\n    current_prefix_sum = 0\n    for x in arr:\n        current_prefix_sum += x\n        prefix_max = max(prefix_max, current_prefix_sum)\n\n    # Calculate the maximum suffix sum.\n    suffix_max = float('-inf')\n    current_suffix_sum = 0\n    for x in reversed(arr):\n        current_suffix_sum += x\n        suffix_max = max(suffix_max, current_suffix_sum)\n\n    # If the total sum of the array is positive, the maximum subarray can potentially\n    # span across multiple repetitions, benefiting from the positive total sum of inner blocks.\n    if total_sum > 0:\n        # The candidate sum is the best suffix of the first block, plus (k-2) full blocks,\n        # plus the best prefix of the last block.\n        # If k=2, total_sum * (k-2) becomes 0, correctly giving suffix_max + prefix_max.\n        candidate_sum = suffix_max + total_sum * (k - 2) + prefix_max\n        return max(best_single, candidate_sum)\n    # If the total sum is non-positive, including more than two blocks won't increase the sum.\n    # The maximum sum will either be within a single block or span across two concatenated blocks.\n    else:\n        # Apply Kadane's algorithm to two concatenated arrays (arr + arr)\n        # to find the maximum sum that spans across the boundary.\n        arr_twice = arr + arr\n        best_double = kadane(arr_twice)\n        return max(best_single, best_double)"}
{"task_id": "Mbpp/294", "solution": "from typing import Any, Iterable, Iterator, Union\nfrom decimal import Decimal\n\nclass NoNumericValueError(Exception):\n    \"\"\"Exception raised when no numeric values are found in the input list.\"\"\"\n    def __init__(self, message: str = None) -> None:\n        super().__init__(message or \"No numeric values found.\")\n\nACCEPTED_NUMERIC_TYPES = (int, float, Decimal)\n\ndef is_numeric(obj: Any) -> bool:\n    \"\"\"Checks if an object is a numeric type (int, float, Decimal) but not a boolean.\"\"\"\n    return isinstance(obj, ACCEPTED_NUMERIC_TYPES) and not isinstance(obj, bool)\n\ndef normalize_number(obj: Any) -> Union[int, float, Decimal]:\n    \"\"\"Returns the object if it's a numeric type, otherwise raises TypeError.\"\"\"\n    if not is_numeric(obj):\n        raise TypeError(\"Object is not a supported numeric type.\")\n    return obj\n\nclass InputDTO:\n    \"\"\"A data transfer object for validating the input list.\"\"\"\n    def __init__(self, items: list) -> None:\n        self.items = items\n\n    def validate(self) -> None:\n        \"\"\"Validates that the input is a list, raising TypeError if not.\"\"\"\n        if not isinstance(self.items, list):\n            raise TypeError(\"Input 'items' must be a list.\")\n\nclass NumericFilterAdapter:\n    \"\"\"Filters an iterable, yielding only accepted numeric values.\"\"\"\n    DEFAULT_INCLUDE_DECIMALS = True\n    def __init__(self, include_decimals: bool = True):\n        self.include_decimals = include_decimals\n\n    def filter(self, items: Iterable[Any]) -> Iterator[Union[int, float, Decimal]]:\n        \"\"\"Iterates through items and yields only valid numeric types.\"\"\"\n        for item in items:\n            if is_numeric(item):\n                num = normalize_number(item)\n                if not self.include_decimals and isinstance(num, Decimal):\n                    continue\n                yield num\n\nclass MaxFinderService:\n    \"\"\"Finds the maximum value in an iterable of numbers.\"\"\"\n    def __init__(self):\n        self._sentinel = object()\n\n    def find_max(self, numbers: Iterable[Union[int, float, Decimal]]) -> Union[int, float]:\n        \"\"\"Iterates to find the maximum number, raising NoNumericValueError if no numbers are present.\"\"\"\n        current = self._sentinel\n        for n in numbers:\n            if current is self._sentinel or n > current:\n                current = n\n        if current is self._sentinel:\n            raise NoNumericValueError(\"No numeric values found.\")\n        return current\n\nclass MaxValController:\n    \"\"\"Orchestrates input validation, numeric filtering, and maximum value calculation.\"\"\"\n    def __init__(self, service: MaxFinderService, adapter: NumericFilterAdapter):\n        self.service = service\n        self.adapter = adapter\n\n    def max_val(self, items: list) -> Union[int, float]:\n        \"\"\"Processes the input list to find its maximum numeric value.\"\"\"\n        dto = InputDTO(items)\n        dto.validate()\n        numbers = self.adapter.filter(dto.items)\n        return self.service.find_max(numbers)\n\ndef max_val(items: list):\n    \"\"\"\n    Finds the maximum numeric value in a given heterogeneous list.\n    assert max_val(['Python', 3, 2, 4, 5, 'version'])==5\n    \"\"\"\n    _default_controller = MaxValController(service=MaxFinderService(), adapter=NumericFilterAdapter())\n    return _default_controller.max_val(items)"}
{"task_id": "Mbpp/300", "solution": "def count_binary_seq(n: int) -> float:\n    \"\"\"\n    Counts binary sequences of length 2n where the sum of the first n bits\n    is the same as the sum of the last n bits.\n    This count is given by the central binomial coefficient C(2n, n).\n    \"\"\"\n    def _binomial_coefficient(N: int, K: int) -> int:\n        \"\"\"Calculates C(N, K), the number of ways to choose K items from N, using integer arithmetic.\"\"\"\n        if K < 0 or K > N:\n            return 0\n        \n        # Optimization: C(N, K) = C(N, N - K)\n        K = min(K, N - K)\n        \n        if K == 0:\n            return 1\n        \n        try:\n            # Use math.comb if available (Python 3.8+)\n            return math.comb(N, K)\n        except AttributeError:\n            # Fallback multiplicative algorithm for older Python versions\n            res = 1\n            for i in range(K):\n                res = res * (N - i) // (i + 1)\n            return res\n\n    import math\n\n    # The count is given by the central binomial coefficient C(2n, n)\n    N_val = 2 * n\n    K_val = n\n    \n    result_int = _binomial_coefficient(N_val, K_val)\n    return float(result_int)"}
{"task_id": "Mbpp/296", "solution": "import collections.abc\nfrom abc import ABC, abstractmethod\nfrom typing import Sequence, List, Tuple, Dict, Any, Optional\n\n# --- DTOs (models.py) ---\nclass ArrayInput:\n    \"\"\"DTO for array input, handles validation and normalization of numbers.\"\"\"\n    def __init__(self, numbers: Sequence[Any]) -> None:\n        self.numbers: List[Any] = list(numbers) # Create a mutable list copy\n        self.validate()\n\n    def validate(self) -> None:\n        \"\"\"Ensures all elements are numeric and comparable, converting to int if safe.\"\"\"\n        if not isinstance(self.numbers, collections.abc.Sequence):\n            raise TypeError(\"Input must be a sequence.\")\n\n        processed_numbers = []\n        all_elements_are_integer_like = True\n\n        for i, item in enumerate(self.numbers):\n            numeric_value: Any\n            if isinstance(item, (int, float)):\n                numeric_value = item\n            else:\n                try:\n                    # Attempt to convert other types (e.g., strings) to float\n                    numeric_value = float(item)\n                except (ValueError, TypeError):\n                    raise ValueError(f\"Element at index {i} is not a number or convertible to a number: {item}\")\n            \n            # Check if it's an integer or a float that represents an integer (e.g., 5.0)\n            if isinstance(numeric_value, float) and not numeric_value.is_integer():\n                all_elements_are_integer_like = False\n            \n            processed_numbers.append(numeric_value)\n\n        # If all numbers are integer-like, convert them all to int\n        if all_elements_are_integer_like:\n            self.numbers = [int(num) for num in processed_numbers]\n        else:\n            self.numbers = processed_numbers\n\n\nclass InversionCountResult:\n    \"\"\"DTO for inversion count result and metadata.\"\"\"\n    def __init__(self, count: int, algorithm: str) -> None:\n        self.count = count\n        self.algorithm = algorithm\n\n    def to_dict(self) -> Dict[str, Any]:\n        return {\"count\": self.count, \"algorithm\": self.algorithm}\n\n# --- Algorithms (algorithms.py) ---\nclass InversionAlgorithm(ABC):\n    \"\"\"Abstract base class for inversion counting algorithms.\"\"\"\n    @abstractmethod\n    def count_inversions(self, numbers: Sequence[Any]) -> int:\n        pass\n\nclass NaiveInversionAlgorithm(InversionAlgorithm):\n    \"\"\"Counts inversions using a brute-force O(n^2) approach.\"\"\"\n    def count_inversions(self, numbers: Sequence[Any]) -> int:\n        arr = list(numbers) # Work on a copy\n        n = len(arr)\n        count = 0\n        for i in range(n):\n            for j in range(i + 1, n):\n                if arr[i] > arr[j]:\n                    count += 1\n        return count\n\nclass MergeSortInversionAlgorithm(InversionAlgorithm):\n    \"\"\"Counts inversions using a modified merge sort, O(n log n).\"\"\"\n    def count_inversions(self, numbers: Sequence[Any]) -> int:\n        arr = list(numbers) # Work on a copy\n        \n        # Recursive helper function for merge sort and inversion counting\n        def _sort_and_count(a: List[Any]) -> Tuple[List[Any], int]:\n            n = len(a)\n            if n <= 1:\n                return a, 0 # Base case: 0 inversions for 0 or 1 element\n            \n            mid = n // 2\n            left_sorted, left_inversions = _sort_and_count(a[:mid])\n            right_sorted, right_inversions = _sort_and_count(a[mid:])\n            \n            merged_list, split_inversions = self._merge_count(left_sorted, right_sorted)\n            \n            return merged_list, left_inversions + right_inversions + split_inversions\n\n        _, total_inversions = _sort_and_count(arr)\n        return total_inversions\n\n    def _merge_count(self, left: List[Any], right: List[Any]) -> Tuple[List[Any], int]:\n        \"\"\"Merges two sorted lists and counts split inversions.\"\"\"\n        merged = []\n        inversions = 0\n        i, j = 0, 0\n        \n        while i < len(left) and j < len(right):\n            if left[i] <= right[j]:\n                merged.append(left[i])\n                i += 1\n            else:\n                # If an element from right is smaller, it forms an inversion\n                # with all remaining elements in left.\n                merged.append(right[j])\n                inversions += (len(left) - i)\n                j += 1\n        \n        # Append remaining elements\n        merged.extend(left[i:])\n        merged.extend(right[j:])\n        \n        return merged, inversions\n\n# --- Service (services.py) ---\nclass ServiceError(Exception):\n    \"\"\"Custom exception for service-level errors.\"\"\"\n    pass\n\nclass InversionService:\n    \"\"\"Orchestrates inversion counting algorithms.\"\"\"\n    def __init__(self, algorithms: Dict[str, InversionAlgorithm], repository: Optional[Any] = None) -> None:\n        self.algorithms = algorithms\n        self.repository = repository # Placeholder for optional FileRepository\n\n    def count(self, array_input: ArrayInput, algorithm: Optional[str] = None) -> InversionCountResult:\n        \"\"\"Counts inversions for a given array using the specified algorithm.\"\"\"\n        try:\n            numbers = array_input.numbers # ArrayInput's constructor already called validate()\n\n            chosen_algo_name = algorithm if algorithm else \"merge\"\n            if chosen_algo_name not in self.algorithms:\n                raise ValueError(f\"Unsupported algorithm: {chosen_algo_name}. Available: {', '.join(self.algorithms.keys())}\")\n            \n            algo_instance = self.algorithms[chosen_algo_name]\n            inversion_count = algo_instance.count_inversions(numbers)\n            \n            result = InversionCountResult(inversion_count, chosen_algo_name)\n            \n            # The _default_service does not pass a repository, so this block will not execute for get_Inv_Count.\n            # if self.repository:\n            #     self.repository.save(result, array_input) \n            \n            return result\n        except (TypeError, ValueError) as e:\n            # Wrap validation or algorithm-specific errors in a service error\n            raise ServiceError(f\"Error in inversion counting service: {e}\") from e\n\n# --- API Adapter (controllers.py) ---\nclass APIAdapter:\n    \"\"\"Adapter to expose InversionService functionality as a simple function.\"\"\"\n    def __init__(self, service: InversionService) -> None:\n        self.service = service\n\n    def get_inv_count(self, numbers: Sequence[Any], algorithm: Optional[str] = None) -> int:\n        \"\"\"\n        Counts inversions in a sequence of numbers and returns the total count.\n        \"\"\"\n        array_input = ArrayInput(numbers) # Input validation happens here\n        result = self.service.count(array_input, algorithm)\n        return result.count\n\n# --- Global setup for the library function (similar to src/invcount/__init__.py) ---\n_naive_algo = NaiveInversionAlgorithm()\n_merge_algo = MergeSortInversionAlgorithm()\n\n_default_service = InversionService(\n    algorithms={\n        \"merge\": _merge_algo,\n        \"naive\": _naive_algo,\n    }\n)\n\n_api = APIAdapter(_default_service)\n\ndef get_Inv_Count(numbers: Sequence[Any], algorithm: str = 'merge') -> int:\n    \"\"\"\n    Counts inversions in an array using either merge sort (O(N log N)) or naive (O(N^2)) algorithm.\n    It validates input and returns the total inversion count.\n    \"\"\"\n    return _api.get_inv_count(numbers, algorithm)"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(nested_list):\n    flattened = []\n    for item in nested_list:\n        if isinstance(item, list):\n            flattened.extend(flatten_list(item))\n        else:\n            flattened.append(item)\n    return flattened"}
{"task_id": "Mbpp/301", "solution": "import collections.abc\n\ndef dict_depth(obj, _seen=None):\n    \"\"\"\n    Calculates the maximum nesting depth of a dictionary.\n    Returns 0 for non-mapping objects and handles cyclic references gracefully.\n    \"\"\"\n    if _seen is None:\n        _seen = set()\n\n    if not isinstance(obj, collections.abc.Mapping):\n        return 0\n\n    obj_id = id(obj)\n    if obj_id in _seen:\n        # Cycle detected; return 0 to prevent RecursionError without raising an exception.\n        return 0\n\n    _seen.add(obj_id)\n\n    max_child_depth = 0\n    for value in obj.values():\n        max_child_depth = max(max_child_depth, dict_depth(value, _seen))\n\n    _seen.remove(obj_id) # Remove object from seen set upon exiting its recursion branch\n\n    return 1 + max_child_depth"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(data):\n    \"\"\"\n    Calculates the maximum aggregate sum from a list of (name, value) tuples.\n    If multiple names tie for the maximum sum, the lexicographically smallest name is returned.\n    \"\"\"\n    aggregates = {}\n    for name, value in data:\n        aggregates[name] = aggregates.get(name, 0.0) + value\n\n    if not aggregates:\n        # According to the design context's AggregatorService, NotFoundError would be raised here.\n        # Per strict completion instructions \"Do NOT add ... raise exceptions for edge cases\",\n        # we let Python's built-in behavior take its course for empty aggregates.\n        # max(empty_iterable) raises ValueError.\n        return None # Or let ValueError propagate if design allows\n\n    max_total = max(aggregates.values())\n    \n    # Find all names that have the max_total\n    candidates = [name for name, total in aggregates.items() if total == max_total]\n    \n    # Apply lexicographical tie-breaker\n    chosen_name = sorted(candidates)[0]\n    \n    return (chosen_name, max_total)"}
{"task_id": "Mbpp/305", "solution": "from typing import List, Tuple, Iterator\n\nclass WordTokenizer:\n    \"\"\"Tokenizes input lines into words, yielding non-empty tokens.\"\"\"\n    def tokenize(self, lines: List[str]) -> Iterator[str]:\n        for line in lines:\n            for token in line.split():\n                if token:\n                    yield token\n\nclass StringNormalizer:\n    \"\"\"Normalizes tokens (trims) and checks if they start with 'p' case-insensitively.\"\"\"\n    P_LETTER = \"p\"\n\n    def normalize(self, token: str) -> str:\n        return token.strip()\n\n    def starts_with_p(self, token: str) -> bool:\n        return token.lower().startswith(self.P_LETTER)\n\nclass StartWithPService:\n    \"\"\"Orchestrates tokenization, normalization, and matching to find 'p' words.\"\"\"\n    def __init__(self, tokenizer: WordTokenizer, normalizer: StringNormalizer) -> None:\n        self.tokenizer = tokenizer\n        self.normalizer = normalizer\n\n    def start_withp(self, lines: List[str]) -> Tuple[str, str]:\n        collected_matches: List[str] = []\n        for token in self.tokenizer.tokenize(lines):\n            trimmed_token = token.strip()\n            normalized_for_check = self.normalizer.normalize(trimmed_token)\n            \n            if self.normalizer.starts_with_p(normalized_for_check):\n                collected_matches.append(trimmed_token)\n                if len(collected_matches) == 2:\n                    return (collected_matches[0], collected_matches[1])\n        \n        # Per the prompt's constraints (\"DO NOT raise exceptions for edge cases\" and\n        # `Tuple[str, str]` return type), this code path implies that the input\n        # is guaranteed to provide at least two matching words, ensuring the function\n        # always returns from within the loop.\n\ndef start_withp(words: List[str]) -> Tuple[str, str]:\n    \"\"\"\n    Returns two words from a list of words starting with letter 'p' (case-insensitive).\n    Assumes input always contains at least two such words.\n    \"\"\"\n    tokenizer = WordTokenizer()\n    normalizer = StringNormalizer()\n    svc = StartWithPService(tokenizer, normalizer)\n    return svc.start_withp(words)"}
{"task_id": "Mbpp/306", "solution": "from typing import List\n\ndef max_sum_increasing_subseq(arr: List[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from arr[0...i]\n    that includes arr[k], where elements from arr[0...i] are strictly\n    less than arr[k] to form the increasing sequence.\n    \"\"\"\n    # msis_sums[j] stores the maximum sum of an increasing subsequence\n    # ending at arr[j] within the prefix arr[0...i].\n    msis_sums = [arr[j] for j in range(i + 1)]\n\n    # Compute MSIS for the prefix arr[0...i] using dynamic programming.\n    for j in range(i + 1):\n        for p in range(j):\n            if arr[p] < arr[j]:\n                msis_sums[j] = max(msis_sums[j], msis_sums[p] + arr[j])\n\n    target_k_value = arr[k]\n    max_prefix_sum_less_than_k = 0\n\n    # Find the maximum MSIS sum from the prefix arr[0...i]\n    # where the last element of that subsequence is strictly less than arr[k].\n    for j in range(i + 1):\n        if arr[j] < target_k_value:\n            max_prefix_sum_less_than_k = max(max_prefix_sum_less_than_k, msis_sums[j])\n\n    # The total maximum sum includes the best prefix sum found and arr[k].\n    # If no prefix element is less than arr[k], max_prefix_sum_less_than_k remains 0,\n    # and the result is just arr[k].\n    return max_prefix_sum_less_than_k + target_k_value"}
{"task_id": "Mbpp/308", "solution": "import heapq\nfrom typing import List, Tuple, Set\n\ndef large_product(list1: List[int], list2: List[int], k: int) -> List[int]:\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list, using a max-heap approach.\n    \"\"\"\n    list1_sorted = sorted(list1, reverse=True)\n    list2_sorted = sorted(list2, reverse=True)\n\n    m, n = len(list1_sorted), len(list2_sorted)\n    \n    # If k is non-positive or either list is empty, return an empty list\n    if k <= 0 or m == 0 or n == 0:\n        return []\n\n    result: List[int] = []\n    \n    # Max-heap to store (negative_product, index_in_list1, index_in_list2)\n    # Using negative product to simulate a max-heap with heapq (which is a min-heap)\n    heap: List[Tuple[int, int, int]] = []\n    \n    # Set to keep track of visited index pairs to avoid duplicates\n    visited: Set[Tuple[int, int]] = set()\n\n    # Start with the product of the largest elements from both lists\n    initial_product = list1_sorted[0] * list2_sorted[0]\n    heapq.heappush(heap, (-initial_product, 0, 0))\n    visited.add((0, 0))\n\n    while heap and len(result) < k:\n        neg_prod, i, j = heapq.heappop(heap)\n        result.append(-neg_prod)\n\n        # Explore the next possible products by incrementing index in list1\n        if i + 1 < m and (i + 1, j) not in visited:\n            next_product_i = list1_sorted[i + 1] * list2_sorted[j]\n            heapq.heappush(heap, (-next_product_i, i + 1, j))\n            visited.add((i + 1, j))\n\n        # Explore the next possible products by incrementing index in list2\n        if j + 1 < n and (i, j + 1) not in visited:\n            next_product_j = list1_sorted[i] * list2_sorted[j + 1]\n            heapq.heappush(heap, (-next_product_j, i, j + 1))\n            visited.add((i, j + 1))\n            \n    return result"}
