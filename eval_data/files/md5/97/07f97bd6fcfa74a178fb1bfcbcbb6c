{"task_id": "Mbpp/140", "solution": "def extract_singly(items):\n    \"\"\"\n    Flattens a list of lists into a single set of numbers.\n    Assumes input is an iterable of iterables containing numbers.\n    \"\"\"\n    result_set = set()\n    for inner_iterable in items:\n        for number in inner_iterable:\n            result_set.add(number)\n    return result_set"}
{"task_id": "Mbpp/145", "solution": "from typing import Sequence, Tuple\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation errors in input sequences.\"\"\"\n    pass\n\ndef max_Abs_Diff(arr: Sequence[int]) -> int:\n    \"\"\"\n    Calculates the maximum difference between any two elements in a given sequence.\n    It identifies the maximum and minimum elements to compute their difference.\n    \"\"\"\n    if not arr:\n        raise ValidationError(\"input sequence must not be empty\")\n\n    converted_values: Tuple[int, ...]\n    temp_list = []\n    for i, item in enumerate(arr):\n        try:\n            temp_list.append(int(item))\n        except (TypeError, ValueError) as e:\n            raise ValidationError(f\"element at index {i} is not an integer: {item}\") from e\n    converted_values = tuple(temp_list)\n\n    if len(converted_values) == 1:\n        return 0\n\n    min_val: int = converted_values[0]\n    max_val: int = converted_values[0]\n\n    for v in converted_values[1:]:\n        if v < min_val:\n            min_val = v\n        if v > max_val:\n            max_val = v\n\n    return max_val - min_val"}
{"task_id": "Mbpp/141", "solution": "def pancake_sort(items: list) -> list:\n    \"\"\"Sorts a list of elements using the pancake sort algorithm.\n    This implementation adheres to the design document, including logging and validation.\n    \"\"\"\n    import json\n    import time\n    import sys\n    from pathlib import Path\n    from datetime import datetime, timezone\n    from typing import List, Any, Dict, TypeVar\n\n    T = TypeVar(\"T\")\n\n    class Config:\n        \"\"\"Configuration for the pancake sorter, including log path and persistence settings.\"\"\"\n        LOG_PATH: str = \"./data/sort_log.jsonl\"\n        PERSISTENCE_ENABLED: bool = True\n\n        @staticmethod\n        def from_env() -> \"Config\":\n            \"\"\"Creates a Config instance, currently returning defaults without environment variable parsing.\"\"\"\n            return Config()\n\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception for invalid input to the sorting functions.\"\"\"\n        def __init__(self, message: str) -> None:\n            self.message = message\n            super().__init__(message)\n\n    class SortResult:\n        \"\"\"Data model representing a single sort operation for logging.\"\"\"\n        def __init__(self, input_list: List[Any], output_list: List[Any], duration_ms: float, timestamp: str):\n            self.input_list = input_list\n            self.output_list = output_list\n            self.duration_ms = duration_ms\n            self.timestamp = timestamp\n\n        def to_dict(self) -> Dict[str, Any]:\n            \"\"\"Converts the SortResult object to a dictionary for JSON serialization.\"\"\"\n            return {\n                \"input\": self.input_list,\n                \"output\": self.output_list,\n                \"duration_ms\": self.duration_ms,\n                \"timestamp\": self.timestamp,\n                \"status\": \"ok\"\n            }\n\n    class ValidationUtils:\n        \"\"\"Utility class for validating input lists and their elements.\"\"\"\n        @staticmethod\n        def is_list(obj: Any) -> bool:\n            \"\"\"Checks if the given object is an instance of a list.\"\"\"\n            return isinstance(obj, list)\n\n        @staticmethod\n        def elements_comparable(lst: List[Any]) -> bool:\n            \"\"\"Checks if all elements in the list can be compared to each other.\"\"\"\n            if len(lst) < 2:\n                return True\n            try:\n                sorted(list(lst))\n                return True\n            except Exception:\n                return False\n\n    class TimingUtils:\n        \"\"\"Utility class for generating timestamps and calculating durations.\"\"\"\n        @staticmethod\n        def now_iso() -> str:\n            \"\"\"Returns the current UTC time in ISO 8601 format with milliseconds.\"\"\"\n            return datetime.now(timezone.utc).isoformat(timespec='milliseconds').replace('+00:00', 'Z')\n\n        @staticmethod\n        def time_ms(start: float, end: float) -> float:\n            \"\"\"Calculates the duration in milliseconds between two performance counter timestamps.\"\"\"\n            return (end - start) * 1000\n\n    class SortRepository:\n        \"\"\"Handles persistence of sort operation records to a local NDJSON file.\"\"\"\n        def __init__(self, path: str):\n            self.path = path\n\n        def ensure_dir_exists(self) -> None:\n            \"\"\"Ensures the directory for the log file exists.\"\"\"\n            Path(self.path).parent.mkdir(parents=True, exist_ok=True)\n\n        def save(self, record: Dict[str, Any]) -> None:\n            \"\"\"Appends a serialized record to the log file, handling I/O errors gracefully.\"\"\"\n            try:\n                self.ensure_dir_exists()\n                with open(self.path, \"a\", encoding=\"utf-8\") as f:\n                    f.write(json.dumps(record, default=str) + \"\\n\")\n            except IOError:\n                print(f\"Error saving sort record to {self.path}\", file=sys.stderr)\n\n    class PancakeSorterService:\n        \"\"\"Implements the pancake sort algorithm to sort a list of comparable elements.\"\"\"\n        def __init__(self) -> None:\n            pass\n\n        def sort(self, items: List[T]) -> List[T]:\n            \"\"\"Sorts the given list of items in non-decreasing order using pancake sort.\"\"\"\n            arr = list(items)  # Work on a shallow copy\n            n = len(arr)\n            for curr_size in range(n, 1, -1):\n                max_idx = self._index_of_max(arr, curr_size)\n                if max_idx != curr_size - 1:\n                    self._flip(arr, max_idx)\n                    self._flip(arr, curr_size - 1)\n            return arr\n\n        def _flip(self, items: List[T], k: int) -> None:\n            \"\"\"Reverses elements in the prefix 0..k of the list in-place.\"\"\"\n            i, j = 0, k\n            while i < j:\n                items[i], items[j] = items[j], items[i]\n                i += 1\n                j -= 1\n\n        def _index_of_max(self, items: List[T], n: int) -> int:\n            \"\"\"Finds the index of the maximum element in the prefix 0..n-1.\"\"\"\n            max_i = 0\n            for i in range(1, n):\n                if items[i] > items[max_i]:\n                    max_i = i\n            return max_i\n\n    class SortController:\n        \"\"\"Orchestrates sorting, validation, timing, and persistence of sort operations.\"\"\"\n        def __init__(self, service: PancakeSorterService, repo: SortRepository, config: Config):\n            self.service = service\n            self.repo = repo\n            self.config = config\n\n        def sort(self, items: List[T]) -> List[T]:\n            \"\"\"Validates input, performs sorting, logs the operation, and returns the sorted list.\"\"\"\n            if not ValidationUtils.is_list(items):\n                raise InvalidInputError(\"Input must be a list\")\n            if not ValidationUtils.elements_comparable(items):\n                raise InvalidInputError(\"Elements are not comparable\")\n\n            start = time.perf_counter()\n            output = self.service.sort(items)\n            end = time.perf_counter()\n\n            duration_ms = TimingUtils.time_ms(start, end)\n            result_record = SortResult(list(items), output, duration_ms, TimingUtils.now_iso())\n\n            if self.config.PERSISTENCE_ENABLED:\n                try:\n                    self.repo.save(result_record.to_dict())\n                except Exception:\n                    pass # Persistence is best effort; do not fail the sort operation\n\n            return output\n\n    # Main execution for pancake_sort function\n    config = Config.from_env()\n    service = PancakeSorterService()\n    repo = SortRepository(config.LOG_PATH)\n    controller = SortController(service, repo, config)\n\n    return controller.sort(items)"}
{"task_id": "Mbpp/142", "solution": "from typing import Sequence, Any, Tuple\n\ndef count_samepair(a: Sequence[Any], b: Sequence[Any], c: Sequence[Any]) -> Tuple[int, int]:\n    \"\"\"Counts identical items at the same position across three sequences.\n    Returns the count and the length compared (shortest of the three sequences).\"\"\"\n    min_len = min(len(a), len(b), len(c))\n    count = 0\n    for i in range(min_len):\n        if a[i] == b[i] == c[i]:\n            count += 1\n    return count, min_len"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(source: list, to_remove: list) -> list:\n    \"\"\"Removes all elements from the source list that are present in the to_remove list, preserving order.\"\"\"\n    \n    # Check if all items in to_remove are hashable to enable a faster set-based comparison.\n    are_hashable = True\n    for item in to_remove:\n        try:\n            hash(item)\n        except TypeError:\n            are_hashable = False\n            break\n\n    if are_hashable:\n        rem_set = set(to_remove)\n        return [item for item in source if item not in rem_set]\n    else:\n        # Fallback for non-hashable items, comparing each item using equality (O(N*M) complexity).\n        return [item for item in source if item not in to_remove]"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(text: str) -> int:\n    \"\"\"\n    Counts characters in a string that match their position in the English alphabet (case-insensitive).\n    \"\"\"\n    alphabet = \"abcdefghijklmnopqrstuvwxyz\"\n    count = 0\n    normalized_text = text.lower()\n\n    for i, char in enumerate(normalized_text, start=1):\n        if 1 <= i <= len(alphabet) and char == alphabet[i - 1]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n):\n    \"\"\"Calculates the sum of the series n + (n-2) + (n-4) + ... for terms greater than zero.\n    This implementation uses a closed-form formula for O(1) performance.\"\"\"\n    if n <= 0:\n        return 0\n\n    # Calculate k, the number of positive terms in the series.\n    k = (n + 1) // 2\n\n    # Determine the last term in the series (which must be strictly positive).\n    last_term = n - 2 * (k - 1)\n\n    # Apply the arithmetic series sum formula: sum = k * (first_term + last_term) / 2.\n    return k * (n + last_term) // 2"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    # This class is defined inline as required for specific error handling.\n    class InfiniteSolutionsError(Exception):\n        def __init__(self, message: str = \"Infinite solutions for 0*x + 0*y = 0\"):\n            super().__init__(message)\n\n    # Handle the special case where both 'a' and 'b' are zero.\n    if a == 0 and b == 0:\n        if n == 0:\n            raise InfiniteSolutionsError()\n        return None  # No solution if a=0, b=0, but n!=0\n\n    # Extended Euclidean Algorithm to find g = gcd(a, b) and coefficients u, v\n    # such that a*u + b*v = g.\n    r_curr, r_next = a, b\n    x_curr, x_next = 1, 0\n    y_curr, y_next = 0, 1\n\n    while r_next != 0:\n        q = r_curr // r_next\n        r_curr, r_next = r_next, r_curr - q * r_next\n        x_curr, x_next = x_next, x_curr - q * x_next\n        y_curr, y_next = y_next, y_curr - q * y_next\n\n    g = r_curr  # g is the GCD\n    u = x_curr  # u is the coefficient for a\n    v = y_curr  # v is the coefficient for b\n\n    # Ensure g is always non-negative, adjusting u and v accordingly.\n    if g < 0:\n        g = -g\n        u = -u\n        v = -v\n\n    # Check if 'n' is divisible by 'g'. If not, no integer solution exists.\n    if n % g != 0:\n        return None\n\n    # Calculate a particular solution (x_p, y_p) by scaling u and v.\n    factor = n // g\n    x_p = u * factor\n    y_p = v * factor\n\n    # Normalize the solution to match the example's specific output (e.g., smallest non-negative x).\n    # This normalization is typically applied when both a and b are non-zero.\n    if b != 0:\n        b_over_g = b // g\n        x = (x_p % b_over_g + b_over_g) % b_over_g\n        y = (n - a * x) // b\n    elif a != 0: # If b is zero, and a is not (handled above).\n        a_over_g = a // g\n        y = (y_p % a_over_g + a_over_g) % a_over_g # Find y in a specific range for non-zero a\n        x = (n - b * y) // a # This case b=0, so x = n//a\n        x = n // a # For a_x = n, x = n/a, y is from scaling\n        y = y_p # Just use the y from scaling as it can be any integer\n        # The prompt test case does not cover a=0, b!=0 explicitly but the general solution\n        # logic for x and y derived from Bezout's identity naturally provides a solution.\n        # For a*x = n, x = n/a, and y can be any integer. The initial y_p from the algorithm is a valid choice.\n        # For b*y = n, y = n/b, and x can be any integer. The initial x_p from the algorithm is a valid choice.\n    else: # This should not be reached due to a=0, b=0 check above.\n        return None\n\n    return (x, y)"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(numbers: list[int]) -> int:\n    \"\"\"\n    Counts pairs of integers in a list that XOR to an even number.\n    This is achieved by counting pairs of numbers with the same parity.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for num in numbers:\n        # Check parity using bitwise AND with 1.\n        # If the least significant bit is 0, the number is even.\n        if (num & 1) == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # A pair (a, b) XORs to an even number if a and b have the same parity.\n    # The number of pairs from 'n' items is n * (n - 1) / 2 (combinations of 2).\n    even_pairs = (even_count * (even_count - 1)) // 2\n    odd_pairs = (odd_count * (odd_count - 1)) // 2\n\n    return even_pairs + odd_pairs"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Assumes n is a non-negative integer as per design context.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Check if n is already a power of two (n > 0 and (n & (n - 1)) == 0)\n    # If it is, return n itself.\n    if (n & (n - 1)) == 0:\n        return n\n    \n    # If n is not a power of two, the next power of two is 2 raised to the power of n's bit length.\n    # For example, if n=3 (binary 11), bit_length is 2. 1 << 2 = 4.\n    # If n=5 (binary 101), bit_length is 3. 1 << 3 = 8.\n    return 1 << n.bit_length()"}
