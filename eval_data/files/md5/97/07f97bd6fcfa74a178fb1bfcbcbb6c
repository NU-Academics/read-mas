{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(data, sort=False):\n    \"\"\"\n    Finds common elements in given nested lists by converting them to sets and performing intersections.\n    Optionally sorts the result.\n    \"\"\"\n    list_of_sets = []\n    for inner_iterable in data:\n        list_of_sets.append(set(inner_iterable))\n\n    if not list_of_sets:\n        return []\n\n    # Sort sets by size to optimize intersection operations, starting with the smallest.\n    list_of_sets.sort(key=len)\n\n    # Initialize the intersection with the first (and smallest) set.\n    current_intersection = list_of_sets[0]\n\n    # If the smallest set is empty, the final intersection must also be empty.\n    if not current_intersection:\n        return []\n\n    # Intersect with the remaining sets.\n    for i in range(1, len(list_of_sets)):\n        current_intersection = current_intersection.intersection(list_of_sets[i])\n        # If intersection becomes empty at any point, no common elements exist.\n        if not current_intersection:\n            return []\n\n    result = list(current_intersection)\n\n    if sort:\n        return sorted(result)\n    return result"}
{"task_id": "Mbpp/123", "solution": "class InvalidParameterError(ValueError):\n    \"\"\"Custom exception for invalid parameters.\"\"\"\n    pass\n\nclass DivisorRepository:\n    \"\"\"Manages computation and caching of proper divisor sums.\"\"\"\n    def __init__(self) -> None:\n        self._cache: dict[int, int] = {1: 0}\n\n    def get_proper_divisor_sum(self, n: int) -> int:\n        \"\"\"Computes the sum of proper divisors for a single number n.\"\"\"\n        if n in self._cache:\n            return self._cache[n]\n        total = 1 if n > 1 else 0\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                total += i\n                j = n // i\n                if j != i:\n                    total += j\n            i += 1\n        self._cache[n] = total\n        return total\n\n    def get_proper_divisor_sums_up_to(self, limit: int) -> dict[int, int]:\n        \"\"\"Computes sums of proper divisors for all numbers up to limit using a sieve-like method.\"\"\"\n        sums = {i: 0 for i in range(1, limit + 1)}\n        for i in range(1, limit // 2 + 1):\n            for multiple in range(i * 2, limit + 1, i):\n                sums[multiple] += i\n        self._cache.update(sums)\n        return sums\n\nclass AmicableService:\n    \"\"\"Provides business logic for finding amicable numbers.\"\"\"\n    def __init__(self, repo: DivisorRepository) -> None:\n        self._repo = repo\n\n    def amicable_numbers_sum(self, limit: int) -> int:\n        \"\"\"Calculates the sum of all amicable numbers up to the specified limit.\"\"\"\n        sums = self._repo.get_proper_divisor_sums_up_to(limit)\n        total = 0\n        for n in range(1, limit + 1):\n            m = sums[n]\n            if m != n and m > 0:\n                dm = sums.get(m)\n                if dm is None:\n                    dm = self._repo.get_proper_divisor_sum(m)\n                if dm == n:\n                    total += n\n        return total\n\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"Sums all amicable numbers up to the specified limit.\"\"\"\n    repo = DivisorRepository()\n    svc = AmicableService(repo)\n    return svc.amicable_numbers_sum(limit)"}
{"task_id": "Mbpp/124", "solution": "import math\n\nclass InvalidComplexError(Exception):\n    \"\"\"Exception for invalid complex number inputs.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass MathUtils:\n    \"\"\"Utility for mathematical operations like atan2.\"\"\"\n    @staticmethod\n    def atan2(y: float, x: float) -> float:\n        return math.atan2(y, x)\n\ndef is_numeric(v) -> bool:\n    \"\"\"Checks if a value is an integer or float.\"\"\"\n    return isinstance(v, (int, float))\n\nclass ComplexNumber:\n    \"\"\"Represents a complex number with real and imaginary parts.\"\"\"\n    def __init__(self, real: float, imag: float) -> None:\n        self.real = float(real)\n        self.imag = float(imag)\n\n    def magnitude(self) -> float:\n        \"\"\"Returns the magnitude of the complex number.\"\"\"\n        return math.hypot(self.real, self.imag)\n\n    def to_complex(self) -> complex:\n        \"\"\"Returns the built-in complex type.\"\"\"\n        return complex(self.real, self.imag)\n\nclass ComplexAdapter:\n    \"\"\"Adapts various inputs to a ComplexNumber model.\"\"\"\n    def to_model(self, value, imag=None) -> ComplexNumber:\n        \"\"\"Converts a complex number input or numeric components to a ComplexNumber model.\"\"\"\n        if isinstance(value, complex) and imag is None:\n            return ComplexNumber(value.real, value.imag)\n        if is_numeric(value) and is_numeric(imag):\n            return ComplexNumber(float(value), float(imag))\n        raise InvalidComplexError(\"Invalid complex input; expected complex or numeric pair.\")\n\nclass AngleService:\n    \"\"\"Service for computing the angle of a complex number.\"\"\"\n    def __init__(self, math_utils: MathUtils = None) -> None:\n        self.math_utils = math_utils or MathUtils()\n\n    def compute_angle(self, c: ComplexNumber) -> float:\n        \"\"\"Computes the angle (argument) of a ComplexNumber.\"\"\"\n        if c.real == 0.0 and c.imag == 0.0:\n            return 0.0\n        return self.math_utils.atan2(c.imag, c.real)\n\n_default_math = MathUtils()\n_default_service = AngleService(math_utils=_default_math)\n_default_adapter = ComplexAdapter()\n\ndef angle_complex(value, imag=None) -> float:\n    \"\"\"\n    Computes the principal value of the argument (angle) of a complex number in radians.\n    Accepts a Python complex number or a real and imaginary component.\n    \"\"\"\n    c = _default_adapter.to_model(value, imag)\n    return _default_service.compute_angle(c)"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(pairs):\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples.\n    The function assumes valid input (non-empty list of 2-element numeric tuples).\n    \"\"\"\n    max_abs_product = 0\n\n    for a, b in pairs:\n        current_product = a * b\n        current_abs_product = abs(current_product)\n\n        if current_abs_product > max_abs_product:\n            max_abs_product = current_abs_product\n\n    return max_abs_product"}
{"task_id": "Mbpp/126", "solution": "import math\nfrom typing import Tuple, List\n\nMAX_INPUT = 1_000_000_000\n\ndef validate_inputs(a: object, b: object, max_abs: int = MAX_INPUT) -> Tuple[int, int]:\n    try:\n        ai = int(a)\n        bi = int(b)\n    except Exception as e:\n        raise TypeError(\"Inputs must be integers\") from e\n    ai = abs(ai)\n    bi = abs(bi)\n    if ai > max_abs or bi > max_abs:\n        raise ValueError(f\"Inputs must be <= {max_abs} in absolute value\")\n    return ai, bi\n\ndef enumerate_divisors(n: int) -> List[int]:\n    if n <= 0:\n        return []\n    divs = set()\n    limit = int(math.isqrt(n))\n    for i in range(1, limit + 1):\n        if n % i == 0:\n            divs.add(i)\n            divs.add(n // i)\n    return sorted(divs)\n\nclass GCDRepository:\n    def __init__(self) -> None:\n        pass\n\n    def gcd(self, a: int, b: int) -> int:\n        return math.gcd(a, b)\n\nclass DivisorCalculator:\n    def __init__(self, gcd_repo: GCDRepository) -> None:\n        self._gcd_repo = gcd_repo\n\n    def sum_common_divisors(self, a: int, b: int) -> int:\n        a_i, b_i = validate_inputs(a, b)\n        g = self._gcd_repo.gcd(a_i, b_i)\n        if g == 0:\n            return 0\n        divisors = enumerate_divisors(g)\n        return sum(divisors)\n\n    def get_common_divisors(self, a: int, b: int) -> list[int]:\n        a_i, b_i = validate_inputs(a, b)\n        g = self._gcd_repo.gcd(a_i, b_i)\n        if g == 0:\n            return []\n        return enumerate_divisors(g)\n\ndef sum(a: int, b: int) -> int:\n    \"\"\"\n    Public convenience function that returns sum of common divisors.\n    \"\"\"\n    gcd_repo = GCDRepository()\n    calc = DivisorCalculator(gcd_repo)\n    return calc.sum_common_divisors(a, b)"}
{"task_id": "Mbpp/125", "solution": "def find_length(s: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s in any substring.\n    This is achieved by mapping '0' to 1 and '1' to -1, then applying Kadane's algorithm.\n    \"\"\"\n    if not s:\n        # As per design, input is guaranteed non-empty by validator.\n        # This case is included for robustness if called directly.\n        return 0\n\n    # Map '0' to 1 and '1' to -1\n    mapped_values = []\n    for char in s:\n        if char == '0':\n            mapped_values.append(1)\n        elif char == '1':\n            mapped_values.append(-1)\n        # No error handling for invalid chars, assuming valid input as per design.\n\n    # Apply Kadane's algorithm to find the maximum subarray sum\n    max_so_far = mapped_values[0]\n    current_max = mapped_values[0]\n\n    for i in range(1, len(mapped_values)):\n        v = mapped_values[i]\n        current_max = max(v, current_max + v)\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/128", "solution": "import re\n\ndef long_words(n: int, text: str) -> list[str]:\n    \"\"\"\n    Finds words from a given text that are strictly longer than n characters.\n    It tokenizes the text, stripping leading/trailing punctuation from each word.\n    \"\"\"\n    strip_punct_pattern = r\"^[\\W_]+|[\\W_]+$\"\n    _strip_re = re.compile(strip_punct_pattern)\n\n    raw_tokens = text.split()\n    processed_tokens = []\n    for t in raw_tokens:\n        trimmed = _strip_re.sub(\"\", t)\n        if trimmed:\n            processed_tokens.append(trimmed)\n\n    return [word for word in processed_tokens if len(word) > n]"}
{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix):\n    n = len(matrix)\n    if n == 0:\n        return False # An empty matrix cannot be a magic square. Design implicitly assumes non-empty.\n\n    # Calculate the magic constant from the sum of the first row\n    magic_sum = sum(matrix[0])\n\n    # Check row sums\n    for i in range(n):\n        if sum(matrix[i]) != magic_sum:\n            return False\n\n    # Check column sums\n    for j in range(n):\n        current_col_sum = 0\n        for i in range(n):\n            current_col_sum += matrix[i][j]\n        if current_col_sum != magic_sum:\n            return False\n\n    # Check main diagonal sum (top-left to bottom-right)\n    main_diag_sum = 0\n    for i in range(n):\n        main_diag_sum += matrix[i][i]\n    if main_diag_sum != magic_sum:\n        return False\n\n    # Check anti-diagonal sum (top-right to bottom-left)\n    anti_diag_sum = 0\n    for i in range(n):\n        anti_diag_sum += matrix[i][n - 1 - i]\n    if anti_diag_sum != magic_sum:\n        return False\n\n    return True"}
{"task_id": "Mbpp/127", "solution": "from typing import Any, Optional\n\nclass MultiplyError(Exception):\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\nclass InvalidOperandError(MultiplyError):\n    pass\n\nclass OperandOutOfRangeError(MultiplyError):\n    pass\n\nclass IntegerValue:\n    def __init__(self, value: int) -> None:\n        self._value = value\n\n    def __int__(self) -> int:\n        return self._value\n\n    def __repr__(self) -> str:\n        return f\"IntegerValue({self._value})\"\n\nMAX_ABS_OPERAND: int = 10**100\n\ndef validate_integer(value: Any, name: str = \"operand\", max_abs: Optional[int] = None) -> IntegerValue:\n    \"\"\"Validates if a value is an integer and within absolute bounds.\"\"\"\n    if not isinstance(value, int):\n        raise InvalidOperandError(f\"{name} must be int, got {type(value).__name__}\")\n    if max_abs is not None and abs(value) > max_abs:\n        raise OperandOutOfRangeError(f\"{name} absolute value must be <= {max_abs}\")\n    return IntegerValue(value)\n\nclass MultiplierService:\n    def __init__(self, max_abs_operand: Optional[int] = None) -> None:\n        self._max_abs_operand = max_abs_operand if max_abs_operand is not None else MAX_ABS_OPERAND\n\n    def multiply(self, a: int, b: int) -> int:\n        \"\"\"Performs integer multiplication with input validation.\"\"\"\n        va: IntegerValue = validate_integer(a, 'a', self._max_abs_operand)\n        vb: IntegerValue = validate_integer(b, 'b', self._max_abs_operand)\n        return int(va) * int(vb)\n\nclass MultiplyController:\n    def __init__(self, service: \"MultiplierService\") -> None:\n        self._service = service\n\n    def multiply(self, a: int, b: int) -> int:\n        \"\"\"Orchestrates multiplication, handling service calls and error wrapping.\"\"\"\n        try:\n            return self._service.multiply(a, b)\n        except MultiplyError:\n            raise\n        except Exception as exc:\n            raise MultiplyError(f\"Unexpected error during multiplication: {exc}\") from exc\n\n_service = MultiplierService()\n_controller = MultiplyController(_service)\n\ndef multiply_int(a: int, b: int) -> int:\n    \"\"\"Multiplies two integers, ensuring type and range validity.\"\"\"\n    return _controller.multiply(a, b)"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(sequence):\n    \"\"\"\n    Finds the item with the maximum frequency in a given list, applying tie-breaking rules.\n    If multiple items share the maximum frequency, the numerically smallest is preferred;\n    otherwise, the first-seen item in the original sequence is returned.\n    \"\"\"\n    counts = {}\n    for item in sequence:\n        counts[item] = counts.get(item, 0) + 1\n\n    if not counts:\n        return None\n\n    max_count = max(counts.values())\n    candidates = [item for item, count in counts.items() if count == max_count]\n\n    if len(candidates) == 1:\n        return candidates[0]\n    else:\n        try:\n            # Attempt to find the minimum among candidates; this works if they are mutually comparable.\n            return min(candidates)\n        except TypeError:\n            # If candidates are not mutually comparable, return the first one seen in the original sequence.\n            for item_in_seq in sequence:\n                if item_in_seq in candidates:\n                    return item_in_seq"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    \"\"\"Reverses only the vowels in a given string, where 'y' is not considered a vowel.\"\"\"\n    VOWELS = \"aeiouAEIOU\"\n    \n    # Collect all vowels from the string in their original order\n    vowels_in_s = [char for char in s if char in VOWELS]\n    \n    # Reverse the list of collected vowels\n    vowels_in_s.reverse()\n    \n    # Create an iterator for the reversed vowels\n    vowel_iter = iter(vowels_in_s)\n    \n    # Build the new string, replacing original vowels with the reversed ones\n    result_chars = []\n    for char in s:\n        if char in VOWELS:\n            result_chars.append(next(vowel_iter))\n        else:\n            result_chars.append(char)\n            \n    return \"\".join(result_chars)"}
