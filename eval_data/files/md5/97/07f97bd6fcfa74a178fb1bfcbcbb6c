{"task_id": "Mbpp/80", "solution": "def tetrahedral_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth tetrahedral number using the formula n*(n+1)*(n+2)/6.\n    Assumes the input 'n' is a positive integer (n >= 1).\n    \"\"\"\n    return (n * (n + 1) * (n + 2)) // 6"}
{"task_id": "Mbpp/75", "solution": "def find_tuples(input_list, k):\n    \"\"\"\n    Finds tuples from a list where all elements are divisible by k.\n    Returns a new list containing only the matching tuples.\n    \"\"\"\n    result = []\n    for current_tuple in input_list:\n        if all(element % k == 0 for element in current_tuple):\n            result.append(current_tuple)\n    return result"}
{"task_id": "Mbpp/77", "solution": "def is_Diff(n):\n    \"\"\"\n    Checks if a number is divisible by 11 using the alternating sum of digits method.\n    The alternating sum of digits is calculated from left to right, adding the first digit,\n    subtracting the second, adding the third, and so on.\n    \"\"\"\n    # Convert input n to an integer, take its absolute value, and then convert to a string of digits.\n    # This ensures the algorithm works with positive digit strings, regardless of the input's sign or type (int/str).\n    number_as_int = int(n)\n    s = str(abs(number_as_int))\n    \n    total_alternating_sum = 0\n    \n    for idx, char_digit in enumerate(s):\n        digit = int(char_digit)\n        if idx % 2 == 0:  # Digits at even indices (0-based: first, third, etc.) are added\n            total_alternating_sum += digit\n        else:             # Digits at odd indices (1-based: second, fourth, etc.) are subtracted\n            total_alternating_sum -= digit\n            \n    # A number is divisible by 11 if its alternating sum of digits is divisible by 11.\n    return abs(total_alternating_sum) % 11 == 0"}
{"task_id": "Mbpp/82", "solution": "import math\n\ndef volume_sphere(radius):\n    \"\"\"\n    Calculate the volume of a sphere given its radius.\n    The formula used is (4/3) * pi * r^3.\n    \"\"\"\n    return (4/3) * math.pi * (radius ** 3)"}
{"task_id": "Mbpp/85", "solution": "import math\n\ndef surfacearea_sphere(radius: float) -> float:\n    \"\"\"Computes the surface area of a sphere given its radius using the formula 4 * pi * r^2.\"\"\"\n    return 4.0 * math.pi * (radius ** 2)"}
