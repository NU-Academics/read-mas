{"task_id": "Mbpp/260", "solution": "def newman_prime(n: int) -> int:\n    \"\"\"Calculates the nth Newman\u2013Shanks\u2013Williams sequence term S_n (zero-based).\"\"\"\n    if n == 0 or n == 1:\n        return 1\n    \n    s_prev2, s_prev1 = 1, 1 # Corresponds to S_0 and S_1\n    \n    for _ in range(2, n + 1):\n        s_current = 2 * s_prev1 + s_prev2\n        s_prev2 = s_prev1\n        s_prev1 = s_current\n        \n    return s_prev1"}
{"task_id": "Mbpp/262", "solution": "import json\nfrom typing import Any, Iterable, List, Tuple\n\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input to the splitting functions.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n    def __str__(self) -> str:\n        return f\"InvalidInputError: {self.message}\"\n\nclass SplitResult:\n    \"\"\"A data transfer object to hold the two parts of a split list.\"\"\"\n    def __init__(self, first: List[Any], second: List[Any]):\n        self.first = list(first)\n        self.second = list(second)\n\n    def to_tuple(self) -> Tuple[List[Any], List[Any]]:\n        \"\"\"Returns the split parts as a tuple of lists.\"\"\"\n        return (self.first, self.second)\n\n    def to_json(self) -> str:\n        \"\"\"Returns a JSON string representation of the split parts.\"\"\"\n        return json.dumps({\"first\": self.first, \"second\": self.second})\n\nclass InputValidator:\n    \"\"\"Provides static methods for validating and normalizing input values.\"\"\"\n    @staticmethod\n    def validate_list(value: Any) -> List[Any]:\n        \"\"\"Validates that the input is a list-like iterable and returns it as a list.\"\"\"\n        if isinstance(value, list):\n            return list(value)\n        if isinstance(value, tuple):\n            return list(value)\n        if isinstance(value, Iterable) and not isinstance(value, str):\n            try:\n                return list(value)\n            except TypeError:\n                raise InvalidInputError(\"Input list must be a list-like iterable.\")\n        raise InvalidInputError(\"Input list must be a list, tuple, or other non-string iterable.\")\n\n    @staticmethod\n    def validate_length(value: Any, max_len: int) -> int:\n        \"\"\"Validates the length parameter L, ensuring it's an int and within valid bounds.\"\"\"\n        if not isinstance(value, int):\n            raise InvalidInputError(f\"Length L must be an integer, got {type(value).__name__}.\")\n        if value < 0:\n            raise InvalidInputError(f\"Length L cannot be negative, got {value}.\")\n        return min(value, max_len)\n\nclass SplitService:\n    \"\"\"Encapsulates the core business logic for splitting lists.\"\"\"\n    def split(self, lst: Iterable[Any], L: int) -> SplitResult:\n        \"\"\"Splits an iterable into two lists based on a specified length L.\"\"\"\n        normalized_list = InputValidator.validate_list(lst)\n        max_list_len = len(normalized_list)\n        valid_L = InputValidator.validate_length(L, max_list_len)\n        \n        first_part = normalized_list[:valid_L]\n        second_part = normalized_list[valid_L:]\n        \n        return SplitResult(first_part, second_part)\n\ndef split_two_parts(lst, L):\n    \"\"\"\n    Splits a list-like iterable into two parts where the length of the first part is L.\n    Returns a tuple of two lists: (first_part, second_part).\n    \"\"\"\n    service = SplitService()\n    result = service.split(lst, L)\n    return result.to_tuple()"}
{"task_id": "Mbpp/259", "solution": "from typing import Sequence, Any, Tuple\n\ndef maximize_elements(a: Sequence[Sequence[Any]], b: Sequence[Sequence[Any]]) -> Tuple[Tuple[Any, ...], ...]:\n    \"\"\"\n    Computes the element-wise maximum of two sequences of tuples.\n    Assumes inputs are of equal outer and inner dimensions with comparable elements.\n    \"\"\"\n    # Convert input sequences to tuple of tuples for consistent processing and output type.\n    a_as_tuples = tuple(tuple(inner_seq) for inner_seq in a)\n    b_as_tuples = tuple(tuple(inner_seq) for inner_seq in b)\n\n    maximized_outer_elements = []\n    # Iterate through corresponding inner tuples from both input sequences.\n    for inner_tuple_a, inner_tuple_b in zip(a_as_tuples, b_as_tuples):\n        maximized_inner_elements = []\n        # For each pair of inner tuples, iterate through their corresponding elements.\n        for elem_a, elem_b in zip(inner_tuple_a, inner_tuple_b):\n            # Compute the maximum of the two elements using Python's built-in max.\n            maximized_inner_elements.append(max(elem_a, elem_b))\n        maximized_outer_elements.append(tuple(maximized_inner_elements))\n\n    return tuple(maximized_outer_elements)"}
{"task_id": "Mbpp/266", "solution": "class InvalidSideError(Exception):\n    \"\"\"Custom exception raised for invalid side length inputs.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nfrom typing import Any\n\ndef is_numeric(value: Any) -> bool:\n    \"\"\"Checks if a value is numeric (int or float) but not boolean.\"\"\"\n    return isinstance(value, (int, float)) and not isinstance(value, bool)\n\ndef validate_side(side: Any) -> None:\n    \"\"\"Validates the side length to be a non-negative numeric value.\"\"\"\n    if is_numeric(side):\n        val = float(side)\n    else:\n        try:\n            val = float(side)\n        except Exception:\n            raise InvalidSideError(\"Side must be a numeric value (int, float or numeric string)\")\n    if val < 0:\n        raise InvalidSideError(\"Side must be non-negative\")\n\nLATERAL_FACES: int = 4\n\nclass Cube:\n    \"\"\"Represents a cube with a given side length.\"\"\"\n    def __init__(self, side: float) -> None:\n        self.side: float = float(side)\n\n    def area_face(self) -> float:\n        \"\"\"Calculates the area of one face of the cube.\"\"\"\n        return self.side * self.side\n\nclass LateralSurfaceService:\n    \"\"\"Provides business logic for lateral surface area computation.\"\"\"\n    def compute(self, side: float) -> float:\n        \"\"\"Computes the lateral surface area of a cube given its side length.\"\"\"\n        cube = Cube(side)\n        return LATERAL_FACES * cube.area_face()\n\n    def compute_from_cube(self, cube: Cube) -> float:\n        \"\"\"Computes the lateral surface area from a Cube object.\"\"\"\n        return LATERAL_FACES * cube.area_face()\n\ndef lateralsurface_cube(side: float) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cube given its side length.\n    This function validates the input and computes the area as 4 * side^2.\n    \"\"\"\n    validate_side(side)\n    service = LateralSurfaceService()\n    return service.compute(float(side))"}
{"task_id": "Mbpp/265", "solution": "def list_split(input_list, n):\n    \"\"\"\n    Splits a list into n sublists, distributing elements by their original index modulo n.\n    Each sublist contains elements at indices i, i+n, i+2n, ... for its starting index i.\n    \"\"\"\n    result = []\n    for i in range(n):\n        result.append(list(input_list[i::n]))\n    return result"}
{"task_id": "Mbpp/269", "solution": "def ascii_value(char: str) -> int:\n    \"\"\"\n    Public API: returns the ASCII value for a single character.\n    Raises InvalidInputError for invalid input.\n    \"\"\"\n\n    class AsciiError(Exception):\n        def __init__(self, message: str):\n            self.message = message\n            super().__init__(message)\n\n    class InvalidInputError(AsciiError, ValueError):\n        def __init__(self, message: str, invalid_value=None):\n            self.invalid_value = invalid_value\n            super().__init__(message)\n\n    class AsciiValidator:\n        def validate_char(self, char: str) -> None:\n            if not isinstance(char, str):\n                raise InvalidInputError(\"Input must be a string\", invalid_value=char)\n            if len(char) != 1:\n                raise InvalidInputError(\"Input must be a single character\", invalid_value=char)\n\n    class AsciiService:\n        MAX_CHAR_LENGTH: int = 1\n\n        def compute(self, char: str) -> int:\n            return ord(char)\n\n    class AsciiController:\n        def __init__(self, validator: AsciiValidator, service: AsciiService) -> None:\n            self._validator = validator\n            self._service = service\n\n        def get_ascii(self, char: str) -> int:\n            self._validator.validate_char(char)\n            try:\n                return self._service.compute(char)\n            except Exception as exc:\n                # Wrap unexpected errors for clarity.\n                raise AsciiError(f\"Unexpected error computing ASCII: {exc}\") from exc\n\n    controller = AsciiController(AsciiValidator(), AsciiService())\n    return controller.get_ascii(char)"}
