{"task_id": "Mbpp/68", "solution": "def is_Monotonic(arr):\n    \"\"\"\n    Checks if an array is monotonic (either non-decreasing or non-increasing).\n    An array of length 0 or 1 is considered monotonic.\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    non_decreasing = True\n    non_increasing = True\n\n    for i in range(1, n):\n        if arr[i] < arr[i - 1]:\n            non_decreasing = False\n        if arr[i] > arr[i - 1]:\n            non_increasing = False\n\n        # If it's neither non-decreasing nor non-increasing, it's not monotonic\n        if not non_decreasing and not non_increasing:\n            return False\n\n    # If the loop completes, it's monotonic in at least one direction\n    return True"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Computes the nth Bell number, which represents the number of partitions of a set with n elements.\n    Uses the optimized Bell triangle algorithm, with O(n^2) time complexity.\n    \"\"\"\n    if n == 0:\n        return 1\n    row = [1]  # Represents B(0)\n    for i in range(1, n + 1):\n        # The first element of the new row is the last element of the previous row (Bell triangle property)\n        new_row = [row[-1]]\n        for j in range(1, i + 1):\n            # Each subsequent element is the sum of the element to its left in the current row\n            # and the element above it (at the same column index) in the previous row.\n            new_row.append(new_row[-1] + row[j - 1])\n        row = new_row\n    return row[0] # The Bell number B(n) is the first element of the final row (B(n,0))"}
{"task_id": "Mbpp/70", "solution": "def get_equal(collection: list[tuple]) -> bool:\n    \"\"\"\n    Checks if all tuples in the given collection have equal length.\n\n    Returns True for an empty collection.\n    \"\"\"\n    if not collection:\n        return True\n    \n    first_len = len(collection[0])\n    for item in collection:\n        if len(item) != first_len:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(haystack, needle, contiguous=True):\n    \"\"\"Checks if a list contains the given sublist, either contiguously or as a subsequence.\"\"\"\n\n    if not needle:\n        return True\n\n    if contiguous:\n        n = len(haystack)\n        m = len(needle)\n        if m > n:\n            return False\n        for i in range(n - m + 1):\n            if haystack[i : i + m] == needle:\n                return True\n        return False\n    else:\n        # Non-contiguous subsequence check using an iterator.\n        it = iter(haystack)\n        for p in needle:\n            for t in it:\n                if t == p:\n                    break\n            else:\n                return False\n        return True"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(items: Iterable[Any], *, key: Optional[Callable[[Any], Any]] = None, reverse: bool = False, shrink_factor: float = 1.3) -> List[Any]:\n    \"\"\"Sorts a list of elements using the Comb Sort algorithm.\n    This function orchestrates the sorting process using internal components.\n    \"\"\"\n\n    DEFAULT_SHRINK_FACTOR: float = 1.3\n\n    class ValidationError(Exception):\n        \"\"\"Exception raised for invalid input parameters.\"\"\"\n        pass\n\n    class SortError(Exception):\n        \"\"\"Exception raised for errors during the sorting process.\"\"\"\n        pass\n\n    @dataclass\n    class AlgorithmStats:\n        \"\"\"Dataclass to hold statistics about the sorting algorithm's execution.\"\"\"\n        comparisons: int = 0\n        swaps: int = 0\n        passes: int = 0\n\n    @dataclass\n    class SortRequest:\n        \"\"\"DTO for carrying sorting request parameters.\"\"\"\n        items: Iterable[Any]\n        key: Optional[Callable[[Any], Any]] = None\n        reverse: bool = False\n        shrink_factor: float = DEFAULT_SHRINK_FACTOR\n\n    @dataclass\n    class SortResult:\n        \"\"\"DTO for carrying sorting results and statistics.\"\"\"\n        sorted_items: List[Any]\n        stats: AlgorithmStats\n\n    def to_list(iterable: Iterable[Any]) -> List[Any]:\n        \"\"\"Converts an iterable to a list.\"\"\"\n        return list(iterable)\n\n    class CombSortAlgorithm:\n        \"\"\"Implements the Comb Sort algorithm to sort a list of elements.\"\"\"\n\n        def run(self, items_list: List[Any], shrink_factor: float = DEFAULT_SHRINK_FACTOR,\n                key: Optional[Callable[[Any], Any]] = None, reverse: bool = False) -> Tuple[List[Any], AlgorithmStats]:\n            \"\"\"Sorts a list using the Comb Sort algorithm and returns statistics.\"\"\"\n            if shrink_factor <= 1.0:\n                raise ValueError(\"shrink_factor must be greater than 1.0.\")\n            arr = list(items_list)  # operate on shallow copy\n            n = len(arr)\n            gap = n\n            swapped = True\n            stats = AlgorithmStats()\n            while gap > 1 or swapped:\n                gap = int(gap / shrink_factor) if gap > 1 else 1\n                swapped = False\n                stats.passes += 1\n                for i in range(0, n - gap):\n                    val_i = key(arr[i]) if key else arr[i]\n                    val_j = key(arr[i + gap]) if key else arr[i + gap]\n                    stats.comparisons += 1\n                    if (val_i > val_j and not reverse) or (val_i < val_j and reverse):\n                        arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                        stats.swaps += 1\n                        swapped = True\n            return arr, stats\n\n    class SortService:\n        \"\"\"Provides business logic for sorting requests.\"\"\"\n\n        def __init__(self, algorithm: CombSortAlgorithm):\n            \"\"\"Initializes the SortService with a CombSortAlgorithm instance.\"\"\"\n            self._algorithm = algorithm\n\n        def sort(self, request: SortRequest) -> SortResult:\n            \"\"\"Processes a SortRequest and returns a SortResult.\"\"\"\n            if request is None:\n                raise ValidationError(\"SortRequest cannot be None.\")\n            \n            items_list = to_list(request.items)\n            try:\n                sorted_items, stats = self._algorithm.run(\n                    items_list,\n                    shrink_factor=request.shrink_factor,\n                    key=request.key,\n                    reverse=request.reverse\n                )\n            except Exception as e:\n                # Wrap potential algorithm errors into SortError.\n                raise SortError(f\"Sorting failed: {e}\") from e\n            return SortResult(sorted_items=sorted_items, stats=stats)\n\n    class SortController:\n        \"\"\"Handles programmatic and CLI sorting requests.\"\"\"\n\n        def __init__(self, service: SortService):\n            \"\"\"Initializes the SortController with a SortService instance.\"\"\"\n            self._service = service\n\n        def handle_request(self, request: SortRequest) -> SortResult:\n            \"\"\"Dispatches a SortRequest to the service and returns the result.\"\"\"\n            return self._service.sort(request)\n\n    algo = CombSortAlgorithm()\n    service = SortService(algo)\n    controller = SortController(service)\n    req = SortRequest(items=items, key=key, reverse=reverse, shrink_factor=shrink_factor)\n    result = controller.handle_request(req)\n    return result.sorted_items"}
{"task_id": "Mbpp/72", "solution": "def dif_Square(n):\n    \"\"\"\n    Checks if an integer can be represented as the difference of two squares.\n    A number n can be represented as a difference of two squares if n is odd or n is a multiple of 4.\n    \"\"\"\n    if n % 2 != 0:\n        return True\n    return n % 4 == 0"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(pattern: list, seq: list) -> bool:\n    \"\"\"\n    Checks if two sequences follow the same bijective pattern mapping.\n    Assumes inputs are lists of hashable items and have the same length.\n    \"\"\"\n    if len(pattern) != len(seq):\n        return False\n\n    pat_to_seq_map = {}\n    seq_to_pat_map = {}\n\n    for i in range(len(pattern)):\n        p_char = pattern[i]\n        s_char = seq[i]\n\n        # Check pattern to sequence mapping\n        if p_char in pat_to_seq_map:\n            if pat_to_seq_map[p_char] != s_char:\n                return False\n        else:\n            pat_to_seq_map[p_char] = s_char\n\n        # Check sequence to pattern mapping (bijective check)\n        if s_char in seq_to_pat_map:\n            if seq_to_pat_map[s_char] != p_char:\n                return False\n        else:\n            seq_to_pat_map[s_char] = p_char\n\n    return True"}
