{"task_id": "Mbpp/12", "solution": "from typing import List\n\ndef compute_row_sum(row: List[float]) -> float:\n    \"\"\"Computes the sum of elements in a row.\"\"\"\n    s = 0.0\n    for e in row:\n        s += float(e)\n    return s\n\ndef sort_matrix(matrix: List[List[int]]) -> List[List[int]]:\n    \"\"\"\n    Sorts a matrix by the sum of its rows in ascending order.\n    Returns a new matrix, preserving the stability of the original order for rows with equal sums.\n    \"\"\"\n    sorted_rows = sorted(matrix, key=lambda r: compute_row_sum(r))\n    return [list(row) for row in sorted_rows]"}
{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(source: str, filter: str) -> str:\n    \"\"\"Removes characters from the source string that are present in the filter string.\"\"\"\n    if not filter:\n        return source\n    remove_set = set(filter)\n    out_chars = [c for c in source if c not in remove_set]\n    return \"\".join(out_chars)"}
{"task_id": "Mbpp/14", "solution": "import datetime\n\nclass Validators:\n    \"\"\"Utility class for validating input measures.\"\"\"\n    @staticmethod\n    def is_positive_number(value) -> bool:\n        \"\"\"Checks if a value is a non-negative number.\"\"\"\n        try:\n            v = float(value)\n            return v >= 0\n        except Exception:\n            return False\n\n    @staticmethod\n    def validate_measure(name: str, value) -> float:\n        \"\"\"Validates if a value is a non-negative number and converts it to float.\"\"\"\n        try:\n            v = float(value)\n        except Exception:\n            raise ValueError(f\"{name} must be a number\")\n        if v < 0:\n            raise ValueError(f\"{name} must be non-negative\")\n        return v\n\nclass TriangleModel:\n    \"\"\"Represents the triangular base of a prism and computes its area.\"\"\"\n    def __init__(self, base: float, height: float) -> None:\n        if base < 0 or height < 0:\n            raise ValueError(\"Triangle base and height must be non-negative\")\n        self._base = float(base)\n        self._height = float(height)\n\n    def area(self) -> float:\n        \"\"\"Calculates the area of the triangle.\"\"\"\n        return 0.5 * self._base * self._height\n\nclass PrismModel:\n    \"\"\"Represents a triangular prism, composed of a TriangleModel and a length.\"\"\"\n    def __init__(self, triangle: TriangleModel, length: float) -> None:\n        if length < 0:\n            raise ValueError(\"Prism length must be non-negative\")\n        self._triangle = triangle\n        self._length = float(length)\n\n    def volume(self) -> float:\n        \"\"\"Calculates the volume of the prism.\"\"\"\n        return self._triangle.area() * self._length\n\nclass VolumeDTO:\n    \"\"\"Data Transfer Object for volume computation results.\"\"\"\n    def __init__(self, area: float, volume: float, inputs: dict, timestamp: str = None) -> None:\n        self.area = float(area)\n        self.volume = float(volume)\n        self.inputs = inputs\n        self.timestamp = timestamp or datetime.datetime.utcnow().isoformat()\n\n    def to_dict(self) -> dict:\n        \"\"\"Converts the DTO to a dictionary for serialization.\"\"\"\n        return {\"inputs\": self.inputs, \"area\": self.area, \"volume\": self.volume, \"timestamp\": self.timestamp}\n\nclass VolumeService:\n    \"\"\"Provides business logic for computing triangular prism volume.\"\"\"\n    def __init__(self, repo=None) -> None:\n        self._repo = repo # repo is optional and not used by find_Volume\n\n    def compute_volume(self, base: float, tri_height: float, length: float) -> VolumeDTO:\n        \"\"\"Computes the volume of a triangular prism with input validation.\"\"\"\n        b = Validators.validate_measure(\"base\", base)\n        h = Validators.validate_measure(\"tri_height\", tri_height)\n        l = Validators.validate_measure(\"length\", length)\n\n        triangle = TriangleModel(b, h)\n        prism = PrismModel(triangle, l)\n\n        area = triangle.area()\n        vol = prism.volume()\n\n        dto = VolumeDTO(area=area, volume=vol, inputs={\"base\": b, \"tri_height\": h, \"length\": l})\n        # If a repository was provided, save the computation.\n        if self._repo:\n            self._repo.save(dto.to_dict())\n        return dto\n\ndef find_Volume(base: float, tri_height: float, length: float) -> float:\n    \"\"\"\n    Finds the volume of a triangular prism given its base, triangle height, and prism length.\n    All inputs must be non-negative numbers.\n    \"\"\"\n    svc = VolumeService()\n    dto = svc.compute_volume(base, tri_height, length)\n    # Return an integer if the volume is an exact integer, otherwise a float.\n    return int(dto.volume) if dto.volume.is_integer() else dto.volume"}
{"task_id": "Mbpp/19", "solution": "```python\ndef test_duplicate(nums):\n    \"\"\"\n    Checks if an array of integers contains any duplicate element using a set for O(n) average time complexity.\n    \"\"\"\n    seen = set()\n    for num in nums:\n        if num in seen:\n            return True\n        seen.add(num)\n    return False\n```"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"\n    Checks if a given number is a Woodall number, defined as n * 2^n - 1 for some integer n >= 1.\n    It iterates through possible values of n to find a match.\n    \"\"\"\n    if number < 0:\n        return False\n\n    # We are looking for an integer n >= 1 such that n * 2^n - 1 == number.\n    # This is equivalent to n * 2^n == number + 1.\n    target_value = number + 1\n\n    n = 1\n    # Iterate to find n. An upper bound (e.g., n > 1024) is used to prevent excessively long computations for large inputs.\n    while True:\n        current_woodall_term = n * (1 << n) # Calculate n * 2^n using bit shift for efficiency\n\n        if current_woodall_term == target_value:\n            return True\n        \n        # If the term exceeds the target, or n becomes very large without finding a match,\n        # it's not a Woodall number. The limit 1024 is an arbitrary practical bound.\n        if current_woodall_term > target_value or n > 1024:\n            return False\n        \n        n += 1"}
{"task_id": "Mbpp/56", "solution": "class InvalidNumberError(Exception):\n    \"\"\"Custom exception for invalid number inputs.\"\"\"\n    pass\n\nclass ReverseUtils:\n    \"\"\"Utility functions for number reversal and validation.\"\"\"\n    DEFAULT_BASE = 10\n\n    @staticmethod\n    def is_integer(obj) -> bool:\n        \"\"\"Checks if the given object is an integer and not a boolean.\"\"\"\n        return isinstance(obj, int) and not isinstance(obj, bool)\n\n    @staticmethod\n    def reverse_int(n: int) -> int:\n        \"\"\"Reverses the digits of a non-negative integer.\"\"\"\n        if n < 0:\n            raise ValueError(\"reverse_int expects non-negative integer\")\n        rev = 0\n        while n:\n            rev = rev * ReverseUtils.DEFAULT_BASE + (n % ReverseUtils.DEFAULT_BASE)\n            n //= ReverseUtils.DEFAULT_BASE\n        return rev\n\nfrom datetime import datetime\n\nclass Number:\n    \"\"\"Domain model for numeric operations, including reversing its digits.\"\"\"\n    def __init__(self, value: int) -> None:\n        if not ReverseUtils.is_integer(value):\n            raise InvalidNumberError(\"value must be int\")\n        self.value: int = value\n\n    def get_abs(self) -> int:\n        \"\"\"Returns the absolute value of the number.\"\"\"\n        return abs(self.value)\n\n    def reverse(self) -> int:\n        \"\"\"Returns the digit-wise reverse of the absolute value.\"\"\"\n        return ReverseUtils.reverse_int(self.get_abs())\n\n    def to_dict(self) -> dict:\n        \"\"\"Serializes the number's details for persistence.\"\"\"\n        return {\n            \"input\": self.value,\n            \"reversed\": self.reverse(),\n            \"timestamp\": datetime.utcnow().isoformat() + \"Z\",\n        }\n\nclass CheckService:\n    \"\"\"Core business logic to check if a number meets the specified condition.\"\"\"\n    def __init__(self, repo=None) -> None:\n        self._repo = repo\n\n    def is_one_less_than_twice_reverse(self, n: int) -> bool:\n        \"\"\"Determines if n is one less than twice its reverse.\"\"\"\n        num = Number(n)\n        r = num.reverse()\n        expected = 2 * r - 1\n        result = (expected == n)\n        # Persistence is disabled for this `_service` instance as `repo` is None.\n        return result\n\n_service = CheckService()\n\ndef check(n):\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    The check uses an internal service for calculation and validation.\n    \"\"\"\n    return _service.is_one_less_than_twice_reverse(n)"}
