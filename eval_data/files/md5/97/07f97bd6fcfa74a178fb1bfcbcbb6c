{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(n):\n    \"\"\"\n    Checks if an integer can be represented as a sum of powers 2^k where k >= 1.\n    This is true for any even integer greater than 1.\n    \"\"\"\n    if n <= 1:\n        return False\n    # A number is a sum of non-zero powers of two if its least significant bit is 0,\n    # meaning all '1' bits are at positions corresponding to exponents 1 or greater.\n    return (n & 1) == 0"}
{"task_id": "Mbpp/133", "solution": "from typing import Iterable, List, Any, Iterator, Optional\n\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input.\n    Provides a custom message for clarity.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n    def __str__(self) -> str:\n        return self.message\n\nclass NumberList:\n    \"\"\"An immutable value object holding a sanitized list of floats.\n    Provides basic iterable functionality.\"\"\"\n    def __init__(self, numbers: List[float]) -> None:\n        self.numbers = list(numbers) # Defensive copy\n\n    def __iter__(self) -> Iterator[float]:\n        return iter(self.numbers)\n\n    def __len__(self) -> int:\n        return len(self.numbers)\n\n    def as_list(self) -> List[float]:\n        return list(self.numbers) # Return shallow copy\n\nclass InputValidator:\n    \"\"\"Validates and coerces incoming iterables into a NumberList.\n    Handles type checking and optional string to float conversion.\"\"\"\n    def validate(self, numbers: Iterable[Any], allow_str_coercion: bool = True) -> NumberList:\n        if numbers is None:\n            raise InvalidInputError(\"numbers cannot be None\")\n        \n        if not isinstance(numbers, Iterable):\n             raise InvalidInputError(\"numbers must be an iterable\")\n\n        out: List[float] = []\n        for i, v in enumerate(numbers):\n            try:\n                if isinstance(v, str) and not allow_str_coercion:\n                    raise ValueError(\"string coercion not allowed for this element\")\n                \n                out.append(self._coerce_to_number(v))\n            except (ValueError, TypeError) as e:\n                raise InvalidInputError(f\"element at index {i} is not numeric: {v!r} (Error: {e})\")\n        return NumberList(out)\n\n    def _coerce_to_number(self, value: Any) -> float:\n        \"\"\"Converts a value to float if it's an int, float, or numeric string.\"\"\"\n        if isinstance(value, (int, float)):\n            return float(value)\n        if isinstance(value, str):\n            try:\n                return float(value.strip())\n            except ValueError:\n                raise ValueError(\"string is not a valid number format\")\n        raise ValueError(\"value cannot be coerced to a number\")\n\nclass SumNegativeService:\n    \"\"\"Provides the core business logic to sum negative numbers.\"\"\"\n    def sum_negative(self, number_list: NumberList) -> float:\n        total: float = 0.0\n        for v in number_list:\n            if v < 0.0:\n                total += v\n        return total\n\nclass SumNegativeController:\n    \"\"\"Orchestrates the validation and summing process.\n    Injects validator and service dependencies.\"\"\"\n    def __init__(self, validator: Optional['InputValidator'] = None, service: Optional['SumNegativeService'] = None) -> None:\n        self.validator = validator if validator is not None else InputValidator()\n        self.service = service if service is not None else SumNegativeService()\n\n    def compute(self, numbers: Iterable[Any], allow_str_coercion: bool = True) -> float:\n        number_list = self.validator.validate(numbers, allow_str_coercion=allow_str_coercion)\n        result = self.service.sum_negative(number_list)\n        return result\n\ndef sum_negativenum(numbers: Iterable[Any], allow_str_coercion: bool = True) -> float:\n    \"\"\"\n    Calculates the sum of negative numbers in a given list.\n    It validates input, optionally coerces numeric strings, and sums values less than zero.\n    \"\"\"\n    controller = SumNegativeController()\n    return controller.compute(numbers, allow_str_coercion=allow_str_coercion)"}
{"task_id": "Mbpp/137", "solution": "def zero_count(array: list[int]) -> float:\n    \"\"\"\n    Calculates the ratio of zeroes to non-zeroes in a list of integers.\n    Returns 0.0 if there are no non-zero elements to avoid division by zero.\n    \"\"\"\n    zeroes = 0\n    non_zeroes = 0\n    for x in array:\n        if x == 0:\n            zeroes += 1\n        else:\n            non_zeroes += 1\n    return zeroes / non_zeroes if non_zeroes != 0 else 0.0"}
