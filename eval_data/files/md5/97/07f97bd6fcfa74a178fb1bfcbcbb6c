{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts the number of substrings where the sum of digits equals their length.\n    It uses a prefix sum technique with a digit transformation to achieve O(n) time complexity.\n    \"\"\"\n    from collections import defaultdict\n    from typing import List\n\n    def transform_digits(input_str: str) -> List[int]:\n        \"\"\"Transforms each digit d in the string to (d-1) for prefix sum calculation.\"\"\"\n        return [int(ch) - 1 for ch in input_str]\n\n    def prefix_count_transformed(arr: List[int]) -> int:\n        \"\"\"Counts subarrays summing to zero using prefix sums and a frequency map.\"\"\"\n        counts = defaultdict(int)\n        prefix_sum = 0\n        counts[0] = 1  # Initialize for subarrays starting from index 0\n        result_count = 0\n        for val in arr:\n            prefix_sum += val\n            result_count += counts[prefix_sum]\n            counts[prefix_sum] += 1\n        return result_count\n    \n    if not s:\n        return 0\n\n    transformed_array = transform_digits(s)\n    return prefix_count_transformed(transformed_array)"}
{"task_id": "Mbpp/62", "solution": "def smallest_num(numbers):\n    \"\"\"\n    Finds the smallest number in a list of numbers.\n    Assumes the input list contains at least one numeric element.\n    \"\"\"\n    # Initialize smallest with the first element\n    it = iter(numbers)\n    smallest = next(it)\n\n    # Iterate through the rest of the list to find the minimum\n    for v in it:\n        if v < smallest:\n            smallest = v\n    return smallest"}
{"task_id": "Mbpp/64", "solution": "def subject_marks(items, order=\"asc\"):\n    \"\"\"\n    Sorts a list of tuples using the second value of each tuple.\n    The sorting order can be specified as 'asc' for ascending or 'desc' for descending.\n    \"\"\"\n    reverse_sort = (order == \"desc\")\n    \n    return sorted(items, key=lambda x: x[1], reverse=reverse_sort)"}
{"task_id": "Mbpp/63", "solution": "import ast\n\nclass InvalidInputError(Exception):\n    \"\"\"Raised when input validation fails.\"\"\"\n    pass\n\ndef _validate_and_normalize_pairs(data: any) -> list[tuple[float, float]]:\n    \"\"\"\n    Validates raw input data and normalizes it into a list of 2-float tuples.\n    Raises InvalidInputError for malformed inputs.\n    \"\"\"\n    if isinstance(data, str):\n        try:\n            data = ast.literal_eval(data)\n        except (ValueError, SyntaxError) as e:\n            raise InvalidInputError(f\"Invalid string representation of pairs: {e}\")\n\n    if not hasattr(data, '__iter__'):\n        raise InvalidInputError(\"Input must be an an iterable of pairs\")\n    \n    normalized = []\n    for idx, elem in enumerate(data):\n        if not (isinstance(elem, (list, tuple)) and len(elem) == 2):\n            raise InvalidInputError(f\"Element {idx} is not a 2-tuple or list: {elem}\")\n        \n        a, b = elem\n        if not (isinstance(a, (int, float)) and isinstance(b, (int, float))):\n            raise InvalidInputError(f\"Non-numeric elements at index {idx}: ({a}, {b})\")\n        \n        normalized.append((float(a), float(b)))\n    \n    if not normalized:\n        raise InvalidInputError(\"At least one pair is required.\")\n        \n    return normalized\n\ndef max_difference(pairs_raw) -> float:\n    \"\"\"\n    Calculates the maximum absolute difference between numbers in given pairs.\n    It validates and normalizes the input before computation.\n    \"\"\"\n    normalized_pairs = _validate_and_normalize_pairs(pairs_raw)\n\n    max_diff_val = 0.0\n    # Since normalized_pairs is guaranteed to be non-empty by validation, \n    # we can initialize max_diff_val with the first pair's difference.\n    # Alternatively, start with None and handle the first assignment.\n    # For robustness, using None is better as it handles potentially large negative diffs if abs() was not used.\n    \n    first_pair = normalized_pairs[0]\n    max_diff_val = abs(first_pair[0] - first_pair[1])\n\n    for i in range(1, len(normalized_pairs)):\n        a, b = normalized_pairs[i]\n        current_diff = abs(a - b)\n        if current_diff > max_diff_val:\n            max_diff_val = current_diff\n            \n    return float(max_diff_val)"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(data: list) -> float:\n    \"\"\"Flattens a list and sums all of its numeric elements.\"\"\"\n\n    from typing import Any, Iterator, List\n\n    class InvalidElementError(ValueError):\n        \"\"\"Raised when an unsupported element type is encountered during flattening.\"\"\"\n        pass\n\n    class SumResult:\n        \"\"\"A data class to hold the total sum and count of numeric elements.\"\"\"\n        def __init__(self, total: float, count: int) -> None:\n            self.total = total\n            self.count = count\n\n    class ListFlattenerUtil:\n        \"\"\"Utility to flatten nested lists and yield numeric elements.\"\"\"\n        def __init__(self, allow_bools: bool = True) -> None:\n            self.allow_bools = allow_bools\n\n        def is_number(self, value: Any) -> bool:\n            \"\"\"Checks if a value is a number (int or float), respecting bools.\"\"\"\n            return isinstance(value, (int, float)) and (self.allow_bools or not isinstance(value, bool))\n\n        def flatten(self, data: List[Any]) -> Iterator[float]:\n            \"\"\"Recursively yields numeric values from nested lists or tuples.\"\"\"\n            stack = [iter(data)]\n            while stack:\n                try:\n                    item = next(stack[-1])\n                except StopIteration:\n                    stack.pop()\n                    continue\n\n                if isinstance(item, (list, tuple)):\n                    stack.append(iter(item))\n                elif self.is_number(item):\n                    yield float(item)\n                else:\n                    raise InvalidElementError(f\"Unsupported element encountered: {repr(item)}\")\n\n    class RecursiveListService:\n        \"\"\"Core business logic for summing elements in nested lists.\"\"\"\n        def __init__(self, flattener: ListFlattenerUtil) -> None:\n            self.flattener = flattener\n\n        def recursive_list_sum(self, data: list) -> SumResult:\n            \"\"\"Flattens a list and sums its numeric elements.\"\"\"\n            total = 0.0\n            count = 0\n            for value in self.flattener.flatten(data):\n                total += value\n                count += 1\n            return SumResult(total=total, count=count)\n\n    service = RecursiveListService(ListFlattenerUtil())\n    result = service.recursive_list_sum(data)\n    return result.total"}
