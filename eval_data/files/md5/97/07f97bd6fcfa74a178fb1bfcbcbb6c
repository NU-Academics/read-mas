{"task_id": "Mbpp/253", "solution": "from typing import Any, Sequence\nfrom collections.abc import Sequence as SeqABC\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to the library functions.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass ListValidator:\n    \"\"\"Validates list inputs and checks element types.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def validate_list(self, items: Any) -> None:\n        \"\"\"Ensures items is a sequence but not a string or bytes.\"\"\"\n        if not isinstance(items, SeqABC) or isinstance(items, (str, bytes)):\n            raise InvalidInputError(\"Input must be a sequence (list/tuple), not string or other type\")\n\n    def is_integer_element(self, el: Any) -> bool:\n        \"\"\"Returns True if the element is an exact integer type (not bool).\"\"\"\n        return type(el) is int\n\nclass CountService:\n    \"\"\"Contains the business logic for counting integers.\"\"\"\n    def __init__(self) -> None:\n        self._validator = ListValidator()\n\n    def count_integers(self, items: Sequence[Any]) -> int:\n        \"\"\"Counts the number of integer elements in a sequence.\"\"\"\n        count = 0\n        for el in items:\n            if self._validator.is_integer_element(el):\n                count += 1\n        return count\n\nclass APIFacade:\n    \"\"\"Public facade for counting integers, coordinating validator and service.\"\"\"\n    def __init__(self, service: CountService = None, validator: ListValidator = None) -> None:\n        self.service = service or CountService()\n        self.validator = validator or ListValidator()\n\n    def count_integer(self, items: Sequence[Any]) -> int:\n        \"\"\"Validates input items and returns the count of integer elements.\"\"\"\n        self.validator.validate_list(items)\n        return self.service.count_integers(items)\n\ndef count_integer(items: Sequence[Any]) -> int:\n    \"\"\"\n    Returns the number of integer elements in a given list.\n    Only exact 'int' types (excluding 'bool') are counted.\n    \"\"\"\n    facade = APIFacade()\n    return facade.count_integer(items)"}
{"task_id": "Mbpp/252", "solution": "import math\n\ndef convert(value):\n    \"\"\"Converts a complex number or numeric input to polar coordinates (r, theta).\"\"\"\n    z = complex(value)\n    x, y = z.real, z.imag\n    r = math.hypot(x, y)\n    theta = math.atan2(y, x)\n\n    # If the magnitude is very close to zero, set theta to 0.0 as per design.\n    EPSILON_ZERO = 1e-12\n    if abs(r) < EPSILON_ZERO:\n        theta = 0.0\n\n    return (float(r), float(theta))"}
{"task_id": "Mbpp/255", "solution": "def combinations_colors(elements: list, n: int) -> list[tuple]:\n    \"\"\"\n    Generates all combinations with repetition of elements from the input list for a given length n.\n    Each combination is returned as a tuple in a list.\n    \"\"\"\n    if n == 0:\n        return [()]\n    if not elements:\n        return []\n\n    # Use an iterative index-based approach to generate combinations with repetition.\n    indices = [0] * n\n    result: list[tuple] = []\n    num_elements = len(elements)\n\n    while True:\n        # Construct the current combination using the current indices.\n        result.append(tuple(elements[i] for i in indices))\n\n        # Attempt to increment the rightmost possible index.\n        for i in reversed(range(n)):\n            if indices[i] + 1 < num_elements:\n                indices[i] += 1\n                # Reset all subsequent indices to the first element (index 0).\n                for j in range(i + 1, n):\n                    indices[j] = 0\n                break\n        else:\n            # All combinations have been generated (all indices are at their maximum).\n            break\n    return result"}
{"task_id": "Mbpp/256", "solution": "def count_Primes_nums(num: int) -> int:\n    \"\"\"\n    Counts the number of prime numbers less than the given non-negative number using the Sieve of Eratosthenes.\n    \"\"\"\n    if num <= 2:\n        return 0\n\n    # Initialize a bytearray where 1 means potentially prime, 0 means not prime.\n    # We need 'num' elements for numbers 0 to num-1.\n    is_prime = bytearray(b'\\x01') * num\n    is_prime[0] = is_prime[1] = 0 # 0 and 1 are not prime\n\n    # Iterate from p = 2 up to sqrt(num).\n    # If is_prime[p] is 1, then p is prime.\n    # Mark all multiples of p as not prime (0).\n    p = 2\n    while p * p < num:\n        if is_prime[p]:\n            # Mark multiples of p as not prime, starting from p*p.\n            # Multiples less than p*p would have already been marked by smaller primes.\n            for multiple in range(p * p, num, p):\n                is_prime[multiple] = 0\n        p += 1\n\n    # Count the number of primes (where is_prime[i] is 1).\n    return sum(is_prime)"}
