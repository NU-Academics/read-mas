{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m, n):\n    \"\"\"\n    Calculates the number of possible sequences of length n,\n    such that each element is a positive integer and is greater than or equal to twice the previous element but less than or equal to m.\n    \"\"\"\n    memo = {}\n\n    def _count_from(current_element, remaining_length):\n        \"\"\"\n        Recursively counts sequences of `remaining_length` elements\n        starting with `current_element`.\n        \"\"\"\n        if (current_element, remaining_length) in memo:\n            return memo[(current_element, remaining_length)]\n\n        if remaining_length == 1:\n            return 1\n\n        count_for_path = 0\n        next_min_val = 2 * current_element\n\n        if next_min_val > m:\n            memo[(current_element, remaining_length)] = 0\n            return 0\n\n        for next_element_val in range(next_min_val, m + 1):\n            count_for_path += _count_from(next_element_val, remaining_length - 1)\n\n        memo[(current_element, remaining_length)] = count_for_path\n        return count_for_path\n\n    if n == 1:\n        return m\n\n    total_sequences = 0\n    # The first element can be any integer from 1 to m.\n    for first_element_val in range(1, m + 1):\n        total_sequences += _count_from(first_element_val, n)\n\n    return total_sequences"}
{"task_id": "Mbpp/244", "solution": "import math\n\ndef next_Perfect_Square(n):\n    \"\"\"\n    Calculates the smallest perfect square strictly greater than the given number n.\n    Handles negative inputs and float values that are integer-like.\n    \"\"\"\n    if n < 0:\n        return 0\n\n    n_int = int(n)\n    k = math.isqrt(n_int)\n    return (k + 1) ** 2"}
{"task_id": "Mbpp/245", "solution": "def max_sum(arr: list) -> int:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence for the given array.\n    A sequence is bitonic if it is first increasing and then decreasing.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n\n    # _compute_increasing_sums computes the maximum sum of an increasing subsequence\n    # ending at each index, and the corresponding sequence.\n    def _compute_increasing_sums(arr_inner: list) -> tuple[list[int], list[list[int]]]:\n        inc_sum = list(arr_inner)\n        inc_seq = [[x] for x in arr_inner]\n\n        for i in range(1, n):\n            for j in range(i):\n                if arr_inner[j] < arr_inner[i]:\n                    if inc_sum[j] + arr_inner[i] > inc_sum[i]:\n                        inc_sum[i] = inc_sum[j] + arr_inner[i]\n                        inc_seq[i] = inc_seq[j] + [arr_inner[i]]\n        return inc_sum, inc_seq\n\n    # _compute_decreasing_sums computes the maximum sum of a decreasing subsequence\n    # starting at each index, and the corresponding sequence.\n    def _compute_decreasing_sums(arr_inner: list) -> tuple[list[int], list[list[int]]]:\n        dec_sum = list(arr_inner)\n        dec_seq = [[x] for x in arr_inner]\n\n        for i in range(n - 2, -1, -1):\n            for j in range(i + 1, n):\n                if arr_inner[j] < arr_inner[i]:\n                    if dec_sum[j] + arr_inner[i] > dec_sum[i]:\n                        dec_sum[i] = dec_sum[j] + arr_inner[i]\n                        dec_seq[i] = [arr_inner[i]] + dec_seq[j]\n        return dec_sum, dec_seq\n\n    inc_sum, _ = _compute_increasing_sums(arr)\n    dec_sum, _ = _compute_decreasing_sums(arr)\n\n    max_bitonic_sum = float(\"-inf\")\n\n    for i in range(n):\n        # The sum for a bitonic subsequence peaking at arr[i]\n        # is the sum of the longest increasing subsequence ending at arr[i]\n        # plus the sum of the longest decreasing subsequence starting at arr[i],\n        # minus arr[i] itself (to avoid double counting the peak element).\n        current_bitonic_sum = inc_sum[i] + dec_sum[i] - arr[i]\n        if current_bitonic_sum > max_bitonic_sum:\n            max_bitonic_sum = current_bitonic_sum\n\n    return max_bitonic_sum"}
{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"\n    Finds the length of the longest palindromic subsequence using dynamic programming.\n    This implementation uses O(n^2) time complexity and O(n) space complexity.\n    \"\"\"\n    n = len(s)\n    if n == 0:\n        return 0\n\n    # Compute LCS (Longest Common Subsequence) of s and its reverse.\n    # This is equivalent to finding the LPS of s.\n    rev_s = s[::-1]\n\n    # prev stores the DP values for the previous row (i-1)\n    # curr stores the DP values for the current row (i)\n    prev = [0] * (n + 1)\n    curr = [0] * (n + 1)\n\n    for i in range(1, n + 1):\n        for j in range(1, n + 1):\n            if s[i - 1] == rev_s[j - 1]:\n                curr[j] = prev[j - 1] + 1\n            else:\n                curr[j] = max(prev[j], curr[j - 1])\n        # After completing a row, the current row becomes the previous row for the next iteration.\n        prev = list(curr) # Create a copy to avoid modification issues\n        # No need to reset curr, it will be overwritten in the next iteration\n\n    return prev[n]"}
