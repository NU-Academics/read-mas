{"task_id": "Mbpp/105", "solution": "from typing import Iterable, List, Any, Optional\n\nclass InvalidInputError(ValueError):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass ElementTypeError(TypeError):\n    def __init__(self, message: str, index: int, value: Any):\n        super().__init__(message)\n        self.index = index\n        self.value = value\n\ndef validate_iterable(obj: Any) -> Iterable[Any]:\n    \"\"\"Confirms obj is iterable; if not, raise InvalidInputError.\"\"\"\n    try:\n        iter(obj)\n    except TypeError:\n        raise InvalidInputError(\"Provided value is not iterable\")\n    return obj\n\ndef is_bool(value: Any) -> bool:\n    \"\"\"Returns True iff value is strictly a bool.\"\"\"\n    return type(value) is bool\n\nclass InMemoryRepository:\n    def __init__(self) -> None:\n        self._records: List[int] = []\n\n    def record(self, count: int) -> None:\n        self._records.append(count)\n\n    def get_records(self) -> List[int]:\n        return list(self._records)\n\nclass BoolList:\n    def __init__(self, values: Iterable[Any]) -> None:\n        self._raw_values = values\n        self.values: List[bool] = []\n\n    def validate(self) -> None:\n        iterable = validate_iterable(self._raw_values)\n        self.values = []\n        for i, v in enumerate(iterable):\n            if not is_bool(v):\n                raise ElementTypeError(f\"Element at index {i} is not bool\", index=i, value=v)\n            self.values.append(v)\n\nclass CountService:\n    def __init__(self, repository: Optional[InMemoryRepository] = None) -> None:\n        self._repository = repository\n\n    def count_true(self, values: List[bool]) -> int:\n        count = sum(1 for v in values if v is True)\n        if self._repository:\n            self._repository.record(count)\n        return count\n\nclass CounterController:\n    def __init__(self, service: CountService) -> None:\n        self._service = service\n\n    def count(self, values: Iterable[Any]) -> int:\n        dto = BoolList(values)\n        dto.validate()\n        return self._service.count_true(dto.values)\n\ndef count(values: Iterable[Any]) -> int:\n    \"\"\"Counts strictly boolean True values in the provided iterable.\"\"\"\n    repo = InMemoryRepository()\n    service = CountService(repository=repo)\n    controller = CounterController(service=service)\n    return controller.count(values)"}
{"task_id": "Mbpp/108", "solution": "import heapq\n\ndef merge_sorted_list(a, b, c):\n    # Sort each input list individually.\n    sorted_a = sorted(list(a))\n    sorted_b = sorted(list(b))\n    sorted_c = sorted(list(c))\n\n    lists_to_merge = [sorted_a, sorted_b, sorted_c]\n    heap = []\n    result = []\n\n    # Initialize the min-heap with the first element from each sorted list.\n    for list_idx, current_list in enumerate(lists_to_merge):\n        if current_list:\n            heapq.heappush(heap, (current_list[0], list_idx, 0)) # (value, list_index, element_index)\n\n    # Perform k-way merge using the min-heap.\n    while heap:\n        val, list_idx, element_idx = heapq.heappop(heap)\n        result.append(val)\n\n        # If there are more elements in the list from which the value was popped,\n        # add the next element to the heap.\n        next_element_idx = element_idx + 1\n        if next_element_idx < len(lists_to_merge[list_idx]):\n            next_val = lists_to_merge[list_idx][next_element_idx]\n            heapq.heappush(heap, (next_val, list_idx, next_element_idx))\n\n    return result"}
{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(s: str, k: int) -> int:\n    \"\"\"\n    Counts how many of the first k left-rotations of a binary string s result in an odd number.\n    A number is odd if its rightmost bit is '1'.\n    \"\"\"\n    n = len(s)\n    if n == 0 or k == 0:\n        return 0\n\n    # Count of '1's in the entire string. This represents the number of odd values\n    # encountered in one full cycle of 'n' rotations.\n    ones_count_in_string = s.count('1')\n\n    # Calculate full cycles and remaining rotations.\n    full_cycles = k // n\n    remainder_rotations = k % n\n\n    # Initialize count with odd numbers from full cycles.\n    count = full_cycles * ones_count_in_string\n\n    # Count odd rotations in the remaining prefix of rotations.\n    # For a left rotation `i`, the character at `s[(n - 1 + i) % n]` becomes the least significant bit.\n    for i in range(remainder_rotations):\n        lsb_original_idx = (n - 1 + i) % n\n        if s[lsb_original_idx] == '1':\n            count += 1\n            \n    return count"}
{"task_id": "Mbpp/116", "solution": "def tuple_to_int(values: tuple[int, ...]) -> int:\n    \"\"\"\n    Converts a tuple of positive integers into a single integer by concatenating their string representations.\n    An empty tuple converts to 0.\n    \"\"\"\n    if not values:\n        return 0\n    \n    string_parts = []\n    for num in values:\n        string_parts.append(str(num))\n    \n    combined_string = \"\".join(string_parts)\n    \n    return int(combined_string)"}
{"task_id": "Mbpp/113", "solution": "def check_integer(value: str, allow_sign: bool = True, allow_whitespace: bool = True) -> bool:\n    \"\"\"Checks if a string represents a valid decimal integer based on sign and whitespace options.\"\"\"\n    import re\n\n    processed_value = value.strip() if allow_whitespace else value\n    \n    # Determine the regex pattern based on whether signs are allowed.\n    # The patterns are derived from INTEGER_REGEX_NO_SIGN and INTEGER_REGEX_WITH_SIGN in utils.py.\n    pattern_string = r'^[+-]?\\d+$' if allow_sign else r'^\\d+$'\n    \n    # Compile the pattern and attempt a full match against the processed string.\n    pattern = re.compile(pattern_string)\n    return bool(pattern.fullmatch(processed_value))"}
{"task_id": "Mbpp/119", "solution": "def search(arr: list[int]) -> int:\n    \"\"\"\n    Finds the single element that appears only once in a sorted array\n    where all other elements appear exactly twice using binary search.\n    \"\"\"\n    n = len(arr)\n    low, high = 0, n - 1\n\n    while low < high:\n        mid = (low + high) // 2\n        # If mid is an even index\n        if mid % 2 == 0:\n            # If element at mid is part of a pair (arr[mid] == arr[mid+1]),\n            # the unique element must be to the right.\n            if arr[mid] == arr[mid + 1]:\n                low = mid + 2\n            # Otherwise, arr[mid] is unique or the unique element is to its left.\n            else:\n                high = mid\n        # If mid is an odd index\n        else:\n            # If element at mid is part of a pair (arr[mid] == arr[mid-1]),\n            # the unique element must be to the right.\n            if arr[mid] == arr[mid - 1]:\n                low = mid + 1\n            # Otherwise, arr[mid-1] is unique or the unique element is to its left.\n            else:\n                high = mid - 1\n\n    return arr[low]"}
