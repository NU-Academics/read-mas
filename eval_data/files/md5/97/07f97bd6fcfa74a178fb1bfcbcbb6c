{"task_id": "Mbpp/98", "solution": "import os\nimport json\nimport threading\nimport logging\nfrom datetime import datetime\nfrom typing import Iterable, Any, List, Dict, Optional\n\ndef multiply_num(seq):\n    class InvalidInputError(Exception):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class CalculationError(Exception):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    def _multiply_iterable(values: Iterable[float]) -> float:\n        acc = 1.0\n        for v in values:\n            acc *= float(v)\n        return acc\n\n    def _safe_divide(numerator: float, divisor: int) -> float:\n        if divisor == 0:\n            raise CalculationError(\"Division by zero\")\n        return numerator / float(divisor)\n\n    class NumberSequence:\n        def __init__(self, values: List[float]) -> None:\n            self.values: List[float] = values\n        def length(self) -> int:\n            return len(self.values)\n\n    class MultiplyResult(NumberSequence):\n        def __init__(self, result: float, input_seq: List[float], timestamp: str) -> None:\n            super().__init__(input_seq)\n            self.result: float = result\n            self.timestamp: str = timestamp\n\n    class InputValidator:\n        def __init__(self) -> None:\n            self.allowed_types = (int, float)\n        def is_number(self, v: Any) -> bool:\n            return isinstance(v, self.allowed_types) and not isinstance(v, bool)\n        def validate_and_normalize(self, seq: Iterable[Any]) -> List[float]:\n            try:\n                iterator = list(seq)\n            except TypeError:\n                raise InvalidInputError(\"Input is not iterable\")\n            if len(iterator) == 0:\n                raise InvalidInputError(\"Empty sequence is not allowed\")\n            out: List[float] = []\n            for i, v in enumerate(iterator):\n                if not self.is_number(v):\n                    raise InvalidInputError(f\"Element at index {i} is not numeric: {v}\")\n                out.append(float(v))\n            return out\n\n    _DEFAULT_HISTORY_PATH = os.environ.get(\"NUMOPS_HISTORY_PATH\") or os.path.expanduser(\"~/.numops_history.json\")\n\n    class NumberRepository:\n        def __init__(self, path: Optional[str]=None) -> None:\n            self._path = path or _DEFAULT_HISTORY_PATH\n            self._lock = threading.Lock()\n        def append(self, record: Dict) -> None:\n            \"\"\"Appends a record to the JSON history file, ensuring atomic write.\"\"\"\n            try:\n                with self._lock:\n                    data = []\n                    if os.path.exists(self._path):\n                        with open(self._path, \"r\", encoding=\"utf-8\") as f:\n                            data = json.load(f) or []\n                    data.append(record)\n                    tmp = f\"{self._path}.tmp\"\n                    with open(tmp, \"w\", encoding=\"utf-8\") as f:\n                        json.dump(data, f, ensure_ascii=False, indent=2)\n                    os.replace(tmp, self._path)\n            except Exception:\n                logging.getLogger(__name__).warning(\"Failed to persist history; continuing without blocking.\")\n        def read_all(self) -> List[Dict]:\n            \"\"\"Reads all records from the JSON history file.\"\"\"\n            if not os.path.exists(self._path):\n                return []\n            with open(self._path, \"r\", encoding=\"utf-8\") as f:\n                return json.load(f)\n\n    class CalculatorService:\n        def __init__(self, repo: NumberRepository, validator: InputValidator) -> None:\n            self._repo = repo\n            self._validator = validator\n\n        def compute_average_product(self, seq: Iterable) -> float:\n            values = self._validator.validate_and_normalize(seq)\n            product = _multiply_iterable(values)\n            result = _safe_divide(product, len(values))\n            return result\n\n        def compute_and_record(self, seq: Iterable) -> MultiplyResult:\n            \"\"\"Validates input, computes product-average, records to history, and returns MultiplyResult.\"\"\"\n            values = self._validator.validate_and_normalize(seq)\n            product = _multiply_iterable(values)\n            result = _safe_divide(product, len(values))\n            timestamp = datetime.utcnow().isoformat(timespec='milliseconds') + \"Z\"\n            rec = {\"timestamp\": timestamp, \"input\": values, \"result\": result}\n            self._repo.append(rec)\n            return MultiplyResult(result=result, input_seq=values, timestamp=timestamp)\n\n    class MultiplyController:\n        def __init__(self, service: CalculatorService) -> None:\n            self._service = service\n        def multiply_num(self, seq: Iterable) -> float:\n            \"\"\"Computes the average product of a sequence and records it, returning only the float result.\"\"\"\n            result_obj = self._service.compute_and_record(seq)\n            return result_obj.result\n        def multiply_num_with_record(self, seq: Iterable) -> MultiplyResult:\n            return self._service.compute_and_record(seq)\n\n    _default_repo = NumberRepository()\n    _default_validator = InputValidator()\n    _default_service = CalculatorService(_default_repo, _default_validator)\n    default_controller = MultiplyController(_default_service)\n\n    return default_controller.multiply_num(seq)"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(s: str) -> str:\n    \"\"\"Converts a snake_case string to CamelCase (PascalCase) by splitting on underscores, capitalizing each word, and joining them.\n    Empty strings, or strings consisting only of underscores, result in an empty string.\"\"\"\n    if not s:\n        return \"\"\n\n    tokens = [token for token in s.split(\"_\") if token]\n    camel_case_string = \"\".join(token[:1].upper() + token[1:].lower() for token in tokens)\n\n    return camel_case_string"}
{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Computes the Eulerian number A(n, m) using dynamic programming.\n    A(n,m) is the number of permutations of {1, ..., n} with m ascents.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # dp_prev_values stores A(k-1, j) for the current iteration k.\n    # It is initialized to A(0,0)=1, with other A(0,j) being 0.\n    dp_prev_values = [1]\n\n    for k_val in range(1, n + 1):\n        # dp_curr_values will store A(k_val, j). It needs k_val+1 elements for j from 0 to k_val.\n        dp_curr_values = [0] * (k_val + 1)\n\n        for j_val in range(k_val):\n            # Recurrence: A(k,j) = (k - j) * A(k-1, j-1) + (j + 1) * A(k-1, j)\n            \n            # A(k_val-1, j_val-1): value from previous row, at index j_val-1.\n            # It's 0 if j_val-1 is out of bounds (i.e., j_val == 0).\n            term1 = dp_prev_values[j_val - 1] if j_val > 0 else 0\n\n            # A(k_val-1, j_val): value from previous row, at index j_val.\n            # It's 0 if j_val is out of bounds for dp_prev_values (i.e., j_val >= k_val).\n            term2 = dp_prev_values[j_val] if j_val < len(dp_prev_values) else 0\n\n            dp_curr_values[j_val] = (k_val - j_val) * term1 + (j_val + 1) * term2\n        \n        # The current row becomes the previous row for the next iteration.\n        dp_prev_values = dp_curr_values\n\n    # After iterating up to n, dp_prev_values contains A(n, j) for j from 0 to n-1.\n    return dp_prev_values[m]"}
{"task_id": "Mbpp/100", "solution": "import time\nfrom dataclasses import dataclass, asdict\nfrom typing import Any, List, Optional\n\nclass InputValidationError(ValueError):\n    \"\"\"Custom exception for invalid input validation.\"\"\"\n    pass\n\n@dataclass\nclass PalindromeResult:\n    \"\"\"Data Transfer Object for palindrome computation results.\"\"\"\n    input_value: int\n    result: int\n    duration_ms: float\n    timestamp: str\n\n    def to_dict(self):\n        \"\"\"Converts the PalindromeResult object to a dictionary.\"\"\"\n        return asdict(self)\n\nMAX_DIGITS: Optional[int] = None # Configuration constant for maximum allowed digits.\n\nclass MathUtils:\n    \"\"\"Utility class for mathematical operations on digits and strings.\"\"\"\n    @staticmethod\n    def is_palindrome_str(s: str) -> bool:\n        \"\"\"Checks if a string is a palindrome.\"\"\"\n        return s == s[::-1]\n\n    @staticmethod\n    def mirror_left_to_right(s: List[str]) -> List[str]:\n        \"\"\"Mirrors the left half of a list of characters to its right half to form a palindrome.\"\"\"\n        n = len(s)\n        mid = n // 2\n        for i in range(mid):\n            s[n - 1 - i] = s[i]\n        return s\n\n    @staticmethod\n    def compare_strings_num(a: List[str], b: List[str]) -> int:\n        \"\"\"Compares two equal-length digit lists numerically. Returns -1 if a<b, 0 if a==b, 1 if a>b.\"\"\"\n        sa = ''.join(a)\n        sb = ''.join(b)\n        if sa == sb: return 0\n        return 1 if sa > sb else -1\n\nclass InputValidator:\n    \"\"\"Validates and sanitizes integer inputs.\"\"\"\n    def __init__(self, max_digits: Optional[int] = None):\n        self.max_digits = max_digits\n\n    def validate_int(self, value: Any) -> int:\n        \"\"\"Converts input to an integer, raising an error for invalid formats or exceeding digit limits.\"\"\"\n        if isinstance(value, int):\n            n = value\n        else:\n            try:\n                s = str(value).strip()\n                if s == \"\":\n                    raise InputValidationError(\"Empty input\")\n                if \".\" in s:\n                    raise InputValidationError(\"Input contains decimal point, not an integer\")\n                n = int(s)\n            except ValueError:\n                raise InputValidationError(f\"Cannot parse integer from {value!r}\")\n        \n        if self.max_digits is not None and len(str(abs(n))) > self.max_digits:\n            raise InputValidationError(f\"Input {n} exceeds maximum allowed digits of {self.max_digits}\")\n        return n\n\nclass PalindromeService:\n    \"\"\"Core service for computing the next smallest palindrome.\"\"\"\n    def __init__(self, repo=None):\n        self.repo = repo # Not used in this function but part of the design context.\n\n    def next_palindrome(self, n: int) -> PalindromeResult:\n        \"\"\"Computes the next smallest palindrome strictly greater than n.\"\"\"\n        start = time.time()\n        \n        if n < 0:\n            candidate = 0\n        elif n == 0:\n            candidate = 1\n        else:\n            s_num = str(n)\n            s_list = list(s_num)\n\n            current_candidate_list = MathUtils.mirror_left_to_right(s_list.copy())\n\n            if MathUtils.compare_strings_num(current_candidate_list, s_list) <= 0:\n                current_candidate_list = self._increment_middle(current_candidate_list)\n            \n            candidate = int(''.join(current_candidate_list))\n\n        duration_ms = (time.time() - start) * 1000.0\n        return PalindromeResult(input_value=n, result=candidate, duration_ms=duration_ms, timestamp=\"\")\n\n    def _increment_middle(self, s: List[str]) -> List[str]:\n        \"\"\"Increments the middle part of a digit list, handles carry, and re-mirrors.\"\"\"\n        l = len(s)\n        i = (l - 1) // 2 \n\n        carry = 1\n        while i >= 0 and carry > 0:\n            digit = int(s[i]) + carry\n            s[i] = str(digit % 10)\n            carry = digit // 10\n            i -= 1\n\n        if carry > 0:\n            # If carry remains, it means the number's length must increase (e.g., 9, 99).\n            return list('1' + '0' * (l - 1) + '1')\n        else:\n            # Otherwise, re-mirror the modified left half to form the new palindrome.\n            return MathUtils.mirror_left_to_right(s)\n\n\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome integer strictly greater than a specified integer.\n    Example: next_smallest_palindrome(99) == 101.\n    \"\"\"\n    validator = InputValidator(max_digits=MAX_DIGITS)\n    n_int = validator.validate_int(n)\n    svc = PalindromeService()\n    result_dto = svc.next_palindrome(n_int)\n    return result_dto.result"}
{"task_id": "Mbpp/104", "solution": "def sort_sublists(items: list[list[str]]) -> list[list[str]]:\n    \"\"\"\n    Sorts each sublist of strings in a given list of lists.\n\n    The input `items` can be a list or tuple of iterables. Each sublist/subtuple\n    will be sorted lexicographically and returned as a new list of lists.\n    \"\"\"\n    result = []\n    for sublist in items:\n        # Convert sublist to a list and sort it, ensuring a new sorted list is created.\n        result.append(sorted(list(sublist)))\n    return result"}
