{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer.\n    The absolute value of the input number is used for the calculation.\n    \"\"\"\n\n    def _prime_factorize(num: int) -> dict[int, int]:\n        \"\"\"\n        Factorizes a positive integer into its prime factors.\n        Returns a dictionary where keys are prime factors and values are their exponents.\n        \"\"\"\n        num_abs = abs(num)\n        if num_abs <= 1:\n            return {}\n\n        factors = {}\n        # Factor out 2\n        while num_abs % 2 == 0:\n            factors[2] = factors.get(2, 0) + 1\n            num_abs //= 2\n\n        # Factor out odd numbers\n        f = 3\n        while f * f <= num_abs:\n            while num_abs % f == 0:\n                factors[f] = factors.get(f, 0) + 1\n                num_abs //= f\n            f += 2\n\n        # If num_abs is still greater than 1, it must be a prime factor itself\n        if num_abs > 1:\n            factors[num_abs] = factors.get(num_abs, 0) + 1\n        return factors\n\n    def _compute_divisor_count_from_factors(factors: dict[int, int]) -> int:\n        \"\"\"\n        Computes the total number of divisors from a dictionary of prime factors and their exponents.\n        For an empty factors dictionary (e.g., for 0, 1, or -1), it returns 1.\n        \"\"\"\n        if not factors:\n            return 1\n\n        count = 1\n        for exponent in factors.values():\n            count *= (exponent + 1)\n        return count\n\n    prime_factors = _prime_factorize(n)\n    return _compute_divisor_count_from_factors(prime_factors)"}
{"task_id": "Mbpp/97", "solution": "class FrequencyError(Exception):\n    \"\"\"Custom exception for frequency computation errors.\"\"\"\n    pass\n\ndef is_hashable(obj):\n    \"\"\"Checks if an object is hashable.\"\"\"\n    try:\n        hash(obj)\n        return True\n    except TypeError:\n        return False\n\nclass ListFlattener:\n    \"\"\"Helper class to flatten a list of lists into an iterator of elements.\"\"\"\n    def flatten(self, iterables):\n        \"\"\"Yields elements from a 2-level nested iterable.\"\"\"\n        try:\n            for outer in iterables:\n                try:\n                    for inner in outer:\n                        yield inner\n                except TypeError as e:\n                    raise FrequencyError(\"Each element of the outer iterable must itself be iterable\") from e\n        except TypeError as e:\n            raise FrequencyError(\"Input must be an iterable of iterables\") from e\n\nclass FrequencyService:\n    \"\"\"Provides core logic for counting element frequencies.\"\"\"\n    def count_frequencies(self, data, sort_keys=True):\n        \"\"\"Flattens a list of lists and counts element frequencies.\"\"\"\n        flattener = ListFlattener()\n        counts = {}\n        \n        try:\n            for item in flattener.flatten(data):\n                if not is_hashable(item):\n                    raise FrequencyError(f\"Unhashable element: {item!r}\")\n                counts[item] = counts.get(item, 0) + 1\n        except FrequencyError:\n            raise # Re-raise exceptions originating from the flattener\n\n        if sort_keys:\n            return {k: counts[k] for k in sorted(counts)}\n        return counts\n\ndef frequency_lists(data, sort_keys=True):\n    \"\"\"\n    Finds the frequency of each element in a flattened list of lists.\n    Returns the frequencies in a dictionary, sorted by key by default.\n    \"\"\"\n    service = FrequencyService()\n    return service.count_frequencies(data, sort_keys=sort_keys)"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"\n    Converts a non-negative decimal integer to its binary string representation.\n    Assumes valid non-negative integer input.\n    \"\"\"\n    if decimal_number == 0:\n        return \"0\"\n\n    bits = []\n    while decimal_number > 0:\n        bits.append(\"1\" if (decimal_number & 1) else \"0\")\n        decimal_number >>= 1\n    return \"\".join(reversed(bits))"}
