{"task_id": "Mbpp/476", "solution": "def big_sum(numbers: list) -> int:\n    \"\"\"\n    Finds the sum of the largest and smallest value in a given array.\n    Assumes the input array contains only numeric types.\n    \"\"\"\n    if not numbers:\n        # Returns NaN for an empty list, adhering to \"no exceptions for edge cases\".\n        # IEEE 754: inf + (-inf) = NaN\n        return float('nan')\n\n    min_val = float('inf')\n    max_val = float('-inf')\n\n    for num in numbers:\n        # Convert each number to float to handle mixed int/float inputs and comparisons.\n        f_num = float(num)\n        if f_num < min_val:\n            min_val = f_num\n        if f_num > max_val:\n            max_val = f_num\n\n    return float(min_val + max_val)"}
{"task_id": "Mbpp/474", "solution": "import re\nfrom typing import Optional, Tuple\n\nclass ValidationError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass ReplacementRequest:\n    \"\"\"Data Transfer Object for replacement request parameters.\"\"\"\n    def __init__(self, input: str, old: str, new: str, count: Optional[int]=None, case_sensitive: bool=True) -> None:\n        self.input = input\n        self.old = old\n        self.new = new\n        self.count = count\n        self.case_sensitive = case_sensitive\n\nclass ReplacementResult:\n    \"\"\"Data Transfer Object for replacement operation results.\"\"\"\n    def __init__(self, original: str, result: str, replaced: int, error: Optional[str] = None) -> None:\n        self.original = original\n        self.result = result\n        self.replaced = replaced\n        self.error = error\n\ndef validate_single_char(ch: str, name: str) -> None:\n    \"\"\"Validates if a string is a single character.\"\"\"\n    if not isinstance(ch, str) or len(ch) != 1:\n        raise ValidationError(f\"{name} must be a single character string.\")\n\ndef perform_replace(input: str, old: str, new: str, count: Optional[int], case_sensitive: bool) -> Tuple[str,int]:\n    \"\"\"Performs the actual string replacement based on options.\"\"\"\n    if case_sensitive:\n        original_count_of_old = input.count(old)\n        # str.replace takes an integer count, -1 means all occurrences\n        result = input.replace(old, new, count if count is not None else -1)\n        # The number of replaced items is min(count, original_count) if count is specified, otherwise all.\n        replaced = min(count, original_count_of_old) if count is not None else original_count_of_old\n    else:\n        pattern = re.compile(re.escape(old), flags=re.IGNORECASE)\n        # re.subn takes an integer count, 0 means all occurrences\n        result, replaced = pattern.subn(new, input, count=count if count is not None else 0)\n    return result, replaced\n\nclass StringReplacer:\n    \"\"\"Service class encapsulating character replacement logic.\"\"\"\n    def __init__(self, history_repo=None):\n        \"\"\"Initializes the StringReplacer service, optionally with a history repository.\"\"\"\n        self.history_repo = history_repo\n\n    def validate(self, request: ReplacementRequest) -> None:\n        \"\"\"Validates the replacement request parameters.\"\"\"\n        validate_single_char(request.old, \"old\")\n        validate_single_char(request.new, \"new\")\n        if not isinstance(request.input, str):\n            raise ValidationError(\"input must be a str\")\n        if request.count is not None and not isinstance(request.count, int):\n            raise ValidationError(\"count must be an integer or None\")\n        if request.count is not None and request.count < 0:\n            raise ValidationError(\"count must be non-negative\")\n\n    def replace(self, input: str, old: str, new: str, count: Optional[int] = None, case_sensitive: bool = True) -> ReplacementResult:\n        \"\"\"Performs a character replacement operation and returns the result.\"\"\"\n        req = ReplacementRequest(input, old, new, count=count, case_sensitive=case_sensitive)\n        \n        error_message = None\n        result_str = input\n        replaced_count = 0\n        try:\n            self.validate(req)\n            result_str, replaced_count = perform_replace(input, old, new, count, case_sensitive)\n        except ValidationError as e:\n            error_message = str(e)\n        except Exception as e:\n            # Catch any other unexpected errors during replacement\n            error_message = f\"An unexpected error occurred: {e}\"\n\n        # History persistence is an optional feature for the StringReplacer service,\n        # but the replace_char function wrapper does not utilize it.\n        return ReplacementResult(original=input, result=result_str, replaced=replaced_count, error=error_message)\n\ndef replace_char(input: str, old: str, new: str, count: Optional[int] = None, case_sensitive: bool = True) -> str:\n    \"\"\"\n    Replaces occurrences of 'old' character with 'new' character in a string.\n    Supports optional count and case-insensitivity.\n    \"\"\"\n    replacer = StringReplacer()\n    result = replacer.replace(input, old, new, count=count, case_sensitive=case_sensitive)\n    if result.error:\n        # Raise ValueError for issues encountered during replacement, as specified by design.\n        raise ValueError(result.error)\n    return result.result"}
{"task_id": "Mbpp/478", "solution": "def remove_lowercase(text: str) -> str:\n    \"\"\"\n    Removes all lowercase characters from the given string.\n    Preserves uppercase characters and non-alphabetic characters.\n    \"\"\"\n    result_chars = []\n    for char in text:\n        if not char.islower():\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/477", "solution": "def is_lower(s: str) -> str:\n    \"\"\"Converts the given string to its lowercase equivalent.\"\"\"\n    return s.lower()"}
{"task_id": "Mbpp/479", "solution": "def first_Digit(num):\n    \"\"\"\n    Finds the first digit of a given number, ignoring its sign and fractional part.\n    \"\"\"\n    s = str(int(abs(num)))\n    return int(s[0])"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(numbers: list[int], n: int) -> int:\n    \"\"\"\n    Counts the number of unordered pairs in a list whose XOR value is odd.\n    An XOR value is odd if one number is even and the other is odd.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n    for num in numbers:\n        if (num & 1) == 0:  # Check if number is even\n            even_count += 1\n        else:  # Number is odd\n            odd_count += 1\n    return even_count * odd_count"}
{"task_id": "Mbpp/554", "solution": "def Split(numbers: list) -> list:\n    \"\"\"Returns a new list containing only the odd integers from the input list.\"\"\"\n    return [n for n in numbers if n % 2 != 0]"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(s: str) -> str:\n    \"\"\"Toggles the case of all alphabetic characters in a string.\n\n    Non-alphabetic characters remain unchanged, using Python's str.swapcase().\n    \"\"\"\n    return s.swapcase()"}
{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers using closed-form formulas.\n    \"\"\"\n    # Sum of the first n natural numbers: n * (n + 1) / 2\n    sum_natural_numbers = n * (n + 1) // 2\n    \n    # Sum of the cubes of the first n natural numbers: (n * (n + 1) / 2)^2\n    sum_cubes_natural_numbers = sum_natural_numbers * sum_natural_numbers\n    \n    # The required difference\n    result = sum_cubes_natural_numbers - sum_natural_numbers\n    \n    return result"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr: list[int], length: int) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist using Kadane's algorithm.\n    Handles cases where all numbers are negative by returning the largest single element.\n    \"\"\"\n    if not arr:\n        return 0 # Or handle error as per design context, but for sum 0 is common if empty\n\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range 1, length):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"Calculates the sum of per-digit absolute differences between two integers.\"\"\"\n\n    def int_to_digits(value: int) -> list[int]:\n        \"\"\"Converts an integer to a list of its digits, least-significant first.\"\"\"\n        value = abs(value)\n        if value == 0:\n            return [0]\n        digits = []\n        while value > 0:\n            digits.append(value % 10)\n            value //= 10\n        return digits\n\n    def align_digits(a_digits: list[int], b_digits: list[int], pad: int = 0) -> tuple[list[int], list[int]]:\n        \"\"\"Aligns two lists of digits to the same length by padding the shorter one with zeros.\"\"\"\n        len_a = len(a_digits)\n        len_b = len(b_digits)\n        max_len = max(len_a, len_b)\n\n        a_aligned = a_digits + [pad] * (max_len - len_a)\n        b_aligned = b_digits + [pad] * (max_len - len_b)\n        \n        return a_aligned, b_aligned\n\n    a_digits = int_to_digits(a)\n    b_digits = int_to_digits(b)\n    \n    a_al, b_al = align_digits(a_digits, b_digits)\n    \n    return sum(abs(x - y) for x, y in zip(a_al, b_al))"}
