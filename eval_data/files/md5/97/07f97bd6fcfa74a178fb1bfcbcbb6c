{"task_id": "Mbpp/468", "solution": "def max_product(sequence: List[float]) -> float:\n    \"\"\"Calculates the maximum product of an increasing subsequence in the given array.\n    Uses dynamic programming with O(n^2) time complexity.\"\"\"\n    \n    if not sequence:\n        return 0.0\n\n    n = len(sequence)\n    # max_prod[i] stores the maximum product of an increasing subsequence ending at sequence[i].\n    max_prod = [float(x) for x in sequence]\n\n    for i in range(n):\n        for j in range(i):\n            # If sequence[j] can precede sequence[i] in a strictly increasing subsequence.\n            if sequence[j] < sequence[i]:\n                candidate_prod = max_prod[j] * sequence[i]\n                if candidate_prod > max_prod[i]:\n                    max_prod[i] = candidate_prod\n    \n    # The maximum value found in max_prod across all ending positions is the overall maximum product.\n    return max(max_prod)"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(numbers: list) -> bool:\n    \"\"\"\n    Checks if the given list of numbers contains consecutive integers.\n    Order does not matter, and duplicates invalidate consecutiveness.\n    \"\"\"\n    if not numbers:\n        return False\n\n    min_val = min(numbers)\n    max_val = max(numbers)\n    unique_count = len(set(numbers))\n\n    # For a list to be consecutive without duplicates,\n    # the difference between max and min plus one must equal the count of unique numbers.\n    # This automatically handles the duplicate invalidation as unique_count will be smaller than expected.\n    return (max_val - min_val + 1) == unique_count"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(items, n):\n    \"\"\"\n    Finds the product of array elements modulo n, ensuring intermediate results do not overflow.\n    \"\"\"\n    \n    # Initialize the product modulo n. The product of an empty set is 1.\n    product_modulo_n = 1 % n\n\n    # Iterate through the items, multiplying and taking modulo at each step.\n    for item in items:\n        # Get the current item modulo n. Python's % handles negative numbers correctly.\n        item_mod_n = item % n\n        \n        # Multiply the running product modulo n by the current item modulo n.\n        product_modulo_n = (product_modulo_n * item_mod_n) % n\n        \n        # Optimization: If the product becomes 0, it will remain 0 for all subsequent multiplications.\n        if product_modulo_n == 0:\n            return 0\n            \n    return product_modulo_n"}
{"task_id": "Mbpp/473", "solution": "from typing import Iterable, Tuple, Set, Any\n\ndef tuple_intersection(list_a: Iterable[Tuple[Any, Any]], list_b: Iterable[Tuple[Any, Any]]) -> Set[Tuple[Any, Any]]:\n    \"\"\"\n    Finds the intersection of 2-element tuples from two lists, irrespective of tuple element order.\n    Tuples are canonicalized to (min_element, max_element) before set intersection.\n    \"\"\"\n    \n    def _canonicalize_tuple(t: Tuple[Any, Any]) -> Tuple[Any, Any]:\n        \"\"\"Canonicalizes a 2-element tuple to a consistent order (min, max).\"\"\"\n        a, b = t[0], t[1]\n        try:\n            return (a, b) if a <= b else (b, a)\n        except TypeError:\n            # Fallback for uncomparable types, orders by string representation\n            return tuple(sorted((a, b), key=repr))\n\n    set_a_canonical = {_canonicalize_tuple(t) for t in list_a}\n    set_b_canonical = {_canonicalize_tuple(t) for t in list_b}\n    \n    return set_a_canonical.intersection(set_b_canonical)"}
