{"task_id": "Mbpp/454", "solution": "import re\nimport json\nfrom pathlib import Path\nfrom typing import Optional, List, Dict, Any\n\nclass TextMatchingError(Exception):\n    pass\n\nclass RegexUtils:\n    @staticmethod\n    def compile_safe(pattern: str, flags: int = 0) -> re.Pattern:\n        try:\n            return re.compile(pattern, flags)\n        except re.error as exc:\n            raise TextMatchingError(f\"Invalid regex pattern: {pattern}\") from exc\n\n    @staticmethod\n    def search(pattern: re.Pattern, text: str):\n        return pattern.search(text)\n\nDEFAULT_PATTERNS_PATH = str(Path(__file__).parent.parent.parent / \"data\" / \"patterns.json\")\nDEFAULT_PATTERN_DEFS = [\n    {\"name\": \"contains_z\", \"pattern\": r\"\\b\\w*z\\w*\\b\", \"flags\": 0}\n]\n\nclass WordPattern:\n    def __init__(self, name: str, pattern: str, flags: int = 0) -> None:\n        self.name = name\n        self.pattern = pattern\n        self.flags = flags\n        self.compiled = None\n\n    def compile(self) -> re.Pattern:\n        if self.compiled is None:\n            self.compiled = RegexUtils.compile_safe(self.pattern, self.flags)\n        return self.compiled\n\n    def matches(self, text: str) -> bool:\n        pat = self.compile()\n        return RegexUtils.search(pat, text) is not None\n\nclass PatternRepository:\n    def __init__(self, path: Optional[str] = None) -> None:\n        self.path = path or DEFAULT_PATTERNS_PATH\n\n    def load_patterns(self) -> List[WordPattern]:\n        p = Path(self.path)\n        if not p.exists():\n            return [WordPattern(**d) for d in DEFAULT_PATTERN_DEFS]\n        try:\n            with p.open(\"r\", encoding=\"utf-8\") as fh:\n                arr = json.load(fh)\n            return [WordPattern(d[\"name\"], d[\"pattern\"], d.get(\"flags\", 0)) for d in arr]\n        except Exception:\n            return [WordPattern(**d) for d in DEFAULT_PATTERN_DEFS]\n\n    def save_patterns(self, patterns: List[WordPattern]) -> None:\n        p = Path(self.path)\n        arr = [{\"name\": w.name, \"pattern\": w.pattern, \"flags\": w.flags} for w in patterns]\n        p.parent.mkdir(parents=True, exist_ok=True)\n        with p.open(\"w\", encoding=\"utf-8\") as fh:\n            json.dump(arr, fh, indent=2)\n\nclass TextMatcherService:\n    def __init__(self, repository: PatternRepository) -> None:\n        self.repository = repository\n\n    def match_word_with_z(self, text: str) -> bool:\n        patterns = self.repository.load_patterns()\n        return self.match_with_patterns(text, patterns)\n\n    def match_with_patterns(self, text: str, patterns: Optional[List[WordPattern]] = None) -> bool:\n        if patterns is None:\n            patterns = self.repository.load_patterns()\n        for wp in patterns:\n            try:\n                if wp.matches(text):\n                    return True\n            except Exception as exc:\n                raise TextMatchingError(\"Error during pattern matching\") from exc\n        return False\n\ndef text_match_wordz(text: str) -> bool:\n    repo = PatternRepository()\n    service = TextMatcherService(repo)\n    return service.match_word_with_z(text)"}
{"task_id": "Mbpp/455", "solution": "class InvalidMonthError(Exception):\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\n\nclass MonthModel:\n    def __init__(self, month: int):\n        try:\n            self.month: int = int(month)\n        except (ValueError, TypeError):\n            raise InvalidMonthError(f\"Month must be an integer, got {month}\")\n\n    def validate(self) -> None:\n        if not (1 <= self.month <= 12):\n            raise InvalidMonthError(f\"Month must be in 1..12, got {self.month}\")\n\nDEFAULT_MONTHS = {\n    1: 31, 2: 28, 3: 31, 4: 30, 5: 31, 6: 30, 7: 31, 8: 31, 9: 30, 10: 31, 11: 30, 12: 31\n}\n\nclass MonthRepository:\n    def __init__(self, mapping: dict = None):\n        self._mapping = mapping if mapping is not None else DEFAULT_MONTHS\n\n    def get_days(self, month: int) -> int:\n        m = MonthModel(month)\n        m.validate()\n        try:\n            return self._mapping[m.month]\n        except KeyError:\n            raise InvalidMonthError(f\"No data for month {m.month} in mapping.\")\n\nclass MonthService:\n    def __init__(self, repository: MonthRepository):\n        self._repository = repository\n\n    def has_31_days(self, month: int) -> bool:\n        days = self._repository.get_days(month)\n        return days == 31\n\nclass MonthController:\n    def __init__(self, service: MonthService = None):\n        self._service = service or MonthService(MonthRepository())\n\n    def check_monthnumb_number(self, month: int) -> bool:\n        return self._service.has_31_days(month)\n\n_controller = MonthController()\n\ndef check_monthnumb_number(month: int) -> bool:\n    \"\"\"Checks if the given month number has 31 days.\"\"\"\n    return _controller.check_monthnumb_number(month)"}
