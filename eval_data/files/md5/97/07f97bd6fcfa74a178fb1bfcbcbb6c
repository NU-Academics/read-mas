{"task_id": "Mbpp/409", "solution": "def min_product_tuple(pairs):\n    \"\"\"\n    Finds the minimum product from the pairs of numbers within a given list of tuples.\n    Assumes valid input: a non-empty list of 2-element tuples containing numbers.\n    \"\"\"\n    min_prod = float('inf')\n    for a, b in pairs:\n        current_prod = a * b\n        if current_prod < min_prod:\n            min_prod = current_prod\n    return min_prod"}
{"task_id": "Mbpp/412", "solution": "def remove_odd(numbers: list) -> list:\n    \"\"\"\n    Filters a list to remove odd numbers, returning a new list with only even numbers.\n    Preserves the original order and duplicates of even numbers.\n    \"\"\"\n    result = [n for n in numbers if n % 2 == 0]\n    return result"}
{"task_id": "Mbpp/410", "solution": "from decimal import Decimal\nfrom typing import Any, Iterable, Optional, Union\n\nclass MinFinderError(Exception):\n    \"\"\"Base exception for minfinder operations.\"\"\"\n    pass\n\nclass NoNumericValuesError(MinFinderError):\n    \"\"\"Raised when no numeric values are found in the input.\"\"\"\n    def __init__(self, message: str = \"No numeric values found\") -> None:\n        super().__init__(message)\n\nclass InvalidInputError(MinFinderError):\n    \"\"\"Raised when the input is not an iterable.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass TypeAdapter:\n    \"\"\"Safely converts various inputs to numeric types.\"\"\"\n    def __init__(self, prefer_decimal: bool = False) -> None:\n        self.prefer_decimal = prefer_decimal\n\n    def to_number(self, value: Any) -> Optional[Union[float, Decimal]]:\n        \"\"\"Returns numeric representation of value or None if unconvertible.\"\"\"\n        if isinstance(value, bool):  # Business decision: treat bool as non-numeric\n            return None\n        if isinstance(value, (int, float, Decimal)):\n            return Decimal(value) if self.prefer_decimal and not isinstance(value, Decimal) else value\n        if isinstance(value, str):\n            s = value.strip()\n            return self._parse_numeric_string(s)\n        return None\n\n    def _parse_numeric_string(self, s: str) -> Optional[Union[float, Decimal]]:\n        \"\"\"Parses a string into a float or Decimal, returning None on failure.\"\"\"\n        try:\n            return Decimal(s) if self.prefer_decimal else float(s)\n        except Exception:\n            return None\n\nclass TypeFilter:\n    \"\"\"Filters out non-numeric values from an iterable.\"\"\"\n    def __init__(self, adapter: TypeAdapter) -> None:\n        self.adapter = adapter\n\n    def filter_numeric(self, values: Iterable[Any]) -> Iterable[Union[float, Decimal]]:\n        \"\"\"Yields parsed numeric values for items that are convertible.\"\"\"\n        for value in values:\n            numeric_value = self.adapter.to_number(value)\n            if numeric_value is not None:\n                yield numeric_value\n\nclass MinFinderService:\n    \"\"\"Core logic to find the minimum numeric value.\"\"\"\n    def __init__(self, type_filter: TypeFilter, adapter: TypeAdapter) -> None:\n        self.type_filter = type_filter\n        self.adapter = adapter # This adapter instance is not directly used in find_min, but maintained for consistency with design.\n\n    def find_min(self, values: Iterable[Any]) -> Union[float, Decimal]:\n        \"\"\"Iterates through filtered numeric values to find the minimum.\"\"\"\n        min_val: Optional[Union[float, Decimal]] = None\n        for num in self.type_filter.filter_numeric(values):\n            if min_val is None or num < min_val:\n                min_val = num\n        if min_val is None:\n            raise NoNumericValuesError()\n        return min_val\n\nclass InputController:\n    \"\"\"Provides a public API wrapper, validating input and delegating to the service.\"\"\"\n    def __init__(self, service: MinFinderService) -> None:\n        self.service = service\n\n    def min_val(self, values: Iterable[Any]) -> Union[float, Decimal]:\n        \"\"\"Public function to find the minimum numeric value in an iterable.\"\"\"\n        try:\n            iter(values)\n        except TypeError:\n            raise InvalidInputError(\"Input must be an iterable\")\n        return self.service.find_min(values)\n\n_default_adapter = TypeAdapter()\n_default_filter = TypeFilter(_default_adapter)\n_default_service = MinFinderService(_default_filter, _default_adapter)\n_default_controller = InputController(_default_service)\n\ndef min_val(values: Iterable[Any]) -> Union[float, Decimal]:\n    \"\"\"\n    Finds the minimum numeric value in a given heterogeneous list.\n    Non-numeric items are ignored, and numeric strings are parsed.\n    \"\"\"\n    return _default_controller.min_val(values)"}
{"task_id": "Mbpp/414", "solution": "def overlapping(seq1: Sequence[Any], seq2: Sequence[Any]) -> bool:\n    \"\"\"\n    Checks if any value in seq1 exists in seq2 using an efficient set-based\n    approach for hashable elements, or a fallback for unhashable elements.\n    \"\"\"\n    try:\n        # Attempt set-based intersection for efficiency with hashable elements.\n        # This will raise TypeError if elements in either sequence are unhashable.\n        set1 = set(seq1)\n        set2 = set(seq2)\n        return not set1.isdisjoint(set2)\n    except TypeError:\n        # If a TypeError occurs, it means one or both sequences contain unhashable elements.\n        # Fallback to a less efficient, element-by-element comparison.\n        # Convert to lists to ensure stable, multi-pass iteration and enable length checks.\n        list1 = list(seq1)\n        list2 = list(seq2)\n\n        # Iterate over the potentially shorter list as the outer loop for minor optimization.\n        if len(list1) < len(list2):\n            for item1 in list1:\n                for item2 in list2:\n                    if item1 == item2:\n                        return True\n        else:\n            for item2 in list2:\n                for item1 in list1:\n                    if item2 == item1:\n                        return True\n        \n        # No common elements found after the full fallback comparison.\n        return False"}
