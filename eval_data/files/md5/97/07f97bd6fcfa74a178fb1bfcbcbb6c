{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(a, b):\n    \"\"\"\n    Checks if two integers differ by exactly one bit position.\n    \"\"\"\n    xor = a ^ b\n    if xor == 0:\n        return False\n    return (xor & (xor - 1)) == 0"}
{"task_id": "Mbpp/7", "solution": "def find_char_long(s):\n    \"\"\"\n    Finds all words which are at least 4 characters long in a string.\n    Words are sequences of alphanumeric characters and apostrophes.\n    \"\"\"\n    import re\n    # Define the pattern to find words based on the design context:\n    # alphanumeric characters and apostrophes are part of a word.\n    pattern = r\"[A-Za-z0-9']+\"\n    words = re.findall(pattern, s)\n\n    # Filter the extracted words to include only those with a length of 4 or more.\n    filtered_words = [word for word in words if len(word) >= 4]\n\n    return filtered_words"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(s: str, ch: str) -> str:\n    \"\"\"Removes the first and last occurrence of a character from a string.\"\"\"\n    first_idx = s.find(ch)\n\n    if first_idx == -1:\n        return s\n\n    last_idx = s.rfind(ch)\n\n    if first_idx == last_idx:\n        return s[:first_idx] + s[first_idx+1:]\n    else:\n        # Remove both occurrences by building the string with slices\n        return s[:first_idx] + s[first_idx+1:last_idx] + s[last_idx+1:]"}
