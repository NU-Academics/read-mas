{"task_id": "Mbpp/462", "solution": "from typing import List\n\ndef combinations_list(items: List[str]) -> List[List[str]]:\n    \"\"\"\n    Generates all possible combinations (subsets) of elements in the input list,\n    maintaining a deterministic order as per the design example.\n    \"\"\"\n    # Initialize the results with an empty list, representing the combination with no elements.\n    results: List[List[str]] = [[]]\n\n    # Iterate through each item provided in the input list.\n    for item in items:\n        # For each item, create new combinations by prepending the current item\n        # to every existing combination found so far in the 'results' list.\n        new_batches = [[item] + combination for combination in results]\n        \n        # Add these newly formed combinations to the collection of results.\n        results.extend(new_batches)\n\n    return results"}
{"task_id": "Mbpp/465", "solution": "def drop_empty(d: dict) -> dict:\n    \"\"\"\n    Removes items with 'empty' values from a dictionary, returning a new dictionary.\n    Empty values include None, empty strings, and empty collections.\n    \"\"\"\n    result = {}\n    for k, v in d.items():\n        is_empty_val = False\n        if v is None:\n            is_empty_val = True\n        elif isinstance(v, str):\n            # As per design, trim_strings is False by default for drop_empty convenience wrapper\n            if v == \"\":\n                is_empty_val = True\n        elif isinstance(v, (list, tuple, set, dict)):\n            if len(v) == 0:\n                is_empty_val = True\n        # Numeric 0 and False are not considered empty as per design\n\n        if not is_empty_val:\n            result[k] = v\n    return result"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(arr: list[int]) -> int:\n    \"\"\"\n    Finds the maximum product of a contiguous subarray within the given array.\n    Assumes `arr` is a non-empty list of integers.\n    \"\"\"\n    n = len(arr)\n\n    # Initialize variables for tracking max and min products ending at the current position,\n    # and the overall maximum product found so far.\n    max_so_far = arr[0]\n    min_so_far = arr[0]\n    overall_max = arr[0]\n\n    for i in range(1, n):\n        num = arr[i]\n\n        if num == 0:\n            # If the current number is 0, any product including it becomes 0.\n            # We update overall_max to include 0 if it's the highest product so far,\n            # and reset max_so_far and min_so_far to 1 to start a new product sequence.\n            overall_max = max(overall_max, 0)\n            max_so_far = 1\n            min_so_far = 1\n            continue\n\n        # Store the current max_so_far before it potentially changes,\n        # as it might be needed for calculating the new min_so_far.\n        temp_max_so_far_val = max_so_far\n        \n        # The new max_so_far is the maximum of three possibilities:\n        # 1. The number itself (starting a new subarray)\n        # 2. Product of the number and the previous max_so_far\n        # 3. Product of the number and the previous min_so_far (important if num is negative)\n        max_so_far = max(num, num * temp_max_so_far_val, num * min_so_far)\n        \n        # Similarly for min_so_far\n        min_so_far = min(num, num * temp_max_so_far_val, num * min_so_far)\n        \n        # Update overall_max if the current max_so_far is greater\n        overall_max = max(overall_max, max_so_far)\n\n    return overall_max"}
