{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n):\n    \"\"\"\n    Finds the highest power of 2 that is less than or equal to n using bit manipulation.\n    Returns 0 for n less than 1.\n    \"\"\"\n    if n < 1:\n        return 0\n    \n    # Set all bits lower than the most significant bit.\n    # This trick works for positive integers.\n    v = n\n    v |= (v >> 1)\n    v |= (v >> 2)\n    v |= (v >> 4)\n    v |= (v >> 8)\n    v |= (v >> 16)\n    v |= (v >> 32) # For 64-bit integers\n    \n    # (v + 1) gives the next power of 2 (or 0 if v was all 1s for the max int size),\n    # then shift right by 1 to get the largest power of 2 less than or equal to n.\n    return (v + 1) >> 1"}
{"task_id": "Mbpp/389", "solution": "import threading\nfrom typing import Any, Optional, Dict, Tuple\n\nclass LucasError(Exception):\n    \"\"\"Base exception for Lucas number operations.\"\"\"\n    pass\n\nclass InvalidInputError(LucasError):\n    \"\"\"Raised when input 'n' is invalid.\"\"\"\n    pass\n\ndef validate_n(n: Any) -> int:\n    \"\"\"Validates and coerces input 'n' to a non-negative integer.\"\"\"\n    if isinstance(n, bool):\n        raise InvalidInputError(\"Input 'n' cannot be a boolean.\")\n    try:\n        n_int = int(n)\n    except (ValueError, TypeError) as e:\n        raise InvalidInputError(f\"Input 'n' must be an integer or convertible to an integer. Got {type(n).__name__}.\") from e\n\n    if n_int < 0:\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n    return n_int\n\nclass MemoCache:\n    \"\"\"Thread-safe in-memory cache with simple LRU eviction.\"\"\"\n    DEFAULT_MAX_SIZE = 10000\n\n    def __init__(self, max_size: int = DEFAULT_MAX_SIZE) -> None:\n        self._store: Dict[int, int] = {}\n        self._lock = threading.Lock()\n        self._max_size = max_size\n\n    def get(self, key: int) -> Optional[int]:\n        with self._lock:\n            if key in self._store:\n                value = self._store.pop(key)\n                self._store[key] = value\n                return value\n            return None\n\n    def set(self, key: int, value: int) -> None:\n        with self._lock:\n            if key in self._store:\n                self._store.pop(key)\n            elif len(self._store) >= self._max_size:\n                oldest_key = next(iter(self._store))\n                del self._store[oldest_key]\n            self._store[key] = value\n\n    def clear(self) -> None:\n        with self._lock:\n            self._store.clear()\n\nclass LucasRepository:\n    \"\"\"Abstract interface for a Lucas number repository/cache.\"\"\"\n    def get(self, n: int) -> Optional[int]:\n        raise NotImplementedError\n\n    def set(self, n: int, value: int) -> None:\n        raise NotImplementedError\n\nclass InMemoryRepository(LucasRepository):\n    \"\"\"An in-memory repository using MemoCache.\"\"\"\n    def __init__(self, cache: Optional[MemoCache] = None) -> None:\n        self._cache = cache or MemoCache()\n\n    def get(self, n: int) -> Optional[int]:\n        return self._cache.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        self._cache.set(n, value)\n\ndef fast_doubling(n: int) -> Tuple[int, int]:\n    \"\"\"Computes (F(n), F(n+1)) for Fibonacci sequence using fast doubling.\"\"\"\n    if n == 0:\n        return (0, 1)\n    \n    a, b = fast_doubling(n >> 1)\n    f_2k = a * (2 * b - a)\n    f_2k_plus_1 = a * a + b * b\n    \n    if n & 1:\n        return (f_2k_plus_1, f_2k + f_2k_plus_1)\n    else:\n        return (f_2k, f_2k_plus_1)\n\nclass LucasService:\n    \"\"\"Provides core business logic for Lucas number computation.\"\"\"\n    L0: int = 2\n    L1: int = 1\n\n    def __init__(self, repository: Optional[LucasRepository] = None) -> None:\n        self.repository = repository or InMemoryRepository(MemoCache())\n\n    def find_lucas(self, n: int, method: str = \"iterative\") -> int:\n        \"\"\"Finds the n'th Lucas number using the specified method.\"\"\"\n        n = validate_n(n)\n        \n        cached = self.repository.get(n)\n        if cached is not None:\n            return cached\n        \n        if method == \"iterative\":\n            result = self._compute_iterative(n)\n        elif method == \"fast\":\n            result = self._compute_fast(n)\n        else:\n            raise ValueError(f\"Unsupported method: {method}. Choose 'iterative' or 'fast'.\")\n        \n        self.repository.set(n, result)\n        return result\n\n    def _compute_iterative(self, n: int) -> int:\n        \"\"\"Computes the n'th Lucas number iteratively (O(n)).\"\"\"\n        if n == 0:\n            return self.L0\n        if n == 1:\n            return self.L1\n        \n        a, b = self.L0, self.L1\n        for _ in range(2, n + 1):\n            a, b = b, a + b\n        return b\n\n    def _compute_fast(self, n: int) -> int:\n        \"\"\"Computes the n'th Lucas number using fast doubling (O(log n)).\"\"\"\n        if n == 0:\n            return self.L0\n        if n == 1:\n            return self.L1\n        \n        # L(n) = 2*F(n+1) - F(n) for n >= 0\n        Fn, Fnp1 = fast_doubling(n) # Fn = F(n), Fnp1 = F(n+1)\n        return 2 * Fnp1 - Fn\n\n_default_lucas_service = LucasService()\n\ndef find_lucas(n: int) -> int:\n    \"\"\"Computes the n'th Lucas number.\n    Delegates to a LucasService instance, using an iterative algorithm by default.\n    \"\"\"\n    return _default_lucas_service.find_lucas(n)"}
{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(ids, names, scores):\n    \"\"\"\n    Converts three parallel lists (ids, names, scores) into a list of nested dictionaries\n    where each dictionary is of the form {id: {name: score}}.\n    \"\"\"\n    result = []\n    for id_val, name_val, score_val in zip(ids, names, scores):\n        nested_dict = {name_val: score_val}\n        result.append({id_val: nested_dict})\n    return result"}
{"task_id": "Mbpp/394", "solution": "def check_distinct(t: tuple) -> bool:\n    \"\"\"\n    Checks if the given tuple contains no duplicate elements.\n    It attempts an O(n) set-based check and falls back to an O(n^2) comparison for unhashable elements.\n    \"\"\"\n    try:\n        # Attempt O(n) check for hashable elements\n        return len(set(t)) == len(t)\n    except TypeError:\n        # Fallback to O(n^2) check for unhashable elements\n        n = len(t)\n        for i in range(n):\n            for j in range(i + 1, n):\n                if t[i] == t[j]:\n                    return False\n        return True"}
{"task_id": "Mbpp/392", "solution": "def get_max_sum(n: int) -> int:\n    \"\"\"\n    Calculates the maximum sum for n using the recursive formula f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n    Uses memoization to optimize repeated calculations.\n    \"\"\"\n    import functools\n\n    @functools.lru_cache(maxsize=None)\n    def _get_max_sum_memoized(current_n: int) -> int:\n        if current_n <= 1:\n            return current_n\n\n        # Recursively calculate the sum of parts using floor division\n        sum_parts = (\n            _get_max_sum_memoized(current_n // 2) +\n            _get_max_sum_memoized(current_n // 3) +\n            _get_max_sum_memoized(current_n // 4) +\n            _get_max_sum_memoized(current_n // 5)\n        )\n\n        # Return the maximum of the sum of parts or n itself\n        return max(sum_parts, current_n)\n    \n    return _get_max_sum_memoized(n)"}
{"task_id": "Mbpp/395", "solution": "from typing import Optional\n\ndef first_non_repeating_character(s: str) -> Optional[str]:\n    \"\"\"Finds the first non-repeated character in a string.\n    Returns None if no non-repeated character is found.\"\"\"\n    char_counts = {}\n    for char in s:\n        char_counts[char] = char_counts.get(char, 0) + 1\n\n    for char in s:\n        if char_counts[char] == 1:\n            return char\n\n    return None"}
{"task_id": "Mbpp/398", "solution": "def sum_of_digits(numbers: list[int]) -> int:\n    \"\"\"\n    Computes the sum of digits for each number in a list and returns the total sum.\n    Negative numbers are handled by using their absolute value.\n    \"\"\"\n    def _sum_digits_of_single_number(n: int) -> int:\n        \"\"\"Helper to calculate the sum of digits for a single integer.\"\"\"\n        n = abs(n)\n        s = 0\n        if n == 0:\n            return 0\n        while n:\n            s += n % 10\n            n //= 10\n        return s\n\n    total_sum_all_numbers = 0\n    for num in numbers:\n        total_sum_all_numbers += _sum_digits_of_single_number(num)\n    \n    return total_sum_all_numbers"}
{"task_id": "Mbpp/397", "solution": "def median_numbers(a, b, c) -> float:\n    \"\"\"Calculates the median of three numbers by sorting them.\"\"\"\n    numbers = [float(a), float(b), float(c)]\n    numbers.sort()\n    return numbers[1]"}
{"task_id": "Mbpp/406", "solution": "from typing import List, Tuple, Callable\n\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\ndef validate_and_cast_to_int(raw: object) -> int:\n    \"\"\"Validates raw input and casts it to an integer, raising InvalidInputError if conversion fails.\"\"\"\n    if isinstance(raw, bool):\n        raise InvalidInputError(\"Boolean is not accepted as integer input\")\n    if isinstance(raw, int):\n        return raw\n    if isinstance(raw, str):\n        s = raw.strip()\n        if s.lstrip(\"+-\").isdigit():\n            return int(s)\n    raise InvalidInputError(f\"Cannot convert {raw!r} to int\")\n\ndef is_odd_bitwise(n: int) -> bool:\n    \"\"\"Determines if an integer is odd using a bitwise operation.\"\"\"\n    return (n & 1) != 0\n\nclass NumberModel:\n    \"\"\"Encapsulates a validated integer value.\"\"\"\n    def __init__(self, value: int) -> None:\n        if not isinstance(value, int):\n            raise ValueError(\"NumberModel must be initialized with an integer.\")\n        self._value = value\n\n    def get_value(self) -> int:\n        \"\"\"Returns the encapsulated integer value.\"\"\"\n        return self._value\n\nclass ParityService:\n    \"\"\"Provides core parity computation logic.\"\"\"\n    def __init__(self, validator: Callable[[object], int]):\n        self.validator = validator\n\n    def is_odd(self, n: int) -> bool:\n        \"\"\"Checks if the given integer is odd.\"\"\"\n        model = NumberModel(n)\n        return is_odd_bitwise(model.get_value())\n\nclass CallLogRepository:\n    \"\"\"A simple in-memory repository for logging calls.\"\"\"\n    def __init__(self) -> None:\n        self._logs: List[Tuple[int, bool]] = []\n\n    def log_call(self, value: int, result: bool) -> None:\n        \"\"\"Logs a call with the input value and its parity result.\"\"\"\n        self._logs.append((value, result))\n\n    def get_logs(self) -> List[Tuple[int, bool]]:\n        \"\"\"Retrieves a copy of the logged calls.\"\"\"\n        return list(self._logs)\n\nclass ParityController:\n    \"\"\"Orchestrates input validation, parity service invocation, and optional logging.\"\"\"\n    def __init__(self, service: ParityService, repo: CallLogRepository = None):\n        self.service = service\n        self.repo = repo\n\n    def check_parity(self, raw: object) -> bool:\n        \"\"\"Validates input, determines parity, and logs the operation.\"\"\"\n        n = self.service.validator(raw)\n        result = self.service.is_odd(n)\n        if self.repo:\n            self.repo.log_call(n, result)\n        return result\n\ndef find_Parity(raw: object) -> bool:\n    \"\"\"Finds whether the parity of a given number is odd.\n    This function handles input validation and delegates to core logic.\n    \"\"\"\n    service = ParityService(validator=validate_and_cast_to_int)\n    controller = ParityController(service=service, repo=CallLogRepository())\n    return controller.check_parity(raw)"}
{"task_id": "Mbpp/404", "solution": "def minimum(a, b):\n    \"\"\"\n    Finds the minimum of two numbers, preserving NaN semantics.\n    Assumes `a` and `b` are valid numeric types (int or float).\n    \"\"\"\n    import math\n\n    # Preserve NaN semantics as per design: if either is NaN, return NaN.\n    if math.isnan(a) or math.isnan(b):\n        return float(\"nan\")\n    \n    return a if a <= b else b"}
