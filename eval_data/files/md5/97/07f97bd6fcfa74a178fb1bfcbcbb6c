{"task_id": "Mbpp/91", "solution": "from abc import ABC, abstractmethod\n\nDEFAULT_CASE_SENSITIVE = False\nDEFAULT_STRICT_VALIDATION = True\n\nclass SubstringError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass InvalidInputError(SubstringError):\n    pass\n\nclass Validator:\n    @staticmethod\n    def validate_pattern(pattern: str) -> None:\n        if not isinstance(pattern, str) or not pattern:\n            raise InvalidInputError(\"pattern must be a non-empty string\")\n\n    @staticmethod\n    def validate_values(values: list[str], strict: bool) -> None:\n        if not hasattr(values, \"__iter__\"):\n            raise InvalidInputError(\"values must be an iterable of strings\")\n        if strict:\n            for i, v in enumerate(values):\n                if not isinstance(v, str):\n                    raise InvalidInputError(f\"values[{i}] is not a string\")\n\n    @staticmethod\n    def normalize_text(s: str, case_sensitive: bool) -> str:\n        return s if case_sensitive else s.lower()\n\nclass RepositoryInterface(ABC):\n    @abstractmethod\n    def get_values(self) -> list[str]:\n        pass\n\nclass InMemoryRepository(RepositoryInterface):\n    def __init__(self, values: list[str]):\n        self._values = list(values)\n\n    def get_values(self) -> list[str]:\n        return self._values\n\nclass SubstringService:\n    def __init__(self, repo: RepositoryInterface, case_sensitive: bool = False, strict: bool = True):\n        self._repo = repo\n        self._case_sensitive = case_sensitive\n        self._strict = strict\n\n    def find_substring(self, pattern: str) -> bool:\n        Validator.validate_pattern(pattern)\n        values = self._repo.get_values()\n        Validator.validate_values(values, self._strict)\n        \n        needle = Validator.normalize_text(pattern, self._case_sensitive)\n        for v in values:\n            if self._match(v, needle):\n                return True\n        return False\n\n    def find_matches(self, pattern: str) -> list[str]:\n        Validator.validate_pattern(pattern)\n        values = self._repo.get_values()\n        Validator.validate_values(values, self._strict)\n        \n        needle = Validator.normalize_text(pattern, self._case_sensitive)\n        matches = [v for v in values if self._match(v, needle)]\n        return matches\n\n    def _match(self, value: str, needle: str) -> bool:\n        if not isinstance(value, str):\n            if self._strict:\n                raise InvalidInputError(\"non-string value encountered\")\n            return False\n        hay = Validator.normalize_text(value, self._case_sensitive)\n        return hay.find(needle) != -1\n\ndef find_substring(values: list[str], pattern: str, case_sensitive: bool = DEFAULT_CASE_SENSITIVE, strict: bool = DEFAULT_STRICT_VALIDATION) -> bool:\n    \"\"\"Checks if a string is present as a substring in a list of strings.\"\"\"\n    repo = InMemoryRepository(values)\n    svc = SubstringService(repo, case_sensitive=case_sensitive, strict=strict)\n    return svc.find_substring(pattern)"}
{"task_id": "Mbpp/90", "solution": "from typing import Iterable, List, Any, Optional, Sequence\nimport json\nimport datetime\n\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input to the word length functions.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass StringUtils:\n    \"\"\"Provides utility methods for string manipulation.\"\"\"\n    def normalize_word(self, word: Any) -> str:\n        \"\"\"Converts an item to string and strips whitespace.\"\"\"\n        return str(word).strip()\n\nclass LoggingRepository:\n    \"\"\"Handles persistence of invocation logs to a JSONL file.\"\"\"\n    def __init__(self, filepath: str = \"wordlen_invocations.log\") -> None:\n        self._filepath = filepath\n\n    def record_invocation(self, payload: dict) -> None:\n        \"\"\"Appends a JSON dump of the payload with timestamp to the log file.\"\"\"\n        log_entry = {\n            \"timestamp\": datetime.datetime.now(datetime.timezone.utc).isoformat(),\n            **payload\n        }\n        try:\n            with open(self._filepath, 'a', encoding='utf-8') as f:\n                f.write(json.dumps(log_entry) + '\\n')\n        except IOError as e:\n            # As per design, I/O errors are logged but not fatal to main flow.\n            print(f\"Warning: Could not log invocation to {self._filepath}: {e}\")\n\nclass InputValidator:\n    \"\"\"Validates and normalizes input iterable of words.\"\"\"\n    def __init__(self, max_word_length: Optional[int] = None) -> None:\n        self._max_word_length = max_word_length\n\n    def validate_words(self, words: Iterable[Any]) -> List[str]:\n        \"\"\"Ensures input is an iterable of strings, rejecting None and checking length.\"\"\"\n        if words is None:\n            raise InvalidInputError(\"words must not be None\")\n        try:\n            # Test if it's iterable\n            iterator = iter(words)\n        except TypeError:\n            raise InvalidInputError(\"words must be an iterable\")\n\n        normalized = []\n        for i, w in enumerate(iterator):\n            if w is None:\n                raise InvalidInputError(f\"element at index {i} is None\")\n            # Coerce to string early to check length and avoid later TypeErrors\n            s = str(w)\n            if self._max_word_length is not None and len(s) > self._max_word_length:\n                raise InvalidInputError(f\"element at index {i} ('{s}') exceeds maximum length of {self._max_word_length}\")\n            normalized.append(s)\n        return normalized\n\nclass WordLengthService:\n    \"\"\"Computes the length of the longest word.\"\"\"\n    def __init__(self, utils: Optional[StringUtils] = None) -> None:\n        self._utils = utils or StringUtils()\n\n    def compute_max_length(self, words: Iterable[str]) -> int:\n        \"\"\"Iterates through words and finds the length of the longest one.\"\"\"\n        max_len = 0\n        if not words: # Handle empty iterable explicitly as per design (returns 0)\n            return 0\n        for w in words:\n            s = self._utils.normalize_word(w)\n            current_len = len(s)\n            if current_len > max_len:\n                max_len = current_len\n        return max_len\n\nclass WordLengthController:\n    \"\"\"Orchestrates validation, computation, and optional logging.\"\"\"\n    def __init__(self, validator: InputValidator, service: WordLengthService, repo: Optional[LoggingRepository] = None) -> None:\n        self._validator = validator\n        self._service = service\n        self._repo = repo\n\n    def get_longest_length(self, words: Iterable[Any]) -> int:\n        \"\"\"Validates input, computes longest length, and optionally logs the invocation.\"\"\"\n        validated_words = self._validator.validate_words(words)\n        result = self._service.compute_max_length(validated_words)\n\n        if self._repo:\n            try:\n                # Log sample inputs from the already validated words\n                payload = {\n                    \"input_count\": len(validated_words),\n                    \"sample_inputs\": validated_words[:10], # Take first 10 validated words as sample\n                    \"result\": result,\n                    \"version\": \"0.1.0\" # Hardcoding as per design example\n                }\n                self._repo.record_invocation(payload)\n            except Exception as e:\n                # Log any unexpected errors during logging itself\n                print(f\"Error during invocation logging: {e}\")\n        return result\n\nclass LenLogAPI:\n    \"\"\"Public adapter providing the len_log function.\"\"\"\n    def __init__(self, controller: WordLengthController) -> None:\n        self.controller = controller\n\n    def len_log(self, words: Iterable[Any]) -> int:\n        \"\"\"Delegates to the controller to find the length of the longest word.\"\"\"\n        return self.controller.get_longest_length(words)\n\n# Initialize default dependencies as per design context in __init__.py\n_default_string_utils = StringUtils()\n_default_validator = InputValidator()\n_default_service = WordLengthService(utils=_default_string_utils)\n_default_logging_repo = LoggingRepository()\n_default_controller = WordLengthController(validator=_default_validator, service=_default_service, repo=_default_logging_repo)\n_default_api = LenLogAPI(controller=_default_controller)\n\ndef len_log(words: Iterable[str]) -> int:\n    \"\"\"Finds the length of the longest word in a list of strings.\n    Delegates to internal components for validation, computation, and logging.\n    \"\"\"\n    return _default_api.len_log(words)"}
{"task_id": "Mbpp/87", "solution": "def merge_dictionaries_three(d1: dict, d2: dict, d3: dict, raise_on_conflict: bool = False) -> dict:\n    \"\"\"\n    Merges three dictionaries into a single dictionary.\n    Keys from earlier dictionaries take precedence, preserving first-seen insertion order.\n    \"\"\"\n    merged_dict = {}\n\n    # Process the first dictionary\n    for key, value in d1.items():\n        merged_dict[key] = value\n\n    # Process the second dictionary\n    for key, value in d2.items():\n        if key not in merged_dict:\n            merged_dict[key] = value\n\n    # Process the third dictionary\n    for key, value in d3.items():\n        if key not in merged_dict:\n            merged_dict[key] = value\n\n    # The 'raise_on_conflict' flag is handled by higher-level components\n    # (e.g., MergeService or Controller) in the full design context,\n    # and not implemented directly in this low-level function per instructions.\n    \n    return merged_dict"}
{"task_id": "Mbpp/92", "solution": "def is_undulating(n: int) -> bool:\n    \"\"\"\n    Checks if an integer is an undulating number, where digits strictly alternate\n    between two distinct values (e.g., 121212, 3434). Single-digit numbers are not undulating.\n    \"\"\"\n    s_n = str(abs(n))\n    length = len(s_n)\n\n    if length < 2:\n        return False\n\n    digit_a = int(s_n[0])\n    digit_b = int(s_n[1])\n\n    if digit_a == digit_b:\n        return False\n\n    for i in range(2, length):\n        current_digit = int(s_n[i])\n        if i % 2 == 0:\n            if current_digit != digit_a:\n                return False\n        else:\n            if current_digit != digit_b:\n                return False\n\n    return True"}
{"task_id": "Mbpp/93", "solution": "def power(a, b):\n    \"\"\"Calculates 'a' to the power 'b', using exponentiation by squaring for integral exponents.\n    For non-integral exponents, it falls back to math.pow.\"\"\"\n    import math\n\n    # A small constant to check if a float is effectively an integer.\n    EPSILON = 1e-12\n\n    # Check if 'b' is an integral number (e.g., 3.0, -2.0, 0.0)\n    is_integral_b = abs(b - round(b)) < EPSILON\n\n    if is_integral_b:\n        # Treat 'b' as an integer for the exponentiation by squaring algorithm.\n        exp_int = int(round(b))\n\n        # Handle the base case where exponent is 0.\n        if exp_int == 0:\n            return 1.0\n\n        # Determine if the exponent is negative to handle reciprocals.\n        negative_exponent = exp_int < 0\n        e = abs(exp_int)\n\n        result = 1.0\n        current_base = float(a) # Ensure intermediate calculations are float\n\n        # Exponentiation by squaring algorithm\n        while e > 0:\n            if e & 1:  # If the current bit of the exponent is 1\n                result *= current_base\n            current_base *= current_base # Square the base\n            e >>= 1 # Move to the next bit of the exponent\n\n        # If the original exponent was negative, return the reciprocal of the result.\n        return 1.0 / result if negative_exponent else result\n    else:\n        # For non-integral exponents, use the standard math.pow function.\n        return math.pow(a, b)"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(items: list[tuple[str, int]]) -> str:\n    \"\"\"\n    Returns the first value of the tuple with the smallest second value.\n    Assumes `items` is a non-empty list of 2-tuples where the second element is comparable.\n    \"\"\"\n    min_tuple = min(items, key=lambda x: x[1])\n    return min_tuple[0]"}
