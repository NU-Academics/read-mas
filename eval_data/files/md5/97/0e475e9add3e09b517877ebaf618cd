llow_bool)\n        except NoNumericValuesError:\n            return None\nclass MaxFinderController:\n    \"\"\"Public interface for library calls, validates input, and coordinates service calls.\"\"\"\n    def __init__(self, service: MaxFinderService) -> None:\n        self.service = service\n\n    def find_max(self, items: Iterable[Any], convert_str: bool=False, allow_bool: bool=False, none_if_empty: bool=False) -> Union[float, int, None]:\n        \"\"\"Finds the maximum numeric value in an iterable.\"\"\"\n        if not is_iterable(items):\n            raise InvalidInputError(\"Input 'items' must be an iterable.\")\n\n        if none_if_empty:\n            return self.service.compute_max_or_none(items, convert_str=convert_str, allow_bool=allow_bool)\n        else:\n            return self.service.compute_max(items, convert_str=convert_str, allow_bool=allow_bool)\n_adapter = TypeAdapter()\n_service = MaxFinderService(_adapter)\n_controller = MaxFinderController(_service)\ndef max_val(items: Iterable[Any], convert_str: bool=False, allow_bool: bool=False, none_if_empty: bool=False) -> Union[float, int, None]:\n    \"\"\"\n    Computes the maximum numeric value from a heterogeneous iterable.\n    Non-numeric items are ignored by default.\n    \"\"\"\n    return _controller.find_max(items, convert_str=convert_str, allow_bool=allow_bool, none_if_empty=none_if_empty)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[["3.14", false, 7.5]]]}], "Mbpp/300": [{"task_id": "Mbpp/300", "solution": "def count_binary_seq(n):\n    \"\"\"Return the number of binary sequences of length 2n where the sum of the first n bits\n    equals the sum of the last n bits (which equals C(2n, n)).\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    import math\n    # Prefer math.comb when available (Python 3.8+)\n    if hasattr(math, \"comb\"):\n        return math.comb(2 * n, n)\n    # Fallback multiplicative computation for C(2n, n)\n    result = 1\n    for i in range(1, n + 1):\n        result = result * (n + i) // i\n    return result", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[50]]}], "Mbpp/305": [{"task_id": "Mbpp/305", "solution": "def start_withp(inputs: list[str]) -> tuple[str, str]:\n    \"\"\"\n    Return the first two words (preserving original casing) from a list of strings\n    that start with the letter 'p' (case-insensitive). Tokens are split on\n    whitespace and stripped of leading/trailing punctuation.\n    Raises:\n      - TypeError: if inputs is not a list or contains non-string elements.\n      - ValueError: if fewer than two matching words are found.\n    \"\"\"\n    if not isinstance(inputs, list):\n        raise TypeError(\"inputs must be a list of strings\")\n\n    import string\n    trim_chars = string.whitespace + string.punctuation\n\n    found: list[str] = []\n    for idx, item in enumerate(inputs):\n        if not isinstance(item, str):\n            raise TypeError(f\"element at index {idx} is not a string\")\n        for token in item.split():\n            cleaned = token.strip(trim_chars)\n            if cleaned and cleaned[0].lower() == 'p':\n                found.append(cleaned)\n                if len(found) == 2:\n                    return (found[0], found[1])\n\n    raise ValueError(f\"expected 2 words starting with 'p', found {len(found)}\")", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[]]]}], "Mbpp/301": [{"task_id": "Mbpp/301", "solution": "def dict_depth(d):\n    if not isinstance(d, dict):\n        return 0\n    max_child = 0\n    for v in d.values():\n        if isinstance(v, dict):\n            child_depth = dict_depth(v)\n            if child_depth > max_child:\n                max_child = child_depth\n    return 1 + max_child", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/306": [{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr, n, i, k):\n    def compute_prefix_best_sums(arr: list, i: int, limit_val: int) -> int:\n        \"\"\"\n        Computes the maximum sum of an increasing subsequence ending with a value < limit_val,\n        using only elements from arr[0..i].\n        \"\"\"\n        dp = [0] * (i + 1)\n        for j in range(0, i + 1):\n            dp[j] = arr[j]\n            for t in range(j):\n                if arr[t] < arr[j] and dp[t] + arr[j] > dp[j]:\n                    dp[j] = dp[t] + arr[j]\n\n        best = 0\n        for j in range(0, i + 1):\n            if arr[j] < limit_val and dp[j] > best:\n                best = dp[j]\n        return best\n\n    target = arr[k]\n    pref_best = compute_prefix_best_sums(arr, i, target)\n    return pref_best + target", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/310": [{"task_id": "Mbpp/310", "solution": "def string_to_tuple(s: str) -> tuple[str, ...]:\n    \"\"\"Converts a string into a tuple of its characters.\n\n    This function iterates through the input string and collects each character into a tuple.\n    \"\"\"\n    return tuple(s)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["python 3.0"]], "plus_fail_tests": [["hello   world"]]}], "Mbpp/299": [{"task_id": "Mbpp/299", "solution": "from abc import ABC, abstractmethod\nfrom dataclasses import dataclass\nfrom typing import Any, Dict, Iterable, List, Tuple, Union\nclass DomainError(Exception):\n    \"\"\"Custom exception for domain-specific errors.\n    Used for invalid input data or operational issues within the domain logic.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef validate_record(record: Tuple[Any, Any]) -> NameScore:\n    \"\"\"Validates a raw record and converts it to a NameScore object.\n    Ensures that the record consists of a string name and a numeric value.\n    \"\"\"\n    if not isinstance(record, (list, tuple)) or len(record) != 2:\n        raise DomainError(f\"Invalid record shape: {record}\")\n    name, value = record\n    if not isinstance(name, str):\n        raise DomainError(f\"Name must be str: {name}\")\n    if not isinstance(value, (int, float)):\n        raise DomainError(f\"Value must be numeric: {value}\")\n    return NameScore(name, float(value))\ndef normalize_name(name: str, case_sensitive: bool = True) -> str:\n    \"\"\"Normalizes a given name based on the case sensitivity setting.\n    By default, names are treated as case-sensitive and returned unchanged.\n    \"\"\"\n    if not case_sensitive:\n        return name.lower()\n    return name\nclass ScoreRepository(ABC):\n    \"\"\"Abstract base class for score repositories.\n    Defines the interface for retrieving NameScore records.\n    \"\"\"\n    @abstractmethod\n    def get_all(self) -> List[NameScore]:\n        \"\"\"Abstract method to retrieve all NameScore records.\"\"\"\n        raise NotImplementedError\nclass InMemoryRepository(ScoreRepository):\n    \"\"\"In-memory implementation of ScoreRepository.\n    Stores and provides NameScore objects from an initial iterable of raw data.\n    \"\"\"\n    def __init__(self, data: Iterable[Tuple[str, Union[int, float]]]):\n        self._raw_data = list(data)\n        self._records: List[NameScore] = []\n        self._load()\n\n    def _load(self) -> None:\n        \"\"\"Internal method to load and validate raw data into NameScore objects.\"\"\"\n        for rec in self._raw_data:\n            self._records.append(validate_record(rec))\n\n    def get_all(self) -> List[NameScore]:\n        \"\"\"Returns all NameScore records currently stored in memory.\"\"\"\n        return list(self._records)\nclass Aggregator:\n    \"\"\"Encapsulates the core logic for aggregating scores and finding the maximum.\n    It takes NameScore objects, aggregates their values by name, and identifies the name with the highest total.\n    \"\"\"\n    def _aggregate(self, records: Iterable[NameScore]) -> Dict[str, float]:\n        \"\"\"Aggregates scores by normalized name, returning a dictionary of totals.\"\"\"\n        totals = {}\n        for r in records:\n            key = normalize_name(r.name)\n            totals[key] = totals.get(key, 0.0) + float(r.value)\n        return totals\n\n    def compute(self, records: Iterable[NameScore]) -> MaxAggregateResult:\n        \"\"\"Computes the name with the maximum aggregate score from a collection of records.\"\"\"\n        totals = self._aggregate(records)\n        if not totals:\n            return MaxAggregateResult(\"\", 0.0)\n        name, total = max(totals.items(), key=lambda kv: kv[1])\n        return MaxAggregateResult(name, total)\nclass AggregateService:\n    \"\"\"Orchestrates interactions between repositories and the aggregator.\n    Provides methods to retrieve and process score data to find the maximum aggregate.\n    \"\"\"\n    def __init__(self, repository: ScoreRepository, aggregator: Aggregator):\n        self._repository = repository\n        self._aggregator = aggregator\n\n    def get_max_aggregate(self) -> MaxAggregateResult:\n        \"\"\"Retrieves all records from the injected repository and computes their max aggregate.\"\"\"\n        records = self._repository.get_all()\n        return self._aggregator.compute(records)\n\n    def get_max_from_data(self, data: Iterable[Tuple[str, Union[int, float]]]) -> MaxAggregateResult:\n        \"\"\"Convenience method to compute max aggregate directly from raw data.\n        It internally uses an InMemoryRepository to process the provided data.\n        \"\"\"\n        repo = InMemoryRepository(data)\n        return self._aggregator.compute(repo.get_all())\ndef max_aggregate(data: Iterable[Tuple[str, Union[int, float]]]) -> Tuple[str, float]:\n    \"\"\"Calculates the maximum aggregate score from a list of (name, value) tuples.\n    This function serves as the main public API entry point.\n    \"\"\"\n    service = AggregateService(InMemoryRepository(data), Aggregator())\n    result = service.get_max_aggregate()\n    return result.to_tuple()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/308": [{"task_id": "Mbpp/308", "solution": "import heapq\ndef large_product(list_a, list_b, k):\n    \"\"\"\n    Finds the specified number of largest products from two lists, selecting one factor from each.\n    Uses a max-heap approach to efficiently find the top-k products.\n    \"\"\"\n    a_sorted = sorted(list_a, reverse=True)\n    b_sorted = sorted(list_b, reverse=True)\n\n    n, m = len(a_sorted), len(b_sorted)\n\n    if n == 0 or m == 0 or k <= 0:\n        return []\n\n    # Use a min-heap to simulate a max-heap by storing negative products.\n    # Each item in the heap is (-product, index_a, index_b).\n    heap = []\n    # Keep track of visited index pairs to avoid duplicate pushes to the heap.\n    visited = set()\n\n    # Start with the product of the largest elements from both lists (a[0]*b[0]).\n    initial_product = a_sorted[0] * b_sorted[0]\n    heapq.heappush(heap, (-initial_product, 0, 0))\n    visited.add((0, 0))\n\n    results = []\n\n    while heap and len(results) < k:\n        neg_prod, i, j = heapq.heappop(heap)\n        results.append(-neg_prod)\n\n        # Explore the next possible largest products by moving to the next element\n        # in either list, ensuring no index pair is processed twice.\n\n        # Consider moving to the next element in a_sorted\n        if i + 1 < n and (i + 1, j) not in visited:\n            next_product = a_sorted[i + 1] * b_sorted[j]\n            heapq.heappush(heap, (-next_product, i + 1, j))\n            visited.add((i + 1, j))\n\n        # Consider moving to the next element in b_sorted\n        if j + 1 < m and (i, j + 1) not in visited:\n            next_product = a_sorted[i] * b_sorted[j + 1]\n            heapq.heappush(heap, (-next_product, i, j + 1))\n            visited.add((i, j + 1))\n\n    # Sort the collected products in descending order as required.\n    results.sort(reverse=True)\n\n    return results", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[-14, 95, -14, true, -100, true, -93, -93, 28, -100, -58, -93], [-14, 95, -14, true, -100, true, -93, -93, 28, -100, -58, -93], 1]]}], "Mbpp/312": [{"task_id": "Mbpp/312", "solution": "import math\ndef volume_cone(radius: float, height: float) -> float:\n    \"\"\"Calculates the volume of a cone given its radius and height.\"\"\"\n    return (1/3) * math.pi * (radius ** 2) * height", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/311": [{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input must be a non-negative integer\")\n    if n == 0:\n        return 1\n    msb_pos = n.bit_length() - 1\n    for pos in range(msb_pos, -1, -1):\n        if ((n >> pos) & 1) == 0:\n            return n | (1 << pos)\n    return n | (1 << (msb_pos + 1))", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[15]], "plus_fail_tests": [[255]]}], "Mbpp/388": [{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n):\n    \"\"\"\n    Finds the highest power of 2 that is less than or equal to n.\n    Assumes n is a positive integer.\n    \"\"\"\n    return 1 << (n.bit_length() - 1)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/390": [{"task_id": "Mbpp/390", "solution": "def add_string(items, fmt):\n    \"\"\"Apply a format string to all elements in an iterable and return a list of formatted strings.\n\n    Example:\n        add_string([1, 2, 3, 4], 'temp{0}') -> ['temp1', 'temp2', 'temp3', 'temp4']\n   