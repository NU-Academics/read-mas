ry to increment the rightmost index\n            for pos in reversed(range(n)):\n                if indices[pos] + 1 < k:\n                    indices[pos] += 1\n                    # Reset all indices to the right of the incremented position to 0\n                    for j in range(pos + 1, n):\n                        indices[j] = 0\n                    break\n            else:\n                # If no index could be incremented, all combinations have been generated\n                return\n\n    return list(_generate_iterative_combinations())", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[["Red", "Green", "Blue"], 2]], "plus_fail_tests": [[["A", "B", "C", "D"], 4]]}], "Mbpp/765": [{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    \"\"\"Finds the nth polite number. A polite number is a positive integer that is not a power of two.\n\n    :param n: 1-based index of the polite number to return\n    :raises TypeError: if n is not an int\n    :raises ValueError: if n < 1\n    :return: the nth polite number\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n\n    def _is_power_of_two(x: int) -> bool:\n        return x > 0 and (x & (x - 1)) == 0\n\n    polite_count = 0\n    candidate = 1\n\n    while True:\n        if not _is_power_of_two(candidate):\n            polite_count += 1\n            if polite_count == n:\n                return candidate\n        candidate += 1", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[1000000000]]}]}}