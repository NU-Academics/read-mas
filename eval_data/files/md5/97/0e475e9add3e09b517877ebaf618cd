"\"Represents a single record with a name and a numeric value.\"\"\"\n        def __init__(self, name: str, value: int) -> None:\n            self.name: str = name\n            self.value: int = value\n\n        def to_tuple(self) -> Tuple[str,int]:\n            \"\"\"Returns the record as a (name, value) tuple.\"\"\"\n            return (self.name, self.value)\n\n        def __iter__(self) -> Iterator[Union[str, int]]:\n            \"\"\"Allows unpacking the record into (name, value).\"\"\"\n            return iter((self.name, self.value))\n\n    class Validator:\n        \"\"\"Utility class for validating input records and k value.\"\"\"\n        def validate_records(self, raw: Sequence[Tuple[Any,Any]]) -> List[Tuple[str,int]]:\n            \"\"\"Validates and converts raw records to a list of (str, int) tuples.\"\"\"\n            if not isinstance(raw, (list, tuple)):\n                raise InvalidInputError(\"Records must be a list or tuple.\")\n\n            validated_records: List[Tuple[str,int]] = []\n            for i, item in enumerate(raw):\n                if not isinstance(item, (list, tuple)) or len(item) != 2:\n                    raise InvalidInputError(f\"Record at index {i} must be a 2-item tuple/list.\")\n\n                name_raw, value_raw = item\n                try:\n                    name = str(name_raw)\n                except Exception:\n                    raise InvalidInputError(f\"Record name at index {i} cannot be converted to string: {name_raw}\")\n\n                try:\n                    value = int(value_raw)\n                except (ValueError, TypeError):\n                    raise InvalidInputError(f\"Record value at index {i} cannot be converted to integer: {value_raw}\")\n\n                validated_records.append((name, value))\n            return validated_records\n\n        def validate_k(self, k_raw: Any) -> int:\n            \"\"\"Validates and converts k to a non-negative integer.\"\"\"\n            try:\n                k = int(k_raw)\n            except (ValueError, TypeError):\n                raise InvalidInputError(f\"k must be an integer: {k_raw}\")\n\n            if k < 0:\n                raise InvalidInputError(\"k must be a non-negative integer.\")\n            return k\n\n    def comparator_key(record: Record) -> Tuple[int, str]:\n        \"\"\"Returns a tuple (value, name) for sorting records.\"\"\"\n        return (record.value, record.name)\n\n    class MinKRequest:\n        \"\"\"Data Transfer Object for requesting minimum k records.\"\"\"\n        def __init__(self, records_raw: Sequence[Tuple[str,int]], k: int) -> None:\n            self.records: List[Record] = [Record(name, value) for name, value in records_raw]\n            self.k: int = k\n\n    class MinKResponse:\n        \"\"\"Data Transfer Object for returning minimum k records.\"\"\"\n        def __init__(self, results: List[Record]) -> None:\n            self.results: List[Record] = results\n\n        def to_tuples(self) -> List[Tuple[str,int]]:\n            \"\"\"Converts results to a list of (name, value) tuples.\"\"\"\n            return [r.to_tuple() for r in self.results]\n\n    class InMemoryRepository:\n        \"\"\"Repository for loading raw input into Record objects.\"\"\"\n        def __init__(self, raw: List[Tuple[str,int]]) -> None:\n            self._raw = raw\n\n        def load(self) -> List[Record]:\n            \"\"\"Loads raw tuples into Record objects.\"\"\"\n            return [Record(name, value) for name, value in self._raw]\n\n    class MinKService:\n        \"\"\"Service layer containing the core logic to select minimum k records.\"\"\"\n        def __init__(self, repository: InMemoryRepository, validator: Validator) -> None:\n            self.repository = repository\n            self.validator = validator\n\n        def min_k(self, request: MinKRequest) -> MinKResponse:\n            \"\"\"Main service method to find the minimum k records.\"\"\"\n            records = self.repository.load()\n            k = request.k\n\n            if k == 0:\n                return MinKResponse([])\n\n            selected = self._select_min_k(records, k)\n            return MinKResponse(selected)\n\n        def _select_min_k(self, records: List[Record], k: int) -> List[Record]:\n            \"\"\"Selects the k smallest records using a min-heap.\"\"\"\n            return heapq.nsmallest(k, records, key=comparator_key)\n\n    validator = Validator()\n\n    validated_records_tuples = validator.validate_records(records)\n\n    validated_k = validator.validate_k(k)\n\n    repo = InMemoryRepository(validated_records_tuples)\n\n    service = MinKService(repo, validator)\n\n    req = MinKRequest(validated_records_tuples, validated_k)\n\n    resp = service.min_k(req)\n\n    return [r.to_tuple() for r in resp.results]", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[["Manjeet", 10], ["Akshat", 10], ["Akash", 10], ["Nikhil", 10]], 2]]}], "Mbpp/755": [{"task_id": "Mbpp/755", "solution": "def second_smallest(numbers):\n    \"\"\"\n    Finds the second smallest number in a list.\n    This implementation handles duplicates, considering them in the sorted order.\n    \"\"\"\n    if not hasattr(numbers, \"__iter__\"):\n        raise TypeError(\"numbers must be an iterable\")\n\n    # Convert to iterator and attempt to get first two items\n    it = iter(numbers)\n    try:\n        first = float(next(it))\n    except StopIteration:\n        raise ValueError(\"Need at least two elements to find the second smallest.\")\n    try:\n        second = float(next(it))\n    except StopIteration:\n        raise ValueError(\"Need at least two elements to find the second smallest.\")\n\n    if second < first:\n        min1, min2 = second, first\n    else:\n        min1, min2 = first, second\n\n    for x in it:\n        v = float(x)\n        if v < min1:\n            min2 = min1\n            min1 = v\n        elif v < min2:\n            min2 = v\n\n    return min2", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 1, -0.5, 0, 2, -2, -2]]], "plus_fail_tests": [[[3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5, 8, 9, 7, 9]]]}], "Mbpp/758": [{"task_id": "Mbpp/758", "solution": "def unique_sublists(sublists):\n    \"\"\"Counts occurrences of sublists, returning a dictionary with tuple keys and integer counts.\"\"\"\n    counts = {}\n    for sublist in sublists:\n        # Convert each sublist to a tuple to use it as a dictionary key.\n        sublist_as_tuple = tuple(sublist)\n        counts[sublist_as_tuple] = counts.get(sublist_as_tuple, 0) + 1\n    return counts", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/760": [{"task_id": "Mbpp/760", "solution": "def unique_Element(lst) -> bool:\n    \"\"\"\n    Checks if a list of numbers contains only one distinct element.\n    Returns True if all elements are identical, or False otherwise.\n    \"\"\"\n    return len(set(lst)) == 1", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/745": [{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum, endnum):\n    \"\"\"\n    Finds numbers within a given inclusive range [startnum, endnum] where every number\n    is divisible by every non-zero digit it contains. Numbers containing digit 0 are excluded.\n    \"\"\"\n    if not isinstance(startnum, int) or not isinstance(endnum, int):\n        raise TypeError(\"startnum and endnum must be integers\")\n    if startnum > endnum:\n        raise ValueError(\"startnum must be <= endnum\")\n\n    result = []\n    for num in range(startnum, endnum + 1):\n        # handle negative numbers by using absolute value for digit check,\n        # but divisibility uses the original number semantics (negative % positive).\n        s = str(abs(num))\n        valid = True\n        for ch in s:\n            d = int(ch)\n            if d == 0 or num % d != 0:\n                valid = False\n                break\n        if valid:\n            result.append(num)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/754": [{"task_id": "Mbpp/754", "solution": "from typing import List, Any, Optional\nclass InvalidListError(ValueError):\n    \"\"\"Exception raised for invalid list inputs.\"\"\"\n    pass\nclass ProcessingError(RuntimeError):\n    \"\"\"Exception raised for unexpected errors during list processing.\"\"\"\n    pass\nclass ExtractionResult:\n    \"\"\"DTO for storing common indices and elements.\"\"\"\n    def __init__(self, common_indices: List[int], common_elements: List[Any]):\n        self.common_indices = list(common_indices)\n        self.common_elements = list(common_elements)\n\n    def to_list(self) -> List[Any]:\n        \"\"\"Returns a copy of the common elements list.\"\"\"\n        return list(self.common_elements)\ndef _is_list_like(obj: Any) -> bool:\n    \"\"\"Checks if an object behaves like a list (has length and is indexable).\"\"\"\n    return isinstance(obj, (list, tuple)) or (hasattr(obj, '__len__') and hasattr(obj, '__getitem__'))\nclass ListValidator:\n    \"\"\"Validates if inputs are list-like and conform to optional length constraints.\"\"\"\n    def validate(self, l1: Any, l2: Any, l3: Any, max_length: Optional[int] = None) -> bool:\n        \"\"\"Validates three inputs against list-like properties and optional max_length.\"\"\"\n        for name, obj in (('l1', l1), ('l2', l2), ('l3', l3)):\n            if not _is_list_like(obj):\n                raise InvalidListError(f\"{name} is not list-like\")\n            if max_length is not None and len(obj) > max_length:\n                raise InvalidListError(f\"{name} length ({len(obj)}) exceeds maximum allowed length ({max_length})\")\n        return True\nclass ExtractIndexService:\n    \"\"\"Core service for finding elements common at the same index across three lists.\"\"\"\n    def __init__(self, validator: ListValidator = None):\n        self.validator = validator or ListValidator()\n\n    def find_common(self, l1: List[Any], l2: List[Any], l3: List[Any]) -> ExtractionResult:\n        \"\"\"Finds elements that appear in all three lists at the same index.\"\"\"\n        self.validator.validate(l1, l2, l3)\n        try:\n            min_len = min(len(l1), len(l2), len(l3))\n            indices = []\n            elements = []\n            for i in range(min_len):\n                if l1[i] == l2[i] == l3[i]:\n                    indices.append(i)\n                    elements.append(l1[i])\n            return ExtractionResult(indices, elements)\n        except Exception as exc:\n            raise ProcessingError(\"Error while processing lists: an element could not be accessed or compared.\") from exc\nclass APIController:\n    \"\"\"Controller for the programmatic API, wrapping the core service.\"\"\"\n    def __init__(self, service: ExtractIndexService = None):\n        self.service = service or ExtractIndexService()\n\n    def extract_index_list(self, l1: List[Any], l2: List[Any], l3: List[Any]) -> List[Any]:\n        \"\"\"Exposes the common element extraction logic as a simple API call.\"\"\"\n        return self.service.find_common(l1, l2, l3).to_list()\n_service = ExtractIndexService()\n_api = APIController(service=_service)\ndef extract_index_list(l1: List[Any], l2: List[Any], l3: List[Any]) -> List[Any]:\n    \"\"\"\n    Finds elements that appear in all three lists under the same index.\n\n    The function returns a list of common elements.\n    \"\"\"\n    return _api.extract_index_list(l1, l2, l3)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/759": [{"task_id": "Mbpp/759", "solution": "import re\ndef is_decimal(value: str) -> bool:\n    \"\"\"Checks if a string represents a decimal number with exactly two fractional digits.\"\"\"\n    def _normalize_str(s: str) -> str:\n        return s.strip()\n\n    normalized_value = _normalize_str(value)\n    pattern = r\"^[+-]?\\d+\\.\\d{2}$\"\n    return re.fullmatch(pattern, normalized_value) is not None", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["-123.11"]]}], "Mbpp/763": [{"task_id": "Mbpp/763", "solution": "def find_min_diff(arr, n):\n    \"\"\"\n    Finds the minimum absolute difference between any two elements in the given array.\n    Considers the first 'n' elements of arr.\n\n    Args:\n        arr: Iterable of numbers (e.g., list or tuple).\n        n: Number of elements from the start of arr to consider (int).\n\n    Returns:\n        int or float: The minimum absolute difference.\n\n    Raises:\n        ValueError: If n is greater than the number of elements in arr or fewer than 2 elements are considered.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    length = len(arr)\n    if n > length:\n        raise ValueError(\"n cannot be greater than the length of arr\")\n    if n < 2:\n        raise ValueError(\"At least two elements are required to compute a difference\")\n\n    # Consider first n elements and sort them\n    list_to_consider = list(arr)[:n]\n    sorted_list = sorted(list_to_consider)\n\n    # Initialize min_diff with the first adjacent pair\n    min_diff = abs(sorted_list[1] - sorted_list[0])\n\n    # Iterate adjacent pairs to find the minimum difference\n    for a, b in zip(sorted_list, sorted_list[1:]):\n        current_diff = abs(b - a)\n        if current_diff < min_diff:\n            min_diff = current_diff\n            if min_diff == 0:\n                return 0\n\n    return min_diff", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/762": [{"task_id": "Mbpp/762", "solution": "def check_monthnumber_number(month: int) -> bool:\n    \"\"\"\n    Checks if the given month number (1-12) has exactly 30 days.\n    Months with 3