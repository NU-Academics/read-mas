ist[ComputationRecord] = []\n        self._lock = threading.Lock()\n\n    def save(self, record: ComputationRecord) -> None:\n        \"\"\"Appends a computation record to the store.\"\"\"\n        with self._lock:\n            self._store.append(record)\n\n    def list_recent(self, limit: int = 10) -> list[ComputationRecord]:\n        \"\"\"Returns the last 'limit' computation records.\"\"\"\n        with self._lock:\n            return list(reversed(self._store[-limit:]))\nclass MinimumService:\n    \"\"\"Business logic to compute minimum and persist computation records.\"\"\"\n    def __init__(self, repo: InMemoryRepository) -> None:\n        self._repo = repo\n\n    def find_min(self, a: float, b: float) -> float:\n        \"\"\"Computes the minimum of two floats, persists the record, and returns the result.\"\"\"\n        result = a if a <= b else b\n        self._persist(a, b, result)\n        return result\n\n    def _persist(self, a: float, b: float, result: float) -> None:\n        \"\"\"Creates and saves a ComputationRecord.\"\"\"\n        rec = ComputationRecord(\n            id=str(uuid.uuid4()),\n            a=a, b=b, result=result,\n            timestamp=datetime.datetime.utcnow().isoformat() + \"Z\"\n        )\n        self._repo.save(rec)\nclass MinimumController:\n    \"\"\"Mediates between input parsing, service logic, and output.\"\"\"\n    def __init__(self, service: MinimumService) -> None:\n        self._service = service\n\n    def compute(self, a: object, b: object) -> float:\n        \"\"\"Parses inputs, computes the minimum via service, and returns the float result.\"\"\"\n        a_f = parse_number(a)\n        b_f = parse_number(b)\n        return self._service.find_min(a_f, b_f)\n_default_service = MinimumService(InMemoryRepository())\ndef minimum(a: object, b: object) -> float:\n    \"\"\"\n    Computes the minimum of two numbers, providing a public API.\n    Handles various numeric input types and persists computation records.\n    \"\"\"\n    controller = MinimumController(_default_service)\n    return controller.compute(a, b)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[10000000000000000000000, -9999999999999999999999]]}], "Mbpp/410": [{"task_id": "Mbpp/410", "solution": "from typing import Sequence, Any, Union\nimport decimal\nclass InvalidInputError(TypeError):\n    \"\"\"Raised when the input is not a valid sequence type.\"\"\"\n    pass\nclass NoNumericElementsError(ValueError):\n    \"\"\"Raised when no numeric elements are found in the input sequence.\"\"\"\n    pass\ndef min_val(values: Sequence[Any]) -> Union[int, float]:\n    \"\"\"\n    Finds the minimum numeric value from a heterogeneous sequence.\n    Non-numeric elements are ignored; Decimal values are converted to float.\n    \"\"\"\n    if not hasattr(values, \"__iter__\"):\n        raise InvalidInputError(\"Input must be an iterable sequence.\")\n\n    numeric_values = []\n    for item in values:\n        if isinstance(item, int):\n            numeric_values.append(item)\n        elif isinstance(item, float):\n            numeric_values.append(item)\n        elif isinstance(item, decimal.Decimal):\n            # Convert Decimal to float to ensure the return type is int or float\n            numeric_values.append(float(item))\n\n    if not numeric_values:\n        raise NoNumericElementsError(\"No numeric elements found in the input list.\")\n\n    return min(numeric_values)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[["Python", 10, 5, 2.5, 2.5, "version"]]]}], "Mbpp/412": [{"task_id": "Mbpp/412", "solution": "from typing import List\nfrom .services import ListFilterService\ndef remove_odd(numbers: List[int]) -> List[int]:\n    \"\"\"\n    Simple facade: return list of even integers preserving order.\n    \"\"\"\n    service = ListFilterService()\n    return service.remove_odd(numbers)", "base_status": "fail", "plus_status": "fail", "bas