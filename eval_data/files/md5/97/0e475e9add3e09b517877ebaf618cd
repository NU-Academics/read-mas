th_param, \"length\")\n            base_obj = TriangleBase(b, h)\n            prism = TriangularPrism(base_obj, l)\n            return prism.volume()\n\n    svc = VolumeService()\n    return svc.compute_volume(base, height, length)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/20": [{"task_id": "Mbpp/20", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nMAX_ITER_K: int = 1000\nclass WoodallValidator:\n    \"\"\"Validates and normalizes inputs.\"\"\"\n    def validate_integer(self, n: any) -> int:\n        \"\"\"Ensures input is a non-negative integer, raising InvalidInputError if not.\"\"\"\n        if isinstance(n, str):\n            try:\n                n = int(n)\n            except ValueError:\n                raise InvalidInputError(\"Input must be a valid integer or numeric string.\")\n        if not isinstance(n, int):\n            raise InvalidInputError(\"Input must be an integer.\")\n        if n < 0:\n            raise InvalidInputError(\"Input must be a non-negative integer.\")\n        return n\nclass WoodallCalculator:\n    \"\"\"Provides the core algorithm to detect Woodall numbers.\"\"\"\n    def is_woodall_value(self, n: int) -> bool:\n        \"\"\"Determines if n is a Woodall number by iterating k.\"\"\"\n        if n < 0:\n            raise ValueError(\"n must be non-negative\")\n\n        k = 0\n        while True:\n            v = self._k_times_two_pow_k(k) - 1\n            if v == n:\n                return True\n            if v > n or k > MAX_ITER_K:\n                return False\n            k += 1\n\n    def find_k_for(self, n: int) -> int | None:\n        \"\"\"Finds the k value for a Woodall number n, or None if not Woodall.\"\"\"\n        if n < 0:\n            return None\n        k = 0\n        while True: