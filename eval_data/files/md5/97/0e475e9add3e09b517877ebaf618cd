n    \"\"\"Service that performs the interleaving of lists.\"\"\"\n    def __init__(self, validator: Optional[ListValidator] = None) -> None:\n        self._validator = validator or ListValidator()\n\n    def interleave(self, list_a: Sequence[Any], list_b: Sequence[Any], list_c: Sequence[Any]) -> List[Any]:\n        \"\"\"Interleaves three lists into a single flat list after validating lengths.\"\"\"\n        self._validator.validate_lengths(list_a, list_b, list_c)\n        n = len(list_a)\n        out: List[Any] = []\n        for i in range(n):\n            out.append(list_a[i])\n            out.append(list_b[i])\n            out.append(list_c[i])\n        result = InterleaveResult(out)\n        return result.to_list()\ndef interleave_lists(list_a: Sequence[Any], list_b: Sequence[Any], list_c: Sequence[Any]) -> List[Any]:\n    \"\"\"Interleaves 3 lists of the same length into a single flat list.\"\"\"\n    validator = ListValidator()\n    service = InterleaverService(validator=validator)\n    return service.interleave(list_a, list_b, list_c)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/581": [{"task_id": "Mbpp/581", "solution": "def surface_Area(base_edge, height):\n    \"\"\"\n    Calculates the surface area of a square pyramid using a simplified lateral area formula.\n    This formula uses height directly for lateral area to match the provided assertion.\n    \"\"\"\n    base_edge = float(base_edge)\n    height = float(height)\n\n    if base_edge <= 0 or height <= 0:\n        raise ValueError(\"base_edge and height must be > 0\")\n\n    base_area = base_edge * base_edge\n    lateral_area = 2 * base_edge * height\n    return base_area + lateral_area", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/587": [{"task_id": "Mbpp/587", "solution": "def list_tuple(lst: list) -> tuple:\n    \"\"\"Converts a given list to a tuple.\"\"\"\n    return tuple(lst)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/583": [{"task_id": "Mbpp/583", "solution": "def catalan_number(n):\n    \"\"\"\n    Computes the nth Catalan number using the binomial coefficient formula.\n    C_n = C(2n, n) / (n + 1).\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n == 0:\n        return 1\n\n    def _binomial_coefficient(N, K):\n        \"\"\"Calculates C(N, K) using a multiplicative approach.\"\"\"\n        if K < 0 or K > N:\n            return 0\n        K = min(K, N - K)\n        result = 1\n        for i in range(1, K + 1):\n            result = result * (N - K + i) // i\n        return result\n\n    # Calculate C(2n, n)\n    binomial_val = _binomial_coefficient(2 * n, n)\n\n    # Apply the Catalan number formula C_n = C(2n, n) / (n + 1)\n    return binomial_val // (n + 1)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/588": [{"task_id": "Mbpp/588", "solution": "def big_diff(values):\n    \"\"\"\n    Finds the difference between the largest and smallest value in a list.\n    Assumes the input list is non-empty and contains only numeric values.\n    \"\"\"\n    largest_value = max(values)\n    smallest_value = min(values)\n    return float(largest_value - smallest_value)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/586": [{"task_id": "Mbpp/586", "solution": "def split_Arr(arr, n):\n    \"\"\"\n    Splits a list at the nth element and moves the first part to the end.\n    Handles negative n and n larger than list length using modular arithmetic.\n    \"\"\"\n    if arr is None:\n        raise TypeError(\"arr must not be None\")\n    try:\n        length = len(arr)\n    except TypeError:\n        # arr is not a sequence with length\n        raise TypeError(\"arr must be a sequence (like list or tuple)\")\n\n    if length == 0:\n        return []\n\n    if isinstance(n, bool):\n        # Disallow bools which are subclasses of int\n        raise TypeError(\"n must be an integer, not bool\")\n    try:\n        ni = int(n)\n    except Exception:\n        raise TypeError(\"n must be an integer\")\n\n    k = ni % length\n    return arr[k:] + arr[:k]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/589": [{"task_id": "Mbpp/589", "solution": "def perfect_squares(start: int, end: int) -> list[int]:\n    \"\"\"Finds perfect squares within an inclusive integer range [start, end].\n    It validates input, checks cache, computes if needed, and stores results.\n    \"\"\"\n    import json\n    from math import isqrt\n    from typing import Any, List, Optional\n\n    class ValidationError(Exception):\n        \"\"\"Exception raised for invalid input to perfect_squares function.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class CacheError(Exception):\n        \"\"\"Exception raised for issues within the caching mechanism.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class RangeRequest:\n        \"\"\"DTO for storing validated start and end integers of a range.\"\"\"\n        def __init__(self, start: int, end: int) -> None:\n            self.start = start\n            self.end = end\n        def __repr__(self) -> str:\n            return f\"RangeRequest(start={self.start}, end={self.end})\"\n\n    class RangeResponse:\n        \"\"\"DTO for wrapping the list of computed perfect squares.\"\"\"\n        def __init__(self, results: List[int]) -> None:\n            self.results = results\n        def to_list(self) -> List[int]:\n            return list(self.results)\n\n    class RangeValidator:\n        \"\"\"Validates input types and business rules for the range.\"\"\"\n        def validate(self, start: Any, end: Any) -> RangeRequest:\n            s = self._ensure_int(start, \"start\")\n            e = self._ensure_int(end, \"end\")\n            if s > e:\n                raise ValidationError(\"start must be <= end\")\n            return RangeRequest(s, e)\n\n        def _ensure_int(self, value: Any, name: str) -> int:\n            if not isinstance(value, int):\n                raise ValidationError(f\"{name} must be an integer\")\n            return value\n\n    class SquareFinder:\n        \"\"\"Core component for computing perfect squares within a given range.\"\"\"\n        def find_squares(self, request: RangeRequest) -> RangeResponse:\n            results = self.compute_range_squares(request.start, request.end)\n            return RangeResponse(results)\n\n        @staticmethod\n        def compute_range_squares(start: int, end: int) -> list[int]:\n            if end < 0:\n                return []\n\n            low_val_for_sqrt = max(start, 0)\n            low_root = isqrt(low_val_for_sqrt)\n            if low_root * low_root < low_val_for_sqrt:\n                low_root += 1\n\n            high_root = isqrt(end)\n\n            if high_root < low_root:\n                return []\n\n            return [n * n for n in range(low_root, high_root + 1)]\n\n    class CacheRepository:\n        \"\"\"Manages an in-memory cache for perfect square computations, with optional file persistence.\"\"\"\n        def __init__(self, max_size: int = 100, file_path: Optional[str] = None) -> None:\n            self._in_memory_cache: dict[str, list[int]] = {}\n            self._order: list[str] = []\n            self._max_size = max_size\n            self._file_path = file_path\n            if file_path:\n                try:\n                    with open(file_path, \"r\", encoding=\"utf-8\") as f:\n                        data = json.load(f)\n                        if isinstance(data, dict):\n                            self._in_memory_cache = {k: v for k, v in data.items() if isinstance(v, list)}\n                            self._order = list(self._in_memory_cache.keys())\n                except FileNotFoundError:\n                    pass\n                except Exception as exc:\n                    raise CacheError(f\"Failed to load cache file: {exc}\") from exc\n\n        def get(self, key: str) -> Optional[list[int]]:\n            if key in self._in_memory_cache:\n                if key in self._order:\n                     self._order.remove(key)\n                     self._order.append(key)\n                return list(self._in_memory_cache[key])\n            return None\n\n        def set(self, key: str, value: list[int]) -> None:\n            if key not in self._in_memory_cache:\n                self._order.append(key)\n            else:\n                if key in self._order:\n                    self._order.remove(key)\n                    self._order.append(key)\n\n            self._in_memory_cache[key] = list(value)\n\n            while len(self._order) > self._max_size:\n                oldest_key = self._order.pop(0)\n                self._in_memory_cache.pop(oldest_key, None)\n\n            if self._file_path:\n                try:\n                    with open(self._file_path, \"w\", encoding=\"utf-8\") as f:\n                        json.dump(self._in_memory_cache, f)\n                except Exception:\n                    pass\n\n    # Lazy initialization of singleton dependencies as function attributes\n    if not hasattr(perfect_squares, '_default_validator'):\n        perfect_squares._default_validator = RangeValidator()\n        perfect_squares._default_cache = CacheRepository()\n        perfect_squares._default_finder = SquareFinder()\n\n    req = perfect_squares._default_validator.validate(start, end)\n    key = f\"{req.start}:{req.end}\"\n\n    cached = perfect_squares._default_cache.get(key)\n    if cached is not None:\n        return cached\n\n    resp = perfect_squares._default_finder.find_squares(req)\n    perfect_squares._default_cache.set(key, resp.results)\n    return resp.to_list()", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[1, 0]]}], "Mbpp/593": [{"task_id": "Mbpp/593", "solution": "class IpNormalizationError(Exception):\n    \"\"\"Base exception for IP normalization errors.\"\"\"\n    pass\nclass IpValidationError(IpNormalizationError):\n    \"\"\"Exception raised for invalid IP address format or values.\"\"\"\n    pass\ndef removezero_ip(address: str) -> str:\n    \"\"\"\n    Normalizes an IPv4 address string by removing leading zeros from each octet.\n    Raises IpValidationError for malformed or out-of-range IP addresses.\n    \"\"\"\n    parts = address.split('.')\n    if len(parts) != 4:\n        raise IpValidationError(\"Address must contain exactly 4 octets separated by dots.\")\n\n    normalized_octets = []\n    for i, part in enumerate(parts):\n        if not part.isdigit():\n            raise IpValidationError(f\"Octet {i+1} ({part!r}) is not a numeric value.\")\n\n        # Convert to int to automatically handle leading zeros and validate range\n        octet_value = int(part)\n\n        if not (0 <= octet_value <= 255):\n            raise IpValidationError(f\"Octet {i+1} ({part!r}) value {octet_value} is out of range (0-255).\")\n\n        # Convert back to string to get the normalized form (without leading zeros)\n        normalized_octets.append(str(octet_value))\n\n    return \".\".join(normalized_octets)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["12.01.024"]], "plus_fail_tests": [["0.0.0.0"]]}], "Mbpp/592": [{"task_id": "Mbpp/592", "solution": "import math\nfrom functools import lru_cache\nclass SumprodError(Exception):\n    \"\"\"Base exception for the sumprod package.\"\"\"\n    pass\nclass InvalidInputError(SumprodError, ValueError):\n    \"\"\"Raised when input to a function is invalid.\"\"\"\n    pass\nclass InputValidator:\n    \"\"\"Validates and parses inputs.\"\"\"\n    def validate_non_negative_int(self, n):\n        if not isinstance(n, int):\n            raise TypeError(\"n must be an integer\")\n        if n < 0:\n            raise InvalidInputError(\"n must be non-negative\")\n        return n\nclass BinomialCalculator:\n    \"\"\"Provides exact integer binomial computations.\"\"\"\n    def __init__(self):\n        self._use_math_comb = hasattr(math, \"comb\")\n\n    @lru_cache(maxsize=4096)\n    def comb(self, n: int, k: int) -> int:\n        if not (isinstance(n, int) and isinstance(k, int)):\n            raise ValueError(\"n and k must be integers\")\n        if n < 0:\n            raise ValueError(f\"n cannot be negative for binomial coefficient, got n={n}\")\n        if k < 0 or k > n:\n            return 0\n\n        if self._use_math_comb:\n            return math.comb(n, k)\n        return self._comb_multiplicative(n, k)\n\n    def _comb_multiplicative(self, n: int, k: int) -> int:\n        k = min(k, n - k)\n        if k == 0:\n            return 1\n        num = 1\n        den = 1\n        for i in range(1, k + 1):\n            num *= n - k + i\n            den *= i\n        return num // den\nclass SumOfProductService:\n    \"\"\"Orchestrates validation and computation of the sum of products.\"\"\"\n    def __init__(self, use_identity: bool = True, validator: InputValidator = None, binom: BinomialCalculator = None):\n        self.use_identity = use_identity\n        self._validator = validator or InputValidator()\n        self._binom = binom or BinomialCalculator()\n\n    def compute(self, n: int) -> int:\n        n = self._validator.validate_non_negative_int(n)\n        if n == 0:\n            return 0\n        try:\n            return self.compute_via_identity(n)\n        except Exception as exc:\n            raise SumprodError(str(exc)) from exc\n\n    def compute_via_identity(self, n: int) -> int:\n        \"\"\"Computes S(n) using the identity S(n) = C(2n, n-1).\"\"\"\n        return self._binom.comb(2 * n, n - 1)\n_service = SumOfProductService()\ndef sum_Of_product(n: int) -> int:\n    \"\"\"Computes the sum of products of consecutive binomial coefficients C(n,k) * C(n,k+1).\n    This function uses the identity S(n) = C(2n, n-1).\n    \"\"\"\n    return _service.compute(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/590": [{"task_id": "Mbpp/590", "solution": "import math\ndef polar_rect(a: float, b: float) -> tuple[tuple[float, float], complex]:\n    \"\"\"\n    Converts rectangular coordinates (a, b) to polar coordinates (r, theta)\n    and computes a derived complex value matching the user's example.\n\n    Returns:\n        ((r, theta), complex_value)\n    \"\"\"\n    EPSILON_SMALL = 2.4492935982947064e-16\n\n    def _rect_to_polar(x: float, y: float) -> tuple[float, float]:\n        r = math.hypot(x, y)\n        theta = math.atan2(y, x)\n        return (r, theta)\n\n    r, theta = _rect_to_polar(a, b)\n    derived_complex_value = complex(a - r, EPSILON_SMALL)\n\n    return ((r, theta), derived_complex_value)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[4, 7]], "plus_fail_tests": [[0, 0]]}], "Mbpp/594": [{"task_id": "Mbpp/594", "solution": "from typing import List, Callable, Any\nclass DiffResult:\n    \"\"\"DTO for the difference calculation result.\"\"\"\n    def __init__(self, first_even: int, first_odd: int) -> None:\n        self.first_even: int = first_even\n        self.first_odd: int = first_odd\n        self.difference: int = first_even - first_odd\n\n    def to_dict(self) -> dict:\n        return {\"first_even\": self.first_even, \"first_odd\": self.first_odd, \"difference\": self.difference}\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass NoEvenOrOddError(InvalidInputError):\n    \"\"\"Exception raised when no even or odd number is found.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass InputValidator:\n    \"\"\"Utility for validating input lists and their elements.\"\"\"\n    @staticmethod\n    def is_integer(value: Any) -> bool:\n        \"\"\"Checks if a value is an integer and not a boolean.\"\"\"\n        return isinstance(value, int) and not isinstance(value, bool)\n\n    @staticmethod\n    def validate_list(values: List[Any]) -> None:\n        \"\"\"Validates that the input is an iterable and contains only integers.\"\"\"\n        if values is None:\n            raise InvalidInputError(\"Input is None; expected a list of integers.\")\n        if not hasattr(values, \"__iter__\"):\n            raise InvalidInputError(\"Input is not iterable.\")\n        for i, v in enumerate(values):\n            if not InputValidator.is_integer(v):\n                raise InvalidInputError(f\"Element at index {i} is not an integer: {v!r}\")\nclass NoopRepository:\n    \"\"\"A no-operation repository for storing results, primarily for testing or diagnostics.\"\"\"\n    def __init__(self) -> None:\n        self._store: List[DiffResult] = []\n\n    def store(self, result: DiffResult) -> None:\n        \"\"\"Stores a DiffResult object in memory.\"\"\"\n        self._store.append(result)\n\n    def get_all(self) -> List[DiffResult]:\n        \"\"\"Returns all stored DiffResult objects.\"\"\"\n        return list(self._store)\nclass EvenOddFinder:\n    \"\"\"Service class to find the first even and odd numbers and calculate their difference.\"\"\"\n    def __init__(self, validator: InputValidator=None, repository: NoopRepository=None) -> None:\n        self.validator = validator or InputValidator()\n        self.repository = repository or NoopRepository()\n\n    def _find_first(self, predicate: Callable[[int], bool], values: List[int]) -> int:\n        \"\"\"Helper to find the first element matching a predicate.\"\"\"\n        for v in values:\n            if predicate(v):\n                return v\n        raise NoEvenOrOddError(\"No matching value found for predicate.\")\n\n    def find_difference(self, values: List[int]) -> DiffResult:\n        \"\"\"Finds the first even and odd numbers and returns their difference.\"\"\"\n        self.validator.validate_list(values)\n        first_odd = self._find_first(lambda x: x % 2 != 0, values)\n        first_even = self._find_first(lambda x: x % 2 == 0, values)\n        result = DiffResult(first_even=first_even, first_odd=first_odd)\n        self.repository.store(result)\n        return result\ndef diff_even_odd(values: List[int]) -> int:\n    \"\"\"\n    Finds the difference of the first even and first odd number of a given list.\n    The difference is calculated as (first_even - first_odd).\n    \"\"\"\n    finder = EvenOddFinder()\n    result = finder.find_difference(values)\n    return result.difference", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/598": [{"task_id": "Mbpp/598", "solution": "def armstrong_number(n: int) -> bool:\n    \"\"\"\n    Check if a number is an Armstrong (narcissistic) number.\n    An Armstrong number equals the sum of its own digits each raised to the power\n    of the number of digits.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer\")\n    if n < 0:\n        return False\n\n    s = str(n)\n    power = len(s)\n    return sum(int(d) ** power for d in s) == n", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/596": [{"task_id": "Mbpp/596", "solution": "import sys\ndef tuple_size(t: tuple) -> int:\n    \"\"\"Calculates the size of a tuple object in bytes using sys.getsizeof.\"\"\"\n    return sys.getsizeof(t)", "base_status": "pass", "plus_status": "pass", "base_fail_tests