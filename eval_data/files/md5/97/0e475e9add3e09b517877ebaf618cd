 value = self._parse_token(s)\n                parsed.append(value)\n            except ValueError:\n                invalid.append(t)\n\n        if invalid:\n            raise InvalidNumericStringError(invalid)\n\n        return parsed\n\n    def _parse_token(self, token: str) -> int:\n        \"\"\"Parses a single string token into an integer, handling common formats.\"\"\"\n        token = token.strip()\n        return int(token)\nclass SortService:\n    \"\"\"Business logic for sorting numeric strings.\"\"\"\n    def __init__(self, parser: Optional[NumericParser] = None) -> None:\n        self._parser = parser or NumericParser()\n\n    def sort(self, tokens: Iterable[str]) -> SortResult:\n        \"\"\"Parses string tokens to integers, sorts them, and returns a SortResult.\"\"\"\n        ints = self._parser.parse_tokens(tokens)\n        sorted_vals = sorted(ints)\n        return SortResult(sorted_vals)\ndef sort_numeric_strings(strings: list[str]) -> list[int]:\n    \"\"\"\n    Sorts a given list of strings of numbers numerically, returning a list of integers.\n    This function acts as a convenience wrapper, orchestrating parsing and sorting.\n    \"\"\"\n    service = SortService(parser=NumericParser())\n    result = service.sort(strings)\n    return result.to_list()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/744": [{"task_id": "Mbpp/744", "solution": "from typing import Iterable, Any, Optional\nfrom .tuple_model import TupleModel\nfrom .repository import InMemoryRepository, CheckRepository\nfrom .check_service import CheckService\ndef check_none(values: Iterable[Any], repo: Optional[CheckRepository] = None) -> bool:\n    \"\"\"\n    Checks if any element in the given iterable is None.\n    Uses a CheckService to perform the check and optionally persist the result.\n    \"\"\"\n    model = TupleModel(values)\n    if repo is None:\n        repository_instance = InMemoryRepository()\n    else:\n        r