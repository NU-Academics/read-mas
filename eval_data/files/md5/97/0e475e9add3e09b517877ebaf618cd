   start = time.perf_counter()\n            try:\n                self.validator.validate(input_str)\n                result = CaseUtils.toggle_case(input_str)\n                duration_ms = (time.perf_counter() - start) * 1000.0\n                timestamp = datetime.datetime.utcnow().isoformat(timespec='milliseconds') + \"Z\"\n\n                res = ToggleResult(input=input_str, result=result, duration_ms=duration_ms, timestamp=timestamp)\n\n                if self.config.AUDIT_ENABLED:\n                    entry = AuditEntry(timestamp=timestamp,\n                                       input_masked=mask_input(input_str, self.config.MASK_LENGTH),\n                                       result=result,\n                                       duration_ms=duration_ms)\n                    try:\n                        self.repo.append(entry)\n                    except AuditError:\n                        # Audit failures should not prevent the operation from succeeding.\n                        pass\n                return res\n            except (InvalidTypeError, StringTooLongError):\n                raise\n            except Exception as e:\n                raise ToggleError(f\"Internal error: {e}\") from e\n\n    class ToggleController:\n        \"\"\"Provides an adapter API to the ToggleService.\"\"\"\n        def __init__(self, service: ToggleService):\n            self.service = service\n\n        def toggle(self, input_str: str) -> ToggleResult:\n            \"\"\"Delegates the toggling operation to the service.\"\"\"\n            return self.service.toggle(input_str)\n\n    # --- End of inline helper definitions ---\n\n    # Instantiate the dependency graph for a single execution\n    config = AppConfig()\n    validator = StringValidator(config.MAX_LENGTH)\n    repo = AuditRepository(config.AUDIT_PATH)\n    service = ToggleService(validator, repo, config)\n    controller = ToggleController(service)\n\n    # Execute the toggle operation and return the result s