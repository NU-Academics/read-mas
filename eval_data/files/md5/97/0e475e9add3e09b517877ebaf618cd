   max_overall_sum = max(max_overall_sum, current_sum)\n\n    return max_overall_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/250": [{"task_id": "Mbpp/250", "solution": "def count_X(tuple, element):\n    \"\"\"Counts the occurrences of an element within a tuple.\"\"\"\n    return tuple.count(element)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/251": [{"task_id": "Mbpp/251", "solution": "def insert_element(items, element):\n    \"\"\"\n    Inserts the given element before each element in the input list.\n    Returns a new list with the inserted elements, preserving original order.\n    \"\"\"\n    result_list = []\n    for item in items:\n        result_list.append(element)\n        result_list.append(item)\n    return result_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/247": [{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"\n    Return the length of the longest palindromic subsequence in the given string.\n    Normalizes input by removing non-alphanumeric characters and lowercasing to match\n    examples like: lps(\"TENS FOR TENS\") == 5\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a string\")\n\n    import re\n\n    t = re.sub(r'[^A-Za-z0-9]', '', s).lower()\n    n = len(t)\n    if n == 0:\n        return 0\n\n    # dp[i][j] = length of LPS in t[i..j]\n    dp = [[0] * n for _ in range(n)]\n    for i in range(n - 1, -1, -1):\n        dp[i][i] = 1\n        for j in range(i + 1, n):\n            if t[i] == t[j]:\n                dp[i][j] = dp[i + 1][j - 1] + 2 if j > i + 1 else 2\n            else:\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n    return dp[0][n - 1]", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["TENS FOR TENS"]], "plus_fail_tests": [["xZQOogNh"]]}], "Mbpp/252": [{"task_id": "M