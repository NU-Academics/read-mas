\n\n    Returns 0 for empty input.\n    \"\"\"\n    if not nums:\n        return 0\n\n    max_prod = nums[0]\n    curr_prod = nums[0]\n\n    for i in range(1, len(nums)):\n        if nums[i] > nums[i - 1]:\n            curr_prod *= nums[i]\n        else:\n            curr_prod = nums[i]\n        if curr_prod > max_prod:\n            max_prod = curr_prod\n\n    return max_prod", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[3, -5, 2, 6, -1, 4, -3]]]}], "Mbpp/472": [{"task_id": "Mbpp/472", "solution": "def check_Consecutive(lst: list) -> bool:\n    \"\"\"\n    Checks if a list contains consecutive integers without duplicates.\n    \"\"\"\n    if not lst:\n        return False\n\n    unique_nums = set(lst)\n    if len(unique_nums) != len(lst):  # Check for duplicates\n        return False\n\n    return max(unique_nums) - min(unique_nums) + 1 == len(unique_nums)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/474": [{"task_id": "Mbpp/474", "solution": "class StrUtilsError(Exception):\n    \"\"\"Custom exception for string utility errors.\"\"\"\n    def __init__(self, message: str, code: int = 1) -> None:\n        self.message = message\n        self.code = code\n\n    def __str__(self) -> str:\n        return self.message\nclass CharReplaceRequest:\n    \"\"\"DTO to hold the text and characters for replacement.\"\"\"\n    def __init__(self, text: str, old: str, new: str) -> None:\n        self.text: str = text\n        self.old: str = old\n        self.new: str = new\n\n    def as_tuple(self) -> tuple[str, str, str]:\n        return (self.text, self.old, self.new)\nclass Validator:\n    \"\"\"Utility class for input validation.\"\"\"\n    @staticmethod\n    def validate_char(char: str, name: str = \"char\") -> None:\n        if not isinstance(char, str) or len(char) != 1:\n            raise StrUtilsError(f\"{name} must be a single character string\", code=400)\n\n    @staticmethod\n    def validate_text(text: str) -> None:\n        if not isinstance(text, str):\n            raise StrUtilsError(\"text must be a string\", code=400)\n\n    @staticmethod\n    def validate_request(req: CharReplaceRequest) -> None:\n        Validator.validate_text(req.text)\n        Validator.validate_char(req.old, name=\"old\")\n        Validator.validate_char(req.new, name=\"new\")\nclass ReplaceService:\n    \"\"\"Core logic for character replacement.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def replace(self, text: str, old: str, new: str) -> str:\n        if old == \"\":\n            raise StrUtilsError(\"old must be non-empty\", code=400)\n        if old == new:\n            return text\n        return text.replace(old, new)\n\n    def replace_in_request(self, req: CharReplaceRequest) -> str:\n        return self.replace(req.text, req.old, req.new)\nclass ReplaceController:\n    \"\"\"Orchestrates validation and delegates to the replacement service.\"\"\"\n    def __init__(self, service: ReplaceService) -> None:\n        self._service = service\n\n    def replace(self, request: CharReplaceRequest) -> str:\n        Validator.validate_request(request)\n        return self._service.replace_in_request(request)\n\n    def replace_char(self, text: str, old: str, new: str) -> str:\n        req = CharReplaceRequest(text, old, new)\n        return self.replace(req)\ndef replace_char(text: str, old: str, new: str) -> str:\n    \"\"\"Replaces all occurrences of an old character with a new character in a string.\"\"\"\n    service = ReplaceService()\n    controller = ReplaceController(service)\n    return controller.replace_char(text, old, new)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/473": [{"task_id": "Mbpp/473", "solution": "def tuple_intersection(list_a, list_b):\n    \"\"\"\n    Finds the tuple intersection of elements in the given tuple list irrespective of their order.\n    Returns a set of canonical tuples.\n    \"\"\"\n\n    class InvalidTupleError(Exception):\n        \"\"\"Raised when an input item is not a 2-element iterable.\"\"\"\n        pass\n\n    class UnhashableElementError(Exception):\n        \"\"\"Raised when an element within a tuple is not hashable.\"\"\"\n        pass\n\n    def validate_iterable_of_pairs(pairs, raise_on_error: bool = True) -> bool:\n        \"\"\"\n        Checks if the input is an iterable containing only 2-length iterables.\n        Optionally raises InvalidTupleError if validation fails.\n        \"\"\"\n        if not isinstance(pairs, (list, tuple, set)):\n            if raise_on_error:\n                raise InvalidTupleError(\"Input must be an iterable (list, tuple, set) of pairs.\")\n            return False\n\n        for i, pair in enumerate(pairs):\n            if not isinstance(pair, (list, tuple)):\n                if raise_on_error:\n                    raise InvalidTupleError(f\"Element at index {i} is not a tuple or list: {pair}\")\n                return False\n            if len(pair) != 2:\n                if raise_on_error:\n                    raise InvalidTupleError(f\"Pair at index {i} does not have exactly 2 elements: {pair}\")\n                return False\n        return True\n\n    class NormalizedPair:\n        \"\"\"\n        Provides a canonical, hashable representation of a 2-element pair,\n        treating (a,b) and (b,a) as identical.\n        \"\"\"\n        def __init__(self, a, b) -> None:\n            try:\n                # Store elements in canonical order (a <= b)\n                if a <= b:\n                    self._a, self._b = a, b\n                else:\n                    self._a, self._b = b, a\n            except TypeError:\n                # Fallback to repr ordering for deterministic order if direct comparison fails\n                if repr(a) <= repr(b):\n                    self._a, self._b = a, b\n                else:\n                    self._a, self._b = b, a\n\n            try:\n                # Ensure the elements are hashable for set operations\n                hash((self._a, self._b))\n            except TypeError as e:\n                raise UnhashableElementError(\"Elements within tuples must be hashable.\") from e\n\n        def as_tuple(self):\n            \"\"\"Returns the pair as a canonical 2-element tuple.\"\"\"\n            return (self._a, self._b)\n\n        def __hash__(self) -> int:\n            return hash((self._a, self._b))\n\n        def __eq__(self, other: object) -> bool:\n            if not isinstance(other, NormalizedPair):\n                return False\n            return (self._a, self._b) == (other._a, other._b)\n\n        def __repr__(self) -> str:\n            return f\"NormalizedPair({repr(self._a)}, {repr(self._b)})\"\n\n    class IntersectionService:\n        \"\"\"Handles the core business logic for computing tuple intersections.\"\"\"\n        def __init__(self, repository=None):\n            # Repository is optional; not used for this specific inline implementation.\n            self._repository = repository\n\n        def _to_normalized_set(self, pairs) -> set:\n            \"\"\"Converts an iterable of raw 2-element pairs into a set of NormalizedPair objects.\"\"\"\n            return {NormalizedPair(a, b) for a, b in pairs}\n\n        def intersect(self, list_a, list_b) -> set:\n            \"\"\"\n            Computes the intersection of two iterables of 2-element tuples.\n            It normalizes each pair to a canonical form before performing set intersection.\n            \"\"\"\n            validate_iterable_of_pairs(list_a)\n            validate_iterable_of_pairs(list_b)\n\n            set_a = self._to_normalized_set(list_a)\n            set_b = self._to_normalized_set(list_b)\n\n            inter = set_a & set_b\n\n            # This block for optional persistence is included per design but will not\n            # execute as no repository is passed in this inline context.\n            if self._repository:\n                try:\n                    # Assuming self._repository.save expects canonical tuples\n                    self._repository.save(\"last_run\", [p.as_tuple() for p in set_a | set_b])\n                except Exception:\n                    pass\n\n            return {p.as_tuple() for p in inter}\n\n    class APIController:\n        \"\"\"A lightweight controller for programmatic access to the intersection service.\"\"\"\n        def __init__(self, service: IntersectionService) -> None:\n            self._service = service\n\n        def compute(self, list_a, list_b) -> set:\n            \"\"\"Delegates the intersection computation to the IntersectionService.\"\"\"\n            return self._service.intersect(list_a, list_b)\n\n    # Initialize the service and controller\n    _service = IntersectionService()\n    _api = APIController(_service)\n\n    # Compute and return the intersection\n    return _api.compute(list_a, list_b)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], [[1, 2, 3], [7, 8, 9], [10, 11, 12]]]]}], "Mbpp/475": [{"task_id": "Mbpp/475", "solution": "from typing import Dict, List, Tuple, Union\ndef sort_counter(counter: Dict[str, Union[int, float]], descending: bool = True) -> List[Tuple[str, Union[int, float]]]:\n    \"\"\"Sorts a dictionary by value in descending order by default.\n    Returns an ordered list of (key, value) tuples.\n    \"\"\"\n    items = list(counter.items())\n    return sorted(items, key=lambda kv: kv[1], reverse=descending)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/476": [{"task_id": "Mbpp/476", "solution": "def big_sum(values: Iterable[Number]) -> Number:\n    \"\"\"Calculates the sum of the largest and smallest numeric values in an iterable.\"\"\"\n    validator = InputValidator()\n    validator.validate(values)\n    service = BigSu