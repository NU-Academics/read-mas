          val = a[i]\n                i += 1\n            else:\n                val = b[j]\n                j += 1\n            count += 1\n            if count == k_int:\n                return val\n\n    # Binary-search partition method (O(log(min(m,n))))\n    # Ensure 'a' is the smaller array\n    if len(a) > len(b):\n        a, b = b, a\n\n    m, n = len(a), len(b)\n    low = max(0, k_int - n)\n    high = min(k_int, m)\n\n    while low <= high:\n        i = (low + high) // 2\n        j = k_int - i\n\n        a_left = a[i - 1] if i > 0 else None\n        a_right = a[i] if i < m else None\n        b_left = b[j - 1] if j > 0 else None\n        b_right = b[j] if j < n else None\n\n        left_ok = (a_left is None or b_right is None or a_left <= b_right)\n        right_ok = (b_left is None or a_right is None or b_left <= a_right)\n\n        if left_ok and right_ok:\n            # Partition is correct. The k-th element is the max of left sides.\n            candidates = []\n            if a_left is not None:\n                candidates.append(a_left)\n            if b_left is not None:\n                candidates.append(b_left)\n            # candidates will never be empty because k >= 1\n            return max(candidates)\n        if a_left is not None and b_right is not None and a_left > b_right:\n            # Too many elements taken from a\n            high = i - 1\n        else:\n            # Too few elements taken from a\n            low = i + 1\n\n    # Should not reach here\n    raise RuntimeError(\"Failed to find k-th element due to algorithm error\")", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1, 2, 3], [true, true, false], 3]]}], "Mbpp/602": [{"task_id": "Mbpp/602", "solution": "def first_repeated_char(s: str) -> str:\n    \"\"\"\n    Finds the first repeated character in a string.\n    Returns the character whose second occurrence is earliest, or an empty string if none.\n    \"\"\"\n    seen_chars = set(