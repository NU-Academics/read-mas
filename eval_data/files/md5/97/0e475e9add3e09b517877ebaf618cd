dOperation as e:\n            raise InvalidAmountError(f\"Invalid amount format: {amount}\") from e\n        except (TypeError, ValueError) as e:\n            raise InvalidAmountError(f\"Invalid amount type or value: {amount}\") from e\nclass Transaction:\n    \"\"\"Represents a financial transaction with selling and cost prices.\"\"\"\n    def __init__(self, selling_price: float, cost_price: float) -> None:\n        self.selling_price = selling_price\n        self.cost_price = cost_price\n\n    def profit_amount(self) -> float:\n        \"\"\"Calculates the profit or loss amount.\"\"\"\n        return self.selling_price - self.cost_price\n\n    def is_no_profit_no_loss(self) -> bool:\n        \"\"\"Checks if the transaction resulted in no profit and no loss.\"\"\"\n        return self.selling_price == self.cost_price\nDEFAULT_MAX_STORE = 1000\nclass InMemoryTransactionRepository:\n    \"\"\"An in-memory implementation of a transaction repository.\"\"\"\n    def __init__(self, max_store: int = DEFAULT_MAX_STORE) -> None:\n        self._store: List[Transaction] = []\n        self._max_store = max_store\n\n    def save(self, transaction: Transaction) -> None:\n        \"\"\"Saves a transaction to the in-memory store.\"\"\"\n        self._store.append(transaction)\n        if len(self._store) > self._max_store:\n            self._store.pop(0)\n\n    def list_all(self) -> List[Transaction]:\n        \"\"\"Returns a copy of all stored transactions.\"\"\"\n        return list(self._store)\nclass ProfitLossService:\n    \"\"\"Encapsulates business logic for profit/loss computations.\"\"\"\n    def __init__(self, validator: ValidationUtils) -> None:\n        self._validator = validator\n\n    def is_no_profit_no_loss(self, transaction: Transaction) -> bool:\n        \"\"\"Checks if a transaction results in no profit and no loss after validation.\"\"\"\n        if not self._validator.is_valid_amount(transaction.selling_price):\n            raise InvalidAmountError(\"Invalid selling_price\")\n        if not self._validator.is_valid_amount(transaction.cost_price):\n            raise InvalidAmountError(\"Invalid cost_price\")\n\n        sp = self._validator.to_decimal(transaction.selling_price)\n        cp = self._validator.to_decimal(transaction.cost_price)\n\n        return sp == cp\nclass ProfitLossController:\n    \"\"\"Manages the flow from external requests to business logic and optional persistence.\"\"\"\n    def __init__(self, service: ProfitLossService, repo: Optional[InMemoryTransactionRepository] = None) -> None:\n        self._service = service\n        self._repo = repo\n\n    def check(self, selling_price: float, cost_price: float) -> bool:\n        \"\"\"Performs the no profit no loss check, potentially saving the transaction.\"\"\"\n        txn = Transaction(selling_price, cost_price)\n        result = self._service.is_no_profit_no_loss(txn)\n        if self._repo is not None:\n            self._repo.save(txn)\n        return result\ndef _build_default_controller() -> ProfitLossController:\n    \"\"\"Composes and returns a default ProfitLossController instance.\"\"\"\n    validator = ValidationUtils()\n    service = ProfitLossService(validator)\n    repo = InMemoryTransactionRepository()\n    controller = ProfitLossController(service, repo)\n    return controller\ndef noprofit_noloss(selling_price: float, cost_price: float) -> bool:\n    \"\"\"Checks if the selling price equals the cost price, indicating no profit and no loss.\"\"\"\n    controller = _build_default_controller()\n    return controller.check(selling_price, cost_price)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[-2000, -5000]]}], "Mbpp/635": [{"task_id": "Mbpp/635", "solution": "from typing import List, Any, Callable, Optional\nimport time\nimport datetime\nclass SortingException(Exception):\n    \"\"\"Base exception for sorting-related errors.\"\"\"\n    def __init__(self, message: str = \"\") -> None:\n        super().__init__(message)\nclass ValidationError(SortingException):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    def __init__(self, message: str = \"\") -> None:\n        super().__init__(message)\nclass RepositoryError(SortingException):\n    \"\"\"Exception raised for issues with the logging repository.\"\"\"\n    def __init__(self, message: str = \"\") -> None:\n        super().__init__(message)\nclass Validator:\n    \"\"\"Provides static methods for input validation.\"\"\"\n    @staticmethod\n    def validate_iterable(lst: Any) -> List[Any]:\n        \"\"\"Ensures the input is an iterable and returns it as a list.\"\"\"\n        if not isinstance(lst, (list, tuple)):\n            raise ValidationError(\"Input 'lst' must be an iterable (list or tuple).\")\n        return list(lst)\n\n    @staticmethod\n    def validate_key(key: Any) -> None:\n        \"\"\"Ensures the key parameter is callable or None.\"\"\"\n        if key is not None and not callable(key):\n            raise ValidationError(\"Input 'key' must be a callable function or None.\")\nclass Timer:\n    \"\"\"A context manager to measure elapsed time in milliseconds.\"\"\"\n    def __init__(self) -> None:\n        self.start_ts: float = 0.0\n        self.end_ts: float = 0.0\n\n    def __enter__(self) -> 'Timer':\n        self.start_ts = time.perf_counter()\n        return self\n\n    def __exit__(self, exc_type, exc, tb) -> None:\n        self.end_ts = time.perf_counter()\n\n    def elapsed_ms(self) -> float:\n        \"\"\"Returns the elapsed time in milliseconds.\"\"\"\n        return (self.end_ts - self.start_ts) * 1000.0\nclass SortRepository:\n    \"\"\"Abstract base for logging sort operations.\"\"\"\n    def __init__(self, log_file_path: str = \"logs/sort_logs.jsonl\") -> None:\n        self.log_file_path = log_file_path\n\n    def append_log(self, entry: dict) -> None:\n        \"\"\"Appends a log entry.\"\"\"\n        # In a real implementation, this would write to a file.\n        pass\nclass InMemorySortRepository(SortRepository):\n    \"\"\"An in-memory repository for logging, primarily for testing.\"\"\"\n    def __init__(self) -> None:\n        super().__init__(\"\")\n        self.entries: List[dict] = []\n\n    def append_log(self, entry: dict) -> None:\n        \"\"\"Appends a log entry to an internal list.\"\"\"\n        self.entries.append(entry)\nclass Heap:\n    \"\"\"Encapsulates heap operations for heap sort.\"\"\"\n    def __init__(self, data: List[Any], key: Optional[Callable[[Any], Any]]=None, reverse: bool=False) -> None:\n        self._data = data\n        self._key = (key if key is not None else (lambda x: x))\n        self._reverse = reverse\n\n    def _compare(self, idx1: int, idx2: int) -> bool:\n        \"\"\"Compares elements at two indices based on key and reverse flag.\"\"\"\n        key1 = self._key(self._data[idx1])\n        key2 = self._key(self._data[idx2])\n        if self._reverse:\n            return key1 < key2\n        else:\n            return key1 > key2\n\n    def heapify(self) -> None:\n        \"\"\"Builds a heap from the underlying data list.\"\"\"\n        n = len(self._data)\n        for i in range((n // 2) - 1, -1, -1):\n            self.sift_down(i, n)\n\n    def sift_down(self, start: int, end: int) -> None:\n        \"\"\"Sifts down the element at start index to maintain heap property.\"\"\"\n        root = start\n        while True:\n            child = 2 * root + 1\n            if child >= end:\n                break\n\n            # Find the \"preferred\" child (larger for max-heap, smaller for min-heap)\n            if child + 1 < end and self._compare(child + 1, child):\n                child = child + 1\n\n            # Compare root with the preferred child and swap if needed\n            if self._compare(child, root):\n                self._data[root], self._data[child] = self._data[child], self._data[root]\n                root = child\n            else:\n                break\n\n    def heapsort_in_place(self) -> None:\n        \"\"\"Sorts the data list in-place using the heap property.\"\"\"\n        n = len(self._data)\n        # Repeatedly extract the root and place it at the end of the sorted portion.\n        for i in range(n - 1, 0, -1):\n            self._data[0], self._data[i] = self._data[i], self._data[0]\n            self.sift_down(0, i)\nclass HeapSortService:\n    \"\"\"Orchestrates heap sort operations, including validation, timing, and logging.\"\"\"\n    DEFAULT_IN_PLACE = False\n\n    def __init__(self, repository: Optional[SortRepository]=None) -> None:\n        \"\"\"Initializes the service with an optional repository dependency.\"\"\"\n        self.repository = repository or InMemorySortRepository()\n\n    def sort(self, lst: List[Any], in_place: bool=False, key: Optional[Callable[[Any], Any]]=None, reverse: bool=False) -> List[Any]:\n        \"\"\"\n        Sorts a list using the heap sort algorithm.\n        Returns a new sorted list by default, or sorts in-place if specified.\n        \"\"\"\n        validated_list = []\n        log_entry = {\n            \"timestamp\": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds'),\n            \"input_size\": 0, # Placeholder, updated after validation\n            \"in_place\": in_place,\n            \"reverse\": reverse,\n            \"success\": False,\n            \"error\": None,\n            \"sample_preview\": [] # Placeholder, updated after validation\n        }\n\n        try:\n            validated_list = Validator.validate_iterable(lst)\n            Validator.validate_key(key)\n\n            log_entry[\"input_size\"] = len(validated_list)\n            log_entry[\"sample_preview\"] = list(validated_list[:10])\n\n            data_to_sort = validated_list if in_place else list(validated_list)\n\n            with Timer() as t:\n                heap = Heap(data_to_sort, key=key, reverse=reverse)\n                heap.heapify()\n                heap.heapsort_in_place()\n\n            log_entry[\"duration_ms\"] = t.elapsed_ms()\n            log_entry[\"success\"] = True\n            return data_to_sort\n\n        except ValidationError as ve:\n            log_entry[\"error\"] = str(ve)\n            raise ve\n        except Exception as e:\n            log_entry[\"error\"] = f\"Unexpected error: {type(e).__name__}: {str(e)}\"\n            raise SortingException(log_entry[\"error\"]) from e\n        finally:\n            try:\n                self.repository.append_log(log_entry)\n            except RepositoryError:\n                pass\n            except Exception:  # Catch any non-RepositoryError during logging as well\n                pass\ndef heap_sort(lst: List[Any], *, in_place: bool=False, key: Optional[Callable[[Any], Any]]=None, reverse: bool=False) -> List[Any]:\n    \"\"\"\n    Sorts a list using the heap sort algorithm.\n    Returns a new sorted list by default, or sorts in-place if specified.\n    \"\"\"\n    svc = HeapSortService()\n    return svc.sort(lst, in_place=in_place, key=key, reverse=reverse)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/639": [{"task_id": "Mbpp/639", "solution": "def sample_nam(names):\n    \"\"\"\n    Sums the length of names after filtering out those starting with a lowercase letter,\n    ignoring leading whitespace for the check. Non-string elements are skipped.\n    \"\"\"\n    total_length = 0\n    for name in names:\n        if isinstance(name, str):\n            stripped_name = name.lstrip()\n            if stripped_name and not stripped_name[0].islower():\n                total_length += len(name)\n    return total_length", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[["AbCdE", "fGH", "IJKLMnOp", "qrs", "TUVW", "xyz"]]]}], "Mbpp/641": [{"task_id": "Mbpp/641", "solution": "def is_nonagonal(n: int) -> int:\n    \"\"\"\n    Calculates the nth nonagonal number 