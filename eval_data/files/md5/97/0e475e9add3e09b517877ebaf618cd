essage\n        super().__init__(message)\n\n    def __str__(self) -> str:\n        return self.message\nclass TupleValidator:\n    \"\"\"Validates input tuples for pairwise addition.\"\"\"\n    def validate(self, t: tuple) -> Tuple[float, ...]:\n        if not isinstance(t, tuple):\n            raise PairwiseError(\"Input must be a tuple.\")\n        if len(t) < 2:\n            raise PairwiseError(\"Tuple must contain at least two elements.\")\n        converted = []\n        for i, x in enumerate(t):\n            if isinstance(x, (int, float)):\n                converted.append(float(x))\n            else:\n                raise PairwiseError(f\"Element at position {i} is not numeric: {x!r}\")\n        return tuple(converted)\nclass PairwiseAdder:\n    \"\"\"Computes the pairwise sums of neighboring elements.\"\"\"\n    def add_pairwise(self, values: Tuple[float, ...]) -> PairwiseResult:\n        computed = self._compute(values)\n        return PairwiseResult(values=tuple(computed))\n\n    def _compute(self, values: Tuple[float, ...]) -> List[float]:\n        n = len(values)\n        result: List[float] = []\n        for i in range(n - 1):\n            result.append(values[i] + values[i + 1])\n        return result\nclass PairwiseController:\n    \"\"\"Coordinates validation and sum computation.\"\"\"\n    def __init__(self):\n        self.validator = TupleValidator()\n        self.adder = PairwiseAdder()\n\n    def add_pairwise(self, t: tuple) -> tuple:\n        values = self.validator.validate(t)\n        result = self.adder.add_pairwise(values)\n        return result.to_tuple()\ndef add_pairwise(t: tuple) -> tuple:\n    \"\"\"\n    Computes the pairwise sum of neighboring elements in a tuple.\n    It validates the input and returns a tuple of float sums.\n    \"\"\"\n    return PairwiseController().add_pairwise(t)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/460": [{"task_id": "Mbpp/460", "solution": "def