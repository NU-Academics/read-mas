ble_of_tuples(data)\n        result = []\n        for i, t in enumerate(normalized):\n            try:\n                result.append(t[index])\n            except IndexError:\n                raise InvalidIndexError(f\"Index {index} out of range for tuple at position {i}: {t}\", index=index)\n        return result\ndef extract_nth_element(data: Iterable[Tuple[Any, ...]], index: int) -> List[Any]:\n    \"\"\"\n    Extracts the nth element from a given list of tuples.\n\n    Delegates to ExtractorService for core logic, including input validation and error handling.\n    \"\"\"\n    service = ExtractorService()\n    return service.extract_nth_element_from_iterable(data, index)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/420": [{"task_id": "Mbpp/420", "solution": "def cube_Sum(n: int) -> int:\n    \"\"\"Computes the sum of cubes of the first n even natural numbers using a closed-form formula.\n\n    Assumes n is a positive integer (n >= 1).\n    \"\"\"\n    # Using the closed-form formula: sum_{k=1..n} (2k)^3 = 2 * (n * (n+1))^2\n    return 2 * (n * (n + 1))**2", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/414": [{"task_id": "Mbpp/414", "solution": "from typing import Sequence, Hashable, Any, Tuple\nclass OverlapError(Exception):\n    \"\"\"Base exception for the overlap package.\"\"\"\n    pass\nclass ValidationError(OverlapError):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    pass\ndef is_hashable(obj: Any) -> bool:\n    \"\"\"Check if an object is hashable.\"\"\"\n    try:\n        hash(obj)\n        return True\n    except TypeError:\n        return False\nclass InputValidator:\n    \"\"\"Validates input sequences for overlap checking.\"\"\"\n    _SAMPLE_SIZE = 10  # Number of elements to sample for hashability check.\n\n    def validate_iterables(self, seq1: Any, seq2: Any) -> Tuple[Sequence[Hashable], Sequence[Hashable]]:\n        \"\"\"\n        Validates that inputs are iterables of hashable elements.\n        Converts non-Sequence iterables to lists for consistent behavior.\n        \"\"\"\n        if seq1 is None or seq2 is None:\n            raise ValidationError(\"Input sequences cannot be None.\")\n\n        try:\n            processed_seq1 = list(seq1)\n        except TypeError:\n            raise ValidationError(\"First input must be an iterable.\")\n        try:\n            processed_seq2 = list(seq2)\n        except TypeError:\n            raise ValidationError(\"Second input must be an iterable.\")\n\n        for i, item in enumerate(processed_seq1):\n            if i >= self._SAMPLE_SIZE:\n                break\n            if not is_hashable(item):\n                raise ValidationError(f\"Element at index {i} in the first sequence is not hashable.\")\n\n        for i, item in enumerate(processed_seq2):\n            if i >= self._SAMPLE_SIZE:\n                break\n            if not is_hashable(item):\n                raise ValidationError(f\"Element at index {i} in the second sequence is not hashable.\")\n\n        return processed_seq1, processed_seq2\nclass OverlapChecker:\n    \"\"\"Implements different strategies for overlap detection.\"\"\"\n\n    def find_overlap(self, seq1: Sequence[Hashable], seq2: Sequence[Hashable], strategy: str = \"auto\", max_size_for_quadratic: int = 1000) -> bool:\n        \"\"\"\n        Detects overlap between two sequences using the specified strategy.\n        Assumes inputs are already validated and are Sequences of Hashable elements.\n        \"\"\"\n        len1 = len(seq1)\n        len2 = len(seq2)\n\n        if len1 == 0 or len2 == 0:\n            return False\n\n        if strategy == \"auto\":\n            # Auto-strategy: Use quadratic for very small inputs, otherwise set-based.\n            if len1 <= max_size_for_quadratic and len2 <= max_size_for_quadratic:\n                return self._quadratic(seq1, seq2)\n            else:\n                # For set-based, always build set from the smaller sequence.\n                if len1 <= len2:\n                    return self._set_based(seq1, seq2)\n                else:\n                    return self._set_based(seq2, seq1)\n        elif strategy == \"set\":\n            if len1 <= len2:\n                return self._set_based(seq1, seq2)\n            else:\n                return self._set_based(seq2, seq1)\n        elif strategy == \"quadratic\":\n            return self._quadratic(seq1, seq2)\n        elif strategy == \"sort\":\n            raise NotImplementedError(\"Sort-based strategy is not implemented in this version.\")\n        else:\n            raise ValueError(f\"Unknown strategy: {strategy}\")\n\n    def _set_based(self, smaller: Sequence[Hashable], larger: Sequence[Hashable]) -> bool:\n        \"\"\"Builds a set from the smaller sequence and checks membership in the larger.\"\"\"\n        seen = set(smaller)\n        for item in larger:\n            if item in seen:\n                return True\n        return False\n\n    def _quadratic(self, seq1: Sequence[Hashable], seq2: Sequence[Hashable]) -> bool:\n        \"\"\"Uses nested loops for overlap detection, suitable for small inputs.\"\"\"\n        for item1 in seq1:\n            for item2 in seq2:\n                if item1 == item2:\n                    return True\n        return False\ndef overlapping(seq1: Sequence[Hashable], seq2: Sequence[Hashable], max_size_for_quadratic: int = 1000) -> bool:\n    \"\"\"\n    Checks if any value in seq1 exists in seq2.\n    It validates inputs and uses an optimized algorithm (set-based for large sequences, quadratic for small).\n    \"\"\"\n    validator = InputValidator()\n    validated_seq1, validated_seq2 = validator.validate_iterables(seq1, seq2)\n\n    checker = OverlapChecker()\n    return checker.find_overlap(validated_seq1, validated_seq2, strategy=\"auto\", max_size_for_quadratic=max_size_for_quadratic)", "base_status": "pass