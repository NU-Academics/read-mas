epository:\n    \"\"\"Manages persistent and in-memory caching of Jacobsthal numbers.\"\"\"\n    CACHE_DB_SCHEMA = \"\"\"\n    CREATE TABLE IF NOT EXISTS cache (\n        n INTEGER PRIMARY KEY,\n        value TEXT NOT NULL,\n        computed_at TEXT NOT NULL\n    );\n    \"\"\"\n\n    def __init__(self, db_path: str = None, max_in_memory: int = 1024):\n        self._db_path = Path(db_path) if db_path else get_cache_path()\n        self._max_in_memory = max_in_memory\n        self._in_memory = OrderedDict() # n -> value\n        self._conn = None\n        self._init_db()\n\n    def _init_db(self) -> None:\n        \"\"\"Initializes the SQLite database and creates the cache table if it doesn't exist.\"\"\"\n        try:\n            self._db_path.parent.mkdir(parents=True, exist_ok=True)\n            self._conn = sqlite3.connect(self._db_path)\n            self._conn.execute(CacheRepository.CACHE_DB_SCHEMA)\n            self._conn.commit()\n        except sqlite3.Error as e:\n            raise CacheError(f\"Failed to initialize database at {self._db_path}: {e}\") from e\n        except Exception as e:\n            raise CacheError(f\"Failed to set up cache directory or database: {e}\") from e\n\n    def _put_in_memory(self, n: int, value: int) -> None:\n        \"\"\"Adds or updates an item in the in-memory LRU cache.\"\"\"\n        if n in self._in_memory:\n            self._in_memory.move_to_end(n)\n        self._in_memory[n] = value\n        if len(self._in_memory) > self._max_in_memory:\n            self._in_memory.popitem(last=False)\n\n    def get(self, n: int) -> JacobsthalModel | None:\n        \"\"\"Retrieves a Jacobsthal number from the cache by its index.\"\"\"\n        if n in self._in_memory:\n            self._in_memory.move_to_end(n)\n            return JacobsthalModel(n=n, value=self._in_memory[n], computed_at=\"in-memory\")\n\n        try:\n            cur = self._conn.cursor()\n            cur.execute(\"SELECT n, value, computed_at FROM cache WHERE n = ?\", (n,))\n            row = cur.fetchone()\n            if row:\n                model = JacobsthalModel.from_row(row)\n                self._put_in_memory(n, model.value)\n                return model\n            return None\n        except sqlite3.Error:\n            # Log cache errors but don't fail computation; treat as cache miss.\n            return None\n\n    def set(self, model: JacobsthalModel) -> None:\n        \"\"\"Stores a Jacobsthal number model in both in-memory and persistent caches.\"\"\"\n        try:\n            self._put_in_memory(model.n, model.value)\n            cur = self._conn.cursor()\n            cur.execute(\n                \"INSERT OR REPLACE INTO cache (n, value, computed_at) VALUES (?, ?, ?)\",\n                (model.n, self._serialize(model.value), model.computed_at),\n            )\n            self._conn.commit()\n        except sqlite3.Error:\n            # Log cache errors but don't fail computation.\n            pass\n\n    def clear(self) -> None:\n        \"\"\"Clears both the in-memory and persistent (SQLite) caches.\"\"\"\n        try:\n            self._in_memory.clear()\n            self._conn.execute(\"DELETE FROM cache\")\n            self._conn.commit()\n        except sqlite3.Error as e:\n            raise CacheError(f\"Failed to clear cache: {e}\") from e\n\n    def close(self) -> None:\n        \"\"\"Closes the database connection if it's open.\"\"\"\n        if self._conn:\n            self._conn.close()\n            self._conn = None\n\n    def _serialize(self, value: int) -> str:\n        \"\"\"Converts an integer value to its string representation for storage.\"\"\"\n        return str(value)\n\n    def _deserialize(self, value_str: str) -> int:\n        \"\"\"Converts a string representation back to an integer value.\"\"\"\n        return int(value_str)\n\n    def __del__(self):\n        \"\"\"Ensures the database connection is closed when the object is garbage collected.\"\"\"\n        self.close()\nclass JacobsthalService:\n    \"\"\"Provides methods to compute Jacobsthal numbers and orchestrates cache usage.\"\"\"\n    def __init__(self, repo: CacheRepository):\n        self._repo = repo\n\n    def compute(self, n: int, use_cache: bool = True) -> int:\n        \"\"\"Computes the nth Jacobsthal number, utilizing the cache if `use_cache` is True.\"\"\"\n        if use_cache:\n            model = self._repo.get(n)\n            if model:\n                return model.value\n\n        result = self._compute_closed_form(n)\n\n        if use_cache:\n            computed_at = datetime.datetime.now(datetime.timezone.utc).isoformat()\n            model_to_store = JacobsthalModel(n=n, value=result, computed_at=computed_at)\n            self._repo.set(model_to_store)\n\n        return result\n\n    def _compute_closed_form(self, n: int) -> int:\n        \"\"\"Computes the nth Jacobsthal number using the closed-form integer formula J(n) = (2**n - (-1)**n) // 3.\"\"\"\n        return (pow(2, n, None) - (-1) ** n) // 3\n\n    def _compute_iterative(self, n: int) -> int:\n        \"\"\"Computes the nth Jacobsthal number iteratively, using J(0)=0, J(1)=1, J(n)=J(n-1)+2*J(n-2).\"\"\"\n        if n == 0:\n            return 0\n        if n == 1:\n            return 1\n        a, b = 0, 1\n        for _ in range(2, n + 1):\n            a, b = b, b + 2 * a\n        return b\n\n    def _compute_recursive_memo(self, n: int, memo: dict | None = None) -> int:\n        \"\"\"Computes the nth Jacobsthal number recursively with memoization for optimization.\"\"\"\n        if memo is None:\n            memo = {}\n        if n in memo:\n            return memo[n]\n        if n == 0:\n            return 0\n        if n == 1:\n            return 1\n        result = self._compute_recursive_memo(n - 1, memo) + 2 * self._compute_recursive_memo(n - 2, memo)\n        memo[n] = result\n        return result\n\n    def clear_cache(self) -> None:\n        \"\"\"Clears both the in-memory and persistent caches through the repository.\"\"\"\n        self._repo.clear()\n_default_repo = CacheRepository()\n_service = JacobsthalService(_default_repo)\ndef jacobsthal_num(n: int, use_cache: bool = True) -> int:\n    \"\"\"\n    Finds the nth Jacobsthal number.\n    The sequence is defined by J(0)=0, J(1)=1, and J(n)=J(n-1)+2*J(n-2) for n > 1.\n    \"\"\"\n    n = validate_index(n)\n    return _service.compute(n, use_cache=use_cache)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/764": [{"task_id": "Mbpp/764", "solution": "from datetime import datetime\nfrom typing import Any, Dict, List, Optional\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input.\"\"\"\n    def __init__(self, message: str = \"\") -> None:\n        self.message = message\n        super().__init__(self.message)\ndef validate_string(s: Any) -> str:\n    \"\"\"Ensures input s is a string; raises InvalidInputError if not.\"\"\"\n    if not isinstance(s, str):\n        raise InvalidInputError(\"Input must be a str\")\n    return s\ndef is_digit(ch: str) -> bool:\n    \"\"\"Returns True if the character is an ASCII digit (0-9).\"\"\"\n    return len(ch) == 1 and '0' <= ch <= '9'\ndef count_digits_iterable(s: str) -> int:\n    \"\"\"Iterates through a string and counts ASCII digits.\"\"\"\n    return sum(1 for ch in s if is_digit(ch))\nclass DigitCountResult:\n    \"\"\"Represents the result of counting digits in a string.\"\"\"\n    def __init__(self, input_string: str, count: int, timestamp: datetime) -> None:\n        self.input_string = input_string\n        self.count = count\n        self.timestamp = timestamp\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Serializes the result into a dictionary.\"\"\"\n        return {\n            \"input_string\": self.input_string,\n            \"count\": self.count,\n            \"timestamp\": self.timestamp.isoformat()\n        }\nclass InMemoryRepository:\n    \"\"\"Simple in-memory store for DigitCountResult objects.\"\"\"\n    DEFAULT_MAX_SIZE: int = 100\n\n    def __init__(self, max_size: int = DEFAULT_MAX_SIZE) -> None:\n        if not isinstance(max_size, int) or max_size <= 0:\n            raise ValueError(\"max_size must be a positive integer\")\n        self._max_size = max_size\n        self._store: List[DigitCountResult] = []\n\n    def save(self, result: DigitCountResult) -> None:\n        \"\"\"Adds a result to the repository, enforcing max_size.\"\"\"\n        if not isinstance(result, DigitCountResult):\n            raise TypeError(\"Result must be of type DigitCountResult\")\n        self._store.append(result)\n        if len(self._store) > self._max_size:\n            self._store.pop(0)\n\n    def list_recent(self, limit: int = 10) -> List[DigitCountResult]:\n        \"\"\"Returns a list of the most recent results.\"\"\"\n        if not isinstance(limit, int) or limit <= 0:\n            raise ValueError(\"limit must be a positive integer\")\n        return self._store[-limit:]\n\n    def clear(self) -> None:\n        \"\"\"Clears all entries from the repository.\"\"\"\n        self._store.clear()\nclass NumberCounterService:\n    \"\"\"Core logic for counting digits, orchestrating validation and optional persistence.\"\"\"\n    def __init__(self, repo: Optional[InMemoryRepository] = None) -> None:\n        self._repo = repo\n\n    def count_digits(self, s: str, persist: bool = False) -> int:\n        \"\"\"Validates, counts digits, and optionally persists, returning the digit count.\"\"\"\n        res = self.count_digits_detail(s, persist)\n        return res.count\n\n    def count_digits_detail(self, s: str, persist: bool = False) -> DigitCountResult:\n        \"\"\"Returns a DigitCountResult object after validation, counting, and optional persistence.\"\"\"\n        validated = validate_string(s)\n        count = count_digits_iterable(validated)\n        result = DigitCountResult(input_string=validated, count=count, timestamp=datetime.utcnow())\n        if persist:\n            if not self._repo:\n                raise RuntimeError(\"Persistence requested but no repository configured\")\n            self._repo.save(result)\n        return result\ndef number_ctr(s: str) -> int:\n    \"\"\"Public convenience function to count digits in a string.\n    Raises InvalidInputError if s is not a str.\n    \"\"\"\n    svc = NumberCounterService()\n    return svc.count_digits(s)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/769": [{"task_id": "Mbpp/769", "solution": "def Diff(a: list[int], b: list[int]) -> list[int]:\n    \"\"\"\n    Computes the difference between two lists, returning elements in 'a' not in 'b',\n    and applying a specific ordering rule.\n    \"\"\"\n    set_b = set(b)\n    filtered = [x for x in a if x not in set_b]\n\n    multiples_of_10 = [x for x in filtered if x % 10 == 0]\n    others = [x for x in filtered if x % 10 != 0]\n\n    return multiples_of_10 + others", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 2, 3, 4, 5], [6, 7, 1]]], "plus_fail_tests": [[[], [1, 2, 3]]]}], "Mbpp/767": [{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list, target: int) -> int:\n    \"\"\"\n    Counts the number of unordered index-pairs (i < j) in a list whose values sum to a target.\n    This implementation uses a hash-based approach for efficient counting, especially with duplicates.\n    \"\"\"\n    freq = {}\n    for v in numbers:\n        freq[v] = freq.get(v, 0) + 1\n\n    count = 0\n    seen = set()\n    for v, fv in freq.items():\n        complement = target - v\n        if complement not in freq:\n            continue\n        if complement == v:\n            # For self-complementing numbers (e.g., target=4, v=2, complement=2)\n            # We need to choose 2 numbers from `fv` occurrences: fv * (fv - 1) // 2\n            count += fv * (fv - 1) // 2\n        elif complement not in seen:\n            # For distinct complements (e.g., target=5, v=2, complement=3)\n            # We pair each occurrence of `v` with each occurrence of `complement`\n            count += fv * freq[complement]\n        seen.add(v) # Mark v as seen to avoid double counting pairs like (2,3) and then (3,2)\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/766": [{"task_id": "Mbpp/766", "solution": "def pair_wise(items):\n    \"\"\"\n    Returns a list of all pairs of consecutive items in the given list.\n    Returns an empty list if the input list has fewer than two items.\n    \"\"\"\n    if len(items) < 2:\n        return []\n    return list(zip(items, items[1:]))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/770": [{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth power of the first n odd natural numbers using a closed-form formula.\n    \"\"\"\n\n    def _sum_k(val: int) -> int:\n        \"\"\"Returns the sum of the first val integers: val(val+1)/2.\"\"\"\n        return val * (val + 1) // 2\n\n    def _sum_k2(val: int) -> int:\n        \"\"\"Returns the sum of the first val squares: val(val+1)(2val+1)/6.\"\"\"\n        return val * (val + 1) * (2 * val + 1) // 6\n\n    def _sum_k3(val: int) -> int:\n        \"\"\"Returns the sum of the first val cubes: (val(val+1)/2)^2.\"\"\"\n        s1 = _sum_k(val)\n        return s1 * s1\n\n    def _sum_k4(val: int) -> int:\n        \"\"\"Returns the sum of the first val fourth powers: val(val+1)(2val+1)(3val^2+3val-1)/30.\"\"\"\n        return val * (val + 1) * (2 * val + 1) * (3 * val * val + 3 * val - 1) // 30\n\n    s1 = _sum_k(n)\n    s2 = _sum_k2(n)\n    s3 = _sum_k3(n)\n    s4 = _sum_k4(n)\n\n    # The formula for sum_{k=1 to n} (2k-1)^4\n    # is 16*sum_k4 - 32*sum_k3 + 24*sum_k2 - 8*sum_k + n\n    return 16 * s4 - 3