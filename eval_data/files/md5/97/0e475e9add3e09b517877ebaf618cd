 = r\n\n    # If the effective range for natural numbers is invalid (e.g., effective_l > effective_r),\n    # there are no odd natural numbers to sum, so return 0. This covers cases like r < 1.\n    if effective_l > effective_r:\n        return 0\n\n    # The sum of the first N odd numbers is N*N.\n    # To find the sum of odd numbers in [effective_l, effective_r],\n    # we calculate (sum of odds up to effective_r) - (sum of odds up to effective_l - 1).\n\n    count_odds_up_to_r = get_count_of_odd_natural_numbers_up_to(effective_r)\n    count_odds_before_l = get_count_of_odd_natural_numbers_up_to(effective_l - 1)\n\n    total_sum = (count_odds_up_to_r * count_odds_up_to_r) - (count_odds_before_l * count_odds_before_l)\n\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/799": [{"task_id": "Mbpp/799", "solution": "def left_rotate(value: int, d: int) -> int:\n    \"\"\"\n    Rotate left bits by d bits for a 32-bit number.\n    The number is assumed to be 32 bit.\n    \"\"\"\n    BIT_WIDTH = 32\n    d_effective = d % BIT_WIDTH\n    mask = (1 << BIT_WIDTH) - 1\n\n    if d_effective == 0:\n        return value & mask\n\n    left_part = (value << d_effective) & mask\n    right_part = (value >> (BIT_WIDTH - d_effective)) & mask\n\n    return (left_part | right_part) & mask", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/800": [{"task_id": "Mbpp/800", "solution": "import re\nfrom dataclasses import dataclass\nfrom typing import Pattern, Optional\nWHITESPACE_REGEX = r'\\s+'\nclass InvalidInputError(ValueError):\n    def __init__(self, message: str):\n        super().__init__(message)\nclass CleaningError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\ndef safe_str(obj) -> str:\n    return str(obj)\nclass Validator:\n    def validate_text(self, text) -> TextPayload:\n        if text is None:\n            raise InvalidInputError(\"text cannot be None\")\n        if isinstance(text, str):\n            return TextPayload(text=text)\n        return TextPayload(text=safe_str(text))\nclass TextCleaningService:\n    def __init__(self, pattern: Optional[Pattern[str]] = None) -> None:\n        self._pattern = pattern or re.compile(WHITESPACE_REGEX)\n\n    def remove_all_spaces(self, text: str) -> str:\n        try:\n            return self._pattern.sub('', text)\n        except Exception as exc:\n            raise CleaningError(f\"failed to clean text: {exc}\") from exc\n\n    def clean_payload(self, payload: TextPayload) -> TextResult:\n        cleaned = self.remove_all_spaces(payload.text)\n        return TextResult(original=payload.text, cleaned=cleaned)\ndef remove_all_spaces(text: str) -> str:\n    \"\"\"Removes all whitespace characters from the input string.\"\"\"\n    validator = Validator()\n    payload = validator.validate_text(text)\n    service = TextCleaningService()\n    return service.clean_payload(payload).cleaned", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/801": [{"task_id": "Mbpp/801", "solution": "def test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"Return how many of the three integers are equal.\n    Returns:\n      3 if all three are equal,\n      2 if exactly two are equal,\n      0 if all are distinct.\n    \"\"\"\n    if a == b == c:\n        return 3\n    if a == b or a == c or b == c:\n        return 2\n    return 0", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/804": [{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers):\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    The product is even if at least one number in the list is even.\n    \"\"\"\n    for number in numbers:\n        if number % 2 == 0:\n            return True\n    return False", "base_status": "pass", "plus_status": "pass", "base_