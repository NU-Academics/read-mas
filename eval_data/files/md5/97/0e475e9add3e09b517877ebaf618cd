   self.a = a\n        self.b = b\nclass InputValidator:\n    \"\"\"Validates and normalizes input sequences.\"\"\"\n    def __init__(self, adapter: ArrayAdapter = None) -> None:\n        self.adapter = adapter or ArrayAdapter()\n\n    def validate(self, a: Sequence[Any], b: Sequence[Any]) -> ListPair:\n        if a is None or b is None:\n            raise InvalidInputError(\"Inputs must not be None\")\n        a_list = self._validate_sequence(a, \"a\")\n        b_list = self._validate_sequence(b, \"b\")\n        if len(a_list) != len(b_list):\n            raise LengthMismatchError(\"Input sequences must have equal length\")\n        return ListPair(a_list, b_list)\n\n    def _validate_sequence(self, seq: Sequence[Any], name: str) -> List[Number]:\n        lst = self.adapter.to_list(seq)\n        for idx, val in enumerate(lst):\n            if not isinstance(val, Number):\n                raise InvalidElementError(f\"Element at index {idx} in {name} is not numeric: {val}\")\n        return lst\nclass SumService:\n    \"\"\"Core logic for element-wise summation.\"\"\"\n    def sum_lists(self, a: List[Number], b: List[Number]) -> List[Number]:\n        # Assumes equal length and numeric elements after validation.\n        return [x + y for x, y in zip(a, b)]\nclass SumController:\n    \"\"\"Orchestrates input validation and summation logic.\"\"\"\n    def __init__(self, validator: InputValidator = None, service: SumService = None) -> None:\n        self.validator = validator or InputValidator()\n        self.service = service or SumService()\n\n    def sum_list(self, a: Sequence[Number], b: Sequence[Number]) -> List[Number]:\n        \"\"\"Validates inputs, then computes element-wise sums.\"\"\"\n        pair = self.validator.validate(a, b)\n        return self.service.sum_lists(pair.a, pair.b)\ndef sum_list(a: Sequence[Number], b: Sequence[Number]) -> List[Number]:\n    \"\"\"Computes the element-wise sum of two numeric sequences.\"\"\"\n    return SumController().su