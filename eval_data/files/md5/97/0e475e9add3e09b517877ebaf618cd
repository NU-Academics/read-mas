terator[int]:\n        return iter(self.numbers)\nclass InputValidator:\n    def __init__(self, allow_coercion: bool = False):\n        self.ALLOW_COERCION = allow_coercion\n\n    def validate_iterable(self, seq: Any) -> bool:\n        \"\"\"Ensures the input sequence is iterable and not a string.\"\"\"\n        try:\n            iter(seq)\n            if isinstance(seq, str):\n                raise InvalidInputError(\"Input string cannot be directly interpreted as an iterable of numbers.\")\n            return True\n        except TypeError:\n            raise InvalidInputError(\"Input is not iterable\")\n\n    def validate_element(self, elem: Any) -> int:\n        \"\"\"Ensures a single element is an integer or convertible to one.\"\"\"\n        if isinstance(elem, int):\n            return elem\n        if self.ALLOW_COERCION:\n            try:\n                return int(elem)\n            except (ValueError, TypeError):\n                pass\n        raise InvalidInputError(f\"Element {elem!r} is not an integer\")\nclass ListAdapter:\n    def __init__(self, validator: InputValidator):\n        self.validator = validator\n\n    def adapt(self, seq: Any) -> NumberList:\n        \"\"\"Validates the sequence and its elements, then adapts to NumberList.\"\"\"\n        self.validator.validate_iterable(seq)\n        nums = []\n        for elem in seq:\n            num = self.validator.validate_element(elem)\n            nums.append(num)\n        return NumberList.from_iterable(nums)\nclass OddFilterService:\n    def __init__(self, validator: InputValidator, adapter: ListAdapter):\n        self.validator = validator\n        self.adapter = adapter\n\n    def filter(self, numbers: NumberList) -> List[int]:\n        \"\"\"Filters a NumberList, returning only odd integers.\"\"\"\n        return [n for n in numbers if n % 2 != 0]\n\n    def filter_from_raw(self, seq: Any) -> List[int]:\n        \"\"\"Convenience method to adapt raw input and then filter.\"\"\"\n        num_list = self.adapter.adapt(seq)\n        return self.filter(num_list)\nclass OddFilterController:\n    def __init__(self, service: OddFilterService):\n        self.service = service\n\n    def filter_oddnumbers(self, seq: Any) -> List[int]:\n        \"\"\"Orchestrates adaptation and filtering for odd numbers.\"\"\"\n        return self.service.filter_from_raw(seq)\n_default_validator = InputValidator(allow_coercion=False)\n_default_adapter = ListAdapter(_default_validator)\n_default_service = OddFilterService(_default_validator, _default_adapter)\n_default_controller = OddFilterController(_default_service)\ndef filter_oddnumbers(seq: Iterable[Any]) -> List[int]:\n    \"\"\"Filters a sequence, returning only odd integers.\"\"\"\n    return _default_controller.filter_oddnumbers(seq)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/309": [{"task_id": "Mbpp/309", "solution": "def maximum(a, b):\n    \"\"\"\n    Finds the maximum of two numbers, including input validation and type preference,\n    following the detailed MaxFinder architecture principles within a single function.\n    \"\"\"\n    import math\n\n    # --- Inlined components to satisfy \"Do NOT call any helper that is not defined inline\" ---\n\n    class ValidationError(Exception):\n        \"\"\"Custom exception for input validation errors.\"\"\"\n        pass\n\n    class NumberValidator:\n        \"\"\"Validates and normalizes numeric inputs.\"\"\"\n        def __init__(self, allow_string_conversion: bool = False):\n            self._allow_string_conversion = allow_string_conversion\n\n        def validate(self, value: any) -> float:\n            \"\"\"\n            Validates if a value is a number (int or float) or a numeric string.\n            Raises ValidationError if invalid, returns a float.\n            \"\"\"\n            if isinstance(value, (int, float)):\n                return float(value)\n\n            if self._allow_string_conversion and isinstance(value, str):\n                try:\n                    return float(value)\n                except ValueError:\n                    raise ValidationError(f\"Invalid numeric string value: '{value}'\")\n\n            raise ValidationError(f\"Value must be a number (int, float) or a numeric string if conversion allowed: '{value}'\")\n\n    class MaxResult:\n        \"\"\"Data Transfer Object for maximum computation results.\"\"\"\n        def __init__(self, value: float, chosen_index: int):\n            self.value = value\n            self.chosen_index = chosen_index\n\n    # From config.py, defining as local constant\n    _PREFERRED_INT_RETURN = True\n\n    class MaxService:\n        \"\"\"Core business logic for computing maximum values.\"\"\"\n        def __init__(self, repository=None): # Repository is optional and not used in this function\n            self._repository = repository\n\n        def compute_max(self, a_val: float, b_val: float) -> MaxResult:\n            \"\"\"\n            Computes the maximum of two validated float values, handling NaN.\n            Returns a MaxResult DTO with the maximum float value.\n            \"\"\"\n            # Handle NaN values as per Python's math.nan behavior: propagate if either is NaN.\n            if math.isnan(a_val) and math.isnan(b_val):\n                return MaxResult(math.nan, -1) # Both NaN, arbitrary index\n            elif math.isnan(a_val):\n                return MaxResult(b_val, 1) # b is chosen as non-NaN\n            elif math.isnan(b_val):\n                return MaxResult(a_val, 0) # a is chosen as non-NaN\n\n            # Standard comparison\n            if a_val >= b_val:\n                return MaxResult(a_val, 0)\n            else:\n                return MaxResult(b_val, 1)\n\n    # --- Main function logic, simulating MaxController's role ---\n\n    # Instantiate validator with string conversion disabled by default as per design\n    validator = NumberValidator(allow_string_conversion=False)\n\n    # Instantiate service; repository is not required for this computation\n    service = MaxService(repository=None)\n\n    # 1. Validate inputs (FR1, FR2)\n    # The `validate` method will raise ValidationError for non-numeric types\n    val_a = validator.validate(a)\n    val_b = validator.validate(b)\n\n    # 2. Compute max using service (FR1, FR3)\n    max_result_dto = service.compute_max(val_a, val_b)\n    final_max_value_float = max_result_dto.value\n\n    # 3. Apply type preference (FR1, Business Rule)\n    # Preserve integer type if both original inputs were ints and result is integer-valued.\n    original_a_is_int = isinstance(a, int)\n    original_b_is_int = isinstance(b, int)\n\n    if _PREFERRED_INT_RETURN and original_a_is_int and original_b_is_int and final_max_value_float.is_integer():\n        return int(final_max_value_float)\n    else:\n        return final_max_value_float", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/429": [{"task_id": "Mbpp/429", "solution": "def and_tuples(a, b):\n    \"\"\"\n    Computes the elementwise bitwise AND of corresponding integers from two input tuples.\n    Assumes inputs are sequences of integers with compatible lengths based on problem constraints.\n    \"\"\"\n    return tuple(x & y for x, y in zip(a, b))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/432": [{"task_id": "Mbpp/432", "solution": "from dataclasses import dataclass\nfrom typing import Optional, Any\nclass InvalidDimensionError(Exception):\n    \"\"\"Custom exception for invalid geometric dimensions.\n    It provides a clear message about the validation failure.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n    def __str__(self):\n        return self.message\ndef validate_positive_number(value: Any, name: str) -> float:\n    \"\"\"Validates if a value is a positive number and returns it as a float.\n    Raises InvalidDimensionError if the value is not numeric or not positive.\"\"\"\n    try:\n        v = float(value)\n    except (TypeError, ValueError):\n        raise InvalidDimensionError(f\"{name} must be a number.\")\n    if v <= 0:\n        raise InvalidDimensionError(f\"{name} must be > 0.\")\n    return v\ndef parse_and_validate(base1: Any, base2: Any, aux: Any | None = None) -> Trapezium:\n    \"\"\"Parses and validates input bases and an optional auxiliary parameter into a Trapezium object.\n    Uses validate_positive_number for each dimension.\"\"\"\n    b1 = validate_positive_number(base1, \"base1\")\n    b2 = validate_positive_number(base2, \"base2\")\n    a = None\n    if aux is not None:\n        a = validate_positive_number(aux, \"aux\")\n    return Trapezium(b1, b2, a)\nclass TrapeziumService:\n    \"\"\"Provides business logic for trapezium calculations.\n    It is a stateless service with a method for median calculation.\"\"\"\n    def median(self, trap: Trapezium) -> float:\n        \"\"\"Calculates the median length of a trapezium from its bases.\n        Raises InvalidDimensionError if bases in the Trapezium object are not positive.\"\"\"\n        if trap.base1 <= 0 or trap.base2 <= 0:\n            raise InvalidDimensionError(\"Bases must be positive numbers.\")\n        return self._compute_average(trap.base1, trap.base2)\n\n    def _compute_average(self, a: float, b: float) -> float:\n        return (a + b) / 2.0\nclass TrapeziumController:\n    \"\"\"Orchestrates input validation and service calls for trapezium calculations.\n    It bridges raw inputs from external interfaces to the core service logic.\"\"\"\n    def __init__(self, service: TrapeziumService) -> None:\n        self._service = service\n\n    def compute_median(self, base1: Any, base2: Any, aux: Any | None = None) -> float:\n        \"\"\"Computes the median length, handling input parsing and validation.\n        It uses the parse_and_validate function and then calls the service layer.\"\"\"\n        trap = parse_and_validate(base1, base2, aux)\n        return self._service.median(trap)\n_service = TrapeziumService()\n_controller = TrapeziumController(_service)\ndef median_trapezium(base1: float, base2: float, aux: float | None = None) -> float:\n    \"\"\"\n    Convenience function: compute median.\n    Matches example usage: assert median_trapezium(15,25,35) == 20\n    \"\"\"\n    return _controller.compute_median(base1, base2, aux)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/430": [{"task_id": "Mbpp/430", "solution": "def parabola_directrix(a, b, c):\n    \"\"\"\n    Computes the directrix of a vertical parabola defined by y = a*x^2 + b*x + c.\n    Returns the y-coordinate of the directrix (a float).\n    \"\"\"\n    if a == 0:\n        raise ValueError(\"Coefficient 'a' must be non-zero for a parabola.\")\n    # vertex (h, k)\n    h = -b / (2.0 * a)\n    k = c - (b * b) / (4.0 * a)\n    # focal length p = 1/(4a)\n    p = 1.0 / (4.0 * a)\n    # directrix: y = k - p\n    return k - p", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[5, 3, 2]], "plus_fail_tests": [[0, 0, 0]]}], "Mbpp/433": [{"task_id": "Mbpp/433", "solution": "def check_greater(array, value) -> bool:\n    \"\"\"Checks if a value is strictly greater than all elements in an array.\n\n    This function initializes and uses the internal application components\n    to perform validation and the core comparison logic.\n    \"\"\"\n    from .controller import CheckGreaterController\n    from .service import CheckGreaterService\n    from .core import CheckGreaterCore\n    from .validators import InputValidator\n\n    _core = CheckGreaterCore()\n    _validator = InputValidator()\n    _service = CheckGreaterService(_validator, _core)\n    _controller = CheckGreaterController(_service)\n\n    return _controller.handle(array, value)", "base_status": "fail", "plus