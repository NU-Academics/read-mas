tion):\n    pass\nclass EmptyInputError(ValidationError):\n    pass\ndef is_iterable(obj) -> bool:\n    \"\"\"Checks if an object is iterable but not a string or bytes.\"\"\"\n    return isinstance(obj, Iterable) and not isinstance(obj, (str, bytes))\ndef safe_hashable(obj) -> bool:\n    \"\"\"Checks if an object is hashable.\"\"\"\n    return isinstance(obj, Hashable)\nclass ListFlattener:\n    MAX_RECURSION_DEPTH = 2\n\n    def flatten(self, lists: Iterable[Iterable[Any]]) -> Iterator[Any]:\n        \"\"\"Yields items from each inner iterable in order.\"\"\"\n        for inner in lists:\n            if is_iterable(inner):\n                for item in inner:\n                    yield item\n            else:\n                yield inner\nclass FrequencyService:\n    def __init__(self, flattener: ListFlattener):\n        self._flattener = flattener\n\n    def compute_frequency(self, lists: Iterable[Iterable[Any]]) -> FrequencyResult:\n        \"\"\"Computes the frequency of elements in a flattened list of lists.\"\"\"\n        if lists is None:\n            raise EmptyInputError(\"Input is None\")\n        counter = Counter()\n        total = 0\n        for item in self._flattener.flatten(lists):\n            if not safe_hashable(item):\n                raise ValidationError(f\"Unhashable item: {item!r}\")\n            counter[item] += 1\n            total += 1\n        return FrequencyResult(dict(counter), total)\ndef frequency_lists(lists: Iterable[Iterable[Any]]) -> Dict[Any, int]:\n    \"\"\"\n    Finds the frequency of each element in a flattened list of lists.\n    Returns a dictionary mapping elements to their counts.\n    \"\"\"\n    flattener = ListFlattener()\n    svc = FrequencyService(flattener)\n    result = svc.compute_frequency(lists)\n    return result.counts", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/103": [{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Computes the Eulerian number a(n, m) for integers n >= 0 and 0 <= m < n.\n    Raises ValueError for invalid inputs.\n    \"\"\"\n    # Validate n\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer.\")\n\n    # Validate m\n    if not isinstance(m, int):\n        raise ValueError(\"m must be an integer.\")\n\n    # Base case for n = 0\n    if n == 0:\n        if m == 0:\n            return 1\n        else:\n            raise ValueError(\"For n=0, m must be 0.\")\n\n    # For n > 0, m must be in the range [0, n-1]\n    if not (0 <= m < n):\n        raise ValueError(f\"For n={n} > 0, m must be in the range [0, {n-1}]. Got m={m}.\")\n\n    # Dynamic programming using rolling arrays\n    # dp will store the Eulerian numbers for the previous row (n-1)\n    # Initialize dp for n=1: a(1,0) = 1\n    dp = [1]\n\n    # Iterate from k=2 up to n (current row index)\n    for k in range(2, n + 1):\n        # next_dp will store the Eulerian numbers for the current row k\n        # It needs k elements for m from 0 to k-1\n        next_dp = [0] * k\n        for j in range(k):  # j corresponds to m, from 0 to k-1\n            # Apply the recurrence relation:\n            # a(k,j) = (k - j) * a(k-1,j-1) + (j + 1) * a(k-1,j)\n\n            # Term for a(k-1, j-1)\n            # If j=0, then j-1 is out of bounds, so a(k-1,-1) is 0\n            term1 = (k - j) * (dp[j - 1] if j > 0 else 0)\n\n            # Term for a(k-1, j)\n            # If j is out of bounds for dp (i.e., j >= len(dp)), then a(k-1,j) is 0\n            term2 = (j + 1) * (dp[j] if j < len(dp) else 0)\n\n            next_dp[j] = term1 + term2\n        dp = next_dp\n\n    # Return the computed value for a(n, m)\n    return dp[m]", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[0, 0]]}], "Mbpp/102": [{"task_id": "Mbpp/102", "solution": "def snake_to_camel(snake_case_string: str) -> str:\n    \"\"\"\n    Converts a snake_cas