lements.append(float(x_val))\n                    else:\n                        self._raise_non_numeric(x_val, name)\n                return validated_elements\n            except TypeError:\n                raise InvalidListError(f\"{name} must be a sequence (iterable) of numbers\")\n\n        def _raise_non_numeric(self, x_val: Any, name_str: str):\n            raise InvalidListError(f\"{name_str} contains non-numeric element: {x_val}\")\n\n    class ListService:\n        \"\"\"Performs the core element-wise subtraction logic.\"\"\"\n        def subtract(self, pair_obj: ListPair) -> ResultList:\n            values = [self._subtract_elements(a_val, b_val) for a_val, b_val in zip(pair_obj.left, pair_obj.right)]\n            return ResultList(values)\n\n        def _subtract_elements(self, a_val: float, b_val: float) -> float:\n            return a_val - b_val\n\n    class ListController:\n        \"\"\"The public API entry point for list subtraction.\"\"\"\n        def __init__(self, validator_obj: InputValidator = None, service_obj: ListService = None):\n            self.validator = validator_obj or InputValidator()\n            self.service = service_obj or ListService()\n\n        def sub_list_internal(self, left_arg: Sequence[Any], right_arg: Sequence[Any]) -> List[float]:\n            pair = self.validator.validate_pair(left_arg, right_arg)\n            result = self.service.subtract(pair)\n            return result.to_list()\n\n    # Instantiate the controller and call its internal method\n    controller_instance = ListController()\n    return controller_instance.sub_list_internal(left, right)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/284": [{"task_id": "Mbpp/284", "solution": "def check_element(lst, element):\n    \"\"\"\n    Checks if all items in the list are equal to the given element.\n    Returns True for an empty list.\n    \"\"\"\n    for item in lst:\n        if item != element:\n           