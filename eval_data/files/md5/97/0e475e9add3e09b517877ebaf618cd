d by word characters,\n    # ensuring it's in the middle of a word.\n    return bool(re.search(r'\\w[zZ]\\w', text, re.IGNORECASE))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/644": [{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(array: list, k: int) -> list:\n    \"\"\"\n    Reverses the first K elements of a list, returning a new list.\n    Handles K values greater than the array length by reversing the entire array.\n    \"\"\"\n    result = list(array)  # Create a shallow copy to avoid mutating the original array\n\n    effective_k = min(k, len(result))\n\n    left_ptr = 0\n    right_ptr = effective_k - 1\n\n    while left_ptr < right_ptr:\n        result[left_ptr], result[right_ptr] = result[right_ptr], result[left_ptr]\n        left_ptr += 1\n        right_ptr -= 1\n\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/630": [{"task_id": "Mbpp/630", "solution": "from dataclasses import dataclass\nfrom typing import Tuple, List, Any, Union\nclass CoordinateExtractor:\n    \"\"\"Extracts adjacent coordinates for a given Coordinate.\"\"\"\n    def extract(self, coord: Coordinate) -> List[Coordinate]:\n        \"\"\"Calculates the 3x3 grid of adjacent coordinates.\"\"\"\n        neighbors = []\n        for dx in (-1, 0, 1):\n            for dy in (-1, 0, 1):\n                neighbors.append(Coordinate(coord.x + dx, coord.y + dy))\n        return neighbors\ndef validate_coordinate_input(coord_input: Any) -> Coordinate:\n    \"\"\"Converts a tuple input to a Coordinate object, assuming valid input.\"\"\"\n    # Per instructions, no explicit isinstance checks or ValueError raises for invalid types.\n    if isinstance(coord_input, Coordinate):\n        return coord_input\n    # Assume coord_input is a valid Tuple[int, int] if not already a Coordinate.\n    x, y = coord_input\n    return Coordinate(x, y)\ndef coords_to_list_list(