{"task_id": "Mbpp/290", "solution": "def max_length(list_of_lists):\n    \"\"\"\n    Finds the list of maximum length in a list of lists.\n    Returns a tuple containing the maximum length and the corresponding list.\n    \"\"\"\n\n    def _validate_input(data):\n        \"\"\"\n        Validates if the input is a list of lists.\n        Raises ValueError if the input structure is invalid.\n        \"\"\"\n        if not isinstance(data, list):\n            raise ValueError(\"Input must be a list.\")\n        for item in data:\n            if not isinstance(item, list):\n                raise ValueError(\"All elements in the input list must be lists.\")\n        return True\n\n    def _find_maximum_length(data_list):\n        \"\"\"\n        Iterates through the list of lists to find the maximum length and its corresponding list.\n        Returns a tuple (max_length, max_list).\n        \"\"\"\n        max_len = 0\n        max_list = []\n\n        for sublist in data_list:\n            if len(sublist) > max_len:\n                max_len = len(sublist)\n                max_list = sublist\n        return (max_len, max_list)\n\n    _validate_input(list_of_lists)\n\n    result_length, result_list = _find_maximum_length(list_of_lists)\n\n    return (result_length, result_list)"}
{"task_id": "Mbpp/294", "solution": "import math\n\ndef max_val(input_list: list):\n    \"\"\"\n    Finds the maximum numeric value in a heterogeneous list.\n    It filters out non-numeric elements and returns the maximum of the remaining numbers.\n    \"\"\"\n    numeric_values = [item for item in input_list if isinstance(item, (int, float))]\n\n    if not numeric_values:\n        # The design context's \"Edge Case Handling\" sequence diagram suggests raising ValueError\n        # but \"Requirement Overview\" and \"System Implementation\" implies no exceptions for non-numeric.\n        # Given \"assert max_val(['Python', 3, 2, 4, 5, 'version'])==5\", an empty list of numbers is fine if other numbers exist.\n        # If the whole list is non-numeric, the result is undefined based on the provided requirements.\n        # To avoid raising an exception as per requirements (\"robust error handling without raising exceptions\"),\n        # and given the assert example, returning None or handling this case differently would be needed if explicitly specified.\n        # For now, if no numeric values are found, and no explicit error handling is defined for this specific \"no numeric values\" case\n        # (beyond \"ignoring non-numeric elements\"), returning None seems a reasonable default for \"no max found\".\n        # However, `max()` on an empty list raises ValueError, so if we must avoid exceptions, a sentinel or None would be alternative.\n        # Given \"robust error handling without raising exceptions for non-numeric values\", and the example working,\n        # it implies that if no numbers, it should result in some form of 'empty' result, not an error.\n        # Let's consider the core `max()` function behavior: it raises ValueError on an empty iterable.\n        # Since the design emphasizes \"robust error handling without raising exceptions\", returning None is a common practice\n        # when a \"max\" cannot be determined, as opposed to raising an error.\n        return None \n    \n    return max(numeric_values)"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(array: list) -> int:\n    \"\"\"Count inversions in array where i < j and array[i] > array[j].\"\"\"\n    inversion_count = 0\n    n = len(array)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if array[i] > array[j]:\n                inversion_count += 1\n    return inversion_count"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(tuple_list: list) -> tuple:\n    \"\"\"\n    Calculate maximum aggregate from list of name-value tuples.\n    Aggregates values for each name and returns the name with the highest total sum.\n    \"\"\"\n    aggregated_data = {}\n    for name, value in tuple_list:\n        aggregated_data[name] = aggregated_data.get(name, 0) + value\n\n    if not aggregated_data:\n        return (\"\", 0) # Return default for empty input list or no valid data\n\n    max_name = None\n    max_sum = -float('inf')\n\n    for name, total_sum in aggregated_data.items():\n        if total_sum > max_sum:\n            max_sum = total_sum\n            max_name = name\n\n    return (max_name, max_sum)"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(nested_list):\n    \"\"\"\n    Flattens a given nested list structure into a single-level list while preserving element order.\n    It recursively processes sublists to extract all elements.\n    \"\"\"\n    flattened = []\n    for item in nested_list:\n        if isinstance(item, list):\n            flattened.extend(flatten_list(item))\n        else:\n            flattened.append(item)\n    return flattened"}
{"task_id": "Mbpp/300", "solution": "import math\n\ndef count_binary_seq(n: int) -> float:\n    \"\"\"\n    Calculates the count of binary sequences of length 2n where the sum of the first n bits equals the sum of the last n bits.\n    This count is equivalent to the central binomial coefficient C(2n, n).\n    \"\"\"\n    result = math.comb(2 * n, n)\n    return float(result)"}
{"task_id": "Mbpp/301", "solution": "def _is_dict(value):\n    \"\"\"Checks if a given value is a dictionary.\"\"\"\n    return isinstance(value, dict)\n\ndef _calculate_max_depth(current_dict, current_depth):\n    \"\"\"Recursively calculates the maximum depth of nested dictionaries.\"\"\"\n    max_nested_depth = current_depth\n    for value in current_dict.values():\n        if _is_dict(value):\n            nested_depth = _calculate_max_depth(value, current_depth + 1)\n            max_nested_depth = max(max_nested_depth, nested_depth)\n    return max_nested_depth\n\ndef dict_depth(dictionary):\n    \"\"\"\n    Calculates the maximum depth of a dictionary, starting at 1 for the outermost level.\n    \"\"\"\n    if not dictionary:\n        return 1 # An empty dictionary itself is considered depth 1.\n    return _calculate_max_depth(dictionary, 1)"}
{"task_id": "Mbpp/305", "solution": "def start_withp(input_list: list) -> tuple:\n    \"\"\"\n    Returns two words starting with letter 'p' from a list of strings.\n\n    Args:\n        input_list: List of strings containing space-separated words\n\n    Returns:\n        Tuple containing exactly two words that start with 'p' (case-insensitive for the first letter).\n    \"\"\"\n    p_words = []\n    for sentence in input_list:\n        words = sentence.split()\n        for word in words:\n            if word.startswith('p') or word.startswith('P'):\n                p_words.append(word)\n                if len(p_words) == 2:\n                    return (p_words[0], p_words[1])\n    return tuple() # Should not be reached based on problem statement having enough words for the example."}
