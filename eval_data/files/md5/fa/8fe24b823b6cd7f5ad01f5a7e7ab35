{"task_id": "Mbpp/457", "solution": "def Find_Min(sublists_list: list) -> list:\n    \"\"\"\n    Finds and returns the sublist with the minimum length from a list of sublists.\n    If the input list is empty, an empty list is returned.\n    \"\"\"\n    if not sublists_list:\n        return []\n    \n    return min(sublists_list, key=len)"}
{"task_id": "Mbpp/460", "solution": "def Extract(input_list: list) -> list:\n    \"\"\"\n    Extracts the first element from each sublist in a given list of sublists.\n    Returns a new list containing these first elements.\n    \"\"\"\n    result = []\n    for sublist in input_list:\n        result.append(sublist[0])\n    return result"}
{"task_id": "Mbpp/459", "solution": "def remove_uppercase(input_string: str) -> str:\n    \"\"\"\n    Remove all consecutive uppercase letter substrings from input string.\n    \"\"\"\n    result = []\n    for char in input_string:\n        if not char.isupper():\n            result.append(char)\n    return \"\".join(result)"}
{"task_id": "Mbpp/462", "solution": "from typing import List\n\ndef combinations_list(input_list: List) -> List[List]:\n    \"\"\"Generate all possible combinations of input list elements.\n\n    Args:\n        input_list: List of elements of any type\n\n    Returns:\n        List of lists containing all possible combinations (2^n total)\n    \"\"\"\n    all_combinations = [[]]  # Start with an empty list, representing the empty set\n\n    for element in input_list:\n        # For each element, create new combinations by prepending it\n        # to all existing combinations at the time of processing this element.\n        current_num_combinations = len(all_combinations)\n        for i in range(current_num_combinations):\n            # Create a new combination by taking an existing one and\n            # prepending the current element. This preserves the relative order\n            # of elements that are already in the existing combination.\n            new_combo = [element] + all_combinations[i]\n            all_combinations.append(new_combo)\n            \n    return all_combinations"}
{"task_id": "Mbpp/465", "solution": "def drop_empty(input_dict: dict) -> dict:\n    \"\"\"\n    Remove dictionary entries where the value is None.\n    \"\"\"\n    return {key: value for key, value in input_dict.items() if value is not None}"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(array: list) -> int:\n    \"\"\"\n    Calculate the maximum product of any contiguous subarray.\n\n    Args:\n        array: List of numeric values\n\n    Returns:\n        Maximum product of contiguous subarray\n    \"\"\"\n    if not array:\n        return 0 # Or handle error, but design implies non-empty arrays with array[0] access\n\n    max_ending_here = array[0]\n    min_ending_here = array[0]\n    max_so_far = array[0]\n\n    for i in range(1, len(array)):\n        num = array[i]\n        \n        # Store max_ending_here because it will be updated before min_ending_here needs its old value\n        temp_max = max_ending_here\n\n        max_ending_here = max(num, temp_max * num, min_ending_here * num)\n        min_ending_here = min(num, temp_max * num, min_ending_here * num)\n        \n        max_so_far = max(max_so_far, max_ending_here)\n\n    return max_so_far"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(array, n):\n    \"\"\"\n    Calculate the product of array elements modulo n.\n    Prevents integer overflow by applying the modulo operation at each multiplication step.\n    \"\"\"\n    product = 1\n    for x in array:\n        product = (product * x) % n\n    return product"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Calculates the sum of neighboring elements in the given tuple.\n    Returns a new tuple containing the pairwise sums.\n    \"\"\"\n    sums = []\n    for i in range(len(input_tuple) - 1):\n        sums.append(input_tuple[i] + input_tuple[i+1])\n    return tuple(sums)"}
{"task_id": "Mbpp/468", "solution": "def generate_subsequences(arr):\n    \"\"\"Generates all possible non-empty subsequences from the input array while maintaining relative order.\"\"\"\n    all_subsequences = []\n    n = len(arr)\n\n    def backtrack(current_subsequence, start_index):\n        if current_subsequence:\n            all_subsequences.append(list(current_subsequence))\n\n        for i in range(start_index, n):\n            current_subsequence.append(arr[i])\n            backtrack(current_subsequence, i + 1)\n            current_subsequence.pop() # Backtrack\n\n    backtrack([], 0)\n    return all_subsequences\n\ndef is_increasing(subseq):\n    \"\"\"Validates if a subsequence is strictly increasing.\"\"\"\n    if len(subseq) <= 1:\n        return True\n    for i in range(1, len(subseq)):\n        if subseq[i] <= subseq[i-1]:\n            return False\n    return True\n\ndef calculate_product(subseq):\n    \"\"\"Calculates the product of all elements in a subsequence.\"\"\"\n    product = 1\n    for num in subseq:\n        product *= num\n    return product\n\ndef find_maximum(products):\n    \"\"\"Finds the maximum value from a list of products, returning 0 if the list is empty.\"\"\"\n    if not products:\n        return 0\n    return max(products)\n\ndef max_product(arr):\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of an increasing subsequence of that array.\n    \"\"\"\n    if not arr:\n        return 0\n\n    all_subsequences = generate_subsequences(arr)\n    \n    products_of_increasing_subsequences = []\n    for subseq in all_subsequences:\n        if is_increasing(subseq):\n            products_of_increasing_subsequences.append(calculate_product(subseq))\n    \n    # If no increasing subsequences (e.g., all numbers are negative or empty input, handled by find_maximum)\n    # The problem context implies positive numbers, so there will always be at least single-element subsequences.\n    return find_maximum(products_of_increasing_subsequences)"}
