{"task_id": "Mbpp/63", "solution": "from typing import List, Tuple, Union\n\ndef max_difference(tuple_list: List[Tuple[Union[int, float], Union[int, float]]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the maximum absolute difference between elements within any tuple in a list.\n    Assumes valid input where each tuple contains exactly two numeric elements.\n    \"\"\"\n    if not tuple_list:\n        return 0.0  # Return 0.0 for an empty list as there are no differences to calculate.\n\n    max_diff = 0.0\n    for a, b in tuple_list:\n        current_diff = abs(a - b)\n        if current_diff > max_diff:\n            max_diff = current_diff\n    return max_diff"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(input_list):\n    \"\"\"\n    Recursively flatten a nested list and sum all numeric elements.\n    It iterates through the list, summing numbers and recursively processing sublists.\n    \"\"\"\n    total_sum = 0\n    for item in input_list:\n        if isinstance(item, list):\n            total_sum += recursive_list_sum(item)\n        elif isinstance(item, (int, float)):\n            total_sum += item\n    return total_sum"}
