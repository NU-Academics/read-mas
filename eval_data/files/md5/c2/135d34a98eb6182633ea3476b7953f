al/126": [{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    \"\"\"\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    \"\"\"\n    if len(lst) <= 1:\n        return True\n\n    counts = {}\n    for i, num in enumerate(lst):\n        # Check for duplicates: a number can appear at most twice.\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] > 2:\n            return False\n\n        # Check for ascending order for elements after the first.\n        if i > 0:\n            if num < lst[i - 1]:\n                return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/128": [{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Returns sum of magnitudes multiplied by product of signs for an array of integers.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_magnitudes = 0\n    product_of_signs = 1\n\n    for num in arr:\n        sum_magnitudes += abs(num)\n        if num > 0:\n            product_of_signs *= 1\n        elif num < 0:\n            product_of_signs *= -1\n        else:  # num == 0\n            product_of_signs *= 0\n            # If a zero is encountered, the product of signs will be zero,\n            # so the final result will be zero. We can short-circuit here.\n            # However, for clarity and simplicity based on the design which\n            # implies a full pass, we complete the loop.\n\n    return sum_magnitudes * product_of_signs", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/132": [{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if a string containing only square brackets has a valid subsequence of\n    brackets where at least one bracket in the subsequence is nested.\n    \"\"\"\n    open_brackets_count = 0\n    nested_found = False\n\n    for char in string:\n        if char == '[':\n            open_brackets_count += 1\n            if open_brackets_count > 1:\n                nested_found = True\n        elif char == ']':\n            # If a closing bracket appears without an open one,\n            # it indicates an invalid bracket sequence context.\n            if open_brackets_count == 0:\n                return False\n            open_brackets_count -= 1\n        else:\n            # The input must contain only square brackets.\n            return False\n            \n    # If nested_found is True, it means a structure like '[[...]]' was encountered.\n    # The balance of the entire string (open_brackets_count == 0) is not required,\n    # as long as a valid nested subsequence (like '[[...]]') could be formed from parts of it.\n    return nested_found", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["[[]"]], "plus_fail_tests": [["[[]]]"]]}], "HumanEval/131": [{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    product_of_odds = 1\n    has_odd_digit = False\n\n    # Convert the integer to a string to easily iterate through its digits\n    for digit_char in str(n):\n        digit = int(digit_char)\n        if digit % 2 != 0:  # Check if the digit is odd\n            product_of_odds *= digit\n            has_odd_digit = True\n    \n    # If no odd digits were found, return 0 as per the requirement\n    if not has_odd_digit:\n        return 0\n    else:\n        return product_of_odds", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/133": [{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    Examples:\n    For lst = [1,2,3] the output should be 14\n    For lst = [1,4,9] the output should be 98\n    For lst = [1,3,5,7] the output should be 84\n    For lst = [1.4,4.2,0] the output should be 29\n    For lst = [-2.4,1,1] the output should be 6\n    \"\"\"\n    return sum(int(math.ceil(x))**2 for x in lst)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/136": [{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n    '''\n    largest_neg = None\n    smallest_pos = None\n\n    for num in lst:\n        if num < 0:\n            if largest_neg is None or num > largest_neg:\n                largest_neg = num\n        elif num > 0:\n            if smallest_pos is None or num < smallest_pos:\n                smallest_pos = num\n\n    return (largest_neg, smallest_pos)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/39": [{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    \"\"\"\n\n    def is_prime(num: int) -> bool:\n        \"\"\"Checks if a number is prime.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    # Initialize Fibonacci sequence with F(1)=1, F(2)=1.\n    # The first Fibonacci number to check will be F(3)=2.\n    a, b = 1, 1\n    prime_fib_count = 0\n\n    while True:\n        next_fib = a + b\n        a, b = b, next_fib  # Update sequence: a becomes the previous b, b becomes the new next_fib\n        \n        if is_prime(next_fib):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                return next_fib", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[12]]}], "HumanEval/134": [{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Create a function that returns True if the last character\n    of a given string is an alphabetical character and is not\n    a part of a word, and False otherwise.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n\n    # Check the character before the last one\n    char_before_last = txt[-2]\n    \n    # If the character before the last one is not an alphabet,\n    # then the last_char is a standalone letter.\n    if not char_before_last.isalpha():\n        return True\n    else:\n        # If the character before the last one is also an alphabet,\n        # then last_char is part of a word.\n        return False", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["aaaaa aaaaa 1A"]]}], "HumanEval/135": [{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Returns the largest index of an element not greater than or equal to its predecessor.\n    Returns -1 if no such element exists.\n    \"\"\"\n    n = len(arr)\n    # Iterate from the end of the array towards the beginning.\n    for i in range(n - 1, 0, -1):\n        # If an element is smaller than its preceding element, this is the largest such index.\n        if arr[i] < arr[i - 1]:\n            return i\n    # If no such element is found, return -1.\n    return -1", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/138": [{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers.\"\"\"\n    # A number can be written as the sum of exactly 4 positive even numbers\n    # if and only if it is even and greater than or equal to 8.\n    return n >= 8 and n % 2 == 0", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/137": [{"task_id": "HumanEval/137", "solution": "import re\nfrom dataclasses import dataclass\nfrom typing import Any, Union\nclass Parser:\n    @staticmethod\n    def parse(input_obj: NumberInput) -> float:\n        if isinstance(input_obj.value, (int, float)):\n            return float(input_obj.value)\n        if isinstance(input_obj.value, str):\n            cleaned = input_obj.value.replace(',', '.')\n            if re.fullmatch(r'[-+]?\\d+(\\.\\d+)?', cleaned):\n                return float(cleaned)\n        raise ValueError(f\"Invalid numeric string: {input_obj.value}\")\nclass Comparator:\n    @staticmethod\n    def compare(a: NumberInput, b: NumberInput) -> NumberInput | None:\n        parser = Parser()\n        num_a = parser.parse(a)\n        num_b = parser.parse(b)\n        if num_a > num_b:\n            return a\n        if num_b > num_a:\n            return b\n        return None\ndef compare_one(a: Union[int, float, str], b: Union[int, float, str]) -> Union[int, float, str, None]:\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n\n    compare_one(1, 2.5) \u279e 2.5\n    compare_one(1, \"2,3\") \u279e \"2,3\"\n    compare_one(\"5,1\", \"6\") \u279e \"6\"\n    compare_one(\"1\", 1) \u279e None\n    \"\"\"\n    # Validate inputs as per design document\n    for val in (a, b):\n        if not isinstance(val, (int, float, str)):\n            raise ValueError(f\"Unsupported type: {type(val).__name__}\")\n        if isinstance(val, str):\n            # Basic numeric string check before parsing\n            if not val.replace(',', '').replace('.', '').lstrip('+-').isdigit():\n                raise ValueError(f\"Invalid numeric string: {val}\")\n\n    a_input = NumberInput(value=a, type=type(a).__name__)\n    b_input = NumberInput(value=b, type=type(b).__name__)\n\n    result = Comparator.compare(a_input, b_input)\n    return result.value if result is not None else None", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/140": [{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \"\"\"\n    result = []\n    i = 0\n    n = len(text)\n\n    while i < n:\n        if text[i] == ' ':\n            space_count = 0\n            # Count consecutive spaces\n            j = i\n            while j < n and text[j] == ' ':\n                space_count += 1\n                j += 1\n\n            # Apply replacement rule based on space_count\n            if space_count <= 2:\n                result.append('_')\n            else: # space_count > 2\n                result.append('-')\n            \n            # Move the main index past the processed space sequence\n            i = j\n        else:\n            # Append non-space characters directly\n            result.append(text[i])\n            i += 1\n            \n    return \"\".join(result)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["Yellow Yellow  Dirty  Fellow"]], "plus_fail_tests": [["  spaces  every  where  "]]}], "HumanEval/141": [{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file name is valid according to specific conditions.\"\"\"\n\n    # Condition 2: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    parts = file_name.split('.')\n    base_name = parts[0]\n    extension = parts[1]\n\n    # Condition 3: The substring before the dot should not be empty.\n    if not base_name:\n        return 'No'\n\n    # Condition 3: The substring before the dot starts with a letter.\n    if not base_name[0].isalpha():\n        return 'No'\n\n    # Condition 4: The substring after the dot should be one of ['txt', 'exe', 'dll'].\n    if extension not in ['txt', 'exe', 'dll']:\n        return 'No'\n\n    # Condition 1: There should not be more than three digits ('0'-'9') in the file's name.\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    return 'Yes'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/143": [{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    You are given a string representing a sentence,\n    the sentence contains some words separated by a space,\n    and you have to return a string that contains the words from the original sentence,\n    whose lengths are prime numbers,\n    the order of the words in the new string should be the same as the original one.\n    \"\"\"\n    def is_prime(n):\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    words = sentence.split()\n    prime_length_words = []\n    for word in words:\n        if is_prime(len(word)):\n            prime_length_words.append(word)\n\n    return \" \".join(prime_length_words)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/142": [{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        modified_num = num\n        if i % 3 == 0:\n            modified_num = num ** 2\n        elif i % 4 == 0: # This condition implicitly means i is a multiple of 4 AND NOT a multiple of 3 due to the `elif`.\n            modified_num = num ** 3\n        # If neither condition is met, modified_num remains the original num.\n        total_sum += modified_num\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/144": [{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Checks if the product of two fractions, x and n, is a whole number.\n    Returns True if x * n evaluates to a whole number, False otherwise.\n    \"\"\"\n    def _gcd(a, b):\n        \"\"\"Calculates the greatest common divisor of two integers.\"\"\"\n        while b:\n            a, b = b, a % b\n        return a\n\n    # Parse x\n    x_parts = x.split('/')\n    x_num = int(x_parts[0])\n    x_den = int(x_parts[1])\n\n    # Parse n\n    n_parts = n.split('/')\n    n_num = int(n_parts[0])\n    n_den = int(n_parts[1])\n\n    # Multiply fractions\n    product_num = x_num * n_num\n    product_den = x_den * n_den\n\n    # Simplify the resulting fraction\n    common_divisor = _gcd(product_num, product_den)\n    simplified_den = product_den // common_divisor\n\n    # A fraction is a whole number if its simplified denominator is 1\n    return simplified_den == 1", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/145": [{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    If several items have similar sum of their digits, they are ordered based on their\n    original index in the input list (stable sort).\n    \"\"\"\n\n    def get_digit_sum(n):\n        \"\"\"\n        Calculates the sum of the absolute value of the digits of an integer.\n        For example, get_digit_sum(-12) returns 3 (1+2).\n        \"\"\"\n        s = 0\n        n_abs = abs(n)\n        if n_abs == 0:\n            return 0\n        while n_abs > 0:\n            s += n_abs % 10\n            n_abs //= 10\n        return s\n\n    # Create a list of tuples (original_index, value)\n    # This preserves the original order for stable sorting.\n    indexed_nums = list(enumerate(nums))\n\n    # Sort the list using a custom key function.\n    # The key is a tuple: (sum_of_digits, original_index).\n    # Python's sorted() is stable. If digit sums are equal,\n    # the original_index as a secondary key will ensure original relative order.\n    sorted_indexed_nums = sorted(indexed_nums, key=lambda item: (get_digit_sum(item[1]), item[0]))\n\n    # Extract the original numbers from the sorted list\n    result = [value for original_index, value in sorted_indexed_nums]\n\n    return result", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 11, -1, -11, -12]]], "plus_fail_tests": [[[-5, -12, 9, 15]]]}], "HumanEval/147": [{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Counts triples (a[i], a[j], a[k]) from a where i < j < k and their sum is a multiple of 3.\n    Values a[i] = i*i - i + 1.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    # These counts store how many elements a[x] (for x from 1 to n)\n    # have a remainder of 0 or 1 when divided by 3.\n    # From a[x] = x*x - x + 1:\n    # If x % 3 == 0, then a[x] % 3 == 1.\n    # If x % 3 == 1, then a[x] % 3 == 1.\n    # If x % 3 == 2, then a[x] % 3 == 0.\n    count_mod_0 = 0 # Number of a[x] values that are 0 mod 3\n    count_mod_1 = 0 # Number of a[x] values that are 1 mod 3\n\n    for i in range(1, n + 1):\n        if i % 3 == 2:\n            count_mod_0 += 1\n        else: # i % 3 == 0 or i % 3 == 1\n            count_mod_1 += 1\n\n    # Helper function to calculate \"k choose 3\" combinations.\n    def combinations3(k):\n        if k < 3:\n            return 0\n        return k * (k - 1) * (k - 2) // 6\n\n    # For (a[i] + a[j] + a[k]) % 3 == 0, and knowing a[x]%3 can only be 0 or 1,\n    # the only possible remainder combinations are (0, 0, 0) or (1, 1, 1).\n    triples_sum_0_mod_3 = combinations3(count_mod_0)\n    triples_sum_1_mod_3 = combinations3(count_mod_1)\n    \n    return triples_sum_0_mod_3 + triples_sum_1_mod_3", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/146": [{"task_id": "HumanEval/146", "solution": "from typing import List\nclass NumberElement:\n    def __init__(self, value: int):\n        self.value = value\n        abs_val = abs(value)\n        # Handle cases where value is 0 or single digit to prevent index out of bounds if it was string based.\n        # But the problem states \"greater than 10\", so single digits are filtered anyway.\n        # Still, abs_val=0 would make str(abs_val)[0] '0', and la