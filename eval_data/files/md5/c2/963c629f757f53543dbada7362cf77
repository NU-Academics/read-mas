{"task_id": "Mbpp/245", "solution": "def max_sum(arr: list[int]) -> int:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence in the given array.\n    A bitonic subsequence is first strictly increasing and then strictly decreasing.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n\n    # inc_sums[i] stores the maximum sum of a strictly increasing subsequence ending at arr[i]\n    inc_sums = [0] * n\n    for i in range(n):\n        inc_sums[i] = arr[i]\n        for j in range(i):\n            if arr[j] < arr[i]:\n                inc_sums[i] = max(inc_sums[i], inc_sums[j] + arr[i])\n\n    # dec_sums[i] stores the maximum sum of a strictly decreasing subsequence starting at arr[i]\n    dec_sums = [0] * n\n    for i in range(n - 1, -1, -1):\n        dec_sums[i] = arr[i]\n        for j in range(n - 1, i, -1):\n            if arr[j] < arr[i]:\n                dec_sums[i] = max(dec_sums[i], dec_sums[j] + arr[i])\n\n    # The maximum sum of a bitonic subsequence centered at arr[i] is inc_sums[i] + dec_sums[i] - arr[i].\n    # We subtract arr[i] because it is included in both the increasing and decreasing sum calculations.\n    max_bitonic_sum = 0\n    for i in range(n):\n        max_bitonic_sum = max(max_bitonic_sum, inc_sums[i] + dec_sums[i] - arr[i])\n\n    return max_bitonic_sum"}
{"task_id": "Mbpp/244", "solution": "def next_Perfect_Square(n: int) -> int:\n    \"\"\"Finds the next perfect square strictly greater than a given number n.\n    It handles input validation and ensures the result is an integer.\n    \"\"\"\n    from math import isqrt\n    from typing import Any\n\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception for invalid input.\"\"\"\n        def __init__(self, message: str) -> None:\n            self.message = message\n            super().__init__(message)\n\n    class AppConfig:\n        \"\"\"Centralized configuration constants.\"\"\"\n        # Using 2**62 as max to be safely within common 64-bit integer limits,\n        # but Python integers handle arbitrary size.\n        MAX_INPUT: int = 2**62\n        MIN_INPUT: int = -(2**62)\n\n    class InputValidator:\n        \"\"\"Validates and normalizes incoming inputs.\"\"\"\n        def validate_int(self, value: Any) -> int:\n            try:\n                if isinstance(value, str):\n                    value = int(value.strip())\n                elif isinstance(value, float):\n                    raise InvalidInputError(\"float not allowed; provide integer\")\n                elif not isinstance(value, int):\n                    # Attempt conversion for other numeric types if not float\n                    value = int(value)\n            except (ValueError, TypeError):\n                raise InvalidInputError(f\"Invalid integer input: {value}\")\n            if value < AppConfig.MIN_INPUT or value > AppConfig.MAX_INPUT:\n                raise InvalidInputError(f\"input {value} out of allowed range [{AppConfig.MIN_INPUT}, {AppConfig.MAX_INPUT}]\")\n            return value\n\n    class MathService:\n        \"\"\"Provides pure mathematical helper functions.\"\"\"\n        def floor_sqrt(self, n: int) -> int:\n            \"\"\"Returns the integer floor of the square root of n. For negative n, returns -1.\"\"\"\n            if n < 0:\n                return -1  # Design spec: returns -1 for negative n for next perfect square calculation\n            return isqrt(n)\n\n        def square(self, n: int) -> int:\n            \"\"\"Returns the square of n.\"\"\"\n            return n * n\n\n    class NoopRepository:\n        \"\"\"A no-operation repository for demonstration purposes.\"\"\"\n        def save(self, query: str, result: int) -> None:\n            pass # Does nothing\n\n    class LoggerAdapter:\n        \"\"\"A simplified logging adapter.\"\"\"\n        def __init__(self, name: str = 'perfectsquare') -> None:\n            pass # In this inline context, we don't need actual logging setup\n\n        def log(self, level: str, msg: str) -> None:\n            pass # Does nothing in this simplified, inline version\n\n    class PerfectSquareService:\n        \"\"\"Orchestrates validation and computation for the next perfect square.\"\"\"\n        def __init__(self, math_service: MathService, validator: InputValidator, repo: NoopRepository | None = None, logger: LoggerAdapter | None = None) -> None:\n            self.math_service = math_service\n            self.validator = validator\n            self.repo = repo\n            self.logger = logger\n\n        def next_perfect_square(self, n: int) -> int:\n            \"\"\"Computes the smallest perfect square strictly greater than n.\"\"\"\n            validated_n = self.validator.validate_int(n)\n            \n            # Find the floor of the square root.\n            # If validated_n is negative, floor_sqrt returns -1, so (floor + 1) becomes 0, and 0^2 = 0.\n            # If validated_n is 35, floor_sqrt returns 5, so (floor + 1) becomes 6, and 6^2 = 36.\n            # If validated_n is 36, floor_sqrt returns 6, so (floor + 1) becomes 7, and 7^2 = 49.\n            sqrt_floor = self.math_service.floor_sqrt(validated_n)\n            \n            # The next perfect square is always (sqrt_floor + 1)^2\n            candidate_square = self.math_service.square(sqrt_floor + 1)\n\n            if self.repo:\n                self.repo.save(str(validated_n), candidate_square)\n            if self.logger:\n                self.logger.log(\"info\", f\"computed {candidate_square} for {validated_n}\")\n            \n            return candidate_square\n\n    # Instantiate the services and dependencies needed for the function\n    _math_service = MathService()\n    _input_validator = InputValidator()\n    _noop_repo = NoopRepository()\n    _logger_adapter = LoggerAdapter()\n    _perfect_square_service = PerfectSquareService(_math_service, _input_validator, _noop_repo, _logger_adapter)\n\n    # Call the core logic method\n    return _perfect_square_service.next_perfect_square(n)"}
{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"\n    Computes the length of the longest palindromic subsequence of the given string using dynamic programming.\n    \"\"\"\n    n = len(s)\n    if n == 0:\n        return 0\n\n    # dp[i][j] stores the length of the longest palindromic subsequence for s[i...j]\n    dp = [[0] * n for _ in range(n)]\n\n    # Base case: Every single character is a palindrome of length 1\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the DP table\n    # length represents the length of the substring being considered\n    for length in range(2, n + 1):\n        for i in range(n - length + 1):\n            j = i + length - 1 # End index of the current substring\n\n            if s[i] == s[j]:\n                # If characters match, they contribute 2 to the LPS length\n                # Add the LPS of the inner substring s[i+1...j-1]\n                dp[i][j] = dp[i + 1][j - 1] + 2 if length > 2 else 2\n            else:\n                # If characters do not match, take the maximum LPS\n                # from either excluding s[i] or excluding s[j]\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n    # The result is the LPS length for the entire string s[0...n-1]\n    return dp[0][n - 1]"}
