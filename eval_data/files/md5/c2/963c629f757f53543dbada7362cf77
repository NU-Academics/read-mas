{"task_id": "Mbpp/585", "solution": "```python\ndef expensive_items(items, n):\n    \"\"\"\n    Finds the n most expensive items in a list of dictionaries based on their 'price' key.\n    Uses a min-heap for efficient selection and sorts the final result for stable ordering.\n    \"\"\"\n    if n <= 0:\n        return []\n\n    # Map raw items to a structure that includes original index for stable sorting on ties\n    # and validates input prices.\n    processed_items = []\n    for idx, item in enumerate(items):\n        name = item.get('name')\n        price = item.get('price')\n        # Basic validation: assumes price is numeric and name exists for simplicity\n        # More robust validation would be in a dedicated validator module per design context\n        if not isinstance(price, (int, float)):\n            continue  # Skip items with non-numeric price\n        if name is None:\n            continue # Skip items with no name\n\n        processed_items.append({'name': name, 'price': price, 'original_index': idx})\n\n    # Use a min-heap to keep track of the n most expensive items found so far.\n    # The heap stores (price, inverted_index, original_item_dict) tuples.\n    # inverted_index is used to ensure stability for ties in a min-heap.\n    import heapq\n    heap = [] # Stores (price, -original_index, item_dict)\n\n    for item_data in processed_items:\n        key = (item_data['price'], -item_data['original_index'])\n        if len(heap) < n:\n            heapq.heappush(heap, (key, item_data))\n        else:\n            # If current item is more expensive than the least expensive in the heap,\n            # replace the least expensive with the current item.\n            if key > heap[0][0]:\n                heapq.heapreplace(heap, (key, item_data))\n    \n    # Extract items from the heap, which are the top N, then sort them in descending order by price.\n    # Secondary sort by original_index ascending for stable tie-breaking.\n    result_items = [t[1] for t in heap]\n    result_items.sort(key=lambda x: (-x['price'], x['original_index']))\n\n    # Remove the 'original_index' before returning, as it's an internal detail.\n    final_result = [{'name': item['name'], 'price': item['price']} for item in result_items]\n\n    return final_result\n```"}
{"task_id": "Mbpp/586", "solution": "def split_Arr(lst, n):\n    \"\"\"\n    Splits a list at the nth element and moves the first part to the end (left rotation).\n    Handles empty lists and normalizes the rotation index.\n    \"\"\"\n    if not lst:\n        return []\n    \n    # Normalize n to be within the bounds of the list length\n    # This handles negative n and n larger than the list length.\n    n = n % len(lst)\n    \n    # Split the list into two parts and concatenate them in the desired order\n    return lst[n:] + lst[:n]"}
{"task_id": "Mbpp/588", "solution": "def big_diff(nums):\n    \"\"\"\n    Finds the difference between the largest and smallest value in a given list of numbers.\n    Assumes a non-empty list of comparable numeric values.\n    \"\"\"\n    smallest = min(nums)\n    largest = max(nums)\n    return largest - smallest"}
{"task_id": "Mbpp/589", "solution": "def perfect_squares(start: int, end: int) -> list[int]:\n    \"\"\"\n    Finds perfect squares within a given range [start, end] inclusive.\n    Returns an empty list if no perfect squares are found or the range is invalid.\n    \"\"\"\n    import math\n\n    squares = []\n\n    # If the end of the range is negative, no perfect squares can exist.\n    if end < 0:\n        return squares\n\n    # Perfect squares are non-negative, so adjust start if it's negative.\n    effective_start = max(0, start)\n\n    # Calculate the smallest integer root whose square is >= effective_start.\n    # math.isqrt gives floor(sqrt(n)). If floor(sqrt(n))^2 < n, we need the next integer root.\n    first_root = math.isqrt(effective_start)\n    if first_root * first_root < effective_start:\n        first_root += 1\n\n    # Calculate the largest integer root whose square is <= end.\n    last_root = math.isqrt(end)\n\n    # Iterate through roots from first_root to last_root (inclusive) and collect their squares.\n    for r in range(first_root, last_root + 1):\n        squares.append(r * r)\n\n    return squares"}
{"task_id": "Mbpp/592", "solution": "def sum_Of_product(n):\n    \"\"\"\n    Calculates the sum of the product of consecutive binomial coefficients C(n,k)*C(n,k+1).\n    This sum is equivalent to C(2n, n-1) for n > 0, and 0 for n = 0.\n    \"\"\"\n    import math\n\n    if n == 0:\n        return 0\n    return math.comb(2 * n, n - 1)"}
{"task_id": "Mbpp/591", "solution": "def swap_List(items):\n    \"\"\"\n    Interchanges the first and last elements of a list, returning a new list.\n    If the list has fewer than two elements, a shallow copy is returned.\n    \"\"\"\n    if len(items) < 2:\n        return items.copy()\n    \n    result = items.copy()\n    result[0], result[-1] = result[-1], result[0]\n    return result"}
