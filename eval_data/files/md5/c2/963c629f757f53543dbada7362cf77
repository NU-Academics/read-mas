{"task_id": "Mbpp/475", "solution": "from typing import List, Tuple, Mapping, Any\n\ndef sort_counter(counter: Mapping[str, Any], descending: bool = True) -> List[Tuple[str, int]]:\n    \"\"\"Sorts a dictionary by its values and returns a list of (key, value) tuples.\n    The sorting is descending by default, but can be ascending if specified.\"\"\"\n    items = list(counter.items())\n    items.sort(key=lambda item: item[1], reverse=descending)\n    return items"}
{"task_id": "Mbpp/554", "solution": "def Split(items: list[int]) -> list[int]:\n    \"\"\"\n    Filters a list of integers, returning a new list containing only the odd ones.\n    This function assumes the input is a list of integers and performs no validation.\n    \"\"\"\n    return [item for item in items if item % 2 != 0]"}
{"task_id": "Mbpp/479", "solution": "def first_Digit(number):\n    \"\"\"\n    Finds the first (most significant) digit of a given number.\n    It processes integers, floats, and numeric strings by considering the absolute integer part.\n    \"\"\"\n    # Determine the absolute integer part of the input number.\n    if isinstance(number, int):\n        value = abs(number)\n    elif isinstance(number, float):\n        value = abs(int(number))\n    else: # number is assumed to be a string based on type hint context\n        # Assume number is a parseable numeric string; strip whitespace and convert.\n        s = number.strip()\n        f = float(s)\n        value = abs(int(f))\n\n    # Compute the first digit by repeatedly dividing by 10.\n    if value == 0:\n        return 0\n    while value >= 10:\n        value //= 10\n    return value"}
{"task_id": "Mbpp/555", "solution": "def difference(n):\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers using optimized formulas.\n    \"\"\"\n    # Sum of first n natural numbers (triangular number)\n    sum_n = n * (n + 1) // 2\n    \n    # Sum of cubes of first n natural numbers\n    # This is equal to the square of the sum of first n natural numbers\n    sum_cubes_n = sum_n * sum_n\n    \n    # The difference is sum_cubes_n - sum_n\n    return sum_cubes_n - sum_n"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(numbers,n):\n    \"\"\"\n    Counts pairs of numbers in a list whose XOR value is odd.\n    A pair's XOR is odd if one number is even and the other is odd.\n    \"\"\"\n    evens_count = 0\n    odds_count = 0\n    for num in numbers:\n        if num % 2 == 0:\n            evens_count += 1\n        else:\n            odds_count += 1\n    return evens_count * odds_count"}
