{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(s: str) -> int:\n    \"\"\"\n    Finds the maximum contiguous run of uppercase ASCII characters in the given string.\n    Returns 0 if no uppercase characters are found or the string is empty.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in s:\n        # Check if the character is an ASCII uppercase letter (A-Z)\n        if 'A' <= char <= 'Z':\n            current_run += 1\n            if current_run > max_run:\n                max_run = current_run\n        else:\n            current_run = 0\n    return max_run"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers):\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    The function short-circuits by returning True if any even number is found.\n    \"\"\"\n    if not numbers:\n        return False\n\n    for n in numbers:\n        if n % 2 == 0:\n            return True\n\n    return False"}
{"task_id": "Mbpp/803", "solution": "import math\nfrom typing import Union, Optional\nfrom abc import ABC, abstractmethod\nimport collections\n\n# Constants\nDEFAULT_CACHE_MAX_SIZE = 1024\n\n# Exceptions\nclass InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass CacheError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n# Data Transfer Objects\nclass ResultDTO:\n    def __init__(self, value: int, is_square: bool) -> None:\n        self.value = value\n        self.is_square = is_square\n\n# Utilities\nclass MathUtils:\n    @staticmethod\n    def normalize_to_int(raw: Union[int, float, str]) -> int:\n        if isinstance(raw, int):\n            return raw\n        if isinstance(raw, float):\n            if raw.is_integer():\n                return int(raw)\n            raise InvalidInputError(f\"Float {raw} is not integer-like\")\n        s = str(raw).strip()\n        try:\n            if '.' in s:\n                f = float(s)\n                if f.is_integer():\n                    return int(f)\n                raise InvalidInputError(f\"String '{s}' does not represent an integer\")\n            return int(s)\n        except ValueError:\n            raise InvalidInputError(f\"Cannot parse '{raw}' as integer\")\n\n    @staticmethod\n    def is_perfect_square_calc(value: int) -> bool:\n        if value < 0:\n            return False\n        root = math.isqrt(value)\n        return root * root == value\n\n# Cache Repositories\nclass CacheRepository(ABC):\n    @abstractmethod\n    def get(self, key: int) -> Optional[bool]:\n        pass\n    @abstractmethod\n    def set(self, key: int, value: bool) -> None:\n        pass\n    @abstractmethod\n    def clear(self) -> None:\n        pass\n\nclass InMemoryCacheRepository(CacheRepository):\n    def __init__(self, max_size: int = DEFAULT_CACHE_MAX_SIZE) -> None:\n        self._store = collections.OrderedDict()\n        self._max_size = max_size\n\n    def get(self, key: int) -> Optional[bool]:\n        if key in self._store:\n            value = self._store.pop(key)\n            self._store[key] = value\n            return value\n        return None\n\n    def set(self, key: int, value: bool) -> None:\n        if key in self._store:\n            self._store.pop(key)\n        self._store[key] = value\n        if len(self._store) > self._max_size:\n            self._store.popitem(last=False)\n\n    def clear(self) -> None:\n        self._store.clear()\n\n# Service\nclass PerfectSquareService:\n    def __init__(self, cache: CacheRepository = None) -> None:\n        self._cache = cache or InMemoryCacheRepository()\n\n    def check(self, raw_value: Union[int, float, str]) -> ResultDTO:\n        value = MathUtils.normalize_to_int(raw_value)\n        try:\n            cached = self._cache.get(value)\n            if cached is not None:\n                return ResultDTO(value, cached)\n        except Exception as e:\n            # Degrade gracefully on cache errors, by re-raising as CacheError.\n            raise CacheError(str(e))\n        result = MathUtils.is_perfect_square_calc(value)\n        try:\n            self._cache.set(value, result)\n        except Exception:\n            # Swallow cache write errors.\n            pass\n        return ResultDTO(value, result)\n\n# Public API Function\ndef is_perfect_square(raw_value: Union[int, float, str]) -> bool:\n    \"\"\"Checks if a number is a perfect square.\n    This function wraps PerfectSquareService for convenience.\"\"\"\n    svc = PerfectSquareService()\n    return svc.check(raw_value).is_square"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(lists):\n    \"\"\"\n    Returns the sublist from a list of lists whose sum of elements is the highest.\n    Assumes `lists` is a non-empty list of lists containing numeric values.\n    \"\"\"\n    max_current_sum = sum(lists[0])\n    max_sublist = lists[0]\n\n    for i in range(1, len(lists)):\n        current_sublist = lists[i]\n        current_sum = sum(current_sublist)\n\n        if current_sum > max_current_sum:\n            max_current_sum = current_sum\n            max_sublist = current_sublist\n            \n    return max_sublist"}
