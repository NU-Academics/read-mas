{"task_id": "Mbpp/63", "solution": "import numbers\nfrom typing import Iterable, Tuple, Any\n\nclass MaxDiffError(Exception):\n    def __init__(self, message: str = \"\") -> None:\n        super().__init__(message)\n        self.message = message\n\nclass InputValidationError(MaxDiffError):\n    def __init__(self, message: str = \"\") -> None:\n        super().__init__(message)\n\nclass CalculationError(MaxDiffError):\n    def __init__(self, message: str = \"\") -> None:\n        super().__init__(message)\n\nclass Pair:\n    def __init__(self, a: float, b: float) -> None:\n        self.a: float = float(a)\n        self.b: float = float(b)\n\n    def as_tuple(self) -> Tuple[float, float]:\n        return (self.a, self.b)\n\nclass Validator:\n    def validate_pairs(self, raw_pairs: Iterable[Any]) -> Iterable[Pair]:\n        iterator = iter(raw_pairs)\n        seen = False\n        for item in iterator:\n            seen = True\n            try:\n                a_candidate, b_candidate = item\n            except (TypeError, ValueError):\n                raise InputValidationError(f\"Each item must be a 2-element iterable, got: {item!r}\")\n            \n            if not self._is_numeric(a_candidate) or not self._is_numeric(b_candidate):\n                raise InputValidationError(f\"Elements must be numeric, got: {a_candidate!r}, {b_candidate!r}\")\n            \n            yield Pair(float(a_candidate), float(b_candidate))\n        \n        if not seen:\n            raise InputValidationError(\"Input collection is empty\")\n\n    def _is_numeric(self, v: Any) -> bool:\n        return isinstance(v, numbers.Real)\n\nclass MaxDifferenceService:\n    DEFAULT_EPSILON: float = 1e-12\n\n    def max_difference(self, pairs: Iterable[Pair]) -> float:\n        max_diff = None\n        seen = False\n        for p in pairs:\n            seen = True\n            d = abs(p.a - p.b)\n            if (max_diff is None) or (d > max_diff):\n                max_diff = d\n        if not seen:\n            raise CalculationError(\"No pairs to calculate\")\n        return float(max_diff)\n\nclass MaxDifferenceController:\n    def __init__(self, service: MaxDifferenceService, validator: Validator) -> None:\n        self._service = service\n        self._validator = validator\n\n    def compute(self, raw_pairs: Iterable[Any]) -> float:\n        validated = self._validator.validate_pairs(raw_pairs)\n        return self._service.max_difference(validated)\n\ndef max_difference(pairs):\n    \"\"\"Compute maximum absolute difference from an iterable of 2-item numeric iterables.\n    This function delegates to an internal architecture for validation and computation.\"\"\"\n    _service = MaxDifferenceService()\n    _validator = Validator()\n    _controller = MaxDifferenceController(_service, _validator)\n    return _controller.compute(pairs)"}
{"task_id": "Mbpp/62", "solution": "def smallest_num(numbers):\n    \"\"\"\n    Finds the smallest number in a list using an iterative approach.\n    Assumes the input list contains only numeric elements and is not empty.\n    \"\"\"\n    it = iter(numbers)\n    current_min = next(it)\n    for x in it:\n        if x < current_min:\n            current_min = x\n    return current_min"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(sequence):\n    \"\"\"\n    Flattens a nested list or tuple and sums all numeric elements recursively.\n    Non-numeric, non-sequence elements are ignored.\n    \"\"\"\n    total = 0\n    for item in sequence:\n        if isinstance(item, (list, tuple)):\n            total += recursive_list_sum(item)\n        elif isinstance(item, (int, float)):\n            total += item\n    return total"}
{"task_id": "Mbpp/66", "solution": "```python\ndef pos_count(numbers):\n    \"\"\"\n    Counts the number of positive numbers in a given list.\n    A number is considered positive if its value is strictly greater than zero.\n    \"\"\"\n    count = 0\n    for num in numbers:\n        if num > 0:\n            count += 1\n    return count\n```"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(arr):\n    \"\"\"\n    Checks if an array is monotonic (either non-decreasing or non-increasing).\n    Assumes the input array contains only numeric types.\n    \"\"\"\n\n    def _is_non_decreasing(values):\n        \"\"\"Helper to check if a sequence is non-decreasing.\"\"\"\n        for i in range(len(values) - 1):\n            if values[i] > values[i+1]:\n                return False\n        return True\n\n    def _is_non_increasing(values):\n        \"\"\"Helper to check if a sequence is non-increasing.\"\"\"\n        for i in range(len(values) - 1):\n            if values[i] < values[i+1]:\n                return False\n        return True\n\n    if len(arr) <= 1:\n        return True\n\n    return _is_non_decreasing(arr) or _is_non_increasing(arr)"}
{"task_id": "Mbpp/70", "solution": "def get_equal(tuples):\n    \"\"\"\n    Checks if all tuples in the given iterable have the same length.\n    Returns True if the iterable is empty or all tuple lengths are equal.\n    \"\"\"\n    if not tuples:\n        return True\n\n    first_tuple_length = len(tuples[0])\n\n    for tpl in tuples[1:]:\n        if len(tpl) != first_tuple_length:\n            return False\n\n    return True"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(container, sublist):\n    \"\"\"\n    Checks if a sublist exists contiguously within a container list.\n    Handles empty sublist and ensures type-consistent comparison.\n    \"\"\"\n    n = len(container)\n    m = len(sublist)\n\n    if m == 0:\n        return True\n\n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        if container[i : i + m] == list(sublist):\n            return True\n\n    return False"}
{"task_id": "Mbpp/72", "solution": "def dif_Square(n: int) -> bool:\n    \"\"\"Checks if n can be represented as the difference of two squares (a^2 - b^2).\n    This is true if n is odd or if n is a multiple of 4.\"\"\"\n    if n == 0:\n        return True\n    return (n % 2 != 0) or (n % 4 == 0)"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(lst):\n    \"\"\"Sorts a list of elements using the Comb Sort algorithm.\"\"\"\n    arr = list(lst)  # Create a copy to avoid mutating the original list\n    n = len(arr)\n    if n < 2:\n        return arr\n\n    gap = n\n    shrink = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        gap = int(gap / shrink)\n        if gap < 1:  # Ensure gap is at least 1\n            gap = 1\n\n        swapped = False\n        for i in range(0, n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    return arr"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number using dynamic programming based on the Bell triangle.\n    This approach computes B_n in O(n^2) time complexity and O(n) space complexity.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Initialize the first row of the Bell triangle, which contains B_0 = 1.\n    # This will serve as the 'previous_row' for the subsequent calculations.\n    previous_row = [1]\n\n    # Iterate from i = 1 up to n to compute Bell numbers B_1, B_2, ..., B_n.\n    for i in range(1, n + 1):\n        # Create a new row for the current Bell number computation.\n        current_row = [0] * (i + 1)\n        \n        # The first element of the current row (which will be B_i) is the last element\n        # of the previous row in the Bell triangle.\n        current_row[0] = previous_row[-1]\n        \n        # Fill the remaining elements of the current row using the Bell triangle recurrence relation.\n        # Each element T[r][c] = T[r][c-1] + T[r-1][c-1].\n        # In our implementation: current_row[j] = current_row[j-1] + previous_row[j-1].\n        for j in range(1, i + 1):\n            current_row[j] = current_row[j - 1] + previous_row[j - 1]\n        \n        # After computing the current row, it becomes the previous row for the next iteration.\n        previous_row = current_row\n    \n    # The nth Bell number is the first element of the last computed row.\n    return previous_row[0]"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(seq, patterns):\n    \"\"\"\n    Checks if two sequences follow the same pattern, ensuring a consistent and injective mapping.\n    It returns True if a one-to-one mapping exists from elements of `patterns` to `seq`.\n    \"\"\"\n    if len(seq) != len(patterns):\n        return False\n\n    pattern_to_target = {}\n    seen_targets = set()\n\n    for p_element, t_element in zip(patterns, seq):\n        if p_element in pattern_to_target:\n            if pattern_to_target[p_element] != t_element:\n                return False\n        else:\n            if t_element in seen_targets:\n                return False\n            pattern_to_target[p_element] = t_element\n            seen_targets.add(t_element)\n\n    return True"}
