{"task_id": "Mbpp/725", "solution": "import re\n\ndef extract_quotation(text: str) -> list:\n    \"\"\"\n    Extracts values enclosed in double quotation marks from the given string.\n    Escaped quotes (\\\\\") and escaped backslashes (\\\\\\\\) within quoted content are unescaped.\n    \"\"\"\n    \n    quote_char = '\"'\n    escape_char = '\\\\'\n\n    # Escape the special characters for use in regex\n    q_escaped = re.escape(quote_char)\n    e_escaped = re.escape(escape_char)\n\n    # Construct the regex pattern:\n    # (?<!{e_escaped})  - Negative lookbehind to ensure the opening quote is not escaped\n    # {q_escaped}       - Matches the opening quote character\n    # (                 - Start capturing group for the content inside quotes\n    #   (?:             - Non-capturing group for alternatives:\n    #     {e_escaped}.  -   Matches any escaped character (e.g., \\\\\", \\\\\\\\)\n    #     |             -   OR\n    #     [^{q_escaped}{e_escaped}] - Matches any character that is not a quote or an escape character\n    #   )*              - Matches zero or more of the alternatives\n    # )                 - End capturing group\n    # {q_escaped}       - Matches the closing quote character\n    pattern = re.compile(rf'(?<!{e_escaped}){q_escaped}((?:{e_escaped}.|[^{q_escaped}{e_escaped}])*){q_escaped}')\n\n    # Find all matches of the content within quotes\n    matches = pattern.findall(text)\n\n    results = []\n    for captured_content in matches:\n        # Unescape quotes and escape characters within the captured content\n        # Order matters: replace escaped quotes first, then escaped escape characters.\n        unescaped_content = captured_content.replace(escape_char + quote_char, quote_char)\n        unescaped_content = unescaped_content.replace(escape_char + escape_char, escape_char)\n        results.append(unescaped_content)\n\n    return results"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(lst):\n    \"\"\"\n    Removes consecutive duplicate elements from a list, preserving the order of unique elements.\n    \"\"\"\n    result = []\n    prev = object()  # Unique sentinel to ensure the first element is always added\n    for elem in lst:\n        if elem != prev:\n            result.append(elem)\n            prev = elem\n    return result"}
{"task_id": "Mbpp/731", "solution": "import math\n\ndef lateralsurface_cone(r, h):\n    \"\"\"\n    Calculates the lateral surface area of a cone given its radius and height.\n    The formula used is pi * r * sqrt(r^2 + h^2).\n    \"\"\"\n    slant_height = math.sqrt(r * r + h * h)\n    lateral_area = math.pi * r * slant_height\n    return lateral_area"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(arr, target):\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array using binary search.\n    Returns -1 if the target is not found.\n    \"\"\"\n    low, high = 0, len(arr) - 1\n    result = -1\n\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == target:\n            result = mid\n            high = mid - 1  # Move left to find the first occurrence\n        elif arr[mid] < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n            \n    return result"}
