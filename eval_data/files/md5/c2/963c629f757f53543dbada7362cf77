{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum, endnum):\n    results = []\n\n    def _get_digits(n: int) -> list[int]:\n        # Extracts decimal digits of a non-negative integer.\n        if n == 0:\n            return [0]\n        digits = []\n        temp_n = n\n        while temp_n > 0:\n            digits.append(temp_n % 10)\n            temp_n //= 10\n        return list(reversed(digits))\n\n    def _is_divisible_by_all_digits(n: int) -> bool:\n        # Checks if a number is divisible by every digit it contains, and contains no zero digits.\n        if n == 0:\n            return False\n\n        digits = _get_digits(n)\n        for digit in digits:\n            if digit == 0:\n                return False  # Disqualify if any digit is 0.\n            if n % digit != 0:\n                return False\n        return True\n\n    for num in range(startnum, endnum + 1):\n        if _is_divisible_by_all_digits(num):\n            results.append(num)\n\n    return results"}
{"task_id": "Mbpp/749", "solution": "class ParseError(Exception):\n    \"\"\"Exception raised for errors during numeric string parsing.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input data structure or types.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\ndef safe_int_parse(value: str) -> int:\n    \"\"\"Converts a string to an integer, stripping whitespace. Raises ValueError if conversion fails.\"\"\"\n    try:\n        return int(value.strip())\n    except ValueError as e:\n        raise ValueError(f\"Cannot parse '{value.strip()}' as an integer.\") from e\n\nclass InputValidator:\n    \"\"\"Validates the structure and types of input requests.\"\"\"\n    def validate_request(self, values: object) -> None:\n        \"\"\"Ensures the input is a list of strings, raising ValidationError otherwise.\"\"\"\n        if not isinstance(values, list):\n            raise ValidationError(\"Input must be a list.\")\n        for item in values:\n            if not isinstance(item, str):\n                raise ValidationError(\"All elements in the list must be strings.\")\n\nclass NumericStringParser:\n    \"\"\"Parses lists of numeric strings into integers, supporting strict and lenient modes.\"\"\"\n    def parse(self, values: list[str]) -> list[int]:\n        \"\"\"Strictly parses strings to integers, raising ParseError for any invalid entry.\"\"\"\n        parsed = []\n        errors = []\n        for v in values:\n            try:\n                parsed.append(safe_int_parse(v))\n            except ValueError as exc:\n                errors.append(f\"'{v}': {exc}\")\n        if errors:\n            raise ParseError(\"Failed to parse some numeric strings: \" + \", \".join(errors))\n        return parsed\n\n    def parse_lenient(self, values: list[str]) -> tuple[list[int], list[str]]:\n        \"\"\"Parses strings to integers, returning valid integers and a list of unparseable strings.\"\"\"\n        parsed, invalid = [], []\n        for v in values:\n            try:\n                parsed.append(safe_int_parse(v))\n            except ValueError:\n                invalid.append(v)\n        return parsed, invalid\n\nclass SortRequest:\n    \"\"\"Data transfer object for sorting requests.\"\"\"\n    def __init__(self, values: list[str], ignore_invalid: bool = False) -> None:\n        self.values = values\n        self.ignore_invalid = ignore_invalid\n\nclass SortResult:\n    \"\"\"Data transfer object for sorting results.\"\"\"\n    def __init__(self, sorted: list[int]) -> None:\n        self.sorted = sorted\n\nclass SortService:\n    \"\"\"Orchestrates validation, parsing, and numerical sorting of string values.\"\"\"\n    def __init__(self, validator: InputValidator, parser: NumericStringParser) -> None:\n        self.validator = validator\n        self.parser = parser\n\n    def sort(self, request: SortRequest) -> SortResult:\n        \"\"\"Validates, parses (strictly or leniently), and sorts the requested numeric strings.\"\"\"\n        self.validator.validate_request(request.values)\n\n        if request.ignore_invalid:\n            parsed_ints, _ = self.parser.parse_lenient(request.values)\n        else:\n            parsed_ints = self.parser.parse(request.values)\n        \n        parsed_ints.sort()\n        return SortResult(parsed_ints)\n\ndef sort_numeric_strings(values: list[str], ignore_invalid: bool=False) -> list[int]:\n    \"\"\"Sorts a list of numeric strings numerically, returning a list of integers.\"\"\"\n    validator = InputValidator()\n    parser = NumericStringParser()\n    service = SortService(validator, parser)\n    \n    request = SortRequest(values, ignore_invalid)\n    result = service.sort(request)\n    \n    return result.sorted"}
