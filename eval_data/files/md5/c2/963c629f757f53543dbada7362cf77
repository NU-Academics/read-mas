{"task_id": "Mbpp/604", "solution": "import re\n\ndef reverse_words(s: str) -> str:\n    \"\"\"\n    Reverses the order of words in a string, normalizing spaces.\n    Words are separated by one or more spaces; multiple spaces are collapsed to single spaces\n    and leading/trailing spaces are trimmed before reversing.\n    \"\"\"\n    normalized_text = re.sub(r' +', ' ', s).strip()\n    if not normalized_text:\n        return \"\"\n    words = normalized_text.split(' ')\n    reversed_words = list(reversed(words))\n    return ' '.join(reversed_words)"}
{"task_id": "Mbpp/603", "solution": "def get_ludic(n: int) -> list[int]:\n    \"\"\"\n    Computes all ludic numbers less than or equal to a given integer n.\n    This function inlines all necessary helper classes as per strict completion rules.\n    \"\"\"\n    import threading\n    from typing import Dict, List, Optional, Any\n\n    # --- Inlined Exceptions (src/ludic/exceptions.py) ---\n    class LudicError(Exception):\n        pass\n    class LudicValueError(LudicError, ValueError):\n        pass\n    class LudicComputeError(LudicError, RuntimeError):\n        pass\n\n    # --- Inlined Config (src/ludic/config.py) ---\n    DEFAULT_CACHE_SIZE: int = 128\n    MAX_SAFE_N: int = 1_000_000\n\n    # --- Inlined Repository (src/ludic/repositories.py) ---\n    class LudicRepository:\n        def __init__(self, max_size: int) -> None:\n            self._cache: Dict[int, List[int]] = {}\n            self._max_size = max_size\n            self._lock = threading.Lock()\n\n        def get(self, n: int) -> Optional[List[int]]:\n            with self._lock:\n                return self._cache.get(n)\n\n        def set(self, n: int, sequence: List[int]) -> None:\n            with self._lock:\n                if len(self._cache) >= self._max_size:\n                    # Simple FIFO-like eviction by removing the oldest item.\n                    if self._cache:\n                        del self._cache[next(iter(self._cache))]\n                self._cache[n] = sequence[:] # Store a copy of the sequence\n\n        def clear(self) -> None:\n            with self._lock:\n                self._cache.clear()\n\n    # --- Inlined Utils (src/ludic/utils.py - Validator) ---\n    class Validator:\n        @staticmethod\n        def validate_n(n: Any) -> int:\n            if not isinstance(n, int):\n                try:\n                    n_float = float(n)\n                    if n_float != int(n_float):\n                        raise ValueError\n                    n_int = int(n_float)\n                except (TypeError, ValueError):\n                    raise LudicValueError(f\"Input must be an integer, got {type(n).__name__}\")\n                else:\n                    n = n_int\n            return n\n\n    # --- Inlined Service (src/ludic/services.py) ---\n    class LudicService:\n        def __init__(self, repo: LudicRepository, max_n: int) -> None:\n            self._repo = repo\n            self._max_n = max_n\n\n        def generate(self, n: int) -> List[int]:\n            if n <= 0:\n                return []\n            if n > self._max_n:\n                raise LudicValueError(f\"n too large (>{self._max_n})\")\n            \n            cached = self._repo.get(n)\n            if cached is not None:\n                return cached.copy() # Return a copy to prevent external modification\n\n            try:\n                vals = self._sieve(n)\n                self._repo.set(n, vals)\n                return vals\n            except Exception as exc:\n                raise LudicComputeError(f\"Error during ludic number computation: {exc}\") from exc\n\n        def _sieve(self, n: int) -> List[int]:\n            \"\"\"\n            Implements the ludic sieve algorithm by iteratively removing elements.\n            The list is modified by creating new lists to extract ludic numbers.\n            \"\"\"\n            L = list(range(1, n + 1))\n            i = 1  # L[0] is 1. We start sieving using the value at index 1 (which is 2).\n\n            while i < len(L):\n                step = L[i]\n                if step <= 1:\n                    i += 1\n                    continue\n                \n                # Keep elements up to and including the current ludic number (L[i]).\n                new_list_head = L[: i + 1]\n                \n                # Filter out every 'step'-th element from the remaining part of the list.\n                remaining_elements_after_current = []\n                count_for_sieve = 0\n                for x in L[i + 1:]:\n                    count_for_sieve += 1\n                    if (count_for_sieve % step) != 0:\n                        remaining_elements_after_current.append(x)\n                \n                L = new_list_head + remaining_elements_after_current\n                i += 1\n            return L\n\n    # --- Inlined Controller (src/ludic/controllers.py) ---\n    class LudicController:\n        def __init__(self, service: LudicService) -> None:\n            self._service = service\n\n        def get_ludic(self, n: int) -> List[int]:\n            normalized_n = Validator.validate_n(n)\n            return self._service.generate(normalized_n)\n\n    # --- Main Logic for the module-level get_ludic function ---\n    # Instances are re-created on each call to satisfy strict inlining requirements.\n    _repo_instance = LudicRepository(max_size=DEFAULT_CACHE_SIZE)\n    _service_instance = LudicService(repo=_repo_instance, max_n=MAX_SAFE_N)\n    controller = LudicController(_service_instance)\n\n    return controller.get_ludic(n)"}
{"task_id": "Mbpp/605", "solution": "def prime_num(n):\n    \"\"\"Checks if an integer is a prime number using trial division up to its square root.\"\"\"\n    # Numbers less than 2 are not prime.\n    if n < 2:\n        return False\n    # 2 is the only even prime number.\n    if n == 2:\n        return True\n    # All other even numbers are not prime.\n    if n % 2 == 0:\n        return False\n    \n    # Check for divisibility by odd numbers from 3 up to the square root of n.\n    limit = int(n**0.5)\n    for i in range(3, limit + 1, 2):\n        if n % i == 0:\n            return False\n            \n    # If no divisors are found, the number is prime.\n    return True"}
{"task_id": "Mbpp/606", "solution": "def radian_degree(degrees: float) -> float:\n    \"\"\"\n    Converts an angle from degrees to radians using math.pi.\n    \"\"\"\n    import math\n    return degrees * math.pi / 180.0"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(items, k):\n    \"\"\"\n    Returns a new list with the k'th element (1-based index) removed.\n    Does not mutate the original list.\n    \"\"\"\n    new_list = list(items)  # Create a shallow copy\n    del new_list[k - 1]     # k is 1-based, so use k-1 for 0-based indexing\n    return new_list"}
{"task_id": "Mbpp/612", "solution": "def merge(list_of_lists):\n    \"\"\"\n    Transforms a list of two-element sublists into a list of two lists.\n    The first output list contains all first elements, and the second contains all second elements.\n    \"\"\"\n    first_elements = []\n    second_elements = []\n\n    for sublist in list_of_lists:\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n\n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"Calculates the nth Bell number using the Bell triangle dynamic programming method.\"\"\"\n    if n == 0:\n        return 1\n    # Build Bell triangle row by row, keeping only the current and previous row in memory.\n    # The first element of each new row generated is the Bell number for that 'i'.\n    row = [1]\n    for i in range(1, n + 1):\n        new_row = [row[-1]]  # First element of the new row is the last element of the previous row.\n        for j in range(1, i + 1):\n            # Each subsequent element is the sum of the element to its left in the current row\n            # and the element directly above it in the previous row.\n            val = new_row[j - 1] + (row[j - 1] if j - 1 < len(row) else 0)\n            new_row.append(val)\n        row = new_row\n    return row[0]"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix: list[list], n: int) -> int:\n    \"\"\"\n    Computes the maximum value in the specified column of a matrix.\n    Assumes valid, rectangular matrix input and an in-bounds index.\n    \"\"\"\n    column_values = [row[n] for row in matrix]\n    return max(column_values)"}
{"task_id": "Mbpp/607", "solution": "import re\nimport json\nimport datetime\nimport hashlib\nimport os\n\nclass SearchError(Exception):\n    \"\"\"Base exception for search-related errors.\"\"\"\n    pass\n\nclass InvalidPatternError(SearchError):\n    \"\"\"Raised when a regex pattern is invalid.\"\"\"\n    pass\n\nclass NotFoundError(SearchError):\n    \"\"\"Raised when no match is found for a pattern.\"\"\"\n    pass\n\nclass Config:\n    \"\"\"Central configuration values and defaults.\"\"\"\n    DEFAULT_LOG_PATH: str = \"search_logs.jsonl\"\n    DEFAULT_MAX_TEXT_PREVIEW: int = 256\n\nclass SearchResult:\n    \"\"\"Represents a search match with its substring and indices.\"\"\"\n    def __init__(self, match: str, start: int, end: int):\n        self.match = match\n        self.start = start\n        self.end = end\n\n    def to_dict(self) -> dict:\n        \"\"\"Converts the search result to a dictionary.\"\"\"\n        return {\"match\": self.match, \"start\": self.start, \"end\": self.end}\n\n    def __repr__(self) -> str:\n        \"\"\"Returns a string representation of the SearchResult.\"\"\"\n        return f\"SearchResult(match='{self.match}', start={self.start}, end={self.end})\"\n\ndef truncate_text(text: str, n: int) -> str:\n    \"\"\"Truncates text to n characters with ellipsis if longer.\"\"\"\n    if len(text) > n:\n        return text[:n-3] + \"...\" if n > 3 else text[:n]\n    return text\n\ndef hash_text_preview(text: str) -> str:\n    \"\"\"Generates a SHA256 hash of the text preview.\"\"\"\n    preview_text = truncate_text(text, Config.DEFAULT_MAX_TEXT_PREVIEW)\n    return f\"sha256:{hashlib.sha256(preview_text.encode('utf-8')).hexdigest()}\"\n\nclass RegexEngineAdapter:\n    \"\"\"Performs regex compilation and searching.\"\"\"\n    DEFAULT_FLAGS = 0\n\n    def compile_and_search(self, text: str, pattern: str) -> SearchResult:\n        \"\"\"Compiles a regex pattern and searches for the first match.\"\"\"\n        try:\n            pat = re.compile(pattern, self.DEFAULT_FLAGS)\n        except re.error as e:\n            raise InvalidPatternError(str(e))\n        m = pat.search(text)\n        if not m:\n            raise NotFoundError(\"No match found\")\n        return SearchResult(match=m.group(0), start=m.start(), end=m.end())\n\nclass SearchRepository:\n    \"\"\"Manages persistence of search logs to a JSON Lines file.\"\"\"\n    def __init__(self, path: str = Config.DEFAULT_LOG_PATH, encoding: str = \"utf-8\"):\n        self.path = path\n        self.encoding = encoding\n        os.makedirs(os.path.dirname(self.path), exist_ok=True)\n\n    def persist(self, entry: dict) -> None:\n        \"\"\"Appends a log entry as a JSON line to the log file.\"\"\"\n        entry['timestamp'] = datetime.datetime.utcnow().isoformat() + 'Z'\n        try:\n            with open(self.path, \"a\", encoding=self.encoding) as fh:\n                fh.write(json.dumps(entry, ensure_ascii=False) + \"\\n\")\n        except IOError:\n            pass # Best-effort logging, ignore IO errors.\n\nclass InputValidator:\n    \"\"\"Validates input arguments for text and pattern.\"\"\"\n    def validate_text(self, text: str) -> None:\n        \"\"\"Ensures the text input is not empty.\"\"\"\n        self.ensure_not_empty(text, \"text\")\n\n    def validate_pattern(self, pattern: str) -> None:\n        \"\"\"Ensures the pattern input is not empty.\"\"\"\n        self.ensure_not_empty(pattern, \"pattern\")\n\n    def ensure_not_empty(self, value: str, name: str) -> None:\n        \"\"\"Helper to raise ValueError if a string is empty.\"\"\"\n        if not value:\n            raise ValueError(f\"{name} cannot be empty.\")\n\nclass TextSearchService:\n    \"\"\"Orchestrates validation, regex search, and logging.\"\"\"\n    def __init__(self, engine: RegexEngineAdapter, repo: SearchRepository, validator: InputValidator):\n        self.engine = engine\n        self.repo = repo\n        self.validator = validator\n\n    def find_literals(self, text: str, pattern: str) -> SearchResult:\n        \"\"\"Performs the search operation, validates inputs, and logs the outcome.\"\"\"\n        self.validator.validate_text(text)\n        self.validator.validate_pattern(pattern)\n\n        result = None\n        error = None\n        try:\n            result = self.engine.compile_and_search(text, pattern)\n            return result\n        except (InvalidPatternError, NotFoundError, SearchError, ValueError) as e:\n            error = e\n            raise # Re-raise the original exception.\n        finally:\n            self._log_search(text, pattern, result, error)\n\n    def _log_search(self, text: str, pattern: str, result: SearchResult | None, error: Exception | None) -> None:\n        \"\"\"Creates a structured log entry and persists it.\"\"\"\n        log_entry = {\n            \"pattern\": pattern,\n            \"text_preview_hash\": hash_text_preview(text),\n            \"text_preview\": truncate_text(text, Config.DEFAULT_MAX_TEXT_PREVIEW),\n            \"match\": result.match if result else None,\n            \"start\": result.start if result else None,\n            \"end\": result.end if result else None,\n            \"error\": str(error) if error else None\n        }\n        self.repo.persist(log_entry)\n\ndef find_literals(text: str, pattern: str) -> tuple:\n    \"\"\"Searches a string for a regex pattern and returns the matching substring, a start index and an end index.\"\"\"\n    engine = RegexEngineAdapter()\n    repo = SearchRepository(Config.DEFAULT_LOG_PATH)\n    validator = InputValidator()\n    service = TextSearchService(engine, repo, validator)\n    result = service.find_literals(text, pattern)\n    return (result.match, result.start, result.end)"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(data_tuple: tuple[tuple[int | float, ...], ...]) -> list[float]:\n    \"\"\"\n    Calculates the average value for each inner tuple in a tuple of tuples.\n    Assumes inner tuples are non-empty and contain only numeric values.\n    \"\"\"\n    averages = []\n    for inner_tuple in data_tuple:\n        total_sum = sum(inner_tuple)\n        count = len(inner_tuple)\n        averages.append(total_sum / count)\n    return averages"}
{"task_id": "Mbpp/614", "solution": "def cummulative_sum(tuples: list[tuple]) -> int:\n    \"\"\"Calculates the cumulative sum of all integer values within a list of tuples.\"\"\"\n    total_sum = 0\n    for tpl in tuples:\n        for item in tpl:\n            total_sum += item\n    return total_sum"}
{"task_id": "Mbpp/616", "solution": "import datetime\nfrom typing import Tuple, Any, Optional\n\nclass TupleLengthMismatchError(Exception):\n    def __init__(self, message=\"Tuple lengths must be equal.\"):\n        super().__init__(message)\n\nclass DivisionByZeroError(Exception):\n    def __init__(self, message=\"Division by zero is not allowed.\"):\n        super().__init__(message)\n\nclass InvalidElementTypeError(Exception):\n    def __init__(self, message=\"All tuple elements must be integers.\"):\n        super().__init__(message)\n\nclass TupleModuloResult:\n    \"\"\"Immutable DTO for computation results, containing inputs, result, and timestamp.\"\"\"\n    def __init__(self, result: Tuple[int, ...], input_a: Tuple[int, ...], input_b: Tuple[int, ...], timestamp: str):\n        self.result = result\n        self.input_a = input_a\n        self.input_b = input_b\n        self.timestamp = timestamp\n\nclass TupleValidator:\n    \"\"\"Validates tuple inputs for length, element types, and non-zero divisors.\"\"\"\n    _allowed_types: Tuple[type, ...] = (int,)\n\n    def validate(self, a: Tuple[Any, ...], b: Tuple[Any, ...]) -> None:\n        self._validate_lengths(a, b)\n        self._validate_elements(a, b)\n\n    def _validate_lengths(self, a: Tuple[Any, ...], b: Tuple[Any, ...]) -> None:\n        if len(a) != len(b):\n            raise TupleLengthMismatchError()\n\n    def _validate_elements(self, a: Tuple[Any, ...], b: Tuple[Any, ...]) -> None:\n        for x, y in zip(a, b):\n            if not isinstance(x, self._allowed_types) or not isinstance(y, self._allowed_types):\n                raise InvalidElementTypeError()\n            if y == 0:\n                raise DivisionByZeroError()\n\nclass TupleService:\n    \"\"\"Orchestrates validation and modulo computation; creates TupleModuloResult.\"\"\"\n    def __init__(self, validator: Optional[TupleValidator] = None):\n        self.validator = validator if validator is not None else TupleValidator()\n\n    def modulo(self, a: Tuple[int, ...], b: Tuple[int, ...]) -> TupleModuloResult:\n        self.validator.validate(a, b)\n        computed_values = self._compute_values(a, b)\n        timestamp = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds') + 'Z'\n        return TupleModuloResult(computed_values, a, b, timestamp)\n\n    def _compute_values(self, a: Tuple[int, ...], b: Tuple[int, ...]) -> Tuple[int, ...]:\n        \"\"\"Performs the element-wise modulo computation.\"\"\"\n        return tuple(x % y for x, y in zip(a, b))\n\nclass TupleController:\n    \"\"\"Provides a thin adaptor to the service for library consumers.\"\"\"\n    def __init__(self, service: TupleService):\n        self.service = service\n\n    def compute(self, a: Tuple[int, ...], b: Tuple[int, ...], persist: bool = False) -> TupleModuloResult:\n        # The persist flag is ignored as persistence components are not defined inline.\n        return self.service.modulo(a, b)\n\ndef tuple_modulo(a: Tuple[int, ...], b: Tuple[int, ...]) -> Tuple[int, ...]:\n    \"\"\"\n    Performs element-wise modulo on two tuples of the same length.\n    Delegates to internal service and controller for validation and computation.\n    \"\"\"\n    svc = TupleService()\n    ctrl = TupleController(svc)\n    result = ctrl.compute(a, b, persist=False)\n    return result.result"}
{"task_id": "Mbpp/619", "solution": "def move_num(s: str) -> str:\n    \"\"\"\n    Moves all digit characters to the end of the string, preserving relative order.\n    Uses a single pass to collect non-digit and digit characters separately.\n    \"\"\"\n    non_digits = []\n    digits = []\n    for char in s:\n        if char.isdigit():\n            digits.append(char)\n        else:\n            non_digits.append(char)\n    return \"\".join(non_digits) + \"\".join(digits)"}
{"task_id": "Mbpp/618", "solution": "import math\n\ndef div_list(a, b, zero_policy: str = \"raise\"):\n    \"\"\"\n    Divides two lists element-wise, handling division by zero based on the specified policy.\n    \"\"\"\n    results = []\n    # Iterate through the lists using zip, which truncates to the shortest list\n    # and implicitly handles different lengths without raising an explicit error.\n    for x_val, y_val in zip(a, b):\n        # Convert values to float. This relies on Python's built-in type conversion\n        # and will raise ValueError or TypeError if conversion is not possible,\n        # which adheres to not adding explicit 'isinstance' checks or custom error raises.\n        x = float(x_val)\n        y = float(y_val)\n\n        if y == 0.0:\n            if zero_policy == \"raise\":\n                # For 'raise' policy, allow Python's built-in ZeroDivisionError to occur.\n                # This aligns with the design's intent to raise an error for this policy,\n                # while adhering to the constraint of not adding custom 'raise' statements.\n                results.append(x / y)\n            elif zero_policy == \"inf\":\n                # Handle division by zero returning positive/negative infinity or NaN.\n                if x > 0:\n                    results.append(math.inf)\n                elif x < 0:\n                    results.append(-math.inf)\n                else:  # x == 0 and y == 0\n                    results.append(math.nan)\n            elif zero_policy == \"nan\":\n                # Handle division by zero returning NaN.\n                results.append(math.nan)\n            else:\n                # For an unrecognized zero_policy, default to NaN to ensure a float result.\n                results.append(math.nan)\n        else:\n            # Perform standard division for non-zero denominators.\n            results.append(x / y)\n\n    return results"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(nums: List[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of numbers where every pair is divisible.\n    Uses dynamic programming after sorting numbers by their absolute values.\n    \"\"\"\n    from typing import List, Tuple, Optional\n\n    class MathUtils:\n        \"\"\"Utility class for performing divisibility checks.\"\"\"\n        def is_divisible(self, a: int, b: int) -> bool:\n            \"\"\"Returns true if 'a' divides 'b' (b % a == 0), handling zero safely.\"\"\"\n            if a == 0:\n                return False\n            return b % a == 0\n\n        def compare_divisible(self, a: int, b: int) -> bool:\n            \"\"\"Returns true if 'a' divides 'b' or 'b' divides 'a' using absolute values.\"\"\"\n            if a == 0 and b == 0:\n                return True\n            return self.is_divisible(abs(a), abs(b)) or self.is_divisible(abs(b), abs(a))\n\n    class Validator:\n        \"\"\"A simplified validator, as per problem constraints, assuming valid input.\"\"\"\n        def validate_numbers(self, numbers: List[int]) -> List[int]:\n            \"\"\"Returns the input list, assuming it contains valid integers.\"\"\"\n            return numbers\n\n    class DivisibleSubsetService:\n        \"\"\"Service containing the core dynamic programming algorithm for largest divisible subset.\"\"\"\n        def __init__(self, validator_instance: Validator, math_utils_instance: MathUtils) -> None:\n            self._validator = validator_instance\n            self._math = math_utils_instance\n\n        def largest_subset_size(self, numbers: List[int]) -> int:\n            \"\"\"Computes the size of the largest divisible subset from the given list of numbers.\"\"\"\n            nums = self._validator.validate_numbers(numbers)\n            if not nums:\n                return 0\n            \n            nums_sorted = sorted(nums, key=abs)\n            \n            dp, _ = self._compute_dp(nums_sorted)\n            return max(dp) if dp else 0\n\n        def _compute_dp(self, nums: List[int]) -> Tuple[List[int], List[Optional[int]]]:\n            \"\"\"Internal method to compute the DP array (lengths) and predecessor indices.\"\"\"\n            n = len(nums)\n            if n == 0:\n                return [], []\n\n            dp = [1] * n\n            prev = [None] * n # prev array is not strictly needed for size, but included per design.\n\n            for i in range(n):\n                for j in range(i):\n                    # Check if nums[j] can precede nums[i] in a divisible subset.\n                    if self._math.compare_divisible(nums[j], nums[i]) and dp[j] + 1 > dp[i]:\n                        dp[i] = dp[j] + 1\n                        prev[i] = j\n            return dp, prev\n\n    # Instantiate utility and service objects locally within the function.\n    math_utils = MathUtils()\n    validator = Validator()\n    service = DivisibleSubsetService(validator_instance=validator, math_utils_instance=math_utils)\n    \n    # Delegate the computation to the service and return the result.\n    return service.largest_subset_size(nums)"}
