{"task_id": "Mbpp/252", "solution": "import math\nfrom typing import Any, Tuple\n\nclass ConversionError(Exception):\n    \"\"\"Custom exception for conversion errors.\"\"\"\n    pass\n\nclass AngleUtils:\n    \"\"\"Utility class for angle operations like normalization.\"\"\"\n    PI = math.pi\n\n    @staticmethod\n    def normalize_angle(theta: float) -> float:\n        \"\"\"Normalizes an angle to the range (-pi, pi].\"\"\"\n        two_pi = 2 * AngleUtils.PI\n        theta = math.fmod(theta, two_pi)\n\n        if theta > AngleUtils.PI:\n            theta -= two_pi\n        elif theta <= -AngleUtils.PI:\n            theta += two_pi\n        return theta\n\n    @staticmethod\n    def is_finite(theta: float) -> bool:\n        \"\"\"Checks if a float is finite.\"\"\"\n        return math.isfinite(theta)\n\nclass ComplexNumber:\n    \"\"\"Represents a complex number with real and imaginary parts.\"\"\"\n    def __init__(self, real: float, imag: float) -> None:\n        self._real = float(real)\n        self._imag = float(imag)\n\n    @staticmethod\n    def from_value(value: Any) -> \"ComplexNumber\":\n        \"\"\"Factory method to create ComplexNumber from various numeric types.\"\"\"\n        try:\n            if isinstance(value, complex):\n                return ComplexNumber(value.real, value.imag)\n            if isinstance(value, (int, float)):\n                return ComplexNumber(float(value), 0.0)\n            # Duck-type objects with real/imag attributes\n            r = getattr(value, \"real\", None)\n            i = getattr(value, \"imag\", None)\n            if r is not None and i is not None:\n                return ComplexNumber(float(r), float(i))\n        except Exception as exc:\n            raise ConversionError(f\"Cannot interpret value as complex: {exc}\")\n        raise ConversionError(\"Unsupported input type for ComplexNumber\")\n\n    def to_complex(self) -> complex:\n        \"\"\"Converts to a built-in complex number.\"\"\"\n        return complex(self._real, self._imag)\n\nclass PolarCoordinate:\n    \"\"\"Represents a polar coordinate with magnitude (r) and angle (theta).\"\"\"\n    def __init__(self, r: float, theta: float) -> None:\n        self._r = r\n        self._theta = theta\n\n    def to_tuple(self) -> Tuple[float, float]:\n        \"\"\"Returns the polar coordinate as a tuple (r, theta).\"\"\"\n        return (self._r, self._theta)\n\ntry:\n    import numpy as np\n    NUMPY_AVAILABLE = True\nexcept ImportError:\n    np = None\n    NUMPY_AVAILABLE = False\n\nclass NumpyAdapter:\n    \"\"\"Adapter for optional NumPy type support.\"\"\"\n    @staticmethod\n    def supports(value: Any) -> bool:\n        \"\"\"Checks if the given value is a supported NumPy numeric type.\"\"\"\n        if not NUMPY_AVAILABLE:\n            return False\n        # np.number covers np.int_, np.float_, np.complex_ scalars\n        return isinstance(value, np.number)\n\n    @staticmethod\n    def to_complex(value: Any) -> complex:\n        \"\"\"Converts a supported NumPy value to a built-in complex number.\"\"\"\n        if not NumpyAdapter.supports(value):\n            raise ConversionError(\"Value is not a supported numpy type or numpy is not available.\")\n        try:\n            return complex(value)\n        except Exception as exc:\n            raise ConversionError(f\"Failed to convert numpy value to complex: {exc}\")\n\nclass Converter:\n    \"\"\"Core service for converting numeric values to polar coordinates.\"\"\"\n    def convert(self, value: Any) -> Tuple[float, float]:\n        \"\"\"Converts a given numeric value to polar coordinates.\"\"\"\n        if NumpyAdapter.supports(value):\n            z = NumpyAdapter.to_complex(value)\n        else:\n            cn = ComplexNumber.from_value(value)\n            z = cn.to_complex()\n        \n        r = self._compute_magnitude(z)\n        theta_raw = self._compute_angle(z)\n        theta = AngleUtils.normalize_angle(theta_raw)\n        \n        if not AngleUtils.is_finite(r) or not AngleUtils.is_finite(theta):\n            raise ConversionError(\"Non-finite result encountered during conversion.\")\n        \n        return PolarCoordinate(r, theta).to_tuple()\n\n    def _compute_magnitude(self, z: complex) -> float:\n        \"\"\"Computes the magnitude (r) from a complex number.\"\"\"\n        return math.hypot(z.real, z.imag)\n\n    def _compute_angle(self, z: complex) -> float:\n        \"\"\"Computes the angle (theta) from a complex number.\"\"\"\n        return math.atan2(z.imag, z.real)\n\ndef convert(value: Any) -> Tuple[float, float]:\n    \"\"\"Converts a numeric value (int, float, complex) to polar coordinates (magnitude, angle).\"\"\"\n    return Converter().convert(value)"}
