{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(items: list[any]) -> list[list[any]]:\n    \"\"\"\n    Packs consecutive duplicate elements of a list into sublists.\n    \"\"\"\n    if not items:\n        return []\n\n    packed_list = []\n    current_sublist = [items[0]]\n\n    for i in range(1, len(items)):\n        if items[i] == current_sublist[-1]:\n            current_sublist.append(items[i])\n        else:\n            packed_list.append(current_sublist)\n            current_sublist = [items[i]]\n\n    packed_list.append(current_sublist)\n    return packed_list"}
{"task_id": "Mbpp/780", "solution": "def find_combinations(tuple_list: list[tuple[int, int]]) -> list[tuple[int, int]]:\n    \"\"\"\n    Calculates all unique pairwise sums of tuples in the given list.\n    Assumes valid input: a list of 2-element integer tuples.\n    \"\"\"\n    n = len(tuple_list)\n    results: list[tuple[int, int]] = []\n\n    # Iterate through all unique pairs (i, j) such that i < j\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            # Get the two tuples to be summed\n            tuple1 = tuple_list[i]\n            tuple2 = tuple_list[j]\n\n            # Perform element-wise summation\n            sum_tuple = (tuple1[0] + tuple2[0], tuple1[1] + tuple2[1])\n\n            # Add the resulting sum tuple to the results list\n            results.append(sum_tuple)\n\n    return results"}
{"task_id": "Mbpp/781", "solution": "from typing import Optional\n\nclass InvalidNumberError(ValueError):\n    \"\"\"Raised when an invalid number is provided.\"\"\"\n    pass\n\nclass DivisorRepository:\n    \"\"\"Manages algorithms for counting divisors.\"\"\"\n    def count_divisors(self, n: int) -> int:\n        \"\"\"\n        Counts the number of positive divisors for a given integer n.\n        Raises InvalidNumberError if n is not positive.\n        \"\"\"\n        if n <= 0:\n            raise InvalidNumberError(\"n must be a positive integer.\")\n\n        count = 1\n        temp_n = n\n\n        # Count factors of 2\n        exponent = 0\n        while temp_n % 2 == 0:\n            temp_n //= 2\n            exponent += 1\n        count *= (exponent + 1)\n\n        # Count factors for odd numbers\n        p = 3\n        while p * p <= temp_n:\n            exponent = 0\n            while temp_n % p == 0:\n                temp_n //= p\n                exponent += 1\n            if exponent > 0:\n                count *= (exponent + 1)\n            p += 2\n\n        # If temp_n is still greater than 1, it must be a prime factor itself\n        if temp_n > 1:\n            count *= 2  # (exponent is 1, so 1+1)\n\n        return count\n\nclass DivisorCalculator:\n    \"\"\"Calculates divisor-related properties using a DivisorRepository.\"\"\"\n    def __init__(self, repository: Optional[DivisorRepository] = None) -> None:\n        \"\"\"Initializes the calculator with an optional DivisorRepository.\"\"\"\n        self.repository = repository or DivisorRepository()\n\n    def get_divisor_count(self, n: int) -> int:\n        \"\"\"Retrieves the total count of divisors for n.\"\"\"\n        return self.repository.count_divisors(n)\n\n    def is_divisor_count_even(self, n: int) -> bool:\n        \"\"\"Checks if the count of divisors for n is even.\"\"\"\n        return (self.get_divisor_count(n) % 2) == 0\n\ndef count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks if the count of positive divisors for a given integer n is even.\n    Raises InvalidNumberError if n is not a positive integer.\n    \"\"\"\n    calc = DivisorCalculator()\n    return calc.is_divisor_count_even(n)"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr):\n    \"\"\"\n    Calculates the sum of all odd-length subarrays using a contribution-based approach.\n    Each element's contribution is determined by how many odd-length subarrays it is part of.\n    \"\"\"\n    n = len(arr)\n    total_sum = 0\n    for i, val in enumerate(arr):\n        # Calculate the number of subarrays ending at 'i' and starting at 'i'\n        # 'left' is the number of choices for the start index (0 to i)\n        # 'right' is the number of choices for the end index (i to n-1)\n        # Total subarrays containing arr[i] is (i + 1) * (n - i)\n        # Half of these will be odd length, half even length.\n        # If total subarrays is odd, then (odd + 1) // 2 odd length subarrays.\n        # If total subarrays is even, then total / 2 odd length subarrays.\n        # This is equivalent to (total_subarrays + 1) // 2 for integer division.\n        left_count = i + 1\n        right_count = n - i\n        odd_count = (left_count * right_count + 1) // 2\n        total_sum += odd_count * val\n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the product of the first even and first odd number in a given list.\n    It assumes both an odd and an even number will be present in the list.\n    \"\"\"\n    first_odd = None\n    first_even = None\n\n    for num in numbers:\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        if first_even is None and num % 2 == 0:\n            first_even = num\n\n        if first_odd is not None and first_even is not None:\n            break\n\n    return first_odd * first_even"}
