{"task_id": "Mbpp/569", "solution": "def sort_sublists(data: list[list[str]], order: str = \"asc\", case_sensitive: bool = True) -> list[list[str]]:\n    \"\"\"Sorts each sublist of strings in a given list of lists.\"\"\"\n    sorted_data = []\n    for sublist in data:\n        key_func = None if case_sensitive else (lambda s: s.lower())\n        reverse_sort = (order == \"desc\")\n        sorted_sublist = sorted(sublist, key=key_func, reverse=reverse_sort)\n        sorted_data.append(sorted_sublist)\n    return sorted_data"}
{"task_id": "Mbpp/572", "solution": "import collections\nfrom typing import Iterable\n\ndef two_unique_nums(*lists: Iterable[Iterable[int]]) -> list[int]:\n    \"\"\"\n    Removes duplicate numbers from a given number of lists,\n    returning numbers that appear exactly once, in first-occurrence order.\n    \"\"\"\n    flattened_elements = []\n    for input_list in lists:\n        for item in input_list:\n            flattened_elements.append(item)\n\n    counts = collections.Counter(flattened_elements)\n\n    unique_numbers_in_order = []\n    for item in flattened_elements:\n        if counts[item] == 1:\n            unique_numbers_in_order.append(item)\n\n    return unique_numbers_in_order"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n):\n    \"\"\"\n    Finds the last digit of n! using mathematical properties.\n    For n >= 5, the last digit is 0.\n    \"\"\"\n    if n == 0 or n == 1:\n        return 1\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 6\n    elif n == 4:\n        return 4\n    else:  # n >= 5\n        return 0"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list, sub_list):\n    \"\"\"\n    Checks if a list is a contiguous sublist of another.\n    An empty sub_list is considered a sublist of any main_list.\n    \"\"\"\n    n = len(main_list)\n    m = len(sub_list)\n\n    if m == 0:\n        return True\n    \n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        match = True\n        for j in range(m):\n            if main_list[i + j] != sub_list[j]:\n                match = False\n                break\n        if match:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/578", "solution": "from typing import List, Sequence, TypeVar\n\nT = TypeVar('T')\n\ndef interleave_lists(a: Sequence[T], b: Sequence[T], c: Sequence[T]) -> List[T]:\n    \"\"\"\n    Interleaves three sequences of the same length into a single flat list.\n    Assumes all input sequences are of equal length.\n    \"\"\"\n    n = len(a)\n    result: List[T] = [None] * (3 * n)\n    idx = 0\n    for i in range(n):\n        result[idx] = a[i]\n        idx += 1\n        result[idx] = b[i]\n        idx += 1\n        result[idx] = c[i]\n        idx += 1\n    return result"}
{"task_id": "Mbpp/573", "solution": "def unique_product(numbers):\n    \"\"\"\n    Calculates the product of unique numbers in a list, applying normalization and specific return type rules.\n    \"\"\"\n\n    def _normalize_number(value):\n        \"\"\"Coerces integer-valued floats to integers for consistent deduplication.\"\"\"\n        if isinstance(value, float) and value == int(value):\n            return int(value)\n        return value\n\n    if not numbers:\n        return 1\n\n    unique_normalized_numbers = set()\n    contains_float_in_original_input = False\n\n    for num in numbers:\n        if isinstance(num, float):\n            contains_float_in_original_input = True\n        \n        normalized_num = _normalize_number(num)\n        unique_normalized_numbers.add(normalized_num)\n\n    product = 1\n    for val in unique_normalized_numbers:\n        product *= val\n    \n    if contains_float_in_original_input:\n        return float(product)\n    else:\n        return int(product)"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Finds elements present in exactly one of the two input tuples,\n    preserving their original appearance order where possible.\n    \"\"\"\n    # Step 1: Compute the symmetric difference to find elements that are in one set but not both.\n    # This is equivalent to SetUtils.compute_symmetric_difference.\n    set_a = set(a)\n    set_b = set(b)\n    dissimilar_elements_set = set_a ^ set_b\n\n    # Step 2: Order the dissimilar elements based on their first appearance in 'a' then 'b'.\n    # This is equivalent to SetUtils.stable_order logic.\n    ordered_dissimilar = []\n    \n    # Use a list to store elements in order, and also implicitly check for duplicates\n    # based on the `x not in ordered_dissimilar` check as per the design's snippet.\n    \n    # First, iterate through tuple 'a' to capture elements unique to 'a' in their original order.\n    for x in a:\n        if x in dissimilar_elements_set and x not in ordered_dissimilar:\n            ordered_dissimilar.append(x)\n\n    # Then, iterate through tuple 'b' to capture elements unique to 'b' in their original order,\n    # ensuring elements already added from 'a' are not re-added.\n    for x in b:\n        if x in dissimilar_elements_set and x not in ordered_dissimilar:\n            ordered_dissimilar.append(x)\n    \n    # Fallback as per the design's `SetUtils.stable_order` snippet:\n    # \"if not seen: seen = sorted(elements)\"\n    # This branch handles cases where `dissimilar_elements_set` might be non-empty\n    # but no elements were added to `ordered_dissimilar` (though this is theoretically\n    # unreachable if `dissimilar_elements_set` is derived from `a` and `b` and is non-empty).\n    if not ordered_dissimilar and dissimilar_elements_set:\n        # Convert set to list before sorting to ensure consistent behavior.\n        ordered_dissimilar = sorted(list(dissimilar_elements_set))\n\n    return tuple(ordered_dissimilar)"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple):\n    \"\"\"\n    Recursively removes odd integers from a nested tuple, preserving even integers and tuple structure.\n    Empty nested tuples resulting from filtering are removed.\n    \"\"\"\n    result_elements = []\n\n    for element in input_tuple:\n        if isinstance(element, int):\n            if element % 2 == 0:\n                result_elements.append(element)\n        elif isinstance(element, tuple):\n            nested_result = extract_even(element)\n            if nested_result:\n                result_elements.append(nested_result)\n        # Other types are implicitly ignored as per the design's lenient mode for non-int/non-tuple elements.\n\n    return tuple(result_elements)"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"\n    Computes the nth Catalan number using dynamic programming.\n    This method has a time complexity of O(n^2) and space complexity of O(n).\n    \"\"\"\n    if n == 0:\n        return 1\n\n    catalan = [0] * (n + 1)\n    catalan[0] = 1\n\n    for i in range(1, n + 1):\n        current_catalan_val = 0\n        for j in range(i):\n            current_catalan_val += catalan[j] * catalan[i - 1 - j]\n        catalan[i] = current_catalan_val\n            \n    return catalan[n]"}
{"task_id": "Mbpp/581", "solution": "import math\nimport os\nfrom abc import ABC, abstractmethod\nfrom typing import Any, Dict, Optional\n\nclass ValidationError(ValueError):\n    \"\"\"Custom exception for input validation errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\ndef validate_positive_number(value: Any, name: str) -> float:\n    \"\"\"Validates if a value is a positive number and converts it to float.\"\"\"\n    if not isinstance(value, (int, float)):\n        raise ValidationError(f\"{name} must be a number.\")\n    if value <= 0:\n        raise ValidationError(f\"{name} must be positive.\")\n    return float(value)\n\ndef compute_slant_height(base_edge: float, height: float) -> float:\n    \"\"\"Calculates the slant height of a square pyramid.\"\"\"\n    return math.sqrt((base_edge / 2.0)**2 + height**2)\n\nclass PyramidParams:\n    \"\"\"Data model for validated pyramid parameters.\"\"\"\n    def __init__(self, base_edge: float, height: float):\n        self.base_edge = base_edge\n        self.height = height\n\n    @staticmethod\n    def from_values(base_edge: Any, height: Any) -> \"PyramidParams\":\n        \"\"\"Creates validated PyramidParams from raw input values.\"\"\"\n        a = validate_positive_number(base_edge, \"base_edge\")\n        h = validate_positive_number(height, \"height\")\n        return PyramidParams(a, h)\n\nclass CalculationStrategy(ABC):\n    \"\"\"Abstract base class for surface area calculation strategies.\"\"\"\n    @abstractmethod\n    def compute(self, base_edge: float, height: float) -> float:\n        pass\n\nclass GeometricStrategy(CalculationStrategy):\n    \"\"\"Geometric strategy using actual slant height.\"\"\"\n    def compute(self, base_edge: float, height: float) -> float:\n        l = compute_slant_height(base_edge, height)\n        base_area = base_edge * base_edge\n        lateral_area = 2.0 * base_edge * l\n        return base_area + lateral_area\n\nclass LegacyStrategy(CalculationStrategy):\n    \"\"\"Legacy strategy for compatibility, treating slant height as vertical height.\"\"\"\n    def compute(self, base_edge: float, height: float) -> float:\n        base_area = base_edge * base_edge\n        # In legacy mode, lateral area is calculated as 2 * a * h\n        lateral_area = 2.0 * base_edge * height\n        return base_area + lateral_area\n\nclass Config:\n    \"\"\"Configuration for the pyramid calculator.\"\"\"\n    ENV_DEFAULT_STRATEGY = \"PYRAMID_DEFAULT_STRATEGY\"\n\n    def __init__(self, default_strategy: str):\n        self.default_strategy = default_strategy\n\n    @staticmethod\n    def from_env() -> \"Config\":\n        \"\"\"Loads configuration from environment variables.\"\"\"\n        strategy_name = os.getenv(Config.ENV_DEFAULT_STRATEGY, \"legacy\")\n        return Config(strategy_name)\n\nclass PyramidCalculator:\n    \"\"\"Service to calculate pyramid surface area using different strategies.\"\"\"\n    def __init__(self, strategies: Optional[Dict[str, CalculationStrategy]] = None, config: Optional[Config] = None):\n        self._strategies = strategies if strategies is not None else self._build_default_strategies()\n        self._config = config if config is not None else Config.from_env()\n\n    def _build_default_strategies(self) -> Dict[str, CalculationStrategy]:\n        return {\n            \"legacy\": LegacyStrategy(),\n            \"geometric\": GeometricStrategy(),\n        }\n\n    def calculate(self, base_edge: Any, height: Any, strategy: Optional[str] = None) -> float:\n        \"\"\"Calculates the surface area of a square pyramid using the specified or default strategy.\"\"\"\n        params = PyramidParams.from_values(base_edge, height)\n        \n        chosen_strategy_name = strategy if strategy is not None else self._config.default_strategy\n        \n        calc_strategy = self._select_strategy(chosen_strategy_name)\n        return calc_strategy.compute(params.base_edge, params.height)\n\n    def _select_strategy(self, strategy_name: str) -> CalculationStrategy:\n        if strategy_name not in self._strategies:\n            raise ValueError(f\"Unknown calculation strategy: {strategy_name}. Available strategies: {list(self._strategies.keys())}\")\n        return self._strategies[strategy_name]\n\n_default_config = Config.from_env()\n_default_calculator = PyramidCalculator(config=_default_config)\n\ndef surface_Area(base_edge, height):\n    \"\"\"Calculates the surface area of a square pyramid using the default strategy.\"\"\"\n    return _default_calculator.calculate(base_edge, height, strategy=None)"}
