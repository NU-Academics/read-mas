{"task_id": "Mbpp/751", "solution": "def check_min_heap(array: list) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    A min-heap property is that every parent node's value is less than or equal to its children's values.\n    \"\"\"\n    n = len(array)\n\n    if n <= 1:\n        return True\n\n    # Iterate through potential parent nodes, from index 0 up to (n // 2) - 1.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check if the parent is greater than its left child (if it exists).\n        if left_child_idx < n and array[i] > array[left_child_idx]:\n            return False\n\n        # Check if the parent is greater than its right child (if it exists).\n        if right_child_idx < n and array[i] > array[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/754", "solution": "from typing import Sequence, Any, List\n\ndef extract_index_list(l1: Sequence[Any], l2: Sequence[Any], l3: Sequence[Any]) -> List[Any]:\n    \"\"\"\n    Finds elements that appear at the same index in all three input sequences.\n    Returns a list of such common elements, preserving their order and duplicates.\n    \"\"\"\n    min_len = min(len(l1), len(l2), len(l3))\n    common_elements = []\n    for i in range(min_len):\n        if l1[i] == l2[i] == l3[i]:\n            common_elements.append(l1[i])\n    return common_elements"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Computes the nth Jacobsthal number using an iterative approach for small n\n    and matrix exponentiation for larger n based on the recurrence J(n) = J(n-1) + 2*J(n-2).\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    ITERATIVE_THRESHOLD = 50\n\n    if n < ITERATIVE_THRESHOLD:\n        j_prev2, j_prev1 = 0, 1\n        for _ in range(2, n + 1):\n            j_current = j_prev1 + 2 * j_prev2\n            j_prev2 = j_prev1\n            j_prev1 = j_current\n        return j_prev1\n    else:\n        def _matrix_multiply(A, B):\n            \"\"\"Multiplies two 2x2 matrices represented as (a, b, c, d).\"\"\"\n            a, b, c, d = A\n            e, f, g, h = B\n            return (a * e + b * g, a * f + b * h,\n                    c * e + d * g, c * f + d * h)\n\n        def _matrix_power(matrix_base, k_power):\n            \"\"\"Computes matrix_base^k_power using exponentiation by squaring.\"\"\"\n            res = (1, 0, 0, 1)  # Identity matrix\n            base = matrix_base\n            while k_power > 0:\n                if k_power % 2 == 1:\n                    res = _matrix_multiply(res, base)\n                base = _matrix_multiply(base, base)\n                k_power //= 2\n            return res\n\n        # The base matrix for the recurrence J(k+1) = J(k) + 2*J(k-1)\n        # represented as [J(k+1), J(k)] = [[1, 2], [1, 0]] * [J(k), J(k-1)]\n        base_matrix = (1, 2, 1, 0)\n\n        # To find J(n), we need to compute M^(n-1) and multiply by initial vector [J(1), J(0)].\n        # If M^(n-1) = [[a, b], [c, d]], then J(n) = a*J(1) + b*J(0) = a*1 + b*0 = a.\n        powered_matrix = _matrix_power(base_matrix, n - 1)\n        return powered_matrix[0]"}
{"task_id": "Mbpp/753", "solution": "def min_k(records, k):\n    \"\"\"\n    Finds the minimum k records from a list of (name, value) tuples,\n    sorted by value in ascending order, preserving original order for ties.\n    \"\"\"\n    import heapq\n\n    # Normalize records to (name: str, value: float), assuming valid input types.\n    normalized_records = []\n    for r in records:\n        name, val = r\n        normalized_records.append((name, float(val)))\n\n    if k <= 0:\n        return []\n\n    # Annotate records with their original index to ensure stable sorting for ties.\n    # Format: (value, original_index, name)\n    annotated_records = [(val, idx, name) for idx, (name, val) in enumerate(normalized_records)]\n\n    # Use heapq.nsmallest to efficiently find the k smallest items.\n    # The key sorts first by value, then by original index for stability.\n    smallest_annotated = heapq.nsmallest(k, annotated_records, key=lambda x: (x[0], x[1]))\n\n    # Convert the result back to the desired (name, value) tuple format.\n    result = [(name, val) for (val, idx, name) in smallest_annotated]\n\n    return result"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(nums: list) -> float:\n    \"\"\"Finds the second smallest distinct number in a list of numbers.\"\"\"\n    min1 = float('inf')\n    min2 = float('inf')\n\n    for x in nums:\n        if x < min1:\n            min2 = min1\n            min1 = x\n        elif min1 < x < min2:\n            min2 = x\n            \n    return min2"}
{"task_id": "Mbpp/759", "solution": "import re\n\ndef is_decimal(s: str) -> bool:\n    \"\"\"\n    Checks if the given string is a decimal number with exactly two digits of precision.\n    The string may have an optional leading sign (+/-).\n    \"\"\"\n    pattern = r'^[+-]?\\d+\\.\\d{2}$'\n    return re.match(pattern, s) is not None"}
{"task_id": "Mbpp/757", "solution": "from collections import Counter\n\ndef count_reverse_pairs(strings: list[str]) -> int:\n    \"\"\"\n    Counts pairs of reverse strings in the given list.\n    A pair (s1, s2) is counted if s2 is the reverse of s1.\n    Palindromes are counted as floor(occurrences / 2).\n    \"\"\"\n    # Helper to normalize strings; based on design, case-sensitive is default\n    # and no actual transformation is applied for this specific function context.\n    def _normalize_string(s: str) -> str:\n        return s\n\n    normalized_strings = [_normalize_string(s) for s in strings]\n    freq = Counter(normalized_strings)\n    pairs = 0\n    processed = set()\n\n    for s in freq:\n        if s in processed:\n            continue\n\n        r = s[::-1]\n\n        if s == r:  # Palindrome\n            pairs += freq[s] // 2\n        else:  # Non-palindrome\n            pairs += min(freq[s], freq.get(r, 0))\n\n        processed.add(s)\n        processed.add(r)\n        \n    return pairs"}
{"task_id": "Mbpp/760", "solution": "def unique_Element(lst):\n    \"\"\"\n    Checks if a list of numbers contains only one distinct element.\n    Returns True if all elements are the same, False otherwise.\n    \"\"\"\n    it = iter(lst)\n    try:\n        first = next(it)\n    except StopIteration:\n        return False # An empty list has no distinct elements\n    for x in it:\n        if x != first:\n            return False\n    return True"}
{"task_id": "Mbpp/758", "solution": "def unique_sublists(some_list):\n    \"\"\"\n    Counts lists within a list, converting each list to a tuple and returning their frequencies.\n    \"\"\"\n    def _normalize_recursive(value):\n        \"\"\"Recursively converts lists into tuples to make them hashable.\"\"\"\n        if isinstance(value, list):\n            return tuple(_normalize_recursive(item) for item in value)\n        return value\n\n    counts = {}\n    for sublist in some_list:\n        normalized_key = _normalize_recursive(sublist)\n        counts[normalized_key] = counts.get(normalized_key, 0) + 1\n    return counts"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(arr, n):\n    \"\"\"\n    Finds the minimum difference between any two elements in the first n elements of an array.\n    Sorts the relevant elements and computes the minimum absolute difference between adjacent elements.\n    \"\"\"\n    values = list(arr[:n])\n    values.sort()\n\n    min_diff = float('inf')\n\n    for i in range(1, len(values)):\n        diff = abs(values[i] - values[i-1])\n        if diff < min_diff:\n            min_diff = diff\n    \n    # Return an integer if all considered elements were integers and the minimum difference is integral, otherwise return a float.\n    if all(isinstance(v, int) for v in values) and min_diff.is_integer():\n        return int(min_diff)\n    else:\n        return min_diff"}
