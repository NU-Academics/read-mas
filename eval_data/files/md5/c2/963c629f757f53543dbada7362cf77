{"task_id": "Mbpp/56", "solution": "def check(n):\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    def _reverse_int(num: int) -> int:\n        \"\"\"Reverses the digits of a non-negative integer.\"\"\"\n        s = str(num)\n        return int(s[::-1])\n\n    reversed_n = _reverse_int(n)\n    return n == (2 * reversed_n) - 1"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(value: int) -> bool:\n    \"\"\"Checks if the given number is a Woodall number (n * 2^n - 1).\"\"\"\n    # Iterate for possible values of n up to a reasonable limit to prevent excessive computation.\n    MAX_N_ITER = 64 \n\n    for n in range(1, MAX_N_ITER + 1):\n        woodall_candidate = n * (1 << n) - 1 # Calculates n * 2^n - 1 using bit shift for 2^n\n\n        if woodall_candidate == value:\n            return True\n        if woodall_candidate > value:\n            # If the current candidate is already greater,\n            # further increments of n will also be greater.\n            return False\n    return False"}
{"task_id": "Mbpp/58", "solution": "def opposite_Signs(a, b):\n    \"\"\"\n    Checks if two integers have opposite signs, considering zero as neither positive nor negative.\n    Returns True if one is positive and the other is negative, False otherwise.\n    \"\"\"\n    sign_a = 0\n    if a < 0:\n        sign_a = -1\n    elif a > 0:\n        sign_a = 1\n\n    sign_b = 0\n    if b < 0:\n        sign_b = -1\n    elif b > 0:\n        sign_b = 1\n\n    return (sign_a * sign_b) == -1"}
