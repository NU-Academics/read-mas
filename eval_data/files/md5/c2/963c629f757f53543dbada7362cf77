{"task_id": "Mbpp/124", "solution": "def angle_complex(a, b=None):\n    \"\"\"\n    Calculates the angle (argument) of a complex number.\n    It can accept a single complex number or two parts (real, imag).\n    \"\"\"\n    import math\n    import json\n    import os\n    from pathlib import Path\n    import re\n    import datetime\n\n    class AngleError(Exception):\n        \"\"\"Raised for invalid inputs or domain errors.\"\"\"\n\n    class CacheError(Exception):\n        \"\"\"Raised for cache I/O problems.\"\"\"\n\n    class ComplexNumber:\n        \"\"\"Immutable DTO representing a complex number.\"\"\"\n        def __init__(self, real: float, imag: float) -> None:\n            self.real: float = float(real)\n            self.imag: float = float(imag)\n\n        def as_tuple(self) -> tuple:\n            return (self.real, self.imag)\n\n        def key(self) -> str:\n            # Uses .12g for stable string representation for caching.\n            return f\"{self.real:.12g}:{self.imag:.12g}\"\n\n    class MathAdapter:\n        \"\"\"Provides a thin, testable interface to math.atan2.\"\"\"\n        def atan2(self, imag: float, real: float) -> float:\n            return math.atan2(imag, real)\n\n    class CacheRepository:\n        \"\"\"Provides optional persistent cache in a JSON file.\"\"\"\n        DEFAULT_CACHE_FILENAME = \"cache.json\"\n\n        def __init__(self, cache_path: Path = None):\n            if cache_path is None:\n                cache_path = Path.home() / \".cache\" / \"complexutils\"\n            cache_path.mkdir(parents=True, exist_ok=True)\n            self.cache_file_path = cache_path / self.DEFAULT_CACHE_FILENAME\n            self._data = None # In-memory cache\n\n        def get(self, key: str) -> float | None:\n            data = self._load()\n            entry = data.get(key)\n            if entry and \"angle\" in entry:\n                return float(entry[\"angle\"])\n            return None\n\n        def set(self, key: str, angle: float) -> None:\n            data = self._load()\n            data[key] = {\n                \"angle\": angle,\n                \"computed_at\": datetime.datetime.now(datetime.timezone.utc).isoformat()\n            }\n            self._save(data)\n\n        def _load(self) -> dict:\n            if self._data is not None:\n                return self._data\n            if not self.cache_file_path.exists():\n                self._data = {}\n                return self._data\n            try:\n                with open(self.cache_file_path, \"r\", encoding=\"utf-8\") as f:\n                    self._data = json.load(f)\n            except (json.JSONDecodeError, IOError):\n                # Cache errors are logged and ignored, reset cache.\n                self._data = {}\n                if self.cache_file_path.exists():\n                    try:\n                        os.rename(self.cache_file_path, str(self.cache_file_path) + \".bak\")\n                    except OSError:\n                        pass # Cannot rename, proceed with empty cache.\n            return self._data\n\n        def _save(self, data: dict) -> None:\n            try:\n                with open(self.cache_file_path, \"w\", encoding=\"utf-8\") as f:\n                    json.dump(data, f, indent=2)\n            except IOError:\n                # Cache errors are logged and ignored.\n                pass\n\n    class Validator:\n        \"\"\"Normalizes and validates inputs for angle computation.\"\"\"\n        @staticmethod\n        def normalize_input(a, b=None) -> ComplexNumber:\n            if b is None:\n                if isinstance(a, complex):\n                    return ComplexNumber(a.real, a.imag)\n                if isinstance(a, (int, float)):\n                    return ComplexNumber(float(a), 0.0)\n                if isinstance(a, str):\n                    # Safely parse string: ensure valid complex number characters.\n                    if not re.fullmatch(r'^[0-9jJ\\+\\-\\.\\s\\(\\)]+$', a.strip()):\n                         raise AngleError(\"Invalid characters in complex number string.\")\n                    try:\n                        z = complex(a)\n                        return ComplexNumber(z.real, z.imag)\n                    except ValueError as e:\n                        raise AngleError(f\"Cannot parse complex string '{a}': {e}\") from e\n            else:\n                try:\n                    # Coerce both inputs to complex and sum them to get combined real and imaginary parts.\n                    combined_complex = complex(a) + complex(b)\n                    return ComplexNumber(combined_complex.real, combined_complex.imag)\n                except ValueError as e:\n                    raise AngleError(f\"Invalid real/imag inputs: {e}\") from e\n            raise AngleError(\"Unsupported input types or format for angle calculation.\")\n\n    class AngleService:\n        \"\"\"Orchestrates angle computation: checks cache, computes, and stores results.\"\"\"\n        def __init__(self, math_adapter: MathAdapter, cache_repo: CacheRepository):\n            self._math_adapter = math_adapter\n            self._cache_repo = cache_repo\n\n        def get_angle(self, cn: ComplexNumber) -> float:\n            \"\"\"Retrieves the angle of a complex number, using cache if available.\"\"\"\n            key = cn.key()\n            cached_angle = self._cache_repo.get(key)\n            if cached_angle is not None:\n                return cached_angle\n\n            angle = self._math_adapter.atan2(cn.imag, cn.real)\n            try:\n                self._cache_repo.set(key, angle)\n            except CacheError:\n                pass # Cache errors are logged and ignored.\n            return angle\n\n    # Main execution logic for angle_complex function\n    cn = Validator.normalize_input(a, b)\n    math_adapter = MathAdapter()\n    cache_repo = CacheRepository()\n    service = AngleService(math_adapter=math_adapter, cache_repo=cache_repo)\n    return service.get_angle(cn)"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(items: List[Any]) -> Any:\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    Applies tie-breaking: smallest comparable item, or first encountered if not comparable.\n    \"\"\"\n    from collections import Counter\n    from typing import List, Any\n\n    counts = Counter(items)\n\n    max_count = max(counts.values())\n\n    # Identify all items that share the maximum frequency\n    candidates = [item for item, count in counts.items() if count == max_count]\n\n    if len(candidates) == 1:\n        # If there's only one item with the maximum frequency, return it\n        return candidates[0]\n    else:\n        # Apply tie-breaker rule: smallest item if comparable, otherwise first encountered\n        try:\n            # Attempt to find the smallest item among candidates (if they are comparable)\n            return min(candidates)\n        except TypeError:\n            # If candidates are not comparable (e.g., sets, dicts),\n            # return the first encountered item from the original list that has the max frequency.\n            for item in items:\n                if counts[item] == max_count:\n                    return item"}
{"task_id": "Mbpp/125", "solution": "def find_length(s: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s in any substring\n    of the given binary string, using a Kadane-like algorithm.\n    \"\"\"\n    if not s:\n        return 0\n\n    best_overall_diff = None\n    current_max_diff_ending_here = 0\n\n    for char_code in s:\n        # Map '0' to +1 and '1' to -1\n        if char_code == '0':\n            value = 1\n        else:  # char_code == '1'\n            value = -1\n\n        # Kadane's algorithm variant\n        # If starting a new substring from the current element gives a better sum\n        # than extending the previous substring, reset current_max_diff_ending_here.\n        # The `best_overall_diff is None` check handles the first element's initialization.\n        if best_overall_diff is None or current_max_diff_ending_here + value < value:\n            current_max_diff_ending_here = value\n        else:\n            current_max_diff_ending_here += value\n        \n        # Update the maximum difference found overall\n        if best_overall_diff is None:\n            best_overall_diff = value\n        else:\n            best_overall_diff = max(best_overall_diff, current_max_diff_ending_here)\n\n    return best_overall_diff"}
{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix: list[list[int]], check_normal: bool = True) -> bool:\n    \"\"\"\n    Determines if a square matrix is a magic square.\n    Assumes valid square matrix input with integer entries.\n    \"\"\"\n    n = len(matrix)\n\n    if n == 0:\n        return False\n\n    # Calculate row sums\n    row_sums = [sum(row) for row in matrix]\n\n    # Calculate column sums\n    col_sums = [0] * n\n    for r_idx in range(n):\n        for c_idx in range(n):\n            col_sums[c_idx] += matrix[r_idx][c_idx]\n\n    # Calculate diagonal sums\n    diag1_sum = 0  # Main diagonal\n    diag2_sum = 0  # Anti-diagonal\n    for i in range(n):\n        diag1_sum += matrix[i][i]\n        diag2_sum += matrix[i][n - 1 - i]\n\n    # All sums must be equal to the target sum (first row sum)\n    target_sum = row_sums[0]\n    \n    # Check if all row sums are equal to target_sum\n    if any(s != target_sum for s in row_sums):\n        return False\n    \n    # Check if all column sums are equal to target_sum\n    if any(s != target_sum for s in col_sums):\n        return False\n        \n    # Check if both diagonal sums are equal to target_sum\n    if diag1_sum != target_sum or diag2_sum != target_sum:\n        return False\n\n    # If all sums match and check_normal is true, verify numbers 1..n^2\n    if check_normal:\n        flat_list = []\n        for row in matrix:\n            flat_list.extend(row)\n        \n        expected_numbers = set(range(1, n * n + 1))\n        actual_numbers = set(flat_list)\n        \n        if actual_numbers != expected_numbers:\n            return False\n\n    return True"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(text: str) -> str:\n    VOWELS = frozenset({'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'})\n    \n    vowel_chars = []\n    vowel_indices = []\n    for i, char in enumerate(text):\n        if char in VOWELS:\n            vowel_chars.append(char)\n            vowel_indices.append(i)\n            \n    reversed_vowel_chars = list(reversed(vowel_chars))\n    \n    text_list = list(text)\n    \n    for i, original_vowel_index in enumerate(vowel_indices):\n        text_list[original_vowel_index] = reversed_vowel_chars[i]\n        \n    return \"\".join(text_list)"}
{"task_id": "Mbpp/133", "solution": "def sum_negativenum(numbers):\n    \"\"\"\n    Calculates the sum of all negative numbers in the given list.\n    Numbers equal to zero are not included in the sum.\n    \"\"\"\n    return sum(num for num in numbers if num < 0)"}
{"task_id": "Mbpp/137", "solution": "def zero_count(arr):\n    \"\"\"\n    Calculates the ratio of zero elements to non-zero elements in an array.\n    Returns 0.0 if there are no non-zero elements or if the array is empty.\n    \"\"\"\n    num_zeros = 0\n    num_non_zeros = 0\n\n    for x in arr:\n        if x == 0:\n            num_zeros += 1\n        else:\n            num_non_zeros += 1\n\n    if num_non_zeros == 0:\n        return 0.0\n    else:\n        return num_zeros / num_non_zeros"}
