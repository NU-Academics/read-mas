{"task_id": "Mbpp/462", "solution": "def combinations_list(items: list, max_n: int = 24) -> list[list]:\n    \"\"\"Generates all possible combinations (power set) of elements from a given list.\n    Combinations are ordered by ascending bitmask value, and elements within each combination are ordered by descending original index to match the example output.\n    \"\"\"\n    n = len(items)\n    all_combinations: list[list] = []\n\n    # Enumerate all 2^n combinations using bitmasks. The outer loop ensures combinations are sorted by ascending mask value.\n    for mask in range(1 << n):\n        current_combination: list = []\n        # Populate the current combination by iterating through items from highest to lowest index. This order of appending items aligns with the specified example output.\n        for i in range(n - 1, -1, -1):\n            if (mask >> i) & 1:\n                current_combination.append(items[i])\n        all_combinations.append(current_combination)\n\n    return all_combinations"}
{"task_id": "Mbpp/465", "solution": "from dataclasses import dataclass\nfrom typing import Any, Dict, List, Optional, Tuple, Set, Union\n\nJSONDict = Dict[str, Any]\n\nclass InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass DropEmptyError(Exception):\n    def __init__(self, message: str, cause: Optional[Exception]=None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.cause = cause\n\n@dataclass\nclass EmptyOptions:\n    remove_empty_iterables: bool\n    remove_blank_strings: bool\n    recursive: bool\n\nclass InputValidator:\n    MAX_DEPTH: int = 100\n\n    def __init__(self) -> None:\n        pass\n\n    def validate_dict(self, input_dict: Any) -> None:\n        if not isinstance(input_dict, dict):\n            raise InvalidInputError(\"Input must be a dictionary.\")\n\n    def validate_options(self, options: EmptyOptions) -> None:\n        if not isinstance(options.remove_empty_iterables, bool) or \\\n           not isinstance(options.remove_blank_strings, bool) or \\\n           not isinstance(options.recursive, bool):\n            raise ValueError(\"Options must be booleans.\")\n\ndef is_empty(value: Any, options: EmptyOptions) -> bool:\n    if value is None:\n        return True\n    if isinstance(value, str):\n        return value.strip() == \"\" if options.remove_blank_strings else False\n    if isinstance(value, (list, tuple, set)):\n        return len(value) == 0 if options.remove_empty_iterables else False\n    if isinstance(value, dict):\n        return len(value) == 0\n    return False\n\ndef filter_dict(input_dict: JSONDict, options: EmptyOptions, current_depth: int = 0) -> JSONDict:\n    if current_depth > InputValidator.MAX_DEPTH:\n        raise DropEmptyError(f\"Maximum recursion depth of {InputValidator.MAX_DEPTH} exceeded.\")\n\n    result = {}\n    for k, v in input_dict.items():\n        if options.recursive and isinstance(v, dict):\n            nested = filter_dict(v, options, current_depth + 1)\n            if nested:\n                result[k] = nested\n        else:\n            if not is_empty(v, options):\n                result[k] = v\n    return result\n\nclass DropEmptyService:\n    def __init__(self, validator: InputValidator) -> None:\n        self._validator = validator\n\n    def drop(self, input_dict: JSONDict, options: EmptyOptions) -> JSONDict:\n        self._validator.validate_dict(input_dict)\n        self._validator.validate_options(options)\n        try:\n            return filter_dict(input_dict, options)\n        except Exception as e:\n            raise DropEmptyError(\"Failed to drop empty items\", cause=e)\n\n_default_validator = InputValidator()\n_default_service = DropEmptyService(_default_validator)\n\ndef drop_empty(input_dict: dict, *, remove_empty_iterables: bool=True, remove_blank_strings: bool=True, recursive: bool=False) -> dict:\n    \"\"\"\n    Drops empty items from a dictionary based on specified options.\n    Returns a new dictionary with empty values removed.\n    \"\"\"\n    options = EmptyOptions(remove_empty_iterables=remove_empty_iterables, remove_blank_strings=remove_blank_strings, recursive=recursive)\n    return _default_service.drop(input_dict, options)"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(values: tuple) -> tuple:\n    \"\"\"\n    Computes the pairwise sum of neighboring elements in a tuple.\n    Returns an empty tuple if the input has fewer than two elements.\n    \"\"\"\n    if len(values) < 2:\n        return ()\n    return tuple(values[i] + values[i+1] for i in range(len(values)-1))"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(array, n):\n    \"\"\"\n    Finds the product of the array multiplication modulo n.\n    \"\"\"\n\n    class MathUtils:\n        @staticmethod\n        def mod_mul(a: int, b: int, modulus: int) -> int:\n            \"\"\"Computes (a * b) % modulus efficiently, preventing intermediate overflow.\"\"\"\n            return ((a % modulus) * (b % modulus)) % modulus\n\n        @staticmethod\n        def product_mod_iterable(values: list[int], modulus: int) -> int:\n            \"\"\"Calculates the product of an iterable of integers modulo a given modulus.\"\"\"\n            acc = 1 % modulus  # Product of empty set is 1. Handles modulus=1 correctly.\n            for v in values:\n                acc = MathUtils.mod_mul(acc, v, modulus)\n            return acc\n\n    class ProductCalculator:\n        def __init__(self, utils: MathUtils = None):\n            self._utils = utils if utils is not None else MathUtils()\n\n        def compute(self, values: list[int], modulus: int) -> int:\n            \"\"\"Computes the product of values modulo modulus, assuming valid inputs.\"\"\"\n            return self._utils.product_mod_iterable(values, modulus)\n\n    calculator = ProductCalculator()\n    return calculator.compute(array, n)"}
{"task_id": "Mbpp/463", "solution": "from typing import List, Sequence\n\nclass ProductResult:\n    \"\"\"\n    Data Transfer Object for the maximum product subarray result.\n    Includes the product value, start and end indices, and the subarray itself.\n    \"\"\"\n    def __init__(self, product: float, start: int, end: int, subarray: List[float]):\n        self.product = product\n        self.start = start\n        self.end = end\n        self.subarray = subarray\n\n    def to_dict(self) -> dict:\n        return {\n            \"product\": self.product,\n            \"start\": self.start,\n            \"end\": self.end,\n            \"subarray\": self.subarray\n        }\n\n    def __repr__(self) -> str:\n        return (f\"ProductResult(product={self.product}, start={self.start}, \"\n                f\"end={self.end}, subarray={self.subarray})\")\n\ndef max_subarray_product(arr: Sequence) -> ProductResult:\n    \"\"\"\n    Finds the maximum product of a contiguous subarray within the given array.\n    Handles positive, negative, and zero values, and tracks subarray indices.\n    \"\"\"\n    # Convert input array to a list of floats, assuming non-empty as per design constraints.\n    a: List[float] = [float(x) for x in arr]\n\n    max_overall = a[0]\n    max_start_idx = 0\n    max_end_idx = 0\n\n    current_max = a[0]\n    current_min = a[0]\n    current_max_start_temp = 0 # Tracks the starting index of the subarray producing `current_max`\n    current_min_start_temp = 0 # Tracks the starting index of the subarray producing `current_min`\n\n    for i in range(1, len(a)):\n        val = a[i]\n\n        prev_current_max = current_max\n        prev_current_min = current_min\n        prev_current_max_start_temp = current_max_start_temp\n        prev_current_min_start_temp = current_min_start_temp\n\n        if val == 0:\n            # If current element is 0, the current product becomes 0.\n            # Max product might be 0 itself, or from a previous segment.\n            if 0.0 > max_overall:\n                max_overall = 0.0\n                max_start_idx = i\n                max_end_idx = i\n            # Reset current product trackers for the next segment\n            current_max = 1.0\n            current_min = 1.0\n            current_max_start_temp = i + 1\n            current_min_start_temp = i + 1\n            continue\n\n        # Calculate potential new current_max and current_min values\n        new_current_max = max(val, prev_current_max * val, prev_current_min * val)\n        new_current_min = min(val, prev_current_max * val, prev_current_min * val)\n\n        # Update current_max_start_temp based on which candidate became new_current_max\n        if new_current_max == val:\n            current_max_start_temp = i\n        elif new_current_max == prev_current_max * val:\n            current_max_start_temp = prev_current_max_start_temp\n        else: # new_current_max == prev_current_min * val\n            current_max_start_temp = prev_current_min_start_temp\n        \n        # Update current_min_start_temp based on which candidate became new_current_min\n        if new_current_min == val:\n            current_min_start_temp = i\n        elif new_current_min == prev_current_min * val:\n            current_min_start_temp = prev_current_min_start_temp\n        else: # new_current_min == prev_current_max * val\n            current_min_start_temp = prev_current_max_start_temp\n            \n        current_max = new_current_max\n        current_min = new_current_min\n\n        # Update overall maximum product and its indices, applying tie-breaking rules\n        if current_max > max_overall:\n            max_overall = current_max\n            max_start_idx = current_max_start_temp\n            max_end_idx = i\n        elif current_max == max_overall: # Tie-breaking: leftmost start, then shortest subarray\n            if current_max_start_temp < max_start_idx: # Smaller start index wins\n                max_start_idx = current_max_start_temp\n                max_end_idx = i\n            elif current_max_start_temp == max_start_idx: # If start indices are same, shorter subarray wins\n                if (i - current_max_start_temp) < (max_end_idx - max_start_idx):\n                    max_end_idx = i\n\n    return ProductResult(\n        product=float(max_overall),\n        start=max_start_idx,\n        end=max_end_idx,\n        subarray=a[max_start_idx : max_end_idx + 1]\n    )"}
{"task_id": "Mbpp/468", "solution": "def max_product(arr):\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of an increasing subsequence.\n    Uses dynamic programming to track the maximum product ending at each element.\n    \"\"\"\n    n = len(arr)\n\n    if n == 0:\n        return 0.0\n\n    # product_dp[i] stores the maximum product of an increasing subsequence ending at arr[i].\n    product_dp = [float(v) for v in arr]\n\n    for i in range(n):\n        for j in range(i):\n            if arr[j] < arr[i]:\n                candidate = product_dp[j] * arr[i]\n                if candidate > product_dp[i]:\n                    product_dp[i] = candidate\n\n    # The maximum product is the largest value in the product_dp array.\n    max_prod = max(product_dp)\n\n    return max_prod"}
{"task_id": "Mbpp/473", "solution": "from typing import Iterable, Tuple, Set\n\ndef tuple_intersection(list_a: Iterable[Tuple[int,int]], list_b: Iterable[Tuple[int,int]]) -> Set[Tuple[int,int]]:\n    \"\"\"\n    Finds the intersection of elements from two lists of tuples, treating tuples like (a, b) and (b, a) as identical.\n    Each tuple is first normalized to its canonical (min, max) form for comparison.\n    \"\"\"\n    def _normalize_pair(pair: Tuple[int, int]) -> Tuple[int, int]:\n        # Normalizes a 2-element tuple to its canonical (min, max) form.\n        a, b = pair\n        return (a, b) if a <= b else (b, a)\n\n    set_a_normalized = {_normalize_pair(item) for item in list_a}\n    set_b_normalized = {_normalize_pair(item) for item in list_b}\n\n    return set_a_normalized & set_b_normalized"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(list):\n    \"\"\"\n    Checks if the given list contains consecutive numbers without duplicates.\n    An empty list or a list with duplicates is not considered consecutive.\n    \"\"\"\n    if not list:\n        return False\n\n    # If duplicates are present, the list is not considered consecutive.\n    if len(set(list)) != len(list):\n        return False\n\n    # Find the minimum and maximum values in the list.\n    min_val = min(list)\n    max_val = max(list)\n\n    # For a list of unique numbers to be consecutive, the range (max - min + 1)\n    # must be equal to the count of numbers in the list.\n    return (max_val - min_val + 1) == len(list)"}
