{"task_id": "Mbpp/629", "solution": "def Split(numbers):\n    \"\"\"\n    Finds even numbers from a list of integers, preserving their original order.\n    Assumes valid input list containing only integers.\n    \"\"\"\n    even_numbers = []\n    for number in numbers:\n        if number % 2 == 0:\n            even_numbers.append(number)\n    return even_numbers"}
{"task_id": "Mbpp/630", "solution": "def get_coordinates(coordinate_tuple):\n    \"\"\"\n    Extracts all adjacent coordinates, including the given one, in row-major order.\n    \"\"\"\n    x, y = coordinate_tuple\n    result = []\n    for dx in (-1, 0, 1):\n        for dy in (-1, 0, 1):\n            result.append([x + dx, y + dy])\n    return result"}
{"task_id": "Mbpp/631", "solution": "def replace_spaces(text: str, to_underscore: bool = True, collapse: bool = False) -> str:\n    \"\"\"Replaces whitespaces with an underscore or vice versa in a string.\n    Optionally collapses consecutive separators.\"\"\"\n    if to_underscore:\n        transformed_text = ''.join('_' if ch.isspace() else ch for ch in text)\n        separator = '_'\n    else:\n        transformed_text = text.replace('_', ' ')\n        separator = ' '\n\n    if collapse and transformed_text:\n        out = []\n        prev_is_separator = False\n        for ch in transformed_text:\n            if ch == separator:\n                if not prev_is_separator:\n                    out.append(ch)\n                prev_is_separator = True\n            else:\n                out.append(ch)\n                prev_is_separator = False\n        transformed_text = ''.join(out)\n\n    return transformed_text"}
{"task_id": "Mbpp/632", "solution": "def move_zero(items: list) -> list:\n    \"\"\"Moves all elements equal to zero to the end of the list, preserving the order of non-zero elements.\"\"\"\n    non_zero = []\n    zero_count = 0\n    for e in items:\n        if e == 0:\n            zero_count += 1\n        else:\n            non_zero.append(e)\n    return non_zero + [0] * zero_count"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers, n):\n    \"\"\"\n    Calculates the sum of XORs of all pairs of numbers in a given list using a bit-contribution approach.\n    The parameter 'n' is ignored as the list length is determined from 'numbers'.\n    \"\"\"\n    num_count = len(numbers)\n\n    if num_count < 2:\n        return 0\n\n    max_abs_val = 0\n    for num in numbers:\n        max_abs_val = max(max_abs_val, abs(num))\n\n    bit_limit = 1\n    if max_abs_val > 0:\n        bit_limit = max_abs_val.bit_length()\n\n    # Initialize a list to store the count of numbers with each bit position set.\n    # counts[b] will store how many numbers have the b-th bit set.\n    counts = [0] * bit_limit\n    \n    # Create a mask for consistent bit representation, especially for negative numbers.\n    # This ensures that only bits up to 'bit_limit' are considered for counting.\n    bit_mask = (1 << bit_limit) - 1\n\n    for num in numbers:\n        # Apply the mask to process numbers within the determined bit width.\n        effective_num = num & bit_mask\n        for b in range(bit_limit):\n            if (effective_num >> b) & 1:  # Check if the b-th bit is set\n                counts[b] += 1\n\n    total_xor_sum = 0\n    # Iterate through each bit position to calculate its contribution to the total XOR sum.\n    # For a given bit position 'b', if 'count_set' numbers have this bit set,\n    # then 'count_set * (num_count - count_set)' pairs will have a '1' at this bit position.\n    for b in range(bit_limit):\n        count_set = counts[b]\n        total_xor_sum += count_set * (num_count - count_set) * (1 << b)\n\n    return total_xor_sum"}
{"task_id": "Mbpp/635", "solution": "def heap_sort(items: List[T]) -> List[T]:\n    \"\"\"\n    Sort items using heap sort and return a new sorted list.\n    This implementation encapsulates all necessary classes and helpers inline.\n    \"\"\"\n    from typing import List, Optional, Any, TypeVar, Callable\n\n    T = TypeVar(\"T\")\n\n    class HeapSortError(Exception):\n        \"\"\"Base exception for the heapsort module.\"\"\"\n\n    class InvalidInputError(HeapSortError):\n        \"\"\"Raised when input to heap_sort is invalid.\"\"\"\n\n    class Validator:\n        \"\"\"Utility class for validating input lists.\"\"\"\n        def validate_list(self, lst: Any) -> None:\n            if not isinstance(lst, (list, tuple)):\n                raise InvalidInputError(\"Input must be a list or tuple.\")\n            if len(lst) < 2:\n                return # Empty or single-element lists are valid\n            sample = lst[0]\n            for item in lst[1:]:\n                try:\n                    _ = sample < item  # Test comparability\n                except Exception as exc:\n                    raise InvalidInputError(\"Elements are not mutually comparable.\") from exc\n\n    class BinaryHeap:\n        \"\"\"A min-heap implementation used for the heap sort algorithm.\"\"\"\n        def __init__(self, items: Optional[List[T]] = None) -> None:\n            self._data: List[T] = []\n            if items:\n                self.heapify(list(items))\n\n        def heapify(self, items: List[T]) -> None:\n            \"\"\"Builds a heap from a list of items in O(n) time.\"\"\"\n            self._data = items\n            n = len(self._data)\n            for i in range((n // 2) - 1, -1, -1):\n                self._sift_down(i)\n\n        def push(self, item: T) -> None:\n            \"\"\"Adds an item to the heap, maintaining the heap invariant.\"\"\"\n            self._data.append(item)\n            self._sift_up(len(self._data) - 1)\n\n        def pop(self) -> T:\n            \"\"\"Removes and returns the smallest item from the heap.\"\"\"\n            if not self._data:\n                raise HeapSortError(\"pop from empty heap\")\n            last = self._data.pop()\n            if not self._data: # Heap was (size 1) before pop\n                return last\n            root = self._data[0]\n            self._data[0] = last\n            self._sift_down(0)\n            return root\n\n        def peek(self) -> T:\n            \"\"\"Returns the smallest item without removing it.\"\"\"\n            if not self._data:\n                raise HeapSortError(\"peek into empty heap\")\n            return self._data[0]\n\n        def size(self) -> int:\n            \"\"\"Returns the number of elements in the heap.\"\"\"\n            return len(self._data)\n\n        def _sift_up(self, idx: int) -> None:\n            \"\"\"Moves an element up the heap to restore the heap invariant.\"\"\"\n            while idx > 0:\n                parent = (idx - 1) // 2\n                if self._data[idx] < self._data[parent]:\n                    self._data[idx], self._data[parent] = self._data[parent], self._data[idx]\n                    idx = parent\n                else:\n                    break\n\n        def _sift_down(self, idx: int) -> None:\n            \"\"\"Moves an element down the heap to restore the heap invariant.\"\"\"\n            n = len(self._data)\n            while True:\n                left = 2 * idx + 1\n                right = left + 1\n                smallest = idx\n                if left < n and self._data[left] < self._data[smallest]:\n                    smallest = left\n                if right < n and self._data[right] < self._data[smallest]:\n                    smallest = right\n                if smallest == idx:\n                    break\n                self._data[idx], self._data[smallest] = self._data[smallest], self._data[idx]\n                idx = smallest\n\n    class HeapSortService:\n        \"\"\"Orchestrates the sorting process using a heap factory.\"\"\"\n        def __init__(self, heap_factory: Callable[[Optional[List[T]]], BinaryHeap]) -> None:\n            self._heap_factory = heap_factory\n\n        def sort(self, items: List[T]) -> List[T]:\n            \"\"\"Performs heapsort on a copy of the input list.\"\"\"\n            items_copy = list(items)  # Create a copy to avoid mutating the original list\n            heap = self._heap_factory(items_copy)\n            result: List[T] = []\n            while heap.size() > 0:\n                result.append(heap.pop())\n            return result\n\n    class HeapSortController:\n        \"\"\"Handles public API requests, performing validation and dispatching to the service.\"\"\"\n        def __init__(self, service: HeapSortService, validator: Validator) -> None:\n            self._service = service\n            self._validator = validator\n\n        def heap_sort(self, items: List[T]) -> List[T]:\n            \"\"\"Validates input and delegates sorting to the service.\"\"\"\n            self._validator.validate_list(items)\n            return self._service.sort(items)\n\n    # Instantiate the default controller with its dependencies\n    _default_controller = HeapSortController(\n        service=HeapSortService(heap_factory=lambda items_param=None: BinaryHeap(items_param)),\n        validator=Validator(),\n    )\n\n    return _default_controller.heap_sort(items)"}
{"task_id": "Mbpp/637", "solution": "from .facade import NoprofitNolossFacade\nfrom .logger_adapter import LoggerAdapter\nfrom .validator import Validator\nfrom .profit_loss_service import ProfitLossService\nfrom .config import LOG_PATH, ALLOW_NEGATIVE, FLOAT_TOLERANCE\n\n# Initialize default dependencies for the package-level function.\n_default_logger = LoggerAdapter(LOG_PATH)\n_default_validator = Validator()\n_default_service = ProfitLossService(\n    allow_negative=ALLOW_NEGATIVE,\n    float_tolerance=FLOAT_TOLERANCE\n)\n\n# Initialize the facade with default dependencies.\n_default_facade = NoprofitNolossFacade(\n    logger=_default_logger,\n    validator=_default_validator,\n    service=_default_service\n)\n\ndef noprofit_noloss(cost: float, price: float) -> bool:\n    \"\"\"\n    Checks if a transaction results in no profit and no loss.\n    Delegates the call to the configured NoprofitNolossFacade instance.\n    \"\"\"\n    return _default_facade.noprofit_noloss(cost, price)"}
{"task_id": "Mbpp/641", "solution": "def is_nonagonal(n: int) -> int:\n    \"\"\"\n    Calculates the nth nonagonal number using the closed-form formula.\n    Assumes n is a positive integer.\n    \"\"\"\n    return (7 * n * n - 5 * n) // 2"}
{"task_id": "Mbpp/638", "solution": "def wind_chill(velocity_kmh: float, temperature_c: float) -> int:\n    \"\"\"\n    Calculate the wind chill index rounded to the nearest integer.\n    Uses the Canadian wind-chill formula for temperature in Celsius and wind speed in km/h.\n    \"\"\"\n    # Wind-chill formula: T_wc = 13.12 + 0.6215*T - 11.37*v^0.16 + 0.3965*T*v^0.16\n    # Where T is temperature_c and v is velocity_kmh\n    \n    # Calculate v^0.16 once to optimize\n    v_pow_0_16 = velocity_kmh ** 0.16\n    \n    # Apply the wind-chill formula\n    raw_wind_chill = (\n        13.12 \n        + 0.6215 * temperature_c \n        - 11.37 * v_pow_0_16 \n        + 0.3965 * temperature_c * v_pow_0_16\n    )\n    \n    # Round to the nearest integer, with halves rounding away from zero (standard Python round behavior for positive values)\n    # The design context explicitly states \"rounded to the next integer\" interpreted as \"nearest integer\"\n    # to satisfy the example wind_chill(120,35)==40 (raw is ~40.24).\n    # Python's round() function rounds to the nearest even integer for .5,\n    # so we implement custom rounding to round away from zero for .5 as per the design context's utils.py snippet.\n    if raw_wind_chill >= 0:\n        return int(raw_wind_chill + 0.5)\n    else:\n        return int(raw_wind_chill - 0.5)"}
{"task_id": "Mbpp/639", "solution": "def sample_nam(names):\n    \"\"\"\n    Sums the length of names, filtering out those that start with a lowercase letter or are empty.\n    \"\"\"\n    total_length = 0\n    for name in names:\n        # Keep the name if it's not empty and its first character is not lowercase.\n        if name and not name[0].islower():\n            total_length += len(name)\n    return total_length"}
{"task_id": "Mbpp/643", "solution": "import re\n\nclass TextTokenizer:\n    \"\"\"Tokenizes text into words using Unicode word characters.\"\"\"\n    WORD_RE = re.compile(r\"\\w+\", re.UNICODE)\n\n    def tokenize(self, text: str) -> list[str]:\n        \"\"\"Returns a list of words found in the text.\"\"\"\n        return self.WORD_RE.findall(text)\n\nclass WordZChecker:\n    \"\"\"Checks if a word contains 'z' in its middle section.\"\"\"\n    def contains_z_middle(self, word: str) -> bool:\n        \"\"\"Returns True if 'z' or 'Z' is found not at the start or end of the word.\"\"\"\n        if len(word) <= 2:\n            return False\n        lower = word.lower()\n        for i in range(1, len(lower) - 1):\n            if lower[i] == \"z\":\n                return True\n        return False\n\ndef text_match_wordz_middle(text: str) -> bool:\n    \"\"\"\n    Checks if any word in the given text contains 'z' or 'Z' not at the start or end of the word.\n    \"\"\"\n    tokenizer = TextTokenizer()\n    checker = WordZChecker()\n    for word in tokenizer.tokenize(text):\n        if checker.contains_z_middle(word):\n            return True\n    return False"}
{"task_id": "Mbpp/644", "solution": "from typing import List, Any, Optional, Tuple\nimport json\nimport os\n\nclass InvalidInputError(ValueError):\n    \"\"\"Raised when an input array or k is invalid.\"\"\"\n    pass\n\nclass InvalidPositionError(ValueError):\n    \"\"\"Raised when the position k is out of bounds.\"\"\"\n    pass\n\nclass PersistenceError(Exception):\n    \"\"\"Raised when there's an issue with persisting data.\"\"\"\n    pass\n\nclass ReverseRequest:\n    \"\"\"DTO for a reverse array request.\"\"\"\n    def __init__(self, array: List[Any], k: int, persist: Optional[bool] = None):\n        self.array = array\n        self.k = k\n        self.persist = persist\n\nclass ReverseResponse:\n    \"\"\"DTO for a reverse array response.\"\"\"\n    def __init__(self, result: List[Any]):\n        self.result = result\n\ndef is_list_like(obj: Any) -> bool:\n    \"\"\"Checks if an object is list-like (list or tuple).\"\"\"\n    return isinstance(obj, (list, tuple))\n\ndef validate_array_and_k(arr: Any, k: Any) -> Tuple[List[Any], int]:\n    \"\"\"Validates the array and k, raising appropriate errors.\"\"\"\n    if not is_list_like(arr):\n        raise InvalidInputError(\"Input 'arr' must be a list or tuple.\")\n    if not isinstance(k, int):\n        raise InvalidInputError(\"Input 'k' must be an integer.\")\n    \n    # Cast tuple to list for consistency in service layer if it was a tuple\n    processed_arr = list(arr)\n    \n    # Position validation is handled in the service layer, but basic type validation is here.\n    return processed_arr, k\n\nDEFAULT_PERSIST_PATH: str = \"array_upto_k_last_result.json\"\n\nclass ArrayRepository:\n    \"\"\"Handles persistence of arrays to a JSON file.\"\"\"\n    def __init__(self, path: str):\n        self._path = path\n\n    def save(self, array: List[Any]) -> None:\n        \"\"\"Saves an array to the configured JSON file.\"\"\"\n        try:\n            with open(self._path, 'w') as f:\n                json.dump(array, f)\n        except Exception as e:\n            raise PersistenceError(f\"Failed to save array to {self._path}: {e}\")\n\n    def load(self) -> List[Any]:\n        \"\"\"Loads an array from the configured JSON file.\"\"\"\n        if not os.path.exists(self._path):\n            return []\n        try:\n            with open(self._path, 'r') as f:\n                return json.load(f)\n        except json.JSONDecodeError as e:\n            raise PersistenceError(f\"Malformed JSON in {self._path}: {e}\")\n        except Exception as e:\n            raise PersistenceError(f\"Failed to load array from {self._path}: {e}\")\n\nclass ArrayReverserService:\n    \"\"\"Provides business logic for reversing array prefixes.\"\"\"\n    def __init__(self, repository: Optional[ArrayRepository] = None):\n        self._repository = repository\n\n    def reverse_prefix(self, arr: List[Any], k: int, persist: Optional[bool] = None) -> List[Any]:\n        \"\"\"Reverses the first k elements of an array and optionally persists the result.\"\"\"\n        if k < 0 or k > len(arr):\n            raise InvalidPositionError(f\"k must be between 0 and {len(arr)} (inclusive for empty or full array).\")\n        \n        result = self._reverse_elements(arr, k)\n        \n        if persist and self._repository:\n            self._repository.save(result)\n        \n        return result\n\n    def _reverse_elements(self, arr: List[Any], k: int) -> List[Any]:\n        \"\"\"Reverses the first k elements of a *copy* of the array.\"\"\"\n        new_arr = list(arr)\n        i, j = 0, k - 1\n        while i < j:\n            new_arr[i], new_arr[j] = new_arr[j], new_arr[i]\n            i += 1\n            j -= 1\n        return new_arr\n\nclass ArrayController:\n    \"\"\"Manages requests, validation, and delegates to the service layer.\"\"\"\n    def __init__(self, service: ArrayReverserService):\n        self._service = service\n\n    def handle_reverse(self, request: ReverseRequest) -> ReverseResponse:\n        \"\"\"Handles a reverse array request, validates inputs, and returns the result.\"\"\"\n        arr, k = validate_array_and_k(request.array, request.k)\n        result = self._service.reverse_prefix(arr, k, persist=request.persist)\n        return ReverseResponse(result=result)\n\ndef reverse_Array_Upto_K(arr: list, k: int, persist: Optional[bool] = None) -> list:\n    \"\"\"\n    Reverses an array up to a given position k.\n    This function acts as the public API entry point.\n    \"\"\"\n    repo = None\n    if persist is True: # Only instantiate repository if persistence is explicitly requested.\n        repo = ArrayRepository(path=DEFAULT_PERSIST_PATH)\n        \n    service = ArrayReverserService(repository=repo)\n    controller = ArrayController(service=service)\n    req = ReverseRequest(array=arr, k=k, persist=persist)\n    return controller.handle_reverse(req).result"}
