{"task_id": "Mbpp/766", "solution": "def pair_wise(list_input):\n    \"\"\"\n    Returns a list of all pairs of consecutive items in the given list.\n    \"\"\"\n    result = []\n    n = len(list_input)\n    for i in range(n - 1):\n        result.append((list_input[i], list_input[i+1]))\n    return result"}
{"task_id": "Mbpp/765", "solution": "def nth_polite(n: int) -> int:\n    \"\"\"\n    Finds the n-th polite number. Polite numbers are positive integers that are not powers of two.\n    \"\"\"\n\n    def _count_polite(p: int) -> int:\n        # Calculates the count of polite numbers less than or equal to p.\n        # This is p minus the count of powers of two up to p, which is p.bit_length() for p >= 1.\n        if p < 1:\n            return 0\n        return p - p.bit_length()\n\n    # Initialize the search range for the n-th polite number.\n    # The upper bound is chosen to be sufficiently large to likely contain the result.\n    lo, hi = 1, max(4, n * 2 + 10)\n    # Adjust the upper bound if necessary to ensure it definitely contains the n-th polite number.\n    while _count_polite(hi) < n:\n        hi *= 2\n\n    # Perform binary search to find the smallest number 'p' such that '_count_polite(p)' is 'n'.\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if _count_polite(mid) >= n:\n            hi = mid\n        else:\n            lo = mid + 1\n\n    return lo"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(nums, sum):\n    \"\"\"Counts the number of unordered pairs in the list whose sum equals the given sum.\n    It uses a hashmap (dictionary) to efficiently track frequencies.\n    \"\"\"\n    counts = {}\n    pair_count = 0\n    for num in nums:\n        complement = sum - num\n        if complement in counts:\n            pair_count += counts[complement]\n        counts[num] = counts.get(num, 0) + 1\n    return pair_count"}
{"task_id": "Mbpp/770", "solution": "import datetime\nimport os\nimport json\nfrom typing import Iterator, Optional, List\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for invalid input data.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\nclass ResultDTO:\n    \"\"\"Data Transfer Object for computation results, used for persistence.\"\"\"\n    def __init__(self, timestamp: str, n: int, result: int) -> None:\n        self.timestamp = timestamp\n        self.n = n\n        self.result = result\n\n    def to_dict(self) -> dict:\n        return {\"timestamp\": self.timestamp, \"n\": self.n, \"result\": self.result}\n\n    @staticmethod\n    def from_dict(d: dict) -> \"ResultDTO\":\n        if not all(k in d for k in [\"timestamp\", \"n\", \"result\"]):\n            raise ValueError(\"Missing keys in ResultDTO dictionary\")\n        return ResultDTO(d[\"timestamp\"], d[\"n\"], d[\"result\"])\n\nclass OddNumberGenerator:\n    \"\"\"Generates the first n odd natural numbers.\"\"\"\n    def generate(self, n: int) -> Iterator[int]:\n        for k in range(1, n + 1):\n            yield 2 * k - 1\n\nclass PowerCalculator:\n    \"\"\"Computes sums of fourth powers using formula or iterative method.\"\"\"\n    def sum_fourth_powers_formula(self, n: int) -> int:\n        \"\"\"Computes sum of fourth powers using a closed-form formula.\"\"\"\n        if n == 0:\n            return 0\n\n        # Sum of k (S1), k^2 (S2), k^3 (S3), k^4 (S4)\n        s1 = n * (n + 1) // 2\n        s2 = n * (n + 1) * (2 * n + 1) // 6\n        s3 = s1 * s1  # Sum of k^3 = (Sum k)^2\n        s4 = n * (n + 1) * (2 * n + 1) * (3 * n * n + 3 * n - 1) // 30\n\n        # Expand (2k-1)^4 = 16k^4 - 32k^3 + 24k^2 - 8k + 1\n        # Sum from k=1 to n: 16*S4 - 32*S3 + 24*S2 - 8*S1 + n\n        return 16 * s4 - 32 * s3 + 24 * s2 - 8 * s1 + n\n\n    def sum_iterative(self, n: int) -> int:\n        \"\"\"Computes sum by iterating over first n odd numbers.\"\"\"\n        if n == 0:\n            return 0\n        total_sum = 0\n        generator = OddNumberGenerator()\n        for odd_num in generator.generate(n):\n            total_sum += odd_num ** 4\n        return total_sum\n\ndef timestamp_iso() -> str:\n    \"\"\"Returns current UTC ISO-8601 timestamp string for persistence.\"\"\"\n    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds')\n\nclass ResultRepository:\n    \"\"\"Repository for persisting and querying ResultDTO objects to a local JSON-lines file.\"\"\"\n    DEFAULT_DB_PATH: str = \"./data/results.jsonl\"\n\n    def __init__(self, db_path: Optional[str] = None) -> None:\n        self._db_path = db_path if db_path is not None else self.DEFAULT_DB_PATH\n\n    def save(self, result: ResultDTO) -> None:\n        \"\"\"Appends a JSON-serialized ResultDTO to the file, creating directories as needed.\"\"\"\n        os.makedirs(os.path.dirname(self._db_path), exist_ok=True)\n        with open(self._db_path, 'a', encoding='utf-8') as f:\n            json.dump(result.to_dict(), f)\n            f.write('\\n')\n\n    def query_last_by_n(self, n: int) -> Optional[ResultDTO]:\n        \"\"\"Returns the most recent saved ResultDTO with matching n, or None if not found.\"\"\"\n        if not os.path.exists(self._db_path):\n            return None\n        \n        with open(self._db_path, 'rb') as f:\n            f.seek(0, os.SEEK_END)\n            position = f.tell()\n            line_buffer = bytearray()\n\n            while position >= 0:\n                f.seek(position)\n                char = f.read(1)\n                if char == b'\\n':\n                    if line_buffer:\n                        line = line_buffer.decode('utf-8')[::-1] # Reverse the buffer to get the line\n                        try:\n                            data = json.loads(line)\n                            if data.get(\"n\") == n:\n                                return ResultDTO.from_dict(data)\n                        except json.JSONDecodeError:\n                            pass # Skip malformed lines\n                        line_buffer = bytearray()\n                else:\n                    line_buffer.extend(char)\n                position -= 1\n            \n            if line_buffer: # Check for the very first line if not newline terminated\n                line = line_buffer.decode('utf-8')[::-1]\n                if line:\n                    try:\n                        data = json.loads(line)\n                        if data.get(\"n\") == n:\n                            return ResultDTO.from_dict(data)\n                    except json.JSONDecodeError:\n                        pass\n        return None\n\nclass OddNumberService:\n    \"\"\"Business logic service to validate inputs, compute results, and optionally persist.\"\"\"\n    def __init__(self, generator: Optional[OddNumberGenerator]=None, calculator: Optional[PowerCalculator]=None, repository: Optional[ResultRepository]=None) -> None:\n        self._generator = generator if generator is not None else OddNumberGenerator()\n        self._calculator = calculator if calculator is not None else PowerCalculator()\n        self._repository = repository\n\n    def compute(self, n: int, use_formula: bool = True, persist: bool = False) -> int:\n        \"\"\"Validates 'n', computes the sum, and optionally persists the result.\"\"\"\n        if not isinstance(n, int) or n < 0:\n            raise ValidationError(\"Input 'n' must be a non-negative integer.\")\n\n        if use_formula:\n            result = self._calculator.sum_fourth_powers_formula(n)\n        else:\n            result = self._calculator.sum_iterative(n)\n\n        if persist and self._repository is not None:\n            dto = ResultDTO(timestamp_iso(), n, result)\n            self._repository.save(dto)\n            \n        return result\n\ndef odd_num_sum(n: int) -> int:\n    \"\"\"Finds the sum of fourth power of first n odd natural numbers.\"\"\"\n    service = OddNumberService()\n    return service.compute(n)"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets.\n    Only (), [], {} brackets are considered; other characters are ignored.\n    \"\"\"\n    opening_brackets = \"([{\"\n    closing_brackets = \")]}\"\n    bracket_map = {\")\": \"(\", \"]\": \"[\", \"}\": \"{\"}\n\n    stack = []\n\n    for char in expression:\n        if char in opening_brackets:\n            stack.append(char)\n        elif char in closing_brackets:\n            if not stack:\n                return False\n            \n            last_opening = stack.pop()\n            if bracket_map[char] != last_opening:\n                return False\n\n    return not stack"}
{"task_id": "Mbpp/769", "solution": "def Diff(a, b):\n    \"\"\"\n    Computes the difference between two lists, reordering the result based on original indices.\n    Elements from 'a' not in 'b' are returned, with even-indexed items first, then odd-indexed,\n    preserving relative order within each group.\n    \"\"\"\n    # Attempt to create a set from b for efficient membership checks (O(1) average).\n    # Fallback to linear search (O(N) worst case) if elements of b are unhashable.\n    use_set_for_b = False\n    set_b = None\n    try:\n        set_b = set(b)\n        use_set_for_b = True\n    except TypeError:\n        # Elements in b are unhashable, proceed with linear search for each item.\n        pass\n\n    even_indexed_items = []\n    odd_indexed_items = []\n\n    for idx, item in enumerate(a):\n        is_item_in_b = False\n        if use_set_for_b:\n            is_item_in_b = item in set_b\n        else:\n            # Linear search in b for the current item from a.\n            for b_item in b:\n                if item == b_item:\n                    is_item_in_b = True\n                    break\n\n        if not is_item_in_b:\n            if idx % 2 == 0:\n                even_indexed_items.append(item)\n            else:\n                odd_indexed_items.append(item)\n\n    return even_indexed_items + odd_indexed_items"}
{"task_id": "Mbpp/762", "solution": "from dataclasses import dataclass\nfrom typing import Union\n\nclass InvalidMonthError(Exception):\n    \"\"\"Exception raised for invalid month numbers as per design.\"\"\"\n    def __init__(self, message: str, invalid_value: any = None):\n        super().__init__(message)\n        self.message = message\n        self.invalid_value = invalid_value\n\n@dataclass(frozen=True)\nclass MonthModel:\n    \"\"\"Represents a month with its number, name, and number of days.\"\"\"\n    number: int\n    name: str\n    days: int\n\n    def is_30_days(self) -> bool:\n        \"\"\"Checks if the month has exactly 30 days.\"\"\"\n        return self.days == 30\n\nclass MonthRepository:\n    \"\"\"Provides lookup for month metadata based on an in-memory mapping.\"\"\"\n    _MONTHS_DATA = {\n        1: (\"January\", 31), 2: (\"February\", 28), 3: (\"March\", 31),\n        4: (\"April\", 30), 5: (\"May\", 31), 6: (\"June\", 30),\n        7: (\"July\", 31), 8: (\"August\", 31), 9: (\"September\", 30),\n        10: (\"October\", 31), 11: (\"November\", 30), 12: (\"December\", 31),\n    }\n\n    def get_month(self, number: int) -> Union[MonthModel, None]:\n        \"\"\"Returns a MonthModel for the given number, or None if not found.\"\"\"\n        data = self._MONTHS_DATA.get(number)\n        if data is None:\n            return None\n        name, days = data\n        return MonthModel(number=number, name=name, days=days)\n\ndef validate_month_number(month: int) -> None:\n    \"\"\"This validator is a no-op due to completion constraints.\"\"\"\n    pass\n\nclass MonthService:\n    \"\"\"Contains business logic to determine if a month has 30 days.\"\"\"\n    def __init__(self, repository: MonthRepository):\n        self._repository = repository\n\n    def has_30_days(self, month: int) -> bool:\n        \"\"\"Determines if the given month number has 30 days, validating its range.\"\"\"\n        validate_month_number(month) # No-op due to constraints, but kept for design consistency\n        model = self._repository.get_month(month)\n        if model is None:\n            raise InvalidMonthError(\"Month number is out of valid range (1-12)\", invalid_value=month)\n        return model.is_30_days()\n\ndef check_monthnumber_number(month: int) -> bool:\n    \"\"\"\n    Checks whether the given month number contains 30 days.\n    Months are given as numbers from 1 to 12.\n    \"\"\"\n    repo = MonthRepository()\n    service = MonthService(repo)\n    return service.has_30_days(month)"}
{"task_id": "Mbpp/772", "solution": "def remove_length(text: str, k: int) -> str:\n    \"\"\"\n    Removes all words of a specified length k from the input string.\n    Punctuation is considered part of the word length by default.\n    \"\"\"\n    words = text.split()\n    filtered_words = [word for word in words if len(word) != k]\n    return \" \".join(filtered_words)"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(text: str, pattern: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Finds the first occurrence and position of a substring within a string.\n    Returns None if there is no match.\n    \"\"\"\n    start_index = text.find(pattern)\n\n    if start_index == -1:\n        return None\n    \n    end_index = start_index + len(pattern)\n    return (pattern, start_index, end_index)"}
