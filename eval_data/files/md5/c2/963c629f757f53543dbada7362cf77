{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers):\n    \"\"\"\n    Finds the difference between the first even and first odd number in a list.\n    The difference is calculated as (first_even - first_odd).\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        \n        if first_even is not None and first_odd is not None:\n            break\n            \n    # Assuming valid input where both an even and an odd number will be found.\n    return first_even - first_odd"}
{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip: str) -> str:\n    # Splits the IP address into octets, normalizes each octet by removing leading zeros,\n    # and then rejoins them into a standardized IP address string.\n    octets = ip.split('.')\n    normalized_octets = []\n    for octet in octets:\n        # Convert to int to remove leading zeros, then back to string.\n        # This correctly handles \"00\" -> \"0\" and \"08\" -> \"8\".\n        normalized_octets.append(str(int(octet)))\n    return '.'.join(normalized_octets)"}
{"task_id": "Mbpp/597", "solution": "def find_kth(arr1, arr2, k):\n    \"\"\"\n    Finds the k-th smallest element from two sorted arrays using a binary search approach.\n    Assumes k is 1-based and within the valid range of total elements.\n    \"\"\"\n    m, n = len(arr1), len(arr2)\n\n    # Ensure arr1 is the shorter array for binary search efficiency\n    if m > n:\n        arr1, arr2, m, n = arr2, arr1, n, m\n\n    # Define the search space for the number of elements taken from arr1 (partition_x)\n    # partition_x can range from max(0, k - n) to min(k, m)\n    low = max(0, k - n)\n    high = min(k, m)\n\n    while low <= high:\n        partition_x = (low + high) // 2\n        partition_y = k - partition_x\n\n        # Determine elements on the left and right sides of the partitions\n        # If partition is at the beginning or end, use -infinity or +infinity\n        max_left_x = arr1[partition_x - 1] if partition_x != 0 else float('-inf')\n        min_right_x = arr1[partition_x] if partition_x != m else float('inf')\n\n        max_left_y = arr2[partition_y - 1] if partition_y != 0 else float('-inf')\n        min_right_y = arr2[partition_y] if partition_y != n else float('inf')\n\n        # Check if the partitions are correct\n        if max_left_x <= min_right_y and max_left_y <= min_right_x:\n            # Found the correct partition\n            # The k-th element is the maximum of the left partition values\n            return max(max_left_x, max_left_y)\n        elif max_left_x > min_right_y:\n            # We took too many elements from arr1, move partition_x to the left\n            high = partition_x - 1\n        else:\n            # We took too many elements from arr2 (or too few from arr1), move partition_x to the right\n            low = partition_x + 1"}
{"task_id": "Mbpp/590", "solution": "import math\nfrom dataclasses import dataclass\n\nclass InvalidCoordinateError(ValueError):\n    \"\"\"Custom exception for invalid coordinate values.\"\"\"\n    pass\n\ndef is_finite_number(v: float) -> bool:\n    \"\"\"Checks if a value is a finite number.\"\"\"\n    return math.isfinite(v)\n\ndef deg_to_rad(deg: float) -> float:\n    \"\"\"Converts degrees to radians.\"\"\"\n    return deg * math.pi / 180.0\n\n@dataclass\nclass Polar:\n    \"\"\"Represents polar coordinates (r, theta).\"\"\"\n    r: float\n    theta: float  # stored in radians\n\n    def to_complex(self, degrees: bool = False) -> complex:\n        \"\"\"Converts polar coordinates to a complex number.\"\"\"\n        if not is_finite_number(self.r) or not is_finite_number(self.theta):\n            raise InvalidCoordinateError(\"Invalid numeric values for Polar\")\n        \n        theta_rad = deg_to_rad(self.theta) if degrees else self.theta\n        x = self.r * math.cos(theta_rad)\n        y = self.r * math.sin(theta_rad)\n        return complex(x, y)\n\n    def to_tuple(self) -> tuple:\n        \"\"\"Returns polar coordinates as a tuple (r, theta).\"\"\"\n        return (self.r, self.theta)\n\ndef polar_rect(a, b):\n    \"\"\"\n    Converts rectangular coordinates (a, b) to polar (r, theta) and returns\n    a tuple containing the polar coordinates as a (r, theta) tuple and the\n    original rectangular coordinates as a complex number.\n    \"\"\"\n    # Based on the design context's 'polar_rect' convenience function\n    # with 'auto' mode defaulting to 'rect2polar' for inputs (a,b),\n    # we interpret (a, b) as (x, y) rectangular coordinates.\n    x = float(a)\n    y = float(b)\n\n    # Validates that inputs are finite numbers as per design context's error handling.\n    if not is_finite_number(x) or not is_finite_number(y):\n        raise InvalidCoordinateError(\"Input coordinates (x, y) must be finite numbers.\")\n\n    r = math.hypot(x, y)\n    theta = math.atan2(y, x)\n\n    polar_coords_dto = Polar(r=r, theta=theta)\n    rectangular_complex_value = complex(x, y)\n\n    # Returns the polar representation as a tuple and the complex form of the input.\n    # The problematic second element of the example assertion is ignored as per design context.\n    return (polar_coords_dto.to_tuple(), rectangular_complex_value)"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n):\n    \"\"\"\n    Calculates the sum and average of the first n natural numbers.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    total_sum = n * (n + 1) // 2\n    if n == 0:\n        average = 0.0\n    else:\n        average = total_sum / n\n    return (total_sum, average)"}
