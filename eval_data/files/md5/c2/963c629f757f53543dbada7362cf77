{"task_id": "Mbpp/140", "solution": "from typing import Iterable, Any, Set, Iterator\n\n\nclass ExtractError(Exception):\n    \"\"\"Custom exception for extraction and validation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\n\nclass Validators:\n    \"\"\"Utility class for validating types.\"\"\"\n    @staticmethod\n    def is_iterable(obj: Any) -> bool:\n        \"\"\"Checks if an object is iterable but not a string or bytes.\"\"\"\n        if isinstance(obj, (str, bytes)):\n            return False\n        try:\n            iter(obj)\n            return True\n        except TypeError:\n            return False\n\n    @staticmethod\n    def is_integer_number(value: Any) -> bool:\n        \"\"\"Checks if a value is an integer or a float representing an integer.\"\"\"\n        if isinstance(value, int):\n            return True\n        if isinstance(value, float):\n            return value.is_integer()\n        return False\n\n\nclass Extractor:\n    \"\"\"Extracts and validates integer numbers from nested iterables.\"\"\"\n    def extract(self, items: Iterable[Iterable[Any]]) -> Iterator[int]:\n        \"\"\"Iterates through items, validating structure and yielding integers.\"\"\"\n        if not Validators.is_iterable(items):\n            raise ExtractError(\"Outer object is not iterable\")\n        for inner in items:\n            for val in self._iter_inner(inner):\n                if Validators.is_integer_number(val):\n                    yield int(val)\n                else:\n                    raise ExtractError(f\"Invalid non-integer value: {val}\")\n\n    def _iter_inner(self, inner: Any) -> Iterator[Any]:\n        \"\"\"Helper to iterate an inner iterable after validation.\"\"\"\n        if not Validators.is_iterable(inner):\n            raise ExtractError(f\"Inner element is not iterable: {inner}\")\n        for v in inner:\n            yield v\n\n\nclass NumberCollection:\n    \"\"\"A data model for a collection of unique integer numbers.\"\"\"\n    def __init__(self, values: Iterable[int]) -> None:\n        self.values = set(values)\n\n    def to_set(self) -> Set[int]:\n        \"\"\"Returns the underlying set of numbers.\"\"\"\n        return self.values\n\n\nclass FlattenService:\n    \"\"\"Business logic for flattening iterables into a set.\"\"\"\n    def __init__(self, extractor: Extractor) -> None:\n        self._extractor = extractor\n\n    def flatten(self, items: Iterable[Iterable[Any]]) -> Set[int]:\n        \"\"\"Flattens a nested iterable using the injected extractor.\"\"\"\n        try:\n            values = set(self._extractor.extract(items))\n            collection = NumberCollection(values)\n            return collection.to_set()\n        except ExtractError:\n            raise\n\n\ndef extract_singly(items: Iterable[Iterable[Any]]) -> Set[int]:\n    \"\"\"Flattens a list of lists into a single set of numbers.\"\"\"\n    extractor = Extractor()\n    svc = FlattenService(extractor)\n    return svc.flatten(items)"}
{"task_id": "Mbpp/141", "solution": "def pancake_sort(values: list) -> list:\n    \"\"\"Sorts a list of elements using the pancake sort algorithm.\n    Returns a new list with elements sorted in non-decreasing order.\n    \"\"\"\n\n    def _flip(arr_local: list, k: int) -> None:\n        \"\"\"Reverses the first k elements of arr_local in place.\"\"\"\n        left = 0\n        while left < k // 2:\n            arr_local[left], arr_local[k - 1 - left] = arr_local[k - 1 - left], arr_local[left]\n            left += 1\n\n    def _find_max_index(arr_local: list, n_local: int) -> int:\n        \"\"\"Finds the index of the maximum element within arr_local[0:n_local].\"\"\"\n        max_idx = 0\n        for i in range(1, n_local):\n            if arr_local[i] > arr_local[max_idx]:\n                max_idx = i\n        return max_idx\n\n    arr = values.copy()\n    n = len(arr)\n\n    for curr_size in range(n, 1, -1):\n        max_idx = _find_max_index(arr, curr_size)\n\n        if max_idx != curr_size - 1:\n            if max_idx != 0:\n                _flip(arr, max_idx + 1)\n            _flip(arr, curr_size)\n\n    return arr"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(seq):\n    \"\"\"\n    Finds the maximum difference between any two elements in a sequence.\n    This is equivalent to max(seq) - min(seq).\n    \"\"\"\n    current_min = float('inf')\n    current_max = float('-inf')\n\n    for x in seq:\n        if x < current_min:\n            current_min = x\n        if x > current_max:\n            current_max = x\n\n    return current_max - current_min"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1, list2, list3):\n    \"\"\"\n    Counts the number of items that are identical at the same position in three given lists.\n    Comparison iterates up to the length of the shortest list.\n    \"\"\"\n    count = 0\n    min_length = min(len(list1), len(list2), len(list3))\n    for i in range(min_length):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n):\n    \"\"\"\n    Calculates the sum (n - 2*i) for positive terms, where i starts from 0.\n    The series continues as long as the term (n - 2*i) is greater than 0.\n    \"\"\"\n    if n <= 0:\n        return 0\n    # Calculate the number of positive terms in the series\n    count = (n + 1) // 2\n    # The last positive term in the series\n    last_term = n - 2 * (count - 1)\n    # Use the arithmetic series sum formula: count * (first_term + last_term) / 2\n    return count * (n + last_term) // 2"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(text: str) -> int:\n    \"\"\"\n    Counts characters in a string that match their 1-based alphabet position (case-insensitive).\n    Only English letters 'a' through 'z' are considered for matching.\n    \"\"\"\n    count = 0\n    alphabet = \"abcdefghijklmnopqrstuvwxyz\"\n    alphabet_size = len(alphabet)\n\n    for i, char in enumerate(text, start=1):\n        # Ignore characters that are not letters or exceed alphabet length.\n        if i > alphabet_size:\n            continue\n        \n        lower_char = char.lower()\n        if 'a' <= lower_char <= 'z':\n            # Check if the character matches the letter at its position in the alphabet.\n            if lower_char == alphabet[i - 1]:\n                count += 1\n    return count"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(source, to_remove):\n    \"\"\"\n    Removes all elements from the source list that are present in the to_remove list.\n    Preserves the order of remaining elements and returns a new list.\n    \"\"\"\n    try:\n        # Attempt to create a set from to_remove for efficient O(1) average time lookups.\n        removal_set = set(to_remove)\n        result = [item for item in source if item not in removal_set]\n    except TypeError:\n        # Fallback to O(n*m) equality comparison if elements in to_remove are not hashable.\n        result = [item for item in source if all(item != remove_item for remove_item in to_remove)]\n    return result"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple,\n    or returns None if no solution exists.\n    \"\"\"\n    def _extended_gcd(a_val: int, b_val: int) -> Tuple[int, int, int]:\n        # Returns (g, x, y) such that a_val*x + b_val*y = g, where g is gcd(a_val, b_val)\n        # and g is always non-negative.\n        old_r, r = a_val, b_val\n        old_s, s = 1, 0\n        old_t, t = 0, 1\n\n        while r != 0:\n            q = old_r // r\n            old_r, r = r, old_r - q * r\n            old_s, s = s, old_s - q * s\n            old_t, t = t, old_t - q * t\n\n        # Ensure g (old_r) is positive and adjust x, y accordingly.\n        if old_r < 0:\n            return (-old_r, -old_s, -old_t)\n        else:\n            return (old_r, old_s, old_t)\n\n    # Handle the special case where both coefficients are zero.\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    # Use the extended Euclidean algorithm to find g = gcd(a, b) and\n    # x0, y0 such that a*x0 + b*y0 = g.\n    g, x_base, y_base = _extended_gcd(a, b)\n\n    # If n is not divisible by g, no integer solution exists.\n    if n % g != 0:\n        return None\n\n    # Scale the base solution to satisfy a*x + b*y = n.\n    factor = n // g\n    x_particular = x_base * factor\n    y_particular = y_base * factor\n\n    # Normalize the particular solution to match specific test cases, e.g., smallest non-negative x.\n    # The general solution is x = x_particular + t * (b // g), y = y_particular - t * (a // g).\n    # We find t to shift x into a canonical range.\n    \n    # If b // g is zero (which happens if b is zero), x is uniquely determined, no x-normalization needed.\n    if b // g != 0:\n        x_shift = b // g\n        x_normalized = x_particular % x_shift\n        \n        # Calculate 't' used for the shift from x_particular to x_normalized.\n        # This t is an integer that accounts for the difference.\n        t_adjust = (x_normalized - x_particular) // x_shift\n        \n        y_normalized = y_particular - t_adjust * (a // g)\n        \n        return (x_normalized, y_normalized)\n    else:\n        # If b is 0, x is fixed (n/a), y can be any integer. (x_particular, y_particular) is a valid solution.\n        return (x_particular, y_particular)\n\nfrom typing import Optional, Tuple"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(nums: list[int]) -> int:\n    \"\"\"\n    Counts pairs of integers in a list that XOR to an even number.\n    Pairs (i, j) where i < j are counted once.\n    \"\"\"\n    evens = 0\n    odds = 0\n    for n in nums:\n        if (n & 1) == 0:  # Check if number is even\n            evens += 1\n        else:\n            odds += 1\n    \n    # Calculate combinations of pairs (n choose 2)\n    # Pairs of evens XOR to even. Pairs of odds XOR to even.\n    # Pairs of (even, odd) XOR to odd.\n    result = evens * (evens - 1) // 2 + odds * (odds - 1) // 2\n    return result"}
{"task_id": "Mbpp/168", "solution": "def frequency(lst: list, value: Any) -> int:\n    \"\"\"\n    Counts the number of occurrences of a value in a list.\n    Handles potential exceptions during comparison by treating non-comparable items as not equal.\n    \"\"\"\n    count = 0\n    for item in lst:\n        try:\n            if item == value:\n                count += 1\n        except Exception:\n            # If item == value comparison raises an exception,\n            # assume items are not equal and continue.\n            continue\n    return count"}
{"task_id": "Mbpp/170", "solution": "def sum_range_list(numbers: list, start: int, end: int) -> float:\n    \"\"\"Calculates the inclusive sum of numbers in a list within a specified index range.\"\"\"\n    n = len(numbers)\n\n    # As per design, an empty list results in a sum of 0.\n    if n == 0:\n        return 0.0\n\n    # Normalize negative indices to positive 0-based indices.\n    norm_start = start + n if start < 0 else start\n    norm_end = end + n if end < 0 else end\n\n    # Clamp normalized indices to be within the valid range [0, n-1].\n    norm_start = max(0, min(norm_start, n - 1))\n    norm_end = max(0, min(norm_end, n - 1))\n\n    # If the normalized start index is greater than the normalized end index, the range is empty.\n    if norm_start > norm_end:\n        return 0.0\n    else:\n        # Sum the slice of numbers from norm_start up to and including norm_end.\n        return float(sum(numbers[norm_start : norm_end + 1]))"}
{"task_id": "Mbpp/172", "solution": "def count_occurance(s):\n    \"\"\"Counts the non-overlapping occurrences of 'std' in the given string.\"\"\"\n    sub = \"std\"\n    if not sub:\n        return 0\n    \n    count = 0\n    idx = 0\n    step = len(sub)\n    \n    while True:\n        pos = s.find(sub, idx)\n        if pos == -1:\n            break\n        count += 1\n        idx = pos + step\n        \n    return count"}
