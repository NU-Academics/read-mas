{"task_id": "Mbpp/280", "solution": "from typing import Sequence, Any, Tuple, Optional\nfrom dataclasses import dataclass\n\n@dataclass(frozen=True)\nclass SearchResult:\n    \"\"\"Represents the result of a search operation.\"\"\"\n    found: bool\n    index: int\n\n    def to_tuple(self) -> Tuple[bool, int]:\n        \"\"\"Converts the search result to a (found, index) tuple.\"\"\"\n        return (self.found, self.index)\n\nclass SequentialSearchAlgorithm:\n    \"\"\"Implements the core sequential (linear) search logic.\"\"\"\n    def search(self, array: Sequence[Any], element: Any) -> SearchResult:\n        \"\"\"Performs a linear scan to find the element.\"\"\"\n        for i, v in enumerate(array):\n            if self._compare(v, element):\n                return SearchResult(True, i)\n        return SearchResult(False, -1)\n\n    def _compare(self, a: Any, b: Any) -> bool:\n        \"\"\"Compares two elements for equality.\"\"\"\n        return a == b\n\nclass SearchService:\n    \"\"\"Orchestrates the search operation, delegating to an algorithm.\"\"\"\n    def __init__(self, algorithm: Optional[SequentialSearchAlgorithm] = None) -> None:\n        \"\"\"Initializes the service with a search algorithm.\"\"\"\n        self._algorithm = algorithm or SequentialSearchAlgorithm()\n\n    def search(self, array: Sequence[Any], element: Any) -> SearchResult:\n        \"\"\"Executes the search using the configured algorithm.\"\"\"\n        return self._algorithm.search(array, element)\n\ndef sequential_search(array: Sequence[Any], element: Any) -> Tuple[bool, int]:\n    \"\"\"\n    Searches for an element in an array using a sequential search algorithm.\n    Returns a tuple (found: bool, index: int) indicating presence and position.\n    \"\"\"\n    service = SearchService()\n    result = service.search(array, element)\n    return result.to_tuple()"}
{"task_id": "Mbpp/282", "solution": "class SubtractionError(Exception):\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\ndef is_numeric(value) -> bool:\n    # Exclude bool, as it's a subclass of int but not semantically numeric here.\n    return isinstance(value, (int, float)) and not isinstance(value, bool)\n\nfrom typing import Sequence, Any\n\nclass ListValidator:\n    def validate_lengths(self, a: Sequence[Any], b: Sequence[Any]) -> None:\n        if len(a) != len(b):\n            raise SubtractionError(f\"Length mismatch: len(a)={len(a)} len(b)={len(b)}\")\n\n    def validate_numeric_elements(self, a: Sequence[Any], b: Sequence[Any]) -> None:\n        for i, (x, y) in enumerate(zip(a, b)):\n            if not is_numeric(x):\n                raise SubtractionError(f\"Non-numeric element at index {i} in first list: {x!r}\")\n            if not is_numeric(y):\n                raise SubtractionError(f\"Non-numeric element at index {i} in second list: {y!r}\")\n\nfrom typing import List, Sequence, Union\n\nNumber = Union[int, float]\n\ndef sub_list(a: Sequence[Number], b: Sequence[Number]) -> List[float]:\n    \"\"\"Subtracts two lists element-wise, returning a list of floats.\"\"\"\n    validator = ListValidator()\n    validator.validate_lengths(a, b)\n    validator.validate_numeric_elements(a, b)\n\n    return [float(x) - float(y) for x, y in zip(a, b)]"}
{"task_id": "Mbpp/283", "solution": "def validate(number: int) -> bool:\n    \"\"\"\n    Checks if the frequency of each digit in the integer is less than or equal to the digit itself.\n    The sign of the number is ignored. A digit '0' appearing will always make validation fail.\n    \"\"\"\n    from collections import Counter\n\n    # Convert the absolute value of the number to a string to easily iterate over digits.\n    # The design context specifies that the negative sign is ignored.\n    num_str = str(abs(number))\n\n    # Count the frequency of each digit.\n    digit_counts = Counter(num_str)\n\n    # Iterate through the counted digits and their frequencies.\n    for digit_char, frequency in digit_counts.items():\n        # Convert the digit character back to an integer for comparison.\n        digit_value = int(digit_char)\n\n        # Check if the frequency of the digit is greater than the digit itself.\n        # This condition naturally handles the '0' digit case:\n        # if digit_value is 0 and frequency is > 0, then frequency > digit_value is True,\n        # causing the function to return False.\n        if frequency > digit_value:\n            return False\n\n    # If all digits satisfy the condition, return True.\n    return True"}
{"task_id": "Mbpp/281", "solution": "def all_unique(iterable):\n    \"\"\"\n    Checks if all elements in the given iterable are unique.\n    It attempts an O(N) hash-based check and falls back to an O(N^2) equality check for unhashable items.\n    \"\"\"\n    items_materialized = []\n    seen_hashable = set()\n    fallback_required = False\n\n    for item in iterable:\n        items_materialized.append(item)\n\n        if not fallback_required:\n            try:\n                if item in seen_hashable:\n                    return False\n                seen_hashable.add(item)\n            except TypeError:\n                fallback_required = True\n\n    if not fallback_required:\n        return True\n    else:\n        n = len(items_materialized)\n        for i in range(n):\n            for j in range(i + 1, n):\n                if items_materialized[i] == items_materialized[j]:\n                    return False\n        return True"}
{"task_id": "Mbpp/284", "solution": "def check_element(lst, element):\n    \"\"\"\n    Checks if all items in the list are equal to the given element.\n    Returns True for an empty list.\n    \"\"\"\n    if not lst:\n        return True\n    for item in lst:\n        if item != element:\n            return False\n    return True"}
{"task_id": "Mbpp/286", "solution": "def max_sub_array_sum_repeated(arr: list[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in the array formed by repeating the given array k times.\n    Assumes n is the correct length of arr and k >= 1.\n    \"\"\"\n\n    def kadane(current_arr: list[int]) -> int:\n        \"\"\"Applies Kadane's algorithm to find the maximum subarray sum in a single array.\"\"\"\n        max_so_far = current_arr[0]\n        current_max = current_arr[0]\n        for x in current_arr[1:]:\n            current_max = max(x, current_max + x)\n            max_so_far = max(max_so_far, current_max)\n        return max_so_far\n\n    def max_prefix_sum(current_arr: list[int]) -> int:\n        \"\"\"Calculates the maximum sum of any prefix of the array.\"\"\"\n        current_sum = 0\n        max_sum_val = float('-inf')\n        for x in current_arr:\n            current_sum += x\n            max_sum_val = max(max_sum_val, current_sum)\n        return max_sum_val\n\n    def max_suffix_sum(current_arr: list[int]) -> int:\n        \"\"\"Calculates the maximum sum of any suffix of the array.\"\"\"\n        current_sum = 0\n        max_sum_val = float('-inf')\n        for x in reversed(current_arr):\n            current_sum += x\n            max_sum_val = max(max_sum_val, current_sum)\n        return max_sum_val\n\n    if k == 1:\n        return kadane(arr)\n\n    total_sum = sum(arr)\n    kadane_single = kadane(arr)\n    ans = kadane_single  # Initial candidate: max sum within a single copy of arr\n\n    if total_sum > 0:\n        # If total_sum is positive, repeating the array helps.\n        # Max sum can be (best suffix) + (k-2)*total_sum + (best prefix).\n        prefix_sum = max_prefix_sum(arr)\n        suffix_sum = max_suffix_sum(arr)\n        ans = max(ans, suffix_sum + (k - 2) * total_sum + prefix_sum)\n    else:\n        # If total_sum is non-positive, repeating the array many times won't increase the sum.\n        # The max sum will either be within one copy or span at most two copies of the array.\n        ans = max(ans, kadane(arr + arr))\n\n    return ans"}
{"task_id": "Mbpp/285", "solution": "import re\nimport sqlite3\nimport os\nfrom datetime import datetime\nfrom typing import Any, List, Optional, Union, Dict\n\n# Expands user path for the SQLite database.\nDB_PATH = os.path.expanduser(\"~/.local/share/text_matcher/history.db\")\nDEFAULT_ENGINE = \"regex\"\nMATCH_PATTERN = r\"a(b{2,3})\"\n\nclass TextMatcherError(Exception):\n    \"\"\"Custom exception for text matcher domain errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass InputValidator:\n    @staticmethod\n    def is_string(value: Any) -> bool:\n        \"\"\"Checks if a value is a string.\"\"\"\n        return isinstance(value, str)\n\nclass TimeUtils:\n    @staticmethod\n    def now_iso() -> str:\n        \"\"\"Returns the current UTC time in ISO8601 format.\"\"\"\n        return datetime.utcnow().isoformat()\n\nclass TextMatchResult:\n    \"\"\"Represents a single text match check result.\"\"\"\n    def __init__(self, input_text: str, matched: bool, engine: str, timestamp: str, id: Optional[int] = None) -> None:\n        self.input_text = input_text\n        self.matched = matched\n        self.engine = engine\n        self.timestamp = timestamp\n        self.id = id\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Converts the result to a dictionary.\"\"\"\n        return {\n            \"id\": self.id,\n            \"input_text\": self.input_text,\n            \"matched\": self.matched,\n            \"engine\": self.engine,\n            \"timestamp\": self.timestamp,\n        }\n\nCREATE_TABLE_SQL = \"\"\"\n    CREATE TABLE IF NOT EXISTS matches (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      input_text TEXT NOT NULL,\n      matched INTEGER NOT NULL,\n      engine TEXT NOT NULL,\n      timestamp TEXT NOT NULL\n    );\n\"\"\"\nINSERT_SQL = \"INSERT INTO matches (input_text, matched, engine, timestamp) VALUES (?, ?, ?, ?)\"\n\nclass TextMatchRepository:\n    \"\"\"Handles persistence of TextMatchResult to SQLite.\"\"\"\n    def __init__(self, db_path: str) -> None:\n        self._db_path = db_path\n        self._conn: Optional[sqlite3.Connection] = None\n        self._connect()\n        self.ensure_schema()\n\n    def _connect(self) -> None:\n        \"\"\"Establishes a connection to the SQLite database.\"\"\"\n        try:\n            db_dir = os.path.dirname(self._db_path)\n            os.makedirs(db_dir, exist_ok=True)\n            self._conn = sqlite3.connect(self._db_path, check_same_thread=False, timeout=5)\n            self._conn.row_factory = sqlite3.Row\n        except sqlite3.Error as e:\n            raise TextMatcherError(f\"Failed to connect to database at {self._db_path}: {e}\")\n\n    def ensure_schema(self) -> None:\n        \"\"\"Ensures the database schema exists.\"\"\"\n        if not self._conn:\n            raise TextMatcherError(\"Database connection not established.\")\n        try:\n            self._conn.execute(CREATE_TABLE_SQL)\n            self._conn.commit()\n        except sqlite3.Error as e:\n            raise TextMatcherError(f\"Failed to ensure DB schema: {e}\")\n\n    def insert_result(self, result: TextMatchResult) -> int:\n        \"\"\"Inserts a TextMatchResult into the database.\"\"\"\n        if not self._conn:\n            raise TextMatcherError(\"Database connection not established.\")\n        try:\n            cursor = self._conn.execute(INSERT_SQL, (result.input_text, result.matched, result.engine, result.timestamp))\n            self._conn.commit()\n            return cursor.lastrowid # type: ignore\n        except sqlite3.Error as e:\n            raise TextMatcherError(f\"Failed to insert result into DB: {e}\")\n\n    def fetch_last(self, n: int = 100) -> List[TextMatchResult]:\n        \"\"\"Fetches the last N match results.\"\"\"\n        if not self._conn:\n            raise TextMatcherError(\"Database connection not established.\")\n        try:\n            cursor = self._conn.execute(\"SELECT id, input_text, matched, engine, timestamp FROM matches ORDER BY id DESC LIMIT ?\", (n,))\n            results = []\n            for row in cursor.fetchall():\n                results.append(TextMatchResult(\n                    id=row['id'],\n                    input_text=row['input_text'],\n                    matched=bool(row['matched']),\n                    engine=row['engine'],\n                    timestamp=row['timestamp']\n                ))\n            return results\n        except sqlite3.Error as e:\n            raise TextMatcherError(f\"Failed to fetch results from DB: {e}\")\n\n    def close(self) -> None:\n        \"\"\"Closes the database connection.\"\"\"\n        if self._conn:\n            self._conn.close()\n            self._conn = None\n\nclass RegexEngine:\n    \"\"\"Regex-based matching engine.\"\"\"\n    def __init__(self, pattern: str) -> None:\n        self._pattern = pattern\n        self._compiled = re.compile(pattern)\n\n    def matches(self, text: str) -> bool:\n        \"\"\"Checks if the text matches the compiled pattern.\"\"\"\n        if not isinstance(text, str):\n            raise TypeError(\"text must be str\")\n        return bool(self._compiled.search(text))\n\nclass FSMEngine:\n    \"\"\"FSM-based engine for 'a' followed by 2 or 3 'b's.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def matches(self, text: str) -> bool:\n        \"\"\"Checks if the text contains 'a' followed by 2 or 3 'b' characters.\"\"\"\n        if not isinstance(text, str):\n            raise TypeError(\"text must be str\")\n        \n        i = 0\n        n = len(text)\n        while i < n:\n            if text[i] == 'a':\n                j = i + 1\n                bcount = 0\n                while j < n and text[j] == 'b' and bcount < 4:\n                    bcount += 1\n                    j += 1\n                if bcount == 2 or bcount == 3:\n                    return True\n            i += 1\n        return False\n\nclass TextMatcherService:\n    \"\"\"Orchestrates pattern matching and persistence.\"\"\"\n    def __init__(self, engine_name: Optional[str] = None, repository: Optional[TextMatchRepository] = None) -> None:\n        self.engine_name = engine_name or DEFAULT_ENGINE\n        self.engine = self._choose_engine(self.engine_name)\n        self.repository = repository if repository is not None else TextMatchRepository(DB_PATH)\n\n    def check(self, text: str) -> TextMatchResult:\n        \"\"\"Performs the match check and persists the result.\"\"\"\n        if not InputValidator.is_string(text):\n            raise TypeError(\"text must be a string\")\n        \n        matched = self.engine.matches(text)\n        ts = TimeUtils.now_iso()\n        result = TextMatchResult(input_text=text, matched=matched, engine=self.engine_name, timestamp=ts)\n        \n        try:\n            rowid = self.repository.insert_result(result)\n            result.id = rowid\n        except Exception as e:\n            raise TextMatcherError(f\"Failed to persist result: {e}\")\n        \n        return result\n\n    def _choose_engine(self, name: str) -> Union[RegexEngine, FSMEngine]:\n        \"\"\"Factory method to select the matching engine.\"\"\"\n        if name == \"fsm\":\n            return FSMEngine()\n        return RegexEngine(MATCH_PATTERN)\n\ndef text_match_two_three(text: str) -> bool:\n    \"\"\"\n    Checks if a string contains 'a' followed by two or three 'b' characters.\n    The check is performed by a TextMatcherService, and the result is persisted.\n    \"\"\"\n    svc = TextMatcherService()\n    try:\n        result = svc.check(text)\n        return result.matched\n    finally:\n        if svc.repository:\n            svc.repository.close()"}
{"task_id": "Mbpp/287", "solution": "import json\nimport os\nimport threading\nimport tempfile\n\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass RepositoryError(RuntimeError):\n    \"\"\"Exception raised for repository persistence issues.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass InputValidator:\n    \"\"\"Validates input for n.\"\"\"\n    MIN_N = 0\n\n    def validate(self, n: object) -> None:\n        \"\"\"Ensures n is a non-negative integer.\"\"\"\n        if not isinstance(n, int):\n            raise InvalidInputError(\"n must be an integer\")\n        if n < self.MIN_N:\n            raise InvalidInputError(\"n must be non-negative\")\n\nclass SumRepository:\n    \"\"\"Handles persistent caching of computed sums.\"\"\"\n    def __init__(self, path: str):\n        self._path = path\n        self._lock = threading.Lock()\n\n    def get(self, n: int) -> int | None:\n        \"\"\"Retrieves a cached result for n, if available.\"\"\"\n        data = self._load()\n        return data.get(str(n))\n\n    def save(self, n: int, value: int) -> None:\n        \"\"\"Saves a computed result to the cache atomically.\"\"\"\n        with self._lock:\n            data = self._load()\n            data[str(n)] = value\n            self._atomic_write(data)\n\n    def _load(self) -> dict[str, int]:\n        \"\"\"Loads cache data from the file, returning an empty dict if not found or invalid.\"\"\"\n        try:\n            with open(self._path, \"r\", encoding=\"utf-8\") as f:\n                return json.load(f)\n        except (FileNotFoundError, json.JSONDecodeError):\n            return {}\n        except Exception as e:\n            raise RepositoryError(f\"Failed to load cache from {self._path}: {e}\")\n\n    def _atomic_write(self, data: dict[str, int]) -> None:\n        \"\"\"Writes data to file atomically using a temporary file.\"\"\"\n        dirpath = os.path.dirname(self._path) or \".\"\n        try:\n            os.makedirs(dirpath, exist_ok=True)\n            fd, tmp_path = tempfile.mkstemp(dir=dirpath)\n            with os.fdopen(fd, \"w\", encoding=\"utf-8\") as f:\n                json.dump(data, f)\n            os.replace(tmp_path, self._path)\n        except Exception as e:\n            if os.path.exists(tmp_path):\n                os.remove(tmp_path)\n            raise RepositoryError(f\"Failed to atomically write cache to {self._path}: {e}\")\n\nclass Utils:\n    \"\"\"Provides mathematical utility methods.\"\"\"\n    @staticmethod\n    def sum_of_squares_of_first_n_even(n: int) -> int:\n        \"\"\"Calculates the sum of squares of the first n even natural numbers using a closed-form formula.\"\"\"\n        if n < 0: # Defensive check, validator should prevent this\n            raise ValueError(\"n must be non-negative\")\n        # Formula: 4 * sum_{k=1..n} k^2 = 4 * n(n+1)(2n+1)/6 simplifies to 2 * n(n+1)(2n+1)/3\n        return (2 * n * (n + 1) * (2 * n + 1)) // 3\n\nclass SquareSumService:\n    \"\"\"Orchestrates validation, computation, and caching.\"\"\"\n    def __init__(self, repository: SumRepository, validator: InputValidator):\n        self._repo = repository\n        self._validator = validator\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the sum of squares, using cache if available and persisting the result.\"\"\"\n        self._validator.validate(n)\n        cached = self._repo.get(n)\n        if cached is not None:\n            return cached\n\n        result = Utils.sum_of_squares_of_first_n_even(n)\n        try:\n            self._repo.save(n, result)\n        except Exception as e:\n            raise RepositoryError(f\"Failed to persist result for n={n}: {e}\")\n        return result\n\ndef square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of squares of the first n even natural numbers.\n    It uses an internal service that handles validation, computation, and caching.\n    \"\"\"\n    repo = SumRepository(os.path.join(\"data\", \"cache.json\"))\n    validator = InputValidator()\n    service = SquareSumService(repo, validator)\n    return service.compute(n)"}
{"task_id": "Mbpp/290", "solution": "from typing import List, Any, Tuple\n\ndef max_length(lists: List[List[Any]]) -> Tuple[int, List[Any]]:\n    \"\"\"\n    Finds the sublist with the maximum length in a list of lists.\n    Returns a tuple containing the maximum length and the first sublist encountered with that length.\n    \"\"\"\n    max_len = -1\n    max_sublist: List[Any] = []\n\n    for sublist in lists:\n        current_len = len(sublist)\n        if current_len > max_len:\n            max_len = current_len\n            max_sublist = sublist\n            \n    return (max_len, max_sublist)"}
{"task_id": "Mbpp/294", "solution": "def max_val(items: list) -> Union[int, float]:\n    \"\"\"\n    Finds the maximum numeric value in a heterogeneous list.\n\n    Non-numeric items are ignored. If no numeric values are found, an error is raised.\n    \"\"\"\n    from typing import Any, Union, Iterable\n\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception for invalid input scenarios.\"\"\"\n        def __init__(self, message: str) -> None:\n            self.message = message\n            super().__init__(self.message)\n\n    def _is_numeric(obj: Any) -> bool:\n        \"\"\"Checks if an object is an int or float, excluding booleans.\"\"\"\n        return isinstance(obj, (int, float)) and not isinstance(obj, bool)\n\n    if items is None:\n        raise InvalidInputError(\"Input is None; expected a sequence.\")\n\n    numeric_values = [item for item in items if _is_numeric(item)]\n\n    if not numeric_values:\n        raise InvalidInputError(\"No numeric values found in input.\")\n\n    return max(numeric_values)"}
{"task_id": "Mbpp/292", "solution": "import math\n\ndef find(a, b):\n    \"\"\"\n    Calculates the quotient of two numbers, rounded down to the nearest integer.\n    Uses math.floor for correct floor division behavior.\n    \"\"\"\n    return int(math.floor(a / b))"}
{"task_id": "Mbpp/293", "solution": "import math\n\ndef otherside_rightangle(a, b, mode=\"auto\"):\n    \"\"\"\n    Finds the third side of a right-angled triangle using the Pythagorean theorem.\n    It can calculate the hypotenuse from two legs or a missing leg from the hypotenuse and one leg.\n    \"\"\"\n\n    class TriangleError(Exception):\n        pass\n\n    class ValidationError(TriangleError):\n        pass\n\n    class GeometryImpossibleError(TriangleError):\n        pass\n\n    class _Validator:\n        @staticmethod\n        def validate_non_negative(value: float, name: str) -> None:\n            if value < 0:\n                raise ValidationError(f\"{name} must be non-negative, got {value}\")\n\n        @staticmethod\n        def validate_hyp_has_leg(hyp: float, leg: float) -> None:\n            if hyp <= leg:\n                raise GeometryImpossibleError(\"Hypotenuse must be greater than leg\")\n\n    class _GeometryService:\n        EPSILON: float = 1e-12\n\n        def _square(self, x: float) -> float:\n            return x * x\n\n        def compute_hypotenuse(self, a: float, b: float) -> float:\n            return math.sqrt(self._square(a) + self._square(b))\n\n        def compute_missing_leg(self, hypotenuse: float, leg: float) -> float:\n            disc = self._square(hypotenuse) - self._square(leg)\n            if disc < -self.EPSILON:\n                raise GeometryImpossibleError(\"Hypotenuse is smaller than leg; impossible geometry\")\n            return math.sqrt(max(disc, 0.0))\n\n    validator = _Validator()\n    service = _GeometryService()\n\n    a_f = float(a)\n    b_f = float(b)\n\n    validator.validate_non_negative(a_f, \"a\")\n    validator.validate_non_negative(b_f, \"b\")\n\n    if mode == \"auto\":\n        mode = \"legs\" # Default policy: treat as legs -> compute hypotenuse.\n\n    if mode == \"legs\":\n        return service.compute_hypotenuse(a_f, b_f)\n    elif mode == \"hypotenuse\":\n        # interpret a as hypotenuse, b as leg\n        validator.validate_hyp_has_leg(a_f, b_f)\n        return service.compute_missing_leg(a_f, b_f)\n    else:\n        raise ValidationError(f\"Unknown mode: {mode}\")"}
{"task_id": "Mbpp/297", "solution": "from typing import Any, List, Tuple\n\n# --- src/flattenlist/utils.py ---\nDEFAULT_CONTAINER_TYPES: Tuple[type, ...] = (list, tuple)\n\ndef is_string(obj: Any) -> bool:\n    \"\"\"Checks if an object is a string or bytes type.\"\"\"\n    return isinstance(obj, (str, bytes))\n\ndef is_iterable(obj: Any, container_types: Tuple[type, ...] = DEFAULT_CONTAINER_TYPES) -> bool:\n    \"\"\"Checks if an object is an iterable of the specified container types, excluding strings.\"\"\"\n    return isinstance(obj, container_types) and not is_string(obj)\n\n# --- src/flattenlist/exceptions.py ---\nclass FlattenError(Exception):\n    \"\"\"Base exception for the flattenlist library.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\nclass InvalidInputError(FlattenError):\n    \"\"\"Exception raised for disallowed or malformed input types.\"\"\"\n    def __init__(self, invalid_value: Any, message: str = '') -> None:\n        self.invalid_value = invalid_value\n        super().__init__(message if message else f\"Invalid input value or type: {type(invalid_value).__name__}\")\n\n# --- src/flattenlist/models.py ---\nclass FlattenRequest:\n    \"\"\"Data Transfer Object for a flatten request.\"\"\"\n    def __init__(self, data: Any) -> None:\n        self.data = data\n\nclass FlattenResponse:\n    \"\"\"Data Transfer Object for a flatten response.\"\"\"\n    def __init__(self, result: List[Any]) -> None:\n        self.result = result\n\n# --- src/flattenlist/flattener.py ---\nclass ListFlattener:\n    \"\"\"Core algorithm for flattening nested list-like structures.\"\"\"\n    def __init__(self, container_types: Tuple[type, ...] = DEFAULT_CONTAINER_TYPES) -> None:\n        self._container_types = container_types\n\n    def flatten(self, data: Any) -> List[Any]:\n        \"\"\"Flattens the provided data into a single list, preserving order.\"\"\"\n        out: List[Any] = []\n        self._flatten_iterative(data, out)\n        return out[::-1] # Reverse the output list to preserve original order\n\n    def _flatten_iterative(self, data: Any, out: List[Any]) -> None:\n        \"\"\"\n        Uses a stack-based iterative approach to flatten the structure.\n        Elements are appended to `out` in reverse discovery order, then reversed by `flatten` method.\n        \"\"\"\n        stack = [data]\n        while stack:\n            cur = stack.pop()\n            if is_string(cur):\n                out.append(cur)\n            elif is_iterable(cur, self._container_types):\n                # Push elements in reverse to process them in original order when popped\n                for item in reversed(cur):\n                    stack.append(item)\n            else:\n                # If it's an iterable but not in _container_types (e.g., dict, set, generator)\n                # or a non-iterable scalar that should be appended.\n                # Disallowed container types (dict, set, generator) should raise an error.\n                if isinstance(cur, (dict, set)) or (hasattr(cur, '__iter__') and not hasattr(cur, '__len__')): # Simple check for generators\n                    raise InvalidInputError(cur, f\"Disallowed container type encountered: {type(cur).__name__}\")\n                out.append(cur)\n\n# --- src/flattenlist/service.py ---\nclass FlattenService:\n    \"\"\"Orchestrates flattening operations and applies business rules.\"\"\"\n    def __init__(self, flattener: ListFlattener) -> None:\n        self._flattener = flattener\n\n    def flatten(self, request: FlattenRequest) -> FlattenResponse:\n        \"\"\"Processes a flatten request and returns the flattened result.\"\"\"\n        if not hasattr(request, 'data'):\n            raise InvalidInputError(request, \"FlattenRequest must contain 'data' attribute.\")\n        try:\n            result = self._flattener.flatten(request.data)\n            return FlattenResponse(result)\n        except InvalidInputError:\n            raise # Propagate specific input errors\n        except Exception as e:\n            raise FlattenError(f\"An unexpected error occurred: {e}\") from e\n\n# --- src/flattenlist/controller.py ---\nclass FlattenController:\n    \"\"\"Provides a programmatic API entrypoint and basic input validation.\"\"\"\n    def __init__(self, service: FlattenService) -> None:\n        self._service = service\n\n    def flatten_request(self, request: FlattenRequest) -> FlattenResponse:\n        \"\"\"Receives a FlattenRequest and delegates to the service for flattening.\"\"\"\n        if request.data is None:\n            # Design allows raising InvalidInputError for None as a design choice.\n            # Assuming None is not a valid top-level input to flatten (e.g., if you expect a list).\n            # If None should be flattened to [None], remove this check.\n            raise InvalidInputError(None, \"Input data cannot be None.\")\n        return self._service.flatten(request)\n\ndef flatten_list(data: Any) -> List[Any]:\n    \"\"\"\n    A convenience function to flatten a given nested list structure.\n    It wraps the core flattening logic with default configurations.\n    \"\"\"\n    _default_flattener = ListFlattener()\n    _default_service = FlattenService(_default_flattener)\n    _default_controller = FlattenController(_default_service)\n\n    req = FlattenRequest(data)\n    resp = _default_controller.flatten_request(req)\n    return resp.result"}
{"task_id": "Mbpp/296", "solution": "import sys\nfrom typing import List, Tuple, Optional, Dict, Any, Union\n\n# Define custom exceptions as per design.\nclass InvalidInputError(Exception):\n    \"\"\"Raised when input array is invalid.\"\"\"\n    pass\n\nclass ResourceLimitError(Exception):\n    \"\"\"Raised when resource limits (e.g., memory for pairs) are exceeded.\"\"\"\n    pass\n\n# utils.py - validate_array: Helper function for input validation.\ndef validate_array(arr: Any) -> None:\n    if not isinstance(arr, list):\n        raise InvalidInputError(\"Input must be a list.\")\n    if not all(isinstance(x, (int, float)) for x in arr):\n        raise InvalidInputError(\"All elements must be numbers.\")\n\n# models.py - ArrayModel: Wrapper for input arrays with validation.\nclass ArrayModel:\n    def __init__(self, numbers: List[Union[int, float]]) -> None:\n        validate_array(numbers)\n        self._numbers = list(numbers)\n\n    def __len__(self) -> int:\n        return len(self._numbers)\n\n    def as_list(self) -> List[Union[int, float]]:\n        return list(self._numbers)\n\n# dto.py - InversionResult: Data Transfer Object for inversion results.\nclass InversionResult:\n    def __init__(self, count: int, pairs: Optional[List[Tuple[int, int]]] = None, metadata: Optional[Dict[str, Any]] = None) -> None:\n        self.count = count\n        self.pairs = pairs if pairs is not None else []\n        self.metadata = metadata if metadata is not None else {}\n\n    def to_dict(self) -> Dict[str, Any]:\n        return {\n            \"count\": self.count,\n            \"pairs\": self.pairs,\n            \"metadata\": self.metadata\n        }\n\n    @classmethod\n    def from_dict(cls, d: Dict[str, Any]) -> \"InversionResult\":\n        return cls(d[\"count\"], d.get(\"pairs\"), d.get(\"metadata\"))\n\n# algorithms.py - MergeSortInversionCounter: Efficient O(n log n) inversion counting.\nclass MergeSortInversionCounter:\n    PAIR_COLLECTION_MEMORY_LIMIT = 10_000_000\n\n    def count_inversions(self, arr: List[Union[int, float]], return_pairs: bool = False) -> InversionResult:\n        model = ArrayModel(arr)\n        if not model.as_list():\n            return InversionResult(count=0, pairs=[] if return_pairs else None, metadata={\"input_length\": 0})\n\n        indexed_arr = [(value, i) for i, value in enumerate(model.as_list())]\n        \n        _, count, pairs = self._sort_and_count_indexed(indexed_arr, return_pairs)\n        \n        if return_pairs and pairs and len(pairs) > self.PAIR_COLLECTION_MEMORY_LIMIT:\n            raise ResourceLimitError(\"Too many inversion pairs to collect. Consider disabling pair collection.\")\n\n        return InversionResult(count=count, pairs=pairs if return_pairs else None, metadata={\"input_length\": len(model)})\n\n    def _sort_and_count_indexed(self, indexed_arr: List[Tuple[Union[int, float], int]], collect_pairs: bool) -> Tuple[List[Tuple[Union[int, float], int]], int, Optional[List[Tuple[int, int]]]]:\n        n = len(indexed_arr)\n        if n <= 1:\n            return indexed_arr, 0, [] if collect_pairs else None\n\n        mid = n // 2\n        left_half, left_inv_count, left_pairs = self._sort_and_count_indexed(indexed_arr[:mid], collect_pairs)\n        right_half, right_inv_count, right_pairs = self._sort_and_count_indexed(indexed_arr[mid:], collect_pairs)\n\n        merged_arr, merge_inv_count, merged_pairs = self._merge_and_count_indexed(left_half, right_half, collect_pairs)\n\n        total_inv_count = left_inv_count + right_inv_count + merge_inv_count\n        \n        total_pairs = []\n        if collect_pairs:\n            if left_pairs: total_pairs.extend(left_pairs)\n            if right_pairs: total_pairs.extend(right_pairs)\n            if merged_pairs: total_pairs.extend(merged_pairs)\n\n        return merged_arr, total_inv_count, total_pairs if collect_pairs else None\n\n    def _merge_and_count_indexed(self, left: List[Tuple[Union[int, float], int]], right: List[Tuple[Union[int, float], int]], collect_pairs: bool) -> Tuple[List[Tuple[Union[int, float], int]], int, Optional[List[Tuple[int, int]]]]:\n        merged_array = []\n        inversions = 0\n        pairs = [] if collect_pairs else None\n\n        i, j = 0, 0\n        while i < len(left) and j < len(right):\n            if left[i][0] <= right[j][0]:\n                merged_array.append(left[i])\n                i += 1\n            else:\n                merged_array.append(right[j])\n                inversions += (len(left) - i)\n                if collect_pairs:\n                    for k in range(i, len(left)):\n                        pairs.append((left[k][1], right[j][1]))\n                j += 1\n        \n        while i < len(left):\n            merged_array.append(left[i])\n            i += 1\n        \n        while j < len(right):\n            merged_array.append(right[j])\n            j += 1\n        \n        return merged_array, inversions, pairs\n\n# services.py - InversionService: Orchestrates validation and algorithm execution.\nclass InversionService:\n    def __init__(self, algorithm: MergeSortInversionCounter) -> None:\n        self.algorithm = algorithm\n\n    def count(self, arr: List[Union[int, float]], return_pairs: bool = False, persist: Optional[Dict[str, str]] = None) -> InversionResult:\n        result = self.algorithm.count_inversions(arr, return_pairs=return_pairs)\n        return result\n\ndef get_Inv_Count(arr: List[int]) -> int:\n    \"\"\"Counts inversions in an array using a merge-sort based algorithm.\"\"\"\n    # Instantiates the service and algorithm as per design context.\n    svc = InversionService(algorithm=MergeSortInversionCounter())\n    # Calls the service to count inversions, without collecting pairs for this API.\n    return svc.count(arr, return_pairs=False).count"}
{"task_id": "Mbpp/300", "solution": "def count_binary_seq(n: int) -> int:\n    \"\"\"\n    Calculates the count of binary sequences of length 2n where the sum of the first n bits\n    is the same as the sum of the last n bits, which is C(2n, n).\n    \"\"\"\n\n    def _comb(N: int, K: int) -> int:\n        \"\"\"Calculates N choose K (binomial coefficient) using an iterative method.\"\"\"\n        if K < 0 or K > N:\n            return 0\n        K = min(K, N - K)  # C(N, K) == C(N, N-K) optimization\n        if K == 0:\n            return 1\n        \n        res = 1\n        for i in range(K):\n            res = res * (N - i) // (i + 1)\n        return res\n\n    return _comb(2 * n, n)"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(data: list[tuple[str, int]]) -> tuple[str, int]:\n    \"\"\"\n    Calculates the maximum aggregate sum from a list of (name, value) tuples.\n    Returns the name with the highest total and its sum, using lexicographical order for tie-breaking.\n    \"\"\"\n    if not data:\n        # Per design context, in a full system this would raise EmptyInputError.\n        # For this specific function stub, an empty list might lead to an error\n        # if max() is called on an empty iterable, so we return a default or error.\n        # Given \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n        # and the assert implies valid input, we proceed without explicit empty handling\n        # unless it causes an uncaught error. A simple max() on an empty dict will fail,\n        # so we need to handle it gracefully for this function if it's possible.\n        # However, the prompt says \"no exceptions for edge cases\" which is conflicting\n        # with \"Raises EmptyInputError on empty input\" from the design context.\n        # Assuming valid, non-empty input for this completion based on \"no exceptions\".\n        # If it could be empty, returning an arbitrary default like (\"\", 0) or raising an error would be needed.\n        # Given the prompt's constraints, we'll proceed assuming `data` is not empty.\n        pass\n\n    totals = {}\n    for name, value in data:\n        totals[name] = totals.get(name, 0) + value\n\n    # Find the maximum total value\n    max_total = max(totals.values())\n\n    # Find all names that have this maximum total\n    candidates = [name for name, total in totals.items() if total == max_total]\n\n    # Apply deterministic tie-breaker: return the name that is lexicographically smallest\n    winner_name = min(candidates)\n\n    return (winner_name, max_total)"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(dictionary):\n    \"\"\"\n    Calculates the maximum nesting depth of a dictionary, including dictionaries found within list, tuple, or set values.\n    The depth starts at 1 for the root dictionary.\n    \"\"\"\n    \n    def _get_depth(current_dict, current_depth, visited_ids):\n        # Track object IDs to prevent infinite recursion on circular references.\n        obj_id = id(current_dict)\n        if obj_id in visited_ids:\n            return current_depth\n        visited_ids.add(obj_id)\n\n        max_depth_here = current_depth\n\n        for value in current_dict.values():\n            if isinstance(value, dict):\n                # Recurse for nested dictionaries.\n                max_depth_here = max(max_depth_here, _get_depth(value, current_depth + 1, visited_ids))\n            elif isinstance(value, (list, tuple, set)):\n                # Iterate through sequences to find dictionaries.\n                for item in value:\n                    if isinstance(item, dict):\n                        max_depth_here = max(max_depth_here, _get_depth(item, current_depth + 1, visited_ids))\n        \n        return max_depth_here\n\n    return _get_depth(dictionary, 1, set())"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr, n, i, k):\n    \"\"\"\n    Computes the maximum sum of an increasing subsequence from arr[0...i]\n    that also includes arr[k] (where k > i).\n    \"\"\"\n    \n    # dp[j] stores the maximum sum of an increasing subsequence ending at arr[j]\n    # for elements within the prefix arr[0...i].\n    dp = [0] * (i + 1)\n    \n    for j in range(i + 1):\n        dp[j] = arr[j] # Initialize with the element itself\n        for t in range(j):\n            if arr[t] < arr[j]:\n                dp[j] = max(dp[j], dp[t] + arr[j])\n    \n    # Find the maximum sum from dp[0...i] that can precede arr[k].\n    target_k_val = arr[k]\n    \n    max_prefix_sum = 0\n    found_suitable_prefix = False\n    \n    for j in range(i + 1):\n        if arr[j] < target_k_val:\n            found_suitable_prefix = True\n            max_prefix_sum = max(max_prefix_sum, dp[j])\n            \n    if found_suitable_prefix:\n        return max_prefix_sum + target_k_val\n    else:\n        # If no element in arr[0...i] is smaller than arr[k],\n        # the subsequence is just arr[k] itself.\n        return target_k_val"}
{"task_id": "Mbpp/305", "solution": "import re\nfrom typing import List, Tuple\n\nclass InvalidResultError(ValueError):\n    \"\"\"Exception raised when the required number of matching words is not found.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef start_withp(words: List[str]) -> Tuple[str, str]:\n    \"\"\"\n    Returns two words from a list of strings starting with the letter 'p' (case-insensitive).\n    Raises InvalidResultError if fewer than two matching words are found.\n    \"\"\"\n    matched_words = []\n    # Regex for word tokenization, derived from TOKEN_REGEX in design context.\n    TOKEN_REGEX = r\"[A-Za-z0-9\\+\\#\\-]+\" \n    REQUIRED_MATCHES = 2 \n\n    for line in words:\n        # Tokenize the line into words, similar to WordParser.parse_words.\n        tokens = re.findall(TOKEN_REGEX, line)\n        \n        for tok in tokens:\n            # Check if the word starts with 'p' or 'P', similar to StartWithPService._collect_matches.\n            if tok and tok[0].lower() == 'p':\n                matched_words.append(tok) \n                \n                if len(matched_words) == REQUIRED_MATCHES:\n                    return (matched_words[0], matched_words[1])\n\n    # Raise an error if insufficient matches are found.\n    raise InvalidResultError(f\"Expected {REQUIRED_MATCHES} words starting with 'p', but found {len(matched_words)}\")"}
{"task_id": "Mbpp/308", "solution": "```python\nimport heapq\n\ndef large_product(A, B, k):\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list using an optimized heap-based approach.\n    \"\"\"\n    if not A or not B or k <= 0:\n        return []\n\n    # Sort lists in descending order to easily find the largest products\n    A_sorted = sorted([float(x) for x in A], reverse=True)\n    B_sorted = sorted([float(x) for x in B], reverse=True)\n\n    results = []\n    # Max-heap to store (-product, index_a, index_b)\n    # Using negative product to simulate a max-heap with heapq (min-heap)\n    heap = []\n    \n    # Set to keep track of visited (index_a, index_b) pairs to avoid duplicates in the heap\n    visited = set()\n\n    def push_candidate(i, j):\n        if i < len(A_sorted) and j < len(B_sorted) and (i, j) not in visited:\n            product = A_sorted[i] * B_sorted[j]\n            heapq.heappush(heap, (-product, i, j))\n            visited.add((i, j))\n\n    # Start with the product of the largest elements\n    push_candidate(0, 0)\n\n    while heap and len(results) < k:\n        neg_prod, i, j = heapq.heappop(heap)\n        current_product = -neg_prod\n        results.append(current_product)\n\n        # Push the next potential candidates:\n        # 1. Product of the next largest element from A with the current element from B\n        push_candidate(i + 1, j)\n        # 2. Product of the current element from A with the next largest element from B\n        push_candidate(i, j + 1)\n        \n    return results\n```"}
