{"task_id": "Mbpp/785", "solution": "import re\nfrom typing import List, Tuple, Optional\n\n__version__ = \"0.1.0\"\n\nclass TupleParserError(Exception):\n    \"\"\"Custom exception for tuple parsing errors.\"\"\"\n    def __init__(self, message: str, position: Optional[int] = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.position = position\n\nclass StringSanitizer:\n    \"\"\"Normalizes and performs initial validation on the raw input string.\"\"\"\n    RE_TRAILING_COMMA_ALLOWED: bool = True\n\n    def is_parenthesized(self, raw: str) -> bool:\n        \"\"\"Checks if the string is enclosed in parentheses.\"\"\"\n        return isinstance(raw, str) and raw.strip().startswith(\"(\") and raw.strip().endswith(\")\")\n\n    def sanitize(self, raw: str) -> str:\n        \"\"\"Strips whitespace and outer parentheses, returning the inner content.\"\"\"\n        if not isinstance(raw, str):\n            raise TupleParserError(\"input must be a string\")\n        s = raw.strip()\n        if not self.is_parenthesized(s):\n            raise TupleParserError(\"expected input to be parenthesized like '(1, 2)'\")\n        inner = s[1:-1].strip()\n        return inner\n\n_INT_RE = re.compile(r'^[+-]?\\d+$')\n\nclass TupleParserService:\n    \"\"\"Core logic for parsing a sanitized tuple string into a tuple of integers.\"\"\"\n    MAX_TOKENS = 100000\n\n    def __init__(self, sanitizer: Optional[StringSanitizer] = None) -> None:\n        self.sanitizer = sanitizer or StringSanitizer()\n\n    def parse(self, raw: str) -> Tuple[int, ...]:\n        \"\"\"Parses the raw string into a tuple of integers.\"\"\"\n        inner = self.sanitizer.sanitize(raw)\n        if inner == \"\":\n            return tuple()\n        tokens = self._tokenize(inner)\n        if len(tokens) > self.MAX_TOKENS:\n            raise TupleParserError(\"too many tokens\")\n        ints: List[int] = []\n        for idx, t in enumerate(tokens):\n            ints.append(self._parse_token(t, idx))\n        return tuple(ints)\n\n    def _tokenize(self, inner: str) -> List[str]:\n        \"\"\"Splits the inner string by commas and handles whitespace.\"\"\"\n        parts = [p.strip() for p in inner.split(\",\")]\n        # Handle trailing comma producing last empty token\n        if parts and parts[-1] == \"\":\n            parts = parts[:-1]\n        if any(p == \"\" for p in parts):\n            raise TupleParserError(\"empty token found; malformed tuple string\")\n        return parts\n\n    def _parse_token(self, token: str, index: int) -> int:\n        \"\"\"Converts a single token string to an integer with validation.\"\"\"\n        if not _INT_RE.match(token):\n            raise TupleParserError(f\"invalid integer token: '{token}'\", position=index)\n        try:\n            return int(token)\n        except ValueError: # This should ideally not be reached if regex is strict enough\n            raise TupleParserError(f\"invalid integer token: '{token}'\", position=index)\n\nclass TupleParserController:\n    \"\"\"Public controller exposing programmatic entrypoints.\"\"\"\n    def __init__(self, service: Optional[TupleParserService] = None) -> None:\n        self.service = service or TupleParserService()\n\n    def parse(self, s: str) -> Tuple[int, ...]:\n        \"\"\"Validates input type and delegates parsing to the service.\"\"\"\n        if not isinstance(s, str):\n            raise TupleParserError(\"input must be a string\")\n        return self.service.parse(s)\n\ndef tuple_str_int(s: str) -> Tuple[int, ...]:\n    \"\"\"Converts a string representation of an integer tuple to an actual tuple of ints.\"\"\"\n    controller = TupleParserController()\n    return controller.parse(s)"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(nums: list, value) -> int:\n    \"\"\"\n    Locate the right insertion point for a specified value in sorted order.\n    This is equivalent to Python's `bisect.bisect_right`.\n    \"\"\"\n    lo = 0\n    hi = len(nums)\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if nums[mid] <= value:\n            lo = mid + 1\n        else:\n            hi = mid\n    return lo"}
