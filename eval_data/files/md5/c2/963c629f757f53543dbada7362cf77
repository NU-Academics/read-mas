{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(*lists):\n    \"\"\"\n    Converts multiple lists into a list of nested dictionaries.\n    The first list provides outer keys, and subsequent lists form inner keys and final values.\n    \"\"\"\n    length = len(lists[0])\n    results = []\n\n    for i in range(length):\n        items_at_index = tuple(lst[i] for lst in lists)\n        \n        outer_key = str(items_at_index[0])\n        \n        if len(items_at_index) == 2:\n            # Case: {outer_key: value}\n            nested_value = items_at_index[1]\n            current_nested_dict = {outer_key: nested_value}\n        else:\n            # Case: {outer_key: {inner_key1: {inner_key2: ... : final_value}}}\n            final_value = items_at_index[-1]\n            \n            current_inner_nest = final_value\n            \n            # Build the inner nested dictionary from right to left\n            for j in range(len(items_at_index) - 2, 0, -1):\n                inner_key = items_at_index[j]\n                current_inner_nest = {str(inner_key): current_inner_nest}\n            \n            current_nested_dict = {outer_key: current_inner_nest}\n            \n        results.append(current_nested_dict)\n            \n    return results"}
{"task_id": "Mbpp/395", "solution": "def first_non_repeating_character(s: str) -> str | None:\n    \"\"\"\n    Finds the first non-repeated character in a string using a two-pass approach.\n    Counts character occurrences and then iterates to find the first character with a count of one.\n    \"\"\"\n    char_counts = {}\n    for char in s:\n        char_counts[char] = char_counts.get(char, 0) + 1\n\n    for char in s:\n        if char_counts[char] == 1:\n            return char\n            \n    return None"}
{"task_id": "Mbpp/392", "solution": "import functools\n\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Computes the maximum sum f(n) = max(n, f(n/2) + f(n/3) + f(n/4) + f(n/5)) using memoization.\n    It takes a non-negative integer n and returns the calculated maximum sum.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    divisors = (2, 3, 4, 5)\n\n    @functools.lru_cache(maxsize=None)\n    def _compute_recursive(current_n: int) -> int:\n        if current_n == 0:\n            return 0\n        \n        parts_sum = sum(_compute_recursive(current_n // d) for d in divisors)\n        return max(current_n, parts_sum)\n\n    return _compute_recursive(n)"}
{"task_id": "Mbpp/397", "solution": "def median_numbers(a: float, b: float, c: float) -> float:\n    \"\"\"Calculates the median of three numbers using minimal comparisons.\"\"\"\n    if (a <= b <= c) or (c <= b <= a):\n        return float(b)\n    if (b <= a <= c) or (c <= a <= b):\n        return float(a)\n    return float(c)"}
{"task_id": "Mbpp/394", "solution": "def check_distinct(t: Tuple[Any, ...]) -> bool:\n    \"\"\"\n    Checks if the given tuple contains no duplicate elements.\n    Uses O(N) set-based comparison for hashable elements and\n    falls back to O(N^2) list-based comparison for unhashable elements.\n    \"\"\"\n    \n    def is_hashable(item: Any) -> bool:\n        \"\"\"Helper to check if an item is hashable by attempting to hash it.\"\"\"\n        try:\n            hash(item)\n            return True\n        except TypeError:\n            return False\n\n    all_hashable = True\n    for item in t:\n        if not is_hashable(item):\n            all_hashable = False\n            break\n\n    if all_hashable:\n        return len(t) == len(set(t))\n    else:\n        seen = []\n        for item in t:\n            if item in seen:\n                return False\n            seen.append(item)\n        return True"}
{"task_id": "Mbpp/404", "solution": "def minimum(a: int | float, b: int | float) -> int | float:\n    \"\"\"Finds the minimum of two numbers.\n\n    Compares two numeric values and returns the smaller one.\"\"\"\n    if a <= b:\n        return a\n    else:\n        return b"}
{"task_id": "Mbpp/405", "solution": "from typing import Any, Callable, Iterable\n\nclass InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\ndef validate_tuple(value: Any) -> tuple:\n    \"\"\"Ensures value is a tuple; raises InvalidInputError otherwise.\"\"\"\n    if not isinstance(value, tuple):\n        raise InvalidInputError(\"Expected a tuple\")\n    return value\n\nclass TupleQuery:\n    def __init__(self, data: tuple, element: Any) -> None:\n        self.data = data\n        self.element = element\n\nclass TupleResult:\n    def __init__(self, found: bool, element: Any, container_size: int) -> None:\n        self.found = found\n        self.element = element\n        self.container_size = container_size\n\nclass TuplexRepository:\n    def __init__(self, data: tuple) -> None:\n        self._data = data\n\n    def iter(self) -> Iterable[Any]:\n        \"\"\"Returns an iterator over the stored tuple data.\"\"\"\n        return iter(self._data)\n\n    def __len__(self) -> int:\n        return len(self._data)\n\n    def get_data(self) -> tuple:\n        \"\"\"Returns the underlying tuple data.\"\"\"\n        return self._data\n\nclass TuplexService:\n    def __init__(self, repository_factory: Callable[[tuple], TuplexRepository]) -> None:\n        self.repository_factory = repository_factory\n\n    def check_membership(self, query: TupleQuery) -> TupleResult:\n        \"\"\"Checks if an element exists within the tuple provided by the query.\"\"\"\n        repo = self.repository_factory(query.data)\n        for item in repo.iter():\n            if item == query.element:\n                return TupleResult(found=True, element=query.element, container_size=len(repo))\n        return TupleResult(found=False, element=query.element, container_size=len(repo))\n\nclass TuplexController:\n    def __init__(self, service: TuplexService) -> None:\n        self.service = service\n\n    def check(self, data: Any, element: Any) -> bool:\n        \"\"\"Validates inputs, calls the service, and returns a boolean result.\"\"\"\n        validated_data = validate_tuple(data)\n        query = TupleQuery(validated_data, element)\n        result = self.service.check_membership(query)\n        return result.found\n\ndef check_tuplex(tuplex: tuple, element: Any) -> bool:\n    \"\"\"\n    Checks if an element exists within a tuple.\n    \"\"\"\n    service = TuplexService(repository_factory=TuplexRepository)\n    controller = TuplexController(service)\n    return controller.check(tuplex, element)"}
{"task_id": "Mbpp/398", "solution": "def sum_of_digits(numbers: list) -> int:\n    \"\"\"\n    Computes the total sum of digits for all numbers in a given list.\n    Negative numbers are treated by taking their absolute value for digit-sum computation.\n    \"\"\"\n\n    def _sum_digits_single_number(n: int) -> int:\n        \"\"\"\n        Returns the sum of decimal digits of the absolute value of n.\n        \"\"\"\n        n = abs(int(n))\n        total = 0\n        if n == 0:\n            return 0\n        while n:\n            total += n % 10\n            n //= 10\n        return total\n\n    total_sum_all_numbers = 0\n    for num in numbers:\n        total_sum_all_numbers += _sum_digits_single_number(num)\n    return total_sum_all_numbers"}
{"task_id": "Mbpp/406", "solution": "def find_Parity(number):\n    \"\"\"\n    Determines whether the parity of a given number is odd.\n    Returns True if the number is odd, False otherwise.\n    \"\"\"\n    return number % 2 != 0"}
{"task_id": "Mbpp/409", "solution": "from typing import Iterable, Tuple, Union\n\nNumber = Union[int, float]\n\ndef min_product_tuple(pairs: Iterable[Tuple[Number, Number]]) -> Number:\n    \"\"\"\n    Finds the minimum product from the pairs of tuples within a given list.\n    Assumes input `pairs` contains 2-element numeric tuples; raises ValueError if empty.\n    \"\"\"\n    products_generator = (a * b for a, b in pairs)\n\n    it = iter(products_generator)\n    try:\n        # Initialize min_product_val with the first product\n        min_product_val = next(it)\n    except StopIteration:\n        # Handles the edge case of an empty input iterable\n        raise ValueError(\"Input list of pairs cannot be empty.\")\n\n    # Iterate through the remaining products to find the minimum\n    for product in it:\n        if product < min_product_val:\n            min_product_val = product\n\n    return min_product_val"}
{"task_id": "Mbpp/412", "solution": "def remove_odd(numbers: list[int]) -> list[int]:\n    \"\"\"\n    Removes odd numbers from a list of integers, returning a new list.\n    The original list is not modified, and the order of even numbers is preserved.\n    \"\"\"\n    return [n for n in numbers if n % 2 == 0]"}
{"task_id": "Mbpp/413", "solution": "def extract_nth_element(items, n):\n    \"\"\"\n    Extracts the nth element from each tuple in a list of tuples.\n    Assumes `items` is a list of tuples and `n` is a valid integer index.\n    \"\"\"\n    return [t[n] for t in items]"}
{"task_id": "Mbpp/410", "solution": "import os\nimport json\nimport datetime\nfrom decimal import Decimal, InvalidOperation\nfrom fractions import Fraction\nfrom typing import Any, List, Dict, Union\nfrom pathlib import Path\n\ntry:\n    import fcntl\n    _HAS_FCNTL = True\nexcept ImportError:\n    _HAS_FCNTL = False\n\nclass InvalidInputError(Exception):\n    \"\"\"Raised when the input is not iterable or invalid parameters are provided.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass NoNumericValueError(Exception):\n    \"\"\"Raised when no numeric values are found in the input list.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass PersistenceError(Exception):\n    \"\"\"Raised on storage failure during history operations.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass ComputationRequest:\n    \"\"\"Data Transfer Object for computation requests.\"\"\"\n    def __init__(self, input_values: List[Any]):\n        self.input_values = input_values\n\nclass ComputationResult:\n    \"\"\"Data Transfer Object for computation results, including metadata.\"\"\"\n    def __init__(self, value: Decimal, timestamp: datetime.datetime, input_summary: str):\n        self.value = value\n        self.timestamp = timestamp\n        self.input_summary = input_summary\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Converts the result to a JSON-serializable dictionary.\"\"\"\n        return {\n            \"value\": str(self.value),\n            \"timestamp\": self.timestamp.isoformat(),\n            \"input_summary\": self.input_summary,\n        }\n\n    @classmethod\n    def from_dict(cls, data: Dict[str, Any]) -> \"ComputationResult\":\n        \"\"\"Creates a ComputationResult object from a dictionary.\"\"\"\n        return cls(\n            value=Decimal(data[\"value\"]),\n            timestamp=datetime.datetime.fromisoformat(data[\"timestamp\"]),\n            input_summary=data[\"input_summary\"],\n        )\n\nclass NumberFilter:\n    \"\"\"Utility for detecting and converting numeric types.\"\"\"\n    supported_types = (int, float, Decimal, Fraction)\n\n    def is_numeric(self, obj: Any, allow_numeric_strings: bool = False) -> bool:\n        \"\"\"Checks if an object is a numeric type or a numeric string (if allowed).\"\"\"\n        if isinstance(obj, bool):\n            return False\n        if isinstance(obj, self.supported_types):\n            return True\n        if allow_numeric_strings and isinstance(obj, str):\n            try:\n                Decimal(obj)\n                return True\n            except InvalidOperation:\n                return False\n        return False\n\n    def to_decimal(self, obj: Any) -> Decimal:\n        \"\"\"Converts an object to Decimal, handling various numeric types and strings.\"\"\"\n        if isinstance(obj, Decimal):\n            return obj\n        if isinstance(obj, Fraction):\n            return Decimal(obj.numerator) / Decimal(obj.denominator)\n        if isinstance(obj, int) and not isinstance(obj, bool):\n            return Decimal(obj)\n        if isinstance(obj, float):\n            return Decimal(str(obj))\n        if isinstance(obj, str):\n            return Decimal(obj)\n        raise ValueError(f\"Unsupported numeric type for conversion: {type(obj)}\")\n\nclass ListRepository:\n    \"\"\"Handles persistence of computation results to a JSON file.\"\"\"\n    DEFAULT_ENCODING = \"utf-8\"\n\n    def __init__(self, storage_path: str, max_records: int = 1000):\n        self._storage_path = Path(storage_path)\n        self._max_records = max_records\n        self._storage_path.parent.mkdir(parents=True, exist_ok=True)\n\n    def _acquire_lock(self, file_obj):\n        \"\"\"Acquire an exclusive lock on the file if fcntl is available.\"\"\"\n        if _HAS_FCNTL:\n            try:\n                fcntl.flock(file_obj, fcntl.LOCK_EX)\n            except OSError:\n                pass \n\n    def _release_lock(self, file_obj):\n        \"\"\"Release the lock on the file if fcntl is available.\"\"\"\n        if _HAS_FCNTL:\n            try:\n                fcntl.flock(file_obj, fcntl.LOCK_UN)\n            except OSError:\n                pass \n\n    def save_result(self, result: ComputationResult) -> None:\n        \"\"\"Appends a new record to history, maintaining bounded length, with atomic write.\"\"\"\n        try:\n            history = self.load_history()\n            history.append(result)\n            \n            if len(history) > self._max_records:\n                history = history[-self._max_records:]\n\n            temp_path = self._storage_path.with_suffix(\".tmp\")\n            \n            with open(temp_path, 'w', encoding=self.DEFAULT_ENCODING) as f:\n                self._acquire_lock(f)\n                json.dump([r.to_dict() for r in history], f, indent=2)\n                self._release_lock(f)\n            os.replace(temp_path, self._storage_path)\n\n        except Exception as e:\n            raise PersistenceError(f\"Failed to save computation result: {e}\") from e\n\n    def load_history(self) -> List[ComputationResult]:\n        \"\"\"Loads records from JSON into ComputationResult objects, returning an empty list if file absent.\"\"\"\n        if not self._storage_path.exists():\n            return []\n        \n        try:\n            with open(self._storage_path, 'r', encoding=self.DEFAULT_ENCODING) as f:\n                self._acquire_lock(f)\n                data = json.load(f)\n                self._release_lock(f)\n            return [ComputationResult.from_dict(d) for d in data]\n        except (json.JSONDecodeError, FileNotFoundError, TypeError, ValueError) as e:\n            return []\n        except Exception as e:\n            raise PersistenceError(f\"Failed to load history: {e}\") from e\n\nclass MinValueService:\n    \"\"\"Core domain logic to compute minimum from heterogeneous lists.\"\"\"\n    def __init__(self, filter: NumberFilter, repository: Union[ListRepository, None] = None):\n        self.filter = filter\n        self.repository = repository\n\n    def compute_min(self, values: List[Any], allow_numeric_strings: bool = False) -> Decimal:\n        \"\"\"\n        Iterates over values, uses NumberFilter to detect/convert numeric values,\n        computes and returns min as Decimal, and optionally persists the result.\n        \"\"\"\n        if not hasattr(values, '__iter__'):\n            raise InvalidInputError(\"Input is not iterable\")\n\n        min_val_found = None\n        for v in values:\n            if self.filter.is_numeric(v, allow_numeric_strings=allow_numeric_strings):\n                try:\n                    dec = self.filter.to_decimal(v)\n                    if min_val_found is None or dec < min_val_found:\n                        min_val_found = dec\n                except ValueError:\n                    pass \n        \n        if min_val_found is None:\n            raise NoNumericValueError(\"No numeric value found in input\")\n        \n        result = ComputationResult(value=min_val_found, timestamp=datetime.datetime.utcnow(), input_summary=f\"len={len(values)}\")\n        if self.repository:\n            try:\n                self.repository.save_result(result)\n            except Exception: \n                pass \n        return min_val_found\n\nclass OutputAdapter:\n    \"\"\"Formats computation results into human-readable strings.\"\"\"\n    def format_result(self, result: ComputationResult) -> str:\n        \"\"\"Returns a formatted string for the computation result.\"\"\"\n        timestamp_str = result.timestamp.isoformat(timespec='seconds')\n        return f\"Minimum: {result.value} (computed at {timestamp_str}Z)\"\n\nclass MinValueController:\n    \"\"\"Orchestrates API calls, input validation, and uses services/adapters.\"\"\"\n    def __init__(self, service: MinValueService, output_adapter: OutputAdapter):\n        self.service = service\n        self.output_adapter = output_adapter\n\n    def min_from_list(self, values: List[Any], allow_numeric_strings: bool = False) -> Decimal:\n        \"\"\"Validates input and delegates to the service to compute the minimum.\"\"\"\n        if not isinstance(values, list):\n            raise InvalidInputError(\"Input must be a list.\")\n        return self.service.compute_min(values, allow_numeric_strings=allow_numeric_strings)\n\n_default_repository = ListRepository(storage_path=\"./data/minfinder_history.json\")\n_default_filter = NumberFilter()\n_default_service = MinValueService(filter=_default_filter, repository=_default_repository)\n_default_controller = MinValueController(service=_default_service, output_adapter=OutputAdapter())\n\ndef min_val(values: list, allow_numeric_strings: bool = False) -> Decimal:\n    \"\"\"\n    Finds the minimum numeric value in a heterogeneous list.\n    Delegates to the default controller and service for computation and optional persistence.\n    \"\"\"\n    return _default_controller.min_from_list(values, allow_numeric_strings=allow_numeric_strings)"}
{"task_id": "Mbpp/418", "solution": "def Find_Max(input_list):\n    \"\"\"\n    Finds the element in a list that has the maximum length.\n    If multiple elements have the same maximum length, the first one encountered is returned.\n    \"\"\"\n    if not input_list:\n        return None # Or handle as per broader context, but the prompt says no error handling. Assuming non-empty per assert.\n\n    max_len_element = input_list[0]\n    max_length = len(input_list[0])\n\n    for element in input_list[1:]:\n        current_length = len(element)\n        if current_length > max_length:\n            max_length = current_length\n            max_len_element = element\n            \n    return max_len_element"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the cube sum of the first n even natural numbers using a closed-form formula.\n    The formula is 2 * n^2 * (n+1)^2.\n    \"\"\"\n    return 2 * (n * n) * ((n + 1) * (n + 1))"}
{"task_id": "Mbpp/419", "solution": "def round_and_sum(numbers):\n    \"\"\"\n    Rounds each number in a list using Python's built-in round semantics,\n    then calculates the total sum multiplied by the list's length.\n    Returns 0 for an empty list.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    rounded_numbers = [int(round(x)) for x in numbers]\n    sum_of_rounded = sum(rounded_numbers)\n    result = sum_of_rounded * len(numbers)\n    return result"}
{"task_id": "Mbpp/414", "solution": "def overlapping(list1, list2):\n    \"\"\"\n    Checks if any value in list1 exists in list2, or vice versa, efficiently.\n    It attempts a hash set approach for O(N+M) performance, falling back to O(N*M) nested loops for unhashable items.\n    \"\"\"\n    # Optimize by making the first list the smaller one, if possible, for set creation efficiency.\n    if len(list1) > len(list2):\n        list1, list2 = list2, list1\n\n    try:\n        # Attempt to create a set from the potentially smaller list for fast lookups.\n        set1 = set(list1)\n        for item in list2:\n            if item in set1:\n                return True\n    except TypeError:\n        # If any item in list1 is unhashable, fall back to a nested loop comparison.\n        for item1 in list1:\n            for item2 in list2:\n                if item1 == item2:\n                    return True\n    return False"}
{"task_id": "Mbpp/415", "solution": "def max_Product(arr: list[int]) -> tuple[int, int]:\n    \"\"\"\n    Finds a pair with the highest product from a given array of integers.\n    The returned tuple's elements are sorted (smaller, larger).\n    \"\"\"\n    # Initialize variables to track the two largest and two smallest numbers encountered.\n    # Using float('inf') for initial comparison values works correctly with integers in Python.\n    max1 = -float('inf')  # The largest number\n    max2 = -float('inf')  # The second largest number\n    min1 = float('inf')   # The smallest number (most negative)\n    min2 = float('inf')   # The second smallest number\n\n    for x in arr:\n        # Update largest numbers\n        if x >= max1:\n            max2 = max1\n            max1 = x\n        elif x > max2:\n            max2 = x\n\n        # Update smallest numbers\n        if x <= min1:\n            min2 = min1\n            min1 = x\n        elif x < min2:\n            min2 = x\n\n    # Candidate pairs for the highest product:\n    # 1. The pair of two largest numbers (if they are positive)\n    candidate_pos = (max1, max2)\n    # 2. The pair of two smallest numbers (if they are both negative, their product will be positive)\n    candidate_neg = (min1, min2)\n\n    # Calculate products of the candidate pairs\n    prod_pos = int(candidate_pos[0] * candidate_pos[1]) # Cast to int to handle -inf/-inf multiplication if input array empty/small\n    prod_neg = int(candidate_neg[0] * candidate_neg[1]) # The problem context guarantees length >= 2, so actual inf values shouldn't be multiplied\n\n    best_pair = None\n    # Compare products to find the primary winner\n    if prod_pos != prod_neg:\n        best_pair = candidate_pos if prod_pos > prod_neg else candidate_neg\n    else:\n        # Products are equal, apply tie-breaking rules\n        # Tie-breaker 1: Choose the pair with the larger maximum element\n        max_elem_pos = max(candidate_pos)\n        max_elem_neg = max(candidate_neg)\n        if max_elem_pos != max_elem_neg:\n            best_pair = candidate_pos if max_elem_pos > max_elem_neg else candidate_neg\n        else:\n            # Tie-breaker 2: Choose the pair with the larger sum\n            sum_pos = candidate_pos[0] + candidate_pos[1]\n            sum_neg = candidate_neg[0] + candidate_neg[1]\n            if sum_pos != sum_neg:\n                best_pair = candidate_pos if sum_pos > sum_neg else candidate_neg\n            else:\n                # Final tie-breaker: Choose lexicographically smaller tuple\n                # This ensures deterministic behavior if all other criteria are equal.\n                best_pair = candidate_pos if candidate_pos <= candidate_neg else candidate_neg\n    \n    # Return the chosen pair with its elements sorted (smaller, larger)\n    return (min(best_pair), max(best_pair))"}
{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n):\n    \"\"\"\n    Calculates the average of cubes of the first n natural numbers using a closed-form formula.\n    The sum of cubes is (n*(n+1)/2)^2, and the average is this sum divided by n.\n    \"\"\"\n    sum_of_natural_numbers = n * (n + 1) // 2\n    sum_of_cubes = sum_of_natural_numbers * sum_of_natural_numbers\n    return sum_of_cubes / float(n)"}
{"task_id": "Mbpp/421", "solution": "def concatenate_tuple(elements: tuple, delimiter: str = \"-\") -> str:\n    \"\"\"Concatenates elements of a tuple into a single string using a specified delimiter.\n    Non-string elements are converted to their string representation before joining.\n    \"\"\"\n    string_elements = [str(element) for element in elements]\n    return delimiter.join(string_elements)"}
{"task_id": "Mbpp/424", "solution": "from typing import Tuple, List, Any\n\nclass InputValidationError(Exception):\n    \"\"\"Custom exception for invalid input scenarios.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass StringUtils:\n    \"\"\"Utility class for string operations.\"\"\"\n    DEFAULT_ENCODING = \"utf-8\"\n\n    def last_char(self, s: str) -> str:\n        \"\"\"Returns the last character of a non-empty string.\"\"\"\n        return s[-1]\n\n    def is_non_empty_string(self, s: Any) -> bool:\n        \"\"\"Checks if the given value is a non-empty string.\"\"\"\n        return isinstance(s, str) and len(s) > 0\n\nclass TupleValidator:\n    \"\"\"Validates the input tuple and its elements.\"\"\"\n    def __init__(self) -> None:\n        self._utils = StringUtils()\n\n    def validate(self, values: Tuple[str, ...]) -> None:\n        \"\"\"Ensures input is a tuple of non-empty strings, raising InputValidationError otherwise.\"\"\"\n        if not isinstance(values, tuple):\n            raise InputValidationError(\"input must be a tuple\")\n        for i, v in enumerate(values):\n            if not isinstance(v, str):\n                raise InputValidationError(f\"element at index {i} is not a str\")\n            if not self._utils.is_non_empty_string(v):\n                raise InputValidationError(f\"element at index {i} is empty\")\n\nclass ExtractionService:\n    \"\"\"Core business logic for extracting last characters.\"\"\"\n    def __init__(self, validator: TupleValidator) -> None:\n        self._validator = validator\n        self._utils = StringUtils()\n\n    def extract_last_chars(self, values: Tuple[str, ...]) -> List[str]:\n        \"\"\"Validates input and extracts the last character from each string.\"\"\"\n        self._validator.validate(values)\n        chars = [self._utils.last_char(s) for s in values]\n        return chars\n\nclass ExtractController:\n    \"\"\"Public API controller for the extraction functionality.\"\"\"\n    def __init__(self, service: ExtractionService) -> None:\n        self._service = service\n\n    def extract_rear(self, values: Tuple[str, ...]) -> List[str]:\n        \"\"\"Delegates to the extraction service to get the rear characters.\"\"\"\n        return self._service.extract_last_chars(values)\n\ndef extract_rear(values: Tuple[str, ...]) -> List[str]:\n    \"\"\"Extracts the rear (last) index element of each string in the given tuple.\"\"\"\n    validator = TupleValidator()\n    service = ExtractionService(validator)\n    controller = ExtractController(service)\n    return controller.extract_rear(values)"}
