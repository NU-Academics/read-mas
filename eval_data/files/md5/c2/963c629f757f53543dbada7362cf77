{"task_id": "Mbpp/256", "solution": "import math\n\ndef count_Primes_nums(n):\n    \"\"\"\n    Counts the number of prime numbers strictly less than n.\n    Utilizes the Sieve of Eratosthenes algorithm for efficiency.\n    \"\"\"\n    if n <= 2:\n        return 0\n\n    sieve = bytearray(b'\\x01') * n\n    sieve[0:2] = b'\\x00\\x00' # 0 and 1 are not prime\n\n    for p in range(2, int(math.isqrt(n - 1)) + 1):\n        if sieve[p]:\n            step = p\n            start = p * p\n            # Mark multiples of p as not prime\n            sieve[start:n:step] = b'\\x00' * ((n - 1 - start) // step + 1)\n            \n    return sum(sieve)"}
{"task_id": "Mbpp/259", "solution": "def maximize_elements(a, b):\n    \"\"\"\n    Maximizes two sequences of tuples element-wise, returning a new tuple of tuples.\n    \"\"\"\n    result = []\n    for inner_tuple_a, inner_tuple_b in zip(a, b):\n        max_inner_elements = tuple(max(x, y) for x, y in zip(inner_tuple_a, inner_tuple_b))\n        result.append(max_inner_elements)\n    return tuple(result)"}
{"task_id": "Mbpp/261", "solution": "class DivisionError(Exception):\n    \"\"\"Base exception for division operations.\"\"\"\n    pass\n\nclass LengthMismatchError(DivisionError):\n    \"\"\"Raised when tuple lengths do not match.\"\"\"\n    pass\n\nclass DivisionByZeroError(DivisionError):\n    \"\"\"Raised when division by zero occurs.\"\"\"\n    pass\n\nclass InvalidElementError(DivisionError):\n    \"\"\"Raised when an invalid element type is found.\"\"\"\n    pass\n\n\ndef division_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise mathematical division on two tuples.\n    Normalizes float results to int if they are mathematically exact integers.\n    \"\"\"\n    # Constant for float comparison, used to determine if a float is an exact integer.\n    EPS = 1e-12\n\n    # Validate inputs as per InputValidator's responsibilities.\n    if not isinstance(a, tuple) or not isinstance(b, tuple):\n        raise InvalidElementError(\"Inputs must be tuples\")\n    if len(a) != len(b):\n        raise LengthMismatchError(\"Tuples must be the same length\")\n\n    # Validate all elements are numeric (int or float).\n    for x in a + b:\n        if not isinstance(x, (int, float)):\n            raise InvalidElementError(f\"Invalid element type found: {x!r}. Elements must be int or float.\")\n    \n    # Handles empty tuples as a valid case, returning an empty tuple.\n    if not a:\n        return tuple()\n\n    # Perform element-wise division and normalization as per DividerService and DivisionResult.\n    results = []\n    for numerator, denominator in zip(a, b):\n        if denominator == 0:\n            raise DivisionByZeroError(\"Division by zero for divisor: 0\")\n        \n        intermediate_result = numerator / denominator\n        \n        # Normalize the result: convert to int if it's an exact integer, otherwise keep as float.\n        if abs(intermediate_result - round(intermediate_result)) < EPS:\n            results.append(int(round(intermediate_result)))\n        else:\n            results.append(float(intermediate_result))\n            \n    return tuple(results)"}
{"task_id": "Mbpp/260", "solution": "def newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the nth Newman\u2013Shanks\u2013Williams number.\n    This function computes S_n where S0=1, S1=1, S_n = 2*S_{n-1} + S_{n-2}.\n    \"\"\"\n\n    if n <= 1:\n        return 1\n\n    class MatrixPower:\n        \"\"\"Helper for 2x2 matrix operations required for sequence computation.\"\"\"\n        def multiply(self, a, b):\n            return (\n                (a[0][0] * b[0][0] + a[0][1] * b[1][0], a[0][0] * b[0][1] + a[0][1] * b[1][1]),\n                (a[1][0] * b[0][0] + a[1][1] * b[1][0], a[1][0] * b[0][1] + a[1][1] * b[1][1])\n            )\n\n        def pow_matrix(self, matrix, exp):\n            \"\"\"Computes matrix^exp using exponentiation by squaring.\"\"\"\n            result = ((1, 0), (0, 1))  # Identity matrix\n            base = matrix\n            while exp > 0:\n                if exp % 2 == 1:\n                    result = self.multiply(result, base)\n                base = self.multiply(base, base)\n                exp //= 2\n            return result\n        \n        def recurrence_matrix(self):\n            return ((2, 1), (1, 0))\n\n    matrix_power_instance = MatrixPower()\n\n    # The recurrence relation [[S_n], [S_{n-1}]] = M^(n-1) * [[S1], [S0]]\n    # where M = [[2,1],[1,0]] and S0=1, S1=1.\n    M = matrix_power_instance.recurrence_matrix()\n    M_pow_n_minus_1 = matrix_power_instance.pow_matrix(M, n - 1)\n\n    # S_n = M_pow_n_minus_1[0][0] * S1 + M_pow_n_minus_1[0][1] * S0\n    # Since S1=1 and S0=1, this simplifies to the sum of the top row elements.\n    S_n = M_pow_n_minus_1[0][0] + M_pow_n_minus_1[0][1]\n\n    return S_n"}
