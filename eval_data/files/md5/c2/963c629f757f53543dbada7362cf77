{"task_id": "Mbpp/427", "solution": "from dataclasses import dataclass\nimport re\nimport datetime\n\nclass ValidationError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n    def __str__(self) -> str:\n        return self.message\n\n@dataclass(frozen=True)\nclass DateModel:\n    year: int\n    month: int\n    day: int\n\n    def __post_init__(self) -> None:\n        if not (1 <= self.month <= 12):\n            raise ValueError(\"month must be in 1..12\")\n        if not (1 <= self.day <= 31):\n            raise ValueError(\"day must be in 1..31\")\n\nDATE_REGEX = re.compile(r'^\\d{4}-\\d{2}-\\d{2}$')\n\nclass DateParser:\n    def parse(self, date_str: str) -> DateModel:\n        if not DATE_REGEX.match(date_str):\n            raise ValidationError(\"Date must be a string in format YYYY-MM-DD\")\n        year_s, month_s, day_s = date_str.split(\"-\")\n        year, month, day = int(year_s), int(month_s), int(day_s)\n        try:\n            datetime.date(year, month, day)\n        except ValueError as e:\n            raise ValidationError(f\"Invalid date: {e}\")\n        return DateModel(year=year, month=month, day=day)\n\nOUTPUT_FORMAT = \"{:02d}-{:02d}-{:04d}\"\n\nclass DateFormatter:\n    def format(self, date: DateModel) -> str:\n        return OUTPUT_FORMAT.format(date.day, date.month, date.year)\n\nclass DateService:\n    def __init__(self, parser: DateParser = None, formatter: DateFormatter = None) -> None:\n        self.parser = parser or DateParser()\n        self.formatter = formatter or DateFormatter()\n\n    def change_date_format(self, date_str: str) -> str:\n        date = self.parser.parse(date_str)\n        return self.formatter.format(date)\n\nclass DateController:\n    def __init__(self, service: DateService = None) -> None:\n        self.service = service or DateService()\n\n    def change_date_format(self, date_str: str) -> str:\n        if not isinstance(date_str, str):\n            raise ValidationError(\"Input must be a string\")\n        return self.service.change_date_format(date_str)\n\n_controller = DateController()\n\ndef change_date_format(date_str: str) -> str:\n    \"\"\"Converts a date string from 'yyyy-mm-dd' to 'dd-mm-yyyy' format.\"\"\"\n    return _controller.change_date_format(date_str)"}
{"task_id": "Mbpp/428", "solution": "from typing import List, TypeVar, Sequence\n\nT = TypeVar(\"T\")\n\ndef shell_sort(data: Sequence[T]) -> List[T]:\n    \"\"\"Sorts a list using the Shell Sort algorithm with Knuth gap sequence.\"\"\"\n    arr = list(data)  # Create a mutable copy to avoid modifying the original sequence\n    n = len(arr)\n\n    if n <= 1:\n        return arr\n\n    # Generate Knuth gap sequence (1, 4, 13, 40, ...) and reverse it\n    gaps = []\n    h = 1\n    while h < n:\n        gaps.append(h)\n        h = 3 * h + 1\n    gaps.reverse()\n\n    # Perform gapped insertion sort for each gap\n    for gap in gaps:\n        for i in range(gap, n):\n            temp = arr[i]\n            j = i\n            # Shift elements for the current gap\n            while j >= gap and arr[j - gap] > temp:\n                arr[j] = arr[j - gap]\n                j -= gap\n            arr[j] = temp\n    return arr"}
{"task_id": "Mbpp/426", "solution": "from typing import List, Union\n\ndef filter_oddnumbers(numbers: List[Union[int, float, str]]) -> List[int]:\n    \"\"\"Filters a list of numbers, returning only the odd integers.\n    Assumes all input elements can be converted to an integer.\n    \"\"\"\n    odd_numbers = []\n    for num in numbers:\n        int_value = int(num)\n        if abs(int_value) % 2 == 1:\n            odd_numbers.append(int_value)\n    return odd_numbers"}
{"task_id": "Mbpp/429", "solution": "def and_tuples(a: Tuple[int, ...], b: Tuple[int, ...]) -> Tuple[int, ...]:\n    \"\"\"\n    Computes the element-wise bitwise AND of two tuples of integers.\n    Assumes inputs are of equal length and contain only integers.\n    \"\"\"\n    return tuple(x & y for x, y in zip(a, b))"}
