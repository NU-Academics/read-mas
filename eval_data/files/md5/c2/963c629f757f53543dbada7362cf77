{"task_id": "Mbpp/435", "solution": "def last_Digit(num):\n    \"\"\"\n    Finds the last digit of a given number, handling integers, floats, and numeric strings.\n    Floats are truncated towards zero, and the absolute value is used for negative numbers.\n    \"\"\"\n    # Convert the number to a string first to handle both int and float types uniformly.\n    # Then convert to float, then to int to truncate decimal parts (e.g., 123.9 -> 123).\n    # Finally, take the absolute value to handle negative numbers (e.g., -123 -> 123).\n    abs_truncated_int = abs(int(float(str(num))))\n\n    # The last digit is the remainder when divided by 10.\n    return abs_truncated_int % 10"}
{"task_id": "Mbpp/433", "solution": "import sys\nfrom typing import Any, List, Optional, Sequence\n\nclass InvalidInputError(Exception):\n    \"\"\"Base exception for invalid input scenarios.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass ValidationError(InvalidInputError):\n    \"\"\"Specific exception for validation failures.\"\"\"\n    pass\n\ndef parse_array_string(s: str) -> List[float]:\n    \"\"\"Converts a comma-separated string of numbers into a list of floats.\"\"\"\n    if s.strip() == \"\":\n        return []\n    parts = [p.strip() for p in s.split(\",\")]\n    out = []\n    for p in parts:\n        if p == \"\":\n            continue\n        out.append(float(p))\n    return out\n\nclass ArrayModel:\n    \"\"\"Encapsulates an array of float elements and provides utility methods.\"\"\"\n    def __init__(self, elements: Sequence[float]) -> None:\n        self._elements: List[float] = [float(e) for e in elements]\n\n    def get_max(self) -> Optional[float]:\n        \"\"\"Returns the maximum element or None if the array is empty.\"\"\"\n        return max(self._elements) if self._elements else None\n\n    def __len__(self) -> int:\n        return len(self._elements)\n\nclass ComparisonService:\n    \"\"\"Provides core business logic for comparing a value against an ArrayModel.\"\"\"\n    def is_greater_than_all(self, array_model: ArrayModel, value: float) -> bool:\n        \"\"\"Checks if a value is strictly greater than all elements in the array model.\"\"\"\n        max_val: Optional[float] = array_model.get_max()\n        if max_val is None:\n            return True\n        return value > max_val\n\nclass ArrayValidator:\n    \"\"\"Validates and normalizes array inputs.\"\"\"\n    def validate_and_normalize(self, array: Any) -> List[float]:\n        \"\"\"Converts various array inputs to a normalized list of floats, or raises ValidationError.\"\"\"\n        if array is None:\n            return []\n        if isinstance(array, str):\n            tokens = parse_array_string(array)\n            return tokens\n        if isinstance(array, (list, tuple, set)):\n            out = []\n            for e in array:\n                try:\n                    out.append(float(e))\n                except Exception as ex:\n                    raise ValidationError(f\"Array contains non-numeric element: {e}\") from ex\n            return out\n        raise ValidationError(\"Unsupported array type; provide list/tuple/set or comma-separated string.\")\n\nclass NumberValidator:\n    \"\"\"Validates and normalizes numeric inputs.\"\"\"\n    def validate(self, value: Any) -> float:\n        \"\"\"Converts an input to a float, or raises ValidationError if non-numeric.\"\"\"\n        try:\n            return float(value)\n        except Exception as ex:\n            raise ValidationError(f\"Value is not numeric: {value}\") from ex\n\nclass CheckGreaterController:\n    \"\"\"Orchestrates validation, model creation, and service calls for the comparison logic.\"\"\"\n    def __init__(self, validator: ArrayValidator, number_validator: NumberValidator, service: ComparisonService) -> None:\n        self.validator = validator\n        self.number_validator = number_validator\n        self.service = service\n\n    def check_greater(self, elements: Sequence[float], value: object) -> bool:\n        \"\"\"Processes inputs to determine if the value is greater than all array elements.\"\"\"\n        arr = self.validator.validate_and_normalize(elements)\n        v = self.number_validator.validate(value)\n        array_model = ArrayModel(arr)\n        return self.service.is_greater_than_all(array_model, v)\n\n# Instantiate default dependencies for the public API function.\n_default_array_validator = ArrayValidator()\n_default_number_validator = NumberValidator()\n_default_comparison_service = ComparisonService()\n_default_controller = CheckGreaterController(\n    _default_array_validator, _default_number_validator, _default_comparison_service\n)\n\ndef check_greater(array, value) -> bool:\n    \"\"\"Checks if the entered number is strictly greater than all elements of the given array.\n\n    Returns True if the array is empty or if 'value' is strictly greater than every element.\n    \"\"\"\n    return _default_controller.check_greater(array, value)"}
{"task_id": "Mbpp/439", "solution": "def multiple_to_single(nums: list[int]) -> int:\n    \"\"\"\n    Joins a list of integers into a single integer by concatenating their string representations.\n    Returns 0 for an empty list.\n    \"\"\"\n    if not nums:\n        return 0\n    \n    # Convert each integer to its string representation and join them\n    joined_str = \"\".join(str(num) for num in nums)\n    \n    # Convert the resulting string back to an integer\n    return int(joined_str)"}
{"task_id": "Mbpp/430", "solution": "import math\nfrom dataclasses import dataclass\nfrom typing import Optional\n\nclass ParabolaError(ValueError):\n    \"\"\"Base exception for parabola related errors.\"\"\"\n    pass\n\nclass InvalidParabolaError(ParabolaError):\n    \"\"\"Raised when parabola coefficients are invalid.\"\"\"\n    pass\n\nEPSILON: float = 1e-12\nDEFAULT_CACHE_SIZE: int = 1024\n\ndef is_finite_number(x: float) -> bool:\n    \"\"\"Checks if a number is finite (not NaN or infinity).\"\"\"\n    return math.isfinite(x)\n\ndef validate_coefficients(a: float, b: float, c: float) -> None:\n    \"\"\"Validates parabola coefficients, raising an error if invalid.\"\"\"\n    if not (is_finite_number(a) and is_finite_number(b) and is_finite_number(c)):\n        raise InvalidParabolaError(\"Coefficients must be finite real numbers.\")\n    if abs(a) <= EPSILON:\n        raise InvalidParabolaError(\"Coefficient 'a' must be non-zero for a parabola.\")\n\ndef safe_divide(numerator: float, denominator: float) -> float:\n    \"\"\"Performs division, raising InvalidParabolaError on near-zero denominator.\"\"\"\n    if abs(denominator) <= EPSILON:\n        raise InvalidParabolaError(\"Division by zero or near-zero denominator detected.\")\n    return numerator / denominator\n\n@dataclass(frozen=True)\nclass Parabola:\n    \"\"\"Represents a parabola with coefficients a, b, c.\"\"\"\n    a: float\n    b: float\n    c: float\n\n    def to_vertex_form(self) -> tuple[float, float]:\n        \"\"\"Calculates the vertex (h, k) of the parabola.\"\"\"\n        h = safe_divide(-self.b, (2.0 * self.a))\n        k = self.c - safe_divide((self.b * self.b), (4.0 * self.a))\n        return h, k\n\nclass InMemoryParabolaRepository:\n    \"\"\"An in-memory cache for parabola directrix computations.\"\"\"\n    def __init__(self, max_size: int = DEFAULT_CACHE_SIZE) -> None:\n        self._cache: dict[str, float] = {}\n        self._max_size = max_size\n\n    def get(self, key: str) -> Optional[float]:\n        \"\"\"Retrieves a cached directrix value.\"\"\"\n        return self._cache.get(key)\n\n    def set(self, key: str, value: float) -> None:\n        \"\"\"Stores a directrix value in the cache, managing size.\"\"\"\n        if len(self._cache) >= self._max_size:\n            if self._cache:\n                del self._cache[next(iter(self._cache))] # Simple eviction\n        self._cache[key] = value\n\n    def _make_key(self, a: float, b: float, c: float) -> str:\n        \"\"\"Creates a deterministic string key from coefficients.\"\"\"\n        return f\"a={a:.12f};b={b:.12f};c={c:.12f}\"\n\nclass ParabolaService:\n    \"\"\"Provides core logic to compute the parabola directrix.\"\"\"\n    def __init__(self, repository: Optional[InMemoryParabolaRepository] = None) -> None:\n        self._repository = repository\n\n    def compute_directrix(self, parabola: Parabola) -> float:\n        \"\"\"Computes the directrix of the given parabola y = ax^2 + bx + c.\"\"\"\n        validate_coefficients(parabola.a, parabola.b, parabola.c)\n\n        key = None\n        if self._repository:\n            key = self._repository._make_key(parabola.a, parabola.b, parabola.c)\n            cached = self._repository.get(key)\n            if cached is not None:\n                return cached\n\n        # Formula: directrix = c - (b^2 + 1) / (4a)\n        numerator = (parabola.b * parabola.b) + 1.0\n        denominator = 4.0 * parabola.a\n        \n        frac = safe_divide(numerator, denominator)\n        directrix = parabola.c - frac\n\n        if self._repository and key:\n            self._repository.set(key, directrix)\n            \n        return directrix\n    \n    def _compute_vertex(self, parabola: Parabola) -> tuple[float, float]:\n        \"\"\"Helper to compute the vertex (h, k) of the parabola.\"\"\"\n        return parabola.to_vertex_form()\n\n    def _compute_focal_length(self, a: float) -> float:\n        \"\"\"Helper to compute the focal length (p) of the parabola.\"\"\"\n        return safe_divide(1.0, 4.0 * a)\n\ndef parabola_directrix(a: float, b: float, c: float, use_cache: bool = True) -> float:\n    \"\"\"Calculates the directrix of a parabola y = ax^2 + bx + c.\n    Raises InvalidParabolaError for invalid input coefficients.\n    \"\"\"\n    validate_coefficients(a, b, c)\n    parabola = Parabola(a, b, c)\n    repo = InMemoryParabolaRepository() if use_cache else None\n    service = ParabolaService(repository=repo)\n    return service.compute_directrix(parabola)"}
{"task_id": "Mbpp/440", "solution": "import re\nfrom dataclasses import dataclass\nfrom typing import Optional, List, Tuple\nfrom abc import ABC, abstractmethod\n\n@dataclass\nclass Token:\n    \"\"\"Represents a detected token with its text and original character offsets.\"\"\"\n    text: str\n    start_char: int\n    end_char: int\n\n@dataclass\nclass AdverbResult:\n    \"\"\"Stores the found adverb's details: start index, end index, and text.\"\"\"\n    start: Optional[int]\n    end: Optional[int]\n    adverb: Optional[str]\n\n    def is_found(self) -> bool:\n        \"\"\"Checks if an adverb was successfully found.\"\"\"\n        return self.adverb is not None\n\nMAX_INPUT_LENGTH = 1_000_000\n\ndef normalize_text(text: str) -> str:\n    \"\"\"Normalizes text by removing control characters and collapsing whitespace.\"\"\"\n    normalized = re.sub(r'[\\x00-\\x1F\\x7F-\\x9F]', ' ', text)\n    normalized = re.sub(r'\\s+', ' ', normalized).strip()\n    return normalized\n\ndef find_token_offsets(orig: str, token_text: str, start_search: int = 0) -> Optional[Tuple[int, int]]:\n    \"\"\"Finds the character offsets for a token in the original string, respecting word boundaries.\"\"\"\n    escaped_token_text = re.escape(token_text)\n    pattern = r\"\\b\" + escaped_token_text + r\"\\b\"\n    # Search in the segment of the original string starting from start_search\n    match = re.search(pattern, orig[start_search:], re.IGNORECASE)\n    if match:\n        start_in_segment = match.start()\n        end_in_segment = match.end()\n        return (start_search + start_in_segment, start_search + end_in_segment)\n    return None\n\nclass AdverbAdapter(ABC):\n    \"\"\"Abstract base class for adverb detection adapters.\"\"\"\n    @abstractmethod\n    def detect_adverbs(self, text: str) -> List[Token]:\n        \"\"\"Detects adverbs in the given text and returns them as a list of Token objects.\"\"\"\n        pass\n\nclass RegexAdapter(AdverbAdapter):\n    \"\"\"An adverb adapter that uses regex patterns and a curated list for detection.\"\"\"\n    SIMPLE_ADVERB_REGEX = r\"\\b([A-Za-z]+ly)\\b\"\n    EXTRA_ADVERBS = (\"well\", \"very\", \"too\", \"quite\", \"never\")\n\n    def __init__(self):\n        self._pattern = re.compile(self.SIMPLE_ADVERB_REGEX, re.IGNORECASE)\n\n    def detect_adverbs(self, text: str) -> List[Token]:\n        \"\"\"Detects adverbs using regex and a predefined list, returning sorted Token objects.\"\"\"\n        tokens = []\n\n        # Find -ly adverbs using the compiled regex pattern\n        for m in self._pattern.finditer(text):\n            token_text = m.group(1)\n            start = m.start(1)\n            end = m.end(1)\n            tokens.append(Token(text=token_text, start_char=start, end_char=end))\n\n        # Find extra adverbs by iterating through the curated list\n        for word in self.EXTRA_ADVERBS:\n            current_search_start = 0\n            while True:\n                # Use find_token_offsets to get robust matches with word boundaries\n                offsets = find_token_offsets(text, word, current_search_start)\n                if offsets:\n                    start_char, end_char = offsets\n                    # Extract the actual word from the `text` (normalized) to preserve casing\n                    actual_word = text[start_char:end_char]\n                    tokens.append(Token(text=actual_word, start_char=start_char, end_char=end_char))\n                    current_search_start = end_char  # Continue search after this match\n                else:\n                    break\n\n        # Sort all detected tokens by their starting character position\n        tokens.sort(key=lambda t: t.start_char)\n        return tokens\n\nclass AdverbFinderService:\n    \"\"\"Service to orchestrate adverb detection, text normalization, and result mapping.\"\"\"\n    def __init__(self, adapter: AdverbAdapter):\n        self._adapter = adapter\n\n    def _safe_detect(self, text: str) -> List[Token]:\n        \"\"\"Safely calls the adapter's detect_adverbs, catching potential exceptions.\"\"\"\n        try:\n            return self._adapter.detect_adverbs(text)\n        except Exception:\n            return []\n\n    def find_first_adverb(self, text: str) -> AdverbResult:\n        \"\"\"Finds the first adverb in the given text, returning its position and value.\"\"\"\n        # For the purpose of this completion and given constraints,\n        # we assume 'text' is a valid string and within length limits,\n        # avoiding explicit type/length checks here as per specific instructions.\n\n        normalized_text = normalize_text(text)\n        tokens_in_normalized = self._safe_detect(normalized_text)\n\n        if not tokens_in_normalized:\n            return AdverbResult(None, None, None)\n\n        # The first token found in the normalized text\n        first_token = tokens_in_normalized[0]\n        adverb_text_from_norm = first_token.text\n\n        # Map the token's text back to the original input string to get correct offsets\n        # Use start_search=0 as we are looking for the *first* adverb\n        original_offsets = find_token_offsets(text, adverb_text_from_norm, 0)\n\n        if original_offsets:\n            actual_start, actual_end = original_offsets\n            return AdverbResult(start=actual_start, end=actual_end, adverb=adverb_text_from_norm)\n        else:\n            # This case indicates the adverb found in normalized text couldn't be located\n            # in the original text, which should ideally not happen with robust normalization/matching.\n            return AdverbResult(None, None, None)\n\ndef find_adverb_position(text: str) -> Tuple[Optional[int], Optional[int], Optional[str]]:\n    \"\"\"Finds the first adverb and its positions in a given sentence.\"\"\"\n    service = AdverbFinderService(adapter=RegexAdapter())\n    result = service.find_first_adverb(text)\n    if result.is_found():\n        return (result.start, result.end, result.adverb)\n    return (None, None, None)"}
