{"task_id": "Mbpp/57", "solution": "from typing import Iterable, Optional, List, Any, Union\nimport json\nimport datetime\n\nclass DigitList:\n    \"\"\"Immutable domain object representing a canonical list of digits.\"\"\"\n    MIN_DIGIT: int = 0\n    MAX_DIGIT: int = 9\n\n    def __init__(self, digits: List[int]) -> None:\n        if any(d < self.MIN_DIGIT or d > self.MAX_DIGIT for d in digits):\n            raise ValueError(\"digits must be in range 0..9\")\n        self._digits = list(digits)\n\n    def as_list(self) -> List[int]:\n        return list(self._digits)\n\n    def as_str(self) -> str:\n        return ''.join(str(d) for d in self._digits)\n\nclass Validator:\n    \"\"\"Validates and normalizes user input into a list of digits.\"\"\"\n    @staticmethod\n    def validate_iterable(digits: Iterable[Any]) -> List[int]:\n        if not hasattr(digits, '__iter__'):\n            raise TypeError(\"Input must be an iterable\")\n        out = []\n        for v in digits:\n            out.append(Validator._to_digit(v))\n        return out\n\n    @staticmethod\n    def _to_digit(value: Any) -> int:\n        if isinstance(value, int):\n            val = value\n        elif isinstance(value, str) and len(value) == 1 and value.isdigit():\n            val = int(value)\n        else:\n            raise ValueError(f\"Invalid digit value: {value!r}\")\n        if not (0 <= val <= 9):\n            raise ValueError(\"Digit out of range 0..9\")\n        return val\n\nclass Formatter:\n    \"\"\"Converts digits to numeric or string representation.\"\"\"\n    @staticmethod\n    def digits_to_str(digits: List[int]) -> str:\n        return ''.join(str(d) for d in digits)\n\n    @staticmethod\n    def digits_to_int(digits: List[int]) -> int:\n        s = Formatter.digits_to_str(digits)\n        return int(s) if s else 0\n\nclass FileRepository:\n    \"\"\"Provides optional persistence to a JSONL file.\"\"\"\n    DEFAULT_REPO_PATH: str = \"maxnum_records.jsonl\"\n\n    def __init__(self, path: str = DEFAULT_REPO_PATH) -> None:\n        self._path = path\n\n    def save(self, record: dict) -> None:\n        record[\"timestamp\"] = datetime.datetime.now(datetime.timezone.utc).isoformat()\n        try:\n            with open(self._path, 'a', encoding='utf-8') as f:\n                json.dump(record, f, ensure_ascii=False)\n                f.write('\\n')\n        except IOError as e:\n            raise IOError(f\"Failed to save record to {self._path}: {e}\") from e\n\nclass NumberBuilderService:\n    \"\"\"Orchestrates validation, ordering, conversion, and optional persistence.\"\"\"\n    def __init__(self, repository: Optional[FileRepository] = None) -> None:\n        self._repository = repository\n\n    def build_max_number(self, digits: Iterable[Union[int, str]]) -> int:\n        validated = Validator.validate_iterable(digits)\n        domain = DigitList(validated)\n        sorted_digits = self._sort_digits_desc(domain.as_list())\n        result = Formatter.digits_to_int(sorted_digits)\n        if self._repository:\n            try:\n                self._persist(domain.as_list(), result)\n            except Exception:\n                # Persistence errors are swallowed and logged in a real implementation.\n                pass\n        return result\n\n    def _sort_digits_desc(self, digits: List[int]) -> List[int]:\n        return sorted(digits, reverse=True)\n\n    def _persist(self, input_digits: List[int], output: int) -> None:\n        record = {\"input\": input_digits, \"output\": output}\n        self._repository.save(record)\n\ndef find_Max_Num(digits: Iterable[Union[int, str]], save: bool = False, repo_path: Optional[str] = None) -> int:\n    \"\"\"Finds the largest number formed by concatenating the given digits.\n\n    Optionally saves the input/output to a JSONL file.\n    \"\"\"\n    repo = None\n    if save:\n        if repo_path:\n            repo = FileRepository(repo_path)\n        else:\n            repo = FileRepository()\n            \n    service = NumberBuilderService(repository=repo)\n    return service.build_max_number(digits)"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts the number of substrings where the sum of digits equals their length.\n    This is solved by transforming each digit 'd' to 'd-1' and counting zero-sum subarrays.\n    \"\"\"\n    \n    # Transform each digit d to d-1. The problem \"sum(digits) == length\" for a substring\n    # is equivalent to \"sum(d-1 for d in substring) == 0\".\n    adjusted_arr = [int(char) - 1 for char in s]\n\n    # Use a hash map to store the frequency of prefix sums encountered so far.\n    # Initialize with a prefix sum of 0 occurring once, representing the empty prefix.\n    prefix_sum_freq: dict[int, int] = {0: 1}\n    current_prefix_sum = 0\n    substring_count = 0\n\n    for num in adjusted_arr:\n        current_prefix_sum += num\n        # If the current prefix sum has been seen before, it means the subarray\n        # between the previous occurrence and the current position sums to zero.\n        substring_count += prefix_sum_freq.get(current_prefix_sum, 0)\n        \n        # Increment the frequency of the current prefix sum.\n        prefix_sum_freq[current_prefix_sum] = prefix_sum_freq.get(current_prefix_sum, 0) + 1\n\n    return substring_count"}
