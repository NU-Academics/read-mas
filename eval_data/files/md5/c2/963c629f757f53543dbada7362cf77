{"task_id": "Mbpp/560", "solution": "def union_elements(tuple1, tuple2):\n    \"\"\"\n    Finds the union of elements from two tuples, removes duplicates, and sorts them.\n    \"\"\"\n    combined_elements = tuple1 + tuple2\n    unique_elements = set(combined_elements)\n    sorted_unique_elements = sorted(list(unique_elements))\n    return tuple(sorted_unique_elements)"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr: list[int], _ignored: int) -> int:\n    \"\"\"Finds the sum of the largest contiguous sublist using Kadane's algorithm.\n\n    Returns 0 for an empty list.\n    \"\"\"\n    if not arr:\n        return 0\n\n    max_ending_here = arr[0]\n    max_so_far = arr[0]\n\n    for x in arr[1:]:\n        max_ending_here = max(x, max_ending_here + x)\n        max_so_far = max(max_so_far, max_ending_here)\n\n    return max_so_far"}
{"task_id": "Mbpp/562", "solution": "class LongestSublistsError(Exception):\n    \"\"\"Base exception for the longest sublists library.\"\"\"\n    pass\n\nclass InvalidInputError(LongestSublistsError):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass InputDTO:\n    \"\"\"Data Transfer Object for validated input list of lists.\"\"\"\n    def __init__(self, lists_data) -> None:\n        self.lists = lists_data\n\nALLOWED_SEQUENCE_TYPES = (list, tuple)\n\nclass InputValidator:\n    \"\"\"Validates the structure and types of the input list of lists.\"\"\"\n    def validate(self, input_lists):\n        if not isinstance(input_lists, ALLOWED_SEQUENCE_TYPES):\n            raise InvalidInputError(\"Top-level input must be list or tuple\")\n        for i, elem in enumerate(input_lists):\n            if not isinstance(elem, ALLOWED_SEQUENCE_TYPES):\n                raise InvalidInputError(f\"Element at index {i} is not a list/tuple\")\n        return InputDTO(input_lists)\n\nclass FinderService:\n    \"\"\"Computes the length of the longest sublist.\"\"\"\n    def __init__(self, validator) -> None:\n        self._validator = validator\n\n    def find_max_length(self, service_lists) -> int:\n        dto = self._validator.validate(service_lists)\n        max_len = 0\n        for sub in dto.lists:\n            current_len = len(sub)\n            if current_len > max_len:\n                max_len = current_len\n        return max_len\n\ndef Find_Max_Length(lists):\n    \"\"\"Finds the length of the longest sublist from a list of lists.\"\"\"\n    validator = InputValidator()\n    svc = FinderService(validator)\n    return svc.find_max_length(lists)"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"Calculates the sum of per-digit absolute differences between two integers.\n    Digits are aligned from least significant, treating missing digits as zero.\n    \"\"\"\n\n    def _generate_digits(value: int):\n        v = abs(value)\n        if v == 0:\n            yield 0\n            return\n        while v > 0:\n            yield v % 10\n            v //= 10\n\n    total = 0\n    gen_a = _generate_digits(a)\n    gen_b = _generate_digits(b)\n\n    while True:\n        try:\n            da = next(gen_a)\n        except StopIteration:\n            da = None\n        try:\n            db = next(gen_b)\n        except StopIteration:\n            db = None\n\n        if da is None and db is None:\n            break\n\n        da = da if da is not None else 0\n        db = db if db is not None else 0\n\n        total += abs(da - db)\n    return total"}
{"task_id": "Mbpp/564", "solution": "from collections import Counter\nfrom typing import List\n\ndef count_Pairs(arr: List[int], n: int) -> int:\n    \"\"\"\n    Counts the number of possible unordered pairs where both elements are unequal.\n    Assumes `n` is the length of `arr`.\n    \"\"\"\n    total_possible_pairs = n * (n - 1) // 2\n\n    # Count frequencies of each element\n    freq_map = Counter(arr)\n\n    # Calculate pairs where both elements are equal\n    equal_element_pairs = 0\n    for count in freq_map.values():\n        equal_element_pairs += count * (count - 1) // 2\n\n    return total_possible_pairs - equal_element_pairs"}
{"task_id": "Mbpp/563", "solution": "import re\nfrom abc import ABC, abstractmethod\n\nclass ExtractionResult:\n    \"\"\"Immutable DTO encapsulating extracted tokens and derived metadata.\"\"\"\n    def __init__(self, tokens: list):\n        self.tokens = tokens\n        self.count = len(tokens)\n\n    def to_list(self) -> list:\n        \"\"\"Returns tokens as a new list (defensive copy).\"\"\"\n        return list(self.tokens)\n\nclass ExtractionError(ValueError):\n    \"\"\"Represents parsing or validation errors during extraction.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nDEFAULT_QUOTE_CHARS = ['\"', \"'\"]\nESCAPE_CHAR = '\\\\'\n\ndef is_str(obj: any) -> bool:\n    \"\"\"Checks if an object is a string.\"\"\"\n    return isinstance(obj, str)\n\ndef default_quote_chars() -> list:\n    \"\"\"Returns a copy of the default quote characters.\"\"\"\n    return list(DEFAULT_QUOTE_CHARS)\n\ndef unescape_content(s: str) -> str:\n    \"\"\"Replaces escaped backslashes and quotes with their literal characters.\"\"\"\n    if not is_str(s):\n        return s\n    \n    result = []\n    i = 0\n    while i < len(s):\n        if s[i] == ESCAPE_CHAR:\n            if i + 1 < len(s):\n                next_char = s[i+1]\n                if next_char == ESCAPE_CHAR or next_char in DEFAULT_QUOTE_CHARS:\n                    result.append(next_char)\n                    i += 1\n                else:\n                    result.append(ESCAPE_CHAR)\n            else:\n                result.append(ESCAPE_CHAR)\n        else:\n            result.append(s[i])\n        i += 1\n    return \"\".join(result)\n\nclass ParserStrategy(ABC):\n    \"\"\"Abstract base class defining the interface for parsing strategies.\"\"\"\n    def __init__(self, name: str):\n        self.name = name\n\n    @abstractmethod\n    def parse(self, text: str, quote_chars: list | None, allow_escaped: bool) -> ExtractionResult:\n        pass\n\nclass RegexStrategy(ParserStrategy):\n    \"\"\"Regex-based parsing implementation for fast extraction.\"\"\"\n    def __init__(self):\n        super().__init__(\"regex\")\n        self._pattern_cache = {}\n\n    def _build_pattern(self, quote_chars: tuple, allow_escaped: bool) -> re.Pattern:\n        \"\"\"Builds and caches the regex pattern based on configuration.\"\"\"\n        cache_key = (quote_chars, allow_escaped)\n        if cache_key in self._pattern_cache:\n            return self._pattern_cache[cache_key]\n\n        quote_char_patterns = []\n        for q in quote_chars:\n            escaped_q = re.escape(q)\n            \n            if allow_escaped:\n                content_pattern = r'(?:\\\\' + r'.' + r'|[^' + escaped_q + r'\\\\])*'\n            else:\n                content_pattern = r'[^' + escaped_q + r']*'\n            \n            quote_char_patterns.append(f'{escaped_q}({content_pattern}){escaped_q}')\n        \n        full_pattern = '|'.join(quote_char_patterns)\n        \n        compiled_pattern = re.compile(full_pattern)\n        self._pattern_cache[cache_key] = compiled_pattern\n        return compiled_pattern\n\n    def parse(self, text: str, quote_chars: list | None = None, allow_escaped: bool = True) -> ExtractionResult:\n        \"\"\"Parses the text using regex and returns extracted content.\"\"\"\n        if quote_chars is None:\n            quote_chars = default_quote_chars()\n        \n        pattern = self._build_pattern(tuple(quote_chars), allow_escaped)\n        \n        tokens = []\n        matches = pattern.findall(text)\n        for match_groups in matches:\n            raw_content = next((group for group in match_groups if group != ''), '')\n            \n            processed_content = unescape_content(raw_content) if allow_escaped else raw_content\n            tokens.append(processed_content)\n            \n        return ExtractionResult(tokens)\n\nclass StateMachineStrategy(ParserStrategy):\n    \"\"\"Deterministic character-state parser robust to complex escapes.\"\"\"\n    def __init__(self):\n        super().__init__(\"state\")\n\n    def parse(self, text: str, quote_chars: list | None = None, allow_escaped: bool = True) -> ExtractionResult:\n        \"\"\"Parses the text character by character using a state machine.\"\"\"\n        if quote_chars is None:\n            quote_chars = default_quote_chars()\n        \n        tokens = []\n        buf = []\n        in_quote = False\n        current_quote_char = None\n        \n        i = 0\n        while i < len(text):\n            ch = text[i]\n\n            if not in_quote:\n                if ch in quote_chars:\n                    in_quote = True\n                    current_quote_char = ch\n            else:\n                if ch == ESCAPE_CHAR and allow_escaped:\n                    if i + 1 < len(text):\n                        buf.append(ch)\n                        buf.append(text[i+1])\n                        i += 1\n                    else:\n                        buf.append(ch)\n                elif ch == current_quote_char:\n                    raw_content = \"\".join(buf)\n                    processed_content = unescape_content(raw_content) if allow_escaped else raw_content\n                    tokens.append(processed_content)\n                    \n                    buf = []\n                    in_quote = False\n                    current_quote_char = None\n                else:\n                    buf.append(ch)\n            \n            i += 1\n        \n        return ExtractionResult(tokens)\n\nclass ExtractorService:\n    \"\"\"Orchestrates validation, strategy selection, and delegates parsing.\"\"\"\n    def __init__(self, strategy_registry: dict | None = None):\n        self._strategies = strategy_registry if strategy_registry is not None else {}\n        if not self._strategies:\n            self.register_strategy(\"regex\", RegexStrategy())\n            self.register_strategy(\"state\", StateMachineStrategy())\n\n    def register_strategy(self, name: str, strategy_instance: ParserStrategy) -> None:\n        \"\"\"Registers a new parsing strategy.\"\"\"\n        self._strategies[name] = strategy_instance\n\n    def available_strategies(self) -> list[str]:\n        \"\"\"Returns a list of names of available parsing strategies.\"\"\"\n        return sorted(list(self._strategies.keys()))\n\n    def extract(self, text: str, quote_chars: list | None = None, allow_escaped: bool = True, strategy: str = 'regex') -> list[str]:\n        \"\"\"Extracts quoted values from a string using the specified strategy.\"\"\"\n        if not is_str(text):\n            raise ExtractionError(\"Input 'text' must be a string.\")\n        \n        if strategy not in self._strategies:\n            raise ValueError(f\"Unknown strategy: '{strategy}'. Available strategies: {', '.join(self.available_strategies())}\")\n        \n        parser = self._strategies[strategy]\n        result = parser.parse(text, quote_chars, allow_escaped)\n        return result.to_list()\n\ndef extract_values(s: str) -> list[str]:\n    \"\"\"Extracts values between quotation marks from a string using default settings.\"\"\"\n    svc = ExtractorService()\n    return svc.extract(s, quote_chars=None, allow_escaped=True, strategy=\"regex\")"}
{"task_id": "Mbpp/566", "solution": "def sum_digits(n):\n    \"\"\"\n    Calculates the sum of the digits of a non-negative integer.\n    The input `n` is assumed to be a non-negative integer.\n    \"\"\"\n    total = 0\n    # Convert the integer to a string to iterate through its digits.\n    for digit_char in str(n):\n        # Convert each digit character back to an integer and add to the total.\n        total += int(digit_char)\n    return total"}
