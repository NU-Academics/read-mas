{"task_id": "Mbpp/796", "solution": "from decimal import Decimal\nimport decimal # Import the module to use Decimal\n\ndef return_sum(values: dict, *, coerce: bool = False):\n    \"\"\"\n    Finds the sum of all numeric items in the given dictionary values.\n    Optionally coerces numeric-like strings to numbers if `coerce` is True.\n    \"\"\"\n\n    def is_numeric_helper(value):\n        \"\"\"Returns True if value is an int, float, or Decimal, excluding bool.\"\"\"\n        return isinstance(value, (int, float, Decimal)) and not isinstance(value, bool)\n\n    def coerce_to_numeric_helper(value):\n        \"\"\"Attempts to convert numeric-like values (especially strings) to int, float, or Decimal.\"\"\"\n        if is_numeric_helper(value):\n            return value\n        if isinstance(value, str):\n            try:\n                # Attempt to convert string to Decimal first for robust parsing.\n                return Decimal(value)\n            except decimal.InvalidOperation:\n                pass\n        raise ValueError(f\"Cannot coerce '{value}' (type {type(value).__name__}) to a numeric type.\")\n\n    def safe_decimal_sum_helper(numbers_list):\n        \"\"\"Sums a list of numbers, using Decimal for precision if any Decimal is present.\"\"\"\n        if any(isinstance(v, Decimal) for v in numbers_list):\n            total_decimal = Decimal(0)\n            for num in numbers_list:\n                # Convert all numbers to Decimal for consistent summation, avoiding float precision issues.\n                total_decimal += Decimal(str(num))\n            return total_decimal\n        return sum(numbers_list)\n\n    numeric_values_to_sum = []\n    for value in values.values():\n        if is_numeric_helper(value):\n            numeric_values_to_sum.append(value)\n        elif coerce:\n            try:\n                coerced_value = coerce_to_numeric_helper(value)\n                numeric_values_to_sum.append(coerced_value)\n            except ValueError:\n                # If coercion fails, the value is simply skipped/filtered.\n                continue\n\n    return safe_decimal_sum_helper(numeric_values_to_sum)"}
{"task_id": "Mbpp/794", "solution": "from text_matcher.services.matcher_service import TextMatcherService\nfrom text_matcher.adapters.regex_adapter import RegexAdapter\nfrom text_matcher.repositories.history_repository import InMemoryHistoryRepository\n\ndef text_starta_endb(text: str) -> bool:\n    \"\"\"\n    Checks if a string starts with 'a', is followed by anything, and ends with 'b'.\n    This is a convenience wrapper, delegating to a default TextMatcherService instance.\n    \"\"\"\n    adapter = RegexAdapter()\n    repository = InMemoryHistoryRepository()\n    service = TextMatcherService(adapter=adapter, repository=repository)\n    return service.text_starta_endb(text)"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(value: int, d: int, width: int = 32) -> int:\n    \"\"\"\n    Rotates the bits of a given number left by d bits within a specified width.\n    The number is treated as unsigned and masked to the given width.\n    \"\"\"\n    mask = (1 << width) - 1\n    d_norm = d % width\n    v_masked = value & mask\n\n    if d_norm == 0:\n        return v_masked\n\n    # Perform the left rotation:\n    # 1. Shift left, then mask to truncate bits that exceed 'width'.\n    # 2. Shift right (width - d_norm) to get the bits that wrapped around.\n    # 3. Combine the two parts with a bitwise OR.\n    return ((v_masked << d_norm) & mask) | (v_masked >> (width - d_norm))"}
{"task_id": "Mbpp/797", "solution": "def sum_in_range(l: int, r: int) -> int:\n    \"\"\"\n    Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n    Natural numbers are positive integers (>= 1).\n    \"\"\"\n    # Determine the first odd natural number (>= 1) in the effective range.\n    first_odd = max(l, 1)\n    if first_odd % 2 == 0:\n        first_odd += 1\n\n    # Determine the last odd natural number (>= 1) in the effective range.\n    last_odd = r\n    if last_odd % 2 == 0:\n        last_odd -= 1\n\n    # If the effective range has no odd natural numbers, return 0.\n    if first_odd > last_odd:\n        return 0\n\n    # Calculate the count of odd numbers in the range [first_odd, last_odd].\n    # This is an arithmetic progression with common difference 2.\n    count = (last_odd - first_odd) // 2 + 1\n\n    # Calculate the sum using the arithmetic progression sum formula: n * (a + b) / 2\n    total_sum = count * (first_odd + last_odd) // 2\n    return total_sum"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a, b, c):\n    \"\"\"\n    Counts the number of equal integers among three given numbers.\n    Returns 3 if all are equal, 2 if exactly two are equal, and 0 if all are distinct.\n    \"\"\"\n    if a == b == c:\n        return 3\n    elif a == b or a == c or b == c:\n        return 2\n    else:\n        return 0"}
