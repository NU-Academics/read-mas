{"task_id": "Mbpp/453", "solution": "def sumofFactors(n):\n    \"\"\"\n    Calculates the sum of even factors of a given positive integer n.\n    Returns 0 if n has no even factors (e.g., if n is odd).\n    \"\"\"\n    sum_even = 0\n\n    # If n is an odd number, it cannot have any even factors.\n    if n % 2 != 0:\n        return 0\n\n    # Iterate through potential factors up to the square root of n.\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            # If i is an even factor, add it to the sum.\n            if i % 2 == 0:\n                sum_even += i\n            \n            # If i*i is not n, then n // i is a distinct factor.\n            if i * i != n:\n                other_factor = n // i\n                # If the other_factor is even, add it to the sum.\n                if other_factor % 2 == 0:\n                    sum_even += other_factor\n        i += 1\n    \n    return sum_even"}
{"task_id": "Mbpp/448", "solution": "def cal_sum(n: int) -> int:\n    from collections import deque\n    from typing import Optional, List, Deque\n\n    # Perrin exceptions defined as per design, even if not used due to other constraints.\n    class PerrinError(Exception):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class ValidationError(PerrinError):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n\n    # Configuration class to hold settings for caching.\n    class Config:\n        DEFAULT_USE_CACHE: bool = True\n        DEFAULT_CACHE_MAX_SIZE: Optional[int] = None\n\n        def __init__(self, use_cache: bool = DEFAULT_USE_CACHE, cache_max_size: Optional[int] = DEFAULT_CACHE_MAX_SIZE) -> None:\n            self.use_cache = use_cache\n            self.cache_max_size = cache_max_size\n\n    # Cache adapter providing in-memory key-value storage with optional size limits.\n    class CacheAdapter:\n        def __init__(self, max_size: Optional[int] = None) -> None:\n            self._store: dict[int, int] = {}\n            self._order: Deque[int] = deque()\n            self._max_size = max_size\n\n        def get(self, key: int) -> Optional[int]:\n            return self._store.get(key)\n\n        def set(self, key: int, value: int) -> None:\n            if key in self._store:\n                self._store[key] = value\n                return\n            self._store[key] = value\n            self._order.append(key)\n            if self._max_size is not None and len(self._order) > self._max_size:\n                evict_key = self._order.popleft()\n                self._store.pop(evict_key, None)\n\n        def clear(self) -> None:\n            self._store.clear()\n            self._order.clear()\n\n        def keys(self) -> List[int]:\n            return list(self._store.keys())\n\n    # Repository for Perrin numbers, abstracting data access and utilizing the cache.\n    class PerrinRepository:\n        def __init__(self, cache: Optional[CacheAdapter] = None) -> None:\n            self._cache = cache\n\n        def get(self, index: int) -> Optional[int]:\n            if self._cache:\n                return self._cache.get(index)\n            return None\n\n        def set(self, index: int, value: int) -> None:\n            if self._cache:\n                self._cache.set(index, value)\n\n        def get_sequence_up_to(self, n: int) -> List[Optional[int]]:\n            sequence: List[Optional[int]] = [None] * (n + 1)\n            if self._cache:\n                for i in range(n + 1):\n                    sequence[i] = self._cache.get(i)\n            return sequence\n\n    # Service layer containing the core Perrin number computation logic.\n    class PerrinService:\n        def __init__(self, repository: PerrinRepository) -> None:\n            self._repo = repository\n\n        def compute_p(self, n: int) -> int:\n            seq = self._compute_iterative(n)\n            return seq[n]\n\n        def sum_up_to(self, n: int) -> int:\n            seq = self._compute_iterative(n)\n            return sum(seq)\n\n        def _compute_iterative(self, n: int) -> List[int]:\n            # Retrieve already cached values for the sequence up to n.\n            sequence_from_repo: List[Optional[int]] = self._repo.get_sequence_up_to(n)\n            \n            final_sequence: List[int] = [0] * (n + 1)\n\n            for i in range(n + 1):\n                if sequence_from_repo[i] is not None:\n                    final_sequence[i] = sequence_from_repo[i]\n                    continue\n\n                value: int\n                if i == 0:\n                    value = 3\n                elif i == 1:\n                    value = 0\n                elif i == 2:\n                    value = 2\n                else:\n                    value = final_sequence[i-2] + final_sequence[i-3]\n                \n                final_sequence[i] = value\n                self._repo.set(i, value)\n                \n            return final_sequence\n\n    # Controller layer handling input delegation to the service.\n    class PerrinController:\n        def __init__(self, service: PerrinService) -> None:\n            self._service = service\n\n        def sum_up_to(self, n: int) -> int:\n            return self._service.sum_up_to(n)\n\n    # Instantiate and orchestrate components as per the design document.\n    cfg = Config()\n    cache = CacheAdapter(cfg.cache_max_size) if cfg.use_cache else None\n    repo = PerrinRepository(cache=cache)\n    svc = PerrinService(repository=repo)\n    ctl = PerrinController(service=svc)\n    return ctl.sum_up_to(n)"}
{"task_id": "Mbpp/454", "solution": "import re\nfrom typing import List, Dict, Optional\nfrom dataclasses import dataclass\n\ndef text_match_wordz(text: str) -> bool:\n    DEFAULT_TOKEN_PATTERN = r\"\\w+\"\n    DEFAULT_Z_PATTERN = r\"z\"\n    DEFAULT_IGNORE_CASE = True\n\n    class TextMatchError(Exception):\n        def __init__(self, message: str, cause: Optional[Exception] = None) -> None:\n            super().__init__(message)\n            self.message = message\n            self.cause = cause\n\n    @dataclass\n    class MatchResult:\n        matched: bool\n        matched_tokens: List[str]\n\n        def to_dict(self) -> Dict[str, object]:\n            return {\"matched\": self.matched, \"matched_tokens\": self.matched_tokens}\n\n    class RegexRepository:\n        def __init__(self, flags: int = re.IGNORECASE if DEFAULT_IGNORE_CASE else 0) -> None:\n            self._cache: dict[str, re.Pattern] = {}\n            self._flags = flags\n\n        def get(self, pattern: str) -> re.Pattern:\n            if pattern in self._cache:\n                return self._cache[pattern]\n            try:\n                compiled = re.compile(pattern, self._flags)\n                self._cache[pattern] = compiled\n                return compiled\n            except re.error as e:\n                raise TextMatchError(f\"Invalid regex pattern: {pattern}\", cause=e)\n\n    class Tokenizer:\n        def __init__(self, regex_repo: RegexRepository, token_pattern: str = DEFAULT_TOKEN_PATTERN) -> None:\n            self._regex_repo = regex_repo\n            self.token_pattern = token_pattern\n\n        def tokenize(self, text: str) -> List[str]:\n            pattern = self._regex_repo.get(self.token_pattern)\n            return pattern.findall(text)\n\n    class TextMatcher:\n        def __init__(self, tokenizer: Tokenizer, regex_repo: RegexRepository, z_pattern: str = DEFAULT_Z_PATTERN) -> None:\n            self._tokenizer = tokenizer\n            self._regex_repo = regex_repo\n            self.z_pattern = z_pattern\n\n        def match(self, text: str) -> MatchResult:\n            tokens = self._tokenizer.tokenize(text)\n            z_re = self._regex_repo.get(self.z_pattern)\n            matched = [t for t in tokens if z_re.search(t)]\n            return MatchResult(matched=bool(matched), matched_tokens=matched)\n\n    repo = RegexRepository()\n    tokenizer = Tokenizer(repo)\n    matcher = TextMatcher(tokenizer, repo)\n    return matcher.match(text).matched"}
