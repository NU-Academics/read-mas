{"task_id": "Mbpp/113", "solution": "import re\n\n# Compiled regex for integer validation as per design context (IntegerValidator.INT_PATTERN).\n# Matches an optional sign (+ or -) followed by one or more digits, from start to end of string.\n_INT_PATTERN = re.compile(r'^[+-]?\\d+$')\n\ndef check_integer(s: str) -> bool:\n    \"\"\"\n    Checks if a string represents a decimal integer, allowing optional leading/trailing whitespace and a sign.\n    Non-string inputs or strings like \"+\" or \"\" are not considered integers.\n    \"\"\"\n    # As per FR1 from design context: \"non-str inputs are treated as non-integers.\"\n    if not isinstance(s, str):\n        return False\n\n    # Normalize the string by stripping leading/trailing whitespace (StringNormalizer.normalize logic).\n    normalized_s = s.strip()\n\n    # Validate the normalized string using the pre-compiled regex (IntegerValidator.is_integer logic).\n    # An empty string after stripping is not an integer. The regex also handles isolated signs.\n    return bool(_INT_PATTERN.match(normalized_s))"}
{"task_id": "Mbpp/118", "solution": "def string_to_list(s: str, collapse_whitespace: bool = False, max_splits: int | None = None, preserve_empty: bool | None = None) -> list[str]:\n    \"\"\"\n    Converts a string to a list of strings split on the space character.\n    Optionally collapses consecutive whitespace or limits the number of splits.\n    \"\"\"\n    if preserve_empty is None:\n        # Default behavior: preserve empty tokens if splitting on literal ' ',\n        # do not preserve empty tokens if collapsing whitespace.\n        preserve_empty_effective = not collapse_whitespace\n    else:\n        preserve_empty_effective = preserve_empty\n\n    tokens: list[str]\n    if collapse_whitespace:\n        # Use str.split() with None as separator to collapse any whitespace and remove empty strings.\n        # The preserve_empty_effective flag has no effect when collapse_whitespace is True,\n        # as s.split(None) inherently does not produce empty tokens (except for empty input string).\n        tokens = s.split(None if max_splits is None else max_splits)\n    else:\n        # Split on the literal space character ' '. This will preserve empty tokens\n        # if there are consecutive spaces (e.g., \"a  b\" -> [\"a\", \"\", \"b\"]).\n        tokens = s.split(' ' if max_splits is None else ' ', max_splits)\n        if not preserve_empty_effective:\n            # If not preserving empty tokens, filter them out.\n            tokens = [t for t in tokens if t != \"\"]\n\n    return tokens"}
{"task_id": "Mbpp/119", "solution": "def search(nums: list[int]) -> int:\n    \"\"\"\n    Finds the single element that appears only once in a sorted array\n    where every other element appears exactly twice, using binary search.\n    \"\"\"\n    low = 0\n    high = len(nums) - 1\n\n    while low < high:\n        mid = (low + high) // 2\n        \n        # If mid is even, check nums[mid] with nums[mid + 1]\n        # The unique element is to the right if they match, or at mid if they don't.\n        if mid % 2 == 0:\n            if nums[mid] == nums[mid + 1]:\n                low = mid + 2\n            else:\n                high = mid\n        # If mid is odd, check nums[mid] with nums[mid - 1]\n        # The unique element is to the right if they match, or to the left if they don't.\n        else: # mid is odd\n            if nums[mid] == nums[mid - 1]:\n                low = mid + 1\n            else:\n                high = mid - 1\n                \n    return nums[low]"}
{"task_id": "Mbpp/120", "solution": "from typing import Sequence, Tuple\n\ndef max_product_tuple(pairs: Sequence[Tuple[int, int]]) -> int:\n    \"\"\"\n    Finds the maximum absolute product between numbers in distinct pairs of tuples.\n    Assumes valid input as per type hints and design context.\n    \"\"\"\n    n = len(pairs)\n    \n    # Initialize with 0. All absolute products are non-negative, so this is a safe starting point.\n    max_absolute_product = 0\n\n    # Iterate through all unique combinations of two distinct tuples (pairs[i] and pairs[j])\n    # The outer loop goes from the first tuple up to the second-to-last.\n    for i in range(n - 1):\n        # Extract elements from the first tuple\n        a1, b1 = pairs[i]\n        \n        # The inner loop starts from the tuple immediately after `i` to ensure distinct tuples\n        # and avoid redundant calculations (e.g., (0,1) vs (1,0)).\n        for j in range(i + 1, n):\n            # Extract elements from the second tuple\n            a2, b2 = pairs[j]\n            \n            # Calculate the absolute value of all four possible products between elements\n            # from the two selected tuples.\n            products_from_pair = [\n                abs(a1 * a2),\n                abs(a1 * b2),\n                abs(b1 * a2),\n                abs(b1 * b2)\n            ]\n            \n            # Find the maximum product among these four for the current pair of tuples.\n            current_max_for_pair = max(products_from_pair)\n            \n            # Update the overall maximum absolute product if the current pair's max is greater.\n            if current_max_for_pair > max_absolute_product:\n                max_absolute_product = current_max_for_pair\n\n    return max_absolute_product"}
{"task_id": "Mbpp/126", "solution": "import math\nimport builtins\n\ndef sum(a: int, b: int) -> int:\n    \"\"\"Calculates the sum of common divisors of two integers a and b.\n    Handles zero inputs and negative numbers according to design specifications.\"\"\"\n\n    def _get_divisors(n: int) -> list[int]:\n        \"\"\"Finds all positive divisors of a given integer n.\"\"\"\n        if n <= 0:\n            return []\n        \n        divs = set()\n        i = 1\n        while i * i <= n:\n            if n % i == 0:\n                divs.add(i)\n                divs.add(n // i)\n            i += 1\n        return list(divs)\n    \n    if a == 0 and b == 0:\n        return 0\n    \n    common_divisor_val = abs(math.gcd(a, b))\n    \n    divisors_of_gcd = _get_divisors(common_divisor_val)\n    \n    return builtins.sum(divisors_of_gcd)"}
{"task_id": "Mbpp/123", "solution": "class AmicableError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass AmicablePair:\n    def __init__(self, a: int, b: int) -> None:\n        if a == b:\n            raise AmicableError(\"amicable pair members must be distinct\")\n        self.a = min(a, b)\n        self.b = max(a, b)\n        self.sum = self.a + self.b\n\n    def __repr__(self) -> str:\n        return f\"AmicablePair({self.a}, {self.b})\"\n\n    def to_tuple(self) -> tuple[int, int]:\n        return (self.a, self.b)\n\nclass DivisorUtils:\n    MINIMUM_SUPPORTED = 2\n\n    def __init__(self) -> None:\n        pass\n\n    def sum_proper_divisors_sieve(self, limit: int) -> list[int]:\n        \"\"\"\n        Computes the sum of proper divisors for all numbers up to 'limit' using a sieve.\n        \"\"\"\n        if limit < self.MINIMUM_SUPPORTED:\n            raise AmicableError(f\"limit must be >= {self.MINIMUM_SUPPORTED}\")\n\n        divs = [0] * (limit + 1)\n\n        for d in range(1, limit // 2 + 1):\n            for m in range(2 * d, limit + 1, d):\n                divs[m] += d\n        return divs\n\n    def sum_proper_divisors(self, n: int) -> int:\n        \"\"\"\n        Computes the sum of proper divisors for a single number n.\n        \"\"\"\n        if n < 1:\n            raise AmicableError(\"n must be a positive integer\")\n        if n == 1:\n            return 0\n        s = 1\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                s += i\n                if i * i != n:\n                    s += n // i\n        return s\n\nclass AmicableCalculator:\n    DEFAULT_MIN_LIMIT = 2\n\n    def __init__(self, divisor_utils: DivisorUtils | None = None) -> None:\n        self.divisor_utils = divisor_utils or DivisorUtils()\n\n    def find_amicable_pairs(self, limit: int) -> list[AmicablePair]:\n        \"\"\"\n        Finds unique amicable pairs (a, b) where a <= limit, with a < b.\n        Includes pairs where b might be greater than limit.\n        \"\"\"\n        if limit < self.DEFAULT_MIN_LIMIT:\n            raise AmicableError(f\"limit must be >= {self.DEFAULT_MIN_LIMIT}\")\n\n        sieve_div_sums = self.divisor_utils.sum_proper_divisors_sieve(limit)\n        found_pairs = set()\n        pairs_list = []\n\n        for a in range(self.DEFAULT_MIN_LIMIT, limit + 1):\n            b = sieve_div_sums[a]\n\n            if b <= a: # Exclude perfect numbers (b=a) and pairs already processed (b<a)\n                continue\n\n            sum_divisors_of_b = 0\n            if b <= limit:\n                sum_divisors_of_b = sieve_div_sums[b]\n            else:\n                sum_divisors_of_b = self.divisor_utils.sum_proper_divisors(b)\n\n            if sum_divisors_of_b == a:\n                pair_tuple = (a, b)\n                if pair_tuple not in found_pairs:\n                    found_pairs.add(pair_tuple)\n                    pairs_list.append(AmicablePair(a, b))\n        return pairs_list\n\n    def sum_amicable_numbers(self, limit: int) -> int:\n        \"\"\"\n        Sums all numbers that are part of an amicable pair (a, b) where the\n        smaller member 'a' is less than or equal to the specified limit.\n        \"\"\"\n        pairs = self.find_amicable_pairs(limit)\n        return sum(p.sum for p in pairs)\n\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"\n    Calculates the sum of all amicable numbers up to the specified limit.\n    \"\"\"\n    calc = AmicableCalculator()\n    return calc.sum_amicable_numbers(limit)"}
{"task_id": "Mbpp/128", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input.\"\"\"\n    pass\n\nPUNCTUATION = \".,;:!?'\\\"()[]{}<>\"\n\ndef normalize_word(word: str) -> str:\n    \"\"\"Strips leading/trailing punctuation from a word.\"\"\"\n    return word.strip(PUNCTUATION)\n\nclass FilterRequest:\n    \"\"\"DTO for a word filtering request.\"\"\"\n    def __init__(self, min_length: int, text: str) -> None:\n        # Normalize negative min_length to 0 as per design rules.\n        self.min_length = max(0, min_length)\n        self.text = text\n\nclass FilterResult:\n    \"\"\"DTO for filtered words result.\"\"\"\n    def __init__(self, words: list[str]) -> None:\n        self.words = words\n\nclass TextParser:\n    \"\"\"Tokenizes text into normalized words.\"\"\"\n    def tokenize(self, text: str) -> list[str]:\n        tokens = []\n        for raw in text.split():\n            w = normalize_word(raw)\n            if w:\n                tokens.append(w)\n        return tokens\n\nclass WordFilterService:\n    \"\"\"Encapsulates word filtering business logic.\"\"\"\n    def __init__(self, parser) -> None:\n        self._parser = parser\n\n    def filter(self, request: FilterRequest) -> FilterResult:\n        \"\"\"Applies length filter to words obtained from the text parser.\"\"\"\n        words = self._parser.tokenize(request.text)\n        filtered = [w for w in words if len(w) > request.min_length]\n        return FilterResult(filtered)\n\ndef long_words(n: int, text: str) -> list[str]:\n    \"\"\"\n    Finds words longer than n characters from a given text.\n    Words are stripped of surrounding punctuation before length check.\n    \"\"\"\n    parser = TextParser()\n    service = WordFilterService(parser)\n    req = FilterRequest(min_length=n, text=text)\n    result = service.filter(req)\n    return result.words"}
