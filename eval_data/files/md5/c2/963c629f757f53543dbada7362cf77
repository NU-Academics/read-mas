{"task_id": "Mbpp/75", "solution": "from typing import Tuple, Any, List\n\nclass InvalidTupleError(Exception):\n    \"\"\"Custom exception for invalid tuple content or structure.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass InvalidParameterError(Exception):\n    \"\"\"Custom exception for invalid function parameters.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nMAX_TUPLE_LENGTH = 1000\n\ndef validate_k(k: Any) -> None:\n    \"\"\"Validates that k is a non-zero integer.\"\"\"\n    if not isinstance(k, int) or k == 0:\n        raise InvalidParameterError(\"k must be a non-zero integer\")\n\ndef validate_tuple_values(values: Tuple[Any, ...]) -> None:\n    \"\"\"Validates that a tuple contains only integers and is within length limits.\"\"\"\n    if not isinstance(values, tuple):\n        raise InvalidTupleError(\"Tuple expected\")\n    if len(values) > MAX_TUPLE_LENGTH:\n        raise InvalidTupleError(f\"Tuple too long, max length is {MAX_TUPLE_LENGTH}\")\n    for v in values:\n        if not isinstance(v, int):\n            raise InvalidTupleError(\"Tuple must contain integers only\")\n\nclass TupleModel:\n    \"\"\"Represents a validated tuple of integers with divisibility checks.\"\"\"\n    def __init__(self, values: Tuple[int, ...]) -> None:\n        validate_tuple_values(values)\n        self.values: Tuple[int, ...] = values\n\n    def all_divisible_by(self, k: int) -> bool:\n        \"\"\"Checks if all elements in the tuple are divisible by k.\"\"\"\n        validate_k(k)\n        return all(v % k == 0 for v in self.values)\n\n    def as_tuple(self) -> Tuple[int, ...]:\n        \"\"\"Returns the underlying tuple.\"\"\"\n        return self.values\n\nclass TupleFilterService:\n    \"\"\"Provides the core business logic for filtering tuples.\"\"\"\n    def find_tuples_from_models(self, models: List[TupleModel], k: int) -> List[TupleModel]:\n        validate_k(k)\n        return [m for m in models if m.all_divisible_by(k)]\n\n    def find_tuples(self, values_list: List[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n        \"\"\"Filters a list of raw tuples, returning those with all elements divisible by k.\"\"\"\n        validate_k(k) # Validate k early, even if values_list is empty\n        models = [TupleModel(values) for values in values_list]\n        return [m.as_tuple() for m in self.find_tuples_from_models(models, k)]\n\nclass TupleController:\n    \"\"\"Adapts service logic for external API calls, handling input and output formats.\"\"\"\n    def __init__(self, service: TupleFilterService) -> None:\n        self._service = service\n\n    def find_tuples(self, values_list: List[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n        \"\"\"Delegates to the service to find matching tuples.\"\"\"\n        return self._service.find_tuples(values_list, k)\n\ndef find_tuples(values_list: List[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n    \"\"\"Finds tuples where all elements are divisible by k from a list of tuples.\"\"\"\n    return TupleController(TupleFilterService()).find_tuples(values_list, k)"}
{"task_id": "Mbpp/77", "solution": "import json\nimport sys\nfrom datetime import datetime, timezone\nfrom typing import Dict, Optional, Union\n\nDEFAULT_LOG_PATH: str = \"./checks.log.jsonl\"\n\nclass NumberModel:\n    \"\"\"Represents and validates numeric input in a normalized string form.\"\"\"\n    def __init__(self, value: Union[int, str]) -> None:\n        self.raw = str(value)\n        self.normalized = self.normalize()\n\n    def normalize(self) -> str:\n        \"\"\"Normalizes the raw input string, removing signs and whitespace.\"\"\"\n        s = self.raw.strip()\n        if s.startswith(('+', '-')):\n            s = s[1:]\n        if not s.isdigit() or len(s) == 0:\n            raise ValueError(f\"Invalid numeric input: {self.raw!r}\")\n        return s\n\n    def as_str(self) -> str:\n        \"\"\"Returns the normalized string representation of the number.\"\"\"\n        return self.normalized\n\nclass CheckResultDTO:\n    \"\"\"Lightweight DTO for structuring persisted check records.\"\"\"\n    def __init__(self, input_value: str, result: bool, timestamp: str) -> None:\n        self.input_value = input_value\n        self.result = result\n        self.timestamp = timestamp\n\n    def to_dict(self) -> Dict:\n        \"\"\"Converts the DTO to a JSON-serializable dictionary.\"\"\"\n        return {\n            \"timestamp\": self.timestamp,\n            \"input\": self.input_value,\n            \"result\": self.result\n        }\n\nclass AlgorithmUtil:\n    \"\"\"Provides the algorithm implementation for divisibility by 11.\"\"\"\n    @staticmethod\n    def _alt_sum(number_str: str) -> int:\n        \"\"\"Calculates the alternating sum of digits for divisibility by 11.\"\"\"\n        total = 0\n        for idx, ch in enumerate(reversed(number_str)):\n            digit = ord(ch) - 48\n            total += digit if (idx % 2 == 0) else -digit\n        return total\n\n    @staticmethod\n    def is_divisible_by_11(number_str: str) -> bool:\n        \"\"\"Checks if a number, represented as a digit-only string, is divisible by 11.\"\"\"\n        alt = AlgorithmUtil._alt_sum(number_str)\n        return abs(alt) % 11 == 0\n\nclass CheckRepository:\n    \"\"\"Appends JSON records to a log file in JSON Lines format.\"\"\"\n    def __init__(self, path: str) -> None:\n        self._path = path\n\n    def append(self, record: Dict) -> None:\n        \"\"\"Appends a JSON serialized dictionary as a new line to the log file.\"\"\"\n        with open(self._path, \"a\", encoding=\"utf-8\") as fh:\n            fh.write(json.dumps(record, ensure_ascii=False) + \"\\n\")\n\nclass DivisibilityService:\n    \"\"\"Orchestrates validation, algorithm invocation, and persistence for divisibility checks.\"\"\"\n    def __init__(self, repo: CheckRepository) -> None:\n        self._repo = repo\n\n    def check(self, number: Union[int, str]) -> bool:\n        \"\"\"Performs a divisibility check, logs the result, and returns a boolean.\"\"\"\n        nm = NumberModel(number)\n        s = nm.as_str()\n        result = AlgorithmUtil.is_divisible_by_11(s)\n        dto = CheckResultDTO(input_value=s, result=result, timestamp=datetime.now(timezone.utc).isoformat())\n        try:\n            self._repo.append(dto.to_dict())\n        except Exception as ex:\n            print(f\"Warning: failed to persist check: {ex}\", file=sys.stderr)\n        return result\n\nclass CLIController:\n    \"\"\"A thin controller that wraps the DivisibilityService for convenient API use.\"\"\"\n    def __init__(self, service: DivisibilityService) -> None:\n        self._service = service\n\n    def is_diff(self, number: Union[int, str]) -> bool:\n        \"\"\"Delegates the divisibility check to the underlying service.\"\"\"\n        return self._service.check(number)\n\nclass CheckerFactory:\n    \"\"\"A factory class for creating configured instances of services and repositories.\"\"\"\n    @staticmethod\n    def default(repo_path: Optional[str] = None) -> DivisibilityService:\n        \"\"\"Creates a default DivisibilityService instance with a CheckRepository.\"\"\"\n        path = repo_path or DEFAULT_LOG_PATH\n        repo = CheckRepository(path)\n        return DivisibilityService(repo)\n\ndef is_Diff(number: Union[int, str]) -> bool:\n    \"\"\"\n    Checks if a given number is divisible by 11.\n    It supports integers and numeric strings, and logs each check.\n    \"\"\"\n    service = CheckerFactory.default()\n    controller = CLIController(service)\n    return controller.is_diff(number)"}
{"task_id": "Mbpp/84", "solution": "_newman_conway_cache = {1: 1, 2: 1}\n\ndef sequence(n: int) -> int:\n    \"\"\"\n    Computes the nth Newman-Conway number using memoization.\n    Assumes n is an integer greater than or equal to 1.\n    \"\"\"\n    if n in _newman_conway_cache:\n        return _newman_conway_cache[n]\n\n    # Compute values up to n, starting from the largest cached index + 1\n    for i in range(max(_newman_conway_cache.keys()) + 1, n + 1):\n        val_i_minus_1 = _newman_conway_cache[i - 1]\n        term1_idx = val_i_minus_1\n        term2_idx = i - val_i_minus_1\n        _newman_conway_cache[i] = _newman_conway_cache[term1_idx] + _newman_conway_cache[term2_idx]\n\n    return _newman_conway_cache[n]"}
