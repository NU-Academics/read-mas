{"task_id": "Mbpp/267", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the squares of the first n odd natural numbers using a closed-form formula.\n    This method provides an O(1) time complexity solution.\n    \"\"\"\n    # The sum of the squares of the first n odd natural numbers is given by the formula:\n    # 4 * sum(k^2 for k=1 to n) - 4 * sum(k for k=1 to n) + n\n    # where sum(k) = n(n+1)/2 and sum(k^2) = n(n+1)(2n+1)/6\n    s_k_squared = n * (n + 1) * (2 * n + 1) // 6\n    s_k = n * (n + 1) // 2\n    return 4 * s_k_squared - 4 * s_k + n"}
{"task_id": "Mbpp/268", "solution": "from dataclasses import dataclass\nfrom typing import Optional, Protocol\n\nclass InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass Validator:\n    @staticmethod\n    def validate_positive_int(n: int, param_name: str = \"n\") -> None:\n        if not isinstance(n, int):\n            raise InvalidInputError(f\"{param_name} must be an integer.\")\n        if n < 1:\n            raise InvalidInputError(f\"{param_name} must be a positive integer (>= 1).\")\n\n@dataclass\nclass StarNumber:\n    n: int\n    value: int\n\n    def to_dict(self) -> dict:\n        return {\"n\": self.n, \"value\": self.value}\n\nclass StarNumberCalculator:\n    def nth(self, n: int) -> int:\n        \"\"\"Computes the n'th star number using the formula S(n) = 6*n*(n-1)+1.\"\"\"\n        return 6 * n * (n - 1) + 1\n\nclass StarNumberRepository(Protocol):\n    def get(self, n: int) -> Optional[int]:\n        ...\n\n    def set(self, n: int, value: int) -> None:\n        ...\n\nclass MemoryStarNumberRepository:\n    def __init__(self) -> None:\n        self._cache: dict[int, int] = {}\n\n    def get(self, n: int) -> Optional[int]:\n        return self._cache.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        self._cache[n] = value\n\nclass StarNumberService:\n    def __init__(self, repo: StarNumberRepository, calculator: StarNumberCalculator) -> None:\n        self._repo = repo\n        self._calculator = calculator\n\n    def get_star_number(self, n: int) -> StarNumber:\n        \"\"\"Validates input, retrieves from cache, or calculates and stores the n'th star number.\"\"\"\n        Validator.validate_positive_int(n)\n        cached = self._repo.get(n)\n        if cached is not None:\n            return StarNumber(n=n, value=cached)\n        value = self._calculator.nth(n)\n        self._repo.set(n, value)\n        return StarNumber(n=n, value=value)\n\nclass StarNumberController:\n    def __init__(self, service: StarNumberService) -> None:\n        self._service = service\n\n    def find_star_num(self, n: int) -> int:\n        \"\"\"Public API method to find the n'th star number, delegating to the service layer.\"\"\"\n        star = self._service.get_star_number(n)\n        return star.value\n\n_default_controller = StarNumberController(\n    StarNumberService(MemoryStarNumberRepository(), StarNumberCalculator())\n)\n\ndef find_star_num(n: int) -> int:\n    \"\"\"\n    Finds the n'th star number using a pre-configured service with caching.\n    \"\"\"\n    return _default_controller.find_star_num(n)"}
{"task_id": "Mbpp/270", "solution": "def sum_even_and_even_index(nums: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of even numbers located at even 0-based indices in a list.\n    Assumes the input list contains only integers.\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(nums):\n        if i % 2 == 0 and num % 2 == 0:\n            total_sum += num\n    return total_sum"}
{"task_id": "Mbpp/271", "solution": "def even_Power_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the first n even natural numbers, each raised to the fifth power.\n    Uses a closed-form formula for efficiency.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    # The sum of the first n even natural numbers raised to the fifth power is:\n    # sum_{k=1..n} (2k)^5 = 32 * sum_{k=1..n} k^5\n    # The sum of the first n natural numbers raised to the fifth power (sum_{k=1..n} k^5) is given by Faulhaber's formula:\n    # (n^2 * (n+1)^2 * (2n^2 + 2n - 1)) / 12\n\n    n_squared = n * n\n    n_plus_1_squared = (n + 1) * (n + 1)\n    term = (2 * n_squared) + (2 * n) - 1\n\n    sum_k_fifth_powers = (n_squared * n_plus_1_squared * term) // 12\n    \n    return 32 * sum_k_fifth_powers"}
