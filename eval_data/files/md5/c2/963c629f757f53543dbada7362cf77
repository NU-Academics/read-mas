{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    This is equivalent to finding the string's minimal period using the KMP prefix function.\n    \"\"\"\n    n = len(s)\n    # The lps array stores the length of the longest proper prefix of s[0...i]\n    # that is also a suffix of s[0...i].\n    lps = [0] * n\n    length = 0  # length of the previous longest prefix suffix\n    i = 1\n\n    # Compute LPS array\n    while i < n:\n        if s[i] == s[length]:\n            length += 1\n            lps[i] = length\n            i += 1\n        else:\n            if length != 0:\n                length = lps[length - 1]\n            else:\n                lps[i] = 0\n                i += 1\n\n    # The length of the smallest repeating unit (period) 'p' is n - lps[-1].\n    # If the string length 'n' is perfectly divisible by 'p', then 'p' is the minimum rotation.\n    # Otherwise, the entire string 'n' is the minimum rotation (no smaller repeating unit).\n    l = lps[-1]\n    p = n - l\n    return p if n % p == 0 else n"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(a, b):\n    \"\"\"\n    Finds the shared elements from two given lists or iterables,\n    preserving the order of appearance from the first iterable.\n    \"\"\"\n\n    import collections.abc\n    import typing\n\n    class InvalidInputError(Exception):\n        \"\"\"Domain-specific exception for invalid inputs.\"\"\"\n        def __init__(self, message: str) -> None:\n            self.message = message\n            super().__init__(self.message)\n\n    class ListPair:\n        \"\"\"Domain container for the two input iterables.\"\"\"\n        def __init__(self, a: typing.Iterable, b: typing.Iterable) -> None:\n            self.a = a\n            self.b = b\n\n        def to_tuple(self) -> typing.Tuple[typing.Iterable, typing.Iterable]:\n            \"\"\"Return (a, b) tuple for convenience.\"\"\"\n            return (self.a, self.b)\n\n    class ResultDTO:\n        \"\"\"Result container with conversion helpers.\"\"\"\n        def __init__(self, items: typing.Tuple[typing.Any, ...]) -> None:\n            self.items = items\n\n        def to_list(self) -> typing.List[typing.Any]:\n            \"\"\"Convert result to a list.\"\"\"\n            return list(self.items)\n\n        def to_tuple(self) -> typing.Tuple[typing.Any, ...]:\n            \"\"\"Return the result as a tuple.\"\"\"\n            return self.items\n\n        def __repr__(self) -> str:\n            return f\"ResultDTO(items={self.items!r})\"\n\n    class Validator:\n        \"\"\"Input validation utilities.\"\"\"\n        def is_iterable(self, obj: typing.Any) -> bool:\n            \"\"\"Return True if obj is iterable (excluding str).\"\"\"\n            return isinstance(obj, collections.abc.Iterable) and not isinstance(obj, str)\n\n        def validate_pair(self, list_pair: ListPair) -> None:\n            \"\"\"Raise InvalidInputError if a or b is None or not iterable.\"\"\"\n            if list_pair.a is None or not self.is_iterable(list_pair.a):\n                raise InvalidInputError(\"Input 'a' must be an iterable and not None.\")\n            if list_pair.b is None or not self.is_iterable(list_pair.b):\n                raise InvalidInputError(\"Input 'b' must be an iterable and not None.\")\n\n    class SetRepository:\n        \"\"\"\n        Converts iterables to set-like structures and supports unhashable fallback.\n        Optionally persists converted sets for caching (not fully implemented).\n        \"\"\"\n        def __init__(self, use_persistence: bool = False) -> None:\n            self._storage_a: typing.Optional[set] = None\n            self._storage_b: typing.Optional[set] = None\n            self._use_persistence = use_persistence # For future use\n\n        @staticmethod\n        def _is_hashable(obj: typing.Any) -> bool:\n            \"\"\"Return True if obj is hashable.\"\"\"\n            try:\n                hash(obj)\n                return True\n            except TypeError:\n                return False\n\n        def to_set(self, iterable: typing.Iterable[typing.Any]) -> typing.Tuple[set, typing.List[typing.Any]]:\n            \"\"\"Extract hashable elements into a set and collect unhashable elements into a list.\"\"\"\n            hashable_set = set()\n            unhashable_list = []\n            for item in iterable:\n                if SetRepository._is_hashable(item):\n                    hashable_set.add(item)\n                else:\n                    unhashable_list.append(item)\n            return hashable_set, unhashable_list\n\n        def intersect(self, a: typing.Iterable[typing.Any], b: typing.Iterable[typing.Any]) -> typing.Tuple[set, typing.List[typing.Any]]:\n            \"\"\"\n            Computes intersection of hashable elements and returns unhashable elements from 'b'.\n            Returns (hashable_intersection_set, unhashable_b_list).\n            \"\"\"\n            hashable_a, _ = self.to_set(a)\n            hashable_b, unhashable_b = self.to_set(b)\n\n            hash_intersection = hashable_a.intersection(hashable_b)\n            return hash_intersection, unhashable_b\n\n    class SimilarityService:\n        \"\"\"Core business logic computing shared elements with deterministic ordering.\"\"\"\n        def __init__(self, repo: SetRepository, validator: Validator) -> None:\n            self.repo = repo\n            self.validator = validator\n\n        def find_shared(self, list_pair: ListPair) -> ResultDTO:\n            \"\"\"\n            Validates inputs, computes intersection, and produces ordered unique shared items.\n            \"\"\"\n            self.validator.validate_pair(list_pair)\n            a, b = list_pair.to_tuple()\n            hash_intersection, unhashable_b = self.repo.intersect(a, b)\n            result_items = self._order_preserved_intersection(a, hash_intersection, unhashable_b)\n            return ResultDTO(result_items)\n\n        def _order_preserved_intersection(self, a: typing.Iterable[typing.Any], b_set: set, unhashable_b: typing.List[typing.Any]) -> typing.Tuple[typing.Any, ...]:\n            \"\"\"\n            Iterates over 'a', includes elements found in 'b_set' or 'unhashable_b',\n            preserving order and ensuring uniqueness.\n            \"\"\"\n            seen = set()\n            result = []\n            \n            # unhashable_b is modified in place to track consumed items from 'b'.\n            # 'list(unhashable_b)' creates a snapshot for each item in 'a' to iterate over,\n            # while `unhashable_b.remove(ub)` modifies the persistent `unhashable_b` list.\n            for item in a:\n                if item in seen:\n                    continue\n\n                if item in b_set:\n                    result.append(item)\n                    seen.add(item)\n                    continue\n\n                # Fallback for unhashable items (compare with equality)\n                # Iterates over a copy for safety, but removes from the original list to consume it.\n                for ub in list(unhashable_b): \n                    if item == ub:\n                        result.append(item)\n                        seen.add(item)\n                        unhashable_b.remove(ub)\n                        break \n            return tuple(result)\n\n    # Instantiate services and run the core logic\n    repo = SetRepository()\n    validator = Validator()\n    service = SimilarityService(repo, validator)\n    list_pair = ListPair(a, b)\n    result_dto = service.find_shared(list_pair)\n    return result_dto.to_tuple()"}
