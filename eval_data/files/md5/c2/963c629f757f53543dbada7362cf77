{"task_id": "Mbpp/92", "solution": "import collections\nimport typing\n\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input scenarios.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass IsUndulatingResult:\n    \"\"\"Data transfer object for the result of an undulating check.\"\"\"\n    def __init__(self, result: bool, pattern: typing.Optional[typing.Tuple[str, str]]) -> None:\n        self.result = result\n        self.pattern = pattern\n\n    def to_dict(self) -> typing.Dict[str, typing.Any]:\n        \"\"\"Returns a dictionary representation of the result.\"\"\"\n        return {\"result\": self.result, \"pattern\": self.pattern}\n\n    def __bool__(self) -> bool:\n        \"\"\"Allows direct boolean evaluation of the result object.\"\"\"\n        return self.result\n\nclass NumberParser:\n    \"\"\"Parses various input types into a normalized digit string.\"\"\"\n    ACCEPTABLE_TYPES = (int, str)\n\n    def parse(self, n: object) -> str:\n        \"\"\"\n        Parses the input `n` into a string of digits.\n\n        Raises InvalidInputError for invalid input types or values.\n        \"\"\"\n        if isinstance(n, int):\n            if n < 0:\n                raise InvalidInputError(\"Negative numbers are not supported\")\n            return str(n)\n        if isinstance(n, str):\n            s = n.strip()\n            if s.startswith('+'):\n                s = s[1:]\n            if s.isdigit():\n                return s\n            raise InvalidInputError(f\"String contains non-digit characters or is malformed: {n!r}\")\n        try:\n            i = int(n)\n            if i < 0:\n                raise InvalidInputError(\"Negative numbers are not supported\")\n            return str(i)\n        except Exception:\n            raise InvalidInputError(f\"Unsupported input type or value: {type(n).__name__}\")\n\nclass UndulatingChecker:\n    \"\"\"Determines whether a given digit string represents an undulating number.\"\"\"\n    MIN_LENGTH_FOR_UNDULATING = 2\n\n    def is_undulating(self, digits: str) -> IsUndulatingResult:\n        \"\"\"\n        Checks if the given digits string is undulating.\n\n        Returns an IsUndulatingResult object.\n        \"\"\"\n        self._validate_digits(digits)\n        ok = self._check_alternation(digits)\n        pattern = None\n        if ok:\n            pattern = (digits[0], digits[1])\n        return IsUndulatingResult(result=ok, pattern=pattern)\n\n    def _validate_digits(self, digits: str) -> None:\n        \"\"\"\n        Ensures the input string consists only of digits.\n\n        Raises InvalidInputError if non-digit characters are found.\n        \"\"\"\n        if not digits.isdigit():\n            raise InvalidInputError(\"Digits string contains non-digit characters\")\n\n    def _check_alternation(self, digits: str) -> bool:\n        \"\"\"\n        Performs the core logic to check for alternating digit pattern.\n\n        Returns True if the digits strictly alternate between two distinct digits, False otherwise.\n        \"\"\"\n        if len(digits) < self.MIN_LENGTH_FOR_UNDULATING:\n            return False\n        a, b = digits[0], digits[1]\n        if a == b:\n            return False\n        for i, ch in enumerate(digits):\n            expected = a if i % 2 == 0 else b\n            if ch != expected:\n                return False\n        return True\n\ndef is_undulating(n: int) -> bool:\n    \"\"\"\n    Checks whether the given number is undulating.\n\n    An undulating number has digits that alternate between exactly two distinct digits (e.g., 12121, 8989).\n    \"\"\"\n    parser = NumberParser()\n    digits = parser.parse(n)\n    checker = UndulatingChecker()\n    result = checker.is_undulating(digits)\n    return bool(result)"}
{"task_id": "Mbpp/93", "solution": "import math\n\ndef power(a, b):\n    # Helper for exponentiation by squaring with non-negative integer exponents.\n    def _fast_pow_int_non_neg(base_val: float, exp_val: int) -> float:\n        res = 1.0\n        curr_base = base_val\n        while exp_val > 0:\n            if exp_val % 2 == 1:\n                res *= curr_base\n            curr_base *= curr_base\n            exp_val //= 2\n        return res\n\n    a_float = float(a)\n    b_float = float(b)\n\n    if b_float.is_integer():\n        b_int = int(b_float)\n\n        if a_float == 0.0:\n            if b_int < 0:\n                # 0.0 to a negative power results in infinity.\n                return math.inf\n            elif b_int == 0:\n                # 0.0 to the power of 0 is 1.0.\n                return 1.0\n            else: # b_int > 0\n                # 0.0 to a positive power is 0.0.\n                return 0.0\n        \n        if b_int < 0:\n            # For negative integer exponents, compute inverse of positive exponent result.\n            positive_exp_val = _fast_pow_int_non_neg(a_float, -b_int)\n            return 1.0 / positive_exp_val\n        else: # b_int >= 0\n            # Use fast exponentiation for non-negative integer exponents.\n            return _fast_pow_int_non_neg(a_float, b_int)\n    else:\n        # For non-integer exponents, use standard math.pow for IEEE semantics.\n        return math.pow(a_float, b_float)"}
{"task_id": "Mbpp/91", "solution": "def find_substring(strings: Optional[Iterable[str]], query: str) -> bool:\n    \"\"\"\n    Checks if a string is present as a substring in a given list of string values.\n    Non-string elements in the list are coerced to string for the check.\n    \"\"\"\n    def coerce_to_str_safe(item: Any) -> str:\n        \"\"\"Converts an item to its string representation, falling back to repr() on error.\"\"\"\n        try:\n            return str(item)\n        except Exception:\n            return repr(item)\n\n    if strings is None:\n        return False\n\n    if query == \"\":\n        return any(True for _ in strings)\n\n    for item in strings:\n        s = coerce_to_str_safe(item)\n        if query in s:\n            return True\n\n    return False"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(items):\n    \"\"\"\n    Returns the first value of the tuple with the smallest second value.\n    If multiple tuples share the same minimal second value, the first encountered is chosen.\n    \"\"\"\n    min_key = None\n    min_val = float('inf')\n\n    for key, val in items:\n        if val < min_val:\n            min_key = key\n            min_val = val\n            \n    return min_key"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(lists):\n    \"\"\"\n    Finds the length of the smallest list in a list of lists.\n    Assumes the input 'lists' is a non-empty list of sequence-like objects.\n    \"\"\"\n    return min(len(inner_list) for inner_list in lists)"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(numbers):\n    \"\"\"\n    Multiplies all numbers in a sequence and divides the product by the sequence's length.\n    \"\"\"\n    product = 1.0\n    for n in numbers:\n        product *= n\n    length = len(numbers)\n    return product / length"}
{"task_id": "Mbpp/97", "solution": "from typing import List, Dict, Any, Hashable, Iterator, Optional\n\nclass FrequencyResult:\n    \"\"\"Data Transfer Object for frequency results.\"\"\"\n    def __init__(self, counts: Dict[Hashable, int]) -> None:\n        self.counts = counts\n\n    def to_dict(self) -> Dict[Hashable, int]:\n        \"\"\"Returns a shallow copy of the counts dictionary.\"\"\"\n        return self.counts.copy()\n\nclass ListFlattener:\n    \"\"\"Utility to flatten a single level of nested lists.\"\"\"\n    def flatten(self, lists: List[List[Any]]) -> Iterator[Any]:\n        if lists is None:\n            return iter(())\n        for inner in lists:\n            yield from inner\n\nclass FrequencyService:\n    \"\"\"Business logic for computing frequency counts.\"\"\"\n    def __init__(self, flattener: ListFlattener) -> None:\n        self.flattener = flattener\n\n    def compute_counts(self, lists: List[List[Hashable]]) -> FrequencyResult:\n        \"\"\"Computes frequency of elements in a list of lists.\"\"\"\n        if lists is None:\n            return FrequencyResult({})\n        iterator = self.flattener.flatten(lists)\n        counts = self._compute_from_iter(iterator)\n        return FrequencyResult(counts)\n\n    def _compute_from_iter(self, iterator: Iterator[Any]) -> Dict[Hashable, int]:\n        \"\"\"Internal helper to count elements from an iterator.\"\"\"\n        counts = {}\n        for elem in iterator:\n            counts[elem] = counts.get(elem, 0) + 1\n        return counts\n\ndef frequency_lists(lists: List[List[Hashable]]) -> Dict[Hashable, int]:\n    \"\"\"\n    Finds the frequency of each element in a flattened list of lists, returned in a dictionary.\n    \"\"\"\n    flattener = ListFlattener()\n    service = FrequencyService(flattener=flattener)\n\n    result = service.compute_counts(lists)\n    return result.to_dict()"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(n: int) -> str:\n    \"\"\"Converts a non-negative decimal integer to its binary string representation.\"\"\"\n    if n == 0:\n        return \"0\"\n\n    binary_digits = []\n    while n > 0:\n        binary_digits.append(str(n % 2))\n        n //= 2\n\n    return \"\".join(reversed(binary_digits))"}
{"task_id": "Mbpp/96", "solution": "import math\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        return f\"InvalidInputError: {self.message}\"\n\nclass DivisorResult:\n    \"\"\"Domain object for storing divisor calculation results.\"\"\"\n    def __init__(self, n: int, count: int, divisors: list[int] | None):\n        self.n = n\n        self.count = count\n        self.divisors = divisors\n\n    def to_dict(self) -> dict[str, any]:\n        return {\"n\": self.n, \"count\": self.count, \"divisors\": self.divisors}\n\nclass Validator:\n    \"\"\"Utility class for input validation.\"\"\"\n    @staticmethod\n    def validate_int(value: any) -> int:\n        try:\n            iv = int(value)\n        except (TypeError, ValueError) as e:\n            raise InvalidInputError(f\"Value '{value}' is not an integer\") from e\n        if iv == 0:\n            raise InvalidInputError(\"Zero is not supported for divisor counting\")\n        return abs(iv)\n\nclass TrialDivisionFactorizer:\n    \"\"\"Factorizes an integer into its prime factors using trial division.\"\"\"\n    def factorize(self, n: int) -> dict[int, int]:\n        if n < 1:\n            raise InvalidInputError(\"Factorization input 'n' must be >= 1\")\n        \n        factors = {}\n        \n        while n % 2 == 0:\n            factors[2] = factors.get(2, 0) + 1\n            n //= 2\n            \n        p = 3\n        while p * p <= n:\n            while n % p == 0:\n                factors[p] = factors.get(p, 0) + 1\n                n //= p\n            p += 2\n            \n        if n > 1:\n            factors[n] = factors.get(n, 0) + 1\n            \n        return factors\n\nclass PrimeFactorizer:\n    \"\"\"Provides a consistent interface for prime factorization, delegating to TrialDivisionFactorizer.\"\"\"\n    def __init__(self):\n        self._default_factorizer = TrialDivisionFactorizer()\n\n    def factorize(self, n: int) -> dict[int, int]:\n        return self._default_factorizer.factorize(n)\n\nclass InMemoryCache:\n    \"\"\"Simple in-memory cache for DivisorResult objects.\"\"\"\n    def __init__(self):\n        self._store: dict[int, DivisorResult] = {}\n\n    def get(self, key: int) -> DivisorResult | None:\n        return self._store.get(key)\n\n    def set(self, key: int, value: DivisorResult) -> None:\n        self._store[key] = value\n    \n    def clear(self) -> None:\n        self._store.clear()\n\nclass DivisorService:\n    \"\"\"Business logic for counting divisors, integrating factorization and caching.\"\"\"\n    def __init__(self, factorizer: PrimeFactorizer, cache: InMemoryCache):\n        self._factorizer = factorizer\n        self._cache = cache\n\n    def count_divisors(self, n: int, include_list: bool=False) -> DivisorResult:\n        n_norm = Validator.validate_int(n)\n\n        cached = self._cache.get(n_norm)\n        if cached and (not include_list or cached.divisors is not None):\n            return cached\n\n        factors = self._factorizer.factorize(n_norm)\n        \n        count = 1\n        for exp in factors.values():\n            count *= (exp + 1)\n        \n        divisors = None # `include_list` is False for the `divisor(n)` function itself.\n        \n        result = DivisorResult(n_norm, count, divisors)\n        self._cache.set(n_norm, result)\n        return result\n\n_default_service = DivisorService(PrimeFactorizer(), InMemoryCache())\n\ndef divisor(n: int) -> int:\n    \"\"\"\n    Finds the number of divisors of a given integer.\n    The function uses a DivisorService, PrimeFactorizer, and InMemoryCache for its operation.\n    \"\"\"\n    return _default_service.count_divisors(n).count"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(s: str) -> str:\n    \"\"\"Converts a snake_case string to PascalCase.\"\"\"\n    tokens = [token for token in s.split('_') if token]\n    return \"\".join(token.capitalize() for token in tokens)"}
{"task_id": "Mbpp/101", "solution": "from typing import Sequence, Any\n\nfrom .models import ArrayModel, KthRequest, KthResponse\nfrom .controllers import KthController\nfrom .services import KthElementService\nfrom .utils import validate_array, validate_k\nfrom .exceptions import KthError, InvalidIndexError\n\n\ndef kth_element(array: Sequence[Any], k: int) -> Any:\n    \"\"\"\n    Finds the k-th element in the given array using 1-based indexing.\n    Raises specific KthErrors for invalid inputs or out-of-range indices.\n    \"\"\"\n    # Validate array and k for basic types and values; these functions raise InvalidInputError.\n    validated_array_data = validate_array(array)\n    validated_k = validate_k(k)\n\n    # Assemble the request using validated inputs.\n    array_model = ArrayModel(validated_array_data)\n    request = KthRequest(array_model, validated_k)\n\n    # Delegate to the controller to process the request.\n    service = KthElementService()\n    controller = KthController(service)\n    response: KthResponse = controller.handle(request)\n\n    # Handle errors returned in the response.\n    if response.error:\n        # Differentiate between InvalidIndexError (from KthElementService) and other KthErrors.\n        if \"is out of range\" in response.error:\n            raise InvalidIndexError(response.error)\n        else:\n            raise KthError(response.error)\n\n    return response.value"}
{"task_id": "Mbpp/100", "solution": "import re\n\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome of a specified integer.\n    \"\"\"\n\n    def _mirror_left(s: str) -> str:\n        \"\"\"Mirrors the left half of a string to create a palindrome of the same length.\"\"\"\n        L = len(s)\n        mid = L // 2\n        left_part = s[:mid]\n        mirrored_right = left_part[::-1]\n        \n        if L % 2 == 1:\n            middle_char = s[mid]\n            return left_part + middle_char + mirrored_right\n        else:\n            return left_part + mirrored_right\n\n    def _increment_part(s: str) -> str:\n        \"\"\"Increments the left half (including middle for odd length) of s, handling carries.\"\"\"\n        s_list = list(s)\n        L = len(s)\n        \n        # mid_start_idx points to the rightmost digit of the effective 'left half' that needs incrementing.\n        # For '123' (L=3), mid_start_idx = 1 (digit '2')\n        # For '1234' (L=4), mid_start_idx = 1 (digit '2')\n        mid_start_idx = (L - 1) // 2 \n        \n        carry = 1\n        for i in range(mid_start_idx, -1, -1):\n            digit = int(s_list[i]) + carry\n            s_list[i] = str(digit % 10)\n            carry = digit // 10\n            if carry == 0:\n                break\n        \n        return \"\".join(s_list)\n\n    s = str(n)\n    \n    # Handle the \"all 9s\" shortcut: e.g., 9 -> 11, 99 -> 101, 999 -> 1001\n    ALL_9S_RE = re.compile(r'^[9]+$')\n    if ALL_9S_RE.match(s):\n        return int('1' + ('0' * (len(s) - 1)) + '1')\n\n    # First attempt: mirror the left half of the original number string\n    mirrored_s = _mirror_left(s)\n    \n    # If this mirrored number is strictly greater than n, it's the next smallest palindrome\n    if int(mirrored_s) > n:\n        return int(mirrored_s)\n    \n    # If not, increment the \"middle\" part of the number string and then mirror again\n    incremented_s = _increment_part(s)\n    final_palindrome_s = _mirror_left(incremented_s)\n    \n    return int(final_palindrome_s)"}
{"task_id": "Mbpp/104", "solution": "def sort_sublists(list_of_lists):\n    \"\"\"\n    Sorts each sublist of strings within a given list of lists.\n    Returns a new list with all sublists sorted lexicographically.\n    \"\"\"\n    sorted_list_of_lists = []\n    for sublist in list_of_lists:\n        sorted_list_of_lists.append(sorted(sublist))\n    return sorted_list_of_lists"}
