))\n            return sentences\n\n    class BoredomCounter:\n        \"\"\"Counts \"boredom\" sentences, which start with \"I\".\"\"\"\n        def __init__(self, sentence_splitter: SentenceSplitter):\n            self._sentence_splitter = sentence_splitter\n\n        def count_boredoms(self, text: str) -> int:\n            \"\"\"Counts sentences starting with \"I\" in the provided text.\"\"\"\n            sentences: List[Sentence] = self._sentence_splitter.split(text)\n            boredom_count = 0\n            for sentence in sentences:\n                if self._is_bored_sentence(sentence):\n                    boredom_count += 1\n            return boredom_count\n\n        def _is_bored_sentence(self, sentence: Sentence) -> bool:\n            \"\"\"Checks if a sentence starts with the word \"I\" (case-sensitive).\"\"\"\n            return sentence.text.startswith(\"I \") or sentence.text == \"I\"\n\n    splitter = SentenceSplitter()\n    counter = BoredomCounter(splitter)\n    return counter.count_boredoms(S)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["I"]]}], "HumanEval/93": [{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Write a function that takes a message, and encodes in such a\n    way that it swaps case of all letters, replaces all vowels in\n    the message with the letter that appears 2 places ahead of that\n    vowel in the english alphabet.\n    \"\"\"\n    VOWELS_LOWER = \"aeiou\"\n    VOWELS_UPPER = \"AEIOU\"\n    ALPHABET_LOWER = \"abcdefghijklmnopqrstuvwxyz\"\n    ALPHABET_UPPER = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n\n    encoded_chars = []\n    for char in message:\n        processed_char = char\n\n        if char.isalpha():\n            # First, apply vowel replacement\n            if char in VOWELS_LOWER:\n                idx = ALPHABET_LOWER.find(char)\n                processed_char = ALPHABET_LOWER[(idx + 2) % len(ALPHABET_LOWER)]\n            elif char in VOWELS_U