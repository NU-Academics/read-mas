{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    \"\"\"\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    integer_part = int(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    if not strings:\n        return []\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/6", "solution": "def parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n\n    def _calculate_group_nesting(group_content: str) -> int:\n        \"\"\"\n        Calculates the deepest nesting level for a single parenthesis group.\n        E.g., '(()())' -> 2, '((()))' -> 3.\n        \"\"\"\n        current_nesting = 0\n        max_nesting = 0\n        for char in group_content:\n            if char == '(':\n                current_nesting += 1\n                if current_nesting > max_nesting:\n                    max_nesting = current_nesting\n            elif char == ')':\n                current_nesting -= 1\n        return max_nesting\n\n    groups = paren_string.split(' ')\n    results = []\n    for group in groups:\n        results.append(_calculate_group_nesting(group))\n    return results"}
{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'. \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/1", "solution": "def separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n\n    def _clean_input(raw_string: str) -> str:\n        \"\"\"Removes all space characters from the raw input string.\"\"\"\n        return raw_string.replace(' ', '')\n\n    def _is_balanced_group(group_content: str) -> bool:\n        \"\"\"Checks if a given string of parentheses is balanced.\"\"\"\n        balance = 0\n        for char in group_content:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    def _identify_groups(cleaned_string: str) -> List[str]:\n        \"\"\"Identifies top-level, non-nested, and balanced parenthesis groups from a cleaned string.\"\"\"\n        groups = []\n        balance = 0\n        start_index = -1\n\n        for i, char in enumerate(cleaned_string):\n            if char == '(':\n                balance += 1\n                if balance == 1:  # Start of a new top-level group\n                    start_index = i\n            elif char == ')':\n                balance -= 1\n                if balance == 0:  # End of a top-level group\n                    group_content = cleaned_string[start_index : i + 1]\n                    if _is_balanced_group(group_content):\n                        groups.append(group_content)\n        return groups\n\n    cleaned_string = _clean_input(paren_string)\n    result_groups = _identify_groups(cleaned_string)\n    return result_groups"}
{"task_id": "HumanEval/3", "solution": "def below_zero(operations: List[int]) -> bool:\n    \"\"\"Detects if an account balance, starting at zero, ever falls below zero.\n    Returns True if the balance goes below zero at any point, False otherwise.\n    \"\"\"\n    current_balance = 0\n    for op in operations:\n        current_balance += op\n        if current_balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/4", "solution": "def calculate_mean(numbers: List[float]) -> float:\n    \"\"\"Calculates the arithmetic mean of a list of numbers.\"\"\"\n    return sum(numbers) / len(numbers)\ndef calculate_absolute_differences(numbers: List[float], mean_value: float) -> List[float]:\n    \"\"\"Calculates the absolute difference between each number in a list and a given mean value.\"\"\"\n    return [abs(number - mean_value) for number in numbers]\ndef calculate_average_of_differences(absolute_differences: List[float]) -> float:\n    \"\"\"Calculates the average of a list of absolute differences.\"\"\"\n    return sum(absolute_differences) / len(absolute_differences)\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    mean_value = calculate_mean(numbers)\n    absolute_differences = calculate_absolute_differences(numbers, mean_value)\n    mad_value = calculate_average_of_differences(absolute_differences)\n    return mad_value"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    a = abs(a)\n    b = abs(b)\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/14", "solution": "def all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    if not string:\n        return []\n\n    prefixes = []\n    for i in range(1, len(string) + 1):\n        prefixes.append(string[0:i])\n    return prefixes"}
{"task_id": "HumanEval/12", "solution": "def longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_str: Optional[str] = None\n    max_len = -1\n\n    for s in strings:\n        current_len = len(s)\n        if current_len > max_len:\n            max_len = current_len\n            longest_str = s\n    \n    return longest_str"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n\n    # Helper function to reverse a string\n    def _reverse_string(s: str) -> str:\n        return s[::-1]\n\n    # Helper function to find the longest palindromic postfix\n    def _find_longest_palindromic_postfix(s: str) -> str:\n        for i in range(len(s)):\n            postfix = s[i:]\n            # is_palindrome is available from the outer scope\n            if is_palindrome(postfix):\n                return postfix\n        return \"\" # Handles empty input string case. For non-empty, a single character is always a palindrome.\n\n    # Helper function to get the prefix before a given postfix\n    def _get_prefix_before_postfix(original: str, postfix: str) -> str:\n        # Assumes original string ends with the given postfix\n        prefix_length = len(original) - len(postfix)\n        return original[:prefix_length]\n\n    # Handle the empty string case explicitly\n    if not string:\n        return \"\"\n\n    # Find the longest palindromic postfix of the input string\n    longest_postfix = _find_longest_palindromic_postfix(string)\n\n    # Get the prefix of the string that comes before this palindromic postfix\n    prefix_before_postfix = _get_prefix_before_postfix(string, longest_postfix)\n\n    # Reverse this prefix\n    reversed_prefix = _reverse_string(prefix_before_postfix)\n\n    # Concatenate the original string with the reversed prefix to form the shortest palindrome\n    return string + reversed_prefix"}
{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    current_max = float('-inf')\n    for num in numbers:\n        current_max = max(current_max, num)\n        result.append(current_max)\n    return result"}
{"task_id": "HumanEval/11", "solution": "from typing import List\ndef _perform_char_wise_xor(a: str, b: str) -> str:\n    \"\"\"Executes the character-wise binary XOR logic on equally sized, validated inputs.\"\"\"\n    result_chars = []\n    for char_a, char_b in zip(a, b):\n        if char_a == char_b:\n            result_chars.append('0')\n        else:\n            result_chars.append('1')\n    return \"\".join(result_chars)\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    _validate_binary_content(a, 'a')\n    _validate_binary_content(b, 'b')\n    _validate_equal_length(a, b)\n    return _perform_char_wise_xor(a, b)"}
{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    >>> string_sequence(0)\n    '0'\n    >>> string_sequence(5)\n    '0 1 2 3 4 5'\n    \"\"\"\n    numbers_as_strings = [str(i) for i in range(n + 1)]\n    return \" \".join(numbers_as_strings)"}
{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\" Find how many times a given substring can be found in the original string. Count overlaping cases.\n    >>> how_many_times('', 'a')\n    0\n    >>> how_many_times('aaa', 'a')\n    3\n    >>> how_many_times('aaaa', 'aa')\n    3\n    \"\"\"\n    # If the original string is empty, no substring can be found, return 0.\n    if not string:\n        return 0\n\n    # If the substring is empty, it matches before every character and at the end of the string.\n    # The design specifies len(original_string) + 1 for non-empty original_string.\n    if not substring:\n        return len(string) + 1\n\n    count = 0\n    len_string = len(string)\n    len_substring = len(substring)\n\n    # Iterate through the string, checking for the substring at each possible starting position,\n    # including overlapping occurrences.\n    for i in range(len_string - len_substring + 1):\n        if string[i : i + len_substring] == substring:\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/19", "solution": "from typing import List\nclass NumberWord:\n    \"\"\"Represents a number word and its numerical value, enabling comparison.\"\"\"\n    def __init__(self, text: str, value: int):\n        self.text = text\n        self.value = value\n\n    def __lt__(self, other: 'NumberWord') -> bool:\n        \"\"\"Enables comparison for sorting based on numerical value.\"\"\"\n        return self.value < other.value\nclass NumberWordSorter:\n    \"\"\"Manages conversion between number words and numerical values, and performs the sorting.\"\"\"\n    _word_to_value_map: dict[str, int] = {\n        'zero': 0, 'one': 1, 'two': 2, 'three': 3, 'four': 4,\n        'five': 5, 'six': 6, 'seven': 7, 'eight': 8, 'nine': 9\n    }\n    _value_to_word_map: dict[int, str] = {\n        0: 'zero', 1: 'one', 2: 'two', 3: 'three', 4: 'four',\n        5: 'five', 6: 'six', 7: 'seven', 8: 'eight', 9: 'nine'\n    }\n\n    def __init__(self):\n        pass\n\n    def sort(self, input_string: str) -> str:\n        \"\"\"Converts space-delimited number words into objects, sorts them, and returns a space-delimited string.\"\"\"\n        words = input_string.split(' ')\n        number_words: List[NumberWord] = []\n        for word_text in words:\n            value = self._word_to_value_map[word_text]\n            number_words.append(NumberWord(word_text, value))\n\n        number_words.sort()\n\n        sorted_word_texts = [nw.text for nw in number_words]\n        return ' '.join(sorted_word_texts)\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    sorter = NumberWordSorter()\n    return sorter.sort(numbers)"}
