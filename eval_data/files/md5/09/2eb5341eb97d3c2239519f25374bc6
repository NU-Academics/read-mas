{"task_id": "Mbpp/11", "solution": "def remove_Occ(s, ch):\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    If the character occurs only once, that single occurrence is removed.\n    \"\"\"\n    first_idx = s.find(ch)\n    if first_idx == -1:\n        return s\n    \n    last_idx = s.rfind(ch)\n    \n    if first_idx == last_idx:\n        return s[:first_idx] + s[first_idx+1:]\n    else:\n        # Remove both first and last occurrences\n        return s[:first_idx] + s[first_idx+1:last_idx] + s[last_idx+1:]"}
{"task_id": "Mbpp/8", "solution": "from typing import List, Union\ndef square_nums(input_list: List[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\"\n    Computes the square of each individual element in a list of numbers.\n    Assumes valid numeric input (int or float) and returns a list of squared numbers.\n    \"\"\"\n    return [x * x for x in input_list]"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(list_a, list_b):\n    \"\"\"\n    Finds unique shared elements between two lists, preserving order from the first list.\n    \"\"\"\n    set_b = set(list_b)\n    seen_in_result = set()\n    result = []\n    for item in list_a:\n        if item in set_b and item not in seen_in_result:\n            result.append(item)\n            seen_in_result.add(item)\n    return result"}
{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import Sequence, List\ndef heap_queue_largest(numbers: Sequence[int], n: int) -> List[int]:\n    \"\"\"Finds the n largest integers from a list, returned in descending order.\"\"\"\n    if n <= 0:\n        return []\n    top_n = heapq.nlargest(n, numbers)\n    return sorted(top_n, reverse=True)"}
{"task_id": "Mbpp/3", "solution": "import math\ndef is_not_prime(n: int) -> bool:\n    \"\"\"\n    Checks if a given integer is a non-prime number.\n    Returns True for numbers less than or equal to 1, or composite numbers.\n    \"\"\"\n    if n <= 1:\n        return True\n    if n == 2:\n        return False\n    if n % 2 == 0:\n        return True\n\n    limit = math.isqrt(n)\n    for i in range(3, limit + 1, 2):\n        if n % i == 0:\n            return True\n\n    return False"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum positive number of rotations to get the same string.\n    This implementation uses the KMP prefix function to find the smallest period.\n    \"\"\"\n    n = len(s)\n    \n    def _is_all_same(s_param: str) -> bool:\n        # Checks if all characters are the same. Assumes s_param is non-empty.\n        return all(ch == s_param[0] for ch in s_param)\n\n    if _is_all_same(s):\n        return 1\n\n    # Compute the KMP prefix function, where pi[i] is the length of the longest proper prefix\n    # of s[0...i] that is also a suffix of s[0...i].\n    pi = [0] * n\n    for i in range(1, n):\n        j = pi[i-1]\n        while j > 0 and s[i] != s[j]:\n            j = pi[j-1]\n        if s[i] == s[j]:\n            j += 1\n        pi[i] = j\n\n    # The minimal period of the string is n - pi[-1]. If n is divisible by this period,\n    # it is the minimum number of rotations; otherwise, n rotations are needed.\n    period = n - pi[-1]\n    return period if n % period == 0 else n"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(a, b):\n    \"\"\"\n    Checks if two integers differ in exactly one bit position.\n    This is true if their XOR result is a power of two.\n    \"\"\"\n    xor_val = a ^ b\n    return xor_val != 0 and (xor_val & (xor_val - 1)) == 0"}
{"task_id": "Mbpp/7", "solution": "def find_char_long(text):\n    \"\"\"\n    Finds all words at least 4 characters long in the given string.\n    Words are defined as sequences of alphabetic characters, possibly with internal hyphens or apostrophes.\n    \"\"\"\n    import re\n\n    # According to the design context, WORD_REGEX handles Unicode letters, hyphens, and apostrophes.\n    WORD_REGEX = r\"[A-Za-z\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]+(?:[-'][A-Za-z\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]+)*\"\n    \n    # Tokenize the text using the defined regex\n    tokens = re.findall(WORD_REGEX, text)\n    \n    # Filter tokens by length >= 4 and collect them into a set\n    long_words = {word for word in tokens if len(word) >= 4}\n    \n    return long_words"}
{"task_id": "Mbpp/16", "solution": "import re\ndef text_lowercase_underscore(text: str) -> bool:\n    \"\"\"\n    Checks if the input string contains sequences of lowercase letters\n    joined by a single underscore, matching the pattern ^[a-z]+_[a-z]+$.\n    \"\"\"\n    pattern = r\"^[a-z]+_[a-z]+$\"\n    normalized_text = text.strip()\n    return bool(re.fullmatch(pattern, normalized_text))"}
{"task_id": "Mbpp/12", "solution": "from typing import List, Union\ndef sort_matrix(matrix: List[List[Union[int, float]]]) -> List[List[Union[int, float]]]:\n    \"\"\"Sorts a matrix in ascending order according to the sum of its rows.\n    This function performs a stable sort, preserving the relative order of rows with equal sums.\"\"\"\n    return sorted([list(row) for row in matrix], key=lambda row: sum(float(x) for x in row))"}
{"task_id": "Mbpp/17", "solution": "def square_perimeter(side):\n    \"\"\"Calculates the perimeter of a square.\n    Assumes 'side' is a valid non-negative numeric value as per overriding requirements.\n    \"\"\"\n    return float(side) * 4"}
{"task_id": "Mbpp/14", "solution": "def find_Volume(base, height, length):\n    \"\"\"\n    Calculates the volume of a triangular prism.\n    The volume is derived from the area of the triangular base multiplied by the prism's length.\n    \"\"\"\n    triangle_area = 0.5 * base * height\n    volume = triangle_area * length\n    return volume"}
{"task_id": "Mbpp/56", "solution": "def check(n):\n    \"\"\"Checks if n is one less than twice its reverse.\"\"\"\n    # Compute the reverse of the absolute value of n\n    s = str(abs(n))\n    rs = s[::-1].lstrip(\"0\")\n    reversed_val = int(rs) if rs else 0\n\n    # Check if n equals (2 * reversed_val) - 1\n    return n == (2 * reversed_val - 1)"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is a Woodall number (W_n = n * 2^n - 1 for n >= 1).\n    Iteratively computes Woodall numbers up to a practical limit for n.\n    \"\"\"\n    if number < 0:\n        return False\n\n    # Max limit for n, derived from the design context to handle realistic inputs\n    # without excessive computation, as W_n grows very quickly.\n    MAX_N_LIMIT = 64\n\n    for n in range(1, MAX_N_LIMIT + 1):\n        woodall_value = n * (2**n) - 1\n        if woodall_value == number:\n            return True\n        # Optimization: if current Woodall number exceeds the target,\n        # all subsequent Woodall numbers will also be larger.\n        if woodall_value > number:\n            return False\n            \n    return False"}
{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(s: str, dirty: str, case_sensitive: bool = True) -> str:\n    \"\"\"Removes characters from the first string that are present in the second string, preserving original order.\"\"\"\n\n    def _get_char_for_comparison(char_val: str, apply_case_sensitive_rules: bool) -> str:\n        \"\"\"Returns the character as-is or casefolded based on case sensitivity rules for comparison.\"\"\"\n        return char_val if apply_case_sensitive_rules else char_val.casefold()\n\n    # Build a set of characters to be removed, normalized by the case_sensitive flag.\n    chars_to_remove_set = {\n        _get_char_for_comparison(char_dirty, case_sensitive)\n        for char_dirty in dirty\n    }\n\n    result_chars = []\n    for char_s in s:\n        # Normalize the current character from the input string for comparison.\n        if _get_char_for_comparison(char_s, case_sensitive) not in chars_to_remove_set:\n            result_chars.append(char_s)\n\n    return ''.join(result_chars)"}
{"task_id": "Mbpp/19", "solution": "from typing import List, Any, Optional, Iterable\nimport json\nimport sqlite3\nimport datetime\nclass DuplicateCheckerError(Exception):\n    \"\"\"Base exception for duplicate checker operations.\"\"\"\n    pass\nclass InvalidInputError(DuplicateCheckerError):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    pass\nDEFAULT_STRATEGY: str = \"set\"\nALLOWED_STRATEGIES: tuple[str, ...] = (\"set\", \"sort\", \"brute\")\nPERSISTENCE_ENABLED: bool = False\nSQLITE_DB_PATH: str = \"duplicate_checks.db\"\nTABLE_SCHEMA: str = \"\"\"\nCREATE TABLE IF NOT EXISTS checks (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    created_at TEXT NOT NULL,\n    items TEXT NOT NULL,\n    result INTEGER NOT NULL,\n    strategy TEXT NOT NULL\n);\n\"\"\"\ndef validate_array(arr: Any) -> List[int]:\n    \"\"\"Validates input to ensure it's an iterable of integers, converting JSON strings if necessary.\"\"\"\n    if isinstance(arr, str):\n        try:\n            parsed = json.loads(arr)\n        except json.JSONDecodeError as e:\n            raise InvalidInputError(f\"Invalid JSON string for array: {e}\")\n        arr = parsed\n\n    if not hasattr(arr, \"__iter__\") or isinstance(arr, (dict, str)):\n        raise InvalidInputError(\"Input must be an iterable of integers\")\n\n    items = []\n    for i, v in enumerate(arr):\n        try:\n            items.append(int(v))\n        except (ValueError, TypeError):\n            raise InvalidInputError(f\"Element at index {i} is not integer-convertible: {repr(v)}\")\n    return items\nclass ArrayRepository:\n    \"\"\"Handles optional persistence of check records to an SQLite database.\"\"\"\n    def __init__(self, db_path: str = SQLITE_DB_PATH) -> None:\n        self.db_path = db_path\n        if PERSISTENCE_ENABLED:\n            self.init_db()\n\n    def init_db(self) -> None:\n        \"\"\"Initializes the database by creating the 'checks' table if it doesn't exist.\"\"\"\n        try:\n            with sqlite3.connect(self.db_path) as conn:\n                conn.execute(TABLE_SCHEMA)\n        except sqlite3.Error as e:\n            raise DuplicateCheckerError(f\"Database initialization failed: {e}\") from e\n\n    def save_check(self, items: List[int], result: bool, strategy: str) -> int:\n        \"\"\"Saves a duplicate check record to the database, returning its ID.\"\"\"\n        if not PERSISTENCE_ENABLED:\n            return -1\n\n        try:\n            with sqlite3.connect(self.db_path) as conn:\n                cur = conn.cursor()\n                cur.execute(\n                    \"INSERT INTO checks (created_at, items, result, strategy) VALUES (?, ?, ?, ?)\",\n                    (datetime.datetime.utcnow().isoformat(), json.dumps(items), int(result), strategy),\n                )\n                return cur.lastrowid\n        except sqlite3.Error as e:\n            raise DuplicateCheckerError(f\"Failed to save check record: {e}\") from e\nclass DuplicateService:\n    \"\"\"Provides various algorithms for duplicate detection.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def has_duplicates(self, items: List[int], strategy: str = DEFAULT_STRATEGY) -> bool:\n        \"\"\"Dispatches to the selected duplicate detection strategy.\"\"\"\n        if strategy not in ALLOWED_STRATEGIES:\n            raise ValueError(f\"Unknown strategy: {strategy}. Allowed strategies are: {', '.join(ALLOWED_STRATEGIES)}\")\n\n        if strategy == \"set\":\n            return self._has_duplicates_set(items)\n        elif strategy == \"sort\":\n            return self._has_duplicates_sort(items)\n        elif strategy == \"brute\":\n            return self._has_duplicates_brute(items)\n        return False\n\n    def _has_duplicates_set(self, items: List[int]) -> bool:\n        \"\"\"Checks for duplicates using a hash set, offering O(n) average time complexity.\"\"\"\n        seen = set()\n        for x in items:\n            if x in seen:\n                return True\n            seen.add(x)\n        return False\n\n    def _has_duplicates_sort(self, items: List[int]) -> bool:\n        \"\"\"Checks for duplicates by sorting the array, then comparing adjacent elements (O(n log n) time).\"\"\"\n        if not items:\n            return False\n        sorted_items = sorted(items)\n        for i in range(len(sorted_items) - 1):\n            if sorted_items[i] == sorted_items[i+1]:\n                return True\n        return False\n\n    def _has_duplicates_brute(self, items: List[int]) -> bool:\n        \"\"\"Checks for duplicates using a brute-force O(n^2) comparison of all pairs.\"\"\"\n        n = len(items)\n        for i in range(n):\n            for j in range(i + 1, n):\n                if items[i] == items[j]:\n                    return True\n        return False\nclass DuplicateController:\n    \"\"\"Manages input validation, calls to the DuplicateService, and optional persistence.\"\"\"\n    def __init__(self, service: DuplicateService, repository: Optional[ArrayRepository] = None) -> None:\n        self.service = service\n        self.repository = repository\n\n    def test_duplicate(self, arr: Any, strategy: Optional[str] = None) -> bool:\n        \"\"\"Validates the input array, checks for duplicates, and optionally records the check.\"\"\"\n        items = validate_array(arr)\n        \n        chosen_strategy = strategy if strategy is not None else DEFAULT_STRATEGY\n        if chosen_strategy not in ALLOWED_STRATEGIES:\n            raise ValueError(f\"Invalid strategy '{chosen_strategy}'. Allowed are: {', '.join(ALLOWED_STRATEGIES)}\")\n\n        result = self.service.has_duplicates(items, chosen_strategy)\n\n        if self.repository and PERSISTENCE_ENABLED:\n            self.repository.save_check(items, result, chosen_strategy)\n        return result\ndef test_duplicate(arr: Iterable[int], strategy: Optional[str] = None) -> bool:\n    \"\"\"\n    Determines if a given array of integers contains any duplicate element.\n    It uses a set-based strategy by default for efficient checking.\n    \"\"\"\n    duplicate_service = DuplicateService()\n    array_repository = ArrayRepository()\n    \n    controller = DuplicateController(service=duplicate_service, repository=array_repository)\n    return controller.test_duplicate(arr, strategy)"}
