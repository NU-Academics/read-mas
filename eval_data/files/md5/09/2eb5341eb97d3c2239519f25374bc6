{"task_id": "Mbpp/297", "solution": "def flatten_list(nested_list):\n    \"\"\"\n    Flattens a nested list structure into a single-level list.\n    Preserves the order of elements encountered during a depth-first traversal.\n    \"\"\"\n    result = []\n    # Initialize the stack with the input list.\n    # The elements of the input list itself will be processed from left to right.\n    # We push the input list onto the stack, and then when popped, its elements\n    # are pushed in reverse to maintain order when subsequent elements are popped.\n    stack = [nested_list]\n\n    while stack:\n        current_item = stack.pop()\n\n        if isinstance(current_item, list):\n            # If it's a list, push its elements onto the stack in reverse order\n            # so that the leftmost elements are processed first.\n            for item in reversed(current_item):\n                stack.append(item)\n        else:\n            # If it's a scalar (non-list), append it to the result list.\n            result.append(current_item)\n            \n    return result"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(entries):\n    \"\"\"\n    Calculates the maximum aggregate value from a list of (name, value) tuples.\n    Tie-breaks by selecting the lexicographically smallest name if totals are equal.\n    \"\"\"\n    aggregated_totals = {}\n    for name, value in entries:\n        normalized_name = name.strip()\n        aggregated_totals[normalized_name] = aggregated_totals.get(normalized_name, 0) + value\n\n    if not aggregated_totals:\n        # Return a default value for no data, as raising an exception is disallowed by constraints.\n        return ('', 0)\n\n    max_total = max(aggregated_totals.values())\n    \n    # Identify all names that achieved the maximum total.\n    potential_winners = [name for name, total in aggregated_totals.items() if total == max_total]\n    \n    # Apply tie-breaking: choose the lexicographically smallest name among winners.\n    winner_name = min(potential_winners)\n    \n    return (winner_name, max_total)"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(d: dict) -> int:\n    \"\"\"Calculates the maximum nesting depth of a dictionary.\n    The top-level dictionary counts as depth 1.\n    \"\"\"\n    max_depth = 1\n    for value in d.values():\n        if isinstance(value, dict):\n            # Recursively find the depth of nested dictionaries.\n            nested_depth = dict_depth(value) + 1\n            if nested_depth > max_depth:\n                max_depth = nested_depth\n    return max_depth"}
{"task_id": "Mbpp/305", "solution": "def start_withp(words: list) -> tuple:\n    \"\"\"Returns the first two words from a list of strings that start with 'p' (case-insensitive).\"\"\"\n    p_words = []\n    for line in words:\n        tokens = line.split()\n        for token in tokens:\n            if token and token[0].lower() == 'p':\n                p_words.append(token)\n                if len(p_words) == 2:\n                    return (p_words[0], p_words[1])"}
{"task_id": "Mbpp/306", "solution": "from typing import List\ndef max_sum_increasing_subseq(arr: List[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from arr[0...i]\n    that must include arr[k] where arr[k] is the last element.\n    \"\"\"\n    # dp[j] stores the maximum sum of an increasing subsequence ending at arr[j]\n    # using elements from the prefix arr[0...j].\n    dp = [0] * (i + 1)\n\n    # Compute DP for the prefix arr[0...i]\n    for j in range(i + 1):\n        dp[j] = arr[j] # Initialize with the element itself\n        for t in range(j):\n            if arr[t] < arr[j] and dp[t] + arr[j] > dp[j]:\n                dp[j] = dp[t] + arr[j]\n\n    # Find the maximum sum from dp such that the last element arr[j] is less than arr[k]\n    best_prefix_sum = 0\n    val_k = arr[k]\n    for j in range(i + 1):\n        if arr[j] < val_k and dp[j] > best_prefix_sum:\n            best_prefix_sum = dp[j]\n\n    # The result is the best prefix sum found plus arr[k]\n    return best_prefix_sum + val_k"}
{"task_id": "Mbpp/309", "solution": "def maximum(a, b):\n    \"\"\"\n    Returns the maximum of two numbers after validating their types.\n    Supports int, float, and decimal.Decimal, raising InvalidNumberError for unsupported types.\n    \"\"\"\n    from decimal import Decimal, InvalidOperation\n    from typing import Union, Any\n\n    class InvalidNumberError(ValueError):\n        \"\"\"Custom exception raised for invalid number inputs.\"\"\"\n        def __init__(self, message: str):\n            super().__init__(message)\n\n    Number = Union[int, float, Decimal]\n    allowed_types = (int, float, Decimal)\n\n    def _validate(value: Any) -> Number:\n        \"\"\"Validates if a value is a number or can be converted to one.\"\"\"\n        if isinstance(value, allowed_types):\n            return value\n        if isinstance(value, str):\n            try:\n                return Decimal(value)\n            except InvalidOperation:\n                raise InvalidNumberError(f\"Cannot parse '{value}' as a number\")\n        raise InvalidNumberError(f\"Unsupported type: {type(value).__name__}\")\n\n    validated_a = _validate(a)\n    validated_b = _validate(b)\n\n    return validated_a if validated_a >= validated_b else validated_b"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n):\n    \"\"\"\n    Finds the highest power of 2 that is less than or equal to n.\n    Assumes n is a positive integer.\n    \"\"\"\n    # For a positive integer n, n.bit_length() gives the number of bits required to represent n.\n    # For example, if n=10 (binary 1010), bit_length is 4.\n    # The highest power of 2 less than or equal to n is 2 raised to (bit_length - 1).\n    # 2^(bit_length - 1) is equivalent to 1 shifted left by (bit_length - 1) positions.\n    return 1 << (n.bit_length() - 1)"}
