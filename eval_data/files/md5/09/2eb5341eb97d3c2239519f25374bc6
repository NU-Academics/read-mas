{"task_id": "Mbpp/803", "solution": "def is_perfect_square(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is a perfect square using integer arithmetic.\n    It returns True if the number is a perfect square, False otherwise.\n    \"\"\"\n    if number < 0:\n        return False\n\n    # Numbers 0 and 1 are perfect squares (0*0=0, 1*1=1).\n    if number < 2:\n        return True\n\n    # Use binary search to find the integer square root (floor value).\n    # The search range for the root is from 1 up to number // 2.\n    low, high = 1, number // 2\n\n    # In the loop, `high` will eventually store the floor of the square root if no exact match is found.\n    while low <= high:\n        mid = (low + high) // 2\n        square = mid * mid\n\n        if square == number:\n            return True  # Found the exact integer square root\n        elif square < number:\n            low = mid + 1  # The root is in the upper half\n        else:  # square > number\n            high = mid - 1  # The root is in the lower half\n\n    # If the loop completes without finding an exact match, 'high' will be floor(sqrt(number)).\n    # Check if squaring this floor value equals the original number.\n    return high * high == number"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a, b, c):\n    \"\"\"\n    Counts the number of equal numbers among three given integers.\n    Returns 3 if all are equal, 2 if exactly two are equal, and 0 if none are equal.\n    \"\"\"\n    if a == b == c:\n        return 3\n    if a == b or a == c or b == c:\n        return 2\n    return 0"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(lists):\n    \"\"\"\n    Returns the sub-list from a list of lists whose sum of elements is the highest.\n    On ties, the first encountered list is returned.\n    \"\"\"\n    max_list = lists[0]\n    max_current_sum = sum(lists[0])\n\n    for sublist in lists[1:]:\n        current_sum = sum(sublist)\n        if current_sum > max_current_sum:\n            max_current_sum = current_sum\n            max_list = sublist\n            \n    return max_list"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(s: str) -> int:\n    \"\"\"Finds the maximum contiguous run of uppercase characters in the given string.\"\"\"\n    max_len = 0\n    current_len = 0\n    for char in s:\n        if char.isupper():\n            current_len += 1\n            if current_len > max_len:\n                max_len = current_len\n        else:\n            current_len = 0\n    return max_len"}
