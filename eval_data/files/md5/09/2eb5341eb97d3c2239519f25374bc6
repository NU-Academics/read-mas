{"task_id": "Mbpp/603", "solution": "from typing import List, Optional, Any\nclass LudicError(Exception):\n    \"\"\"Custom exception for Ludic number generation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass Validator:\n    \"\"\"Utility class for input validation.\"\"\"\n    def validate_positive_int(self, value: Any, name: str = \"max_n\") -> int:\n        \"\"\"\n        Validates that a value is a positive integer, raising LudicError on failure.\n        \"\"\"\n        if not isinstance(value, int):\n            try:\n                value = int(value)\n            except (ValueError, TypeError) as e:\n                raise LudicError(f\"{name} must be an integer, but got {type(value).__name__}\") from e\n\n        if value < 1:\n            raise LudicError(f\"{name} must be a positive integer (>= 1), but got {value}\")\n        return value\nclass NumberSequence:\n    \"\"\"Domain model representing a sequence of numbers with sieve operations.\"\"\"\n    def __init__(self, numbers: List[int]) -> None:\n        self._numbers: List[int] = numbers\n\n    def remove_every_kth(self, k: int, start_index: int = 0) -> None:\n        \"\"\"\n        Removes every k-th element from the sequence, counting from start_index.\n        \"\"\"\n        if k <= 0:\n            return\n\n        out = []\n        count = 0\n        for idx, val in enumerate(self._numbers):\n            if idx < start_index:\n                out.append(val)\n            else:\n                count += 1\n                if count % k != 0:\n                    out.append(val)\n        self._numbers = out\n\n    def to_list(self, limit: Optional[int] = None) -> List[int]:\n        \"\"\"\n        Returns a shallow copy of the numbers, optionally filtered by a value limit.\n        \"\"\"\n        if limit is None:\n            return list(self._numbers)\n        return [x for x in self._numbers if x <= limit]\nclass SequenceRepository:\n    \"\"\"Repository for generating ludic number sequences using a sieve algorithm.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def generate(self, max_n: int) -> 'NumberSequence':\n        \"\"\"\n        Generates an initial sequence of numbers and applies the ludic sieve algorithm.\n        \"\"\"\n        nums = list(range(1, max_n + 1))\n        seq = NumberSequence(nums)\n        self._apply_sieve(seq)\n        return seq\n\n    def _apply_sieve(self, seq: 'NumberSequence') -> None:\n        \"\"\"\n        Applies the Josephus-like sieve algorithm to the number sequence in-place.\n        \"\"\"\n        i = 0\n        while i < len(seq._numbers):\n            s = seq._numbers[i]\n            \n            # The number 1 is ludic but does not remove any subsequent elements in the sieve.\n            if s <= 1:\n                i += 1\n                continue\n            \n            # If there are no elements left after the current ludic number to apply the sieve to, stop.\n            if i + 1 >= len(seq._numbers):\n                break\n            \n            # Apply the sieve: remove every s-th element from the sequence, starting from the element after s.\n            seq.remove_every_kth(s, start_index=i+1)\n            i += 1\nclass LudicService:\n    \"\"\"Service layer for computing ludic numbers, orchestrating validation and generation.\"\"\"\n    def __init__(self, repo: 'SequenceRepository', validator: 'Validator') -> None:\n        self._repo = repo\n        self._validator = validator\n\n    def compute(self, max_n: int) -> List[int]:\n        \"\"\"\n        Computes ludic numbers up to max_n after validating the input.\n        \"\"\"\n        n = self._validator.validate_positive_int(max_n)\n        seq = self._repo.generate(n)\n        return seq.to_list(limit=n)\nclass LudicController:\n    \"\"\"Controller for the public API, handling input and delegating to the service layer.\"\"\"\n    def __init__(self, service: 'LudicService') -> None:\n        self._service = service\n\n    def get_ludic(self, max_n: int) -> List[int]:\n        \"\"\"\n        Retrieves all ludic numbers less than or equal to max_n.\n        \"\"\"\n        return self._service.compute(max_n)\n_repo = SequenceRepository()\n_validator = Validator()\n_service = LudicService(_repo, _validator)\n_controller = LudicController(_service)\ndef get_ludic(max_n: int) -> List[int]:\n    \"\"\"\n    Returns a list of all ludic numbers less than or equal to max_n.\n    \"\"\"\n    return _controller.get_ludic(max_n)"}
