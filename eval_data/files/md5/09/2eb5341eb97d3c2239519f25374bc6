{"task_id": "Mbpp/793", "solution": "def last(arr, target):\n    \"\"\"\n    Finds the last (rightmost) position of an element in a sorted array using binary search.\n    Returns the index or -1 if the element is not found.\n    \"\"\"\n    left, right = 0, len(arr) - 1\n    result = -1\n\n    while left <= right:\n        mid = (left + right) // 2\n        if arr[mid] == target:\n            result = mid\n            left = mid + 1  # Continue searching in the right half for a later occurrence\n        elif arr[mid] < target:\n            left = mid + 1\n        else:\n            right = mid - 1\n    return result"}
{"task_id": "Mbpp/794", "solution": "import re\ndef text_starta_endb(text: str) -> bool:\n    \"\"\"\n    Checks if a string starts with 'a', followed by anything, and ends with 'b'.\n    Matching is case-sensitive.\n    \"\"\"\n    pattern = r\"^a.*b$\"\n    return bool(re.match(pattern, text))"}
{"task_id": "Mbpp/796", "solution": "def return_sum(d: dict) -> float:\n    \"\"\"Calculates the sum of all numeric values in the given dictionary.\n    Returns an integer if the sum is an integral number, otherwise a float.\n    \"\"\"\n    total = sum(d.values())\n    if abs(total - int(total)) < 1e-12:\n        return int(total)\n    return total"}
{"task_id": "Mbpp/797", "solution": "def sum_in_range(l: int, r: int) -> int:\n    \"\"\"\n    Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n    Natural numbers are considered positive integers (>= 1).\n    \"\"\"\n    # Find the first odd number that is greater than or equal to l.\n    first_odd = l if l % 2 == 1 else l + 1\n    # Find the last odd number that is less than or equal to r.\n    last_odd = r if r % 2 == 1 else r - 1\n\n    # If the effective range of odd numbers is invalid (e.g., 2,2 -> first_odd=3, last_odd=1), return 0.\n    if first_odd > last_odd:\n        return 0\n\n    # Calculate the number of odd terms in the arithmetic progression.\n    # The common difference is 2.\n    num_terms = ((last_odd - first_odd) // 2) + 1\n\n    # Calculate the sum of the arithmetic progression using the formula:\n    # sum = n * (first_term + last_term) / 2\n    total_sum = num_terms * (first_odd + last_odd) // 2\n\n    return total_sum"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(value, d):\n    \"\"\"\n    Performs a 32-bit left bit rotation on the given integer.\n    The value is treated as an unsigned 32-bit integer.\n    \"\"\"\n    BIT_WIDTH = 32\n    mask = (1 << BIT_WIDTH) - 1\n\n    unsigned_value = value & mask\n    normalized_d = d % BIT_WIDTH\n\n    left_part = (unsigned_value << normalized_d) & mask\n    right_part = (unsigned_value >> (BIT_WIDTH - normalized_d)) & mask\n\n    return left_part | right_part"}
