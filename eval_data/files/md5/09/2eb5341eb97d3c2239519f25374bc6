{"task_id": "Mbpp/445", "solution": "def index_multiplication(a, b):\n    \"\"\"\n    Performs index-wise multiplication of elements from two tuples of tuples.\n    Assumes inputs are well-formed tuples of tuples with matching dimensions.\n    \"\"\"\n    result = []\n    for inner_tuple_a, inner_tuple_b in zip(a, b):\n        inner_result = tuple(x * y for x, y in zip(inner_tuple_a, inner_tuple_b))\n        result.append(inner_result)\n    return tuple(result)"}
{"task_id": "Mbpp/446", "solution": "from collections import Counter\ndef count_Occurrence(data_tuple, elements_list):\n    \"\"\"\n    Counts the total occurrences of elements from a list within a tuple.\n    It uses collections.Counter for efficient frequency counting.\n    \"\"\"\n    element_counts = Counter(data_tuple)\n    total_occurrence = sum(element_counts[element] for element in elements_list)\n    return total_occurrence"}
{"task_id": "Mbpp/448", "solution": "def cal_sum(n):\n    \"\"\"\n    Calculates the sum of Perrin numbers from P(0) to P(n) inclusive.\n    The Perrin sequence is defined as P(0)=3, P(1)=0, P(2)=2, and P(n)=P(n-2)+P(n-3) for n>=3.\n    \"\"\"\n    if n < 0:\n        # Based on constraints, assume valid non-negative input;\n        # if negative n is passed, the loop for range(0, n + 1) would be empty or raise,\n        # leading to incorrect behavior. The design context indicates ValueError for negative n\n        # but the prompt states \"Do NOT add isinstance() checks or raise exceptions for edge cases\".\n        # For simplicity and adhering to strict prompt, assume n >= 0.\n        return 0 # Or some other default behavior, but the problem implies n >= 0 based on assert cal_sum(9) == 49\n\n    total = 0\n    # Initialize P(0), P(1), P(2)\n    p_minus_3, p_minus_2, p_minus_1 = 3, 0, 2 # Represents P(i-3), P(i-2), P(i-1) respectively\n\n    for i in range(n + 1):\n        if i == 0:\n            current_p = p_minus_3\n        elif i == 1:\n            current_p = p_minus_2\n        elif i == 2:\n            current_p = p_minus_1\n        else:\n            # Calculate P(i) using the recurrence P(i) = P(i-2) + P(i-3)\n            # Then shift the values for the next iteration\n            next_p = p_minus_3 + p_minus_2\n            p_minus_3 = p_minus_2\n            p_minus_2 = p_minus_1\n            p_minus_1 = next_p\n            current_p = next_p\n        total += current_p\n    return total"}
{"task_id": "Mbpp/447", "solution": "def cube_nums(nums):\n    \"\"\"\n    Computes the cube of each numeric element in a list.\n    \"\"\"\n    return [n * n * n for n in nums]"}
{"task_id": "Mbpp/450", "solution": "def extract_string(strings: list[str], size: int) -> list[str]:\n    \"\"\"\n    Extracts strings of a specified length from a list of strings, after trimming whitespace.\n    \"\"\"\n    result = []\n    for s in strings:\n        normalized_s = s.strip()\n        if len(normalized_s) == size:\n            result.append(normalized_s)\n    return result"}
{"task_id": "Mbpp/454", "solution": "import re\ndef text_match_wordz(text):\n    \"\"\"Checks if the input text contains at least one word with the letter 'z' (case-insensitive).\"\"\"\n    # Pattern to match words containing 'z' or 'Z', respecting word boundaries.\n    pattern = re.compile(r\"\\b\\w*z\\w*\\b\", re.IGNORECASE)\n    return pattern.search(text) is not None"}
