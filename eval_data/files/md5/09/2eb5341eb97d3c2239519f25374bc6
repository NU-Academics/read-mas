{"task_id": "Mbpp/427", "solution": "import re\nclass DateFormatError(Exception):\n    \"\"\"Custom exception for date formatting and validation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n    def __str__(self) -> str:\n        return self.message\nclass DateDTO:\n    \"\"\"Data Transfer Object for a validated date.\"\"\"\n    def __init__(self, year: int, month: int, day: int) -> None:\n        self._year = year\n        self._month = month\n        self._day = day\n\n    def to_tuple(self) -> tuple[int, int, int]:\n        \"\"\"Returns the date components as a tuple (year, month, day).\"\"\"\n        return (self._year, self._month, self._day)\nDATE_REGEX: str = r\"^\\d{4}-\\d{2}-\\d{2}$\"\ndef is_leap_year(year: int) -> bool:\n    \"\"\"Checks if a year is a leap year according to Gregorian calendar rules.\"\"\"\n    return (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0)\ndef month_days(month: int, year: int) -> int:\n    \"\"\"Returns the number of days in a given month and year.\"\"\"\n    if not (1 <= month <= 12):\n        raise ValueError(\"Month must be between 1 and 12.\")\n    if month == 2:\n        return 29 if is_leap_year(year) else 28\n    elif month in [4, 6, 9, 11]:\n        return 30\n    else:\n        return 31\ndef zero_pad(value: int, width: int = 2) -> str:\n    \"\"\"Pads an integer with leading zeros to a specified width.\"\"\"\n    return str(value).zfill(width)\nclass DateValidator:\n    \"\"\"Validates a date string and converts it into a DateDTO.\"\"\"\n    def validate(self, date_str: str) -> DateDTO:\n        \"\"\"Validates the date string format and values, returning a DateDTO.\"\"\"\n        if not re.match(DATE_REGEX, date_str):\n            raise DateFormatError(\"invalid format: expected YYYY-MM-DD\")\n        \n        y_s, m_s, d_s = date_str.split(\"-\")\n        try:\n            y, m, d = int(y_s), int(m_s), int(d_s)\n        except ValueError:\n            raise DateFormatError(\"non-numeric components in date\")\n        \n        if not (1 <= m <= 12):\n            raise DateFormatError(\"month out of range\")\n        \n        md = month_days(m, y)\n        if not (1 <= d <= md):\n            raise DateFormatError(\"day out of range for month\")\n        \n        return DateDTO(y, m, d)\nclass DateFormatterService:\n    \"\"\"Orchestrates date validation and formatting.\"\"\"\n    def format_date(self, dto: DateDTO, sep: str = \"-\") -> str:\n        \"\"\"Formats a DateDTO into the 'dd-mm-yyyy' string format.\"\"\"\n        year, month, day = dto.to_tuple()\n        return f\"{zero_pad(day)}{sep}{zero_pad(month)}{sep}{year}\"\n\n    def format_from_string(self, date_str: str) -> str:\n        \"\"\"Validates a date string and formats it into 'dd-mm-yyyy'.\"\"\"\n        validator = DateValidator()\n        dto = validator.validate(date_str)\n        return self.format_date(dto)\ndef change_date_format(date_str: str) -> str:\n    \"\"\"Converts a date of 'yyyy-mm-dd' format to 'dd-mm-yyyy' format.\"\"\"\n    service = DateFormatterService()\n    return service.format_from_string(date_str)"}
{"task_id": "Mbpp/426", "solution": "def filter_oddnumbers(numbers: list) -> list:\n    \"\"\"Library convenience function: validate and return odd numbers.\"\"\"\n\n    class ValidationError(Exception):\n        def __init__(self, message: str):\n            super().__init__(message)\n            self.message = message\n\n    class Validator:\n        def validate_numbers(self, value: any) -> list:\n            \"\"\"Validates the input value and converts it to a list of integers.\"\"\"\n            if isinstance(value, str):\n                tokens = [t.strip() for t in value.replace(',', ' ').split()]\n                try:\n                    return [int(t) for t in tokens if t] # Ensure token is not empty\n                except ValueError as e:\n                    raise ValidationError(f\"Could not parse token as int: {e}\")\n            if isinstance(value, (list, tuple)):\n                for i, v in enumerate(value):\n                    if not isinstance(v, int):\n                        raise ValidationError(f\"Element at index {i} is not int: {v!r}\")\n                return list(value)\n            raise ValidationError(\"Input must be list/tuple of ints or a string of ints.\")\n\n    class OddFilterService:\n        def filter_odd_numbers(self, numbers_list: list) -> list:\n            \"\"\"Filters a list of integers, returning only the odd numbers.\"\"\"\n            return [n for n in numbers_list if self.is_odd(n)]\n\n        def is_odd(self, n: int) -> bool:\n            \"\"\"Checks if an integer is an odd number.\"\"\"\n            return (n % 2) != 0\n\n    class FilterController:\n        def __init__(self, validator_inst, service_inst, repository_inst=None):\n            self._validator = validator_inst\n            self._service = service_inst\n            self._repository = repository_inst # Repository is not used for persist=False.\n\n        def filter_and_maybe_persist(self, numbers_input: any, persist: bool = False) -> list:\n            \"\"\"Validates input, filters odd numbers, and optionally persists the result.\"\"\"\n            validated_numbers = self._validator.validate_numbers(numbers_input)\n            result = self._service.filter_odd_numbers(validated_numbers)\n            return result\n\n    _validator = Validator()\n    _service = OddFilterService()\n    _controller = FilterController(_validator, _service)\n\n    return _controller.filter_and_maybe_persist(numbers, persist=False)"}
{"task_id": "Mbpp/428", "solution": "def shell_sort(arr):\n    \"\"\"\n    Sorts a list using the Shell sort algorithm with Shell's original gap sequence.\n    Returns a new sorted list without modifying the original.\n    \"\"\"\n    n = len(arr)\n    data = list(arr)  # Create a mutable copy to perform sorting\n\n    # Start with a large gap, then reduce the gap using Shell's original sequence.\n    gap = n // 2\n    while gap > 0:\n        # Perform a gapped insertion sort for the current gap size.\n        # This iterates through elements, inserting them into their correct place in gapped sub-arrays.\n        for i in range(gap, n):\n            temp = data[i]\n            j = i\n            # Shift elements of the gapped subarray up until the correct location for temp is found.\n            while j >= gap and data[j - gap] > temp:\n                data[j] = data[j - gap]\n                j -= gap\n            data[j] = temp\n        gap //= 2  # Reduce the gap for the next pass\n\n    return data"}
