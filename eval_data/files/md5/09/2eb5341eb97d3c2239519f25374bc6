{"task_id": "Mbpp/764", "solution": "def number_ctr(s: str) -> int:\n    \"\"\"Counts the number of ASCII digits (0-9) in the given string.\"\"\"\n    ascii_digits = \"0123456789\"\n    count = 0\n    for char in s:\n        if char in ascii_digits:\n            count += 1\n    return count"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(array, n):\n    \"\"\"\n    Finds the minimum absolute difference between any two elements in the given array.\n    The algorithm sorts the array and then iterates through adjacent elements.\n    \"\"\"\n    sorted_array = sorted(array)\n    \n    min_diff = abs(sorted_array[1] - sorted_array[0])\n    \n    for i in range(2, n):\n        diff = abs(sorted_array[i] - sorted_array[i-1])\n        if diff < min_diff:\n            min_diff = diff\n            \n    return min_diff"}
{"task_id": "Mbpp/766", "solution": "from typing import List, Tuple, Any, Iterable, Iterator\ndef pair_wise(items: Iterable[Any]) -> List[Tuple[Any, Any]]:\n    \"\"\"\n    Returns a list of all pairs of consecutive items in the given list.\n    Handles empty lists and lists with a single item.\n    \"\"\"\n    it: Iterator[Any] = iter(items)\n    try:\n        prev = next(it)\n    except StopIteration:\n        return []\n\n    result: List[Tuple[Any, Any]] = []\n    for current in it:\n        result.append((prev, current))\n        prev = current\n    return result"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(numbers):\n    \"\"\"\n    Finds the second smallest distinct number in a list of numbers.\n    Assumes numeric input; handles edge cases by returning float('inf').\n    \"\"\"\n    smallest = float('inf')\n    second_smallest_val = float('inf')\n\n    for num in numbers:\n        # Convert each number to float for consistent comparison and to handle mixed int/float types.\n        # This will raise a ValueError if 'num' is not convertible to float, as per Python's built-in behavior.\n        current_num = float(num)\n\n        if current_num < smallest:\n            second_smallest_val = smallest\n            smallest = current_num\n        elif current_num < second_smallest_val and current_num != smallest:\n            second_smallest_val = current_num\n\n    return second_smallest_val"}
