{"task_id": "Mbpp/392", "solution": "def get_max_sum(n: int) -> int:\n    \"\"\"\n    Computes the maximum sum for n using f(n) = max(n, f(n//2) + f(n//3) + f(n//4) + f(n//5)).\n    Uses memoization to store and retrieve previously computed results.\n    \"\"\"\n    memo = {}\n\n    def _compute_max_sum(k: int) -> int:\n        if k == 0:\n            return 0\n        if k in memo:\n            return memo[k]\n\n        sum_children = (_compute_max_sum(k // 2) +\n                        _compute_max_sum(k // 3) +\n                        _compute_max_sum(k // 4) +\n                        _compute_max_sum(k // 5))\n        \n        result = max(k, sum_children)\n        memo[k] = result\n        return result\n\n    return _compute_max_sum(n)"}
{"task_id": "Mbpp/391", "solution": "from typing import Any, List, Dict, Optional, Callable\nfrom dataclasses import dataclass\nNestedDict = Dict[Any, Any]\nclass ConverterService:\n    def __init__(self, validator: Callable[[List[List[Any]]], None] = validate_lists) -> None:\n        self._validator = validator\n\n    def convert(self, list_input: ListInput) -> List[NestedDict]:\n        self._validator(list_input.lists)\n        if not list_input.lists:\n            return []\n        result: List[NestedDict] = []\n        first_list = list_input.lists[0]\n        other_lists = list_input.lists[1:]\n        for i, key in enumerate(first_list):\n            values_for_index = [lst[i] for lst in other_lists]\n            nested_structure = self._build_nested(values_for_index)\n            result.append({key: nested_structure})\n        return result\n\n    def _build_nested(self, values: List[Any]) -> NestedDict:\n        if not values:\n            return {}\n        if len(values) == 1:\n            return values[0] # The last item in the sequence is the leaf value\n        \n        # Build nested dictionary from right to left: [a, b, c] -> {a: {b: c}}\n        nested_val: Any = values[-1]\n        for i in reversed(range(len(values) - 1)):\n            nested_val = {values[i]: nested_val}\n        return nested_val\nclass ConverterController:\n    def __init__(self, service: ConverterService, repository: Any = None) -> None:\n        self._service = service\n        self._repo = repository\n\n    def convert_lists(self, *lists: List[Any], persist_path: Optional[str] = None) -> List[NestedDict]:\n        list_input = ListInput(lists=list(lists))\n        output = self._service.convert(list_input)\n        # Persistence logic (if any) is skipped as `repository` is None for this wrapper.\n        return output\ndef convert_list_dictionary(*lists: List[Any]) -> List[NestedDict]:\n    \"\"\"Converts multiple parallel lists into a list of nested dictionaries.\n    The first list provides top-level keys, subsequent lists create nested key-value pairs.\"\"\"\n    controller = ConverterController(service=ConverterService(), repository=None)\n    return controller.convert_lists(*lists)"}
