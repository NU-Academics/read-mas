{"task_id": "Mbpp/733", "solution": "from typing import List\ndef find_first_occurrence(array: List[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array.\n    Uses a modified binary search algorithm to locate the leftmost index.\n    \"\"\"\n    low, high = 0, len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = (low + high) // 2\n        \n        if array[mid] == target:\n            result = mid\n            high = mid - 1  # Move left to find the absolute first occurrence\n        elif array[mid] < target:\n            low = mid + 1\n        else:  # array[mid] > target\n            high = mid - 1\n            \n    return result"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(n: int) -> int:\n    \"\"\"Toggles bits of the number except the first (MSB) and the last (LSB) bit.\"\"\"\n    # If the number has 2 or fewer significant bits, there are no middle bits to toggle.\n    # This covers n=0 (no bits), n=1 (only LSB), n=2 (MSB=1, LSB=0), n=3 (MSB=1, LSB=0).\n    if n <= 3 and n != 0: # For n=0, bit_length is 0. For n=1, bit_length=1. For n=2,3 bit_length=2\n        return n\n    if n == 0:\n        return 0\n\n    # The most significant bit index (0-based) for n > 0.\n    msb_idx = n.bit_length() - 1\n    # The least significant bit index (0-based) for n > 0 is always 0.\n    lsb_idx = 0\n\n    # If the range between MSB and LSB is too small, there are no 'middle' bits.\n    # This condition covers cases where (msb_idx - lsb_idx) <= 1.\n    # Example: n=4 (0100b), msb_idx=2, lsb_idx=0. msb_idx - lsb_idx = 2.\n    # Here, bit 1 is a middle bit.\n    if msb_idx - lsb_idx <= 1:\n        return n\n\n    # The bits to toggle are from lsb_idx + 1 up to msb_idx - 1 (inclusive).\n    start_toggle_bit = lsb_idx + 1\n    end_toggle_bit = msb_idx - 1\n\n    # Construct the mask with '1's in the positions from start_toggle_bit to end_toggle_bit.\n    # This is achieved by XORing a mask of (0 to end_toggle_bit) with a mask of (0 to start_toggle_bit - 1).\n    mask = ((1 << (end_toggle_bit + 1)) - 1) ^ ((1 << start_toggle_bit) - 1)\n\n    return n ^ mask"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(seq, value):\n    \"\"\"\n    Locates the left-most insertion point for a value in a sorted sequence.\n    This function implements a left-biased binary search algorithm.\n    \"\"\"\n    lo = 0\n    hi = len(seq)\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if seq[mid] < value:\n            lo = mid + 1\n        else:\n            hi = mid\n    return lo"}
{"task_id": "Mbpp/734", "solution": "from decimal import Decimal\ndef sum_Of_Subarray_Prod(nums):\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists (subarrays) of a given list.\n    Uses Decimal for precise arithmetic to avoid floating-point issues.\n    \"\"\"\n    total_sum = Decimal(0)\n    n = len(nums)\n\n    # Iterate through all possible starting indices of a subarray\n    for i in range(n):\n        current_product = Decimal(1)\n        # Iterate through all possible ending indices for the current starting index\n        for j in range(i, n):\n            current_product *= Decimal(nums[j])\n            total_sum += current_product\n            \n    return total_sum"}
{"task_id": "Mbpp/737", "solution": "import re\nclass VowelCheckError(Exception):\n    \"\"\"Custom exception for vowel check domain-specific errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\nclass VowelCheckRequest:\n    def __init__(self, s: str, trim: bool = False) -> None:\n        self.s = s\n        self.trim = trim\nDEFAULT_VOWEL_PATTERN = r'^[aeiouAEIOU]'\nclass RegexValidator:\n    def __init__(self, pattern: str = DEFAULT_VOWEL_PATTERN) -> None:\n        self._pattern_str = pattern\n        self._compiled = None\n\n    def compile_pattern(self) -> re.Pattern:\n        if self._compiled is None:\n            try:\n                self._compiled = re.compile(self._pattern_str)\n            except re.error as e:\n                raise VowelCheckError(f\"Invalid regex: {e}\")\n        return self._compiled\n\n    def is_starting_vowel(self, s: str) -> bool:\n        pat = self.compile_pattern()\n        return bool(pat.match(s))\nclass VowelService:\n    def __init__(self, validator: RegexValidator) -> None:\n        self.validator = validator\n\n    def check(self, request: VowelCheckRequest) -> bool:\n        s_to_check = request.s\n        if request.trim:\n            s_to_check = s_to_check.lstrip()\n\n        if not s_to_check:\n            return False\n            \n        return self.validator.is_starting_vowel(s_to_check)\nclass VowelController:\n    def __init__(self, service: VowelService) -> None:\n        self.service = service\n\n    def check_text(self, s: str, trim: bool = False) -> bool:\n        request = VowelCheckRequest(s=s, trim=trim)\n        return self.service.check(request)\ndef check_str(s: str, trim: bool = False) -> bool:\n    \"\"\"\n    Checks if the given string starts with a vowel using regex.\n    \"\"\"\n    validator = RegexValidator()\n    service = VowelService(validator)\n    controller = VowelController(service)\n    return controller.check_text(s, trim)"}
{"task_id": "Mbpp/739", "solution": "def find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    Uses an algebraic approach to solve k(k+1)/2 >= 10^(n-1).\n    \"\"\"\n    import math\n\n    # The smallest n-digit number is 10^(n-1).\n    # We need to find the smallest k such that T_k = k*(k+1)/2 >= target_value_lower_bound.\n    target_value_lower_bound = 10**(n - 1)\n\n    # The inequality k*(k+1)/2 >= target is equivalent to k^2 + k - 2*target >= 0.\n    # The positive root of k^2 + k - 2*target = 0 is (-1 + sqrt(1 + 8*target)) / 2.\n    # The smallest integer k satisfying the inequality is the ceiling of this value.\n    \n    discriminant = 1 + 8 * target_value_lower_bound\n\n    # Calculate ceil(sqrt(discriminant)). math.isqrt gives floor(sqrt(x)).\n    sqrt_discriminant_floor = math.isqrt(discriminant)\n    \n    # Adjust to get ceil(sqrt(discriminant)).\n    sqrt_discriminant_ceil = sqrt_discriminant_floor\n    if sqrt_discriminant_floor * sqrt_discriminant_floor < discriminant:\n        sqrt_discriminant_ceil += 1\n\n    # Now, calculate k = ceil((-1 + sqrt_discriminant_ceil) / 2).\n    # Since n >= 1, target_value_lower_bound >= 1, which means discriminant >= 9,\n    # and sqrt_discriminant_ceil >= 3, ensuring (-1 + sqrt_discriminant_ceil) is positive.\n    k = math.ceil((-1 + sqrt_discriminant_ceil) / 2)\n\n    return k"}
