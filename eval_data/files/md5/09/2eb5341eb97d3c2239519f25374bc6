{"task_id": "Mbpp/479", "solution": "def first_Digit(n):\n    \"\"\"\n    Finds the first (most significant) digit of a given number,\n    considering the absolute value of its integer part.\n    \"\"\"\n    # Convert input to an integer, handling floats by truncation and strings by parsing.\n    # This path assumes valid numeric input as per constraints.\n    num_val = int(float(n))\n\n    # Get the absolute value of the integer part.\n    abs_num = abs(num_val)\n\n    # Handle the special case where the number is zero.\n    if abs_num == 0:\n        return 0\n\n    # Repeatedly divide by 10 until only the first digit remains.\n    while abs_num >= 10:\n        abs_num //= 10\n\n    return abs_num"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr, n):\n    \"\"\"Counts the number of unordered pairs in an array whose XOR value is odd.\n    An XOR operation results in an odd number if and only if one operand is odd and the other is even.\"\"\"\n    odd_count = 0\n    for x in arr:\n        if x & 1:  # Check if odd using bitwise AND\n            odd_count += 1\n    \n    even_count = n - odd_count\n    return odd_count * even_count"}
{"task_id": "Mbpp/554", "solution": "def Split(values: list[int]) -> list[int]:\n    \"\"\"\n    Filters a list of integers, returning only the odd numbers while preserving order.\n    \"\"\"\n    return [x for x in values if x % 2 != 0]"}
{"task_id": "Mbpp/555", "solution": "def difference(n):\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers using closed-form formulas.\n    \"\"\"\n    # Sum of the first n natural numbers: S = n * (n + 1) / 2\n    sum_n = n * (n + 1) // 2\n    # Sum of the cubes of the first n natural numbers: Sum_cubes = (S)^2\n    sum_cubes = sum_n * sum_n\n    \n    return sum_cubes - sum_n"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(s: str) -> str:\n    \"\"\"Toggles the case of all alphabetic characters in a string.\"\"\"\n    parts = []\n    for ch in s:\n        if ch.islower():\n            parts.append(ch.upper())\n        elif ch.isupper():\n            parts.append(ch.lower())\n        else:\n            parts.append(ch)\n    return \"\".join(parts)"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr, n):\n    \"\"\"\n    Finds the maximum sum of a contiguous sublist in the given list using Kadane's algorithm.\n    Assumes the input list `arr` is non-empty.\n    \"\"\"\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, n):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the sum of per-digit absolute differences between two integers,\n    treating numbers as their absolute values and right-aligning them with leading zeros.\n    \"\"\"\n    abs_a = abs(a)\n    abs_b = abs(b)\n\n    str_a = str(abs_a)\n    str_b = str(abs_b)\n\n    max_len = max(len(str_a), len(str_b))\n\n    padded_str_a = str_a.zfill(max_len)\n    padded_str_b = str_b.zfill(max_len)\n\n    total_distance = 0\n    for i in range(max_len):\n        digit_a = int(padded_str_a[i])\n        digit_b = int(padded_str_b[i])\n        total_distance += abs(digit_a - digit_b)\n\n    return total_distance"}
{"task_id": "Mbpp/560", "solution": "def union_elements(t1, t2):\n    \"\"\"\n    Finds the union of elements from two tuples, removing duplicates and sorting them.\n    Returns the result as a new tuple.\n    \"\"\"\n    union_set = set(t1) | set(t2)\n    sorted_elements = sorted(list(union_set))\n    return tuple(sorted_elements)"}
{"task_id": "Mbpp/564", "solution": "def count_Pairs(arr: list[int], n: int) -> int:\n    \"\"\"\n    Counts the number of possible unordered pairs where both elements are unequal.\n    The 'n' parameter is assumed to be the length of 'arr' for this calculation.\n    \"\"\"\n    length = len(arr)\n\n    # If the array has fewer than two elements, no pairs can be formed.\n    if length < 2:\n        return 0\n\n    # Calculate the total number of unordered pairs possible from 'length' elements.\n    total_pairs = length * (length - 1) // 2\n\n    # Count the frequency of each element in the array.\n    freqs = {}\n    for value in arr:\n        freqs[value] = freqs.get(value, 0) + 1\n\n    # Calculate the number of pairs where elements are equal.\n    equal_pairs = 0\n    for freq in freqs.values():\n        if freq > 1:\n            equal_pairs += freq * (freq - 1) // 2\n\n    # Subtract equal pairs from total pairs to get the count of unequal pairs.\n    return total_pairs - equal_pairs"}
