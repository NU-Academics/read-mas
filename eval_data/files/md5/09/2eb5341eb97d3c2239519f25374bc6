{"task_id": "Mbpp/455", "solution": "def check_monthnumb_number(month_number: int) -> bool:\n    \"\"\"Checks if the given month number corresponds to a month with 31 days.\n    This function includes all necessary helpers defined inline to be self-contained.\n    \"\"\"\n    from dataclasses import dataclass\n    from typing import Dict, Optional\n\n    class InvalidMonthError(ValueError):\n        \"\"\"Exception raised for invalid month numbers.\"\"\"\n        def __init__(self, message: str, month: Optional[int] = None) -> None:\n            super().__init__(message)\n            self.month = month\n\n    @dataclass(frozen=True)\n    class Month:\n        \"\"\"Represents a month with its number, name, and days.\"\"\"\n        number: int\n        name: str\n        days: int\n\n        def is_31_days(self) -> bool:\n            \"\"\"Returns True if the month has 31 days.\"\"\"\n            return self.days == 31\n\n    MONTH_DEFINITIONS: Dict[int, Month] = {\n        1: Month(1, \"January\", 31),\n        2: Month(2, \"February\", 28),\n        3: Month(3, \"March\", 31),\n        4: Month(4, \"April\", 30),\n        5: Month(5, \"May\", 31),\n        6: Month(6, \"June\", 30),\n        7: Month(7, \"July\", 31),\n        8: Month(8, \"August\", 31),\n        9: Month(9, \"September\", 30),\n        10: Month(10, \"October\", 31),\n        11: Month(11, \"November\", 30),\n        12: Month(12, \"December\", 31),\n    }\n\n    def validate_month_number(month_num_to_validate: int) -> None:\n        \"\"\"Validates if the month number is an integer between 1 and 12.\"\"\"\n        if not isinstance(month_num_to_validate, int):\n            raise InvalidMonthError(f\"Month must be int, got {type(month_num_to_validate).__name__}\", month=None)\n        if month_num_to_validate < 1 or month_num_to_validate > 12:\n            raise InvalidMonthError(f\"Month must be between 1 and 12, got {month_num_to_validate}\", month=month_num_to_validate)\n\n    class MonthService:\n        \"\"\"Provides business logic for checking month properties.\"\"\"\n        def has_31_days(self, month_num_service: int) -> bool:\n            \"\"\"Checks if the given month number corresponds to a month with 31 days.\"\"\"\n            validate_month_number(month_num_service)\n            month_obj = MONTH_DEFINITIONS[month_num_service]\n            return month_obj.is_31_days()\n\n    class MonthController:\n        \"\"\"Coordinates validation and service calls.\"\"\"\n        def __init__(self, service_instance: MonthService) -> None:\n            self.service = service_instance\n\n        def check_monthnumb_number(self, month_num_controller: int) -> bool:\n            \"\"\"Delegates the check to the MonthService.\"\"\"\n            return self.service.has_31_days(month_num_controller)\n\n    service = MonthService()\n    controller = MonthController(service)\n    return controller.check_monthnumb_number(month_number)"}
