{"task_id": "Mbpp/787", "solution": "import re\nfrom dataclasses import dataclass\nfrom datetime import datetime\nfrom typing import Optional\nclass TextMatchError(Exception):\n    \"\"\"Base exception for text matching operations.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\nclass ValidationError(TextMatchError):\n    \"\"\"Exception for invalid input during validation.\"\"\"\n    pass\nDEFAULT_MAX_INPUT_LENGTH: int = 1_000_000\nDEFAULT_CASE_SENSITIVE: bool = True\nclass Config:\n    \"\"\"Configuration for text matching service.\"\"\"\n    def __init__(self, max_input_length: int = DEFAULT_MAX_INPUT_LENGTH, case_sensitive: bool = DEFAULT_CASE_SENSITIVE):\n        self.max_input_length = max_input_length\n        self.case_sensitive = case_sensitive\nclass Utils:\n    \"\"\"Utility functions for input validation and normalization.\"\"\"\n    @staticmethod\n    def validate_input(text: str, max_length: int) -> None:\n        \"\"\"Validates input text type and length.\"\"\"\n        if not isinstance(text, str):\n            raise ValidationError(\"Input must be a string.\")\n        if len(text) > max_length:\n            raise ValidationError(f\"Input length exceeds maximum allowed of {max_length} characters.\")\n\n    @staticmethod\n    def normalize_text(text: str, case_sensitive: bool) -> str:\n        \"\"\"Normalizes text based on case sensitivity.\"\"\"\n        return text if case_sensitive else text.lower()\nclass TextMatcher:\n    \"\"\"Encapsulates the pattern matching algorithm.\"\"\"\n    DEFAULT_PATTERN = r\"abbb\"\n\n    def __init__(self, pattern: str = DEFAULT_PATTERN, case_sensitive: bool = True):\n        self._pattern = pattern\n        self._case_sensitive = case_sensitive\n        self._compiled = self.compile_pattern()\n\n    def compile_pattern(self) -> re.Pattern:\n        \"\"\"Compiles the regex pattern with appropriate flags.\"\"\"\n        flags = 0 if self._case_sensitive else re.IGNORECASE\n        return re.compile(self._pattern, flags)\n\n    def match(self, text: str) -> bool:\n        \"\"\"Checks if the compiled pattern is found in the text.\"\"\"\n        return bool(self._compiled.search(text))\nclass TextMatchService:\n    \"\"\"Orchestrates validation, matching, and optional persistence.\"\"\"\n    def __init__(self, matcher: TextMatcher, repo: Optional[object], config: Config):\n        self._matcher = matcher\n        self._repo = repo\n        self._config = config\n\n    def match(self, text: str) -> bool:\n        \"\"\"Validates, normalizes, matches text, and optionally records the attempt.\"\"\"\n        Utils.validate_input(text, self._config.max_input_length)\n        normalized = Utils.normalize_text(text, self._config.case_sensitive)\n        result = self._matcher.match(normalized)\n        \n        if self._repo is not None:\n            record = MatchRecord(id=None, text=text, matched=result, timestamp=datetime.utcnow())\n            try:\n                # In this context, _repo will be None, so this line will not execute.\n                self._repo.save(record) \n            except Exception as e:\n                raise TextMatchError(f\"Repository error: {e}\") from e\n        return result\ndef text_match_three(text: str) -> bool:\n    \"\"\"\n    Checks if the input string contains an 'a' followed by three 'b's (\"abbb\").\n    This function acts as a convenience wrapper, configuring and orchestrating\n    the core matching logic as per the design.\n    \"\"\"\n    cfg = Config()\n    matcher = TextMatcher(case_sensitive=cfg.case_sensitive)\n    service = TextMatchService(matcher=matcher, repo=None, config=cfg)\n    return service.match(text)"}
{"task_id": "Mbpp/791", "solution": "def remove_nested(input_tuple):\n    \"\"\"\n    Removes any top-level elements that are tuples from the given tuple.\n    Non-tuple elements are retained in their original order.\n    \"\"\"\n    result = []\n    for item in input_tuple:\n        if not isinstance(item, tuple):\n            result.append(item)\n    return tuple(result)"}
