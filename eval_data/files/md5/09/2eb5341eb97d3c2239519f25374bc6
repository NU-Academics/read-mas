{"task_id": "Mbpp/612", "solution": "def merge(list_of_lists: list) -> list:\n    \"\"\"\n    Splits a list of 2-element sublists into two separate lists.\n    The first output list contains all first elements, and the second contains all second elements.\n    \"\"\"\n    first_elements = []\n    second_elements = []\n    for sublist in list_of_lists:\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/614", "solution": "def cummulative_sum(tuple_list):\n    \"\"\"\n    Calculates the cumulative sum of all numeric values in a list of tuples.\n    The return type is float if any input value was a float, otherwise it's an int.\n    \"\"\"\n    total = 0\n    any_float = False\n\n    for inner_sequence in tuple_list:\n        for number in inner_sequence:\n            if isinstance(number, float):\n                any_float = True\n            total += number\n\n    return float(total) if any_float else int(total)"}
{"task_id": "Mbpp/619", "solution": "def move_num(s: str) -> str:\n    \"\"\"\n    Moves all digit characters to the end of the string, preserving their relative order\n    and the relative order of non-digit characters.\n    \"\"\"\n    non_digits = []\n    digits = []\n    for char in s:\n        if '0' <= char <= '9':\n            digits.append(char)\n        else:\n            non_digits.append(char)\n    return \"\".join(non_digits) + \"\".join(digits)"}
{"task_id": "Mbpp/615", "solution": "import ast\nfrom typing import Tuple, List, Any\ndef average_tuple(data):\n    class InvalidInputError(Exception):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n        def __str__(self) -> str:\n            return self.message\n\n    class DomainTuple:\n        def __init__(self, values: Tuple[float, ...]) -> None:\n            self._values = tuple(float(v) for v in values)\n            self.validate()\n\n        def length(self) -> int:\n            return len(self._values)\n\n        def get(self, index: int) -> float:\n            return self._values[index]\n\n        def validate(self) -> None:\n            if not isinstance(self._values, tuple) or len(self._values) == 0:\n                raise InvalidInputError(\"Inner tuple must be a non-empty tuple\")\n\n    class AverageService:\n        def __init__(self) -> None:\n            pass\n\n        def calculate_averages(self, data: Tuple[Tuple[float, ...], ...]) -> List[float]:\n            domain = self._build_domain_tuples(data)\n            self._validate_same_length(domain)\n            count = len(domain)\n            length = domain[0].length()\n            sums = [0.0] * length\n            for d in domain:\n                for i in range(length):\n                    sums[i] += d.get(i)\n            return [s / count for s in sums]\n\n        def _build_domain_tuples(self, data: Tuple[Tuple[float, ...], ...]) -> List[DomainTuple]:\n            if not isinstance(data, tuple) or len(data) == 0:\n                raise InvalidInputError(\"Data must be a non-empty tuple of tuples\")\n            return [DomainTuple(inner) for inner in data]\n\n        def _validate_same_length(self, domain_tuples: List[DomainTuple]) -> None:\n            if not domain_tuples:\n                return\n            lengths = {d.length() for d in domain_tuples}\n            if len(lengths) != 1:\n                raise InvalidInputError(\"All inner tuples must have the same length\")\n\n    class InputAdapter:\n        def parse_literal(self, literal: str) -> Tuple[Tuple[float, ...], ...]:\n            try:\n                obj = ast.literal_eval(literal)\n            except Exception as e:\n                raise InvalidInputError(f\"Unable to parse input literal: {e}\")\n            return self.validate_structure(obj)\n\n        def validate_structure(self, obj: Any) -> Tuple[Tuple[float, ...], ...]:\n            if not isinstance(obj, tuple) or len(obj) == 0:\n                raise InvalidInputError(\"Input must be a non-empty tuple of tuples\")\n            normalized = []\n            for inner in obj:\n                if not isinstance(inner, (tuple, list)):\n                    raise InvalidInputError(\"Each inner item must be a tuple or list of numbers\")\n                try:\n                    floats = tuple(float(x) for x in inner)\n                except Exception:\n                    raise InvalidInputError(\"All inner values must be numeric\")\n                normalized.append(floats)\n            return tuple(normalized)\n\n    _service = AverageService()\n    _adapter = InputAdapter()\n\n    if isinstance(data, str):\n        processed_data = _adapter.parse_literal(data)\n    else:\n        processed_data = _adapter.validate_structure(data)\n\n    return _service.calculate_averages(processed_data)"}
{"task_id": "Mbpp/616", "solution": "from typing import Tuple, Any\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass DivisionByZeroError(Exception):\n    \"\"\"Custom exception for division by zero during modulo operation.\"\"\"\n    def __init__(self, index: int, message: str) -> None:\n        super().__init__(message)\n        self.index = index\n        self.message = message\nclass TupleModuloRequest:\n    \"\"\"Data Transfer Object for validated modulo operation inputs.\"\"\"\n    def __init__(self, a: Tuple[int, ...], b: Tuple[int, ...]) -> None:\n        self.a: Tuple[int, ...] = a\n        self.b: Tuple[int, ...] = b\nclass TupleModuloResponse:\n    \"\"\"Data Transfer Object for modulo operation results.\"\"\"\n    def __init__(self, result: Tuple[int, ...]) -> None:\n        self.result: Tuple[int, ...] = result\nclass TupleValidator:\n    \"\"\"Validates and normalizes input tuples for element-wise modulo.\"\"\"\n    MAX_LENGTH = 10000\n\n    def validate(self, a: Any, b: Any) -> TupleModuloRequest:\n        \"\"\"Validates inputs and returns a TupleModuloRequest.\"\"\"\n        a_t = self._ensure_iterable(a)\n        b_t = self._ensure_iterable(b)\n        if len(a_t) != len(b_t):\n            raise InvalidInputError(\"Input tuples must have the same length\")\n        if len(a_t) > self.MAX_LENGTH:\n            raise InvalidInputError(f\"Input length exceeds MAX_LENGTH {self.MAX_LENGTH}\")\n        self._ensure_all_ints(a_t, \"a\")\n        self._ensure_all_ints(b_t, \"b\")\n        return TupleModuloRequest(a=tuple(a_t), b=tuple(b_t))\n\n    def _ensure_iterable(self, value: Any) -> Tuple[Any, ...]:\n        \"\"\"Converts an iterable to a tuple or raises an error if not iterable.\"\"\"\n        if isinstance(value, (tuple, list, range)):\n            return tuple(value)\n        raise InvalidInputError(f\"Input must be an iterable (tuple, list, or range), got {type(value).__name__}\")\n\n    def _ensure_all_ints(self, tup: Tuple[Any, ...], name: str) -> None:\n        \"\"\"Ensures all elements in a tuple are integers.\"\"\"\n        for i, item in enumerate(tup):\n            if not isinstance(item, int):\n                raise InvalidInputError(f\"Element at index {i} of tuple '{name}' is not an integer: {type(item).__name__}\")\nclass TupleModuloService:\n    \"\"\"Performs the core element-wise modulo computation.\"\"\"\n    def compute(self, req: TupleModuloRequest) -> TupleModuloResponse:\n        \"\"\"Computes element-wise modulo and handles division by zero.\"\"\"\n        result = []\n        for i, (ai, bi) in enumerate(zip(req.a, req.b)):\n            if bi == 0:\n                raise DivisionByZeroError(i, f\"Division by zero at index {i}\")\n            result.append(ai % bi)\n        return TupleModuloResponse(result=tuple(result))\nclass TupleModuloController:\n    \"\"\"Orchestrates validation and service calls for the tuple modulo operation.\"\"\"\n    def __init__(self, validator: TupleValidator = None, service: TupleModuloService = None) -> None:\n        self.validator = validator or TupleValidator()\n        self.service = service or TupleModuloService()\n\n    def process(self, a: Any, b: Any) -> Tuple[int, ...]:\n        \"\"\"Processes input, validates, computes modulo, and returns the result tuple.\"\"\"\n        req = self.validator.validate(a, b)\n        resp = self.service.compute(req)\n        return resp.result\n_controller = TupleModuloController()\ndef tuple_modulo(a: Tuple[int, ...], b: Tuple[int, ...]) -> Tuple[int, ...]:\n    \"\"\"\n    Computes the element-wise modulo of two tuples of the same length.\n\n    Raises InvalidInputError for type/length mismatches or non-integer elements.\n    Raises DivisionByZeroError if any element in the second tuple is zero.\n    \"\"\"\n    return _controller.process(a, b)"}
