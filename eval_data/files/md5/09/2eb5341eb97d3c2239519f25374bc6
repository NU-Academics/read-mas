{"task_id": "Mbpp/605", "solution": "import math\ndef prime_num(n: int) -> bool:\n    \"\"\"\n    Checks if an integer is a prime number using optimized trial division.\n    It efficiently handles small numbers, even numbers, and then checks odd divisors up to the square root of n.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2 or n == 3:\n        return True\n    if n % 2 == 0:\n        return False\n    \n    # Trial division for odd numbers up to the square root of n.\n    limit = int(math.isqrt(n))\n    for i in range(3, limit + 1, 2):\n        if n % i == 0:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/607", "solution": "import re\nclass SearchError(Exception):\n    \"\"\"Base exception for search operations.\"\"\"\n    pass\nclass PatternError(SearchError):\n    \"\"\"Raised when a regex pattern is invalid.\"\"\"\n    pass\nclass NotFoundError(SearchError):\n    \"\"\"Raised when no match is found for a regex pattern.\"\"\"\n    pass\ndef find_literals(text: str, pattern: str, flags: int = 0, start_pos: int = 0) -> tuple[str, int, int]:\n    \"\"\"\n    Searches a string for a regex pattern, returning the matched substring and its indices.\n    Raises PatternError for invalid regex or NotFoundError if no match is found.\n    \"\"\"\n    try:\n        compiled_pattern = re.compile(pattern, flags)\n    except re.error as e:\n        raise PatternError(f\"Invalid regex pattern: {e}\") from e\n\n    match = compiled_pattern.search(text, pos=start_pos)\n\n    if match:\n        return (match.group(0), match.start(), match.end())\n    else:\n        raise NotFoundError(f\"No match found for pattern '{pattern}' in text starting at position {start_pos}\")"}
