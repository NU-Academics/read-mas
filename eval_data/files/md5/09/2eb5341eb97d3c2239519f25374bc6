{"task_id": "Mbpp/463", "solution": "def max_subarray_product(arr):\n    \"\"\"\n    Finds the maximum product of a contiguous subarray in the given array.\n    This implementation handles negative numbers and zeros efficiently.\n    \"\"\"\n    if not arr:\n        return 0  # Or raise an error as per validation in design, but for problem solving, assume valid non-empty array.\n\n    max_so_far = arr[0]\n    min_so_far = arr[0]\n    result = arr[0]\n\n    for i in range(1, len(arr)):\n        curr = arr[i]\n\n        # swapped max_so_far and min_so_far if current number is negative\n        if curr < 0:\n            max_so_far, min_so_far = min_so_far, max_so_far\n\n        # Update max_so_far and min_so_far for the current number\n        max_so_far = max(curr, max_so_far * curr)\n        min_so_far = min(curr, min_so_far * curr)\n\n        result = max(result, max_so_far)\n\n    return result"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple: tuple[int, ...]) -> tuple[int, ...]:\n    \"\"\"\n    Computes the pairwise sum of neighboring elements in the given tuple.\n    Assumes valid input of a tuple of integers with at least two elements.\n    \"\"\"\n    return tuple(input_tuple[i] + input_tuple[i+1] for i in range(len(input_tuple) - 1))"}
{"task_id": "Mbpp/465", "solution": "from typing import Any, Callable, Dict, Optional\ndef drop_empty(data: Dict, recursive: bool = False, rule: Optional[Callable[[Any], bool]] = None, remove_whitespace_str: bool = False) -> Dict:\n    \"\"\"\n    Drops empty items from a dictionary, optionally recursively and with custom rules.\n    Empty values are None, empty strings, or empty collections by default.\n    \"\"\"\n\n    def _default_is_empty(value: Any) -> bool:\n        \"\"\"Determines if a value is considered empty based on default rules.\"\"\"\n        if value is None:\n            return True\n        if isinstance(value, str):\n            return value == \"\" or (remove_whitespace_str and value.strip() == \"\")\n        if isinstance(value, (list, tuple, dict, set)):\n            return len(value) == 0\n        return False\n\n    is_empty_predicate = rule if rule is not None else _default_is_empty\n\n    cleaned_data = {}\n    for key, value in data.items():\n        if isinstance(value, Dict) and recursive:\n            cleaned_nested_dict = drop_empty(value, recursive=True, rule=rule, remove_whitespace_str=remove_whitespace_str)\n            if cleaned_nested_dict:\n                cleaned_data[key] = cleaned_nested_dict\n        elif not is_empty_predicate(value):\n            cleaned_data[key] = value\n\n    return cleaned_data"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(numbers: list[int], n: int) -> int:\n    \"\"\"\n    Find the product of an array of numbers modulo n.\n    This function uses modular multiplication to prevent overflow.\n    \"\"\"\n    \n    # Helper function for modular multiplication\n    def modular_multiply(a: int, b: int, mod: int) -> int:\n        return ((a % mod) * (b % mod)) % mod\n\n    # The initial result is 1 modulo n. This handles empty list and modulus 1 correctly.\n    result = 1 % n\n    \n    for x in numbers:\n        result = modular_multiply(result, x, n)\n        \n    return result"}
{"task_id": "Mbpp/468", "solution": "from typing import Sequence\ndef max_product(arr: Sequence[float], contiguous: bool = True) -> float:\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of an increasing subsequence.\n    Supports both contiguous and non-contiguous subsequences.\n    \"\"\"\n\n    def _max_product_contiguous_helper(sequence: Sequence[float]) -> float:\n        \"\"\"Calculates max product of a strictly increasing contiguous subarray.\"\"\"\n        n_cont = len(sequence)\n\n        # Initialize with the largest single element, as a single element is a valid increasing subsequence.\n        max_overall_product = max(sequence)\n\n        current_product = 1.0\n\n        for i in range(n_cont):\n            if i == 0 or sequence[i] > sequence[i - 1]:\n                current_product *= sequence[i]\n            else:\n                # Sequence broken, start a new one with the current element.\n                current_product = sequence[i]\n\n            # Update max_overall_product with the current sequence's product.\n            max_overall_product = max(max_overall_product, current_product)\n\n        return max_overall_product\n\n    def _max_product_subsequence_helper(sequence: Sequence[float]) -> float:\n        \"\"\"Calculates max product of a strictly increasing non-contiguous subsequence using DP.\"\"\"\n        n_sub = len(sequence)\n\n        # dp_max[i] stores the maximum product of an increasing subsequence ending at index i.\n        # dp_min[i] stores the minimum product (to handle negative numbers) of an increasing subsequence ending at index i.\n        dp_max = list(sequence)\n        dp_min = list(sequence)\n\n        # Initialize overall max product with the largest single element.\n        max_overall_product = max(sequence)\n\n        for i in range(n_sub):\n            # The initial value for dp_max[i] and dp_min[i] is sequence[i] itself.\n            # We then try to extend previous subsequences.\n            for j in range(i):\n                if sequence[j] < sequence[i]:\n                    # Consider extending the subsequence ending at j with sequence[i].\n                    # Products can be large positive or negative depending on signs.\n                    prod1 = dp_max[j] * sequence[i]\n                    prod2 = dp_min[j] * sequence[i]\n\n                    # Update dp_max[i] and dp_min[i] considering current element and extended products.\n                    dp_max[i] = max(dp_max[i], prod1, prod2)\n                    dp_min[i] = min(dp_min[i], prod1, prod2)\n\n            # Update the overall maximum product with the max product found ending at current index i.\n            max_overall_product = max(max_overall_product, dp_max[i])\n\n        return max_overall_product\n\n    # Dispatch based on the 'contiguous' flag\n    if contiguous:\n        return _max_product_contiguous_helper(arr)\n    else:\n        return _max_product_subsequence_helper(arr)"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(numbers: list) -> bool:\n    \"\"\"\n    Checks if the given list contains consecutive numbers, ignoring order but disallowing duplicates.\n    An empty list returns False, and a single-element list returns True.\n    \"\"\"\n    n = len(numbers)\n    if n == 0:\n        return False\n    if n == 1:\n        return True\n\n    unique_numbers = set(numbers)\n    # If there are duplicates, they cannot be consecutive\n    if len(unique_numbers) != n:\n        return False\n\n    min_val = min(unique_numbers)\n    max_val = max(unique_numbers)\n\n    # For a list of n unique numbers to be consecutive, the difference between\n    # the maximum and minimum values must be exactly n - 1.\n    return (max_val - min_val + 1) == n"}
{"task_id": "Mbpp/473", "solution": "import collections\nfrom typing import Sequence, Iterable, Set, Tuple, Optional\ndef tuple_intersection(a: Iterable[Sequence[int]], b: Iterable[Sequence[int]]) -> Set[Tuple[int, int]]:\n    \"\"\"\n    Finds the tuple intersection of elements in two tuple lists,\n    irrespective of the order of elements within each tuple.\n    \"\"\"\n    \n    class InvalidInputError(Exception):\n        \"\"\"Exception raised for invalid input data.\"\"\"\n        pass\n\n    class RepositoryError(Exception):\n        \"\"\"Exception raised for repository operation failures.\"\"\"\n        pass\n\n    class TupleUtils:\n        \"\"\"Utility class for tuple normalization.\"\"\"\n        @staticmethod\n        def normalize_pair(pair: Sequence[int]) -> Tuple[int, int]:\n            # Assumes input pair is valid (sequence of 2 ints) as per constraints.\n            val1, val2 = pair[0], pair[1]\n            return (val1, val2) if val1 <= val2 else (val2, val1)\n\n    class IntersectionResult:\n        \"\"\"Holds the result of an intersection operation.\"\"\"\n        def __init__(self, matches: Optional[Iterable[Tuple[int, int]]] = None) -> None:\n            self.matches = set(matches) if matches is not None else set()\n\n        def to_set(self) -> Set[Tuple[int, int]]:\n            return self.matches\n\n    class InMemoryTupleRepository:\n        \"\"\"A minimal in-memory repository stub for tuple sets.\"\"\"\n        def __init__(self, persistence_path: Optional[str] = None) -> None:\n            self._store: dict[str, set[Tuple[int, int]]] = {}\n            self._persistence_path = persistence_path\n\n        def get(self, key: str) -> Optional[Set[Tuple[int, int]]]:\n            return None # Caching not implemented for this context.\n\n        def set(self, key: str, value: Iterable[Tuple[int, int]]) -> None:\n            pass # Caching not implemented for this context.\n\n        def persist(self) -> None:\n            pass # Persistence not implemented for this context.\n\n        def load(self) -> None:\n            pass # Loading not implemented for this context.\n\n    class IntersectionService:\n        \"\"\"Core service to compute tuple intersections.\"\"\"\n        def __init__(self, repo: Optional[InMemoryTupleRepository] = None) -> None:\n            self._repo = repo or InMemoryTupleRepository(None)\n\n        def compute_intersection(self, a: Iterable[Sequence[int]], b: Iterable[Sequence[int]]) -> IntersectionResult:\n            normalized_a = {TupleUtils.normalize_pair(p) for p in a}\n            normalized_b = {TupleUtils.normalize_pair(p) for p in b}\n            \n            matches = normalized_a & normalized_b\n            return IntersectionResult(matches)\n\n    # Instantiate the service and compute the intersection.\n    service = IntersectionService()\n    result = service.compute_intersection(a, b)\n    return result.to_set()"}
{"task_id": "Mbpp/475", "solution": "def sort_counter(d: dict, reverse: bool = True):\n    \"\"\"\n    Sorts a dictionary by its values and returns a list of (key, value) tuples.\n    By default, values are sorted in descending order.\n    \"\"\"\n    validate_mapping(d)\n    items = list(d.items())\n    items.sort(key=lambda kv: kv[1], reverse=reverse)\n    return items"}
