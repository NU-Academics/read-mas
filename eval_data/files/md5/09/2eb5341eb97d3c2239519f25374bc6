{"task_id": "Mbpp/586", "solution": "def split_Arr(arr: list, n: int) -> list:\n    \"\"\"\n    Splits a list at the nth element and adds the first part to the end.\n    The index n is normalized to handle negative or out-of-bounds values.\n    \"\"\"\n    if not arr:\n        return []\n\n    effective_n = n % len(arr)\n    first_part = arr[:effective_n]\n    second_part = arr[effective_n:]\n    return second_part + first_part"}
{"task_id": "Mbpp/591", "solution": "def swap_List(items):\n    \"\"\"\n    Interchanges the first and last elements in a list.\n    Returns a new list with the swapped elements, without modifying the original.\n    \"\"\"\n    # Create a mutable shallow copy of the input sequence.\n    my_list = list(items)\n\n    n = len(my_list)\n\n    # If the list has 0 or 1 elements, no swap is needed.\n    if n <= 1:\n        return my_list\n\n    # Swap the first and last elements in the copied list.\n    my_list[0], my_list[n - 1] = my_list[n - 1], my_list[0]\n\n    return my_list"}
{"task_id": "Mbpp/585", "solution": "def expensive_items(items, n, strict=False, use_heap=False):\n    import json\n    import os\n    import heapq\n    from abc import ABC, abstractmethod\n    from dataclasses import dataclass\n    from typing import List, Union, Optional, Any\n\n    # --- Exceptions ---\n    class InvalidInputError(Exception):\n        \"\"\"Raised when input data is invalid or malformed.\"\"\"\n        pass\n\n    class NotEnoughItemsError(Exception):\n        \"\"\"Raised when strict mode is enabled and n > number of available items.\"\"\"\n        pass\n\n    class RepositoryError(Exception):\n        \"\"\"Raised for errors within the data repository layer.\"\"\"\n        pass\n\n    # --- Models ---\n    @dataclass\n    class Item:\n        \"\"\"Domain model for an item with name, price, and optional metadata.\"\"\"\n        name: str\n        price: float\n        metadata: Optional[dict] = None\n\n        @staticmethod\n        def from_dict(d: dict) -> \"Item\":\n            \"\"\"Creates an Item instance from a dictionary.\"\"\"\n            if 'name' not in d or 'price' not in d:\n                raise InvalidInputError(\"Item must have 'name' and 'price' fields.\")\n            try:\n                price = float(d['price'])\n            except (ValueError, TypeError):\n                raise InvalidInputError(f\"Price for item '{d.get('name', 'unknown')}' must be numeric.\")\n            \n            metadata = {k: v for k, v in d.items() if k not in ('name', 'price')}\n            return Item(name=str(d['name']), price=price, metadata=metadata or None)\n\n        def to_dict(self) -> dict:\n            \"\"\"Converts the Item instance back to a dictionary.\"\"\"\n            out = {'name': self.name, 'price': self.price}\n            if self.metadata:\n                out.update(self.metadata)\n            return out\n\n    # --- Utils ---\n    def parse_items(items_input: Union[List[dict], List[Item], str]) -> List[Item]:\n        \"\"\"Parses various input types into a list of Item objects.\"\"\"\n        items_list: List[Item] = []\n\n        if isinstance(items_input, str):\n            if not os.path.exists(items_input):\n                raise FileNotFoundError(f\"File not found: {items_input}\")\n            try:\n                with open(items_input, 'r', encoding='utf-8') as f:\n                    data = json.load(f)\n                if not isinstance(data, list):\n                    raise InvalidInputError(\"JSON file must contain a list of items.\")\n                items_list = [Item.from_dict(d) for d in data]\n            except (json.JSONDecodeError, UnicodeDecodeError) as e:\n                raise InvalidInputError(f\"Invalid JSON file format or encoding: {e}\")\n            except Exception as e:\n                raise InvalidInputError(f\"Error reading or parsing JSON file: {e}\")\n        elif isinstance(items_input, list):\n            if not items_input:\n                return []\n            if isinstance(items_input[0], dict):\n                items_list = [Item.from_dict(d) for d in items_input]\n            elif isinstance(items_input[0], Item):\n                items_list = items_input\n            else:\n                raise InvalidInputError(\"List items must be dictionaries or Item objects.\")\n        else:\n            raise InvalidInputError(\"Input 'items' must be a list of dicts/Items or a file path (str).\")\n\n        return items_list\n\n    # --- Repositories ---\n    class DataRepository(ABC):\n        \"\"\"Abstract base class for data repositories.\"\"\"\n        @abstractmethod\n        def get_all(self) -> List[Item]:\n            pass\n\n    class InMemoryRepository(DataRepository):\n        \"\"\"In-memory implementation of DataRepository.\"\"\"\n        def __init__(self, initial_data: Optional[List[Union[dict, Item]]] = None) -> None:\n            self._items: List[Item] = []\n            if initial_data is not None:\n                self._items = parse_items(initial_data)\n\n        def get_all(self) -> List[Item]:\n            \"\"\"Returns a shallow copy of all items in the repository.\"\"\"\n            return list(self._items)\n        \n        def _set_items(self, items: List[Item]) -> None:\n            \"\"\"Internal method to replace current items with a new list of Item objects.\"\"\"\n            self._items = items\n\n    # --- Services ---\n    class ExpensiveItemService:\n        \"\"\"Business logic for selecting the n most expensive items.\"\"\"\n        def __init__(self, repository: DataRepository):\n            self._repository = repository\n\n        def get_top_n_expensive(self, n: int, use_heap: bool=False, strict: bool=False) -> List[Item]:\n            \"\"\"Retrieves the top n most expensive items from the repository.\"\"\"\n            if not isinstance(n, int) or n < 1:\n                raise InvalidInputError(\"n must be an integer >= 1.\")\n\n            items = self._repository.get_all()\n\n            if strict and n > len(items):\n                raise NotEnoughItemsError(f\"Requested {n} items but only {len(items)} available.\")\n            \n            if not items:\n                return []\n\n            if use_heap:\n                return heapq.nlargest(n, items, key=lambda i: i.price)\n            else:\n                return sorted(items, key=lambda i: i.price, reverse=True)[:n]\n\n    # --- Controllers ---\n    class ExpensiveItemsController:\n        \"\"\"Controller for the public API, handling input/output and orchestrating service.\"\"\"\n        def __init__(self, service: ExpensiveItemService) -> None:\n            self._service = service\n\n        def expensive_items(self, items_input: Union[List[dict], List[Item], str], n: int, strict: bool=False, use_heap: bool=False) -> List[dict]:\n            \"\"\"Finds the n most expensive items from the given input data.\"\"\"\n            # If the service's repository is empty (because original `items` was a string path),\n            # this method parses the path and populates the repository for this call.\n            current_repo_items = self._service._repository.get_all()\n            if not current_repo_items and isinstance(items_input, str):\n                parsed_items = parse_items(items_input)\n                if isinstance(self._service._repository, InMemoryRepository):\n                    self._service._repository._set_items(parsed_items)\n            \n            result_items = self._service.get_top_n_expensive(n, use_heap=use_heap, strict=strict)\n            \n            return [item.to_dict() for item in result_items]\n\n    # --- Public API Entry Point ---\n    # This orchestrates the creation of repository, service, and controller.\n    # The InMemoryRepository is initialized with items if it's a list, otherwise empty.\n    repo = InMemoryRepository(items if not isinstance(items, str) else None)\n    service = ExpensiveItemService(repo)\n    controller = ExpensiveItemsController(service)\n    \n    # The controller's method then handles potentially loading items if `items` was a string path.\n    return controller.expensive_items(items, n, strict=strict, use_heap=use_heap)"}
{"task_id": "Mbpp/589", "solution": "import math\ndef perfect_squares(start: int | float, end: int | float) -> list[int]:\n    \"\"\"\n    Finds perfect squares between two given numbers, inclusive.\n    Handles swapping start and end if start > end.\n    \"\"\"\n\n    def _integer_sqrt(n: int) -> int:\n        \"\"\"Computes the integer square root of n, returning 0 for negative inputs.\"\"\"\n        if n < 0:\n            return 0\n        return math.isqrt(n)\n\n    _start = int(start)\n    _end = int(end)\n\n    if _start > _end:\n        _start, _end = _end, _start\n\n    # If the upper bound is negative, no non-negative perfect squares exist in the range.\n    if _end < 0:\n        return []\n\n    # Determine the smallest integer k whose square is >= _start.\n    # We only care about non-negative squares, so ensure the effective start for sqrt is at least 0.\n    effective_start_for_sqrt = max(0, _start)\n    k_start = _integer_sqrt(effective_start_for_sqrt)\n    if k_start * k_start < effective_start_for_sqrt:\n        k_start += 1\n    \n    # Determine the largest integer k whose square is <= _end.\n    k_end = _integer_sqrt(_end)\n\n    squares = []\n    # Iterate through potential integer roots and append their squares.\n    for k in range(k_start, k_end + 1):\n        squares.append(k * k)\n\n    return squares"}
{"task_id": "Mbpp/592", "solution": "def sum_Of_product(n: int) -> int:\n    \"\"\"\n    Finds the sum of the product of consecutive binomial coefficients using the identity C(2n, n-1).\n    For n=0, the sum is defined as 0.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    def combinations(N: int, K: int) -> int:\n        \"\"\"\n        Calculates C(N, K) using a multiplicative formula for efficiency.\n        Handles base cases and symmetry C(N, K) = C(N, N-K).\n        \"\"\"\n        if K < 0 or K > N:\n            return 0\n        if K == 0 or K == N:\n            return 1\n        if K > N // 2:\n            K = N - K\n\n        res = 1\n        for i in range(K):\n            res = res * (N - i) // (i + 1)\n        return res\n\n    # The identity is sum_{k=0}^{n-1} C(n,k) * C(n,k+1) = C(2n, n-1) for n >= 1\n    return combinations(2 * n, n - 1)"}
{"task_id": "Mbpp/590", "solution": "import math\nfrom typing import Tuple\ndef polar_rect(a: float, b: float) -> Tuple[Tuple[float, float], complex]:\n    \"\"\"\n    Converts inputs (a, b) in two ways:\n    1. Interprets (a, b) as rectangular (x, y) and returns polar (r, theta).\n    2. Interprets (a, b) as polar (r, theta) and returns rectangular (x, y) as a complex number.\n    \"\"\"\n    # Part 1: Convert rectangular (x=a, y=b) to polar (r_rect, theta_rect)\n    r_rect = math.sqrt(a*a + b*b)\n    theta_rect = math.atan2(b, a)\n    polar_from_rect = (r_rect, theta_rect)\n\n    # Part 2: Convert polar (r=a, theta=b) to rectangular (x_polar, y_polar)\n    # The design specifies a tolerance for very small real/imaginary parts.\n    tolerance = 1e-15 # From ComplexFactory design\n    \n    r_polar = a\n    theta_polar = b\n\n    x_polar = r_polar * math.cos(theta_polar)\n    y_polar = r_polar * math.sin(theta_polar)\n\n    # Apply tolerance to zero out tiny real or imaginary components\n    if abs(x_polar) < tolerance:\n        x_polar = 0.0\n    if abs(y_polar) < tolerance:\n        y_polar = 0.0\n    \n    rect_from_polar = complex(x_polar, y_polar)\n\n    return (polar_from_rect, rect_from_polar)"}
{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip: str) -> str:\n    \"\"\"Removes leading zeros from each octet of an IP address string.\"\"\"\n    octets = ip.split('.')\n    normalized_octets = []\n    for octet in octets:\n        stripped_octet = octet.lstrip('0')\n        if not stripped_octet:  # Handle cases like \"0\", \"00\", \"000\" which should become \"0\"\n            normalized_octets.append('0')\n        else:\n            normalized_octets.append(stripped_octet)\n    return \".\".join(normalized_octets)"}
