{"task_id": "Mbpp/90", "solution": "def len_log(words: list) -> int:\n    \"\"\"\n    Finds the length of the longest word in a list of words.\n    Words are stripped of leading/trailing whitespace before length calculation.\n    \"\"\"\n    if not words:\n        return 0\n\n    max_length = 0\n    for word in words:\n        stripped_word_length = len(word.strip())\n        if stripped_word_length > max_length:\n            max_length = stripped_word_length\n            \n    return max_length"}
{"task_id": "Mbpp/91", "solution": "def find_substring(strings: list, query: str, case_sensitive: bool = False) -> bool:\n    \"\"\"\n    Checks if a query string is a substring of any string in a list.\n    By default, the search is case-insensitive.\n    \"\"\"\n    for item in strings:\n        haystack = item if case_sensitive else item.lower()\n        needle = query if case_sensitive else query.lower()\n        if needle in haystack:\n            return True\n    return False"}
