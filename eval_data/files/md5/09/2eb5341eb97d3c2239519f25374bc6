{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum, endnum):\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    Zero digits are ignored; a number itself being 0 is not considered divisible.\n    \"\"\"\n    result = []\n    for n in range(startnum, endnum + 1):\n        if n == 0:\n            continue\n        \n        # Extract non-zero digits of the absolute value of n\n        num_str = str(abs(n))\n        non_zero_digits = [int(d) for d in num_str if d != '0']\n\n        if not non_zero_digits:  # If n only contains zeros (e.g., 0, 100, 200), treat as divisible if it's not zero.\n                                 # For example, 10 is divisible by 1. 200 is divisible by 2.\n            # This specific condition implies that if a number (like 10, 20)\n            # has only one non-zero digit and it is divisible by that digit, it counts.\n            # The prompt implies that 0 is ignored. So, for a number like 10, the non-zero digits are [1].\n            # 10 % 1 == 0, so 10 is divisible.\n            # The `if not non_zero_digits:` block is only reached for `n` values like 0,\n            # which is already handled by `if n == 0: continue`.\n            # So, for n > 0, non_zero_digits will always have at least one element.\n            pass # No non-zero digits means vacuously true *if the number itself is not zero*.\n                 # However, given `n > 0` and `non_zero_digits` being empty implies `abs(n)` has no non-zero digits,\n                 # which is only possible if `n` is `0`, already handled.\n                 # So this branch realistically won't be hit for positive `n`.\n\n        is_divisible = True\n        for digit in non_zero_digits:\n            if n % digit != 0:\n                is_divisible = False\n                break\n        \n        if is_divisible:\n            result.append(n)\n            \n    return result"}
{"task_id": "Mbpp/743", "solution": "def rotate_right(items: list, k: int) -> list:\n    \"\"\"Rotates a list to the right by k positions.\n    Returns a new list without modifying the original.\"\"\"\n    n = len(items)\n    if n == 0:\n        return []\n\n    # Normalize k to be within [0, n-1]\n    k_normalized = k % n\n\n    if k_normalized == 0:\n        return list(items)  # Return a copy if no rotation is needed\n\n    # Perform the rotation using list slicing\n    return items[-k_normalized:] + items[:-k_normalized]"}
{"task_id": "Mbpp/748", "solution": "import re\ndef capital_words_spaces(text):\n    \"\"\"\n    Puts spaces between words starting with capital letters in a given string.\n    Handles CamelCase/PascalCase and acronyms.\n    \"\"\"\n    if not text:\n        return \"\"\n\n    s = text.strip()\n\n    # Handle acronym followed by titlecase, e.g., \"HTTPResponse\" -> \"HTTP Response\"\n    s = re.sub(r'([A-Z]+)([A-Z][a-z])', r'\\1 \\2', s)\n    # Insert space before capital letters preceded by lowercase or digits\n    s = re.sub(r'(?<=[a-z0-9])([A-Z])', r' \\1', s)\n    # Normalize any sequence of whitespace characters to a single space\n    s = re.sub(r'\\s+', ' ', s)\n\n    return s"}
{"task_id": "Mbpp/749", "solution": "from typing import List, Any\nclass SortError(Exception):\n    \"\"\"Base exception for sorting errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass TypeValidationError(SortError):\n    \"\"\"Raised when the input list type is invalid.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass ParseValidationError(SortError):\n    \"\"\"Raised when one or more string items cannot be parsed to an integer.\"\"\"\n    def __init__(self, message: str, offending_indices: List[int], offending_values: List[str]) -> None:\n        super().__init__(message)\n        self.offending_indices = offending_indices\n        self.offending_values = offending_values\ndef normalize_string(s: str) -> str:\n    \"\"\"Trims leading/trailing whitespace from a string.\"\"\"\n    return s.strip()\ndef to_int_safe(s: str) -> int:\n    \"\"\"Converts a string to an integer, raising ValueError if empty or non-numeric.\"\"\"\n    if s == \"\":\n        raise ValueError(\"empty string\")\n    return int(s, 10)\nclass InputValidator:\n    \"\"\"Validates top-level input and basic item conditions.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def validate_iterable(self, strings: Any) -> None:\n        \"\"\"Ensures the input is an iterable of strings, not a single string or None.\"\"\"\n        if not hasattr(strings, '__iter__') or strings is None:\n            raise TypeValidationError(\"Input must be an iterable (e.g., list, tuple), not None or a scalar.\")\n        if isinstance(strings, (str, bytes, dict)):\n             if isinstance(strings, str):\n                 raise TypeValidationError(\"Input cannot be a single string, expected a list of strings.\")\n             if isinstance(strings, bytes):\n                 raise TypeValidationError(\"Input cannot be bytes, expected a list of strings.\")\n             if isinstance(strings, dict):\n                 raise TypeValidationError(\"Input cannot be a dictionary, expected a list of strings.\")\n\n    def validate_item_basic(self, s: str, index: int) -> None:\n        \"\"\"Checks if a string item is empty or only whitespace after normalization.\"\"\"\n        normalized = normalize_string(s)\n        if not normalized:\n            raise ParseValidationError(\n                f\"Item at index {index} is an empty or whitespace-only string.\",\n                [index],\n                [s]\n            )\nclass StringParser:\n    \"\"\"Handles conversion of string items to integers and aggregates errors.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def parse_to_ints(self, strings: List[str]) -> List[int]:\n        \"\"\"Converts each string in the list to an integer, collecting and raising parsing errors.\"\"\"\n        results = []\n        errors_idx = []\n        errors_vals = []\n        for i, raw_item in enumerate(strings):\n            s_to_process = str(raw_item)\n            normalized_s = normalize_string(s_to_process)\n\n            try:\n                n = to_int_safe(normalized_s)\n                results.append(n)\n            except ValueError:\n                errors_idx.append(i)\n                errors_vals.append(raw_item)\n\n        if errors_idx:\n            raise ParseValidationError(\n                \"Some values could not be parsed as integers.\",\n                errors_idx,\n                errors_vals\n            )\n        return results\nclass SortService:\n    \"\"\"Orchestrates validation, parsing, and numerical sorting of string numbers.\"\"\"\n    def __init__(self, parser: StringParser, validator: InputValidator) -> None:\n        \"\"\"Initializes the service with necessary parser and validator components.\"\"\"\n        self._parser = parser\n        self._validator = validator\n\n    def sort(self, strings: List[str]) -> List[int]:\n        \"\"\"Validates the input, converts string numbers to integers, and sorts them numerically.\"\"\"\n        self._validator.validate_iterable(strings)\n        numbers = self._parser.parse_to_ints(strings)\n        return self._sort_numbers(numbers)\n\n    def _sort_numbers(self, numbers: List[int]) -> List[int]:\n        \"\"\"Sorts a list of integers in ascending order.\"\"\"\n        return sorted(numbers)\n_default_service = SortService(parser=StringParser(), validator=InputValidator())\ndef sort_numeric_strings(strings: List[str]) -> List[int]:\n    \"\"\"Sorts a given list of strings of numbers numerically.\"\"\"\n    return _default_service.sort(strings)"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr):\n    \"\"\"Checks if the given array represents a min-heap.\"\"\"\n    from typing import Sequence, Any, Optional, Callable\n\n    class ValidationError(Exception):\n        \"\"\"Custom exception for validation errors.\"\"\"\n        def __init__(self, message: str) -> None:\n            self.message = message\n            super().__init__(message)\n\n    def _is_sequence(obj: Any) -> bool:\n        \"\"\"Checks if an object is a sequence (not string/bytes).\"\"\"\n        return hasattr(obj, \"__iter__\") and not isinstance(obj, (str, bytes))\n\n    def _safe_compare(a: Any, b: Any) -> bool:\n        \"\"\"Compares two elements for min-heap property (a <= b).\"\"\"\n        return a <= b\n\n    class _HeapArray:\n        \"\"\"Encapsulates an array and provides index computations for binary heap layout.\"\"\"\n        def __init__(self, items: Sequence[Any]) -> None:\n            if not _is_sequence(items):\n                raise ValidationError(\"Input must be a sequence.\")\n            self._items = list(items)\n\n        def __len__(self) -> int:\n            return len(self._items)\n\n        def get(self, index: int) -> Any:\n            return self._items[index]\n\n        def left_index(self, parent: int) -> int:\n            return 2 * parent + 1\n\n        def right_index(self, parent: int) -> int:\n            return 2 * parent + 2\n\n        def has_left(self, parent: int) -> bool:\n            return self.left_index(parent) < len(self)\n\n        def has_right(self, parent: int) -> bool:\n            return self.right_index(parent) < len(self)\n\n    class _ValidationResult:\n        \"\"\"Immutable DTO for validation outcome.\"\"\"\n        def __init__(self, success: bool, first_violation_index: Optional[int]=None, message: str=\"\"):\n            self.success = success\n            self.first_violation_index = first_violation_index\n            self.message = message\n\n    class _HeapValidator:\n        \"\"\"Implements the min-heap check algorithm.\"\"\"\n        def __init__(self, comparator: Optional[Callable[[Any, Any], bool]] = None) -> None:\n            self._comparator = comparator or _safe_compare\n\n        def validate(self, items: Sequence[Any]) -> _ValidationResult:\n            heap = _HeapArray(items)\n            n = len(heap)\n\n            if n <= 1:\n                return _ValidationResult(True, None, \"Array represents a min-heap.\")\n\n            for i in range(n // 2): # Iterate over parent nodes\n                parent_value = heap.get(i)\n\n                if heap.has_left(i):\n                    left_child_idx = heap.left_index(i)\n                    left_child_value = heap.get(left_child_idx)\n                    if not self._compare(parent_value, left_child_value):\n                        return _ValidationResult(False, i, f\"Violation: parent at index {i} ({parent_value}) is greater than left child at index {left_child_idx} ({left_child_value})\")\n\n                if heap.has_right(i):\n                    right_child_idx = heap.right_index(i)\n                    right_child_value = heap.get(right_child_idx)\n                    if not self._compare(parent_value, right_child_value):\n                        return _ValidationResult(False, i, f\"Violation: parent at index {i} ({parent_value}) is greater than right child at index {right_child_idx} ({right_child_value})\")\n            \n            return _ValidationResult(True, None, \"Array represents a min-heap.\")\n\n        def _compare(self, parent: Any, child: Any) -> bool:\n            try:\n                return self._comparator(parent, child)\n            except TypeError as exc:\n                raise ValidationError(f\"Incomparable elements found: {exc}\")\n\n    DEFAULT_VALIDATOR = _HeapValidator()\n    result = DEFAULT_VALIDATOR.validate(arr)\n    return result.success"}
