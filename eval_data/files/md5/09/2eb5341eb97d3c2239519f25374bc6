{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    \"\"\"\n    Sets the left-most unset bit in the binary representation of a non-negative integer n.\n    If all bits up to the most significant bit are set, it sets the next higher bit.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Find the index of the most significant set bit (0-indexed)\n    msb_index = n.bit_length() - 1\n\n    # Iterate from MSB down to 0 to find the first unset bit\n    for i in range(msb_index, -1, -1):\n        if ((n >> i) & 1) == 0:\n            # If the bit at position 'i' is unset, set it and return\n            return n | (1 << i)\n\n    # If all bits from MSB down to 0 are set, set the bit at msb_index + 1\n    return n | (1 << (msb_index + 1))"}
{"task_id": "Mbpp/308", "solution": "def large_product(a, b, k):\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list.\n    \"\"\"\n    import heapq\n\n    # Convert inputs to lists of floats\n    a_f = [float(x) for x in a]\n    b_f = [float(x) for x in b]\n\n    # Handle edge cases: k=0, or empty input lists\n    if k == 0 or not a_f or not b_f:\n        return []\n\n    m, n = len(a_f), len(b_f)\n\n    # Sort both lists in descending order.\n    # This ordering helps in exploring candidate products efficiently from the largest elements.\n    sa = sorted(a_f, reverse=True)\n    sb = sorted(b_f, reverse=True)\n\n    # Max-heap to store candidate products.\n    # We store (-product, index_a, index_b) to simulate a max-heap using Python's min-heap.\n    candidate_heap = []\n\n    # Set to keep track of visited (index_a, index_b) pairs to avoid redundant processing.\n    visited = set()\n\n    # Initial candidate: product of the two largest elements (from sorted descending lists).\n    # This covers cases like largest positive*positive. For mixed signs, the heap exploration\n    # from this point, combined with exploring neighbors, helps find all largest products.\n    initial_product = sa[0] * sb[0]\n    heapq.heappush(candidate_heap, (-initial_product, 0, 0))\n    visited.add((0, 0))\n\n    # List to store the k largest products found.\n    result_products = []\n\n    # Extract k largest products from the heap\n    while len(result_products) < k and candidate_heap:\n        neg_prod, i, j = heapq.heappop(candidate_heap)\n        current_product = -neg_prod\n        result_products.append(current_product)\n\n        # Explore neighbors: (i+1, j) and (i, j+1).\n        # These represent moving to the next element in either list `sa` or `sb`.\n        # The `visited` set ensures each unique pair is processed only once.\n\n        # Consider moving to the next element in list `sa`\n        if i + 1 < m and (i + 1, j) not in visited:\n            next_product_a = sa[i+1] * sb[j]\n            heapq.heappush(candidate_heap, (-next_product_a, i + 1, j))\n            visited.add((i + 1, j))\n\n        # Consider moving to the next element in list `sb`\n        if j + 1 < n and (i, j + 1) not in visited:\n            next_product_b = sa[i] * sb[j+1]\n            heapq.heappush(candidate_heap, (-next_product_b, i, j + 1))\n            visited.add((i, j + 1))\n    \n    # The products in `result_products` are not guaranteed to be in descending order\n    # because products are extracted from the heap as they are determined to be the largest\n    # available candidate, not necessarily strictly in final sorted order.\n    # Sort the final list to meet the deterministic output ordering requirement.\n    result_products.sort(reverse=True)\n    \n    return result_products"}
{"task_id": "Mbpp/389", "solution": "class MemoizationCache:\n    \"\"\"In-memory memoization store for Lucas numbers.\n    It uses a simple FIFO eviction policy when max_entries is reached.\n    \"\"\"\n    def __init__(self, max_entries: int = 100000) -> None:\n        self._store: dict[int, int] = {}\n        self.max_entries = max_entries\n\n    def get(self, n: int) -> int | None:\n        return self._store.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        if len(self._store) >= self.max_entries:\n            self._store.pop(next(iter(self._store)))\n        self._store[n] = value\n\n    def clear(self) -> None:\n        self._store.clear()\nclass LucasCalculator:\n    \"\"\"Computes Lucas numbers, utilizing a cache for efficiency.\n    It uses an iterative approach to calculate the sequence.\n    \"\"\"\n    def __init__(self, cache: \"MemoizationCache\" | None = None) -> None:\n        self._cache = cache or MemoizationCache()\n\n    def compute(self, n: int) -> int:\n        cached = self._cache.get(n)\n        if cached is not None:\n            return cached\n        value = self._iterative(n)\n        self._cache.set(n, value)\n        return value\n\n    def _iterative(self, n: int) -> int:\n        if n == 0:\n            return 2\n        if n == 1:\n            return 1\n        a, b = 2, 1\n        for _ in range(2, n + 1):\n            a, b = b, a + b\n        return b\nclass InputValidator:\n    \"\"\"Validates the input 'n' for Lucas number calculations.\n    It ensures 'n' is an non-negative integer within a specified maximum limit.\n    \"\"\"\n    @staticmethod\n    def validate_n(n: int, max_n: int = 1_000_000) -> None:\n        if not isinstance(n, int):\n            raise ValueError(f\"n must be an int, got {type(n).__name__}\")\n        if n < 0:\n            raise ValueError(\"n must be non-negative\")\n        if n > max_n:\n            raise ValueError(f\"n must be <= {max_n}\")\nclass LucasService:\n    \"\"\"Orchestrates validation and computation for Lucas numbers.\n    It combines an InputValidator and a LucasCalculator to fulfill requests.\n    \"\"\"\n    def __init__(self, calculator: LucasCalculator | None = None, validator: InputValidator | None = None, max_n: int = 1_000_000) -> None:\n        self.calculator = calculator or LucasCalculator()\n        self.validator = validator or InputValidator()\n        self.max_n = max_n\n\n    def find_lucas(self, n: int) -> int:\n        self.validator.validate_n(n, self.max_n)\n        return self.calculator.compute(n)\n_service = LucasService()\ndef find_lucas(n: int) -> int:\n    \"\"\"\n    Finds the n'th Lucas number.\n    Delegates to an internal service for validation and computation.\n    \"\"\"\n    return _service.find_lucas(n)"}
