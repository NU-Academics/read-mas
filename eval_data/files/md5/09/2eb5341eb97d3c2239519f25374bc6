{"task_id": "Mbpp/409", "solution": "import numbers\nfrom typing import Any, List, Tuple, Union\nNumber = Union[int, float]\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input data.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass TuplePair:\n    \"\"\"Represents a pair of numeric values.\"\"\"\n    def __init__(self, a: Number, b: Number) -> None:\n        self.a: Number = a\n        self.b: Number = b\n\n    def as_tuple(self) -> Tuple[Number, Number]:\n        \"\"\"Returns the pair as a native tuple.\"\"\"\n        return (self.a, self.b)\nclass MathUtils:\n    \"\"\"Utility class for basic mathematical operations.\"\"\"\n    @staticmethod\n    def product(a: Number, b: Number) -> Number:\n        \"\"\"Calculates the product of two numbers.\"\"\"\n        return a * b\nclass InputValidator:\n    \"\"\"Validates the structure and types of the input list of pairs.\"\"\"\n    MAX_PAIRS = 100000\n\n    @staticmethod\n    def validate_list_of_pairs(data: Any) -> None:\n        \"\"\"Validates that the input is a non-empty list of 2-item numeric tuples/lists.\"\"\"\n        if not isinstance(data, (list, tuple)):\n            raise InvalidInputError(\"Input must be a list of 2-item tuples/lists.\")\n        if not data: # len(data) == 0\n            raise InvalidInputError(\"Input list must not be empty.\")\n        if len(data) > InputValidator.MAX_PAIRS:\n            raise InvalidInputError(f\"Input list exceeds maximum allowed pairs ({InputValidator.MAX_PAIRS}).\")\n        for i, pair in enumerate(data):\n            InputValidator._validate_pair(pair, i)\n\n    @staticmethod\n    def _validate_pair(pair: Any, index: int) -> None:\n        \"\"\"Validates a single element to ensure it's a 2-item numeric tuple/list.\"\"\"\n        if not isinstance(pair, (list, tuple)) or len(pair) != 2:\n            raise InvalidInputError(f\"Item at index {index} is not a 2-item tuple/list.\")\n        a, b = pair\n        if not isinstance(a, numbers.Real) or not isinstance(b, numbers.Real):\n            raise InvalidInputError(f\"Non-numeric element found in pair at index {index}.\")\nclass TupleListRepository:\n    \"\"\"Converts a raw list of pairs into a list of TuplePair objects.\"\"\"\n    @staticmethod\n    def load_from_list(raw_input_list: List[Any]) -> List[TuplePair]:\n        \"\"\"Loads and converts raw list items into TuplePair objects.\"\"\"\n        pairs: List[TuplePair] = []\n        for item in raw_input_list:\n            # InputValidator ensures item is a 2-item numeric iterable\n            pairs.append(TuplePair(item[0], item[1]))\n        return pairs\nclass MinProductService:\n    \"\"\"Provides the core logic to compute the minimum product from TuplePair objects.\"\"\"\n    @staticmethod\n    def min_product(pairs: List[TuplePair]) -> Number:\n        \"\"\"Calculates the minimum product from a list of TuplePair objects.\"\"\"\n        # InputValidator already ensures `pairs` is not empty.\n        min_value = MathUtils.product(pairs[0].a, pairs[0].b)\n        for p in pairs[1:]:\n            current_product = MathUtils.product(p.a, p.b)\n            if current_product < min_value:\n                min_value = current_product\n        return min_value\ndef min_product_tuple(list_of_pairs: Any) -> Number:\n    \"\"\"\n    Finds the minimum product from the pairs of tuples within a given list.\n\n    The function validates the input, converts it to an internal model,\n    and then computes the minimum product using dedicated service logic.\n    \"\"\"\n    InputValidator.validate_list_of_pairs(list_of_pairs)\n    pairs_model = TupleListRepository.load_from_list(list_of_pairs)\n    result = MinProductService.min_product(pairs_model)\n    return result"}
{"task_id": "Mbpp/410", "solution": "import re\nfrom dataclasses import dataclass\nfrom typing import Any, Sequence\nfrom decimal import Decimal\nclass NoNumericValuesError(ValueError):\n    \"\"\"Exception raised when no numeric values are found in the input sequence.\"\"\"\n    def __init__(self, message: str = \"No numeric values found\"):\n        super().__init__(message)\n        self.message = message\nclass NumericParser:\n    \"\"\"Helper class to detect and parse numeric values from various types.\"\"\"\n    NUMERIC_STR_REGEX = r'^[+-]?\\d+(\\.\\d+)?$'\n\n    @staticmethod\n    def is_numeric(value: Any) -> bool:\n        \"\"\"Checks if a value can be interpreted as a number.\"\"\"\n        if isinstance(value, (int, float, Decimal)):\n            return True\n        if isinstance(value, str):\n            return bool(re.match(NumericParser.NUMERIC_STR_REGEX, value.strip()))\n        return False\n\n    @staticmethod\n    def parse_numeric(value: Any) -> float:\n        \"\"\"Converts a supported numeric type or string to a float.\"\"\"\n        if isinstance(value, (int, float)):\n            return float(value)\n        if isinstance(value, Decimal):\n            return float(value)\n        if isinstance(value, str):\n            s = value.strip()\n            if not NumericParser.is_numeric(s):\n                raise ValueError(f\"Not numeric: {value!r}\")\n            return float(s)\n        raise ValueError(f\"Not numeric: {value!r}\")\nclass MinFinderService:\n    \"\"\"Core logic to compute the smallest numeric value from a sequence.\"\"\"\n    def __init__(self, parser: NumericParser = None) -> None:\n        self._parser = parser or NumericParser()\n\n    def find_min(self, values: Sequence[Any]) -> MinResult:\n        \"\"\"Iterates over values, converts numeric items, and tracks the minimum.\"\"\"\n        min_val_found = None\n        count = 0\n        for v in values:\n            if self._parser.is_numeric(v):\n                num = self._parser.parse_numeric(v)\n                if min_val_found is None or num < min_val_found:\n                    min_val_found = num\n                count += 1\n        if count == 0:\n            raise NoNumericValuesError()\n        return MinResult(value=float(min_val_found), count=count)\nclass MinFinderAPI:\n    \"\"\"Public API facade for consumers of the min-finding functionality.\"\"\"\n    def __init__(self, service: MinFinderService = None) -> None:\n        self._service = service or MinFinderService()\n\n    def min_val(self, values: Sequence[Any]) -> float:\n        \"\"\"Retrieves the minimum numeric value from a sequence as a float.\"\"\"\n        result = self._service.find_min(values)\n        return float(result.value)\ndef min_val(values: Sequence[Any]) -> float:\n    \"\"\"Finds the minimum numeric value in a given heterogeneous list.\n    Ignores non-numeric items and raises NoNumericValuesError if no numerics are found.\"\"\"\n    return MinFinderAPI().min_val(values)"}
{"task_id": "Mbpp/412", "solution": "from typing import Iterable, List, Any\nclass RemoveOddError(Exception):\n    \"\"\"Custom exception for errors during number filtering.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass InputValidator:\n    \"\"\"Validates and coerces input into a list of integers.\"\"\"\n    def validate_numbers(self, numbers: Any) -> List[int]:\n        \"\"\"Attempts to convert each element in the input to an integer.\"\"\"\n        try:\n            # Check if numbers is iterable\n            _ = iter(numbers)\n        except TypeError:\n            raise RemoveOddError(\"Input must be an iterable of integers\")\n\n        result = []\n        for i, v in enumerate(numbers):\n            try:\n                iv = int(v)\n            except Exception:\n                raise RemoveOddError(f\"Element at index {i} cannot be converted to int: {v!r}\")\n            result.append(iv)\n        return result\nclass NumberFilterService:\n    \"\"\"Provides the core business logic for filtering numbers.\"\"\"\n    def __init__(self, validator: InputValidator) -> None:\n        self._validator = validator\n\n    def remove_odd(self, numbers: Iterable[int]) -> List[int]:\n        \"\"\"Validates numbers and returns a new list containing only even integers.\"\"\"\n        nums = self._validator.validate_numbers(numbers)\n        return [n for n in nums if n % 2 == 0]\ndef remove_odd(numbers: Iterable[int]) -> List[int]:\n    \"\"\"Removes odd numbers from the given list of integers.\"\"\"\n    validator = InputValidator()\n    service = NumberFilterService(validator)\n    return service.remove_odd(numbers)"}
{"task_id": "Mbpp/414", "solution": "from typing import Iterable, Any, Optional, Set, Tuple, List\nclass InvalidSequenceError(Exception):\n    \"\"\"Exception raised for invalid sequence inputs.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nMAX_SEQ_LENGTH: int = 1_000_000\ndef try_hash(value: Any) -> bool:\n    \"\"\"Attempts to hash a value and returns True if successful, False otherwise.\"\"\"\n    try:\n        hash(value)\n        return True\n    except TypeError:\n        return False\nclass SequenceAdapter:\n    \"\"\"Adapts an iterable into a set or list for overlap checking.\"\"\"\n    def __init__(self, max_length: int = MAX_SEQ_LENGTH):\n        self._max_length = max_length\n\n    def to_set(self, seq: Iterable) -> Tuple[Optional[Set], List]:\n        \"\"\"Converts an iterable to a set if possible, otherwise returns None with the list.\"\"\"\n        if seq is None:\n            raise InvalidSequenceError(\"sequence cannot be None\")\n        lst = list(seq)\n        if len(lst) > self._max_length:\n            raise InvalidSequenceError(f\"sequence length exceeds maximum of {self._max_length}\")\n        for v in lst:\n            if not try_hash(v):\n                return None, lst\n        return set(lst), lst\nclass OverlapService:\n    \"\"\"Provides the core logic for checking overlap between two sequences.\"\"\"\n    def __init__(self, adapter: SequenceAdapter):\n        self._adapter = adapter\n\n    def any_overlap(self, seq1: Iterable, seq2: Iterable) -> bool:\n        \"\"\"Checks if there is any common element between two sequences.\"\"\"\n        set1, list1 = self._adapter.to_set(seq1)\n        set2, list2 = self._adapter.to_set(seq2)\n\n        if set1 is not None and set2 is not None:\n            return bool(set1 & set2)\n        if set1 is not None:\n            return any(x in set1 for x in list2)\n        if set2 is not None:\n            return any(x in set2 for x in list1)\n\n        # Fallback to O(n*m) comparison if elements are unhashable\n        for item1 in list1:\n            for item2 in list2:\n                if item1 == item2:\n                    return True\n        return False\ndef overlapping(seq1: Iterable[Any], seq2: Iterable[Any]) -> bool:\n    \"\"\"\n    Checks whether any value in sequence `seq1` also exists in sequence `seq2`.\n    Uses an optimized approach with sets for hashable elements, falling back to pairwise comparison for unhashable elements.\n    \"\"\"\n    adapter = SequenceAdapter()\n    service = OverlapService(adapter)\n    return service.any_overlap(seq1, seq2)"}
{"task_id": "Mbpp/415", "solution": "import sys\ndef max_Product(nums):\n    # Find the two largest and two smallest numbers in a single pass.\n    # These candidates will form the pairs for the highest product.\n    max1 = -sys.maxsize - 1\n    max2 = -sys.maxsize - 1\n    min1 = sys.maxsize\n    min2 = sys.maxsize\n\n    for x in nums:\n        # Update the two largest numbers\n        if x >= max1:\n            max2 = max1\n            max1 = x\n        elif x > max2:\n            max2 = x\n\n        # Update the two smallest numbers\n        if x <= min1:\n            min2 = min1\n            min1 = x\n        elif x < min2:\n            min2 = x\n\n    # Calculate products of the two candidate pairs (two largest, two smallest)\n    product_pos = max1 * max2\n    product_neg = min1 * min2\n\n    # Return the pair with the highest product, ensuring elements are ordered.\n    if product_pos >= product_neg:\n        return (min(max1, max2), max(max1, max2))\n    else:\n        return (min(min1, min2), max(min1, min2))"}
{"task_id": "Mbpp/418", "solution": "def Find_Max(input_list):\n    \"\"\"\n    Finds the element in a list that has the maximum length.\n    Assumes the input list is not empty and contains elements that support the len() operation.\n    \"\"\"\n    max_element = None\n    max_length = -1\n\n    for element in input_list:\n        current_length = len(element)\n        if current_length > max_length:\n            max_length = current_length\n            max_element = element\n    return max_element"}
{"task_id": "Mbpp/419", "solution": "def round_and_sum(numbers):\n    \"\"\"\n    Rounds each number in a list, sums the rounded values, and multiplies the total by the list length.\n    The function prints the final result and returns it.\n    \"\"\"\n    rounded_numbers = [int(round(num)) for num in numbers]\n    total_sum = sum(rounded_numbers)\n    list_length = len(numbers)\n    result = total_sum * list_length\n    print(result)\n    return result"}
