{"task_id": "Mbpp/724", "solution": "class BigIntUtils:\n    @staticmethod\n    def safe_pow(base: int, power: int) -> int:\n        return pow(base, power)\n\n    @staticmethod\n    def int_to_digits(n: int) -> list[int]:\n        if n == 0:\n            return [0]\n        digits = []\n        while n:\n            digits.append(n % 10)\n            n //= 10\n        return digits[::-1]\n\n    @staticmethod\n    def sum_digits(n: int) -> int:\n        return sum(BigIntUtils.int_to_digits(n))\nclass CalculationRepository:\n    def __init__(self):\n        self._cache: dict[str, int] = {}\n\n    def get(self, key: str) -> int | None:\n        return self._cache.get(key)\n\n    def set(self, key: str, value: int) -> None:\n        self._cache[key] = value\n\n    def make_key(self, base: int, power: int) -> str:\n        return f\"{base}:{power}\"\nclass PowerService:\n    def __init__(self, repo: \"CalculationRepository\" = None):\n        self.repo = repo if repo is not None else CalculationRepository()\n\n    def compute_sum(self, base: int, power: int) -> int:\n        # Per instructions: \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n        # so no validation is performed on base/power here.\n        key = self.repo.make_key(base, power)\n        cached_sum = self.repo.get(key)\n\n        if cached_sum is not None:\n            return cached_sum\n        else:\n            value = BigIntUtils.safe_pow(base, power)\n            s = BigIntUtils.sum_digits(value)\n            self.repo.set(key, s)\n            return s\ndef power_base_sum(base: int, power: int) -> int:\n    \"\"\"Calculates the sum of all digits of the base to the specified power.\"\"\"\n    repo = CalculationRepository()\n    service = PowerService(repo=repo)\n    return service.compute_sum(base, power)"}
{"task_id": "Mbpp/723", "solution": "def count_same_pair(a, b):\n    \"\"\"\n    Counts the number of indices where two lists of the same length have equal values.\n    Assumes inputs are lists of equal length.\n    \"\"\"\n    count = 0\n    for x, y in zip(a, b):\n        if x == y:\n            count += 1\n    return count"}
{"task_id": "Mbpp/721", "solution": "def maxAverageOfPath(matrix: list[list[int]]) -> float:\n    \"\"\"\n    Finds the path from the top-left to the bottom-right cell with the maximum average cost,\n    moving only right or down.\n    \"\"\"\n    n = len(matrix)\n    if n == 0:\n        return 0.0\n    if n == 1:\n        return float(matrix[0][0])\n\n    def _can_achieve_target(current_matrix: list[list[int]], target: float) -> tuple[bool, list[tuple[int, int]] | None]:\n        \"\"\"\n        Checks if a path exists from (0,0) to (n-1,n-1) with an average cost\n        greater than or equal to the given target. It uses dynamic programming\n        on a transformed grid (cost' = cost - target).\n        \"\"\"\n        transformed = [[float(current_matrix[i][j]) - target for j in range(n)] for i in range(n)]\n\n        dp = [[-math.inf] * n for _ in range(n)]\n        parent = [[None] * n for _ in range(n)]  # Stores predecessor (prev_i, prev_j)\n\n        dp[0][0] = transformed[0][0]\n\n        for i in range(n):\n            for j in range(n):\n                if i == 0 and j == 0:\n                    continue\n\n                from_up_sum = -math.inf\n                if i > 0:\n                    from_up_sum = dp[i-1][j] + transformed[i][j]\n\n                from_left_sum = -math.inf\n                if j > 0:\n                    from_left_sum = dp[i][j-1] + transformed[i][j]\n\n                if from_up_sum > from_left_sum:\n                    dp[i][j] = from_up_sum\n                    if i > 0:\n                        parent[i][j] = (i-1, j)\n                else:\n                    dp[i][j] = from_left_sum\n                    if j > 0:\n                        parent[i][j] = (i, j-1)\n\n        if dp[n-1][n-1] >= 0:\n            # Path reconstruction\n            path = []\n            curr_i, curr_j = n-1, n-1\n            while True:\n                path.append((curr_i, curr_j))\n                if curr_i == 0 and curr_j == 0:\n                    break\n                prev_i, prev_j = parent[curr_i][curr_j]  # type: ignore\n                curr_i, curr_j = prev_i, prev_j\n            path.reverse()\n            return True, path\n        return False, None\n\n    import math\n\n    # Determine the range for binary search\n    min_val = float(matrix[0][0])\n    max_val = float(matrix[0][0])\n    for r in range(n):\n        for c in range(n):\n            min_val = min(min_val, float(matrix[r][c]))\n            max_val = max(max_val, float(matrix[r][c]))\n\n    low = min_val\n    high = max_val\n    eps = 1e-6  # Precision for binary search\n\n    best_avg = low\n    best_path: list[tuple[int, int]] = []\n\n    # Binary search for the maximum average\n    while high - low > eps:\n        mid = (low + high) / 2.0\n        ok, current_path = _can_achieve_target(matrix, mid)\n\n        if ok:\n            best_avg = mid\n            if current_path: # Store path if found\n                best_path = current_path\n            low = mid  # Try for a higher average\n        else:\n            high = mid # Target average too high\n\n    # After binary search, `best_avg` holds the maximum average found.\n    # If `best_path` is empty (e.g., if only a very low `min_val` was achievable in initial checks,\n    # or for edge cases where `current_path` was not captured),\n    # re-run _can_achieve_target with `best_avg` to ensure we get a valid path for final calculation.\n    if not best_path:\n        _, final_path_candidate = _can_achieve_target(matrix, best_avg)\n        if final_path_candidate:\n            best_path = final_path_candidate\n        else:\n            # This should ideally not happen for N>=1, as a path always exists.\n            # Fallback to a path with min_val, which is guaranteed to be achievable.\n            _, path_from_min = _can_achieve_target(matrix, min_val)\n            if path_from_min:\n                best_path = path_from_min\n            else:\n                # Should only happen if matrix is non-navigable (not possible with right/down moves on square grid)\n                # or N=0 (handled). For N=1, length is 1.\n                return float(matrix[0][0]) if n == 1 else 0.0 # Defensive, should not be reached\n\n    total_cost = sum(float(matrix[r][c]) for r, c in best_path)\n    num_cells = len(best_path)\n\n    return total_cost / num_cells"}
{"task_id": "Mbpp/725", "solution": "import re\nclass QuotationError(Exception):\n    def __init__(self, message: str, cause: Exception = None) -> None:\n        super().__init__(message)\n        self.cause = cause\ndef unescape_token(token: str) -> str:\n    \"\"\"Unescapes common escaped characters within a token.\"\"\"\n    return token.replace(r'\\\"', '\"').replace(r'\\\\', '\\\\')\ndef validate_text_input(text: str) -> str:\n    \"\"\"Passes through text, assuming it is valid string per type hint.\"\"\"\n    return text\nclass QuotationResult:\n    \"\"\"Data transfer object for extracted tokens.\"\"\"\n    def __init__(self, tokens: list[str]) -> None:\n        self.tokens = tokens\n\n    def as_list(self) -> list[str]:\n        \"\"\"Returns the list of tokens.\"\"\"\n        return self.tokens\nREGEX_PATTERN_SIMPLE = r'\"([^\"\\\\]*(?:\\\\.[^\"\\\\]*)*)\"'\nclass RegexExtractionStrategy:\n    \"\"\"Extracts tokens using a regular expression pattern.\"\"\"\n    def __init__(self, pattern: str = REGEX_PATTERN_SIMPLE) -> None:\n        self._pattern = re.compile(pattern)\n\n    def extract(self, text: str) -> list[str]:\n        \"\"\"Finds all non-overlapping matches and unescapes them.\"\"\"\n        matches = [unescape_token(m.group(1)) for m in self._pattern.finditer(text)]\n        return matches\nclass ExtractorService:\n    \"\"\"Orchestrates the extraction process using a given strategy.\"\"\"\n    def __init__(self, strategy: RegexExtractionStrategy) -> None:\n        self._strategy = strategy\n\n    def extract(self, text: str) -> QuotationResult:\n        \"\"\"Validates input and delegates to the extraction strategy.\"\"\"\n        validated_text = validate_text_input(text)\n        try:\n            tokens = self._strategy.extract(validated_text)\n            return QuotationResult(tokens)\n        except Exception as e:\n            raise QuotationError(f\"Extraction failed: {e}\", cause=e)\nclass QuotationController:\n    \"\"\"Controller to manage extraction requests.\"\"\"\n    def __init__(self, service: ExtractorService) -> None:\n        self._service = service\n\n    def extract(self, text: str) -> list[str]:\n        \"\"\"Calls the service to extract tokens and returns them as a list.\"\"\"\n        result = self._service.extract(text)\n        return result.as_list()\ndef extract_quotation(text: str) -> list[str]:\n    \"\"\"\n    Extracts values between quotation marks \" \" from the given string.\n    \"\"\"\n    service = ExtractorService(strategy=RegexExtractionStrategy())\n    controller = QuotationController(service=service)\n    return controller.extract(text)"}
{"task_id": "Mbpp/726", "solution": "def multiply_elements(input_tuple: tuple) -> tuple:\n    \"\"\"Calculates the product of adjacent elements in an input tuple.\n    Returns a new tuple where the i-th element is input_tuple[i] * input_tuple[i+1].\"\"\"\n    return tuple(input_tuple[i] * input_tuple[i+1] for i in range(len(input_tuple) - 1))"}
{"task_id": "Mbpp/730", "solution": "from typing import List, TypeVar\nT = TypeVar(\"T\")\ndef consecutive_duplicates(lst: List[T]) -> List[T]:\n    \"\"\"Removes consecutive duplicate elements from a list, preserving order.\"\"\"\n    result: List[T] = []\n    for item in lst:\n        if not result or item != result[-1]:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/722", "solution": "def filter_data(students: dict[str, tuple[float, float]], min_height: float, min_weight: float) -> dict[str, tuple[float, float]]:\n    \"\"\"Filters students based on height and weight thresholds.\n\n    Includes students whose height is strictly greater than min_height AND weight is greater than or equal to min_weight.\n    \"\"\"\n    filtered_students = {}\n    for name, (height, weight) in students.items():\n        if height > min_height and weight >= min_weight:\n            filtered_students[name] = (height, weight)\n    return filtered_students"}
{"task_id": "Mbpp/732", "solution": "def replace_specialchar(s: str) -> str:\n    \"\"\"\n    Replaces all occurrences of spaces, commas, or dots with a colon.\n    This function uses a translation table for efficient character replacement.\n    \"\"\"\n    if s is None:\n        raise ValueError(\"input must be a string\")\n\n    DEFAULT_TARGET_CHARS = {\" \", \",\", \".\"}\n    REPLACEMENT_CHAR = \":\"\n\n    # Build translation table\n    trans = str.maketrans({ch: REPLACEMENT_CHAR for ch in DEFAULT_TARGET_CHARS})\n    return str(s).translate(trans)"}
{"task_id": "Mbpp/731", "solution": "import math\ndef lateralsurface_cone(r,h):\n    \"\"\"\n    Calculates the lateral surface area of a cone.\n    The formula used is A = pi * r * s, where s is the slant height.\n    \"\"\"\n    slant_height = math.sqrt(r**2 + h**2)\n    lateral_area = math.pi * r * slant_height\n    return lateral_area"}
