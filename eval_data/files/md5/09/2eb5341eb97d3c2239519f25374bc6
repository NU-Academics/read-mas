{"task_id": "Mbpp/752", "solution": "class JacobsthalError(Exception):\n    pass\nclass InvalidInputError(JacobsthalError, ValueError):\n    pass\nclass JacobsthalCalculator:\n    \"\"\"Provides numeric algorithms to compute Jacobsthal numbers.\"\"\"\n    def compute_iterative(self, n: int) -> int:\n        \"\"\"Computes the nth Jacobsthal number iteratively.\"\"\"\n        if n < 0:\n            raise InvalidInputError(\"n must be non-negative\")\n        if n == 0:\n            return 0\n        if n == 1:\n            return 1\n        a, b = 0, 1\n        for _ in range(2, n + 1):\n            a, b = b, b + 2 * a\n        return b\nclass CacheRepository:\n    \"\"\"A simple in-memory cache for computed Jacobsthal numbers.\"\"\"\n    def __init__(self):\n        self._store: dict[int, int] = {}\n\n    def get(self, n: int) -> int | None:\n        return self._store.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        self._store[n] = value\n\n    def clear(self) -> None:\n        self._store.clear()\nclass JacobsthalService:\n    \"\"\"Manages the computation and caching of Jacobsthal numbers.\"\"\"\n    def __init__(self, repository: CacheRepository, calculator: JacobsthalCalculator | None = None):\n        self.repository = repository\n        self.calculator = calculator or JacobsthalCalculator()\n        self.repository.set(0, 0)\n        self.repository.set(1, 1)\n\n    def get(self, n: int) -> int:\n        \"\"\"Retrieves the nth Jacobsthal number, using cache or computing it.\"\"\"\n        if n < 0:\n            raise InvalidInputError(\"n must be non-negative\")\n        cached = self.repository.get(n)\n        if cached is not None:\n            return cached\n        value = self.calculator.compute_iterative(n)\n        self.repository.set(n, value)\n        return value\n\n    def clear_cache(self) -> None:\n        self.repository.clear()\n_default_service = JacobsthalService(CacheRepository(), JacobsthalCalculator())\ndef jacobsthal_num(n: int) -> int:\n    \"\"\"Finds the nth Jacobsthal number.\"\"\"\n    return _default_service.get(n)"}
{"task_id": "Mbpp/753", "solution": "import heapq\nfrom typing import List, Tuple\ndef min_k(data: List[Tuple[str, int]], k: int) -> List[Tuple[str, int]]:\n    \"\"\"\n    Finds the minimum k records from a list of (name, value) tuples.\n    Records are sorted by value ascending, with original order preserved for equal values.\n    \"\"\"\n    # Annotate each tuple with its value and original index to ensure stable sorting by value.\n    # The format is (value, original_index, original_tuple).\n    annotated_data = [(item[1], i, item) for i, item in enumerate(data)]\n    \n    # Use heapq.nsmallest to efficiently find the k smallest items.\n    # The key ensures items are compared first by value, then by original index for stability.\n    smallest_k_items = heapq.nsmallest(k, annotated_data, key=lambda x: (x[0], x[1]))\n    \n    # Extract and return the original tuples from the result.\n    return [item[2] for item in smallest_k_items]"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds elements that are common across three lists at the same index.\n    \"\"\"\n    result = []\n    min_len = min(len(l1), len(l2), len(l3))\n    for i in range(min_len):\n        if l1[i] == l2[i] and l2[i] == l3[i]:\n            result.append(l1[i])\n    return result"}
{"task_id": "Mbpp/758", "solution": "from collections import Counter\nfrom typing import List, Any, Dict, Tuple\ndef unique_sublists(list_of_lists: List[List[Any]]) -> Dict[Tuple[Any, ...], int]:\n    \"\"\"\n    Counts occurrences of sublists within a list, returning a dictionary\n    mapping each unique sublist (converted to a tuple) to its count.\n    \"\"\"\n    tuple_representation = (tuple(sublist) for sublist in list_of_lists)\n    counts = Counter(tuple_representation)\n    return dict(counts)"}
{"task_id": "Mbpp/759", "solution": "import re\ndef is_decimal(s: str) -> bool:\n    \"\"\"Checks if a string represents a decimal number with a precision of 2.\n    Handles optional sign, leading/trailing whitespace, and ensures exactly two digits after the decimal point.\"\"\"\n    if s is None:\n        return False\n\n    stripped_s = s.strip()\n\n    # The regex matches an optional sign, one or more digits, a literal decimal point, and exactly two digits.\n    # re.fullmatch ensures the entire string matches the pattern.\n    pattern = r'^[+-]?(\\d+)\\.(\\d{2})$'\n    match = re.fullmatch(pattern, stripped_s)\n\n    return match is not None"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(strings: List[str]) -> int:\n    \"\"\"\n    Counts pairs of strings in the list where one is the reverse of the other.\n    The algorithm efficiently handles palindromes and duplicate strings.\n    \"\"\"\n    counts = {}\n    total_pairs = 0\n\n    for s in strings:\n        reversed_s = s[::-1]\n        # Add the number of times the reversed string has been seen to the total.\n        total_pairs += counts.get(reversed_s, 0)\n        \n        # Increment the count for the current string.\n        counts[s] = counts.get(s, 0) + 1\n        \n    return total_pairs"}
{"task_id": "Mbpp/760", "solution": "def unique_Element(numbers: list) -> bool:\n    \"\"\"\n    Checks if a list of numbers contains only one distinct element.\n    Returns False for an empty list.\n    \"\"\"\n    if not numbers:\n        return False\n    \n    distinct_elements = set(numbers)\n    return len(distinct_elements) == 1"}
