{"task_id": "Mbpp/638", "solution": "def wind_chill(velocity_kmh: float, temp_c: float) -> int:\n    \"\"\"\n    Calculates the wind chill index given wind velocity in km/h and temperature in Celsius.\n    The result is rounded to the nearest integer according to the Canadian/NIOSH formula.\n    \"\"\"\n    # Formula constants\n    A = 13.12\n    B = 0.6215\n    C = 11.37\n    D = 0.3965\n\n    # Calculate v^0.16\n    v_pow_16 = velocity_kmh ** 0.16\n\n    # Apply the wind chill formula\n    raw_wind_chill = A + B * temp_c - C * v_pow_16 + D * temp_c * v_pow_16\n\n    # Round to the nearest integer and convert to int\n    return int(round(raw_wind_chill))"}
{"task_id": "Mbpp/641", "solution": "import collections\nfrom typing import Optional, Protocol\nclass NonagonalNumber:\n    \"\"\"Represents a computed nonagonal number.\"\"\"\n    def __init__(self, index: int, value: int) -> None:\n        self.index = index\n        self.value = value\n\n    def to_dict(self) -> dict:\n        \"\"\"Returns the nonagonal number as a dictionary.\"\"\"\n        return {\"index\": self.index, \"value\": self.value}\ndef nonagonal_formula(n: int) -> int:\n    \"\"\"Computes the nth nonagonal number using the formula P9(n) = (7*n^2 - 5*n) / 2.\"\"\"\n    validate_index(n)\n    return (7 * n * n - 5 * n) // 2\nclass CacheRepository(Protocol):\n    \"\"\"Abstract base class for a cache repository.\"\"\"\n    def get(self, key: int) -> Optional[int]:\n        ...\n\n    def set(self, key: int, value: int) -> None:\n        ...\n\n    def clear(self) -> None:\n        ...\nclass InMemoryCacheRepository:\n    \"\"\"An in-memory LRU cache repository.\"\"\"\n    def __init__(self, max_size: int = 128) -> None:\n        self._max_size = max_size\n        self._store: dict[int, int] = {}\n        self._order: collections.deque[int] = collections.deque()\n\n    def get(self, key: int) -> Optional[int]:\n        if key in self._store:\n            self._order.remove(key)\n            self._order.append(key)\n            return self._store[key]\n        return None\n\n    def set(self, key: int, value: int) -> None:\n        if key in self._store:\n            self._order.remove(key)\n        elif len(self._order) >= self._max_size:\n            lru_key = self._order.popleft()\n            del self._store[lru_key]\n        self._store[key] = value\n        self._order.append(key)\n\n    def clear(self) -> None:\n        self._store.clear()\n        self._order.clear()\nclass NonagonalService:\n    \"\"\"Orchestrates validation, caching, and computation of nonagonal numbers.\"\"\"\n    def __init__(self, cache_repo: Optional[CacheRepository] = None) -> None:\n        self._cache: CacheRepository = cache_repo if cache_repo is not None else InMemoryCacheRepository()\n\n    def compute(self, n: int) -> NonagonalNumber:\n        \"\"\"\n        Computes the nth nonagonal number, using cache if available.\n        Validates input and stores result in cache.\n        \"\"\"\n        validate_index(n)\n        \n        cached = self._cache.get(n)\n        if cached is not None:\n            return NonagonalNumber(n, cached)\n        \n        value = nonagonal_formula(n)\n        try:\n            self._cache.set(n, value)\n        except Exception:\n            pass\n        return NonagonalNumber(n, value)\n\n    def is_cached(self, n: int) -> bool:\n        \"\"\"Checks if the nth nonagonal number is in the cache.\"\"\"\n        return self._cache.get(n) is not None\ndef is_nonagonal(n: int) -> int:\n    \"\"\"Calculates the nth nonagonal number.\"\"\"\n    svc = NonagonalService()\n    return svc.compute(n).value"}
{"task_id": "Mbpp/643", "solution": "import re\ndef text_match_wordz_middle(text: str) -> bool:\n    \"\"\"\n    Checks if any word in the text contains 'z' (case-insensitive) not at its start or end.\n    \"\"\"\n    word_pattern = re.compile(r\"\\w+\", re.UNICODE)\n    words = word_pattern.findall(text)\n\n    for word in words:\n        if len(word) < 3:\n            continue\n        \n        lower_word = word.lower()\n        # Check for 'z' at any position except the first (index 0) and the last (index len-1)\n        for i in range(1, len(lower_word) - 1):\n            if lower_word[i] == 'z':\n                return True\n    return False"}
