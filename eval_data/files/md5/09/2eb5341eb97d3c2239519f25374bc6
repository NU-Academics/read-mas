{"task_id": "Mbpp/227", "solution": "from dataclasses import dataclass\nimport math\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass InputValidator:\n    \"\"\"Validates and normalizes inputs to a NumberTriple.\"\"\"\n    _ALLOW_NAN: bool = False\n\n    @classmethod\n    def validate(cls, a: object, b: object, c: object) -> NumberTriple:\n        \"\"\"Converts inputs to floats, rejecting non-numeric types and NaN.\"\"\"\n        def _to_float(v: object) -> float:\n            if isinstance(v, bool):\n                raise InvalidInputError(\"bool is not accepted as numeric\")\n            try:\n                fv = float(v)\n            except (TypeError, ValueError):\n                raise InvalidInputError(f\"Value {v!r} is not numeric\")\n            if not cls._ALLOW_NAN and math.isnan(fv):\n                raise InvalidInputError(\"NaN is not allowed\")\n            return fv\n        return NumberTriple(_to_float(a), _to_float(b), _to_float(c))\nclass MinService:\n    \"\"\"Provides the core logic for finding the minimum of three numbers.\"\"\"\n    @staticmethod\n    def min_of_three(triple: NumberTriple) -> float:\n        \"\"\"Computes and returns the minimum of the three numbers in the triple.\"\"\"\n        return min(triple.as_tuple())\nclass MinController:\n    \"\"\"Orchestrates input validation and minimum computation.\"\"\"\n    @staticmethod\n    def compute_min(a: object, b: object, c: object) -> float:\n        \"\"\"Validates inputs and computes the minimum using the MinService.\"\"\"\n        triple = InputValidator.validate(a, b, c)\n        return MinService.min_of_three(triple)\ndef min_of_three(a: object, b: object, c: object) -> float:\n    \"\"\"\n    Finds the minimum of three numbers.\n    Inputs are validated and converted to float before comparison.\n    \"\"\"\n    return MinController.compute_min(a, b, c)"}
