{"task_id": "Mbpp/767", "solution": "from collections import Counter\ndef get_pairs_count(numbers: list[int], sum: int) -> int:\n    \"\"\"\n    Counts the number of unordered pairs in a list that sum up to a target value.\n    Uses a frequency map for O(N) time complexity.\n    \"\"\"\n    target_sum = sum\n    freq_map = Counter(numbers)\n    total_pairs = 0\n\n    for num, count in list(freq_map.items()):\n        complement = target_sum - num\n        if complement not in freq_map:\n            continue\n\n        if num == complement:\n            # If the number is its own complement, count combinations (nC2)\n            total_pairs += count * (count - 1) // 2\n        elif num < complement:\n            # Count pairs with a distinct complement, ensuring (num, complement) is counted once\n            total_pairs += count * freq_map[complement]\n\n    return total_pairs"}
{"task_id": "Mbpp/769", "solution": "from typing import List, Set, Iterable, Any, Tuple\nfrom dataclasses import dataclass\nclass ListDiffError(Exception):\n    \"\"\"Custom exception for errors during list difference computation.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        return f\"ListDiffError: {self.message}\"\nclass ListNormalizer:\n    \"\"\"Validates and normalizes iterables into a list of integers.\"\"\"\n    def normalize_and_validate(self, seq: Iterable[Any]) -> List[int]:\n        \"\"\"Converts an iterable to a list, ensuring all elements are integers or convertible to integers.\"\"\"\n        if not isinstance(seq, Iterable):\n            raise ListDiffError(f\"Input must be an iterable, got {type(seq).__name__}.\")\n        \n        normalized_list = []\n        for item in seq:\n            try:\n                normalized_item = int(item)\n                normalized_list.append(normalized_item)\n            except (ValueError, TypeError):\n                raise ListDiffError(f\"All elements must be integers or convertible to integers, got {type(item).__name__} for '{item}'.\")\n        return normalized_list\ndef _evens_first(items: List[int]) -> List[int]:\n    \"\"\"Orders items by even-indexed elements first, then odd-indexed, retaining relative order.\"\"\"\n    evens = [x for i, x in enumerate(items) if i % 2 == 0]\n    odds = [x for i, x in enumerate(items) if i % 2 == 1]\n    return evens + odds\ndef _preserve(items: List[int]) -> List[int]:\n    \"\"\"Returns items with their original relative order preserved.\"\"\"\n    return items\ndef apply_strategy(items: List[int], strategy: str) -> List[int]:\n    \"\"\"Applies the specified ordering strategy to the list of items.\"\"\"\n    if strategy == \"evens_first\":\n        return _evens_first(items)\n    if strategy == \"preserve\":\n        return _preserve(items)\n    raise ListDiffError(f\"Unknown strategy: {strategy}\")\nclass DiffService:\n    \"\"\"Implements the core difference calculation and applies ordering strategies.\"\"\"\n    def __init__(self, normalizer: ListNormalizer) -> None:\n        self._normalizer = normalizer\n        self._supported_strategies: Set[str] = {\"evens_first\", \"preserve\"}\n\n    def compute(self, list_a: Iterable[Any], list_b: Iterable[Any], strategy: str = \"evens_first\") -> DiffResult:\n        \"\"\"Computes the difference between two lists and applies the specified ordering strategy.\"\"\"\n        a_normalized = self._normalizer.normalize_and_validate(list_a)\n        b_normalized = self._normalizer.normalize_and_validate(list_b)\n        \n        if strategy not in self._supported_strategies:\n            raise ListDiffError(f\"Strategy '{strategy}' is not supported. Supported strategies are: {', '.join(sorted(self._supported_strategies))}.\")\n\n        b_set: Set[int] = set(b_normalized)\n        filtered = self._difference(a_normalized, b_set)\n        ordered = apply_strategy(filtered, strategy)\n        return DiffResult(items=ordered)\n\n    def _difference(self, list_a: List[int], list_b_set: Set[int]) -> List[int]:\n        \"\"\"Calculates items present in list_a but not in list_b_set, preserving duplicates.\"\"\"\n        return [x for x in list_a if x not in list_b_set]\nclass DiffController:\n    \"\"\"Orchestrates list difference computation using normalizer and service.\"\"\"\n    def __init__(self, service: DiffService) -> None:\n        self._service = service\n\n    def compute_difference(self, list_a: Iterable[Any], list_b: Iterable[Any], strategy: str = \"evens_first\") -> List[int]:\n        \"\"\"Orchestrates the computation of list difference and returns the result.\"\"\"\n        result = self._service.compute(list_a, list_b, strategy=strategy)\n        return result.to_list()\n_normalizer = ListNormalizer()\n_service = DiffService(_normalizer)\n_controller = DiffController(_service)\ndef Diff(list_a: Iterable[Any], list_b: Iterable[Any], *, strategy: str = \"evens_first\") -> List[int]:\n    \"\"\"\n    Computes the difference between two lists, returning elements present in list_a but not in list_b.\n    The default 'evens_first' strategy orders results by even-indexed survivors first, then odd.\n    \"\"\"\n    return _controller.compute_difference(list_a, list_b, strategy=strategy)"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"Calculates the sum of the fourth powers of the first n odd natural numbers.\n    Assumes n is an integer >= 1.\"\"\"\n    total_sum = 0\n    for i in range(n):\n        odd_number = 2 * i + 1\n        total_sum += odd_number ** 4\n    return total_sum"}
{"task_id": "Mbpp/772", "solution": "def remove_length(text, k):\n    \"\"\"\n    Removes all words of a given length k from the input string.\n    Words are split by whitespace, and punctuation is treated as part of the word.\n    \"\"\"\n    words = text.split()\n    filtered_words = [word for word in words if len(word) != k]\n    return \" \".join(filtered_words)"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets using a stack-based approach.\n    Only parentheses, square brackets, and curly braces are considered; other characters are ignored.\n    \"\"\"\n    class Stack:\n        \"\"\"A simple LIFO stack implementation.\"\"\"\n        def __init__(self):\n            self._items = []\n\n        def push(self, item):\n            self._items.append(item)\n\n        def pop(self):\n            if not self._items:\n                raise IndexError(\"pop from empty stack\")\n            return self._items.pop()\n\n        def is_empty(self):\n            return not self._items\n\n    bracket_pairs = {'(': ')', '[': ']', '{': '}'}\n    opening_brackets = set(bracket_pairs.keys())\n    closing_brackets = set(bracket_pairs.values())\n\n    s = Stack()\n    for char in expression:\n        if char in opening_brackets:\n            s.push(char)\n        elif char in closing_brackets:\n            try:\n                opening = s.pop()\n                if bracket_pairs[opening] != char:\n                    return False  # Mismatch found\n            except IndexError:\n                return False  # Closing bracket without a corresponding opening bracket\n\n    return s.is_empty() # Expression is balanced if the stack is empty at the end"}
{"task_id": "Mbpp/777", "solution": "def find_sum(numbers: list) -> int:\n    \"\"\"\n    Calculates the sum of non-repeated (distinct) elements in a list.\n    Elements are de-duplicated before summing.\n    \"\"\"\n    distinct_elements = set(numbers)\n    return sum(distinct_elements)"}
{"task_id": "Mbpp/775", "solution": "def odd_position(input_list):\n    \"\"\"\n    Checks if every odd index in a list contains an odd number.\n    Returns True if all odd-indexed numbers are odd, False otherwise.\n    \"\"\"\n    for i in range(1, len(input_list), 2):\n        if input_list[i] % 2 == 0:\n            return False\n    return True"}
{"task_id": "Mbpp/778", "solution": "from typing import Any, List\ndef pack_consecutive_duplicates(items: List[Any]) -> List[List[Any]]:\n    \"\"\"Packs consecutive duplicate elements of a list into sublists.\n    Processes the list in a single pass to group identical consecutive items.\"\"\"\n    if not items:\n        return []\n\n    packed_list: List[List[Any]] = []\n    current_group: List[Any] = []\n\n    for item in items:\n        if not current_group or item != current_group[-1]:\n            # Start a new group if current_group is empty or the item is different\n            if current_group:\n                packed_list.append(current_group)\n            current_group = [item]\n        else:\n            # Continue adding to the current group\n            current_group.append(item)\n\n    # Append the last accumulated group after the loop finishes\n    if current_group:\n        packed_list.append(current_group)\n\n    return packed_list"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(source_string: str, sub_string: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Finds the first occurrence and position of a substring within a string.\n    Returns None if the substring is not found.\n    \"\"\"\n    start_index = source_string.find(sub_string)\n    if start_index == -1:\n        return None\n    end_index = start_index + len(sub_string)\n    return (sub_string, start_index, end_index)"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of all odd-length subarrays of a given list of integers\n    using an O(N) formulaic approach.\n    \"\"\"\n    n = len(arr)\n    total = 0\n    for i, val in enumerate(arr):\n        # Calculate total subarrays starting at 'i' and ending at 'i' (inclusive)\n        # (i + 1) is the number of possible start indices for subarrays ending at or before arr[i]\n        # (n - i) is the number of possible end indices for subarrays starting at or after arr[i]\n        # This formula calculates the total number of subarrays in which arr[i] appears.\n        total_subarrays_containing_val = (i + 1) * (n - i)\n        \n        # For any given element, roughly half the subarrays it appears in will have odd length\n        # and half will have even length. When total_subarrays_containing_val is odd,\n        # there is one more odd-length subarray than even-length subarrays.\n        # This gives the exact count of odd-length subarrays that contain arr[i].\n        odd_count = (total_subarrays_containing_val + 1) // 2\n        \n        total += val * odd_count\n    return total"}
{"task_id": "Mbpp/780", "solution": "def find_combinations(tuple_list):\n    \"\"\"\n    Computes all unique pairwise element-wise sums of 2-tuples in the given list.\n    Results are ordered deterministically by the index of the combined input tuples (i < j).\n    \"\"\"\n    n = len(tuple_list)\n    result_combinations = []\n    for i in range(n):\n        for j in range(i + 1, n):\n            # Sum elements of tuple_list[i] and tuple_list[j]\n            sum_tuple = (tuple_list[i][0] + tuple_list[j][0],\n                         tuple_list[i][1] + tuple_list[j][1])\n            result_combinations.append(sum_tuple)\n    return result_combinations"}
{"task_id": "Mbpp/784", "solution": "class MissingNumberError(ValueError):\n    \"\"\"Raised when the list does not contain at least one odd and one even integer.\"\"\"\n    pass\ndef mul_even_odd(numbers: list) -> int:\n    \"\"\"\n    Finds the product of the first even and odd number in a given list.\n    Raises MissingNumberError if either number is not found.\n    \"\"\"\n    first_odd = None\n    first_even = None\n\n    for n in numbers:\n        if first_odd is None and n % 2 != 0:\n            first_odd = n\n        if first_even is None and n % 2 == 0:\n            first_even = n\n        \n        if first_odd is not None and first_even is not None:\n            break\n    \n    if first_odd is None or first_even is None:\n        raise MissingNumberError(\"List must contain at least one odd and one even integer.\")\n    \n    return first_odd * first_even"}
{"task_id": "Mbpp/781", "solution": "import math\ndef count_divisors(n: int) -> bool:\n    \"\"\"Calculates the number of positive divisors for n and checks if the count is even.\"\"\"\n    limit = math.isqrt(n)\n    count = 0\n    for i in range(1, limit + 1):\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n    return count % 2 == 0"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(seq, value):\n    \"\"\"\n    Locates the right insertion point for a value in a sorted sequence.\n    This uses a binary search algorithm to find the index where the value\n    would be inserted to maintain sorted order, appearing after existing equal values.\n    \"\"\"\n    n = len(seq)\n    left, right = 0, n\n\n    while left < right:\n        mid = (left + right) // 2\n        if seq[mid] <= value:\n            left = mid + 1\n        else:\n            right = mid\n    return left"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(s: str) -> tuple[int, ...]:\n    \"\"\"\n    Converts a string representing a tuple of integers to an actual Python tuple of integers.\n    Handles whitespace and empty/single-element tuples, and ignores empty strings from trailing commas.\n    \"\"\"\n    s = s.strip()\n    if not s.startswith('(') or not s.endswith(')'):\n        # According to constraints, do not raise exceptions for edge cases.\n        # If input is not correctly formatted, subsequent operations might fail naturally.\n        pass\n\n    # Remove outer parentheses and strip any leading/trailing whitespace from the inner content\n    inner_str = s[1:-1].strip()\n\n    if not inner_str:\n        return ()\n\n    # Split the inner string by commas to get individual token strings\n    tokens = inner_str.split(',')\n\n    # Convert each non-empty, stripped token to an integer\n    result_ints = []\n    for token in tokens:\n        stripped_token = token.strip()\n        if stripped_token:  # Only process non-empty tokens (handles trailing commas producing empty strings)\n            result_ints.append(int(stripped_token)) # int() will raise ValueError for non-integer strings\n\n    return tuple(result_ints)"}
