{"task_id": "Mbpp/440", "solution": "import re\nimport json\nfrom pathlib import Path\nfrom typing import Tuple, Optional\nclass Token:\n    \"\"\"Represents a token with its text and original sentence offsets.\"\"\"\n    def __init__(self, text: str, start: int, end: int):\n        self.text = text\n        self.start = start\n        self.end = end\n\n    def __repr__(self) -> str:\n        return f\"Token(text='{self.text}', start={self.start}, end={self.end})\"\ndef normalize_word(word: str) -> str:\n    \"\"\"Lowercases a word and strips leading/trailing non-alphanumeric characters.\"\"\"\n    return re.sub(r'^\\W+|\\W+$', '', word.lower())\ndef strip_punct_keep_offsets(token_text: str, original_start: int, original_text: str) -> Tuple[str, int, int]:\n    \"\"\"Adjusts token offsets by stripping leading/trailing non-alphabetic punctuation.\"\"\"\n    match = re.search(r'[a-zA-Z]+', token_text)\n    if match:\n        new_start = original_start + match.start()\n        new_end = original_start + match.end()\n        return match.group(0), new_start, new_end\n    return \"\", original_start, original_start\nclass AdverbLexiconRepository:\n    \"\"\"Manages an in-memory set of adverbs for quick lookup.\"\"\"\n    def __init__(self, lexicon_path: Optional[str] = None):\n        self.adverbs_set = set()\n        # Hardcode a small lexicon for self-contained function execution.\n        hardcoded_lexicon = [\n            \"clearly\", \"quickly\", \"slowly\", \"silently\", \"happily\",\n            \"sadly\", \"badly\", \"well\", \"ever\", \"never\", \"always\",\n            \"often\", \"sometimes\", \"rarely\", \"usually\", \"just\",\n            \"already\", \"yet\", \"still\", \"soon\", \"late\", \"early\",\n            \"tomorrow\", \"yesterday\", \"today\", \"here\", \"there\", \"everywhere\",\n            \"somewhere\", \"nowhere\", \"anywhere\", \"up\", \"down\", \"in\", \"out\",\n            \"away\", \"back\", \"almost\", \"hardly\", \"nearly\", \"quite\", \"rather\",\n            \"very\", \"too\", \"enough\", \"so\", \"such\", \"how\", \"what\", \"where\",\n            \"when\", \"why\"\n        ]\n        self.adverbs_set = {w.lower() for w in hardcoded_lexicon}\n\n    def load(self) -> None:\n        \"\"\"Loads or reloads the lexicon (no-op with hardcoded lexicon).\"\"\"\n        pass\n\n    def is_adverb(self, word: str) -> bool:\n        \"\"\"Checks if a word is an adverb based on lexicon or -ly suffix.\"\"\"\n        w = word.lower()\n        return w in self.adverbs_set or w.endswith(\"ly\")\n\n    def add_adverb(self, word: str) -> None:\n        \"\"\"Adds an adverb to the in-memory lexicon.\"\"\"\n        self.adverbs_set.add(word.lower())\nclass SimpleTokenizer:\n    \"\"\"A basic tokenizer that extracts word-like sequences with their offsets.\"\"\"\n    def __init__(self):\n        self.word_pattern = re.compile(r\"[A-Za-z]+(?:'[A-Za-z]+)?\")\n\n    def tokenize_with_offsets(self, text: str) -> list[Token]:\n        \"\"\"Tokenizes text and returns a list of Token objects.\"\"\"\n        return [Token(m.group(0), m.start(), m.end()) for m in self.word_pattern.finditer(text)]\nclass AdverbFinderService:\n    \"\"\"Provides core logic to find the first adverb in a sentence.\"\"\"\n    def __init__(self, tokenizer: 'SimpleTokenizer', lexicon: 'AdverbLexiconRepository', max_length: int = 10000) -> None:\n        self.tokenizer = tokenizer\n        self.lexicon = lexicon\n        self.max_length = max_length\n\n    def find_first_adverb(self, sentence: str) -> Tuple[Optional[int], Optional[int], Optional[str]]:\n        \"\"\"Finds the first adverb in the given sentence and returns its position and normalized form.\"\"\"\n        tokens = self.tokenizer.tokenize_with_offsets(sentence)\n        for tok in tokens:\n            inner, s, e = strip_punct_keep_offsets(tok.text, tok.start, sentence)\n            norm = normalize_word(inner)\n            if norm and self.lexicon.is_adverb(norm):\n                return (s, e, norm)\n        return (None, None, None)\n_repo = AdverbLexiconRepository()\n_tokenizer = SimpleTokenizer()\n_service = AdverbFinderService(_tokenizer, _repo)\ndef find_adverb_position(sentence: str) -> Tuple[Optional[int], Optional[int], Optional[str]]:\n    \"\"\"Finds the first adverb and its positions in a given sentence.\"\"\"\n    return _service.find_first_adverb(sentence)"}
