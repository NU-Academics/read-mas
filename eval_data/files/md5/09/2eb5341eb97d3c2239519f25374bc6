{"task_id": "Mbpp/632", "solution": "def move_zero(nums: list) -> list:\n    \"\"\"Moves all zeros to the end of the list while preserving the order of non-zero elements.\n\n    This function creates a new list without modifying the original.\n    \"\"\"\n    result = []\n    zero_count = 0\n    for v in nums:\n        if v == 0:  # Check for integer 0 or float 0.0\n            zero_count += 1\n        else:\n            result.append(v)\n    result.extend([0] * zero_count)\n    return result"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers, n):\n    \"\"\"\n    Calculates the sum of XOR of all unique pairs of numbers in the given list.\n    The parameter 'n' is expected to be the length of the 'numbers' list.\n    \"\"\"\n    if n <= 1:\n        return 0\n\n    # Determine the maximum bit width needed to represent all numbers (considering absolute values).\n    max_abs_val = 0\n    for num in numbers:\n        if abs(num) > max_abs_val:\n            max_abs_val = abs(num)\n            \n    bit_width = 1 if max_abs_val == 0 else max_abs_val.bit_length()\n\n    total_xor_sum = 0\n    \n    # Iterate through each bit position from 0 up to bit_width-1.\n    for b in range(bit_width):\n        count_set_bit = 0\n        # Count how many numbers have the current bit 'b' set.\n        for num in numbers:\n            # Normalize negative numbers to their unsigned representation based on bit_width.\n            # This ensures consistent bitwise operations as described in two's complement logic.\n            normalized_num = num if num >= 0 else num & ((1 << bit_width) - 1)\n            \n            if (normalized_num >> b) & 1:\n                count_set_bit += 1\n        \n        # The contribution of bit 'b' to the total XOR sum comes from pairs where this bit is different.\n        # There are `count_set_bit` numbers with the bit set, and `n - count_set_bit` numbers with the bit unset.\n        # Each such pair contributes 1 at bit position 'b' to their XOR sum.\n        # The total contribution is (count_set_bit * (n - count_set_bit)) * (2^b).\n        total_xor_sum += (count_set_bit * (n - count_set_bit)) * (1 << b)\n            \n    return total_xor_sum"}
{"task_id": "Mbpp/639", "solution": "def sample_nam(names: list) -> int:\n    \"\"\"\n    Sums the length of names that do not start with a lowercase letter.\n    Non-string items or empty strings are handled per specified filtering logic.\n    \"\"\"\n    total_length = 0\n    for name in names:\n        # Check if the name should be kept (i.e., does not start with a lowercase letter).\n        # An empty string does not start with a lowercase letter, so it would be 'kept'\n        # and contribute 0 to the sum. The design context's utils.is_lowercase_start\n        # confirms this behavior for empty strings.\n        if not (name and 'a' <= name[0] <= 'z'):\n            total_length += len(name)\n    return total_length"}
{"task_id": "Mbpp/635", "solution": "from typing import List, Sequence\nclass Heap:\n    \"\"\"A max-heap implementation.\"\"\"\n    def __init__(self, data: Sequence[int] | None = None) -> None:\n        self._data: List[int] = list(data) if data is not None else []\n        if self._data:\n            self.heapify()\n\n    def _sift_down(self, idx: int, size: int) -> None:\n        \"\"\"Sifts down an element to maintain the max-heap property.\"\"\"\n        largest = idx\n        left_child = 2 * idx + 1\n        right_child = 2 * idx + 2\n\n        if left_child < size and self._data[left_child] > self._data[largest]:\n            largest = left_child\n        if right_child < size and self._data[right_child] > self._data[largest]:\n            largest = right_child\n\n        if largest != idx:\n            self._data[idx], self._data[largest] = self._data[largest], self._data[idx]\n            self._sift_down(largest, size)\n\n    def _sift_up(self, idx: int) -> None:\n        \"\"\"Sifts up an element to maintain the max-heap property.\"\"\"\n        parent_idx = (idx - 1) // 2\n        while idx > 0 and self._data[parent_idx] < self._data[idx]:\n            self._data[idx], self._data[parent_idx] = self._data[parent_idx], self._data[idx]\n            idx = parent_idx\n            parent_idx = (idx - 1) // 2\n\n    def heapify(self) -> None:\n        \"\"\"Builds a max-heap from the current list.\"\"\"\n        n = len(self._data)\n        for i in range(n // 2 - 1, -1, -1):\n            self._sift_down(i, n)\n\n    def push(self, value: int) -> None:\n        \"\"\"Inserts a value into the heap.\"\"\"\n        self._data.append(value)\n        self._sift_up(len(self._data) - 1)\n\n    def pop(self) -> int:\n        \"\"\"Removes and returns the largest element from the heap.\"\"\"\n        if not self._data:\n            raise IndexError(\"pop from empty heap\")\n\n        self._data[0], self._data[-1] = self._data[-1], self._data[0]\n        val = self._data.pop()\n        if self._data:\n            self._sift_down(0, len(self._data))\n        return val\n\n    def __len__(self) -> int:\n        \"\"\"Returns the number of elements in the heap.\"\"\"\n        return len(self._data)\ndef heap_sort(data: Sequence[int]) -> List[int]:\n    \"\"\"Sorts a sequence of integers using the heap sort algorithm.\"\"\"\n    heap = Heap(data)\n    \n    result: List[int] = []\n    while len(heap) > 0:\n        result.append(heap.pop())\n    \n    result.reverse()\n    return result"}
