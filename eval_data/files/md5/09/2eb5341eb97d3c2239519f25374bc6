{"task_id": "Mbpp/566", "solution": "def sum_digits(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the digits of a non-negative integer.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    total = 0\n    # Handle the case of n=0 explicitly for the loop condition\n    if n == 0:\n        return 0\n    while n > 0:\n        total += n % 10\n        n //= 10\n    return total"}
{"task_id": "Mbpp/563", "solution": "def extract_values(s: str) -> list[str]:\n    \"\"\"Extracts values between quotation marks from a string.\"\"\"\n\n    def _unescape_quoted_string(value: str) -> str:\n        \"\"\"Converts escaped quotes and backslashes within a string.\"\"\"\n        # Replace escaped backslashes first to avoid double-replacing, then escaped quotes.\n        return value.replace(\"\\\\\\\\\", \"\\\\\").replace('\\\\\"', '\"').replace(\"\\\\'\", \"'\")\n\n    values: list[str] = []\n    current_buffer: list[str] = []\n    in_quote: bool = False\n    quote_char: str | None = None\n    # `is_escaped` indicates if the *previous* character was a backslash,\n    # meaning the *current* character might be part of an escape sequence.\n    is_escaped: bool = False\n\n    for char in s:\n        if in_quote:\n            if is_escaped:\n                # The current character is escaped, append it directly to the buffer.\n                current_buffer.append(char)\n                is_escaped = False\n            elif char == '\\\\':\n                # Encountered a backslash, mark the next character as potentially escaped.\n                is_escaped = True\n            elif char == quote_char:\n                # Found the closing quote for the current string.\n                raw_content = \"\".join(current_buffer)\n                values.append(_unescape_quoted_string(raw_content))\n                current_buffer = []\n                in_quote = False\n                quote_char = None\n            else:\n                # Regular character inside quotes, append to buffer.\n                current_buffer.append(char)\n        else:\n            # Not currently in a quote, looking for a starting quote.\n            if char == '\"' or char == \"'\":\n                in_quote = True\n                quote_char = char\n                current_buffer = []  # Reset buffer for the new quoted string.\n            # Otherwise, ignore characters outside of quotes.\n\n    return values"}
{"task_id": "Mbpp/567", "solution": "def issort_list(lst):\n    \"\"\"\n    Checks if a list is sorted in non-decreasing order.\n    An empty or single-element list is considered sorted.\n    \"\"\"\n    if len(lst) < 2:\n        return True\n    for i in range(len(lst) - 1):\n        if not (lst[i] <= lst[i+1]):\n            return False\n    return True"}
