{"task_id": "Mbpp/252", "solution": "import math\ndef convert(value) -> tuple[float, float]:\n    \"\"\"\n    Converts a complex number or numeric value to its polar coordinates (r, theta).\n    The angle theta is normalized to the range (-pi, pi].\n    \"\"\"\n    # Extract real and imaginary parts. This handles int, float, complex,\n    # and objects with .real and .imag attributes without explicit isinstance checks.\n    real_part = float(value.real if hasattr(value, 'real') else value)\n    imag_part = float(value.imag if hasattr(value, 'imag') else 0.0)\n\n    # Compute the magnitude (r) using hypotenuse function for accuracy.\n    r = math.hypot(real_part, imag_part)\n\n    # Compute the angle (theta) in radians using atan2, which handles quadrants correctly.\n    theta = math.atan2(imag_part, real_part)\n\n    # Normalize theta to the range (-pi, pi] using a common method.\n    normalized_theta = math.atan2(math.sin(theta), math.cos(theta))\n\n    return (r, normalized_theta)"}
{"task_id": "Mbpp/255", "solution": "def combinations_colors(items, n):\n    \"\"\"\n    Generates all combinations (with repetition) of the elements of the list and returns a list with a tuple for each combination.\n    \"\"\"\n    from typing import Any, List, Tuple, Optional\n\n    # --- Nested Class Definitions as per \"inline helper\" constraint ---\n\n    class CombinationRequest:\n        def __init__(self, items_param: List[Any], n_param: int) -> None:\n            self.items = items_param\n            self.n = n_param\n\n    class CombinationResult:\n        def __init__(self, results_param: List[Tuple[Any, ...]]) -> None:\n            self.results = results_param\n\n    class ValidationError(Exception):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class CombinationError(Exception):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    # --- Nested Utility Functions ---\n\n    def validate_items(items_param: Any) -> None:\n        if not isinstance(items_param, (list, tuple)):\n            raise ValidationError(\"Items must be a list or tuple.\")\n\n    def validate_n(n_param: Any) -> None:\n        if not isinstance(n_param, int) or n_param < 0:\n            raise ValidationError(\"n must be a non-negative integer.\")\n\n    class CombinationGenerator:\n        def generate(self, items_param: List[Any], n_param: int) -> List[Tuple[Any, ...]]:\n            if n_param == 0:\n                return [()]\n            m = len(items_param)\n            if m == 0:\n                return []\n            \n            indices = [0] * n_param\n            results: List[Tuple[Any, ...]] = []\n            \n            while True:\n                results.append(tuple(items_param[i] for i in indices))\n                \n                # Advance indices from rightmost position\n                for pos in range(n_param - 1, -1, -1):\n                    if indices[pos] < m - 1:\n                        indices[pos] += 1\n                        # Ensure non-decreasing property: set all positions to pos value\n                        for k in range(pos + 1, n_param):\n                            indices[k] = indices[pos]\n                        break\n                else: # No index could be advanced, all combinations generated\n                    break\n            return results\n\n    class InMemoryRepository:\n        def __init__(self) -> None:\n            self._last: Optional[Tuple[CombinationRequest, CombinationResult]] = None\n\n        def save(self, request_param: CombinationRequest, result_param: CombinationResult) -> None:\n            self._last = (request_param, result_param)\n\n        def get_last(self) -> Optional[Tuple[CombinationRequest, CombinationResult]]:\n            return self._last\n\n    class CombinationService:\n        def __init__(self, generator_param: CombinationGenerator, repository_param: Optional[InMemoryRepository] = None) -> None:\n            self.generator = generator_param\n            self.repository = repository_param\n\n        def generate_combinations(self, request_param: CombinationRequest) -> CombinationResult:\n            results_list = self.generator.generate(request_param.items, request_param.n)\n            result_obj = CombinationResult(results_list)\n            if self.repository:\n                self.repository.save(request_param, result_obj)\n            return result_obj\n\n    class CombinationController:\n        def __init__(self, service_param: CombinationService) -> None:\n            self.service = service_param\n\n        def handle(self, request_param: CombinationRequest) -> CombinationResult:\n            validate_items(request_param.items)\n            validate_n(request_param.n)\n            return self.service.generate_combinations(request_param)\n\n    # --- Component Instantiation (as per module-level setup in design context) ---\n    _generator = CombinationGenerator()\n    _repository = InMemoryRepository()\n    _service = CombinationService(_generator, _repository)\n    _controller = CombinationController(_service)\n\n    # --- Main Function Logic ---\n    req = CombinationRequest(items, n)\n    result = _controller.handle(req)\n    return result.results"}
{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"\n    Finds the length of the longest palindromic subsequence in the given string using dynamic programming.\n    \"\"\"\n    n = len(s)\n    if n == 0:\n        return 0\n\n    # dp[i][j] stores the length of the longest palindromic subsequence of s[i...j]\n    # We use two rows (prev and curr) to optimize space to O(n)\n    prev = [0] * n\n    curr = [0] * n\n\n    # Fill the DP table diagonally\n    # i iterates from n-1 down to 0\n    # j iterates from i+1 up to n-1\n    for i in range(n - 1, -1, -1):\n        curr[i] = 1  # Base case: a single character s[i...i] is a palindrome of length 1\n        for j in range(i + 1, n):\n            if s[i] == s[j]:\n                # If characters match, they form part of the LPS. Add 2 to LPS of s[i+1...j-1]\n                # prev[j-1] corresponds to dp[i+1][j-1]\n                curr[j] = 2 + prev[j - 1]\n            else:\n                # If characters don't match, take the max of LPS without s[i] or without s[j]\n                # prev[j] corresponds to dp[i+1][j]\n                # curr[j-1] corresponds to dp[i][j-1]\n                curr[j] = max(prev[j], curr[j - 1])\n        \n        # After processing row 'i', curr becomes prev for the next iteration (i-1)\n        prev = list(curr) # Deep copy curr to prev\n        # No need to re-initialize curr = [0]*n here if curr is fully overwritten in next iteration,\n        # but in the provided design snippet it's reset. For simplicity and correctness with list assignment,\n        # copying ensures prev holds the correct previous row state.\n        # Alternatively, if we swap references `prev, curr = curr, prev` and then clear `curr` or re-init it,\n        # but `list(curr)` is safer when the next `curr` calculation starts from scratch (which it does via `curr[i]=1`).\n        # To strictly match the design excerpt:\n        # prev, curr = curr, [0] * n\n\n    # The final result is in prev[n-1], which corresponds to dp[0][n-1]\n    return prev[n - 1]"}
{"task_id": "Mbpp/256", "solution": "def count_Primes_nums(n: int) -> int:\n    \"\"\"\n    Counts the number of prime numbers less than a given non-negative integer n\n    using the Sieve of Eratosthenes algorithm.\n    \"\"\"\n    if n <= 2:\n        return 0\n\n    # Initialize a boolean array 'sieve', where sieve[i] is True if i is potentially prime.\n    # We use a bytearray for memory efficiency and direct sum calculation.\n    sieve = bytearray(b'\\x01') * n\n    sieve[0:2] = b'\\x00\\x00'  # 0 and 1 are not prime\n\n    import math\n    # Iterate from 2 up to the square root of n-1.\n    # Any composite number n has a prime factor less than or equal to sqrt(n).\n    for p in range(2, int(math.isqrt(n - 1)) + 1):\n        # If sieve[p] is True, then p is a prime number.\n        if sieve[p]:\n            # Mark all multiples of p as not prime.\n            # Start marking from p*p, as smaller multiples would have been marked by smaller primes.\n            # The slice assignment efficiently sets elements to 0.\n            start_multiple = p * p\n            step = p\n            # Calculate the number of elements to mark in the slice.\n            # This is equivalent to `len(range(start_multiple, n, step))`\n            num_multiples = (n - 1 - start_multiple) // step + 1\n            if num_multiples > 0:\n                sieve[start_multiple:n:step] = b'\\x00' * num_multiples\n\n    # The sum of the sieve array gives the count of prime numbers.\n    # (since 1 represents prime and 0 represents not prime)\n    return sum(sieve)"}
