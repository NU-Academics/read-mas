{"task_id": "Mbpp/129", "solution": "from typing import List, Tuple, Any, Optional\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid matrix input.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass MagicSquareError(Exception):\n    \"\"\"Exception raised for errors during magic square computation.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass Matrix:\n    \"\"\"Represents a square integer matrix and provides accessors.\"\"\"\n    def __init__(self, rows: List[List[Any]]) -> None:\n        if not rows:\n            raise ValidationError(\"Matrix cannot be empty.\")\n        n = len(rows)\n        if not all(len(r) == n for r in rows):\n            raise ValidationError(\"Matrix must be non-empty and square (n x n).\")\n        try:\n            self._rows: List[List[int]] = [list(map(int, r)) for r in rows]\n        except (ValueError, TypeError) as e:\n            raise ValidationError(f\"Matrix contains non-integer elements: {e}\") from e\n\n    def size(self) -> int:\n        \"\"\"Returns the size N of the N x N matrix.\"\"\"\n        return len(self._rows)\n\n    def get_row(self, i: int) -> List[int]:\n        \"\"\"Returns a copy of the specified row.\"\"\"\n        return self._rows[i].copy()\n\n    def get_col(self, j: int) -> List[int]:\n        \"\"\"Returns a list of elements in the specified column.\"\"\"\n        return [row[j] for row in self._rows]\n\n    def main_diagonal(self) -> List[int]:\n        \"\"\"Returns the elements of the main diagonal.\"\"\"\n        n = self.size()\n        return [self._rows[i][i] for i in range(n)]\n\n    def anti_diagonal(self) -> List[int]:\n        \"\"\"Returns the elements of the anti-diagonal.\"\"\"\n        n = self.size()\n        return [self._rows[i][n-1-i] for i in range(n)]\n\n    def flatten(self) -> List[int]:\n        \"\"\"Returns all elements of the matrix as a flattened list.\"\"\"\n        return [x for row in self._rows for x in row]\n\n    def __hash__(self) -> int:\n        \"\"\"Computes a stable hash for caching purposes.\"\"\"\n        return hash(tuple(tuple(r) for r in self._rows))\n\n    def __eq__(self, other: Any) -> bool:\n        if not isinstance(other, Matrix):\n            return NotImplemented\n        return self._rows == other._rows\nclass Validator:\n    \"\"\"Validates raw input to ensure it forms a well-formed square matrix of integers.\"\"\"\n    def validate_square_matrix(self, matrix_input: Any) -> Matrix:\n        if not isinstance(matrix_input, list):\n            raise ValidationError(\"Input must be a list of lists.\")\n        \n        if not matrix_input:\n            raise ValidationError(\"Matrix cannot be empty.\")\n            \n        n = len(matrix_input)\n        \n        for r_idx, row in enumerate(matrix_input):\n            if not isinstance(row, list):\n                raise ValidationError(f\"Row {r_idx} must be a list.\")\n            if len(row) != n:\n                raise ValidationError(f\"Matrix must be square (n x n). Row {r_idx} has {len(row)} elements, expected {n}.\")\n            \n            for c_idx, item in enumerate(row):\n                if not isinstance(item, (int, float)):\n                    try:\n                        int(item)\n                    except (ValueError, TypeError):\n                        raise ValidationError(f\"Matrix element at [{r_idx}][{c_idx}] '{item}' is not a valid integer.\")\n                elif isinstance(item, float) and item != int(item):\n                    raise ValidationError(f\"Matrix element at [{r_idx}][{c_idx}] '{item}' is not a valid integer (float with decimal part).\")\n        \n        return Matrix(matrix_input)\nclass InMemoryRepository:\n    \"\"\"Simple in-process cache mapping matrix hash to boolean magic square result.\"\"\"\n    def __init__(self) -> None:\n        self._store: dict[int, bool] = {}\n\n    def get(self, matrix_hash: int) -> Optional[bool]:\n        \"\"\"Retrieves a cached result for a given matrix hash.\"\"\"\n        return self._store.get(matrix_hash)\n\n    def set(self, matrix_hash: int, result: bool) -> None:\n        \"\"\"Stores a magic square result for a given matrix hash.\"\"\"\n        self._store[matrix_hash] = result\n\n    def clear(self) -> None:\n        \"\"\"Clears all entries from the cache.\"\"\"\n        self._store.clear()\nclass MagicSquareService:\n    \"\"\"Core logic for determining if a matrix is a magic square.\"\"\"\n    def __init__(self, repo: Optional[InMemoryRepository]=None, validator: Optional[Validator]=None) -> None:\n        self.repo = repo or InMemoryRepository()\n        self.validator = validator or Validator()\n\n    def compute_magic_sum(self, matrix: Matrix) -> int:\n        \"\"\"Calculates the magic sum using the first row.\"\"\"\n        return sum(matrix.get_row(0))\n\n    def is_magic_square(self, matrix_input: List[List[Any]], enforce_distinct: bool=False) -> bool:\n        \"\"\"Checks if the given matrix is a magic square.\"\"\"\n        try:\n            matrix = self.validator.validate_square_matrix(matrix_input)\n        except ValidationError:\n            raise\n        \n        h = hash(matrix)\n        cached = self.repo.get(h)\n        if cached is not None:\n            return cached\n\n        try:\n            n = matrix.size()\n            \n            # An empty matrix is handled by Validator and Matrix.__init__.\n            # If a 0x0 matrix were somehow constructed, it wouldn't be a magic square.\n            if n == 0:\n                self.repo.set(h, False)\n                return False\n\n            target_sum = self.compute_magic_sum(matrix)\n\n            for i in range(n):\n                if sum(matrix.get_row(i)) != target_sum:\n                    self.repo.set(h, False)\n                    return False\n                if sum(matrix.get_col(i)) != target_sum:\n                    self.repo.set(h, False)\n                    return False\n\n            if sum(matrix.main_diagonal()) != target_sum:\n                self.repo.set(h, False)\n                return False\n            if sum(matrix.anti_diagonal()) != target_sum:\n                self.repo.set(h, False)\n                return False\n\n            if enforce_distinct:\n                flattened = matrix.flatten()\n                expected_set = set(range(1, n * n + 1))\n                if set(flattened) != expected_set:\n                    self.repo.set(h, False)\n                    return False\n            \n            self.repo.set(h, True)\n            return True\n        except ValidationError:\n            raise\n        except Exception as ex:\n            raise MagicSquareError(str(ex)) from ex\ndef magic_square_test(matrix: List[List[int]], enforce_distinct: bool=False) -> bool:\n    \"\"\"Calculates whether the given matrix is a magic square.\"\"\"\n    service = MagicSquareService()\n    return service.is_magic_square(matrix, enforce_distinct=enforce_distinct)"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(items, tie_breaker=\"smallest\"):\n    \"\"\"\n    Finds the item with maximum frequency in a given list,\n    applying a tie-breaking rule if multiple items have the same maximum frequency.\n    \"\"\"\n    from typing import Any, Dict, List, Sequence, Tuple\n\n    # --- Config constants (from src/maxfreq/config.py) ---\n    ALLOWED_TIE_BREAKERS: Tuple[str, ...] = (\"smallest\", \"first\")\n\n    # --- Exception Class (from src/maxfreq/exceptions.py) ---\n    class InvalidInputError(Exception):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    # --- Utility functions (replacing methods in src/maxfreq/utils.py) ---\n\n    def _validate_items(items_seq: Sequence[Any]) -> None:\n        \"\"\"Ensures items is a non-empty sequence of hashable values.\"\"\"\n        if not hasattr(items_seq, \"__iter__\") or isinstance(items_seq, (str, bytes)):\n            raise InvalidInputError(\"Items must be a sequence (list/tuple) of hashable values.\")\n        if len(items_seq) == 0:\n            raise InvalidInputError(\"Empty sequence provided.\")\n\n    def _count_items_manual(items_seq: Sequence[Any]) -> Dict[Any, int]:\n        \"\"\"Counts occurrences of each item using a dictionary.\"\"\"\n        counts: Dict[Any, int] = {}\n        for item in items_seq:\n            counts[item] = counts.get(item, 0) + 1\n        return counts\n\n    def _find_max_items(count_map: Dict[Any, int]) -> List[Any]:\n        \"\"\"Returns a list of items with the maximum frequency.\"\"\"\n        if not count_map:\n            return []\n        max_count = 0\n        for count in count_map.values():\n            if count > max_count:\n                max_count = count\n        return [item for item, cnt in count_map.items() if cnt == max_count]\n\n    def _tie_breaker_smallest(items_with_max_count: List[Any]) -> Any:\n        \"\"\"Returns the smallest item from a list of comparable items.\"\"\"\n        return min(items_with_max_count)\n\n    def _tie_breaker_first(items_with_max_count: List[Any], original_items: Sequence[Any]) -> Any:\n        \"\"\"Returns the first encountered item from original_items that is also in items_with_max_count.\"\"\"\n        item_set = set(items_with_max_count)\n        for val in original_items:\n            if val in item_set:\n                return val\n        return items_with_max_count[0] # Fallback, should not be reached under normal conditions\n\n    # --- Main logic (emulating FrequencyController and FrequencyService.max_occurrence) ---\n\n    # Validate the tie_breaker parameter.\n    if tie_breaker not in ALLOWED_TIE_BREAKERS:\n        raise InvalidInputError(f\"Invalid tie_breaker: {tie_breaker}\")\n\n    # Validate the input items sequence.\n    _validate_items(items)\n\n    # Count the occurrences of each item.\n    counts = _count_items_manual(items)\n\n    # Find all items that have the maximum frequency.\n    max_items = _find_max_items(counts)\n\n    chosen_item: Any\n    if len(max_items) == 1:\n        chosen_item = max_items[0] # If only one item has max frequency, choose it directly.\n    else:\n        # Apply the tie-breaking rule if multiple items share the maximum frequency.\n        try:\n            if tie_breaker == \"smallest\":\n                chosen_item = _tie_breaker_smallest(max_items)\n            else: # tie_breaker == \"first\"\n                chosen_item = _tie_breaker_first(max_items, items)\n        except TypeError:\n            # If \"smallest\" tie-breaker fails due to non-comparable types, fall back to \"first\".\n            chosen_item = _tie_breaker_first(max_items, items)\n    \n    # Return the chosen item as per the problem's assertion format.\n    return chosen_item"}
