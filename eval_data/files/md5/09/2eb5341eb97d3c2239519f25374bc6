{"task_id": "Mbpp/133", "solution": "from typing import Sequence, Iterable, Iterator\nimport math\nclass NegativeSumError(Exception):\n    \"\"\"Base exception for the negative sum module.\"\"\"\n    pass\nclass InvalidInputError(NegativeSumError):\n    \"\"\"Raised when the input is not valid.\"\"\"\n    pass\nclass ValidationUtils:\n    \"\"\"Utility class for input validation and parsing.\"\"\"\n    @staticmethod\n    def assert_iterable(numbers: Sequence[float | int]) -> None:\n        \"\"\"Asserts that the input is an iterable and not None.\"\"\"\n        if numbers is None:\n            raise InvalidInputError(\"Input is None\")\n        try:\n            iter(numbers)\n        except TypeError:\n            raise InvalidInputError(\"Input is not iterable\")\n\n    @staticmethod\n    def to_number(value: Any) -> float:\n        \"\"\"Converts a value to a float, raising an error if conversion fails.\"\"\"\n        try:\n            return float(value)\n        except (TypeError, ValueError):\n            raise InvalidInputError(f\"Value {value!r} is not numeric\")\n\n    @staticmethod\n    def parse_sequence(numbers: Sequence[Any]) -> list[float]:\n        \"\"\"Parses a sequence of values into a list of floats.\"\"\"\n        ValidationUtils.assert_iterable(numbers)\n        return [ValidationUtils.to_number(x) for x in numbers]\nclass NegativeSumService:\n    \"\"\"Core business logic for summing negative numbers.\"\"\"\n    def __init__(self, repository=None):\n        self._repository = repository\n\n    def sum_negatives(self, numbers: Iterable[float | int]) -> float:\n        \"\"\"Calculates the sum of negative numbers in the given iterable.\"\"\"\n        try:\n            negatives = (float(x) for x in numbers if float(x) < 0)\n        except (TypeError, ValueError) as e:\n            raise InvalidInputError(str(e))\n        total = math.fsum(negatives)\n        # The repository logic is omitted as per instructions to not call helpers not defined inline,\n        # and it's optional for the core function logic itself.\n        return total\ndef sum_negativenum(numbers: Sequence[float | int]) -> float:\n    \"\"\"\n    Calculates the sum of the negative numbers of a given list of numbers.\n    Returns 0.0 if no negative numbers are present.\n    \"\"\"\n    ValidationUtils.assert_iterable(numbers)\n    parsed = ValidationUtils.parse_sequence(numbers)\n    service = NegativeSumService()\n    result = service.sum_negatives(parsed)\n    return result"}
{"task_id": "Mbpp/137", "solution": "def zero_count(arr: list[int]) -> float:\n    \"\"\"Calculates the ratio of zeroes to non-zeroes in an array of integers.\n    Returns float('inf') if there are no non-zero elements.\n    \"\"\"\n    num_zeros = 0\n    num_non_zeros = 0\n\n    for x in arr:\n        if x == 0:\n            num_zeros += 1\n        else:\n            num_non_zeros += 1\n\n    if num_non_zeros == 0:\n        return float('inf')\n    else:\n        return num_zeros / num_non_zeros"}
{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(n: int) -> bool:\n    \"\"\"\n    Checks if a given number can be represented as a sum of distinct non-zero powers of 2.\n    Non-zero powers of 2 mean exponents must be 1 or greater, thus excluding 2^0 (1).\n    \"\"\"\n    if n <= 0:\n        return False\n    # If 2^0 (1) is excluded, all available powers of two (2, 4, 8, ...) are even.\n    # A sum of even numbers must itself be an even number.\n    return n % 2 == 0"}
{"task_id": "Mbpp/139", "solution": "import math\nimport json\nfrom pathlib import Path\nfrom typing import Optional, Dict\nclass Constants:\n    \"\"\"Provides mathematical and configuration constants for calculations.\"\"\"\n    PI: float = math.pi\n    DEFAULT_PRECISION: int = 6\nclass Circle:\n    \"\"\"Represents a circle, handling radius validation and normalization.\"\"\"\n    def __init__(self, radius: float) -> None:\n        if not isinstance(radius, (int, float)):\n            raise TypeError(\"radius must be numeric\")\n        self.radius: float = float(radius)\n        self.validate()\n\n    def validate(self) -> None:\n        \"\"\"Ensures the radius is a non-negative value.\"\"\"\n        if self.radius < 0:\n            raise ValueError(\"radius must be non-negative\")\n\n    def normalized_radius(self) -> float:\n        \"\"\"Returns a rounded radius value suitable for use as a cache key.\"\"\"\n        return round(self.radius, 12)\nclass CacheRepository:\n    \"\"\"Manages an in-memory cache for circumferences, with optional JSON persistence.\"\"\"\n    def __init__(self, persist_file: Optional[str] = None) -> None:\n        self._cache: Dict[float, float] = {}\n        self.persist_file = persist_file\n        if persist_file:\n            self._load()\n\n    def get(self, radius_key: float) -> Optional[float]:\n        \"\"\"Retrieves a cached circumference value if available.\"\"\"\n        return self._cache.get(radius_key)\n\n    def set(self, radius_key: float, circumference: float) -> None:\n        \"\"\"Stores a circumference value in the cache and optionally saves it to disk.\"\"\"\n        self._cache[radius_key] = circumference\n        if self.persist_file:\n            try:\n                self._save()\n            except Exception:\n                # In a real application, this would log the error.\n                pass\n\n    def _load(self) -> None:\n        \"\"\"Loads cached data from the persistence file into memory.\"\"\"\n        if self.persist_file and Path(self.persist_file).exists():\n            try:\n                with open(self.persist_file, 'r') as f:\n                    loaded_data = json.load(f)\n                    self._cache = {float(k): v for k, v in loaded_data.items()}\n            except (json.JSONDecodeError, IOError):\n                # In a real application, this would log the error.\n                pass\n\n    def _save(self) -> None:\n        \"\"\"Saves the current in-memory cache to the persistence file.\"\"\"\n        if self.persist_file:\n            try:\n                Path(self.persist_file).parent.mkdir(parents=True, exist_ok=True)\n                with open(self.persist_file, 'w') as f:\n                    json.dump({str(k): v for k, v in self._cache.items()}, f)\n            except IOError:\n                # In a real application, this would log the error.\n                pass\nclass CircumferenceService:\n    \"\"\"Provides the core logic for calculating a circle's circumference.\"\"\"\n    def __init__(self, pi_provider: Optional[Constants] = None) -> None:\n        self.pi_provider = pi_provider or Constants()\n\n    def calculate(self, circle: Circle) -> float:\n        \"\"\"Computes the circumference using the circle's radius and PI.\"\"\"\n        return 2.0 * self.pi_provider.PI * circle.radius\n\n    def format_value(self, value: float, precision: Optional[int] = None) -> float:\n        \"\"\"Formats or rounds a float value to a specified precision.\"\"\"\n        if precision is None:\n            precision = self.pi_provider.DEFAULT_PRECISION\n        return round(value, precision)\nclass CircleController:\n    \"\"\"Orchestrates circle operations, including validation, caching, and calculation.\"\"\"\n    def __init__(self, service: CircumferenceService, cache: CacheRepository) -> None:\n        self.service = service\n        self.cache = cache\n\n    def circle_circumference(self, radius: float) -> float:\n        \"\"\"Calculates the circumference, leveraging caching for efficiency.\"\"\"\n        circle = Circle(radius)\n        key = circle.normalized_radius()\n\n        cached = self.cache.get(key)\n        if cached is not None:\n            return cached\n\n        value = self.service.calculate(circle)\n        self.cache.set(key, value)\n        return value\n_default_controller = CircleController(\n    service=CircumferenceService(),\n    cache=CacheRepository(persist_file=None)\n)\ndef circle_circumference(radius: float) -> float:\n    \"\"\"\n    Calculates the circumference of a circle given its radius.\n    It performs input validation and utilizes an internal caching mechanism.\n    \"\"\"\n    return _default_controller.circle_circumference(radius)"}
{"task_id": "Mbpp/140", "solution": "from typing import Iterable, Any, Iterator, Set\ndef extract_singly(items: Iterable[Any]) -> Set[int]:\n    \"\"\"\n    Flattens a list of lists into a single set of numbers,\n    coercing numeric-like values to integers and deduplicating them.\n    \"\"\"\n\n    class InvalidInputError(Exception):\n        \"\"\"Exception raised for invalid input types or values.\"\"\"\n        def __init__(self, message: str):\n            super().__init__(message)\n            self.message = message\n\n    class FlattenError(Exception):\n        \"\"\"Exception raised for general flattening failures, wrapping a cause.\"\"\"\n        def __init__(self, message: str, cause: Exception | None = None):\n            super().__init__(message)\n            self.message = message\n            self.cause = cause\n\n    def _is_iterable_helper(obj: Any) -> bool:\n        \"\"\"Helper to check if an object is iterable but not a string or bytes.\"\"\"\n        try:\n            if isinstance(obj, (str, bytes)):\n                return False\n            iter(obj)\n            return True\n        except TypeError:\n            return False\n\n    def _flatten_recursive_helper(item: Any) -> Iterator[Any]:\n        \"\"\"Helper to recursively yield atomic elements from nested iterables.\"\"\"\n        if _is_iterable_helper(item):\n            for sub in item:\n                yield from _flatten_recursive_helper(sub)\n        else:\n            yield item\n\n    def _coerce_atomic_helper(value: Any, allow_float_to_int: bool) -> int:\n        \"\"\"Helper to coerce a leaf value to an integer, handling floats and numeric strings.\"\"\"\n        if isinstance(value, int):\n            return value\n        if isinstance(value, float) and allow_float_to_int:\n            if value.is_integer():\n                return int(value)\n            raise InvalidInputError(f\"Non-integral float: {value}\")\n        if isinstance(value, str):\n            try:\n                return int(value)\n            except ValueError:\n                raise InvalidInputError(f\"Cannot coerce string to int: {value}\")\n        raise InvalidInputError(f\"Unsupported value type: {type(value).__name__}\")\n\n    if not _is_iterable_helper(items):\n        raise InvalidInputError(\"Top-level input must be iterable.\")\n\n    result: Set[int] = set()\n    try:\n        for leaf in _flatten_recursive_helper(items):\n            # As per design, allow_float_to_int is True by default for FlattenService\n            value = _coerce_atomic_helper(leaf, allow_float_to_int=True)\n            result.add(value)\n        return result\n    except InvalidInputError as e:\n        # Re-raise specific input errors directly\n        raise e\n    except Exception as e:\n        # Wrap other unexpected errors in FlattenError\n        raise FlattenError(\"Failed to flatten input\", cause=e)"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(arr):\n    \"\"\"\n    Finds the maximum difference between any two elements in the given array.\n    Assumes the input array contains at least two numeric elements.\n    \"\"\"\n    if not arr:  # This check is technically an edge case, but good practice if not explicitly forbidden.\n        # However, the prompt says \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n        # and \"assumes array has at least two numeric elements.\"\n        # So, I'll remove this check to strictly follow the prompt.\n        pass\n\n    current_min = arr[0]\n    current_max = arr[0]\n\n    for x in arr[1:]:\n        if x < current_min:\n            current_min = x\n        elif x > current_max:\n            current_max = x\n\n    return current_max - current_min"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1, list2, list3):\n    \"\"\"\n    Counts number of items identical in the same position of three given lists.\n    Compares elements up to the minimum length of the three lists.\n    \"\"\"\n    count = 0\n    min_length = min(len(list1), len(list2), len(list3))\n    for i in range(min_length):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/141", "solution": "from typing import Sequence, List, TypeVar\nT = TypeVar(\"T\")\ndef pancake_sort(data: Sequence[T]) -> List[T]:\n    \"\"\"Sorts a list of elements in ascending order using the pancake sort algorithm.\"\"\"\n    arr = list(data)  # Create a mutable copy of the input sequence\n    n = len(arr)\n\n    def _max_index(current_arr: List[T], k_size: int) -> int:\n        \"\"\"Finds the index of the maximum element in current_arr[0...k_size-1].\"\"\"\n        max_i = 0\n        for i in range(1, k_size):\n            if current_arr[i] > current_arr[max_i]:\n                max_i = i\n        return max_i\n\n    def _flip(current_arr: List[T], k: int) -> None:\n        \"\"\"Reverses the order of the first k elements in current_arr (in-place).\"\"\"\n        current_arr[:k] = reversed(current_arr[:k])\n\n    for current_unsorted_size in range(n, 1, -1):\n        # Find index of the maximum element in the unsorted part\n        max_idx = _max_index(arr, current_unsorted_size)\n\n        # If the maximum element is not already at its correct final position\n        if max_idx != current_unsorted_size - 1:\n            # Move the maximum element to the beginning of the list\n            _flip(arr, max_idx + 1)\n            # Move the maximum element from the beginning to its correct final position\n            _flip(arr, current_unsorted_size)\n            \n    return arr"}
{"task_id": "Mbpp/160", "solution": "from typing import Optional, Tuple\ndef _extended_gcd(a: int, b: int) -> Tuple[int, int, int]:\n    \"\"\"\n    Computes (g, x, y) such that g = gcd(a, b) and a*x + b*y = g.\n    g is always non-negative.\n    \"\"\"\n    if b == 0:\n        return (abs(a), 1 if a >= 0 else -1, 0)\n\n    old_r, r = a, b\n    old_s, s = 1, 0\n    old_t, t = 0, 1\n\n    while r != 0:\n        q = old_r // r\n        old_r, r = r, old_r - q * r\n        old_s, s = s, old_s - q * s\n        old_t, t = t, old_t - q * t\n\n    g = abs(old_r)\n    if old_r < 0:\n        return (g, -old_s, -old_t)\n    return (g, old_s, old_t)\ndef find_solution(a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n    \"\"\"\n    Finds integers x and y that satisfy ax + by = n as a tuple,\n    or returns None if no solution exists.\n    \"\"\"\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    g, x0, y0 = _extended_gcd(a, b)\n\n    if n % g != 0:\n        return None\n\n    k = n // g\n    x = x0 * k\n    y = y0 * k\n\n    return (x, y)"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(source, to_remove):\n    \"\"\"\n    Removes all elements from the source list that are present in the to_remove list.\n    Preserves order and handles unhashable items efficiently.\n    \"\"\"\n    hashable_items_to_remove = set()\n    unhashable_items_to_remove = []\n\n    for item in to_remove:\n        try:\n            hashable_items_to_remove.add(item)\n        except TypeError:\n            unhashable_items_to_remove.append(item)\n\n    result = []\n    for item in source:\n        # Check against hashable items first for average O(1) lookup\n        if item in hashable_items_to_remove:\n            continue\n        \n        # Fallback to O(N) list scan for unhashable items\n        if any(item == x for x in unhashable_items_to_remove):\n            continue\n            \n        result.append(item)\n            \n    return result"}
{"task_id": "Mbpp/165", "solution": "ALPHABET = tuple(chr(ord(\"a\") + i) for i in range(26))\ndef count_char_position(s: str) -> int:\n    \"\"\"Counts characters in a string that match their English alphabet position (case-insensitive).\"\"\"\n    s_norm = s.lower()\n    count = 0\n    limit = min(len(s_norm), len(ALPHABET))\n\n    for i in range(limit):\n        ch = s_norm[i]\n        if ch.isalpha() and ch == ALPHABET[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series n + (n-2) + (n-4) + ... until terms are less than or equal to 0.\n    Uses a closed-form formula for O(1) computation.\n    \"\"\"\n    if n < 0:\n        return 0 # As per the series definition, no terms would be positive, or it would be an invalid input caught by a higher layer.\n    \n    # Calculate k, the number of terms in the series (including 0 if n is even).\n    # The terms are n, n-2, n-4, ..., 0 or 1.\n    # The number of positive terms is ceil(n/2)\n    # If n=0, k=0\n    # If n=1, k=1 (term: 1)\n    # If n=2, k=2 (terms: 2, 0)\n    # If n=3, k=2 (terms: 3, 1)\n    # If n=4, k=3 (terms: 4, 2, 0)\n    # This can be calculated as (n + 2) // 2 for n >= 0, or (n + 1) // 2 if 0 term is also considered based on formula in design\n    # The design context specified formula is k = (n + 1) // 2\n    k = (n + 1) // 2\n    \n    # Apply the arithmetic series sum formula: k * (first_term + last_term) / 2.\n    # Here, first_term is n, and the last term is n - 2*(k-1).\n    # Sum = k * (n - (k - 1)) as derived in design context.\n    total_sum = k * (n - (k - 1))\n    \n    return total_sum"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(nums: list[int]) -> int:\n    \"\"\"Counts pairs of integers in a list that XOR to an even number.\n    This is based on the property that XOR of two numbers is even if both have the same parity.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n    for v in nums:\n        if v & 1:  # Check if the least significant bit is 1 (odd)\n            odd_count += 1\n        else:      # Least significant bit is 0 (even)\n            even_count += 1\n\n    def _choose2(n: int) -> int:\n        \"\"\"Calculates n choose 2, representing the number of unique pairs from n items.\"\"\"\n        if n < 2:\n            return 0\n        return n * (n - 1) // 2\n\n    # A pair (a, b) XORs to an even number if a and b are both even, or both odd.\n    # Count pairs of evens + Count pairs of odds.\n    return _choose2(even_count) + _choose2(odd_count)"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    For n=0, it returns 1.\n    \"\"\"\n    def is_power_of_two(num: int) -> bool:\n        \"\"\"Checks if a number is a power of two.\"\"\"\n        return num > 0 and (num & (num - 1)) == 0\n\n    if n <= 1:\n        return 1\n    if is_power_of_two(n):\n        return n\n    return 1 << (n - 1).bit_length()"}
{"task_id": "Mbpp/170", "solution": "from dataclasses import dataclass\nfrom typing import List\nclass AppError(Exception):\n    \"\"\"Base exception for application-specific errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass ValidationError(AppError):\n    \"\"\"Raised when input types or values are invalid.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass RangeError(AppError):\n    \"\"\"Raised when indices are invalid and clamping is not applied.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass Settings:\n    \"\"\"Runtime configuration values.\"\"\"\n    CLAMP_INDICES: bool = True\n    LOG_LEVEL: str = \"INFO\"\n\n    def __init__(self, CLAMP_INDICES: bool = True, LOG_LEVEL: str = \"INFO\") -> None:\n        self.CLAMP_INDICES = CLAMP_INDICES\n        self.LOG_LEVEL = LOG_LEVEL\n\n    @staticmethod\n    def from_env() -> 'Settings':\n        \"\"\"Creates Settings by reading environment variables (not implemented here).\"\"\"\n        return Settings()\nclass Validator:\n    \"\"\"Utility class for validating lists and indices.\"\"\"\n    @staticmethod\n    def is_numeric(value: object) -> bool:\n        \"\"\"Checks if a value is an int or float (excluding bool).\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n    def validate_list(self, lst: object) -> list[float]:\n        \"\"\"Ensures the input is a list of numeric values.\"\"\"\n        if not isinstance(lst, list):\n            raise ValidationError(\"lst must be a list\")\n        validated = []\n        for i, v in enumerate(lst):\n            if not self.is_numeric(v):\n                raise ValidationError(f\"Non-numeric element at index {i}: {v!r}\")\n            validated.append(float(v))\n        return validated\n\n    def validate_indices(self, start: int, end: int, length: int, clamp: bool) -> tuple[int,int]:\n        \"\"\"Validates and normalizes start/end indices relative to list length.\"\"\"\n        if not isinstance(start, int) or not isinstance(end, int):\n            raise ValidationError(\"start and end must be integers\")\n        \n        # Handle empty list gracefully for indices.\n        if length == 0:\n            if start != 0 or end != -1: # or any other empty range indicator\n                # If clamping, it would result in an empty valid range, e.g., (0,-1)\n                # But for a non-empty list this check is for start_norm > end_norm\n                pass\n        \n        if clamp:\n            start_norm = max(0, min(length - 1, start)) if length > 0 else 0\n            end_norm = max(0, min(length - 1, end)) if length > 0 else -1 # If length is 0, ensures an empty slice\n        else:\n            if length == 0 and (start != 0 or end != -1): # Specific check for non-empty indices on empty list\n                raise RangeError(\"Indices out of bounds for an empty list\")\n            if length > 0 and (start < 0 or end < 0 or start >= length or end >= length):\n                raise RangeError(\"Indices out of bounds\")\n            start_norm, end_norm = start, end\n\n        if start_norm > end_norm and length > 0: # Only raise if list is not empty\n            raise RangeError(\"start index greater than end index after normalization\")\n        \n        # Special case: if list is empty, start_norm=0, end_norm=-1 is acceptable for an empty slice.\n        # If length is 0 and start=0, end=0 (meaning original range was [0,0]), clamped results in (0,-1)\n        # The sum of an empty slice will be 0.\n        return start_norm, end_norm\nclass ListRepository:\n    \"\"\"Abstracts retrieval of a slice from a list.\"\"\"\n    def get_slice(self, lst: list[float], start: int, end: int) -> list[float]:\n        \"\"\"Returns an inclusive slice of the list.\"\"\"\n        if start > end: # For cases where normalized indices result in an empty range like (0,-1)\n            return []\n        return lst[start:end + 1]\nclass SumService:\n    \"\"\"Core business logic for summing a range in a list.\"\"\"\n    def __init__(self, repo: ListRepository, validator: Validator, settings: Settings) -> None:\n        self.repo = repo\n        self.validator = validator\n        self.settings = settings\n\n    def sum_range(self, lst: list[float], start: int, end: int) -> float:\n        \"\"\"Computes the sum of a list's elements within a specified inclusive range.\"\"\"\n        validated = self.validator.validate_list(lst)\n        s, e = self.validator.validate_indices(start, end, len(validated), self.settings.CLAMP_INDICES)\n        sub = self.repo.get_slice(validated, s, e)\n        return float(sum(sub))\nclass SumController:\n    \"\"\"Orchestrates interaction between models and the sum service.\"\"\"\n    def __init__(self, service: SumService) -> None:\n        self._service = service\n\n    def handle(self, request: RangeRequest) -> SumResult:\n        \"\"\"Handles a range sum request and returns the result.\"\"\"\n        total = self._service.sum_range(request.lst, request.start, request.end)\n        return SumResult(total=total)\ndef sum_range_list(lst: list[float], start: int, end: int) -> float:\n    \"\"\"\n    Calculates the sum of numbers in a list within a range specified by two inclusive indices.\n    \"\"\"\n    settings = Settings()\n    repo = ListRepository()\n    validator = Validator()\n    service = SumService(repo, validator, settings)\n    controller = SumController(service)\n\n    req = RangeRequest(lst=lst, start=start, end=end)\n    res = controller.handle(req)\n    return res.total"}
