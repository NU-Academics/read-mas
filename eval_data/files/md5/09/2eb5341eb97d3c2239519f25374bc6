{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome of a specified integer, returned as an integer.\n    \"\"\"\n    # Handle negative and zero inputs as per design assumptions.\n    if n < 0:\n        return 0\n    if n == 0:\n        return 1\n\n    # Start by considering the number just after n, as we need a palindrome strictly greater than n.\n    current_num_str = str(n + 1)\n    length = len(current_num_str)\n    s_list = list(current_num_str)\n    mid = length // 2\n\n    # Step 1: Create a candidate palindrome by mirroring the left half to the right half.\n    # This produces the smallest palindrome >= current_num_str with the current length.\n    for i in range(mid):\n        s_list[length - 1 - i] = s_list[i]\n    pal_str_candidate = \"\".join(s_list)\n\n    # Step 2: If the created palindrome is already greater than or equal to current_num_str,\n    # it is the next smallest palindrome.\n    if int(pal_str_candidate) >= int(current_num_str):\n        return int(pal_str_candidate)\n    else:\n        # Step 3: If mirroring left half resulted in a palindrome smaller than current_num_str,\n        # we need to increment the middle part of current_num_str and then re-mirror.\n        # Re-initialize s_list to ensure we work on the original digits of (n+1) for incrementing.\n        s_list = list(current_num_str)\n        \n        # Determine the starting index for incrementing (middle digit for odd length, \n        # leftmost of the two middle digits for even length).\n        left_start_index = mid - 1 if length % 2 == 0 else mid\n        carry = 1\n\n        # Propagate carry from the middle towards the left.\n        for i in range(left_start_index, -1, -1):\n            digit = int(s_list[i]) + carry\n            s_list[i] = str(digit % 10)\n            carry = digit // 10\n            if carry == 0:\n                break  # No more carry to propagate\n\n        # If carry is still 1 after the loop, it means the number of digits increased\n        # (e.g., 9 -> 10, 99 -> 100). The palindrome will be '1' followed by \n        # (length-1) zeros, then '1'.\n        if carry == 1:\n            return int(\"1\" + \"0\" * (length - 1) + \"1\")\n        else:\n            # Otherwise, re-mirror the updated left half to the right half.\n            for i in range(mid):\n                s_list[length - 1 - i] = s_list[i]\n            return int(\"\".join(s_list))"}
{"task_id": "Mbpp/108", "solution": "import heapq\nfrom abc import ABC, abstractmethod\nfrom typing import Any, Iterable, List, Optional, Iterator\nclass MergeError(Exception):\n    \"\"\"Base exception for merge operations.\"\"\"\n    pass\nclass ValidationError(MergeError):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    pass\nclass MergeRequest:\n    \"\"\"Holds the validated lists for a merge operation.\"\"\"\n    def __init__(self, lists: List[List[Any]]) -> None:\n        self._lists = lists\n\n    @property\n    def lists(self) -> List[List[Any]]:\n        return self._lists\nclass MergeResult:\n    \"\"\"Holds the result of a merge operation.\"\"\"\n    def __init__(self, result: List[Any]) -> None:\n        self._result = result\n\n    def to_list(self) -> List[Any]:\n        return list(self._result)\nclass ListValidator:\n    \"\"\"Provides static methods to validate and normalize input lists.\"\"\"\n    @staticmethod\n    def validate_lists(lists_of_iterables: Iterable[Iterable[Any]]) -> List[List[Any]]:\n        validated: List[List[Any]] = []\n        for idx, it in enumerate(lists_of_iterables):\n            if it is None:\n                raise ValidationError(f\"List at index {idx} is None.\")\n            try:\n                lst = list(it)\n            except TypeError:\n                raise ValidationError(f\"List at index {idx} is not iterable.\")\n            validated.append(lst)\n\n        # Check for comparability by attempting to sort a small sample.\n        # This relies on the controller providing exactly three iterables.\n        try:\n            _ = sorted(validated[0][:1] + validated[1][:1] + validated[2][:1])\n        except TypeError as e:\n            raise ValidationError(\"Elements are not mutually comparable.\") from e\n\n        return validated\nclass SortStrategy(ABC):\n    \"\"\"Abstract base class for sorting/merging strategies.\"\"\"\n    @abstractmethod\n    def sort(self, lists: List[List[Any]]) -> List[Any]:\n        pass\nclass TimSortStrategy(SortStrategy):\n    \"\"\"Implements merge by concatenating all lists and using Python's built-in sorted().\"\"\"\n    def sort(self, lists: List[List[Any]]) -> List[Any]:\n        combined = []\n        for lst in lists:\n            combined.extend(lst)\n        return sorted(combined)\nclass MergeService:\n    \"\"\"Orchestrates the merge operation using a chosen sorting strategy.\"\"\"\n    def __init__(self, strategy: Optional[SortStrategy] = None) -> None:\n        self.strategy = strategy if strategy is not None else TimSortStrategy()\n\n    def merge(self, request: MergeRequest) -> MergeResult:\n        \"\"\"Executes the merge operation using the configured strategy.\"\"\"\n        try:\n            result_list = self.strategy.sort(request.lists)\n            return MergeResult(result_list)\n        except Exception as e:\n            raise MergeError(f\"Merge operation failed: {e}\") from e\ndef merge_sorted_list(a: Iterable[Any], b: Iterable[Any], c: Iterable[Any], strategy: Optional[SortStrategy]=None) -> List[Any]:\n    \"\"\"\n    Merges three input lists into a single sorted list.\n    A custom strategy can be provided; otherwise, it defaults to TimSortStrategy.\n    \"\"\"\n    input_iterables = [a, b, c]\n    validated_lists = ListValidator.validate_lists(input_iterables)\n    merge_request = MergeRequest(validated_lists)\n    svc = MergeService(strategy or TimSortStrategy())\n    merge_result = svc.merge(merge_request)\n    return merge_result.to_list()"}
{"task_id": "Mbpp/111", "solution": "import json\nfrom typing import Iterable, List, Any, Optional, Tuple, Dict, Set\ndef common_in_nested_lists(lists: Iterable[Iterable[Any]]) -> List[Any]:\n    \"\"\"\n    Finds common elements in given nested lists.\n    Returns a list of unique elements present in all input iterables.\n    \"\"\"\n\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception for invalid input.\"\"\"\n        def __init__(self, message: str):\n            self.message = message\n            super().__init__(self.message)\n\n    def is_hashable(obj: Any) -> bool:\n        \"\"\"Checks if an object is hashable.\"\"\"\n        try:\n            hash(obj)\n            return True\n        except TypeError:\n            return False\n\n    def make_hashable(obj: Any) -> Any:\n        \"\"\"Converts unhashable objects into a hashable representation recursively.\"\"\"\n        if is_hashable(obj):\n            return obj\n        if isinstance(obj, (list, tuple)):\n            return tuple(make_hashable(item) for item in obj)\n        if isinstance(obj, dict):\n            return tuple(sorted((make_hashable(k), make_hashable(v)) for k, v in obj.items()))\n        return repr(obj)\n\n    class InMemoryCacheRepository:\n        \"\"\"In-memory cache for computation results.\"\"\"\n        def __init__(self):\n            self._store: Dict[str, List[Any]] = {}\n\n        def get(self, key: str) -> Optional[List[Any]]:\n            return self._store.get(key)\n\n        def set(self, key: str, value: List[Any]) -> None:\n            self._store[key] = value\n\n    class InputValidator:\n        \"\"\"Validates and normalizes input to a list of lists.\"\"\"\n        MAX_LISTS = 10000\n        MAX_ELEMENTS_PER_LIST = 100000\n\n        def validate(self, lists_input: Any) -> List[List[Any]]:\n            if lists_input is None:\n                raise InvalidInputError(\"Input is None; expected iterable of iterables.\")\n            try:\n                outer = list(self._ensure_iterable(lists_input))\n            except TypeError:\n                raise InvalidInputError(\"Top-level input must be an iterable of iterables.\")\n            if len(outer) > self.MAX_LISTS:\n                raise InvalidInputError(f\"Too many lists: {len(outer)} exceeds maximum of {self.MAX_LISTS}.\")\n            \n            result_lists = []\n            for i, sub in enumerate(outer):\n                try:\n                    lst = list(self._ensure_iterable(sub))\n                except TypeError:\n                    raise InvalidInputError(f\"Element at index {i} is not iterable or is a string/bytes type.\")\n                if len(lst) > self.MAX_ELEMENTS_PER_LIST:\n                    raise InvalidInputError(f\"Too many elements in list at index {i}: {len(lst)} exceeds maximum of {self.MAX_ELEMENTS_PER_LIST}.\")\n                result_lists.append(lst)\n            \n            return result_lists\n\n        def _ensure_iterable(self, obj: Any) -> Iterable[Any]:\n            if isinstance(obj, (str, bytes)):\n                raise TypeError(\"Strings/bytes are not accepted as inner iterables directly.\")\n            if not isinstance(obj, Iterable):\n                raise TypeError(f\"Object {obj!r} is not iterable.\")\n            return obj\n\n    def _hash_based_intersection(lists_of_items: List[List[Any]]) -> List[Any]:\n        \"\"\"Computes intersection using hashable sets.\"\"\"\n        if not lists_of_items:\n            return []\n        if len(lists_of_items) == 1:\n            return list(set(lists_of_items[0]))\n\n        common_elements_set = set(lists_of_items[0])\n        for i in range(1, len(lists_of_items)):\n            common_elements_set.intersection_update(set(lists_of_items[i]))\n            if not common_elements_set:\n                return []\n        return list(common_elements_set)\n\n    def _fallback_intersection(lists_of_items: List[List[Any]]) -> List[Any]:\n        \"\"\"Computes intersection for unhashable items with equality checks.\"\"\"\n        if not lists_of_items:\n            return []\n        if len(lists_of_items) == 1:\n            unique_elements = []\n            for item in lists_of_items[0]:\n                if not any(item == existing_item for existing_item in unique_elements):\n                    unique_elements.append(item)\n            return unique_elements\n\n        first_list = lists_of_items[0]\n        other_lists = lists_of_items[1:]\n        \n        common_result: List[Any] = []\n        seen_first_list_elements: Set[Any] = set()\n\n        for item_from_first in first_list:\n            hashable_item_key = make_hashable(item_from_first)\n            if hashable_item_key in seen_first_list_elements:\n                continue\n            seen_first_list_elements.add(hashable_item_key)\n\n            is_common_to_all = True\n            for other_list in other_lists:\n                found_in_current_other_list = False\n                for item_in_other in other_list:\n                    if item_from_first == item_in_other:\n                        found_in_current_other_list = True\n                        break\n                if not found_in_current_other_list:\n                    is_common_to_all = False\n                    break\n            \n            if is_common_to_all:\n                common_result.append(item_from_first)\n\n        return common_result\n\n    # --- Main Logic ---\n    validator_instance = InputValidator()\n    cache_repo_instance = InMemoryCacheRepository()\n\n    normalized_lists = validator_instance.validate(lists)\n\n    if not normalized_lists:\n        return []\n\n    cache_key = None\n    try:\n        cache_key = json.dumps(make_hashable(normalized_lists), sort_keys=True)\n        cached_result = cache_repo_instance.get(cache_key)\n        if cached_result is not None:\n            return list(cached_result)\n    except TypeError:\n        cache_key = None # Disable caching if key generation fails\n\n    all_elements_are_hashable = True\n    for sublist in normalized_lists:\n        for item in sublist:\n            if not is_hashable(item):\n                all_elements_are_hashable = False\n                break\n        if not all_elements_are_hashable:\n            break\n\n    result: List[Any]\n    if all_elements_are_hashable:\n        result = _hash_based_intersection(normalized_lists)\n    else:\n        result = _fallback_intersection(normalized_lists)\n\n    if cache_key and cache_repo_instance is not None:\n        cache_repo_instance.set(cache_key, list(result))\n\n    return result"}
{"task_id": "Mbpp/113", "solution": "def check_integer(s: str) -> bool:\n    \"\"\"Checks if a string represents a base-10 integer.\n\n    Handles optional leading signs and leading/trailing whitespace, rejecting non-digit characters.\n    \"\"\"\n    s = s.strip()\n\n    if not s:\n        return False\n\n    # Handle optional leading sign\n    if s[0] == '+' or s[0] == '-':\n        s = s[1:]\n\n    # If only a sign was present (e.g., \"+\", \"-\") or string was only whitespace, it's not an integer\n    if not s:\n        return False\n\n    # Check if all remaining characters are ASCII digits\n    for char in s:\n        if not ('0' <= char <= '9'):\n            return False\n\n    return True"}
{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary: str, rotations: int) -> int:\n    \"\"\"\n    Counts the number of rotated versions of a binary string that represent an odd integer.\n    \"\"\"\n    # Helper to check if a binary string represents an odd number.\n    def is_odd_local(b_str: str) -> bool:\n        return b_str[-1] == '1'\n\n    # Helper to perform a right rotation on a binary string.\n    def rotate_right_local(s: str, k: int) -> str:\n        n = len(s)\n        k_mod = k % n\n        if k_mod == 0:\n            return s\n        return s[-k_mod:] + s[:-k_mod]\n\n    # Helper to normalize rotations into full cycles and a remainder.\n    def normalize_rotations_local(total_rotations: int, n: int) -> tuple[int, int]:\n        full = total_rotations // n\n        rem = total_rotations % n\n        return (full, rem)\n\n    n = len(binary) # Guaranteed to be >= 1 by preconditions.\n\n    # Determine full cycles and remaining rotations to optimize calculations.\n    full_cycles, rem = normalize_rotations_local(rotations, n)\n\n    # Calculate the number of odd-valued rotations within a single full cycle (0 to n-1).\n    count_per_cycle = 0\n    for k_cycle in range(n):\n        rotated_str = rotate_right_local(binary, k_cycle)\n        if is_odd_local(rotated_str):\n            count_per_cycle += 1\n\n    # Calculate the number of odd-valued rotations for the remaining rotations (0 to rem-1).\n    remainder_count = 0\n    for k_rem in range(rem):\n        rotated_str = rotate_right_local(binary, k_rem)\n        if is_odd_local(rotated_str):\n            remainder_count += 1\n\n    # The total count is the sum of odd counts from full cycles and the remainder.\n    total_odd_count = full_cycles * count_per_cycle + remainder_count\n    return total_odd_count"}
{"task_id": "Mbpp/118", "solution": "import re\nfrom typing import List\ndef string_to_list(s: str, collapse_whitespace: bool = False) -> List[str]:\n    \"\"\"\n    Converts a string to a list of strings split on the space character.\n    Optionally collapses consecutive spaces before splitting.\n    \"\"\"\n    if collapse_whitespace:\n        # Normalize by replacing any sequence of one or more spaces with a single space.\n        processed_s = re.sub(r' +', ' ', s)\n        # Split the processed string on the single space character.\n        tokens = processed_s.split(' ')\n    else:\n        # Split on the exact space character, preserving empty tokens from adjacent spaces.\n        tokens = s.split(' ')\n    return tokens"}
{"task_id": "Mbpp/116", "solution": "import math\ndef tuple_to_int(t: tuple[int, ...]) -> int:\n    \"\"\"Converts a tuple of positive integers into a single integer by concatenating their decimal representations.\"\"\"\n    result = 0\n    for num in t:\n        # Calculate the number of digits in the current positive integer.\n        num_digits = int(math.log10(num)) + 1\n        result = result * (10 ** num_digits) + num\n    return result"}
{"task_id": "Mbpp/119", "solution": "def search(arr: list[int]) -> int:\n    \"\"\"Finds the single element that appears only once in a sorted array.\"\"\"\n    low, high = 0, len(arr) - 1\n    while low < high:\n        mid = (low + high) // 2\n        # Ensure mid is at an even index to represent the start of a pair\n        if mid % 2 == 1:\n            mid -= 1\n        \n        # If elements at mid and mid+1 are the same, the unique element is to the right\n        if arr[mid] == arr[mid + 1]:\n            low = mid + 2\n        # Otherwise, the unique element is at or to the left of mid\n        else:\n            high = mid\n            \n    return arr[low]"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(pairs: list[tuple[int | float, int | float]]) -> float:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    \"\"\"\n    from dataclasses import dataclass\n    from typing import Any, List, Optional, Tuple, Union\n\n    class InvalidInputError(ValueError):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n\n    def is_number(value: Any) -> bool:\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n    def ensure_is_pair(value: Any) -> bool:\n        return isinstance(value, (list, tuple)) and len(value) == 2\n\n    def to_float(value: Any) -> float:\n        if not is_number(value):\n            raise InvalidInputError(f\"Non-numeric value encountered: {value!r}\")\n        return float(value)\n\n    @dataclass(frozen=True)\n    class TuplePair:\n        a: float\n        b: float\n\n        def product(self) -> float:\n            return self.a * self.b\n\n        def abs_product(self) -> float:\n            return abs(self.product())\n\n    class PairRepository:\n        def __init__(self) -> None:\n            pass\n\n        def parse_raw(self, raw_pairs: list[Tuple[Any, Any]]) -> list[TuplePair]:\n            if not raw_pairs:\n                raise InvalidInputError(\"Input list is empty\")\n            result = []\n            for p_raw in raw_pairs:\n                if not ensure_is_pair(p_raw):\n                    raise InvalidInputError(f\"Item is not a pair (length 2 iterable): {p_raw!r}\")\n                a, b = p_raw\n                result.append(TuplePair(to_float(a), to_float(b)))\n            return result\n\n    class MaxProductService:\n        def __init__(self) -> None:\n            pass\n\n        def compute_max_product(self, pairs_domain: list[TuplePair]) -> float:\n            if not pairs_domain:\n                raise InvalidInputError(\"No valid pairs to compute product from.\")\n            max_val: Optional[float] = None\n            for tp in pairs_domain:\n                current_abs_product = tp.abs_product()\n                if max_val is None or current_abs_product > max_val:\n                    max_val = current_abs_product\n            return max_val\n\n    class MaxProductController:\n        def __init__(self, repository: Optional[PairRepository] = None, service: Optional[MaxProductService] = None) -> None:\n            self.repository = repository if repository is not None else PairRepository()\n            self.service = service if service is not None else MaxProductService()\n\n        def compute(self, raw_pairs_input: list[Tuple[Any, Any]]) -> float:\n            parsed_pairs = self.repository.parse_raw(raw_pairs_input)\n            result = self.service.compute_max_product(parsed_pairs)\n            return result\n\n    controller = MaxProductController()\n    return controller.compute(pairs)"}
{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(limit: int) -> int:\n    # Precompute sums of proper divisors for all numbers up to the limit\n    # sums[i] will store the sum of proper divisors for the number i.\n    sums = [0] * (limit + 1)\n    for i in range(1, limit // 2 + 1):\n        for j in range(2 * i, limit + 1, i):\n            sums[j] += i\n\n    amicable_numbers = set()\n    # Iterate from 2 to limit to find amicable pairs.\n    # Amicable numbers are typically defined for numbers greater than 1.\n    for a in range(2, limit + 1):\n        b = sums[a]\n        # Check if a and b form an amicable pair: they are distinct,\n        # b is within the limit, and the sum of divisors of b is a.\n        if b != a and 1 < b <= limit and sums[b] == a:\n            amicable_numbers.add(a)\n            amicable_numbers.add(b)\n\n    return sum(amicable_numbers)"}
{"task_id": "Mbpp/124", "solution": "import math\ndef angle_complex(real_part: float, imaginary_value: complex) -> float:\n    \"\"\"\n    Calculates the principal angle (argument) of a complex number.\n    The angle is returned in radians in the range (-pi, pi].\n    \"\"\"\n    return math.atan2(imaginary_value.imag, real_part)"}
{"task_id": "Mbpp/125", "solution": "def find_length(s: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the count of 0s and 1s in any substring\n    of the given binary string using Kadane's algorithm.\n    \"\"\"\n    # Transform the binary string into a numeric array: '0' becomes 1, '1' becomes -1.\n    # This transforms the problem into finding the maximum subarray sum.\n    arr = [1 if char == '0' else -1 for char in s]\n\n    # Kadane's algorithm to find the maximum subarray sum\n    # (max_sum, start_index, end_index are typically tracked, but we only need max_sum here)\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, len(arr)):\n        # If adding the current element makes the current sum smaller than the current element itself,\n        # it means starting a new subarray from the current element is better.\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
