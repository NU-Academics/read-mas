{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    # dp_prev[v] stores the number of valid sequences of the current length ending with v.\n    dp_prev = [0] * (m + 1)\n\n    # Base case: For length 1, any integer from 1 to m is a valid sequence.\n    for v in range(1, m + 1):\n        dp_prev[v] = 1\n\n    # Iterate for sequence lengths from 2 up to n.\n    for length in range(2, n + 1):\n        # Calculate prefix sums for dp_prev to efficiently query sums of previous elements.\n        prefix = [0] * (m + 1)\n        current_sum = 0\n        for i in range(1, m + 1):\n            current_sum += dp_prev[i]\n            prefix[i] = current_sum\n\n        # dp_curr will store the counts for the sequences of the current length.\n        dp_curr = [0] * (m + 1)\n        for u in range(1, m + 1):\n            # A sequence ending in 'u' must have a previous element 'v' such that u >= 2 * v.\n            # This implies v <= u // 2. We sum counts for all valid 'v' using prefix sums.\n            max_prev_val = u // 2\n            if max_prev_val >= 1:\n                dp_curr[u] = prefix[max_prev_val]\n            else:\n                dp_curr[u] = 0\n        \n        # Update dp_prev for the next iteration of length.\n        dp_prev = dp_curr\n    \n    # The total number of sequences of length n is the sum of all elements in dp_prev (from index 1 to m).\n    return sum(dp_prev[1:])"}
{"task_id": "Mbpp/244", "solution": "import math\ndef next_Perfect_Square(n):\n    \"\"\"\n    Finds the next perfect square strictly greater than the given number n.\n    \"\"\"\n    # Calculate the integer square root (floor(sqrt(n))).\n    k = math.isqrt(n)\n    # The next perfect square strictly greater than n will be the square of (k + 1).\n    return (k + 1) ** 2"}
{"task_id": "Mbpp/250", "solution": "def count_X(t: tuple, x: object) -> int:\n    \"\"\"\n    Counts the occurrences of an element in a tuple, validating inputs.\n    \"\"\"\n\n    class InvalidInputError(ValueError):\n        \"\"\"Custom exception for invalid input types.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class TupleValidator:\n        \"\"\"Validates that the input 't' is a tuple.\"\"\"\n        def validate(self, t_input: object, x_input: object) -> None:\n            if not isinstance(t_input, tuple):\n                raise InvalidInputError(\"Input t must be a tuple\")\n\n    class TupleRepository:\n        \"\"\"Provides an abstraction for accessing tuple elements.\"\"\"\n        def get_items(self, t_data: tuple) -> tuple:\n            return t_data\n\n    class TupleCounterService:\n        \"\"\"Contains the core business logic for counting occurrences.\"\"\"\n        def __init__(self, repository: \"TupleRepository\") -> None:\n            self._repository = repository\n\n        def count_occurrences(self, t_data: tuple, x_element: object) -> int:\n            count = 0\n            for item in self._repository.get_items(t_data):\n                if item == x_element:\n                    count += 1\n            return count\n\n    class CountController:\n        \"\"\"Orchestrates validation and counting services.\"\"\"\n        def __init__(self, service: \"TupleCounterService\", validator: \"TupleValidator\") -> None:\n            self._service = service\n            self._validator = validator\n\n        def count(self, t_input: tuple, x_element: object) -> int:\n            self._validator.validate(t_input, x_element)\n            return self._service.count_occurrences(t_input, x_element)\n\n    # Instantiate the components as per the API layer design\n    repository = TupleRepository()\n    service = TupleCounterService(repository)\n    validator = TupleValidator()\n    controller = CountController(service, validator)\n\n    return controller.count(t, x)"}
{"task_id": "Mbpp/245", "solution": "def max_sum(arr: list) -> int:\n    \"\"\"\n    Calculates the maximum sum of a bitonic subsequence for the given array.\n    A sequence is bitonic if it is first increasing and then decreasing.\n    \"\"\"\n    n = len(arr)\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return arr[0]\n\n    # msis[i] stores the maximum sum of an increasing subsequence ending at arr[i]\n    msis = [0] * n\n    for i in range(n):\n        msis[i] = arr[i]\n        for j in range(i):\n            if arr[i] > arr[j]:\n                msis[i] = max(msis[i], msis[j] + arr[i])\n\n    # msds[i] stores the maximum sum of a decreasing subsequence starting at arr[i]\n    msds = [0] * n\n    for i in range(n - 1, -1, -1):\n        msds[i] = arr[i]\n        for j in range(n - 1, i, -1):\n            if arr[i] > arr[j]:\n                msds[i] = max(msds[i], msds[j] + arr[i])\n\n    # The maximum sum bitonic subsequence will have a peak element arr[i].\n    # Its sum is msis[i] + msds[i] - arr[i] (arr[i] is counted twice).\n    max_bitonic_sum = 0\n    for i in range(n):\n        max_bitonic_sum = max(max_bitonic_sum, msis[i] + msds[i] - arr[i])\n\n    return max_bitonic_sum"}
