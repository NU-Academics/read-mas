{"task_id": "Mbpp/296", "solution": "from typing import List, Tuple\ndef get_Inv_Count(arr: List[int]) -> int:\n    \"\"\"\n    Counts inversions in an array using a merge-sort based algorithm.\n    An inversion is a pair (i, j) such that i < j and arr[i] > arr[j].\n    \"\"\"\n\n    def _merge_and_count(left_arr: List[int], right_arr: List[int]) -> Tuple[List[int], int]:\n        \"\"\"\n        Merges two sorted arrays and counts inversions between them.\n        \"\"\"\n        merged = []\n        inversions = 0\n        i, j = 0, 0\n        n_left, n_right = len(left_arr), len(right_arr)\n\n        while i < n_left and j < n_right:\n            if left_arr[i] <= right_arr[j]:\n                merged.append(left_arr[i])\n                i += 1\n            else:\n                # If left_arr[i] > right_arr[j], then an inversion exists.\n                # Since left_arr is sorted, all remaining elements in left_arr\n                # from index i onwards are also greater than right_arr[j].\n                merged.append(right_arr[j])\n                inversions += (n_left - i)\n                j += 1\n        \n        # Append any remaining elements\n        merged.extend(left_arr[i:])\n        merged.extend(right_arr[j:])\n        \n        return merged, inversions\n\n    def _merge_sort_and_count(sub_arr: List[int]) -> Tuple[List[int], int]:\n        \"\"\"\n        Recursively sorts a subarray and counts inversions within it.\n        \"\"\"\n        n = len(sub_arr)\n        if n <= 1:\n            return sub_arr.copy(), 0 # Base case: 0 inversions for 0 or 1 element\n\n        mid = n // 2\n        left_half = sub_arr[:mid]\n        right_half = sub_arr[mid:]\n\n        # Recursively count inversions in left and right halves\n        sorted_left, left_inversions = _merge_sort_and_count(left_half)\n        sorted_right, right_inversions = _merge_sort_and_count(right_half)\n\n        # Merge the sorted halves and count cross inversions\n        merged_array, cross_inversions = _merge_and_count(sorted_left, sorted_right)\n\n        total_inversions = left_inversions + right_inversions + cross_inversions\n        return merged_array, total_inversions\n\n    _, total_inversions = _merge_sort_and_count(arr)\n    return total_inversions"}
