{"task_id": "Mbpp/84", "solution": "class SequenceCache:\n    \"\"\"Manages an in-memory dictionary cache for sequence values, with a basic eviction policy.\"\"\"\n    def __init__(self, max_size: int = 10000) -> None:\n        self._store: dict[int, int] = {}\n        self._max_size = max_size\n\n    def get(self, n: int) -> int | None:\n        return self._store.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        # Remove the oldest item if the cache reaches its maximum size.\n        if len(self._store) >= self._max_size:\n            if self._store:\n                self._store.popitem(last=False)\n        self._store[n] = value\n\n    def clear(self) -> None:\n        self._store.clear()\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters to sequence functions.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n    def __str__(self) -> str:\n        return self.message\nclass SequenceService:\n    \"\"\"Computes Newman-Conway sequence numbers using dynamic programming and an in-memory cache.\"\"\"\n    def __init__(self, cache: SequenceCache | None = None) -> None:\n        self.cache = cache or SequenceCache()\n        # Seed the base cases a(1)=1 and a(2)=1 as per sequence definition.\n        if self.cache.get(1) is None:\n            self.cache.set(1, 1)\n        if self.cache.get(2) is None:\n            self.cache.set(2, 1)\n\n    def sequence(self, n: int) -> int:\n        if not isinstance(n, int) or n < 1:\n            raise InvalidInputError(\"n must be integer >= 1\")\n\n        cached = self.cache.get(n)\n        if cached is not None:\n            return cached\n        \n        self._compute_up_to(n)\n        # The value must now be in cache after computation.\n        return self.cache.get(n)\n\n    def _compute_up_to(self, n: int) -> None:\n        # Determine the maximum index currently present in the cache.\n        # The cache will always have at least a(1) and a(2) after service initialization.\n        current_max = max(self.cache._store.keys())\n\n        # Begin computing from the next uncomputed number, ensuring at least from index 3.\n        start_index = max(3, current_max + 1)\n\n        for k in range(start_index, n + 1):\n            # The Newman-Conway recurrence relation is a(k) = a(a(k-1)) + a(k - a(k-1)).\n            a_k_minus_1 = self.cache.get(k - 1)\n            if a_k_minus_1 is None:\n                # If a(k-1) is unexpectedly missing, recursively compute it.\n                self._compute_up_to(k - 1)\n                a_k_minus_1 = self.cache.get(k - 1)\n            \n            # The indices for lookup are guaranteed to be less than k and at least 1,\n            # ensuring they are already present in the cache.\n            idx1 = a_k_minus_1\n            idx2 = k - a_k_minus_1\n\n            val = self.cache.get(idx1) + self.cache.get(idx2)\n            self.cache.set(k, val)\nclass SequenceController:\n    \"\"\"A facade class providing an interface to compute Newman-Conway sequence numbers.\"\"\"\n    def __init__(self, service: SequenceService | None = None) -> None:\n        self.service = service or SequenceService()\n\n    def get(self, n: int) -> int:\n        if not isinstance(n, int):\n            raise InvalidInputError(\"n must be integer\")\n        # Delegates to the service for actual computation and further validation.\n        return self.service.sequence(n)\n_default_controller = SequenceController(SequenceService(SequenceCache()))\ndef sequence(n):\n    \"\"\"\n    Finds the nth number in the Newman-Conway sequence.\n    Example: sequence(10) == 6\n    \"\"\"\n    return _default_controller.get(n)"}
{"task_id": "Mbpp/85", "solution": "import math\nfrom typing import Any, Dict, Optional\nclass ValidationError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nPI: float = math.pi\ndef validate_radius(radius: Any) -> float:\n    \"\"\"Validates and converts the input radius to a non-negative float.\"\"\"\n    try:\n        r = float(radius)\n    except (TypeError, ValueError):\n        raise ValidationError(\"radius must be numeric\")\n    if math.isnan(r) or math.isinf(r):\n        raise ValidationError(\"radius must be finite\")\n    if r < 0:\n        raise ValidationError(\"radius must be >= 0\")\n    return r\nclass Sphere:\n    def __init__(self, radius: float) -> None:\n        self.radius: float = radius\n        self.area: Optional[float] = None\n\n    def validate(self) -> None:\n        \"\"\"Ensures the sphere's radius is valid before computation.\"\"\"\n        if not isinstance(self.radius, (int, float)):\n            raise ValidationError(\"radius must be numeric\")\n        if self.radius < 0:\n            raise ValidationError(\"radius must be >= 0\")\n\n    def set_area(self, area: float) -> None:\n        self.area = area\n\n    def as_dict(self) -> dict:\n        return {\"radius\": float(self.radius), \"area\": float(self.area) if self.area is not None else None}\nclass SurfaceAreaCalculator:\n    def calculate(self, radius: float) -> float:\n        \"\"\"Calculates the surface area of a sphere using the formula 4 * PI * r^2.\"\"\"\n        return 4.0 * PI * (radius * radius)\nclass GeometryService:\n    def __init__(self, calculator: SurfaceAreaCalculator) -> None:\n        self._calculator = calculator\n\n    def compute_surface_area(self, radius: Any) -> float:\n        \"\"\"Validates radius, creates a Sphere, and computes its surface area.\"\"\"\n        r = validate_radius(radius)\n        sphere = Sphere(r)\n        return self.compute_surface_area_for_sphere(sphere)\n\n    def compute_surface_area_for_sphere(self, sphere: Sphere) -> float:\n        \"\"\"Computes the surface area for a given Sphere object.\"\"\"\n        sphere.validate()\n        area = self._calculator.calculate(sphere.radius)\n        sphere.set_area(area)\n        return area\nclass GeometryController:\n    def __init__(self, service: GeometryService) -> None:\n        self._service = service\n\n    def compute_area(self, radius: Any) -> Dict[str, Any]:\n        \"\"\"Orchestrates surface area computation and returns results in a dictionary.\"\"\"\n        area = self._service.compute_surface_area(radius)\n        return {\"radius\": float(radius), \"area\": float(area)}\n_calculator = SurfaceAreaCalculator()\n_service = GeometryService(_calculator)\n_controller = GeometryController(_service)\ndef surfacearea_sphere(radius: float) -> float:\n    \"\"\"Calculates the surface area of a sphere given its radius.\"\"\"\n    return _controller.compute_area(radius)[\"area\"]"}
