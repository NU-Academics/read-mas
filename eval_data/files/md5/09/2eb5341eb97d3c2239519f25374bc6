{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers):\n    \"\"\"\n    Finds the difference of the first even and first odd number in a list.\n    Assumes that at least one even and one odd number exist in the list.\n    \"\"\"\n    first_odd = None\n    first_even = None\n\n    for num in numbers:\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_odd is not None and first_even is not None:\n            break\n\n    return first_even - first_odd"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(n: int) -> bool:\n    \"\"\"\n    Checks if a given number is an Armstrong number.\n    An Armstrong number is a number that is the sum of its own digits each raised to the power of the number of digits.\n    \"\"\"\n    if n < 0:\n        return False\n\n    def _compute_digits(num: int) -> list[int]:\n        \"\"\"Extracts the decimal digits of a non-negative integer.\"\"\"\n        if num == 0:\n            return [0]\n        digits = []\n        temp_num = num\n        while temp_num > 0:\n            digits.append(temp_num % 10)\n            temp_num //= 10\n        return digits[::-1]\n\n    def _power_sum(digits_list: list[int], power: int) -> int:\n        \"\"\"Calculates the sum of each digit raised to the specified power.\"\"\"\n        return sum(d ** power for d in digits_list)\n\n    digits = _compute_digits(n)\n    num_digits = len(digits)\n    sum_of_powers = _power_sum(digits, num_digits)\n\n    return sum_of_powers == n"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n):\n    \"\"\"\n    Calculates the sum and average of the first n natural numbers using arithmetic formulas.\n    Assumes n is a positive integer.\n    \"\"\"\n    s = n * (n + 1) // 2\n    a = s / n\n    return s, a"}
{"task_id": "Mbpp/602", "solution": "from typing import Optional\ndef first_repeated_char(s: str) -> Optional[str]:\n    \"\"\"\n    Finds the first repeated character in a string.\n    Returns the character if found, otherwise returns None.\n    \"\"\"\n    seen_chars: dict[str, int] = {}\n    for char in s:\n        if char in seen_chars:\n            return char\n        seen_chars[char] = 1\n    return None"}
{"task_id": "Mbpp/597", "solution": "def find_kth(a: list, b: list, k: int) -> int:\n    \"\"\"\n    Finds the k-th smallest element from two sorted arrays.\n    The arrays a and b are assumed to be sorted in ascending order and k is 1-indexed.\n    \"\"\"\n    m, n = len(a), len(b)\n\n    # Ensure 'a' is the smaller array for binary search efficiency.\n    # This optimization helps keep the binary search range smaller.\n    if m > n:\n        a, b = b, a\n        m, n = n, m\n\n    # 'left' is the minimum possible count of elements taken from 'a'.\n    # 'right' is the maximum possible count of elements taken from 'a'.\n    # These bounds ensure we always take 'k' elements in total (i from a, j from b).\n    left, right = max(0, k - n), min(k, m)\n\n    while left <= right:\n        i = (left + right) // 2  # Number of elements taken from 'a' (partition point).\n        j = k - i                # Number of elements taken from 'b'.\n\n        # Define elements at the partition boundaries.\n        # Use float('-inf') and float('inf') as sentinels for virtual elements\n        # when a partition extends beyond an array's bounds.\n        Aleft = a[i - 1] if i > 0 else float(\"-inf\")\n        Aright = a[i] if i < m else float(\"inf\")\n        Bleft = b[j - 1] if j > 0 else float(\"-inf\")\n        Bright = b[j] if j < n else float(\"inf\")\n\n        # Check if the partitions are correctly formed such that Aleft <= Bright and Bleft <= Aright.\n        # This condition means that all elements in the left partitions are less than or equal to\n        # all elements in the right partitions, satisfying the sorted merge property.\n        if Aleft <= Bright and Bleft <= Aright:\n            # If partitions are valid, the k-th element is the maximum of the\n            # largest elements in the left partitions of both arrays.\n            return int(max(Aleft, Bleft))\n        elif Aleft > Bright:\n            # If the largest element in the left partition of 'a' is too big,\n            # it means we took too many elements from 'a'. Adjust 'right' to reduce 'i'.\n            right = i - 1\n        else: # Bleft > Aright\n            # If the largest element in the left partition of 'b' is too big,\n            # it means we took too few elements from 'a'. Adjust 'left' to increase 'i'.\n            left = i + 1\n\n    # This line should ideally not be reached under the assumption that k is valid (1 to m+n).\n    # For robust production code, an exception might be raised, but per instructions, we return -1.\n    return -1"}
