{"task_id": "Mbpp/569", "solution": "from typing import List\ndef sort_sublists(list_of_lists: List[List[str]], in_place: bool = False) -> List[List[str]]:\n    \"\"\"Sorts each sublist of strings in a given list of lists.\n    Returns a new list by default, or modifies the input list if `in_place` is True.\n    \"\"\"\n\n    def _deep_copy_list(input_list: List[List[str]]) -> List[List[str]]:\n        return [list(inner) for inner in input_list]\n\n    working_list = list_of_lists if in_place else _deep_copy_list(list_of_lists)\n\n    for idx, sublist in enumerate(working_list):\n        working_list[idx] = sorted(sublist)\n\n    return working_list"}
{"task_id": "Mbpp/572", "solution": "def two_unique_nums(*lists):\n    \"\"\"\n    Removes duplicate numbers from a given number of lists, returning numbers that appear exactly once.\n    The order of the returned numbers is based on their first appearance across all input lists.\n    \"\"\"\n    counts = {}\n    order = []\n\n    for inner_list in lists:\n        for num in inner_list:\n            if num not in counts:\n                counts[num] = 0\n                order.append(num)\n            counts[num] += 1\n\n    return [num for num in order if counts[num] == 1]"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(list1, list2):\n    \"\"\"\n    Checks if list2 is a contiguous sublist of list1 using a sliding window approach.\n    Returns True if list2 is found within list1, False otherwise.\n    \"\"\"\n    n = len(list1)\n    m = len(list2)\n\n    if m == 0:\n        return True  # An empty list is always considered a sublist\n    if m > n:\n        return False # The sublist cannot be longer than the main list\n\n    for i in range(n - m + 1):\n        if list1[i : i + m] == list2:\n            return True\n    return False"}
{"task_id": "Mbpp/577", "solution": "from typing import Optional, Any\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass FactorialRequest:\n    \"\"\"DTO for carrying the input integer n.\"\"\"\n    def __init__(self, n: int) -> None:\n        self.n = n\n    def to_dict(self) -> dict:\n        return {\"n\": self.n}\nclass FactorialResult:\n    \"\"\"DTO for carrying the computation result (n and last_digit).\"\"\"\n    def __init__(self, n: int, last_digit: int) -> None:\n        self.n = n\n        self.last_digit = last_digit\n    def to_dict(self) -> dict:\n        return {\"n\": self.n, \"last_digit\": self.last_digit}\nclass InputValidator:\n    \"\"\"Validates and normalizes input to a non-negative integer.\"\"\"\n    def validate(self, value: Any) -> int:\n        if not isinstance(value, int) or isinstance(value, bool):\n            raise InvalidInputError(\"Input must be an integer.\")\n        if value < 0:\n            raise InvalidInputError(\"Input must be a non-negative integer.\")\n        return value\nclass CacheRepository:\n    \"\"\"In-memory caching adapter for storing and retrieving results.\"\"\"\n    DEFAULT_CACHE_MAX_ITEMS: int = 1000\n\n    def __init__(self) -> None:\n        self._cache: dict[int, int] = {}\n\n    def get(self, n: int) -> Optional[int]:\n        return self._cache.get(n)\n\n    def set(self, n: int, last_digit: int) -> None:\n        self._cache[n] = last_digit\n\n    def clear(self) -> None:\n        self._cache.clear()\nclass FactorialService:\n    \"\"\"Core business logic for computing the last digit of a factorial.\"\"\"\n    THRESHOLD_ZERO = 5\n\n    def __init__(self, cache_repo: CacheRepository, validator: InputValidator) -> None:\n        self.cache_repo = cache_repo\n        self.validator = validator\n\n    def compute_last_digit(self, n: int) -> int:\n        n = self.validator.validate(n)\n        cached = self.cache_repo.get(n)\n        if cached is not None:\n            return cached\n        last = self._compute_direct(n)\n        try:\n            self.cache_repo.set(n, last)\n        except Exception:\n            pass # Swallow cache errors; service still returns correct result.\n        return last\n\n    def _compute_direct(self, n: int) -> int:\n        # Rules for the last digit of n!\n        if n == 0 or n == 1:\n            return 1\n        if n == 2:\n            return 2\n        if n == 3:\n            return 6\n        if n == 4:\n            return 4\n        if n >= self.THRESHOLD_ZERO:\n            return 0\n        return 0 # Fallback for completeness, though all valid cases covered.\nclass FactorialController:\n    \"\"\"Adapter between DTOs and the FactorialService.\"\"\"\n    def __init__(self, service: FactorialService) -> None:\n        self.service = service\n\n    def get_last_digit(self, request: FactorialRequest) -> FactorialResult:\n        last_digit = self.service.compute_last_digit(request.n)\n        return FactorialResult(n=request.n, last_digit=last_digit)\ndef create_default_controller() -> FactorialController:\n    \"\"\"Creates and wires up the default controller instance with its dependencies.\"\"\"\n    cache = CacheRepository()\n    validator = InputValidator()\n    service = FactorialService(cache_repo=cache, validator=validator)\n    return FactorialController(service=service)\ndef last_Digit_Factorial(n: int) -> int:\n    \"\"\"Finds the last digit in the factorial of a given number.\"\"\"\n    controller = create_default_controller()\n    req = FactorialRequest(n)\n    result = controller.get_last_digit(req)\n    return result.last_digit"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Finds elements present in exactly one of the two input tuples, preserving order.\n    Elements unique to 'a' come first, then elements unique to 'b'.\n    \"\"\"\n\n    # Helper function to check if an object is hashable.\n    def _is_hashable(obj: Any) -> bool:\n        try:\n            hash(obj)\n            return True\n        except TypeError:\n            return False\n\n    # Determine if all elements in both tuples are hashable.\n    # This guides whether to use the set-based (O(N+M)) or fallback (O(N*M)) approach.\n    all_hashable = True\n    for item in a:\n        if not _is_hashable(item):\n            all_hashable = False\n            break\n    if all_hashable:\n        for item in b:\n            if not _is_hashable(item):\n                all_hashable = False\n                break\n\n    result_a_unique = []\n    result_b_unique = []\n\n    if all_hashable:\n        # Optimized path for hashable items using sets (O(N+M) time complexity).\n        set_b = set(b)\n        set_a = set(a)\n\n        for item_a in a:\n            if item_a not in set_b:\n                result_a_unique.append(item_a)\n\n        for item_b in b:\n            if item_b not in set_a:\n                result_b_unique.append(item_b)\n    else:\n        # Fallback path for unhashable items or mixed types (O(N*M) time complexity).\n        # An item from 'a' is unique to 'a' if it does not equal any item in 'b'.\n        for item_a in a:\n            is_unique_to_a = True\n            for item_b in b:\n                if item_a == item_b:\n                    is_unique_to_a = False\n                    break\n            if is_unique_to_a:\n                result_a_unique.append(item_a)\n\n        # An item from 'b' is unique to 'b' if it does not equal any item in 'a'.\n        for item_b in b:\n            is_unique_to_b = True\n            for item_a in a:\n                if item_b == item_a:\n                    is_unique_to_b = False\n                    break\n            if is_unique_to_b:\n                result_b_unique.append(item_b)\n\n    return tuple(result_a_unique + result_b_unique)"}
{"task_id": "Mbpp/580", "solution": "def extract_even(data: tuple) -> tuple:\n    \"\"\"\n    Recursively filters a nested tuple to include only even integers and non-empty nested tuples.\n    Assumes the input tuple contains only integers or other nested tuples.\n    \"\"\"\n    result = []\n    for el in data:\n        if isinstance(el, int):\n            if el % 2 == 0:\n                result.append(el)\n        elif isinstance(el, tuple):\n            nested_result = extract_even(el)\n            if nested_result:  # Only include non-empty results from nested tuples\n                result.append(nested_result)\n    return tuple(result)"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(a, b, c):\n    \"\"\"Interleaves three lists of the same length into a single flat list.\"\"\"\n    out = []\n    for i in range(len(a)):\n        out.append(a[i])\n        out.append(b[i])\n        out.append(c[i])\n    return out"}
{"task_id": "Mbpp/573", "solution": "from typing import Iterable, Any, List, Union, Optional\nfrom dataclasses import dataclass\nNumber = Union[int, float]\nMULTIPLICATIVE_IDENTITY: int = 1\nclass InvalidInputError(Exception):\n    def __init__(self, message: str, index: Optional[int] = None, value: Any = None) -> None:\n        self.message = message\n        self.index = index\n        self.value = value\n        super().__init__(self.__str__())\n\n    def __str__(self) -> str:\n        base = self.message\n        if self.index is not None:\n            base += f\" (index={self.index}, value={self.value!r})\"\n        return base\nclass ListValidator:\n    def validate_numbers(self, numbers: Iterable[Any]) -> List[Number]:\n        \"\"\"Validates and coerces an iterable of values into a list of numbers.\"\"\"\n        result: List[Number] = []\n        for i, v in enumerate(numbers):\n            result.append(self._to_number(v, i))\n        return result\n\n    def _to_number(self, value: Any, index: int) -> Number:\n        \"\"\"Helper to convert a single value to a number.\"\"\"\n        if isinstance(value, (int, float)):\n            return value\n        if isinstance(value, str):\n            try:\n                if '.' in value or 'e' in value.lower():\n                    return float(value)\n                return int(value)\n            except ValueError:\n                raise InvalidInputError(\"Cannot parse numeric string\", index=index, value=value)\n        raise InvalidInputError(\"Unsupported type for numeric conversion\", index=index, value=value)\nclass UniqueProductService:\n    def compute_product(self, numbers: Iterable[Number]) -> UniqueProductResult:\n        \"\"\"Computes the product of unique numbers.\"\"\"\n        uniques = self._normalize_uniques(numbers)\n        product = MULTIPLICATIVE_IDENTITY\n        for v in uniques:\n            product *= v\n        return UniqueProductResult(value=product, unique_count=len(uniques))\n\n    def _normalize_uniques(self, numbers: Iterable[Number]) -> List[Number]:\n        \"\"\"Deduplicates numbers, preserving first-seen order.\"\"\"\n        seen = set()\n        result: List[Number] = []\n        for v in numbers:\n            if v not in seen:\n                seen.add(v)\n                result.append(v)\n        return result\ndef unique_product(numbers: Iterable[Any]) -> Number:\n    \"\"\"\n    Calculates the product of the unique numbers in a given list.\n    It supports mixed types, including numeric strings, and handles validation.\n    \"\"\"\n    validator = ListValidator()\n    service = UniqueProductService()\n    \n    validated_numbers = validator.validate_numbers(numbers)\n    result = service.compute_product(validated_numbers)\n    return result.value"}
{"task_id": "Mbpp/581", "solution": "def surface_Area(base_edge, height):\n    \"\"\"\n    Calculates the surface area of a square pyramid.\n    The 'height' parameter is interpreted as the slant height.\n    \"\"\"\n    base_area = base_edge * base_edge\n    lateral_area = 2 * base_edge * height  # 4 * (0.5 * base_edge * slant_height)\n    return base_area + lateral_area"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n):\n    \"\"\"\n    Computes the nth Catalan number using the binomial coefficient formula.\n    Catalan(n) = C(2n, n) / (n + 1).\n    \"\"\"\n\n    def _safe_binomial_coefficient(N, K):\n        \"\"\"\n        Calculates C(N, K) efficiently by iteratively multiplying and dividing.\n        This approach avoids computing large intermediate factorials.\n        \"\"\"\n        if K < 0 or K > N:\n            return 0\n        if K == 0 or K == N:\n            return 1\n        if K > N // 2:  # C(N, K) == C(N, N - K)\n            K = N - K\n\n        res = 1\n        for i in range(K):\n            res = res * (N - i) // (i + 1)\n        return res\n\n    # For n=0, C_0 = 1. The formula C(0,0)/(0+1) = 1/1 = 1 works.\n    # For n < 0, Catalan numbers are usually considered 0, but the problem context implies n >= 0.\n    # Assuming n is a non-negative integer based on typical Catalan number definitions.\n    \n    binomial_coeff = _safe_binomial_coefficient(2 * n, n)\n    return binomial_coeff // (n + 1)"}
