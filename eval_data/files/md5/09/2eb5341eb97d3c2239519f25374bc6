{"task_id": "Mbpp/128", "solution": "from typing import List, Union\nimport re\nclass WordFilterResult:\n    \"\"\"DTO to hold matched tokens and count.\"\"\"\n    def __init__(self, matched: List[str]) -> None:\n        self.matched = matched\n        self.count = len(matched)\n\n    def to_list(self) -> List[str]:\n        \"\"\"Returns the list of matched words.\"\"\"\n        return self.matched\n\n    def to_dict(self) -> dict:\n        \"\"\"Returns a dictionary representation of the result.\"\"\"\n        return {\"matched\": self.matched, \"count\": self.count}\nclass TextRepository:\n    \"\"\"Normalizes input sources into a list of strings.\"\"\"\n    def __init__(self) -> None:\n        self._valid_file_extensions: List[str] = ['.txt']\n\n    def normalize_source(self, source: Union[str, List[str]]) -> List[str]:\n        \"\"\"If source is list[str], return it; if str, return [source].\"\"\"\n        if isinstance(source, list):\n            return source\n        elif isinstance(source, str):\n            return [source]\n        # The design context specified raising ValidationError for unsupported types,\n        # but the prompt restricts raising exceptions.\n        # This implementation will rely on broader checks if needed, but follows the spirit.\n        return []\nTOKEN_RE = re.compile(r\"[A-Za-z0-9]+(?:[-'][A-Za-z0-9]+)*\")\nclass TokenizerUtil:\n    \"\"\"Tokenize and normalize raw text into tokens.\"\"\"\n    def __init__(self, preserve_case: bool = False) -> None:\n        self.preserve_case = preserve_case\n\n    def tokenize(self, text: str) -> List[str]:\n        \"\"\"Converts input text into tokens using regex.\"\"\"\n        # The design context specified raising TokenizationError for non-string input,\n        # but the prompt restricts raising exceptions.\n        # Assuming `text` will always be a string based on prior normalization.\n        raw = TOKEN_RE.findall(text)\n        return [self._normalize_token(t) for t in raw]\n\n    def _normalize_token(self, token: str) -> str:\n        \"\"\"Trims punctuation and optionally lowercases a token.\"\"\"\n        return token if self.preserve_case else token.lower()\nclass LongWordService:\n    \"\"\"Encapsulates core business logic for filtering long words.\"\"\"\n    def __init__(self, repository: TextRepository, tokenizer: TokenizerUtil) -> None:\n        self.repository = repository\n        self.tokenizer = tokenizer\n\n    def filter_long_words(self, n: int, source: Union[str, List[str]]) -> WordFilterResult:\n        \"\"\"Filters words longer than n characters from the source.\"\"\"\n        # The design context specified _validate, but the prompt restricts isinstance checks and exceptions.\n        # Assuming valid inputs based on the prompt's constraints.\n        parts = self.repository.normalize_source(source)\n        text = \" \".join(parts)\n        tokens = self.tokenizer.tokenize(text)\n        matched = [t for t in tokens if len(t) > n]\n        return WordFilterResult(matched)\ndef long_words(n: int, text: Union[str, List[str]]) -> List[str]:\n    \"\"\"\n    Finds words that are longer than n characters from a given list of words or string.\n    \"\"\"\n    repo = TextRepository()\n    tokenizer = TokenizerUtil(preserve_case=False)\n    svc = LongWordService(repo, tokenizer)\n    result = svc.filter_long_words(n, text)\n    return result.to_list()"}
{"task_id": "Mbpp/126", "solution": "import math\nfrom typing import List, Optional\nclass NumberPair:\n    \"\"\"A data transfer object for a pair of numbers.\"\"\"\n    def __init__(self, a: int, b: int) -> None:\n        self.a = a\n        self.b = b\n        # Validation for non-integers or both zeros is omitted as per prompt's constraints.\nclass DivisorResult:\n    \"\"\"A data transfer object for common divisor computation results.\"\"\"\n    def __init__(self, gcd: int, divisors: List[int], sum: int) -> None:\n        self.gcd = gcd\n        self.divisors = divisors\n        self.sum = sum\nclass MathUtils:\n    \"\"\"Utility class for mathematical operations.\"\"\"\n    @staticmethod\n    def gcd(a: int, b: int) -> int:\n        \"\"\"Computes the greatest common divisor of two integers.\"\"\"\n        return math.gcd(a, b)\n\n    @staticmethod\n    def divisors(n: int) -> List[int]:\n        \"\"\"Enumerates all positive divisors of a given positive integer n.\"\"\"\n        if n <= 0:\n            # This case is handled by the service ensuring gcd_val > 0 before calling.\n            # If n is 0, this will still raise an error, but the service design prevents that.\n            raise ValueError(\"n must be positive for divisor enumeration\")\n        res = set()\n        i = 1\n        while i * i <= n:\n            if n % i == 0:\n                res.add(i)\n                res.add(n // i)\n            i += 1\n        return sorted(list(res))\nclass InMemoryRepository:\n    \"\"\"An optional in-memory repository for caching recent results.\"\"\"\n    def __init__(self, max_size: int = 100) -> None:\n        self._store_map = {}\n        self._max_size = max_size\n        self._keys_order = [] # Simple list to track order for eviction\n\n    def get(self, key: str) -> Optional[DivisorResult]:\n        \"\"\"Retrieves a DivisorResult from the cache by key.\"\"\"\n        return self._store_map.get(key)\n\n    def store(self, key: str, value: DivisorResult) -> None:\n        \"\"\"Stores a DivisorResult in the cache, managing max_size.\"\"\"\n        if key in self._store_map:\n            self._keys_order.remove(key) # Move to end (most recently used)\n        elif len(self._store_map) >= self._max_size:\n            oldest_key = self._keys_order.pop(0) # Remove oldest\n            del self._store_map[oldest_key]\n        self._store_map[key] = value\n        self._keys_order.append(key)\nclass CommonDivisorService:\n    \"\"\"Core service for computing the sum of common divisors.\"\"\"\n    def __init__(self, repo: Optional[InMemoryRepository] = None) -> None:\n        self._repo = repo\n\n    def sum_common_divisors(self, a: int, b: int) -> int:\n        \"\"\"\n        Computes the sum of common divisors for two integers.\n        Inputs are treated as their absolute values for divisor calculation.\n        \"\"\"\n        pair = NumberPair(a, b)\n        # Input validation for non-integers or both zeros is omitted here due to prompt constraints.\n        # If a and b are both 0, MathUtils.gcd(0,0) is 0, leading to an empty divisor list and sum 0.\n\n        key = f\"{abs(pair.a)}:{abs(pair.b)}\"\n        if self._repo:\n            cached = self._repo.get(key)\n            if cached:\n                return cached.sum\n\n        gcd_val = MathUtils.gcd(abs(pair.a), abs(pair.b))\n\n        divs = MathUtils.divisors(gcd_val) if gcd_val > 0 else []\n\n        total = sum(divs)\n\n        result = DivisorResult(gcd=gcd_val, divisors=divs, sum=total)\n        if self._repo:\n            self._repo.store(key, result)\n\n        return total\n_repo = InMemoryRepository()\n_service = CommonDivisorService(repo=_repo)\ndef sum(a: int, b: int) -> int:\n    \"\"\"\n    Finds the sum of common divisors of two given numbers.\n    This function acts as the public facade, delegating to the core service.\n    \"\"\"\n    return _service.sum_common_divisors(a, b)"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels in a given string.\n    'y' is not considered a vowel.\n    \"\"\"\n    VOWELS = {\"a\", \"e\", \"i\", \"o\", \"u\", \"A\", \"E\", \"I\", \"O\", \"U\"}\n\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is a vowel (case-insensitive, 'y' excluded).\"\"\"\n        return char in VOWELS\n\n    chars = list(s)\n    \n    # Collect all vowels from the string in their original order.\n    found_vowels = [c for c in chars if _is_vowel(c)]\n    \n    # Reverse the collected vowels.\n    found_vowels.reverse()\n    \n    # Create an iterator for the reversed vowels to place them back.\n    vowels_iterator = iter(found_vowels)\n    \n    # Rebuild the string, replacing original vowel positions with reversed vowels.\n    result_chars = []\n    for char in chars:\n        if _is_vowel(char):\n            result_chars.append(next(vowels_iterator))\n        else:\n            result_chars.append(char)\n            \n    return \"\".join(result_chars)"}
