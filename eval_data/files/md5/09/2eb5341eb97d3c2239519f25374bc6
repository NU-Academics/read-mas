{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of squares of the first n even natural numbers using a closed-form formula.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    # The sum of squares of the first n even natural numbers (2k)^2 for k=1 to n\n    # is 4 * sum(k^2) for k=1 to n.\n    # The sum of first n squares (k^2) is n * (n + 1) * (2 * n + 1) / 6.\n    # Therefore, the sum is 4 * n * (n + 1) * (2 * n + 1) // 6.\n    return 4 * n * (n + 1) * (2 * n + 1) // 6"}
{"task_id": "Mbpp/290", "solution": "def max_length(lists: Sequence[Sequence[Any]]) -> Tuple[int, Sequence[Any]]:\n    \"\"\"\n    Finds the list of maximum length in a list of lists.\n    Returns a tuple containing the maximum length and the first sublist with that length.\n    \"\"\"\n    if not lists:\n        return 0, []\n\n    max_len = 0\n    first_of_max: Sequence[Any] = []\n\n    for sublist in lists:\n        current_len = len(sublist)\n        if current_len > max_len:\n            max_len = current_len\n            first_of_max = sublist\n\n    return max_len, first_of_max"}
{"task_id": "Mbpp/294", "solution": "from typing import Sequence, Any, Union, Iterable, List, Iterator\nclass MaxFinderError(Exception):\n    \"\"\"Base exception for the maxfinder library.\"\"\"\n    pass\nclass NoNumericValueError(MaxFinderError, ValueError):\n    \"\"\"Raised when no numeric value is found in the input.\"\"\"\n    def __init__(self, message: str = \"No numeric value found in input\") -> None:\n        super().__init__(message)\nclass NumberList:\n    \"\"\"Encapsulates an input sequence and provides normalized iteration.\"\"\"\n    def __init__(self, items: Sequence[Any]) -> None:\n        if not hasattr(items, \"__iter__\"):\n            raise TypeError(\"items must be an iterable sequence\")\n        self._items: Sequence[Any] = items\n\n    def __iter__(self) -> Iterator[Any]:\n        return iter(self._items)\n\n    def as_list(self) -> List[Any]:\n        return list(self._items)\nclass TypeUtils:\n    \"\"\"Provides utility methods for type detection.\"\"\"\n    NUMERIC_TYPES = (int, float)\n\n    def is_numeric(self, obj: Any) -> bool:\n        return isinstance(obj, self.NUMERIC_TYPES) and not isinstance(obj, bool)\n\n    def to_numeric(self, obj: Any) -> Union[int, float]:\n        if self.is_numeric(obj):\n            return obj\n        raise TypeError(\"Object is not numeric\")\nclass MaxValueService:\n    \"\"\"Core algorithm to compute the maximum numeric value.\"\"\"\n    def __init__(self, type_utils: TypeUtils) -> None:\n        self._type_utils = type_utils\n\n    def _filter_numeric(self, items: Iterable[Any]) -> List[Union[int, float]]:\n        return [x for x in items if self._type_utils.is_numeric(x)]\n\n    def find_max(self, numbers: NumberList) -> Union[int, float]:\n        nums = self._filter_numeric(numbers)\n        if not nums:\n            raise NoNumericValueError()\n        return max(nums)\nclass CLIController:\n    \"\"\"Public API layer that callers use, validates inputs and handles delegation.\"\"\"\n    def __init__(self, service: MaxValueService) -> None:\n        self._service = service\n\n    def _validate_input(self, items: Any) -> Sequence[Any]:\n        if not hasattr(items, \"__iter__\"):\n            raise TypeError(\"Input must be iterable\")\n        return items\n\n    def max_val(self, items: Sequence[Any]) -> Union[int, float]:\n        validated = self._validate_input(items)\n        number_list = NumberList(validated)\n        return self._service.find_max(number_list)\n_default_service = MaxValueService(TypeUtils())\n_default_controller = CLIController(_default_service)\ndef max_val(items: Sequence[Any]) -> Union[int, float]:\n    \"\"\"\n    Finds the maximum numeric value in a heterogeneous list.\n    Ignores non-numeric items and raises an error if no numeric values are found.\n    \"\"\"\n    return _default_controller.max_val(items)"}
{"task_id": "Mbpp/286", "solution": "from typing import List\ndef _kadane(arr: List[int]) -> int:\n    \"\"\"Computes the maximum contiguous subarray sum using Kadane's algorithm.\"\"\"\n    max_ending_here = arr[0]\n    max_so_far = arr[0]\n    for x in arr[1:]:\n        max_ending_here = max(x, max_ending_here + x)\n        max_so_far = max(max_so_far, max_ending_here)\n    return max_so_far\ndef _max_prefix_sum(arr: List[int]) -> int:\n    \"\"\"Computes the maximum sum of any prefix of the array.\"\"\"\n    best = current = arr[0]\n    for x in arr[1:]:\n        current += x\n        best = max(best, current)\n    return best\ndef _max_suffix_sum(arr: List[int]) -> int:\n    \"\"\"Computes the maximum sum of any suffix of the array.\"\"\"\n    best = current = arr[-1]\n    for x in reversed(arr[:-1]):\n        current += x\n        best = max(best, current)\n    return best\ndef max_sub_array_sum_repeated(arr: List[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous array in the modified array formed by repeating the given array k times.\n    This function applies Kadane's algorithm and considers array repetition strategies.\n    \"\"\"\n    if k == 1:\n        return _kadane(arr)\n\n    # Compute the maximum subarray sum within two concatenated arrays.\n    # This covers cases where the max sum spans the boundary of a single repetition.\n    best_two = _kadane(arr + arr)\n\n    total_sum_arr = sum(arr)\n\n    # If the total sum of the array is positive and k > 2,\n    # the maximum sum could potentially include multiple full repetitions of the array\n    # between a max suffix from the first part and a max prefix from the last part.\n    if total_sum_arr > 0 and k > 2:\n        max_prefix = _max_prefix_sum(arr)\n        max_suffix = _max_suffix_sum(arr)\n        \n        # The candidate sum is composed of a max suffix, (k-2) full array sums, and a max prefix.\n        candidate_with_middle = max_suffix + (k - 2) * total_sum_arr + max_prefix\n        \n        return max(best_two, candidate_with_middle)\n    \n    # If total_sum_arr is non-positive or k is 2,\n    # repeating the array further will not yield a sum greater than best_two.\n    return best_two"}
{"task_id": "Mbpp/293", "solution": "import math\ndef otherside_rightangle(a: float, b: float, hypotenuse_known: bool = False) -> float:\n    \"\"\"\n    Calculates the third side of a right-angled triangle.\n    By default, it computes the hypotenuse from two legs (a and b).\n    If hypotenuse_known is True, it computes the other leg, where 'a' is the hypotenuse and 'b' is a known leg.\n    \"\"\"\n    if not hypotenuse_known:\n        # a and b are legs, calculate the hypotenuse\n        return math.sqrt(a**2 + b**2)\n    else:\n        # a is the hypotenuse, b is one leg, calculate the other leg\n        return math.sqrt(a**2 - b**2)"}
