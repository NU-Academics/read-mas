{"task_id": "Mbpp/65", "solution": "from typing import Any, Iterator, List, Dict, Optional\nclass Utils:\n    \"\"\"Provides utility methods for type checking.\"\"\"\n    @staticmethod\n    def is_numeric(value: Any) -> bool:\n        \"\"\"Checks if a value is a numeric type (int or float, but not bool).\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n    @staticmethod\n    def is_list(value: Any) -> bool:\n        \"\"\"Checks if a value is strictly a list.\"\"\"\n        return isinstance(value, list)\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation errors with context about invalid items.\"\"\"\n    def __init__(self, message: str, invalid_items: List[Any] = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.invalid_items = invalid_items or []\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Converts the error details to a dictionary.\"\"\"\n        return {\"message\": self.message, \"invalid_items\": self.invalid_items}\nclass SumResult:\n    \"\"\"Data Transfer Object (DTO) for the sum and count of elements.\"\"\"\n    def __init__(self, sum: float, count: int, metadata: Dict[str, Any] = None) -> None:\n        self.sum = float(sum)\n        self.count = int(count)\n        self.metadata = metadata or {}\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Converts the SumResult object to a serializable dictionary.\"\"\"\n        return {\"sum\": self.sum, \"count\": self.count, \"metadata\": self.metadata}\nclass ListFlattener:\n    \"\"\"Traverses a nested list structure and yields numeric primitives.\"\"\"\n    MAX_RECURSION_DEPTH = 1000\n\n    def flatten(self, data: list) -> Iterator[float]:\n        \"\"\"Public entry to flatten the list, ensuring top-level is a list.\"\"\"\n        if not Utils.is_list(data):\n            raise ValidationError(\"Top-level input must be a list\", [data])\n        yield from self._flatten_recursive(data, depth=0)\n\n    def _flatten_recursive(self, item: Any, depth: int = 0) -> Iterator[float]:\n        \"\"\"Recursively yields numeric values from nested structures.\"\"\"\n        if depth > self.MAX_RECURSION_DEPTH:\n            raise ValidationError(\"Max recursion depth exceeded\", [item])\n        if Utils.is_numeric(item):\n            yield float(item)\n        elif Utils.is_list(item):\n            for child in item:\n                yield from self._flatten_recursive(child, depth + 1)\n        else:\n            raise ValidationError(\"Invalid element type\", [item])\nclass RecursiveListSumService:\n    \"\"\"Coordinates validation, flattening, and summing operations.\"\"\"\n    def __init__(self, flattener: Optional[ListFlattener] = None) -> None:\n        self._flattener = flattener or ListFlattener()\n\n    def compute_sum(self, data: list) -> SumResult:\n        \"\"\"Computes the sum and count of numeric elements in a nested list.\"\"\"\n        if not Utils.is_list(data):\n            raise ValidationError(\"Input must be a list\", [data])\n        \n        total = 0.0\n        count = 0\n        input_len = len(data)\n\n        for num in self._flattener.flatten(data):\n            total += num\n            count += 1\n        return SumResult(sum=total, count=count, metadata={\"input_length\": input_len})\n_service: Optional[RecursiveListSumService] = None\ndef recursive_list_sum(data: list) -> float:\n    \"\"\"Flattens a list and sums all of its numeric elements.\"\"\"\n    global _service\n    if _service is None:\n        _service = RecursiveListSumService()\n    \n    result = _service.compute_sum(data)\n    return result.sum"}
{"task_id": "Mbpp/66", "solution": "def pos_count(numbers_list):\n    \"\"\"Counts the number of positive numbers in a list.\n    Positive numbers are defined as strictly greater than zero.\"\"\"\n    return sum(1 for number in numbers_list if number > 0)"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(container: list, sub: list) -> bool:\n    \"\"\"\n    Checks if a sublist is present as a contiguous sequence in a container list.\n    \"\"\"\n    n = len(container)\n    m = len(sub)\n\n    # An empty sublist is considered contained in any container.\n    if m == 0:\n        return True\n\n    # A sublist cannot be contained if it's longer than the container.\n    if m > n:\n        return False\n\n    # Perform a naive sliding window search.\n    for i in range(n - m + 1):\n        if container[i : i + m] == sub:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    # Computes the nth Bell number using the Bell triangle (Aitken's array).\n    # Bell(n) is the number of partitions of a set with n elements.\n    if n == 0:\n        return 1\n    row = [1]\n    for i in range(1, n + 1):\n        new_row = [row[-1]]\n        for j in range(1, i + 1):\n            new_row.append(new_row[-1] + (row[j - 1] if j - 1 < len(row) else 0))\n        row = new_row\n    return row[0]"}
{"task_id": "Mbpp/70", "solution": "def get_equal(tuples):\n    \"\"\"\n    Checks if all given tuples have an equal length.\n    Returns True for empty or single-tuple inputs, and if all lengths are identical for multiple tuples.\n    \"\"\"\n    lengths = [len(t) for t in tuples]\n\n    if not lengths or len(lengths) == 1:\n        return True\n\n    first_length = lengths[0]\n    return all(length == first_length for length in lengths[1:])"}
{"task_id": "Mbpp/71", "solution": "from typing import Iterable, Callable, Any, List, Optional, Tuple\nimport json\nclass SortError(Exception):\n    \"\"\"Custom exception for sorting-related errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\nclass Validator:\n    \"\"\"Utility class for input validation.\"\"\"\n    @staticmethod\n    def validate_iterable(items: Any) -> None:\n        \"\"\"Ensures items is an iterable and not None.\"\"\"\n        if items is None:\n            raise SortError(\"Input 'items' cannot be None.\")\n        try:\n            iter(items)\n        except TypeError:\n            raise SortError(\"Input 'items' must be an iterable.\")\n\n    @staticmethod\n    def ensure_comparable_pair(a: Any, b: Any, key: Optional[Callable[[Any], Any]] = None) -> None:\n        \"\"\"Attempts a comparison to check if elements are comparable.\"\"\"\n        try:\n            val_a = key(a) if key else a\n            val_b = key(b) if key else b\n            # Attempt a comparison to trigger TypeError if not comparable\n            _ = val_a < val_b\n        except TypeError as e:\n            raise SortError(f\"Elements are not comparable: {e}\")\nclass SortRequest:\n    \"\"\"Data transfer object for a sort request.\"\"\"\n    def __init__(self, items: Iterable[Any], reverse: bool = False, shrink: Optional[float] = None) -> None:\n        self.items = list(items)  # Ensure a list copy\n        self.reverse = reverse\n        self.shrink = shrink\nclass SortResult:\n    \"\"\"Data transfer object for a sort operation result.\"\"\"\n    def __init__(self, sorted_items: List[Any], comparisons: int, swaps: int) -> None:\n        self.sorted_items = sorted_items\n        self.comparisons = comparisons\n        self.swaps = swaps\n\n    def to_json(self) -> str:\n        \"\"\"Serializes the result to a JSON string.\"\"\"\n        return json.dumps({\n            \"sorted_items\": self.sorted_items,\n            \"comparisons\": self.comparisons,\n            \"swaps\": self.swaps\n        })\nDEFAULT_SHRINK = 1.3\nclass CombSorter:\n    \"\"\"Implements the Comb Sort algorithm and collects metrics.\"\"\"\n    def sort(self, items: List[Any], key: Optional[Callable[[Any], Any]] = None, reverse: bool = False, shrink: float = DEFAULT_SHRINK) -> Tuple[List[Any], int, int]:\n        arr = list(items)  # Do not mutate caller's list\n        n = len(arr)\n        if n < 2:\n            return arr, 0, 0\n        \n        comparisons = 0\n        swaps = 0\n        gap = n\n        sorted_flag = False\n        \n        while not sorted_flag:\n            gap = int(gap / shrink)\n            if gap <= 1:\n                gap = 1\n                sorted_flag = True # Assume sorted until a swap occurs\n\n            i = 0\n            while i + gap < n:\n                # Retrieve values for comparison, applying the key function\n                val_i = key(arr[i]) if key else arr[i]\n                val_gap = key(arr[i + gap]) if key else arr[i + gap]\n                \n                comparisons += 1\n                Validator.ensure_comparable_pair(val_i, val_gap) # Validate comparability of the actual comparison values\n\n                should_swap = (val_i > val_gap) ^ reverse # XOR with reverse for correct ascending/descending order\n\n                if should_swap:\n                    arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                    swaps += 1\n                    sorted_flag = False # A swap occurred, so not yet fully sorted\n                i += 1\n        return arr, comparisons, swaps\nclass SortService:\n    \"\"\"Orchestrates validation and the Comb Sort algorithm.\"\"\"\n    def sort(self, request: SortRequest, key: Optional[Callable[[Any], Any]] = None) -> SortResult:\n        Validator.validate_iterable(request.items) # Ensure the initial items are iterable\n        sorter = CombSorter()\n        \n        # Use key passed to service, fallback to default shrink factor if not specified in request\n        effective_shrink = request.shrink if request.shrink is not None else DEFAULT_SHRINK\n        \n        sorted_items, comparisons, swaps = sorter.sort(\n            list(request.items), # Pass a new copy to sorter to ensure no mutation if request.items was modified\n            key=key,\n            reverse=request.reverse,\n            shrink=effective_shrink\n        )\n        return SortResult(sorted_items, comparisons, swaps)\ndef comb_sort(items: Iterable[Any], key: Optional[Callable[[Any], Any]] = None, reverse: bool = False, shrink: Optional[float] = None) -> List[Any]:\n    \"\"\"Sorts a list of elements using the Comb Sort algorithm.\"\"\"\n    req = SortRequest(items, reverse=reverse, shrink=shrink)\n    svc = SortService()\n    result = svc.sort(req, key=key) # Pass the key to the service\n    return result.sorted_items"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(seq1, seq2) -> bool:\n    \"\"\"\n    Checks if two sequences follow the same pattern, maintaining a bijective mapping.\n    \"\"\"\n    if len(seq1) != len(seq2):\n        return False\n\n    mapping_ab = {}\n    mapping_ba = {}\n\n    for x, y in zip(seq1, seq2):\n        if x in mapping_ab:\n            if mapping_ab[x] != y:\n                return False\n        else:\n            mapping_ab[x] = y\n\n        if y in mapping_ba:\n            if mapping_ba[y] != x:\n                return False\n        else:\n            mapping_ba[y] = x\n\n    return True"}
