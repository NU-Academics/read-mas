{"task_id": "Mbpp/59", "solution": "def is_octagonal(n: int) -> int:\n    \"\"\"Calculates the nth octagonal number.\n\n    The formula for the nth octagonal number is O_n = n * (3*n - 2).\n    \"\"\"\n    # This is a self-contained implementation as per the prompt's instructions.\n    # The design context provides a more complex layered architecture,\n    # but the completion task is for a single function without external dependencies.\n    # Therefore, we directly implement the formula as described in the design context (FR1).\n\n    # The design context also specifies:\n    # \"Error handling: non-integer or n < 1 raises ValueError with clear message.\"\n    # and \"Business rules: n must be a positive integer (>= 1).\"\n    # However, the prompt also says: \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n    # Given 'n: int' type hint, we assume valid integer input >= 1.\n    return n * (3 * n - 2)"}
{"task_id": "Mbpp/57", "solution": "def find_Max_Num(digits):\n    \"\"\"\n    Finds the largest number that can be formed by arranging the given list of digits.\n    Sorts digits in descending order and concatenates them to form the largest number.\n    \"\"\"\n    sorted_digits = sorted(digits, reverse=True)\n    return int(\"\".join(map(str, sorted_digits)))"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    # Transforms each digit d to (int(d) - 1) and counts zero-sum subarrays using prefix sums.\n    # The sum of digits equals length when sum(digit - 1) equals 0.\n    freq = {0: 1}\n    total_count = 0\n    current_prefix_sum = 0\n    for char_digit in s:\n        # Transform digit: '0' -> -1, '1' -> 0, '2' -> 1, etc.\n        transformed_value = int(char_digit) - 1\n        current_prefix_sum += transformed_value\n        \n        # If current_prefix_sum has been seen before, it means a subarray\n        # between the previous occurrence and current position sums to zero.\n        total_count += freq.get(current_prefix_sum, 0)\n        \n        # Increment frequency of the current prefix sum\n        freq[current_prefix_sum] = freq.get(current_prefix_sum, 0) + 1\n    return total_count"}
{"task_id": "Mbpp/63", "solution": "class EmptyInputError(Exception):\n    \"\"\"Raised when no input pairs are provided.\"\"\"\n    pass\ndef max_difference(pairs):\n    \"\"\"\n    Finds the maximum absolute difference between values in available pairs.\n    Each pair is expected to be a 2-element tuple of numbers.\n    \"\"\"\n    max_diff_found = None\n\n    for pair in pairs:\n        a, b = pair\n        current_diff = abs(float(a) - float(b))\n        \n        if max_diff_found is None or current_diff > max_diff_found:\n            max_diff_found = current_diff\n            \n    if max_diff_found is None:\n        raise EmptyInputError(\"No pairs provided\")\n        \n    return max_diff_found"}
