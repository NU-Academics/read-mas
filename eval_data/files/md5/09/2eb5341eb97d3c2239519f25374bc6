{"task_id": "Mbpp/94", "solution": "def index_minimum(items):\n    \"\"\"\n    Returns the first value of the tuple with the smallest second value.\n    Assumes `items` is a non-empty list of 2-element tuples.\n    \"\"\"\n    min_first_value = items[0][0]\n    min_second_value = items[0][1]\n\n    for first, second in items[1:]:\n        if second < min_second_value:\n            min_first_value = first\n            min_second_value = second\n\n    return min_first_value"}
{"task_id": "Mbpp/92", "solution": "from typing import Any, Callable, List, Union\nclass InvalidInputError(Exception):\n    \"\"\"Exception for invalid input values.\"\"\"\n    pass\ndef validate_int_input(value: Any) -> str:\n    \"\"\"Validates and normalizes an input to a canonical digit string.\"\"\"\n    if isinstance(value, int):\n        if value < 0:\n            raise InvalidInputError(\"Negative integers are not supported\")\n        return str(value)\n    if isinstance(value, str):\n        s = value.strip()\n        if not s.isdigit():\n            raise InvalidInputError(f\"String contains non-digit characters: {value!r}\")\n        return s\n    raise InvalidInputError(f\"Unsupported input type: {type(value).__name__}\")\nclass NumberModel:\n    \"\"\"Represents a normalized numeric input as a sequence of digits.\"\"\"\n    def __init__(self, raw: str) -> None:\n        self.raw: str = raw\n        self.digits: List[str] = list(raw)\n\n    @classmethod\n    def from_int(cls, value: int) -> \"NumberModel\":\n        return cls(str(value))\n\n    def is_valid_length(self, min_len: int = 3) -> bool:\n        \"\"\"Checks if the number has a valid length (>= min_len).\"\"\"\n        return len(self.digits) >= min_len\nclass UndulatingService:\n    \"\"\"Service containing the core business logic for checking undulating numbers.\"\"\"\n    def __init__(self, validator: Callable[[Any], str] | None = None) -> None:\n        self._validator = validator or validate_int_input\n\n    def is_undulating(self, value: Union[int, str]) -> bool:\n        \"\"\"Determines if the given value is an undulating number.\"\"\"\n        digit_str = self._validator(value)\n        model = NumberModel(digit_str)\n        if not model.is_valid_length(3):\n            return False\n        return self._check_alternation(model.digits)\n\n    def _check_alternation(self, digits: List[str]) -> bool:\n        \"\"\"Checks if the digits alternate between exactly two distinct values.\"\"\"\n        if len(digits) < 3:\n            return False\n\n        a, b = digits[0], digits[1]\n        if a == b:\n            return False\n\n        for i, d in enumerate(digits):\n            expected = a if i % 2 == 0 else b\n            if d != expected:\n                return False\n        return True\ndef is_undulating(number: Union[int, str]) -> bool:\n    \"\"\"\n    Checks if a number is undulating, meaning its digits alternate between exactly two distinct digits.\n    Numbers with fewer than 3 digits are not considered undulating by default.\n    \"\"\"\n    svc = UndulatingService()\n    return svc.is_undulating(number)"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists):\n    \"\"\"\n    Finds the length of the smallest list in a list of lists.\n    Assumes the input list_of_lists is non-empty and contains only lists or tuples.\n    \"\"\"\n    min_len = len(list_of_lists[0])\n    for inner_list in list_of_lists:\n        current_len = len(inner_list)\n        if current_len < min_len:\n            min_len = current_len\n            if min_len == 0:\n                break\n    return min_len"}
{"task_id": "Mbpp/93", "solution": "def power(a, b):\n    import math\n\n    class PowerError(Exception):\n        def __init__(self, message: str, code: int = 1):\n            super().__init__(message)\n            self.message = message\n            self.code = code\n        def __str__(self):\n            return self.message\n\n    class ValidationError(PowerError):\n        def __init__(self, message: str, field: str = \"input\"):\n            super().__init__(message, code=2)\n            self.field = field\n        def __str__(self):\n            return f\"{self.field} validation error: {self.message}\"\n\n    class CalculationError(PowerError):\n        def __init__(self, message: str, cause: Exception | None = None):\n            super().__init__(message, code=1)\n            self.cause = cause\n        def __str__(self):\n            return f\"Calculation error: {self.message}\" + (f\" (Cause: {self.cause})\" if self.cause else \"\")\n\n    class Validator:\n        def parse_numeric(self, value) -> float:\n            try:\n                if isinstance(value, (int, float)):\n                    v = float(value)\n                else:\n                    v = float(str(value).strip())\n            except (ValueError, TypeError):\n                raise ValidationError(f\"Value '{value}' is not numeric\")\n            if not math.isfinite(v):\n                raise ValidationError(f\"Value '{value}' is not a finite number\")\n            return v\n\n    class PowerRequest:\n        def __init__(self, base: float, exponent: float):\n            self.base = base\n            self.exponent = exponent\n\n        @staticmethod\n        def from_raw(base, exponent) -> \"PowerRequest\":\n            v = Validator()\n            b = v.parse_numeric(base)\n            e = v.parse_numeric(exponent)\n            return PowerRequest(b, e)\n\n    class MathAdapter:\n        def compute(self, base: float, exponent: float) -> float:\n            try:\n                return pow(base, exponent)\n            except (OverflowError, ValueError) as exc:\n                raise CalculationError(f\"Computation failed for {base}^{exponent}\", cause=exc) from exc\n\n    class PowerService:\n        def __init__(self, adapter: MathAdapter):\n            self._adapter = adapter\n\n        def power(self, req: PowerRequest) -> float:\n            if req.base == 0.0 and req.exponent < 0.0:\n                raise CalculationError(\"0 cannot be raised to a negative power\")\n            return self._adapter.compute(req.base, req.exponent)\n\n    math_adapter_instance = MathAdapter()\n    power_service_instance = PowerService(math_adapter_instance)\n\n    power_request = PowerRequest.from_raw(a, b)\n\n    return power_service_instance.power(power_request)"}
{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"\n    Finds the number of positive divisors for a given integer.\n    For negative input, it uses the absolute value. By convention, divisor(0) is 0.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    n_abs = abs(n)\n    factors = {}\n    temp_n = n_abs\n\n    # Count factors of 2\n    while temp_n % 2 == 0:\n        factors[2] = factors.get(2, 0) + 1\n        temp_n //= 2\n\n    # Count factors of odd numbers\n    d = 3\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors[d] = factors.get(d, 0) + 1\n            temp_n //= d\n        d += 2\n\n    # If temp_n is still greater than 1, it must be a prime factor itself\n    if temp_n > 1:\n        factors[temp_n] = factors.get(temp_n, 0) + 1\n\n    # Calculate number of divisors from prime factorization\n    num_divisors = 1\n    for exponent in factors.values():\n        num_divisors *= (exponent + 1)\n\n    return num_divisors"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(n: int) -> str:\n    \"\"\"Converts a non-negative decimal integer to its binary string equivalent without leading zeros.\"\"\"\n    if n == 0:\n        return \"0\"\n\n    bits = []\n    while n > 0:\n        bits.append(str(n % 2))\n        n //= 2\n    return ''.join(reversed(bits))"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(numbers):\n    \"\"\"\n    Multiplies all numbers in a sequence and divides the product by the sequence's length.\n    Assumes valid, non-empty numeric input sequence based on the problem constraints.\n    \"\"\"\n    product_val = 1.0\n    for num in numbers:\n        product_val *= num\n\n    list_len = len(numbers)\n    # Based on the problem description and constraints, we assume list_len will not be zero.\n    # The provided assert uses a non-empty sequence.\n    return product_val / list_len"}
{"task_id": "Mbpp/97", "solution": "import json\nimport os\nimport tempfile\nfrom abc import ABC, abstractmethod\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Any, Dict, Hashable, Iterable, Iterator, List, Optional, TypeVar, cast\nT = TypeVar(\"T\")\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input data.\"\"\"\n    pass\nclass RepositoryError(Exception):\n    \"\"\"Custom exception for repository-related issues.\"\"\"\n    pass\nclass FrequencyResult:\n    \"\"\"Data Transfer Object for frequency computation results with metadata.\"\"\"\n    def __init__(self, result: Dict[Hashable, int], meta: Dict[str, Any]) -> None:\n        self.result = result\n        self.meta = meta\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Converts the result and metadata to a dictionary for serialization.\"\"\"\n        serializable_result = {str(k): v for k, v in self.result.items()}\n        return {\"result\": serializable_result, \"meta\": self.meta}\ndef is_iterable(obj: Any) -> bool:\n    \"\"\"Checks if an object is iterable but not a string or bytes.\"\"\"\n    return hasattr(obj, '__iter__') and not isinstance(obj, (str, bytes))\nclass Flattener:\n    \"\"\"Flattens a list of iterables by one level.\"\"\"\n    def __init__(self, strict: bool = True) -> None:\n        self._strict = strict\n\n    def flatten(self, nested: Iterable[Iterable[T]]) -> Iterator[T]:\n        \"\"\"Yields elements from a one-level-nested iterable.\"\"\"\n        if not is_iterable(nested):\n            raise InvalidInputError(\"Top-level input must be iterable.\")\n        for inner in nested:\n            if not is_iterable(inner):\n                if self._strict:\n                    raise InvalidInputError(\"Inner elements must be iterable when strict=True\")\n                yield cast(T, inner)\n            else:\n                for item in inner:\n                    yield item\nclass Repository(ABC):\n    \"\"\"Abstract base class for persistence repositories.\"\"\"\n    @abstractmethod\n    def save(self, key: str, payload: Dict[str, Any]) -> None:\n        \"\"\"Saves a payload associated with a given key.\"\"\"\n        pass\n\n    @abstractmethod\n    def load(self, key: str) -> Optional[Dict[str, Any]]:\n        \"\"\"Loads a payload for a given key, or None if not found.\"\"\"\n        pass\nclass FileRepository(Repository):\n    \"\"\"A file-based repository that stores data in a JSON file.\"\"\"\n    ATOMIC_WRITE_SUFFIX = '.tmp'\n    DEFAULT_REPO_KEY = \"results\"\n\n    def __init__(self, path: Path) -> None:\n        self._path = path\n\n    def _read_data(self) -> Dict[str, Any]:\n        \"\"\"Reads the entire JSON file content, returning an empty structure if not found.\"\"\"\n        if not self._path.exists():\n            return {self.DEFAULT_REPO_KEY: {}}\n        try:\n            with open(self._path, 'r', encoding='utf-8') as f:\n                data = json.load(f)\n                if not isinstance(data, dict):\n                    return {self.DEFAULT_REPO_KEY: {}}\n                return data\n        except json.JSONDecodeError as e:\n            raise RepositoryError(f\"Error decoding JSON from repository file '{self._path}': {e}\")\n        except OSError as e:\n            raise RepositoryError(f\"Error reading repository file '{self._path}': {e}\")\n\n    def _write_data(self, data: Dict[str, Any]) -> None:\n        \"\"\"Writes data to the JSON file atomically.\"\"\"\n        temp_path = self._path.with_suffix(self._path.suffix + self.ATOMIC_WRITE_SUFFIX)\n        try:\n            self._path.parent.mkdir(parents=True, exist_ok=True)\n            with open(temp_path, 'w', encoding='utf-8') as f:\n                json.dump(data, f, indent=2)\n            os.replace(temp_path, self._path)\n        except OSError as e:\n            if temp_path.exists():\n                os.remove(temp_path)\n            raise RepositoryError(f\"Error writing to repository file '{self._path}': {e}\")\n        except Exception as e:\n            if temp_path.exists():\n                os.remove(temp_path)\n            raise RepositoryError(f\"Unexpected error during atomic write to '{self._path}': {e}\")\n\n    def save(self, key: str, payload: Dict[str, Any]) -> None:\n        \"\"\"Saves a payload associated with a given key to the JSON file.\"\"\"\n        all_data = self._read_data()\n        if self.DEFAULT_REPO_KEY not in all_data or not isinstance(all_data[self.DEFAULT_REPO_KEY], dict):\n            all_data[self.DEFAULT_REPO_KEY] = {}\n        all_data[self.DEFAULT_REPO_KEY][key] = payload\n        self._write_data(all_data)\n\n    def load(self, key: str) -> Optional[Dict[str, Any]]:\n        \"\"\"Loads a payload for a given key from the JSON file.\"\"\"\n        all_data = self._read_data()\n        if self.DEFAULT_REPO_KEY in all_data and isinstance(all_data[self.DEFAULT_REPO_KEY], dict):\n            return all_data[self.DEFAULT_REPO_KEY].get(key)\n        return None\nclass FrequencyService:\n    \"\"\"Provides core business logic for computing and persisting element frequencies.\"\"\"\n    def __init__(self, flattener: Flattener, repository: Optional[Repository] = None) -> None:\n        self._flattener = flattener\n        self._repo = repository\n\n    def compute_frequencies(self, data: List[List[Hashable]]) -> Dict[Hashable, int]:\n        \"\"\"Computes the frequency of each hashable element in a flattened list.\"\"\"\n        counts: Dict[Hashable, int] = {}\n        for item in self._flattener.flatten(data):\n            try:\n                counts[item] = counts.get(item, 0) + 1\n            except TypeError as e:\n                raise InvalidInputError(\"Elements must be hashable.\") from e\n        return counts\n\n    def compute_and_persist(self, data: List[List[Hashable]], key: str) -> FrequencyResult:\n        \"\"\"Computes frequencies, adds metadata, and optionally persists the result.\"\"\"\n        result = self.compute_frequencies(data)\n        meta = {\"timestamp\": datetime.utcnow().isoformat(timespec='seconds') + \"Z\", \"input_count\": sum(result.values())}\n        dto = FrequencyResult(result=result, meta=meta)\n        if self._repo:\n            self._repo.save(key, dto.to_dict())\n        return dto\nDEFAULT_STRICT: bool = True\nDEFAULT_PERSIST: bool = False\nDEFAULT_REPO_PATH: Path = Path('frequency_results.json')\ndef frequency_lists(data: list[list[object]]) -> dict:\n    \"\"\"\n    Finds the frequency of each element in a flattened list of lists.\n    Returns the frequencies in a dictionary.\n    \"\"\"\n    fl = Flattener(strict=DEFAULT_STRICT)\n    repo = FileRepository(DEFAULT_REPO_PATH) if DEFAULT_PERSIST else None\n    svc = FrequencyService(fl, repository=repo)\n    return svc.compute_frequencies(data)"}
{"task_id": "Mbpp/101", "solution": "from typing import Sequence, Any\ndef kth_element(arr: Sequence[Any], k: int) -> Any:\n    \"\"\"\n    Finds the kth element in the given array using 1-based indexing.\n    Validates array and index, then returns the element.\n    \"\"\"\n\n    class InvalidArrayError(Exception):\n        \"\"\"Raised when the input array is invalid or empty.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n\n    class InvalidIndexError(Exception):\n        \"\"\"Raised when the requested index k is invalid or out of range.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n\n    MIN_INDEX: int = 1\n\n    class ArrayValidator:\n        \"\"\"Validates the input array.\"\"\"\n        def validate(self, arr: Sequence[Any]) -> None:\n            if not isinstance(arr, (list, tuple, range)):\n                raise InvalidArrayError(\"Input must be a sequence (list, tuple, range).\")\n            if not arr:\n                raise InvalidArrayError(\"Input array cannot be empty.\")\n\n    class IndexValidator:\n        \"\"\"Validates the 1-based index k.\"\"\"\n        def validate(self, k: int, arr_len: int) -> None:\n            if not isinstance(k, int):\n                raise InvalidIndexError(\"Index 'k' must be an integer.\")\n            if k < MIN_INDEX or k > arr_len:\n                raise InvalidIndexError(f\"Index 'k' ({k}) is out of 1-based range [1, {arr_len}].\")\n\n    def one_based_to_zero_based(k: int) -> int:\n        \"\"\"Converts a 1-based index to a 0-based index.\"\"\"\n        return k - 1\n\n    class KthFinderService:\n        \"\"\"Core business logic to fetch the k-th element.\"\"\"\n        def __init__(self, array_validator: ArrayValidator, index_validator: IndexValidator) -> None:\n            self._array_validator = array_validator\n            self._index_validator = index_validator\n\n        def kth_element_internal(self, arr: Sequence[Any], k: int) -> Any:\n            \"\"\"Performs validation and retrieves the element.\"\"\"\n            self._array_validator.validate(arr)\n            self._index_validator.validate(k, len(arr))\n            idx = one_based_to_zero_based(k)\n            return arr[idx]\n\n    array_validator_instance = ArrayValidator()\n    index_validator_instance = IndexValidator()\n    service = KthFinderService(array_validator_instance, index_validator_instance)\n    return service.kth_element_internal(arr, k)"}
{"task_id": "Mbpp/105", "solution": "def count(values: list) -> int:\n    \"\"\"Counts the number of strict True boolean values in a list.\"\"\"\n    return sum(1 for v in values if type(v) is bool and v is True)"}
{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Computes the Eulerian number a(n, m) using an iterative dynamic programming approach.\n    The function directly implements the recurrence relation:\n    a(n,m) = (n - m) * a(n-1, m-1) + (m+1) * a(n-1, m), with base case a(0,0) = 1.\n    \"\"\"\n    if n == 0:\n        return 1 if m == 0 else 0\n\n    # dp[i][j] stores the Eulerian number a(i, j)\n    # dp is a list of lists, where dp[i] contains values for a(i, m) for m from 0 to i-1.\n    dp = []\n    # Base case for n=0: a(0,0)=1\n    dp.append([1])\n\n    for i in range(1, n + 1):\n        # For a given n=i, m can range from 0 to i-1, so the row needs 'i' elements.\n        current_row = [0] * i\n        for j in range(i):\n            # Recurrence: a(i, j) = (i - j) * a(i-1, j-1) + (j + 1) * a(i-1, j)\n            \n            # The a(i-1, j-1) term: only valid if j-1 >= 0\n            left_term = (i - j) * (dp[i-1][j-1] if j - 1 >= 0 else 0)\n            \n            # The a(i-1, j) term: only valid if j is within bounds of dp[i-1] (0 to i-2)\n            right_term = (j + 1) * (dp[i-1][j] if j < len(dp[i-1]) else 0)\n            \n            current_row[j] = left_term + right_term\n        dp.append(current_row)\n\n    return dp[n][m]"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(snake_case_string: str) -> str:\n    \"\"\"Converts a snake_case string to a CamelCase string.\"\"\"\n\n    def _split_snake(value: str) -> list[str]:\n        # Trim leading/trailing underscores and split the string into segments.\n        # Multiple underscores are treated as a single separator, and empty segments are ignored.\n        trimmed = value.strip('_')\n        parts = [p for p in trimmed.split('_') if p]\n        return parts\n\n    def _capitalize_segment(segment: str) -> str:\n        # Capitalizes the first letter of a single segment.\n        if not segment:\n            return ''\n        return segment[0].upper() + segment[1:]\n\n    segments = _split_snake(snake_case_string)\n    camel_case_segments = [_capitalize_segment(segment) for segment in segments]\n    return ''.join(camel_case_segments)"}
{"task_id": "Mbpp/104", "solution": "from typing import Sequence, List\ndef sort_sublists(data: Sequence[Sequence[str]]) -> List[List[str]]:\n    \"\"\"\n    Sorts each sublist of strings in a given list of lists lexicographically.\n    Returns a new list of lists without mutating the original input data.\n    \"\"\"\n    # Create a new list of lists, ensuring each inner list is a mutable copy\n    # so that sorting them in-place does not affect the original input sequences.\n    sorted_data = [list(sub) for sub in data]\n    \n    # Iterate through the newly created mutable inner lists and sort each one.\n    for sublist in sorted_data:\n        sublist.sort()\n        \n    return sorted_data"}
