{"task_id": "HumanEval/1", "solution": "```python\nfrom typing import List\n\n# Helper function to remove spaces from the input string.\ndef _clean_string(input_str: str) -> str:\n    \"\"\"Removes all space characters from the input string.\"\"\"\n    return input_str.replace(' ', '')\n\n# Helper function to check if a parenthesis string is balanced.\ndef _is_balanced(s: str) -> bool:\n    \"\"\"Checks if a given string of parentheses is balanced.\"\"\"\n    balance = 0\n    for char in s:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0\n\n# Helper function to find distinct, non-nested, balanced groups.\ndef _find_distinct_balanced_groups(cleaned_string: str) -> List[str]:\n    \"\"\"Identifies and extracts top-level, distinct, and balanced groups of parentheses.\"\"\"\n    groups = []\n    current_group_start_index = -1\n    balance = 0\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            if balance == 0:  # Mark the beginning of a new top-level group\n                current_group_start_index = i\n            balance += 1\n        elif char == ')':\n            balance -= 1\n            if balance == 0:  # The current top-level group has closed\n                groups.append(cleaned_string[current_group_start_index : i + 1])\n                current_group_start_index = -1  # Reset for the next potential group\n    return groups\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses.\n    It separates distinct, balanced groups, ignoring spaces.\n    \"\"\"\n\n    cleaned_string = _clean_string(paren_string)\n    identified_groups = _find_distinct_balanced_groups(cleaned_string)\n\n    return identified_groups\n```"}
{"task_id": "HumanEval/0", "solution": "```python\nfrom typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than given threshold.\n    Compares all distinct pairs to find if their absolute difference is less than the threshold.\n    \"\"\"\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False\n\n```"}
{"task_id": "HumanEval/2", "solution": "```python\nimport math\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    # Calculate the integer part, as specified in domain.Number.get_integer_part.\n    integer_part_value = math.floor(number)\n\n    # Calculate the decimal part, as specified in domain.Number.get_decimal_part.\n    decimal_part_value = number - integer_part_value\n\n    # Handle potential floating-point inaccuracies based on the design's specification.\n    if abs(decimal_part_value) < 1e-9 and number == round(number):\n        decimal_part_value = 0.0\n    elif decimal_part_value >= 1.0:\n        # This clause addresses potential edge cases as mentioned in the design.\n        decimal_part_value -= 1.0\n\n    return decimal_part_value\n```"}
{"task_id": "HumanEval/1", "solution": "```python\nfrom typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n\n    class ParenthesisString:\n        \"\"\"Manages the input string, providing a cleaned version without spaces.\"\"\"\n        def __init__(self, raw_input_str: str):\n            self.raw_input = raw_input_str\n            self.cleaned_input = self.raw_input.replace(\" \", \"\")\n\n        def get_cleaned_input(self) -> str:\n            return self.cleaned_input\n\n    class Group:\n        \"\"\"Represents a single identified parenthesis group with its content and balance status.\"\"\"\n        def __init__(self, content_str: str):\n            self.content = content_str\n            self.is_balanced = False\n\n        def get_content(self) -> str:\n            return self.content\n\n        def set_balanced_status(self, status: bool):\n            self.is_balanced = status\n\n        def is_group_balanced(self) -> bool:\n            return self.is_balanced\n\n    class ResultList:\n        \"\"\"Collects and manages the list of separated, balanced parenthesis groups.\"\"\"\n        def __init__(self):\n            self.separated_groups: List[Group] = []\n\n        def add_group(self, group: Group):\n            # Per design, only balanced groups are added, so `group.is_group_balanced()` is expected to be True.\n            self.separated_groups.append(group)\n\n        def get_string_list(self) -> List[str]:\n            # Returns content of all stored groups, as they are already validated as balanced.\n            return [group.get_content() for group in self.separated_groups]\n\n    def _is_balanced(s: str) -> bool:\n        \"\"\"Checks if a given string of parentheses is properly balanced.\"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    # 1. Input Cleaning\n    paren_str_manager = ParenthesisString(paren_string)\n    cleaned_input = paren_str_manager.get_cleaned_input()\n\n    # 3. Result Aggregation\n    result_list = ResultList()\n\n    # 2. Group Identification and Separation\n    balance_count = 0\n    start_index = 0\n\n    for i, char in enumerate(cleaned_input):\n        if char == '(':\n            balance_count += 1\n        elif char == ')':\n            balance_count -= 1\n\n        # When the overall balance count returns to zero, it signifies a potential top-level group.\n        if balance_count == 0:\n            potential_group_str = cleaned_input[start_index : i + 1]\n            # Validate the internal structure of the potential group.\n            if _is_balanced(potential_group_str):\n                group = Group(potential_group_str)\n                group.set_balanced_status(True)\n                result_list.add_group(group)\n            # Reset start_index for the next potential top-level group.\n            start_index = i + 1\n\n    # 4. Output Generation\n    return result_list.get_string_list()\n```"}
{"task_id": "HumanEval/3", "solution": "```python\nfrom typing import List\n\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"Detects if a bank account balance falls below zero.\n    The account starts with zero balance and processes a list of operations.\"\"\"\n    balance = 0\n    for operation in operations:\n        balance += operation\n        if balance < 0:\n            return True\n    return False\n```"}
{"task_id": "HumanEval/5", "solution": "from typing import List\n\n\ndef intersperse(numbers: List[int], delimiter: int) -> List[int]:\n    \"\"\" Insert a number 'delimiter' between every two consecutive elements of input list `numbers`\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimiter)\n    return result"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"Calculates the Mean Absolute Deviation around the mean for a list of floating-point numbers.\n    MAD is the average absolute difference between each element and the mean.\n    \"\"\"\n    # Calculate the mean of the numbers.\n    mean_val = sum(numbers) / len(numbers)\n\n    # Calculate the absolute deviations from the mean for each number.\n    deviations = [abs(x - mean_val) for x in numbers]\n\n    # Calculate the mean of these absolute deviations.\n    mad = sum(deviations) / len(deviations)\n\n    return mad```"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    MAD = average | x - x_mean |\n    \"\"\"\n    mean_val = sum(numbers) / len(numbers)\n    absolute_diffs = [abs(x - mean_val) for x in numbers]\n    mad = sum(absolute_diffs) / len(absolute_diffs)\n    return mad"}
{"task_id": "HumanEval/5", "solution": "from typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers`.\n    Returns an empty list if the input `numbers` list is empty.\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/6", "solution": "```python\nfrom typing import List\n\ndef _calculate_group_nesting_level(group_string: str) -> int:\n    \"\"\"Calculates the deepest nesting level for a single group of parentheses.\n    It tracks current and maximum depth by iterating through the string.\n    \"\"\"\n    current_nesting = 0\n    max_nesting = 0\n    for char in group_string:\n        if char == '(':\n            current_nesting += 1\n            max_nesting = max(max_nesting, current_nesting)\n        elif char == ')':\n            current_nesting -= 1\n    return max_nesting\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    result_list = []\n    groups = paren_string.split(' ')\n    for group_string in groups:\n        if group_string: # Handle potential empty strings from multiple spaces\n            nesting_level = _calculate_group_nesting_level(group_string)\n            result_list.append(nesting_level)\n    return result_list\n```"}
