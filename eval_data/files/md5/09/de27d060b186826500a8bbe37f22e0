{"task_id": "HumanEval/6", "solution": "```python\nfrom typing import List\n\n\nclass ParenGroup:\n    \"\"\"Encapsulates a single group of parentheses.\n    Provides logic to calculate its deepest nesting level.\n    \"\"\"\n    def __init__(self, group_string: str):\n        \"\"\"Initializes a ParenGroup with its string value.\"\"\"\n        self.value = group_string\n        self._deepest_nesting_level = 0\n\n    def calculate_nesting_level(self) -> int:\n        \"\"\"Computes and returns the deepest nesting level for the group's string value.\"\"\"\n        current_depth = 0\n        max_depth = 0\n        for char in self.value:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n        self._deepest_nesting_level = max_depth\n        return self._deepest_nesting_level\n\n    def get_deepest_nesting_level(self) -> int:\n        \"\"\"Returns the stored deepest nesting level.\"\"\"\n        return self._deepest_nesting_level\n\n\nclass ParenStringProcessor:\n    \"\"\"Manages overall processing of the input string.\n    Splits string into groups and coordinates nesting level calculations.\n    \"\"\"\n    def __init__(self, paren_string: str):\n        \"\"\"Initializes the processor with the raw input string.\"\"\"\n        self._raw_input = paren_string\n\n    def process(self) -> List[int]:\n        \"\"\"Splits the input into groups, processes each, and collects nesting levels.\"\"\"\n        group_strings = self._raw_input.split(' ')\n        nesting_levels = []\n        for group_string in group_strings:\n            if group_string:  # Ensure not processing empty strings from multiple spaces\n                paren_group_instance = ParenGroup(group_string)\n                deepest_level = paren_group_instance.calculate_nesting_level()\n                nesting_levels.append(deepest_level)\n        return nesting_levels\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    processor = ParenStringProcessor(paren_string)\n    result = processor.process()\n    return result\n```"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    current_sum = 0\n    current_product = 1\n    for num in numbers:\n        current_sum += num\n        current_product *= num\n\n    return (current_sum, current_product)"}
