{"task_id": "HumanEval/122", "solution": "def _validate_inputs(arr, k):\n    \"\"\"Checks if arr and k meet specified length and range constraints. Raises ValueError on failure.\"\"\"\n    if not (1 <= len(arr) <= 100):\n        raise ValueError(\"Length of arr must be between 1 and 100, inclusive.\")\n    if not (1 <= k <= len(arr)):\n        raise ValueError(\"k must be between 1 and len(arr), inclusive.\")\n\ndef _filter_k_elements(arr, k):\n    \"\"\"Returns the first k elements from the input array arr.\"\"\"\n    return arr[:k]\n\ndef _has_at_most_two_digits(number):\n    \"\"\"Checks if a number has an absolute value less than 100. Returns True if it does, False otherwise.\"\"\"\n    return -100 < number < 100\n\ndef _sum_elements(elements):\n    \"\"\"Calculates the sum of a list of numbers.\"\"\"\n    return sum(elements)\n\ndef add_elements(arr, k):\n    \"\"\"Calculates the sum of elements with at most two digits from the first k elements of arr, after validating inputs.\"\"\"\n    _validate_inputs(arr, k)\n\n    first_k_elements = _filter_k_elements(arr, k)\n\n    two_digit_elements = []\n    for element in first_k_elements:\n        if _has_at_most_two_digits(element):\n            two_digit_elements.append(element)\n\n    total_sum = _sum_elements(two_digit_elements)\n    return total_sum"}
{"task_id": "HumanEval/123", "solution": "```python\ndef _generate_collatz_sequence(start_n: int) -> list[int]:\n    \"\"\"\n    Generates the Collatz sequence starting from `start_n`.\n    The sequence terminates when it reaches 1.\n    \"\"\"\n    sequence = [start_n]\n    current = start_n\n    while current != 1:\n        if current % 2 == 0:\n            current = current // 2\n        else:\n            current = 3 * current + 1\n        sequence.append(current)\n    return sequence\n\ndef _get_odd_numbers(sequence: list[int]) -> list[int]:\n    \"\"\"\n    Extracts all odd numbers from the given sequence.\n    It iterates through the sequence and filters odd values.\n    \"\"\"\n    return [num for num in sequence if num % 2 != 0]\n\ndef _sort_numbers(numbers: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of numbers in increasing order.\n    Returns a new list with sorted elements.\n    \"\"\"\n    return sorted(numbers)\n\ndef get_odd_collatz(n: int) -> list[int]:\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n\n    The Collatz conjecture is a conjecture in mathematics that concerns a sequence defined\n    as follows: start with any positive integer n. Then each term is obtained from the\n    previous term as follows: if the previous term is even, the next term is one half of\n    the previous term. If the previous term is odd, the next term is 3 times the previous\n    term plus 1. The conjecture is that no matter what value of n, the sequence will always reach 1.\n\n    Note:\n        1. Collatz(1) is [1].\n        2. returned list sorted in increasing order.\n\n    For example:\n    get_odd_collatz(5) returns [1, 5] # The collatz sequence for 5 is [5, 16, 8, 4, 2, 1], so the odd numbers are only 1, and 5.\n    \"\"\"\n    # According to the problem description, n is a positive integer.\n    # No explicit input validation for n <= 0 or n not being an int, as per prompt's focus.\n\n    if n == 1:\n        return [1]\n\n    collatz_sequence = _generate_collatz_sequence(n)\n    odd_numbers = _get_odd_numbers(collatz_sequence)\n    sorted_odd_numbers = _sort_numbers(odd_numbers)\n\n    return sorted_odd_numbers\n```"}
{"task_id": "HumanEval/123", "solution": "```python\nclass PositiveInteger:\n    \"\"\"\n    A simple wrapper class to hold a positive integer value.\n    \"\"\"\n    def __init__(self, n: int):\n        self._value = n\n\n    def get_value(self) -> int:\n        \"\"\"Returns the integer value.\"\"\"\n        return self._value\n\n\nclass Number:\n    \"\"\"\n    Represents a single number in the Collatz sequence and provides related operations.\n    \"\"\"\n    def __init__(self, val: int):\n        self._value = val\n\n    def get_value(self) -> int:\n        \"\"\"Returns the integer value of this number.\"\"\"\n        return self._value\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the number is odd.\"\"\"\n        return self._value % 2 != 0\n\n    def is_even(self) -> bool:\n        \"\"\"Checks if the number is even.\"\"\"\n        return self._value % 2 == 0\n\n    def get_next_collatz_term(self) -> 'Number':\n        \"\"\"Calculates and returns the next term in the Collatz sequence as a new Number object.\"\"\"\n        if self.is_even():\n            return Number(self._value // 2)\n        else:\n            return Number(self._value * 3 + 1)\n\n\nclass OddNumbersList:\n    \"\"\"\n    Manages the collection of odd numbers found in the Collatz sequence.\n    \"\"\"\n    def __init__(self):\n        self._odd_numbers: list[int] = []\n\n    def add(self, number: Number):\n        \"\"\"Adds the integer value of a Number object to the list if not already present.\"\"\"\n        if number.get_value() not in self._odd_numbers:\n            self._odd_numbers.append(number.get_value())\n\n    def sort_ascending(self):\n        \"\"\"Sorts the internal list of odd numbers in increasing order.\"\"\"\n        self._odd_numbers.sort()\n\n    def get_list(self) -> list[int]:\n        \"\"\"Returns the sorted list of odd numbers.\"\"\"\n        return self._odd_numbers\n\n\nclass CollatzSequenceGenerator:\n    \"\"\"\n    Encapsulates the logic for generating the Collatz sequence and extracting odd numbers.\n    \"\"\"\n    def generate_and_extract_odd(self, start: PositiveInteger) -> OddNumbersList:\n        \"\"\"Generates the Collatz sequence from 'start' and collects all odd numbers.\"\"\"\n        odd_list = OddNumbersList()\n        current_val = start.get_value()\n\n        while True:\n            current_num_obj = Number(current_val)\n            if current_num_obj.is_odd():\n                odd_list.add(current_num_obj)\n\n            if current_val == 1:\n                break\n\n            current_val = current_num_obj.get_next_collatz_term().get_value()\n\n        odd_list.sort_ascending()\n        return odd_list\n\n\ndef get_odd_collatz(n: int) -> list[int]:\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in Collatz sequence.\n    The returned list contains odd numbers from the Collatz sequence of n, sorted in increasing order.\n    \"\"\"\n    if n == 1:\n        return [1]\n\n    positive_n = PositiveInteger(n)\n    generator = CollatzSequenceGenerator()\n    odd_list_obj = generator.generate_and_extract_odd(positive_n)\n    return odd_list_obj.get_list()\n\n```"}
{"task_id": "HumanEval/124", "solution": "```python\ndef _is_not_empty(date_str: str) -> bool:\n    \"\"\"Checks if the date string is not empty.\"\"\"\n    return bool(date_str)\n\n\ndef _is_format_valid(date_str: str) -> bool:\n    \"\"\"Validates the date string adheres to the mm-dd-yyyy format.\"\"\"\n    if len(date_str) != 10 or date_str.count('-') != 2:\n        return False\n\n    parts = date_str.split('-')\n    if not (len(parts[0]) == 2 and parts[0].isdigit()):\n        return False\n    if not (len(parts[1]) == 2 and parts[1].isdigit()):\n        return False\n    if not (len(parts[2]) == 4 and parts[2].isdigit()):\n        return False\n\n    return True\n\n\ndef _parse_date_components(date_str: str) -> tuple[int, int, int]:\n    \"\"\"Parses the date string into month, day, and year integers.\"\"\"\n    parts = date_str.split('-')\n    month = int(parts[0])\n    day = int(parts[1])\n    year = int(parts[2])\n    return (month, day, year)\n\n\ndef _is_month_valid(month: int) -> bool:\n    \"\"\"Checks if the month value is between 1 and 12 (inclusive).\"\"\"\n    return 1 <= month <= 12\n\n\ndef _is_day_valid(month: int, day: int) -> bool:\n    \"\"\"Validates the day value is appropriate for the given month.\"\"\"\n    if month in {1, 3, 5, 7, 8, 10, 12}:\n        return 1 <= day <= 31\n    elif month in {4, 6, 9, 11}:\n        return 1 <= day <= 30\n    # Month 2 (February) is the only remaining valid month here.\n    return 1 <= day <= 29\n\n\ndef valid_date(date: str) -> bool:\n    \"\"\"Validates a given date string against specific format and calendar rules.\n    Returns True if valid, False otherwise.\"\"\"\n\n    if not _is_not_empty(date):\n        return False\n\n    if not _is_format_valid(date):\n        return False\n\n    month, day, year = _parse_date_components(date)\n\n    if not _is_month_valid(month):\n        return False\n\n    if not _is_day_valid(month, day):\n        return False\n\n    return True\n```"}
{"task_id": "HumanEval/119", "solution": "```python\ndef _is_balanced(s: str) -> bool:\n    \"\"\"Checks if a string `s` is a balanced parentheses string.\n    Returns True if balanced, False otherwise.\n    \"\"\"\n    balance = 0\n    for char in s:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0\n\ndef match_parens(lst: list[str]) -> str:\n    \"\"\"Checks if concatenating two strings from `lst` in any order forms a balanced parentheses string.\n    Returns 'Yes' if possible, 'No' otherwise.\n    \"\"\"\n    s1, s2 = lst[0], lst[1]\n\n    if _is_balanced(s1 + s2):\n        return 'Yes'\n\n    if _is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'\n```"}
{"task_id": "HumanEval/125", "solution": "def _has_whitespace(text: str) -> bool:\n    \"\"\"Checks if the text contains any whitespace characters.\"\"\"\n    return any(c.isspace() for c in text)\n\ndef _has_commas(text: str) -> bool:\n    \"\"\"Checks if the text contains any comma characters.\"\"\"\n    return ',' in text\n\ndef _split_by_whitespace(text: str) -> list[str]:\n    \"\"\"Splits the text into words using whitespace as a delimiter.\"\"\"\n    return text.split()\n\ndef _split_by_commas(text: str) -> list[str]:\n    \"\"\"Splits the text into words using commas as a delimiter.\"\"\"\n    return text.split(',')\n\ndef _count_odd_ordered_lowercase_letters(text: str) -> int:\n    \"\"\"Counts lowercase letters with an odd 0-indexed alphabetical order.\"\"\"\n    count = 0\n    for char in text:\n        if 'a' <= char <= 'z':\n            order = ord(char) - ord('a')\n            if order % 2 != 0:\n                count += 1\n    return count\n\ndef split_words(txt: str) -> list[str] | int:\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3\n    '''\n    if _has_whitespace(txt):\n        return _split_by_whitespace(txt)\n    elif _has_commas(txt):\n        return _split_by_commas(txt)\n    else:\n        return _count_odd_ordered_lowercase_letters(txt)```"}
{"task_id": "HumanEval/125", "solution": "def _contains_whitespace(txt: str) -> bool:\n    \"\"\"Checks if the input string contains any whitespace characters.\"\"\"\n    for char in txt:\n        if char.isspace():\n            return True\n    return False\n\ndef _contains_comma(txt: str) -> bool:\n    \"\"\"Checks if the input string contains any comma characters.\"\"\"\n    return ',' in txt\n\ndef _split_on_whitespace(txt: str) -> list[str]:\n    \"\"\"Splits the input string by whitespace characters.\"\"\"\n    return txt.split()\n\ndef _split_on_comma(txt: str) -> list[str]:\n    \"\"\"Splits the input string by comma characters.\"\"\"\n    return txt.split(',')\n\ndef _get_alphabetical_order(char: str) -> int:\n    \"\"\"Calculates the 0-indexed alphabetical order of a given lowercase character.\"\"\"\n    return ord(char) - ord('a')\n\ndef _count_odd_ordered_lowercase_letters(txt: str) -> int:\n    \"\"\"Counts lowercase letters with an odd alphabetical order in the string.\"\"\"\n    count = 0\n    for char in txt:\n        if 'a' <= char <= 'z': # Check for lowercase letter\n            order = _get_alphabetical_order(char)\n            if order % 2 != 0:\n                count += 1\n    return count\n\ndef split_words(txt: str) -> 'list[str] | int':\n    \"\"\"\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',', if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    \"\"\"\n    if _contains_whitespace(txt):\n        return _split_on_whitespace(txt)\n    elif _contains_comma(txt):\n        return _split_on_comma(txt)\n    else:\n        return _count_odd_ordered_lowercase_letters(txt)"}
{"task_id": "HumanEval/126", "solution": "```python\nimport collections\n\ndef is_sorted(lst):\n    \"\"\"\n    Checks if a list of non-negative integers is sorted in ascending order\n    and if no number appears more than twice.\n    \"\"\"\n    # Check for duplicate constraint (no number appears more than twice).\n    counts = collections.Counter(lst)\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    # Check if the list is sorted in ascending order.\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    return True\n```"}
{"task_id": "HumanEval/115", "solution": "```python\nimport math\n\ndef _calculate_water_in_well(well_row):\n    \"\"\"Calculates total water units present in a single well row.\n    It sums the '1's representing water units.\"\"\"\n    return sum(well_row)\n\ndef _calculate_lowering_operations_for_well(water_units, capacity):\n    \"\"\"Calculates bucket lowering operations required for a well using ceiling division.\n    Returns 0 if no water is present.\"\"\"\n    if water_units == 0:\n        return 0\n    return math.ceil(water_units / capacity)\n\ndef max_fill(grid, capacity):\n    \"\"\"\n    Calculates the total bucket lowering operations needed to empty all wells.\n    It sums operations for each well based on its water content and bucket capacity.\n    \"\"\"\n    total_lowers = 0\n    for well_row in grid:\n        water_units_in_well = _calculate_water_in_well(well_row)\n        lowers_for_current_well = _calculate_lowering_operations_for_well(water_units_in_well, capacity)\n        total_lowers += lowers_for_current_well\n    return total_lowers\n```"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes multiplied by the product of signs for integers in an array.\n    Returns None for an empty array.\n    \"\"\"\n\n    def _get_sign(number: int) -> int:\n        \"\"\"Returns 1 for positive, -1 for negative, and 0 for zero.\"\"\"\n        if number > 0:\n            return 1\n        elif number < 0:\n            return -1\n        else:\n            return 0\n\n    def _get_magnitude(number: int) -> int:\n        \"\"\"Returns the absolute value of a number.\"\"\"\n        return abs(number)\n\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for number in arr:\n        product_of_signs *= _get_sign(number)\n        sum_of_magnitudes += _get_magnitude(number)\n\n    final_result = sum_of_magnitudes * product_of_signs\n    return final_result"}
{"task_id": "HumanEval/127", "solution": "```python\ndef intersection(interval1, interval2):\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two\n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n\n\n    [input/output] samples:\n    intersection((1, 2), (2, 3)) ==> \"NO\"\n    intersection((-1, 1), (0, 4)) ==> \"NO\"\n    intersection((-3, -1), (-5, 5)) ==> \"YES\"\n    \"\"\"\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if a given integer n is a prime number.\n        Returns True if n is prime, False otherwise.\n        \"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    intersection_start = max(start1, start2)\n    intersection_end = min(end1, end2)\n\n    if intersection_start > intersection_end:\n        length = 0\n    else:\n        length = intersection_end - intersection_start\n\n    if is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\"\n\n```"}
{"task_id": "HumanEval/127", "solution": "```python\ndef is_prime(n: int) -> bool:\n    \"\"\"Checks if a given integer is a prime number.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    # Check for odd divisors from 3 up to the square root of n.\n    # This loop avoids calling math.sqrt to adhere to strict definition requirements.\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef intersection(interval1: tuple[int, int], interval2: tuple[int, int]) -> str:\n    \"\"\"Determines if the intersection of two closed intervals has a prime length.\"\"\"\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    intersect_start = max(start1, start2)\n    intersect_end = min(end1, end2)\n\n    if intersect_start > intersect_end:\n        return \"NO\"\n\n    intersection_length = intersect_end - intersect_start\n\n    if is_prime(intersection_length):\n        return \"YES\"\n    else:\n        return \"NO\"\n```\n"}
{"task_id": "HumanEval/128", "solution": "```python\nfrom typing import List\n\ndef prod_signs(arr: List[int]) -> int | None:\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n\n    Example:\n    >>> prod_signs([1, 2, 2, -4]) == -9\n    >>> prod_signs([0, 1]) == 0\n    >>> prod_signs([]) == None\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for num in arr:\n        # Determine the sign of the current number\n        if num > 0:\n            sign = 1\n        elif num < 0:\n            sign = -1\n        else:\n            sign = 0\n        product_of_signs *= sign\n\n        # Add the magnitude of the current number to the sum\n        sum_of_magnitudes += abs(num)\n\n    return sum_of_magnitudes * product_of_signs\n```"}
{"task_id": "HumanEval/124", "solution": "```python\ndef _parse_date_components(date_string: str) -> tuple[int, int, int] | None:\n    \"\"\"Parses a date string in 'mm-dd-yyyy' format into month, day, and year integers.\n    Returns (month, day, year) or None if parsing fails.\"\"\"\n    if len(date_string) != 10 or date_string[2] != '-' or date_string[5] != '-':\n        return None\n\n    try:\n        month = int(date_string[0:2])\n        day = int(date_string[3:5])\n        year = int(date_string[6:10])\n    except ValueError:\n        return None\n\n    return (month, day, year)\n\ndef _is_valid_month(month: int) -> bool:\n    \"\"\"Validates if the month is within the valid range of 1 to 12.\"\"\"\n    return 1 <= month <= 12\n\ndef _is_valid_day(day: int, month: int) -> bool:\n    \"\"\"Validates if the day is valid for the given month, considering fixed day ranges.\"\"\"\n    if month in {1, 3, 5, 7, 8, 10, 12}: # Months with 31 days\n        return 1 <= day <= 31\n    elif month in {4, 6, 9, 11}: # Months with 30 days\n        return 1 <= day <= 30\n    elif month == 2: # February (29 days, no leap year logic as per spec)\n        return 1 <= day <= 29\n    return False\n\ndef valid_date(date: str) -> bool:\n    \"\"\"Validates a given date string and returns True if the date is valid, otherwise False.\n    The date must be in 'mm-dd-yyyy' format and adhere to month/day ranges.\"\"\"\n\n    if not date: # Validate that the input date string is not empty.\n        return False\n\n    components = _parse_date_components(date)\n    if components is None: # Validate that the date string is in the format 'mm-dd-yyyy'.\n        return False\n\n    month, day, year = components\n\n    if not _is_valid_month(month): # Validate that the month is between 1 and 12.\n        return False\n\n    if not _is_valid_day(day, month): # Validate day ranges based on the month.\n        return False\n\n    return True # All validation rules are satisfied.\n```\n"}
{"task_id": "HumanEval/131", "solution": "```python\ndef digits(n: int) -> int:\n    \"\"\"Given a positive integer n, return the product of its odd digits.\n    Returns 0 if all digits are even, and 1 if there is exactly one odd digit.\n    \"\"\"\n    product_of_odd_digits = 1\n    odd_digit_count = 0\n\n    # Iterate through the digits of n by converting it to a string.\n    for char_digit in str(n):\n        digit = int(char_digit)\n        if digit % 2 != 0:  # Check if the digit is odd.\n            product_of_odd_digits *= digit\n            odd_digit_count += 1\n\n    # Apply the specific return rules based on the count of odd digits.\n    if odd_digit_count == 0:\n        return 0\n    elif odd_digit_count == 1:\n        return 1\n    else:\n        return product_of_odd_digits\n```"}
{"task_id": "HumanEval/129", "solution": "```python\ndef minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k,\n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n\n    class Cell:\n        \"\"\"Represents a cell in the grid with its value and coordinates.\"\"\"\n        def __init__(self, value, row, col):\n            self.value = value\n            self.row = row\n            self.col = col\n\n        def get_value(self):\n            return self.value\n\n        def get_coordinates(self):\n            return (self.row, self.col)\n\n        def getNeighbors(self, grid_obj):\n            \"\"\"Returns a list of valid adjacent Cell objects.\"\"\"\n            neighbors = []\n            # Possible movements: up, down, left, right\n            moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n            for dr, dc in moves:\n                new_row, new_col = self.row + dr, self.col + dc\n                if grid_obj.isValid(new_row, new_col):\n                    neighbors.append(grid_obj.get_cell(new_row, new_col))\n            return neighbors\n\n    class Grid:\n        \"\"\"Manages the 2D grid structure and provides access/validation methods.\"\"\"\n        def __init__(self, grid_values):\n            self.N = len(grid_values)\n            self.cells = [[None for _ in range(self.N)] for _ in range(self.N)]\n            for r in range(self.N):\n                for c in range(self.N):\n                    self.cells[r][c] = Cell(grid_values[r][c], r, c)\n\n        def getValue(self, row, col):\n            return self.cells[row][col].get_value()\n\n        def isValid(self, row, col):\n            \"\"\"Checks if coordinates are within grid boundaries.\"\"\"\n            return 0 <= row < self.N and 0 <= col < self.N\n\n        def get_cell(self, row, col):\n            return self.cells[row][col]\n\n        def get_all_cells(self):\n            \"\"\"Returns a flat list of all Cell objects in the grid.\"\"\"\n            all_cells = []\n            for r in range(self.N):\n                for c in range(self.N):\n                    all_cells.append(self.cells[r][c])\n            return all_cells\n\n    class Path:\n        \"\"\"Represents a sequence of cell values, supporting construction and comparison.\"\"\"\n        def __init__(self, target_length, initial_cell_value=None, values_list=None):\n            self.target_length = target_length\n            if values_list is not None:\n                self.cellValues = list(values_list)\n            elif initial_cell_value is not None:\n                self.cellValues = [initial_cell_value]\n            else:\n                self.cellValues = []\n\n        def addCellValue(self, value):\n            \"\"\"Appends a new cell value to the path.\"\"\"\n            self.cellValues.append(value)\n\n        def removeLastCellValue(self):\n            \"\"\"Removes the last cell value from the path for backtracking.\"\"\"\n            if self.cellValues:\n                self.cellValues.pop()\n\n        def isComplete(self):\n            \"\"\"Checks if the path has reached the target length.\"\"\"\n            return len(self.cellValues) == self.target_length\n\n        def compareLexicographically(self, otherPath):\n            \"\"\"Compares this path with another path lexicographically.\"\"\"\n            if self.cellValues < otherPath.cellValues:\n                return -1\n            elif self.cellValues > otherPath.cellValues:\n                return 1\n            else:\n                return 0\n\n        def get_values(self):\n            \"\"\"Returns the ordered list of cell values in the path.\"\"\"\n            return self.cellValues\n\n        def __lt__(self, other):\n            \"\"\"Enables direct comparison using the '<' operator.\"\"\"\n            return self.compareLexicographically(other) == -1\n\n    def _find_paths_dfs(current_cell, current_path_obj, grid_obj, k_val, min_path_ref):\n        \"\"\"\n        Recursive DFS to explore paths of length k and update the minimum path found.\n        The min_path_ref is a list [min_path_obj] to allow modification across calls.\n        \"\"\"\n        # Base case: if the current path is complete, compare and update the minimum.\n        if current_path_obj.isComplete():\n            if min_path_ref[0] is None or current_path_obj < min_path_ref[0]:\n                min_path_ref[0] = Path(k_val, values_list=current_path_obj.get_values())\n            return\n\n        # Recursive step: explore valid neighbors.\n        for neighbor_cell in current_cell.getNeighbors(grid_obj):\n            current_path_obj.addCellValue(neighbor_cell.get_value())\n            _find_paths_dfs(neighbor_cell, current_path_obj, grid_obj, k_val, min_path_ref)\n            current_path_obj.removeLastCellValue()  # Backtrack to explore other branches\n\n    # --- Main minPath function logic ---\n    grid_obj = Grid(grid)\n    # min_path_ref holds the unique lexicographically smallest path found so far.\n    min_path_ref = [None]\n\n    # Iterate through each cell as a starting point for DFS.\n    for start_cell in grid_obj.get_all_cells():\n        # Initialize a new path for each starting cell.\n        current_path_obj = Path(k, initial_cell_value=start_cell.get_value())\n        _find_paths_dfs(start_cell, current_path_obj, grid_obj, k, min_path_ref)\n\n    # Return the cell values of the unique minimum path found.\n    return min_path_ref[0].get_values()\n\n```"}
{"task_id": "HumanEval/129", "solution": "```python\nclass Cell:\n    \"\"\"Represents a single cell in the grid with its value, row, and column.\"\"\"\n    def __init__(self, value: int, row: int, column: int):\n        self._value = value\n        self._row = row\n        self._column = column\n\n    @property\n    def value(self) -> int:\n        return self._value\n\n    @property\n    def row(self) -> int:\n        return self._row\n\n    @property\n    def column(self) -> int:\n        return self._column\n\n    def isNeighbor(self, otherCell: 'Cell') -> bool:\n        \"\"\"Checks if another cell is an adjacent neighbor.\"\"\"\n        return abs(self.row - otherCell.row) + abs(self.column - otherCell.column) == 1\n\n    def __hash__(self):\n        return hash((self._row, self._column, self._value))\n\n    def __eq__(self, other):\n        if not isinstance(other, Cell):\n            return NotImplemented\n        return self.row == other.row and self.column == other.column and self.value == other.value\n\n\nclass Grid:\n    \"\"\"Represents the N x N grid, containing cells and providing access to them and their neighbors.\"\"\"\n    def __init__(self, grid_data: list[list[int]]):\n        self._N = len(grid_data)\n        self._cells: list[list[Cell]] = [[None for _ in range(self._N)] for _ in range(self._N)]\n        for r in range(self._N):\n            for c in range(self._N):\n                self._cells[r][c] = Cell(grid_data[r][c], r, c)\n\n    @property\n    def N(self) -> int:\n        return self._N\n\n    def getCell(self, row: int, col: int) -> Cell:\n        \"\"\"Retrieves a cell at specific coordinates.\"\"\"\n        return self._cells[row][col]\n\n    def getNeighbors(self, cell: Cell) -> list[Cell]:\n        \"\"\"Returns a list of valid adjacent neighbor cells for a given cell.\"\"\"\n        neighbors = []\n        dr = [-1, 1, 0, 0] # Up, Down\n        dc = [0, 0, -1, 1] # Left, Right\n\n        for i in range(4):\n            new_row, new_col = cell.row + dr[i], cell.column + dc[i]\n            if 0 <= new_row < self._N and 0 <= new_col < self._N:\n                neighbors.append(self.getCell(new_row, new_col))\n        return neighbors\n\n\nclass Path:\n    \"\"\"Represents an ordered sequence of cells visited, providing its values and lexicographical comparison.\"\"\"\n    def __init__(self, k: int, sequence_of_cells: list[Cell] = None):\n        self._k = k\n        self._sequenceOfCells: list[Cell] = []\n        self._sequenceOfValues: list[int] = []\n\n        if sequence_of_cells is not None:\n            for cell in sequence_of_cells:\n                self.addCell(cell)\n\n    def addCell(self, cell: Cell):\n        \"\"\"Adds a cell to the path sequence.\"\"\"\n        if len(self._sequenceOfCells) < self._k:\n            self._sequenceOfCells.append(cell)\n            self._sequenceOfValues.append(cell.value)\n\n    def getValues(self) -> list[int]:\n        \"\"\"Returns the ordered list of integer values in the path.\"\"\"\n        return self._sequenceOfValues\n\n    def getCells(self) -> list[Cell]:\n        \"\"\"Returns the ordered list of Cell objects in the path.\"\"\"\n        return self._sequenceOfCells\n\n    def isLexicographicallyLessThan(self, other_path_values: list[int]) -> bool:\n        \"\"\"Compares this path's values to another path's values lexicographically.\"\"\"\n        self_values = self.getValues()\n        # Paths being compared here will have length k.\n        for i in range(self._k):\n            if self_values[i] < other_path_values[i]:\n                return True\n            if self_values[i] > other_path_values[i]:\n                return False\n        return False # Paths are equal or self_values is not less than other_path_values\n\n\nclass PathFinder:\n    \"\"\"Implements the algorithm to find the lexicographically smallest path of length k in a given grid.\"\"\"\n    def __init__(self):\n        pass # PathFinder is stateless.\n\n    def find_minimum_path(self, grid_data: list[list[int]], k: int) -> list[int]:\n        \"\"\"Initializes the grid and orchestrates the search for the minimum path.\"\"\"\n        grid = Grid(grid_data)\n        N = grid.N\n\n        # Initialize min_path_values to a path of k 'infinity' values.\n        # Max possible value is N*N, so N*N + 1 is guaranteed to be larger.\n        max_possible_value = N * N + 1\n        min_path_values: list[int] = [max_possible_value] * k\n\n        # Iterate through all possible starting cells (r, c)\n        for r in range(N):\n            for c in range(N):\n                start_cell = grid.getCell(r, c)\n                initial_path = Path(k)\n                initial_path.addCell(start_cell)\n                # Start recursive exploration from this cell.\n                self._explore_paths(initial_path, start_cell, k - 1, grid, min_path_values)\n\n        return min_path_values\n\n    def _explore_paths(self,\n                       current_path: Path,\n                       current_cell: Cell,\n                       remaining_length: int,\n                       grid: Grid,\n                       min_path_values: list[int]):\n        \"\"\"Recursive backtracking function to explore paths and update the minimum path found so far.\"\"\"\n        if remaining_length == 0:\n            # Path of length k found. Compare its values with the current minimum path values.\n            if current_path.isLexicographicallyLessThan(min_path_values):\n                # Update min_path_values using the values from current_path.\n                min_path_values[:] = current_path.getValues()\n            return\n\n        # Explore neighbors of the current cell.\n        neighbors = grid.getNeighbors(current_cell)\n        for neighbor_cell in neighbors:\n            # Create a new path object by copying the current path's sequence of cells.\n            # This ensures each branch of exploration works with an independent path.\n            next_path = Path(current_path._k, current_path.getCells())\n            next_path.addCell(neighbor_cell)\n            self._explore_paths(next_path, neighbor_cell, remaining_length - 1, grid, min_path_values)\n\n\ndef minPath(grid: list[list[int]], k: int) -> list[int]:\n    \"\"\"\n    Given a grid and a positive integer k, find the lexicographically smallest path of length k.\n    The path can start from any cell and move to adjacent cells, staying within boundaries.\n    \"\"\"\n    finder = PathFinder()\n    result = finder.find_minimum_path(grid, k)\n    return result\n```"}
{"task_id": "HumanEval/130", "solution": "```python\ndef tri(n):\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in\n    the last couple centuries. However, what people don't know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8\n    You are given a non-negative integer number n, you have to a return a list of the\n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n    memo = {}\n\n    def _calculate_term(k: int) -> int:\n        \"\"\"Calculates and memoizes a single Tribonacci term for k=0, 1, or even k.\"\"\"\n        if k in memo:\n            return memo[k]\n\n        val: int\n        if k == 0:\n            val = 1\n        elif k == 1:\n            val = 3\n        elif k % 2 == 0: # k is even and > 0\n            val = 1 + k // 2\n        # For odd k > 1, this method is not intended for direct calculation\n        # in the forward pass. Their calculation is handled in the second pass.\n        else:\n            return 0 # This branch should ideally not be reached during the first pass for odd k\n\n        memo[k] = val\n        return val\n\n    # Handle edge cases for n=0 and n=1 explicitly\n    if n == 0:\n        return [1]\n    if n == 1:\n        return [1, 3]\n\n    # Initialize base cases tri(0) and tri(1)\n    _calculate_term(0)\n    _calculate_term(1)\n\n    # First Pass (Forward Calculation for Even Terms and Dependencies):\n    # Calculates all even terms up to n + 2, which are needed for odd term calculations.\n    # The range goes up to n + 2 inclusive.\n    for i in range(2, n + 2 + 1):\n        if i % 2 == 0:  # Calculate only even terms.\n            _calculate_term(i)\n\n    # Second Pass (Backward Calculation for Odd Terms):\n    # Calculates odd terms using values guaranteed to be in memo from the first pass.\n    # Iterate backward from n down to and including 2.\n    for i in range(n, 1, -1):\n        if i % 2 == 1:  # Calculate only odd terms.\n            memo[i] = memo[i - 1] + memo[i - 2] + memo[i + 1]\n\n    # Result Extraction: Collect the sequence from tri(0) to tri(n).\n    return [memo[i] for i in range(n + 1)]\n```\n"}
{"task_id": "HumanEval/130", "solution": "```python\ndef tri(n: int) -> list[int | float]:\n    \"\"\"Calculates the first n + 1 Tribonacci numbers.\n    It uses a two-pass approach to handle the circular dependency for odd k.\"\"\"\n\n    # The cache needs to store values up to index n, and potentially up to n+1 for odd n's tri(n) calculation.\n    cache_size = max(2, n + 2)\n    sequence_cache = [None] * cache_size\n\n    # Base cases\n    sequence_cache[0] = 1\n    if n >= 1:\n        sequence_cache[1] = 3\n\n    # Pass 1: Calculate all even numbers and necessary forward numbers for odd k.\n    # Iterates up to n + 1 to ensure tri(k+1) is available when tri(k) is calculated later.\n    for k in range(2, n + 2):\n        if k % 2 == 0:  # k is even\n            sequence_cache[k] = 1 + k / 2\n\n    # Pass 2: Calculate all odd numbers using cached values.\n    # Iterates from 3 up to n (inclusive).\n    for k in range(3, n + 1):\n        if k % 2 != 0:  # k is odd\n            # tri(k) = tri(k - 1) + tri(k - 2) + tri(k + 1)\n            sequence_cache[k] = sequence_cache[k - 1] + sequence_cache[k - 2] + sequence_cache[k + 1]\n\n    # Return the first n + 1 numbers from the cache.\n    return sequence_cache[:n + 1]\n```"}
{"task_id": "HumanEval/131", "solution": "```python\ndef digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    product = 1\n    found_odd_digit = False\n\n    extracted_digits = [int(d) for d in str(n)]\n\n    for digit in extracted_digits:\n        if digit % 2 != 0:\n            product *= digit\n            found_odd_digit = True\n\n    return product if found_odd_digit else 0\n```"}
{"task_id": "HumanEval/132", "solution": "```python\nclass BracketString:\n    def __init__(self, content: str):\n        self.content = content\n\n    def get_content(self) -> str:\n        return self.content\n\n    def is_valid_bracket_sequence(self, s: str) -> bool:\n        \"\"\"Checks if the string s forms a valid bracket sequence.\n        Uses a stack to match opening and closing brackets.\"\"\"\n        stack = []\n        for char in s:\n            if char == '[':\n                stack.append(char)\n            elif char == ']':\n                if not stack:\n                    return False\n                stack.pop()\n        return not stack\n\n    def has_nested_pair(self, s: str) -> bool:\n        \"\"\"Checks if a valid bracket sequence s contains a nested pair.\n        A sequence is nested if it forms `[X]` where X is a non-empty valid sequence.\"\"\"\n        if len(s) < 4:  # Smallest nested sequence is '[[]]'\n            return False\n        # Checks if 's' itself represents a single enclosing pair containing another valid sequence.\n        if s[0] == '[' and s[-1] == ']':\n            inner_content = s[1:-1]\n            # The inner content must be non-empty and also a valid bracket sequence.\n            return len(inner_content) > 0 and self.is_valid_bracket_sequence(inner_content)\n        return False\n\nclass BracketValidator:\n    def check_nested_validity(self, bracket_string: BracketString) -> bool:\n        \"\"\"Iterates through all subsequences to find one that is both valid and nested.\"\"\"\n        original_content = bracket_string.get_content()\n        n = len(original_content)\n\n        # Iterate through all non-empty subsequences using bitmasks.\n        for i in range(1, 1 << n):\n            subsequence_chars = []\n            for j in range(n):\n                if (i >> j) & 1:\n                    subsequence_chars.append(original_content[j])\n\n            subsequence = \"\".join(subsequence_chars)\n\n            # Skip short subsequences that cannot possibly be nested.\n            if len(subsequence) < 4:\n                continue\n\n            if bracket_string.is_valid_bracket_sequence(subsequence):\n                if bracket_string.has_nested_pair(subsequence):\n                    return True\n        return False\n\ndef is_nested(string):\n    '''\n    Checks if the input string contains a valid subsequence of brackets with at least one nested bracket.\n    Uses BracketString and BracketValidator classes as per design.\n    '''\n    bracket_string_obj = BracketString(string)\n    validator = BracketValidator()\n    return validator.check_nested_validity(bracket_string_obj)\n```"}
{"task_id": "HumanEval/133", "solution": "import math\n\ndef sum_squares(lst):\n    \"\"\"Calculates the sum of squared numbers in a list, after rounding each element up to its ceiling.\n    This function processes numbers by applying ceiling, then squaring, and finally summing them.\n    \"\"\"\n    total_sum = 0\n    for number in lst:\n        rounded_number = math.ceil(number)\n        squared_number = rounded_number ** 2\n        total_sum += squared_number\n    return total_sum"}
{"task_id": "HumanEval/132", "solution": "```python\ndef is_nested(s: str) -> bool:\n    \"\"\"\n    Checks if the string contains a valid nested bracket subsequence.\n    This is true if an inner ']' closes while an outer '[' is still open.\n    \"\"\"\n    open_brackets_count = 0\n    for char in s:\n        if char == '[':\n            open_brackets_count += 1\n        elif char == ']':\n            # Only process if there's an open bracket to match\n            if open_brackets_count > 0:\n                open_brackets_count -= 1\n                # A nested structure like '[[]]' is detected when an inner ']'\n                # closes a bracket, but there's still at least one outer '[' open.\n                if open_brackets_count >= 1:\n                    return True\n    return False\n```"}
{"task_id": "HumanEval/126", "solution": "def _validate_input_list(lst: list[int]) -> bool:\n    \"\"\"Checks if all elements in the list are non-negative.\"\"\"\n    for num in lst:\n        if num < 0:\n            return False\n    return True\n\ndef _check_ascending_order(lst: list[int]) -> bool:\n    \"\"\"Verifies if the list is sorted in ascending order.\"\"\"\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n    return True\n\ndef _check_duplicate_count(lst: list[int]) -> bool:\n    \"\"\"Counts element occurrences and checks if any appears more than two times.\"\"\"\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] > 2:\n            return False\n    return True\n\ndef is_sorted(lst: list[int]) -> bool:\n    \"\"\"\n    Checks if a list is sorted ascendingly and no number appears more than two times.\n    Returns True if valid, False otherwise.\n    \"\"\"\n    if not _validate_input_list(lst):\n        return False\n    if not _check_ascending_order(lst):\n        return False\n    if not _check_duplicate_count(lst):\n        return False\n    return True"}
{"task_id": "HumanEval/134", "solution": "```python\ndef check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an isolated alphabetical character.\n    Returns True if it's an alphabetical character not part of a word, False otherwise.\n    \"\"\"\n    if len(txt) == 0:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n\n    char_before_last = txt[-2]\n    if char_before_last.isspace():\n        return True\n    else:\n        return False\n```"}
{"task_id": "HumanEval/135", "solution": "```python\ndef can_arrange(arr: list) -> int:\n    \"\"\"Returns the largest index where arr[i] < arr[i-1], iterating right-to-left.\n    If no such index exists, returns -1.\"\"\"\n    for i in range(len(arr) - 1, 0, -1):\n        if arr[i] < arr[i-1]:\n            return i\n    return -1\n```"}
{"task_id": "HumanEval/134", "solution": "```python\ndef check_if_last_char_is_a_letter(txt):\n    '''\n    Checks if the last character of a string is an alphabetical single-letter word.\n    A single-letter word is either the only character or preceded by a space.\n    '''\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n\n    # For strings longer than one character, check the second to last character\n    second_to_last_char = txt[-2]\n    if second_to_last_char == ' ':\n        return True\n    else:\n        return False\n```"}
{"task_id": "HumanEval/136", "solution": "```python\ndef largest_smallest_integers(lst):\n    \"\"\"\n    Identifies the largest negative integer and the smallest positive integer in a list.\n    Returns (largest_negative, smallest_positive), with None for missing categories.\n    \"\"\"\n    if not lst or (len(lst) == 1 and lst[0] == 0):\n        return (None, None)\n\n    largest_negative = None\n    smallest_positive = None\n\n    for number in lst:\n        if number < 0:\n            if largest_negative is None or number > largest_negative:\n                largest_negative = number\n        elif number > 0:\n            if smallest_positive is None or number < smallest_positive:\n                smallest_positive = number\n\n    return (largest_negative, smallest_positive)\n```"}
{"task_id": "HumanEval/135", "solution": "```python\ndef can_arrange(arr):\n    \"\"\"Create a function which returns the largest index of an element which\n    is not greater than or equal to the element immediately preceding it. If\n    no such element exists then return -1. The given array will not contain\n    duplicate values.\n\n    Examples:\n    can_arrange([1,2,4,3,5]) = 3\n    can_arrange([1,2,3]) = -1\n    \"\"\"\n    for i in range(len(arr) - 1, 0, -1):\n        if arr[i] < arr[i-1]:\n            return i\n    return -1\n```"}
{"task_id": "HumanEval/136", "solution": "```python\ndef largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n    '''\n    largest_negative = None\n    smallest_positive = None\n\n    # Iterate through the list to find the largest negative and smallest positive integers.\n    # The initial None values correctly handle cases where no such integers are found.\n    for current_int in lst:\n        if current_int < 0:\n            if largest_negative is None or current_int > largest_negative:\n                largest_negative = current_int\n        elif current_int > 0:\n            if smallest_positive is None or current_int < smallest_positive:\n                smallest_positive = current_int\n\n    return (largest_negative, smallest_positive)\n```"}
{"task_id": "HumanEval/137", "solution": "class _ValueWrapper:\n    \"\"\"Helper class to encapsulate a value, its original type, and its parsed numerical representation.\"\"\"\n    def __init__(self, value):\n        self._original_value = value\n        # Convert the input value to a float, handling string representations with comma or period as decimal separators.\n        if isinstance(value, str):\n            self._numeric_value = float(value.replace(',', '.'))\n        else:\n            self._numeric_value = float(value)\n\n    def get_original_value(self):\n        \"\"\"Returns the original input value.\"\"\"\n        return self._original_value\n\n    def get_numeric_value(self):\n        \"\"\"Returns the numerical (float) representation of the value.\"\"\"\n        return self._numeric_value\n\n\ndef compare_one(a, b):\n    \"\"\"\n    Compares two input values (integers, floats, or strings representing real numbers)\n    and returns the numerically larger value in its original type, or None if equal.\n    \"\"\"\n    wrapper_a = _ValueWrapper(a)\n    wrapper_b = _ValueWrapper(b)\n\n    numeric_a = wrapper_a.get_numeric_value()\n    numeric_b = wrapper_b.get_numeric_value()\n\n    if numeric_a == numeric_b:\n        return None\n    elif numeric_a > numeric_b:\n        return wrapper_a.get_original_value()\n    else: # numeric_b > numeric_a\n        return wrapper_b.get_original_value()"}
{"task_id": "HumanEval/137", "solution": "```python\nclass InputProcessor:\n    \"\"\"\n    Processes an input value to store its original form and a parsed numerical value for comparison.\n    Handles integers, floats, and strings with ',' or '.' as decimal separators.\n    \"\"\"\n    def __init__(self, value):\n        self.original_value = value\n        self.original_type = type(value)\n        try:\n            # Attempt to process as a string that might contain a comma decimal separator.\n            cleaned_str = value.replace(',', '.')\n            self.parsed_numerical_value = float(cleaned_str)\n        except AttributeError:\n            # If value is not a string (e.g., int or float), convert directly to float.\n            self.parsed_numerical_value = float(value)\n\n    def get_original_value(self):\n        return self.original_value\n\n    def get_parsed_numerical_value(self):\n        return self.parsed_numerical_value\n\ndef compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n\n    compare_one(1, 2.5) \u279e 2.5\n    compare_one(1, \"2,3\") \u279e \"2,3\"\n    compare_one(\"5,1\", \"6\") \u279e \"6\"\n    compare_one(\"1\", 1) \u279e None\n    \"\"\"\n    processor_a = InputProcessor(a)\n    processor_b = InputProcessor(b)\n\n    num_a = processor_a.get_parsed_numerical_value()\n    num_b = processor_b.get_parsed_numerical_value()\n\n    if num_a > num_b:\n        return processor_a.get_original_value()\n    elif num_b > num_a:\n        return processor_b.get_original_value()\n    else: # num_a == num_b\n        return None\n```"}
