{"task_id": "HumanEval/81", "solution": "```python\nclass _GradingScale:\n    \"\"\"Encapsulates the grading scale logic for GPA to letter grade conversion.\n    Rules define inclusive lower bounds for each letter grade.\n    \"\"\"\n    def __init__(self):\n        # Rules are ordered by descending GPA threshold.\n        # Each threshold is the *inclusive* lower bound for its corresponding grade,\n        # aligning with the example output for boundary conditions.\n        self.rules = [\n            (4.0, 'A+'),\n            (3.7, 'A'),\n            (3.3, 'A-'),\n            (3.0, 'B+'),\n            (2.7, 'B'),\n            (2.3, 'B-'),\n            (2.0, 'C+'),\n            (1.7, 'C'),\n            (1.3, 'C-'),\n            (1.0, 'D+'),\n            (0.7, 'D'),\n            (0.0, 'D-') # Represents all GPAs > 0.0 and <= 0.7 that don't match higher rules.\n        ]\n\n    def get_letter_grade(self, gpa: float) -> str:\n        \"\"\"Applies the grading scale to convert a single GPA to its letter grade.\n        It handles exact 0.0 for 'E' and iterates through defined rules for other GPAs.\n        \"\"\"\n        if gpa == 0.0:\n            return 'E'\n\n        for threshold, letter_grade in self.rules:\n            if gpa >= threshold:\n                return letter_grade\n\ndef numerical_letter_grade(grades: list[float]) -> list[str]:\n    \"\"\"Converts a list of numerical GPAs into a corresponding list of letter grades.\n    It uses an internal grading scale to determine each letter grade.\n    \"\"\"\n    converter = _GradingScale()\n    converted_grades = []\n    for gpa in grades:\n        converted_grades.append(converter.get_letter_grade(gpa))\n    return converted_grades\n```"}
{"task_id": "HumanEval/82", "solution": "```python\nimport math\n\ndef prime_length(string):\n    \"\"\"Checks if the length of the input string is a prime number.\n    Returns True if the length is prime, False otherwise.\"\"\"\n    n = len(string)\n\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n > 2 and n % 2 == 0:\n        return False\n\n    limit = math.isqrt(n)\n    for i in range(3, limit + 1, 2):\n        if n % i == 0:\n            return False\n\n    return True\n```"}
{"task_id": "HumanEval/81", "solution": "```python\n\"\"\"\nIt is the last week of the semester and the teacher has to give the grades to students.\nThis function converts a list of GPAs into a list of letter grades based on a predefined scale.\n\"\"\"\n\nclass GradingRule:\n    \"\"\"Represents a single rule for mapping a GPA to a letter grade.\"\"\"\n    def __init__(self, letter_grade: str, exact_gpa: float = None, min_gpa: float = None, max_gpa: float = None, upper_bound_inclusive: bool = True):\n        self._letter_grade = letter_grade\n        self._exact_gpa = exact_gpa\n        self._min_gpa = min_gpa\n        self._max_gpa = max_gpa\n        self._upper_bound_inclusive = upper_bound_inclusive\n        self._is_exact_match = exact_gpa is not None\n\n    def applies_to(self, gpa: float) -> bool:\n        \"\"\"Checks if the given GPA falls within this rule's criteria.\"\"\"\n        if self._is_exact_match:\n            return gpa == self._exact_gpa\n\n        if self._min_gpa is not None and self._max_gpa is not None:\n            if self._upper_bound_inclusive:\n                return self._min_gpa < gpa <= self._max_gpa\n            else:\n                return self._min_gpa < gpa < self._max_gpa\n        return False\n\nclass GradingScale:\n    \"\"\"Manages a collection of grading rules to convert GPAs.\"\"\"\n    def __init__(self):\n        self._rules = [\n            # Rules ordered from highest GPA to lowest, with exact matches handled first where appropriate.\n            GradingRule('A+', exact_gpa=4.0),\n            GradingRule('A', min_gpa=3.7, max_gpa=4.0, upper_bound_inclusive=False),\n            GradingRule('A-', min_gpa=3.3, max_gpa=3.7, upper_bound_inclusive=True),\n            GradingRule('B+', min_gpa=3.0, max_gpa=3.3, upper_bound_inclusive=True),\n            GradingRule('B', min_gpa=2.7, max_gpa=3.0, upper_bound_inclusive=True),\n            GradingRule('B-', min_gpa=2.3, max_gpa=2.7, upper_bound_inclusive=True),\n            GradingRule('C+', min_gpa=2.0, max_gpa=2.3, upper_bound_inclusive=True),\n            GradingRule('C', min_gpa=1.7, max_gpa=2.0, upper_bound_inclusive=True),\n            GradingRule('C-', min_gpa=1.3, max_gpa=1.7, upper_bound_inclusive=True),\n            GradingRule('D+', min_gpa=1.0, max_gpa=1.3, upper_bound_inclusive=True),\n            GradingRule('D', min_gpa=0.7, max_gpa=1.0, upper_bound_inclusive=True),\n            GradingRule('D-', min_gpa=0.0, max_gpa=0.7, upper_bound_inclusive=True),\n            GradingRule('E', exact_gpa=0.0)\n        ]\n\n    def get_letter_grade(self, gpa: float) -> str:\n        \"\"\"Determines the letter grade for a given GPA using the defined rules.\"\"\"\n        for rule in self._rules:\n            if rule.applies_to(gpa):\n                return rule._letter_grade\n        # Fallback if no rule matches, though problem implies all GPAs map.\n        return \"Unknown\"\n\ndef numerical_letter_grade(grades: list[float]) -> list[str]:\n    \"\"\"\n    Converts a list of numerical Grade Point Averages (GPAs) into a corresponding list of letter grades.\n    The conversion follows a predefined grading scale.\n    \"\"\"\n    grading_scale = GradingScale()\n    result_grades = []\n    for gpa in grades:\n        letter_grade = grading_scale.get_letter_grade(gpa)\n        result_grades.append(letter_grade)\n    return result_grades\n```"}
{"task_id": "HumanEval/76", "solution": "```python\nimport math\n\ndef is_simple_power(x, n):\n    \"\"\"Checks if `x` is a simple power of `n` (i.e., `n**i = x` for some integer `i`).\n    Returns True if it is, False otherwise.\n    \"\"\"\n    # Handle specific edge cases as per design.\n\n    # Case 1: x is 1. Any n raised to the power of 0 is 1 (n**0 = 1).\n    if x == 1:\n        return True\n\n    # Case 2: n is 1. 1 raised to any power is always 1.\n    # Since x is not 1 (handled above), x cannot be a simple power of 1.\n    if n == 1:\n        return False\n\n    # Case 3: n is 0.\n    # 0**i for i > 0 is 0. Since x is not 1 (handled above), the only remaining possibility for n**i = x is if x=0.\n    if n == 0:\n        return x == 0\n\n    # Case 4: x is 0.\n    # If x is 0, and n is not 0 or 1 (handled above), n**i = 0 implies n must be 0 (already handled).\n    # Thus, if x is 0 and n is not 0, it's not a simple power.\n    if x == 0:\n        return False\n\n    # Case 5: Negative numbers for x or n.\n    # For simplicity and based on typical power definitions in this context,\n    # if x or n is negative, it's considered not a simple power.\n    if x < 0 or n < 0:\n        return False\n\n    # General Case: x > 0 and n > 1.\n    # We can use logarithms to find if there's an integer exponent i such that n**i = x.\n    # This is equivalent to checking if log_n(x) is an integer.\n    log_val = math.log(x, n)\n\n    # Use a small epsilon for floating-point comparisons to check if log_val is close to an integer.\n    epsilon = 1e-9\n    return abs(log_val - round(log_val)) < epsilon\n```"}
{"task_id": "HumanEval/82", "solution": "```python\ndef _is_prime(n: int) -> bool:\n    \"\"\"Internal helper for integer primality check.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef prime_length(string: str) -> bool:\n    \"\"\"Checks if the length of the input string is a prime number.\"\"\"\n    length = len(string)\n    return _is_prime(length)\n```\n"}
{"task_id": "HumanEval/83", "solution": "```python\ndef starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        # For n=1, the only 1-digit positive integer starting or ending with 1 is '1'.\n        # All three counts (starts, ends, overlap) are 1.\n        count_start = 1\n        count_end = 1\n        count_overlap = 1\n    else:\n        # Calculate count of n-digit numbers that start with 1.\n        # The first digit is 1, remaining n-1 digits can be any of 0-9.\n        count_start = 10**(n - 1)\n\n        # Calculate count of n-digit numbers that end with 1.\n        # The last digit is 1. The first digit can be 1-9 (9 choices).\n        # The middle n-2 digits can be any of 0-9 (10 choices each).\n        count_end = 9 * (10**(n - 2))\n\n        # Calculate count of n-digit numbers that both start and end with 1.\n        # The first digit is 1, the last digit is 1.\n        # The middle n-2 digits can be any of 0-9 (10 choices each).\n        count_overlap = 10**(n - 2)\n\n    # Apply the inclusion-exclusion principle: P(A U B) = P(A) + P(B) - P(A intersection B)\n    final_count = count_start + count_end - count_overlap\n    return final_count\n```"}
{"task_id": "HumanEval/84", "solution": "```python\ndef solve(N):\n    \"\"\"Calculates the sum of N's decimal digits and returns its binary string representation.\n    N is an integer within the range 0 <= N <= 10000.\n    \"\"\"\n    sum_digits = sum(int(digit) for digit in str(N))\n    binary_string = bin(sum_digits)[2:]\n    return binary_string\n```"}
{"task_id": "HumanEval/77", "solution": "```python\ndef iscube(a):\n    '''\n    Checks if an integer is a perfect cube.\n    Handles positive, negative, and zero inputs by calculating and comparing integer cube roots.\n    '''\n    if a == 0:\n        return True\n\n    # Calculate the cube root of the absolute value using floating-point arithmetic.\n    cbrt_abs_a = abs(a)**(1/3)\n\n    # Round the floating-point cube root to the nearest integer to mitigate precision issues.\n    rounded_root = round(cbrt_abs_a)\n\n    # Apply the original sign to the rounded integer root.\n    actual_root = -rounded_root if a < 0 else rounded_root\n\n    # Cube the integer root and compare it to the original input 'a'.\n    return actual_root**3 == a\n```"}
{"task_id": "HumanEval/83", "solution": "```python\ndef starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n\n    def calculate_count_starts_with_1(num_digits: int) -> int:\n        \"\"\"Calculates count of n-digit numbers that start with 1.\"\"\"\n        return 10**(num_digits - 1)\n\n    def calculate_count_ends_with_1(num_digits: int) -> int:\n        \"\"\"Calculates count of n-digit numbers that end with 1.\"\"\"\n        if num_digits == 1:\n            return 1\n        return 9 * (10**(num_digits - 2))\n\n    def calculate_count_starts_and_ends_with_1(num_digits: int) -> int:\n        \"\"\"Calculates count of n-digit numbers that start and end with 1.\"\"\"\n        if num_digits == 1:\n            return 1\n        return 10**(num_digits - 2)\n\n    def calculate_total_count(starts_with_1_count: int, ends_with_1_count: int, starts_and_ends_with_1_count: int) -> int:\n        \"\"\"Applies the Principle of Inclusion-Exclusion to derive the total count.\"\"\"\n        return starts_with_1_count + ends_with_1_count - starts_and_ends_with_1_count\n\n    count_starts_with_1_val = calculate_count_starts_with_1(n)\n    count_ends_with_1_val = calculate_count_ends_with_1(n)\n    count_starts_and_ends_with_1_val = calculate_count_starts_and_ends_with_1(n)\n\n    total_count_val = calculate_total_count(\n        count_starts_with_1_val,\n        count_ends_with_1_val,\n        count_starts_and_ends_with_1_val\n    )\n\n    return total_count_val\n```"}
{"task_id": "HumanEval/85", "solution": "```python\ndef add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\n\n\n    Examples:\n        add([4, 2, 6, 7]) ==> 2\n    \"\"\"\n    total_sum = 0\n    for index, element in enumerate(lst):\n        if index % 2 != 0 and element % 2 == 0:\n            total_sum += element\n    return total_sum\n```"}
