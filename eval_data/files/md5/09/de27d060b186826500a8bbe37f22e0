{"task_id": "HumanEval/25", "solution": "from typing import List\n\n\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    if n <= 1:\n        return []\n\n    factors = []\n    d = 2\n\n    # Divide by 2 until n is odd\n    while n % d == 0:\n        factors.append(d)\n        n //= d\n\n    # Divide by odd numbers starting from 3\n    d = 3\n    while d * d <= n:\n        while n % d == 0:\n            factors.append(d)\n            n //= d\n        d += 2  # Increment by 2 to check only odd numbers\n\n    # If n is still greater than 1, it must be a prime factor itself\n    if n > 1:\n        factors.append(n)\n\n    return factors"}
{"task_id": "HumanEval/26", "solution": "```python\nfrom typing import List\n\n\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    counts = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    result = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n\n    return result\n```"}
{"task_id": "HumanEval/25", "solution": "```python\nfrom typing import List\n\n\ndef factorize(n: int) -> List[int]:\n    \"\"\"Return a list of prime factors for a given integer, ordered smallest to largest, with multiplicity.\n    The product of these factors will equal the input number.\n    \"\"\"\n    factors = []\n    temp_n = n\n\n    # Handle factor 2\n    d = 2\n    while temp_n % d == 0:\n        factors.append(d)\n        temp_n //= d\n\n    # Handle odd factors\n    d = 3\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 2  # Only check odd numbers\n\n    # If temp_n is still greater than 1, it must be a prime factor itself\n    if temp_n > 1:\n        factors.append(temp_n)\n\n    return factors\n```"}
{"task_id": "HumanEval/19", "solution": "from typing import List, Dict\n\nclass NumeralConverter:\n    \"\"\"Handles conversion between number words and their integer values.\"\"\"\n    _WORD_TO_VALUE_MAP: Dict[str, int] = {\n        'zero': 0, 'one': 1, 'two': 2, 'three': 3, 'four': 4,\n        'five': 5, 'six': 6, 'seven': 7, 'eight': 8, 'nine': 9\n    }\n\n    def word_to_value(self, word: str) -> int:\n        \"\"\"Converts a number word to its numerical integer value.\"\"\"\n        return self._WORD_TO_VALUE_MAP[word]\n\nclass Numeral:\n    \"\"\"Represents a number word with its corresponding numerical value.\"\"\"\n    def __init__(self, word: str, value: int):\n        self.word = word\n        self.value = value\n\n    def __lt__(self, other: 'Numeral') -> bool:\n        \"\"\"Compares two Numeral objects based on their numerical value.\"\"\"\n        return self.value < other.value\n\n    def __eq__(self, other: 'Numeral') -> bool:\n        \"\"\"Checks if two Numeral objects have the same numerical value.\"\"\"\n        return self.value == other.value\n\n    def get_word(self) -> str:\n        \"\"\"Returns the word representation of the numeral.\"\"\"\n        return self.word\n\nclass NumeralCollection:\n    \"\"\"Manages a collection of Numeral objects, providing sorting and string conversion.\"\"\"\n    def __init__(self, numeral_words_str: str):\n        self._numerals: List[Numeral] = []\n        converter = NumeralConverter()\n        for word in numeral_words_str.split(' '):\n            value = converter.word_to_value(word)\n            self._numerals.append(Numeral(word, value))\n\n    def sort(self) -> None:\n        \"\"\"Sorts the internal list of Numeral objects based on their value.\"\"\"\n        self._numerals.sort()\n\n    def to_string(self) -> str:\n        \"\"\"Converts the sorted collection of numerals back into a space-delimited string.\"\"\"\n        return ' '.join(numeral.get_word() for numeral in self._numerals)\n\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    \"\"\"\n    numeral_collection = NumeralCollection(numbers)\n    numeral_collection.sort()\n    return numeral_collection.to_string()"}
{"task_id": "HumanEval/26", "solution": "```python\nfrom typing import List\n\n\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    frequency_map = {}\n    for num in numbers:\n        frequency_map[num] = frequency_map.get(num, 0) + 1\n\n    result_list = []\n    for num in numbers:\n        if frequency_map[num] == 1:\n            result_list.append(num)\n\n    return result_list\n```"}
{"task_id": "HumanEval/27", "solution": "```python\ndef _flip_char_case(char: str) -> str:\n    \"\"\"Flips the case of an alphabetic character, otherwise returns it unchanged.\"\"\"\n    if 'a' <= char <= 'z':\n        return chr(ord(char) - 32)\n    elif 'A' <= char <= 'Z':\n        return chr(ord(char) + 32)\n    return char\n\ndef flip_case(string: str) -> str:\n    \"\"\" For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    >>> flip_case('Hello')\n    'hELLO'\n    \"\"\"\n    flipped_chars = []\n    for char in string:\n        flipped_chars.append(_flip_char_case(char))\n    return \"\".join(flipped_chars)\n```"}
{"task_id": "HumanEval/27", "solution": "```python\ndef flip_case(string: str) -> str:\n    \"\"\" For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    >>> flip_case('Hello')\n    'hELLO'\n    \"\"\"\n    flipped_chars = []\n    for char in string:\n        if char.islower():\n            flipped_chars.append(char.upper())\n        elif char.isupper():\n            flipped_chars.append(char.lower())\n        else:\n            flipped_chars.append(char)\n    return \"\".join(flipped_chars)\n```"}
