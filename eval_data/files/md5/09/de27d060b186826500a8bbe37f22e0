{"task_id": "HumanEval/89", "solution": "```python\ndef encrypt(s: str) -> str:\n    \"\"\"Encrypts a string by rotating lowercase English letters down by 4 places.\n    Non-lowercase letters are returned unchanged.\"\"\"\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Shift the lowercase letter by 4, handling wrap-around for 'w' through 'z'.\n            shifted_char_code = (ord(char) - ord('a') + 4) % 26 + ord('a')\n            encrypted_chars.append(chr(shifted_char_code))\n        else:\n            # Keep non-lowercase characters as they are.\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)\n```"}
{"task_id": "HumanEval/88", "solution": "import enum\n\nclass SortOrder(enum.Enum):\n    \"\"\"\n    Defines the possible sorting orders.\n    ASCENDING for smallest to largest, DESCENDING for largest to smallest.\n    \"\"\"\n    ASCENDING = 1\n    DESCENDING = 2\n\ndef _determine_sort_order(first_val: int, last_val: int) -> SortOrder:\n    \"\"\"\n    Determines the sorting order based on the parity of the sum of first and last values.\n    Returns ASCENDING if the sum is odd, DESCENDING if the sum is even.\n    \"\"\"\n    sum_first_last = first_val + last_val\n    if sum_first_last % 2 != 0:\n        return SortOrder.ASCENDING\n    else:\n        return SortOrder.DESCENDING\n\ndef sort_array(array: list[int]) -> list[int]:\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n\n    Note:\n    * don't change the given array.\n\n    Examples:\n    * sort_array([]) => []\n    * sort_array([5]) => [5]\n    * sort_array([2, 4, 3, 0, 1, 5]) => [0, 1, 2, 3, 4, 5]\n    * sort_array([2, 4, 3, 0, 1, 5, 6]) => [6, 5, 4, 3, 2, 1, 0]\n    \"\"\"\n    if not array:\n        return []\n\n    if len(array) == 1:\n        return list(array)\n\n    copied_array = list(array)\n    sort_order = _determine_sort_order(copied_array[0], copied_array[-1])\n\n    if sort_order == SortOrder.ASCENDING:\n        copied_array.sort()\n    else: # SortOrder.DESCENDING\n        copied_array.sort(reverse=True)\n\n    return copied_array"}
{"task_id": "HumanEval/89", "solution": "```python\nALPHABET = \"abcdefghijklmnopqrstuvwxyz\"\nSHIFT_AMOUNT = 4\n\ndef _shift_char(char: str, shift: int, alphabet: str) -> str:\n    \"\"\"Shifts a single lowercase English alphabet character by a given amount, handling wrap-around.\"\"\"\n    if char not in alphabet:\n        return char\n\n    current_index = alphabet.index(char)\n    shifted_index = (current_index + shift) % len(alphabet)\n    return alphabet[shifted_index]\n\ndef encrypt(s: str) -> str:\n    \"\"\"Encrypts an input string by rotating lowercase English alphabet characters by four places.\"\"\"\n    encrypted_chars = []\n    for char in s:\n        char_lower = char.lower()\n        if char_lower in ALPHABET:\n            shifted_char = _shift_char(char_lower, SHIFT_AMOUNT, ALPHABET)\n            encrypted_chars.append(shifted_char)\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)\n```"}
