{"task_id": "HumanEval/108", "solution": "```python\ndef _calculate_signed_sum_of_digits(number: int) -> int:\n    \"\"\"\n    Calculates the sum of digits for a number, treating the first digit of negative numbers as negative.\n    Returns 0 if the number is 0.\n    \"\"\"\n    if number == 0:\n        return 0\n\n    if number > 0:\n        return sum(int(digit) for digit in str(number))\n    else: # number is negative\n        str_num = str(abs(number))\n        first_digit = int(str_num[0])\n        remaining_sum = sum(int(digit) for digit in str_num[1:])\n        return -first_digit + remaining_sum\n\ndef count_nums(arr: list[int]) -> int:\n    \"\"\"\n    Counts elements in an array where the sum of digits (with special negative handling) is greater than zero.\n    It iterates through the array, calculates the signed sum for each number, and increments a counter if the sum is positive.\n    \"\"\"\n    count = 0\n    for number in arr:\n        if _calculate_signed_sum_of_digits(number) > 0:\n            count += 1\n    return count\n```"}
{"task_id": "HumanEval/108", "solution": "```python\ndef _calculate_signed_sum_of_digits(num: int) -> int:\n    \"\"\"\n    Calculates the sum of digits for an integer, treating the first digit of a negative number as negative.\n    For example, -123 results in -1 + 2 + 3 = 4.\n    \"\"\"\n    if num < 0:\n        s = str(num)\n        # The first digit is s[1] (e.g., '1' for -123), made negative.\n        # Remaining digits are s[2:] (e.g., '23' for -123).\n        return -int(s[1]) + sum(int(d) for d in s[2:])\n    else:\n        # For non-negative numbers, sum all digits as positive.\n        return sum(int(d) for d in str(num))\n\ndef count_nums(arr: list[int]) -> int:\n    \"\"\"\n    Counts the number of elements in an array whose sum of digits is greater than zero.\n    Negative numbers treat their first digit as negative in the sum calculation.\n    \"\"\"\n    count = 0\n    for num in arr:\n        if _calculate_signed_sum_of_digits(num) > 0:\n            count += 1\n    return count\n```"}
{"task_id": "HumanEval/109", "solution": "```python\ndef _is_sorted_non_decreasing(arr: list[int]) -> bool:\n    \"\"\"Checks if the array is sorted in non-decreasing order.\n    An empty or single-element array is considered sorted.\"\"\"\n    for i in range(len(arr) - 1):\n        if arr[i] > arr[i+1]:\n            return False\n    return True\n\ndef _perform_right_shift(arr: list[int]) -> list[int]:\n    \"\"\"Performs a single right shift operation on the array.\n    The last element moves to the 0th index, others shift right.\"\"\"\n    if not arr:\n        return []\n\n    shifted_arr = list(arr) # Create a new list to avoid modifying the original.\n    last_element = shifted_arr.pop()\n    shifted_arr.insert(0, last_element)\n    return shifted_arr\n\ndef move_one_ball(arr: list[int]) -> bool:\n    \"\"\"Determines if an array can be sorted into non-decreasing order by right shifts.\n    Returns True if sorted state is achievable, False otherwise.\"\"\"\n    n = len(arr)\n\n    if n == 0:\n        return True # An empty array is considered sorted.\n\n    current_arr = list(arr) # Create a mutable copy for shifting.\n\n    for _ in range(n): # Check up to N unique shifted states.\n        if _is_sorted_non_decreasing(current_arr):\n            return True # A sorted state was found.\n\n        current_arr = _perform_right_shift(current_arr) # Apply the right shift.\n\n    return False # No sorted state found after all possible shifts.\n```"}
{"task_id": "HumanEval/109", "solution": "```python\nfrom typing import List\n\ndef _is_sorted(arr: List[int]) -> bool:\n    \"\"\"Checks if an array is sorted in non-decreasing order.\n    It returns True if sorted, False otherwise.\n    \"\"\"\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i - 1]:\n            return False\n    return True\n\ndef _perform_right_shift(arr: List[int]) -> List[int]:\n    \"\"\"Performs a single right shift operation on the array.\n    The last element moves to the 0th index, creating a new list.\n    \"\"\"\n    if not arr:\n        return []\n    return [arr[-1]] + arr[:-1]\n\ndef move_one_ball(arr: List[int]) -> bool:\n    \"\"\"Determines if an array can be sorted into non-decreasing order by right shifts.\n    It returns True if a sorted state is achievable, False otherwise.\n    \"\"\"\n    if not arr:\n        return True\n\n    current_arr = list(arr) # Work with a copy to avoid modifying the original input\n    n = len(arr)\n\n    for _ in range(n):  # Iterate N times for all unique shift possibilities\n        if _is_sorted(current_arr):\n            return True\n        current_arr = _perform_right_shift(current_arr)\n\n    return False\n```"}
{"task_id": "HumanEval/111", "solution": "```python\ndef histogram(test):\n    \"\"\"Counts occurrences of space-separated lowercase letters, returning a dictionary of the most frequent ones and their count.\n    If multiple letters share the highest frequency, all are included.\n    \"\"\"\n    if not test:  # Handles an empty input string directly\n        return {}\n\n    letters = test.split()  # Splits the string into individual letter tokens\n\n    counts = {}\n    for letter in letters:\n        if letter:  # Ensure only non-empty strings (letters) are counted\n            counts[letter] = counts.get(letter, 0) + 1\n\n    if not counts:  # If no letters were found after parsing (e.g., input was only spaces)\n        return {}\n\n    max_count = 0\n    # Determine the maximum occurrence count\n    max_count = max(counts.values())\n\n    result = {}\n    # Identify all letters that share this maximum count\n    for letter, count in counts.items():\n        if count == max_count:\n            result[letter] = max_count\n\n    return result\n```"}
{"task_id": "HumanEval/110", "solution": "```python\ndef is_even(number):\n    \"\"\"Checks if a number is even.\n    Returns True if the number is even, False otherwise.\n    \"\"\"\n    return number % 2 == 0\n\ndef count_odd_numbers(numbers):\n    \"\"\"Counts the number of odd elements in a list.\n    It iterates through the list, using `is_even` to identify and count odd numbers.\n    \"\"\"\n    odd_count = 0\n    for number in numbers:\n        if not is_even(number):\n            odd_count += 1\n    return odd_count\n\ndef count_even_numbers(numbers):\n    \"\"\"Counts the number of even elements in a list.\n    It iterates through the list, using `is_even` to identify and count even numbers.\n    \"\"\"\n    even_count = 0\n    for number in numbers:\n        if is_even(number):\n            even_count += 1\n    return even_count\n\ndef exchange(lst1, lst2):\n    \"\"\"Determines if lst1 can be made entirely even by exchanging elements with lst2.\n    It counts odd numbers in lst1 and even numbers in lst2 to make the decision.\n    \"\"\"\n    odd_count_lst1 = count_odd_numbers(lst1)\n    even_count_lst2 = count_even_numbers(lst2)\n\n    if odd_count_lst1 <= even_count_lst2:\n        return \"YES\"\n    else:\n        return \"NO\"\n```"}
{"task_id": "HumanEval/111", "solution": "```python\ndef histogram(test: str) -> dict[str, int]:\n    \"\"\"Given a string of space-separated letters, return a dictionary of letters with the most repetitions and their count.\n    If several letters have the same maximum occurrence, return all of them.\n    \"\"\"\n    if not test:\n        return {}\n\n    def _calculate_frequencies(input_string: str) -> dict[str, int]:\n        \"\"\"Calculates the frequency of each unique letter in the input string.\"\"\"\n        frequencies = {}\n        for letter in input_string.split():\n            frequencies[letter] = frequencies.get(letter, 0) + 1\n        return frequencies\n\n    def _get_max_frequency_letters(frequencies: dict[str, int]) -> dict[str, int]:\n        \"\"\"Determines the maximum frequency and identifies all letters sharing it.\"\"\"\n        if not frequencies:\n            return {}\n\n        max_frequency = 0\n        for count in frequencies.values():\n            if count > max_frequency:\n                max_frequency = count\n\n        max_freq_letters = {}\n        for letter, count in frequencies.items():\n            if count == max_frequency:\n                max_freq_letters[letter] = count\n        return max_freq_letters\n\n    letter_frequencies = _calculate_frequencies(test)\n    return _get_max_frequency_letters(letter_frequencies)\n\n```"}
{"task_id": "HumanEval/110", "solution": "```python\ndef exchange(lst1, lst2):\n    \"\"\"In this problem, you will implement a function that takes two lists of numbers,\n    and determines whether it is possible to perform an exchange of elements\n    between them to make lst1 a list of only even numbers.\n    There is no limit on the number of exchanged elements between lst1 and lst2.\n    If it is possible to exchange elements between the lst1 and lst2 to make\n    all the elements of lst1 to be even, return \"YES\".\n    Otherwise, return \"NO\".\n    For example:\n    exchange([1, 2, 3, 4], [1, 2, 3, 4]) => \"YES\"\n    exchange([1, 2, 3, 4], [1, 5, 3, 4]) => \"NO\"\n    It is assumed that the input lists will be non-empty.\n    \"\"\"\n\n    def is_even(number: int) -> bool:\n        return number % 2 == 0\n\n    odd_needed = 0\n    for number in lst1:\n        if not is_even(number):\n            odd_needed += 1\n\n    even_available = 0\n    for number in lst2:\n        if is_even(number):\n            even_available += 1\n\n    if odd_needed <= even_available:\n        return \"YES\"\n    else:\n        return \"NO\"\n\n```"}
{"task_id": "HumanEval/112", "solution": "def _remove_characters(s: str, chars_to_remove: str) -> str:\n    \"\"\"Removes characters from 's' that are present in 'chars_to_remove'.\n    It builds a new string with only the desired characters.\"\"\"\n    result_chars = []\n    chars_to_remove_set = set(chars_to_remove) # Use a set for O(1) average time lookups\n    for char_s in s:\n        if char_s not in chars_to_remove_set:\n            result_chars.append(char_s)\n    return \"\".join(result_chars)\n\ndef _is_palindrome(s: str) -> bool:\n    \"\"\"Checks if the given string 's' is a palindrome.\n    A palindrome reads the same forwards and backwards.\"\"\"\n    return s == s[::-1]\n\ndef reverse_delete(s: str, c: str) -> tuple[str, bool]:\n    \"\"\"Deletes characters from s present in c and checks if the result is a palindrome.\n    Returns a tuple (processed_string, is_palindrome).\"\"\"\n    processed_string = _remove_characters(s, c)\n    is_palindrome = _is_palindrome(processed_string)\n    return (processed_string, is_palindrome)"}
{"task_id": "HumanEval/113", "solution": "```python\ndef _validate_digit_string(s: str) -> None:\n    \"\"\"Validates if a string contains only digits.\n    Raises ValueError if any character is not a digit.\"\"\"\n    if not s.isdigit():\n        raise ValueError(f\"Input string '{s}' contains non-digit characters.\")\n\ndef _count_odd_digits_in_string(s: str) -> int:\n    \"\"\"Counts the number of odd digits in a string.\n    Iterates through the string, converting characters to integers to check parity.\"\"\"\n    count = 0\n    for char in s:\n        if int(char) % 2 != 0:\n            count += 1\n    return count\n\ndef _format_result_string(count: int) -> str:\n    \"\"\"Formats the output string using the provided count.\n    Inserts the count into a specific template string.\"\"\"\n    return f\"the number of odd elements {count}n the str{count}ng {count} of the {count}nput.\"\n\ndef odd_count(lst: list[str]) -> list[str]:\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\n\n    >>> odd_count(['1234567'])\n    [\"the number of odd elements 4n the str4ng 4 of the 4nput.\"]\n    >>> odd_count(['3',\"11111111\"])\n    [\"the number of odd elements 1n the str1ng 1 of the 1nput.\",\n     \"the number of odd elements 8n the str8ng 8 of the 8nput.\"]\n    \"\"\"\n    results_list = []\n    for input_string in lst:\n        _validate_digit_string(input_string)\n        odd_digit_count = _count_odd_digits_in_string(input_string)\n        formatted_string = _format_result_string(odd_digit_count)\n        results_list.append(formatted_string)\n    return results_list\n```"}
{"task_id": "HumanEval/114", "solution": "```python\ndef minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array.\n    This implementation uses nested loops to check all possible sub-arrays.\n    \"\"\"\n    min_sum_overall = float('inf')\n\n    for i in range(len(nums)):\n        current_sub_array_sum = 0\n        for j in range(i, len(nums)):\n            current_sub_array_sum += nums[j]\n            if current_sub_array_sum < min_sum_overall:\n                min_sum_overall = current_sub_array_sum\n\n    return min_sum_overall\n```"}
{"task_id": "HumanEval/114", "solution": "```python\ndef minSubArraySum(nums):\n    \"\"\"\n    Finds the minimum sum of any non-empty sub-array within nums using a dynamic programming approach.\n    It maintains the minimum sum ending at the current position and the overall minimum sum found.\n    \"\"\"\n    min_so_far = nums[0]\n    current_min = nums[0]\n\n    for i in range(1, len(nums)):\n        num = nums[i]\n        current_min = min(num, current_min + num)\n        min_so_far = min(min_so_far, current_min)\n\n    return min_so_far\n```"}
{"task_id": "HumanEval/116", "solution": "```python\ndef _count_set_bits(n: int) -> int:\n    \"\"\"Counts the number of '1' bits in the binary representation of a non-negative integer.\"\"\"\n    return bin(n).count('1')\n\ndef sort_array(arr: list[int]) -> list[int]:\n    \"\"\"\n    Sorts an array of non-negative integers based on the count of 'ones' in their binary\n    representation, then by decimal value for ties.\n    \"\"\"\n    return sorted(arr, key=lambda x: (_count_set_bits(x), x))\n```"}
{"task_id": "HumanEval/115", "solution": "```python\nimport math\n\nclass Bucket:\n    \"\"\"\n    Represents a water bucket with a specific capacity.\n    Handles storage and retrieval of bucket capacity.\n    \"\"\"\n    def __init__(self, capacity: int):\n        self._capacity = capacity\n        # Validation is designed here, but raising errors is forbidden by critical requirements.\n        self.validate_capacity()\n\n    def validate_capacity(self):\n        \"\"\"\n        Validates the bucket's capacity based on design constraints.\n        No exceptions are raised per critical requirements.\n        \"\"\"\n        pass\n\n    def get_capacity(self) -> int:\n        \"\"\"\n        Returns the bucket's capacity.\n        \"\"\"\n        return self._capacity\n\nclass Well:\n    \"\"\"\n    Represents a single water well with its water content.\n    Calculates the total water units within the well.\n    \"\"\"\n    def __init__(self, well_content: list[int]):\n        self._content = well_content\n        self._water_units = self.calculate_water_units()\n\n    def calculate_water_units(self) -> int:\n        \"\"\"\n        Calculates the total number of water units (1s) in the well.\n        \"\"\"\n        return sum(self._content)\n\n    def get_water_units(self) -> int:\n        \"\"\"\n        Returns the total water units in the well.\n        \"\"\"\n        return self._water_units\n\nclass Grid:\n    \"\"\"\n    Manages the collection of wells, including structural validation.\n    Holds and provides access to individual Well objects.\n    \"\"\"\n    def __init__(self, grid_data: list[list[int]]):\n        self._grid_data = grid_data\n        self._wells: list[Well] = []\n        # Validation is designed here, but raising errors is forbidden by critical requirements.\n        self.validate_constraints()\n        self._populate_wells()\n\n    def validate_constraints(self):\n        \"\"\"\n        Validates the grid's structure, dimensions, and content.\n        No exceptions are raised per critical requirements.\n        \"\"\"\n        pass\n\n    def _populate_wells(self):\n        \"\"\"\n        Creates Well objects from the grid data.\n        \"\"\"\n        for well_content in self._grid_data:\n            self._wells.append(Well(well_content))\n\n    def get_wells(self) -> list[Well]:\n        \"\"\"\n        Returns a list of Well objects contained in the grid.\n        \"\"\"\n        return self._wells\n\ndef max_fill(grid: list[list[int]], capacity: int) -> int:\n    \"\"\"\n    Calculates the total number of bucket lowerings required to empty all wells.\n    Processes each well, determines water units, and aggregates lowering counts.\n    \"\"\"\n    total_lowerings = 0\n\n    grid_obj = Grid(grid)\n    bucket_obj = Bucket(capacity)\n    bucket_capacity = bucket_obj.get_capacity()\n\n    for well_obj in grid_obj.get_wells():\n        water_units = well_obj.get_water_units()\n        if water_units > 0:\n            lowerings_per_well = math.ceil(water_units / bucket_capacity)\n            total_lowerings += lowerings_per_well\n\n    return total_lowerings\n```"}
{"task_id": "HumanEval/116", "solution": "```python\ndef sort_array(arr):\n    \"\"\"\n    Sorts an array based on custom rules: negatives by value, non-negatives by bit count then value.\n    Negative numbers come before non-negative numbers in the final sorted array.\n    \"\"\"\n\n    def _count_set_bits(n):\n        \"\"\"Counts the number of set bits (1s) in the binary representation of a non-negative integer.\"\"\"\n        return bin(n).count('1')\n\n    non_negative_nums = []\n    negative_nums = []\n\n    for num in arr:\n        if num >= 0:\n            non_negative_nums.append(num)\n        else:\n            negative_nums.append(num)\n\n    # Sort non-negative numbers: primary by bit count, secondary by decimal value.\n    non_negative_nums.sort(key=lambda x: (_count_set_bits(x), x))\n\n    # Sort negative numbers by their decimal value in ascending order.\n    negative_nums.sort()\n\n    return negative_nums + non_negative_nums\n```"}
{"task_id": "HumanEval/117", "solution": "```python\nfrom typing import List\n\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is a vowel (case-insensitive).\n    Returns True if the character is 'a', 'e', 'i', 'o', or 'u', False otherwise.\n    \"\"\"\n    return char.lower() in 'aeiou'\n\ndef _count_consonants(word: str) -> int:\n    \"\"\"Counts the number of consonants in a given word.\n    It iterates through the word, classifying each letter as a vowel or consonant.\n    \"\"\"\n    count = 0\n    for char in word:\n        if char.isalpha() and not _is_vowel(char):\n            count += 1\n    return count\n\ndef _split_string_into_words(s: str) -> List[str]:\n    \"\"\"Splits an input string into a list of words.\n    It uses space as a delimiter and filters out any empty strings.\n    \"\"\"\n    return [word for word in s.split(' ') if word]\n\ndef select_words(s: str, n: int) -> List[str]:\n    \"\"\"Given a string s and a natural number n, you have been tasked to implement\n    a function that returns a list of all words from string s that contain exactly\n    n consonants, in order these words appear in the string s.\n    If the string s is empty then the function should return an empty list.\n    Note: you may assume the input string contains only letters and spaces.\n    Examples:\n    select_words(\"Mary had a little lamb\", 4) ==> [\"little\"]\n    select_words(\"Mary had a little lamb\", 3) ==> [\"Mary\", \"lamb\"]\n    select_words(\"simple white space\", 2) ==> []\n    select_words(\"Hello world\", 4) ==> [\"world\"]\n    select_words(\"Uncle sam\", 3) ==> [\"Uncle\"]\n    \"\"\"\n    if not s:\n        return []\n\n    words = _split_string_into_words(s)\n    result = []\n    for word in words:\n        if _count_consonants(word) == n:\n            result.append(word)\n    return result\n```"}
{"task_id": "HumanEval/117", "solution": "```python\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is a vowel, case-insensitively.\"\"\"\n    return char.lower() in {'a', 'e', 'i', 'o', 'u'}\n\ndef _count_consonants(word: str) -> int:\n    \"\"\"Counts the number of consonants in a word, case-insensitively.\"\"\"\n    consonant_count = 0\n    for char in word:\n        if char.isalpha() and not _is_vowel(char):\n            consonant_count += 1\n    return consonant_count\n\ndef _split_words(text: str) -> list[str]:\n    \"\"\"Splits a string into a list of words by spaces.\"\"\"\n    return text.split()\n\ndef select_words(s: str, n: int) -> list[str]:\n    \"\"\"\n    Given a string s and a natural number n, this function returns a list of all words\n    from string s that contain exactly n consonants, in their original order.\n    \"\"\"\n    if not s:\n        return []\n\n    words = _split_words(s)\n    result = []\n    for word in words:\n        if _count_consonants(word) == n:\n            result.append(word)\n    return result\n```\n"}
{"task_id": "HumanEval/118", "solution": "```python\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is an English vowel (case-sensitive).\"\"\"\n    return char in \"aeiouAEIOU\"\n\ndef _is_consonant(char: str) -> bool:\n    \"\"\"Checks if a character is an English consonant (case-sensitive).\"\"\"\n    return char.isalpha() and not _is_vowel(char)\n\ndef get_closest_vowel(word: str) -> str:\n    \"\"\"Finds the closest vowel from the right, surrounded by two consonants (case-sensitive).\n    Returns an empty string if no such vowel is found.\n    \"\"\"\n    if len(word) < 3:\n        return \"\"\n\n    # Iterate from right to left, excluding the first and last characters.\n    # The range is from len(word) - 2 down to 1 (inclusive).\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        char_before = word[i - 1]\n        char_after = word[i + 1]\n\n        if _is_vowel(current_char):\n            if _is_consonant(char_before) and _is_consonant(char_after):\n                return current_char\n\n    return \"\"\n```"}
{"task_id": "HumanEval/112", "solution": "```python\ndef _remove_characters(s: str, chars_to_remove: str) -> str:\n    \"\"\"Removes specified characters from a string.\"\"\"\n    chars_to_remove_set = set(chars_to_remove)\n    result_chars = []\n    for char_s in s:\n        if char_s not in chars_to_remove_set:\n            result_chars.append(char_s)\n    return \"\".join(result_chars)\n\ndef _is_palindrome(s: str) -> bool:\n    \"\"\"Checks if a string is a palindrome.\"\"\"\n    return s == s[::-1]\n\ndef reverse_delete(s,c):\n    \"\"\"Deletes specified characters from s and checks if the result is a palindrome.\n    Returns a tuple of the modified string and a boolean indicating palindrome status.\"\"\"\n    modified_s = _remove_characters(s, c)\n    is_pal = _is_palindrome(modified_s)\n    return (modified_s, is_pal)\n```"}
{"task_id": "HumanEval/113", "solution": "```python\ndef _count_odd_digits_in_string(s: str) -> int:\n    odd_count_val = 0\n    for char_digit in s:\n        digit = int(char_digit)\n        if digit % 2 != 0:\n            odd_count_val += 1\n    return odd_count_val\n\ndef _format_output_string(count: int) -> str:\n    template = \"the number of odd elements in the string i of the input.\"\n    return template.replace('i', str(count))\n\ndef odd_count(lst: list[str]) -> list[str]:\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\n\n    >>> odd_count(['1234567'])\n    [\"the number of odd elements 4n the str4ng 4 of the 4nput.\"]\n    >>> odd_count(['3',\"11111111\"])\n    [\"the number of odd elements 1n the str1ng 1 of the 1nput.\",\n     \"the number of odd elements 8n the str8ng 8 of the 8nput.\"]\n    \"\"\"\n    results = []\n    for s in lst:\n        odd_digits = _count_odd_digits_in_string(s)\n        formatted_string = _format_output_string(odd_digits)\n        results.append(formatted_string)\n    return results\n```"}
{"task_id": "HumanEval/119", "solution": "```python\ndef match_parens(lst):\n    '''\n    Checks if two strings of parentheses can be concatenated in any order to form a balanced string.\n    Returns 'Yes' if a balanced string can be formed, 'No' otherwise.\n    '''\n\n    def _is_balanced(s):\n        '''\n        Determines if a given string of parentheses is balanced.\n        It uses a counter to track open parentheses, ensuring it never drops below zero and ends at zero.\n        '''\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    def _validate_input(lst_input):\n        '''\n        Validates the input list, checking for exactly two string elements and content of '(' or ')'.\n        Returns True if the input is valid, False otherwise.\n        '''\n        if not (isinstance(lst_input, list) and len(lst_input) == 2):\n            return False\n\n        for s_element in lst_input:\n            if not isinstance(s_element, str):\n                return False\n            for char_in_s in s_element:\n                if char_in_s not in '()':\n                    return False\n        return True\n\n    if not _validate_input(lst):\n        return 'No'\n\n    s1 = lst[0]\n    s2 = lst[1]\n\n    # Check the first concatenation order: s1 + s2\n    if _is_balanced(s1 + s2):\n        return 'Yes'\n\n    # Check the second concatenation order: s2 + s1\n    if _is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'\n```"}
{"task_id": "HumanEval/118", "solution": "```python\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Determines if a given character is a vowel, performing case-sensitive comparison.\"\"\"\n    return char in \"AEIOUaeiou\"\n\ndef _is_consonant(char: str) -> bool:\n    \"\"\"Determines if a given character is a consonant, assuming it's an English letter.\"\"\"\n    # If the character is an English letter and not a vowel, it must be a consonant.\n    return not _is_vowel(char)\n\ndef get_closest_vowel(word: str) -> str:\n    \"\"\"Finds the closest vowel from the right side of the word that is between two consonants.\n    Returns an empty string if no such vowel is found.\n    \"\"\"\n    n = len(word)\n    # The first and last characters are excluded from the search range.\n    if n < 3:\n        return \"\"\n\n    # Iterate from the second-to-last character (index n-2) down to the second character (index 1).\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i - 1]\n        right_char = word[i + 1]\n\n        # Check if the current character is a vowel and its immediate neighbors are consonants.\n        if _is_vowel(current_char) and _is_consonant(left_char) and _is_consonant(right_char):\n            return current_char\n\n    return \"\"\n```"}
{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n\n    Example 1:\n\n        Input: arr = [-3, -4, 5], k = 3\n        Output: [-4, -3, 5]\n\n    Example 2:\n\n        Input: arr = [4, -4, 4], k = 2\n        Output: [4, 4]\n\n    Example 3:\n\n        Input: arr = [-3, 2, 1, 2, -1, -2, 1], k = 1\n        Output: [2]\n\n    Note:\n        1. The length of the array will be in the range of [1, 1000].\n        2. The elements in the array will be in the range of [-1000, 1000].\n        3. 0 <= k <= len(arr)\n    \"\"\"\n    if k == 0:\n        return []\n\n    arr.sort(reverse=True) # Sorts array to find k largest.\n    k_largest = arr[:k]\n\n    k_largest.sort() # Sorts the k largest in ascending order.\n\n    return k_largest"}
{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    if k == 0:\n        return []\n\n    # Sort the array in ascending order.\n    arr.sort()\n\n    # The last k elements will be the k maximum numbers, already sorted.\n    return arr[len(arr) - k:]"}
{"task_id": "HumanEval/121", "solution": "```python\ndef _is_odd(num: int) -> bool:\n    \"\"\"Checks if a number is odd.\n    Returns True if odd, False otherwise.\"\"\"\n    return num % 2 != 0\n\ndef solution(lst: list[int]) -> int:\n    \"\"\"Given a list of integers, return the sum of all odd elements that are in even positions.\n    An empty list will return 0.\"\"\"\n\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for index, element_value in enumerate(lst):\n        if index % 2 == 0:  # Check if the index is even (0-based)\n            if _is_odd(element_value): # Check if the element at this even index is odd\n                total_sum += element_value\n\n    return total_sum\n```"}
