{"task_id": "HumanEval/150", "solution": "```python\nimport math\n\ndef _is_prime(n: int) -> bool:\n    \"\"\"Checks if a number is prime using an efficient primality test.\n    Handles edge cases for 1 and 2, and efficiently checks odd divisors.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    # Iterate through odd numbers up to the square root of n.\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n\n    return True\n\ndef x_or_y(n, x, y):\n    \"\"\"Returns x if n is prime, otherwise returns y.\"\"\"\n    if _is_prime(n):\n        return x\n    else:\n        return y\n```"}
{"task_id": "HumanEval/150", "solution": "```python\ndef is_prime(num: int) -> bool:\n    \"\"\"Checks if a number is prime. Optimizes by checking divisors up to its square root.\"\"\"\n    if num < 2:\n        return False\n    for i in range(2, int(num**0.5) + 1):\n        if num % i == 0:\n            return False\n    return True\n\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n    \"\"\"\n    if is_prime(n):\n        return x\n    else:\n        return y\n```"}
{"task_id": "HumanEval/144", "solution": "```python\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n\n    class Fraction:\n        \"\"\"Represents a mathematical fraction with numerator and denominator.\"\"\"\n        def __init__(self, numerator: int, denominator: int):\n            self.numerator = numerator\n            self.denominator = denominator\n\n        @staticmethod\n        def parse(fraction_string: str) -> 'Fraction':\n            \"\"\"Parses a string in '<numerator>/<denominator>' format into a Fraction object.\"\"\"\n            parts = fraction_string.split('/')\n            numerator = int(parts[0])\n            denominator = int(parts[1])\n            return Fraction(numerator, denominator)\n\n        def multiply(self, other: 'Fraction') -> 'Fraction':\n            \"\"\"Multiplies this fraction by another fraction.\"\"\"\n            new_numerator = self.numerator * other.numerator\n            new_denominator = self.denominator * other.denominator\n            return Fraction(new_numerator, new_denominator)\n\n        def is_whole_number(self) -> bool:\n            \"\"\"Determines if the fraction represents a whole number.\"\"\"\n            # Handle potential division by zero, though problem states no zero denominator.\n            # This check is more robust for general fraction handling.\n            if self.denominator == 0:\n                # Or raise an error, depending on desired behavior for invalid state\n                return False\n            return self.numerator % self.denominator == 0\n\n    fraction_x = Fraction.parse(x)\n    fraction_n = Fraction.parse(n)\n    product_fraction = fraction_x.multiply(fraction_n)\n    return product_fraction.is_whole_number()\n```"}
{"task_id": "HumanEval/151", "solution": "```python\nclass InputList:\n    def __init__(self, numbers: list):\n        \"\"\"Initializes the InputList with the given numbers.\"\"\"\n        self.numbers = numbers\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the internal list of numbers is empty.\"\"\"\n        return not self.numbers\n\n    def __iter__(self):\n        \"\"\"Returns an iterator for the numbers list.\"\"\"\n        return iter(self.numbers)\n\n\nclass NumberElement:\n    def __init__(self, value: any):\n        \"\"\"Encapsulates a single number value for validation and calculation.\"\"\"\n        self.value = value\n\n    def is_integer(self) -> bool:\n        \"\"\"Checks if the encapsulated value is of integer type.\"\"\"\n        return isinstance(self.value, int)\n\n    def is_negative(self) -> bool:\n        \"\"\"Determines if the value is negative, returning False for non-numeric types.\"\"\"\n        if isinstance(self.value, (int, float)):\n            return self.value < 0\n        return False\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the value is an odd integer, assuming it is already a valid integer.\"\"\"\n        return self.value % 2 != 0\n\n    def get_square(self) -> int:\n        \"\"\"Calculates and returns the square of the value.\"\"\"\n        return self.value * self.value\n\n\nclass CalculationResult:\n    def __init__(self):\n        \"\"\"Initializes the accumulator for the sum of squares.\"\"\"\n        self.sum_of_squares_of_odds = 0\n\n    def add_square(self, square: int):\n        \"\"\"Adds a calculated square to the running total.\"\"\"\n        self.sum_of_squares_of_odds += square\n\n    def get_sum(self) -> int:\n        \"\"\"Returns the accumulated sum of squares of odd numbers.\"\"\"\n        return self.sum_of_squares_of_odds\n\n\ndef double_the_difference(lst: list) -> int:\n    \"\"\"\n    Calculates the sum of squares of odd, non-negative integers in a list.\n    It processes numbers using helper classes for validation and accumulation.\n    \"\"\"\n    input_list_obj = InputList(lst)\n\n    if input_list_obj.is_empty():\n        return 0\n\n    result_accumulator = CalculationResult()\n\n    for item_value in input_list_obj:\n        num_element = NumberElement(item_value)\n\n        if num_element.is_negative():\n            continue\n\n        if not num_element.is_integer():\n            continue\n\n        if not num_element.is_odd():\n            continue\n\n        square = num_element.get_square()\n        result_accumulator.add_square(square)\n\n    return result_accumulator.get_sum()\n```"}
{"task_id": "HumanEval/151", "solution": "```python\ndef double_the_difference(lst: list) -> int:\n    \"\"\"\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum = 0.0\n    for element in lst:\n        # Check if the number has an integer value, e.g., filters 3.5 but allows 3.0.\n        # This acts as a filter for \"not integers\" without using isinstance.\n        if element % 1 != 0:\n            continue\n\n        # Filter negative numbers.\n        if element < 0:\n            continue\n\n        # Filter even numbers; only odd numbers proceed.\n        if element % 2 == 0:\n            continue\n\n        # If all filters pass, calculate the square and add to sum.\n        total_sum += element * element\n\n    return int(total_sum)\n```"}
{"task_id": "HumanEval/152", "solution": "```python\ndef compare(game,guess):\n    \"\"\"I think we all remember that feeling when the result of some long-awaited\n    event is finally known. The feelings and thoughts you have at that moment are\n    definitely worth noting down and comparing.\n    Your task is to determine if a person correctly guessed the results of a number of matches.\n    You are given two arrays of scores and guesses of equal length, where each index shows a match.\n    Return an array of the same length denoting how far off each guess was. If they have guessed correctly,\n    the value is 0, and if not, the value is the absolute difference between the guess and the score.\n\n\n    example:\n\n    compare([1,2,3,4,5,1],[1,2,3,4,2,-2]) -> [0,0,0,0,3,3]\n    compare([0,5,0,0,0,4],[4,1,1,0,0,-2]) -> [4,4,1,0,0,6]\n    \"\"\"\n    result = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            result.append(0)\n        else:\n            result.append(abs(game[i] - guess[i]))\n    return result\n```"}
{"task_id": "HumanEval/153", "solution": "def calculate_strength(extension_name: str) -> int:\n    \"\"\"Calculates the strength of an extension name (CAP - SM).\"\"\"\n    uppercase_count = 0\n    lowercase_count = 0\n    for char in extension_name:\n        if 'A' <= char <= 'Z':\n            uppercase_count += 1\n        elif 'a' <= char <= 'z':\n            lowercase_count += 1\n    return uppercase_count - lowercase_count\n\ndef Strongest_Extension(class_name: str, extensions: list[str]) -> str:\n    \"\"\"Finds the strongest extension for a given class name, applying tie-breaking rules.\"\"\"\n    max_strength = float('-inf')\n    strongest_extension_name = \"\"\n\n    for extension in extensions:\n        current_strength = calculate_strength(extension)\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/153", "solution": "```python\nclass Extension:\n    \"\"\"Represents an extension, calculating its strength from letter counts.\"\"\"\n    def __init__(self, name: str):\n        self.name = name\n        self.uppercase_count = 0\n        self.lowercase_count = 0\n        self.strength = 0\n\n    def calculate_strength(self) -> int:\n        \"\"\"Determines the extension's strength as uppercase count minus lowercase count.\"\"\"\n        for char in self.name:\n            if char.isupper():\n                self.uppercase_count += 1\n            elif char.islower():\n                self.lowercase_count += 1\n        self.strength = self.uppercase_count - self.lowercase_count\n        return self.strength\n\ndef Strongest_Extension(class_name: str, extensions: list[str]) -> str:\n    \"\"\"\n    Finds the strongest extension for a class based on its strength (CAP - SM).\n    Returns a formatted string \"ClassName.StrongestExtensionName\".\n    \"\"\"\n    max_strength = float('-inf')\n    strongest_extension_name = \"\"\n\n    for ext_name in extensions:\n        ext_obj = Extension(ext_name)\n        current_strength = ext_obj.calculate_strength()\n\n        # Update if a stronger extension is found; ties go to the first in the list.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = ext_name\n\n    return f\"{class_name}.{strongest_extension_name}\"\n```"}
{"task_id": "HumanEval/154", "solution": "```python\ndef cycpattern_check(a, b):\\\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\"\"\"\n    if not b:\n        return True  # An empty string is always a substring of any string (including an empty string).\n\n    len_b = len(b)\n    for i in range(len_b):\n        # Generate a cyclic rotation of b\n        rotated_b = b[i:] + b[:i]\n        # Check if the current rotation is a substring of a\n        if rotated_b in a:\n            return True\n\n    # If no rotation was found as a substring after checking all possibilities\n    return False\n```"}
{"task_id": "HumanEval/155", "solution": "```python\ndef even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    abs_num = abs(num)\n    num_str = str(abs_num)\n\n    even_count = 0\n    odd_count = 0\n\n    for digit_char in num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)\n```"}
{"task_id": "HumanEval/154", "solution": "```python\ndef cycpattern_check(a, b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word.\"\"\"\n\n    if not b:\n        return True\n\n    if not a:\n        return False\n\n    if len(b) > len(a):\n        return False\n\n    doubled_b = b + b\n\n    for i in range(len(b)):\n        current_rotation = doubled_b[i : i + len(b)]\n        if current_rotation in a:\n            return True\n\n    return False\n```"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Converts a positive integer (1-1000) to its lowercase Roman numeral equivalent.\n    The function trusts the input to be within the valid range.\n    \"\"\"\n    roman_map = [\n        (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n        (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n        (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'), (1, 'i')\n    ]\n\n    result = \"\"\n    for value, symbol in roman_map:\n        while number >= value:\n            result += symbol\n            number -= value\n    return result"}
{"task_id": "HumanEval/155", "solution": "```python\ndef even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    abs_num = abs(num)\n    even_count = 0\n    odd_count = 0\n\n    # Handle the special case of 0 separately, as str(0) is '0', which is even.\n    if abs_num == 0:\n        return (1, 0)\n\n    for digit_char in str(abs_num):\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)\n```"}
{"task_id": "HumanEval/147", "solution": "```python\nimport math\n\ndef _combinations(count, k):\n    \"\"\"\n    Calculates the number of combinations 'count choose k'.\n    Returns 0 if k is less than 0 or greater than count.\n    \"\"\"\n    if k < 0 or k > count:\n        return 0\n    if k == 0 or k == count:\n        return 1\n    if k > count // 2:\n        k = count - k\n\n    # Using math.comb for efficiency and correctness in Python 3.8+.\n    # For older Python, a manual factorial calculation would be needed.\n    return math.comb(count, k)\n\ndef _calculate_remainder_counts(n):\n    \"\"\"\n    Calculates the count of a[i] values (where a[i] = i*i - i + 1)\n    based on their remainder modulo 3 for i from 1 to n.\n    \"\"\"\n    remainder_counts = {0: 0, 1: 0}\n    for i in range(1, n + 1):\n        # The pattern for (i*i - i + 1) % 3 is: 1 if i%3=0 or i%3=1, and 0 if i%3=2.\n        i_mod_3 = i % 3\n        if i_mod_3 == 2:\n            remainder_counts[0] += 1\n        else:\n            remainder_counts[1] += 1\n    return remainder_counts\n\ndef get_max_triples(n):\n    \"\"\"\n    Counts triples (a[i], a[j], a[k]) from a where a[x] = x*x - x + 1 and i < j < k.\n    The sum a[i] + a[j] + a[k] must be a multiple of 3.\n    \"\"\"\n    # The array 'a' is not materialized; counts of elements by (a[i] % 3) are used instead.\n    # A sum a[i] + a[j] + a[k] is divisible by 3 if all three a[x] have the same remainder modulo 3.\n    remainder_counts = _calculate_remainder_counts(n)\n    count_rem0 = remainder_counts[0]\n    count_rem1 = remainder_counts[1]\n\n    total_triples = 0\n\n    # Counts triples where all three elements have remainder 0 modulo 3.\n    total_triples += _combinations(count_rem0, 3)\n\n    # Counts triples where all three elements have remainder 1 modulo 3.\n    total_triples += _combinations(count_rem1, 3)\n\n    # Returns the total count of such triples.\n    return total_triples\n```"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    '''\n    epsilon = 1e-9 # Epsilon for floating-point comparisons to handle precision errors.\n\n    a_sq = a * a\n    b_sq = b * b\n    c_sq = c * c\n\n    # Check if any permutation of the sides satisfies the Pythagorean theorem.\n    if abs(a_sq + b_sq - c_sq) < epsilon:\n        return True\n    if abs(a_sq + c_sq - b_sq) < epsilon:\n        return True\n    if abs(b_sq + c_sq - a_sq) < epsilon:\n        return True\n\n    return False"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n\n    find_max([\"name\", \"of\", \"string\"]) == \"string\"\n    find_max([\"name\", \"enam\", \"game\"]) == \"enam\"\n    find_max([\"aaaaaaa\", \"bb\" ,\"cc\"]) == \"aaaaaaa\"\n    \"\"\"\n    if not words:\n        return \"\"\n\n    result_word = words[0]\n    max_unique_count = len(set(words[0]))\n\n    for i in range(1, len(words)):\n        current_word = words[i]\n        current_unique_count = len(set(current_word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = current_word\n        elif current_unique_count == max_unique_count:\n            # If unique counts are equal, choose the lexicographically smaller word\n            if current_word < result_word:\n                result_word = current_word\n\n    return result_word"}
{"task_id": "HumanEval/152", "solution": "```python\ndef compare(game,guess):\n    \"\"\"Your task is to determine if a person correctly guessed the results of a number of matches.\n    Return an array of the same length denoting how far off each guess was.\n    \"\"\"\n    differences_array = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            differences_array.append(0)\n        else:\n            differences_array.append(abs(game[i] - guess[i]))\n    return differences_array\n```"}
{"task_id": "HumanEval/158", "solution": "```python\ndef find_max(words: list[str]) -> str:\n    \"\"\"\n    Finds the string with the most unique characters, applying lexicographical tie-breaking.\n    Returns an empty string if the input list is empty.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_chars = -1\n    result_word = \"\"\n\n    for word in words:\n        # Calculate unique characters for the current word\n        current_unique_chars = len(set(word))\n\n        # Compare and update based on unique char count and lexicographical order\n        if current_unique_chars > max_unique_chars:\n            max_unique_chars = current_unique_chars\n            result_word = word\n        elif current_unique_chars == max_unique_chars:\n            # Apply lexicographical tie-breaking\n            if result_word == \"\" or word < result_word:\n                result_word = word\n\n    return result_word\n```"}
{"task_id": "HumanEval/159", "solution": "```python\ndef eat(number, need, remaining):\n    \"\"\"\n    Calculates the outcome of a rabbit's meal, determining total carrots eaten\n    and remaining based on initial conditions. It ensures the rabbit eats\n    what is available or needed, whichever is less.\n    \"\"\"\n    carrots_eaten_in_current_meal = min(need, remaining)\n    total_eaten_carrots = number + carrots_eaten_in_current_meal\n    final_remaining_carrots = remaining - carrots_eaten_in_current_meal\n    return [total_eaten_carrots, final_remaining_carrots]\n```"}
{"task_id": "HumanEval/159", "solution": "```python\ndef eat(number, need, remaining):\n    \"\"\"\n    Calculates total carrots eaten and remaining after a rabbit's meal.\n    It considers carrots already eaten, current need, and available stock.\n    \"\"\"\n\n    eaten_carrots_for_meal = 0\n    carrots_left_after_meal = 0\n\n    if remaining >= need:\n        # Rabbit eats the full needed amount if sufficient stock.\n        eaten_carrots_for_meal = need\n        carrots_left_after_meal = remaining - need\n    else:\n        # Rabbit eats all remaining carrots if stock is insufficient.\n        eaten_carrots_for_meal = remaining\n        carrots_left_after_meal = 0\n\n    total_eaten_carrots_after_meal = number + eaten_carrots_for_meal\n\n    return [total_eaten_carrots_after_meal, carrots_left_after_meal]\n```"}
{"task_id": "HumanEval/160", "solution": "```python\ndef do_algebra(operator: list[str], operand: list[int]) -> float:\n    \"\"\"Builds and evaluates an algebraic expression from given operators and operands.\n    It supports standard arithmetic operations including addition, subtraction, multiplication, floor division, and exponentiation, following standard precedence.\n    \"\"\"\n\n    def _build_expression_string(op_list: list[str], val_list: list[int]) -> str:\n        \"\"\"Constructs the algebraic expression string by interleaving operands and operators.\"\"\"\n        expression_parts = []\n        for i in range(len(op_list)):\n            expression_parts.append(str(val_list[i]))\n            expression_parts.append(op_list[i])\n        expression_parts.append(str(val_list[-1]))\n        return \" \".join(expression_parts)\n\n    def _evaluate_expression_string(expression_str: str) -> float:\n        \"\"\"Evaluates the constructed expression string using Python's eval function.\"\"\"\n        return float(eval(expression_str))\n\n    expression = _build_expression_string(operator, operand)\n    result = _evaluate_expression_string(expression)\n    return result\n```"}
{"task_id": "HumanEval/160", "solution": "```python\ndef do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator and operand, builds and evaluates an algebraic expression.\n    Returns the numerical result, or raises ValueError/ZeroDivisionError on invalid input/operation.\n    \"\"\"\n\n    def _validate_inputs(operators_list: list[str], operands_list: list[int]) -> None:\n        \"\"\"\n        Enforces input constraints on operator and operand lists.\n        Raises ValueError if any validation rule is violated.\n        \"\"\"\n        if not (len(operators_list) == len(operands_list) - 1):\n            raise ValueError(\"Operator list length must be operand list length minus one.\")\n        if not (len(operators_list) >= 1):\n            raise ValueError(\"Operator list must contain at least one operator.\")\n        if not (len(operands_list) >= 2):\n            raise ValueError(\"Operand list must contain at least two operands.\")\n\n        for op_val in operands_list:\n            if not isinstance(op_val, int) or op_val < 0:\n                raise ValueError(\"All operands must be non-negative integers.\")\n\n    def _build_expression_string(operators_list: list[str], operands_list: list[int]) -> str:\n        \"\"\"\n        Constructs the algebraic expression string by interleaving operands and operators.\n        \"\"\"\n        expression_parts = [str(operands_list[0])]\n        for i in range(len(operators_list)):\n            expression_parts.append(operators_list[i])\n            expression_parts.append(str(operands_list[i + 1]))\n        return \" \".join(expression_parts)\n\n    def _evaluate_expression_string(expression_string: str) -> int | float:\n        \"\"\"\n        Evaluates the algebraic expression string respecting standard mathematical precedence.\n        Propagates ZeroDivisionError if division by zero occurs.\n        \"\"\"\n        return eval(expression_string)\n\n    _validate_inputs(operator, operand)\n    expression_string = _build_expression_string(operator, operand)\n    result = _evaluate_expression_string(expression_string)\n    return result\n```"}
{"task_id": "HumanEval/162", "solution": "```python\nimport hashlib\n\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n\n    # Encode the string and compute the MD5 hash.\n    md5_hash = hashlib.md5(text.encode('utf-8')).hexdigest()\n    return md5_hash\n```"}
{"task_id": "HumanEval/162", "solution": "import hashlib\nfrom typing import Optional\n\ndef string_to_md5(text: str) -> Optional[str]:\n    \"\"\"\n    Computes the MD5 hash of a string, returning it as a hexadecimal string.\n    Returns None if the input string is empty.\n    \"\"\"\n    if not text:\n        return None\n    md5_hash = hashlib.md5()\n    md5_hash.update(text.encode('utf-8'))\n    return md5_hash.hexdigest()"}
{"task_id": "HumanEval/156", "solution": "```python\nROMAN_MAP = [\n    (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n    (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n    (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'), (1, 'i')\n]\n\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    roman_numeral = []\n    temp_num = number\n    for value, symbol in ROMAN_MAP:\n        while temp_num >= value:\n            roman_numeral.append(symbol)\n            temp_num -= value\n    return \"\".join(roman_numeral)\n```"}
{"task_id": "HumanEval/161", "solution": "```python\ndef solve(s: str) -> str:\n    \"\"\"\n    Processes a string s according to specific rules for letter case and string reversal.\n    Returns the resulting modified string after applying the rules.\n    \"\"\"\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    if not has_letters:\n        return s[::-1]\n    else:\n        result_chars = []\n        for char in s:\n            if char.isalpha():\n                if char.islower():\n                    result_chars.append(char.upper())\n                else:\n                    result_chars.append(char.lower())\n            else:\n                result_chars.append(char)\n        return ''.join(result_chars)\n```"}
{"task_id": "HumanEval/163", "solution": "```python\ndef _is_single_digit(num: int) -> bool:\n    \"\"\"Checks if a number is a single-digit integer (0-9 inclusive).\"\"\"\n    return 0 <= num <= 9\n\ndef _is_even(num: int) -> bool:\n    \"\"\"Checks if a number is an even integer.\"\"\"\n    return num % 2 == 0\n\ndef generate_integers(a: int, b: int) -> list[int]:\n    \"\"\"\n    Generates a sorted list of even, single-digit integers within an inclusive range.\n    The list is sorted in ascending order.\n    \"\"\"\n    result = []\n    start = min(a, b)\n    end = max(a, b)\n\n    for i in range(start, end + 1):\n        if _is_single_digit(i) and _is_even(i):\n            result.append(i)\n\n    return result\n```"}
{"task_id": "HumanEval/163", "solution": "```python\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    min_val, max_val = min(a, b), max(a, b)\n    return [num for num in range(min_val, max_val + 1) if num % 2 == 0]\n```"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given three side lengths, return True if they form a right-angled triangle.\n    It checks all permutations of the Pythagorean theorem.\n    '''\n    a_sq = a * a\n    b_sq = b * b\n    c_sq = c * c\n\n    # Check the three possible permutations of the Pythagorean theorem\n    if (a_sq + b_sq == c_sq) or \\\n       (a_sq + c_sq == b_sq) or \\\n       (b_sq + c_sq == a_sq):\n        return True\n    else:\n        return False"}
{"task_id": "HumanEval/161", "solution": "```python\ndef _is_letter(c):\n    \"\"\"Checks if a character is an alphabet letter.\"\"\"\n    return 'a' <= c <= 'z' or 'A' <= c <= 'Z'\n\ndef _reverse_case(c):\n    \"\"\"Reverses the case of a letter character.\"\"\"\n    if 'a' <= c <= 'z':\n        return c.upper()\n    elif 'A' <= c <= 'Z':\n        return c.lower()\n    return c\n\ndef _has_letters(s):\n    \"\"\"Determines if the string contains any letters.\"\"\"\n    for char in s:\n        if _is_letter(char):\n            return True\n    return False\n\ndef _reverse_string(s):\n    \"\"\"Reverses the entire input string.\"\"\"\n    return s[::-1]\n\ndef solve(s):\n    \"\"\"Processes a string: reverses letter cases or reverses the entire string if no letters are present.\"\"\"\n    if not _has_letters(s):\n        return _reverse_string(s)\n\n    result_chars = []\n    for char in s:\n        if _is_letter(char):\n            result_chars.append(_reverse_case(char))\n        else:\n            result_chars.append(char)\n\n    return \"\".join(result_chars)\n```\n"}
