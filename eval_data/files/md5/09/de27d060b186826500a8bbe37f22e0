{"task_id": "HumanEval/138", "solution": "```python\ndef is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers\n    Example\n    is_equal_to_sum_even(4) == False\n    is_equal_to_sum_even(6) == False\n    is_equal_to_sum_even(8) == True\n    \"\"\"\n    # The smallest sum of four positive even numbers is 2 + 2 + 2 + 2 = 8.\n    # Any sum of even numbers must itself be an even number.\n    return n >= 8 and n % 2 == 0\n```"}
{"task_id": "HumanEval/133", "solution": "```python\nimport math\n\ndef sum_squares(lst):\n    \"\"\"Calculates the sum of squared ceiling numbers from a list.\n    Each number in the list is rounded up, then squared, and finally summed.\n    \"\"\"\n\n    # Custom ceil implementation to satisfy \"Every function you call must be defined inline in your response.\"\n    def _my_ceil(x: float) -> int:\n        \"\"\"Returns the smallest integer greater than or equal to x.\"\"\"\n        if x == int(x):\n            return int(x)\n        return int(x) + 1 if x > 0 else int(x)\n\n    class Number:\n        \"\"\"Encapsulates a numerical value and provides methods for ceiling and squaring.\"\"\"\n        def __init__(self, value: float):\n            self.value = value\n\n        def round_to_ceiling(self) -> int:\n            \"\"\"Returns the smallest integer greater than or equal to the value.\"\"\"\n            return _my_ceil(self.value)\n\n        def square(self) -> int:\n            \"\"\"Returns the square of the ceiling-rounded integer value.\"\"\"\n            ceiling_val = self.round_to_ceiling()\n            return ceiling_val * ceiling_val\n\n    class Calculator:\n        \"\"\"Orchestrates calculation of the sum of squared ceiling numbers.\"\"\"\n        def calculate_sum_of_squared_ceiling_numbers(self, numbers: list[float]) -> int:\n            \"\"\"Iterates through numbers, applies ceiling and square operations, and sums results.\"\"\"\n            total_sum = 0\n            for value in numbers:\n                num_obj = Number(value)\n                # As per sequence diagram, round_to_ceiling is called, though its result isn't directly passed to square.\n                _ = num_obj.round_to_ceiling()\n                squared_value = num_obj.square()\n                total_sum += squared_value\n            return total_sum\n\n    calculator = Calculator()\n    return calculator.calculate_sum_of_squared_ceiling_numbers(lst)\n```\n"}
{"task_id": "HumanEval/139", "solution": "```python\ndef special_factorial(n: int) -> int:\n    \"\"\"The Brazilian factorial is defined as: n! * (n-1)! * ... * 1!\"\"\"\n    def _calculate_factorial(k: int) -> int:\n        \"\"\"Calculates the factorial of a positive integer k.\"\"\"\n        product = 1\n        for i in range(1, k + 1):\n            product *= i\n        return product\n\n    total_special_factorial = 1\n    for i in range(1, n + 1):\n        current_factorial = _calculate_factorial(i)\n        total_special_factorial *= current_factorial\n    return total_special_factorial\n```"}
{"task_id": "HumanEval/140", "solution": "```python\nimport re\n\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores.\n    If a string has more than 2 consecutive spaces, replace all consecutive spaces with a hyphen.\n    \"\"\"\n    # Apply rule for 3 or more consecutive spaces first (replace with hyphen)\n    modified_text = re.sub(r' {3,}', '-', text)\n    # Then, apply rule for single spaces (replace with underscore)\n    final_text = re.sub(r' ', '_', modified_text)\n    return final_text\n```"}
{"task_id": "HumanEval/139", "solution": "```python\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n\n    def factorial(k):\n        \"\"\"Computes the standard factorial of an integer k.\"\"\"\n        result = 1\n        for i in range(1, k + 1):\n            result *= i\n        return result\n\n    brazilian_fact_result = 1\n    for i in range(1, n + 1):\n        brazilian_fact_result *= factorial(i)\n\n    return brazilian_fact_result\n```"}
{"task_id": "HumanEval/140", "solution": "```python\nimport re\n\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n\n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    # Replace sequences of three or more consecutive spaces with a hyphen.\n    modified_text = re.sub(r' {3,}', '-', text)\n    # Replace any remaining single spaces with an underscore.\n    modified_text = modified_text.replace(' ', '_')\n    return modified_text\n```"}
{"task_id": "HumanEval/143", "solution": "```python\ndef _validate_sentence(sentence: str) -> bool:\n    \"\"\"Checks if the sentence length is between 1 and 100, and contains only letters and spaces.\"\"\"\n    if not (1 <= len(sentence) <= 100):\n        return False\n    if not sentence.replace(' ', '').isalpha():\n        return False\n    return True\n\ndef _is_prime(n: int) -> bool:\n    \"\"\"Determines if a given integer is a prime number.\"\"\"\n    if n < 2:\n        return False\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            return False\n    return True\n\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Returns a string containing words from the input sentence whose lengths are prime numbers,\n    maintaining original order and separated by single spaces.\n    \"\"\"\n    if not _validate_sentence(sentence):\n        return \"\"\n\n    prime_length_words = []\n    words = sentence.split(' ')\n\n    for word in words:\n        if _is_prime(len(word)):\n            prime_length_words.append(word)\n\n    return ' '.join(prime_length_words)\n```"}
{"task_id": "HumanEval/141", "solution": "```python\nclass FileName:\n    \"\"\"Encapsulates a file name and its validation logic.\n\n    Performs all necessary checks upon initialization and stores the overall validity.\n    \"\"\"\n    def __init__(self, file_name: str):\n        self._full_name = file_name\n        self._is_valid = True # Assume valid until a rule is broken\n\n        self._digits_count = self._count_digits()\n        if not self._validate_digit_count():\n            self._is_valid = False\n\n        self._dot_count = self._count_dots()\n        if not self._validate_dot_count():\n            self._is_valid = False\n\n        # Only proceed with prefix/suffix extraction and validation if dot count is valid.\n        self._prefix = \"\"\n        self._suffix = \"\"\n        if self._is_valid:\n            self._extract_prefix_suffix()\n\n            if not self._validate_prefix_not_empty():\n                self._is_valid = False\n\n            if not self._validate_prefix_starts_with_letter():\n                self._is_valid = False\n\n            if not self._validate_suffix_type():\n                self._is_valid = False\n\n    def _count_digits(self) -> int:\n        \"\"\"Counts the number of digits in the file name.\"\"\"\n        return sum(1 for char in self._full_name if '0' <= char <= '9')\n\n    def _count_dots(self) -> int:\n        \"\"\"Counts the number of dots in the file name.\"\"\"\n        return self._full_name.count('.')\n\n    def _extract_prefix_suffix(self):\n        \"\"\"Extracts the prefix and suffix, assuming exactly one dot is present.\"\"\"\n        parts = self._full_name.split('.', 1)\n        self._prefix = parts[0]\n        self._suffix = parts[1]\n\n    def _validate_digit_count(self) -> bool:\n        \"\"\"Checks if the digit count is not more than three.\"\"\"\n        return self._digits_count <= 3\n\n    def _validate_dot_count(self) -> bool:\n        \"\"\"Checks if the file name contains exactly one dot.\"\"\"\n        return self._dot_count == 1\n\n    def _validate_prefix_not_empty(self) -> bool:\n        \"\"\"Checks if the prefix substring is not empty.\"\"\"\n        return bool(self._prefix)\n\n    def _validate_prefix_starts_with_letter(self) -> bool:\n        \"\"\"Checks if the prefix starts with a Latin alphabet letter.\"\"\"\n        if not self._prefix:\n            return False\n        first_char = self._prefix[0]\n        return ('a' <= first_char <= 'z') or ('A' <= first_char <= 'Z')\n\n    def _validate_suffix_type(self) -> bool:\n        \"\"\"Checks if the suffix is one of the allowed types.\"\"\"\n        allowed_suffixes = ['txt', 'exe', 'dll']\n        return self._suffix in allowed_suffixes\n\n    def is_valid(self) -> bool:\n        \"\"\"Returns the overall validation status of the file name.\"\"\"\n        return self._is_valid\n\n\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions\n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from\n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n    validator = FileName(file_name)\n    if validator.is_valid():\n        return 'Yes'\n    else:\n        return 'No'\n\n```"}
{"task_id": "HumanEval/142", "solution": "```python\ndef sum_squares(lst: list[int]) -> int:\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n\n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for i, val in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += val * val\n        elif i % 4 == 0: # This implicitly means i % 3 != 0 due to the `if` above\n            total_sum += val * val * val\n        else:\n            total_sum += val\n\n    return total_sum\n```\n"}
{"task_id": "HumanEval/142", "solution": "```python\ndef sum_squares(lst):\n    \"\"\"\n    This function processes a list of integers, applying transformations based on index.\n    It squares elements at indices that are multiples of 3, cubes elements at indices that are multiples of 4 but not 3, and sums all processed elements.\n    \"\"\"\n    total_sum = 0\n\n    if not lst:\n        return 0\n\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += num * num\n        elif i % 4 == 0:  # Implies i % 3 != 0 due to previous condition\n            total_sum += num * num * num\n        else:\n            total_sum += num\n\n    return total_sum\n```"}
{"task_id": "HumanEval/141", "solution": "```python\nclass FileNameValidator:\n    \"\"\"Encapsulates file name validation logic.\"\"\"\n\n    def __init__(self, file_name: str):\n        self._file_name = file_name\n        self._digits_count = 0\n        self._dot_count = 0\n        self._prefix = \"\"\n        self._suffix = \"\"\n        self._is_valid = True\n        self._allowed_suffixes = ['txt', 'exe', 'dll']\n\n    def _check_digit_count(self) -> None:\n        \"\"\"Checks if the file name has more than three digits.\"\"\"\n        for char in self._file_name:\n            if '0' <= char <= '9':\n                self._digits_count += 1\n        if self._digits_count > 3:\n            self._is_valid = False\n\n    def _check_dot_count(self) -> None:\n        \"\"\"Checks if the file name contains exactly one dot.\"\"\"\n        for char in self._file_name:\n            if char == '.':\n                self._dot_count += 1\n        if self._dot_count != 1:\n            self._is_valid = False\n\n    def _extract_parts(self) -> None:\n        \"\"\"Extracts prefix and suffix if a single dot exists.\"\"\"\n        if not self._is_valid:\n            return\n\n        parts = self._file_name.split('.', 1)\n        if len(parts) == 2:\n            self._prefix = parts[0]\n            self._suffix = parts[1]\n        else:\n            self._is_valid = False\n\n    def _check_prefix_not_empty(self) -> None:\n        \"\"\"Checks if the prefix before the dot is not empty.\"\"\"\n        if not self._is_valid:\n            return\n        if not self._prefix:\n            self._is_valid = False\n\n    def _check_prefix_starts_with_letter(self) -> None:\n        \"\"\"Checks if the prefix starts with a Latin alphabet letter.\"\"\"\n        if not self._is_valid:\n            return\n        if not self._prefix: # Safety check, should be caught by _check_prefix_not_empty\n            self._is_valid = False\n            return\n        first_char = self._prefix[0]\n        if not ('a' <= first_char <= 'z' or 'A' <= first_char <= 'Z'):\n            self._is_valid = False\n\n    def _check_suffix_type(self) -> None:\n        \"\"\"Checks if the suffix is one of the allowed types.\"\"\"\n        if not self._is_valid:\n            return\n        if self._suffix not in self._allowed_suffixes:\n            self._is_valid = False\n\n    def validate(self) -> bool:\n        \"\"\"Orchestrates all validation checks and returns overall validity.\"\"\"\n        self._check_digit_count()\n        if not self._is_valid:\n            return False\n\n        self._check_dot_count()\n        if not self._is_valid:\n            return False\n\n        if self._dot_count == 1:\n            self._extract_parts()\n            if not self._is_valid:\n                return False\n\n            self._check_prefix_not_empty()\n            if not self._is_valid:\n                return False\n\n            self._check_prefix_starts_with_letter()\n            if not self._is_valid:\n                return False\n\n            self._check_suffix_type()\n            if not self._is_valid:\n                return False\n\n        return self._is_valid\n\n\ndef file_name_check(file_name: str) -> str:\n    \"\"\"\n    Checks if a file name is valid based on several conditions.\n    Returns 'Yes' if valid, 'No' otherwise.\n    \"\"\"\n    validator = FileNameValidator(file_name)\n    is_valid = validator.validate()\n    return 'Yes' if is_valid else 'No'\n```"}
{"task_id": "HumanEval/143", "solution": "```python\nimport math\n\ndef is_prime(n: int) -> bool:\n    \"\"\"\n    Checks if a given integer n is a prime number.\n    Returns True if n is prime, False otherwise.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\n\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Filters words from a sentence, returning only those with prime lengths.\n    Words maintain their original order in the output string.\n    \"\"\"\n    collected_words = []\n    words = sentence.split()\n    for word in words:\n        if is_prime(len(word)):\n            collected_words.append(word)\n    return \" \".join(collected_words)\n```"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    \"\"\"Represents a fraction with a numerator and a denominator.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        self.numerator = numerator\n        self.denominator = denominator\n\n    @staticmethod\n    def parse(fraction_string: str) -> 'Fraction':\n        \"\"\"Parses a fraction string into a Fraction object.\"\"\"\n        num_str, den_str = fraction_string.split('/')\n        return Fraction(int(num_str), int(den_str))\n\n    def multiply(self, other: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another fraction.\"\"\"\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Determines if the fraction represents a whole number.\"\"\"\n        return self.numerator % self.denominator == 0\n\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"\n    Checks if the product of two fractional strings evaluates to a whole number.\n    Uses a Fraction class to handle fraction arithmetic.\n    \"\"\"\n    fraction_x = Fraction.parse(x)\n    fraction_n = Fraction.parse(n)\n    product_fraction = fraction_x.multiply(fraction_n)\n    return product_fraction.is_whole_number()"}
{"task_id": "HumanEval/146", "solution": "```python\ndef _is_greater_than_10(number: int) -> bool:\n    \"\"\"Checks if a number is greater than 10.\"\"\"\n    return number > 10\n\n\ndef _get_first_digit(number: int) -> int:\n    \"\"\"Determines the first digit of a number, ignoring its sign. Handles 0 gracefully.\"\"\"\n    abs_number = abs(number)\n    if abs_number == 0:\n        return 0\n    return int(str(abs_number)[0])\n\n\ndef _get_last_digit(number: int) -> int:\n    \"\"\"Determines the last digit of a number, ignoring its sign.\"\"\"\n    abs_number = abs(number)\n    return abs_number % 10\n\n\ndef _is_odd_digit(digit: int) -> bool:\n    \"\"\"Checks if a digit is odd (1, 3, 5, 7, 9).\"\"\"\n    return digit in {1, 3, 5, 7, 9}\n\n\ndef specialFilter(nums: list[int]) -> int:\n    \"\"\"\n    Counts numbers greater than 10 with both first and last digits odd.\n    It iterates through the input array and applies helper functions for checks.\n    \"\"\"\n    count = 0\n    for number in nums:\n        is_gt_10 = _is_greater_than_10(number)\n        first_digit = _get_first_digit(number)\n        is_first_digit_odd = _is_odd_digit(first_digit)\n        last_digit = _get_last_digit(number)\n        is_last_digit_odd = _is_odd_digit(last_digit)\n\n        if is_gt_10 and is_first_digit_odd and is_last_digit_odd:\n            count += 1\n    return count\n```"}
{"task_id": "HumanEval/145", "solution": "```python\ndef order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers based on the sum of their absolute digits,\n    using the original index as a tie-breaker.\n    \"\"\"\n\n    if not nums:\n        return []\n\n    def _calculate_digit_sum(number: int) -> int:\n        \"\"\"\n        Calculates the sum of the absolute values of digits for a given number.\n        It converts the number to its absolute string representation and sums its digits.\n        \"\"\"\n        s = 0\n        for digit_char in str(abs(number)):\n            s += int(digit_char)\n        return s\n\n    # Augment each number with its digit sum and original index.\n    # The tuple (digit_sum, original_index, value) is used, so Python's\n    # default tuple comparison handles sorting by primary then secondary key.\n    augmented_data = []\n    for index, value in enumerate(nums):\n        digit_sum = _calculate_digit_sum(value)\n        augmented_data.append((digit_sum, index, value))\n\n    # Sort the augmented data. Python's default tuple comparison will\n    # sort by digit_sum first (ascending), then original_index (ascending).\n    sorted_augmented_data = sorted(augmented_data)\n\n    # Extract the original integer values from the sorted data.\n    result = [item[2] for item in sorted_augmented_data]\n\n    return result\n```\n"}
{"task_id": "HumanEval/146", "solution": "```python\ndef _is_odd(digit):\n    \"\"\"Checks if a given digit is odd.\n    \"\"\"\n    return digit % 2 != 0\n\ndef _is_greater_than_ten(number):\n    \"\"\"Checks if a number is greater than 10.\n    \"\"\"\n    return number > 10\n\ndef _get_first_digit(number):\n    \"\"\"Extracts the first digit of a number's absolute integer part.\n    \"\"\"\n    return int(str(int(abs(number)))[0])\n\ndef _get_last_digit(number):\n    \"\"\"Extracts the last digit of a number's absolute integer part.\n    \"\"\"\n    return int(abs(number)) % 10\n\ndef _is_first_digit_odd(number):\n    \"\"\"Determines if the first digit of a number is odd.\n    \"\"\"\n    first_digit = _get_first_digit(number)\n    return _is_odd(first_digit)\n\ndef _is_last_digit_odd(number):\n    \"\"\"Determines if the last digit of a number is odd.\n    \"\"\"\n    last_digit = _get_last_digit(number)\n    return _is_odd(last_digit)\n\ndef specialFilter(nums):\n    \"\"\"Write a function that takes an array of numbers as input and returns\n    the number of elements in the array that are greater than 10 and both\n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    For example:\n    specialFilter([15, -73, 14, -15]) => 1\n    specialFilter([33, -2, -3, 45, 21, 109]) => 2\n    \"\"\"\n    count = 0\n    for num in nums:\n        if _is_greater_than_ten(num) and \\\n           _is_first_digit_odd(num) and \\\n           _is_last_digit_odd(num):\n            count += 1\n    return count\n```\n"}
{"task_id": "HumanEval/145", "solution": "```python\nfrom typing import List, Tuple\n\ndef _calculate_sum_of_digits(num: int) -> int:\n    \"\"\"\n    Calculates the sum of the absolute values of the digits of an integer.\n    e.g., _calculate_sum_of_digits(-12) == 3\n    \"\"\"\n    s = str(abs(num))\n    return sum(int(digit) for digit in s)\n\ndef order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers in ascending order according to the sum of their digits.\n    If sums are equal, items are ordered based on their original index.\n    \"\"\"\n    if not nums:\n        return []\n\n    decorated_list: List[Tuple[int, int, int]] = []\n    for index, num in enumerate(nums):\n        sum_digits = _calculate_sum_of_digits(num)\n        decorated_list.append((sum_digits, index, num))\n\n    decorated_list.sort()\n\n    return [item[2] for item in decorated_list]\n```"}
{"task_id": "HumanEval/147", "solution": "```python\nclass Triple:\n    \"\"\"Encapsulates a triple of numbers and checks if their sum is a multiple of 3.\"\"\"\n    def __init__(self, element1: int, element2: int, element3: int):\n        self.element1 = element1\n        self.element2 = element2\n        self.element3 = element3\n        self._sum = element1 + element2 + element3\n\n    def is_multiple_of_3(self) -> bool:\n        \"\"\"Returns True if the sum of the triple's elements is a multiple of 3.\"\"\"\n        return self._sum % 3 == 0\n\ndef _generate_array_elements(n: int) -> list[int]:\n    \"\"\"Generates an array 'a' of length n where a[idx] corresponds to i*i - i + 1 for i = idx + 1.\"\"\"\n    a = [0] * n\n    for idx in range(n):\n        i_val = idx + 1\n        a[idx] = i_val * i_val - i_val + 1\n    return a\n\ndef get_max_triples(n):\n    \"\"\"\n    Counts unique triples (a[i], a[j], a[k]) with i < j < k from array 'a'\n    such that their sum is a multiple of 3.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    a = _generate_array_elements(n)\n    valid_triples_count = 0\n\n    for i in range(n - 2):\n        for j in range(i + 1, n - 1):\n            for k in range(j + 1, n):\n                current_triple = Triple(a[i], a[j], a[k])\n                if current_triple.is_multiple_of_3():\n                    valid_triples_count += 1\n\n    return valid_triples_count\n```"}
{"task_id": "HumanEval/148", "solution": "```python\nfrom typing import List, Dict, Optional\n\nclass Planet:\n    \"\"\"Represents a planet with its name and order from the Sun.\"\"\"\n    def __init__(self, name: str, order_from_sun: int):\n        self.name = name\n        self.order_from_sun = order_from_sun\n\nclass SolarSystem:\n    \"\"\"Manages the canonical list of planets and provides lookup capabilities.\"\"\"\n    def __init__(self):\n        # Canonical order of the eight planets from the Sun.\n        planet_names = [\n            \"Mercury\", \"Venus\", \"Earth\", \"Mars\",\n            \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n        ]\n\n        self._planets_list: List[Planet] = []\n        self._planet_map: Dict[str, Planet] = {}\n\n        for i, name in enumerate(planet_names):\n            planet = Planet(name, i + 1)\n            self._planets_list.append(planet)\n            self._planet_map[name] = planet\n\n    def get_planet_by_name(self, name: str) -> Optional[Planet]:\n        \"\"\"Retrieves a Planet object by its name, or None if not found.\"\"\"\n        return self._planet_map.get(name)\n\n    def get_planet_order(self) -> List[Planet]:\n        \"\"\"Returns the ordered list of all planets from the Sun.\"\"\"\n        return self._planets_list\n\n# Instantiate SolarSystem globally for use by the bf function.\n_solar_system = SolarSystem()\n\ndef bf(planet1, planet2):\n    \"\"\"\n    Identifies planets located strictly between two specified planets,\n    returning them sorted by proximity to the Sun. Returns an empty\n    tuple for invalid planet names or no planets in between.\n    \"\"\"\n    p1_obj = _solar_system.get_planet_by_name(planet1)\n    p2_obj = _solar_system.get_planet_by_name(planet2)\n\n    if p1_obj is None or p2_obj is None:\n        return ()\n\n    start_order = min(p1_obj.order_from_sun, p2_obj.order_from_sun)\n    end_order = max(p1_obj.order_from_sun, p2_obj.order_from_sun)\n\n    intermediate_planets = []\n    for planet in _solar_system.get_planet_order():\n        if start_order < planet.order_from_sun < end_order:\n            intermediate_planets.append(planet.name)\n\n    return tuple(intermediate_planets)\n```"}
{"task_id": "HumanEval/148", "solution": "```python\nPLANETS_ORDERED = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\nPLANET_TO_ORDER_MAP = {planet: i for i, planet in enumerate(PLANETS_ORDERED)}\n\ndef bf(planet1: str, planet2: str) -> tuple[str, ...]:\n    \"\"\"\n    Returns a tuple of planets whose orbits are between planet1 and planet2, sorted by proximity to the Sun.\n    Returns an empty tuple if either input planet name is invalid.\n    \"\"\"\n    if planet1 not in PLANET_TO_ORDER_MAP or planet2 not in PLANET_TO_ORDER_MAP:\n        return ()\n\n    order1 = PLANET_TO_ORDER_MAP[planet1]\n    order2 = PLANET_TO_ORDER_MAP[planet2]\n\n    min_order = min(order1, order2)\n    max_order = max(order1, order2)\n\n    result_planets = []\n    for planet_name in PLANETS_ORDERED:\n        current_order = PLANET_TO_ORDER_MAP[planet_name]\n        if min_order < current_order < max_order:\n            result_planets.append(planet_name)\n\n    return tuple(result_planets)\n```"}
{"task_id": "HumanEval/149", "solution": "```python\ndef sorted_list_sum(lst: list[str]) -> list[str]:\n    \"\"\"\n    Filters a list of strings, keeping only even-length strings,\n    and then sorts the filtered list primarily by string length (ascending)\n    and secondarily by alphabetical order (ascending).\n    \"\"\"\n    # Filter strings with even lengths.\n    filtered_list = [s for s in lst if len(s) % 2 == 0]\n\n    # Sort the filtered list by length, then alphabetically for ties.\n    sorted_list = sorted(filtered_list, key=lambda s: (len(s), s))\n\n    return sorted_list\n```"}
