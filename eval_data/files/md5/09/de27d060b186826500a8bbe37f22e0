{"task_id": "HumanEval/91", "solution": "```python\nimport re\nfrom typing import List\n\nclass Sentence:\n    \"\"\"Encapsulates a single sentence and checks if it starts with 'I'.\"\"\"\n    def __init__(self, text: str):\n        self._text = text\n\n    def check_starts_with_I(self) -> bool:\n        \"\"\"Checks if the trimmed sentence text starts with 'I ' or is exactly 'I'.\"\"\"\n        trimmed_text = self._text.strip()\n        # Checks for \"I \" (with a space) to ensure it's the word \"I\", or if the entire sentence is just \"I\".\n        return trimmed_text.startswith(\"I \") or trimmed_text == \"I\"\n\n    @staticmethod\n    def identify_sentences(input_string: str) -> List['Sentence']:\n        \"\"\"Splits the input string into sentences using '.', '?', '!' as delimiters.\"\"\"\n        # Splits the input string by sentence delimiters and filters out any empty segments.\n        raw_segments = re.split(r'[.?!]', input_string)\n        sentences = []\n        for segment in raw_segments:\n            if segment.strip():\n                sentences.append(Sentence(segment))\n        return sentences\n\nclass BoredomCounter:\n    \"\"\"Orchestrates the counting of 'boredom' sentences in a given text.\"\"\"\n    def __init__(self):\n        self._total_boredoms = 0\n\n    def process_string(self, input_string: str) -> None:\n        \"\"\"Processes the input string to identify and count boredom sentences.\"\"\"\n        sentences = Sentence.identify_sentences(input_string)\n        for sentence_obj in sentences:\n            if sentence_obj.check_starts_with_I():\n                self._total_boredoms += 1\n\n    def get_boredom_count(self) -> int:\n        \"\"\"Returns the total count of boredom sentences.\"\"\"\n        return self._total_boredoms\n\ndef is_bored(S: str) -> int:\n    \"\"\"Counts sentences that start with the word 'I' (case-sensitive).\"\"\"\n    counter = BoredomCounter()\n    counter.process_string(S)\n    return counter.get_boredom_count()\n```"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message according to specific rules: vowels are shifted two positions,\n    other letters have their case swapped, and non-letters are preserved.\n    \"\"\"\n\n    def _is_english_letter(char: str) -> bool:\n        \"\"\"Checks if a character is an English alphabet letter.\"\"\"\n        return 'a' <= char <= 'z' or 'A' <= char <= 'Z'\n\n    def _is_english_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is an English vowel (case-insensitive).\"\"\"\n        return char.lower() in 'aeiou'\n\n    def _swap_case(char: str) -> str:\n        \"\"\"Swaps the case of a single English letter.\"\"\"\n        return char.swapcase()\n\n    def _get_char_two_ahead(char: str) -> str:\n        \"\"\"Replaces a vowel with the letter two positions ahead, preserving case.\"\"\"\n        return chr(ord(char) + 2)\n\n    encoded_chars = []\n    for char in message:\n        if _is_english_vowel(char):\n            encoded_chars.append(_get_char_two_ahead(char))\n        elif _is_english_letter(char):\n            encoded_chars.append(_swap_case(char))\n        else:\n            encoded_chars.append(char)\n\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "```python\ndef skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"Checks if a given integer n is a prime number.\n        Returns False for numbers less than or equal to 1, or if divisible by any number up to its square root.\n        \"\"\"\n        if n <= 1:\n            return False\n        # Only check for divisors up to the square root of n.\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    def _sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the digits of a given integer n.\n        It converts the number to a string to sum each digit.\n        \"\"\"\n        digit_sum = 0\n        for digit_char in str(n):\n            digit_sum += int(digit_char)\n        return digit_sum\n\n    largest_prime = 0  # Initialize with 0, as all prime numbers are positive.\n\n    for number in lst:\n        if _is_prime(number):\n            if number > largest_prime:\n                largest_prime = number\n\n    if largest_prime == 0:\n        # If no prime numbers were found in the list, return 0.\n        return 0\n    else:\n        # Otherwise, calculate and return the sum of digits for the largest prime.\n        return _sum_digits(largest_prime)\n```"}
{"task_id": "HumanEval/93", "solution": "def _is_alphabetic(char: str) -> bool:\n    \"\"\"Checks if a character is an English letter.\"\"\"\n    return char.isalpha()\n\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is an English vowel (case-insensitive).\"\"\"\n    return char.lower() in 'aeiou'\n\ndef _swap_case(char: str) -> str:\n    \"\"\"Returns the case-swapped version of an alphabetic character.\"\"\"\n    return char.swapcase()\n\ndef _get_vowel_replacement(char: str) -> str:\n    \"\"\"Calculates the character two places ahead in the alphabet, preserving case.\"\"\"\n    if 'a' <= char <= 'z':\n        base = ord('a')\n    else:  # 'A' <= char <= 'Z'\n        base = ord('A')\n\n    new_ord = (ord(char) - base + 2) % 26 + base\n    return chr(new_ord)\n\ndef encode(message: str) -> str:\n    \"\"\"Encodes a message by swapping case of letters and replacing vowels.\n    Vowels are replaced with the letter two places ahead in the alphabet.\"\"\"\n    encoded_chars = []\n    for char in message:\n        if _is_alphabetic(char):\n            # All alphabetic characters first undergo a case swap.\n            processed_char = _swap_case(char)\n            # If the original character was a vowel, apply the vowel replacement rule.\n            if _is_vowel(char):\n                # The vowel replacement operates on the already case-swapped character,\n                # preserving its current case (which is the swapped case).\n                processed_char = _get_vowel_replacement(processed_char)\n            encoded_chars.append(processed_char)\n        else:\n            # Non-alphabetic characters are preserved without modification.\n            encoded_chars.append(char)\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "```python\ndef skjkasdkd(lst):\n    \"\"\"Finds the largest prime in a list and returns the sum of its digits.\n    If no prime is found, returns 0.\"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n <= 1:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    def sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of a number's digits.\"\"\"\n        digit_sum = 0\n        while n > 0:\n            digit_sum += n % 10\n            n //= 10\n        return digit_sum\n\n    largest_prime = -1\n    max_prime_found = False\n\n    for num in lst:\n        if is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n                max_prime_found = True\n\n    if max_prime_found:\n        return sum_digits(largest_prime)\n    else:\n        return 0\n```"}
{"task_id": "HumanEval/92", "solution": "```python\ndef any_int(x, y, z):\n    '''\n    Checks if all three numbers are strictly integers.\n    If so, it then checks if any one number is the sum of the other two.\n    '''\n    if not isinstance(x, int):\n        return False\n    if not isinstance(y, int):\n        return False\n    if not isinstance(z, int):\n        return False\n\n    return (x == y + z) or \\\n           (y == x + z) or \\\n           (z == x + y)\n\n```"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"\n    Checks if all string keys in a dictionary are uniformly lower case or uniformly upper case.\n    Returns False if the dictionary is empty or keys are mixed case.\n    \"\"\"\n    if not dict:\n        return False\n\n    # As per critical requirement, no isinstance() checks are performed.\n    # It is assumed all keys in the input dictionary are string-like\n    # and support .islower() and .isupper() methods.\n\n    # Check if all keys are lower case\n    all_lower = True\n    for key in dict.keys():\n        if not key.islower():\n            all_lower = False\n            break\n    if all_lower:\n        return True\n\n    # Check if all keys are upper case\n    all_upper = True\n    for key in dict.keys():\n        if not key.isupper():\n            all_upper = False\n            break\n    if all_upper:\n        return True\n\n    # If neither all lower nor all upper case\n    return False\n```"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    \"\"\"\n    if not dict:\n        return False\n\n    is_all_lower = True\n    is_all_upper = True\n\n    for key in dict:\n        # Check if key is a string to satisfy the requirement of returning False for non-string keys.\n        if not isinstance(key, str):\n            return False\n\n        # Evaluate casing for string keys.\n        if not key.islower():\n            is_all_lower = False\n        if not key.isupper():\n            is_all_upper = False\n\n    # After iterating through all keys, return True if all were consistently lower or upper.\n    return is_all_lower or is_all_upper\n```"}
{"task_id": "HumanEval/96", "solution": "```python\ndef is_prime(number):\n    \"\"\"Checks if a number is prime.\n    A prime number is a natural number greater than 1 that has no positive divisors other than 1 and itself.\"\"\"\n    if number < 2:\n        return False\n    i = 2\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 1\n    return True\n\ndef count_up_to(n):\n    \"\"\"Implement a function that takes a non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    for example:\n    count_up_to(5) => [2,3]\n    count_up_to(11) => [2,3,5,7]\n    count_up_to(0) => []\n    count_up_to(20) => [2,3,5,7,11,13,17,19]\n    count_up_to(1) => []\n    count_up_to(18) => [2,3,5,7,11,13,17]\n    \"\"\"\n    if n < 2:\n        return []\n\n    primes_list = []\n    for number in range(2, n):\n        if is_prime(number):\n            primes_list.append(number)\n\n    return primes_list\n```"}
{"task_id": "HumanEval/96", "solution": "```python\ndef _sieve_of_eratosthenes(limit: int) -> list[bool]:\n    \"\"\"Generates a boolean list indicating primality for numbers up to a given limit.\n    `is_prime[i]` is True if `i` is prime, False otherwise.\"\"\"\n    if limit <= 0:\n        return []\n\n    is_prime = [True] * limit\n    if limit > 0:\n        is_prime[0] = False\n    if limit > 1:\n        is_prime[1] = False\n\n    p = 2\n    while (p * p) < limit:\n        if is_prime[p]:\n            for multiple in range(p * p, limit, p):\n                is_prime[multiple] = False\n        p += 1\n    return is_prime\n\ndef count_up_to(n: int) -> list[int]:\n    \"\"\"Returns an array of all prime numbers strictly less than a given non-negative integer n.\n    This function uses the Sieve of Eratosthenes for efficient prime number generation.\"\"\"\n    if n < 2:\n        return []\n\n    is_prime_flags = _sieve_of_eratosthenes(n)\n    primes = []\n    # Iterate from 2 up to n-1 (exclusive upper limit n)\n    for i in range(2, n):\n        if is_prime_flags[i]:\n            primes.append(i)\n    return primes\n```"}
{"task_id": "HumanEval/97", "solution": "```python\ndef multiply(a, b):\n    \"\"\"Complete the function that takes two integers and returns\n    the product of their unit digits.\"\"\"\n\n\n    def _get_absolute_unit_digit(number: int) -> int:\n        \"\"\"Extracts the absolute value of the unit digit from an integer.\"\"\"\n        return abs(number % 10)\n\n    unit_digit_a = _get_absolute_unit_digit(a)\n    unit_digit_b = _get_absolute_unit_digit(b)\n\n    return unit_digit_a * unit_digit_b\n```"}
{"task_id": "HumanEval/97", "solution": "```python\ndef multiply(a, b):\n    \"\"\"\n    Calculates the product of the unit digits of two integers.\n    The unit digit is the absolute value of the last digit.\n    \"\"\"\n    unit_digit_a = abs(a % 10)\n    unit_digit_b = abs(b % 10)\n    return unit_digit_a * unit_digit_b\n```"}
{"task_id": "HumanEval/98", "solution": "def _is_even_index(index: int) -> bool:\n    \"\"\"Checks if an index is even.\"\"\"\n    return index % 2 == 0\n\ndef _is_uppercase_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is an uppercase vowel.\"\"\"\n    return char in ('A', 'E', 'I', 'O', 'U')\n\ndef count_upper(s):\n    \"\"\"\n    Given a string s, count the number of uppercase vowels in even indices.\n\n    For example:\n    count_upper('aBCdEf') returns 1\n    count_upper('abcdefg') returns 0\n    count_upper('dBBE') returns 0\n    \"\"\"\n    count = 0\n    for index, char in enumerate(s):\n        if _is_even_index(index) and _is_uppercase_vowel(char):\n            count += 1\n    return count"}
{"task_id": "HumanEval/98", "solution": "```python\ndef count_upper(s):\n    \"\"\"\n    Given a string s, count the number of uppercase vowels in even indices.\n\n    For example:\n    count_upper('aBCdEf') returns 1\n    count_upper('abcdefg') returns 0\n    count_upper('dBBE') returns 0\n    \"\"\"\n\n    def _is_even_index(index: int) -> bool:\n        \"\"\"Checks if an index is even.\n        Returns True if the index is even, False otherwise.\"\"\"\n        return index % 2 == 0\n\n    def _is_uppercase_vowel(char: str) -> bool:\n        \"\"\"Determines if a character is an uppercase vowel.\n        Returns True if the character is 'A', 'E', 'I', 'O', or 'U'.\"\"\"\n        return char in 'AEIOU'\n\n    count = 0\n    for i, char in enumerate(s):\n        if _is_even_index(i) and _is_uppercase_vowel(char):\n            count += 1\n    return count\n```"}
{"task_id": "HumanEval/92", "solution": "```python\ndef any_int(x, y, z):\n    '''\n    Checks if all three numbers are integers and if one is the sum of the other two.\\n    Returns true only if both conditions are met.\\n    '''\n    # Check if all inputs are effectively integers by comparing them to their integer representation.\n    if not (x == int(x) and y == int(y) and z == int(z)):\n        return False\n\n    # If all are integers, check if any one argument is equal to the sum of the other two.\n    return (x == y + z) or \\\n           (y == x + z) or \\\n           (z == x + y)\n```"}
