{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Takes a string and returns an ordered version where characters within each word are sorted by ASCII value.\n    The order of words and spaces in the sentence is preserved.\n    \"\"\"\n    if not s:\n        return \"\"\n\n    processed_segments = []\n    current_segment_chars = []\n    # Determine initial state: True if first char is a non-space, False if space\n    is_current_segment_word = not s[0].isspace()\n\n    for char in s:\n        char_is_space = char.isspace()\n\n        # If current character type matches the segment type, extend current segment\n        if (is_current_segment_word and not char_is_space) or \\\n           (not is_current_segment_word and char_is_space):\n            current_segment_chars.append(char)\n        else:\n            # Segment type changed, so process the accumulated segment\n            segment_str = \"\".join(current_segment_chars)\n            if is_current_segment_word:\n                processed_segments.append(\"\".join(sorted(segment_str)))\n            else:\n                processed_segments.append(segment_str)\n\n            # Start a new segment with the current character\n            current_segment_chars = [char]\n            is_current_segment_word = not char_is_space\n\n    # After the loop, there's always one last segment to process\n    segment_str = \"\".join(current_segment_chars)\n    if is_current_segment_word:\n        processed_segments.append(\"\".join(sorted(segment_str)))\n    else:\n        processed_segments.append(segment_str)\n\n    return \"\".join(processed_segments)"}
{"task_id": "HumanEval/87", "solution": "```python\ndef get_row(lst, x):\n    \"\"\"\n    Finds all occurrences of integer `x` in a nested list `lst` and returns their 0-indexed `(row, column)` coordinates.\n    The coordinates are sorted primarily by row ascending, and secondarily by column descending.\n    \"\"\"\n    found_coordinates = []\n\n    for row_index, row in enumerate(lst):\n        for col_index, value in enumerate(row):\n            if value == x:\n                found_coordinates.append((row_index, col_index))\n\n    # Sort primarily by row in ascending order, then by column in descending order\n    # By using -coord[1], Python's default ascending sort effectively sorts columns descending.\n    sorted_coordinates = sorted(found_coordinates, key=lambda coord: (coord[0], -coord[1]))\n\n    return sorted_coordinates\n```\n"}
{"task_id": "HumanEval/88", "solution": "from typing import List\n\nclass SortableArray:\n    \"\"\"\n    Manages array data and provides methods for sorting and array information.\n    Ensures operations return new instances to maintain immutability.\n    \"\"\"\n    def __init__(self, elements: List[int]):\n        \"\"\"Initializes with a copy of the input elements.\"\"\"\n        self._elements = list(elements)\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the array contains no elements.\"\"\"\n        return not self._elements\n\n    def has_single_element(self) -> bool:\n        \"\"\"Checks if the array contains exactly one element.\"\"\"\n        return len(self._elements) == 1\n\n    def get_first_element(self) -> int | None:\n        \"\"\"Returns the first element or None if the array is empty.\"\"\"\n        return self._elements[0] if not self.is_empty() else None\n\n    def get_last_element(self) -> int | None:\n        \"\"\"Returns the last element or None if the array is empty.\"\"\"\n        return self._elements[-1] if not self.is_empty() else None\n\n    def calculate_sum_first_last(self) -> int | None:\n        \"\"\"Calculates the sum of the first and last elements if available.\"\"\"\n        if len(self._elements) >= 2:\n            return self._elements[0] + self._elements[-1]\n        return None\n\n    def create_copy(self) -> 'SortableArray':\n        \"\"\"Returns a new SortableArray instance that is a copy of the current instance.\"\"\"\n        return SortableArray(self._elements)\n\n    def sort_ascending(self) -> 'SortableArray':\n        \"\"\"Returns a new SortableArray instance with elements sorted in ascending order.\"\"\"\n        return SortableArray(sorted(self._elements))\n\n    def sort_descending(self) -> 'SortableArray':\n        \"\"\"Returns a new SortableArray instance with elements sorted in descending order.\"\"\"\n        return SortableArray(sorted(self._elements, reverse=True))\n\n    def to_list(self) -> List[int]:\n        \"\"\"Converts the SortableArray instance back into a standard Python list.\"\"\"\n        return list(self._elements)\n\nclass ArraySorterService:\n    \"\"\"\n    Provides the public interface for sorting an array based on specific rules.\n    It orchestrates operations using the SortableArray class.\n    \"\"\"\n    def sort_array(self, array: List[int]) -> List[int]:\n        \"\"\"\n        Sorts an array of non-negative integers based on the parity of the sum of\n        its first and last elements, returning a new sorted copy.\n        \"\"\"\n        sortable_array_instance = SortableArray(array)\n\n        if sortable_array_instance.is_empty():\n            return []\n        elif sortable_array_instance.has_single_element():\n            # For single-element arrays, return an unchanged copy.\n            return sortable_array_instance.create_copy().to_list()\n        else:\n            sum_val = sortable_array_instance.calculate_sum_first_last()\n\n            if sum_val is not None and sum_val % 2 != 0:  # Sum is odd, sort ascending\n                sorted_instance = sortable_array_instance.sort_ascending()\n            else:  # Sum is even, sort descending\n                sorted_instance = sortable_array_instance.sort_descending()\n\n            return sorted_instance.to_list()\n\ndef sort_array(array: List[int]) -> List[int]:\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n    \"\"\"\n    service = ArraySorterService()\n    return service.sort_array(array)"}
{"task_id": "HumanEval/87", "solution": "```python\ndef get_row(lst: list[list[int]], x: int) -> list[tuple[int, int]]:\n    \"\"\"\n    Finds all occurrences of `x` in `lst` and returns their 0-indexed `(row, column)` coordinates.\n    The coordinates are sorted primarily by row ascending, and secondarily by column descending.\n    \"\"\"\n    found_coordinates = []\n    for row_idx, row in enumerate(lst):\n        for col_idx, value in enumerate(row):\n            if value == x:\n                found_coordinates.append((row_idx, col_idx))\n\n    # Sort primarily by row (ascending), secondarily by column (descending)\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return found_coordinates\n```"}
{"task_id": "HumanEval/84", "solution": "```python\ndef _calculate_sum_of_decimal_digits(N: int) -> int:\n    \"\"\"Calculates the sum of the decimal digits of N.\n    This function iteratively extracts digits using modulo and division.\"\"\"\n    current_sum = 0\n    temp_N = N\n    while temp_N > 0:\n        current_sum += temp_N % 10\n        temp_N //= 10\n    return current_sum\n\ndef _to_binary_string(decimal_sum: int) -> str:\n    \"\"\"Converts a decimal integer to its binary string representation.\n    It uses a standard library function and removes the '0b' prefix.\"\"\"\n    return bin(decimal_sum)[2:]\n\ndef solve(N: int) -> str:\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    The function orchestrates calculation of decimal sum and its binary conversion.\"\"\"\n    sum_of_digits = _calculate_sum_of_decimal_digits(N)\n    binary_representation = _to_binary_string(sum_of_digits)\n    return binary_representation\n```"}
