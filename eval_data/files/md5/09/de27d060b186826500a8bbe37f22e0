{"task_id": "HumanEval/39", "solution": "```python\nclass FibonacciSequenceGenerator:\n    \"\"\"Generates Fibonacci numbers sequentially.\n    It starts with F(0)=0 and F(1)=1.\"\"\"\n    def __init__(self):\n        self._a = 0\n        self._b = 1\n\n    def generate_next(self) -> int:\n        \"\"\"Generates and returns the next Fibonacci number in the sequence.\"\"\"\n        current_fib = self._a\n        self._a, self._b = self._b, self._a + self._b\n        return current_fib\n\nclass PrimeChecker:\n    \"\"\"Determines if a given number is prime.\n    It checks for divisibility up to half of the number.\"\"\"\n    def is_prime(self, num: int) -> bool:\n        \"\"\"Checks if the given number is prime.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        # Check odd divisors up to num // 2 + 1 to find factors.\n        for i in range(3, num // 2 + 1, 2):\n            if num % i == 0:\n                return False\n        return True\n\nclass PrimeFibonacciFinder:\n    \"\"\"Orchestrates the finding of the n-th prime Fibonacci number.\n    It uses a Fibonacci generator and a prime checker.\"\"\"\n    def __init__(self, fib_generator: FibonacciSequenceGenerator, prime_checker: PrimeChecker):\n        \"\"\"Initializes with dependencies.\"\"\"\n        self._fib_generator = fib_generator\n        self._prime_checker = prime_checker\n\n    def find_nth_prime_fibonacci(self, n: int) -> int:\n        \"\"\"Finds the n-th prime Fibonacci number.\"\"\"\n        prime_fib_count = 0\n        while True:\n            fib_number = self._fib_generator.generate_next()\n            # 0 and 1 are Fibonacci but not prime.\n            if fib_number < 2:\n                continue\n\n            if self._prime_checker.is_prime(fib_number):\n                prime_fib_count += 1\n                if prime_fib_count == n:\n                    return fib_number\n\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    fib_generator = FibonacciSequenceGenerator()\n    prime_checker = PrimeChecker()\n    finder = PrimeFibonacciFinder(fib_generator, prime_checker)\n    return finder.find_nth_prime_fibonacci(n)\n```"}
{"task_id": "HumanEval/39", "solution": "```python\nimport math\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n\n    def _is_perfect_square(num: int) -> bool:\n        \"\"\"Helper to check if a number is a perfect square.\"\"\"\n        if num < 0:\n            return False\n        sqrt_num = int(math.isqrt(num))\n        return sqrt_num * sqrt_num == num\n\n    def is_fibonacci(num: int) -> bool:\n        \"\"\"Checks if a given number is a Fibonacci number using the perfect square property.\"\"\"\n        if num < 0:\n            return False\n        if num == 0 or num == 1:\n            return True\n        return _is_perfect_square(5 * num * num + 4) or _is_perfect_square(5 * num * num - 4)\n\n    def is_prime(num: int) -> bool:\n        \"\"\"Checks if a given number is a prime number using an optimized trial division algorithm.\"\"\"\n        if num <= 1:\n            return False\n        if num <= 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    count_found_prime_fibs = 0\n    candidate_num = 1\n\n    while True:\n        candidate_num += 1\n        if is_fibonacci(candidate_num):\n            if is_prime(candidate_num):\n                count_found_prime_fibs += 1\n                if count_found_prime_fibs == n:\n                    return candidate_num\n\n```"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece. This function efficiently computes the n-th element without recursion.\"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n\n    # Initialize the four preceding values: fib4(n-4), fib4(n-3), fib4(n-2), fib4(n-1)\n    # These correspond to fib4(0), fib4(1), fib4(2), fib4(3) initially.\n    f_n_minus_4 = 0 # Corresponds to fib4(0)\n    f_n_minus_3 = 0 # Corresponds to fib4(1)\n    f_n_minus_2 = 2 # Corresponds to fib4(2)\n    f_n_minus_1 = 0 # Corresponds to fib4(3)\n\n    for _ in range(4, n + 1):\n        current_fib4 = f_n_minus_1 + f_n_minus_2 + f_n_minus_3 + f_n_minus_4\n        # Shift values for the next iteration\n        f_n_minus_4 = f_n_minus_3\n        f_n_minus_3 = f_n_minus_2\n        f_n_minus_2 = f_n_minus_1\n        f_n_minus_1 = current_fib4\n\n    return f_n_minus_1"}
