elf, raw: str):\n        self.raw = raw\n        self.cleaned = self.clean_spaces()\n\n    def clean_spaces(self) -> str:\n        \"\"\"Removes all space characters (' ') from the raw string.\"\"\"\n        return self.raw.replace(' ', '')\nclass ParenthesisGroup:\n    \"\"\"Represents a balanced group of parentheses and validates its content.\"\"\"\n    def __init__(self, content: str):\n        self.content = content\n        current_depth = 0\n        max_depth = 0\n        is_valid_balance_during_scan = True\n\n        for char in content:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n            \n            if current_depth < 0:\n                is_valid_balance_during_scan = False\n                break\n        \n        self.nestingDepth = max_depth\n        self._is_balanced = is_valid_balance_during_scan and (current_depth == 0)\n\n    def isBalanced(self) -> bool:\n        \"\"\"Verifies if the group's content has matched parentheses and never went negative in balance.\"\"\"\n        return self._is_balanced\nclass OutputList:\n    \"\"\"A container for the final list of group strings to be returned.\"\"\"\n    def __init__(self, groups: List[str]):\n        self.groups = groups\nclass Parser:\n    \"\"\"Orchestrates the cleaning and splitting of the input string into parenthesis groups.\"\"\"\n    def separate_paren_groups(self, paren_string: str) -> List[str]:\n        \"\"\"Coordinates the parsing process from raw string to a list of group strings.\"\"\"\n        input_obj = InputString(paren_string)\n        cleaned = input_obj.cleaned\n        \n        parenthesis_groups = self._scan_and_split(cleaned)\n        \n        result_strings = [group.content for group in parenthesis_groups]\n        \n        output_list_obj = OutputList(result_strings)\n        return output_list_obj.groups\n\n    def _scan_and_split(self, cleaned: str) -> List[ParenthesisGroup]:\n        \"\"\"Scans the cleaned string, identifies top-level balanced groups, and creates ParenthesisGroup objects.\"\"\"\n        groups = []\n        current_group_buffer = []\n        balance = 0\n        \n        for char in cleaned:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            \n            current_group_buffer.append(char)\n            \n            if balance == 0 and current_group_buffer:\n                group_content = \"\".join(current_group_buffer)\n                pg = ParenthesisGroup(group_content)\n                groups.append(pg)\n                current_group_buffer = [] \n        \n        return groups\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    parser = Parser()\n    return parser.separate_paren_groups(paren_string)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/4": [{"task_id": "HumanEval/4", "solution": "from typing import List\nclass Dataset:\n    \"\"\"Lightweight data container for the input list.\"\"\"\n    def __init__(self, numbers: List[float]) -> None:\n        self.numbers = numbers\nclass MeanCalculator:\n    \"\"\"Computes the arithmetic mean of a list of floats.\"\"\"\n    def calculate_mean(self, numbers: List[float]) -> float:\n        return sum(numbers) / len(numbers)\nclass DeviationCalculator:\n    \"\"\"Computes absolute deviations for each element from a given mean.\"\"\"\n    def calculate_absolute_deviations(self, numbers: List[float], mean: float) -> List[float]:\n        return [abs(x - mean) for x in numbers]\nclass MADCalculator:\n    \"\"\"Orchestrates mean and deviation calculations and computes the final MAD.\"\"\"\n    def __init__(self, mean_calculator: MeanCalculator = None, deviation_calculator: DeviationCalculator = None) -> None:\n        self.mean_calculator = mean_calculator if mean_calculator is not None else MeanCalculator()\n        self.deviation_calculator = deviation_calculator if deviation_calculator is not None else DeviationCalculator()\n\n    def mean_absolute_deviation(self, numbers: List[float]) -> float:\n        mean = self.mean_calculator.calculate_mean(numbers)\n        deviations = self.deviation_calculator.calculate_absolute_deviations(numbers, mean)\n        mad_value = sum(deviations) / len(deviations)\n        # MADResult(mad_value) is conceptually produced as per design, but float is returned.\n        return mad_value\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    dataset = Dataset(numbers)\n    mad_calculator = MADCalculator()\n    result = mad_calculator.mean_absolute_deviation(dataset.numbers)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/3": [{"task_id": "HumanEval/3", "solution": "from typing import List\nclass Operation:\n    \"\"\"Value object representing a deposit/withdrawal and its sequence index.\"\"\"\n    def __init__(self, amount: int, sequence_index: int):\n        self.amount: int = amount\n        self.sequence_index: int = sequence_index\nclass Account:\n    \"\"\"Represents a logical account with a running balance.\"\"\"\n    def __init__(self):\n        self.balance: int = 0\n\n    def initialize(self) -> None:\n        \"\"\"Sets the account balance to zero.\"\"\"\n        self.balance = 0\n\n    def apply_operation(self, op: Operation) -> None:\n        \"\"\"Updates the balance by adding the operation's amount.\"\"\"\n        self.balance += op.amount\nclass BalanceChecker:\n    \"\"\"Orchestrates evaluation of account operations to detect negative balances.\"\"\"\n    def __init__(self):\n        self._account: Account = Account()\n\n    def below_zero(self, operations: List[int]) -> bool:\n        \"\"\"\n        Processes operations, returning True if the balance falls below zero at any point.\n        Otherwise, returns False.\n        \"\"\"\n        self._account.initialize()\n        for i, amount in enumerate(operations):\n            op = Operation(amount, i)\n            self._account.apply_operation(op)\n            if self._account.balance < 0:\n                return True\n        return False\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    checker = BalanceChecker()\n    return checker.below_zero(operations)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/12": [{"task_id": "HumanEval/12", "solution": "def longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n