n        Returns True if such a pair is found, False otherwise.\n        \"\"\"\n        if input_list.length() < 2:\n            return False\n\n        return self.find_pair(input_list) is not None\n\n    def find_pair(self, input_list: InputList) -> Optional[Tuple[Element, Element]]:\n        \"\"\"\n        Finds two distinct elements in the InputList that sum to zero.\n        Returns the pair as a tuple of Elements if found, otherwise None.\n        \"\"\"\n        elements = input_list.elements\n        n = input_list.length()\n\n        for i in range(n):\n            for j in range(i + 1, n):\n                el1 = elements[i]\n                el2 = elements[j]\n                if el1.value + el2.value == 0:\n                    return (el1, el2)\n        return None\ndef pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    elements = [Element(value=v, index=i) for i, v in enumerate(l)]\n    input_list = InputList(elements)\n    checker = PairChecker()\n    return checker.pairs_sum_to_zero(input_list)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/47": [{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    def _validate_input(lst: list) -> list:\n        \"\"\"Validate input list and its elements.\"\"\"\n        if not isinstance(lst, list):\n            raise TypeError(\"Input must be a list.\")\n        for x in lst:\n            if not isinstance(x, (int, float)):\n                raise TypeError(\"List elements must be numeric (int or float).\")\n        return lst\n\n    def _sorted_values(lst: list) -> list:\n        \"\"\"Return a sorted shallow copy of the numeric list.\"\"\"\n        return sorted(lst)\n\n    def _median_from_sorted(sorted_values: list):\n        \"\"\"Compute the median from a sorted list.\"\"\"\n        n = len(sorted_values)\n        if n == 0:\n            raise ValueError(\"Cannot compute median of an empty list.\")\n        \n        if n % 2 == 1:\n            return sorted_values[n // 2]\n        else:\n            mid1 = sorted_values[n // 2 - 1]\n            mid2 = sorted_values[n // 2]\n            return (mid1 + mid2) / 2.0\n\n    validated_list = _validate_input(l)\n    sorted_values = _sorted_values(validated_list)\n    return _median_from_sorted(sorted_values)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/46": [{"task_id": "HumanEval/46", "solution": "class ErrorHandler:\n    \"\"\"Handles raising appropriate exceptions for invalid input.\"\"\"\n    def raiseInvalidInput(self, errorMessage: str):\n        if \"must be an integer\" in errorMessage:\n            raise TypeError(errorMessage)\n        elif \"must be non-negative\" in errorMessage:\n            raise ValueError(errorMessage)\n        else:\n            raise ValueError(errorMessage)\nclass InputValidator:\n    \"\"\"Validates if the input n is a non-negative integer.\"\"\"\n    def isValid(self, n) -> bool:\n        return isinstance(n, int) and n >= 0\nclass Fib4Calculator:\n    \"\"\"Calculates the n-th Fib4 number iteratively with O(1) space.\"\"\"\n    def __init__(self):\n        # Internal rolling state for fib4(i-1), fib4(i-2), fib4(i-3), fib4(i-4)\n        self._a: int = 0\n        self._b: int = 0\n        self._c: int = 0\n        self._d: int = 0\n\n    def advance(self) -> None:\n        \"\"\"Updates the rolling state to compute the next Fib4 number.\"\"\"\n        next_fib = self._a + self._b + self._c + self._d\n        self._d = self._c\n        self._c = self._b\n        self._b = self._a\n        self._a = next_fib\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the n-th Fib4 number iteratively, handling base cases.\"\"\"\n        if n == 0:\n            return 0\n        if n == 1:\n            return 0\n        if n == 2:\n            return 2\n        if n == 3:\n            return 0\n\n        # Initialize rolling state for computing fib4(4)\n        # _d, _c, _b, _a represent fib4(k-4), fib4(k-3), fib4(k-2), fib4(k-1) respectively.\n        self._d = 0  # fib4(0)\n        self._c = 0  # fib4(1)\n        self._b = 2  # fib4(2)\n        self._a = 0  # fib4(3)\n\n        # Iterate from the 4th number up to n\n        for _ in range(4, n + 1):\n            self.advance()\n\n        return self._a\ndef fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    validator = InputValidator()\n    error_handler = ErrorHandler()\n\n    if not isinstance(n, int):\n        error_handler.raiseInvalidInput(f\"Input n must be an integer, but got type {type(n).__name__}.\")\n    if n < 0:\n        error_handler.raiseInvalidInput(f\"Input n must be non-negative, but got {n}.\")\n\n    calculator = Fib4Calculator()\n    return calculator.compute(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/32": [{"task_id": "HumanEval/32", "solution": "import math\nROOT_TOLERANCE: float = 1e-12\nSAMPLE_STEPS: int = 1000\nclass ValidationError(Exception):\n    \"\"\"Exception to signal invalid input conditions for find_zero.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        return self.message\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef _cauchy_root_bound(xs: list) -> float:\n    \"\"\"\n    Calculates a Cauchy bound for the roots of a polynomial.\n    R = 1 + max_{0 <= i < n} |a_i / a_n| where a_n is leading coefficient.\n    Assumes a_n (xs[-1]) is not zero, as validated by find_zero.\n    \"\"\"\n    n = len(xs) - 1\n    if n < 0: # Empty coefficients list, should be caught by find_zero validation\n        return 0.0\n    if n == 0: # Constant polynomial (e.g., [5]). find_zero's even length check prevents this.\n        return 0.0 # Or float('inf') if constant is non-zero, but for valid inputs, this isn't reached.\n    \n    an = xs[n]\n    # an is guaranteed not to be zero by find_zero's validation\n    \n    max_ratio = 0.0\n    for i in range(n):\n        max_ratio = max(max_ratio, abs(xs[i] / an))\n    \n    return 1.0 + max_ratio\ndef _sample_intervals(left: float, right: float, steps: int) -> list[tuple[float, float]]:\n    \"\"\"\n    Uniformly partitions [left, right] into 'steps' intervals.\n    Returns a list of adjacent pairs (x_i, x_{i+1}).\n    \"\"\"\n    if steps <= 0:\n        return []\n    \n    points = [left + i * (right - left) / steps for i in range(steps + 1)]\n    return [(points[i], points[i+1]) for i in range(steps)]\ndef _bisection(f: callable, a: float, b: float, tol: float) -> float:\n    \"\"\"\n    Standard bisection method to find a root of f within [a, b].\n    Assumes f(a) and f(b) have opposite signs or one is near zero.\n    Refines until abs(f(mid)) <= tol or interval width <= tol.\n    \"\"\"\n    fa = f(a)\n    fb = f(b)\n\n    # If an endpoint is already a root or very close\n    if abs(fa) <= tol:\n        return a\n    if abs(fb) <= tol:\n        return b\n\n    # It's assumed that the interval [a, b] is a valid bracket where fa*fb <= 0\n    # due to how _bisection is called from RootFinder.find_zero.\n    # If not, the method might not converge correctly.\n\n    while abs(b - a) > tol:\n        mid = (a + b) / 2.0\n        fmid = f(mid)\n\n        if abs(fmid) <= tol:\n            return mid\n\n        if fa * fmid < 0: # Root is in [a, mid]\n            b = mid\n            fb = fmid\n        else: # Root is in [mid, b]\n            a = mid\n            fa = fmid\n    \n    return (a + b) / 2.0 # Return midpoint of final interval\nclass RootFinder:\n    \"\"\"Finds a single root of a polynomial with given coefficients.\"\"\"\n    def __init__(self, coefficients: list):\n        self.coefficients = coefficients\n\n    def find_zero(self) -> float:\n        \"\"\"\n        Implements deterministic root search by sampling within a Cauchy bound\n        and refining brackets using bisection.\n        Assumes coefficients are already validated (even length, non-zero leading coefficient).\n        \"\"\"\n        poly_func = lambda x_val: poly(self.coefficients, x_val)\n\n        # 1. Compute Cauchy bound R for root magnitude\n        R = _cauchy_root_bound(self.coefficients)\n        \n        # Ensure R is a positive finite value for sampling range.\n        # Given validation ensures xs[-1] is non-zero, R should be finite for n>0.\n        # For n=0 (constant poly), R could be 0, but this is caught by find_zero's even length.\n        if R <= 0.0: # Should not happen for valid polynomials of degree > 0\n            R = 1.0 # Default a small range if somehow R is non-positive\n\n        # 2. Sample interval [-R, R]\n        sample_intervals = _sample_intervals(-R, R, SAMPLE_STEPS)\n\n        # 3. Scan from left to right for the first root or bracket\n        for a, b in sample_intervals:\n            fa = poly_func(a)\n            fb = poly_func(b)\n\n            # If a sample point is a root or very close\n            if abs(fa) <= ROOT_TOLERANCE:\n                return a\n            \n            # If a bracket (sign change) is found\n            if fa * fb <= 0:\n                root = _bisection(poly_func, a, b, ROOT_TOLERANCE)\n                return root\n        \n        # As per the problem statement, a solution is guaranteed for valid inputs.\n        # If no root is found by sampling and bisection within the bound,\n        # it implies a limitation of the method or numerical precision issues.\n        # For robustness, we can check the endpoint R as a last resort.\n        if abs(poly_func(R)) <= ROOT_TOLERANCE:\n            return R\n\n        # This point should theoretically not be reached given problem guarantees.\n        raise RuntimeError(\"No root found despite problem guarantee for valid input. Consider adjusting SAMPLE_STEPS or ROOT_TOLERANCE.\")\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    # Validate inputs as per design requirements\n    if len(xs) == 0:\n        raise ValidationError(\"The list of coefficients 'xs' cannot be empty.\")\n        \n    # Check for even number of coefficients\n    if len(xs) % 2 != 0:\n        raise ValidationError(\"The list of coefficients 'xs' must have an even number of elements.\")\n    \n