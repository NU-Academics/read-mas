HumanEval/56", "solution": "class BracketValidator:\n    \"\"\"Implements bracket validation logic according to prefix and total-equality rules.\"\"\"\n    def correct_bracketing(self, brackets: str) -> bool:\n        \"\"\"Performs a single-pass streaming validation for both prefix and total equality rules.\"\"\"\n        balance = 0\n        for char in brackets:\n            if char == '<':\n                balance += 1\n            elif char == '>':\n                balance -= 1\n            # If balance ever drops below zero, a closing bracket appeared without a matching open one.\n            if balance < 0:\n                return False\n        # After iterating through all characters, the balance must be zero for total equality.\n        return balance == 0\n\n    def check_prefixes(self, brackets: str) -> bool:\n        \"\"\"Checks if for every prefix, the count of '<' is greater than or equal to '>'. \"\"\"\n        balance = 0\n        for char in brackets:\n            if char == '<':\n                balance += 1\n            elif char == '>':\n                balance -= 1\n            if balance < 0:\n                return False\n        return True\n\n    def check_counts(self, brackets: str) -> bool:\n        \"\"\"Checks if the total count of '<' equals the total count of '>'.\"\"\"\n        return brackets.count('<') == brackets.count('>')\ndef correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n\n    >>> correct_bracketing(\"<\")\n    False\n    >>> correct_bracketing(\"<>\")\n    True\n    >>> correct_bracketing(\"<<><>>\")\n    True\n    >>> correct_bracketing(\"><<>\")\n    False\n    \"\"\"\n    validator = BracketValidator()\n    return validator.correct_bracketing(brackets)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/57": [{"task_id": "HumanEval/57", "solution": 