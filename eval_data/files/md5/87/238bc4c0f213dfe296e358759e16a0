-empty sub-array\n    of nums.\n    \"\"\"\n    validated_input = validate_input(nums)\n    calculator = MinSubarrayCalculator()\n    return calculator.computeMin(validated_input)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/115": [{"task_id": "HumanEval/115", "solution": "import math\nfrom typing import List", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/113": [{"task_id": "HumanEval/113", "solution": "import re\nTEMPLATE = \"the number of odd elements in the string i of the input.\"\ndef count_odd_digits(s: str) -> int:\n    \"\"\"Counts the number of odd digits in a string.\"\"\"\n    odd_digits = {'1', '3', '5', '7', '9'}\n    count = 0\n    for char in s:\n        if char in odd_digits:\n            count += 1\n    return count\ndef substitute_template(count: int) -> str:\n    \"\"\"Substitutes every 'i' in the TEMPLATE with the given count.\"\"\"\n    return TEMPLATE.replace('i', str(count))\ndef odd_count(lst):\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\n    \"\"\"\n    validate_input(lst)\n    \n    results = []\n    for s in lst:\n        count = count_odd_digits(s)\n        output_string = substitute_template(count)\n        results.append(output_string)\n        \n    return results", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[["1234567"]]], "plus_fail_tests": [[["2468"]]]}], "HumanEval/96": [{"task_id": "HumanEval/96", "solution": "from typing import List, Optional\nclass InputParameter:\n    \"\"\"Holds an input integer and validates it.\"\"\"\n    def __init__(self, n):\n        self.n = n\n\n    def validate(self) -> bool:\n        \"\"\"Validates if n is a non-negative integer.\"\"\"\n        return isinstance(self.n, int) and self.n >= 0\nclass PrimeList:\n    \"\"\"A container for prime numbers with sorting capabilities.\"\"\"\n    def __init__(self, primes: Optional[List[int]] = None):\n        self.primes = primes if primes is not None else []\n\n    def sort_ascending(self) -> None:\n        \"\"\"Sorts the stored prime numbers in ascending order.\"\"\"\n        self.primes.sort()\nclass PrimeCalculator:\n    \"\"\"Calculates and generates prime numbers.\"\"\"\n    def __init__(self):\n        pass\n\n    def is_prime(self, x: int) -> bool:\n        \"\"\"Determines if a number is prime.\"\"\"\n        if x < 2:\n            return False\n        for i in range(2, int(x**0.5) + 1):\n            if x % i == 0:\n                return False\n        return True\n\n    def generate_primes(self, limit: int) -> List[int]:\n        \"\"\"Generates a list of prime numbers up to a given limit, sorted.\"\"\"\n        raw_primes = []\n        for num in range(2, limit + 1):\n            if self.is_prime(num):\n                raw_primes.append(num)\n        \n        prime_list_container = PrimeList(raw_primes)\n        prime_list_container.sort_ascending()\n        return prime_list_container.primes\ndef count_up_to(n):\n    \"\"\"Implement a function that takes a non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    for example:\n    count_up_to(5) => [2,3]\n    count_up_to(11) => [2,3,5,7]\n    count_up_to(0) => []\n    count_up_to(20) => [2,3,5,7,11,13,17,19]\n    count_up_to(1) => []\n    count_up_to(18) => [2,3,5,7,11,13,17]\n    \"\"\"\n    input_param = InputParameter(n)\n    if not input_param.validate():\n        # Behavior for invalid input is unspecified by SRS. Returning empty list.\n        return []\n\n    if n <= 2:\n        return []\n\n    calculator = PrimeCalculator()\n    primes_less_than_n = calculator.generate_primes(limit=n - 1)\n\n    return primes_less_than_n", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/116": [{"task_id": "HumanEval/116", "solution": "from typing import List, Optional\nclass IntegerElement:\n    \"\"\"Represents an integer value with its bit count and negativity status.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n        self.bitCount: Optional[int] = None\n        self.isNegative = value < 0\n\n    def computeBitCount(self) -> Optional[int]:\n        \"\"\"Computes and stores the number of '1' bits for non-negative integers.\"\"\"\n        if self.isNegative:\n            return self.bitCount # Bit count is not computed for negative numbers for this specific sorting logic.\n\n        if self.value == 0:\n            self.bitCount = 0\n        else:\n            self.bitCount = bin(self.value).count('1')\n        return self.bitCount\nclass InputArray:\n    \"\"\"A container for input integers, wrapped as IntegerElement objects.\"\"\"\n    def __init__(self, arr: List[int]):\n        self.elements: List[IntegerElement] = [IntegerElement(val) for val in arr]\nclass OutputArray:\n    \"\"\"A container for sorted IntegerElement objects, convertible back to a list of integers.\"\"\"\n    def __init__(self, elements: List[IntegerElement]):\n        self.elements = elements\n\n    def to_list(self) -> List[int]:\n        \"\"\"Converts the contained IntegerElement objects back to a list of their integer values.\"\"\"\n        return [e.value for e in self.elements]\nclass SortArray:\n    \"\"\"Orchestrates sorting an array of integers based on specified rules.\"\"\"\n    def execute(self, arr: List[int]) -> List[int]:\n        \"\"\"\n        Sorts an array of integers. For non-negative integers, it sorts by ascending bit-count,\n        then by decimal value. If all integers are negative, it sorts by numeric ascending order.\n        \"\"\"\n        input_container = InputArray(arr)\n\n        if all(e.isNegative for e in input_container.elements):\n            sorted_values = sorted([e.value for e in input_container.elements])\n            output = OutputArray([IntegerElement(v) for v in sorted_values])\n            return output.to_list()\n        \n        for e in input_container.elements:\n            if not e.isNegative:\n                e.computeBitCount()\n        \n        # Sort elements by (bitCount, value). Negative numbers will have bitCount=None,\n        # which Python's comparison places before integers, effectively grouping them first.\n        # Within the None group, they are sorted by value.\n        sorted_elements = sorted(input_container.elements, key=lambda x: (x.bitCount, x.value))\n        output = OutputArray(sorted_elements)\n        return output.to_list()\ndef sort_array(arr: List[int]) -> List[int]:\n    \"\"\"\n    In this Kata, you have to sort an array of non-negative integers according to\n    number of ones in their binary representation in ascending order.\n    For similar number of ones, sort based on decimal value.\n    \"\"\"\n    sorter = SortArray()\n    return sorter.execute(arr)", "base_status": "fail", "plus_status": "pass", "base_fail_tests": [[[-2, -3, -4, -5, -6]]], "plus_fail_tests": []}], "HumanEval/117": [{"task_id": "HumanEval/117", "solution": "class ConsonantCounter:\n    \"\"\"Encapsulates vowel set and provides consonant membership and counting.\"\"\"\n    def __init__(self):\n        self.vowels = {'a', 'e', 'i', 'o', 'u'}\n\n    def isConsonant(self, char: str) -> bool:\n        \"\"\"Checks if a character is a consonant (case-insensitive).\"\"\"\n        char_lower = char.lower()\n        return char_lower.isalpha() and char_lower not in self.vowels\n\n    def count(self, text: str) -> int:\n        \"\"\"Counts consonants in a given text (case-insensitive).\"\"\"\n        consonant_count = 0\n        for char in text:\n            if self.isConsonant(char):\n                consonant_count += 1\n        return consonant_count\nclass Word:\n    \"\"\"Represents a parsed word token including its original text, position, and computed consonantCount.\"\"\"\n    def __init__(self, text: str, position: int):\n        self.text = text\n        self.position = position\n        self.consonantCount = 0\n\n    def countConsonants(self, counter: ConsonantCounter) -> int:\n        \"\"\"Computes and stores the consonant count for the word using a ConsonantCounter.\"\"\"\n        self.consonantCount = counter.count(self.text)\n        return self.consonantCount\nclass InputString:\n    \"\"\"Tokenizes raw input string s into Word domain objects.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n\n    def parse(self) -> list[Word]:\n        \"\"\"Parses the raw string into a list of Word objects, splitting by space and ignoring empty tokens.\"\"\"\n        words_list = []\n        tokens = self.raw.split(' ')\n        for i, token in enumerate(tokens):\n            if token:\n                words_list.append(Word(text=token, position=i))\n        return words_list\nclass OutputList:\n    \"\"\"Collects matching Word instances and converts them to a list of original strings.\"\"\"\n    def __init__(self):\n        self.results = []\n\n    def append(self, word: Word) -> None:\n        \"\"\"Adds a matching Word object to the internal results list.\"\"\"\n        self.results.append(word)\n\n    def toList(self) -> list[str]:\n        \"\"\"Returns a list of the original text from the collected Word objects, preserving order.\"\"\"\n        return [w.text for w in self.results]\ndef select_words(s, n):\n    \"\"\"Given a string s and a natural number n, this function returns a list of all words from string s\n    that contain exactly n consonants, in order these words appear in the string s.\n    \"\"\"\n    input_obj = InputString(s)\n    words = input_obj.parse()\n    \n    if not words:\n        return []\n    \n    counter = ConsonantCounter()\n    out = OutputList()\n    \n    for w in words:\n        w.countConsonants(counter)\n        if w.consonantCount == n:\n            out.append(w)\n            \n    return out.toList()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/123": [{"task_id": "HumanEval/123", "solution": "from typing import List, Set\nclass InputValidator:\n    \"\"\"Validates input n to be a positive integer.\"\"\"\n    def validate(self, n):\n        if not isinstance(n, int):\n            raise ValueError(\"Input n must be an integer.\")\n        if n <= 0:\n            raise ValueError(\"Input n must be a positive integer.\")\nclass CollatzSequenceGenerator:\n    \"\"\"Generates the Collatz sequence for a given number n.\"\"\"\n    def generate(self, n: int) -> List[int]:\n        sequence = [n]\n        current = n\n        while current != 1:\n            if current % 2 == 0:\n                current //= 2\n            else:\n                current = 3 * current + 1\n            sequence.append(current)\n        return sequence\nclass OddCollector:\n    \"\"\"Collects unique odd numbers from a list of integers.\"\"\"\n    def collect(self, sequence: List[int]) -> Set[int]:\n        odd_numbers = set()\n        for num in sequence:\n            if num % 2 != 0:\n                odd_numbers.add(num)\n        return odd_numbers\nclass Result:\n    \"\"\"Holds the final sorted list of odd numbers.\"\"\"\n    def __init__(self, odd_list: List[int]):\n        self.odd_list = odd_list\n\n    @classmethod\n    def build_from_iterable(cls, iterable) -> 'Result':\n        return cls(list(iterable))\ndef get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n\n    The Collatz conjecture is a conjecture in mathematics that concerns a sequence defined\n    as follows: start with any positive integer n. Then each term is obtained from the \n    previous term as follows: if the previous term is even, the next term is one half of \n    the previous term. If the previous term is odd, the next term is 3 times the previous\n    term plus 1. The conjecture is that no matter what value of n, the sequence will always reach 1.\n\n    Note: \n        1. Collatz(1) is [1].\n        2. returned list sorted in increasing order.\n\n    For example:\n    get_odd_collatz(5) returns [1, 5] # The collatz sequence for 5 is [5, 16, 8, 4, 2, 1], so the odd numbers are only 1, and 5.\n    \"\"\"\n    InputValidator().validate(n)\n    seq = CollatzSequenceGenerator().generate(n)\n    odd_set = OddCollector().collect(seq)\n    sorted_list = sorted(odd_set)\n    return Result.build_from_iterable(sorted_list).odd_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/120": [{"task_id": "HumanEval/120", "solution": "import heapq\nclass ErrorHandler:\n    def raiseTypeError(self, message: str):\n        raise TypeError(message)\n\n    def raiseValueError(self, message: str):\n        raise ValueError(message)\nclass InputArray:\n    def __init__(self, values: list):\n        self.values = values\n        self.length = len(values)\nclass KParameter:\n    def __init__(self, k: int):\n        self.k = k\nclass Validator:\n    def __init__(self, error_handler: ErrorHandler):\n        self._error_handler = error_handler\n\n    def validateElements(self, input_array: InputArray):\n        # Validates that 'arr' is a list and its elements are integers within the specified range.\n        if not isinstance(input_array.values, list):\n            self._error_handler.raiseTypeError(\"Input 'arr' must be a list.\")\n        \n        if not (1 <= input_array.length <= 1000):\n            self._error_handler.raiseValueError(f\"Length of 'arr' must be between 1 and 1000, got {input_array.length}.\")\n        \n        for i, val in enumerate(input_array.values):\n            if not isinstance(val, int):\n                self._error_handler.raiseTypeError(f\"Element at index {i} of 'arr' must be an integer, got {type(val).__name__}.\")\n            if not (-1000 <= val <= 1000):\n                self._error_handler.raiseValueError(f\"Element at index {i} of 'arr' must be between -1000 and 1000, got {val}.\")\n\n    def validateK(self, kparam: KParameter, input_array: InputArray):\n        # Validates that 'k' is an integer and within the valid range relative to 'arr's length.\n        if not isinstance(kparam.k, int):\n            self._error_handler.raiseTypeError(\"Input 'k' must be an integer.\")\n        \n        if not (0 <= kparam.k <= input_array.length):\n            self._error_handler.raiseValueError(f\"Input 'k' must be between 0 and the length of 'arr' ({input_array.length}), got {kparam.k}.\")\nclass Selector:\n    def selectTopK(self, input_array: InputArray, kparam: KParameter) -> list[int]:\n        # Uses heapq.nlargest to efficiently find the k largest elements from the array.\n        try:\n            selected = heapq.nlargest(kparam.k, input_array.values)\n            return selected\n        except Exception as e:\n            # Catches unexpected errors during selection and re-raises as a ValueError.\n            ErrorHandler().raiseValueError(f\"Internal error during selection of top k elements: {e}\")\nclass Sorter:\n    def sortAscending(self, values: list[int]) -> list[int]:\n        # Sorts the given list of integers in non-decreasing (ascending) order.\n        return sorted(values)\nclass ResultList:\n    def __init__(self, values: list[int]):\n        self.values = values\n        self.length = len(values)\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list \n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    error_handler = ErrorHandler()\n\n    # Construct initial data objects for input array and k parameter.\n    input_array = InputArray(values=arr)\n    kparam = KParameter(k=k)\n\n    # Validate inputs using the Validator component to ensure correctness.\n    validator = Validator(error_handler=error_handler)\n    validator.validateElements(input_array)\n    validator.validateK(kparam, input_array)\n\n    # If k is 0, return an empty list immediately as per the requirements.\n    if kparam.k == 0:\n        return ResultList([]).values\n\n    # Select the k largest numbers from the array using the Selector component.\n    selector = Selector()\n    selected = selector.selectTopK(input_array, kparam)\n\n    # Sort the selected numbers in ascending order using the Sorter component.\n    sorter = Sorter()\n    sorted_selected = sorter.sortAscending(selected)\n\n    # Encapsulate the final sorted list in ResultList and return its values.\n    return ResultList(sorted_selected).values", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/122": [{"task_id": "HumanEval/122", "solution": "from typing import List\nclass Error(Exception):\n    \"\"\"Represents validation/processing errors.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\nclass Element:\n    \"\"\"Represents a single integer element and evaluates the two-digit rule.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def hasAtMostTwoDigits(self) -> bool:\n        \"\"\"Returns True if the absolute value of the element is at most 99.\"\"\"\n        return -99 <= self.value <= 99\nclass Validator:\n    \"\"\"Validates input constraints for the array and k.\"\"\"\n    def validateArray(self, arr: List[int]) -> None:\n        \"\"\"Validates array length. Raises Error if invalid.\"\"\"\n        if not (1 <= len(arr) <= 100):\n            raise Error('arr empty or length out-of-range')\n\n    def validateK(self, k: int, length: int) -> None:\n        \"\"\"Validates k's range. Raises Error if invalid.\"\"\"\n        if not (1 <= k <= length):\n            raise Error('k out of range')\nclass Selector:\n    \"\"\"Provides selection and filtering functions for elements.\"\"\"\n    def selectFirstK(self, arr: List[int], k: int) -> List[Element]:\n        \"\"\"Selects the first k elements from arr and wraps them in Element objects.\"\"\"\n        return [Element(value) for value in arr[:k]]\n\n    def filterAtMostTwoDigits(self, elems: List[Element]) -> List[Element]:\n        \"\"\"Filters a list of Element objects based on the two-digit rule.\"\"\"\n        return [elem for elem in elems if elem.hasAtMostTwoDigits()]\nclass Summation:\n    \"\"\"Sums the values of filtered Element objects.\"\"\"\n    def sum(self, elems: List[Element]) -> int:\n        \"\"\"Calculates the sum of values from a list of Element objects.\"\"\"\n        return sum(elem.value for elem in elems)\ndef add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    validator = Validator()\n    selector = Selector()\n    summation = Summation()\n\n    validator.validateArray(arr)\n    validator.validateK(k, len(arr))\n\n    selected_elements = selector.selectFirstK(arr, k)\n    filtered_elements = selector.filterAtMostTwoDigits(selected_elements)\n    \n    final_sum = summation.sum(filtered_elements)\n    return final_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/119": [{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if concatenating two parenthesis strings in any order results in a balanced string.\n    Returns 'Yes' if a good string can be formed, 'No' otherwise.\n    \"\"\"\n\n    class ParenthesisString:\n        # Represents a string consisting only of '(' or ')' characters.\n        def __init__(self, value: str):\n            self.value = value\n\n        def length(self) -> int:\n            return len(self.value)\n\n        def isEmpty(self) -> bool:\n            return self.length() == 0\n\n        def is_valid_chars(self) -> bool:\n            # Assumes input string contains only '(' or ')' based on problem description.\n            return all(c in ('(', ')') for c in self.value)\n\n    class InputList:\n        # Holds exactly two ParenthesisString items.\n        def __init__(self, items: list[ParenthesisString]):\n            self.items = items\n\n        def isValid(self) -> bool:\n            # Checks validity of the contained items.\n            return len(self.items) == 2 and \\\n                   self.items[0].is_valid_chars() and \\\n                   self.items[1].is_valid_chars()\n\n    class Concatenation:\n        # Provides an iterator view of two concatenated ParenthesisString objects.\n        def __init__(self, left: ParenthesisString, right: ParenthesisString):\n            self.left = left\n            self.right = right\n\n        def concat(self):\n            # Yields characters from the left string then the right string without materializing the full string.\n            yield from self.left.value\n            yield from self.right.value\n\n    class BalanceChecker:\n        # Determines if a sequence of parentheses is balanced.\n        def __init__(self):\n            pass\n\n        def isGood(self, s) -> bool:\n            # Iterates through characters, maintaining a running balance, and returns True if balanced.\n            runningBalance = 0\n            for char in s:\n                if char == '(':\n                    runningBalance += 1\n                elif char == ')':\n                    runningBalance -= 1\n                if runningBalance < 0:\n                    return False\n            return runningBalance == 0\n\n    def _validate_input(input_lst: list) -> InputList:\n        # Wraps the input strings into ParenthesisString objects.\n        # This assumes the input list adheres to the problem's preconditions (list of two strings, valid characters).\n        p_string1 = ParenthesisString(input_lst[0])\n        p_string2 = ParenthesisString(input_lst[1])\n        return InputList([p_string1, p_string2])\n\n    # Main logic\n    input_list_obj = _validate_input(lst)\n    \n    s1 = input_list_obj.items[0]\n    s2 = input_list_obj.items[1]\n\n    checker = BalanceChecker()\n\n    # Check the first concatenation order: s1 + s2\n    concatenation_order1 = Concatenation(s1, s2)\n    is_good1 = checker.isGood(concatenation_order1.concat())\n\n    # Check the second concatenation order: s2 + s1\n    concatenation_order2 = Concatenation(s2, s1)\n    is_good2 = checker.isGood(concatenation_order2.concat())\n\n    if is_good1 or is_good2:\n        return 'Yes'\n    else:\n        return 'No'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/118": [{"task_id": "HumanEval/118", "solution": "from typing import List\nclass VowelSet:\n    \"\"\"Provides canonical vowel membership testing.\"\"\"\n    def __init__(self):\n        self.vowels = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\n    def contains(self, c: str) -> bool:\n        \"\"\"Checks if a character is a vowel.\"\"\"\n        return c in self.vowels\nclass Character:\n    \"\"\"Represents a single character with position and vowel flag.\"\"\"\n    def __init__(self, value: str, position: int, parent_length: int, is_vowel: bool):\n        self.value = value\n        self.position = position\n        self._parent_length = parent_length\n        self.is_vowel = is_vowel\n\n    def isFirst(self) -> bool:\n        \"\"\"Checks if the character is at the first position.\"\"\"\n        return self.position == 0\n\n    def isLast(self) -> bool:\n        \"\"\"Checks if the character is at the last position.\"\"\"\n        return self.position == self._parent_length - 1\nclass GetClosestVowelFunction:\n    \"\"\"Encapsulates the algorithm to find the rightmost vowel between two consonants.\"\"\"\n    def __init__(self):\n        self._vowel_set = VowelSet()\n\n    def _is_vowel(self, c: str) -> bool:\n        \"\"\"Delegates vowel check to VowelSet.\"\"\"\n        return self._vowel_set.contains(c)\n\n    def _classify_characters(self, word: str) -> List[Character]:\n        \"\"\"Classifies each character in the word as a Character object.\"\"\"\n        characters = []\n        word_length = len(word)\n        for i, char_value in enumerate(word):\n            is_vowel = self._is_vowel(char_value)\n            characters.append(Character(char_value, i, word_length, is_vowel))\n        return characters\n\n    def _scan_right_to_left(self, chars: List[Character]) -> str:\n        \"\"\"Scans characters from right to left to find a qualifying vowel.\"\"\"\n        # Vowels at the beginning (index 0) and ending (index len-1) don't count.\n        # Thus, we iterate from the second to last character (index len-2)\n        # down to the second character (index 1), inclusive.\n        if len(chars) < 3:\n            return \"\"\n\n        for i in range(len(chars) - 2, 0, -1):\n            current_char = chars[i]\n            \n            if current_char.is_vowel:\n                left_neighbor = chars[i - 1]\n                right_neighbor = chars[i + 1]\n                \n                # Check if both neighbors are consonants\n                if not left_neighbor.is_vowel and not right_neighbor.is_vowel:\n                    return current_char.value\n        \n        return \"\"\n\n    def get_closest_vowel(self, word: str) -> str:\n        \"\"\"Finds the closest vowel that stands between two consonants from the right side.\"\"\"\n        classified_chars = self._classify_characters(word)\n        return self._scan_right_to_left(classified_chars)\ndef get_closest_vowel(word):\n    \"\"\"You are given a word. Your task is to find the closest vowel that stands between \n    two consonants from the right side of the word (case sensitive).\n    \n    Vowels in the beginning and ending doesn't count. Return empty string if you didn't\n    find any vowel met the above condition. \n\n    You may assume that the given string contains English letter only.\n\n    Example:\n    get_closest_vowel(\"yogurt\") ==> \"u\"\n    get_closest_vowel(\"FULL\") ==> \"U\"\n    get_closest_vowel(\"quick\") ==> \"\"\n    get_closest_vowel(\"ab\") ==> \"\"\n    \"\"\"\n    worker = GetClosestVowelFunction()\n    return worker.get_closest_vowel(word)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/124": [{"task_id": "HumanEval/124", "solution": "MONTHS_31_SET = {1, 3, 5, 7, 8, 10, 12}\nMONTHS_30_SET = {4, 6, 9, 11}\nFEBRUARY_MONTH = 2\nclass DateComponents:\n    \"\"\"Data holder for parsed month, day, year integers.\"\"\"\n    def __init__(self, month: int, day: int, year: int):\n        self.month = month\n        self.day = day\n        self.year = year\nclass DateValidator:\n    \"\"\"Encapsulates the date validation algorithm and orchestrates checks.\"\"\"\n    def validate(self, date: str) -> bool:\n        \"\"\"Validates a date string against all defined rules.\"\"\"\n        if not self._checkFormat(date):\n            return False\n\n        components = self._parseComponents(date)\n        if components is None:\n            return False\n\n        if not self._checkMonth(components.month):\n            return False\n\n        if not self._checkDay(components.day, components.month):\n            return False\n\n        return True\n\n    def _checkFormat(self, date: str) -> bool:\n        \"\"\"Verifies the string length and hyphen positions for 'mm-dd-yyyy'.\"\"\"\n        if not date or len(date) != 10:\n            return False\n        if date[2] != '-' or date[5] != '-':\n            return False\n        return True\n\n    def _parseComponents(self, date: str) -> DateComponents | None:\n        \"\"\"Extracts and converts month, day, year substrings to integers, ensuring they are digits.\"\"\"\n        mm_str = date[0:2]\n        dd_str = date[3:5]\n        yyyy_str = date[6:10]\n\n        if not (mm_str.isdigit() and dd_str.isdigit() and yyyy_str.isdigit()):\n            return None\n\n        month = int(mm_str)\n        day = int(dd_str)\n        year = int(yyyy_str)\n        return DateComponents(month, day, year)\n\n    def _checkMonth(self, month: int) -> bool:\n        \"\"\"Checks if the month value is within the valid range 1 to 12.\"\"\"\n        return 1 <= month <= 12\n\n    def _checkDay(self, day: int, month: int) -> bool:\n        \"\"\"Validates the day value based on the specific rules for the month.\"\"\"\n        if month in MONTHS_31_SET:\n            return 1 <= day <= 31\n        elif month in MONTHS_30_SET:\n            return 1 <= day <= 30\n        elif month == FEBRUARY_MONTH:\n            return 1 <= day <= 29\n        return False\ndef valid_date(date):\n    \"\"\"You have to write a function which validates a given date string and\n    returns True if the date is valid otherwise False.\n    The date is valid if all of the following rules are satisfied:\n    1. The date string is not empty.\n    2. The number of days is not less than 1 or higher than 31 days for months 1,3,5,7,8,10,12. And the number of days is not less than 1 or higher than 30 days for months 4,6,9,11. And, the number of days is not less than 1 or higher than 29 for the month 2.\n    3. The months should not be less than 1 or higher than 12.\n    4. The date should be in the format: mm-dd-yyyy\n\n    for example: \n    valid_date('03-11-2000') => True\n\n    valid_date('15-01-2012') => False\n\n    valid_date('04-0-2040') => False\n\n    valid_date('06-04-2020') => True\n\n    valid_date('06/04/2020') => False\n    \"\"\"\n    validator = DateValidator()\n    return validator.validate(date)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/121": [{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 2 == 0 and num % 2 != 0:\n            total_sum += num\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/125": [{"task_id": "HumanEval/125", "solution": "class InputText:\n    def __init__(self, txt: str):\n        self.txt = txt\n\n    def containsWhitespace(self) -> bool:\n        return any(c.isspace() for c in self.txt)\n\n    def containsComma(self) -> bool:\n        return ',' in self.txt\nclass Token:\n    def __init__(self, value: str, position: int):\n        self.value = value\n        self.position = position\nclass Splitter:\n    def splitOnWhitespace(self, txt: str) -> list[Token]:\n        tokens = txt.split()\n        return [Token(value, i) for i, value in enumerate(tokens)]\n\n    def splitOnComma(self, txt: str) -> list[Token]:\n        tokens = txt.split(',')\n        return [Token(value, i) for i, value in enumerate(tokens)]\nclass LetterCounter:\n    def countOddLowercase(self, txt: str) -> int:\n        count = 0\n        for c in txt:\n            if 'a' <= c <= 'z':\n                if (ord(c) - ord('a')) % 2 == 1:\n                    count += 1\n        return count\ndef split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    '''\n    input_text = InputText(txt)\n    \n    if input_text.containsWhitespace():\n        splitter = Splitter()\n        tokens = splitter.splitOnWhitespace(txt)\n        return [token.value for token in tokens]\n    elif input_text.containsComma():\n        splitter = Splitter()\n        tokens = splitter.splitOnComma(txt)\n        return [token.value for token in tokens]\n    else:\n        letter_counter = LetterCounter()\n        return letter_counter.countOddLowercase(txt)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/126": [{"task_id": "HumanEval/126", "solution": "class InputList:\n    def __init__(self, elements):\n        self.elements = elements\n        self.length = len(elements)\n\n    def validateElements(self) -> bool:\n        \"\"\"Validates that all elements are non-negative integers, as per BR-1.\"\"\"\n        for element in self.elements:\n            if not isinstance(element, int) or element < 0:\n                return False\n        return True\nclass AnalysisResult:\n    def __init__(self, is_sorted: bool, duplicates_valid: bool):\n        self.is_sorted = is_sorted\n        self.duplicates_valid = duplicates_valid\n        self.result = is_sorted and duplicates_valid\nclass InputProcessor:\n    def prepare(self, lst: list) -> InputList:\n        \"\"\"Prepares and validates the raw input list into an InputList object.\"\"\"\n        input_list = InputList(lst)\n        # As per design, call validateElements. Given the is_sorted docstring's assumption,\n        # this check should always pass for inputs to is_sorted.\n        input_list.validateElements()\n        return input_list\nclass SortChecker:\n    def isNonDecreasing(self, input_list: InputList) -> bool:\n        \"\"\"Checks if the InputList is sorted in non-decreasing order, per BR-3.\"\"\"\n        if input_list.length <= 1:\n            return True\n        for i in range(1, input_list.length):\n            if input_list.elements[i] < input_list.elements[i-1]:\n                return False\n        return True\nclass DuplicateChecker:\n    def __init__(self):\n        self.maxAllowed = 2 # As per BR-4\n\n    def countOccurrences(self, input_list: InputList) -> dict:\n        \"\"\"Counts occurrences of each element in the InputList.\"\"\"\n        counts = {}\n        for element in input_list.elements:\n            counts[element] = counts.get(element, 0) + 1\n        return counts\n\n    def hasExcessDuplicates(self, input_list: InputList) -> bool:\n        \"\"\"Determines if any element occurs more than maxAllowed times, per BR-4.\"\"\"\n        counts = self.countOccurrences(input_list)\n        for count in counts.values():\n            if count > self.maxAllowed:\n                return True\n        return False\nclass ResultAggregator:\n    def aggregate(self, is_sorted: bool, duplicates_valid: bool) -> AnalysisResult:\n        \"\"\"Aggregates sorting and duplicate validity flags into an AnalysisResult.\"\"\"\n        return AnalysisResult(is_sorted, duplicates_valid)\n\n    def finalResult(self, ar: AnalysisResult) -> bool:\n        \"\"\"Extracts the final boolean result from an AnalysisResult object.\"\"\"\n        return ar.result\ndef is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n\n    Examples\n    is_sorted([5]) \u279e True\n    is_sorted([1, 2, 3, 4, 5]) \u279e True\n    is_sorted([1, 3, 2, 4, 5]) \u279e False\n    is_sorted([1, 2, 3, 4, 5, 6]) \u279e True\n    is_sorted([1, 2, 3, 4, 5, 6, 7]) \u279e True\n    is_sorted([1, 3, 2, 4, 5, 6, 7]) \u279e False\n    is_sorted([1, 2, 2, 3, 3, 4]) \u279e True\n    is_sorted([1, 2, 2, 2, 3, 4]) \u279e False\n    '''\n    ip = InputProcessor()\n    input_list = ip.prepare(lst)\n\n    # FR-3 / BR-2: System shall return True for any input list of length 1.\n    # Also handles empty lists, which are conventionally considered sorted and without excess duplicates.\n    if input_list.length <= 1:\n        return ResultAggregator().finalResult(ResultAggregator().aggregate(True, True))\n\n    sc = SortChecker()\n    is_sorted_flag = sc.isNonDecreasing(input_list)\n\n    dc = DuplicateChecker()\n    duplicates_valid = (not dc.hasExcessDuplicates(input_list))\n\n    ar = ResultAggregator().aggregate(is_sorted_flag, duplicates_valid)\n    return ResultAggregator().finalResult(ar)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/127": [{"task_id": "HumanEval/127", "solution": "import math\nclass Interval:\n    \"\"\"Represents a closed integer interval and provides validation and intersection helpers.\"\"\"\n    def __init__(self, start: int, end: int):\n        self.start = start\n        self.end = end\n\n    def validate(self) -> bool:\n        \"\"\"Returns True if start <= end.\"\"\"\n        return self.start <= self.end\n\n    def intersectionWith(self, other: 'Interval') -> 'Intersection':\n        \"\"\"Returns an Intersection object representing the intersection of two intervals.\"\"\"\n        max_start = max(self.start, other.start)\n        min_end = min(self.end, other.end)\n        return Intersection(max_start, min_end)\nclass Intersection:\n    \"\"\"Represents the intersection interval and computes its length.\"\"\"\n    def __init__(self, start: int, end: int):\n        self.start = start\n        self.end = end\n        self.length = 0\n\n    def computeLength(self) -> int:\n        \"\"\"Computes and returns the length of the intersection as end - start.\"\"\"\n        self.length = self.end - self.start\n        return self.length\nclass PrimeChecker:\n    \"\"\"Determines primality of integer values.\"\"\"\n    def isPrime(self, n: int) -> bool:\n        \"\"\"Returns True if n is a prime number, False otherwise.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\nclass IntersectionService:\n    \"\"\"Orchestrates validation, intersection computation, length calculation, and primality check.\"\"\"\n    def __init__(self, prime_checker: PrimeChecker = None):\n        self.prime_checker = prime_checker if prime_checker is not None else PrimeChecker()\n\n    def compute(self, interval_a: Interval, interval_b: Interval) -> str:\n        \"\"\"Computes the intersection of two intervals and checks if its length is a prime number.\"\"\"\n        if not interval_a.validate() or not interval_b.validate():\n            return \"NO\"\n\n        intersection_obj = interval_a.intersectionWith(interval_b)\n        length = intersection_obj.computeLength()\n\n        if length <= 0:\n            return \"NO\"\n\n        if self.prime_checker.isPrime(length):\n            return \"YES\"\n        else:\n            return \"NO\"\ndef intersection(interval1, interval2):\n    \"\"\"Checks if the length of the intersection of two intervals is a prime number.\"\"\"\n    int1 = Interval(interval1[0], interval1[1])\n    int2 = Interval(interval2[0], interval2[1])\n\n    service = IntersectionService()\n    return service.compute(int1, int2)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/132": [{"task_id": "HumanEval/132", "solution": "from typing import List\nclass Bracket:\n    \"\"\"Represents a single bracket character along with its original index.\"\"\"\n    def __init__(self, value: str, index: int):\n        self.value = value\n        self.index = index\n\n    def isOpen(self) -> bool:\n        \"\"\"Returns True if the bracket is an opening bracket ('[').\"\"\"\n        return self.value == '['\nclass AnalysisResult:\n    \"\"\"A data transfer object to hold the final boolean result of the analysis.\"\"\"\n    def __init__(self, has_nested_subsequence: bool):\n        self.hasNestedSubsequence = has_nested_subsequence\nclass BracketSequence:\n    \"\"\"Encapsulates the input string and performs the core analysis for nested subsequences.\"\"\"\n    def __init__(self, input_str: str):\n        self.input = input_str\n        self.length = len(input_str)\n        self.chars: List[Bracket] = [Bracket(char_val, i) for i, char_val in enumerate(input_str)]\n\n    def isEmpty(self) -> bool:\n        \"\"\"Returns True if the input string is empty.\"\"\"\n        return self.length == 0\n\n    def findNestedSubsequence(self) -> AnalysisResult:\n        \"\"\"\n        Determines if there exists a balanced subsequence with maximum nesting depth >= 2.\n        This is achieved by searching for a subsequence of the form `[[ ]]`.\n        \"\"\"\n        if self.isEmpty():\n            return AnalysisResult(False)\n\n        # We are looking for the pattern '[' ... '[' ... ']' ... ']' as a subsequence.\n        # This specifically means finding indices i < j < k < l such that:\n        # string[i] == '['\n        # string[j] == '['\n        # string[k] == ']'\n        # string[l] == ']'\n        # If this pattern exists, a subsequence `[[]]` can be formed, which has a nesting depth of 2.\n\n        found_first_open = False    # State: found the first '['\n        found_second_open = False   # State: found the second '['\n        found_first_close = False   # State: found the first ']' for the inner pair\n\n        for bracket in self.chars:\n            if not found_first_open and bracket.isOpen():\n                found_first_open = True\n            elif found_first_open and not found_second_open and bracket.isOpen():\n                found_second_open = True\n            elif found_second_open and not found_first_close and not bracket.isOpen(): # char is ']'\n                found_first_close = True\n            elif found_first_close and not bracket.isOpen(): # char is ']'\n                # Found all four components: '[', '[', ']', ']' in order\n                return AnalysisResult(True)\n\n        return AnalysisResult(False)\ndef is_nested(string):\n    \"\"\"\n    Checks if a string containing only square brackets has a valid subsequence of brackets\n    where at least one bracket in the subsequence is nested (i.e., nesting depth >= 2).\n    \"\"\"\n    # Validate input characters: Must contain only '[' and ']'\n    valid_chars = {'[', ']'}\n    for char in string:\n        if char not in valid_chars:\n            raise ValueError(\"Input string must contain only square brackets ('[' and ']')\")\n\n    # Orchestrate domain analysis\n    bracket_sequence = BracketSequence(string)\n    result = bracket_sequence.findNestedSubsequence()\n    return result.hasNestedSubsequence", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["[][][]"]]}], "HumanEval/131": [{"task_id": "HumanEval/131", "solution": "class PositiveInteger:\n    \"\"\"Represents a validated positive integer input.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isValid(self) -> bool:\n        \"\"\"Returns True if value is an integer > 0.\"\"\"\n        return isinstance(self.value, int) and self.value > 0\nclass Digit:\n    \"\"\"Represents a single decimal digit with position metadata.\"\"\"\n    def __init__(self, value: int, position: int):\n        self.value = value\n        self.position = position\n\n    def isOdd(self) -> bool:\n        \"\"\"Returns True if value is an odd digit.\"\"\"\n        return self.value in {1, 3, 5, 7, 9}\nclass Validator:\n    \"\"\"Validates raw inputs according to design rules.\"\"\"\n    def validate(self, n) -> bool:\n        \"\"\"Accepts raw int or PositiveInteger; returns True if n > 0 and integral.\"\"\"\n        if isinstance(n, PositiveInteger):\n            return n.isValid()\n        return isinstance(n, int) and n > 0\nclass DigitExtractor:\n    \"\"\"Extracts decimal digits from a validated PositiveInteger.\"\"\"\n    def extractDigits(self, n_obj: PositiveInteger) -> list:\n        \"\"\"Returns Digit objects ordered by position (units=0,...).\"\"\"\n        digits_list = []\n        s_n = str(n_obj.value)\n        for i, char_digit in enumerate(reversed(s_n)):\n            digits_list.append(Digit(int(char_digit), i))\n        return digits_list\nclass ProductCalculator:\n    \"\"\"Computes multiplicative product of odd digits; returns 0 if none found.\"\"\"\n    def computeProduct(self, digits: list) -> int:\n        \"\"\"Returns product of odd Digit.value entries, or 0 if none.\"\"\"\n        product = 1\n        found_odd = False\n        for digit_obj in digits:\n            if digit_obj.isOdd():\n                product *= digit_obj.value\n                found_odd = True\n        return product if found_odd else 0\ndef digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    validator = Validator()\n    digit_extractor = DigitExtractor()\n    product_calculator = ProductCalculator()\n\n    if not validator.validate(n):\n        raise ValueError(\"Input must be a positive integer.\")\n\n    positive_integer_obj = PositiveInteger(n)\n    extracted_digits = digit_extractor.extractDigits(positive_integer_obj)\n    result_product = product_calculator.computeProduct(extracted_digits)\n\n    return result_product", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/128": [{"task_id": "HumanEval/128", "solution": "class IntegerElement:\n    \"\"\"\n    Represents a single integer element with methods to get its sign and magnitude.\n    \"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def sign(self) -> int:\n        \"\"\"Returns 1 for positive, -1 for negative, and 0 for zero.\"\"\"\n        if self._value > 0:\n            return 1\n        elif self._value < 0:\n            return -1\n        else:\n            return 0\n\n    def magnitude(self) -> int:\n        \"\"\"Returns the absolute value of the integer.\"\"\"\n        return abs(self._value)\nclass Array:\n    \"\"\"\n    Wraps a list of integers, converting them into IntegerElement instances.\n    Provides iteration over these elements.\n    \"\"\"\n    def __init__(self, values: list[int]):\n        self._elements: list[IntegerElement] = [IntegerElement(v) for v in values]\n\n    def __iter__(self):\n        return iter(self._elements)\n\n    def __len__(self):\n        return len(self._elements)\nclass Result:\n    \"\"\"\n    Encapsulates the final result, which can be an integer or None.\n    \"\"\"\n    def __init__(self, value: int | None):\n        self.value = value\nclass ProdSigns:\n    \"\"\"\n    Service class responsible for orchestrating the sign and magnitude calculations.\n    It delegates to IntegerElement and Array for specific responsibilities.\n    \"\"\"\n    def compute_sign(self, num: int) -> int:\n        \"\"\"Computes the sign of a raw integer.\"\"\"\n        if num > 0:\n            return 1\n        elif num < 0:\n            return -1\n        else:\n            return 0\n\n    def product_of_signs(self, arr_obj: Array) -> int:\n        \"\"\"Calculates the product of signs for all elements in the array.\"\"\"\n        prod = 1\n        for element in arr_obj:\n            s = element.sign()\n            if s == 0:\n                return 0  # Short-circuit if any sign is 0\n            prod *= s\n        return prod\n\n    def sum_of_magnitudes(self, arr_obj: Array) -> int:\n        \"\"\"Calculates the sum of magnitudes for all elements in the array.\"\"\"\n        total_magnitude = 0\n        for element in arr_obj:\n            total_magnitude += element.magnitude()\n        return total_magnitude\n\n    def prod_signs(self, arr: list[int]) -> int | None:\n        \"\"\"\n        Orchestrates the calculation of sum of magnitudes multiplied by product of signs.\n        Returns None for an empty input array.\n        \"\"\"\n        if not arr:\n            return Result(None).value\n\n        array_obj = Array(arr)\n        product = self.product_of_signs(array_obj)\n        total_magnitude = self.sum_of_magnitudes(array_obj)\n\n        final_result = product * total_magnitude\n        return Result(final_result).value\ndef prod_signs(arr: list[int]) -> int | None:\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n    \"\"\"\n    service = ProdSigns()\n    return service.prod_signs(arr)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/135": [{"task_id": "HumanEval/135", "solution": "from dataclasses import dataclass\nclass Validator:\n    \"\"\"Provides static methods for input validation.\"\"\"\n\n    @staticmethod\n    def validateNoDuplicates(arr) -> bool:\n        \"\"\"Checks if the array contains duplicate values.\"\"\"\n        if isinstance(arr, Array):\n            actual_arr = arr.elements\n        else:\n            actual_arr = arr\n        return len(actual_arr) == len(set(actual_arr))\n\n    @staticmethod\n    def validateLength(arr) -> bool:\n        \"\"\"Checks if the array has at least two elements.\"\"\"\n        if isinstance(arr, Array):\n            actual_len = arr.length()\n        else:\n            actual_len = len(arr)\n        return actual_len >= 2\ndef can_arrange(arr):\n    \"\"\"\n    Returns the largest index of an element which is not greater than or equal to\n    the element immediately preceding it. Returns -1 if no such element exists.\n    \"\"\"\n    if not Validator.validateLength(arr):\n        return -1\n\n    # The design specifies calling validateNoDuplicates but not altering behavior for duplicates.\n    _duplicates_ok = Validator.validateNoDuplicates(arr)\n\n    last_drop_index = -1\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            last_drop_index = i\n\n    return last_drop_index", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 2, 4, 3, 5]]], "plus_fail_tests": [[[1]]]}], "HumanEval/133": [{"task_id": "HumanEval/133", "solution": "import math\ndef _apply_ceil(lst):\n    \"\"\"Applies math.ceil to each element in the list, returning a list of integers.\"\"\"\n    return [math.ceil(x) for x in lst]\ndef _square_values(int_list):\n    \"\"\"Computes the square of each integer in the list.\"\"\"\n    return [n * n for n in int_list]\ndef _sum_values(int_list):\n    \"\"\"Computes the sum of integers in the list.\"\"\"\n    return sum(int_list)\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    Examples:\n    For lst = [1,2,3] the output should be 14\n    For lst = [1,4,9] the output should be 98\n    For lst = [1,3,5,7] the output should be 84\n    For lst = [1.4,4.2,0] the output should be 29\n    For lst = [-2.4,1,1] the output should be 6\n    \"\"\"\n    _validate_input(lst)\n    rounded_list = _apply_ceil(lst)\n    squared_list = _square_values(rounded_list)\n    total_sum = _sum_values(squared_list)\n    return total_sum", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 2, 3]]], "plus_fail_tests": [[[-3, 4, 5, 6, 7]]]}], "HumanEval/134": [{"task_id": "HumanEval/134", "solution": "class TextInput:\n    def __init__(self, txt: str) -> None:\n        self.txt = txt\n\n    def is_empty(self) -> bool:\n        return not self.txt\n\n    def ends_with_space(self) -> bool:\n        return self.txt.endswith(' ')\nclass Tokenizer:\n    def tokenize(self, txt: str) -> list[str]:\n        return txt.split(' ')\n\n    def last_non_empty_token(self, txt: str) -> str | None:\n        tokens = self.tokenize(txt)\n        for token_value in reversed(tokens):\n            if token_value:\n                return token_value\n        return None\nclass Token:\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\n\n    def is_single_char(self) -> bool:\n        return self.length() == 1\nclass Character:\n    def __init__(self, value: str, position: int = 0) -> None:\n        self.value = value\n        self.position = position\n\n    def is_alpha(self) -> bool:\n        return self.value.isalpha()\n\n    def is_last(self, token: Token) -> bool:\n        return self.position == token.length() - 1\nclass Result:\n    def __init__(self, value: bool) -> None:\n        self.value = value\nclass Evaluator:\n    def __init__(self, tokenizer: Tokenizer | None = None) -> None:\n        self.tokenizer = tokenizer if tokenizer is not None else Tokenizer()\n\n    def is_last_char_standalone_alpha(self, txt: str) -> bool:\n        text_input = TextInput(txt)\n\n        if text_input.is_empty():\n            return Result(False).value\n\n        if text_input.ends_with_space():\n            return Result(False).value\n\n        last_token_value = self.tokenizer.last_non_empty_token(txt)\n\n        if last_token_value is None:\n            return Result(False).value\n\n        token = Token(last_token_value)\n\n        if not token.is_single_char():\n            return Result(False).value\n\n        char_obj = Character(token.value[0])\n\n        if char_obj.is_alpha():\n            return Result(True).value\n        else:\n            return Result(False).value\ndef check_if_last_char_is_a_letter(txt):\n    '''\n    Create a function that returns True if the last character\n    of a given string is an alphabetical character and is not\n    a part of a word, and False otherwise.\n    '''\n    evaluator = Evaluator()\n    return evaluator.is_last_char_standalone_alpha(txt)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/138": [{"task_id": "HumanEval/138", "solution": "class NumberInput:\n    \"\"\"Represents an input integer and provides parity checking.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_even(self) -> bool:\n        return self.value % 2 == 0\nclass IsEqualToSumEvenService:\n    \"\"\"Encapsulates business logic to determine if a number meets the criteria.\"\"\"\n    def is_equal_to_sum_even(self, n: int) -> bool:\n        \"\"\"Determines if n can be written as the sum of exactly 4 positive even numbers.\"\"\"\n        num = NumberInput(n)\n        if not num.is_even():\n            return False\n        return n >= 8\ndef is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers\n    Example\n    is_equal_to_sum_even(4) == False\n    is_equal_to_sum_even(6) == False\n    is_equal_to_sum_even(8) == True\n    \"\"\"\n    service = IsEqualToSumEvenService()\n    return service.is_equal_to_sum_even(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/136": [{"task_id": "HumanEval/136", "solution": "from typing import List, Optional, Tuple\nclass IntegerList:\n    \"\"\"Holds a list of integer values and provides filters for positive and negative numbers.\"\"\"\n    def __init__(self, elements: List[int]):\n        self.elements = elements\n\n    def get_negatives(self) -> List[int]:\n        \"\"\"Returns a list of all negative integers.\"\"\"\n        return [item for item in self.elements if item < 0]\n\n    def get_positives(self) -> List[int]:\n        \"\"\"Returns a list of all positive integers.\"\"\"\n        return [item for item in self.elements if item > 0]\nclass Result:\n    \"\"\"Represents the computed result of the largest negative and smallest positive integers.\"\"\"\n    def __init__(self, largest_negative: Optional[int], smallest_positive: Optional[int]):\n        self.largest_negative = largest_negative\n        self.smallest_positive = smallest_positive\n\n    def to_tuple(self) -> Tuple[Optional[int], Optional[int]]:\n        \"\"\"Converts the result to a tuple.\"\"\"\n        return (self.largest_negative, self.smallest_positive)\nclass LargestSmallestService:\n    \"\"\"Encapsulates the logic to compute the largest negative and smallest positive integers.\"\"\"\n    def largest_smallest_integers(self, lst: List[int]) -> Result:\n        \"\"\"\n        Computes the largest negative and smallest positive integers from a list.\n        Returns a Result object with the computed values.\n        \"\"\"\n        if not lst:\n            return Result(None, None)\n\n        integer_list_obj = IntegerList(lst)\n        negatives = integer_list_obj.get_negatives()\n        positives = integer_list_obj.get_positives()\n\n        largest_negative = max(negatives) if negatives else None\n        smallest_positive = min(positives) if positives else None\n\n        return Result(largest_negative, smallest_positive)\ndef largest_smallest_integers(lst) -> Tuple[Optional[int], Optional[int]]:\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n    '''\n    service = LargestSmallestService()\n    result = service.largest_smallest_integers(lst)\n    return result.to_tuple()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/137": [{"task_id": "HumanEval/137", "solution": "class Result:\n    \"\"\"DTO capturing comparison outcome.\"\"\"\n    def __init__(self, is_equal: bool, winner_original_value=None, winner_type=None):\n        self.is_equal = is_equal\n        self.winner_original_value = winner_original_value\n        self.winner_type = winner_type\nclass InputParameter:\n    \"\"\"Encapsulates original value and its numeric representation.\"\"\"\n    def __init__(self, original_value):\n        self.original_value = original_value\n        self.original_type = type(original_value).__name__\n        self.representation = None\n        self.decimal_separator = None\n        self.numeric_value = None\n\n    def parse(self):\n        \"\"\"Normalize representation and compute numeric_value, relying on Python's float conversion for type checks.\"\"\"\n        if isinstance(self.original_value, str):\n            self.representation = self.original_value\n            normalized_representation = self.representation\n\n            if ',' in self.representation:\n                self.decimal_separator = ','\n                normalized_representation = self.representation.replace(',', '.')\n            elif '.' in self.representation:\n                self.decimal_separator = '.'\n            else:\n                self.decimal_separator = None\n\n            self.numeric_value = float(normalized_representation) # Raises ValueError for malformed strings.\n        else:\n            # For int/float, convert directly. This will raise TypeError for unsupported types.\n            self.numeric_value = float(self.original_value)\n            self.representation = str(self.original_value)\n            self.decimal_separator = None # Per design for non-string types.\nclass ComparisonEngine:\n    \"\"\"Stateless service for numerical comparison.\"\"\"\n    def compare(self, a: InputParameter, b: InputParameter) -> Result:\n        \"\"\"Compares numeric_value fields using double-precision semantics.\"\"\"\n        if a.numeric_value > b.numeric_value:\n            return Result(is_equal=False, winner_original_value=a.original_value, winner_type=a.original_type)\n        elif b.numeric_value > a.numeric_value:\n            return Result(is_equal=False, winner_original_value=b.original_value, winner_type=b.original_type)\n        else:\n            return Result(is_equal=True)\ndef compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n    \"\"\"\n    a_param = InputParameter(a)\n    a_param.parse()\n\n    b_param = InputParameter(b)\n    b_param.parse()\n\n    engine = ComparisonEngine()\n    comparison_result = engine.compare(a_param, b_param)\n\n    if comparison_result.is_equal:\n        return None\n    else:\n        return comparison_result.winner_original_value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/142": [{"task_id": "HumanEval/142", "solution": "from typing import List\nclass OperationRule:\n    \"\"\"Encodes index-based decision logic for choosing the operation type.\"\"\"\n    def isMultipleOf(self, index: int, n: int) -> bool:\n        return index % n == 0\n\n    def decide(self, index: int) -> str:\n        if self.isMultipleOf(index, 3):\n            return 'square'\n        elif self.isMultipleOf(index, 4):\n            return 'cube'\n        else:\n            return 'none'\nclass Transformer:\n    \"\"\"Provides primitive arithmetic operations and applies chosen operation.\"\"\"\n    def square(self, v: int) -> int:\n        return v * v\n\n    def cube(self, v: int) -> int:\n        return v * v * v\n\n    def noChange(self, v: int) -> int:\n        return v\n\n    def transform(self, element: 'ListElement', operation_type: str) -> int:\n        if operation_type == 'square':\n            return self.square(element.value)\n        elif operation_type == 'cube':\n            return self.cube(element.value)\n        else: # 'none'\n            return self.noChange(element.value)\nclass ListElement:\n    \"\"\"Encapsulates a single list element with its index, original value, and transformed value.\"\"\"\n    def __init__(self, index: int, value: int):\n        self.index = index\n        self.value = value\n        self.transformedValue: int = value # Initialize with original value\n\n    def applyRule(self, operation_rule: OperationRule, transformer: Transformer) -> None:\n        operation_type = operation_rule.decide(self.index)\n        self.transformedValue = transformer.transform(self, operation_type)\nclass InputList:\n    \"\"\"Represents the incoming list as a domain object and validates its contract.\"\"\"\n    def __init__(self, elements_raw: List[int]):\n        self.elements: List[ListElement] = []\n        for i, val in enumerate(elements_raw):\n            self.elements.append(ListElement(i, val))\n\n    def validate(self) -> bool:\n        # As per problem constraints, this function assumes valid input.\n        return True\nclass Result:\n    \"\"\"Aggregates transformed values and provides the final sum.\"\"\"\n    def compute(self, input_list: InputList) -> int:\n        total_sum = 0\n        for element in input_list.elements:\n            total_sum += element.transformedValue\n        return total_sum\ndef sum_squares(lst: List[int]) -> int:\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    if not lst:\n        return 0\n\n    input_list = InputList(lst)\n    # input_list.validate() # Validation is assumed true as per requirements.\n\n    operation_rule = OperationRule()\n    transformer = Transformer()\n\n    for element in input_list.elements:\n        element.applyRule(operation_rule, transformer)\n\n    result_aggregator = Result()\n    final_sum = result_aggregator.compute(input_list)\n\n    return final_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/140": [{"task_id": "HumanEval/140", "solution": "class SpaceRun:\n    \"\"\"Represents a maximal contiguous run of ASCII spaces.\"\"\"\n    def __init__(self, startIndex: int, length: int):\n        self.startIndex = startIndex\n        self.length = length\nclass FixSpacesFunction:\n    \"\"\"Encapsulates the algorithm for detecting and replacing space runs.\"\"\"\n    def fix_spaces(self, text: str) -> str:\n        if not text:\n            return \"\"\n        \n        runs = self._identify_space_runs(text)\n        return self._apply_replacement_rules(runs, text)\n\n    def _identify_space_runs(self, text: str) -> list[SpaceRun]:\n        runs = []\n        i = 0\n        while i < len(text):\n            if text[i] == ' ':\n                start_index = i\n                while i < len(text) and text[i] == ' ':\n                    i += 1\n                runs.append(SpaceRun(start_index, i - start_index))\n            else:\n                i += 1\n        return runs\n\n    def _apply_replacement_rules(self, runs: list[SpaceRun], text: str) -> str:\n        result_parts = []\n        last_index = 0\n        for run in runs:\n            # Add the text before the current run\n            result_parts.append(text[last_index:run.startIndex])\n\n            # Apply replacement rule\n            if run.length == 1:\n                result_parts.append('_')\n            elif run.length == 2:\n                result_parts.append('__')\n            elif run.length >= 3:\n                result_parts.append('-')\n            \n            last_index = run.startIndex + run.length\n        \n        # Add any remaining text after the last run\n        result_parts.append(text[last_index:])\n        \n        return \"\".join(result_parts)\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \"\"\"\n    return FixSpacesFunction().fix_spaces(text)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/143": [{"task_id": "HumanEval/143", "solution": "from .validator import Validator\nfrom .sentence import Sentence\nfrom .prime_checker import PrimeChecker\nfrom .words_processor import WordsProcessor\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Orchestrates validation, splitting, prime checks, selection, and returns result string.\n    \"\"\"\n    validator = Validator()\n    if not validator.isAllowedLength(sentence):\n        raise ValueError(\"sentence length must be between 1 and 100\")\n    if not validator.isAllowedCharacters(sentence):\n        raise ValueError(\"sentence contains invalid characters; only letters and spaces allowed\")\n\n    sent = Sentence(sentence)\n    word_objs = sent.split()\n\n    checker = PrimeChecker()\n    processor = WordsProcessor()\n\n    selected = processor.selectPrimeLengthWords(word_objs, checker)\n    result_text = processor.composeResult(selected)\n\n    return result_text", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/141": [{"task_id": "HumanEval/141", "solution": "import collections\nclass FileName:\n    \"\"\"\n    Represents parsed file name components and computed counts.\n    \"\"\"\n    def __init__(self, rawName: str) -> None:\n        self.rawName = rawName\n        self.prefix = ''\n        self.extension = ''\n        self.digitCount = 0\n        self.dotCount = 0\n\n    def parse(self) -> None:\n        \"\"\"\n        Splits rawName into prefix and extension and computes dotCount.\n        \"\"\"\n        self.dotCount = self.rawName.count('.')\n        if self.dotCount == 1:\n            parts = self.rawName.rsplit('.', 1)\n            self.prefix = parts[0]\n            self.extension = parts[1]\n        else:\n            # If no dot or multiple dots, for parsing purposes, consider the whole name as prefix.\n            # The Validator will apply specific rules based on dotCount.\n            self.prefix = self.rawName\n            self.extension = ''\n\n    def computeDigitCount(self) -> None:\n        \"\"\"\n        Computes and sets the digitCount for the entire rawName.\n        \"\"\"\n        count = 0\n        for char in self.rawName:\n            if char.isdigit():\n                count += 1\n        self.digitCount = count\nclass Validator:\n    \"\"\"\n    Encapsulates business validation rules and orchestrates checks.\n    \"\"\"\n    allowed_extensions: set[str] = {'txt', 'exe', 'dll'}\n\n    def validate(self, rawName: str) -> bool:\n        \"\"\"\n        Orchestrates parsing and checks, returning True if all rules pass.\n        \"\"\"\n        file_name_obj = FileName(rawName)\n        file_name_obj.parse()\n        file_name_obj.computeDigitCount()\n\n        # Rule 1: There should not be more than three digits.\n        if file_name_obj.digitCount > 3:\n            return False\n\n        # Rule 2: The file's name contains exactly one dot.\n        if file_name_obj.dotCount != 1:\n            return False\n\n        # Rule 3: The substring before the dot should not be empty,\n        # and it starts with a latin alphabet letter.\n        if not self.isPrefixValid(file_name_obj.prefix):\n            return False\n\n        # Rule 4: The substring after the dot should be one of these: ['txt', 'exe', 'dll'].\n        if not self.isExtensionAllowed(file_name_obj.extension):\n            return False\n\n        return True\n\n    def countDigits(self, s: str) -> int:\n        \"\"\"Counts digit characters in a string.\"\"\"\n        return sum(1 for char in s if char.isdigit())\n\n    def hasExactlyOneDot(self, s: str) -> bool:\n        \"\"\"Checks if a string contains exactly one dot.\"\"\"\n        return s.count('.') == 1\n\n    def isPrefixValid(self, prefix: str) -> bool:\n        \"\"\"Checks if the prefix is non-empty and starts with an ASCII letter.\"\"\"\n        return len(prefix) > 0 and prefix[0].isalpha()\n\n    def isExtensionAllowed(self, ext: str) -> bool:\n        \"\"\"Checks if the extension is one of the allowed types.\"\"\"\n        return ext in self.allowed_extensions\nclass ValidationResult:\n    \"\"\"\n    Represents the outcome of a validation operation.\n    \"\"\"\n    def __init__(self, passed: bool, output: str) -> None:\n        self.passed = passed\n        self.output = output\ndef file_name_check(file_name: str) -> str:\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions \n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from \n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    \"\"\"\n    validator = Validator()\n    is_valid = validator.validate(file_name)\n    \n    result_obj = ValidationResult(is_valid, 'Yes' if is_valid else 'No')\n    return result_obj.output", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/144": [{"task_id": "HumanEval/144", "solution": "class ProductFraction:\n    \"\"\"Represents the product of two fractions and determines whole-ness.\"\"\"\n    def __init__(self, numerator: int, denominator: int) -> None:\n        self.numerator = numerator\n        self.denominator = denominator\n\n    def isWhole(self) -> bool:\n        \"\"\"Returns True if the fraction evaluates to a whole number.\"\"\"\n        return self.numerator % self.denominator == 0\nclass Fraction:\n    \"\"\"Represents a fraction with integer numerator and denominator.\"\"\"\n    def __init__(self, numerator: int, denominator: int) -> None:\n        self.numerator = numerator\n        self.denominator = denominator\n\n    @staticmethod\n    def parse(s: str) -> 'Fraction':\n        \"\"\"Parses a string \"<numerator>/<denominator>\" into a Fraction instance.\"\"\"\n        num_str, den_str = s.split(\"/\")\n        return Fraction(int(num_str), int(den_str))\n\n    def multiply(self, other: 'Fraction') -> 'ProductFraction':\n        \"\"\"Multiplies this fraction by another and returns a ProductFraction.\"\"\"\n        product_numerator = self.numerator * other.numerator\n        product_denominator = self.denominator * other.denominator\n        return ProductFraction(product_numerator, product_denominator)\n\n    def isWhole(self) -> bool:\n        \"\"\"Returns True if the fraction evaluates to a whole number.\"\"\"\n        return self.numerator % self.denominator == 0\nclass Simplifier:\n    \"\"\"Orchestrates parsing, multiplication, and whole-number check.\"\"\"\n    @staticmethod\n    def simplify(x: str, n: str) -> bool:\n        \"\"\"Parses two fraction strings, multiplies them, and checks if the product is a whole number.\"\"\"\n        x_frac = Fraction.parse(x)\n        n_frac = Fraction.parse(n)\n        product = x_frac.multiply(n_frac)\n        return product.isWhole()\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n    \"\"\"\n    return Simplifier.simplify(x, n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/146": [{"task_id": "HumanEval/146", "solution": "import math\nfrom typing import List\nclass NumberElement:\n    \"\"\"Encapsulates per-element digit and threshold operations.\"\"\"\n    def __init__(self, value: float):\n        self.value = value\n\n    def getFirstDigit(self) -> int:\n        \"\"\"Computes the leftmost digit of int(abs(value)).\"\"\"\n        n = int(math.fabs(self.value))\n        if n == 0:\n            return 0\n        while n >= 10:\n            n //= 10\n        return n\n\n    def getLastDigit(self) -> int:\n        \"\"\"Computes the rightmost digit of int(abs(value)).\"\"\"\n        n = int(math.fabs(self.value))\n        return n % 10\n\n    def isGreaterThan10(self) -> bool:\n        \"\"\"Checks if the numeric value is strictly greater than 10.\"\"\"\n        return self.value > 10\nclass InputArray:\n    \"\"\"Container for the input list of numeric values.\"\"\"\n    def __init__(self, elements: List[float]):\n        self.elements = elements\nclass FilterLogic:\n    \"\"\"Performs the filtering algorithm.\"\"\"\n    def specialFilter(self, input_array: InputArray) -> int:\n        count = 0\n        odd_digits = {1, 3, 5, 7, 9}\n        for element_value in input_array.elements:\n            num_element = NumberElement(element_value)\n            if not num_element.isGreaterThan10():\n                continue\n\n            first_digit = num_element.getFirstDigit()\n            last_digit = num_element.getLastDigit()\n\n            if first_digit in odd_digits and last_digit in odd_digits:\n                count += 1\n        return count\ndef specialFilter(nums):\n    \"\"\"Write a function that takes an array of numbers as input and returns \n    the number of elements in the array that are greater than 10 and both \n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    For example:\n    specialFilter([15, -73, 14, -15]) => 1 \n    specialFilter([33, -2, -3, 45, 21, 109]) => 2\n    \"\"\"\n    input_array = InputArray(nums)\n    filter_logic = FilterLogic()\n    return filter_logic.specialFilter(input_array)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/145": [{"task_id": "HumanEval/145", "solution": "from typing import List\nclass NumberItem:\n    \"\"\"Represents a number with its original index and computed digit sum.\"\"\"\n    def __init__(self, value: int, index: int):\n        self.value = value\n        self.index = index\n        self.digitSum = 0 # Initialized; will be computed by computeDigitSum.\n\n    def computeDigitSum(self) -> int:\n        \"\"\"Computes the sum of decimal digits of the absolute value of the number.\"\"\"\n        abs_value_str = str(abs(self.value))\n        current_sum = 0\n        for digit_char in abs_value_str:\n            current_sum += int(digit_char)\n        self.digitSum = current_sum\n        return current_sum\nclass Sorter:\n    \"\"\"Sorts NumberItem records based on digit sum and original index.\"\"\"\n    def order_by_points(self, items: List[NumberItem]) -> List[int]:\n        \"\"\"\n        Sorts NumberItem objects by (digit sum ascending, original index descending)\n        and returns a list of their original values.\n        \"\"\"\n        # Sorts using a key that prioritizes digit sum (ascending) then original index (descending).\n        sorted_items = sorted(items, key=lambda item: (item.digitSum, -item.index))\n        \n        # Extracts and returns the original values from the sorted NumberItem objects.\n        return [item.value for item in sorted_items]\ndef order_by_points(nums: List[int]) -> List[int]:\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    If several items have a similar sum of digits, they are ordered based on their\n    index in the original list in descending order.\n    \"\"\"\n    if not nums:\n        return []\n\n    items_for_sorting: List[NumberItem] = []\n    for index, value in enumerate(nums):\n        item = NumberItem(value=value, index=index)\n        item.computeDigitSum()\n        items_for_sorting.append(item)\n\n    sorter = Sorter()\n    sorted_values = sorter.order_by_points(items_for_sorting)\n    \n    return sorted_values", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 11, -1, -11, -12]]], "plus_fail_tests": [[[-5, -12, 9, 15]]]}], "HumanEval/150": [{"task_id": "HumanEval/150", "solution": "import math\nclass InputParameters:\n    \"\"\"Holds input parameters for a single invocation of x_or_y.\"\"\"\n    def __init__(self, n, x, y):\n        self.n = n\n        self.x = x\n        self.y = y\nclass PrimeChecker:\n    \"\"\"Encapsulates primality checking logic that implements BR3.\"\"\"\n    def isPrime(self, n):\n        \"\"\"Determines if n is a prime number according to BR3.\"\"\"\n        # BR3: n is an integer greater than 1.\n        if not isinstance(n, int) or n <= 1:\n            return False\n        \n        # Check for small prime numbers\n        if n <= 3:\n            return True\n        \n        # Check for divisibility by 2 or 3\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        \n        # Trial division for numbers greater than 3, checking up to sqrt(n)\n        # Optimized to check numbers of the form 6k +/- 1\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n            \n        return True\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n    \n    \"\"\"\n    params = InputParameters(n, x, y)\n    checker = PrimeChecker()\n    \n    if checker.isPrime(params.n):\n        return params.x\n    else:\n        return params.y", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/147": [{"task_id": "HumanEval/147", "solution": "class TripleCounter:\n    \"\"\"Computes valid triple count using combinatorics.\"\"\"\n\n    def combination(self, n: int, k: int) -> int:\n        \"\"\"Calculates C(n, k). Returns 0 if n < k or k < 0.\"\"\"\n        if k < 0 or k > n:\n            return 0\n        if k == 0 or k == n:\n            return 1\n        if k > n // 2: \n            k = n - k\n        \n        res = 1\n        for i in range(k):\n            res = res * (n - i) // (i + 1)\n        return res\n\n    def count_triples(self, c0: int, c1: int) -> int:\n        \"\"\"Counts triples based on counts of elements with residue 0 or 1 mod 3.\"\"\"\n        return self.combination(c0, 3) + self.combination(c1, 3)\ndef get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k, \n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    # As per \"DO NOT add isinstance() checks or raise exceptions for edge cases\",\n    # and \"You are given a positive integer n\", input n is assumed to be a valid positive integer.\n\n    # If n is less than 3, it's impossible to form a triple.\n    if n < 3:\n        return 0\n\n    # BR4: c0 = floor((n + 1) / 3); c1 = n - c0.\n    # a[i] % 3 is 0 if i % 3 == 2, and 1 otherwise (i % 3 == 0 or i % 3 == 1).\n    # c0 represents the count of numbers in `a` that are 0 mod 3.\n    # c1 represents the count of numbers in `a` that are 1 mod 3.\n    c0 = (n + 1) // 3  # Count of `i` values (1 to n) where i % 3 == 2, which results in a[i] % 3 == 0.\n    c1 = n - c0       # Count of `i` values (1 to n) where i % 3 == 0 or i % 3 == 1, which results in a[i] % 3 == 1.\n\n    # BR5: Valid sums are (0,0,0) and (1,1,1); total valid triples = C(c0,3) + C(c1,3).\n    triple_counter = TripleCounter()\n    total_count = triple_counter.count_triples(c0, c1)\n\n    return total_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/148": [{"task_id": "HumanEval/148", "solution": "class Planet:\n    \"\"\"Represents a planet with its name and orbital position.\"\"\"\n    def __init__(self, name: str, position: int) -> None:\n        self.name = name\n        self.position = position\nclass PlanetRepository:\n    \"\"\"Manages the canonical list of planets and provides lookup functionality.\"\"\"\n    def __init__(self) -> None:\n        self._planets = [\n            Planet(\"Mercury\", 1),\n            Planet(\"Venus\", 2),\n            Planet(\"Earth\", 3),\n            Planet(\"Mars\", 4),\n            Planet(\"Jupiter\", 5),\n            Planet(\"Saturn\", 6),\n            Planet(\"Uranus\", 7),\n            Planet(\"Neptune\", 8),\n        ]\n        self._name_to_position = {planet.name: planet.position for planet in self._planets}\n\n    def is_valid(self, name: str) -> bool:\n        return name in self._name_to_position\n\n    def get_position(self, name: str) -> int:\n        return self._name_to_position.get(name)\n\n    def get_planets_between(self, low_pos: int, high_pos: int) -> list:\n        result = []\n        for planet in self._planets:\n            if low_pos < planet.position < high_pos:\n                result.append(planet)\n        return result\nclass OrbitRangeService:\n    \"\"\"Provides business logic for finding planets between two orbits.\"\"\"\n    def __init__(self, repo: PlanetRepository) -> None:\n        self._repo = repo\n\n    def planets_between(self, name1: str, name2: str) -> tuple:\n        if not (self._repo.is_valid(name1) and self._repo.is_valid(name2)):\n            return ()\n\n        pos1 = self._repo.get_position(name1)\n        pos2 = self._repo.get_position(name2)\n\n        low = min(pos1, pos2)\n        high = max(pos1, pos2)\n\n        if high - low <= 1:\n            return ()\n\n        between_planets_objects = self._repo.get_planets_between(low, high)\n        return tuple(planet.name for planet in between_planets_objects)\nclass BFFunction:\n    \"\"\"API adapter for the bf function, delegating to OrbitRangeService.\"\"\"\n    def __init__(self, service: OrbitRangeService) -> None:\n        self._service = service\n\n    def bf(self, planet1: str, planet2: str) -> tuple:\n        return self._service.planets_between(planet1, planet2)\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    planet_repo = PlanetRepository()\n    orbit_service = OrbitRangeService(planet_repo)\n    bf_adapter = BFFunction(orbit_service)\n    \n    return bf_adapter.bf(planet1, planet2)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/149": [{"task_id": "HumanEval/149", "solution": "class StringItem:\n    \"\"\"Represents one input string with derived metadata for sorting and filtering.\"\"\"\n    def __init__(self, value: str, occurrence: int) -> None:\n        self.value = value\n        self.length = len(value)\n        self.occurrence = occurrence\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the string's length is even.\"\"\"\n        return self.length % 2 == 0\n\n    def __lt__(self, other: \"StringItem\") -> bool:\n        \"\"\"Defines less-than comparison for sorting: by length, then alphabetically by value.\"\"\"\n        if self.length != other.length:\n            return self.length < other.length\n        return self.value < other.value\nclass StringList:\n    \"\"\"Holds and operates on a list of StringItem instances.\"\"\"\n    def __init__(self, items: list[StringItem]) -> None:\n        self.items = items\n\n    def filter_even(self) -> list[StringItem]:\n        \"\"\"Returns a new list containing only StringItems with even lengths.\"\"\"\n        return [item for item in self.items if item.isEven()]\n\n    def sort_by_length_then_alpha(self, items_to_sort: list[StringItem]) -> list[StringItem]:\n        \"\"\"Sorts a list of StringItems by length ascending, then alphabetically by value.\"\"\"\n        return sorted(items_to_sort)\nclass SortedListSum:\n    \"\"\"Orchestrates the processing of string lists: filter, sort, and extract values.\"\"\"\n    def sorted_list_sum(self, lst: list) -> list:\n        # Map input strings to StringItem instances, preserving original order with 'occurrence'.\n        items = [StringItem(value=s, occurrence=i) for i, s in enumerate(lst)]\n        \n        # Encapsulate items in StringList for filtering and sorting operations.\n        sl = StringList(items)\n        \n        # Filter out strings with odd lengths.\n        filtered_items = sl.filter_even()\n        \n        # Sort the remaining strings based on length then alphabetically.\n        sorted_items = sl.sort_by_length_then_alpha(filtered_items)\n        \n        # Extract and return the string values from the sorted StringItems.\n        return [item.value for item in sorted_items]\ndef sorted_list_sum(lst):\n    \"\"\"Write a function that accepts a list of strings as a parameter,\n    deletes the strings that have odd lengths from it,\n    and returns the resulted list with a sorted order,\n    The list is always a list of strings and never an array of numbers,\n    and it may contain duplicates.\n    The order of the list should be ascending by length of each word, and you\n    should return the list sorted by that rule.\n    If two words have the same length, sort the list alphabetically.\n    The function should return a list of strings in sorted order.\n    You may assume that all words will have the same length.\n    For example:\n    assert list_sort([\"aa\", \"a\", \"aaa\"]) => [\"aa\"]\n    assert list_sort([\"ab\", \"a\", \"aaa\", \"cd\"]) => [\"ab\", \"cd\"]\n    \"\"\"\n    # Delegate the processing to the orchestrator class.\n    return SortedListSum().sorted_list_sum(lst)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/151": [{"task_id": "HumanEval/151", "solution": "class NumberElement:\n    \"\"\"Encapsulates a numeric value and provides predicates for filtering.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def is_integer(self):\n        \"\"\"Returns True if the value is a native Python integer.\"\"\"\n        return type(self.value) is int\n\n    def is_negative(self):\n        \"\"\"Returns True if the value is negative.\"\"\"\n        return self.value < 0\n\n    def is_odd(self):\n        \"\"\"Returns True if the value is odd.\"\"\"\n        return self.value % 2 != 0\nclass InputList:\n    \"\"\"Container for NumberElement instances created from a raw list.\"\"\"\n    def __init__(self, raw_list):\n        self.elements = [NumberElement(v) for v in raw_list]\nclass DoubleTheDifference:\n    \"\"\"Executor implementing the processing pipeline for double_the_difference.\"\"\"\n    def __init__(self, lst):\n        self.lst = lst\n\n    def execute(self):\n        \"\"\"Implements the filtering, squaring, and summing logic.\"\"\"\n        if not self.lst:\n            return 0\n\n        input_list_obj = InputList(self.lst)\n        sum_of_squares = 0\n\n        for element in input_list_obj.elements:\n            if element.is_negative():\n                continue\n            \n            if not element.is_integer():\n                continue\n            \n            if element.is_odd():\n                sum_of_squares += element.value ** 2\n        \n        return sum_of_squares\ndef double_the_difference(lst):\n    \"\"\"\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \"\"\"\n    executor = DoubleTheDifference(lst)\n    return executor.execute()", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[true, true, false, false, true, false, false, false, false, false]]]}], "HumanEval/152": [{"task_id": "HumanEval/152", "solution": "from typing import Sequence, List, Union\nfrom .models import MatchSet, DifferenceResult\nfrom .validator import Validator\nfrom .processor import Processor\nfrom .errors import ValidationError\ndef compare(game: Sequence[Union[int, float]], guess: Sequence[Union[int, float]]) -> List[float]:\n    \"\"\"Determines how far off each guess was compared to the actual game score.\"\"\"\n    validator = Validator()\n    processor = Processor()\n\n    # Orchestration Step 2: Validate arrays (type and length).\n    # Interpreting validateArrays to check the raw input sequences for array-likeness and equal length.\n    # The parameter names matchSetA and matchSetB are assumed to refer to the input sequences here.\n    validator.validateArrays(game, guess)\n\n    # Orchestration Step 1: Construct MatchSet from the two input sequences.\n    # This happens after initial structural validation to ensure equal lengths.\n    match_set = MatchSet(game, guess)\n\n    # Orchestration Step 3: Validate that all elements in the MatchSet are numeric.\n    validator.validateElementsAreNumeric(match_set)\n\n    # Orchestration Step 4: Compute differences using the Processor.\n    difference_result = processor.computeDifferences(match_set)\n\n    # Orchestration Step 5: Return the differences as a plain list.\n    return difference_result.as_list()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/153": [{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"You will be given the name of a class (a string) and a list of extensions.\n    The extensions are to be used to load additional classes to the class. The\n    strength of the extension is as follows: Let CAP be the number of the uppercase\n    letters in the extension's name, and let SM be the number of lowercase letters \n    in the extension's name, the strength is given by the fraction CAP - SM. \n    You should find the strongest extension and return a string in this \n    format: ClassName.StrongestExtensionName.\n    If there are two or more extensions with the same strength, you should\n    choose the one that comes first in the list.\n    For example, if you are given \"Slices\" as the class and a list of the\n    extensions: ['SErviNGSliCes', 'Cheese', 'StuFfed'] then you should\n    return 'Slices.SErviNGSliCes' since 'SErviNGSliCes' is the strongest extension \n    (its strength is -1).\n    Example:\n    for Strongest_Extension('my_class', ['AA', 'Be', 'CC']) == 'my_class.AA'\n    \"\"\"\n\n    # Inlined domain.Extension class from design context\n    class Extension:\n        def __init__(self, name: str, CAP: int = 0, SM: int = 0, strength: int = 0):\n            self.name = name\n            self.CAP = CAP\n            self.SM = SM\n            self.strength = strength\n\n    # Inlined strength_calculator.StrengthCalculator class from design context\n    class StrengthCalculator:\n        def computeCAP(self, name: str) -> int:\n            \"\"\"Counts uppercase alphabetic characters in the given name.\"\"\"\n            return sum(1 for char in name if char.isalpha() and char.isupper())\n\n        def computeSM(self, name: str) -> int:\n            \"\"\"Counts lowercase alphabetic characters in the given name.\"\"\"\n            return sum(1 for char in name if char.isalpha() and char.islower())\n\n        def computeStrength(self, name: str) -> int:\n            \"\"\"Computes strength as CAP - SM for the given name.\"\"\"\n            cap = self.computeCAP(name)\n            sm = self.computeSM(name)\n            return cap - sm\n\n        def selectStrongest(self, extensions_list: list[Extension]) -> Extension:\n            \"\"\"Selects the strongest Extension from a list, using first occurrence for ties.\"\"\"\n            # Per design notes, assume input 'extensions' is non-empty, thus extensions_list will be non-empty.\n            strongest_ext = extensions_list[0]\n            max_strength = strongest_ext.strength\n\n            # Iterate from the second element to respect \"first occurrence\" tie-breaker\n            for i in range(1, len(extensions_list)):\n                current_ext = extensions_list[i]\n                if current_ext.strength > max_strength:\n                    max_strength = current_ext.strength\n                    strongest_ext = current_ext\n            return strongest_ext\n\n    # Inlined domain.ClassName class from design context\n    class ClassName:\n        def __init__(self, name: str):\n            self.name = name\n\n        def getStrongestExtension(self, strongest_extension: Extension) -> str:\n            \"\"\"Formats the class name with the strongest extension's name.\"\"\"\n            return f\"{self.name}.{strongest_extension.name}\"\n\n    # Main logic of Strongest_Extension function as per design orchestration\n    strength_calculator = StrengthCalculator()\n    \n    # Convert input extension names to Extension objects with calculated metrics\n    extension_objects = []\n    for ext_name in extensions:\n        cap = strength_calculator.computeCAP(ext_name)\n        sm = strength_calculator.computeSM(ext_name)\n        strength = cap - sm\n        extension_objects.append(Extension(ext_name, cap, sm, strength))\n\n    # Select the strongest extension from the created objects\n    strongest_extension_obj = strength_calculator.selectStrongest(extension_objects)\n\n    # Instantiate ClassName and use its method to format the final result string\n    class_name_obj = ClassName(class_name)\n    return class_name_obj.getStrongestExtension(strongest_extension_obj)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/154": [{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    if not b:\n        # As per design, RotationGenerator returns [] for empty b.\n        # However, \"\" is a substring of any string including an empty string.\n        # This explicit check handles the edge case of b being an empty string,\n        # where the \"empty string rotation\" should be considered.\n        return \"\" in a\n\n    rotations = []\n    for i in range(len(b)):\n        rotated_b = b[i:] + b[:i]\n        rotations.append(rotated_b)\n\n    for r in rotations:\n        if r in a:\n            return True\n            \n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/157": [{"task_id": "HumanEval/157", "solution": "TOLERANCE = 1e-9\nclass ValidationResult:\n    \"\"\"DTO encapsulating validation outcome.\"\"\"\n    def __init__(self, valid: bool, reason: str = \"\"):\n        self.valid = valid\n        self.reason = reason\nclass Triangle:\n    \"\"\"Represents a triangle with three side lengths.\"\"\"\n    def __init__(self, a: float, b: float, c: float):\n        self.a = float(a)\n        self.b = float(b)\n        self.c = float(c)\n\n    def isValid(self) -> bool:\n        \"\"\"Wrapper indicating whether validate() yields valid == True.\"\"\"\n        return self.validate().valid\n\n    def validate(self) -> ValidationResult:\n        \"\"\"Checks positivity and triangle inequality.\"\"\"\n        # Check if sides are positive\n        if self.a <= 0 or self.b <= 0 or self.c <= 0:\n            return ValidationResult(False, \"non-positive side\")\n\n        # Check triangle inequality: sum of any two sides must be greater than the third\n        if not (self.a + self.b > self.c and\n                self.a + self.c > self.b and\n                self.b + self.c > self.a):\n            return ValidationResult(False, \"triangle inequality failed\")\n        \n        return ValidationResult(True)\n\n    def longest(self) -> float:\n        \"\"\"Returns the longest side length.\"\"\"\n        return max(self.a, self.b, self.c)\n\n    def isRightAngle(self, tolerance: float) -> bool:\n        \"\"\"Determines if the triangle is right-angled using Pythagorean theorem within a tolerance.\"\"\"\n        sides = sorted([self.a, self.b, self.c])\n        s1, s2, hypotenuse = sides[0], sides[1], sides[2]\n\n        # Check Pythagorean theorem (s1^2 + s2^2 = hypotenuse^2) with absolute tolerance\n        return abs(hypotenuse**2 - (s1**2 + s2**2)) < tolerance\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # 1. Type check: ensure inputs are numeric (int or float).\n    if not all(isinstance(x, (int, float)) for x in [a, b, c]):\n        return False\n\n    # 2. Positivity check: ensure all sides are greater than 0.\n    if a <= 0 or b <= 0 or c <= 0:\n        return False\n\n    # 3. Instantiate Triangle and validate for non-degeneracy.\n    triangle = Triangle(a, b, c)\n    validation_result = triangle.validate()\n    if not validation_result.valid:\n        return False\n\n    # 4. Check if it's a right-angled triangle using the defined tolerance.\n    return triangle.isRightAngle(TOLERANCE)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/155": [{"task_id": "HumanEval/155", "solution": "from typing import List\nclass IntegerInput:\n    \"\"\"Wraps the raw input integer and provides absolute value extraction.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def get_absolute_value(self) -> int:\n        \"\"\"Returns the absolute value of the integer.\"\"\"\n        return abs(self.value)\nclass Digit:\n    \"\"\"Represents a single decimal digit with position and parity inquiry.\"\"\"\n    def __init__(self, position: int, value: int) -> None:\n        self.position = position\n        self.value = value\n\n    def is_even(self) -> bool:\n        \"\"\"Returns True if the digit is even (0, 2, 4, 6, 8).\"\"\"\n        return self.value % 2 == 0\nclass DigitCollection:\n    \"\"\"Holds an ordered list of Digit instances and provides a factory constructor from an integer.\"\"\"\n    def __init__(self, digits: List[Digit]) -> None:\n        self.digits = digits\n\n    @staticmethod\n    def from_integer(value: int) -> 'DigitCollection':\n        \"\"\"Decomposes an integer into a collection of Digit instances.\"\"\"\n        if value == 0:\n            return DigitCollection([Digit(0, 0)])\n\n        digits_list: List[Digit] = []\n        s_value = str(value)\n        for i, char_digit in enumerate(s_value):\n            digits_list.append(Digit(i, int(char_digit)))\n        return DigitCollection(digits_list)\n\n    def __len__(self) -> int:\n        return len(self.digits)\n\n    def __iter__(self):\n        return iter(self.digits)\nclass DigitCounter:\n    \"\"\"Stateless counting behavior to count even and odd digits in a DigitCollection.\"\"\"\n    def count_even(self, dc: 'DigitCollection') -> int:\n        \"\"\"Counts even digits in the collection.\"\"\"\n        even_count = 0\n        for digit in dc:\n            if digit.is_even():\n                even_count += 1\n        return even_count\n\n    def count_odd(self, dc: 'DigitCollection') -> int:\n        \"\"\"Counts odd digits in the collection.\"\"\"\n        odd_count = 0\n        for digit in dc:\n            if not digit.is_even():\n                odd_count += 1\n        return odd_count\nclass ResultTuple:\n    \"\"\"Simple data holder for even_count and odd_count; convertible to a tuple.\"\"\"\n    def __init__(self, even_count: int, odd_count: int) -> None:\n        self.even_count = even_count\n        self.odd_count = odd_count\n\n    def as_tuple(self) -> tuple[int, int]:\n        \"\"\"Returns the counts as a tuple (even_count, odd_count).\"\"\"\n        return (self.even_count, self.odd_count)\ndef even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    integer_input = IntegerInput(num)\n    abs_value = integer_input.get_absolute_value()\n    digit_collection = DigitCollection.from_integer(abs_value)\n    digit_counter = DigitCounter()\n    even_count = digit_counter.count_even(digit_collection)\n    odd_count = digit_counter.count_odd(digit_collection)\n    result = ResultTuple(even_count, odd_count)\n    return result.as_tuple()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/158": [{"task_id": "HumanEval/158", "solution": "from typing import List\nclass UniqueCharacterCounter:\n    \"\"\"Computes the number of unique characters in a string.\"\"\"\n    @staticmethod\n    def count(s: str) -> int:\n        \"\"\"Returns the number of unique characters in the input string.\"\"\"\n        return len(set(s))\nclass Word:\n    \"\"\"Represents a single word and its computed unique character count.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self.uniqueCount = UniqueCharacterCounter.count(value)\nclass Comparator:\n    \"\"\"Provides ordering semantics to choose between Word objects for tie-breaking.\"\"\"\n    @staticmethod\n    def compareByUniqueThenLex(a: 'Word', b: 'Word') -> int:\n        \"\"\"\n        Compares two Word objects. Returns -1 if 'a' is preferred, 1 if 'b' is preferred, 0 if equal.\n        Preference order: higher uniqueCount, then lexicographically smaller value.\n        \"\"\"\n        if a.uniqueCount > b.uniqueCount:\n            return -1\n        elif a.uniqueCount < b.uniqueCount:\n            return 1\n        else: # uniqueCount is equal, break tie with lexicographical order\n            if a.value < b.value:\n                return -1\n            elif a.value > b.value:\n                return 1\n            else:\n                return 0\nclass Result:\n    \"\"\"Container for the selected output string.\"\"\"\n    def __init__(self, selectedWord: str):\n        self.selectedWord = selectedWord\nclass FindMaxFunction:\n    \"\"\"Orchestrates the selection of the word with maximum unique characters.\"\"\"\n    def find_max(self, words: List[str]) -> str:\n        \"\"\"\n        Finds the word with the maximum number of unique characters from a list,\n        breaking ties by lexicographical order.\n        \"\"\"\n        best_word_obj: Word = None\n\n        for word_str in words:\n            current_word_obj = Word(word_str)\n            if best_word_obj is None:\n                best_word_obj = current_word_obj\n            else:\n                comparison_result = Comparator.compareByUniqueThenLex(current_word_obj, best_word_obj)\n                if comparison_result == -1: # current_word_obj is preferred\n                    best_word_obj = current_word_obj\n        \n        return Result(best_word_obj.value).selectedWord\ndef find_max(words: List[str]) -> str:\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n    orchestrator = FindMaxFunction()\n    return orchestrator.find_max(words)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/156": [{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    # Define the Roman numeral mapping including subtractive pairs, ordered from largest to smallest value.\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'),\n        (1, 'I')\n    ]\n\n    result = []\n    current_num = number\n\n    for value, numeral in roman_map:\n        while current_num >= value:\n            result.append(numeral)\n            current_num -= value\n\n    return \"\".join(result).lower()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/161": [{"task_id": "HumanEval/161", "solution": "class InputString:\n    \"\"\"Represents the raw input string and its basic metadata.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n        self.length = len(raw)\n\n    def __len__(self):\n        return self.length\n\n    def char_at(self, pos: int) -> str:\n        return self.raw[pos]\nclass CharacterProcessor:\n    \"\"\"Stateless helper implementing character-level business rules.\"\"\"\n    def isLetter(self, ch: str) -> bool:\n        \"\"\"Checks if a character is an ASCII letter (A-Z, a-z).\"\"\"\n        return 'a' <= ch <= 'z' or 'A' <= ch <= 'Z'\n\n    def flipCase(self, ch: str) -> str:\n        \"\"\"Flips the case of a letter; otherwise returns the character unchanged.\"\"\"\n        if self.isLetter(ch):\n            return ch.swapcase()\n        return ch\nclass OutputString:\n    \"\"\"Accumulates output characters and produces the final string.\"\"\"\n    def __init__(self):\n        self._parts = []\n\n    def append(self, ch: str):\n        self._parts.append(ch)\n\n    def finalize(self) -> str:\n        return \"\".join(self._parts)\ndef solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n    input_obj = InputString(s)\n    proc = CharacterProcessor()\n\n    any_letters = False\n    for ch in input_obj.raw:\n        if proc.isLetter(ch):\n            any_letters = True\n            break\n    \n    if not any_letters:\n        return input_obj.raw[::-1]\n\n    out = OutputString()\n    for ch in input_obj.raw:\n        out.append(proc.flipCase(ch))\n    \n    return out.finalize()", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["\u00e4\u00eb\u00ef\u00f6\u00fc"]]}], "HumanEval/159": [{"task_id": "HumanEval/159", "solution": "class ConsumptionResult:\n    def __init__(self, totalEaten: int, remainingAfter: int) -> None:\n        self.totalEaten = totalEaten\n        self.remainingAfter = remainingAfter\nclass Inventory:\n    def __init__(self, remaining: int) -> None:\n        self._remaining = remaining\n\n    @property\n    def remaining(self) -> int:\n        return self._remaining\n\n    def decrease(self, amount: int) -> None:\n        self._remaining -= amount\nclass Rabbit:\n    def __init__(self, number: int, need: int) -> None:\n        self._numberEaten = number\n        self._need = need\n\n    def consume(self, inventory: Inventory) -> ConsumptionResult:\n        consumed = min(self._need, inventory.remaining)\n        inventory.decrease(consumed)\n        \n        total_eaten_after_meal = self._numberEaten + consumed\n        remaining_after_meal = inventory.remaining\n        \n        return ConsumptionResult(total_eaten_after_meal, remaining_after_meal)\ndef validate_inputs(number: int, need: int, remaining: int) -> bool:\n    \"\"\"\n    Validates if inputs are integers within the allowed range [0, 1000].\n    \"\"\"\n    if not all(isinstance(arg, int) for arg in [number, need, remaining]):\n        return False\n    if not (0 <= number <= 1000 and 0 <= need <= 1000 and 0 <= remaining <= 1000):\n        return False\n    return True\ndef eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n    \"\"\"\n    if not validate_inputs(number, need, remaining):\n        raise ValueError('invalid input')\n    \n    rabbit = Rabbit(number, need)\n    inventory = Inventory(remaining)\n    result = rabbit.consume(inventory)\n    \n    return [result.totalEaten, result.remainingAfter]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/160": [{"task_id": "HumanEval/160", "solution": "ALLOWED_OPERATORS = ('+', '-', '*', '//', '**')\nclass OperatorList:\n    \"\"\"Encapsulates and validates a list of algebraic operators.\"\"\"\n    def __init__(self, operators: list):\n        self.operators = operators\n\n    def validate(self) -> None:\n        if not isinstance(self.operators, list):\n            raise ValueError(\"Operator list must be a list.\")\n        for op in self.operators:\n            if not isinstance(op, str) or op not in ALLOWED_OPERATORS:\n                raise ValueError(f\"Invalid operator '{op}'. Allowed operators are {ALLOWED_OPERATORS}.\")\nclass OperandList:\n    \"\"\"Encapsulates and validates a list of non-negative integer operands.\"\"\"\n    def __init__(self, operands: list):\n        self.operands = operands\n\n    def validate(self) -> None:\n        if not isinstance(self.operands, list):\n            raise ValueError(\"Operand list must be a list.\")\n        for i, op in enumerate(self.operands):\n            if not isinstance(op, int):\n                raise ValueError(f\"Operand at index {i} ('{op}') must be an integer.\")\n            if op < 0:\n                raise ValueError(f\"Operand at index {i} ('{op}') must be non-negative.\")\nclass Expression:\n    \"\"\"Constructs an expression's token list and infix string from operands and operators.\"\"\"\n    def __init__(self):\n        self.infix: str = ''\n        self.tokens: list = []\n\n    def construct(self, operand_list: OperandList, operator_list: OperatorList) -> None:\n        assembled_tokens = []\n        for i in range(len(operator_list.operators)):\n            assembled_tokens.append(str(operand_list.operands[i]))\n            assembled_tokens.append(operator_list.operators[i])\n        assembled_tokens.append(str(operand_list.operands[-1]))\n\n        self.tokens = assembled_tokens\n        self.infix = ' '.join(assembled_tokens)\nclass Evaluator:\n    \"\"\"Evaluates an algebraic expression using precedence and associativity rules.\"\"\"\n    _PRECEDENCE = {'+': 1, '-': 1, '*': 2, '//': 2, '**': 3}\n    _ASSOCIATIVITY = {'+': 'left', '-': 'left', '*': 'left', '//': 'left', '**': 'right'}\n\n    def evaluate(self, expression: Expression) -> 'number':\n        # Shunting-yard algorithm to convert infix to RPN\n        output_queue = []\n        operator_stack = []\n\n        for token in expression.tokens:\n            if token.isdigit(): # Operands are non-negative integers as per validation\n                output_queue.append(int(token))\n            elif token in self._PRECEDENCE:\n                o1 = token\n                while (operator_stack and operator_stack[-1] in self._PRECEDENCE and\n                       (self._PRECEDENCE[operator_stack[-1]] > self._PRECEDENCE[o1] or\n                        (self._PRECEDENCE[operator_stack[-1]] == self._PRECEDENCE[o1] and\n                         self._ASSOCIATIVITY[o1] == 'left'))):\n                    output_queue.append(operator_stack.pop())\n                operator_stack.append(o1)\n\n        while operator_stack:\n            output_queue.append(operator_stack.pop())\n\n        # Evaluate RPN\n        operand_stack = []\n        for token in output_queue:\n            if isinstance(token, int):\n                operand_stack.append(token)\n            else: # It's an operator string\n                operand2 = operand_stack.pop()\n                operand1 = operand_stack.pop()\n                result = None\n                if token == '+':\n                    result = operand1 + operand2\n                elif token == '-':\n                    result = operand1 - operand2\n                elif token == '*':\n                    result = operand1 * operand2\n                elif token == '//':\n                    result = operand1 // operand2\n                elif token == '**':\n                    result = operand1 ** operand2\n                operand_stack.append(result)\n\n        return operand_stack[0]\ndef do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n    \"\"\"\n    operator_list_obj = OperatorList(operator)\n    operand_list_obj = OperandList(operand)\n\n    # Validate operand list content and minimum length\n    operand_list_obj.validate() \n    if len(operand_list_obj.operands) < 2:\n        raise ValueError(\"Operand list must contain at least two operands.\")\n\n    # Validate operator list content and minimum length\n    operator_list_obj.validate()\n    if not operator_list_obj.operators:\n        raise ValueError(\"Operator list has at least one operator.\")\n\n    # Validate the relationship between list lengths\n    if len(operator_list_obj.operators) != len(operand_list_obj.operands) - 1:\n        raise ValueError(\"The length of the operator list must be equal to the length of the operand list minus one.\")\n    \n    # Construct the expression\n    expr = Expression()\n    expr.construct(operand_list_obj, operator_list_obj)\n\n    # Evaluate the expression\n    evaluator = Evaluator()\n    result = evaluator.evaluate(expr)\n\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/162": [{"task_id": "HumanEval/162", "solution": "import hashlib\nfrom typing import Optional\nclass MD5Service:\n    def string_to_md5(self, text: str) -> Optional[str]:\n        \"\"\"Return None for empty string, otherwise 32-char lowercase MD5 hex.\"\"\"\n        if not self.validate_input(text):\n            return None\n        return self.compute_md5(text)\n\n    def validate_input(self, text: str) -> bool:\n        \"\"\"Return True if text is non-empty (len(text) > 0).\"\"\"\n        return len(text) > 0\n\n    def compute_md5(self, text: str) -> str:\n        \"\"\"Encode text using UTF-8 and return hashlib.md5(bytes).hexdigest().\"\"\"\n        return hashlib.md5(text.encode('utf-8')).hexdigest()\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n\n    >>> string_to_md5('Hello world') == '3e25960a79dbc69b674cd4ec67a72c62'\n    \"\"\"\n    service = MD5Service()\n    return service.string_to_md5(text)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/163": [{"task_id": "HumanEval/163", "solution": "class IntegerInput:\n    \"\"\"Represents the two input integers a and b, providing validation and range conversion.\"\"\"\n    def __init__(self, a, b):\n        self.a = a\n        self.b = b\n\n    def validate(self):\n        \"\"\"Validates inputs. Assumes inputs are positive integers per problem statement.\"\"\"\n        return True\n\n    def toRange(self):\n        \"\"\"Converts the input integers into an inclusive Range object.\"\"\"\n        return Range(min(self.a, self.b), max(self.a, self.b))\nclass Range:\n    \"\"\"Represents an inclusive integer range [low, high] and checks for membership.\"\"\"\n    def __init__(self, low, high):\n        self.low = low\n        self.high = high\n\n    def contains(self, n):\n        \"\"\"Checks if a given integer n falls within the inclusive range.\"\"\"\n        return self.low <= n <= self.high\nclass EvenDigitSet:\n    \"\"\"Provides a fixed set of even single digits and filters them by a given range.\"\"\"\n    def __init__(self):\n        self.digits = [2, 4, 6, 8]\n\n    def filter(self, range_obj):\n        \"\"\"Returns a list of digits from the set that are contained within the range.\"\"\"\n        return [d for d in self.digits if range_obj.contains(d)]\nclass ResultList:\n    \"\"\"Holds a list of integers and provides functionality to sort them in ascending order.\"\"\"\n    def __init__(self, items):\n        self.items = items\n\n    def sortAscending(self):\n        \"\"\"Returns a new list with the items sorted in ascending order.\"\"\"\n        return sorted(self.items)\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    integer_input = IntegerInput(a, b)\n    integer_input.validate() # As per constraints, this effectively passes.\n\n    data_range = integer_input.toRange()\n\n    even_digit_set = EvenDigitSet()\n    matched_digits = even_digit_set.filter(data_range)\n\n    result_list = ResultList(matched_digits)\n    sorted_result = result_list.sortAscending()\n\n    return sorted_result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/83": [{"task_id": "HumanEval/83", "solution": "class Parameter:\n    def __init__(self, n: int):\n        self.n = n\n\n    def as_int(self) -> int:\n        return self.n\nclass Validator:\n    def validate(self, n) -> bool:\n        # Validates if n is an integer and a positive integer (n >= 1).\n        return isinstance(n, int) and n >= 1\nclass Calculator:\n    def compute_count(self, n: int) -> int:\n        if n == 1:\n            return 1\n        # For n >= 2, the count is 18 * 10^(n-2).\n        return 18 * (10 ** (n - 2))\nclass Result:\n    def __init__(self, count: int):\n        self.count = count\n\n    def as_int(self) -> int:\n        return self.count\nclass Error:\n    def __init__(self, message: str):\n        self.message = message\n\n    def as_str(self) -> str:\n        return self.message\ndef starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    p = Parameter(n)\n    v = Validator()\n    if not v.validate(p.as_int()):\n        err = Error(\"n must be a positive integer (n >= 1)\")\n        raise ValueError(err.as_str())\n    c = Calculator()\n    count = c.compute_count(p.as_int())\n    r = Result(count)\n    return r.as_int()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/15": [{"task_id": "HumanEval/15", "solution": "def _validate_n(n: int) -> bool:\n    \"\"\"Validates if n is a non-negative integer, raising ValueError if not.\"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n    return True\ndef _generate_tokens(n: int) -> list[str]:\n    \"\"\"Generates a list of string tokens from 0 to n inclusive.\"\"\"\n    return [str(i) for i in range(n + 1)]\ndef _join_tokens(tokens: list[str]) -> str:\n    \"\"\"Joins a list of string tokens with a single space.\"\"\"\n    return \" \".join(tokens)\ndef string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    >>> string_sequence(0)\n    '0'\n    >>> string_sequence(5)\n    '0 1 2 3 4 5'\n    \"\"\"\n    _validate_n(n)\n    tokens = _generate_tokens(n)\n    return _join_tokens(tokens)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/94": [{"task_id": "HumanEval/94", "solution": "import math\ndef is_prime(n):\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\ndef sum_digits(n):\n    digit_sum = 0\n    # Process positive numbers; primes are always positive.\n    while n > 0:\n        digit_sum += n % 10\n        n //= 10\n    return digit_sum\ndef skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    largest_prime = -1 # Initialize with a value smaller than any possible prime.\n\n    for num in lst:\n        if is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n\n    # Based on the examples provided, it's guaranteed that at least one prime\n    # will be found in the input list, so largest_prime will be updated.\n    return sum_digits(largest_prime)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "import sys\nfrom typing import List, Optional\nclass Cell:\n    \"\"\"Represents a cell with coordinates and value; enumerates edge-adjacent neighbors inside grid.\"\"\"\n    def __init__(self, row: int, col: int, value: int, grid_ref):\n        self.row = row\n        self.col = col\n        self.value = value\n        self._grid_ref = grid_ref\n\n    def neighbors(self) -> List['Cell']:\n        \"\"\"Returns a list of edge-adjacent neighbor cells within the grid boundaries.\"\"\"\n        neighbors_list = []\n        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n\n        for dr, dc in directions:\n            new_row, new_col = self.row + dr, self.col + dc\n            if 0 <= new_row < self._grid_ref.size and \\\n               0 <= new_col < self._grid_ref.size:\n                neighbors_list.append(self._grid_ref.getCell(new_row, new_col))\n        return neighbors_list\nclass Grid:\n    \"\"\"In-memory representation of the N x N grid and utility operations.\"\"\"\n    def __init__(self, raw_grid: List[List[int]]):\n        self.size = len(raw_grid)\n        self.cells: List[List[Cell]] = [[None for _ in range(self.size)] for _ in range(self.size)] # type: ignore\n\n        for r in range(self.size):\n            for c in range(self.size):\n                self.cells[r][c] = Cell(r, c, raw_grid[r][c], self)\n\n    def getCell(self, r: int, c: int) -> Cell:\n        \"\"\"Returns the Cell object at the given row and column.\"\"\"\n        return self.cells[r][c]\nclass Path:\n    \"\"\"Represents an ordered sequence of Cell visits and converts to a value list.\"\"\"\n    def __init__(self, initial_cell: Optional[Cell] = None):\n        self.steps: List[Cell] = []\n        self.values: List[int] = []\n        if initial_cell:\n            self.append(initial_cell)\n\n    def append(self, cell: Cell) -> None:\n        \"\"\"Appends a cell to the path.\"\"\"\n        self.steps.append(cell)\n        self.values.append(cell.value)\n\n    def pop(self) -> None:\n        \"\"\"Removes the last cell from the path (for backtracking).\"\"\"\n        if self.steps:\n            self.steps.pop()\n            self.values.pop()\n\n    def length(self) -> int:\n        \"\"\"Returns the current length of the path.\"\"\"\n        return len(self.steps)\n\n    def toValueList(self) -> List[int]:\n        \"\"\"Returns the ordered list of values visited in the path.\"\"\"\n        return self.values[:] # Return a copy to prevent external modification\nclass Comparator:\n    \"\"\"Lexicographically compares two Path objects by their value lists.\"\"\"\n\n    def lexCompare(self, pathA: Path, pathB: Path) -> int:\n        \"\"\"\n        Compares two paths lexicographically.\n        Returns negative if pathA < pathB, zero if equal, positive if pathA > pathB.\n        Assumes paths are of equal length (k).\n        \"\"\"\n        valsA = pathA.values\n        valsB = pathB.values\n        for i in range(len(valsA)): # Assumes same length\n            if valsA[i] < valsB[i]:\n                return -1\n            elif valsA[i] > valsB[i]:\n                return 1\n        return 0 # Should not happen due to uniqueness guarantee\nclass PathFinder:\n    \"\"\"Generates candidate paths and selects the lexicographically minimal path.\"\"\"\n\n    def __init__(self, comparator: Comparator):\n        self.comparator = comparator\n        self.grid: Optional[Grid] = None\n        self.k: int = 0\n        self.best_path: Optional[Path] = None\n        self.current_path: Path = Path()\n\n    def _dfs(self, current_cell: Cell, depth: int):\n        \"\"\"\n        Recursive helper for DFS to find paths of length k.\n        Modifies self.current_path in-place.\n        \"\"\"\n        self.current_path.append(current_cell)\n\n        # Pruning: If a best path has been found, check if current prefix is already worse.\n        if self.best_path is not None:\n            prune = False\n            for i in range(depth): # Compare prefix up to current depth\n                if self.current_path.values[i] > self.best_path.values[i]:\n                    prune = True\n                    break\n                elif self.current_path.values[i] < self.best_path.values[i]:\n                    # Current path is better than best_path's prefix so far, don't prune.\n                    break\n                # If values are equal, continue comparison at next index.\n\n            if prune:\n                self.current_path.pop() # Backtrack\n                return\n\n        if depth == self.k:\n            # If best_path is None or current_path is lexicographically smaller\n            if self.best_path is None or self.comparator.lexCompare(self.current_path, self.best_path) < 0:\n                # Deep copy the current_path to best_path\n                self.best_path = Path()\n                self.best_path.steps = list(self.current_path.steps)\n                self.best_path.values = list(self.current_path.values)\n            self.current_path.pop() # Backtrack\n            return\n\n        for neighbor in current_cell.neighbors():\n            self._dfs(neighbor, depth + 1)\n\n        self.current_path.pop() # Backtrack\n\n    def findMinPath(self, grid_obj: Grid, k: int) -> Path:\n        \"\"\"Finds the lexicographically minimal path of length k in the grid.\"\"\"\n        self.grid = grid_obj\n        self.k = k\n        self.best_path = None # Reset for a new search\n        self.current_path = Path() # Reset current path\n\n        # Special case for k=1: Find the cell with the minimum value.\n        if k == 1:\n            min_value = sys.maxsize\n            min_cell = None\n            for r in range(self.grid.size):\n                for c in range(self.grid.size):\n                    cell = self.grid.getCell(r, c)\n                    if cell.value < min_value:\n                        min_value = cell.value\n                        min_cell = cell\n            return Path(min_cell) # Return a path with just this cell\n\n        for r in range(self.grid.size):\n            for c in range(self.grid.size):\n                start_cell = self.grid.getCell(r, c)\n                self._dfs(start_cell, 1) # Start DFS for each cell, depth 1 for the first cell\n\n        # The problem guarantees a unique answer and valid inputs will find a path.\n        return self.best_path\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n    grid_obj = Grid(grid)\n    # The design context described validation and returning Error objects.\n    # However, the function signature `-> List[int]` implies valid inputs\n    # according to typical competitive programming contexts.\n    # Therefore, explicit error handling with Error DTOs is omitted from this function.\n\n    comparator = Comparator()\n    pathfinder = PathFinder(comparator)\n    best_path = pathfinder.findMinPath(grid_obj, k)\n    return best_path.toValueList()", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[[10, 5, 20, 14, 16], [7, 11, 12, 17, 9], [13, 19, 1, 15, 8], [3, 18, 4, 6, 2], [22, 21, 23, 24, 25]], 23]]}], "HumanEval/130": [{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in \n    the last couple centuries. However, what people don't know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8 \n    You are given a non-negative integer number n, you have to a return a list of the \n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n    cache = {}\n\n    def get_value(k):\n        \"\"\"Computes and caches the Tribonacci value for a given index k.\"\"\"\n        if k in cache:\n            return cache[k]\n\n        if k == 0:\n            val = 1\n        elif k == 1:\n            val = 3\n        elif k % 2 == 0:  # k is even and k >= 2\n            val = 1 + k // 2\n        else:  # k is odd and k >= 3\n            # Resolve forward reference by ensuring k+1 is computed first\n            val_k_plus_1 = get_value(k + 1)\n            val_k_minus_1 = get_value(k - 1)\n            val_k_minus_2 = get_value(k - 2)\n            val = val_k_minus_1 + val_k_minus_2 + val_k_plus_1\n\n        cache[k] = val\n        return val\n\n    result_list = []\n    for i in range(n + 1):\n        result_list.append(get_value(i))\n\n    return result_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/139": [{"task_id": "HumanEval/139", "solution": "class ValidationError(Exception):\n    \"\"\"Signals invalid input to callers.\"\"\"\n    pass\nclass InputParameter:\n    \"\"\"Represents the validated input integer n.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\n    def is_valid(self) -> bool:\n        \"\"\"Returns True if n is an integer greater than 0.\"\"\"\n        return isinstance(self.n, int) and self.n > 0\nclass BrazilianFactorial:\n    \"\"\"Computes and holds the Brazilian factorial result.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n        self.result = 0\n\n    def compute(self) -> int:\n        \"\"\"Computes product_{k=1..n} (k!) and sets/returns result.\"\"\"\n        self.result = accumulate_factorials(self.n)\n        return self.result\nclass Result:\n    \"\"\"Represents the produced result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def as_integer(self) -> int:\n        \"\"\"Returns the value as an integer.\"\"\"\n        return self.value\ndef validate_input(n) -> InputParameter:\n    \"\"\"Validates that n is an integer greater than 0.\"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValidationError(\"Input must be an integer greater than 0.\")\n    return InputParameter(n)\ndef accumulate_factorials(n: int) -> int:\n    \"\"\"Computes product_{k=1..n} (k!) efficiently.\"\"\"\n    product_of_factorials = 1\n    current_factorial = 1\n    for k in range(1, n + 1):\n        current_factorial *= k\n        product_of_factorials *= current_factorial\n    return product_of_factorials\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    input_param = validate_input(n)\n    brazilian = BrazilianFactorial(input_param.n)\n    result_int = brazilian.compute()\n    return Result(result_int).as_integer()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]}}