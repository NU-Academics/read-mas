scending(self) -> bool:\n        \"\"\"Checks if the factors list is sorted in ascending order.\"\"\"\n        if not self._factors:\n            return True\n        for i in range(len(self._factors) - 1):\n            if self._factors[i] > self._factors[i+1]:\n                return False\n        return True\nclass FactorizationService:\n    def factorize(self, n: int) -> FactorizationResult:\n        \"\"\"Computes the prime factorization for a given integer n.\"\"\"\n        input_obj = IntegerInput(n)\n        if not input_obj.isValid():\n            # For n <= 1 (invalid per IntegerInput.isValid()), return an empty list of factors.\n            return FactorizationResult([])\n\n        factors: List[int] = []\n        d = 2\n        temp_n = n\n        while d * d <= temp_n:\n            while temp_n % d == 0:\n                factors.append(d)\n                temp_n //= d\n            d += 1\n        if temp_n > 1:\n            factors.append(temp_n)\n        \n        result = FactorizationResult(factors)\n        self.sortFactorsAscending(result)\n        self.verifyProduct(result, n) # Verification step, result is assumed correct for valid inputs.\n\n        return result\n\n    def sortFactorsAscending(self, result: FactorizationResult) -> None:\n        \"\"\"Sorts the factors within a FactorizationResult object in ascending order.\"\"\"\n        result._factors.sort()\n\n    def verifyProduct(self, result: FactorizationResult, n: int) -> bool:\n        \"\"\"Verifies that the product of factors in FactorizationResult equals n.\"\"\"\n        return result.product() == n\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5