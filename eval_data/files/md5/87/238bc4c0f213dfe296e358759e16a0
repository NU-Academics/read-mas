ates a single input binary string.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\n\n    def is_valid(self) -> bool:\n        \"\"\"Returns True if the value contains exclusively '0' and '1' characters.\"\"\"\n        return all(c in ('0', '1') for c in self.value)\nclass XORResult:\n    \"\"\"Represents the XOR computation result string.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    binary_a = BinaryString(a)\n    binary_b = BinaryString(b)\n\n    if not binary_a.is_valid() or not binary_b.is_valid():\n        raise ValueError(\"Input strings must contain only '0' or '1' characters.\")\n\n    if binary_a.length() != binary_b.length():\n        raise ValueError(\"Input strings must be of equal length.\")\n\n    if binary_a.length() == 0:\n        return XORResult('').value\n\n    result_chars: List[str] = []\n    for i in range(binary_a.length()):\n        char_a = binary_a.value[i]\n        char_b = binary_b.value[i]\n        if char_a == char_b:\n            result_chars.append('0')\n        else:\n            result_chars.append('1')\n\n    return XORResult(\"\".join(result_chars)).value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/13": [{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    # Use absolute values to ensure the GCD is non-negative, as per mathematical convention.\n    a = abs(a)\n    b = abs(b)\n\n    # Implement the Euclidean algorithm iteratively.\n    while b:\n        a, b = b, a % b\n    return a", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/10": [{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\ndef _longest_palindromic_suffix(string: str) -> int:\n    \"\"\" Returns the starting index of the longest palindromic suffix. \"\"\"\n    n = len(string)\n    for i in range(n):\n        if is_palindrome(string[i:]):\n            return i\n    return n # Should not be reached for non-empty string, for empty string it's 0.\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    # Find the starting index of the longest palindromic suffix\n    idx = _longest_palindromic_suffix(string)\n\n    # The prefix that needs to be reversed is everything before this suffix\n    prefix_to_reverse = string[:idx]\n\n    # Append the reversed prefix to the original string\n    return string + prefix_to_reverse[::-1]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/14": [{"task_id": "HumanEval/14", "solution": "from typing import List\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    return [string[:i] for i in range(1, len(string) + 1)]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/20": [{"task_id": "HumanEval/20", "solution": "class NumbersList:\n    \"\"\"Wraps a list of numbers for validation.\"\"\"\n    def __init__(self, numbers: List[float]):\n        self._numbers = numbers\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self._numbers)\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the list contains at least two elements.\"\"\"\n        return self.length() >= 2\nclass NumberPair:\n    \"\"\"Represents an ordered pair of numbers (smaller, larger).\"\"\"\n    def __init__(self, smaller: float, larger: float):\n        self._smaller = smaller\n        self._larger = larger\n\n    def to_tuple(self) -> Tuple[float, float]:\n        \"\"\"Converts the NumberPair to a tuple.\"\"\"\n        return (self._smaller, self._larger)\nclass ClosestElementsService:\n    \"\"\"Computes the closest pair of elements in a list.\"\"\"\n    def find_closest_elements(self, numbers: List[float]) -> 'NumberPair':\n        \"\"\"Sorts the numbers and finds the adjacent pair with the minimal difference.\"\"\"\n        sorted_numbers = sorted(numbers)\n        \n        minimal_diff = float('inf')\n        # Initialize best_pair with the first adjacent pair, as length >= 2 is guaranteed by validation.\n        best_pair = (sorted_numbers[0], sorted_numbers[1])\n\n        for i in range(len(sorted_numbers) - 1):\n            a = sorted_numbers[i]\n            b = sorted_numbers[i+1]\n            diff = abs(b - a)\n\n            if diff < minimal_diff:\n                minimal_diff = diff\n                best_pair = (a, b)\n        \n        return NumberPair(smaller=best_pair[0], larger=best_pair[1])\ndef find_closest_elements(numbers: List[float]) -> Tuple[float, float]:\n    \"\"\" From a supplied list of numbers (of length at least two) select and return two that are the closest 