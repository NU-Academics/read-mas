str:\n        \"\"\"Converts an integer x to its string representation in the given base.\"\"\"\n        if x == 0:\n            return '0'\n\n        res = \"\"\n        is_negative = False\n        if x < 0:\n            is_negative = True\n            x = abs(x)\n\n        while x > 0:\n            remainder = x % base\n            res = str(remainder) + res\n            x //= base\n        \n        if is_negative:\n            res = '-' + res\n            \n        return res\ndef change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    validator = InputValidator()\n    if not validator.validate_types(x, base):\n        raise TypeError(\"x and base must be integers\")\n    if not validator.validate_base_range(base):\n        raise ValueError(\"base must be less than 10\")\n    \n    converter = NumberConverter()\n    return converter.change_base(x, base)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/42": [{"task_id": "HumanEval/42", "solution": "def incr_list(l: list):\n    \"\"\"Return list with elements incremented by 1.\n    >>> incr_list([1, 2, 3])\n    [2, 3, 4]\n    >>> incr_list([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [6, 4, 6, 3, 4, 4, 10, 1, 124]\n    \"\"\"\n    return [x + 1 for x in l]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/45": [{"task_id": "HumanEval/45", "solution": "class Triangle:\n    \"\"\"A value object representing a triangle with a base and height.\"\"\"\n    def __init__(self, a: float, h: float):\n        self.a = float(a)\n        self.h = float(h)\n\n    def area(self) -> float:\n        \"\"\"Computes the area of the triangle.\"\"\"\n        return (self.a * 