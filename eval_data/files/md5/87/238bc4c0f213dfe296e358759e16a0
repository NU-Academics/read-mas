m a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    '''\n    validator = InputValidator()\n\n    # Validate numeric input types and positivity of side lengths.\n    if not validator.validateNumeric(a, b, c):\n        return -1\n\n    # Convert inputs to float for consistent arithmetic operations.\n    a_f, b_f, c_f = float(a), float(b), float(c)\n\n    # Validate the triangle inequality condition.\n    if not validator.validateTriangleInequality(a_f, b_f, c_f):\n        return -1\n\n    # If valid, compute the area using the Triangle class.\n    tri = Triangle(a_f, b_f, c_f)\n    area_unrounded = tri.computeArea()\n\n    # Return the computed area rounded to two decimal places.\n    return round(area_unrounded, 2)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/72": [{"task_id": "HumanEval/72", "solution": "class PalindromeChecker:\n    def is_palindrome(self, sequence):\n        \"\"\"Return True if sequence is palindromic (single-element => True).\"\"\"\n        return sequence == sequence[::-1]\nclass SumCalculator:\n    def sum(self, sequence):\n        \"\"\"Return arithmetic sum of numeric elements in sequence.\"\"\"\n        return sum(sequence)\ndef will_it_fly(q,w):\n    '''\n    Write a function that returns True if the object q will fly, and False otherwise.\n    The object q will fly if it's balanced (it is a palindromic list) and the sum of its elements is less than or equal the maximum possible weight w.\n\n    Example:\n    will_it_fly([1, 2], 5) \u279e False \n    # 1+2 is less than the maximum possible weight, but it's unbalanced.\n\n    will_it_fly([3, 2, 3], 1) \u279e False\n    # it's balanced, but 3+2+3 is more than the maximum possible weight.\n\n    will_it_fly([3, 2, 3], 9) \u279e True\n    # 3+2+3 is less than the maximum possible weight, and it's balanced.\n\n    will_it_fly([3], 5) \u279e True\n    # 3 is less than the maximum possible weight, and it's balanced.\n    '''\n    if not PalindromeChecker().is_palindrome(q):\n        return False\n    total = SumCalculator().sum(q)\n    return total <= w", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/64": [{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    \"\"\"\n    class VowelCounter:\n        def __init__(self):\n            self.vowels: set[str] = {'a', 'e', 'i', 'o', 'u'}\n\n        def countVowels(self, s_param: str) -> int:\n            if not s_param:\n                return 0\n\n            count = 0\n            s_lower = s_param.lower()\n            last_index = len(s_lower) - 1\n\n            for i, char in enumerate(s_lower):\n                if char in self.vowels:\n                    count += 1\n                elif char == 'y' and i == last_index:\n                    count += 1\n            return count\n\n    return VowelCounter().countVowels(s)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/65": [{"task_id": "HumanEval/65", "solution": "class ResultString:\n    \"\"\"Wraps the final result string.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def to_string(self) -> str:\n        \"\"\"Returns the wrapped string value.\"\"\"\n        return self.value\nclass ShiftParameter:\n    \"\"\"Wraps the integer shift value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\nclass DigitArray:\n    \"\"\"Represents a sequence of digits and provides manipulation operations.\"\"\"\n    def __init__(self, digits: str) -> None:\n        self.digits = digits\n\n    def length(self) -> int:\n        \"\"\"Returns the number of digits in the array.\"\"\"\n        return len(self.digits)\n\n    def to_string(self) -> str:\n        \"\"\"Converts the DigitArray to a string.\"\"\"\n        return self.digits\n\n    def right_rotate(self, k: int) -> 'DigitArray':\n        \"\"\"Performs a right circular rotation by k positions.\"\"\"\n        n = self.length()\n        if n == 0:\n            return DigitArray(\"\")\n        \n        effective_k = k % n\n        rotated_digits = self.digits[-effective_k:] + self.digits[:-effective_k]\n        return DigitArray(rotated_digits)\n\n    def reverse(self) -> 'DigitArray':\n        \"\"\"Reverses the sequence of digits.\"\"\"\n        return DigitArray(self.digits[::-1])\nclass IntegerNumber:\n    \"\"\"Holds an integer value and converts it to a DigitArray.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def to_digit_array(self) -> 'DigitArray':\n        \"\"\"Converts the integer value to a DigitArray.\"\"\"\n        return DigitArray(str(self.value))\nclass CircularShiftFunction:\n    \"\"\"Transforms digit sequences according to shift rules.\"\"\"\n    def apply(self, x_num: 'IntegerNumber', shift_param: 'ShiftParameter') -> str:\n        \"\"\"Applies circular shift rules to the integer's digits.\"\"\"\n        digit_array = x_num.to_digit_array()\n        digits_str = digit_array.to_string()\n        digit_count = digit_array.length()\n        shift = shift_param.value\n\n        if 0 < shift < digit_count:\n            # BR2: Shift is within the bounds for right-rotation.\n            transformed_digits = digit_array.right_rotate(shift).to_string()\n        elif shift == digit_count:\n            # BR3: Shift equals digit count, no change.\n            transformed_digits = digits_str\n        elif shift > digit_count:\n            # BR4: Shift is greater than digit count, reverse.\n            transformed_digits = digit_array.reverse().to_string()\n        else:\n            # Fallback for unspecified cases (e.g., shift <= 0): return original.\n            transformed_digits = digits_str\n            \n        return ResultString(transformed_digits).to_string()\ndef circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    integer_number = IntegerNumber(x)\n    shift_parameter = ShiftParameter(shift)\n    \n    circular_shift_func = CircularShiftFunction()\n    return circular_shift_func.apply(integer_number, shift_parameter)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/68": [{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Given an array, find the smallest even non-negative integer and its index.\n    If multiple such values exist, return the one with the smallest index.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for i, value in enumerate(arr):\n        # Check if the current value is even\n        if value % 2 == 0:\n            # If this even value is smaller than the current smallest even value found\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n            # If value == smallest_even_value, we do not update,\n            # as the current smallest_even_index is already for the first occurrence.\n\n    # If no even values were found (smallest_even_index remains -1), return an empty list\n    if smallest_even_index == -1:\n        return []\n    else:\n        # Otherwise, return the smallest even value and its corresponding index\n        return [smallest_even_value, smallest_even_index]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/69": [{"task_id": "HumanEval/69", "solution": "from typing import List, Dict\nclass InputList:\n    def __init__(self, values: List[int]):\n        self.values = values\n\n    def validate(self) -> bool:\n        # Checks if the list is non-empty and all elements are positive.\n        if not self.values:\n            return False\n        if not all(x > 0 for x in self.values):\n            return False\n        return True\nclass Frequency:\n    def __init__(self, value: int, count: int = 0):\n        self.value = value\n        self.count = count\n\n    def increment(self) -> None:\n        # Increments the frequency count for the associated value.\n        self.count += 1\nclass CandidateValue:\n    def __init__(self, value: int, count: int):\n        self.value = value\n        self.count = count\n\n    def isCandidate(self) -> bool:\n        # Determines if the value meets candidacy criteria (count >= value and value > 0).\n        return self.count >= self.value and self.value > 0\nclass Result:\n    @staticmethod\n    def determineMax(candidates: List[CandidateValue]) -> int:\n        # Finds the maximum value among valid candidates, or returns -1 if none.\n        if not candidates:\n            return -1\n        \n        max_val = -1\n        for candidate in candidates:\n            if candidate.value > max_val:\n                max_val = candidate.value\n        return max_val\ndef search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    input_obj = InputList(lst)\n    if not input_obj.validate():\n        return -1\n\n    frequency_map: Dict[int, Frequency] = {}\n    for number in lst:\n        if number not in frequency_map:\n            frequency_map[number] = Frequency(value=number)\n        frequency_map[number].increment()\n\n    candidates: List[CandidateValue] = []\n    for freq_obj in frequency_map.values():\n        candidate_obj = CandidateValue(value=freq_obj.value, count=freq_obj.count)\n        if candidate_obj.isCandidate():\n            candidates.append(candidate_obj)\n\n    return Result.determineMax(candidates)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/73": [{"task_id": "HumanEval/73", "solution": "from typing import List\ndef smallest_change(arr: List[int]) -> int:\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic. A palindromic array is an array that\n    is read the same backwards and forwards. In one change, you can change one element to any other element.\n\n    For example:\n    smallest_change([1,2,3,5,4,7,9,6]) == 4\n    smallest_change([1, 2, 3, 4, 3, 2, 2]) == 1\n    smallest_change([1, 2, 3, 2, 1]) == 0\n    \"\"\"\n    n = len(arr)\n    changes = 0\n    # Iterate from the start of the array up to the middle index (exclusive)\n    # The middle element for odd-length arrays does not need to be compared.\n    for i in range(n // 2):\n        # Compare the element at index i with its symmetric counterpart\n        if arr[i] != arr[n - 1 - i]:\n            changes += 1\n    return changes", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/74": [{"task_id": "HumanEval/74", "solution": "class StringItem:\n    \"\"\"Represents a single string element and provides its length.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the string.\"\"\"\n        return len(self.value)\nclass StringList:\n    \"\"\"Encapsulates a list of strings and computes its total character count.\"\"\"\n    def __init__(self, elements: list):\n        self._elements = elements\n        self._total_chars = -1  # Sentinel value to indicate not yet computed\n\n    def compute_total_chars(self) -> int:\n        \"\"\"Computes and caches the total character count for the list.\"\"\"\n        if self._total_chars != -1:\n            return self._total_chars\n        \n        total = 0\n        for item_str in self._elements:\n            string_item = StringItem(item_str)\n            total += string_item.length()\n        \n        self._total_chars = total\n        return total\n\n    def get_total_chars(self) -> int:\n        \"\"\"Returns the total character count, computing it if necessary.\"\"\"\n        return self.compute_total_chars()\ndef total_match(lst1, lst2):\n    '''\n    Write a function that accepts two lists of strings and returns the list that has \n    total number of chars in the all strings of the list less than the other list.\n\n    if the two lists have the same number of chars, return the first list.\n    '''\n    string_list1 = StringList(lst1)\n    string_list2 = StringList(lst2)\n\n    total1 = string_list1.get_total_chars()\n    total2 = string_list2.get_total_chars()\n\n    if total1 <= total2:\n        return lst1\n    else:\n        return lst2", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/75": [{"task_id": "HumanEval/75", "solution": "import math\nfrom typing import List\nclass IntegerInput:\n    \"\"\"Represents a caller-supplied integer input value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\nclass Validator:\n    \"\"\"Validates an IntegerInput per business rules: type int and 1 <= value <= 99.\"\"\"\n    min_value: int = 1\n    max_value: int = 99\n\n    def validate(self, input: IntegerInput) -> bool:\n        \"\"\"Returns True if input.value is an integer within [1,99]; otherwise False.\"\"\"\n        if not isinstance(input.value, int):\n            return False\n        return self.min_value <= input.value <= self.max_value\nclass PrimeFactorization:\n    \"\"\"Computes prime factorization for integers in [1..99] using trial division.\"\"\"\n    def factorize(self, n: int) -> List[int]:\n        \"\"\"Returns a list of prime factors (including multiplicity) for n.\"\"\"\n        factors = []\n        d = 2\n        temp_n = n\n        while d * d <= temp_n:\n            while temp_n % d == 0:\n                factors.append(d)\n                temp_n //= d\n            d += 1\n        if temp_n > 1:\n            factors.append(temp_n)\n        return factors\nclass FactorizationResult:\n    \"\"\"Container for factorization output, including the list of factors and their count.\"\"\"\n    def __init__(self, factors: List[int]):\n        self.factors = factors\n        self.factorCount = len(factors)\nclass IsMultiplyPrimeService:\n    \"\"\"Orchestrates validation and factorization to implement the decision rule.\"\"\"\n    def __init__(self, validator: Validator = None, factorizer: PrimeFactorization = None):\n        self.validator = validator if validator is not None else Validator()\n        self.factorizer = factorizer if factorizer is not None else PrimeFactorization()\n\n    def is_multiply_prime(self, a: int) -> bool:\n        \"\"\"Determines if 'a' is a product of exactly three prime numbers.\"\"\"\n        try:\n            input_obj = IntegerInput(a)\n            if not self.validator.validate(input_obj):\n                return False\n\n            factors = self.factorizer.factorize(input_obj.value)\n            result = FactorizationResult(factors)\n\n            return result.factorCount == 3\n        except Exception:\n            # Handles any unexpected internal errors by returning False.\n            return False\ndef is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100. \n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    service = IsMultiplyPrimeService()\n    return service.is_multiply_prime(a)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/77": [{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Write a function that takes an integer a and returns True \n    if this ingeger is a cube of some integer number.\n    '''\n    if a == 0:\n        return True\n\n    # Determine if 'a' is negative to handle cube root correctly\n    is_negative = a < 0\n    \n    # Calculate the absolute value for cube root computation\n    abs_a = abs(a)\n    \n    # Compute the cube root using floating-point arithmetic and round to the nearest integer.\n    # Python's `** (1/3)` works for floats. `round()` handles minor precision errors for perfect cubes.\n    root_candidate = round(abs_a**(1/3))\n    \n    # Reconstruct the cube using the integer root candidate\n    # If the original number was negative, the root must also be negative\n    if is_negative:\n        calculated_cube = (-root_candidate) * (-root_candidate) * (-root_candidate)\n    else:\n        calculated_cube = root_candidate * root_candidate * root_candidate\n        \n    return calculated_cube == a", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/76": [{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n (n**k = x for non-negative integer k).\"\"\"\n\n    if x == 1:\n        return True\n\n    if n =