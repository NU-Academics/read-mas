d be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n    # Condition 2: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    parts = file_name.split('.')\n    prefix = parts[0]\n    suffix = parts[1]\n\n    # Condition 3: The substring before the dot should not be empty,\n    # and it starts with a letter from the latin alphapet ('a'-'z' and 'A'-'Z').\n    if not prefix:  # Check if prefix is empty\n        return 'No'\n    \n    first_char = prefix[0]\n    if not ('a' <= first_char <= 'z' or 'A' <= first_char <= 'Z'):\n        return 'No'\n\n    # Condition 4: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    if suffix not in ['txt', 'exe', 'dll']:\n        return 'No'\n\n    # Condition 1: There should not be more than three digits ('0'-'9') in the file's name.\n    digit_count = 0\n    for char in file_name:\n        if char.isdigit():\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    # If all conditions are met\n    return 'Yes'", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["\u00e9xample.exe"]]}, {"task_id": "HumanEval/141", "solution": "_ALLOWED_EXTENSIONS = ['txt', 'exe', 'dll']\n_MAX_DIGITS = 3\nclass _FileNameParts:\n    def __init__(self, name: str, ext: str) -> None:\n        self.name = name\n        self.ext = ext\nclass _ParseError(ValueError):\n    pass\ndef _is_latin_letter(ch: str) -> bool:\n    return 'a' <= ch <= 'z' or 'A' <= ch <= 'Z'\ndef _split_once_dot(s: str) -> _FileNameParts:\n    parts = s.split('.')\n    if len(parts) != 2:\n        raise _ParseError(\"expected exactly one dot in filename\")\n    name, ext = parts[0].strip(), parts[1].strip()\n    if not name:\n        raise _ParseError(\"prefix before dot must not be empty\")\n    return _FileNameParts(name=name, ext=ext)\ndef _count_digits(s: str) -> int:\n    return sum(1 for ch in s if '0' <= ch <= '9')\n_LOWER_ALLOWED_EXTENSIONS = [ext.lower() for ext in _ALLOWED_EXTENSIONS]\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\"\"\"\n\n    # Handle non-string and empty string inputs, returning 'No' as per \"returns 'No' otherwise\".\n    if not isinstance(file_name, str) or not file_name:\n        return \"No\"\n\n    try:\n        parts = _split_once_dot(file_name)\n    except _ParseError:\n        return \"No\"\n\n    # Condition: There should not be more than three digits ('0'-'9') in the file's name.\n    digit_count = _count_digits(file_name)\n    if digit_count > _MAX_DIGITS:\n        return \"No\"\n\n    # Condition: The substring before the dot should not be empty (guaranteed by _split_once_dot),\n    # and it starts with a letter from the latin alphabet ('a'-'z' and 'A'-'Z').\n    if not _is_latin_letter(parts.name[0]):\n        return \"No\"\n\n    # Condition: The substring after the dot should be one of these: ['txt', 'exe', 'dll'].\n    # Comparison is case-insensitive due to _CASE_INSENSITIVE_EXT.\n    if parts.ext.lower() not in _LOWER_ALLOWED_EXTENSIONS:\n        return \"No\"\n\n    return \"Yes\"", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["\u00e9xample.exe"]]}], "HumanEval/142": [{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Calculates the sum of modified list entries based on their index.\n    Indexes multiple of 3 are squared; indexes multiple of 4 but not 3 are cubed.\n    \"\"\"\n    total_sum = 0\n    for i, x in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += x ** 2\n        elif i % 4 == 0:  # This implicitly means i % 3 != 0 because of the previous condition\n            total_sum += x ** 3\n        else:\n            total_sum += x\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    total = 0\n    for i, v in enumerate(lst):\n        if i % 3 == 0:\n            total += v * v\n        elif i % 4 == 0:\n            total += v * v * v\n        else:\n            total += v\n    return total", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/143": [{"task_id": "HumanEval/143", "solution": "import math\ndef words_in_sentence(sentence):\n    \"\"\"\n    Returns a string containing words from the original sentence whose lengths are prime numbers,\n    maintaining their original order.\n    \"\"\"\n    def is_prime(n):\n        # Checks if a given number n is a prime number using trial division.\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        limit = int(math.sqrt(n)) + 1\n        for i in range(3, limit, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    # Split the sentence into words, filtering out any empty strings.\n    words = [word for word in sentence.split(' ') if word]\n\n    prime_length_words = []\