ile ((())) has three.\n    \"\"\"\n\n    def _split_groups(s: str) -> List[str]:\n        \"\"\"Splits the input string into groups by whitespace, filtering out empty tokens.\"\"\"\n        if not s:\n            return []\n        return [token for token in s.split() if token]\n\n    def _process_single_group(group: str) -> int:\n        \"\"\"Computes the maximum nesting depth for a parenthesis group, validating characters and balance.\"\"\"\n        max_depth = 0\n        current_depth = 0\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                if current_depth > max_depth:\n                    max_depth = current_depth\n            elif char == ')':\n                current_depth -= 1\n            else:\n                raise ParseError(\"Invalid character detected\", group=group)\n            \n            if current_depth < 0:\n                raise ParseError(\"Unbalanced parentheses (too many closing parentheses)\", group=group)\n        \n        if current_depth != 0:\n            raise ParseError(\"Unbalanced parentheses (mismatched open/close pairs)\", group=group)\n            \n        return max_depth\n\n    groups = _split_groups(paren_string)\n    results = []\n    for group_str in groups:\n        results.append(_process_single_group(group_str))\n    \n    return results", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/6", "solution": "def parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    \"\"\"\n    import re\n    from typing import List, Optional\n\n    class ParseError(Exception):\n        def __init__(self, message: str, group_index: int | None = None):\n            super().__init__(message)\n            self.message = message\n            self.group_index = group_index\n        def __str__(self) -> str:\n            if self.group_index is None:\n                return self.message\n            return f\"Group {self.group_index}: {self.message}\"\n\n    VALID_CHARS = set(\"()\")\n\n    def compute_depth(group: str) -> int:\n        curr = 0\n        max_d = 0\n        for i, ch in enumerate(group):\n            if ch == '(':\n                curr += 1\n                if curr > max_d:\n                    max_d = curr\n            elif ch == ')':\n                curr -= 1\n                if curr < 0:\n                    raise ParseError(\"Unmatched ')'\", group_index=None)\n            else:\n                raise ParseError(\"Invalid character encountered during depth computation\", group_index=None)\n        if curr != 0:\n            raise ParseError(\"Unmatched '(' remains\", group_index=None)\n        return max_d\n\n    def is_balanced(group: str) -> bool:\n        balance = 0\n        for char in group:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    class ParseMetrics:\n        def __init__(self, num_groups: int, max_depth: int):\n            self.num_groups = num_groups\n            self.max_depth = max_depth\n\n    GROUP_SEPARATOR_REGEX = r'\\s+'\n\n    class Tokenizer:\n        @staticmethod\n        def split_into_groups(s: str) -> List[str]:\n            tokens = re.split(GROUP_SEPARATOR_REGEX, s.strip())\n            return [t for t in tokens if t != \"\"]\n\n    class Validator:\n        @staticmethod\n        def validate_group(group: str, index: int) -> None:\n            if any(ch not in VALID_CHARS for ch in group):\n                raise ParseError(\"Group contains invalid characters\", group_index=index)\n            if not is_balanced(group):\n                raise ParseError(\"Unbalanced pare