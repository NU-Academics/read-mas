e: str):\n        self.name: str = name\n        self._strength: Optional[int] = None\n\n    def calculate_strength(self, calc) -> int:\n        \"\"\"Calculates and stores the strength of the extension using the given calculator.\"\"\"\n        if self._strength is None:\n            self._strength = calc.calculate(self.name)\n        return self._strength\n\n    def get_strength(self) -> int:\n        \"\"\"Returns the computed strength.\"\"\"\n        if self._strength is None:\n            raise RuntimeError(\"Strength not calculated\")\n        return self._strength\nclass SelectionResult:\n    \"\"\"Stores the class name and selected extension name.\"\"\"\n    def __init__(self, class_name: str, extension_name: str):\n        self.class_name = class_name\n        self.extension_name = extension_name\n\n    def formatted(self) -> str:\n        \"\"\"Returns the result in the 'ClassName.ExtensionName' format.\"\"\"\n        return f\"{self.class_name}.{self.extension_name}\"\nclass StrengthCalculator:\n    \"\"\"Calculates the strength of an extension string.\"\"\"\n    def __init__(self, count_upper: bool = True):\n        self.count_upper = count_upper\n\n    def calculate(self, extension: str) -> int:\n        \"\"\"Counts uppercase and lowercase letters to determine strength (CAP - SM).\"\"\"\n        if not isinstance(extension, str):\n            raise InvalidInputError(\"extension must be a string\")\n        cap = sum(1 for ch in extension if 'A' <= ch <= 'Z')\n        sm = sum(1 for ch in extension if 'a' <= ch <= 'z')\n        return cap - sm\nclass ExtensionSelector:\n    \"\"\"Selects the strongest extension from a list.\"\"\"\n    def __init__(self, calculator: StrengthCalculator):\n        self.calculator = calculator\n\n    def select(self, class_name: str, extensions: list[str]) -> SelectionResult:\n        \"\"\"Finds the strongest extension and returns the formatted result.\"\"\"\n        models = [ExtensionModel(name) for name in extensions]\n        for m in models:\n            m.calculate_strength(self.calculator)\n        best = self._select_best(models)\n        return SelectionResult(class_name, best.name)\n\n    def _select_best(self, models: list[ExtensionModel]) -> ExtensionModel:\n        \"\"\"Selects the ExtensionModel with maximum strength, preserving original order for ties.\"\"\"\n        return max(models, key=lambda m: m.get_strength())\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension based on CAP - SM calculation and returns it in ClassName.StrongestExtensionName format.\n    Ties are broken by choosing the first encountered extension in the list.\n    \"\"\"\n    validate_class_name(class_name)\n    validate_extensions(extensions)\n    \n    selector = ExtensionSelector(StrengthCalculator())\n    result = selector.select(class_name, extensions)\n    \n    return result.formatted()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["Watashi", ["tEN", "niNE", "eIGHt8OKe"]]], "plus_fail_tests": [["Test1", ["UPPERCASE", "uppercase", "1111"]]]}], "HumanEval/154": [{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    if b == \"\":\n        return True\n    if len(b) > len(a):\n        return False\n    \n    # Check if b is directly a substring of a.\n    if b in a:\n        return True\n    \n    # Create a concatenated string (b+b) to efficiently check all rotations.\n    # Any rotation of b will be a substring of length len(b) within (b+b).\n    concat_b = b +