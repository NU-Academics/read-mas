   def get_nth_prime_fib(self, n: int) -> PrimeFibResult:\n        \"\"\"Returns the n-th Fibonacci number that is also prime.\"\"\"\n        self._validate_input(n)\n        \n        # Check cache first for the exact 'n' requested\n        cached = self.cache.get(n)\n        if cached is not None:\n            return PrimeFibResult(n=n, value=cached)\n        \n        # If not in cache, compute it. _compute_nth_prime_fib will also populate\n        # cache for intermediate results (e.g., if n=5, it caches for 1,2,3,4,5)\n        value = self._compute_nth_prime_fib(n)\n        \n        return PrimeFibResult(n=n, value=value)\n_default_service = PrimeFibService(\n    cache=InMemoryCacheRepository(),\n    generator=FibonacciGenerator(),\n    checker=PrimeChecker()\n)\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    return _default_service.get_nth_prime_fib(n).value", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[2]], "plus_fail_tests": [[12]]}], "HumanEval/42": [{"task_id": "HumanEval/42", "solution": "def incr_list(l: list):\n    \"\"\"Return list with elements incremented by 1.\n    >>> incr_list([1, 2, 3])\n    [2, 3, 4]\n    >>> incr_list([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [6, 4, 6, 3, 4, 4, 10, 1, 124]\n    \"\"\"\n    return [x + 1 for x in l]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/42", "solution": "def incr_list(l: list):\n    \"\"\"Return list with elements incremented by 1.\n    >>> incr_list([1, 2, 3])\n    [2, 3, 4]\n    >>> incr_list([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [6, 4, 6, 3, 4, 4, 10, 1, 124]\n    \"\"\"\n    return [x + 1 for x in l]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_te