ta object for a balanced parenthesis group.\"\"\"\n        def __init__(self, content: str):\n            self.content = content\n\n        def __str__(self) -> str:\n            return self.content\n\n    VALID_CHARS = set(['(', ')', ' ', '\\t', '\\n', '\\r'])\n\n    def validate_input(s: str) -> None:\n        \"\"\"Validates input string for allowed characters and basic balance.\"\"\"\n        open_count = 0\n        close_count = 0\n        for i, char in enumerate(s):\n            if char not in VALID_CHARS:\n                raise InvalidInputError(f\"Invalid character '{char}'\", position=i)\n            if char == '(':\n                open_count += 1\n            elif char == ')':\n                close_count += 1\n        if open_count != close_count:\n            raise InvalidInputError(\"Mismatched number of opening and closing parentheses.\")\n\n    class Parser:\n        \"\"\"Parses input string into a list of Group objects.\"\"\"\n        def scan(self, input_str: str) -> List[Group]:\n            cursor = 0\n            length = len(input_str)\n            groups: List[Group] = []\n            buffer: List[str] = []\n            balance = 0\n            while cursor < length:\n                ch = input_str[cursor]\n                if ch.isspace():\n                    cursor += 1\n                    continue\n                if ch not in (\"(\", \")\"):\n                    raise InvalidInputError(f\"Invalid char '{ch}'\", position=cursor)\n\n                buffer.append(ch)\n                if ch == \"(\":\n                    balance += 1\n                else: # ch == ')'\n                    balance -= 1\n                    if balance < 0:\n                        raise InvalidInputError(\"Unmatched closing parenthesis\", position=cursor)\n                \n                # A balanced group finished and buffer is not empty\n                if balance == 0 and buffer:\n                    groups.append(Group(\"\".join(buffer)))\n                    buffer = []\n                cursor += 1\n\n            if balance != 0:\n                raise InvalidInputError(\"Unmatched opening parenthesis at end\")\n            \n            return groups\n\n    class SeparatorService:\n        \"\"\"Orchestrates validation and parsing to separate parenthesis groups.\"\"\"\n        def __init__(self, parser: Parser, validator: callable):\n            self._parser = parser\n            self._validator = validator\n\n        def separate(self, input_str: str) -> List[str]:\n            self._validator(input_str)\n            groups = self._parser.scan(input_str)\n            return [g.content for g in groups]\n\n    parser_instance = Parser()\n    service_instance = SeparatorService(parser_instance, validate_input)\n    return service_instance.separate(paren_string)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/0": [{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    from .controllers import APIController\n    return APIController().has_close_elements(numbers, threshold)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    sorted_numbers = sorted(numbers)\n\n    for i in ran