_NON_NUMERIC_ELEMENT.format(elem=e))\n        return out\nclass NegativePositiveFinderService:\n    \"\"\"Contains the core algorithm to find the largest negative and smallest positive integers.\"\"\"\n    def compute(self, lst: Sequence[int]) -> Result:\n        \"\"\"Scans the list once to find the required values.\"\"\"\n        max_neg = None\n        min_pos = None\n        for x in lst:\n            if x < 0:\n                if max_neg is None or x > max_neg:\n                    max_neg = x\n            elif x > 0:\n                if min_pos is None or x < min_pos:\n                    min_pos = x\n        return Result(max_negative=max_neg, min_positive=min_pos)\ndef largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n\n    Examples:\n    largest_smallest_integers([2, 4, 1, 3, 5, 7]) == (None, 1)\n    largest_smallest_integers([]) == (None, None)\n    largest_smallest_integers([0]) == (None, None)\n    '''\n    validator = InputValidator()\n    normalized = validator.validate_and_normalize(lst)\n    service = NegativePositiveFinderService()\n    result = service.compute(normalized)\n    return result.to_tuple()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n    '''\n    negatives = [n for n in lst if n < 0]\n    positives = [n for n in lst if n > 0]\n\n    largest_neg = max(negatives) if negatives else None\n    smallest_pos = min(positives) if positives else None\n\n    return (largest_neg, smallest_pos)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/137": [{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n    \"\"\"\n\n    def _parse_value(value):\n        \"\"\"\n        Parses a single value (int, float, or str) into its original form and a normalized float.\n        It handles string representations with ',' or '.' as decimal separators.\n        \"\"\"\n        if isinstance(value, (int, float)):\n            return (value, float(value))\n        elif isinstance(value, str):\n            s = value.strip()\n            has_dot = '.' in s\n            has_comma = ',' in s\n\n            # If only a comma is present, assume it's the decimal separator and replace it.\n            # If both are present, or only a dot, `float()` will handle the dot\n            # or raise a ValueError for ambiguous or invalid formats.\n            if has_comma and not has_dot:\n                s = s.replace(',', '.')\n            \n            # For non-numeric string formats, float() will raise a ValueError.\n            # For types other than int, float, or str, float() will raise a TypeError.\n            # These built-in exceptions are allowed to propagate.\n            return (value, float(s))\n        else:\n            # For any other unsupported type, rely on float() to raise a TypeError.\n            return (value, float(value))\n\n    # Parse both inputs into their original form and a normalized float for comparison.\n    parsed_a_original, parsed_a_normalized = _parse_value(a)\n    parsed_b_original, parsed_b_normalized = _parse_value(b)\n\n    # Compare the normalized float values.\n    if parsed_a_normalized > parsed_b_normalized:\n        return parsed_a_original\n    elif parsed_b_normalized > parsed_a_normalized:\n        return parsed_b_original\n    else:  # Values are numerically equal\n        return None", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Compares two values (integers, floats, or strings representing real numbers)\n    and returns the larger value in its original type, or None if they are equal.\n    \"\"\"\n    import re\n    from typing import Any, Union, Optional\n\n    class CompareError(Exception):\n        \"\"\"Base exception for comparison operations.\"\"\"\n        def __init__(self, message: str) -> None:\n            self.message = message\n            super().__init__(self.message)\n\n        def __str__(self) -> str:\n            return self.message\n\n    class CompareParseError(CompareError):\n        \"\"\"Exception raised for errors during parsing of input values.\"\"\"\n        def __init__(self, input_value: Any, message: str) -> None:\n            self.input_value = input_value\n            super().__init__(f\"Failed to parse '{input_value!r}': {message}\")\n\n    class StringUtils:\n        \"\"\"Utility class for string normalization.\"\"\"\n        @staticmethod\n        def normalize_decimal_string(s: str) -> str:\n            s = s.strip()\n            if '.' in s and ',' in s:\n                raise CompareParseError(s, \"Ambiguous decimal separators.\")\n            if ',' in s:\n                s = s.replace(',', '.')\n            return s\n\n    class ValueModel:\n        \"\"\"Represents an input value with its original and parsed numeric form.\"\"\"\n        def __init__(self, original: Any, numeric: float, type_name: str) -> None:\n            self.original: Any = original\n            self.numeric: float = numeric\n            self.type_name: str = type_name\n\n        @staticmethod\n        def from_input(original: Union[int, float, str], numeric: float, type_name: str) -> \"ValueModel\":\n            return ValueModel(original=original, numeric=numeric, type_name=type_name)\n\n        def as_original(self) -> Any:\n            return self.original\n\n    class Converter:\n        \"\"\"Parses various input types into a ValueModel.\"\"\"\n        NUMBER_RE = re.compile(r'^[+-]?\\d+(\\.\\d+)?$')\n\n        def parse(self, value: Union[int, float, str]) -> ValueModel:\n            if isinstance(value, int):\n                return ValueModel.from_input(value, float(value), \"int\")\n            if isinstance(value, float):\n                return ValueModel.from_input(value, float(value), \"float\")\n            if isinstance(value, str):\n                s = value.strip()\n                try:\n                    normalized = StringUtils.normalize_decimal_string(s)\n                except CompareParseError:\n                    raise # Re-raise ambiguous decimal error directly\n                if not self.NUMBER_RE.match(normalized):\n                    raise CompareParseError(value, \"Invalid numeric string format.\")\n                numeric = float(normalized)\n                return ValueModel.from_input(value, numeric, \"str\")\n            raise CompareParseError(value, \"Unsupported type for comparison.\")\n\n    class ComparatorService:\n        \"\"\"Provides the core logic for comparing two values.\"\"\"\n        def __init__(self, converter: Converter = None) -> None:\n            self._converter = converter or Converter()\n\n        def compare(self, a: Union[int,float,str], b: Union[int,float,str]) -> Optional[Union[int,float,str]]:\n            a_vm: ValueModel = self._converter.parse(a)\n            b_vm: ValueModel = self._converter.parse(b)\n            return self._compare_values(a_vm, b_vm)\n\n        def _compare_values(self, a_vm: ValueModel, b_vm: ValueModel) -> Optional[Union[int,float,str]]:\n            if a_vm.numeric > b_vm.numeric:\n                return a_vm.as_original()\n            if b_vm.numeric > a_vm.numeric:\n                return b_vm.as_original()\n            return None\n\n    # Instantiate the service and perform the comparison\n    _service = ComparatorService()\n    return _service.compare(a, b)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["1,45", "1,"]]}], "HumanEval/138": [{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers\n    Example\n    is_equal_to_sum_even(4) == False\n    is_equal_to_sum_even(6) == False\n    is_equal_to_sum_even(8) == True\n    \"\"\"\n    # A number n can be written as the sum of exactly 4 positive even numbers\n    # if n is even and n is at least 8 (the smallest sum: 2+2+2+2).\n    return (n % 2 == 0) and (n >= 8)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers.\"\"\"\n    # A number n can be written as the sum of 4 positive even numbers if and only if n is even and n is at least 8.\n    # The smallest sum of 4 positive even numbers is 2 + 2 + 2 + 2 = 8.\n    # The sum of any four even numbers will always be an even number.\n    return n % 2 == 0 and n >= 8", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/140": [{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Replaces spaces in text: 3+ consecutive spaces become a hyphen, \n    all other spaces become underscores.\n    \"\"\"\n    # First, replace sequences of 3 or more spaces with a single hyphen.\n    processed_text = re.sub(r' {3,}', '-', text)\