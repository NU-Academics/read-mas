s the closest integer to it. If the number is equidistant\n    from two integers, round it away from zero.\n\n    Examples\n    >>> closest_integer(\"10\")\n    10\n    >>> closest_integer(\"15.3\")\n    15\n\n    Note:\n    Rounding away from zero means that if the given number is equidistant\n    from two integers, the one you should return is the one that is the\n    farthest from zero. For example closest_integer(\"14.5\") should\n    return 15 and closest_integer(\"-14.5\") should return -15.\n    '''\n    class InvalidNumberError(ValueError):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class NumberParser:\n        CONTEXT_PREC = 50\n\n        def parse(self, value: str) -> Decimal:\n            s = value.strip()\n            if s == \"\":\n                raise InvalidNumberError(\"empty string\")\n            getcontext().prec = self.CONTEXT_PREC\n            try:\n                return Decimal(s)\n            except (InvalidOperation, ValueError) as exc:\n                raise InvalidNumberError(f\"cannot parse '{value}'\") from exc\n\n    class AwayFromZeroRoundingStrategy:\n        def round(self, d: Decimal) -> int:\n            sign = 1 if d >= 0 else -1\n            abs_d = d.copy_abs()\n            integer_part = int(abs_d // 1)\n            frac = abs_d - Decimal(integer_part)\n            if frac > Decimal(\"0.5\"):\n                integer_part += 1\n            elif frac == Decimal(\"0.5\"):\n                integer_part += 1 # tie -> away from zero\n            return sign * integer_part\n\n    class ClosestIntegerService:\n        def __init__(self, parser: NumberParser, strategy: AwayFromZeroRoundingStrategy) -> None:\n            self._parser = parser\n            self._strategy = strategy\n\n        def closest_integer(self, value: str) -> int:\n            d = self._parser.parse(value)\n            return self._strategy.round(d)\n\n    parser = NumberParser()\n    strategy = AwayFromZeroRoundingStrategy()\n    service = ClosestIntegerService(parser, strategy)\n    return service.closest_integer(value)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["-578000000007654321.12345"]]}, {"task_id": "HumanEval/99", "solution": "from decimal import Decimal, localcontext, InvalidOperation, ROUND_FLOOR\nimport re\ndef closest_integer(value):\n    '''\n    Create a function that takes a value (string) representing a number\n    and returns the closest integer to it. If the number is equidistant\n    from two integers, round it away from zero.\n\n    Examples\n    >>> closest_integer(\"10\")\n    10\n    >>> closest_integer(\"15.3\")\n    15\n\n    Note:\n    Rounding away from zero means that if the given number is equidistant\n    from two integers, the one you should return is the one that is the\n    farthest from zero. For example closest_integer(\"14.5\") should\n    return 15 and closest_integer(\"-14.5\") should return -15.\n    '''\n    # Helper to normalize the input string.\n    def _normalize_str(s: str) -> str:\n        if s is None:\n            return s\n        return s.strip().replace('\\u00A0', ' ')\n\n    # Constants for parsing.\n    DEFAULT_PRECISION = 28\n    _float_regex = re.compile(r'^[+-]?(\\d+(\\.\\d*)?|\\.\\d+)([eE][+-]?\\d+)?$')\n\n    # --- Parsing Logic (adapted from ValueParser) ---\n    if value is None:\n        raise ValueError(\"Input is None\")\n    \n    s = _normalize_str(value)\n    \n    if not s:\n        raise ValueError(\"Input is empty\")\n    \n    if not _float_regex.match(s):\n        raise ValueError(f\"Invalid numeric format: {value!r}\")\n    \n    try:\n        with localcontext() as ctx:\n            ctx.prec = DEFAULT_PRECISION\n            d = Decimal(s)\n    except InvalidOperation as e:\n        raise ValueError(f\"Cannot parse number: {e}\") from e\n    \n    if d.is_nan() or d == Decimal('Infinity') or d == Decimal('-Infinity'):\n        raise ValueError(\"NaN or Infinity not supported\")\n\n    # --- Rounding Logic (adapted from Rounder) ---\n    try:\n        # Determine the floor integer (as a Decimal first for precision).\n        floor_d = d.to_integral_value(rounding=ROUND_FLOOR)\n        floor_i = int(floor_d)\n        \n        # The ceiling integer will be one greater than the floor.\n        ceil_i = floor_i + 1\n\n        # Calculate distances to floor and ceiling using Decimal.\n        dist_floor = abs(d - Decimal(floor_i))\n        dist_ceil = abs(Decimal(ceil_i) - d)\n\n        if dist_floor < dist_ceil:\n            return floor_i\n        if dist_ceil < dist_floor:\n            return ceil_i\n        \n        # Tie-breaking rule: if equidistant, round away from zero.\n        # For positive numbers (e.g., 14.5), choose ceil_i (15).\n        # For negative numbers (e.g., -14.5), choose floor_i (-15).\n        return ceil_i if d >= 0 else floor_i\n    except Exception as e:\n        raise ValueError(f\"Error during rounding: {e}\") from e", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["-578000000007654321.12345"]]}], "HumanEval/100": [{"task_id": "HumanEval/100", "solution": "def make_a_pile(n):\n    \"\"\"\n    Given a positive integer n, you have to make a pile of n levels of stones.\n    The first level has n stones.\n    The number of stones in the next level is:\n        - the next odd number if n is odd.\n        - the next even number if n is even.\n    Return the number of stones in each level in a list, where element at index\n    i represents the number of stones in the level (i+1).\n    \"\"\"\n    return [n + 2 * i for i in range(n)]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/100", "solution": "def make_a_pile(n):\n    \"\"\"\n    Given a positive integer n, you have to make a pile of n levels of stones.\n    The first level has n stones.\n  