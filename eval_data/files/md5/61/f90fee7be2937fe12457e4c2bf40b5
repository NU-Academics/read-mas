.symbol, \"duration\": self.duration}\nclass NoteSymbol(enum.Enum):\n    \"\"\"Canonical mapping of note tokens to their beat durations.\"\"\"\n    WHOLE = (\"o\", 4)\n    HALF = (\"o|\", 2)\n    QUARTER = (\".|\", 1)\n\n    def token(self) -> str:\n        return self.value[0]\n\n    def duration(self) -> int:\n        return self.value[1]\nTOKEN_TO_DURATION: Dict[str, int] = {symbol.token(): symbol.duration() for symbol in NoteSymbol}\nALLOWED_TOKENS: Set[str] = set(TOKEN_TO_DURATION.keys())\nclass NoteFactory:\n    \"\"\"Creates Note objects from token strings.\"\"\"\n    def create_note(self, token: str) -> Note:\n        if token not in TOKEN_TO_DURATION:\n            # The design context says to raise InvalidMusicStringError here.\n            raise InvalidMusicStringError(f\"Unknown token: '{token}'\", [(None, token)])\n        duration = TOKEN_TO_DURATION[token]\n        return Note(symbol=token, duration=duration)\nclass InputValidator:\n    \"\"\"Validates raw input strings and tokens.\"\"\"\n    def tokenize(self, music_string: str) -> List[str]:\n        # Per strict requirement: \"DO NOT add isinstance() checks or raise exceptions for edge cases\"\n        # The design context originally had a TypeError check, but omitting due to explicit instruction.\n        tokens = music_string.split()\n        return tokens\n\n    def find_invalid_tokens(self, tokens: List[str]) -> List[Tuple[int, str]]:\n        return [(i, t) for i, t in enumerate(tokens) if t not in ALLOWED_TOKENS]\n\n    def validate_string(self, music_string: str) -> None:\n        tokens = self.tokenize(music_string)\n        invalids = self.find_invalid_tokens(tokens)\n        if invalids:\n            # The design context requires this specific error for invalid tokens.\n            error_msg = f\"Invalid tokens found: {[t for i,t in invalids]}\"\n            raise InvalidMusicStringError(error_msg, invalids)\nclass NoteSequence:\n    \"\"\"Container for Note objects, providing convenience for extracting durations.\"\"\"\n    def __init__(self, notes: List[Note]) -> None:\n        self._notes = notes\n\n    def durations(self) -> List[int]:\n        return [n.duration for n in self._notes]\nclass MusicParser:\n    \"\"\"Orchestrates parsing: tokenization, validation, note creation, sequence creation.\"\"\"\n    def __init__(self, validator: InputValidator = None, factory: NoteFactory = None) -> None:\n        self.validator = validator if validator is not None else InputValidator()\n        self.factory = factory if factory is not None else NoteFactory()\n\n    def parse(self, music_string: str) -> NoteSequence:\n        self.validator.validate_string(music_string) # This will raise InvalidMusicStringError if issues\n        tokens = self.validator.tokenize(music_string)\n        \n        notes = []\n        for token in tokens:\n            note = self.factory.create_note(token)\n            notes.append(note)\n        \n        return NoteSequence(notes)\n\n    def parse_to_durations(self, music_string: str) -> List[int]:\n        note_sequence = self.parse(music_string)\n        return note_sequence.durations()\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\"Parses a string representing musical notes and returns a list of their beat durations.\n\n    Each note symbol ('o', 'o|', '.|') is mapped to its corresponding beat duration.\n    \"\"\"\n    parser = MusicParser()\n    return parser.parse_to_durations(music_string)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/17", "solution": "def parse_music(music_string: str) -> List[int]:\n    \"\"\" Input to this function is a string representing musical notes in a special ASCII format.\n    Your task is to parse this string and return list of integers corresponding to how many beats does each\n    not last.\n    \"\"\"\n    \n    # Define the mapping of musical note symbols to their beat durations.\n    # This information comes directly from the problem description's legend.\n    TOKEN_BEATS = {\n        'o': 4,   # whole note\n        'o|': 2,  # half note\n        '.|': 1   # quarter note\n    }\n\n    # Split the input string into individual tokens.\n    # .strip() handles leading/trailing whitespace, and .split() handles multiple spaces\n    # and returns an empty list for an empty or purely whitespace string,\n    # which correctly results in an empty beat list.\n    tokens = music_string.strip().split()\n\n    beats = []\n    for token in tokens:\n        # Look up the beat duration for the current token.\n        # As per the design context and constraints, we assume valid tokens\n        # and do not add error handling for unknown tokens within this direct implementation.\n        beats.append(TOKEN_BEATS[token])\n        \n    return beats", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/19": [{"task_id": "HumanEval/19", "solution": "def sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n\n    WORD_TO_VALUE = {\n        'zero': 0, 'one': 1, 'two': 2, 'three': 3, 'four': 4,\n        'five': 5, 'six': 6, 'seven': 7, 'eight': 8, 'nine': 9\n    }\n    VALUE_TO_WORD = {v: k for k, v in WORD_TO_VALUE.items()}\n    ALLOWED_WORDS = set(WORD_TO_VALUE.keys())\n\n    class InvalidNumberWordError(Exception):\n        \"\"\"Custom exception for invalid number words.\"\"\"\n        def __init__(self, invalid_tokens: List[str]):\n            super().__init__(f\"Invalid number words found: {', '.join(invalid_tokens)}\")\n            self.invalid_tokens = invalid_tokens\n\n    class MappingError(Exception):\n        \"\"\"