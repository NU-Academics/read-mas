     rows = len(matrix)\n        cols = len(matrix[0])\n        return rows == cols and all(len(row) == cols for row in matrix)\n\n    @staticmethod\n    def flatten(matrix: List[List[int]]) -> List[int]:\n        \"\"\"Flattens a 2D matrix into a 1D list.\"\"\"\n        return [item for sublist in matrix for item in sublist]\n\n    @staticmethod\n    def is_permutation_of_range(matrix: List[List[int]]) -> bool:\n        \"\"\"Checks if matrix values are a permutation of 1 to N*N.\"\"\"\n        if not matrix or not Utils.is_square_matrix(matrix):\n            return False\n        \n        N = len(matrix)\n        expected_size = N * N\n        flat_values = Utils.flatten(matrix)\n\n        if len(flat_values) != expected_size:\n            return False\n\n        seen = collections.Counter(flat_values)\n        if len(seen) != expected_size: # Not unique or missing values\n            return False\n        \n        for i in range(1, expected_size + 1):\n            if seen[i] != 1:\n                return False\n        return True\nclass Grid:\n    \"\"\"Represents an N x N grid, providing fast lookups and neighbor queries.\"\"\"\n    def __init__(self, matrix: List[List[int]]) -> None:\n        self._matrix = matrix\n        self._rows = len(matrix)\n        self._cols = len(matrix[0]) if matrix else 0\n        self._value_to_coord = {}\n        self.validate()\n        for r in range(self._rows):\n            for c in range(self._cols):\n                v = matrix[r][c]\n                self._value_to_coord[v] = (r, c)\n\n    def get_value(self, row: int, col: int) -> int:\n        \"\"\"Returns the value at specified coordinates.\"\"\"\n        if not (0 <= row < self._rows and 0 <= col < self._cols):\n            raise MinPathError(f\"Coordinates ({row}, {col}) are out of grid bounds.\")\n        return self._matrix[row][col]\n\n    def get_coords(self, value: int) -> tuple[int, int]:\n        \"\"\"Returns the coordinates of a given value.\"\"\"\n        i