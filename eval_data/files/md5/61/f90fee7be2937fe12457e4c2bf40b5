_s1", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/55": [{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\"\"\"\n    if n == 0:\n        return 0\n    a, b = 0, 1\n    for _ in range(1, n):\n        a, b = b, a + b\n    return b", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/55", "solution": "def fib(n: int, _service=None):\n    \"\"\"Return n-th Fibonacci number.\n    This function computes the n-th Fibonacci number, using an internal service with caching.\n    \"\"\"\n    import time\n    from abc import ABC, abstractmethod\n    from typing import Any, Dict, Optional, Tuple\n    import threading\n\n    class InvalidInputError(Exception):\n        def __init__(self, message: str):\n            super().__init__(message)\n\n    class ConfigurationError(Exception):\n        def __init__(self, message: str):\n            super().__init__(message)\n\n    class _Config:\n        MAX_N: int = 10_000_000\n        DEFAULT_ALGORITHM: str = \"fast_doubling\"\n\n    class _Utils:\n        @staticmethod\n        def validate_n(n_val: Any, max_n: int = _Config.MAX_N) -> int:\n            if not isinstance(n_val, int):\n                raise InvalidInputError(\"Input 'n' must be an integer.\")\n            if n_val < 0:\n                raise InvalidInputError(\"Input 'n' cannot be negative.\")\n            if n_val > max_n:\n                raise InvalidInputError(f\"Input 'n' exceeds maximum allowed value of {max_n}.\")\n            return n_val\n\n    class FibonacciResult:\n        def __init__(self, n_val: int, value: int, algorithm: str, cached: bool, timestamp: Optional[float] = None):\n            self.n = n_val\n            self.value = value\n            self.algorithm = algorithm\n            self.cached = cached\n            self.timestamp = timestamp if timestamp is not None else time.time()\n\n    class Algorithm(ABC):\n        @abstractmethod\n        def compute(self, n_val: int) -> int:\n            pass\n\n    class FastDoublingAlgorithm(Algorithm):\n        def _fast_doubling(self, n_val: int) -> Tuple[int, int]:\n            if n_val == 0:\n                return 0, 1\n            a, b = self._fast_doubling(n_val >> 1)\n            c = a * (2 * b - a)\n            d = a * a + b * b\n            if n_val & 1:\n                return d, c + d\n            return c, d\n\n        def compute(self, n_val: int) -> int:\n            return self._fast_doubling(n_val)[0]\n\n    class CacheRepository(ABC):\n        @abstractmethod\n        def get(self, n_val: int) -> Optional[int]:\n            pass\n\n        @abstractmethod\n        def set(self, n_val: int, value: int) -> None:\n            pass\n\n        @abstractmethod\n        def clear(self) -> None:\n            pass\n\n    class InMemoryCacheRepository(CacheRepository):\n        def __init__(self):\n            self._store: Dict[int, int] = {}\n            self._lock = threading.Lock()\n\n        def get(self, n_val: int) -> Optional[int]:\n            with self._lock:\n                return self._store.get(n_val)\n\n        def set(self, n_val: int, value: int) -> None:\n            with self._lock:\n                self._store[n_val] = value\n\n        def clear(self) -> None:\n            with self._lock:\n                self._store.clear()\n\n    class FibonacciService:\n        def __init__(self, cache: CacheRepository, algorithms: Optional[Dict[str, Algorithm]] = None, default_algorithm: str = _Config.DEFAULT_ALGORITHM):\n            self.cache = cache\n            self.algorithms: Dict[str, Algorithm] = algorithms if algorithms is not None else {}\n            self.default_algorithm = default_algorithm\n            if not self.algorithms:\n                self.register_algorithm(_Config.DEFAULT_ALGORITHM, FastDoublingAlgorithm())\n\n        def register_algorithm(self, name: str, algo: Algorithm) -> None:\n            self.algorithms[name] = algo\n\n        def compute(self, n_val: int, algorithm: Optional[str] = None) -> FibonacciResult:\n            n_val = _Utils.validate_n(n_val)\n            algo_name = algorithm or self.default_algorithm\n\n            if algo_name not in self.algorithms:\n                raise ConfigurationError(f\"Algorithm '{algo_name}' not registered\")\n\n            cached = self.cache.get(n_val)\n            if cached is not None:\n                return FibonacciResult(n_val=n_val, value=cached, algorithm=algo_name, cached=True)\n\n            value = self.algorithms[algo_name].compute(n_val)\n            self.cache.set(n_val, value)\n            return FibonacciResult(n_val=n_val, value=value, algorithm=algo_name, cached=False)\n\n    if _service is None:\n        _service = FibonacciService(cache=InMemoryCacheRepository())\n        fib.__defaults__ = (_service,)\n\n    result = _service.compute(n)\n    return result.value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/56": [{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    counter = 0\n    for char in brackets:\n        if char == \"<\":\n            counter += 1\n        else: # char == \">\"\n            counter -= 1\n            if counter < 0:\n                return False\n    return counter == 0", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char =