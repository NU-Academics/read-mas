f._parser.parse(input_str)\n            sorted_tokens = self._sorter.sort(tokens)\n            output_str = self._formatter.format(sorted_tokens)\n            return output_str\n\n    # Instantiate the core components\n    parser = Parser()\n    sorter = Sorter()\n    formatter = Formatter()\n    \n    # Create the controller to orchestrate the process\n    controller = SortController(parser, sorter, formatter)\n    \n    # Execute the sorting pipeline\n    return controller.sort_input(numbers)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[""]], "plus_fail_tests": [["four eight two"]]}, {"task_id": "HumanEval/19", "solution": "from typing import List, Dict, Set, Optional\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    \"\"\"\n\n    # --- Emulating src/numsort/numberword.py ---\n    # These internal components are defined within the function scope to satisfy the \"inline helper\" constraint.\n    WORD_TO_INT: Dict[str, int] = {\n        \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n        \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9,\n    }\n\n    def to_int(word: str) -> int:\n        \"\"\"Converts a number word to its integer value.\"\"\"\n        return WORD_TO_INT[word]\n\n    # --- Emulating src/numsort/exceptions.py ---\n    class InvalidTokenError(ValueError):\n        \"\"\"Raised when invalid number words are found.\"\"\"\n        def __init__(self, invalid_tokens: List[str]) -> None:\n            super().__init__(f\"Invalid tokens found: {', '.join(invalid_tokens)}\")\n            self.invalid_tokens = invalid_tokens\n\n    class ParseError(Exception):\n        \"\"\"Raised for general parsing or mapping errors.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class SortError(Exception):\n        \"\"\"Raised for unexpected errors during sorting.\"\"\"\n        def __init__(self, message: str, cause: Optional[Exception] = None) -> None:\n            super().__init__(message)\n            self.message = message\n            self.cause = cause\n\n    # --- Emulating src/numsort/utils.py ---\n    def normalize_token(token: str) -> str:\n        \"\"\"Trims whitespace and converts a token to lower case.\"\"\"\n        return token.strip().lower()\n\n    # --- Emulating src/numsort/formatter.py ---\n    class Formatter:\n        \"\"\"Formats a list of tokens into a space-delimited string.\"\"\"\n        def format(self, tokens: List[str]) -> str:\n            return \" \".join(tokens)\n\n    # --- Emulating src/numsort/parser.py ---\n    class Parser:\n        \"\"\"Parses an input string into tokens and validates them.\"\"\"\n        def __init__(self, allowed_words: Optional[Set[str]] = None) -> None:\n            self.allowed_words = set(allowed_words or WORD_TO_INT.keys())\n\n        def parse(self, input_str: str) -> List[str]:\n            \"\"\"Splits and normalizes the input string into a list of tokens.\"\"\"\n            tokens = [normalize_token(t) for t in input_str.split() if t.strip()]\n            self.validate(tokens)\n            return tokens\n\n        def validate(self, tokens: List[str]) -> None:\n            \"\"\"Validates that all tokens are among the allowed number words.\"\"\"\n            invalid = [t for t in tokens if t not in self.allowed_words]\n            if invalid:\n                raise InvalidTokenError(invalid)\n\n    # --- Emulating src/numsort/sorter.py ---\n    class SortService:\n        \"\"\"Maps tokens to integers and performs a stable sort.\"\"\"\n        def sort_tokens(self, tokens: List[str]) -> List[str]:\n            \"\"\"Sorts tokens based on their numeric value, preserving stable order.\"\"\"\n            try:\n                # Create a list of tuples: (numeric_value, original_index, token_word)\n                indexed_tokens = [(to_int(token), i, token) for i, token in enumerate(tokens)]\n            except KeyError as e:\n                # This should ideally not be hit if Parser.validate works correctly.\n                raise ParseError(f\"Unexpected token encountered during mapping: '{e}'\") from e\n\n            try:\n                # Sort primarily by numeric_value, secondarily by original_index for stability\n                indexed_tokens.sort(key=lambda x: (x[0], x[1]))\n                # Extract the original token words in sorted order\n                return [token_word for (_, _, token_word) in indexed_tokens]\n            except Exception as e:\n                raise SortError(\"An unexpected error occurred during sorting.\", cause=e)\n\n    # --- Emulating src/numsort/controller.py ---\n    class CLIController:\n        \"\"\"Orchestrates parsing, sorting, and formatting of number word strings.\"\"\"\n        def __init__(self, parser: Parser, sorter: SortService, formatter: Formatter):\n            self.parser = parser\n            self.sorter = sorter\n            self.formatter = formatter\n\n        def sort_numbers(self, input_str: str) -> str:\n            \"\"\"Parses, sorts, and formats number words from an input string.\"\"\"\n            tokens = self.parser.parse(input_str)\n            sorted_tokens = self.sorter.sort_tokens(tokens)\n            return self.formatter.format(sorted_tokens)\n\n    # Main logic for the sort_numbers function:\n    # Instantiate the core components with default configurations.\n    parser_instance = Parser()\n    sorter_instance = SortService()\n    formatter_instance = Formatter()\n\n    # Orchestrate the process using the CLIController pattern.\n    controller_instance = CLIController(parser_instance, sorter_instance, formatter_instance)\n    return controller_instance.sort_numbers(numbers)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tes