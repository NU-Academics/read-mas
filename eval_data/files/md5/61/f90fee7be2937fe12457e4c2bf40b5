uivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    # The mapping of integer values to Roman numerals, ordered from largest to smallest.\n    roman_map = [\n        (1000, \"M\"), (900, \"CM\"), (500, \"D\"), (400, \"CD\"),\n        (100, \"C\"), (90, \"XC\"), (50, \"L\"), (40, \"XL\"),\n        (10, \"X\"), (9, \"IX\"), (5, \"V\"), (4, \"IV\"), (1, \"I\")\n    ]\n\n    result_parts = []\n    num_to_convert = number\n\n    for value, symbol in roman_map:\n        while num_to_convert >= value:\n            result_parts.append(symbol)\n            num_to_convert -= value\n        if num_to_convert == 0:\n            break\n            \n    return \"\".join(result_parts).lower()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    roman_map = [\n        (1000, \"M\"), (900, \"CM\"), (500, \"D\"), (400, \"CD\"),\n        (100, \"C\"), (90, \"XC\"), (50, \"L\"), (40, \"XL\"),\n        (10, \"X\"), (9, \"IX\"), (5, \"V\"), (4, \"IV\"), (1, \"I\"),\n    ]\n\n    result_parts = []\n    num = number\n\n    for value, symbol in roman_map:\n        while num >= value:\n            result_parts.append(symbol)\n            num -= value\n        if num == 0:\n            break\n\n    return \"\".join(result_parts).lower()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/158": [{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n\n    find_max([\"name\", \"of\", \"string\"]) == \"string\"\n    find_max([\"name\", \"enam\", \"game\"]) == \"enam\"\n    find_max([\"aaaaaaa\", \"bb\" ,\"cc\"]) == \"\"aaaaaaa\"\n    \"\"\"\n    if not words:\n        return \"\"\n\n    # (unique_count, word) tuples for comparison\n    # unique_count is negated to make `max` select the highest count first\n    # when `word` is the second element, `max` will then use lexicographical order for ties (string comparison)\n    # The requirement is \"return the one which comes first in lexicographical order\", which means the smallest string.\n    # Python's `max` will pick the largest string for a tie.\n    # So, we need to sort candidates explicitly or use min with a key that ensures lexicographical priority.\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        unique_chars = len(set(word))\n        if unique_chars > max_unique_count:\n            max_unique_count = unique_chars\n            result_word = word\n        elif unique_chars == max_unique_count:\n            # Tie-breaking: return the one which comes first in lexicographical order\n            if word < result_word:\n                result_word = word\n\n    return result_word", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    # The key for max function will prioritize unique character count (descending)\n    # and then lexicographical order (ascending) for tie-breaking.\n    # We use -len(set(word)) to sort unique counts in descending order,\n    # and 'word' itself for ascending lexicographical order.\n    best_word = max(words, key=lambda word: (-len(set(word)), word))\n\n    return best_word", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[["name", "of", "string"]]], "plus_fail_tests": [[["abcdefg", "hijklmnop", "qrstuvwxyz"]]]}], "HumanEval/157": [{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    \n    # Sides must be positive.\n    if a <= 0 or b <= 0 or c <= 0:\n        return False\n\n    # Sort sides to identify potential hypotenuse (h) and shorter sides (x, y).\n    sides = sorted([a, b, c])\n    x, y, h = sides[0], sides[1], sides[2]\n\n    # Check triangle inequality: the sum of the lengths of any two sides must be greater than the third.\n    # For sorted sides, this simplifies to x + y > h. Degenerate triangles (x + y == h) are considered invalid.\n    if x + y <= h:\n        return False\n\n    # Apply Pythagorean theorem with a tolerance for floating-point comparisons.\n    # The tolerance is set to 1e-9, as suggested by the design context.\n    tolerance = 1e-9\n    \n    h_squared = h * h\n    sum_of_squares_of_others = (x * x) + (y * y)\n\n    # Use a robust floating-point comparison, `is_close` logic from design.\n    return abs(h_squared - sum_of_squares_of_others) <= tolerance * max(1.0, abs(h_squared), abs(sum_of_squares_of_others))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Re