            -> reverse arr -> [8, 5, 4, 3, 2, 2, 1, 1]\n      return [\"Eight\", \"Five\", \"Four\", \"Three\", \"Two\", \"Two\", \"One\", \"One\"]\n    \n      If the array is empty, return an empty array:\n      arr = []\n      return []\n    \n      If the array has any strange number ignore it:\n      arr = [1, -1 , 55] \n            -> sort arr -> [-1, 1, 55]\n            -> reverse arr -> [55, 1, -1]\n      return = ['One']\n    \"\"\"\n    NUMBER_NAME_MAP = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n    VALID_RANGE_MIN = 1\n    VALID_RANGE_MAX = 9\n\n    def is_int(value):\n        return isinstance(value, int) and not isinstance(value, bool)\n\n    def in_valid_range(n):\n        return VALID_RANGE_MIN <= n <= VALID_RANGE_MAX\n\n    if arr is None:\n        return []\n\n    filtered_values = []\n    for v in arr:\n        if is_int(v) and in_valid_range(v):\n            filtered_values.append(v)\n\n    sorted_vals = sorted(filtered_values)\n    sorted_vals.reverse()\n\n    result_names = []\n    for v in sorted_vals:\n        name = NUMBER_NAME_MAP.get(v)\n        if name:\n            result_names.append(name)\n            \n    return result_names", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Sorts integers between 1 and 9, reverses them, and replaces each digit with its English name.\n    Ignores numbers outside the 1-9 range.\n    \"\"\"\n    \n    # Define the mapping for digits to names\n    name_map = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    # 1. Filter: Keep only integers between 1 and 9 inclusive.\n    # The design context indicates \"If the array has any strange number ignore it\".\n    # This implies non-integer types might be present, but the example `[1, -1, 55]`\n    # only shows integers. The requirement summary states \"Non-integer or non-iterable input -> service raises TypeError\".\n    # However, the direct function stub completion does not require explicit type checking or raising.\n    # We will assume `arr` contains elements that can be checked for integer type and value.\n    filtered_arr = []\n    for x in arr:\n        # Check if x is an integer and within the valid range [1, 9]\n        if isinstance(x, int) and 1 <= x <= 9:\n            filtered_arr.append(x)\n\n    # 2. Sort: Sort the filtered integers in ascending order.\n    filtered_arr.sort()\n\n    # 3. Reverse: Reverse the resulting array.\n    filtered_arr.reverse()\n\n    # 4. Map: Replace each digit by its corresponding name.\n    result_arr = [name_map[x] for x in filtered_arr]\n\n    return result_arr", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/106": [{"task_id": "HumanEval/106", "solution": "def f(n):\n    \"\"\"\n    Returns a list of size n, where elements are factorial of i if i is even,\n    or the sum of numbers from 1 to i if i is odd (i starts from 1).\n    \"\"\"\n    results = []\n    current_factorial_val = 1\n\n    for i in range(1, n + 1):\n        # Update current_factorial_val to hold i! for the current iteration\n        current_factorial_val *= i\n\n        if i % 2 == 0:  # i is even\n            results.append(current_factorial_val)\n        else:  # i is odd\n            sum_to_i = i * (i + 1) // 2\n            results.append(sum_to_i)\n\n    return results", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/106", "solution": "from typing import List, Optional, Any, Tuple\nclass InvalidParameterError(Exception):\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        return self.message\nclass FactorialCalculator:\n    DEFAULT_START: int = 1\n\n    def calculate(self, i: int) -> int:\n        if i < 1:\n            raise InvalidParameterError(f\"i must be >=1, got {i}\")\n        result = 1\n        for k in range(1, i + 1):\n            result *= k\n        return result\n\n    def calculate_incremental(self, i: int, prev: Optional[int]) -> int:\n        if i < 1:\n            raise InvalidParameterError(f\"i must be >=1, got {i}\")\n        if prev is None:\n            return self.calculate(i)\n        return prev * i\nclass SummationCalculator:\n    def calculate(self, i: int) -> int:\n        if i < 1:\n            raise InvalidParameterError(f\"i must be >=1, got {i}\")\n        return self.formula(i)\n\n    def formula(self, i: int) -> int:\n        return i * (i + 1) // 2\nclass InputValidator:\n    def validate_n(self, value: Any) -> int:\n        try:\n            n = int(value)\n            # Ensure that float(value) doesn't lose precision for non-integers, e.g., \"5.0\" is fine, \"5.5\" is not.\n            if float(value) != n:\n                raise ValueError\n        except (ValueError, TypeError):\n            raise InvalidParameterError(f\"Input must be an integer or numeric string representing an integer, got '{value}'\")\n        if n < 1:\n            raise InvalidParameterError(f\"n must be a positive integer (>=1), got {n}\")\n        return n\nclass SeriesService:\n    def __init__(self,\n                 factorial: Optional[FactorialCalculator] = None,\n                 summation: Optional[SummationCalculator] = None,\n                 validator: Optional[InputValidator] = None):\n        self.factorial_calculator = factorial or FactorialCalculator()\n        self.summation_calculator = summation or SummationCalculator()\n        self.validator = validator or InputValidator()\n\n    def generate_series(self, n: int) -> List[int]:\n        n = self.validator.validate_n(n)\n        series: List[int] = []\n        current_factorial: int = 1 # Stores factorial(i-1) before each iteration, then becomes factorial(i).\n\n        for i in range(1, n + 1):\n            # Update current_factorial to factorial(i) for the current iteration.\n            current_factorial *= i\n\n            if i % 2 == 0:\n                # Even index: value is factorial(i)\n                val = current_factorial\n            else:\n                # Odd index: value is sum of numbers from 1 to i\n                val = self.summation_calculator.calculate(i)\n            series.append(val)\n        return series\ndef f(n):\n    \"\"\" Implement the function f that takes n as a parameter,\n    and returns a list of size n, such that the value of the element at index i is the factorial of i if i is even\n    or the sum of numbers from 1 to i otherwise.\n    i starts from 1.\n    \"\"\"\n    return SeriesService().generate_series(n)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[0]]}], "HumanEval/107": [{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n    def _is_palindrome(num):\n        \"\"\"Checks if a given integer is a palindrome.\"\"\"\n        s = str(num)\n        return s == s[::-1]\n\n    even_count = 0\n    odd_count = 0\n\n    for i in range(1, n + 1):\n        if _is_palindrome(i):\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n\n    return (even_count, odd_count)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n    even_palindromes = 0\n    odd_palindromes = 0\n\n    for i in range(1, n + 1):\n        # Check if the number is a palindrome by converting it to a string\n        s = str(i)\n        if s == s[::-1]:\n            # If it's a palindrome, check its parity\n            if i % 2 == 0:\n                even_palindromes += 1\n            else:\n                odd_palindromes += 1\n                \n    return (even_palindromes, odd_palindromes)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/108": [{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Counts elements in an array where the sum of signed digits is greater than 0.\n    Handles negative numbers by making the first digit negative.\n    \"\"\"\n    def sum_signed_digits(n):\n        s = str(abs(n))\n        digits = [int(ch) for ch in s]\n        if n < 0:\n            if digits:  # Ensure digits list is not empty for numbers like 0\n                digits[0] = -digits[0]\n        return sum(digits)\n\n    count = 0\n    for num in arr:\n        if sum_signed_digits(num) > 0:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/108", "solution": "import datetime\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    pass\nclass DigitExtractor:\n    \"\"\"Utility to extract signed digits and their sum from an integer.\"\"\"\n    def _extract_abs_digits(self, n: int) -> list[int]:\n        # Helper to extract absolute digits in order.\n        if n == 0:\n            return [0]\n        digits = []\n        temp_n = n\n        while temp_n > 0:\n            digits.append(temp_n % 10)\n            temp_n //= 10\n        return digits[::-1]\n\n    def signed_digits(self, n: int) -> list[int]:\n        # Returns list of digits where the most significant digit is negative if n < 0.\n        if not isinstance(n, int):\n            raise TypeError(\"n must be an integer.\")\n        if n == 0:\n            return [0]\n        \n        sign = -1 if n < 0 else 1\n        abs_val = abs(n)\n        \n        abs_digits = self._extract_abs_digits(abs_val)\n        \n        if abs_digits:\n            abs_digits[0] *= sign\n        \n        return abs_digits\n\n    def sum_signed_digits(self, n: int) -> int:\n        # Returns sum of signed_digits(n).\n        return sum(self.signed_digits(n))\nclass CountRequest:\n    \"\"\"DTO to carry a list of integers into the service.\"\"\"\n    def __init__(self, numbers: list[int]) -> None:\n        self.numbers = numbers\nclass CountResult:\n    \"\"\"DTO for the service result.\"\"\"\n    def __init__(self, count: int, input_size: int, timestamp: datetime.datetime | None = None) -> None:\n        self.count = count\n        self.input_size = input_size\n        self.timestamp = timestamp if timestamp is not None else datetime.datetime.now(datetime.timezone.utc)\nclass Repository:\n    \"\"\"Abstract base for repository interfaces.\"\"\"\n    def save(self, request: CountRequest, result: CountResult) -> None:\n        raise NotImplementedError\nclass CountService:\n    \"\"\"Core counting logic; validates input, uses DigitExtractor, optionally persists.\"\"\"\n    def __init__(self, extractor: DigitExtractor, repo: Repository | None = None) -> None:\n        self._extractor = extractor\n        self._repo = repo\n\n    def _validate(self, request: CountRequest) -> None:\n        # Validates request.numbers is list-like and contents are integers.\n        if not isinstance(request.numbers, (list, tuple)):\n            raise InvalidInputError(\"Input must be a list or tuple of integers.\")\n        for i, n in enumerate(request.numbers):\n            if not isinstance(n, int):\n                raise InvalidInputError(f\"Element at index {i} is not an integer: {type(n).__name__}\")\n\n    def count(self, request: CountRequest) -> CountResult:\n        # Validates request, computes count as per rules, and returns CountResult.\n        self._validate(request)\n        \n        cnt = 0\n        for n in request.numbers:\n            s = self._extractor.sum_signed_digits(n)\n            if s > 0:\n                cnt += 1\n        \n        result = CountResult(count=cnt, input_size=len(request.numbers))\n        \n        if self._repo:\n            self._repo.save(request, result)\n            \n        return result\nclass CountController:\n    \"\"\"Orchestrates validation, DTO mapping, and service invocation.\"\"\"\n    def __init__(self, service: CountService) -> None:\n        self._service = service\n\n    def count(self, nums: list[int]) -> int:\n        # Validates input types, creates CountRequest, calls service.count, returns result.count.\n        if not isinstance(nums, (list, tuple)):\n            raise InvalidInputError(\"Input 'arr' must be a list or tuple.\")\n\n        request = CountRequest(numbers=nums)\n        result = self._service.count(request)\n        return result.count\ndef count_nums(arr):\n    \"\"\"\n    Write a function count_nums which takes an array of integers and returns\n    the number of elements which has a sum of digits > 0.\n    If a number is negative, then its first signed digit will be negative:\n    e.g. -123 has signed digits -1, 2, and 3.\n    >>> count_nums([]) == 0\n    >>> count_nums([-1, 11, -11]) == 1\n    >>> count_nums([1, 1, 2]) == 3\n    \"\"\"\n    extractor = DigitExtractor()\n    service = CountService(extractor)\n    controller = CountController(service)\n    return controller.count(arr)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/109": [{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"We have an array 'arr' of N integers arr[1], arr[2], ..., arr[N].The\n    numbers in the array will 