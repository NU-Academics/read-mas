{"task_id": "Mbpp/732", "solution": "def replace_specialchar(s: str) -> str:\n    \"\"\"\n    Replaces all occurrences of spaces, commas, or dots in the input string with a colon.\n    This function processes the string in a single pass for efficiency.\n    \"\"\"\n    targets = frozenset({' ', ',', '.'})\n    replacement = ':'\n    result_parts = []\n    for char in s:\n        if char in targets:\n            result_parts.append(replacement)\n        else:\n            result_parts.append(char)\n    return ''.join(result_parts)"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(sequence):\n    \"\"\"\n    Removes consecutive duplicate elements from a list.\n    Preserves the order of unique elements.\n    \"\"\"\n    if not sequence:\n        return []\n\n    result = [sequence[0]]\n    for item in sequence[1:]:\n        if item != result[-1]:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(n: int) -> int:\n    \"\"\"\n    Toggles all bits of the number except the first (MSB) and the last (LSB) bit.\n    For numbers with 2 or fewer bits, no middle bits exist, so the number is returned unchanged.\n    \"\"\"\n    # Validate input\n    if not isinstance(n, int):\n        raise TypeError(f\"Expected int, got {type(n).__name__}\")\n    if n < 0:\n        raise ValueError(\"Expected non-negative integer\")\n\n    # Calculate the bit length of n, treating 0 as having a bit length of 1.\n    bitlen = n.bit_length()\n    if bitlen == 0:  # Handle the special case for n=0\n        bitlen = 1\n\n    # If there are 2 or fewer bits, there are no 'middle' bits to toggle.\n    if bitlen <= 2:\n        return n\n\n    # Calculate the width of the middle section (number of bits to toggle).\n    # This is total_bit_length - MSB - LSB.\n    width = bitlen - 2\n\n    # Create a mask with 'width' number of 1s, shifted left by 1 to skip the LSB.\n    # E.g., if width=2, (1 << 2) - 1 gives 0b11. Shifting left by 1 gives 0b110.\n    mask = ((1 << width) - 1) << 1\n\n    # XOR the number with the mask to toggle the middle bits.\n    return n ^ mask"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sequence, value):\n    \"\"\"Locate the left insertion point for a specified value in sorted order using binary search.\"\"\"\n    lo = 0\n    hi = len(sequence)\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if sequence[mid] < value:\n            lo = mid + 1\n        else:\n            hi = mid\n    return lo"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(nums, target):\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array using binary search.\n    Returns -1 if the target is not found.\n    \"\"\"\n    lo, hi = 0, len(nums) - 1\n    result = -1\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        if nums[mid] == target:\n            result = mid\n            hi = mid - 1  # Try to find an earlier occurrence in the left half\n        elif nums[mid] < target:\n            lo = mid + 1\n        else:  # nums[mid] > target\n            hi = mid - 1\n    return result"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(nums):\n    \"\"\"\n    Calculates the sum of products of all contiguous subarrays in the given list.\n    The approach uses dynamic programming to efficiently accumulate products.\n    \"\"\"\n    total_sum_of_products = 0\n    # prev_products stores the products of all subarrays ending at the previous element.\n    prev_products = []\n\n    for x in nums:\n        # new_products will store products of all subarrays ending at the current element x.\n        # It includes x itself, and x multiplied by each product in prev_products.\n        new_products = [x] + [p * x for p in prev_products]\n\n        # Add the sum of these new products to the total.\n        total_sum_of_products += sum(new_products)\n\n        # Update prev_products for the next iteration.\n        prev_products = new_products\n\n    return total_sum_of_products"}
{"task_id": "Mbpp/737", "solution": "import re\nimport os\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input types or values.\"\"\"\n    pass\nclass CheckerError(Exception):\n    \"\"\"Custom exception for internal checker errors, like invalid regex.\"\"\"\n    pass\nclass RegexValidator:\n    \"\"\"Encapsulates regex compilation and matching logic.\"\"\"\n    def __init__(self, pattern: str) -> None:\n        try:\n            self.pattern = pattern\n            self._compiled = re.compile(pattern)\n        except re.error as e:\n            raise CheckerError(f\"Invalid regex pattern: {e}\")\n\n    def matches(self, s: str) -> bool:\n        \"\"\"Returns True if the compiled pattern matches at the start of the string.\"\"\"\n        return bool(self._compiled.match(s))\nclass StringInput:\n    \"\"\"DTO to wrap a raw string and provide normalization.\"\"\"\n    def __init__(self, raw: str) -> None:\n        self._raw = raw\n\n    def normalized(self) -> str:\n        \"\"\"Returns the string with only leading whitespace stripped.\"\"\"\n        return self._raw.lstrip()\nclass VowelChecker:\n    \"\"\"Business logic to check if a string starts with a vowel, orchestrating normalization and validation.\"\"\"\n    def __init__(self, validator: RegexValidator) -> None:\n        self._validator = validator\n\n    def check(self, s: str) -> bool:\n        \"\"\"Checks if the given string starts with a vowel after normalization.\"\"\"\n        normalized = StringInput(s).normalized()\n        if not normalized:\n            return False\n        return self._validator.matches(normalized)\nDEFAULT_VOWEL_REGEX = r'^[aeiouAEIOU]'\nENV_VOWEL_REGEX = 'VOWEL_REGEX'\ndef get_vowel_regex() -> str:\n    \"\"\"Retrieves the vowel regex pattern from environment or uses default.\"\"\"\n    return os.getenv(ENV_VOWEL_REGEX, DEFAULT_VOWEL_REGEX)\ndef check_str(s: str) -> bool:\n    \"\"\"\n    Determines if a string starts with a vowel (case-insensitive, ignores leading whitespace).\n    Raises InvalidInputError if input is not a string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise InvalidInputError(\"input must be a string\")\n\n    validator = RegexValidator(get_vowel_regex())\n    checker = VowelChecker(validator)\n    return checker.check(s)"}
{"task_id": "Mbpp/739", "solution": "import math\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be a positive integer\")\n    threshold = 10 ** (n - 1)\n    D = 1 + 8 * threshold\n    s = math.isqrt(D)\n    k = (s - 1) // 2\n    while k * (k + 1) // 2 < threshold:\n        k += 1\n    return k"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input_tuple):\n    \"\"\"\n    Converts a tuple of adjacent elements into a key-value dictionary.\n    \"\"\"\n    result = {}\n    for i in range(0, len(input_tuple), 2):\n        result[input_tuple[i]] = input_tuple[i + 1]\n    return result"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(s: str) -> bool:\n    \"\"\"\n    Checks if all characters in the given string are identical.\n    An empty string or a single-character string is considered to have all characters the same.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a str\")\n    if len(s) <= 1:\n        return True\n    first = s[0]\n    for ch in s:\n        if ch != first:\n            return False\n    return True"}
{"task_id": "Mbpp/743", "solution": "def rotate_right(lst, k):\n    \"\"\"\n    Rotates a list to the right by k positions, returning a new list.\n    Handles empty lists and normalizes k to avoid out-of-bounds issues.\n    \"\"\"\n    if not lst:\n        return []\n\n    n = len(lst)\n    normalized_k = k % n\n\n    # Split the list into two parts and concatenate them in reverse order\n    # The last 'normalized_k' elements move to the front\n    return lst[-normalized_k:] + lst[:-normalized_k]"}
