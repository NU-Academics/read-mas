{"task_id": "Mbpp/439", "solution": "import math\nfrom typing import Any, List, Sequence\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input scenarios.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n    def __str__(self) -> str:\n        return self.message\nclass Utils:\n    \"\"\"Provides utility methods for numeric operations.\"\"\"\n    def digit_count(self, n: int) -> int:\n        if n < 0:\n            raise InvalidInputError(\"Negative value when counting digits.\")\n        if n == 0:\n            return 1\n        return int(math.floor(math.log10(n))) + 1\n\n    def pow10(self, exp: int) -> int:\n        if exp < 0:\n            raise InvalidInputError(\"Negative exponent for pow10.\")\n        return 10 ** exp\nclass InputValidator:\n    \"\"\"Validates and normalizes raw inputs for the joining operation.\"\"\"\n    def validate(self, candidate: Any) -> List[int]:\n        if not isinstance(candidate, (list, tuple)):\n            raise InvalidInputError(\"Input must be a list or tuple of integers.\")\n        nums = list(candidate)\n        if len(nums) == 0:\n            raise InvalidInputError(\"Input list must not be empty.\")\n        result = []\n        for i, el in enumerate(nums):\n            if isinstance(el, int):\n                val = el\n            elif isinstance(el, str) and el.isdigit():\n                val = int(el)\n            else:\n                raise InvalidInputError(f\"Element at index {i} is not a non-negative integer or digit string.\")\n            if val < 0:\n                raise InvalidInputError(f\"Element at index {i} is negative.\")\n            result.append(val)\n        return result\nclass JoinService:\n    \"\"\"Core logic for joining a list of integers into a single integer.\"\"\"\n    SUPPORTED_METHODS = {\"numeric\", \"string\"}\n\n    def __init__(self, validator: InputValidator, utils: Utils) -> None:\n        self._validator = validator\n        self._utils = utils\n\n    def join(self, nums: List[int], method: str = \"numeric\") -> int:\n        validated = self._validator.validate(nums)\n        method_lower = method.lower() if isinstance(method, str) else \"numeric\"\n        if method_lower not in self.SUPPORTED_METHODS:\n            raise InvalidInputError(f\"Unsupported method: {method}\")\n        if method_lower == \"string\":\n            return self.join_string(validated)\n        return self.join_numeric(validated)\n\n    def join_string(self, nums: List[int]) -> int:\n        s = \"\".join(str(n) for n in nums)\n        return int(s)\n\n    def join_numeric(self, nums: List[int]) -> int:\n        result = 0\n        for n in nums:\n            d = self._utils.digit_count(n)\n            result = result * self._utils.pow10(d) + n\n        return result\n_validator_instance = InputValidator()\n_utils_instance = Utils()\n_service_instance = JoinService(_validator_instance, _utils_instance)\ndef multiple_to_single(nums: list[int], method: str = \"numeric\") -> int:\n    \"\"\"Joins a list of multiple integers into a single integer.\n    The default 'numeric' method is generally more performant for large numbers.\n    \"\"\"\n    return _service_instance.join(nums, method=method)"}
