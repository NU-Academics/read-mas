{"task_id": "Mbpp/94", "solution": "from typing import Sequence, Tuple, Any\ndef index_minimum(items: Sequence[Tuple[Any, Any]]) -> Any:\n    \"\"\"\n    Given a list of tuples, returns the first value of the tuple with the smallest second value.\n    Assumes `items` is a non-empty sequence of 2-element tuples where the second element is comparable.\n    \"\"\"\n    if not items:\n        raise ValueError(\"items must be a non-empty sequence\")\n\n    try:\n        min_second_value = items[0][1]\n        first_value_of_min = items[0][0]\n    except Exception:\n        raise TypeError(\"items must be a sequence of 2-element tuples\")\n\n    for item in items[1:]:\n        if not (isinstance(item, (list, tuple)) and len(item) == 2):\n            raise TypeError(\"each item must be a 2-element sequence\")\n        current_second_value = item[1]\n        current_first_value = item[0]\n\n        if current_second_value < min_second_value:\n            min_second_value = current_second_value\n            first_value_of_min = current_first_value\n\n    return first_value_of_min"}
{"task_id": "Mbpp/98", "solution": "class InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        # Initializes the error with a descriptive message.\n        super().__init__(message)\n        self.message = message\ndef is_numeric(value) -> bool:\n    # Checks if a value is an int or float, excluding booleans.\n    return isinstance(value, (int, float)) and not isinstance(value, bool)\nclass NumberCollection:\n    def __init__(self, numbers):\n        # Stores numbers as an immutable tuple of floats.\n        self.numbers = tuple(numbers)\n\n    def __len__(self) -> int:\n        # Returns the number of elements in the collection.\n        return len(self.numbers)\n\n    def __iter__(self):\n        # Provides an iterator for the numbers.\n        return iter(self.numbers)\n\n    def as_tuple(self):\n        # Returns the underlying tuple of numbers.\n        return self.numbers\nclass InputValidator:\n    def __init__(self, allowed_types=(int, float)) -> None:\n        # Initializes the validator with allowed numeric types.\n        self._allowed_types = allowed_types\n\n    def validate_numbers(self, numbers) -> NumberCollection:\n        # Validates if input is a non-empty sequence of numeric types.\n        if not isinstance(numbers, (list, tuple)):\n            raise InvalidInputError(\"Input must be a non-empty sequence (list or tuple)\")\n        if len(numbers) == 0:\n            raise InvalidInputError(\"Input must not be empty\")\n        normalized = []\n        for i, v in enumerate(numbers):\n            if not is_numeric(v):\n                raise InvalidInputError(f\"Element at index {i} is not numeric: {v!r}\")\n            normalized.append(float(v))\n        return NumberCollection(normalized)\nclass MultiplyService:\n    def __init__(self) -> None:\n        # Constructor for the MultiplyService.\n        pass\n\n    def multiply_and_divide(self, numbers) -> float:\n        # Computes the product of numbers and divides by the count.\n        # Assumes numbers is a non-empty sequence of floats.\n        prod = self._product(numbers)\n        return prod / float(len(numbers))\n\n    def _product(self, numbers) -> float:\n        # Calculates the product of all numbers in the sequence.\n        result = 1.0\n        for v in numbers:\n            result *= float(v)\n        return result\nclass MultiplyController:\n    def __init__(self, validator: InputValidator, service: MultiplyService) -> None:\n        # Initializes controller with injected validator and service.\n        self._validator = validator\n        self._service = service\n\n    def compute(self, numbers) -> float:\n        # Orchestrates validation and computation.\n        coll = self._validator.validate_numbers(numbers)\n        return self._service.multiply_and_divide(coll.as_tuple())\ndef multiply_num(numbers):\n    # Multiplies all numbers in a sequence and divides by the length of the list.\n    # It performs input validation and orchestrates the computation via internal components.\n    validator = InputValidator()\n    service = MultiplyService()\n    controller = MultiplyController(validator, service)\n    return controller.compute(numbers)"}
{"task_id": "Mbpp/97", "solution": "from typing import Iterable, Any, Dict, Iterator, Hashable, Mapping\ndef frequency_lists(list_of_lists: Iterable[Iterable[Any]]) -> Dict[Any, int]:\n    \"\"\"\n    Finds the frequency of each element in a flattened list of lists,\n    returning the result as a dictionary with normalized elements as keys.\n    \"\"\"\n    MAX_RECURSION_DEPTH = 1000\n\n    def _is_atomic(obj: Any) -> bool:\n        \"\"\"Checks if an object should be treated as a single item and not further iterated.\"\"\"\n        return isinstance(obj, (str, bytes)) or not hasattr(obj, '__iter__')\n\n    def _normalize_element(element: Any, _depth: int = 0) -> Hashable:\n        \"\"\"\n        Normalizes an element into a deterministic, hashable representation.\n        Handles unhashable types like lists, sets, and dictionaries recursively.\n        \"\"\"\n        if _depth > MAX_RECURSION_DEPTH:\n            raise RuntimeError(\"Maximum recursion depth exceeded during normalization.\")\n\n        try:\n            hash(element)\n            return element\n        except TypeError:\n            if isinstance(element, Mapping):\n                # Normalize keys and values, then sort the pairs for deterministic frozenset creation.\n                normalized_items = tuple(sorted(\n                    (_normalize_element(k, _depth + 1), _normalize_element(v, _depth + 1))\n                    for k, v in element.items()\n                ))\n                return frozenset(normalized_items)\n            elif isinstance(element, (list, tuple, set)):\n                # Recursively normalize elements within iterables.\n                normalized_elements = tuple(_normalize_element(e, _depth + 1) for e in element)\n                return frozenset(normalized_elements) if isinstance(element, set) else normalized_elements\n            # Fallback for other unhashable types by using their string representation.\n            return repr(element)\n\n    def _flatten(nested: Iterable[Any], _depth: int = 0) -> Iterator[Any]:\n        \"\"\"Recursively flattens a nested iterable, yielding atomic elements.\"\"\"\n        if _depth > MAX_RECURSION_DEPTH:\n            raise RuntimeError(\"Maximum recursion depth exceeded during flattening.\")\n\n        for item in nested:\n            if _is_atomic(item):\n                yield item\n            else:\n                yield from _flatten(item, _depth + 1)\n\n    counts: Dict[Any, int] = {}\n    for item in _flatten(list_of_lists):\n        norm = _normalize_element(item)\n        counts[norm] = counts.get(norm, 0) + 1\n\n    return counts"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(n: int) -> str:\n    # Handle the special case for 0, which is represented as \"0\".\n    if n == 0:\n        return \"0\"\n\n    bits = []\n    # Convert the positive integer to binary using bitwise operations.\n    while n > 0:\n        bits.append(\"1\" if (n & 1) else \"0\")\n        n >>= 1\n\n    # The bits are collected in reverse order, so reverse the list before joining.\n    return \"\".join(reversed(bits))"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome strictly greater than n.\n    Handles single digits and all-nines special cases.\n    \"\"\"\n    s = str(n)\n    length = len(s)\n\n    # Helper function: Check if string consists of all '9's\n    def _is_all_nines(val_str: str) -> bool:\n        return all(ch == '9' for ch in val_str)\n\n    # Helper function: Mirror left half to right half\n    def _mirror_left_to_right(val_str: str) -> str:\n        left_half = val_str[: (length + 1) // 2]\n        return left_half + left_half[: length // 2][::-1]\n\n    # Helper function: Increment the middle part of the number string\n    def _increment_middle(val_str: str) -> str:\n        digits = [int(d) for d in val_str]\n\n        # Start from the middle (right middle for even length)\n        i = (length - 1) // 2\n        j = length // 2\n\n        # Increment the middle and propagate carry to the left side\n        carry_idx = j - 1  # left middle index for propagation\n        while carry_idx >= 0:\n            if digits[carry_idx] < 9:\n                digits[carry_idx] += 1\n                break\n            digits[carry_idx] = 0\n            carry_idx -= 1\n\n        if carry_idx < 0:\n            # All digits on the left were 9 (should be handled by all-nines case),\n            # but return a safe fallback like 100...001\n            return \"1\" + \"0\" * (length - 1) + \"1\"\n\n        # Reflect the left side to the right side after increment\n        for k in range((length) // 2):\n            digits[length - 1 - k] = digits[k]\n\n        return \"\".join(map(str, digits))\n\n    if n < 0:\n        # Negative inputs not supported per design assumptions.\n        # Behavior is unspecified; raise ValueError would be appropriate,\n        # but keeping function simple as per the problem statement.\n        raise ValueError(\"Negative inputs are not supported\")\n\n    if length == 1 and n < 9:\n        return n + 1\n\n    if _is_all_nines(s):\n        return int(\"1\" + \"0\" * (length - 1) + \"1\")\n\n    # Try mirroring first\n    candidate_s = _mirror_left_to_right(s)\n    candidate_int = int(candidate_s)\n\n    if candidate_int > n:\n        return candidate_int\n    else:\n        # If mirroring results in a number <= n, increment the middle and mirror again\n        incremented_s = _increment_middle(s)\n        # After increment_middle we should mirror left to right (increment already reflected)\n        # but to be safe, build final by mirroring the left half\n        final_left = incremented_s[: (length + 1) // 2]\n        final = final_left + final_left[: length // 2][::-1]\n        return int(final)"}
{"task_id": "Mbpp/101", "solution": "def kth_element(array, k):\n    \"\"\"\n    Finds the kth element in the given array using 1-based indexing.\n    \"\"\"\n    # Validate types\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer\")\n    if not hasattr(array, '__getitem__'):\n        raise TypeError(\"array must be a sequence or support indexing\")\n    # Convert 1-based index k to a 0-based index\n    zero_based_index = k - 1\n    # Validate range\n    if zero_based_index < 0 or zero_based_index >= len(array):\n        raise IndexError(\"k is out of range for the array\")\n    return array[zero_based_index]"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(s: str) -> str:\n    \"\"\"Converts a snake_case string to CamelCase (PascalCase).\"\"\"\n\n    class StringNormalizer:\n        \"\"\"Helper to normalize string segments and capitalize them.\"\"\"\n\n        def normalize_parts(self, s: str) -> list[str]:\n            # Split by underscore, trim whitespace, and filter out empty segments.\n            parts = [p.strip() for p in s.split(\"_\") if p.strip() != \"\"]\n            return parts\n\n        def capitalize_segment(self, seg: str) -> str:\n            # Capitalize the first character of a segment, if it exists.\n            if not seg:\n                return \"\"\n            return seg[0].upper() + seg[1:]\n\n    class SnakeToCamelConverter:\n        \"\"\"Core logic to convert snake_case to CamelCase.\"\"\"\n\n        def __init__(self, normalizer: StringNormalizer) -> None:\n            self._normalizer = normalizer\n\n        def convert(self, s: str) -> str:\n            # Normalize parts, capitalize each, and join them.\n            parts = self._normalizer.normalize_parts(s)\n            return \"\".join(self._normalizer.capitalize_segment(p) for p in parts)\n\n    normalizer = StringNormalizer()\n    converter = SnakeToCamelConverter(normalizer)\n    return converter.convert(s)"}
{"task_id": "Mbpp/105", "solution": "from typing import Iterable, Any\ndef count(items: Iterable[Any], include_truthy: bool=False) -> int:\n    \"\"\"Counts True boolean values or truthy values in an iterable.\n\n    The behavior depends on the `include_truthy` parameter.\n    \"\"\"\n    true_count = 0\n    if include_truthy:\n        for item in items:\n            if bool(item):\n                true_count += 1\n    else:\n        for item in items:\n            if item is True:  # Checks for exact boolean True\n                true_count += 1\n    return true_count"}
{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Compute the Eulerian number A(n, m).\n\n    Uses the recurrence:\n        A(0,0) = 1\n        A(n,m) = (n - m) * A(n-1, m-1) + (m + 1) * A(n-1, m)\n\n    Returns 0 for out-of-range m (i.e., m < 0 or m >= n when n > 0).\n    \"\"\"\n    if n == 0:\n        return 1 if m == 0 else 0\n    if m < 0 or m >= n:\n        return 0\n\n    # Start from row for n = 1: A(1,0) = 1\n    prev_row = [1]\n\n    for current_n in range(2, n + 1):\n        current_row = [0] * current_n\n        for current_m in range(current_n):\n            a = prev_row[current_m - 1] if (current_m - 1) >= 0 and (current_m - 1) < len(prev_row) else 0\n            b = prev_row[current_m] if current_m < len(prev_row) else 0\n            current_row[current_m] = (current_n - current_m) * a + (current_m + 1) * b\n        prev_row = current_row\n\n    return prev_row[m]"}
{"task_id": "Mbpp/106", "solution": "def add_lists(lst: list, tup: tuple) -> tuple:\n    \"\"\"\n    Append the elements of `lst` to the end of `tup` and return a new tuple.\n\n    Example:\n        add_lists([5, 6, 7], (9, 10)) -> (9, 10, 5, 6, 7)\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"First argument must be a list\")\n    if not isinstance(tup, tuple):\n        raise TypeError(\"Second argument must be a tuple\")\n    return tup + tuple(lst)"}
