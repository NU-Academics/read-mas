{"task_id": "Mbpp/261", "solution": "def division_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise division between two tuples.\n    Results are integer if division is exact (within tolerance), otherwise float.\n    \"\"\"\n    INTEGER_TOLERANCE = 1e-12\n\n    def is_integerish(x: float, tol: float = INTEGER_TOLERANCE) -> bool:\n        \"\"\"Checks if a float value is approximately an integer.\"\"\"\n        return abs(x - round(x)) < tol\n\n    if not isinstance(a, tuple) or not isinstance(b, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n    if len(a) != len(b):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n    results = []\n    for i, (x, y) in enumerate(zip(a, b)):\n        if not isinstance(x, (int, float)):\n            raise TypeError(f\"Element at index {i} of first tuple is not numeric: {x!r}\")\n        if not isinstance(y, (int, float)):\n            raise TypeError(f\"Element at index {i} of second tuple is not numeric: {y!r}\")\n        if y == 0:\n            raise ZeroDivisionError(f\"Division by zero at index {i}.\")\n        val = x / y\n        if is_integerish(val):\n            results.append(int(round(val)))\n        else:\n            results.append(float(val))\n    return tuple(results)"}
{"task_id": "Mbpp/259", "solution": "def maximize_elements(a, b):\n    \"\"\"\n    Computes the element-wise maximum of two nested sequences, returning a tuple of tuples.\n    Raises ValueError if input sequence shapes do not match.\n    \"\"\"\n    # Convert inputs to tuples to ensure indexability and consistent behavior,\n    # handling potential iterators or other non-indexable sequences.\n    a_indexed = tuple(a)\n    b_indexed = tuple(b)\n\n    len_a = len(a_indexed)\n    len_b = len(b_indexed)\n\n    # Validate outer sequence lengths\n    if len_a != len_b:\n        raise ValueError(f\"Outer sequences differ in length: {len_a} != {len_b}\")\n\n    result_outer = []\n    for i in range(len_a):\n        # Convert inner sequences to tuples to ensure indexability\n        inner_a = tuple(a_indexed[i])\n        inner_b = tuple(b_indexed[i])\n\n        len_inner_a = len(inner_a)\n        len_inner_b = len(inner_b)\n\n        # Validate inner sequence lengths\n        if len_inner_a != len_inner_b:\n            raise ValueError(f\"Inner sequences at index {i} differ in length: {len_inner_a} != {len_inner_b}\")\n\n        # Compute element-wise maximum for the inner sequences\n        result_inner = [None] * len_inner_a\n        for j in range(len_inner_a):\n            result_inner[j] = max(inner_a[j], inner_b[j])\n\n        # Convert the inner list to a tuple for immutability\n        result_outer.append(tuple(result_inner))\n\n    # Convert the outer list of tuples to a tuple for immutability\n    return tuple(result_outer)"}
{"task_id": "Mbpp/256", "solution": "import math\nDEFAULT_MAX_N = 10_000_000\nclass PrimeCounterError(Exception):\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\nclass ValidationUtils:\n    @staticmethod\n    def validate_non_negative_int(n) -> int:\n        if not isinstance(n, int):\n            raise PrimeCounterError(\"Input must be an integer.\")\n        if n < 0:\n            raise PrimeCounterError(\"Input must be non-negative.\")\n        return n\nclass InMemoryCacheRepository:\n    def __init__(self):\n        self._store: dict[int, int] = {}\n\n    def get(self, n: int) -> int | None:\n        return self._store.get(n)\n\n    def set(self, n: int, count: int) -> None:\n        self._store[n] = count\n\n    def clear(self) -> None:\n        self._store.clear()\nclass SieveAlgorithm:\n    DEFAULT_MAX_N = DEFAULT_MAX_N\n\n    def count_primes_less_than(self, n: int, max_n: int = DEFAULT_MAX_N) -> int:\n        if n < 0:\n            raise PrimeCounterError(\"n must be non-negative\")\n        if n > max_n:\n            raise PrimeCounterError(f\"n exceeds configured maximum {max_n}\")\n        if n <= 2:\n            return 0\n\n        limit = n\n        sieve = bytearray(b\"\\x01\") * limit\n        sieve[0:2] = b\"\\x00\\x00\"\n\n        for p in range(2, int(math.isqrt(limit)) + 1):\n            if sieve[p]:\n                step = p\n                start = p * p\n                sieve[start:limit:step] = b\"\\x00\" * (((limit - 1 - start) // step) + 1)\n        return sieve.count(1)\nclass PrimeService:\n    def __init__(self, algorithm: SieveAlgorithm, cache_repo: InMemoryCacheRepository | None = None, max_n: int = DEFAULT_MAX_N):\n        self._algorithm = algorithm\n        self._cache_repo = cache_repo\n        self._max_n = max_n\n\n    def count_primes(self, n: int) -> int:\n        n = ValidationUtils.validate_non_negative_int(n)\n\n        if self._cache_repo:\n            cached = self._cache_repo.get(n)\n            if cached is not None:\n                return cached\n\n        result = self._algorithm.count_primes_less_than(n, max_n=self._max_n)\n\n        if self._cache_repo:\n            try:\n                self._cache_repo.set(n, result)\n            except Exception:\n                pass\n        return result\nclass PrimeCounterAPI:\n    DEFAULT_MAX_N = DEFAULT_MAX_N\n\n    def __init__(self, max_n: int = DEFAULT_MAX_N, cache_repo: InMemoryCacheRepository | None = None):\n        self._service = PrimeService(SieveAlgorithm(), cache_repo or InMemoryCacheRepository(), max_n=max_n)\n\n    def count(self, n: int) -> int:\n        return self._service.count_primes(n)\n_api = PrimeCounterAPI()\ndef count_Primes_nums(n: int) -> int:\n    \"\"\"Public convenience function to count primes less than n.\"\"\"\n    return _api.count(n)"}
{"task_id": "Mbpp/262", "solution": "def split_two_parts(items, L):\n    \"\"\"\n    Splits a list into two parts based on a given length L for the first part.\n    Returns the two resulting lists as a tuple.\n    \"\"\"\n    first_part = items[:L]\n    second_part = items[L:]\n    return (first_part, second_part)"}
{"task_id": "Mbpp/260", "solution": "def newman_prime(n: int) -> int:\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n == 0 or n == 1:\n        return 1\n\n    # Multiply two 2x2 matrices\n    def _mul(a, b):\n        return [\n            [a[0][0] * b[0][0] + a[0][1] * b[1][0], a[0][0] * b[0][1] + a[0][1] * b[1][1]],\n            [a[1][0] * b[0][0] + a[1][1] * b[1][0], a[1][0] * b[0][1] + a[1][1] * b[1][1]],\n        ]\n\n    # Fast exponentiation of a 2x2 matrix\n    def _mat_pow(matrix, exponent):\n        result = [[1, 0], [0, 1]]  # identity\n        base = matrix\n        e = exponent\n        while e > 0:\n            if e & 1:\n                result = _mul(result, base)\n            base = _mul(base, base)\n            e >>= 1\n        return result\n\n    BASE = [[2, 1], [1, 0]]\n    M = _mat_pow(BASE, n - 1)\n    # S(n) = M * [S1, S0]^T with S1 = S0 = 1 => sum of first row\n    return M[0][0] + M[0][1]"}
{"task_id": "Mbpp/264", "solution": "def dog_age(human_years: int) -> int:\n    \"\"\"\n    Convert human years to dog years using a piecewise rule.\n    The formula ensures dog_age(12) == 61.\n    \"\"\"\n    if human_years == 0:\n        return 0\n    if human_years == 1:\n        return 15\n    if human_years == 2:\n        return 24\n    return int(round(24 + (human_years - 2) * 3.7))"}
{"task_id": "Mbpp/266", "solution": "import math\ndef lateralsurface_cube(side: float) -> float:\n    \"\"\"Calculates the lateral surface area of a cube given its side length.\n    Input `side` is validated to be a non-negative finite number.\"\"\"\n    class InvalidDimensionError(ValueError):\n        \"\"\"Exception raised for invalid geometric dimensions.\"\"\"\n        pass\n\n    def is_number(value: any) -> bool:\n        \"\"\"Checks if a value is an int or float.\"\"\"\n        return isinstance(value, (int, float))\n\n    def validate_side(side_input: any) -> float:\n        \"\"\"Validates the side length and converts it to a float.\"\"\"\n        if not is_number(side_input):\n            raise InvalidDimensionError(\"Side must be a number\")\n        side_f = float(side_input)\n        if math.isnan(side_f) or math.isinf(side_f) or side_f < 0:\n            raise InvalidDimensionError(\"Side must be a finite non-negative number\")\n        return side_f\n\n    class MathAdapter:\n        \"\"\"Adapts mathematical operations for isolation.\"\"\"\n        def multiply(self, a: float, b: float) -> float:\n            return a * b\n\n        def square(self, a: float) -> float:\n            return self.multiply(a, a)\n\n    class Cube:\n        \"\"\"Represents a cube with a defined side length.\"\"\"\n        def __init__(self, side_len: float) -> None:\n            self._side: float = side_len\n\n        def area_of_one_face(self) -> float:\n            \"\"\"Calculates the area of one face of the cube.\"\"\"\n            return self._side * self._side\n\n        def lateral_surface_area(self) -> float:\n            \"\"\"Calculates the lateral surface area of the cube.\"\"\"\n            return 4.0 * self.area_of_one_face()\n\n    class GeometryService:\n        \"\"\"Provides core geometric computation logic.\"\"\"\n        def __init__(self, math_adapter_instance: MathAdapter) -> None:\n            self._math_adapter = math_adapter_instance\n\n        def lateral_surface_area(self, cube_obj: Cube) -> float:\n            \"\"\"Computes the lateral surface area using the MathAdapter.\"\"\"\n            side_value = cube_obj._side\n            side_squared = self._math_adapter.square(side_value)\n            return self._math_adapter.multiply(4.0, side_squared)\n\n    class LateralSurfaceController:\n        \"\"\"Orchestrates the calculation flow for lateral surface area.\"\"\"\n        def __init__(self, service_instance: GeometryService) -> None:\n            self._service = service_instance\n\n        def compute(self, input_side: float) -> float:\n            \"\"\"Validates the side and delegates computation to the service.\"\"\"\n            validated_side = validate_side(input_side)\n            cube = Cube(validated_side)\n            return self._service.lateral_surface_area(cube)\n\n    # Initialize components and compute result\n    adapter = MathAdapter()\n    service = GeometryService(adapter)\n    controller = LateralSurfaceController(service)\n    return controller.compute(side)"}
{"task_id": "Mbpp/267", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the squares of the first n odd natural numbers using a closed-form formula.\n    The formula is derived from sum of squares and sum of natural numbers formulas.\n    \"\"\"\n    if n < 0:\n        # For negative n, return 0 (no odd numbers to square)\n        return 0\n\n    # Formula for sum of first k natural numbers: sum_k = k(k+1)/2\n    # Formula for sum of squares of first k natural numbers: sum_k2 = k(k+1)(2k+1)/6\n\n    # The sum of squares of the first n odd natural numbers is given by:\n    # sum_{k=1..n} (2k-1)^2 = 4 * sum_{k=1..n} k^2 - 4 * sum_{k=1..n} k + n\n    #                    = 4 * (n(n+1)(2n+1)/6) - 4 * (n(n+1)/2) + n\n\n    sum_k2_term = n * (n + 1) * (2 * n + 1) // 6\n    sum_k_term = n * (n + 1) // 2\n\n    result = 4 * sum_k2_term - 4 * sum_k_term + n\n\n    return result"}
{"task_id": "Mbpp/265", "solution": "from typing import List, Any, Sequence\ndef list_split(lst: Sequence[Any], n: int) -> List[List[Any]]:\n    \"\"\"\n    Splits a list into n sublists where each sublist contains elements\n    from the original list taken every n elements, starting at each offset.\n    \"\"\"\n    result: List[List[Any]] = [[] for _ in range(n)]\n    for idx, val in enumerate(lst):\n        result[idx % n].append(val)\n    return result"}
{"task_id": "Mbpp/270", "solution": "def sum_even_and_even_index(numbers):\n    \"\"\"\n    Finds the sum of even numbers that are located at even positions (0-indexed) in a list.\n    \"\"\"\n    total_sum = 0\n    for index, num in enumerate(numbers):\n        if index % 2 == 0 and num % 2 == 0:\n            total_sum += num\n    return total_sum"}
{"task_id": "Mbpp/268", "solution": "class StarNumber:\n    \"\"\"Data model for a star number, storing its index and value.\"\"\"\n    def __init__(self, n: int, value: int):\n        self.n = n\n        self.value = value\nclass StarNumberCalculator:\n    \"\"\"Calculates the n-th star number using the formula S(n) = 6*n*(n-1) + 1.\"\"\"\n    def calculate(self, n: int) -> int:\n        return 6 * n * (n - 1) + 1\nclass StarNumberCache:\n    \"\"\"Provides an in-memory cache for star numbers.\"\"\"\n    def __init__(self):\n        self._memory_cache: dict[int, int] = {}\n\n    def get(self, n: int) -> int | None:\n        return self._memory_cache.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        self._memory_cache[n] = value\nclass StarNumberService:\n    \"\"\"Orchestrates calculation and caching of star numbers.\"\"\"\n    def __init__(self, calculator: StarNumberCalculator | None = None, cache: StarNumberCache | None = None):\n        self.calculator = calculator if calculator is not None else StarNumberCalculator()\n        self.cache = cache if cache is not None else StarNumberCache()\n\n    def find(self, n: int) -> StarNumber:\n        # Input validation for 'n' is omitted per completion instructions.\n        cached_value = self.cache.get(n)\n        if cached_value is not None:\n            return StarNumber(n, cached_value)\n\n        value = self.calculator.calculate(n)\n        self.cache.set(n, value)\n        return StarNumber(n, value)\ndef find_star_num(n: int) -> int:\n    \"\"\"\n    Calculates the n'th star number.\n    Input validation is assumed to be handled by the caller or external system.\n    \"\"\"\n    service = StarNumberService()\n    star_number_model = service.find(n)\n    return star_number_model.value"}
