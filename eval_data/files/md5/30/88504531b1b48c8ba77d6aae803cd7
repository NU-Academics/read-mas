{"task_id": "Mbpp/119", "solution": "def search(nums: list[int]) -> int:\n    \"\"\"Return the element that appears only once in a sorted list where every other element appears twice.\"\"\"\n    if not nums:\n        raise ValueError(\"nums must be a non-empty list\")\n    left, right = 0, len(nums) - 1\n    while left < right:\n        mid = left + (right - left) // 2\n        if mid % 2 == 0:\n            if nums[mid] == nums[mid + 1]:\n                left = mid + 2\n            else:\n                right = mid\n        else:\n            if nums[mid] == nums[mid - 1]:\n                left = mid + 1\n            else:\n                right = mid - 1\n    return nums[left]"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(pairs):\n    \"\"\"\n    Find the maximum absolute product between numbers in pairs of tuples within a given iterable.\n\n    Example:\n        assert max_product_tuple([(2, 7), (2, 6), (1, 8), (4, 9)]) == 36\n\n    Raises:\n        ValueError: if `pairs` is not an iterable of 2-length numeric iterables or if no pairs are provided.\n    \"\"\"\n    max_val = None\n    found = False\n\n    try:\n        iterator = iter(pairs)\n    except TypeError:\n        raise ValueError(\"Input must be an iterable of 2-length numeric iterables\")\n\n    for idx, item in enumerate(pairs):\n        # Reject strings (they are iterable but not pairs of numbers)\n        if isinstance(item, str) or not hasattr(item, \"__iter__\"):\n            raise ValueError(f\"Item at index {idx} is not a 2-length iterable: {item!r}\")\n\n        # Attempt to unpack two elements\n        try:\n            a, b = item\n        except Exception:\n            raise ValueError(f\"Item at index {idx} is not a 2-length iterable: {item!r}\")\n\n        # Reject booleans explicitly\n        if isinstance(a, bool) or isinstance(b, bool):\n            raise ValueError(f\"Boolean values are not accepted as numeric elements at index {idx}: {item!r}\")\n\n        # Ensure numeric types (int or float)\n        if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n            raise ValueError(f\"Non-numeric element at index {idx}: {item!r}\")\n\n        cur = abs(a * b)\n        if max_val is None or cur > max_val:\n            max_val = cur\n        found = True\n\n    if not found:\n        raise ValueError(\"No valid pairs provided\")\n\n    # If the maximum is a float that represents an integer, return an int for nicer output\n    if isinstance(max_val, float) and max_val.is_integer():\n        return int(max_val)\n    return max_val"}
{"task_id": "Mbpp/124", "solution": "import math\nfrom typing import Union, Optional, Tuple\nclass AngleCalculationError(Exception):\n    \"\"\"Exception raised for errors during complex number angle calculation.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\nclass ComplexNumber:\n    \"\"\"Immutable domain model for a complex number with real and imaginary parts.\"\"\"\n    def __init__(self, real: float, imag: float) -> None:\n        self._real = float(real)\n        self._imag = float(imag)\n\n    @property\n    def real(self) -> float:\n        return self._real\n\n    @property\n    def imag(self) -> float:\n        return self._imag\n\n    def to_tuple(self) -> Tuple[float, float]:\n        return (self._real, self._imag)\n\n    def to_complex(self) -> complex:\n        return complex(self._real, self._imag)\nALLOWED_SCALAR_TYPES = (int, float)\nclass InputValidator:\n    \"\"\"Validates and normalizes various input forms into a (real, imag) tuple of floats.\"\"\"\n    def validate(self, value: Union[complex, tuple, list, float, int], imag: Optional[float] = None) -> Tuple[float, float]:\n        if isinstance(value, complex):\n            return (value.real, value.imag)\n        elif isinstance(value, (tuple, list)):\n            if len(value) == 2 and all(isinstance(x, ALLOWED_SCALAR_TYPES) for x in value):\n                return (float(value[0]), float(value[1]))\n            else:\n                raise AngleCalculationError(\"Input tuple or list must contain two numeric values.\")\n        elif isinstance(value, ALLOWED_SCALAR_TYPES):\n            if imag is not None:\n                if isinstance(imag, ALLOWED_SCALAR_TYPES):\n                    return (float(value), float(imag))\n                else:\n                    raise AngleCalculationError(\"Imaginary part must be a numeric value if provided.\")\n            else:\n                return (float(value), 0.0)\n        else:\n            raise AngleCalculationError(f\"Invalid input type: {type(value)}. Expected complex, tuple, list, float, or int.\")\nclass ComplexFactory:\n    \"\"\"Factory for creating ComplexNumber instances from normalized numeric pairs or complex objects.\"\"\"\n    @staticmethod\n    def from_pair(real: float, imag: float) -> ComplexNumber:\n        return ComplexNumber(real, imag)\n\n    @staticmethod\n    def from_complex(c: complex) -> ComplexNumber:\n        return ComplexNumber(c.real, c.imag)\nclass AngleCalculator:\n    \"\"\"Calculates the angle (argument) of a complex number using math.atan2.\"\"\"\n    def calculate(self, c: ComplexNumber) -> float:\n        return math.atan2(c.imag, c.real)\n\n    def calculate_components(self, real: float, imag: float) -> float:\n        return math.atan2(imag, real)\nclass AngleController:\n    \"\"\"Orchestrates input validation, complex number creation, and angle calculation.\"\"\"\n    def __init__(self, validator: InputValidator, factory: ComplexFactory, calculator: AngleCalculator) -> None:\n        self._validator = validator\n        self._factory = factory\n        self._calculator = calculator\n\n    def get_angle(self, value: Union[complex, tuple, list, float, int], imag: Optional[float] = None) -> float:\n        normalized_real, normalized_imag = self._validator.validate(value, imag)\n        model = self._factory.from_pair(normalized_real, normalized_imag)\n        return self._calculator.calculate(model)\n_default_controller = AngleController(InputValidator(), ComplexFactory(), AngleCalculator())\ndef angle_complex(value: Union[complex, tuple, list, float, int], imag: Optional[float] = None) -> float:\n    \"\"\"\n    Computes the angle (argument) of a complex number in radians.\n    Accepts complex numbers, (real, imag) tuples/lists, or two numeric arguments.\n    \"\"\"\n    return _default_controller.get_angle(value, imag)"}
{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(limit: int) -> int:\n    \"\"\"\n    Return the sum of all amicable numbers between 1 and `limit` (inclusive).\n\n    Raises:\n        TypeError: if limit is not an int\n        ValueError: if limit < 2\n    \"\"\"\n    if not isinstance(limit, int):\n        raise TypeError(\"limit must be an int\")\n    if limit < 2:\n        raise ValueError(\"limit must be >= 2\")\n\n    # sum of proper divisors for each number 0..limit\n    divsum = [0] * (limit + 1)\n\n    # For each potential divisor i, add it to all multiples j > i\n    for i in range(1, limit // 2 + 1):\n        for j in range(i * 2, limit + 1, i):\n            divsum[j] += i\n\n    total = 0\n    for a in range(2, limit + 1):\n        b = divsum[a]\n        # include a only if b is a distinct partner within range and mutual\n        if b != a and b <= limit and b > 0 and divsum[b] == a:\n            total += a\n\n    return total"}
{"task_id": "Mbpp/125", "solution": "def find_length(s: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s in any substring.\n    Maps '0' to +1 and '1' to -1, then uses Kadane's algorithm to find the maximum subarray sum.\n    \"\"\"\n    if not s:\n        return 0\n\n    current_max = 0\n    global_max = float('-inf')\n\n    for char_val in s:\n        val = 1 if char_val == '0' else -1\n        current_max = max(val, current_max + val)\n        global_max = max(global_max, current_max)\n\n    return max(0, int(global_max))"}
{"task_id": "Mbpp/126", "solution": "def sum(a: int, b: int) -> int:\n    \"\"\"Calculates the sum of common divisors of two integers.\"\"\"\n    def _gcd_helper(x: int, y: int) -> int:\n        x, y = abs(x), abs(y)\n        while y:\n            x, y = y, x % y\n        return x\n\n    def _divisors_of_helper(n: int) -> list[int]:\n        if n <= 0:\n            return []\n        small, large = [], []\n        i = 1\n        while i * i <= n:\n            if n % i == 0:\n                small.append(i)\n                if i != n // i:\n                    large.append(n // i)\n            i += 1\n        return small + large[::-1]\n\n    def _sum_of_divisors_helper(n: int) -> int:\n        return sum(_divisors_of_helper(n))\n\n    common_divisor_gcd = _gcd_helper(a, b)\n    return _sum_of_divisors_helper(common_divisor_gcd)"}
{"task_id": "Mbpp/127", "solution": "def multiply_int(a: int, b: int) -> int:\n    import uuid\n    import datetime\n    import json\n    import os\n    from typing import Any, List, Optional\n\n    class ValidationError(ValueError):\n        \"\"\"Exception raised for invalid input types or values.\"\"\"\n        pass\n\n    class RepositoryError(RuntimeError):\n        \"\"\"Exception raised for repository persistence failures.\"\"\"\n        pass\n\n    class IntPair:\n        \"\"\"Data Transfer Object for two integers.\"\"\"\n        def __init__(self, a: int, b: int) -> None:\n            self.a = a\n            self.b = b\n\n    class MultiplyResult(IntPair):\n        \"\"\"Data Transfer Object for multiplication results, including metadata.\"\"\"\n        def __init__(self, a: int, b: int, result: int, timestamp: str, id: str) -> None:\n            super().__init__(a, b)\n            self.result = result\n            self.timestamp = timestamp\n            self.id = id\n\n    class LoggerAdapter:\n        \"\"\"Abstract base class for logging operations.\"\"\"\n        def info(self, msg: str) -> None:\n            raise NotImplementedError\n        def error(self, msg: str) -> None:\n            raise NotImplementedError\n\n    class StdLoggerAdapter(LoggerAdapter):\n        \"\"\"A simple standard logger adapter using print for output.\"\"\"\n        def __init__(self, name: str = \"multiplier\") -> None:\n            self._name = name\n\n        def info(self, msg: str) -> None:\n            print(f\"INFO: {msg}\")\n\n        def error(self, msg: str) -> None:\n            print(f\"ERROR: {msg}\")\n\n    class CalculationRepository:\n        \"\"\"Abstract base class for storing calculation records.\"\"\"\n        def save(self, record: dict) -> str:\n            raise NotImplementedError\n        def list(self, limit: Optional[int] = None) -> List[dict]:\n            raise NotImplementedError\n\n    class InMemoryCalculationRepository(CalculationRepository):\n        \"\"\"In-memory repository for calculation records, with optional file persistence.\"\"\"\n        def __init__(self, persist_path: Optional[str] = None) -> None:\n            self._persist_path = persist_path\n            self._store = []\n            if persist_path:\n                self._load()\n\n        def save(self, record: dict) -> str:\n            self._store.append(record)\n            if self._persist_path:\n                self._persist()\n            return record[\"id\"]\n\n        def list(self, limit: Optional[int] = None) -> List[dict]:\n            return self._store[-limit:] if limit else list(self._store)\n\n        def _load(self) -> None:\n            \"\"\"Loads records from the persistence file if it exists.\"\"\"\n            if self._persist_path and os.path.exists(self._persist_path):\n                try:\n                    with open(self._persist_path, \"r\", encoding=\"utf-8\") as f:\n                        self._store = json.load(f)\n                except json.JSONDecodeError as e:\n                    raise RepositoryError(f\"Failed to load history from {self._persist_path}: {e}\")\n                except IOError as e:\n                    raise RepositoryError(f\"Failed to read history file {self._persist_path}: {e}\")\n\n        def _persist(self) -> None:\n            \"\"\"Persists records to the file atomically.\"\"\"\n            if not self._persist_path:\n                return\n            try:\n                tmp_path = self._persist_path + \".tmp\"\n                with open(tmp_path, \"w\", encoding=\"utf-8\") as f:\n                    json.dump(self._store, f, indent=2)\n                os.replace(tmp_path, self._persist_path)\n            except IOError as e:\n                raise RepositoryError(f\"Failed to persist history to {self._persist_path}: {e}\")\n\n    def validate_int(value: Any, name: str) -> None:\n        \"\"\"Validates if a value is an integer, raising ValidationError if not.\"\"\"\n        if not isinstance(value, int):\n            raise ValidationError(f\"{name} must be an integer, got {type(value).__name__}.\")\n\n    class MultiplierService:\n        \"\"\"Service for multiplying integers, orchestrating validation, history, and logging.\"\"\"\n        def __init__(self, repository: CalculationRepository, logger: LoggerAdapter) -> None:\n            self._repository = repository\n            self._logger = logger\n\n        def multiply(self, a: int, b: int) -> MultiplyResult:\n            validate_int(a, \"a\")\n            validate_int(b, \"b\")\n\n            result = a * b\n            timestamp = datetime.datetime.utcnow().isoformat(timespec='seconds') + \"Z\"\n            record_id = str(uuid.uuid4())\n            record = {\"id\": record_id, \"a\": a, \"b\": b, \"result\": result, \"timestamp\": timestamp}\n\n            self._repository.save(record)\n            self._logger.info(f\"computed {a} * {b} = {result}\")\n\n            return MultiplyResult(a=a, b=b, result=result, timestamp=timestamp, id=record_id)\n\n    # Implementation of multiply_int function logic as per design context\n    logger = StdLoggerAdapter()\n    repo = InMemoryCalculationRepository()\n    svc = MultiplierService(repository=repo, logger=logger)\n    result_dto = svc.multiply(a, b)\n    return result_dto.result"}
{"task_id": "Mbpp/128", "solution": "STRIP_CHARS = \".,;:!?()[]\\\"'`\"\ndef long_words(n: int, text: str) -> list:\n    \"\"\"\n    Finds words from a text that are longer than n characters.\n    Words are tokenized by whitespace and stripped of leading/trailing punctuation.\n    \"\"\"\n    result = []\n    for raw_token in text.split():\n        stripped_word = raw_token.strip(STRIP_CHARS)\n        if stripped_word and len(stripped_word) > n:\n            result.append(stripped_word)\n\n    return result"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(items):\n    \"\"\"Finds the item with the maximum frequency in a given list. Ties are resolved by selecting the item encountered first.\"\"\"\n    counts = {}\n    first_indices = {}\n\n    for idx, item in enumerate(items):\n        if item not in counts:\n            counts[item] = 0\n            first_indices[item] = idx\n        counts[item] += 1\n\n    max_item = None\n    max_freq = -1\n    min_first_idx = float('inf')\n\n    for item, count in counts.items():\n        if count > max_freq:\n            max_freq = count\n            max_item = item\n            min_first_idx = first_indices[item]\n        elif count == max_freq:\n            if first_indices[item] < min_first_idx:\n                min_first_idx = first_indices[item]\n                max_item = item\n\n    return max_item"}
{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix):\n    \"\"\"Calculates if a given square matrix of integers is a magic square.\"\"\"\n    n = len(matrix)\n\n    # Calculate the target sum from the first row.\n    target_sum = sum(matrix[0])\n\n    # Check all row sums.\n    for i in range(n):\n        if sum(matrix[i]) != target_sum:\n            return False\n\n    # Check all column sums.\n    for j in range(n):\n        col_sum = 0\n        for i in range(n):\n            col_sum += matrix[i][j]\n        if col_sum != target_sum:\n            return False\n\n    # Check the main diagonal sum.\n    main_diag_sum = 0\n    for i in range(n):\n        main_diag_sum += matrix[i][i]\n    if main_diag_sum != target_sum:\n        return False\n\n    # Check the anti-diagonal sum.\n    anti_diag_sum = 0\n    for i in range(n):\n        anti_diag_sum += matrix[i][n - 1 - i]\n    if anti_diag_sum != target_sum:\n        return False\n\n    return True"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(text: str) -> str:\n    \"\"\"\n    Reverses only the vowels in a given string.\n    Vowels are 'a', 'e', 'i', 'o', 'u' (case-insensitive); 'y' is not considered a vowel.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a str\")\n\n    VOWELS = frozenset({\"a\", \"e\", \"i\", \"o\", \"u\", \"A\", \"E\", \"I\", \"O\", \"U\"})\n\n    arr = list(text)\n    i, j = 0, len(arr) - 1\n\n    while i < j:\n        if arr[i] not in VOWELS:\n            i += 1\n            continue\n        if arr[j] not in VOWELS:\n            j -= 1\n            continue\n\n        arr[i], arr[j] = arr[j], arr[i]\n        i += 1\n        j -= 1\n\n    return ''.join(arr)"}
