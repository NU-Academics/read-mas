{"task_id": "Mbpp/630", "solution": "def get_coordinates(coord_tuple: tuple[int, int]) -> list[list[int]]:\n    \"\"\"\n    Extracts all adjacent coordinates (3x3 neighborhood) for the given coordinate tuple.\n    The coordinates are returned in row-major order, including the center coordinate.\n    \"\"\"\n    x_center, y_center = coord_tuple\n    adjacent_coords = []\n    for dx in [-1, 0, 1]:\n        for dy in [-1, 0, 1]:\n            adjacent_coords.append([x_center + dx, y_center + dy])\n    return adjacent_coords"}
{"task_id": "Mbpp/629", "solution": "from collections.abc import Iterable\nfrom dataclasses import dataclass\nfrom datetime import datetime\nimport json\nimport os\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input.\"\"\"\n    pass\nclass RepositoryError(Exception):\n    \"\"\"Custom exception for repository errors.\"\"\"\n    pass\nclass Validator:\n    \"\"\"Provides input validation methods.\"\"\"\n    def validate_numbers(self, numbers: Iterable[int]) -> None:\n        \"\"\"Ensures the input is an iterable containing only integers.\"\"\"\n        if not isinstance(numbers, Iterable):\n            raise InvalidInputError(\"input must be an iterable of ints\")\n        for i, v in enumerate(numbers):\n            if not isinstance(v, int):\n                raise InvalidInputError(f\"element {i} is not int: {v!r}\")\nclass EvenSplitter:\n    \"\"\"Contains the core logic for filtering even numbers.\"\"\"\n    def split(self, numbers: list[int]) -> list[int]:\n        \"\"\"Filters a list of numbers, returning only the even ones.\"\"\"\n        return [x for x in numbers if x % 2 == 0]\nclass FileJSONRepository:\n    \"\"\"Handles persistence of result records to a JSON file.\"\"\"\n    def __init__(self, path: str):\n        self._path = path\n\n    def save(self, record: ResultRecord) -> None:\n        \"\"\"Appends a result record to the specified JSON file.\"\"\"\n        try:\n            dir_name = os.path.dirname(self._path)\n            if dir_name:\n                os.makedirs(dir_name, exist_ok=True)\n\n            try:\n                with open(self._path, \"r\", encoding=\"utf-8\") as f:\n                    arr = json.load(f)\n            except (FileNotFoundError, json.JSONDecodeError):\n                arr = []\n\n            arr.append(record.to_dict())\n            with open(self._path, \"w\", encoding=\"utf-8\") as f:\n                json.dump(arr, f, ensure_ascii=False, indent=2)\n        except Exception as e:\n            raise RepositoryError(str(e)) from e\ndef Split(numbers: list[int], persist: bool=False) -> list[int]:\n    \"\"\"\n    Finds even numbers from a list of numbers.\n    Validates input, computes even numbers, and optionally persists the result.\n    \"\"\"\n    validator = Validator()\n    service = EvenSplitter()\n\n    validator.validate_numbers(numbers)\n    result = service.split(numbers)\n\n    if persist:\n        repo = FileJSONRepository(\"results.json\")\n        timestamp_str = datetime.utcnow().isoformat(timespec='seconds') + 'Z'\n        record = ResultRecord(input=list(numbers), result=result, timestamp=timestamp_str)\n        try:\n            repo.save(record)\n        except Exception as e:\n            raise RepositoryError(str(e)) from e\n\n    return result"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers, n):\n    \"\"\"\n    Calculates the sum of XOR of all unordered pairs of numbers in the given list.\n\n    Parameters:\n    - numbers: list of int\n    - n: int, expected length of numbers (must equal len(numbers))\n\n    Returns:\n    - int: sum of xor for all pairs i < j of numbers[i] ^ numbers[j]\n\n    Notes:\n    - Uses an O(n * B) algorithm where B is the number of bits considered (64 by default).\n    - Assumes numbers contains integers. If n does not match len(numbers), raises ValueError.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise ValueError(\"numbers must be a list of integers\")\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer\")\n    if n != len(numbers):\n        raise ValueError(\"n does not match length of numbers\")\n\n    # If fewer than 2 numbers, no pairs exist.\n    if n < 2:\n        return 0\n\n    total_xor_sum = 0\n    MAX_BITS = 64  # default bit width to consider\n\n    for i in range(MAX_BITS):\n        count_ones = 0\n        mask = 1 << i\n        for num in numbers:\n            # Treat numbers as Python ints; for negatives the bit operations will behave appropriately\n            if (num & mask) != 0:\n                count_ones += 1\n        count_zeros = n - count_ones\n        total_xor_sum += count_ones * count_zeros * mask\n\n    return total_xor_sum"}
{"task_id": "Mbpp/635", "solution": "def heap_sort(data: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of integers using the heap sort algorithm.\n    Returns a new sorted list, without modifying the original.\n    \"\"\"\n    arr = list(data)  # Create a mutable copy to perform in-place sort\n    n = len(arr)\n\n    # Build a max-heap from the input array\n    for i in range(n // 2 - 1, -1, -1):\n        _sift_down(arr, i, n - 1)\n\n    # Extract elements one by one from the heap\n    for i in range(n - 1, 0, -1):\n        arr[i], arr[0] = arr[0], arr[i]  # Move current root to end\n        _sift_down(arr, 0, i - 1)  # Call sift_down on the reduced heap\n    return arr"}
{"task_id": "Mbpp/632", "solution": "def move_zero(nums: list, in_place: bool = False) -> list:\n    \"\"\"\n    Moves all zeroes to the end of the given list, preserving the relative\n    order of non-zero elements.\n\n    Args:\n        nums: List of elements where elements equal to 0 are treated as zeros.\n        in_place: If True, modifies the given list in-place and returns it.\n                  If False, returns a new list with zeros moved to the end.\n\n    Returns:\n        A list with zeros moved to the end.\n\n    Example:\n        assert move_zero([1,0,2,0,3,4]) == [1,2,3,4,0,0]\n    \"\"\"\n    ZERO_VAL = 0\n\n    def _move_zero_stable(input_list: list) -> list:\n        \"\"\"\n        Creates a new list with non-zeros in order, then appends zeros.\n        O(n) time, O(n) extra space.\n        \"\"\"\n        result = []\n        zero_count = 0\n        for x in input_list:\n            if x == ZERO_VAL:\n                zero_count += 1\n            else:\n                result.append(x)\n        result.extend([ZERO_VAL] * zero_count)\n        return result\n\n    def _move_zero_inplace(input_list: list) -> list:\n        \"\"\"\n        Modifies the list in-place using a two-pointer technique.\n        O(n) time, O(1) extra space.\n        \"\"\"\n        non_zero_ptr = 0\n        for current_ptr in range(len(input_list)):\n            if input_list[current_ptr] != ZERO_VAL:\n                input_list[non_zero_ptr] = input_list[current_ptr]\n                non_zero_ptr += 1\n\n        for i in range(non_zero_ptr, len(input_list)):\n            input_list[i] = ZERO_VAL\n\n        return input_list\n\n    if in_place:\n        return _move_zero_inplace(nums)\n    else:\n        return _move_zero_stable(nums)"}
{"task_id": "Mbpp/631", "solution": "import os\nimport re\nimport json\nimport uuid\nimport logging\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Tuple, List, Dict, Any\n_logger = logging.getLogger(__name__)\nclass Config:\n    \"\"\"Central configuration for the text utility, including defaults and environment overrides.\"\"\"\n    HISTORY_FILENAME: str = 'history.json'\n    DEFAULT_MODE: str = 'auto'\n\n    def __init__(self, data_dir: Path, max_history_records: int):\n        self.data_dir = data_dir\n        self.MAX_HISTORY_RECORDS = max_history_records\n\n    @staticmethod\n    def from_env() -> 'Config':\n        \"\"\"Constructs a Config instance from environment variables, using defaults if not set.\"\"\"\n        data_dir_str = os.environ.get('TEXTUTILS_DATA_DIR')\n        data_dir = Path(data_dir_str) if data_dir_str else Path.cwd() / 'data'\n\n        max_history_records_str = os.environ.get('TEXTUTILS_MAX_HISTORY_RECORDS')\n        try:\n            max_history_records = int(max_history_records_str) if max_history_records_str else 100\n        except ValueError:\n            max_history_records = 100\n\n        return Config(data_dir, max_history_records)\nclass HistoryRecord:\n    \"\"\"Data transfer object for a single transformation history entry.\"\"\"\n    def __init__(self, record_id: str, timestamp: str, input_text: str, output_text: str, mode: str):\n        self.id = record_id\n        self.timestamp = timestamp\n        self.input = input_text\n        self.output = output_text\n        self.mode = mode\n\n    @classmethod\n    def create_new(cls, input_text: str, output_text: str, mode: str) -> 'HistoryRecord':\n        \"\"\"Creates a new HistoryRecord with a fresh UUID and current timestamp.\"\"\"\n        return cls(\n            record_id=str(uuid.uuid4()),\n            timestamp=datetime.now().isoformat(timespec='seconds') + 'Z',\n            input_text=input_text,\n            output_text=output_text,\n            mode=mode\n        )\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Converts the HistoryRecord instance to a dictionary for serialization.\"\"\"\n        return {\n            \"id\": self.id,\n            \"timestamp\": self.timestamp,\n            \"input\": self.input,\n            \"output\": self.output,\n            \"mode\": self.mode,\n        }\n\n    @classmethod\n    def from_dict(cls, data: Dict[str, Any]) -> 'HistoryRecord':\n        \"\"\"Creates a HistoryRecord instance from a dictionary.\"\"\"\n        return cls(\n            record_id=data['id'],\n            timestamp=data['timestamp'],\n            input_text=data['input'],\n            output_text=data['output'],\n            mode=data['mode']\n        )\nclass TextTransformer:\n    \"\"\"Provides pure functions for text transformation operations.\"\"\"\n    @staticmethod\n    def to_underscore(text: str) -> str:\n        \"\"\"Replaces one or more whitespace characters with a single underscore.\"\"\"\n        return re.sub(r'\\s+', '_', text)\n\n    @staticmethod\n    def to_space(text: str) -> str:\n        \"\"\"Replaces one or more underscores with a single space.\"\"\"\n        return re.sub(r'_+', ' ', text)\n\n    @staticmethod\n    def auto_toggle(text: str) -> Tuple[str, str]:\n        \"\"\"Determines and performs an automatic transformation based on content.\"\"\"\n        has_spaces = re.search(r'\\s', text) is not None\n        has_underscores = '_' in text\n\n        if has_spaces and not has_underscores:\n            return TextTransformer.to_underscore(text), 'to_underscore'\n        elif has_underscores and not has_spaces:\n            return TextTransformer.to_space(text), 'to_space'\n        else:\n            return text, 'none' # No transformation or ambiguous case\nclass ReplacementRepository:\n    \"\"\"Manages persistence and retrieval of transformation history records in a JSON file.\"\"\"\n    def __init__(self, history_file_path: Path, max_records: int):\n        self._history_file_path = history_file_path\n        self._max_records = max_records\n        self._history_file_path.parent.mkdir(parents=True, exist_ok=True)\n\n    def _read_records(self) -> List[HistoryRecord]:\n        \"\"\"Reads all history records from the JSON file.\"\"\"\n        if not self._history_file_path.exists():\n            return []\n        try:\n            with open(self._history_file_path, 'r', encoding='utf-8') as f:\n                data = json.load(f)\n            return [HistoryRecord.from_dict(d) for d in data]\n        except (IOError, json.JSONDecodeError) as e:\n            _logger.warning(f\"Failed to read history from {self._history_file_path}: {e}\")\n            return []\n\n    def _write_records(self, records: List[HistoryRecord]) -> None:\n        \"\"\"Writes history records to the JSON file atomically.\"\"\"\n        temp_file_path = self._history_file_path.with_suffix('.tmp')\n        try:\n            with open(temp_file_path, 'w', encoding='utf-8') as f:\n                json.dump([r.to_dict() for r in records], f, indent=2)\n            os.replace(temp_file_path, self._history_file_path)\n        except IOError as e:\n            _logger.error(f\"Failed to write history to {self._history_file_path}: {e}\")\n            if temp_file_path.exists():\n                try:\n                    os.remove(temp_file_path)\n                except OSError as remove_e:\n                    _logger.error(f\"Failed to remove temporary history file {temp_file_path}: {remove_e}\")\n            raise # Re-raise for outer logging if necessary\n\n    def save(self, record: HistoryRecord) -> None:\n        \"\"\"Appends a new record and truncates the history to the maximum number of records.\"\"\"\n        try:\n            records = self._read_records()\n            records.append(record)\n            if len(records) > self._max_records:\n                records = records[-self._max_records:]\n            self._write_records(records)\n        except Exception as e:\n            _logger.warning(f\"Best-effort history persistence failed for record {record.id}: {e}\")\n\n    def list(self, limit: int | None = None) -> List[HistoryRecord]:\n        \"\"\"Retrieves history records, optionally limited to the most recent entries.\"\"\"\n        records = self._read_records()\n        if limit is not None:\n            return records[-limit:]\n        return records\nclass ReplaceService:\n    \"\"\"Encapsulates the core business logic for text transformations and history management.\"\"\"\n    def __init__(self, repo: 'ReplacementRepository', transformer: 'TextTransformer', config: 'Config'):\n        self._repo = repo\n        self._transformer = transformer\n        self._config = config\n\n    def transform_text(self, text: str, mode: str = 'auto') -> str:\n        \"\"\"Transforms text based on the specified mode and records the operation.\"\"\"\n        output_text: str\n        resolved_mode: str\n\n        if mode == 'auto':\n            output_text, resolved_mode = self._transformer.auto_toggle(text)\n        elif mode == 'to_underscore':\n            output_text = self._transformer.to_underscore(text)\n            resolved_mode = 'to_underscore'\n        else: # mode == 'to_space'\n            output_text = self._transformer.to_space(text)\n            resolved_mode = 'to_space'\n\n        # Persist history as a best-effort operation if a transformation occurred\n        if output_text != text or resolved_mode != 'none':\n            record = HistoryRecord.create_new(text, output_text, resolved_mode)\n            self._repo.save(record)\n\n        return output_text\ndef replace_spaces(text: str, mode: str = 'auto') -> str:\n    \"\"\"\n    Replaces whitespaces with underscores or vice versa in a string.\n\n    Mode 'auto' detects the best transformation. 'to_underscore' forces spaces to underscores,\n    'to_space' forces underscores to spaces.\n    \"\"\"\n    cfg = Config.from_env()\n    cfg.data_dir.mkdir(parents=True, exist_ok=True)\n    repo = ReplacementRepository(cfg.data_dir / cfg.HISTORY_FILENAME, cfg.MAX_HISTORY_RECORDS)\n    svc = ReplaceService(repo, TextTransformer(), cfg)\n    return svc.transform_text(text, mode)"}
{"task_id": "Mbpp/637", "solution": "def noprofit_noloss(cost_price: float, selling_price: float) -> bool:\n    \"\"\"\n    Checks if there is no profit and no loss based on cost and selling prices.\n    Uses a default tolerance of 0.0 for exact equality.\n    \"\"\"\n    DEFAULT_TOLERANCE = 0.0\n    return abs(cost_price - selling_price) <= DEFAULT_TOLERANCE"}
{"task_id": "Mbpp/638", "solution": "import math\ndef wind_chill(velocity_kmh, temperature_celsius):\n    \"\"\"\n    Calculates the wind chill index rounded to the next integer.\n    The velocity is converted from km/h to m/s for use in the standard formula.\n    \"\"\"\n    # Convert wind velocity from km/h to m/s\n    velocity_ms = velocity_kmh / 3.6\n\n    # Calculate the V^0.16 term\n    # The standard formula for wind chill index is WCI = 13.12 + 0.6215*T - 11.37*V^0.16 + 0.3965*T*V^0.16\n    # For these constants to align with the example, V is interpreted in m/s.\n    v_power = velocity_ms**0.16\n\n    wind_chill_val = (13.12 +\n                      0.6215 * temperature_celsius -\n                      11.37 * v_power +\n                      0.3965 * temperature_celsius * v_power)\n\n    # Round to the next integer (ceiling)\n    return math.ceil(wind_chill_val)"}
{"task_id": "Mbpp/643", "solution": "def text_match_wordz_middle(text):\n    \"\"\"\n    Checks if the character 'z' appears in a string, but not at the first or last position.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a str\")\n    # Iterate from the second character (index 1) up to, but not including, the last character.\n    # This ensures 'z' is not at the start or end.\n    for i in range(1, len(text) - 1):\n        if text[i] == 'z':\n            return True\n    return False"}
{"task_id": "Mbpp/639", "solution": "def sample_nam(names: list[str]) -> int:\n    \"\"\"\n    Sums the length of names after removing those starting with a lowercase letter.\n    \"\"\"\n    from typing import Optional\n\n    class NameListDTO:\n        def __init__(self, names: list[str]) -> None:\n            self.names = names\n\n        def validate(self) -> None:\n            if not isinstance(self.names, list):\n                raise TypeError(\"names must be a list\")\n            for n in self.names:\n                if not isinstance(n, str):\n                    raise TypeError(\"all items must be strings\")\n                if n == \"\":\n                    raise ValueError(\"empty strings are not allowed\")\n\n    class NamesRepository:\n        def __init__(self, initial: Optional[list[str]] = None) -> None:\n            self._names = []\n            if initial is not None:\n                self.set_all(initial)\n\n        def get_all(self) -> list[str]:\n            return list(self._names)\n\n        def set_all(self, names: list[str]) -> None:\n            dto = NameListDTO(names)\n            dto.validate()\n            self._names = list(names)\n\n    class StringUtils:\n        @staticmethod\n        def is_start_lowercase(name: str) -> bool:\n            if name == \"\":\n                raise ValueError(\"name must be non-empty\")\n            first = name[0]\n            return 'a' <= first <= 'z'\n\n    class NameFilter:\n        def filter_starting_with_upper(self, names: list[str]) -> list[str]:\n            result = []\n            for n in names:\n                if not isinstance(n, str):\n                    raise TypeError(\"item is not a string\")\n                try:\n                    if not StringUtils.is_start_lowercase(n):\n                        result.append(n)\n                except ValueError:\n                    raise ValueError(\"empty string encountered\")\n            return result\n\n    class LengthCalculator:\n        def sum_lengths(self, names: list[str]) -> int:\n            return sum(len(n) for n in names)\n\n    class NameService:\n        def __init__(self, repo: NamesRepository, name_filter: NameFilter, calculator: LengthCalculator) -> None:\n            self.repo = repo\n            self.name_filter = name_filter\n            self.calculator = calculator\n\n        def compute_total_length(self, names: Optional[list[str]] = None) -> int:\n            if names is not None:\n                dto = NameListDTO(names)\n                dto.validate()\n                self.repo.set_all(names)\n            stored = self.repo.get_all()\n            filtered = self.name_filter.filter_starting_with_upper(stored)\n            return self.calculator.sum_lengths(filtered)\n\n    class CLIController:\n        def __init__(self, service: NameService) -> None:\n            self.service = service\n\n        def sample_nam(self, names: list[str]) -> int:\n            dto = NameListDTO(names)\n            dto.validate()\n            return self.service.compute_total_length(names)\n\n    repo = NamesRepository(initial=names)\n    name_filter = NameFilter()\n    calculator = LengthCalculator()\n    service = NameService(repo, name_filter, calculator)\n    controller = CLIController(service)\n    return controller.sample_nam(names)"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(arr, k):\n    \"\"\"Reverses the first k elements of an array and returns a new array.\"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(f\"arr must be a list, got {type(arr).__name__}\")\n    if not isinstance(k, int):\n        raise TypeError(f\"k must be an int, got {type(k).__name__}\")\n    if k < 0 or k > len(arr):\n        raise ValueError(f\"k must be between 0 and len(arr) inclusive (got {k})\")\n    if k == 0 or len(arr) == 0:\n        return arr.copy()\n    prefix_rev = arr[:k][::-1]\n    return prefix_rev + arr[k:]"}
