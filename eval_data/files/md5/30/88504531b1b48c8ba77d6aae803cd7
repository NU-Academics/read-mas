{"task_id": "Mbpp/749", "solution": "def sort_numeric_strings(strings: list) -> list:\n    \"\"\"\n    Sorts a list of strings of numbers numerically, returning a list of actual numbers.\n    Handles integers, floats, and exponential notation, converting integral floats to integers.\n    \"\"\"\n    import re\n    from typing import List, Union, Any\n\n    class SortError(Exception):\n        \"\"\"Base exception for sorting errors.\"\"\"\n        pass\n\n    class SortInputError(SortError):\n        \"\"\"Raised when the input list itself is invalid.\"\"\"\n        pass\n\n    class SortParseError(SortError):\n        \"\"\"Raised when an individual string cannot be parsed into a number.\"\"\"\n        pass\n\n    class ValidationUtils:\n        \"\"\"Utility class for input validation and sanitization.\"\"\"\n        @staticmethod\n        def is_iterable_of_strings(obj: Any) -> bool:\n            \"\"\"Checks if an object is an iterable of strings.\"\"\"\n            if not isinstance(obj, (list, tuple)):\n                return False\n            return all(isinstance(item, str) for item in obj)\n\n        @staticmethod\n        def sanitize_string(s: str) -> str:\n            \"\"\"Trims leading/trailing whitespace from a string.\"\"\"\n            return s.strip()\n\n    class NumericStringParser:\n        \"\"\"Parses individual numeric strings into int or float types.\"\"\"\n        def _to_int_if_integral(self, value: float) -> Union[int, float]:\n            \"\"\"Converts a float to an int if its value is integral.\"\"\"\n            if value.is_integer():\n                return int(value)\n            return value\n\n        def parse(self, s: str, convert_integral_floats_to_int: bool = True) -> Union[int, float]:\n            \"\"\"Parses a string into an int or float, raising SortParseError on failure.\"\"\"\n            s = ValidationUtils.sanitize_string(s)\n            if not s:\n                raise SortParseError(\"Empty string cannot be parsed as a number.\")\n            try:\n                # Try parsing as an integer first if it matches integer pattern\n                if re.fullmatch(r'[+-]?\\d+', s):\n                    return int(s)\n\n                # Otherwise, parse as a float (supports decimal and exponential notation)\n                val = float(s)\n                if convert_integral_floats_to_int:\n                    return self._to_int_if_integral(val)\n                return val\n            except ValueError:\n                raise SortParseError(f\"Cannot parse '{s}' as a number.\")\n\n    class SortService:\n        \"\"\"Orchestrates the parsing and numeric sorting of string lists.\"\"\"\n        def __init__(self, parser: NumericStringParser, repository=None):\n            self.parser = parser\n            self.repository = repository # Optional repository, not used in this context\n\n        def sort_numeric_strings(self, strings: List[str]) -> List[Union[int, float]]:\n            \"\"\"Validates, parses, and sorts a list of numeric strings.\"\"\"\n            if not ValidationUtils.is_iterable_of_strings(strings):\n                raise SortInputError(\"Input must be an iterable of strings.\")\n\n            parsed_numbers = []\n            for i, s in enumerate(strings):\n                try:\n                    parsed_numbers.append(self.parser.parse(s))\n                except SortParseError as e:\n                    raise SortParseError(f\"Error at index {i} with value '{s}': {e}\") from e\n\n            parsed_numbers.sort()\n            return parsed_numbers\n\n    class SortController:\n        \"\"\"A thin adapter layer for the sorting functionality.\"\"\"\n        def __init__(self, service: SortService):\n            self.service = service\n\n        def sort(self, strings: List[str]) -> List[Union[int, float]]:\n            \"\"\"Delegates sorting to the SortService.\"\"\"\n            return self.service.sort_numeric_strings(strings)\n\n    # Main execution flow for the sort_numeric_strings function\n    parser = NumericStringParser()\n    service = SortService(parser)\n    controller = SortController(service)\n    return controller.sort(strings)"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr):\n    \"\"\"\n    Return True if the given array (list) represents a min-heap.\n    Empty or single-element lists are valid min-heaps.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"arr must be a list\")\n\n    n = len(arr)\n    # Only need to check parent nodes: indices 0 .. n//2 - 1\n    for i in range(n // 2):\n        left = 2 * i + 1\n        if left < n and arr[i] > arr[left]:\n            return False\n        right = left + 1\n        if right < n and arr[i] > arr[right]:\n            return False\n    return True"}
{"task_id": "Mbpp/752", "solution": "import os\nimport threading\nimport json\nimport logging\nfrom typing import Optional, Any\n_LOGGER = logging.getLogger(__name__)\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass CacheError(Exception):\n    \"\"\"Custom exception for issues with the cache repository.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\ndef validate_index(n: Any) -> int:\n    \"\"\"Validate that n is an integer greater than or equal to 0.\"\"\"\n    if isinstance(n, bool):\n        raise InvalidInputError(\"n must be an integer >= 0\")\n    try:\n        ival = int(n)\n    except (TypeError, ValueError):\n        raise InvalidInputError(\"n must be an integer >= 0\")\n    if ival < 0:\n        raise InvalidInputError(\"n must be >= 0\")\n    return ival\ndef pow2(n: int) -> int:\n    \"\"\"Returns 2 to the power of n, using bit shift for efficiency.\"\"\"\n    return 1 << n\nclass JacobsthalService:\n    \"\"\"Provides algorithms to compute Jacobsthal numbers.\"\"\"\n    ALLOWED_METHODS = {\"auto\", \"closed_form\", \"iterative\"}\n\n    def compute_closed_form(self, n: int) -> int:\n        \"\"\"Computes J(n) using the closed-form formula (2^n - (-1)^n) // 3.\"\"\"\n        numerator = pow2(n) - ((-1) ** n)\n        return numerator // 3\n\n    def compute_iterative(self, n: int) -> int:\n        \"\"\"Computes J(n) using the iterative recurrence J(n)=J(n-1)+2*J(n-2).\"\"\"\n        if n == 0:\n            return 0\n        if n == 1:\n            return 1\n        a, b = 0, 1\n        for _ in range(2, n + 1):\n            a, b = b, a + 2 * b\n        return b\n\n    def compute(self, n: int, method: str = 'auto') -> int:\n        \"\"\"Selects and runs the appropriate computation method.\"\"\"\n        if method not in self.ALLOWED_METHODS:\n            raise InvalidInputError(f\"Invalid method: {method}. Must be one of {self.ALLOWED_METHODS}\")\n\n        if method == 'closed_form' or method == 'auto':\n            return self.compute_closed_form(n)\n        elif method == 'iterative':\n            return self.compute_iterative(n)\n        return self.compute_closed_form(n)\nclass CacheRepository:\n    \"\"\"Simple JSON file-based key-value cache for computed values.\"\"\"\n    DEFAULT_CACHE_FILENAME = os.path.join(os.path.expanduser(\"~\"), \".cache\", \"jacobsthal_cache.json\")\n    CACHE_FORMAT_VERSION = 1\n\n    def __init__(self, path: str = DEFAULT_CACHE_FILENAME) -> None:\n        self._path = os.path.expanduser(path)\n        self._lock = threading.Lock()\n        try:\n            os.makedirs(os.path.dirname(self._path), exist_ok=True)\n        except OSError as e:\n            raise CacheError(f\"Could not create cache directory {os.path.dirname(self._path)}: {e}\") from e\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a cached value by index n, or None if not found/error.\"\"\"\n        with self._lock:\n            try:\n                data = self._load()\n                return data.get(\"values\", {}).get(str(n))\n            except CacheError as e:\n                _LOGGER.warning(f\"Failed to read from cache at {self._path}: {e}\")\n            return None\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a value in the cache, persisting it to file.\"\"\"\n        with self._lock:\n            try:\n                data = self._load()\n                if \"values\" not in data:\n                    data[\"values\"] = {}\n                data[\"values\"][str(n)] = value\n                data[\"format_version\"] = self.CACHE_FORMAT_VERSION\n                self._save(data)\n            except CacheError as e:\n                _LOGGER.warning(f\"Failed to write to cache at {self._path}: {e}\")\n                raise\n\n    def _load(self) -> dict:\n        \"\"\"Loads cache data from the JSON file.\"\"\"\n        if not os.path.exists(self._path):\n            return {\"format_version\": self.CACHE_FORMAT_VERSION, \"values\": {}}\n\n        try:\n            with open(self._path, 'r', encoding='utf-8') as f:\n                data = json.load(f)\n            if data.get(\"format_version\", 0) < self.CACHE_FORMAT_VERSION:\n                _LOGGER.info(f\"Cache file {self._path} has old format version {data.get('format_version', 0)}. Will upgrade on next save.\")\n            return data\n        except (IOError, json.JSONDecodeError) as e:\n            raise CacheError(f\"Error loading cache file {self._path}: {e}\") from e\n\n    def _save(self, data: dict) -> None:\n        \"\"\"Atomically saves cache data to the JSON file.\"\"\"\n        temp_path = self._path + \".tmp\"\n        try:\n            with open(temp_path, 'w', encoding='utf-8') as f:\n                json.dump(data, f)\n            os.replace(temp_path, self._path)\n        except IOError as e:\n            if os.path.exists(temp_path):\n                os.remove(temp_path)\n            raise CacheError(f\"Error saving cache file {self._path}: {e}\") from e\nclass JacobsthalController:\n    \"\"\"Coordinates validation, caching, and computation of Jacobsthal numbers.\"\"\"\n    def __init__(self, service: JacobsthalService, cache: Optional[CacheRepository] = None) -> None:\n        self.service = service\n        self.cache = cache\n\n    def jacobsthal_num(self, n: Any, method: str = 'auto', use_cache: bool = False) -> int:\n        \"\"\"Primary facade method to compute the nth Jacobsthal number.\"\"\"\n        n_validated = validate_index(n)\n\n        result = None\n        if use_cache and self.cache:\n            try:\n                result = self._get_from_cache(n_validated)\n                if result is not None:\n                    _LOGGER.debug(f\"Cache hit for J({n_validated})\")\n                    return result\n            except CacheError as e:\n                _LOGGER.warning(f\"Cache read error for J({n_validated}): {e}. Computing without cache.\")\n\n        _LOGGER.debug(f\"Cache miss or disabled for J({n_validated}). Computing...\")\n        result = self.service.compute(n_validated, method)\n\n        if use_cache and self.cache:\n            try:\n                self._store_in_cache(n_validated, result)\n            except CacheError as e:\n                _LOGGER.warning(f\"Cache write error for J({n_validated}): {e}. Result not cached.\")\n\n        return result\n\n    def _get_from_cache(self, n: int) -> Optional[int]:\n        \"\"\"Wrapper to safely retrieve from cache.\"\"\"\n        if self.cache:\n            return self.cache.get(n)\n        return None\n\n    def _store_in_cache(self, n: int, value: int) -> None:\n        \"\"\"Wrapper to safely store in cache.\"\"\"\n        if self.cache:\n            self.cache.set(n, value)\n_default_service = JacobsthalService()\n_default_cache_repo: Optional[CacheRepository] = None\ndef jacobsthal_num(n: int, method: str = 'auto', use_cache: bool = False) -> int:\n    \"\"\"\n    Finds the nth Jacobsthal number using specified method and optional caching.\n    J(0)=0, J(1)=1, J(n)=J(n-1)+2*J(n-2).\n    \"\"\"\n    global _default_cache_repo\n\n    cache_to_use: Optional[CacheRepository] = None\n    if use_cache:\n        if _default_cache_repo is None:\n            try:\n                _default_cache_repo = CacheRepository()\n            except CacheError as e:\n                _LOGGER.warning(f\"Could not initialize default cache: {e}. Proceeding without caching.\")\n                _default_cache_repo = None\n        cache_to_use = _default_cache_repo\n\n    controller = JacobsthalController(service=_default_service, cache=cache_to_use)\n    return controller.jacobsthal_num(n, method=method, use_cache=use_cache)"}
{"task_id": "Mbpp/753", "solution": "import heapq\ndef min_k(records, k):\n    \"\"\"\n    Finds the minimum k records from a list of (name, value) tuples.\n    Records are sorted by value ascending, then by name alphabetically for ties.\n    \"\"\"\n    if k == 0:\n        return []\n\n    # Validate records is iterable and k is int and non-negative\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer\")\n    if k < 0:\n        raise ValueError(\"k must be non-negative\")\n\n    # Convert input tuples to a format (value, name) for direct sorting\n    processed_records = []\n    for rec in records:\n        if not (isinstance(rec, (list, tuple)) and len(rec) == 2):\n            raise ValueError(f\"each record must be a 2-tuple, got: {rec!r}\")\n        name, value = rec\n        if not isinstance(name, str):\n            raise TypeError(f\"record name must be a string, got: {type(name).__name__}\")\n        try:\n            val = float(value)\n        except Exception:\n            raise TypeError(f\"record value must be numeric, got: {value!r}\")\n        processed_records.append((val, name))\n\n    num_records = len(processed_records)\n\n    if k >= num_records:\n        # Return all records sorted by (value, name).\n        selected_records = sorted(processed_records)\n    else:\n        # Use heapq.nsmallest for efficient retrieval of the k smallest records.\n        selected_records = heapq.nsmallest(k, processed_records)\n\n    # Convert the selected records back to the original (name, value) format.\n    return [(name, int(value) if value.is_integer() else value) for value, name in selected_records]"}
{"task_id": "Mbpp/755", "solution": "import math\ndef second_smallest(numbers: list) -> float:\n    \"\"\"\n    Finds the second smallest number in a list of numbers using a single pass.\n    Assumes the input list contains at least two numeric values.\n    \"\"\"\n    min1 = math.inf\n    min2 = math.inf\n    for num in numbers:\n        if num < min1:\n            min2 = min1\n            min1 = num\n        elif num < min2:\n            min2 = num\n    return min2"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds elements common to three lists that appear at the same index.\n    The function returns a list of these common elements.\n    \"\"\"\n\n    # --- 1. Define Exceptions (from src/extract_index/exceptions.py) ---\n    class ValidationError(Exception):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class LimitExceededError(Exception):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    # --- 2. Define Models (from src/extract_index/models.py) ---\n    class ExtractRequest:\n        def __init__(self, l1_model: list, l2_model: list, l3_model: list) -> None:\n            self.l1 = l1_model\n            self.l2 = l2_model\n            self.l3 = l3_model\n\n    class ExtractResult:\n        def __init__(self, result_model: list) -> None:\n            self.result = result_model\n\n    # --- 3. Define Configuration Constant (from src/extract_index/config.py) ---\n    # This constant is used for both general max length and comparator-specific max length.\n    DEFAULT_MAX_LENGTH = 1_000_000\n\n    # --- 4. Define Utility Function (from src/extract_index/utils.py) ---\n    def validate_lists(l1_val: any, l2_val: any, l3_val: any, max_len: int = DEFAULT_MAX_LENGTH) -> None:\n        \"\"\"\n        Validates inputs are list-like, not None, and their lengths do not exceed max_len.\n        Raises ValidationError or LimitExceededError on invalid input.\n        \"\"\"\n        for idx, l_item in enumerate((l1_val, l2_val, l3_val), start=1):\n            if l_item is None:\n                raise ValidationError(f\"List {idx} is None\")\n            # Check for list-like (iterable with length and item access)\n            if not hasattr(l_item, \"__len__\") or not hasattr(l_item, \"__getitem__\"):\n                raise ValidationError(f\"List {idx} must be list-like (have __len__ and __getitem__ methods).\")\n            if len(l_item) > max_len:\n                raise LimitExceededError(f\"List {idx} length {len(l_item)} exceeds max {max_len}\")\n\n    # --- 5. Define Comparator Class (from src/extract_index/comparator.py) ---\n    class ListComparator:\n        def __init__(self, max_len: int = DEFAULT_MAX_LENGTH) -> None:\n            self._max_len = max_len\n\n        def compare(self, l1_comp: list, l2_comp: list, l3_comp: list, max_len_override: int | None = None) -> list:\n            \"\"\"\n            Compares three lists element-wise at the same indices up to an effective limit.\n            Returns a list of elements found to be common.\n            \"\"\"\n            limit = self._max_len if max_len_override is None else max_len_override\n\n            min_list_len = min(len(l1_comp), len(l2_comp), len(l3_comp))\n\n            # Raise an error if the actual minimum list length exceeds the overall processing limit.\n            if min_list_len > limit:\n                raise LimitExceededError(f\"Minimum list length {min_list_len} exceeds effective processing limit: {limit}\")\n\n            # Determine the actual number of iterations, bounded by the shortest list and the limit.\n            effective_iter_len = min(min_list_len, limit)\n\n            result_list: list = []\n            for i in range(effective_iter_len):\n                if l1_comp[i] == l2_comp[i] == l3_comp[i]:\n                    result_list.append(l1_comp[i])\n            return result_list\n\n    # --- 6. Define Service Class (from src/extract_index/service.py) ---\n    class ExtractService:\n        def __init__(self, comparator: ListComparator, validator: callable) -> None:\n            self._comparator = comparator\n            self._validator = validator\n\n        def extract(self, request: ExtractRequest) -> ExtractResult:\n            \"\"\"\n            Orchestrates validation and comparison to extract common elements.\n            Returns an ExtractResult object.\n            \"\"\"\n            # Validate individual lists before comparison.\n            self._validator(request.l1, request.l2, request.l3, max_len=DEFAULT_MAX_LENGTH)\n            # Perform the comparison, explicitly passing the max_len.\n            result_data = self._comparator.compare(request.l1, request.l2, request.l3, max_len_override=DEFAULT_MAX_LENGTH)\n            return ExtractResult(result_data)\n\n    # --- 7. Define Controller Class (from src/extract_index/controller.py) ---\n    class ExtractController:\n        def __init__(self, service: ExtractService) -> None:\n            self._service = service\n\n        def extract_index_list(self, l1_ctrl: list, l2_ctrl: list, l3_ctrl: list) -> list:\n            \"\"\"\n            Public entry point for library users.\n            Creates request DTO, calls the service, and returns the list of results.\n            \"\"\"\n            req = ExtractRequest(l1_ctrl, l2_ctrl, l3_ctrl)\n            result_obj = self._service.extract(req)\n            return result_obj.result\n\n    # --- Main orchestration logic (from src/extract_index/__init__.py) ---\n    # Instantiate the dependency graph.\n    comparator = ListComparator()\n    service = ExtractService(comparator, validate_lists)\n    controller = ExtractController(service)\n\n    # Call the controller's method which encapsulates the full logic.\n    return controller.extract_index_list(l1, l2, l3)"}
{"task_id": "Mbpp/757", "solution": "from collections import Counter\nfrom typing import List\ndef count_reverse_pairs(strings: List[str]) -> int:\n    \"\"\"\n    Counts pairs of reverse strings in the given list, case-sensitively.\n    Each pair is counted once, and palindromes contribute combinations of their occurrences.\n    \"\"\"\n    def normalize(s: str) -> str:\n        # Defaulting to case-sensitive and stripping whitespace.\n        return s.strip()\n\n    def reverse(s: str) -> str:\n        return s[::-1]\n\n    # Count occurrences of normalized strings\n    norm_counts = Counter(normalize(s) for s in strings)\n    total_pairs = 0\n    seen = set()\n\n    for s, count_s in norm_counts.items():\n        if s in seen:\n            continue\n\n        rev_s = reverse(s)\n\n        if rev_s in norm_counts:\n            count_rev_s = norm_counts[rev_s]\n\n            if s == rev_s:\n                # If a string is its own reverse (palindrome or empty),\n                # pairs are N * (N - 1) // 2 combinations.\n                total_pairs += count_s * (count_s - 1) // 2\n            else:\n                # If s and rev_s are distinct, pairs are N * M.\n                total_pairs += count_s * count_rev_s\n\n            # Mark both the string and its reverse as seen to avoid double-counting pairs.\n            seen.add(s)\n            seen.add(rev_s)\n\n    return total_pairs"}
{"task_id": "Mbpp/758", "solution": "def unique_sublists(lists):\n    \"\"\"\n    Counts lists within a list, converting each to a tuple, and returns a dictionary\n    mapping the unique tuples to their occurrence counts.\n    \"\"\"\n    counts = {}\n\n    def _is_iterable_but_not_string(obj):\n        \"\"\"Checks if an object is iterable but not a string or bytes.\"\"\"\n        return hasattr(obj, '__iter__') and not isinstance(obj, (str, bytes))\n\n    def _convert_to_hashable_tuple(item, current_depth=0):\n        \"\"\"Recursively converts iterable elements within an item to tuples for hashing.\"\"\"\n        max_recursion_depth = 10\n\n        if current_depth >= max_recursion_depth:\n            # If recursion depth is exceeded, convert the current item directly to a tuple\n            # without further deep processing, to prevent infinite recursion on malicious inputs.\n            return tuple(item) if _is_iterable_but_not_string(item) else item\n\n        if _is_iterable_but_not_string(item):\n            # If the item is an iterable (and not a string/bytes), recursively convert its elements.\n            return tuple(_convert_to_hashable_tuple(element, current_depth + 1) for element in item)\n        else:\n            # If it's a scalar (or string/bytes), return it as is.\n            return item\n\n    # Iterate through each sublist in the main list.\n    for sublist in lists:\n        # Convert the current sublist (and any nested lists within it) into a hashable tuple.\n        hashable_key = _convert_to_hashable_tuple(sublist, 0)\n\n        # Increment the count for this unique tuple in the dictionary.\n        counts[hashable_key] = counts.get(hashable_key, 0) + 1\n\n    return counts"}
