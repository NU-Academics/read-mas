{"task_id": "Mbpp/445", "solution": "def index_multiplication(a, b):\n    \"\"\"\n    Performs index-wise multiplication of tuple elements in two nested tuples.\n\n    Example:\n    assert index_multiplication(\n        ((1, 3), (4, 5), (2, 9), (1, 10)),\n        ((6, 7), (3, 9), (1, 1), (7, 3))\n    ) == ((6, 21), (12, 45), (2, 9), (7, 30))\n    \"\"\"\n    result_outer = []\n    for inner_tuple_a, inner_tuple_b in zip(a, b):\n        result_inner = []\n        for element_a, element_b in zip(inner_tuple_a, inner_tuple_b):\n            result_inner.append(element_a * element_b)\n        result_outer.append(tuple(result_inner))\n    return tuple(result_outer)"}
{"task_id": "Mbpp/446", "solution": "from collections import Counter\ndef count_Occurrence(tuple_data, items):\n    \"\"\"\n    Counts the total occurrences of elements from a list within a tuple.\n    Each unique item in the 'items' list contributes its count from the 'tuple_data'.\n    \"\"\"\n    data_counts = Counter(tuple_data)\n    total_occurrence = 0\n    for item in set(items):\n        total_occurrence += data_counts.get(item, 0)\n    return total_occurrence"}
{"task_id": "Mbpp/440", "solution": "def find_adverb_position(sentence: str) -> Optional[Tuple[int, int, str]]:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence using a regex heuristic.\n    Returns a tuple (start_index, end_index, adverb_text) or None if no adverb is found.\n    \"\"\"\n    import re\n    from typing import List, Optional, Tuple, Set\n\n    def strip_punct(word: str) -> str:\n        \"\"\"Strips leading/trailing punctuation from a word.\"\"\"\n        return word.strip(\".,!?:;\\\"'\")\n\n    class Config:\n        \"\"\"Holds configuration constants for the adverb finder.\"\"\"\n        EXCEPTIONS_LIST: Set[str] = {\"family\", \"only\", \"sly\"}\n\n    class Token:\n        \"\"\"Represents a token with its text and character offsets.\"\"\"\n        def __init__(self, text: str, start: int, end: int):\n            self.text = text\n            self.start = start\n            self.end = end\n\n        def __repr__(self) -> str:\n            return f\"Token(text='{self.text}', start={self.start}, end={self.end})\"\n\n    class TokenWithTag(Token):\n        \"\"\"Extends Token with a Part-of-Speech tag.\"\"\"\n        def __init__(self, text: str, start: int, end: int, tag: str):\n            super().__init__(text, start, end)\n            self.tag = tag\n\n        def __repr__(self) -> str:\n            return f\"TokenWithTag(text='{self.text}', start={self.start}, end={self.end}, tag='{self.tag}')\"\n\n    class Adverb:\n        \"\"\"Represents a found adverb with its start, end, and text.\"\"\"\n        def __init__(self, start: int, end: int, text: str):\n            self.start = start\n            self.end = end\n            self.text = text\n\n        def to_tuple(self) -> Tuple[int, int, str]:\n            \"\"\"Converts the adverb object to a tuple format.\"\"\"\n            return (self.start, self.end, self.text)\n\n    class Tokenizer:\n        \"\"\"Tokenizes a sentence into word-like tokens with their character offsets.\"\"\"\n        WORD_RE = re.compile(r\"\\b\\w[\\w'-]*\\b\")\n\n        def tokenize(self, sentence: str) -> List[Token]:\n            \"\"\"Finds word-like substrings and computes their start/end offsets.\"\"\"\n            matches = list(self.WORD_RE.finditer(sentence))\n            tokens = [Token(text=match.group(0), start=match.start(), end=match.end()) for match in matches]\n            return tokens\n\n    class RegexPOSTagger:\n        \"\"\"A heuristic POS tagger that identifies adverbs based on the 'ly' suffix.\"\"\"\n        ADVERB_SUFFIX = \"ly\"\n\n        def __init__(self, exceptions: Set[str]):\n            self.exceptions = exceptions\n\n        def tag(self, tokens: List[Token]) -> List[TokenWithTag]:\n            \"\"\"Tags tokens as 'ADV' if they end with 'ly' and are not in exceptions.\"\"\"\n            tagged = []\n            for t in tokens:\n                word_for_tagging = strip_punct(t.text).lower()\n                tag = \"ADV\" if word_for_tagging.endswith(self.ADVERB_SUFFIX) and word_for_tagging not in self.exceptions else \"OTHER\"\n                tagged.append(TokenWithTag(text=t.text, start=t.start, end=t.end, tag=tag))\n            return tagged\n\n    class AdverbFinderService:\n        \"\"\"Orchestrates tokenization and POS tagging to find the first adverb.\"\"\"\n        def __init__(self, tagger, tokenizer):\n            self.tagger = tagger\n            self.tokenizer = tokenizer\n\n        def find_first_adverb(self, sentence: str) -> Optional[Adverb]:\n            \"\"\"Finds the first adverb in the sentence and returns an Adverb object.\"\"\"\n            tokens = self.tokenizer.tokenize(sentence)\n            tagged_tokens = self.tagger.tag(tokens)\n\n            for tt in tagged_tokens:\n                if tt.tag == \"ADV\":\n                    stripped_text = strip_punct(tt.text)\n                    new_end = tt.start + len(stripped_text)\n                    return Adverb(start=tt.start, end=new_end, text=stripped_text)\n            return None\n\n        def find_adverb_position(self, sentence: str) -> Optional[Tuple[int, int, str]]:\n            \"\"\"A convenience wrapper that returns the adverb as a tuple or None.\"\"\"\n            adverb = self.find_first_adverb(sentence)\n            return adverb.to_tuple() if adverb else None\n\n    # Main logic to instantiate components and call the service\n    tagger_instance = RegexPOSTagger(exceptions=Config.EXCEPTIONS_LIST)\n    tokenizer_instance = Tokenizer()\n    service_instance = AdverbFinderService(tagger=tagger_instance, tokenizer=tokenizer_instance)\n\n    result = service_instance.find_adverb_position(sentence)\n    return result"}
