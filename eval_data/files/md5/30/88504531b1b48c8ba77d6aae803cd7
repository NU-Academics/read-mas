{"task_id": "Mbpp/12", "solution": "def sort_matrix(matrix: list[list[float]]) -> list[list[float]]:\n    \"\"\"Sorts a matrix by the sum of its rows in ascending order.\n    The sorting is stable, preserving the original order of rows with equal sums.\"\"\"\n    return sorted(matrix, key=lambda row: sum(row))"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    This is equivalent to finding the minimal period length of the string using the KMP LPS array.\n    \"\"\"\n    n = len(s)\n\n    # Compute the Longest Prefix Suffix (LPS) array for string s.\n    # lps[i] = length of the longest proper prefix of s[:i+1] which is also a suffix of s[:i+1]\n    lps = [0] * n\n    length = 0  # length of the previous longest prefix suffix\n    i = 1\n    while i < n:\n        if s[i] == s[length]:\n            length += 1\n            lps[i] = length\n            i += 1\n        else:\n            if length != 0:\n                length = lps[length - 1]\n            else:\n                lps[i] = 0\n                i += 1\n\n    potential_period = n - lps[n - 1]\n    if potential_period != 0 and n % potential_period == 0:\n        return potential_period\n    return n"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(s: str, ch: str) -> str:\n    \"\"\"Removes the first and last occurrence of a given character from the string.\"\"\"\n    first_idx = s.find(ch)\n    if first_idx == -1:\n        return s\n\n    last_idx = s.rfind(ch)\n\n    if first_idx == last_idx:\n        # Only one occurrence\n        return s[:first_idx] + s[first_idx + 1:]\n    else:\n        # Remove both first and last occurrences using slicing.\n        return s[:first_idx] + s[first_idx + 1:last_idx] + s[last_idx + 1:]"}
{"task_id": "Mbpp/14", "solution": "def find_Volume(base, triangle_height, length):\n    \"\"\"\n    Calculates the volume of a triangular prism.\n    The volume is derived from the area of the triangular base multiplied by the prism's length.\n    \"\"\"\n    triangle_area = 0.5 * base * triangle_height\n    volume = triangle_area * length\n    return volume"}
{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(s, d):\n    \"\"\"\n    Removes characters from the first string that are present in the second string.\n    Uses a set for efficient lookup and a list for building the result.\n    \"\"\"\n    if not d:\n        return s\n\n    dirty_set = set(d)\n    result_chars = []\n    for char in s:\n        if char not in dirty_set:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/57", "solution": "from typing import List\ndef find_Max_Num(digits: List[int]) -> int:\n    \"\"\"\n    Finds the largest number that can be formed with the given list of digits.\n    Assumes input `digits` contains only integers from 0 to 9.\n    \"\"\"\n    if not digits:\n        return 0\n\n    # Sort the digits in descending order to form the largest number\n    sorted_digits = sorted(digits, reverse=True)\n\n    # Convert digits to strings, join them, and convert the result to an integer\n    return int(''.join(str(d) for d in sorted_digits))"}
{"task_id": "Mbpp/19", "solution": "def test_duplicate(nums):\n    \"\"\"\n    Checks if the given array of integers contains any duplicate element.\n    It uses a set to efficiently track seen elements.\n    \"\"\"\n    seen = set()\n    for num in nums:\n        if num in seen:\n            return True\n        seen.add(num)\n    return False"}
{"task_id": "Mbpp/56", "solution": "def check(n: int) -> bool:\n    \"\"\"Checks if n is one less than twice its reverse.\"\"\"\n\n    def _reverse_integer_inline(num: int) -> int:\n        \"\"\"Reverses the digits of an integer, reapplying its original sign.\"\"\"\n        sign = -1 if num < 0 else 1\n        abs_num_str = str(abs(num))\n        reversed_abs_num_str = abs_num_str[::-1]\n        return sign * int(reversed_abs_num_str)\n\n    reversed_n = _reverse_integer_inline(n)\n    return n == 2 * reversed_n - 1"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(m: int) -> bool:\n    # A Woodall number m satisfies m = n * 2^n - 1 for some integer n >= 1.\n    # This is equivalent to m + 1 = n * 2^n.\n    if not isinstance(m, int):\n        raise TypeError(\"m must be an integer\")\n    if m < 1:\n        return False\n\n    target_sum = m + 1\n    n = 1\n    while True:\n        # Calculate n * 2^n efficiently using bit shift.\n        current_product = n * (1 << n)\n\n        if current_product == target_sum:\n            return True\n        elif current_product > target_sum:\n            # If n * 2^n exceeds m + 1, no larger n will satisfy the condition.\n            return False\n\n        n += 1"}
