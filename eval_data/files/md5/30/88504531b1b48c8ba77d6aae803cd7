{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"Checks if a number is undulating, meaning its digits alternate between exactly two different digits.\"\"\"\n    s = str(number)\n    n = len(s)\n\n    if n < 2:\n        return False\n\n    digit1 = s[0]\n    digit2 = ''\n\n    # Find the second distinct digit\n    for i in range(1, n):\n        if s[i] != digit1:\n            digit2 = s[i]\n            break\n\n    # If no second distinct digit is found (e.g., 111, 222), it's not undulating\n    if digit2 == '':\n        return False\n\n    # Check for alternating pattern\n    for i in range(n):\n        if i % 2 == 0:  # Even index should match digit1\n            if s[i] != digit1:\n                return False\n        else:  # Odd index should match digit2\n            if s[i] != digit2:\n                return False\n\n    return True"}
{"task_id": "Mbpp/90", "solution": "from typing import List, Iterable, Optional\ndef len_log(words: list) -> int:\n    # Custom exception class, as defined in the design document.\n    class InvalidInputError(Exception):\n        def __init__(self, message: str):\n            super().__init__(message)\n            self.message = message\n        def __str__(self):\n            return self.message\n\n    # Utility class for string operations, without explicit type checks or raises as per prompt.\n    class StringUtils:\n        @staticmethod\n        def normalize(word: str) -> str:\n            return word.strip()\n\n        @staticmethod\n        def length(word: str) -> int:\n            return len(word)\n\n    # Repository for word normalization, without explicit type checks or raises for items.\n    class WordRepository:\n        def __init__(self, cache_path: Optional[str] = None):\n            self._cache_path = cache_path\n            self._utils = StringUtils()\n\n        def normalize(self, words_input: Iterable[str]) -> List[str]:\n            if words_input is None:\n                return []\n            normalized_list = []\n            for w in words_input:\n                normalized_list.append(self._utils.normalize(w))\n            return normalized_list\n\n    # Data model for word statistics, included as per design, but not directly critical to this function's logic flow.\n    class WordStats:\n        def __init__(self, words_list: List[str], longest_word_val: Optional[str], longest_length_val: int):\n            self.words = words_list\n            self.longest_word = longest_word_val\n            self.longest_length = longest_length_val\n\n        @staticmethod\n        def from_words(words_list: List[str]) -> 'WordStats':\n            if not words_list:\n                return WordStats(words_list, None, 0)\n            longest = max(words_list, key=lambda w: len(w))\n            return WordStats(words_list, longest, len(longest))\n\n    # Service class encapsulating the core logic, without explicit validation/raises as per prompt.\n    class LengthService:\n        def __init__(self, repo_param: WordRepository = None, utils_param: StringUtils = None):\n            self.repo = repo_param or WordRepository()\n            self.utils = utils_param or StringUtils()\n\n        def _compute_longest_length(self, words_param: Iterable[str]) -> int:\n            normalized = self.repo.normalize(words_param)\n            if not normalized:\n                return 0\n            max_len = 0\n            for w in normalized:\n                l = self.utils.length(w)\n                if l > max_len:\n                    max_len = l\n            return max_len\n\n    # Instantiate the necessary components and execute the main logic, replicating PackageAPI's role.\n    repo_instance = WordRepository()\n    utils_instance = StringUtils()\n    service_instance = LengthService(repo=repo_instance, utils=utils_instance)\n    return service_instance._compute_longest_length(words)"}
{"task_id": "Mbpp/93", "solution": "import math\ndef power(a, b):\n    \"\"\"Calculates 'a' to the power 'b', using exponentiation by squaring for integers or math.pow for floats.\"\"\"\n    # Business rule: 0^0 is 1.0\n    if a == 0 and b == 0:\n        return 1.0\n\n    # Determine if b is an integer exponent (including negative integers, or float representing an integer)\n    is_integer_exponent = False\n    b_as_int = 0\n    if isinstance(b, int):\n        is_integer_exponent = True\n        b_as_int = b\n    elif isinstance(b, float):\n        if b.is_integer():\n            is_integer_exponent = True\n            b_as_int = int(b)\n\n    if is_integer_exponent:\n        # Use exponentiation by squaring algorithm\n        base = float(a)\n        exponent = b_as_int\n\n        # For x^0, result is 1.0 (0^0 handled above)\n        if exponent == 0:\n            return 1.0\n\n        is_negative = False\n        if exponent < 0:\n            is_negative = True\n            exponent = -exponent # Work with positive exponent\n\n        result = 1.0\n        while exponent > 0:\n            if exponent % 2 == 1:\n                result *= base\n            base *= base\n            exponent //= 2\n\n        if is_negative:\n            # For 0^-N, this will result in ZeroDivisionError, which is an expected behavior for this layer\n            return 1.0 / result\n        else:\n            return result\n    else:\n        # For non-integer exponents, use math.pow as specified\n        return math.pow(a, b)"}
{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer.\n    Handles negative inputs by taking their absolute value and returns 0 for 0.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    num = abs(n)\n    total_divisors = 1\n    i = 2\n\n    # Iterate up to sqrt(num) to find prime factors and their powers.\n    while i * i <= num:\n        if num % i == 0:\n            count = 0\n            while num % i == 0:\n                num //= i\n                count += 1\n            total_divisors *= (count + 1)\n        i += 1\n\n    # If num is still greater than 1, it means the remaining num is a prime factor.\n    if num > 1:\n        total_divisors *= 2\n\n    return total_divisors"}
