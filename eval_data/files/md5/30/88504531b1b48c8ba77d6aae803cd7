{"task_id": "Mbpp/470", "solution": "def add_pairwise(tuple_input: tuple) -> tuple:\n    \"\"\"Computes pairwise sums of neighboring elements in a tuple.\n\n    Returns an empty tuple if the input has less than two elements.\n    \"\"\"\n    if len(tuple_input) < 2:\n        return ()\n\n    result = []\n    for i in range(len(tuple_input) - 1):\n        result.append(tuple_input[i] + tuple_input[i+1])\n    return tuple(result)"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(lst: list[int]) -> bool:\n    \"\"\"\n    Checks if the given list contains consecutive numbers.\n    By default ignores duplicates and order: e.g. [3,1,2] -> True, [1,2,2,3] -> True.\n    Empty list or single-element list is considered consecutive.\n    \"\"\"\n    # Validate input is iterable of ints\n    if lst is None:\n        raise TypeError(\"Input must be a list of integers, got None\")\n\n    try:\n        # Ensure elements are ints (will raise if non-int convertible)\n        nums = [int(x) for x in lst]\n    except Exception:\n        raise TypeError(\"All elements must be integers\")\n\n    if len(nums) == 0:\n        return True\n\n    unique_elements = sorted(set(nums))\n\n    if len(unique_elements) <= 1:\n        return True\n\n    # Check that each adjacent difference is exactly 1\n    for a, b in zip(unique_elements, unique_elements[1:]):\n        if b - a != 1:\n            return False\n\n    return True"}
{"task_id": "Mbpp/465", "solution": "def drop_empty(data: dict) -> dict:\n    \"\"\"\n    Drops items from a dictionary where the value is considered empty.\n    By default, None, empty strings, and empty containers are considered empty.\n    \"\"\"\n\n    def _is_empty(value: object) -> bool:\n        \"\"\"\n        Determines if a value is considered 'empty' based on default rules.\n        Includes None, empty strings, and empty collections.\n        \"\"\"\n        if value is None:\n            return True\n        if isinstance(value, str):\n            return value == \"\"\n        if isinstance(value, (list, dict, tuple, set)):\n            return len(value) == 0\n        return False\n\n    result = {}\n    for k, v in data.items():\n        if not _is_empty(v):\n            result[k] = v\n    return result"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(array, n):\n    \"\"\"\n    Calculates the product of array elements modulo n using modular multiplication.\n    This approach prevents potential overflow for large intermediate products.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Modulus n must be an integer\")\n    if n <= 0:\n        raise ValueError(\"Modulus n must be a positive integer\")\n\n    if array is None:\n        raise ValueError(\"Input array must not be None\")\n    # Treat empty array as invalid per design; raise an error.\n    if len(array) == 0:\n        raise ValueError(\"Input array must not be empty\")\n\n    product = 1 % n\n\n    for x in array:\n        # Ensure elements are integers (or convertible)\n        try:\n            xi = int(x)\n        except Exception:\n            raise TypeError(f\"Array element {x!r} is not convertible to int\")\n        if (xi % n) == 0:\n            return 0\n        product = (product * (xi % n)) % n\n\n    return product"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(arr):\n    if not arr:\n        raise ValueError(\"arr must be non-empty\")\n    cur_max = cur_min = global_max = arr[0]\n    for num in arr[1:]:\n        if num < 0:\n            cur_max, cur_min = cur_min, cur_max\n        cur_max = max(num, cur_max * num)\n        cur_min = min(num, cur_min * num)\n        global_max = max(global_max, cur_max)\n    return global_max"}
{"task_id": "Mbpp/468", "solution": "def max_product(arr: list) -> float:\n    \"\"\"\n    Return the maximum product formed by multiplying numbers of a strictly-increasing\n    contiguous subsequence (increasing subarray) of `arr`.\n\n    Raises:\n        TypeError: if arr is not a list or tuple.\n        ValueError: if arr is empty or contains non-numeric elements.\n    \"\"\"\n    if not isinstance(arr, (list, tuple)):\n        raise TypeError(\"arr must be a list or tuple of numbers\")\n    if len(arr) == 0:\n        raise ValueError(\"arr must contain at least one number\")\n\n    # Normalize and validate numeric values\n    try:\n        nums = [float(x) for x in arr]\n    except (TypeError, ValueError):\n        raise ValueError(\"all elements of arr must be numeric\")\n\n    if len(nums) == 1:\n        return nums[0]\n\n    # Split into maximal strictly-increasing contiguous runs\n    runs = []\n    current_run = [nums[0]]\n    for x in nums[1:]:\n        if x > current_run[-1]:\n            current_run.append(x)\n        else:\n            runs.append(current_run)\n            current_run = [x]\n    runs.append(current_run)\n\n    global_max = float(\"-inf\")\n\n    # For each run, compute maximum product contiguous subarray (handles negatives)\n    for run in runs:\n        if not run:\n            continue\n        local_max = run[0]\n        local_min = run[0]\n        run_best = run[0]\n        for x in run[1:]:\n            candidates = (x, local_max * x, local_min * x)\n            local_max = max(candidates)\n            local_min = min(candidates)\n            run_best = max(run_best, local_max)\n        global_max = max(global_max, run_best)\n\n    return global_max"}
{"task_id": "Mbpp/473", "solution": "def tuple_intersection(a, b):\n    \"\"\"\n    Finds the intersection of 2-element tuples from two iterables,\n    ignoring the order of elements within the tuples.\n    Returns a set of tuples, preferring the orientation from the first input iterable 'a'.\n    \"\"\"\n    def _normalize_tuple_elements(tup):\n        if not hasattr(tup, \"__iter__\"):\n            raise TypeError(\"Each item must be an iterable of length 2\")\n        tup_tuple = tuple(tup)\n        if len(tup_tuple) != 2:\n            raise ValueError(\"Each item must contain exactly 2 elements\")\n        # Use repr-based ordering to ensure deterministic ordering for non-comparable types\n        a_elem, b_elem = tup_tuple\n        try:\n            # try natural ordering first\n            return tuple(sorted(tup_tuple))\n        except TypeError:\n            # fallback: sort by repr to produce a deterministic canonical form\n            return tuple(sorted(tup_tuple, key=lambda x: repr(x)))\n\n    canonical_to_original_a = {}\n    for tup_a in a:\n        canonical_form = _normalize_tuple_elements(tup_a)\n        # Preserve the first-seen orientation from 'a'\n        if canonical_form not in canonical_to_original_a:\n            canonical_to_original_a[canonical_form] = tuple(tup_a)\n\n    result_set = set()\n    for tup_b in b:\n        canonical_form = _normalize_tuple_elements(tup_b)\n        if canonical_form in canonical_to_original_a:\n            result_set.add(canonical_to_original_a[canonical_form])\n\n    return result_set"}
{"task_id": "Mbpp/475", "solution": "def sort_counter(counter):\n    \"\"\"\n    Sort a dictionary by its values in descending order.\n\n    Returns:\n        list[tuple]: list of (key, value) tuples sorted by value descending.\n                     If values are equal, keys are compared as strings ascending\n                     to ensure deterministic ordering.\n\n    Raises:\n        TypeError: if counter is not a dict or if values are not numeric.\n    \"\"\"\n    if not isinstance(counter, dict):\n        raise TypeError(\"counter must be a dict\")\n\n    from numbers import Number\n\n    items = list(counter.items())\n\n    if not all(isinstance(v, Number) for _, v in items):\n        raise TypeError(\"all values must be numeric (int or float)\")\n\n    # Sort by value descending, then by key (as string) ascending for deterministic tie-breaks\n    return sorted(items, key=lambda kv: (-kv[1], str(kv[0])))"}
