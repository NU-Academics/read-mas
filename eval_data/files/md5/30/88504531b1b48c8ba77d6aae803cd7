{"task_id": "Mbpp/799", "solution": "def left_rotate(value, d):\n    \"\"\"\n    Rotates the bits of a 32-bit number to the left by d positions.\n    Inputs are treated as unsigned 32-bit integers.\n    \"\"\"\n    bit_width = 32\n\n    # Mask the value to ensure it's within the 32-bit range\n    value = value & ((1 << bit_width) - 1)\n\n    # Normalize the rotation distance d\n    d = d % bit_width\n\n    if d == 0:\n        return value\n\n    # Perform the left rotation\n    left_part = (value << d) & ((1 << bit_width) - 1)\n    right_part = value >> (bit_width - d)\n\n    # Combine the parts and ensure the result is 32-bit\n    return (left_part | right_part) & ((1 << bit_width) - 1)"}
{"task_id": "Mbpp/798", "solution": "def _sum(values: Sequence[Any]) -> Decimal:\n    \"\"\"Public function: computes the sum of a sequence of numeric values.\"\"\"\n    # To adhere to the strict \"output the COMPLETE function definition starting with the `def` line\"\n    # and \"Do NOT call any helper that is not defined inline in your response\",\n    # all necessary helper classes and functions are defined locally within _sum.\n    # This design choice prioritizes strict adherence to prompt constraints over\n    # modularity and efficiency as outlined in the general design document.\n\n    from typing import Sequence, Any, Optional, List, Dict\n    from decimal import Decimal\n    import os\n    import json\n    from datetime import datetime\n    import sqlite3\n\n    class ArraySumError(Exception):\n        pass\n    class InvalidInputError(ArraySumError):\n        pass\n    class PersistenceError(ArraySumError):\n        pass\n\n    class Config:\n        def __init__(self, persist: bool = True, db_path: str = \"data/arraysum.db\"):\n            self.persist = persist\n            self.db_path = db_path\n        def as_dict(self) -> dict[str, Any]:\n            return {\"persist\": self.persist, \"db_path\": self.db_path}\n\n    class ArrayModel:\n        def __init__(self, values: Sequence[Any]):\n            self.values = values\n        def to_json(self) -> str:\n            return json.dumps(list(self.values))\n\n    class Validator:\n        def __init__(self, allowed_types: tuple = None):\n            self._allowed_types = allowed_types if allowed_types is not None else (int, float, Decimal)\n        def validate_iterable(self, values: Any) -> Sequence[Any]:\n            try:\n                iter(values)\n            except TypeError:\n                raise InvalidInputError(\"Input must be iterable\")\n            if isinstance(values, (str, bytes)):\n                raise InvalidInputError(\"String/bytes are not accepted as array\")\n            return values\n        def is_numeric(self, value: Any) -> bool:\n            return not isinstance(value, bool) and isinstance(value, self._allowed_types)\n        def ensure_numeric(self, values: Sequence[Any]) -> list[Decimal]:\n            result = []\n            for i, v in enumerate(values):\n                if not self.is_numeric(v):\n                    raise InvalidInputError(f\"Non-numeric value at index {i}: {v!r}\")\n                result.append(Decimal(str(v)))\n            return result\n\n    CREATE_TABLE_SQL = \"\"\"\n    CREATE TABLE IF NOT EXISTS sums (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      input TEXT NOT NULL,\n      result REAL NOT NULL,\n      created_at TEXT NOT NULL\n    );\n    \"\"\"\n    INSERT_SQL = \"INSERT INTO sums (input, result, created_at) VALUES (?, ?, ?)\"\n    # SELECT_SQL is not strictly needed for _sum, but included for completeness of repository definition\n    SELECT_SQL = \"SELECT id, input, result, created_at FROM sums ORDER BY created_at DESC LIMIT ?\"\n\n    class SumRepository:\n        def __init__(self, db_path: str):\n            self.db_path = db_path\n            db_dir = os.path.dirname(db_path)\n            if db_dir and not os.path.exists(db_dir):\n                os.makedirs(db_dir)\n            self.conn = sqlite3.connect(self.db_path, check_same_thread=False)\n            self.init_schema()\n        def init_schema(self) -> None:\n            c = self.conn.cursor()\n            c.execute(CREATE_TABLE_SQL)\n            self.conn.commit()\n        def persist(self, input_json: str, result: Decimal, created_at: str) -> int:\n            try:\n                c = self.conn.cursor()\n                c.execute(INSERT_SQL, (input_json, float(result), created_at))\n                self.conn.commit()\n                return c.lastrowid\n            except sqlite3.Error as e:\n                raise PersistenceError(f\"Failed to persist sum: {e}\")\n        def query_recent(self, limit: int = 10) -> List[Dict[str, Any]]:\n            try:\n                c = self.conn.cursor()\n                c.execute(SELECT_SQL, (limit,))\n                rows = c.fetchall()\n                columns = [description[0] for description in c.description]\n                return [dict(zip(columns, row)) for row in rows]\n            except sqlite3.Error as e:\n                raise PersistenceError(f\"Failed to query recent sums: {e}\")\n\n    class SumService:\n        def __init__(self, validator: Validator, repo: Optional[SumRepository], config: Config):\n            self.validator = validator\n            self.repo = repo\n            self.config = config\n        def compute_sum(self, values: Sequence[Any]) -> Decimal:\n            seq = self.validator.validate_iterable(values)\n            nums = self.validator.ensure_numeric(seq)\n            total = Decimal('0')\n            for n in nums:\n                total += n\n            if self.config.persist and self.repo:\n                try:\n                    array_model = ArrayModel(values)\n                    self.repo.persist(input_json=array_model.to_json(), result=total, created_at=datetime.utcnow().isoformat())\n                except Exception as e:\n                    raise PersistenceError(str(e))\n            return total\n\n    # Instantiate the dependencies for each call to _sum to ensure self-containment\n    _config_instance = Config()\n    _validator_instance = Validator()\n    _repo_instance = SumRepository(_config_instance.db_path)\n    _service_instance = SumService(_validator_instance, _repo_instance, _config_instance)\n\n    return _service_instance.compute_sum(values)"}
{"task_id": "Mbpp/803", "solution": "import math\ndef is_perfect_square(n: int) -> bool:\n    \"\"\"Checks if a given integer is a perfect square using integer square root.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(f\"Expected int, got {type(n).__name__}\")\n    if n < 0:\n        return False\n    s = math.isqrt(n)\n    return s * s == n"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers):\n    \"\"\"Checks if the product of numbers in a list is even using short-circuit logic.\"\"\"\n    for n in numbers:\n        if n == 0:\n            return True  # Product is 0, which is even\n        if n % 2 == 0:\n            return True  # An even number makes the product even\n    return False  # All numbers are odd, so their product is odd"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(text):\n    \"\"\"\n    Finds the maximum consecutive run of uppercase characters in the given string.\n    \"\"\"\n    max_len = 0\n    current_len = 0\n    for char in text:\n        if char.isupper():\n            current_len += 1\n        else:\n            current_len = 0\n        if current_len > max_len:\n            max_len = current_len\n    return max_len"}
{"task_id": "Mbpp/805", "solution": "from typing import List, Optional, Union\nNumber = Union[int, float]\ndef max_sum_list(lists: List[List[Number]]) -> List[Number]:\n    \"\"\"\n    Returns the sublist from a list of lists whose sum of elements is the highest.\n    If multiple lists share the maximum sum, the first such sublist is returned.\n    \"\"\"\n    best_sum: Optional[float] = None\n    best_list: List[Number] = []\n\n    for current_list in lists:\n        current_sum = sum(current_list)\n        if best_sum is None or current_sum > best_sum:\n            best_sum = current_sum\n            best_list = current_list\n\n    return best_list"}
