{"task_id": "Mbpp/721", "solution": "def maxAverageOfPath(matrix):\n    \"\"\"\n    Computes the maximum average path from the top-left to the bottom-right cell\n    of a square matrix, moving only right or down.\n    \"\"\"\n    n = len(matrix)\n\n    # prev_row_max_sums stores the maximum path sums to each cell in the previous row.\n    # It's initialized with -infinity to correctly handle boundary conditions where a cell\n    # has no 'up' path (i.e., for the first row).\n    prev_row_max_sums = [float('-inf')] * n\n\n    for i in range(n):\n        curr_row_max_sums = [float('-inf')] * n\n        for j in range(n):\n            current_cost = matrix[i][j]\n\n            if i == 0 and j == 0:\n                # Base case: The sum to the starting cell (0,0) is just its own cost.\n                curr_row_max_sums[j] = current_cost\n            else:\n                # Determine the maximum sum from an allowed preceding cell.\n                # A path can come from the cell directly above (i-1, j) or directly left (i, j-1).\n\n                # 'from_up' is the max sum from the cell (i-1, j). If i=0, there's no cell above, so it's -infinity.\n                from_up = prev_row_max_sums[j] if i > 0 else float('-inf')\n\n                # 'from_left' is the max sum from the cell (i, j-1). If j=0, there's no cell left, so it's -infinity.\n                from_left = curr_row_max_sums[j-1] if j > 0 else float('-inf')\n\n                # The maximum sum to reach (i, j) is its own cost plus the maximum of the sums from 'up' or 'left'.\n                curr_row_max_sums[j] = current_cost + max(from_up, from_left)\n\n        # After computing all max sums for the current row, it becomes the 'previous' row for the next iteration.\n        prev_row_max_sums = curr_row_max_sums\n\n    # The final maximum total sum to reach the bottom-right cell (n-1, n-1)\n    # is stored in the last element of the last computed 'prev_row_max_sums'.\n    max_total_sum = prev_row_max_sums[n-1]\n\n    # For an N*N matrix, any valid path from (0,0) to (N-1, N-1) moving only right or down\n    # will always have a fixed length of 2*N - 1 cells.\n    path_length = 2 * n - 1\n\n    # The maximum average is the maximum total sum divided by the path length.\n    # N is guaranteed to be >= 1, so path_length will always be >= 1.\n    max_average = max_total_sum / path_length\n\n    return max_average"}
{"task_id": "Mbpp/722", "solution": "def filter_data(data: dict, min_height: float, min_weight: float) -> dict:\n    \"\"\"\n    Filters students from the input dictionary who meet or exceed the given\n    minimum height and weight thresholds.\n    \"\"\"\n    filtered_students = {}\n    for student_name, student_info in data.items():\n        student_height, student_weight = student_info\n        if student_height >= min_height and student_weight >= min_weight:\n            filtered_students[student_name] = student_info\n    return filtered_students"}
{"task_id": "Mbpp/723", "solution": "def count_same_pair(list_a, list_b):\n    \"\"\"\n    Counts the number of indices where values in two lists are identical.\n    It assumes the input lists are of the same length.\n    \"\"\"\n    count = 0\n    for i in range(len(list_a)):\n        if list_a[i] == list_b[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    This function uses an in-memory cache for intermediate results.\n    \"\"\"\n    from .models.power_request import PowerRequest\n    from .repositories.in_memory_cache import InMemoryCacheRepository\n    # The design context snippet imports FileCacheRepository but doesn't use it.\n    # from .repositories.file_cache import FileCacheRepository\n    from .utils.digit_utils import DigitUtils\n    from .services.power_calculator import PowerCalculator\n\n    repo = InMemoryCacheRepository()\n    utils = DigitUtils()\n    calc = PowerCalculator(repo, utils)\n    request = PowerRequest(base, power)\n    result = calc.calculate(request)\n    return result.digit_sum"}
{"task_id": "Mbpp/726", "solution": "def multiply_elements(input_tuple: tuple[float, ...]) -> tuple[float, ...]:\n    \"\"\"\n    Computes the pairwise product of adjacent elements in a tuple of numbers.\n    The i-th element of the returned tuple is t_i * t_{i+1}.\n    \"\"\"\n    return tuple(float(input_tuple[i] * input_tuple[i+1]) for i in range(len(input_tuple) - 1))"}
{"task_id": "Mbpp/725", "solution": "from typing import List, Optional, Dict\nimport re\nclass ExtractionError(Exception):\n    \"\"\"Custom exception for extraction-related errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass ExtractorStrategy:\n    \"\"\"Abstract base class defining the contract for text extraction strategies.\"\"\"\n    def extract(self, text: str) -> List[str]:\n        \"\"\"Extracts quoted substrings from the given text.\"\"\"\n        raise NotImplementedError\nDEFAULT_PATTERN = r'\\\"([^\\\"\\\\]*(?:\\\\.[^\\\"\\\\]*)*)\\\"'\nclass RegexExtractorStrategy(ExtractorStrategy):\n    \"\"\"An extraction strategy that uses regular expressions.\"\"\"\n    def __init__(self, pattern: Optional[str] = None) -> None:\n        self._pattern = pattern or DEFAULT_PATTERN\n        self._compiled = re.compile(self._pattern)\n\n    def extract(self, text: str) -> List[str]:\n        \"\"\"Extracts all matching groups based on the regex pattern.\"\"\"\n        try:\n            return [m for m in self._compiled.findall(text)]\n        except re.error as e:\n            raise ExtractionError(f\"Regex error during extraction: {e}\")\nclass CharScanExtractorStrategy(ExtractorStrategy):\n    \"\"\"An extraction strategy that scans characters to handle escaped quotes.\"\"\"\n    def __init__(self, escape_char: str = \"\\\\\") -> None:\n        self._escape = escape_char\n\n    def extract(self, text: str) -> List[str]:\n        \"\"\"Iterates through text to find quotes, respecting escape characters.\"\"\"\n        results: List[str] = []\n        buf: list[str] = []\n        in_quote = False\n        esc = False\n        for ch in text:\n            if in_quote:\n                if esc:\n                    buf.append(ch)\n                    esc = False\n                elif ch == self._escape:\n                    esc = True\n                elif ch == '\"':\n                    results.append(''.join(buf))\n                    buf = []\n                    in_quote = False\n                else:\n                    buf.append(ch)\n            else:\n                if ch == '\"':\n                    in_quote = True\n        return results\nclass ExtractorService:\n    \"\"\"Orchestrates different extraction strategies and optionally persists results.\"\"\"\n    def __init__(self, default_strategy: str = \"regex\", repository: Optional[object] = None) -> None:\n        self._default_strategy = default_strategy\n        self._repository = repository\n        self._strategies: Dict[str, ExtractorStrategy] = {}\n        self.register_strategy(\"regex\", RegexExtractorStrategy())\n        self.register_strategy(\"charscan\", CharScanExtractorStrategy())\n\n    def register_strategy(self, name: str, strategy: ExtractorStrategy) -> None:\n        \"\"\"Registers a new extraction strategy under a given name.\"\"\"\n        self._strategies[name] = strategy\n\n    def extract(self, text: str, strategy: Optional[str] = None) -> List[str]:\n        \"\"\"Performs extraction using the specified or default strategy.\"\"\"\n        key = strategy or self._default_strategy\n        if key not in self._strategies:\n            raise ValueError(f\"Unknown strategy: {key}\")\n        extractor = self._strategies[key]\n        result = extractor.extract(text)\n        return result\ndef extract_quotation(text):\n    \"\"\"Extracts values enclosed in double quotation marks from a given string.\n\n    This function uses an internal ExtractorService with a default regex strategy.\"\"\"\n    service = ExtractorService()\n    return service.extract(text)"}
{"task_id": "Mbpp/731", "solution": "import math\ndef lateralsurface_cone(r, h):\n    \"\"\"\n    Calculates the lateral surface area of a cone.\n    The lateral surface area is given by the formula: \u03c0 * r * s, where s = sqrt(r^2 + h^2).\n    \"\"\"\n    slant_height = math.sqrt(r ** 2 + h ** 2)\n    lateral_surface_area = math.pi * r * slant_height\n    return lateral_surface_area"}
