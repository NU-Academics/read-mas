{"task_id": "Mbpp/62", "solution": "from typing import List, Union\ndef smallest_num(values: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Finds the smallest number in a list of numbers.\n\n    Args:\n        values: A non-empty list of ints or floats.\n\n    Returns:\n        The smallest value from the list.\n\n    Raises:\n        ValueError: If the input list is empty.\n        TypeError: If any element is not int or float.\n    \"\"\"\n    if not values:\n        raise ValueError(\"Input list must not be empty\")\n\n    min_val = values[0]\n    if not isinstance(min_val, (int, float)):\n        raise TypeError(f\"List elements must be int or float, got {type(min_val).__name__}\")\n\n    for v in values[1:]:\n        if not isinstance(v, (int, float)):\n            raise TypeError(f\"List elements must be int or float, got {type(v).__name__}\")\n        if v < min_val:\n            min_val = v\n    return min_val"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(lst):\n    \"\"\"\n    Flattens a list/tuple structure and sums all numeric (int, float) elements found.\n    Non-numeric or non-iterable elements are implicitly ignored.\n\n    Example:\n        assert recursive_list_sum(([1, 2, [3,4],[5,6]])) == 21\n    \"\"\"\n    total_sum = 0\n    # Handle non-list/tuple inputs gracefully\n    if not isinstance(lst, (list, tuple)):\n        if isinstance(lst, (int, float)):\n            return lst\n        return 0\n\n    for item in lst:\n        if isinstance(item, (int, float)):\n            total_sum += item\n        elif isinstance(item, (list, tuple)):\n            total_sum += recursive_list_sum(item)\n        # ignore other types\n    return total_sum"}
{"task_id": "Mbpp/66", "solution": "def pos_count(input_list):\n    \"\"\"\n    Counts the number of positive numbers in a list.\n\n    Args:\n        input_list: An iterable of numbers (ints or floats).\n\n    Returns:\n        int: Number of elements strictly greater than 0.\n    \"\"\"\n    if not hasattr(input_list, '__iter__'):\n        raise TypeError(\"input_list must be an iterable\")\n\n    count = 0\n    for number in input_list:\n        # Reject boolean values which are subclasses of int\n        if isinstance(number, bool):\n            raise TypeError(\"boolean values are not accepted as numeric inputs\")\n        try:\n            if number > 0:\n                count += 1\n        except TypeError:\n            raise TypeError(\"all elements must be numeric (int or float)\")\n    return count"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Compute the nth Bell number (the number of partitions of a set of size n).\n    Uses the Bell triangle (Dobinski's triangle) dynamic programming method.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    row = [1]  # Bell(0) row\n    for _ in range(1, n + 1):\n        next_row = [row[-1]]\n        for j in range(len(row)):\n            next_row.append(next_row[-1] + row[j])\n        row = next_row\n    return row[0]"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(haystack, needle):\n    n = len(haystack)\n    m = len(needle)\n    if m == 0:\n        return True\n    if m > n:\n        return False\n    for i in range(n - m + 1):\n        for j in range(m):\n            if haystack[i + j] != needle[j]:\n                break\n        else:\n            return True\n    return False"}
{"task_id": "Mbpp/68", "solution": "from typing import Sequence\ndef is_Monotonic(array: Sequence[float|int]) -> bool:\n    \"\"\"\n    Checks if the given array is monotonic (non-increasing or non-decreasing).\n    Raises InvalidArrayError for invalid inputs like None, empty arrays, or non-numeric elements.\n    \"\"\"\n    class InvalidArrayError(Exception):\n        \"\"\"Custom exception raised for invalid array inputs.\"\"\"\n        def __init__(self, message: str) -> None:\n            self.message = message\n            super().__init__(message)\n        def __str__(self) -> str:\n            return self.message\n\n    if array is None:\n        raise InvalidArrayError(\"Input is None\")\n    if not isinstance(array, (list, tuple)):\n        raise InvalidArrayError(\"Input must be list or tuple\")\n    if len(array) == 0:\n        raise InvalidArrayError(\"Input must contain at least one element\")\n\n    def _is_numeric(item: object) -> bool:\n        \"\"\"Determines if an item is a numeric type (int or float), excluding booleans.\"\"\"\n        return isinstance(item, (int, float)) and not isinstance(item, bool)\n\n    for i, item in enumerate(array):\n        if not _is_numeric(item):\n            raise InvalidArrayError(f\"Element at index {i} is not numeric: {item!r}\")\n\n    if len(array) == 1:\n        return True\n\n    inc = False\n    dec = False\n    for a, b in zip(array, array[1:]):\n        if b > a:\n            inc = True\n        elif b < a:\n            dec = True\n        if inc and dec:\n            return False\n\n    return True"}
{"task_id": "Mbpp/70", "solution": "from typing import Iterable, Tuple, Any, Optional\ndef get_equal(tuples: Iterable[Tuple[Any, ...]]) -> bool:\n    \"\"\"\n    Checks if all given tuples have equal length.\n    Returns True for an empty iterable of tuples.\n    \"\"\"\n    first_len: Optional[int] = None\n\n    for t in tuples:\n        current_len = len(t)\n        if first_len is None:\n            first_len = current_len\n        elif current_len != first_len:\n            return False\n\n    return True"}
{"task_id": "Mbpp/71", "solution": "from typing import Sequence, List, TypeVar, Any\nT = TypeVar(\"T\")\nclass SortError(Exception):\n    \"\"\"Custom exception for sorting-related errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\n    def __str__(self) -> str:\n        return self.message\nclass InputValidator:\n    \"\"\"Provides static methods for validating input sequences.\"\"\"\n    @staticmethod\n    def validate_sequence(data: Any) -> Sequence[Any]:\n        if not isinstance(data, (list, tuple)):\n            raise SortError(\"Input must be a list or tuple\")\n        return data\n\n    @staticmethod\n    def are_elements_comparable(seq: Sequence[Any]) -> bool:\n        if len(seq) < 2:\n            return True\n        for i in range(len(seq) - 1):\n            try:\n                _ = seq[i] <= seq[i+1]\n            except Exception:\n                return False\n        return True\nDEFAULT_SHRINK = 1.3\nclass CombSorter:\n    \"\"\"Implements the Comb Sort algorithm.\"\"\"\n    def __init__(self, shrink_factor: float = DEFAULT_SHRINK) -> None:\n        if shrink_factor <= 1.0:\n            raise ValueError(\"shrink_factor must be > 1.0\")\n        self.shrink_factor = shrink_factor\n        self.gap = 0\n\n    def _next_gap(self, current_gap: int) -> int:\n        next_gap = int(current_gap / self.shrink_factor)\n        return next_gap if next_gap >= 1 else 1\n\n    def sort(self, data: Sequence[T]) -> List[T]:\n        \"\"\"Sorts a sequence using Comb Sort and returns a new sorted list.\"\"\"\n        arr = list(data)\n        n = len(arr)\n        self.gap = n\n        swapped = True\n        try:\n            while self.gap != 1 or swapped:\n                self.gap = self._next_gap(self.gap)\n                swapped = False\n                i = 0\n                while i + self.gap < n:\n                    if arr[i] > arr[i + self.gap]:\n                        arr[i], arr[i + self.gap] = arr[i + self.gap], arr[i]\n                        swapped = True\n                    i += 1\n            return arr\n        except TypeError as e:\n            raise SortError(\"Elements are not mutually comparable\") from e\nclass SortService:\n    \"\"\"Provides higher-level API to sort sequences using an injected sorter.\"\"\"\n    def __init__(self, sorter: CombSorter) -> None:\n        self._sorter = sorter\n\n    def sort_list(self, data: Sequence[T]) -> List[T]:\n        \"\"\"Validates and sorts a list using the injected sorter.\"\"\"\n        seq: Sequence[Any] = InputValidator.validate_sequence(data)\n        if not InputValidator.are_elements_comparable(seq):\n            raise SortError(\"Elements are not comparable\")\n        try:\n            return self._sorter.sort(seq)\n        except SortError:\n            raise\n        except Exception as e:\n            raise SortError(f\"Unexpected error during sorting: {e}\") from e\n_default_service = SortService(CombSorter())\ndef comb_sort(data: Sequence[T]) -> List[T]:\n    \"\"\"Sorts a list of comparable elements using the Comb Sort algorithm.\"\"\"\n    return _default_service.sort_list(data)"}
