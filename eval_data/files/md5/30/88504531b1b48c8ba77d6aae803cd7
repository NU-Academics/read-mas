{"task_id": "Mbpp/392", "solution": "def get_max_sum(n: int) -> int:\n    \"\"\"\n    Computes the maximum sum using the recurrence:\n    f(n) = max(f(n//2) + f(n//3) + f(n//4) + f(n//5), n)\n\n    Uses memoization to avoid repeated work.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    _memo = {}\n\n    def _compute(x: int) -> int:\n        if x == 0:\n            return 0\n        if x in _memo:\n            return _memo[x]\n        total = _compute(x // 2) + _compute(x // 3) + _compute(x // 4) + _compute(x // 5)\n        res = total if total > x else x\n        _memo[x] = res\n        return res\n\n    return _compute(n)"}
{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(*lists):\n    \"\"\"\n    Converts multiple parallel lists into a list of nested dictionaries.\n    The first list provides top-level keys, subsequent lists provide nested key-value pairs.\n\n    Example:\n        convert_list_dictionary(\n            [\"S001\", \"S002\"],\n            [\"Adina Park\", \"Leyton Marsh\"],\n            [85, 98]\n        )\n        -> [{'S001': {'Adina Park': 85}}, {'S002': {'Leyton Marsh': 98}}]\n    \"\"\"\n    if len(lists) < 2:\n        raise ValueError(\"At least two lists are required\")\n\n    # Validate all inputs are indexable and have the same length\n    try:\n        lengths = [len(lst) for lst in lists]\n    except TypeError:\n        raise TypeError(\"All arguments must be indexable (support len and __getitem__)\")\n\n    if any(l != lengths[0] for l in lengths):\n        raise ValueError(\"All lists must have the same length\")\n\n    def _create_nested_mapping(values):\n        \"\"\"Recursively creates nested dictionaries from a list of values.\"\"\"\n        if len(values) == 1:\n            return values[0]\n        return {values[0]: _create_nested_mapping(values[1:])}\n\n    n = lengths[0]\n    result = []\n    for i in range(n):\n        top_key = lists[0][i]\n        nested_values_for_row = [lst[i] for lst in lists[1:]]\n        nested_dict = _create_nested_mapping(nested_values_for_row)\n        result.append({top_key: nested_dict})\n\n    return result"}
{"task_id": "Mbpp/395", "solution": "from collections import Counter\nfrom typing import Optional\ndef first_non_repeating_character(s: str) -> Optional[str]:\n    \"\"\"\n    Finds the first character in a string that appears only once.\n    Returns None if no such character exists.\n    \"\"\"\n    counts = Counter(s)\n    for ch in s:\n        if counts[ch] == 1:\n            return ch\n    return None"}
{"task_id": "Mbpp/394", "solution": "def check_distinct(items):\n    \"\"\"\n    Return True if the given tuple (or iterable) contains no duplicate elements, False otherwise.\n    Example: assert check_distinct((1, 4, 5, 6, 1, 4)) == False\n    \"\"\"\n    # Coerce to tuple for consistent indexing if not already a tuple\n    try:\n        if not isinstance(items, tuple):\n            items = tuple(items)\n    except TypeError:\n        # Not iterable\n        raise TypeError(\"items must be an iterable (e.g., a tuple)\")\n\n    n = len(items)\n    if n <= 1:\n        return True\n\n    # Fast path: try using a set for O(n) average time\n    try:\n        seen = set()\n        for x in items:\n            if x in seen:\n                return False\n            seen.add(x)\n        return True\n    except TypeError:\n        # Unhashable elements encountered; fall back to O(n^2) nested scan\n        for i in range(n):\n            for j in range(i + 1, n):\n                if items[i] == items[j]:\n                    return False\n        return True"}
