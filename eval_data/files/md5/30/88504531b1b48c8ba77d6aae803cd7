{"task_id": "Mbpp/742", "solution": "import math\nfrom typing import Final\nclass Validator:\n    \"\"\"Provides validation utilities.\"\"\"\n    def validate_edge_length(self, value: float) -> None:\n        \"\"\"This method performs no validation per problem constraints.\"\"\"\n        pass\nSQRT_3: Final[float] = math.sqrt(3)\nclass RegularTetrahedron:\n    \"\"\"Represents a regular tetrahedron and calculates its surface area.\"\"\"\n    def __init__(self, edge_length: float) -> None:\n        self._edge_length: float = edge_length\n\n    def surface_area(self) -> float:\n        \"\"\"Calculates the surface area of the regular tetrahedron.\"\"\"\n        return SQRT_3 * (self._edge_length ** 2)\nclass TetraFactory:\n    \"\"\"Factory for creating RegularTetrahedron instances.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def create_regular(self, edge_length: float) -> RegularTetrahedron:\n        \"\"\"Creates a RegularTetrahedron instance.\"\"\"\n        return RegularTetrahedron(edge_length)\nclass TetrahedronService:\n    \"\"\"Provides business logic for tetrahedron computations.\"\"\"\n    def __init__(self, factory: TetraFactory, validator: Validator) -> None:\n        self._factory = factory\n        self._validator = validator\n\n    def compute_surface_area(self, edge_length: float) -> float:\n        \"\"\"Computes the surface area of a tetrahedron after (no-op) validation.\"\"\"\n        self._validator.validate_edge_length(edge_length)\n        tetra = self._factory.create_regular(float(edge_length))\n        return tetra.surface_area()\nclass TetraController:\n    \"\"\"Provides a public facade for tetrahedron calculations.\"\"\"\n    def __init__(self, service: TetrahedronService) -> None:\n        self._service = service\n\n    def area_tetrahedron(self, edge_length: float) -> float:\n        \"\"\"Public facade to compute tetrahedron surface area.\"\"\"\n        return self._service.compute_surface_area(edge_length)\n_factory = TetraFactory()\n_validator = Validator()\n_service = TetrahedronService(_factory, _validator)\n_controller = TetraController(_service)\ndef area_tetrahedron(edge_length: float) -> float:\n    \"\"\"Calculates the surface area of a regular tetrahedron given its edge length.\"\"\"\n    return _controller.area_tetrahedron(edge_length)"}
{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(start: int, end: int, allow_zero: bool = False, persist: bool = False) -> list:\n    \"\"\"\n    Finds numbers in a given range [start, end] where every number is divisible by every non-zero digit it contains.\n    Optionally allows numbers containing digit zero and persists results.\n    \"\"\"\n    from datetime import datetime\n    import json\n    import os\n    from typing import List, Dict, Any, Optional\n\n    class InvalidRangeError(ValueError):\n        pass\n\n    class DigitZeroError(ValueError):\n        pass\n\n    class RepositoryError(Exception):\n        pass\n\n    def digits_of_util(n: int) -> list:\n        \"\"\"Returns a list of digits for the absolute value of n.\"\"\"\n        return [int(c) for c in str(abs(n))]\n\n    def safe_divides_util(n: int, d: int) -> bool:\n        \"\"\"Checks if n is divisible by d, ensuring d is not zero.\"\"\"\n        return (d != 0) and (n % d == 0)\n\n    class Validator:\n        def __init__(self, allow_zero: bool = False) -> None:\n            self.allow_zero = allow_zero\n\n        def digits_of(self, n: int) -> List[int]:\n            return digits_of_util(n)\n\n        def is_valid(self, n: int) -> bool:\n            \"\"\"Checks if a number is valid based on its digits and the zero-digit policy.\"\"\"\n            digits = self.digits_of(n)\n            for d in digits:\n                if d == 0:\n                    if not self.allow_zero:\n                        raise DigitZeroError(\"zero digit encountered\")\n                    else:\n                        continue\n                if not safe_divides_util(n, d):\n                    return False\n            return True\n\n    class InMemoryRepository:\n        def __init__(self) -> None:\n            self._store: List[Dict[str, Any]] = []\n\n        def save(self, record: Dict[str, Any]) -> None:\n            \"\"\"Saves a record to the in-memory store.\"\"\"\n            self._store.append(record)\n\n        def get_all(self) -> List[Dict[str, Any]]:\n            return list(self._store)\n\n    class JsonFileRepository:\n        DEFAULT_FILEPATH = \"divisible_digits_history.json\"\n\n        def __init__(self, filepath: str = DEFAULT_FILEPATH) -> None:\n            self.filepath = filepath\n\n        def _load_file(self) -> List[Dict[str, Any]]:\n            \"\"\"Loads existing records from the JSON file.\"\"\"\n            if not os.path.exists(self.filepath):\n                return []\n            try:\n                with open(self.filepath, 'r') as f:\n                    return json.load(f)\n            except json.JSONDecodeError:\n                return []\n\n        def save(self, record: Dict[str, Any]) -> None:\n            \"\"\"Appends a record to the JSON file.\"\"\"\n            records = self._load_file()\n            records.append(record)\n            try:\n                with open(self.filepath, 'w') as f:\n                    json.dump(records, f, indent=2)\n            except IOError as e:\n                raise RepositoryError(f\"Failed to write to repository file: {e}\")\n\n    class DivisibilityService:\n        def __init__(self, validator: Validator, repository: Optional[Any] = None) -> None:\n            self.validator = validator\n            self.repository = repository\n\n        def find_valid_numbers(self, start: int, end: int) -> List[int]:\n            \"\"\"\n            Finds all numbers in the range [start, end] that are divisible by their digits.\n            Raises InvalidRangeError if start > end.\n            \"\"\"\n            if start > end:\n                raise InvalidRangeError(\"start must be <= end\")\n\n            results = []\n            for n in range(start, end + 1):\n                try:\n                    if self.validator.is_valid(n):\n                        results.append(n)\n                except DigitZeroError:\n                    # If validator raises DigitZeroError and policy is strict, treat as not valid\n                    continue\n                except Exception:\n                    # Catch other unexpected exceptions during validation and treat as not valid\n                    continue\n\n            if self.repository:\n                try:\n                    self.repository.save({\n                        \"start\": start,\n                        \"end\": end,\n                        \"results\": results,\n                        \"timestamp\": datetime.utcnow().isoformat() + \"Z\"\n                    })\n                except Exception as exc:\n                    raise RepositoryError(f\"Failed to save to repository: {exc}\")\n\n            return results\n\n    validator = Validator(allow_zero=allow_zero)\n    repo: Optional[Any] = None\n    if persist:\n        repo = JsonFileRepository() # Default to JsonFileRepository for persistence\n    service = DivisibilityService(validator, repository=repo)\n    return service.find_valid_numbers(start, end)"}
