{"task_id": "Mbpp/563", "solution": "import collections\nfrom typing import List, Tuple, Iterator\ndef extract_values(text: str) -> List[str]:\n    \"\"\"\n    Extracts values between quotation marks from a string.\n    Handles single and double quotes, and backslash escapes for quotes and backslashes.\n    \"\"\"\n\n    def _unescape_string(s: str, quote_char: str) -> str:\n        \"\"\"Unescapes backslash-escaped characters within a raw token.\"\"\"\n        out = []\n        i = 0\n        while i < len(s):\n            ch = s[i]\n            if ch == \"\\\\\" and i + 1 < len(s):\n                nxt = s[i+1]\n                if nxt == quote_char or nxt == \"\\\\\":\n                    out.append(nxt)\n                    i += 2\n                    continue\n            out.append(ch)\n            i += 1\n        return \"\".join(out)\n\n    def _scan_quoted_tokens(input_text: str) -> Iterator[Tuple[str, int, int]]:\n        \"\"\"\n        Scans the input text for quoted tokens and yields their raw content\n        along with the start and end indices of the enclosing quotes.\n        \"\"\"\n        i = 0\n        n = len(input_text)\n        SUPPORTED_QUOTES = ('\"', \"'\")\n\n        while i < n:\n            char = input_text[i]\n            if char in SUPPORTED_QUOTES:\n                quote_char = char\n                start_quote_idx = i\n                i += 1 # Move past the opening quote\n\n                token_content_start = i\n\n                escaped = False\n                found_closing_quote = False\n                while i < n:\n                    current_char = input_text[i]\n                    if escaped:\n                        # Character was escaped, treat it as part of the token content\n                        escaped = False\n                    elif current_char == '\\\\':\n                        # This backslash might escape the next character\n                        escaped = True\n                    elif current_char == quote_char:\n                        # Found the non-escaped matching closing quote\n                        found_closing_quote = True\n                        break\n\n                    i += 1\n\n                if found_closing_quote:\n                    token_content_end = i\n                    raw_token = input_text[token_content_start:token_content_end]\n                    yield (raw_token, start_quote_idx, i) # i is the index of the closing quote\n                    i += 1 # Move past the closing quote\n                else:\n                    # Unmatched opening quote, continue scanning from after the initial opening quote.\n                    # The 'i' pointer already advanced during the inner loop for content scanning.\n                    # If a closing quote was not found, 'i' is 'n'. The outer loop will terminate.\n                    pass\n            else:\n                i += 1\n\n    extracted_values = []\n    for raw_token_content, start_quote_idx, end_quote_idx in _scan_quoted_tokens(text):\n        quote_char = text[start_quote_idx] # The character at start_quote_idx is the opening quote\n        unescaped_value = _unescape_string(raw_token_content, quote_char)\n        extracted_values.append(unescaped_value)\n\n    return extracted_values"}
{"task_id": "Mbpp/566", "solution": "def sum_digits(n: int) -> int:\n    \"\"\"\n    Compute sum of decimal digits for a non-negative integer n.\n    Assumes n is a non-negative integer based on design context.\n    \"\"\"\n    total = 0\n    # Handle the special case for n = 0\n    if n == 0:\n        return 0\n    while n > 0:\n        total += n % 10\n        n //= 10\n    return total"}
{"task_id": "Mbpp/567", "solution": "def issort_list(seq, strict: bool=False) -> bool:\n    \"\"\"\n    Checks if the specified list is sorted.\n    The default check is non-decreasing. If strict is True, checks for strictly increasing.\n    \"\"\"\n\n    def _pairwise(iterable):\n        \"\"\"Yields adjacent pairs (a, b) from an iterable.\"\"\"\n        it = iter(iterable)\n        try:\n            prev_item = next(it)\n        except StopIteration:\n            return\n        for current_item in it:\n            yield prev_item, current_item\n            prev_item = current_item\n\n    for a, b in _pairwise(seq):\n        if strict:\n            if not (a < b):\n                return False\n        else:\n            if not (a <= b):\n                return False\n    return True"}
{"task_id": "Mbpp/572", "solution": "def two_unique_nums(*lists: Iterable[int]) -> List[int]:\n    \"\"\"\n    Returns numbers that appear exactly once across all input lists, preserving first-occurrence order.\n    \"\"\"\n    flattened_numbers = []\n    for lst in lists:\n        flattened_numbers.extend(lst)\n\n    # Count occurrences of each number\n    counts = {}\n    for num in flattened_numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    # Collect numbers that appear exactly once, preserving first-occurrence order\n    unique_once_numbers = []\n    for num in flattened_numbers:\n        if counts[num] == 1:\n            unique_once_numbers.append(num)\n\n    return unique_once_numbers"}
{"task_id": "Mbpp/568", "solution": "def empty_list(n: int) -> list[dict]:\n    # Creates a list of N distinct empty dictionaries.\n    # Validate input\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be >= 0\")\n    return [dict() for _ in range(n)]"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(list_a, list_b):\n    \"\"\"\n    Checks if list_b is a contiguous sublist of list_a.\n    Returns True if list_b is found contiguously in list_a, False otherwise.\n    \"\"\"\n    if list_b is None or list_a is None:\n        raise ValueError(\"Both list_a and list_b must be provided (not None).\")\n\n    # Normalize to lists (accept tuples or other sequences)\n    try:\n        list_a = list(list_a)\n        list_b = list(list_b)\n    except TypeError:\n        raise ValueError(\"Both list_a and list_b must be iterable.\")\n\n    if not list_b:\n        return True\n\n    if len(list_b) > len(list_a):\n        return False\n\n    n = len(list_a)\n    m = len(list_b)\n\n    for i in range(n - m + 1):\n        if list_a[i: i + m] == list_b:\n            return True\n\n    return False"}
{"task_id": "Mbpp/569", "solution": "import abc\nimport copy\nimport logging\n_logger = logging.getLogger(__name__)\nclass SortError(Exception):\n    \"\"\"Base exception for sorting operations.\"\"\"\n    pass\nclass ValidationError(SortError):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    pass\ndef dedupe_list(lst: list[str]) -> list[str]:\n    \"\"\"Removes duplicate strings from a list, preserving order of first appearance.\"\"\"\n    seen = set()\n    deduped = []\n    for item in lst:\n        if item not in seen:\n            deduped.append(item)\n            seen.add(item)\n    return deduped\nclass SortRequest:\n    \"\"\"Data Transfer Object for sort requests.\"\"\"\n    def __init__(self, lists: list[list[str]], strategy: str = 'default',\n                 reverse: bool = False, dedupe: bool = False, in_place: bool = False) -> None:\n        self.lists = lists\n        self.strategy = strategy\n        self.reverse = reverse\n        self.dedupe = dedupe\n        self.in_place = in_place\nclass SortResult:\n    \"\"\"Data Transfer Object for sort results.\"\"\"\n    def __init__(self, sorted_lists: list[list[str]]) -> None:\n        self.sorted_lists = sorted_lists\nclass ListValidator:\n    \"\"\"Validates if an object is a list of lists of strings.\"\"\"\n    def validate(self, lists: object) -> None:\n        if not isinstance(lists, list):\n            raise ValidationError(\"Input must be a list of lists of strings.\")\n        for i, sub in enumerate(lists):\n            if not isinstance(sub, list):\n                raise ValidationError(f\"Element at index {i} is not a list.\")\n            for j, item in enumerate(sub):\n                if not isinstance(item, str):\n                    raise ValidationError(f\"Item at [{i}][{j}] is not a string.\")\nclass SortStrategy(abc.ABC):\n    \"\"\"Abstract base class for sorting strategies.\"\"\"\n    @abc.abstractmethod\n    def sort_list(self, lst: list[str], reverse: bool = False, dedupe: bool = False) -> list[str]:\n        pass\nclass DefaultSortStrategy(SortStrategy):\n    \"\"\"Implements case-sensitive lexicographical sorting.\"\"\"\n    def sort_list(self, lst: list[str], reverse: bool = False, dedupe: bool = False) -> list[str]:\n        sorted_lst = sorted(lst, reverse=reverse)\n        if dedupe:\n            return dedupe_list(sorted_lst)\n        return sorted_lst\nclass CaseInsensitiveSortStrategy(SortStrategy):\n    \"\"\"Implements case-insensitive lexicographical sorting.\"\"\"\n    def sort_list(self, lst: list[str], reverse: bool = False, dedupe: bool = False) -> list[str]:\n        sorted_lst = sorted(lst, key=lambda s: s.lower(), reverse=reverse)\n        if dedupe:\n            return dedupe_list(sorted_lst)\n        return sorted_lst\nclass StrategyFactory:\n    \"\"\"Factory for creating SortStrategy instances based on strategy name.\"\"\"\n    def get(self, strategy_name: str) -> SortStrategy:\n        if strategy_name == 'default':\n            return DefaultSortStrategy()\n        elif strategy_name in ['case-insensitive', 'ci']:\n            return CaseInsensitiveSortStrategy()\n        else:\n            _logger.warning(f\"Unknown strategy '{strategy_name}'. Falling back to 'default'.\")\n            return DefaultSortStrategy()\nclass SorterService:\n    \"\"\"Orchestrates validation and sorting of lists of lists.\"\"\"\n    def __init__(self, validator: ListValidator, strategy_factory: StrategyFactory) -> None:\n        self._validator = validator\n        self._strategy_factory = strategy_factory\n\n    def sort(self, request: SortRequest) -> SortResult:\n        self._validator.validate(request.lists)\n\n        chosen_strategy = self._strategy_factory.get(request.strategy)\n\n        if request.in_place:\n            # If in_place, modify the original lists and return a reference to them.\n            target_lists = request.lists\n        else:\n            # If not in_place, create a new list for the results.\n            target_lists = []\n\n        for i, sublist in enumerate(request.lists):\n            sorted_sublist = chosen_strategy.sort_list(sublist, reverse=request.reverse, dedupe=request.dedupe)\n            if request.in_place:\n                # Modify the original sublist directly.\n                sublist.clear()\n                sublist.extend(sorted_sublist)\n            else:\n                # Add the new sorted sublist to the new outer list.\n                target_lists.append(sorted_sublist)\n\n        return SortResult(target_lists)\ndef sort_sublists(lists: list[list[str]], *, strategy: str = 'default',\n                  reverse: bool = False, dedupe: bool = False, in_place: bool = False) -> list[list[str]]:\n    \"\"\"Sorts each sublist of strings in a given list of lists based on specified options.\"\"\"\n    req = SortRequest(lists=lists, strategy=strategy, reverse=reverse, dedupe=dedupe, in_place=in_place)\n    service = SorterService(validator=ListValidator(), strategy_factory=StrategyFactory())\n    result = service.sort(req)\n    return result.sorted_lists"}
{"task_id": "Mbpp/573", "solution": "import collections\nclass InvalidInputError(Exception):\n    \"\"\"Raised when input validation fails.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass CalculationError(Exception):\n    \"\"\"Raised when a calculation cannot be performed.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nCACHE_MAX_ENTRIES: int = 1000\nALLOW_FLOAT_CONVERSION: bool = False\nclass UniqueProductRequest:\n    \"\"\"Data transfer object for product calculation request.\"\"\"\n    def __init__(self, numbers: list) -> None:\n        self.numbers = numbers\nclass UniqueProductResponse:\n    \"\"\"Data transfer object for product calculation response.\"\"\"\n    def __init__(self, product: int, unique_count: int) -> None:\n        self.product = product\n        self.unique_count = unique_count\nclass ProductCalculator:\n    \"\"\"Calculates the product of a list of integers.\"\"\"\n    def compute_product(self, numbers: list[int]) -> int:\n        if not numbers:\n            raise CalculationError(\"No numbers to multiply for product calculation.\")\n        result = 1\n        for n in numbers:\n            result *= n\n        return result\nclass ListValidator:\n    \"\"\"Validates input lists for unique product calculation.\"\"\"\n    def validate(self, numbers: list) -> None:\n        if not isinstance(numbers, (list, tuple)):\n            raise InvalidInputError(\"Input must be a list or tuple.\")\n        if len(numbers) == 0:\n            raise InvalidInputError(\"Input list must not be empty.\")\n        for i, v in enumerate(numbers):\n            if not isinstance(v, int):\n                if ALLOW_FLOAT_CONVERSION and isinstance(v, float) and v.is_integer():\n                    continue\n                else:\n                    raise InvalidInputError(f\"Element at index {i} is not an integer: {v!r}\")\nclass UniqueProductRepository:\n    \"\"\"In-memory cache for unique product results.\"\"\"\n    def __init__(self, max_entries: int = CACHE_MAX_ENTRIES) -> None:\n        self._store: collections.OrderedDict[tuple[int, ...], int] = collections.OrderedDict()\n        self._max_entries = max_entries\n\n    def get(self, key: tuple[int, ...]) -> int | None:\n        return self._store.get(key)\n\n    def set(self, key: tuple[int, ...], value: int) -> None:\n        if key not in self._store and len(self._store) >= self._max_entries:\n            self._store.popitem(last=False)\n        self._store[key] = value\n\n    def clear(self) -> None:\n        self._store.clear()\n\n    def size(self) -> int:\n        return len(self._store)\nclass UniqueProductService:\n    \"\"\"Orchestrates validation, caching, and product calculation.\"\"\"\n    def __init__(self, calculator: ProductCalculator, validator: ListValidator, repository: UniqueProductRepository) -> None:\n        self._calculator = calculator\n        self._validator = validator\n        self._repository = repository\n\n    def _make_cache_key(self, raw_numbers: list) -> tuple[int, ...]:\n        \"\"\"Creates a canonical cache key from a list of raw input numbers.\"\"\"\n        unique_int_numbers = sorted(list(set(map(int, raw_numbers))))\n        return tuple(unique_int_numbers)\n\n    def compute(self, request: UniqueProductRequest) -> UniqueProductResponse:\n        self._validator.validate(request.numbers)\n\n        canonical_numbers_for_key = self._make_cache_key(request.numbers)\n\n        cached_product = self._repository.get(canonical_numbers_for_key)\n        if cached_product is not None:\n            return UniqueProductResponse(cached_product, len(canonical_numbers_for_key))\n\n        product = self._calculator.compute_product(list(canonical_numbers_for_key))\n        self._repository.set(canonical_numbers_for_key, product)\n\n        return UniqueProductResponse(product, len(canonical_numbers_for_key))\nclass UniqueProductController:\n    \"\"\"API entrypoint for unique product calculation.\"\"\"\n    def __init__(self, service: UniqueProductService) -> None:\n        self._service = service\n\n    def handle(self, numbers: list) -> UniqueProductResponse:\n        request = UniqueProductRequest(numbers)\n        response = self._service.compute(request)\n        return response\n_repo = UniqueProductRepository()\n_service = UniqueProductService(ProductCalculator(), ListValidator(), _repo)\n_controller = UniqueProductController(_service)\ndef unique_product(numbers: list[int]) -> int:\n    \"\"\"\n    Calculates the product of the unique numbers in a given list.\n    Internally uses validation, caching, and a product calculation logic.\n    \"\"\"\n    response = _controller.handle(numbers)\n    return response.product"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"Calculates the last decimal digit of n! (factorial of n).\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n == 0 or n == 1:\n        return 1\n    if n >= 5:\n        return 0\n    # For n in [2, 3, 4], return known values\n    if n == 2:\n        return 2\n    if n == 3:\n        return 6\n    # n == 4\n    return 4"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1: list, list2: list, list3: list) -> list:\n    \"\"\"Interleaves three lists of the same length into a single flat list.\"\"\"\n    interleaved_list = []\n    for item1, item2, item3 in zip(list1, list2, list3):\n        interleaved_list.extend([item1, item2, item3])\n    return interleaved_list"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(t1, t2):\n    \"\"\"\n    Finds elements present in one tuple but not the other, preserving order and deduplicating.\n    Elements unique to t1 are listed first, then elements unique to t2.\n    \"\"\"\n    def is_hashable(obj):\n        \"\"\"Checks if an object is hashable.\"\"\"\n        try:\n            hash(obj)\n            return True\n        except TypeError:\n            return False\n\n    # Determine if all elements in both tuples are hashable\n    all_elements_hashable = True\n    for item in t1:\n        if not is_hashable(item):\n            all_elements_hashable = False\n            break\n    if all_elements_hashable:  # Only check t2 if t1 was all hashable\n        for item in t2:\n            if not is_hashable(item):\n                all_elements_hashable = False\n                break\n\n    def _get_unique_in_order_filtered(source_tuple, exclude_from_tuple, are_elements_hashable):\n        \"\"\"\n        Extracts elements from source_tuple not found in exclude_from_tuple,\n        preserving original order and returning each unique element once.\n        \"\"\"\n        result = []\n\n        if are_elements_hashable:\n            seen_in_source = set()  # For deduplication within source_tuple\n            exclude_set = set(exclude_from_tuple)  # For efficient lookup of excluded items\n            for item in source_tuple:\n                if item not in exclude_set and item not in seen_in_source:\n                    result.append(item)\n                    seen_in_source.add(item)\n        else:  # Fallback for unhashable elements, uses linear scans\n            seen_in_source_list = []  # List to track seen elements for unhashable items\n            for item in source_tuple:\n                # Check if item is in exclude_from_tuple (linear scan)\n                is_in_exclude = False\n                for excl_item in exclude_from_tuple:\n                    if item == excl_item:\n                        is_in_exclude = True\n                        break\n\n                if not is_in_exclude:\n                    # Check if item has been added to result already (deduplication via linear scan)\n                    is_seen_in_result = False\n                    for seen_item in seen_in_source_list:\n                        if item == seen_item:\n                            is_seen_in_result = True\n                            break\n\n                    if not is_seen_in_result:\n                        result.append(item)\n                        seen_in_source_list.append(item)\n        return result\n\n    # Find elements unique to t1\n    t1_only = _get_unique_in_order_filtered(t1, t2, all_elements_hashable)\n\n    # Find elements unique to t2\n    t2_only = _get_unique_in_order_filtered(t2, t1, all_elements_hashable)\n\n    return tuple(t1_only + t2_only)"}
{"task_id": "Mbpp/585", "solution": "def expensive_items(items, n):\n    \"\"\"\n    Finds the n most expensive items in a list, sorting by price descending and then name ascending for ties.\n    Assumes valid input according to the design context.\n    \"\"\"\n    if not items:\n        return []\n\n    # Sort the items: price descending, then name ascending for tie-breaking\n    # Use a lambda for the sort key to access 'price' and 'name'\n    sorted_items = sorted(items, key=lambda item: (-item['price'], item['name']))\n\n    # Return the top n items\n    return sorted_items[:n]"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"\n    Computes the nth Catalan number using the binomial coefficient formula C_n = binomial(2n, n) // (n + 1).\n    Exact integer arithmetic is used (Python ints are arbitrary precision).\n    \"\"\"\n    def binomial(N: int, K: int) -> int:\n        \"\"\"\n        Calculates N choose K using an iterative multiplicative formula.\n        \"\"\"\n        if K < 0 or K > N:\n            return 0\n        if K == 0 or K == N:\n            return 1\n        if K > N // 2:\n            K = N - K\n\n        res = 1\n        for i in range(1, K + 1):\n            res = res * (N - K + i) // i\n        return res\n\n    if n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    return binomial(2 * n, n) // (n + 1)"}
{"task_id": "Mbpp/580", "solution": "def extract_even(t: tuple) -> tuple:\n    \"\"\"Recursively removes odd integer elements from a nested tuple.\"\"\"\n    result = []\n    for item in t:\n        if isinstance(item, int):\n            if item % 2 == 0:\n                result.append(item)\n        elif isinstance(item, tuple):\n            result.append(extract_even(item))\n        else:\n            result.append(item)\n    return tuple(result)"}
{"task_id": "Mbpp/581", "solution": "def surface_Area(base_edge, height):\n    \"\"\"\n    Calculates the surface area of a square pyramid.\n    The 'height' parameter is interpreted as the slant height of the pyramid's triangular faces.\n    \"\"\"\n    base_area = base_edge ** 2\n    lateral_area = 2 * base_edge * height\n    return base_area + lateral_area"}
