{"task_id": "Mbpp/132", "solution": "def tup_string(tup: tuple[str, ...]) -> str:\n    \"\"\"Converts a tuple of characters to a string.\"\"\"\n    class InvalidTupleError(Exception):\n        pass\n\n    class InvalidElementError(Exception):\n        pass\n\n    def validate_tuple_input(t: any) -> None:\n        if not isinstance(t, tuple):\n            raise InvalidTupleError(f\"Input must be a tuple, but got {type(t).__name__}.\")\n\n    def validate_char_element(elem: any) -> None:\n        if not isinstance(elem, str) or len(elem) != 1:\n            raise InvalidElementError(f\"Tuple elements must be single-character strings, but got '{elem}' of type {type(elem).__name__} and length {len(elem) if isinstance(elem, str) else 'N/A'}.\")\n\n    class CharTupleModel:\n        def __init__(self, chars: tuple[str, ...]) -> None:\n            self._chars = chars\n\n        @property\n        def chars(self) -> tuple[str, ...]:\n            return self._chars\n\n        def validate(self) -> None:\n            validate_tuple_input(self._chars)\n            for c in self._chars:\n                validate_char_element(c)\n\n        def to_string(self) -> str:\n            self.validate()\n            return \"\".join(self._chars)\n\n    model = CharTupleModel(tup)\n    return model.to_string()"}
{"task_id": "Mbpp/135", "solution": "def hexagonal_num(n: int) -> int:\n    \"\"\"Return the nth hexagonal number H(n) = n * (2*n - 1).\n\n    Args:\n        n: Integer index (must be >= 1).\n\n    Returns:\n        The nth hexagonal number as an int.\n\n    Raises:\n        ValueError: If n is not an integer or is less than 1.\n    \"\"\"\n    # Reject booleans which are instances of int\n    if isinstance(n, bool):\n        raise ValueError(f\"n must be an integer >= 1, got {n!r}\")\n\n    try:\n        n_int = int(n)\n    except Exception:\n        raise ValueError(f\"n must be an integer >= 1, got {n!r}\")\n\n    if n_int < 1:\n        raise ValueError(f\"n must be >= 1, got {n_int}\")\n\n    return n_int * (2 * n_int - 1)"}
