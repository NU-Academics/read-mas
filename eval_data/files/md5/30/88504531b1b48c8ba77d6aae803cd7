{"task_id": "Mbpp/161", "solution": "def remove_elements(source_list, elements_to_remove):\n    \"\"\"\n    Removes all elements from the source_list that are present in elements_to_remove, preserving order.\n    It attempts an efficient set-based removal and falls back to a slower comparison if elements are unhashable.\n    \"\"\"\n    if not isinstance(source_list, list) or not isinstance(elements_to_remove, list):\n        raise TypeError(\"source_list and elements_to_remove must be lists\")\n\n    try:\n        # Use a set for efficient O(1) average-time lookups if elements are hashable.\n        remove_set = set(elements_to_remove)\n        return [item for item in source_list if item not in remove_set]\n    except TypeError:\n        # Fallback for unhashable elements in elements_to_remove, using O(n*m) comparison.\n        result = []\n        for item_source in source_list:\n            found_in_remove = False\n            for item_remove in elements_to_remove:\n                if item_source == item_remove:\n                    found_in_remove = True\n                    break\n            if not found_in_remove:\n                result.append(item_source)\n        return result"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(s: str) -> int:\n    \"\"\"\n    Counts characters in a string that match their 1-based English alphabet position.\n    Comparison is case-insensitive, and non-alphabetic characters are ignored for matching.\n    \"\"\"\n    english_alphabet = \"abcdefghijklmnopqrstuvwxyz\"\n    count = 0\n    for idx, char in enumerate(s, start=1):\n        normalized_char = char.lower()\n        if normalized_char in english_alphabet:\n            alpha_index = english_alphabet.index(normalized_char) + 1\n            if alpha_index == idx:\n                count += 1\n    return count"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(numbers):\n    \"\"\"Counts pairs of integers in a list whose XOR is even.\n\n    An XOR result is even iff the two numbers have the same parity\n    (both even or both odd). This counts unordered pairs (i < j).\n    \"\"\"\n    n_even = 0\n    n_odd = 0\n    for n in numbers:\n        if n % 2 == 0:\n            n_even += 1\n        else:\n            n_odd += 1\n\n    # n choose 2 = n*(n-1)//2\n    even_pairs = n_even * (n_even - 1) // 2\n    odd_pairs = n_odd * (n_odd - 1) // 2\n\n    return even_pairs + odd_pairs"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n):\n    \"\"\"Calculates the sum of the series n + (n-2) + (n-4) + ... while terms are positive.\n\n    Args:\n        n (int): non-negative integer input\n\n    Returns:\n        int: sum of the series\n\n    Examples:\n        >>> sum_series(6)\n        12\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    # number of positive terms: floor((n + 1) / 2)\n    k = (n + 1) // 2\n    if k == 0:\n        return 0\n\n    last_term = n - 2 * (k - 1)\n    # sum of arithmetic series: k * (first + last) / 2\n    return k * (n + last_term) // 2"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    def extended_gcd_impl(num1, num2):\n        # Implements the iterative extended Euclidean algorithm.\n        # It finds g, x, y such that num1*x + num2*y = g = gcd(num1, num2).\n\n        # Store original signs to adjust x, y coefficients at the end\n        sign_a = 1 if num1 >= 0 else -1\n        sign_b = 1 if num2 >= 0 else -1\n\n        # Work with absolute values for the Euclidean algorithm itself\n        abs_a, abs_b = abs(num1), abs(num2)\n\n        # Initialize for extended Euclidean algorithm:\n        # old_r, r track the remainders in Euclidean algorithm\n        # old_s, s track the coefficients for abs_a (s.t. old_r = old_s*abs_a + old_t*abs_b)\n        # old_t, t track the coefficients for abs_b\n        old_r, r = abs_a, abs_b\n        old_s, s = 1, 0\n        old_t, t = 0, 1\n\n        while r != 0:\n            q = old_r // r\n            old_r, r = r, old_r - q * r\n            old_s, s = s, old_s - q * s\n            old_t, t = t, old_t - q * t\n\n        # g = old_r (the gcd)\n        # old_s and old_t are the Bezout coefficients for abs_a and abs_b\n        # We adjust them by the original signs to get coefficients for num1 and num2\n        return old_r, old_s * sign_a, old_t * sign_b\n\n\n    # Handle the degenerate case where both a and b are zero\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    # Compute g = gcd(a, b) and initial Bezout coefficients x_base, y_base\n    # such that a*x_base + b*y_base = g\n    g, x_base, y_base = extended_gcd_impl(a, b)\n\n    # If n is not divisible by g, there is no integer solution\n    if n % g != 0:\n        return None\n\n    # Scale Bezout coefficients to find a particular solution for ax + by = n\n    scale_factor = n // g\n    x_particular = x_base * scale_factor\n    y_particular = y_base * scale_factor\n\n    # Adjust (x_particular, y_particular) to find a specific canonical solution.\n    # The general solution form is: x = x_particular + k * (b/g), y = y_particular - k * (a/g)\n    # We aim to find the solution where x is the smallest non-negative value (i.e., x in [0, abs(b/g) - 1]).\n\n    # If b/g is 0 (which happens if b=0), x is uniquely determined as n/a.\n    # The adjustment logic would cause a ZeroDivisionError in this case, so handle it separately.\n    if b == 0:\n        return (x_particular, y_particular)\n\n    # Calculate the steps for x and y in the general solution\n    dx_step = b // g\n    dy_step = a // g\n\n    # Calculate the `k_shift` that brings `x_particular` to its smallest non-negative equivalent\n    # `x_target_for_k` is the smallest non-negative x-value in the residue class modulo `dx_step`.\n    x_target_for_k = (x_particular % dx_step + dx_step) % dx_step\n\n    # Solve for k: x_particular + k * dx_step = x_target_for_k\n    k_shift = (x_target_for_k - x_particular) // dx_step\n\n    # Apply the shift to find the final solution (x, y)\n    final_x = x_particular + k_shift * dx_step\n    final_y = y_particular - k_shift * dy_step\n\n    return (final_x, final_y)"}
{"task_id": "Mbpp/167", "solution": "from dataclasses import dataclass\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\n    def __str__(self) -> str:\n        return self.message\nclass NextPowerCalculator:\n    \"\"\"Computes the smallest power of two greater than or equal to n.\"\"\"\n    DEFAULT_MIN_RESULT: int = 1\n\n    def compute(self, n: int) -> int:\n        if n <= self.DEFAULT_MIN_RESULT:\n            return self.DEFAULT_MIN_RESULT\n        if (n & (n - 1)) == 0:\n            return n\n        return 1 << n.bit_length()\nclass InputValidator:\n    \"\"\"Validates and normalizes input values.\"\"\"\n    def validate(self, n: object) -> int:\n        if isinstance(n, int):\n            if n < 0:\n                raise InvalidInputError(\"n must be non-negative\")\n            return n\n        if isinstance(n, str):\n            try:\n                parsed = int(n.strip())\n            except ValueError:\n                raise InvalidInputError(f\"cannot parse '{n}' as int\")\n            if parsed < 0:\n                raise InvalidInputError(\"n must be non-negative\")\n            return parsed\n        raise InvalidInputError(\"unsupported input type; expected int or str\")\nclass CalculatorService:\n    \"\"\"Orchestrates validation and power of two calculation.\"\"\"\n    def __init__(self, validator: InputValidator = None, calculator: NextPowerCalculator = None):\n        self.validator = validator or InputValidator()\n        self.calculator = calculator or NextPowerCalculator()\n\n    def get_next_power(self, n: object) -> ResultDTO:\n        normalized = self.validator.validate(n)\n        result = self.calculator.compute(normalized)\n        return ResultDTO(input=normalized, result=result)\ndef next_power_of_2(n: int) -> int:\n    \"\"\"\n    Computes the smallest power of two greater than or equal to a given non-negative integer n.\n    Raises InvalidInputError if n is not an integer or is negative.\n    \"\"\"\n    _default_service = CalculatorService()\n    dto = _default_service.get_next_power(n)\n    return dto.result"}
