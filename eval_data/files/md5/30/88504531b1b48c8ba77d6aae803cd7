{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(a, b):\n    \"\"\"\n    Calculates the sum of per-digit absolute differences between two integers.\n    The shorter number is padded with leading zeros for alignment.\n    \"\"\"\n    def _abs_digits_from_int(value: int) -> list[int]:\n        \"\"\"Returns a list of digits from most-significant to least-significant for the absolute value of `value`.\"\"\"\n        v = abs(value)\n        if v == 0:\n            return [0]\n        digits_reversed = []\n        while v:\n            digits_reversed.append(v % 10)\n            v //= 10\n        return list(reversed(digits_reversed))\n\n    def _align_digits(a_digits: list[int], b_digits: list[int]) -> tuple[list[int], list[int]]:\n        \"\"\"Pads the shorter digit list with leading zeros to match the length of the longer list.\"\"\"\n        la, lb = len(a_digits), len(b_digits)\n        if la < lb:\n            a_digits = [0] * (lb - la) + a_digits\n        elif lb < la:\n            b_digits = [0] * (la - lb) + b_digits\n        return a_digits, b_digits\n\n    # Convert integers to lists of their absolute digits\n    a_digits = _abs_digits_from_int(a)\n    b_digits = _abs_digits_from_int(b)\n\n    # Align the digit lists by padding with leading zeros\n    a_aligned, b_aligned = _align_digits(a_digits, b_digits)\n\n    # Calculate the sum of absolute differences for each pair of aligned digits\n    total_difference = sum(abs(x - y) for x, y in zip(a_aligned, b_aligned))\n\n    return total_difference"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr: list, n: int) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist using Kadane's algorithm.\n\n    Parameters:\n    - arr: list of integers\n    - n: expected length of arr (will be validated against len(arr))\n\n    Returns:\n    - int: maximum contiguous subarray sum\n\n    Behavior:\n    - If arr is empty, returns 0.\n    - If n does not match len(arr), raises ValueError.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"arr must be a list of integers\")\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n != len(arr):\n        raise ValueError(\"n must be equal to len(arr)\")\n\n    if n == 0:\n        return 0\n\n    # Initialize with first element to handle all-negative lists correctly\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, n):\n        current_max = arr[i] if arr[i] > current_max + arr[i] else current_max + arr[i]\n        if current_max > max_so_far:\n            max_so_far = current_max\n\n    return max_so_far"}
{"task_id": "Mbpp/560", "solution": "def union_elements(a, b):\n    \"\"\"\n    Finds the union of elements from two tuples and returns them in sorted order.\n    \"\"\"\n    combined_elements = set(a) | set(b)\n    sorted_unique_elements = sorted(list(combined_elements))\n    return tuple(sorted_unique_elements)"}
{"task_id": "Mbpp/564", "solution": "import collections\ndef count_Pairs(nums, n):\n    \"\"\"\n    Counts the number of possible unordered pairs in a list where both elements are unequal.\n    The 'n' parameter is ignored; the function operates based on the length of 'nums'.\n    \"\"\"\n    total_elements = len(nums)\n    if total_elements < 2:\n        return 0\n\n    # Calculate total possible unordered pairs without any restrictions\n    total_possible_pairs = total_elements * (total_elements - 1) // 2\n\n    # Count frequencies of each number\n    freq = collections.Counter(nums)\n\n    # Calculate pairs where both elements are equal\n    equal_pairs = 0\n    for count in freq.values():\n        if count >= 2:\n            equal_pairs += count * (count - 1) // 2\n\n    # The number of unequal pairs is total possible pairs minus equal pairs\n    return total_possible_pairs - equal_pairs"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(lists):\n    \"\"\"\n    Finds the length of the longest sublist within a given list of lists.\n    Returns 0 if the input list is empty or contains no sublists.\n    \"\"\"\n    max_len = 0\n    for sublist in lists:\n        current_len = len(sublist)\n        if current_len > max_len:\n            max_len = current_len\n    return max_len"}
