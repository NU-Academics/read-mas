{"task_id": "Mbpp/410", "solution": "def min_val(items, *, permissive: bool = False, return_none_on_empty: bool = False):\n    \"\"\"\n    Find the minimum numeric value in a heterogeneous iterable.\n\n    Args:\n        items: An iterable of heterogeneous items.\n        permissive: If True, attempt to parse numeric-looking strings as numbers.\n        return_none_on_empty: If True, return None when no numeric values are found;\n                              otherwise raise ValueError.\n\n    Returns:\n        The minimum numeric value (int, float or Decimal) or None if configured.\n\n    Raises:\n        TypeError: If items is not an iterable.\n        ValueError: If no numeric values are found and return_none_on_empty is False.\n    \"\"\"\n    import re\n    from decimal import Decimal, InvalidOperation\n    from collections.abc import Iterable\n\n    if not isinstance(items, Iterable):\n        raise TypeError(\"items must be an iterable\")\n\n    # Regex to detect plain numeric strings (integer, float, scientific)\n    _NUMERIC_REGEX = re.compile(r'^[+-]?\\d+(\\.\\d+)?([eE][+-]?\\d+)?$')\n\n    found_any = False\n    current_min = None\n\n    for item in items:\n        value = None\n\n        # Exclude booleans which are subclasses of int\n        if isinstance(item, (int, float, Decimal)) and not isinstance(item, bool):\n            value = item\n        elif permissive and isinstance(item, str):\n            s = item.strip()\n            if _NUMERIC_REGEX.match(s):\n                try:\n                    # Prefer int when possible; otherwise float\n                    if '.' in s or 'e' in s or 'E' in s:\n                        value = float(s)\n                    else:\n                        value = int(s)\n                except (ValueError, OverflowError):\n                    try:\n                        value = Decimal(s)\n                    except (InvalidOperation, ValueError):\n                        value = None\n\n        if value is not None:\n            if not found_any:\n                current_min = value\n                found_any = True\n            else:\n                # Rely on Python's numeric comparison semantics\n                try:\n                    if value < current_min:\n                        current_min = value\n                except TypeError:\n                    # Mixed types that cannot be compared (very rare); convert to float as a fallback\n                    try:\n                        if float(value) < float(current_min):\n                            current_min = value\n                    except Exception:\n                        # If conversion fails, ignore this value\n                        pass\n\n    if not found_any:\n        if return_none_on_empty:\n            return None\n        raise ValueError(\"No numeric values found in the iterable\")\n\n    return current_min"}
{"task_id": "Mbpp/413", "solution": "def extract_nth_element(list_of_tuples, n):\n    \"\"\"\n    Extracts the nth element from each tuple in a given list of tuples.\n\n    Args:\n        list_of_tuples: sequence (typically list) of tuples\n        n: zero-based index to extract from each tuple\n\n    Returns:\n        List of extracted elements.\n\n    Raises:\n        TypeError: if list_of_tuples is not a sequence of tuples or n is not an int.\n        IndexError: if any tuple does not contain index n.\n    \"\"\"\n    # Basic validation\n    if not isinstance(list_of_tuples, (list, tuple)):\n        raise TypeError(\"list_of_tuples must be a list or tuple of tuples\")\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n\n    result = []\n    for i, item in enumerate(list_of_tuples):\n        if not isinstance(item, tuple):\n            raise TypeError(f\"Element at position {i} is not a tuple\")\n        try:\n            result.append(item[n])\n        except IndexError as e:\n            raise IndexError(f\"Tuple at position {i} does not have index {n}\") from e\n\n    return result"}
{"task_id": "Mbpp/414", "solution": "from typing import Iterable, Any, Optional, Set, Sequence\ndef overlapping(seq1: Sequence[Any], seq2: Sequence[Any]) -> bool:\n    \"\"\"\n    Checks if any value in seq1 exists in seq2.\n    Uses set intersection for hashable items, falls back to nested loops otherwise.\n    \"\"\"\n\n    def _to_iterable(seq: Any) -> Iterable[Any]:\n        \"\"\"\n        Converts an input to a re-iterable sequence (list or tuple).\n        Strings and bytes are treated as single atomic items.\n        \"\"\"\n        if isinstance(seq, (str, bytes)):\n            return [seq]\n        if isinstance(seq, (list, tuple)):\n            return seq\n        try:\n            # Convert any other iterable (like a set, generator, or range) to a list\n            # to ensure it's re-iterable for multiple passes.\n            return list(seq)\n        except TypeError:\n            # If not iterable (scalar), wrap it in a list.\n            return [seq]\n\n    def _to_hashable_set(seq_iterable: Iterable[Any]) -> Optional[Set[Any]]:\n        \"\"\"\n        Attempts to convert an iterable to a set.\n        Returns the set if all elements are hashable, otherwise returns None.\n        \"\"\"\n        s = set()\n        for item in seq_iterable:\n            try:\n                s.add(item)\n            except TypeError:\n                return None  # An unhashable item was found\n        return s\n\n    # Convert original sequences to re-iterable forms (lists or tuples).\n    # This ensures they can be consumed multiple times, once for set conversion and potentially again for nested loops.\n    a_processed = _to_iterable(seq1)\n    b_processed = _to_iterable(seq2)\n\n    # Attempt to convert to sets for an efficient O(N+M) intersection check.\n    a_set = _to_hashable_set(a_processed)\n    b_set = _to_hashable_set(b_processed)\n\n    if a_set is not None and b_set is not None:\n        # Both sequences contain only hashable items, use efficient set intersection.\n        return bool(a_set.intersection(b_set))\n    else:\n        # Fallback to O(N*M) nested loop comparison if any unhashable items were present.\n        # Since a_processed and b_processed are already re-iterable lists/tuples,\n        # they can be directly used here without further conversion.\n        for x in a_processed:\n            for y in b_processed:\n                if x == y:\n                    return True\n        return False"}
{"task_id": "Mbpp/415", "solution": "from typing import Sequence, Tuple\ndef max_Product(arr: Sequence[int]) -> Tuple[int, int]:\n    \"\"\"\n    Finds a pair with the highest product from a given array of integers.\n    The algorithm tracks the two largest and two smallest numbers in O(n) time.\n    \"\"\"\n    # Input validation\n    if arr is None:\n        raise ValueError(\"Input array must not be None\")\n    # Ensure there are at least two elements\n    n = len(arr)\n    if n < 2:\n        raise ValueError(\"Need at least two integers to form a product\")\n\n    # Initialize variables to track the two largest and two smallest numbers.\n    # Use sentinels that are outside typical integer ranges.\n    largest = -10**18\n    second_largest = -10**18\n\n    smallest = 10**18\n    second_smallest = 10**18\n\n    # Iterate through the array to find these four extreme numbers.\n    for x in arr:\n        if not isinstance(x, int):\n            raise ValueError(\"All elements must be integers\")\n\n        # Update largest and second_largest\n        if x >= largest:\n            second_largest = largest\n            largest = x\n        elif x > second_largest:\n            second_largest = x\n\n        # Update smallest and second_smallest\n        if x <= smallest:\n            second_smallest = smallest\n            smallest = x\n        elif x < second_smallest:\n            second_smallest = x\n\n    # Calculate the product of the two largest numbers.\n    product_of_largest_two = largest * second_largest\n    pair_of_largest_two = (min(largest, second_largest), max(largest, second_largest))\n\n    # Calculate the product of the two smallest numbers (relevant for two negatives).\n    product_of_smallest_two = smallest * second_smallest\n    pair_of_smallest_two = (min(smallest, second_smallest), max(smallest, second_smallest))\n\n    # Compare the two candidate products and apply tie-breaking rules if necessary.\n    if product_of_largest_two > product_of_smallest_two:\n        return pair_of_largest_two\n    elif product_of_smallest_two > product_of_largest_two:\n        return pair_of_smallest_two\n    else:\n        # Products are equal, apply tie-breaking: prefer the pair with smaller first element, then smaller second.\n        if pair_of_largest_two[0] < pair_of_smallest_two[0]:\n            return pair_of_largest_two\n        elif pair_of_smallest_two[0] < pair_of_largest_two[0]:\n            return pair_of_smallest_two\n        else:  # First elements are equal, compare second elements.\n            if pair_of_largest_two[1] < pair_of_smallest_two[1]:\n                return pair_of_largest_two\n            else:\n                return pair_of_smallest_two"}
{"task_id": "Mbpp/418", "solution": "def Find_Max(items):\n    \"\"\"\n    Return the element of a sequence that has the maximum length.\n\n    If multiple elements share the maximum length, the first occurrence is returned.\n    Raises:\n      - TypeError if `items` is not iterable or elements do not support len().\n      - ValueError if `items` is empty or is None.\n    \"\"\"\n    if items is None:\n        raise ValueError(\"Input is None\")\n\n    try:\n        seq = list(items)\n    except TypeError as e:\n        raise TypeError(\"Input is not iterable\") from e\n\n    if len(seq) == 0:\n        raise ValueError(\"Input sequence is empty\")\n\n    try:\n        return max(seq, key=len)\n    except TypeError as e:\n        # Happens if elements don't support len()\n        raise TypeError(\"Elements must have a length (support __len__)\") from e"}
{"task_id": "Mbpp/419", "solution": "from decimal import Decimal, ROUND_HALF_UP\nfrom typing import List\nclass CalculationError(Exception):\n    \"\"\"Exception for calculation failures.\"\"\"\n    pass\nclass ServiceError(Exception):\n    \"\"\"Generic exception for service failures.\"\"\"\n    pass\ndef round_half_up(value: float) -> int:\n    \"\"\"Rounds a float to the nearest integer, with halves rounding up (e.g., 2.5 -> 3, -2.5 -> -3).\"\"\"\n    d = Decimal(str(value))\n    return int(d.quantize(Decimal(\"1\"), rounding=ROUND_HALF_UP))\nclass OutputRepository:\n    \"\"\"Abstract base class for output mechanisms.\"\"\"\n    def write(self, result: int) -> None:\n        raise NotImplementedError\nclass PrintOutputRepository(OutputRepository):\n    \"\"\"An OutputRepository that, for programmatic calls, does not print, as the result is returned.\"\"\"\n    def write(self, result: int) -> None:\n        pass # The result is returned by the function; printing is for CLI.\nclass RoundingService:\n    \"\"\"Service to apply round_half_up to a list of numbers.\"\"\"\n    def round_numbers(self, numbers: List[float]) -> List[int]:\n        try:\n            return [round_half_up(x) for x in numbers]\n        except Exception as e:\n            raise ServiceError(\"Rounding failed\") from e\nclass AggregateService:\n    \"\"\"Service to aggregate rounded numbers and multiply by original length.\"\"\"\n    def aggregate(self, rounded: List[int], original_len: int) -> int:\n        try:\n            total = sum(rounded)\n            return total * original_len\n        except Exception as e:\n            raise CalculationError(\"Aggregation failed\") from e\nclass RoundAndSumApp:\n    \"\"\"Orchestrates rounding, aggregation, and output for a list of numbers.\"\"\"\n    def __init__(self, output_repo: OutputRepository, service: RoundingService, aggregator: AggregateService):\n        self._output = output_repo\n        self._service = service\n        self._aggregator = aggregator\n\n    def execute(self, numbers: List[float]) -> int:\n        \"\"\"Executes the rounding and summing logic.\"\"\"\n        rounded = self._service.round_numbers(numbers)\n        result = self._aggregator.aggregate(rounded, len(numbers))\n        self._output.write(result)\n        return result\ndef round_and_sum(numbers: List[float]) -> int:\n    \"\"\"\n    Rounds every number in a list using round half up, sums them, and\n    multiplies the sum by the original list's length.\n    \"\"\"\n    app = RoundAndSumApp(PrintOutputRepository(), RoundingService(), AggregateService())\n    return app.execute(numbers)"}
{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n):\n    \"\"\"\n    Calculates the average of the cubes of the first n natural numbers.\n    Uses the closed-form formula: average = n * (n + 1)^2 / 4.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be an integer >= 1\")\n    result = n * (n + 1) * (n + 1) / 4\n    return float(result)"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of cubes of the first n even natural numbers using a closed-form formula.\n    The formula is 2 * (n * (n + 1))^2.\n    \"\"\"\n    # Validate input\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    # Sum of cubes of first n even natural numbers (2k)^3 for k from 1 to n:\n    # 8 * sum_{k=1..n} k^3 = 8 * (n(n+1)/2)^2 = 2 * (n(n+1))^2\n    nn_plus_1 = n * (n + 1)\n    return 2 * (nn_plus_1 * nn_plus_1)"}
{"task_id": "Mbpp/421", "solution": "def concatenate_tuple(items: tuple, delimiter: str = '-') -> str:\n    \"\"\"Concatenates each element of a tuple into a single string using the specified delimiter.\"\"\"\n    formatted_items = []\n    for item in items:\n        if item is None:\n            formatted_items.append(\"None\")\n        else:\n            formatted_items.append(str(item))\n    return delimiter.join(formatted_items)"}
{"task_id": "Mbpp/425", "solution": "def count_element_in_list(lists, element):\n    \"\"\"\n    Counts the number of sublists containing a particular element.\n    \"\"\"\n    count = 0\n    for item in lists:\n        # Treat strings and bytes as single items (not iterables of characters for this purpose)\n        if isinstance(item, (str, bytes)):\n            search_target = [item]\n        else:\n            try:\n                iter(item)\n                search_target = item\n            except TypeError:\n                # Non-iterable: wrap as single-item list\n                search_target = [item]\n\n        try:\n            if element in search_target:\n                count += 1\n        except TypeError:\n            # If membership test fails (e.g., item is a set and element is unhashable),\n            # fall back to safe iteration and equality checks\n            try:\n                found = False\n                for x in search_target:\n                    if x == element:\n                        found = True\n                        break\n                if found:\n                    count += 1\n            except Exception:\n                # On any unexpected error, treat as not found for this sublist\n                pass\n\n    return count"}
