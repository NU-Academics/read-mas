{"task_id": "Mbpp/4", "solution": "import heapq\ndef heap_queue_largest(numbers: list[int], n: int) -> list[int]:\n    \"\"\"Finds the n largest integers from a list, returned in descending order.\n    Uses heapq.nlargest for efficient computation.\"\"\"\n    top_k = heapq.nlargest(n, numbers)\n    return sorted(top_k, reverse=True)"}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(n: int) -> bool:\n    \"\"\"\n    Identifies if a number is non-prime.\n    Returns True for non-prime numbers (including 0, 1, and negatives), False for primes.\n    \"\"\"\n    if not isinstance(n, int) or isinstance(n, bool):\n        raise TypeError(f\"Expected int, got {type(n).__name__}\")\n\n    if n <= 1:\n        return True\n\n    if n == 2 or n == 3:\n        return False\n\n    if n % 2 == 0 or n % 3 == 0:\n        return True\n\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return True\n        i += 6\n    return False"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(a: int, b: int) -> bool:\n    \"\"\"Checks if two integers differ at exactly one bit position.\"\"\"\n\n    class BitUtilsError(Exception):\n        def __init__(self, message: str, cause: Exception | None = None) -> None:\n            super().__init__(message)\n            self.message = message\n            self.cause = cause\n\n    class InputTypeError(BitUtilsError):\n        pass\n\n    class BitComparator:\n        def __init__(self) -> None:\n            pass\n\n        def differ_exactly_one_bit(self, a: int, b: int) -> bool:\n            x = self._xor_value(a, b)\n            return self._popcount(x) == 1\n\n        def _xor_value(self, a: int, b: int) -> int:\n            return a ^ b\n\n        def _popcount(self, x: int) -> int:\n            return x.bit_count()\n\n    class BitService:\n        def __init__(self, comparator: BitComparator | None = None) -> None:\n            self._comparator = comparator or BitComparator()\n\n        def check_single_bit_difference(self, a: int, b: int) -> bool:\n            # Per user requirements, no isinstance checks or explicit exception raising for edge cases.\n            return self._comparator.differ_exactly_one_bit(a, b)\n\n    service = BitService()\n    return service.check_single_bit_difference(a, b)"}
{"task_id": "Mbpp/7", "solution": "import re\nclass Word:\n    def __init__(self, text: str) -> None:\n        self.text = text\n        self.length = len(text)\n\n    def __repr__(self) -> str:\n        return f\"Word(text='{self.text}', length={self.length})\"\nclass Tokenizer:\n    WORD_RE = re.compile(r\"[A-Za-z0-9]+(?:'[A-Za-z0-9]+)*\", re.UNICODE)\n\n    def tokenize(self, text: str) -> list[str]:\n        return self.WORD_RE.findall(text)\nclass WordFinderService:\n    def __init__(self, tokenizer: Tokenizer = None):\n        self.tokenizer = tokenizer or Tokenizer()\n\n    def find_long_words(self, text: str, min_length: int = 4) -> list[str]:\n        tokens = self.tokenizer.tokenize(text)\n        words = [Word(t) for t in tokens]\n        return [w.text for w in words if w.length >= min_length]\n_default_service = WordFinderService()\ndef find_char_long(text: str, min_length: int = 4) -> list[str]:\n    \"\"\"\n    Finds words in a string that are at least a specified minimum length.\n    It tokenizes the text and filters words based on their character count.\n    \"\"\"\n    return _default_service.find_long_words(text, min_length=min_length)"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(a, b):\n    \"\"\"\n    Finds unique common elements between two iterables, supporting both hashable\n    and non-hashable items, and sorts the result if elements are comparable.\n    \"\"\"\n    list_a = list(a)\n    list_b = list(b)\n    shared_elements = []\n\n    if not list_a or not list_b:\n        return []\n\n    try:\n        # Attempt hash-based intersection for efficiency with hashable items\n        set_b = set(list_b)\n        seen = set()\n        for item in list_a:\n            if item in set_b and item not in seen:\n                shared_elements.append(item)\n                seen.add(item)\n    except TypeError:\n        # Fallback to O(n*m) comparison for non-hashable items\n        seen_in_a = [] # Track items from list_a already processed to ensure uniqueness\n        for item_a in list_a:\n            # Check if this item_a (or an equivalent) has already been processed and added\n            if any(item_a == seen_item for seen_item in seen_in_a):\n                continue\n\n            for item_b in list_b:\n                if item_a == item_b:\n                    shared_elements.append(item_a)\n                    break # Found a match, move to the next unique item_a\n            seen_in_a.append(item_a) # Mark item_a as processed\n\n    # Sort the shared elements if they are comparable; otherwise, keep insertion order.\n    try:\n        shared_elements.sort()\n    except TypeError:\n        # Elements are not comparable, maintain the stable order from processing.\n        pass\n\n    return shared_elements"}
{"task_id": "Mbpp/17", "solution": "def square_perimeter(side):\n    \"\"\"\n    Calculate the perimeter of a square given its side length.\n\n    Accepts int, float, or string convertible to float. Raises ValueError for\n    non-numeric, NaN/Infinity, or negative inputs.\n    \"\"\"\n    import math\n\n    try:\n        value = float(side)\n    except (TypeError, ValueError):\n        raise ValueError(\"Side length must be a numeric value.\") from None\n\n    if not math.isfinite(value):\n        raise ValueError(\"Side length must be a finite number.\")\n\n    if value < 0:\n        raise ValueError(\"Side length must be non-negative.\")\n\n    return 4 * value"}
