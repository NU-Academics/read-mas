{"task_id": "Mbpp/170", "solution": "def sum_range_list(data: list[int | float], start: int, end: int) -> int | float:\n    \"\"\"\n    Calculates the sum of numbers in a list within a specified inclusive range.\n    Handles negative indices following Python's semantics.\n    \"\"\"\n    length = len(data)\n\n    # Normalize negative indices to non-negative equivalents.\n    actual_start = start if start >= 0 else start + length\n    actual_end = end if end >= 0 else end + length\n\n    total_sum = 0\n    # Iterate through the specified inclusive range [actual_start, actual_end]\n    for i in range(actual_start, actual_end + 1):\n        total_sum += data[i]\n\n    return total_sum"}
{"task_id": "Mbpp/222", "solution": "from .controllers import CheckController\nfrom .repositories import TupleRepository\nfrom .services import TypeChecker\ndef check_type(t: object) -> bool:\n    \"\"\"Checks if all elements in a given object (normalized to a tuple) are of the same type.\"\"\"\n    repo = TupleRepository()\n    checker = TypeChecker()\n    controller = CheckController(repo, checker)\n    return controller.check_tuple_input(t)"}
{"task_id": "Mbpp/172", "solution": "def count_occurance(text):\n    \"\"\"Counts the non-overlapping occurrences of the substring 'std' in the given text.\"\"\"\n    substring = \"std\"\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a str\")\n    count = 0\n    i = 0\n    step = len(substring)\n\n    while True:\n        idx = text.find(substring, i)\n        if idx == -1:\n            break\n        count += 1\n        i = idx + step\n    return count"}
{"task_id": "Mbpp/223", "solution": "def is_majority(arr: list[int], n: int, x: int) -> bool:\n    \"\"\"\n    Checks if an element is the majority element in a sorted array.\n    A majority element occurs more than n/2 times.\n    \"\"\"\n    if n == 0:\n        return False\n\n    # Step 1: Find the first occurrence of x using binary search.\n    low, high = 0, n - 1\n    first_idx = -1\n\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == x:\n            first_idx = mid\n            high = mid - 1  # Look for an earlier occurrence in the left half\n        elif arr[mid] < x:\n            low = mid + 1\n        else:  # arr[mid] > x\n            high = mid - 1\n\n    # Step 2: If x is not found, it cannot be a majority element.\n    if first_idx == -1:\n        return False\n\n    # Step 3: Check if the element at 'first_idx + n//2' is also x.\n    # If x is a majority element, it must span from 'first_idx' to at least 'first_idx + n//2'.\n    majority_threshold_index = first_idx + (n // 2)\n\n    return majority_threshold_index < n and arr[majority_threshold_index] == x"}
