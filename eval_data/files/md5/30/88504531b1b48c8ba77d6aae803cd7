{"task_id": "Mbpp/252", "solution": "import math\ndef convert(value: object) -> tuple[float, float]:\n    \"\"\"\n    Converts a complex number (or int/float) to polar coordinates (radius, angle).\n    The angle is in radians within the range (-pi, pi].\n    \"\"\"\n    c = complex(value)\n    r = math.hypot(c.real, c.imag)\n    theta = math.atan2(c.imag, c.real)\n    return (r, theta)"}
{"task_id": "Mbpp/255", "solution": "import itertools\nfrom typing import List, Tuple, Any, Sequence\ndef combinations_colors(items: Sequence[Any], n: int) -> List[Tuple[Any, ...]]:\n    \"\"\"\n    Generates all ordered combinations (with repetition) of the elements of the list 'items'\n    with a specified length 'n', returning a list of tuples.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    if n == 0:\n        return [()]\n    if not items:\n        return []\n    return [tuple(prod) for prod in itertools.product(items, repeat=n)]"}
