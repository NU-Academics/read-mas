{"task_id": "Mbpp/286", "solution": "from typing import List\ndef max_sub_array_sum_repeated(arr: List[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in the array formed by repeating `arr` `k` times.\n    \"\"\"\n\n    def _kadane(current_arr: List[int]) -> int:\n        \"\"\"Computes the maximum contiguous subarray sum for a given array.\"\"\"\n        if not current_arr:\n            return 0\n        max_ending_here = current_arr[0]\n        max_so_far = current_arr[0]\n        for x in current_arr[1:]:\n            max_ending_here = max(x, max_ending_here + x)\n            max_so_far = max(max_so_far, max_ending_here)\n        return max_so_far\n\n    def _max_prefix(current_arr: List[int]) -> int:\n        \"\"\"Computes the maximum prefix sum for a given array.\"\"\"\n        s = 0\n        best_prefix_sum = current_arr[0]\n        for x in current_arr:\n            s += x\n            best_prefix_sum = max(best_prefix_sum, s)\n        return best_prefix_sum\n\n    def _max_suffix(current_arr: List[int]) -> int:\n        \"\"\"Computes the maximum suffix sum for a given array.\"\"\"\n        s = 0\n        best_suffix_sum = current_arr[-1]\n        for x in reversed(current_arr):\n            s += x\n            best_suffix_sum = max(best_suffix_sum, s)\n        return best_suffix_sum\n\n    # Handle the case of an empty array.\n    if n == 0:\n        return 0\n\n    total_sum = sum(arr)\n    max_sub_single = _kadane(arr)\n\n    # If k is 1, the problem is a standard Kadane's algorithm problem.\n    if k == 1:\n        return max_sub_single\n    else:\n        # For k > 1, consider subarrays that may span across repetitions.\n        max_sub_double = _kadane(arr + arr)\n\n        if total_sum > 0:\n            # Max suffix of first + (k-2)*total + max prefix of last\n            max_pref = _max_prefix(arr)\n            max_suff = _max_suffix(arr)\n            candidate_sum_across_all = max_suff + max_pref + (k - 2) * total_sum\n            return max(max_sub_double, candidate_sum_across_all)\n        else:\n            # No benefit from more than two repetitions\n            return max_sub_double"}
