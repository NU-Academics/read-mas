{"task_id": "Mbpp/622", "solution": "def get_median(a: list, b: list, n: int) -> float:\n    \"\"\"\n    Finds the median of two sorted lists of the same size using a divide-and-conquer algorithm.\n    \"\"\"\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception for invalid input data.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class ListValidator:\n        \"\"\"Validates input lists for length, sorted order, and numeric content.\"\"\"\n        def to_float_list(self, seq: list) -> list:\n            \"\"\"Converts sequence elements to floats, raising an error if non-numeric.\"\"\"\n            try:\n                return [float(x) for x in seq]\n            except Exception as e:\n                raise InvalidInputError(\"All elements must be numeric\") from e\n\n        def validate_equal_length(self, a_list: list, b_list: list, expected_n: int) -> None:\n            \"\"\"Ensures both lists have the same positive length 'expected_n'.\"\"\"\n            if len(a_list) != expected_n or len(b_list) != expected_n or expected_n <= 0:\n                raise InvalidInputError(\"Lists must have the same positive length 'n'\")\n\n        def validate_sorted(self, lst: list) -> None:\n            \"\"\"Checks if a list is sorted in non-decreasing order.\"\"\"\n            if any(lst[i] > lst[i+1] for i in range(len(lst)-1)):\n                raise InvalidInputError(\"List must be sorted in non-decreasing order\")\n\n    class MedianFinder:\n        \"\"\"Implements the O(log n) divide-and-conquer algorithm to find the median.\"\"\"\n        def __init__(self) -> None:\n            pass\n\n        def find_median(self, a: list, b: list) -> float:\n            \"\"\"Public entry point to find the median of two equal-sized sorted lists.\"\"\"\n            list_n = len(a)\n            return float(self._median_recursive(a, b, 0, list_n - 1, 0, list_n - 1))\n\n        def _median_single_list(self, lst: list, start: int, end: int) -> float:\n            \"\"\"Computes the median of a single sublist. This is a helper used in base cases.\"\"\"\n            length = end - start + 1\n            if length % 2 == 1:\n                return lst[start + length // 2]\n            else:\n                i = start + length // 2\n                return (lst[i-1] + lst[i]) / 2.0\n\n        def _median_recursive(self, a: list, b: list, start_a: int, end_a: int, start_b: int, end_b: int) -> float:\n            \"\"\"Recursive helper for finding the median using divide and conquer.\"\"\"\n            current_len = end_a - start_a + 1\n\n            if current_len <= 0:\n                raise InvalidInputError(\"Internal error: Recursive median finder called with non-positive length.\")\n\n            if current_len == 1:\n                return (a[start_a] + b[start_b]) / 2.0\n\n            if current_len == 2:\n                return (max(a[start_a], b[start_b]) + min(a[end_a], b[end_b])) / 2.0\n\n            mid_a = start_a + (current_len - 1) // 2\n            mid_b = start_b + (current_len - 1) // 2\n\n            if a[mid_a] == b[mid_b]:\n                return a[mid_a]\n            elif a[mid_a] < b[mid_b]:\n                # Median must be in the elements from mid_a onwards in 'a'\n                # and elements up to mid_b in 'b'.\n                return self._median_recursive(a, b, mid_a, end_a, start_b, mid_b)\n            else: # a[mid_a] > b[mid_b]\n                # Median must be in the elements up to mid_a in 'a'\n                # and elements from mid_b onwards in 'b'.\n                return self._median_recursive(a, b, start_a, mid_a, mid_b, end_b)\n\n    # Main logic for the get_median function\n    validator = ListValidator()\n\n    a_floats = validator.to_float_list(a)\n    b_floats = validator.to_float_list(b)\n\n    validator.validate_equal_length(a_floats, b_floats, n)\n    validator.validate_sorted(a_floats)\n    validator.validate_sorted(b_floats)\n\n    finder = MedianFinder()\n    return finder.find_median(a_floats, b_floats)"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of numbers where every pair forms a divisible chain.\n    The subset is built such that for any two elements a <= b in the subset, a divides b,\n    using the zero divisibility rules described in the design:\n      - 0 divides 0 (True)\n      - 0 does not divide non-zero (False)\n      - non-zero divides 0 (True)\n      - for non-zero a and b, a divides b if b % a == 0\n    \"\"\"\n    nums = sorted(numbers)\n    if not nums:\n        return 0\n\n    n = len(nums)\n    dp = [1] * n  # dp[i] stores the length of the largest divisible subset ending with nums[i]\n\n    max_len = 1\n\n    for i in range(n):\n        for j in range(i):\n            is_divisible = False\n            if nums[j] == 0:\n                if nums[i] == 0:\n                    is_divisible = True\n            else:\n                if nums[i] == 0:\n                    is_divisible = True\n                elif nums[i] % nums[j] == 0:\n                    is_divisible = True\n\n            if is_divisible and dp[j] + 1 > dp[i]:\n                dp[i] = dp[j] + 1\n\n        if dp[i] > max_len:\n            max_len = dp[i]\n\n    return max_len"}
