{"task_id": "Mbpp/426", "solution": "def filter_oddnumbers(numbers):\n    \"\"\"\n    Filters a list of numbers, returning a new list containing only the odd numbers.\n    \"\"\"\n    odd_numbers = []\n    for num in numbers:\n        if num % 2 != 0:\n            odd_numbers.append(num)\n    return odd_numbers"}
{"task_id": "Mbpp/429", "solution": "def and_tuples(a, b):\n    \"\"\"\n    Compute the element-wise bitwise AND of two tuples of integers.\n\n    Args:\n        a: tuple of ints\n        b: tuple of ints\n\n    Returns:\n        tuple of ints where each element is a[i] & b[i]\n\n    Raises:\n        TypeError: if inputs are not tuples or elements are not ints\n        ValueError: if tuples have differing lengths\n    \"\"\"\n    if not isinstance(a, tuple) or not isinstance(b, tuple):\n        raise TypeError(\"Both inputs must be tuple instances.\")\n    if len(a) != len(b):\n        raise ValueError(\"Tuples must have the same length.\")\n    result = []\n    for i, (x, y) in enumerate(zip(a, b)):\n        if not isinstance(x, int) or not isinstance(y, int):\n            raise TypeError(f\"Elements at index {i} must be integers.\")\n        result.append(x & y)\n    return tuple(result)"}
{"task_id": "Mbpp/428", "solution": "class SortError(Exception):\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\nclass SortResult:\n    def __init__(self, success: bool, sorted_list: list, original_length: int, error: str = None):\n        self.success = success\n        self.sorted_list = sorted_list\n        self.original_length = original_length\n        self.error = error\n\n    def to_dict(self):\n        return {\"success\": self.success, \"sorted_list\": self.sorted_list, \"original_length\": self.original_length, \"error\": self.error}\nclass Validator:\n    @staticmethod\n    def validate_list_of_comparables(arr: list) -> None:\n        \"\"\"Validates if the input is a list, raising SortError if not.\"\"\"\n        if not isinstance(arr, list):\n            raise SortError(\"Input must be a list.\")\nclass ShellSorter:\n    DEFAULT_GAP_STRATEGY = \"knuth\"\n\n    def gap_sequence(self, n: int) -> list[int]:\n        \"\"\"Computes the Knuth gap sequence (h = 3*h + 1) in descending order.\"\"\"\n        gaps = []\n        h = 1\n        while h < n:\n            gaps.insert(0, h)\n            h = 3 * h + 1\n        return gaps\n\n    def _insertion_gap(self, arr: list, gap: int, start: int) -> None:\n        \"\"\"Performs gapped insertion sort on a sub-array starting at 'start' with 'gap' step.\"\"\"\n        for i in range(start + gap, len(arr), gap):\n            temp = arr[i]\n            j = i\n            while j >= gap and arr[j - gap] > temp:\n                arr[j] = arr[j - gap]\n                j -= gap\n            arr[j] = temp\n\n    def sort(self, arr: list) -> list:\n        \"\"\"Sorts the given list using Shell Sort and returns a new sorted list.\"\"\"\n        a = list(arr)\n        n = len(a)\n\n        for gap in self.gap_sequence(n):\n            for start_index in range(gap):\n                self._insertion_gap(a, gap, start_index)\n        return a\nclass SortService:\n    def __init__(self, algorithm: ShellSorter = None):\n        self._algorithm = algorithm or ShellSorter()\n\n    def _select_algorithm(self, name: str) -> ShellSorter:\n        \"\"\"Selects the appropriate sorting algorithm implementation.\"\"\"\n        if name == \"shell\":\n            return self._algorithm\n        raise SortError(f\"Unsupported algorithm: {name}\")\n\n    def sort_array(self, arr: list, algorithm_name: str = \"shell\") -> SortResult:\n        \"\"\"Validates input, sorts the array, and returns a SortResult.\"\"\"\n        try:\n            Validator.validate_list_of_comparables(arr)\n            algo = self._select_algorithm(algorithm_name)\n            sorted_list = algo.sort(arr)\n            return SortResult(True, sorted_list, len(arr))\n        except SortError as e:\n            return SortResult(False, [], 0, str(e))\n        except Exception as e:\n            raise SortError(str(e))\ndef shell_sort(arr: list) -> list:\n    \"\"\"Sorts a list using the Shell Sort algorithm and returns a new sorted list.\"\"\"\n    service = SortService()\n    result = service.sort_array(arr, algorithm_name=\"shell\")\n    if not result.success:\n        raise SortError(result.error or \"Unknown error during shell sort\")\n    return result.sorted_list"}
{"task_id": "Mbpp/427", "solution": "def change_date_format(date_str: str) -> str:\n    \"\"\"\n    Converts a date string from YYYY-MM-DD format to DD-MM-YYYY format.\n    Assumes valid input structure; month and day are zero-padded in the output.\n    \"\"\"\n    parts = date_str.split('-')\n    year_str = parts[0]\n    month_str = parts[1]\n    day_str = parts[2]\n\n    # Convert to int for zero-padding, then format back to string.\n    formatted_day = f\"{int(day_str):02d}\"\n    formatted_month = f\"{int(month_str):02d}\"\n\n    return f\"{formatted_day}-{formatted_month}-{year_str}\""}
{"task_id": "Mbpp/430", "solution": "def parabola_directrix(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Computes the directrix y-value for a parabola y = a x^2 + b x + c.\n    The directrix is calculated as y = c - (b^2 + 1) / (4a).\n    \"\"\"\n    # Validate inputs\n    if not isinstance(a, (int, float)) or not isinstance(b, (int, float)) or not isinstance(c, (int, float)):\n        raise TypeError(\"Coefficients must be real numbers\")\n    if a == 0:\n        raise ValueError(\"Coefficient 'a' must be non-zero for a parabola\")\n    # Calculate the y-coordinate of the vertex (k)\n    k = c - (b * b) / (4.0 * a)\n    # Calculate the focal parameter (p)\n    p = 1.0 / (4.0 * a)\n    # The directrix is y = k - p\n    directrix_y = k - p\n    return directrix_y"}
{"task_id": "Mbpp/432", "solution": "def median_trapezium(base1: float, base2: float, auxiliary: float = None) -> float:\n    \"\"\"\n    Calculates the median length of a trapezium, which is the average of its two parallel bases.\n    The 'auxiliary' parameter is accepted for compatibility but is not used in the calculation.\n    \"\"\"\n    median_length = (base1 + base2) / 2.0\n    # Round the result to the default precision of 6 decimal places as per design context.\n    return round(median_length, 6)"}
