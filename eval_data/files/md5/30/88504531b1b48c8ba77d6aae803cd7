{"task_id": "Mbpp/137", "solution": "import math\ndef zero_count(arr):\n    \"\"\"\n    Calculates the ratio of zeroes to non-zeroes in an array of integers.\n    Returns math.inf if there are zeroes but no non-zeroes; returns 0.0 if there are no non-zeroes and no zeroes.\n    \"\"\"\n    num_zeros = 0\n    num_non_zeros = 0\n\n    for x in arr:\n        if x == 0:\n            num_zeros += 1\n        else:\n            num_non_zeros += 1\n\n    if num_non_zeros == 0:\n        # If there are no non-zeroes:\n        # Return infinity if there are zeroes (e.g., [0,0,0]).\n        # Return 0.0 if there are no zeroes (e.g., [] or an empty sequence).\n        return math.inf if num_zeros > 0 else 0.0\n    else:\n        return float(num_zeros) / float(num_non_zeros)"}
{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(n):\n    \"\"\"\n    Checks if a number can be represented as a sum of distinct non-zero powers of 2.\n    Interpreting \"non-zero powers of 2\" as powers 2^k with k > 0 (i.e., disallowing 2^0 == 1).\n    Under that interpretation, a number is representable iff it is a positive even integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n <= 0:\n        return False\n    return (n & 1) == 0"}
{"task_id": "Mbpp/142", "solution": "from typing import Iterable, Any\ndef count_samepair(list_a: Iterable[Any], list_b: Iterable[Any], list_c: Iterable[Any]) -> int:\n    \"\"\"\n    Counts number of items identical in the same position of three given lists.\n    Compares elements up to the length of the shortest list.\n    \"\"\"\n    a_seq = list(list_a)\n    b_seq = list(list_b)\n    c_seq = list(list_c)\n\n    min_len = min(len(a_seq), len(b_seq), len(c_seq))\n    count = 0\n\n    for i in range(min_len):\n        if a_seq[i] == b_seq[i] == c_seq[i]:\n            count += 1\n\n    return count"}
{"task_id": "Mbpp/140", "solution": "def extract_singly(items):\n    \"\"\"\n    Flattens a list of lists into a single set of numbers.\n    Assumes valid input: iterable of iterables, with each inner element being an integer.\n    \"\"\"\n    result = set()\n    for row in items:\n        for n in row:\n            result.add(n)\n    return result"}
{"task_id": "Mbpp/141", "solution": "def pancake_sort(items):\n    \"\"\"\n    Sort a sequence of comparable elements using the pancake sort algorithm.\n\n    Returns a new list with elements in non-decreasing (ascending) order.\n\n    Raises:\n        TypeError: if items is None or contains non-comparable elements.\n    \"\"\"\n    if items is None:\n        raise TypeError(\"items must be a sequence, not None\")\n    arr = list(items)\n    n = len(arr)\n    try:\n        for curr_size in range(n, 1, -1):\n            # find index of maximum element in arr[0:curr_size]\n            max_i = 0\n            for i in range(1, curr_size):\n                if arr[i] > arr[max_i]:\n                    max_i = i\n            if max_i != curr_size - 1:\n                # flip prefix up to max_i\n                arr[: max_i + 1] = arr[: max_i + 1][::-1]\n                # flip prefix up to curr_size-1 to move max to its final place\n                arr[:curr_size] = arr[:curr_size][::-1]\n        return arr\n    except TypeError as exc:\n        raise TypeError(\"items contain non-comparable elements\") from exc"}
