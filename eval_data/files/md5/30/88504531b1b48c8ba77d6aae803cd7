{"task_id": "Mbpp/300", "solution": "import math\ndef count_binary_seq(n: int) -> float:\n    \"\"\"\n    Calculates the number of binary sequences of length 2n such that the sum of the first n bits equals the sum of the last n bits.\n    This count is given by the central binomial coefficient C(2n, n).\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(f\"n must be an int, got {type(n).__name__}\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    return float(math.comb(2 * n, n))"}
{"task_id": "Mbpp/294", "solution": "import decimal\nclass MaxFinderError(Exception):\n    pass\nclass EmptyInputError(MaxFinderError):\n    pass\nclass NoNumericElementsError(MaxFinderError):\n    pass\ndef max_val(lst):\n    \"\"\"\n    Finds the maximum numeric value in a heterogeneous list, ignoring non-numeric elements.\n    Raises EmptyInputError if the list is empty or NoNumericElementsError if no numeric elements are found.\n    \"\"\"\n    if not lst:\n        raise EmptyInputError(\"Input list is empty\")\n\n    found_numeric = False\n    current_max = None\n\n    for item in lst:\n        # Identify numeric types (int, float, decimal.Decimal) while excluding bool\n        if isinstance(item, (int, float, decimal.Decimal)) and not isinstance(item, bool):\n            if not found_numeric:\n                current_max = item\n                found_numeric = True\n            elif item > current_max:\n                current_max = item\n\n    if not found_numeric:\n        raise NoNumericElementsError(\"No numeric elements found in the list\")\n\n    return current_max"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(dictionary):\n    from collections.abc import Mapping\n\n    if not isinstance(dictionary, Mapping):\n        raise TypeError(\"Input must be a mapping (e.g., dict)\")\n\n    visited = set()\n\n    def _depth(curr, level):\n        cid = id(curr)\n        if cid in visited:\n            return level\n        visited.add(cid)\n\n        max_level = level\n        for v in curr.values():\n            if isinstance(v, Mapping):\n                child_level = _depth(v, level + 1)\n                if child_level > max_level:\n                    max_level = child_level\n        return max_level\n\n    return _depth(dictionary, 1)"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr):\n    \"\"\"\n    Count and return the number of inversions in the input sequence.\n    An inversion is a pair (i, j) such that i < j and arr[i] > arr[j].\n\n    Example:\n        assert get_Inv_Count([1,20,6,4,5]) == 5\n    \"\"\"\n    if arr is None:\n        raise ValueError(\"Input is None\")\n\n    try:\n        seq = list(arr)\n    except TypeError:\n        raise TypeError(\"Input must be an iterable\")\n\n    try:\n        nums = [int(x) for x in seq]\n    except Exception:\n        raise ValueError(\"All elements must be convertible to int\")\n\n    def _sort_count(a):\n        n = len(a)\n        if n <= 1:\n            return a, 0\n        mid = n // 2\n        left, inv_left = _sort_count(a[:mid])\n        right, inv_right = _sort_count(a[mid:])\n        merged = []\n        i = j = 0\n        inv_merge = 0\n        while i < len(left) and j < len(right):\n            if left[i] <= right[j]:\n                merged.append(left[i])\n                i += 1\n            else:\n                merged.append(right[j])\n                j += 1\n                inv_merge += len(left) - i\n        if i < len(left):\n            merged.extend(left[i:])\n        if j < len(right):\n            merged.extend(right[j:])\n        return merged, inv_left + inv_right + inv_merge\n\n    _, count = _sort_count(nums)\n    return count"}
{"task_id": "Mbpp/297", "solution": "from typing import Any, Tuple, Callable, Iterator, List\nclass FlattenError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\nclass InvalidInputError(FlattenError):\n    def __init__(self, message: str):\n        super().__init__(message)\ndef _is_list_like_type_check(obj: Any, allowed_container_types: Tuple[type, ...]) -> bool:\n    \"\"\"Helper to check if an object is an allowed container type, explicitly excluding strings and bytes.\"\"\"\n    if isinstance(obj, (str, bytes)):\n        return False\n    return isinstance(obj, allowed_container_types)\nclass InputValidator:\n    \"\"\"Validates top-level input and determines if an object is an allowed container.\"\"\"\n    def __init__(self, allowed_container_types: Tuple[type, ...] = (list, tuple)) -> None:\n        self._allowed = allowed_container_types\n\n    def validate_top_level(self, obj: Any) -> None:\n        \"\"\"Raises InvalidInputError if the top-level object is not a scalar or an allowed container type.\"\"\"\n        if self.is_allowed_container(obj):\n            return\n\n        if isinstance(obj, (int, float, bool, type(None), str, bytes)):\n            return\n\n        raise InvalidInputError(f\"Unsupported top-level input type: {type(obj)}. Must be a scalar or an allowed container type (e.g., list, tuple).\")\n\n    def is_allowed_container(self, obj: Any) -> bool:\n        \"\"\"Determines if an object is an instance of the configured allowed container types.\"\"\"\n        return _is_list_like_type_check(obj, self._allowed)\nclass FlattenIterator:\n    \"\"\"An iterator to flatten nested list-like structures using an explicit stack for depth management and cycle detection.\"\"\"\n    def __init__(self, root: Any, is_container_fn: Callable[[Any], bool]) -> None:\n        self._is_container = is_container_fn\n        self._seen_ids: set[int] = set()\n        self._path: List[Any] = []\n\n        if is_container_fn(root):\n            self._stack: List[Iterator[Any]] = [iter(root)]\n            self._push_container(root)\n        else:\n            self._stack = [iter([root])]\n\n    def __iter__(self) -> \"FlattenIterator\":\n        return self\n\n    def __next__(self) -> Any:\n        while self._stack:\n            try:\n                item = next(self._stack[-1])\n            except StopIteration:\n                self._stack.pop()\n                if self._path:\n                    self._seen_ids.remove(id(self._path.pop()))\n                continue\n\n            if self._is_container(item):\n                if id(item) in self._seen_ids:\n                    path_repr = \" -> \".join([str(x) for x in self._path + [item]])\n                    raise FlattenError(f\"Cycle detected in nested structure involving object: {path_repr}\")\n                self._push_container(item)\n                self._stack.append(iter(item))\n                continue\n            return item\n        raise StopIteration\n\n    def _push_container(self, container: Any) -> None:\n        \"\"\"Adds a container to the seen set and path for cycle detection.\"\"\"\n        self._seen_ids.add(id(container))\n        self._path.append(container)\nclass FlattenService:\n    \"\"\"Provides the core logic for flattening nested list-like structures.\"\"\"\n    def __init__(self, validator: InputValidator | None = None) -> None:\n        self.validator = validator or InputValidator()\n\n    def flatten(self, data: Any) -> List[Any]:\n        \"\"\"Validates input and returns a flattened list from the given data, handling recursion limits.\"\"\"\n        self.validator.validate_top_level(data)\n        try:\n            it = FlattenIterator(data, self.validator.is_allowed_container)\n            return list(it)\n        except RecursionError as e:\n            raise FlattenError(\"Recursion limit reached during flattening. The input structure is excessively deep.\") from e\n_default_service = FlattenService()\ndef flatten_list(data: Any) -> List[Any]:\n    \"\"\"\n    Flattens a nested list-like structure into a single flat list, preserving item order.\n    \"\"\"\n    return _default_service.flatten(data)"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(entries):\n    \"\"\"\n    Calculates the maximum aggregate value from a list of (name, value) tuples.\n    If multiple names tie for maximum, the lexicographically smallest name is chosen.\n    \"\"\"\n    aggregated_totals = {}\n    for name, value in entries:\n        aggregated_totals[name] = aggregated_totals.get(name, 0.0) + float(value)\n\n    # Transform to (-total, name) tuples for sorting,\n    # enabling `min` to find the largest total with lexicographical name tie-breaking.\n    tie_breaking_list = [(-total, name) for name, total in aggregated_totals.items()]\n\n    min_tuple = min(tie_breaking_list)\n\n    max_total = -min_tuple[0]\n    max_name = min_tuple[1]\n\n    return (max_name, max_total)"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr: list, n: int, i: int, k: int) -> float:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from arr[0...i]\n    that must include arr[k] as its final element, given k > i.\n    \"\"\"\n    # Basic validation\n    if not isinstance(arr, list):\n        raise TypeError(\"arr must be a list\")\n    if n != len(arr):\n        raise ValueError(\"n must be the length of arr\")\n    if not (0 <= i < n):\n        raise IndexError(\"i out of bounds\")\n    if not (0 <= k < n):\n        raise IndexError(\"k out of bounds\")\n    if not (k > i):\n        raise ValueError(\"k must be greater than i\")\n\n    # Initialize msis_sums where msis_sums[j] stores the maximum sum of an increasing subsequence\n    # ending at index j within the prefix arr[0...i].\n    msis_sums = [float(x) for x in arr[:i+1]]\n\n    # Compute MSIS for each element in the prefix arr[0...i]\n    for j in range(i + 1):\n        for p in range(j):\n            if arr[p] < arr[j]:\n                candidate_sum = msis_sums[p] + arr[j]\n                if candidate_sum > msis_sums[j]:\n                    msis_sums[j] = candidate_sum\n\n    # Find the maximum sum from msis_sums[j] such that arr[j] is strictly less than arr[k].\n    best_prefix_sum_before_k = 0.0\n    for j in range(i + 1):\n        if arr[j] < arr[k] and msis_sums[j] > best_prefix_sum_before_k:\n            best_prefix_sum_before_k = msis_sums[j]\n\n    # The final maximum sum is the best prefix sum found plus arr[k] itself.\n    return best_prefix_sum_before_k + arr[k]"}
{"task_id": "Mbpp/305", "solution": "from typing import List, Tuple, Iterator\nclass NotEnoughPWordsError(Exception):\n    \"\"\"Custom exception raised when fewer than two words starting with 'p' are found.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef starts_with_p(token: str) -> bool:\n    \"\"\"Checks if a token starts with 'p' case-insensitively after stripping whitespace.\"\"\"\n    return token.strip().lower().startswith('p')\nclass StringRepository:\n    \"\"\"Provides methods to tokenize input lines into words.\"\"\"\n    def tokenize(self, lines: List[str]) -> Iterator[str]:\n        # Iterates through lines and yields non-empty tokens.\n        for line in lines:\n            for token in line.split():\n                if token:\n                    yield token\nclass StartWithPService:\n    \"\"\"Implements the core logic to find two words starting with 'p'.\"\"\"\n    def __init__(self, repository: StringRepository):\n        self._repository = repository\n\n    def find_two_p_words(self, lines: List[str]) -> Tuple[str, str]:\n        # Finds the first two words that start with 'p' using the repository.\n        if lines is None:\n            raise ValueError(\"lines must be provided\")\n\n        found = []\n        for token in self._repository.tokenize(lines):\n            if starts_with_p(token):\n                found.append(token)\n                if len(found) == 2:\n                    return (found[0], found[1])\n\n        raise NotEnoughPWordsError(\"Fewer than two words starting with 'p' were found\")\ndef start_withp(lines: List[str]) -> Tuple[str, str]:\n    \"\"\"Returns the first two words from a list of lines that start with 'p' (case-insensitive).\"\"\"\n    # Orchestrates the process by instantiating the repository and service.\n    repository = StringRepository()\n    service = StartWithPService(repository)\n    return service.find_two_p_words(lines)"}
{"task_id": "Mbpp/310", "solution": "def string_to_tuple(s: str, remove_whitespace: bool = True) -> tuple[str, ...]:\n    \"\"\"Converts a string to a tuple of its characters, optionally removing whitespace.\"\"\"\n    if remove_whitespace:\n        return tuple(ch for ch in s if not ch.isspace())\n    else:\n        return tuple(s)"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    \"\"\"\n    Sets the left-most (most-significant) unset bit in a non-negative integer.\n    If all bits are set within its current width, it sets the next higher bit.\n    \"\"\"\n\n    def _msb_index(num: int) -> int:\n        \"\"\"Returns the 0-based index of the most significant set bit. Returns -1 for 0.\"\"\"\n        if num == 0:\n            return -1\n        return num.bit_length() - 1\n\n    def _bit_width(num: int) -> int:\n        \"\"\"Returns the number of bits required to represent the number. For 0, returns 1.\"\"\"\n        return max(1, num.bit_length())\n\n    def _is_bit_set(num: int, pos: int) -> bool:\n        \"\"\"Checks if the bit at the given position is set in the number.\"\"\"\n        return ((num >> pos) & 1) == 1\n\n    def _set_bit(num: int, pos: int) -> int:\n        \"\"\"Sets the bit at the given position in the number.\"\"\"\n        return num | (1 << pos)\n\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer\")\n    if n < 0:\n        raise ValueError(\"Input must be non-negative\")\n\n    if n == 0:\n        return 1\n\n    msb = _msb_index(n)\n\n    # Iterate from the most significant set bit's position down to 0\n    for pos in range(msb, -1, -1):\n        if not _is_bit_set(n, pos):\n            # Found the left-most unset bit, set it and return\n            return _set_bit(n, pos)\n\n    # If the loop completes, all bits up to the MSB are set (e.g., n=7 which is 0b111).\n    # In this case, set the next higher bit.\n    new_pos = _bit_width(n)\n    return _set_bit(n, new_pos)"}
{"task_id": "Mbpp/309", "solution": "def maximum(a, b):\n    \"\"\"\n    Finds the maximum of two numbers using a full architectural design.\n    The function preserves integer types if both inputs were integers and the result is an integer.\n    \"\"\"\n\n    class MaxError(Exception):\n        \"\"\"Domain-specific exception for Maxutil operations.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n        def __str__(self) -> str:\n            return self.message\n\n    class MaxRequest:\n        \"\"\"Data transfer object for input request.\"\"\"\n        def __init__(self, a_val: float, b_val: float) -> None:\n            self.a = a_val\n            self.b = b_val\n\n    class MaxResult:\n        \"\"\"Data transfer object for the computation result.\"\"\"\n        def __init__(self, value_val: float, request_val: MaxRequest) -> None:\n            self.value = value_val\n            self.request = request_val\n\n    class InputValidator:\n        \"\"\"Validates and normalizes input values to floats.\"\"\"\n        def validate(self, value: object) -> float:\n            \"\"\"Converts a value to float, raising MaxError on failure.\"\"\"\n            try:\n                return float(value)\n            except (TypeError, ValueError) as e:\n                raise MaxError(f\"Invalid numeric value: {value}\") from e\n\n        def validate_pair(self, val_a: object, val_b: object) -> MaxRequest:\n            \"\"\"Validates two inputs and returns them as a MaxRequest DTO.\"\"\"\n            return MaxRequest(a_val=self.validate(val_a), b_val=self.validate(val_b))\n\n    class MaxCore:\n        \"\"\"Provides the pure comparison logic for two floats.\"\"\"\n        def maximum(self, val_a: float, val_b: float) -> float:\n            \"\"\"Returns the numerically greater value between a and b.\"\"\"\n            return val_a if val_a >= val_b else val_b\n\n    class MaxService:\n        \"\"\"Orchestrates input validation and core computation.\"\"\"\n        def __init__(self, validator: InputValidator, core: MaxCore) -> None:\n            \"\"\"Initializes with injected validator and core components.\"\"\"\n            self._validator = validator\n            self._core = core\n\n        def compute(self, val_a: object, val_b: object) -> MaxResult:\n            \"\"\"Validates inputs, computes maximum, and returns MaxResult.\"\"\"\n            req = self._validator.validate_pair(val_a, val_b)\n            val = self._core.maximum(req.a, req.b)\n            return MaxResult(value_val=val, request_val=req)\n\n    # Instantiate the components\n    validator_instance = InputValidator()\n    core_instance = MaxCore()\n    service_instance = MaxService(validator_instance, core_instance)\n\n    # Compute the maximum value using the service layer\n    result_obj = service_instance.compute(a, b)\n    computed_value = result_obj.value\n\n    # Apply type preservation based on original inputs for the top-level API\n    if isinstance(a, int) and isinstance(b, int) and computed_value.is_integer():\n        return int(computed_value)\n    else:\n        return computed_value"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n):\n    \"\"\"\n    Finds the highest power of 2 that is less than or equal to n.\n    For n == 0, returns 0.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    if n == 0:\n        return 0\n\n    p = 1\n    while p <= n:\n        p <<= 1\n\n    return p >> 1"}
