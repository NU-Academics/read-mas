{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number.\n    Polite numbers are positive integers that are not powers of two.\n    \"\"\"\n\n    def _count_polite_upto(x: int) -> int:\n        \"\"\"Counts polite numbers less than or equal to x.\"\"\"\n        if x < 1:\n            return 0\n        # The number of powers of two less than or equal to x is x.bit_length().\n        powers_of_two_count = x.bit_length()\n        return x - powers_of_two_count\n\n    # Input validation\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n\n    # Exponential search to find an initial upper bound\n    low, high = 1, max(2, n * 2)\n    while _count_polite_upto(high) < n:\n        low = high + 1\n        high *= 2\n\n    # Binary search within the determined range [low, high]\n    ans = high\n    while low <= high:\n        mid = (low + high) // 2\n        if _count_polite_upto(mid) >= n:\n            ans = mid\n            high = mid - 1  # Try to find a smaller number\n        else:\n            low = mid + 1   # Need a larger number\n\n    return ans"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(items):\n    \"\"\"\n    Returns a list of all pairs of consecutive items in the given list.\n    If the list has less than two items, an empty list is returned.\n    \"\"\"\n    n = len(items)\n    if n < 2:\n        return []\n\n    pairs = []\n    for i in range(n - 1):\n        pairs.append((items[i], items[i+1]))\n    return pairs"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(list_of_numbers, sum):\n    # Calculate the frequency of each number in the input list.\n    freq = {}\n    for num in list_of_numbers:\n        freq[num] = freq.get(num, 0) + 1\n\n    pairs = 0\n    # Iterate through unique numbers to find complements, ensuring each pair is counted once.\n    for v in sorted(freq.keys()):\n        complement = sum - v\n\n        if complement == v:\n            # For a number v, if complement is also v, count combinations: n * (n - 1) // 2\n            n = freq[v]\n            pairs += n * (n - 1) // 2\n        elif complement in freq and complement > v:\n            # If complement is different and greater than v, multiply frequencies.\n            pairs += freq[v] * freq[complement]\n\n    return pairs"}
{"task_id": "Mbpp/769", "solution": "def Diff(a, b):\n    \"\"\"\n    Return a list of elements present in `a` but not in `b`.\n    The relative order of elements from `a` is preserved.\n    \"\"\"\n    try:\n        b_set = set(b)\n    except TypeError:\n        # b contains unhashable elements; fall back to equality checks.\n        b_list = list(b)\n        return [x for x in list(a) if not any(x == y for y in b_list)]\n    else:\n        result = []\n        for x in a:\n            if x not in b_set:\n                result.append(x)\n        return result"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Finds the sum of the fourth powers of the first n odd natural numbers using a closed-form formula.\n    Assumes n is a positive integer.\n    \"\"\"\n\n    # Helper functions for sum of k, k^2, k^3, k^4\n    def _sum_k(val: int) -> int:\n        return val * (val + 1) // 2\n\n    def _sum_k2(val: int) -> int:\n        return val * (val + 1) * (2 * val + 1) // 6\n\n    def _sum_k3(val: int) -> int:\n        s = _sum_k(val)\n        return s * s\n\n    def _sum_k4(val: int) -> int:\n        return val * (val + 1) * (2 * val + 1) * (3 * val * val + 3 * val - 1) // 30\n\n    # The sum of (2k-1)^4 for k=1 to n is equivalent to the sum of\n    # 16k^4 - 32k^3 + 24k^2 - 8k + 1 for k=1 to n.\n    # We apply the linearity of summation and use the closed-form sums.\n    return (16 * _sum_k4(n)\n            - 32 * _sum_k3(n)\n            + 24 * _sum_k2(n)\n            - 8 * _sum_k(n)\n            + n)"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets.\n    Only parentheses, square brackets, and curly braces are considered.\n    \"\"\"\n    # Maps closing brackets to their corresponding opening brackets.\n    pairs = {')': '(', ']': '[', '}': '{'}\n\n    # Set of all opening brackets for efficient lookup.\n    opens = set(pairs.values())\n\n    # Stack to store encountered opening brackets.\n    stack = []\n\n    for char in expression:\n        if char in opens:\n            # If an opening bracket is found, push it onto the stack.\n            stack.append(char)\n        elif char in pairs:\n            # If a closing bracket is found:\n            # 1. The stack must not be empty (i.e., there must be an opening bracket to match).\n            # 2. The top of the stack must be the corresponding opening bracket for the current closing bracket.\n            if not stack or stack.pop() != pairs[char]:\n                return False\n        # Ignore any other characters that are not brackets.\n\n    # After iterating through the entire expression, if the stack is empty,\n    # all opening brackets have been correctly matched with their closing counterparts.\n    return not stack"}
{"task_id": "Mbpp/772", "solution": "def remove_length(s: str, k: int) -> str:\n    \"\"\"\n    Removes all words with a specified length k from the given string.\n    Words are split by whitespace; punctuation counts toward word length.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a string\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer\")\n    if k < 0:\n        raise ValueError(\"k must be non-negative\")\n\n    words = s.split()\n    filtered_words = [word for word in words if len(word) != k]\n    return \" \".join(filtered_words)"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(haystack, needle):\n    \"\"\"\n    Finds the first occurrence and position of a substring within a string.\n    Returns None if there is no match, or a tuple (matched_text, start_index, end_index).\n    \"\"\"\n    if not isinstance(haystack, str) or not isinstance(needle, str):\n        raise TypeError(\"haystack and needle must be strings\")\n\n    if needle == \"\":\n        return (\"\", 0, 0)\n\n    start_index = haystack.find(needle)\n\n    if start_index == -1:\n        return None\n    else:\n        end_index = start_index + len(needle)\n        matched_text = haystack[start_index:end_index]\n        return (matched_text, start_index, end_index)"}
