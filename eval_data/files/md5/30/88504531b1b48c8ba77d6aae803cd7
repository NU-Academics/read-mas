{"task_id": "Mbpp/589", "solution": "import math\ndef perfect_squares(start: int, end: int) -> list[int]:\n    \"\"\"\n    Finds perfect square integers within an inclusive integer range [start, end].\n    \"\"\"\n    # If the upper bound is negative, no perfect squares can exist.\n    if end < 0:\n        return []\n\n    # Perfect squares are non-negative. Adjust the effective lower bound if 'start' is negative.\n    low_effective = max(start, 0)\n\n    # Compute integer square roots using math.isqrt (floor of sqrt).\n    low_root = math.isqrt(low_effective)\n    high_root = math.isqrt(end)\n\n    # If low_root^2 is less than low_effective, advance to the next integer root.\n    if low_root * low_root < low_effective:\n        low_root += 1\n\n    # If there are no valid roots in the interval, return empty list.\n    if low_root > high_root:\n        return []\n\n    # Build and return the list of perfect squares.\n    return [r * r for r in range(low_root, high_root + 1)]"}
{"task_id": "Mbpp/591", "solution": "from typing import TypeVar, List\nT = TypeVar(\"T\")\ndef swap_List(lst: List[T]) -> List[T]:\n    \"\"\"\n    Returns a new list with the first and last elements swapped.\n    Does not mutate the original list.\n    \"\"\"\n    if len(lst) < 2:\n        return lst[:]  # Return a shallow copy for lists with less than 2 elements\n    else:\n        # Create a shallow copy to avoid mutating the original list\n        result = lst[:]\n        # Swap the first and last elements\n        result[0], result[-1] = result[-1], result[0]\n        return result"}
{"task_id": "Mbpp/590", "solution": "import math\nfrom typing import Any, Tuple\nclass PolarResult:\n    \"\"\"A data transfer object for polar coordinates.\"\"\"\n    def __init__(self, r: float, theta: float):\n        self.r = r\n        self.theta = theta\n\n    def as_tuple(self) -> Tuple[float, float]:\n        \"\"\"Returns the polar coordinates as a tuple (r, theta).\"\"\"\n        return (self.r, self.theta)\nclass Validators:\n    \"\"\"Provides methods for validating and coercing numeric inputs.\"\"\"\n    @staticmethod\n    def validate_numeric(value: Any, name: str) -> float:\n        \"\"\"Attempts to convert a value to float, raising ValueError if unsuccessful.\"\"\"\n        try:\n            return float(value)\n        except (TypeError, ValueError):\n            raise ValueError(f\"{name} must be numeric\")\nclass PolarConverter:\n    \"\"\"Converts rectangular coordinates to polar coordinates.\"\"\"\n    def compute_polar(self, x: float, y: float) -> PolarResult:\n        \"\"\"Calculates radius (r) and angle (theta) from x and y.\"\"\"\n        r = math.hypot(x, y)\n        theta = math.atan2(y, x)\n        return PolarResult(r=r, theta=theta)\nclass ComplexFactory:\n    \"\"\"Creates a derived complex number based on a specific formula.\"\"\"\n    TWO_PI: float = 2.0 * math.pi\n\n    def make_complex(self, x: float, y: float, r: float, theta: float) -> complex:\n        \"\"\"Generates a complex number using a deterministic formula.\"\"\"\n        real_part = x - r\n        imag_part = -math.sin(self.TWO_PI)\n        return complex(real_part, imag_part)\ndef polar_rect(x: float, y: float) -> Tuple[Tuple[float, float], complex]:\n    \"\"\"\n    Converts rectangular coordinates (x, y) to polar coordinates (r, theta)\n    and returns a derived complex number.\n    \"\"\"\n    x_f = Validators.validate_numeric(x, \"x\")\n    y_f = Validators.validate_numeric(y, \"y\")\n    pr = PolarConverter().compute_polar(x_f, y_f)\n    c = ComplexFactory().make_complex(x_f, y_f, pr.r, pr.theta)\n    return (pr.as_tuple(), c)"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(nums: list[int]) -> int:\n    \"\"\"\n    Finds the difference of the first even and first odd number in a list.\n    The difference is calculated as (first_even - first_odd).\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in nums:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        if first_even is not None and first_odd is not None:\n            break\n\n    return first_even - first_odd"}
{"task_id": "Mbpp/592", "solution": "def sum_Of_product(n: int) -> int:\n    \"\"\"\n    Return the sum of products of consecutive binomial coefficients:\n    sum_{k=0}^{n-1} C(n,k) * C(n,k+1).\n    For n >= 1 this equals C(2n, n-1); for n == 0 the sum is 0.\n    \"\"\"\n    import math\n\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    if n == 0:\n        return 0\n    return math.comb(2 * n, n - 1)"}
