{"task_id": "Mbpp/598", "solution": "from typing import Any, List\nimport re\nclass ArmstrongError(Exception):\n    def __init__(self, message: str = None) -> None:\n        super().__init__(message)\n        self.message = message\nclass ValidationError(ArmstrongError):\n    pass\nclass Utils:\n    def extract_digits(self, n: int) -> List[int]:\n        \"\"\"Extracts digits of the absolute value of n.\n        Returns them in natural order (e.g., 153 -> [1, 5, 3]).\"\"\"\n        if n == 0:\n            return [0]\n        digits = []\n        abs_n = abs(n)\n        while abs_n > 0:\n            digits.append(abs_n % 10)\n            abs_n //= 10\n        return digits[::-1]\n\n    def pow_sum(self, digits: List[int], power: int) -> int:\n        \"\"\"Computes the sum of each digit raised to the given power.\n        Example: pow_sum([1, 5, 3], 3) computes 1**3 + 5**3 + 3**3.\"\"\"\n        total = 0\n        for d in digits:\n            total += d ** power\n        return total\nclass NumberModel:\n    def __init__(self, value: int) -> None:\n        \"\"\"Initializes the number model with an integer value.\"\"\"\n        self._value = value\n        self._digits_abs_cache: List[int] | None = None\n        self._num_digits_cache: int | None = None\n        self._utils = Utils()\n\n    @property\n    def value(self) -> int:\n        \"\"\"Returns the original integer value.\"\"\"\n        return self._value\n\n    @property\n    def digits_abs(self) -> List[int]:\n        \"\"\"Returns a list of digits of the absolute value, lazily cached.\"\"\"\n        if self._digits_abs_cache is None:\n            self._digits_abs_cache = self._utils.extract_digits(self._value)\n        return self._digits_abs_cache\n\n    @property\n    def num_digits(self) -> int:\n        \"\"\"Returns the count of digits in the absolute value, lazily cached.\"\"\"\n        if self._num_digits_cache is None:\n            self._num_digits_cache = len(self.digits_abs)\n        return self._num_digits_cache\n\n    def normalized(self) -> int:\n        \"\"\"Returns the absolute value for consistent digit operations.\"\"\"\n        return abs(self._value)\nclass ArmstrongService:\n    def __init__(self, utils: Utils = None) -> None:\n        \"\"\"Initializes the ArmstrongService with an optional Utils instance.\"\"\"\n        self._utils = utils or Utils()\n\n    def is_armstrong(self, n: int) -> bool:\n        \"\"\"Determines if the given number n is an Armstrong number.\"\"\"\n        model = NumberModel(n)\n        digits = model.digits_abs\n        power = model.num_digits\n        total = self._utils.pow_sum(digits, power)\n        return total == model.value\nclass NumberValidator:\n    def validate_and_convert(self, value: Any) -> int:\n        \"\"\"Validates input and converts it to an integer.\n        Raises ValidationError for invalid types or formats.\"\"\"\n        if isinstance(value, int):\n            return value\n        if isinstance(value, str):\n            s = value.strip()\n            if re.fullmatch(r'[+-]?\\d+', s):\n                return int(s)\n            raise ValidationError(f\"Invalid integer string: {value!r}\")\n        if isinstance(value, float):\n            raise ValidationError(f\"Unsupported type {type(value).__name__}. Floats are not allowed.\")\n        raise ValidationError(f\"Unsupported type {type(value).__name__}\")\n_service = ArmstrongService()\n_validator = NumberValidator()\ndef armstrong_number(n: int) -> bool:\n    \"\"\"Checks if the given number is an Armstrong number.\"\"\"\n    value = _validator.validate_and_convert(n)\n    return _service.is_armstrong(value)"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n):\n    \"\"\"\n    Calculates the sum and average of the first n natural numbers.\n    Assumes n is a positive integer based on design context.\n    \"\"\"\n    total = n * (n + 1) // 2\n    average = total / n\n    return (total, average)"}
{"task_id": "Mbpp/600", "solution": "class InvalidInputError(ValueError):\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\nclass InputValidator:\n    def __init__(self) -> None:\n        pass\n\n    def validate(self, n: object) -> int:\n        \"\"\"Accepts any input, ensures it is of type int. If input is of type int, returns it. Otherwise raises InvalidInputError.\"\"\"\n        if not isinstance(n, int):\n            raise InvalidInputError(f\"Expected int, got {type(n).__name__}\")\n        return n\nclass EvenChecker:\n    def __init__(self, validator: InputValidator) -> None:\n        self._validator = validator\n\n    def is_even(self, n: int) -> bool:\n        \"\"\"Return True if n is even, False otherwise. Assumes validated integer input.\"\"\"\n        return (n % 2) == 0\ndef is_Even(n: int) -> bool:\n    \"\"\"Checks whether the given number is even. Raises InvalidInputError if the input is not an integer.\"\"\"\n    validator = InputValidator()\n    value = validator.validate(n)\n    checker = EvenChecker(validator)\n    return checker.is_even(value)"}
{"task_id": "Mbpp/597", "solution": "def find_kth(a: list[int], b: list[int], k: int) -> int:\n    \"\"\"\n    Finds the k-th smallest element from two sorted arrays without merging them.\n    Assumes k is 1-based and within valid bounds [1, len(a) + len(b)].\n    \"\"\"\n    # Basic validation\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer\")\n    total = len(a) + len(b)\n    if k < 1 or k > total:\n        raise ValueError(\"k is out of bounds\")\n\n    # Ensure 'a' refers to the shorter array for optimized binary search\n    if len(a) > len(b):\n        a, b = b, a\n\n    m, n = len(a), len(b)\n    # Define the search space for 'i', the number of elements taken from 'a'\n    low = max(0, k - n)\n    high = min(k, m)\n\n    NEG_INF = float(\"-inf\")\n    POS_INF = float(\"inf\")\n\n    while low <= high:\n        i = (low + high) // 2  # Count of elements taken from 'a'\n        j = k - i              # Count of elements taken from 'b'\n\n        # Determine the four partition boundaries using sentinel values for out-of-bounds access\n        a_left = a[i - 1] if i > 0 else NEG_INF\n        a_right = a[i] if i < m else POS_INF\n        b_left = b[j - 1] if j > 0 else NEG_INF\n        b_right = b[j] if j < n else POS_INF\n\n        if a_left <= b_right and b_left <= a_right:\n            # Correct partition found: the k-th element is the maximum of the\n            # largest elements in the left partitions of a and b.\n            return int(max(a_left, b_left))\n        elif a_left > b_right:\n            # 'i' is too large, meaning we need to take fewer elements from 'a'\n            high = i - 1\n        else:  # b_left > a_right\n            # 'i' is too small, meaning we need to take more elements from 'a'\n            low = i + 1\n\n    # Should not reach here if inputs are valid\n    raise ValueError(\"Unable to find the k-th element with given inputs\")"}
{"task_id": "Mbpp/602", "solution": "def first_repeated_char(s: str) -> str | None:\n    \"\"\"\n    Finds the first repeated character in a string.\n    Returns the character if found, otherwise None.\n    \"\"\"\n    seen_chars = set()\n    for char in s:\n        if char in seen_chars:\n            return char\n        seen_chars.add(char)\n    return None"}
{"task_id": "Mbpp/604", "solution": "import re\ndef reverse_words(text: str) -> str:\n    \"\"\"\n    Reverses the order of space-separated words in a given string.\n    Normalizes whitespace by collapsing multiple spaces into one and stripping leading/trailing spaces.\n    \"\"\"\n    # Normalize whitespace: replace tabs/newlines with spaces, collapse sequences into single space, strip ends.\n    normalized_text = re.sub(r'\\s+', ' ', text).strip()\n\n    # Split the normalized string into words. If empty, return empty string.\n    words = normalized_text.split(' ') if normalized_text else []\n\n    # Reverse and join.\n    words.reverse()\n    return ' '.join(words)"}
{"task_id": "Mbpp/606", "solution": "import math\nfrom typing import Any\nclass ConverterError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass MathAdapter:\n    def __init__(self) -> None:\n        self._pi = math.pi\n\n    def radians(self, degrees: float) -> float:\n        return degrees * (self._pi / 180.0)\n\n    def pi(self) -> float:\n        return self._pi\nclass InputValidator:\n    def __init__(self) -> None:\n        pass\n\n    def validate_numeric(self, value: Any) -> float:\n        try:\n            f = float(value)\n        except (TypeError, ValueError):\n            raise ConverterError(f\"Value '{value}' is not numeric\")\n        if not self.is_finite(f):\n            raise ConverterError(f\"Value '{value}' is not finite\")\n        return f\n\n    def is_finite(self, value: float) -> bool:\n        return math.isfinite(value)\nclass DegreesToRadiansConverter:\n    def __init__(self, math_adapter: MathAdapter, validator: InputValidator) -> None:\n        self.math_adapter = math_adapter\n        self.validator = validator\n\n    def convert(self, degrees: float) -> float:\n        validated = self.validator.validate_numeric(degrees)\n        return self.math_adapter.radians(validated)\ndef radian_degree(degrees: float) -> float:\n    \"\"\"Convenience function used in tests: radian_degree(90) -> pi/2\"\"\"\n    return DegreesToRadiansConverter(MathAdapter(), InputValidator()).convert(degrees)"}
{"task_id": "Mbpp/607", "solution": "import re\nfrom typing import Optional, Tuple, Union\nclass SearchError(Exception):\n    \"\"\"Exception raised for errors during search operations.\"\"\"\n    def __init__(self, message: str, cause: Optional[Exception] = None):\n        super().__init__(message)\n        self.message = message\n        self.cause = cause\n\n    def __str__(self):\n        if self.cause:\n            return f\"{self.message}: {self.cause}\"\n        return self.message\ndef find_literals(text: str, pattern: Union[str, re.Pattern], *, raise_on_no_match: bool = True) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Searches a string for a regex pattern, returning the matched substring, start index, and end index.\n    Raises SearchError on invalid patterns or no match (configurable).\n    \"\"\"\n    compiled_pattern: re.Pattern\n\n    if isinstance(pattern, re.Pattern):\n        compiled_pattern = pattern\n    else:\n        try:\n            compiled_pattern = re.compile(pattern)\n        except re.error as e:\n            raise SearchError(\"InvalidPattern\", cause=e)\n\n    m = re.search(compiled_pattern, text)\n\n    if m:\n        return (m.group(0), m.start(), m.end())\n    else:\n        if raise_on_no_match:\n            raise SearchError(\"NoMatch\")\n        return None"}
{"task_id": "Mbpp/605", "solution": "def prime_num(n: int) -> bool:\n    \"\"\"\n    Checks if an integer is a prime number using trial division with a 6k \u00b1 1 optimization.\n    \"\"\"\n    import math\n\n    if n < 2:\n        return False\n    if n in (2, 3):\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n\n    limit = int(math.isqrt(n))\n    i = 5\n    while i <= limit:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True"}
{"task_id": "Mbpp/603", "solution": "def get_ludic(n: int) -> list[int]:\n    \"\"\"\n    Computes all ludic numbers less than or equal to n using an iterative sieve.\n    The algorithm starts with numbers from 1 to n and iteratively removes elements.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be an integer >= 1\")\n\n    nums = list(range(1, n + 1))\n\n    i = 1\n    # Iterate through the list. nums[i] is the current ludic number that acts as the step.\n    while i < len(nums):\n        step = nums[i]\n\n        # Remove every 'step'-th element from the list, starting from index i + step.\n        del nums[i + step::step]\n\n        # Move to the next potential ludic number.\n        i += 1\n\n    return nums"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n):\n    \"\"\"\n    Computes the nth Bell number using the Bell triangle algorithm.\n    The Bell numbers are 0-indexed.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n == 0:\n        return 1\n\n    # Initialize the first row of the Bell triangle (B0)\n    row = [1]\n    # Iteratively build rows up to n\n    for i in range(1, n + 1):\n        new_row = [row[-1]]  # Each new row starts with the last element of the previous row\n        for j in range(1, i + 1):\n            # Each subsequent element is the sum of the element to its left in new_row\n            # and the element above it in the previous row (row[j-1])\n            new_row.append(new_row[-1] + row[j - 1])\n        row = new_row\n    return row[0]"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix, n):\n    \"\"\"\n    Returns the maximum value of the n'th column in a given matrix.\n    Assumes a valid, non-empty, rectangular matrix with numeric elements and a valid column index.\n    \"\"\"\n    column_values = [row[n] for row in matrix]\n    return max(column_values)"}
{"task_id": "Mbpp/614", "solution": "def cummulative_sum(tuple_list):\n    \"\"\"\n    Calculates the cumulative sum of all numeric values within a list of tuples.\n    Assumes valid input where `tuple_list` is a sequence of sequences containing numbers.\n    \"\"\"\n    total = 0.0\n    for inner_sequence in tuple_list:\n        for value in inner_sequence:\n            total += value\n    return total"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(data: tuple) -> list:\n    \"\"\"\n    Calculates the average value for each corresponding element across all inner tuples.\n    Assumes `data` is a non-empty tuple of non-empty tuples with consistent lengths and numeric elements.\n    \"\"\"\n    if not data:\n        return []\n\n    # Initialize a list to store the sum of elements for each column\n    column_sums = [0.0] * len(data[0])\n\n    # Iterate through each inner tuple (row)\n    for row in data:\n        # Iterate through each element in the current row\n        for i, value in enumerate(row):\n            column_sums[i] += value\n\n    # Calculate the average for each column\n    num_rows = len(data)\n    averages = [total_sum / num_rows for total_sum in column_sums]\n\n    return averages"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(lst, k):\n    \"\"\"\n    Return a new list with the k'th element removed.\n\n    Behavior:\n    - If k > 0, k is treated as 1-based (k=1 removes the first element).\n    - If k <= 0, k is treated like Python negative indices (k=-1 removes the last element).\n    Raises:\n    - TypeError if lst is not a list or k is not an int.\n    - IndexError if the computed index is out of range or the list is empty.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"lst must be a list\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an int\")\n\n    n = len(lst)\n    if n == 0:\n        raise IndexError(\"cannot remove from an empty list\")\n\n    if k > 0:\n        idx = k - 1\n    else:\n        idx = n + k\n\n    if idx < 0 or idx >= n:\n        raise IndexError(\"k out of range\")\n\n    return lst[:idx] + lst[idx + 1:]"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(a: tuple[int, ...], b: tuple[int, ...]) -> tuple[int, ...]:\n    \"\"\"\n    Computes the element-wise modulo of two tuples of integers.\n    Assumes inputs are tuples of integers and have the same length.\n    \"\"\"\n    return tuple(x % y for x, y in zip(a, b))"}
{"task_id": "Mbpp/612", "solution": "def merge(list_of_lists):\n    \"\"\"\n    Splits a list of two-element sublists into two separate lists.\n    The first output list contains all first elements, and the second contains all second elements.\n    \"\"\"\n    firsts = []\n    seconds = []\n    for sublist in list_of_lists:\n        firsts.append(sublist[0])\n        seconds.append(sublist[1])\n    return [firsts, seconds]"}
{"task_id": "Mbpp/618", "solution": "from typing import List, Sequence, Union\nNumber = Union[int, float]\ndef div_list(a: Sequence[Number], b: Sequence[Number]) -> List[float]:\n    \"\"\"\n    Performs element-wise division of two sequences of numbers.\n    Assumes inputs are of equal length and contain only numeric values, with no zero divisors.\n    \"\"\"\n    results: List[float] = []\n    for i in range(len(a)):\n        results.append(float(a[i] / b[i]))\n    return results"}
{"task_id": "Mbpp/619", "solution": "def move_num(s: str) -> str:\n    \"\"\"\n    Moves all numeric characters in a string to the end, preserving relative order.\n    \"\"\"\n    non_digits = []\n    digits = []\n    for char in s:\n        if char.isdigit():\n            digits.append(char)\n        else:\n            non_digits.append(char)\n    return \"\".join(non_digits) + \"\".join(digits)"}
