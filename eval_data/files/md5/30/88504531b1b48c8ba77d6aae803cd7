{"task_id": "Mbpp/448", "solution": "_perrin_cache = {0: 3, 1: 0, 2: 2}\ndef cal_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of Perrin numbers from P(0) up to P(n) inclusive.\n    Perrin numbers: P(0)=3, P(1)=0, P(2)=2, P(k)=P(k-2)+P(k-3) for k >= 3.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    # Ensure all Perrin numbers up to n are computed and cached.\n    # Start from current max index in cache + 1 if needed.\n    max_cached = max(_perrin_cache.keys())\n    for k in range(max_cached + 1, n + 1):\n        _perrin_cache[k] = _perrin_cache[k - 2] + _perrin_cache[k - 3]\n\n    # Sum the cached Perrin numbers from P(0) to P(n).\n    total_sum = 0\n    for i in range(n + 1):\n        total_sum += _perrin_cache[i]\n    return total_sum"}
{"task_id": "Mbpp/453", "solution": "def sumofFactors(n: int) -> int:\n    \"\"\"\n    Calculates the sum of even factors of a given positive integer.\n    \"\"\"\n    factors = set()\n    # Iterate from 1 up to the square root of n to find factors.\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            factors.add(i)\n            factors.add(n // i)\n        i += 1\n\n    # Sum only the even factors found.\n    total_even_sum = 0\n    for factor in factors:\n        if factor % 2 == 0:\n            total_even_sum += factor\n\n    return total_even_sum"}
{"task_id": "Mbpp/451", "solution": "import re\nfrom typing import Any, Optional\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input types.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass Validator:\n    \"\"\"Utility class for input validation.\"\"\"\n    def is_string(self, obj: Any) -> bool:\n        return isinstance(obj, str)\n\n    def validate_text(self, text: Any) -> None:\n        \"\"\"Validates that the input text is a string.\"\"\"\n        if not self.is_string(text):\n            raise InvalidInputError(\"text must be a str\")\nclass StringAdapter:\n    \"\"\"Provides utility methods for string normalization.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def normalize_whitespace(self, text: str) -> str:\n        \"\"\"Currently returns the input text unchanged.\"\"\"\n        return text\nclass Remover:\n    \"\"\"Implements various algorithms for whitespace removal.\"\"\"\n    DEFAULT_PATTERN = r'\\s+'\n\n    def __init__(self, pattern: Optional[str]=None, use_regex: bool=True) -> None:\n        self._pattern = pattern or self.DEFAULT_PATTERN\n        self._use_regex = use_regex\n        self._adapter = StringAdapter()\n\n    def remove(self, text: str) -> str:\n        \"\"\"Removes all whitespace characters from the given string.\"\"\"\n        if self._use_regex:\n            return re.sub(self._pattern, \"\", self._adapter.normalize_whitespace(text))\n        return self.remove_using_translation(text)\n\n    def remove_using_translation(self, text: str) -> str:\n        \"\"\"Removes whitespace using str.translate or a comprehension.\"\"\"\n        return \"\".join(char for char in text if not char.isspace())\nclass WhitespaceService:\n    \"\"\"Orchestrates validation and delegates whitespace removal.\"\"\"\n    def __init__(self, remover: Remover) -> None:\n        self._remover = remover\n        self._validator = Validator()\n\n    def clean(self, text: str) -> str:\n        \"\"\"Validates input and removes all whitespace.\"\"\"\n        self._validator.validate_text(text)\n        return self._remover.remove(text)\ndef remove_whitespaces(text: str) -> str:\n    \"\"\"Removes all whitespace characters from the given string.\"\"\"\n    remover = Remover()\n    service = WhitespaceService(remover)\n    return service.clean(text)"}
{"task_id": "Mbpp/454", "solution": "import re\nfrom typing import List, Dict, Any, Optional\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"\n    Checks if the input text contains a word with the letter 'z' (case-insensitive).\n    \"\"\"\n\n    # Configuration constants\n    DEFAULT_WORD_PATTERN: str = r\"\\b\\w*z\\w*\\b\"\n    COMPILE_FLAGS: int = re.IGNORECASE | re.UNICODE\n    CACHE_SIZE: int = 16\n\n    class WordMatchResult:\n        def __init__(self, matched: bool, matched_words: Optional[List[str]] = None) -> None:\n            self.matched = matched\n            self.matched_words = matched_words or []\n\n    class TextMatcherError(Exception):\n        def __init__(self, message: str) -> None:\n            self.message = message\n            super().__init__(message)\n\n    class RegexRepository:\n        def __init__(self, flags: int = COMPILE_FLAGS, cache_size: int = CACHE_SIZE) -> None:\n            self.flags = flags\n            self.cache_size = cache_size\n            self._cache: Dict[str, re.Pattern] = {}\n\n        def get_compiled(self, pattern: str) -> re.Pattern:\n            if pattern in self._cache:\n                # Simulate LRU: move accessed item to the end of the cache.\n                value = self._cache.pop(pattern)\n                self._cache[pattern] = value\n                return value\n\n            try:\n                compiled = re.compile(pattern, self.flags)\n            except re.error as e:\n                raise TextMatcherError(f\"Invalid regex pattern: {pattern}. Error: {e}\")\n\n            if len(self._cache) >= self.cache_size:\n                # Evict the least recently used item (the first one added).\n                self._cache.pop(next(iter(self._cache)))\n            self._cache[pattern] = compiled\n            return compiled\n\n    class TextMatcherService:\n        def __init__(self, repo: RegexRepository, pattern: Optional[str] = None) -> None:\n            self.repo = repo\n            self.pattern = pattern or DEFAULT_WORD_PATTERN\n\n        def text_match_wordz(self, text: str) -> WordMatchResult:\n            # Input validation (e.g., isinstance checks) omitted per specific instruction.\n\n            compiled = self.repo.get_compiled(self.pattern)\n            matches = [m.group(0) for m in compiled.finditer(text)]\n            # Deduplicate matched words while preserving order.\n            unique = list(dict.fromkeys(matches))\n            return WordMatchResult(matched=bool(unique), matched_words=unique)\n\n    # Initialize components and perform the check.\n    repo_instance = RegexRepository()\n    service_instance = TextMatcherService(repo_instance)\n    result = service_instance.text_match_wordz(text)\n    return result.matched"}
{"task_id": "Mbpp/457", "solution": "def Find_Min(lists):\n    \"\"\"\n    Return the sublist (one of the input sequences) that has the minimum length.\n    If multiple sublists share the minimum length, the first is returned.\n\n    Parameters:\n    - lists: a list or tuple of sublists (each sublist should be a list or tuple)\n\n    Raises:\n    - TypeError: if the top-level input or any element is not a list/tuple\n    - ValueError: if the top-level sequence is empty\n    \"\"\"\n    if not isinstance(lists, (list, tuple)):\n        raise TypeError(\"Input must be a list or tuple of sequences\")\n\n    if len(lists) == 0:\n        raise ValueError(\"Input must not be empty\")\n\n    best = None\n    best_len = None\n\n    for idx, sub in enumerate(lists):\n        if not isinstance(sub, (list, tuple)):\n            raise TypeError(f\"Element at index {idx} is not a supported sequence type (expected list or tuple)\")\n        cur_len = len(sub)\n        if best is None or cur_len < best_len:\n            best = sub\n            best_len = cur_len\n\n    return best"}
