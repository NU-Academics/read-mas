{"task_id": "Mbpp/459", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass ServiceError(Exception):\n    \"\"\"Generic service layer exception, often wrapping original exceptions.\"\"\"\n    def __init__(self, message: str, original=None):\n        super().__init__(message)\n        self.original = original\nclass StringCleaner:\n    \"\"\"Core utility to remove uppercase characters from a string.\"\"\"\n    def process(self, text: str) -> str:\n        return ''.join(ch for ch in text if not (ch.isupper()))\nclass RemoveUppercaseService:\n    \"\"\"Service layer for removing uppercase characters, handling validation and error wrapping.\"\"\"\n    def __init__(self, cleaner=None):\n        self._cleaner = cleaner or StringCleaner()\n\n    def clean(self, text: str) -> str:\n        \"\"\"Validates input and removes uppercase characters.\"\"\"\n        if text is None or not isinstance(text, str):\n            raise InvalidInputError(\"text must be a non-None str\")\n        try:\n            return self._cleaner.process(text)\n        except InvalidInputError:\n            raise\n        except Exception as e:\n            raise ServiceError(\"Unexpected error cleaning text\", e)\ndef remove_uppercase(text: str) -> str:\n    \"\"\"Removes all uppercase characters from the input string using the service layer.\"\"\"\n    return RemoveUppercaseService().clean(text)"}
{"task_id": "Mbpp/462", "solution": "def combinations_list(items):\n    \"\"\"\n    Generates all possible combinations (subsets) of elements from the input list.\n    Subsets are ordered by bitmask enumeration, and elements within each subset are ordered by descending original index.\n    \"\"\"\n    n = len(items)\n    all_combinations = []\n\n    # Iterate through all possible bitmasks from 0 to 2^n - 1.\n    # Each mask represents a unique combination of elements.\n    for mask in range(1 << n):\n        current_subset = []\n        # Build the subset by including elements whose corresponding bit in the mask is set.\n        # Elements are added in reverse order of their original index to match the specified ordering.\n        for i in range(n - 1, -1, -1):\n            if (mask >> i) & 1:\n                current_subset.append(items[i])\n        all_combinations.append(current_subset)\n\n    return all_combinations"}
