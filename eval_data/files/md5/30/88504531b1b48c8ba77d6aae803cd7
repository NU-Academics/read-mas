{"task_id": "Mbpp/278", "solution": "def count_first_elements(input_tuple: tuple) -> int:\n    \"\"\"\n    Counts elements before the first nested tuple in the given tuple.\n    Returns the index of the first tuple element, or the tuple's length if no tuple is found.\n    \"\"\"\n    for i, element in enumerate(input_tuple):\n        if isinstance(element, tuple):\n            return i\n    return len(input_tuple)"}
{"task_id": "Mbpp/276", "solution": "import math\nclass DomainError(Exception):\n    \"\"\"Custom exception for domain-specific validation errors.\"\"\"\n    def __init__(self, message: str, code: int = 400) -> None:\n        self.message = message\n        self.code = code\n    def __str__(self) -> str:\n        return f\"Error {self.code}: {self.message}\"\nclass MathUtils:\n    \"\"\"Utility class for mathematical operations.\"\"\"\n    @staticmethod\n    def is_finite_number(value: object) -> bool:\n        \"\"\"Checks if a value is a finite number (int or float, not NaN or Inf).\"\"\"\n        return isinstance(value, (int, float)) and math.isfinite(value)\nclass InputValidator:\n    \"\"\"Validates input values for geometric calculations.\"\"\"\n    def validate_radius(self, radius: object) -> None:\n        \"\"\"Ensures radius is a non-negative, finite number.\"\"\"\n        if not MathUtils.is_finite_number(radius) or radius < 0:\n            raise DomainError(f\"Invalid radius: {radius}\", code=400)\n\n    def validate_height(self, height: object) -> None:\n        \"\"\"Ensures height is a non-negative, finite number.\"\"\"\n        if not MathUtils.is_finite_number(height) or height < 0:\n            raise DomainError(f\"Invalid height: {height}\", code=400)\n\n    def validate_both(self, radius: object, height: object) -> None:\n        \"\"\"Validates both radius and height.\"\"\"\n        self.validate_radius(radius)\n        self.validate_height(height)\nclass ConfigRepository:\n    \"\"\"Provides configuration constants.\"\"\"\n    def __init__(self) -> None:\n        pass\n    def get_precision(self) -> int:\n        return 6\n    def get_unit_label(self) -> str:\n        return \"cubic units\"\nclass VolumeCalculator:\n    \"\"\"Calculates the volume of geometric shapes.\"\"\"\n    def __init__(self, config_repo: ConfigRepository = None) -> None:\n        self._config = config_repo or ConfigRepository()\n\n    def calculate_from_values(self, radius: float, height: float) -> float:\n        \"\"\"Computes cylinder volume from radius and height.\"\"\"\n        if radius < 0 or height < 0:\n            raise DomainError(\"radius and height must be non-negative\", code=400)\n        return math.pi * (radius ** 2) * height\n_validator = InputValidator()\n_calc = VolumeCalculator(config_repo=ConfigRepository())\ndef volume_cylinder(radius: float, height: float) -> float:\n    \"\"\"\n    Calculates the volume of a cylinder given its radius and height.\n    Raises DomainError if inputs are invalid (e.g., negative or non-numeric).\n    \"\"\"\n    _validator.validate_both(radius, height)\n    return _calc.calculate_from_values(radius, height)"}
{"task_id": "Mbpp/279", "solution": "def is_num_decagonal(n):\n    \"\"\"\n    Calculates the nth decagonal number using the formula 4*n^2 - 3*n.\n    Assumes n is a positive integer based on design context.\n    \"\"\"\n    return 4 * n * n - 3 * n"}
{"task_id": "Mbpp/280", "solution": "def sequential_search(array, element):\n    \"\"\"\n    Searches for an element in an array using sequential search.\n    Returns a tuple (found: bool, index: int) indicating if the element was found and its position.\n    \"\"\"\n    for i, item in enumerate(array):\n        if item == element:\n            return (True, i)\n    return (False, -1)"}
{"task_id": "Mbpp/284", "solution": "def check_element(items, element):\n    \"\"\"\n    Checks if all items in the given list are equal to the specified element.\n    Returns True for an empty list (vacuous truth).\n    \"\"\"\n    for item in items:\n        if item != element:\n            return False\n    return True"}
{"task_id": "Mbpp/281", "solution": "def all_unique(items):\n    \"\"\"\n    Return True if all elements in the iterable `items` are unique.\n\n    Uses a hash set for O(n) average time for hashable elements.\n    Falls back to O(n^2) pairwise comparison if any element is unhashable.\n    Raises TypeError if `items` is not iterable.\n    \"\"\"\n    try:\n        seen = set()\n        for el in items:\n            try:\n                if el in seen:\n                    return False\n                seen.add(el)\n            except TypeError:\n                # Encountered an unhashable element; fallback to pairwise comparison.\n                lst = list(items)\n                n = len(lst)\n                for i in range(n):\n                    for j in range(i + 1, n):\n                        if lst[i] == lst[j]:\n                            return False\n                return True\n        return True\n    except TypeError:\n        raise TypeError(\"all_unique() expects an iterable\")"}
{"task_id": "Mbpp/282", "solution": "def sub_list(a, b):\n    \"\"\"Subtract two lists element-wise and return the result list.\n\n    Raises:\n        ValueError: if inputs are not sequences of equal length or contain non-numeric elements.\n    \"\"\"\n    # Basic validation: ensure lengths match\n    if len(a) != len(b):\n        raise ValueError(f\"Lengths differ: {len(a)} != {len(b)}\")\n\n    # Validate elements and compute result\n    result = []\n    for i, (x, y) in enumerate(zip(a, b)):\n        # Reject booleans explicitly\n        if isinstance(x, bool) or isinstance(y, bool):\n            raise ValueError(f\"Element at index {i} is not a numeric type: {x}, {y}\")\n        if not isinstance(x, (int, float)) or not isinstance(y, (int, float)):\n            raise ValueError(f\"Element at index {i} is not a numeric type: {x}, {y}\")\n        result.append(x - y)\n\n    return result"}
{"task_id": "Mbpp/283", "solution": "def validate(integer: int) -> bool:\n    \"\"\"Checks if each digit's frequency in the integer is less than or equal to the digit's value.\n    The validation uses the absolute value, and any occurrence of digit '0' results in False.\n    \"\"\"\n    num = abs(integer)\n\n    # If the number is 0, the digit '0' appears once. Frequency (1) > digit (0) makes it invalid.\n    if num == 0:\n        return False\n\n    counts = {}\n    temp_num = num\n    while temp_num > 0:\n        digit = temp_num % 10\n        counts[digit] = counts.get(digit, 0) + 1\n        temp_num //= 10\n\n    for digit, frequency in counts.items():\n        # The condition states frequency <= digit. If frequency > digit, it's invalid.\n        # This naturally covers digit '0' as well, since any frequency for '0' (which would be >= 1)\n        # will be greater than the digit '0' itself.\n        if frequency > digit:\n            return False\n\n    return True"}
{"task_id": "Mbpp/285", "solution": "import re\ndef text_match_two_three(text: str) -> bool:\n    \"\"\"\n    Checks if a string contains 'a' followed by two or three 'b' characters.\n    Uses regex to find the pattern \"abb\" or \"abbb\".\n    \"\"\"\n    pattern = r\"a(b{2,3})\"\n    return re.search(pattern, text) is not None"}
{"task_id": "Mbpp/290", "solution": "def max_length(list_of_lists):\n    \"\"\"\n    Finds the list of maximum length in a list of lists, returning its length and the list itself.\n    If multiple lists have the same maximum length, the first one encountered is returned.\n    \"\"\"\n    max_len = 0\n    longest_list = []\n    for sublist in list_of_lists:\n        current_len = len(sublist)\n        if current_len > max_len:\n            max_len = current_len\n            longest_list = sublist\n    return (max_len, longest_list)"}
{"task_id": "Mbpp/287", "solution": "def square_Sum(n):\n    \"\"\"\n    Calculates the sum of squares of the first n even natural numbers using a closed-form formula.\n\n    The formula:\n      S(n) = sum_{k=1..n} (2k)^2 = 4 * sum_{k=1..n} k^2\n           = 4 * n * (n + 1) * (2n + 1) // 6\n\n    Args:\n        n (int): number of even natural numbers (n >= 0)\n\n    Returns:\n        int: sum of squares of first n even natural numbers\n\n    Raises:\n        TypeError: if n is not an int\n        ValueError: if n is negative\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    return 4 * n * (n + 1) * (2 * n + 1) // 6"}
