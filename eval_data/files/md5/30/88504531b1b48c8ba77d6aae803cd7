{"task_id": "Mbpp/104", "solution": "def sort_sublists(lists: Iterable[Iterable[Any]]) -> List[List[str]]:\n    \"\"\"Sorts each sublist lexicographically, returning a new list of sorted sublists.\"\"\"\n    result: List[List[str]] = []\n    for sublist in lists:\n        sorted_sub = sorted([str(item) for item in sublist])\n        result.append(sorted_sub)\n    return result"}
{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary: str, rotations: int) -> int:\n    \"\"\"\n    Calculates the number of times a binary string, when left-rotated, results in an odd number.\n    An odd number in binary has its least significant bit (last character) as '1'.\n    \"\"\"\n    if not isinstance(binary, str):\n        raise TypeError(\"binary must be a string\")\n    if not isinstance(rotations, int):\n        raise TypeError(\"rotations must be an integer\")\n    b = binary.strip()\n    if len(b) == 0:\n        raise ValueError(\"binary string must be non-empty\")\n    if any(ch not in \"01\" for ch in b):\n        raise ValueError(\"binary string must contain only '0' and '1'\")\n    if rotations < 0:\n        raise ValueError(\"rotations must be non-negative\")\n\n    n = len(b)\n    odd_count = 0\n\n    for k in range(rotations):\n        # For k=0 (no rotation), last bit is b[n-1].\n        # For k>0, after k left rotations, the character originally at index (k-1) % n becomes the last bit.\n        idx = (n - 1) if k == 0 else ((k - 1) % n)\n        if b[idx] == '1':\n            odd_count += 1\n\n    return odd_count"}
{"task_id": "Mbpp/111", "solution": "from typing import List, Any, Sequence\nclass ValidationError(Exception):\n    \"\"\"Domain-specific validation exception for invalid inputs.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass ListCollection:\n    \"\"\"Immutable DTO for nested lists, providing a canonical List[List[Any]] representation.\"\"\"\n    def __init__(self, lists: Sequence[Sequence[Any]]) -> None:\n        self._lists: List[List[Any]] = [list(inner) for inner in lists]\n\n    def to_list_of_lists(self) -> List[List[Any]]:\n        \"\"\"Returns a defensive copy of the nested lists.\"\"\"\n        return [list(inner) for inner in self._lists]\nclass CommonFinderService:\n    \"\"\"Service containing the core algorithm for finding common elements across nested lists.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def find_common(self, lists: List[List[Any]]) -> List[Any]:\n        \"\"\"Finds elements present in every sub-list, returning them as a list.\"\"\"\n        if not lists:\n            raise ValidationError(\"Input 'lists' cannot be empty for common element search.\")\n\n        common_elements_set = set(lists[0])\n\n        for lst in lists[1:]:\n            common_elements_set &= set(lst)\n            if not common_elements_set:\n                break\n        return list(common_elements_set)\nclass InputAdapter:\n    \"\"\"Adapts various input representations into a ListCollection DTO.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def adapt(self, input_obj: Any) -> ListCollection:\n        \"\"\"Converts input (e.g., Sequence[Sequence[Any]]) to a validated ListCollection.\"\"\"\n        validate_nested_lists(input_obj)\n        return ListCollection(input_obj)\ndef common_in_nested_lists(lists: Sequence[Sequence[Any]]) -> List[Any]:\n    \"\"\"\n    Finds common elements in given nested lists.\n\n    This function acts as a facade, orchestrating input validation and the core common element finding logic.\n    \"\"\"\n    adapter = InputAdapter()\n    dto = adapter.adapt(lists)\n    service = CommonFinderService()\n    return service.find_common(dto.to_list_of_lists())"}
{"task_id": "Mbpp/113", "solution": "import re\n_INTEGER_PATTERN = re.compile(r'^[+-]?[0-9]+$')\ndef check_integer(s: str) -> bool:\n    \"\"\"\n    Checks if a string represents an integer, allowing optional leading + or -,\n    and ignoring leading/trailing whitespace.\n\n    Returns True if s is a valid integer literal, otherwise False.\n\n    Note: This function assumes `s` is a str. Passing None will raise AttributeError.\n    \"\"\"\n    trimmed_s = s.strip()\n    if trimmed_s == \"\":\n        return False\n    return bool(_INTEGER_PATTERN.fullmatch(trimmed_s))"}
