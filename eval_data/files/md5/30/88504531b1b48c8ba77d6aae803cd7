{"task_id": "Mbpp/759", "solution": "import re\n_decimal_template = r'^[+-]?\\d+\\.{frac}$'\n_regex_cache = {}\ndef _build_decimal_regex(precision: int) -> re.Pattern[str]:\n    # Builds a regex pattern for a decimal number with the specified precision.\n    # Assumes precision is a non-negative integer.\n    if not isinstance(precision, int):\n        raise TypeError(\"precision must be an integer\")\n    if precision < 0:\n        raise ValueError(\"precision must be non-negative\")\n    frac = r'\\d{' + str(precision) + r'}'\n    pattern = _decimal_template.format(frac=frac)\n    return re.compile(pattern)\ndef _normalize_value(value: str) -> str:\n    # Trims leading and trailing whitespace from the input string.\n    if value is None:\n        raise TypeError(\"value must be a string\")\n    return str(value).strip()\ndef is_decimal(value: str, precision: int = 2) -> bool:\n    # Checks if a string is a decimal number with exactly 'precision' digits after the decimal point.\n    # Handles optional sign and trims whitespace.\n    s = _normalize_value(value)\n\n    pattern = _regex_cache.get(precision)\n    if pattern is None:\n        pattern = _build_decimal_regex(precision)\n        _regex_cache[precision] = pattern\n\n    return bool(pattern.match(s))"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(arr, n=None):\n    \"\"\"\n    Finds the minimum difference between any two elements in a given array.\n    The algorithm sorts the array and then finds the minimum difference between adjacent elements.\n    \"\"\"\n    vals = list(arr)\n    if len(vals) < 2:\n        raise ValueError(\"arr must contain at least two elements\")\n    vals.sort()\n\n    min_diff = abs(vals[1] - vals[0])\n\n    for i in range(1, len(vals) - 1):\n        current_diff = abs(vals[i + 1] - vals[i])\n        if current_diff < min_diff:\n            min_diff = current_diff\n\n    return min_diff"}
