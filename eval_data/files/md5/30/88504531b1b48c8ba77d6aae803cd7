{"task_id": "Mbpp/777", "solution": "def find_sum(values: list) -> int:\n    \"\"\"\n    Calculates the sum of unique elements in the given list.\n    This interprets 'non-repeated elements' as elements present in the set of the list.\n    \"\"\"\n    unique_elements = set(values)\n    total_sum = sum(unique_elements)\n    return total_sum"}
{"task_id": "Mbpp/778", "solution": "from typing import Iterable, List, TypeVar\nT = TypeVar(\"T\")\ndef pack_consecutive_duplicates(seq: Iterable[T]) -> List[List[T]]:\n    it = iter(seq)\n    groups: List[List[T]] = []\n    try:\n        first = next(it)\n    except StopIteration:\n        return []\n    current = [first]\n    for item in it:\n        if item == current[-1]:\n            current.append(item)\n        else:\n            groups.append(current)\n            current = [item]\n    groups.append(current)\n    return groups"}
{"task_id": "Mbpp/780", "solution": "from dataclasses import dataclass\nfrom typing import Any, Iterable, List, Tuple\ndef parse_input(raw: Any) -> List[TuplePair]:\n    \"\"\"Parses raw input (list of tuples/lists) into a list of TuplePair objects.\"\"\"\n    validate_pairs_list(raw)\n    return [TuplePair.from_tuple(tuple(x)) for x in raw]\ndef to_raw_list(pairs: List[TuplePair]) -> List[Tuple[int,int]]:\n    \"\"\"Converts a list of TuplePair objects back to a list of standard Python tuples.\"\"\"\n    return [p.to_tuple() for p in pairs]\nclass CombinationService:\n    \"\"\"Provides the core algorithm for finding combinations of sums from TuplePair objects.\"\"\"\n    def find_combinations(self, pairs: List[TuplePair]) -> List[TuplePair]:\n        \"\"\"\n        Computes element-wise sums for all unique unordered pairs of TuplePair instances.\n        The output order is deterministic based on input indices.\n        \"\"\"\n        result: List[TuplePair] = []\n        n = len(pairs)\n        for i in range(n):\n            for j in range(i + 1, n):\n                a = pairs[i].value1 + pairs[j].value1\n                b = pairs[i].value2 + pairs[j].value2\n                result.append(TuplePair(a, b))\n        return result\ndef find_combinations(raw_input: List[Tuple[int,int]]) -> List[Tuple[int,int]]:\n    \"\"\"\n    Computes element-wise sums for all unique unordered pairs of 2-element integer tuples.\n    Validates the input and returns results in a deterministic order.\n    \"\"\"\n    pairs = parse_input(raw_input)\n    svc = CombinationService()\n    combos = svc.find_combinations(pairs)\n    return to_raw_list(combos)"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(n: int) -> bool:\n    \"\"\"Checks if the count of positive divisors for n is even.\"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be a positive integer (>= 1)\")\n\n    def _enumerate_divisor_count(num: int) -> int:\n        \"\"\"Efficiently computes the number of positive divisors for a given integer.\"\"\"\n        count = 0\n        i = 1\n        while i * i <= num:\n            if num % i == 0:\n                count += 1 if i * i == num else 2\n            i += 1\n        return count\n\n    divisor_count = _enumerate_divisor_count(n)\n    return divisor_count % 2 == 0"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(nums):\n    \"\"\"\n    Finds the sum of all odd length subarrays using an O(N) approach.\n    For each element, calculate how many odd-length subarrays it contributes to.\n    \"\"\"\n    n = len(nums)\n    total_sum = 0\n    for i, num in enumerate(nums):\n        # Calculate total subarrays containing nums[i]\n        # (i + 1) choices for starting point (0 to i)\n        # (n - i) choices for ending point (i to n-1)\n        total_subarrays_containing_i = (i + 1) * (n - i)\n\n        # Half of these subarrays will be odd length, half even.\n        # If total_subarrays_containing_i is odd, there's one more odd-length than even.\n        odd_count = (total_subarrays_containing_i + 1) // 2\n\n        total_sum += num * odd_count\n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(nums):\n    \"\"\"\n    Find the product of the first odd and the first even number in the given iterable.\n    Elements that are not ints will be coerced to int when possible.\n    Raises ValueError if an odd or an even value is not found or if elements cannot be converted to int.\n    \"\"\"\n    first_odd = None\n    first_even = None\n\n    for item in nums:\n        try:\n            n = int(item)\n        except Exception:\n            raise ValueError(\"All elements must be integers or convertible to int.\")\n        if first_odd is None and (n % 2 != 0):\n            first_odd = n\n        if first_even is None and (n % 2 == 0):\n            first_even = n\n        if first_odd is not None and first_even is not None:\n            break\n\n    if first_odd is None or first_even is None:\n        raise ValueError(\"Both an odd and an even number are required in the sequence.\")\n\n    return first_odd * first_even"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(s: str) -> tuple[int, ...]:\n    \"\"\"Converts a string representation of an integer tuple to an actual integer tuple.\"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string\")\n\n    s = s.strip()\n    if not s.startswith('(') or not s.endswith(')'):\n        raise ValueError(\"Input must start with '(' and end with ')'\")\n\n    inner_content = s[1:-1].strip()\n\n    if inner_content == '':\n        return ()\n\n    parts = [p.strip() for p in inner_content.split(',')]\n    if any(p == '' for p in parts):\n        raise ValueError(\"Empty token found in tuple string\")\n\n    try:\n        int_values = tuple(int(p) for p in parts)\n    except ValueError as e:\n        raise ValueError(f\"Non-integer token found: {e}\") from e\n\n    return int_values"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(seq, value):\n    \"\"\"\n    Return the index where `value` should be inserted in `seq` to keep it sorted,\n    inserting to the right of any existing equal elements (bisect_right behavior).\n    \"\"\"\n    left, right = 0, len(seq)\n    while left < right:\n        mid = (left + right) // 2\n        if seq[mid] <= value:\n            left = mid + 1\n        else:\n            right = mid\n    return left"}
{"task_id": "Mbpp/790", "solution": "from typing import Sequence, Any\ndef even_position(lst: Sequence[Any], strict: bool = True) -> bool:\n    \"\"\"\n    Checks if every element at an even index in a list is an even integer.\n    In strict mode, raises ValueError for non-integer elements at even indices.\n    \"\"\"\n    if lst is None:\n        raise TypeError(\"Input list cannot be None.\")\n\n    for i in range(0, len(lst), 2):\n        val = lst[i]\n        if not isinstance(val, int):\n            if strict:\n                raise ValueError(f\"Non-integer value {val!r} found at even index {i}.\")\n            else:\n                # In permissive mode, skip non-integer elements at even indices.\n                continue\n\n        if val % 2 != 0:\n            return False\n\n    return True"}
{"task_id": "Mbpp/788", "solution": "from typing import List, Tuple\nfrom dataclasses import dataclass\nclass TupleFactory:\n    def create(self, input_dto: InputDTO) -> Tuple[str, ...]:\n        return tuple(input_dto.elements) + (input_dto.extra,)\nclass TupleService:\n    def __init__(self, factory: TupleFactory) -> None:\n        self._factory = factory\n\n    def create_tuple(self, elements: List[str], extra: str) -> Tuple[str, ...]:\n        validate_elements(elements)\n        validate_extra(extra)\n        dto = InputDTO(elements=elements, extra=extra)\n        return self._factory.create(dto)\nclass TupleController:\n    def __init__(self, service: TupleService) -> None:\n        self._service = service\n\n    def make(self, elements: List[str], extra: str) -> Tuple[str, ...]:\n        return self._service.create_tuple(elements, extra)\n_factory_singleton = TupleFactory()\n_service_singleton = TupleService(_factory_singleton)\n_controller_singleton = TupleController(_service_singleton)\ndef new_tuple(elements: List[str], value: str) -> Tuple[str, ...]:\n    \"\"\"\n    Creates a new tuple by combining a list of strings and an additional string.\n    Input validation is handled internally by the underlying service.\n    \"\"\"\n    return _controller_singleton.make(elements, value)"}
{"task_id": "Mbpp/787", "solution": "import re\ndef text_match_three(text):\n    \"\"\"\n    Checks if the given text contains the substring 'abbb'.\n    The matching is case-sensitive.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a str\")\n    pattern = r'abbb'\n    return re.search(pattern, text) is not None"}
{"task_id": "Mbpp/791", "solution": "def remove_nested(input_tuple):\n    \"\"\"\n    Removes top-level tuple elements from the given tuple.\n    Returns a new tuple containing only the non-tuple elements in their original order.\n    \"\"\"\n    return tuple(item for item in input_tuple if not isinstance(item, tuple))"}
{"task_id": "Mbpp/792", "solution": "from typing import Any\ndef count_list(lists: Any, deep: bool = False) -> int:\n    \"\"\"\n    Counts the number of list instances in a given iterable, either shallow or deep.\n    It counts list objects found at the top level or within nested iterables.\n    \"\"\"\n    if not deep:\n        count = 0\n        for item in lists:\n            if isinstance(item, list):\n                count += 1\n        return count\n    else:\n        total_count = 0\n        seen_ids = set() # Tracks object IDs to prevent infinite recursion in cyclic structures.\n\n        def _count_recursive_deep(current_item):\n            nonlocal total_count\n            item_id = id(current_item)\n            if item_id in seen_ids:\n                return\n            seen_ids.add(item_id)\n\n            if isinstance(current_item, list):\n                total_count += 1\n\n            # Do not recurse into strings or bytes, as they iterate character by character.\n            if isinstance(current_item, (str, bytes)):\n                return\n\n            try:\n                # Attempt to iterate; if not iterable, a TypeError will be caught.\n                iterator = iter(current_item)\n            except TypeError:\n                return # Not iterable, so nothing to recurse into.\n\n            for sub_item in iterator:\n                _count_recursive_deep(sub_item)\n\n        # The initial `lists` parameter is assumed to be an iterable itself.\n        # We iterate its direct elements for the start of the deep count.\n        for item in lists:\n            _count_recursive_deep(item)\n\n        return total_count"}
{"task_id": "Mbpp/794", "solution": "import re\ndef text_starta_endb(text: str) -> bool:\n    \"\"\"\n    Checks if a string starts with 'a', contains any sequence of characters, and ends with 'b'.\n    The match is case-sensitive and considers the entire string.\n    \"\"\"\n    pattern = r\"a.*b\"\n    return re.fullmatch(pattern, text) is not None"}
{"task_id": "Mbpp/793", "solution": "def last(arr, value):\n    \"\"\"\n    Finds the last position of an element in a sorted array using binary search.\n    Returns the index or -1 if the value is not found.\n    \"\"\"\n    n = len(arr)\n    low, high = 0, n - 1\n    result = -1\n\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == value:\n            result = mid\n            low = mid + 1  # Move right to find the last occurrence\n        elif arr[mid] < value:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result"}
{"task_id": "Mbpp/796", "solution": "import numbers\nfrom typing import Any, Iterator, Optional, Dict\nfrom decimal import Decimal\nSUPPORTED_NUMERIC_TYPES = (int, float, Decimal)\nSUPPORT_NESTED_DICTS = True\nclass SumRequest:\n    def __init__(self, data: Dict[str, Any]) -> None:\n        self.data = data\nclass SumResult:\n    def __init__(self, total: numbers.Number) -> None:\n        self.total = total\nclass Validator:\n    # Use module-level constants for numeric types and nested dict support\n    _SUPPORTED_NUMERIC_TYPES = SUPPORTED_NUMERIC_TYPES\n    _SUPPORT_NESTED_DICTS = SUPPORT_NESTED_DICTS\n\n    def validate_root_is_dict(self, data: Any) -> None:\n        \"\"\"Validates if the root input is a dictionary, performs no-op due to constraints.\"\"\"\n        # Per strict requirement: \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n        # Therefore, this method does not perform actual validation or raise errors.\n        pass\n\n    def _is_numeric(self, value: Any) -> bool:\n        \"\"\"Checks if a value is of a supported numeric type.\"\"\"\n        # This check is for core logic to identify summable items, not an \"edge case\" validation.\n        return isinstance(value, self._SUPPORTED_NUMERIC_TYPES)\n\n    def iterate_numeric_values(self, data: Dict[str, Any]) -> Iterator[numbers.Number]:\n        \"\"\"Iterates and yields numeric values from the dictionary, including nested dictionaries.\"\"\"\n        # Per strict requirement: \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n        # Any non-numeric, non-dict values are implicitly skipped without raising errors.\n        for value in data.values():\n            if self._is_numeric(value):\n                yield value\n            elif self._SUPPORT_NESTED_DICTS and isinstance(value, dict):\n                yield from self.iterate_numeric_values(value)\nclass SumRepository:\n    def __init__(self) -> None:\n        self._store: Dict[str, SumResult] = {}\n\n    def persist(self, key: str, result: SumResult) -> None:\n        \"\"\"Persists the sum result (no-op in this inline context).\"\"\"\n        pass # No actual persistence needed or implemented for this problem.\n\n    def get(self, key: str) -> Optional[SumResult]:\n        \"\"\"Retrieves a stored sum result (not implemented).\"\"\"\n        return None\n\n    def clear(self) -> None:\n        \"\"\"Clears the repository (not implemented).\"\"\"\n        pass\nclass SumService:\n    def __init__(self, validator: Validator, repository: SumRepository) -> None:\n        self._validator = validator\n        self._repository = repository\n\n    def sum(self, request: SumRequest) -> SumResult:\n        \"\"\"Computes the sum of numeric values in the request data.\"\"\"\n        # Root validation is a no-op as per Validator's adaptation to requirements.\n        self._validator.validate_root_is_dict(request.data)\n\n        total: numbers.Number = 0\n        for value in self._validator.iterate_numeric_values(request.data):\n            total += value\n\n        result = SumResult(total=total)\n        # Persistence is a no-op as per SumRepository's adaptation.\n        self._repository.persist(\"last\", result)\n        return result\ndef return_sum(data: dict) -> numbers.Number:\n    \"\"\"Calculates the sum of all numeric items in the given dictionary, including nested dictionaries.\"\"\"\n    request = SumRequest(data)\n    validator = Validator()\n    repository = SumRepository()\n    service = SumService(validator, repository)\n    result = service.sum(request)\n    return result.total"}
{"task_id": "Mbpp/797", "solution": "def sum_in_range(l, r):\n    \"\"\"\n    Finds the sum of all odd natural numbers within the inclusive range l and r.\n    Natural numbers are positive integers (1, 2, 3, ...).\n    \"\"\"\n    if l > r:\n        return 0\n\n    # Natural numbers start from 1. Adjust 'l' if it's less than 1.\n    l_adjusted = max(1, l)\n\n    # Ensure inputs are integers (if floats provided, treat them as ints if exact)\n    # If non-integers (like 3.5) are passed, convert to int by truncation to keep behavior simple.\n    try:\n        if isinstance(l_adjusted, float):\n            if not l_adjusted.is_integer():\n                l_adjusted = int(l_adjusted)\n            else:\n                l_adjusted = int(l_adjusted)\n        if isinstance(r, float):\n            if not r.is_integer():\n                r = int(r)\n            else:\n                r = int(r)\n    except Exception:\n        # Fallback: attempt to convert to int\n        try:\n            l_adjusted = int(l_adjusted)\n            r = int(r)\n        except Exception:\n            return 0\n\n    # Find the first odd natural number in the adjusted range\n    first_odd = l_adjusted if l_adjusted % 2 != 0 else l_adjusted + 1\n\n    # Find the last odd natural number in the range\n    last_odd = r if r % 2 != 0 else r - 1\n\n    # If the calculated first_odd is greater than last_odd, there are no odd numbers in the range.\n    if first_odd > last_odd:\n        return 0\n\n    # Calculate the number of terms (odd numbers) in the arithmetic progression.\n    # The common difference is 2.\n    count = (last_odd - first_odd) // 2 + 1\n\n    # Calculate the sum of the arithmetic series: n * (a_1 + a_n) / 2\n    total_sum = count * (first_odd + last_odd) // 2\n\n    return total_sum"}
