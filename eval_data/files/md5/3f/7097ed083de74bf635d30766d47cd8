{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Computes the Bell number B(n), representing the number of ways to partition a set of n elements.\n    Uses the Bell triangle (Aitken's array) algorithm.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Initialize the Bell triangle with B(0) = 1\n    # 'triangle' will store rows, where triangle[i] is the i-th row (0-indexed).\n    # The first element of triangle[k] will be the Bell number B(k).\n    triangle = [[1]]\n\n    # Build the triangle up to the n-th row\n    for i in range(1, n + 1):\n        # The first element of the current row is the last element of the previous row.\n        row = [triangle[i-1][-1]]\n        # Subsequent elements are the sum of the element to their left in the current row\n        # and the element directly above them in the previous row.\n        for j in range(1, i + 1):\n            row.append(row[j-1] + triangle[i-1][j-1])\n        triangle.append(row)\n\n    # The Bell number B(n) is the first element of the n-th row (0-indexed) in the triangle.\n    return triangle[n][0]"}
{"task_id": "Mbpp/70", "solution": "import collections.abc\nfrom typing import Iterable, Tuple, Any, Iterator\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for input validation errors.\"\"\"\n    pass\n\ndef _is_sequence(value: Any) -> bool:\n    \"\"\"\n    Returns True if value is an instance of collections.abc.Sequence but not str/bytes.\n    \"\"\"\n    return isinstance(value, collections.abc.Sequence) and not isinstance(value, (str, bytes))\n\ndef _to_tuple(value: Any) -> Tuple[Any, ...]:\n    \"\"\"\n    If value is a tuple, return unchanged; if a sequence, convert to tuple; else raise ValidationError.\n    \"\"\"\n    if isinstance(value, tuple):\n        return value\n    if _is_sequence(value):\n        return tuple(value)\n    raise ValidationError(f\"Value is not a sequence and cannot be converted to a tuple: {value!r}\")\n\ndef _validate_iterable(value: Any) -> Iterable[Any]:\n    \"\"\"\n    Ensure value is iterable; otherwise raise ValidationError.\n    \"\"\"\n    try:\n        iter(value)\n        return value\n    except TypeError:\n        raise ValidationError(\"Input is not iterable\")\n\ndef _validate_and_normalize_elements(iterable: Iterable[Any], allow_sequences: bool=False) -> Iterator[Tuple[Any, ...]]:\n    \"\"\"\n    Yields validated and normalized tuple elements from the iterable.\n    \"\"\"\n    for idx, item in enumerate(iterable):\n        if isinstance(item, tuple):\n            yield item\n        elif allow_sequences:\n            try:\n                yield _to_tuple(item)\n            except ValidationError as e:\n                raise ValidationError(f\"Element at index {idx} failed conversion to tuple: {item!r} ({e})\") from e\n        else:\n            raise ValidationError(f\"Element at index {idx} is not a tuple: {item!r}\")\n\ndef get_equal(tuples: Iterable[Any], *, allow_sequences: bool = False, empty_is_equal: bool = True) -> bool:\n    \"\"\"\n    Finds whether all the given tuples in an iterable have equal length or not.\n    \"\"\"\n    _validate_iterable(tuples)\n    normalized_tuples_iterator = _validate_and_normalize_elements(tuples, allow_sequences)\n\n    it = iter(normalized_tuples_iterator)\n\n    try:\n        first = next(it)\n    except StopIteration:\n        return empty_is_equal\n\n    first_len = len(first)\n\n    if any(len(t) != first_len for t in it):\n        return False\n\n    return True"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(haystack, needle):\n    \"\"\"\n    Checks if a list contains the given sublist contiguously using a naive search algorithm.\n    An empty needle is considered a sublist.\n    \"\"\"\n    if not needle:\n        return True\n\n    n = len(haystack)\n    m = len(needle)\n\n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        j = 0\n        while j < m and haystack[i + j] == needle[j]:\n            j += 1\n        if j == m:\n            return True\n    return False"}
{"task_id": "Mbpp/68", "solution": "import collections.abc\n\ndef is_Monotonic(arr: collections.abc.Sequence) -> bool:\n    \"\"\"\n    Checks if an array is monotonic (either non-increasing or non-decreasing).\n    An empty array or a single-element array is considered monotonic.\n    \"\"\"\n    if len(arr) <= 2:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i - 1]:\n            is_increasing = False\n        if arr[i] > arr[i - 1]:\n            is_decreasing = False\n        \n        # If it's neither increasing nor decreasing, it's not monotonic\n        if not is_increasing and not is_decreasing:\n            return False\n            \n    return True"}
