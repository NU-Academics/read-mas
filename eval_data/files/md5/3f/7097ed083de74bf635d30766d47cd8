{"task_id": "Mbpp/9", "solution": "def compute_lps(s: str) -> list[int]:\n    \"\"\"Computes the Longest Proper Prefix which is also a Suffix (LPS) array for a string.\"\"\"\n    n = len(s)\n    lps = [0] * n\n    length = 0\n    i = 1\n    while i < n:\n        if s[i] == s[length]:\n            length += 1\n            lps[i] = length\n            i += 1\n        else:\n            if length != 0:\n                length = lps[length - 1]\n            else:\n                lps[i] = 0\n                i += 1\n    return lps\n\ndef find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    Uses the Knuth-Morris-Pratt (KMP) algorithm's LPS array to find the string's smallest period.\n    \"\"\"\n    n = len(s)\n    \n    # Per instructions, assuming valid non-empty string input.\n    # The LPS array is used to find the length of the smallest repeating unit (period).\n    lps = compute_lps(s)\n    \n    # The length of the smallest repeating unit (period) is n - lps[n-1].\n    # This value represents the length of the shortest string 'p' such that s can be\n    # written as 'p' concatenated with itself multiple times (e.g., \"abab\" has period \"ab\", length 2).\n    period = n - lps[n - 1]\n    \n    # If the string length is perfectly divisible by this period,\n    # then 'period' is the minimum rotation. Otherwise, the string itself is primitive,\n    # and the minimum rotation is its full length, 'n'.\n    if n % period == 0:\n        return period\n    else:\n        return n"}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(n: int) -> bool:\n    \"\"\"\n    Identifies if a number is not prime (is composite or an edge case like 0, 1, or negative).\n    \"\"\"\n    # Business rule: Negative integers are treated as non-prime.\n    if n < 0:\n        return True\n\n    # Business rules: 0 and 1 are non-prime.\n    if n <= 1:\n        return True\n\n    # 2 is a prime number, so it is NOT non-prime.\n    if n == 2:\n        return False\n\n    # 3 is a prime number, so it is NOT non-prime.\n    if n == 3:\n        return False\n\n    # All even numbers greater than 2, and all multiples of 3 greater than 3, are non-prime.\n    if n % 2 == 0 or n % 3 == 0:\n        return True\n\n    # Optimized trial division for numbers greater than 3 not divisible by 2 or 3.\n    # Check for factors of the form 6k \u00b1 1 up to sqrt(n).\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            # If a factor is found, n is composite (non-prime).\n            return True\n        i += 6\n\n    # If no factors were found, n is a prime number. Thus, it is NOT non-prime.\n    return False"}
{"task_id": "Mbpp/7", "solution": "import re\n\ndef find_char_long(text):\n    \"\"\"\n    Finds all words in a string that are at least 4 characters long.\n    Words are considered alphanumeric sequences, preserving their original casing.\n    \"\"\"\n    min_length = 4\n    # Regex to find sequences of alphanumeric characters.\n    # This acts as the tokenizer, extracting \"words\" and handling punctuation removal implicitly.\n    word_pattern = r\"[A-Za-z0-9]+\"\n\n    tokens = re.findall(word_pattern, text)\n    long_words = set()\n\n    for word in tokens:\n        # Apply cleaning (stripping whitespace) as per TextNormalizer's default behavior\n        # when preserve_case is True. The word_pattern already handles external punctuation.\n        cleaned_word = word.strip()\n        if len(cleaned_word) >= min_length:\n            long_words.add(cleaned_word)\n\n    return long_words"}
