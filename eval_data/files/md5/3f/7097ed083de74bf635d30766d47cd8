{"task_id": "Mbpp/71", "solution": "from typing import List, Any, Optional, Callable, Iterable\nfrom dataclasses import dataclass\n\nclass SortError(Exception):\n    pass\n\nclass SortInputError(SortError):\n    pass\n\nclass InvalidParameterError(SortError):\n    pass\n\n@dataclass\nclass SortResult:\n    items: List[Any]\n    comparisons: int\n    swaps: int\n\n    def to_list(self) -> List[Any]:\n        return self.items[:]\n\ndef is_iterable(obj: Any) -> bool:\n    \"\"\"Checks if an object is iterable.\"\"\"\n    try:\n        iter(obj)\n        return True\n    except TypeError:\n        return False\n\nclass Validator:\n    \"\"\"Validates input parameters.\"\"\"\n    def validate_iterable(self, obj: Any) -> None:\n        if not is_iterable(obj):\n            raise SortInputError(\"Provided object is not iterable\")\n\nclass ListAdapter:\n    \"\"\"Adapts various iterables to mutable lists.\"\"\"\n    def adapt(self, seq: Iterable[Any]) -> List[Any]:\n        try:\n            return list(seq)\n        except TypeError as e:\n            raise SortInputError(\"Input is not iterable\") from e\n\n    def clone(self, seq: Iterable[Any]) -> List[Any]:\n        return self.adapt(seq)[:]\n\nDEFAULT_SHRINK = 1.3\n\nclass CombSorter:\n    \"\"\"Implements the Comb Sort algorithm.\"\"\"\n    def __init__(self, gap_shrink: float = DEFAULT_SHRINK) -> None:\n        if gap_shrink <= 1.0:\n            raise InvalidParameterError(\"gap_shrink must be > 1.0\")\n        self._gap_shrink = gap_shrink\n        self._comparisons = 0\n        self._swaps = 0\n\n    def _next_gap(self, gap: int) -> int:\n        next_g = int(gap / self._gap_shrink)\n        return max(1, next_g)\n\n    def sort(self, items: List[Any], key: Optional[Callable[[Any], Any]] = None, reverse: bool = False) -> SortResult:\n        a = items[:]\n        n = len(a)\n        gap = n\n        swapped = True\n        self._comparisons = 0\n        self._swaps = 0\n        while gap != 1 or swapped:\n            gap = self._next_gap(gap)\n            swapped = False\n            for i in range(0, n - gap):\n                self._comparisons += 1\n                left = a[i] if key is None else key(a[i])\n                right = a[i + gap] if key is None else key(a[i + gap])\n                if (left > right) ^ reverse:\n                    a[i], a[i + gap] = a[i + gap], a[i]\n                    swapped = True\n                    self._swaps += 1\n        return SortResult(items=a, comparisons=self._comparisons, swaps=self._swaps)\n\ndef comb_sort(seq: Iterable[Any], key: Optional[Callable[[Any], Any]] = None, reverse: bool = False) -> List[Any]:\n    \"\"\"Sorts a sequence using the Comb Sort algorithm.\"\"\"\n    validator = Validator()\n    adapter = ListAdapter()\n    sorter = CombSorter(gap_shrink=DEFAULT_SHRINK)\n    \n    validator.validate_iterable(seq)\n    items_list = adapter.adapt(seq)\n    \n    result = sorter.sort(items_list, key=key, reverse=reverse)\n    return result.to_list()"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(patterns: list, tokens: list) -> bool:\n    \"\"\"\n    Checks if two sequences follow the same bijective pattern.\n    Assumes inputs are lists of hashable items and handles length mismatch by returning False.\n    \"\"\"\n    if len(patterns) != len(tokens):\n        return False\n\n    pattern_to_token = {}\n    token_to_pattern = {}\n\n    for p, t in zip(patterns, tokens):\n        if p in pattern_to_token:\n            if pattern_to_token[p] != t:\n                return False\n        else:\n            if t in token_to_pattern:\n                return False\n            pattern_to_token[p] = t\n            token_to_pattern[t] = p\n            \n    return True"}
