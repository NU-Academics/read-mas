{"task_id": "Mbpp/16", "solution": "import re\nfrom typing import Optional\n\nclass ValidationError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nPATTERN_STR = r'^[a-z]+_[a-z]+$'\n\nclass RegexUtils:\n    DEFAULT_FLAGS: int = 0\n\n    def compile(self, pattern: str) -> re.Pattern:\n        return re.compile(pattern, self.DEFAULT_FLAGS)\n\n    def safe_match(self, compiled: re.Pattern, s: str) -> bool:\n        if compiled is None:\n            raise ValidationError(\"Compiled regex is missing.\")\n        input_str = str(s) if s is not None else \"\"\n        return bool(compiled.fullmatch(input_str))\n\nclass RegexValidator:\n    def __init__(self, pattern: str, utils: 'RegexUtils') -> None:\n        self._pattern_str = pattern\n        self._utils = utils\n        try:\n            self._compiled = self._utils.compile(pattern)\n        except re.error as e:\n            raise ValidationError(f\"Invalid pattern: {e}\")\n\n    def match(self, s: str) -> bool:\n        return self._utils.safe_match(self._compiled, s)\n\nclass TextValidationService:\n    def __init__(self, validator: 'RegexValidator') -> None:\n        self._validator = validator\n\n    def validate(self, s: Optional[str]) -> bool:\n        if s is None:\n            return False\n        try:\n            return self._validator.match(s)\n        except ValidationError:\n            return False\n\ndef text_lowercase_underscore(s: str) -> bool:\n    \"\"\"\n    Checks if the input string contains sequences of lowercase letters\n    joined with an underscore. Returns True if it matches, False otherwise.\n    \"\"\"\n    utils = RegexUtils()\n    validator = RegexValidator(PATTERN_STR, utils)\n    service = TextValidationService(validator)\n    return service.validate(s)"}
