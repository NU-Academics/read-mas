{"task_id": "Mbpp/75", "solution": "import collections\nimport uuid\nimport json\nfrom typing import Iterable, List, Tuple, Any, Deque, Dict, Optional\n\n# Custom exceptions for clearer error handling\nclass InvalidInputError(Exception):\n    \"\"\"Raised when input tuples or their elements are invalid.\"\"\"\n    pass\n\nclass InvalidKError(Exception):\n    \"\"\"Raised when the divisor k is invalid.\"\"\"\n    pass\n\n# DTOs (Data Transfer Objects)\nclass FilterRequest:\n    \"\"\"DTO for the filter request.\"\"\"\n    def __init__(self, tuples: List[Tuple[int, ...]], k: int) -> None:\n        self.tuples = tuples\n        self.k = k\n\nclass FilterResult:\n    \"\"\"DTO for the filter result.\"\"\"\n    def __init__(self, results: List[Tuple[int, ...]]) -> None:\n        self.results = results\n\n# Validators\ndef validate_k(k: Any) -> None:\n    \"\"\"Validates that k is a non-zero integer.\"\"\"\n    if not isinstance(k, int):\n        raise InvalidKError(\"k must be an integer\")\n    if k == 0:\n        raise InvalidKError(\"k cannot be zero\")\n\ndef validate_tuples(tuples: Iterable[Any]) -> List[Tuple[int, ...]]:\n    \"\"\"Validates that all items are tuples/lists of integers and converts to tuples.\"\"\"\n    result = []\n    for item in tuples:\n        if isinstance(item, list):\n            item = tuple(item)\n        if not isinstance(item, tuple):\n            raise InvalidInputError(\"Each item must be a tuple or list of integers\")\n        if not all(isinstance(x, int) for x in item):\n            raise InvalidInputError(\"Tuple elements must all be integers\")\n        result.append(item)\n    return result\n\n# Repository (Protocol/ABC for interface not used for direct impl here)\nclass InMemoryTupleRepository:\n    \"\"\"In-memory repository to store recent query metadata.\"\"\"\n    def __init__(self, capacity: int = 100) -> None:\n        self.capacity: int = capacity\n        self.store: Deque[Dict[str, Any]] = collections.deque(maxlen=capacity)\n\n    def save_query(self, request: FilterRequest, result: FilterResult) -> None:\n        \"\"\"Saves a query request and its result to the in-memory store.\"\"\"\n        query_id = str(uuid.uuid4())\n        timestamp = uuid.datetime.datetime.now().isoformat()\n        self.store.append({\n            \"id\": query_id,\n            \"timestamp\": timestamp,\n            \"request\": {\"tuples\": [list(t) for t in request.tuples], \"k\": request.k},\n            \"result\": {\"results\": [list(t) for t in result.results]}\n        })\n\n    def list_queries(self) -> List[Dict[str, Any]]:\n        \"\"\"Lists all stored queries.\"\"\"\n        return list(self.store)\n\n# Service\nclass TupleFilterService:\n    \"\"\"Core business logic for filtering tuples.\"\"\"\n    def __init__(self, repository: InMemoryTupleRepository) -> None:\n        self.repository = repository\n\n    def filter(self, tuples: Iterable[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n        \"\"\"\n        Filters a list of tuples, returning only those where all elements are divisible by k.\n        Validates inputs and records the query.\n        \"\"\"\n        validated_tuples = validate_tuples(tuples)\n        validate_k(k)\n\n        filtered_result = []\n        for t in validated_tuples:\n            if all(x % k == 0 for x in t):\n                filtered_result.append(t)\n        \n        # Persist metadata, suppressing repository failures to ensure filter returns results\n        try:\n            self.repository.save_query(FilterRequest(validated_tuples, k), FilterResult(filtered_result))\n        except Exception:\n            pass # Log this in a real application\n            \n        return filtered_result\n\n# Module-level function as required, delegating to the service\n_default_repository = InMemoryTupleRepository()\n_default_service = TupleFilterService(_default_repository)\n\ndef find_tuples(list_of_tuples: List[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n    \"\"\"\n    Finds tuples where all elements are divisible by k from the given list of tuples.\n    This function uses a default service instance for convenience.\n    \"\"\"\n    return _default_service.filter(list_of_tuples, k)"}
{"task_id": "Mbpp/77", "solution": "def is_Diff(n):\n    \"\"\"\n    Checks if a number is divisible by 11 using the alternating sum of its digits.\n    The sum of digits at even positions (from the right) minus the sum of digits\n    at odd positions (from the right) must be divisible by 11.\n    \"\"\"\n    num_str = str(abs(n))\n    alternating_sum = 0\n    for i, digit_char in enumerate(reversed(num_str)):\n        digit = int(digit_char)\n        if i % 2 == 0:  # Digits at even positions from the right (0, 2, 4...) are added\n            alternating_sum += digit\n        else:  # Digits at odd positions from the right (1, 3, 5...) are subtracted\n            alternating_sum -= digit\n            \n    return alternating_sum % 11 == 0"}
{"task_id": "Mbpp/82", "solution": "import math\n\ndef volume_sphere(radius: float) -> float:\n    \"\"\"\n    Calculates the volume of a sphere given its radius.\n    Assumes radius is a non-negative numeric value.\n    \"\"\"\n    return (4.0 / 3.0) * math.pi * (radius ** 3)"}
{"task_id": "Mbpp/80", "solution": "class InvalidParameterError(Exception):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass TetrahedralResult:\n    \"\"\"Data transfer object for a tetrahedral number result.\"\"\"\n    def __init__(self, n: int, value: int) -> None:\n        self.n = n\n        self.value = value\n\n    def to_dict(self) -> dict:\n        \"\"\"Converts the result to a dictionary.\"\"\"\n        return {\"n\": self.n, \"value\": self.value}\n\nclass Validator:\n    \"\"\"Validates input parameters for tetrahedral number computation.\"\"\"\n    MAX_N = 1_000_000\n\n    def validate_n(self, n) -> int:\n        \"\"\"Ensures n is a valid non-negative integer within limits.\"\"\"\n        try:\n            ni = int(n)\n        except (TypeError, ValueError):\n            raise InvalidParameterError(f\"n must be an integer, got {n!r}\")\n        if ni < 0:\n            raise InvalidParameterError(\"n must be >= 0\")\n        if ni > self.MAX_N:\n            raise InvalidParameterError(f\"n is too large (>{self.MAX_N})\")\n        return ni\n\nclass MathRepository:\n    \"\"\"Provides low-level mathematical helper functions.\"\"\"\n    MAX_SAFE_N = 10_000_000\n\n    def combination(self, n: int, k: int) -> int:\n        \"\"\"Calculates the binomial coefficient C(n, k) using integer arithmetic.\"\"\"\n        if k < 0 or k > n:\n            return 0\n        k = min(k, n - k)\n        numer = 1\n        denom = 1\n        for i in range(1, k + 1):\n            numer *= n - (k - i)\n            denom *= i\n        return numer // denom\n\nclass TetrahedralService:\n    \"\"\"Orchestrates validation and computation of tetrahedral numbers.\"\"\"\n    def __init__(self, repo: MathRepository, validator: Validator) -> None:\n        self._repo = repo\n        self._validator = validator\n\n    def compute(self, n: int) -> TetrahedralResult:\n        \"\"\"Computes the nth tetrahedral number.\"\"\"\n        n_valid = self._validator.validate_n(n)\n        value = self._repo.combination(n_valid + 2, 3)\n        return TetrahedralResult(n_valid, value)\n\nclass TetrahedralController:\n    \"\"\"Provides the public API interface for tetrahedral number functions.\"\"\"\n    def __init__(self, service: TetrahedralService):\n        self._service = service\n\n    def tetrahedral_number(self, n: int) -> int:\n        \"\"\"Returns the nth tetrahedral number as an integer.\"\"\"\n        return self._service.compute(n).value\n\n    def tetrahedral_response(self, n: int) -> dict:\n        \"\"\"Returns the nth tetrahedral number as a dictionary for API responses.\"\"\"\n        res = self._service.compute(n)\n        return res.to_dict()\n\n# Initialize core components\n_repo = MathRepository()\n_validator = Validator()\n_service = TetrahedralService(_repo, _validator)\n_controller = TetrahedralController(_service)\n\ndef tetrahedral_number(n: int) -> int:\n    \"\"\"Calculates the nth tetrahedral number.\n\n    Raises InvalidParameterError for invalid input.\n    \"\"\"\n    return _controller.tetrahedral_number(n)"}
{"task_id": "Mbpp/85", "solution": "import math\n\nclass SurfaceAreaError(Exception):\n    \"\"\"Custom exception for sphere surface area calculation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass SphereModel:\n    \"\"\"Represents a sphere and validates its radius.\"\"\"\n    def __init__(self, radius: float) -> None:\n        self.radius: float = radius\n        self.validate()\n\n    def validate(self) -> None:\n        \"\"\"Ensures the radius is non-negative.\"\"\"\n        if self.radius < 0:\n            raise SurfaceAreaError(\"Radius must be non-negative\")\n\nclass GeometryService:\n    \"\"\"Provides methods for geometry calculations.\"\"\"\n    def surface_area(self, sphere: \"SphereModel\") -> float:\n        \"\"\"Calculates the surface area of a given sphere.\"\"\"\n        radius = sphere.radius\n        return self._area_formula(radius)\n\n    def _area_formula(self, radius: float) -> float:\n        \"\"\"Internal helper to compute the sphere's surface area.\"\"\"\n        return 4.0 * math.pi * radius * radius\n\ndef surfacearea_sphere(radius: float) -> float:\n    \"\"\"Calculates the surface area of a sphere given its radius.\"\"\"\n    sphere = SphereModel(radius)\n    service = GeometryService()\n    return service.surface_area(sphere)"}
{"task_id": "Mbpp/87", "solution": "def merge_dictionaries_three(a: dict, b: dict, c: dict) -> dict:\n    \"\"\"Merges three dictionaries into a single dictionary with precedence a > b > c.\n    Keys from 'a' override keys from 'b' and 'c'; keys from 'b' override keys from 'c'.\n    \"\"\"\n    merged = {}\n    merged.update(c)\n    merged.update(b)\n    merged.update(a)\n    return merged"}
