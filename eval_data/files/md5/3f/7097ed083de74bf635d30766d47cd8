{"task_id": "Mbpp/2", "solution": "import collections\n\ndef similar_elements(a, b):\n    \"\"\"\n    Finds unique shared elements between two iterables, preserving order from the first iterable.\n    Elements must be hashable.\n    \"\"\"\n    seen_in_a = collections.OrderedDict.fromkeys(a)\n    set_b = set(b)\n    \n    result = []\n    for item in seen_in_a:\n        if item in set_b:\n            result.append(item)\n            \n    return result"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(s: str, ch: str) -> str:\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    \"\"\"\n    first_idx = s.find(ch)\n    if first_idx == -1:\n        # Character not found, return original string\n        return s\n    \n    last_idx = s.rfind(ch)\n    \n    if first_idx == last_idx:\n        # Only one occurrence of the character\n        return s[:first_idx] + s[first_idx+1:]\n    else:\n        # Multiple occurrences, remove first and last\n        return s[:first_idx] + s[first_idx+1:last_idx] + s[last_idx+1:]"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(a: int, b: int) -> bool:\n    \"\"\"\n    Checks if two integers differ by exactly one bit.\n    This is true if their XOR result is a power of two.\n    \"\"\"\n    xor_result = a ^ b\n    # A number is a power of two if it's greater than 0 and has only one bit set.\n    # This is equivalent to x > 0 and (x & (x - 1)) == 0.\n    return xor_result > 0 and (xor_result & (xor_result - 1)) == 0"}
{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import List, Iterable, Any, Optional, Protocol\nfrom dataclasses import dataclass\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str, code: int = 400) -> None:\n        super().__init__(message)\n        self.message = message\n        self.code = code\n\n    def __str__(self) -> str:\n        return f\"Error {self.code}: {self.message}\"\n\n@dataclass(frozen=True)\nclass NumberList:\n    \"\"\"A data model holding a validated list of integers.\"\"\"\n    nums: List[int]\n\n    def as_list(self) -> List[int]:\n        \"\"\"Returns a shallow copy of the internal list of integers.\"\"\"\n        return list(self.nums)\n\n@dataclass(frozen=True)\nclass NLargestResult:\n    \"\"\"A data model holding the result of the top-k computation.\"\"\"\n    top_k: List[int]\n\n    def as_list(self) -> List[int]:\n        \"\"\"Returns the list of top-k integers.\"\"\"\n        return self.top_k\n\nMAX_LIST_LENGTH = 10_000_000\n\ndef validate_input(nums: Iterable[Any], n: int) -> NumberList:\n    \"\"\"Validates input parameters for the top-n largest number functions.\"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise InvalidInputError(\"n must be a non-negative integer\")\n    if nums is None:\n        raise InvalidInputError(\"nums must be provided\")\n    try:\n        lst = list(nums)\n    except TypeError:\n        raise InvalidInputError(\"nums must be an iterable\")\n    if len(lst) > MAX_LIST_LENGTH:\n        raise InvalidInputError(f\"nums exceeds maximum supported length of {MAX_LIST_LENGTH}\")\n    for i, x in enumerate(lst):\n        if not isinstance(x, int):\n            raise InvalidInputError(f\"element at index {i} is not an int: {x!r}\")\n    return NumberList(lst)\n\nclass ITopKAdapter(Protocol):\n    \"\"\"Interface for top-k finding algorithms.\"\"\"\n    def find_top_k(self, nums: List[int], k: int) -> List[int]:\n        ...\n\nclass HeapAdapter(ITopKAdapter):\n    \"\"\"Finds top-k elements using a min-heap from the heapq module.\"\"\"\n    def __init__(self) -> None:\n        pass # The heap is ephemeral per call to find_top_k\n\n    def find_top_k(self, nums: List[int], k: int) -> List[int]:\n        if k == 0:\n            return []\n        \n        # If k is larger than or equal to the list length, return all sorted\n        if k >= len(nums):\n            return sorted(nums, reverse=True)\n\n        heap: List[int] = []\n        for x in nums:\n            if len(heap) < k:\n                heapq.heappush(heap, x)\n            else:\n                if x > heap[0]:\n                    heapq.heapreplace(heap, x)\n        return sorted(heap, reverse=True)\n\nclass LargestService:\n    \"\"\"Orchestrates top-k computation using an injected adapter.\"\"\"\n    def __init__(self, adapter: ITopKAdapter) -> None:\n        self._adapter = adapter\n\n    def get_n_largest(self, nums: List[int], n: int) -> NLargestResult:\n        \"\"\"Computes the n largest numbers and returns them in descending order.\"\"\"\n        top_k_list = self._adapter.find_top_k(nums, n)\n        return NLargestResult(top_k_list)\n\ndef heap_queue_largest(nums: Iterable[int], n: int) -> List[int]:\n    \"\"\"\n    Finds the n largest integers from a given list of numbers using a heap,\n    returned in descending order.\n    \"\"\"\n    validated_nums_model = validate_input(nums, n)\n    service = LargestService(adapter=HeapAdapter())\n    result_model = service.get_n_largest(validated_nums_model.as_list(), n)\n    return result_model.as_list()"}
