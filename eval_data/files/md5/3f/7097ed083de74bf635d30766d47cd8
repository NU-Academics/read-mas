{"task_id": "Mbpp/57", "solution": "import collections\n\ndef find_Max_Num(digits):\n    \"\"\"\n    Finds the largest number that can be formed with the given list of digits.\n    This implementation uses a counting sort approach which is efficient for digits 0-9.\n    \"\"\"\n    if not digits:\n        return 0\n\n    # Count occurrences of each digit (0-9)\n    # Using a list of size 10 for counting sort, indices represent digits\n    counts = [0] * 10\n    for digit in digits:\n        counts[digit] += 1\n\n    # Build the largest number by appending digits in descending order\n    result_str = []\n    for d in range(9, -1, -1):  # Iterate from 9 down to 0\n        result_str.append(str(d) * counts[d])\n\n    # Join the parts and convert to integer\n    # int() will handle leading zeros correctly (e.g., \"001\" becomes 1)\n    return int(\"\".join(result_str))"}
{"task_id": "Mbpp/63", "solution": "from typing import Iterable, Tuple, List, Iterator, Any\n\nclass InvalidPairError(ValueError):\n    \"\"\"Raised when an input pair contains non-numeric or invalid values.\"\"\"\n    pass\n\nclass EmptyInputError(ValueError):\n    \"\"\"Raised when the input list of pairs is empty.\"\"\"\n    pass\n\nclass Pair:\n    \"\"\"Represents a pair of numeric values and computes their absolute difference.\"\"\"\n    def __init__(self, a: float, b: float) -> None:\n        self.a: float = float(a)\n        self.b: float = float(b)\n\n    def difference(self) -> float:\n        \"\"\"Calculates the absolute difference between the pair's elements.\"\"\"\n        return abs(self.a - self.b)\n\n    def as_tuple(self) -> Tuple[float, float]:\n        \"\"\"Returns the pair as a tuple of floats.\"\"\"\n        return (self.a, self.b)\n\nclass PairCollection:\n    \"\"\"Manages a collection of Pair objects and computes the maximum difference among them.\"\"\"\n    PAIR_LENGTH: int = 2\n\n    def __init__(self, pairs: Iterable[Tuple[float,float]]) -> None:\n        self._pairs: List[Pair] = []\n        for p in pairs:\n            self._pairs.append(Pair(p[0], p[1]))\n\n    def __iter__(self) -> Iterator[Pair]:\n        \"\"\"Allows iteration over the Pair objects in the collection.\"\"\"\n        return iter(self._pairs)\n\n    def __len__(self) -> int:\n        \"\"\"Returns the number of pairs in the collection.\"\"\"\n        return len(self._pairs)\n\n    def max_difference(self) -> float:\n        \"\"\"Computes the maximum absolute difference among all pairs in the collection.\"\"\"\n        return max(pair.difference() for pair in self._pairs)\n\nclass DifferenceService:\n    \"\"\"Provides the core business logic for computing maximum differences.\"\"\"\n    def __init__(self, repo: Any = None) -> None:\n        self._repo = repo\n\n    def compute_max_difference(self, pairs: Iterable[Tuple[float,float]]) -> float:\n        \"\"\"\n        Computes the maximum absolute difference from an iterable of numeric pairs.\n        \"\"\"\n        collection = PairCollection(pairs)\n        return collection.max_difference()\n\ndef max_difference(pairs: Iterable[Tuple[float,float]]) -> float:\n    \"\"\"\n    Finds the maximum absolute difference between available pairs in the given tuple list.\n    \"\"\"\n    service = DifferenceService()\n    return service.compute_max_difference(pairs)"}
