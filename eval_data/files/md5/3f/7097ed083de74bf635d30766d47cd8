{"task_id": "Mbpp/65", "solution": "class InvalidElementError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nfrom typing import List, Any\n\nclass ListFlattener:\n    SUPPORTED_ALGORITHMS = ['recursive', 'iterative']\n\n    def flatten_recursive(self, lst: list) -> list:\n        result = []\n        for el in lst:\n            if isinstance(el, (list, tuple)):\n                result.extend(self.flatten_recursive(list(el)))\n            else:\n                result.append(el)\n        return result\n\n    def flatten_iterative(self, lst: list) -> list:\n        result = []\n        stack = [lst]\n        while stack:\n            current = stack.pop()\n            for el in reversed(current):\n                if isinstance(el, (list, tuple)):\n                    stack.append(list(el))\n                else:\n                    result.append(el)\n        return result\n\n    def sum_flattened(self, flat: list) -> float:\n        total = 0.0\n        for el in flat:\n            if not isinstance(el, (int, float)):\n                raise InvalidElementError(f\"Non-numeric element: {el!r}\")\n            total += el\n        return total\n\n    def flatten_and_sum(self, lst: list, algorithm: str = 'iterative') -> float:\n        if algorithm == 'recursive':\n            flat = self.flatten_recursive(lst)\n        else:\n            flat = self.flatten_iterative(lst)\n        return self.sum_flattened(flat)\n\nclass RecursiveSumService:\n    def __init__(self, flattener: ListFlattener) -> None:\n        self._flattener = flattener\n\n    def _validate_root(self, data: Any) -> None:\n        if not isinstance(data, (list, tuple)):\n            raise TypeError(\"Root data must be a list or tuple\")\n\n    def sum_list(self, data: Any, algorithm: str = 'auto') -> float:\n        self._validate_root(data)\n        algo = algorithm if algorithm in self._flattener.SUPPORTED_ALGORITHMS else 'iterative'\n        return self._flattener.flatten_and_sum(list(data), algorithm=algo)\n\nDEFAULT_ALGORITHM = \"iterative\"\n\n_flattener = ListFlattener()\n_service = RecursiveSumService(_flattener)\n\ndef recursive_list_sum(lst: object, algorithm: str = DEFAULT_ALGORITHM) -> float:\n    \"\"\"\n    Public API: sum nested lists/tuples of numbers.\n    \"\"\"\n    return _service.sum_list(lst, algorithm=algorithm)"}
