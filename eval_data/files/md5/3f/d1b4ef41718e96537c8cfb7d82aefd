{"task_id": "Mbpp/427", "solution": "class DateString:\n    \"\"\"Encapsulates a date string value and its associated input and output formats.\"\"\"\n    def __init__(self, value: str, input_format: str = \"yyyy-mm-dd\", output_format: str = \"dd-mm-yyyy\"):\n        self.value = value\n        self.input_format = input_format\n        self.output_format = output_format\n\nclass DateFormatConverter:\n    \"\"\"Performs the conversion of a DateString from its input format to its output format.\"\"\"\n    def convert(self, date_string_obj: DateString) -> DateString:\n        # Splits the date string 'yyyy-mm-dd' into year, month, day components.\n        parts = date_string_obj.value.split('-')\n        year, month, day = parts[0], parts[1], parts[2]\n        # Reorders components to 'dd-mm-yyyy' format.\n        converted_value = f\"{day}-{month}-{year}\"\n        # Returns a new DateString object with the converted value.\n        return DateString(converted_value, date_string_obj.output_format, date_string_obj.output_format)\n\ndef change_date_format(date_string: str) -> str:\n    \"\"\"Converts a date string from 'yyyy-mm-dd' to 'dd-mm-yyyy' format.\"\"\"\n    initial_date_obj = DateString(date_string)\n    converter = DateFormatConverter()\n    converted_date_obj = converter.convert(initial_date_obj)\n    return converted_date_obj.value"}
{"task_id": "Mbpp/426", "solution": "class Number:\n    \"\"\"Represents a single integer and determines if it is odd.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def is_odd(self) -> bool:\n        \"\"\"Returns True if the number is odd, False otherwise.\"\"\"\n        return self._value % 2 != 0\n\n    def get_value(self) -> int:\n        \"\"\"Returns the integer value of the Number.\"\"\"\n        return self._value\n\nclass NumberList:\n    \"\"\"Manages a collection of Number objects and provides a method to filter out odd numbers.\"\"\"\n    def __init__(self):\n        self._numbers: list[Number] = []\n\n    def add_number(self, num: int):\n        \"\"\"Adds a new Number object to the list.\"\"\"\n        self._numbers.append(Number(num))\n\n    def get_odd_numbers(self) -> list[int]:\n        \"\"\"Returns a new list containing only the integer values of odd numbers.\"\"\"\n        odd_values = []\n        for number_obj in self._numbers:\n            if number_obj.is_odd():\n                odd_values.append(number_obj.get_value())\n        return odd_values\n\ndef filter_oddnumbers(input_list: list[int]) -> list[int]:\n    \"\"\"Filters odd numbers from a given list of integers.\"\"\"\n    number_list_manager = NumberList()\n    for num in input_list:\n        number_list_manager.add_number(num)\n    return number_list_manager.get_odd_numbers()"}
{"task_id": "Mbpp/428", "solution": "def shell_sort(arr: list[int | float]) -> list[int | float]:\n    \"\"\"Sorts a list of numbers in ascending order using the Shell Sort algorithm.\n\n    Args:\n        arr: The list of numerical elements to be sorted.\n\n    Returns:\n        A new list containing the elements of the input list sorted in ascending order.\n    \"\"\"\n    n = len(arr)\n    gap = n // 2\n\n    while gap > 0:\n        for i in range(gap, n):\n            temp = arr[i]\n            j = i\n            while j >= gap and arr[j - gap] > temp:\n                arr[j] = arr[j - gap]\n                j -= gap\n            arr[j] = temp\n        gap //= 2\n    return arr"}
