{"task_id": "Mbpp/131", "solution": "def reverse_vowels(input_string: str) -> str:\n    def is_vowel(char: str) -> bool:\n        \"\"\"Determines if a given character is a vowel (case-insensitive, 'y' excluded).\"\"\"\n        return char.lower() in 'aeiou'\n\n    if not input_string:\n        return \"\"\n\n    s_list = list(input_string)\n    vowel_indices = []\n    vowels = []\n\n    for i, char in enumerate(s_list):\n        if is_vowel(char):\n            vowel_indices.append(i)\n            vowels.append(char)\n\n    vowels.reverse()\n\n    for i, original_index in enumerate(vowel_indices):\n        s_list[original_index] = vowels[i]\n\n    return \"\".join(s_list)"}
{"task_id": "Mbpp/129", "solution": "from typing import List\n\nclass Matrix:\n    \"\"\"\n    Encapsulates a 2D list and provides methods for calculating sums and validating structure.\n    \"\"\"\n    def __init__(self, elements: List[List[int]]):\n        if not isinstance(elements, list) or not all(isinstance(row, list) for row in elements):\n            raise ValueError(\"Input must be a 2D list.\")\n        if not elements:\n            self._elements = []\n            self._size = 0\n            return\n\n        self._size = len(elements)\n        if not all(len(row) == self._size for row in elements):\n            raise ValueError(\"Matrix must be square (N x N).\")\n        if not all(isinstance(val, int) for row in elements for val in row):\n            raise ValueError(\"Matrix elements must be integers.\")\n\n        self._elements = elements\n\n    def get_element(self, row: int, col: int) -> int:\n        if not (0 <= row < self._size and 0 <= col < self._size):\n            raise IndexError(\"Matrix index out of bounds.\")\n        return self._elements[row][col]\n\n    def get_size(self) -> int:\n        return self._size\n\n    def is_square(self) -> bool:\n        return self._size > 0 and all(len(row) == self._size for row in self._elements)\n\n    def calculate_row_sum(self, row_index: int) -> int:\n        if not (0 <= row_index < self._size):\n            raise IndexError(\"Row index out of bounds.\")\n        return sum(self._elements[row_index])\n\n    def calculate_column_sum(self, col_index: int) -> int:\n        if not (0 <= col_index < self._size):\n            raise IndexError(\"Column index out of bounds.\")\n        return sum(self._elements[i][col_index] for i in range(self._size))\n\n    def calculate_main_diagonal_sum(self) -> int:\n        return sum(self._elements[i][i] for i in range(self._size))\n\n    def calculate_anti_diagonal_sum(self) -> int:\n        return sum(self._elements[i][self._size - 1 - i] for i in range(self._size))\n\nclass MagicSquareValidator:\n    \"\"\"\n    Provides the public interface to validate if a given matrix (2D list) is a magic square.\n    It constructs a Matrix object and uses its methods to perform all necessary sum checks.\n    \"\"\"\n    @staticmethod\n    def isMagicSquare(matrix_elements: List[List[int]]) -> bool:\n        try:\n            matrix = Matrix(matrix_elements)\n        except ValueError: # Handles non-2D list, non-square, non-integer elements\n            return False\n\n        size = matrix.get_size()\n        if size == 0: # Empty matrix cannot be a magic square\n            return False\n\n        expected_sum = matrix.calculate_row_sum(0)\n\n        for i in range(size):\n            if matrix.calculate_row_sum(i) != expected_sum:\n                return False\n\n        for j in range(size):\n            if matrix.calculate_column_sum(j) != expected_sum:\n                return False\n\n        if matrix.calculate_main_diagonal_sum() != expected_sum:\n            return False\n\n        if matrix.calculate_anti_diagonal_sum() != expected_sum:\n            return False\n\n        return True\n\ndef magic_square_test(matrix_elements: List[List[int]]) -> bool:\n    \"\"\"\n    Determines if a given matrix is a magic square.\n    This function delegates the validation call to MagicSquareValidator.isMagicSquare.\n    \"\"\"\n    return MagicSquareValidator.isMagicSquare(matrix_elements)"}
