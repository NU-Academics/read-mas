{"task_id": "Mbpp/91", "solution": "class SubstringChecker:\n    \"\"\"Helper class to encapsulate substring checking logic.\"\"\"\n    def __init__(self):\n        pass\n\n    def check(self, string_list: list[str], search_string: str) -> bool:\n        \"\"\"\n        Iterates through the list of strings to find if the search_string\n        is a substring of any item.\n        \"\"\"\n        for item in string_list:\n            if search_string in item:\n                return True\n        return False\n\ndef find_substring(string_list: list[str], search_string: str) -> bool:\n    \"\"\"\n    Checks if a given string is present as a substring in any of the\n    string values within a provided list.\n    \"\"\"\n    checker = SubstringChecker()\n    return checker.check(string_list, search_string)"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists: list[list]) -> int:\n    \"\"\"\n    Finds the length of the smallest list in a list of lists.\n    Returns 0 if the input list of lists is empty.\n    \"\"\"\n    if not list_of_lists:\n        return 0\n\n    min_length = len(list_of_lists[0])\n\n    for sub_list in list_of_lists[1:]:\n        current_length = len(sub_list)\n        if current_length < min_length:\n            min_length = current_length\n\n    return min_length"}
{"task_id": "Mbpp/96", "solution": "import math\n\ndef divisor(input_integer: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer.\n    The function iterates up to the square root of the input integer to find its divisors.\n    \"\"\"\n    count = 0\n    # Iterate from 1 up to the square root of input_integer (inclusive)\n    for i in range(1, int(math.sqrt(input_integer)) + 1):\n        if input_integer % i == 0:\n            # If i*i == input_integer, then i is a divisor counted once.\n            if i * i == input_integer:\n                count += 1\n            # Otherwise, i and input_integer // i are two distinct divisors.\n            else:\n                count += 2\n    return count"}
{"task_id": "Mbpp/93", "solution": "def power(a, b):\n    \"\"\"\n    Calculates 'a' to the power of 'b' using a simple loop.\n    Assumes positive integer base and exponent.\n    \"\"\"\n    result = 1\n    for _ in range(b):\n        result *= a\n    return result"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(data):\n    \"\"\"\n    Returns the first value of the tuple with the smallest second value.\n    Raises ValueError if the input list is empty.\n    \"\"\"\n    if not data:\n        raise ValueError(\"Input list cannot be empty\")\n\n    min_second_value = data[0][1]\n    result_first_value = data[0][0]\n\n    for first_value, second_value in data[1:]:\n        if second_value < min_second_value:\n            min_second_value = second_value\n            result_first_value = first_value\n            \n    return result_first_value"}
{"task_id": "Mbpp/92", "solution": "def is_undulating(number):\n    \"\"\"\n    Checks if a given number is an undulating number.\n    An undulating number has length >= 3, different first two digits, and subsequent digits matching the digit two positions prior.\n    \"\"\"\n    num_str = str(number)\n\n    if len(num_str) < 3:\n        return False\n\n    if num_str[0] == num_str[1]:\n        return False\n\n    for i in range(2, len(num_str)):\n        if num_str[i] != num_str[i - 2]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"\n    Converts a non-negative decimal integer to its binary string equivalent without leading zeros.\n    The special case of 0 is represented as '0'.\n    \"\"\"\n    if decimal_number == 0:\n        return '0'\n\n    binary_digits = []\n    while decimal_number > 0:\n        remainder = decimal_number % 2\n        binary_digits.append(str(remainder))\n        decimal_number //= 2\n\n    return \"\".join(binary_digits[::-1])"}
{"task_id": "Mbpp/97", "solution": "from typing import List, Any, Dict\nimport collections\n\ndef frequency_lists(input_data: List[List[Any]]) -> Dict[Any, int]:\n    \"\"\"\n    Calculates the frequency of each element in a flattened list of lists.\n    Args:\n        input_data: A list of lists, where inner lists can contain elements of any hashable type.\n    Returns:\n        A dictionary where keys are unique elements and values are their frequencies.\n    \"\"\"\n    flattened_list = [item for sublist in input_data for item in sublist]\n    element_frequencies = collections.Counter(flattened_list)\n    return dict(element_frequencies)"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(input_integer: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome strictly greater than the input integer.\n    \"\"\"\n    def _is_palindrome(num: int) -> bool:\n        \"\"\"Checks if a given integer is a palindrome.\"\"\"\n        s = str(num)\n        return s == s[::-1]\n\n    current_number = input_integer + 1\n    while True:\n        if _is_palindrome(current_number):\n            return current_number\n        current_number += 1"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(numbers: tuple) -> float:\n    \"\"\"\n    Calculates the product of all numbers in a tuple and divides by its length.\n    Returns 0.0 if the input tuple is empty to prevent division by zero.\n    \"\"\"\n    if not numbers:\n        return 0.0\n\n    product = 1.0\n    for num in numbers:\n        product *= num\n\n    return product / len(numbers)"}
{"task_id": "Mbpp/103", "solution": "import math\n\nclass EulerianNumber:\n    \"\"\"\n    Encapsulates the mathematical definition and logic for computing Eulerian numbers.\n    \"\"\"\n    @staticmethod\n    def calculate(n: int, m: int) -> int:\n        \"\"\"\n        Performs the actual mathematical computation of the Eulerian number a(n, m).\n        \"\"\"\n        eulerian_sum = 0\n        for k in range(m + 1):\n            term = ((-1)**k) * math.comb(n + 1, k) * ((m + 1 - k)**n)\n            eulerian_sum += term\n        return eulerian_sum\n\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number a(n, m) by delegating to the EulerianNumber class.\n    \"\"\"\n    return EulerianNumber.calculate(n, m)"}
{"task_id": "Mbpp/104", "solution": "def sort_sublists(input_list_of_lists: list[list[str]]) -> list[list[str]]:\n    \"\"\"\n    Sorts the string elements within each sublist of a given list of lists\n    lexicographically, preserving the order of sublists.\n    \"\"\"\n    sorted_outer_list = []\n    for sublist in input_list_of_lists:\n        sorted_sublist = sorted(sublist)\n        sorted_outer_list.append(sorted_sublist)\n    return sorted_outer_list"}
{"task_id": "Mbpp/102", "solution": "def _capitalize_word(word: str) -> str:\n    \"\"\"\n    Capitalizes the first letter of a single word.\n    \"\"\"\n    if not word:\n        return \"\"\n    return word[0].upper() + word[1:].lower()\n\ndef snake_to_camel(snake_case_string: str) -> str:\n    \"\"\"\n    Converts a snake_case string to a PascalCase string.\n    \"\"\"\n    if not snake_case_string:\n        return \"\"\n\n    words = snake_case_string.split('_')\n    pascal_words = [_capitalize_word(word) for word in words]\n    return \"\".join(pascal_words)"}
