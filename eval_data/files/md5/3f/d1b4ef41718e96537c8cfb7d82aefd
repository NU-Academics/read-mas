{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_string: str) -> str:\n    \"\"\"\n    Inserts spaces into a string before capital letters based on specific rules.\n\n    Args:\n        input_string: The string to process.\n    \"\"\"\n    if not input_string or len(input_string) == 1:\n        return input_string\n\n    output_parts = [input_string[0]]\n\n    for i in range(1, len(input_string)):\n        current_char = input_string[i]\n        prev_char = input_string[i-1]\n\n        # Rule FR2: lowercase followed by uppercase\n        if prev_char.islower() and current_char.isupper():\n            output_parts.append(' ')\n\n        # Rule FR3: uppercase-uppercase-lowercase sequence\n        elif prev_char.isupper() and current_char.isupper() and i + 1 < len(input_string) and input_string[i+1].islower():\n            output_parts.append(' ')\n\n        output_parts.append(current_char)\n\n    final_output = \"\".join(output_parts)\n\n    # Rule FR5: Return original string if no spaces were inserted.\n    if final_output == input_string:\n        return input_string\n    else:\n        return final_output"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"Calculates the nth Jacobsthal number using an iterative approach.\n    J(n) = J(n-1) + 2 * J(n-2) for n > 1, with J(0)=0, J(1)=1.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    else:\n        a, b = 0, 1  # J(0), J(1)\n        for _ in range(2, n + 1):\n            next_j = b + 2 * a\n            a = b\n            b = next_j\n        return b"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr: list) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    Returns True if the array is a min-heap, False otherwise.\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    # Iterate only up to the last parent node\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n and arr[i] > arr[left_child_idx]:\n            return False\n\n        # Check right child\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Finds common elements from three lists where elements appear at the same index.\n    Collects all identified common elements into a new list and returns it.\n    \"\"\"\n    min_length = min(len(list1), len(list2), len(list3))\n    common_elements = []\n\n    for i in range(min_length):\n        if list1[i] == list2[i] and list2[i] == list3[i]:\n            common_elements.append(list1[i])\n\n    return common_elements"}
{"task_id": "Mbpp/753", "solution": "def min_k(data: list[tuple[str, int]], k: int) -> list[tuple[str, int]]:\n    \"\"\"\n    Finds the minimum k records from a list of tuples.\n    It sorts the data based on the integer value and returns the top k elements.\n    \"\"\"\n    # Sort the input 'data' list based on the integer value of each tuple.\n    sorted_data = sorted(data, key=lambda item: item[1])\n\n    # Select the top 'k' elements.\n    return sorted_data[:k]"}
{"task_id": "Mbpp/757", "solution": "import collections\n\ndef count_reverse_pairs(strings: list[str]) -> int:\n    \"\"\"Counts unique reverse string pairs in a list.\n\n    It handles duplicates and ensures that palindromes are not counted as pairs with themselves.\n    \"\"\"\n    pair_count = 0\n    # Use a set to store processed pairs to ensure uniqueness, canonicalizing pairs as frozensets.\n    processed_pairs = set()\n    \n    # Use a Counter to efficiently check for available strings and their counts\n    string_counts = collections.Counter(strings)\n\n    for s1 in strings:\n        if string_counts[s1] == 0:  # Skip if s1 has already been used up as part of a pair\n            continue\n\n        s1_reversed = s1[::-1]\n\n        # A string cannot be its own reverse pair unless it's a palindrome AND its reverse is a different instance in the list.\n        # But per BR2: \"A string can only form a pair with a *different* string that is its reverse. A string cannot pair with itself.\"\n        # This means palindromes (e.g., \"aba\") cannot form a pair with themselves.\n        # So we explicitly check s1 != s1_reversed.\n        # If s1 == s1_reversed, it's a palindrome, and we should NOT count it as a pair with itself.\n        if s1 != s1_reversed and string_counts[s1_reversed] > 0:\n            # Check if this pair (s1, s1_reversed) has already been processed.\n            # Create a canonical representation of the pair (e.g., frozenset ensures order doesn't matter).\n            canonical_pair = frozenset({s1, s1_reversed})\n            if canonical_pair not in processed_pairs:\n                pair_count += 1\n                processed_pairs.add(canonical_pair)\n                \n                # Decrement counts for both strings to mark them as \"used\" in a pair\n                string_counts[s1] -= 1\n                string_counts[s1_reversed] -= 1\n    \n    return pair_count"}
