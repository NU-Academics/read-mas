{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr: list) -> int:\n    \"\"\"\n    Calculates the total number of inversions in the input array.\n\n    An inversion is defined as a pair of indices (i, j) such that i < j\n    and the element at index i is greater than the element at index j (arr[i] > arr[j]).\n    \"\"\"\n    n = len(arr)\n    inv_count = 0\n    for i in range(n):\n        for j in range(i + 1, n):\n            if arr[i] > arr[j]:\n                inv_count += 1\n    return inv_count"}
{"task_id": "Mbpp/299", "solution": "import collections\n\ndef max_aggregate(records: list[tuple[str, int]]) -> tuple[str, int]:\n    \"\"\"\n    Calculates the maximum aggregate score for entities from a list of records.\n    Aggregates scores for each unique entity and returns the entity with the highest total.\n    \"\"\"\n    aggregated_scores = collections.defaultdict(int)\n\n    for name, score in records:\n        aggregated_scores[name] += score\n    \n    # Find the name-score pair with the maximum aggregate score.\n    # Assumes records is not empty based on problem context and assert.\n    max_name, max_score = max(aggregated_scores.items(), key=lambda item: item[1])\n    \n    return (max_name, max_score)"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(input_dictionary: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of dictionaries within the provided input dictionary.\n    An empty dictionary or a flat dictionary has a depth of 1.\n    \"\"\"\n    max_depth = 1\n    for value in input_dictionary.values():\n        if isinstance(value, dict):\n            nested_depth = dict_depth(value)\n            max_depth = max(max_depth, 1 + nested_depth)\n    return max_depth"}
{"task_id": "Mbpp/308", "solution": "from typing import List, Union\n\ndef _calculate_all_products(list1: List[Union[int, float]], list2: List[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\"Calculates all possible products from two input lists.\n    Returns a list containing all possible products.\n    \"\"\"\n    all_products = []\n    for num1 in list1:\n        for num2 in list2:\n            all_products.append(num1 * num2)\n    return all_products\n\ndef _get_k_largest_and_sort(all_products: List[Union[int, float]], k: int) -> List[Union[int, float]]:\n    \"\"\"Identifies the k largest products and sorts them in descending order.\n    Returns a list of the k largest products, sorted descending.\n    \"\"\"\n    all_products.sort(reverse=True)\n    return all_products[:k]\n\ndef large_product(list1: List[Union[int, float]], list2: List[Union[int, float]], k: int) -> List[Union[int, float]]:\n    \"\"\"Finds the k largest products from two given lists, selecting one factor from each list.\n    Returns a list of the k largest products in descending order.\n    \"\"\"\n    all_products = _calculate_all_products(list1, list2)\n    k_largest_products = _get_k_largest_and_sort(all_products, k)\n    return k_largest_products"}
