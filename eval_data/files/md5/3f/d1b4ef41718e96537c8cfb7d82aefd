{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number.\n\n    Args:\n        n: A non-negative integer.\n\n    Returns:\n        The nth Bell number.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n == 0:\n        return 1\n\n    # Initialize a 2D list for Stirling numbers of the second kind\n    stirling = [[0 for _ in range(n + 1)] for _ in range(n + 1)]\n\n    # Base cases for Stirling numbers\n    stirling[0][0] = 1\n\n    for i in range(1, n + 1):\n        for j in range(1, i + 1):\n            stirling[i][j] = stirling[i - 1][j - 1] + j * stirling[i - 1][j]\n\n    # Bell number B_n is the sum of S(n, k) for k from 0 to n\n    bell = 0\n    for k in range(n + 1):\n        bell += stirling[n][k]\n\n    return bell"}
{"task_id": "Mbpp/607", "solution": "import re\n\ndef find_literals(target_string: str, pattern: str) -> tuple[str, int, int]:\n    \"\"\"\n    Searches a target string for a regex pattern. Returns the matching substring, start index, and end index.\n    If no match is found, returns an empty string and -1 for both indices.\n    \"\"\"\n    match = re.search(pattern, target_string)\n    if match:\n        return match.group(0), match.start(), match.end()\n    else:\n        return '', -1, -1"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list: list, k: int) -> list:\n    \"\"\"\n    Returns a new list with the k'th element (1-based index) removed from the input_list.\n    Raises IndexError if k is out of bounds.\n    \"\"\"\n    if not (1 <= k <= len(input_list)):\n        raise IndexError(\"k is out of bounds for the list\")\n\n    # Python uses 0-based indexing, so the k-th element is at index k-1.\n    return input_list[:k-1] + input_list[k:]"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix: list[list[int]], n: int) -> int:\n    \"\"\"\n    Returns the maximum value of the n'th column in a given matrix.\n    Includes basic input validation for matrix and column index.\n    \"\"\"\n    if not matrix:\n        raise ValueError(\"Matrix cannot be empty.\")\n    if n < 0:\n        raise ValueError(\"Column index 'n' must be non-negative.\")\n\n    column_values = []\n    for row in matrix:\n        if n >= len(row):\n            raise ValueError(f\"Column index {n} is out of bounds for row: {row}\")\n        column_values.append(row[n])\n\n    return max(column_values)"}
