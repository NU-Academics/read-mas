{"task_id": "Mbpp/116", "solution": "def tuple_to_int(input_tuple: tuple[int, ...]) -> int:\n    \"\"\"\n    Converts a tuple of positive integers into a single integer.\n    Concatenates string representations of tuple elements and converts the result to an integer.\n    \"\"\"\n    str_elements = [str(x) for x in input_tuple]\n    concatenated_string = \"\".join(str_elements)\n    return int(concatenated_string)"}
{"task_id": "Mbpp/119", "solution": "def search(arr: list[int]) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array.\n    The array has exactly one unique element, with all others appearing an even number of times.\n    \"\"\"\n    left, right = 0, len(arr) - 1\n\n    while left < right:\n        mid = (left + right) // 2\n        \n        # If mid is odd, make it even to ensure pairs are compared correctly\n        if mid % 2 == 1:\n            mid -= 1\n        \n        # Check if the pair at mid and mid+1 are different\n        if arr[mid] == arr[mid + 1]:\n            left = mid + 2 # The unique element is to the right\n        else:\n            right = mid # The unique element is at or to the left of mid\n\n    return arr[left]"}
{"task_id": "Mbpp/125", "solution": "def find_length(binary_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s in any substring of the given binary string.\n    The difference is calculated as (count of '0's - count of '1's).\n    \"\"\"\n    max_difference = -float('inf')\n\n    # Input validation as per BR1, raising ValueError for invalid characters\n    if not all(c in '01' for c in binary_string):\n        raise ValueError(\"Input string must contain only '0's and '1's.\")\n\n    # Edge case for empty string\n    if not binary_string:\n        return 0 # Or -1, depending on problem specific handling for empty string difference\n\n    n = len(binary_string)\n\n    # Iterate through all possible start indices (FR2, BR3)\n    for i in range(n):\n        # Iterate through all possible end indices (j >= i)\n        for j in range(i, n):\n            substring = binary_string[i:j+1]\n            \n            # Count '0's and '1's (FR2, BR2)\n            count_zeros = substring.count('0')\n            count_ones = substring.count('1')\n            \n            current_difference = count_zeros - count_ones\n            \n            # Update max_difference (FR3, BR4)\n            if current_difference > max_difference:\n                max_difference = current_difference\n                \n    return max_difference"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(input_list: list) -> int | float:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    Initializes the maximum absolute product to 0 and updates it during iteration.\n    \"\"\"\n    max_absolute_product = 0\n\n    for a, b in input_list:\n        current_product = a * b\n        current_absolute_product = abs(current_product)\n        if current_absolute_product > max_absolute_product:\n            max_absolute_product = current_absolute_product\n\n    return max_absolute_product"}
