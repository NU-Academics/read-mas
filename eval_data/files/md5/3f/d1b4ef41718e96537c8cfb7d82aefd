{"task_id": "Mbpp/415", "solution": "def max_Product(arr: list[int]) -> tuple[int, int] | None:\n    \"\"\"\n    Finds the pair of integers with the highest product from a given array.\n    Handles cases with negative numbers and insufficient input.\n    \"\"\"\n    if len(arr) < 2:\n        return None\n\n    arr.sort()\n\n    # Product of the two largest numbers\n    product1 = arr[-1] * arr[-2]\n    # Product of the two smallest numbers (can be largest if both are negative)\n    product2 = arr[0] * arr[1]\n\n    if product1 > product2:\n        return (arr[-2], arr[-1])\n    else:\n        return (arr[0], arr[1])"}
{"task_id": "Mbpp/418", "solution": "def Find_Max(input_list_of_lists: list[list]) -> list:\n    \"\"\"Finds the element (sub-list) with the maximum length from a list of lists.\n    Returns one of the elements if multiple have the same maximum length.\"\"\"\n    \n    max_element = None\n    max_length = -1 \n\n    for sub_list in input_list_of_lists:\n        current_length = len(sub_list)\n        if current_length > max_length:\n            max_length = current_length\n            max_element = sub_list\n    \n    return max_element"}
{"task_id": "Mbpp/419", "solution": "import math\n\ndef round_and_sum(numbers: list[float]) -> int:\n    \"\"\"\n    Rounds each number in the list (halves up), sums them, and multiplies the sum by the list length.\n    Returns the final product as an integer.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    def _round_number(number: float) -> int:\n        if number >= 0:\n            return math.floor(number + 0.5)\n        else:\n            return math.ceil(number - 0.5)\n\n    rounded_numbers = [_round_number(num) for num in numbers]\n    sum_of_rounded = sum(rounded_numbers)\n    count_of_numbers = len(numbers)\n\n    return sum_of_rounded * count_of_numbers"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the cubes of the first 'n' even natural numbers.\n    Assumes n is a positive integer (n >= 1).\n    \"\"\"\n    sum_cubes = 0\n    for i in range(1, n + 1):\n        even_number = 2 * i\n        sum_cubes += even_number ** 3\n    return sum_cubes"}
{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n):\n    \"\"\"\n    Calculates the average of the cubes of the first n natural numbers.\n    \"\"\"\n    sum_of_cubes = 0\n    for i in range(1, n + 1):\n        sum_of_cubes += i ** 3\n    return sum_of_cubes / n"}
