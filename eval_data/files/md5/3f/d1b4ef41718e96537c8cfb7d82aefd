{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_lists: list[list]) -> set:\n    \"\"\"\n    Finds common elements in a list of lists.\n    Returns a set containing the elements that are common to all inner lists.\n    \"\"\"\n    if not nested_lists:\n        return set()\n\n    common_elements = set(nested_lists[0])\n\n    if len(nested_lists) == 1:\n        return common_elements\n\n    for sublist in nested_lists[1:]:\n        if not common_elements:\n            return set()\n        common_elements.intersection_update(sublist)\n\n    return common_elements"}
{"task_id": "Mbpp/113", "solution": "def check_integer(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string represents a valid integer, handling optional leading signs.\n    An empty string or a string with only a sign is not considered a valid integer.\n    \"\"\"\n    if not input_string:\n        return False\n\n    start_index = 0\n    if input_string[0] == '-' or input_string[0] == '+':\n        start_index = 1\n\n    # If the string is just a sign, or a sign followed by nothing\n    if start_index >= len(input_string):\n        return False\n\n    # All characters from start_index onwards must be digits\n    for i in range(start_index, len(input_string)):\n        if not '0' <= input_string[i] <= '9':\n            return False\n\n    return True"}
{"task_id": "Mbpp/109", "solution": "class BinaryString:\n    \"\"\"Manages a binary string, providing methods for rotation and conversion to decimal.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def rotate(self) -> 'BinaryString':\n        \"\"\"Performs a left rotation and returns a new BinaryString instance.\"\"\"\n        if not self._value:\n            return BinaryString(\"\")\n        rotated_value = self._value[1:] + self._value[0]\n        return BinaryString(rotated_value)\n\n    def to_decimal(self) -> 'DecimalEquivalent':\n        \"\"\"Converts the binary string to its decimal equivalent.\"\"\"\n        if not self._value:\n            return DecimalEquivalent(0)\n        return DecimalEquivalent(int(self._value, 2))\n\nclass DecimalEquivalent:\n    \"\"\"Encapsulates a decimal integer and provides a method to check if it's odd.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the decimal value is odd.\"\"\"\n        return self._value % 2 != 0\n\nclass OddCount:\n    \"\"\"Maintains and increments a count of odd numbers.\"\"\"\n    def __init__(self):\n        self._value = 0\n\n    def increment(self):\n        \"\"\"Increments the count by 1.\"\"\"\n        self._value += 1\n\n    def get_count(self) -> int:\n        \"\"\"Returns the current total count.\"\"\"\n        return self._value\n\ndef odd_Equivalent(binary_string: str, rotation_count: int) -> int:\n    \"\"\"Calculates the number of odd decimal equivalents after specified rotations.\"\"\"\n    odd_counter = OddCount()\n    current_bs = BinaryString(binary_string)\n\n    for _ in range(rotation_count):\n        decimal_eq_instance = current_bs.to_decimal()\n        if decimal_eq_instance.is_odd():\n            odd_counter.increment()\n        current_bs = current_bs.rotate()\n        \n    return odd_counter.get_count()"}
