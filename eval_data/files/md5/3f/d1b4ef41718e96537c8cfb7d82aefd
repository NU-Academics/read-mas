{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip_address_string: str) -> str:\n    \"\"\"Removes leading zeros from each octet of an IP address string.\"\"\"\n\n    def _split_ip_into_octets(ip_address_string: str) -> list[str]:\n        \"\"\"Splits an IP address string into a list of octet strings.\"\"\"\n        return ip_address_string.split('.')\n\n    def _remove_leading_zeros_from_octet(octet_string: str) -> str:\n        \"\"\"Removes leading zeros from a single octet string.\"\"\"\n        return str(int(octet_string))\n\n    def _reconstruct_ip_from_octets(octets: list[str]) -> str:\n        \"\"\"Joins a list of processed octet strings back into a full IP address string.\"\"\"\n        return \".\".join(octets)\n\n    octets = _split_ip_into_octets(ip_address_string)\n    processed_octets = [_remove_leading_zeros_from_octet(octet) for octet in octets]\n    return _reconstruct_ip_from_octets(processed_octets)"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers: list) -> int | None:\n    \"\"\"\n    Finds the difference of the first even and first odd number in a given list.\n    Returns None if either number is not found.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n\n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is not None and first_odd is not None:\n        return first_even - first_odd\n    else:\n        return None"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n):\n    \"\"\"Calculates the sum and average of the first 'n' natural numbers.\"\"\"\n    total_sum = n * (n + 1) // 2\n    average = total_sum / n\n    return (total_sum, average)"}
{"task_id": "Mbpp/597", "solution": "def find_kth(arr1: list, arr2: list, k: int):\n    \"\"\"\n    Finds the k-th smallest element from two given sorted arrays.\n    Uses a two-pointer approach to iterate through elements until the k-th element is found.\n    \"\"\"\n    ptr1, ptr2 = 0, 0\n    current_k_count = 0\n    kth_element = None\n\n    while current_k_count < k:\n        if ptr1 < len(arr1) and ptr2 < len(arr2):\n            if arr1[ptr1] <= arr2[ptr2]:\n                kth_element = arr1[ptr1]\n                ptr1 += 1\n            else:\n                kth_element = arr2[ptr2]\n                ptr2 += 1\n        elif ptr1 < len(arr1):  # arr2 is exhausted, take from arr1\n            kth_element = arr1[ptr1]\n            ptr1 += 1\n        elif ptr2 < len(arr2):  # arr1 is exhausted, take from arr2\n            kth_element = arr2[ptr2]\n            ptr2 += 1\n        current_k_count += 1\n\n    return kth_element"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is an Armstrong number.\n    An Armstrong number is the sum of its own digits each raised to the power of the number of digits.\n    \"\"\"\n    if number < 0:\n        return False\n    if number == 0:\n        return True\n\n    num_str = str(number)\n    num_digits = len(num_str)\n    sum_of_powers = 0\n\n    for digit_char in num_str:\n        digit = int(digit_char)\n        sum_of_powers += digit ** num_digits\n\n    return sum_of_powers == number"}
