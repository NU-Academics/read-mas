{"task_id": "Mbpp/590", "solution": "import math\n\nclass PolarCoordinate:\n    \"\"\"Represents a point in polar coordinates (r, theta).\"\"\"\n    def __init__(self, r: float, theta: float):\n        self.r = r\n        self.theta = theta\n\n    def __repr__(self) -> str:\n        return f\"PolarCoordinate(r={self.r}, theta={self.theta})\"\n\nclass RectangularCoordinate:\n    \"\"\"Represents a point in rectangular coordinates (x, y).\"\"\"\n    def __init__(self, x: float, y: float):\n        self.x = x\n        self.y = y\n\n    def __repr__(self) -> str:\n        return f\"RectangularCoordinate(x={self.x}, y={self.y})\"\n\n    def to_tuple(self) -> tuple[float, float]:\n        return (self.x, self.y)\n\nclass CoordinateConverter:\n    \"\"\"Converts polar coordinates to rectangular coordinates.\"\"\"\n    def convert(self, polar: PolarCoordinate) -> RectangularCoordinate:\n        \"\"\"Converts a PolarCoordinate object to a RectangularCoordinate object.\n        \"\"\"\n        x = polar.r * math.cos(polar.theta)\n        y = polar.r * math.sin(polar.theta)\n        return RectangularCoordinate(x, y)\n\ndef polar_rect(r: float, theta: float) -> tuple[float, float]:\n    \"\"\"Converts polar coordinates (r, theta) to rectangular coordinates (x, y).\n    \"\"\"\n    polar_coord = PolarCoordinate(r, theta)\n    converter = CoordinateConverter()\n    rect_coord = converter.convert(polar_coord)\n    return rect_coord.to_tuple()"}
{"task_id": "Mbpp/591", "solution": "def swap_List(input_list: list) -> list:\n    \"\"\"Interchanges the first and last elements of the input list.\n\n    For lists with 0 or 1 element, swapping has no effect or is not possible.\n    \"\"\"\n    if not input_list or len(input_list) < 2:\n        return input_list\n\n    input_list[0], input_list[-1] = input_list[-1], input_list[0]\n    return input_list"}
{"task_id": "Mbpp/592", "solution": "def sum_Of_product(n):\n    \"\"\"\n    Calculates the sum of products of consecutive binomial coefficients for a given non-negative integer n.\n    \"\"\"\n\n    def _factorial(k):\n        \"\"\"\n        Calculates the factorial of a non-negative integer k.\n        \"\"\"\n        if k < 0:\n            raise ValueError(\"Factorial is not defined for negative numbers.\")\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    def _binomial_coefficient(n_val, k_val):\n        \"\"\"\n        Calculates the binomial coefficient C(n, k).\n        \"\"\"\n        if not (0 <= k_val <= n_val):\n            return 0\n        return _factorial(n_val) // (_factorial(k_val) * _factorial(n_val - k_val))\n\n    if n < 0:\n        raise ValueError(\"Input n must be non-negative\")\n    if n == 0:\n        return 0\n\n    coefficients = [_binomial_coefficient(n, k) for k in range(n + 1)]\n\n    total_sum = 0\n    for k in range(n):\n        product = coefficients[k] * coefficients[k+1]\n        total_sum += product\n\n    return total_sum"}
