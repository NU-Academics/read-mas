{"task_id": "Mbpp/7", "solution": "def find_char_long(input_string: str) -> set[str]:\n    \"\"\"\n    Identifies and filters words in a string based on a minimum length of 4 characters.\n    Returns a set of strings, where each string is a word from the input_string\n    that has a length of at least 4 characters.\n    \"\"\"\n    words = input_string.split()\n    filtered_words = set()\n    for word in words:\n        if len(word) >= 4:\n            filtered_words.add(word)\n    return filtered_words"}
{"task_id": "Mbpp/2", "solution": "from typing import Iterable, Any, Set\n\ndef similar_elements(collection1: Iterable[Any], collection2: Iterable[Any]) -> Set[Any]:\n    \"\"\"\n    Finds and returns the unique shared elements between two input collections.\n    :param collection1: The first input collection (e.g., list, tuple).\n    :param collection2: The second input collection (e.g., list, tuple).\n    :return: A set containing elements present in both collection1 and collection2.\n    \"\"\"\n    set1 = set(collection1)\n    set2 = set(collection2)\n    return set1.intersection(set2)"}
{"task_id": "Mbpp/8", "solution": "def square_nums(numbers: list[float | int]) -> list[float | int]:\n    \"\"\"Calculates the square of each number in the input list.\n\n    Args:\n        numbers: A list of numerical values (integers or floats).\n\n    Returns:\n        A new list where each element is the square of the corresponding\n        element from the input list.\n    \"\"\"\n    return [num * num for num in numbers]"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks if the binary representations of two integers differ by exactly one bit.\n    \"\"\"\n    xor_result = num1 ^ num2\n    set_bits_count = bin(xor_result).count('1')\n    return set_bits_count == 1"}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(number: int) -> bool:\n    \"\"\"\n    Identifies if a number is non-prime. Returns True if the number is composite (> 1), False otherwise.\n    \"\"\"\n    if number <= 1:\n        # Numbers less than or equal to 1 are not prime and thus not non-prime.\n        return False\n    if number == 2:\n        # 2 is a prime number, so it is not non-prime.\n        return False\n    if number % 2 == 0:\n        # All even numbers greater than 2 are non-prime.\n        return True\n\n    # Check for odd divisors starting from 3 up to the square root of the number.\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return True  # Found a divisor, so it's non-prime.\n        i += 2\n\n    # If no divisors were found, the number is prime, hence not non-prime.\n    return False"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Calculates the minimum number of rotations (greater than 0) required\n    to get the same string.\n    \"\"\"\n    if not s:\n        return 0\n\n    original_s = s\n    current_s = s\n    \n    for rotations in range(1, len(s) + 1):\n        current_s = current_s[1:] + current_s[0]\n        if current_s == original_s:\n            return rotations\n    \n    return len(s)"}
{"task_id": "Mbpp/4", "solution": "import heapq\n\ndef heap_queue_largest(numbers: list[int], n: int) -> list[int]:\n    \"\"\"Finds the 'n' largest integers from a list and returns them in descending order.\n    If the list has fewer than 'n' elements, all elements are returned.\n    \"\"\"\n    if len(numbers) <= n:\n        return sorted(numbers, reverse=True)\n    \n    return heapq.nlargest(n, numbers)"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string, char_to_remove):\n    \"\"\"Removes the first and last occurrences of a given character from a string.\n    If the character appears only once, that single occurrence is removed.\n    \"\"\"\n    first_index = input_string.find(char_to_remove)\n    last_index = input_string.rfind(char_to_remove)\n\n    if first_index == -1:\n        return input_string\n\n    if first_index == last_index:\n        return input_string[:first_index] + input_string[first_index + 1:]\n    else:\n        temp_string = input_string[:first_index] + input_string[first_index + 1:]\n        \n        # Recalculate last_index on the temp_string for correct removal\n        adjusted_last_index = temp_string.rfind(char_to_remove)\n        \n        return temp_string[:adjusted_last_index] + temp_string[adjusted_last_index + 1:]"}
{"task_id": "Mbpp/12", "solution": "def sort_matrix(matrix):\n    \"\"\"\n    Sorts a given matrix in ascending order based on the sum of its rows.\n    \"\"\"\n    def _calculate_row_sum(row):\n        \"\"\"Calculates the sum of elements for a single row.\"\"\"\n        return sum(row)\n\n    # Sort the matrix using the sum of each row as the key\n    sorted_matrix = sorted(matrix, key=_calculate_row_sum)\n    return sorted_matrix"}
{"task_id": "Mbpp/16", "solution": "import re\n\ndef text_lowercase_underscore(input_string: str) -> bool:\n    \"\"\"\n    Validates if the input string consists of one or more sequences of lowercase letters,\n    where each subsequent sequence is preceded by a single underscore.\n    \"\"\"\n    pattern = r\"^[a-z]+(_[a-z]+)*$\"\n    return re.fullmatch(pattern, input_string) is not None"}
{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(source_string: str, filter_string: str) -> str:\n    \"\"\"\n    Removes characters from the source_string that are present in the filter_string.\n    Preserves the relative order of remaining characters.\n    \"\"\"\n    result_string = []\n    filter_set = set(filter_string) # Use a set for efficient O(1) character lookup\n    for char in source_string:\n        if char not in filter_set:\n            result_string.append(char)\n    return \"\".join(result_string)"}
