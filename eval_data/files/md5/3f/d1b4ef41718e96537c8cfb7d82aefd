{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(\n    student_ids: list[str],\n    student_names: list[str],\n    scores: list[int]\n) -> list[dict[str, dict[str, int]]]:\n    \"\"\"Convert three parallel lists into a list of nested dictionaries.\n\n    Raises:\n        ValueError: If the input lists do not have the same length.\n    \"\"\"\n    if not (len(student_ids) == len(student_names) == len(scores)):\n        raise ValueError(\"All input lists must have the same number of elements.\")\n\n    result = []\n    for i in range(len(student_ids)):\n        student_id = student_ids[i]\n        student_name = student_names[i]\n        score = scores[i]\n        inner_dict = {student_name: score}\n        outer_dict = {student_id: inner_dict}\n        result.append(outer_dict)\n    return result"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    \"\"\"Computes the n'th Lucas number using an iterative approach.\n    Handles base cases L(0)=2, L(1)=1, and L(n)=L(n-1)+L(n-2) for n>1.\n    \"\"\"\n    if n == 0:\n        return 2\n    elif n == 1:\n        return 1\n    else:\n        # Using an iterative approach for efficiency over naive recursion\n        a, b = 2, 1  # L(0), L(1)\n        for _ in range(2, n + 1):\n            a, b = b, a + b\n        return b"}
{"task_id": "Mbpp/394", "solution": "from typing import Any, Tuple\n\ndef check_distinct(tuple_to_check: Tuple[Any, ...]) -> bool:\n    \"\"\"\n    Checks if the given tuple contains no duplicate elements.\n    Returns True if the tuple contains no duplicates, False otherwise.\n    \"\"\"\n    return len(tuple_to_check) == len(set(tuple_to_check))"}
{"task_id": "Mbpp/392", "solution": "_memo = {}\n\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Calculates the maximum sum for a given non-negative integer 'n'\n    using the recursive equation f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n    \"\"\"\n    if n <= 0:\n        return 0\n    if n in _memo:\n        return _memo[n]\n\n    sum_of_parts = (\n        get_max_sum(n // 2) +\n        get_max_sum(n // 3) +\n        get_max_sum(n // 4) +\n        get_max_sum(n // 5)\n    )\n\n    result = max(sum_of_parts, n)\n    _memo[n] = result\n    return result"}
{"task_id": "Mbpp/398", "solution": "from typing import List\n\ndef _calculate_sum_of_digits_for_number(number: int) -> int:\n    \"\"\"Calculates the sum of digits for a single integer.\"\"\"\n    if number == 0:\n        return 0\n    \n    digit_sum = 0\n    # Handle negative numbers by taking absolute value, as sum of digits usually refers to non-negative\n    current_number = abs(number)\n    while current_number > 0:\n        digit = current_number % 10\n        digit_sum += digit\n        current_number //= 10\n    return digit_sum\n\ndef sum_of_digits(numbers: List[int]) -> int:\n    \"\"\"Computes the total sum of digits for each number in a given list.\"\"\"\n    total_sum = 0\n    for num in numbers:\n        total_sum += _calculate_sum_of_digits_for_number(num)\n    return total_sum"}
{"task_id": "Mbpp/395", "solution": "def first_non_repeating_character(input_string: str) -> str | None:\n    \"\"\"\n    Finds the first non-repeated character in a given string.\n\n    This function iterates through the string to count character occurrences\n    and then iterates again to find the first character with a count of one.\n    \"\"\"\n    character_counts = {}\n\n    # First pass: Populate character counts\n    for char in input_string:\n        character_counts[char] = character_counts.get(char, 0) + 1\n\n    # Second pass: Find the first non-repeated character\n    for char in input_string:\n        if character_counts[char] == 1:\n            return char\n\n    # If no non-repeated character is found\n    return None"}
