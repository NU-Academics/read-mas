{"task_id": "Mbpp/612", "solution": "from typing import Any\n\ndef merge(list_of_lists: list[list[Any, Any]]) -> list[list[Any], list[Any]]:\n    \"\"\"\n    Transforms a list of lists into a list of two lists.\n    The first output list contains all first elements from input sublists.\n    The second output list contains all second elements from input sublists.\n    \"\"\"\n    first_elements = []\n    second_elements = []\n    for sublist in list_of_lists:\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/603", "solution": "def _sieve_ludic_numbers(limit: int) -> list[int]:\n    \"\"\"\n    Implements the iterative sieving process to generate ludic numbers up to a specified limit.\n    This function is internal to the module and not intended for direct external use.\n    \"\"\"\n    if limit < 1:\n        return []\n\n    candidates = list(range(1, limit + 1))\n    ludic_list = []\n\n    while candidates:\n        current_ludic = candidates[0]\n        ludic_list.append(current_ludic)\n        candidates.pop(0) # Remove the current ludic number from candidates\n\n        if not candidates: # No more numbers to sieve\n            break\n\n        if current_ludic == 1:\n            # Ludic number 1 just gets added; it does not sieve other numbers by position.\n            continue\n\n        remove_indices = []\n        idx_to_remove = current_ludic - 1 # 0-indexed position based on the current candidates list\n        \n        # Calculate indices to remove from the current 'candidates' list\n        while idx_to_remove < len(candidates):\n            remove_indices.append(idx_to_remove)\n            idx_to_remove += current_ludic\n\n        # Remove elements in reverse order to avoid index shifting issues\n        for idx in reversed(remove_indices):\n            candidates.pop(idx)\n    \n    return ludic_list\n\ndef get_ludic(limit: int) -> list[int]:\n    \"\"\"\n    Calculates and returns a list of all ludic numbers less than or equal to the given limit.\n    \"\"\"\n    return _sieve_ludic_numbers(limit)"}
