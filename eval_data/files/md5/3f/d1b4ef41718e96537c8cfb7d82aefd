{"task_id": "Mbpp/462", "solution": "def combinations_list(input_list: list) -> list[list]:\n    \"\"\"\n    Generates all possible combinations of elements from the input_list.\n    For each element, it prepends the element to existing combinations to form new ones.\n    \"\"\"\n    all_combinations = [[]]\n\n    for current_element in input_list:\n        new_combinations_this_iteration = []\n        for existing_combination in all_combinations:\n            new_combination = [current_element] + existing_combination\n            new_combinations_this_iteration.append(new_combination)\n        all_combinations.extend(new_combinations_this_iteration)\n\n    return all_combinations"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple: tuple) -> tuple:\n    \"\"\"Calculates the pairwise addition of neighboring elements of the given tuple. Returns a new tuple containing the sums.\"\"\"\n    if len(input_tuple) < 2:\n        return ()\n\n    result_list = []\n    for i in range(len(input_tuple) - 1):\n        pair_sum = input_tuple[i] + input_tuple[i+1]\n        result_list.append(pair_sum)\n\n    return tuple(result_list)"}
{"task_id": "Mbpp/471", "solution": "from typing import List\n\ndef find_remainder(array: List[int], n: int) -> int:\n    \"\"\"\n    Computes the product of all elements in an array and returns the result modulo n.\n    The modulo operation is applied at each multiplication to prevent intermediate overflows.\n    \"\"\"\n    if not array:\n        return 1 % n\n\n    current_product = 1\n    for element in array:\n        current_product = (current_product * element) % n\n\n    return current_product"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(nums: list[int]) -> int:\n    \"\"\"\n    Finds the maximum product of a contiguous subarray within the given array.\n    This uses a dynamic programming approach to track both max and min products ending at the current position.\n    \"\"\"\n    if not nums:\n        return 0\n\n    max_so_far = nums[0]\n    min_ending_here = nums[0]\n    max_ending_here = nums[0]\n\n    for i in range(1, len(nums)):\n        num = nums[i]\n        \n        # Store previous max_ending_here because it's needed for min_ending_here calculation\n        # before max_ending_here itself is updated for the current element.\n        temp_max_ending_here = max_ending_here\n\n        # The new max product ending at current position can be current number itself,\n        # or current number multiplied by previous max product, or current number multiplied by previous min product.\n        max_ending_here = max(num, num * temp_max_ending_here, num * min_ending_here)\n\n        # Similarly for the new min product ending at current position.\n        min_ending_here = min(num, num * temp_max_ending_here, num * min_ending_here)\n\n        # Update the overall maximum product found so far.\n        max_so_far = max(max_so_far, max_ending_here)\n\n    return max_so_far"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(numbers: list) -> bool:\n    \"\"\"\n    Checks if the given list contains consecutive numbers.\n    Assumes the input list contains integers or comparable types.\n    \"\"\"\n    if len(numbers) <= 1:\n        return True\n\n    sorted_numbers = sorted(numbers)\n\n    for i in range(1, len(sorted_numbers)):\n        if sorted_numbers[i] != sorted_numbers[i-1] + 1:\n            return False\n    return True"}
{"task_id": "Mbpp/468", "solution": "def max_product(arr: list[int | float]) -> int | float:\n    \"\"\"\n    Calculates the maximum product formed by multiplying numbers of an increasing subsequence within the array.\n    An increasing subsequence is where each subsequent element is strictly greater than the preceding one,\n    and elements appear in the same relative order as in the input array.\n    \"\"\"\n    def _handle_empty_or_single_element_array(arr_param: list[int | float]) -> int | float:\n        \"\"\"Handles edge cases for empty or single-element arrays.\"\"\"\n        if not arr_param:\n            return 0\n        if len(arr_param) == 1:\n            return arr_param[0]\n        return None # Indicates that this is not an edge case handled by this helper\n\n    def _calculate_max_product_dp(arr_param: list[int | float]) -> list[int | float]:\n        \"\"\"\n        Computes an array where each element dp_products[i] stores the maximum product\n        of an increasing subsequence ending at arr_param[i].\n        \"\"\"\n        n = len(arr_param)\n        # Initialize dp_products. Each element arr_param[i] itself is an increasing subsequence\n        # with product arr_param[i].\n        dp_products = list(arr_param)\n\n        for i in range(n):\n            for j in range(i):\n                # If arr_param[i] can extend the increasing subsequence ending at arr_param[j]\n                if arr_param[i] > arr_param[j]:\n                    # Update dp_products[i] if extending the subsequence ending at arr_param[j]\n                    # results in a larger product for a subsequence ending at arr_param[i].\n                    dp_products[i] = max(dp_products[i], dp_products[j] * arr_param[i])\n        return dp_products\n\n    # Main logic of the max_product function\n    edge_case_result = _handle_empty_or_single_element_array(arr)\n    if edge_case_result is not None:\n        return edge_case_result\n\n    dp_products_list = _calculate_max_product_dp(arr)\n    \n    # The maximum product is the largest value found in the dp_products_list.\n    # This correctly handles positive, negative, and zero values.\n    # If dp_products_list is empty (after edge case checks, should not happen), return 0.\n    if not dp_products_list:\n        return 0\n\n    return max(dp_products_list)"}
{"task_id": "Mbpp/473", "solution": "def _canonical_tuple(t: tuple) -> tuple:\n    \"\"\"Converts a tuple to its canonical (sorted) form for order-agnostic comparison.\n    This ensures tuples like (5, 4) and (4, 5) are treated as identical.\"\"\"\n    return tuple(sorted(t))\n\ndef tuple_intersection(list1: list[tuple], list2: list[tuple]) -> set[tuple]:\n    \"\"\"\n    Finds the order-agnostic intersection of elements in two given tuple lists.\n    Tuples are considered equal irrespective of the order of their internal elements.\n    \"\"\"\n    set1_canonical = {_canonical_tuple(t) for t in list1}\n    set2_canonical = {_canonical_tuple(t) for t in list2}\n    return set1_canonical.intersection(set2_canonical)"}
