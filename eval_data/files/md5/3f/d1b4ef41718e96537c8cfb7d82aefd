{"task_id": "Mbpp/733", "solution": "from typing import List\n\ndef find_first_occurrence(sorted_array: List[int], target_number: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array.\n    Returns -1 if the target number is not found.\n    \"\"\"\n    low = 0\n    high = len(sorted_array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if sorted_array[mid] == target_number:\n            result = mid  # Found a potential first occurrence\n            high = mid - 1 # Search in the left half for an earlier one\n        elif sorted_array[mid] < target_number:\n            low = mid + 1\n        else: # sorted_array[mid] > target_number\n            high = mid - 1\n            \n    return result"}
{"task_id": "Mbpp/731", "solution": "import math\n\nclass Cone:\n    def __init__(self, radius: float, height: float):\n        self._radius = float(radius)\n        self._height = float(height)\n\n    def calculateSlantHeight(self) -> float:\n        return math.sqrt(self._radius**2 + self._height**2)\n\n    def calculateLateralSurfaceArea(self) -> float:\n        slant_height = self.calculateSlantHeight()\n        return math.pi * self._radius * slant_height\n\ndef lateralsurface_cone(r: float, h: float) -> float:\n    \"\"\"Calculates the lateral surface area of a cone given radius r and height h.\"\"\"\n    cone = Cone(r, h)\n    return cone.calculateLateralSurfaceArea()"}
