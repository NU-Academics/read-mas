{"task_id": "Mbpp/75", "solution": "import collections\n\n\ndef find_tuples(list_of_tuples, k):\n    \"\"\"Finds tuples where all elements are divisible by k from the given list of tuples.\"\"\"\n    filtered_list = []\n    for current_tuple in list_of_tuples:\n        # Check if all elements in the current tuple are divisible by k\n        all_divisible = True\n        for element in current_tuple:\n            if element % k != 0:\n                all_divisible = False\n                break\n        if all_divisible:\n            filtered_list.append(current_tuple)\n    return filtered_list"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(data: list) -> list:\n    \"\"\"\n    Sorts a list of comparable elements in ascending order using the Comb Sort algorithm.\n    Returns a new sorted list.\n    \"\"\"\n    n = len(data)\n    if n == 0:\n        return []\n\n    # Create a mutable copy of the input list\n    arr = list(data)\n\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        # Calculate the new gap value\n        gap = int(gap / shrink_factor)\n        if gap < 1:\n            gap = 1\n\n        swapped = False\n        # Compare elements with the current gap and swap if out of order\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    return arr"}
{"task_id": "Mbpp/70", "solution": "class ListOfTuples:\n    \"\"\"Encapsulates a list of tuples and provides methods to check their lengths.\"\"\"\n\n    def __init__(self, tuples: list[tuple]):\n        self._tuples = tuples\n\n    def get_length_of_first_tuple(self) -> int:\n        \"\"\"Returns the length of the first tuple in the list.\"\"\"\n        if not self._tuples:\n            raise ValueError(\"Cannot get length of first tuple from an empty list.\")\n        return len(self._tuples[0])\n\n    def are_all_tuple_lengths_equal(self) -> bool:\n        \"\"\"Checks if all tuples in the encapsulated list have the same length.\"\"\"\n        if not self._tuples:\n            return True\n\n        first_tuple_length = self.get_length_of_first_tuple()\n\n        for i in range(1, len(self._tuples)):\n            if len(self._tuples[i]) != first_tuple_length:\n                return False\n\n        return True\n\ndef get_equal(list_of_tuples: list[tuple]) -> bool:\n    \"\"\"Finds whether all the given tuples have equal length or not.\n\n    Returns True if all tuples have equal length or the list is empty, False otherwise.\n    \"\"\"\n    list_of_tuples_obj = ListOfTuples(list_of_tuples)\n    return list_of_tuples_obj.are_all_tuple_lengths_equal()"}
{"task_id": "Mbpp/74", "solution": "class PatternMatcher:\n    def is_same_pattern(self, sequence1: list[str], sequence2: list[str]) -> bool:\n        \"\"\"\n        Determines if two sequences have the same pattern of element repetition and uniqueness.\n        It uses two-way mapping to ensure consistency in the pattern.\n        \"\"\"\n        if len(sequence1) != len(sequence2):\n            return False\n\n        map1 = {}  # Maps elements from sequence1 to sequence2\n        map2 = {}  # Maps elements from sequence2 to sequence1\n\n        for i in range(len(sequence1)):\n            s1_elem = sequence1[i]\n            s2_elem = sequence2[i]\n\n            # Check mapping from sequence1 to sequence2\n            if s1_elem in map1:\n                if map1[s1_elem] != s2_elem:\n                    return False\n            else:\n                map1[s1_elem] = s2_elem\n\n            # Check mapping from sequence2 to sequence1\n            if s2_elem in map2:\n                if map2[s2_elem] != s1_elem:\n                    return False\n            else:\n                map2[s2_elem] = s1_elem\n        \n        return True\n\ndef is_samepatterns(sequence1: list[str], sequence2: list[str]) -> bool:\n    \"\"\"\n    Checks if two sequences follow the same pattern, delegating the comparison logic to PatternMatcher.\n    This function provides a direct interface for pattern comparison.\n    \"\"\"\n    matcher = PatternMatcher()\n    return matcher.is_same_pattern(sequence1, sequence2)"}
{"task_id": "Mbpp/77", "solution": "def is_Diff(number: int) -> bool:\n    \"\"\"\n    Checks if a number is divisible by 11 using the alternating sum of its digits.\n    Returns True if the alternating sum is divisible by 11, False otherwise.\n    \"\"\"\n    num_str = str(number)\n    alternating_sum = 0\n    for i, digit_char in enumerate(num_str):\n        digit = int(digit_char)\n        if i % 2 == 0:\n            alternating_sum += digit\n        else:\n            alternating_sum -= digit\n    return alternating_sum % 11 == 0"}
