{"task_id": "Mbpp/572", "solution": "from collections import Counter\nfrom typing import List\n\ndef two_unique_nums(input_list: List[int]) -> List[int]:\n    \"\"\"\n    Identifies and returns numbers that appear exactly once in an input list,\n    preserving their first appearance order.\n    \"\"\"\n    counts = Counter(input_list)\n\n    result_list = []\n    for num in input_list:\n        if counts[num] == 1:\n            result_list.append(num)\n\n    return result_list"}
{"task_id": "Mbpp/573", "solution": "def unique_product(numbers: list) -> int:\n    \"\"\"\n    Calculates the product of unique numbers in a given list.\n    It converts the list to a set to find unique numbers, then multiplies them.\n    \"\"\"\n    unique_numbers = set(numbers)\n    product = 1\n    for num in unique_numbers:\n        product *= num\n    return product"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Interleaves three input lists of the same length into a single flat list.\n    Raises ValueError if the input lists do not have the same length.\n    \"\"\"\n    len1 = len(list1)\n    len2 = len(list2)\n    len3 = len(list3)\n\n    if not (len1 == len2 == len3):\n        raise ValueError(\"All input lists must have the same length.\")\n\n    result_list = []\n    for i in range(len1):\n        result_list.append(list1[i])\n        result_list.append(list2[i])\n        result_list.append(list3[i])\n\n    return result_list"}
{"task_id": "Mbpp/577", "solution": "```python\ndef last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Calculates the last digit of the factorial of a given non-negative integer.\n    Handles special cases for n < 0, n >= 5, and direct computation for 0 <= n < 5.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Factorial undefined for negative numbers\")\n    elif n >= 5:\n        return 0\n    else:\n        # Precomputed last digits for 0! through 4!\n        # 0! = 1, 1! = 1, 2! = 2, 3! = 6, 4! = 24\n        last_digits = [1, 1, 2, 6, 4]\n        return last_digits[n]\n```"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Calculates the symmetric difference between two tuples, returning elements present in one but not both.\n\n    The resulting tuple contains elements sorted in ascending order.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n    dissimilar_elements_set = set1.symmetric_difference(set2)\n    return tuple(sorted(list(dissimilar_elements_set)))"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(list1: list, list2: list) -> bool:\n    \"\"\"\n    Checks if list2 is a contiguous sublist of list1.\n    Returns True if found, False otherwise.\n    \"\"\"\n    n1 = len(list1)\n    n2 = len(list2)\n\n    if n2 == 0:\n        return True  # An empty list is always a sublist\n\n    if n2 > n1:\n        return False\n\n    for i in range(n1 - n2 + 1):\n        if list1[i : i + n2] == list2:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Removes uneven (odd) integer elements from a nested mixed tuple,\n    preserving the original nesting structure.\n    \"\"\"\n    result = []\n    for element in input_tuple:\n        if isinstance(element, int):\n            if element % 2 == 0:\n                result.append(element)\n        elif isinstance(element, tuple):\n            sub_tuple_result = extract_even(element)\n            if sub_tuple_result: # Only add if not empty to preserve structure\n                result.append(sub_tuple_result)\n    return tuple(result)"}
{"task_id": "Mbpp/581", "solution": "import math\n\ndef surface_Area(base_edge: float, height: float) -> float:\n    \"\"\"\n    Calculates the surface area of a square pyramid.\n    Raises ValueError if base_edge or height are not positive numerical values.\n    \"\"\"\n    if not isinstance(base_edge, (int, float)) or base_edge <= 0:\n        raise ValueError(\"Base edge must be a positive numerical value.\")\n    if not isinstance(height, (int, float)) or height <= 0:\n        raise ValueError(\"Height must be a positive numerical value.\")\n\n    slant_height = math.sqrt(height**2 + (base_edge / 2)**2)\n    base_area = base_edge**2\n    lateral_area = 2 * base_edge * slant_height\n    surface_area = base_area + lateral_area\n\n    return surface_area"}
{"task_id": "Mbpp/585", "solution": "def expensive_items(dataset: list[dict], n: int) -> list[dict]:\n    \"\"\"\n    Finds the n most expensive items in a given dataset.\n    Sorts the dataset by 'price' in descending order and returns the top n items.\n    \"\"\"\n    if not dataset or n <= 0:\n        return []\n\n    # Sort the dataset by 'price' in descending order\n    sorted_dataset = sorted(dataset, key=lambda item: item['price'], reverse=True)\n\n    # Return the top n items\n    return sorted_dataset[:n]"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Catalan number using an iterative dynamic programming approach.\n    C_0 = 1, and C_n = C_{n-1} * (4n - 2) / (n + 1) for n > 0.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Initialize a list to store Catalan numbers, with C_0 = 1\n    catalan = [0] * (n + 1)\n    catalan[0] = 1\n\n    # Compute Catalan numbers iteratively up to n\n    for i in range(1, n + 1):\n        catalan[i] = catalan[i-1] * (4 * i - 2) // (i + 1)\n\n    return catalan[n]"}
{"task_id": "Mbpp/586", "solution": "def split_Arr(input_list: list, n: int) -> list:\n    \"\"\"\n    Splits a list at the nth element and moves the first part to the end.\n    This function uses list slicing and concatenation for efficient reordering.\n    \"\"\"\n    first_part = input_list[0:n]\n    second_part = input_list[n:]\n    reordered_list = second_part + first_part\n    return reordered_list"}
