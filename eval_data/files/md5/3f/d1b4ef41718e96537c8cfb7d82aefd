{"task_id": "Mbpp/554", "solution": "def Split(numbers: list[int]) -> list[int]:\n    \"\"\"\n    Filters a list of integers, returning a new list containing only the odd numbers.\n    The original relative order of elements is preserved.\n    \"\"\"\n    odd_numbers = []\n    for number in numbers:\n        if number % 2 != 0:\n            odd_numbers.append(number)\n    return odd_numbers"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of the absolute per-digit differences between two non-negative integers.\n    The shorter number is implicitly padded with leading zeros for comparison.\n    \"\"\"\n    s1 = str(num1)\n    s2 = str(num2)\n\n    max_len = max(len(s1), len(s2))\n\n    s1_padded = s1.zfill(max_len)\n    s2_padded = s2.zfill(max_len)\n\n    total_sum = 0\n    for i in range(max_len):\n        digit1 = int(s1_padded[i])\n        digit2 = int(s2_padded[i])\n        total_sum += abs(digit1 - digit2)\n\n    return total_sum"}
{"task_id": "Mbpp/555", "solution": "def _calculate_sum_of_n(n: int) -> int:\n    \"\"\"Calculates the sum of the first 'n' natural numbers.\"\"\"\n    return n * (n + 1) // 2\n\ndef _calculate_sum_of_cubes_of_n(n: int) -> int:\n    \"\"\"Calculates the sum of the cubes of the first 'n' natural numbers.\"\"\"\n    sum_n = _calculate_sum_of_n(n)\n    return sum_n * sum_n\n\ndef difference(n: int) -> int:\n    \"\"\"\n    Computes the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    sum_n = _calculate_sum_of_n(n)\n    sum_cubes_n = _calculate_sum_of_cubes_of_n(n)\n    result = sum_cubes_n - sum_n\n    return result"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string: str) -> str:\n    \"\"\"Toggles the case of all alphabetic characters in a string.\"\"\"\n    toggled_chars = []\n    for char in input_string:\n        if char.isupper():\n            toggled_chars.append(char.lower())\n        elif char.islower():\n            toggled_chars.append(char.upper())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr: list[int], n: int) -> int:\n    \"\"\"\n    Counts the number of unique pairs in a list whose bitwise XOR sum is odd.\n    Iterates through all unique pairs and checks if their XOR result is odd.\n    \"\"\"\n    count = 0\n    for i in range(n):\n        for j in range(i + 1, n):\n            xor_result = arr[i] ^ arr[j]\n            if xor_result % 2 != 0:  # Check if the XOR result is odd\n                count += 1\n    return count"}
