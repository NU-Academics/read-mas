{"task_id": "Mbpp/798", "solution": "from typing import Union\n\ndef _sum(array: list) -> Union[int, float]:\n    \"\"\"\n    Calculates the sum of all numerical elements in a list.\n    Returns 0 for an empty list, otherwise the sum of its contents.\n    \"\"\"\n    return sum(array)"}
{"task_id": "Mbpp/799", "solution": "BIT_LENGTH = 32\nBIT_MASK = 0xFFFFFFFF\n\ndef left_rotate(number: int, d: int) -> int:\n    \"\"\"\n    Rotates the bits of a 32-bit number to the left by d positions.\n    The result is masked to ensure it remains within 32 bits.\n    \"\"\"\n    d_effective = d % BIT_LENGTH\n    rotated = (number << d_effective) | (number >> (BIT_LENGTH - d_effective))\n    return rotated & BIT_MASK"}
{"task_id": "Mbpp/797", "solution": "def _is_natural(num: int) -> bool:\n    \"\"\"Checks if a given number is a natural number (positive integer).\"\"\"\n    return num > 0\n\ndef _is_odd(num: int) -> bool:\n    \"\"\"Checks if a given number is an odd number.\"\"\"\n    return num % 2 != 0\n\ndef sum_in_range(l: int, r: int) -> int:\n    \"\"\"\n    Finds the sum of all odd natural numbers within the range l and r (inclusive).\n    \"\"\"\n    total_sum = 0\n    # Adjust the lower bound to ensure only natural numbers are considered.\n    start = max(1, l)\n\n    # Iterate through the numbers in the adjusted range.\n    for i in range(start, r + 1):\n        if _is_natural(i) and _is_odd(i):\n            total_sum += i\n    return total_sum"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(num1, num2, num3):\n    \"\"\"\n    Counts the number of equal integers among three given inputs.\n    Returns 3 if all three are equal, 2 if exactly two are equal, and 0 if none are equal.\n    \"\"\"\n    if num1 == num2 and num2 == num3:\n        return 3\n    elif num1 == num2 or num1 == num3 or num2 == num3:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/803", "solution": "import math\n\ndef is_perfect_square(number: int) -> bool:\n    \"\"\"\n    Determines if the given integer is a perfect square.\n    A number N is a perfect square if there exists an integer K such that K*K = N.\n    \"\"\"\n    if number < 0:\n        return False\n    if number == 0:\n        return True\n\n    int_sqrt = int(round(math.sqrt(number)))\n\n    return int_sqrt * int_sqrt == number"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(list_of_lists: list[list[int | float]]) -> list[int | float] | None:\n    \"\"\"\n    Identifies the sub-list with the highest sum of elements from a given list of lists.\n    Returns None if the input list_of_lists is empty.\n    \"\"\"\n    if not list_of_lists:\n        return None\n\n    max_sum = float('-inf')\n    result_list = None\n\n    for sub_list in list_of_lists:\n        current_sum = sum(sub_list)\n        if current_sum > max_sum:\n            max_sum = current_sum\n            result_list = sub_list\n\n    return result_list"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers: list[int]) -> bool:\n    \"\"\"\n    Determines if the product of numbers in a given list is even.\n    The product is even if any number in the list is even; otherwise, it's odd.\n    \"\"\"\n    if not numbers:\n        return False\n\n    for number in numbers:\n        if number % 2 == 0:\n            return True\n\n    return False"}
{"task_id": "Mbpp/807", "solution": "def first_odd(numbers: list[int]) -> int | None:\n    \"\"\"\n    Finds the first odd number in a given list of integers.\n    Returns the first odd number found, or None if no odd number is present.\n    \"\"\"\n    for number in numbers:\n        if number % 2 != 0:\n            return number\n    return None"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Calculates the maximum run of uppercase characters in a given string.\n    Returns 0 if the string is empty or contains no uppercase characters.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in input_string:\n        if char.isupper():\n            current_run += 1\n            max_run = max(max_run, current_run)\n        else:\n            current_run = 0\n    return max_run"}
