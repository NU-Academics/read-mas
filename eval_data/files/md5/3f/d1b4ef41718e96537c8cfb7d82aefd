{"task_id": "Mbpp/141", "solution": "def _flip(arr: list, k: int) -> None:\n    \"\"\"\n    Reverses elements in the list 'arr' from index 0 up to 'k' (inclusive).\n    Modifies the list in-place.\n    \"\"\"\n    start = 0\n    while start < k:\n        arr[start], arr[k] = arr[k], arr[start]\n        start += 1\n        k -= 1\n\ndef _find_max_index(arr: list, n: int) -> int:\n    \"\"\"\n    Finds the index of the maximum element in the list 'arr' from index 0 up to 'n-1'.\n    \"\"\"\n    max_val = arr[0]\n    max_idx = 0\n    for i in range(1, n):\n        if arr[i] > max_val:\n            max_val = arr[i]\n            max_idx = i\n    return max_idx\n\ndef pancake_sort(input_list: list) -> list:\n    \"\"\"\n    Sorts a list of comparable elements in ascending order using the pancake sort algorithm.\n    Returns a new list with the sorted elements.\n    \"\"\"\n    arr = list(input_list)\n    n = len(arr)\n\n    for current_size in range(n, 1, -1):\n        max_idx = _find_max_index(arr, current_size)\n\n        if max_idx != current_size - 1:\n            _flip(arr, max_idx)\n            _flip(arr, current_size - 1)\n\n    return arr"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1: list, list2: list, list3: list) -> int:\n    \"\"\"\n    Counts identical items in the same position of three given lists.\n    The comparison iterates up to the length of the shortest input list.\n    \"\"\"\n    count = 0\n    min_length = min(len(list1), len(list2), len(list3))\n\n    for i in range(min_length):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(input_array: 'list[int] | list[float] | tuple[int, ...] | tuple[float, ...]') -> 'int | float':\n    \"\"\"\n    Finds the maximum difference between any two elements in a given array.\n    Returns 0 if the array is empty or has only one element.\n    \"\"\"\n    if len(input_array) <= 1:\n        return 0\n    \n    min_val = min(input_array)\n    max_val = max(input_array)\n    \n    return max_val - min_val"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Finds integer solutions (x, y) for the linear Diophantine equation ax + by = n.\n    Returns (x, y) if a solution exists, otherwise None.\n    \"\"\"\n\n    def gcd(a: int, b: int) -> int:\n        while b:\n            a, b = b, a % b\n        return a\n\n    def extended_gcd(a: int, b: int) -> tuple[int, int, int]:\n        \"\"\"\n        Calculates gcd(a, b) and returns (gcd, x, y) such that ax + by = gcd.\n        \"\"\"\n        if a == 0:\n            return b, 0, 1\n        gcd_val, x1, y1 = extended_gcd(b % a, a)\n        x = y1 - (b // a) * x1\n        y = x1\n        return gcd_val, x, y\n\n    common_divisor = gcd(a, b)\n\n    if n % common_divisor != 0:\n        return None\n\n    # Reduce the equation by dividing by common_divisor\n    a_prime = a // common_divisor\n    b_prime = b // common_divisor\n    n_prime = n // common_divisor\n\n    # Find a particular solution to a_prime*x + b_prime*y = 1\n    # using the extended Euclidean algorithm\n    _, x0_prime, y0_prime = extended_gcd(a_prime, b_prime)\n\n    # Scale the particular solution to a_prime*x + b_prime*y = n_prime\n    x_particular = x0_prime * n_prime\n    y_particular = y0_prime * n_prime\n\n    return (x_particular, y_particular)"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) for i from 0 to n // 2, inclusive.\n    \"\"\"\n    current_sum = 0\n    for i in range(n // 2 + 1):\n        term = n - 2 * i\n        current_sum += term\n    return current_sum"}
