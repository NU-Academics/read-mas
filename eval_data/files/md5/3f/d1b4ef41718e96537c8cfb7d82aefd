{"task_id": "Mbpp/62", "solution": "def smallest_num(numbers: list) -> float:\n    \"\"\"Finds the smallest number in a list of numeric values.\n\n    Assumes the input list 'numbers' is not empty and contains only numeric types.\n    \"\"\"\n    min_value = numbers[0]\n    for num in numbers:\n        if num < min_value:\n            min_value = num\n    return min_value"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts the number of substrings in 's' where the sum of their digits equals their length.\n    \"\"\"\n    def _calculate_digit_sum(sub: str) -> int:\n        \"\"\"Calculates the sum of numerical digits in a given string.\"\"\"\n        total_sum = 0\n        for char in sub:\n            total_sum += int(char)\n        return total_sum\n\n    count = 0\n    n = len(s)\n    for i in range(n):\n        for j in range(i, n):\n            substring = s[i:j+1]\n            substring_length = len(substring)\n            digit_sum = _calculate_digit_sum(substring)\n            if digit_sum == substring_length:\n                count += 1\n    return count"}
