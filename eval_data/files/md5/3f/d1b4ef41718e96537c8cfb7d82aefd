{"task_id": "Mbpp/409", "solution": "def min_product_tuple(list_of_tuples: list[tuple[int, int]]) -> int:\n    \"\"\"\n    Calculates the minimum product from a list of integer tuples.\n    Each tuple is expected to contain two integer elements.\n    \"\"\"\n    min_product_found = float('inf')  # Initialize with positive infinity to ensure any product will be smaller\n\n    for tpl in list_of_tuples:\n        # Calculate the product of the two elements in the current tuple\n        product = tpl[0] * tpl[1]\n        \n        # Update min_product_found if the current product is smaller\n        if product < min_product_found:\n            min_product_found = product\n            \n    return min_product_found"}
{"task_id": "Mbpp/410", "solution": "def min_val(data_list: list) -> int | float:\n    \"\"\"\n    Finds the minimum numeric value in a heterogeneous list, ignoring non-numeric elements.\n    Raises ValueError if no numeric values are found.\n    \"\"\"\n    numeric_values = [item for item in data_list if isinstance(item, (int, float))]\n    \n    if not numeric_values:\n        raise ValueError(\"No numeric values found in the list.\")\n        \n    return min(numeric_values)"}
