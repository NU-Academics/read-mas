{"task_id": "Mbpp/763", "solution": "def find_min_diff(array: tuple[int | float, ...], size: int) -> int | float:\n    \"\"\"\n    Computes the minimum absolute difference between any two distinct elements in the given array.\n    Returns: The minimum absolute difference found, or float('inf') if the array has fewer than two elements.\n    \"\"\"\n    if size < 2:\n        return float('inf')\n\n    min_diff = float('inf')\n\n    sorted_array = sorted(array)\n\n    for i in range(size - 1):\n        diff = abs(sorted_array[i+1] - sorted_array[i])\n        if diff < min_diff:\n            min_diff = diff\n            \n    return min_diff"}
{"task_id": "Mbpp/765", "solution": "class InvalidArgumentError(ValueError):\n    \"\"\"Custom exception for invalid input arguments.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef _is_power_of_two(num: int) -> bool:\n    \"\"\"Checks if a given positive integer is a power of two.\"\"\"\n    if num <= 0:\n        return False\n    return (num & (num - 1)) == 0\n\ndef find_nth_polite_number(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number. A polite number is any positive integer\n    that is not a power of 2.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise InvalidArgumentError(\"n must be a positive integer.\")\n\n    count = 0\n    current_number = 1\n    while count < n:\n        if not _is_power_of_two(current_number):\n            count += 1\n        current_number += 1\n    return current_number - 1"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(input_string: str) -> int:\n    \"\"\"\n    Counts the number of digit characters in the given string.\n    A digit is defined as any character from '0' through '9'.\n    \"\"\"\n    count = 0\n    for char in input_string:\n        if char.isdigit():  # Checks if the character is a digit\n            count += 1\n    return count"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1: list, list2: list) -> list:\n    \"\"\"\n    Calculates the difference between two lists (list1 - list2),\n    preserving the order of elements from list1.\n    \"\"\"\n    set_list2 = set(list2)\n    result_list = []\n    for item in list1:\n        if item not in set_list2:\n            result_list.append(item)\n    return result_list"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list, target_sum: int) -> int:\n    \"\"\"\n    Counts the number of distinct pairs (by index) whose sum equals 'target_sum'.\n    Iterates through all possible pairs and increments a counter if their sum matches.\n    \"\"\"\n    pair_count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                pair_count += 1\n    return pair_count"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list: list) -> list[tuple]:\n    \"\"\"\n    Returns a list of all consecutive pairs from a given list, formatted as tuples.\n    Returns an empty list if the input list has fewer than two elements.\n    \"\"\"\n    if len(input_list) < 2:\n        return []\n\n    result = []\n    for i in range(len(input_list) - 1):\n        result.append((input_list[i], input_list[i+1]))\n    return result"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth power of the first 'n' odd natural numbers.\n    Assumed to be a positive integer as per SRS assumptions.\n    \"\"\"\n    current_sum = 0\n    current_odd_num = 1\n\n    for _ in range(n):\n        current_sum += current_odd_num ** 4\n        current_odd_num += 2\n\n    return current_sum"}
{"task_id": "Mbpp/775", "solution": "def odd_position(numbers: list[int]) -> bool:\n    \"\"\"\n    Checks if every element at an odd index in the given list is an odd number.\n    Returns True if all elements at odd indices are odd numbers, False otherwise.\n    \"\"\"\n    for i, num in enumerate(numbers):\n        # Check if the current index is odd\n        if i % 2 != 0:\n            # If the index is odd, check if the number at this index is even\n            if num % 2 == 0:\n                return False  # An odd index contains an even number, condition not met\n    return True # All odd-indexed numbers were odd (or there were no odd indices)"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression_string: str) -> bool:\n    \"\"\"\n    Checks if the given expression string has balanced brackets.\n    Returns True if the expression is balanced, False otherwise.\n    \"\"\"\n    stack = []\n    bracket_map = {\n        '(': ')',\n        '{': '}',\n        '[': ']'\n    }\n    opening_brackets = set(bracket_map.keys())\n    closing_brackets = set(bracket_map.values())\n\n    for char in expression_string:\n        if char in opening_brackets:\n            stack.append(char)\n        elif char in closing_brackets:\n            if not stack:\n                return False\n            last_open = stack.pop()\n            if bracket_map[last_open] != char:\n                return False\n\n    return not stack"}
{"task_id": "Mbpp/772", "solution": "def remove_length(input_string: str, k: int) -> str:\n    \"\"\"\n    Removes all words of length k from the input string.\n    Preserves the order of remaining words and separates them by single spaces.\n    \"\"\"\n    words = input_string.split()\n\n    if k < 0:\n        filtered_words = words\n    else:\n        filtered_words = [word for word in words if len(word) != k]\n\n    return ' '.join(filtered_words)"}
{"task_id": "Mbpp/773", "solution": "import typing\n\ndef occurance_substring(main_string: str, sub_string: str) -> typing.Optional[typing.Tuple[str, int, int]]:\n    \"\"\"\n    Finds the first occurrence of a substring within a string, returning its details or None.\n    \"\"\"\n    start_index = main_string.find(sub_string)\n    if start_index == -1:\n        return None\n    \n    end_index = start_index + len(sub_string)\n    return (sub_string, start_index, end_index)"}
{"task_id": "Mbpp/777", "solution": "import collections\n\ndef find_sum(numbers: list) -> int | float:\n    \"\"\"\n    Calculates the sum of non-repeated elements in a given list.\n    Counts element frequencies and sums those appearing exactly once.\n    \"\"\"\n    counts = collections.Counter(numbers)\n    total_sum = 0\n    for element, count in counts.items():\n        if count == 1:\n            total_sum += element\n    return total_sum"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list) -> list:\n    \"\"\"Packs consecutive duplicate elements of a given list into sublists.\n\n    Args:\n        input_list: The list whose consecutive duplicates are to be packed.\n\n    Returns:\n        A new list where consecutive duplicates are grouped into sublists.\n    \"\"\"\n    if not input_list:\n        return []\n\n    packed_list = []\n    current_sublist = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] == current_sublist[0]:\n            current_sublist.append(input_list[i])\n        else:\n            packed_list.append(current_sublist)\n            current_sublist = [input_list[i]]\n\n    # Add the last sublist\n    packed_list.append(current_sublist)\n\n    return packed_list"}
{"task_id": "Mbpp/781", "solution": "import math\n\nclass BooleanResult:\n    def __init__(self, result: bool):\n        self._result = result\n\n    @property\n    def result(self) -> bool:\n        return self._result\n\n    def get_result(self) -> bool:\n        return self._result\n\nclass DivisorCount:\n    def __init__(self, count: int):\n        self._count = count\n\n    @property\n    def count(self) -> int:\n        return self._count\n\n    def isEven(self) -> BooleanResult:\n        return BooleanResult(self._count % 2 == 0)\n\nclass Integer:\n    def __init__(self, value: int):\n        self._value = value\n\n    @property\n    def value(self) -> int:\n        return self._value\n\n    def calculateDivisorCount(self) -> DivisorCount:\n        # Calculates the count of positive divisors for the integer's absolute value.\n        # Uses an optimized loop up to the square root of the number.\n        num = abs(self._value)\n        if num == 0:\n            return DivisorCount(0)\n        if num == 1:\n            return DivisorCount(1)\n\n        count = 0\n        for i in range(1, int(math.sqrt(num)) + 1):\n            if num % i == 0:\n                if i * i == num:\n                    count += 1\n                else:\n                    count += 2\n        return DivisorCount(count)\n\ndef count_divisors(integer_value: int) -> bool:\n    \"\"\"\n    Checks whether the count of positive divisors for an integer is even.\n    Returns True if the count of divisors is even, False otherwise.\n    \"\"\"\n    integer_obj = Integer(integer_value)\n    divisor_count_obj = integer_obj.calculateDivisorCount()\n    boolean_result_obj = divisor_count_obj.isEven()\n    return boolean_result_obj.get_result()"}
{"task_id": "Mbpp/780", "solution": "from typing import List, Tuple, Union, Any\nimport itertools\n\nNumber = Union[int, float]\n\nclass Tuple:\n    \"\"\"Represents a pair of numerical elements and provides element-wise summation.\"\"\"\n    def __init__(self, element1: Number, element2: Number) -> None:\n        self.element1 = element1\n        self.element2 = element2\n\n    def sum(self, other_tuple: 'Tuple') -> 'Tuple':\n        \"\"\"Calculates the element-wise sum with another Tuple.\"\"\"\n        return Tuple(self.element1 + other_tuple.element1, self.element2 + other_tuple.element2)\n\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, Tuple):\n            return NotImplemented\n        return self.element1 == other.element1 and self.element2 == other.element2\n\n    def __hash__(self) -> int:\n        return hash((self.element1, self.element2))\n\n    def __repr__(self) -> str:\n        return f\"Tuple({self.element1}, {self.element2})\"\n\n    def to_native_tuple(self) -> Tuple[Number, Number]:\n        \"\"\"Converts to a native Python tuple.\"\"\"\n        return (self.element1, self.element2)\n\ndef _validate_single_tuple(tup: Any) -> None:\n    \"\"\"Validates that a single input is a tuple with exactly two numerical elements.\"\"\"\n    if not isinstance(tup, tuple):\n        raise ValueError(\"Each item in the list must be a tuple.\")\n    if len(tup) != 2:\n        raise ValueError(\"Each tuple must contain exactly two elements.\")\n    if not all(isinstance(x, (int, float)) for x in tup):\n        raise ValueError(\"Both elements in each tuple must be numerical (int or float).\")\n\ndef _validate_tuple_list_input(tuple_list: Any) -> None:\n    \"\"\"Validates that the main input is a list and that all its elements are valid tuples.\"\"\"\n    if not isinstance(tuple_list, list):\n        raise ValueError(\"Input must be a list of tuples.\")\n    for tup in tuple_list:\n        _validate_single_tuple(tup)\n\ndef find_combinations(tuple_list: List[Tuple[Number, Number]]) -> List[Tuple[Number, Number]]:\n    \"\"\"\n    Finds combinations of sums with tuples in the given tuple list.\n    It calculates element-wise sums of all unique pairs of tuples from the input.\n    \"\"\"\n    _validate_tuple_list_input(tuple_list)\n\n    result_sums: List[Tuple[Number, Number]] = []\n\n    for t1_native, t2_native in itertools.combinations(tuple_list, 2):\n        t1_obj = Tuple(t1_native[0], t1_native[1])\n        t2_obj = Tuple(t2_native[0], t2_native[1])\n\n        sum_obj = t1_obj.sum(t2_obj)\n        result_sums.append(sum_obj.to_native_tuple())\n\n    return result_sums"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int | float]) -> int:\n    \"\"\"\n    Calculates the sum of all odd-length subarrays from the input array.\n    This implementation iterates through all possible subarrays, sums those with odd lengths, and returns the total.\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):\n        for j in range(i, n):\n            subarray = arr[i : j + 1]\n            if len(subarray) % 2 == 1:\n                total_sum += sum(subarray)\n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(numbers: list) -> int | None:\n    \"\"\"\n    Finds the product of the first even and first odd number in a given list.\n    Returns None if either an even or an odd number is not found.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for number in numbers:\n        if first_even is None and number % 2 == 0:\n            first_even = number\n        if first_odd is None and number % 2 != 0:\n            first_odd = number\n\n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is not None and first_odd is not None:\n        return first_even * first_odd\n    else:\n        return None"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(sorted_list: list, value: object) -> int:\n    \"\"\"\n    Locates the right insertion point for a specified value in a sorted list.\n    If the value is already present, returns the index immediately following\n    the last occurrence of that value.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] <= value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(tuple_str: str) -> tuple[int]:\n    \"\"\"\n    Converts a string representation of an integer tuple into an actual tuple of integers.\n    Raises ValueError for invalid input format or non-integer elements.\n    \"\"\"\n    if not tuple_str.startswith('(') or not tuple_str.endswith(')'):\n        raise ValueError(\"Invalid tuple string format\")\n\n    content = tuple_str[1:-1].strip()\n\n    if not content:\n        return ()\n\n    elements_str = [s.strip() for s in content.split(',')]\n    int_elements = []\n\n    for s in elements_str:\n        try:\n            int_elements.append(int(s))\n        except ValueError:\n            raise ValueError(f\"Invalid tuple element: '{s}'\")\n\n    return tuple(int_elements)"}
