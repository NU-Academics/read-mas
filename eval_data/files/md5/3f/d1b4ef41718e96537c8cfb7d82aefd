{"task_id": "Mbpp/305", "solution": "from typing import List, Tuple\n\ndef _split_string_into_words(input_string: str) -> List[str]:\n    \"\"\"Splits a string into words using whitespace as a delimiter.\"\"\"\n    return input_string.split()\n\ndef _word_starts_with_p(word: str) -> bool:\n    \"\"\"Checks if a word starts with 'p' or 'P' case-insensitively.\"\"\"\n    return len(word) > 0 and word[0].lower() == 'p'\n\ndef start_withp(word_list: List[str]) -> Tuple[str, ...]:\n    \"\"\"Returns the first two words from a list of strings starting with 'p' or 'P'.\n    It iterates through the input, splits strings into words, and collects the first two case-insensitively matching words, returning them as a tuple.\n    \"\"\"\n    collected_words: List[str] = []\n    for s in word_list:\n        words_in_string = _split_string_into_words(s)\n        for word in words_in_string:\n            if _word_starts_with_p(word):\n                collected_words.append(word)\n                if len(collected_words) == 2:\n                    return tuple(collected_words)\n    return tuple(collected_words)"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(sequence: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from prefix until ith index,\n    including the kth element (k > i).\n    \"\"\"\n    if not (0 <= i < n and i < k < n):\n        return 0\n\n    kth_element = sequence[k]\n    max_sum_prefix = [0] * (i + 1)\n\n    for current_idx in range(i + 1):\n        max_sum_prefix[current_idx] = sequence[current_idx]\n        for prev_idx in range(current_idx):\n            if sequence[current_idx] > sequence[prev_idx]:\n                max_sum_prefix[current_idx] = max(max_sum_prefix[current_idx],\n                                                  max_sum_prefix[prev_idx] + sequence[current_idx])\n\n    overall_max_sum = 0\n    for current_idx in range(i + 1):\n        if kth_element > sequence[current_idx]:\n            overall_max_sum = max(overall_max_sum, max_sum_prefix[current_idx] + kth_element)\n\n    return overall_max_sum"}
