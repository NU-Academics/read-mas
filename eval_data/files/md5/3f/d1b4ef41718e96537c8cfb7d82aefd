{"task_id": "Mbpp/440", "solution": "import re\nimport string\n\ndef find_adverb_position(sentence_text: str) -> tuple[int, int, str] | None:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    The adverb is identified as a word ending in '-ly' (case-insensitive),\n    excluding any immediately trailing punctuation.\n    \"\"\"\n    for match in re.finditer(r'\\S+', sentence_text):\n        word_with_punct = match.group(0)\n        original_start_index = match.start()\n\n        # Strip trailing punctuation to get the base word for the '-ly' check.\n        # This ensures the adverb itself does not include punctuation.\n        base_word = word_with_punct.rstrip(string.punctuation)\n\n        if base_word and base_word.lower().endswith('ly'):\n            # The adverb is found. The text and end index correspond to the base word.\n            adverb_text = base_word\n            end_index = original_start_index + len(base_word)\n            return (original_start_index, end_index, adverb_text)\n\n    # If no adverb is found after checking all word-like tokens.\n    return None"}
{"task_id": "Mbpp/448", "solution": "_memo = {}\n\ndef _calculate_perrin_number(index: int) -> int:\n    \"\"\"Calculates the Perrin number P(index) using memoization.\"\"\"\n    if index in _memo:\n        return _memo[index]\n\n    if index == 0:\n        result = 3\n    elif index == 1:\n        result = 0\n    elif index == 2:\n        result = 2\n    else:\n        result = _calculate_perrin_number(index - 2) + _calculate_perrin_number(index - 3)\n\n    _memo[index] = result\n    return result\n\ndef cal_sum(maxIndex: int) -> int:\n    \"\"\"Calculates the sum of Perrin numbers from P(0) to P(maxIndex).\"\"\"\n    total_sum = 0\n    for i in range(maxIndex + 1):\n        total_sum += _calculate_perrin_number(i)\n    return total_sum"}
