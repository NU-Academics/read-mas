{"task_id": "Mbpp/165", "solution": "_ALPHABET_MAP = {chr(ord('a') + i): i for i in range(26)}\n\ndef _get_alphabet_position(char: str) -> int | None:\n    # Converts a character to its 0-based alphabet position, case-insensitively.\n    # Returns None if the character is not an English alphabet letter.\n    lower_char = char.lower()\n    return _ALPHABET_MAP.get(lower_char)\n\ndef count_char_position(input_string: str) -> int:\n    # Counts characters in a string whose 0-based position matches their alphabet position.\n    count = 0\n    for index, char in enumerate(input_string):\n        alphabet_pos = _get_alphabet_position(char)\n        if alphabet_pos is not None and index == alphabet_pos:\n            count += 1\n    return count"}
{"task_id": "Mbpp/166", "solution": "def _is_even(number: int) -> bool:\n    \"\"\"Determines if a given integer is even.\"\"\"\n    return number % 2 == 0\n\ndef find_even_pair(numbers: list[int]) -> int:\n    \"\"\"Counts pairs of integers in a list that XOR to an even number.\"\"\"\n    even_pair_count = 0\n    n = len(numbers)\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            # Two numbers XOR to an even number if and only if they have the same parity.\n            if _is_even(numbers[i]) == _is_even(numbers[j]):\n                even_pair_count += 1\n                \n    return even_pair_count"}
{"task_id": "Mbpp/170", "solution": "from typing import List\n\nclass RangeSumError(Exception):\n    \"\"\"Custom exception for errors related to range sum calculation.\"\"\"\n    pass\n\ndef _validate_indices(numbers_length: int, startIndex: int, endIndex: int) -> None:\n    \"\"\"\n    Validates the start and end indices against business rules.\n    Raises RangeSumError if any index validation rule is violated.\n    \"\"\"\n    if startIndex < 0:\n        raise RangeSumError(f\"BR1: Start index must be non-negative. Got: {startIndex}\")\n    if endIndex < 0:\n        raise RangeSumError(f\"BR2: End index must be non-negative. Got: {endIndex}\")\n    if startIndex > endIndex:\n        raise RangeSumError(f\"BR3: Start index ({startIndex}) must be less than or equal to end index ({endIndex}).\")\n    if endIndex >= numbers_length:\n        raise RangeSumError(f\"BR4: End index ({endIndex}) must be within the bounds of the list (length {numbers_length}).\")\n\ndef sum_range_list(numbers: List[int], startIndex: int, endIndex: int) -> int:\n    \"\"\"\n    Calculates the sum of numbers in a list within a specified inclusive range.\n    It validates indices and inputs, raising exceptions for invalid cases.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input 'numbers' must be a list.\")\n    if not all(isinstance(n, int) for n in numbers):\n        raise TypeError(\"All elements in 'numbers' list must be integers.\")\n    if not isinstance(startIndex, int):\n        raise TypeError(\"Input 'startIndex' must be an integer.\")\n    if not isinstance(endIndex, int):\n        raise TypeError(\"Input 'endIndex' must be an integer.\")\n\n    _validate_indices(len(numbers), startIndex, endIndex)\n\n    current_sum = 0\n    for i in range(startIndex, endIndex + 1):\n        current_sum += numbers[i]\n\n    return current_sum"}
