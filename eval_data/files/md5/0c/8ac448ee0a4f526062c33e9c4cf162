{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome strictly greater than the given integer n.\n    Handles negative inputs by treating them as 0, then finding the next palindrome >= 0.\n    \"\"\"\n    # As per design context, for negative inputs, compute next palindrome >= 0.\n    # The simplest approach is to treat n as 0 if it's negative.\n    if n < 0:\n        n = 0\n\n    s = str(n)\n    length = len(s)\n\n    # Helper function to build a palindrome string from its left half and (optional) middle character.\n    def _build_palindrome(left_half_str, middle_char_str, is_odd_length):\n        right_half_str = left_half_str[::-1]\n        return int(left_half_str + (middle_char_str if is_odd_length else '') + right_half_str)\n\n    # Special case: If the number consists of all '9's (e.g., 9, 99, 999).\n    # The next palindrome will have length+1 digits, starting and ending with '1'.\n    # E.g., 9 -> 11, 99 -> 101, 999 -> 1001.\n    if s.count('9') == length:\n        return int('1' + '0' * (length - 1) + '1')\n\n    # General case:\n    # 1. Split the number string into left, middle (if odd length), and right parts.\n    mid_idx = length // 2\n    left_part = s[:mid_idx]\n    middle_char = s[mid_idx] if length % 2 == 1 else ''\n\n    # 2. First attempt: Construct a palindrome by mirroring the left part.\n    # This creates the smallest palindrome that has the same prefix as 's'.\n    candidate_palindrome_int = _build_palindrome(left_part, middle_char, length % 2 == 1)\n\n    # 3. If this candidate palindrome is already strictly greater than n, it's our answer.\n    # E.g., n=120, candidate=\"121\". 121 > 120, so 121 is the answer.\n    if candidate_palindrome_int > n:\n        return candidate_palindrome_int\n    \n    # 4. If the candidate palindrome is not strictly greater (i.e., <= n),\n    # we need to increment the 'center' part of the number and then re-mirror.\n    # The 'center' part includes the left half and the middle digit if the length is odd.\n    \n    # Extract the 'center' part as a string.\n    # For odd length: s[0...mid_idx] (e.g., \"123\" from \"12345\")\n    # For even length: s[0...mid_idx-1] (e.g., \"12\" from \"1234\")\n    # This can be generalized as s[:mid_idx + (length % 2)]\n    center_part_to_increment_str = s[:mid_idx + (length % 2)]\n    \n    # Increment its integer value.\n    incremented_center_int = int(center_part_to_increment_str) + 1\n    incremented_center_str = str(incremented_center_int)\n\n    # Re-build the palindrome with the newly incremented center part.\n    # The new left part comes from incremented_center_str.\n    new_left_part = incremented_center_str[:mid_idx]\n    new_middle_char = incremented_center_str[mid_idx] if length % 2 == 1 else ''\n\n    return _build_palindrome(new_left_part, new_middle_char, length % 2 == 1)"}
{"task_id": "Mbpp/104", "solution": "from typing import List\n\ndef sort_sublists(list_of_lists: List[List[str]]) -> List[List[str]]:\n    \"\"\"\n    Sorts each sublist of strings in a given list of lists lexicographically.\n    Returns a new list of lists with each sublist sorted in ascending order.\n    \"\"\"\n    sorted_outer_list: List[List[str]] = []\n    for sublist in list_of_lists:\n        # Create a new list from the sublist and sort it\n        sorted_sublist = sorted(sublist)\n        sorted_outer_list.append(sorted_sublist)\n    return sorted_outer_list"}
{"task_id": "Mbpp/103", "solution": "_eulerian_num_cache = {}\n\ndef eulerian_num(n, m):\n    \"\"\"\n    Computes the Eulerian number a(n, m) using dynamic programming with memoization.\n    It returns 0 for inputs outside the standard mathematical definition domain (n >= 0, 0 <= m < n, or n=0, m=0).\n    \"\"\"\n    if n == 0 and m == 0:\n        return 1\n    if n < 0 or m < 0 or m >= n:\n        return 0\n\n    if (n, m) in _eulerian_num_cache:\n        return _eulerian_num_cache[(n, m)]\n\n    # Initialize previous row for k=0: a(0,0)=1\n    # `prev_row` stores a(k-1, j) values. Its length is k-1 (max j is k-2).\n    # For k=1, prev_row represents a(0,j), which only has a(0,0). So length 1.\n    prev_row = [1] # a(0,0) = 1\n\n    # Iterate from k=1 up to n to compute a(k, j)\n    for k in range(1, n + 1):\n        # `current_row` will store a(k, j) values for the current iteration k.\n        # It needs to store values for j from 0 to k-1, so its length is k.\n        current_row = [0] * k\n        for j in range(k): # j iterates from 0 to k-1 (m index for a(k,j))\n            # Recurrence relation: a(k, j) = (k - j) * a(k - 1, j - 1) + (j + 1) * a(k - 1, j)\n\n            # Term 1: (k - j) * a(k - 1, j - 1)\n            term1 = 0\n            if j - 1 >= 0: # a(k-1, j-1) is 0 if j-1 < 0\n                term1 = (k - j) * prev_row[j - 1]\n\n            # Term 2: (j + 1) * a(k - 1, j)\n            term2 = 0\n            if j < len(prev_row): # a(k-1, j) is 0 if j is out of bounds for prev_row\n                term2 = (j + 1) * prev_row[j]\n\n            current_row[j] = term1 + term2\n            \n            # Cache all intermediate results\n            _eulerian_num_cache[(k, j)] = current_row[j]\n\n        prev_row = current_row # Set current_row as prev_row for the next iteration\n\n    # The result for (n, m) will be in the cache after the loops\n    return _eulerian_num_cache[(n, m)]"}
{"task_id": "Mbpp/106", "solution": "from typing import Any, List, Tuple\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input types or values.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\n    def __str__(self) -> str:\n        return self.message\n\nclass InputValidator:\n    \"\"\"Validates input types for list and tuple arguments.\"\"\"\n    def validate_list(self, items: Any) -> None:\n        if items is None or not isinstance(items, list):\n            self._raise_invalid(\"items must be a list\")\n\n    def validate_tuple(self, base: Any) -> None:\n        if base is None or not isinstance(base, tuple):\n            self._raise_invalid(\"base must be a tuple\")\n\n    def _raise_invalid(self, msg: str) -> None:\n        raise InvalidInputError(msg)\n\nclass Converter:\n    \"\"\"Converts a list to a tuple.\"\"\"\n    def list_to_tuple(self, items: List[Any]) -> Tuple[Any, ...]:\n        return tuple(items)\n\nclass ListToTupleService:\n    \"\"\"Appends elements from a list to a base tuple.\"\"\"\n    def __init__(self, converter: Converter) -> None:\n        self.converter = converter\n\n    def append_list_to_tuple(self, items: List[Any], base: Tuple[Any, ...]) -> Tuple[Any, ...]:\n        items_tuple = self.converter.list_to_tuple(items)\n        return base + items_tuple\n\nclass AddListsController:\n    \"\"\"Orchestrates validation and list-to-tuple append service.\"\"\"\n    def __init__(self, validator: InputValidator, service: ListToTupleService) -> None:\n        self.validator = validator\n        self.service = service\n\n    def add_lists(self, items: List[Any], base: Tuple[Any, ...]) -> Tuple[Any, ...]:\n        self.validator.validate_list(items)\n        self.validator.validate_tuple(base)\n        return self.service.append_list_to_tuple(items, base)\n\n_converter = Converter()\n_service = ListToTupleService(_converter)\n_validator = InputValidator()\n_controller = AddListsController(_validator, _service)\n\ndef add_lists(items: List[Any], base: Tuple[Any, ...]) -> Tuple[Any, ...]:\n    \"\"\"Appends elements from a list to a tuple, returning a new tuple.\"\"\"\n    return _controller.add_lists(items, base)"}
{"task_id": "Mbpp/105", "solution": "def count(items):\n    \"\"\"\n    Count true booleans in the given list.\n    \"\"\"\n    return sum(1 for item in items if item is True)"}
{"task_id": "Mbpp/109", "solution": "import re\n\nclass InvalidBinaryStringError(Exception):\n    \"\"\"Custom exception for invalid binary strings.\"\"\"\n    pass\n\nclass InvalidRotationError(Exception):\n    \"\"\"Custom exception for invalid rotation counts.\"\"\"\n    pass\n\nclass BinaryStringModel:\n    \"\"\"Represents and operates on a binary string.\"\"\"\n    def __init__(self, value: str) -> None:\n        if not self._validate_initial(value):\n            raise InvalidBinaryStringError(\"Binary string must be non-empty and contain only '0' or '1'.\")\n        self.value = value\n        self._length = len(value)\n\n    def _validate_initial(self, s: str) -> bool:\n        \"\"\"Internal validation for initial string during construction.\"\"\"\n        return bool(s) and re.fullmatch(r'^[01]+$', s)\n\n    def rotate_left(self, steps: int) -> \"BinaryStringModel\":\n        \"\"\"Returns a new BinaryStringModel representing a left-rotation by steps.\"\"\"\n        if self._length == 0:\n            return BinaryStringModel(\"\")\n        effective_steps = steps % self._length\n        rotated_value = self.value[effective_steps:] + self.value[:effective_steps]\n        return BinaryStringModel(rotated_value)\n\n    def is_odd(self) -> bool:\n        \"\"\"Determines if the binary string represents an odd integer.\"\"\"\n        if not self.value:\n            return False # An empty string cannot be odd.\n        return self.value[-1] == '1'\n\nclass RotationService:\n    \"\"\"Encapsulates the algorithm for iterating rotations and counting odd-valued ones.\"\"\"\n    def count_odd_rotations(self, binary: str, rotations: int) -> int:\n        \"\"\"\n        Counts how many cyclic left-rotations of a binary string yield an odd integer value,\n        up to the given number of rotations.\n        \"\"\"\n        if not isinstance(binary, str) or not binary:\n            raise InvalidBinaryStringError(\"Binary string must be a non-empty string.\")\n        if not re.fullmatch(r'^[01]+$', binary):\n            raise InvalidBinaryStringError(\"Binary string must contain only '0' or '1'.\")\n        if not isinstance(rotations, int) or rotations < 0:\n            raise InvalidRotationError(\"Rotations must be a non-negative integer.\")\n\n        initial_model = BinaryStringModel(binary)\n        odd_count = 0\n        current_string = binary\n        length = len(binary)\n\n        for i in range(rotations):\n            # Check the current string for parity\n            if current_string[-1] == '1': # Check the last bit for oddness\n                odd_count += 1\n            \n            # Rotate for the next iteration\n            if i < rotations - 1: # Only rotate if there are more iterations\n                # Perform a single left rotation\n                current_string = current_string[1:] + current_string[0]\n\n        return odd_count\n\ndef odd_Equivalent(s: str, rotations: int) -> int:\n    \"\"\"\n    Finds the number of numbers with an odd value when rotating a binary string\n    the given number of times.\n    \"\"\"\n    service = RotationService()\n    return service.count_odd_rotations(s, rotations)"}
{"task_id": "Mbpp/111", "solution": "import collections.abc\nimport json\nfrom typing import Iterable, List, Set, Optional\n\nclass InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nALLOWED_ORDERS = {\"asc\", \"desc\"}\n\ndef validate_nested_lists(nested: Iterable[Iterable[int]]) -> None:\n    if not isinstance(nested, collections.abc.Iterable):\n        raise InvalidInputError(\"Top-level object must be iterable\")\n    \n    # Convert to list to check length efficiently and iterate if needed\n    current_lists = list(nested) \n    \n    if not current_lists:\n        raise InvalidInputError(\"Top-level iterable must not be empty\")\n    \n    for i, inner in enumerate(current_lists):\n        if not isinstance(inner, collections.abc.Iterable):\n            raise InvalidInputError(f\"Inner element at index {i} is not iterable\")\n        for j, v in enumerate(inner):\n            if not isinstance(v, int):\n                raise InvalidInputError(f\"Element at [{i}][{j}] is not int\")\n\ndef to_int_set(iterable: Iterable[int]) -> Set[int]:\n    s = set()\n    for v in iterable:\n        if not isinstance(v, int):\n            raise InvalidInputError(\"All elements must be int\")\n        s.add(v)\n    return s\n\ndef sort_results(items: Iterable[int], order: str = \"desc\") -> List[int]:\n    if order not in ALLOWED_ORDERS:\n        raise InvalidInputError(f\"Unknown order {order}\")\n    reverse = (order == \"desc\")\n    return sorted(items, reverse=reverse)\n\nclass NestedListsDTO:\n    def __init__(self, lists: Iterable[Iterable[int]]) -> None:\n        self.lists: List[List[int]] = [list(inner) for inner in lists]\n\n    def validate(self) -> None:\n        validate_nested_lists(self.lists)\n\nclass ResultDTO:\n    def __init__(self, common: List[int]) -> None:\n        self.common = list(common)\n\nclass ListRepository:\n    def load_from_json(self, path: str) -> NestedListsDTO:\n        try:\n            with open(path, \"r\", encoding=\"utf-8\") as f:\n                data = json.load(f)\n        except Exception as e:\n            raise InvalidInputError(f\"Failed to read JSON file: {e}\")\n        return self.from_iterable(data)\n\n    def from_iterable(self, nested: Iterable[Iterable[int]]) -> NestedListsDTO:\n        dto = NestedListsDTO(nested)\n        return dto\n\nclass CommonElementsService:\n    def __init__(self, repository: Optional[ListRepository] = None) -> None:\n        self._repo = repository or ListRepository()\n\n    def find_common(self, nested_dto: NestedListsDTO, sort_order: str = \"desc\") -> ResultDTO:\n        nested_dto.validate()\n        lists = nested_dto.lists\n\n        # If nested_dto.validate() passed, lists is guaranteed to be non-empty.\n        iter_lists = iter(lists)\n        first_set = to_int_set(next(iter_lists))\n        \n        common_set: Set[int] = first_set\n        for inner in iter_lists:\n            common_set &= to_int_set(inner)\n            if not common_set: # Short-circuit if intersection becomes empty\n                break\n        \n        sorted_list = sort_results(common_set, order=sort_order)\n        return ResultDTO(sorted_list)\n\n    def find_common_from_iterable(self, nested: Iterable[Iterable[int]], sort_order: str = \"desc\") -> ResultDTO:\n        dto = self._repo.from_iterable(nested)\n        return self.find_common(dto, sort_order=sort_order)\n\ndef common_in_nested_lists(nested: Iterable[Iterable[int]], sort_order: str = \"desc\") -> List[int]:\n    repo = ListRepository()\n    service = CommonElementsService(repository=repo)\n    result = service.find_common_from_iterable(nested, sort_order=sort_order)\n    return result.common"}
