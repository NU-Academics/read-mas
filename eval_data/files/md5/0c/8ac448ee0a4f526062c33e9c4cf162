{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(a, b):\n    \"\"\"\n    Checks if two integers differ at exactly one bit position.\n    This is equivalent to checking if their XOR sum has exactly one bit set.\n    \"\"\"\n    xor_val = a ^ b\n    # A number has exactly one bit set if it's not zero and (n & (n - 1)) is zero.\n    return xor_val != 0 and (xor_val & (xor_val - 1)) == 0"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(s: str, ch: str) -> str:\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    If only one occurrence exists, it removes that single occurrence.\n    \"\"\"\n    first_idx = s.find(ch)\n    if first_idx == -1:\n        return s\n\n    last_idx = s.rfind(ch)\n\n    if first_idx == last_idx:\n        # Only one occurrence, remove it\n        return s[:first_idx] + s[first_idx+1:]\n    else:\n        # Multiple occurrences, remove first and last\n        return s[:first_idx] + s[first_idx+1:last_idx] + s[last_idx+1:]"}
{"task_id": "Mbpp/7", "solution": "import string\n\ndef find_char_long(text: str) -> list[str]:\n    \"\"\"\n    Finds all words in a string that are at least 4 characters long,\n    preserving order of first appearance and original capitalization.\n    \"\"\"\n    raw_tokens = text.split()\n    \n    cleaned_tokens = []\n    for raw_token in raw_tokens:\n        # Strip leading and trailing punctuation, but keep internal punctuation.\n        cleaned_token = raw_token.strip(string.punctuation)\n        if cleaned_token:\n            cleaned_tokens.append(cleaned_token)\n            \n    result_words = []\n    seen = {} # Used to track seen words to maintain uniqueness while preserving order\n\n    for token in cleaned_tokens:\n        # Validate: token must contain at least one alphabetic character.\n        has_alpha = any(char.isalpha() for char in token)\n        \n        # Filter by length: at least 4 characters long.\n        is_long_enough = len(token) >= 4\n\n        if has_alpha and is_long_enough:\n            if token not in seen:\n                result_words.append(token)\n                seen[token] = True\n                \n    return result_words"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    Uses the Knuth-Morris-Pratt (KMP) prefix function to determine the string's minimal period.\n    \"\"\"\n    n = len(s)\n\n    # Calculate the KMP prefix function (LPS array)\n    lps = [0] * n\n    length = 0  # Length of the longest proper prefix that is also a suffix\n    i = 1\n    while i < n:\n        if s[i] == s[length]:\n            length += 1\n            lps[i] = length\n            i += 1\n        else:\n            if length != 0:\n                length = lps[length - 1]\n            else:\n                lps[i] = 0\n                i += 1\n\n    # The minimal period of the string is n - lps[n-1]\n    # This 'k' is the length of the smallest repeating unit that makes up the string.\n    k = n - lps[n - 1]\n\n    # If the string's length is perfectly divisible by 'k',\n    # then 'k' is the minimum number of rotations.\n    # Otherwise, the string itself is the smallest non-trivial period,\n    # meaning n rotations are required.\n    if n % k == 0:\n        return k\n    else:\n        return n"}
{"task_id": "Mbpp/3", "solution": "import math\n\ndef is_not_prime(n: int) -> bool:\n    \"\"\"\n    Identifies non-prime numbers based on mathematical definition and design rules.\n    Numbers 0, 1, and negative integers are considered non-prime.\n    \"\"\"\n    if n <= 1:\n        return True\n\n    if n == 2 or n == 3:\n        return False\n\n    if n % 2 == 0:\n        return True\n\n    limit = math.isqrt(n)\n    for i in range(3, limit + 1, 2):\n        if n % i == 0:\n            return True\n\n    return False"}
