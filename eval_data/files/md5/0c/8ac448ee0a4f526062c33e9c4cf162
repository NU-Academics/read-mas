{"task_id": "Mbpp/119", "solution": "from typing import List\n\ndef search(arr: List[int]) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where every other\n    element appears exactly twice, using binary search.\n    \"\"\"\n    left, right = 0, len(arr) - 1\n\n    while left < right:\n        mid = (left + right) // 2\n        # Ensure mid points to the start of a potential pair\n        # If mid is odd, make it even by decrementing\n        if mid % 2 == 1:\n            mid -= 1\n\n        # Check if the pair at mid is the same\n        if arr[mid] == arr[mid + 1]:\n            # If they are the same, the single element must be to the right\n            left = mid + 2\n        else:\n            # If they are different, the single element is at mid or to its left\n            right = mid\n            \n    return arr[left]"}
{"task_id": "Mbpp/113", "solution": "import re\nfrom typing import Any\n\nclass StringDTO:\n    \"\"\"\n    Data Transfer Object for input strings, handling normalization.\n    \"\"\"\n    def __init__(self, value: Any, trim: bool = True) -> None:\n        self.value = str(value)\n        self.trim = trim\n\n    def normalized(self) -> str:\n        \"\"\"Returns the string, trimmed if 'trim' is True.\"\"\"\n        return self.value.strip() if self.trim else self.value\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the normalized string is empty.\"\"\"\n        return self.normalized() == \"\"\n\nclass RegexValidator:\n    \"\"\"\n    Validates if a string matches an integer regex pattern.\n    \"\"\"\n    DEFAULT_INTEGER_REGEX = r'^[+-]?\\d+$'\n\n    def __init__(self, pattern: str = None) -> None:\n        self._pattern = re.compile(pattern or self.DEFAULT_INTEGER_REGEX)\n\n    def is_integer(self, value: str) -> bool:\n        \"\"\"Checks if the string represents an integer using a regex.\"\"\"\n        return bool(self._pattern.fullmatch(value))\n\nclass NumericUtils:\n    \"\"\"\n    Utility methods for numeric operations, primarily string coercion.\n    \"\"\"\n    @staticmethod\n    def coerce_to_str(value: Any) -> str:\n        \"\"\"Coerces any value to a string.\"\"\"\n        return str(value)\n\nclass CheckIntegerService:\n    \"\"\"\n    Provides the core business logic for checking if a string is an integer.\n    \"\"\"\n    def __init__(self, validator: RegexValidator = None) -> None:\n        self.validator = validator or RegexValidator()\n\n    def check(self, value: Any) -> bool:\n        \"\"\"Checks if the given value (coerced to string) represents an integer.\"\"\"\n        s = NumericUtils.coerce_to_str(value)\n        dto = StringDTO(s)\n        normalized = dto.normalized()\n        if dto.is_empty():\n            return False\n        return self.validator.is_integer(normalized)\n\n_default_service = CheckIntegerService(validator=RegexValidator())\n\ndef check_integer(value: str) -> bool:\n    \"\"\"\n    Checks if a string represents an integer.\n    \"\"\"\n    return _default_service.check(value)"}
{"task_id": "Mbpp/108", "solution": "import heapq\nimport abc\nfrom typing import Callable, Union\n\n\ndef merge_sorted_list(l1: list, l2: list, l3: list, strategy: str = \"heap\") -> list:\n    \"\"\"\n    Merges three lists into a single sorted list using a specified strategy.\n    Supports 'heap' (default) for k-way merge or 'sort' for concatenation and sort.\n    \"\"\"\n\n    class InvalidInputError(Exception):\n        \"\"\"Raised when input lists are invalid according to structural rules.\"\"\"\n\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class StrategyError(Exception):\n        \"\"\"Raised when a merge strategy encounters an error during execution or is unknown.\"\"\"\n\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class MergeRequest:\n        \"\"\"DTO for carrying input lists and strategy choice.\"\"\"\n\n        def __init__(self, lists: list[list], strategy: str | None = \"heap\") -> None:\n            self.lists = lists\n            self.strategy = strategy if strategy is not None else \"heap\"\n\n        def validate(self) -> None:\n            \"\"\"Ensures the basic structure of the request DTO is valid.\"\"\"\n            if not isinstance(self.lists, (list, tuple)):\n                raise InvalidInputError(\"Input 'lists' must be a list or tuple of lists.\")\n            if len(self.lists) != 3:\n                raise InvalidInputError(\"Input 'lists' must contain exactly three lists.\")\n            if not isinstance(self.strategy, str):\n                raise InvalidInputError(\"Strategy must be a string.\")\n\n    class MergeResult:\n        \"\"\"DTO for holding the merged sorted list.\"\"\"\n\n        def __init__(self, result: list) -> None:\n            self.result = result\n\n    def validate_lists(lists: list[list]) -> None:\n        \"\"\"Ensures the argument 'lists' is an iterable of exactly three iterables.\"\"\"\n        if not isinstance(lists, (list, tuple)):\n            raise InvalidInputError(\"Argument 'lists' must be a list or tuple.\")\n        if len(lists) != 3:\n            raise InvalidInputError(\"Argument 'lists' must contain exactly three iterables.\")\n        for i, lst in enumerate(lists):\n            if not hasattr(lst, '__iter__'):\n                raise InvalidInputError(f\"Element at index {i} in 'lists' is not iterable.\")\n\n    class MergeStrategy(abc.ABC):\n        \"\"\"Abstract base class defining the interface for merge strategies.\"\"\"\n\n        @abc.abstractmethod\n        def merge(self, lists: list[list]) -> list:\n            pass\n\n    class SortMergeStrategy(MergeStrategy):\n        \"\"\"Merges lists by concatenating them and then performing a full sort.\"\"\"\n\n        def merge(self, lists: list[list]) -> list:\n            try:\n                all_elements = [item for sublist in lists for item in sublist]\n                return sorted(all_elements)\n            except TypeError as e:\n                raise StrategyError(f\"Elements in lists are not comparable for sorting: {e}\")\n\n    class HeapMergeStrategy(MergeStrategy):\n        \"\"\"Performs a k-way merge of lists using a min-heap.\"\"\"\n\n        def merge(self, lists: list[list]) -> list:\n            merged_list = []\n            min_heap = []\n\n            for i, lst in enumerate(lists):\n                if lst:\n                    try:\n                        heapq.heappush(min_heap, (lst[0], i, 0))\n                    except TypeError as e:\n                        raise StrategyError(f\"Elements in lists are not comparable for heap operations: {e}\")\n\n            while min_heap:\n                value, list_idx, element_idx = heapq.heappop(min_heap)\n                merged_list.append(value)\n\n                if element_idx + 1 < len(lists[list_idx]):\n                    next_value = lists[list_idx][element_idx + 1]\n                    try:\n                        heapq.heappush(min_heap, (next_value, list_idx, element_idx + 1))\n                    except TypeError as e:\n                        raise StrategyError(f\"Elements in lists are not comparable for heap operations: {e}\")\n\n            return merged_list\n\n    class ListMergerService:\n        \"\"\"Orchestrates input validation, strategy selection, and execution.\"\"\"\n\n        def __init__(self, strategy_provider: Callable[[str], MergeStrategy | None]) -> None:\n            self._strategy_provider = strategy_provider\n\n        def merge(self, request: MergeRequest) -> MergeResult:\n            request.validate()\n            validate_lists(request.lists)\n\n            strategy = self._strategy_provider(request.strategy)\n            if strategy is None:\n                raise StrategyError(f\"Unknown merge strategy: '{request.strategy}'\")\n\n            merged = strategy.merge(request.lists)\n            return MergeResult(merged)\n\n    class MergeController:\n        \"\"\"A facade for external callers, delegating merge operations to the service.\"\"\"\n\n        def __init__(self, service: ListMergerService) -> None:\n            self._service = service\n\n        def merge(self, request: MergeRequest) -> MergeResult:\n            return self._service.merge(request)\n\n    # Factory function for providing strategy instances\n    def _strategy_factory(name: str) -> MergeStrategy | None:\n        if name == \"heap\":\n            return HeapMergeStrategy()\n        elif name == \"sort\":\n            return SortMergeStrategy()\n        return None\n\n    # Main execution logic for the merge_sorted_list function\n    request = MergeRequest([l1, l2, l3], strategy=strategy)\n    service = ListMergerService(_strategy_factory)\n    controller = MergeController(service)\n    return controller.merge(request).result"}
{"task_id": "Mbpp/126", "solution": "def sum_common_divisors(a, b):\n    \"\"\"\n    Calculates the sum of common positive divisors of two integers.\n    Uses an inline GCD helper and a divisor enumeration helper.\n    \"\"\"\n\n    def _gcd(x, y):\n        \"\"\"Computes the greatest common divisor of two numbers.\"\"\"\n        x, y = abs(x), abs(y)\n        if x == 0 and y == 0:\n            return 0\n        while y:\n            x, y = y, x % y\n        return x\n\n    def _divisors_of(n):\n        \"\"\"Finds all positive divisors of a given number.\"\"\"\n        if n <= 0:\n            return []\n        divs = set()\n        i = 1\n        while i * i <= n:\n            if n % i == 0:\n                divs.add(i)\n                divs.add(n // i)\n            i += 1\n        return sorted(list(divs))\n\n    g = _gcd(a, b)\n    if g == 0:\n        return 0\n    \n    common_divisors = _divisors_of(g)\n    return sum(common_divisors)"}
