{"task_id": "Mbpp/69", "solution": "from typing import Sequence, Any, List\n\ndef is_sublist(main: Sequence[Any], sub: Sequence[Any]) -> bool:\n    \"\"\"\n    Checks if a list contains the given sublist contiguously using a KMP-like algorithm.\n    An empty sublist is considered not found based on business rules.\n    \"\"\"\n    n = len(main)\n    m = len(sub)\n\n    if m == 0:\n        return False\n    if m > n:\n        return False\n\n    def _build_lps(pattern: Sequence[Any]) -> List[int]:\n        length = 0\n        lps = [0] * m\n        i = 1\n        while i < m:\n            if pattern[i] == pattern[length]:\n                length += 1\n                lps[i] = length\n                i += 1\n            else:\n                if length != 0:\n                    length = lps[length - 1]\n                else:\n                    lps[i] = 0\n                    i += 1\n        return lps\n\n    lps = _build_lps(sub)\n\n    i = 0  # index for main[]\n    j = 0  # index for sub[]\n\n    while i < n:\n        if main[i] == sub[j]:\n            i += 1\n            j += 1\n\n        if j == m:\n            return True\n        elif i < n and main[i] != sub[j]:\n            if j != 0:\n                j = lps[j - 1]\n            else:\n                i += 1\n    return False"}
{"task_id": "Mbpp/65", "solution": "from typing import Any, Iterator, Sequence, Union\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input types or detected cycles.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass ListFlattener:\n    \"\"\"Recursively flattens a list, yielding numeric elements and detecting cycles.\"\"\"\n    def __init__(self) -> None:\n        self._visited_ids: set[int] = set()\n\n    def flatten(self, seq: Sequence[Any]) -> Iterator[Union[int, float]]:\n        seq_id = id(seq)\n        if seq_id in self._visited_ids:\n            raise ValidationError(\"Cycle detected in input sequence\")\n        self._visited_ids.add(seq_id)\n        try:\n            for item in seq:\n                if self._is_number(item):\n                    yield item\n                elif self._is_sequence(item):\n                    yield from self.flatten(item)  # recursion via iterator\n                else:\n                    raise ValidationError(f\"Unsupported element type: {type(item).__name__}\")\n        finally:\n            self._visited_ids.remove(seq_id)\n\n    def _is_sequence(self, obj: Any) -> bool:\n        \"\"\"Checks if an object is a list or tuple, excluding strings/bytes.\"\"\"\n        return isinstance(obj, (list, tuple))\n\n    def _is_number(self, obj: Any) -> bool:\n        \"\"\"Checks if an object is an int or float, including booleans.\"\"\"\n        return isinstance(obj, (int, float))\n\nclass RecursiveSumService:\n    \"\"\"Orchestrates flattening and summing of numeric elements in a sequence.\"\"\"\n    def __init__(self, flattener: ListFlattener | None = None) -> None:\n        self._flattener = flattener or ListFlattener()\n\n    def sum_list(self, seq: Sequence[Any]) -> Union[int, float]:\n        \"\"\"Flattens the sequence and sums its numeric elements.\"\"\"\n        iterator = self._flattener.flatten(seq)\n        return self._accumulate(iterator)\n\n    def _accumulate(self, iterable: Iterator[Union[int, float]]) -> Union[int, float]:\n        \"\"\"Accumulates numeric values, promoting to float if any float is encountered.\"\"\"\n        total = 0\n        saw_float = False\n        for v in iterable:\n            if isinstance(v, float):\n                saw_float = True\n            total += v\n        return float(total) if saw_float else int(total)\n\ndef recursive_list_sum(input_list: Sequence[Any]) -> Union[int, float]:\n    \"\"\"Flattens a list and sums all of its numeric elements.\"\"\"\n    service = RecursiveSumService()\n    return service.sum_list(input_list)"}
{"task_id": "Mbpp/71", "solution": "from typing import List, TypeVar\n\nT = TypeVar(\"T\")\n\ndef comb_sort(items: List[T]) -> List[T]:\n    \"\"\"\n    Sorts a list of elements using the Comb Sort algorithm.\n    The function returns a new sorted list without mutating the original input.\n    \"\"\"\n    SHRINK_FACTOR: float = 1.3\n\n    def _next_gap(gap: int) -> int:\n        \"\"\"Calculates the next gap size for the Comb Sort algorithm.\"\"\"\n        new_gap = int(gap / SHRINK_FACTOR)\n        return max(1, new_gap)\n\n    arr = list(items)  # Create a new list to avoid mutating the original\n    n = len(arr)\n\n    if n < 2:\n        return arr\n\n    gap = n\n    swapped = True\n\n    while gap > 1 or swapped:\n        gap = _next_gap(gap)\n        swapped = False\n\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    return arr"}
{"task_id": "Mbpp/70", "solution": "from typing import Iterable, List, Tuple, Any, Set\nimport json # Required for TupleRepository.from_json method, defined inline.\n\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input to the tuple collection operations.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\ndef is_tuple_like(obj: Any) -> bool:\n    \"\"\"Checks if an object is a tuple.\"\"\"\n    return isinstance(obj, tuple)\n\ndef tuple_length(t: Tuple[Any, ...]) -> int:\n    \"\"\"Returns the length of a tuple.\"\"\"\n    if not isinstance(t, tuple):\n        raise TypeError(\"Not a tuple\") # Should not be reached if validation is correct\n    return len(t)\n\nclass TupleCollection:\n    \"\"\"Represents a collection of tuples and enforces validation rules.\"\"\"\n    def __init__(self, items: Iterable[Any], empty_behavior: str = \"raise\") -> None:\n        self._items = list(items)\n        self._empty_behavior = empty_behavior\n        self.validate()\n\n    def validate(self) -> None:\n        \"\"\"Validates the collection for non-emptiness and tuple-like elements.\"\"\"\n        if len(self._items) == 0:\n            if self._empty_behavior == \"raise\":\n                raise InvalidInputError(\"Empty collection\")\n        for i, it in enumerate(self._items):\n            if not is_tuple_like(it):\n                raise InvalidInputError(f\"Item at index {i} is not a tuple\")\n\n    def as_list(self) -> List[Tuple[Any, ...]]:\n        \"\"\"Returns the stored list of tuples.\"\"\"\n        return self._items\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the collection is empty.\"\"\"\n        return len(self._items) == 0\n\nclass TupleEqualityService:\n    \"\"\"Provides business logic for checking tuple length equality.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def are_all_equal_length(self, collection: TupleCollection) -> bool:\n        \"\"\"Determines if all tuples in the collection have the same length.\"\"\"\n        items = collection.as_list()\n        lengths = self._compute_length_set(items)\n        return len(lengths) == 1\n\n    def _compute_length_set(self, tuples: List[Tuple[Any, ...]]) -> Set[int]:\n        \"\"\"Computes the set of distinct lengths for given tuples.\"\"\"\n        return {tuple_length(t) for t in tuples}\n\nclass TupleRepository:\n    \"\"\"Adapts various input sources into a TupleCollection.\"\"\"\n    def from_list(self, items: Iterable[Any]) -> TupleCollection:\n        \"\"\"Creates a TupleCollection from an iterable of items.\"\"\"\n        return TupleCollection(items)\n\n    def from_json(self, json_str: str) -> TupleCollection:\n        \"\"\"Parses a JSON string into a TupleCollection.\"\"\"\n        try:\n            parsed = json.loads(json_str)\n        except json.JSONDecodeError as exc:\n            raise InvalidInputError(f\"JSON parse error: {exc}\") from exc\n        if not isinstance(parsed, list):\n            raise InvalidInputError(\"Top-level JSON must be a list\")\n        normalized = [tuple(x) if isinstance(x, list) else x for x in parsed]\n        return TupleCollection(normalized)\n\nclass TupleController:\n    \"\"\"Orchestrates repository and service to provide the public API.\"\"\"\n    def __init__(self, repo: TupleRepository, service: TupleEqualityService) -> None:\n        self._repo = repo\n        self._service = service\n\n    def get_equal(self, items: Iterable[Any]) -> bool:\n        \"\"\"Processes an iterable of items to check if all tuples have equal length.\"\"\"\n        collection = self._repo.from_list(items)\n        return self._service.are_all_equal_length(collection)\n\n# Initialize the core components as singletons for the module's public API.\n_repo = TupleRepository()\n_service = TupleEqualityService()\n_controller = TupleController(_repo, _service)\n\ndef get_equal(items: Iterable[Tuple[Any, ...]]) -> bool:\n    \"\"\"\n    Checks if all given tuples have equal length.\n    Raises InvalidInputError if the input collection is empty or contains non-tuple elements.\n    \"\"\"\n    return _controller.get_equal(items)"}
{"task_id": "Mbpp/68", "solution": "from typing import List\n\ndef is_Monotonic(arr: List[int]) -> bool:\n    \"\"\"\n    Checks if the given array is monotonic (non-increasing or non-decreasing).\n    An array with fewer than 2 elements is considered monotonic.\n    \"\"\"\n    n = len(arr)\n    if n < 2:\n        return True\n\n    is_non_decreasing = True\n    is_non_increasing = True\n\n    for i in range(1, n):\n        if arr[i] < arr[i-1]:\n            is_non_decreasing = False\n        if arr[i] > arr[i-1]:\n            is_non_increasing = False\n        \n        # If it's neither non-decreasing nor non-increasing, it's not monotonic.\n        if not is_non_decreasing and not is_non_increasing:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/72", "solution": "def dif_Square(n: int) -> bool:\n    \"\"\"\n    Checks if an integer can be represented as the difference of two squares.\n    An integer n is representable as x^2 - y^2 if and only if n % 4 != 2.\n    \"\"\"\n    return (n % 4) != 2"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(seq, pattern):\n    \"\"\"\n    Checks if two sequences follow the same pattern, maintaining a bijective mapping.\n    Returns True if a consistent one-to-one mapping exists, False otherwise.\n    \"\"\"\n    if len(seq) != len(pattern):\n        return False\n\n    p_to_s = {}  # Maps pattern element to sequence element\n    s_to_p = {}  # Maps sequence element to pattern element\n\n    for i in range(len(seq)):\n        p_char = pattern[i]\n        s_char = seq[i]\n\n        # Check mapping from pattern to sequence\n        if p_char in p_to_s:\n            if p_to_s[p_char] != s_char:\n                return False  # Inconsistent mapping for p_char\n        else:\n            p_to_s[p_char] = s_char\n\n        # Check mapping from sequence to pattern (ensuring bijectivity)\n        if s_char in s_to_p:\n            if s_to_p[s_char] != p_char:\n                return False  # s_char already mapped by a different p_char\n        else:\n            s_to_p[s_char] = p_char\n            \n    return True"}
{"task_id": "Mbpp/75", "solution": "```python\nfrom typing import List, Tuple\n\ndef find_tuples(data: List[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n    \"\"\"\n    Finds tuples where all elements are divisible by k from a list of tuples.\n    Assumes valid input: data is a list of tuples, k is a positive integer.\n    \"\"\"\n    results: List[Tuple[int, ...]] = []\n    for t in data:\n        if all((e % k) == 0 for e in t):\n            results.append(t)\n    return results\n```"}
{"task_id": "Mbpp/77", "solution": "def is_Diff(n: int | str) -> bool:\n    \"\"\"\n    Checks if a number is divisible by 11 using the alternating sum of digits method.\n    Handles both integer and string representations of numbers.\n    \"\"\"\n    # Convert input to an integer. This handles both int and str types\n    # as long as the string represents a valid integer.\n    num_val = int(str(n))\n    \n    # Work with the absolute value for the divisibility test.\n    abs_n = abs(num_val)\n    \n    # Convert the absolute number to a string to easily iterate over its digits.\n    s_abs_n = str(abs_n)\n    \n    alternating_sum = 0\n    sign = 1  # Start with + for the rightmost digit\n    \n    # Iterate through digits from right to left (least significant to most significant)\n    for digit_char in reversed(s_abs_n):\n        digit = int(digit_char)\n        alternating_sum += sign * digit\n        sign *= -1  # Toggle the sign for the next digit\n            \n    # A number is divisible by 11 if its alternating sum of digits is divisible by 11.\n    return (alternating_sum % 11) == 0"}
{"task_id": "Mbpp/82", "solution": "import math\nfrom typing import Any\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\nclass InputValidator:\n    \"\"\"Utility for parsing and validating input radius.\"\"\"\n    @staticmethod\n    def parse_radius(value: Any) -> float:\n        try:\n            if isinstance(value, str):\n                v = value.strip()\n            else:\n                v = value\n            f = float(v)\n        except Exception:\n            raise ValidationError(f\"radius must be a number, got {value!r}\")\n        if f < 0:\n            raise ValidationError(\"radius must be non-negative\")\n        return f\n\nclass SphereModel:\n    \"\"\"Domain model for a sphere with validation.\"\"\"\n    def __init__(self, radius: float) -> None:\n        self._radius: float = radius\n        self.validate()\n\n    def validate(self) -> None:\n        if not isinstance(self._radius, (int, float)):\n            raise ValidationError(\"radius must be a number\")\n        if self._radius < 0:\n            raise ValidationError(\"radius must be non-negative\")\n\n    def volume_formula(self) -> float:\n        \"\"\"Calculates radius cubed.\"\"\"\n        return self._radius ** 3\n\n    @property\n    def radius(self) -> float:\n        return float(self._radius)\n\nclass VolumeService:\n    \"\"\"Service to compute the volume of a sphere.\"\"\"\n    def __init__(self, pi: float = None) -> None:\n        self._pi = pi if pi is not None else math.pi\n\n    def compute(self, sphere: SphereModel) -> float:\n        # V = 4/3 * pi * r^3\n        r3 = sphere.volume_formula()\n        return (4.0 / 3.0) * self._pi * r3\n\ndef volume_sphere(radius: float) -> float:\n    \"\"\"\n    Calculates the volume of a sphere given its radius.\n    Raises ValidationError if the radius is invalid.\n    \"\"\"\n    r = InputValidator.parse_radius(radius)\n    sphere = SphereModel(r)\n    svc = VolumeService()\n    return svc.compute(sphere)"}
