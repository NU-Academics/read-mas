{"task_id": "Mbpp/125", "solution": "def find_length(s: str) -> int:\n    \"\"\"\n    Finds the maximum difference (count of '0's minus count of '1's)\n    in any non-empty substring of the given binary string.\n    \"\"\"\n    max_so_far = None\n    current_max = None\n\n    for char in s:\n        score = 1 if char == '0' else -1\n\n        if current_max is None:\n            # Initialize for the first element\n            current_max = score\n            max_so_far = score\n        else:\n            # Kadane's algorithm logic\n            current_max = max(score, current_max + score)\n            max_so_far = max(max_so_far, current_max)\n            \n    # As per problem constraints and design context, input string `s` is non-empty.\n    # Therefore, max_so_far will always be initialized and non-None.\n    return max_so_far"}
{"task_id": "Mbpp/120", "solution": "from dataclasses import dataclass\nfrom typing import Union, Iterable, Any, List, Tuple\n\nclass MaxProductError(Exception):\n    \"\"\"Base package exception.\"\"\"\n\nclass ValidationError(MaxProductError):\n    \"\"\"Raised for invalid inputs.\"\"\"\n\nclass EmptyInputError(MaxProductError):\n    \"\"\"Raised for empty input sequences.\"\"\"\n\nNumber = Union[int, float]\n\n@dataclass(frozen=True)\nclass TuplePair:\n    a: Number\n    b: Number\n\n    def product(self) -> Number:\n        return self.a * self.b\n\nclass Validator:\n    NUMERIC_TYPES = (int, float)\n\n    @staticmethod\n    def _coerce_to_number(value: Any) -> float | int:\n        if isinstance(value, Validator.NUMERIC_TYPES):\n            return value\n        if isinstance(value, str):\n            if \".\" in value:\n                return float(value)\n            return int(value)\n        raise ValueError(f\"Cannot coerce {value!r} to number\")\n\n    @staticmethod\n    def validate_pairs(pairs: Iterable[Tuple[Any, Any]]) -> List[TuplePair]:\n        if pairs is None:\n            raise ValidationError(\"Input is None\")\n        \n        validated = []\n        for idx, item in enumerate(pairs):\n            if not isinstance(item, (tuple, list)) or len(item) != 2:\n                raise ValidationError(f\"Item at index {idx} is not a 2-tuple or 2-list: {item!r}\")\n            a, b = item\n            try:\n                a_num = Validator._coerce_to_number(a)\n                b_num = Validator._coerce_to_number(b)\n            except ValueError as e:\n                raise ValidationError(f\"Non-numeric value at index {idx}: {e}\")\n            validated.append(TuplePair(a_num, b_num))\n        \n        if not validated:\n            raise EmptyInputError(\"Input sequence is empty\")\n        \n        return validated\n\nclass MaxProductService:\n    def max_product(self, pairs: Iterable[TuplePair]) -> float | int:\n        iterator = iter(pairs)\n        try:\n            first = next(iterator)\n        except StopIteration:\n            raise EmptyInputError(\"No pairs to compute\")\n\n        max_abs = abs(first.product())\n        for p in iterator:\n            val = abs(p.product())\n            if val > max_abs:\n                max_abs = val\n        return max_abs\n\nclass MaxProductController:\n    def __init__(self, service: MaxProductService = None, validator: Validator = None):\n        self.service = service or MaxProductService()\n        self.validator = validator or Validator()\n\n    def compute_max_product(self, raw_pairs: Iterable[Iterable[Any]]) -> float | int:\n        validated = self.validator.validate_pairs(raw_pairs)\n        return self.service.max_product(validated)\n\ndef max_product_tuple(pairs: Iterable[Tuple[Any, Any]]) -> float | int:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples.\n    This function validates input and computes the maximum absolute product.\n    \"\"\"\n    controller = MaxProductController()\n    return controller.compute_max_product(pairs)"}
