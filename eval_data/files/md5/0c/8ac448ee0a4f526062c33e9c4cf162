{"task_id": "Mbpp/84", "solution": "import threading\n\nclass InMemoryRepository:\n    \"\"\"A thread-safe in-memory cache for Newman-Conway sequence values.\"\"\"\n    def __init__(self) -> None:\n        # Initialize with base cases for the Newman-Conway sequence.\n        self._store: dict[int, int] = {1: 1, 2: 1}\n        self._lock = threading.Lock()\n\n    def get(self, index: int) -> int | None:\n        \"\"\"Retrieves a value from the cache by index.\"\"\"\n        with self._lock:\n            return self._store.get(index)\n\n    def set(self, index: int, value: int) -> None:\n        \"\"\"Stores a value in the cache at the given index.\"\"\"\n        with self._lock:\n            self._store[index] = value\n\n    def has(self, index: int) -> bool:\n        \"\"\"Checks if a value exists in the cache for the given index.\"\"\"\n        with self._lock:\n            return index in self._store\n\nclass SequenceService:\n    \"\"\"Computes Newman-Conway sequence values with memoization.\"\"\"\n    def __init__(self, repo: InMemoryRepository) -> None:\n        self._repo = repo\n\n    def compute(self, n: int) -> int:\n        \"\"\"Calculates the nth Newman-Conway number using a repository for memoization.\"\"\"\n        if self._repo.has(n):\n            return self._repo.get(n)\n\n        # Iteratively compute values from 3 up to n, leveraging the cache.\n        for i in range(3, n + 1):\n            if not self._repo.has(i):\n                # a(i) = a(a(i-1)) + a(i - a(i-1))\n                val_i_minus_1 = self.compute(i - 1) # This ensures a(i-1) is computed and cached.\n\n                term1_index = val_i_minus_1\n                term2_index = i - val_i_minus_1\n\n                # Recursively call compute to ensure these terms are calculated and cached.\n                term1 = self.compute(term1_index)\n                term2 = self.compute(term2_index)\n\n                self._repo.set(i, term1 + term2)\n        \n        return self._repo.get(n)\n\ndef sequence(n: int) -> int:\n    \"\"\"Finds the nth number in the Newman-Conway sequence.\"\"\"\n    repo = InMemoryRepository()\n    service = SequenceService(repo)\n    return service.compute(n)"}
{"task_id": "Mbpp/80", "solution": "import sys\nfrom datetime import datetime, timezone\nimport json\nimport os\nimport tempfile\n\nclass InvalidInputError(ValueError):\n    pass\n\nclass ComputationError(RuntimeError):\n    pass\n\nclass TetrahedralResult:\n    \"\"\"DTO for computed tetrahedral numbers.\"\"\"\n    def __init__(self, n: int, value: int, computed_at: datetime) -> None:\n        self.n = n\n        self.value = value\n        self.computed_at = computed_at\n\n    def to_dict(self) -> dict:\n        return {\n            \"n\": self.n,\n            \"value\": self.value,\n            \"computed_at\": self.computed_at.isoformat()\n        }\n\nclass MathUtils:\n    \"\"\"Utility class for mathematical computations.\"\"\"\n    @staticmethod\n    def compute_tetrahedral_formula(n: int) -> int:\n        \"\"\"Calculates the nth tetrahedral number using the direct formula.\"\"\"\n        return (n * (n + 1) * (n + 2)) // 6\n\nclass Validator:\n    \"\"\"Validates input parameters.\"\"\"\n    MAX_N_SAFE = 10**7 # From config.py\n\n    def validate_n(self, n: int) -> None:\n        \"\"\"Ensures n is a valid positive integer within safe limits.\"\"\"\n        if not isinstance(n, int):\n            raise InvalidInputError(\"n must be an int\")\n        if n < 1:\n            raise InvalidInputError(\"n must be >= 1\")\n        if n > self.MAX_N_SAFE:\n            raise InvalidInputError(f\"n is too large (max {self.MAX_N_SAFE})\")\n\nclass CacheRepository:\n    \"\"\"Manages file-backed and in-memory caching of tetrahedral numbers.\"\"\"\n    DEFAULT_CACHE_PATH = os.path.expanduser(\"~/.cache/tetrahedral/cache.json\")\n    CACHE_RETENTION_DAYS = 30 # From config.py\n\n    def __init__(self, path: str = DEFAULT_CACHE_PATH, retention_days: int = CACHE_RETENTION_DAYS) -> None:\n        self._path = path\n        self._retention_days = retention_days\n        self._in_memory = {}\n        self._load()\n\n    def _load(self) -> None:\n        \"\"\"Loads cache from file, filtering out expired entries.\"\"\"\n        if not os.path.exists(self._path):\n            return\n\n        try:\n            with open(self._path, 'r', encoding='utf-8') as f:\n                data = json.load(f)\n            \n            cutoff = datetime.now(timezone.utc) - timedelta(days=self._retention_days)\n            for n_str, entry in data.items():\n                try:\n                    computed_at = datetime.fromisoformat(entry['computed_at']).replace(tzinfo=timezone.utc)\n                    if computed_at >= cutoff:\n                        self._in_memory[int(n_str)] = (entry['value'], computed_at.isoformat())\n                except (ValueError, KeyError):\n                    # Log warning about malformed cache entry\n                    pass\n        except (IOError, json.JSONDecodeError):\n            # Log warning about cache load failure\n            pass\n\n    def _atomic_write(self, data: dict) -> None:\n        \"\"\"Atomically writes data to the cache file.\"\"\"\n        os.makedirs(os.path.dirname(self._path), exist_ok=True)\n        tmp_dir = os.path.dirname(self._path)\n        with tempfile.NamedTemporaryFile(delete=False, dir=tmp_dir, mode='w', encoding='utf-8') as tmp:\n            json.dump(data, tmp, indent=2)\n        \n        # Ensure data is written to disk before renaming\n        os.fsync(tmp.fileno()) \n        os.replace(tmp.name, self._path)\n\n    def get(self, n: int) -> tuple[int, str] | None:\n        \"\"\"Retrieves a cached value for n, if not expired.\"\"\"\n        entry = self._in_memory.get(n)\n        if entry:\n            value, computed_at_iso = entry\n            computed_at = datetime.fromisoformat(computed_at_iso).replace(tzinfo=timezone.utc)\n            if datetime.now(timezone.utc) - computed_at <= timedelta(days=self._retention_days):\n                return value, computed_at_iso\n            else:\n                del self._in_memory[n] # Expired, remove from in-memory\n                # Don't write back immediately, let a `set` or next `_atomic_write` handle it\n        return None\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a new value in the cache.\"\"\"\n        try:\n            computed_at = datetime.now(timezone.utc)\n            self._in_memory[n] = (value, computed_at.isoformat())\n            \n            # Prepare data for atomic write, ensuring only valid entries are written\n            data_to_write = {str(k): {'value': v[0], 'computed_at': v[1]} \n                             for k, v in self._in_memory.items() \n                             if datetime.now(timezone.utc) - datetime.fromisoformat(v[1]).replace(tzinfo=timezone.utc) <= timedelta(days=self._retention_days)}\n\n            self._atomic_write(data_to_write)\n        except (IOError, json.JSONDecodeError):\n            # Log warning about cache write failure\n            pass\n\n    def clear(self) -> None:\n        \"\"\"Clears both in-memory and persistent cache.\"\"\"\n        self._in_memory.clear()\n        try:\n            if os.path.exists(self._path):\n                os.remove(self._path)\n        except OSError:\n            # Log warning about cache file deletion failure\n            pass\n\nclass TetrahedralService:\n    \"\"\"Service to compute tetrahedral numbers, integrating validation and caching.\"\"\"\n    def __init__(self, cache_repo: CacheRepository, validator: Validator) -> None:\n        self._cache = cache_repo\n        self._validator = validator\n\n    def compute(self, n: int) -> TetrahedralResult:\n        \"\"\"Computes the nth tetrahedral number, using cache if available.\"\"\"\n        self._validator.validate_n(n)\n        \n        cached = self._cache.get(n)\n        if cached:\n            value, computed_at_iso = cached\n            computed_at = datetime.fromisoformat(computed_at_iso).replace(tzinfo=timezone.utc)\n            return TetrahedralResult(n=n, value=value, computed_at=computed_at)\n        \n        value = MathUtils.compute_tetrahedral_formula(n)\n        self._cache.set(n, value)\n        \n        return TetrahedralResult(n=n, value=value, computed_at=datetime.now(timezone.utc))\n\nclass ServiceFactory:\n    \"\"\"Factory for creating TetrahedralService instances.\"\"\"\n    @staticmethod\n    def create_service(config: dict | None = None) -> TetrahedralService:\n        \"\"\"Constructs and returns a TetrahedralService instance.\"\"\"\n        config = config or {}\n        cache_path = config.get(\"cache_path\", CacheRepository.DEFAULT_CACHE_PATH)\n        cache_retention_days = config.get(\"cache_retention_days\", CacheRepository.CACHE_RETENTION_DAYS)\n        \n        cache_repo = CacheRepository(path=cache_path, retention_days=cache_retention_days)\n        validator = Validator()\n        return TetrahedralService(cache_repo, validator)\n\nfrom datetime import timedelta\n\ndef tetrahedral_number(n: int) -> int:\n    \"\"\"\n    Finds the nth tetrahedral number.\n    \"\"\"\n    service = ServiceFactory.create_service()\n    result = service.compute(n)\n    return result.value"}
