{"task_id": "Mbpp/14", "solution": "def find_Volume(base, height, length):\n    \"\"\"\n    Calculates the volume of a triangular prism.\n    The volume is derived from the area of the triangular base multiplied by the prism's length.\n    \"\"\"\n    triangle_area = 0.5 * base * height\n    volume = triangle_area * length\n    return volume"}
{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(src, filt):\n    \"\"\"\n    Removes characters from the first string that are present in the second string.\n    The removal is case-sensitive by default.\n    \"\"\"\n    \n    # Create a set of characters to be removed from the filter string for efficient lookup.\n    # Based on design context's build_filter_set for case_insensitive=False.\n    to_remove = set(filt)\n    \n    out_chars = []\n    for ch in src:\n        # Append character if it's not in the set of characters to remove.\n        # Default behavior: case-sensitive, whitespace is preserved unless in filt.\n        if ch not in to_remove:\n            out_chars.append(ch)\n            \n    return \"\".join(out_chars)"}
{"task_id": "Mbpp/12", "solution": "def sort_matrix(matrix):\n    \"\"\"\n    Sorts a matrix (list of lists) by the ascending sum of its rows.\n    Uses Python's built-in sorted function with a lambda key for row sums, preserving original order for ties.\n    \"\"\"\n    return sorted(matrix, key=lambda row: sum(row))"}
{"task_id": "Mbpp/19", "solution": "import datetime\nfrom typing import List, Optional, Tuple, Sequence, Dict, Any, Protocol\n\nclass DuplicateError(Exception):\n    \"\"\"Base exception for duplicate checker operations.\"\"\"\n    pass\n\nclass DuplicateInputError(DuplicateError):\n    \"\"\"Exception raised for invalid input to duplicate checker functions.\"\"\"\n    pass\n\nclass RepositoryError(DuplicateError):\n    \"\"\"Exception raised for issues during repository operations.\"\"\"\n    pass\n\nDEFAULT_ALGORITHM: str = \"set\"\n\nclass DuplicateResult:\n    \"\"\"DTO for the result of a duplicate check.\"\"\"\n    def __init__(self, contains_duplicate: bool, algorithm: str) -> None:\n        self.contains_duplicate = contains_duplicate\n        self.algorithm = algorithm\n\n    def as_bool(self) -> bool:\n        \"\"\"Convenience method to return the boolean result.\"\"\"\n        return self.contains_duplicate\n\nclass DuplicateCheckRecord:\n    \"\"\"Record of a duplicate check operation.\"\"\"\n    def __init__(self, items: List[int], contains_duplicate: bool, timestamp: datetime.datetime) -> None:\n        self.items = items\n        self.contains_duplicate = contains_duplicate\n        self.timestamp = timestamp\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Converts the record to a dictionary.\"\"\"\n        return {\n            \"items\": self.items,\n            \"contains_duplicate\": self.contains_duplicate,\n            \"timestamp\": self.timestamp.isoformat()\n        }\n\n    @staticmethod\n    def from_dict(d: Dict[str, Any]) -> 'DuplicateCheckRecord':\n        \"\"\"Creates a record from a dictionary.\"\"\"\n        return DuplicateCheckRecord(\n            items=d[\"items\"],\n            contains_duplicate=d[\"contains_duplicate\"],\n            timestamp=datetime.datetime.fromisoformat(d[\"timestamp\"])\n        )\n\ndef is_valid_int_list(items: Sequence[Any]) -> bool:\n    \"\"\"\n    Checks if the given sequence is a valid list of integers.\n    Returns False if items is not a sequence, is None, or contains non-integer elements.\n    \"\"\"\n    if not isinstance(items, Sequence):\n        return False\n    # Explicit check for None, though Sequence type hint implies non-None\n    if items is None:\n        return False\n    return all(isinstance(item, int) for item in items)\n\nclass DuplicateCheckerUtil:\n    \"\"\"Utility class containing duplicate checking algorithms.\"\"\"\n    SUPPORTED_STRATEGIES: Tuple[str, ...] = (\"set\", \"sort\")\n\n    @staticmethod\n    def has_duplicates_set(items: List[int]) -> bool:\n        \"\"\"Detects duplicates in a list using a set for O(n) average time complexity.\"\"\"\n        seen = set()\n        for i in items:\n            if i in seen:\n                return True\n            seen.add(i)\n        return False\n\n    @staticmethod\n    def has_duplicates_sort(items: List[int]) -> bool:\n        \"\"\"Detects duplicates in a list by sorting for O(n log n) time complexity.\"\"\"\n        if not items:\n            return False\n        sorted_items = sorted(items)\n        for i in range(len(sorted_items) - 1):\n            if sorted_items[i] == sorted_items[i+1]:\n                return True\n        return False\n\nclass DuplicateRepository(Protocol):\n    \"\"\"Protocol for a repository storing DuplicateCheckRecord.\"\"\"\n    def save(self, record: DuplicateCheckRecord) -> None:\n        pass\n    def last(self) -> Optional[DuplicateCheckRecord]:\n        pass\n\nclass InMemoryRepository:\n    \"\"\"In-memory implementation of DuplicateRepository.\"\"\"\n    def __init__(self) -> None:\n        self._storage: Optional[DuplicateCheckRecord] = None\n\n    def save(self, record: DuplicateCheckRecord) -> None:\n        \"\"\"Saves the given record, overwriting any previous record.\"\"\"\n        self._storage = record\n\n    def last(self) -> Optional[DuplicateCheckRecord]:\n        \"\"\"Returns the last saved record, or None if no record exists.\"\"\"\n        return self._storage\n\nclass DuplicateService:\n    \"\"\"Business logic for checking duplicates and orchestrating operations.\"\"\"\n    def __init__(self, repository: Optional[DuplicateRepository] = None) -> None:\n        self._repository = repository\n\n    def check(self, items: List[int], strategy: Optional[str] = None) -> DuplicateResult:\n        \"\"\"\n        Checks for duplicates in a list of integers using a specified strategy.\n        Raises DuplicateInputError for invalid input or DuplicateError for unsupported strategies.\n        \"\"\"\n        if not is_valid_int_list(items):\n            raise DuplicateInputError(\"items must be a sequence of integers.\")\n\n        algorithm = strategy or DEFAULT_ALGORITHM\n        if algorithm not in DuplicateCheckerUtil.SUPPORTED_STRATEGIES:\n            raise DuplicateError(f\"Unsupported strategy '{algorithm}'. Supported strategies are: {', '.join(DuplicateCheckerUtil.SUPPORTED_STRATEGIES)}\")\n\n        contains: bool\n        if algorithm == \"set\":\n            contains = DuplicateCheckerUtil.has_duplicates_set(items)\n        elif algorithm == \"sort\":\n            contains = DuplicateCheckerUtil.has_duplicates_sort(items)\n        else:\n            # This branch should ideally not be reached due to the check above\n            raise DuplicateError(f\"Logic error: unhandled strategy {algorithm}\")\n\n        result = DuplicateResult(contains, algorithm)\n\n        if self._repository:\n            # Create a copy of items for the record to prevent external modification issues\n            record = DuplicateCheckRecord(list(items), contains, datetime.datetime.now())\n            try:\n                self._repository.save(record)\n            except Exception as e:\n                raise RepositoryError(f\"Failed to save record to repository: {e}\")\n\n        return result\n\nclass DuplicateController:\n    \"\"\"Controller class providing the public API for duplicate checking.\"\"\"\n    def __init__(self, service: DuplicateService) -> None:\n        self.service = service\n\n    def test_duplicate(self, items: List[int], strategy: Optional[str] = None) -> bool:\n        \"\"\"\n        Checks if the given array of integers contains any duplicate element.\n        Delegates to the service layer and returns a boolean result.\n        \"\"\"\n        result = self.service.check(items, strategy)\n        return result.as_bool()\n\ndef test_duplicate(items: List[int], strategy: Optional[str] = None) -> bool:\n    \"\"\"\n    Checks if the given array of integers contains any duplicate element.\n    This is a convenience wrapper that sets up the default components.\n    \"\"\"\n    repository = InMemoryRepository() # Default in-memory repository for transient checks\n    service = DuplicateService(repository=repository)\n    controller = DuplicateController(service=service)\n    return controller.test_duplicate(items, strategy)"}
{"task_id": "Mbpp/56", "solution": "def check(n):\n    \"\"\"Checks if a number is one less than twice its reverse.\"\"\"\n    # Compute the reverse of the absolute value of n\n    sign = -1 if n < 0 else 1\n    x = abs(n)\n    reversed_n_abs = 0\n    while x > 0:\n        reversed_n_abs = reversed_n_abs * 10 + (x % 10)\n        x //= 10\n    \n    # Apply the original sign to the reversed number\n    reversed_n = reversed_n_abs * sign\n\n    # Check if n is one less than twice its reverse\n    return n == (2 * reversed_n - 1)"}
{"task_id": "Mbpp/58", "solution": "def opposite_Signs(a, b):\n    \"\"\"\n    Checks if two integers have opposite signs using multiplication.\n    The product of two numbers with opposite signs is negative.\n    \"\"\"\n    return (a * b) < 0"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(value: int) -> bool:\n    \"\"\"\n    Checks if the given number is a Woodall number.\n    A Woodall number is of the form n * 2^n - 1 for an integer n >= 1.\n    \"\"\"\n    MAX_N_SEARCH_LIMIT = 1000\n\n    if value < 1:\n        # Woodall numbers generated by n >= 1 are always positive (1, 7, 23, 63, 159, 383, ...).\n        return False\n\n    for n in range(1, MAX_N_SEARCH_LIMIT + 1):\n        woodall_candidate = (n << n) - 1  # Computes n * (2**n) - 1\n\n        if woodall_candidate == value:\n            return True\n        \n        # Since n * 2^n - 1 is monotonically increasing for n >= 1,\n        # if the candidate value exceeds the target, we can stop searching.\n        if woodall_candidate > value:\n            return False\n            \n    # If no matching n is found within the search limit, it's not a Woodall number.\n    return False"}
{"task_id": "Mbpp/59", "solution": "def nth_octagonal(n):\n    \"\"\"\n    Computes the nth octagonal number using the formula n * (3n - 2).\n    Assumes n is a valid positive integer based on design context.\n    \"\"\"\n    return n * (3 * n - 2)"}
{"task_id": "Mbpp/61", "solution": "import collections\n\ndef count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts substrings where the sum of digits equals the substring length using prefix sums.\n    This is equivalent to counting subarrays where (digit - 1) sums to zero.\n    \"\"\"\n    freq = collections.defaultdict(int)\n    freq[0] = 1  # For subarrays starting from index 0\n    prefix_sum = 0\n    total_count = 0\n    for char_digit in s:\n        digit = int(char_digit)\n        prefix_sum += (digit - 1)\n        total_count += freq[prefix_sum]\n        freq[prefix_sum] += 1\n    return total_count"}
{"task_id": "Mbpp/57", "solution": "from typing import List\n\ndef find_Max_Num(digits: List[int]) -> int:\n    # Convert each digit to its string representation.\n    strs = [str(d) for d in digits]\n\n    # Sort the string representations to form the largest possible number.\n    # The custom key `lambda x: x*10` allows for comparing numbers formed by concatenating them,\n    # specifically for single-digit inputs (0-9), by effectively making all strings the same length for comparison.\n    strs.sort(key=lambda x: x * 10, reverse=True)\n\n    # Join the sorted strings to form the final number string.\n    joined_str = ''.join(strs)\n\n    # Convert the joined string to an integer.\n    # Handle cases with leading zeros or inputs like [0, 0, 0] which should result in 0.\n    # `lstrip('0')` removes leading zeros. If the string becomes empty (e.g., from '000'), default to '0'.\n    return int(joined_str.lstrip('0') or '0')"}
{"task_id": "Mbpp/63", "solution": "from typing import List, Tuple\n\ndef max_difference(tuple_list: List[Tuple[int, int]]) -> int:\n    \"\"\"\n    Finds the maximum absolute difference between elements in each pair of the given tuple list.\n    Assumes the input list is not empty and contains valid 2-element integer tuples.\n    \"\"\"\n    max_diff = 0\n    for a, b in tuple_list:\n        current_diff = abs(a - b)\n        if current_diff > max_diff:\n            max_diff = current_diff\n    return max_diff"}
{"task_id": "Mbpp/62", "solution": "from typing import Iterable, Union\n\ndef smallest_num(nums: Iterable[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Finds the smallest number in a given iterable of numbers.\n    Assumes the iterable is non-empty and contains only numeric types.\n    \"\"\"\n    it = iter(nums)\n    smallest = next(it)\n\n    for num in it:\n        if num < smallest:\n            smallest = num\n    return smallest"}
{"task_id": "Mbpp/64", "solution": "import operator\nfrom typing import List, Tuple\n\ndef subject_marks(records: List[Tuple[str, int]]) -> List[Tuple[str, int]]:\n    \"\"\"\n    Sorts a list of subject-mark tuples by the mark (second element) in ascending order.\n    The sorting is stable, preserving the relative order of tuples with equal marks.\n    \"\"\"\n    return sorted(records, key=operator.itemgetter(1))"}
{"task_id": "Mbpp/67", "solution": "```python\ndef bell_number(n: int) -> int:\n    \"\"\"\n    Computes the nth Bell number using the Bell triangle dynamic programming method.\n    Bell numbers count the number of partitions of a set with n elements.\n    \"\"\"\n    if n == 0:\n        return 1\n    \n    # Initialize the Bell triangle with B[0][0] = 1\n    # The triangle will store rows, where each row is a list of integers.\n    # B[i][j] is stored as triangle[i][j]\n    triangle = [[1]]\n\n    for i in range(1, n + 1):\n        # The first element of the current row is the last element of the previous row.\n        # B[i][0] = B[i-1][i-1]\n        row = [triangle[i-1][-1]]\n        \n        # Subsequent elements in the row are calculated using the formula:\n        # B[i][j] = B[i][j-1] + B[i-1][j-1]\n        for j in range(1, i + 1):\n            row.append(row[-1] + triangle[i-1][j-1])\n        \n        triangle.append(row)\n    \n    # The nth Bell number is the first element of the nth row (B[n][0])\n    return triangle[n][0]\n```"}
