{"task_id": "Mbpp/88", "solution": "from collections import defaultdict\nfrom typing import List, Any, Dict\n\ndef freq_count(items: List[Any]) -> Dict[Any, int]:\n    \"\"\"Computes the frequency of each element in a list, returning the result as a dictionary.\"\"\"\n    counts: Dict[Any, int] = defaultdict(int)\n    for item in items:\n        counts[item] += 1\n    return dict(counts)"}
{"task_id": "Mbpp/91", "solution": "from typing import List\n\ndef find_substring(values: List[str], pattern: str, case_insensitive: bool = False) -> bool:\n    \"\"\"\n    Checks if a string is present as a substring in any of the given list of string values.\n    \"\"\"\n    if case_insensitive:\n        pattern = pattern.lower()\n        for value in values:\n            if pattern in value.lower():\n                return True\n    else:\n        for value in values:\n            if pattern in value:\n                return True\n    return False"}
{"task_id": "Mbpp/89", "solution": "import math\n\ndef closest_num(n: float | int) -> int:\n    \"\"\"\n    Finds the largest integer strictly less than n.\n    If n is an integer, returns n - 1. Otherwise, returns floor(n).\n    \"\"\"\n    if float(n).is_integer():\n        return int(n) - 1\n    else:\n        return math.floor(n)"}
{"task_id": "Mbpp/86", "solution": "from typing import Any, Optional\n\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass InputValidator:\n    \"\"\"Validates and normalizes input values for centered hexagonal numbers.\"\"\"\n    def validate_positive_integer(self, n: Any) -> int:\n        \"\"\"Ensures n is an integer >= 1, converting from string if possible.\"\"\"\n        try:\n            if isinstance(n, str):\n                n_conv = int(n.strip())\n            else:\n                n_conv = int(n)\n        except (ValueError, TypeError):\n            raise InvalidInputError(\"n must be an integer >= 1\")\n        if n_conv < 1:\n            raise InvalidInputError(\"n must be >= 1\")\n        return n_conv\n\nclass InMemoryCacheRepository:\n    \"\"\"Provides an in-memory cache for computed hexagonal numbers.\"\"\"\n    def __init__(self, persist_file: Optional[str] = None, load: bool = False) -> None:\n        self._store: dict[int, int] = {}\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a value from the cache by key n.\"\"\"\n        return self._store.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a value in the cache with key n.\"\"\"\n        self._store[n] = value\n\nclass HexagonalService:\n    \"\"\"Orchestrates validation, caching, and computation of centered hexagonal numbers.\"\"\"\n    def __init__(self, repo: InMemoryCacheRepository, validator: InputValidator) -> None:\n        self._repo = repo\n        self._validator = validator\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the nth centered hexagonal number, using cache if available.\"\"\"\n        n_valid = self._validator.validate_positive_integer(n)\n        cached = self._repo.get(n_valid)\n        if cached is not None:\n            return cached\n        \n        value = 3 * n_valid * (n_valid - 1) + 1\n        self._repo.set(n_valid, value)\n        return value\n\ndef centered_hexagonal_number(n: int) -> int:\n    \"\"\"\n    Computes the nth centered hexagonal number using a service layer with caching and validation.\n    \"\"\"\n    repo = InMemoryCacheRepository()\n    validator = InputValidator()\n    service = HexagonalService(repo=repo, validator=validator)\n    return service.compute(n)"}
{"task_id": "Mbpp/90", "solution": "from typing import List, Optional, Any, Iterator\nfrom abc import ABC, abstractmethod\n\n# 1. Error Classes (from src/lenlog/errors.py)\nclass InvalidWordError(TypeError):\n    \"\"\"Exception raised for invalid word inputs.\"\"\"\n    pass\n\nclass ValidationError(ValueError):\n    \"\"\"Exception raised for general validation failures.\"\"\"\n    pass\n\n# 2. Validators (from src/lenlog/utils/validators.py)\nclass Validators:\n    \"\"\"Provides static helper methods for input validation and normalization.\"\"\"\n\n    @staticmethod\n    def is_string(obj: Any) -> bool:\n        \"\"\"Checks if an object is a string.\"\"\"\n        return isinstance(obj, str)\n\n    @staticmethod\n    def trim(word: str) -> str:\n        \"\"\"Removes leading and trailing whitespace from a string.\"\"\"\n        return word.strip()\n\n    @staticmethod\n    def normalize(word: str) -> str:\n        \"\"\"Normalizes a word (currently just trims whitespace).\"\"\"\n        return Validators.trim(word)\n\n# 3. WordDTO (from src/lenlog/models/word_dto.py)\nclass WordDTO:\n    \"\"\"Lightweight DTO representing a single word with its normalized form and length.\"\"\"\n\n    def __init__(self, raw: str):\n        if not Validators.is_string(raw):\n            raise InvalidWordError(f\"Word must be a string, got {type(raw).__name__}\")\n        self.raw: str = raw\n        self.normalized: str = Validators.normalize(raw)\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the normalized word.\"\"\"\n        return len(self.normalized)\n\n# 4. IWordRepository (from src/lenlog/repositories/i_word_repository.py)\nclass IWordRepository(ABC):\n    \"\"\"Abstract interface for word repository implementations.\"\"\"\n\n    @abstractmethod\n    def save(self, words: List[str]) -> None:\n        pass\n\n    @abstractmethod\n    def get_all(self) -> List[str]:\n        pass\n\n# 5. InMemoryWordRepository (from src/lenlog/repositories/in_memory_word_repository.py)\nclass InMemoryWordRepository(IWordRepository):\n    \"\"\"In-memory repository implementation for testing and local operations.\"\"\"\n\n    def __init__(self):\n        self._store: List[str] = []\n\n    def save(self, words: List[str]) -> None:\n        \"\"\"Stores a shallow copy of the provided list of words.\"\"\"\n        self._store = list(words)\n\n    def get_all(self) -> List[str]:\n        \"\"\"Returns a copy of the stored words.\"\"\"\n        return list(self._store)\n\n    def clear(self) -> None:\n        \"\"\"Clears all stored words.\"\"\"\n        self._store.clear()\n\n# 6. WordCollection (from src/lenlog/models/word_collection.py)\nclass WordCollection:\n    \"\"\"Validated container for WordDTO items.\"\"\"\n\n    def __init__(self, words: List[str]):\n        self._words: List[WordDTO] = []\n        for word_item in words:\n            try:\n                self._words.append(WordDTO(word_item))\n            except InvalidWordError as e:\n                # Re-raise to indicate an issue with a specific word input\n                raise InvalidWordError(f\"Invalid word '{word_item}' in collection: {e}\") from e\n\n    def validate(self) -> None:\n        \"\"\"Ensures all words in the collection are non-empty after trimming.\"\"\"\n        for dto in self._words:\n            if not dto.normalized:\n                raise InvalidWordError(f\"Word cannot be empty after trimming, got '{dto.raw}'\")\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the collection is empty.\"\"\"\n        return not bool(self._words)\n\n    def __iter__(self) -> Iterator[WordDTO]:\n        \"\"\"Returns an iterator over the WordDTOs.\"\"\"\n        return iter(self._words)\n\n    def as_raw_list(self) -> List[str]:\n        \"\"\"Returns the raw (unnormalized) words as a list of strings.\"\"\"\n        return [dto.raw for dto in self._words]\n\n# 7. LengthService (from src/lenlog/services/length_service.py)\nclass LengthService:\n    \"\"\"Core business logic for computing the longest word length.\"\"\"\n\n    def __init__(self, repository: Optional[IWordRepository] = None):\n        self._repo = repository\n\n    def longest_length(self, words: List[str]) -> int:\n        \"\"\"Computes the length of the longest word in a list of raw strings.\"\"\"\n        if self._repo:\n            self._repo.save(words)\n        if not words:\n            return 0\n        return max(len(w.strip()) for w in words)\n\n# 8. CLIController (from src/lenlog/controllers/cli_controller.py)\nclass CLIController:\n    \"\"\"Orchestrates validation and service invocation; provides the public API surface.\"\"\"\n\n    def __init__(self, repository: Optional[IWordRepository] = None, validator: Optional[Validators] = None):\n        self.repository: IWordRepository = repository or InMemoryWordRepository()\n        self.validator: Validators = validator or Validators()\n        self.service = LengthService(repository=self.repository)\n\n    def len_log(self, words: List[str]) -> int:\n        \"\"\"Public API: returns the length of the longest word in a list.\"\"\"\n        if not hasattr(words, '__iter__'):\n            raise TypeError(\"words must be an iterable of strings\")\n\n        try:\n            collection = WordCollection(words)\n            collection.validate()\n        except InvalidWordError as e:\n            # Re-raise with a generic message for the public API\n            raise InvalidWordError(f\"Invalid input word(s): {e}\") from e\n\n        return self.service.longest_length(collection.as_raw_list())\n\n# Package export: expose len_log function (from src/lenlog/__init__.py)\n_default_controller = CLIController()\n\ndef len_log(words: list[str]) -> int:\n    \"\"\"\n    Finds the length of the longest word in a list of words.\n\n    Input words are validated, trimmed, and their lengths compared.\n    \"\"\"\n    return _default_controller.len_log(words)"}
{"task_id": "Mbpp/92", "solution": "from .parser import NumberParser\nfrom .pattern import PatternChecker\nfrom .services import UndulatingService\nfrom . import config\n\ndef is_undulating(value):\n    \"\"\"\n    Checks if a number is undulating using the UndulatingService.\n    This is a convenience wrapper that returns a boolean.\n    \"\"\"\n    parser = NumberParser()\n    checker = PatternChecker()\n    # The convenience function doesn't need persistence, so repo is None.\n    service = UndulatingService(parser, checker, None, config)\n    return service.check(value).is_undulating"}
{"task_id": "Mbpp/93", "solution": "import os\nimport json\nimport tempfile\nfrom datetime import datetime\nfrom pathlib import Path\n\n# 1. Exceptions (from src/power_app/exceptions.py)\nclass PowerError(Exception):\n    \"\"\"Custom exception for power calculation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\n# 2. DTOs (from src/power_app/models.py)\nclass PowerRequest:\n    \"\"\"Data Transfer Object for power calculation request.\"\"\"\n    def __init__(self, a: float | int, b: int) -> None:\n        self.a = a\n        self.b = b\n\nclass PowerResult:\n    \"\"\"Data Transfer Object for power calculation result.\"\"\"\n    def __init__(self, result: float | int) -> None:\n        self.result = result\n\n# 3. Configuration (from src/power_app/config.py)\n_DEFAULT_CACHE_DIR = Path.home() / \".cache\" / \"power_app\"\n_DEFAULT_CACHE_DIR.mkdir(parents=True, exist_ok=True)\nCACHE_PATH: str = str(_DEFAULT_CACHE_DIR / \"cache.json\")\nCACHE_VERSION: int = 1\n\n# 4. Utilities (from src/power_app/utils.py)\ndef format_key(a: float | int, b: int) -> str:\n    \"\"\"Creates a deterministic cache key including type and version.\"\"\"\n    type_tag = \"int\" if isinstance(a, int) else \"float\"\n    return f\"{a}|{b}|{type_tag}|v{CACHE_VERSION}\"\n\n# 5. Algorithm Layer (from src/power_app/algorithms.py)\nclass PowerAlgorithm:\n    \"\"\"Implements exponentiation algorithms.\"\"\"\n    def fast_pow(self, a: float | int, b: int) -> float | int:\n        \"\"\"\n        Uses exponentiation by squaring for integer b; supports negative b.\n        Returns int when inputs are ints and result is whole number, else float.\n        \"\"\"\n        if b == 0:\n            if a == 0: # Python's 0**0 is 1\n                return 1\n            return 1\n\n        neg = b < 0\n        exponent = -b if neg else b\n        \n        # Ensure base is float if exponent is negative or 'a' is already a float\n        current_base = float(a) if neg or isinstance(a, float) else a\n        result = 1.0 if neg or isinstance(a, float) else 1\n\n        while exponent > 0:\n            if exponent & 1:\n                result *= current_base\n            current_base *= current_base\n            exponent >>= 1\n        \n        if neg:\n            if result == 0: # This implies original 'a' was 0, but b was negative.\n                raise PowerError(\"Cannot raise zero to a negative power.\")\n            return 1.0 / result\n        \n        # Convert result to int if 'a' was int and result is a whole number\n        if isinstance(a, int) and result == int(result):\n            return int(result)\n        return result\n\n    def fallback_pow(self, a: float | int, b: int) -> float | int:\n        \"\"\"Uses Python's built-in pow for general cases.\"\"\"\n        try:\n            return pow(a, b)\n        except ZeroDivisionError:\n            raise PowerError(\"Cannot raise zero to a negative power.\")\n        except OverflowError:\n            raise PowerError(\"Result exceeds maximum representable value.\")\n\n# 6. Repository Layer (from src/power_app/repositories.py)\nclass CacheRepository:\n    \"\"\"Manages file-backed JSON cache.\"\"\"\n    _store: dict[str, dict]\n\n    def __init__(self, path: str, version: int) -> None:\n        self._path = path\n        self._version = version\n        self._store = {}\n        self._load_cache()\n\n    def _load_cache(self) -> None:\n        \"\"\"Loads the cache from the file.\"\"\"\n        if os.path.exists(self._path):\n            try:\n                with open(self._path, \"r\") as f:\n                    self._store = json.load(f)\n            except (IOError, json.JSONDecodeError):\n                self._store = {}\n        keys_to_remove = [k for k in self._store if not k.endswith(f\"|v{self._version}\")]\n        for k in keys_to_remove:\n            del self._store[k]\n\n    def _save_cache(self) -> None:\n        \"\"\"Persists the cache to the file using atomic write.\"\"\"\n        os.makedirs(os.path.dirname(self._path), exist_ok=True)\n        tmp_fd, tmp_path = tempfile.mkstemp(dir=os.path.dirname(self._path))\n        try:\n            with os.fdopen(tmp_fd, \"w\") as f:\n                json.dump(self._store, f)\n            os.replace(tmp_path, self._path)\n        except IOError:\n            pass # Log error, continue without updating cache file\n        finally:\n            if os.path.exists(tmp_path):\n                os.remove(tmp_path)\n\n    def get(self, key: str) -> tuple[bool, float | int | None]:\n        \"\"\"Retrieves a value from the cache.\"\"\"\n        record = self._store.get(key)\n        if record and record.get(\"version\") == self._version:\n            return True, record.get(\"result\")\n        return False, None\n\n    def set(self, key: str, value: float | int) -> None:\n        \"\"\"Stores a value in the cache.\"\"\"\n        self._store[key] = {\n            \"result\": value,\n            \"computed_at\": datetime.utcnow().isoformat(timespec='seconds') + \"Z\",\n            \"version\": self._version,\n        }\n        self._save_cache()\n\n    def all_keys(self) -> list[str]:\n        \"\"\"Returns all keys in the cache for debugging/testing.\"\"\"\n        return list(self._store.keys())\n\n# 7. Service Layer (from src/power_app/services.py)\nclass PowerService:\n    \"\"\"Orchestrates validation, cache, and algorithm.\"\"\"\n    _algorithm: PowerAlgorithm\n    _cache: CacheRepository\n\n    def __init__(self, algorithm: PowerAlgorithm, cache: CacheRepository) -> None:\n        self._algorithm = algorithm\n        self._cache = cache\n\n    def compute(self, req: PowerRequest) -> PowerResult:\n        \"\"\"Computes a^b, utilizing cache and specific algorithms.\"\"\"\n        cache_key = format_key(req.a, req.b)\n        found, cached_result = self._cache.get(cache_key)\n        if found:\n            return PowerResult(cached_result)\n\n        # Primary algorithm is fast_pow for integer exponents\n        result = self._algorithm.fast_pow(req.a, req.b)\n        self._cache.set(cache_key, result)\n        return PowerResult(result)\n\n# 8. API Facade Layer (from src/power_app/api.py)\nclass APIFacade:\n    \"\"\"Public API facade for power calculation.\"\"\"\n    _service: PowerService\n\n    def __init__(self, service: PowerService) -> None:\n        self._service = service\n\n    def power(self, a: float | int, b: int) -> float | int:\n        \"\"\"Calculates 'a' to the power 'b'.\"\"\"\n        req = PowerRequest(a, b)\n        res = self._service.compute(req)\n        return res.result\n\n# 9. Global instances for the public function to use\n_power_algorithm_instance = PowerAlgorithm()\n_cache_repository_instance = CacheRepository(CACHE_PATH, CACHE_VERSION)\n_power_service_instance = PowerService(_power_algorithm_instance, _cache_repository_instance)\n_api_facade_instance = APIFacade(_power_service_instance)\n\ndef power(a: float | int, b: int) -> float | int:\n    \"\"\"\n    Calculates the value of 'a' to the power 'b'.\n    Utilizes caching and optimized algorithms internally.\n    \"\"\"\n    return _api_facade_instance.power(a, b)"}
{"task_id": "Mbpp/94", "solution": "from typing import List, Tuple, Any\n\ndef index_minimum(items: List[Tuple[Any, Any]]) -> Any:\n    \"\"\"\n    Returns the first value of the tuple with the smallest second value.\n    Assumes `items` is a non-empty list of 2-tuples with comparable second values.\n    \"\"\"\n    best_first_value = items[0][0]\n    min_second_value = items[0][1]\n\n    for first_value, second_value in items[1:]:\n        if second_value < min_second_value:\n            min_second_value = second_value\n            best_first_value = first_value\n\n    return best_first_value"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists):\n    \"\"\"Finds the length of the smallest list in a list of lists.\n    Returns 0 if the input list of lists is empty.\"\"\"\n    if not list_of_lists:\n        return 0\n    return min(len(sublist) for sublist in list_of_lists)"}
{"task_id": "Mbpp/98", "solution": "import math\nfrom typing import Iterable, Union, List\n\ndef multiply_num(numbers: Iterable[Union[int, float]]) -> float:\n    \"\"\"Multiplies all numbers in an iterable and divides the product by the iterable's length.\"\"\"\n    # Convert the iterable to a list of floats to ensure consistent arithmetic\n    # and to allow reliable determination of length.\n    float_numbers: List[float] = [float(n) for n in numbers]\n\n    list_length = len(float_numbers)\n\n    product = 1.0\n    for num in float_numbers:\n        product *= num\n\n    # Division by zero will occur naturally if list_length is 0,\n    # as per the constraint to not add custom exception handling for edge cases.\n    return product / list_length"}
{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer.\n    Assumes n is a positive integer or can be treated as its absolute value.\n    \"\"\"\n    if n == 0:\n        # Based on design context, 0 has undefined divisors for this library.\n        # This function is not meant to handle input validation or raise errors.\n        # The design context indicates an external 'Utils.validate_integer' would handle this.\n        # For direct implementation of the core logic, we assume valid non-zero input.\n        # However, to produce a working function that matches the test case `assert divisor(15) == 4`\n        # and implicitly assumes positive integers, we proceed with the core algorithm.\n        return 0 # Or handle as per context for direct implementation without Utils\n    \n    n = abs(n)\n    \n    if n == 1:\n        return 1\n\n    count = 0\n    i = 1\n    # Iterate from 1 up to the square root of n\n    while i * i <= n:\n        if n % i == 0:\n            # If i is a divisor, then n/i is also a divisor\n            # If i*i == n, then i and n/i are the same divisor (e.g., for perfect squares)\n            if i * i == n:\n                count += 1\n            else:\n                count += 2  # i and n/i are two distinct divisors\n        i += 1\n    return count"}
{"task_id": "Mbpp/97", "solution": "import collections\n\ndef frequency_lists(lists):\n    \"\"\"\n    Finds the frequency of each element in a flattened list of lists.\n    \"\"\"\n    counts = collections.Counter()\n    for sublist in lists:\n        for item in sublist:\n            counts[item] += 1\n    return dict(counts)"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(n):\n    \"\"\"Converts a non-negative decimal integer to its binary string representation.\"\"\"\n    if n == 0:\n        return \"0\"\n\n    bits = []\n    while n > 0:\n        bits.append(\"1\" if (n & 1) else \"0\")\n        n >>= 1\n    \n    bits.reverse()\n    return \"\".join(bits)"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(s: str) -> str:\n    \"\"\"\n    Converts a snake_case string to a PascalCase (UpperCamelCase) string.\n    Handles empty strings, multiple underscores, and preserves numeric tokens.\n    \"\"\"\n    if not s:\n        return \"\"\n\n    words = s.split('_')\n    camel_case_words = []\n    for word in words:\n        if word:  # Ignore empty tokens resulting from multiple underscores\n            camel_case_words.append(word.lower().capitalize())\n    \n    return \"\".join(camel_case_words)"}
