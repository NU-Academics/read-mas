{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"\n    Converts a decimal number to its binary equivalent as a string without leading zeros.\n    \"\"\"\n\n    def convert_decimal_to_binary(number: int) -> str:\n        \"\"\"\n        Core mathematical conversion from decimal to binary, producing a raw binary string.\n        \"\"\"\n        if number == 0:\n            return \"0\"\n        binary_representation = \"\"\n        while number > 0:\n            remainder = number % 2\n            binary_representation = str(remainder) + binary_representation\n            number //= 2\n        return binary_representation\n\n    def remove_leading_zeros(binary_string: str) -> str:\n        \"\"\"\n        Formats a binary string by removing leading zeros, unless the string is '0'.\n        \"\"\"\n        if binary_string == \"0\":\n            return \"0\"\n        \n        stripped_string = binary_string.lstrip('0')\n        if not stripped_string: # Handles cases like \"000\" which should result in \"0\"\n            return \"0\"\n        return stripped_string\n\n    raw_binary = convert_decimal_to_binary(decimal_number)\n    return remove_leading_zeros(raw_binary)"}
