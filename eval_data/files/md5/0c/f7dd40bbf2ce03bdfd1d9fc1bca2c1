{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    \"\"\"\n    n = len(s)\n\n    # For an empty string, 1 rotation (of 0 characters) is considered the minimum positive rotation\n    # to return the same string.\n    if n == 0:\n        return 1\n\n    # Iterate from 1 up to the length of the string to find the smallest rotation count.\n    for k in range(1, n + 1):\n        # Rotate the string by k positions: move the first k characters to the end.\n        rotated_s = s[k:] + s[:k]\n        \n        # If the rotated string is identical to the original, this 'k' is the minimum.\n        if rotated_s == s:\n            return k"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    This is equivalent to finding the shortest repeating period of the string.\n    \"\"\"\n    n = len(s)\n    # Iterate through all possible lengths for the repeating unit (period).\n    # The smallest period must be at least 1, and at most the length of the string itself.\n    for p in range(1, n + 1):\n        # A string can only be formed by repeating a substring of length 'p'\n        # if the total length 'n' is perfectly divisible by 'p'.\n        if n % p == 0:\n            # Check if the string 's' is actually formed by repeating its prefix of length 'p'.\n            # If s[:p] repeated (n // p) times equals the original string s,\n            # then 'p' is a period. Since we iterate from 1 upwards, the first 'p' found\n            # will be the minimum period.\n            if s[:p] * (n // p) == s:\n                return p\n    \n    # This line should theoretically not be reached, as 'p = n' will always satisfy\n    # the condition (s[:n] * 1 == s). However, it serves as a final safeguard.\n    return n"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, character: str) -> str:\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    If the character is not found or occurs only once, it's removed appropriately.\n    \"\"\"\n    first_occurrence = input_string.find(character)\n    last_occurrence = input_string.rfind(character)\n\n    if first_occurrence == -1:\n        # Character not found, return original string\n        return input_string\n    elif first_occurrence == last_occurrence:\n        # Character found only once, remove that single occurrence\n        return input_string[:first_occurrence] + input_string[first_occurrence + 1:]\n    else:\n        # Character found multiple times, remove both first and last occurrences\n        return input_string[:first_occurrence] + input_string[first_occurrence + 1:last_occurrence] + input_string[last_occurrence + 1:]"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string, target_char):\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    Returns the modified string.\n    \"\"\"\n    if not input_string:\n        return \"\"\n\n    first_pos = -1\n    last_pos = -1\n\n    # Find first occurrence\n    for i in range(len(input_string)):\n        if input_string[i] == target_char:\n            first_pos = i\n            break\n\n    if first_pos == -1:\n        return input_string  # Character not found\n\n    # Find last occurrence\n    for i in range(len(input_string) - 1, -1, -1):\n        if input_string[i] == target_char:\n            last_pos = i\n            break\n\n    # Reconstruct the string\n    if first_pos == last_pos: # Only one occurrence\n        return input_string[:first_pos] + input_string[first_pos+1:]\n    else: # Two or more occurrences\n        # Remove last_pos first to avoid index shift issues if removing from left to right\n        # However, it's safer to build a new string or remove by slicing\n        # Build the new string by skipping the first_pos and last_pos characters\n        result = []\n        for i in range(len(input_string)):\n            if i != first_pos and i != last_pos:\n                result.append(input_string[i])\n        return \"\".join(result)"}
