{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number a(n, m) using its explicit formula.\n    Eulerian numbers count permutations of {1, ..., n} with m ascents.\n    \"\"\"\n\n    def combinations(N, K):\n        \"\"\"Calculates the binomial coefficient C(N, K).\"\"\"\n        if K < 0 or K > N:\n            return 0\n        if K == 0 or K == N:\n            return 1\n        if K > N // 2:  # Optimization: C(N, K) = C(N, N-K)\n            K = N - K\n        \n        res = 1\n        for i in range(K):\n            res = res * (N - i) // (i + 1)\n        return res\n\n    total_sum = 0\n    # The formula for a(n, m) is sum_{k=0 to m} (-1)^k * C(n+1, k) * (m - k + 1)^n\n    for k in range(m + 1):\n        term = ((-1)**k) * combinations(n + 1, k) * ((m - k + 1)**n)\n        total_sum += term\n    \n    return total_sum"}
{"task_id": "Mbpp/103", "solution": "def combinations(n, k):\n    \"\"\"\n    Calculates the binomial coefficient C(n, k).\n    C(n, k) = n! / (k! * (n-k)!)\n    \"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n\n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\n\ndef compute_eulerian(n: int, m: int) -> int:\n    \"\"\"Core logic to calculate Eulerian number A(n, m) using its sum formula.\"\"\"\n    total_sum = 0\n    for k in range(m + 1):\n        term = ((-1)**k) * combinations(n + 1, k) * ((m - k + 1)**n)\n        total_sum += term\n    return total_sum\n\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number A(n, m), representing permutations of {1, ..., n} with m ascents.\n    Returns 0 if m is out of the valid range [0, n-1].\n    \"\"\"\n    if m < 0 or m >= n:\n        return 0\n    return compute_eulerian(n, m)"}
