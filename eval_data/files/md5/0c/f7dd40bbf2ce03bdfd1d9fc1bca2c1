{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix: List[List[int]]) -> bool:\n    \"\"\"\n    Validates whether a matrix is a magic square.\n    It checks if all rows, columns, and both main diagonals have equal sums.\n    \"\"\"\n    n = len(matrix)\n\n    if n == 0:\n        return False\n    \n    # Check if the matrix is square.\n    for row in matrix:\n        if len(row) != n:\n            return False\n\n    # Calculate the target sum from the first row.\n    target_sum = sum(matrix[0])\n\n    # Validate row sums.\n    for i in range(n):\n        if sum(matrix[i]) != target_sum:\n            return False\n\n    # Validate column sums.\n    for j in range(n):\n        current_col_sum = 0\n        for i in range(n):\n            current_col_sum += matrix[i][j]\n        if current_col_sum != target_sum:\n            return False\n\n    # Validate main diagonal sum.\n    main_diag_sum = 0\n    for i in range(n):\n        main_diag_sum += matrix[i][i]\n    if main_diag_sum != target_sum:\n        return False\n\n    # Validate anti-diagonal sum.\n    anti_diag_sum = 0\n    for i in range(n):\n        anti_diag_sum += matrix[i][n - 1 - i]\n    if anti_diag_sum != target_sum:\n        return False\n\n    return True"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(input_list):\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    Orchestrates frequency counting and maximum item identification.\n    \"\"\"\n    if not input_list:\n        return None  # Handle empty list gracefully\n\n    frequency_map = _count_frequencies(input_list)\n    max_item = _find_max_frequency_item(frequency_map)\n    return max_item\n\ndef _count_frequencies(input_list):\n    \"\"\"\n    Counts the occurrences of each unique item in the input list.\n    Returns a dictionary mapping items to their frequencies.\n    \"\"\"\n    frequencies = {}\n    for item in input_list:\n        frequencies[item] = frequencies.get(item, 0) + 1\n    return frequencies\n\ndef _find_max_frequency_item(frequency_map):\n    \"\"\"\n    Identifies the item with the highest frequency from a frequency map.\n    Returns the item that has the maximum count.\n    \"\"\"\n    if not frequency_map:\n        return None  # No items to find max frequency for\n\n    max_frequency = -1\n    max_item = None\n    for item, frequency in frequency_map.items():\n        if frequency > max_frequency:\n            max_frequency = frequency\n            max_item = item\n    return max_item"}
{"task_id": "Mbpp/129", "solution": "def _calculate_row_sums(matrix):\n    \"\"\"Calculate the sum of each row in the matrix.\"\"\"\n    return [sum(row) for row in matrix]\n\ndef _calculate_column_sums(matrix):\n    \"\"\"Calculate the sum of each column in the matrix.\"\"\"\n    n = len(matrix)\n    if n == 0:\n        return []\n    \n    column_sums = [0] * n\n    for r in range(n):\n        for c in range(n):\n            column_sums[c] += matrix[r][c]\n    return column_sums\n\ndef _calculate_diagonal_sums(matrix):\n    \"\"\"Calculate the sums of the main and anti-diagonals.\"\"\"\n    n = len(matrix)\n    if n == 0:\n        return 0, 0\n    \n    main_diag_sum = 0\n    anti_diag_sum = 0\n    for i in range(n):\n        main_diag_sum += matrix[i][i]\n        anti_diag_sum += matrix[i][n - 1 - i]\n    return main_diag_sum, anti_diag_sum\n\ndef _are_all_sums_equal(sums):\n    \"\"\"Check if all values in a list of sums are equal.\"\"\"\n    if not sums:\n        return True\n    \n    ref_sum = sums[0]\n    for s in sums:\n        if s != ref_sum:\n            return False\n    return True\n\ndef magic_square_test(matrix):\n    \"\"\"\n    Determines if a given square matrix is a magic square.\n    It checks if the sums of all rows, columns, and both main diagonals are equal.\n    \"\"\"\n    n = len(matrix)\n\n    # A magic square must be a square matrix of size 1x1 or greater.\n    if n == 0:\n        return False\n    \n    # Check if all rows have the same length as the number of rows (i.e., square).\n    for row in matrix:\n        if len(row) != n:\n            return False\n            \n    # Calculate all required sums\n    row_sums = _calculate_row_sums(matrix)\n    column_sums = _calculate_column_sums(matrix)\n    main_diag_sum, anti_diag_sum = _calculate_diagonal_sums(matrix)\n    \n    # Collect all sums into a single list for comparison\n    all_sums = row_sums + column_sums + [main_diag_sum, anti_diag_sum]\n    \n    # Check if all these sums are equal\n    return _are_all_sums_equal(all_sums)"}
{"task_id": "Mbpp/130", "solution": "def _count_frequencies(input_list: List[Any]) -> Dict[Any, int]:\n    \"\"\"Count occurrences of each item in the list.\"\"\"\n    frequency_map: Dict[Any, int] = {}\n    for item in input_list:\n        frequency_map[item] = frequency_map.get(item, 0) + 1\n    return frequency_map\n\ndef _find_max_frequency_item(frequency_map: Dict[Any, int]) -> Any:\n    \"\"\"Find the item with highest frequency from frequency map.\"\"\"\n    if not frequency_map:\n        return None\n    return max(frequency_map, key=frequency_map.get)\n\ndef max_occurrences(input_list: List[Any]) -> Any:\n    \"\"\"Find the item with maximum frequency in the given list.\"\"\"\n    if not input_list:\n        return None\n\n    frequency_map = _count_frequencies(input_list)\n    return _find_max_frequency_item(frequency_map)"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(input_string: str) -> str:\n    \"\"\"Reverses only the vowels of a given string (where y is not a vowel).\"\"\"\n\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Determines if a character is a vowel (a,e,i,o,u, case-insensitive).\"\"\"\n        return char.lower() in 'aeiou'\n\n    def _preserve_case(original_vowel: str, new_vowel: str) -> str:\n        \"\"\"Preserves the case of original vowel when replacing with new vowel.\"\"\"\n        if original_vowel.isupper():\n            return new_vowel.upper()\n        elif original_vowel.islower():\n            return new_vowel.lower()\n        return new_vowel\n\n    def _extract_vowels_and_positions(input_string: str) -> tuple[list[str], list[int]]:\n        \"\"\"Extracts vowels and their positions from input string.\"\"\"\n        vowels = []\n        positions = []\n        for i, char in enumerate(input_string):\n            if _is_vowel(char):\n                vowels.append(char)\n                positions.append(i)\n        return vowels, positions\n\n    def _reverse_vowels_list(vowels: list[str]) -> list[str]:\n        \"\"\"Reverses the order of vowels in a list.\"\"\"\n        return vowels[::-1]\n\n    def _reconstruct_string(original: str, reversed_vowels: list[str], positions: list[int]) -> str:\n        \"\"\"Reconstructs string with reversed vowels in original vowel positions.\"\"\"\n        string_list = list(original)\n        for i in range(len(positions)):\n            original_idx = positions[i]\n            original_vowel_char = original[original_idx]\n            new_vowel_char = reversed_vowels[i]\n            string_list[original_idx] = _preserve_case(original_vowel_char, new_vowel_char)\n        return \"\".join(string_list)\n\n    vowels, positions = _extract_vowels_and_positions(input_string)\n    reversed_vowels = _reverse_vowels_list(vowels)\n    return _reconstruct_string(input_string, reversed_vowels, positions)"}
{"task_id": "Mbpp/131", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Determines if a character is a vowel (case-insensitive).\n    'y' is explicitly not considered a vowel.\n    \"\"\"\n    return char.lower() in VOWELS\n\ndef _extract_vowels(text: str) -> list[tuple[str, int]]:\n    \"\"\"Extracts all vowels from a string along with their original indices.\"\"\"\n    extracted = []\n    for i, char in enumerate(text):\n        if _is_vowel(char):\n            extracted.append((char, i))\n    return extracted\n\ndef reverse_vowels(input_string: str) -> str:\n    \"\"\"Reverses only the vowels within a given string, preserving consonant positions.\"\"\"\n    vowel_data = _extract_vowels(input_string)\n\n    if not vowel_data:\n        return input_string\n\n    # Extract the vowel characters and reverse their order\n    vowels_only = [v[0] for v in vowel_data]\n    vowels_only.reverse()\n\n    # Create a list of characters from the input string to allow modification\n    result_chars = list(input_string)\n\n    # Place the reversed vowels back into their original positions\n    for i, (_, original_index) in enumerate(vowel_data):\n        result_chars[original_index] = vowels_only[i]\n\n    return \"\".join(result_chars)"}
