{"task_id": "Mbpp/3", "solution": "def is_not_prime(number: int) -> bool:\n    \"\"\"Identifies whether a given integer is a non-prime number.\n    It returns True if the number is not prime, False if it is prime.\n    \"\"\"\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"Helper function to determine if a number is prime.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:  # 2 and 3 are prime\n            return True\n        if n % 2 == 0 or n % 3 == 0:  # Multiples of 2 or 3 (except 2, 3 themselves) are not prime\n            return False\n        \n        # Check for factors from 5 onwards with a step of 6\n        # (all primes > 3 are of the form 6k \u00b1 1)\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    return not _is_prime(number)"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(collection1, collection2):\n    \"\"\"\n    Finds the shared elements between two collections (lists or tuples).\n    Returns a list containing the common elements.\n    \"\"\"\n    set1 = set(collection1)\n    set2 = set(collection2)\n    shared = set1.intersection(set2)\n    return list(shared)"}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(number: int) -> bool:\n    \"\"\"\n    Identifies if a number is not prime.\n    Returns True if the number is not prime, False if prime.\n    \"\"\"\n\n    def _is_prime_helper(n: int) -> bool:\n        \"\"\"Determines if a given number is prime.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    return not _is_prime_helper(number)"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(collection1, collection2):\n    \"\"\"\n    Finds the shared elements between two given collections.\n    The result preserves the order of elements as they appear in the first collection.\n    \"\"\"\n    set2 = set(collection2)\n    shared = []\n    for item in collection1:\n        if item in set2:\n            shared.append(item)\n    return tuple(shared)"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks if two integers differ at exactly one bit position.\n    This is achieved by XORing the numbers and counting the set bits in the result.\n    \"\"\"\n    xor_result = num1 ^ num2\n    \n    # Count the number of set bits in the xor_result\n    set_bits_count = 0\n    while xor_result > 0:\n        xor_result &= (xor_result - 1) # Clears the least significant set bit\n        set_bits_count += 1\n        \n    return set_bits_count == 1"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks if two numbers differ at exactly one bit position.\n    This is achieved by XORing the numbers and counting set bits in the result.\n    \"\"\"\n    xor_result = num1 ^ num2\n    return xor_result.bit_count() == 1"}
