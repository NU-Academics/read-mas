{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculate sum of series (n - 2*i) from i=0 to n//2, adding terms only if they are positive.\n    The summation stops if a term becomes less than or equal to 0.\n    \"\"\"\n    total_sum = 0\n    for i in range(n // 2 + 1):  # i goes from 0 up to n // 2 (inclusive)\n        term = n - 2 * i\n        if term > 0:\n            total_sum += term\n        else:\n            # According to the design context, break if term <= 0\n            break\n    return total_sum"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    \"\"\"\n    Count characters that occur at same position as in English alphabet.\n\n    Args:\n        input_string: String to process\n\n    Returns:\n        Integer count of matching characters\n    \"\"\"\n    count = 0\n    for i, char in enumerate(input_string):\n        if i < 26:  # Only check first 26 positions corresponding to 'a' through 'z'\n            # Calculate the expected character for the current position\n            expected_char = chr(ord('a') + i)\n            # Compare the lowercase version of the input character with the expected character\n            if char.lower() == expected_char:\n                count += 1\n    return count"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string):\n    \"\"\"\n    Counts characters in a string that match their position in the English alphabet (case-insensitive).\n    \"\"\"\n    count = 0\n    for i, char in enumerate(input_string):\n        # Normalize the current character to lowercase\n        normalized_char = char.lower()\n\n        # Check if the character is a lowercase English letter and if its position is valid\n        if 'a' <= normalized_char <= 'z':\n            # Calculate the expected alphabet character at the current string position\n            expected_char_code = ord('a') + i\n            if 0 <= i < 26 and ord(normalized_char) == expected_char_code:\n                count += 1\n    return count"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple,\n    or returns None if no solution exists.\n    \"\"\"\n\n    # Helper function to calculate the greatest common divisor using Euclidean algorithm.\n    def calculate_gcd(num1: int, num2: int) -> int:\n        num1, num2 = abs(num1), abs(num2)\n        while num2:\n            num1, num2 = num2, num1 % num2\n        return num1\n\n    # Helper function for the Extended Euclidean Algorithm.\n    # It finds (gcd, x, y) such that a_val*x + b_val*y = gcd(abs(a_val), abs(b_val)).\n    # The x and y returned are specific to a_val and b_val with their original signs.\n    def extended_euclidean(a_val: int, b_val: int) -> tuple[int, int, int]:\n        # Store original signs to adjust x and y later if absolute values are used internally.\n        # This implementation directly uses a_val and b_val, so signs are handled.\n        \n        # Base cases for Extended Euclidean Algorithm:\n        # For a_val*x + b_val*y = gcd\n        if a_val == 0:\n            return (abs(b_val), 0, (1 if b_val >= 0 else -1)) # gcd(0, b_val)=abs(b_val). 0*x + b_val*y = abs(b_val) => y = +/-1.\n        if b_val == 0:\n            return (abs(a_val), (1 if a_val >= 0 else -1), 0) # gcd(a_val, 0)=abs(a_val). a_val*x + 0*y = abs(a_val) => x = +/-1.\n\n        # Iterative Extended Euclidean Algorithm\n        x_prev, y_prev = 1, 0\n        x_curr, y_curr = 0, 1\n        \n        r_prev, r_curr = a_val, b_val\n\n        while r_curr != 0:\n            q = r_prev // r_curr\n            r_prev, r_curr = r_curr, r_prev - q * r_curr\n            x_prev, x_curr = x_curr, x_prev - q * x_curr\n            y_prev, y_curr = y_curr, y_prev - q * y_curr\n        \n        # r_prev now holds gcd(a_val, b_val)\n        # x_prev and y_prev hold the coefficients such that a_val*x_prev + b_val*y_prev = r_prev\n        return (r_prev, x_prev, y_prev)\n\n    # --- Main find_solution logic ---\n\n    # Handle edge case where both a and b are zero.\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    # Calculate the greatest common divisor of a and b.\n    common_divisor = calculate_gcd(a, b)\n\n    # According to Bezout's identity, a linear Diophantine equation ax + by = n\n    # has integer solutions if and only if n is divisible by gcd(a, b).\n    if n % common_divisor != 0:\n        return None\n\n    # Use the Extended Euclidean Algorithm to find a particular solution (x_prime, y_prime)\n    # for the equation a*x_prime + b*y_prime = common_divisor.\n    # Note: extended_euclidean might return a negative gcd if one of the inputs is negative,\n    # but the subsequent steps will correctly handle scaling for 'n'.\n    gcd_val, x_prime, y_prime = extended_euclidean(a, b)\n    \n    # Scale the particular solution (x_prime, y_prime) to solve for 'n'.\n    # We have a*x_prime + b*y_prime = gcd_val.\n    # We want a*x + b*y = n.\n    # The scaling factor is (n / gcd_val).\n    factor = n // gcd_val\n    x_particular = x_prime * factor\n    y_particular = y_prime * factor\n\n    # The general solution for ax + by = n is given by:\n    # x = x_particular + t * (b / gcd(a,b))\n    # y = y_particular - t * (a / gcd(a,b))\n    # where 't' is any integer.\n\n    # To get a specific canonical solution (e.g., to match test cases like (2,1) for (2,3,7)),\n    # we adjust 't' to shift x into a desired range.\n    # A common way is to find the 't' that makes x the smallest non-negative integer.\n    # The step values for x and y depend on (b/gcd) and (a/gcd).\n    \n    # Handle cases where a or b is zero for the step calculation, as it simplifies.\n    if b == 0: # Equation is ax = n. We already know n is divisible by a. x = n/a, y can be 0.\n        return (n // a, 0)\n    if a == 0: # Equation is by = n. We already know n is divisible by b. y = n/b, x can be 0.\n        return (0