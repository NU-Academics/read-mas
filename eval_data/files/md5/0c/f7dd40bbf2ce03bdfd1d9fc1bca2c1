{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_lists: list) -> list:\n    \"\"\"\n    Finds elements that are common to all sublists within a given nested list.\n    Returns a list of these common elements.\n    \"\"\"\n    if not nested_lists:\n        return []\n\n    # Initialize common_elements with the set of the first sublist\n    common_elements_set = set(nested_lists[0])\n\n    # Iterate through the remaining sublists and find intersections\n    for sublist in nested_lists[1:]:\n        common_elements_set = common_elements_set.intersection(set(sublist))\n        # If the set becomes empty, no further common elements are possible\n        if not common_elements_set:\n            break\n\n    return list(common_elements_set)"}
{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary_string: str, rotation_count: int) -> int:\n    \"\"\"\n    Orchestrates the complete rotation and counting workflow to find the number of odd decimal values.\n    \"\"\"\n    def _validate_input(binary_string: str, rotation_count: int) -> None:\n        \"\"\"\n        Validates input parameters for correctness.\n        \"\"\"\n        if not binary_string or not all(c in '01' for c in binary_string):\n            raise ValueError(\"binary_string must be a non-empty string containing only '0' and '1'.\")\n        if not isinstance(rotation_count, int) or rotation_count < 0:\n            raise ValueError(\"rotation_count must be a non-negative integer.\")\n\n    def _rotate_string(s: str, positions: int) -> str:\n        \"\"\"\n        Performs a left rotation on the input string by the given number of positions.\n        \"\"\"\n        if not s:\n            return s\n        actual_positions = positions % len(s)\n        return s[actual_positions:] + s[:actual_positions]\n\n    def _binary_to_decimal(binary_str: str) -> int:\n        \"\"\"\n        Converts a binary string to its decimal integer equivalent.\n        \"\"\"\n        return int(binary_str, 2)\n\n    def _is_odd(number: int) -> bool:\n        \"\"\"\n        Determines if a given number is odd.\n        \"\"\"\n        return number % 2 != 0\n\n    _validate_input(binary_string, rotation_count)\n\n    odd_count = 0\n    current_string = binary_string\n    n = len(binary_string)\n\n    # We need to consider 'rotation_count' distinct states.\n    # If rotation_count > n, the rotations will repeat after n times.\n    # The problem description and example suggest rotating up to the given count.\n    # If rotation_count is 6 for a 6-length string, it performs 6 rotations starting from 0.\n    # The first rotation (i=0) is the original string.\n    for i in range(rotation_count):\n        # The first iteration (i=0) is the original string, for subsequent iterations,\n        # we consider the string rotated by 'i' positions from the original.\n        rotated_str = _rotate_string(binary_string, i)\n        decimal_value = _binary_to_decimal(rotated_str)\n        if _is_odd(decimal_value):\n            odd_count += 1\n    \n    return odd_count"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_lists: list) -> list:\n    \"\"\"\n    Find elements that appear in all sublists of the input nested lists.\n    It returns a list of elements common to all sublists.\n    \"\"\"\n    if not nested_lists:\n        return []\n\n    # Initialize common_elements with the set of the first sublist\n    common_elements = set(nested_lists[0])\n\n    # Iterate through the remaining sublists and perform intersection\n    for sublist in nested_lists[1:]:\n        common_elements = common_elements.intersection(set(sublist))\n\n    # Convert the resulting set back to a list\n    return list(common_elements)"}
{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary_string: str, rotations: int) -> int:\n    \"\"\"Finds the count of odd numbers generated by rotating a binary string.\n    Each rotation is converted to decimal to check for oddness.\n    \"\"\"\n\n    def _validate_binary_string(s: str) -> bool:\n        \"\"\"Validates if a string contains only '0' and '1' characters.\"\"\"\n        return all(c in '01' for c in s)\n\n    def _rotate_left(s: str) -> str:\n        \"\"\"Performs a left rotation on a binary string.\n        Handles empty strings by returning them unchanged.\n        \"\"\"\n        if not s:\n            return s\n        return s[1:] + s[0]\n\n    def _binary_to_decimal(s: str) -> int:\n        \"\"\"Converts a binary string to its decimal integer equivalent.\n        Returns 0 for an empty string.\n        \"\"\"\n        if not s:\n            return 0\n        return int(s, 2)\n\n    # As per design, _validate_binary_string is called.\n    # Per explicit instructions, no exceptions or complex edge case handling for invalid input.\n    _validate_binary_string(binary_string)\n\n    odd_count = 0\n    current_string = binary_string\n\n    if not binary_string:\n        return 0\n\n    for _ in range(rotations):\n        decimal_value = _binary_to_decimal(current_string)\n        if decimal_value % 2 == 1:\n            odd_count += 1\n        current_string = _rotate_left(current_string)\n\n    return odd_count"}
{"task_id": "Mbpp/113", "solution": "def check_integer(input_string: str) -> bool:\n    \"\"\"Checks if a string represents an integer, handling signs but not decimals.\"\"\"\n    if not input_string:\n        return False\n\n    start_index = 0\n    if input_string[0] == '-' or input_string[0] == '+':\n        start_index = 1\n        if len(input_string) == 1:  # String is just \"-\" or \"+\"\n            return False\n\n    for i in range(start_index, len(input_string)):\n        if not '0' <= input_string[i] <= '9':\n            return False\n\n    return True"}
{"task_id": "Mbpp/113", "solution": "def check_integer(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string represents an integer, handling optional leading signs and excluding decimals/scientific notation.\n    \"\"\"\n    s = input_string.strip()\n\n    # An empty string or a string that becomes empty after stripping is not an integer.\n    if not s:\n        return False\n\n    # Strings containing a decimal point are considered floats, not integers.\n    if '.' in s:\n        return False\n\n    # Strings containing 'e' or 'E' are considered scientific notation, not integers.\n    if 'e' in s or 'E' in s:\n        return False\n\n    # Determine the starting index for digit validation, accounting for an optional leading sign.\n    start_index = 0\n    if s[0] == '+' or s[0] == '-':\n        start_index = 1\n\n    # After handling the sign, the remaining part of the string must not be empty (e.g., just \"+\" or \"-\").\n    if start_index >= len(s):\n        return False\n\n    # All characters from the determined start_index must be digits.\n    for char in s[start_index:]:\n        if not char.isdigit():\n            return False\n\n    return True"}
