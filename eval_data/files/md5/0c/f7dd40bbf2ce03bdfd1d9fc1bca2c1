{"task_id": "Mbpp/141", "solution": "def pancake_sort(arr: list) -> list:\n    \"\"\"Sorts a list of elements in ascending order using the pancake sort algorithm.\"\"\"\n\n    def find_max_index(current_arr: list, n: int) -> int:\n        \"\"\"Finds the index of the maximum element in the first n elements of a list.\"\"\"\n        max_element_index = 0\n        for i in range(1, n):\n            if current_arr[i] > current_arr[max_element_index]:\n                max_element_index = i\n        return max_element_index\n\n    def flip(current_arr: list, k: int) -> None:\n        \"\"\"Reverses elements from index 0 to k in a list in-place.\"\"\"\n        start = 0\n        while start < k:\n            current_arr[start], current_arr[k] = current_arr[k], current_arr[start]\n            start += 1\n            k -= 1\n\n    arr_copy = arr[:]  # Create a copy to not modify the original list\n    n = len(arr_copy)\n\n    for i in range(n, 1, -1):\n        # Find index of the maximum element in arr_copy[0...i-1]\n        max_idx = find_max_index(arr_copy, i)\n\n        # If maximum element is not already at its correct position\n        if max_idx != i - 1:\n            # Move the maximum element to the beginning if it's not already there\n            if max_idx != 0:\n                flip(arr_copy, max_idx)\n            # Move the maximum element from the beginning to its correct position\n            flip(arr_copy, i - 1)\n            \n    return arr_copy"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1: list, list2: list, list3: list) -> int:\n    \"\"\"\n    Count number of items that are identical in the same position of three given lists.\n    Compares elements at identical index positions across all three lists.\n    \"\"\"\n    count = 0\n    min_length = min(len(list1), len(list2), len(list3))\n\n    for i in range(min_length):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/141", "solution": "def find_max_index(arr: list, n: int) -> int:\n    \"\"\"\n    Finds the index of the maximum element in the first 'n' elements of the list.\n    \"\"\"\n    max_val = arr[0]\n    max_idx = 0\n    for i in range(1, n):\n        if arr[i] > max_val:\n            max_val = arr[i]\n            max_idx = i\n    return max_idx\n\ndef flip(arr: list, k: int) -> None:\n    \"\"\"\n    Reverses elements in the list from index 0 up to 'k' (inclusive) in-place.\n    \"\"\"\n    start = 0\n    end = k\n    while start < end:\n        arr[start], arr[end] = arr[end], arr[start]\n        start += 1\n        end -= 1\n\ndef pancake_sort(input_list: list) -> list:\n    \"\"\"\n    Sorts a list of elements using the pancake sort algorithm.\n    \"\"\"\n    n = len(input_list)\n    arr = input_list.copy() # Work on a copy to preserve the original list\n\n    # Iterate from the last element down to the second element.\n    # 'current_size' represents the number of elements in the unsorted portion.\n    for current_size in range(n, 1, -1):\n        # Find the index of the maximum element in the current unsorted portion (arr[0...current_size-1]).\n        max_idx = find_max_index(arr, current_size)\n\n        # If the maximum element is not already at the front, bring it to the front.\n        if max_idx != 0:\n            flip(arr, max_idx)\n        \n        # Move the maximum element from the front to its correct sorted position\n        # at the end of the current unsorted portion.\n        flip(arr, current_size - 1)\n            \n    return arr"}
