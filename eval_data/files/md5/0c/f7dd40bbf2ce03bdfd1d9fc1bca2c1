{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Calculate the Bell number for a given non-negative integer.\n    Uses dynamic programming with the Bell triangle method.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    if n == 0:\n        return 1\n\n    # bell_triangle[i][j] stores the j-th element of the i-th row.\n    # The Bell number B_i is bell_triangle[i][0].\n    bell_triangle = [[0] * (i + 1) for i in range(n + 1)]\n\n    # Base case: B_0 = 1\n    bell_triangle[0][0] = 1\n\n    # Fill the Bell triangle using the recurrence relations\n    for i in range(1, n + 1):\n        # The first element of row i is the last element of the previous row (i-1).\n        bell_triangle[i][0] = bell_triangle[i - 1][i - 1]\n        for j in range(1, i + 1):\n            # Subsequent elements are the sum of the element to their left in the current row\n            # and the element above and to their left in the previous row.\n            bell_triangle[i][j] = bell_triangle[i][j - 1] + bell_triangle[i - 1][j - 1]\n\n    # The Bell number B_n is the first element of the n-th row.\n    return bell_triangle[n][0]"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array):\n    \"\"\"\n    Check if the given array is monotonic.\n    An array is monotonic if it is either non-decreasing or non-increasing.\n    \"\"\"\n    def _is_non_decreasing(arr):\n        \"\"\"Helper function to check if the array is non-decreasing.\"\"\"\n        for i in range(1, len(arr)):\n            if arr[i] < arr[i-1]:\n                return False\n        return True\n\n    def _is_non_increasing(arr):\n        \"\"\"Helper function to check if the array is non-increasing.\"\"\"\n        for i in range(1, len(arr)):\n            if arr[i] > arr[i-1]:\n                return False\n        return True\n\n    return _is_non_decreasing(array) or _is_non_increasing(array)"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(arr: list) -> bool:\n    \"\"\"\n    Check if array is monotonic (either increasing or decreasing).\n    An empty array or single-element array is considered monotonic.\n    \"\"\"\n    if len(arr) <= 1:\n        return True\n\n    def _check_increasing(arr_local: list) -> bool:\n        \"\"\"Helper function to check if array is non-decreasing.\"\"\"\n        for i in range(1, len(arr_local)):\n            if arr_local[i] < arr_local[i - 1]:\n                return False\n        return True\n\n    def _check_decreasing(arr_local: list) -> bool:\n        \"\"\"Helper function to check if array is non-increasing.\"\"\"\n        for i in range(1, len(arr_local)):\n            if arr_local[i] > arr_local[i - 1]:\n                return False\n        return True\n\n    return _check_increasing(arr) or _check_decreasing(arr)"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Calculate the Bell number for given input n.\n\n    Args:\n        n: Non-negative integer representing set size\n\n    Returns:\n        Bell number representing number of ways to partition set of size n\n\n    Raises:\n        ValidationError: If n is negative\n    \"\"\"\n\n    class ValidationError(Exception):\n        \"\"\"Exception raised for invalid input values.\"\"\"\n        pass\n\n    def validate_input(num: int) -> bool:\n        \"\"\"\n        Validate that input is a non-negative integer.\n        Raises ValidationError if num is negative.\n        \"\"\"\n        if not isinstance(num, int) or num < 0:\n            raise ValidationError(\"Input must be a non-negative integer.\")\n        return True\n\n    def generate_bell_triangle(size: int) -> list[list[int]]:\n        \"\"\"\n        Generates the Bell triangle up to row 'size'.\n        The Bell number B_k is the first element of row k.\n        \"\"\"\n        if size == 0:\n            return [[1]]\n\n        triangle = [[1]] # Initialize with B_0\n\n        for i in range(1, size + 1):\n            # The first element of the current row (A[i][0]) is the last element of the previous row (A[i-1][i-1])\n            current_row = [triangle[i-1][-1]]\n            for j in range(1, i + 1):\n                # Subsequent elements A[i][j] = A[i][j-1] + A[i-1][j-1]\n                current_row.append(current_row[j-1] + triangle[i-1][j-1])\n            triangle.append(current_row)\n        return triangle\n\n    def calculate_bell_number_internal(num: int) -> int:\n        \"\"\"\n        Calculates the Bell number for 'num' using the Bell triangle method.\n        \"\"\"\n        # For num=0, generate_bell_triangle will return [[1]], and triangle[0][0] is 1.\n        # This handles B_0 = 1 correctly.\n        bell_triangle = generate_bell_triangle(num)\n        return bell_triangle[num][0] # The Bell number B_num is the first element of the 'num'-th row\n\n    # Main logic of the bell_number function\n    validate_input(n) # Validate input as per design\n    return calculate_bell_number_internal(n) # Calculate and return the Bell number"}
