{"task_id": "Mbpp/311", "solution": "def _find_leftmost_unset_bit(n: int) -> int:\n    \"\"\"Finds the position of the leftmost unset bit (0-indexed from right).\"\"\"\n    if n == 0:\n        return 0\n\n    # Get the position of the most significant bit.\n    msb_pos = n.bit_length() - 1\n\n    # Iterate from msb_pos down to 0 to find the first 0 bit.\n    for pos in range(msb_pos, -1, -1):\n        if not (n >> pos) & 1:\n            return pos\n\n    # If all bits up to msb_pos are 1s, the leftmost unset bit is one position to the left of msb.\n    return msb_pos + 1\n\ndef _set_bit_at_position(n: int, pos: int) -> int:\n    \"\"\"Sets the bit at a specified position to 1.\"\"\"\n    return n | (1 << pos)\n\ndef set_left_most_unset_bit(n: int) -> int:\n    \"\"\"Sets the leftmost unset bit in the binary representation of n.\"\"\"\n    # Find the position of the leftmost unset bit.\n    bit_pos = _find_leftmost_unset_bit(n)\n\n    # Set the bit at the identified position.\n    return _set_bit_at_position(n, bit_pos)"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the highest power of 2 that is less than or equal to n.\n    Returns 0 for n less than or equal to 0, as no positive power of 2 satisfies the condition.\n    \"\"\"\n    if n <= 0:\n        return 0\n    # For positive n, calculate 2 raised to the power of (n's most significant bit position).\n    # n.bit_length() returns the number of bits required to represent n in binary;\n    # subtracting 1 gives the 0-indexed position of the most significant bit.\n    return 1 << (n.bit_length() - 1)"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    \"\"\"\n    Calculates the n'th Lucas number using an iterative approach.\n    Handles base cases for n=0 and n=1, and computes for n >= 2.\n    \"\"\"\n    if n == 0:\n        return 2\n    elif n == 1:\n        return 1\n    else:\n        a, b = 2, 1  # L(0) = 2, L(1) = 1\n        for _ in range(2, n + 1):\n            a, b = b, a + b\n        return b"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    \"\"\"\n    Calculates the n'th Lucas number using an iterative approach.\n    The sequence starts with L(0)=2, L(1)=1, and L(n)=L(n-1)+L(n-2) for n > 1.\n    \"\"\"\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n\n    a, b = 2, 1  # L(0) and L(1)\n    for _ in range(2, n + 1):\n        a, b = b, a + b\n    return b"}
{"task_id": "Mbpp/311", "solution": "def _find_left_most_unset_bit(number: int) -> int:\n    \"\"\"Find the position of the leftmost unset bit.\"\"\"\n    if number == 0:\n        return 0\n\n    msb_idx = number.bit_length() - 1\n    for p in range(msb_idx, -1, -1):\n        if not ((number >> p) & 1):\n            return p\n\n    return msb_idx + 1\n\ndef _set_bit_at_position(number: int, position: int) -> int:\n    \"\"\"Set the bit at the specified position to 1.\"\"\"\n    mask = 1 << position\n    return number | mask\n\ndef set_left_most_unset_bit(number: int) -> int:\n    \"\"\"Set the leftmost unset bit in the binary representation of number.\"\"\"\n    position_to_set = _find_left_most_unset_bit(number)\n    return _set_bit_at_position(number, position_to_set)"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the highest power of 2 that is less than or equal to n.\n    For non-positive n, it returns 1 (which is 2^0).\n    \"\"\"\n    current_power_of_2 = 1\n    while (current_power_of_2 << 1) <= n:\n        current_power_of_2 <<= 1\n    return current_power_of_2"}
