{"task_id": "Mbpp/290", "solution": "def max_length(list_of_lists):\n    \"\"\"\n    Finds the list of maximum length in a list of lists.\n    Returns a tuple (maximum_length, list_with_maximum_length).\n    \"\"\"\n\n    def _calculate_lengths(data_list):\n        \"\"\"Calculates the length of each inner list.\"\"\"\n        return [len(inner_list) for inner_list in data_list]\n\n    def _find_maximum(lengths_list):\n        \"\"\"Finds the maximum length and its index (first occurrence).\"\"\"\n        # lengths_list is guaranteed not to be empty at this point\n        max_len = lengths_list[0]\n        max_idx = 0\n        for i in range(1, len(lengths_list)):\n            if lengths_list[i] > max_len:\n                max_len = lengths_list[i]\n                max_idx = i\n        return max_len, max_idx\n\n    def _create_result(max_len, max_idx, original_list):\n        \"\"\"Creates the final result tuple.\"\"\"\n        return max_len, original_list[max_idx]\n\n    if not list_of_lists:\n        return 0, []\n\n    lengths = _calculate_lengths(list_of_lists)\n    max_len, max_idx = _find_maximum(lengths)\n\n    return _create_result(max_len, max_idx, list_of_lists)"}
{"task_id": "Mbpp/290", "solution": "def max_length(list_of_lists: list) -> tuple:\n    \"\"\"\n    Finds the sublist with the maximum length in a list of lists.\n    Returns a tuple containing the maximum length and the corresponding list.\n    \"\"\"\n    max_len = 0\n    max_list = []\n\n    for sublist in list_of_lists:\n        current_len = len(sublist)\n        if current_len > max_len:\n            max_len = current_len\n            max_list = sublist\n            \n    return (max_len, max_list)"}
