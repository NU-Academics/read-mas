{"task_id": "Mbpp/299", "solution": "def max_aggregate(tuple_list):\n    \"\"\"\n    Calculate maximum aggregate from list of tuples.\n\n    Args:\n        tuple_list: List of tuples containing (name, value) pairs\n\n    Returns:\n        Tuple containing (name, sum) with highest aggregate\n    \"\"\"\n    aggregates = {}\n    for name, value in tuple_list:\n        aggregates[name] = aggregates.get(name, 0) + value\n\n    if not aggregates:\n        return None, None # Or handle as per specific requirement for empty input\n\n    max_name = None\n    max_sum = float('-inf')\n\n    for name, current_sum in aggregates.items():\n        if current_sum > max_sum:\n            max_sum = current_sum\n            max_name = name\n\n    return (max_name, max_sum)"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(tuples_list):\n    \"\"\"Calculates the maximum aggregate sum for names from a list of (name, value) tuples.\"\"\"\n    aggregates = {}\n    for name, value in tuples_list:\n        aggregates[name] = aggregates.get(name, 0) + value\n\n    # Find the name with the maximum aggregate sum, handling empty aggregates.\n    return max(aggregates.items(), key=lambda item: item[1], default=('', 0))"}
{"task_id": "Mbpp/300", "solution": "def _binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient C(n,k).\"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n\n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\n\ndef count_binary_seq(n: int) -> float:\n    \"\"\"Counts binary sequences of length 2n where the sum of the first n bits equals the sum of the last n bits.\n    This is calculated as the sum of C(n,k)^2 for k from 0 to n.\n    \"\"\"\n    total_count = 0\n    for k in range(n + 1):\n        coeff = _binomial_coefficient(n, k)\n        total_count += coeff * coeff\n    \n    return float(total_count)"}
{"task_id": "Mbpp/300", "solution": "import math\n\ndef count_binary_seq(n: int) -> float:\n    \"\"\"\n    Calculate count of binary sequences of length 2n where sum of first n bits\n    equals sum of last n bits.\n    \"\"\"\n    # This problem is equivalent to finding the number of ways to choose n positions\n    # for '1's in a sequence of length 2n, which is given by the central binomial coefficient.\n    result = math.comb(2 * n, n)\n    return float(result)"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(input_dict):\n    \"\"\"Calculates the maximum depth of nested dictionaries.\"\"\"\n\n    def _is_dict(value):\n        # Checks if a value is a dictionary.\n        return isinstance(value, dict)\n\n    def _traverse_nested(current_dict, current_depth):\n        # Recursively traverses a dictionary to find the maximum depth.\n        max_depth_found = current_depth\n        for value in current_dict.values():\n            if _is_dict(value):\n                nested_depth = _traverse_nested(value, current_depth + 1)\n                max_depth_found = max(max_depth_found, nested_depth)\n        return max_depth_found\n\n    return _traverse_nested(input_dict, 1)"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(dictionary: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of a dictionary.\n    The root dictionary is considered depth 1, and each nested dictionary adds to the depth.\n    \"\"\"\n    max_current_depth = 1  # The current dictionary itself counts as depth 1\n\n    for value in dictionary.values():\n        if isinstance(value, dict):\n            # Recursively find the depth of the nested dictionary and add 1 for the current level.\n            nested_level_depth = 1 + dict_depth(value)\n            max_current_depth = max(max_current_depth, nested_level_depth)\n\n    return max_current_depth"}
