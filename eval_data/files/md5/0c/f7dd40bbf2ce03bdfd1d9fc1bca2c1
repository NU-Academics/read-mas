{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(upper_limit: int) -> int:\n    \"\"\"\n    Calculates the sum of proper divisors for a given number.\n    Proper divisors are positive divisors of a number, excluding the number itself.\n    \"\"\"\n    def _calculate_proper_divisors_sum(n: int) -> int:\n        if n <= 1:\n            return 0\n        divisor_sum = 1  # 1 is always a proper divisor for n > 1\n        # Iterate up to the square root of n to find divisors efficiently.\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                divisor_sum += i\n                if i * i != n:  # Add the pair divisor if it's not the square root itself\n                    divisor_sum += (n // i)\n        return divisor_sum\n\n    \"\"\"\n    Identifies all amicable numbers within the range from 1 to the specified upper limit.\n    Amicable numbers are two different numbers such that each is the sum of the proper divisors of the other.\n    \"\"\"\n    def _find_amicable_numbers(upper_limit: int) -> list[int]:\n        amicable_nums = []\n        # Use a set to keep track of numbers already identified as part of an amicable pair\n        # to avoid redundant calculations and adding duplicates.\n        found_pairs = set()\n\n        for n in range(1, upper_limit + 1):\n            if n in found_pairs:\n                continue\n\n            sum_divisors_n = _calculate_proper_divisors_sum(n)\n\n            # Check if sum_divisors_n is a distinct number, positive, and within the upper_limit.\n            # If these conditions are met, it's a potential amicable partner.\n            if n != sum_divisors_n and 0 < sum_divisors_n <= upper_limit:\n                sum_divisors_m = _calculate_proper_divisors_sum(sum_divisors_n)\n\n                # If n is equal to the sum of the proper divisors of sum_divisors_n,\n                # then (n, sum_divisors_n) form an amicable pair.\n                if n == sum_divisors_m:\n                    amicable_nums.append(n)\n                    amicable_nums.append(sum_divisors_n)\n                    found_pairs.add(n)\n                    found_pairs.add(sum_divisors_n)\n        return amicable_nums\n\n    # Get the list of amicable numbers up to the specified upper_limit.\n    amicable_numbers_list = _find_amicable_numbers(upper_limit)\n    # Calculate and return the sum of all identified amicable numbers.\n    return sum(amicable_numbers_list)"}
{"task_id": "Mbpp/124", "solution": "import math\n\ndef angle_complex(complex_num):\n    \"\"\"\n    Calculate the angle (argument) of a complex number in radians.\n    Returns the angle in radians within the range (-\u03c0, \u03c0].\n    \"\"\"\n    real_part = complex_num.real\n    imaginary_part = complex_num.imag\n    return math.atan2(imaginary_part, real_part)"}
{"task_id": "Mbpp/125", "solution": "def calculate_difference(substring: str) -> int:\n    \"\"\"\n    Calculates the difference between the count of '0's and '1's in a given substring.\n    \"\"\"\n    zeros = substring.count('0')\n    ones = substring.count('1')\n    return zeros - ones\n\ndef find_maximum_difference(binary_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference (0s - 1s) among all possible substrings of the binary string.\n    This function iterates through all substrings and calculates their differences.\n    \"\"\"\n    n = len(binary_string)\n    if n == 0:\n        return 0\n\n    max_diff = -float('inf') # Initialize with negative infinity to handle cases where all differences are negative\n\n    # Iterate over all possible start indices\n    for i in range(n):\n        # Iterate over all possible end indices (inclusive)\n        for j in range(i, n):\n            substring = binary_string[i : j + 1]\n            current_diff = calculate_difference(substring)\n            if current_diff > max_diff:\n                max_diff = current_diff\n    return max_diff\n\ndef find_length(binary_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s in any substring of the given binary string.\n    This function orchestrates the process by calling helper functions for calculation.\n    \"\"\"\n    # Input validation (as per design) is not explicitly implemented here due to constraints\n    # against raising exceptions or adding type/instance checks for edge cases.\n    # We proceed assuming a valid binary string input.\n    return find_maximum_difference(binary_string)"}
{"task_id": "Mbpp/125", "solution": "def find_length(binary_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and number of 1s\n    in any sub-string of the given binary string.\n    \"\"\"\n\n    def validate_binary_string(s: str) -> bool:\n        \"\"\"Validates that the input string contains only '0' and '1' characters.\"\"\"\n        return all(char in ('0', '1') for char in s)\n\n    def generate_all_substrings(s: str) -> list[str]:\n        \"\"\"Generates all possible non-empty substrings from the given string.\"\"\"\n        substrings = []\n        n = len(s)\n        for i in range(n):\n            for j in range(i + 1, n + 1):\n                substrings.append(s[i:j])\n        return substrings\n\n    def calculate_difference(substring: str) -> int:\n        \"\"\"Calculates the difference between the count of '0's and '1's in a substring.\"\"\"\n        count_zeros = substring.count('0')\n        count_ones = substring.count('1')\n        return count_zeros - count_ones\n\n    def find_maximum(differences: list[int]) -> int:\n        \"\"\"Finds the maximum value from a list of difference values.\"\"\"\n        # Returns 0 if the list is empty, aligning with an empty substring having 0 difference.\n        return max(differences) if differences else 0\n\n    if not validate_binary_string(binary_string):\n        raise ValueError(\"Invalid binary string\")\n\n    # Initialize with 0 to account for the empty substring case, or if all actual\n    # substrings result in negative differences.\n    all_differences = [0]\n\n    substrings = generate_all_substrings(binary_string)\n\n    for sub in substrings:\n        diff = calculate_difference(sub)\n        all_differences.append(diff)\n\n    return find_maximum(all_differences)"}
{"task_id": "Mbpp/126", "solution": "def sum_common_divisors(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of common divisors for two given numbers.\n    This function orchestrates divisor calculation and summing.\n    \"\"\"\n\n    def get_divisors(number: int) -> list[int]:\n        \"\"\"Calculates all positive divisors of a given number.\"\"\"\n        divs = set()\n        for i in range(1, int(number**0.5) + 1):\n            if number % i == 0:\n                divs.add(i)\n                divs.add(number // i)\n        return list(divs)\n\n    def find_common_divisors(divisors1: list[int], divisors2: list[int]) -> list[int]:\n        \"\"\"Identifies divisors that appear in both input lists.\"\"\"\n        return list(set(divisors1).intersection(set(divisors2)))\n\n    divisors_num1 = get_divisors(num1)\n    divisors_num2 = get_divisors(num2)\n\n    common_divs = find_common_divisors(divisors_num1, divisors_num2)\n\n    return sum(common_divs)"}
