{"task_id": "Mbpp/252", "solution": "import math\nfrom typing import Union, Tuple\n\ndef convert(input: Union[int, float, complex]) -> Tuple[float, float]:\n    \"\"\"\n    Convert complex number to polar coordinates.\n\n    Args:\n        input: Complex number, real number, or integer to convert\n\n    Returns:\n        Tuple containing (magnitude, angle) in polar coordinates\n    \"\"\"\n    if not isinstance(input, complex):\n        input = complex(input)\n\n    real_part = input.real\n    imag_part = input.imag\n\n    magnitude = math.sqrt(real_part**2 + imag_part**2)\n    angle = math.atan2(imag_part, real_part)\n\n    return (magnitude, angle)"}
{"task_id": "Mbpp/252", "solution": "import cmath\nfrom typing import Union, Tuple\n\ndef convert(input: Union[complex, int, float]) -> Tuple[float, float]:\n    \"\"\"\n    Convert complex numbers to polar coordinates.\n    This function handles int, float, and complex inputs, returning (magnitude, angle).\n    \"\"\"\n    z = complex(input)\n    magnitude, angle = cmath.polar(z)\n    return magnitude, angle"}
{"task_id": "Mbpp/256", "solution": "def count_Primes_nums(number):\n    \"\"\"\n    Counts the number of prime numbers less than the given non-negative number.\n    Uses a helper function to determine primality for each number.\n    \"\"\"\n    if number < 2:\n        return 0\n\n    def is_prime(n):\n        \"\"\"\n        Checks if a given number n is prime.\n        \"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    count = 0\n    for i in range(2, number):\n        if is_prime(i):\n            count += 1\n    return count"}
