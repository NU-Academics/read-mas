{"task_id": "Mbpp/166", "solution": "import itertools\n\ndef find_even_pair(numbers: list[int]) -> int:\n    \"\"\"\n    Counts the number of pairs of integers in a list that XOR to an even number.\n    It iterates through all unique pairs and checks if their bitwise XOR sum is even.\n    \"\"\"\n    even_xor_pairs_count = 0\n\n    # Generate all unique pairs from the input list.\n    for num1, num2 in itertools.combinations(numbers, 2):\n        # Calculate the bitwise XOR of the pair.\n        xor_result = num1 ^ num2\n        \n        # Check if the XOR result is an even number.\n        # An integer is even if its last bit is 0, which means modulo 2 is 0.\n        if xor_result % 2 == 0:\n            even_xor_pairs_count += 1\n            \n    return even_xor_pairs_count"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(nums: list[int]) -> int:\n    \"\"\"\n    Counts pairs of integers in a list where their XOR sum is an even number.\n    \"\"\"\n    pair_count = 0\n    n = len(nums)\n    for i in range(n):\n        for j in range(i + 1, n):\n            # Calculate the XOR sum of the pair\n            xor_result = nums[i] ^ nums[j]\n            # Check if the XOR result is even\n            if xor_result % 2 == 0:\n                pair_count += 1\n    return pair_count"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Handles n=0 as a special case returning 1.\n    \"\"\"\n    if n == 0:\n        return 1\n    # For n > 0, calculate 2 raised to the power of the bit length of (n-1).\n    # This efficiently finds the smallest power of 2 that is >= n.\n    return 1 << (n - 1).bit_length()"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Handles n=0 as a special case, returning 1.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Implements the power calculation component as per design.\n    # Defined inline to adhere to the prompt's helper function constraint.\n    def _calculate_next_power_internal(val: int) -> int:\n        # Use bit manipulation to find the next power of 2.\n        # This handles cases where val is already a power of 2 correctly.\n        val -= 1\n        val |= val >> 1\n        val |= val >> 2\n        val |= val >> 4\n        val |= val >> 8\n        val |= val >> 16\n        val |= val >> 32\n        val += 1\n        return val\n\n    return _calculate_next_power_internal(n)"}
