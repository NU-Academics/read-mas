{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome greater than the input integer.\n    The function iteratively checks numbers starting from n + 1 until a palindrome is found.\n    \"\"\"\n    def _is_palindrome(num: int) -> bool:\n        \"\"\"\n        Checks if a given integer is a palindrome.\n        It converts the number to a string and compares it with its reverse.\n        \"\"\"\n        s = str(num)\n        return s == s[::-1]\n\n    current_num = n + 1\n    while True:\n        if _is_palindrome(current_num):\n            return current_num\n        current_num += 1"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome greater than the input integer n.\n    \"\"\"\n\n    def reverse_digits(num: int) -> int:\n        \"\"\"Reverses the digits of an integer.\"\"\"\n        reversed_num = 0\n        temp_num = num\n        while temp_num > 0:\n            digit = temp_num % 10\n            reversed_num = reversed_num * 10 + digit\n            temp_num //= 10\n        return reversed_num\n\n    def is_palindrome(num: int) -> bool:\n        \"\"\"Checks if an integer is a palindrome.\"\"\"\n        if num < 0:\n            return False\n        return num == reverse_digits(num)\n\n    current_num = n + 1\n    while True:\n        if is_palindrome(current_num):\n            return current_num\n        current_num += 1"}
