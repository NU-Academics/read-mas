{"task_id": "Mbpp/119", "solution": "def search(array: list) -> int:\n    \"\"\"Find the element that appears only once in a sorted array.\n\n    Args:\n        array: A sorted list of integers where all elements except one appear twice\n\n    Returns:\n        The integer that appears only once\n    \"\"\"\n    n = len(array)\n    # Iterate through the array in steps of two.\n    # If a pair of adjacent elements is not equal, the first element of the pair is the unique one.\n    for i in range(0, n - 1, 2):\n        if array[i] != array[i+1]:\n            return array[i]\n    \n    # If the loop completes, it means all elements except the last one formed pairs.\n    # Thus, the last element is the unique one.\n    return array[n-1]"}
{"task_id": "Mbpp/119", "solution": "def search(array: list) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where all other elements appear in pairs using binary search.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n\n    while low < high:\n        mid = low + (high - low) // 2\n\n        # Adjust mid to be an even index. This ensures array[mid] and array[mid+1]\n        # form a potential pair, simplifying the logic.\n        if mid % 2 == 1:\n            mid -= 1\n\n        # If array[mid] and array[mid+1] are a pair, the unique element must be in the right half.\n        if array[mid] == array[mid + 1]:\n            low = mid + 2\n        # Otherwise, array[mid] is either the unique element or the unique element\n        # is in the left half before mid.\n        else:\n            high = mid\n\n    # When the loop terminates, low == high, and this index points to the unique element.\n    return array[low]"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(tuple_list: list) -> float:\n    \"\"\"\n    Calculates the maximum absolute product from pairs within a list of tuples.\n    This function orchestrates input validation, product calculation, and maximum finding.\n    \"\"\"\n\n    def validate_input_list(lst):\n        \"\"\"Validates that the input is a list.\"\"\"\n        if not isinstance(lst, list):\n            raise TypeError(\"Input must be a list.\")\n\n    def validate_tuple(tup):\n        \"\"\"Validates that a tuple contains exactly two numeric values.\"\"\"\n        if not isinstance(tup, tuple):\n            raise TypeError(f\"Expected a tuple, but got {type(tup)}.\")\n        if len(tup) != 2:\n            raise ValueError(f\"Tuple must contain exactly two elements, but got {len(tup)}.\")\n        if not all(isinstance(x, (int, float)) for x in tup):\n            raise TypeError(\"Tuple elements must be numeric (int or float).\")\n\n    def calculate_product(num1, num2):\n        \"\"\"Calculates the product of two numbers.\"\"\"\n        return num1 * num2\n\n    def get_absolute_value(value):\n        \"\"\"Computes the absolute value of a number.\"\"\"\n        return abs(value)\n\n    def find_maximum(values):\n        \"\"\"Finds the maximum value in a list of numbers.\"\"\"\n        if not values:\n            raise ValueError(\"Cannot find maximum of an empty list.\")\n        return max(values)\n\n    validate_input_list(tuple_list)\n\n    if not tuple_list:\n        return 0.0 # Requirement: handles empty lists gracefully\n\n    absolute_products = []\n    for item in tuple_list:\n        validate_tuple(item)\n        num1, num2 = item\n        product = calculate_product(num1, num2)\n        abs_product = get_absolute_value(product)\n        absolute_products.append(abs_product)\n\n    return find_maximum(absolute_products)"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(tuple_list):\n    \"\"\"\n    Find the maximum absolute product between numbers in pairs of tuples.\n\n    Args:\n        tuple_list: List of tuples containing exactly two numeric values each.\n    \"\"\"\n    if not isinstance(tuple_list, list):\n        raise TypeError(\"Input must be a list.\")\n    if not tuple_list:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    max_product = float('-inf')\n\n    for item in tuple_list:\n        if not isinstance(item, tuple):\n            raise TypeError(f\"All elements in the list must be tuples, but found {type(item).__name__}.\")\n        if len(item) != 2:\n            raise ValueError(f\"Each tuple must contain exactly 2 numbers, but found {len(item)} elements in {item}.\")\n\n        num1, num2 = item\n        if not isinstance(num1, (int, float)) or not isinstance(num2, (int, float)):\n            raise TypeError(f\"Tuple elements must be numbers, but found types {type(num1).__name__} and {type(num2).__name__} in {item}.\")\n\n        current_product = abs(num1 * num2)\n        if current_product > max_product:\n            max_product = current_product\n\n    return max_product"}
{"task_id": "Mbpp/123", "solution": "import math\n\ndef amicable_numbers_sum(upper_limit: int) -> int:\n    \"\"\"\n    Calculates the sum of all amicable numbers up to a specified upper limit.\n    Uses helper functions to find proper divisors and identify amicable pairs.\n    \"\"\"\n    _divisor_sum_cache = {}\n\n    def _find_proper_divisors(number: int) -> list[int]:\n        \"\"\"Finds all proper divisors of a given number.\"\"\"\n        if number <= 1:\n            return []\n        \n        divs = [1]\n        limit = int(math.sqrt(number))\n        for i in range(2, limit + 1):\n            if number % i == 0:\n                divs.append(i)\n                if i * i != number:\n                    divs.append(number // i)\n        return divs\n\n    def _sum_proper_divisors(number: int) -> int:\n        \"\"\"Calculates the sum of all proper divisors of a given number, using a cache.\"\"\"\n        if number in _divisor_sum_cache:\n            return _divisor_sum_cache[number]\n        \n        divs = _find_proper_divisors(number)\n        s = sum(divs)\n        _divisor_sum_cache[number] = s\n        return s\n\n    def _is_amicable_pair(a: int, b: int) -> bool:\n        \"\"\"Determines if two numbers form an amicable pair.\"\"\"\n        if a == b: # Amicable numbers must be distinct.\n            return False\n        \n        sum_a = _sum_proper_divisors(a)\n        sum_b = _sum_proper_divisors(b)\n        \n        return sum_a == b and sum_b == a\n    \n    current_total_sum = 0\n    # Set to store numbers already added to the sum, preventing double-counting.\n    processed_numbers = set()\n\n    for n in range(1, upper_limit + 1):\n        if n in processed_numbers:\n            continue\n        \n        sum_div_n = _sum_proper_divisors(n)\n        \n        # Check if the potential amicable partner is within the upper limit.\n        if sum_div_n <= upper_limit:\n            if _is_amicable_pair(n, sum_div_n):\n                current_total_sum += n + sum_div_n\n                processed_numbers.add(n)\n                processed_numbers.add(sum_div_n)\n                \n    return current_total_sum"}
