{"task_id": "Mbpp/74", "solution": "def is_samepatterns(array1, array2):\n    \"\"\"\n    Checks if two arrays follow the same structural pattern.\n    This involves a consistent one-to-one mapping between elements of array1 and array2.\n    \"\"\"\n    if len(array1) != len(array2):\n        return False\n\n    map1 = {} # Maps elements from array1 to array2\n    map2 = {} # Maps elements from array2 to array1\n\n    for i in range(len(array1)):\n        val1 = array1[i]\n        val2 = array2[i]\n\n        # Check consistency for array1 -> array2 mapping\n        if val1 in map1:\n            if map1[val1] != val2:\n                return False\n        else:\n            map1[val1] = val2\n\n        # Check consistency for array2 -> array1 mapping\n        if val2 in map2:\n            if map2[val2] != val1:\n                return False\n        else:\n            map2[val2] = val1\n            \n    return True"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(elements: list) -> list:\n    \"\"\"Sorts a list of elements using the comb sort algorithm.\n    It creates a copy of the input list and returns the sorted copy.\"\"\"\n\n    # Define the shrink factor for gap calculation\n    SHRINK_FACTOR = 1.3\n\n    def _calculate_gap(current_gap: int) -> int:\n        \"\"\"Calculates the next gap size by applying the shrink factor.\n        Ensures the gap does not go below 1.\"\"\"\n        new_gap = int(current_gap / SHRINK_FACTOR)\n        if new_gap < 1:\n            return 1\n        return new_gap\n\n    def _swap_elements(arr_list: list, i: int, j: int) -> None:\n        \"\"\"Swaps two elements within a list at the specified indices.\"\"\"\n        arr_list[i], arr_list[j] = arr_list[j], arr_list[i]\n\n    # Create a mutable copy of the input list to sort\n    arr = list(elements)\n    n = len(arr)\n\n    # Handle empty list case\n    if n == 0:\n        return []\n\n    gap = n\n    swapped = True\n\n    # Continue sorting as long as there's a gap or elements were swapped\n    while gap > 1 or swapped:\n        gap = _calculate_gap(gap)\n        swapped = False\n\n        # Traverse the list and compare elements with the current gap\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                _swap_elements(arr, i, i + gap)\n                swapped = True\n    return arr"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(array1, array2):\n    \"\"\"\n    Checks if two arrays follow the same sequence pattern.\n    It maps elements to their first occurrence index and compares the resulting sequences.\n    \"\"\"\n    if len(array1) != len(array2):\n        return False\n\n    def _create_pattern_sequence(arr):\n        \"\"\"Maps elements in an array to an integer sequence based on their first appearance.\"\"\"\n        pattern_sequence = []\n        element_to_code = {}\n        next_code = 0\n        for element in arr:\n            if element not in element_to_code:\n                element_to_code[element] = next_code\n                next_code += 1\n            pattern_sequence.append(element_to_code[element])\n        return pattern_sequence\n\n    pattern_sequence1 = _create_pattern_sequence(array1)\n    pattern_sequence2 = _create_pattern_sequence(array2)\n\n    return pattern_sequence1 == pattern_sequence2"}
