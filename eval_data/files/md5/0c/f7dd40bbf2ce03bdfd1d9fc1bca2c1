{"task_id": "Mbpp/398", "solution": "def sum_of_digits(numbers: list) -> int:\n    \"\"\"\n    Computes the sum of digits for each number in a list and returns the total sum.\n    This function processes integers by extracting their digits and summing them up.\n    \"\"\"\n    def _extract_digits(number: int) -> list:\n        \"\"\"Extracts individual digits from a single integer.\"\"\"\n        if number == 0:\n            return [0]\n        digits = []\n        # Handle negative numbers by taking absolute value for digit extraction\n        abs_number = abs(number)\n        while abs_number > 0:\n            digits.append(abs_number % 10)\n            abs_number //= 10\n        return digits[::-1] # Reverse to get digits in correct order, though not strictly necessary for summation\n\n    def _calculate_sum(digits_list: list) -> int:\n        \"\"\"Calculates the sum of a list of integers.\"\"\"\n        return sum(digits_list)\n\n    all_extracted_digits = []\n    for num in numbers:\n        all_extracted_digits.extend(_extract_digits(num))\n\n    return _calculate_sum(all_extracted_digits)"}
{"task_id": "Mbpp/398", "solution": "def sum_of_digits(numbers: list[int]) -> int:\n    \"\"\"\n    Computes the sum of all individual digits from all numbers in a given list.\n    Handles both positive and negative integers.\n    \"\"\"\n    total_sum = 0\n    for number in numbers:\n        # Get the absolute value to handle negative numbers\n        abs_number = abs(number)\n\n        # Convert to string to easily iterate through digits, then convert back to int\n        for digit_char in str(abs_number):\n            total_sum += int(digit_char)\n    return total_sum"}
