{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"Checks if a given number is an undulating number.\n    An undulating number has at least 3 digits and alternates between exactly two different digits.\"\"\"\n\n    s_num = str(number)\n    num_digits = len(s_num)\n\n    if num_digits < 3:\n        return False\n\n    digit_a = s_num[0]\n    digit_b = s_num[1]\n\n    if digit_a == digit_b:\n        return False\n\n    for i in range(2, num_digits):\n        if i % 2 == 0:  # Even index (0-indexed) should match digit_a\n            if s_num[i] != digit_a:\n                return False\n        else:  # Odd index (0-indexed) should match digit_b\n            if s_num[i] != digit_b:\n                return False\n\n    return True"}
{"task_id": "Mbpp/94", "solution": "from typing import List, Tuple, Union\n\ndef index_minimum(tuple_list: List[Tuple[str, Union[int, float]]]) -> str:\n    \"\"\"\n    Returns the first value of the tuple with the smallest second value.\n\n    Args:\n        tuple_list: List of tuples containing (string, numeric) pairs\n\n    Returns:\n        str: First value of the tuple with minimum second value\n\n    Raises:\n        ValueError: If input list is empty\n    \"\"\"\n    if not tuple_list:\n        raise ValueError(\"Input list cannot be empty.\")\n    \n    min_tuple = min(tuple_list, key=lambda item: item[1])\n    return min_tuple[0]"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(tuple_list: list) -> any:\n    \"\"\"\n    Returns the first value of the tuple with the smallest second value.\n    Assumes tuple_list is non-empty and contains valid tuples with at least two elements.\n    \"\"\"\n    min_first_value = tuple_list[0][0]\n    min_second_value = tuple_list[0][1]\n\n    for i in range(1, len(tuple_list)):\n        current_tuple = tuple_list[i]\n        # Only update if a strictly smaller second value is found to handle duplicate minimums by returning the first occurrence.\n        if current_tuple[1] < min_second_value:\n            min_second_value = current_tuple[1]\n            min_first_value = current_tuple[0]\n    \n    return min_first_value"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists: list) -> int:\n    \"\"\"\n    Finds the length of the smallest list within a list of lists.\n    Assumes the input list_of_lists is not empty and contains at least one sublist.\n    \"\"\"\n    if not list_of_lists:\n        return 0  # Or raise an error, depending on desired behavior for empty input.\n\n    min_length = float('inf')\n    for sublist in list_of_lists:\n        if len(sublist) < min_length:\n            min_length = len(sublist)\n            \n    return min_length"}
{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer.\n    Handles absolute value of input and returns 0 for n=0.\n    \"\"\"\n    # Ensure num is positive for divisor calculation.\n    # Divisors of a negative number are the same as its positive counterpart.\n    # For num=0, it has an infinite number of divisors; returning 0 is a pragmatic choice.\n    num = abs(n)\n\n    if num == 0:\n        return 0\n    if num == 1:\n        return 1\n\n    count = 0\n    # Iterate up to the square root of num.\n    # If i divides num, then num // i also divides num. These are distinct unless i*i == num.\n    limit = int(num**0.5)\n    for i in range(1, limit + 1):\n        if num % i == 0:\n            if i * i == num:\n                count += 1\n            else:\n                count += 2\n    return count"}
{"task_id": "Mbpp/96", "solution": "def divisor(n):\n    \"\"\"\n    Calculates the number of positive divisors for a given integer n.\n    It iterates from 1 up to n, checking for divisibility.\n    \"\"\"\n    count = 0\n    for i in range(1, n + 1):\n        if n % i == 0:\n            count += 1\n    return count"}
