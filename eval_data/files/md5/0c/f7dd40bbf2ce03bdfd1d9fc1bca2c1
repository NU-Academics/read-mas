{"task_id": "Mbpp/261", "solution": "def division_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise mathematical division on two input tuples.\n    Assumes tuples are of equal length and elements are numeric.\n    \"\"\"\n    result_list = []\n    for dividend, divisor in zip(tuple1, tuple2):\n        result_list.append(dividend // divisor)\n    return tuple(result_list)"}
{"task_id": "Mbpp/260", "solution": "def newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the Newman-Shanks-Williams number S(n) and returns it if it is prime.\n    Raises ValueError if S(n) is not prime or if n is an invalid input.\n    \"\"\"\n\n    def _validate_input(k: int):\n        \"\"\"Validates that the input k is a positive integer.\"\"\"\n        if not isinstance(k, int) or k <= 0:\n            raise ValueError(\"Input must be a positive integer.\")\n\n    def _is_prime(num: int) -> bool:\n        \"\"\"Checks if a number is prime.\"\"\"\n        if num < 2:\n            return False\n        for i in range(2, int(num**0.5) + 1):\n            if num % i == 0:\n                return False\n        return True\n\n    def _get_nsw_number(k: int) -> int:\n        \"\"\"Calculates the k-th Newman-Shanks-Williams number S(k).\"\"\"\n        if k == 0:\n            return 1\n        if k == 1:\n            return 1\n        \n        s_prev2 = 1  # Corresponds to S(0)\n        s_prev1 = 1  # Corresponds to S(1)\n        \n        for _ in range(2, k + 1):\n            current_s = 2 * s_prev1 + s_prev2\n            s_prev2 = s_prev1\n            s_prev1 = current_s\n        return s_prev1\n\n    _validate_input(n)\n\n    # Calculate the nth Newman-Shanks-Williams number S(n)\n    nsw_num = _get_nsw_number(n)\n\n    # Check if S(n) is prime\n    if _is_prime(nsw_num):\n        return nsw_num\n    else:\n        raise ValueError(f\"S({n}) = {nsw_num} is not a prime number.\")"}
{"task_id": "Mbpp/260", "solution": "import math\n\ndef is_prime(num: int) -> bool:\n    \"\"\"Checks if a number is prime.\"\"\"\n    if num < 2:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(num)) + 1, 2):\n        if num % i == 0:\n            return False\n    return True\n\ndef validate_input(n: int) -> bool:\n    \"\"\"Validates that input parameter n is a positive integer.\"\"\"\n    # Assuming 'n' is an integer based on type hint and problem context.\n    return n > 0\n\ndef generate_newman_sequence(count: int) -> list[int]:\n    \"\"\"Generates the first 'count' Newman-Shanks-Williams primes, including 2 as the first as per design context.\"\"\"\n    nsw_primes = []\n    if count <= 0:\n        return nsw_primes\n\n    # As per design sequence diagram, 2 is the first prime in this sequence.\n    if count >= 1:\n        nsw_primes.append(2)\n    \n    if count == 1:\n        return nsw_primes\n\n    # Standard NSW sequence starts S_0 = 1, S_1 = 1, S_k = 2*S_{k-1} + S_{k-2}.\n    s_prev2 = 1  # Represents S_0\n    s_prev1 = 1  # Represents S_1\n\n    while len(nsw_primes) < count:\n        s_current = 2 * s_prev1 + s_prev2\n        if is_prime(s_current):\n            nsw_primes.append(s_current)\n        \n        s_prev2 = s_prev1\n        s_prev1 = s_current\n\n    return nsw_primes\n\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the nth Newman-Shanks-Williams prime number.\n    Returns the (n-1)th element from the generated sequence of NSW primes.\n    \"\"\"\n    # Calls validate_input as per design, but does not raise exception as per prompt's constraint.\n    # It assumes 'n' will be a positive integer based on problem statement and assertion.\n    _ = validate_input(n)\n\n    # Generates a list of the first 'n' NSW primes as defined by the problem's context.\n    primes_list = generate_newman_sequence(n)\n    \n    # Returns the nth prime from the generated list (0-indexed list, so element at n-1).\n    return primes_list[n - 1]"}
