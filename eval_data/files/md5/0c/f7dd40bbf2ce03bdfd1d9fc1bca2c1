{"task_id": "Mbpp/253", "solution": "def _is_integer(element: any) -> bool:\n    \"\"\"\n    Determines if an element is of integer type.\n    This uses Python's built-in type checking as required.\n    \"\"\"\n    return isinstance(element, int)\n\ndef _validate_input(input_list: any) -> bool:\n    \"\"\"\n    Validates that input parameter is a list.\n    \"\"\"\n    return isinstance(input_list, list)\n\ndef _count_elements(input_list: list) -> int:\n    \"\"\"\n    Iterates through the list and counts integer elements.\n    \"\"\"\n    count = 0\n    for element in input_list:\n        if _is_integer(element):\n            count += 1\n    return count\n\ndef count_integer(input_list: list) -> int:\n    \"\"\"\n    Returns the number of integer elements in a given list.\n    It orchestrates validation and counting logic using helper functions.\n    \"\"\"\n    # As per design, _validate_input is called. Due to constraints (\"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n    # and requiring an int return), we proceed assuming input_list is a valid list.\n    _validate_input(input_list)\n    return _count_elements(input_list)"}
{"task_id": "Mbpp/255", "solution": "def combinations_colors(input_list, n):\n    \"\"\"\n    Generates all combinations with repetition of elements from `input_list` of length `n`.\n    Returns a list of tuples, where each tuple is a combination.\n    \"\"\"\n    if n == 0:\n        return [()]\n\n    if not input_list:\n        return []\n\n    combinations = []\n    \n    def generate_recursive(current_combination, length_left):\n        if length_left == 0:\n            combinations.append(tuple(current_combination))\n            return\n\n        for element in input_list:\n            current_combination.append(element)\n            generate_recursive(current_combination, length_left - 1)\n            current_combination.pop()\n\n    generate_recursive([], n)\n    return combinations"}
{"task_id": "Mbpp/256", "solution": "import math\n\ndef is_prime(n: int) -> bool:\n    \"\"\"Checks if a number is prime using an optimized algorithm.\"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    limit = int(math.sqrt(n)) + 1\n    for i in range(3, limit, 2):\n        if n % i == 0:\n            return False\n    return True\n\ndef validate_input(number: int) -> bool:\n    \"\"\"Validates that the input number is non-negative.\"\"\"\n    return number >= 0\n\ndef count_Primes_nums(number: int) -> int:\n    \"\"\"Counts the number of prime numbers less than the given non-negative number.\"\"\"\n    if not validate_input(number):\n        raise ValueError(\"Input must be non-negative\")\n\n    count = 0\n    for i in range(2, number):\n        if is_prime(i):\n            count += 1\n    return count"}
