{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(identifiers, names, values):\n    \"\"\"\n    Converts three lists into a list of nested dictionaries, mapping elements by index.\n    Each resulting dictionary contains an identifier as the outer key,\n    a name as the inner key, and a value as the innermost value.\n    \"\"\"\n    result = []\n    for i in range(len(identifiers)):\n        outer_key = identifiers[i]\n        inner_key = names[i]\n        inner_value = values[i]\n        result.append({outer_key: {inner_key: inner_value}})\n    return result"}
{"task_id": "Mbpp/392", "solution": "_memo = {}\n\ndef get_max_sum(n: int) -> int:\n    \"\"\"Calculates the maximum sum for n using a recursive formula with memoization.\"\"\"\n    if n in _memo:\n        return _memo[n]\n\n    if n <= 1:\n        _memo[n] = n\n        return n\n\n    # Recursively calculate the sum of parts using integer division\n    sum_recursive_parts = (\n        get_max_sum(n // 2) +\n        get_max_sum(n // 3) +\n        get_max_sum(n // 4) +\n        get_max_sum(n // 5)\n    )\n\n    # Determine the maximum between the sum of parts and n itself\n    result = max(sum_recursive_parts, n)\n    _memo[n] = result\n    return result"}
{"task_id": "Mbpp/392", "solution": "def get_max_sum(n, memo=None):\n    \"\"\"\n    Calculates the maximum sum for a given integer n using the recursive equation\n    f(n) = max((f(n/2) + f(n/3) + f(n/4) + f(n/5)), n), with memoization.\n    \"\"\"\n    # Initialize memoization dictionary for the current call stack if not provided.\n    if memo is None:\n        memo = {}\n\n    # Base case: for non-positive integers, the value 'n' itself is the maximum sum.\n    # This also handles f(0)=0 and f(1)=1 efficiently.\n    if n <= 1:\n        return n\n\n    # If the result for 'n' is already computed, return it from the memoization cache.\n    if n in memo:\n        return memo[n]\n\n    # Recursively calculate the sum of the parts using integer division.\n    sum_parts = (\n        get_max_sum(n // 2, memo) +\n        get_max_sum(n // 3, memo) +\n        get_max_sum(n // 4, memo) +\n        get_max_sum(n // 5, memo)\n    )\n\n    # The maximum sum for 'n' is the greater of 'n' itself or the sum of its parts.\n    result = max(sum_parts, n)\n\n    # Store the computed result in the memoization dictionary before returning.\n    memo[n] = result\n    return result"}
{"task_id": "Mbpp/395", "solution": "def first_non_repeating_character(input_string: str) -> str | None:\n    \"\"\"\n    Finds the first non-repeated character in a given string.\n    Returns None if no non-repeated character is found or the string is empty.\n    \"\"\"\n    if not input_string:\n        return None\n\n    # Use a dictionary to store character counts.\n    # We iterate through the string twice: once to count, once to find the first unique.\n    char_counts = {}\n    for char in input_string:\n        char_counts[char] = char_counts.get(char, 0) + 1\n\n    for char in input_string:\n        if char_counts[char] == 1:\n            return char\n\n    return None"}
