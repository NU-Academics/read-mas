{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    \"\"\"\n    l_prime = list(l)  # Create a copy of the input list for the result.\n    even_elements = []\n\n    # Extract values from even indices into a temporary list.\n    for i in range(len(l)):\n        if i % 2 == 0:\n            even_elements.append(l[i])\n\n    even_elements.sort()  # Sort the temporary list of even-indexed values.\n\n    sorted_even_idx = 0\n    # Iterate through the result list, placing sorted even values back into even indices.\n    for i in range(len(l_prime)):\n        if i % 2 == 0:\n            l_prime[i] = even_elements[sorted_even_idx]\n            sorted_even_idx += 1\n\n    return l_prime"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\"\"\"\n\n    def _is_divisible_by_11_or_13(num: int) -> bool:\n        \"\"\"Checks if a number is divisible by 11 or 13.\"\"\"\n        return (num % 11 == 0) or (num % 13 == 0)\n\n    def _count_digit_7(num: int) -> int:\n        \"\"\"Counts occurrences of the digit '7' in a number's decimal representation.\"\"\"\n        count = 0\n        s_num = str(num)\n        for digit_char in s_num:\n            if digit_char == '7':\n                count += 1\n        return count\n\n    total_count = 0\n    for i in range(1, n):\n        if _is_divisible_by_11_or_13(i):\n            total_count += _count_digit_7(i)\n    return total_count"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # restore elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
