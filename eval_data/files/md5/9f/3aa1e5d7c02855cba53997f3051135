{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    Checks if there are three distinct elements in the list that sum to zero.\n    Returns True if such a triple exists, False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    for i in range(n - 2):\n        for j in range(i + 1, n - 1):\n            for k in range(j + 1, n):\n                if l[i] + l[j] + l[k] == 0:\n                    return True\n    return False"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if x == 0:\n        return '0'\n\n    # As per design context, raise ValueError for invalid base.\n    if not (1 < base < 10):\n        raise ValueError(\"Base must be an integer between 2 and 9 (exclusive).\")\n\n    result = []\n    is_negative = False\n    if x < 0:\n        is_negative = True\n        x = -x\n\n    while x > 0:\n        remainder = x % base\n        result.append(str(remainder))\n        x //= base\n\n    if is_negative:\n        result.append('-')\n\n    return ''.join(result[::-1])"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    n = len(l)\n    if n < 2:\n        return False\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            if l[i] + l[j] == 0:\n                return True\n    return False"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence. Computes the n-th element using an iterative approach.\"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize the four most recent Fib4 numbers for n-4, n-3, n-2, n-1\n    # For i=4, these correspond to fib4(0), fib4(1), fib4(2), fib4(3)\n    fib_n_minus_4 = 0  # fib4(0)\n    fib_n_minus_3 = 0  # fib4(1)\n    fib_n_minus_2 = 2  # fib4(2)\n    fib_n_minus_1 = 0  # fib4(3)\n\n    for _ in range(4, n + 1):\n        current_fib = fib_n_minus_1 + fib_n_minus_2 + fib_n_minus_3 + fib_n_minus_4\n        # Shift values for the next iteration\n        fib_n_minus_4 = fib_n_minus_3\n        fib_n_minus_3 = fib_n_minus_2\n        fib_n_minus_2 = fib_n_minus_1\n        fib_n_minus_1 = current_fib\n    \n    return fib_n_minus_1"}
{"task_id": "HumanEval/45", "solution": "def triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    return 0.5 * a * h"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    Calculates (2^n) % p using modular exponentiation by squaring, ensuring numerical correctness.\n    \"\"\"\n    if p == 1:\n        return 0\n    res = 1\n    base = 2 % p\n    while n > 0:\n        if n % 2 == 1:\n            res = (res * base) % p\n        base = (base * base) % p\n        n //= 2\n    return res"}
