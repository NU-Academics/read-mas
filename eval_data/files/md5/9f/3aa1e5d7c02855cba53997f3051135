{"task_id": "HumanEval/53", "solution": "def add(x: int, y: int):\n    \"\"\"Add two numbers x and y\n    >>> add(2, 3)\n    5\n    >>> add(5, 7)\n    12\n    \"\"\"\n    class Number:\n        \"\"\"Represents an integer number.\"\"\"\n        def __init__(self, value: int):\n            self.value = value\n\n    class Calculation:\n        \"\"\"Provides core arithmetic operations.\"\"\"\n        def add(self, num1: Number, num2: Number) -> Number:\n            \"\"\"Adds two Number objects and returns a new Number object.\"\"\"\n            return Number(num1.value + num2.value)\n\n    num1 = Number(x)\n    num2 = Number(y)\n\n    calculator = Calculation()\n    result_number = calculator.add(num1, num2)\n\n    return result_number.value"}
{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    tolerance = 1e-7\n\n    # Initialize search interval (bracket)\n    # For odd-degree polynomials (len(xs) is even, so degree is len(xs)-1 which is odd),\n    # there is always a real root. We expand the interval until a sign change is found.\n    low, high = -1.0, 1.0\n    p_low = poly(xs, low)\n    p_high = poly(xs, high)\n\n    # Check if initial points are already roots within tolerance\n    if abs(p_low) < tolerance:\n        return low\n    if abs(p_high) < tolerance:\n        return high\n\n    # Expand the interval until poly(low) and poly(high) have opposite signs.\n    # This guarantees a root exists within [low, high].\n    while p_low * p_high > 0:\n        low *= 2.0\n        high *= 2.0\n        p_low = poly(xs, low)\n        p_high = poly(xs, high)\n\n        # Check if new interval boundaries are roots\n        if abs(p_low) < tolerance:\n            return low\n        if abs(p_high) < tolerance:\n            return high\n\n    # Bisection method to find a root within the bracket [low, high]\n    while abs(high - low) > tolerance:\n        mid = (low + high) / 2.0\n        p_mid = poly(xs, mid)\n\n        # If poly(mid) is close enough to zero, we found a root\n        if abs(p_mid) < tolerance:\n            return mid\n\n        # Update the interval based on the sign of p_mid\n        # If p_low and p_mid have opposite signs, the root is in [low, mid]\n        if p_low * p_mid < 0:\n            high = mid\n            p_high = p_mid\n        # Otherwise, the root is in [mid, high]\n        else:\n            low = mid\n            p_low = p_mid\n\n    # Return the midpoint of the final converged interval as the root\n    return (low + high) / 2.0"}
{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    else:\n        a, b = 0, 1\n        for _ in range(2, n + 1):\n            a, b = b, a + b\n        return b"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_factor = 1\n    d = 2\n    temp_n = n\n\n    while d * d <= temp_n:\n        if temp_n % d == 0:\n            largest_factor = d\n            while temp_n % d == 0:\n                temp_n //= d\n        d += 1\n\n    if temp_n > 1:  # If temp_n is still greater than 1, it must be a prime factor\n        largest_factor = temp_n\n\n    return largest_factor"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n\n    \"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n    common_set = set1.intersection(set2)\n    result_list = list(common_set)\n    result_list.sort()\n    return result_list"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\"\"\"\n\n    def _is_monotonically_increasing(l: list) -> bool:\n        \"\"\"Helper function to check if a list is monotonically increasing.\"\"\"\n        if len(l) <= 1:\n            return True\n        for i in range(1, len(l)):\n            if l[i] < l[i-1]:\n                return False\n        return True\n\n    def _is_monotonically_decreasing(l: list) -> bool:\n        \"\"\"Helper function to check if a list is monotonically decreasing.\"\"\"\n        if len(l) <= 1:\n            return True\n        for i in range(1, len(l)):\n            if l[i] > l[i-1]:\n                return False\n        return True\n\n    return _is_monotonically_increasing(l) or _is_monotonically_decreasing(l)"}
