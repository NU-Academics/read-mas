.0\n        self._calculate_stats()\n\n    def _calculate_stats(self):\n        \"\"\"Calculates the total cost, number of cells, and average cost for the path.\"\"\"\n        self.total_cost = sum(cell.cost for cell in self.sequence_of_cells)\n        self.number_of_cells = len(self.sequence_of_cells)\n        if self.number_of_cells > 0:\n            self.average_cost = self.total_cost / self.number_of_cells\ndef find_all_paths(matrix: Matrix) -> list[Path]:\n    \"\"\"Recursively explores the matrix to identify all valid paths from top-left to bottom-right.\"\"\"\n    all_paths: list[Path] = []\n    \n    def dfs(r: int, c: int, current_path_cells: list[Cell]):\n        if r >= matrix.N or c >= matrix.N:\n            return\n\n        current_path_cells.append(matrix.cells[r][c])\n\n        if r == matrix.N - 1 and c == matrix.N - 1:\n            all_paths.append(Path(list(current_path_cells)))\n        else:\n            dfs(r + 1, c, current_path_cells) # Move down\n            dfs(r, c + 1, current_path_cells) # Move right\n        \n        current_path_cells.pop() # Backtrack\n\n    dfs(0, 0, [])\n    return all_paths\ndef calculate_max_average_cost(paths: list[Path]) -> float:\n    \"\"\"Iterates through a list of paths to find the one with the highest average cost.\"\"\"\n    if not paths:\n        return 0.0\n    \n    max_avg = -math.inf\n    for path in paths:\n        if path.average_cost > max_avg:\n            max_avg = path.average_cost\n    return max_avg\ndef maxAverageOfPath(matrix_data: list[list[int]]) -> float:\n    \"\"\"\n    Given a square matrix, finds a path from top-left to bottom-right (moving only right or down)\n    with the maximum average cost over all existing paths.\n    \"\"\"\n    matrix_obj = Matrix(matrix_data)\n    all_valid_paths = find_all_paths(matrix_obj)\n    max_avg_cost = calculate_max_average_cost(all_valid_paths)\n    return max_avg_cost", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fai