oat, element2: int | float):\n        self.element1 = element1\n        self.element2 = element2\n\n    def to_tuple(self) -> tuple[int | float, int | float]:\n        \"\"\"Converts the Tuple object back to a native Python tuple.\"\"\"\n        return (self.element1, self.element2)\n\n    def __eq__(self, other) -> bool:\n        if not isinstance(other, Tuple):\n            return NotImplemented\n        return self.element1 == other.element1 and self.element2 == other.element2\n\n    def __hash__(self) -> int:\n        return hash((self.element1, self.element2))\nclass Combination:\n    \"\"\"\n    Represents a unique, order-agnostic pair of distinct Tuple objects.\n    \"\"\"\n    def __init__(self, tuple1: Tuple, tuple2: Tuple):\n        self.tuple1 = tuple1\n        self.tuple2 = tuple2\n\n    def __eq__(self, other) -> bool:\n        if not isinstance(other, Combination):\n            return NotImplemented\n        # Order-agnostic comparison for the two tuples\n        return (self.tuple1 == other.tuple1 and self.tuple2 == other.tuple2) or \\\n               (self.tuple1 == other.tuple2 and self.tuple2 == other.tuple1)\n\n    def __hash__(self) -> int:\n        # Order-agnostic hash using a frozenset of the constituent tuple hashes\n        return hash(frozenset({hash(self.tuple1), hash(self.tuple2)}))\nclass SumTuple:\n    \"\"\"\n    Represents a 2-element numerical tuple resulting from an element-wise sum.\n    \"\"\"\n    def __init__(self, sum_element1: int | float, sum_element2: int | float):\n        self.sum_element1 = sum_element1\n        self.sum_element2 = sum_element2\n\n    def to_tuple(self) -> tuple[int | float, int | float]:\n        \"\"\"Converts the SumTuple object back to a native Python tuple.\"\"\"\n        return (self.sum_element1, self.sum_element2)\ndef validate_input_tuples(input_list: list) -> list[Tuple]:\n    \"\"\"Converts a list of native tuples into a list of Tuple objects.\"\"\"\n    return [Tuple(t[0], t[1]) for t in input