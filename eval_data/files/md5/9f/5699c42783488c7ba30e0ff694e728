ned opening or closing bracket.\n        if char not in opening_chars and char not in closing_chars:\n            continue\n\n        bracket_obj = Bracket(char)\n\n        if bracket_obj.is_opening():\n            # If it's an opening bracket, push its character onto the stack.\n            stack.append(bracket_obj.get_character())\n        else: # It's a closing bracket.\n            # If the stack is empty, a closing bracket appeared without a corresponding opening one.\n            if not stack:\n                return False\n\n            # Pop the last opening bracket character from the stack.\n            last_opening_char = stack.pop()\n            \n            # Check if the popped opening bracket correctly matches the current closing bracket.\n            if _bracket_matching_pairs.get(last_opening_char) != bracket_obj.get_character():\n                return False\n\n    # After iterating through the entire string, if the stack is empty, all brackets are balanced.\n    return not stack", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[""]]}], "Mbpp/777": [{"task_id": "Mbpp/777", "solution": "from typing import List, Union\nfrom collections import Counter\ndef find_sum(input_list: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the sum of non-repeated (unique) elements in a given list of numbers.\n    An element is considered non-repeated if it appears exactly once in the input list.\n    \"\"\"\n    element_counts = Counter(input_list)\n    unique_elements = [element for element, count in element_counts.items() if count == 1]\n    return sum(unique_elements)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 2, 3, 1, 1, 4, 5, 6]]], "plus_fail_tests": [[[-1, -2, -3, -1, -1, -4, -5, -6]]]}], "Mbpp/775": [{"task_id": "Mbpp/775", "solution": "def odd_position(input_list: list) -> bool:\n    \"\"\"\n    Checks if every odd index in the input_list contains an odd number.