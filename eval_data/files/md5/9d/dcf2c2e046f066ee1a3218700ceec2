{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_string: str) -> str:\n    \"\"\"\n    Inserts spaces between words starting with capital letters in a given string.\n    \"\"\"\n    class CapitalWordsSpaceInserter:\n        \"\"\"Helper class to encapsulate logic for inserting spaces.\"\"\"\n        def insertSpaces(self, input_str_to_process: str) -> str:\n            if not input_str_to_process:\n                return \"\"\n\n            # Start with the first character; no space is inserted before it.\n            result_parts = [input_str_to_process[0]]\n            # Iterate through the string starting from the second character.\n            for char in input_str_to_process[1:]:\n                if char.isupper():\n                    result_parts.append(\" \")  # Add a space before an uppercase letter.\n                result_parts.append(char)\n            return \"\".join(result_parts)\n\n    inserter = CapitalWordsSpaceInserter()\n    return inserter.insertSpaces(input_string)"}
{"task_id": "Mbpp/745", "solution": "class Number:\n    \"\"\"Encapsulates an integer, extracts its digits, and checks for divisibility properties.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n        self.digits = self._extract_digits()\n\n    def _extract_digits(self) -> list[int]:\n        \"\"\"Extracts individual decimal digits from the number.\"\"\"\n        if self.value == 0:\n            return [0]\n        \n        digits = []\n        temp_value = self.value\n        while temp_value > 0:\n            digits.append(temp_value % 10)\n            temp_value //= 10\n        return digits[::-1]\n\n    def contains_zero_digit(self) -> bool:\n        \"\"\"Checks if any digit of the number is zero.\"\"\"\n        return 0 in self.digits\n\n    def is_divisible_by_all_digits(self) -> bool:\n        \"\"\"Checks if the number is divisible by each of its non-zero digits.\"\"\"\n        for digit in self.digits:\n            if self.value % digit != 0:\n                return False\n        return True\n\nclass Range:\n    \"\"\"Represents an inclusive numerical range.\"\"\"\n    def __init__(self, start: int, end: int):\n        self.start = start\n        self.end = end\n\nclass ResultSet:\n    \"\"\"Collects and manages qualifying Number objects.\"\"\"\n    def __init__(self):\n        self.numbers: list[Number] = []\n\n    def add(self, num: Number):\n        \"\"\"Adds a Number object to the result set.\"\"\"\n        self.numbers.append(num)\n\n    def get_sorted_values(self) -> list[int]:\n        \"\"\"Returns the sorted list of integer values from the collected numbers.\"\"\"\n        return [num.value for num in self.numbers]\n\ndef divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    Numbers containing the digit 0 are excluded.\n    \"\"\"\n    \n    # The design specifies creating a Range object, though it's not strictly used for iteration.\n    # It fulfills the design's component interaction.\n    _range = Range(startnum, endnum) \n    result_set = ResultSet()\n\n    for current_num in range(_range.start, _range.end + 1):\n        number_obj = Number(current_num)\n        \n        if number_obj.contains_zero_digit():\n            continue # Exclude numbers containing the digit 0 (FR3)\n        \n        if number_obj.is_divisible_by_all_digits():\n            result_set.add(number_obj) # Add qualifying numbers (FR1)\n\n    return result_set.get_sorted_values() # Return sorted list (FR4)"}
{"task_id": "Mbpp/749", "solution": "def sort_numeric_strings(strings):\n    \"\"\"\n    Converts a list of numeric strings to integers and sorts them numerically.\n    Raises ValueError if any string cannot be converted to an integer.\n    \"\"\"\n    \n    converted_numbers = []\n    for s in strings:\n        try:\n            converted_numbers.append(int(s))\n        except ValueError as e:\n            # Re-raise ValueError as per design if conversion fails\n            raise ValueError(f\"Invalid numeric string found: '{s}'\") from e\n            \n    return sorted(converted_numbers)"}
