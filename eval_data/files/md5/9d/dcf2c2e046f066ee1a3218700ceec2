{"task_id": "Mbpp/96", "solution": "def divisor(n):\n    \"\"\"\n    Calculates the number of positive divisors for a given integer.\n    Handles negative inputs by using their absolute value; returns 0 for zero input.\n    \"\"\"\n    num_abs = abs(n)\n    if num_abs == 0:\n        return 0\n\n    count = 0\n    i = 1\n    # Iterate up to the square root of num_abs to find divisors\n    while i * i <= num_abs:\n        if num_abs % i == 0:\n            if i * i == num_abs:\n                count += 1  # If i is the square root, it's counted once\n            else:\n                count += 2  # i and num_abs/i are distinct divisors, count both\n        i += 1\n    return count"}
{"task_id": "Mbpp/97", "solution": "def frequency_lists(list_of_lists):\n    \"\"\"\n    Calculates the frequency of each element in a flattened list of lists.\n    Returns a dictionary where keys are elements and values are their counts.\n    \"\"\"\n    from collections import Counter\n\n    flat_list = [item for sublist in list_of_lists for item in sublist]\n    return dict(Counter(flat_list))"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(n: int) -> str:\n    \"\"\"\n    Converts a non-negative integer to its binary string representation.\n    Handles the zero case and iteratively builds the binary string without leading zeros.\n    \"\"\"\n    if n == 0:\n        return '0'\n\n    binary_digits = []\n    # Use a temporary variable for the value as per DecimalNumber concept\n    current_n = n\n\n    # The core conversion logic, mimicking BinaryConverter's role.\n    while current_n > 0:\n        remainder = current_n % 2\n        binary_digits.append(str(remainder))\n        current_n //= 2\n\n    # Binary digits are collected in reverse order, so reverse the list and join.\n    # This result conceptually corresponds to BinaryString.representation.\n    return \"\".join(binary_digits[::-1])"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome integer strictly greater than the input.\n    It delegates the core logic to an internal PalindromeFinder class.\n    \"\"\"\n    class PalindromeFinder:\n        \"\"\"Helper class to encapsulate the palindrome finding algorithm.\"\"\"\n        def find_next_palindrome(self, input_int: int) -> int:\n            \"\"\"Increments the input until a palindrome is found using string reversal.\"\"\"\n            num = input_int + 1\n            while True:\n                s_num = str(num)\n                if s_num == s_num[::-1]:\n                    return num\n                num += 1\n\n    finder = PalindromeFinder()\n    return finder.find_next_palindrome(n)"}
