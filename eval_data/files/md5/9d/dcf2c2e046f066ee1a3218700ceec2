{"task_id": "Mbpp/639", "solution": "class Name:\n    \"\"\"Represents a single name string, providing a method to check its capitalization.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def startsWithUppercase(self) -> bool:\n        \"\"\"Returns True if the name's first character is an uppercase letter.\"\"\"\n        if not self.value:\n            return False\n        return self.value[0].isupper()\n\nclass NameList:\n    \"\"\"Manages a collection of Name objects and calculates the sum of lengths for uppercase names.\"\"\"\n    def __init__(self, name_strings: list[str]):\n        self.names = [Name(s) for s in name_strings]\n\n    def sumLengthsOfUppercaseNames(self) -> int:\n        \"\"\"Computes the total length of names that start with an uppercase letter.\"\"\"\n        total_length = 0\n        for name_obj in self.names:\n            if name_obj.startsWithUppercase():\n                total_length += len(name_obj.value)\n        return total_length\n\ndef sample_nam(names: list[str]) -> int:\n    \"\"\"\n    Sums the length of names that start with an uppercase letter from a given list.\n    \"\"\"\n    name_list_obj = NameList(names)\n    return name_list_obj.sumLengthsOfUppercaseNames()"}
