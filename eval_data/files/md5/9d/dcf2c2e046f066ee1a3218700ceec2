{"task_id": "Mbpp/119", "solution": "def search(arr: list[int]) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where all other elements appear twice.\n    Uses binary search to efficiently locate the unique element.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n\n    while low < high:\n        mid = (low + high) // 2\n\n        # Ensure mid points to the start of a potential pair (an even index)\n        # If mid is odd, decrement it to point to the even index before it\n        if mid % 2 == 1:\n            mid -= 1\n\n        # If arr[mid] is equal to its next element, this pair is regular.\n        # The unique element must be in the subarray to the right.\n        if arr[mid] == arr[mid + 1]:\n            low = mid + 2\n        # Otherwise, the unique element is either arr[mid] or in the subarray to its left.\n        else:\n            high = mid\n\n    # When low equals high, that index points to the unique element.\n    return arr[low]"}
{"task_id": "Mbpp/120", "solution": "from typing import List, Tuple, Optional\n\ndef max_product_tuple(pairs: List[Tuple[int, int]]) -> Optional[int]:\n    \"\"\"Finds the maximum absolute product from a list of two-integer tuples.\"\"\"\n    if not pairs:\n        return None\n\n    max_abs_prod = float('-inf')\n\n    for a, b in pairs:\n        current_prod = a * b\n        abs_current_prod = abs(current_prod)\n        if abs_current_prod > max_abs_prod:\n            max_abs_prod = abs_current_prod\n            \n    return int(max_abs_prod)"}
{"task_id": "Mbpp/123", "solution": "import math\n\nclass Number:\n    \"\"\"Represents an integer and provides methods for number theory calculations.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def sumOfProperDivisors(self) -> int:\n        \"\"\"Calculates the sum of proper divisors for the number.\"\"\"\n        if self.value <= 1:\n            return 0\n        s = 1 # 1 is always a proper divisor\n        limit = int(math.sqrt(self.value))\n        for i in range(2, limit + 1):\n            if self.value % i == 0:\n                s += i\n                if i * i != self.value: # Avoid adding the square root twice\n                    s += (self.value // i)\n        return s\n\nclass AmicableNumberService:\n    \"\"\"Orchestrates the calculation of sums of amicable numbers.\"\"\"\n    def __init__(self):\n        pass\n\n    def calculateSum(self, n: int) -> int:\n        \"\"\"Calculates the sum of all amicable numbers up to n.\"\"\"\n        total_sum = 0\n        found_amicable_numbers = set() # Cache to avoid redundant checks and double-counting\n\n        for i in range(2, n + 1): # Start from 2, as 1 is not amicable\n            if i in found_amicable_numbers:\n                continue\n\n            num_i = Number(i)\n            sum_div_i = num_i.sumOfProperDivisors()\n\n            # Check if sum_div_i forms a potential amicable pair and is within range\n            if sum_div_i > i and sum_div_i <= n:\n                num_j = Number(sum_div_i)\n                sum_div_j = num_j.sumOfProperDivisors()\n\n                if sum_div_j == i: # Found an amicable pair (i, sum_div_i)\n                    total_sum += i\n                    total_sum += sum_div_i\n                    found_amicable_numbers.add(i)\n                    found_amicable_numbers.add(sum_div_i)\n        return total_sum\n\ndef amicable_numbers_sum(n: int) -> int:\n    \"\"\"\n    Sums all amicable numbers from 1 to a specified number n.\n    Returns 0 if n is less than 1.\n    \"\"\"\n    if n < 1:\n        return 0\n    \n    service = AmicableNumberService()\n    return service.calculateSum(n)"}
