{"task_id": "Mbpp/130", "solution": "from typing import List\n\ndef max_occurrences(lst: List[int]) -> int:\n    \"\"\"Finds the item with the maximum frequency in a given list in a single pass.\"\"\"\n    frequency_map = {}\n    max_freq_item = None\n    max_freq_count = 0\n\n    for item in lst:\n        frequency_map[item] = frequency_map.get(item, 0) + 1\n        current_freq = frequency_map[item]\n\n        if current_freq > max_freq_count:\n            max_freq_count = current_freq\n            max_freq_item = item\n            \n    return max_freq_item"}
{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix):\n    \"\"\"\n    Determines if a given square matrix of integers is a magic square.\n    Assumes the input is a valid square matrix of integers.\n    \"\"\"\n    n = len(matrix)\n\n    # Calculate the sum of the first row as the reference sum.\n    target_sum = sum(matrix[0])\n\n    # Check sums of all rows.\n    for i in range(n):\n        if sum(matrix[i]) != target_sum:\n            return False\n\n    # Check sums of all columns.\n    for j in range(n):\n        col_sum = 0\n        for i in range(n):\n            col_sum += matrix[i][j]\n        if col_sum != target_sum:\n            return False\n\n    # Check sum of the main diagonal (top-left to bottom-right).\n    main_diag_sum = 0\n    for i in range(n):\n        main_diag_sum += matrix[i][i]\n    if main_diag_sum != target_sum:\n        return False\n\n    # Check sum of the anti-diagonal (top-right to bottom-left).\n    anti_diag_sum = 0\n    for i in range(n):\n        anti_diag_sum += matrix[i][n - 1 - i]\n    if anti_diag_sum != target_sum:\n        return False\n\n    # If all sums match the target sum, it is a magic square.\n    return True"}
{"task_id": "Mbpp/131", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\ndef reverse_vowels(input_string: str) -> str:\n    \"\"\"\n    Reverse only the vowels in the input string.\n    'y' is treated as a consonant.\n    \"\"\"\n    if not input_string:\n        return input_string\n\n    chars = list(input_string)\n    vowel_indices = [i for i, ch in enumerate(chars) if ch.lower() in VOWELS]\n\n    left, right = 0, len(vowel_indices) - 1\n    while left < right:\n        i, j = vowel_indices[left], vowel_indices[right]\n        chars[i], chars[j] = chars[j], chars[i]\n        left += 1\n        right -= 1\n\n    return ''.join(chars)"}
