{"task_id": "Mbpp/271", "solution": "class EvenNumber:\n    def __init__(self, value: int):\n        self.value = value\n\n    def powerFifth(self) -> int:\n        return self.value ** 5\n\n\nclass PowerCalculator:\n    @staticmethod\n    def computePower(base: int, exponent: int) -> int:\n        return base ** exponent\n\n\nclass SumCalculator:\n    def computeSum(self, n: int) -> int:\n        if n <= 0:\n            return 0\n        total = 0\n        for k in range(1, n + 1):\n            even = EvenNumber(2 * k)\n            powered = PowerCalculator.computePower(even.value, 5)\n            total += powered\n        return total\n\n\ndef even_Power_Sum(n: int) -> int:\n    \"\"\"Computes the sum of the first n even natural numbers raised to the fifth power.\n    Returns 0 if n is not positive.\n    \"\"\"\n    calculator = SumCalculator()\n    return calculator.computeSum(n)"}
