{"task_id": "Mbpp/398", "solution": "from typing import List\n\nclass Number:\n    \"\"\"A value object that knows how to compute its own digit sum.\"\"\"\n    def __init__(self, value: int):\n        self.value = abs(value)\n\n    def digit_sum(self) -> int:\n        \"\"\"Computes the sum of the digits of the number.\"\"\"\n        return sum(int(d) for d in str(self.value))\n\nclass SumOfDigitsCalculator:\n    \"\"\"Orchestrates the calculation of the sum of digits for a list of numbers.\"\"\"\n    def sum_of_digits(self, numbers: List[int]) -> int:\n        \"\"\"Calculates the total sum of digits for all numbers in the list.\"\"\"\n        return sum(Number(n).digit_sum() for n in numbers)\n\ndef sum_of_digits(numbers: List[int]) -> int:\n    \"\"\"Computes the sum of digits of each number of a given list.\"\"\"\n    calculator = SumOfDigitsCalculator()\n    return calculator.sum_of_digits(numbers)"}
