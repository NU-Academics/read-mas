{"task_id": "Mbpp/767", "solution": "from collections import Counter\nfrom typing import List\n\ndef get_pairs_count(numbers: List[int], target: int) -> int:\n    \"\"\"\n    Counts pairs of numbers in a list that sum to a specific target value.\n    Handles duplicate numbers and counts unordered pairs.\n    \"\"\"\n    freq = Counter(numbers)\n    count = 0\n    for x in list(freq):\n        y = target - x\n        if y not in freq:\n            continue\n        if x == y:\n            # If x and y are the same, we need to choose 2 numbers from freq[x]\n            count += freq[x] * (freq[x] - 1) // 2\n        elif x < y:\n            # If x and y are different, multiply their frequencies\n            count += freq[x] * freq[y]\n    return count"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"Calculate the sum of the fourth powers of the first n odd natural numbers.\"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    total = 0\n    for k in range(1, n + 1):\n        odd_num = 2 * k - 1\n        total += odd_num ** 4\n    return total"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1, list2):\n    \"\"\"\n    Computes the difference between two lists, reordering remaining elements.\n    Elements not in list2 are kept from list1. Even-indexed elements from original list1\n    precede odd-indexed elements, while preserving their relative order.\n    \"\"\"\n    set2 = set(list2)\n    evens_list = []\n    odds_list = []\n\n    for i, item in enumerate(list1):\n        if item not in set2:\n            if i % 2 == 0:\n                evens_list.append(item)\n            else:\n                odds_list.append(item)\n\n    return evens_list + odds_list"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced parentheses, brackets, and braces.\n    \"\"\"\n    stack = []\n    opening_brackets = \"([{\"\n    closing_brackets = \")]}\"\n    bracket_map = {\")\": \"(\", \"]\": \"[\", \"}\": \"{\"}\n\n    for char in expression:\n        if char in opening_brackets:\n            stack.append(char)\n        elif char in closing_brackets:\n            if not stack:\n                return False\n            top_of_stack = stack.pop()\n            if bracket_map[char] != top_of_stack:\n                return False\n    \n    return not stack"}
