{"task_id": "Mbpp/91", "solution": "class Substring:\n    \"\"\"\n    Holds a substring value.\n    \"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass StringList:\n    \"\"\"\n    Manages a list of strings and provides search functionality.\n    \"\"\"\n    def __init__(self, items: list[str]):\n        self.items = items\n\n    def containsSubstring(self, substring_value: str) -> bool:\n        \"\"\"\n        Checks if any item in the list contains the given substring value.\n        \"\"\"\n        for item in self.items:\n            if substring_value in item:\n                return True\n        return False\n\ndef find_substring(items: list[str], substring: str) -> bool:\n    \"\"\"\n    Checks if a string is present as a substring in a given list of string values.\n    \"\"\"\n    substring_holder = Substring(substring)\n    string_list_manager = StringList(items)\n    result = string_list_manager.containsSubstring(substring_holder.value)\n    return result"}
{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"Checks if a number is undulating, meaning its digits alternate between two distinct values.\n    For example, 1212121 is undulating (1, 2, 1, 2, 1, 2, 1).\"\"\"\n    s_num = str(number)\n    n = len(s_num)\n\n    # An undulating number needs at least three digits to establish an 'A, B, A' pattern.\n    # It must also alternate between two distinct values.\n    if n < 3:\n        return False\n\n    first_digit = s_num[0]\n    second_digit = s_num[1]\n\n    # The first two digits must be distinct to alternate between two different values.\n    if first_digit == second_digit:\n        return False\n\n    # Verify the alternating pattern for the subsequent digits.\n    for i in range(2, n):\n        if (i % 2 == 0 and s_num[i] != first_digit) or \\\n           (i % 2 != 0 and s_num[i] != second_digit):\n            return False\n\n    return True"}
