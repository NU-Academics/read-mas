{"task_id": "Mbpp/733", "solution": "from typing import List\n\ndef find_first_occurrence(array: List[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array.\n    Returns -1 if the target is not found.\n    \"\"\"\n    left, right = 0, len(array) - 1\n    first_occurrence_index = -1\n\n    while left <= right:\n        mid = (left + right) // 2\n        if array[mid] == target:\n            first_occurrence_index = mid\n            right = mid - 1  # Found a match, but continue searching in the left half for an earlier occurrence\n        elif array[mid] < target:\n            left = mid + 1\n        else:  # array[mid] > target\n            right = mid - 1\n\n    return first_occurrence_index"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(elements):\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists.\n    This function iterates through all sublists, computes their product, and accumulates the sum.\n    \"\"\"\n    total_sum = 0\n    n = len(elements)\n\n    for i in range(n):\n        current_product = 1\n        for j in range(i, n):\n            current_product *= elements[j]\n            total_sum += current_product\n\n    return total_sum"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"\n    Toggles all bits of the number except the first (most significant) and the last (least significant) bit.\n    \"\"\"\n    bit_length = number.bit_length()\n\n    if bit_length <= 2:\n        return number\n\n    # Create a mask with 1s for all middle bits\n    # (bit_length - 2) is the count of middle bits\n    # ((1 << (bit_length - 2)) - 1) creates a sequence of (bit_length - 2) ones\n    # << 1 shifts these ones to start from the second bit position (index 1)\n    mask = ((1 << (bit_length - 2)) - 1) << 1\n\n    # XOR the number with the mask to toggle only the middle bits\n    result = number ^ mask\n    return result"}
