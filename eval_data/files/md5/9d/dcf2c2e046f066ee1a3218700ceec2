{"task_id": "Mbpp/261", "solution": "def division_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Performs element-wise division of two tuples.\"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n    result = []\n    for idx, (num, den) in enumerate(zip(tuple1, tuple2)):\n        if den == 0:\n            raise ZeroDivisionError(f\"Division by zero at index {idx}.\")\n        result.append(num / den)\n\n    return tuple(result)"}
{"task_id": "Mbpp/260", "solution": "def is_prime(num: int) -> bool:\n    \"\"\"Return True if num is prime, False otherwise.\"\"\"\n    if num < 2:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    i = 3\n    while i * i <= num:\n        if num % i == 0:\n            return False\n        i += 2\n    return True\n\ndef _generate_nsw_sequence():\n    \"\"\"\n    Generates terms of the Newman-Shanks-Williams sequence using\n    S_n = 3*S_{n-1} - S_{n-2} with S_0 = 1 and S_1 = 3.\n    \"\"\"\n    s_prev2 = 1  # S_0\n    s_prev1 = 3  # S_1\n\n    yield s_prev2 # Yield S_0\n    yield s_prev1 # Yield S_1\n\n    while True:\n        s_current = 3 * s_prev1 - s_prev2\n        yield s_current\n        s_prev2 = s_prev1\n        s_prev1 = s_current\n\nclass NewmanShanksWilliamsPrimeCalculator:\n    def calculate(self, n_prime_target: int) -> int:\n        \"\"\"\n        Calculates the nth Newman-Shanks-Williams prime number\n        by generating sequence terms and testing for primality.\n        \"\"\"\n        prime_count = 0\n        nsw_generator = _generate_nsw_sequence()\n\n        for term in nsw_generator:\n            if term == 1: # S_0 = 1 is not a prime number.\n                continue\n            if is_prime(term):\n                prime_count += 1\n                if prime_count == n_prime_target:\n                    return term\n\n        # This part should theoretically not be reached if n_prime_target is a positive integer,\n        # as the NSW sequence grows and prime numbers are infinite.\n        return -1 # Fallback, though an unreachable state for valid inputs\n\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the nth Newman\u2013Shanks\u2013Williams prime number.\n    This implementation uses the recurrence S_n = 3*S_{n-1} - S_{n-2}\n    with S_0 = 1 and S_1 = 3, as specified in the design context.\n    \"\"\"\n    calculator = NewmanShanksWilliamsPrimeCalculator()\n    return calculator.calculate(n)"}
