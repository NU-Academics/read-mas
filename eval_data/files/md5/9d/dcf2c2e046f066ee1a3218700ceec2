{"task_id": "Mbpp/751", "solution": "def check_min_heap(array: list[int]) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    A min-heap satisfies the property that every parent node is less than or equal to its children.\n    \"\"\"\n    n = len(array)\n\n    if n == 0:\n        raise ValueError(\"Array cannot be empty for heap validation.\")\n\n    # Iterate over each node and check the min-heap property against its children.\n    for i in range(n):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n and array[i] > array[left_child_idx]:\n            return False\n\n        # Check right child\n        if right_child_idx < n and array[i] > array[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"Calculates the nth Jacobsthal number using an iterative approach.\n    The sequence is defined by J(0)=0, J(1)=1, and J(n) = J(n-1) + 2*J(n-2) for n >= 2.\"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    # Initialize for J(0) and J(1)\n    j_n_minus_2 = 0  # Represents J(k-2)\n    j_n_minus_1 = 1  # Represents J(k-1)\n    current_j = 0\n\n    # Iterate from 2 up to n to compute the desired Jacobsthal number\n    for _ in range(2, n + 1):\n        current_j = j_n_minus_1 + 2 * j_n_minus_2\n        j_n_minus_2 = j_n_minus_1\n        j_n_minus_1 = current_j\n\n    return current_j"}
{"task_id": "Mbpp/753", "solution": "from dataclasses import dataclass\n\ndef min_k(records, k):\n    \"\"\"\n    Finds the minimum k records from a list of tuples based on their second element.\n    This function delegates the core logic to an inline `MinKService` class.\n    \"\"\"\n\n    @dataclass(order=True)\n    class Record:\n        value: int\n        name: str\n\n        def to_tuple(self):\n            return (self.name, self.value)\n\n    class MinKService:\n        def min_k_implementation(self, records_data, k_val):\n            # Convert input tuples to internal Record objects for easier sorting.\n            record_objects = [Record(value=t[1], name=t[0]) for t in records_data]\n            record_objects.sort() # Sorts based on 'value' field first due to dataclass order=True.\n            \n            # Extract the top k records and convert them back to the original tuple format.\n            result_records = record_objects[:k_val]\n            return [rec.to_tuple() for rec in result_records]\n\n    service = MinKService()\n    return service.min_k_implementation(records, k)"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds elements that are common across three lists at the same index.\n    Compares elements up to the length of the shortest list and returns a new list of matches.\n    \"\"\"\n    result = []\n    min_len = min(len(l1), len(l2), len(l3))\n    for i in range(min_len):\n        if l1[i] == l2[i] == l3[i]:\n            result.append(l1[i])\n    return result"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(numbers):\n    \"\"\"\n    Finds the second smallest distinct number in a list.\n    Assumes the list contains at least two distinct values.\n    \"\"\"\n    first_min = float('inf')\n    second_min = float('inf')\n\n    for n in numbers:\n        if n < first_min:\n            second_min = first_min\n            first_min = n\n        elif n < second_min and n != first_min:\n            second_min = n\n            \n    return second_min"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(string_list: list) -> int:\n    \"\"\"Counts unique pairs of strings where one is the reverse of the other.\n    Palindromes are not counted as pairs with themselves.\"\"\"\n    count = 0\n    # Use a set for efficient O(1) average time complexity lookups and removals.\n    unprocessed_strings = set(string_list)\n\n    for s in string_list:\n        if s in unprocessed_strings:\n            s_reversed = s[::-1]\n            # Check if the reverse exists and is different from the original string.\n            if s_reversed in unprocessed_strings and s != s_reversed:\n                count += 1\n                unprocessed_strings.remove(s)\n                unprocessed_strings.remove(s_reversed)\n    return count"}
