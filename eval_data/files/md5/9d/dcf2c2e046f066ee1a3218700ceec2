{"task_id": "Mbpp/294", "solution": "from typing import List, Any, Optional, Union\n\ndef max_val(input_list: List[Any]) -> Optional[Union[int, float]]:\n    \"\"\"\n    Finds the maximum numeric value in a heterogeneous list, ignoring non-numeric elements.\n    Returns None for an empty list, and raises ValueError if no numeric values are present.\n    \"\"\"\n    numeric_values = [x for x in input_list if isinstance(x, (int, float))]\n\n    if not numeric_values:\n        if not input_list:\n            return None\n        else:\n            raise ValueError(\"No numeric values found in the list.\")\n    \n    return max(numeric_values)"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr):\n    \"\"\"\n    Counts inversions in an array using a merge-sort based approach.\n    An inversion is a pair (i, j) such that i < j and arr[i] > arr[j].\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return 0\n\n    # A temporary array for merging during the sort process.\n    temp_arr = [0] * n\n\n    def _merge_sort(arr_list, temp_list, left, right):\n        \"\"\"Recursively sorts the array segment and counts inversions.\"\"\"\n        inv_count = 0\n        if left < right:\n            mid = (left + right) // 2\n            inv_count += _merge_sort(arr_list, temp_list, left, mid)\n            inv_count += _merge_sort(arr_list, temp_list, mid + 1, right)\n            inv_count += _merge(arr_list, temp_list, left, mid, right)\n        return inv_count\n\n    def _merge(arr_list, temp_list, left, mid, right):\n        \"\"\"Merges two sorted subarrays and counts inversions spanning across them.\"\"\"\n        i = left\n        j = mid + 1\n        k = left\n        inv_count = 0\n\n        while i <= mid and j <= right:\n            if arr_list[i] <= arr_list[j]:\n                temp_list[k] = arr_list[i]\n                i += 1\n            else:\n                # If arr_list[i] > arr_list[j], all remaining elements in the\n                # left subarray (from i to mid) form an inversion with arr_list[j].\n                temp_list[k] = arr_list[j]\n                inv_count += (mid - i + 1)\n                j += 1\n            k += 1\n\n        while i <= mid:\n            temp_list[k] = arr_list[i]\n            k += 1\n            i += 1\n\n        while j <= right:\n            temp_list[k] = arr_list[j]\n            k += 1\n            j += 1\n\n        # Copy the merged elements back to the original array segment.\n        for x in range(left, right + 1):\n            arr_list[x] = temp_list[x]\n        return inv_count\n\n    return _merge_sort(arr, temp_arr, 0, n - 1)"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(input_list):\n    \"\"\"Recursively flattens an arbitrarily nested list of atomic values.\n    Returns a new list with all atomic values in the original order.\n    \"\"\"\n    result = []\n\n    def _flatten(sublist):\n        for item in sublist:\n            if isinstance(item, list):\n                _flatten(item)\n            else:\n                result.append(item)\n\n    _flatten(input_list)\n    return result"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(input_list):\n    \"\"\"Calculates the maximum aggregate score from a list of (name, score) tuples.\n    It sums scores for each name and returns the name with the highest total score.\"\"\"\n    if not input_list:\n        return None\n\n    aggregated_scores = {}\n    for name, score in input_list:\n        aggregated_scores[name] = aggregated_scores.get(name, 0) + score\n\n    max_name = None\n    max_total_score = -1\n\n    for name, total_score in aggregated_scores.items():\n        if total_score > max_total_score:\n            max_total_score = total_score\n            max_name = name\n\n    return (max_name, max_total_score)"}
{"task_id": "Mbpp/300", "solution": "import math\n\ndef count_binary_seq(n: int) -> int:\n    \"\"\"\n    Calculates the count of binary sequences of length 2n where the sum of the first n bits\n    is the same as the sum of the last n bits, using the combinatorial formula \u03a3(C(n,k))\u00b2.\n    \"\"\"\n    total_count = 0\n    for k in range(n + 1):\n        combinations_nk = math.comb(n, k)\n        total_count += combinations_nk * combinations_nk\n    return total_count"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(dictionary):\n    \"\"\"\n    Computes the depth of a nested dictionary.\n    An empty dictionary has depth 1, and each nested dictionary adds to the depth.\n    \"\"\"\n    max_depth = 0\n    stack = [(dictionary, 1)]\n\n    while stack:\n        current, depth = stack.pop()\n        max_depth = max(max_depth, depth)\n        for value in current.values():\n            if isinstance(value, dict):\n                stack.append((value, depth + 1))\n\n    return max_depth"}
