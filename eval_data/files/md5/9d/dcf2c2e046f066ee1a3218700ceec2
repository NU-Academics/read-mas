{"task_id": "Mbpp/440", "solution": "import string\n\n# This set would typically be imported from src/adverb_list.py\n# For self-containment in this completion, it is defined inline.\nADVERB_SET = {\n    \"clearly\", \"quickly\", \"slowly\", \"happily\", \"sadly\", \"loudly\", \"softly\",\n    \"always\", \"never\", \"often\", \"sometimes\", \"rarely\", \"usually\", \"seldom\",\n    \"very\", \"quite\", \"really\", \"extremely\", \"almost\", \"just\", \"hardly\", \"rather\",\n    \"early\", \"late\", \"here\", \"there\", \"everywhere\", \"nowhere\", \"somewhere\",\n    \"today\", \"yesterday\", \"tomorrow\", \"tonight\", \"soon\", \"then\", \"ago\",\n    \"well\", \"badly\", \"fast\", \"hard\", \"far\", \"near\", \"however\", \"therefore\",\n    \"meanwhile\", \"consequently\", \"furthermore\", \"thus\", \"moreover\", \"otherwise\",\n    \"actually\", \"possibly\", \"probably\", \"certainly\", \"definitely\", \"really\"\n}\n\ndef find_adverb_position(sentence: str):\n    \"\"\"\n    Finds the first adverb in a given sentence and returns its position and the word.\n    The function identifies adverbs based on a predefined list, handling punctuation.\n    \"\"\"\n    idx = 0\n    while idx < len(sentence):\n        # Skip leading whitespace to find the start of the next token\n        while idx < len(sentence) and sentence[idx].isspace():\n            idx += 1\n\n        if idx >= len(sentence):\n            break # Reached end of sentence\n\n        word_start_in_sentence = idx\n        \n        # Find the end of the current token (until next space or end of string)\n        while idx < len(sentence) and not sentence[idx].isspace():\n            idx += 1\n        word_end_in_sentence = idx\n\n        token = sentence[word_start_in_sentence:word_end_in_sentence]\n        \n        # Determine the effective start and end of the word within the token,\n        # ignoring leading/trailing punctuation as per BR1, BR2, BR3.\n        effective_start_in_token = 0\n        while effective_start_in_token < len(token) and token[effective_start_in_token] in string.punctuation:\n            effective_start_in_token += 1\n\n        effective_end_in_token = len(token)\n        while effective_end_in_token > effective_start_in_token and token[effective_end_in_token - 1] in string.punctuation:\n            effective_end_in_token -= 1\n\n        # Extract the cleaned word for lookup, converted to lowercase for case-insensitivity.\n        cleaned_word = token[effective_start_in_token:effective_end_in_token].lower()\n\n        # Check if the cleaned word is in our predefined set of adverbs\n        if cleaned_word in ADVERB_SET:\n            # Calculate the absolute start and end indices in the original sentence\n            absolute_start = word_start_in_sentence + effective_start_in_token\n            absolute_end = word_start_in_sentence + effective_end_in_token\n            return (absolute_start, absolute_end, cleaned_word)\n            \n    return None # Return None if no adverb is found, as per BR4"}
