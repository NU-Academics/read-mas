{"task_id": "Mbpp/777", "solution": "def find_sum(numbers):\n    \"\"\"\n    Finds the sum of elements that appear exactly once in the input list.\n    Uses a frequency map to count occurrences, then sums elements with a count of 1.\n    \"\"\"\n    counts = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    total_sum = 0\n    for num, count in counts.items():\n        if count == 1:\n            total_sum += num\n\n    return total_sum"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(elements):\n    \"\"\"\n    Packs consecutive duplicate elements of a list into sublists.\n    \"\"\"\n    if not elements:\n        return []\n\n    packed_list = []\n    current_group = [elements[0]]\n\n    for i in range(1, len(elements)):\n        if elements[i] == current_group[-1]:\n            current_group.append(elements[i])\n        else:\n            packed_list.append(current_group)\n            current_group = [elements[i]]\n\n    packed_list.append(current_group) # Append the last group\n\n    return packed_list"}
{"task_id": "Mbpp/780", "solution": "from typing import List, Tuple\n\ndef find_combinations(tuples: List[Tuple[int, int]]) -> List[Tuple[int, int]]:\n    \"\"\"\n    Compute element\u2011wise sums of all unique pairs of two\u2011element integer tuples.\n    Returns a list of summed tuples in the order of input pairs.\n    \"\"\"\n    n = len(tuples)\n    if n < 2:\n        return []\n\n    result: List[Tuple[int, int]] = []\n    for i in range(n - 1):\n        a1, a2 = tuples[i]\n        for j in range(i + 1, n):\n            b1, b2 = tuples[j]\n            result.append((a1 + b1, a2 + b2))\n    return result"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks if the count of positive divisors for a given integer n is an even number.\n    The algorithm iterates up to the square root of |n| to find divisor pairs.\n    \"\"\"\n    divisors = set()\n    limit = int(abs(n) ** 0.5)\n\n    # Handle n=0 case explicitly if needed, but the loop yields True (0 divisors)\n    # For n=0, limit is 0, range is empty, len(divisors) is 0, 0 % 2 == 0 is True.\n    # For n=1, divisors={1}, len=1, False.\n    # For n=-1, divisors={1, -1}, len=2, True.\n    \n    for i in range(1, limit + 1):\n        if n % i == 0:\n            divisors.add(i)\n            # Add the corresponding quotient; n // i will be negative if n is negative\n            # This counts divisors including negative ones if n is negative.\n            divisors.add(n // i) \n    \n    # A number has an odd number of positive divisors if and only if it is a perfect square.\n    # For general integers (positive/negative), the interpretation of \"divisors\" can vary.\n    # Following the pseudocode, `n // i` is used directly.\n    return len(divisors) % 2 == 0"}
{"task_id": "Mbpp/782", "solution": "```python\nfrom typing import List\n\ndef odd_length_sum(nums: List[int]) -> int:\n    \"\"\"\n    Compute the sum of all contiguous subarrays of odd length.\n    \"\"\"\n    total = 0\n    n = len(nums)\n    for start in range(n):\n        for end in range(start, n):\n            length = end - start + 1\n            if length % 2 == 1:\n                total += sum(nums[start:end + 1])\n    return total\n```"}
{"task_id": "Mbpp/784", "solution": "from typing import List, Optional\n\ndef mul_even_odd(numbers: List[int]) -> Optional[int]:\n    \"\"\"\n    Return the product of the first even and first odd integers in `numbers`.\n    If either an even or an odd number is missing, return None.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is None or first_odd is None:\n        return None\n    return first_even * first_odd"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(value: str) -> tuple[int, ...]:\n    \"\"\"\n    Convert a string representation of a tuple of integers into a tuple of integers.\n    \"\"\"\n    inner = value.strip()[1:-1].strip()\n\n    if not inner:\n        return tuple()\n\n    parts = [part.strip() for part in inner.split(',')]\n    ints = []\n    for part in parts:\n        ints.append(int(part))\n\n    return tuple(ints)"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(sorted_list, value):\n    \"\"\"\n    Locates the right insertion point for a specified value in a sorted list.\n    This function performs a binary search to find the index where the value\n    should be inserted to maintain sorted order, placing it after any existing\n    elements equal to the value.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] <= value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
