{"task_id": "Mbpp/285", "solution": "def text_match_two_three(text):\n    \"\"\"\n    Checks if a string contains the character 'a' followed by two or three 'b' characters.\n    Returns True if a match is found, False otherwise.\n    \"\"\"\n    if text is None:\n        return False\n\n    n = len(text)\n    for i in range(n):\n        if text[i] == 'a':\n            # Check for 'abb' pattern\n            if i + 2 < n and text[i+1] == 'b' and text[i+2] == 'b':\n                return True # Found 'abb' (which also covers 'abbb')\n    return False"}
{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non\u2011negative\")\n\n    class EvenNumberSequence:\n        def __init__(self, count: int):\n            self.start = 2\n            self.step = 2\n            self.count = count\n\n        def generate(self) -> list[int]:\n            return [self.start + i * self.step for i in range(self.count)]\n\n    class SumCalculator:\n        @staticmethod\n        def computeSum(numbers: list[int]) -> int:\n            return sum(numbers)\n\n    seq = EvenNumberSequence(n)\n    evens = seq.generate()\n    squares = [x * x for x in evens]\n    return SumCalculator.computeSum(squares)"}
{"task_id": "Mbpp/290", "solution": "def max_length(list_of_lists):\n    \"\"\"\n    Finds the maximum length among sub-lists and returns a tuple of (max_length, first_sub_list_of_that_length).\n    Returns (0, []) if the input list of lists is empty.\n    \"\"\"\n    max_len = 0\n    first_max_list = []\n\n    for sublist in list_of_lists:\n        if len(sublist) > max_len:\n            max_len = len(sublist)\n            first_max_list = sublist\n\n    return max_len, first_max_list"}
{"task_id": "Mbpp/286", "solution": "def max_sub_array_sum_repeated(arr, k):\n    \"\"\"\n    Finds the largest sum of a contiguous array in the modified array\n    formed by repeating the given array k times.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n\n    # Kadane's algorithm for a single array\n    max_so_far = -float('inf')\n    current_max = 0\n    for x in arr:\n        current_max += x\n        if current_max > max_so_far:\n            max_so_far = current_max\n        if current_max < 0:\n            current_max = 0\n\n    # If all numbers are negative, the max_so_far will be the largest negative number\n    # This also handles cases where current_max resets to 0 but max_so_far remains negative\n    if max_so_far == 0 and any(x < 0 for x in arr) and not any(x > 0 for x in arr):\n        max_so_far = max(arr)\n\n    total_sum = sum(arr)\n\n    # Calculate max prefix sum\n    max_prefix_sum = 0\n    current_prefix_sum = 0\n    for x in arr:\n        current_prefix_sum += x\n        if current_prefix_sum > max_prefix_sum:\n            max_prefix_sum = current_prefix_sum\n\n    # Calculate max suffix sum\n    max_suffix_sum = 0\n    current_suffix_sum = 0\n    for i in range(n - 1, -1, -1):\n        current_suffix_sum += arr[i]\n        if current_suffix_sum > max_suffix_sum:\n            max_suffix_sum = current_suffix_sum\n\n    if k == 1:\n        return max_so_far\n    elif total_sum < 0:\n        # If total sum is negative, the optimal subarray will span at most two repetitions\n        # (or just one if max_so_far is greater)\n        return max(max_so_far, max_prefix_sum + max_suffix_sum)\n    else:\n        # If total sum is positive, and k > 1, the optimal subarray could\n        # span multiple repetitions including the full sums of middle repetitions.\n        return max(max_so_far, max_prefix_sum + max_suffix_sum + (k - 2) * total_sum)"}
