{"task_id": "Mbpp/161", "solution": "from typing import List, TypeVar, Set\n\nT = TypeVar('T')\n\ndef remove_elements(source: List[T], removal: List[T]) -> List[T]:\n    \"\"\"\n    Removes all elements from the source list that are present in the removal list.\n    Preserves the relative order of elements from the source list.\n    \"\"\"\n    removal_set: Set[T] = set(removal)\n    result: List[T] = []\n    for item in source:\n        if item not in removal_set:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/160", "solution": "import math\nfrom typing import Optional, Tuple\n\ndef find_solution(a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple, or None if no solution exists.\n    Uses the extended Euclidean algorithm to find a particular solution.\n    \"\"\"\n\n    # Helper function for extended Euclidean algorithm.\n    # Returns (gcd, x, y) such that num1*x + num2*y = gcd(num1, num2).\n    # Assumes num1, num2 are non-negative.\n    def _extended_gcd(num1: int, num2: int) -> Tuple[int, int, int]:\n        if num1 == 0:\n            return num2, 0, 1\n        gcd, x1, y1 = _extended_gcd(num2 % num1, num1)\n        x = y1 - (num2 // num1) * x1\n        y = x1\n        return gcd, x, y\n\n    # Handle edge cases where a or b is zero.\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n    if a == 0:\n        if n % b == 0:\n            return (0, n // b)\n        else:\n            return None\n    if b == 0:\n        if n % a == 0:\n            return (n // a, 0)\n        else:\n            return None\n\n    # General case: a and b are non-zero.\n    # Calculate the greatest common divisor using math.gcd which handles signs.\n    common_divisor = math.gcd(a, b)\n\n    # If n is not divisible by the gcd, no integer solution exists.\n    if n % common_divisor != 0:\n        return None\n\n    # Use _extended_gcd with absolute values to get x_prime, y_prime for |a|*x_prime + |b|*y_prime = common_divisor.\n    gcd_val, x_prime, y_prime = _extended_gcd(abs(a), abs(b))\n\n    # Adjust x_prime and y_prime to be coefficients for the original a and b (which could be negative).\n    x0 = x_prime\n    y0 = y_prime\n    if a < 0:\n        x0 = -x_prime\n    if b < 0:\n        y0 = -y_prime\n\n    # Scale the particular solution (x0, y0) by k = n // common_divisor to solve ax + by = n.\n    k = n // common_divisor\n    x = x0 * k\n    y = y0 * k\n\n    return (x, y)"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum (n - 2*i) from i=0 to n // 2.\n    This corresponds to the series n + (n-2) + (n-4) ... until the term becomes non-positive.\n    \"\"\"\n    total_sum = 0\n    # The loop iterates from i=0 up to and including n // 2.\n    for i in range(n // 2 + 1):\n        total_sum += (n - 2 * i)\n    return total_sum"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input: str) -> int:\n    \"\"\"\n    Counts characters in the input string whose alphabetic position matches\n    their zero-based index (case-insensitive). Non-alphabetic characters are ignored.\n    \"\"\"\n    count = 0\n    for idx, ch in enumerate(input):\n        if ch.isalpha():\n            pos = ord(ch.lower()) - ord('a')\n            if pos == idx:\n                count += 1\n    return count"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Uses bitwise operations for efficiency.\n    \"\"\"\n    if n == 0:\n        return 1\n    n -= 1\n    n |= n >> 1\n    n |= n >> 2\n    n |= n >> 4\n    n |= n >> 8\n    n |= n >> 16\n    return n + 1"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(int_list):\n    \"\"\"\n    Counts pairs of integers in a list whose bitwise XOR result is even.\n    Iterates over all unordered distinct pairs and checks their XOR parity.\n    \"\"\"\n    count = 0\n    n = len(int_list)\n    for i in range(n):\n        for j in range(i + 1, n):  # Consider only unordered distinct pairs (i < j).\n            num1 = int_list[i]\n            num2 = int_list[j]\n            xor_result = num1 ^ num2\n            if xor_result % 2 == 0:  # XOR result is even if both numbers have the same parity.\n                count += 1\n    return count"}
