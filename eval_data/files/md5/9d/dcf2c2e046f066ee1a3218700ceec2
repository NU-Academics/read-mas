{"task_id": "Mbpp/141", "solution": "class Element:\n    \"\"\"Represents a single element, allowing for comparison operations.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def __lt__(self, other):\n        return self.value < other.value\n\n    def __le__(self, other):\n        return self.value <= other.value\n\n    def __gt__(self, other):\n        return self.value > other.value\n\n    def __ge__(self, other):\n        return self.value >= other.value\n\n    def __eq__(self, other):\n        return self.value == other.value\n\n    def __repr__(self):\n        return f\"Element({self.value})\"\n\n\nclass List:\n    \"\"\"A wrapper for a collection of Element objects, facilitating list-like access.\"\"\"\n    def __init__(self, items=None):\n        if items is None:\n            self.items = []\n        else:\n            self.items = [item if isinstance(item, Element) else Element(item) for item in items]\n\n    def __len__(self):\n        return len(self.items)\n\n    def __getitem__(self, index):\n        return self.items[index]\n\n    def __setitem__(self, index, value):\n        self.items[index] = value\n\n    def to_python_list(self):\n        \"\"\"Converts the internal list of Element objects to a standard Python list.\"\"\"\n        return [item.value for item in self.items]\n\n    def __repr__(self):\n        return f\"List({self.to_python_list()})\"\n\n\ndef pancake_sort(list):\n    \"\"\"\n    Sorts a list of elements using the pancake sort algorithm, returning a new sorted list.\n    The original input list remains unmodified.\n    \"\"\"\n    # Create an internal List object from the input Python list for sorting\n    internal_list_obj = List(list)\n    n = len(internal_list_obj)\n\n    # If the list is empty or has only one element, it's already sorted.\n    if n <= 1:\n        return internal_list_obj.to_python_list()\n\n    def _flip(arr_obj, k):\n        \"\"\"Reverses the sub-array from index 0 to k (inclusive) within the List object.\"\"\"\n        start = 0\n        while start < k:\n            arr_obj[start], arr_obj[k] = arr_obj[k], arr_obj[start]\n            start += 1\n            k -= 1\n\n    # Iterate from the end of the list down to the second element\n    for current_size in range(n, 1, -1):\n        # Find the index of the maximum element in the current unsorted portion\n        max_element_idx = 0\n        for i in range(1, current_size):\n            if internal_list_obj[i] > internal_list_obj[max_element_idx]:\n                max_element_idx = i\n\n        # If the maximum element is not already in its correct sorted position\n        if max_element_idx != current_size - 1:\n            # 1. Flip to bring the maximum element to the front (index 0)\n            _flip(internal_list_obj, max_element_idx)\n            # 2. Flip to move the maximum element to its correct position\n            _flip(internal_list_obj, current_size - 1)\n\n    # Convert the sorted internal List object back to a standard Python list of values\n    return internal_list_obj.to_python_list()"}
{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(n):\n    \"\"\"Checks if n can be represented as a sum of non-zero powers of 2.\"\"\"\n    if n <= 0:\n        return False\n    # A positive number can be represented as a sum of non-zero powers of 2\n    # if and only if its binary representation does not include 2^0 (i.e., it is even).\n    return (n & 1) == 0"}
