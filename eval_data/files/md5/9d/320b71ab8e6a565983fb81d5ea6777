{"task_id": "Mbpp/749", "solution": "```python\nclass NumericString:\n    \"\"\"Represents a numeric string and provides conversion to its numerical value.\"\"\"\n    def __init__(self, string_value: str):\n        self._string_value = string_value\n\n    def to_numeric_value(self) -> \"Union[int, float]\":\n        \"\"\"Converts the stored string to an integer or float.\"\"\"\n        numeric_val = float(self._string_value)\n        if numeric_val.is_integer():\n            return int(numeric_val)\n        return numeric_val\n\nclass NumericList:\n    \"\"\"Manages a list of numeric strings, converting and sorting them.\"\"\"\n    def __init__(self, input_list: \"List[str]\"):\n        self._input_string_values: \"List[NumericString]\" = []\n        for s_val in input_list:\n            self._input_string_values.append(NumericString(s_val))\n        self._sorted_numeric_values: \"List[Union[int, float]]\" = []\n\n    def convert_and_sort(self) -> \"List[Union[int, float]]\":\n        \"\"\"Converts all stored strings to numbers, sorts them, and returns the result.\"\"\"\n        numerical_values: \"List[Union[int, float]]\" = []\n        for numeric_string_obj in self._input_string_values:\n            numerical_values.append(numeric_string_obj.to_numeric_value())\n        numerical_values.sort()\n        self._sorted_numeric_values = numerical_values\n        return self._sorted_numeric_values\n\ndef sort_numeric_strings(input_list: \"List[str]\") -> \"List[Union[int, float]]\":\n    \"\"\"\n    Sorts a given list of strings of numbers numerically.\n    It orchestrates the conversion and sorting process using internal classes.\n    \"\"\"\n    numeric_list_processor = NumericList(input_list)\n    return numeric_list_processor.convert_and_sort()\n```"}
{"task_id": "Mbpp/749", "solution": "```python\ndef sort_numeric_strings(list_of_strings: list[str]) -> list[int]:\n    \"\"\"Converts a list of numeric strings to integers and sorts them numerically in ascending order.\n    Relies on Python's built-in int() for conversion and sorted() for sorting.\"\"\"\n\n    # Convert each string to an integer, collecting them into a new list.\n    numbers = [int(s) for s in list_of_strings]\n\n    # Sort the list of integers numerically in ascending order and return it.\n    return sorted(numbers)\n```"}
{"task_id": "Mbpp/745", "solution": "```python\ndef _get_digits(number: int) -> list[int]:\n    \"\"\"\n    Extracts individual digits from a number.\n    Returns a list of integers representing the digits.\n    \"\"\"\n    if number == 0:\n        return [0]\n    digits = []\n    temp_num = abs(number)\n    while temp_num > 0:\n        digits.append(temp_num % 10)\n        temp_num //= 10\n    return digits[::-1]\n\ndef _is_divisible_by_its_digits(number: int) -> bool:\n    \"\"\"\n    Checks if a number is divisible by all its non-zero digits.\n    Returns True if divisible by all non-zero digits, False otherwise.\n    \"\"\"\n    digits = _get_digits(number)\n    for digit in digits:\n        if digit == 0:\n            continue\n        if number % digit != 0:\n            return False\n    return True\n\ndef divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a given range [startnum, endnum] (inclusive)\n    where every number is divisible by every non-zero digit it contains.\n    Returns a list of numbers satisfying the criteria.\n    \"\"\"\n    result = []\n    for number in range(startnum, endnum + 1):\n        if _is_divisible_by_its_digits(number):\n            result.append(number)\n    return result\n```"}
