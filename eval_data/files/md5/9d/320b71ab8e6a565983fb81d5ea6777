{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix: list[list[int]]) -> bool:\n    # Get the dimension of the square matrix.\n    n = len(matrix)\n\n    # Calculate the expected sum from the first row, assuming a valid square matrix.\n    expected_sum = sum(matrix[0])\n\n    # Check row sums.\n    for i in range(n):\n        if sum(matrix[i]) != expected_sum:\n            return False\n\n    # Check column sums.\n    for j in range(n):\n        current_col_sum = 0\n        for i in range(n):\n            current_col_sum += matrix[i][j]\n        if current_col_sum != expected_sum:\n            return False\n\n    # Check main diagonal sum (top-left to bottom-right).\n    main_diag_sum = 0\n    for i in range(n):\n        main_diag_sum += matrix[i][i]\n    if main_diag_sum != expected_sum:\n        return False\n\n    # Check anti-diagonal sum (top-right to bottom-left).\n    anti_diag_sum = 0\n    for i in range(n):\n        anti_diag_sum += matrix[i][n - 1 - i]\n    if anti_diag_sum != expected_sum:\n        return False\n\n    # If all checks pass, the matrix is a magic square.\n    return True"}
{"task_id": "Mbpp/130", "solution": "```python\ndef max_occurrences(input_list):\n    \"\"\"\n    Identifies and returns the item with the highest frequency from a given list.\n    Raises ValueError if the input list is empty.\n    \"\"\"\n    if not input_list:\n        raise ValueError(\"Input list cannot be empty\")\n\n    counts = {}\n    for item in input_list:\n        counts[item] = counts.get(item, 0) + 1\n\n    max_item = None\n    max_frequency = -1\n\n    for item, frequency in counts.items():\n        if frequency > max_frequency:\n            max_frequency = frequency\n            max_item = item\n\n    return max_item\n```"}
{"task_id": "Mbpp/130", "solution": "```python\ndef max_occurrences(list_items: list) -> any:\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    Returns None if the list is empty.\n    \"\"\"\n    if not list_items:\n        return None\n\n    item_counts = {}\n    for item in list_items:\n        item_counts[item] = item_counts.get(item, 0) + 1\n\n    max_count = -1\n    most_frequent_item = None\n    for item, count in item_counts.items():\n        if count > max_count:\n            max_count = count\n            most_frequent_item = item\n\n    return most_frequent_item\n```"}
{"task_id": "Mbpp/131", "solution": "def _is_vowel(char: str) -> bool:\n    \"\"\"\n    Determines if a given character is a vowel (a, e, i, o, u, case-insensitive, 'y' excluded).\n    Converts the character to lowercase and checks its presence in the set of vowels.\n    \"\"\"\n    return char.lower() in {'a', 'e', 'i', 'o', 'u'}\n\ndef reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels in an input string while preserving the positions of consonants.\n    It identifies vowels, reverses their order, and reconstructs the string.\n    \"\"\"\n    s_list = list(s)\n    vowels_found = []\n\n    for char in s_list:\n        if _is_vowel(char):\n            vowels_found.append(char)\n\n    vowels_found.reverse()\n\n    vowel_index = 0\n    for i in range(len(s_list)):\n        if _is_vowel(s_list[i]):\n            s_list[i] = vowels_found[vowel_index]\n            vowel_index += 1\n\n    return \"\".join(s_list)"}
{"task_id": "Mbpp/129", "solution": "```python\nfrom typing import List\n\ndef magic_square_test(matrix: List[List[int]]) -> bool:\n    \"\"\"\n    Checks if a given matrix is a magic square by verifying it's square,\n    calculating sums of rows, columns, and diagonals, and comparing them.\n    \"\"\"\n    n = len(matrix)\n\n    # A 0x0 matrix is trivially square and considered magic by this implementation's flow.\n    # For any other non-square matrix, return False as per design.\n    if n == 0:\n        # If matrix is empty list [], it's 0x0. Subsequent sum calculations\n        # will result in all sums being 0, and thus equal.\n        pass\n    else:\n        for row in matrix:\n            if len(row) != n:\n                return False  # Not a square matrix.\n\n    def _calculate_row_sums(elements: List[List[int]]) -> List[int]:\n        \"\"\"Calculates sums for each row of the matrix.\"\"\"\n        return [sum(row) for row in elements]\n\n    def _calculate_column_sums(elements: List[List[int]]) -> List[int]:\n        \"\"\"Calculates sums for each column of the matrix.\"\"\"\n        column_sums = [0] * n\n        for r_idx in range(n):\n            for c_idx in range(n):\n                column_sums[c_idx] += elements[r_idx][c_idx]\n        return column_sums\n\n    def _calculate_main_diagonal_sum(elements: List[List[int]]) -> int:\n        \"\"\"Calculates the sum of the main diagonal (top-left to bottom-right).\"\"\"\n        main_diag_sum = 0\n        for i in range(n):\n            main_diag_sum += elements[i][i]\n        return main_diag_sum\n\n    def _calculate_anti_diagonal_sum(elements: List[List[int]]) -> int:\n        \"\"\"Calculates the sum of the anti-diagonal (top-right to bottom-left).\"\"\"\n        anti_diag_sum = 0\n        for i in range(n):\n            anti_diag_sum += elements[i][n - 1 - i]\n        return anti_diag_sum\n\n    def _all_sums_equal(sums: List[int]) -> bool:\n        \"\"\"Compares a list of sums to check if they are all equal.\"\"\"\n        if not sums:\n            return True  # Trivially true if there are no sums to compare.\n        return all(s == sums[0] for s in sums)\n\n    # Calculate all required sums using the matrix elements.\n    row_sums = _calculate_row_sums(matrix)\n    column_sums = _calculate_column_sums(matrix)\n    main_diagonal_sum = _calculate_main_diagonal_sum(matrix)\n    anti_diagonal_sum = _calculate_anti_diagonal_sum(matrix)\n\n    # Aggregate all calculated sums into a single list for comparison.\n    all_calculated_sums = row_sums + column_sums + [main_diagonal_sum, anti_diagonal_sum]\n\n    # Determine if all aggregated sums are equal.\n    return _all_sums_equal(all_calculated_sums)\n```\n"}
