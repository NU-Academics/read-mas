{"task_id": "Mbpp/287", "solution": "```python\ndef square_Sum(n: int) -> int:\n    \"\"\"Calculates the sum of squares of the first n even natural numbers.\n    It iterates from 1 to n, computes the even number, squares it, and adds to a running total.\"\"\"\n    current_sum = 0\n    for i in range(1, n + 1):\n        even_number = 2 * i\n        squared_even = even_number * even_number\n        current_sum += squared_even\n    return current_sum\n```"}
{"task_id": "Mbpp/286", "solution": "```python\ndef _kadane_algorithm(arr: list[int | float]) -> int | float:\n    \"\"\"\n    Applies Kadane's algorithm to find the maximum subarray sum in a single array.\n    Returns 0 for an empty array, otherwise the maximum sum including negative values.\n    \"\"\"\n    if not arr:\n        return 0\n\n    max_so_far = arr[0]\n    current_max = arr[0]\n    for i in range(1, len(arr)):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n    return max_so_far\n\ndef _calculate_max_prefix_sum(arr: list[int | float]) -> int | float:\n    \"\"\"\n    Calculates the maximum sum of any prefix of the array.\n    Returns 0 for an empty array.\n    \"\"\"\n    if not arr:\n        return 0\n\n    max_prefix_sum = arr[0]\n    current_sum = arr[0]\n    for i in range(1, len(arr)):\n        current_sum += arr[i]\n        max_prefix_sum = max(max_prefix_sum, current_sum)\n    return max_prefix_sum\n\ndef _calculate_max_suffix_sum(arr: list[int | float]) -> int | float:\n    \"\"\"\n    Calculates the maximum sum of any suffix of the array.\n    Returns 0 for an empty array.\n    \"\"\"\n    if not arr:\n        return 0\n\n    max_suffix_sum = arr[-1]\n    current_sum = arr[-1]\n    for i in range(len(arr) - 2, -1, -1):\n        current_sum += arr[i]\n        max_suffix_sum = max(max_suffix_sum, current_sum)\n    return max_suffix_sum\n\ndef _calculate_total_sum(arr: list[int | float]) -> int | float:\n    \"\"\"\n    Calculates the total sum of all elements in the array.\n    Returns 0 for an empty array.\n    \"\"\"\n    return sum(arr)\n\ndef max_sub_array_sum_repeated(arr: list[int | float], n: int, k: int) -> int | float:\n    \"\"\"\n    Calculates the largest sum of a contiguous subarray in a modified array\n    formed by repeating the input array 'k' times.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    max_sum_single_pass = _kadane_algorithm(arr)\n\n    if k == 1:\n        return max_sum_single_pass\n\n    max_prefix = _calculate_max_prefix_sum(arr)\n    max_suffix = _calculate_max_suffix_sum(arr)\n    total_sum = _calculate_total_sum(arr)\n\n    # Max sum could be within a single repetition, or span two, or span multiple with positive total sum.\n    overall_max = max_sum_single_pass\n    overall_max = max(overall_max, max_suffix + max_prefix)\n\n    if total_sum > 0 and k > 2:\n        # If total sum is positive, repeating the entire array (k-2) times in the middle can increase the sum.\n        overall_max = max(overall_max, max_suffix + (k - 2) * total_sum + max_prefix)\n\n    return overall_max\n```"}
{"task_id": "Mbpp/286", "solution": "```python\ndef max_sub_array_sum_repeated(arr: list[int], n: int, k: int) -> int:\n    \"\"\"\n    Calculates the largest sum of a contiguous subarray in an array formed by repeating arr k times.\n    \"\"\"\n\n    def _kadane(arr_local: list[int]) -> int:\n        \"\"\"\n        Implements Kadane's algorithm to find the maximum sum of a contiguous subarray.\n        \"\"\"\n        if not arr_local:\n            return 0\n        max_so_far = arr_local[0]\n        current_max = arr_local[0]\n        for i in range(1, len(arr_local)):\n            current_max = max(arr_local[i], current_max + arr_local[i])\n            max_so_far = max(max_so_far, current_max)\n        return max_so_far\n\n    def _total_sum(arr_local: list[int]) -> int:\n        \"\"\"\n        Calculates the sum of all elements in the array.\n        \"\"\"\n        return sum(arr_local)\n\n    def _max_prefix_sum(arr_local: list[int]) -> int:\n        \"\"\"\n        Calculates the maximum sum of any prefix subarray.\n        \"\"\"\n        if not arr_local:\n            return 0\n        max_prefix = float('-inf')\n        current_sum = 0\n        for x in arr_local:\n            current_sum += x\n            max_prefix = max(max_prefix, current_sum)\n        return max_prefix\n\n    def _max_suffix_sum(arr_local: list[int]) -> int:\n        \"\"\"\n        Calculates the maximum sum of any suffix subarray.\n        \"\"\"\n        if not arr_local:\n            return 0\n        max_suffix = float('-inf')\n        current_sum = 0\n        for i in range(len(arr_local) - 1, -1, -1):\n            current_sum += arr_local[i]\n            max_suffix = max(max_suffix, current_sum)\n        return max_suffix\n\n    if k == 0:\n        return 0\n\n    if k == 1:\n        return _kadane(arr)\n\n    # For k > 1\n    # Calculate max sum for two concatenations (arr + arr) to cover boundary cases.\n    max_sum_two_arrays = _kadane(arr + arr)\n\n    total_sum_single_array = _total_sum(arr)\n    max_prefix = _max_prefix_sum(arr)\n    max_suffix = _max_suffix_sum(arr)\n\n    if total_sum_single_array > 0:\n        # If the total sum of 'arr' is positive, additional repetitions can increase the total sum.\n        # The maximum sum could span across: (suffix of first arr) + (k-2)*total_sum + (prefix of last arr).\n        max_sum_with_middle = max_suffix + (k - 2) * total_sum_single_array + max_prefix\n        return max(max_sum_two_arrays, max_sum_with_middle)\n    else:\n        # If the total sum of 'arr' is non-positive, repeating more than twice won't yield a larger sum\n        # than what can be found within the first two repetitions.\n        return max_sum_two_arrays\n```"}
{"task_id": "Mbpp/290", "solution": "```python\ndef max_length(list_of_lists: list) -> tuple[int, list]:\n    \"\"\"\n    Finds the sub-list with the maximum length in a list of lists.\n\n    Args:\n        list_of_lists: A list where each element is expected to be a list.\n\n    Returns:\n        A tuple containing:\n        - The maximum length found (int).\n        - The first sub-list encountered with that maximum length (list).\n        Returns (0, []) if the input list_of_lists is empty.\n    \"\"\"\n    if not list_of_lists:\n        return (0, [])\n\n    max_len = 0\n    longest_list = []\n\n    for sub_list in list_of_lists:\n        current_len = len(sub_list)\n        if current_len > max_len:\n            max_len = current_len\n            longest_list = sub_list\n\n    return (max_len, longest_list)\n```"}
