{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list: list, sub_list: list) -> bool:\n    \"\"\"\n    Checks if `sub_list` is a contiguous sublist of `main_list`.\n    Returns `True` if `sub_list` is found, `False` otherwise.\n    \"\"\"\n    # An empty list is considered a sublist of any list.\n    if not sub_list:\n        return True\n    # If sub_list is longer than main_list, it cannot be a sublist.\n    if len(sub_list) > len(main_list):\n        return False\n\n    # Iterate through main_list to find a matching slice.\n    for i in range(len(main_list) - len(sub_list) + 1):\n        if main_list[i : i + len(sub_list)] == sub_list:\n            return True\n    return False"}
{"task_id": "Mbpp/573", "solution": "```python\ndef unique_product(numbers: list) -> float:\n    \"\"\"\n    Calculates the product of the unique numbers in a list.\n    Returns 1 for empty lists and 0 if unique numbers include 0.\n    \"\"\"\n    if not numbers:\n        return 1.0\n\n    unique_nums = set(numbers)\n\n    if 0 in unique_nums:\n        return 0.0\n\n    product = 1.0\n    for num in unique_nums:\n        product *= num\n\n    return product\n```"}
{"task_id": "Mbpp/577", "solution": "```python\ndef last_Digit_Factorial(n: int) -> int:\n    \"\"\"Calculates the last digit of n!.\n    Handles specific cases for small n and returns 0 for n >= 5.\"\"\"\n    if n == 0:\n        return 1\n    elif n == 1:\n        return 1\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 6\n    elif n == 4:\n        return 4\n    else:  # For n >= 5, the last digit of n! is always 0\n        return 0\n```"}
{"task_id": "Mbpp/576", "solution": "```python\ndef is_Sub_Array(list1: list, list2: list) -> bool:\n    \"\"\"\n    Determines if list1 is a sublist of list2.\n    Returns True if list1 is found within list2, False otherwise.\n    \"\"\"\n    if not list1:\n        return True  # An empty list is always considered a sublist.\n    if len(list1) > len(list2):\n        return False # A longer list cannot be a sublist of a shorter list.\n\n    for i in range(len(list2) - len(list1) + 1):\n        if list2[i : i + len(list1)] == list1:\n            return True\n\n    return False\n```"}
