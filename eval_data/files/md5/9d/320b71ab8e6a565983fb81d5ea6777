{"task_id": "Mbpp/160", "solution": "# diophantine_solver/__init__.py\nfrom .solver import find_solution\n\n__all__ = ['find_solution']\n\n# diophantine_solver/solver.py\ndef _gcd(a: int, b: int) -> int:\n    \"\"\"Computes the greatest common divisor of two integers using the Euclidean algorithm.\"\"\"\n    while b:\n        a, b = b, a % b\n    return a\n\ndef _extended_gcd(a: int, b: int) -> tuple[int, int, int]:\n    \"\"\"Implements the Extended Euclidean Algorithm to find g, x, y such that ax + by = g.\"\"\"\n    if a == 0:\n        return b, 0, 1\n    g, x1, y1 = _extended_gcd(b % a, a)\n    x = y1 - (b // a) * x1\n    y = x1\n    return g, x, y\n\ndef find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Finds integer solutions (x, y) for the linear Diophantine equation ax + by = n.\n    Returns a tuple (x, y) if a solution exists, otherwise returns None.\n    \"\"\"\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n    elif a == 0:\n        return (0, n // b) if n % b == 0 else None\n    elif b == 0:\n        return (n // a, 0) if n % a == 0 else None\n\n    g = _gcd(abs(a), abs(b))\n\n    if n % g != 0:\n        return None\n\n    a_prime = a // g\n    b_prime = b // g\n    n_prime = n // g\n\n    _, x_g, y_g = _extended_gcd(a_prime, b_prime)\n\n    x0 = x_g * n_prime\n    y0 = y_g * n_prime\n\n    return (x0, y0)"}
