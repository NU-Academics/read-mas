{"task_id": "Mbpp/721", "solution": "from typing import List\n\nclass Cell:\n    \"\"\"Represents a single cell in the matrix with its coordinates and cost.\"\"\"\n    def __init__(self, row: int, col: int, cost: int):\n        self.row = row\n        self.col = col\n        self.cost = cost\n\nclass Path:\n    \"\"\"Represents a sequence of cells forming a valid path.\"\"\"\n    def __init__(self, sequence: List[Cell]):\n        self.sequence = sequence\n        self.totalCost = sum(cell.cost for cell in sequence)\n        self.numberOfCells = len(sequence)\n\n    def averageCost(self) -> float:\n        \"\"\"Calculates the average cost of the path.\"\"\"\n        return self.totalCost / self.numberOfCells\n\nclass Matrix:\n    \"\"\"Encapsulates the square matrix of cells.\"\"\"\n    def __init__(self, matrix_data: List[List[int]]):\n        self.N = len(matrix_data)\n        self.cells: List[List[Cell]] = []\n        for r in range(self.N):\n            row_cells = []\n            for c in range(self.N):\n                row_cells.append(Cell(r, c, matrix_data[r][c]))\n            self.cells.append(row_cells)\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        \"\"\"Retrieves a cell at the specified row and column.\"\"\"\n        return self.cells[row][col]\n\nclass MaxAveragePathCalculator:\n    \"\"\"Calculates the maximum average cost among all valid paths in a matrix.\"\"\"\n    def calculate_max_average_path(self, matrix_data: List[List[int]]) -> float:\n        \"\"\"Finds all valid paths and returns the maximum average cost.\"\"\"\n        matrix = Matrix(matrix_data)\n        all_paths = self._find_all_paths(matrix)\n\n        max_average = 0.0\n        for path in all_paths:\n            max_average = max(max_average, path.averageCost())\n        return max_average\n\n    def _find_all_paths(self, matrix: Matrix) -> List[Path]:\n        \"\"\"Initiates the recursive path finding process.\"\"\"\n        all_paths: List[Path] = []\n        self._find_paths_recursive(matrix, 0, 0, [], all_paths)\n        return all_paths\n\n    def _find_paths_recursive(self, matrix: Matrix, r: int, c: int, current_path_cells: List[Cell], all_paths: List[Path]):\n        \"\"\"Recursively explores paths from (r, c) to the bottom-right cell.\"\"\"\n        current_cell = matrix.get_cell(r, c)\n        current_path_cells.append(current_cell)\n\n        if r == matrix.N - 1 and c == matrix.N - 1:\n            all_paths.append(Path(list(current_path_cells)))\n        else:\n            # Move right\n            if c + 1 < matrix.N:\n                self._find_paths_recursive(matrix, r, c + 1, current_path_cells, all_paths)\n            # Move down\n            if r + 1 < matrix.N:\n                self._find_paths_recursive(matrix, r + 1, c, current_path_cells, all_paths)\n\n        current_path_cells.pop() # Backtrack\n\ndef maxAverageOfPath(matrix_data: List[List[int]]) -> float:\n    \"\"\"\n    Given a square matrix, finds the path from top-left to bottom-right\n    (moving only right or down) with the maximum average cost.\n    \"\"\"\n    calculator = MaxAveragePathCalculator()\n    return calculator.calculate_max_average_path(matrix_data)"}
{"task_id": "Mbpp/721", "solution": "```python\ndef maxAverageOfPath(matrix: list[list[int]]) -> float:\n    \"\"\"Calculates the maximum average cost of a path in a given square matrix.\n    Paths move only right or down from top-left to bottom-right.\"\"\"\n\n    def _validate_matrix(matrix_input: list[list[int]]) -> int:\n        \"\"\"Validates the input matrix, ensuring it's square and N >= 1, and returns its dimension N.\"\"\"\n        if not matrix_input or not isinstance(matrix_input, list):\n            raise ValueError(\"Matrix cannot be empty or invalid.\")\n        n = len(matrix_input)\n        if n == 0:\n            raise ValueError(\"Matrix dimension N must be at least 1.\")\n        for row in matrix_input:\n            if not isinstance(row, list) or len(row) != n:\n                raise ValueError(\"Matrix must be square.\")\n        return n\n\n    all_path_averages = []\n\n    def _find_all_paths_dfs(\n        current_matrix: list[list[int]],\n        row: int,\n        col: int,\n        current_sum: int,\n        current_len: int,\n        N_dim: int,\n        averages_list: list[float]\n    ) -> None:\n        \"\"\"Recursively explores all paths from (row, col) to (N-1, N-1) using DFS, calculating and storing path averages.\"\"\"\n        # Base case: Reached the bottom-right cell.\n        if row == N_dim - 1 and col == N_dim - 1:\n            averages_list.append(current_sum / current_len)\n            return\n\n        # Move Right: If not at the rightmost column.\n        if col + 1 < N_dim:\n            _find_all_paths_dfs(\n                current_matrix,\n                row,\n                col + 1,\n                current_sum + current_matrix[row][col + 1],\n                current_len + 1,\n                N_dim,\n                averages_list\n            )\n\n        # Move Down: If not at the bottommost row.\n        if row + 1 < N_dim:\n            _find_all_paths_dfs(\n                current_matrix,\n                row + 1,\n                col,\n                current_sum + current_matrix[row + 1][col],\n                current_len + 1,\n                N_dim,\n                averages_list\n            )\n\n    N = _validate_matrix(matrix)\n\n    # Start DFS from (0,0) with initial cell's cost and length 1.\n    _find_all_paths_dfs(matrix, 0, 0, matrix[0][0], 1, N, all_path_averages)\n\n    # Find the maximum average among all computed path averages.\n    return max(all_path_averages)\n```"}
{"task_id": "Mbpp/725", "solution": "```python\ndef extract_quotation(text):\n    \"\"\"\n    Extracts all substrings enclosed in double quotation marks from the given text.\n    It returns a list of these extracted strings.\n    \"\"\"\n    results = []\n    start_index = 0\n    while True:\n        first_quote_idx = text.find('\"', start_index)\n        if first_quote_idx == -1:\n            break\n\n        second_quote_idx = text.find('\"', first_quote_idx + 1)\n        if second_quote_idx == -1:\n            break\n\n        results.append(text[first_quote_idx + 1 : second_quote_idx])\n        start_index = second_quote_idx + 1\n    return results\n```"}
