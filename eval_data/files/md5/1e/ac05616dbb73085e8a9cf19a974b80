{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if n <= 0:\n        return 0\n    if n == 1:\n        return 1\n\n    # Initialize for F(1) and F(2)\n    a, b = 1, 1\n\n    # Calculate subsequent Fibonacci numbers iteratively\n    for _ in range(n - 2):\n        a, b = b, a + b\n\n    return b"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n        \n        # If balance ever drops below zero, a closing bracket appeared without a matching opening one.\n        if balance < 0:\n            return False\n            \n    # After iterating through the string, balance must be zero for correct bracketing.\n    return balance == 0"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    max_prime_factor = 1\n\n    # Handle factor 2\n    while n % 2 == 0:\n        max_prime_factor = 2\n        n //= 2\n\n    # Handle odd factors starting from 3 up to sqrt(n)\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            max_prime_factor = i\n            n //= i\n        i += 2\n\n    # If n is still greater than 1, it must be the largest prime factor\n    if n > 1:\n        max_prime_factor = n\n\n    return max_prime_factor"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n    common_elements = list(set1.intersection(set2))\n    common_elements.sort()\n    return common_elements"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    This checks if the list is either non-decreasing or non-increasing.\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    is_non_decreasing = True\n    is_non_increasing = True\n\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            is_non_decreasing = False\n        if l[i] < l[i+1]:\n            is_non_increasing = False\n        \n        # If neither condition holds, it's not monotonic\n        if not is_non_decreasing and not is_non_increasing:\n            return False\n\n    return True"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int):\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        # If balance drops below zero, a closing bracket appeared without a matching opening one.\n        if balance < 0:\n            return False\n    # If balance is zero at the end, all brackets are correctly matched.\n    return balance == 0"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\"\n    Calculates the coefficients of the derivative of a polynomial.\n    The polynomial is represented by its coefficients xs[0] + xs[1] * x + ...\n    \"\"\"\n    if not xs or len(xs) == 1:\n        return []\n\n    # The derivative of c*x^n is c*n*x^(n-1).\n    # The new coefficient for x^(i-1) comes from the original coefficient xs[i] * x^i.\n    # This new coefficient is xs[i] * i.\n    # The loop starts from i=1 because xs[0] (constant term) differentiates to 0.\n    # The resulting polynomial will have one less term than the original.\n    return [xs[i] * i for i in range(1, len(xs))]"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"\n    Counts the number of vowels in a string, including 'y' when at the end of the word.\n    Standard vowels are 'a', 'e', 'i', 'o', 'u' (case-insensitive).\n    \"\"\"\n    count = 0\n    standard_vowels = \"aeiouAEIOU\"\n    n = len(s)\n    for i, char in enumerate(s):\n        if char in standard_vowels:\n            count += 1\n        elif char.lower() == 'y' and i == n - 1:\n            count += 1\n    return count"}
{"task_id": "HumanEval/63", "solution": "_fibfib_cache = {}\n\ndef fibfib(n: int):\n    \"\"\"Computes the n-th FibFib number using memoization for efficiency.\n    It is defined by fibfib(0)=0, fibfib(1)=0, fibfib(2)=1, and fibfib(n)=fibfib(n-1)+fibfib(n-2)+fibfib(n-3).\n    \"\"\"\n    if n in _fibfib_cache:\n        return _fibfib_cache[n]\n\n    if n == 0:\n        result = 0\n    elif n == 1:\n        result = 0\n    elif n == 2:\n        result = 1\n    else:\n        result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n\n    _fibfib_cache[n] = result\n    return result"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    s_x = str(x)\n\n    # Handle negative numbers by separating the sign\n    sign = ''\n    if s_x.startswith('-'):\n        sign = '-'\n        s_x = s_x[1:]\n    \n    digits = s_x\n    n = len(digits)\n\n    # If shift exceeds the number of digits, return the digits reversed\n    if shift > n:\n        return sign + digits[::-1]\n    \n    # Perform a circular shift to the right by `shift` positions\n    # A shift by `n` positions or 0 positions results in the original sequence\n    shift_mod = shift % n \n    shifted_digits = digits[-shift_mod:] + digits[:-shift_mod]\n    \n    return sign + shifted_digits"}
{"task_id": "HumanEval/67", "solution": "def fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket given total fruits and a string\n    describing apples and oranges.\n    \"\"\"\n    parts = s.split(\" \")\n    apples = int(parts[0])\n    oranges = int(parts[3])\n    \n    mangoes = n - apples - oranges\n    return mangoes"}
