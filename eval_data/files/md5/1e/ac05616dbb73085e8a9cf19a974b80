{"task_id": "HumanEval/30", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass Number:\n    value: int\n\n@dataclass\nclass NumberList:\n    elements: List[Number]\n\ndef get_positive(l: list):\n    \"\"\"Return only positive numbers in the list.\n    >>> get_positive([-1, 2, -4, 5, 6])\n    [2, 5, 6]\n    >>> get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    [5, 3, 2, 3, 9, 123, 1]\n    \"\"\"\n    number_list = NumberList(elements=[Number(value=x) for x in l])\n    positives = [n.value for n in number_list.elements if n.value > 0]\n    return positives"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if not isinstance(n, int):\n        return False\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list):\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    unique_elements = list(set(l))\n    unique_elements.sort()\n    return unique_elements"}
{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    max_val = l[0]\n    for x in l:\n        if x > max_val:\n            max_val = x\n    return max_val"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\n        return []\n\n    # Create a mutable copy of the input list to modify.\n    result = l.copy()\n\n    # Collect elements at indices divisible by three and their corresponding indices.\n    elements_at_third_indices = []\n    third_indices = []\n    for i in range(len(l)):\n        if i % 3 == 0:\n            elements_at_third_indices.append(l[i])\n            third_indices.append(i)\n\n    # Sort the collected elements.\n    sorted_elements = sorted(elements_at_third_indices)\n\n    # Place the sorted elements back into their original positions in the copied list.\n    for i in range(len(third_indices)):\n        result[third_indices[i]] = sorted_elements[i]\n\n    return result"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    even_indexed_elements = []\n    for i in range(0, len(l), 2):\n        even_indexed_elements.append(l[i])\n\n    even_indexed_elements.sort()\n\n    result = list(l) # Create a copy to avoid modifying the original list\n    even_sorted_idx = 0\n    for i in range(len(l)):\n        if i % 2 == 0:\n            result[i] = even_indexed_elements[even_sorted_idx]\n            even_sorted_idx += 1\n    \n    return result"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    if n <= 0:\n        return 0\n\n    total_sevens_count = 0\n    # Iterate over numbers from 1 to n-1.\n    for i in range(1, n):\n        # Check divisibility by 11 or 13.\n        if (i % 11 == 0) or (i % 13 == 0):\n            # Convert qualifying numbers to string and count occurrences of '7'.\n            total_sevens_count += str(i).count('7')\n            \n    return total_sevens_count"}
{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    # Use the bisection method to find a root of the polynomial.\n    # For odd-degree polynomials, a real root is guaranteed to exist.\n\n    EPS = 1e-7  # Tolerance for convergence (how close to zero for function value or interval width)\n    MAX_ITER = 1000  # Maximum number of iterations for the bisection loop\n\n    # Define an initial broad search range. For an odd-degree polynomial,\n    # the function values at sufficiently large negative and positive x\n    # will have opposite signs, guaranteeing a root within this interval.\n    low = -100000.0\n    high = 100000.0\n\n    # Evaluate the polynomial at the initial bounds and at x=0.\n    # Check for early exit if a root is found directly at these points.\n    if abs(poly(xs, 0.0)) < EPS:\n        return 0.0\n\n    f_low = poly(xs, low)\n    if abs(f_low) < EPS:\n        return low\n\n    f_high = poly(xs, high)\n    if abs(f_high) < EPS:\n        return high\n\n    # If the initial interval does not bracket a root (i.e., signs are not opposite),\n    # it implies an issue with the range or polynomial properties not expected\n    # given the problem's guarantees for odd-degree polynomials.\n    # We proceed assuming a root exists and will be found by bisection.\n    # The problem statement guarantees a solution, so a robust dynamic\n    # bracket expansion is not strictly necessary for this context.\n\n    for _ in range(MAX_ITER):\n        mid = (low + high) / 2.0\n        f_mid = poly(xs, mid)\n\n        # Check convergence conditions:\n        # 1. The function value at the midpoint is very close to zero.\n        # 2. The width of the current search interval is very small.\n        if abs(f_mid) < EPS or (high - low) < EPS:\n            return mid\n\n        # Determine which half of the interval contains the root\n        # If f_low and f_mid have opposite signs, the root is in [low, mid]\n        if f_low * f_mid < 0:\n            high = mid\n            f_high = f_mid  # Update f_high to maintain the bracketing invariant\n        # Otherwise, f_low and f_mid have the same sign (or f_mid is 0,\n        # which would have been caught by the convergence check),\n        # so the root is in [mid, high]\n        else:\n            low = mid\n            f_low = f_mid  # Update f_low to maintain the bracketing invariant\n\n    # If the maximum number of iterations is reached without converging,\n    # return the midpoint of the final interval as the best approximation.\n    return (low + high) / 2.0"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "class FibonacciGenerator:\n    \"\"\"Generates Fibonacci numbers sequentially.\"\"\"\n    def __init__(self):\n        self.prev, self.curr = 0, 1\n\n    def next(self) -> int:\n        self.prev, self.curr = self.curr, self.prev + self.curr\n        return self.curr\n\n\nclass PrimeChecker:\n    \"\"\"Checks if a number is prime.\"\"\"\n    @staticmethod\n    def is_prime(number: int) -> bool:\n        if number < 2:\n            return False\n        if number == 2:\n            return True\n        if number % 2 == 0:\n            return False\n        i = 3\n        while i * i <= number:\n            if number % i == 0:\n                return False\n            i += 2\n        return True\n\n\nclass PrimeFibonacciService:\n    \"\"\"Service that returns the nth prime Fibonacci number.\"\"\"\n    def prime_fib(self, n: int) -> int:\n        if not isinstance(n, int) or n <= 0:\n            raise ValueError(\"n must be a positive integer\")\n        \n        gen = FibonacciGenerator()\n        checker = PrimeChecker()\n        count = 0\n        while True:\n            fib = gen.next()\n            if checker.is_prime(fib):\n                count += 1\n                if count == n:\n                    return fib\n\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    service = PrimeFibonacciService()\n    return service.prime_fib(n)"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    # Sort the list to enable the two-pointer approach.\n    l.sort()\n\n    # Iterate through the list, fixing one element (l[i])\n    for i in range(n - 2):\n        # Initialize two pointers for the remaining sublist\n        left = i + 1\n        right = n - 1\n\n        while left < right:\n            current_sum = l[i] + l[left] + l[right]\n\n            if current_sum == 0:\n                # Found a triple that sums to zero\n                return True\n            elif current_sum < 0:\n                # Sum is too small, move left pointer to increase the sum\n                left += 1\n            else:\n                # Sum is too large, move right pointer to decrease the sum\n                right -= 1\n\n    # No triple found after checking all possibilities\n    return False"}
