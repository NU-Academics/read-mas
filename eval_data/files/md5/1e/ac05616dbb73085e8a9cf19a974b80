{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even non-negative integer in an array and returns it along with its index.\n    If multiple such values exist, the one with the smallest index is returned.\n    \"\"\"\n    min_even_value = float('inf')\n    min_even_index = -1\n\n    for i, num in enumerate(arr):\n        if num % 2 == 0:  # Check if the number is even\n            if num < min_even_value:\n                min_even_value = num\n                min_even_index = i\n            # If num == min_even_value, we do nothing because we prioritize the smallest index,\n            # and iterating from left to right naturally picks the first occurrence.\n\n    if min_even_index != -1:\n        return [min_even_value, min_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    \"\"\"\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    \"\"\"\n    frequencies = {}\n    for num in lst:\n        frequencies[num] = frequencies.get(num, 0) + 1\n\n    max_qualifying_integer = -1\n    for num, freq in frequencies.items():\n        if freq >= num and num > max_qualifying_integer:\n            max_qualifying_integer = num\n\n    return max_qualifying_integer"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    if not lst:\n        return []\n\n    sorted_lst = sorted(lst)\n    result = []\n    left, right = 0, len(sorted_lst) - 1\n    pick_min = True\n\n    while left <= right:\n        if pick_min:\n            result.append(sorted_lst[left])\n            left += 1\n        else:\n            result.append(sorted_lst[right])\n            right -= 1\n        pick_min = not pick_min\n\n    return result"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    \"\"\"\n    Checks if object q will fly based on palindromic balance and weight constraint.\n    Returns True if q is a palindrome and sum(q) <= w, False otherwise.\n    \"\"\"\n    # Check if the list q is a palindrome\n    if q != q[::-1]:\n        return False\n    \n    # Check if the sum of elements is less than or equal to the maximum weight w\n    if sum(q) <= w:\n        return True\n    else:\n        return False"}
{"task_id": "HumanEval/71", "solution": "import math\n\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    # Sides must be positive values.\n    if a <= 0 or b <= 0 or c <= 0:\n        return -1\n\n    # Validate triangle inequality: the sum of any two sides must be greater than the third side.\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1\n\n    # Calculate the semi-perimeter.\n    s = (a + b + c) / 2\n\n    # Calculate the area using Heron's formula.\n    # Use max(0, ...) to prevent potential math domain errors from floating point inaccuracies causing a slightly negative value.\n    area_squared = s * (s - a) * (s - b) * (s - c)\n    area = math.sqrt(max(0, area_squared))\n\n    # Round the calculated area to 2 decimal points.\n    return round(area, 2)"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum number of changes to make an array palindromic by comparing symmetric elements.\n    Each mismatch between symmetric elements contributes one change.\n    \"\"\"\n    n = len(arr)\n    changes = 0\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            changes += 1\n    return changes"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    \"\"\"\n    Compares two lists of strings based on their total character count\n    and returns the list with the fewer characters, or the first list if counts are equal.\n    \"\"\"\n    total_chars_lst1 = sum(len(s) for s in lst1)\n    total_chars_lst2 = sum(len(s) for s in lst2)\n\n    if total_chars_lst1 <= total_chars_lst2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"\n    Checks if a number is the product of exactly three prime numbers.\n    The input `a` is less than 100.\n    \"\"\"\n    def is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    if a < 8: # Smallest product of 3 primes is 2*2*2 = 8\n        return False\n\n    # Iterate through possible first prime factors p1\n    # p1 must be less than or equal to the cube root of a.\n    # For a < 100, the maximum p1 is 4 (cbrt(99) approx 4.62), so p1 can be 2 or 3.\n    # We iterate up to int(a**(1/3)) + 2 to be safe and cover all cases.\n    for p1 in range(2, int(a**(1/3)) + 2):\n        if not is_prime(p1):\n            continue\n        if a % p1 == 0:\n            remaining_val1 = a // p1\n            # Iterate through possible second prime factors p2\n            # p2 must be greater than or equal to p1.\n            # p2 must be less than or equal to the square root of remaining_val1.\n            for p2 in range(p1, int(remaining_val1**0.5) + 2):\n                if not is_prime(p2):\n                    continue\n                if remaining_val1 % p2 == 0:\n                    p3 = remaining_val1 // p2\n                    # The third factor p3 must be prime and greater than or equal to p2.\n                    if is_prime(p3) and p3 >= p2:\n                        return True\n    return False"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Your task is to write a function that returns true if a number x is a simple\n    power of n and false in other cases.\n    x is a simple power of n if n**int=x\n    For example:\n    is_simple_power(1, 4) => true\n    is_simple_power(2, 2) => true\n    is_simple_power(8, 2) => true\n    is_simple_power(3, 2) => false\n    is_simple_power(3, 1) => false\n    is_simple_power(5, 3) => false\n    \"\"\"\n    if x == 1:\n        return n > 0\n    if n == 1:\n        return x == 1\n    if n <= 0 or x <= 0:\n        return False\n\n    current = 1\n    while current < x:\n        current *= n\n    return current == x"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    if a < 0:\n        # For negative numbers, calculate the cube root of the absolute value, then negate the result.\n        potential_root = -round(abs(a)**(1/3))\n    else:\n        # For non-negative numbers, directly calculate the cube root.\n        potential_root = round(a**(1/3))\n    \n    # Check if cubing the potential root returns the original number.\n    return potential_root * potential_root * potential_root == a"}
{"task_id": "HumanEval/78", "solution": "def hex_key(num):\n    \"\"\"Counts the number of prime hexadecimal digits in the input string.\"\"\"\n    prime_hex_digits = {'2', '3', '5', '7', 'B', 'D'}\n    count = 0\n    for digit in num:\n        if digit in prime_hex_digits:\n            count += 1\n    return count"}
{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal):\n    \"\"\"Converts a decimal number to its binary string representation,\n    formatted with 'db' prefix and suffix.\n    \"\"\"\n    if decimal == 0:\n        binary_str = \"0\"\n    else:\n        binary_digits = []\n        temp_decimal = decimal\n        while temp_decimal > 0:\n            remainder = temp_decimal % 2\n            binary_digits.append(str(remainder))\n            temp_decimal //= 2\n        # Reverse the list of digits and join them to form the binary string\n        binary_str = \"\".join(binary_digits[::-1])\n\n    return \"db\" + binary_str + \"db\""}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    Examples\n    prime_length('Hello') == True\n    prime_length('abcdcba') == True\n    prime_length('kittens') == True\n    prime_length('orange') == False\n    \"\"\"\n    length = len(string)\n\n    if length <= 1:\n        return False\n    if length == 2:\n        return True\n    if length % 2 == 0:\n        return False\n\n    i = 3\n    while i * i <= length:\n        if length % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"Checks if the string is happy. A string is happy if its length is at least 3 and every 3 consecutive letters are distinct.\"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        # Check if the three consecutive characters are distinct\n        if s[i] == s[i+1] or s[i] == s[i+2] or s[i+1] == s[i+2]:\n            return False\n            \n    return True"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n    \n    # Count of numbers that start with 1: The first digit is 1, the remaining (n-1) digits can be any from 0-9.\n    starts_with_1 = 10**(n - 1)\n    \n    # Count of numbers that end with 1: The last digit is 1. The first digit cannot be 0 (9 choices). The middle (n-2) digits can be any (10 choices each).\n    ends_with_1 = 9 * (10**(n - 2))\n    \n    # Count of numbers that start AND end with 1: The first digit is 1, the last digit is 1. The middle (n-2) digits can be any from 0-9.\n    starts_and_ends_with_1 = 10**(n - 2)\n    \n    # Using the Principle of Inclusion-Exclusion: |A U B| = |A| + |B| - |A intersection B|\n    # This simplifies to 10**(n-1) + 8 * 10**(n-2)\n    return starts_with_1 + ends_with_1 - starts_and_ends_with_1"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"It is the last week of the semester and the teacher has to give the grades\n    to students. The teacher has been making her own algorithm for grading.\n    The only problem is, she has lost the code she used for grading.\n    She has given you a list of GPAs for some students and you have to write\n    a function that can output a list of letter grades using the following table:\n             GPA       |    Letter grade\n              4.0                A+\n            > 3.7                A\n            > 3.3                A-\n            > 3.0                B+\n            > 2.7                B\n            > 2.3                B-\n            > 2.0                C+\n            > 1.7                C\n            > 1.3                C-\n            > 1.0                D+\n            > 0.7                D\n            > 0.0                D-\n              0.0                E\n\n\n    Example:\n    grade_equation([4.0, 3, 1.7, 2, 3.5]) ==> ['A+', 'B', 'C-', 'C', 'A-']\n    \"\"\"\n    letter_grades = []\n    for gpa in grades:\n        # Validate GPA is within the acceptable range [0.0, 4.0].\n        if not (0.0 <= gpa <= 4.0):\n            raise ValueError(\"GPA must be between 0.0 and 4.0, inclusive.\")\n\n        if gpa == 4.0:\n            letter_grades.append('A+')\n        elif gpa > 3.7:\n            letter_grades.append('A')\n        elif gpa > 3.3:\n            letter_grades.append('A-')\n        elif gpa > 3.0:\n            letter_grades.append('B+')\n        elif gpa > 2.7:\n            letter_grades.append('B')\n        elif gpa > 2.3:\n            letter_grades.append('B-')\n        elif gpa > 2.0:\n            letter_grades.append('C+')\n        elif gpa > 1.7:\n            letter_grades.append('C')\n        elif gpa > 1.3:\n            letter_grades.append('C-')\n        elif gpa > 1.0:\n            letter_grades.append('D+')\n        elif gpa > 0.7:\n            letter_grades.append('D')\n        elif gpa > 0.0:\n            letter_grades.append('D-')\n        else:  # gpa == 0.0\n            letter_grades.append('E')\n    return letter_grades"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\"\"\"\n    \n    digit_sum = 0\n    # Calculate the sum of the digits of N\n    s_N = str(N)\n    for digit_char in s_N:\n        digit_sum += int(digit_char)\n            \n    # Convert the sum to its binary representation and return as a string\n    return bin(digit_sum)[2:]"}
{"task_id": "HumanEval/85", "solution": "```python\ndef add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\n\n\n    Examples:\n        add([4, 2, 6, 7]) ==> 2 \n    \"\"\"\n    total = 0\n    for idx, value in enumerate(lst):\n        if idx % 2 == 1 and value % 2 == 0:\n            total += value\n    return total\n```"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n    \"\"\"\n    if len(array) <= 1:\n        return array[:]\n\n    first_element = array[0]\n    last_element = array[-1]\n    \n    sum_first_last = first_element + last_element\n\n    # Create a copy of the array to avoid modifying the original\n    sorted_copy = array[:]\n\n    if sum_first_last % 2 != 0:  # Sum is odd, sort ascending\n        sorted_copy.sort()\n    else:  # Sum is even, sort descending\n        sorted_copy.sort(reverse=True)\n\n    return sorted_copy"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n\n    For example:\n    anti_shuffle('Hi') returns 'Hi'\n    anti_shuffle('hello') returns 'ehllo'\n    anti_shuffle('Hello World!!!') returns 'Hello !!!Wdlor'\n    \"\"\"\n    result_parts = []\n    current_word = []\n    in_word = False\n\n    for char in s:\n        if char == ' ':\n            if in_word:\n                result_parts.append(\"\".join(sorted(current_word)))\n                current_word = []\n                in_word = False\n            result_parts.append(' ')\n        else:\n            current_word.append(char)\n            in_word = True\n\n    if in_word:\n        result_parts.append(\"\".join(sorted(current_word)))\n\n    return \"\".join(result_parts)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds all occurrences of integer x in a jagged 2D list and returns their coordinates.\n    Coordinates are sorted by row ascending, then by column descending within each row.\n    \"\"\"\n    coordinates = []\n    for row_index, row in enumerate(lst):\n        for col_index, value in enumerate(row):\n            if value == x:\n                coordinates.append((row_index, col_index))\n\n    coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n    return coordinates"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by shifting alphabetic characters down by four places, wrapping around the alphabet.\"\"\"\n    result = []\n    shift = 4  # The alphabet shifts down by two multiplied to two places, which is 4.\n    for char in s:\n        if 'a' <= char <= 'z':\n            shifted_char = chr(((ord(char) - ord('a') + shift) % 26) + ord('a'))\n            result.append(shifted_char)\n        elif 'A' <= char <= 'Z':\n            shifted_char = chr(((ord(char) - ord('A') + shift) % 26) + ord('A'))\n            result.append(shifted_char)\n        else:\n            result.append(char)\n    return \"\".join(result)"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Returns the 2nd smallest distinct element of the list.\n    Returns None if there is no such element.\n    \"\"\"\n    distinct_elements = sorted(list(set(lst)))\n    if len(distinct_elements) < 2:\n        return None\n    return distinct_elements[1]"}
{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    Counts the number of sentences that start with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    import re\n\n    boredom_count = 0\n    # Split the string into sentences using '.', '?', or '!' as delimiters.\n    # re.split returns a list of strings where the splits occurred.\n    # Empty strings might appear if delimiters are at the start/end or consecutive.\n    sentences = re.split(r'[.?!]', S)\n\n    for sentence in sentences:\n        # Remove leading/trailing whitespace from the sentence.\n        stripped_sentence = sentence.strip()\n\n        # Check if the stripped sentence is not empty.\n        if stripped_sentence:\n            # A boredom is a sentence that starts with the word \"I\".\n            # This means it either equals \"I\" or starts with \"I \" (I followed by a space).\n            if stripped_sentence == \"I\" or stripped_sentence.startswith(\"I \"):\n                boredom_count += 1\n\n    return boredom_count"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n    '''\n    # Check if all numbers are integers (e.g., 5, 2.0 but not 3.6)\n    all_integers = (x == int(x) and y == int(y) and z == int(z))\n\n    # Check if one number is the sum of the other two\n    sum_condition = (x == y + z or y == x + z or z == x + y)\n\n    return all_integers and sum_condition"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"Implement a function that takes a non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    \"\"\"\n    if n <= 2:\n        return []\n\n    primes = []\n\n    def is_prime(num):\n        if num < 2:\n            return False\n        for i in range(2, int(num**0.5) + 1):\n            if num % i == 0:\n                return False\n        return True\n\n    for num in range(2, n):\n        if is_prime(num):\n            primes.append(num)\n\n    return primes"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"Finds the largest prime value in a list of integers and returns the sum of its digits.\n    Returns 0 if no prime number is found.\"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    def sum_digits(n):\n        \"\"\"Calculates the sum of the digits of a number.\"\"\"\n        s = 0\n        while n:\n            s += n % 10\n            n //= 10\n        return s\n\n    largest_prime = 0\n    for num in lst:\n        if is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n\n    if largest_prime == 0:\n        return 0\n    else:\n        return sum_digits(largest_prime)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower \n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    Examples:\n    check_dict_case({\"a\":\"apple\", \"b\":\"banana\"}) should return True.\n    check_dict_case({\"a\":\"apple\", \"A\":\"banana\", \"B\":\"banana\"}) should return False.\n    check_dict_case({\"a\":\"apple\", 8:\"banana\", \"a\":\"apple\"}) should return False.\n    check_dict_case({\"Name\":\"John\", \"Age\":\"36\", \"City\":\"Houston\"}) should return False.\n    check_dict_case({\"STATE\":\"NC\", \"ZIP\":\"12345\" }) should return True.\n    \"\"\"\n    if not dict:\n        return False\n\n    all_keys_are_lower = True\n    all_keys_are_upper = True\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n\n        # A string key must be either entirely lowercase or entirely uppercase.\n        # If it's neither (e.g., \"MixedCase\", \"123\", or contains symbols),\n        # it cannot satisfy the condition for all keys.\n        if not (key.islower() or key.isupper()):\n            return False\n\n        all_keys_are_lower = all_keys_are_lower and key.islower()\n        all_keys_are_upper = all_keys_are_upper and key.isupper()\n\n    # The condition is met if all keys were consistently lowercase or consistently uppercase.\n    return all_keys_are_lower or all_keys_are_upper"}
{"task_id": "HumanEval/97", "solution": "def multiply(a, b):\n    \"\"\"Complete the function that takes two integers and returns\n    the product of their unit digits.\n    Assume the input is always valid.\n    Examples:\n    multiply(148, 412) should return 16.\n    multiply(19, 28) should return 72.\n    multiply(2020, 1851) should return 0.\n    multiply(14,-15) should return 20.\n    \"\"\"\n    class MultiplyFunction:\n        def __init__(self, val_a: int, val_b: int):\n            self._a = val_a\n            self._b = val_b\n\n        def compute(self) -> int:\n            \"\"\"Calculates the product of the absolute unit digits.\"\"\"\n            unit_a = abs(self._a) % 10\n            unit_b = abs(self._b) % 10\n            return unit_a * unit_b\n\n    # Delegate the computation to the MultiplyFunction class as per design\n    multiplier = MultiplyFunction(a, b)\n    return multiplier.compute()"}
