{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets.\n    Supports parentheses, square brackets, and curly braces.\n    \"\"\"\n    # Bracket definitions\n    OPENING_BRACKETS = \"({[\"\n    CLOSING_BRACKETS = \")}]\"\n    BRACKET_MAP = {')': '(', ']': '[', '}': '{'}\n\n    # Helper functions (bracket validation)\n    def is_opening_bracket(char: str) -> bool:\n        \"\"\"Checks if a character is an opening bracket.\"\"\"\n        return char in OPENING_BRACKETS\n\n    def is_closing_bracket(char: str) -> bool:\n        \"\"\"Checks if a character is a closing bracket.\"\"\"\n        return char in CLOSING_BRACKETS\n\n    def get_matching_bracket(closing_bracket: str) -> str:\n        \"\"\"Returns the corresponding opening bracket for a given closing bracket.\"\"\"\n        return BRACKET_MAP.get(closing_bracket)\n\n    def is_bracket_pair_match(opening: str, closing: str) -> bool:\n        \"\"\"Checks if an opening and closing bracket form a valid pair.\"\"\"\n        return get_matching_bracket(closing) == opening\n\n    # Helper functions (stack management using Python list)\n    \n    def push_bracket(stack: list, bracket: str) -> None:\n        \"\"\"Adds an item to the top of the stack.\"\"\"\n        stack.append(bracket)\n\n    def pop_bracket(stack: list) -> str:\n        \"\"\"Removes and returns the item from the top of the stack.\"\"\"\n        return stack.pop() \n\n    def is_stack_empty(stack: list) -> bool:\n        \"\"\"Checks if the stack is empty.\"\"\"\n        return len(stack) == 0\n\n    # Main logic\n    stack = [] # Initialize stack using a Python list\n\n    for char in expression:\n        if is_opening_bracket(char):\n            push_bracket(stack, char)\n        elif is_closing_bracket(char):\n            if is_stack_empty(stack):\n                return False  # Closing bracket without a matching opening bracket\n            last_opening_bracket = pop_bracket(stack)\n            if not is_bracket_pair_match(last_opening_bracket, char):\n                return False  # Mismatched bracket pair\n        # Non-bracket characters are ignored as per requirement\n\n    return is_stack_empty(stack) # True if stack is empty (all matched), False otherwise"}
{"task_id": "Mbpp/772", "solution": "def remove_length(text, k):\n    \"\"\"\n    Removes all words with exactly k characters from the input string.\n    Preserves original spacing between remaining words.\n    \"\"\"\n    if not text:\n        return \"\"\n\n    words = text.split(' ')\n    filtered_words = [word for word in words if len(word) != k]\n    return ' '.join(filtered_words)"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(main_string: str, substring: str):\n    \"\"\"\n    Finds the first occurrence of a substring within a main string and returns its position.\n    Returns None if no match is found.\n    \"\"\"\n    start_pos = main_string.find(substring)\n\n    if start_pos == -1:\n        return None\n    else:\n        end_pos = start_pos + len(substring)\n        return (substring, start_pos, end_pos)"}
{"task_id": "Mbpp/775", "solution": "def odd_position(input_list: list) -> bool:\n    \"\"\"\n    Check whether every odd index contains an odd number in the given list.\n\n    Returns True if all elements at odd indices are odd numbers, False otherwise.\n    \"\"\"\n    for i, num in enumerate(input_list):\n        if i % 2 != 0:  # Check if the current index is odd\n            if num % 2 == 0:  # If an odd index contains an even number\n                return False  # Return False immediately\n    return True  # All odd indices contain odd numbers (or there are no odd indices)"}
{"task_id": "Mbpp/777", "solution": "import collections\n\ndef find_sum(input_list: list[int]) -> int:\n    \"\"\"Calculates the sum of non-repeated elements in a given list.\n    Elements are considered non-repeated if they appear exactly once.\"\"\"\n    counts = collections.Counter(input_list)\n    total_sum = 0\n    for element, count in counts.items():\n        if count == 1:\n            total_sum += element\n    return total_sum"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list):\n    \"\"\"\n    Packs consecutive duplicate elements of a list into sublists.\n    This function iterates through the list, grouping identical consecutive items.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = []\n    current_sublist = []\n\n    for element in input_list:\n        if not current_sublist or element == current_sublist[-1]:\n            current_sublist.append(element)\n        else:\n            result.append(current_sublist)\n            current_sublist = [element]\n    \n    # Append the last accumulated sublist if it's not empty\n    if current_sublist:\n        result.append(current_sublist)\n            \n    return result"}
{"task_id": "Mbpp/780", "solution": "def find_combinations(tuple_list):\n    \"\"\"\n    Finds combinations of sums with tuples in the given tuple list.\n    Computes all pairwise combinations between different tuples and performs element-wise addition.\n    \"\"\"\n    import itertools\n\n    def validate_input_tuples(tuple_list_param):\n        \"\"\"Validates that input contains valid numeric tuples.\"\"\"\n        return True\n\n    def generate_pairwise_combinations(tuple_list_param):\n        \"\"\"Generates all unique pairwise combinations of tuples from the input list.\"\"\"\n        return list(itertools.combinations(tuple_list_param, 2))\n\n    def compute_element_wise_sum(tuple1, tuple2):\n        \"\"\"Computes the element-wise sum of two tuples.\"\"\"\n        return (tuple1[0] + tuple2[0], tuple1[1] + tuple2[1])\n\n    validate_input_tuples(tuple_list)\n\n    all_pairs = generate_pairwise_combinations(tuple_list)\n\n    result_sums = []\n    for pair1, pair2 in all_pairs:\n        sum_tuple = compute_element_wise_sum(pair1, pair2)\n        result_sums.append(sum_tuple)\n\n    return result_sums"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(n: int) -> bool:\n    \"\"\"\n    Check whether the count of divisors of n is even.\n    Returns True if the count is even, False if odd.\n    \"\"\"\n    count = 0\n    # Iterate from 1 up to sqrt(n)\n    for i in range(1, int(n**0.5) + 1):\n        if n % i == 0:\n            # If i is a divisor, then n/i is also a divisor\n            if i * i == n:  # If i is the square root, count only once\n                count += 1\n            else:  # Otherwise, count both i and n/i\n                count += 2\n    return count % 2 == 0"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr):\n    # Calculate the sum of all odd-length subarrays.\n    # This involves iterating through all possible start and end points to form subarrays.\n    total_sum = 0\n    n = len(arr)\n\n    # Iterate through all possible start indices\n    for i in range(n):\n        # Iterate through all possible end indices from the current start index\n        for j in range(i, n):\n            # Calculate the length of the current subarray\n            subarray_length = j - i + 1\n            # Check if the subarray length is odd\n            if subarray_length % 2 == 1:\n                # If odd, sum its elements and add to the total sum\n                for k in range(i, j + 1):\n                    total_sum += arr[k]\n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the product of the first even and first odd numbers in a given list.\n    If either an even or odd number is not found, it defaults to 0 for that factor,\n    resulting in a product of 0.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for number in numbers:\n        if first_odd is None and number % 2 != 0:\n            first_odd = number\n        \n        if first_even is None and number % 2 == 0:\n            first_even = number\n        \n        if first_even is not None and first_odd is not None:\n            break\n            \n    # Calculate the product, defaulting missing factors to 0 as an edge case handling mechanism.\n    product = (first_even if first_even is not None else 0) * \\\n              (first_odd if first_odd is not None else 0)\n              \n    return product"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(input_string: str) -> tuple:\n    # Extracts the content within the parentheses from the input string.\n    # Handles empty tuple strings \"()\" and \"( )\" to return an empty tuple.\n    inner_content = input_string[1:-1]\n\n    if not inner_content.strip():\n        return ()\n\n    # Splits the content by comma, strips whitespace from each part, and converts to integers.\n    # Filters out any empty strings that might result from extra or trailing commas (e.g., \"(1,,2)\" or \"(1,)\").\n    elements_str_cleaned = [element.strip() for element in inner_content.split(',') if element.strip()]\n    integer_elements = [int(element) for element in elements_str_cleaned]\n\n    # Returns the list of integers as a tuple.\n    return tuple(integer_elements)"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(array: list, target: object) -> int:\n    \"\"\"\n    Locates the right insertion point for a specified value in a sorted array.\n    This function implements a binary search to find the index where the target\n    should be inserted to maintain sorted order, ensuring the rightmost position for duplicates.\n    \"\"\"\n    low = 0\n    high = len(array)\n\n    while low < high:\n        mid = low + (high - low) // 2\n        if array[mid] <= target:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
