{"task_id": "Mbpp/63", "solution": "def max_difference(tuple_list: list) -> float:\n    \"\"\"\n    Calculate the maximum absolute difference between pairs in a list of tuples.\n\n    Args:\n        tuple_list: List of tuples, each containing exactly two numeric elements\n\n    Returns:\n        float: Maximum absolute difference found among all tuple pairs\n    \"\"\"\n    # Helper function to calculate the absolute difference between two numbers.\n    def _calculate_difference(a: float, b: float) -> float:\n        return abs(a - b)\n\n    # Helper function to find the maximum value from a list of numbers.\n    def _find_maximum(differences: list) -> float:\n        # Assuming the input list of differences is guaranteed to be non-empty based on problem context.\n        return max(differences)\n\n    # As per design and explicit instructions, input validation checks and raising exceptions are omitted.\n    # We assume valid input structure and content as demonstrated in the assert.\n    if not tuple_list:\n        return 0.0  # Return 0.0 for an empty input list, as no differences can be calculated.\n\n    calculated_differences = []\n    for pair in tuple_list:\n        # Each pair is assumed to contain exactly two numeric elements.\n        diff = _calculate_difference(pair[0], pair[1])\n        calculated_differences.append(diff)\n\n    # Find the maximum difference from the collected differences.\n    return _find_maximum(calculated_differences)"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"\n    Count substrings where sum of digits equals substring length.\n    \"\"\"\n    \n    def generate_substrings(s: str) -> list[str]:\n        \"\"\"\n        Generate all contiguous substrings.\n        \"\"\"\n        substrings = []\n        n = len(s)\n        for i in range(n):\n            for j in range(i + 1, n + 1):\n                substrings.append(s[i:j])\n        return substrings\n\n    def calculate_digit_sum(substring: str) -> int:\n        \"\"\"\n        Calculate sum of digits in substring.\n        \"\"\"\n        return sum(int(digit) for digit in substring)\n\n    def is_valid_substring(substring: str) -> bool:\n        \"\"\"\n        Check if substring digit sum equals its length.\n        \"\"\"\n        return calculate_digit_sum(substring) == len(substring)\n\n    count = 0\n    all_substrings = generate_substrings(s)\n    for substring in all_substrings:\n        if is_valid_substring(substring):\n            count += 1\n    return count"}
