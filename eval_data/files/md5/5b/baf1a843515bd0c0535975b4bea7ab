{"task_id": "Mbpp/632", "solution": "def move_zero(input_list: list) -> list:\n    \"\"\"\n    Moves all zeroes in the input list to the end, preserving the relative order of non-zero elements.\n    Returns a new list with the modified order.\n    \"\"\"\n    non_zeros = []\n    zero_count = 0\n    for element in input_list:\n        if element != 0:\n            non_zeros.append(element)\n        else:\n            zero_count += 1\n    non_zeros.extend([0] * zero_count)\n    return non_zeros"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers: list, count: int) -> int:\n    \"\"\"\n    Calculates the sum of XOR of all unique pairs of numbers in the given list.\n    It uses a bitwise approach for optimized performance.\n    \"\"\"\n    total_xor_sum = 0\n    \n    # Iterate over each bit position (e.g., up to 31 for standard integers).\n    # This covers the typical range for non-negative integers.\n    for k in range(32): \n        set_bits_count = 0\n        \n        # Count how many numbers in the list have the k-th bit set.\n        for num in numbers:\n            if (num >> k) & 1:\n                set_bits_count += 1\n        \n        # Calculate how many numbers have the k-th bit unset.\n        unset_bits_count = count - set_bits_count\n        \n        # Each pair with one set bit and one unset bit at position k contributes 2^k to the total XOR sum.\n        total_xor_sum += (set_bits_count * unset_bits_count) * (1 << k)\n        \n    return total_xor_sum"}
{"task_id": "Mbpp/635", "solution": "from typing import List\n\ndef heapify(arr: List[int], n: int, i: int) -> None:\n    \"\"\"Maintains heap property for subtree rooted at index i\"\"\"\n    largest = i\n    l = 2 * i + 1  # left child\n    r = 2 * i + 2  # right child\n\n    if l < n and arr[l] > arr[largest]:\n        largest = l\n\n    if r < n and arr[r] > arr[largest]:\n        largest = r\n\n    if largest != i:\n        arr[i], arr[largest] = arr[largest], arr[i]\n        heapify(arr, n, largest)\n\ndef build_max_heap(arr: List[int]) -> None:\n    \"\"\"Builds max heap from unsorted array\"\"\"\n    n = len(arr)\n    for i in range(n // 2 - 1, -1, -1):\n        heapify(arr, n, i)\n\ndef extract_elements(arr: List[int]) -> List[int]:\n    \"\"\"Extracts elements in sorted order from max heap\"\"\"\n    n = len(arr)\n    for i in range(n - 1, 0, -1):\n        arr[i], arr[0] = arr[0], arr[i]  # Swap root with current last element\n        heapify(arr, i, 0)  # Heapify the reduced heap\n    return arr\n\ndef heap_sort(input_list: List[int]) -> List[int]:\n    \"\"\"Main heap sort function that sorts input list in ascending order\"\"\"\n    if not input_list:\n        return []\n\n    arr = list(input_list) # Create a copy to avoid modifying original\n\n    build_max_heap(arr)\n    return extract_elements(arr)"}
