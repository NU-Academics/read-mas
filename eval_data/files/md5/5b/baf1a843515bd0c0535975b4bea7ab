{"task_id": "Mbpp/572", "solution": "def two_unique_nums(input_list: list) -> list:\n    \"\"\"Removes duplicate numbers, keeping only unique occurrences while preserving order.\"\"\"\n    if not input_list:\n        return []\n\n    def _count_occurrences(lst: list) -> dict:\n        \"\"\"Counts the frequency of each number in the input list.\"\"\"\n        counts = {}\n        for num in lst:\n            counts[num] = counts.get(num, 0) + 1\n        return counts\n\n    def _filter_unique(lst: list, occurrence_dict: dict) -> list:\n        \"\"\"Filters the list to keep only numbers appearing exactly once, preserving order.\"\"\"\n        unique_nums = []\n        for num in lst:\n            if occurrence_dict[num] == 1:\n                unique_nums.append(num)\n        return unique_nums\n\n    occurrences = _count_occurrences(input_list)\n    return _filter_unique(input_list, occurrences)"}
{"task_id": "Mbpp/573", "solution": "def unique_product(input_list: list) -> int:\n    \"\"\"\n    Calculates the product of the unique numbers in a given list.\n    Returns 1 for an empty list, as it's the multiplicative identity.\n    \"\"\"\n    unique_numbers = set(input_list)\n    product = 1\n    for num in unique_numbers:\n        product *= num\n    return product"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list, sub_list):\n    \"\"\"Checks if sub_list is a contiguous sublist of main_list.\"\"\"\n    # An empty list is considered a sublist of any list.\n    if not sub_list:\n        return True\n\n    # If the sub_list is longer than the main_list, it cannot be a sublist.\n    if len(sub_list) > len(main_list):\n        return False\n\n    # Iterate through possible starting positions for the sub_list in the main_list.\n    for i in range(len(main_list) - len(sub_list) + 1):\n        # Compare the slice of main_list with the sub_list.\n        if main_list[i : i + len(sub_list)] == sub_list:\n            return True\n\n    # If no contiguous match is found after checking all positions.\n    return False"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(number: int) -> int:\n    \"\"\"\n    Calculates the last digit of the factorial of a given number.\n    For numbers 5 or greater, the last digit of the factorial is always 0.\n    \"\"\"\n    if number < 0:\n        # Factorial is not defined for negative numbers.\n        # Following design context to not raise exceptions or add checks,\n        # but for practical use, this would ideally raise an error or return a specific value.\n        # Given the problem's focus on last digit of factorial, and common interpretations,\n        # we can assume valid non-negative integer input based on typical factorial problems.\n        # If forced to return something, 0 is a placeholder, but undefined is more accurate.\n        return 0\n    elif number == 0 or number == 1:\n        return 1\n    elif number == 2:\n        return 2\n    elif number == 3:\n        return 6\n    elif number == 4:\n        return 4\n    else:  # For number >= 5, n! will always end in 0\n        return 0"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Find elements that exist in either tuple but not in both.\n\n    Args:\n        tuple1: First input tuple\n        tuple2: Second input tuple\n\n    Returns:\n        Tuple containing all dissimilar elements\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n    dissimilar_elements = set1.symmetric_difference(set2)\n    return tuple(dissimilar_elements)"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1, list2, list3):\n    \"\"\"\n    Interleave elements from three lists of equal length.\n    Returns a new list with elements from list1, list2, and list3 interleaved.\n    \"\"\"\n    result = []\n    # All lists are assumed to have identical length\n    for i in range(len(list1)):\n        result.append(list1[i])\n        result.append(list2[i])\n        result.append(list3[i])\n    return result"}
{"task_id": "Mbpp/581", "solution": "def surface_Area(base_edge, height):\n    \"\"\"\n    Calculates the surface area of a square pyramid.\n    Uses the formulas for base area, slant height, and triangular face area.\n    \"\"\"\n    import math\n\n    base_area = base_edge * base_edge\n    \n    # Calculate the half of the base edge for the slant height calculation\n    half_base_edge = base_edge / 2\n    \n    # Calculate the slant height using the Pythagorean theorem\n    slant_height = math.sqrt(height**2 + half_base_edge**2)\n    \n    # Calculate the area of one triangular face\n    triangular_face_area = 0.5 * base_edge * slant_height\n    \n    # The total surface area is the base area plus the area of four triangular faces\n    total_surface_area = base_area + (4 * triangular_face_area)\n    \n    return total_surface_area"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Removes odd integer elements from a nested tuple, preserving even integers and the tuple structure.\n    \"\"\"\n\n    def _is_even(number: int) -> bool:\n        \"\"\"Determines if an integer is even.\"\"\"\n        return number % 2 == 0\n\n    def _process_element(element: any) -> any:\n        \"\"\"Processes individual elements, filtering integers or recursing for tuples.\"\"\"\n        if isinstance(element, int):\n            return element if _is_even(element) else None\n        elif isinstance(element, tuple):\n            return extract_even(element)\n        return element # Preserve non-integer, non-tuple elements\n\n    result_elements = []\n    for element in input_tuple:\n        processed = _process_element(element)\n        # Only add non-None results, and for tuples, only add if not empty after processing\n        if processed is not None and not (isinstance(processed, tuple) and not processed):\n            result_elements.append(processed)\n            \n    return tuple(result_elements)"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Catalan number using an iterative recurrence relation.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    catalan = 1  # C_0\n    for i in range(1, n + 1):\n        # C_i = C_{i-1} * 2 * (2*i - 1) / (i + 1)\n        catalan = catalan * (2 * (2 * i - 1)) // (i + 1)\n    return catalan"}
