{"task_id": "Mbpp/592", "solution": "import math\n\ndef _calculate_binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient C(n, k).\"\"\"\n    if k < 0 or k > n:\n        return 0\n    return math.factorial(n) // (math.factorial(k) * math.factorial(n - k))\n\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the product of consecutive binomial coefficients C(n, k) * C(n, k+1).\n    The sum iterates for k from 0 to n-1.\n    \"\"\"\n    total_sum = 0\n    for k in range(n):\n        coeff_k = _calculate_binomial_coefficient(n, k)\n        coeff_k_plus_1 = _calculate_binomial_coefficient(n, k + 1)\n        total_sum += coeff_k * coeff_k_plus_1\n    return total_sum"}
{"task_id": "Mbpp/594", "solution": "def is_even(number: int) -> bool:\n    \"\"\"Checks if a number is even.\"\"\"\n    return number % 2 == 0\n\ndef is_odd(number: int) -> bool:\n    \"\"\"Checks if a number is odd.\"\"\"\n    return number % 2 != 0\n\ndef find_first_even(input_list: list[int]) -> int:\n    \"\"\"Finds the first even number in the list. Assumes an even number is always present.\"\"\"\n    for num in input_list:\n        if is_even(num):\n            return num\n    # According to problem constraints, valid input guarantees an even number is found.\n\ndef find_first_odd(input_list: list[int]) -> int:\n    \"\"\"Finds the first odd number in the list. Assumes an odd number is always present.\"\"\"\n    for num in input_list:\n        if is_odd(num):\n            return num\n    # According to problem constraints, valid input guarantees an odd number is found.\n\ndef calculate_difference(even: int, odd: int) -> int:\n    \"\"\"Calculates the difference between two integers (even - odd).\"\"\"\n    return even - odd\n\ndef diff_even_odd(input_list: list[int]) -> int:\n    \"\"\"\n    Finds the difference between the first even and first odd numbers of a given list.\n    It is assumed that the input list contains at least one even and one odd number.\n    \"\"\"\n    first_even = find_first_even(input_list)\n    first_odd = find_first_odd(input_list)\n    return calculate_difference(first_even, first_odd)"}
