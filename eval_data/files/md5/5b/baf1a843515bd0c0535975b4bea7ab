{"task_id": "Mbpp/721", "solution": "def maxAverageOfPath(matrix_list):\n    \"\"\"\n    Calculates the maximum average cost of a path from the top-left to the bottom-right cell.\n    Paths can only move right or down.\n    \"\"\"\n\n    class Cell:\n        \"\"\"Represents a single cell in the matrix with its coordinates and cost.\"\"\"\n        def __init__(self, row, col, cost):\n            self._row = row\n            self._col = col\n            self._cost = float(cost)\n\n        def get_row(self):\n            return self._row\n\n        def get_col(self):\n            return self._col\n\n        def get_cost(self):\n            return self._cost\n\n    class Path:\n        \"\"\"Represents a sequence of cells forming a path, with calculated total cost and average.\"\"\"\n        def __init__(self):\n            self.cells = []\n            self._total_cost = 0.0\n            self._average = 0.0\n\n        def add_cell(self, cell):\n            self.cells.append(cell)\n            self._total_cost += cell.get_cost()\n\n        def calculate_average(self):\n            length = len(self.cells)\n            if length > 0:\n                self._average = self._total_cost / length\n            else:\n                self._average = 0.0\n\n        def get_length(self):\n            return len(self.cells)\n\n        def get_total_cost(self):\n            return self._total_cost\n\n        def get_average(self):\n            return self._average\n\n    class Matrix:\n        \"\"\"Encapsulates the matrix data and provides access to cells.\"\"\"\n        def __init__(self, matrix_data):\n            self._cells_data = matrix_data\n            self._size = len(matrix_data)\n\n        def get_cell(self, r, c):\n            return Cell(r, c, self._cells_data[r][c])\n\n        def get_size(self):\n            return self._size\n\n    class PathFinder:\n        \"\"\"Finds all valid paths from the top-left to the bottom-right cell.\"\"\"\n        def __init__(self, matrix):\n            self.matrix = matrix\n            self.all_paths = []\n\n        def _generate_paths_recursive(self, r, c, current_path_cells_list):\n            \"\"\"Recursively explores paths by moving right or down.\"\"\"\n            current_cell = self.matrix.get_cell(r, c)\n            current_path_cells_list.append(current_cell)\n\n            is_at_end = (r == self.matrix.get_size() - 1 and c == self.matrix.get_size() - 1)\n\n            if is_at_end:\n                path = Path()\n                for cell in current_path_cells_list:\n                    path.add_cell(cell)\n                path.calculate_average()\n                self.all_paths.append(path)\n                return\n\n            # Try moving right\n            if c + 1 < self.matrix.get_size():\n                # Pass a copy to ensure independent path branches\n                self._generate_paths_recursive(r, c + 1, list(current_path_cells_list))\n\n            # Try moving down\n            if r + 1 < self.matrix.get_size():\n                # Pass a copy to ensure independent path branches\n                self._generate_paths_recursive(r + 1, c, list(current_path_cells_list))\n\n        def find_all_paths(self):\n            \"\"\"Initiates the path generation from the starting cell (0, 0).\"\"\"\n            self._generate_paths_recursive(0, 0, [])\n            return self.all_paths\n\n    # Main function logic starts here\n    matrix_obj = Matrix(matrix_list)\n    path_finder = PathFinder(matrix_obj)\n    \n    all_paths = path_finder.find_all_paths()\n\n    max_average = float('-inf')\n\n    for path in all_paths:\n        max_average = max(max_average, path.get_average())\n\n    return max_average"}
