{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array) -> bool:\n    \"\"\"\n    Check if array is monotonic (non-decreasing or non-increasing).\n    \"\"\"\n    if len(array) <= 1:\n        return True\n\n    is_non_decreasing = True\n    is_non_increasing = True\n\n    for i in range(len(array) - 1):\n        if array[i] > array[i+1]:\n            is_non_decreasing = False\n        if array[i] < array[i+1]:\n            is_non_increasing = False\n\n    return is_non_decreasing or is_non_increasing"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number, representing the number of ways to partition a set of n labeled objects.\n    Uses dynamic programming to compute Stirling numbers of the second kind.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    if n == 0:\n        return 1\n\n    # stirling[i][j] stores S(i, j), the Stirling number of the second kind\n    stirling = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # Base case S(0, 0) = 1\n    stirling[0][0] = 1\n\n    # Fill the Stirling numbers table\n    for i in range(1, n + 1):\n        stirling[i][0] = 0  # S(i, 0) = 0 for i >= 1\n        for j in range(1, i + 1):\n            if j == i:\n                stirling[i][j] = 1  # S(i, i) = 1\n            else:\n                stirling[i][j] = stirling[i-1][j-1] + j * stirling[i-1][j]\n\n    # The nth Bell number B_n is the sum of S(n, k) for k from 0 to n\n    bell_n = 0\n    for k in range(n + 1):\n        bell_n += stirling[n][k]\n\n    return bell_n"}
