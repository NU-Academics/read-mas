{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    sum_of_naturals = n * (n + 1) // 2\n    sum_of_cubes = sum_of_naturals * sum_of_naturals # (n*(n+1)/2)^2\n    return sum_of_cubes - sum_of_naturals"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(array: list, size: int) -> int:\n    \"\"\"\n    Counts the number of pairs in an array whose XOR value is odd.\n    An XOR sum is odd if and only if one element is odd and the other is even.\n    \"\"\"\n    odd_count = 0\n    even_count = 0\n\n    for i in range(size):\n        if array[i] % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # The number of pairs with an odd XOR sum is the product of\n    # the count of odd numbers and the count of even numbers.\n    return odd_count * even_count"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string: str) -> str:\n    \"\"\"Toggles the case of all alphabetic characters in a string, preserving non-alphabetic ones.\"\"\"\n    toggled_chars = []\n    for char in input_string:\n        if char.isupper():\n            toggled_chars.append(char.lower())\n        elif char.islower():\n            toggled_chars.append(char.upper())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of the per-digit absolute differences between two integers.\n    Missing digits are treated as zero, and negative numbers are processed by their absolute values.\n    \"\"\"\n    # Convert absolute values of numbers to strings for digit processing\n    s_num1 = str(abs(num1))\n    s_num2 = str(abs(num2))\n\n    # Determine the maximum length to align digits by padding\n    max_len = max(len(s_num1), len(s_num2))\n\n    # Pad the shorter string representations with leading zeros\n    s_num1 = s_num1.zfill(max_len)\n    s_num2 = s_num2.zfill(max_len)\n\n    total_difference = 0\n    # Iterate through the aligned digits and sum their absolute differences\n    for i in range(max_len):\n        digit1 = int(s_num1[i])\n        digit2 = int(s_num2[i])\n        total_difference += abs(digit1 - digit2)\n\n    return total_difference"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr: list[int], n: int) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist in the given list using Kadane's algorithm.\n    It correctly handles arrays with negative numbers and ensures an O(n) time complexity.\n    \"\"\"\n    max_so_far = arr[0]  # Stores the maximum sum found globally.\n    current_max = arr[0] # Stores the maximum sum ending at the current position.\n\n    # Iterate through the array starting from the second element.\n    for i in range(1, n):\n        # Update current_max: either extend the previous subarray or start a new one with the current element.\n        current_max = max(arr[i], current_max + arr[i])\n        \n        # Update max_so_far if current_max is greater.\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
