{"task_id": "Mbpp/643", "solution": "def text_match_wordz_middle(input_string: str) -> bool:\n    \"\"\"\n    Checks if any word in the input string contains 'z' in its middle characters,\n    excluding the first and last characters.\n    \"\"\"\n    import re\n\n    # Helper function to parse words from the input string\n    def _parse_words(text: str) -> list[str]:\n        # Split the string by non-alphanumeric characters to get words.\n        # This handles punctuation and spaces, and keeps only word characters.\n        return [word for word in re.findall(r'\\b\\w+\\b', text.lower()) if word]\n\n    # Helper function to check if a word contains 'z' in its middle\n    def _check_middle_z(word: str) -> bool:\n        # A word must have at least 3 characters to have a 'middle'.\n        if len(word) < 3:\n            return False\n        # The middle part of the word excludes the first and last characters.\n        middle_chars = word[1:-1]\n        return 'z' in middle_chars\n\n    words = _parse_words(input_string)\n    for word in words:\n        if _check_middle_z(word):\n            return True\n    return False"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(array: list, position: int) -> list:\n    \"\"\"\n    Reverse array elements from index 0 up to specified position (exclusive).\n    Returns a new list with the reversed portion followed by unchanged elements.\n    \"\"\"\n    if not (0 <= position <= len(array)):\n        raise ValueError(\"Position must be non-negative and not exceed array length.\")\n\n    # Slice the array into two parts: the part to be reversed and the rest.\n    # The part to be reversed is from index 0 up to 'position' (exclusive).\n    part_to_reverse = array[:position]\n    remaining_part = array[position:]\n\n    # Reverse the first part.\n    reversed_part = part_to_reverse[::-1]\n\n    # Concatenate the reversed part with the remaining, unchanged part.\n    return reversed_part + remaining_part"}
