{"task_id": "Mbpp/754", "solution": "```python\ndef extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds elements that appear at the same index in all three input lists.\n    Returns a new list containing these common elements.\n    \"\"\"\n    min_length = min(len(l1), len(l2), len(l3))\n    result = []\n    for i in range(min_length):\n        if l1[i] == l2[i] and l2[i] == l3[i]:\n            result.append(l1[i])\n    return result\n```"}
{"task_id": "Mbpp/755", "solution": "from typing import List, Union\n\ndef second_smallest(input_list: List[Union[int, float]]) -> Union[int, float, None]:\n    \"\"\"\n    Find the second smallest unique value in a list.\n\n    Args:\n        input_list: List of numerical values\n\n    Returns:\n        Second smallest unique value, or None if fewer than 2 unique values\n    \"\"\"\n    unique_numbers = list(set(input_list)) # Remove duplicates by converting to a set, then back to a list.\n    unique_numbers.sort() # Sort the list of unique numbers in ascending order.\n\n    if len(unique_numbers) < 2: # Handle edge cases: return None if fewer than 2 unique numbers.\n        return None\n    else:\n        return unique_numbers[1] # Return the second element, which is the second smallest unique value."}
{"task_id": "Mbpp/757", "solution": "def _normalize_string(s: str) -> str:\n    \"\"\"Converts a string to lowercase for case-insensitive comparison.\"\"\"\n    return s.lower()\n\ndef _reverse_string(s: str) -> str:\n    \"\"\"Generates the reversed version of a string.\"\"\"\n    return s[::-1]\n\ndef _is_palindrome(s: str) -> bool:\n    \"\"\"Checks if a string is a palindrome.\"\"\"\n    return s == s[::-1]\n\ndef count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"\n    Counts pairs of strings in a list where one string is the reverse of another,\n    excluding palindromic strings from forming pairs.\n    \"\"\"\n    pair_count = 0\n    n = len(string_list)\n\n    # Iterate through each string in the list\n    for i in range(n):\n        s1 = string_list[i]\n        normalized_s1 = _normalize_string(s1)\n        reversed_normalized_s1 = _reverse_string(normalized_s1)\n\n        # Compare s1 with all subsequent strings to find pairs\n        for j in range(i + 1, n):\n            s2 = string_list[j]\n            normalized_s2 = _normalize_string(s2)\n\n            # If s1's reverse matches s2, we found a potential pair\n            if reversed_normalized_s1 == normalized_s2:\n                # Ensure the original normalized_s1 is not a palindrome to count the pair\n                if not _is_palindrome(normalized_s1):\n                    pair_count += 1\n    \n    return pair_count"}
{"task_id": "Mbpp/758", "solution": "from typing import List, Dict, Tuple\n\ndef _convert_to_tuple(sublist: List) -> Tuple:\n    \"\"\"Convert a sublist to tuple preserving order.\"\"\"\n    return tuple(sublist)\n\ndef _count_occurrences(tuples: List[Tuple]) -> Dict[Tuple, int]:\n    \"\"\"Count occurrences of tuples in list.\"\"\"\n    counts = {}\n    for tpl in tuples:\n        counts[tpl] = counts.get(tpl, 0) + 1\n    return counts\n\ndef unique_sublists(input_list: List[List]) -> Dict[Tuple, int]:\n    \"\"\"Count occurrences of sublists converted to tuples.\"\"\"\n    converted_tuples = []\n    for sublist in input_list:\n        converted_tuples.append(_convert_to_tuple(sublist))\n    return _count_occurrences(converted_tuples)"}
{"task_id": "Mbpp/759", "solution": "def is_decimal(input_string: str) -> bool:\n    \"\"\"Checks if a string represents a positive decimal number with exactly two decimal places.\"\"\"\n    if not input_string:\n        return False\n\n    # A valid decimal must contain exactly one dot.\n    if input_string.count('.') != 1:\n        return False\n\n    integer_part, fractional_part = input_string.split('.')\n\n    # The integer part must be non-empty and contain only digits.\n    if not integer_part or not integer_part.isdigit():\n        return False\n\n    # The fractional part must have exactly two digits and contain only digits.\n    if len(fractional_part) != 2 or not fractional_part.isdigit():\n        return False\n\n    return True"}
