{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list: list, sublist: list) -> bool:\n    \"\"\"\n    Check if sublist appears as contiguous sequence in main_list.\n    Compares elements directly to achieve O(1) additional space.\n    \"\"\"\n    if not sublist:\n        return True\n\n    n_main = len(main_list)\n    n_sub = len(sublist)\n\n    if n_sub > n_main:\n        return False\n\n    for i in range(n_main - n_sub + 1):\n        match = True\n        for j in range(n_sub):\n            if main_list[i + j] != sublist[j]:\n                match = False\n                break\n        if match:\n            return True\n\n    return False"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(input_list: list) -> list:\n    \"\"\"Sorts a list of elements using the comb sort algorithm.\n\n    Returns a new list with elements sorted in ascending order.\n    \"\"\"\n    arr = list(input_list)\n    n = len(arr)\n\n    gap = n\n    swapped = True\n\n    while gap > 1 or swapped:\n        # Calculate the next gap value.\n        gap = int(gap / 1.3)\n        if gap < 1:\n            gap = 1\n\n        swapped = False # Reset swapped for this pass.\n\n        # Perform a single pass with the current gap.\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                # Swap elements if they are out of order.\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n\n    return arr"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(array1, array2):\n    \"\"\"\n    Checks if two arrays follow the same pattern structure.\n    Returns True if patterns match, False otherwise.\n    \"\"\"\n    if len(array1) != len(array2):\n        return False\n\n    def _map_to_pattern(arr):\n        \"\"\"Maps array elements to a numeric pattern representation.\"\"\"\n        mapping = {}\n        pattern = []\n        next_index = 0\n        for item in arr:\n            if item not in mapping:\n                mapping[item] = next_index\n                next_index += 1\n            pattern.append(mapping[item])\n        return pattern\n\n    pattern1 = _map_to_pattern(array1)\n    pattern2 = _map_to_pattern(array2)\n\n    # _compare_patterns is implicitly handled by direct comparison of the generated lists\n    return pattern1 == pattern2"}
