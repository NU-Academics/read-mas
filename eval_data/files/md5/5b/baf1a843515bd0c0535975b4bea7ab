{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"Checks if a given number is undulating.\n\n    An undulating number has at least 3 digits and alternates between exactly two different digit values.\n    \"\"\"\n    if number < 0:\n        number = abs(number)\n\n    s_number = str(number)\n    digits = [int(d) for d in s_number]\n\n    if len(digits) < 3:\n        return False\n\n    unique_digits = sorted(list(set(digits)))\n    if len(unique_digits) != 2:\n        return False\n\n    # Check for alternating pattern\n    first_digit = digits[0]\n    second_digit = digits[1]\n    \n    if first_digit == second_digit: # An undulating number must start with two different digits\n        return False\n\n    for i in range(len(digits)):\n        if i % 2 == 0:\n            if digits[i] != first_digit:\n                return False\n        else:\n            if digits[i] != second_digit:\n                return False\n\n    return True"}
{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"Calculates the number of divisors for a given integer n.\"\"\"\n\n    def _count_divisors_helper(num: int) -> int:\n        count = 0\n        i = 1\n        while i * i <= num:\n            if num % i == 0:\n                if i * i == num:\n                    count += 1\n                else:\n                    count += 2\n            i += 1\n        return count\n\n    return _count_divisors_helper(n)"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(numbers):\n    \"\"\"\n    Multiplies all numbers in a collection and divides the product by the collection's length.\n    Handles lists and tuples containing integers or floats, including negative values.\n    \"\"\"\n    if not numbers:\n        return 0.0  # Or raise an error for empty input, but per instructions, handle gracefully.\n\n    product = 1.0\n    for num in numbers:\n        product *= num\n\n    return product / len(numbers)"}
{"task_id": "Mbpp/97", "solution": "def frequency_lists(list_of_lists):\n    \"\"\"\n    Flattens a list of lists and calculates the frequency of each element.\n    Returns a dictionary mapping each element to its count.\n    \"\"\"\n    flattened_list = []\n    for sublist in list_of_lists:\n        for item in sublist:\n            flattened_list.append(item)\n\n    frequency_map = {}\n    for item in flattened_list:\n        frequency_map[item] = frequency_map.get(item, 0) + 1\n\n    return frequency_map"}
