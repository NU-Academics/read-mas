{"task_id": "Mbpp/619", "solution": "def move_num(input_string: str) -> str:\n    \"\"\"\n    Move all numeric characters to the end of the given string.\n    This function separates digits from non-digits while preserving their original relative order.\n    \"\"\"\n    non_numeric_chars = []\n    numeric_chars = []\n    for char in input_string:\n        if char.isdigit():\n            numeric_chars.append(char)\n        else:\n            non_numeric_chars.append(char)\n    return \"\".join(non_numeric_chars) + \"\".join(numeric_chars)"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers):\n    \"\"\"\n    Finds the size of the largest subset of numbers where every pair is divisible.\n    The divisibility means for any two numbers a, b in the subset (with a <= b), b % a == 0.\n    \"\"\"\n    # Validation Layer: Input validation and edge case handling\n    if not numbers:\n        return 0\n    if len(numbers) == 1:\n        return 1\n\n    # DivisibilityChecker Component: is_divisible_pair\n    def _is_divisible_pair(smaller, larger):\n        \"\"\"Checks if 'larger' is divisible by 'smaller', assuming smaller <= larger.\"\"\"\n        if smaller == 0:\n            # If the smaller number is 0, the pair is valid only if the larger is also 0.\n            # 0 cannot divide a non-zero number.\n            return larger == 0\n        return larger % smaller == 0\n\n    # DivisibilityChecker Component: check_all_pairs_divisible\n    def _check_all_pairs_divisible(subset):\n        \"\"\"Validates if all pairs in a subset satisfy the divisibility property.\"\"\"\n        if len(subset) < 2:\n            return True # Subsets with 0 or 1 element are trivially valid.\n\n        # Sorting the subset allows checking only 'larger % smaller == 0'.\n        sorted_subset = sorted(subset)\n\n        for i in range(len(sorted_subset)):\n            for j in range(i + 1, len(sorted_subset)):\n                # Use _is_divisible_pair for each pair (sorted_subset[i], sorted_subset[j]).\n                if not _is_divisible_pair(sorted_subset[i], sorted_subset[j]):\n                    return False\n        return True\n\n    # SubsetAnalyzer Component: generate_subsets\n    def _generate_subsets(arr):\n        \"\"\"Generates all possible subsets of the input list.\"\"\"\n        subsets = [[]]\n        for item in arr:\n            new_subsets = []\n            for s in subsets:\n                new_subsets.append(s + [item])\n            subsets.extend(new_subsets)\n        return subsets\n\n    # Computation Layer: find_largest_valid_subset logic\n    all_subsets = _generate_subsets(numbers)\n    \n    max_size = 0\n    for subset in all_subsets:\n        if _check_all_pairs_divisible(subset):\n            max_size = max(max_size, len(subset))\n            \n    return max_size"}
{"task_id": "Mbpp/622", "solution": "def merge_sorted_lists(list1, list2):\n    \"\"\"Merges two sorted lists into a single sorted list.\"\"\"\n    merged_list = []\n    i, j = 0, 0\n    n1, n2 = len(list1), len(list2)\n\n    while i < n1 and j < n2:\n        if list1[i] <= list2[j]:\n            merged_list.append(list1[i])\n            i += 1\n        else:\n            merged_list.append(list2[j])\n            j += 1\n\n    merged_list.extend(list1[i:])\n    merged_list.extend(list2[j:])\n    return merged_list\n\ndef find_median_from_merged(merged_list):\n    \"\"\"Calculates the median from a single sorted list.\"\"\"\n    n = len(merged_list)\n    if n % 2 == 1:\n        return float(merged_list[n // 2])\n    else:\n        mid1 = merged_list[n // 2 - 1]\n        mid2 = merged_list[n // 2]\n        return (float(mid1) + float(mid2)) / 2.0\n\ndef get_median(list1, list2, size):\n    \"\"\"Finds the median of two sorted lists of the same size.\"\"\"\n    merged = merge_sorted_lists(list1, list2)\n    return find_median_from_merged(merged)"}
{"task_id": "Mbpp/623", "solution": "def nth_nums(numbers, n):\n    \"\"\"Computes the n-th power of each number in a list.\n    It iterates through the input list and raises each element to the specified power n.\"\"\"\n    result = []\n    for number in numbers:\n        result.append(number ** n)\n    return result"}
