{"task_id": "Mbpp/589", "solution": "import math\n\ndef perfect_squares(start: int, end: int) -> list:\n    \"\"\"Write a function to find perfect squares between two given numbers.\"\"\"\n\n    def is_perfect_square(number: int) -> bool:\n        \"\"\"Determines if a given number is a perfect square.\n        Handles non-negative integers.\n        \"\"\"\n        if number < 0:\n            return False\n        if number == 0:\n            return True\n        \n        sqrt_num = int(math.sqrt(number))\n        return sqrt_num * sqrt_num == number\n\n    def find_squares_in_range(start_val: int, end_val: int) -> list:\n        \"\"\"Finds all perfect squares within the specified range by checking each number.\"\"\"\n        perfect_squares_list = []\n        for num in range(start_val, end_val + 1):\n            if is_perfect_square(num):\n                perfect_squares_list.append(num)\n        return perfect_squares_list\n\n    return find_squares_in_range(start, end)"}
{"task_id": "Mbpp/590", "solution": "import math\n\ndef polar_rect(radius, theta):\n    \"\"\"\n    Convert polar coordinates to rectangular coordinates.\n    Returns a tuple containing ((x, y), complex_number).\n    \"\"\"\n    x = radius * math.cos(theta)\n    y = radius * math.sin(theta)\n\n    rectangular_coords = (x, y)\n    complex_representation = complex(x, y)\n\n    return (rectangular_coords, complex_representation)"}
