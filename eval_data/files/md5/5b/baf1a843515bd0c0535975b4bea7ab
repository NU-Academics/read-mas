{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"Main function that finds numbers divisible by all their digits within a range.\"\"\"\n    \n    def extract_digits(number: int) -> list[int]:\n        \"\"\"Helper function for digit extraction.\"\"\"\n        if number == 0:\n            return [0]\n        digits = []\n        temp_num = abs(number)\n        while temp_num > 0:\n            digits.append(temp_num % 10)\n            temp_num //= 10\n        return digits[::-1] # Reverse to get correct order\n\n    def is_divisible_by_all_digits(number: int, digits: list[int]) -> bool:\n        \"\"\"Helper function to check if number is divisible by all its digits.\"\"\"\n        for digit in digits:\n            if number % digit != 0:\n                return False\n        return True\n\n    def contains_zero(digits: list[int]) -> bool:\n        \"\"\"Helper function to check if digit list contains zero.\"\"\"\n        return 0 in digits\n\n    result = []\n    for num in range(startnum, endnum + 1):\n        digits = extract_digits(num)\n        if contains_zero(digits):\n            continue\n        if is_divisible_by_all_digits(num, digits):\n            result.append(num)\n    return result"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_string: str) -> str:\n    \"\"\"Processes strings by inserting spaces before capital letters that follow lowercase letters or digits.\"\"\"\n\n    def _is_capital_letter(char: str) -> bool:\n        \"\"\"Determines if a character is an uppercase letter.\"\"\"\n        return char.isupper()\n\n    def _is_lowercase_or_digit(char: str) -> bool:\n        \"\"\"Determines if a character is a lowercase letter or a digit.\"\"\"\n        return char.islower() or char.isdigit()\n\n    def _requires_space_before(current_char: str, previous_char: str) -> bool:\n        \"\"\"Determines if a space should be inserted before the current character.\"\"\"\n        return _is_capital_letter(current_char) and _is_lowercase_or_digit(previous_char)\n\n    if not input_string:\n        return \"\"\n\n    result_chars = [input_string[0]]\n\n    for i in range(1, len(input_string)):\n        current_char = input_string[i]\n        previous_char = input_string[i-1]\n\n        if _requires_space_before(current_char, previous_char):\n            result_chars.append(' ')\n        \n        result_chars.append(current_char)\n\n    return \"\".join(result_chars)"}
