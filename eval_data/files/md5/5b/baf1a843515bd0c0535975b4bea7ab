{"task_id": "Mbpp/803", "solution": "import math\n\ndef is_perfect_square(number):\n    \"\"\"\n    Checks if the given number is a perfect square according to the definition\n    where the square root must be an integer.\n    Handles both integers and floating-point numbers.\n    \"\"\"\n    if number < 0:\n        return False\n    \n    # Calculate the square root of the number.\n    sqrt_num = math.sqrt(number)\n    \n    # Check if the square root is effectively an integer by comparing it to its\n    # nearest rounded integer value with a small tolerance for floating-point inaccuracies.\n    # If sqrt_num is an integer (e.g., 5.0), round(sqrt_num) will be 5, and they'll be close.\n    # If sqrt_num is not an integer (e.g., 3.16), round(sqrt_num) will be 3, and they won't be close.\n    return math.isclose(sqrt_num, round(sqrt_num), abs_tol=1e-9)"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers):\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    Returns True if the product is even, False otherwise.\n    \"\"\"\n\n    def _calculate_product(nums):\n        \"\"\"Calculates the mathematical product of all numbers in the list.\"\"\"\n        product = 1\n        for num in nums:\n            product *= num\n        return product\n\n    def _is_even(number):\n        \"\"\"Determines if a given number is even.\"\"\"\n        # This handles integers (positive, negative, zero) and float values.\n        return number % 2 == 0\n\n    # The product of an empty list is conventionally 1 (multiplicative identity).\n    # Since 1 is odd, we return False for an empty list.\n    if not numbers:\n        return False\n\n    product_value = _calculate_product(numbers)\n    return _is_even(product_value)"}
{"task_id": "Mbpp/805", "solution": "from typing import List, Union\n\nNumber = Union[int, float]\n\ndef max_sum_list(input_lists: List[List[Number]]) -> List[Number]:\n    \"\"\"\n    Returns the list with the highest sum of elements from a list of lists.\n    The complete inner list with the highest sum of elements is returned.\n    \"\"\"\n    if not input_lists:\n        return None\n\n    max_list_found = input_lists[0]\n    max_sum_val = sum(input_lists[0])\n\n    for current_list in input_lists[1:]:\n        current_sum = sum(current_list)\n        if current_sum > max_sum_val:\n            max_sum_val = current_sum\n            max_list_found = current_list\n\n    return max_list_found"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Finds the maximum run of consecutive uppercase characters in the given string.\n    Returns 0 if the string is empty or contains no uppercase characters.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in input_string:\n        if char.isupper():\n            current_run += 1\n            if current_run > max_run:\n                max_run = current_run\n        else:\n            current_run = 0\n    return max_run"}
