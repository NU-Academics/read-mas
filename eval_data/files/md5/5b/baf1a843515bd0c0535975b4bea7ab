{"task_id": "Mbpp/730", "solution": "from typing import List\n\ndef consecutive_duplicates(input_list: List) -> List:\n    \"\"\"\n    Remove consecutive duplicate elements from the input list.\n    Preserves the order and non-consecutive duplicates.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = [input_list[0]]\n    for i in range(1, len(input_list)):\n        if input_list[i] != result[-1]:\n            result.append(input_list[i])\n    return result"}
{"task_id": "Mbpp/731", "solution": "def lateralsurface_cone(r, h):\n    \"\"\"\n    Calculates the lateral surface area of a cone.\n    The formula used is \u03c0 * r * sqrt(r^2 + h^2).\n    \"\"\"\n    import math\n    \n    # Calculate the slant height (l = sqrt(r^2 + h^2))\n    slant_height = math.sqrt(r**2 + h**2)\n    \n    # Calculate the lateral surface area (A = \u03c0 * r * l)\n    lateral_surface_area = math.pi * r * slant_height\n    \n    return lateral_surface_area"}
{"task_id": "Mbpp/732", "solution": "def replace_specialchar(input_string: str) -> str:\n    \"\"\"\n    Replaces all occurrences of spaces, commas, or dots with a colon in the given string.\n    Processes replacements sequentially for each specified character.\n    \"\"\"\n    modified_string = input_string.replace(' ', ':')\n    modified_string = modified_string.replace(',', ':')\n    modified_string = modified_string.replace('.', ':')\n    return modified_string"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array: list[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array using binary search.\n    Returns the index of the first occurrence, or -1 if the target is not found.\n    \"\"\"\n    left, right = 0, len(array) - 1\n    result = -1\n\n    while left <= right:\n        mid = left + (right - left) // 2\n\n        if array[mid] == target:\n            result = mid\n            right = mid - 1  # Found a match, but continue searching left for an earlier occurrence\n        elif array[mid] < target:\n            left = mid + 1\n        else:  # array[mid] > target\n            right = mid - 1\n            \n    return result"}
{"task_id": "Mbpp/734", "solution": "def _generate_sublists(input_list):\n    \"\"\"Generates all contiguous sublists from the input list.\"\"\"\n    sublists = []\n    n = len(input_list)\n    for i in range(n):\n        for j in range(i, n):\n            sublists.append(input_list[i : j + 1])\n    return sublists\n\ndef _calculate_product(sublist):\n    \"\"\"Calculates the product of elements in a single sublist.\"\"\"\n    if not sublist:\n        return 1\n    product = 1\n    for item in sublist:\n        product *= item\n    return product\n\ndef _sum_products(products):\n    \"\"\"Sums all individual sublist products.\"\"\"\n    return sum(products)\n\ndef sum_Of_Subarray_Prod(input_list):\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists of a given list.\n    This function generates all sublists, computes the product for each, and then sums these products.\n    \"\"\"\n    all_sublists = _generate_sublists(input_list)\n    \n    all_products = []\n    for sublist in all_sublists:\n        all_products.append(_calculate_product(sublist))\n        \n    total_sum = _sum_products(all_products)\n    \n    return total_sum"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"\n    Toggle all middle bits of the input number except first and last bit.\n\n    Args:\n        number (int): Input integer to process\n\n    Returns:\n        int: Modified integer with middle bits toggled\n    \"\"\"\n    length = number.bit_length()\n\n    if length <= 2:\n        # If the number has 0, 1, or 2 bits, there are no \"middle\" bits to toggle.\n        toggle_mask = 0\n    else:\n        # Create a mask with 1s for all bits except the MSB and LSB.\n        # This is equivalent to (1 << (length - 1)) - 2.\n        # Example for length=4: (1 << 3) - 2 = 8 - 2 = 6 (0b0110)\n        toggle_mask = (1 << (length - 1)) - 2\n\n    return number ^ toggle_mask"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(array: list[int], target: int) -> int:\n    \"\"\"\n    Find the leftmost insertion point for target in a sorted array using binary search.\n    This function returns the index where the target should be inserted to maintain sorted order.\n    \"\"\"\n    low = 0\n    high = len(array)\n\n    while low < high:\n        mid = low + (high - low) // 2\n        if array[mid] < target:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/737", "solution": "import re\n\ndef check_str(input_string: str) -> bool:\n    \"\"\"Check if the string starts with a vowel using regex.\n    Handles empty strings by returning False.\n    \"\"\"\n    if not input_string:\n        return False\n    \n    # Define a regex pattern for a vowel at the start of the string, case-insensitive.\n    # The ^ anchor ensures it matches only at the beginning.\n    vowel_pattern = re.compile(r'^[aeiouAEIOU]')\n    \n    # Use re.match to check if the beginning of the string matches the pattern.\n    return bool(vowel_pattern.match(input_string))"}
{"task_id": "Mbpp/739", "solution": "def find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with exactly n digits.\n    It iteratively calculates triangular numbers until one with n digits is found.\n    \"\"\"\n    def calculate_triangular_number(k: int) -> int:\n        \"\"\"Calculates the triangular number for a given index k.\"\"\"\n        return k * (k + 1) // 2\n\n    def count_digits(number: int) -> int:\n        \"\"\"Counts the number of digits in a given integer.\"\"\"\n        if number == 0:\n            return 1\n        return len(str(number))\n\n    k = 1\n    while True:\n        triangular_num = calculate_triangular_number(k)\n        num_digits = count_digits(triangular_num)\n        if num_digits == n:\n            return k\n        k += 1"}
