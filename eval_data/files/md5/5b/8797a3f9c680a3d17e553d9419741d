{"task_id": "HumanEval/30", "solution": "def get_positive(l: list[int]) -> list[int]:\n    \"\"\"\n    Returns a new list containing only the positive numbers from the input list.\n\n    This function iterates through the given list of integers and filters out\n    any numbers that are greater than 0, collecting them into a new list.\n\n    Args:\n        l: A list of integers.\n\n    Returns:\n        A new list containing only integers greater than 0 from the input list.\n        The order of positive numbers is maintained.\n\n    Examples:\n        >>> get_positive([1, -2, 3, 0, 4, -5])\n        [1, 3, 4]\n        >>> get_positive([])\n        []\n        >>> get_positive([-1, -2, -3, 0])\n        []\n        >>> get_positive([5, 10, 15])\n        [5, 10, 15]\n    \"\"\"\n    return [x for x in l if x > 0]\n\n\nif __name__ == \"__main__\":\n    # Demonstrate the function with examples based on the docstring\n    print(\"--- Demonstrating get_positive function ---\")\n    examples = [\n        [1, -2, 3, 0, 4, -5],\n        [],\n        [-1, -2, -3, 0],\n        [5, 10, 15],\n        [0, -7, 8, 1, -20, 33, 0, 2],\n    ]\n    for i, example in enumerate(examples, 1):\n        print(f\"Example {i}: Input: {example}\")\n        print(f\"Output: {get_positive(example)}\")\n        print(\"-\" * 30)\n    print(\"--- Demonstration complete ---\")"}
{"task_id": "HumanEval/31", "solution": "import math\nimport doctest\nfrom typing import Optional\n\ndef is_prime(n: int) -> bool:\n    \"\"\"\n    Checks if a given integer 'n' is a prime number.\n\n    A prime number is a natural number greater than 1 that has no positive\n    divisors other than 1 and itself.\n    Handles edge cases for n <= 1 by returning False.\n    Checks divisibility by 2 separately for efficiency.\n    Then, iterates through odd divisors up to the square root of n.\n\n    >>> is_prime(0)\n    False\n    >>> is_prime(1)\n    False\n    >>> is_prime(2)\n    True\n    >>> is_prime(3)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(5)\n    True\n    >>> is_prime(7)\n    True\n    >>> is_prime(9)\n    False\n    >>> is_prime(11)\n    True\n    >>> is_prime(13)\n    True\n    >>> is_prime(25)\n    False\n    >>> is_prime(49)\n    False\n    >>> is_prime(97)\n    True\n    >>> is_prime(100)\n    False\n    >>> is_prime(-5)\n    False\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    limit = int(math.sqrt(n)) + 1\n    for i in range(3, limit, 2):\n        if n % i == 0:\n            return False\n    return True\n\nif __name__ == \"__main__\":\n    doctest.testmod()"}
{"task_id": "HumanEval/32", "solution": "import math\nfrom typing import List\n\n\ndef poly(xs: List[float], x: float) -> float:\n    \"\"\"Evaluate a polynomial with coefficients xs at point x.\n\n    Parameters\n    ----------\n    xs : List[float]\n        Coefficients of the polynomial in ascending order.  The coefficient\n        of x**i is xs[i].\n    x : float\n        The point at which to evaluate the polynomial.\n\n    Returns\n    -------\n    float\n        The value of the polynomial at x.\n    \"\"\"\n    return sum(coeff * math.pow(x, i) for i, coeff in enumerate(xs))\n\n\ndef find_zero(xs: List[float]) -> float:\n    \"\"\"Find one real zero of a polynomial.\n\n    The function assumes that *xs* contains an odd degree polynomial\n    (i.e. the number of coefficients is even) and that the leading\n    coefficient is non\u2011zero.  Under these conditions the Fundamental\n    Theorem of Algebra guarantees at least one real root.\n\n    The algorithm searches for a sign change in the polynomial values\n    between two symmetric bounds, then applies a bisection method to\n    refine the root.\n\n    Parameters\n    ----------\n    xs : List[float]\n        Coefficients of the polynomial in ascending order.\n\n    Returns\n    -------\n    float\n        A real root of the polynomial.\n\n    Examples\n    --------\n    >>> round(find_zero([1, 2]), 2)\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2)\n    1.0\n    \"\"\"\n    # Helper to evaluate polynomial\n    def f(val: float) -> float:\n        return poly(xs, val)\n\n    # Start with symmetric bounds\n    low = -1.0\n    high = 1.0\n    step = 1.0\n    # Expand bounds until we find opposite signs or a zero at a bound\n    while f(low) * f(high) > 0:\n        if f(low) == 0:\n            return low\n        if f(high) == 0:\n            return high\n\n        low -= step\n        high += step\n        step *= 2\n        if step > 1e12:\n            raise ValueError(\"Unable to find bounds with sign change within reasonable range.\")\n\n    # If either bound is exactly zero, return it\n    if f(low) == 0:\n        return low\n    if f(high) == 0:\n        return high\n\n    # Bisection method\n    tolerance = 1e-12\n    max_iter = 200\n\n    for _ in range(max_iter):\n        mid = (low + high) / 2\n        f_mid = f(mid)\n\n        if abs(f_mid) < tolerance:\n            return mid\n\n        if abs(high - low) < tolerance:\n            return (low + high) / 2\n\n        if f(low) * f_mid <= 0:\n            high = mid\n        else:\n            low = mid\n\n    return (low + high) / 2"}
{"task_id": "HumanEval/33", "solution": "from typing import List\n\ndef sort_third(l: List[int]) -> List[int]:\n    \"\"\"\n    Return a new list where elements at indices divisible by three\n    are sorted, and other positions remain unchanged.\n    \n    Parameters\n    ----------\n    l : List[int]\n        Input list of integers.\n    \n    Returns\n    -------\n    List[int]\n        A new list with the third-indexed elements sorted.\n    \n    Examples\n    --------\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    # Find positions where the index is divisible by 3\n    third_indices = [i for i in range(len(l)) if i % 3 == 0]\n    \n    # Extract and sort the values at these positions\n    sorted_third_values = sorted(l[i] for i in third_indices)\n    \n    # Build the result list by copying the original and replacing sorted values\n    result = l.copy()\n    for i, val in zip(third_indices, sorted_third_values):\n        result[i] = val\n    \n    return result"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list) -> list:\n    \"\"\"\n    Return sorted unique elements in a list.\n\n    Parameters\n    ----------\n    l : list\n        The list of elements to process.\n\n    Returns\n    -------\n    list\n        A new list containing the unique elements of ``l``, sorted in ascending order.\n\n    Examples\n    --------\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    # Convert the input list to a set to remove duplicates,\n    # then sort the resulting unique values.\n    return sorted(set(l))\n\n\n# If the module is executed directly, run the doctest.\nif __name__ == \"__main__\":\n    import doctest\n    doctest.testmod()\n"}
{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"\n    Return the maximum element of a list.\n\n    Raises:\n        ValueError: If the list is empty.\n\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([3, 1, 2])\n    3\n    >>> max_element([-1, -5, -2])\n    -1\n    >>> max_element([5])\n    5\n    >>> max_element([])\n    Traceback (most recent call last):\n        ...\n    ValueError: max_element() arg is an empty sequence\n    >>> max_element([1.1, 2.2, 0.5])\n    2.2\n    >>> max_element(['apple', 'banana', 'cherry'])\n    'cherry'\n    >>> max_element(['zoo', 'apple', 'banana'])\n    'zoo'\n    \"\"\"\n    if not l:\n        raise ValueError(\"max_element() arg is an empty sequence\")\n    return max(l)"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int) -> int:\n    \"\"\"\n    Return the number of times the digit 7 appears in integers less than ``n`` that are\n    divisible by 11 or 13.\n\n    Parameters\n    ----------\n    n : int\n        The upper bound (exclusive) for the range of integers to consider.\n\n    Examples\n    --------\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    if n <= 0:\n        return 0\n\n    count = 0\n    for num in range(1, n):\n        if num % 11 == 0 or num % 13 == 0:\n            count += str(num).count(\"7\")\n    return count)"}
{"task_id": "HumanEval/37", "solution": "from typing import List, Any\n\ndef sort_even(l: List[Any]) -> List[Any]:\n    \"\"\"\n    Return a copy of ``l`` where elements at even indices are sorted, while odd indices remain unchanged.\n\n    Parameters\n    ----------\n    l : List[Any]\n        The input list.\n\n    Returns\n    -------\n    List[Any]\n        A new list with even-index elements sorted.\n\n    Examples\n    --------\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    >>> sort_even([])\n    []\n    >>> sort_even([10])\n    [10]\n    >>> sort_even([9, 1, 5, 2, 7])\n    [5, 1, 7, 2, 9]\n    \"\"\"\n    if not l:\n        return []\n\n    # Extract elements at even indices and sort them\n    even_indices = list(range(0, len(l), 2))\n    even_values = sorted(l[i] for i in even_indices)\n\n    # Build the result list\n    result = l.copy()\n    for idx, val in zip(even_indices, even_values):\n        result[idx] = val\n\n    return result\n\n# Run doctests if this module is executed directly\nif __name__ == \"__main__\":\n    import doctest\n    doctest.testmod()\n"}
{"task_id": "HumanEval/38", "solution": "from __future__ import annotations\n\n__all__ = [\"encode_cyclic\", \"decode_cyclic\"]\n\n\ndef encode_cyclic(s: str) -> str:\n    \"\"\"Encodes a string by cyclically left-shifting groups of 3 characters.\n\n    Groups shorter than 3 characters are left unchanged.\n\n    Args:\n        s: The input string to encode.\n\n    Returns:\n        The cyclically encoded string.\n    \"\"\"\n    return \"\".join(\n        (\n            (s[i + 1] + s[i + 2] + s[i]) if (i + 2 < len(s)) else s[i:i + 3]\n            for i in range(0, len(s), 3)\n        )\n    )\n\n\ndef decode_cyclic(s: str) -> str:\n    \"\"\"Decodes a string by cyclically right-shifting groups of 3 characters.\n\n    Groups shorter than 3 characters are left unchanged. This reverses\n    the encoding performed by `encode_cyclic`.\n\n    Args:\n        s: The cyclically encoded string to decode.\n\n    Returns:\n        The original string.\n    \"\"\"\n    return \"\".join(\n        (\n            (s[i + 2] + s[i] + s[i + 1]) if (i + 2 < len(s)) else s[i:i + 3]\n            for i in range(0, len(s), 3)\n        )\n    )\n\n\nif __name__ == \"__main__\":\n    import unittest\n\n    class TestCyclic(unittest.TestCase):\n        def test_empty(self):\n            self.assertEqual(encode_cyclic(\"\"), \"\")\n            self.assertEqual(decode_cyclic(\"\"), \"\")\n\n        def test_short(self):\n            for s in [\"a\", \"ab\"]:\n                self.assertEqual(encode_cyclic(s), s)\n                self.assertEqual(decode_cyclic(s), s)\n\n        def test_exact_multiple_of_three(self):\n            original = \"abcdefghi\"\n            encoded = encode_cyclic(original)\n            self.assertEqual(encoded, \"bcadefghi\")\n            self.assertEqual(decode_cyclic(encoded), original)\n\n        def test_non_multiple_of_three(self):\n            original = \"abcdefgh\"\n            encoded = encode_cyclic(original)\n            self.assertEqual(encoded, \"bcadefgh\")\n            self.assertEqual(decode_cyclic(encoded), original)\n\n        def test_round_trip_random(self):\n            import random\n            for _ in range(100):\n                length = random.randint(0, 50)\n                original = \"\".join(random.choice(\"abcdefghijklmnopqrstuvwxyz\") for _ in range(length))\n                encoded = encode_cyclic(original)\n                decoded = decode_cyclic(encoded)\n                self.assertEqual(decoded, original)\n\n    unittest.main()"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int) -> int:\n    \"\"\"\n    Return the *n*-th prime number that also appears in the Fibonacci sequence.\n    The sequence begins with 2, 3, 5, 13, 89, ...\n\n    Parameters\n    ----------\n    n : int\n        The position in the list of prime Fibonacci numbers (1\u2011based).\n\n    Raises\n    ------\n    ValueError\n        If *n* is not a positive integer.\n\n    Examples\n    --------\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    def _is_prime(x: int) -> bool:\n        \"\"\"Simple primality test for non\u2011negative integers.\"\"\"\n        if x < 2:\n            return False\n        if x in (2, 3):\n            return True\n        if x % 2 == 0 or x % 3 == 0:\n            return False\n        i = 5\n        w = 2\n        while i * i <= x:\n            if x % i == 0:\n                return False\n            i += w\n            w = 6 - w\n        return True\n\n    # Generate Fibonacci numbers and test for primality\n    count = 0\n    a, b = 0, 1          # starts from 0, 1\n    while True:\n        a, b = b, a + b  # next Fibonacci number\n        if a >= 2 and _is_prime(a):\n            count += 1\n            if count == n:\n                return a\n</details>"}
{"task_id": "HumanEval/40", "solution": "import random\nfrom typing import List, Tuple\n\ndef triples_sum_to_zero(l: List[int]) -> bool:\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n\n    >>> triples_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> triples_sum_to_zero([1, 3, -2, 1])\n    True\n    >>> triples_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> triples_sum_to_zero([2, 4, -5, 3, 9, 7])\n    True\n    >>> triples_sum_to_zero([1])\n    False\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n    l_sorted = sorted(l)\n    for i in range(n - 2):\n        if i > 0 and l_sorted[i] == l_sorted[i - 1]:\n            continue\n        left, right = i + 1, n - 1\n        while left < right:\n            total = l_sorted[i] + l_sorted[left] + l_sorted[right]\n            if total == 0:\n                return True\n            elif total < 0:\n                left += 1\n            else:\n                right -= 1\n    return False\n"}
{"task_id": "HumanEval/41", "solution": "def car_race_collision(n: int) -> int:\n    \"\"\"\n    Compute the total number of collisions between two sets of cars moving in opposite\n    directions on an infinitely long straight line when both sets start far apart.\n\n    Parameters\n    ----------\n    n : int\n        Number of cars in each set. Must be non\u2011negative.\n\n    Returns\n    -------\n    int\n        Number of collisions that will occur.\n\n    Notes\n    -----\n    Since all cars move at the same speed and the two sets start with all left\u2011to\u2011right\n    cars positioned to the left of all right\u2011to\u2011left cars, every left\u2011to\u2011right car\n    collides with every right\u2011to\u2011left car exactly once, leading to n*n collisions.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    return n * n"}
{"task_id": "HumanEval/42", "solution": "import unittest\nfrom typing import List\n\ndef incr_list(l: List[int]) -> List[int]:\n    \"\"\"\n    Return a new list with each integer element incremented by 1.\n\n    Parameters\n    ----------\n    l : List[int]\n        A list of integers.\n\n    Returns\n    -------\n    List[int]\n        A new list where every element is the corresponding element of `l`\n        incremented by 1.\n\n    Raises\n    ------\n    TypeError\n        If `l` is not a list or contains non\u2011integer elements.\n\n    Examples\n    --------\n    >>> incr_list([1, 2, 3])\n    [2, 3, 4]\n    >>> incr_list([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [6, 4, 6, 3, 4, 4, 10, 1, 124]\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list\")\n    if not all(isinstance(x, int) for x in l):\n        raise TypeError(\"All elements in the list must be integers\")\n    return [x + 1 for x in l]\n\n\nclass TestIncrList(unittest.TestCase):\n    def test_simple_case(self):\n        self.assertEqual(incr_list([1, 2, 3]), [2, 3, 4])\n\n    def test_extended_case(self):\n        self.assertEqual(\n            incr_list([5, 3, 5, 2, 3, 3, 9, 0, 123]),\n            [6, 4, 6, 3, 4, 4, 10, 1, 124]\n        )\n\n    def test_empty_list(self):\n        self.assertEqual(incr_list([]), [])\n\n    def test_invalid_type(self):\n        with self.assertRaises(TypeError):\n            incr_list(\"not a list\")\n\n    def test_non_int_elements(self):\n        with self.assertRaises(TypeError):\n            incr_list([1, 2.5, 3])\n\n\nif __name__ == \"__main__\":\n    unittest.main(verbosity=2)"}
{"task_id": "HumanEval/43", "solution": "```python\ndef find_zero_sum_pairs(numbers):\n    \"\"\"\n    Finds all unique pairs of numbers in a given list that sum to zero.\n\n    A pair (a, b) is considered unique if the set of its values {a, b} has not been\n    found before.\n    For example, if the input is [1, -1, 1], only one pair (-1, 1) will be returned.\n    If the input contains multiple zeros, e.g., [0, 0, 0], only one pair (0, 0) will be\n    returned.\n\n    Args:\n        numbers: A list of integers or floats.\n\n    Returns:\n        A list of tuples, where each tuple (a, b) represents a unique zero-sum pair.\n        The numbers within each pair are sorted in ascending order (e.g., (-1, 1)\n        instead of (1, -1)).\n    \"\"\"\n    zero_sum_pairs = []\n    seen_numbers = set()\n    # Use a set of frozensets to efficiently track unique pairs regardless of element order.\n    seen_pairs_set = set() \n\n    for num in numbers:\n        complement = -num\n        if complement in seen_numbers:\n            # A potential zero-sum pair is found.\n            \n            # Sort the pair to ensure a consistent representation (e.g., (-1, 1) rather\n            # than (1, -1)).\n            pair_values_tuple = tuple(sorted((num, complement)))\n            \n            # Create a frozenset for the pair to check for uniqueness, as frozensets\n            # are hashable and treat {a, b} and {b, a} as the same.\n            frozenset_pair = frozenset((num, complement))\n\n            if frozenset_pair not in seen_pairs_set:\n                zero_sum_pairs.append(pair_values_tuple)\n                seen_pairs_set.add(frozenset_pair)\n        # Add the current number to the set of seen numbers for future lookups.\n        seen_numbers.add(num)\n\n    return zero_sum_pairs\n```"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int) -> str:\n    \"\"\"\n    Converts a non-negative integer x to its string representation in a target base.\n\n    Args:\n        x: A non-negative integer.\n        base: The target base, must be between 2 and 9 inclusive.\n\n    Returns:\n        The string representation of x in the specified base.\n\n    Raises:\n        ValueError: If the base is not within the range [2, 9].\n    \"\"\"\n    if not (2 <= base <= 9):\n        raise ValueError(\"Base must be an integer between 2 and 9 inclusive.\")\n\n    if x == 0:\n        return \"0\"\n\n    digits = []\n    while x > 0:\n        remainder = x % base\n        digits.append(str(remainder))\n        x //= base\n\n    return \"\".join(reversed(digits))"}
{"task_id": "HumanEval/45", "solution": "# src/domain/point.py\nclass Point:\n    def __init__(self, x: float, y: float):\n        if not isinstance(x, (int, float)) or not isinstance(y, (int, float)):\n            raise TypeError(\"Coordinates must be numeric.\")\n        self._x = float(x)\n        self._y = float(y)\n\n    @property\n    def x(self) -> float:\n        return self._x\n\n    @property\n    def y(self) -> float:\n        return self._y\n\n    def __repr__(self):\n        return f\"Point(x={self.x}, y={self.y})\"\n\n# src/domain/triangle.py\nclass Triangle:\n    def __init__(\n        self,\n        sideA: float = None,\n        sideB: float = None,\n        sideC: float = None,\n        base: float = None,\n        height: float = None,\n    ):\n        self._sideA = sideA\n        self._sideB = sideB\n        self._sideC = sideC\n        self._base = base\n        self._height = height\n\n    @property\n    def sideA(self) -> float:\n        return self._sideA\n\n    @property\n    def sideB(self) -> float:\n        return self._sideB\n\n    @property\n    def sideC(self) -> float:\n        return self._sideC\n\n    @property\n    def base(self) -> float:\n        return self._base\n\n    @property\n    def height(self) -> float:\n        return self._height\n\n    def is_valid(self) -> bool:\n        # Check for non-positive dimensions for whichever set is provided\n        if (\n            self._sideA is not None\n            and (self._sideA <= 0 or self._sideB <= 0 or self._sideC <= 0)\n        ) or (\n            self._base is not None\n            and (self._base <= 0 or self._height <= 0)\n        ):\n            return False\n\n        # Validate triangle inequality for sides\n        if (\n            self._sideA is not None\n            and self._sideB is not None\n            and self._sideC is not None\n        ):\n            a, b, c = self._sideA, self._sideB, self._sideC\n            if a <= 0 or b <= 0 or c <= 0:\n                return False\n            return (a + b > c) and (a + c > b) and (b + c > a)\n\n        # If base and height are provided, they just need to be positive.\n        if self._base is not None and self._height is not None:\n            if self._base <= 0 or self._height <= 0:\n                return False\n            return True\n\n        # If neither a complete set of sides nor base/height is provided, it's not a valid triangle configuration.\n        return False\n\n    def __repr__(self):\n        if (\n            self._sideA is not None\n            and self._sideB is not None\n            and self._sideC is not None\n        ):\n            return f\"Triangle(sides={self.sideA},{self.sideB},{self.sideC})\"\n        elif self._base is not None and self._height is not None:\n            return f\"Triangle(base={self.base},height={self.height})\"\n        return \"Triangle(incomplete dimensions)\"  # Should not happen if created by factory\n\n# src/domain/triangle_factory.py\nfrom src.domain.triangle import Triangle\n\n\nclass TriangleFactory:\n    @staticmethod\n    def create_with_sides(a: float, b: float, c: float) -> Triangle:\n        return Triangle(sideA=a, sideB=b, sideC=c)\n\n    @staticmethod\n    def create_with_base_height(base: float, height: float) -> Triangle:\n        return Triangle(base=base, height=height)\n\n# src/infrastructure/strategies/area_calculator_strategy.py\nimport abc\nfrom src.domain.triangle import Triangle\n\n\nclass IAreaCalculatorStrategy(abc.ABC):\n    @abc.abstractmethod\n    def calculate(self, triangle: Triangle) -> float:\n        pass\n\n# src/application/area_calculator_service.py\nfrom src.infrastructure.strategies.area_calculator_strategy import IAreaCalculatorStrategy\nfrom src.domain.triangle import Triangle\n\n\nclass AreaCalculatorService:\n    def __init__(self):\n        self._strategy: IAreaCalculatorStrategy | None = None\n\n    def set_strategy(self, strategy: IAreaCalculatorStrategy):\n        # Basic type check to ensure the strategy adheres to the interface\n        if not isinstance(strategy, IAreaCalculatorStrategy):\n            raise TypeError(\n                \"Strategy must implement IAreaCalculatorStrategy interface.\"\n            )\n        self._strategy = strategy\n\n    def compute_area(self, triangle: Triangle) -> float:\n        if self._strategy is None:\n            raise ValueError(\"Area calculation strategy has not been set.\")\n        return self._strategy.calculate(triangle)\n\n# src/application/validation_service.py\nfrom src.domain.triangle import Triangle\n\n\nclass ValidationService:\n    @staticmethod\n    def validate_numeric_input(value_str: str) -> float:\n        try:\n            val = float(value_str)\n            if val <= 0:\n                raise ValueError(\"Input must be a positive number.\")\n            return val\n        except ValueError:\n            raise ValueError(\n                f\"Invalid numeric input: '{value_str}'. Please enter a valid positive number.\"\n            )\n\n    @staticmethod\n    def validate_triangle(triangle: Triangle) -> bool:\n        return triangle.is_valid()\n\n# src/application/output_service.py\nclass OutputService:\n    @staticmethod\n    def format_area(area: float) -> str:\n        return f\"The calculated area is: {area:.2f}\"\n\n# src/infrastructure/strategies/heron_strategy.py\nimport math\nfrom src.infrastructure.strategies.area_calculator_strategy import IAreaCalculatorStrategy\nfrom src.domain.triangle import Triangle\n\n\nclass HeronStrategy(IAreaCalculatorStrategy):\n    def calculate(self, triangle: Triangle) -> float:\n        if not all(\n            x is not None for x in [triangle.sideA, triangle.sideB, triangle.sideC]\n        ):\n            raise ValueError(\n                \"Heron's formula requires three side lengths to be provided.\"\n            )\n\n        # The TriangleController's ValidationService call should generally prevent this,\n        # but a final check within the strategy adds robustness.\n        if not triangle.is_valid():\n            raise ValueError(\"Invalid triangle dimensions for Heron's formula.\")\n\n        a, b, c = triangle.sideA, triangle.sideB, triangle.sideC\n        s = (a + b + c) / 2\n        area_squared = s * (s - a) * (s - b) * (s - c)\n\n        # Floating point inaccuracies can sometimes lead to very small negative values.\n        # Treat them as zero for area calculation, as an area cannot be negative.\n        if area_squared < 1e-9:  # A small epsilon to account for FP error\n            return 0.0\n\n        return math.sqrt(area_squared)\n\n# src/infrastructure/strategies/base_height_strategy.py\nfrom src.infrastructure.strategies.area_calculator_strategy import IAreaCalculatorStrategy\nfrom src.domain.triangle import Triangle\n\n\nclass BaseHeightStrategy(IAreaCalculatorStrategy):\n    def calculate(self, triangle: Triangle) -> float:\n        if triangle.base is None or triangle.height is None:\n            raise ValueError(\n                \"Base/Height formula requires a base and a height to be provided.\"\n            )\n\n        # The TriangleController's ValidationService call should generally prevent this,\n        # but a final check within the strategy adds robustness.\n        if not triangle.is_valid():\n            raise ValueError(\n                \"Invalid triangle dimensions for base and height formula.\"\n            )\n\n        return 0.5 * triangle.base * triangle.height\n\n# src/infrastructure/input_handler.py\nclass InputHandler:\n    @staticmethod\n    def prompt_for_sides() -> tuple[str, str, str]:\n        print(\"\\nEnter the three sides of the triangle:\")\n        a = input(\"Side A: \")\n        b = input(\"Side B: \")\n        c = input(\"Side C: \")\n        return a, b, c\n\n    @staticmethod\n    def prompt_for_base_height() -> tuple[str, str]:\n        print(\"\\nEnter the base and height of the triangle:\")\n        base = input(\"Base: \")\n        height = input(\"Height: \")\n        return base, height\n\n    @staticmethod\n    def prompt_choice() -> str:\n        print(\"\\nChoose an option:\")\n        print(\"1. Calculate area using three sides (Heron's formula)\")\n        print(\"2. Calculate area using base and height\")\n        print(\"3. Exit\")\n        choice = input(\"Enter your choice (1, 2, or 3): \")\n        return choice\n\n    @staticmethod\n    def display_result(message: str):\n        print(message)\n\n    @staticmethod\n    def display_error(message: str):\n        print(f\"\\nError: {message}\")\n\n# src/ui/cli.py\nfrom src.domain.triangle_factory import TriangleFactory\nfrom src.application.area_calculator_service import AreaCalculatorService\nfrom src.application.validation_service import ValidationService\nfrom src.application.output_service import OutputService\nfrom src.infrastructure.strategies.heron_strategy import HeronStrategy\nfrom src.infrastructure.strategies.base_height_strategy import BaseHeightStrategy\nfrom src.infrastructure.input_handler import InputHandler\n\n\nclass TriangleController:\n    def __init__(self):\n        self._input_handler = InputHandler()\n        self._validation_service = ValidationService()\n        self._area_calculator_service = AreaCalculatorService()\n        self._output_service = OutputService()\n        self._triangle_factory = TriangleFactory()\n\n    def _calculate_by_sides(self):\n        try:\n            s_a, s_b, s_c = self._input_handler.prompt_for_sides()\n            a = self._validation_service.validate_numeric_input(s_a)\n            b = self._validation_service.validate_numeric_input(s_b)\n            c = self._validation_service.validate_numeric_input(s_c)\n\n            triangle = self._triangle_factory.create_with_sides(a, b, c)\n\n            if not self._validation_service.validate_triangle(triangle):\n                self._input_handler.display_error(\n                    \"The given side lengths do not form a valid triangle.\"\n                )\n                return\n\n            self._area_calculator_service.set_strategy(HeronStrategy())\n            area = self._area_calculator_service.compute_area(triangle)\n            self._input_handler.display_result(self._output_service.format_area(area))\n        except ValueError as e:\n            self._input_handler.display_error(str(e))\n        except Exception as e:\n            self._input_handler.display_error(\n                f\"An unexpected error occurred: {e}\"\n            )\n\n    def _calculate_by_base_height(self):\n        try:\n            s_base, s_height = self._input_handler.prompt_for_base_height()\n            base = self._validation_service.validate_numeric_input(s_base)\n            height = self._validation_service.validate_numeric_input(s_height)\n\n            triangle = self._triangle_factory.create_with_base_height(base, height)\n\n            # For base/height, positivity is already checked. This keeps alignment with the design step.\n            if not self._validation_service.validate_triangle(triangle):\n                self._input_handler.display_error(\n                    \"Base and height must be positive numbers.\"\n                )\n                return\n\n            self._area_calculator_service.set_strategy(BaseHeightStrategy())\n            area = self._area_calculator_service.compute_area(triangle)\n            self._input_handler.display_result(self._output_service.format_area(area))\n        except ValueError as e:\n            self._input_handler.display_error(str(e))\n        except Exception as e:\n            self._input_handler.display_error(\n                f\"An unexpected error occurred: {e}\"\n            )\n\n    def run(self):\n        print(\"Welcome to the Triangle Area Calculator!\")\n        while True:\n            choice = self._input_handler.prompt_choice()\n            if choice == \"1\":\n                self._calculate_by_sides()\n            elif choice == \"2\":\n                self._calculate_by_base_height()\n            elif choice == \"3\":\n                print(\"Exiting Triangle Area Calculator. Goodbye!\")\n                break\n            else:\n                self._input_handler.display_error(\n                    \"Invalid choice. Please enter 1, 2, or 3.\"\n                )"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int) -> int:\n    \"\"\"\n    Compute the n-th element of the fib4 sequence.\n\n    The fib4 sequence is defined as:\n        fib4(0) -> 0\n        fib4(1) -> 0\n        fib4(2) -> 2\n        fib4(3) -> 0\n        fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4)   for n >= 4\n\n    This implementation uses an iterative approach with O(1) additional space\n    and O(n) time complexity.\n\n    Parameters\n    ----------\n    n : int\n        The index of the element to compute. Must be non\u2011negative.\n\n    Returns\n    -------\n    int\n        The n-th fib4 number.\n\n    Raises\n    ------\n    ValueError\n        If n is negative.\n\n    Examples\n    --------\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    >>> fib4(0)\n    0\n    >>> fib4(2)\n    2\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    base = [0, 0, 2, 0]  # fib4(0), fib4(1), fib4(2), fib4(3)\n    if n < 4:\n        return base[n]\n\n    a, b, c, d = base\n    for _ in range(4, n + 1):\n        next_val = a + b + c + d\n        a, b, c, d = b, c, d, next_val\n    return d"}
{"task_id": "HumanEval/47", "solution": "# median.py\n\"\"\"Utility module for calculating the median of a list of numbers.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import List, Sequence, Union\n\nNumber = Union[int, float]\n\n\ndef median(values: Sequence[Number]) -> float:\n    \"\"\"\n    Return the median of the elements in ``values``.\n    \n    The function does not modify the original input sequence.\n    \n    Parameters\n    ----------\n    values : Sequence[Number]\n        A sequence (e.g., list or tuple) of numeric values.\n    \n    Returns\n    -------\n    float\n        The median value. For an odd number of items the middle element\n        is returned. For an even number of items the average of the two\n        middle elements is returned.\n    \n    Raises\n    ------\n    ValueError\n        If ``values`` is empty or contains non-numeric entries.\n\n    Examples\n    --------\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    if not values:\n        raise ValueError(\"Cannot compute median of an empty sequence\")\n\n    # Ensure all items are numeric\n    try:\n        sorted_values = sorted(values)\n    except TypeError as exc:\n        raise ValueError(\"All items must be numeric\") from exc\n\n    n = len(sorted_values)\n    mid = n // 2\n\n    if n % 2:\n        return float(sorted_values[mid])\n    else:\n        return (sorted_values[mid - 1] + sorted_values[mid]) / 2.0\n\n\n# tests/test_median.py\nimport pytest\nfrom median import median\n\n\ndef test_odd_length():\n    assert median([3, 1, 2, 4, 5]) == 3.0\n\n\ndef test_even_length():\n    assert median([-10, 4, 6, 1000, 10, 20]) == 15.0\n\n\ndef test_single_element():\n    assert median([42]) == 42.0\n\n\ndef test_floats():\n    assert median([1.5, 2.5, 3.5]) == 2.5\n\n\ndef test_empty_raises():\n    with pytest.raises(ValueError):\n        median([])\n\n\ndef test_non_numeric_raises():\n    with pytest.raises(ValueError):\n        median([1, \"a\", 3])\n</details>"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str) -> bool:\n    \"\"\"\n    Checks if the given string is a palindrome.\n\n    This function performs an exact character-by-character comparison\n    from the start and end of the string, moving inward until a mismatch\n    is found or the indices cross. It runs in O(n) time and O(1) space.\n\n    Parameters:\n        text (str): The string to test.\n\n    Returns:\n        bool: True if ``text`` is a palindrome, False otherwise.\n\n    Examples\n    --------\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    left, right = 0, len(text) - 1\n    while left < right:\n        if text[left] != text[right]:\n            return False\n        left += 1\n        right -= 1\n    return True"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int) -> int:\n    \"\"\"\n    Compute (2**n) % p efficiently using binary exponentiation.\n\n    Parameters\n    ----------\n    n : int\n        The exponent, must be non\u2011negative.\n    p : int\n        The modulus, must be a positive integer.\n\n    Returns\n    -------\n    int\n        The remainder after dividing 2**n by p.\n\n    Raises\n    ------\n    ValueError\n        If p is not a positive integer or n is negative.\n\n    Examples\n    --------\n    >>> modp(3, 5)\n    3\n    >>> modp(1101, 101)\n    2\n    >>> modp(0, 101)\n    1\n    >>> modp(3, 11)\n    8\n    >>> modp(100, 101)\n    1\n    \"\"\"\n    if p <= 0:\n        raise ValueError(\"Modulus p must be a positive integer\")\n    if n < 0:\n        raise ValueError(\"Exponent n must be non\u2011negative\")\n\n    result = 1\n    base = 2 % p\n    exponent = n\n    while exponent:\n        if exponent & 1:\n            result = (result * base) % p\n        base = (base * base) % p\n        exponent >>= 1\n    return result\n\n# End of module\n"}
{"task_id": "HumanEval/50", "solution": "def encode_shift(s: str) -> str:\n    \"\"\"\n    Encode a string by shifting every lowercase alphabetic character forward\n    by 5 positions. Characters outside 'a'-'z' will raise a ValueError.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"input must be a string\")\n    for ch in s:\n        if not ('a' <= ch <= 'z'):\n            raise ValueError(\"input string must contain only lowercase letters 'a' to 'z'\")\n    return \"\".join([chr(((ord(ch) + 5 - ord(\"a\")) % 26) + ord(\"a\")) for ch in s])\n\n\ndef decode_shift(s: str) -> str:\n    \"\"\"\n    Decode a string that was encoded with `encode_shift` by shifting each\n    lowercase alphabetic character backward by 5 positions.\n\n    Parameters\n    ----------\n    s : str\n        The encoded string consisting only of lowercase letters 'a'-'z'.\n\n    Returns\n    -------\n    str\n        The decoded, original string.\n\n    Raises\n    ------\n    TypeError\n        If ``s`` is not a string.\n    ValueError\n        If ``s`` contains characters outside the range 'a'-'z'.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"input must be a string\")\n    for ch in s:\n        if not ('a' <= ch <= 'z'):\n            raise ValueError(\"input string must contain only lowercase letters 'a' to 'z'\")\n    return \"\".join([chr(((ord(ch) - 5 - ord(\"a\")) % 26) + ord(\"a\")) for ch in s])"}
{"task_id": "HumanEval/51", "solution": "def remove_vowels(text: str) -> str:\n    \"\"\"\n    Remove all English vowels (case-insensitive) from the input string.\n\n    >>> remove_vowels('')\n    ''\n    >>> remove_vowels(\"abcdef\\\\nghijklm\")\n    'bcdf\\\\nghjklm'\n    >>> remove_vowels('abcdef')\n    'bcdf'\n    >>> remove_vowels('aaaaa')\n    ''\n    >>> remove_vowels('aaBAA')\n    'B'\n    >>> remove_vowels('zbcd')\n    'zbcd'\n    \"\"\"\n    vowels = set(\"aeiouAEIOU\")\n    return \"\".join(char for char in text if char not in vowels)"}
{"task_id": "HumanEval/52", "solution": "def below_threshold(l: list, t: int) -> bool:\n    \"\"\"\n    Return True if all numbers in the list *l* are below the threshold *t*.\n    This function is type\u2011annotated and includes a comprehensive docstring\n    with doctest examples.\n\n    Parameters\n    ----------\n    l : list\n        List of numeric values (int or float). Non\u2011numeric elements will\n        raise a ``ValueError`` to enforce strict type usage.\n    t : int\n        Threshold value to compare against.\n\n    Returns\n    -------\n    bool\n        ``True`` if every element in ``l`` is strictly less than ``t``,\n        otherwise ``False``.\n    \"\"\"\n    if not isinstance(t, (int, float)):\n        raise ValueError(f\"Threshold must be a number, got {t!r}\")\n\n    for idx, x in enumerate(l):\n        if not isinstance(x, (int, float)):\n            raise ValueError(f\"Element at index {idx} is not numeric: {x!r}\")\n        if x >= t:\n            return False\n    return True\n\n# doctest\nif __name__ == \"__main__\":\n    import doctest\n    doctest.testmod()"}
