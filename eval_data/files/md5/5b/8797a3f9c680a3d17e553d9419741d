{"task_id": "HumanEval/25", "solution": "from math import sqrt\nfrom typing import List\n\n\ndef factorize(n: int) -> List[int]:\n    \"\"\"\n    Return a list of prime factors of the given integer in ascending order.\n\n    Each factor appears as many times as it occurs in the prime factorization.\n    If `n` is 1, an empty list is returned. A ValueError is raised for\n    non\u2011positive inputs.\n\n    Examples\n    --------\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    factors: List[int] = []\n\n    # Handle factor 2 separately for efficiency\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    # Check odd divisors up to sqrt(n)\n    divisor = 3\n    limit = int(sqrt(n)) + 1\n    while divisor <= limit and n > 1:\n        while n % divisor == 0:\n            factors.append(divisor)\n            n //= divisor\n            limit = int(sqrt(n)) + 1\n        divisor += 2\n\n    # If remainder is a prime number greater than 2\n    if n > 1:\n        factors.append(n)\n\n    return factors\n\nif __name__ == \"__main__\":\n    import doctest\n    doctest.testmod()"}
{"task_id": "HumanEval/26", "solution": "from typing import List, Dict\n\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\"\n    From a list of integers, remove all elements that occur more than once.\n    Keep the order of the remaining elements the same as in the input.\n\n    Args:\n        numbers: A list of integers.\n\n    Returns:\n        A list containing only the numbers that are unique across the entire input list.\n\n    Examples:\n        >>> remove_duplicates([1, 2, 3, 2, 4])\n        [1, 3, 4]\n    \"\"\"\n    # Count occurrences of each number\n    frequency: Dict[int, int] = {}\n    for num in numbers:\n        frequency[num] = frequency.get(num, 0) + 1\n\n    # Filter numbers that appear exactly once\n    return [num for num in numbers if frequency[num] == 1]"}
