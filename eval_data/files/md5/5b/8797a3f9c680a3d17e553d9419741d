matter(logging.Formatter(\"%(message)s\"))\nlogger.addHandler(handler)\nlogger.setLevel(logging.INFO)\n\n# --------------------------------------------------------------------------- #\n# Env / Secrets\n# --------------------------------------------------------------------------- #\nclass Settings(BaseSettings):\n    \"\"\"Read env vars (e.g. .env).\"\"\"\n\n    model_config = SettingsConfigDict(\n        env_file=\".env\",\n        env_file_encoding=\"utf-8\",\n    )\n\n    app_name: str\n    debug: bool = True\n    port: int = 8000\n    log_level: str = \"INFO\"\n    otel_exporter_otlp_endpoint: str = \"http://localhost:4317\"\n    # Add other env vars / secrets here\n\nsettings = Settings()\n# --------------------------------------------------------------------------- #\n# Pydantic DTOs\n# --------------------------------------------------------------------------- #\nclass CollatzRequest(BaseModel):\n    number: int = Field(\n        ...,\n        title=\"n\",\n        description=\"Positive integer\",\n        example=27,\n    )\n\nclass CollatzResponse(BaseModel):\n    odds: List[int] = Field(\n        description=\"List of odd numbers from the Collatz sequence\",\n    )\n\nclass ValidationErrorDetail(BaseModel):\n    detail: str = Field(\n        ..., examples=[{\"detail\": \"Number must be a positive integer.\"}]\n    )\n\n# --------------------------------------------------------------------------- #\n# Service metrics \u2013 Prometheus\n# --------------------------------------------------------------------------- #\ncollatz_latency_seconds = Summary(\"collatz_latency_seconds\",\n                                 \"Time spent computing the Collatz sequence and filtering odds.\")\ncollatz_computations_total = Counter(\"collatz_computations_total\",\n                                   \"Number of Collatz computations performed\", labelnames=[\"status\"])\n\n# --------------------------------------------------------------------------- #\n# FastAPI app + routes\n# --------------------------------------------------------------------------- #\nfrom fastapi import APIRouter\n\napp = FastAPI(\n    title=settings.app_name,\n    debug=settings.debug,\n    version=\"1.0.0\",\n)\n\ncollatz_router = APIRouter()\n\n@collatz_router.post(\n    \"/collatz/odd\",\n    response_model=CollatzResponse,\n    responses={\n        200: {\"description\": \"Successful response\"},\n        400: {\"model\": ValidationErrorDetail, \"description\": \"Invalid input\"},\n    },\n    tags=[\"CollatzOddService\"],\n)\nasync def compute_collatz_odd(request: CollatzRequest, raw_request: Request):\n    \"\"\"\n    POST /collatz/odd\n    Body: {\"number\": 27}\n    Returns the list of odd numbers from the Collatz (3n+1) sequence of `n`.\n    \"\"\"\n    number = request.number\n\n    # --- Validation --------------------------------------------------------- #\n    try:\n        if number <= 0:\n            raise ValueError(\"Number must be a positive integer greater than 0.\")\n    except ValueError as exc:\n        collatz_computations_total.labels(status=\"error\").inc()\n        # 400 Bad Request with detail\n        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST,\n                            detail=str(exc))\n    # ------------------------------------------------------------------------ #\n\n    # --- Tracing ------------------------------------------------------------ #\n    from opentelemetry import trace\n    tracer = trace.get_tracer(__name__)\n\n    with tracer.start_as_current_span(\"collatz_computation\"):\n        start_ts = time.perf_counter()\n\n        # Generate Collatz sequence\n        def collatz_sequence(n: int):\n            seq = []\n            while True:\n                seq.append(n)\n                if n == 1:\n                    break\n                if n % 2 == 0:\n                    n //= 2\n                else:\n                    n = 3 * n + 1\n            return seq\n\n        # Generate and filter odds\n        collatz_seq = collatz_sequence(number)\n        odds = [num for num in collatz_seq if num % 2 != 0]\n\n        # Record metrics for this request\n        collatz_latency_seconds.observe(time.perf_counter() - start_ts)\n\n    collatz_computations_total.labels(status=\"success\").inc()\n\n    return CollatzResponse(odds=odds)\n\n# Mount router\napp.include_router(collatz_router)\n\n# --------------------------------------------------------------------------- #\n# Health\u2011check\n# --------------------------------------------------------------------------- #\n@app.get(\"/healthz\", tags=[\"Health\"])\nasync def health_check():\n    \"\"\"Health endpoint for load\u2011balancer/HA checks.\"\"\"\n    return JSONResponse(content={\"status\": \"healthy\"}, status_code=status.HTTP_200_OK)\n\n# --------------------------------------------------------------------------- #\n# Prometheus metrics endpoint\n# --------------------------------------------------------------------------- #\n@app.get(\n    \"/metrics\",\n    tags=[\"Metrics\"],\n    summary=\"Expose Prometheus metrics on /metrics\",\n    response_class=Response,\n)\nasync def expose_metrics(request: Request):\n    \"\"\"\n    Serve metrics for Prometheus and Service Level Monitoring.\n    The metrics include custom app metrics + HTTP router metrics.\n    \"\"\"\n    from prometheus_client import generate_latest, CONTENT_TYPE_LATEST\n    return Response(\n        content=generate_latest(),\n        media_type=CONTENT_TYPE_LATEST,\n    )\n```\n\n---\n\n### `src/collatz_odd_service/config.py`   *(empty \u2013 kept for future use; you can add any environment\u2011specific config here)*\n\n```python\n# Placeholder for future environment or secret handling\n# For now it is intentionally empty\n```\n\n---\n\n### `src/collatz_odd_service/models/__init__.py`\n\n```python\n\"\"\"\nDTOs (Data Transfer Objects) used across the service.\n\"\"\"\n\n# Expose DTO names so `from collatz_odd_service.models import *` works.\n```\n\n---\n\n### `src/collatz_odd_service/models/request.py`\n\n```python\nfrom pydantic import BaseModel, Field\n\nclass CollatzRequest(BaseModel):\n    \"\"\"\n    Request payload shape for POST /collatz/odd\n\n    The request MUST contain a single positive integer `n > 0`.\n    \"\"\"\n    number: int = Field(\n        ...,\n        title=\"n\",\n        description=\"Positive integer for Collatz sequence\",\n        example=27,\n    )\n```\n\n---\n\n### `src/collatz_odd_service/models/response.py`\n\n```python\nfrom pydantic import BaseModel, Field\nfrom typing import List\n\nclass CollatzResponse(BaseModel):\n    \"\"\"\n    Response body \u2013 a list of odd numbers extracted from the Collatz sequence.\n    \"\"\"\n    odds: List[int] = Field(\n        description=\"Odd numbers from the Collatz (3n+1) sequence\"\n    )\n```\n\n---\n\n### `src/collatz_odd_service/models/errors.py`\n\n```python\nclass ValidationError(RuntimeError):\n    \"\"\"Raised when input validation fails.\"\"\"\n```\n\n---\n\n### `src/collatz_odd_service/services/__init__.py`\n\n```python\n\"\"\"\nPure\u2010Python service layer \u2013 no side\u2011effects, stateless.\n\"\"\"\n\n```\n\n---\n\n### `src/collatz_odd_service/services/collatz_engine.py`\n\n```python\nclass CollatzEngine:\n    \"\"\"Generate Collatz (3n+1) sequence.\"\"\"\n\n    @staticmethod\n    def compute(number: int) -> list[int]:\n        \"\"\"Return the full Collatz sequence for `number` (inclusive).\"\"\"\n        if number <= 0:\n            raise ValueError(\"Number must be greater than zero for Collatz.\")\n        current = number\n        sequence = []          # List[int]\n        while True:\n            sequence.append(current)\n            if current == 1:\n                break\n            current = 3 * current + 1 if current % 2 else current // 2\n        return sequence\n```\n\n---\n\n### `src/collatz_odd_service/services/validator.py`\n\n```python\nclass CollatzValidator:\n    \"\"\"Validate input for Collatz calculation.\"\"\"\n\n    @staticmethod\n    def validate(number: int) -> None:\n        \"\"\"\n        Raises ValueError if `number` is not a positive integer.\n        \"\"\"\n        if not isinstance(number, int) or number <= 0:\n            raise ValueError(\n                \"Number must be a positive integer greater than 0.\"\n            )\n```\n\n---\n\n### `src/collatz_odd_service/services/odd_filter.py`\n\n```python\nclass OddFilter:\n    \"\"\"Extract odd numbers from a numeric sequence.\"\"\"\n\n    @staticmethod\n    def filter( sequence: list[int] ) -> list[int]:\n        \"\"\"\n        Return a new list containing only odd numbers from `sequence`.\n        \"\"\"\n        return [n for n in sequence if n % 2]\n```\n\n---\n\n### `src/collatz_odd_service/services/metrics.py`\n\n```python\nfrom prometheus_client import Summary, Counter\n\n# HTTP request metrics \u2013 automatically exposed at /metrics\nhttp_request_duration_seconds = Summary(\n    'http_request_duration_seconds',\n    'HTTP request latency in seconds',\n    ['method', 'endpoint', 'http_status']\n)\n\nhttp_requests_total = Counter(\n    'http_requests_total',\n    'Total number of HTTP requests',\n    ['method', 'endpoint', 'http_status']\n)\n\n# Custom app metrics\ncollatz_latency_seconds = Summary(\n    'collatz_latency_seconds',\n    'Latency (in seconds) of Collatz sequence generation and odd filtering.'\n)\n\ncollatz_computations_total = Counter(\n    'collatz_computations_total',\n    'Number of Collatz computations per status code',\n    ['status']\n)\n```\n\n---\n\n### `src/collatz_odd_service/routes/__init__.py`\n\n```python\n\"\"\"\nFastAPI router modules for the service.\n\"\"\"\n\n```\n\n---\n\n### `src/collatz_odd_service/routes/collatz_route.py`\n\n*(Already in `app.py` \u2013 router defined inline for brevity, but you could move it to this file if desired.)*\n\n---\n\n### `src/collatz_odd_service/middleware/__init__.py`\n\n```python\n\"\"\"\nMiddleware packages \u2013 currently only Common middleware.\n\"\"\"\n\n```\n\n---\n\n### `src/collatz_odd_service/middleware/common.py`\n\n```python\nfrom fastapi import FastAPI, Request, Response\nfrom fastapi.responses import JSONResponse\nfrom fastapi.exceptions import RequestValidationError\nimport logging\nimport time\n\n# Standard logger (set up in app.py)\n# If you prefer structured logging, you can plug in structlog here\n\nclass CommonMiddleware:\n    \"\"\"Common behaviour for logging and exception handling.\"\"\"\n    # No explicit code required \u2013 left as a placeholder for future middleware upgrades.\n    pass\n```\n\n---\n\n### `docker/Dockerfile`\n\n```Dockerfile\n# ----------------------------------------------\n# Base image \u2013 official FastAPI/uvicorn runtime\n# ----------------------------------------------\nFROM python:3.12-slim AS builder\n\n# ----------------------------------------------\n# Build stage \u2013 install dependencies\n# ----------------------------------------------\nWORKDIR /app\nCOPY requirements.txt ./\nRUN --mount=type=cache,target=/root/.cache/pip \\\n    pip install --upgrade pip \\\n    && pip install --no-cache-dir -r requirements.txt\n\n# ----------------------------------------------\n# Final stage \u2013 lean runtime\n# ----------------------------------------------\nFROM python:3.12-slim AS runtime\n\nWORKDIR /app\n\n# Copy minimal runtime files\nCOPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages\nCOPY src/collatz_odd_service ./collatz_odd_service\nCOPY .env .\nCOPY requirements.txt .\nCOPY setup.py .\n\n# Expose ports\nEXPOSE 8000 4317 4318 9090 3000\n\n# Create log directory\nRUN mkdir -p /var/log/collatz_odd_service\n\n# Entrypoint \u2013 override CMD to avoid gunicorn\nENTRYPOINT [ \"uvicorn\", \"collatz_odd_service.app:app\",\n             \"--host\", \"0.0.0.0\",\n             \"--port\", \"8000\",\n             \"--workers\", \"1\",\n             \"--log-level\", \"info\" ]\n```\n\n-