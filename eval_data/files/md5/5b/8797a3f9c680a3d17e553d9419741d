{"task_id": "HumanEval/24", "solution": "# File: src/__init__.py\n# This file marks the 'src' directory as a Python package.\n\n# File: src/domain/__init__.py\n# This file marks the 'domain' directory as a Python package.\n\n# File: src/domain/number.py\nfrom dataclasses import dataclass\n\nclass InvalidIntegerNumberError(ValueError):\n    \"\"\"Raised when an IntegerNumber has an invalid value.\"\"\"\n    pass\n\n@dataclass(frozen=True)\nclass IntegerNumber:\n    value: int\n\n    def __post_init__(self):\n        \"\"\"Validates the integer number value upon instantiation.\n        A valid integer number must be a positive integer.\n        \"\"\"\n        if not self.is_valid():\n            raise InvalidIntegerNumberError(\n                f\"Integer number must be a positive integer. Got {self.value}\"\n            )\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the integer number value is valid.\"\"\"\n        return self.value > 0\n\n    def __hash__(self):\n        \"\"\"Enables IntegerNumber objects to be used as dictionary keys or set members.\"\"\"\n        return hash(self.value)\n\n# File: src/domain/divisor.py\nfrom dataclasses import dataclass\n\n@dataclass(frozen=True)\nclass Divisor:\n    value: int\n\n    def __post_init__(self):\n        \"\"\"Validates the divisor value upon instantiation.\n        A divisor value must be a positive integer.\n        \"\"\"\n        if not isinstance(self.value, int) or self.value <= 0:\n            raise ValueError(\"Divisor value must be a positive integer.\")\n\n    def __lt__(self, other):\n        \"\"\"Enables comparison between Divisor objects.\"\"\"\n        if not isinstance(other, Divisor):\n            return NotImplemented\n        return self.value < other.value\n\n    def __eq__(self, other):\n        \"\"\"Enables equality checks between Divisor objects.\"\"\"\n        if not isinstance(other, Divisor):\n            return NotImplemented\n        return self.value == other.value\n\n  