{"task_id": "HumanEval/52", "solution": "from typing import List, Union\ndef below_threshold(l: List[Union[int, float]], t: int) -> bool:\n    \"\"\"Return True if all numbers in list 'l' are strictly less than threshold 't'.\n    Raises TypeError for invalid input types or non-numeric list elements.\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input 'l' must be a list.\")\n    if not isinstance(t, int):\n        raise TypeError(\"Input 't' must be an integer.\")\n\n    for number in l:\n        if not isinstance(number, (int, float)):\n            raise TypeError(f\"All elements in 'l' must be numbers, but found type {type(number).__name__}.\")\n        if number >= t:\n            return False\n    return True"}
{"task_id": "HumanEval/55", "solution": "from typing import Any\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    pass\nclass InputValidator:\n    \"\"\"Provides utility methods for validating various inputs.\"\"\"\n    def validate_non_negative_integer(self, value: Any, param_name: str) -> int:\n        \"\"\"Validates if a given value is a non-negative integer. Raises InvalidInputError if validation fails.\"\"\"\n        if not isinstance(value, int):\n            raise InvalidInputError(f\"Parameter '{param_name}' must be an integer, but got {type(value).__name__}.\")\n        if value < 0:\n            raise InvalidInputError(f\"Parameter '{param_name}' must be a non-negative integer, but got {value}.\")\n        return value\nclass FibonacciCalculator:\n    \"\"\"Computes the Nth Fibonacci number.\"\"\"\n    def __init__(self, validator: InputValidator):\n        \"\"\"Initializes the calculator with an InputValidator instance.\"\"\"\n        self.validator = validator\n\n    def calculate(self, n: int) -> int:\n        \"\"\"Calculates the Nth Fibonacci number using an iterative approach.\n        Input is validated to be a non-negative integer.\"\"\"\n        validated_n = self.validator.validate_non_negative_integer(n, \"n\")\n\n        if validated_n == 0:\n            return 0\n        elif validated_n == 1:\n            return 1\n        else:\n            # Using an iterative approach for better performance and to avoid recursion depth limits.\n            a, b = 0, 1\n            for _ in range(2, validated_n + 1):\n                a, b = b, a + b\n            return b\n_validator = InputValidator()\n_calculator = FibonacciCalculator(_validator)\ndef fib(n: int) -> int:\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    return _calculator.calculate(n)"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Sorts a list of integers in an alternating minimum-then-maximum order.\n    Starts with the smallest element, then the largest remaining, then the smallest, and so on.\n    '''\n    if not lst:\n        return []\n\n    # Create a sorted copy of the list to avoid modifying the original input.\n    sorted_lst = sorted(lst)\n    result = []\n    is_min_turn = True\n\n    # Iteratively append the smallest and largest remaining elements.\n    while sorted_lst:\n        if is_min_turn:\n            result.append(sorted_lst.pop(0))  # Append the smallest element.\n        else:\n            result.append(sorted_lst.pop(-1)) # Append the largest element.\n        is_min_turn = not is_min_turn\n    return result"}
{"task_id": "HumanEval/78", "solution": "PRIME_HEX_DIGITS = {'2', '3', '5', '7', 'B', 'D'}\ndef hex_key(num):\n    \"\"\"\n    Counts prime hexadecimal digits in a string.\n    Returns 0 for an empty input string.\n    \"\"\"\n    if not num:\n        return 0\n\n    count = 0\n    for digit in num:\n        if digit in PRIME_HEX_DIGITS:\n            count += 1\n    return count"}
{"task_id": "HumanEval/82", "solution": "def _is_prime(n: int) -> bool:\n    \"\"\"\n    Checks if an integer is prime.\n    Uses an optimized trial division algorithm up to the square root of n.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    Examples\n    prime_length('Hello') == True\n    prime_length('abcdcba') == True\n    prime_length('kittens') == True\n    prime_length('orange') == False\n    \"\"\"\n    length = len(string)\n    return _is_prime(length)"}
{"task_id": "HumanEval/83", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\ndef starts_one_ends(n: int) -> int:\n    \"\"\"\n    Given a positive integer n, return the count of n-digit positive integers\n    that start or end with 1. It applies the inclusion-exclusion principle for n > 1.\n    \"\"\"\n    # Validate 'n' as a positive integer.\n    if not isinstance(n, int) or n < 1:\n        raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n\n    if n == 1:\n        # For n=1, only the number '1' qualifies as it starts and ends with 1.\n        return 1\n    else:\n        # Calculate for n > 1 using the inclusion-exclusion principle.\n        # This simplifies to 18 * 10^(n-2) numbers.\n        return 18 * (10**(n - 2))"}
{"task_id": "HumanEval/81", "solution": "from dataclasses import dataclass\nimport sys\nEPSILON = sys.float_info.epsilon * 10\nGRADING_SCALE: list[GradeMapping] = [\n    GradeMapping(min_gpa=4.0, letter_grade='A+'),\n    GradeMapping(min_gpa=3.7, letter_grade='A'), # Per test_single_gpa_conversion(3.7, 'A')\n    GradeMapping(min_gpa=3.3, letter_grade='A-'),\n    GradeMapping(min_gpa=3.0, letter_grade='B+'),\n    GradeMapping(min_gpa=2.7, letter_grade='B'),\n    GradeMapping(min_gpa=2.3, letter_grade='B-'),\n    GradeMapping(min_gpa=2.0, letter_grade='C+'),\n    GradeMapping(min_gpa=1.7, letter_grade='C'),\n    GradeMapping(min_gpa=1.3, letter_grade='C-'),\n    GradeMapping(min_gpa=1.0, letter_grade='D+'),\n    GradeMapping(min_gpa=0.7, letter_grade='D'),\n    # 'D-' is for > 0.0, so 0.0 itself falls to 'E'.\n    GradeMapping(min_gpa=0.0 + EPSILON, letter_grade='D-'),\n    # 'E' handles 0.0 and any negative GPAs, as per BR1 and test cases.\n    GradeMapping(min_gpa=-float('inf'), letter_grade='E') \n]\nclass GradeConverter:\n    \"\"\"Converts numerical GPAs to letter grades based on a predefined scale.\n    It handles both single GPA conversions and lists of GPAs.\n    \"\"\"\n\n    def __init__(self):\n        \"\"\"Initializes the GradeConverter with the predefined grading scale.\"\"\"\n        # The scale is already defined in descending order, but sorting ensures correctness.\n        self._grading_scale = sorted(GRADING_SCALE, key=lambda x: x.min_gpa, reverse=True)\n\n    def convert_gpa_to_letter_grade(self, gpa: float) -> str:\n        \"\"\"Converts a single GPA to its corresponding letter grade.\n        It performs type checking and iterates through the sorted grading scale.\n        \"\"\"\n        if not isinstance(gpa, (int, float)):\n            raise TypeError(\"GPA must be a numeric value.\")\n\n        for mapping in self._grading_scale:\n            if gpa >= mapping.min_gpa:\n                return mapping.letter_grade\n        # This fallback should ideally not be reached if -float('inf') covers all lowest cases.\n        return 'E' \n\n    def numerical_letter_grade(self, gpas: list[float]) -> list[str]:\n        \"\"\"Converts a list of GPAs to a list of letter grades.\n        It validates the input list and applies single GPA conversion to each element.\n        \"\"\"\n        if not isinstance(gpas, list):\n            raise TypeError(\"Input must be a list of GPAs.\")\n        \n        return [self.convert_gpa_to_letter_grade(gpa) for gpa in gpas]\ndef numerical_letter_grade(grades: list[float]) -> list[str]:\n    \"\"\"\n    It is the last week of the semester and the teacher has to give the grades\n    to students. The teacher has been making her own algorithm for grading.\n    The only problem is, she has lost the code she used for grading.\n    She has given you a list of GPAs for some students and you have to write \n    a function that can output a list of letter grades using the following table:\n             GPA       |    Letter grade\n              4.0                A+\n            > 3.7                A \n            > 3.3                A- \n            > 3.0                B+\n            > 2.7                B \n            > 2.3                B-\n            > 2.0                C+\n            > 1.7                C\n            > 1.3                C-\n            > 1.0                D+ \n            > 0.7                D \n            > 0.0                D-\n              0.0                E\n    \n\n    Example:\n    grade_equation([4.0, 3, 1.7, 2, 3.5]) ==> ['A+', 'B', 'C-', 'C', 'A-']\n    \"\"\"\n    converter = GradeConverter()\n    return converter.numerical_letter_grade(grades)"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n: int) -> int:\n    \"\"\"\n    Given a positive integer n, return the count of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    if n == 1:\n        return 1\n\n    # Counts n-digit numbers starting with 1 (e.g., 10^(n-1)).\n    def _count_starts_with_one_inner(num_digits: int) -> int:\n        return 10**(num_digits - 1)\n\n    # Counts n-digit numbers ending with 1.\n    def _count_ends_with_one_inner(num_digits: int) -> int:\n        if num_digits == 1:\n            return 1\n        return 9 * (10**(num_digits - 2))\n\n    # Counts n-digit numbers starting AND ending with 1.\n    def _count_starts_and_ends_with_one_inner(num_digits: int) -> int:\n        if num_digits == 1:\n            return 1\n        return 10**(num_digits - 2)\n\n    # Apply the principle of inclusion-exclusion.\n    starts_with_one = _count_starts_with_one_inner(n)\n    ends_with_one = _count_ends_with_one_inner(n)\n    starts_and_ends_with_one = _count_starts_and_ends_with_one_inner(n)\n\n    return starts_with_one + ends_with_one - starts_and_ends_with_one"}
{"task_id": "HumanEval/84", "solution": "class DigitSumCalculator:\n    def calculate_digit_sum(self, n: int) -> int:\n        \"\"\"Calculates the sum of the decimal digits of an integer n.\n        Handles non-negative integers by iteratively summing digits.\"\"\"\n        digit_sum = 0\n        if n == 0:\n            return 0\n        \n        temp_n = n\n        while temp_n > 0:\n            digit_sum += temp_n % 10\n            temp_n //= 10\n        return digit_sum\n\n    def to_binary_string(self, decimal_sum: int) -> str:\n        \"\"\"Converts a non-negative decimal integer to its binary string representation.\n        Leverages Python's built-in bin() function for efficient conversion.\"\"\"\n        if decimal_sum == 0:\n            return \"0\"\n        return bin(decimal_sum)[2:] # Remove the \"0b\" prefix\ndef solve(N: int) -> str:\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    \n    Example\n        For N = 1000, the sum of digits will be 1 the output should be \"1\".\n        For N = 150, the sum of digits will be 6 the output should be \"110\".\n        For N = 147, the sum of digits will be 12 the output should be \"1100\".\n    \n    Variables:\n        @N integer\n             Constraints: 0 \u2264 N \u2264 10000.\n    Output:\n         a string of binary number\n    \"\"\"\n    calculator = DigitSumCalculator()\n    digit_sum = calculator.calculate_digit_sum(N)\n    binary_representation = calculator.to_binary_string(digit_sum)\n    return binary_representation"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Takes a string and returns an ordered version where word characters are sorted by ASCII value.\n    Preserves the order of words and blank spaces in the sentence.\n    \"\"\"\n    if not s:\n        return \"\"\n\n    def _sort_word(word: str) -> str:\n        \"\"\"Sorts characters of a word by ascending ASCII value.\"\"\"\n        return \"\".join(sorted(word))\n\n    # Split the string by single space to capture multiple spaces as empty strings.\n    segments = s.split(' ')\n    processed_segments = []\n\n    for segment in segments:\n        if segment:  # If the segment is a non-empty word (or punctuation block).\n            processed_segments.append(_sort_word(segment))\n        else:  # If the segment is an empty string, representing a space.\n            processed_segments.append(\"\")\n\n    return \" \".join(processed_segments)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds all occurrences of x in a nested list and returns their (row, column) coordinates.\n    Coordinates are sorted by row ascending and then by column descending.\n    \"\"\"\n    coordinates = []\n    for r, row_list in enumerate(lst):\n        for c, element in enumerate(row_list):\n            if element == x:\n                coordinates.append((r, c))\n\n    # Sort primarily by row ascending, secondarily by column descending, leveraging stable sort.\n    coordinates.sort(key=lambda coord: coord[1], reverse=True)  # Sort by column descending\n    coordinates.sort(key=lambda coord: coord[0])               # Sort by row ascending (stable)\n\n    return coordinates"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array: list[int]) -> list[int]:\n    \"\"\"\n    Sorts an array of non-negative integers based on the parity of the sum of its first and last elements.\n    Returns a new sorted array, leaving the original unchanged.\n    \"\"\"\n    if not array:\n        return []\n    if len(array) == 1:\n        return list(array)\n\n    first_val = array[0]\n    last_val = array[-1]\n    sum_first_last = first_val + last_val\n\n    if sum_first_last % 2 != 0:\n        return sorted(array)\n    else:\n        return sorted(array, reverse=True)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds all occurrences of integer x in a nested list (2D data) and returns\n    their (row, column) coordinates. Coordinates are sorted first by row in\n    ascending order, then by column in descending order for elements within\n    the same row.\n    \"\"\"\n    coordinates = []\n    for r_idx, row in enumerate(lst):\n        for c_idx, val in enumerate(row):\n            if val == x:\n                coordinates.append((r_idx, c_idx))\n\n    coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n    return coordinates"}
{"task_id": "HumanEval/88", "solution": "from .exceptions import InvalidArrayError\nfrom typing import List\nclass InvalidArrayError(ValueError):\n    \"\"\"Custom exception for invalid array input conditions.\"\"\"\n    pass\nclass ArrayValidator:\n    \"\"\"Utility for validating array input according to specified rules.\"\"\"\n\n    @staticmethod\n    def _is_non_negative_integer(value: any) -> bool:\n        \"\"\"Checks if a value is a non-negative integer.\"\"\"\n        return isinstance(value, int) and value >= 0\n\n    @staticmethod\n    def validate_array(array: list) -> None:\n        \"\"\"Validates that the input is a list of non-negative integers.\"\"\"\n        if not isinstance(array, list):\n            raise InvalidArrayError(\"Input must be a list.\")\n        for item in array:\n            if not ArrayValidator._is_non_negative_integer(item):\n                raise InvalidArrayError(\"All array elements must be non-negative integers.\")\nclass ArraySorter:\n    \"\"\"Orchestrates conditional sorting of an array based on its first and last elements.\"\"\"\n\n    def _determine_sort_order(self, first: int, last: int) -> str:\n        \"\"\"Determines the sort order (ascending/descending) based on element sum parity.\"\"\"\n        if (first + last) % 2 == 0:\n            return \"descending\"\n        else:\n            return \"ascending\"\n\n    def sort(self, array: List[int]) -> List[int]:\n        \"\"\"Sorts a copy of the array based on specific conditions.\"\"\"\n        ArrayValidator.validate_array(array)\n\n        # Handle empty or single-element arrays as per FR4 and FR5.\n        if not array or len(array) == 1:\n            return list(array)\n\n        copied_array = list(array) # FR3: Ensure original array is not modified.\n\n        first_element = copied_array[0]\n        last_element = copied_array[-1]\n\n        sort_order = self._determine_sort_order(first_element, last_element)\n\n        if sort_order == \"ascending\":\n            return sorted(copied_array) # FR1: Ascending sort.\n        else: # descending\n            return sorted(copied_array, reverse=True) # FR2: Descending sort.\ndef sort_array(array: List[int]) -> List[int]:\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n\n    Note:\n    * don't change the given array.\n\n    Examples:\n    * sort_array([]) => []\n    * sort_array([5]) => [5]\n    * sort_array([2, 4, 3, 0, 1, 5]) => [0, 1, 2, 3, 4, 5]\n    * sort_array([2, 4, 3, 0, 1, 5, 6]) => [6, 5, 4, 3, 2, 1, 0]\n    \"\"\"\n    sorter = ArraySorter()\n    return sorter.sort(array)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by shifting alphabetic characters by four positions.\n    Non-alphabetic characters remain unchanged, and rotation is circular.\"\"\"\n\n    SHIFT_AMOUNT = 4\n    ALPHABET_SIZE = 26\n    \n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            base = ord('a')\n            offset = ord(char) - base\n            shifted_offset = (offset + SHIFT_AMOUNT) % ALPHABET_SIZE\n            encrypted_chars.append(chr(base + shifted_offset))\n        elif 'A' <= char <= 'Z':\n            base = ord('A')\n            offset = ord(char) - base\n            shifted_offset = (offset + SHIFT_AMOUNT) % ALPHABET_SIZE\n            encrypted_chars.append(chr(base + shifted_offset))\n        else:\n            encrypted_chars.append(char)\n            \n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s: str) -> str:\n    \"\"\"\n    Encrypts a string by shifting each alphabetic character.\n    Letters shift down by four places, preserving case and wrapping around.\n    \"\"\"\n    SHIFT_AMOUNT = 4\n\n    def _shift_char(char_to_shift: str, start_ord: int, end_ord: int) -> str:\n        \"\"\"Helper to shift a single character within an ASCII range, handling wrap-around.\"\"\"\n        char_code = ord(char_to_shift)\n        shifted_code = start_ord + (char_code - start_ord + SHIFT_AMOUNT) % (end_ord - start_ord + 1)\n        return chr(shifted_code)\n\n    result_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            shifted_char = _shift_char(char, ord('a'), ord('z'))\n        elif 'A' <= char <= 'Z':\n            shifted_char = _shift_char(char, ord('A'), ord('Z'))\n        else:\n            shifted_char = char\n        result_chars.append(shifted_char)\n    return \"\".join(result_chars)"}
