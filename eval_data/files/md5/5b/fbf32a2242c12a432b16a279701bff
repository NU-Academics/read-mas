{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s, n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket.\n    Parses the input string for apples and oranges, then subtracts from total.\n    \"\"\"\n    # Parse the input string to extract the number of apples and oranges.\n    match = re.match(r\"(\\d+)\\s*apples\\s*and\\s*(\\d+)\\s*oranges\", s)\n    if not match:\n        raise ValueError(f\"Invalid fruit string format: '{s}'. Expected 'X apples and Y oranges'.\")\n\n    apples = int(match.group(1))\n    oranges = int(match.group(2))\n\n    # Validate total fruits count.\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Total fruits must be a non-negative integer.\")\n\n    # Calculate the number of mango fruits.\n    total_apples_oranges = apples + oranges\n\n    # Ensure total apples and oranges do not exceed total fruits.\n    if total_apples_oranges > n:\n        raise ValueError(\"Sum of apples and oranges cannot exceed total fruits.\")\n\n    mango_count = n - total_apples_oranges\n    return mango_count"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\ndef search(lst):\n    \"\"\"\n    Returns the greatest integer `x` where `x > 0` and its frequency in `lst` is `>= x`.\n    Returns -1 if no such integer exists.\n    \"\"\"\n    if not lst:\n        return -1 # Problem statement guarantees non-empty list, but this handles an empty list.\n\n    frequencies = Counter(lst)\n    max_candidate = -1\n\n    for num, freq in frequencies.items():\n        if num > 0 and freq >= num:\n            if num > max_candidate:\n                max_candidate = num\n    return max_candidate"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even-valued node and its index from an array of non-negative integers.\n    Returns [value, index] or an empty list if no even values are found or the array is empty.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = None\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even.\n            if smallest_even_value is None or value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n            # If value == smallest_even_value, the current smallest_even_index is preserved (first occurrence).\n\n    if smallest_even_value is None:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr: list[int]) -> list[int]:\n    \"\"\"\n    Finds the smallest even non-negative integer and its index in `arr`.\n    Returns `[value, index]` or `[]` if no even numbers are found or the array is empty.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n            elif value == smallest_even_value and index < smallest_even_index:\n                smallest_even_index = index\n\n    if smallest_even_index != -1:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\ndef search(lst):\n    \"\"\"\n    Finds the greatest integer in a non-empty list of positive integers\n    that has a frequency greater than or equal to its value.\n    Returns the greatest such integer, or -1 if none exist.\n    \"\"\"\n    frequency_map = Counter(lst) # Calculate the frequency of each integer in the list.\n    \n    qualifying_integers = []\n    for num, freq in frequency_map.items():\n        if num > 0 and freq >= num: # Identify integers that meet the condition.\n            qualifying_integers.append(num)\n    \n    if not qualifying_integers:\n        return -1\n    \n    return max(qualifying_integers) # Return the greatest among the qualifying integers."}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    # Validate that sides are positive and satisfy the triangle inequality theorem.\n    if not (a > 0 and b > 0 and c > 0 and \\\n            (a + b > c) and (a + c > b) and (b + c > a)):\n        return -1.0\n\n    # Calculate the semi-perimeter.\n    s = (a + b + c) / 2\n    # Apply Heron's formula to find the area, guarding against floating-point inaccuracies.\n    area = math.sqrt(max(0.0, s * (s - a) * (s - b) * (s - c)))\n\n    return round(area, 2)"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst: list[int]) -> list[int]:\n    \"\"\"\n    Given a list of integers, return a new list sorted in a specific strange order.\n    The order alternates between the minimum and maximum remaining values.\n    \"\"\"\n    if not lst:\n        return []\n\n    # Create a mutable working copy, initially sorted as per design's example.\n    working_list = sorted(lst)\n    result = []\n\n    while working_list:\n        # Find and remove the minimum value from the remaining list.\n        min_val = min(working_list)\n        working_list.remove(min_val)\n        result.append(min_val)\n\n        if not working_list:\n            break\n\n        # Find and remove the maximum value from the remaining list.\n        max_val = max(working_list)\n        working_list.remove(max_val)\n        result.append(max_val)\n\n    return result"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Given three side lengths, calculate the triangle's area or return -1 if invalid.\n    Area is rounded to 2 decimal places.\n    \"\"\"\n    # Validate side lengths as per FR1 and Business Rules.\n    if not (a > 0 and b > 0 and c > 0):\n        return -1.0\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1.0\n\n    # Calculate area using Heron's formula as per FR2.\n    s = (a + b + c) / 2\n    area_squared = s * (s - a) * (s - b) * (s - c)\n\n    # Handle potential floating point inaccuracies for area_squared.\n    if area_squared < 0:\n        area = 0.0\n    else:\n        area = math.sqrt(area_squared)\n\n    # Round the calculated area to two decimal places as per FR3 and NFR1.\n    return round(area, 2)"}
{"task_id": "HumanEval/72", "solution": "from typing import Any\ndef _is_palindromic(q: list) -> bool:\n    \"\"\"\n    Checks if the input list 'q' is a palindrome.\n    Returns True if it is, False otherwise.\n    \"\"\"\n    return q == q[::-1]\ndef _is_within_weight_limit(q: list, w: Any) -> bool:\n    \"\"\"\n    Calculates the sum of elements in 'q' and checks if it's less than or equal to 'w'.\n    Returns True if the sum is within the limit, False otherwise.\n    \"\"\"\n    return sum(q) <= w\ndef will_it_fly(q, w):\n    '''\n    Write a function that returns True if the object q will fly, and False otherwise.\n    The object q will fly if it's balanced (it is a palindromic list) and the sum of its elements is less than or equal the maximum possible weight w.\n\n    Example:\n    will_it_fly([1, 2], 5) \u279e False \n    # 1+2 is less than the maximum possible weight, but it's unbalanced.\n\n    will_it_fly([3, 2, 3], 1) \u279e False\n    # it's balanced, but 3+2+3 is more than the maximum possible weight.\n\n    will_it_fly([3, 2, 3], 9) \u279e True\n    # 3+2+3 is less than the maximum possible weight, and it's balanced.\n\n    will_it_fly([3], 5) \u279e True\n    # 3 is less than the maximum possible weight, and it's balanced.\n    '''\n    _validate_list_of_numbers(q, \"q\")\n    _validate_number(w, \"w\")\n\n    is_balanced = _is_palindromic(q)\n    is_light_enough = _is_within_weight_limit(q, w)\n\n    return is_balanced and is_light_enough"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum changes to make an array palindromic.\n    Compares elements from ends, incrementing count for mismatches.\n    \"\"\"\n    changes = 0\n    left = 0\n    right = len(arr) - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes"}
{"task_id": "HumanEval/72", "solution": "def _is_palindrome(q):\n    \"\"\"Checks if a list is a palindrome.\"\"\"\n    if not isinstance(q, list):\n        raise TypeError(\"Input 'q' must be a list.\")\n    return q == q[::-1]\ndef _calculate_sum(q):\n    \"\"\"Calculates the sum of elements in a list.\"\"\"\n    if not isinstance(q, list):\n        raise TypeError(\"Input 'q' must be a list.\")\n    return sum(q)\ndef will_it_fly(q,w):\n    '''\n    Determines if object `q` will fly.\n    An object flies if it's a palindromic list and its total weight is less than or equal to `w`.\n    '''\n    if not isinstance(w, (int, float)):\n        raise TypeError(\"Input 'w' must be an integer or float.\")\n\n    is_balanced = _is_palindrome(q)\n    total_weight = _calculate_sum(q)\n\n    weight_ok = total_weight <= w\n\n    return is_balanced and weight_ok"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Find the minimum changes to make an array palindromic.\n    Raises ValueError for invalid input.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise ValueError(\"Input must be a list of integers.\")\n    for item in arr:\n        if not isinstance(item, int):\n            raise ValueError(\"Input must be a list of integers.\")\n\n    changes = 0\n    left, right = 0, len(arr) - 1\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes"}
{"task_id": "HumanEval/74", "solution": "from typing import List\ndef total_match(lst1: List[str], lst2: List[str]) -> List[str]:\n    '''\n    Calculates the total character count for two lists of strings and returns the list with fewer characters.\n    If total character counts are equal, the first list (lst1) is returned.\n    '''\n    count1 = sum(len(s) for s in lst1)\n    count2 = sum(len(s) for s in lst2)\n\n    if count1 <= count2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    '''\n    Write a function that accepts two lists of strings and returns the list that has \n    total number of chars in the all strings of the list less than the other list.\n    If the two lists have the same number of chars, return the first list.\n    '''\n    total_chars_lst1 = sum(len(s) for s in lst1)\n    total_chars_lst2 = sum(len(s) for s in lst2)\n\n    if total_chars_lst1 <= total_chars_lst2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100.\n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n\n    def get_prime_factors_local(n: int) -> list[int]:\n        \"\"\"Finds all distinct prime factors of a given integer. Returns an empty list if n is 0 or 1.\"\"\"\n        factors = set()\n        d = 2\n        temp = n\n        while d * d <= temp:\n            if temp % d == 0:\n                factors.add(d)\n                while temp % d == 0:\n                    temp //= d\n            d += 1\n        if temp > 1:\n            factors.add(temp)\n        return sorted(list(factors))\n\n    if a < 1:\n        return False\n\n    factors = get_prime_factors_local(a)\n\n    if len(factors) == 3:\n        # Check if the product of these 3 distinct factors equals 'a'.\n        product = 1\n        for factor in factors:\n            product *= factor\n        return product == a\n    return False"}
{"task_id": "HumanEval/75", "solution": "import itertools\ndef is_multiply_prime(a):\n    \"\"\"Checks if a number is the product of exactly three distinct prime numbers.\n    Input 'a' must be an integer between 1 and 99 (exclusive of 0 and 100).\"\"\"\n\n    if not isinstance(a, int) or not (0 < a < 100):\n        raise ValueError(\"Input 'a' must be an integer between 1 and 99.\")\n\n    # Numbers less than 30 cannot be a product of three distinct primes (2*3*5=30).\n    if a < 30:\n        return False\n\n    def _generate_primes_up_to(limit: int) -> list[int]:\n        # Generates primes up to 'limit' using the Sieve of Eratosthenes.\n        # Returns an empty list if limit is less than 2.\n        if limit < 2:\n            return []\n        primes_list = []\n        is_prime_sieve = [True] * (limit + 1)\n        is_prime_sieve[0] = is_prime_sieve[1] = False\n        for p in range(2, int(limit**0.5) + 1):\n            if is_prime_sieve[p]:\n                for multiple in range(p * p, limit + 1, p):\n                    is_prime_sieve[multiple] = False\n        for p in range(2, limit + 1):\n            if is_prime_sieve[p]:\n                primes_list.append(p)\n        return primes_list\n\n    primes = _generate_primes_up_to(a)\n    \n    # Check all combinations of three distinct primes.\n    for p1, p2, p3 in itertools.combinations(primes, 3):\n        if p1 * p2 * p3 == a:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x: int, n: int) -> bool:\n    \"\"\"\n    Checks if a number x is a simple power of n.\n    x is a simple power of n if n**k = x for some non-negative integer k.\n    \"\"\"\n    if x == 1:\n        return True  # Any n >= 1 to the power of 0 is 1.\n    if n == 1:\n        return False # If x != 1 and n == 1, then 1^k will always be 1, so x cannot be a power of 1.\n    if x <= 0 or n <= 0:\n        return False # Handles non-positive x or n, excluding x=1.\n\n    current_val = n\n    while current_val < x:\n        current_val *= n\n    return current_val == x"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if x is a simple integer power of n (n**integer = x).\n    Returns True if x is a simple power of n, False otherwise.\n    \"\"\"\n    if n == 0:\n        # 0^0 is 1 by convention, 0^k=0 for k > 0.\n        return x == 0 or x == 1\n    if n == 1:\n        # 1^k = 1 for any integer k.\n        return x == 1\n    if n == -1:\n        # (-1)^k is 1 for even k, -1 for odd k.\n        return x == 1 or x == -1\n\n    if x == 1:\n        # Any n (except 0, 1, -1 handled) raised to power 0 is 1.\n        return True\n    if x == 0:\n        # Only 0^k = 0, but n=0 is handled separately.\n        return False\n\n    # Now n is not 0, 1, or -1. x is not 0 or 1.\n    if n > 0:\n        if x < 0:\n            # A positive base cannot produce a negative result.\n            return False\n        # Both x and n are positive; perform repeated division.\n        temp_x = x\n        while temp_x > 1:\n            if temp_x % n != 0:\n                return False\n            temp_x //= n\n        return temp_x == 1\n    else:  # n < 0\n        if x > 0:\n            # x is positive, so exponent must be even.\n            exponent_parity_check = True\n        else:  # x < 0\n            # x is negative, so exponent must be odd.\n            exponent_parity_check = False\n\n        temp_x = abs(x)\n        temp_n_abs = abs(n)\n        exponent_count = 0\n\n        # Check if abs(x) is a power of abs(n).\n        while temp_x > 1:\n            if temp_x % temp_n_abs != 0:\n                return False\n            temp_x //= temp_n_abs\n            exponent_count += 1\n        \n        # If abs(x) is not a perfect power of abs(n).\n        if temp_x != 1:\n            return False\n\n        # Verify exponent parity based on the sign of x.\n        return (exponent_count % 2 == 0) == exponent_parity_check"}
{"task_id": "HumanEval/77", "solution": "import math\ndef iscube(a):\n    \"\"\"\n    Checks if an integer 'a' is a cube of some integer number.\n    Assumes the input 'a' is always a valid integer.\n    \"\"\"\n    if a == 0:\n        return True\n    \n    # Calculate the cube root of the absolute value of 'a' and round to the nearest integer.\n    # This mitigates floating point inaccuracies while handling signs correctly.\n    abs_a = abs(a)\n    cbrt = round(abs_a**(1/3))\n    \n    # Verify if the cubed rounded root matches the absolute value.\n    # If it matches, 'a' is a perfect cube (either positive or negative).\n    return cbrt * cbrt * cbrt == abs_a"}
{"task_id": "HumanEval/77", "solution": "import math\ndef iscube(a):\n    '''\n    Write a function that takes an integer a and returns True \n    if this ingeger is a cube of some integer number.\n    Note: you may assume the input is always valid.\n    Examples:\n    iscube(1) ==> True\n    iscube(2) ==> False\n    iscube(-1) ==> True\n    iscube(64) ==> True\n    iscube(0) ==> True\n    iscube(180) ==> False\n    '''\n    if a == 0:\n        return True\n\n    abs_a = abs(a)\n    \n    # Calculate an approximate cube root.\n    # Due to floating point inaccuracies, we check a small range around the rounded root.\n    root_estimate = round(abs_a**(1/3))\n\n    # Check candidate roots: root_estimate-2, root_estimate-1, root_estimate, root_estimate+1, root_estimate+2\n    # This range covers potential off-by-one errors from floating point math.\n    for candidate_root in range(max(0, root_estimate - 2), root_estimate + 3):\n        if candidate_root * candidate_root * candidate_root == abs_a:\n            return True\n    \n    return False"}
{"task_id": "HumanEval/78", "solution": "class HexDigitValidator:\n    PRIME_HEX_DIGITS = {'2', '3', '5', '7', 'B', 'D'}\n\n    def is_prime_hex_digit(self, digit: str) -> bool:\n        \"\"\"Checks if a given hexadecimal digit is prime.\n        It compares the digit against a predefined set of prime hexadecimal digits.\"\"\"\n        return digit in self.PRIME_HEX_DIGITS\nclass HexKeyCounter:\n    def __init__(self, hex_digit_validator: HexDigitValidator = None):\n        \"\"\"Initializes the counter with an optional HexDigitValidator instance.\n        If none is provided, a default instance is created.\"\"\"\n        self.hex_digit_validator = hex_digit_validator if hex_digit_validator else HexDigitValidator()\n\n    def count_prime_hex_digits(self, hex_string: str) -> int:\n        \"\"\"Counts prime hexadecimal digits within the given string.\n        It iterates through the string, checking each character for primality.\"\"\"\n        count = 0\n        for digit in hex_string:\n            if self.hex_digit_validator.is_prime_hex_digit(digit):\n                count += 1\n        return count\ndef hex_key(num: str) -> int:\n    \"\"\"Counts the number of prime hexadecimal digits in a hexadecimal string.\n    This function serves as the public entry point.\"\"\"\n    counter = HexKeyCounter()\n    return counter.count_prime_hex_digits(num)"}
{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal):\n    \"\"\"Converts a decimal number to its binary string representation, prefixed and suffixed with 'db'.\n    Raises ValueError for non-integer or negative inputs.\"\"\"\n    if not isinstance(decimal, int):\n        raise ValueError(\"Input must be an integer.\")\n    if decimal < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    binary_str = bin(decimal)[2:]\n    return f\"db{binary_str}db\""}
