{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Returns sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Returns None for empty arr.\n    \"\"\"\n    if not arr:\n        return None\n\n    def _get_sign(num: int) -> int:\n        \"\"\"Determines the sign of an integer (1 for positive, -1 for negative, 0 for zero).\"\"\"\n        if num > 0:\n            return 1\n        elif num < 0:\n            return -1\n        else:\n            return 0\n\n    def _calculate_sum_of_magnitudes(numbers: list[int]) -> int:\n        \"\"\"Calculates the sum of the absolute values of all integers.\"\"\"\n        return sum(abs(x) for x in numbers)\n\n    def _calculate_product_of_signs(numbers: list[int]) -> int:\n        \"\"\"Calculates the product of the signs of all integers.\"\"\"\n        product = 1\n        for x in numbers:\n            current_sign = _get_sign(x)\n            product *= current_sign\n            if product == 0:  # Optimization: if any sign is 0, the product will be 0.\n                return 0\n        return product\n\n    sum_magnitudes = _calculate_sum_of_magnitudes(arr)\n    product_signs = _calculate_product_of_signs(arr)\n\n    return sum_magnitudes * product_signs"}
{"task_id": "HumanEval/157", "solution": "class InvalidSideLengthError(ValueError):\n    \"\"\"Raised when a side length is not a positive number.\"\"\"\n    pass\ndef right_angle_triangle(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    \"\"\"\n    FLOAT_TOLERANCE = 1e-9 # Tolerance for floating-point comparisons.\n\n    # Validate side lengths are positive numbers.\n    for side in [a, b, c]:\n        if not isinstance(side, (int, float)) or side <= 0:\n            raise InvalidSideLengthError(\"Side lengths must be positive numbers.\")\n\n    # Check triangle inequality: sum of any two sides must be greater than the third.\n    if not ((a + b > c) and (a + c > b) and (b + c > a)):\n        return False\n\n    # Check Pythagorean theorem for a right-angled triangle.\n    sides = sorted([a, b, c])\n    return abs(sides[0]**2 + sides[1]**2 - sides[2]**2) < FLOAT_TOLERANCE"}
{"task_id": "HumanEval/160", "solution": "from enum import Enum\ndef do_algebra(operator: list[str], operand: list[int]) -> int:\n    \"\"\"\n    Evaluates an algebraic expression constructed from given operators and operands.\n    Ensures inputs are valid and handles standard mathematical operator precedence.\n    \"\"\"\n\n    # Internal definitions for the ExpressionEvaluator components.\n    class Operator(Enum):\n        \"\"\"Defines the set of allowed algebraic operators.\"\"\"\n        ADD = \"+\"\n        SUBTRACT = \"-\"\n        MULTIPLY = \"*\"\n        FLOOR_DIVIDE = \"//\"\n        EXPONENTIATE = \"**\"\n\n    VALID_OPERATORS = {op.value for op in Operator}\n\n    class Utils:\n        \"\"\"Provides general utility functions.\"\"\"\n        @staticmethod\n        def is_valid_operator(op_str: str) -> bool:\n            \"\"\"Checks if a given string is a valid algebraic operator.\"\"\"\n            return op_str in VALID_OPERATORS\n\n    class ExpressionEvaluator:\n        \"\"\"Handles validation, construction, and evaluation of algebraic expressions.\"\"\"\n\n        def validate_inputs(self, op_list: list[str], val_list: list[int]) -> None:\n            \"\"\"Validates operator and operand lists, raising ValueError for invalid inputs.\"\"\"\n            if not isinstance(op_list, list) or not all(isinstance(op_elem, str) for op_elem in op_list):\n                raise ValueError(\"Operator list must contain only strings.\")\n            if not isinstance(val_list, list) or not all(isinstance(val_elem, int) and val_elem >= 0 for val_elem in val_list):\n                raise ValueError(\"Operand list must contain only non-negative integers.\")\n\n            if len(op_list) != len(val_list) - 1:\n                raise ValueError(\"Length of operator list must be equal to length of operand list minus one.\")\n            if len(op_list) < 1 or len(val_list) < 2:\n                raise ValueError(\"Operator list must have at least one operator, and operand list at least two operands.\")\n\n            for op_elem in op_list:\n                if not Utils.is_valid_operator(op_elem):\n                    raise ValueError(f\"Invalid operator found: {op_elem}\")\n\n        def build_expression_string(self, op_list: list[str], val_list: list[int]) -> str:\n            \"\"\"Constructs the algebraic expression as a string by interleaving operands and operators.\"\"\"\n            expression_parts = []\n            for i in range(len(val_list)):\n                expression_parts.append(str(val_list[i]))\n                if i < len(op_list):\n                    expression_parts.append(op_list[i])\n            return \" \".join(expression_parts)\n\n        def evaluate_expression(self, expression_string: str) -> int:\n            \"\"\"Safely evaluates the given expression string, respecting operator precedence.\"\"\"\n            try:\n                result = eval(expression_string)\n                return int(result)\n            except ZeroDivisionError:\n                raise ArithmeticError(\"Division by zero encountered during expression evaluation.\")\n            except Exception as e:\n                raise ValueError(f\"Error evaluating expression: {e}\")\n\n    # Core logic flow\n    evaluator = ExpressionEvaluator()\n    evaluator.validate_inputs(operator, operand)\n    expression_string = evaluator.build_expression_string(operator, operand)\n    result = evaluator.evaluate_expression(expression_string)\n    return result"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a: int, b: int) -> list[int]:\n    \"\"\"\n    Given two positive integers a and b, return the even integers between a\n    and b, in ascending order.\n    \"\"\"\n    start = min(a, b)\n    end = max(a, b)\n    \n    even_numbers = []\n    for i in range(start, end + 1):\n        if i % 2 == 0:\n            even_numbers.append(i)\n            \n    return even_numbers"}
{"task_id": "HumanEval/130", "solution": "def tri(n: int) -> list[int]:\n    \"\"\"\n    Calculates the first n + 1 numbers of the Tribonacci sequence.\n    This implementation uses memoization for efficient computation of individual terms.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    _memo: dict[int, int] = {}\n\n    def _calculate_term(k: int) -> int:\n        \"\"\"\n        Recursively calculates the k-th Tribonacci number using memoization.\n        It applies base cases and specific recurrence rules for even and odd indices.\n        \"\"\"\n        if k in _memo:\n            return _memo[k]\n\n        if k == 0:\n            result = 1\n        elif k == 1:\n            result = 3\n        elif k % 2 == 0:  # k is even and k > 0\n            result = 1 + k // 2\n        else:  # k is odd and k > 1\n            val_n_minus_1 = _calculate_term(k - 1)\n            val_n_minus_2 = _calculate_term(k - 2)\n            val_n_plus_1 = _calculate_term(k + 1)\n            result = val_n_minus_1 + val_n_minus_2 + val_n_plus_1\n        \n        _memo[k] = result\n        return result\n\n    sequence = []\n    for i in range(n + 1):\n        sequence.append(_calculate_term(i))\n        \n    return sequence"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    def _sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the absolute value of digits for an integer.\n        Example: _sum_digits(123) == 6, _sum_digits(-12) == 3.\"\"\"\n        s = 0\n        for digit_char in str(abs(n)):\n            s += int(digit_char)\n        return s\n\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    If there are several items with similar sum of their digits,\n    order them based on their index in the original list.\n    \"\"\"\n    if not nums:\n        return []\n\n    decorated_list = []\n    for i, num in enumerate(nums):\n        decorated_list.append((_sum_digits(num), i, num))\n\n    decorated_list.sort()\n\n    return [item[2] for item in decorated_list]"}
{"task_id": "HumanEval/81", "solution": "from dataclasses import dataclass\nGRADE_SCALE_DATA = [\n    {\"min_gpa\": 4.0, \"letter_grade\": \"A+\"},\n    {\"min_gpa\": 3.7 + 0.000001, \"letter_grade\": \"A\"},\n    {\"min_gpa\": 3.3 + 0.000001, \"letter_grade\": \"A-\"},\n    {\"min_gpa\": 3.0 + 0.000001, \"letter_grade\": \"B+\"},\n    {\"min_gpa\": 2.7 + 0.000001, \"letter_grade\": \"B\"},\n    {\"min_gpa\": 2.3 + 0.000001, \"letter_grade\": \"B-\"},\n    {\"min_gpa\": 2.0 + 0.000001, \"letter_grade\": \"C+\"},\n    {\"min_gpa\": 1.7 + 0.000001, \"letter_grade\": \"C\"},\n    {\"min_gpa\": 1.3 + 0.000001, \"letter_grade\": \"C-\"},\n    {\"min_gpa\": 1.0 + 0.000001, \"letter_grade\": \"D+\"},\n    {\"min_gpa\": 0.7 + 0.000001, \"letter_grade\": \"D\"},\n    {\"min_gpa\": 0.0 + 0.000001, \"letter_grade\": \"D-\"}, # Slightly above 0.0 for D-\n    {\"min_gpa\": 0.0, \"letter_grade\": \"E\"},\n]\nclass GradeConverter:\n    def __init__(self):\n        # Sort the scale in descending order of min_gpa for efficient lookup.\n        self._grade_scale: list[GradeMapping] = sorted(\n            [GradeMapping(**data) for data in GRADE_SCALE_DATA],\n            key=lambda x: x.min_gpa,\n            reverse=True\n        )\n\n    def convert_gpa_to_letter(self, gpa: float) -> str:\n        \"\"\"Converts a single GPA to its corresponding letter grade.\"\"\"\n        # Clamp GPA to the valid range [0.0, 4.0].\n        clamped_gpa = max(0.0, min(4.0, gpa))\n\n        for grade_map in self._grade_scale:\n            if clamped_gpa >= grade_map.min_gpa:\n                return grade_map.letter_grade\n        return \"E\" # Fallback, though 0.0 is in scale so it should not be reached.\n\n    def convert_gpas_to_letters(self, gpas: list[float]) -> list[str]:\n        \"\"\"Converts a list of GPAs to a list of letter grades.\"\"\"\n        return [self.convert_gpa_to_letter(gpa) for gpa in gpas]\ndef numerical_letter_grade(grades):\n    \"\"\"Converts a list of student GPAs into a corresponding list of letter grades based on a defined scale.\"\"\"\n    validate_gpa_list(grades)\n    converter = GradeConverter()\n    return converter.convert_gpas_to_letters(grades)"}
{"task_id": "HumanEval/160", "solution": "class AlgebraError(Exception):\n    \"\"\"Base exception for algebra evaluation errors.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\nclass InvalidInputError(AlgebraError):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    pass\nclass ZeroDivisionErrorWrapper(AlgebraError):\n    \"\"\"Exception raised for division by zero errors during evaluation.\"\"\"\n    pass\ndef build_expression_string(operator: list[str], operand: list[int]) -> str:\n    \"\"\"\n    Constructs a valid algebraic expression string from the given operator and operand.\n    It interleaves operands and operators into a single string.\n    \"\"\"\n    expression_parts = []\n    for i in range(len(operand)):\n        expression_parts.append(str(operand[i]))\n        if i < len(operator):\n            expression_parts.append(operator[i])\n    return \"\".join(expression_parts)\ndef do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and\n    the second list is a list of integers. Use the two given lists to build the algebric\n    expression and return the evaluation of this expression.\n\n    The basic algebra operations:\n    Addition ( + )\n    Subtraction ( - )\n    Multiplication ( * )\n    Floor division ( // )\n    Exponentiation ( ** )\n\n    Example:\n    operator['+', '*', '-']\n    array = [2, 3, 4, 5]\n    result = 2 + 3 * 4 - 5\n    => result = 9\n\n    Note:\n        The length of operator list is equal to the length of operand list minus one.\n        Operand is a list of of non-negative integers.\n        Operator list has at least one operator, and operand list has at least two operands.\n\n    \"\"\"\n    validate_inputs(operator, operand)\n    expression_string = build_expression_string(operator, operand)\n\n    try:\n        result = eval(expression_string)\n        return float(result)\n    except ZeroDivisionError:\n        raise ZeroDivisionErrorWrapper(\"Division by zero occurred in the expression.\")\n    except Exception as e:\n        # Catch other potential eval errors, though validation should prevent most syntax issues.\n        raise InvalidInputError(f\"Error evaluating expression: {e}\")"}
