{"task_id": "HumanEval/62", "solution": "def derivative(xs: list) -> list:\n    \"\"\"Calculates the derivative of a polynomial represented by coefficients.\n    xs[i] is the coefficient for x^i. Returns derivative coefficients in the same form.\n    \"\"\"\n    if not isinstance(xs, list):\n        raise ValueError(\"Input must be a list.\")\n    if not all(isinstance(c, (int, float)) for c in xs):\n        raise ValueError(\"All coefficients must be numeric (int or float).\")\n\n    if not xs or len(xs) == 1:\n        return []\n\n    derivative_coeffs: list[int | float] = []\n    for i in range(1, len(xs)):\n        derivative_coeffs.append(i * xs[i])\n\n    return derivative_coeffs"}
{"task_id": "HumanEval/62", "solution": "from typing import List, Union\ndef derivative(xs: list) -> List[Union[int, float]]:\n    \"\"\"\n    Calculates the derivative of a polynomial represented by coefficients.\n    Coefficients `xs[i]` correspond to the `x^i` term.\n    \"\"\"\n    # If the polynomial is constant (e.g., P(x) = 5) or empty, its derivative is an empty polynomial.\n    if not xs or len(xs) == 1:\n        return []\n\n    derivative_coeffs = []\n    # For a term c_i * x^i, its derivative is i * c_i * x^(i-1).\n    for i in range(1, len(xs)):\n        derivative_coeffs.append(i * xs[i])\n\n    return derivative_coeffs"}
{"task_id": "HumanEval/63", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to the fibfib function.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n_fibfib_memo = {\n    0: 0,\n    1: 0,\n    2: 1\n}\ndef fibfib(n: int):\n    \"\"\"The FibFib number sequence is defined as fibfib(n) = fibfib(n-1) + fibfib(n-2) + fibfib(n-3) for n > 2.\n    This function efficiently computes the n-th element, handling base cases and invalid inputs.\n    \"\"\"\n    if n < 0:\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n\n    if n in _fibfib_memo:\n        return _fibfib_memo[n]\n\n    result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n    _fibfib_memo[n] = result\n    return result"}
{"task_id": "HumanEval/63", "solution": "from typing import Dict\nclass FibFibCalculator:\n    \"\"\"Manages the state (memoization cache) and logic for computing FibFib numbers.\n    The memoization cache ensures O(n) time complexity.\n    \"\"\"\n    def __init__(self):\n        \"\"\"Initializes the memoization dictionary to an empty state.\"\"\"\n        self.memo: Dict[int, int] = {}\n\n    def _fibfib_recursive(self, n: int) -> int:\n        \"\"\"Private recursive helper method for the FibFib sequence with memoization.\n        It computes and stores new results in the memo.\n        \"\"\"\n        if n in self.memo:\n            return self.memo[n]\n\n        if n == 0:\n            result = 0\n        elif n == 1:\n            result = 0\n        elif n == 2:\n            result = 1\n        else:\n            result = self._fibfib_recursive(n - 1) + self._fibfib_recursive(n - 2) + self._fibfib_recursive(n - 3)\n\n        self.memo[n] = result\n        return result\n\n    def calculate(self, n: int) -> int:\n        \"\"\"Public method to compute the n-th FibFib number.\n        It validates input and delegates to the recursive helper.\n        \"\"\"\n        if n < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\n        return self._fibfib_recursive(n)\ndef fibfib(n: int) -> int:\n    \"\"\"The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    >>> fibfib(1)\n    0\n    >>> fibfib(5)\n    4\n    >>> fibfib(8)\n    24\n    \"\"\"\n    # Each call to fibfib(n) creates a new FibFibCalculator instance as per design.\n    calculator = FibFibCalculator()\n    return calculator.calculate(n)"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts vowels in a string s, handling 'y' as a vowel only if it's the last character.\n    The counting is case-insensitive for all vowels.\"\"\"\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'} # Define standard vowels for efficient lookup.\n\n    if not s:\n        return 0\n\n    vowel_count = 0\n    s_lower = s.lower() # Convert the entire string to lowercase once for case-insensitivity.\n\n    for i, char in enumerate(s_lower):\n        if char in standard_vowels:\n            vowel_count += 1\n        # Apply the 'y' vowel rule: 'y' is a vowel only if it is the last character.\n        elif char == 'y' and i == len(s_lower) - 1:\n            vowel_count += 1\n            \n    return vowel_count"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    >>> vowels_count(\"\")\n    0\n    >>> vowels_count(\"rhythm\")\n    1\n    >>> vowels_count(\"AEIOU\")\n    5\n    >>> vowels_count(\"fly\")\n    1\n    >>> vowels_count(\"mystery\")\n    1\n    >>> vowels_count(\"AbCdEfY\")\n    3\n    >>> vowels_count(\"supercalifragilisticexpialidocious\")\n    16\n    >>> vowels_count(\"h3ll0 w0rld!\")\n    1\n    \"\"\"\n\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    vowel_count = 0\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n    word_lower = s.lower()\n    word_length = len(word_lower)\n\n    for i, char in enumerate(word_lower):\n        if char in standard_vowels:\n            vowel_count += 1\n        elif char == 'y' and i == word_length - 1:\n            vowel_count += 1\n            \n    return vowel_count"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x to the right by shift, returning the result as a string.\n    If shift exceeds the number of digits, the absolute value of x's digits are reversed.\"\"\"\n\n    is_negative = x < 0\n    abs_x_str = str(abs(x))\n    num_digits = len(abs_x_str)\n\n    if shift > num_digits:\n        # If shift is strictly greater than the number of digits, reverse the digits.\n        shifted_str = abs_x_str[::-1]\n    else:\n        # Perform a circular right shift.\n        effective_shift = shift % num_digits\n        shifted_str = abs_x_str[-effective_shift:] + abs_x_str[:-effective_shift]\n\n    # Prepend the minus sign if the original number was negative and not zero.\n    if is_negative and abs(x) != 0:\n        return \"-\" + shifted_str\n    else:\n        return shifted_str"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"\n    Circularly shifts the digits of an integer to the right by a specified amount.\n    If the shift amount exceeds the number of digits, the digits are reversed.\n    \"\"\"\n    if not isinstance(x, int) or not isinstance(shift, int):\n        raise TypeError(\"Both x and shift must be integers.\")\n\n    s = str(x)\n    sign = ''\n    if s.startswith('-'):\n        sign = '-'\n        s = s[1:] # Extract the absolute digits string for manipulation.\n\n    num_digits = len(s)\n\n    # FR3: If shift is strictly greater than the number of digits, reverse.\n    if shift > num_digits:\n        result_digits = s[::-1]\n    # FR4: Otherwise (shift <= number of digits), perform a circular right shift.\n    else:\n        effective_shift = shift % num_digits\n        result_digits = s[num_digits - effective_shift:] + s[:num_digits - effective_shift]\n\n    # FR5: Return the final result as a string, prepending the sign if necessary.\n    return sign + result_digits"}
