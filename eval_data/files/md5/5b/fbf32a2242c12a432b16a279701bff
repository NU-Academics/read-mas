{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\"\n    For a given number n, find the largest number that divides n evenly, smaller than n.\n    Raises: ValueError: If n is not a positive integer greater than 1.\n    \"\"\"\n    if not (isinstance(n, int) and n > 1):\n        raise ValueError(\"Input 'n' must be a positive integer greater than 1.\")\n\n    for i in range(n // 2, 0, -1):\n        if n % i == 0:\n            return i\n    return 1"}
{"task_id": "HumanEval/25", "solution": "from typing import List\ndef factorize(n: int) -> List[int]:\n    \"\"\"\n    Computes the prime factors of a given integer n.\n    Returns a list of prime factors in ascending order, with multiplicities.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Invalid input: n must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"Invalid input: n must be a positive integer.\")\n    if n == 1:\n        return []\n\n    factors: List[int] = []\n    d = 2\n    temp_n = n\n\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 1\n    if temp_n > 1:\n        factors.append(temp_n)\n    return factors"}
{"task_id": "HumanEval/25", "solution": "from typing import List\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to the factorize function.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef factorize(n: int) -> List[int]:\n    \"\"\"\n    Returns a list of prime factors for a given integer `n`, in ascending order with multiplicity.\n    Each factor is listed as many times as it divides the original number.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n <= 0:\n        raise InvalidInputError(\"Input must be a positive integer.\")\n    if n == 1:\n        return []\n\n    factors: List[int] = []\n    d = 2\n    temp_n = n\n\n    while d * d <= temp_n: # Optimized trial division: only check divisors up to sqrt(n).\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 1\n\n    if temp_n > 1: # If temp_n is still greater than 1, it must be the remaining prime factor.\n        factors.append(temp_n)\n\n    return factors"}
{"task_id": "HumanEval/24", "solution": "from math import isqrt\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef largest_divisor(n: int) -> int:\n    \"\"\"\n    Finds the largest number that divides n evenly, smaller than n.\n    Raises TypeError if n is not an integer, InvalidInputError if n <= 1.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n <= 1:\n        raise InvalidInputError(\"Input 'n' must be greater than 1 to have a proper divisor.\")\n\n    # Iterate from 2 up to the integer square root of n.\n    # The first divisor 'i' found will yield n // i as the largest proper divisor.\n    for i in range(2, isqrt(n) + 1):\n        if n % i == 0:\n            return n // i\n    \n    # If no divisors are found, 'n' is prime, so its largest proper divisor is 1.\n    return 1"}
{"task_id": "HumanEval/26", "solution": "from typing import List\nfrom collections import Counter\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    # Count occurrences of each element in the input list.\n    counts = Counter(numbers)\n\n    # Build a new list with elements that appeared exactly once, preserving their original order.\n    result = [item for item in numbers if counts[item] == 1]\n    return result"}
