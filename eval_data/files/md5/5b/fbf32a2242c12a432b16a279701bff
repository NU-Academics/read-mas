{"task_id": "HumanEval/152", "solution": "def compare(game, guess):\n    \"\"\"Determines how far off each guess was for a series of matches.\n    Returns an array where 0 indicates a correct guess and a positive integer is the absolute difference.\n    \"\"\"\n    if len(game) != len(guess):\n        raise ValueError(\"Input arrays must be of equal length.\")\n\n    differences = []\n    for i in range(len(game)):\n        differences.append(abs(game[i] - guess[i]))\n    return differences"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num: int) -> tuple[int, int]:\n    \"\"\"\n    Counts the number of even and odd digits in an integer.\n    Handles negative numbers by using their absolute value and treats 0 as one even digit.\n    \"\"\"\n    if not isinstance(num, int):\n        raise TypeError(\"Input must be an integer.\")\n\n    if num == 0:\n        return (1, 0)\n\n    even_count = 0\n    odd_count = 0\n\n    num_str = str(abs(num))\n\n    for digit_char in num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/120", "solution": "from typing import List\ndef maximum(arr: List[int], k: int) -> List[int]:\n    \"\"\"\n    Given an array arr of integers and a non-negative integer k, returns a sorted list\n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise TypeError(\"All elements in 'arr' must be integers.\")\n    if not isinstance(k, int):\n        raise TypeError(\"Input 'k' must be an integer.\")\n\n    if not (0 <= k <= len(arr)):\n        raise ValueError(f\"Input 'k' must be between 0 and {len(arr)} (inclusive).\")\n\n    if k == 0:\n        return []\n\n    # Sort the array in descending order to find the largest elements quickly.\n    arr_sorted_desc = sorted(arr, reverse=True)\n\n    # Select the top k elements and then sort them in ascending order for the final result.\n    top_k_elements = arr_sorted_desc[:k]\n    return sorted(top_k_elements)"}
{"task_id": "HumanEval/85", "solution": "def add(lst: list[int]) -> int:\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\n\n    Examples:\n        add([4, 2, 6, 7]) ==> 2\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input 'lst' must be a list.\")\n    if not lst:\n        raise ValueError(\"Input 'lst' cannot be empty.\")\n\n    total_sum = 0\n    for i, element in enumerate(lst):\n        if not isinstance(element, int):\n            raise TypeError(f\"List element at index {i} is not an integer: {element}\")\n        if i % 2 != 0 and element % 2 == 0:\n            total_sum += element\n    return total_sum"}
