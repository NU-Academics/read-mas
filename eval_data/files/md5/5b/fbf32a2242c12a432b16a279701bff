{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    an integer part and decimals. Return the decimal part of the number.\n    \"\"\"\n    if not isinstance(number, float):\n        raise ValueError(\"Input must be a floating-point number.\")\n    if number < 0:\n        raise ValueError(\"Input number must be positive.\")\n\n    return number - int(number)"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separates a string of balanced parenthesis groups into a list of individual group strings, ignoring spaces.\n    Groups are balanced and not nested at the top level of separation.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    if not isinstance(paren_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    cleaned_string = paren_string.replace(\" \", \"\")\n    \n    groups = []\n    balance = 0\n    start_index = 0\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n\n        # If balance is zero, we've found a complete, top-level balanced group.\n        # This condition extracts the segment from the last start_index.\n        if balance == 0 and i >= start_index:\n            groups.append(cleaned_string[start_index : i + 1])\n            start_index = i + 1\n    \n    return groups"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Input to this function is a string containing multiple groups of nested parentheses.\n    It separates these groups into separate strings, ensuring they are balanced, not nested, and ignores spaces.\n    \"\"\"\n    result = []\n    balance = 0\n    current_group_start = 0\n    cleaned_string = paren_string.replace(\" \", \"\")\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        # Ignore any other characters as per implicit assumption in design\n\n        if balance == 0 and current_group_start <= i:\n            # A balanced top-level group is found.\n            group = cleaned_string[current_group_start : i + 1]\n            result.append(group)\n            current_group_start = i + 1\n        elif balance < 0:\n            # Unbalanced closing parenthesis, reset and start looking for a new group.\n            balance = 0\n            current_group_start = i + 1\n    \n    return result"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input 'numbers' must be a list.\")\n    if not isinstance(threshold, (int, float)):\n        raise TypeError(\"Input 'threshold' must be a number.\")\n    if threshold < 0:\n        raise ValueError(\"Input 'threshold' cannot be negative.\")\n\n    # Convert numbers to floats and validate elements in a single pass.\n    processed_numbers = []\n    for i, num in enumerate(numbers):\n        if not isinstance(num, (int, float)):\n            raise ValueError(f\"Element at index {i} in 'numbers' is not a float: {num}\")\n        processed_numbers.append(float(num))\n\n    n = len(processed_numbers)\n    if n < 2:\n        return False\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(processed_numbers[i] - processed_numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"Check if any two numbers in the list are closer than the threshold.\n    Raises TypeError or ValueError for invalid inputs.\"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input 'numbers' must be a list.\")\n    # Allow ints as they are implicitly convertible to floats for comparison.\n    if not all(isinstance(n, (int, float)) for n in numbers):\n        raise ValueError(\"All elements in 'numbers' must be numeric.\")\n    if not isinstance(threshold, float):\n        raise TypeError(\"Input 'threshold' must be a float.\")\n    if threshold < 0:\n        raise ValueError(\"Input 'threshold' must be non-negative.\")\n\n    if len(numbers) < 2:\n        return False\n\n    # Sort the list to enable O(N log N) performance by checking only adjacent elements.\n    sorted_numbers = sorted(numbers)\n\n    for i in range(len(sorted_numbers) - 1):\n        if abs(sorted_numbers[i] - sorted_numbers[i + 1]) < threshold:\n            return True\n    return False"}
{"task_id": "HumanEval/2", "solution": "import math\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    an integer part and decimals (leftover part always smaller than 1).\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    integer_part = math.floor(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/3", "solution": "from typing import List\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"\n    Checks if the account balance ever falls below zero given a list of operations.\n    The account starts with a zero balance.\n    \"\"\"\n    current_balance = 0\n    for op in operations:\n        current_balance += op\n        if current_balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"Calculates the Mean Absolute Deviation (MAD) for a list of numbers around their mean.\n    Returns 0.0 if the input list is empty, as per specification.\"\"\"\n    if not numbers:\n        return 0.0\n\n    mean = sum(numbers) / len(numbers)\n    absolute_differences = [abs(x - mean) for x in numbers]\n    mad = sum(absolute_differences) / len(absolute_differences)\n    return mad"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"\n    Insert a number 'delimeter' between every two consecutive elements of input list `numbers`.\n    Returns an empty list for empty input, and the original list for single-element input.\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/4", "solution": "from typing import List\nclass EmptyInputError(ValueError):\n    \"\"\"Custom exception raised when an input list is empty.\"\"\"\n    pass\ndef _calculate_mean(numbers: List[float]) -> float:\n    \"\"\"\n    Calculates the arithmetic mean of a list of floating-point numbers.\n    Raises EmptyInputError if the input list is empty.\n    \"\"\"\n    if not numbers:\n        raise EmptyInputError(\"Input list for mean calculation cannot be empty.\")\n    return sum(numbers) / len(numbers)\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        raise EmptyInputError(\"Input list for MAD calculation cannot be empty.\")\n\n    mean = _calculate_mean(numbers)\n    absolute_differences = [abs(x - mean) for x in numbers]\n    return sum(absolute_differences) / len(numbers)"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers`\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/6", "solution": "from typing import List\nclass NestingCalculator:\n    def calculate_max_depth(self, group_string: str) -> int:\n        max_depth = 0\n        current_depth = 0\n        for char in group_string:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                # Decrement depth only if positive to avoid negative counts for malformed groups.\n                if current_depth > 0:\n                    current_depth -= 1\n        return max_depth\nclass ParserService:\n    def __init__(self, calculator: NestingCalculator):\n        self._calculator = calculator\n\n    def parse(self, paren_string: str) -> List[int]:\n        if not paren_string.strip():\n            return []\n        \n        # Split the input string into groups, handling multiple spaces as delimiters.\n        groups = paren_string.split(' ') \n        results = []\n        for group in groups:\n            if group: # Process only non-empty group strings after splitting.\n                results.append(self._calculator.calculate_max_depth(group))\n        return results\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    calculator = NestingCalculator()\n    service = ParserService(calculator)\n    return service.parse(paren_string)"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef _calculate_max_depth(group: str) -> int:\n    \"\"\"Calculates the deepest nesting level for a single group of parentheses.\n    It tracks the maximum depth encountered, even for malformed groups.\n    \"\"\"\n    max_depth = 0\n    current_depth = 0\n    for char in group:\n        if char == '(':\n            current_depth += 1\n            max_depth = max(max_depth, current_depth)\n        elif char == ')':\n            current_depth -= 1\n            # Current_depth can go negative for unbalanced groups, but max_depth retains its highest value.\n    return max_depth\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Parses a string of space-separated parentheses groups to find the deepest nesting level for each.\n    Returns a list of integers representing these maximum depths.\n    \"\"\"\n    if not paren_string.strip():\n        return []\n\n    groups = paren_string.split(' ')\n    results = []\n    for group in groups:\n        if group: # Only process non-empty groups\n            results.append(_calculate_max_depth(group))\n    return results"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\"For a given list of integers, return a tuple consisting of a sum and a product\n    of all the integers in the list. An empty list returns sum 0 and product 1.\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/7", "solution": "from typing import List\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring.\n    This function leverages Python's 'in' operator for efficient substring checking.\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/9", "solution": "from typing import List\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\"From a given list of integers, generate a list of rolling maximum elements\n    found until the given moment in the sequence.\"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n    if not all(isinstance(x, int) for x in numbers):\n        raise ValueError(\"All elements in the list must be integers.\")\n\n    if not numbers:\n        return []\n\n    rolling_max_list: List[int] = []\n    current_max: int = float('-inf')\n\n    for number in numbers:\n        if number > current_max:\n            current_max = number\n        rolling_max_list.append(current_max)\n\n    return rolling_max_list"}
{"task_id": "HumanEval/9", "solution": "from typing import List\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\"\n    From a given list of integers, generate a list of rolling maximum element found\n    until the given moment in the sequence.\n    \"\"\"\n    if not isinstance(numbers, List):\n        raise TypeError(f\"'numbers' must be a list, but got {type(numbers).__name__}\")\n    for i, item in enumerate(numbers):\n        if not isinstance(item, int):\n            raise TypeError(f\"Element at index {i} in 'numbers' must be an integer, but got {type(item).__name__}\")\n\n    if not numbers:\n        return []\n\n    rolling_max_list: List[int] = []\n    # Initialize current_max with negative infinity to ensure the first element is correctly picked.\n    current_max: int = float('-inf')  # type: ignore\n\n    for number in numbers:\n        if number > current_max:\n            current_max = number\n        rolling_max_list.append(current_max)\n    \n    return rolling_max_list"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\"Performs bitwise XOR on two binary strings.\n    Validates inputs for binary content, non-emptiness, and equal length, raising ValueError on failure.\"\"\"\n\n    if not a:\n        raise ValueError(\"Input string cannot be empty.\")\n    if not all(c in '01' for c in a):\n        raise ValueError(f\"String '{a}' contains non-binary characters. Only '0' and '1' are allowed.\")\n\n    if not b:\n        raise ValueError(\"Input string cannot be empty.\")\n    if not all(c in '01' for c in b):\n        raise ValueError(f\"String '{b}' contains non-binary characters. Only '0' and '1' are allowed.\")\n\n    if len(a) != len(b):\n        raise ValueError(f\"Input strings must have the same length. Got {len(a)} and {len(b)}.\")\n\n    result = []\n    for i in range(len(a)):\n        bit_a = int(a[i])\n        bit_b = int(b[i])\n        result.append(str(bit_a ^ bit_b))\n    return \"\".join(result)"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    The algorithm finds the longest palindromic postfix and appends the reversed prefix preceding it.\n    \"\"\"\n    if not string:\n        return \"\"\n\n    longest_palindromic_postfix_len = 0\n    for i in range(len(string)):\n        suffix = string[i:]\n        # Assume is_palindrome is available in the execution environment\n        if is_palindrome(suffix):\n            longest_palindromic_postfix_len = len(suffix)\n            break\n\n    prefix_to_reverse = string[:len(string) - longest_palindromic_postfix_len]\n    return string + prefix_to_reverse[::-1]"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Finds the longest string in a list, returning the first one in case of a tie or None for an empty list.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_str: Optional[str] = None\n    max_length: int = -1\n\n    for s in strings:\n        if longest_str is None or len(s) > max_length:\n            longest_str = s\n            max_length = len(s)\n    return longest_str"}
{"task_id": "HumanEval/11", "solution": "class InvalidBinaryStringError(ValueError):\n    \"\"\"Custom exception for invalid binary string input.\n    Raised when a string contains characters other than '0' or '1'.\n    \"\"\"\n    def __init__(self, message: str = \"Input string contains non-binary characters.\"):\n        super().__init__(message)\ndef string_xor(a: str, b: str) -> str:\n    \"\"\"Performs bitwise XOR operation on two binary strings, padding with leading zeros if lengths differ.\n    Raises InvalidBinaryStringError if inputs contain non-binary characters.\n    \"\"\"\n    # Validate that input strings a and b contain only '0' or '1' characters.\n    for char in a:\n        if char not in '01':\n            raise InvalidBinaryStringError(f\"String '{a}' contains non-binary characters.\")\n    for char in b:\n        if char not in '01':\n            raise InvalidBinaryStringError(f\"String '{b}' contains non-binary characters.\")\n\n    # Handle strings of different lengths by padding the shorter string with leading zeros.\n    len_a = len(a)\n    len_b = len(b)\n\n    if len_a > len_b:\n        b = '0' * (len_a - len_b) + b\n    elif len_b > len_a:\n        a = '0' * (len_b - len_a) + a\n\n    # Perform a bitwise XOR operation and return the result as a binary string.\n    result = []\n    for bit_a, bit_b in zip(a, b):\n        result.append('1' if bit_a != bit_b else '0')\n\n    return \"\".join(result)"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n    if not string:\n        return \"\"\n\n    longest_palindromic_suffix_len = 0\n    for j in range(len(string)):\n        suffix = string[j:]\n        if is_palindrome(suffix):\n            longest_palindromic_suffix_len = len(suffix)\n            break\n\n    prefix_to_reverse = string[:-longest_palindromic_suffix_len]\n    return string + prefix_to_reverse[::-1]"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b.\n    It uses the Euclidean algorithm and handles zero or negative inputs correctly.\n    \"\"\"\n    while b:\n        a, b = b, a % b\n    return abs(a)"}
{"task_id": "HumanEval/14", "solution": "from typing import List\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n        \n    prefixes = []\n    # Iterate to generate substrings from the start, growing by one character each time.\n    for i in range(1, len(string) + 1):\n        prefixes.append(string[:i])\n    return prefixes"}
{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\"Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    It performs validation for input type and value as specified.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    return \" \".join(str(i) for i in range(n + 1))"}
{"task_id": "HumanEval/14", "solution": "from typing import List\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\"Return list of all prefixes from shortest to longest of the input string.\n    Example: all_prefixes('abc') returns ['a', 'ab', 'abc'].\"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n    return [string[0:i+1] for i in range(len(string))]"}
{"task_id": "HumanEval/13", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception raised for invalid input types or values.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\"Returns the greatest common divisor of two integers a and b.\n    Handles negative inputs by taking their absolute values, and GCD(0, 0) returns 0.\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise InvalidInputError(\"Inputs 'a' and 'b' must be integers.\")\n\n    if a == 0 and b == 0:\n        return 0\n\n    # The Euclidean algorithm works with non-negative numbers.\n    # GCD(a, b) = GCD(|a|, |b|)\n    abs_a = abs(a)\n    abs_b = abs(b)\n\n    # Euclidean algorithm implementation\n    while abs_b:\n        abs_a, abs_b = abs_b, abs_a % abs_b\n    return abs_a"}
{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\"Return a space-delimited string of numbers from 0 to n (inclusive).\n    Raises ValueError if n is negative.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    return \" \".join(map(str, range(n + 1)))"}
{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of.\n    This function converts the input to lowercase and uses a set to count unique characters.\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    return len(set(string.lower()))"}
{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\"\n    Counts the number of distinct characters in a string, ignoring case.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    # Convert the string to lowercase and use a set to count unique characters.\n    return len(set(string.lower()))"}
{"task_id": "HumanEval/17", "solution": "from typing import List, Dict\nfrom enum import Enum\nclass InvalidMusicStringError(Exception):\n    \"\"\"Custom exception for invalid music string input.\"\"\"\n    pass\nclass NoteType(Enum):\n    WHOLE = \"o\"\n    HALF = \"o|\"\n    QUARTER = \".|\"\nNOTE_BEAT_MAP: Dict[str, int] = {\n    NoteType.WHOLE.value: 4,\n    NoteType.HALF.value: 2,\n    NoteType.QUARTER.value: 1,\n}\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\"Parses a string of musical notes into their beat durations based on predefined mappings.\n    Raises InvalidMusicStringError for invalid input or unrecognized note representations.\"\"\"\n    if not music_string:\n        raise InvalidMusicStringError(\"Input music string cannot be empty or None.\")\n\n    notes = music_string.split(' ')\n    beat_durations: List[int] = []\n\n    for note_str in notes:\n        if not note_str:\n            continue\n        beat = NOTE_BEAT_MAP.get(note_str)\n        if beat is None:\n            raise InvalidMusicStringError(f\"Unrecognized note representation: '{note_str}'\")\n        beat_durations.append(beat)\n\n    return beat_durations"}
{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\"Find how many times a given substring can be found in the original string. Count overlaping cases.\n    \"\"\"\n    if not isinstance(string, str) or not isinstance(substring, str):\n        raise TypeError(\"Both 'string' and 'substring' must be of type str.\")\n\n    if not substring:\n        return len(string) + 1\n\n    count = 0\n    # Iterate through the string, checking for substring matches at each position.\n    # The loop range ensures the substring can fit completely.\n    for i in range(len(string) - len(substring) + 1):\n        if string[i:i+len(substring)] == substring:\n            count += 1\n    return count"}
{"task_id": "HumanEval/17", "solution": "from typing import List, Dict\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\"Parses a musical ASCII string into a list of beat durations.\n    Unknown characters and spaces are ignored during parsing.\"\"\"\n\n    NOTE_BEAT_MAP: Dict[str, int] = {\n        'o': 4,    # whole note\n        'o|': 2,   # half note\n        '.|': 1    # quarter note\n    }\n\n    if not music_string:\n        return []\n\n    beats: List[int] = []\n    i = 0\n    while i < len(music_string):\n        matched = False\n        # Prioritize matching longer patterns first to prevent partial matches.\n        for pattern, duration in sorted(NOTE_BEAT_MAP.items(), key=lambda item: len(item[0]), reverse=True):\n            if music_string[i:].startswith(pattern):\n                beats.append(duration)\n                i += len(pattern)\n                matched = True\n                break\n\n        if not matched:\n            # Ignore spaces and any unrecognized characters.\n            i += 1\n\n    return beats"}
{"task_id": "HumanEval/20", "solution": "from typing import List, Tuple\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input scenarios.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef find_closest_elements(numbers: List[float]) -> Tuple[float, float]:\n    \"\"\"\n    Identifies the two numbers from a list that are closest to each other,\n    returning them in ascending order.\n    \"\"\"\n    # Validate input list type and minimum length as per FR1 and FR4.\n    if not isinstance(numbers, list):\n        raise InvalidInputError(\"Input must be a list\")\n    if len(numbers) < 2:\n        raise InvalidInputError(\"List must contain at least two numbers\")\n\n    # Validate elements are numerical and convert all to float for consistent processing.\n    numbers_as_floats: List[float] = []\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise InvalidInputError(\"List must contain only numbers\")\n        numbers_as_floats.append(float(num))\n\n    # Sort the list to efficiently find the closest pair, achieving O(N log N) (NFR1).\n    sorted_numbers = sorted(numbers_as_floats)\n\n    min_diff = float('inf')\n    closest_pair: Tuple[float, float] = (0.0, 0.0)\n\n    # Iterate through the sorted list to find the pair with the smallest difference (FR2).\n    for i in range(len(sorted_numbers) - 1):\n        diff = sorted_numbers[i+1] - sorted_numbers[i]\n        if diff < min_diff:\n            min_diff = diff\n            closest_pair = (sorted_numbers[i], sorted_numbers[i+1])\n    \n    # The pair is already in ascending order due to sorting (FR3).\n    return closest_pair"}
{"task_id": "HumanEval/19", "solution": "from typing import List, Dict, Set\nclass NumberWordMapper:\n    \"\"\"Manages bidirectional mapping between number words and integers.\"\"\"\n    WORD_TO_INT_MAP: Dict[str, int] = {\n        'zero': 0, 'one': 1, 'two': 2, 'three': 3, 'four': 4,\n        'five': 5, 'six': 6, 'seven': 7, 'eight': 8, 'nine': 9\n    }\n    INT_TO_WORD_MAP: Dict[int, str] = {\n        0: 'zero', 1: 'one', 2: 'two', 3: 'three', 4: 'four',\n        5: 'five', 6: 'six', 7: 'seven', 8: 'eight', 9: 'nine'\n    }\n\n    def word_to_int(self, word: str) -> int:\n        \"\"\"Converts a number word to its integer value.\"\"\"\n        return self.WORD_TO_INT_MAP[word]\n\n    def int_to_word(self, num: int) -> str:\n        \"\"\"Converts an integer to its number word.\"\"\"\n        return self.INT_TO_WORD_MAP[num]\n\n    def get_valid_words(self) -> Set[str]:\n        \"\"\"Returns a set of all valid number words.\"\"\"\n        return set(self.WORD_TO_INT_MAP.keys())\nclass InputValidator:\n    \"\"\"Validates input number words against a set of known valid words.\"\"\"\n    def validate_number_words(self, words: List[str], valid_words: Set[str]) -> None:\n        \"\"\"Checks if all words in the list are valid. Raises ValueError for invalid words.\"\"\"\n        for word in words:\n            if word not in valid_words:\n                raise ValueError(f\"Invalid number word found: '{word}'. Valid words are: {', '.join(sorted(valid_words))}\")\nclass NumberSorterService:\n    \"\"\"Orchestrates the sorting process for number words.\"\"\"\n    def __init__(self, mapper: NumberWordMapper, validator: InputValidator) -> None:\n        \"\"\"Initializes the service with a mapper and validator.\"\"\"\n        self.mapper = mapper\n        self.validator = validator\n\n    def sort_number_words(self, numbers_str: str) -> str:\n        \"\"\"Parses, validates, sorts, and formats the number words string.\"\"\"\n        if not numbers_str:\n            return \"\"\n\n        words = self._parse_and_validate(numbers_str)\n        ints = self._convert_words_to_ints(words)\n        ints.sort()\n        sorted_words = self._convert_ints_to_words(ints)\n        return \" \".join(sorted_words)\n\n    def _parse_and_validate(self, numbers_str: str) -> List[str]:\n        \"\"\"Splits the input string into words and validates them.\"\"\"\n        words = numbers_str.split(' ')\n        self.validator.validate_number_words(words, self.mapper.get_valid_words())\n        return words\n\n    def _convert_words_to_ints(self, words: List[str]) -> List[int]:\n        \"\"\"Converts a list of number words to a list of integers.\"\"\"\n        return [self.mapper.word_to_int(word) for word in words]\n\n    def _convert_ints_to_words(self, ints: List[int]) -> List[str]:\n        \"\"\"Converts a list of integers back to a list of number words.\"\"\"\n        return [self.mapper.int_to_word(num) for num in ints]\n_number_word_mapper = NumberWordMapper()\n_input_validator = InputValidator()\n_number_sorter_service = NumberSorterService(mapper=_number_word_mapper, validator=_input_validator)\ndef sort_numbers(numbers: str) -> str:\n    \"\"\"\n    Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest.\n    \"\"\"\n    if not isinstance(numbers, str):\n        raise TypeError(\"Input 'numbers' must be a string.\")\n    return _number_sorter_service.sort_number_words(numbers)"}
{"task_id": "HumanEval/20", "solution": "from typing import List, Tuple\nclass ClosestElementsError(Exception):\n    \"\"\"Base exception for the closest_elements package.\n    It provides a common base for custom errors in this utility.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass InvalidInputError(ClosestElementsError):\n    \"\"\"Raised when the input list is invalid (e.g., too short).\n    This error indicates that the input does not meet the minimum length requirement.\"\"\"\n    def __init__(self, message: str = \"Input list must contain at least two elements.\"):\n        super().__init__(message)\ndef find_closest_elements(numbers: List[float]) -> Tuple[float, float]:\n    \"\"\" From a supplied list of numbers (of length at least two) select and return two that are the closest to each\n    other and return them in order (smaller number, larger number).\n    \"\"\"\n    if len(numbers) < 2:\n        raise InvalidInputError(\"Input list must contain at least two elements.\")\n\n    sorted_numbers = sorted(numbers)\n    min_diff = float('inf')\n    closest_pair = (0.0, 0.0)\n\n    for i in range(len(sorted_numbers) - 1):\n        diff = sorted_numbers[i+1] - sorted_numbers[i]\n        if diff < min_diff:\n            min_diff = diff\n            closest_pair = (sorted_numbers[i], sorted_numbers[i+1])\n        \n    return closest_pair"}
{"task_id": "HumanEval/21", "solution": "from typing import List\ndef rescale_to_unit(numbers: List[float]) -> List[float]:\n    \"\"\"Given a list of numbers (of at least two elements), apply a linear transform\n    such that the smallest number will become 0 and the largest will become 1.\n    \"\"\"\n    if len(numbers) < 2:\n        raise ValueError(\"Input list must contain at least two elements for rescaling.\")\n\n    min_val = min(numbers)\n    max_val = max(numbers)\n\n    if max_val == min_val:\n        # If all numbers are identical, rescale to all zeros.\n        return [0.0] * len(numbers)\n    else:\n        # Apply the linear transformation (x - min) / (max - min).\n        scale = 1.0 / (max_val - min_val)\n        return [(num - min_val) * scale for num in numbers]"}
{"task_id": "HumanEval/19", "solution": "import typing\nclass InvalidNumberWordError(ValueError):\n    \"\"\"Custom exception for invalid number words.\"\"\"\n    pass\nclass NumberWordMap:\n    \"\"\"\n    Provides a bidirectional mapping between number words and integers.\n    It supports retrieving integer for a word and word for an integer.\n    \"\"\"\n    def __init__(self, mapping: typing.Dict[str, int]):\n        self._word_to_int_map = mapping\n        self._int_to_word_map = {v: k for k, v in mapping.items()}\n\n    def get_int(self, word: str) -> int:\n        \"\"\"Retrieves the integer value for a given number word.\"\"\"\n        if word not in self._word_to_int_map:\n            raise InvalidNumberWordError(f\"Unknown number word: '{word}'\")\n        return self._word_to_int_map[word]\n\n    def get_word(self, num: int) -> str:\n        \"\"\"Retrieves the number word for a given integer.\"\"\"\n        if num not in self._int_to_word_map:\n            raise ValueError(f\"Unknown integer: '{num}'\")\n        return self._int_to_word_map[num]\nNUMBER_WORD_MAP_DATA = {\n    \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n    \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9\n}\nDEFAULT_NUMBER_WORD_MAP = NumberWordMap(NUMBER_WORD_MAP_DATA)\nclass WordToNumberConverter:\n    \"\"\"\n    Handles conversion between lists of number words and lists of integers.\n    It uses a NumberWordMap for the actual lookup operations.\n    \"\"\"\n    def __init__(self, word_map: NumberWordMap):\n        self._word_map = word_map\n\n    def words_to_numbers(self, word_list: typing.List[str]) -> typing.List[int]:\n        \"\"\"Converts a list of number words to a list of integers.\"\"\"\n        numbers = []\n        for word in word_list:\n            try:\n                numbers.append(self._word_map.get_int(word))\n            except InvalidNumberWordError as e:\n                raise e # Re-raise the error for external handling\n        return numbers\n\n    def numbers_to_words(self, num_list: typing.List[int]) -> typing.List[str]:\n        \"\"\"Converts a list of integers to a list of number words.\"\"\"\n        words = []\n        for num in num_list:\n            words.append(self._word_map.get_word(num))\n        return words\nclass NumberSorter:\n    \"\"\"\n    Orchestrates the sorting of space-delimited number words.\n    It delegates conversion tasks to a WordToNumberConverter.\n    \"\"\"\n    def __init__(self, converter: WordToNumberConverter):\n        self._converter = converter\n\n    def sort_numbers(self, numbers_str: str) -> str:\n        \"\"\"\n        Takes a space-delimited string of number words, sorts them,\n        and returns a space-delimited string of sorted number words.\n        \"\"\"\n        if not isinstance(numbers_str, str):\n            raise TypeError(\"Input must be a string.\")\n\n        if not numbers_str.strip():\n            return \"\"\n\n        word_list = numbers_str.split(' ')\n        \n        numeric_list = self._converter.words_to_numbers(word_list)\n        numeric_list.sort()\n        sorted_word_list = self._converter.numbers_to_words(numeric_list)\n        \n        return ' '.join(sorted_word_list)\n_number_word_converter = WordToNumberConverter(DEFAULT_NUMBER_WORD_MAP)\n_number_sorter_instance = NumberSorter(_number_word_converter)\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    return _number_sorter_instance.sort_numbers(numbers)"}
