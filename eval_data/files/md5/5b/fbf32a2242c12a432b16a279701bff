{"task_id": "HumanEval/91", "solution": "import re\ndef is_bored(S):\n    \"\"\"\n    Counts sentences starting with \"I\". Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    if not isinstance(S, str):\n        raise TypeError(\"Input must be a string.\")\n\n    # Split the text into segments based on sentence delimiters.\n    # The split method creates a list of strings between the delimiters.\n    sentences = re.split(r'[.?!]', S)\n\n    bored_count = 0\n    for sentence in sentences:\n        # Clean whitespace and convert to lowercase for case-insensitive check.\n        cleaned_sentence = sentence.strip().lower()\n        # Check if the sentence starts with 'i ' (ensuring 'i' is a standalone word)\n        # or if the entire cleaned sentence is just 'i' (e.g., for \"I.\")\n        if cleaned_sentence.startswith(\"i \") or cleaned_sentence == \"i\":\n            bored_count += 1\n    return bored_count"}
{"task_id": "HumanEval/91", "solution": "from typing import List\nSENTENCE_DELIMITERS = ['.', '?', '!']\nclass SentenceSplitter:\n    \"\"\"\n    Utility class for splitting text into sentences.\n    It splits text based on delimiters and trims resulting sentences.\n    \"\"\"\n    @staticmethod\n    def split(text: str, delimiters: List[str]) -> List[str]:\n        \"\"\"\n        Splits the given text into sentences using provided delimiters.\n        Returns a list of trimmed sentences, filtering out empty ones.\n        \"\"\"\n        if not text:\n            return []\n\n        # Replace delimiters with a unique marker to split reliably\n        temp_text = text\n        for delim in delimiters:\n            temp_text = temp_text.replace(delim, delim + \"###SENTENCE_END###\")\n\n        # Split by the marker, filter out empty strings, and strip whitespace\n        sentences = [\n            s.strip() for s in temp_text.split(\"###SENTENCE_END###\") if s.strip()\n        ]\n        return sentences\nclass BoredomDetector:\n    \"\"\"\n    Detects and counts \"boredom\" sentences in a given text.\n    A \"boredom\" is a sentence that starts with the word \"I\".\n    \"\"\"\n    def __init__(self, sentence_splitter: SentenceSplitter = None):\n        self._sentence_splitter = sentence_splitter or SentenceSplitter()\n\n    def count_boredoms(self, text: str) -> int:\n        \"\"\"\n        Counts sentences starting with \"I\" after splitting the text.\n        It uses the internal sentence splitter and checker.\n        \"\"\"\n        sentences = self._split_sentences(text)\n        boredom_count = 0\n        for sentence in sentences:\n            if self._is_bored_sentence(sentence):\n                boredom_count += 1\n        return boredom_count\n\n    def _split_sentences(self, text: str) -> List[str]:\n        \"\"\"\n        Splits the text into sentences using the configured splitter and delimiters.\n        \"\"\"\n        return self._sentence_splitter.split(text, SENTENCE_DELIMITERS)\n\n    def _is_bored_sentence(self, sentence: str) -> bool:\n        \"\"\"\n        Checks if a given sentence starts with \"I\" (case-insensitive).\n        It handles forms like \"I am\", \"I'm\", and \"I!\".\n        \"\"\"\n        if not sentence:\n            return False\n        first_word_lower = sentence.lower()\n        return first_word_lower.startswith(\"i \") or \\\n               first_word_lower == \"i\" or \\\n               (first_word_lower.startswith(\"i\") and not first_word_lower[1].isalpha())\ndef is_bored(S: str) -> int:\n    \"\"\"\n    Counts the number of boredoms in a string. A boredom is a sentence that starts with \"I\", delimited by '.', '?' or '!'.\n   \n    For example:\n    >>> is_bored(\"Hello world\")\n    0\n    >>> is_bored(\"The sky is blue. The sun is shining. I love this weather\")\n    1\n    \"\"\"\n    if not isinstance(S, str):\n        raise TypeError(\"Input must be a string.\")\n    \n    detector = BoredomDetector()\n    return detector.count_boredoms(S)"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping letter case and shifting vowels two places forward.\n    Assumes input contains English alphabet letters and may contain spaces (per examples).\n    \"\"\"\n    VOWELS = \"aeiouAEIOU\"\n    ALPHABET_LOWER = \"abcdefghijklmnopqrstuvwxyz\"\n    ALPHABET_UPPER = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n\n    encoded_chars = []\n    for char in message:\n        # First, swap the case of the character\n        processed_char = char\n        if char.islower():\n            processed_char = char.upper()\n        elif char.isupper():\n            processed_char = char.lower()\n        # Non-letters are unchanged here\n\n        # Second, replace vowels, if 'processed_char' is a vowel\n        if processed_char in VOWELS:\n            if processed_char.islower():\n                idx = ALPHABET_LOWER.find(processed_char)\n                processed_char = ALPHABET_LOWER[(idx + 2) % len(ALPHABET_LOWER)]\n            elif processed_char.isupper():\n                idx = ALPHABET_UPPER.find(processed_char)\n                processed_char = ALPHABET_UPPER[(idx + 2) % len(ALPHABET_UPPER)]\n        # Non-vowels (or non-letters) are unchanged here\n\n        encoded_chars.append(processed_char)\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower \n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    Examples:\n    check_dict_case({\"a\":\"apple\", \"b\":\"banana\"}) should return True.\n    check_dict_case({\"a\":\"apple\", \"A\":\"banana\", \"B\":\"banana\"}) should return False.\n    check_dict_case({\"a\":\"apple\", 8:\"banana\", \"a\":\"apple\"}) should return False.\n    check_dict_case({\"Name\":\"John\", \"Age\":\"36\", \"City\":\"Houston\"}) should return False.\n    check_dict_case({\"STATE\":\"NC\", \"ZIP\":\"12345\" }) should return True.\n    \"\"\"\n    if not isinstance(dict, dict):\n        raise TypeError(\"Input 'dict' must be a dictionary.\")\n\n    if not dict:\n        return False\n\n    keys = list(dict.keys())\n\n    if not all(isinstance(key, str) for key in keys):\n        return False\n\n    first_key = keys[0]\n    is_all_lower = first_key.islower()\n    is_all_upper = first_key.isupper()\n\n    # If the first key is not purely lower or purely upper (e.g., \"Key\", \"key1\"), it's not consistently cased.\n    # Also handles cases where the key might be digits or special characters and thus neither lower nor upper.\n    if not is_all_lower and not is_all_upper:\n        return False\n\n    for key in keys[1:]:\n        if (is_all_lower and not key.islower()) or \\\n           (is_all_upper and not key.isupper()):\n            return False\n\n    return True"}
{"task_id": "HumanEval/94", "solution": "import math\nclass PrimeChecker:\n    \"\"\"Utility class for determining if a number is prime.\"\"\"\n    def is_prime(self, n: int) -> bool:\n        \"\"\"Checks if the input integer n is a prime number. Returns True if prime, False otherwise.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\nclass PrimeService:\n    \"\"\"Core business logic for finding the largest prime and summing its digits.\"\"\"\n    def __init__(self, prime_checker: 'PrimeChecker'):\n        \"\"\"Initializes PrimeService with a PrimeChecker instance.\"\"\"\n        self.prime_checker = prime_checker\n\n    def find_largest_prime_and_sum_digits(self, lst: list[int]) -> int:\n        \"\"\"Finds the largest prime in a list and returns the sum of its digits.\"\"\"\n        largest_prime = None\n        for num in lst:\n            if self.prime_checker.is_prime(num):\n                if largest_prime is None or num > largest_prime:\n                    largest_prime = num\n        \n        if largest_prime is not None:\n            return self._sum_digits(largest_prime)\n        return 0\n\n    def _sum_digits(self, n: int) -> int:\n        \"\"\"Calculates the sum of the digits of a non-negative integer. Primes are positive, so abs is for general robustness.\"\"\"\n        s = 0\n        n_abs = abs(n) \n        while n_abs > 0:\n            s += n_abs % 10\n            n_abs //= 10\n        return s\ndef skjkasdkd(lst: list[int]) -> int:\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    prime_checker = PrimeChecker()\n    prime_service = PrimeService(prime_checker)\n    return prime_service.find_largest_prime_and_sum_digits(lst)"}
{"task_id": "HumanEval/94", "solution": "class PrimeUtils:\n    \"\"\"Utility functions for primality testing and digit summing.\"\"\"\n    @staticmethod\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if a given integer n is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    @staticmethod\n    def sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the digits of a given non-negative integer n.\"\"\"\n        digit_sum = 0\n        abs_n = abs(n)\n        while abs_n > 0:\n            digit_sum += abs_n % 10\n            abs_n //= 10\n        return digit_sum\nclass PrimeService:\n    \"\"\"Business logic for finding the largest prime and summing its digits.\"\"\"\n    @staticmethod\n    def find_largest_prime_and_sum_digits(lst: list[int]) -> int:\n        \"\"\"Finds the largest prime in a list and sums its digits, returning 0 if no primes.\"\"\"\n        largest_prime = None\n        for num in lst:\n            if PrimeUtils.is_prime(num):\n                if largest_prime is None or num > largest_prime:\n                    largest_prime = num\n        \n        if largest_prime is not None:\n            return PrimeUtils.sum_digits(largest_prime)\n        return 0\ndef skjkasdkd(lst: list[int]) -> int:\n    \"\"\"\n    You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    return PrimeService.find_largest_prime_and_sum_digits(lst)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict: dict) -> bool:\n    \"\"\"\n    Checks if all keys in the dictionary are strings and are either all lowercase or all uppercase.\n    Returns False if the dictionary is empty or contains non-string keys or mixed-case string keys.\n    \"\"\"\n    if not dict:\n        return False\n\n    keys = list(dict.keys())\n\n    # Check if all keys are strings\n    if not all(isinstance(key, str) for key in keys):\n        return False\n\n    # Check if all keys are lowercase\n    all_lower = all(key == key.lower() for key in keys)\n    if all_lower:\n        return True\n\n    # Check if all keys are uppercase\n    all_upper = all(key == key.upper() for key in keys)\n    if all_upper:\n        return True\n\n    return False"}
{"task_id": "HumanEval/97", "solution": "def multiply(a, b):\n    \"\"\"Calculates the product of the unit digits of two integers.\n    The unit digit of a negative number is its absolute value modulo 10.\n    \"\"\"\n    unit_digit_a = abs(a) % 10\n    unit_digit_b = abs(b) % 10\n    return unit_digit_a * unit_digit_b"}
{"task_id": "HumanEval/96", "solution": "import math\ndef count_up_to(n):\n    \"\"\"Returns an array of prime numbers strictly less than n.\n    Handles invalid inputs and edge cases for n <= 2.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n <= 2:\n        return []\n\n    def _is_prime(num: int) -> bool:\n        \"\"\"Checks if an integer is prime. It optimizes by checking odd divisors up to its square root.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(num)) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\n\n    primes = []\n    for num in range(2, n):\n        if _is_prime(num):\n            primes.append(num)\n    return primes"}
{"task_id": "HumanEval/96", "solution": "import math\ndef _is_prime(num: int) -> bool:\n    \"\"\"Checks if a given number is prime using trial division up to its square root.\"\"\"\n    if num < 2:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    # Iterate through odd numbers from 3 up to the square root of num.\n    for i in range(3, int(math.sqrt(num)) + 1, 2):\n        if num % i == 0:\n            return False\n    return True\ndef count_up_to(n: int) -> list[int]:\n    \"\"\"\n    Returns a list of all prime numbers strictly less than the given non-negative integer n.\n    Input validation ensures n is an integer and non-negative, raising ValueError otherwise.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    primes = []\n    for num in range(2, n):\n        if _is_prime(num):\n            primes.append(num)\n    return primes"}
{"task_id": "HumanEval/97", "solution": "def multiply(a, b):\n    \"\"\"\n    Calculates the product of the unit digits of two integers.\n    The unit digit is the absolute value of the last digit.\n    \"\"\"\n    unit_digit_a = abs(a % 10)\n    unit_digit_b = abs(b % 10)\n    return unit_digit_a * unit_digit_b"}
{"task_id": "HumanEval/98", "solution": "def count_upper(s):\n    \"\"\"\n    Counts uppercase vowels at even indices in a string.\n    Raises TypeError if input is not a string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    UPPERCASE_VOWELS = {'A', 'E', 'I', 'O', 'U'}\n    count = 0\n    for i, char in enumerate(s):\n        if i % 2 == 0 and char in UPPERCASE_VOWELS:\n            count += 1\n    return count"}
{"task_id": "HumanEval/98", "solution": "UPPERCASE_VOWELS = {'A', 'E', 'I', 'O', 'U'}\ndef count_upper(s: str) -> int:\n    \"\"\"\n    Given a string s, count the number of uppercase vowels in even indices.\n    For example, count_upper('aBCdEf') returns 1 (E at index 4).\n    \"\"\"\n    count = 0\n    for i in range(0, len(s), 2):\n        if s[i] in UPPERCASE_VOWELS:\n            count += 1\n    return count"}
{"task_id": "HumanEval/99", "solution": "import math\ndef closest_integer(value: str) -> int:\n    \"\"\"\n    Converts a numerical string to its closest integer.\n    Equidistant numbers are rounded away from zero.\n    \"\"\"\n    try:\n        num = float(value)\n    except ValueError:\n        raise ValueError(f\"Invalid input: '{value}' is not a valid number string.\")\n\n    floor_num = math.floor(num)\n    ceil_num = math.ceil(num)\n\n    # Calculate distances\n    dist_to_floor = abs(num - floor_num)\n    dist_to_ceil = abs(num - ceil_num)\n\n    if dist_to_floor < dist_to_ceil:\n        return int(floor_num)\n    elif dist_to_ceil < dist_to_floor:\n        return int(ceil_num)\n    else:  # Equidistant, round away from zero\n        if num >= 0:\n            return int(ceil_num)\n        else:\n            return int(floor_num)"}
{"task_id": "HumanEval/100", "solution": "def make_a_pile(n: int) -> list[int]:\n    \"\"\"\n    Calculates the number of stones in each level of a pile.\n    The first level has 'n' stones, and subsequent levels increment by 2, maintaining the initial parity.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    pile = [n]\n    current_stones = n\n\n    for _ in range(n - 1):\n        current_stones += 2\n        pile.append(current_stones)\n\n    return pile"}
{"task_id": "HumanEval/99", "solution": "import math\ndef closest_integer(value: str) -> int:\n    \"\"\"\n    Create a function that takes a value (string) representing a number\n    and returns the closest integer to it. If the number is equidistant\n    from two integers, round it away from zero.\n    \"\"\"\n    try:\n        num = float(value)\n    except ValueError:\n        raise ValueError(f\"Invalid input: '{value}' is not a valid number string.\")\n\n    fractional_part = abs(num) - math.floor(abs(num))\n\n    if fractional_part == 0.5:\n        if num >= 0:\n            return int(math.ceil(num))\n        else:\n            return int(math.floor(num))\n    else:\n        return round(num)"}
