{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates total carrots eaten and remaining stock after a rabbit's meal.\n    Handles scenarios where needed carrots exceed available stock.\n    \"\"\"\n    MIN_CARROTS = 0\n    MAX_CARROTS = 1000\n\n    # Input validation based on constraints.\n    if not (MIN_CARROTS <= number <= MAX_CARROTS):\n        raise ValueError(f\"Number of eaten carrots must be between {MIN_CARROTS} and {MAX_CARROTS}.\")\n    if not (MIN_CARROTS <= need <= MAX_CARROTS):\n        raise ValueError(f\"Number of needed carrots must be between {MIN_CARROTS} and {MAX_CARROTS}.\")\n    if not (MIN_CARROTS <= remaining <= MAX_CARROTS):\n        raise ValueError(f\"Number of remaining carrots must be between {MIN_CARROTS} and {MAX_CARROTS}.\")\n\n    # Determine how many carrots the rabbit actually eats in this meal.\n    carrots_eaten_this_meal = min(need, remaining)\n\n    # Calculate total carrots eaten.\n    total_eaten = number + carrots_eaten_this_meal\n\n    # Calculate remaining carrots in stock.\n    carrots_left = remaining - carrots_eaten_this_meal\n\n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"\n    Transforms a string: reverses case of letters or reverses the whole string if no letters are present.\n    Non-letter characters remain unchanged in case reversal mode.\n    \"\"\"\n\n    def _is_letter(char: str) -> bool:\n        \"\"\"Checks if a character is an alphabetic letter.\"\"\"\n        return char.isalpha()\n\n    def _reverse_case(char: str) -> str:\n        \"\"\"Reverses the case of a letter; returns unchanged if not a letter.\"\"\"\n        if char.islower():\n            return char.upper()\n        elif char.isupper():\n            return char.lower()\n        return char\n\n    def _reverse_string(input_s: str) -> str:\n        \"\"\"Reverses the order of characters in a string.\"\"\"\n        return input_s[::-1]\n\n    def _has_letters(input_s: str) -> bool:\n        \"\"\"Determines if the string contains any alphabetic characters.\"\"\"\n        return any(_is_letter(char) for char in input_s)\n\n    if not _has_letters(s):\n        return _reverse_string(s)\n    \n    transformed_chars = []\n    for char in s:\n        transformed_chars.append(_reverse_case(char))\n    return \"\".join(transformed_chars)"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Reverses case of letters or reverses the whole string if no letters.\n    Returns the transformed string based on character types.\n    \"\"\"\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    if not has_letters:\n        return s[::-1]\n    \n    transformed_chars = []\n    for char in s:\n        if char.isalpha():\n            if char.islower():\n                transformed_chars.append(char.upper())\n            elif char.isupper():\n                transformed_chars.append(char.lower())\n        else:\n            transformed_chars.append(char)\n    \n    return \"\".join(transformed_chars)"}
{"task_id": "HumanEval/163", "solution": "from typing import List\ndef generate_integers(a: int, b: int) -> List[int]:\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b (inclusive), in ascending order.\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise ValueError(\"Inputs 'a' and 'b' must be integers.\")\n    if a <= 0 or b <= 0:\n        raise ValueError(\"Inputs 'a' and 'b' must be positive integers.\")\n\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    EVEN_DIGITS = [0, 2, 4, 6, 8]\n\n    result = [\n        digit for digit in EVEN_DIGITS\n        if min_val <= digit <= max_val\n    ]\n    return sorted(result)"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    if not b:\n        return True\n\n    len_b = len(b)\n    len_a = len(a)\n\n    # Optimization: if b is longer than a, no rotation can be a substring\n    if len_b > len_a:\n        return False\n\n    # Create a doubled string of b to easily get all rotations as substrings\n    doubled_b = b + b\n\n    # Iterate through all possible starting positions for rotations in doubled_b\n    # and check if each rotation is a substring of a.\n    for i in range(len_b):\n        rotation = doubled_b[i : i + len_b]\n        if rotation in a:\n            return True\n    \n    return False"}
