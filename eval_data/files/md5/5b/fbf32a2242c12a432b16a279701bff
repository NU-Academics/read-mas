{"task_id": "HumanEval/137", "solution": "from typing import Union\ndef compare_one(a: Union[int, float, str], b: Union[int, float, str]) -> Union[int, float, str, None]:\n    \"\"\"\n    Compares two values (int, float, or string representing real numbers)\n    and returns the larger one in its original type, or None if equal.\n    \"\"\"\n\n    def _to_float(value: Union[int, float, str]) -> float:\n        \"\"\"\n        Converts a value to a float, handling string formats with ',' or '.' decimals.\n        Raises ValueError for invalid numeric strings, TypeError for unsupported types.\n        \"\"\"\n        if isinstance(value, (int, float)):\n            return float(value)\n        elif isinstance(value, str):\n            # Replace comma with dot for consistent float conversion\n            cleaned_value = value.replace(',', '.')\n            return float(cleaned_value)\n        else:\n            raise TypeError(f\"Unsupported type for conversion: {type(value)}\")\n\n    float_a = _to_float(a)\n    float_b = _to_float(b)\n\n    if float_a > float_b:\n        return a\n    elif float_b > float_a:\n        return b\n    else:\n        return None"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n\n    if n < 8:\n        return False\n\n    if n % 2 != 0:\n        return False\n\n    return True"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluates if n can be expressed as the sum of exactly four positive even numbers.\n    This is true if n is even and n is greater than or equal to 8.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n\n    return n % 2 == 0 and n >= 8"}
{"task_id": "HumanEval/137", "solution": "from typing import Any, Optional\nclass NumberConverter:\n    \"\"\"Converts inputs to float, handling string decimals ('.' or ',').\"\"\"\n    def to_float(self, value: Any) -> float:\n        if isinstance(value, (int, float)):\n            return float(value)\n        elif isinstance(value, str):\n            try:\n                # Replace comma with dot for consistent float conversion.\n                cleaned_value = value.replace(',', '.')\n                return float(cleaned_value)\n            except ValueError as e:\n                raise ValueError(f\"Invalid string representation for number: '{value}'\") from e\n        else:\n            raise TypeError(f\"Unsupported type for comparison: {type(value)}\")\nclass ComparisonService:\n    \"\"\"Compares two inputs, returning the larger preserving its type, or None if equal.\"\"\"\n    def __init__(self, converter: NumberConverter):\n        self._converter = converter\n\n    def compare_one(self, a: Any, b: Any) -> Optional[Any]:\n        float_a = self._converter.to_float(a)\n        float_b = self._converter.to_float(b)\n\n        if float_a > float_b:\n            return a\n        elif float_b > float_a:\n            return b\n        else:\n            return None\ndef compare_one(a, b):\n    \"\"\"\n    Compares two numerical values (int, float, or string) and returns the larger\n    value while preserving its original type, or None if numerically equal.\n    \"\"\"\n    converter = NumberConverter()\n    service = ComparisonService(converter)\n    return service.compare_one(a, b)"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n: int) -> int:\n    \"\"\"Calculates the special factorial of n, defined as n! * (n-1)! * ... * 1!.\n    Input n must be a positive integer.\n    \"\"\"\n\n    def _calculate_factorial(k: int) -> int:\n        if not isinstance(k, int):\n            raise TypeError(\"Input 'k' must be an integer.\")\n        if k < 0:\n            raise ValueError(\"Factorial is not defined for negative numbers.\")\n        \n        if k == 0:\n            return 1\n        \n        result_k = 1\n        for i in range(1, k + 1):\n            result_k *= i\n        return result_k\n\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"Special factorial is defined for positive integers only.\")\n    \n    special_fact_result = 1\n    for i in range(1, n + 1):\n        current_factorial = _calculate_factorial(i)\n        special_fact_result *= current_factorial\n    \n    return special_fact_result"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input must be a string.\")\n\n    # First, replace sequences of three or more spaces with a single hyphen.\n    processed_text = re.sub(r' {3,}', '-', text)\n    # Then, replace remaining single space characters with underscores.\n    final_text = re.sub(r' ', '_', processed_text)\n    return final_text"}
{"task_id": "HumanEval/139", "solution": "import math\nfrom typing import Any\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to special_factorial functions.\n    It carries a descriptive error message.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef is_positive_integer(value: Any) -> bool:\n    \"\"\"Checks if the given value is a positive integer.\n    Returns True if value is an integer and greater than 0, False otherwise.\"\"\"\n    return isinstance(value, int) and value > 0\ndef special_factorial(n: int) -> int:\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    if not is_positive_integer(n):\n        raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n\n    result = 1\n    for i in range(1, n + 1):\n        result *= math.factorial(i)\n    return result"}
{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"Given a non-empty list of integers lst. Add the even elements that are at odd indices.\n    This function first validates the input list before calculating the sum.\n    \"\"\"\n    if not lst:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    # Validate all elements are integers upfront as per design.\n    for item in lst:\n        if not isinstance(item, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n\n    total = 0\n    # Iterate through the list to find even elements at odd indices.\n    for index, element in enumerate(lst):\n        if index % 2 != 0 and element % 2 == 0:\n            total += element\n    return total"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Checks if the length of a string is a prime number.\n    Raises TypeError if the input is not a string.\"\"\"\n\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"Determines if an integer n is a prime number using trial division.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:  # 2 and 3 are prime\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    length = len(string)\n    return _is_prime(length)"}
{"task_id": "HumanEval/44", "solution": "MIN_BASE = 2\nMAX_BASE = 9\ndef change_base(x: int, base: int) -> str:\n    \"\"\"Converts a non-negative integer 'x' to its string representation in a specified 'base'.\n    The target base must be between 2 and 9 (inclusive).\n    \"\"\"\n    if not isinstance(x, int) or x < 0:\n        raise ValueError(\"Input number 'x' must be a non-negative integer.\")\n    if not isinstance(base, int) or not (MIN_BASE <= base <= MAX_BASE):\n        raise ValueError(f\"Base must be an integer between {MIN_BASE} and {MAX_BASE} (inclusive).\")\n\n    if x == 0:\n        return \"0\"\n\n    result = []\n    while x > 0:\n        remainder = x % base\n        result.append(str(remainder))\n        x //= base\n    \n    return \"\".join(reversed(result))"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    \n    This function calculates the sum of decimal digits of N and converts it to a binary string.\n    \"\"\"\n    if not isinstance(N, int) or N < 0 or N > 10000:\n        raise ValueError(\"Input N must be an integer between 0 and 10000.\")\n\n    decimal_sum = 0\n    for digit_char in str(N):\n        decimal_sum += int(digit_char)\n\n    binary_string = bin(decimal_sum)[2:]\n    return binary_string"}
{"task_id": "HumanEval/100", "solution": "def make_a_pile(n):\n    \"\"\"\n    Given a positive integer n, you have to make a pile of n levels of stones.\n    The first level has n stones.\n    The number of stones in the next level is:\n        - the next odd number if n is odd.\n        - the next even number if n is even.\n    Return the number of stones in each level in a list, where element at index\n    i represents the number of stones in the level (i+1).\n\n    Examples:\n    >>> make_a_pile(3)\n    [3, 5, 7]\n    \"\"\"\n    result = []\n    current_stones = n\n    result.append(current_stones)\n\n    for _ in range(n - 1):\n        current_stones += 2\n        result.append(current_stones)\n\n    return result"}
{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s,n):\n    \"\"\"\n    In this task, you will be given a string that represents a number of apples and oranges \n    that are distributed in a basket of fruit this basket contains \n    apples, oranges, and mango fruits. Given the string that represents the total number of \n    the oranges and apples and an integer that represent the total number of the fruits \n    in the basket return the number of the mango fruits in the basket.\n    for examble:\n    fruit_distribution(\"5 apples and 6 oranges\", 19) ->19 - 5 - 6 = 8\n    fruit_distribution(\"0 apples and 1 oranges\",3) -> 3 - 0 - 1 = 2\n    fruit_distribution(\"2 apples and 3 oranges\", 100) -> 100 - 2 - 3 = 95\n    fruit_distribution(\"100 apples and 1 oranges\",120) -> 120 - 100 - 1 = 19\n    \"\"\"\n    \n    def _parse_fruit_count(text: str, fruit_name: str) -> int:\n        \"\"\"\n        Extracts the numerical count of a specified fruit from a given text.\n        Returns 0 if the fruit count cannot be found or parsed.\n        \"\"\"\n        pattern = rf\"(\\d+)\\s+{re.escape(fruit_name)}\"\n        match = re.search(pattern, text)\n        if match:\n            try:\n                return int(match.group(1))\n            except ValueError:\n                return 0\n        return 0\n\n    apples = _parse_fruit_count(s, \"apples\")\n    oranges = _parse_fruit_count(s, \"oranges\")\n\n    mangoes = n - apples - oranges\n    return max(0, mangoes) # Ensure non-negative result"}
{"task_id": "HumanEval/86", "solution": "import re\ndef anti_shuffle(s):\n    \"\"\"\n    Sorts characters within each word of a string based on ASCII value,\n    preserving word order and all blank spaces.\n    \"\"\"\n    if not s:\n        return \"\"\n\n    # Split the string by one or more spaces, keeping the delimiters in the result.\n    # This method ensures that all original spacing (leading, trailing, and multiple spaces) is preserved.\n    parts = re.split(r'(\\s+)', s)\n    \n    processed_parts = []\n    for part in parts:\n        # Check if the part consists only of whitespace or is an empty string resulting from the split.\n        # If it's a non-word part, append it directly to maintain original spacing.\n        if part.strip() == '': \n            processed_parts.append(part)\n        else: \n            # If it's a word, sort its characters in ascending order by their ASCII values.\n            # Then, rejoin the sorted characters to form the new word.\n            processed_parts.append(\"\".join(sorted(part)))\n    \n    # Reconstruct the final string by joining all processed parts.\n    return \"\".join(processed_parts)"}
{"task_id": "HumanEval/107", "solution": "MIN_N = 1\nMAX_N = 1000\ndef _is_palindrome(num: int) -> bool:\n    \"\"\"Checks if an integer is a palindrome by comparing its string representation with its reverse.\"\"\"\n    return str(num) == str(num)[::-1]\ndef _is_even(num: int) -> bool:\n    \"\"\"Checks if an integer is even using the modulo operator.\"\"\"\n    return num % 2 == 0\ndef even_odd_palindrome(n: int) -> tuple[int, int]:\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n    if not isinstance(n, int) or not (MIN_N <= n <= MAX_N):\n        raise ValueError(\n            f\"Input 'n' must be an integer between {MIN_N} and {MAX_N} inclusive.\"\n        )\n\n    even_count = 0\n    odd_count = 0\n\n    for i in range(1, n + 1):\n        if _is_palindrome(i):\n            if _is_even(i):\n                even_count += 1\n            else:\n                odd_count += 1\n                \n    return (even_count, odd_count)"}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s, c):\n    \"\"\"\n    Deletes all characters in s that are equal to any character in c,\n    then checks if the result string is a palindrome.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input 's' must be a string.\")\n    if not isinstance(c, str):\n        raise TypeError(\"Input 'c' must be a string.\")\n\n    chars_to_remove_set = set(c) # Convert 'c' to a set for efficient character lookups.\n\n    filtered_chars = [char for char in s if char not in chars_to_remove_set]\n    filtered_s = \"\".join(filtered_chars) # Build the new string with unwanted characters removed.\n\n    is_pal = (filtered_s == filtered_s[::-1]) # Compare the filtered string with its reversed version.\n\n    return (filtered_s, is_pal)"}
{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and an integer k, return a sorted list\n    of the k largest numbers. Handles various inputs and edge cases efficiently.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise TypeError(\"All elements in 'arr' must be integers.\")\n    if not isinstance(k, int):\n        raise TypeError(\"Input 'k' must be an integer.\")\n    if k < 0:\n        raise ValueError(\"Input 'k' cannot be negative.\")\n    if k > len(arr):\n        raise ValueError(\"Input 'k' cannot be greater than the length of 'arr'.\")\n\n    if k == 0:\n        return []\n\n    # Sort the array in ascending order to find the largest elements.\n    sorted_arr = sorted(arr)\n\n    # Return the last k elements, which are the k largest numbers.\n    return sorted_arr[len(sorted_arr) - k:]"}
{"task_id": "HumanEval/32", "solution": "import math\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef find_zero(xs: list):\n    \"\"\"Finds a single real root for a polynomial with coefficients `xs`, where `poly(x)` is approximately zero.\n    It requires `xs` to have an even number of coefficients, as this guarantees a solution for the bisection method used.\n    \"\"\"\n    # Validate coefficients for root finding.\n    if not isinstance(xs, list) or not all(isinstance(c, (int, float)) for c in xs):\n        raise ValueError(\"Coefficients must be a list of numbers.\")\n    if not xs:\n        raise ValueError(\"Coefficient list cannot be empty.\")\n    if len(xs) % 2 != 0:\n        raise ValueError(\"Polynomial must have an even number of coefficients for root finding.\")\n\n    # Set constants for the bisection method.\n    DEFAULT_TOLERANCE = 1e-6\n    MAX_ITERATIONS = 1000\n\n    # Define a wide initial search interval for the root.\n    a, b = -1000.0, 1000.0\n\n    fa = poly(xs, a)\n    fb = poly(xs, b)\n\n    # Ensure a sign change exists within the initial interval for bisection to work.\n    if fa * fb > 0:\n        raise ValueError(\"Initial interval does not bracket a root; f(a) and f(b) have the same sign.\")\n\n    for _ in range(MAX_ITERATIONS):\n        mid = (a + b) / 2\n        f_mid = poly(xs, mid)\n\n        # Check for convergence and round result to 2 decimal places.\n        if abs(f_mid) < DEFAULT_TOLERANCE:\n            return round(mid, 2)\n\n        # Update the interval based on the sign of f_mid.\n        if fa * f_mid < 0:\n            b = mid\n            fb = f_mid\n        else:\n            a = mid\n            fa = f_mid\n    \n    # Raise an error if the root is not found within the maximum iterations.\n    raise ValueError(\"Root not found within maximum iterations; algorithm did not converge.\")"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr: list[int]) -> list[str]:\n    \"\"\"\n    Transforms an array of integers by filtering, sorting, reversing, and converting valid digits to English words.\n    Only integers from 1 to 9 are processed; others are ignored.\n    \"\"\"\n    DIGIT_NAMES = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    # Filter for numbers between 1 and 9 (inclusive)\n    filtered_digits = [n for n in arr if 1 <= n <= 9]\n\n    # Return empty if no valid digits were found\n    if not filtered_digits:\n        return []\n\n    # Sort the valid digits in ascending order\n    filtered_digits.sort()\n    # Reverse the sorted list to get descending order\n    filtered_digits.reverse()\n\n    # Convert each digit to its English word representation\n    result_words = [DIGIT_NAMES[digit] for digit in filtered_digits]\n\n    return result_words"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\n\n    >>> odd_count(['1234567'])\n    [\"the number of odd elements 4n the str4ng 4 of the 4nput.\"]\n    >>> odd_count(['3',\"11111111\"])\n    [\"the number of odd elements 1n the str1ng 1 of the 1nput.\",\n     \"the number of odd elements 8n the str8ng 8 of the 8nput.\"]\n    \"\"\"\n    results = []\n    for digit_string in lst:\n        odd_digit_count = 0\n        for char in digit_string:\n            # Check if the digit is odd\n            if int(char) % 2 != 0:\n                odd_digit_count += 1\n        \n        # Format the output string using the calculated count\n        template = \"the number of odd elements in the string i of the input.\"\n        formatted_string = template.replace('i', str(odd_digit_count))\n        results.append(formatted_string)\n    return results"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr: list[int]) -> int | None:\n    \"\"\"\n    Calculates the sum of magnitudes multiplied by the product of signs of numbers in an array.\n    Returns None for an empty array, otherwise an integer result.\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for num in arr:\n        # Determine the sign of the current number based on its value.\n        if num > 0:\n            current_sign = 1\n        elif num < 0:\n            current_sign = -1\n        else:\n            current_sign = 0\n\n        product_of_signs *= current_sign\n        sum_of_magnitudes += abs(num)\n\n    return sum_of_magnitudes * product_of_signs"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Returns the largest index i where arr[i] < arr[i-1]. If no such element exists, returns -1.\n    The given array will not contain duplicate values.\"\"\"\n    if not arr or len(arr) < 2:\n        return -1\n\n    largest_disorder_index = -1\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            largest_disorder_index = i\n    return largest_disorder_index"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text: str) -> str:\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores.\n    If a string has more than 2 consecutive spaces, replace all consecutive spaces with a hyphen.\n    \"\"\"\n    # Replace 3 or more consecutive spaces with a single hyphen\n    text = re.sub(r' {3,}', '-', text)\n    # Replace single spaces (including any remaining pairs, which are treated as two single spaces) with underscores\n    text = text.replace(' ', '_')\n    return text"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on predefined criteria.\n    Returns 'Yes' for a valid name, 'No' otherwise.\"\"\"\n\n    allowed_extensions = ['txt', 'exe', 'dll']\n\n    # Rule: Not more than three digits.\n    digit_count = sum(c.isdigit() for c in file_name)\n    if digit_count > 3:\n        return 'No'\n\n    # Rule: Exactly one dot.\n    if file_name.count('.') != 1:\n        return 'No'\n\n    prefix, suffix = file_name.split('.', 1)\n\n    # Rule: Prefix not empty and starts with a letter.\n    if not prefix or not prefix[0].isalpha():\n        return 'No'\n\n    # Rule: Suffix is one of the allowed extensions.\n    if suffix not in allowed_extensions:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date: str) -> bool:\n    \"\"\"\n    Validates a given date string according to specified rules. It checks for non-empty input,\n    'mm-dd-yyyy' format, valid month (1-12), and valid day for the month (e.g., max 29 for February).\n    \"\"\"\n    import re\n\n    # FR1: The date string is not empty.\n    if not date:\n        return False\n\n    # FR2: The date string adheres to the \"mm-dd-yyyy\" format.\n    match = re.fullmatch(r'(\\d{2})-(\\d{2})-(\\d{4})', date)\n    if not match:\n        return False\n\n    try:\n        month = int(match.group(1))\n        day = int(match.group(2))\n        _ = int(match.group(3))  # Year is extracted but not further validated here.\n    except ValueError:\n        return False\n\n    # FR3: The month component is between 1 and 12, inclusive.\n    if not (1 <= month <= 12):\n        return False\n\n    # Constants for days in month, including February with max 29 days (per specification).\\n\n    DAYS_IN_MONTH = {\n        1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n        4: 30, 6: 30, 9: 30, 11: 30,\n        2: 29\n    }\n\n    # FR4: The day component is appropriate for the given month.\n    if not (1 <= day):  # Day must be at least 1.\n        return False\n\n    max_days = DAYS_IN_MONTH.get(month)\n    if max_days is None:  # Defensive check; should not be reached if month is valid.\n        return False\n    \n    if not (day <= max_days):\n        return False\n            \n    # FR5: Return True if all validation rules are satisfied.\n    return True"}
{"task_id": "HumanEval/132", "solution": "class InvalidBracketStringError(Exception):\n    \"\"\"Custom exception for invalid characters in the bracket string.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef is_nested(string: str) -> bool:\n    \"\"\"\n    Checks if a string of square brackets contains a nested subsequence `[ [ ] ]`.\n    Raises TypeError for non-string input or InvalidBracketStringError for invalid characters.\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    # Validate input characters.\n    for char in string:\n        if char not in \"[]\":\n            raise InvalidBracketStringError(\n                f\"Invalid character '{char}' found in string. Only '[' and ']' are allowed.\"\n            )\n\n    idx1 = -1\n    idx2 = -1\n    idx3 = -1\n    idx4 = -1\n\n    # Find first '['.\n    for i, char in enumerate(string):\n        if char == '[':\n            idx1 = i\n            break\n    if idx1 == -1:\n        return False\n\n    # Find second '[' after idx1.\n    for i in range(idx1 + 1, len(string)):\n        if string[i] == '[':\n            idx2 = i\n            break\n    if idx2 == -1:\n        return False\n\n    # Find first ']' after idx2.\n    for i in range(idx2 + 1, len(string)):\n        if string[i] == ']':\n            idx3 = i\n            break\n    if idx3 == -1:\n        return False\n\n    # Find second ']' after idx3.\n    for i in range(idx3 + 1, len(string)):\n        if string[i] == ']':\n            idx4 = i\n            break\n    if idx4 == -1:\n        return False\n\n    return True"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    You are given a string representing a sentence,\n    the sentence contains some words separated by a space,\n    and you have to return a string that contains the words from the original sentence,\n    whose lengths are prime numbers,\n    the order of the words in the new string should be the same as the original one.\n\n    Example 1:\n        Input: sentence = \"This is a test\"\n        Output: \"is\"\n\n    Example 2:\n        Input: sentence = \"lets go for swimming\"\n        Output: \"go for\"\n\n    Constraints:\n        * 1 <= len(sentence) <= 100\n        * sentence contains only letters\n    \"\"\"\n\n    def is_prime(number: int) -> bool:\n        \"\"\"Determines if a given integer is a prime number.\"\"\"\n        if number < 2:\n            return False\n        # Optimized check: iterate only up to the square root of the number\n        # Numbers greater than 2 that are even are not prime.\n        # This optimization is not strictly needed for numbers up to 100, but is good practice.\n        for i in range(2, int(number**0.5) + 1):\n            if number % i == 0:\n                return False\n        return True\n\n    words = sentence.split(' ')\n    filtered_words = []\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n    \n    return ' '.join(filtered_words)"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name: str) -> str:\n    \"\"\"Checks if a file name is valid based on specific rules.\n    Returns 'Yes' for valid names, 'No' otherwise.\n    \"\"\"\n    \n    ALLOWED_EXTENSIONS = ['txt', 'exe', 'dll']\n\n    # Rule: The file's name contains exactly one dot '.'.\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # Split the file name into prefix and suffix.\n    # We are guaranteed to have exactly two parts due to the dot count check above.\n    prefix, suffix = file_name.split('.', 1)\n\n    # Rule: The substring before the dot should not be empty.\n    if not prefix:\n        return 'No'\n    \n    # Rule: The substring before the dot must start with a letter from the Latin alphabet.\n    if not prefix[0].isalpha():\n        return 'No'\n\n    # Rule: The substring after the dot should be one of the allowed extensions.\n    if suffix not in ALLOWED_EXTENSIONS:\n        return 'No'\n\n    # Rule: There should not be more than three digits ('0'-'9') in the file's name.\n    digit_count = sum(1 for char in file_name if char.isdigit())\n    if digit_count > 3:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/32", "solution": "import math\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef _bisection_method(func, a: float, b: float, tol: float, max_iter: int) -> float:\n    \"\"\"\n    Finds a root of func using the bisection method within the interval [a, b].\n    Assumes func(a) and func(b) have opposite signs for root existence.\n    \"\"\"\n    fa, fb = func(a), func(b)\n    if fa * fb > 0:\n        raise ValueError(\"Function has same sign at interval endpoints. No root or multiple roots within this range.\")\n\n    for _ in range(max_iter):\n        c = (a + b) / 2\n        fc = func(c)\n\n        if abs(fc) < tol:\n            return c\n\n        if abs(b - a) < tol:\n            return c\n\n        if fa * fc < 0:\n            b = c\n            fb = fc\n        else:\n            a = c\n            fa = fc\n    raise RuntimeError(\"Bisection method did not converge within max iterations.\")\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    if not xs:\n        raise ValueError(\"Coefficients list cannot be empty.\")\n    if not all(isinstance(c, (int, float)) for c in xs):\n        raise ValueError(\"All coefficients must be numeric.\")\n    \n    if len(xs) % 2 != 0:\n        raise ValueError(\"find_zero only takes list xs having an even number of coefficients.\")\n    \n    # According to the design and interpretation of \"largest non zero coefficient as it guarantees a solution\",\n    # the last coefficient in the list (representing the highest degree) must not be zero.\n    if len(xs) > 0 and xs[-1] == 0:\n        raise ValueError(\"The highest degree coefficient (last element in xs) cannot be zero for zero-finding as specified.\")\n\n    func_to_root = lambda val: poly(xs, val)\n\n    # Use a broad search interval and default numerical parameters from the design.\n    lower_bound = -1000.0\n    upper_bound = 1000.0\n    tolerance = 1e-6\n    max_iterations = 1000\n\n    return _bisection_method(func_to_root, lower_bound, upper_bound, tolerance, max_iterations)"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    def __init__(self, numerator: int, denominator: int):\n        # Constructor for the Fraction object, ensuring valid integer inputs.\n        # Denominator cannot be zero, as per design and business rules.\n        if not isinstance(numerator, int) or not isinstance(denominator, int):\n            raise TypeError(\"Numerator and denominator must be integers.\")\n        if denominator == 0:\n            raise ValueError(\"Denominator cannot be zero.\")\n        self.numerator = numerator\n        self.denominator = denominator\n\n    def __repr__(self):\n        return f\"Fraction({self.numerator}/{self.denominator})\"\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"This function determines if the product of two fractions, x and n, results in a whole number.\n    It takes two fraction strings and returns True if their product is a whole number, False otherwise.\n    \"\"\"\n\n    def _parse_fraction(fraction_str: str) -> Fraction:\n        # Converts a string representation of a fraction into a Fraction object.\n        # Assumes valid string format \"<numerator>/<denominator>\" with positive integers.\n        parts = fraction_str.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return Fraction(numerator, denominator)\n\n    def _multiply_fractions(f1: Fraction, f2: Fraction) -> Fraction:\n        # Multiplies two Fraction objects and returns the product as a new Fraction object.\n        # It calculates the new numerator and denominator by multiplying respective parts.\n        new_numerator = f1.numerator * f2.numerator\n        new_denominator = f1.denominator * f2.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def _is_whole_number(f: Fraction) -> bool:\n        # Checks if a given Fraction object represents a whole number.\n        # A fraction is considered a whole number if its numerator is perfectly divisible by its denominator.\n        return f.numerator % f.denominator == 0\n\n    # Main flow: parse fractions, multiply them, and check if the product is a whole number.\n    fraction_x = _parse_fraction(x)\n    fraction_n = _parse_fraction(n)\n    product_fraction = _multiply_fractions(fraction_x, fraction_n)\n    return _is_whole_number(product_fraction)"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums: list[int]) -> int:\n    \"\"\"\n    Counts numbers greater than 10 whose first and last digits (absolute value) are odd.\n    \"\"\"\n\n    def _is_odd(digit: int) -> bool:\n        # Checks if a given digit is odd.\n        return abs(digit) % 2 != 0\n\n    def _get_first_digit(num: int) -> int:\n        # Extracts the first digit of a number's absolute value.\n        return int(str(abs(num))[0])\n\n    def _get_last_digit(num: int) -> int:\n        # Extracts the last digit of a number's absolute value.\n        return abs(num) % 10\n\n    count = 0\n    for num in nums:\n        if num > 10:\n            first_digit = _get_first_digit(num)\n            last_digit = _get_last_digit(num)\n\n            if _is_odd(first_digit) and _is_odd(last_digit):\n                count += 1\n    return count"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst: list[str]) -> list[str]:\n    \"\"\"\n    Filters a list of strings, keeping only those with even lengths.\n    The remaining strings are sorted first by their length, then alphabetically.\n    \"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    sorted_strings = sorted(even_length_strings, key=lambda s: (len(s), s))\n    return sorted_strings"}
{"task_id": "HumanEval/145", "solution": "class DigitSumCalculator:\n    @staticmethod\n    def calculate(num: int) -> int:\n        \"\"\"\n        Calculates the sum of the absolute digits of an integer.\n        For example, calculate(-12) returns 3 (1 + 2).\n        \"\"\"\n        s = str(abs(num))\n        digit_sum = 0\n        for digit_char in s:\n            digit_sum += int(digit_char)\n        return digit_sum\nclass DigitSumSorter:\n    @staticmethod\n    def order_by_points(nums: list[int]) -> list[int]:\n        \"\"\"\n        Sorts the given list of integers in ascending order according to the sum of their digits.\n        If there are several items with similar sum of their digits, order them based on their index in the original list.\n        \"\"\"\n        if not nums:\n            return []\n\n        decorated_list = []\n        for i, num in enumerate(nums):\n            # Create a tuple: (digit_sum, original_index, original_number).\n            digit_sum = DigitSumCalculator.calculate(num)\n            decorated_list.append((digit_sum, i, num))\n\n        # Python's sort is stable; the original index `i` serves as a tie-breaker.\n        decorated_list.sort()\n\n        # Extract the original numbers from the sorted list.\n        sorted_nums = [item[2] for item in decorated_list]\n        return sorted_nums\ndef order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of integers by the sum of their digits, with original index as a tie-breaker.\n    If sums are equal, items are ordered by their original index.\n    \"\"\"\n    return DigitSumSorter.order_by_points(nums)"}
{"task_id": "HumanEval/148", "solution": "PLANET_ORDER = [\n    \"Mercury\",\n    \"Venus\",\n    \"Earth\",\n    \"Mars\",\n    \"Jupiter\",\n    \"Saturn\",\n    \"Uranus\",\n    \"Neptune\"\n]\nclass PlanetOrderData:\n    @staticmethod\n    def get_index(planet_name: str) -> int | None:\n        try:\n            return PLANET_ORDER.index(planet_name)\n        except ValueError:\n            return None\nclass PlanetFinderService:\n    @staticmethod\n    def find_planets_between(planet1: str, planet2: str) -> tuple[str, ...]:\n        idx1 = PlanetOrderData.get_index(planet1)\n        idx2 = PlanetOrderData.get_index(planet2)\n\n        if idx1 is None or idx2 is None:\n            return ()\n\n        start_idx = min(idx1, idx2)\n        end_idx = max(idx1, idx2)\n\n        intermediate_planets = PLANET_ORDER[start_idx + 1:end_idx]\n\n        return tuple(intermediate_planets)\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    return PlanetFinderService.find_planets_between(planet1, planet2)"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n    \n    for item in lst:\n        if not isinstance(item, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n\n    total_sum = 0\n    for i, value in enumerate(lst):\n        if i % 3 == 0:\n            transformed_value = value * value\n        elif i % 4 == 0:\n            transformed_value = value * value * value\n        else:\n            transformed_value = value\n        total_sum += transformed_value\n    return total_sum"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst: list[str]) -> list[str]:\n    \"\"\"\n    Filters a list of strings to include only those with even lengths.\n    Then, it sorts the remaining strings by length and alphabetically.\n    \"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    sorted_strings = sorted(even_length_strings, key=lambda s: (len(s), s))\n    return sorted_strings"}
{"task_id": "HumanEval/147", "solution": "import math\ndef get_max_triples(n: int) -> int:\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k, \n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n    if n < 3:\n        return 0\n\n    num_mod_0 = 0  # Count of a[x] where a[x] % 3 == 0 (occurs when x % 3 == 2).\n    num_mod_1 = 0  # Count of a[x] where a[x] % 3 == 1 (occurs when x % 3 == 0 or x % 3 == 1).\n\n    for i in range(1, n + 1):\n        # Analyze a[i] = i*i - i + 1 modulo 3\n        # If i % 3 == 0: a[i] % 3 = (0*0 - 0 + 1) % 3 = 1 % 3 = 1\n        # If i % 3 == 1: a[i] % 3 = (1*1 - 1 + 1) % 3 = 1 % 3 = 1\n        # If i % 3 == 2: a[i] % 3 = (2*2 - 2 + 1) % 3 = (4 - 2 + 1) % 3 = 3 % 3 = 0\n        \n        if i % 3 == 2:\n            num_mod_0 += 1\n        else:\n            num_mod_1 += 1\n        \n    # We need (r1 + r2 + r3) % 3 == 0\n    # Possible combinations of remainders (0 or 1) that sum to a multiple of 3:\n    # (0, 0, 0) -> sum = 0 % 3 = 0\n    # (1, 1, 1) -> sum = 3 % 3 = 0\n    \n    count_000 = math.comb(num_mod_0, 3)\n    count_111 = math.comb(num_mod_1, 3)\n\n    return count_000 + count_111"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"Calculates the sum of squares of odd, positive integers from the list.\n    Ignores numbers that are negative or not integers, returning 0 for an empty list.\"\"\"\n    total_sum_of_squares = 0\n    if not lst:\n        return 0\n\n    for item in lst:\n        if isinstance(item, int):\n            if item > 0 and item % 2 != 0:\n                total_sum_of_squares += item * item\n    return total_sum_of_squares"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Given a list of numbers, return the sum of squares of the numbers in the list\n    that are odd, positive, and integers. Ignore numbers that are negative, zero, or not integers.\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum_of_squares = 0\n    for num in lst:\n        if isinstance(num, int) and num > 0 and num % 2 != 0:\n            total_sum_of_squares += num * num\n    return total_sum_of_squares"}
{"task_id": "HumanEval/150", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"Checks if the input integer n is a prime number.\n    Returns True if prime, False otherwise.\"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n    \n    \"\"\"\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/150", "solution": "import math\nclass PrimeChecker:\n    @staticmethod\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if the input integer n is a prime number.\n        Raises TypeError if n is not an integer.\n        \"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n\n        # Iterates from 3 up to the square root of n, checking only odd divisors.\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\ndef x_or_y(n, x, y):\n    \"\"\"Returns the value of x if n is a prime number, and y otherwise.\n    This function uses the PrimeChecker utility to determine primality.\n    \"\"\"\n    if PrimeChecker.is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"\n    Counts numbers in an array that are greater than 10 and have odd first and last digits.\n    Handles both integers and floats, considering absolute values for digits.\n    \"\"\"\n    if not isinstance(nums, list):\n        raise TypeError(\"Input must be a list of numbers.\")\n\n    def _is_odd(digit: int) -> bool:\n        # Checks if a given digit is odd.\n        if not isinstance(digit, int):\n            raise TypeError(\"Digit must be an integer.\")\n        return digit % 2 != 0\n\n    def _to_abs_string(number: int | float) -> str:\n        # Converts a number to its absolute string representation, handling floats by removing the decimal part.\n        if not isinstance(number, (int, float)):\n            raise TypeError(\"Number must be an integer or float.\")\n        s = str(abs(number))\n        return s.split('.')[0]\n\n    def _get_first_digit(number: int | float) -> int:\n        # Extracts the first digit of a number (absolute value).\n        s = _to_abs_string(number)\n        return int(s[0])\n\n    def _get_last_digit(number: int | float) -> int:\n        # Extracts the last digit of a number (absolute value).\n        s = _to_abs_string(number)\n        return int(s[-1])\n\n    def _is_special(number: int | float) -> bool:\n        # Determines if a single number meets all the \"special\" criteria.\n        if number <= 10:\n            return False\n        \n        first_digit = _get_first_digit(number)\n        last_digit = _get_last_digit(number)\n        \n        return _is_odd(first_digit) and _is_odd(last_digit)\n\n    count = 0\n    for number in nums:\n        if not isinstance(number, (int, float)):\n            raise ValueError(f\"Array contains non-numeric element: {number}\")\n        if _is_special(number):\n            count += 1\n            \n    return count"}
{"task_id": "HumanEval/148", "solution": "class Planet:\n    def __init__(self, name: str, order: int):\n        self._name = name\n        self._order = order\n\n    def get_name(self) -> str:\n        return self._name\n\n    def get_order(self) -> int:\n        return self._order\nPLANET_NAMES_ORDERED = [\n    \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n]\ndef normalize_planet_name(name: str) -> str:\n    \"\"\"Converts a planet name to a consistent, lowercase format.\"\"\"\n    return name.strip().lower()\nclass PlanetRepository:\n    def __init__(self):\n        self._planets = []\n        self._planet_name_to_order_map = {}\n\n        for i, name in enumerate(PLANET_NAMES_ORDERED):\n            planet = Planet(name, i)\n            self._planets.append(planet)\n            self._planet_name_to_order_map[normalize_planet_name(name)] = i\n\n    def get_planet_order(self, name: str) -> int | None:\n        \"\"\"Returns the orbital order of a planet given its normalized name.\"\"\"\n        return self._planet_name_to_order_map.get(name)\n\n    def get_planets_between(self, start_order: int, end_order: int) -> tuple[str, ...]:\n        \"\"\"Returns a tuple of planet names strictly between start_order and end_order.\"\"\"\n        min_order = min(start_order, end_order)\n        max_order = max(start_order, end_order)\n\n        intermediate_planets = []\n        for i in range(min_order + 1, max_order):\n            intermediate_planets.append(self._planets[i].get_name())\n        return tuple(intermediate_planets)\nclass PlanetService:\n    def __init__(self, repository: PlanetRepository):\n        self._repository = repository\n\n    def find_planets_between(self, planet1_name: str, planet2_name: str) -> tuple[str, ...]:\n        \"\"\"Finds planets between two given names, returning an empty tuple if invalid.\"\"\"\n        normalized_planet1 = normalize_planet_name(planet1_name)\n        normalized_planet2 = normalize_planet_name(planet2_name)\n\n        order1 = self._repository.get_planet_order(normalized_planet1)\n        order2 = self._repository.get_planet_order(normalized_planet2)\n\n        if order1 is None or order2 is None:\n            return ()\n\n        return self._repository.get_planets_between(order1, order2)\n_planet_repository = PlanetRepository()\n_planet_service = PlanetService(repository=_planet_repository)\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    return _planet_service.find_planets_between(planet1, planet2)"}
{"task_id": "HumanEval/147", "solution": "def combinations(n: int, k: int) -> int:\n    \"\"\"\n    Calculates nCk (n choose k).\n    Returns 0 if k > n or k < 0.\n    \"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n    \n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\ndef _calculate_a_i_mod_3(i: int) -> int:\n    \"\"\"\n    Calculates (i*i - i + 1) % 3 efficiently.\n    The result is 0 if i % 3 == 2, otherwise 1.\n    \"\"\"\n    i_mod_3 = i % 3\n    if i_mod_3 == 2:\n        return 0\n    else:\n        return 1\ndef get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k, \n    and a[i] + a[j] + a[k] is a multiple of 3.\n\n    Example :\n        Input: n = 5\n        Output: 1\n        Explanation: \n        a = [1, 3, 7, 13, 21]\n        The only valid triple is (1, 7, 13).\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input n must be a positive integer.\")\n    \n    if n < 3:\n        return 0\n\n    count0 = 0  # Count of a[i] where a[i] % 3 == 0\n    count1 = 0  # Count of a[i] where a[i] % 3 == 1\n\n    for i in range(1, n + 1):\n        remainder = _calculate_a_i_mod_3(i)\n        if remainder == 0:\n            count0 += 1\n        elif remainder == 1:\n            count1 += 1\n    \n    # Triples sum to 0 mod 3 if all elements are 0 mod 3 or all are 1 mod 3.\n    num_triples_000 = combinations(count0, 3)\n    num_triples_111 = combinations(count1, 3)\n\n    return num_triples_000 + num_triples_111"}
{"task_id": "HumanEval/152", "solution": "def compare(game: list[int], guess: list[int]) -> list[int]:\n    \"\"\"Compares actual game scores with guessed scores and returns an array of differences.\n    If a guess is correct, the difference is 0; otherwise, it's the absolute difference between the score and the guess.\n    \"\"\"\n    if len(game) != len(guess):\n        raise ValueError(\"Input arrays 'game' and 'guess' must be of equal length.\")\n\n    differences = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            differences.append(0)\n        else:\n            differences.append(abs(game[i] - guess[i]))\n            \n    return differences"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"\n    Counts the number of even and odd digits in an integer.\n    Returns a tuple (even_count, odd_count), handling negative numbers by absolute value and treating 0 as even.\n    \"\"\"\n    num_abs = abs(num)\n    num_str = str(num_abs)\n\n    even_count = 0\n    odd_count = 0\n\n    for char_digit in num_str:\n        digit = int(char_digit)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/154", "solution": "def _generate_rotations(s: str) -> list[str]:\n    \"\"\"Generates all unique cyclic rotations of a string.\n    Uses a set to ensure uniqueness for strings with repeating characters.\n    \"\"\"\n    if not s:\n        return [\"\"]\n    rotations = set()\n    n = len(s)\n    for i in range(n):\n        rotated_s = s[i:] + s[:i]\n        rotations.add(rotated_s)\n    return list(rotations)\ndef cycpattern_check(a: str, b: str) -> bool:\n    \"\"\"\n    Checks if the second word or any of its rotations is a substring in the first word.\n    Handles empty strings as per specification (empty string is a substring of any string).\n    \"\"\"\n    if not b:\n        return True\n    if not a:\n        return False\n\n    rotations_of_b = _generate_rotations(b)\n    for rotation in rotations_of_b:\n        if rotation in a:\n            return True\n    return False"}
{"task_id": "HumanEval/156", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    pass\n_ROMAN_MAP = [\n    (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n    (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n    (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n]\ndef int_to_mini_roman(number):\n    \"\"\"Converts a positive integer (1-1000) into its lowercase Roman numeral string.\n    Raises InvalidInputError if the number is out of range or not an integer.\n    \"\"\"\n    if not isinstance(number, int) or not (1 <= number <= 1000):\n        raise InvalidInputError(\"Input number must be an integer between 1 and 1000.\")\n\n    roman_numeral = []\n    temp_num = number\n\n    for value, symbol in _ROMAN_MAP:\n        while temp_num >= value:\n            roman_numeral.append(symbol)\n            temp_num -= value\n    \n    return \"\".join(roman_numeral).lower()"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"\n    Finds the word with the maximum number of unique characters.\n    Applies lexicographical order for tie-breaking.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            if word < result_word:\n                result_word = word\n    return result_word"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Finds the word with the most unique characters, breaking ties lexicographically.\n    Returns an empty string if the input list is empty.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        # Count unique characters for the current word.\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # If unique counts are tied, use lexicographical order.\n            if result_word == \"\" or word < result_word:\n                result_word = word\n    return result_word"}
{"task_id": "HumanEval/156", "solution": "ROMAN_MAP = [\n    (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n    (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n    (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n]\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    if not isinstance(number, int) or not (1 <= number <= 1000):\n        raise ValueError(\"Input number must be an integer between 1 and 1000.\")\n\n    result_parts = []\n    temp_num = number\n\n    for value, symbol in ROMAN_MAP:\n        while temp_num >= value:\n            result_parts.append(symbol)\n            temp_num -= value\n    \n    return \"\".join(result_parts).lower()"}
{"task_id": "HumanEval/153", "solution": "from dataclasses import dataclass\nfrom typing import List, Optional\ndef Strongest_Extension(class_name: str, extensions: List[str]) -> str:\n    \"\"\"\n    Finds the strongest extension for a given class name.\n    Returns a string in the format 'ClassName.StrongestExtensionName'.\n    \"\"\"\n\n    @dataclass\n    class ExtensionInfo:\n        name: str\n        strength: int\n\n    class ExtensionUtils:\n        @staticmethod\n        def calculate_strength(extension_name: str) -> int:\n            # Counts uppercase and lowercase letters to determine strength.\n            cap_count = sum(1 for char in extension_name if 'A' <= char <= 'Z')\n            sm_count = sum(1 for char in extension_name if 'a' <= char <= 'z')\n            return cap_count - sm_count\n\n    class ExtensionService:\n        def find_strongest_extension(self, class_name: str, extensions: List[str]) -> str:\n            # Returns 'ClassName.' if the extensions list is empty.\n            if not extensions:\n                return f\"{class_name}.\"\n\n            strongest_info: Optional[ExtensionInfo] = None\n\n            # Iterates to find the strongest extension, respecting tie-breaking rules.\n            for ext_name in extensions:\n                strength = ExtensionUtils.calculate_strength(ext_name)\n                current_info = ExtensionInfo(name=ext_name, strength=strength)\n\n                # Update if current is strictly stronger; for ties, the first encountered is kept.\n                if strongest_info is None or current_info.strength > strongest_info.strength:\n                    strongest_info = current_info\n\n            # Formats and returns the identified strongest extension.\n            return f\"{class_name}.{strongest_info.name}\"\n\n    service = ExtensionService()\n    return service.find_strongest_extension(class_name, extensions)"}
{"task_id": "HumanEval/153", "solution": "from typing import List, Optional\nfrom dataclasses import dataclass\nclass InvalidExtensionListError(Exception):\n    \"\"\"Custom exception for an invalid or empty extension list.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nclass ExtensionStrengthCalculator:\n    \"\"\"Calculates the strength of an extension string based on CAP - SM.\"\"\"\n    def calculate(self, extension_name: str) -> int:\n        if not isinstance(extension_name, str):\n            raise TypeError(\"Extension name must be a string.\")\n        cap_count = sum(1 for char in extension_name if char.isupper())\n        sm_count = sum(1 for char in extension_name if char.islower())\n        return cap_count - sm_count\nclass StrongestExtensionFinder:\n    \"\"\"Finds the strongest extension from a list, applying tie-breaking rules.\"\"\"\n    def __init__(self, calculator: ExtensionStrengthCalculator):\n        self._calculator = calculator\n\n    def find(self, extensions: List[str]) -> str:\n        if not extensions:\n            raise InvalidExtensionListError(\"Extension list cannot be empty.\")\n\n        strongest_ext: Optional[Extension] = None\n\n        for ext_name in extensions:\n            if not isinstance(ext_name, str):\n                raise TypeError(f\"All extensions must be strings, got {type(ext_name)}.\")\n\n            current_strength = self._calculator.calculate(ext_name)\n            current_ext = Extension(name=ext_name, strength=current_strength)\n\n            if strongest_ext is None or current_ext.strength > strongest_ext.strength:\n                strongest_ext = current_ext\n            # If strengths are equal, the existing 'strongest_ext' (first encountered) is retained.\n\n        return strongest_ext.name # 'strongest_ext' is guaranteed not to be None here.\nclass StrongestExtensionApp:\n    \"\"\"Orchestrates the process of finding and formatting the strongest extension.\"\"\"\n    def __init__(self, finder: StrongestExtensionFinder):\n        self._finder = finder\n\n    def run(self, class_name: str, extensions: List[str]) -> str:\n        if not isinstance(class_name, str):\n            raise TypeError(\"Class name must be a string.\")\n        strongest_ext_name = self._finder.find(extensions)\n        return f\"{class_name}.{strongest_ext_name}\"\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"\n    You will be given the name of a class (a string) and a list of extensions.\n    The extensions are to be used to load additional classes to the class. The\n    strength of the extension is as follows: Let CAP be the number of the uppercase\n    letters in the extension's name, and let SM be the number of lowercase letters\n    in the extension's name, the strength is given by the fraction CAP - SM.\n    You should find the strongest extension and return a string in this\n    format: ClassName.StrongestExtensionName.\n    If there are two or more extensions with the same strength, you should\n    choose the one that comes first in the list.\n    For example, if you are given \"Slices\" as the class and a list of the\n    extensions: ['SErviNGSliCes', 'Cheese', 'StuFfed'] then you should\n    return 'Slices.SErviNGSliCes' since 'SErviNGSliCes' is the strongest extension\n    (its strength is -1).\n    Example:\n    for Strongest_Extension('my_class', ['AA', 'Be', 'CC']) == 'my_class.AA'\n    \"\"\"\n    calculator = ExtensionStrengthCalculator()\n    finder = StrongestExtensionFinder(calculator)\n    app = StrongestExtensionApp(finder)\n    return app.run(class_name, extensions)"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates total carrots eaten by a rabbit and remaining stock after a meal.\n    It returns a list of [total eaten, carrots left].\n    \"\"\"\n    for param_name, value, min_val, max_val in [\n        (\"number\", number, 0, 1000),\n        (\"need\", need, 0, 1000),\n        (\"remaining\", remaining, 0, 1000)\n    ]:\n        if not isinstance(value, int):\n            raise ValueError(f\"{param_name} must be an integer.\")\n        if not (min_val <= value <= max_val):\n            raise ValueError(f\"{param_name} must be between {min_val} and {max_val}, inclusive.\")\n\n    if remaining >= need:\n        total_eaten = number + need\n        carrots_left = remaining - need\n    else:\n        total_eaten = number + remaining\n        carrots_left = 0\n\n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # All side lengths must be positive\n    if not (a > 0 and b > 0 and c > 0):\n        return False\n\n    # Triangle Inequality Theorem: The sum of the lengths of any two sides of a triangle must be greater than the length of the third side.\n    if not (a + b > c and a + c > b and b + c > a):\n        return False\n\n    # Sort the sides to easily identify the hypotenuse (longest side)\n    sides = sorted([a, b, c])\n    s1, s2, s3 = sides[0], sides[1], sides[2]\n\n    # Pythagorean theorem: s1^2 + s2^2 = s3^2\n    # Use a small epsilon for float comparison to account for precision issues\n    epsilon = 1e-9\n    return abs(s1**2 + s2**2 - s3**2) < epsilon"}
