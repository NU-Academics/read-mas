{"task_id": "HumanEval/41", "solution": "def car_race_collision(n: int):\n    \"\"\"\n    Imagine a road that's a perfectly straight infinitely long line.\n    n cars are driving left to right;  simultaneously, a different set of n cars\n    are driving right to left.   The two sets of cars start out being very far from\n    each other.  All cars move in the same speed.  Two cars are said to collide\n    when a car that's moving left to right hits a car that's moving right to left.\n    However, the cars are infinitely sturdy and strong; as a result, they continue moving\n    in their trajectory as if they did not collide.\n\n    This function outputs the number of such collisions.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Number of cars (n) cannot be negative.\")\n    return n * n"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    It returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n\n    seen_numbers = set()\n    zero_count = 0\n\n    for num in l:\n        if not isinstance(num, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n\n        if num == 0:\n            zero_count += 1\n            if zero_count >= 2:\n                # Found two distinct zeros (l[i] and l[j] where i != j)\n                return True\n        elif -num in seen_numbers:\n            # Found a pair (num and -num) that sum to zero\n            return True\n        seen_numbers.add(num)\n\n    return False"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"Checks if two distinct elements in the list sum to zero. Returns True if such a pair exists, False otherwise.\"\"\"\n    seen_numbers = set()\n    for num in l:\n        complement = -num\n        # Check if the complement exists and the current number is distinct from its complement (for zero).\n        if complement in seen_numbers and num != complement:\n            return True\n        seen_numbers.add(num)\n    return False"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Converts a non-negative integer `x` to its string representation in the specified `base`.\n    The base is assumed to be an integer between 2 and 9 inclusive.\"\"\"\n    if x == 0:\n        return '0'\n\n    res = []\n    temp_x = x\n    while temp_x > 0:\n        remainder = temp_x % base\n        res.append(str(remainder))\n        temp_x //= base\n    return \"\".join(res[::-1])"}
{"task_id": "HumanEval/45", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    pass\nclass InputValidator:\n    @staticmethod\n    def validate_positive_float(value: any, name: str) -> float:\n        \"\"\"Validates if a value is a positive float.\n        Raises InvalidInputError if validation fails.\n        \"\"\"\n        try:\n            float_value = float(value)\n        except (ValueError, TypeError):\n            raise InvalidInputError(f\"{name} must be a number.\")\n\n        if float_value <= 0:\n            raise InvalidInputError(f\"{name} must be a positive number.\")\n\n        return float_value\nclass TriangleAreaCalculator:\n    def calculate(self, base: float, height: float) -> float:\n        \"\"\"Computes the area of a triangle.\n        Validates base and height, then applies the area formula.\n        \"\"\"\n        try:\n            validated_base = InputValidator.validate_positive_float(base, \"base\")\n            validated_height = InputValidator.validate_positive_float(height, \"height\")\n        except InvalidInputError as e:\n            raise e\n\n        return 0.5 * validated_base * validated_height\ndef triangle_area(a: float, h: float) -> float:\n    \"\"\"Given length of a side and high return area for a triangle.\n    It performs validation and calculation using a dedicated calculator class.\n    \"\"\"\n    calculator = TriangleAreaCalculator()\n    return calculator.calculate(a, h)"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int) -> int:\n    \"\"\"Computes the n-th element of the Fib4 number sequence iteratively.\n    Raises ValueError if n is negative, otherwise returns the calculated Fib4 number.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    elif n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n    else:\n        # fib4_values stores [fib4(i-4), fib4(i-3), fib4(i-2), fib4(i-1)]\n        fib4_values = [0, 0, 2, 0]\n\n        for _ in range(4, n + 1):\n            next_fib4 = sum(fib4_values)\n            fib4_values.pop(0) # Remove the oldest element\n            fib4_values.append(next_fib4) # Add the new element\n\n        return fib4_values[3] # The last computed value is fib4(n)"}
{"task_id": "HumanEval/45", "solution": "def triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    if not isinstance(a, (int, float)):\n        raise TypeError(\"Base must be a number.\")\n    if a <= 0:\n        raise ValueError(\"Base must be a positive number.\")\n\n    if not isinstance(h, (int, float)):\n        raise TypeError(\"Height must be a number.\")\n    if h <= 0:\n        raise ValueError(\"Height must be a positive number.\")\n\n    return 0.5 * a * h"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    dp = [0, 0, 2, 0]\n\n    for i in range(4, n + 1):\n        next_fib4 = dp[i-1] + dp[i-2] + dp[i-3] + dp[i-4]\n        dp.append(next_fib4)\n\n    return dp[n]"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str):\n    \"\"\"\n    Checks if a given string is a palindrome.\n    A palindrome reads the same forwards and backwards, considering all characters and case.\n    \"\"\"\n    return text == text[::-1]"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    if not l:\n        # Raise ValueError for an empty input list, as per FR1 and BR3.\n        raise ValueError(\"Input list cannot be empty.\")\n\n    # Validate all elements are numeric (int or float), adhering to FR1 and FR2.\n    for item in l:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"Input list must contain only numeric elements (int or float).\")\n\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # For odd-length lists, the median is the middle element (BR1, FR1).\n        return sorted_l[n // 2]\n    else:\n        # For even-length lists, the median is the average of the two middle elements (BR2, FR1, FR4).\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2.0"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int) -> int:\n    \"\"\"Return 2^n modulo p.\n    This function calculates modular exponentiation using an optimized built-in.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Exponent 'n' must be a non-negative integer.\")\n    if not isinstance(p, int) or p <= 0:\n        raise ValueError(\"Modulus 'p' must be a positive integer.\")\n\n    return pow(2, n, p)"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int) -> int:\n    \"\"\"Return 2^n modulo p using binary exponentiation.\n    Validates inputs for non-negative n and positive p.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Exponent 'n' must be a non-negative integer.\")\n    if p <= 0:\n        raise ValueError(\"Modulus 'p' must be a positive integer.\")\n\n    if n == 0:\n        return 1 % p # Handles 2^0 mod p = 1 mod p, which is 0 for p=1.\n\n    result = 1\n    base = 2 % p # Start with base = 2, taking modulo p to keep numbers small.\n    \n    # Binary exponentiation (exponentiation by squaring)\n    while n > 0:\n        if n % 2 == 1:  # If n is odd, multiply result by current base.\n            result = (result * base) % p\n        base = (base * base) % p\n        n //= 2\n        \n    return result"}
{"task_id": "HumanEval/50", "solution": "def decode_shift(s: str):\n    \"\"\"\n    Decodes an encoded string by shifting each lowercase English letter back by 5 positions.\n    It correctly handles wrap-around from 'a' to 'z'.\n    \"\"\"\n    SHIFT_AMOUNT = 5\n    ALPHABET_SIZE = 26\n    ALPHABET_START_ORD = ord('a')\n    \n    decoded_chars = []\n    for char in s:\n        char_code = ord(char)\n        # Calculate the position relative to 'a'\n        relative_pos = char_code - ALPHABET_START_ORD\n        # Shift back and handle wrap-around\n        shifted_relative_pos = (relative_pos - SHIFT_AMOUNT + ALPHABET_SIZE) % ALPHABET_SIZE\n        # Convert back to character and append\n        decoded_chars.append(chr(ALPHABET_START_ORD + shifted_relative_pos))\n        \n    return \"\".join(decoded_chars)"}
