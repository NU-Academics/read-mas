{"task_id": "HumanEval/35", "solution": "from typing import Any\ndef max_element(l: list) -> Any:\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    if not l:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    max_val = l[0]\n    for element in l:\n        if element > max_val:\n            max_val = element\n    return max_val"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not isinstance(l, list):\n        # Input must be a list according to FR1.\n        raise TypeError(\"Input must be a list.\")\n\n    if not l:\n        # Handle empty lists gracefully as per NFR4.\n        return []\n\n    list_length = len(l)\n    # Identify all indices i in l such that i % 3 == 0 (FR2).\n    third_indices = [i for i in range(list_length) if i % 3 == 0]\n\n    if not third_indices:\n        # If no elements are at indices divisible by three, return a shallow copy of the original list (FR5).\n        return l[:]\n\n    # Extract the elements from l corresponding to the identified indices (FR3).\n    extracted_elements = [l[i] for i in third_indices]\n    try:\n        # Sort the extracted elements in ascending order (FR4).\n        extracted_elements.sort()\n    except TypeError as e:\n        # If elements are not sortable, raise a TypeError (FR4 error handling).\n        raise TypeError(f\"Elements in the list are not sortable: {e}\")\n\n    # Create a new list l' that is initially a shallow copy of l (FR5).\n    result_list = l[:]\n    # Replace elements in l' at the identified indices with the corresponding sorted extracted elements (FR6).\n    for i, sorted_val in zip(third_indices, extracted_elements):\n        result_list[i] = sorted_val\n\n    # Return the modified list l' (FR7).\n    return result_list"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    total_sevens_count = 0\n    for i in range(1, n):\n        if (i % 11 == 0) or (i % 13 == 0):\n            # Count occurrences of '7' in the current number.\n            total_sevens_count += str(i).count('7')\n    return total_sevens_count"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    \"\"\"\n    if not l:\n        return []\n\n    even_indexed_elements = []\n    for i in range(len(l)):\n        if i % 2 == 0:\n            even_indexed_elements.append(l[i])\n\n    even_indexed_elements.sort() # Sorts in ascending order.\n\n    result_list = l[:] # Create a shallow copy to build the new list.\n\n    even_idx_counter = 0\n    for i in range(len(result_list)):\n        if i % 2 == 0:\n            result_list[i] = even_indexed_elements[even_idx_counter]\n            even_idx_counter += 1\n            \n    return result_list"}
{"task_id": "HumanEval/36", "solution": "def _count_digit(number: int, digit: int) -> int:\n    \"\"\"Counts occurrences of a specific digit in an integer.\n    Handles negative numbers by using their absolute value for counting.\n    \"\"\"\n    if not isinstance(number, int):\n        raise ValueError(\"Input 'number' must be an integer.\")\n    if not isinstance(digit, int) or not (0 <= digit <= 9):\n        raise ValueError(\"Input 'digit' must be a single integer between 0 and 9.\")\n\n    count = 0\n    abs_number = abs(number)\n    \n    if abs_number == 0 and digit == 0:\n        return 1\n\n    while abs_number > 0:\n        if abs_number % 10 == digit:\n            count += 1\n        abs_number //= 10\n    return count\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    total_count = 0\n    for i in range(1, n):\n        if (i % 11 == 0) or (i % 13 == 0):\n            total_count += _count_digit(i, 7)\n    return total_count"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    Decodes a string by reversing the cyclic shift on groups of three characters.\n    Groups shorter than three characters are left unchanged.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    decoded_parts = []\n    # Process the string in blocks of three characters, reversing the shift for full blocks.\n    for i in range(0, len(s), 3):\n        group = s[i:i+3]\n        if len(group) == 3:\n            # To reverse 'abc' -> 'bca', for 'bca' the original 'a' is group[2], 'b' is group[0], 'c' is group[1].\n            decoded_parts.append(group[2] + group[0] + group[1])\n        else:\n            decoded_parts.append(group)\n    return \"\".join(decoded_parts)"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not l:\n        return []\n\n    even_indexed_elements = [l[i] for i in range(0, len(l), 2)]\n    try:\n        even_indexed_elements.sort()\n    except TypeError as e:\n        raise TypeError(f\"Elements at even indices must be comparable: {e}\") from e\n\n    result = l[:]  # Create a shallow copy to avoid modifying the original list.\n    even_sorted_idx = 0\n    for i in range(0, len(l), 2):\n        result[i] = even_indexed_elements[even_sorted_idx]\n        even_sorted_idx += 1\n    return result"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    Takes as input string encoded with encode_cyclic function. Returns decoded string.\n    This function reverses the cyclic shift applied to groups of three characters.\n    \"\"\"\n    decoded_parts = []\n    for i in range(0, len(s), 3):\n        group = s[i:i+3]\n        if len(group) == 3:\n            # Reverse the cycle: move the last character to the front.\n            decoded_group = group[2] + group[0] + group[1]\n            decoded_parts.append(decoded_group)\n        else:\n            # Groups with fewer than three characters are not altered.\n            decoded_parts.append(group)\n    return \"\".join(decoded_parts)"}
{"task_id": "HumanEval/39", "solution": "from typing import Generator\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input scenarios.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nclass FibonacciCalculator:\n    \"\"\"Generates Fibonacci numbers, caching results.\"\"\"\n    def __init__(self):\n        self._cache: dict[int, int] = {0: 0, 1: 1}\n\n    def generate_fibonacci_sequence(self) -> Generator[int, None, None]:\n        \"\"\"Yields an infinite sequence of Fibonacci numbers.\"\"\"\n        a, b = 0, 1\n        count = 0\n        while True:\n            if count in self._cache:\n                yield self._cache[count]\n            else:\n                self._cache[count] = a\n                yield a\n            a, b = b, a + b\n            count += 1\nclass PrimeChecker:\n    \"\"\"Checks if a given number is prime, caching results.\"\"\"\n    def __init__(self):\n        self._cache: dict[int, bool] = {}\n\n    def is_prime(self, num: int) -> bool:\n        \"\"\"Determines if a number is prime using trial division.\"\"\"\n        if num in self._cache:\n            return self._cache[num]\n\n        if num < 2:\n            self._cache[num] = False\n            return False\n        if num == 2:\n            self._cache[num] = True\n            return True\n        if num % 2 == 0:\n            self._cache[num] = False\n            return False\n        \n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                self._cache[num] = False\n                return False\n            i += 2\n        \n        self._cache[num] = True\n        return True\nclass PrimeFibService:\n    \"\"\"Orchestrates finding the Nth prime Fibonacci number.\"\"\"\n    def __init__(self, fib_calculator: FibonacciCalculator, prime_checker: PrimeChecker):\n        self._fib_calculator = fib_calculator\n        self._prime_checker = prime_checker\n\n    def get_nth_prime_fib(self, n: int) -> int:\n        \"\"\"Calculates and returns the Nth prime Fibonacci number.\"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n\n        prime_fib_numbers = []\n        fib_generator = self._fib_calculator.generate_fibonacci_sequence()\n\n        # Skip initial 0, 1 as per problem examples.\n        next(fib_generator) # 0\n        next(fib_generator) # 1\n\n        while len(prime_fib_numbers) < n:\n            fib_num = next(fib_generator)\n            if self._prime_checker.is_prime(fib_num):\n                prime_fib_numbers.append(fib_num)\n        \n        return prime_fib_numbers[n - 1]\n_fib_calculator = FibonacciCalculator()\n_prime_checker = PrimeChecker()\n_prime_fib_service = PrimeFibService(_fib_calculator, _prime_checker)\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    return _prime_fib_service.get_nth_prime_fib(n)"}
{"task_id": "HumanEval/39", "solution": "import math\nfrom typing import Iterator\ndef _is_prime(num: int) -> bool:\n    \"\"\"\n    Checks if a given integer is a prime number.\n    It efficiently verifies primality by checking divisors up to its square root.\n    \"\"\"\n    if num < 2:\n        return False\n    for i in range(2, int(math.sqrt(num)) + 1):\n        if num % i == 0:\n            return False\n    return True\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    prime_fib_count = 0\n    fib_generator = _generate_fibonacci_numbers()\n\n    # Skip initial Fibonacci numbers (0, 1, 1) as they are not considered prime in this sequence.\n    # The first prime Fibonacci number is 2.\n    next(fib_generator) # 0\n    next(fib_generator) # 1\n    next(fib_generator) # 1\n\n    while True:\n        fib_num = next(fib_generator)\n        if _is_prime(fib_num):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                return fib_num"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list) -> bool:\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    l.sort()  # Sort the list to efficiently use the two-pointer technique\n\n    for i in range(n - 2):\n        # Skip duplicate elements for 'i' to avoid redundant checks\n        if i > 0 and l[i] == l[i-1]:\n            continue\n\n        left = i + 1\n        right = n - 1\n\n        while left < right:\n            current_sum = l[i] + l[left] + l[right]\n\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n            else: # current_sum > 0\n                right -= 1\n    return False"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list) -> bool:\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    sorted_l = sorted(l)\n\n    for i in range(n - 2):\n        # Skip duplicate elements for the first number to avoid redundant checks.\n        if i > 0 and sorted_l[i] == sorted_l[i-1]:\n            continue\n\n        left = i + 1\n        right = n - 1\n\n        while left < right:\n            current_sum = sorted_l[i] + sorted_l[left] + sorted_l[right]\n\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n            else: # current_sum > 0\n                right -= 1\n    return False"}
