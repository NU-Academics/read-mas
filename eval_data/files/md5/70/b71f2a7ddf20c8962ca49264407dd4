{"task_id": "Mbpp/277", "solution": "from collections import OrderedDict\nfrom collections.abc import Mapping\nfrom typing import Any, Mapping as MappingType, Dict\n\n\nclass InvalidMappingError(TypeError):\n    \"\"\"Raised when the input is not a mapping object.\"\"\"\n\n\nclass InvalidThresholdError(TypeError):\n    \"\"\"Raised when the threshold is not an integer.\"\"\"\n\n\ndef filter_dict_by_value(\n    data: MappingType[Any, Any],\n    threshold: int\n) -> MappingType[Any, Any]:\n    \"\"\"\n    Return a new mapping containing only items where the value is greater than\n    or equal to *threshold*.\n\n    Parameters\n    ----------\n    data : Mapping[Any, Any]\n        Input mapping (e.g., dict, OrderedDict).\n    threshold : int\n        Numeric threshold to filter values.\n\n    Returns\n    -------\n    Mapping[Any, Any]\n        New mapping preserving the order of the input if it is order\u2011preserving.\n\n    Raises\n    ------\n    InvalidMappingError\n        If *data* does not implement the Mapping protocol.\n    InvalidThresholdError\n        If *threshold* is not an integer.\n    \"\"\"\n    if not isinstance(data, Mapping):\n        raise InvalidMappingError(\n            f\"data must be a mapping, got {type(data).__name__}\"\n        )\n\n    if not isinstance(threshold, int):\n        raise InvalidThresholdError(\n            f\"threshold must be an int, got {type(threshold).__name__}\"\n        )\n\n    # Preserve order if the input is an OrderedDict\n    result: Dict[Any, Any] = (\n        OrderedDict() if isinstance(data, OrderedDict) else {}\n    )\n\n    for key, value in data.items():\n        try:\n            if value >= threshold:\n                result[key] = value\n        except TypeError:\n            # Skip values that cannot be compared to an int\n            continue\n\n    return result"}
{"task_id": "Mbpp/278", "solution": "def count_before_first_nested_tuple(t: tuple) -> int:\n    \"\"\"Counts the number of elements before the first nested tuple in the input tuple.\n\n    Parameters:\n        t (tuple): The tuple to inspect.\n\n    Returns:\n        int: The count of elements preceding the first nested tuple,\n             or -1 if no nested tuple is present.\n    \"\"\"\n    count = 0\n    for element in t:\n        if isinstance(element, tuple):\n            return count\n        count += 1\n    return -1"}
{"task_id": "Mbpp/279", "solution": "__all__ = [\"decagonal_number\"]\n\n\ndef decagonal_number(n: int) -> int:\n    \"\"\"\n    Compute the n-th decagonal number.\n\n    Parameters\n    ----------\n    n : int\n        The position in the decagonal sequence (1\u2011based). Must be a positive integer.\n\n    Returns\n    -------\n    int\n        The n-th decagonal number.\n\n    Raises\n    ------\n    ValueError\n        If `n` is not an integer or is <= 0.\n\n    Notes\n    -----\n    The decagonal number sequence starts with D_1 = 1, D_2 = 14, D_3 = 33, ...\n\n    Examples\n    --------\n    >>> decagonal_number(1)\n    1\n    >>> decagonal_number(2)\n    14\n    >>> decagonal_number(5)\n    85\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n    return n * (4 * n - 3)"}
{"task_id": "Mbpp/280", "solution": "def sequential_search(array, element):\n    \"\"\"\n    Search for ``element`` in ``array`` using a sequential (linear) search.\n\n    Parameters\n    ----------\n    array : Iterable\n        The collection to search. Must support iteration.\n    element : Any\n        The value to locate within ``array``.\n\n    Returns\n    -------\n    tuple[bool, int]\n        (True, index) if ``element`` is found at the first occurrence.\n        (False, -1) if ``element`` is not present.\n\n    Raises\n    ------\n    TypeError\n        If ``array`` is not iterable.\n        If comparison between ``element`` and an array item raises an exception.\n    \"\"\"\n    # Validate that array is iterable\n    try:\n        iterator = iter(array)\n    except TypeError as exc:\n        raise TypeError(\"`array` must be an iterable\") from exc\n\n    # Perform linear search\n    for idx, val in enumerate(iterator):\n        try:\n            if val == element:\n                return True, idx\n        except Exception as exc:\n            raise TypeError(f\"Comparison failed: {exc}\") from exc\n\n    return False, -1"}
{"task_id": "Mbpp/281", "solution": "from collections.abc import Iterable as _Iterable\nfrom typing import Any, Iterable as _IterableType\n\ndef are_elements_unique(data: _IterableType[Any]) -> bool:\n    \"\"\"\n    Return True if all elements in *data* are unique, False otherwise.\n\n    Parameters\n    ----------\n    data : Iterable\n        An iterable containing hashable elements.\n\n    Returns\n    -------\n    bool\n        True if each element occurs exactly once; False if any duplicates exist.\n\n    Raises\n    ------\n    TypeError\n        If *data* is not iterable or contains an unhashable element.\n\n    Examples\n    --------\n    >>> are_elements_unique([1, 2, 3, 4])\n    True\n    >>> are_elements_unique([1, 2, 3, 2])\n    False\n    >>> are_elements_unique('abc')\n    True\n    >>> are_elements_unique(42)\n    Traceback (most recent call last):\n        ...\n    TypeError: Input must be an iterable.\n    \"\"\"\n    if not isinstance(data, _Iterable):\n        raise TypeError(\"Input must be an iterable.\")\n\n    seq = list(data)\n    seen = set()\n    for item in seq:\n        if item in seen:\n            return False\n        seen.add(item)\n    return True"}
{"task_id": "Mbpp/282", "solution": "from typing import List\n\ndef sub_list(list1: List[float], list2: List[float]) -> List[float]:\n    \"\"\"\n    Subtract two lists element\u2011wise.\n\n    Parameters\n    ----------\n    list1 : list of int or float\n        The minuend list.\n    list2 : list of int or float\n        The subtrahend list.\n\n    Returns\n    -------\n    list of float\n        A new list where each element is the difference\n        of the corresponding elements in `list1` and `list2`.\n\n    Raises\n    ------\n    TypeError\n        If either argument is not a list or contains non\u2011numeric\n        elements.\n    ValueError\n        If the input lists have different lengths.\n\n    Examples\n    --------\n    >>> sub_list([5, 10, 15], [1, 2, 3])\n    [4, 8, 12]\n    \"\"\"\n    if not isinstance(list1, list):\n        raise TypeError(\"list1 must be of type list\")\n    if not isinstance(list2, list):\n        raise TypeError(\"list2 must be of type list\")\n    if len(list1) != len(list2):\n        raise ValueError(\"Both lists must have the same length\")\n\n    result: List[float] = []\n    for a, b in zip(list1, list2):\n        if not isinstance(a, (int, float)):\n            raise TypeError(\"All elements must be int or float\")\n        if not isinstance(b, (int, float)):\n            raise TypeError(\"All elements must be int or float\")\n        result.append(a - b)\n\n    return result\n\n# Simple test\nif __name__ == \"__main__\":\n    assert sub_list([1, 2, 3], [4, 5, 6]) == [-3, -3, -3]\n    print(\"All tests passed.\")"}
{"task_id": "Mbpp/283", "solution": "def validate(n: int) -> bool:\n    \"\"\"Return True if the frequency of each decimal digit in `n` is <= the digit itself.\"\"\"\n    n = abs(n)\n    freq = [0] * 10\n    if n == 0:\n        freq[0] = 1\n    else:\n        while n:\n            digit = n % 10\n            freq[digit] += 1\n            n //= 10\n    return all(f <= d for d, f in enumerate(freq) if f)\n\nassert validate(1234) == True"}
{"task_id": "Mbpp/284", "solution": "```python\nfrom typing import Any, Iterable\n\n\ndef _is_iterable(obj: Any) -> bool:\n    \"\"\"Determine whether *obj* is iterable.\"\"\"\n    try:\n        iter(obj)\n    except TypeError:\n        return False\n    return True\n\n\ndef are_all_equal(iterable: Iterable[Any], target: Any) -> bool:\n    \"\"\"Return True if every element in *iterable* is equal to *target*.\n\n    Parameters\n    ----------\n    iterable : Iterable[Any]\n        The sequence to inspect. Must be iterable.\n    target : Any\n        The value to compare against.\n\n    Returns\n    -------\n    bool\n        True if all elements equal ``target``, else False.\n        Returns True for an empty iterable.\n\n    Raises\n    ------\n    TypeError\n        If *iterable* is not iterable.\n\n    Examples\n    --------\n    >>> are_all_equal([1, 1, 1], 1)\n    True\n    >>> are_all_equal([1, 2, 1], 1)\n    False\n    >>> are_all_equal([], 0)\n    True\n    \"\"\"\n    if not _is_iterable(iterable):\n        raise TypeError(\"Provided object is not iterable\")\n\n    for element in iterable:\n        if element != target:\n            return False\n    return True\n```"}
{"task_id": "Mbpp/285", "solution": "def text_match_two_three(s: str) -> bool:\n    \"\"\"\n    Determine whether *s* contains the substring 'abb' or 'abbb'.\n\n    Parameters\n    ----------\n    s : str\n        The string to search. Must be a Unicode string.\n\n    Returns\n    -------\n    bool\n        ``True`` if either 'abb' or 'abbb' is present, otherwise ``False``.\n\n    Raises\n    ------\n    TypeError\n        If *s* is not a string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string\")\n\n    if not s:\n        return False\n\n    patterns = (\"abb\", \"abbb\")\n    for i in range(len(s)):\n        for pat in patterns:\n            if s.startswith(pat, i):\n                return True\n    return False\n\n# Example usage:\n# assert text_match_two_three(\"ac\") == False\n# assert text_match_two_three(\"abbb\") == True\n# assert text_match_two_three(\"cabb\") == True\n# assert text_match_two_three(\"abbbb\") == False\n\nif __name__ == \"__main__\":\n    import doctest\n    doctest.testmod()"}
{"task_id": "Mbpp/286", "solution": "from typing import List\n\ndef max_sub_array_sum_repeated(array: List[int], n: int, k: int) -> int:\n    \"\"\"Return the maximum possible sum of any contiguous sub\u2011array when the\n    input array is conceptually repeated *k* times.\n\n    Parameters\n    ----------\n    array : List[int]\n        The input array of integers.\n    n : int\n        Expected length of the input array.\n    k : int\n        Number of times the array is repeated. Must be >= 1.\n\n    Returns\n    -------\n    int\n        The maximum sub\u2011array sum over the concatenated array.\n\n    Raises\n    ------\n    ValueError\n        If *n* does not equal ``len(array)``, if *k* < 1, or if the array\n        is empty.\n    \"\"\"\n    def _validate_inputs(arr: List[int], exp_len: int, repeat: int) -> None:\n        if exp_len != len(arr):\n            raise ValueError(f\"Expected array length {exp_len} but got {len(arr)}\")\n        if repeat < 1:\n            raise ValueError(f\"k must be >= 1, got {repeat}\")\n        if not arr:\n            raise ValueError(\"array must not be empty\")\n\n    def _kadane(nums: List[int]) -> int:\n        max_ending = nums[0]\n        max_so_far = nums[0]\n        for x in nums[1:]:\n            max_ending = x if max_ending < 0 and x > max_ending else max_ending + x\n            if max_ending > max_so_far:\n                max_so_far = max_ending\n        return max_so_far\n\n    def _prefix_suffix_and_total(nums: List[int]) -> tuple[int, int, int]:\n        total = 0\n        max_prefix = cur_prefix = 0\n        for x in nums:\n            total += x\n            cur_prefix += x\n            if cur_prefix > max_prefix:\n                max_prefix = cur_prefix\n\n        max_suffix = cur_suffix = 0\n        for x in reversed(nums):\n            cur_suffix += x\n            if cur_suffix > max_suffix:\n                max_suffix = cur_suffix\n\n        return max_prefix, max_suffix, total\n\n    _validate_inputs(array, n, k)\n\n    max_single = _kadane(array)\n\n    if k == 1:\n        return max_single\n\n    max_prefix, max_suffix, total_sum = _prefix_suffix_and_total(array)\n\n    candidate1 = max_single\n    candidate2 = max_suffix + max_prefix\n    best = candidate1 if candidate1 >= candidate2 else candidate2\n\n    if total_sum > 0:\n        candidate3 = max_suffix + max_prefix + (k - 2) * total_sum\n        if candidate3 > best:\n            best = candidate3\n\n    return best\n"}
{"task_id": "Mbpp/287", "solution": "def sum_of_squares_of_even(n: int) -> int:\n    \"\"\"Calculate the sum of squares of the first `n` even natural numbers.\n\n    Parameters\n    ----------\n    n : int\n        The count of even natural numbers to include. Must be a positive integer.\n\n    Returns\n    -------\n    int\n        The sum of squares: 4 * sum_{k=1}^{n} k^2\n\n    Raises\n    ------\n    TypeError\n        If `n` is not an integer.\n    ValueError\n        If `n` is less than or equal to zero.\n\n    Examples\n    --------\n    >>> sum_of_squares_of_even(3)\n    56\n    >>> sum_of_squares_of_even(5)\n    220\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n\n    return 4 * n * (n + 1) * (2 * n + 1) // 6"}
{"task_id": "Mbpp/290", "solution": "from __future__ import annotations\nfrom typing import Iterable, List, Sequence, Tuple, TypeVar\n\nT = TypeVar(\"T\")\n\ndef max_length(sublists: Sequence[Sequence[T]]) -> Tuple[int, List[T]]:\n    \"\"\"Return the longest sub\u2011list found in *sublists*.\n\n    Parameters\n    ----------\n    sublists : Sequence[Sequence[T]]\n        An iterable where each element is itself a sequence.\n        The outer sequence may be empty.\n\n    Returns\n    -------\n    Tuple[int, List[T]]\n        A tuple containing:\n            * The length of the longest sub\u2011list.\n            * The first sub\u2011list with that length, converted to a list.\n\n    Examples\n    --------\n    >>> max_length([[1, 2], [3, 4, 5], [6]])\n    (3, [3, 4, 5])\n    >>> max_length([])\n    (0, [])\n    \"\"\"\n    max_len = 0\n    longest: List[T] = []\n\n    for sub in sublists:\n        if not isinstance(sub, Iterable):\n            raise TypeError(f\"Element {sub!r} is not iterable\")\n\n        current_len = len(sub)\n        if current_len > max_len:\n            max_len = current_len\n            longest = list(sub)\n\n    return max_len, longest\n\n\n# Example usage\nif __name__ == \"__main__\":\n    assert max_length([[0], [1, 3], [5, 7], [9, 11], [13, 15, 17]]) == (3, [13, 15, 17])\n    print(\"All tests passed.\")\n"}
{"task_id": "Mbpp/292", "solution": "from typing import Union\n\ndef find(dividend: Union[int, float], divisor: Union[int, float]) -> int:\n    \"\"\"\n    Returns the floor division of `dividend` by `divisor`.\n\n    Parameters\n    ----------\n    dividend : int | float\n        The number to be divided.\n    divisor : int | float\n        The number by which to divide. Must not be zero.\n\n    Returns\n    -------\n    int\n        The integer result of floor division.\n\n    Raises\n    ------\n    ValueError\n        If `divisor` is zero.\n        If either argument is not an int or float.\n\n    Examples\n    --------\n    >>> find(10, 3)\n    3\n    >>> find(-10, 3)\n    -4\n    >>> find(10, 0)\n    Traceback (most recent call last):\n        ...\n    ValueError: divisor must not be zero\n    \"\"\"\n    if not isinstance(dividend, (int, float)):\n        raise ValueError(\"dividend must be an int or float\")\n    if not isinstance(divisor, (int, float)):\n        raise ValueError(\"divisor must be an int or float\")\n    if divisor == 0:\n        raise ValueError(\"divisor must not be zero\")\n    return int(dividend // divisor)"}
{"task_id": "Mbpp/293", "solution": "import math\nfrom typing import Union\n\ndef otherside_rightangle(a: float, b: float) -> float:\n    \"\"\"Calculate the hypotenuse of a right\u2011angled triangle.\n\n    Args:\n        a (float): Length of the first perpendicular side.\n        b (float): Length of the second perpendicular side.\n\n    Returns:\n        float: Length of the hypotenuse.\n\n    Raises:\n        ValueError: If either `a` or `b` is not a real number or is negative.\n\n    Example:\n        >>> otherside_rightangle(3.0, 4.0)\n        5.0\n    \"\"\"\n    if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n        raise ValueError(\"Both arguments must be numeric types.\")\n    if a < 0 or b < 0:\n        raise ValueError(f\"Side lengths must be non\u2011negative; received a={a}, b={b}.\")\n    return math.sqrt(a * a + b * b)"}
{"task_id": "Mbpp/294", "solution": "from typing import Any, List, Optional\n\ndef max_val(values: List[Any]) -> Optional[float]:\n    \"\"\"\n    Return the maximum numeric value from a list containing heterogeneous elements.\n\n    Parameters\n    ----------\n    values : List[Any]\n        A list of elements that may include integers, floats, strings, and other objects.\n\n    Returns\n    -------\n    Optional[float]\n        The maximum numeric value found, converted to float. \n        Returns None if the list contains no numeric elements.\n\n    Examples\n    --------\n    >>> max_val([1, 'a', 3.5, None, 2])\n    3.5\n    >>> max_val(['x', 'y'])\n    None\n    \"\"\"\n    max_value: Optional[float] = None\n    for item in values:\n        if isinstance(item, (int, float)):\n            numeric = float(item)\n            if max_value is None or numeric > max_value:\n                max_value = numeric\n    return max_value"}
{"task_id": "Mbpp/296", "solution": "import typing\n\n__all__ = [\"get_Inv_Count\"]\n\n\ndef get_Inv_Count(arr: typing.List[int]) -> int:\n    \"\"\"\n    Compute the number of inversions in an integer array.\n\n    Parameters\n    ----------\n    arr : list[int]\n        The array to analyze.\n\n    Returns\n    -------\n    int\n        Total inversion count.\n\n    Raises\n    ------\n    TypeError\n        If the input is not a list of integers.\n    \"\"\"\n    _validate_input(arr)\n\n    n = len(arr)\n    if n <= 1:\n        return 0\n\n    # Work on a copy to preserve immutability\n    data = arr.copy()\n    temp = [0] * n\n    return _merge_sort_and_count(data, temp, 0, n - 1)\n\n\ndef _merge_sort_and_count(\n    arr: typing.List[int], temp: typing.List[int], left: int, right: int\n) -> int:\n    \"\"\"\n    Recursive merge sort that returns the inversion count.\n    \"\"\"\n    if left >= right:\n        return 0\n\n    mid = (left + right) // 2\n    inv_count = _merge_sort_and_count(arr, temp, left, mid)\n    inv_count += _merge_sort_and_count(arr, temp, mid + 1, right)\n    inv_count += _merge_and_count(arr, temp, left, mid, right)\n    return inv_count\n\n\ndef _merge_and_count(\n    arr: typing.List[int], temp: typing.List[int], left: int, mid: int, right: int\n) -> int:\n    \"\"\"\n    Merge two sorted halves of `arr` and count cross inversions.\n    \"\"\"\n    i, j, k = left, mid + 1, left\n    inv_count = 0\n\n    while i <= mid and j <= right:\n        if arr[i] <= arr[j]:\n            temp[k] = arr[i]\n            i += 1\n        else:\n            temp[k] = arr[j]\n            inv_count += (mid - i + 1)\n            j += 1\n        k += 1\n\n    while i <= mid:\n        temp[k] = arr[i]\n        i += 1\n        k += 1\n\n    while j <= right:\n        temp[k] = arr[j]\n        j += 1\n        k += 1\n\n    # Copy back to the original array\n    arr[left : right + 1] = temp[left : right + 1]\n    return inv_count\n\n\ndef _validate_input(arr: typing.Any) -> None:\n    \"\"\"\n    Validate that `arr` is a list of integers.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list of integers.\")\n    for idx, item in enumerate(arr):\n        if not isinstance(item, int):\n            raise TypeError(\n                f\"All elements must be integers. \"\n                f\"Element at index {idx} is of type {type(item).__name__}.\"\n            )"}
{"task_id": "Mbpp/297", "solution": "from typing import List, Union, Any\n\n\ndef flatten(nested: List[Union[int, List[Any]]]) -> List[int]:\n    \"\"\"Return a flat list of integers preserving order from a nested list.\n\n    Parameters\n    ----------\n    nested : List[Union[int, List[Any]]]\n        The nested list to flatten. It may contain integers or other lists\n        of the same structure.\n\n    Returns\n    -------\n    List[int]\n        A new list containing all integers from `nested` in left\u2011to\u2011right\n        traversal order.\n\n    Raises\n    ------\n    TypeError\n        If an element is neither an int nor a list.\n    \"\"\"\n    result: List[int] = []\n\n    def _flatten(sublist: List[Union[int, List[Any]]]) -> None:\n        for elem in sublist:\n            if isinstance(elem, int):\n                result.append(elem)\n            elif isinstance(elem, list):\n                _flatten(elem)\n            else:\n                raise TypeError(\n                    f\"Unsupported element type: {type(elem).__name__}\"\n                )\n\n    _flatten(nested)\n    return result"}
{"task_id": "Mbpp/299", "solution": "from __future__ import annotations\nfrom typing import List, Tuple, Optional, Dict\n\n\ndef max_aggregate(records: List[Tuple[str, int]]) -> Optional[Tuple[str, int]]:\n    \"\"\"Return the name with the highest aggregated score.\n\n    Parameters\n    ----------\n    records : List[Tuple[str, int]]\n        A list of (name, score) tuples. Names are strings; scores are integers.\n\n    Returns\n    -------\n    Optional[Tuple[str, int]]\n        The (name, total_score) tuple with the highest total score.\n        If the input list is empty, returns None.\n\n    Examples\n    --------\n    >>> max_aggregate([('Alice', 10), ('Bob', 15), ('Alice', 5)])\n    ('Bob', 15)\n\n    >>> max_aggregate([])\n    None\n    \"\"\"\n    if not records:\n        return None\n\n    totals: Dict[str, int] = {}\n    for name, score in records:\n        totals[name] = totals.get(name, 0) + score\n\n    max_name, max_score = max(totals.items(), key=lambda item: item[1])\n    return max_name, max_score"}
{"task_id": "Mbpp/300", "solution": "import math\nfrom typing import Optional\n\ndef count_binary_seq(n: int, modulus: Optional[int] = None) -> int:\n    \"\"\"Return the number of binary sequences of length 2*n with equal half sums.\n\n    Args:\n        n: Length of the first half of the sequence (non\u2011negative integer).\n        modulus: If provided, return the result modulo ``modulus``.\n\n    Returns:\n        The exact count or the result modulo ``modulus``.\n\n    Raises:\n        TypeError: If ``n`` or ``modulus`` is not an integer.\n        ValueError: If ``n`` is negative or ``modulus`` is non\u2011positive.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non\u2011negative\")\n\n    if modulus is not None:\n        if not isinstance(modulus, int):\n            raise TypeError(\"modulus must be an integer\")\n        if modulus <= 0:\n            raise ValueError(\"modulus must be positive\")\n\n    if n == 0:\n        return 1\n\n    # Binomial coefficient C(2n, n) = product_{i=1}^{n} (n+i) / i\n    result = 1\n    start = n + 1\n    for i in range(1, n + 1):\n        numerator = start + i - 1\n        if modulus is None:\n            result = (result * numerator) // i\n        else:\n            result = (result * numerator) % modulus\n            result = (result * pow(i, -1, modulus)) % modulus\n\n    return result if modulus is None else result % modulus\n\n\n# Example usage and test\nif __name__ == \"__main__\":\n    assert math.isclose(count_binary_seq(1), 2.0, rel_tol=0.001)\n    print(\"All tests passed.\")\n"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(data: dict) -> int:\n    \"\"\"\n    Return the maximum nesting depth of a dictionary.\n\n    A single dictionary with no nested dictionaries has a depth of 1.\n    Empty dictionaries are treated as depth 1. Non\u2011dictionary values are\n    ignored for depth calculation.\n\n    Parameters\n    ----------\n    data : dict\n        The dictionary to analyze.\n\n    Returns\n    -------\n    int\n        The maximum depth of nested dictionaries.\n\n    Raises\n    ------\n    TypeError\n        If the input is not a dictionary.\n    \"\"\"\n    if not isinstance(data, dict):\n        raise TypeError(\"Input must be a dictionary\")\n    return _depth_helper(data, 1)\n\n\ndef _depth_helper(d: dict, depth: int) -> int:\n    \"\"\"\n    Recursive helper to compute dictionary depth.\n\n    Parameters\n    ----------\n    d : dict\n        Current dictionary being examined.\n    depth : int\n        Current depth level (starting at 1 for the outermost dict).\n\n    Returns\n    -------\n    int\n        The maximum depth found in this branch.\n    \"\"\"\n    max_depth = depth\n    for value in d.values():\n        if isinstance(value, dict):\n            child_depth = _depth_helper(value, depth + 1)\n            if child_depth > max_depth:\n                max_depth = child_depth\n    return max_depth\n\n\nif __name__ == \"__main__\":\n    # Example usage\n    sample = {'a': 1, 'b': {'c': {'d': {}}}}\n    print(f\"Depth of sample: {dict_depth(sample)}\")"}
{"task_id": "Mbpp/305", "solution": "def validate_input(words_list):\n    if not isinstance(words_list, list):\n        raise TypeError(\"Input must be a list of strings.\")\n    for idx, elem in enumerate(words_list):\n        if not isinstance(elem, str):\n            raise TypeError(f\"Element at index {idx} is not a string.\")\n\n\ndef extract_words(words_list):\n    for line in words_list:\n        for word in line.split():\n            yield word\n\n\ndef filter_p_words(words_iter):\n    matches = []\n    for word in words_iter:\n        if word and word[0].lower() == 'p':\n            matches.append(word)\n            if len(matches) == 2:\n                break\n    return matches\n\n\ndef format_result(matches):\n    return tuple(matches)\n\n\ndef start_withp(words_list):\n    \"\"\"Return the first two words starting with 'p' or 'P' from a list of strings.\n\n    Parameters\n    ----------\n    words_list : list of str\n        List of strings to search.\n\n    Returns\n    -------\n    tuple\n        A tuple containing up to two words that begin with 'p' (case\u2011insensitive).\n\n    Raises\n    ------\n    TypeError\n        If the argument is not a list or contains non\u2011string elements.\n    \"\"\"\n    validate_input(words_list)\n    words_iter = extract_words(words_list)\n    matches = filter_p_words(words_iter)\n    return format_result(matches)"}
{"task_id": "Mbpp/306", "solution": "from typing import List\n\ndef max_sum_increasing_subseq(arr: List[int], n: int, i: int, k: int) -> int:\n    if not isinstance(arr, list) or not all(isinstance(x, int) for x in arr):\n        raise ValueError(\"arr must be a list of integers\")\n    if n != len(arr):\n        raise ValueError(\"n must equal len(arr)\")\n    if not (0 <= i < n):\n        raise ValueError(\"i out of bounds: 0 <= i < n\")\n    if not (0 <= k < n):\n        raise ValueError(\"k out of bounds: 0 <= k < n\")\n    if k <= i:\n        raise ValueError(\"k must be greater than i\")\n\n    dp = [0] * (i + 1)\n    dp[0] = arr[0]\n    for j in range(1, i + 1):\n        dp[j] = arr[j]\n        for p in range(j):\n            if arr[p] < arr[j]:\n                candidate = dp[p] + arr[j]\n                if candidate > dp[j]:\n                    dp[j] = candidate\n\n    max_sum = arr[k]\n    for j in range(i + 1):\n        if arr[j] < arr[k]:\n            candidate = dp[j] + arr[k]\n            if candidate > max_sum:\n                max_sum = candidate\n\n    return max_sum\n\nassert max_sum_increasing_subseq([1, 101, 2, 3, 100, 4, 5], 7, 4, 6) == 11"}
{"task_id": "Mbpp/308", "solution": "import heapq\nfrom typing import List\n\ndef large_product(A: List[int], B: List[int], k: int) -> List[int]:\n    # Validate input types\n    if not isinstance(A, list) or not isinstance(B, list):\n        raise TypeError(\"A and B must be lists\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer\")\n    if k <= 0:\n        return []\n    if len(A) == 0 or len(B) == 0:\n        return []\n\n    # Ensure all elements are integers\n    if not all(isinstance(x, int) for x in A):\n        raise TypeError(\"All elements of A must be integers\")\n    if not all(isinstance(x, int) for x in B):\n        raise TypeError(\"All elements of B must be integers\")\n\n    total_pairs = len(A) * len(B)\n\n    # If k >= total pairs, compute all and sort\n    if k >= total_pairs:\n        products = [a * b for a in A for b in B]\n        products.sort(reverse=True)\n        return products\n\n    # Use min-heap to keep the largest k products\n    min_heap: List[int] = []\n    for a in A:\n        for b in B:\n            prod = a * b\n            if len(min_heap) < k:\n                heapq.heappush(min_heap, prod)\n            elif prod > min_heap[0]:\n                heapq.heapreplace(min_heap, prod)\n\n    return sorted(min_heap, reverse=True)"}
