{"task_id": "Mbpp/791", "solution": "def remove_nested(input_tuple):\n    \"\"\"Return a new tuple containing only the non\u2011tuple elements from `input_tuple`.\n\n    Parameters\n    ----------\n    input_tuple : tuple\n        The tuple to process.\n\n    Returns\n    -------\n    tuple\n        A new tuple with all tuple elements removed.\n\n    Raises\n    ------\n    TypeError\n        If `input_tuple` is not a tuple.\n\n    Examples\n    --------\n    >>> remove_nested((1, (2, 3), 4, (5,)))\n    (1, 4)\n    >>> remove_nested((1, 2, 3))\n    (1, 2, 3)\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"remove_nested expects a tuple\")\n    return tuple(x for x in input_tuple if not isinstance(x, tuple))"}
{"task_id": "Mbpp/792", "solution": "import collections.abc\nfrom typing import Iterable, Any\n\ndef count_list(lists: Iterable[Any]) -> int:\n    \"\"\"\n    Count the number of list elements contained in the provided iterable.\n\n    Parameters\n    ----------\n    lists : Iterable[Any]\n        An iterable that may contain lists among other types.\n\n    Returns\n    -------\n    int\n        The number of items that are instances of ``list``.\n\n    Raises\n    ------\n    TypeError\n        If *lists* is not an iterable.\n\n    Examples\n    --------\n    >>> count_list([[1, 3], [5, 7], [9, 11], [13, 15, 17]])\n    4\n    >>> count_list([1, 2, [3], ('a',), [4, 5]])\n    2\n    \"\"\"\n    if not isinstance(lists, collections.abc.Iterable):\n        raise TypeError(f\"Expected an iterable, got {type(lists).__name__}\")\n\n    return sum(1 for item in lists if isinstance(item, list))\n\nif __name__ == \"__main__\":\n    import doctest\n    doctest.testmod()\n    # Test assertion from the prompt\n    assert count_list([[1, 3], [5, 7], [9, 11], [13, 15, 17]]) == 4\n    print(\"All tests passed.\")"}
{"task_id": "Mbpp/793", "solution": "from typing import TypeVar, List, Tuple, Union\n\nT = TypeVar('T')\n\ndef find_last_position(array: Union[List[T], Tuple[T, ...]], target: T) -> int:\n    \"\"\"\n    Return the index of the last occurrence of ``target`` in the sorted ``array``.\n    If ``target`` is not found, return ``-1``.\n\n    Parameters\n    ----------\n    array : list or tuple\n        A sorted list (or tuple) of elements of type ``T``.\n    target : T\n        The element to search for.\n\n    Returns\n    -------\n    int\n        Index of the last occurrence of ``target``, or ``-1`` if not found.\n\n    Raises\n    ------\n    TypeError\n        If ``array`` is not a list or tuple.\n    \"\"\"\n    if not isinstance(array, (list, tuple)):\n        raise TypeError(\"array must be a list or tuple\")\n\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = (low + high) // 2\n        mid_val = array[mid]\n        if mid_val == target:\n            result = mid\n            low = mid + 1  # look for a later occurrence\n        elif mid_val < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n\n    return result"}
