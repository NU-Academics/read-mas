{"task_id": "Mbpp/796", "solution": "import json\nimport logging\nimport os\nimport sys\nfrom typing import Any, Dict, List\n\n\n# Configure logging based on environment variable\n_LOG_ENV_VAR = \"SUM_UTIL_LOG\"\n_LOGGING_ENABLED = os.getenv(_LOG_ENV_VAR, \"\").lower() in (\"1\", \"true\", \"yes\", \"on\")\nlogger = logging.getLogger(__name__)\nif _LOGGING_ENABLED:\n    logging.basicConfig(level=logging.DEBUG, format=\"%(levelname)s: %(message)s\")\nelse:\n    logging.basicConfig(level=logging.INFO)\n\n\ndef sum_dict_values(data: Dict[Any, Any]) -> float:\n    \"\"\"Calculate the sum of all numeric values in a dictionary, recursively summing nested dictionaries and ignoring non-numeric values.\n\n    Parameters\n    ----------\n    data : dict\n        Dictionary containing numeric values (int or float). Nested dictionaries are processed recursively.\n\n    Returns\n    -------\n    float\n        The total sum of all numeric values found in the dictionary.\n\n    Raises\n    ------\n    TypeError\n        If the input is not a dictionary.\n    \"\"\"\n    if not isinstance(data, dict):\n        raise TypeError(\"Input must be a dictionary\")\n\n    logger.debug(\"Starting sum\")\n    total = 0.0\n    total = _rec_sum(data, total)\n    logger.debug(\"Finished sum\")\n    return total\n\n\ndef _rec_sum(data: Any, total: float) -> float:\n    \"\"\"Recursive helper to accumulate numeric values from dictionaries.\n\n    Parameters\n    ----------\n    data : Any\n        Current data element being processed.\n    total : float\n        Running total of numeric values.\n\n    Returns\n    -------\n    float\n        Updated total after processing `data`.\n    \"\"\"\n    if isinstance(data, dict):\n        for key, value in data.items():\n            if isinstance(value, (int, float)) and not isinstance(value, bool):\n                total += float(value)\n                logger.debug(f\"Found numeric {value!r} -> total so far: {total}\")\n            elif isinstance(value, dict):\n                logger.debug(f\"Recursing into dict at key {key!r}\")\n                total = _rec_sum(value, total)\n            else:\n                logger.debug(f\"Ignoring non-numeric value at key {key!r}: {value!r}\")\n    return total\n\n\ndef main(argv: List[str]) -> None:\n    \"\"\"Command-line interface entry point.\n\n    Expects a single positional argument: a JSON string representing the dictionary.\n    The calculated sum is printed to standard output.\n    \"\"\"\n    if len(argv) != 2:\n        print(\"Usage: python sum_dict_values.py '<json_dict>'\")\n        sys.exit(1)\n\n    json_str = argv[1]\n    try:\n        data = json.loads(json_str)\n    except json.JSONDecodeError as exc:\n        print(f\"Error: Invalid JSON input: {exc}\")\n        sys.exit(1)\n\n    try:\n        result = sum_dict_values(data)\n    except TypeError as exc:\n        print(f\"Error: {exc}\")\n        sys.exit(1)\n\n    print(result)\n\n\nif __name__ == \"__main__\":\n    main(sys.argv)"}
{"task_id": "Mbpp/797", "solution": "def sum_in_range(l: int, r: int) -> int:\n    \"\"\"\n    Return the sum of all odd natural numbers in the inclusive range [l, r].\n\n    Parameters\n    ----------\n    l : int\n        Lower bound of the range (must be a natural number \u2265 1).\n    r : int\n        Upper bound of the range (must be a natural number \u2265 1).\n\n    Returns\n    -------\n    int\n        Sum of all odd integers between l and r inclusive. Returns 0 if no\n        odd integers exist in the range.\n\n    Raises\n    ------\n    ValueError\n        If either argument is not an integer,\n        if either argument is less than 1,\n        or if l > r.\n\n    Examples\n    --------\n    >>> sum_in_range(1, 10)\n    25\n    >>> sum_in_range(2, 2)\n    0\n    >>> sum_in_range(5, 5)\n    5\n    \"\"\"\n    # Input validation\n    if not isinstance(l, int) or not isinstance(r, int):\n        raise ValueError(\"Both l and r must be integers.\")\n    if l < 1 or r < 1:\n        raise ValueError(\"Both l and r must be natural numbers (>= 1).\")\n    if l > r:\n        raise ValueError(\"Lower bound l must be <= upper bound r.\")\n\n    # Determine first and last odd numbers in the range\n    first = l if l % 2 == 1 else l + 1\n    last = r if r % 2 == 1 else r - 1\n\n    # No odd numbers present\n    if first > last:\n        return 0\n\n    # Count of odd terms in the arithmetic progression\n    count = ((last - first) // 2) + 1\n\n    # Sum using arithmetic series formula\n    return count * (first + last) // 2\n"}
{"task_id": "Mbpp/798", "solution": "from typing import List, Union\n\ndef _sum(numbers: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"Return the sum of numeric elements in a list.\n\n    Args:\n        numbers (List[Union[int, float]]): A list of integers or floats.\n\n    Returns:\n        Union[int, float]: The arithmetic sum of all elements. The return type\n        will be an int if all inputs are integers; otherwise, a float.\n\n    Raises:\n        TypeError: If `numbers` is not a list or contains non-numeric elements.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"`numbers` must be a list.\")\n    for idx, value in enumerate(numbers):\n        if not isinstance(value, (int, float)):\n            raise TypeError(f\"Element at index {idx} is not numeric: {value!r}\")\n    total = sum(numbers)\n    if all(isinstance(v, int) for v in numbers):\n        return int(total)\n    return float(total)"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(x: int, d: int) -> int:\n    \"\"\"\n    Rotate a 32\u2011bit integer `x` to the left by `d` bits.\n\n    Parameters\n    ----------\n    x : int\n        The integer to rotate. Only the lower 32 bits are used.\n    d : int\n        The number of bit positions to rotate. Must be non\u2011negative.\n\n    Returns\n    -------\n    int\n        The 32\u2011bit result of the left rotation.\n\n    Raises\n    ------\n    ValueError\n        If `d` is negative.\n\n    Examples\n    --------\n    >>> left_rotate(16, 2)\n    64\n    >>> left_rotate(0x12345678, 8)\n    0x34567812\n    \"\"\"\n    if d < 0:\n        raise ValueError(\"shift count must be non\u2011negative\")\n\n    # Work with 32 bits only\n    mask = 0xFFFFFFFF\n    d %= 32\n    return ((x & mask) << d | (x & mask) >> (32 - d)) & mask\n"}
{"task_id": "Mbpp/800", "solution": "def remove_whitespaces(input_str: str | None) -> str:\n    if input_str is None:\n        return \"\"\n    if not isinstance(input_str, str):\n        raise TypeError(\"input_str must be a string or None\")\n    return \"\".join(ch for ch in input_str if not ch.isspace())"}
{"task_id": "Mbpp/801", "solution": "def count_equal_numbers(a: int, b: int, c: int) -> int:\n    \"\"\"\n    Counts how many distinct equality relationships exist among three integers.\n\n    Parameters:\n        a (int): First integer.\n        b (int): Second integer.\n        c (int): Third integer.\n\n    Returns:\n        int: 2 if all three numbers are equal,\n             1 if exactly two numbers are equal,\n             0 if all numbers are distinct.\n\n    Raises:\n        TypeError: If any argument is not an integer.\n    \"\"\"\n    if not all(isinstance(v, int) for v in (a, b, c)):\n        raise TypeError(\"All arguments must be integers\")\n\n    if a == b == c:\n        return 2\n\n    if a == b or a == c or b == c:\n        return 1\n\n    return 0"}
{"task_id": "Mbpp/803", "solution": "from typing import Any\n\ndef is_perfect_square(n: int) -> bool:\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer\")\n    if n < 0:\n        raise ValueError(\"Negative numbers cannot be perfect squares\")\n    root = int(n ** 0.5)\n    if root * root != n:\n        # Fallback for very large integers where float precision may be insufficient\n        import math\n        root = math.isqrt(n)\n    return root * root == n"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(nums: list[int]) -> bool:\n    \"\"\"\n    Determine whether the product of all integers in the input list is even.\n\n    Parameters\n    ----------\n    nums : list[int]\n        List of integers to evaluate.\n\n    Returns\n    -------\n    bool\n        True if the product of all integers in nums is even, False otherwise.\n        The product is considered even if any element in nums is even.\n        For an empty list, returns False.\n\n    Raises\n    ------\n    ValueError\n        If ``nums`` is None.\n    TypeError\n        If any element of ``nums`` is not an integer.\n    \"\"\"\n    if nums is None:\n        raise ValueError(\"Input list cannot be None\")\n\n    for num in nums:\n        if not isinstance(num, int):\n            raise TypeError(\"All elements must be integers\")\n        if num % 2 == 0:\n            return True\n    return False"}
{"task_id": "Mbpp/805", "solution": "from typing import List, Any\nimport math\n\ndef _validate_input(lists: Any) -> None:\n    if not isinstance(lists, list):\n        raise TypeError(\"Input must be a list of lists of integers.\")\n    for sub in lists:\n        if not isinstance(sub, list):\n            raise TypeError(\"All elements of the top-level list must be lists.\")\n        for item in sub:\n            if not isinstance(item, int):\n                raise TypeError(\"All elements of the sublists must be integers.\")\n\n\ndef max_sum_sublist(lists: List[List[int]]) -> List[int]:\n    _validate_input(lists)\n    if not lists:\n        return []\n\n    max_sum = -math.inf\n    best_sublist: List[int] = []\n\n    for sub in lists:\n        current_sum = sum(sub)\n        if current_sum > max_sum:\n            max_sum = current_sum\n            best_sublist = sub\n\n    return best_sublist\n\n\n# Unit tests\nimport unittest\n\nclass TestMaxSumSublist(unittest.TestCase):\n    def test_empty_input(self):\n        self.assertEqual(max_sum_sublist([]), [])\n\n    def test_empty_sublists(self):\n        self.assertEqual(max_sum_sublist([[], []]), [])\n        self.assertEqual(max_sum_sublist([[], [1, 2]]), [1, 2])\n\n    def test_single_sublist(self):\n        self.assertEqual(max_sum_sublist([[5, -3, 2]]), [5, -3, 2])\n\n    def test_multiple_sublists(self):\n        self.assertEqual(\n            max_sum_sublist([[1, 2], [3], [0, 4, -1]]), [0, 4, -1]\n        )\n\n    def test_tie_breaker(self):\n        self.assertEqual(max_sum_sublist([[1, 1], [2], [0, 2]]), [1, 1])\n\n    def test_negative_numbers(self):\n        self.assertEqual(max_sum_sublist([[-1, -2], [-3], []]), [])\n\n    def test_large_numbers(self):\n        big = 10 ** 100\n        self.assertEqual(max_sum_sublist([[big, 1], [big]]), [big, 1])\n\n    def test_invalid_top_level(self):\n        with self.assertRaises(TypeError):\n            max_sum_sublist(\"not a list\")\n\n    def test_invalid_sublist_element(self):\n        with self.assertRaises(TypeError):\n            max_sum_sublist([[1, \"two\"], [3]])\n\n    def test_non_list_sublist(self):\n        with self.assertRaises(TypeError):\n            max_sum_sublist([[1, 2], \"not a list\"])\n\nif __name__ == \"__main__\":\n    unittest.main()\n"}
{"task_id": "Mbpp/806", "solution": "def _is_uppercase(ch: str) -> bool:\n    \"\"\"\n    Determine if a single character is an uppercase ASCII letter.\n    \"\"\"\n    return 'A' <= ch <= 'Z'\n\n\ndef max_uppercase_run(input_str: str) -> int:\n    \"\"\"\n    Return the length of the longest consecutive run of uppercase ASCII letters\n    in `input_str`. Non\u2011string inputs raise TypeError. Empty strings return 0.\n\n    Parameters\n    ----------\n    input_str : str\n        The string to analyze.\n\n    Returns\n    -------\n    int\n        Length of the longest contiguous sequence of uppercase letters.\n        Zero if no such sequence exists.\n\n    Raises\n    ------\n    TypeError\n        If `input_str` is not an instance of `str`.\n\n    Example\n    -------\n    >>> max_uppercase_run(\"abCDEfGHIJk\")\n    4\n    \"\"\"\n    if not isinstance(input_str, str):\n        raise TypeError(\"input_str must be a string\")\n\n    max_run = 0\n    current_run = 0\n\n    for ch in input_str:\n        if _is_uppercase(ch):\n            current_run += 1\n        else:\n            if current_run > max_run:\n                max_run = current_run\n            current_run = 0\n\n    # Final update in case the string ends with an uppercase run\n    if current_run > max_run:\n        max_run = current_run\n\n    return max_run"}
{"task_id": "Mbpp/807", "solution": "from typing import List\n\ndef find_first_odd(nums: List[int]) -> int:\n    \"\"\"Return the first odd integer in the given list.\n\n    Parameters\n    ----------\n    nums : List[int]\n        List of integers to search.\n\n    Returns\n    -------\n    int\n        The first odd integer found.\n\n    Raises\n    ------\n    ValueError\n        If the list contains no odd numbers or is empty.\n    \"\"\"\n    for num in nums:\n        if num % 2 != 0:\n            return num\n    raise ValueError(\"No odd number found\")"}
{"task_id": "Mbpp/808", "solution": "def check_K(t: tuple, k: int) -> bool:\n    \"\"\"Checks whether integer k is present in tuple t.\n    Returns True if k is found, otherwise False.\"\"\"\n    return k in t\n\n\nif __name__ == \"__main__\":\n    sample_tuple = (1, 2, 3, 4)\n    print(check_K(sample_tuple, 3))  # Output: True\n    print(check_K(sample_tuple, 5))  # Output: False"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(first: tuple, second: tuple) -> bool:\n    \"\"\"\n    Determine if every element in `second` is strictly smaller than the corresponding element in `first`.\n\n    Parameters\n    ----------\n    first : tuple\n        Tuple of numeric values (int or float).\n    second : tuple\n        Tuple of numeric values of equal length to `first`.\n\n    Returns\n    -------\n    bool\n        True if all elements of `second` are strictly smaller than those in `first`; False otherwise.\n\n    Raises\n    ------\n    TypeError\n        If inputs are not tuples or contain non-numeric elements.\n    ValueError\n        If tuples differ in length.\n    \"\"\"\n    # Validate that both arguments are tuples\n    if not isinstance(first, tuple) or not isinstance(second, tuple):\n        raise TypeError(\"Both arguments must be tuples.\")\n\n    # Validate that tuples have the same length\n    if len(first) != len(second):\n        raise ValueError(\"Tuples must be of equal length.\")\n\n    # Validate that all elements are numeric (int or float) and perform comparison\n    for idx, (f_val, s_val) in enumerate(zip(first, second)):\n        if not isinstance(f_val, (int, float)):\n            raise TypeError(f\"Element {idx} in first tuple is not numeric.\")\n        if not isinstance(s_val, (int, float)):\n            raise TypeError(f\"Element {idx} in second tuple is not numeric.\")\n        if s_val >= f_val:\n            return False\n\n    return True"}
