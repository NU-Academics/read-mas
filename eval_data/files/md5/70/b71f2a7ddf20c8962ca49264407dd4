{"task_id": "Mbpp/84", "solution": "from typing import List, Optional\n\n# Global cache: index 0 unused, CACHE[1] = 1, CACHE[2] = 1\n_CACHE: List[Optional[int]] = [None, 1, 1]\n\n\ndef newman_conway(n: int) -> int:\n    \"\"\"Return the nth term of the Newman\u2013Conway sequence.\n\n    Parameters\n    ----------\n    n : int\n        Positive integer index of the desired term.\n\n    Returns\n    -------\n    int\n        The nth term of the sequence.\n\n    Raises\n    ------\n    ValueError\n        If n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    global _CACHE\n    while len(_CACHE) <= n:\n        i = len(_CACHE)\n        a_prev = _CACHE[i - 1]  # value of a(i-1)\n        term = _CACHE[a_prev] + _CACHE[i - a_prev]\n        _CACHE.append(term)\n\n    return _CACHE[n]"}
{"task_id": "Mbpp/85", "solution": "import math\nfrom typing import Union\n\ndef surfacearea_sphere(radius: Union[int, float]) -> float:\n    \"\"\"\n    Calculate the surface area of a sphere.\n\n    Parameters\n    ----------\n    radius : float\n        Radius of the sphere. Must be a non\u2011negative number.\n\n    Returns\n    -------\n    float\n        Surface area of the sphere.\n\n    Raises\n    ------\n    TypeError\n        If *radius* is not an instance of int or float.\n    ValueError\n        If *radius* is negative.\n\n    Examples\n    --------\n    >>> surfacearea_sphere(1)\n    12.566370614359172\n    \"\"\"\n    if not isinstance(radius, (int, float)):\n        raise TypeError(\"radius must be a numeric type (int or float)\")\n    if radius < 0:\n        raise ValueError(\"radius cannot be negative\")\n    return 4 * math.pi * radius ** 2"}
{"task_id": "Mbpp/86", "solution": "def centered_hexagonal_number(n: int) -> int:\n    \"\"\"\n    Return the n-th centered hexagonal number.\n\n    The centered hexagonal numbers form the sequence:\n        1, 7, 19, 37, 61, ...\n    given by the formula H(n) = 3*n*(n-1) + 1 for n >= 1.\n\n    Parameters\n    ----------\n    n : int\n        The index (1\u2011based) of the centered hexagonal number to compute.\n\n    Returns\n    -------\n    int\n        The n-th centered hexagonal number.\n\n    Raises\n    ------\n    TypeError\n        If n is not an instance of int.\n    ValueError\n        If n < 1.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(f\"n must be an integer, got {type(n).__name__}\")\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n\n    return 3 * n * (n - 1) + 1"}
{"task_id": "Mbpp/87", "solution": "from typing import Dict, Any\n\ndef merge_dictionaries_three(\n    dict1: Dict[Any, Any],\n    dict2: Dict[Any, Any],\n    dict3: Dict[Any, Any],\n) -> Dict[Any, Any]:\n    \"\"\"\n    Merge three dictionaries into a single dictionary.\n\n    Parameters\n    ----------\n    dict1, dict2, dict3 : Dict[Any, Any]\n        The dictionaries to merge. Later dictionaries override earlier ones\n        when a key is present in more than one dictionary.\n\n    Returns\n    -------\n    Dict[Any, Any]\n        A new dictionary containing all key/value pairs from the three input\n        dictionaries, with later values taking precedence.\n    \"\"\"\n    merged = dict1.copy()\n    merged.update(dict2)\n    merged.update(dict3)\n    return merged\n\n\n# Example usage and test\nif __name__ == \"__main__\":\n    result = merge_dictionaries_three(\n        {\"R\": \"Red\", \"B\": \"Black\", \"P\": \"Pink\"},\n        {\"G\": \"Green\", \"W\": \"White\"},\n        {\"O\": \"Orange\", \"W\": \"White\", \"B\": \"Black\"},\n    )\n    assert result == {\"B\": \"Black\", \"R\": \"Red\", \"P\": \"Pink\", \"G\": \"Green\", \"W\": \"White\", \"O\": \"Orange\"}\n    print(\"Test passed.\")"}
{"task_id": "Mbpp/88", "solution": "from typing import Iterable, Dict, Any\n\ndef freq_count(nums: Iterable[int]) -> Dict[int, int]:\n    \"\"\"Compute the frequency of each integer in an iterable.\n\n    Parameters\n    ----------\n    nums : Iterable[int]\n        The iterable of integers to analyze.\n\n    Returns\n    -------\n    Dict[int, int]\n        A dictionary mapping each unique integer to its frequency count.\n\n    Raises\n    ------\n    TypeError\n        If `nums` is not iterable or contains non\u2011int elements.\n    \"\"\"\n    if not hasattr(nums, \"__iter__\"):\n        raise TypeError(\"Input must be an iterable of integers.\")\n    freq: Dict[int, int] = {}\n    for x in nums:\n        if not isinstance(x, int):\n            raise TypeError(f\"All elements must be integers; got {type(x).__name__}.\")\n        freq[x] = freq.get(x, 0) + 1\n    return freq"}
{"task_id": "Mbpp/89", "solution": "def closest_smaller(n: int) -> int:\n    \"\"\"\n    Return the largest integer strictly less than the given integer `n`.\n\n    Parameters\n    ----------\n    n : int\n        The integer for which to find the closest smaller number.\n\n    Returns\n    -------\n    int\n        The integer immediately less than `n`. If `n` is zero or negative,\n        -1 is returned to indicate that no valid smaller integer exists\n        under the defined constraints.\n\n    Raises\n    ------\n    TypeError\n        If `n` is not an instance of int.\n\n    Examples\n    --------\n    >>> closest_smaller(10)\n    9\n    >>> closest_smaller(1)\n    0\n    >>> closest_smaller(0)\n    -1\n    >>> closest_smaller(-5)\n    -1\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer\")\n    if n <= 0:\n        return -1\n    return n - 1"}
{"task_id": "Mbpp/90", "solution": "def len_log(words):\n    \"\"\"Return the length of the longest word in *words*.\n\n    Parameters\n    ----------\n    words : list[str]\n        List of words to examine.\n\n    Returns\n    -------\n    int\n        Length of the longest word; 0 if *words* is empty.\n\n    Raises\n    ------\n    TypeError\n        If *words* is not a list or contains non\u2011string items.\n    \"\"\"\n    if not isinstance(words, list):\n        raise TypeError(\"Input must be a list.\")\n    max_len = 0\n    for w in words:\n        if not isinstance(w, str):\n            raise TypeError(\"All items in the list must be strings.\")\n        l = len(w)\n        if l > max_len:\n            max_len = l\n    return max_len\n\n# Example usage\nassert len_log([\"python\", \"PHP\", \"bigdata\"]) == 7\nassert len_log([]) == 0\nassert len_log([\"short\", \"longer\", \"mid\"]) == 6\n```"}
{"task_id": "Mbpp/91", "solution": "def find_substring(string_list: list[str], substring: str) -> bool:\n    \"\"\"\n    Return True if `substring` occurs in any string in `string_list`; otherwise False.\n\n    Raises:\n        TypeError: If `string_list` is not a list, if any element of `string_list`\n                   is not a string, or if `substring` is not a string.\n        ValueError: If `substring` is an empty string.\n    \"\"\"\n    # Validate string_list type\n    if not isinstance(string_list, list):\n        raise TypeError(\"`string_list` must be a list.\")\n    # Validate substring type\n    if not isinstance(substring, str):\n        raise TypeError(\"`substring` must be a string.\")\n    # Validate substring non-empty\n    if substring == \"\":\n        raise ValueError(\"`substring` must not be an empty string.\")\n    # Iterate over each string in the list\n    for idx, text in enumerate(string_list):\n        if not isinstance(text, str):\n            raise TypeError(f\"Element at index {idx} in `string_list` is not a string.\")\n        if substring in text:\n            return True\n    return False"}
{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"\n    Determine whether an integer is an undulating number.\n\n    An undulating number alternates strictly between two distinct digits\n    throughout its decimal representation (e.g., 1212121, 212121, 343434).\n\n    Parameters\n    ----------\n    number : int\n        The integer to check. Negative numbers are considered non\u2011undulating.\n\n    Returns\n    -------\n    bool\n        True if `number` is undulating, False otherwise.\n\n    Examples\n    --------\n    >>> is_undulating(1212121)\n    True\n    >>> is_undulating(212121)\n    True\n    >>> is_undulating(343434)\n    True\n    >>> is_undulating(-1212)\n    False\n    >>> is_undulating(7)\n    False\n    >>> is_undulating(11)\n    False\n    \"\"\"\n    if not isinstance(number, int):\n        return False\n    if number < 0:\n        return False\n    s = str(number)\n    if len(s) < 2:\n        return False\n    first_digit = s[0]\n    second_digit = s[1]\n    if first_digit == second_digit:\n        return False\n    for idx in range(2, len(s)):\n        expected = first_digit if idx % 2 == 0 else second_digit\n        if s[idx] != expected:\n            return False\n    return True"}
{"task_id": "Mbpp/93", "solution": "```python\n\"\"\"\npower_module.py\n\nProvides an efficient integer exponentiation function using\nexponentiation by squaring.\n\nThe implementation follows the specification:\n- Supports positive, negative, and zero exponents.\n- Handles zero base with proper error handling.\n- Returns a float result.\n\"\"\"\n\nfrom __future__ import annotations\n\n__all__ = [\"power\"]\n\n\ndef power(a: int, b: int) -> float:\n    \"\"\"\n    Compute a ** b using exponentiation by squaring.\n\n    Parameters\n    ----------\n    a : int\n        Base (can be negative, zero, or positive).\n    b : int\n        Exponent (can be negative, zero, or positive).\n\n    Returns\n    -------\n    float\n        The result of a ** b.\n\n    Raises\n    ------\n    ZeroDivisionError\n        If a == 0 and b <= 0 (covers 0 ** 0 and 0 ** negative).\n\n    Examples\n    --------\n    >>> power(2, 10)\n    1024.0\n    >>> power(-3, 4)\n    81.0\n    >>> power(2, -3)\n    0.125\n    >>> power(5, 0)\n    1.0\n    >>> power(0, 5)\n    0.0\n    >>> power(0, -1)\n    Traceback (most recent call last):\n        ...\n    ZeroDivisionError: 0 ** -1 is undefined\n    \"\"\"\n    # Zero exponent: return 1.0 unless base is zero, which is undefined\n    if b == 0:\n        if a == 0:\n            raise ZeroDivisionError(\"0 ** 0 is undefined\")\n        return 1.0\n\n    # Negative exponent: compute reciprocal\n    if b < 0:\n        if a == 0:\n            raise ZeroDivisionError(f\"0 ** {b} is undefined\")\n        # Recursive call with positive exponent will be handled iteratively\n        return 1.0 / power(a, -b)\n\n    # At this point b > 0\n    result: float = 1.0\n    base: float = float(a)\n\n    while b > 0:\n        if b & 1:          # b is odd\n            result *= base\n        base *= base       # square the base\n        b >>= 1           # halve the exponent\n\n    return result\n```"}
{"task_id": "Mbpp/94", "solution": "from typing import List, Tuple\n\n\ndef index_minimum(data: List[Tuple[str, int]]) -> str:\n    \"\"\"Return the string from the tuple with the smallest integer value.\n\n    Parameters\n    ----------\n    data : List[Tuple[str, int]]\n        List of two-element tuples where first element is a string,\n        second element is an integer.\n\n    Returns\n    -------\n    str\n        The string component of the tuple with the minimal integer.\n\n    Raises\n    ------\n    TypeError\n        If `data` is not a list, or any element is not a tuple,\n        or tuple elements are of wrong types.\n    ValueError\n        If `data` is empty or any tuple does not contain exactly two items.\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input data must be a list.\")\n    if not data:\n        raise ValueError(\"Input list is empty.\")\n    for idx, t in enumerate(data):\n        if not isinstance(t, tuple):\n            raise TypeError(\"All elements must be tuples.\")\n        if len(t) != 2:\n            raise ValueError(\"Each tuple must contain exactly two elements.\")\n        if not isinstance(t[0], str):\n            raise TypeError(\"First element of tuple must be a string.\")\n        if not isinstance(t[1], int):\n            raise TypeError(\"Second element of tuple must be an integer.\")\n    min_tuple = min(data, key=lambda t: t[1])\n    return min_tuple[0]"}
{"task_id": "Mbpp/95", "solution": "from typing import List, Sequence, Any\n\ndef find_min_length(input_list: List[Sequence[Any]]) -> int:\n    \"\"\"Return the length of the shortest inner sequence in a list of sequences.\n\n    Parameters\n    ----------\n    input_list : List[Sequence[Any]]\n        A list where each element is a sequence type that implements __len__.\n\n    Returns\n    -------\n    int\n        The minimal length among all inner sequences.\n\n    Raises\n    ------\n    TypeError\n        If the input is not a list or any inner element is not a sequence.\n    ValueError\n        If the input list is empty.\n\n    Examples\n    --------\n    >>> find_min_length([[1, 2, 3], [4, 5], [6]])\n    1\n    >>> find_min_length([[], [1, 2], [3]])\n    0\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list of sequences.\")\n    if len(input_list) == 0:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    min_len: int | None = None\n    for idx, inner in enumerate(input_list):\n        if not hasattr(inner, \"__len__\"):\n            raise TypeError(f\"Element at index {idx} is not a sequence.\")\n        current_len = len(inner)\n        if min_len is None or current_len < min_len:\n            min_len = current_len\n    return min_len"}
{"task_id": "Mbpp/96", "solution": "from math import isqrt\n\ndef divisor(n: int) -> int:\n    \"\"\"Return the number of positive integer divisors of n.\"\"\"\n    if n <= 0:\n        return 0\n\n    count = 0\n    limit = isqrt(n)\n    for i in range(1, limit + 1):\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n    return count"}
{"task_id": "Mbpp/97", "solution": "from typing import List, Dict\n\ndef frequency_lists(data: List[List[int]]) -> Dict[int, int]:\n    \"\"\"\n    Return a dictionary mapping each integer in the nested list to its frequency.\n\n    Parameters\n    ----------\n    data : List[List[int]]\n        A list of integer sublists.\n\n    Returns\n    -------\n    Dict[int, int]\n        Mapping from integer to count.\n\n    Raises\n    ------\n    TypeError\n        If the input is not a list of lists of integers.\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input must be a list of lists of integers.\")\n    result: Dict[int, int] = {}\n    for sublist in data:\n        if not isinstance(sublist, list):\n            raise TypeError(\"Each element of the top-level list must be a list.\")\n        for item in sublist:\n            if not isinstance(item, int):\n                raise TypeError(\"All items must be integers.\")\n            result[item] = result.get(item, 0) + 1\n    return result\n\n\n# Example usage and test\nif __name__ == \"__main__\":\n    assert frequency_lists([[1, 2, 3, 2], [4, 5, 6, 2], [7, 8, 9, 5]]) == {\n        1: 1,\n        2: 3,\n        3: 1,\n        4: 1,\n        5: 2,\n        6: 1,\n        7: 1,\n        8: 1,\n        9: 1\n    }\n    print(\"All tests passed.\")"}
{"task_id": "Mbpp/98", "solution": "import math\nfrom typing import Union, List, Tuple\n\ndef multiply_num(numbers: Union[List[Union[int, float]], Tuple[Union[int, float], ...]]) -> float:\n    \"\"\"\n    Compute the product of all numeric elements in a list or tuple and divide the result by the number of elements.\n\n    Parameters\n    ----------\n    numbers : list or tuple of int or float\n        The collection of numeric values to process. Only ``list`` and ``tuple`` are accepted.\n\n    Returns\n    -------\n    float\n        The value of (\u220f numbers) / len(numbers). The result is always returned as a float.\n\n    Raises\n    ------\n    TypeError\n        If ``numbers`` is not a list or tuple, or if any element is not an int or float.\n    ValueError\n        If ``numbers`` is empty.\n\n    Examples\n    --------\n    >>> multiply_num([2, 3, 4])\n    8.0\n    >>> multiply_num((1.5, 2.0))\n    3.0\n    \"\"\"\n    if not isinstance(numbers, (list, tuple)):\n        raise TypeError(\"Input must be a list or tuple\")\n    if not numbers:\n        raise ValueError(\"Iterable is empty; cannot compute product\")\n    product = 1.0\n    for value in numbers:\n        if not isinstance(value, (int, float)):\n            raise TypeError(\"All elements must be numeric\")\n        product *= float(value)\n    return product / len(numbers)"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(n: int) -> str:\n    \"\"\"\n    Convert a non\u2011negative integer to its binary string representation.\n\n    Parameters:\n        n (int): Non\u2011negative integer to convert.\n\n    Returns:\n        str: Binary representation without leading zeros.\n\n    Raises:\n        TypeError: If n is not an int.\n        ValueError: If n is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input must be non\u2011negative.\")\n    if n == 0:\n        return \"0\"\n\n    bits = []\n    while n > 0:\n        bits.append(str(n & 1))\n        n >>= 1\n    bits.reverse()\n    return \"\".join(bits)"}
{"task_id": "Mbpp/100", "solution": "def _mirror(num_str: str) -> str:\n    \"\"\"\n    Return a palindrome formed by mirroring the left half of ``num_str`` onto the right.\n    \"\"\"\n    length = len(num_str)\n    left = num_str[: length // 2]\n    if length % 2 == 0:\n        return left + left[::-1]\n    return left + num_str[length // 2] + left[::-1]\n\n\ndef _increment_middle(num_str: str) -> str:\n    \"\"\"\n    Increment the middle digit(s) of ``num_str`` and propagate any carry leftward.\n    The result is a string that is ready to be mirrored into a palindrome.\n    \"\"\"\n    length = len(num_str)\n    chars = list(num_str)\n    carry = 1\n\n    if length % 2 == 0:\n        i, j = length // 2 - 1, length // 2\n    else:\n        i = j = length // 2\n\n    while i >= 0 and carry:\n        new_digit = int(chars[i]) + carry\n        carry = new_digit // 10\n        chars[i] = str(new_digit % 10)\n        chars[j] = chars[i]\n        i -= 1\n        j += 1\n\n    if carry:\n        # Overflow e.g., 99 -> 1001\n        return '1' + '0' * (length - 1) + '1'\n    return ''.join(chars)\n\n\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Return the smallest palindrome integer strictly greater than ``n``.\n\n    Parameters\n    ----------\n    n : int\n        Input integer. Must be in the signed 64\u2011bit range\n        (-2**63 <= n < 2**63).\n\n    Returns\n    -------\n    int\n        The next palindrome greater than ``n``.\n\n    Raises\n    ------\n    TypeError\n        If ``n`` is not an integer.\n    ValueError\n        If ``n`` is outside the 64\u2011bit signed integer range.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer\")\n\n    if n < -(1 << 63) or n >= (1 << 63):\n        raise ValueError(\"Input must be within signed 64\u2011bit range\")\n\n    if n < 0:\n        return 1\n\n    s = str(n)\n    candidate = _mirror(s)\n    if int(candidate) > n:\n        return int(candidate)\n\n    incremented = _increment_middle(s)\n    palindrome = _mirror(incremented)\n    return int(palindrome)"}
{"task_id": "Mbpp/101", "solution": "from typing import Sequence, TypeVar\n\nT = TypeVar(\"T\")\n\n__all__ = [\"kth_element\"]\n\n\ndef kth_element(seq: Sequence[T], k: int) -> T:\n    \"\"\"Return the kth element (1\u2011based index) from the given sequence.\n\n    Parameters\n    ----------\n    seq : Sequence[T]\n        The input sequence (list, tuple, str, etc.).\n    k : int\n        The 1\u2011based position of the desired element.\n\n    Returns\n    -------\n    T\n        The element at position ``k`` in the sequence.\n\n    Raises\n    ------\n    TypeError\n        If ``seq`` is not a sequence or ``k`` is not an integer.\n    IndexError\n        If ``k`` is out of bounds (``k < 1`` or ``k > len(seq)``).\n\n    Examples\n    --------\n    >>> kth_element([10, 20, 30], 2)\n    20\n    >>> kth_element('hello', 5)\n    'o'\n    \"\"\"\n    if not isinstance(seq, Sequence):\n        raise TypeError(\"First argument must be a sequence\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer\")\n    length = len(seq)\n    if k < 1 or k > length:\n        raise IndexError(\"k is out of bounds\")\n    return seq[k - 1]"}
{"task_id": "Mbpp/102", "solution": "import re\nfrom typing import List\n\ndef _normalize_separators(s: str) -> str:\n    result = []\n    prev_sep = False\n    for ch in s:\n        if ch.isalnum():\n            result.append(ch)\n            prev_sep = False\n        else:\n            if not prev_sep:\n                result.append('_')\n                prev_sep = True\n    return ''.join(result).strip('_')\n\ndef _split_words(normalized: str) -> List[str]:\n    return [token for token in normalized.split('_') if token]\n\ndef _capitalize_word(word: str) -> str:\n    return word[0].upper() + word[1:] if word else ''\n\ndef snake_to_camel(s: str) -> str:\n    if not s or s.strip() == '':\n        return ''\n    normalized = _normalize_separators(s.lower())\n    words = _split_words(normalized)\n    return ''.join(_capitalize_word(word) for word in words)"}
{"task_id": "Mbpp/103", "solution": "from functools import lru_cache\n\ndef eulerian_num(n: int, m: int) -> int:\n    if n < 0 or m < 0 or (m >= n and not (n == 0 and m == 0)):\n        raise ValueError(\"Invalid input: require 0 <= m < n for n > 0, and n=m=0 allowed\")\n    @lru_cache(None)\n    def _rec(i: int, j: int) -> int:\n        if i == 0 and j == 0:\n            return 1\n        if j == 0:\n            return 1\n        if j == i:\n            return 0\n        return (j + 1) * _rec(i - 1, j) + (i - j) * _rec(i - 1, j - 1)\n    return _rec(n, m)"}
{"task_id": "Mbpp/104", "solution": "from __future__ import annotations\n\nfrom typing import List\n\n\ndef sort_sublist_strings(data: List[List[str]]) -> List[List[str]]:\n    \"\"\"\n    Return a new list where each sublist of strings in *data* is sorted\n    in ascending lexicographic order.\n\n    Parameters\n    ----------\n    data : List[List[str]]\n        Top\u2011level list containing sublists of strings.\n\n    Returns\n    -------\n    List[List[str]]\n        A new list containing sorted sublists; the original *data* is left\n        unchanged.\n\n    Raises\n    ------\n    TypeError\n        If *data* is not a list, if any element of *data* is not a list,\n        or if any item within a sublist is not a string.\n    ValueError\n        If a sublist is not a list (used for future extension).\n\n    Notes\n    -----\n    * Empty top\u2011level lists or empty sublists are supported and returned as\n      empty lists.\n    * The function is O(n\u202flog\u202fm) in time where n is the total number of\n      strings and m is the average sublist length.  It uses O(n) additional\n      memory.\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input must be a list of lists of strings.\")\n\n    sorted_data: List[List[str]] = []\n\n    for idx, sub in enumerate(data):\n        if not isinstance(sub, list):\n            raise TypeError(f\"Element at index {idx} is not a list.\")\n        for s_idx, item in enumerate(sub):\n            if not isinstance(item, str):\n                raise TypeError(\n                    f\"Item at data[{idx}][{s_idx}] is not a string.\"\n                )\n        sorted_data.append(sorted(sub))\n\n    return sorted_data\n\n\nif __name__ == \"__main__\":\n    # Simple demonstration\n    example = [[\"delta\", \"alpha\", \"charlie\"], [\"bravo\", \"echo\"]]\n    print(sort_sublist_strings(example))\n    # Expected output: [['alpha', 'charlie', 'delta'], ['bravo', 'echo']]\n\n"}
