{"task_id": "Mbpp/2", "solution": "from typing import List, TypeVar, Set\n\nT = TypeVar(\"T\")\n\ndef shared_elements(list1: List[T], list2: List[T]) -> List[T]:\n    \\\"\\\"\\\"Return a list of elements common to both *list1* and *list2*,\n    preserving the order of first appearance in *list1*.\n\n    Parameters\n    ----------\n    list1 : List[T]\n        First input list.\n    list2 : List[T]\n        Second input list.\n\n    Returns\n    -------\n    List[T]\n        Elements that appear in both lists, without duplicates.\n\n    Raises\n    ------\n    ValueError\n        If either input list is ``None``.\n    \"\"\"\n    if list1 is None or list2 is None:\n        raise ValueError(\"Input lists must not be None\")\n\n    set2: Set[T] = set(list2)\n    result: List[T] = []\n    seen: Set[T] = set()\n\n    for elem in list1:\n        if elem in set2 and elem not in seen:\n            result.append(elem)\n            seen.add(elem)\n\n    return result"}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(n: int) -> bool:\n    \"\"\"Determine whether an integer is NOT a prime number.\n\n    Args:\n        n: Integer to test.\n\n    Returns:\n        True if n is composite, 0, 1, or negative.\n        False if n is prime (2 or 3).\n\n    Raises:\n        TypeError: If n is not an int.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n\n    if n <= 1:\n        return True\n\n    if n in (2, 3):\n        return False\n\n    if n % 2 == 0:\n        return True\n\n    sqrt_n = int(n ** 0.5) + 1\n    i = 3\n    while i <= sqrt_n:\n        if n % i == 0:\n            return True\n        i += 2\n    return False"}
{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import List\n\ndef heap_queue_largest(data: List[int], n: int) -> List[int]:\n    \"\"\"\n    Return the `n` largest integers from `data` in descending order.\n\n    Parameters\n    ----------\n    data : list[int]\n        List of integers to evaluate.\n    n : int\n        Number of largest elements to return. Must be non\u2011negative.\n\n    Returns\n    -------\n    list[int]\n        A list containing the `n` largest integers from `data`, sorted in descending order.\n\n    Raises\n    ------\n    TypeError\n        If `data` is not a list of integers or `n` is not an integer.\n    ValueError\n        If `n` is negative.\n\n    Examples\n    --------\n    >>> heap_queue_largest([5, 1, 9, 3], 2)\n    [9, 5]\n    >>> heap_queue_largest([5, 1, 9, 3], 0)\n    []\n    \"\"\"\n    # Validate `data`\n    if not isinstance(data, list):\n        raise TypeError(\"data must be a list of integers\")\n    for idx, item in enumerate(data):\n        if not isinstance(item, int):\n            raise TypeError(\n                f\"data must be a list of integers, element at index {idx} \"\n                f\"is of type {type(item).__name__}\"\n            )\n\n    # Validate `n`\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non\u2011negative\")\n\n    # Edge cases\n    if n == 0:\n        return []\n\n    if n >= len(data):\n        return sorted(data, reverse=True)\n\n    # Core logic using heapq.nlargest\n    return heapq.nlargest(n, data)"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(a: int, b: int) -> bool:\n    \"\"\"\n    Determine if two integers differ in exactly one bit position.\n\n    Parameters\n    ----------\n    a : int\n        First integer.\n    b : int\n        Second integer.\n\n    Returns\n    -------\n    bool\n        True if a and b differ by exactly one bit, False otherwise.\n\n    Raises\n    ------\n    TypeError\n        If either argument is not an integer.\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise TypeError(f\"Both arguments must be integers, got {type(a)} and {type(b)}.\")\n    xor_val = a ^ b\n    return xor_val != 0 and (xor_val & (xor_val - 1)) == 0"}
{"task_id": "Mbpp/7", "solution": "def find_char_long(text: str) -> set[str]:\n    \"\"\"\n    Return a set of all words in *text* that are at least four characters long.\n\n    Words are delimited by whitespace.  The function is case-sensitive and\n    preserves the original casing of each word.\n\n    Parameters\n    ----------\n    text : str\n        Input string containing words separated by whitespace.\n\n    Returns\n    -------\n    set[str]\n        A set of words with length >= 4.\n    \"\"\"\n    if not text:\n        return set()\n\n    return {word for word in text.split() if len(word) >= 4}"}
{"task_id": "Mbpp/8", "solution": "from typing import List, Union\n\nNumber = Union[int, float, complex]\n\ndef square_nums(values: List[Number]) -> List[Number]:\n    \"\"\"Return a new list containing the squares of each numeric element in the input list.\"\"\"\n    if not isinstance(values, list):\n        raise TypeError(f\"Expected a list, got {type(values).__name__}\")\n\n    for idx, val in enumerate(values):\n        if not isinstance(val, (int, float, complex)):\n            raise TypeError(\n                f\"Element at index {idx} is not numeric: {val!r} (type {type(val).__name__})\"\n            )\n\n    return [x * x for x in values]"}
{"task_id": "Mbpp/9", "solution": "def minRotation(s: str) -> int:\n    \"\"\"\n    Return the smallest positive number of left\u2011rotations required to transform\n    the input string `s` back into itself. If no such proper rotation exists,\n    the function returns the length of `s`. For an empty string, the function\n    returns 0.\n\n    Parameters\n    ----------\n    s : str\n        The input string. Must be of type `str`.\n\n    Returns\n    -------\n    int\n        Minimal rotation count > 0 (or 0 for an empty string).\n\n    Raises\n    ------\n    ValueError\n        If `s` is not a string instance.\n    \"\"\"\n    if not isinstance(s, str):\n        raise ValueError(\"Input must be a string\")\n\n    n = len(s)\n    if n == 0:\n        return 0\n\n    # Build the LPS (Longest Prefix Suffix) array\n    lps = [0] * n\n    length = 0  # length of the previous longest prefix suffix\n    i = 1\n\n    while i < n:\n        if s[i] == s[length]:\n            length += 1\n            lps[i] = length\n            i += 1\n        else:\n            if length != 0:\n                length = lps[length - 1]\n            else:\n                lps[i] = 0\n                i += 1\n\n    # Determine the minimal period\n    p = n - lps[-1]\n    if n % p == 0:\n        return p\n    return n"}
{"task_id": "Mbpp/11", "solution": "from typing import Optional\n\ndef remove_Occ(str_input: Optional[str], char: str) -> str:\n    \"\"\"Remove the first and last occurrence of `char` from `str_input`.\n\n    Parameters\n    ----------\n    str_input : Optional[str]\n        The string from which to remove characters. If None, returns \"\".\n    char : str\n        The single character to remove. Must be a string of length 1.\n\n    Returns\n    -------\n    str\n        The resulting string after removal. If `char` occurs fewer than\n        two times, the original string is returned unchanged.\n\n    Raises\n    ------\n    TypeError\n        If `str_input` is not a string or None, or if `char` is not a\n        single character string.\n\n    Examples\n    --------\n    >>> remove_Occ(\"hello\", \"l\")\n    'heo'\n    >>> remove_Occ(\"abc\", \"x\")\n    'abc'\n    >>> remove_Occ(None, \"a\")\n    ''\n    \"\"\"\n    if str_input is None:\n        return \"\"\n\n    if not isinstance(str_input, str):\n        raise TypeError(f\"str_input must be of type str or None, got {type(str_input).__name__}\")\n\n    if not isinstance(char, str) or len(char) != 1:\n        raise TypeError(f\"char must be a single character string, got {char!r}\")\n\n    if str_input == \"\":\n        return str_input\n\n    first_idx = str_input.find(char)\n    if first_idx == -1:\n        return str_input\n\n    last_idx = str_input.rfind(char)\n    if first_idx == last_idx:\n        return str_input\n\n    return (\n        str_input[:first_idx]\n        + str_input[first_idx + 1 : last_idx]\n        + str_input[last_idx + 1 :]\n    )"}
{"task_id": "Mbpp/12", "solution": "from typing import List\n\ndef sort_matrix(matrix: List[List[int]]) -> List[List[int]]:\n    \"\"\"\n    Return a new matrix sorted by ascending sum of each row.\n\n    Parameters\n    ----------\n    matrix : List[List[int]]\n        2-D list of integers to be sorted.\n\n    Returns\n    -------\n    List[List[int]]\n        New matrix sorted by row sum.\n\n    Raises\n    ------\n    TypeError\n        If matrix is not a list of lists of integers.\n    \"\"\"\n    if not isinstance(matrix, list) or any(\n        not isinstance(row, list) or any(not isinstance(x, int) for x in row)\n        for row in matrix\n    ):\n        raise TypeError(\"matrix must be a list of lists of integers\")\n\n    # Empty or all-empty rows\n    if not matrix or all(not row for row in matrix):\n        return []\n\n    return sorted(matrix, key=sum)"}
{"task_id": "Mbpp/14", "solution": "def find_Volume(base: float, height: float, length: float) -> float:\n    \"\"\"\n    Calculate the volume of a triangular prism using the formula:\n        volume = 0.5 * base * height * length\n\n    Parameters\n    ----------\n    base : float\n        The base measurement. Must be numeric and greater than 0.\n    height : float\n        The height measurement. Must be numeric and greater than 0.\n    length : float\n        The length measurement. Must be numeric and greater than 0.\n\n    Returns\n    -------\n    float\n        The calculated volume.\n\n    Raises\n    ------\n    TypeError\n        If any of the arguments is not an int or float.\n    ValueError\n        If any of the arguments is not greater than 0.\n\n    Examples\n    --------\n    >>> find_Volume(10, 8, 6)\n    240.0\n    \"\"\"\n    for name, value in ((\"base\", base), (\"height\", height), (\"length\", length)):\n        if not isinstance(value, (int, float)):\n            raise TypeError(f\"{name} must be a numeric type (int or float), got {type(value).__name__}\")\n        if value <= 0:\n            raise ValueError(f\"{name} must be greater than 0, got {value}\")\n\n    volume = 0.5 * base * height * length\n    return float(volume)"}
{"task_id": "Mbpp/16", "solution": "import re\n\n_LOWERCASE_UNDERSCORE_PATTERN = re.compile(r'^[a-z]+(?:_[a-z]+)+$')\n\ndef text_lowercase_underscore(s):\n    if not isinstance(s, str):\n        return False\n    return bool(_LOWERCASE_UNDERSCORE_PATTERN.fullmatch(s))"}
{"task_id": "Mbpp/17", "solution": "from typing import Union\n\ndef square_perimeter(side_length: Union[int, float]) -> Union[int, float]:\n    \\\"\\\"\\\"Return the perimeter of a square given its side length.\\\"\\\"\\n    if not isinstance(side_length, (int, float)):\\n        raise TypeError(\\\"Side length must be an int or float.\\\")\\n    if side_length < 0:\\n        raise ValueError(\\\"Side length cannot be negative.\\\")\\n    perimeter = 4 * side_length\\n    return int(perimeter) if isinstance(side_length, int) else float(perimeter)"}
{"task_id": "Mbpp/18", "solution": "public static string RemoveCharacters(string source, string removeSet)\n{\n    if (string.IsNullOrEmpty(source))\n        return string.Empty;\n    if (string.IsNullOrEmpty(removeSet))\n        return source;\n\n    var removeChars = new HashSet<char>(removeSet);\n    var result = new System.Text.StringBuilder();\n\n    foreach (char c in source)\n    {\n        if (!removeChars.Contains(c))\n            result.Append(c);\n    }\n\n    return result.ToString();\n}"}
{"task_id": "Mbpp/19", "solution": "import typing\n\ndef test_duplicate(arr: typing.List[int]) -> bool:\n    \"\"\"Return True if the input list contains any duplicate integers, otherwise False.\n\n    Raises:\n        ValueError: If any element in `arr` is not an integer.\n    \"\"\"\n    seen = set()\n    for x in arr:\n        if not isinstance(x, int):\n            raise ValueError(\"All elements must be integers\")\n        if x in seen:\n            return True\n        seen.add(x)\n    return False"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(n: int) -> bool:\n    \"\"\"\n    Determine if the given integer n is a Woodall prime (i.e., prime).\n\n    Parameters:\n        n (int): The number to test.\n\n    Returns:\n        bool: True if n is prime, False otherwise.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer\")\n\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0:\n        return False\n\n    limit = int(n**0.5) + 1\n    i = 3\n    while i <= limit:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\nassert is_woodall(383) == True"}
{"task_id": "Mbpp/56", "solution": "def is_one_less_than_twice_reverse(n: int) -> bool:\n    \"\"\"\n    Return True if n == 2 * reverse(n) - 1, False otherwise.\n\n    Parameters\n    ----------\n    n : int\n        The integer to test. Can be negative, zero, or positive.\n\n    Returns\n    -------\n    bool\n        True if the condition holds, False otherwise.\n\n    Raises\n    ------\n    ValueError\n        If n is not an int.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input must be an integer.\")\n\n    rev = _reverse_digits(n)\n    return _evaluate_condition(n, rev)\n\n\ndef _reverse_digits(n: int) -> int:\n    \"\"\"\n    Compute the decimal digit reverse of the absolute value of n.\n    Leading zeros are discarded; e.g., reverse(1200) -> 21.\n    \"\"\"\n    sign = -1 if n < 0 else 1\n    digits = str(abs(n))\n    reversed_digits = digits[::-1]\n    return sign * int(reversed_digits)\n\n\ndef _evaluate_condition(n: int, rev: int) -> bool:\n    \"\"\"Evaluate whether n equals 2*rev - 1.\"\"\"\n    return n == 2 * rev - 1"}
{"task_id": "Mbpp/57", "solution": "from typing import List, Any\n\ndef find_Max_Num(digits: List[int]) -> int:\n    \"\"\"Return the largest integer that can be formed by arranging digits.\n\n    Args:\n        digits (List[int]): List of digits (0-9). Must not be empty.\n\n    Returns:\n        int: Largest possible integer from the digits.\n\n    Raises:\n        TypeError: If input is not a list or contains non\u2011int elements.\n        ValueError: If the list is empty or contains digits outside 0-9.\n    \"\"\"\n    _validate_input(digits)\n    return _compute_max_number(digits)\n\n\ndef _validate_input(digits: Any) -> None:\n    if not isinstance(digits, list):\n        raise TypeError(\"Input must be a list.\")\n    if len(digits) == 0:\n        raise ValueError(\"Input list cannot be empty.\")\n    for idx, d in enumerate(digits):\n        if not isinstance(d, int):\n            raise TypeError(f\"Element at index {idx} is not an integer.\")\n        if not 0 <= d <= 9:\n            raise ValueError(f\"Digit at index {idx} ({d}) is out of range 0-9.\")\n\n\ndef _compute_max_number(digits: List[int]) -> int:\n    sorted_digits = sorted(digits, reverse=True)\n    number_str = ''.join(map(str, sorted_digits))\n    return int(number_str)"}
{"task_id": "Mbpp/58", "solution": "def opposite_Signs(a: int, b: int) -> bool:\n    \"\"\"Return True if a and b have opposite signs (one positive, one negative).\"\"\"\n    return a * b < 0\n\n# Basic sanity check\nif __name__ == \"__main__\":\n    assert opposite_Signs(1, -2) == True\n    assert opposite_Signs(-5, 3) == True\n    assert opposite_Signs(0, 5) == False\n    assert opposite_Signs(4, 4) == False\n    assert opposite_Signs(-7, -1) == False\n    print(\"All tests passed.\")"}
{"task_id": "Mbpp/59", "solution": "def is_octagonal(n: int) -> int:\n    \"\"\"\n    Return the nth octagonal number.\n\n    Octagonal numbers are given by the formula:\n        O(n) = n * (3n - 2)\n\n    Parameters\n    ----------\n    n : int\n        The ordinal number of the octagonal number to compute.\n        Must be a positive integer.\n\n    Returns\n    -------\n    int\n        The nth octagonal number.\n\n    Raises\n    ------\n    ValueError\n        If n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n    return n * (3 * n - 2)\n\n# Example usage:\nif __name__ == \"__main__\":\n    assert is_octagonal(5) == 65\n    print(\"All tests passed.\")"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"Count substrings where the sum of digits equals the substring length.\"\"\"\n    if not s or not s.isdigit():\n        raise ValueError(\"Input must be a non-empty string of digits.\")\n\n    prefix_sum = 0\n    k_counts = {0: 1}  # K value for index 0\n    total = 0\n\n    for idx, ch in enumerate(s, start=1):  # 1-based index\n        digit = ord(ch) - 48\n        prefix_sum += digit\n        k = prefix_sum - idx\n        current_count = k_counts.get(k, 0)\n        total += current_count\n        k_counts[k] = current_count + 1\n\n    return total\n\n\nif __name__ == \"__main__\":\n    assert count_Substrings(\"112112\") == 6\n    print(\"All tests passed.\")"}
{"task_id": "Mbpp/62", "solution": "from typing import List\n\ndef smallest_num(numbers: List[int]) -> int:\n    \"\"\"Return the smallest integer from a list of integers.\n\n    Parameters\n    ----------\n    numbers : List[int]\n        A list containing integer values. Must not be empty.\n\n    Returns\n    -------\n    int\n        The smallest integer in the input list.\n\n    Raises\n    ------\n    TypeError\n        If ``numbers`` is not a list or contains non\u2011int elements.\n    ValueError\n        If ``numbers`` is an empty list.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"`numbers` must be of type list[int]\")\n\n    if not all(isinstance(item, int) for item in numbers):\n        raise TypeError(\"All elements of `numbers` must be int\")\n\n    if not numbers:\n        raise ValueError(\"`numbers` must not be empty\")\n\n    return min(numbers)"}
{"task_id": "Mbpp/63", "solution": "from typing import List, Tuple, Optional\n\ndef max_difference(pairs: List[Tuple[int, int]]) -> Optional[int]:\n    \"\"\"\n    Return the maximum absolute difference between any two integers\n    contained in the given list of two\u2011element integer tuples.\n\n    Parameters\n    ----------\n    pairs : List[Tuple[int, int]]\n        List of tuples, each containing exactly two integers.\n\n    Returns\n    -------\n    Optional[int]\n        The maximum absolute difference, or None if the list is empty.\n\n    Raises\n    ------\n    TypeError\n        If the input is not a list of 2\u2011element tuples of integers.\n    \"\"\"\n    if not isinstance(pairs, list):\n        raise TypeError(\"Input must be a list of tuples.\")\n    if not pairs:\n        return None\n\n    # Initialize min and max with values from the first tuple\n    a, b = pairs[0]\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise TypeError(\"All tuple elements must be integers.\")\n    min_val = a if a < b else b\n    max_val = a if a > b else b\n\n    for t in pairs[1:]:\n        if not (isinstance(t, tuple) and len(t) == 2):\n            raise TypeError(\"Each element must be a tuple of two integers.\")\n        x, y = t\n        if not isinstance(x, int) or not isinstance(y, int):\n            raise TypeError(\"All tuple elements must be integers.\")\n        local_min = x if x < y else y\n        local_max = x if x > y else y\n        if local_min < min_val:\n            min_val = local_min\n        if local_max > max_val:\n            max_val = local_max\n\n    return max_val - min_val\n\n# Example usage\nif __name__ == \"__main__\":\n    assert max_difference([(3, 5), (1, 7), (10, 3), (1, 2)]) == 7\n    print(\"All tests passed.\")"}
{"task_id": "Mbpp/64", "solution": "def subject_marks(subject_list):\n    \"\"\"\n    Sorts a list of (subject, score) tuples by the score (second element) in ascending order.\n    \n    Parameters:\n        subject_list (list of tuple): List where each tuple contains a subject name and a numeric score.\n    \n    Returns:\n        list of tuple: New list sorted by score in ascending order.\n    \"\"\"\n    return sorted(subject_list, key=lambda x: x[1])"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(data: list) -> int:\n    \"\"\"\n    Compute the sum of all integer elements in a nested list.\n\n    Parameters\n    ----------\n    data : list\n        The input list, potentially nested, containing integers and/or other types.\n\n    Returns\n    -------\n    int\n        Sum of all integer elements found within `data`.\n\n    Raises\n    ------\n    TypeError\n        If `data` is not a list.\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input must be a list.\")\n\n    def _sum_recursive(sublist: list) -> int:\n        total = 0\n        for element in sublist:\n            if isinstance(element, int):\n                total += element\n            elif isinstance(element, list):\n                total += _sum_recursive(element)\n            # ignore non-integer, non-list elements\n        return total\n\n    return _sum_recursive(data)"}
{"task_id": "Mbpp/66", "solution": "from typing import List\n\ndef _validate_input(nums):\n    if not isinstance(nums, list):\n        raise TypeError(\"Input must be a list\")\n\ndef _validate_elements(nums):\n    for idx, val in enumerate(nums):\n        if not isinstance(val, int):\n            raise ValueError(f\"Element at index {idx} is not an int\")\n\ndef pos_count(nums: List[int]) -> int:\n    \"\"\"Count strictly positive integers in a list.\n\n    Parameters\n    ----------\n    nums : List[int]\n        List of integers to evaluate.\n\n    Returns\n    -------\n    int\n        Number of elements greater than zero.\n\n    Raises\n    ------\n    TypeError\n        If nums is not a list.\n    ValueError\n        If any element in nums is not an int.\n    \"\"\"\n    _validate_input(nums)\n    _validate_elements(nums)\n    count = 0\n    for num in nums:\n        if num > 0:\n            count += 1\n    return count"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Return the nth Bell number using dynamic programming on Stirling numbers of the second kind.\n    \n    Parameters\n    ----------\n    n : int\n        Non\u2011negative integer index (n \u2265 0).\n    \n    Returns\n    -------\n    int\n        Exact integer Bell number B_n.\n    \n    Raises\n    ------\n    ValueError\n        If n is not an integer or n < 0.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non\u2011negative integer\")\n\n    if n == 0:\n        return 1\n\n    prev = [0] * (n + 1)\n    prev[0] = 1  # S(0,0)\n\n    for i in range(1, n + 1):\n        curr = [0] * (n + 1)\n        for k in range(1, i + 1):\n            curr[k] = k * prev[k] + prev[k - 1]\n        prev = curr\n\n    return sum(prev[: n + 1])"}
{"task_id": "Mbpp/68", "solution": "from typing import List, Union\n\ndef is_Monotonic(lst: List[Union[int, float]]) -> bool:\n    \"\"\"Determine whether a given list of numbers is monotonic (either non\u2011decreasing or non\u2011increasing).\n\n    Parameters\n    ----------\n    lst : List[Union[int, float]]\n        Input list of numeric values.\n\n    Returns\n    -------\n    bool\n        True if the list is monotonic; otherwise False.\n\n    Raises\n    ------\n    TypeError\n        If `lst` is not a list or contains non\u2011numeric elements.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n    for idx, item in enumerate(lst):\n        if not isinstance(item, (int, float)):\n            raise TypeError(\n                f\"All list elements must be int or float. Invalid element at index {idx}: {item!r}\"\n            )\n\n    n = len(lst)\n    if n <= 1:\n        return True\n\n    non_decreasing = True\n    non_increasing = True\n    prev = lst[0]\n    for curr in lst[1:]:\n        if curr > prev:\n            non_increasing = False\n        elif curr < prev:\n            non_decreasing = False\n        if not non_decreasing and not non_increasing:\n            return False\n        prev = curr\n\n    return True"}
{"task_id": "Mbpp/69", "solution": "from collections.abc import Sequence\nfrom typing import Any\n\ndef is_sublist(lst: Sequence[Any], sub: Sequence[Any]) -> bool:\n    \"\"\"\n    Return True if sub appears contiguously within lst; otherwise False.\n    Raises TypeError if inputs are not sequences.\n\n    Parameters\n    ----------\n    lst : Sequence[Any]\n        Host list in which to search for the sublist.\n    sub : Sequence[Any]\n        Subsequence to search for.\n\n    Returns\n    -------\n    bool\n        True if sub is a contiguous sublist of lst, False otherwise.\n    \"\"\"\n    if not isinstance(lst, Sequence) or not isinstance(sub, Sequence):\n        raise TypeError(\"Both arguments must be sequences\")\n\n    n, m = len(lst), len(sub)\n\n    if m == 0:\n        return True\n    if m > n:\n        return False\n\n    max_start = n - m\n    for start in range(max_start + 1):\n        match = True\n        for i in range(m):\n            if lst[start + i] != sub[i]:\n                match = False\n                break\n        if match:\n            return True\n    return False"}
{"task_id": "Mbpp/70", "solution": "from collections.abc import Iterable\nfrom typing import Any, List, Tuple\n\n\ndef get_equal(data: List[Tuple[Any, ...]]) -> bool:\n    \"\"\"\n    Determine if all tuples in 'data' have the same length.\n\n    Parameters:\n        data (List[Tuple[Any, ...]]): List containing tuples to evaluate.\n\n    Returns:\n        bool: True if all tuples are of equal length, False otherwise.\n              Returns True for an empty list.\n\n    Raises:\n        TypeError: If 'data' is not a list or iterable, or any element is not a tuple.\n    \"\"\"\n    if not isinstance(data, Iterable) or isinstance(data, (str, bytes)):\n        raise TypeError(\"Input must be a list or iterable of tuples\")\n\n    iterator = iter(data)\n    try:\n        first = next(iterator)\n    except StopIteration:\n        return True\n\n    if not isinstance(first, tuple):\n        raise TypeError(\"All elements must be tuples\")\n\n    first_len = len(first)\n    for item in iterator:\n        if not isinstance(item, tuple):\n            raise TypeError(\"All elements must be tuples\")\n        if len(item) != first_len:\n            return False\n\n    return True"}
{"task_id": "Mbpp/71", "solution": "from typing import List, TypeVar, Any\n\nT = TypeVar('T')\n\ndef comb_sort(lst: List[T], reverse: bool = False) -> List[T]:\n    \"\"\"\n    Sort a list of comparable elements using the Comb Sort algorithm.\n\n    Parameters\n    ----------\n    lst : list\n        List of elements supporting < and > operators.\n    reverse : bool, optional\n        If True, sort in descending order. Default is False.\n\n    Returns\n    -------\n    list\n        A new list containing the sorted elements.\n\n    Raises\n    ------\n    TypeError\n        If the input is not a list or elements are not comparable.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(f\"Expected a list, got {type(lst).__name__}\")\n\n    # Create a copy to avoid mutating the original list\n    arr = list(lst)\n\n    n = len(arr)\n    if n < 2:\n        return arr\n\n    shrink = 1.3\n    gap = n\n    swapped = True\n\n    # Helper for comparison based on reverse flag\n    comp = (lambda a, b: a > b) if not reverse else (lambda a, b: a < b)\n\n    while gap > 1 or swapped:\n        gap = int(gap / shrink)\n        if gap < 1:\n            gap = 1\n\n        swapped = False\n\n        for i in range(n - gap):\n            try:\n                if comp(arr[i], arr[i + gap]):\n                    arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                    swapped = True\n            except TypeError as exc:\n                raise TypeError(f\"Elements at indices {i} and {i + gap} are not comparable\") from exc\n\n    return arr"}
{"task_id": "Mbpp/72", "solution": "def dif_Square(n: int) -> bool:\n    \"\"\"Determine if the integer n can be expressed as a difference of two perfect squares.\n\n    Args:\n        n (int): Integer to test (must fit in 64\u2011bit signed range).\n\n    Returns:\n        bool: True if n = a^2 - b^2 for some integers a, b; False otherwise.\n\n    Raises:\n        TypeError: If n is not an int.\n        ValueError: If n is outside 64\u2011bit signed integer range.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n < -2**63 or n > 2**63 - 1:\n        raise ValueError(\"Input out of 64\u2011bit signed integer range.\")\n    return n % 4 != 2"}
{"task_id": "Mbpp/74", "solution": "from collections.abc import Iterable\nfrom typing import TypeVar\n\nT = TypeVar(\"T\")\n\n\ndef is_samepatterns(a: Iterable[T], b: Iterable[T]) -> bool:\n    \"\"\"\n    Determine whether two iterables follow the same pattern.\n\n    A pattern match exists if there is a bijective mapping between the\n    elements of the first iterable and the elements of the second\n    iterable that preserves order and duplicate relationships.\n\n    Parameters\n    ----------\n    a : Iterable[T]\n        First iterable of hashable elements.\n    b : Iterable[T]\n        Second iterable of hashable elements.\n\n    Returns\n    -------\n    bool\n        True if the iterables follow the same pattern, False otherwise.\n\n    Raises\n    ------\n    TypeError\n        If inputs are not iterable or contain unhashable elements.\n    \"\"\"\n    # Validate iterables\n    if not isinstance(a, Iterable):\n        raise TypeError(f\"First argument {a!r} is not iterable\")\n    if not isinstance(b, Iterable):\n        raise TypeError(f\"Second argument {b!r} is not iterable\")\n\n    # Convert to lists for length check and repeated access\n    list_a = list(a)\n    list_b = list(b)\n\n    # Length check\n    if len(list_a) != len(list_b):\n        return False\n\n    # Mapping dictionaries\n    map_a_to_b = {}\n    map_b_to_a = {}\n\n    for x, y in zip(list_a, list_b):\n        # Ensure hashability\n        try:\n            hash(x)\n        except TypeError as exc:\n            raise TypeError(f\"Element {x!r} from first iterable is unhashable\") from exc\n        try:\n            hash(y)\n        except TypeError as exc:\n            raise TypeError(f\"Element {y!r} from second iterable is unhashable\") from exc\n\n        # Check existing mappings\n        if x in map_a_to_b:\n            if map_a_to_b[x] != y:\n                return False\n        else:\n            if y in map_b_to_a:\n                return False\n            map_a_to_b[x] = y\n            map_b_to_a[y] = x\n\n    return True\n\n# Example usage\nif __name__ == \"__main__\":\n    assert is_samepatterns([\"red\", \"green\", \"green\"], [\"a\", \"b\", \"b\"])\n    assert not is_samepatterns([1, 2, 3], [\"a\", \"b\", \"a\"])\n    assert is_samepatterns([], [])\n    print(\"All tests passed.\")"}
{"task_id": "Mbpp/75", "solution": "def find_tuples(input_tuples, k):\n    \"\"\"\n    Return a list of tuples from `input_tuples` where every element is divisible by `k`.\n\n    Parameters\n    ----------\n    input_tuples : list[tuple[int, ...]]\n        A list containing tuples of integers.\n    k : int\n        The divisor. Must not be zero.\n\n    Returns\n    -------\n    list[tuple[int, ...]]\n        A list of tuples that satisfy the divisibility condition.\n\n    Raises\n    ------\n    ValueError\n        If `k` is zero.\n    TypeError\n        If `k` is not an integer, if `input_tuples` is not a list,\n        if any element of `input_tuples` is not a tuple, or if any element\n        within a tuple is not an integer.\n    \"\"\"\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer\")\n    if k == 0:\n        raise ValueError(\"Divisor k cannot be zero\")\n\n    if not isinstance(input_tuples, list):\n        raise TypeError(\"input_tuples must be a list\")\n\n    result = []\n\n    for t in input_tuples:\n        if not isinstance(t, tuple):\n            raise TypeError(\"Each element of input_tuples must be a tuple\")\n        for e in t:\n            if not isinstance(e, int):\n                raise TypeError(\"All tuple elements must be integers\")\n        if all(e % k == 0 for e in t):\n            result.append(t)\n\n    return result"}
{"task_id": "Mbpp/77", "solution": "def is_Diff(number: int) -> bool:\n    \"\"\"Check if an integer is divisible by 11.\n\n    Parameters\n    ----------\n    number : int\n        The integer to test.\n\n    Returns\n    -------\n    bool\n        True if number is divisible by 11, False otherwise.\n\n    Raises\n    ------\n    TypeError\n        If the input is not an integer.\n    \"\"\"\n    if not isinstance(number, int):\n        raise TypeError(f\"Input must be an integer, got {type(number).__name__}\")\n    return number % 11 == 0"}
{"task_id": "Mbpp/79", "solution": "def word_len(word: str) -> bool:\n    \"\"\"\n    Determine if the length of the input word is odd.\n\n    Parameters\n    ----------\n    word : str\n        The word to be examined. Unicode characters are counted as a single character.\n\n    Returns\n    -------\n    bool\n        True if len(word) is odd; False otherwise.\n\n    Raises\n    ------\n    TypeError\n        If `word` is not an instance of `str`.\n\n    Examples\n    --------\n    >>> word_len(\"hello\")\n    True\n    >>> word_len(\"world!\")\n    False\n    >>> word_len(\"\")\n    False\n    \"\"\"\n    if not isinstance(word, str):\n        raise TypeError(\"Input must be a string\")\n    return len(word) % 2 == 1"}
{"task_id": "Mbpp/80", "solution": "def tetrahedral(n: int) -> int:\n    \"\"\"Compute the nth tetrahedral number.\n\n    Parameters:\n        n (int): Non\u2011negative index of the tetrahedral sequence.\n\n    Returns:\n        int: The nth tetrahedral number.\n\n    Raises:\n        ValueError: If n is negative.\n        TypeError: If n is not an integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non\u2011negative\")\n\n    # Compute the triangular number first to reduce intermediate size:\n    # T_tri = n * (n + 1) // 2\n    t_tri = n * (n + 1) // 2\n    # Then compute the tetrahedral number:\n    # T = t_tri * (n + 2) // 3\n    return t_tri * (n + 2) // 3\n\n# Example usage:\n# >>> tetrahedral(3)\n# 10\n# >>> tetrahedral(10)\n# 220"}
