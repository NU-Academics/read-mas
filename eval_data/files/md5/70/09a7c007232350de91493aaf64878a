{"task_id": "Mbpp/126", "solution": "def sum(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of common divisors of two given numbers.\n    This function orchestrates the finding of divisors, common divisors, and their sum.\n    \"\"\"\n\n    def get_divisors(number: int) -> list[int]:\n        \"\"\"\n        Calculates all positive divisors of a given number efficiently.\n        It uses an O(sqrt(n)) approach to find divisors.\n        \"\"\"\n        divs = set()\n        for i in range(1, int(number**0.5) + 1):\n            if number % i == 0:\n                divs.add(i)\n                divs.add(number // i)\n        return sorted(list(divs))\n\n    def find_common_divisors(divisors1: list[int], divisors2: list[int]) -> list[int]:\n        \"\"\"\n        Identifies the divisors common to both input lists.\n        It returns the intersection of the two sets of divisors.\n        \"\"\"\n        set1 = set(divisors1)\n        set2 = set(divisors2)\n        return sorted(list(set1.intersection(set2)))\n\n    def calculate_sum(divisors: list[int]) -> int:\n        \"\"\"\n        Computes the sum of all integers in the provided list of divisors.\n        \"\"\"\n        return builtins.sum(divisors) # Using builtins.sum to avoid recursion with this function's name\n\n    # Alias built-in sum to avoid shadowing and allow use in `calculate_sum`\n    import builtins\n\n    divs1 = get_divisors(num1)\n    divs2 = get_divisors(num2)\n    common_divs = find_common_divisors(divs1, divs2)\n    final_sum = calculate_sum(common_divs)\n\n    return final_sum"}
{"task_id": "Mbpp/128", "solution": "def _validate_input(n: int, text_string: str) -> bool:\n    \"\"\"Validate input parameters. Returns True if valid, False otherwise.\"\"\"\n    # Ensure threshold n is non-negative.\n    return n >= 0\n\ndef _split_text(text_string: str) -> list[str]:\n    \"\"\"Split text into words using whitespace delimiter.\"\"\"\n    return text_string.split()\n\ndef _filter_words(words: list[str], threshold: int) -> list[str]:\n    \"\"\"Filter words that have more than threshold characters.\"\"\"\n    return [word for word in words if len(word) > threshold]\n\ndef long_words(n: int, text_string: str) -> list[str]:\n    \"\"\"\n    Find words longer than n characters from given text string.\n    Returns a list of words longer than n characters.\n    \"\"\"\n    if not _validate_input(n, text_string):\n        return []\n\n    word_list = _split_text(text_string)\n    filtered_words = _filter_words(word_list, n)\n    return filtered_words"}
{"task_id": "Mbpp/125", "solution": "def find_length(binary_string: str) -> int:\n    \"\"\"\n    Calculates the maximum difference between the number of 0s and 1s in any substring of the given binary string.\n    This is solved by transforming '0' to 1 and '1' to -1, then finding the maximum subarray sum using Kadane's algorithm.\n    \"\"\"\n    transformed_array = []\n    for char in binary_string:\n        if char == '0':\n            transformed_array.append(1)\n        else:  # char == '1'\n            transformed_array.append(-1)\n\n    # If the input binary string is empty, there are no substrings, so the difference is 0.\n    if not transformed_array:\n        return 0\n\n    max_so_far = transformed_array[0]\n    current_max = transformed_array[0]\n\n    for i in range(1, len(transformed_array)):\n        num = transformed_array[i]\n        # Calculate the maximum sum ending at the current position.\n        current_max = max(num, current_max + num)\n        # Update the overall maximum sum found so far.\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix):\n    \"\"\"\n    Calculates whether the given matrix is a magic square.\n    A magic square has equal sums for all rows, columns, and both main diagonals.\n    \"\"\"\n    if not matrix:\n        return False\n\n    n = len(matrix)\n\n    # Check if the matrix is empty or has non-list rows, or inconsistent row lengths\n    if n == 0 or not matrix[0] or len(matrix[0]) != n:\n        return False\n    \n    for row in matrix:\n        if len(row) != n:\n            return False\n\n    # Calculate the sum of the first row to use as the expected sum for all other lines\n    expected_sum = sum(matrix[0])\n\n    # Check row sums\n    for i in range(n):\n        current_row_sum = sum(matrix[i])\n        if current_row_sum != expected_sum:\n            return False\n\n    # Check column sums\n    for j in range(n):\n        current_column_sum = 0\n        for i in range(n):\n            current_column_sum += matrix[i][j]\n        if current_column_sum != expected_sum:\n            return False\n\n    # Check main diagonal sum (top-left to bottom-right)\n    main_diagonal_sum = 0\n    for i in range(n):\n        main_diagonal_sum += matrix[i][i]\n    if main_diagonal_sum != expected_sum:\n        return False\n\n    # Check anti-diagonal sum (top-right to bottom-left)\n    anti_diagonal_sum = 0\n    for i in range(n):\n        anti_diagonal_sum += matrix[i][n - 1 - i]\n    if anti_diagonal_sum != expected_sum:\n        return False\n\n    return True"}
