{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the number of sequences of length n, where each element is a positive integer,\n    is less than or equal to m, and is greater than or equal to twice the previous element.\n    \"\"\"\n    # dp[i][j] stores the number of sequences of length 'i' ending with value 'j'.\n    dp = [[0] * (m + 1) for _ in range(n + 1)]\n\n    # prefix_sum[i][j] stores the sum of dp[i][k] for 1 <= k <= j.\n    # This helps optimize the sum calculation in the DP transition.\n    prefix_sum = [[0] * (m + 1) for _ in range(n + 1)]\n\n    # Base case: Sequences of length 1\n    # Any positive integer from 1 to m can be the first element.\n    for j in range(1, m + 1):\n        dp[1][j] = 1\n        prefix_sum[1][j] = prefix_sum[1][j - 1] + dp[1][j]\n\n    # Fill DP table for lengths from 2 to n\n    for length in range(2, n + 1):\n        for ending_val in range(1, m + 1):\n            # The previous element 'k' must satisfy k * 2 <= ending_val,\n            # so k <= ending_val // 2.\n            max_prev_val = ending_val // 2\n\n            if max_prev_val >= 1:\n                # The number of sequences of length 'length' ending with 'ending_val'\n                # is the sum of sequences of length 'length-1' that end with 'k'\n                # where 1 <= k <= max_prev_val.\n                dp[length][ending_val] = prefix_sum[length - 1][max_prev_val]\n            # If max_prev_val < 1, no positive integer 'k' can satisfy the condition,\n            # so dp[length][ending_val] remains 0.\n\n            prefix_sum[length][ending_val] = prefix_sum[length][ending_val - 1] + dp[length][ending_val]\n\n    # The total number of sequences of length n is the sum of all dp[n][j] for 1 <= j <= m.\n    # This is conveniently stored in prefix_sum[n][m].\n    return prefix_sum[n][m]"}
{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"\n    Finds the length of the longest palindromic subsequence in the given string using dynamic programming.\n    \"\"\"\n    n = len(s)\n\n    # If the string is empty, the LPS length is 0.\n    if n == 0:\n        return 0\n    \n    # dp[i][j] stores the length of the longest palindromic subsequence of substring s[i...j].\n    dp = [[0] * n for _ in range(n)]\n\n    # Base case: A single character is a palindrome of length 1.\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the DP table for substrings of increasing length.\n    # 'l' represents the current length of the substring.\n    for l in range(2, n + 1):\n        # 'i' is the starting index of the substring.\n        for i in range(n - l + 1):\n            j = i + l - 1  # 'j' is the ending index of the substring.\n\n            if s[i] == s[j]:\n                # If characters at ends match, they contribute 2 to the LPS, plus the LPS of the inner substring.\n                if l == 2:\n                    dp[i][j] = 2\n                else:\n                    dp[i][j] = 2 + dp[i+1][j-1]\n            else:\n                # If characters don't match, take the maximum LPS from excluding either end character.\n                dp[i][j] = max(dp[i+1][j], dp[i][j-1])\n    \n    # The result for the entire string s[0...n-1] is at dp[0][n-1].\n    return dp[0][n-1]"}
{"task_id": "Mbpp/245", "solution": "def find_increasing_sums(arr: list[int]) -> list[int]:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence ending at each position.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n    # inc_sums[i] stores the maximum sum of an increasing subsequence ending with arr[i].\n    inc_sums = list(arr)\n    for i in range(1, n):\n        for j in range(i):\n            if arr[i] > arr[j]:\n                inc_sums[i] = max(inc_sums[i], inc_sums[j] + arr[i])\n    return inc_sums\n\ndef find_decreasing_sums(arr: list[int]) -> list[int]:\n    \"\"\"\n    Finds the maximum sum of a decreasing subsequence starting at each position.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n    # dec_sums[i] stores the maximum sum of a decreasing subsequence starting with arr[i].\n    dec_sums = list(arr)\n    for i in range(n - 2, -1, -1):\n        for j in range(i + 1, n):\n            if arr[i] > arr[j]:\n                dec_sums[i] = max(dec_sums[i], dec_sums[j] + arr[i])\n    return dec_sums\n\ndef combine_bitonic_sums(arr: list[int], inc_sums: list[int], dec_sums: list[int]) -> int:\n    \"\"\"\n    Combines increasing and decreasing sums to find the overall maximum bitonic sum.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n    # Initialize with the sum of a single element (a trivial bitonic subsequence).\n    max_bitonic_sum = arr[0] \n    \n    # For a bitonic sequence, the element at index `i` can be the peak.\n    # The sum for a peak at index `i` is inc_sums[i] + dec_sums[i] - arr[i],\n    # as arr[i] is counted in both increasing and decreasing sums.\n    for i in range(n):\n        current_sum = inc_sums[i] + dec_sums[i] - arr[i]\n        max_bitonic_sum = max(max_bitonic_sum, current_sum)\n    \n    return max_bitonic_sum\n\ndef max_sum(arr: list[int]) -> int:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence in the given array.\n    A sequence is bitonic if it is first increasing and then decreasing.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n\n    inc_sums = find_increasing_sums(arr)\n    dec_sums = find_decreasing_sums(arr)\n\n    return combine_bitonic_sums(arr, inc_sums, dec_sums)"}
