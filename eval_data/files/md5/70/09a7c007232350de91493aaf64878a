{"task_id": "Mbpp/763", "solution": "def find_min_diff(array, length):\n    \"\"\"\n    Finds the minimum absolute difference between any two elements in a given array.\n    This implementation compares all distinct pairs of elements.\n    \"\"\"\n    min_diff = float('inf')\n\n    for i in range(length):\n        for j in range(i + 1, length):\n            current_diff = abs(array[i] - array[j])\n            if current_diff < min_diff:\n                min_diff = current_diff\n    return min_diff"}
{"task_id": "Mbpp/762", "solution": "def check_monthnumber_number(month_number: int) -> bool:\n    \"\"\"\n    Checks if the given month number (1-12) has exactly 30 days.\n    Months with 30 days are April (4), June (6), September (9), and November (11).\n    \"\"\"\n    if not 1 <= month_number <= 12:\n        # Invalid month number, but according to prompt:\n        # \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n        # and \"Return False for months not containing 30 days\" and \"Graceful error handling for invalid inputs\"\n        # The test case implies returning a boolean. If the month number is outside the valid range,\n        # it certainly does not have 30 days (as it's not a real month).\n        return False\n\n    return month_number in {4, 6, 9, 11}"}
{"task_id": "Mbpp/766", "solution": "from typing import List, Tuple, Any\n\ndef pair_wise(input_list: List[Any]) -> List[Tuple[Any, Any]]:\n    \"\"\"\n    Return a list of all pairs of consecutive items in a given list.\n    \"\"\"\n    if len(input_list) < 2:\n        return []\n\n    result = []\n    for i in range(len(input_list) - 1):\n        result.append((input_list[i], input_list[i+1]))\n    return result"}
{"task_id": "Mbpp/765", "solution": "def findNthPoliteNumber(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number.\n    A polite number is a positive integer that can be expressed as the sum of two or more consecutive positive integers.\n    \"\"\"\n    # A number is polite if and only if it is not a power of 2.\n    # Therefore, we need to find the nth number that is not a power of 2.\n    \n    count = 0\n    num = 1\n    while True:\n        # Check if num is a power of 2\n        # A number is a power of 2 if (num > 0) and (num & (num - 1) == 0)\n        # However, the problem statement defines polite numbers as positive integers.\n        # The sequence starts from 3, 5, 6, 7, 9, 10, 11, 12, 13, 14, 15, 17...\n        # The powers of 2 are 1, 2, 4, 8, 16, 32...\n        # So we want to count numbers that are NOT powers of 2.\n        \n        is_power_of_two = (num > 0) and ((num & (num - 1)) == 0)\n        \n        if not is_power_of_two:\n            count += 1\n            if count == n:\n                return num\n        num += 1"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth power of the first n odd natural numbers.\n    For n=2, this is 1^4 + 3^4 = 1 + 81 = 82.\n    \"\"\"\n    total_sum = 0\n    for i in range(n):\n        odd_number = 2 * i + 1\n        total_sum += odd_number ** 4\n    return total_sum"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers, target_sum):\n    \"\"\"\n    Count pairs of numbers whose sum equals target_sum.\n    The function considers pairs formed by elements at different indices only.\n    \"\"\"\n    if len(numbers) < 2:\n        return 0\n\n    count = 0\n    for i in range(len(numbers)):\n        for j in range(i + 1, len(numbers)):\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n\n    return count"}
{"task_id": "Mbpp/769", "solution": "def Diff(first_list: list, second_list: list) -> list:\n    \"\"\"\n    Calculates the difference between two lists, returning elements from the first list\n    that are not present in the second list, while preserving their original order.\n    \"\"\"\n    result = []\n    # Convert second_list to a set for efficient lookups, improving performance.\n    second_set = set(second_list)\n    for item in first_list:\n        if item not in second_set:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets.\n    Supports parentheses (), square brackets [], and curly braces {}.\n    \"\"\"\n    stack = []\n    \n    # Define bracket types and their matching pairs\n    opening_brackets = {'(', '[', '{'}\n    closing_brackets = {')', ']', '}'}\n    bracket_pairs = {')': '(', ']': '[', '}': '{'}\n    \n    for char in expression:\n        if char in opening_brackets:\n            stack.append(char)\n        elif char in closing_brackets:\n            if not stack:\n                return False  # Closing bracket without a matching opening bracket\n            \n            top_of_stack = stack.pop()\n            if bracket_pairs[char] != top_of_stack:\n                return False  # Mismatched opening and closing brackets\n        # Non-bracket characters are ignored\n            \n    return not stack # True if stack is empty (all brackets matched), False otherwise"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(source_string: str, search_substring: str) -> tuple | None:\n    \"\"\"\n    Finds the first occurrence and position of a substring within a string.\n    Returns None if no match is found.\n    \"\"\"\n    if not search_substring:\n        # According to the problem description, an empty substring should not match,\n        # but Python's find() method returns 0 for empty substrings.\n        # This handles that specific edge case.\n        return None\n\n    start_position = source_string.find(search_substring)\n\n    if start_position == -1:\n        return None\n    else:\n        end_position = start_position + len(search_substring)\n        return (search_substring, start_position, end_position)"}
{"task_id": "Mbpp/775", "solution": "def odd_position(input_list):\n    \"\"\"\n    Checks if every odd index in the list contains an odd number.\n    Returns True if all odd-indexed positions satisfy this condition, False otherwise.\n    \"\"\"\n    for index, value in enumerate(input_list):\n        # Check if the current index is odd (1, 3, 5, ...)\n        if index % 2 == 1:\n            # If the index is odd, the value at that index must also be odd.\n            # If it's not odd (i.e., it's even), then the condition is not met.\n            if value % 2 == 0:\n                return False\n    # If the loop completes, it means all odd-indexed positions contained odd numbers.\n    return True"}
