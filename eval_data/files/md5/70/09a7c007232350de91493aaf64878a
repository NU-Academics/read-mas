{"task_id": "Mbpp/801", "solution": "def test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"\n    Count the number of equal integers from three given integers.\n\n    Args:\n        a: First integer\n        b: Second integer\n        c: Third integer\n\n    Returns:\n        int: Count of equal numbers (0, 2, or 3)\n    \"\"\"\n    if a == b and b == c:\n        return 3\n    elif a == b or b == c or a == c:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/803", "solution": "def is_perfect_square(number):\n    \"\"\"\n    Checks if the given number is a perfect square.\n    It returns True if the number is a perfect square, False otherwise.\n    \"\"\"\n    if number < 0:\n        return False\n    if number == 0:\n        return True\n    \n    # Calculate the integer square root\n    root = int(number**0.5)\n    \n    # Check if the square of the integer root equals the original number\n    return root * root == number"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(lists):\n    \"\"\"\n    Returns the list with the highest sum of elements.\n    \"\"\"\n    def _calculate_sum(inner_list):\n        \"\"\"\n        Calculate sum of elements in a list.\n        \"\"\"\n        return sum(inner_list)\n\n    def _find_max_index(sums):\n        \"\"\"\n        Find index of first maximum value in list.\n        \"\"\"\n        if not sums:\n            # This case would ideally be handled by input validation or specific error,\n            # but per instructions, assuming valid non-empty input for processing.\n            return -1 # Or handle as per undefined behavior for empty input sums\n\n        max_val = sums[0]\n        max_idx = 0\n        for i, val in enumerate(sums):\n            if val > max_val:\n                max_val = val\n                max_idx = i\n        return max_idx\n\n    all_sums = []\n    for inner_list in lists:\n        all_sums.append(_calculate_sum(inner_list))\n\n    if not all_sums:\n        # If input lists was empty, return an empty list or handle as per desired spec for empty input.\n        # Given the problem statement and example, an empty input is not expected or explicitly defined.\n        return [] \n\n    max_idx = _find_max_index(all_sums)\n    return lists[max_idx]"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Finds the maximum run of consecutive uppercase characters in a string.\n    Iterates through the string, tracking the current and maximum uppercase run lengths.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in input_string:\n        if char.isupper():\n            current_run += 1\n            if current_run > max_run:\n                max_run = current_run\n        else:\n            current_run = 0\n    return max_run"}
