{"task_id": "Mbpp/605", "solution": "def _validate_input(n: int) -> bool:\n    \"\"\"\n    Validate input is positive integer.\n    Returns True if n is a positive integer, False otherwise.\n    \"\"\"\n    return n > 0\n\ndef _is_prime_algorithm(n: int) -> bool:\n    \"\"\"\n    Efficient primality testing algorithm.\n    Checks if a positive integer n is prime using O(\u221an) trial division.\n    \"\"\"\n    if n == 1:\n        return False\n    if n == 2 or n == 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef prime_num(n: int) -> bool:\n    \"\"\"\n    Check if given integer is a prime number.\n    Returns True if n is prime, False otherwise.\n    \"\"\"\n    if not _validate_input(n):\n        return False\n\n    return _is_prime_algorithm(n)"}
{"task_id": "Mbpp/608", "solution": "import math\n\ndef bell_Number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number using dynamic programming.\n    Bell numbers count the number of partitions of a set of n elements.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Create a list to store Bell numbers, where bell[i] will hold B_i\n    bell = [0] * (n + 1)\n    bell[0] = 1  # Base case for B_0\n\n    # Calculate B_i using the recurrence B_i = sum_{k=0 to i-1} (i-1 choose k) * B_k\n    for i in range(1, n + 1):\n        current_bell_number = 0\n        for k in range(i):  # k ranges from 0 to i-1\n            # (i-1 choose k)\n            binom_coeff = math.comb(i - 1, k)\n            current_bell_number += binom_coeff * bell[k]\n        bell[i] = current_bell_number\n\n    return bell[n]"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list, k):\n    \"\"\"\n    Returns a new list with the k'th element removed using zero-based indexing.\n    The original list remains unchanged.\n    \"\"\"\n    new_list = []\n    for i in range(len(input_list)):\n        if i != k:\n            new_list.append(input_list[i])\n    return new_list"}
{"task_id": "Mbpp/607", "solution": "import re\n\ndef find_literals(text: str, pattern: str) -> tuple:\n    \"\"\"\n    Searches a string for the first occurrence of a regex pattern.\n    Returns the matching substring, start index, and end index as a tuple.\n    \"\"\"\n    match = re.search(pattern, text)\n    if match:\n        return match.group(0), match.start(), match.end()\n    return None"}
{"task_id": "Mbpp/611", "solution": "def _validate_input(matrix, column_index):\n    \"\"\"Validate matrix structure and column index.\n    No explicit exception raising or type checks are included due to specific constraints.\n    \"\"\"\n    pass\n\ndef _extract_column(matrix, column_index):\n    \"\"\"Extracts values from the specified column across all matrix rows.\"\"\"\n    return [row[column_index] for row in matrix]\n\ndef _find_maximum(values):\n    \"\"\"Finds the maximum value from a list of numbers.\"\"\"\n    return max(values)\n\ndef max_of_nth(matrix, n):\n    \"\"\"Finds the maximum value in the nth column of a given matrix.\n    This function orchestrates validation, column extraction, and maximum calculation.\n    \"\"\"\n    _validate_input(matrix, n)\n    column_values = _extract_column(matrix, n)\n    return _find_maximum(column_values)"}
{"task_id": "Mbpp/612", "solution": "from typing import List\n\ndef merge(input_list: List[List]) -> List[List]:\n    \"\"\"\n    Transforms a list of two-element sublists into two separate lists,\n    grouping elements by their original position.\n    \"\"\"\n    first_elements = [sublist[0] for sublist in input_list]\n    second_elements = [sublist[1] for sublist in input_list]\n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(tuple_of_tuples: tuple) -> list:\n    \"\"\"\n    Calculates the average value for each inner tuple in a tuple of tuples.\n    Returns the averages as a list of floating-point numbers.\n    \"\"\"\n    averages = []\n    for inner_tuple in tuple_of_tuples:\n        current_sum = sum(inner_tuple)\n        count = len(inner_tuple)\n        average = current_sum / count\n        averages.append(average)\n    return averages"}
{"task_id": "Mbpp/614", "solution": "from typing import List, Tuple, Union\n\ndef cummulative_sum(tuple_list: List[Tuple]) -> Union[int, float]:\n    \"\"\"Calculates the cumulative sum of all numeric values within a list of tuples.\n    Handles empty lists and empty tuples by returning 0 or contributing nothing.\n    \"\"\"\n    if not tuple_list:\n        return 0\n\n    total_sum = 0\n    for sub_tuple in tuple_list:\n        for value in sub_tuple:\n            total_sum += value\n    return total_sum"}
{"task_id": "Mbpp/616", "solution": "def _validate_tuple_lengths(tuple1: tuple, tuple2: tuple) -> None:\n    \"\"\"Validates that input tuples have equal length.\"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Tuples must have the same length.\")\n\ndef _check_zero_divisors(tuple2: tuple) -> None:\n    \"\"\"Checks for zero values in the divisor tuple.\"\"\"\n    if 0 in tuple2:\n        raise ZeroDivisionError(\"Cannot modulo by zero.\")\n\ndef tuple_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise modulo on two tuples of the same length.\n    Raises ValueError for length mismatch or ZeroDivisionError for division by zero.\n    \"\"\"\n    _validate_tuple_lengths(tuple1, tuple2)\n    _check_zero_divisors(tuple2)\n\n    result_list = []\n    for a, b in zip(tuple1, tuple2):\n        result_list.append(a % b)\n\n    return tuple(result_list)"}
{"task_id": "Mbpp/618", "solution": "def div_list(list1: list, list2: list) -> list[float]:\n    \"\"\"\n    Divides two lists element-wise, returning a new list of floating-point results.\n    Assumes input lists are of equal length and contain numeric elements.\n    \"\"\"\n    result_list = []\n    # Iterate through the lists, performing element-wise division.\n    # The design context implies inputs are of equal length.\n    for i in range(len(list1)):\n        # Python's / operator performs float division by default.\n        result_list.append(list1[i] / list2[i])\n    return result_list"}
{"task_id": "Mbpp/620", "solution": "import itertools\n\ndef check_pair_divisibility(a: int, b: int) -> bool:\n    \"\"\"Check if one number divides the other.\"\"\"\n    return a % b == 0 or b % a == 0\n\ndef is_divisible_subset(subset: list[int]) -> bool:\n    \"\"\"Validate if all pairs in subset satisfy divisibility condition.\"\"\"\n    if len(subset) <= 1:\n        return True\n    for pair in itertools.combinations(subset, 2):\n        if not check_pair_divisibility(pair[0], pair[1]):\n            return False\n    return True\n\ndef generate_subsets(numbers: list[int]) -> itertools.chain:\n    \"\"\"Generate all possible subsets of input list.\"\"\"\n    for i in range(len(numbers) + 1):\n        yield from (list(subset_tuple) for subset_tuple in itertools.combinations(numbers, i))\n\ndef largest_subset(numbers: list[int]) -> int:\n    \"\"\"Finds the size of the largest subset where every pair of numbers has the divisibility property.\"\"\"\n    max_size = 0\n    for subset in generate_subsets(numbers):\n        if is_divisible_subset(subset):\n            if len(subset) > max_size:\n                max_size = len(subset)\n    return max_size"}
