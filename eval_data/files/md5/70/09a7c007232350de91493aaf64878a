{"task_id": "Mbpp/448", "solution": "def cal_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the first n Perrin numbers.\n    The Perrin sequence starts with P(0)=3, P(1)=0, P(2)=2, and P(n) = P(n-2) + P(n-3) for n > 2.\n    \"\"\"\n    if n <= 0:\n        return 0\n    if n == 1:\n        return 3\n    if n == 2:\n        return 3 # P(0) + P(1)\n    if n == 3:\n        return 5 # P(0) + P(1) + P(2)\n\n    # Initialize the first three Perrin numbers and their sum\n    p0, p1, p2 = 3, 0, 2\n    current_sum = p0 + p1 + p2\n\n    # Iterate from the 4th Perrin number up to the nth\n    for i in range(3, n):\n        p_next = p0 + p1\n        current_sum += p_next\n        p0 = p1\n        p1 = p2\n        p2 = p_next\n    \n    return current_sum"}
{"task_id": "Mbpp/445", "solution": "def index_multiplication(tuple1, tuple2):\n    \"\"\"\n    Performs index-wise multiplication of elements from two tuples.\n    Each nested tuple's corresponding elements are multiplied together.\n    \"\"\"\n    result = []\n    for i in range(len(tuple1)):\n        # Multiply corresponding nested tuples element-wise\n        multiplied_pair = (tuple1[i][0] * tuple2[i][0], tuple1[i][1] * tuple2[i][1])\n        result.append(multiplied_pair)\n    return tuple(result)"}
{"task_id": "Mbpp/440", "solution": "import string\nimport re\n\nclass WordInfo:\n    \"\"\"Data structure to hold word text, its positions, and original text including punctuation.\"\"\"\n    def __init__(self, text: str, start_pos: int, end_pos: int, original_text: str):\n        self.text = text\n        self.start_pos = start_pos\n        self.end_pos = end_pos\n        self.original_text = original_text\n\nclass PunctuationCleaner:\n    \"\"\"Utility to clean words by removing leading and trailing punctuation.\"\"\"\n    def __init__(self):\n        self.PUNCTUATION_CHARS = string.punctuation\n\n    def clean_word(self, word: str) -> str:\n        return word.strip(self.PUNCTUATION_CHARS)\n\nclass AdverbDatabase:\n    \"\"\"Manages a knowledge base of adverb patterns and exceptions for identification.\"\"\"\n    def __init__(self):\n        self.ADVERB_SUFFIXES = [\"ly\", \"ward\", \"wards\", \"wise\"]\n        self.ADVERB_EXCEPTIONS = {\"friendly\", \"lovely\", \"ugly\", \"likely\", \"elderly\", \"silly\", \"early\", \"daily\", \"jolly\", \"lonely\", \"costly\", \"ghastly\", \"holy\", \"lively\", \"manly\", \"masterly\", \"melancholy\", \"oily\", \"princely\", \"scholarly\", \"shapely\", \"sickly\", \"timely\", \"unruly\", \"wily\", \"comely\"}\n        self.COMMON_ADVERBS = {\"always\", \"often\", \"never\", \"very\", \"quite\", \"here\", \"there\", \"now\", \"then\", \"soon\", \"late\", \"fast\", \"well\", \"hard\", \"far\"}\n\n    def is_adverb(self, word: str) -> bool:\n        \"\"\"Checks if a word is likely an adverb based on internal rules.\"\"\"\n        word_lower = word.lower()\n        if word_lower in self.ADVERB_EXCEPTIONS:\n            return False\n        if word_lower in self.COMMON_ADVERBS:\n            return True\n        for suffix in self.ADVERB_SUFFIXES:\n            if word_lower.endswith(suffix) and len(word_lower) > len(suffix):\n                return True\n        return False\n\nclass AdverbDetector:\n    \"\"\"Core logic to identify adverbs using a cleaner and a database.\"\"\"\n    def __init__(self, cleaner: PunctuationCleaner, database: AdverbDatabase):\n        self.cleaner = cleaner\n        self.database = database\n\n    def is_adverb(self, word_info: WordInfo) -> bool:\n        \"\"\"Determines if the cleaned version of a word_info's text is an adverb.\"\"\"\n        cleaned_word = self.cleaner.clean_word(word_info.text)\n        if not cleaned_word:\n            return False\n        return self.database.is_adverb(cleaned_word)\n\nclass SentenceParser:\n    \"\"\"Parses a sentence into WordInfo objects, tracking original positions.\"\"\"\n    def parse_words(self, sentence: str) -> list[WordInfo]:\n        words_info = []\n        for match in re.finditer(r'\\S+', sentence):\n            original_text = match.group(0)\n            start_pos = match.start()\n            end_pos = match.end()\n            words_info.append(WordInfo(original_text, start_pos, end_pos, original_text))\n        return words_info\n\nclass PositionCalculator:\n    \"\"\"Computes accurate start and end positions for adverbs within the original sentence.\"\"\"\n    def __init__(self, cleaner: PunctuationCleaner):\n        self.cleaner = cleaner\n\n    def calculate_positions(self, word_info: WordInfo, cleaned_adverb_text: str) -> tuple[int, int]:\n        \"\"\"Calculates the precise start and end positions for the cleaned adverb.\"\"\"\n        original_segment = word_info.original_text\n        effective_start_offset = 0\n        for i, char in enumerate(original_segment):\n            if char not in self.cleaner.PUNCTUATION_CHARS:\n                effective_start_offset = i\n                break\n        \n        final_start = word_info.start_pos + effective_start_offset\n        final_end = final_start + len(cleaned_adverb_text)\n        \n        return (final_start, final_end)\n\nclass ResultBuilder:\n    \"\"\"Constructs the final result tuple in the required format.\"\"\"\n    def build_result(self, start: int, end: int, text: str) -> tuple[int, int, str]:\n        return (start, end, text)\n\ndef find_adverb_position(sentence: str) -> tuple:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    Returns a tuple (start_position, end_position, adverb_text) or None if no adverb is found.\n    \"\"\"\n    if not sentence:\n        return None\n\n    punctuation_cleaner = PunctuationCleaner()\n    adverb_database = AdverbDatabase()\n    adverb_detector = AdverbDetector(punctuation_cleaner, adverb_database)\n    sentence_parser = SentenceParser()\n    position_calculator = PositionCalculator(punctuation_cleaner)\n    result_builder = ResultBuilder()\n\n    words_info = sentence_parser.parse_words(sentence)\n\n    for word_info in words_info:\n        if adverb_detector.is_adverb(word_info):\n            cleaned_adverb_text = punctuation_cleaner.clean_word(word_info.text)\n            start_pos, end_pos = position_calculator.calculate_positions(word_info, cleaned_adverb_text)\n            return result_builder.build_result(start_pos, end_pos, cleaned_adverb_text)\n\n    return None"}
