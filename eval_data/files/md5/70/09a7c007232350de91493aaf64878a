{"task_id": "Mbpp/597", "solution": "def find_kth(array1: list, array2: list, k: int) -> int:\n    \"\"\"\n    Finds the kth smallest element from two sorted arrays using binary search.\n    Assumes k is 1-indexed and within the valid range of total elements.\n    \"\"\"\n    m, n = len(array1), len(array2)\n\n    # Ensure array1 is the shorter array to optimize binary search range.\n    if m > n:\n        array1, array2 = array2, array1\n        m, n = n, m\n\n    # Define the search space for partition_a (number of elements taken from array1).\n    low = max(0, k - n)  # Minimum elements to take from array1.\n    high = min(m, k)     # Maximum elements to take from array1.\n\n    while low <= high:\n        partition_a = (low + high) // 2\n        partition_b = k - partition_a\n\n        # Determine the elements around the partition points, using negative/positive infinity for boundary conditions.\n        max_left_a = array1[partition_a - 1] if partition_a > 0 else float('-inf')\n        min_right_a = array1[partition_a] if partition_a < m else float('inf')\n\n        max_left_b = array2[partition_b - 1] if partition_b > 0 else float('-inf')\n        min_right_b = array2[partition_b] if partition_b < n else float('inf')\n\n        # Check if the partition is valid (elements on left <= elements on right).\n        if max_left_a <= min_right_b and max_left_b <= min_right_a:\n            # If valid, the kth element is the maximum of the left partition elements.\n            return max(max_left_a, max_left_b)\n        elif max_left_a > min_right_b:\n            # If max_left_a is too large, we took too many from array1, so adjust high.\n            high = partition_a - 1\n        else: # max_left_b > min_right_a\n            # If max_left_b is too large, we took too few from array1, so adjust low.\n            low = partition_a + 1\n    \n    # This point should not be reached with valid inputs for k, m, and n.\n    return -1"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n):\n    \"\"\"\n    Calculates the sum and average of the first n natural numbers.\n    Uses the mathematical formula n*(n+1)/2 for the sum.\n    \"\"\"\n    total_sum = n * (n + 1) // 2\n    average = total_sum / n\n    return (total_sum, average)"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(number: int) -> bool:\n    \"\"\"\n    Checks if a given number is an Armstrong number.\n    An Armstrong number is a number that is equal to the sum of its own digits each raised to the power of the number of digits.\n    \"\"\"\n    if number < 0:\n        return False\n    \n    num_str = str(number)\n    num_digits = len(num_str)\n    \n    sum_of_powers = 0\n    for digit_char in num_str:\n        digit = int(digit_char)\n        sum_of_powers += digit ** num_digits\n        \n    return sum_of_powers == number"}
{"task_id": "Mbpp/602", "solution": "def first_repeated_char(input_string):\n    \"\"\"\n    Finds the first repeated character in a string by iterating and tracking seen characters.\n    Returns an empty string if no character is repeated.\n    \"\"\"\n    seen_chars = set()\n    for char in input_string:\n        if char in seen_chars:\n            return char\n        seen_chars.add(char)\n    return \"\""}
{"task_id": "Mbpp/604", "solution": "def reverse_words(input_string: str) -> str:\n    \"\"\"\n    Reverses the order of words in a space-separated string.\n    Splits the string, reverses the list of words, then joins them back.\n    \"\"\"\n    words = input_string.split(' ')\n    words.reverse()\n    return ' '.join(words)"}
{"task_id": "Mbpp/603", "solution": "def get_ludic(n: int) -> list[int]:\n    \"\"\"\n    Generates all Ludic numbers less than or equal to a given integer n using a sieve method.\n    \"\"\"\n    if n < 1:\n        return []\n\n    ludic_numbers = []\n    if n >= 1:\n        ludic_numbers.append(1)\n        \n    # The numbers to be sieved, starting from 2 up to n.\n    candidates = list(range(2, n + 1))\n\n    while candidates:\n        # The next Ludic number is the first available candidate.\n        p = candidates[0]\n        ludic_numbers.append(p)\n\n        # Build a new list of candidates by applying the sieve.\n        # Remove every p-th element from the *remaining* candidates list, starting after p itself.\n        new_candidates_after_sieve = []\n        count = 0  # This count tracks the position of numbers in the candidates list for removal logic.\n        for i in range(1, len(candidates)): # Start from index 1, effectively skipping 'p'\n            count += 1\n            if count % p != 0:\n                new_candidates_after_sieve.append(candidates[i])\n        \n        candidates = new_candidates_after_sieve\n    \n    return ludic_numbers"}
