{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(arr: list[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array using binary search.\n    Returns the index or -1 if the target is not found.\n    \"\"\"\n    left, right = 0, len(arr) - 1\n    result = -1\n\n    while left <= right:\n        mid = (left + right) // 2\n        if arr[mid] == target:\n            result = mid\n            right = mid - 1  # Continue searching in the left half for an earlier occurrence\n        elif arr[mid] < target:\n            left = mid + 1\n        else:  # arr[mid] > target\n            right = mid - 1\n            \n    return result"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"\n    Toggles all bits of the number except the first (most significant) and the last (least significant) bit.\n    \"\"\"\n    # Determine the number of bits required to represent the integer.\n    # For 0, bit_length() returns 0. For 1 (binary 1), it returns 1. For 9 (binary 1001), it returns 4.\n    bit_length = number.bit_length()\n\n    # Create a mask where only the bits to be toggled are set to 1.\n    # These are all bits from the second position to the second-to-last position.\n    toggle_mask = 0\n    if bit_length > 2:\n        # If the number has 3 or more bits, there are middle bits to toggle.\n        # Calculate the count of middle bits (excluding MSB and LSB).\n        num_middle_bits = bit_length - 2\n        \n        # Create a sequence of 'num_middle_bits' ones.\n        # Example: if num_middle_bits = 2, this creates binary '11'.\n        ones_sequence = (1 << num_middle_bits) - 1\n        \n        # Shift this sequence left by 1 to align it correctly,\n        # placing the 'ones' in the middle bit positions (from index 1 to bit_length - 2).\n        # Example: '11' shifted left by 1 becomes '110'.\n        toggle_mask = ones_sequence << 1\n    \n    # Toggle the determined middle bits using the XOR operation.\n    # Bits set in the toggle_mask will flip, others will remain unchanged.\n    result = number ^ toggle_mask\n    return result"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(lst: list) -> int:\n    \"\"\"Calculates the sum of products of all possible contiguous sublists.\n    This function utilizes helper functions for clarity and modularity.\n    \"\"\"\n\n    def _generate_sublists(input_list: list) -> list:\n        \"\"\"Generates all contiguous sublists from the input list.\"\"\"\n        sublists = []\n        n = len(input_list)\n        for i in range(n):\n            for j in range(i, n):\n                sublists.append(input_list[i : j + 1])\n        return sublists\n\n    def _calculate_product(sublist: list) -> int:\n        \"\"\"Calculates the product of elements in a single sublist.\"\"\"\n        if not sublist:\n            return 1  # Product of an empty list is 1 (multiplicative identity)\n        product = 1\n        for item in sublist:\n            product *= item\n        return product\n\n    def _sum_products(products_list: list) -> int:\n        \"\"\"Sums all individual sublist products.\"\"\"\n        return sum(products_list)\n\n    all_sublists = _generate_sublists(lst)\n    all_products = []\n    for sublist in all_sublists:\n        all_products.append(_calculate_product(sublist))\n\n    return _sum_products(all_products)"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(array: list[int], target: int) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted array using binary search.\n    The function returns the index where the target value would be inserted to maintain sorted order,\n    ensuring the leftmost position for duplicate values.\n    \"\"\"\n    low = 0\n    high = len(array)\n    ans = len(array)  # Default for when target is larger than all elements or array is empty\n\n    while low < high:\n        mid = low + (high - low) // 2\n        if array[mid] < target:\n            low = mid + 1\n        else:\n            ans = mid\n            high = mid\n            \n    return ans"}
{"task_id": "Mbpp/737", "solution": "import re\n\ndef check_str(input_string: str) -> bool:\n    \"\"\"\n    Checks if the given string starts with a vowel (a, e, i, o, u) using regex.\n    \"\"\"\n    # Pattern to match the start of the string with any vowel (case-insensitive)\n    vowel_pattern = r\"^[aeiou]\"\n    match = re.match(vowel_pattern, input_string, re.IGNORECASE)\n    return bool(match)"}
{"task_id": "Mbpp/739", "solution": "def find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with exactly n digits.\n    Iteratively checks triangular numbers until one with n digits is found.\n    \"\"\"\n    def calculate_triangular_number(k: int) -> int:\n        return k * (k + 1) // 2\n\n    def count_digits(number: int) -> int:\n        # Optimized for positive integers by converting to string.\n        return len(str(number))\n\n    # Based on the design, validation is expected to be handled,\n    # and `n` is assumed to be a positive integer.\n\n    k = 1\n    while True:\n        triangular_value = calculate_triangular_number(k)\n        digit_count = count_digits(triangular_value)\n        if digit_count == n:\n            return k\n        elif digit_count > n:\n            # If the current triangular number has more digits than n,\n            # it means the smallest n-digit number was passed in the previous step\n            # or it's not possible to find an exact match if n is 0 or negative\n            # which is prevented by validation.\n            # However, for this problem, we strictly search for *exactly* n digits.\n            # If digit_count went over, it means the smallest n-digit triangular\n            # number must have been encountered.\n            # This specific condition is only relevant if we were looking for\n            # \"at most n digits\" or similar. For \"exactly n digits\", we just keep searching.\n            pass # Keep searching, as k increases, digit_count will only increase or stay the same.\n        k += 1"}
