{"task_id": "Mbpp/131", "solution": "def is_vowel(char: str) -> bool:\n    \"\"\"Determine if a character is a vowel (a,e,i,o,u case-insensitive, 'y' is not a vowel).\"\"\"\n    return char.lower() in 'aeiou'\n\ndef preserve_case(original: str, replacement: str) -> str:\n    \"\"\"Apply original character's case to replacement character.\"\"\"\n    if original.isupper():\n        return replacement.upper()\n    elif original.islower():\n        return replacement.lower()\n    return replacement\n\ndef extract_vowels(text: str) -> list[tuple[str, int]]:\n    \"\"\"Extract vowels and their positions from input string.\"\"\"\n    vowel_info = []\n    for i, char in enumerate(text):\n        if is_vowel(char):\n            vowel_info.append((char, i))\n    return vowel_info\n\ndef reconstruct_string(original: str, vowel_positions: list[tuple[str, int]], reversed_vowels: list[str]) -> str:\n    \"\"\"Rebuild string with reversed vowels in original positions.\"\"\"\n    result_chars = list(original)\n    for i, (original_char_at_pos, pos) in enumerate(vowel_positions):\n        new_vowel_char = reversed_vowels[i]\n        result_chars[pos] = preserve_case(original_char_at_pos, new_vowel_char)\n    return \"\".join(result_chars)\n\ndef reverse_vowels(input_string: str) -> str:\n    \"\"\"Main entry point that orchestrates vowel reversal process.\"\"\"\n    if not input_string:\n        return \"\"\n\n    vowel_locations = extract_vowels(input_string)\n\n    if not vowel_locations:\n        return input_string\n    \n    vowels_to_reverse_chars = [item[0] for item in vowel_locations]\n    reversed_vowels_chars = vowels_to_reverse_chars[::-1]\n    \n    return reconstruct_string(input_string, vowel_locations, reversed_vowels_chars)"}
