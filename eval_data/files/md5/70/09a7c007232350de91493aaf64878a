{"task_id": "Mbpp/119", "solution": "def search(array: list[int]) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where all other elements appear in pairs.\n    \"\"\"\n    left = 0\n    right = len(array) - 1\n\n    while left < right:\n        mid = (left + right) // 2\n\n        # If mid is an even index\n        if mid % 2 == 0:\n            # Check if current element is same as next element\n            if array[mid] == array[mid + 1]:\n                # Pair found (array[mid], array[mid+1]). The unique element is to the right.\n                left = mid + 2\n            else:\n                # array[mid] is not equal to array[mid+1].\n                # This means array[mid] could be the unique element, or its pair is array[mid-1].\n                # In either case, the unique element is at or before `mid`.\n                right = mid\n        # If mid is an odd index\n        else:\n            # Check if current element is same as previous element\n            if array[mid] == array[mid - 1]:\n                # Pair found (array[mid-1], array[mid]). The unique element is to the right.\n                left = mid + 1\n            else:\n                # array[mid] is not equal to array[mid-1].\n                # This means array[mid] could be the unique element, or its pair is array[mid+1].\n                # In either case, the unique element is at or before `mid`.\n                right = mid\n\n    # When the loop terminates, left == right, and array[left] is the unique element.\n    return array[left]"}
{"task_id": "Mbpp/120", "solution": "def is_numeric(value):\n    \"\"\"Checks if a value is an integer or float.\"\"\"\n    return isinstance(value, (int, float))\n\ndef is_valid_tuple(tup):\n    \"\"\"Checks if a tuple has exactly two numeric elements.\"\"\"\n    return isinstance(tup, tuple) and len(tup) == 2 and is_numeric(tup[0]) and is_numeric(tup[1])\n\ndef validate_tuple_format(tuple_list):\n    \"\"\"Validates the input list to ensure it contains only valid tuples.\"\"\"\n    if not isinstance(tuple_list, list):\n        raise TypeError(\"Input must be a list of tuples.\")\n    if not tuple_list:\n        raise ValueError(\"Input list cannot be empty.\")\n    for tup in tuple_list:\n        if not is_valid_tuple(tup):\n            if not isinstance(tup, tuple):\n                raise TypeError(f\"All elements in the list must be tuples, but found {type(tup)}.\")\n            elif len(tup) != 2:\n                raise ValueError(f\"All tuples must contain exactly two elements, but found {len(tup)} in {tup}.\")\n            else: # Elements are not numeric, based on is_valid_tuple failure\n                raise TypeError(f\"All tuple elements must be numeric, but found non-numeric in {tup}.\")\n\ndef get_absolute_value(value):\n    \"\"\"Returns the absolute value of a number.\"\"\"\n    return abs(value)\n\ndef multiply_tuple_elements(tup):\n    \"\"\"Multiplies the two elements of a tuple.\"\"\"\n    return tup[0] * tup[1]\n\ndef calculate_absolute_product(tup):\n    \"\"\"Calculates the absolute product of elements in a tuple.\"\"\"\n    product = multiply_tuple_elements(tup)\n    return get_absolute_value(product)\n\ndef find_maximum_value(products):\n    \"\"\"Finds the maximum value from a list of numbers.\"\"\"\n    # Pre-validation (validate_tuple_format) ensures products list won't be empty\n    return max(products)\n\ndef max_product_tuple(tuple_list):\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    It validates the input, calculates absolute products for each tuple, and returns the maximum.\n    \"\"\"\n    validate_tuple_format(tuple_list)\n\n    absolute_products = []\n    for tup in tuple_list:\n        absolute_products.append(calculate_absolute_product(tup))\n\n    return find_maximum_value(absolute_products)"}
{"task_id": "Mbpp/123", "solution": "def get_proper_divisors(n: int) -> list[int]:\n    # Finds all positive proper divisors of n (divisors excluding n itself).\n    if n <= 1:\n        return []\n    divisors = [1]\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            divisors.append(i)\n            if i * i != n:\n                divisors.append(n // i)\n    return divisors\n\ndef sum_of_proper_divisors(n: int) -> int:\n    # Calculates the sum of all proper divisors of a number n.\n    return sum(get_proper_divisors(n))\n\ndef is_amicable_pair(a: int, b: int) -> bool:\n    # Checks if two distinct numbers a and b form an amicable pair.\n    if a == b or a <= 0 or b <= 0:\n        return False\n    return sum_of_proper_divisors(a) == b and sum_of_proper_divisors(b) == a\n\ndef find_amicable_numbers(upper_limit: int) -> set[int]:\n    # Identifies all amicable numbers within the specified range [1, upper_limit].\n    amicable_set = set()\n    for n in range(1, upper_limit + 1):\n        sum_div_n = sum_of_proper_divisors(n)\n        # To avoid redundant checks and ensure both numbers are within range.\n        if sum_div_n > n and sum_div_n <= upper_limit:\n            if is_amicable_pair(n, sum_div_n):\n                amicable_set.add(n)\n                amicable_set.add(sum_div_n)\n    return amicable_set\n\ndef amicable_numbers_sum(upper_limit: int) -> int:\n    # Sums all amicable numbers from 1 up to the specified upper_limit.\n    amicable_numbers = find_amicable_numbers(upper_limit)\n    return sum(amicable_numbers)"}
