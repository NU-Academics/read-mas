{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks if a given number is undulating. An undulating number alternates\n    between exactly two different digits throughout its length.\n    \"\"\"\n    s = str(number)\n    n = len(s)\n\n    if n < 3:\n        return False\n\n    # Establish the two alternating digits\n    digit1 = s[0]\n    digit2 = s[1]\n\n    # The two alternating digits must be different\n    if digit1 == digit2:\n        return False\n\n    # Check the alternating pattern for the rest of the digits\n    for i in range(2, n):\n        if i % 2 == 0:  # Even index (0-indexed) should match digit1\n            if s[i] != digit1:\n                return False\n        else:  # Odd index should match digit2\n            if s[i] != digit2:\n                return False\n\n    return True"}
{"task_id": "Mbpp/97", "solution": "import collections\n\ndef frequency_lists(list_of_lists):\n    \"\"\"\n    Count frequency of each element in a flattened list of lists.\n\n    Args:\n        list_of_lists: List of lists containing integer elements\n\n    Returns:\n        Dict mapping each element to its frequency count\n    \"\"\"\n    flattened_list = []\n    for sublist in list_of_lists:\n        flattened_list.extend(sublist)\n    \n    return collections.Counter(flattened_list)"}
{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer.\n    Handles negative inputs by considering their absolute value.\n    \"\"\"\n    if n == 0:\n        return 0\n        \n    # Work with the absolute value to count positive divisors.\n    n = abs(n)\n    \n    count = 0\n    # Iterate from 1 up to n (inclusive) to find all divisors.\n    for i in range(1, n + 1):\n        if n % i == 0:\n            count += 1\n            \n    return count"}
{"task_id": "Mbpp/98", "solution": "from typing import Union\n\ndef multiply_num(numbers: Union[list, tuple]) -> float:\n    \"\"\"\n    Multiplies all numbers in a collection and divides the product by the collection's length.\n    Handles empty collections by returning 0.0 to avoid ZeroDivisionError.\n    \"\"\"\n    if not numbers:\n        return 0.0\n\n    product = 1\n    for num in numbers:\n        product *= num\n\n    return float(product) / len(numbers)"}
{"task_id": "Mbpp/100", "solution": "def reverse_string(s: str) -> str:\n    \"\"\"Reverses the given string.\"\"\"\n    return s[::-1]\n\ndef is_palindrome(n: int) -> bool:\n    \"\"\"Checks if an integer is a palindrome by comparing its string representation with its reverse.\"\"\"\n    s = str(n)\n    return s == reverse_string(s)\n\ndef increment_to_next_palindrome(n: int) -> int:\n    \"\"\"Finds the next smallest palindrome by incrementing from the number greater than n.\"\"\"\n    num = n + 1\n    while True:\n        if is_palindrome(num):\n            return num\n        num += 1\n\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"Finds the next smallest palindrome greater than the specified integer.\"\"\"\n    return increment_to_next_palindrome(n)"}
{"task_id": "Mbpp/101", "solution": "def kth_element(array, k):\n    \"\"\"\n    Finds the kth element in the given array using 1-based indexing.\n    Converts 1-based index to 0-based and accesses the array.\n    \"\"\"\n    # Convert the 1-based index 'k' to a 0-based index.\n    zero_based_index = k - 1\n    # Return the element at the calculated 0-based index.\n    return array[zero_based_index]"}
{"task_id": "Mbpp/99", "solution": "def _convert_to_binary(number: int) -> str:\n    \"\"\"\n    Core binary conversion algorithm for non-negative integers.\n    It builds the binary string by prepending remainders.\n    \"\"\"\n    if number == 0:\n        return \"0\"\n\n    binary_str = \"\"\n    temp_number = number\n    while temp_number > 0:\n        remainder = temp_number % 2\n        binary_str = str(remainder) + binary_str\n        temp_number //= 2\n    return binary_str\n\ndef _remove_leading_zeros(binary_str: str) -> str:\n    \"\"\"\n    Removes leading zeros from a binary string.\n    Special cases \"0\" and strings that become empty after stripping are handled to return \"0\".\n    \"\"\"\n    if binary_str == \"0\":\n        return \"0\"\n    stripped_str = binary_str.lstrip('0')\n    if not stripped_str:\n        return \"0\"\n    return stripped_str\n\ndef decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"\n    Converts a given decimal number to its binary equivalent as a string.\n    Ensures the binary string has no leading zeros, handling the special case of 0.\n    \"\"\"\n    raw_binary = _convert_to_binary(decimal_number)\n    final_binary = _remove_leading_zeros(raw_binary)\n    return final_binary"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(snake_case_string: str) -> str:\n    \"\"\"Converts a snake_case string to CamelCase.\n    It splits the string by underscores, capitalizes each word, and then joins them.\"\"\"\n    words = snake_case_string.split('_')\n    camel_case_words = [word.capitalize() for word in words]\n    return \"\".join(camel_case_words)"}
{"task_id": "Mbpp/105", "solution": "def count(input_list: list) -> int:\n    \"\"\"\n    Counts the number of True boolean values in the given list.\n    Iterates through the list and increments a counter for each True value.\n    \"\"\"\n    true_count = 0\n    for item in input_list:\n        if item is True:\n            true_count += 1\n    return true_count"}
{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number A(n, m) using dynamic programming.\n    A(n, m) is the number of permutations of {1, ..., n} with exactly m ascents.\n    \"\"\"\n    # DP table to store A(i, j) values.\n    # The table size is (n+1) x (n+1) to accommodate indices up to n.\n    dp = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # Base case: A(0, 0) = 1\n    dp[0][0] = 1\n\n    # Fill the DP table using the recurrence relation:\n    # A(i, j) = (j + 1) * A(i-1, j) + (i - j) * A(i-1, j-1)\n    # Valid range for j is 0 <= j < i.\n    for i in range(1, n + 1):\n        for j in range(i): # j ranges from 0 to i-1\n            # Term 1: (j + 1) * A(i-1, j)\n            term1 = (j + 1) * dp[i-1][j]\n            \n            # Term 2: (i - j) * A(i-1, j-1)\n            # A(i-1, j-1) is 0 if j-1 < 0.\n            term2 = 0\n            if j - 1 >= 0:\n                term2 = (i - j) * dp[i-1][j-1]\n            \n            dp[i][j] = term1 + term2\n            \n    # Handle cases where m is outside the standard range for Eulerian numbers (0 <= m < n).\n    # For A(n, m), if m < 0 or m >= n (and not n=0, m=0), the value is 0.\n    # The base case dp[0][0]=1 covers n=0, m=0.\n    if m < 0 or m >= n:\n        if n == 0 and m == 0:\n            return dp[0][0]\n        else:\n            return 0\n    \n    return dp[n][m]"}
