{"task_id": "Mbpp/566", "solution": "def sum_digits(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the digits of a non-negative integer.\n    Assumes input `n` is a non-negative integer.\n    \"\"\"\n    total_sum = 0\n    # Convert the integer to a string to iterate through its digits.\n    # Alternatively, use modulo and division for arithmetic extraction.\n    for digit_char in str(n):\n        total_sum += int(digit_char)\n    return total_sum"}
{"task_id": "Mbpp/563", "solution": "def _validate_quote_pair(start_pos: int, end_pos: int, text_length: int) -> bool:\n    \"\"\"Validates that a quote pair's positions are within text bounds and correctly ordered.\"\"\"\n    return 0 <= start_pos < end_pos < text_length\n\ndef _find_quoted_values(text: str) -> list[tuple[int, int]]:\n    \"\"\"Locates all valid double quote pairs in the input string.\"\"\"\n    positions = []\n    in_quote = False\n    start_index = -1\n    text_length = len(text)\n\n    for i in range(text_length):\n        if text[i] == '\"':\n            if not in_quote:\n                start_index = i\n                in_quote = True\n            else:\n                if _validate_quote_pair(start_index, i, text_length):\n                    positions.append((start_index, i))\n                in_quote = False\n                start_index = -1\n    return positions\n\ndef _extract_content(text: str, positions: list[tuple[int, int]]) -> list[str]:\n    \"\"\"Extracts the content between the given quote positions.\"\"\"\n    extracted_values = []\n    for start_quote_index, end_quote_index in positions:\n        extracted_values.append(text[start_quote_index + 1 : end_quote_index])\n    return extracted_values\n\ndef extract_values(input_string: str) -> list[str]:\n    \"\"\"\n    Extracts all text values enclosed within double quotation marks from an input string.\n    Returns a list of strings, excluding the quotation marks themselves.\n    \"\"\"\n    quote_positions = _find_quoted_values(input_string)\n    if not quote_positions:\n        return []\n    return _extract_content(input_string, quote_positions)"}
{"task_id": "Mbpp/567", "solution": "def issort_list(input_list: list) -> bool:\n    \"\"\"\n    Check if a list is sorted in ascending order.\n    \"\"\"\n    n = len(input_list)\n    if n <= 1:\n        return True\n    \n    for i in range(n - 1):\n        if input_list[i] > input_list[i+1]:\n            return False\n            \n    return True"}
