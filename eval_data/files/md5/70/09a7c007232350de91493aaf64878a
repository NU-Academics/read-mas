{"task_id": "Mbpp/569", "solution": "def sort_sublists(list_of_lists):\n    \"\"\"\n    Sorts each sublist of strings in a given list of lists alphabetically.\n    Returns a new list with sorted sublists, leaving the original input unchanged.\n    \"\"\"\n    sorted_outer_list = []\n    for sublist in list_of_lists:\n        sorted_sublist = sorted(sublist)\n        sorted_outer_list.append(sorted_sublist)\n    return sorted_outer_list"}
{"task_id": "Mbpp/572", "solution": "import collections\n\ndef two_unique_nums(numbers: list) -> list:\n    \"\"\"\n    Remove duplicate numbers from a list, keeping only numbers that appear exactly once.\n    The order of the unique numbers is preserved from the original list.\n    \"\"\"\n    counts = collections.Counter(numbers)\n    result = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n    return result"}
{"task_id": "Mbpp/573", "solution": "def unique_product(input_list):\n    \"\"\"\n    Calculates the product of all unique numbers in the given list.\n    If the list is empty or contains no unique numbers, the product is 1.\n    \"\"\"\n    unique_numbers = set(input_list)\n    product = 1\n    for num in unique_numbers:\n        product *= num\n    return product"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(number: int) -> int:\n    \"\"\"\n    Calculates the last digit of the factorial of a given non-negative integer.\n    It computes the factorial and then extracts its last digit.\n    \"\"\"\n    if number < 0:\n        # Factorial is typically defined for non-negative integers.\n        # As per instructions, no exceptions or explicit error handling for invalid input type/range.\n        # Returning 0 as a default for scenarios where negative input might be unexpected.\n        return 0\n    elif number == 0:\n        return 1  # 0! = 1\n\n    factorial_val = 1\n    for i in range(1, number + 1):\n        factorial_val *= i\n        # To prevent potential overflow for very large numbers and focus on the last digit,\n        # we can optimize by only keeping track of the last few digits.\n        # For this problem, keeping track of the full number is fine given Python's arbitrary precision integers.\n        \n    return factorial_val % 10"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list, sub_list):\n    \"\"\"\n    Checks if `sub_list` is a contiguous sublist of `main_list`.\n    Returns True if `sub_list` is empty, False if `main_list` is empty and `sub_list` is not.\n    \"\"\"\n    len_main = len(main_list)\n    len_sub = len(sub_list)\n\n    if len_sub == 0:\n        return True\n    if len_main == 0:\n        return False\n    if len_sub > len_main:\n        return False\n\n    for i in range(len_main - len_sub + 1):\n        match = True\n        for j in range(len_sub):\n            if main_list[i + j] != sub_list[j]:\n                match = False\n                break\n        if match:\n            return True\n\n    return False"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1, list2, list3):\n    \"\"\"\n    Interleaves elements from three lists of the same length into a single flat list.\n    Raises ValueError if input lists do not have equal lengths.\n    \"\"\"\n    if not (len(list1) == len(list2) == len(list3)):\n        raise ValueError(\"Lists must have equal length to be interleaved.\")\n\n    result = []\n    list_length = len(list1)\n\n    for i in range(list_length):\n        result.append(list1[i])\n        result.append(list2[i])\n        result.append(list3[i])\n\n    return result"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Finds elements that are present in one tuple but not in both, preserving their original order.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n\n    dissimilar_elements = []\n\n    # Add elements unique to tuple1, preserving their order\n    for item in tuple1:\n        if item not in set2:\n            dissimilar_elements.append(item)\n\n    # Add elements unique to tuple2, preserving their order\n    for item in tuple2:\n        if item not in set1:\n            dissimilar_elements.append(item)\n\n    return tuple(dissimilar_elements)"}
{"task_id": "Mbpp/581", "solution": "import math\n\ndef surface_Area(base_edge: float, height: float) -> float:\n    \"\"\"\n    Calculate the surface area of a square pyramid.\n    This includes the base area and the lateral surface area.\n    \"\"\"\n    base_area = base_edge ** 2\n    \n    # Calculate the slant height using Pythagorean theorem\n    slant_height = math.sqrt(height**2 + (base_edge/2)**2)\n    \n    # Lateral surface area is 4 times the area of one triangular face\n    # Area of one triangular face = 0.5 * base_edge * slant_height\n    lateral_surface_area = 2 * base_edge * slant_height # 4 * (0.5 * base_edge * slant_height)\n    \n    total_surface_area = base_area + lateral_surface_area\n    \n    return total_surface_area"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Main function to filter even elements from nested tuples.\n    It recursively processes elements, preserving even integers and tuple structure.\n    \"\"\"\n    def _is_even(element: any) -> bool:\n        \"\"\"Checks if an element is an even integer.\"\"\"\n        return isinstance(element, int) and element % 2 == 0\n\n    def _process_element(element: any) -> any:\n        \"\"\"\n        Processes individual elements, handling integers and nested tuples.\n        Returns the processed element or None if filtered out.\n        \"\"\"\n        if isinstance(element, int):\n            if _is_even(element):\n                return element\n            else:\n                return None\n        elif isinstance(element, tuple):\n            # Recursive call to the outer extract_even\n            processed_sub_tuple = extract_even(element)\n            # Include if the processed sub-tuple is not empty\n            if processed_sub_tuple:\n                return processed_sub_tuple\n            else:\n                return None\n        else:\n            # Preserve elements that are not integers or tuples\n            return element\n\n    processed_elements = []\n    for item in input_tuple:\n        processed_item = _process_element(item)\n        if processed_item is not None:\n            processed_elements.append(processed_item)\n    return tuple(processed_elements)"}
