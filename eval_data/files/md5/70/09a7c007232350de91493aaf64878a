{"task_id": "Mbpp/619", "solution": "def _extract_numeric_chars(input_string: str) -> str:\n    \"\"\"Extracts all numeric characters from the input string while preserving their order.\"\"\"\n    numeric_chars = []\n    for char in input_string:\n        if char.isdigit():\n            numeric_chars.append(char)\n    return \"\".join(numeric_chars)\n\ndef _extract_non_numeric_chars(input_string: str) -> str:\n    \"\"\"Extracts all non-numeric characters from the input string while preserving their order.\"\"\"\n    non_numeric_chars = []\n    for char in input_string:\n        if not char.isdigit():\n            non_numeric_chars.append(char)\n    return \"\".join(non_numeric_chars)\n\ndef move_num(input_string: str) -> str:\n    \"\"\"Moves all numeric characters to the end of the given string, preserving relative order.\"\"\"\n    non_numeric_part = _extract_non_numeric_chars(input_string)\n    numeric_part = _extract_numeric_chars(input_string)\n    return non_numeric_part + numeric_part"}
{"task_id": "Mbpp/630", "solution": "def get_coordinates(coordinate_tuple):\n    \"\"\"\n    Extract all adjacent coordinates in a 3x3 grid pattern, including the center.\n    Coordinates are returned as a list of lists in row-major order (x-first, then y).\n    \"\"\"\n    x_center, y_center = coordinate_tuple\n    adjacent_coordinates = []\n\n    for dx in [-1, 0, 1]:\n        for dy in [-1, 0, 1]:\n            current_x = x_center + dx\n            current_y = y_center + dy\n            adjacent_coordinates.append([current_x, current_y])\n\n    return adjacent_coordinates"}
