{"task_id": "Mbpp/724", "solution": "def power_base_sum(base, power):\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    It orchestrates power calculation and digit summation.\n    \"\"\"\n\n    def calculate_power(b, p):\n        \"\"\"Calculates base raised to the power.\"\"\"\n        return b ** p\n\n    def extract_digits(number):\n        \"\"\"Extracts individual digits from a number.\"\"\"\n        return [int(d) for d in str(number)]\n\n    def sum_digits(digits_list):\n        \"\"\"Sums a list of digits.\"\"\"\n        return sum(digits_list)\n\n    powered_number = calculate_power(base, power)\n    digits = extract_digits(powered_number)\n    total_sum = sum_digits(digits)\n    return total_sum"}
{"task_id": "Mbpp/721", "solution": "def maxAverageOfPath(matrix: list[list[int]]) -> float:\n    \"\"\"\n    Calculates the maximum average cost of a path from the top-left to the bottom-right cell\n    in a square matrix, moving only right or down.\n    The path length is fixed to 2*N-1 cells, so maximizing average is equivalent to maximizing total cost.\n    \"\"\"\n    n = len(matrix)\n    if n == 0:\n        return 0.0\n\n    # dp[r][c] will store the maximum total cost to reach cell (r, c)\n    dp = [[0.0] * n for _ in range(n)]\n\n    # Initialize the top-left cell\n    dp[0][0] = float(matrix[0][0])\n\n    # Initialize the first row (only move right)\n    for c in range(1, n):\n        dp[0][c] = dp[0][c-1] + float(matrix[0][c])\n\n    # Initialize the first column (only move down)\n    for r in range(1, n):\n        dp[r][0] = dp[r-1][0] + float(matrix[r][0])\n\n    # Fill the rest of the dp table\n    for r in range(1, n):\n        for c in range(1, n):\n            # To reach (r, c), we must come from (r-1, c) or (r, c-1)\n            # We choose the path that yields the maximum sum\n            dp[r][c] = float(matrix[r][c]) + max(dp[r-1][c], dp[r][c-1])\n\n    # The maximum total cost to reach the bottom-right cell\n    max_total_cost = dp[n-1][n-1]\n\n    # The number of cells in any valid path from (0,0) to (N-1,N-1) is always (N-1) + (N-1) + 1 = 2*N - 1\n    path_length = (2 * n) - 1\n\n    # Calculate the maximum average\n    return max_total_cost / path_length"}
{"task_id": "Mbpp/725", "solution": "def extract_quotation(input_string: str) -> list[str]:\n    \"\"\"\n    Extracts values enclosed between double quotation marks from the given string.\n    \"\"\"\n    extracted_values = []\n    in_quote = False\n    start_index = -1\n\n    for i, char in enumerate(input_string):\n        if char == '\"':\n            if in_quote:\n                # Found a closing quote\n                extracted_values.append(input_string[start_index:i])\n                in_quote = False\n                start_index = -1\n            else:\n                # Found an opening quote\n                in_quote = True\n                start_index = i + 1\n    return extracted_values"}
