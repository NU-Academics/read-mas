{"task_id": "Mbpp/583", "solution": "def _compute_factorial(n: int) -> int:\n    \"\"\"Computes the factorial of a non-negative integer.\"\"\"\n    if n == 0:\n        return 1\n    result = 1\n    for i in range(1, n + 1):\n        result *= i\n    return result\n\ndef _validate_input(n: int) -> bool:\n    \"\"\"Validates that input parameter n is a non-negative integer.\"\"\"\n    return n >= 0\n\ndef _compute_catalan_formula(n: int) -> int:\n    \"\"\"Applies the Catalan number formula C(n) = (2n)! / ((n+1)! * n!).\"\"\"\n    numerator = _compute_factorial(2 * n)\n    denominator = _compute_factorial(n + 1) * _compute_factorial(n)\n    return numerator // denominator\n\ndef catalan_number(n: int) -> int:\n    \"\"\"\n    Computes the nth Catalan number using the formula C(n) = (2n)! / ((n+1)! * n!).\n    Returns 0 for invalid (negative) input, as exceptions are forbidden.\n    \"\"\"\n    if not _validate_input(n):\n        return 0\n    return _compute_catalan_formula(n)"}
{"task_id": "Mbpp/588", "solution": "def big_diff(input_list):\n    \"\"\"\n    Finds the difference between the largest and smallest value in a given list.\n    Assumes the input list is not empty and contains numeric values.\n    \"\"\"\n    max_val = max(input_list)\n    min_val = min(input_list)\n    return max_val - min_val"}
{"task_id": "Mbpp/586", "solution": "def split_Arr(input_list: list, n: int) -> list:\n    \"\"\"\n    Splits a list at the nth element and moves the first part to the end.\n    Handles edge cases where n is out of bounds by returning the original list.\n    \"\"\"\n    list_length = len(input_list)\n\n    if n <= 0 or n >= list_length:\n        return input_list[:] # Return a shallow copy for consistency, as per design context (returning new list)\n\n    first_part = input_list[:n]\n    second_part = input_list[n:]\n\n    return second_part + first_part"}
{"task_id": "Mbpp/585", "solution": "def expensive_items(dataset, n):\n    \"\"\"\n    Finds the n most expensive items in a given dataset.\n    Assumes each item is a dictionary with a 'price' key.\n    \"\"\"\n    if not dataset:\n        return []\n\n    # Sort items by price in descending order\n    sorted_items = sorted(dataset, key=lambda item: item['price'], reverse=True)\n\n    # Return the top n items\n    return sorted_items[:n]"}
{"task_id": "Mbpp/590", "solution": "import math\n\ndef polar_rect(radius, angle):\n    \"\"\"\n    Converts polar coordinates (radius, angle) to rectangular coordinates (x, y)\n    and complex number representation.\n    \"\"\"\n    x = radius * math.cos(angle)\n    y = radius * math.sin(angle)\n    \n    rectangular_coords = (x, y)\n    complex_number = complex(x, y)\n    \n    return (rectangular_coords, complex_number)"}
{"task_id": "Mbpp/591", "solution": "def swap_List(input_list):\n    \"\"\"Interchanges the first and last elements in a list, returning a new list without modifying the original.\"\"\"\n    if len(input_list) <= 1:\n        return list(input_list)\n\n    new_list = list(input_list) # Create a copy to avoid modifying the original list.\n    new_list[0], new_list[-1] = new_list[-1], new_list[0]\n\n    return new_list"}
{"task_id": "Mbpp/589", "solution": "import math\n\ndef _get_square_root(n: int) -> int:\n    \"\"\"Calculates the integer square root of a non-negative number.\"\"\"\n    if n < 0:\n        return 0 # Perfect squares are non-negative; return 0 for consistency if negative is passed.\n    return int(math.sqrt(n))\n\ndef _is_perfect_square(n: int) -> bool:\n    \"\"\"Checks if a given non-negative integer is a perfect square.\"\"\"\n    if n < 0:\n        return False\n    root = _get_square_root(n)\n    return root * root == n\n\ndef _validate_inputs(start: float, end: float) -> tuple[int, int]:\n    \"\"\"Validates and normalizes the input range to non-negative integers.\"\"\"\n    min_val = int(start)\n    max_val = int(end)\n\n    if min_val < 0:\n        min_val = 0 # Perfect squares are non-negative.\n\n    if min_val > max_val:\n        min_val, max_val = max_val, min_val # Ensure min_val is always less than or equal to max_val.\n\n    return (min_val, max_val)\n\ndef _find_perfect_squares(min_val: int, max_val: int) -> list[int]:\n    \"\"\"Iterates through the range to find perfect squares using _is_perfect_square.\"\"\"\n    squares = []\n    for n in range(min_val, max_val + 1):\n        if _is_perfect_square(n):\n            squares.append(n)\n    return squares\n\ndef perfect_squares(start: float, end: float) -> list[int]:\n    \"\"\"\n    Finds perfect squares between two given numbers (inclusive range).\n    The input range is normalized to non-negative integers.\n    \"\"\"\n    validated_min, validated_max = _validate_inputs(start, end)\n    return _find_perfect_squares(validated_min, validated_max)"}
{"task_id": "Mbpp/596", "solution": "import sys\n\ndef tuple_size(tuple_input: tuple) -> int:\n    \"\"\"\n    Calculates the size in bytes of the given tuple using sys.getsizeof().\n    \"\"\"\n    return sys.getsizeof(tuple_input)"}
{"task_id": "Mbpp/592", "solution": "import math\n\ndef _calculate_binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient C(n, k).\"\"\"\n    return math.comb(n, k)\n\ndef _calculate_consecutive_products(n: int) -> list:\n    \"\"\"Calculates products of consecutive binomial coefficients C(n, k) * C(n, k+1).\"\"\"\n    products = []\n    for k in range(n):\n        coeff1 = _calculate_binomial_coefficient(n, k)\n        coeff2 = _calculate_binomial_coefficient(n, k + 1)\n        products.append(coeff1 * coeff2)\n    return products\n\ndef _sum_products(products: list) -> int:\n    \"\"\"Sums a list of numbers.\"\"\"\n    return sum(products)\n\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Finds the sum of the product of consecutive binomial coefficients for a given n.\n    This calculates sum_{k=0}^{n-1} C(n, k) * C(n, k+1).\n    \"\"\"\n    consecutive_products = _calculate_consecutive_products(n)\n    total_sum = _sum_products(consecutive_products)\n    return total_sum"}
{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip_string: str) -> str:\n    \"\"\"\n    Removes leading zeroes from each octet of an IP address string.\n    Expects a valid IP address format, splits it into octets, and processes each one.\n    \"\"\"\n    octets = ip_string.split('.')\n    processed_octets = []\n    for octet in octets:\n        # Convert to int and then back to str to remove leading zeroes\n        processed_octets.append(str(int(octet)))\n    return '.'.join(processed_octets)"}
{"task_id": "Mbpp/594", "solution": "import math\nfrom typing import List, Optional\n\ndef is_even(number: int) -> bool:\n    \"\"\"Checks if a given number is even.\"\"\"\n    return number % 2 == 0\n\ndef is_odd(number: int) -> bool:\n    \"\"\"Checks if a given number is odd.\"\"\"\n    return number % 2 != 0\n\ndef find_first_even(numbers: List[int]) -> Optional[int]:\n    \"\"\"Finds the first even number in a list.\"\"\"\n    for number in numbers:\n        if is_even(number):\n            return number\n    return None\n\ndef find_first_odd(numbers: List[int]) -> Optional[int]:\n    \"\"\"Finds the first odd number in a list.\"\"\"\n    for number in numbers:\n        if is_odd(number):\n            return number\n    return None\n\ndef calculate_absolute_difference(first_even: int, first_odd: int) -> int:\n    \"\"\"Calculates the absolute difference between two numbers.\"\"\"\n    return abs(first_even - first_odd)\n\ndef diff_even_odd(input_list: List[int]) -> int:\n    \"\"\"\n    Calculates the absolute difference between the first even and first odd number in a list.\n    Raises ValueError if either an even or an odd number is not found.\n    \"\"\"\n    first_even = find_first_even(input_list)\n    first_odd = find_first_odd(input_list)\n\n    if first_even is None:\n        raise ValueError(\"No even number found in the list.\")\n    if first_odd is None:\n        raise ValueError(\"No odd number found in the list.\")\n\n    return calculate_absolute_difference(first_even, first_odd)"}
