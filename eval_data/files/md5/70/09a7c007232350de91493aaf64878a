{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"\n    Count substrings where sum of digits equals substring length.\n\n    Args:\n        s (str): Input string containing numeric characters\n\n    Returns:\n        int: Count of qualifying substrings\n    \"\"\"\n    count = 0\n    n = len(s)\n\n    for i in range(n):\n        current_sum = 0\n        for j in range(i, n):\n            # Calculate digit sum for the current substring s[i:j+1]\n            current_sum += int(s[j])\n            # Check if digit sum equals substring length (j - i + 1)\n            if current_sum == (j - i + 1):\n                count += 1\n    return count"}
{"task_id": "Mbpp/63", "solution": "from typing import List, Tuple, Union\n\ndef max_difference(tuple_list: List[Tuple[Union[int, float], Union[int, float]]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the maximum absolute difference between elements within pairs in a list of tuples.\n    Returns 0 if the input list is empty or contains no pairs.\n    \"\"\"\n    max_diff: Union[int, float] = 0\n\n    for item1, item2 in tuple_list:\n        current_diff = abs(item2 - item1)\n        if current_diff > max_diff:\n            max_diff = current_diff\n            \n    return max_diff"}
