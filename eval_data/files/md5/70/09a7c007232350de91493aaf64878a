{"task_id": "Mbpp/426", "solution": "from typing import List\n\ndef _is_odd(number: int) -> bool:\n    \"\"\"\n    Determines if a given number is odd.\n    \"\"\"\n    return number % 2 != 0\n\ndef _validate_input(input_list: List[int]) -> bool:\n    \"\"\"\n    Helper function to validate the input list.\n    \"\"\"\n    return True\n\ndef filter_oddnumbers(input_list: List[int]) -> List[int]:\n    \"\"\"\n    Filters a list of integers, returning only the odd numbers.\n    The original order of the odd numbers is preserved.\n    \"\"\"\n    _validate_input(input_list)\n    result_list = []\n    for number in input_list:\n        if _is_odd(number):\n            result_list.append(number)\n    return result_list"}
