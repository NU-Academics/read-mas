{"task_id": "Mbpp/478", "solution": "def remove_lowercase(input_string: str) -> str:\n    \"\"\"Removes all contiguous lowercase letter substrings from the input string.\"\"\"\n    if not input_string:\n        return \"\"\n\n    lowercase_ranges = _identify_lowercase_substrings(input_string)\n    return _build_output_string(input_string, lowercase_ranges)\n\ndef _identify_lowercase_substrings(input_string: str) -> list[tuple[int, int]]:\n    \"\"\"Identifies start and end positions of all lowercase substrings.\"\"\"\n    ranges = []\n    start_index = -1\n\n    for i, char in enumerate(input_string):\n        if char.islower():\n            if start_index == -1:\n                start_index = i\n        else:\n            if start_index != -1:\n                ranges.append((start_index, i))\n                start_index = -1\n\n    if start_index != -1:\n        ranges.append((start_index, len(input_string)))\n\n    return ranges\n\ndef _build_output_string(input_string: str, lowercase_ranges: list[tuple[int, int]]) -> str:\n    \"\"\"Constructs the output string, excluding characters within the specified ranges.\"\"\"\n    result_chars = []\n    current_pos = 0\n\n    for start, end in lowercase_ranges:\n        result_chars.append(input_string[current_pos:start])\n        current_pos = end\n\n    result_chars.append(input_string[current_pos:])\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/554", "solution": "def Split(input_list: list) -> list:\n    \"\"\"\n    Filters a list of integers, returning only the odd numbers while preserving their order.\n    \"\"\"\n    def _is_odd(number: int) -> bool:\n        \"\"\"\n        Checks if an integer is odd.\n        \"\"\"\n        return number % 2 != 0\n\n    odd_numbers = []\n    for number in input_list:\n        if _is_odd(number):\n            odd_numbers.append(number)\n    return odd_numbers"}
{"task_id": "Mbpp/555", "solution": "def sum_of_natural_numbers(n: int) -> int:\n    \"\"\"Calculates the sum of the first n natural numbers.\"\"\"\n    return n * (n + 1) // 2\n\ndef sum_of_cubes(n: int) -> int:\n    \"\"\"Calculates the sum of cubes of the first n natural numbers.\"\"\"\n    sum_nat = sum_of_natural_numbers(n)\n    return sum_nat * sum_nat\n\ndef difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    cubes_sum = sum_of_cubes(n)\n    naturals_sum = sum_of_natural_numbers(n)\n    return cubes_sum - naturals_sum"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string):\n    \"\"\"\n    Toggles the case of all alphabetic characters in a string.\n    Uppercase characters become lowercase, and lowercase become uppercase.\n    \"\"\"\n    toggled_chars = []\n    for char in input_string:\n        if char.isupper():\n            toggled_chars.append(char.lower())\n        elif char.islower():\n            toggled_chars.append(char.upper())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(array: list, size: int) -> int:\n    \"\"\"\n    Counts the number of pairs in an array whose XOR sum is odd.\n    An XOR sum is odd if one number is even and the other is odd.\n    \"\"\"\n    odd_count = 0\n    even_count = 0\n    for num in array:\n        if num % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n    \n    # An XOR value is odd if and only if one operand is odd and the other is even.\n    # So, we need to count pairs (odd, even).\n    return odd_count * even_count"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(list_of_lists):\n    \"\"\"\n    Find the length of the longest sublist in a list of lists.\n    \"\"\"\n    max_length = 0\n    for sublist in list_of_lists:\n        if len(sublist) > max_length:\n            max_length = len(sublist)\n    return max_length"}
{"task_id": "Mbpp/558", "solution": "def extract_digits(number: int) -> list[int]:\n    \"\"\"Extract digits from integer, returning list from least to most significant.\"\"\"\n    if number == 0:\n        return [0]\n    return [int(d) for d in str(abs(number))[::-1]]\n\ndef calculate_differences(digits1: list[int], digits2: list[int]) -> list[int]:\n    \"\"\"Calculate absolute differences between corresponding positions.\"\"\"\n    max_len = max(len(digits1), len(digits2))\n    differences = []\n    for i in range(max_len):\n        digit1_val = digits1[i] if i < len(digits1) else 0\n        digit2_val = digits2[i] if i < len(digits2) else 0\n        differences.append(abs(digit1_val - digit2_val))\n    return differences\n\ndef sum_differences(differences: list[int]) -> int:\n    \"\"\"Sum all difference values.\"\"\"\n    return sum(differences)\n\ndef digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"Calculate sum of absolute differences between corresponding digits.\"\"\"\n    digits1 = extract_digits(num1)\n    digits2 = extract_digits(num2)\n    \n    per_digit_differences = calculate_differences(digits1, digits2)\n    total_sum = sum_differences(per_digit_differences)\n    \n    return total_sum"}
{"task_id": "Mbpp/560", "solution": "def union_elements(tuple1, tuple2):\n    \"\"\"\n    Finds the union of elements from two tuples and returns them in sorted order as a new tuple.\n    Duplicates are handled by including each unique element only once.\n    \"\"\"\n    combined_set = set(tuple1) | set(tuple2)\n    sorted_list = sorted(list(combined_set))\n    return tuple(sorted_list)"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr: list, n: int) -> int:\n    \"\"\"\n    Find the sum of the largest contiguous subarray using Kadane's algorithm.\n    It iterates through the array, keeping track of the maximum sum found so far and the current sum ending at the current position.\n    \"\"\"\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, n):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/564", "solution": "def count_Pairs(lst: list, length: int) -> int:\n    \"\"\"\n    Counts the number of possible unordered pairs where both elements are unequal.\n    Assumes `length` matches the actual length of `lst`.\n    \"\"\"\n    count = 0\n    n = len(lst)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if lst[i] != lst[j]:\n                count += 1\n    return count"}
