{"task_id": "Mbpp/777", "solution": "import collections\n\ndef find_sum(input_list):\n    \"\"\"\n    Calculate sum of elements that appear exactly once in the input list.\n    Handles empty lists by returning 0.\n    \"\"\"\n    if not input_list:\n        return 0\n\n    counts = collections.Counter(input_list)\n    total_sum = 0\n    for element, count in counts.items():\n        if count == 1:\n            total_sum += element\n    return total_sum"}
{"task_id": "Mbpp/781", "solution": "def _validate_input(n: int) -> bool:\n    \"\"\"Validate input is positive integer.\"\"\"\n    # Based on the instruction \"Do NOT add isinstance() checks or raise exceptions for edge cases\",\n    # we assume 'n' will always be a positive integer as per the problem description and type hint.\n    return True\n\ndef _calculate_divisor_count(n: int) -> int:\n    \"\"\"Calculate total number of divisors.\"\"\"\n    count = 0\n    # Iterate up to the square root of n to find divisors efficiently.\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            if i * i == n:\n                count += 1  # If i is a perfect square root, it's one divisor.\n            else:\n                count += 2  # i and n/i are two distinct divisors.\n        i += 1\n    return count\n\ndef _is_count_even(count: int) -> bool:\n    \"\"\"Check if count is even.\"\"\"\n    return count % 2 == 0\n\ndef count_divisors(n: int) -> bool:\n    \"\"\"Check whether the count of divisors is even.\"\"\"\n    _validate_input(n)\n    divisor_count = _calculate_divisor_count(n)\n    return _is_count_even(divisor_count)"}
{"task_id": "Mbpp/780", "solution": "def _validate_input(tuple_list):\n    \"\"\"\n    Validates input tuple list structure and content.\n    Returns True as per constraints to skip validation logic.\n    \"\"\"\n    return True\n\ndef _add_tuples(tuple1, tuple2):\n    \"\"\"\n    Performs element-wise addition of two tuples.\n    Returns a new tuple with the sums.\n    \"\"\"\n    return (tuple1[0] + tuple2[0], tuple1[1] + tuple2[1])\n\ndef _generate_pairs(tuple_list):\n    \"\"\"\n    Generates all pairwise combinations excluding self-pairs,\n    including both directional combinations.\n    \"\"\"\n    pairs = []\n    n = len(tuple_list)\n    for i in range(n):\n        for j in range(n):\n            if i != j:\n                pairs.append((tuple_list[i], tuple_list[j]))\n    return pairs\n\ndef find_combinations(tuple_list):\n    \"\"\"\n    Main entry point for tuple combination sum calculation.\n    Orchestrates validation, pair generation, and sum calculation.\n    \"\"\"\n    _validate_input(tuple_list) # As per constraints, this will not perform actual validation.\n\n    pairs_to_sum = _generate_pairs(tuple_list)\n\n    result_sums = []\n    for t1, t2 in pairs_to_sum:\n        result_sums.append(_add_tuples(t1, t2))\n\n    return result_sums"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list) -> list:\n    \"\"\"\n    Packs consecutive duplicate elements of a list into sublists.\n    Groups identical adjacent elements into a single sublist.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = []\n    current_group = []\n\n    for element in input_list:\n        if not current_group or element != current_group[-1]:\n            # If there's an existing group, add it to the result before starting a new one.\n            if current_group:\n                result.append(current_group)\n            # Start a new group with the current element.\n            current_group = [element]\n        else:\n            # The current element is a duplicate of the last element in the current group.\n            current_group.append(element)\n\n    # After the loop, append the last collected group to the result.\n    if current_group:\n        result.append(current_group)\n\n    return result"}
{"task_id": "Mbpp/782", "solution": "def _generate_subarrays(array):\n    \"\"\"Generates all contiguous subarrays from the input array.\"\"\"\n    subarrays = []\n    n = len(array)\n    for i in range(n):\n        for j in range(i, n):\n            subarrays.append(array[i : j + 1])\n    return subarrays\n\ndef _is_odd_length(subarray):\n    \"\"\"Checks if a subarray has an odd length.\"\"\"\n    return len(subarray) % 2 == 1\n\ndef _calculate_subarray_sum(subarray):\n    \"\"\"Calculates the sum of elements in a single subarray.\"\"\"\n    return sum(subarray)\n\ndef odd_length_sum(array):\n    \"\"\"\n    Calculates the sum of all elements in odd length subarrays of the given array.\n    \"\"\"\n    total_sum = 0\n    all_subarrays = _generate_subarrays(array)\n\n    for subarray in all_subarrays:\n        if _is_odd_length(subarray):\n            total_sum += _calculate_subarray_sum(subarray)\n    \n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "import math\n\ndef mul_even_odd(numbers):\n    \"\"\"\n    Finds the product of the first even and first odd numbers in a list.\n    Returns 0 if either an even or odd number is not found.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        \n        if first_even is not None and first_odd is not None:\n            break\n            \n    if first_even is None or first_odd is None:\n        # Per design, no explicit error handling, return 0 for simplicity if not found.\n        # However, the example `mul_even_odd([1,3,5,7,4,1,6,8])==4` implies that\n        # if both are found, their product is returned. If one is missing, \n        # the problem statement doesn't specify, but often implies 0 or an error.\n        # Given the example output, and the prompt's `no isinstance() checks or raise exceptions`,\n        # the most straightforward interpretation for missing numbers is that the problem\n        # expects a valid pair for calculation, and if not, the default behavior (e.g. 0)\n        # or problem constraints not explicitly stated here might apply.\n        # For the given example, both exist. If the problem implies no calculation if one is missing,\n        # then returning 0 is a common safe default.\n        return 0 # This line is a deviation from the design document's error handling \n                 # (raising exceptions) due to the specific instruction \"no isinstance() checks or raise exceptions\".\n                 # If the problem statement implies a product must always be returned, 0 is a common default.\n\n    return first_even * first_odd"}
