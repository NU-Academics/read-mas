{"task_id": "Mbpp/106", "solution": "def add_lists(input_list: list, input_tuple: tuple) -> tuple:\n    \"\"\"\n    Appends elements from a list to a tuple, returning a new tuple.\n    Raises TypeError if inputs are not a list and a tuple.\n    \"\"\"\n    if not isinstance(input_list, list) or not isinstance(input_tuple, tuple):\n        raise TypeError(\"Expected list and tuple\")\n    return input_tuple + tuple(input_list)"}
{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary_string: str, rotations: int) -> int:\n    \"\"\"\n    Counts the number of odd decimal values obtained by rotating a binary string.\n    Each rotation converts the binary string to decimal, and checks if it's odd.\n    \"\"\"\n    def _rotate_left(s: str) -> str:\n        \"\"\"Performs a left rotation on the string.\"\"\"\n        if not s:\n            return s\n        return s[1:] + s[0]\n\n    def _binary_to_decimal(s: str) -> int:\n        \"\"\"Converts a binary string to its decimal equivalent.\"\"\"\n        return int(s, 2)\n\n    def _is_odd(n: int) -> bool:\n        \"\"\"Checks if a number is odd.\"\"\"\n        return n % 2 != 0\n\n    odd_count = 0\n    current_string = binary_string\n\n    for _ in range(rotations):\n        decimal_value = _binary_to_decimal(current_string)\n        if _is_odd(decimal_value):\n            odd_count += 1\n        current_string = _rotate_left(current_string)\n\n    return odd_count"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_lists: list) -> set:\n    \"\"\"\n    Finds elements common to all sublists within a given list of nested lists.\n    Initializes with the first sublist's elements and iteratively intersects with subsequent sublists.\n    \"\"\"\n    if not nested_lists:\n        return set()\n\n    # Initialize the set of common elements with the first sublist\n    common_elements = set(nested_lists[0])\n\n    # Iterate through the rest of the sublists and find the intersection\n    for sublist in nested_lists[1:]:\n        common_elements = common_elements.intersection(set(sublist))\n\n    return common_elements"}
{"task_id": "Mbpp/113", "solution": "def check_integer(input_string: str) -> bool:\n    \"\"\"\n    Check if a string represents an integer.\n\n    Args:\n        input_string (str): The string to validate\n\n    Returns:\n        bool: True if string represents valid integer, False otherwise\n    \"\"\"\n    s = input_string.strip()  # Handle whitespace\n    if not s:\n        return False\n\n    start_index = 0\n    if s[0] == '-' or s[0] == '+':\n        start_index = 1\n        if len(s) == 1:  # Only a sign is not an integer\n            return False\n\n    for i in range(start_index, len(s)):\n        if not s[i].isdigit():\n            return False\n\n    return True"}
{"task_id": "Mbpp/116", "solution": "def _validate_input(input_tuple: tuple) -> bool:\n    \"\"\"Validates that all elements in the tuple are positive integers.\n    Raises ValueError if any element is not a positive integer.\"\"\"\n    for element in input_tuple:\n        if not isinstance(element, int) or element <= 0:\n            raise ValueError(\"Tuple must contain only positive integers.\")\n    return True\n\ndef _concatenate_digits(input_tuple: tuple) -> int:\n    \"\"\"Concatenates the digits of numbers in the tuple into a single integer.\n    Returns 0 if the input tuple is empty.\"\"\"\n    if not input_tuple:\n        return 0\n    return int(\"\".join(str(x) for x in input_tuple))\n\ndef tuple_to_int(input_tuple: tuple) -> int:\n    \"\"\"Converts a tuple of positive integers into a single integer by concatenation.\"\"\"\n    _validate_input(input_tuple)\n    return _concatenate_digits(input_tuple)"}
