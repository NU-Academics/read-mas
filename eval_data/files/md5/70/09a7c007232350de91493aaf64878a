{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number, representing the number of ways to partition a set of n elements.\n    It builds Bell's triangle to compute the value efficiently.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Initialize a 2D array to store Bell's triangle values.\n    # triangle[i][j] stores the j-th number in the i-th row of the triangle.\n    triangle = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # The first element of the 0-th row is 1 (B(0)).\n    triangle[0][0] = 1\n\n    # Build Bell's triangle row by row.\n    for i in range(1, n + 1):\n        # The first element of the current row is the last element of the previous row.\n        triangle[i][0] = triangle[i-1][i-1]\n        for j in range(1, i + 1):\n            # Each subsequent element is the sum of the element to its left\n            # in the same row and the element above it in the previous row.\n            triangle[i][j] = triangle[i][j-1] + triangle[i-1][j-1]\n\n    # The nth Bell number is the first element of the nth row of the triangle.\n    return triangle[n][0]"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array: list) -> bool:\n    \"\"\"Checks if the given array is monotonic (either non-decreasing or non-increasing).\"\"\"\n\n    def _is_non_decreasing(arr: list) -> bool:\n        \"\"\"Checks if the array is non-decreasing.\"\"\"\n        for i in range(1, len(arr)):\n            if arr[i] < arr[i-1]:\n                return False\n        return True\n\n    def _is_non_increasing(arr: list) -> bool:\n        \"\"\"Checks if the array is non-increasing.\"\"\"\n        for i in range(1, len(arr)):\n            if arr[i] > arr[i-1]:\n                return False\n        return True\n\n    if len(array) <= 1:\n        return True\n\n    return _is_non_decreasing(array) or _is_non_increasing(array)"}
{"task_id": "Mbpp/70", "solution": "def get_equal(tuples: list) -> bool:\n    \"\"\"\n    Determines whether all tuples in the given list have equal length.\n\n    Args:\n        tuples (list): List of tuples to validate\n\n    Returns:\n        bool: True if all tuples have equal length, False otherwise\n\n    Raises:\n        TypeError: If input contains non-tuple elements\n    \"\"\"\n    if not isinstance(tuples, list):\n        raise TypeError(\"Invalid input: Expected a list of tuples.\")\n\n    if not tuples:\n        return True\n\n    # Get the length of the first tuple and validate its type\n    if not isinstance(tuples[0], tuple):\n        raise TypeError(\"Invalid input: Expected a list of tuples.\")\n    \n    first_tuple_length = len(tuples[0])\n\n    # Compare lengths of remaining tuples\n    for t in tuples[1:]:\n        if not isinstance(t, tuple):\n            raise TypeError(\"Invalid input: Expected a list of tuples.\")\n        if len(t) != first_tuple_length:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list, sublist):\n    \"\"\"Checks if a sublist is a contiguous sequence within a main list.\"\"\"\n    # An empty sublist is considered present in any list.\n    if not sublist:\n        return True\n\n    # A non-empty sublist cannot be found in an empty main list or if it's longer.\n    if not main_list or len(sublist) > len(main_list):\n        return False\n\n    len_main = len(main_list)\n    len_sub = len(sublist)\n\n    # Iterate through all possible starting positions for the sublist in the main list.\n    for i in range(len_main - len_sub + 1):\n        match = True\n        # Compare elements of the sublist with the corresponding segment of the main list.\n        for j in range(len_sub):\n            if main_list[i + j] != sublist[j]:\n                match = False\n                break  # Mismatch found, move to the next starting position.\n\n        if match:\n            return True  # A full contiguous match was found.\n\n    # No contiguous sublist was found after checking all positions.\n    return False"}
{"task_id": "Mbpp/71", "solution": "def _calculate_gap(gap: int) -> int:\n    \"\"\"Calculates the next gap value for the Comb Sort algorithm.\"\"\"\n    shrink_factor = 1.3\n    gap = int(gap / shrink_factor)\n    return max(1, gap)\n\ndef comb_sort(elements: list) -> list:\n    \"\"\"\n    Sorts a list of elements using the Comb Sort algorithm in ascending order.\n    Returns a new sorted list, preserving the original.\n    \"\"\"\n    n = len(elements)\n    result = elements.copy()\n\n    if n <= 1:\n        return result\n\n    gap = n\n    swapped = True\n\n    while gap > 1 or swapped:\n        gap = _calculate_gap(gap)\n        swapped = False\n        for i in range(n - gap):\n            if result[i] > result[i + gap]:\n                result[i], result[i + gap] = result[i + gap], result[i]\n                swapped = True\n    return result"}
