{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculate the sum of series (n - 2*i) from i=0 to n//2 where terms > 0.\n    The series continues as long as terms are positive.\n    \"\"\"\n    total_sum = 0\n    for i in range(n // 2 + 1):\n        term = n - 2 * i\n        if term > 0:\n            total_sum += term\n        else:\n            break  # Stop if term becomes non-positive\n    return total_sum"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string):\n    \"\"\"\n    Counts characters in a string that match their alphabet position (case-insensitive).\n    Position 0 corresponds to 'a', 1 to 'b', etc.\n    \"\"\"\n    count = 0\n    for i, char_val in enumerate(input_string):\n        char_lower = char_val.lower()\n        if char_lower.isalpha():\n            alphabet_pos = ord(char_lower) - ord('a')\n            if alphabet_pos == i:\n                count += 1\n    return count"}
{"task_id": "Mbpp/160", "solution": "def extended_gcd(a, b):\n    # Implements the Extended Euclidean Algorithm to find GCD and Bezout coefficients.\n    # Returns (gcd, x, y) such that ax + by = gcd(a, b).\n    if b == 0:\n        return (a, 1, 0)\n    else:\n        gcd, x1, y1 = extended_gcd(b, a % b)\n        x = y1\n        y = x1 - (a // b) * y1\n        return (gcd, x, y)\n\ndef find_solution(a, b, n):\n    # Handle the special case where both a and b are zero.\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    # Calculate gcd and Bezout coefficients (s, t) for a and b.\n    gcd, s, t = extended_gcd(a, b)\n\n    # Ensure gcd is positive.\n    if gcd < 0:\n        gcd, s, t = -gcd, -s, -t\n\n    # If n is not divisible by gcd, no integer solution exists.\n    if n % gcd != 0:\n        return None\n\n    # Calculate a particular solution (x0, y0).\n    k_scale = n // gcd\n    x0 = s * k_scale\n    y0 = t * k_scale\n\n    # Canonicalize the solution (x, y) to satisfy common conventions (e.g., smallest non-negative x).\n    # The general solution is x = x0 + k * (b/gcd) and y = y0 - k * (a/gcd).\n    # We find k_shift to get x into the range [0, abs(b/gcd) - 1].\n    \n    # b_prime is the coefficient for k in the general solution for x.\n    # It cannot be zero here because `a=0, b=0` case and `b=0` cases are handled implicitly by `extended_gcd`\n    # and previous conditions.\n    b_prime = b // gcd\n    \n    # Calculate the target x value within the desired range.\n    # Python's `%` operator for `x % m` (where `m > 0`) returns a result in `[0, m-1]`.\n    x_target = x0 % abs(b_prime)\n    \n    # Calculate the k_shift required to move x0 to x_target.\n    # This k_shift will be an integer.\n    k_shift = (x_target - x0) // b_prime\n    \n    # Apply k_shift to find the canonical solution (x, y).\n    x = x0 + k_shift * b_prime\n    y = y0 - k_shift * (a // gcd)\n\n    return (x, y)"}
{"task_id": "Mbpp/166", "solution": "from typing import List\n\ndef find_even_pair(numbers: List[int]) -> int:\n    \"\"\"\n    Counts the number of pairs of integers in a list that XOR to an even number.\n    This occurs when both integers in a pair have the same parity (both even or both odd).\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for num in numbers:\n        if num % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # Number of pairs of even numbers\n    pairs_from_even = (even_count * (even_count - 1)) // 2\n    # Number of pairs of odd numbers\n    pairs_from_odd = (odd_count * (odd_count - 1)) // 2\n\n    return pairs_from_even + pairs_from_odd"}
{"task_id": "Mbpp/168", "solution": "def _validate_inputs(input_list, target_number):\n    \"\"\"\n    Validates input parameters.\n    Per requirements, it returns True without performing specific type or structural checks.\n    \"\"\"\n    return True\n\ndef _count_occurrences(input_list, target_number):\n    \"\"\"\n    Counts the occurrences of the target number in the input list.\n    It iterates through the list and increments a counter for each match.\n    \"\"\"\n    count = 0\n    for item in input_list:\n        if item == target_number:\n            count += 1\n    return count\n\ndef frequency(input_list, target_number):\n    \"\"\"\n    Counts the number of occurrences of a target number in a given list.\n    It delegates validation and counting to helper functions.\n    \"\"\"\n    # Validate inputs using the helper function as per design.\n    # _validate_inputs will always return True based on the constraints.\n    if not _validate_inputs(input_list, target_number):\n        # This branch is effectively unreachable under current constraints.\n        pass\n\n    # Perform the actual counting using the helper function.\n    return _count_occurrences(input_list, target_number)"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Handles n=0 by returning 1 as the smallest power of 2.\n    \"\"\"\n    if n == 0:\n        return 1\n    \n    # Check if n is already a power of 2.\n    # A positive integer is a power of 2 if it has only one bit set in its binary representation.\n    # This can be efficiently checked using the bitwise AND operation: (n & (n - 1)) == 0.\n    if (n & (n - 1)) == 0:\n        return n\n    \n    # If n is not a power of 2, find the next one.\n    # The bit_length() method returns the number of bits required to represent an integer in binary,\n    # excluding the sign and leading zeros. For a positive integer n that is not a power of 2,\n    # 2 raised to the power of n.bit_length() gives the smallest power of 2 strictly greater than n.\n    return 1 << n.bit_length()"}
