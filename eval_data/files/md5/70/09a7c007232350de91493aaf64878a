{"task_id": "Mbpp/804", "solution": "from typing import List, Union\n\ndef is_product_even(numbers: List[Union[int, float]]) -> bool:\n    \"\"\"Checks if the product of numbers in a list is even.\n    Handles empty lists, zeros, negatives, and floating-point numbers.\"\"\"\n\n    # If the list is empty, the product is implicitly 1 (multiplicative identity), which is odd.\n    # However, the design context's sequence diagram for an empty list results in True.\n    if not numbers:\n        return True\n\n    # If any number in the list is 0, the product will be 0, which is even.\n    for num in numbers:\n        if num == 0:\n            return True\n\n    # Calculate the product of all numbers.\n    product: Union[int, float] = 1\n    for num in numbers:\n        product *= num\n\n    # A number is even if it is divisible by 2 with no remainder.\n    # This check works for both integers and floating-point numbers that are effectively integers (e.g., 4.0 % 2 == 0).\n    return product % 2 == 0"}
{"task_id": "Mbpp/808", "solution": "def _search_element(tuple_param: tuple, k: int) -> bool:\n    \"\"\"\n    Internal helper function to perform a sequential search for k in tuple_param.\n    Returns True if k is found, False otherwise.\n    \"\"\"\n    for item in tuple_param:\n        if item == k:\n            return True\n    return False\n\ndef check_K(tuple_param: tuple, k: int) -> bool:\n    \"\"\"\n    Checks if the given tuple_param contains the integer k.\n    Delegates the search logic to a private helper function.\n    \"\"\"\n    return _search_element(tuple_param, k)"}
