{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(array, position):\n    \"\"\"\n    Reverse elements of array from index 0 up to position (exclusive).\n    \"\"\"\n    # Create a new list to avoid modifying the original array in place\n    # Slice the prefix to be reversed and the suffix to remain unchanged\n    prefix = array[:position]\n    suffix = array[position:]\n\n    # Reverse the prefix\n    reversed_prefix = prefix[::-1]\n\n    # Combine the reversed prefix with the unchanged suffix\n    return reversed_prefix + suffix"}
{"task_id": "Mbpp/643", "solution": "def text_match_wordz_middle(input_string: str) -> bool:\n    \"\"\"\n    Checks if the input string contains 'z' in the middle of any word.\n    'z' is considered in the middle if it's not the first or last character of a word.\n    \"\"\"\n\n    def _is_word_boundary(char: str) -> bool:\n        \"\"\"Determines if a character is a word boundary (non-alphanumeric).\"\"\"\n        return not char.isalnum()\n\n    def _find_words(text: str) -> list[tuple[int, int]]:\n        \"\"\"Extracts word segments (start and end indices) from the input string.\"\"\"\n        words_indices = []\n        word_start = -1\n\n        for i, char in enumerate(text):\n            if not _is_word_boundary(char):\n                if word_start == -1:\n                    word_start = i\n            else: # char is a boundary\n                if word_start != -1: # A word just ended\n                    words_indices.append((word_start, i))\n                    word_start = -1\n        \n        # Handle case where the string ends with a word\n        if word_start != -1:\n            words_indices.append((word_start, len(text)))\n            \n        return words_indices\n\n    def _has_middle_z(word: str) -> bool:\n        \"\"\"Checks if a word contains 'z' at any position except the first or last.\"\"\"\n        # A word must have at least 3 characters for 'z' to be in the middle.\n        if len(word) < 3:\n            return False\n        \n        # Check positions from index 1 to len(word) - 2 (inclusive)\n        for i in range(1, len(word) - 1):\n            if word[i] == 'z':\n                return True\n        return False\n\n    if not input_string:\n        return False\n\n    word_segments = _find_words(input_string)\n\n    for start, end in word_segments:\n        word = input_string[start:end]\n        if _has_middle_z(word):\n            return True\n            \n    return False"}
