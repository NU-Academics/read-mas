{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a given range that are divisible by every digit they contain.\n    Excludes numbers containing the digit 0.\n    \"\"\"\n\n    def _extract_digits(number: int) -> list[int]:\n        \"\"\"Extracts individual digits from a number.\"\"\"\n        return [int(d) for d in str(number)]\n\n    def _contains_zero(number: int) -> bool:\n        \"\"\"Checks if a number contains the digit zero.\"\"\"\n        return '0' in str(number)\n\n    def _is_divisible_by_digits(number: int) -> bool:\n        \"\"\"Checks if a number is divisible by all its digits.\"\"\"\n        digits = _extract_digits(number)\n        for digit in digits:\n            if number % digit != 0:\n                return False\n        return True\n\n    result = []\n    for num in range(startnum, endnum + 1):\n        if not _contains_zero(num):\n            if _is_divisible_by_digits(num):\n                result.append(num)\n    return result"}
{"task_id": "Mbpp/749", "solution": "from typing import List\n\ndef sort_numeric_strings(string_list: List[str]) -> List[int]:\n    \"\"\"\n    Sort a list of string representations of numbers numerically.\n\n    Args:\n        string_list: List of strings representing numbers\n\n    Returns:\n        List of integers sorted in ascending numerical order\n    \"\"\"\n    return sorted([int(s) for s in string_list])"}
{"task_id": "Mbpp/748", "solution": "def _is_capital_letter(char: str) -> bool:\n    \"\"\"Check if character is a capital letter.\"\"\"\n    return 'A' <= char <= 'Z'\n\ndef _is_lowercase_or_digit(char: str) -> bool:\n    \"\"\"Check if character is lowercase letter or digit.\"\"\"\n    return ('a' <= char <= 'z') or ('0' <= char <= '9')\n\ndef _should_insert_space(prev_char: str, curr_char: str) -> bool:\n    \"\"\"Determine if space should be inserted before current character.\"\"\"\n    return _is_lowercase_or_digit(prev_char) and _is_capital_letter(curr_char)\n\ndef capital_words_spaces(input_string: str) -> str:\n    \"\"\"\n    Insert spaces before capital letters that follow lowercase letters or digits.\n    \"\"\"\n    if not input_string:\n        return \"\"\n\n    result_chars = [input_string[0]]\n    for i in range(1, len(input_string)):\n        prev_char = input_string[i-1]\n        curr_char = input_string[i]\n        if _should_insert_space(prev_char, curr_char):\n            result_chars.append(' ')\n        result_chars.append(curr_char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(array: list[int]) -> bool:\n    \"\"\"\n    Checks if the given array represents a min heap.\n    Iterates through parent nodes and validates the min-heap property against their children.\n    \"\"\"\n    n = len(array)\n\n    if n <= 1:\n        return True\n\n    # Iterate only up to the last parent node.\n    # The last parent node's index is (n-2) // 2 for 0-indexed arrays.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check against left child\n        if left_child_idx < n and array[i] > array[left_child_idx]:\n            return False\n\n        # Check against right child\n        if right_child_idx < n and array[i] > array[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds elements that appear in all three lists at the same index.\n    Returns a list of these common elements.\n    \"\"\"\n    common_elements = []\n    min_length = min(len(l1), len(l2), len(l3))\n\n    for i in range(min_length):\n        if l1[i] == l2[i] and l2[i] == l3[i]:\n            common_elements.append(l1[i])\n            \n    return common_elements"}
{"task_id": "Mbpp/753", "solution": "def min_k(tuple_list, k):\n    \"\"\"\n    Sorts a list of tuples by their second element and returns the first k smallest records.\n    Handles cases where k is greater than the list length by returning the entire sorted list.\n    \"\"\"\n    sorted_list = sorted(tuple_list, key=lambda x: x[1])\n    return sorted_list[:k]"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n):\n    \"\"\"\n    Calculates the nth Jacobsthal number using an iterative approach.\n    Handles base cases J(0)=0 and J(1)=1, then applies the recurrence J(n) = J(n-1) + 2*J(n-2).\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    a, b = 0, 1  # J(0) and J(1)\n    for _ in range(2, n + 1):\n        a, b = b, b + 2 * a\n    return b"}
{"task_id": "Mbpp/758", "solution": "def unique_sublists(input_list: list) -> dict:\n    \"\"\"\n    Counts occurrences of sublists within a list by converting them to tuples.\n    Returns a dictionary mapping each unique tuple to its frequency count.\n    \"\"\"\n    counts = {}\n    for sublist in input_list:\n        sublist_as_tuple = tuple(sublist)\n        counts[sublist_as_tuple] = counts.get(sublist_as_tuple, 0) + 1\n    return counts"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(string_list):\n    \"\"\"\n    Counts pairs of reverse strings in the given string list.\n    Handles palindromes by not counting them as pairs.\n    \"\"\"\n    count = 0\n    n = len(string_list)\n    processed = [False] * n # To keep track of strings already part of a counted pair\n\n    def is_palindrome(s):\n        \"\"\"Checks if a string is its own reverse (palindrome).\"\"\"\n        return s == s[::-1]\n\n    def is_reverse_pair(s1, s2):\n        \"\"\"Checks if two strings are exact reverses of each other.\"\"\"\n        return s1 == s2[::-1]\n\n    for i in range(n):\n        if processed[i]:\n            continue # Skip if already processed\n\n        current_string = string_list[i]\n        \n        # Palindromes are explicitly not counted as reverse pairs of themselves\n        if is_palindrome(current_string):\n            continue\n\n        for j in range(i + 1, n):\n            if processed[j]:\n                continue # Skip if already processed\n\n            if is_reverse_pair(current_string, string_list[j]):\n                count += 1\n                processed[i] = True\n                processed[j] = True\n                break # Move to the next unprocessed string after finding a pair\n\n    return count"}
{"task_id": "Mbpp/755", "solution": "from typing import List, Union\n\ndef second_smallest(numbers: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Finds the second smallest unique number in a list of numbers.\n    Assumes the input list contains at least two unique numbers.\n    \"\"\"\n    unique_numbers = list(set(numbers))\n    unique_numbers.sort()\n    return unique_numbers[1]"}
{"task_id": "Mbpp/759", "solution": "def is_decimal(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string represents a positive decimal number with exactly two decimal places.\n    The string must be in the format 'digits.dd', where 'digits' can be any length.\n    \"\"\"\n    if '.' not in input_string:\n        return False\n\n    parts = input_string.split('.')\n\n    # A valid decimal with one '.' should split into exactly two parts.\n    if len(parts) != 2:\n        return False\n\n    integer_part, decimal_part = parts[0], parts[1]\n\n    # Validate the integer part: must consist only of digits and not be empty.\n    if not integer_part or not integer_part.isdigit():\n        return False\n\n    # Validate the decimal part: must have exactly two digits and consist only of digits.\n    if len(decimal_part) != 2 or not decimal_part.isdigit():\n        return False\n\n    return True"}
{"task_id": "Mbpp/760", "solution": "def unique_Element(numbers: list) -> bool:\n    \"\"\"\n    Check whether a list of numbers contains only one distinct element.\n\n    Args:\n        numbers (list): List of numbers to check\n\n    Returns:\n        bool: True if only one distinct element, False otherwise\n    \"\"\"\n    # Handle empty list: returns True per business rules from design.\n    if not numbers:\n        return True\n\n    # Count distinct elements using set.\n    distinct_elements = set(numbers)\n\n    # Return True if only one distinct element.\n    return len(distinct_elements) == 1"}
