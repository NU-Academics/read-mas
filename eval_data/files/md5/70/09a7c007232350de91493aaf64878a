{"task_id": "Mbpp/286", "solution": "def _kadane_standard(arr: list) -> int:\n    \"\"\"Applies Kadane's algorithm to find the maximum sum of a contiguous subarray in a single array.\"\"\"\n    if not arr:\n        return 0\n\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, len(arr)):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n    return max_so_far\n\ndef _calculate_array_sum(arr: list) -> int:\n    \"\"\"Calculates the total sum of all elements in an array.\"\"\"\n    return sum(arr)\n\ndef max_sub_array_sum_repeated(array: list, k: int, length: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in a modified array formed by repeating the given array k times.\n    The 'length' parameter is not used in this calculation as per standard problem interpretation.\n    \"\"\"\n    if not array:\n        return 0\n\n    if k == 1:\n        return _kadane_standard(array)\n\n    total_array_sum = _calculate_array_sum(array)\n    \n    # Calculate the maximum subarray sum for the array repeated twice.\n    # This covers scenarios where the maximum subarray spans across the boundary of two repetitions.\n    max_sum_double_array = _kadane_standard(array + array)\n\n    if total_array_sum > 0:\n        # If the total sum of the original array is positive,\n        # we can potentially maximize the sum by including the full array sum (k-2) times.\n        return max_sum_double_array + (k - 2) * total_array_sum\n    else:\n        # If the total sum is non-positive, repeating the array more than twice\n        # will not increase the maximum subarray sum.\n        # The maximum will be found within the first two repetitions.\n        return max_sum_double_array"}
{"task_id": "Mbpp/290", "solution": "from typing import List, Tuple\n\ndef max_length(list_of_lists: List[List]) -> Tuple[int, List]:\n    \"\"\"\n    Find the list with maximum length in a list of lists.\n\n    Args:\n        list_of_lists: List containing sublists\n\n    Returns:\n        Tuple containing (max_length, max_length_list)\n    \"\"\"\n    max_len = 0\n    max_list = []\n\n    for sublist in list_of_lists:\n        current_len = len(sublist)\n        if current_len > max_len:\n            max_len = current_len\n            max_list = sublist\n            \n    return (max_len, max_list)"}
{"task_id": "Mbpp/294", "solution": "from typing import Union\n\ndef _is_numeric(element) -> bool:\n    \"\"\"Checks if an element is an integer or a float.\"\"\"\n    return isinstance(element, (int, float))\n\ndef _filter_numeric_values(input_list: list) -> list:\n    \"\"\"Extracts all numeric values from the input list.\"\"\"\n    numeric_collection = []\n    for element in input_list:\n        if _is_numeric(element):\n            numeric_collection.append(element)\n    return numeric_collection\n\ndef _find_maximum(numeric_list: list) -> Union[int, float]:\n    \"\"\"Calculates the maximum value from a list of numbers.\"\"\"\n    if not numeric_list:\n        # Based on the prompt's assertion, empty lists are not a primary concern\n        # for this specific problem, but a robust solution would handle it.\n        # For this problem, we're assuming there will be at least one numeric value.\n        pass # The prompt does not specify error handling or return for empty numeric list.\n    return max(numeric_list)\n\ndef max_val(input_list: list) -> Union[int, float]:\n    \"\"\"\n    Finds the maximum numeric value in a given heterogeneous list.\n    It filters out non-numeric elements before finding the maximum.\n    \"\"\"\n    numeric_elements = _filter_numeric_values(input_list)\n    maximum_value = _find_maximum(numeric_elements)\n    return maximum_value"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr: list[int]) -> int:\n    \"\"\"\n    Count the number of inversions in an array.\n\n    Args:\n        arr: List of integers\n\n    Returns:\n        Integer count of inversions\n    \"\"\"\n    n = len(arr)\n    inv_count = 0\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            if arr[i] > arr[j]:\n                inv_count += 1\n    return inv_count"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(nested_list: list) -> list:\n    \"\"\"\n    Flattens a nested list structure into a single-level list.\n    It processes elements recursively to handle arbitrary levels of nesting.\n    \"\"\"\n    flattened = []\n    for item in nested_list:\n        if isinstance(item, list):\n            flattened.extend(flatten_list(item))\n        else:\n            flattened.append(item)\n    return flattened"}
{"task_id": "Mbpp/299", "solution": "import collections\n\ndef max_aggregate(tuple_list):\n    \"\"\"\n    Calculates the maximum aggregate value from a list of name-value tuples.\n    Aggregates values for each unique name and returns the name with the highest total.\n    \"\"\"\n    aggregated_data = collections.defaultdict(int)\n    for name, value in tuple_list:\n        aggregated_data[name] += value\n\n    if not aggregated_data:\n        # Return a default value if no aggregates were found (e.g., empty input list).\n        return (\"\", 0)\n\n    max_name = None\n    max_value = -float('inf')\n\n    for name, total_value in aggregated_data.items():\n        if total_value > max_value:\n            max_value = total_value\n            max_name = name\n\n    return (max_name, max_value)"}
{"task_id": "Mbpp/305", "solution": "def start_withp(input_list: list) -> tuple:\n    \"\"\"Return two words starting with 'p' from input list.\"\"\"\n    all_words = []\n    for item in input_list:\n        all_words.extend(item.split(' '))\n\n    p_words = []\n    for word in all_words:\n        if word.lower().startswith('p'):\n            p_words.append(word)\n        if len(p_words) == 2:\n            break\n            \n    return tuple(p_words[:2])"}
