{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(array, length, i, k):\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from the prefix of the array (up to index i)\n    and including the element at index k, where k > i.\n    \"\"\"\n    # dp[x] stores the maximum sum of an increasing subsequence\n    # ending at array[x], considering elements from array[0...x].\n    # This dp array is built only for the prefix elements up to index i.\n    dp = [0] * (i + 1)\n\n    # Calculate dp values for the prefix array[0...i]\n    for current_idx in range(i + 1):\n        current_val = array[current_idx]\n        # Initialize the maximum sum ending at current_idx with the element itself.\n        dp[current_idx] = current_val\n\n        # Iterate through previous elements in the prefix (0 to current_idx - 1)\n        # to find potential predecessors for an increasing subsequence.\n        for prev_idx in range(current_idx):\n            if current_val > array[prev_idx]:\n                # If current_val can extend a subsequence ending at prev_idx,\n                # update dp[current_idx] if the new sum is greater.\n                dp[current_idx] = max(dp[current_idx], dp[prev_idx] + current_val)\n\n    # After computing dp for all elements up to index i,\n    # find the maximum sum among those subsequences that can precede array[k].\n    max_sum_before_k = 0\n    target_val_k = array[k]\n\n    # Iterate through the computed dp sums for the prefix elements.\n    for j in range(i + 1):\n        # Only consider subsequences from the prefix (ending at array[j])\n        # if array[j] is strictly less than array[k] to maintain the increasing property\n        # when array[k] is added.\n        if array[j] < target_val_k:\n            max_sum_before_k = max(max_sum_before_k, dp[j])\n\n    # The final maximum sum is the largest sum found before array[k] plus array[k] itself.\n    return max_sum_before_k + target_val_k"}
{"task_id": "Mbpp/311", "solution": "def _find_leftmost_unset_bit_position(number: int) -> int:\n    \"\"\"Identifies the position of the leftmost unset bit.\n    Scans from the most significant bit downwards, returning the 0-indexed position.\n    \"\"\"\n    if number == 0:\n        return 0  # For 0, the leftmost unset bit is at position 0.\n\n    # Iterate from the highest relevant bit down to 0.\n    # number.bit_length() gives the number of bits excluding leading zeros.\n    for i in range(number.bit_length() - 1, -1, -1):\n        if (number >> i) & 1 == 0:\n            return i\n    \n    # If all bits up to bit_length - 1 are set (e.g., number is 2^k - 1),\n    # the leftmost unset bit is at position number.bit_length().\n    return number.bit_length()\n\ndef _set_bit_at_position(number: int, position: int) -> int:\n    \"\"\"Sets a specific bit at the given 0-indexed position.\"\"\"\n    return number | (1 << position)\n\ndef set_left_most_unset_bit(number: int) -> int:\n    \"\"\"Sets the leftmost unset bit in an integer's binary representation.\"\"\"\n    position_to_set = _find_leftmost_unset_bit_position(number)\n    return _set_bit_at_position(number, position_to_set)"}
{"task_id": "Mbpp/312", "solution": "import math\n\ndef volume_cone(radius: float, height: float) -> float:\n    \"\"\"\n    Calculate the volume of a cone using the formula V = (1/3) * \u03c0 * r\u00b2 * h.\n    \"\"\"\n    volume = (1/3) * math.pi * (radius ** 2) * height\n    return volume"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"Finds the highest power of 2 that is less than or equal to n.\n    This is achieved by iteratively multiplying by 2 until the next power exceeds n.\"\"\"\n    power = 1\n    while power * 2 <= n:\n        power *= 2\n    return power"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    \"\"\"\n    Calculates the n'th Lucas number iteratively.\n    The sequence is L(0) = 2, L(1) = 1, and L(n) = L(n-1) + L(n-2) for n >= 2.\n    \"\"\"\n    if n == 0:\n        return 2\n    elif n == 1:\n        return 1\n    \n    # Initialize L(0) and L(1)\n    a, b = 2, 1 \n    # Iterate from L(2) up to L(n)\n    for _ in range(2, n + 1):\n        a, b = b, a + b\n    return b"}
