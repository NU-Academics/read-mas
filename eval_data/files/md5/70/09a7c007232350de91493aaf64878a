{"task_id": "Mbpp/623", "solution": "from typing import List\n\ndef _validate_input_list(numbers_list: List[int]) -> bool:\n    \"\"\"Validates that the input list contains only positive integers.\"\"\"\n    if not isinstance(numbers_list, list):\n        raise ValueError(\"Input 'numbers_list' must be a list.\")\n    for num in numbers_list:\n        if not isinstance(num, int) or num <= 0:\n            raise ValueError(\"All elements in 'numbers_list' must be positive integers.\")\n    return True\n\ndef _validate_power_parameter(n: int) -> bool:\n    \"\"\"Validates that the power parameter 'n' is a positive integer.\"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Power parameter 'n' must be a positive integer.\")\n    return True\n\ndef nth_nums(numbers_list: List[int], n: int) -> List[int]:\n    \"\"\"\n    Computes the n-th power of each number in a list.\n    Validates inputs and returns a new list with computed powers.\n    \"\"\"\n    _validate_input_list(numbers_list)\n    _validate_power_parameter(n)\n\n    result_list = []\n    for num in numbers_list:\n        result_list.append(pow(num, n))\n    return result_list"}
