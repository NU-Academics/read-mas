ed on the number of digits n.\n    \"\"\"\n    if n == 1:\n        return 1  # Only '1' starts and ends with 1 (it's a 1-digit number)\n    \n    # Numbers starting with 1: 1 followed by (n-1) digits. The remaining (n-1) digits can be anything (0-9).\n    # So, 1 * 10^(n-1) possibilities.\n    # Numbers ending with 1: (n-1) digits followed by 1. The first digit cannot be 0, so 9 choices for the first digit,\n    # and 10 choices for each of the remaining (n-2) digits.\n    # So, 9 * 10^(n-2) possibilities.\n    \n    # Numbers starting AND ending with 1: 1 followed by (n-2) digits, then 1.\n    # The middle (n-2) digits can be anything (0-9).\n    # So, 1 * 10^(n-2) possibilities.\n    \n    # Using inclusion-exclusion principle:\n    # Count = (Starts with 1) + (Ends with 1) - (Starts with 1 AND Ends with 1)\n    \n    starts_with_one = 10**(n - 1)\n    ends_with_one = 9 * (10**(n - 2)) # First digit cannot be 0, and last is fixed as 1\n    starts_and_ends_with_one = 10**(n - 2)\n    \n    return starts_with_one + ends_with_one - starts_and_ends_with_one", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/139": [{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"Calculates the Brazilian factorial of n, which is n! * (n-1)! * ... * 1!\n    n is guaranteed to be a positive integer.\n    \"\"\"\n    overall_product = 1\n    for k in range(1, n + 1):\n        current_factorial = 1\n        for i in range(1, k + 1):\n            current_factorial *= i\n        overall_product *= current_factorial\n    return overall_product", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/147": [{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Counts the number of triples (a[i], a[j], a[k]) such that i < j < k and their sum is a multiple of 3.\n    The array a is generated by a[i] = i*i - i + 1.\n    \"\"\"\n    class IntegerArray:\n        def __init__(self, length):\n            self.length = length\n            self.elements = [0] * length\n\n        def generate(self):\n            for i in range(1, self.length + 1):\n                self.elements[i - 1] = i * i - i + 1\n\n    class Triple:\n        def __init__(self, i, j, k, sum_val):\n            self.i = i\n            self.j = j\n            self.k = k\n            self.sum = sum_val\n\n        def isMultipleOfThree(self):\n            return self.sum % 3 == 0\n\n    # Generate array\n    array = IntegerArray(n)\n    array.generate()\n\n    count = 0\n    # Enumerate triples\n    # i, j, k are 1-based indices as per problem statement\n    for i in range(1, n - 1):\n        for j in range(i + 1, n):\n            for k in range(j + 1, n + 1):\n                # Access array elements using 0-based indexing\n                sum_elements = array.elements[i - 1] + array.elements[j - 1] + array.elements[k - 1]\n                triple = Triple(i, j, k, sum_elements)\n                if triple.isMultipleOfThree():\n                    count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]}}