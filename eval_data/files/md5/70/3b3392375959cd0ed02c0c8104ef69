       \n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/127": [{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"\n    Determines if the length of the intersection of two closed integer intervals\n    is a prime number. Returns \"YES\" if it is, otherwise \"NO\".\n    \"\"\"\n\n    class Interval:\n        \"\"\"Represents a closed integer interval [start, end].\"\"\"\n        def __init__(self, start, end):\n            self.start = start\n            self.end = end\n\n        def length(self):\n            \"\"\"Calculates the length of the interval.\"\"\"\n            if self.start > self.end:\n                return 0\n            return self.end - self.start + 1\n\n        def get_intersection(self, other):\n            \"\"\"Returns a new Interval object representing the intersection, or None if no intersection.\"\"\"\n            intersection_start = max(self.start, other.start)\n            intersection_end = min(self.end, other.end)\n\n            if intersection_start <= intersection_end:\n                return Interval(intersection_start, intersection_end)\n            return None\n\n    class PrimeChecker:\n        \"\"\"Provides a utility method to check for primality.\"\"\"\n        @staticmethod\n        def is_prime(number):\n            \"\"\"Checks if a non-negative integer is a prime number.\"\"\"\n            if number <= 1:\n                return False\n            i = 2\n            while i * i <= number:\n                if number % i == 0:\n                    return False\n                i += 1\n            return True\n\n    # Create Interval objects from input tuples\n    int1 = Interval(interval1[0], interval1[1])\n    int2 = Interval(interval2[0], interval2[1])\n\n    # Get the intersection interval\n    intersection_interval = int1.get_intersection(int2)\n\n    if intersection_interval:\n        # Calculate the length of the intersection\n        intersection_length = intersection_interval.length()\n        # Check if the length is a prime number\n        if PrimeChecker.is_prime(intersection_length):\n            return \"YES\"\n        else:\n            return \"NO\"\n    else:\n        # If there is no intersection, return \"NO\"\n        return \"NO\"", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[-1, 1], [0, 4]]], "plus_fail_tests": [[[10, 20], [15, 25]]]}], "HumanEval/118": [{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"You are given a word. Your task is to find the closest vowel that stands between \n    two consonants from the right side of the word (case sensitive).\n    \n    Vowels in the beginning and ending doesn't count. Return empty string if you didn't\n    find any vowel met the above condition. \n\n    You may assume that the given string contains English letter only.\n\n    Example:\n    get_closest_vowel(\"yogurt\") ==> \"u\"\n    get_closest_vowel(\"FULL\") ==> \"U\"\n    get_closest_vowel(\"quick\") ==> \"\"\n    get_closest_vowel(\"ab\") ==> \"\"\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\n    def is_vowel(char):\n        return char in VOWELS\n\n    def is_consonant(char):\n        # Assumes char is an English letter; if not a vowel, it's a consonant.\n        return char.isalpha() and char not in VOWELS\n\n    n = len(word)\n    # A vowel needs at least one character before and one after it.\n    # So, the word must have a minimum length of 3 (CVC pattern).\n    if n < 3:\n        return \"\"\n\n    # Iterate from the second-to-last character (index n-2) down to the second character (index 1).\n    # This ensures that word[i-1] and word[i+1] are always valid indices.\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        prev_char = word[i - 1]\n        next_char = word[i + 1]\n\n        if is_vowel(current_char) and is_consonant(prev_cha