{"task_id": "Mbpp/120", "solution": "import collections.abc\n\nclass TuplePair:\n    \"\"\"Represents a 2-element numeric pair and computes its absolute product.\"\"\"\n    def __init__(self, a, b):\n        self.a = a\n        self.b = b\n\n    def absolute_product(self) -> float:\n        \"\"\"Computes and returns the absolute product of the two elements.\"\"\"\n        return abs(self.a * self.b)\n\nclass InputList:\n    \"\"\"Encapsulates the input collection of tuple pairs with validation.\"\"\"\n    def __init__(self, pairs: list) -> None:\n        if not isinstance(pairs, collections.abc.Sequence) or isinstance(pairs, str):\n            raise ValueError(\"Input 'pairs' must be a list.\")\n        if not pairs:\n            raise ValueError(\"Input list 'pairs' cannot be empty.\")\n\n        processed_pairs = []\n        for i, item in enumerate(pairs):\n            if not isinstance(item, tuple):\n                raise ValueError(f\"Element at index {i} is not a tuple: {item}\")\n            if len(item) != 2:\n                raise ValueError(f\"Tuple at index {i} does not have 2 elements: {item}\")\n            a, b = item\n            if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n                raise ValueError(f\"Elements in tuple at index {i} must be numeric: {item}\")\n            processed_pairs.append(TuplePair(a, b))\n        self.pairs = processed_pairs\n\nclass MaxProductResult:\n    \"\"\"Holds the computed maximum absolute product value.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value = value\n\nclass MaxProductCalculator:\n    \"\"\"Executes the algorithm to compute per-tuple absolute products and determine the maximum.\"\"\"\n    def max_product_tuple(self, input_list: InputList) -> MaxProductResult:\n        max_abs_product = float('-inf')\n        for tuple_pair in input_list.pairs:\n            current_abs_product = tuple_pair.absolute_product()\n            if current_abs_product > max_abs_product:\n                max_abs_product = current_abs_product\n        return MaxProductResult(max_abs_product)\n\ndef max_product_tuple(pairs):\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    Validates input and delegates computation to domain-specific classes.\n    \"\"\"\n    input_list = InputList(pairs)\n    calculator = MaxProductCalculator()\n    result = calculator.max_product_tuple(input_list)\n    return result.value"}
{"task_id": "Mbpp/119", "solution": "from typing import List\n\ndef _is_sorted(nums: List[int]) -> bool:\n    \"\"\"Return True iff nums is sorted in non-decreasing order.\"\"\"\n    for i in range(len(nums) - 1):\n        if nums[i] > nums[i+1]:\n            return False\n    return True\n\ndef _validate_nums(nums: List[int]) -> None:\n    \"\"\"Raise ValueError if nums violates preconditions described in design.\"\"\"\n    if not isinstance(nums, list):\n        raise ValueError(\"Input must be a list.\")\n    if not nums:\n        raise ValueError(\"Input list cannot be empty.\")\n    if not all(isinstance(x, int) for x in nums):\n        raise ValueError(\"All elements in the list must be integers.\")\n    if not _is_sorted(nums):\n        raise ValueError(\"Input list must be sorted in non-decreasing order.\")\n    if len(nums) % 2 == 0:\n        raise ValueError(\"Input list must have an odd number of elements to satisfy pairing property.\")\n\ndef search(nums: List[int]) -> int:\n    \"\"\"Search the sorted list nums and return the unique integer.\n\n    Args:\n        nums: sorted list of integers where exactly one integer appears once and every other integer appears twice.\n    Returns:\n        int: the integer that appears once.\n    Raises:\n        ValueError: if nums is empty, not a list of ints, not sorted, or pairing property is violated.\n    \"\"\"\n    _validate_nums(nums)\n\n    low, high = 0, len(nums) - 1\n\n    while low < high:\n        mid = low + (high - low) // 2\n\n        # Ensure mid always points to an even index to start checking a pair.\n        # If mid is odd, decrement it to point to the start of its pair.\n        if mid % 2 == 1:\n            mid -= 1\n\n        # Now mid is an even index. Compare nums[mid] with nums[mid+1].\n        if nums[mid] == nums[mid+1]:\n            # The pair is on the left or at mid; the unique element is to the right.\n            # Move low past this pair.\n            low = mid + 2\n        else:\n            # The pair is broken, meaning the unique element is at or before mid.\n            # Narrow down the search to the left half.\n            high = mid\n            \n    return nums[low]"}
{"task_id": "Mbpp/116", "solution": "class Validator:\n    \"\"\"Validates input tuples according to specified rules.\"\"\"\n\n    @staticmethod\n    def is_valid(input_tuple: tuple) -> bool:\n        \"\"\"Checks if the input is a non-empty tuple of positive integers.\"\"\"\n        if not isinstance(input_tuple, tuple):\n            return False\n        if not input_tuple:  # Check for empty tuple\n            return False\n        for element in input_tuple:\n            if not isinstance(element, int) or element <= 0:  # Must be positive integer (> 0)\n                return False\n        return True\n\n    @staticmethod\n    def validate_or_raise(input_tuple: tuple) -> None:\n        \"\"\"Raises ValueError if the input tuple is invalid.\"\"\"\n        if not isinstance(input_tuple, tuple):\n            raise ValueError(\"Input must be a tuple.\")\n        if not input_tuple:\n            raise ValueError(\"Input tuple cannot be empty.\")\n        for element in input_tuple:\n            if not isinstance(element, int):\n                raise ValueError(\"All elements in the tuple must be integers.\")\n            if element <= 0:  # Check for non-positive integers\n                raise ValueError(\"All elements in the tuple must be positive integers.\")\n\n\ndef tuple_to_int(input_tuple: tuple) -> int:\n    \"\"\"\n    Converts a tuple of positive integers into a single integer by concatenating their string representations.\n    Raises ValueError for invalid input based on validation rules.\n    \"\"\"\n    Validator.validate_or_raise(input_tuple)\n\n    # Convert each integer to its string representation and concatenate\n    concatenated_str = \"\".join(str(element) for element in input_tuple)\n\n    # Convert the resulting string back to an integer\n    return int(concatenated_str)"}
