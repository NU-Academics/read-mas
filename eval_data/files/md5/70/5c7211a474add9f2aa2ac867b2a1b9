{"task_id": "Mbpp/69", "solution": "def is_sublist(source, sublist) -> bool:\n    \"\"\"\n    Checks if a sublist exists contiguously and in order within a source list.\n    Elements are compared using the equality operator (==).\n    \"\"\"\n    len_source = len(source)\n    len_sublist = len(sublist)\n\n    # Return False if the sublist is longer than the source list (FR5).\n    if len_sublist > len_source:\n        return False\n\n    # An empty sublist is considered present in any list.\n    if len_sublist == 0:\n        return True\n\n    # Iterate through all possible starting positions for the sublist within the source list.\n    for i in range(len_source - len_sublist + 1):\n        match = True\n        # Compare elements of the current slice of the source with the sublist (FR2, FR3).\n        for k in range(len_sublist):\n            if source[i + k] != sublist[k]:\n                match = False\n                break  # Mismatch found, move to the next starting position in the source.\n        if match:\n            return True  # A full contiguous and ordered match was found.\n\n    # If no match was found after checking all possible starting positions.\n    return False"}
{"task_id": "Mbpp/67", "solution": "class BellNumberException(ValueError):\n    \"\"\"\n    Custom exception for Bell number computation errors.\n    Subclasses ValueError as specified in the design.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass InputValidator:\n    \"\"\"\n    Validates inputs for the Bell number function.\n    Ensures input is a non-negative integer.\n    \"\"\"\n    def is_non_negative_integer(self, n) -> bool:\n        \"\"\"Checks if n is a non-negative integer.\"\"\"\n        return isinstance(n, int) and n >= 0\n\n    def validate_or_raise(self, n) -> None:\n        \"\"\"\n        Raises BellNumberException if n is not a non-negative integer.\n        \"\"\"\n        if not self.is_non_negative_integer(n):\n            raise BellNumberException(\"n must be a non-negative integer.\")\n\nclass BellNumberFunction:\n    \"\"\"\n    Computes Bell numbers using a recurrence and memoization.\n    _cache stores computed Bell numbers to avoid redundant calculations.\n    \"\"\"\n    def __init__(self):\n        self._cache = {0: 1} # B(0) = 1\n\n    @staticmethod\n    def _comb(n, k):\n        \"\"\"Calculates binomial coefficient C(n, k).\"\"\"\n        if k < 0 or k > n:\n            return 0\n        if k == 0 or k == n:\n            return 1\n        if k > n // 2:\n            k = n - k\n\n        res = 1\n        for i in range(k):\n            res = res * (n - i) // (i + 1)\n        return res\n\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Computes the Bell number B(n) using a recurrence relation and memoization.\n        B(n) = sum_{k=0}^{n-1} C(n-1, k) * B(k) for n >= 1, B(0) = 1.\n        \"\"\"\n        if n in self._cache:\n            return self._cache[n]\n\n        current_max_n_in_cache = max(self._cache.keys())\n\n        for i in range(current_max_n_in_cache + 1, n + 1):\n            current_bell = 0\n            for k in range(i):\n                current_bell += self._comb(i - 1, k) * self._cache[k]\n            self._cache[i] = current_bell\n        return self._cache[n]\n\n_bell_impl = BellNumberFunction()\n\ndef bell_number(n: int) -> int:\n    \"\"\"\n    Computes the Bell number B(n) for a non-negative integer n.\n    Validates input and delegates computation to BellNumberFunction.\n    \"\"\"\n    InputValidator().validate_or_raise(n)\n    return _bell_impl.compute(n)"}
{"task_id": "Mbpp/68", "solution": "def _is_non_decreasing(sequence: list) -> bool:\n    \"\"\"Return True if for all i: sequence[i] <= sequence[i+1].\"\"\"\n    for i in range(len(sequence) - 1):\n        if sequence[i] > sequence[i+1]:\n            return False\n    return True\n\ndef _is_non_increasing(sequence: list) -> bool:\n    \"\"\"Return True if for all i: sequence[i] >= sequence[i+1].\"\"\"\n    for i in range(len(sequence) - 1):\n        if sequence[i] < sequence[i+1]:\n            return False\n    return True\n\ndef is_Monotonic(sequence: list) -> bool:\n    \"\"\"Return True if sequence is entirely non-increasing or entirely non-decreasing.\n    Adjacent equal elements preserve monotonicity.\n    \"\"\"\n    return _is_non_decreasing(sequence) or _is_non_increasing(sequence)"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(elements: list) -> list:\n    \"\"\"Sorts a list of elements using the Comb Sort algorithm.\"\"\"\n    n = len(elements)\n    if n == 0:\n        return []\n\n    # Create a copy to avoid modifying the original list in place\n    arr = list(elements) \n\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        # Update the gap value\n        gap = int(gap / shrink_factor)\n        if gap < 1:\n            gap = 1\n\n        swapped = False\n\n        # Perform a single pass (similar to bubble sort)\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    return arr"}
{"task_id": "Mbpp/70", "solution": "def get_equal(tuple_list: list[tuple]) -> bool:\n    \"\"\"\n    Checks if all tuples in a list have the same length.\n    Returns True for an empty list.\n    \"\"\"\n    if not tuple_list:\n        return True\n\n    # Get the length of the first tuple\n    first_length = len(tuple_list[0])\n\n    # Compare the length of all subsequent tuples to the first one\n    for tpl in tuple_list:\n        if len(tpl) != first_length:\n            return False\n\n    return True"}
