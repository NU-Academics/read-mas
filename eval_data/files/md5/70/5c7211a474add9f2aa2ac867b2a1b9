{"task_id": "Mbpp/743", "solution": "class ParameterK:\n    \"\"\"Encapsulates rotation count and normalization logic.\n    Normalizes k for list rotation operations.\n    \"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def normalize(self, n: int) -> int:\n        \"\"\"Normalizes k to be within [0, n-1] range, or 0 if n is 0.\"\"\"\n        if n == 0:\n            return 0\n        return self.value % n\n\nclass ResultList:\n    \"\"\"A wrapper for the returned rotated list.\n    Provides methods to interact with the wrapped list.\n    \"\"\"\n    def __init__(self, elements: list) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the wrapped list.\"\"\"\n        return len(self.elements)\n\nclass RotationOperation:\n    \"\"\"Performs the rotation transform using the effective k.\n    Creates a new list by slicing and concatenating parts of the original list.\n    \"\"\"\n    def __init__(self, k: int) -> None:\n        self.k = k\n\n    def rotate(self, lst: list) -> ResultList:\n        \"\"\"Rotates the given list and returns it wrapped in a ResultList.\"\"\"\n        n = len(lst)\n        if n == 0:\n            return ResultList([])\n        \n        if self.k == 0:\n            return ResultList(lst[:]) # Shallow copy for k=0\n\n        split_point = n - self.k\n        rotated_list = lst[split_point:] + lst[:split_point]\n        return ResultList(rotated_list)\n\ndef rotate_right(lst: list, k: int) -> list:\n    \"\"\"\n    Rotates a given list by specified number of items to the right direction.\n    Returns a new list, leaving the original unchanged.\n    \"\"\"\n    n = len(lst)\n\n    # Handle empty list explicitly (Business Rule 1)\n    if n == 0:\n        return []\n\n    # Normalize k using ParameterK (Business Rule 4)\n    pk = ParameterK(k)\n    effective_k = pk.normalize(n)\n\n    # Perform rotation using RotationOperation (Business Rule 5, 6)\n    ro = RotationOperation(effective_k)\n    result_list_obj = ro.rotate(lst)\n    \n    # Extract and return the plain Python list from the ResultList wrapper\n    return result_list_obj.elements"}
{"task_id": "Mbpp/749", "solution": "from typing import List\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for errors in the input string format.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass NumericStringSorter:\n    \"\"\"Internal class to handle conversion and sorting logic.\"\"\"\n\n    def sort_numeric_strings(self, list_of_strings: List[str]) -> List[int]:\n        \"\"\"Converts strings to integers, then sorts them.\"\"\"\n        ints = [self.convert(s) for s in list_of_strings]\n        return self.sort(ints)\n\n    def convert(self, s: str) -> int:\n        \"\"\"Validates and converts a string to an integer.\"\"\"\n        try:\n            return int(s)\n        except ValueError:\n            raise ValidationError(f\"Input string '{s}' is not a valid decimal integer literal.\")\n\n    def sort(self, values: List[int]) -> List[int]:\n        \"\"\"Sorts a list of integers in ascending order.\"\"\"\n        return sorted(values)\n\ndef sort_numeric_strings(list_of_strings: List[str]) -> List[int]:\n    \"\"\"\n    Sorts a list of strings of numbers numerically.\n    Each string is converted to an integer, then the integers are sorted in ascending order.\n    \"\"\"\n    return NumericStringSorter().sort_numeric_strings(list_of_strings)"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_string: str) -> str:\n    # Returns an empty string if the input is empty.\n    if not input_string:\n        return \"\"\n\n    result_chars = []\n    # prev_char tracks the character immediately preceding the current one.\n    # Initialized to an empty string to prevent a leading space at the start.\n    prev_char = '' \n\n    for current_char in input_string:\n        # Insert a space if the previous character was lowercase and the current is uppercase.\n        # This also correctly handles the start of the string where prev_char is '', as ''.islower() is False.\n        if prev_char.islower() and current_char.isupper():\n            result_chars.append(' ')\n        \n        result_chars.append(current_char)\n        prev_char = current_char\n    \n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/745", "solution": "from typing import Iterator\n\n# Helper function\ndef _digits_of_int(n: int) -> list[int]:\n    \"\"\"Extracts decimal digits from an integer's absolute value.\"\"\"\n    n_abs = abs(n)\n    if n_abs == 0:\n        return [0]\n    return [int(d) for d in str(n_abs)]\n\n# Domain classes\nclass Digit:\n    \"\"\"Represents a single decimal digit.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass IntegerValue:\n    \"\"\"Represents a candidate integer and provides digit extraction.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n        self._digits_cache = None # Computed lazily\n\n    def digits_list(self) -> list[Digit]:\n        \"\"\"Returns Digit objects for decimal digits of abs(value).\"\"\"\n        if self._digits_cache is None:\n            self._digits_cache = [Digit(d) for d in _digits_of_int(self.value)]\n        return self._digits_cache\n\nclass Range:\n    \"\"\"Represents inclusive integer bounds and provides iteration helper.\"\"\"\n    def __init__(self, startnum: int, endnum: int):\n        self.startnum = startnum\n        self.endnum = endnum\n\n    def __iter__(self) -> Iterator[int]:\n        \"\"\"Iterates from startnum to endnum inclusive.\"\"\"\n        for i in range(self.startnum, self.endnum + 1):\n            yield i\n\nclass ResultList:\n    \"\"\"Holds qualifying integers and provides sorted ascending list for return.\"\"\"\n    def __init__(self):\n        self.items: list[int] = []\n\n    def append(self, n: int) -> None:\n        \"\"\"Appends an integer to the result list.\"\"\"\n        self.items.append(n)\n\n    def as_list(self) -> list[int]:\n        \"\"\"Returns the collected integers as a sorted ascending list.\"\"\"\n        return sorted(self.items)\n\nclass DivisibleByDigitsFunction:\n    \"\"\"Implements the algorithm to evaluate integers and find those divisible by their digits.\"\"\"\n    def __init__(self, startnum: int, endnum: int):\n        self.startnum = startnum\n        self.endnum = endnum\n\n    def execute(self) -> ResultList:\n        \"\"\"Evaluates integers in the range and returns qualifying numbers.\"\"\"\n        result_list = ResultList()\n        current_range = Range(self.startnum, self.endnum)\n\n        for n in current_range:\n            iv = IntegerValue(n)\n            digits = iv.digits_list()\n\n            # Exclude any number that contains digit 0.\n            if any(d.value == 0 for d in digits):\n                continue\n\n            # Check if every digit divides the number evenly.\n            is_divisible_by_all_digits = True\n            for d in digits:\n                if n % d.value != 0:\n                    is_divisible_by_all_digits = False\n                    break\n            \n            if is_divisible_by_all_digits:\n                result_list.append(n)\n        \n        return result_list\n\ndef divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a given range from startnum to endnum where every number\n    is divisible by every digit it contains.\n    \"\"\"\n    if startnum > endnum:\n        return []\n\n    impl = DivisibleByDigitsFunction(startnum, endnum)\n    result_list = impl.execute()\n    return result_list.as_list()"}
