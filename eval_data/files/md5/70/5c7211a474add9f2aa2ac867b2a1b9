{"task_id": "Mbpp/239", "solution": "from typing import Dict, Tuple\n\nclass InputValidationError(Exception):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    pass\n\nclass InputValidator:\n    \"\"\"Centralized utility for validating input parameters.\"\"\"\n    def validatePositiveInteger(self, value: int, name: str) -> None:\n        \"\"\"\n        Validates that the given value is a positive integer.\n        Raises InputValidationError if the value is not an integer or is less than 1.\n        \"\"\"\n        if not isinstance(value, int) or value < 1:\n            raise InputValidationError(f\"{name} must be a positive integer.\")\n\nclass SequenceCalculator:\n    \"\"\"\n    Calculates the total number of valid sequences given constraints m and n.\n    Uses memoized recursion (dynamic programming) for efficient computation.\n    \"\"\"\n    def __init__(self):\n        self._validator = InputValidator()\n        self._memo: Dict[Tuple[int, int], int] = {}\n\n    def get_total_number_of_sequences(self, m: int, n: int) -> int:\n        \"\"\"\n        Public entry point for calculating sequences.\n        Validates inputs and delegates to the internal counting mechanism.\n        \"\"\"\n        self._validator.validatePositiveInteger(m, 'm')\n        self._validator.validatePositiveInteger(n, 'n')\n\n        if n == 1:\n            return m\n\n        return self.countSequences(m, n)\n\n    def countSequences(self, m: int, n: int) -> int:\n        \"\"\"\n        Orchestrates the counting process, including memoization setup.\n        \"\"\"\n        self._reset_memo()\n        # Initial call: remaining length n, previous element is 0 (sentinel for first element)\n        return self._count_from(remaining=n, prev=0, m=m)\n\n    def _reset_memo(self) -> None:\n        \"\"\"Clears the memoization cache for a new calculation.\"\"\"\n        self._memo = {}\n\n    def _count_from(self, remaining: int, prev: int, m: int) -> int:\n        \"\"\"\n        Recursive helper function to count sequences using memoization.\n        remaining: number of elements left to choose for the sequence.\n        prev: the value of the previously chosen element.\n        m: the maximum allowed value for any element in the sequence.\n        \"\"\"\n        if remaining == 0:\n            return 1  # Found one valid sequence suffix\n\n        memo_key = (remaining, prev)\n        if memo_key in self._memo:\n            return self._memo[memo_key]\n\n        count = 0\n        # Determine the minimum possible value for the current element\n        # If prev is 0 (first element), the min value is 1.\n        # Otherwise, it must be at least twice the previous element.\n        start_next = 1 if prev == 0 else (2 * prev)\n\n        # Iterate possible values for the current element\n        for current_val in range(start_next, m + 1):\n            count += self._count_from(remaining - 1, current_val, m)\n\n        self._memo[memo_key] = count\n        return count\n\n# Create a singleton instance of the calculator as specified by design\n_calculator_instance = SequenceCalculator()\n\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the total number of sequences of length n, where each element\n    is a positive integer, greater than or equal to twice the previous,\n    and less than or equal to m.\n    \"\"\"\n    return _calculator_instance.get_total_number_of_sequences(m, n)"}
