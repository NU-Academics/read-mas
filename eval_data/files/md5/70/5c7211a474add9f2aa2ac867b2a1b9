{"task_id": "Mbpp/757", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass StringItem:\n    \"\"\"Domain concept representing a single string value and its position (index) in the list.\"\"\"\n    index: int\n    value: str\n\n    def reverse(self) -> str:\n        \"\"\"Returns the reversed string value.\"\"\"\n        return self.value[::-1]\n\n@dataclass\nclass StringList:\n    \"\"\"Ordered collection of StringItem objects.\"\"\"\n    items: List[StringItem]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of items in the list.\"\"\"\n        return len(self.items)\n\n    def get(self, index: int) -> StringItem:\n        \"\"\"Returns the StringItem at the given index.\"\"\"\n        return self.items[index]\n\n@dataclass\nclass ReversePair:\n    \"\"\"Unordered association of two distinct StringItem objects satisfying the reverse relation.\"\"\"\n    a: StringItem\n    b: StringItem\n\ndef _validate_input(list_of_strings) -> None:\n    \"\"\"Ensures parameter is a list and all elements are strings; raises TypeError on violation.\"\"\"\n    if not isinstance(list_of_strings, list):\n        raise TypeError(\"Input must be a list.\")\n    for i, item in enumerate(list_of_strings):\n        if not isinstance(item, str):\n            raise TypeError(f\"List element at index {i} is not a string.\")\n\ndef _compute_string_items(list_of_strings: List[str]) -> StringList:\n    \"\"\"Converts input list_of_strings into a StringList containing StringItem(index, value) for each element.\"\"\"\n    items = [StringItem(index, value) for index, value in enumerate(list_of_strings)]\n    return StringList(items=items)\n\ndef _detect_reverse_pairs(string_list: StringList) -> List[ReversePair]:\n    \"\"\"Detects candidate ReversePair objects where strings are reverses of each other and indices are distinct (i < j enforced).\"\"\"\n    found_pairs: List[ReversePair] = []\n    n = string_list.length()\n\n    for i in range(n):\n        for j in range(i + 1, n):  # Enforce i < j to get unique unordered index pairs\n            item_i = string_list.get(i)\n            item_j = string_list.get(j)\n\n            if item_i.value == item_j.reverse() or item_j.value == item_i.reverse():\n                found_pairs.append(ReversePair(a=item_i, b=item_j))\n    return found_pairs\n\ndef _count_unique_pairs(pairs: List[ReversePair]) -> int:\n    \"\"\"Counts the number of unique unordered reverse pairs.\"\"\"\n    return len(pairs)\n\ndef count_reverse_pairs(list_of_strings: List[str]) -> int:\n    \"\"\"Compute number of unordered reverse-string pairs in list_of_strings and return int.\"\"\"\n    _validate_input(list_of_strings)\n    string_list = _compute_string_items(list_of_strings)\n    pairs = _detect_reverse_pairs(string_list)\n    return _count_unique_pairs(pairs)"}
{"task_id": "Mbpp/758", "solution": "from typing import List, Dict, Tuple, Iterator, Any\n\nclass TupleSublist:\n    \"\"\"Immutable value object holding tuple representation and hashing semantics.\"\"\"\n    def __init__(self, elements: Tuple):\n        self.elements = elements\n\n    def __hash__(self) -> int:\n        return hash(self.elements)\n\n    def __eq__(self, other: Any) -> bool:\n        if not isinstance(other, TupleSublist):\n            return NotImplemented\n        return self.elements == other.elements\n\n    def as_tuple(self) -> Tuple:\n        \"\"\"Returns the internal tuple.\"\"\"\n        return self.elements\n\nclass Sublist:\n    \"\"\"Encapsulates a single sublist and conversion to TupleSublist.\"\"\"\n    def __init__(self, elements: List):\n        self.elements = elements\n\n    def to_tuple(self) -> TupleSublist:\n        \"\"\"Converts the internal list to a TupleSublist.\"\"\"\n        return TupleSublist(tuple(self.elements))\n\nclass SublistsCollection:\n    \"\"\"Lightweight wrapper providing iteration over input sublists.\"\"\"\n    def __init__(self, sublists: List[List]):\n        self.sublists = sublists\n\n    def __iter__(self) -> Iterator[Sublist]:\n        \"\"\"Iterates over the collection, yielding Sublist objects.\"\"\"\n        for s in self.sublists:\n            yield Sublist(s)\n\n    def size(self) -> int:\n        \"\"\"Returns the number of sublists in the collection.\"\"\"\n        return len(self.sublists)\n\nclass CountDictionary:\n    \"\"\"Aggregates occurrence counts and exposes a final dictionary.\"\"\"\n    def __init__(self):\n        self.counts: Dict[Tuple, int] = {}\n\n    def increment(self, tuple_key: Tuple) -> None:\n        \"\"\"Increments the count for a given tuple key.\"\"\"\n        self.counts[tuple_key] = self.counts.get(tuple_key, 0) + 1\n\n    def to_dict(self) -> Dict[Tuple, int]:\n        \"\"\"Returns the aggregated counts as a dictionary.\"\"\"\n        return self.counts\n\nclass UniqueSublistsFunction:\n    \"\"\"Orchestrates validation, conversion, counting, and final dictionary output.\"\"\"\n    def __init__(self, list_of_sublists: List):\n        self.list_of_sublists = list_of_sublists\n\n    def execute(self) -> Dict[Tuple, int]:\n        \"\"\"Executes the counting logic and returns the result.\"\"\"\n        if not self.list_of_sublists:\n            return {}\n\n        coll = SublistsCollection(self.list_of_sublists)\n        counts = CountDictionary()\n\n        for sub_raw in coll:\n            tuple_sub = sub_raw.to_tuple()\n            counts.increment(tuple_sub.as_tuple())\n            \n        return counts.to_dict()\n\ndef unique_sublists(list_of_sublists: List) -> Dict[Tuple, int]:\n    \"\"\"\n    Counts lists within a list, converting each sublist to a tuple and\n    returning their occurrences in a dictionary.\n    \"\"\"\n    uf = UniqueSublistsFunction(list_of_sublists)\n    return uf.execute()"}
{"task_id": "Mbpp/762", "solution": "from typing import Any\n\n_THIRTY_DAY_MONTHS = (4, 6, 9, 11)\n\nclass ValidationError(ValueError):\n    def __init__(self, message: str) -> None:\n        \"\"\"Construct ValidationError with descriptive message.\"\"\"\n        super().__init__(message)\n\nclass Month:\n    def __init__(self, value: Any) -> None:\n        \"\"\"Store value; no coercion performed (validation in is_valid).\"\"\"\n        self._value = value\n\n    def is_valid(self) -> bool:\n        \"\"\"Return True if stored value is an integer in 1..12.\"\"\"\n        return isinstance(self._value, int) and 1 <= self._value <= 12\n\n    def has_30_days(self) -> bool:\n        \"\"\"Return True if stored value is in _THIRTY_DAY_MONTHS.\"\"\"\n        return self._value in _THIRTY_DAY_MONTHS\n\nclass MonthChecker:\n    def __init__(self) -> None:\n        \"\"\"Stateless helper; no fields to ensure purity.\"\"\"\n        pass\n\n    def check_monthnumber_number(self, month: Any) -> bool:\n        \"\"\"Validate parameter and return True/False per business rules.\n           Raises ValidationError if input is invalid.\"\"\"\n        month_obj = Month(month)\n        if not month_obj.is_valid():\n            if not isinstance(month, int):\n                raise ValidationError(\"Month number must be an integer.\")\n            else:\n                raise ValidationError(\"Month number must be between 1 and 12.\")\n        return month_obj.has_30_days()\n\ndef check_monthnumber_number(month: Any) -> bool:\n    \"\"\"Public API function; delegates to MonthChecker and returns boolean or raises ValidationError.\"\"\"\n    checker = MonthChecker()\n    return checker.check_monthnumber_number(month)"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(s: str) -> int:\n    \"\"\"Return the number of ASCII digit characters ('0'..'9') in s.\n\n    Signature mandated by FR1: number_ctr(s: string) -> int\n    \"\"\"\n    count = 0\n    for ch in s:\n        if '0' <= ch <= '9':\n            count += 1\n    return count"}
{"task_id": "Mbpp/765", "solution": "import math\n\ndef is_power_of_two(x: int) -> bool:\n    \"\"\"Checks if a positive integer is a power of two using bitwise arithmetic.\"\"\"\n    return x > 0 and (x & (x - 1)) == 0\n\ndef find_nth_polite_number(n: int) -> int:\n    \"\"\"Finds the nth polite number, which is a positive integer that is not a power of two.\"\"\"\n    count = 0\n    candidate = 0\n    while count < n:\n        candidate += 1\n        if not is_power_of_two(candidate):\n            count += 1\n    return candidate"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(array, n):\n    \"\"\"\n    Finds the minimum absolute difference between any two elements among the first n elements in an array.\n    Raises ValueError if n is less than 2 or greater than the array's length.\n    \"\"\"\n    if n < 2:\n        raise ValueError(\"n must be at least 2 to find a difference between two elements.\")\n    if n > len(array):\n        raise ValueError(\"n cannot be greater than the length of the array.\")\n\n    # Take the first n elements and sort them\n    sub_array = sorted(array[:n])\n\n    min_diff = float('inf')\n\n    # Iterate through the sorted sub_array to find the minimum difference between adjacent elements\n    for i in range(n - 1):\n        diff = sub_array[i+1] - sub_array[i]\n        if diff < min_diff:\n            min_diff = diff\n\n    return min_diff"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list):\n    \"\"\"\n    Accepts input_list (ordered list) and returns a list of 2-tuples for consecutive items.\n    If input_list has fewer than two items, returns [].\n    \"\"\"\n    result = []\n    for i in range(len(input_list) - 1):\n        result.append((input_list[i], input_list[i+1]))\n    return result"}
{"task_id": "Mbpp/770", "solution": "from typing import List\n\nclass Number:\n    \"\"\"Wraps an integer value and provides a method to compute integer powers.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def power(self, exp: int) -> int:\n        \"\"\"Computes the integer power of the stored value.\"\"\"\n        return self.value ** exp\n\nclass OddNumberSequence:\n    \"\"\"Encapsulates 'n' and generates the sequence of the first n odd natural numbers.\"\"\"\n    def __init__(self, n: int) -> None:\n        self.n = n\n        self.sequence: List[int] = []\n\n    def generate(self) -> List[int]:\n        \"\"\"Generates the sequence [1, 3, 5, ..., 2*n-1].\"\"\"\n        self.sequence = [(2 * k - 1) for k in range(1, self.n + 1)]\n        return self.sequence\n\ndef odd_num_sum(n: int) -> int:\n    \"\"\"\n    Finds the sum of the fourth power of the first n odd natural numbers.\n    Orchestrates sequence generation and power computation using helper classes.\n    \"\"\"\n    total_sum = 0\n    \n    odd_seq_generator = OddNumberSequence(n)\n    odd_numbers = odd_seq_generator.generate()\n    \n    for num in odd_numbers:\n        number_obj = Number(num)\n        total_sum += number_obj.power(4)\n        \n    return total_sum"}
{"task_id": "Mbpp/769", "solution": "def Diff(list_a: list, list_b: list) -> list:\n    \"\"\"\n    Computes the difference between two lists, returning elements from list_a not in list_b.\n    Preserves the relative order and multiplicity of elements from list_a.\n    \"\"\"\n    \n    # Convert list_b to a set for efficient O(1) average time complexity lookups.\n    # This ensures that checking 'item not in exclude_elements' is fast.\n    exclude_elements = set(list_b)\n    \n    result = []\n    # Iterate through list_a to preserve the original relative order of elements.\n    for item in list_a:\n        # If an element from list_a is not found in the set of elements to exclude,\n        # it means it is part of the difference and should be added to the result.\n        if item not in exclude_elements:\n            result.append(item)\n            \n    return result"}
{"task_id": "Mbpp/767", "solution": "import collections\nfrom typing import List\n\ndef get_pairs_count(list_of_numbers: List[int], target_sum: int) -> int:\n    \"\"\"\n    Counts the number of pairs in a list that sum up to a target_sum.\n    Each unordered index-pair (i < j) is counted once, even if values are duplicates.\n    \"\"\"\n    count = 0\n    n = len(list_of_numbers)\n\n    # Edge-case: if len(list_of_numbers) < 2, return 0 immediately.\n    if n < 2:\n        return 0\n\n    # Iterate through all possible unordered pairs (i, j) where i < j.\n    for i in range(n):\n        for j in range(i + 1, n):\n            if list_of_numbers[i] + list_of_numbers[j] == target_sum:\n                count += 1\n    return count"}
{"task_id": "Mbpp/775", "solution": "import typing\n\ndef odd_position(lst: typing.List[int]) -> bool:\n    \"\"\"\n    Checks if every odd-indexed element in the list is an odd number.\n    Returns True if all odd-indexed elements are odd, or if there are no odd indices.\n    \"\"\"\n    for i, num in enumerate(lst):\n        if i % 2 == 1:  # Check only odd indices (1, 3, 5, ...)\n            if num % 2 == 0:  # If the number at an odd index is even\n                return False\n    return True"}
{"task_id": "Mbpp/772", "solution": "import typing\nfrom typing import List\n\ndef remove_length(input_string: str, k: int) -> str:\n    \"\"\"\n    Public API: orchestrates tokenization, filtering, and joining.\n    Returns the filtered string per design rules.\n    \"\"\"\n    def _tokenize(text: str) -> List[str]:\n        \"\"\"\n        Split on whitespace (spaces, tabs, newlines).\n        Uses Python's str.split() which collapses runs of whitespace.\n        \"\"\"\n        return text.split()\n\n    def _count_codepoints(token: str) -> int:\n        \"\"\"\n        Return the number of Unicode code points in token.\n        Python str len() yields code-point count.\n        \"\"\"\n        return len(token)\n\n    def _filter_tokens(tokens: List[str], length_to_remove: int) -> List[str]:\n        \"\"\"\n        Remove tokens whose _count_codepoints(token) == k while preserving order.\n        \"\"\"\n        return [t for t in tokens if _count_codepoints(t) != length_to_remove]\n\n    def _join_tokens(tokens_to_join: List[str]) -> str:\n        \"\"\"\n        Join remaining tokens with single spaces; return '' if no tokens.\n        \"\"\"\n        return ' '.join(tokens_to_join)\n\n    tokens = _tokenize(input_string)\n    filtered = _filter_tokens(tokens, k)\n    return _join_tokens(filtered)"}
{"task_id": "Mbpp/771", "solution": "from enum import Enum\nfrom typing import List, Optional\n\nclass BracketType(Enum):\n    \"\"\"Enumeration for different types of brackets.\"\"\"\n    PAREN = 1\n    SQUARE = 2\n    CURLY = 3\n\n# Mappings for bracket properties and matching.\n_BRACKET_TYPE_MAP = {\n    '(': BracketType.PAREN, ')': BracketType.PAREN,\n    '[': BracketType.SQUARE, ']': BracketType.SQUARE,\n    '{': BracketType.CURLY, '}': BracketType.CURLY,\n}\n_OPENING_BRACKETS = {'(', '[', '{'}\n_CLOSING_BRACKETS = {')', ']', '}'}\n_MATCHING_PAIRS = {\n    '(': ')',\n    '[': ']',\n    '{': '}',\n}\n\nclass Bracket:\n    \"\"\"Represents a single bracket character with its type and position.\"\"\"\n    def __init__(self, symbol: str, position: int):\n        self.symbol = symbol\n        self.position = position\n        self.type = _BRACKET_TYPE_MAP[symbol]\n        self._is_opening = symbol in _OPENING_BRACKETS\n\n    def isOpening(self) -> bool:\n        \"\"\"Checks if the bracket is an opening type.\"\"\"\n        return self._is_opening\n\n    def matches(self, other: 'Bracket') -> bool:\n        \"\"\"Checks if this opening bracket correctly matches the given closing bracket.\"\"\"\n        return (self.isOpening() and not other.isOpening() and\n                _MATCHING_PAIRS.get(self.symbol) == other.symbol)\n\nclass Expression:\n    \"\"\"Represents the input string as an expression to be parsed.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n        self.length = len(raw)\n\n    def parse(self) -> List[Bracket]:\n        \"\"\"Parses the raw string into a list of Bracket objects, ignoring non-bracket characters.\"\"\"\n        brackets = []\n        for i, char in enumerate(self.raw):\n            if char in _BRACKET_TYPE_MAP: # Only process known bracket characters\n                brackets.append(Bracket(char, i))\n        return brackets\n\nclass Stack:\n    \"\"\"A simple LIFO stack implementation for Bracket objects.\"\"\"\n    def __init__(self):\n        self._items: List[Bracket] = []\n\n    def push(self, item: Bracket) -> None:\n        \"\"\"Pushes an item onto the stack.\"\"\"\n        self._items.append(item)\n\n    def pop(self) -> Bracket:\n        \"\"\"Removes and returns the top item from the stack. Raises IndexError if empty.\"\"\"\n        return self._items.pop()\n\n    def peek(self) -> Optional[Bracket]:\n        \"\"\"Returns the top item without removing it, or None if the stack is empty.\"\"\"\n        if self.isEmpty():\n            return None\n        return self._items[-1]\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the stack is empty.\"\"\"\n        return len(self._items) == 0\n\nclass BalanceValidator:\n    \"\"\"Validates the balance of brackets within an expression.\"\"\"\n    def validate(self, expression: Expression) -> bool:\n        \"\"\"Validates if the given expression has balanced brackets.\"\"\"\n        stack = Stack()\n        for bracket in expression.parse():\n            if bracket.isOpening():\n                stack.push(bracket)\n            else: # Closing bracket\n                if stack.isEmpty():\n                    return False # Unmatched closing bracket\n                \n                opening_bracket = stack.pop()\n                if not opening_bracket.matches(bracket):\n                    return False # Mismatched bracket type\n\n        return stack.isEmpty() # Stack must be empty for a fully balanced expression\n\ndef check_expression(input: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets.\n    Non-bracket characters are ignored, and an empty string is considered balanced.\n    \"\"\"\n    validator = BalanceValidator()\n    expression = Expression(input)\n    return validator.validate(expression)"}
{"task_id": "Mbpp/773", "solution": "from dataclasses import dataclass\nfrom typing import Tuple, Optional\n\n@dataclass\nclass StringInput:\n    \"\"\"Encapsulates a string input value and provides basic validation.\"\"\"\n    value: str\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the encapsulated value is a valid string.\"\"\"\n        return isinstance(self.value, str)\n\n@dataclass\nclass SearchResult:\n    \"\"\"Represents a found substring and its indices for internal use.\"\"\"\n    matched: str\n    start_index: int\n    end_index: int\n\n    def to_tuple(self) -> Tuple[str, int, int]:\n        \"\"\"Converts the search result to a public tuple format.\"\"\"\n        return (self.matched, self.start_index, self.end_index)\n\nclass OccuranceSubstring:\n    \"\"\"Performs search logic to find the first occurrence of a substring.\"\"\"\n    def __init__(self, source: StringInput, substring: StringInput) -> None:\n        self.source = source\n        self.substring = substring\n\n    def search(self) -> Optional[SearchResult]:\n        \"\"\"Locates the first occurrence of the substring within the source string.\"\"\"\n        if not self.source.is_valid() or not self.substring.is_valid():\n            return None # Should not happen based on design assumptions, but good guard.\n\n        source_str = self.source.value\n        substring_str = self.substring.value\n\n        if not substring_str: # Handle empty substring case as per typical find behavior\n            if not source_str: # empty string in empty string\n                return SearchResult(matched=\"\", start_index=0, end_index=0)\n            else: # empty string in non-empty string always at 0\n                return SearchResult(matched=\"\", start_index=0, end_index=0)\n\n        start_index = source_str.find(substring_str)\n\n        if start_index != -1:\n            end_index = start_index + len(substring_str)\n            return SearchResult(matched=substring_str, start_index=start_index, end_index=end_index)\n        else:\n            return None\n\ndef occurance_substring(source: str, substring: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Finds the first occurrence and position of a substring within a string.\n    Returns None if there is no match.\n    \"\"\"\n    source_input = StringInput(source)\n    substring_input = StringInput(substring)\n\n    search_engine = OccuranceSubstring(source_input, substring_input)\n    result = search_engine.search()\n\n    if result:\n        return result.to_tuple()\n    else:\n        return None"}
{"task_id": "Mbpp/777", "solution": "import collections\nfrom typing import List\n\ndef find_sum(input_list: List[int]) -> int:\n    \"\"\"Compute sum of elements occurring exactly once in input_list and return int.\n    Must not modify input_list and accepts exactly one parameter.\n    \"\"\"\n    counts = collections.Counter(input_list)\n    total_sum = 0\n    for element, count in counts.items():\n        if count == 1:\n            total_sum += element\n    return total_sum"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list):\n    \"\"\"Return a list of sublists where each sublist contains consecutive equal elements from input_list.\n\n    Args:\n        input_list: a list/sequence of elements comparable by equality\n\n    Returns:\n        list of lists: groups of consecutive equal elements; empty list returned if input_list is empty.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = []\n    current_group = []\n\n    for element in input_list:\n        if not current_group or element == current_group[-1]:\n            current_group.append(element)\n        else:\n            result.append(current_group)\n            current_group = [element]\n\n    # Append the last group after the loop finishes\n    if current_group:\n        result.append(current_group)\n\n    return result"}
{"task_id": "Mbpp/781", "solution": "def compute_divisor_count(n: int) -> int:\n    \"\"\"\n    Computes the count of positive integer divisors of n.\n    Iterates up to sqrt(n) for efficiency.\n    \"\"\"\n    count = 0\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count\n\ndef is_count_even(count: int) -> bool:\n    \"\"\"\n    Checks if a given count is an even number.\n    \"\"\"\n    return (count % 2) == 0\n\ndef count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks whether the count of positive integer divisors of n is even.\n    \"\"\"\n    divisor_count = compute_divisor_count(n)\n    return is_count_even(divisor_count)"}
{"task_id": "Mbpp/780", "solution": "from typing import Sequence, List, Tuple\n\ndef _compute_pair_sum(t1: Tuple[int, int], t2: Tuple[int, int]) -> Tuple[int, int]:\n    \"\"\"Computes the element-wise sum of two 2-element integer tuples.\"\"\"\n    return (t1[0] + t2[0], t1[1] + t2[1])\n\ndef find_combinations(input_list: Sequence[Tuple[int, int]]) -> List[Tuple[int, int]]:\n    \"\"\"\n    Finds combinations of sums with tuples in the given tuple list.\n    Computes element-wise sums for every unordered pair of distinct input tuples.\n    \"\"\"\n    n = len(input_list)\n    output_list: List[Tuple[int, int]] = []\n\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            sum_tuple = _compute_pair_sum(input_list[i], input_list[j])\n            output_list.append(sum_tuple)\n            \n    return output_list"}
{"task_id": "Mbpp/782", "solution": "from typing import List\n\nclass InputList:\n    \"\"\"Container wrapper for a Python list[int].\"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        self.elements = elements\n\n    def get_elements(self) -> List[int]:\n        \"\"\"Returns the wrapped list of elements.\"\"\"\n        return self.elements\n\nclass Subarray:\n    \"\"\"Represents a contiguous slice of a list and provides length and sum operations.\"\"\"\n    def __init__(self, start_index: int, end_index: int, elements: List[int]) -> None:\n        self.start_index = start_index\n        self.end_index = end_index\n        self._original_elements = elements # The underlying full list from which this subarray is derived.\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the subarray.\"\"\"\n        return self.end_index - self.start_index + 1\n\n    def elements(self) -> List[int]:\n        \"\"\"Returns the actual elements of this subarray.\"\"\"\n        return self._original_elements[self.start_index : self.end_index + 1]\n\n    def sum(self) -> int:\n        \"\"\"Computes and returns the sum of the subarray's elements.\"\"\"\n        return sum(self.elements())\n\nclass OddLengthSumCalculator:\n    \"\"\"Enumerate contiguous subarrays, filter odd-length ones, aggregate their sums.\"\"\"\n    def odd_length_sum(self, input_list: InputList) -> int:\n        \"\"\"Computes the aggregated integer sum of all odd-length contiguous subarrays.\"\"\"\n        total_sum = 0\n        arr = input_list.get_elements()\n        n = len(arr)\n\n        for start_index in range(n):\n            for end_index in range(start_index, n):\n                subarray = Subarray(start_index, end_index, arr)\n                if subarray.length() % 2 != 0:\n                    total_sum += subarray.sum()\n        return total_sum\n\ndef odd_length_sum(arr: List[int]) -> int:\n    \"\"\"\n    Calculates the sum of all odd-length subarrays in the given list.\n    Delegates the computation to an OddLengthSumCalculator.\n    \"\"\"\n    input_list = InputList(arr)\n    calculator = OddLengthSumCalculator()\n    return calculator.odd_length_sum(input_list)"}
{"task_id": "Mbpp/784", "solution": "from typing import List\n\ndef _validate_numbers(numbers: List[int]) -> None:\n    \"\"\"Raise TypeError if any element in numbers is not an int.\"\"\"\n    for num in numbers:\n        if not isinstance(num, int):\n            raise TypeError(\"non-integer element in input list\")\n\ndef _find_first_odd(numbers: List[int]) -> int:\n    \"\"\"Scan from index 0; return first odd int or raise ValueError if none.\"\"\"\n    for num in numbers:\n        if num % 2 != 0:\n            return num\n    raise ValueError(\"no odd number found in input list\")\n\ndef _find_first_even(numbers: List[int]) -> int:\n    \"\"\"Scan from index 0; return first even int or raise ValueError if none.\"\"\"\n    for num in numbers:\n        if num % 2 == 0:\n            return num\n    raise ValueError(\"no even number found in input list\")\n\ndef mul_even_odd(numbers: List[int]) -> int:\n    \"\"\"Public API: validate -> find first odd -> find first even -> return product.\"\"\"\n    _validate_numbers(numbers)\n    first_odd = _find_first_odd(numbers)\n    first_even = _find_first_even(numbers)\n    return first_odd * first_even"}
{"task_id": "Mbpp/785", "solution": "from typing import List\n\nclass TupleString:\n    \"\"\"Holds the raw input string for parsing.\"\"\"\n    def __init__(self, raw: str) -> None:\n        self.raw = raw\n\nclass IntegerTuple:\n    \"\"\"Holds the resulting tuple of integers.\"\"\"\n    def __init__(self, values: tuple) -> None:\n        self.values = values\n\nclass TupleParser:\n    \"\"\"Parses a tuple string into an integer tuple.\"\"\"\n\n    def tuple_str_int(self, s: str) -> tuple:\n        \"\"\"\n        Converts a string representation of an integer tuple to a native integer tuple.\n        Raises ValueError for invalid formats or non-integer tokens.\n        \"\"\"\n        if not self._validate_format(s):\n            raise ValueError(\"Invalid tuple format: must start with '(' and end with ')'\")\n\n        tokens = self._tokenize(s)\n        parsed_integers = []\n        for token in tokens:\n            parsed_integers.append(self._parse_token(token))\n        \n        return tuple(parsed_integers)\n\n    def _validate_format(self, s: str) -> bool:\n        \"\"\"\n        Checks the high-level format: string must start with '(' and end with ')',\n        ignoring leading/trailing whitespace.\n        \"\"\"\n        s_stripped = s.strip()\n        return len(s_stripped) >= 2 and s_stripped[0] == '(' and s_stripped[-1] == ')'\n\n    def _tokenize(self, s: str) -> List[str]:\n        \"\"\"\n        Extracts numeric token strings from the input, trimming whitespace around them.\n        Assumes _validate_format has already passed.\n        \"\"\"\n        s_stripped = s.strip()\n        # Remove outer parentheses\n        content = s_stripped[1:-1]\n        \n        # Split by comma and strip whitespace from each token, filtering out empty strings\n        raw_tokens = content.split(',')\n        tokens = [token.strip() for token in raw_tokens if token.strip()]\n        \n        return tokens\n\n    def _parse_token(self, tok: str) -> int:\n        \"\"\"\n        Converts a single numeric token string to an integer.\n        Raises ValueError if the token cannot be converted.\n        \"\"\"\n        try:\n            return int(tok)\n        except ValueError:\n            raise ValueError(f\"Invalid integer token: '{tok}'\")\n\ndef tuple_str_int(s: str) -> tuple:\n    \"\"\"\n    Converts a string representation of an integer tuple to a native integer tuple.\n    \"\"\"\n    parser = TupleParser()\n    return parser.tuple_str_int(s)"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(sorted_list, value) -> int:\n    \"\"\"\n    Locates the right insertion point for a specified value in sorted order.\n\n    The input `sorted_list` must be sorted in ascending (non-decreasing) order;\n    behavior is undefined for unsorted inputs.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] <= value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/787", "solution": "class InputString:\n    \"\"\"Represent the provided input string and provide its length.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n        self.length = len(value)\n\n    def __len__(self) -> int:\n        return self.length\n\nclass MatchResult:\n    \"\"\"Represent the boolean outcome of the match operation.\"\"\"\n    def __init__(self, is_match: bool) -> None:\n        self.is_match = is_match\n\nclass TextMatcher:\n    \"\"\"Encapsulate matching behavior and canonical pattern literal \"abbb\".\"\"\"\n    def __init__(self) -> None:\n        self._pattern: str = \"abbb\"\n\n    def match(self, text: str) -> bool:\n        \"\"\"Return True iff `text` contains the literal contiguous substring \"abbb\".\"\"\"\n        is_match = self._pattern in text\n        # MatchResult object created for traceability per design, but not returned by this method.\n        # The method returns bool as per the explicit signature.\n        _ = MatchResult(is_match)\n        return is_match\n\ndef text_match_three(text) -> bool:\n    \"\"\"Return True if `text` contains the contiguous substring \"abbb\", else False.\n\n    Signature required by SRS: text_match_three(text)\n    Parameter: text (expected str)\n    Return: bool\n    \"\"\"\n    input_string = InputString(value=text)\n    text_matcher = TextMatcher()\n    result = text_matcher.match(input_string.value)\n    return result"}
{"task_id": "Mbpp/788", "solution": "from typing import List, Tuple, Any\n\ndef new_tuple(listInput: List[Any], stringInput: str) -> Tuple[Any, ...]:\n    \"\"\"\n    Construct and return a tuple consisting of the elements of listInput in order\n    followed by stringInput as the final element.\n    \"\"\"\n    combined = list(listInput) + [stringInput]\n    return tuple(combined)"}
{"task_id": "Mbpp/790", "solution": "def even_position(input_list: list) -> bool:\n    \"\"\"Return True iff every element at an even index (0-based) in input_list is an even integer.\n\n    Non-integer elements at even indices are treated as failing the evenness condition.\n    \"\"\"\n    for i in range(0, len(input_list), 2):\n        element = input_list[i]\n        if not (isinstance(element, int) and element % 2 == 0):\n            return False\n    return True"}
{"task_id": "Mbpp/791", "solution": "def validate_input(input_tuple):\n    \"\"\"Raise TypeError if input_tuple is not a tuple.\"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\ndef filter_elements(elements: tuple) -> tuple:\n    \"\"\"Return tuple of elements where isinstance(element, tuple) is False, preserving order and identity.\"\"\"\n    filtered_list = []\n    for element in elements:\n        if not isinstance(element, tuple):\n            filtered_list.append(element)\n    return tuple(filtered_list)\n\ndef remove_nested(input_tuple: tuple) -> tuple:\n    \"\"\"Public API: validate input and return tuple with top-level tuples removed.\"\"\"\n    validate_input(input_tuple)\n    return filter_elements(input_tuple)"}
{"task_id": "Mbpp/792", "solution": "def count_list(lst: list) -> int:\n    \"\"\"Counts the number of top-level list elements in the given list.\"\"\"\n    count = 0\n    for element in lst:\n        if isinstance(element, list):\n            count += 1\n    return count"}
{"task_id": "Mbpp/793", "solution": "def last(array: list, value) -> int:\n    \"\"\"Return highest 0-based index of value in array, or -1 if not present.\n    Assumes array is sorted ascending.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == value:\n            result = mid  # Found a potential last occurrence\n            low = mid + 1  # Try to find an even later occurrence in the right subarray\n        elif array[mid] < value:\n            low = mid + 1\n        else:  # array[mid] > value\n            high = mid - 1\n    return result"}
{"task_id": "Mbpp/796", "solution": "from typing import Union\n\nNumber = Union[int, float]\n\ndef return_sum(arg: dict) -> Number:\n    \"\"\"\n    Calculates the sum of all numeric values in the given dictionary.\n    Raises TypeError if the input is not a dictionary.\n    \"\"\"\n    if not isinstance(arg, dict):\n        raise TypeError(\"Input must be a dictionary.\")\n    return sum(arg.values())"}
