{"task_id": "Mbpp/245", "solution": "from dataclasses import dataclass\nfrom typing import List, Dict, Sequence, Optional, Any, Union\n\n@dataclass\nclass ArrayInput:\n    \"\"\"Represents an input array abstraction.\"\"\"\n    numbers: List[float]\n\n    def length(self) -> int:\n        return len(self.numbers)\n\n    def get(self, index: int) -> float:\n        return self.numbers[index]\n\n@dataclass\nclass Element:\n    \"\"\"Represents a single array element with its value and index.\"\"\"\n    value: float\n    index: int\n\n@dataclass\nclass Subsequence:\n    \"\"\"Represents a subsequence of Element objects.\"\"\"\n    elements: List[Element]\n\n    def sum(self) -> float:\n        return sum(e.value for e in self.elements)\n\n    def length(self) -> int:\n        return len(self.elements)\n\n@dataclass\nclass BitonicSubsequence:\n    \"\"\"Represents a bitonic subsequence composed of increasing and decreasing parts with a pivot.\"\"\"\n    increasingPart: Subsequence\n    decreasingPart: Subsequence\n    pivot: Element\n\n    def sum(self) -> float:\n        \"\"\"Calculates the sum of the bitonic subsequence.\"\"\"\n        return self.increasingPart.sum() + self.decreasingPart.sum() - self.pivot.value\n\n    def isValidBitonic(self) -> bool:\n        \"\"\"Checks if the subsequence is strictly increasing then strictly decreasing.\"\"\"\n        if not (self.increasingPart.length() > 0 and self.increasingPart.elements[-1] == self.pivot):\n            return False\n        if not (self.decreasingPart.length() > 0 and self.decreasingPart.elements[0] == self.pivot):\n            return False\n\n        for i in range(self.increasingPart.length() - 1):\n            if not (self.increasingPart.elements[i].value < self.increasingPart.elements[i+1].value):\n                return False\n        for i in range(self.decreasingPart.length() - 1):\n            if not (self.decreasingPart.elements[i].value > self.decreasingPart.elements[i+1].value):\n                return False\n        return True\n\nclass MaxSumFunction:\n    \"\"\"Encapsulates the algorithm to compute increasing/decreasing sums and combine them.\"\"\"\n    def max_sum(self, array: ArrayInput) -> float:\n        \"\"\"Computes the maximum sum of a bitonic subsequence for the given array.\"\"\"\n        if array.length() == 0:\n            return 0.0\n\n        inc_map = self._computeMaxIncreasingSums(array)\n        dec_map = self._computeMaxDecreasingSums(array)\n        \n        return self._combineSums(inc_map, dec_map, array)\n\n    def _computeMaxIncreasingSums(self, array: ArrayInput) -> Dict[int, float]:\n        \"\"\"Calculates max sum of strictly increasing subsequence ending at each index.\"\"\"\n        n = array.length()\n        if n == 0:\n            return {}\n\n        dp = [0.0] * n\n        for i in range(n):\n            dp[i] = array.get(i)\n            for j in range(i):\n                if array.get(i) > array.get(j):\n                    dp[i] = max(dp[i], dp[j] + array.get(i))\n        \n        return {i: dp[i] for i in range(n)}\n\n    def _computeMaxDecreasingSums(self, array: ArrayInput) -> Dict[int, float]:\n        \"\"\"Calculates max sum of strictly decreasing subsequence starting at each index.\"\"\"\n        n = array.length()\n        if n == 0:\n            return {}\n\n        dp = [0.0] * n\n        for i in range(n - 1, -1, -1):\n            dp[i] = array.get(i)\n            for j in range(i + 1, n):\n                if array.get(i) > array.get(j):\n                    dp[i] = max(dp[i], dp[j] + array.get(i))\n        \n        return {i: dp[i] for i in range(n)}\n\n    def _combineSums(self, incMap: Dict[int, float], decMap: Dict[int, float], array: ArrayInput) -> float:\n        \"\"\"Combines increasing and decreasing sums to find the maximum bitonic sum.\"\"\"\n        n = array.length()\n        if n == 0:\n            return 0.0\n        if n == 1: # A single element is a valid bitonic subsequence\n            return array.get(0)\n\n        max_bitonic_sum = float('-inf')\n\n        for i in range(n):\n            # Sum for a bitonic subsequence with array[i] as the pivot\n            current_sum = incMap[i] + decMap[i] - array.get(i)\n            max_bitonic_sum = max(max_bitonic_sum, current_sum)\n        \n        return max_bitonic_sum\n\ndef max_sum(array: Sequence[float]) -> float:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence (first increasing then decreasing).\n    \"\"\"\n    array_input = ArrayInput(numbers=list(array))\n    calculator = MaxSumFunction()\n    return calculator.max_sum(array_input)"}
