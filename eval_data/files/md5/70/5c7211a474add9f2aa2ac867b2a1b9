{"task_id": "Mbpp/581", "solution": "import math\n\ndef surface_Area(base_edge, height):\n    \"\"\"\n    Calculates the surface area of a square pyramid given its base edge and height.\n    This includes the area of the square base and the four triangular lateral faces.\n    \"\"\"\n    # Calculate the slant height of the pyramid\n    half_base_edge = base_edge / 2\n    slant_height = math.sqrt(half_base_edge**2 + height**2)\n\n    # Calculate the area of the square base\n    base_area = base_edge**2\n\n    # Calculate the lateral surface area (sum of areas of four triangular faces)\n    # Area of one triangular face = 0.5 * base_edge * slant_height\n    # Lateral area = 4 * (0.5 * base_edge * slant_height) = 2 * base_edge * slant_height\n    lateral_area = 2 * base_edge * slant_height\n\n    # Total surface area is the sum of the base area and the lateral area\n    total_surface_area = base_area + lateral_area\n\n    return total_surface_area"}
{"task_id": "Mbpp/585", "solution": "def expensive_items(dataset, n) -> list:\n    \"\"\"Find the n most expensive items in a dataset, sorted by price descending.\n    Returns an empty list if n is not positive, or a subset of the dataset.\"\"\"\n    if n <= 0:\n        return []\n\n    # Create a shallow copy of the dataset to ensure the original list is not modified.\n    items_copy = list(dataset)\n\n    # Sort the items by their 'price' in descending order. Python's Timsort is stable,\n    # preserving the original order for items with equal prices.\n    sorted_items = sorted(items_copy, key=lambda item: item['price'], reverse=True)\n\n    # Return the top 'n' items from the sorted list. Slicing handles cases\n    # where n is greater than the total number of items in the dataset.\n    return sorted_items[:n]"}
{"task_id": "Mbpp/586", "solution": "def split_Arr(input_list: list, n: int) -> list:\n    \"\"\"Return a new list where the first n elements of input_list are moved to the end, preserving relative order.\n\n    Preconditions: input_list is a Python list, n is an integer.\n    \"\"\"\n    first_part = input_list[:n]\n    second_part = input_list[n:]\n    return second_part + first_part"}
{"task_id": "Mbpp/588", "solution": "def big_diff(values: list) -> float:\n    \"\"\"Compute difference between largest and smallest numeric values in values.\n    Returns a numeric result (float or int depending on inputs).\n    \"\"\"\n    max_value = max(values)\n    min_value = min(values)\n    return max_value - min_value"}
{"task_id": "Mbpp/589", "solution": "import math\nfrom typing import List\n\ndef _first_integer_root_at_or_above(value: float) -> int:\n    \"\"\"\n    Computes the smallest integer k such that k*k >= value.\n    Returns 0 if value is non-positive, as perfect squares are non-negative.\n    \"\"\"\n    if value <= 0:\n        return 0\n    return math.ceil(math.sqrt(value))\n\ndef _last_integer_root_at_or_below(value: float) -> int:\n    \"\"\"\n    Computes the largest integer k such that k*k <= value.\n    Returns -1 if value is negative, as no perfect square can be negative.\n    \"\"\"\n    if value < 0:\n        return -1\n    return math.floor(math.sqrt(value))\n\ndef perfect_squares(start: float, end: float) -> List[int]:\n    \"\"\"\n    Finds all perfect squares within a given inclusive range [start, end].\n    Returns a sorted list of integers that are perfect squares.\n    \"\"\"\n    first_k = _first_integer_root_at_or_above(start)\n    last_k = _last_integer_root_at_or_below(end)\n\n    if first_k > last_k:\n        return []\n\n    result = [k * k for k in range(first_k, last_k + 1)]\n    return result"}
{"task_id": "Mbpp/591", "solution": "def swap_List(lst):\n    \"\"\"\n    Interchanges the first and last elements of a list.\n    Returns the original list unchanged if its length is less than 2,\n    otherwise returns a new list with the first and last elements swapped.\n    \"\"\"\n    if len(lst) < 2:\n        return lst\n    else:\n        new_list = lst.copy()\n        new_list[0], new_list[-1] = new_list[-1], new_list[0]\n        return new_list"}
{"task_id": "Mbpp/592", "solution": "import math\n\nclass InputValidator:\n    \"\"\"\n    Encapsulates input validation rules for type and non-negativity.\n    \"\"\"\n    def is_integer(self, value) -> bool:\n        \"\"\"Checks if the given value is an integer.\"\"\"\n        return isinstance(value, int)\n\n    def is_non_negative(self, n: int) -> bool:\n        \"\"\"Checks if the given integer is non-negative.\"\"\"\n        return n >= 0\n\n    def raise_error_on_invalid(self, value) -> None:\n        \"\"\"Raises TypeError for non-int or ValueError for negative integers.\"\"\"\n        if not self.is_integer(value):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        if not self.is_non_negative(value):\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\nclass BinomialCalculator:\n    \"\"\"\n    Provides exact integer binomial coefficient computation using math.comb.\n    \"\"\"\n    def comb(self, n: int, k: int) -> int:\n        \"\"\"Computes C(n, k) using math.comb.\"\"\"\n        return math.comb(n, k)\n\n    def comb_safe(self, n: int, k: int) -> int:\n        \"\"\"Computes C(n, k), returning 0 for out-of-range k.\"\"\"\n        return math.comb(n, k)\n\nclass Result:\n    \"\"\"\n    A simple value object to hold an integer result.\n    \"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass SumOfProductFunction:\n    \"\"\"\n    Coordinates validation and calculation of sum of products of consecutive binomial coefficients.\n    \"\"\"\n    def __init__(self, validator: InputValidator, calculator: BinomialCalculator):\n        self.validator = validator\n        self.calculator = calculator\n\n    def compute_via_identity(self, n: int) -> int:\n        \"\"\"Computes the sum using the identity comb(2*n, n-1) for n >= 1.\"\"\"\n        return self.calculator.comb(2 * n, n - 1)\n\n    def compute_via_sum(self, n: int) -> int:\n        \"\"\"Computes the sum using a direct summation loop.\"\"\"\n        total = 0\n        for k in range(n):\n            term = self.calculator.comb(n, k) * self.calculator.comb(n, k + 1)\n            total += term\n        return total\n\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Validates input and computes the sum of the product of consecutive binomial coefficients.\n        \"\"\"\n        self.validator.raise_error_on_invalid(n)\n        if n == 0:\n            return 0\n        return self.compute_via_identity(n)\n\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Finds the sum of the product of consecutive binomial co-efficients.\n    For n >= 1, this is equal to C(2*n, n-1).\n    \"\"\"\n    validator = InputValidator()\n    calculator = BinomialCalculator()\n    service = SumOfProductFunction(validator, calculator)\n    return service.compute(n)"}
{"task_id": "Mbpp/593", "solution": "from typing import List\n\nclass Validator:\n    \"\"\"\n    Validation component responsible for format checks on IPv4 input strings.\n    Checks for exactly four numeric dot-separated components.\n    \"\"\"\n    def is_valid_ipv4(self, input_str: str) -> bool:\n        parts = input_str.split('.')\n        if len(parts) != 4:\n            return False\n        for part in parts:\n            if not part or not part.isdigit():\n                return False\n        return True\n\nclass Octet:\n    \"\"\"\n    Domain model for a single octet of an IP address.\n    Handles parsing its raw string value to numeric and normalizing it.\n    \"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n        # Numeric conversion relies on prior validation ensuring 'raw' is a digit string.\n        self.numeric = int(raw)\n        self.normalized = str(self.numeric)\n\n    def removeLeadingZeros(self) -> str:\n        # Returns the already computed normalized string representation.\n        return self.normalized\n\nclass IPAddress:\n    \"\"\"\n    Domain model representing an IPv4 address, composed of four Octet instances.\n    Provides methods to construct from raw input and retrieve normalized output.\n    \"\"\"\n    def __init__(self, raw_input: str):\n        self.raw_input = raw_input\n        # Input is expected to be pre-validated for format.\n        parts = raw_input.split('.')\n        self.octets: List[Octet] = [Octet(part) for part in parts]\n\n    def normalized_output(self) -> str:\n        \"\"\"Returns the dot-joined normalized string for the IP address.\"\"\"\n        return \".\".join(octet.normalized for octet in self.octets)\n\ndef removezero_ip(input: str) -> str:\n    \"\"\"\n    Removes leading zeros from each octet of an IPv4 address string.\n    Raises ValueError for malformed input as per design.\n    \"\"\"\n    validator = Validator()\n\n    if not validator.is_valid_ipv4(input):\n        raise ValueError(\"Invalid IPv4 address format: Must have four dot-separated numeric components.\")\n\n    try:\n        ip_address = IPAddress(raw_input=input)\n        return ip_address.normalized_output()\n    except ValueError as e:\n        # Catches potential parsing errors during Octet instantiation if is_valid_ipv4 was insufficient.\n        raise ValueError(f\"Error processing IP address components: {e}\")"}
