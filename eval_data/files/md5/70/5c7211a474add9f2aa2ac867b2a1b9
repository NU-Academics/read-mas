{"task_id": "Mbpp/590", "solution": "import math\n\nTOLERANCE: float = 1e-12\n\nclass PolarCoordinate:\n    def __init__(self, r: float, theta: float) -> None:\n        self.r = r\n        self.theta = theta\n\n    def as_tuple(self) -> tuple[float, float]:\n        return (self.r, self.theta)\n\nclass RectangularCoordinate:\n    def __init__(self, x: float, y: float) -> None:\n        self.x = x\n        self.y = y\n\n    def as_tuple(self) -> tuple[float, float]:\n        return (self.x, self.y)\n\n    def asComplex(self) -> complex:\n        return complex(self.x, self.y)\n\nclass MathFunctions:\n    @staticmethod\n    def cos(theta: float) -> float:\n        return math.cos(theta)\n\n    @staticmethod\n    def sin(theta: float) -> float:\n        return math.sin(theta)\n\nclass PolarRectConverter:\n    @staticmethod\n    def polar_rect(r: float, theta: float) -> tuple[PolarCoordinate, RectangularCoordinate]:\n        x = r * MathFunctions.cos(theta)\n        y = r * MathFunctions.sin(theta)\n        return PolarCoordinate(r, theta), RectangularCoordinate(x, y)\n\ndef validate_numeric(value, name: str) -> None:\n    if not isinstance(value, (int, float)):\n        raise ValueError(f\"{name} must be numeric\")\n\ndef polar_rect(r, theta):\n    validate_numeric(r, 'r')\n    validate_numeric(theta, 'theta')\n    return PolarRectConverter.polar_rect(r, theta)"}
{"task_id": "Mbpp/594", "solution": "import collections\nfrom typing import List, Callable, Optional\n\n\nclass InputList:\n    \"\"\"A thin wrapper around a list of integers, providing validation and indexed access.\"\"\"\n    def __init__(self, values: List):\n        for item in values:\n            if not isinstance(item, int):\n                raise TypeError(\"List elements must be integers.\")\n        self.values = values\n\n    def length(self) -> int:\n        return len(self.values)\n\n    def get(self, index: int) -> 'IntegerNumber':\n        return IntegerNumber(self.values[index])\n\n\nclass IntegerNumber:\n    \"\"\"A wrapper for a single integer with parity predicates.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isEven(self) -> bool:\n        return self.value % 2 == 0\n\n    def isOdd(self) -> bool:\n        return self.value % 2 != 0\n\n\nclass Result:\n    \"\"\"A data transfer object holding the computed difference.\"\"\"\n    def __init__(self, difference: int):\n        self.difference = difference\n\n\nclass DiffEvenOddFunction:\n    \"\"\"Helper encapsulating the logic for scanning and computing the difference.\"\"\"\n    def find_first(self, predicate: Callable[['IntegerNumber'], bool], input_list: InputList) -> Optional['IntegerNumber']:\n        for i in range(input_list.length()):\n            num = input_list.get(i)\n            if predicate(num):\n                return num\n        return None\n\n    def compute_difference(self, input_list: InputList) -> Result:\n        first_odd = self.find_first(lambda num: num.isOdd(), input_list)\n        first_even = self.find_first(lambda num: num.isEven(), input_list)\n\n        if first_odd is None:\n            raise ValueError(\"No odd number found in the list.\")\n        if first_even is None:\n            raise ValueError(\"No even number found in the list.\")\n\n        return Result(first_even.value - first_odd.value)\n\n\ndef diff_even_odd(arr: List) -> int:\n    \"\"\"\n    Finds the difference of the first even and first odd number of a given list.\n    Raises TypeError if any element is not an integer, or ValueError if parity is missing.\n    \"\"\"\n    input_list = InputList(arr)\n    logic_processor = DiffEvenOddFunction()\n    result = logic_processor.compute_difference(input_list)\n    return result.difference"}
{"task_id": "Mbpp/597", "solution": "from find_kth.validator import Validator\nfrom find_kth.exceptions import IndexErrorException\n\ndef find_kth(arr1: list, arr2: list, k: int) -> object:\n    \"\"\"\n    Finds the k-th smallest element from two sorted arrays.\n    Uses a two-pointer approach and validates k using the Validator.\n    \"\"\"\n    len1 = len(arr1)\n    len2 = len(arr2)\n    total_length = len1 + len2\n\n    # Validate k using the Validator component\n    Validator.validate_k(k, total_length)\n\n    ptr1 = 0\n    ptr2 = 0\n    count = 0\n\n    while ptr1 < len1 and ptr2 < len2:\n        count += 1\n        if arr1[ptr1] <= arr2[ptr2]:\n            if count == k:\n                return arr1[ptr1]\n            ptr1 += 1\n        else:\n            if count == k:\n                return arr2[ptr2]\n            ptr2 += 1\n\n    while ptr1 < len1:\n        count += 1\n        if count == k:\n            return arr1[ptr1]\n        ptr1 += 1\n\n    while ptr2 < len2:\n        count += 1\n        if count == k:\n            return arr2[ptr2]\n        ptr2 += 1"}
{"task_id": "Mbpp/598", "solution": "class Number:\n    \"\"\"Data holder for a number and its digit count.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n        self.digitCount = self._count_digits(value)\n\n    def _count_digits(self, n: int) -> int:\n        \"\"\"Helper to count digits of an integer.\"\"\"\n        if n == 0:\n            return 1\n        return len(str(abs(n)))\n\nclass Result:\n    \"\"\"Data holder for boolean result.\"\"\"\n    def __init__(self, isArmstrong: bool):\n        self.isArmstrong = isArmstrong\n\nclass ArmstrongNumberService:\n    \"\"\"Provides the core logic to determine if a number is an Armstrong number.\"\"\"\n\n    def armstrong_number(self, n: int) -> bool:\n        \"\"\"Checks if a given number is an Armstrong number.\"\"\"\n        digit_count = self.countDigits(n)\n        sum_of_powers = self.sumOfPowers(n)\n\n        result_model = Result(sum_of_powers == n)\n        return result_model.isArmstrong\n\n    def countDigits(self, n: int) -> int:\n        \"\"\"Counts the number of decimal digits in the given integer.\"\"\"\n        if n == 0:\n            return 1\n        return len(str(abs(n)))\n\n    def sumOfPowers(self, n: int) -> int:\n        \"\"\"Calculates the sum of each digit raised to the power of the total digit count.\"\"\"\n        digit_count = self.countDigits(n)\n        \n        temp_n = abs(n)\n        total_sum = 0\n        while temp_n > 0:\n            digit = temp_n % 10\n            total_sum += digit ** digit_count\n            temp_n //= 10\n        return total_sum\n\ndef armstrong_number(n: int) -> bool:\n    \"\"\"\n    Checks whether the given number is an Armstrong number.\n    Raises TypeError if the input is not an integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n\n    service = ArmstrongNumberService()\n    return service.armstrong_number(n)"}
{"task_id": "Mbpp/600", "solution": "def is_Even(number):\n    \"\"\"\n    Checks if the given number is even.\n    Returns True if even, False if odd.\n    \"\"\"\n    return (number % 2) == 0"}
{"task_id": "Mbpp/604", "solution": "def reverse_words(input_str: str) -> str:\n    \"\"\"Reverses the order of words (space-delimited) in a given string.\n\n    Words are split by whitespace, reversed in order, and joined by single spaces.\n    \"\"\"\n    words = input_str.split()\n    reversed_words = words[::-1]\n    return \" \".join(reversed_words)"}
{"task_id": "Mbpp/599", "solution": "class InputValidator:\n    \"\"\"Validates the input 'n' for the sum_average function.\"\"\"\n    def validate(self, n: any) -> bool:\n        if not isinstance(n, int) or n < 1:\n            raise ValueError(\"n must be an integer >= 1\")\n        return True\n\nclass Calculator:\n    \"\"\"Performs arithmetic computations for sum and average.\"\"\"\n    def compute_sum(self, n: int) -> int:\n        \"\"\"Computes the sum of the first n natural numbers using a closed-form formula.\"\"\"\n        return n * (n + 1) // 2\n\n    def compute_average(self, sum_value: int, n: int) -> float:\n        \"\"\"Computes the average of the first n natural numbers.\"\"\"\n        return float(sum_value) / n\n\ndef sum_average(n: int) -> tuple:\n    \"\"\"\n    Finds the sum and average of the first n natural numbers.\n    Validates input and returns results as a tuple (sum:int, average:float).\n    \"\"\"\n    validator = InputValidator()\n    validator.validate(n)\n\n    calculator = Calculator()\n    sum_value = calculator.compute_sum(n)\n    avg = calculator.compute_average(sum_value, n)\n\n    return (sum_value, avg)"}
{"task_id": "Mbpp/602", "solution": "def first_repeated_char(input_str: str) -> str:\n    \"\"\"\n    Scans the input string left-to-right to find the first character that appears more than once.\n    Returns the first such repeated character.\n    \"\"\"\n    seen_chars = set()\n    for char in input_str:\n        if char in seen_chars:\n            return char\n        seen_chars.add(char)"}
{"task_id": "Mbpp/605", "solution": "import math\n\ndef prime_num(n: int) -> bool:\n    \"\"\"Validate input and return True if n is prime (per SRS BR4/BR5), else False. Raises TypeError for non-int inputs.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"prime_num: input must be an integer\")\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True"}
{"task_id": "Mbpp/603", "solution": "class InputParameter:\n    \"\"\"Encapsulates input parameter n and validates type.\"\"\"\n    def __init__(self, n):\n        self.n = n\n\n    def validate(self):\n        \"\"\"Raises TypeError if n is not an int.\"\"\"\n        if not isinstance(self.n, int):\n            raise TypeError(\"n must be an int\")\n\nclass Algorithm:\n    \"\"\"Generates ludic numbers using a sieve-like elimination process.\"\"\"\n    def generate(self, limit: int) -> list[int]:\n        \"\"\"Computes and returns all ludic numbers up to the limit.\"\"\"\n        if limit < 1:\n            return []\n\n        candidates = list(range(1, limit + 1))\n        ludic_numbers = []\n        current_idx = 0\n\n        while current_idx < len(candidates):\n            current_ludic = candidates[current_idx]\n            ludic_numbers.append(current_ludic)\n\n            if current_ludic == 1:\n                # For 1, we just take it and proceed to the next number.\n                # The \"elimination of every 1st number\" is essentially taking the next.\n                current_idx += 1\n                continue\n\n            # Eliminate every current_ludic-th number from the remaining candidates\n            # The indices for removal are 1-based relative to the *current* list.\n            # Example: if current_ludic is 2, remove 2nd, 4th, 6th...\n            # We iterate backwards to avoid issues with shifting indices.\n            new_candidates = []\n            for i, num in enumerate(candidates):\n                if (i + 1) % current_ludic != 0:\n                    new_candidates.append(num)\n            candidates = new_candidates\n\n            # Find the index of the next number to be considered as a ludic\n            # This is the first number in the new_candidates list that is greater than the last found ludic.\n            # Since numbers are always added in order and the sieve maintains order,\n            # this means we just take the first element of the new candidates list.\n            current_idx = 0 # reset index for new candidate list\n\n\n        return ludic_numbers\n\n\nclass ResultList:\n    \"\"\"Collects ludic numbers, ensures ascending order, and provides final list output.\"\"\"\n    def __init__(self):\n        self.numbers = []\n\n    def add(self, value: int):\n        self.numbers.append(value)\n\n    def sort(self):\n        self.numbers.sort()\n\n    def to_list(self) -> list[int]:\n        return list(self.numbers)\n\nclass LudicNumber:\n    \"\"\"Simple value object representing a ludic number (for domain clarity).\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n\ndef get_ludic(n):\n    \"\"\"\n    Returns all lucid numbers smaller than or equal to a given integer.\n    The function validates input, generates numbers using a sieve, and returns a sorted list.\n    \"\"\"\n    ip = InputParameter(n)\n    ip.validate()\n\n    if n < 1:\n        return []\n\n    algo = Algorithm()\n    results = algo.generate(n) # Algorithm.generate returns an ascending list\n\n    rl = ResultList()\n    for v in results:\n        rl.add(v)\n    # The algorithm already returns sorted, but for consistency with design, we re-sort.\n    rl.sort() \n    return rl.to_list()"}
