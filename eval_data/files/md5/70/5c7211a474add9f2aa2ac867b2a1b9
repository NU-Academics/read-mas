{"task_id": "Mbpp/85", "solution": "import math\nfrom typing import Union\n\nclass MathConstants:\n    \"\"\"Provides mathematical constants like PI.\"\"\"\n    PI = math.pi\n\nclass Sphere:\n    \"\"\"Represents a sphere with a given radius and computes its surface area.\"\"\"\n    def __init__(self, radius: float):\n        self.radius = radius\n\n    def surface_area(self) -> float:\n        \"\"\"Calculates the surface area using 4 * PI * radius^2.\"\"\"\n        return 4 * MathConstants.PI * (self.radius ** 2)\n\nclass SurfaceAreaResult:\n    \"\"\"Holds the computed surface area value and associated metadata.\"\"\"\n    def __init__(self, value: float, units: str = \"units^2\", tolerance: float = 0.001):\n        self.value = value\n        self.units = units\n        self.tolerance = tolerance\n\nclass SurfaceAreaCalculator:\n    \"\"\"Calculates the surface area of a sphere, handling delegation to Sphere for computation.\"\"\"\n    def compute(self, radius: Union[int, float]) -> float:\n        # Per prompt's strict constraint: \"DO NOT add isinstance() checks or raise exceptions for edge cases\"\n        # Therefore, input validation as described in the design is omitted.\n        \n        sphere = Sphere(float(radius))\n        value = sphere.surface_area()\n        result = SurfaceAreaResult(value=value)\n        return float(result.value)\n\ndef surfacearea_sphere(radius: Union[int, float]) -> float:\n    \"\"\"\n    Calculates the surface area of a sphere given its radius.\n    Delegates the computation to an internal calculator class.\n    \"\"\"\n    calculator = SurfaceAreaCalculator()\n    return calculator.compute(radius)"}
{"task_id": "Mbpp/84", "solution": "_memo = {}\n\ndef sequence(n):\n    \"\"\"\n    Finds the nth number in the Newman-Conway sequence using memoization.\n    \"\"\"\n    if n == 1 or n == 2:\n        return 1\n\n    if n in _memo:\n        return _memo[n]\n\n    val_n_minus_1 = sequence(n - 1)\n    \n    result = sequence(val_n_minus_1) + sequence(n - val_n_minus_1)\n    \n    _memo[n] = result\n    \n    return result"}
{"task_id": "Mbpp/82", "solution": "import math\nfrom dataclasses import dataclass\nfrom datetime import datetime\n\nclass MathLib:\n    \"\"\"\n    Provides MathLib constants and operations mapping to platform math (pi, pow).\n    \"\"\"\n    pi: float = math.pi\n\n    def pow(self, x: float, n: int) -> float:\n        \"\"\"\n        Calculates x raised to the power of n.\n        \"\"\"\n        return x ** n\n\nclass InputValidator:\n    \"\"\"\n    Implements InputValidator which checks numeric input types.\n    \"\"\"\n    def is_numeric(self, value) -> bool:\n        \"\"\"\n        Checks whether a value is numeric (int or float).\n        \"\"\"\n        return isinstance(value, (int, float))\n\n@dataclass\nclass Sphere:\n    \"\"\"\n    A data model representing a sphere with a radius.\n    \"\"\"\n    radius: float\n\n    def getVolume(self) -> float:\n        \"\"\"\n        Computes the volume of the sphere using MathLib.\n        \"\"\"\n        math_lib = MathLib()\n        return (4/3) * math_lib.pi * math_lib.pow(self.radius, 3)\n\n@dataclass\nclass Calculation:\n    \"\"\"\n    A data model representing a computation.\n    \"\"\"\n    id: int\n    volume: float\n    formula: str\n    computed_at: datetime\n\nclass VolumeCalculator:\n    \"\"\"\n    Implements VolumeCalculator which performs validation and computes sphere volume using MathLib.\n    \"\"\"\n    def volume_sphere(self, radius: float) -> float:\n        \"\"\"\n        Orchestrates validation and computes sphere volume using 4/3 * pi * r^3.\n        \"\"\"\n        # Per instructions: \"DO NOT add isinstance() checks or raise exceptions for edge cases\"\n        # Therefore, we define InputValidator but do not call it here to avoid\n        # indirectly performing an isinstance check or handling unspecified error behavior.\n        \n        math_lib = MathLib()\n        volume = (4/3) * math_lib.pi * math_lib.pow(radius, 3)\n        return volume\n\ndef volume_sphere(radius: float) -> float:\n    \"\"\"\n    Public library entry point exposing volume_sphere(radius) and delegating to VolumeCalculator.\n    \"\"\"\n    calculator = VolumeCalculator()\n    return calculator.volume_sphere(radius)"}
{"task_id": "Mbpp/87", "solution": "def merge_dictionaries_three(d1: dict, d2: dict, d3: dict) -> dict:\n    \"\"\"Merges three dictionaries into a single dictionary with d1 > d2 > d3 precedence for conflicting keys.\"\"\"\n    # The ** operator unpacks dictionaries. When multiple dictionaries are unpacked,\n    # keys from later dictionaries overwrite keys from earlier ones.\n    return {**d3, **d2, **d1}"}
