{"task_id": "Mbpp/751", "solution": "def check_min_heap(array):\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    Assumes 0-based indexing for the heap structure.\n    \"\"\"\n    n = len(array)\n\n    # Iterate only through parent nodes. The last parent is at index (n - 2) // 2.\n    # For n=0 or n=1, (n-2)//2 + 1 will be 0, so the loop doesn't run, correctly returning True.\n    for i in range((n - 2) // 2 + 1):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n:\n            if array[i] > array[left_child_idx]:\n                return False\n\n        # Check right child\n        if right_child_idx < n:\n            if array[i] > array[right_child_idx]:\n                return False\n\n    return True"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Computes the nth Jacobsthal number using an iterative approach.\n    Raises ValueError if n is not a non-negative integer.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    else:\n        a, b = 0, 1  # J(0) and J(1)\n        for _ in range(2, n + 1):\n            next_jacobsthal = b + 2 * a\n            a = b\n            b = next_jacobsthal\n        return b"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"Return list of values v such that for some index i, l1[i] == l2[i] == l3[i] == v.\n\n    Parameters must be named and used exactly as: l1, l2, l3 (per SRS).\n    \"\"\"\n    min_len = min(len(l1), len(l2), len(l3))\n    result = []\n    for i in range(min_len):\n        if l1[i] == l2[i] == l3[i]:\n            result.append(l1[i])\n    return result"}
{"task_id": "Mbpp/755", "solution": "from typing import List\n\nNumberList = List[float]\n\ndef second_smallest(numbers: NumberList) -> float:\n    \"\"\"Accepts a single argument (list of numbers) and returns the second element in ascending-sorted order (duplicates counted).\"\"\"\n    sorted_numbers = sorted(numbers)\n    return sorted_numbers[1]"}
{"task_id": "Mbpp/753", "solution": "from typing import List, Tuple\n\ndef min_k(tuples: List[tuple], k: int) -> List[tuple]:\n    \"\"\"\n    Finds the minimum k records from a list of tuples, sorted by the second element.\n    Raises ValueError for malformed input tuples or non-numeric second elements.\n    \"\"\"\n    if k <= 0:\n        return []\n\n    processed_records: List[Tuple[str, float]] = []\n    for i, t in enumerate(tuples):\n        if not isinstance(t, tuple) or len(t) < 2:\n            raise ValueError(f\"Tuple at index {i} is malformed or has fewer than 2 elements: {t}\")\n        try:\n            value = float(t[1])\n        except (TypeError, ValueError):\n            raise ValueError(f\"Second element of tuple at index {i} ('{t[1]}') is not a numeric value. Original tuple: {t}\")\n        \n        processed_records.append((str(t[0]), value))\n\n    # Sort the records by their numeric value in ascending order.\n    # Python's sorted() is a stable sort.\n    sorted_records = sorted(processed_records, key=lambda x: x[1])\n\n    # Determine how many records to return, up to k or the total number of records.\n    num_to_return = min(k, len(sorted_records))\n\n    return sorted_records[:num_to_return]"}
{"task_id": "Mbpp/759", "solution": "import re\n\nclass DecimalValidator:\n    \"\"\"\n    Internal class encapsulating the regex pattern and matching logic.\n    The regex is compiled once as a class attribute for efficiency.\n    \"\"\"\n    pattern = r'^[0-9]+\\.[0-9]{2}$'\n    _compiled_regex = re.compile(pattern)\n\n    def is_decimal(self, input_string: str) -> bool:\n        \"\"\"\n        Checks if the given string is a decimal number with exactly two digits after the decimal point.\n        Uses re.fullmatch to ensure the entire string matches the pattern.\n        \"\"\"\n        return self._compiled_regex.fullmatch(input_string) is not None\n\ndef is_decimal(input_string):\n    \"\"\"\n    Checks if a given string is a decimal number with a precision of 2.\n    The function strictly matches the pattern '^[0-9]+\\.[0-9]{2}$'.\n    \"\"\"\n    validator = DecimalValidator()\n    return validator.is_decimal(input_string)"}
