{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list):\n    \"\"\"Return a new list where every maximal run of consecutive elements equal by '==' is collapsed to a single element.\n\n    Parameters:\n      input_list (list): input list of elements supporting equality (==).\n\n    Returns:\n      list: a new list instance with consecutive duplicates collapsed.\n    \"\"\"\n    if not input_list:\n        return []\n    output = []\n    prev = object()  # sentinel distinct from any element\n    for elem in input_list:\n        if elem != prev:\n            output.append(elem)\n            prev = elem\n    return output"}
{"task_id": "Mbpp/728", "solution": "from typing import Sequence, List\nimport numbers\n\nclass Error(Exception):\n    \"\"\"Represents a validation or runtime error with a descriptive message.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\n    def __str__(self) -> str:\n        return f\"Error: {self.message}\"\n\nclass InputList:\n    \"\"\"Wrapper around a provided sequence exposing length and element access.\"\"\"\n    def __init__(self, elements: Sequence[numbers.Number]) -> None:\n        self.elements = list(elements)\n        self.length = len(self.elements)\n\n    def get_element(self, i: int) -> numbers.Number:\n        \"\"\"Returns the element at the given index.\"\"\"\n        return self.elements[i]\n\nclass ResultList:\n    \"\"\"Domain representation of computed result list; exposes conversion to plain Python list.\"\"\"\n    def __init__(self, elements: Sequence[numbers.Number]) -> None:\n        self.elements = list(elements)\n        self.length = len(self.elements)\n\n    def to_list(self) -> List[numbers.Number]:\n        \"\"\"Converts the ResultList to a plain Python list.\"\"\"\n        return self.elements\n\nclass Validator:\n    \"\"\"Enforces preconditions: lists must have equal lengths, and element pairs must be addable.\"\"\"\n    def validate_lengths(self, a: InputList, b: InputList) -> None:\n        \"\"\"Raises Error if input lists have mismatched lengths.\"\"\"\n        if a.length != b.length:\n            raise Error(f\"mismatched lengths: len(a)={a.length}, len(b)={b.length}\")\n\n    def validate_elements_numeric(self, a: InputList, b: InputList) -> None:\n        \"\"\"Raises Error if any pair of elements is not numeric.\"\"\"\n        for i in range(a.length):\n            el_a = a.get_element(i)\n            el_b = b.get_element(i)\n            if not isinstance(el_a, numbers.Number) or not isinstance(el_b, numbers.Number):\n                raise Error(f\"non-addable elements at index {i}: '{el_a}' (type {type(el_a).__name__}) and '{el_b}' (type {type(el_b).__name__}) are not both numeric\")\n\nclass SumFunction:\n    \"\"\"Computes element-wise sums, using Validator for input checks.\"\"\"\n    def __init__(self, validator: Validator = None) -> None:\n        self.validator = validator if validator is not None else Validator()\n\n    def compute(self, a: InputList, b: InputList) -> ResultList:\n        \"\"\"Performs element-wise sum after validating inputs.\"\"\"\n        self.validator.validate_lengths(a, b)\n        if a.length > 0:\n            self.validator.validate_elements_numeric(a, b)\n\n        result_elements: List[numbers.Number] = []\n        for i in range(a.length):\n            result_elements.append(a.get_element(i) + b.get_element(i))\n        return ResultList(result_elements)\n\ndef sum_list(a: Sequence[numbers.Number], b: Sequence[numbers.Number]) -> List[numbers.Number]:\n    \"\"\"\n    Takes two lists [a_1,...,a_n], [b_1,...,b_n] and returns [a_1+b_1,...,a_n+b_n].\n    Validates input lengths and element types before performing the element-wise sum.\n    \"\"\"\n    input_a = InputList(a)\n    input_b = InputList(b)\n\n    validator_instance = Validator()\n    sum_function_instance = SumFunction(validator=validator_instance)\n\n    result_list = sum_function_instance.compute(input_a, input_b)\n\n    return result_list.to_list()"}
{"task_id": "Mbpp/731", "solution": "import math\n\ndef lateralsurface_cone(r: float, h: float) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cone.\n    \"\"\"\n    # Calculate the slant height (l) using the Pythagorean theorem.\n    l = math.sqrt(r**2 + h**2)\n    # Calculate the lateral surface area using the formula: PI * r * l.\n    area = math.pi * r * l\n    return area"}
{"task_id": "Mbpp/732", "solution": "class ReplacementRule:\n    \"\"\"Encapsulates target character set and replacement character.\"\"\"\n    def __init__(self, targets: set[str], replacement: str) -> None:\n        self.targets = targets\n        self.replacement = replacement\n\n    def appliesTo(self, c: str) -> bool:\n        \"\"\"Checks if a character is one of the target characters.\"\"\"\n        return c in self.targets\n\nclass InputString:\n    \"\"\"Lightweight wrapper for the input string.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the input string.\"\"\"\n        return len(self.value)\n\nclass OutputString:\n    \"\"\"Build and hold the output string.\"\"\"\n    def __init__(self) -> None:\n        self._chars: list[str] = []\n\n    def append(self, s: str) -> None:\n        \"\"\"Appends a character to the output string.\"\"\"\n        self._chars.append(s)\n\n    def length(self) -> int:\n        \"\"\"Returns the current length of the output string.\"\"\"\n        return len(self._chars)\n\n    def __str__(self) -> str:\n        \"\"\"Returns the joined output string.\"\"\"\n        return \"\".join(self._chars)\n\nclass Character:\n    \"\"\"Represent a single-character value and test against ReplacementRule.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def isTarget(self, rule: 'ReplacementRule') -> bool:\n        \"\"\"Checks if this character is a target for replacement.\"\"\"\n        return rule.appliesTo(self.value)\n\nclass ReplaceSpecialcharFunction:\n    \"\"\"Business logic; iterate input characters, apply replacement rule, build output.\"\"\"\n    def __init__(self, rule: ReplacementRule) -> None:\n        self._rule = rule\n\n    def validateInput(self, input: str) -> None:\n        \"\"\"Validates input (no-op due to constraints).\"\"\"\n        pass # Per explicit constraint: \"DO NOT add isinstance() checks or raise exceptions for edge cases\"\n\n    def execute(self, input_str: str) -> str:\n        \"\"\"Processes the input string to replace special characters.\"\"\"\n        self.validateInput(input_str)\n        \n        output_obj = OutputString()\n\n        for char_value in input_str:\n            char_obj = Character(char_value)\n            if char_obj.isTarget(self._rule):\n                output_obj.append(self._rule.replacement)\n            else:\n                output_obj.append(char_value)\n        \n        return str(output_obj)\n\ndef replace_specialchar(input: str) -> str:\n    \"\"\"\n    Replaces all occurrences of spaces, commas, or dots with a colon.\n    \"\"\"\n    target_chars = {' ', ',', '.'}\n    replacement_char = ':'\n    \n    rule = ReplacementRule(target_chars, replacement_char)\n    processor = ReplaceSpecialcharFunction(rule)\n    \n    return processor.execute(input)"}
{"task_id": "Mbpp/733", "solution": "from typing import List, Union\n\nNumber = Union[int, float]\n\ndef find_first_occurrence(array: List[Number], target: Number) -> int:\n    \"\"\"Return the zero-based index of the first occurrence of target in array.\n    Preconditions: array is sorted.\"\"\"\n    low = 0\n    high = len(array) - 1\n    first_occurrence_index = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            first_occurrence_index = mid\n            high = mid - 1  # Try to find an earlier occurrence in the left half\n        elif array[mid] < target:\n            low = mid + 1   # Target is in the right half\n        else: # array[mid] > target\n            high = mid - 1  # Target is in the left half\n\n    return first_occurrence_index"}
{"task_id": "Mbpp/734", "solution": "def product_of_list(lst):\n    \"\"\"Return product of elements in lst.\"\"\"\n    prod = 1\n    for x in lst:\n        prod *= x\n    return prod\n\ndef generate_contiguous_subarrays(input_list):\n    \"\"\"Yield contiguous non-empty sublists (as lists) of input_list.\"\"\"\n    n = len(input_list)\n    for i in range(n):\n        for j in range(i, n):\n            yield input_list[i : j + 1]\n\ndef sum_Of_Subarray_Prod(input_list):\n    \"\"\"Compute sum of products of all contiguous non-empty subarrays.\n    Args: input_list: list\n    Returns: int when input elements are integers\n    \"\"\"\n    total_sum = 0\n    for subarray in generate_contiguous_subarrays(input_list):\n        total_sum += product_of_list(subarray)\n    return total_sum"}
{"task_id": "Mbpp/735", "solution": "class Validator:\n    \"\"\"Provides static methods for input validation, ensuring integers are of correct type and non-negative.\"\"\"\n    @staticmethod\n    def validate_integer(n):\n        if not isinstance(n, int):\n            raise TypeError(\"Input must be an integer.\")\n\n    @staticmethod\n    def validate_non_negative(n):\n        if n < 0:\n            raise ValueError(\"Input must be a non-negative integer.\")\n\n\nclass BinaryRepresentation:\n    \"\"\"Converts integers to binary string representations and provides properties for bit length and indices of MSB/LSB.\"\"\"\n    def __init__(self, n_int):\n        self._n = n_int\n        if n_int == 0:\n            self._bits = '0'\n            self._length = 1\n            self._msb_index = 0\n            self._lsb_index = 0\n        else:\n            self._bits = bin(n_int)[2:]\n            self._length = len(self._bits)\n            # msb_index is 0-based from the right (LSB is index 0)\n            self._msb_index = self._length - 1\n            # lsb_index is 0-based position of the least-significant SET bit\n            self._lsb_index = (n_int & -n_int).bit_length() - 1\n\n    @staticmethod\n    def from_int(n):\n        return BinaryRepresentation(n)\n\n    @property\n    def bits(self):\n        return self._bits\n\n    def length(self):\n        return self._length\n\n    @property\n    def msb_index(self):\n        return self._msb_index\n\n    @property\n    def lsb_index(self):\n        return self._lsb_index\n\n\nclass BitManipulator:\n    \"\"\"Offers static methods to construct a bitmask for middle bits and apply it via XOR operation.\"\"\"\n    @staticmethod\n    def build_toggle_mask(msb_index, lsb_index):\n        # If there are fewer than two bits strictly between MSB and LSB, no bits to toggle.\n        if msb_index - lsb_index < 2:\n            return 0\n        \n        # Create a mask with all bits from 0 to msb_index-1 set to 1.\n        mask_up_to_msb_exclusive = (1 << msb_index) - 1\n        \n        # Create a mask with all bits from 0 to lsb_index set to 1.\n        mask_up_to_lsb_inclusive = (1 << (lsb_index + 1)) - 1\n        \n        # XORing these two masks isolates the bits strictly between lsb_index and msb_index.\n        return mask_up_to_msb_exclusive ^ mask_up_to_lsb_inclusive\n\n    @staticmethod\n    def apply_mask(n, mask):\n        return n ^ mask\n\n\ndef toggle_middle_bits(n):\n    \"\"\"Toggles bits of a number except the most-significant and least-significant set bits.\n    Handles validation and edge cases for bit length, returning the result as an integer.\"\"\"\n    Validator.validate_integer(n)\n    Validator.validate_non_negative(n)\n\n    br = BinaryRepresentation.from_int(n)\n\n    # If the number has fewer than 3 bits, there are no \"middle\" bits to toggle.\n    if br.length() < 3:\n        return n\n\n    mask = BitManipulator.build_toggle_mask(br.msb_index, br.lsb_index)\n    toggled_value = BitManipulator.apply_mask(n, mask)\n\n    return toggled_value"}
{"task_id": "Mbpp/737", "solution": "import re\n\nVOWEL_PATTERN: str = r'^[aeiou]'\n\ndef check_str(input: str) -> bool:\n    \"\"\"Return True if input starts with a vowel (a,e,i,o,u) using regex match against VOWEL_PATTERN.\"\"\"\n    if not isinstance(input, str):\n        return False\n    if input == \"\":\n        return False\n    return re.match(VOWEL_PATTERN, input) is not None"}
{"task_id": "Mbpp/736", "solution": "def _binary_search_left(sorted_sequence, value, lo, hi) -> int:\n    \"\"\"\n    Internal helper for binary searching the leftmost index for insertion.\n    Returns the smallest index i in [lo, hi) such that sorted_sequence[i] >= value.\n    \"\"\"\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if sorted_sequence[mid] < value:\n            lo = mid + 1\n        else:\n            hi = mid\n    return lo\n\ndef left_insertion(sorted_sequence, value) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in sorted order.\n    Uses an internal binary search helper for efficient lookup.\n    \"\"\"\n    n = len(sorted_sequence)\n\n    if n == 0:\n        return 0\n\n    if value < sorted_sequence[0]:\n        return 0\n\n    if value > sorted_sequence[-1]:\n        return n\n\n    return _binary_search_left(sorted_sequence, value, 0, n)"}
{"task_id": "Mbpp/739", "solution": "import math\n\nclass InputParameter:\n    def __init__(self, n: int):\n        self.n = n\n\nclass Result:\n    def __init__(self, index: int, triangularValue: int):\n        self.index = index\n        self.triangularValue = triangularValue\n\nclass TriangularNumber:\n    def __init__(self, k: int):\n        self.k = k\n        self.value = 0 # Will be computed on demand\n    \n    def computeValue(self) -> int:\n        self.value = self.k * (self.k + 1) // 2\n        return self.value\n    \n    def digitCount(self) -> int:\n        # Assumes value has been computed and is positive\n        if self.value == 0:\n            return 1\n        return len(str(self.value))\n\nclass TriangularNumberCalculator:\n    def find_Index(self, n: int) -> int:\n        if not self._is_valid_input(n):\n            raise ValueError(\"Input n must be an integer and n >= 1.\")\n        \n        k = 1\n        while True:\n            triangular = TriangularNumber(k)\n            triangular_value = triangular.computeValue()\n            \n            digit_count = triangular.digitCount()\n            \n            if digit_count == n:\n                # Found the smallest k\n                # Result object is for internal consistency, only index is returned\n                _ = Result(index=k, triangularValue=triangular_value) \n                return k\n            \n            # The digit count of triangular numbers is non-decreasing.\n            # If digit_count > n, it means we've overshot without finding an exact match.\n            # This shouldn't happen for valid n, as triangular numbers grow to have any number of digits.\n            # However, for robustness, if we wanted to handle cases where no such number *exactly* has n digits\n            # (e.g., if we were looking for a non-existent pattern), we might need different logic.\n            # For this problem, we are guaranteed to find one.\n\n            k += 1\n\n    def _is_valid_input(self, n: int) -> bool:\n        # Validate that n is an integer and n >= 1.\n        return isinstance(n, int) and n >= 1\n\n    def _digit_count(self, value: int) -> int:\n        # Compute decimal digit count for a positive integer value.\n        if value == 0:\n            return 1\n        return len(str(value))\n\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    Delegates the computation to TriangularNumberCalculator.\n    \"\"\"\n    calculator = TriangularNumberCalculator()\n    return calculator.find_Index(n)"}
