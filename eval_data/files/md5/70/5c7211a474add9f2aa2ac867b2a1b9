{"task_id": "Mbpp/566", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for invalid input.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass IntegerInput:\n    \"\"\"Represents an input value and provides validation methods.\"\"\"\n    def __init__(self, value) -> None:\n        self.value = value\n\n    def isInteger(self) -> bool:\n        \"\"\"Checks if the stored value is an integer.\"\"\"\n        return isinstance(self.value, int)\n\n    def isNonNegative(self) -> bool:\n        \"\"\"Checks if the stored value is an integer and non-negative.\"\"\"\n        return self.isInteger() and self.value >= 0\n\nclass Digit:\n    \"\"\"Represents a single decimal digit and its position.\"\"\"\n    def __init__(self, value: int, position: int) -> None:\n        self.value = value\n        self.position = position\n\nclass Result:\n    \"\"\"Holds the final sum integer.\"\"\"\n    def __init__(self, sum: int) -> None:\n        self.sum = sum\n\nclass DigitExtractor:\n    \"\"\"Extracts decimal digits from a non-negative integer and emits Digit objects.\"\"\"\n    def extract(self, n: int) -> list[Digit]:\n        \"\"\"Extracts digits from n, returning them as a list of Digit objects.\"\"\"\n        if n == 0:\n            return [Digit(0, 0)]\n\n        digits_list = []\n        position = 0\n        temp_n = n\n        while temp_n > 0:\n            digit_value = temp_n % 10\n            digits_list.append(Digit(digit_value, position))\n            temp_n //= 10\n            position += 1\n        return digits_list\n\ndef extract_digits(n: int) -> list[Digit]:\n    \"\"\"Convenience wrapper for DigitExtractor.extract.\"\"\"\n    return DigitExtractor().extract(n)\n\nclass SumCalculator:\n    \"\"\"Sums Digit.value fields and returns a Result.\"\"\"\n    def calculate(self, digits: list[Digit]) -> Result:\n        \"\"\"Calculates the sum of digit values from a list of Digit objects.\"\"\"\n        total_sum = 0\n        for digit in digits:\n            total_sum += digit.value\n        return Result(total_sum)\n\ndef calculate_sum_from_digits(digits: list[Digit]) -> Result:\n    \"\"\"Convenience wrapper for SumCalculator.calculate.\"\"\"\n    return SumCalculator().calculate(digits)\n\ndef sum_digits(n):\n    \"\"\"\n    Calculates the sum of the digits of a non-negative integer.\n    Validates input and raises ValidationError for invalid input.\n    \"\"\"\n    wrapper = IntegerInput(n)\n\n    if not wrapper.isInteger() or not wrapper.isNonNegative():\n        raise ValidationError(\"input must be an integer >= 0\")\n\n    digits = extract_digits(n)\n    result = calculate_sum_from_digits(digits)\n    return result.sum"}
{"task_id": "Mbpp/567", "solution": "from typing import List, Any\n\ndef issort_list(lst: List[Any]) -> bool:\n    \"\"\"Checks if a list is sorted in non-decreasing order.\"\"\"\n    if len(lst) <= 1:\n        return True\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n    return True"}
{"task_id": "Mbpp/569", "solution": "def sort_sublists(list_of_lists: list[list[str]]) -> list[list[str]]:\n    \"\"\"Sort each inner sublist in ascending lexicographic order.\n    The outer list's order is preserved, and sorting is done in-place for each sublist.\n    \"\"\"\n    for sublist in list_of_lists:\n        sublist.sort()\n    return list_of_lists"}
{"task_id": "Mbpp/573", "solution": "from typing import List, Union, Iterable\n\ndef _extract_unique_numbers(input_list: list) -> set:\n    \"\"\"Extracts a deterministic set of unique values from the input list.\n    No explicit type checks are performed as per problem constraints.\n    \"\"\"\n    unique_nums = set()\n    for item in input_list:\n        unique_nums.add(item)\n    return unique_nums\n\ndef _product_of_iterable(iterable: Iterable) -> Union[int, float]:\n    \"\"\"Computes the product of all elements in the given iterable.\n    Returns 1 for an empty iterable as a mathematical convention.\n    \"\"\"\n    product = 1\n    for num in iterable:\n        product *= num\n    return product\n\ndef unique_product(input_list: list) -> Union[int, float]:\n    \"\"\"Compute product of unique numeric values from input_list and return numeric (int or float).\n\n    Parameters:\n      input_list: list -- Python list containing numeric elements (int or float) as specified by SRS.\n\n    Returns:\n      int or float -- product of unique numeric values.\n    \"\"\"\n    unique_values = _extract_unique_numbers(input_list)\n    result = _product_of_iterable(unique_values)\n    return result"}
{"task_id": "Mbpp/572", "solution": "from typing import List, Dict\n\ndef validate_input(input_list: List[int]) -> None:\n    \"\"\"Validate that input_list is a list of integers.\"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n    if not all(isinstance(item, int) for item in input_list):\n        raise TypeError(\"All elements in the input list must be integers.\")\n\ndef _count_occurrences(input_list: List[int]) -> Dict[int, int]:\n    \"\"\"Return a dictionary mapping each distinct integer to its occurrence count.\"\"\"\n    counts = {}\n    for num in input_list:\n        counts[num] = counts.get(num, 0) + 1\n    return counts\n\ndef two_unique_nums(input_list: List[int]) -> List[int]:\n    \"\"\"\n    Returns a list of numbers that occur exactly once in the input list,\n    preserving their original relative order.\n    \"\"\"\n    validate_input(input_list)\n    occurrence_map = _count_occurrences(input_list)\n    \n    result = []\n    for num in input_list:\n        if occurrence_map[num] == 1:\n            result.append(num)\n            \n    return result"}
{"task_id": "Mbpp/576", "solution": "# Helper function to check if list_b matches a window of list_a starting at 'start'.\ndef _match_at(list_a, list_b, start) -> bool:\n    \"\"\"\n    Compares list_b against a window of list_a starting at 'start_idx' in list_a.\n    Returns True if all elements match, otherwise False.\n    \"\"\"\n    # An empty list_b is considered a match.\n    if not list_b:\n        return True\n    \n    # This bounds check is technically redundant if the calling loop is correct,\n    # but provides defensive programming if called directly.\n    if start + len(list_b) > len(list_a):\n        return False\n\n    # Perform element-wise comparison for the window.\n    for i in range(len(list_b)):\n        if list_a[start + i] != list_b[i]:\n            return False\n    return True\n\n# Stateless class to encapsulate the sublist checking logic.\nclass SublistChecker:\n    \"\"\"\n    A stateless class responsible for performing the contiguous sublist check.\n    It contains a static method to determine if one list is a sublist of another.\n    \"\"\"\n    @staticmethod\n    def is_Sub_Array(list_a, list_b) -> bool:\n        \"\"\"\n        Checks if list_b is a contiguous sublist of list_a.\n        It handles short-circuit conditions and iterates through potential start positions.\n        \"\"\"\n        # Short-circuit 1: If the potential sublist is longer than the main list, it cannot be a sublist.\n        if len(list_b) > len(list_a):\n            return False\n        \n        # Short-circuit 2: An empty list is always considered a sublist.\n        if not list_b:\n            return True\n\n        # Iterate through all possible starting positions for list_b within list_a.\n        # The range includes the last possible starting index.\n        for start_idx in range(len(list_a) - len(list_b) + 1):\n            if _match_at(list_a, list_b, start_idx):\n                return True  # A match was found at this position.\n\n        return False  # No match found after checking all possible positions.\n\n# Public API function as per the design.\ndef is_Sub_Array(list_a, list_b) -> bool:\n    \"\"\"\n    Public API to check whether a list (list_b) is a contiguous sublist of another (list_a).\n    This function delegates the core logic to the SublistChecker class.\n    \"\"\"\n    return SublistChecker.is_Sub_Array(list_a, list_b)"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n):\n    \"\"\"Return the last decimal digit of n! as an int in 0..9.\n\n    Behavior per SRS:\n    - If n < 0: raise ValueError\n    - If n >= 5: return 0\n    - Else compute factorial(n) and return factorial % 10\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    elif n >= 5:\n        return 0\n    else:\n        # For n in [0, 1, 2, 3, 4], compute n! and return the last digit.\n        if n == 0:\n            return 1 # 0! = 1\n        elif n == 1:\n            return 1 # 1! = 1\n        elif n == 2:\n            return 2 # 2! = 2\n        elif n == 3:\n            return 6 # 3! = 6\n        elif n == 4:\n            return 4 # 4! = 24, last digit is 4"}
{"task_id": "Mbpp/578", "solution": "from typing import List, Any\n\ndef _ensure_equal_length(l1: List[Any], l2: List[Any], l3: List[Any]) -> None:\n    \"\"\"Validates that all three input lists have the same length.\"\"\"\n    if not (len(l1) == len(l2) == len(l3)):\n        raise ValueError('Input lists must have equal length')\n\ndef interleave_lists(l1: List[Any], l2: List[Any], l3: List[Any]) -> List[Any]:\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Elements are taken in order l1[i], l2[i], l3[i] for each index i.\n    \"\"\"\n    _ensure_equal_length(l1, l2, l3)\n\n    result: List[Any] = []\n    list_length = len(l1)\n\n    for i in range(list_length):\n        result.append(l1[i])\n        result.append(l2[i])\n        result.append(l3[i])\n\n    return result"}
{"task_id": "Mbpp/579", "solution": "class SymmetricDifferenceOperation:\n    \"\"\"Helper class to compute the symmetric difference of two tuples.\"\"\"\n    @staticmethod\n    def compute(tuple1: tuple, tuple2: tuple) -> list:\n        \"\"\"\n        Returns an ordered list of unique elements present in exactly one input tuple.\n        Elements unique to tuple1 come first, in their first-occurrence order,\n        followed by elements unique to tuple2, in their first-occurrence order.\n        \"\"\"\n        set1 = set(tuple1)\n        set2 = set(tuple2)\n        result_elements = []\n        seen_in_result = set()\n\n        for element in tuple1:\n            if element not in set2 and element not in seen_in_result:\n                result_elements.append(element)\n                seen_in_result.add(element)\n\n        for element in tuple2:\n            if element not in set1 and element not in seen_in_result:\n                result_elements.append(element)\n                seen_in_result.add(element)\n        \n        return result_elements\n\ndef find_dissimilar(tuple1, tuple2) -> tuple:\n    \"\"\"\n    Finds the dissimilar elements in two given tuples, preserving order and uniqueness.\n    It returns elements present in exactly one input tuple, first from tuple1 then from tuple2.\n    \"\"\"\n    return tuple(SymmetricDifferenceOperation.compute(tuple1, tuple2))"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"Return a new tuple with odd integers removed at all nesting levels.\n\n    Raises TypeError if input_tuple is not a tuple or if any element is neither int nor tuple.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    def _recurse(elements: tuple) -> tuple:\n        current_level_result = []\n        for item in elements:\n            if isinstance(item, int):\n                if item % 2 == 0:\n                    current_level_result.append(item)\n            elif isinstance(item, tuple):\n                current_level_result.append(_recurse(item))\n            else:\n                raise TypeError(\"Elements must be integers or tuples.\")\n        return tuple(current_level_result)\n\n    return _recurse(input_tuple)"}
{"task_id": "Mbpp/583", "solution": "class InvalidInputError(Exception):\n    \"\"\"Raised when input n is not a non-negative integer.\"\"\"\n    pass\n\ndef catalan_number(n):\n    \"\"\"Compute and return the nth Catalan number as an exact int.\n    Raises InvalidInputError if n is not a non-negative integer.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise InvalidInputError(\"Input must be a non-negative integer.\")\n\n    if n == 0:\n        return 1\n\n    catalan = [0] * (n + 1)\n    catalan[0] = 1\n\n    for i in range(1, n + 1):\n        current_catalan_i = 0\n        for j in range(i):\n            current_catalan_i += catalan[j] * catalan[i - 1 - j]\n        catalan[i] = current_catalan_i\n        \n    return catalan[n]"}
