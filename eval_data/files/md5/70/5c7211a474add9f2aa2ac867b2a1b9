{"task_id": "Mbpp/478", "solution": "from typing import Iterator\n\nclass Character:\n    def __init__(self, char: str) -> None:\n        self.char = char\n\n    def is_lowercase(self) -> bool:\n        \"\"\"Returns True if the character is an ASCII lowercase letter.\"\"\"\n        return 'a' <= self.char <= 'z'\n\nclass InputString:\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def __iter__(self) -> Iterator[str]:\n        \"\"\"Allows iteration over the characters of the input string.\"\"\"\n        return iter(self.value)\n\nclass OutputString:\n    def __init__(self, value: str) -> None:\n        self.value = value\n\nclass RemoveLowercaseService:\n    def remove_lowercase(self, input_string: str) -> str:\n        \"\"\"Removes all ASCII lowercase characters from the input string.\"\"\"\n        input_obj = InputString(input_string)\n        result_chars = []\n        for char_str in input_obj:\n            character_obj = Character(char_str)\n            if not character_obj.is_lowercase():\n                result_chars.append(char_str)\n        \n        output_value = \"\".join(result_chars)\n        output_obj = OutputString(output_value)\n        return output_obj.value\n\ndef remove_lowercase(input_string: str) -> str:\n    \"\"\"Removes all ASCII lowercase characters from the input string using the service layer.\"\"\"\n    service = RemoveLowercaseService()\n    return service.remove_lowercase(input_string)"}
{"task_id": "Mbpp/479", "solution": "def first_Digit(number):\n    \"\"\"Compute and return the most significant (first) digit of integer 'number'.\n\n    This function finds the first digit by repeatedly dividing the absolute value of\n    the number by 10 until it's a single-digit number.\n    \"\"\"\n    num_abs = abs(number)\n\n    if num_abs == 0:\n        return 0\n\n    while num_abs >= 10:\n        num_abs //= 10\n    return num_abs"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr, n):\n    \"\"\"\n    Counts pairs in the array whose XOR sum is odd.\n    Clamps n to be within the valid index range of arr.\n    \"\"\"\n    count = 0\n    # Clamp n to avoid index errors and handle various input scenarios for n\n    n = max(0, min(int(n), len(arr)))\n\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            xor_value = arr[i] ^ arr[j]\n            if xor_value % 2 == 1:\n                count += 1\n    return count"}
{"task_id": "Mbpp/555", "solution": "class NaturalNumberSequence:\n    \"\"\"Holds the natural number n for sequence calculations.\"\"\"\n    def __init__(self, n: int) -> None:\n        self.n = n\n\nclass SumOfNumbers:\n    \"\"\"Computes the sum of the first n natural numbers.\"\"\"\n    def compute(self, seq: NaturalNumberSequence) -> int:\n        return (seq.n * (seq.n + 1)) // 2\n\nclass SumOfCubes:\n    \"\"\"Computes the sum of the cubes of the first n natural numbers.\"\"\"\n    def compute(self, seq: NaturalNumberSequence) -> int:\n        # Formula: ((n * (n + 1) // 2) ** 2)\n        sum_of_numbers = SumOfNumbers().compute(seq)\n        return sum_of_numbers ** 2\n\nclass Result:\n    \"\"\"A container for the final computed integer result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\ndef difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    # Input validation (type and value) is omitted as per specific requirements.\n\n    seq = NaturalNumberSequence(n)\n    sum_numbers = SumOfNumbers().compute(seq)\n    sum_cubes = SumOfCubes().compute(seq)\n    diff = sum_cubes - sum_numbers\n    \n    result_obj = Result(diff)\n    return result_obj.value"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string: str) -> str:\n    \"\"\"\n    Toggles the case of all alphabetic characters in a string.\n    Non-alphabetic characters remain unchanged.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"input_string must be a str\")\n\n    if not input_string:\n        return \"\"\n\n    result_chars = []\n    for char in input_string:\n        if char.isalpha():\n            if char.isupper():\n                result_chars.append(char.lower())\n            else:\n                result_chars.append(char.upper())\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(list_of_numbers, n):\n    \"\"\"\n    Finds the sum of the largest contiguous sublist using Kadane's algorithm.\n    Validates input length and handles empty lists as specified.\n    \"\"\"\n    if n != len(list_of_numbers):\n        raise ValueError(\"Input length 'n' does not match the actual list length.\")\n\n    if n == 0:\n        return 0\n\n    # Initialize current_max and global_max with the first element for non-empty lists\n    current_max = list_of_numbers[0]\n    global_max = list_of_numbers[0]\n\n    # Iterate through the rest of the list\n    for i in range(1, n):\n        current_max = max(list_of_numbers[i], current_max + list_of_numbers[i])\n        global_max = max(global_max, current_max)\n\n    return global_max"}
