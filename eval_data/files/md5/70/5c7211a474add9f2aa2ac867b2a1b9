{"task_id": "Mbpp/607", "solution": "import re\nfrom typing import Optional, Tuple\n\ndef find_literals(text: str, pattern: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Searches a string for a regex pattern and returns the first match found,\n    including the substring and its start and end indices.\n    \"\"\"\n    match = re.search(pattern, text)\n    if match:\n        return (match.group(0), match.start(), match.end())\n    return None"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"Compute and return the nth Bell number using dynamic programming.\n    This implementation constructs the Bell triangle row by row.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Initialize a 2D list for the Bell triangle, where bell[i][j] is the j-th element of row i.\n    # The Bell number B_i is stored in bell[i][0].\n    bell = [[0] * (i + 1) for i in range(n + 1)]\n\n    bell[0][0] = 1  # Base case: B_0 = 1\n\n    for i in range(1, n + 1):\n        # The first element of row i is the last element of the previous row (i-1).\n        bell[i][0] = bell[i-1][i-1]\n        for j in range(1, i + 1):\n            # Other elements are the sum of the element to their left in the current row\n            # and the element directly above-left in the previous row.\n            bell[i][j] = bell[i][j-1] + bell[i-1][j-1]\n\n    return bell[n][0]"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(lst, k):\n    \"\"\"\n    Remove the k'th element from lst using 1-based indexing and return a new list.\n\n    Parameters:\n    - lst: list (Python list) \u2014 input list\n    - k: int \u2014 1-based index of element to remove\n\n    Returns:\n    - list: a new list equal to lst with the element at 1-based position k removed\n    \"\"\"\n    # Convert 1-based k to 0-based index\n    idx = k - 1\n    # Construct a new list by concatenating slices before and after the removed element\n    return lst[:idx] + lst[idx+1:]"}
{"task_id": "Mbpp/612", "solution": "from typing import Any, List, Sequence, Tuple\n\ndef validate(input_list: Any) -> None:\n    \"\"\"Raise TypeError if input_list is not a list; raise ValueError if any element is not a sequence of length 2.\"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n    \n    for sublist in input_list:\n        try:\n            if len(sublist) != 2:\n                raise ValueError(\"Each sublist must contain exactly two elements.\")\n        except TypeError:\n            raise ValueError(\"Each element in the input list must be a sequence of exactly two elements.\")\n\ndef split(input_list: List[Sequence[Any]]) -> Tuple[List[Any], List[Any]]:\n    \"\"\"Return (first_list, second_list) extracted from input_list without mutating input_list.\"\"\"\n    first_elements = []\n    second_elements = []\n    for sublist in input_list:\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n    return first_elements, second_elements\n\ndef merge(input_list: Any) -> List[List[Any]]:\n    \"\"\"Public API: validate(input_list) then return [first_list, second_list].\"\"\"\n    validate(input_list)\n    first_list, second_list = split(input_list)\n    return [first_list, second_elements]"}
{"task_id": "Mbpp/611", "solution": "from typing import Any, List\n\ndef max_of_nth(matrix: List[List[Any]], n: int) -> Any:\n    \"\"\"Return the maximum value of the nth column (zero-based) from matrix.\n\n    Extract row[n] for each row in matrix and return the maximum element, preserving its type.\n    \"\"\"\n    values = [row[n] for row in matrix]\n    return max(values)"}
{"task_id": "Mbpp/614", "solution": "def cummulative_sum(input_list):\n    \"\"\"\n    Calculates the cumulative sum of all numeric values in a list of tuples.\n    This function sums all numbers present within the nested tuples.\n    \"\"\"\n    total_sum = 0\n    for tpl in input_list:\n        for num in tpl:\n            total_sum += num\n    return total_sum"}
{"task_id": "Mbpp/615", "solution": "def _is_numeric(value: object) -> bool:\n    \"\"\"Checks if a value is an integer or a float.\"\"\"\n    return isinstance(value, (int, float))\n\ndef compute_mean(inner: tuple) -> float:\n    \"\"\"Computes the arithmetic mean of a tuple. It validates the tuple is non-empty and contains only numeric elements.\"\"\"\n    if not inner:\n        raise ValueError('inner tuple must not be empty')\n    for element in inner:\n        if not _is_numeric(element):\n            raise TypeError('inner tuple must contain only numeric elements')\n    return float(sum(inner) / len(inner))\n\ndef validate_input(input: tuple) -> None:\n    \"\"\"Validates the top-level input structure. It ensures the input is a tuple of tuples.\"\"\"\n    if not isinstance(input, tuple):\n        raise TypeError('input must be a tuple of tuples')\n    for element in input:\n        if not isinstance(element, tuple):\n            raise TypeError('each inner element must be a tuple')\n\ndef average_tuple(input: tuple) -> list:\n    \"\"\"Compute per-inner-tuple arithmetic means.\n\n    Args:\n        input (tuple): a tuple of tuples where each inner tuple contains numeric elements (int|float).\n\n    Returns:\n        list: list of float averages corresponding to each inner tuple in input order.\n    \"\"\"\n    validate_input(input)\n    averages = []\n    for inner_tuple in input:\n        averages.append(compute_mean(inner_tuple))\n    return averages"}
{"task_id": "Mbpp/618", "solution": "class LengthMismatchError(Exception):\n    def __init__(self, message: str = \"Input lists must have the same length\") -> None:\n        super().__init__(message)\n\ndef div_list(list1: list, list2: list) -> list:\n    \"\"\"Accepts two lists and returns a list where each element is list1[i] / list2[i] as float.\n    Raises LengthMismatchError if lengths differ.\n    \"\"\"\n    if len(list1) != len(list2):\n        raise LengthMismatchError(\"Input lists must have the same length\")\n\n    result = [float(list1[i]) / float(list2[i]) for i in range(len(list1))]\n    return result"}
{"task_id": "Mbpp/616", "solution": "from typing import Tuple\n\ndef tuple_modulo(a: Tuple, b: Tuple) -> Tuple:\n    \"\"\"\n    Performs element-wise modulo on two tuples of the same length.\n    Raises ValueError if tuples have different lengths.\n    \"\"\"\n    if len(a) != len(b):\n        raise ValueError(\"Input tuples must be of the same length.\")\n\n    return tuple(x % y for x, y in zip(a, b))"}
