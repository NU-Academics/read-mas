{"task_id": "Mbpp/459", "solution": "def remove_uppercase(input: str) -> str:\n    # Checks if a character is an ASCII uppercase letter (A-Z).\n    def _is_ascii_upper(ch: str) -> bool:\n        return 'A' <= ch <= 'Z'\n\n    if not isinstance(input, str):\n        raise TypeError(\"Input must be a string.\")\n\n    result_chars = []\n    for char in input:\n        if not _is_ascii_upper(char):\n            result_chars.append(char)\n\n    return ''.join(result_chars)"}
{"task_id": "Mbpp/456", "solution": "from typing import List, Any\n\nclass ValidationError(Exception):\n    \"\"\"Exception for invalid input or invalid element types.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n    def __str__(self) -> str:\n        return self.message\n\nclass StringItem:\n    \"\"\"Represent one string value and its position; provide reverse() operation.\"\"\"\n    def __init__(self, value: str, position: int) -> None:\n        self.value = value\n        self.position = position\n    def reverse(self) -> str:\n        return self.value[::-1]\n\nclass InputList:\n    \"\"\"Domain model representing incoming collection; constructs StringItem objects preserving positions.\"\"\"\n    def __init__(self, items: List[str]) -> None:\n        self._items = [StringItem(value, i) for i, value in enumerate(items)]\n    def items(self) -> List[StringItem]:\n        return self._items\n\nclass OutputList:\n    \"\"\"Domain model representing output collection after transformation.\"\"\"\n    def __init__(self, items: List[StringItem]) -> None:\n        self._items = items\n    def to_values(self) -> List[str]:\n        return [item.reverse() for item in self._items]\n\nclass ReverseStringListService:\n    \"\"\"Encapsulate validation and transformation logic; stateless service.\"\"\"\n    def reverse_string_list(self, input_list: List[Any]) -> List[str]:\n        self._validate_input(input_list)\n        \n        if not input_list:\n            return []\n\n        input_domain_list = InputList(input_list)\n        output_domain_list = OutputList(input_domain_list.items())\n        return output_domain_list.to_values()\n\n    def _validate_input(self, input_list: Any) -> None:\n        \"\"\"\n        Validates that the input is a list and that each element is a string.\n        Raises ValidationError on invalid input.\n        \"\"\"\n        if not isinstance(input_list, list):\n            raise ValidationError(\"Input must be a list.\")\n        for i, item in enumerate(input_list):\n            if not isinstance(item, str):\n                raise ValidationError(f\"Element at position {i} is not a string.\")\n\n    def _reverse_item(self, s: str) -> str:\n        \"\"\"Reverses a single string.\"\"\"\n        return s[::-1]\n\ndef reverse_string_list(input_list: List[str]) -> List[str]:\n    \"\"\"\n    Public API to reverse each string in a list of string values.\n    Delegates to ReverseStringListService for validation and transformation.\n    \"\"\"\n    return ReverseStringListService().reverse_string_list(input_list)"}
{"task_id": "Mbpp/462", "solution": "```python\ndef combinations_list(input_list):\n    \"\"\"\n    Return list of combinations per SRS.\n\n    Behavior:\n    - Iterate input_list left-to-right; for each element e, for each current combination c in result (in order), append [e] + c to result.\n    \"\"\"\n    result = [[]]\n    for element in input_list:\n        # Create new_combinations by prefixing 'element' to each existing combination\n        # The new combinations are added after the existing ones in result.\n        new_combinations = []\n        for combination in result:\n            new_combinations.append([element] + combination)\n        result.extend(new_combinations)\n    return result\n```"}
