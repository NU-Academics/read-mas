{"task_id": "Mbpp/740", "solution": "from typing import Any, Dict\n\ndef tuple_to_dict(input_tuple: tuple) -> Dict[Any, Any]:\n    \"\"\"Convert an input tuple to a dictionary using adjacent elements as key-value pairs.\"\"\"\n    result: Dict[Any, Any] = {}\n    for i in range(0, len(input_tuple), 2):\n        key = input_tuple[i]\n        value = input_tuple[i + 1]\n        result[key] = value\n    return result"}
{"task_id": "Mbpp/742", "solution": "import math\nfrom dataclasses import dataclass\nimport time\n\n@dataclass\nclass Tetrahedron:\n    \"\"\"Domain data holder representing edge_length and surface_area.\"\"\"\n    edge_length: float\n    surface_area: float | None = None\n\n@dataclass\nclass CalculationResult:\n    \"\"\"Encapsulates computed numeric result.\"\"\"\n    value: float\n    calculated_at: float | None = None\n\nclass AreaFunction:\n    \"\"\"Domain service to perform surface area calculation.\"\"\"\n    def compute(self, tetra: Tetrahedron) -> CalculationResult:\n        \"\"\"\n        Computes the surface area of a tetrahedron and updates the tetrahedron object.\n        \"\"\"\n        sqrt3 = math.sqrt(3)\n        result_value = sqrt3 * tetra.edge_length * tetra.edge_length\n        tetra.surface_area = result_value\n        return CalculationResult(value=result_value, calculated_at=time.time())\n\ndef area_tetrahedron(a: float) -> float:\n    \"\"\"\n    Calculates the surface area of a regular tetrahedron given its edge length.\n    \"\"\"\n    tetra = Tetrahedron(edge_length=a)\n    calc = AreaFunction()\n    result = calc.compute(tetra)\n    return float(result.value)"}
