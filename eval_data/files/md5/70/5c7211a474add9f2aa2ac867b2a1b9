{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(arr, k):\n    \"\"\"\n    Reverses the first 'k' elements of an array, returning a new array.\n    If 'k' is greater than the array length, the entire array is reversed.\n    \"\"\"\n    new_arr = arr[:]\n    n = len(new_arr)\n\n    if k <= 0:\n        return new_arr\n\n    effective_k = min(k, n)\n\n    prefix_to_reverse = new_arr[:effective_k]\n    prefix_to_reverse.reverse()\n\n    result = prefix_to_reverse + new_arr[effective_k:]\n\n    return result"}
{"task_id": "Mbpp/722", "solution": "import typing\n\nclass Student:\n    \"\"\"Represents a single student with name, height, and weight.\"\"\"\n    def __init__(self, name: str, height: float, weight: float) -> None:\n        self.name = name\n        self.height = height\n        self.weight = weight\n\nclass StudentRepository:\n    \"\"\"Holds and provides access to the input dictionary of students.\"\"\"\n    def __init__(self, students: typing.Dict[str, typing.Tuple[float, float]]) -> None:\n        self.students = students\n\n    def get_all(self) -> typing.Dict[str, typing.Tuple[float, float]]:\n        return self.students\n\n    def get(self, name: str) -> typing.Optional[typing.Tuple[float, float]]:\n        return self.students.get(name)\n\nclass FilterCriteria:\n    \"\"\"Encapsulates height and weight thresholds and evaluates student matches.\"\"\"\n    def __init__(self, min_height: float, min_weight: float) -> None:\n        self.min_height = min_height\n        self.min_weight = min_weight\n\n    def matches(self, student: Student) -> bool:\n        return student.height >= self.min_height and student.weight >= self.min_weight\n\nclass FilterResult:\n    \"\"\"Accumulates matching student entries and provides results.\"\"\"\n    def __init__(self) -> None:\n        self.results: typing.Dict[str, typing.Tuple[float, float]] = {}\n\n    def add(self, name: str, values: typing.Tuple[float, float]) -> None:\n        self.results[name] = values\n\n    def is_empty(self) -> bool:\n        return not self.results\n\n    def to_dict(self) -> typing.Dict[str, typing.Tuple[float, float]]:\n        return self.results\n\ndef filter_data(data: typing.Dict[str, typing.Tuple[float, float]], min_height: float, min_weight: float) -> typing.Dict[str, typing.Tuple[float, float]]:\n    \"\"\"Filters students based on minimum height and weight criteria.\"\"\"\n    repository = StudentRepository(data)\n    criteria = FilterCriteria(min_height, min_weight)\n    result = FilterResult()\n\n    for student_name, (height, weight) in repository.get_all().items():\n        student = Student(student_name, height, weight)\n        if criteria.matches(student):\n            result.add(student_name, (height, weight))\n\n    return result.to_dict()"}
{"task_id": "Mbpp/723", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised when inputs are invalid (non-list or unequal lengths).\"\"\"\n    pass\n\ndef count_same_pair(list1, list2):\n    \"\"\"\n    Counts indices where two lists of the same length have identical values.\n    Raises ValidationError if inputs are not lists or have unequal lengths.\n    \"\"\"\n    if not isinstance(list1, list) or not isinstance(list2, list):\n        raise ValidationError(\"Both inputs must be lists\")\n    if len(list1) != len(list2):\n        raise ValidationError(\"Lists must have the same length\")\n\n    count = 0\n    for i in range(len(list1)):\n        if list1[i] == list2[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/721", "solution": "from typing import List, Iterator\nimport collections.abc\nimport numbers\n\nclass Cell:\n    \"\"\"Represents a single cell with numeric value and coordinates.\"\"\"\n    def __init__(self, value: float, row: int, col: int) -> None:\n        self.value = float(value)\n        self.row = row\n        self.col = col\n\n    def __repr__(self) -> str:\n        return f\"Cell(value={self.value}, row={self.row}, col={self.col})\"\n\nclass Matrix:\n    \"\"\"Represents an N x N matrix of numeric cell costs.\"\"\"\n    def __init__(self, cells: List[List[Cell]]) -> None:\n        if not cells:\n            # This should ideally be caught by Validator, but a robust constructor might check.\n            raise ValueError(\"Matrix cannot be empty.\")\n        self._cells = cells\n        self.size = len(cells)\n        if any(len(row) != self.size for row in cells):\n            raise ValueError(\"Matrix must be square.\") # Validator also checks this.\n\n    def get_cell(self, row: int, col: int) -> 'Cell':\n        \"\"\"Returns the Cell object at the given row and column.\"\"\"\n        if not (0 <= row < self.size and 0 <= col < self.size):\n            raise IndexError(\"Cell coordinates out of bounds.\")\n        return self._cells[row][col]\n\n    def as_list(self) -> List[List[float]]:\n        \"\"\"Returns the matrix as a list of lists of float values.\"\"\"\n        return [[cell.value for cell in row] for row in self._cells]\n\ndef matrix_from_list(matrix_list: List[List[float]]) -> Matrix:\n    \"\"\"Factory to build a Matrix object from a raw list of lists.\"\"\"\n    n = len(matrix_list)\n    cells: List[List[Cell]] = []\n    for r in range(n):\n        row_cells: List[Cell] = []\n        for c in range(n):\n            row_cells.append(Cell(matrix_list[r][c], r, c))\n        cells.append(row_cells)\n    return Matrix(cells)\n\nclass Path:\n    \"\"\"Represents an ordered sequence of Cells and computes path metrics.\"\"\"\n    def __init__(self, cells: List[Cell]) -> None:\n        self.cells = cells\n\n    def length(self) -> int:\n        \"\"\"Returns the number of cells in the path.\"\"\"\n        return len(self.cells)\n\n    def sum(self) -> float:\n        \"\"\"Returns the total sum of cell values in the path.\"\"\"\n        return sum(cell.value for cell in self.cells)\n\n    def average(self) -> float:\n        \"\"\"Returns the average value of cells in the path.\"\"\"\n        path_length = self.length()\n        if path_length == 0:\n            return 0.0 # A valid path will always have length >= 1.\n        return self.sum() / path_length\n\ndef enumerate_paths(matrix: Matrix) -> Iterator['Path']:\n    \"\"\"Enumerates all valid right/down paths from top-left to bottom-right.\"\"\"\n    n = matrix.size\n    \n    def _dfs(row: int, col: int, current_path_cells: List[Cell]):\n        current_path_cells.append(matrix.get_cell(row, col))\n\n        if row == n - 1 and col == n - 1:\n            yield Path(list(current_path_cells))\n        else:\n            if col + 1 < n: # Move right\n                yield from _dfs(row, col + 1, current_path_cells)\n            if row + 1 < n: # Move down\n                yield from _dfs(row + 1, col, current_path_cells)\n        \n        current_path_cells.pop() # Backtrack\n\n    if n == 0:\n        return\n    \n    yield from _dfs(0, 0, [])\n\nclass Validator:\n    \"\"\"Validates that an input is a non-empty square numeric matrix.\"\"\"\n    def validateMatrix(self, matrix) -> None:\n        \"\"\"Raises a ValueError if the input matrix is invalid.\"\"\"\n        if not isinstance(matrix, collections.abc.Sequence):\n            raise ValueError(\"Input must be a list of lists.\")\n        if not matrix:\n            raise ValueError(\"Input matrix cannot be empty.\")\n\n        n = len(matrix)\n        for i, row in enumerate(matrix):\n            if not isinstance(row, collections.abc.Sequence):\n                raise ValueError(f\"Row {i} is not a list.\")\n            if len(row) != n:\n                raise ValueError(f\"Row {i} has length {len(row)}, expected {n} for a square matrix.\")\n            for j, cell_value in enumerate(row):\n                if not isinstance(cell_value, numbers.Number):\n                    raise ValueError(f\"Cell ({i},{j}) value '{cell_value}' is not a number.\")\n\n_validator_instance = Validator()\ndef validateMatrix(matrix) -> None:\n    \"\"\"Module-level convenience wrapper for Validator.validateMatrix.\"\"\"\n    _validator_instance.validateMatrix(matrix)\n\nclass Result:\n    \"\"\"Simple value object holding the numeric maximum-average result.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value = value\n\nclass MaxAverageCalculator:\n    \"\"\"Computes the maximum average among all valid right/down paths.\"\"\"\n    def __init__(self, tolerance: float = 1e-6) -> None:\n        self.tolerance = tolerance\n\n    def maxAverageOfPath(self, matrix_obj: Matrix) -> float:\n        \"\"\"\n        Calculates the maximum average-cost path for a given Matrix object.\n        Assumes matrix_obj is validated, converted, and N > 1.\n        \"\"\"\n        max_avg = -float('inf') \n\n        for path in enumerate_paths(matrix_obj):\n            current_avg = path.average()\n            if current_avg > max_avg:\n                max_avg = current_avg\n        \n        return max_avg\n\n_calculator_instance = MaxAverageCalculator()\n\ndef maxAverageOfPath(matrix: List[List[float]]) -> float:\n    \"\"\"\n    Given a square matrix, finds a path from top-left to bottom-right\n    moving only right or down, with the maximum average cost.\n    \"\"\"\n    validateMatrix(matrix)\n\n    matrix_obj = matrix_from_list(matrix)\n\n    if matrix_obj.size == 1:\n        return float(matrix_obj.get_cell(0, 0).value)\n\n    result_value = _calculator_instance.maxAverageOfPath(matrix_obj)\n    \n    return result_value"}
{"task_id": "Mbpp/724", "solution": "class IntegerInput:\n    \"\"\"Encapsulates the input pair base and power.\"\"\"\n    def __init__(self, base: int, power: int) -> None:\n        self.base = base\n        self.power = power\n\nclass BigIntegerResult:\n    \"\"\"Holds the integer result of exponentiation and provides decimal representation.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def decimal_representation(self) -> str:\n        \"\"\"Returns the decimal string representation of the value.\"\"\"\n        return str(self.value)\n\nclass Digit:\n    \"\"\"Represents a single decimal digit extracted from BigIntegerResult.\"\"\"\n    def __init__(self, position: int, value: int) -> None:\n        self.position = position\n        self.value = value\n\nclass DigitSum:\n    \"\"\"Represents the final digit sum result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass PowerBaseSum:\n    \"\"\"Performs exponentiation, digit extraction, and summation.\"\"\"\n    def power_base_sum(self, base: int, power: int) -> int:\n        \"\"\"Calculates the sum of digits of base raised to power.\"\"\"\n        computed_value = base ** power\n        \n        big_int_result = BigIntegerResult(computed_value)\n        decimal_str = big_int_result.decimal_representation()\n        \n        total_sum_value = 0\n        for i, char_digit in enumerate(decimal_str):\n            digit_value = int(char_digit)\n            _ = Digit(i, digit_value) # Create Digit object as per design guidance\n            total_sum_value += digit_value\n        \n        digit_sum_obj = DigitSum(total_sum_value)\n        return digit_sum_obj.value\n\ndef power_base_sum(base, power) -> int:\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    Delegates the core logic to an instance of PowerBaseSum.\n    \"\"\"\n    return PowerBaseSum().power_base_sum(base, power)"}
{"task_id": "Mbpp/725", "solution": "from typing import List, Optional\nfrom dataclasses import dataclass\n\n@dataclass\nclass InputString:\n    value: str\n    def __len__(self) -> int:\n        return len(self.value)\n\n@dataclass\nclass QuotedSubstring:\n    value: str\n    start_pos: int\n    end_pos: int\n\nclass ResultList:\n    def __init__(self, items: Optional[List[QuotedSubstring]] = None) -> None:\n        self.items: List[QuotedSubstring] = items if items is not None else []\n    def count(self) -> int:\n        return len(self.items)\n    def to_values(self) -> List[str]:\n        return [item.value for item in self.items]\n\ndef extract_quotation(input: str) -> List[str]:\n    \"\"\"\n    Public API function that extracts substrings between complete pairs of double quotes.\n    Returns a list of strings (quotes removed) in left-to-right order.\n    \"\"\"\n    input_str = InputString(input)\n    result_list = ResultList()\n    \n    in_quote = False\n    quote_start_index = -1\n\n    for i in range(len(input_str)):\n        if input_str.value[i] == '\"':\n            if not in_quote:\n                # Found opening quote\n                in_quote = True\n                quote_start_index = i\n            else:\n                # Found closing quote\n                in_quote = False\n                # Extract substring between quotes (excluding quotes)\n                substring = input_str.value[quote_start_index + 1:i]\n                result_list.items.append(QuotedSubstring(value=substring, start_pos=quote_start_index, end_pos=i))\n                quote_start_index = -1 # Reset for next pair\n\n    return result_list.to_values()"}
