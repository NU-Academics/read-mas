{"task_id": "Mbpp/308", "solution": "class Element:\n    \"\"\"Represents an element from an input list with its value and original position.\"\"\"\n    def __init__(self, value, position: int) -> None:\n        self.value = value\n        self.position = position\n\nclass List:\n    \"\"\"A wrapper for a list of values, converting them into Element objects.\"\"\"\n    def __init__(self, values: list) -> None:\n        self.elements = [Element(v, i) for i, v in enumerate(values)]\n\n    def __iter__(self):\n        return iter(self.elements)\n\nclass PairwiseProduct:\n    \"\"\"Stores two elements and their computed product value.\"\"\"\n    def __init__(self, a: Element, b: Element, value) -> None:\n        self.a = a\n        self.b = b\n        self.value = value\n\nclass ResultList:\n    \"\"\"A container for the final ordered numeric products.\"\"\"\n    def __init__(self, products: list) -> None:\n        self.products = products\n\nclass LargeProductFunction:\n    \"\"\"Orchestrates the process of finding the largest products.\"\"\"\n    def __init__(self, list_a, list_b, k) -> None:\n        self._list_a = list_a\n        self._list_b = list_b\n        self._k = k\n        self._products = []\n\n    def compute(self) -> list:\n        \"\"\"Executes the steps to compute and return the top k largest products.\"\"\"\n        self._validate_inputs()\n        self._generate_pairwise_products()\n        self._sort_pairwise_descending()\n        return self._select_top_k_values()\n\n    def _validate_inputs(self) -> None:\n        # Placeholder for validation as per design context, without explicit checks.\n        pass\n\n    def _generate_pairwise_products(self) -> None:\n        \"\"\"Generates all pairwise products from list_a and list_b.\"\"\"\n        list_a_elements = List(self._list_a)\n        list_b_elements = List(self._list_b)\n\n        for el_a in list_a_elements:\n            for el_b in list_b_elements:\n                product_value = self._compute_product_value(el_a.value, el_b.value)\n                self._products.append(PairwiseProduct(el_a, el_b, product_value))\n\n    def _compute_product_value(self, a_value, b_value):\n        \"\"\"Computes the product, preserving integer/float typing.\"\"\"\n        return a_value * b_value\n\n    def _sort_pairwise_descending(self) -> None:\n        \"\"\"Sorts the generated pairwise products by their value in descending order.\"\"\"\n        self._products.sort(key=lambda p: p.value, reverse=True)\n\n    def _select_top_k_values(self) -> list:\n        \"\"\"Selects the top k product values from the sorted list.\"\"\"\n        selected_products = self._products[:self._k]\n        return [p.value for p in selected_products]\n\ndef large_product(list_a, list_b, k):\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list.\n    \"\"\"\n    func = LargeProductFunction(list_a, list_b, k)\n    return func.compute()"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from arr[0...i]\n    ending with an element strictly less than arr[k], then adds arr[k].\n    \"\"\"\n    # Input validation as per design\n    if n != len(arr):\n        raise ValueError(f\"Array length mismatch: n={n} but actual length is {len(arr)}.\")\n    if not (0 <= i < k < n):\n        raise ValueError(f\"Invalid indices: Expected 0 <= i < k < n, but got i={i}, k={k}, n={n}.\")\n\n    # dp[j] stores the maximum sum of an increasing subsequence ending at arr[j]\n    # considering only elements from arr[0...j].\n    dp = [0] * (i + 1)\n\n    # Calculate dp values for the prefix arr[0...i]\n    for j in range(i + 1):\n        dp[j] = arr[j]  # A subsequence can be just arr[j] itself\n        for p in range(j):\n            if arr[p] < arr[j]:\n                dp[j] = max(dp[j], dp[p] + arr[j])\n\n    max_prefix_sum = 0\n    # Find the maximum sum from dp values where arr[j] < arr[k]\n    for j in range(i + 1):\n        if arr[j] < arr[k]:\n            max_prefix_sum = max(max_prefix_sum, dp[j])\n\n    # If no element in arr[0...i] is strictly less than arr[k], return arr[k]\n    if max_prefix_sum == 0:\n        return arr[k]\n    else:\n        return max_prefix_sum + arr[k]"}
{"task_id": "Mbpp/310", "solution": "def string_to_tuple(input: str) -> tuple:\n    \"\"\"\n    Converts a string to a tuple of characters, excluding ASCII space characters.\n    Preserves original character order and other whitespace types.\n    \"\"\"\n    return tuple(char for char in input if char != ' ')"}
{"task_id": "Mbpp/312", "solution": "from math import pi\n\nclass MathConstants:\n    \"\"\"Provides PI constant used by computation.\"\"\"\n    PI = pi\n\nclass GeometryUtil:\n    \"\"\"Encapsulates cone volume calculation algorithm.\"\"\"\n    @staticmethod\n    def computeConeVolume(radius, height):\n        \"\"\"Return (1.0/3.0) * MathConstants.PI * radius * radius * height\"\"\"\n        return (1.0 / 3.0) * MathConstants.PI * radius * radius * height\n\nclass Cone:\n    \"\"\"Domain object holding radius and height and delegating volume computation.\"\"\"\n    def __init__(self, radius, height):\n        self.radius = radius\n        self.height = height\n\n    def volume(self):\n        return GeometryUtil.computeConeVolume(self.radius, self.height)\n\ndef volume_cone(radius, height):\n    \"\"\"Public API function required by SRS. Returns a float.\"\"\"\n    return GeometryUtil.computeConeVolume(radius, height)"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n):\n    \"\"\"Return the largest power of two less than or equal to integer n.\n    This function computes the highest power of 2 that does not exceed n.\n    \"\"\"\n    power = 1\n    while (power << 1) <= n:\n        power <<= 1\n    return power"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    \"\"\"\n    Sets the leftmost unset bit in the binary representation of n within the range\n    from bit position 0 up to the highest set bit.\n    \"\"\"\n    def _find_highest_set_bit(val: int) -> int:\n        \"\"\"\n        Finds the position of the highest set bit in an integer.\n        For n=0, it returns 0 as per BR5.\n        \"\"\"\n        if val == 0:\n            return 0\n        return val.bit_length() - 1\n\n    def _find_leftmost_unset_bit(val: int, highest_bit_pos: int) -> int | None:\n        \"\"\"\n        Searches for the most significant unset bit from highest_bit_pos down to 0.\n        Returns the position of the first unset bit found, or None if all bits are set.\n        \"\"\"\n        for pos in range(highest_bit_pos, -1, -1):\n            if not ((val >> pos) & 1):\n                return pos\n        return None\n\n    highest_bit = _find_highest_set_bit(n)\n    unset_bit_pos = _find_leftmost_unset_bit(n, highest_bit)\n\n    if unset_bit_pos is not None:\n        return n | (1 << unset_bit_pos)\n    return n"}
{"task_id": "Mbpp/389", "solution": "class InputValidator:\n    \"\"\"Validates input to ensure it is a non-negative integer.\"\"\"\n    @staticmethod\n    def is_non_negative_integer(n):\n        return isinstance(n, int) and n >= 0\n\nclass LucasCalculator:\n    \"\"\"Provides computation logic for Lucas numbers.\"\"\"\n    @staticmethod\n    def compute_iterative(n):\n        if n == 0:\n            return 2\n        elif n == 1:\n            return 1\n        else:\n            a, b = 2, 1  # L0, L1\n            for _ in range(2, n + 1):\n                a, b = b, a + b\n            return b\n\nclass LucasNumber:\n    \"\"\"Lightweight value-holder for Lucas numbers.\"\"\"\n    def __init__(self, n: int, value: int):\n        self.n = n\n        self.value = value\n\ndef find_lucas(n):\n    \"\"\"Public API: returns int Lucas number for non-negative integer n or raises ValueError.\"\"\"\n    if not InputValidator.is_non_negative_integer(n):\n        raise ValueError(\"n must be a non-negative integer\")\n\n    return LucasCalculator.compute_iterative(n)"}
{"task_id": "Mbpp/390", "solution": "from typing import List\n\nclass FormatString:\n    \"\"\"Encapsulates format pattern behavior and substitution using the '{0}' placeholder.\"\"\"\n    def __init__(self, pattern: str):\n        self.pattern = pattern\n\n    def substitute(self, value_str: str) -> str:\n        \"\"\"Substitutes the given string into the format pattern.\"\"\"\n        return self.pattern.format(value_str)\n\nclass ResultList:\n    \"\"\"Collects and manages a list of formatted strings in insertion order.\"\"\"\n    def __init__(self):\n        self.elements: List[str] = []\n\n    def append(self, value: str) -> None:\n        \"\"\"Appends a formatted string to the internal list.\"\"\"\n        self.elements.append(value)\n\n    def to_list(self) -> List[str]:\n        \"\"\"Returns the accumulated list of formatted strings.\"\"\"\n        return self.elements\n\nclass AddStringService:\n    \"\"\"Orchestrates the process of applying a format string to elements in a list.\"\"\"\n    def add_string(self, input_list, format_string_pattern: str) -> List[str]:\n        formatter = FormatString(format_string_pattern)\n        result_collector = ResultList()\n\n        for element in input_list:\n            value_str = str(element)\n            formatted_item = formatter.substitute(value_str)\n            result_collector.append(formatted_item)\n\n        return result_collector.to_list()\n\ndef add_string(input_list, format_string: str) -> List[str]:\n    \"\"\"\n    Applies a given format string to all elements in a list.\n\n    Each element is converted to a string and substituted into the format_string at '{0}'.\n    \"\"\"\n    service = AddStringService()\n    return service.add_string(input_list, format_string)"}
