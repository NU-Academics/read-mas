{"task_id": "Mbpp/806", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass UppercaseRun:\n    start_index: int\n    length: int\n\ndef _is_ascii_upper(ch: str) -> bool:\n    \"\"\"Checks if a character is an ASCII uppercase letter.\"\"\"\n    return 'A' <= ch <= 'Z'\n\ndef compute_runs(s: str) -> List[UppercaseRun]:\n    \"\"\"Scans the string and returns a list of UppercaseRun objects.\"\"\"\n    runs = []\n    current_run_start = -1\n    current_run_length = 0\n\n    for i, char in enumerate(s):\n        if _is_ascii_upper(char):\n            if current_run_length == 0:\n                current_run_start = i\n            current_run_length += 1\n        else:\n            if current_run_length > 0:\n                runs.append(UppercaseRun(current_run_start, current_run_length))\n                current_run_start = -1\n                current_run_length = 0\n\n    if current_run_length > 0:\n        runs.append(UppercaseRun(current_run_start, current_run_length))\n\n    return runs\n\ndef max_run_uppercase(s: str) -> int:\n    \"\"\"Finds the maximum run of uppercase characters in the given string.\"\"\"\n    runs = compute_runs(s)\n    if not runs:\n        return 0\n    return max(run.length for run in runs)"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(input_list: list) -> list:\n    \"\"\"\n    Returns the sublist in a list of lists whose sum of elements is the highest.\n    On ties, the first encountered sublist is returned.\n    \"\"\"\n    if not input_list:\n        return []\n\n    max_sublist = input_list[0]\n    max_current_sum = sum(input_list[0])\n\n    for sublist in input_list[1:]:\n        current_sum = sum(sublist)\n        if current_sum > max_current_sum:\n            max_current_sum = current_sum\n            max_sublist = sublist\n\n    return max_sublist"}
{"task_id": "Mbpp/807", "solution": "from typing import Optional\n\ndef _is_numeric(value) -> bool:\n    \"\"\"Helper to check if a value is an integer.\n    Design choice is to strictly treat integers as numeric for this function.\n    \"\"\"\n    return isinstance(value, int)\n\ndef first_odd(numbers: list) -> Optional[int]:\n    \"\"\"Finds the first odd number in a list of numbers.\n    Raises ValueError for invalid input or non-numeric elements.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise ValueError(\"Input 'numbers' must be a list.\")\n\n    for element in numbers:\n        if not _is_numeric(element):\n            raise ValueError(\"All elements in 'numbers' must be integers.\")\n        if element % 2 != 0:\n            return element\n    return None"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(tuple1, tuple2):\n    # Assumes tuple1 and tuple2 are tuples of equal length with comparable elements.\n    # Checks if each element of tuple2 is strictly smaller than its corresponding element in tuple1.\n    for i in range(len(tuple1)):\n        if not (tuple2[i] < tuple1[i]):\n            return False\n    return True"}
