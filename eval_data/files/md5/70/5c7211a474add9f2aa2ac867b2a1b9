{"task_id": "Mbpp/620", "solution": "def _divisible(x: int, y: int) -> bool:\n    \"\"\"\n    Checks if two integers are divisible.\n    (0, 0) is considered divisible. Other zero-pair logic specified.\n    \"\"\"\n    if x == 0 and y == 0:\n        return True\n\n    divisible_by_y = False\n    if y != 0:\n        divisible_by_y = (x % y == 0)\n\n    divisible_by_x = False\n    if x != 0:\n        divisible_by_x = (y % x == 0)\n    \n    return divisible_by_y or divisible_by_x\n\ndef _build_divisibility_graph(numbers: list[int]) -> dict[int, set[int]]:\n    \"\"\"\n    Builds an undirected adjacency graph where nodes are indices of numbers.\n    An edge (i, j) exists if numbers[i] and numbers[j] are divisible.\n    \"\"\"\n    n = len(numbers)\n    graph: dict[int, set[int]] = {i: set() for i in range(n)}\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            if _divisible(numbers[i], numbers[j]):\n                graph[i].add(j)\n                graph[j].add(i)\n    return graph\n\ndef _bron_kerbosch_max_clique_size(graph: dict[int, set[int]]) -> int:\n    \"\"\"\n    Computes the size of the maximum clique in the given graph using\n    the Bron-Kerbosch algorithm (version 2 with pivoting).\n    \"\"\"\n    max_size = [0] # Use a list to hold the maximum size found across recursive calls\n\n    nodes = set(graph.keys())\n    if not nodes:\n        return 0\n\n    def _bron_kerbosch_recursive(R: set[int], P: set[int], X: set[int]):\n        nonlocal max_size\n\n        if not P and not X:\n            max_size[0] = max(max_size[0], len(R))\n            return\n\n        if not P:\n            return\n\n        # Pivot selection: choose u from P U X that maximizes |P intersect N(u)|.\n        pivot_candidates = P.union(X)\n        u = max(pivot_candidates, key=lambda node: len(P.intersection(graph[node])))\n\n        # Iterate over vertices v in P - N(u), which are candidates not connected to the pivot.\n        # Iterate over a copy to allow P to be modified within the loop's recursive calls.\n        for v in list(P - graph[u]):\n            _bron_kerbosch_recursive(R.union({v}), P.intersection(graph[v]), X.intersection(graph[v]))\n            P.remove(v)\n            X.add(v)\n\n    _bron_kerbosch_recursive(set(), nodes, set())\n    return max_size[0]\n\ndef largest_subset(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of numbers where every pair is divisible.\n    Uses a divisibility graph and the Bron-Kerbosch algorithm for max clique.\n    \"\"\"\n    if not numbers:\n        return 0\n    if len(numbers) == 1:\n        return 1\n    \n    graph = _build_divisibility_graph(numbers)\n    return _bron_kerbosch_max_clique_size(graph)"}
{"task_id": "Mbpp/623", "solution": "class InputList:\n    \"\"\"Wrapper around the input list to centralize element access and checks.\"\"\"\n    def __init__(self, elements: list):\n        if not isinstance(elements, list):\n            raise TypeError(\"First argument must be a list\")\n        self.elements = elements\n\n    def __iter__(self):\n        return iter(self.elements)\n\n    def __len__(self):\n        return len(self.elements)\n\nclass Number:\n    \"\"\"Wraps a numeric value and exposes power(n) to perform per-element exponentiation.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def power(self, n) -> \"numeric\":\n        try:\n            return self.value ** n\n        except TypeError:\n            raise TypeError(\"List contains non-numeric element or an element type that does not support exponentiation\")\n\nclass Exponent:\n    \"\"\"Lightweight wrapper for integer exponent; validates that exponent is an integer.\"\"\"\n    def __init__(self, n: int):\n        if not isinstance(n, int):\n            raise TypeError(\"Exponent must be an integer\")\n        self.n = n\n\nclass OutputList:\n    \"\"\"Container for results; preserves order and length; exposes to_list() to return a native list.\"\"\"\n    def __init__(self):\n        self._elements = []\n\n    def append(self, value):\n        self._elements.append(value)\n\n    def to_list(self) -> list:\n        return list(self._elements)\n\nclass NthNumsFunction:\n    \"\"\"Stateless encapsulation of validation and computation logic.\"\"\"\n    def compute(self, input_list_wrapper: InputList, exponent_wrapper: Exponent) -> list:\n        output_list_wrapper = OutputList()\n        n = exponent_wrapper.n\n\n        for element_value in input_list_wrapper:\n            number_wrapper = Number(element_value)\n            powered_value = number_wrapper.power(n)\n            output_list_wrapper.append(powered_value)\n\n        return output_list_wrapper.to_list()\n\ndef nth_nums(input_list, n) -> list:\n    \"\"\"\n    Computes the n-th power of each number in a list.\n    Validates inputs and performs element-wise exponentiation.\n    \"\"\"\n    input_list_wrapper = InputList(input_list)\n    exponent_wrapper = Exponent(n)\n\n    nth_func = NthNumsFunction()\n    result_list = nth_func.compute(input_list_wrapper, exponent_wrapper)\n\n    return result_list"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1, list2, n):\n    \"\"\"\n    Finds the median of two sorted lists of the same size.\n    Assumes lists are sorted and contain n numeric elements each.\n    \"\"\"\n    i = 0  # Pointer for list1\n    j = 0  # Pointer for list2\n    m1 = 0.0 # Stores the element at conceptual merged index n-1\n    m2 = 0.0 # Stores the element at conceptual merged index n\n\n    # Iterate n+1 times to find the elements at conceptual merged indices n-1 and n.\n    # The loop effectively processes elements until the (n+1)-th element is found.\n    for count in range(n + 1):\n        m1 = m2  # m1 always stores the value from the previous step\n\n        # Choose the smaller element from the current positions in list1 and list2.\n        # Handle cases where one list might be exhausted.\n        if i < n and (j >= n or list1[i] <= list2[j]):\n            m2 = float(list1[i])\n            i += 1\n        else:\n            m2 = float(list2[j])\n            j += 1\n            \n    # The median is the average of the two middle elements found.\n    return (m1 + m2) / 2.0"}
{"task_id": "Mbpp/626", "solution": "from dataclasses import dataclass\nfrom typing import Optional, Union\n\nclass Validator:\n    \"\"\"Validates input parameters for numeric type and non-negativity.\"\"\"\n    def is_numeric(self, radius: object) -> bool:\n        \"\"\"Checks if the radius is an int or float.\"\"\"\n        return isinstance(radius, (int, float))\n\n    def is_non_negative(self, radius: Union[int, float]) -> bool:\n        \"\"\"Checks if the radius is greater than or equal to zero.\"\"\"\n        return radius >= 0\n\n@dataclass\nclass Radius:\n    \"\"\"Value object encapsulating the radius.\"\"\"\n    value: float\n\n    def __init__(self, value: Union[int, float]):\n        self.value = float(value)\n\n@dataclass\nclass Triangle:\n    \"\"\"Domain object holding the computed area.\"\"\"\n    area: float\n\n@dataclass\nclass Result:\n    \"\"\"Internal return structure with status and optional area.\"\"\"\n    status: str\n    area: Optional[float]\n\nclass TriangleAreaCalculator:\n    \"\"\"Calculates the area of the largest triangle inscribed in a semicircle.\"\"\"\n    def compute_area(self, radius: Radius) -> Triangle:\n        \"\"\"Calculates the triangle area as radius squared.\"\"\"\n        area = radius.value ** 2\n        return Triangle(area=area)\n\n    def triangle_area(self, radius: Union[int, float]) -> Optional[float]:\n        \"\"\"A convenience adapter for triangle area calculation, not the primary API entry point.\"\"\"\n        validator = Validator()\n        if not validator.is_non_negative(radius):\n            return None\n        \n        radius_obj = Radius(radius)\n        triangle_obj = self.compute_area(radius_obj)\n        return triangle_obj.area\n\ndef triangle_area(radius: Union[int, float]) -> Optional[float]:\n    \"\"\"\n    Finds the area of the largest triangle that can be inscribed in a semicircle.\n    Returns None if the radius is negative, otherwise returns the area as a float.\n    \"\"\"\n    validator = Validator()\n    \n    if not validator.is_non_negative(radius):\n        return None\n    \n    # For valid non-negative radii, create Radius object and calculate area.\n    radius_obj = Radius(radius)\n    calculator = TriangleAreaCalculator()\n    triangle_obj = calculator.compute_area(radius_obj)\n    \n    return triangle_obj.area"}
{"task_id": "Mbpp/628", "solution": "class ReplaceSpacesFunction:\n    \"\"\"Encapsulates the algorithm for replacing spaces.\"\"\"\n    def replace(self, input: str) -> str:\n        \"\"\"Replaces all ASCII spaces in the input string with '%20'.\"\"\"\n        return input.replace(\" \", \"%20\")\n\ndef replace_spaces(input: str) -> str:\n    \"\"\"Replaces all ASCII spaces in the given string with '%20'.\"\"\"\n    return ReplaceSpacesFunction().replace(input)"}
{"task_id": "Mbpp/629", "solution": "from typing import List\n\ndef validate_input(numbers: List) -> None:\n    \"\"\"Validate that 'numbers' is a list and its elements are integers. Raise TypeError on invalid input.\"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n    for item in numbers:\n        if not isinstance(item, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n\ndef filter_even(numbers: List) -> List:\n    \"\"\"Return a new list containing only even integers from 'numbers', preserving order.\"\"\"\n    return [x for x in numbers if isinstance(x, int) and x % 2 == 0]\n\ndef Split(numbers: List) -> List:\n    \"\"\"Public API: return a list of even numbers preserving input order.\"\"\"\n    validate_input(numbers)\n    return filter_even(numbers)"}
{"task_id": "Mbpp/630", "solution": "def get_coordinates(coord: tuple) -> list[list[int]]:\n    \"\"\"Extracts all adjacent coordinates (3x3 neighborhood) of the given coordinate tuple.\n    The output is in row-major order.\"\"\"\n    first, second = coord\n    result = []\n    for i in range(first - 1, first + 2):\n        for j in range(second - 1, second + 2):\n            result.append([i, j])\n    return result"}
{"task_id": "Mbpp/631", "solution": "def replace_spaces(input: str) -> str:\n    \"\"\"Return a new string where every ASCII space (' ') in input is replaced by '_' and every '_' is replaced by ' '.\n    Mapping is applied atomically in a single pass.\"\"\"\n    result_chars = []\n    for char in input:\n        if char == ' ':\n            result_chars.append('_')\n        elif char == '_':\n            result_chars.append(' ')\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/632", "solution": "def move_zero(inputList: list) -> list:\n    \"\"\"Moves all zeroes to the end of the given list, preserving the relative order of non-zero elements.\"\"\"\n    nonzeros = []\n    zeros = []\n    for item in inputList:\n        if item == 0:\n            zeros.append(item)\n        else:\n            nonzeros.append(item)\n    return nonzeros + zeros"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(arr, n):\n    \"\"\"\n    Calculates the sum of XORs of all unique pairs among the first n elements of arr.\n    Returns 0 if fewer than two elements are available for pairing.\n    \"\"\"\n    prefix = arr[0:n]\n\n    if n < 2 or len(prefix) < 2:\n        return 0\n\n    total_xor_sum = 0\n    num_elements = len(prefix)\n\n    for i in range(num_elements - 1):\n        for j in range(i + 1, num_elements):\n            total_xor_sum += (prefix[i] ^ prefix[j])\n\n    return total_xor_sum"}
{"task_id": "Mbpp/635", "solution": "def heap_sort(inputList: list) -> list:\n    \"\"\"Sorts the given list using the heap sort algorithm.\"\"\"\n    if not inputList:\n        return []\n\n    # Define the Heap class locally as per design guidance to keep helpers inline.\n    class Heap:\n        def __init__(self):\n            self._data = []\n            self._size = 0\n\n        def _parent(self, i: int) -> int:\n            \"\"\"Calculates the parent index for a given node index.\"\"\"\n            return (i - 1) // 2\n\n        def _left_child(self, i: int) -> int:\n            \"\"\"Calculates the left child index for a given node index.\"\"\"\n            return 2 * i + 1\n\n        def _right_child(self, i: int) -> int:\n            \"\"\"Calculates the right child index for a given node index.\"\"\"\n            return 2 * i + 2\n\n        def swap(self, i: int, j: int) -> None:\n            \"\"\"Swaps elements at indices i and j in the heap's underlying data.\"\"\"\n            self._data[i], self._data[j] = self._data[j], self._data[i]\n\n        def heapify(self, i: int) -> None:\n            \"\"\"Maintains the max-heap property for a subtree rooted at index i.\"\"\"\n            largest = i\n            left = self._left_child(i)\n            right = self._right_child(i)\n\n            if left < self._size and self._data[left] > self._data[largest]:\n                largest = left\n            if right < self._size and self._data[right] > self._data[largest]:\n                largest = right\n\n            if largest != i:\n                self.swap(i, largest)\n                self.heapify(largest)\n\n        def build_max_heap(self, lst: list) -> None:\n            \"\"\"Builds a max-heap from the given list.\"\"\"\n            self._data = list(lst)  # Create a copy to avoid modifying the original inputList.\n            self._size = len(self._data)\n            for i in range(self._size // 2 - 1, -1, -1):\n                self.heapify(i)\n\n        def extract_max(self):\n            \"\"\"Removes and returns the maximum element from the heap.\"\"\"\n            if self._size == 0:\n                return None\n\n            max_val = self._data[0]\n            self._data[0] = self._data[self._size - 1] # Move the last element to the root\n            self._size -= 1 # Decrease heap size\n            if self._size > 0:\n                self.heapify(0) # Restore heap property\n            return max_val\n\n    heap_instance = Heap()\n    heap_instance.build_max_heap(inputList)\n\n    sorted_result = []\n    # Repeatedly extract the maximum element until the heap is empty.\n    for _ in range(len(inputList)):\n        sorted_result.append(heap_instance.extract_max())\n    \n    # The extracted elements are in descending order. Reverse to obtain ascending order.\n    return sorted_result[::-1]"}
