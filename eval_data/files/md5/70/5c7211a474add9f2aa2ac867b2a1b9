{"task_id": "Mbpp/472", "solution": "def validate_input(numbers) -> None:\n    \"\"\"Ensures 'numbers' is a Python list and each element is numeric (int or float).\"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n    for element in numbers:\n        if not isinstance(element, (int, float)):\n            raise TypeError(\"All elements in the list must be numeric (int or float).\")\n\ndef is_consecutive(numbers) -> bool:\n    \"\"\"Checks if elements in a list are strictly consecutive (step +1).\"\"\"\n    if len(numbers) <= 1:\n        return True\n    for i in range(len(numbers) - 1):\n        if numbers[i+1] != numbers[i] + 1:\n            return False\n    return True\n\ndef check_Consecutive(numbers) -> bool:\n    \"\"\"\n    Checks whether the given list contains consecutive numbers.\n    Input is validated, then consecutiveness is determined.\n    \"\"\"\n    validate_input(numbers)\n    return is_consecutive(numbers)"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple: tuple) -> tuple:\n    \"\"\"Finds the pairwise addition of neighboring elements of the given tuple.\n    Returns an empty tuple if the input tuple has fewer than two elements.\n    \"\"\"\n    if len(input_tuple) < 2:\n        return ()\n\n    # Calculates pairwise sums by iterating through the tuple up to the second-to-last element.\n    # Each element at index `i` is added to its neighbor at `i+1`.\n    result_list = [input_tuple[i] + input_tuple[i+1] for i in range(len(input_tuple) - 1)]\n\n    return tuple(result_list)"}
{"task_id": "Mbpp/468", "solution": "from typing import List, Optional\n\nclass Element:\n    \"\"\"Represents a single input value and its original index.\"\"\"\n    def __init__(self, value: float, index: int) -> None:\n        self.value = value\n        self.index = index\n\nclass Subsequence:\n    \"\"\"Represents a subsequence composed of Element objects.\"\"\"\n    def __init__(self, elements: List[Element]) -> None:\n        self.elements = elements\n\n    def isStrictlyIncreasing(self) -> bool:\n        \"\"\"Checks if the subsequence is strictly increasing by value.\"\"\"\n        if len(self.elements) <= 1:\n            return True\n        for i in range(1, len(self.elements)):\n            if self.elements[i].value <= self.elements[i-1].value:\n                return False\n        return True\n\n    def product(self) -> float:\n        \"\"\"Computes the product of elements in the subsequence.\"\"\"\n        if not self.elements:\n            return 0.0 # Product of an empty subsequence is generally 1, but 0 is safer for \"max product\" if no valid elements exist.\n        p = 1.0\n        for element in self.elements:\n            p *= element.value\n        return p\n\nclass ProductResult:\n    \"\"\"Wraps the numeric result of a product calculation.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value = value\n\nclass InputArray:\n    \"\"\"Represents input as a collection of Element objects.\"\"\"\n    def __init__(self, elements: List[Element]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the input array.\"\"\"\n        return len(self.elements)\n\nclass Validator:\n    \"\"\"Encapsulates input validation.\"\"\"\n    def validate(self, nums: List[float]) -> bool:\n        \"\"\"Returns True if the input list is valid (non-empty), False otherwise.\"\"\"\n        return len(nums) > 0\n\nclass ProductCalculator:\n    \"\"\"Computes the product of a Subsequence.\"\"\"\n    def product_of(self, subseq: Subsequence) -> float:\n        \"\"\"Returns the product of the given subsequence.\"\"\"\n        return subseq.product()\n\nclass MaxSelector:\n    \"\"\"Selects the maximum product from candidate products.\"\"\"\n    def select_max(self, products: List[float]) -> ProductResult:\n        \"\"\"Returns a ProductResult with the maximum value from the list of products.\"\"\"\n        if not products:\n            return ProductResult(0.0) # If no products, default to 0.0.\n        return ProductResult(max(products))\n\nclass SubsequenceGenerator:\n    \"\"\"Generates strictly increasing subsequences, adhering to the problem's example-driven interpretation.\"\"\"\n    def generate_strictly_increasing(self, nums: List[float]) -> List[Subsequence]:\n        \"\"\"\n        Generates all strictly increasing subsequences that are entirely contained\n        within any maximal contiguous increasing sub-segment of the input array.\n        \"\"\"\n        all_subsequences: List[Subsequence] = []\n        if not nums:\n            return all_subsequences\n\n        # Step 1: Identify maximal strictly increasing contiguous segments.\n        segments: List[List[Element]] = []\n        current_segment: List[Element] = [Element(nums[0], 0)]\n        for i in range(1, len(nums)):\n            if nums[i] > nums[i-1]:\n                current_segment.append(Element(nums[i], i))\n            else:\n                segments.append(current_segment)\n                current_segment = [Element(nums[i], i)]\n        segments.append(current_segment) # Add the last segment\n\n        # Step 2: For each segment, generate all strictly increasing subsequences within that segment.\n        for segment_elements in segments:\n            n = len(segment_elements)\n            # dp_subsequences_ending_at_i[k] stores all increasing subsequences ending at segment_elements[k].\n            dp_subsequences_ending_at_i: List[List[Subsequence]] = [[] for _ in range(n)]\n\n            for i in range(n):\n                current_element = segment_elements[i]\n                \n                # A single element forms an increasing subsequence.\n                single_element_subseq = Subsequence([current_element])\n                dp_subsequences_ending_at_i[i].append(single_element_subseq)\n                all_subsequences.append(single_element_subseq)\n\n                # Extend previous subsequences in the current segment.\n                for j in range(i):\n                    prev_element = segment_elements[j]\n                    if current_element.value > prev_element.value:\n                        for subseq_ending_at_j in dp_subsequences_ending_at_i[j]:\n                            new_subseq_elements = subseq_ending_at_j.elements + [current_element]\n                            new_subseq = Subsequence(new_subseq_elements)\n                            dp_subsequences_ending_at_i[i].append(new_subseq)\n                            all_subsequences.append(new_subseq)\n        return all_subsequences\n\nclass MaxProductFunction:\n    \"\"\"Orchestrates validation, subsequence generation, product computation, and selection.\"\"\"\n    def __init__(self) -> None:\n        self._validator = Validator()\n        self._generator = SubsequenceGenerator()\n        self._calculator = ProductCalculator()\n        self._selector = MaxSelector()\n\n    def computeMaxProduct(self, nums: List[float]) -> float:\n        \"\"\"Computes the maximum product of a strictly increasing subsequence.\"\"\"\n        if not self.validateInput(nums):\n            return 0.0 # Returns 0.0 for invalid/empty input as per design.\n\n        subsequences = self._generator.generate_strictly_increasing(nums)\n        \n        products: List[float] = []\n        for subseq in subsequences:\n            products.append(self._calculator.product_of(subseq))\n        \n        result = self._selector.select_max(products)\n        return result.value\n\n    def validateInput(self, nums: List[float]) -> bool:\n        \"\"\"Delegates input validation to the Validator component.\"\"\"\n        return self._validator.validate(nums)\n\ndef max_product(nums: List[float]) -> float:\n    \"\"\"Public API (FR1). Delegates to MaxProductFunction.computeMaxProduct.\"\"\"\n    mpf = MaxProductFunction()\n    return mpf.computeMaxProduct(nums)"}
{"task_id": "Mbpp/473", "solution": "from collections import Counter\nfrom typing import List, Tuple as TypingTuple, Optional, Iterator, Set\n\nclass Tuple:\n    \"\"\"Immutable adapter representing a tuple value, preserving element order for representation.\"\"\"\n    def __init__(self, elements: TypingTuple) -> None:\n        self._elements = elements\n\n    def as_sequence(self) -> TypingTuple:\n        \"\"\"Returns the underlying tuple sequence.\"\"\"\n        return self._elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the tuple.\"\"\"\n        return len(self._elements)\n\n    def __hash__(self) -> int:\n        return hash(self._elements)\n\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, Tuple):\n            return NotImplemented\n        return self._elements == other._elements\n\nclass TupleList:\n    \"\"\"Lightweight wrapper around Python list for Tuple instances.\"\"\"\n    def __init__(self, tuples: Optional[List[Tuple]] = None) -> None:\n        self._tuples: List[Tuple] = [] if tuples is None else tuples\n\n    def add(self, t: Tuple) -> None:\n        \"\"\"Adds a Tuple instance to the list.\"\"\"\n        self._tuples.append(t)\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the list is empty.\"\"\"\n        return not bool(self._tuples)\n\n    def __iter__(self) -> Iterator[Tuple]:\n        \"\"\"Provides an iterator over the contained Tuple instances.\"\"\"\n        return iter(self._tuples)\n\nclass SetResult:\n    \"\"\"Wrapper around Python set that stores Tuple elements and enforces uniqueness.\"\"\"\n    def __init__(self) -> None:\n        self._tuples: Set[Tuple] = set()\n\n    def add(self, t: Tuple) -> None:\n        \"\"\"Adds a Tuple instance to the set.\"\"\"\n        self._tuples.add(t)\n\n    def to_set(self) -> Set[TypingTuple]:\n        \"\"\"Converts the internal set of Tuple objects to a set of native Python tuples.\"\"\"\n        return {t.as_sequence() for t in self._tuples}\n\n    def __len__(self) -> int:\n        \"\"\"Returns the number of unique tuples in the result set.\"\"\"\n        return len(self._tuples)\n\nclass MatchEngine:\n    \"\"\"Provides unordered equality comparison for two Tuple instances.\"\"\"\n    def is_unordered_equal(self, a: Tuple, b: Tuple) -> bool:\n        \"\"\"Compares two Tuple instances for unordered equality using multiset comparison.\"\"\"\n        if a.length() != b.length():\n            return False\n        return Counter(a.as_sequence()) == Counter(b.as_sequence())\n\nclass TupleIntersectionFunction:\n    \"\"\"Orchestrates comparison and accumulation for tuple intersection based on unordered equality.\"\"\"\n    def __init__(self, match_engine: Optional[MatchEngine] = None) -> None:\n        self._match_engine = match_engine if match_engine is not None else MatchEngine()\n\n    def tuple_intersection(self, list1: TupleList, list2: TupleList) -> SetResult:\n        \"\"\"Finds the intersection of two TupleList instances, preserving representation from list1.\"\"\"\n        result = SetResult()\n        if list1.isEmpty() or list2.isEmpty():\n            return result\n\n        for t1 in list1:\n            for t2 in list2:\n                if self._match_engine.is_unordered_equal(t1, t2):\n                    result.add(t1)\n                    break\n        return result\n\ndef tuple_intersection(list1: List[TypingTuple], list2: List[TypingTuple]) -> Set[TypingTuple]:\n    \"\"\"\n    Finds the tuple intersection of elements in the given tuple list irrespective of their order.\n    Preserves tuple representation from the first input list.\n    \"\"\"\n    tuple_list_1 = TupleList([Tuple(t) for t in list1])\n    tuple_list_2 = TupleList([Tuple(t) for t in list2])\n\n    intersection_finder = TupleIntersectionFunction()\n    set_result = intersection_finder.tuple_intersection(tuple_list_1, tuple_list_2)\n\n    return set_result.to_set()"}
{"task_id": "Mbpp/463", "solution": "class InputArray:\n    \"\"\"Encapsulates validation and length checks for input arrays.\"\"\"\n    def __init__(self, elements: list[int]) -> None:\n        self.elements = elements\n        self.length = len(elements)\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the array is empty.\"\"\"\n        return self.length == 0\n\n    def isSingleElement(self) -> bool:\n        \"\"\"Checks if the array contains a single element.\"\"\"\n        return self.length == 1\n\n    def validate(self) -> None:\n        \"\"\"\n        Validates the input array for type and emptiness.\n        Raises TypeError if not a list or contains non-integers.\n        Raises ValueError if the list is empty.\n        \"\"\"\n        if not isinstance(self.elements, list):\n            raise TypeError(\"Input must be a list.\")\n        if self.isEmpty():\n            raise ValueError(\"Input list cannot be empty.\")\n        for element in self.elements:\n            if not isinstance(element, int):\n                raise TypeError(\"All elements in the list must be integers.\")\n\nclass Result:\n    \"\"\"A conceptual wrapper for a numeric result.\"\"\"\n    def __init__(self, value: float | int) -> None:\n        self.value = value\n\nclass ProductCalculator:\n    \"\"\"Performs algorithmic computation to find the maximum product subarray.\"\"\"\n    def compute_max_product(self, arr: list[int]) -> float | int:\n        \"\"\"\n        Computes the maximum product of any contiguous subarray using a single pass.\n        Handles positive, negative, and zero elements correctly.\n        \"\"\"\n        max_so_far = arr[0]\n        current_max = arr[0]\n        current_min = arr[0]\n\n        for i in range(1, len(arr)):\n            num = arr[i]\n\n            if num == 0:\n                # If current number is 0, reset current_max/min as any product\n                # with 0 would be 0. The max_so_far should consider 0 itself.\n                current_max = 1\n                current_min = 1\n                max_so_far = max(max_so_far, 0)\n                continue\n\n            # If num is negative, current_max and current_min will swap roles\n            # after multiplication.\n            if num < 0:\n                current_max, current_min = current_min, current_max\n\n            # Update current_max and current_min by considering the current number\n            # itself or extending the previous product.\n            current_max = max(num, current_max * num)\n            current_min = min(num, current_min * num)\n\n            max_so_far = max(max_so_far, current_max)\n\n        return max_so_far\n\n    def compute_subarray_product(self, arr: list[int], i: int, j: int) -> float | int:\n        \"\"\"Computes the product of a subarray from index i to j (inclusive).\"\"\"\n        product = 1\n        for k in range(i, j + 1):\n            product *= arr[k]\n        return product\n\nclass Subarray:\n    \"\"\"Conceptual holder for subarray details.\"\"\"\n    def __init__(self, startIndex: int, endIndex: int, product: float | int) -> None:\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n        self.product = product\n\ndef max_subarray_product(arr: list[int]) -> float | int:\n    \"\"\"\n    Finds the maximum product subarray of the given array.\n    This function validates input and delegates computation.\n    \"\"\"\n    input_obj = InputArray(arr)\n    input_obj.validate()\n\n    if input_obj.isSingleElement():\n        return arr[0]\n\n    calc = ProductCalculator()\n    return calc.compute_max_product(arr)"}
