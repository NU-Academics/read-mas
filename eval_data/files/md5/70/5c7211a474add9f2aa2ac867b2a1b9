{"task_id": "Mbpp/286", "solution": "from typing import List\n\nclass Array:\n    \"\"\"Encapsulates a list of integers and provides sum, max prefix/suffix computations.\"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        self._elements = elements\n        self.length = len(elements)\n\n    def sum(self) -> int:\n        \"\"\"Calculates the total sum of elements in the array.\"\"\"\n        return sum(self._elements)\n\n    def max_prefix_sum(self) -> int:\n        \"\"\"Finds the maximum sum of any prefix subarray starting from index 0.\"\"\"\n        if not self._elements:\n            return 0\n        current_sum = 0\n        max_prefix = float('-inf')\n        for x in self._elements:\n            current_sum += x\n            max_prefix = max(max_prefix, current_sum)\n        return int(max_prefix)\n\n    def max_suffix_sum(self) -> int:\n        \"\"\"Finds the maximum sum of any suffix subarray ending at the last index.\"\"\"\n        if not self._elements:\n            return 0\n        current_sum = 0\n        max_suffix = float('-inf')\n        for x in reversed(self._elements):\n            current_sum += x\n            max_suffix = max(max_suffix, current_sum)\n        return int(max_suffix)\n\nclass InputValidator:\n    \"\"\"Provides stateless validation helpers for input parameters.\"\"\"\n    def validateArrIsList(self, arr) -> bool:\n        \"\"\"Validates if arr is a list or tuple containing only integers.\"\"\"\n        if not isinstance(arr, (list, tuple)):\n            return False\n        return all(isinstance(x, int) for x in arr)\n\n    def validateNMatchesLength(self, arr, n) -> bool:\n        \"\"\"Validates if n is an integer and matches the length of arr.\"\"\"\n        return isinstance(n, int) and n == len(arr)\n\n    def validateKPositive(self, k) -> bool:\n        \"\"\"Validates if k is a positive integer.\"\"\"\n        return isinstance(k, int) and k > 0\n\nclass Result:\n    \"\"\"A simple container for an integer result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def asInt(self) -> int:\n        \"\"\"Returns the encapsulated integer value.\"\"\"\n        return self.value\n\nclass MaxSubarrayFunction:\n    \"\"\"Orchestrates validation and computes max contiguous subarray sum.\"\"\"\n    def __init__(self, validator: 'InputValidator' = None) -> None:\n        self.validator = validator if validator is not None else InputValidator()\n\n    def kadane(self, arr: List[int]) -> int:\n        \"\"\"Implements Kadane's algorithm to find the maximum contiguous subarray sum.\"\"\"\n        if not arr:\n            return 0 # Per design context for an empty array\n        \n        max_so_far = arr[0]\n        current_max = arr[0]\n\n        for i in range(1, len(arr)):\n            current_max = max(arr[i], current_max + arr[i])\n            max_so_far = max(max_so_far, current_max)\n        return max_so_far\n\n    def maxPrefixSum(self, arr: List[int]) -> int:\n        \"\"\"Returns the maximal sum of a prefix starting at index 0 by using the Array model.\"\"\"\n        return Array(arr).max_prefix_sum()\n\n    def maxSuffixSum(self, arr: List[int]) -> int:\n        \"\"\"Returns the maximal sum of a suffix ending at the last index by using the Array model.\"\"\"\n        return Array(arr).max_suffix_sum()\n\n    def totalSum(self, arr: List[int]) -> int:\n        \"\"\"Returns the sum of all elements in the array by using the Array model.\"\"\"\n        return Array(arr).sum()\n\n    def max_sub_array_sum_repeated(self, arr, n, k) -> int:\n        \"\"\"\n        Computes the largest sum of a contiguous array in the modified array\n        formed by repeating the given array k times.\n        \"\"\"\n        # Validate inputs\n        if not self.validator.validateArrIsList(arr):\n            raise ValueError(\"arr must be a list or tuple of integers.\")\n        if not self.validator.validateNMatchesLength(arr, n):\n            raise ValueError(\"n must match the length of arr.\")\n        if not self.validator.validateKPositive(k):\n            raise ValueError(\"k must be a positive integer.\")\n        \n        if n == 0:\n            return 0 # Max sum in an empty array is 0\n\n        # Case 1: k == 1 (standard Kadane's algorithm)\n        if k == 1:\n            return self.kadane(arr)\n\n        # Case 2: k > 1\n        single_kadane = self.kadane(arr)\n        prefix_sum = self.maxPrefixSum(arr)\n        suffix_sum = self.maxSuffixSum(arr)\n        total_sum = self.totalSum(arr)\n\n        # Initialize result with max subarray entirely within one copy\n        result_value = single_kadane\n\n        # Consider subarray spanning one boundary (suffix of first array + prefix of second array)\n        candidate_span = suffix_sum + prefix_sum\n        result_value = max(result_value, candidate_span)\n\n        # If total sum is positive, consider subarrays spanning multiple full copies\n        if total_sum > 0:\n            candidate_multi = suffix_sum + total_sum * (k - 2) + prefix_sum\n            result_value = max(result_value, candidate_multi)\n            \n        return Result(result_value).asInt()\n\ndef max_sub_array_sum_repeated(arr, n, k) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous array in the modified array\n    which is formed by repeating the given array k times.\n    \"\"\"\n    validator = InputValidator()\n    msf = MaxSubarrayFunction(validator)\n    return msf.max_sub_array_sum_repeated(arr, n, k)"}
{"task_id": "Mbpp/290", "solution": "from typing import List, Tuple, Any\n\ndef max_length(list_of_lists: List[List[Any]]) -> Tuple[int, List[Any]]:\n    \"\"\"Finds the sublist with the maximum length and returns its length and the sublist itself.\n\n    If multiple sublists have the same maximum length, the first one encountered is returned.\n    \"\"\"\n    if not list_of_lists:\n        return (0, [])\n\n    max_len = 0\n    example_sublist: List[Any] = []\n\n    for sublist in list_of_lists:\n        current_len = len(sublist)\n        if current_len > max_len:\n            max_len = current_len\n            example_sublist = sublist\n    \n    return (max_len, example_sublist)"}
