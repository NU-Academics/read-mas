{"task_id": "Mbpp/457", "solution": "from typing import Sequence, Any, List\n\nclass Sublist:\n    \"\"\"Minimal wrapper representing an individual sublist.\"\"\"\n    def __init__(self, elements: Sequence[Any]):\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the encapsulated sublist.\"\"\"\n        return len(self.elements)\n\nclass SublistsCollection:\n    \"\"\"Encapsulates a sequence of sublists and provides methods to find the minimum.\"\"\"\n    def __init__(self, sublists: Sequence[Sequence[Any]]):\n        if not sublists:\n            raise ValueError(\"no sublists provided\")\n        self._sublists: List[Sublist] = [Sublist(s) for s in sublists]\n\n    def get_min_sublist(self) -> Sequence[Any]:\n        \"\"\"Returns the first sublist with minimal length.\"\"\"\n        # This check is redundant due to __init__ validation, but kept for robustness.\n        if not self._sublists:\n            raise ValueError(\"no sublists provided\")\n\n        min_length = float('inf')\n        min_sublist_elements: Sequence[Any] = []\n\n        for wrapped_sublist in self._sublists:\n            current_length = wrapped_sublist.length()\n            if current_length < min_length:\n                min_length = current_length\n                min_sublist_elements = wrapped_sublist.elements\n        return min_sublist_elements\n\ndef Find_Min(sublists):\n    \"\"\"\n    Finds the sublist having minimum length from a sequence of sublists.\n\n    Raises ValueError if the input sequence is empty.\n    \"\"\"\n    collection = SublistsCollection(sublists)\n    return collection.get_min_sublist()"}
{"task_id": "Mbpp/454", "solution": "import string\nfrom typing import List\n\nclass TextInput:\n    \"\"\"Represents the input string.\"\"\"\n    def __init__(self, content: str) -> None:\n        self.content = content\n\nclass Word:\n    \"\"\"Represents a token/word.\"\"\"\n    def __init__(self, text: str) -> None:\n        self.text = text\n\n    def contains_lowercase_z(self) -> bool:\n        \"\"\"Checks if the word contains ASCII lowercase 'z' (case-sensitive).\"\"\"\n        return 'z' in self.text\n\nclass MatchResult:\n    \"\"\"Represents the boolean result of a match operation.\"\"\"\n    def __init__(self, matched: bool) -> None:\n        self.matched = matched\n\nclass Tokenizer:\n    \"\"\"Splits input content into Word tokens, treating punctuation and whitespace as separators.\"\"\"\n    def tokenize(self, content: str) -> List[Word]:\n        # Replace punctuation with spaces to ensure they act as separators\n        for p in string.punctuation:\n            content = content.replace(p, ' ')\n        \n        # Split by whitespace and filter out empty strings\n        raw_tokens = content.split()\n        return [Word(token) for token in raw_tokens if token]\n\nclass Matcher:\n    \"\"\"Evaluates a list of Word tokens for the presence of 'z'.\"\"\"\n    def has_word_with_lowercase_z(self, words: List[Word]) -> MatchResult:\n        for word in words:\n            if word.contains_lowercase_z():\n                return MatchResult(matched=True)\n        return MatchResult(matched=False)\n\ndef text_match_wordz(input: str) -> bool:\n    \"\"\"Public API: accepts a single string and returns boolean True if any word contains 'z'.\"\"\"\n    tx = TextInput(input)\n    tokenizer = Tokenizer()\n    words = tokenizer.tokenize(tx.content)\n    matcher = Matcher()\n    result = matcher.has_word_with_lowercase_z(words)\n    return result.matched"}
