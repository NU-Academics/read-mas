{"task_id": "Mbpp/794", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass InputString:\n    \"\"\"Holds the input string value.\"\"\"\n    value: str\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the string.\"\"\"\n        return len(self.value)\n\n@dataclass\nclass MatchResult:\n    \"\"\"Represents the boolean match outcome.\"\"\"\n    matched: bool\n\nclass TextMatcher:\n    \"\"\"Encapsulates matching logic for strings starting with 'a' and ending with 'b'.\"\"\"\n    _pattern: str = \"^a.*b$\" # Internal pattern hint, not directly used in this implementation.\n\n    def text_starta_endb(self, input: str) -> bool:\n        \"\"\"\n        Evaluates input and returns True if the first character is 'a' and the last character is 'b'.\n        \"\"\"\n        input_string = InputString(value=input)\n        \n        if input_string.length() < 2:\n            match_outcome = False\n        else:\n            starts_with_a = input_string.value[0] == 'a'\n            ends_with_b = input_string.value[-1] == 'b'\n            match_outcome = starts_with_a and ends_with_b\n        \n        return MatchResult(matched=match_outcome).matched\n\ndef text_starta_endb(input: str) -> bool:\n    \"\"\"\n    Matches a string that has an 'a' followed by anything, ending in 'b'.\n    \"\"\"\n    return TextMatcher().text_starta_endb(input)"}
{"task_id": "Mbpp/800", "solution": "def remove_all_spaces(input: str) -> str:\n    \"\"\"Remove all whitespace characters from input and return resulting string.\n    Implementation uses Python's str.isspace() predicate.\n    \"\"\"\n    return ''.join(c for c in input if not c.isspace())"}
{"task_id": "Mbpp/797", "solution": "def sum_in_range(l, r):\n    \"\"\"\n    Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n    Natural numbers are defined as integers greater than or equal to 1.\n    \"\"\"\n    if l > r:\n        return 0\n\n    total_sum = 0\n    start = max(l, 1) # Natural numbers must be >= 1\n\n    for num in range(start, r + 1):\n        if num % 2 != 0:\n            total_sum += num\n\n    return total_sum"}
{"task_id": "Mbpp/799", "solution": "WORD_SIZE = 32\nMASK_32 = 0xFFFFFFFF\n\ndef _mask_to_32(value: int) -> int:\n    \"\"\"Masks an integer to ensure it fits within 32 bits.\"\"\"\n    return value & MASK_32\n\ndef left_rotate(number: int, d: int) -> int:\n    \"\"\"\n    Performs a 32-bit circular left bit rotation on the given number by d bits.\n    The rotation count d is interpreted modulo 32.\n    \"\"\"\n    # Ensure the input number is treated as a 32-bit value.\n    num_32 = _mask_to_32(number)\n\n    d_mod = d % WORD_SIZE\n\n    if d_mod == 0:\n        return num_32\n\n    # Shift left and mask to keep only the 32 most significant bits of the shifted part.\n    left_part = (num_32 << d_mod) & MASK_32\n    \n    # Shift right to get the bits that wrap around from the left.\n    wrap_part = (num_32 & MASK_32) >> (WORD_SIZE - d_mod)\n    \n    # Combine the two parts and ensure the final result is 32-bit masked.\n    result = (left_part | wrap_part) & MASK_32\n    \n    return result"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a, b, c):\n    \"\"\"\n    Accepts three integer parameters and returns an integer count of how many of the inputs are equal.\n\n    Preconditions: a, b, c are integers (caller responsibility per design).\n    Returns:\n        int: 3 if a == b == c, 2 if exactly two values are equal, 0 if all values are distinct.\n    \"\"\"\n    if a == b == c:\n        return 3\n    elif a == b or b == c or a == c:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/803", "solution": "def is_perfect_square(n: int) -> bool:\n    \"\"\"\n    Checks if an integer is a perfect square.\n    Returns False for negative inputs.\n    \"\"\"\n    if n < 0:\n        return False\n    \n    # Calculate the integer square root\n    root = int(n**0.5)\n    \n    # Check if the square of the integer root equals the original number\n    return root * root == n"}
