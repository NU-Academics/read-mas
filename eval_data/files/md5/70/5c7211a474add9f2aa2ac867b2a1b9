{"task_id": "Mbpp/558", "solution": "def validate_inputs(a, b) -> None:\n    \"\"\"Ensures inputs are integers, raising TypeError otherwise.\"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise TypeError(\"Inputs 'a' and 'b' must be integers.\")\n\ndef digits_of(n) -> list[int]:\n    \"\"\"Converts an integer to a list of its decimal digits, most-significant-first.\"\"\"\n    if n == 0:\n        return [0]\n    return [int(d) for d in str(abs(n))]\n\ndef align_digits(da, db) -> tuple[list[int], list[int]]:\n    \"\"\"Left-pads the shorter digit list with zeros to match the length of the longer list.\"\"\"\n    max_len = max(len(da), len(db))\n    da_aligned = [0] * (max_len - len(da)) + da\n    db_aligned = [0] * (max_len - len(db)) + db\n    return da_aligned, db_aligned\n\ndef sum_differences(diffs) -> int:\n    \"\"\"Sums a list of integer differences.\"\"\"\n    return sum(diffs)\n\ndef digit_distance_nums(a, b) -> int:\n    \"\"\"\n    Calculates the sum of per-digit absolute differences between two integers.\n    Inputs are normalized using their absolute values, and shorter numbers are\n    left-padded with zeros for alignment.\n    \"\"\"\n    validate_inputs(a, b)\n\n    da = digits_of(a)\n    db = digits_of(b)\n\n    da_aligned, db_aligned = align_digits(da, db)\n\n    diffs = [abs(d_a - d_b) for d_a, d_b in zip(da_aligned, db_aligned)]\n\n    return sum_differences(diffs)"}
{"task_id": "Mbpp/562", "solution": "from dataclasses import dataclass\nfrom typing import List, Any\n\ndef Find_Max_Length(input_list) -> int:\n    \"\"\"Public API: Validate input and return the length of the longest sublist.\n    Raises TypeError if input_list is not a list or if any element is not a list.\n    \"\"\"\n    InputValidator.validate_top_level(input_list)\n    InputValidator.validate_elements_are_lists(input_list)\n\n    if not input_list:\n        return 0\n\n    max_len = 0\n    for item in input_list:\n        sub = Sublist(item)\n        current_len = sub.length()\n        if current_len > max_len:\n            max_len = current_len\n            \n    # The design context mentions a Result class, but the final pseudo-code suggests returning the int directly.\n    # Result(max_length) usage would be more for internal data flow or if the API returned a Result object.\n    # As the API returns int, we return the primitive.\n    return max_len\n\nclass InputValidator:\n    \"\"\"Validates the input structure to ensure it is a list of lists.\"\"\"\n    @staticmethod\n    def validate_top_level(input_list) -> None:\n        if not isinstance(input_list, list):\n            raise TypeError(\"input_list must be a list\")\n\n    @staticmethod\n    def validate_elements_are_lists(input_list) -> None:\n        \"\"\"Assumes input_list is already validated as a list.\"\"\"\n        for idx, item in enumerate(input_list):\n            if not isinstance(item, list):\n                raise TypeError(f\"element at index {idx} is not a list\")\n\nclass Sublist:\n    \"\"\"A lightweight wrapper for a sublist to expose its length.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\n\n@dataclass\nclass Result:\n    \"\"\"A simple data holder for the computed maximum length.\"\"\"\n    max_length: int"}
{"task_id": "Mbpp/560", "solution": "class TypeValidator:\n    \"\"\"Validates that an input is a tuple and raises TypeError otherwise.\"\"\"\n    def validate(self, input_value) -> None:\n        if not isinstance(input_value, tuple):\n            raise TypeError(\"Input must be a tuple.\")\n\nclass SetOperator:\n    \"\"\"Computes the union of two sequences and removes duplicates.\"\"\"\n    def compute_union(self, elementsA, elementsB) -> list:\n        union_set = set(elementsA).union(set(elementsB))\n        return list(union_set)\n\nclass Sorter:\n    \"\"\"Sorts a sequence of elements in ascending order.\"\"\"\n    def sort_ascending(self, elements) -> list:\n        return sorted(elements)\n\nclass UnionService:\n    \"\"\"Coordinates validation, union computation, sorting, and result assembly.\"\"\"\n    def __init__(self):\n        self._validator = TypeValidator()\n        self._set_operator = SetOperator()\n        self._sorter = Sorter()\n\n    def union_elements(self, a: tuple, b: tuple) -> tuple:\n        self._validator.validate(a)\n        self._validator.validate(b)\n\n        unique_values = self._set_operator.compute_union(a, b)\n        sorted_values = self._sorter.sort_ascending(unique_values)\n\n        return tuple(sorted_values)\n\ndef union_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Finds the union of elements from two tuples, sorts them, and returns a new tuple.\n    \"\"\"\n    svc = UnionService()\n    return svc.union_elements(a, b)"}
{"task_id": "Mbpp/563", "solution": "def extract_values(input: str) -> list[str]:\n    \"\"\"\n    Extract every substring enclosed in double quotes from `input` and return a\n    list of the extracted strings with leading/trailing whitespace removed from\n    each extracted substring. Preserves internal characters and casing.\n    \"\"\"\n    result = []\n    current_pos = 0\n    while True:\n        first_quote_idx = input.find('\"', current_pos)\n        if first_quote_idx == -1:\n            break\n\n        second_quote_idx = input.find('\"', first_quote_idx + 1)\n        if second_quote_idx == -1:\n            # Unmatched opening quote, stop\n            break\n\n        extracted_value = input[first_quote_idx + 1 : second_quote_idx]\n        result.append(extracted_value.strip())\n\n        current_pos = second_quote_idx + 1\n    return result"}
{"task_id": "Mbpp/564", "solution": "from collections import Counter\n\ndef count_Pairs(arr, n) -> int:\n    \"\"\"\n    Counts the number of unordered pairs (i, j) with 0 <= i < j < n where arr[i] != arr[j].\n    Achieves O(n) time complexity and O(k) space complexity, where k is the number of distinct elements.\n    \"\"\"\n    if n < 2:\n        return 0\n\n    # Build a frequency map for elements in the first n elements of the array.\n    freq_map = Counter(arr[:n])\n\n    # Calculate the total possible number of unordered pairs from n elements.\n    total_pairs = n * (n - 1) // 2\n\n    # Calculate the number of unordered pairs where both elements are equal.\n    equal_pairs = 0\n    for count in freq_map.values():\n        equal_pairs += count * (count - 1) // 2\n\n    # The number of unequal pairs is total pairs minus equal pairs.\n    return total_pairs - equal_pairs"}
