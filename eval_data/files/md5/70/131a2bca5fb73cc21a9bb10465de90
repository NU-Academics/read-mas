late_digit_sum(n: int) -> int:\n        \"\"\"Calculates the sum of the absolute digits of an integer.\"\"\"\n        return sum(int(digit) for digit in str(abs(n)))\n\n    decorated_list = []\n    for i, num in enumerate(nums):\n        digit_sum = _calculate_digit_sum(num)\n        decorated_list.append((digit_sum, i, num))\n\n    decorated_list.sort()\n\n    return [num for _, _, num in decorated_list]", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 11, -1, -11, -12]]], "plus_fail_tests": [[[-5, -12, 9, 15]]]}], "HumanEval/144": [{"task_id": "HumanEval/144", "solution": "import math\nclass Fraction:\n    def __init__(self, numerator: int, denominator: int):\n        self._numerator = numerator\n        self._denominator = denominator\n        self._simplify_self()\n\n    def _simplify_self(self):\n        # Divides numerator and denominator by their greatest common divisor.\n        common_divisor = math.gcd(self._numerator, self._denominator)\n        self._numerator //= common_divisor\n        self._denominator //= common_divisor\n        if self._denominator < 0:\n            self._numerator *= -1\n            self._denominator *= -1\n\n    def __mul__(self, other: 'Fraction') -> 'Fraction':\n        # Multiplies two fractions and returns a new simplified Fraction.\n        new_numerator = self._numerator * other._numerator\n        new_denominator = self._denominator * other._denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        # Checks if the fraction represents a whole number (denominator is 1).\n        return self._denominator == 1\n\n    def get_numerator(self) -> int:\n        return self._numerator\n\n    def get_denominator(self) -> int:\n        return self._denominator\n\n    def __repr__(self) -> str:\n        return f\"Fraction({self._numerator}/{self._denominator})\"\nclass FractionParser:\n    @staticmethod\n    def parse(fraction_str: str) -> Fraction:\n        # Parses a string into a Fraction object, assuming valid format.\n        parts = fraction_str.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return Fraction(numerator, denominator)\nclass FractionService:\n    def __init__(self, parser: FractionParser):\n        self._parser = parser\n\n    def multiply_and_check_whole(self, x_str: str, n_str: str) -> bool:\n        # Multiplies two fractions and checks if the product is a whole number.\n        fraction_x = self._parser.parse(x_str)\n        fraction_n = self._parser.parse(n_str)\n        \n        product_fraction = fraction_x * fraction_n\n        \n        return product_fraction.is_whole_number()\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n    \"\"\"\n    parser = FractionParser()\n    service = FractionService(parser)\n    return service.multiply_and_check_whole(x, n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/151": [{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \"\"\"\n    total_sum_of_squares = 0\n    for item in lst:\n        # Check if the item is an integer, positive, and odd.\n        if isinstance(item, int) and item > 0 and item % 2 != 0:\n            total_sum_of_squares += item * item\n    return total_sum_of_squares", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/150": [{"task_id": "HumanEval/150", "solution": "import math\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n    \"\"\"\n    def _is_prime_inline(num: int) -> bool:\n        # Check basic cases for primality.\n        if num <= 1:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        \n        # Optimized trial division for primality testing up to the square root.\n        for i in range(3, int(math.sqrt(num)) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\n\n    if _is_prime_inline(n):\n        return x\n    else:\n        return y", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/147": [{"task_id": "HumanEval/147", "solution": "import math\ndef get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k, \n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    # Analysis of a[i] % 3 for a[i] = i * i - i + 1:\n    # If i % 3 == 0: a[i] % 3 = (0*(-1) + 1) % 3 = 1\n    # If i % 3 == 1: a[i] % 3 = (1*0 + 1) % 3 = 1\n    # If i % 3 == 2: a[i] % 3 = (2*1 + 1) % 3 = 0\n    # So, a[i] % 3 can only be 0 or 1.\n\n    count_rem_0 = 0\n    count_rem_1 = 0\n\n    for i in range(1, n + 1):\n        if i % 3 == 2:\n            count_rem_0 += 1\n        else: # i % 3 == 0 or i % 3 == 1\n            count_rem_1 += 1\n\n    # A sum of three numbers (a[i] + a[j] + a[k]) is a multiple of 3 if their remainders modulo 3 sum to a multiple of 3.\n    # Given a[x] % 3 can only be 0 or 1, the only combinations that sum to a multiple of 3 are:\n    # (0, 0, 0) -> sum % 3 == 0\n    # (1, 1, 1) -> sum % 3 == 3 -> sum % 3 == 0\n\n    total_triples = 0\n    # Number of ways to choose 3 elements from those with remainder 0\n    total_triples += math.comb(count_rem_0, 3)\n    # Number of ways to choose 3 elements from those with remainder 1\n    total_triples += math.comb(count_rem_1, 3)\n\n    return total_triples", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/155": [{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    s_num = str(abs(num))\n    even_count = 0\n    odd_count = 0\n\n    for digit_char in s_num:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n    return (even_count, odd_count)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/153": [{"task_id": "HumanEval/153", "solution": "import string\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension for a given class name from a list of extensions.\n    The strength is calculated as (uppercase letters - lowercase letters), with ties broken by original list order.\n    \"\"\"\n    strongest_ext_name = None\n    max_strength = -float('inf') \n\n    for ext_name in extensions:\n        cap_count = sum(1 for char in ext_name if char in string.ascii_uppercase)\n        sm_count = sum(1 for char in ext_name if char in string.ascii_lowercase)\n        current_strength = cap_count - sm_count\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_ext_name = ext_name\n\n    return f\"{class_name}.{strongest_ext_name}\"", "base_status": "pass", "plus_status": "pass", "base_fail_te