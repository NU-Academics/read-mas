129", "solution": "class Path:\n    \"\"\"Represents a sequence of cell values forming a path.\"\"\"\n    def __init__(self, initial_values: list[int] = None) -> None:\n        self._values = list(initial_values) if initial_values else []\n\n    def add_value(self, value: int) -> None:\n        \"\"\"Appends a value to the path.\"\"\"\n        self._values.append(value)\n\n    def remove_last_value(self) -> None:\n        \"\"\"Removes the last value from the path (for backtracking).\"\"\"\n        if not self._values:\n            raise IndexError(\"Cannot remove from an empty path.\")\n        self._values.pop()\n\n    def get_values(self) -> list[int]:\n        \"\"\"Returns a copy of the path's values.\"\"\"\n        return list(self._values)\n\n    def get_length(self) -> int:\n        \"\"\"Returns the current length of the path.\"\"\"\n        return len(self._values)\n\n    def is_lexicographically_smaller(self, other: 'Path') -> bool:\n        \"\"\"Compares self with other path. Returns True if self is lexicographically smaller.\"\"\"\n        for i in range(len(self._values)):\n            if self._values[i] < other._values[i]:\n                return True\n            if self._values[i] > other._values[i]:\n                return False\n        return False\nclass GridUtils:\n    \"\"\"Provides static utility methods for grid operations.\"\"\"\n    @staticmethod\n    def _is_valid_coordinate(N: int, r: int, c: int) -> bool:\n        \"\"\"Checks if (r, c) is within the N x N grid boundaries.\"\"\"\n        return 0 <= r < N and 0 <= c < N\n\n    @staticmethod\n    def get_neighbors(grid: list[list[int]], r: int, c: int) -> list[tuple[int, int]]:\n        \"\"\"Returns a list of (row, col) tuples for valid adjacent cells.\"\"\"\n        N = len(grid)\n        neighbors = []\n        moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n        for dr, dc in moves:\n            nr, nc = r + dr, c + dc\n            if GridUtils._is_valid_coordinate(N, nr, nc):\n                neighbors.append((nr, nc))\n        return neighbors\nclass MinPathFinderService:\n    \"\"\"Implements the core algorithm to find the lexicographically smallest path of length k.\"\"\"\n    def find_min_path(self, grid: list[list[int]], k: int) -> list[int]:\n        N = len(grid)\n        if not (N >= 2 and all(len(row) == N for row in grid)):\n            raise ValueError(\"Invalid grid: Must be an N x N grid with N >= 2.\")\n        if not (k >= 1):\n            raise ValueError(\"Invalid k: Must be a positive integer.\")\n\n        min_found_path = Path([float('inf')] * k)\n\n        for r_start in range(N):\n            for c_start in range(N):\n                initial_path = Path([grid[r_start][c_start]])\n                self._explore_paths(grid, k, initial_path, r_start, c_start, min_found_path)\n        \n        return min_found_path.get_values()\n\n    def _explore_paths(self, grid: list[list[int]], k: int, current_path: Path, current_r: int, current_c: int, min_found_path: Path) -> None:\n        \"\"\"Recursive helper to explore paths and update the minimum found path.\"\"\"\n        if current_path.get_length() == k:\n            if current_path.is_lexicographically_smaller(min_found_path):\n                min_found_path._values = current_path.get_values()\n            return\n\n        if current_path.get_length() > k:\n            return\n\n        neighbors = GridUtils.get_neighbors(grid, current_r, current_c)\n        for nr, nc in neighbors:\n            current_path.add_value(grid[nr][nc])\n            self._explore_paths(grid, k, current_path, nr, nc, min_found_path)\n            current_path.remove_last_value()\ndef minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid