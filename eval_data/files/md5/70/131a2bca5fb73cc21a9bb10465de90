n False\n        if num <= 3: # 2 and 3 are prime\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        \n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\nclass FibonacciGenerator:\n    \"\"\"Generates an infinite sequence of Fibonacci numbers with memoization.\"\"\"\n    def __init__(self):\n        # Initialize memo with standard Fibonacci sequence: F_0=0, F_1=1, F_2=1\n        self.memo: Dict[int, int] = {0: 0, 1: 1, 2: 1} \n\n    def generate(self) -> Iterator[int]:\n        \"\"\"Generates Fibonacci numbers: 2, 3, 5, 8, 13... (F_3, F_4, F_5, etc.).\"\"\"\n        # The design context examples imply the sequence starts yielding from 2 (F_3).\n        yield 2 # F_3\n        yield 3 # F_4\n\n        a, b = 2, 3 # These are F_3 and F_4 respectively\n        while True:\n            next_fib = a + b\n            yield next_fib\n            a = b\n            b = next_fib\n\n    def _fib(self, n: int) -> int:\n        \"\"\"Calculates the n-th Fibonacci number (F_n) using memoized recursion.\"\"\"\n        if n < 0:\n            raise ValueError(\"Fibonacci index cannot be negative.\")\n        if n in self.memo:\n            return self.memo[n]\n        \n        self.memo[n] = self._fib(n - 1) + self._fib(n - 2)\n        return self.memo[n]\nclass PrimeFibService:\n    \"\"\"Orchestrates finding the n-th prime Fibonacci number.\"\"\"\n    def __init__(self, fibonacci_generator: FibonacciGenerator, prime_checker: PrimeChecker):\n        self.fibonacci_generator = fibonacci_generator\n        self.prime_checker = prime_checker\n        # Arbitrary limit to prevent infinite loops for very large 'n'.\n        self.MAX_FIB_SEARCH_LIMIT = 100_000 \n\n    def find_nth_prime_fib(self, n: int) -> int:\n        \"\"\"Finds the n-th number that is both a Fibonacci number and a prime.\"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n\n        prime_fib_count = 0\n        fib_generator = self.fibonacci_generator.generate()\n        \n        for _ in range(self.MAX_FIB_SEARCH_LIMIT): \n            try:\n                fib_num = next(fib_generator)\n            except StopIteration:\n                raise IndexOutOfRangeError(f\"Fibonacci generator stopped unexpectedly.\")\n\n            if self.prime_checker.is_prime(fib_num):\n                prime_fib_count += 1\n                if prime_fib_count == n:\n                    return fib_num\n        \n        raise IndexOutOfRangeError(\n            f\"Could not find the {n}-th prime Fibonacci number within \"\n            f\"the search limit ({self.MAX_FIB_SEARCH_LIMIT} Fibonacci numbers checked).\"\n        )\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    \"\"\"\n    fib_gen = FibonacciGenerator()\n    prime_chk = PrimeChecker()\n    service = PrimeFibService(fib_gen, prime_chk)\n    try:\n        return service.find_nth_prime_fib(n)\n    except (InvalidInputError, IndexOutOfRangeError) as e:\n        raise e", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[12]]}], "HumanEval/143": [{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, keeping only those with prime lengths.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a given integer is a prime number.\"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    words = sentence.split()\n    filtered_words = []\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n    return \" \".join(filtered_words)", "base_