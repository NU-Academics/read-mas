{"task_id": "Mbpp/632", "solution": "def move_zeroes(numbers: list[int]) -> list[int]:\n    \"\"\"\n    Moves all zero elements to the end of a list while preserving the\n    relative order of non-zero elements.\n    Returns a new list with zeroes moved to the end.\n    \"\"\"\n    non_zero_elements = []\n    zero_count = 0\n\n    for num in numbers:\n        if num == 0:\n            zero_count += 1\n        else:\n            non_zero_elements.append(num)\n\n    non_zero_elements.extend([0] * zero_count)\n\n    return non_zero_elements"}
{"task_id": "Mbpp/632", "solution": "def move_zero(numbers: list[int]) -> list[int]:\n    \"\"\"\n    Moves all zero elements to the end of the given list,\n    preserving the relative order of non-zero elements.\n    \"\"\"\n    if not numbers:\n        return numbers\n\n    non_zero_ptr = 0\n    for i in range(len(numbers)):\n        if numbers[i] != 0:\n            numbers[non_zero_ptr], numbers[i] = numbers[i], numbers[non_zero_ptr]\n            non_zero_ptr += 1\n    return numbers"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers: list[int], n: int) -> int:\n    \"\"\"Calculates the sum of XORs of all unique pairs in a list.\n    Assumes valid list of integers and correct length `n` are provided.\n    \"\"\"\n    total_xor_sum = 0\n    for i in range(n):\n        for j in range(i + 1, n):\n            total_xor_sum += (numbers[i] ^ numbers[j])\n    return total_xor_sum"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers, length):\n    \"\"\"Calculates the sum of bitwise XOR of all unique pairs in a list.\n    This uses a bitwise approach for optimal performance.\n    \"\"\"\n    MAX_BITS = 32\n\n    if length < 2:\n        return 0\n\n    total_sum = 0\n    for i in range(MAX_BITS):\n        count_set_bits = 0\n        for num in numbers:\n            if (num >> i) & 1:\n                count_set_bits += 1\n        \n        count_unset_bits = length - count_set_bits\n        \n        total_sum += (count_set_bits * count_unset_bits) * (1 << i)\n    \n    return total_sum"}
{"task_id": "Mbpp/635", "solution": "def heap_sort(data_list: list) -> None:\n    \"\"\"\n    Sorts a list in ascending order using the Heap Sort algorithm in-place.\n    The input list `data_list` is modified directly.\n    \"\"\"\n    n = len(data_list)\n\n    if n <= 1:\n        return\n\n    _build_max_heap(data_list)\n\n    for i in range(n - 1, 0, -1):\n        data_list[i], data_list[0] = data_list[0], data_list[i]\n        _heapify(data_list, i, 0)"}
