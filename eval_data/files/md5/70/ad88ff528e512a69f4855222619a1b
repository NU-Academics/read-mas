{"task_id": "Mbpp/589", "solution": "import math\ndef perfect_squares(start: int, end: int) -> list[int]:\n    \"\"\"\n    Finds perfect squares within an inclusive numerical range.\n    Assumes valid integer inputs where start is not greater than end.\n    \"\"\"\n    perfect_squares_list = []\n    \n    current_sqrt = math.ceil(math.sqrt(max(0, start)))\n    \n    while True:\n        square = current_sqrt * current_sqrt\n        if square > end:\n            break\n        if square >= start:\n            perfect_squares_list.append(square)\n        current_sqrt += 1\n            \n    return perfect_squares_list"}
{"task_id": "Mbpp/589", "solution": "import math\ndef perfect_squares(start: int, end: int) -> list[int]:\n    \"\"\"\n    Finds all perfect squares within the inclusive range [start, end].\n\n    Args:\n        start: The lower bound of the range (integer).\n        end: The upper bound of the range (integer).\n\n    Returns:\n        A list of integers, representing all perfect squares in the range.\n\n    Raises:\n        TypeError: If start or end are not integers.\n        ValueError: If start > end.\n    \"\"\"\n    if not isinstance(start, int) or not isinstance(end, int):\n        raise TypeError(\"Both 'start' and 'end' must be integers.\")\n    if start > end:\n        raise ValueError(\"'start' cannot be greater than 'end'.\")\n\n    squares = []\n    # Start checking from the smallest integer whose square is >= start\n    # Or from 0 if start is negative\n    current_num = max(0, math.ceil(math.sqrt(start)))\n\n    while True:\n        square = current_num * current_num\n        if square > end:\n            break\n        if square >= start: # Ensure it's within the lower bound too\n            squares.append(square)\n        current_num += 1\n    return squares"}
{"task_id": "Mbpp/590", "solution": "import math\ndef polar_rect(r: float, theta: float) -> tuple[float, float]:\n    \"\"\"\n    Converts polar coordinates (radius, angle) to rectangular coordinates (x, y).\n    Angles are assumed to be in radians.\n    \"\"\"\n    x = r * math.cos(theta)\n    y = r * math.sin(theta)\n    return (x, y)"}
{"task_id": "Mbpp/590", "solution": "import math\ndef polar_rect(radius, angle):\n    \"\"\"Converts polar coordinates (radius, angle in radians) to rectangular coordinates (x, y).\n    The result is returned as a complex number representing (x + yj).\"\"\"\n    x = radius * math.cos(angle)\n    y = radius * math.sin(angle)\n    return complex(x, y)"}
{"task_id": "Mbpp/591", "solution": "def swap_List(lst: list) -> list:\n    \"\"\"\n    Interchanges the first and last elements of a list in-place.\n    Returns the original list if it has fewer than two elements.\n    \"\"\"\n    if len(lst) < 2:\n        return lst\n    lst[0], lst[-1] = lst[-1], lst[0]\n    return lst"}
