{"task_id": "Mbpp/448", "solution": "_perrin_memo = {\n    0: 3,\n    1: 0,\n    2: 2\n}\ndef calculate_perrin(n: int) -> int:\n    \"\"\"Calculates the nth Perrin number using memoization.\n    It directly accesses a module-level cache for efficiency.\"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    if n in _perrin_memo:\n        return _perrin_memo[n]\n\n    # Recalculate using the recurrence relation and store the result.\n    result = calculate_perrin(n - 2) + calculate_perrin(n - 3)\n    _perrin_memo[n] = result\n    return result\ndef cal_sum(n: int) -> int:\n    \"\"\"Calculates the sum of Perrin numbers from P(0) up to P(n), inclusive.\n    It iterates and sums individual Perrin numbers, relying on memoization.\"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    total_sum = 0\n    for i in range(n + 1):\n        total_sum += calculate_perrin(i)\n    return total_sum"}
{"task_id": "Mbpp/448", "solution": "def cal_sum(n: int) -> int:\n    \"\"\"Calculates the sum of Perrin numbers from P(0) to P(n).\n    Uses memoization for efficient Perrin number computation within the call.\"\"\"\n\n    memo = {\n        0: 3,\n        1: 0,\n        2: 2\n    }\n\n    def _get_perrin_number(k: int) -> int:\n        \"\"\"Helper to calculate the kth Perrin number using memoization.\"\"\"\n        if k in memo:\n            return memo[k]\n\n        # P(k) = P(k-2) + P(k-3)\n        perrin_k = _get_perrin_number(k - 2) + _get_perrin_number(k - 3)\n        memo[k] = perrin_k\n        return perrin_k\n\n    total_sum = 0\n    for i in range(n + 1):\n        total_sum += _get_perrin_number(i)\n    return total_sum"}
{"task_id": "Mbpp/450", "solution": "def extract_string(string_list: list, size: int) -> list:\n    \"\"\"\n    Extracts strings of a specified size from a given list of string values.\n\n    Args:\n        string_list: A list of string values.\n        size: The desired length of strings to extract.\n\n    Returns:\n        A new list containing only strings whose length matches the input size.\n    \"\"\"\n    if not isinstance(string_list, list):\n        raise TypeError(\"string_list must be a list.\")\n    if not isinstance(size, int):\n        raise TypeError(\"size must be an integer.\")\n    if size < 0:\n        raise ValueError(\"size cannot be negative.\")\n\n    filtered_strings = [s for s in string_list if isinstance(s, str) and len(s) == size]\n    return filtered_strings"}
