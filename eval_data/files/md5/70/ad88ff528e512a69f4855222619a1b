{"task_id": "Mbpp/597", "solution": "def find_kth(arr1, arr2, k):\n    \"\"\"\n    Finds the k-th smallest element from two given sorted arrays.\n    This uses a binary search approach for optimal logarithmic time complexity.\n    \"\"\"\n    len1, len2 = len(arr1), len(arr2)\n\n    # Ensure arr1 is the shorter array to optimize binary search range\n    if len1 > len2:\n        arr1, arr2 = arr2, arr1\n        len1, len2 = len2, len1\n\n    # Binary search for a partition point in arr1\n    # 'low' represents the minimum possible elements to take from arr1\n    # 'high' represents the maximum possible elements to take from arr1\n    low = max(0, k - len2)\n    high = min(k, len1)\n\n    while low <= high:\n        # mid1 is the number of elements taken from arr1\n        mid1 = (low + high) // 2\n        # mid2 is the number of elements taken from arr2\n        mid2 = k - mid1\n\n        # L1: element before mid1 in arr1 (or -infinity if mid1 is 0)\n        # R1: element at mid1 in arr1 (or +infinity if mid1 is len1)\n        # L2: element before mid2 in arr2 (or -infinity if mid2 is 0)\n        # R2: element at mid2 in arr2 (or +infinity if mid2 is len2)\n        L1 = arr1[mid1 - 1] if mid1 > 0 else float('-inf')\n        R1 = arr1[mid1] if mid1 < len1 else float('inf')\n        L2 = arr2[mid2 - 1] if mid2 > 0 else float('-inf')\n        R2 = arr2[mid2] if mid2 < len2 else float('inf')\n\n        if L1 <= R2 and L2 <= R1:\n            # Partition is correct: L1, L2 <= R1, R2\n            # The k-th element is the maximum of L1 and L2\n            return max(L1, L2)\n        elif L1 > R2:\n            # mid1 is too high, need to move left in arr1\n            high = mid1 - 1\n        else: # L2 > R1\n            # mid1 is too low, need to move right in arr1\n            low = mid1 + 1"}
{"task_id": "Mbpp/597", "solution": "def find_kth(arr1: list[int], arr2: list[int], k: int) -> int:\n    \"\"\"\n    Finds the k-th smallest element from two sorted arrays.\n    Assumes valid, sorted input arrays and k within bounds.\n    \"\"\"\n    len1, len2 = len(arr1), len(arr2)\n\n    # Ensure arr1 is the shorter array for optimization\n    if len1 > len2:\n        arr1, arr2 = arr2, arr1\n        len1, len2 = len2, len1\n\n    # Binary search range for partition1 in arr1\n    # low: minimum elements to take from arr1 (to satisfy k if arr2 is too short)\n    low = max(0, k - len2)\n    # high: maximum elements to take from arr1 (cannot exceed k or len1)\n    high = min(len1, k)\n\n    while low <= high:\n        partition1 = (low + high) // 2\n        partition2 = k - partition1\n\n        # Determine elements at the boundaries of the partitions\n        max_left1 = arr1[partition1 - 1] if partition1 > 0 else float('-inf')\n        min_right1 = arr1[partition1] if partition1 < len1 else float('inf')\n\n        max_left2 = arr2[partition2 - 1] if partition2 > 0 else float('-inf')\n        min_right2 = arr2[partition2] if partition2 < len2 else float('inf')\n\n        # Check if partitions are correctly placed\n        if max_left1 <= min_right2 and max_left2 <= min_right1:\n            return max(max_left1, max_left2)\n        elif max_left1 > min_right2:\n            # max_left1 is too large, move partition1 to the left\n            high = partition1 - 1\n        else:\n            # max_left2 is too large (meaning max_left1 is too small), move partition1 to the right\n            low = partition1 + 1"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(number: int) -> bool:\n    \"\"\"\n    Checks if a number is an Armstrong number.\n    An Armstrong number is equal to the sum of its own digits each raised to the power of the number of digits.\n    \"\"\"\n    if number < 0:\n        return False\n    \n    num_str = str(number)\n    n = len(num_str)\n    sum_of_powers = 0\n\n    for digit_char in num_str:\n        digit = int(digit_char)\n        sum_of_powers += digit ** n\n    \n    return sum_of_powers == number"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(number: int) -> bool:\n    \"\"\"Checks if an integer is an Armstrong number based on its digits raised to the power of the total digit count.\"\"\"\n    if number < 0:\n        return False\n    if number == 0:\n        return True\n\n    num_str = str(number)\n    num_digits = len(num_str)\n    sum_of_powers = 0\n    for digit_char in num_str:\n        digit = int(digit_char)\n        sum_of_powers += digit ** num_digits\n    \n    return sum_of_powers == number"}
