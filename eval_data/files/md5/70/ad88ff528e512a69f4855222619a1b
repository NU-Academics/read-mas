{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr):\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    It returns True if the array is a min-heap, False otherwise.\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n and arr[left_child_idx] < arr[i]:\n            return False\n\n        # Check right child\n        if right_child_idx < n and arr[right_child_idx] < arr[i]:\n            return False\n    return True"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr: list) -> bool:\n    \"\"\"\n    Determines if the given list `arr` represents a valid min-heap.\n    It checks if each parent node is less than or equal to its children.\n    \"\"\"\n    n = len(arr)\n\n    if n <= 1:\n        return True\n\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        if left_child_idx < n and arr[i] > arr[left_child_idx]:\n            return False\n\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth Jacobsthal number iteratively.\n    This implementation assumes n is a non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    # Initialize base cases J(0) and J(1)\n    j_n_minus_2 = 0\n    j_n_minus_1 = 1\n\n    # Calculate J(n) using the recurrence J(n) = J(n-1) + 2 * J(n-2)\n    for _ in range(2, n + 1):\n        current_j = j_n_minus_1 + 2 * j_n_minus_2\n        j_n_minus_2 = j_n_minus_1\n        j_n_minus_1 = current_j\n\n    return j_n_minus_1"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n):\n    \"\"\"Calculates the nth Jacobsthal number using an iterative approach.\n    The sequence is defined by J(0)=0, J(1)=1, and J(n) = J(n-1) + 2 * J(n-2).\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    else:\n        # Initialize for J(0) and J(1)\n        j_n_minus_2 = 0\n        j_n_minus_1 = 1\n\n        # Calculate iteratively from J(2) up to J(n)\n        for _ in range(2, n + 1):\n            current_j = j_n_minus_1 + 2 * j_n_minus_2\n            j_n_minus_2 = j_n_minus_1\n            j_n_minus_1 = current_j\n        return current_j"}
{"task_id": "Mbpp/753", "solution": "def min_k(data: list[tuple[str, int]], k: int) -> list[tuple[str, int]]:\n    \"\"\"\n    Sorts the input list of tuples by their second element and returns the first k elements.\n    Relies on Python's slicing behavior to handle k <= 0 and k > len(data) edge cases.\n    \"\"\"\n    sorted_data = sorted(data, key=lambda item: item[1])\n    return sorted_data[:k]"}
