{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list: list, k: int) -> list:\n    \"\"\"\n    Removes the element at the k'th position (1-based index) from a list.\n    Handles out-of-bounds k by returning a shallow copy of the original list.\n    \"\"\"\n    if not input_list:\n        return []\n\n    if k < 1 or k > len(input_list):\n        return list(input_list)\n\n    zero_based_index = k - 1\n    new_list = input_list[:zero_based_index] + input_list[zero_based_index+1:]\n    return new_list"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix: list[list[int | float]], n: int) -> int | float:\n    \"\"\"\n    Calculates the maximum numeric value in the n'th column of the given matrix.\n    Rows shorter than n are skipped, and the column must contain at least one element.\n    \"\"\"\n    column_elements = []\n    for row in matrix:\n        if n < len(row):\n            column_elements.append(row[n])\n    return max(column_elements)"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix, n):\n    \"\"\"Finds the maximum value in the nth column of a matrix.\n    Assumes valid, non-empty matrix and a valid column index.\"\"\"\n    if not matrix:\n        raise ValueError(\"Input matrix cannot be empty.\")\n    \n    # Check if column index is valid for at least the first row\n    if not matrix[0] or n < 0 or n >= len(matrix[0]):\n        raise ValueError(\"Column index out of bounds.\")\n\n    max_val = matrix[0][n]\n\n    for i in range(1, len(matrix)):\n        # This check ensures that if the matrix is jagged, we still handle it\n        if n >= len(matrix[i]):\n            raise ValueError(f\"Column index {n} out of bounds for row {i}.\")\n        \n        if matrix[i][n] > max_val:\n            max_val = matrix[i][n]\n    \n    return max_val"}
