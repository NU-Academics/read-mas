{"task_id": "Mbpp/409", "solution": "def min_product_tuple(data: list[tuple[int | float, int | float]]) -> int | float:\n    \"\"\"\n    Finds the minimum product from pairs of numbers within a given list of tuples.\n    It assumes valid input and directly calculates the smallest product.\n    \"\"\"\n    min_product = float('inf')\n\n    for num1, num2 in data:\n        product = num1 * num2\n        if product < min_product:\n            min_product = product\n            \n    return min_product"}
{"task_id": "Mbpp/409", "solution": "def min_product_tuple(data: list[tuple[int, int]]) -> int:\n    \"\"\"\n    Calculates the product of elements within each tuple in the data list\n    and returns the minimum product found.\n\n    Args:\n        data: A list where each element is expected to be a tuple of two integers.\n\n    Returns:\n        The minimum product found.\n\n    Raises:\n        InvalidInputError: If the input data is not valid according to\n                           the specified constraints.\n    \"\"\"\n    validate_tuple_list(data)\n\n    products = []\n    for item in data:\n        product = item[0] * item[1]\n        products.append(product)\n\n    return min(products)"}
{"task_id": "Mbpp/410", "solution": "from typing import List, Union, Any\nclass NoNumericValueError(Exception):\n    \"\"\"Custom exception raised when no numeric values are found in a list.\n    It carries a descriptive message explaining the error.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass MinFinderService:\n    \"\"\"Encapsulates the core logic for filtering numeric values and finding the minimum.\n    This service is stateless and performs the main computations.\n    \"\"\"\n    def find_min(self, data_list: List[Any]) -> Union[int, float]:\n        \"\"\"Filters the list for numeric values and returns the minimum among them.\n        Raises NoNumericValueError if no numeric values are found after filtering.\n        \"\"\"\n        numeric_values = self._filter_numerics(data_list)\n        if not numeric_values:\n            raise NoNumericValueError(\"No numeric values found in the list.\")\n        return min(numeric_values)\n\n    def _filter_numerics(self, data_list: List[Any]) -> List[Union[int, float]]:\n        \"\"\"A private helper method to return a new list containing only int or float elements.\n        Non-numeric elements are silently ignored.\n        \"\"\"\n        return [item for item in data_list if isinstance(item, (int, float))]\ndef min_val(data_list: List[Any]) -> Union[int, float]:\n    \"\"\"Finds the minimum numeric value in a given heterogeneous list.\n    It performs initial input validation and delegates core logic to MinFinderService.\n    \"\"\"\n    if not isinstance(data_list, list):\n        raise TypeError(\"Input must be a list.\")\n    service = MinFinderService()\n    return service.find_min(data_list)"}
{"task_id": "Mbpp/410", "solution": "def min_val(data_list: list):\n    \"\"\"\n    Finds the minimum numeric value in a given heterogeneous list,\n    ignoring non-numeric elements.\n\n    Args:\n        data_list: A list of arbitrary Python objects.\n\n    Returns:\n        The minimum numeric value found in the list.\n\n    Raises:\n        ValueError: If no comparable numeric values are found in the list.\n    \"\"\"\n    numeric_values = []\n    for item in data_list:\n        if isinstance(item, (int, float)):\n            numeric_values.append(item)\n\n    if not numeric_values:\n        raise ValueError(\"No comparable numeric values found in the list.\")\n\n    return min(numeric_values)"}
