{"task_id": "Mbpp/119", "solution": "def search(arr: list[int]) -> int:\n    \"\"\"\n    Finds the single unique element in a sorted array where all other elements appear twice.\n    Assumes valid input conforming to the problem's constraints for performance.\n    \"\"\"\n    low, high = 0, len(arr) - 1\n\n    while low <= high:\n        mid = (low + high) // 2\n\n        # Check if mid's pair is adjacent. If not, mid or an element to its left is unique.\n        # If mid is even, its pair should be at mid + 1.\n        # If mid is odd, its pair should be at mid - 1.\n        if (mid % 2 == 0 and mid + 1 < len(arr) and arr[mid] == arr[mid + 1]) or \\\n           (mid % 2 == 1 and mid - 1 >= 0 and arr[mid] == arr[mid - 1]):\n            # The current mid and its pair are part of the even-indexed segments.\n            # The unique element must be on the right side.\n            low = mid + 1\n        else:\n            # The current mid either has no pair at its expected position,\n            # or it is the unique element itself. Search in the left half including mid.\n            high = mid - 1\n            \n    # After the loop, 'low' will point to the index of the unique element.\n    return arr[low]"}
{"task_id": "Mbpp/119", "solution": "def search(arr: list[int]) -> int | None:\n    \"\"\"\n    Finds the single unique element in a sorted array where all other elements appear twice.\n    The array is guaranteed to be sorted.\n    \"\"\"\n    if not arr:\n        return None\n    if len(arr) == 1:\n        return arr[0]\n\n    low, high = 0, len(arr) - 1\n\n    while low < high:\n        mid = low + (high - low) // 2\n\n        # Ensure mid points to the start of a potential pair (even index)\n        if mid % 2 == 1:\n            mid -= 1\n\n        # If elements at mid and mid+1 are a pair, the unique element is to the right\n        if arr[mid] == arr[mid+1]:\n            low = mid + 2\n        # Otherwise, the unique element is at or to the left of mid\n        else:\n            high = mid\n\n    return arr[low]"}
{"task_id": "Mbpp/120", "solution": "from typing import List, Tuple, Union\ndef max_product_tuple(data: List[Tuple[Union[int, float], Union[int, float]]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the maximum absolute product from a list of two-element numeric tuples.\n    Returns 0 if the input list is empty.\n    \"\"\"\n    max_abs_product = 0.0\n\n    for num1, num2 in data:\n        current_product = num1 * num2\n        max_abs_product = max(max_abs_product, abs(current_product))\n\n    return max_abs_product"}
{"task_id": "Mbpp/120", "solution": "from typing import List, Tuple, Union\ndef max_product_tuple(data: List[Tuple[Union[int, float], Union[int, float]]]) -> Union[int, float]:\n    \"\"\"\n    Identifies the maximum absolute product from a collection of number pairs.\n    Returns 0 if the input list of tuples is empty.\n    \"\"\"\n    if not data:\n        return 0\n\n    max_abs_product: Union[int, float] = 0\n\n    for num1, num2 in data:\n        product = num1 * num2\n        abs_product = abs(product)\n        if abs_product > max_abs_product:\n            max_abs_product = abs_product\n            \n    return max_abs_product"}
{"task_id": "Mbpp/123", "solution": "_divisor_sums_cache = {}\ndef _sum_of_proper_divisors(num: int) -> int:\n    \"\"\"Calculates the sum of proper divisors for a number, using a cache.\"\"\"\n    if num in _divisor_sums_cache:\n        return _divisor_sums_cache[num]\n\n    if num <= 0:\n        return 0\n    \n    s = 0\n    if num > 1:\n        s = 1\n    \n    for i in range(2, int(num**0.5) + 1):\n        if num % i == 0:\n            s += i\n            if i * i != num:\n                s += num // i\n    _divisor_sums_cache[num] = s\n    return s\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"Calculates the sum of all amicable numbers up to a specified limit.\"\"\"\n    if not isinstance(limit, int) or limit <= 0:\n        raise ValueError(\"Limit must be a positive integer.\")\n\n    total_sum = 0\n    found_amicable_numbers = set()\n\n    for a in range(1, limit):\n        if a in found_amicable_numbers:\n            continue\n\n        b = _sum_of_proper_divisors(a)\n        \n        if b > 0 and a != b and b <= limit:\n            c = _sum_of_proper_divisors(b)\n            if a == c:\n                if a not in found_amicable_numbers:\n                    total_sum += a\n                    found_amicable_numbers.add(a)\n                if b not in found_amicable_numbers:\n                    total_sum += b\n                    found_amicable_numbers.add(b)\n    return total_sum"}
{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(limit: int) -> int:\n    \"\"\"\n    Calculates the sum of all unique amicable numbers from 1 to a specified limit.\n    \"\"\"\n\n    def sum_proper_divisors(n: int) -> int:\n        \"\"\"Calculates the sum of all positive divisors of n excluding n itself.\"\"\"\n        if n == 1:\n            return 0 \n\n        s = 1 \n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                s += i\n                if i * i != n:\n                    s += n // i\n        return s\n\n    amicable_numbers_found = set()\n    \n    for n in range(1, limit + 1):\n        if n in amicable_numbers_found:\n            continue\n\n        sum_divisors_n = sum_proper_divisors(n)\n        \n        if sum_divisors_n != n and sum_divisors_n <= limit: \n            sum_divisors_m = sum_proper_divisors(sum_divisors_n)\n            \n            if sum_divisors_m == n:\n                amicable_numbers_found.add(n)\n                amicable_numbers_found.add(sum_divisors_n)\n    \n    return sum(amicable_numbers_found)"}
