{"task_id": "Mbpp/777", "solution": "def find_sum(numbers):\n    # Counts the frequency of each number in the list.\n    counts = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    # Sums numbers that appear exactly once.\n    total_sum = 0\n    for num, count in counts.items():\n        if count == 1:\n            total_sum += num\n    return total_sum"}
{"task_id": "Mbpp/777", "solution": "from collections import Counter\ndef find_sum(numbers: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of elements that appear exactly once in the given list.\n    Returns 0 if the list is empty or contains no unique elements.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    counts = Counter(numbers)\n    unique_sum = 0\n    for num, count in counts.items():\n        if count == 1:\n            unique_sum += num\n    return unique_sum"}
{"task_id": "Mbpp/778", "solution": "from typing import Any, List\ndef pack_consecutive_duplicates(input_list: List[Any]) -> List[List[Any]]:\n    \"\"\"Packs consecutive duplicates of list elements into sublists.\n    Returns a new list where consecutive duplicates are grouped.\"\"\"\n\n    packed_list: List[List[Any]] = []\n    current_sublist: List[Any] = []\n\n    for item in input_list:\n        if not current_sublist or item == current_sublist[-1]:\n            current_sublist.append(item)\n        else:\n            packed_list.append(current_sublist)\n            current_sublist = [item]\n    \n    if current_sublist:\n        packed_list.append(current_sublist)\n\n    return packed_list"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(data_list: list) -> list[list]:\n    \"\"\"Packs consecutive duplicates of a given list elements into sublists.\n    It returns a new list where consecutive duplicates are grouped.\"\"\"\n    if not data_list:\n        return []\n\n    packed_list = []\n    current_sublist = [data_list[0]]\n\n    for i in range(1, len(data_list)):\n        if data_list[i] == data_list[i-1]:\n            current_sublist.append(data_list[i])\n        else:\n            packed_list.append(current_sublist)\n            current_sublist = [data_list[i]]\n    \n    packed_list.append(current_sublist) # Append the last sublist\n    return packed_list"}
{"task_id": "Mbpp/780", "solution": "import itertools\nfrom typing import List, Tuple, Union\ndef find_combinations(tuple_list: List[Tuple[Union[int, float], ...]]) -> List[Tuple[Union[int, float], ...]]:\n    \"\"\"\n    Calculates all unique pairwise element-wise sums from a list of tuples.\n    Returns an empty list if there are fewer than two tuples.\n    \"\"\"\n    if len(tuple_list) < 2:\n        return []\n\n    result_sums: List[Tuple[Union[int, float], ...]] = []\n    for tuple1, tuple2 in itertools.combinations(tuple_list, 2):\n        sum_tuple = tuple(x + y for x, y in zip(tuple1, tuple2))\n        result_sums.append(sum_tuple)\n\n    return result_sums"}
{"task_id": "Mbpp/780", "solution": "import itertools\ndef find_combinations(tuple_list: list[tuple]) -> list[tuple]:\n    \"\"\"Calculates combinations of element-wise sums of distinct tuples from a list.\n    It returns a new list of tuples, each being the sum of two unique input tuples.\n    \"\"\"\n    result_sums = []\n    for t1, t2 in itertools.combinations(tuple_list, 2):\n        # Perform element-wise summation for the pair of tuples.\n        sum_tuple = tuple(a + b for a, b in zip(t1, t2))\n        result_sums.append(sum_tuple)\n    \n    return result_sums"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(number: int) -> bool:\n    \"\"\"\n    Calculates the number of divisors for a positive integer and checks if it's even.\n    It iterates up to the square root of the number to efficiently count divisors.\n    \"\"\"\n    count = 0\n    i = 1\n    while i * i <= number:\n        if number % i == 0:\n            if i * i == number:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count % 2 == 0"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks if a positive integer has an even number of divisors.\n    A number has an even number of divisors if and only if it is not a perfect square.\n    \"\"\"\n    sqrt_n = int(n**0.5)\n    is_perfect_square = (sqrt_n * sqrt_n == n)\n    return not is_perfect_square"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of all elements across all possible odd-length subarrays of the input array.\n    This implementation iterates through all subarrays and sums elements of odd-length ones.\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):\n        for j in range(i, n):\n            # Subarray is arr[i:j+1]\n            subarray_length = j - i + 1\n            if subarray_length % 2 == 1:\n                # Sum elements of the odd-length subarray\n                for k in range(i, j + 1):\n                    total_sum += arr[k]\n    return total_sum"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int]) -> int:\n    \"\"\"Calculates the sum of all odd-length subarrays within a given array.\n    This uses an efficient O(N) approach to sum each element's contribution.\"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):\n        # Calculate the number of times arr[i] appears in odd-length subarrays.\n        # It appears in (i + 1) * (n - i) total subarrays.\n        # The number of odd-length subarrays containing arr[i] is ceil(((i + 1) * (n - i)) / 2).\n        # This simplifies to ((i + 1) * (n - i) + 1) // 2.\n        count_left = i + 1  # Number of possible start positions to the left (including itself)\n        count_right = n - i # Number of possible end positions to the right (including itself)\n        \n        num_odd_subarrays_containing_i = (count_left * count_right + 1) // 2\n        total_sum += arr[i] * num_odd_subarrays_containing_i\n            \n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(numbers: list) -> int | None:\n    \"\"\"Calculates the product of the first encountered even and odd numbers.\n    Returns None if either an even or an odd number is not found.\"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        # The design document specified handling of non-integer elements.\n        # However, the original prompt and assert imply all elements are integers.\n        # Given the core guideline \"Return ONLY the bare function\", and the fact\n        # that the prompt doesn't explicitly mention non-integers, I'll remove\n        # the 'isinstance' check to keep the function as lean as possible\n        # and directly address the problem as stated, which focuses on\n        # even/odd numbers (implicitly integers). If non-integers are expected,\n        # the prompt should explicitly state it or the design should strictly enforce\n        # the isinstance check. For this specific case, based on the prompt's\n        # simplicity, I will assume integer input. If a non-integer is encountered\n        # and \"%\" is applied, a TypeError will naturally occur, which is Python's\n        # way of handling unexpected types.\n\n        # Check for the first even number\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        \n        # Check for the first odd number\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n\n        # If both have been found, stop iterating early\n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is not None and first_odd is not None:\n        return first_even * first_odd\n    else:\n        return None"}
{"task_id": "Mbpp/784", "solution": "class ProductFinderError(Exception):\n    \"\"\"Custom exception for errors in ProductFinder operations.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef mul_even_odd(numbers: list) -> int:\n    \"\"\"\n    Finds the product of the first even and first odd number in a given list.\n\n    Args:\n        numbers: A list of numbers.\n\n    Returns:\n        The product of the first even and first odd number.\n\n    Raises:\n        TypeError: If the input is not a list.\n        ProductFinderError: If no even number or no odd number is found in the list.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if isinstance(num, int):\n            if first_even is None and num % 2 == 0:\n                first_even = num\n            if first_odd is None and num % 2 != 0:\n                first_odd = num\n            \n            if first_even is not None and first_odd is not None:\n                break\n    \n    if first_even is None:\n        raise ProductFinderError(\"No even number found in the list.\")\n    \n    if first_odd is None:\n        raise ProductFinderError(\"No odd number found in the list.\")\n\n    return first_even * first_odd"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(tuple_string: str) -> tuple[int, ...]:\n    \"\"\"\n    Converts a string representation of an integer tuple to an actual tuple of integers.\n    Assumes the input string is correctly formatted with parentheses and contains only integers.\n    \"\"\"\n    content = tuple_string[1:-1].strip()\n\n    if not content:\n        return ()\n\n    elements = content.split(',')\n    result_elements: list[int] = [int(element_str.strip()) for element_str in elements]\n\n    return tuple(result_elements)"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(tuple_str: str) -> tuple[int, ...]:\n    \"\"\"Converts a tuple string like '(7, 8, 9)' to an integer tuple (7, 8, 9).\n    Assumes valid input format with integers and parentheses.\"\"\"\n    stripped_str = tuple_str.strip()\n    content = stripped_str[1:-1].strip()\n\n    if not content:\n        return ()\n\n    elements = []\n    for item in content.split(','):\n        elements.append(int(item.strip()))\n    \n    return tuple(elements)"}
