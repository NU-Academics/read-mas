{"task_id": "Mbpp/638", "solution": "def wind_chill(velocity: float, temperature: float) -> int:\n    \"\"\"Calculates the wind chill index based on wind velocity and temperature.\n    The result is rounded to the nearest integer.\n    \"\"\"\n\n    # Wind chill formula: WCI = 13.12 + 0.6215*T - 11.37*V^0.16 + 0.3965*T*V^0.16\n    # Where T is temperature (celsius) and V is velocity (km/h)\n\n    wind_chill_index = (\n        13.12\n        + 0.6215 * temperature\n        - 11.37 * (velocity**0.16)\n        + 0.3965 * temperature * (velocity**0.16)\n    )\n    return round(wind_chill_index)"}
{"task_id": "Mbpp/638", "solution": "import math\ndef wind_chill(wind_velocity_kmh: float, temperature_celsius: float) -> int:\n    \"\"\"\n    Calculates the Canadian Wind Chill Index and rounds the result up to the next integer.\n    The formula is applied directly to the provided temperature and wind velocity.\n    \"\"\"\n    # WCI = 13.12 + 0.6215 * T - 11.37 * V^0.16 + 0.3965 * T * V^0.16\n    # T = temperature_celsius, V = wind_velocity_kmh\n    wind_chill_float = (\n        13.12\n        + (0.6215 * temperature_celsius)\n        - (11.37 * math.pow(wind_velocity_kmh, 0.16))\n        + (0.3965 * temperature_celsius * math.pow(wind_velocity_kmh, 0.16))\n    )\n\n    return math.ceil(wind_chill_float)"}
