{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix: list[list[int]]) -> bool:\n    \"\"\"\n    Checks if the given matrix is a magic square.\n    A magic square contains numbers 1 to N^2 exactly once and has equal sums for rows, columns, and both diagonals.\n    \"\"\"\n    n = len(matrix)\n\n    # Verify if the input matrix is square (N x N) and handle empty matrix.\n    if n == 0:\n        return False\n    for row in matrix:\n        if len(row) != n:\n            return False\n\n    # Handle 1x1 matrix special case.\n    if n == 1:\n        return matrix[0][0] == 1\n\n    # Verify if all numbers from 1 to N^2 are present exactly once.\n    expected_numbers = set(range(1, n * n + 1))\n    actual_numbers = set()\n    for r_idx in range(n):\n        for c_idx in range(n):\n            num = matrix[r_idx][c_idx]\n            actual_numbers.add(num)\n    if actual_numbers != expected_numbers:\n        return False\n\n    # Determine the target sum from the first row.\n    target_sum = sum(matrix[0])\n\n    # Calculate and verify row sums.\n    for row in matrix:\n        if sum(row) != target_sum:\n            return False\n\n    # Calculate and verify column sums.\n    for c_idx in range(n):\n        col_sum = 0\n        for r_idx in range(n):\n            col_sum += matrix[r_idx][c_idx]\n        if col_sum != target_sum:\n            return False\n\n    # Calculate and verify main diagonal sum.\n    main_diag_sum = 0\n    for i in range(n):\n        main_diag_sum += matrix[i][i]\n    if main_diag_sum != target_sum:\n        return False\n\n    # Calculate and verify anti-diagonal sum.\n    anti_diag_sum = 0\n    for i in range(n):\n        anti_diag_sum += matrix[i][n - 1 - i]\n    if anti_diag_sum != target_sum:\n        return False\n\n    return True"}
{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix: list[list[int]]) -> bool:\n    \"\"\"Checks if the given matrix is a magic square.\n    A magic square is a square matrix where sums of rows, columns, and diagonals are equal, and contains all integers from 1 to n^2 exactly once.\n    \"\"\"\n    if not matrix:\n        return False\n    \n    n = len(matrix)\n    for row in matrix:\n        if len(row) != n:\n            return False\n\n    expected_sum = n * (n * n + 1) // 2\n\n    for row in matrix:\n        if sum(row) != expected_sum:\n            return False\n\n    for col_idx in range(n):\n        col_sum = 0\n        for row_idx in range(n):\n            col_sum += matrix[row_idx][col_idx]\n        if col_sum != expected_sum:\n            return False\n\n    diag1_sum = 0\n    diag2_sum = 0\n    for i in range(n):\n        diag1_sum += matrix[i][i]\n        diag2_sum += matrix[i][n - 1 - i]\n    if diag1_sum != expected_sum or diag2_sum != expected_sum:\n        return False\n\n    seen_elements = set()\n    max_val = n * n\n    for row in matrix:\n        for element in row:\n            if not isinstance(element, int): # Added check for non-integer elements\n                return False\n            if not (1 <= element <= max_val):\n                return False\n            if element in seen_elements:\n                return False\n            seen_elements.add(element)\n    \n    if len(seen_elements) != max_val:\n        return False\n\n    return True"}
{"task_id": "Mbpp/130", "solution": "from typing import Any, List, Optional\ndef max_occurrences(data_list: List[Any]) -> Optional[Any]:\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    Returns None if the list is empty, otherwise returns the most frequent item.\n    \"\"\"\n    if not data_list:\n        return None\n\n    counts = {}\n    for item in data_list:\n        counts[item] = counts.get(item, 0) + 1\n\n    max_item = None\n    max_count = -1\n\n    for item, count in counts.items():\n        if count > max_count:\n            max_count = count\n            max_item = item\n    \n    return max_item"}
{"task_id": "Mbpp/130", "solution": "from dataclasses import dataclass, field\nfrom typing import List, Any\nimport collections\nclass FrequencyAnalyzer:\n    \"\"\"\n    Provides core logic for analyzing a list to find most frequent items.\n    It is a stateless utility class for frequency analysis.\n    \"\"\"\n    def find_max_frequency_item(self, data: list) -> FrequencyResult:\n        \"\"\"\n        Finds the item(s) with maximum frequency in a given list.\n        Returns a FrequencyResult object with the most frequent items and their count.\n        \"\"\"\n        if not isinstance(data, (list, tuple)):\n            raise TypeError(\"Input 'data' must be an iterable (e.g., list or tuple).\")\n\n        if not data:\n            return FrequencyResult(items=[], count=0)\n\n        frequency_map = self._count_frequencies(data)\n        max_items, max_count = self._get_max_frequency_items(frequency_map)\n\n        return FrequencyResult(items=max_items, count=max_count)\n\n    def _count_frequencies(self, data: list) -> dict:\n        \"\"\"\n        Counts occurrences of each unique item using collections.Counter.\n        This method is private and used internally.\n        \"\"\"\n        return dict(collections.Counter(data))\n\n    def _get_max_frequency_items(self, frequency_map: dict) -> tuple[list, int]:\n        \"\"\"\n        Identifies max frequency and all items associated with it.\n        This method is private and used internally.\n        \"\"\"\n        if not frequency_map:\n            return [], 0\n\n        max_count = 0\n        for count in frequency_map.values():\n            if count > max_count:\n                max_count = count\n        \n        max_items = [item for item, count in frequency_map.items() if count == max_count]\n        \n        return max_items, max_count\ndef max_occurrences(data):\n    \"\"\"\n    Finds the most frequently occurring item in a list.\n    If multiple items have the same max frequency, the first one encountered is returned.\n    \"\"\"\n    analyzer = FrequencyAnalyzer()\n    result = analyzer.find_max_frequency_item(data)\n    \n    if result.items:\n        return result.items[0]\n    else:\n        return None"}
{"task_id": "Mbpp/131", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u'}\ndef reverse_vowels(s: str) -> str:\n    \"\"\"Reverses only the vowels within the input string, treating 'y' as a consonant.\"\"\"\n    s_list = list(s)\n    vowel_indices = []\n    vowels_found = []\n\n    for i, char in enumerate(s_list):\n        if char.lower() in VOWELS:\n            vowel_indices.append(i)\n            vowels_found.append(char)\n\n    vowels_found.reverse()\n\n    for i, original_index in enumerate(vowel_indices):\n        s_list[original_index] = vowels_found[i]\n\n    return \"\".join(s_list)"}
