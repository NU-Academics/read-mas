{"task_id": "Mbpp/223", "solution": "def _find_first_occurrence(sorted_array: list[int], low: int, high: int, element: int) -> int:\n    \"\"\"Finds the index of the first occurrence of `element` using binary search.\n    Returns -1 if the element is not found in the array.\n    \"\"\"\n    first = -1\n    while low <= high:\n        mid = (low + high) // 2\n        if sorted_array[mid] == element:\n            first = mid\n            high = mid - 1\n        elif sorted_array[mid] < element:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return first\ndef _find_last_occurrence(sorted_array: list[int], low: int, high: int, element: int) -> int:\n    \"\"\"Finds the index of the last occurrence of `element` using binary search.\n    Returns -1 if the element is not found in the array.\n    \"\"\"\n    last = -1\n    while low <= high:\n        mid = (low + high) // 2\n        if sorted_array[mid] == element:\n            last = mid\n            low = mid + 1\n        elif sorted_array[mid] < element:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return last\ndef is_majority(sorted_array: list[int], n: int, element: int) -> bool:\n    \"\"\"Determines if `element` occurs more than `n/2` times in the given sorted array.\n    Returns True if it's a majority element, False otherwise.\n    Raises ValueError if the array is empty or n does not match the array's length.\n    \"\"\"\n    if not sorted_array or n != len(sorted_array):\n        raise ValueError(\"Array cannot be empty and n must match array length.\")\n\n    first_occurrence = _find_first_occurrence(sorted_array, 0, n - 1, element)\n    if first_occurrence == -1:\n        return False\n\n    last_occurrence = _find_last_occurrence(sorted_array, 0, n - 1, element)\n    \n    count = last_occurrence - first_occurrence + 1\n    return count > n / 2"}
{"task_id": "Mbpp/223", "solution": "def _first_occurrence(arr: list[int], low: int, high: int, x: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of x in the sorted array arr[low...high].\n    Returns -1 if x is not found.\n    \"\"\"\n    while low <= high:\n        mid = low + (high - low) // 2\n        if (mid == 0 or arr[mid - 1] < x) and arr[mid] == x:\n            return mid\n        elif arr[mid] < x:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return -1\ndef _last_occurrence(arr: list[int], low: int, high: int, x: int) -> int:\n    \"\"\"\n    Finds the index of the last occurrence of x in the sorted array arr[low...high].\n    Returns -1 if x is not found.\n    \"\"\"\n    while low <= high:\n        mid = low + (high - low) // 2\n        if (mid == len(arr) - 1 or arr[mid + 1] > x) and arr[mid] == x:\n            return mid\n        elif arr[mid] > x:\n            high = mid - 1\n        else:\n            low = mid + 1\n    return -1\ndef is_majority(arr: list[int], n: int, x: int) -> bool:\n    \"\"\"\n    Checks if x is a majority element in the sorted array arr of length n.\n    An element is a majority element if it occurs more than n/2 times.\n    \"\"\"\n    if n == 0:\n        return False\n\n    first_idx = _first_occurrence(arr, 0, n - 1, x)\n\n    if first_idx == -1:\n        return False # x is not present in the array\n\n    last_idx = _last_occurrence(arr, 0, n - 1, x)\n\n    # Calculate count of x\n    count = last_idx - first_idx + 1\n\n    return count > (n / 2)"}
{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(number):\n    \"\"\"Counts the number of set bits (1s) in the binary representation of an integer.\n    Uses Brian Kernighan's algorithm for efficiency.\"\"\"\n    count = 0\n    while number > 0:\n        number &= (number - 1)\n        count += 1\n    return count"}
{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(number: int) -> int:\n    \"\"\"Counts the number of set bits (1s) in the binary representation of a non-negative integer.\n    This function implements Brian Kernighan's algorithm for efficient bit counting.\"\"\"\n    count = 0\n    while number > 0:\n        number &= (number - 1)  # Clear the least significant set bit\n        count += 1\n    return count"}
