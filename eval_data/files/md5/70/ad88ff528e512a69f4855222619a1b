{"task_id": "Mbpp/74", "solution": "from typing import List\ndef is_samepatterns(colors: List[str], patterns: List[str]) -> bool:\n    \"\"\"\n    Checks if two sequences of elements follow an identical structural pattern.\n    Requires a consistent one-to-one mapping between elements in `colors` and `patterns`.\n    \"\"\"\n    if len(colors) != len(patterns):\n        return False\n\n    color_to_pattern_map: dict[str, str] = {}\n    pattern_to_color_map: dict[str, str] = {}\n\n    for i in range(len(colors)):\n        color = colors[i]\n        pattern = patterns[i]\n\n        # Check mapping from color to pattern\n        if color in color_to_pattern_map:\n            if color_to_pattern_map[color] != pattern:\n                return False\n        else:\n            color_to_pattern_map[color] = pattern\n\n        # Check mapping from pattern to color\n        if pattern in pattern_to_color_map:\n            if pattern_to_color_map[pattern] != color:\n                return False\n        else:\n            pattern_to_color_map[pattern] = color\n    \n    return True"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(items: list[str], pattern: list[str]) -> bool:\n    \"\"\"Checks if a list of strings follows a given pattern list with a one-to-one mapping.\n    Returns True if patterns match, False otherwise.\"\"\"\n    if len(items) != len(pattern):\n        return False\n\n    if not items:  # If lengths are equal and items is empty, both lists are empty.\n        return True\n\n    item_to_pattern_map = {}\n    pattern_to_item_map = {}\n\n    for i in range(len(items)):\n        item = items[i]\n        pattern_char = pattern[i]\n\n        # Verify or establish mapping from item to pattern_char.\n        if item in item_to_pattern_map:\n            if item_to_pattern_map[item] != pattern_char:\n                return False\n        else:\n            item_to_pattern_map[item] = pattern_char\n\n        # Verify or establish mapping from pattern_char to item.\n        if pattern_char in pattern_to_item_map:\n            if pattern_to_item_map[pattern_char] != item:\n                return False\n        else:\n            pattern_to_item_map[pattern_char] = item\n\n    return True"}
