{"task_id": "Mbpp/745", "solution": "class DigitChecker:\n    \"\"\"\n    Checks if a number is divisible by all its non-zero digits.\n    \"\"\"\n    def is_divisible_by_all_digits(self, num: int) -> bool:\n        num_str = str(num)\n        for digit_char in num_str:\n            digit = int(digit_char)\n            if digit == 0:\n                continue\n            if num % digit != 0:\n                return False\n        return True\nclass DivisibleNumbersService:\n    \"\"\"\n    Service to find numbers within a range that are divisible by all their digits.\n    \"\"\"\n    def __init__(self, digit_checker: DigitChecker = None):\n        # Initializes the service, optionally injecting a DigitChecker instance for testability.\n        self._digit_checker = digit_checker if digit_checker is not None else DigitChecker()\n\n    def find_divisible_by_digits(self, startnum: int, endnum: int) -> list[int]:\n        # Iterates from startnum to endnum, checking each number and collecting valid results.\n        results = []\n        for num in range(startnum, endnum + 1):\n            if self._digit_checker.is_divisible_by_all_digits(num):\n                results.append(num)\n        return results\ndef divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    \"\"\"\n    service = DivisibleNumbersService()\n    return service.find_divisible_by_digits(startnum, endnum)"}
{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a given range that are divisible by each of their non-zero constituent digits.\n    The range is inclusive, and only positive integers are considered.\n    \"\"\"\n    results = []\n    for num in range(startnum, endnum + 1):\n        if num <= 0:\n            continue  # Only positive integers are considered for divisibility.\n\n        temp_num = num\n        all_digits_divide = True\n        while temp_num > 0:\n            digit = temp_num % 10\n            if digit == 0:\n                temp_num //= 10\n                continue  # The digit '0' is ignored for divisibility checks.\n            \n            if num % digit != 0:\n                all_digits_divide = False\n                break\n            temp_num //= 10\n        \n        if all_digits_divide:\n            results.append(num)\n            \n    return results"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_string: str) -> str:\n    \"\"\"Inserts spaces before capital letters in a string, excluding the first character.\n    This respects existing spaces and the first character rule.\n    \"\"\"\n    if not input_string:\n        return \"\"\n\n    result_chars = []\n    for i, char in enumerate(input_string):\n        if i > 0 and char.isupper() and input_string[i-1] != ' ':\n            result_chars.append(' ')\n        result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/748", "solution": "import re\ndef capital_words_spaces(input_string: str) -> str:\n    \"\"\"\n    Inserts spaces before capitalized words in a string, excluding the very first character.\n    It converts \"HelloWorld\" to \"Hello World\" and \"USAState\" to \"USA State\".\n    \"\"\"\n    return re.sub(r'(?<!^)(?=[A-Z])', ' ', input_string)"}
