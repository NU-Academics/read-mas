{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts substrings where the sum of digits equals their length.\n    Assumes valid input: a non-empty string of digits.\n    \"\"\"\n    count = 0\n    n = len(s)\n    for i in range(n):\n        current_sum = 0\n        for j in range(i, n):\n            current_sum += int(s[j])\n            if current_sum == (j - i + 1):\n                count += 1\n    return count"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts substrings where the sum of their digits equals their length.\n    It iterates through all substrings, incrementally calculating their digit sum.\n    \"\"\"\n    count = 0\n    n = len(s)\n\n    for i in range(n):\n        current_sum = 0\n        for j in range(i, n):\n            current_sum += int(s[j])\n            substring_length = (j - i) + 1\n            if current_sum == substring_length:\n                count += 1\n    return count"}
