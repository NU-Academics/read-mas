{"task_id": "Mbpp/94", "solution": "from typing import Any\ndef index_minimum(data: list[tuple]) -> Any:\n    \"\"\"\n    Finds the first value of the tuple with the smallest second value.\n    Assumes `data` is a non-empty list of tuples, each with at least two comparable elements.\n    \"\"\"\n    # Using min() with a key function efficiently finds the tuple\n    # with the smallest second element, adhering to tie-breaking rules.\n    smallest_tuple = min(data, key=lambda item: item[1])\n    return smallest_tuple[0]"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(data):\n    \"\"\"\n    Finds the first value of the tuple with the smallest second value in a list of tuples.\n    Returns None if the input list is empty.\n    \"\"\"\n    if not data:\n        return None\n\n    min_value = data[0][1]\n    result = data[0][0]\n\n    for item in data[1:]:\n        first_val, second_val = item\n        if second_val < min_value:\n            min_value = second_val\n            result = first_val\n\n    return result"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists: list[list]) -> int:\n    \"\"\"Calculates the length of the shortest list within a list of lists.\n    Returns 0 if the input list of lists is empty.\"\"\"\n    if not list_of_lists:\n        return 0\n    \n    min_len = float('inf')\n    for inner_list in list_of_lists:\n        min_len = min(min_len, len(inner_list))\n    \n    return int(min_len)"}
{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for an integer n.\n    Assumes n is a positive integer.\n    \"\"\"\n    count = 0\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count"}
