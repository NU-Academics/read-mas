{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    \"\"\"Calculates and returns the Nth polite number.\n    A polite number is a positive integer that can be expressed as the sum of two or more consecutive positive integers.\n    This definition implies that numbers that are powers of 2 (1, 2, 4, 8, 16, ...) are not polite numbers,\n    and all other positive integers are polite numbers.\n    \"\"\"\n\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    def _is_number_polite(num: int) -> bool:\n        \"\"\"Determines if a number is polite (not a power of 2).\"\"\"\n        # A number is polite if it's not a power of 2.\n        # This is a known mathematical property of polite numbers.\n        # Powers of 2 (1, 2, 4, 8, 16, ...) cannot be expressed as sum of consecutive integers.\n        # All other positive integers can.\n        return (num & (num - 1) != 0)\n\n    polite_numbers_found = 0\n    current_number = 1\n\n    while polite_numbers_found < n:\n        if _is_number_polite(current_number):\n            polite_numbers_found += 1\n        current_number += 1\n    \n    return current_number - 1"}
{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    \"\"\"\n    Calculates the Nth polite number, which is a positive integer not a power of 2.\n    Uses binary search to efficiently find the number for large N.\n    \"\"\"\n\n    # Helper function to check if a number is a power of two.\n    # A positive integer k is a power of two if k > 0 and (k & (k - 1)) == 0.\n    def _is_power_of_two(k: int) -> bool:\n        return (k > 0) and ((k & (k - 1)) == 0)\n\n    # Helper function to count powers of two up to k.\n    # The number of powers of two (1, 2, 4, ..., 2^x) less than or equal to k\n    # is equivalent to floor(log2(k)) + 1 for k >= 1.\n    # k.bit_length() returns the number of bits required to represent k in binary,\n    # which is effectively floor(log2(k)) + 1 for k > 0.\n    def _count_powers_of_two_up_to(k: int) -> int:\n        if k <= 0:\n            return 0\n        return k.bit_length()\n\n    # Helper function to count polite numbers up to k.\n    # Polite numbers are all positive integers minus powers of two.\n    def _count_polite_up_to(k: int) -> int:\n        if k <= 0:\n            return 0\n        return k - _count_powers_of_two_up_to(k)\n\n    # Input validation, as per the design, but simplified to a standard ValueError\n    # as custom exceptions are not part of the bare function requirement.\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n\n    # Binary search for the smallest number 'x' such that count_polite_up_to(x) >= n.\n    # The smallest polite number is 3 (for n=1), so 'low' can start at n.\n    # An upper bound for the binary search; the Nth polite number is roughly N + log2(N).\n    # Adding a buffer (e.g., 100) ensures the upper bound is sufficiently large for all N.\n    low = n\n    high = 2 * n + 100\n\n    result_candidate = -1\n    while low <= high:\n        mid = low + (high - low) // 2\n\n        # Ensure mid is positive for the helper functions.\n        # Given n > 0, mid will naturally be positive in this loop.\n        if mid <= 0:\n            low = 1\n            continue\n\n        polite_count = _count_polite_up_to(mid)\n\n        if polite_count >= n:\n            result_candidate = mid\n            high = mid - 1\n        else:\n            low = mid + 1\n    \n    # The `result_candidate` is the smallest integer 'x' such that there are at least 'n'\n    # polite numbers up to 'x'. This 'x' might itself be a power of two.\n    # If it is a power of two, it's not a polite number, so we need to find the next\n    # integer that is not a power of two.\n    while _is_power_of_two(result_candidate):\n        result_candidate += 1\n            \n    return result_candidate"}
{"task_id": "Mbpp/766", "solution": "from typing import List, Tuple, Any\ndef pair_wise(input_list: List[Any]) -> List[Tuple[Any, Any]]:\n    \"\"\"\n    Returns a list of all pairs of consecutive items in a given list.\n    Returns an empty list if the input has fewer than two elements.\n    \"\"\"\n    if len(input_list) < 2:\n        return []\n\n    return [(input_list[i], input_list[i+1]) for i in range(len(input_list) - 1)]"}
