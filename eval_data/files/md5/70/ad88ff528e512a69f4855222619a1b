{"task_id": "Mbpp/247", "solution": "from typing import Dict, Tuple\ndef lps(s: str) -> int:\n    \"\"\"Calculates the length of the longest palindromic subsequence.\"\"\"\n    n = len(s)\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    memo: Dict[Tuple[int, int], int] = {}\n\n    def _lps_recursive(i: int, j: int) -> int:\n        \"\"\"Helper to calculate LPS for s[i...j] using memoization.\"\"\"\n        if i > j:\n            return 0\n        if i == j:\n            return 1\n\n        if (i, j) in memo:\n            return memo[(i, j)]\n\n        if s[i] == s[j]:\n            result = 2 + _lps_recursive(i + 1, j - 1)\n        else:\n            result = max(\n                _lps_recursive(i + 1, j),\n                _lps_recursive(i, j - 1)\n            )\n        \n        memo[(i, j)] = result\n        return result\n    \n    return _lps_recursive(0, n - 1)"}
{"task_id": "Mbpp/264", "solution": "FIRST_TWO_YEARS_DOG_AGE_FACTOR: float = 10.5\nSUBSEQUENT_YEARS_DOG_AGE_FACTOR: float = 4.0\ndef dog_age(age: int) -> float:\n    \"\"\"Calculates a dog's age in \"dog years\" based on a human age input.\"\"\"\n    if age <= 2:\n        return float(age * FIRST_TWO_YEARS_DOG_AGE_FACTOR)\n    else:\n        return (2 * FIRST_TWO_YEARS_DOG_AGE_FACTOR) + \\\n               (float(age - 2) * SUBSEQUENT_YEARS_DOG_AGE_FACTOR)"}
