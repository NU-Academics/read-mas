{"task_id": "Mbpp/290", "solution": "def max_length(list_of_lists: list[list]) -> tuple[int, list]:\n    \"\"\"\n    Finds the list with the maximum length in a list of lists.\n    Returns (0, []) if the input list_of_lists is empty or contains only empty sublists.\n    \"\"\"\n    if not list_of_lists:\n        return 0, []\n\n    max_len = 0\n    longest_list_found = []\n\n    for sublist in list_of_lists:\n        current_length = len(sublist)\n        if current_length > max_len:\n            max_len = current_length\n            longest_list_found = sublist\n    \n    return max_len, longest_list_found"}
{"task_id": "Mbpp/290", "solution": "from typing import Any, List, Tuple\ndef max_length(list_of_lists: List[List[Any]]) -> Tuple[int, List[Any]]:\n    \"\"\"\n    Identifies the sublist with the maximum length from the input list of lists.\n    Returns a tuple of (max_length, longest_sublist), or (0, []) if the input is empty.\n    \"\"\"\n    if not list_of_lists:\n        return 0, []\n\n    max_length = 0\n    longest_list: List[Any] = []\n\n    for sublist in list_of_lists:\n        current_length = len(sublist)\n        if current_length > max_length:\n            max_length = current_length\n            longest_list = sublist\n    \n    return max_length, longest_list"}
