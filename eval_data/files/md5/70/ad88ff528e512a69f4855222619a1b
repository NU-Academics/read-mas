{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"Calculates the sum of per-digit differences between two non-negative integers.\n    The shorter number is conceptually padded with leading zeros for comparison.\n    \"\"\"\n    str_num1 = str(num1)\n    str_num2 = str(num2)\n\n    max_len = max(len(str_num1), len(str_num2))\n\n    padded_num1 = str_num1.zfill(max_len)\n    padded_num2 = str_num2.zfill(max_len)\n\n    total_diff = 0\n    for i in range(max_len):\n        digit1 = int(padded_num1[i])\n        digit2 = int(padded_num2[i])\n        total_diff += abs(digit1 - digit2)\n    return total_diff"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"Calculates the sum of per-digit absolute differences between two non-negative integers.\n    Shorter numbers are padded with leading zeros for comparison.\"\"\"\n    \n    digits1 = [int(d) for d in str(num1)]\n    digits2 = [int(d) for d in str(num2)]\n\n    len1 = len(digits1)\n    len2 = len(digits2)\n    max_len = max(len1, len2)\n\n    # Pad the shorter list with leading zeros\n    padded_digits1 = [0] * (max_len - len1) + digits1\n    padded_digits2 = [0] * (max_len - len2) + digits2\n\n    total_difference = 0\n    for d1, d2 in zip(padded_digits1, padded_digits2):\n        total_difference += abs(d1 - d2)\n\n    return total_difference"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr: list[int], n: int) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist in the given list using Kadane's algorithm.\n    It returns the maximum sum of any contiguous sub-array.\n    \"\"\"\n    if not arr or n == 0:\n        return 0\n\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, n):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr: list[int], n: int) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist in the given list.\n    Implements Kadane's algorithm efficiently.\n    \"\"\"\n    if not arr:\n        return 0\n\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, n):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
