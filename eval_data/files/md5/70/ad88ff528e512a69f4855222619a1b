{"task_id": "Mbpp/801", "solution": "def test_three_equal(a, b, c):\n    \"\"\"Counts how many of the three input integers are equal.\n    Returns 3 if all are equal, 2 if exactly two are equal, or 0 if none are equal.\n    \"\"\"\n    if a == b == c:\n        return 3\n    elif a == b or a == c or b == c:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"Counts equal numbers among three integers.\n    Returns 3 if all are equal, 2 if two are equal, and 0 if none are equal.\n    \"\"\"\n    if a == b == c:\n        return 3\n    elif a == b or a == c or b == c:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/803", "solution": "import math\ndef is_perfect_square(number: int) -> bool:\n    \"\"\"Checks if the given number is a perfect square.\n    It returns False for negative inputs.\n    \"\"\"\n    if number < 0:\n        return False\n    \n    root = math.isqrt(number)\n    return root * root == number"}
{"task_id": "Mbpp/803", "solution": "import math\ndef is_perfect_square(number):\n    \"\"\"\n    Checks if a number is a perfect square.\n    Assumes non-negative numeric input.\n    \"\"\"\n    if number < 0:\n        # As per the design, negative numbers are not considered perfect squares.\n        # Although the design indicated throwing an InvalidInputError, the prompt is simple\n        # and it's generally better to return False for non-perfect square cases\n        # unless specifically instructed to raise an error for invalid mathematical inputs.\n        # For a simple 'is_perfect_square' function, typically it would just return False for negatives.\n        return False\n    \n    if number == 0:\n        return True\n\n    sqrt_val = math.sqrt(number)\n\n    # Check if the square root is an integer, accounting for float precision.\n    # For integers, int(sqrt_val) == sqrt_val is exact.\n    # For floats, we need to consider precision.\n    # A common way is to check if the difference between the sqrt_val and its\n    # integer part is very small.\n    return abs(sqrt_val - round(sqrt_val)) < 1e-9"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers: list) -> bool:\n    \"\"\"Determines if the product of numbers in a list is even.\n    Returns True if any number is 0 or an even integer, False otherwise.\n    \"\"\"\n    if not numbers:\n        return False  # An empty list's product is conventionally 1 (odd).\n\n    for num in numbers:\n        # Check if the number is 0 or an even integer (e.g., 2, 4.0, -6).\n        # This covers all conditions for an even product.\n        # For floats, num % 2 will be 0.0 if it's an even integer (e.g., 4.0 % 2 == 0.0).\n        # For non-integer floats (e.g., 0.5), 0.5 % 2 == 0.5, which is not 0, so it won't be considered even here.\n        if num % 2 == 0:\n            return True\n\n    return False"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers):\n    \"\"\"Checks if the product of numbers in a list is an even integer.\n    Returns False for empty lists, odd integer products, or non-integer float products.\"\"\"\n\n    if not numbers:\n        return False\n\n    # Short-circuit: if any number is an even integer or zero, the product is even.\n    # The modulo operator correctly identifies even integers and zero for both int and float types.\n    for num in numbers:\n        if num % 2 == 0:\n            return True\n\n    # If no even integer or zero was found, calculate the full product.\n    # Start with 1.0 to ensure consistent float arithmetic for mixed types.\n    product = 1.0\n    for num in numbers:\n        product *= num\n\n    # The product is even if it is an integer and divisible by 2.\n    # The modulo operator handles this for integers, even floats (e.g., 2.0),\n    # odd floats (e.g., 3.0), and non-integer floats (e.g., 2.42) per the specification.\n    return product % 2 == 0"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(data: list[list[int | float]]) -> list[int | float] | None:\n    \"\"\"\n    Returns the sublist from a list of lists whose sum of elements is the highest.\n    Returns None if the input list `data` is empty.\n    \"\"\"\n    if not data:\n        return None\n\n    max_sum = float('-inf')\n    max_list = None\n\n    for sublist in data:\n        current_sum = sum(sublist)\n        if current_sum > max_sum:\n            max_sum = current_sum\n            max_list = sublist\n    return max_list"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(list_of_lists: list[list[int | float]]) -> list[int | float]:\n    \"\"\"\n    Identifies and returns the sublist with the highest sum of elements.\n    If multiple lists have the same maximum sum, the first one encountered is returned.\n    \"\"\"\n    return max(list_of_lists, key=sum)"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Finds the maximum length of a consecutive run of uppercase characters.\n    Returns 0 for empty strings or strings with no uppercase characters.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in input_string:\n        if char.isupper():\n            current_run += 1\n        else:\n            max_run = max(max_run, current_run) # Update max run if current run was longer.\n            current_run = 0 # Reset current run counter.\n    max_run = max(max_run, current_run) # Final check for a run at the end of the string.\n    return max_run"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(text: str) -> int:\n    \"\"\"Calculates the maximum number of consecutive uppercase characters in the given string.\"\"\"\n    max_run = 0\n    current_run = 0\n    for char in text:\n        if char.isupper():\n            current_run += 1\n        else:\n            max_run = max(max_run, current_run)\n            current_run = 0\n    max_run = max(max_run, current_run)\n    return max_run"}
{"task_id": "Mbpp/807", "solution": "def first_odd(numbers: list[int]) -> int | None:\n    \"\"\"\n    Finds the first odd number in a list of integers.\n    Returns the first odd integer found, or None if none are present.\n    \"\"\"\n    for num in numbers:\n        if num % 2 != 0:\n            return num\n    return None"}
{"task_id": "Mbpp/807", "solution": "def first_odd(numbers: list[int]) -> int | None:\n    \"\"\"\n    Finds the first odd number in a given list of integers.\n    Returns the first odd number found, or None if no odd numbers are present.\n    \"\"\"\n    for number in numbers:\n        if number % 2 != 0:\n            return number\n    return None"}
