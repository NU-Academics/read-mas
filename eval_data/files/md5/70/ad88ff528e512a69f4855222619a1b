{"task_id": "Mbpp/721", "solution": "from typing import List\ndef maxAverageOfPath(matrix: List[List[int]]) -> float:\n    \"\"\"Finds the path with the maximum average cost from top-left to bottom-right.\n    Movement is restricted to only right or down.\n    \"\"\"\n    N = len(matrix)\n    # Handle empty matrix or non-square matrix as per design's validator logic\n    if not matrix or not all(len(row) == N for row in matrix):\n        raise ValueError(\"Matrix cannot be empty or non-square.\")\n\n    max_average = [-float('inf')] # Stores the maximum average found.\n\n    def _find_paths_recursive(row: int, col: int, current_sum: int, current_length: int) -> None:\n        \"\"\"Recursively explores paths, updating max_average upon reaching the destination.\"\"\"\n        # Base case: Reached the bottom-right cell.\n        if row == N - 1 and col == N - 1:\n            current_average = current_sum / current_length\n            if current_average > max_average[0]:\n                max_average[0] = current_average\n            return\n\n        # Move right if within bounds.\n        if col + 1 < N:\n            _find_paths_recursive(row, col + 1, current_sum + matrix[row][col + 1], current_length + 1)\n\n        # Move down if within bounds.\n        if row + 1 < N:\n            _find_paths_recursive(row + 1, col, current_sum + matrix[row + 1][col], current_length + 1)\n\n    # Start the recursive search from (0,0) with the initial cell's cost and length 1.\n    _find_paths_recursive(0, 0, matrix[0][0], 1)\n\n    return max_average[0]"}
{"task_id": "Mbpp/721", "solution": "from typing import List\ndef maxAverageOfPath(matrix: List[List[int]]) -> float:\n    \"\"\"Finds the path with the maximum average cost in a square matrix.\n    It uses binary search on the answer combined with dynamic programming.\"\"\"\n    n = len(matrix)\n\n    if n == 0:\n        return 0.0\n    if n == 1:\n        return float(matrix[0][0])\n\n    def _check(current_matrix: List[List[int]], avg: float) -> bool:\n        \"\"\"Checks if a path with average cost >= avg exists using dynamic programming.\n        A path exists if the max sum path in the transformed matrix is non-negative.\"\"\"\n        size = len(current_matrix)\n        dp = [[0.0] * size for _ in range(size)]\n\n        dp[0][0] = current_matrix[0][0] - avg\n\n        for c in range(1, size):\n            dp[0][c] = dp[0][c-1] + (current_matrix[0][c] - avg)\n\n        for r in range(1, size):\n            dp[r][0] = dp[r-1][0] + (current_matrix[r][0] - avg)\n\n        for r in range(1, size):\n            for c in range(1, size):\n                dp[r][c] = max(dp[r-1][c], dp[r][c-1]) + (current_matrix[r][c] - avg)\n\n        return dp[size-1][size-1] >= 0\n\n    min_val = float('inf')\n    max_val = float('-inf')\n    for r in range(n):\n        for c in range(n):\n            min_val = min(min_val, matrix[r][c])\n            max_val = max(max_val, matrix[r][c])\n\n    low, high = float(min_val), float(max_val)\n\n    for _ in range(100):  # 100 iterations for binary search precision\n        mid = (low + high) / 2\n        if _check(matrix, mid):\n            low = mid\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/722", "solution": "def filter_data(student_data: dict[str, tuple[float, float]], min_height: float, min_weight: float) -> dict[str, tuple[float, float]]:\n    \"\"\"\n    Filters student data based on minimum height and weight criteria.\n    Returns a new dictionary containing only the students who meet both conditions.\n    \"\"\"\n    filtered_students = {}\n    for name, (height, weight) in student_data.items():\n        if height >= min_height and weight >= min_weight:\n            filtered_students[name] = (height, weight)\n    return filtered_students"}
