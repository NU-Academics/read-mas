{"task_id": "Mbpp/724", "solution": "def power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates base raised to power and then sums the digits of the result.\n    \"\"\"\n    def _sum_digits(number: int) -> int:\n        \"\"\"Sums the absolute digits of an integer.\"\"\"\n        return sum(int(digit) for digit in str(abs(number)))\n\n    result = base ** power\n    return _sum_digits(result)"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base: int, power: int) -> int:\n    \"\"\"Calculates the sum of all digits of the base to the specified power.\n    Assumes valid non-negative integer inputs for base and power.\n    \"\"\"\n    result = base ** power\n    sum_of_digits = sum(int(digit) for digit in str(result))\n    return sum_of_digits"}
{"task_id": "Mbpp/725", "solution": "import re\ndef extract_quotation(input_string: str) -> list[str]:\n    \"\"\"\n    Extracts all substrings enclosed by double quotation marks from the input string.\n    The function collects content between valid pairs of double quotes.\n\n    Args:\n        input_string: The string from which to extract quoted values.\n\n    Returns:\n        A list of strings found between double quotation marks.\n        Returns an empty list if no quoted strings are found.\n\n    Raises:\n        TypeError: If input_string is not of type str.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    # Regular expression to find all non-greedy matches between double quotes\n    # r'\\\"([^\\\"]*)\\\"' matches a double quote, then any character zero or more times\n    # (non-greedy), then another double quote. The parentheses create a capturing group\n    # for the content inside the quotes.\n    return re.findall(r'\\\"([^\\\"]*)\\\"', input_string)"}
{"task_id": "Mbpp/725", "solution": "import re\nfrom typing import List\ndef extract_quotation(text: str) -> List[str]:\n    \"\"\"\n    Extracts all substrings enclosed within double quotation marks from the input string.\n    Returns a list of the extracted contents.\n    \"\"\"\n    return re.findall(r'\\\"([^\\\"]*)\\\"', text)"}
{"task_id": "Mbpp/726", "solution": "from typing import Tuple, Union\ndef multiply_elements(input_tuple: Tuple[Union[int, float], ...]) -> Tuple[Union[int, float], ...]:\n    \"\"\"\n    Computes the product of adjacent elements in a tuple of numbers.\n    Returns an empty tuple if the input has fewer than two elements.\n    \"\"\"\n    if len(input_tuple) < 2:\n        return ()\n\n    result = []\n    for i in range(len(input_tuple) - 1):\n        result.append(input_tuple[i] * input_tuple[i+1])\n    return tuple(result)"}
{"task_id": "Mbpp/726", "solution": "from typing import Tuple, Union\ndef multiply_elements(input_tuple: Tuple[Union[int, float], ...]) -> Tuple[Union[int, float], ...]:\n    \"\"\"Calculates the product of adjacent elements in an input tuple of numbers.\n    Returns a new tuple where the i-th element is the product of input_tuple[i] and input_tuple[i+1].\"\"\"\n    result = []\n    for i in range(len(input_tuple) - 1):\n        result.append(input_tuple[i] * input_tuple[i+1])\n    return tuple(result)"}
