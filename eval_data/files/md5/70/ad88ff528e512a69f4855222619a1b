{"task_id": "Mbpp/137", "solution": "def zero_count(data: list[int]) -> float:\n    \"\"\"\n    Calculates the ratio of zeroes to non-zeroes in an array of integers.\n    Returns 0.0 if there are no non-zeroes or if the array is empty.\n    \"\"\"\n    zeroes = 0\n    non_zeroes = 0\n\n    for x in data:\n        if x == 0:\n            zeroes += 1\n        else:\n            non_zeroes += 1\n\n    if non_zeroes == 0:\n        return 0.0\n    \n    return float(zeroes) / non_zeroes"}
{"task_id": "Mbpp/137", "solution": "from typing import List\ndef zero_count(numbers: List[int]) -> float:\n    \"\"\"Calculates the ratio of zero elements to non-zero elements in a list.\n    Returns 0.0 if there are no non-zero elements.\"\"\"\n    count_of_zeroes = 0\n    count_of_non_zeroes = 0\n\n    for num in numbers:\n        if num == 0:\n            count_of_zeroes += 1\n        else:\n            count_of_non_zeroes += 1\n\n    if count_of_non_zeroes == 0:\n        return 0.0\n    else:\n        return float(count_of_zeroes) / count_of_non_zeroes"}
{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(number: int) -> bool:\n    \"\"\"Checks if the number can be represented as a sum of distinct non-zero powers of 2.\n    A sum implies at least two distinct terms, and non-zero powers are 2^k where k >= 1.\n    \"\"\"\n    if number <= 1:\n        return False # Handles non-positive numbers and 2^0 (1).\n\n    if number % 2 != 0:\n        return False # All non-zero powers of 2 are even, so their sum must be even.\n\n    # An even number > 1 is a sum of distinct non-zero powers of 2 if and only if\n    # it is not a single power of 2 (i.e., has more than one '1' bit in binary).\n    return (number & (number - 1)) != 0"}
{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(number: int) -> bool:\n    \"\"\"\n    Determines if a number is a positive even integer, matching the definition\n    of a sum of distinct non-zero powers of two.\n    \"\"\"\n    return number > 0 and number % 2 == 0"}
