{"task_id": "Mbpp/2", "solution": "def similar_elements(list1, list2):\n    \"\"\"\n    Finds and returns elements common to both input iterables.\n    Duplicates are preserved based on their occurrence in list1.\n    \"\"\"\n    shared = []\n    # Convert list2 to a set for O(1) average time complexity lookups.\n    set2 = set(list2)\n    for item in list1:\n        if item in set2:\n            shared.append(item)\n    return shared"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(list1: list, list2: list) -> list:\n    \"\"\"\n    Finds and returns a list of unique elements that are present in both input lists.\n    This function efficiently identifies common elements using set operations.\n    \"\"\"\n    set1 = set(list1)\n    set2 = set(list2)\n    \n    common_elements = set1.intersection(set2)\n    \n    return list(common_elements)"}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(number):\n    # Numbers less than or equal to 2 (including negative numbers, 0, 1, and 2 itself) are not non-prime.\n    if number <= 2:\n        return False\n    # Check for divisibility by numbers from 2 up to the square root of the input number.\n    for i in range(2, int(number**0.5) + 1):\n        if number % i == 0:\n            return True\n    return False"}
{"task_id": "Mbpp/3", "solution": "def _is_prime(number: int) -> bool:\n    \"\"\"\n    Helper function to check if a number is prime.\n    Assumes positive integer input.\n    \"\"\"\n    if number < 2:\n        return False\n    for i in range(2, int(number**0.5) + 1):\n        if number % i == 0:\n            return False\n    return True\ndef is_not_prime(number: int) -> bool:\n    \"\"\"\n    Determines if the given number is non-prime.\n    Returns False for numbers less than 2, as they are not non-prime.\n    \"\"\"\n    if number < 2:\n        return False\n    return not _is_prime(number)"}
{"task_id": "Mbpp/4", "solution": "import heapq\ndef heap_queue_largest(numbers: list[int | float], n: int) -> list[int | float]:\n    \"\"\"Finds the n largest numbers from a list using heapq, returning them sorted descending.\n    Handles edge cases for n and empty lists as specified.\"\"\"\n    if n <= 0:\n        return []\n    if not numbers:\n        return []\n\n    # Use heapq.nlargest to efficiently retrieve the n largest elements.\n    # This function typically returns them in descending order.\n    largest_elements = heapq.nlargest(n, numbers)\n\n    # Explicitly sort the collected list in descending order.\n    # This ensures strict adherence to the output sorting requirement.\n    largest_elements.sort(reverse=True)\n\n    return largest_elements"}
