{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(arr: list[int], num: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array.\n    Returns the index of the first occurrence, or -1 if the number is not found.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == num:\n            result = mid\n            high = mid - 1  # Continue searching in the left half for the first occurrence\n        elif arr[mid] < num:\n            low = mid + 1\n        else:  # arr[mid] > num\n            high = mid - 1\n    return result"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(arr: list[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array.\n    Returns the index or -1 if not found.\n    \"\"\"\n    low, high = 0, len(arr) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == target:\n            result = mid\n            high = mid - 1  # Continue searching in the left half for the first occurrence\n        elif arr[mid] < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(data_list):\n    \"\"\"Calculates the sum of products of all contiguous sublists.\n    Returns 0 for an empty list as per the design specification.\"\"\"\n\n    if not data_list:\n        return 0\n\n    total_sum = 0\n    n = len(data_list)\n\n    for i in range(n):\n        current_product = 1\n        for j in range(i, n):\n            current_product *= data_list[j]\n            total_sum += current_product\n    return total_sum"}
{"task_id": "Mbpp/734", "solution": "from typing import List, Union\ndef sum_Of_Subarray_Prod(numbers: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the sum of products of all contiguous sublists of a given list.\n    Returns 0 if the input list is empty as per business rule BR2.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    total_sum: Union[int, float] = 0\n    n = len(numbers)\n\n    # Iterates through all possible starting points 'i'\n    for i in range(n):\n        current_product: Union[int, float] = 1  # Multiplicative identity for current sublist product\n        # Iterates through all possible ending points 'j' for the current starting point 'i'\n        for j in range(i, n):\n            # Calculate product of the sublist numbers[i:j+1] incrementally\n            current_product *= numbers[j]\n            total_sum += current_product\n\n    return total_sum"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"\n    Toggles all bits of a non-negative integer, excluding its most significant bit (MSB)\n    and least significant bit (LSB). Numbers with 2 or fewer bits are returned unchanged.\n    \"\"\"\n    n_bits = number.bit_length()\n\n    if n_bits <= 2:\n        return number\n\n    # Calculate a mask where only the middle bits are set to 1.\n    # This mask is then XORed with the number to flip these specific bits.\n    all_ones_mask = (1 << n_bits) - 1\n    msb_mask = (1 << (n_bits - 1))\n    lsb_mask = 1\n    middle_bits_mask = all_ones_mask ^ msb_mask ^ lsb_mask\n\n    toggled_num = number ^ middle_bits_mask\n    return toggled_num"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"Toggles all bits of the number except the most significant bit and the least significant bit.\n    This function operates on non-negative integers as specified.\"\"\"\n\n    # Input validation as per design document (FR1, Error handling)\n    if not isinstance(number, int) or number < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    # Handle edge cases for numbers with 0, 1, or 2 bits (BR3 in design)\n    # The bit_length for 0 is 0. The .bit_length() method returns the number of bits required to represent an integer in binary, excluding the sign and leading zeros.\n    # For 0, bit_length() is 0, but for our logic, 0 has 1 effective bit for the LSB/MSB concept.\n    # The design states that for numbers <= 3 (which covers 0, 1, 2, 3), return the original number.\n    # This also aligns with the definition of \"no middle bits for 0, 1, or 2-bit numbers\".\n    #\n    # The original design's `_get_bit_length` handled 0 by returning 1.\n    # We will adjust `bit_length` calculation for 0 and 1 here to be consistent with the `bit_length <= 2` check.\n    if number == 0:\n        return 0 # 0 has no middle bits to toggle, returns itself\n    if number == 1: # Binary 1, has 1 bit, no middle bits\n        return 1\n    if number == 2: # Binary 10, has 2 bits, no middle bits\n        return 2\n    if number == 3: # Binary 11, has 2 bits, no middle bits\n        return 3\n\n    bit_length = number.bit_length()\n\n    # Create the middle bits mask. If length is 2 or less, there are no middle bits.\n    # This is already handled by the `if number <= 3` check above, which means\n    # if we reach this point, bit_length will be > 2.\n    \n    # Create a mask with all bits set up to bit_length.\n    all_bits_mask = (1 << bit_length) - 1\n\n    # Create masks for the MSB and LSB to exclude them.\n    msb_mask = 1 << (bit_length - 1)\n    lsb_mask = 1\n\n    # The middle bits mask is all_bits_mask with MSB and LSB unset.\n    middle_mask = all_bits_mask ^ msb_mask ^ lsb_mask\n\n    return number ^ middle_mask"}
{"task_id": "Mbpp/736", "solution": "from typing import Any\ndef left_insertion(sorted_list: list, value: Any) -> int:\n    \"\"\"\n    Finds the leftmost insertion point for a value in a sorted list.\n    Ensures all existing elements equal to the value appear to its right.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sorted_list, value):\n    \"\"\"\n    Locates the leftmost index where 'value' should be inserted into 'sorted_list' to maintain sort order.\n    Returns an index 'i' such that elements before 'i' are less than 'value', and elements at or after 'i' are greater than or equal to 'value'.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
