{"task_id": "Mbpp/244", "solution": "import math\ndef next_Perfect_Square(number: int) -> int:\n    \"\"\"Calculates the smallest perfect square strictly greater than the given number.\n    For negative inputs, the smallest non-negative perfect square (0) is returned.\n    Raises ValueError if the input is not an integer.\n    \"\"\"\n    if not isinstance(number, int):\n        raise ValueError(\"Input must be an integer.\")\n\n    if number < 0:\n        return 0\n\n    root = math.isqrt(number)\n    next_root = root + 1\n    return next_root * next_root"}
{"task_id": "Mbpp/244", "solution": "import math\ndef next_Perfect_Square(number):\n    \"\"\"\n    Calculates the smallest perfect square strictly greater than the input number.\n    Handles negative inputs by returning 0.\n    \"\"\"\n    if number < 0:\n        return 0\n\n    # Find the integer part of the square root.\n    # For example, math.isqrt(35) is 5, math.isqrt(36) is 6.\n    sqrt_val = math.isqrt(number)\n\n    # The root of the next perfect square is always one greater than sqrt_val.\n    # For example, if number=35 (sqrt_val=5), the next root is 6 (6*6=36).\n    # If number=36 (sqrt_val=6), the next root is 7 (7*7=49).\n    next_root = sqrt_val + 1\n\n    return next_root * next_root"}
{"task_id": "Mbpp/245", "solution": "def max_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum sum of a bitonic subsequence in the input array.\n    A bitonic sequence strictly increases then strictly decreases.\n    \"\"\"\n    n = len(arr)\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return arr[0]\n\n    # Helper function to calculate sum of LIS ending at each position.\n    # This function is defined locally to comply with critical requirements.\n    def _calculate_lis_sums_internal(current_arr: list[int]) -> list[int]:\n        lis_sums = list(current_arr)\n        for i in range(1, len(current_arr)):\n            for j in range(i):\n                if current_arr[i] > current_arr[j]:\n                    lis_sums[i] = max(lis_sums[i], lis_sums[j] + current_arr[i])\n        return lis_sums\n\n    # Calculate LIS sums ending at each position (forward pass).\n    lis_sums_forward = _calculate_lis_sums_internal(arr)\n\n    # Calculate LDS sums starting at each position (backward pass).\n    # This is achieved by finding LIS on the reversed array, then reversing the result.\n    reversed_arr = arr[::-1]\n    lis_sums_backward_reversed = _calculate_lis_sums_internal(reversed_arr)\n    lis_sums_backward = lis_sums_backward_reversed[::-1]\n\n    # Combine LIS_forward and LDS_backward sums to find the maximum bitonic sum.\n    # For each element arr[i], it can be the peak, so its value is counted in both LIS and LDS.\n    max_bitonic_sum = float('-inf')\n\n    for i in range(n):\n        current_bitonic_sum = lis_sums_forward[i] + lis_sums_backward[i] - arr[i]\n        max_bitonic_sum = max(max_bitonic_sum, current_bitonic_sum)\n\n    return max_bitonic_sum"}
{"task_id": "Mbpp/245", "solution": "def max_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum sum of a bitonic subsequence in the input array.\n    A bitonic sequence is first increasing and then decreasing.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n    if n == 1:\n        return arr[0]\n\n    # lis_sum[i] stores the maximum sum of an increasing subsequence ending at arr[i].\n    lis_sum = [0] * n\n    for i in range(n):\n        lis_sum[i] = arr[i]\n        for j in range(i):\n            if arr[i] > arr[j]:\n                lis_sum[i] = max(lis_sum[i], lis_sum[j] + arr[i])\n\n    # lds_sum[i] stores the maximum sum of a decreasing subsequence starting at arr[i].\n    lds_sum = [0] * n\n    for i in range(n - 1, -1, -1):\n        lds_sum[i] = arr[i]\n        for j in range(n - 1, i, -1):\n            if arr[i] > arr[j]:\n                lds_sum[i] = max(lds_sum[i], lds_sum[j] + arr[i])\n\n    # Initialize max_bitonic_sum with the first possible bitonic sum\n    # since n >= 2 at this point and we need to handle potentially negative maximums.\n    # arr[i] is counted twice (once in LIS ending at arr[i] and once in LDS starting at arr[i]).\n    # Subtract it once to get the correct sum of the bitonic subsequence with arr[i] as peak.\n    max_bitonic_sum = lis_sum[0] + lds_sum[0] - arr[0]\n\n    for i in range(n):\n        current_bitonic_sum = lis_sum[i] + lds_sum[i] - arr[i]\n        max_bitonic_sum = max(max_bitonic_sum, current_bitonic_sum)\n\n    return max_bitonic_sum"}
{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    n = len(s)\n    if n == 0:\n        return 0\n\n    # dp[i][j] stores the length of the longest palindromic subsequence\n    # of substring s[i..j]\n    dp = [[0] * n for _ in range(n)]\n\n    # Every single character is a palindrome of length 1\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Build the table.\n    # l is length of subsequence\n    for l in range(2, n + 1):\n        for i in range(n - l + 1):\n            j = i + l - 1\n            if s[i] == s[j]:\n                dp[i][j] = 2 + (dp[i + 1][j - 1] if l > 2 else 0)\n            else:\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n    return dp[0][n - 1]"}
