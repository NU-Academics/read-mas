{"task_id": "Mbpp/615", "solution": "def average_tuple(data: tuple[tuple[int | float, ...], ...]) -> list[float]:\n    \"\"\"\n    Calculates the average value for each inner tuple in a tuple of tuples.\n    Assumes input types are correct and inner tuples contain only numbers.\n    \"\"\"\n    averages = []\n    for inner_tuple in data:\n        if not inner_tuple:\n            averages.append(0.0)\n        else:\n            averages.append(sum(inner_tuple) / len(inner_tuple))\n    return averages"}
{"task_id": "Mbpp/615", "solution": "from typing import Tuple, List, Union\ndef average_tuple(data: Tuple[Tuple[Union[int, float], ...], ...]) -> List[float]:\n    \"\"\"\n    Calculates the average value for each inner tuple in a tuple of tuples.\n    Returns 0.0 for any empty inner tuples as per business rules.\n    \"\"\"\n    averages = []\n    for inner_tuple in data:\n        if not inner_tuple:\n            averages.append(0.0)\n        else:\n            average = sum(inner_tuple) / len(inner_tuple)\n            averages.append(average)\n    return averages"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Performs element-wise modulo on two tuples of the same length.\n    It is assumed that inputs are valid numeric tuples with no zero divisors.\n    \"\"\"\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n    \n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same length.\")\n    \n    result = []\n    for i in range(len(tuple1)):\n        val1 = tuple1[i]\n        val2 = tuple2[i]\n\n        if not isinstance(val1, (int, float)) or not isinstance(val2, (int, float)):\n            raise TypeError(f\"Elements at index {i} must be numeric. Got {type(val1).__name__} and {type(val2).__name__}.\")\n\n        if val2 == 0:\n            raise ZeroDivisionError(f\"Cannot perform modulo by zero at index {i}.\")\n        \n        result.append(val1 % val2)\n            \n    return tuple(result)"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Performs element-wise modulo on two tuples.\n    Assumes tuples are of the same length and contain numeric elements.\n    \"\"\"\n    return tuple(t1 % t2 for t1, t2 in zip(tuple1, tuple2))"}
{"task_id": "Mbpp/618", "solution": "def div_list(list1: list[float | int], list2: list[float | int]) -> list[float]:\n    \"\"\"Divides elements of two lists element-wise.\n    This function relies on Python's built-in error handling for non-numeric types, length mismatches, or division by zero.\n    \"\"\"\n    result = []\n    # The loop iterates based on the length of list1.\n    # If list2 is shorter, an IndexError will be raised during element access.\n    for i in range(len(list1)):\n        # Python's standard division operator (/) naturally produces float results.\n        # If list2[i] is zero, a ZeroDivisionError will be raised by Python.\n        result.append(list1[i] / list2[i])\n    return result"}
{"task_id": "Mbpp/619", "solution": "def move_num(s: str) -> str:\n    # Reorders the input string by moving all numeric characters to the end.\n    # Preserves the relative order of both non-numeric and numeric characters.\n    non_numeric_chars = []\n    numeric_chars = []\n\n    for char in s:\n        if char.isdigit():\n            numeric_chars.append(char)\n        else:\n            non_numeric_chars.append(char)\n\n    return \"\".join(non_numeric_chars) + \"\".join(numeric_chars)"}
{"task_id": "Mbpp/618", "solution": "from typing import List, Union\nclass ListLengthMismatchError(Exception):\n    \"\"\"Exception raised when two lists have different lengths for an element-wise operation.\"\"\"\n    def __init__(self, message: str = \"Input lists must have the same length.\"):\n        self.message = message\n        super().__init__(self.message)\nclass DivisionByZeroError(Exception):\n    \"\"\"Exception raised when an attempt is made to divide by zero in an element-wise operation.\"\"\"\n    def __init__(self, message: str = \"Division by zero encountered.\"):\n        self.message = message\n        super().__init__(self.message)\ndef div_list(list1: List[Union[float, int]], list2: List[Union[float, int]]) -> List[float]:\n    \"\"\"\n    Divides elements of list1 by corresponding elements of list2 element-wise.\n\n    Args:\n        list1: The numerator list, containing numbers (integers or floats).\n        list2: The denominator list, containing numbers (integers or floats).\n\n    Returns:\n        A new list containing the floating-point results of the divisions.\n\n    Raises:\n        ListLengthMismatchError: If list1 and list2 have different lengths.\n        DivisionByZeroError: If any element in list2 is zero.\n        TypeError: If list elements are not numeric.\n    \"\"\"\n    if len(list1) != len(list2):\n        raise ListLengthMismatchError(\"Input lists must have the same length for division.\")\n\n    results: List[float] = []\n    for i in range(len(list1)):\n        numerator = list1[i]\n        denominator = list2[i]\n\n        if not isinstance(numerator, (int, float)) or not isinstance(denominator, (int, float)):\n            raise TypeError(\"All list elements must be numbers (int or float).\")\n\n        if denominator == 0:\n            raise DivisionByZeroError(f\"Division by zero at index {i}.\")\n            \n        results.append(float(numerator) / float(denominator))\n    \n    return results"}
{"task_id": "Mbpp/619", "solution": "def move_num(input_string: str) -> str:\n    \"\"\"Moves all numeric characters to the end of the string, preserving relative order.\n    It returns a new string with non-numeric characters followed by numeric ones.\"\"\"\n    non_numeric_chars = []\n    numeric_chars = []\n\n    for char in input_string:\n        if char.isdigit():\n            numeric_chars.append(char)\n        else:\n            non_numeric_chars.append(char)\n\n    return \"\".join(non_numeric_chars) + \"\".join(numeric_chars)"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers):\n    \"\"\"\n    Finds the size of the largest subset of a list of numbers so that every pair is divisible.\n\n    Args:\n        numbers: A list of positive integers.\n\n    Returns:\n        An integer representing the size of the largest divisible subset.\n\n    Raises:\n        ValueError: If the input is not a list, contains non-integer elements,\n                    or contains non-positive integers.\n    \"\"\"\n    # Input validation (FR1, FR5)\n    if not isinstance(numbers, list):\n        raise ValueError(\"Input must be a list.\")\n    if not all(isinstance(num, int) for num in numbers):\n        raise ValueError(\"All elements in the list must be integers.\")\n    if not all(num > 0 for num in numbers):\n        raise ValueError(\"All numbers in the list must be positive integers.\")\n\n    # Handle empty list (FR3)\n    if not numbers:\n        return 0\n\n    # Handle single element list (FR4)\n    if len(numbers) == 1:\n        return 1\n\n    # Core calculation logic\n    # Sort the numbers and remove duplicates to simplify divisibility checks\n    nums = sorted(list(set(numbers)))\n    n = len(nums)\n\n    # dp[i] will store the size of the largest divisible subset ending with nums[i]\n    dp = [1] * n\n\n    for i in range(n):\n        for j in range(i):\n            if nums[i] % nums[j] == 0:\n                dp[i] = max(dp[i], dp[j] + 1)\n\n    return max(dp)"}
{"task_id": "Mbpp/620", "solution": "from typing import List\ndef largest_subset(nums: List[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset where every pair is divisible.\n    This uses a dynamic programming approach after sorting unique numbers.\n    \"\"\"\n    n = len(nums)\n    if n == 0:\n        return 0\n\n    # Remove duplicates and sort the numbers to simplify divisibility checks.\n    # Duplicates in the input list are effectively filtered, considering unique elements for the subset.\n    unique_nums = sorted(list(set(nums)))\n    n_unique = len(unique_nums)\n\n    if n_unique == 0: # This can happen if the input was like [0, 0, 0] and 0 is filtered. But 0 is usually not an element in such problems.\n        return 0      # Given FR5, we assume positive integers.\n    \n    # dp[i] stores the size of the largest divisible subset ending with unique_nums[i].\n    dp = [1] * n_unique\n\n    max_size = 1\n\n    for i in range(n_unique):\n        for j in range(i):\n            # If unique_nums[i] is divisible by unique_nums[j], it can extend the subset ending at unique_nums[j].\n            # Based on FR5, we assume positive integers, so unique_nums[j] will not be 0.\n            if unique_nums[i] % unique_nums[j] == 0:\n                dp[i] = max(dp[i], dp[j] + 1)\n        max_size = max(max_size, dp[i])\n\n    return max_size"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1, list2, n):\n    \"\"\"\n    Finds the median of two sorted lists of the same size n.\n    This uses a two-pointer approach to achieve O(n) time complexity.\n    \"\"\"\n    i = 0  # Current index for list1\n    j = 0  # Current index for list2\n    m1 = -1.0 # To store the (n-1)-th element\n    m2 = -1.0 # To store the n-th element\n\n    for count in range(n + 1):\n        if i == n: # list1 is exhausted\n            m1 = m2\n            m2 = float(list2[j])\n            j += 1\n        elif j == n: # list2 is exhausted\n            m1 = m2\n            m2 = float(list1[i])\n            i += 1\n        elif list1[i] <= list2[j]:\n            m1 = m2\n            m2 = float(list1[i])\n            i += 1\n        else:\n            m1 = m2\n            m2 = float(list2[j])\n            j += 1\n    \n    return (m1 + m2) / 2.0"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1: list[int], list2: list[int], size: int) -> float:\n    \"\"\"\n    Calculates the median of two sorted lists of the same given positive size.\n    The median is the average of the two middle elements in the combined sorted list.\n    \"\"\"\n    i = 0  # Current index for list1\n    j = 0  # Current index for list2\n    m1 = -1  # Stores the element at index size-1 in the merged list.\n    m2 = -1  # Stores the element at index size in the merged list.\n\n    # This loop finds the (size-1)-th and size-th elements (0-indexed) of the combined sorted list.\n    # The iteration runs `size + 1` times to correctly capture both middle elements.\n    for count in range(size + 1):\n        m1 = m2  # Shift current m2 to m1 for next iteration.\n\n        if i == size:  # list1 is exhausted, take from list2\n            m2 = list2[j]\n            j += 1\n        elif j == size:  # list2 is exhausted, take from list1\n            m2 = list1[i]\n            i += 1\n        elif list1[i] <= list2[j]:  # Compare and take the smaller element\n            m2 = list1[i]\n            i += 1\n        else:\n            m2 = list2[j]\n            j += 1\n    \n    return (m1 + m2) / 2.0"}
