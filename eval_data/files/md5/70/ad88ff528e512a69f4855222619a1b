{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"Determines if two integers differ by exactly one bit position.\"\"\"\n    xor_result = num1 ^ num2\n    # A number is a power of 2 if it's greater than 0 and (number & (number - 1)) == 0.\n    # This checks if only one bit is set in xor_result.\n    return xor_result > 0 and (xor_result & (xor_result - 1)) == 0"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"Checks if two integers differ at exactly one bit position.\n    Returns True if they differ at exactly one bit, False otherwise.\"\"\"\n    xor_result = num1 ^ num2\n    # Count set bits using Brian Kernighan's algorithm.\n    count = 0\n    while xor_result > 0:\n        xor_result &= (xor_result - 1)\n        count += 1\n    return count == 1"}
{"task_id": "Mbpp/7", "solution": "import re\nimport string\ndef _strip_punctuation(word: str) -> str:\n    \"\"\"Removes leading and trailing punctuation from a word.\"\"\"\n    return word.strip(string.punctuation)\ndef find_char_long(text: str) -> set[str]:\n    \"\"\"\n    Finds words in a string that are at least 4 characters long after stripping punctuation.\n    Preserves original casing and handles internal hyphens/apostrophes.\n    \"\"\"\n    long_words = set()\n    words = re.findall(r\"\\b[\\w'-]+\\b\", text)\n\n    for word in words:\n        stripped_word = _strip_punctuation(word)\n        if len(stripped_word) >= 4:\n            long_words.add(word)\n            \n    return long_words"}
