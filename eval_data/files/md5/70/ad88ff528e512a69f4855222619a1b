{"task_id": "Mbpp/755", "solution": "def second_smallest(numbers: list[int]) -> int:\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n    if len(numbers) < 2:\n        raise ValueError(\"List must contain at least two elements.\")\n\n    # Validate all elements are integers\n    for num in numbers:\n        if not isinstance(num, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n\n    # Remove duplicates and sort to find the second smallest distinct number\n    unique_numbers = sorted(list(set(numbers)))\n\n    if len(unique_numbers) < 2:\n        raise ValueError(\"List must contain at least two distinct elements to find the second smallest.\")\n\n    return unique_numbers[1]"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"\n    Counts reverse string pairs in a list, where one string is the reverse of another.\n    Palindromes form a pair with themselves if they appear at least twice.\n    \"\"\"\n    total_pairs = 0\n    unmatched_strings = set()\n\n    for s in string_list:\n        reverse_s = s[::-1]\n        if reverse_s in unmatched_strings:\n            total_pairs += 1\n            unmatched_strings.remove(reverse_s)\n        else:\n            unmatched_strings.add(s)\n    return total_pairs"}
{"task_id": "Mbpp/757", "solution": "from typing import List\ndef count_reverse_pairs(string_list: List[str]) -> int:\n    \"\"\"\n    Counts unique pairs of reverse strings in the given list.\n    Each string instance can form a pair with a distinct reverse string instance.\n    \"\"\"\n    pairs_count = 0\n    processed_indices = set()\n\n    for i in range(len(string_list)):\n        if i in processed_indices:\n            continue\n\n        current_string = string_list[i]\n        reversed_string = current_string[::-1]\n\n        for j in range(i + 1, len(string_list)):\n            if j in processed_indices:\n                continue\n\n            if string_list[j] == reversed_string:\n                pairs_count += 1\n                processed_indices.add(i)\n                processed_indices.add(j)\n                break\n    return pairs_count"}
{"task_id": "Mbpp/758", "solution": "from collections import Counter\ndef unique_sublists(input_list: list[list]) -> dict[tuple, int]:\n    \"\"\"\n    Counts the occurrences of each unique sublist within a given list of lists.\n\n    Each sublist is converted to a tuple to ensure hashability and uniqueness\n    for counting.\n\n    Args:\n        input_list: A list of lists, where each inner list represents a sublist.\n\n    Returns:\n        A dictionary where keys are the unique sublists (as tuples) and\n        values are their respective counts.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    tuple_list = []\n    for sublist in input_list:\n        if not isinstance(sublist, list):\n            raise TypeError(f\"All elements in the input list must be lists, but found: {type(sublist)}\")\n        try:\n            tuple_list.append(tuple(sublist))\n        except TypeError as e:\n            raise TypeError(f\"Sublist contains unhashable elements: {sublist}. Original error: {e}\") from e\n\n    return dict(Counter(tuple_list))"}
{"task_id": "Mbpp/758", "solution": "from typing import Any, List, Dict, Tuple\ndef unique_sublists(input_list: List[List[Any]]) -> Dict[Tuple[Any, ...], int]:\n    \"\"\"\n    Counts the occurrences of each unique sublist within a list of lists.\n    Each sublist is converted to a tuple to be used as a dictionary key.\n    \"\"\"\n    counts: Dict[Tuple[Any, ...], int] = {}\n    for sublist in input_list:\n        sublist_tuple: Tuple[Any, ...] = tuple(sublist)\n        counts[sublist_tuple] = counts.get(sublist_tuple, 0) + 1\n    return counts"}
{"task_id": "Mbpp/759", "solution": "import re\nDECIMAL_REGEX_PATTERN: str = r\"^[+-]?\\d+\\.\\d{2}$\"\nDECIMAL_REGEX = re.compile(DECIMAL_REGEX_PATTERN)\ndef is_decimal(value: str) -> bool:\n    \"\"\"\n    Checks if a string is a decimal number with exactly two decimal places.\n    Uses a pre-compiled regular expression for efficient matching.\n    \"\"\"\n    return bool(DECIMAL_REGEX.match(value))"}
