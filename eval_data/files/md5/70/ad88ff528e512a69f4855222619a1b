{"task_id": "Mbpp/124", "solution": "import math\ndef angle_complex(real_part, imag_arg):\n    \"\"\"\n    Computes the angle (argument) of a complex number in radians.\n    It handles complex, float, or integer imaginary arguments.\n    \"\"\"\n    # Determine the imaginary value: if imag_arg is complex, use its .imag attribute;\n    # otherwise, use imag_arg directly (for float or int).\n    imaginary_value = getattr(imag_arg, 'imag', imag_arg)\n    \n    # Calculate the angle using math.atan2, ensuring both arguments are floats.\n    return math.atan2(float(imaginary_value), float(real_part))"}
{"task_id": "Mbpp/125", "solution": "def find_length(binary_string: str) -> int:\n    \"\"\"Calculates the maximum difference between 0s and 1s in any substring.\n    0s are treated as +1, 1s as -1, and Kadane's algorithm finds the max subarray sum.\n    \"\"\"\n    if not binary_string:\n        return 0\n\n    # Convert binary string to an array where '0' is 1 and '1' is -1\n    arr = [1 if char == '0' else -1 for char in binary_string]\n\n    max_val = 0\n    current_sum = 0\n    for val in arr:\n        current_sum += val\n        if current_sum < 0:\n            current_sum = 0\n        max_val = max(max_val, current_sum)\n    \n    return max_val"}
{"task_id": "Mbpp/126", "solution": "def sum(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of common positive divisors of two given integers.\n\n    Args:\n        num1: The first integer.\n        num2: The second integer.\n\n    Returns:\n        The sum of common positive divisors. Returns 0 if either input is non-positive.\n    \"\"\"\n    if num1 <= 0 or num2 <= 0:\n        return 0\n\n    divisors1 = set()\n    for i in range(1, int(num1**0.5) + 1):\n        if num1 % i == 0:\n            divisors1.add(i)\n            divisors1.add(num1 // i)\n\n    divisors2 = set()\n    for i in range(1, int(num2**0.5) + 1):\n        if num2 % i == 0:\n            divisors2.add(i)\n            divisors2.add(num2 // i)\n\n    common_divisors = divisors1.intersection(divisors2)\n    return sum(common_divisors)"}
{"task_id": "Mbpp/125", "solution": "def is_binary_string(s: str) -> bool:\n    \"\"\"\n    Checks if the given string contains only '0' and '1' characters.\n    \"\"\"\n    return all(char in ('0', '1') for char in s)\ndef find_length(binary_string: str) -> int:\n    \"\"\"\n    Calculates the maximum difference between the number of 0s and 1s\n    in any sub-string of the given binary string.\n    Treats '0' as +1 and '1' as -1, then applies Kadane's algorithm.\n    \"\"\"\n    if not is_binary_string(binary_string):\n        raise ValueError(\"Input string must contain only '0' and '1'.\")\n\n    if not binary_string:\n        return 0\n\n    # Transform the binary string into an array of integers: '0' becomes +1, '1' becomes -1.\n    transformed_arr = [1 if char == '0' else -1 for char in binary_string]\n    \n    # Initialize max_so_far and current_max for Kadane's algorithm.\n    # The first element is the initial maximum sum ending at the first position.\n    max_so_far = transformed_arr[0]\n    current_max = transformed_arr[0]\n\n    # Iterate through the array starting from the second element.\n    for i in range(1, len(transformed_arr)):\n        # For each element, decide whether to extend the current subarray\n        # or start a new subarray from the current element.\n        current_max = max(transformed_arr[i], current_max + transformed_arr[i])\n        \n        # Update the overall maximum subarray sum found so far.\n        max_so_far = max(max_so_far, current_max)\n            \n    return max_so_far"}
{"task_id": "Mbpp/126", "solution": "def sum(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the sum of common divisors of two given positive integers.\n\n    Args:\n        a: The first positive integer.\n        b: The second positive integer.\n\n    Returns:\n        The sum of the common positive divisors of a and b.\n\n    Raises:\n        ValueError: If a or b is not a positive integer.\n    \"\"\"\n    if not isinstance(a, int) or a <= 0:\n        raise ValueError(\"Both numbers must be positive integers.\")\n    if not isinstance(b, int) or b <= 0:\n        raise ValueError(\"Both numbers must be positive integers.\")\n\n    def get_divisors(n: int) -> set[int]:\n        divs = set()\n        for i in range(1, int(n**0.5) + 1):\n            if n % i == 0:\n                divs.add(i)\n                divs.add(n // i)\n        return divs\n\n    divisors_a = get_divisors(a)\n    divisors_b = get_divisors(b)\n\n    common_divs = divisors_a.intersection(divisors_b)\n    return builtins.sum(common_divs)"}
