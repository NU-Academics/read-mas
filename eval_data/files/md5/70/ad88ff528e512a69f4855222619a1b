{"task_id": "Mbpp/414", "solution": "from collections.abc import Sequence\ndef overlapping(seq1: Sequence, seq2: Sequence) -> bool:\n    \"\"\"\n    Checks if any element from seq1 is present in seq2.\n    Optimizes performance by converting the smaller sequence to a set for efficient lookups.\n    \"\"\"\n    if len(seq1) <= len(seq2):\n        smaller_seq = seq1\n        larger_seq = seq2\n    else:\n        smaller_seq = seq2\n        larger_seq = seq1\n\n    lookup_set = set(smaller_seq)\n\n    for item in larger_seq:\n        if item in lookup_set:\n            return True\n    return False"}
{"task_id": "Mbpp/413", "solution": "def extract_nth_element(data_list: list[tuple], n: int) -> list:\n    \"\"\"\n    Extracts the nth element from each tuple in a list of tuples.\n\n    Args:\n        data_list: A list of tuples.\n        n: The 0-indexed position of the element to extract from each tuple.\n\n    Returns:\n        A list containing the nth element from each tuple.\n\n    Raises:\n        TypeError: If data_list is not a list or n is not an integer.\n        IndexError: If any tuple in data_list does not have an element at index n.\n    \"\"\"\n    if not isinstance(data_list, list):\n        raise TypeError(\"data_list must be a list.\")\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer.\")\n    if n < 0:\n        raise IndexError(\"n must be a non-negative integer.\")\n\n    result = []\n    for item in data_list:\n        if not isinstance(item, tuple):\n            raise TypeError(f\"All elements in data_list must be tuples, but found {type(item)}\")\n        if len(item) <= n:\n            raise IndexError(f\"Tuple {item} does not have an element at index {n}.\")\n        result.append(item[n])\n    return result"}
{"task_id": "Mbpp/414", "solution": "from typing import Iterable, Set\ndef overlapping(sequence1: Iterable, sequence2: Iterable) -> bool:\n    \"\"\"Checks if any element in sequence1 exists in sequence2.\n    Returns True if an overlap is found, False otherwise.\"\"\"\n    if not sequence1 or not sequence2:\n        return False\n\n    set2: Set = set(sequence2)\n\n    for item in sequence1:\n        if item in set2:\n            return True\n    return False"}
{"task_id": "Mbpp/415", "solution": "def max_Product(numbers: list[int]) -> tuple[int, int]:\n    \"\"\"\n    Finds the pair of integers in the input list that yields the highest product.\n    Assumes the input list contains at least two integers.\n    \"\"\"\n    sorted_numbers = sorted(numbers)\n\n    # Candidate pairs are the two largest or the two smallest (most negative) numbers.\n    largest1, largest2 = sorted_numbers[-1], sorted_numbers[-2]\n    smallest1, smallest2 = sorted_numbers[0], sorted_numbers[1]\n\n    if largest1 * largest2 >= smallest1 * smallest2:\n        return (largest2, largest1)\n    else:\n        return (smallest1, smallest2)"}
{"task_id": "Mbpp/418", "solution": "def Find_Max(data_list):\n    \"\"\"\n    Finds and returns the element with the maximum length from the given list.\n\n    If the list is empty or contains no elements for which len() is defined,\n    returns None.\n    If multiple elements have the same maximum length, the first one encountered is returned.\n    Elements that do not support len() are skipped.\n    \"\"\"\n    if not data_list:\n        return None\n\n    longest_element = None\n    max_length = -1\n\n    for element in data_list:\n        try:\n            current_length = len(element)\n            if current_length > max_length:\n                max_length = current_length\n                longest_element = element\n        except TypeError:\n            # Element does not support len(), skip it\n            continue\n    \n    return longest_element"}
{"task_id": "Mbpp/415", "solution": "def max_Product(numbers: list[int]) -> tuple[int, int]:\n    \"\"\"\n    Finds the pair of integers with the highest product from a given list.\n    Assumes the input list contains at least two integers.\n    \"\"\"\n    # Initialize the two largest and two smallest numbers\n    # Assumes numbers contains at least two elements as per constraints.\n    if numbers[0] > numbers[1]:\n        max1, max2 = numbers[0], numbers[1]\n        min1, min2 = numbers[1], numbers[0]\n    else:\n        max1, max2 = numbers[1], numbers[0]\n        min1, min2 = numbers[0], numbers[1]\n\n    # Iterate through the rest of the list to find the actual two largest and two smallest\n    for i in range(2, len(numbers)):\n        num = numbers[i]\n        \n        # Update two largest\n        if num > max1:\n            max2 = max1\n            max1 = num\n        elif num > max2:\n            max2 = num\n        \n        # Update two smallest\n        if num < min1:\n            min2 = min1\n            min1 = num\n        elif num < min2:\n            min2 = num\n            \n    product_of_two_largest = max1 * max2\n    product_of_two_smallest = min1 * min2\n\n    if product_of_two_largest >= product_of_two_smallest:\n        # Return the pair sorted numerically\n        return (max2, max1) if max2 <= max1 else (max1, max2)\n    else:\n        # Return the pair sorted numerically\n        return (min1, min2) if min1 <= min2 else (min2, min1)"}
{"task_id": "Mbpp/418", "solution": "from typing import List, Any\ndef Find_Max(list_of_lists: List[List[Any]]) -> List[Any]:\n    \"\"\"\n    Finds the sublist with the maximum length from a list of lists.\n    Returns the first such sublist if multiple have the same maximum length, or an empty list if the input is empty.\n    \"\"\"\n    if not list_of_lists:\n        return []\n\n    max_sublist = []\n    max_length = -1\n\n    for sublist in list_of_lists:\n        current_length = len(sublist)\n        if current_length > max_length:\n            max_length = current_length\n            max_sublist = sublist\n            \n    return max_sublist"}
{"task_id": "Mbpp/419", "solution": "def round_and_sum(numbers: list[float | int]) -> int | float:\n    \"\"\"\n    Rounds every number of a given list of numbers, calculates the total sum\n    of the rounded numbers, and returns this sum multiplied by the length of the list.\n\n    Args:\n        numbers: A list of numbers (integers or floats).\n\n    Returns:\n        The total sum of rounded numbers multiplied by the length of the list.\n\n    Raises:\n        TypeError: If the input is not a list.\n        ValueError: If any element in the list is not a number.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list of numbers.\")\n\n    rounded_sum = 0\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise ValueError(f\"List contains non-numeric element: {num}\")\n        rounded_sum += round(num)\n\n    result = rounded_sum * len(numbers)\n    return result"}
{"task_id": "Mbpp/419", "solution": "def round_and_sum(numbers):\n    \"\"\"\n    Rounds each number in a list, sums the rounded values, and then\n    multiplies the sum by the length of the original list.\n    Assumes valid input as a list of numbers.\n    \"\"\"\n    \n    rounded_numbers = [round(n) for n in numbers]\n    total_sum = sum(rounded_numbers)\n    \n    # The multiplier is the length of the original input list.\n    result = total_sum * len(numbers)\n    \n    return result"}
