{"task_id": "Mbpp/474", "solution": "def replace_char(original_string: str, old_char: str, new_char: str) -> str:\n    \"\"\"Replaces all occurrences of old_char with new_char in the original_string.\n\n    Args:\n        original_string: The input string to perform replacements on.\n        old_char: The single character to be replaced.\n        new_char: The single character to replace old_char with.\n\n    Returns:\n        The modified string.\n\n    Raises:\n        TypeError: If original_string is not a string.\n        ValueError: If old_char or new_char are not single-character strings.\n    \"\"\"\n    if not isinstance(original_string, str):\n        raise TypeError(\"original_string must be a string.\")\n    if not isinstance(old_char, str) or len(old_char) != 1:\n        raise ValueError(\"old_char must be a single character string.\")\n    if not isinstance(new_char, str) or len(new_char) != 1:\n        raise ValueError(\"new_char must be a single character string.\")\n\n    return original_string.replace(old_char, new_char)"}
{"task_id": "Mbpp/475", "solution": "from typing import Any, Dict, List, Tuple\ndef sort_counter(data: Dict[Any, Any]) -> List[Tuple[Any, Any]]:\n    \"\"\"\n    Sorts a dictionary by its values in descending order.\n    Returns a list of (key, value) tuples.\n    \"\"\"\n    items = list(data.items())\n    sorted_items = sorted(items, key=lambda item: item[1], reverse=True)\n    return sorted_items"}
