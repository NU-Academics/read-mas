{"task_id": "Mbpp/569", "solution": "from typing import List\ndef sort_sublists(data: List[List[str]]) -> List[List[str]]:\n    \"\"\"Sorts each sublist of strings in a list of lists alphabetically.\n    Returns a new list with sorted sublists, leaving the original input unchanged.\n    \n    Args:\n        data: A list of lists of strings.\n\n    Returns:\n        A new list of lists where each sublist is sorted alphabetically.\n\n    Raises:\n        TypeError: If the input data is not a list of lists of strings,\n                   or if any element within sublists is not a string.\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input must be a list of lists of strings.\")\n\n    sorted_data = []\n    for i, sublist in enumerate(data):\n        if not isinstance(sublist, list):\n            raise TypeError(f\"Element at index {i} is not a list. Input must be a list of lists of strings.\")\n        \n        for j, item in enumerate(sublist):\n            if not isinstance(item, str):\n                raise TypeError(f\"Element at index [{i}][{j}] is not a string. Input must be a list of lists of strings.\")\n\n        sorted_data.append(sorted(sublist))\n    return sorted_data"}
{"task_id": "Mbpp/572", "solution": "def two_unique_nums(numbers: list) -> list:\n    \"\"\"\n    Finds numbers that appear exactly once in a given list, preserving order of first appearance.\n    This function assumes valid list input with numeric elements.\n    \"\"\"\n    counts = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    unique_list = []\n    seen = set()\n    for num in numbers:\n        if counts[num] == 1 and num not in seen:\n            unique_list.append(num)\n            seen.add(num)\n            \n    return unique_list"}
{"task_id": "Mbpp/572", "solution": "def two_unique_nums(numbers: list) -> list:\n    \"\"\"\n    Identifies and returns numbers that appear exactly once in the input list.\n    The original relative order of unique elements is preserved in the output.\n    \"\"\"\n    counts = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    unique_elements = [num for num in numbers if counts[num] == 1]\n    return unique_elements"}
{"task_id": "Mbpp/573", "solution": "def unique_product(numbers: list[int | float]) -> int | float:\n    \"\"\"Calculates the product of unique numbers in a list.\n    Returns 1 for an empty list, as it's the multiplicative identity.\n    \"\"\"\n    unique_numbers = set(numbers)\n    product = 1\n    for num in unique_numbers:\n        product *= num\n    return product"}
{"task_id": "Mbpp/573", "solution": "import math\ndef unique_product(numbers: list[int | float]) -> int | float:\n    \"\"\"Calculates the product of unique numerical elements in a list.\n\n    Args:\n        numbers: A list of integers or floats.\n\n    Returns:\n        The product of the unique numbers. Returns 1 if the list is empty\n        or contains no numerical elements, representing the multiplicative identity.\n\n    Raises:\n        TypeError: If the input is not a list, or if any element in the list\n                   is not an integer or a float.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not numbers:\n        return 1\n\n    unique_numbers_set = set()\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise TypeError(f\"All elements in the list must be numbers, but found type {type(num).__name__}.\")\n        unique_numbers_set.add(num)\n\n    # If all elements were non-numeric and filtered out, unique_numbers_set might be empty\n    # In this case, the product should be 1 (multiplicative identity)\n    if not unique_numbers_set:\n        return 1\n\n    return math.prod(unique_numbers_set)"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list: list, sub_list: list) -> bool:\n    \"\"\"Checks if 'sub_list' is a contiguous sublist of 'main_list'.\n    Returns True if sub_list is found, False otherwise.\"\"\"\n\n    if not sub_list:\n        return True\n\n    len_main = len(main_list)\n    len_sub = len(sub_list)\n\n    if len_sub > len_main:\n        return False\n\n    for i in range(len_main - len_sub + 1):\n        if main_list[i : i + len_sub] == sub_list:\n            return True\n    return False"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list, sub_list):\n    \"\"\"Checks if sub_list is a contiguous sublist of main_list.\n    An empty list is considered a sublist of any list.\n    \"\"\"\n    if not sub_list:\n        return True\n\n    if len(sub_list) > len(main_list):\n        return False\n\n    n = len(main_list)\n    m = len(sub_list)\n\n    for i in range(n - m + 1):\n        if main_list[i:i + m] == sub_list:\n            return True\n    return False"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Calculates the last digit of n!.\n    Leverages mathematical properties to avoid computing large factorials directly.\n    \"\"\"\n    if n == 0 or n == 1:\n        return 1\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 6\n    elif n == 4:\n        return 4\n    else:\n        return 0"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Calculates the last digit of n!.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    if n == 0 or n == 1:\n        return 1\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 6\n    elif n == 4:\n        return 4\n    # For n >= 5, the last digit of n! is 0.\n    else:\n        return 0"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1: list, list2: list, list3: list) -> list:\n    \"\"\"Interleaves elements from three input lists into a single flat list.\n    Assumes all input lists are of the same length and are indeed lists.\n    \"\"\"\n    interleaved = []\n    for i in range(len(list1)):\n        interleaved.append(list1[i])\n        interleaved.append(list2[i])\n        interleaved.append(list3[i])\n    return interleaved"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1: list, list2: list, list3: list) -> list:\n    \"\"\"Interleaves three lists of the same length into a single flat list.\n    It assumes all input lists have identical lengths.\n    \"\"\"\n    length = len(list1)\n    interleaved_list = []\n    for i in range(length):\n        interleaved_list.append(list1[i])\n        interleaved_list.append(list2[i])\n        interleaved_list.append(list3[i])\n    return interleaved_list"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1, tuple2):\n    \"\"\"Identifies elements present in exactly one of the two input tuples.\n    Returns these unique elements as a new tuple, with no guaranteed order.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n    dissimilar_elements = set1.symmetric_difference(set2)\n    return tuple(dissimilar_elements)"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Finds elements present in only one of the input tuples.\n    Returns a new tuple containing these unique dissimilar elements.\n    \"\"\"\n    set_a = set(tuple1)\n    set_b = set(tuple2)\n    dissimilar_set = set_a.symmetric_difference(set_b)\n    return tuple(dissimilar_set)"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Recursively extracts even integers from a nested tuple, preserving structure.\n    Empty nested tuples (after filtering) are excluded from the result.\n    \"\"\"\n    result_elements = []\n    for element in input_tuple:\n        if isinstance(element, tuple):\n            processed_nested_tuple = extract_even(element)\n            if processed_nested_tuple:\n                result_elements.append(processed_nested_tuple)\n        elif isinstance(element, int) and element % 2 == 0:\n            result_elements.append(element)\n    return tuple(result_elements)"}
{"task_id": "Mbpp/580", "solution": "def extract_even(data: tuple) -> tuple:\n    \"\"\"\n    Recursively filters a nested tuple, retaining only even integers\n    and preserving the tuple structure.\n    \"\"\"\n    results = []\n    for item in data:\n        if isinstance(item, int):\n            if item % 2 == 0:\n                results.append(item)\n        elif isinstance(item, tuple):\n            nested_result = extract_even(item)\n            if nested_result:\n                results.append(nested_result)\n    return tuple(results)"}
{"task_id": "Mbpp/581", "solution": "import math\ndef surface_Area(base_edge, height):\n    \"\"\"Calculates the total surface area of a square pyramid.\n    It uses the base edge and height as input for the calculation.\n    \"\"\"\n    # Calculate the total surface area using the standard geometric formula.\n    total_surface_area = base_edge**2 + 2 * base_edge * math.sqrt((base_edge / 2)**2 + height**2)\n    return total_surface_area"}
{"task_id": "Mbpp/581", "solution": "def surface_Area(base_edge, height):\n    \"\"\"\n    Calculates the surface area of a square pyramid.\n    The 'height' parameter is treated as the pyramid's slant height to match the example `surface_Area(3,4) == 33`.\n    \"\"\"\n    # Base area of a square pyramid\n    base_area = base_edge**2\n    \n    # Lateral surface area of the four triangular faces\n    # Each face area = 0.5 * base_edge * slant_height\n    # Total lateral area = 4 * (0.5 * base_edge * slant_height) = 2 * base_edge * slant_height\n    # Assuming the 'height' parameter is the slant height (l)\n    lateral_surface_area = 2 * base_edge * height\n    \n    # Total surface area is the sum of base area and lateral surface area\n    total_surface_area = base_area + lateral_surface_area\n    \n    return total_surface_area"}
{"task_id": "Mbpp/583", "solution": "from math import comb\ndef catalan_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Catalan number.\n\n    Args:\n        n: A non-negative integer.\n\n    Returns:\n        The nth Catalan number.\n\n    Raises:\n        ValueError: If n is negative or not an integer.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    # Using the direct combinatorial formula: C_n = (1 / (n + 1)) * C(2n, n)\n    # C(2n, n) is math.comb(2*n, n)\n    # The division by (n + 1) is guaranteed to be exact for Catalan numbers.\n    return comb(2 * n, n) // (n + 1)"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n, _memo={0: 1}):\n    \"\"\"Calculates the nth Catalan number using an iterative and memoized approach.\n    It leverages the recurrence relation C_n = C_{n-1} * (4n - 2) / (n + 1) for efficiency.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n in _memo:\n        return _memo[n]\n\n    # Fill memoization table up to n if not already computed.\n    # Start from the largest key in _memo, or 1 if only C_0 is present.\n    start_from = max(_memo.keys()) + 1 if _memo else 1\n    \n    for i in range(start_from, n + 1):\n        _memo[i] = _memo[i-1] * (4 * i - 2) // (i + 1)\n            \n    return _memo[n]"}
{"task_id": "Mbpp/585", "solution": "class InvalidInputError(Exception):\n    \"\"\"\n    Custom exception for invalid input data provided to the ItemAnalyzerService.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass Item:\n    \"\"\"\n    Represents a single item with a name and a price.\n    \"\"\"\n    def __init__(self, name: str, price: float):\n        if not isinstance(name, str) or not name:\n            raise ValueError(\"Item name must be a non-empty string.\")\n        if not isinstance(price, (int, float)) or price < 0:\n            raise ValueError(\"Item price must be a non-negative number.\")\n\n        self.name = name\n        self.price = float(price)\n\n    def to_dict(self) -> dict:\n        \"\"\"\n        Converts the Item object to a dictionary.\n        \"\"\"\n        return {'name': self.name, 'price': self.price}\n\n    def __repr__(self) -> str:\n        return f\"Item(name='{self.name}', price={self.price})\"\n\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, Item):\n            return NotImplemented\n        return self.name == other.name and self.price == other.price\nclass ItemAnalyzerService:\n    \"\"\"\n    Service responsible for analyzing item data, specifically finding\n    the n most expensive items.\n    \"\"\"\n    def find_n_most_expensive_items(self, items_data: list[dict], n: int) -> list['Item']:\n        \"\"\"\n        Finds the n most expensive items from a list of item dictionaries.\n\n        Args:\n            items_data: A list of dictionaries, where each dictionary\n                        must contain 'name' (str) and 'price' (numeric) keys.\n            n: The number of most expensive items to retrieve. Must be a positive integer.\n\n        Returns:\n            A list of Item objects, sorted by price in descending order.\n            Returns an empty list if items_data is empty or contains no valid items.\n\n        Raises:\n            InvalidInputError: If items_data is not a list, n is not a positive integer,\n                               or if any item in items_data is malformed.\n        \"\"\"\n        self._validate_input_data(items_data, n)\n\n        parsed_items: list['Item'] = []\n        for i, item_data in enumerate(items_data):\n            try:\n                parsed_items.append(self._parse_item(item_data))\n            except InvalidInputError as e:\n                raise InvalidInputError(f\"Error in item at index {i}: {e.message}\") from e\n\n        if not parsed_items:\n            return []\n\n        # Sort items by price in descending order\n        sorted_items = sorted(parsed_items, key=lambda item: item.price, reverse=True)\n\n        # Return the top n items\n        return sorted_items[:n]\n\n    def _validate_input_data(self, items_data: list[dict], n: int) -> None:\n        \"\"\"\n        Validates the overall input parameters for the service.\n        \"\"\"\n        if not isinstance(items_data, list):\n            raise InvalidInputError(\"Input 'items_data' must be a list.\")\n        if not isinstance(n, int) or n <= 0:\n            raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n\n    def _parse_item(self, item_data: dict) -> 'Item':\n        \"\"\"\n        Parses a single item dictionary into an Item object.\n        \"\"\"\n        if not isinstance(item_data, dict):\n            raise InvalidInputError(\"Each item in 'items_data' must be a dictionary.\")\n        if 'name' not in item_data:\n            raise InvalidInputError(\"Item dictionary must contain a 'name' key.\")\n        if 'price' not in item_data:\n            raise InvalidInputError(\"Item dictionary must contain a 'price' key.\")\n\n        name = item_data['name']\n        price = item_data['price']\n\n        try:\n            return Item(name, price)\n        except ValueError as e:\n            raise InvalidInputError(f\"Invalid item data: {e}\") from e\ndef expensive_items(items_data: list[dict], n: int) -> list[dict]:\n    \"\"\"\n    Finds the n most expensive items in a given dataset.\n\n    Args:\n        items_data: A list of dictionaries, where each dictionary represents an item\n                    and must contain 'name' (string) and 'price' (numeric) keys.\n        n: The number of most expensive items to retrieve. Must be a positive integer.\n\n    Returns:\n        A list of dictionaries representing the n most expensive items,\n        sorted by price in descending order.\n\n    Raises:\n        InvalidInputError: If items_data is not a list, n is not a positive integer,\n                           or if any item in items_data is malformed.\n    \"\"\"\n    analyzer = ItemAnalyzerService()\n    most_expensive_items_obj = analyzer.find_n_most_expensive_items(items_data, n)\n    return [item.to_dict() for item in most_expensive_items_obj]"}
{"task_id": "Mbpp/585", "solution": "class Item:\n    \"\"\"\n    Represents an item with a name and a price.\n    \"\"\"\n    def __init__(self, name: str, price: float):\n        if not isinstance(name, str) or not name:\n            raise ValueError(\"Item name must be a non-empty string.\")\n        if not isinstance(price, (int, float)) or price < 0:\n            raise ValueError(\"Item price must be a non-negative number.\")\n        self._name = name\n        self._price = float(price)\n\n    def get_name(self) -> str:\n        return self._name\n\n    def get_price(self) -> float:\n        return self._price\n\n    def to_dict(self) -> dict:\n        return {\"name\": self._name, \"price\": self._price}\n\n    def __repr__(self) -> str:\n        return f\"Item(name='{self._name}', price={self._price})\"\nclass ItemService:\n    \"\"\"\n    Service for operations related to items, such as finding the most expensive ones.\n    \"\"\"\n    def _validate_item_data(self, item_data: dict) -> None:\n        \"\"\"\n        Validates the structure and content of a single item dictionary.\n        \"\"\"\n        if not isinstance(item_data, dict):\n            raise ValueError(\"Each item must be a dictionary.\")\n        if 'name' not in item_data or 'price' not in item_data:\n            raise ValueError(\"Each item dictionary must contain 'name' and 'price' keys.\")\n        # Further validation handled by Item constructor\n        Item(item_data['name'], item_data['price'])\n\n    def find_n_most_expensive_items(self, items_data: list[dict], n: int) -> list[dict]:\n        \"\"\"\n        Finds the n most expensive items from a given list of item dictionaries.\n\n        Args:\n            items_data: A list of dictionaries, where each dictionary represents an item\n                        and has 'name' (str) and 'price' (float) keys.\n            n: An integer representing the number of most expensive items to return.\n\n        Returns:\n            A list of the n most expensive items, sorted by price in descending order.\n            If n is greater than the number of items, all items are returned.\n            If n is 0 or negative, an empty list is returned.\n\n        Raises:\n            TypeError: If items_data is not a list or n is not an integer.\n            ValueError: If an item dictionary is malformed (missing keys, invalid types).\n        \"\"\"\n        if not isinstance(items_data, list):\n            raise TypeError(\"Input 'items_data' must be a list.\")\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n\n        if n <= 0:\n            return []\n\n        items: list[Item] = []\n        for data in items_data:\n            self._validate_item_data(data)\n            items.append(Item(data['name'], data['price']))\n\n        # Sort items by price in descending order\n        items.sort(key=lambda item: item.get_price(), reverse=True)\n\n        # Return the top n items, or all items if n is too large\n        result_items = items[:n] if n < len(items) else items\n        return [item.to_dict() for item in result_items]\ndef expensive_items(dataset: list[dict], n: int) -> list[dict]:\n    \"\"\"\n    Finds the n most expensive items in a given dataset.\n\n    Args:\n        dataset: A list of dictionaries, where each dictionary represents an item\n                 and has 'name' (str) and 'price' (float) keys.\n        n: An integer representing the number of most expensive items to return.\n\n    Returns:\n        A list of the n most expensive items, sorted by price in descending order.\n        If n is greater than the number of items, all items are returned.\n        If n is 0 or negative, an empty list is returned.\n\n    Raises:\n        TypeError: If dataset is not a list or n is not an integer.\n        ValueError: If an item dictionary in the dataset is malformed.\n    \"\"\"\n    service = ItemService()\n    return service.find_n_most_expensive_items(dataset, n)"}
