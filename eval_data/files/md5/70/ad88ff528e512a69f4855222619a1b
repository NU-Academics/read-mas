{"task_id": "Mbpp/305", "solution": "def split_words(text: str) -> list[str]:\n    \"\"\"Splits a string into words by whitespace.\"\"\"\n    return text.split()\ndef start_withp(word_list: list[str]) -> tuple:\n    \"\"\"Extracts the first two words starting with 'p' (case-insensitive) from a list of strings.\"\"\"\n    found_words = []\n    for text_string in word_list:\n        words_in_string = split_words(text_string)\n        for word in words_in_string:\n            if word.lower().startswith('p'):\n                found_words.append(word)\n                if len(found_words) == 2:\n                    return tuple(found_words)\n    return tuple(found_words)"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Calculates the maximum sum of an increasing subsequence from arr[0...i] that includes arr[k].\n    The subsequence elements from arr[0...i] must be strictly less than arr[k].\n    \"\"\"\n    dp = [0] * (i + 1)\n    max_prefix_sum = 0\n\n    for j in range(i + 1):\n        dp[j] = arr[j]\n        for p in range(j):\n            if arr[j] > arr[p]:\n                dp[j] = max(dp[j], dp[p] + arr[j])\n\n        if arr[j] < arr[k]:\n            max_prefix_sum = max(max_prefix_sum, dp[j])\n\n    return max_prefix_sum + arr[k]"}
{"task_id": "Mbpp/308", "solution": "import heapq\ndef large_product(list1: list[float], list2: list[float], k: int) -> list[float]:\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list.\n    \"\"\"\n    # Calculate all possible products by pairing one element from each list.\n    products = []\n    for num1 in list1:\n        for num2 in list2:\n            products.append(num1 * num2)\n\n    # If k is greater than or equal to the total number of products, return all, sorted.\n    if k >= len(products):\n        return sorted(products, reverse=True)\n    \n    # Efficiently find the k largest products using a min-heap, then sort the result.\n    return sorted(heapq.nlargest(k, products), reverse=True)"}
{"task_id": "Mbpp/308", "solution": "import heapq\ndef large_product(list1: list[int], list2: list[int], num_largest: int) -> list[int]:\n    \"\"\"\n    Finds the specified number of largest products from two lists.\n    Products are formed by multiplying one element from each list.\n    \"\"\"\n    if not list1 or not list2 or num_largest <= 0:\n        return []\n\n    min_heap = [] # Stores the num_largest largest products found so far.\n\n    for val1 in list1:\n        for val2 in list2:\n            product = val1 * val2\n            if len(min_heap) < num_largest:\n                heapq.heappush(min_heap, product)\n            elif product > min_heap[0]:\n                heapq.heapreplace(min_heap, product)\n\n    # Extract elements from the min-heap and sort in descending order.\n    result = sorted(min_heap, reverse=True)\n    return result"}
