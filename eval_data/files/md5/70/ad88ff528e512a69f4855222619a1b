{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced and correctly nested delimiters.\n    Only parentheses `()`, brackets `[]`, and braces `{}` are considered.\n    \"\"\"\n    OPENING_DELIMITERS = \"([{\"\n    CLOSING_DELIMITERS = \")]}\"\n    DELIMITER_MAP = {\"(\": \")\", \"[\": \"]\", \"{\": \"}\"}\n\n    stack = []\n    for char in expression:\n        if char in OPENING_DELIMITERS:\n            stack.append(char)\n        elif char in CLOSING_DELIMITERS:\n            if not stack:\n                return False\n            last_opener = stack.pop()\n            if DELIMITER_MAP[last_opener] != char:\n                return False\n    return not stack"}
{"task_id": "Mbpp/771", "solution": "OPENING_DELIMITERS = \"({[\"\nCLOSING_DELIMITERS = \")}]\"\nDELIMITER_MAP = {\"(\": \")\", \"{\": \"}\", \"[\": \"]\"}\ndef check_expression(expression: str) -> bool:\n    \"\"\"Checks if a string expression has balanced delimiters.\n    It uses a stack to match opening and closing delimiters.\n    \"\"\"\n    stack = []\n    \n    for char in expression:\n        if char in OPENING_DELIMITERS:\n            stack.append(char)\n        elif char in CLOSING_DELIMITERS:\n            if not stack:\n                return False\n            last_opened = stack.pop()\n            if DELIMITER_MAP.get(last_opened) != char:\n                return False\n                \n    return not stack"}
