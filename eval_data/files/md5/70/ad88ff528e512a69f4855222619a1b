{"task_id": "Mbpp/299", "solution": "from collections import defaultdict\nfrom typing import List, Tuple\ndef max_aggregate(data: List[Tuple[str, int]]) -> Tuple[str, int]:\n    \"\"\"\n    Calculates the maximum aggregated score from a list of name-score tuples.\n    Returns ('', 0) if the input list is empty.\n    \"\"\"\n    aggregated_scores = defaultdict(int)\n\n    for name, score in data:\n        aggregated_scores[name] += score\n\n    if not aggregated_scores:\n        return ('', 0)\n\n    max_name = ''\n    max_score = 0\n\n    for name, total_score in aggregated_scores.items():\n        if total_score > max_score:\n            max_score = total_score\n            max_name = name\n    \n    return (max_name, max_score)"}
{"task_id": "Mbpp/299", "solution": "from collections import defaultdict\ndef max_aggregate(scores):\n    \"\"\"\n    Calculates the sum of scores for each unique name and returns the name\n    with the highest total score along with their total score. Assumes scores are non-negative.\n    \"\"\"\n    aggregated_scores = defaultdict(int)\n    for name, score in scores:\n        aggregated_scores[name] += score\n\n    max_name = None\n    max_score = -1\n\n    for name, total_score in aggregated_scores.items():\n        if total_score > max_score:\n            max_score = total_score\n            max_name = name\n\n    return (max_name, max_score)"}
{"task_id": "Mbpp/300", "solution": "import math\ndef count_binary_seq(n: int) -> int:\n    \"\"\"\n    Finds the count of all binary sequences of length 2n such that\n    the sum of the first n bits is same as the sum of the last n bits.\n    This is equivalent to C(2n, n).\n\n    Args:\n        n: An integer representing half the total length of the sequence.\n\n    Returns:\n        The total count of such binary sequences.\n\n    Raises:\n        ValueError: If n is a negative integer.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    # The problem simplifies to calculating C(2n, n)\n    # based on the identity Sum_{k=0 to n} (C(n, k))^2 = C(2n, n)\n    return math.comb(2 * n, n)"}
{"task_id": "Mbpp/300", "solution": "import math\ndef count_binary_seq(n: int) -> int:\n    \"\"\"\n    Calculates the count of binary sequences where the sum of the first half of bits\n    equals the sum of the second half. Assumes n is a non-negative integer.\n    \"\"\"\n    total_count = 0\n    # Iterate through all possible sums 'k' for the first (and last) n bits\n    for k in range(n + 1):\n        # Calculate the number of ways to choose k bits out of n to be '1'\n        combinations_n_k = math.comb(n, k)\n        # Add the square of this count to total_count\n        total_count += combinations_n_k * combinations_n_k\n    return total_count"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(d: dict) -> int:\n    \"\"\"\n    Calculates the maximum depth of a dictionary, traversing nested dictionaries and iterables.\n    Each nested dictionary increments the depth.\n    \"\"\"\n    max_depth_found = 1\n\n    for value in d.values():\n        if isinstance(value, dict):\n            max_depth_found = max(max_depth_found, dict_depth(value) + 1)\n        elif isinstance(value, (list, tuple, set)):\n            for item in value:\n                if isinstance(item, dict):\n                    max_depth_found = max(max_depth_found, dict_depth(item) + 1)\n    return max_depth_found"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(d: dict) -> int:\n    \"\"\"Calculates the maximum nesting depth of dictionaries within the input.\n    Depth counts the dictionary itself as one level, returning 0 for non-dict inputs.\n    \"\"\"\n    if not isinstance(d, dict):\n        return 0\n\n    if not d:\n        return 1\n\n    max_current_depth = 1\n    for value in d.values():\n        if isinstance(value, dict):\n            max_current_depth = max(max_current_depth, 1 + dict_depth(value))\n        elif isinstance(value, (list, tuple)):\n            for item in value:\n                if isinstance(item, dict):\n                    max_current_depth = max(max_current_depth, 1 + dict_depth(item))\n    return max_current_depth"}
