{"task_id": "Mbpp/141", "solution": "def pancake_sort(arr):\n    \"\"\"\n    Sorts a list of numbers using the pancake sort algorithm.\n    Returns a new list containing the sorted numbers in ascending order.\n    \"\"\"\n\n    def _flip(sub_arr: list, k: int) -> None:\n        \"\"\"Reverses the order of the first k elements in sub_arr.\n        k is the length of the prefix to reverse (indices 0 to k-1).\"\"\"\n        start = 0\n        end = k - 1\n        while start < end:\n            sub_arr[start], sub_arr[end] = sub_arr[end], sub_arr[start]\n            start += 1\n            end -= 1\n\n    def _find_max_index(sub_arr: list, n: int) -> int:\n        \"\"\"Finds the index of the maximum element in the first n elements of sub_arr.\n        n is the length of the sublist to search.\"\"\"\n        max_val = sub_arr[0]\n        max_idx = 0\n        for i in range(1, n):\n            if sub_arr[i] > max_val:\n                max_val = sub_arr[i]\n                max_idx = i\n        return max_idx\n\n    # Create a copy to avoid modifying the original list and return a new one.\n    current_arr = list(arr)\n\n    n = len(current_arr)\n    for curr_size in range(n, 1, -1):\n        # Find index of the maximum element in current sublist (0 to curr_size-1).\n        max_idx = _find_max_index(current_arr, curr_size)\n\n        # If max element is not already at its correct position.\n        if max_idx != curr_size - 1:\n            # Move the maximum element to the beginning of the sublist.\n            _flip(current_arr, max_idx + 1)\n\n            # Move the maximum element to its correct sorted position.\n            _flip(current_arr, curr_size)\n            \n    return current_arr"}
{"task_id": "Mbpp/141", "solution": "def _find_max_index(data: list, n: int) -> int:\n    \"\"\"\n    Finds the index of the maximum element within the first n elements of the list data.\n    This helper identifies the largest element in the current unsorted segment.\n    \"\"\"\n    max_val = data[0]\n    max_idx = 0\n    for i in range(1, n):\n        if data[i] > max_val:\n            max_val = data[i]\n            max_idx = i\n    return max_idx\ndef pancake_sort(data: list) -> list:\n    \"\"\"\n    Sorts the input list using the pancake sort algorithm.\n    Returns a new sorted list, leaving the original list unchanged.\n    \"\"\"\n    # Validate input type\n    if not isinstance(data, list):\n        raise TypeError(\"Input must be a list.\")\n\n    n = len(data)\n    # Handle empty or single-element lists\n    if n <= 1:\n        return list(data) # Return a copy for consistency\n\n    arr = list(data) # Work on a copy to avoid modifying original list\n\n    # The main sorting loop iterates from the largest segment down to 2 elements.\n    for curr_size in range(n, 1, -1):\n        # Find index of the maximum element in the current unsorted segment.\n        max_idx = _find_max_index(arr, curr_size)\n\n        # If the max element is not already at the end of the current segment, move it.\n        if max_idx != curr_size - 1:\n            # First, move the maximum element to the beginning of the segment.\n            _flip(arr, max_idx)\n            # Then, move the maximum element from the beginning to its correct sorted position.\n            _flip(arr, curr_size - 1)\n    return arr"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1, list2, list3):\n    \"\"\"\n    Counts how many items are identical across three given lists at the same position.\n    It iterates up to the length of the shortest list.\n    \"\"\"\n    count = 0\n    min_length = min(len(list1), len(list2), len(list3))\n    for i in range(min_length):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
