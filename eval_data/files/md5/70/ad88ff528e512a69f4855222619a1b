{"task_id": "Mbpp/462", "solution": "def combinations_list(input_list):\n    \"\"\"\n    Finds all possible combinations of the elements of a given list.\n    The order of combinations and elements within combinations matches the example.\n    \"\"\"\n    result = [[]]\n    for item in reversed(input_list):\n        new_combinations = []\n        for existing_combination in result:\n            new_combinations.append([item] + existing_combination)\n        result.extend(new_combinations)\n    return sorted(result, key=lambda x: (len(x), [str(i) for i in x]))"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(nums: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum product of a contiguous subarray within a given array of integers.\n    Handles positive, negative, and zero values efficiently in O(n) time.\n    \"\"\"\n    if not nums:\n        return 0\n\n    max_so_far = nums[0]\n    min_so_far = nums[0]\n    result = max_so_far\n\n    for i in range(1, len(nums)):\n        curr = nums[i]\n        \n        # Store the previous max_so_far to calculate the new min_so_far\n        temp_max = max(curr, max_so_far * curr, min_so_far * curr)\n        min_so_far = min(curr, max_so_far * curr, min_so_far * curr)\n\n        max_so_far = temp_max\n\n        result = max(max_so_far, result)\n\n    return result"}
{"task_id": "Mbpp/462", "solution": "from typing import List, Any\nclass CombinationsGenerator:\n    \"\"\"\n    Generates all combinations (subsets) from a list, producing the specific output order.\n    \"\"\"\n    def __init__(self, elements: List[Any]):\n        self._elements = elements\n\n    def generate(self) -> List[List[Any]]:\n        \"\"\"\n        Computes and returns all possible combinations of the initialized elements.\n        The result includes the empty list and specific order based on prepending.\n        \"\"\"\n        result: List[List[Any]] = [[]]\n        for element in self._elements:\n            new_combinations = []\n            for existing_combination in result:\n                new_combinations.append(existing_combination + [element])\n            result.extend(new_combinations)\n        return result\ndef combinations_list(input_list: List[Any]) -> List[List[Any]]:\n    \"\"\"\n    Generates all possible combinations (subsets) of elements from the given list.\n    The empty list is always included, with specific element ordering.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input 'input_list' must be a list.\")\n\n    generator = CombinationsGenerator(input_list)\n    return generator.generate()"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(nums):\n    # Handle the empty array case as per problem requirements.\n    if not nums:\n        return 0\n\n    max_so_far = nums[0]\n    min_so_far = nums[0]\n    result = max_so_far\n\n    # Iterate through the array to find the maximum product subarray.\n    for i in range(1, len(nums)):\n        curr = nums[i]\n        \n        # Calculate potential new maximum and minimum products ending at the current position.\n        temp_max = max(curr, max_so_far * curr, min_so_far * curr)\n        min_so_far = min(curr, max_so_far * curr, min_so_far * curr)\n\n        max_so_far = temp_max\n        result = max(max_so_far, result)\n\n    return result"}
