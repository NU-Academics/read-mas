{"task_id": "Mbpp/84", "solution": "from typing import Dict, Optional\nclass Cache:\n    \"\"\"Simple in-memory key-value store for memoization.\"\"\"\n    def __init__(self) -> None:\n        self._store: Dict[int, int] = {}\n\n    def get(self, key: int) -> Optional[int]:\n        \"\"\"Retrieves a value from the cache.\"\"\"\n        return self._store.get(key)\n\n    def set(self, key: int, value: int) -> None:\n        \"\"\"Stores a key-value pair in the cache.\"\"\"\n        self._store[key] = value\nclass NewmanConwaySequenceCalculator:\n    \"\"\"Calculates Newman-Conway sequence numbers with memoization.\"\"\"\n    def __init__(self) -> None:\n        self._cache = Cache()\n        # Initialize base cases P(1)=1 and P(2)=1 in the cache.\n        self._cache.set(1, 1)\n        self._cache.set(2, 1)\n\n    def calculate(self, n: int) -> int:\n        \"\"\"Public method to compute the nth Newman-Conway number.\"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise ValueError(\"Input 'n' must be a positive integer.\")\n        return self._p(n)\n\n    def _p(self, n: int) -> int:\n        \"\"\"Private recursive helper method to compute P(n) using memoization.\"\"\"\n        cached_value = self._cache.get(n)\n        if cached_value is not None:\n            return cached_value\n\n        # Applies the recursive formula P(n) = P(P(n - 1)) + P(n - P(n - 1)) for n > 2.\n        p_n_minus_1 = self._p(n - 1)\n        result = self._p(p_n_minus_1) + self._p(n - p_n_minus_1)\n        self._cache.set(n, result)\n        return result\n_calculator = NewmanConwaySequenceCalculator()\ndef sequence(n: int) -> int:\n    \"\"\"\n    Calculates the nth number in the Newman-Conway sequence.\n\n    The sequence is defined as:\n    P(1) = 1\n    P(2) = 1\n    P(n) = P(P(n - 1)) + P(n - P(n - 1)) for n > 2\n\n    Args:\n        n: A positive integer representing the index in the sequence.\n\n    Returns:\n        The nth Newman-Conway number.\n\n    Raises:\n        ValueError: If n is not a positive integer.\n    \"\"\"\n    return _calculator.calculate(n)"}
