{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum (n - 2*i) from i=0 to n // 2,\n    for instance n + (n-2) + (n-4)... (until n-x =< 0).\n    Terms are included as long as they are strictly positive.\n\n    Args:\n        n: An integer representing the starting term of the series.\n\n    Returns:\n        An integer representing the sum of the series. Returns 0 if n is negative.\n\n    Raises:\n        TypeError: If n is not an integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        return 0\n\n    total_sum = 0\n    current_i = 0\n    while True:\n        term = n - 2 * current_i\n        if term <= 0:  # Stop when term is non-positive\n            break\n        total_sum += term\n        current_i += 1\n    return total_sum"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series n + (n-2) + (n-4) + ...\n    Only non-negative terms are included in the sum.\n    \"\"\"\n    if n <= 0:\n        return 0\n\n    total_sum = 0\n    for i in range(n // 2 + 1):\n        term = n - 2 * i\n        if term > 0:\n            total_sum += term\n        else:\n            break\n    return total_sum"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Finds integer solutions (x, y) for the linear Diophantine equation ax + by = n.\n    Returns a tuple (x, y) if a solution exists, otherwise None.\n    \"\"\"\n\n    def gcd(a_val: int, b_val: int) -> int:\n        \"\"\"Computes the greatest common divisor of two integers using the Euclidean algorithm.\"\"\"\n        while b_val:\n            a_val, b_val = b_val, a_val % b_val\n        return abs(a_val)\n\n    def extended_gcd(a_val: int, b_val: int) -> tuple[int, int, int]:\n        \"\"\"Implements the Extended Euclidean Algorithm to find g, x, y such that ax + by = g = gcd(a, b).\"\"\"\n        if a_val == 0:\n            return b_val, 0, 1\n        g, x, y = extended_gcd(b_val % a_val, a_val)\n        return g, y - (b_val // a_val) * x, x\n\n    g, x_prime, y_prime = extended_gcd(a, b)\n\n    if g == 0: # This implies a == 0 and b == 0\n        if n == 0:\n            return 0, 0 # Any x,y is a solution; (0,0) is a valid choice.\n        else:\n            return None # 0x + 0y = n can only be satisfied if n is 0.\n\n    if n % g != 0:\n        return None # No integer solution exists if n is not divisible by gcd(a, b).\n\n    # Calculate a particular solution by scaling x_prime and y_prime.\n    factor = n // g\n    x = x_prime * factor\n    y = y_prime * factor\n    return x, y"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    \"\"\"Counts characters whose 1-indexed string position matches their 1-indexed alphabetical position, case-insensitively.\"\"\"\n    count = 0\n    for i, char in enumerate(input_string):\n        lower_char = char.lower()\n        if 'a' <= lower_char <= 'z':\n            alphabet_position = ord(lower_char) - ord('a') + 1\n            if alphabet_position == i + 1:\n                count += 1\n    return count"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters whose 1-based string position matches their 1-based alphabetical position (case-insensitive).\n    Non-alphabetic characters are ignored.\n    \"\"\"\n    count = 0\n    # Maps lowercase letters to their 1-based alphabetical position.\n    alphabet_positions = {chr(ord('a') + i): i + 1 for i in range(26)}\n\n    for i, char in enumerate(input_string):\n        # Convert character to lowercase for case-insensitive comparison.\n        lower_char = char.lower()\n\n        # Check if the character is an English alphabet letter.\n        if 'a' <= lower_char <= 'z':\n            alpha_pos = alphabet_positions[lower_char]\n            string_index = i + 1\n\n            if alpha_pos == string_index:\n                count += 1\n    return count"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(numbers: list[int]) -> int:\n    \"\"\"\n    Counts pairs of integers in a list that XOR to an even number.\n    Pairs XOR to an even number if they have the same parity (both even or both odd).\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for num in numbers:\n        if num % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # Calculate combinations of even numbers (nC2) and odd numbers (nC2)\n    even_pairs = even_count * (even_count - 1) // 2\n    odd_pairs = odd_count * (odd_count - 1) // 2\n\n    return even_pairs + odd_pairs"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(nums: list[int]) -> int:\n    \"\"\"\n    Counts pairs of integers in a list whose bitwise XOR operation results in an even number.\n    This relies on the property that a XOR b is even if and only if a and b have the same parity.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for num in nums:\n        if num % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # Calculate combinations for (even, even) pairs and (odd, odd) pairs.\n    even_pairs = even_count * (even_count - 1) // 2\n    odd_pairs = odd_count * (odd_count - 1) // 2\n\n    return even_pairs + odd_pairs"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Calculates the smallest power of 2 greater than or equal to n.\n    Assumes n is a non-negative integer as per the design's preconditions.\n    \"\"\"\n    if n == 0:\n        return 1\n    \n    # Efficiently calculates the next power of 2 using bit manipulation.\n    # This handles both powers of 2 (e.g., 8 -> 8) and non-powers (e.g., 7 -> 8).\n    n -= 1\n    n |= n >> 1\n    n |= n >> 2\n    n |= n >> 4\n    n |= n >> 8\n    n |= n >> 16\n    n |= n >> 32 # For 64-bit integers; Python integers handle arbitrary size.\n    n += 1\n    return n"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Returns 1 if n is 0, otherwise iteratively finds the next power.\n    \"\"\"\n    if n == 0:\n        return 1\n    \n    power = 1\n    while power < n:\n        power *= 2\n    return power"}
