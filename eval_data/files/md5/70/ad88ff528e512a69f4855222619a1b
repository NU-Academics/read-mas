{"task_id": "Mbpp/260", "solution": "def _is_prime(num: int) -> bool:\n    \"\"\"Checks if a number is prime using trial division.\"\"\"\n    if num <= 1:\n        return False\n    if num <= 3:\n        return True\n    if num % 2 == 0 or num % 3 == 0:\n        return False\n    i = 5\n    while i * i <= num:\n        if num % i == 0 or num % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n_nsw_sequence_cache = {0: 1, 1: 1}\ndef _calculate_nsw_number(n: int) -> int:\n    \"\"\"Calculates the n-th Newman-Shanks-Williams number using memoization.\"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    if n in _nsw_sequence_cache:\n        return _nsw_sequence_cache[n]\n\n    # Calculate iteratively to fill cache up to n\n    for i in range(2, n + 1):\n        if i not in _nsw_sequence_cache:\n            _nsw_sequence_cache[i] = (\n                2 * _nsw_sequence_cache[i - 1] + _nsw_sequence_cache[i - 2]\n            )\n    return _nsw_sequence_cache[n]\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the n-th Newman-Shanks-Williams prime number.\n\n    Args:\n        n: The index of the Newman-Shanks-Williams number to find.\n\n    Returns:\n        The n-th Newman-Shanks-Williams number if it is prime.\n\n    Raises:\n        ValueError: If n is negative or if the n-th NSW number is not prime.\n    \"\"\"\n    nsw_number = _calculate_nsw_number(n)\n    if not _is_prime(nsw_number):\n        raise ValueError(f\"The {n}-th Newman-Shanks-Williams number ({nsw_number}) is not prime.\")\n    return nsw_number"}
{"task_id": "Mbpp/260", "solution": "def newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the nth Newman-Shanks-Williams (NSW) prime number.\n    It calculates S_n and verifies its primality.\n\n    Args:\n        n: The index (k) of the NSW number in the sequence.\n\n    Returns:\n        The nth Newman-Shanks-Williams prime number (S_n).\n\n    Raises:\n        TypeError: If n is not an integer.\n        ValueError: If n is negative, or if S_n is not a prime number.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    def _calculate_nsw(k: int) -> int:\n        # Calculates the kth Newman-Shanks-Williams (NSW) number iteratively.\n        # Handles base cases for k=0 and k=1 directly.\n        if k == 0:\n            return 1\n        if k == 1:\n            return 1\n\n        s_prev_prev = 1\n        s_prev = 1\n        for _ in range(2, k + 1):\n            s_current = 2 * s_prev + s_prev_prev\n            s_prev_prev = s_prev\n            s_prev = s_current\n        return s_prev\n\n    def _is_prime(num: int) -> bool:\n        # Determines if a given number is prime using an optimized trial division method.\n        # Checks divisors up to its square root.\n        if num <= 1:\n            return False\n        if num <= 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    nsw_number = _calculate_nsw(n)\n    if not _is_prime(nsw_number):\n        raise ValueError(f\"S_{n} ({nsw_number}) is not a prime number.\")\n    return nsw_number"}
{"task_id": "Mbpp/261", "solution": "def division_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n    results = []\n    for i in range(len(tuple1)):\n        if tuple2[i] == 0:\n            raise ZeroDivisionError(f\"Cannot divide by zero at index {i}.\")\n        results.append(tuple1[i] / tuple2[i])\n    return tuple(results)"}
