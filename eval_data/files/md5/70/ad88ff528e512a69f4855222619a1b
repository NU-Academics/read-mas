{"task_id": "Mbpp/635", "solution": "import copy\ndef heap_sort(data_list: list[int | float]) -> list[int | float]:\n    \"\"\"\n    Sorts a list of numbers in ascending order using the heap sort algorithm.\n    It creates a sorted copy of the input list.\n    \"\"\"\n    arr = copy.deepcopy(data_list)\n    n = len(arr)\n\n    def _heapify(arr_param: list[int | float], heap_size: int, i: int) -> None:\n        \"\"\"\n        Maintains the max-heap property for a subtree rooted at index i.\n        It ensures the parent node is greater than its children within the current heap_size.\n        \"\"\"\n        largest = i\n        l = 2 * i + 1\n        r = 2 * i + 2\n\n        if l < heap_size and arr_param[largest] < arr_param[l]:\n            largest = l\n\n        if r < heap_size and arr_param[largest] < arr_param[r]:\n            largest = r\n\n        if largest != i:\n            arr_param[i], arr_param[largest] = arr_param[largest], arr_param[i]\n            _heapify(arr_param, heap_size, largest)\n\n    def _build_max_heap(arr_param: list[int | float]) -> None:\n        \"\"\"\n        Converts an arbitrary list into a max-heap.\n        It calls _heapify for all non-leaf nodes starting from the last parent.\n        \"\"\"\n        heap_size_for_build = len(arr_param)\n        for i in range(heap_size_for_build // 2 - 1, -1, -1):\n            _heapify(arr_param, heap_size_for_build, i)\n\n    _build_max_heap(arr)\n\n    for i in range(n - 1, 0, -1):\n        arr[i], arr[0] = arr[0], arr[i]\n        _heapify(arr, i, 0)\n    \n    return arr"}
