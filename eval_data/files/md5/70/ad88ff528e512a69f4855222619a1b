{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number, which represents the number of partitions of a set with n elements.\n    It uses Stirling numbers of the second kind for computation.\n    \"\"\"\n    # Initialize a 2D array for Stirling numbers of the second kind.\n    # S(i, j) represents stirling[i][j].\n    stirling = [[0 for _ in range(n + 1)] for _ in range(n + 1)]\n\n    # Base cases for Stirling numbers: S(0,0) = 1, S(i,0) = 0 for i>0, S(i,i) = 1.\n    stirling[0][0] = 1\n    for i in range(1, n + 1):\n        stirling[i][i] = 1\n        for j in range(1, i):\n            stirling[i][j] = stirling[i - 1][j - 1] + j * stirling[i - 1][j]\n\n    # The nth Bell number is the sum of Stirling numbers S(n, k) for k from 0 to n.\n    bell = 0\n    for k in range(n + 1):\n        bell += stirling[n][k]\n\n    return bell"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"Calculates the nth Bell number using Stirling numbers of the second kind.\n    This function assumes n is a non-negative integer.\n    \"\"\"\n\n    def _compute_stirling_numbers_internal(max_n: int) -> list[list[int]]:\n        \"\"\"Computes Stirling numbers of the second kind S(i, j) up to max_n.\n        This helper uses dynamic programming for efficiency.\n        \"\"\"\n        stirling_numbers = [[0] * (max_n + 1) for _ in range(max_n + 1)]\n        stirling_numbers[0][0] = 1\n\n        for i in range(1, max_n + 1):\n            for j in range(1, i + 1):\n                stirling_numbers[i][j] = stirling_numbers[i-1][j-1] + j * stirling_numbers[i-1][j]\n        return stirling_numbers\n\n    if n == 0:\n        return 1\n\n    stirling_numbers_matrix = _compute_stirling_numbers_internal(n)\n\n    # Bell number B(n) = sum(S(n, k) for k from 0 to n)\n    bell_n = sum(stirling_numbers_matrix[n][k] for k in range(n + 1))\n    return bell_n"}
{"task_id": "Mbpp/68", "solution": "def _is_non_decreasing(arr: list[int | float]) -> bool:\n    \"\"\"Checks if the array is non-decreasing.\n    It returns False if any element is greater than the next.\n    \"\"\"\n    for i in range(len(arr) - 1):\n        if arr[i] > arr[i+1]:\n            return False\n    return True\ndef _is_non_increasing(arr: list[int | float]) -> bool:\n    \"\"\"Checks if the array is non-increasing.\n    It returns False if any element is smaller than the next.\n    \"\"\"\n    for i in range(len(arr) - 1):\n        if arr[i] < arr[i+1]:\n            return False\n    return True\ndef is_Monotonic(arr: list[int | float]) -> bool:\n    \"\"\"Determines if a list of numbers is monotonic.\n    It returns True if the array is entirely non-decreasing or non-increasing.\n    \"\"\"\n    if len(arr) <= 1:\n        return True\n\n    return _is_non_decreasing(arr) or _is_non_increasing(arr)"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(arr: list) -> bool:\n    \"\"\"Checks if the given array is monotonic (either non-increasing or non-decreasing).\n    Empty or single-element arrays are considered monotonic.\"\"\"\n    if len(arr) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(1, len(arr)):\n        if arr[i] > arr[i-1]:\n            is_decreasing = False\n        if arr[i] < arr[i-1]:\n            is_increasing = False\n\n    return is_increasing or is_decreasing"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list: list, sub_list: list) -> bool:\n    \"\"\"\n    Checks if sub_list is found as a contiguous sequence within main_list.\n    Handles edge cases for empty or differing length lists as per design.\n    \"\"\"\n    if not sub_list:\n        return True\n    if not main_list and sub_list:\n        return False\n    if len(sub_list) > len(main_list):\n        return False\n\n    n = len(main_list)\n    m = len(sub_list)\n\n    for i in range(n - m + 1):\n        if main_list[i:i + m] == sub_list:\n            return True\n    return False"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list, sub_list):\n    \"\"\"\n    Returns True if `sub_list` is found contiguously within `main_list`; an empty `sub_list` always returns True.\n    Returns False if `main_list` is empty and `sub_list` is not, or if `sub_list` is not found.\n    \"\"\"\n    if not sub_list:\n        return True\n    \n    if not main_list:\n        return False\n    \n    n = len(main_list)\n    m = len(sub_list)\n\n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        if main_list[i:i+m] == sub_list:\n            return True\n            \n    return False"}
