{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Calculates the minimum positive number of rotations required to transform\n    the input string `s` back into itself.\n    \"\"\"\n    if not s:\n        return 0\n    if len(s) == 1:\n        return 1\n\n    double_s = s + s\n    # Iterate through possible rotation counts k, from 1 up to the string's length.\n    for k in range(1, len(s) + 1):\n        # Check if the string formed by rotating s by k positions matches the original string.\n        if double_s[k : k + len(s)] == s:\n            return k"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Calculates the minimum number of rotations (greater than 0) for a string to return to its original form.\n    Handles empty and single-character strings by returning 1, per specified business rules.\n    \"\"\"\n    n = len(s)\n    \n    if n == 0 or n == 1:\n        return 1\n\n    for i in range(1, n):\n        rotated_s = s[i:] + s[:i]\n        if rotated_s == s:\n            return i\n    \n    return n"}
{"task_id": "Mbpp/7", "solution": "import string\ndef find_char_long(text):\n    \"\"\"Extracts words from a string that are at least 4 characters long,\n    after removing leading/trailing punctuation.\n    \"\"\"\n    words = text.split()\n    long_words = set()\n    for word in words:\n        cleaned_word = word.strip(string.punctuation)\n        if len(cleaned_word) >= 4:\n            long_words.add(cleaned_word)\n    return long_words"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(text: str, char_to_remove: str) -> str:\n    \"\"\"Removes the first and last occurrences of a specified character from a string.\n    If the character appears less than twice, it is removed once or not at all, respectively.\"\"\"\n    first_idx = text.find(char_to_remove)\n    if first_idx == -1:\n        return text\n\n    # Construct intermediate string after removing the first occurrence.\n    temp_text = text[:first_idx] + text[first_idx+1:]\n\n    last_idx = temp_text.rfind(char_to_remove)\n    if last_idx == -1:\n        # If no other occurrence is found, return the string with only the first removed.\n        return temp_text\n\n    # Construct the final string after removing the last occurrence from the intermediate string.\n    return temp_text[:last_idx] + temp_text[last_idx+1:]"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, char_to_remove: str) -> str:\n    \"\"\"Removes the first and last occurrences of a specified character from a string.\n    If the character appears only once, it is removed; if not found, the original string is returned.\"\"\"\n    first_idx = input_string.find(char_to_remove)\n    if first_idx == -1:\n        return input_string\n\n    last_idx = input_string.rfind(char_to_remove)\n\n    if first_idx == last_idx:\n        return input_string[:first_idx] + input_string[first_idx+1:]\n    else:\n        temp_string = input_string[:first_idx] + input_string[first_idx+1:]\n        adjusted_last_idx = temp_string.rfind(char_to_remove)\n        return temp_string[:adjusted_last_idx] + temp_string[adjusted_last_idx+1:]"}
