{"task_id": "Mbpp/63", "solution": "from typing import List, Tuple\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef max_difference(tuple_list: List[Tuple[int, int]]) -> int:\n    \"\"\"\n    Finds the maximum absolute difference between elements in available pairs.\n\n    Args:\n        tuple_list: A list of tuples, where each tuple contains two integers.\n\n    Returns:\n        The maximum absolute difference found.\n\n    Raises:\n        InvalidInputError: If the input list is empty or contains malformed tuples.\n    \"\"\"\n    if not isinstance(tuple_list, list):\n        raise InvalidInputError(\"Input must be a list.\")\n    if not tuple_list:\n        raise InvalidInputError(\"Input list cannot be empty.\")\n\n    differences = []\n    for i, item in enumerate(tuple_list):\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise InvalidInputError(\n                f\"Element at index {i} is not a tuple of two elements: {item}\"\n            )\n        if not all(isinstance(x, int) for x in item):\n            raise InvalidInputError(\n                f\"Elements in tuple at index {i} must be integers: {item}\"\n            )\n        a, b = item\n        differences.append(abs(a - b))\n\n    return max(differences)"}
{"task_id": "Mbpp/63", "solution": "def max_difference(data: list[tuple[int, int]]) -> int:\n    \"\"\"Calculates the largest absolute difference between elements in any tuple in a list.\n    Returns 0 if the input list is empty, otherwise returns the maximum absolute difference.\n    \"\"\"\n    if not data:\n        return 0\n\n    # Calculate absolute differences for each tuple.\n    # As per critical requirements, input types are trusted, and no explicit validation is performed.\n    differences = (abs(a - b) for a, b in data)\n\n    # Find the maximum of these differences.\n    return max(differences)"}
