{"task_id": "Mbpp/592", "solution": "import math\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the product of consecutive binomial coefficients.\n    This is equivalent to C(2n, n-1).\n\n    Args:\n        n: A non-negative integer.\n\n    Returns:\n        The sum of the product of consecutive binomial coefficients.\n\n    Raises:\n        ValueError: If n is a negative integer.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    if n == 0:\n        return 0\n    # Using the identity: Sum_{k=0 to n-1} C(n, k) * C(n, k+1) = C(2n, n-1)\n    return math.comb(2 * n, n - 1)"}
{"task_id": "Mbpp/592", "solution": "def binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient C(n, k).\n    Returns 0 if k is out of the valid range [0, n].\n    \"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n    \n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the product of consecutive binomial coefficients.\n    Sum = C(n, 0)*C(n, 1) + ... + C(n, n-1)*C(n, n).\n    \"\"\"\n    if n == 0:\n        return 0\n\n    total_sum = 0\n    for k in range(n):\n        term1 = binomial_coefficient(n, k)\n        term2 = binomial_coefficient(n, k + 1)\n        total_sum += term1 * term2\n    \n    return total_sum"}
{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip_address_str: str) -> str:\n    parts = ip_address_str.split('.')\n    if len(parts) != 4:\n        return ip_address_str\n\n    formatted_parts = []\n    for part in parts:\n        try:\n            # Convert to int to remove leading zeros, then back to string\n            # This also handles cases like \"0\" -> \"0\"\n            int_part = int(part)\n            if not (0 <= int_part <= 255):\n                return ip_address_str # Octet out of range\n            formatted_parts.append(str(int_part))\n        except ValueError:\n            return ip_address_str # Non-numeric part\n\n    return \".\".join(formatted_parts)"}
{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip_address: str) -> str:\n    # Splits the IP address into octets and removes leading zeros from each.\n    # It converts each octet to an integer and then back to a string.\n    octets = ip_address.split('.')\n    normalized_octets = [str(int(octet_str)) for octet_str in octets]\n    return \".\".join(normalized_octets)"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers):\n    \"\"\"\n    Calculates the absolute difference between the first encountered even and first encountered odd number in a list.\n    Assumes the list contains numbers and both even and odd numbers will be present.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if num % 2 == 0:\n            if first_even is None:\n                first_even = num\n        else:\n            if first_odd is None:\n                first_odd = num\n        \n        if first_even is not None and first_odd is not None:\n            break\n\n    return abs(int(first_even - first_odd))"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the first even and first odd number, then returns their absolute difference.\n    This function assumes the input list always contains at least one even and one odd number.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        \n        if first_even is not None and first_odd is not None:\n            break\n\n    return abs(first_even - first_odd)"}
