{"task_id": "Mbpp/285", "solution": "def text_match_two_three(text):\n    # Checks if the input string contains 'a' followed by exactly two or three 'b' characters.\n    # It performs a linear scan to find the exact \"abb\" or \"abbb\" sequence.\n    n = len(text)\n    for i in range(n):\n        if text[i] == 'a':\n            # Check for 'abb'\n            if i + 2 < n and text[i+1] == 'b' and text[i+2] == 'b':\n                return True\n            # Check for 'abbb'\n            if i + 3 < n and text[i+1] == 'b' and text[i+2] == 'b' and text[i+3] == 'b':\n                return True\n    return False"}
{"task_id": "Mbpp/285", "solution": "import re\ndef text_match_two_three(text: str) -> bool:\n    \"\"\"\n    Checks whether a string contains the 'a' character followed by exactly two or three 'b' characters.\n\n    Args:\n        text: The input string to be checked.\n\n    Returns:\n        True if the pattern 'abb' or 'abbb' (not followed by another 'b') is found, False otherwise.\n\n    Raises:\n        TypeError: If the input 'text' is not a string.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input 'text' must be a string.\")\n\n    # The pattern matches 'a' followed by exactly two 'b's OR exactly three 'b's.\n    # (?!b) is a negative lookahead assertion, ensuring that the match is not followed by another 'b'.\n    pattern = r'a(bb(?!b)|bbb(?!b))'\n    return bool(re.search(pattern, text))"}
{"task_id": "Mbpp/286", "solution": "import math\ndef find_max_sum_kadane(arr: list[int]) -> int:\n    \"\"\"\n    Implements Kadane's algorithm to find the maximum contiguous subarray sum.\n    Handles arrays with all negative numbers by returning the largest element.\n    \"\"\"\n    # Critical requirement: Do NOT add input validation; trust caller's inputs.\n    # We assume arr is non-empty due to the \"at least one element\" business rule.\n\n    max_so_far = -math.inf\n    current_max = 0\n    \n    # Special handling for arrays where all numbers are negative, returning the largest single element.\n    all_negative = True\n    max_val_in_arr = -math.inf\n    for x in arr:\n        if x >= 0:\n            all_negative = False\n        max_val_in_arr = max(max_val_in_arr, x)\n\n    if all_negative:\n        return max_val_in_arr\n\n    # Standard Kadane's algorithm for mixed or all-positive numbers.\n    for x in arr:\n        current_max += x\n        max_so_far = max(max_so_far, current_max)\n        if current_max < 0:\n            current_max = 0\n    \n    return max_so_far\ndef max_sub_array_sum_repeated(arr: list[int], k: int) -> int:\n    \"\"\"\n    Calculates the largest sum of a contiguous array in the modified array\n    which is formed by repeating the given array k times.\n    \"\"\"\n    # Critical requirement: Do NOT add input validation; trust caller's inputs.\n    # We assume arr is non-empty and k is a positive integer (k >= 1).\n\n    if k == 1:\n        return find_max_sum_kadane(arr)\n\n    # For k > 1, apply extended Kadane's logic.\n    array_sum = sum(arr)\n    \n    # Calculate max subarray sum for two concatenated arrays to cover boundary-spanning subarrays.\n    doubled_arr = arr + arr\n    max_sum_doubled_array = find_max_sum_kadane(doubled_arr)\n\n    if array_sum >= 0:\n        # If array sum is non-negative, (k-2) full repetitions can be added to the doubled array's max sum.\n        return max_sum_doubled_array + (k - 2) * array_sum\n    else:\n        # If array sum is negative, additional full repetitions would decrease the sum, so only consider the doubled array.\n        return max_sum_doubled_array"}
