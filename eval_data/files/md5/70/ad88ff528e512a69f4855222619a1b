{"task_id": "Mbpp/440", "solution": "import string\nimport re\nfrom typing import Optional, Tuple\nPUNCTUATION_CHARS = string.punctuation\ndef clean_word(word: str) -> str:\n    \"\"\"Removes leading and trailing punctuation from a word.\"\"\"\n    return word.strip(PUNCTUATION_CHARS)\nCOMMON_ADVERBS = [\n    \"clearly\", \"quickly\", \"slowly\", \"happily\", \"sadly\", \"always\", \"never\",\n    \"often\", \"rarely\", \"usually\", \"sometimes\", \"very\", \"really\", \"quite\",\n    \"almost\", \"just\", \"even\", \"back\", \"away\", \"down\", \"up\", \"here\", \"there\",\n    \"everywhere\", \"somewhere\", \"now\", \"then\", \"today\", \"tomorrow\", \"yesterday\",\n    \"soon\", \"late\", \"early\", \"ago\", \"yet\", \"still\", \"already\", \"finally\",\n    \"first\", \"second\", \"third\", \"once\", \"twice\", \"thrice\", \"again\", \"also\",\n    \"too\", \"either\", \"neither\", \"however\", \"therefore\", \"thus\", \"consequently\",\n    \"meanwhile\", \"otherwise\", \"instead\", \"rather\", \"indeed\", \"perhaps\",\n    \"probably\", \"possibly\", \"certainly\", \"definitely\", \"absolutely\", \"hardly\",\n    \"scarcely\", \"barely\", \"nearly\", \"almost\", \"only\", \"merely\", \"simply\",\n    \"exactly\", \"precisely\", \"approximately\", \"roughly\", \"generally\", \"usually\",\n    \"normally\", \"frequently\", \"seldom\", \"rarely\", \"hard\", \"fast\", \"well\",\n    \"badly\", \"loudly\", \"softly\", \"beautifully\", \"carefully\", \"easily\",\n    \"quickly\", \"slowly\", \"angrily\", \"bravely\", \"calmly\", \"eagerly\", \"fairly\",\n    \"foolishly\", \"gently\", \"greedily\", \"hastily\", \"honestly\", \"kindly\",\n    \"lazily\", \"loudly\", \"merrily\", \"neatly\", \"nervously\", \"patiently\",\n    \"politely\", \"promptly\", \"quietly\", \"rapidly\", \"regularly\", \"rudely\",\n    \"safely\", \"secretly\", \"seriously\", \"silently\", \"sincerely\", \"smoothly\",\n    \"softly\", \"sternly\", \"suddenly\", \"swiftly\", \"tenderly\", \"thoughtfully\",\n    \"tightly\", \"truthfully\", \"unexpectedly\", \"urgently\", \"warmly\", \"wearily\",\n    \"wildly\", \"wisely\", \"wonderfully\", \"yearly\", \"daily\", \"weekly\", \"monthly\"\n]\ndef find_adverb_position(sentence: str) -> Optional[Tuple[int, int, str]]:\n    \"\"\"\n    Finds the first adverb and its position in a given sentence.\n    Returns (start_index, end_index, adverb_word) or None.\n    \"\"\"\n    words_and_spaces = re.split(r'(\\s+)', sentence)\n    current_index = 0\n\n    for part in words_and_spaces:\n        if not part.strip(): # Skip pure whitespace parts or parts that become empty after stripping\n            current_index += len(part)\n            continue\n\n        original_stripped_word = clean_word(part)\n        \n        if original_stripped_word.lower() in COMMON_ADVERBS:\n            # Find the position of the stripped word within its original 'part' token\n            offset_within_part = part.find(original_stripped_word)\n            \n            if offset_within_part != -1: # Ensure the stripped word was found within the part\n                start_index = current_index + offset_within_part\n                end_index = start_index + len(original_stripped_word)\n                return (start_index, end_index, original_stripped_word.lower())\n        \n        current_index += len(part)\n            \n    return None"}
