{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary_string: str, rotations: int) -> int:\n    \"\"\"Calculates the count of odd decimal numbers from binary string rotations.\n    It rotates the string `rotations` times and checks each resulting decimal value.\n    \"\"\"\n    odd_count = 0\n    current_string = binary_string\n\n    for _ in range(rotations):\n        # Convert the current binary string to its decimal equivalent.\n        decimal_value = int(current_string, 2)\n\n        # Check if the decimal value is odd and increment count if true.\n        if decimal_value % 2 != 0:\n            odd_count += 1\n\n        # Perform a single left rotation on the string for the next iteration.\n        current_string = current_string[1:] + current_string[0]\n    \n    return odd_count"}
{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary_string: str, rotations: int) -> int:\n    \"\"\"\n    Calculates the number of odd decimal equivalents when rotating a binary string.\n\n    Args:\n        binary_string: A string consisting only of '0's and '1's.\n        rotations: The number of left rotations to perform and check.\n\n    Returns:\n        The count of odd numbers found.\n\n    Raises:\n        ValueError: If binary_string is not a valid binary string or rotations is negative.\n    \"\"\"\n    if not isinstance(binary_string, str) or not all(c in '01' for c in binary_string):\n        raise ValueError(\"binary_string must be a string containing only '0's and '1's.\")\n    if not binary_string:\n        return 0\n    if not isinstance(rotations, int) or rotations < 0:\n        raise ValueError(\"rotations must be a non-negative integer.\")\n\n    odd_count = 0\n    len_binary_string = len(binary_string)\n\n    for i in range(rotations):\n        # Inlined logic for _rotate_string\n        n = i % len_binary_string\n        rotated_str = binary_string[n:] + binary_string[:n]\n\n        decimal_value = int(rotated_str, 2)\n        # Inlined logic for _is_odd\n        if decimal_value % 2 != 0:\n            odd_count += 1\n\n    return odd_count"}
{"task_id": "Mbpp/111", "solution": "from typing import Any, List\ndef common_in_nested_lists(nested_lists: List[List[Any]]) -> List[Any]:\n    \"\"\"\n    Finds elements common to all inner lists in a list of lists.\n    Returns a sorted list of these common elements.\n    \"\"\"\n    if not nested_lists:\n        return []\n\n    common_set = set(nested_lists[0])\n\n    for sublist in nested_lists[1:]:\n        common_set.intersection_update(set(sublist))\n\n    return sorted(list(common_set))"}
{"task_id": "Mbpp/111", "solution": "from typing import Any\ndef common_in_nested_lists(nested_lists: list[list[Any]]) -> set[Any]:\n    \"\"\"\n    Identifies elements present in every sublist within a given nested list.\n    Leverages set intersections for efficient finding of commonalities.\n    \"\"\"\n    if not nested_lists:\n        return set()\n\n    common_elements = set(nested_lists[0])\n\n    for sublist in nested_lists[1:]:\n        common_elements = common_elements.intersection(set(sublist))\n        if not common_elements:\n            break\n\n    return common_elements"}
{"task_id": "Mbpp/113", "solution": "def check_integer(input_string: str) -> bool:\n    \"\"\"Checks if a string represents an integer, adhering to strict formatting rules.\n    It handles optional signs and ensures all other characters are digits.\"\"\"\n    \n    # FR8: The check_integer function shall return False for strings with leading or trailing whitespace.\n    # This also acts as an implicit check for empty strings before accessing characters.\n    if input_string != input_string.strip():\n        return False\n\n    # FR6: The check_integer function shall return False for empty strings (\"\").\n    if not input_string:\n        return False\n\n    start_index = 0\n    # BR1: An integer string must consist only of an optional leading sign ('-' or '+')\n    if input_string[0] == '-' or input_string[0] == '+':\n        start_index = 1\n        # If only a sign is present (e.g., \"-\", \"+\"), it's not a valid integer.\n        # This handles cases like `check_integer(\"-\")` -> False.\n        if len(input_string) == 1:\n            return False\n\n    # The rest of the string must contain only digits.\n    # This covers FR5 (non-digit characters), FR7 (floating-point numbers),\n    # and ensures there's at least one digit following the optional sign (or at the start).\n    return input_string[start_index:].isdigit()"}
