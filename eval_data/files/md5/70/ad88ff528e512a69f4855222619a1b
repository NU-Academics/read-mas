{"task_id": "Mbpp/84", "solution": "class NewmanConwaySequenceCalculator:\n    \"\"\"Calculates Newman-Conway numbers with memoization.\"\"\"\n    def __init__(self):\n        \"\"\"Initializes the cache with base sequence values.\"\"\"\n        self._memoization_cache = {1: 1, 2: 1}\n\n    def calculate(self, n: int) -> int:\n        \"\"\"Retrieves the nth Newman-Conway number.\"\"\"\n        return self._get_or_calculate(n)\n\n    def _get_or_calculate(self, n: int) -> int:\n        \"\"\"Recursively calculates and caches the nth Newman-Conway number.\"\"\"\n        if n not in self._memoization_cache:\n            p_n_minus_1 = self._get_or_calculate(n - 1)\n            p_n_minus_p_n_minus_1 = self._get_or_calculate(n - p_n_minus_1)\n            self._memoization_cache[n] = p_n_minus_1 + p_n_minus_p_n_minus_1\n        return self._memoization_cache[n]\n_calculator_instance = NewmanConwaySequenceCalculator()\ndef sequence(n: int) -> int:\n    \"\"\"\n    Calculates the nth Newman-Conway number.\n    Uses a memoized calculator instance for efficiency.\n    \"\"\"\n    return _calculator_instance.calculate(n)"}
