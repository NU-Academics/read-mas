{"task_id": "Mbpp/767", "solution": "from collections import Counter\ndef get_pairs_count(numbers: list[int], sum: int) -> int:\n    \"\"\"Counts pairs in a list that sum to a target value.\n\n    This function finds all unique pairs by index whose elements sum up to the given target.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input 'numbers' must be a list.\")\n    if not all(isinstance(n, int) for n in numbers):\n        raise TypeError(\"All elements in 'numbers' must be integers.\")\n    if not isinstance(sum, int):\n        raise TypeError(\"Input 'sum' must be an integer.\")\n\n    if not numbers:\n        return 0\n\n    num_counts = Counter(numbers)\n    pair_count = 0\n\n    for num in numbers:\n        # Decrement count for current 'num' to avoid pairing with itself\n        # if num == complement, and to correctly count distinct pairs.\n        num_counts[num] -= 1\n\n        complement = sum - num\n\n        if complement in num_counts and num_counts[complement] > 0:\n            pair_count += num_counts[complement]\n    \n    return pair_count"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(arr: list[int], target_sum: int) -> int:\n    \"\"\"\n    Counts pairs in a list whose sum equals 'target_sum', counting each pair uniquely by index.\n    This function uses a hash map for efficient O(N) performance.\n    \"\"\"\n    count = 0\n    num_counts = {}\n\n    for num in arr:\n        complement = target_sum - num\n        if complement in num_counts:\n            count += num_counts[complement]\n        num_counts[num] = num_counts.get(num, 0) + 1\n    return count"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1: list, list2: list) -> list:\n    \"\"\"\n    Calculates the difference between two lists, returning elements present in list1\n    but not in list2, while preserving the order of elements from list1.\n    Returns a new list with the difference.\n    \"\"\"\n    set2 = set(list2)\n    result = []\n    for item in list1:\n        if item not in set2:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1, list2):\n    \"\"\"Calculates the difference between two lists.\n    Returns elements present in list1 but not in list2, preserving their original order from list1.\n    \"\"\"\n    set2 = set(list2)\n    result = [item for item in list1 if item not in set2]\n    return result"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"Calculates the sum of the fourth power of the first n odd natural numbers.\n    Assumes n is a positive integer.\n    \"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        odd_number = 2 * i - 1\n        total_sum += odd_number ** 4\n    return total_sum"}
