{"task_id": "Mbpp/777", "solution": "def find_sum(lst):\n    \"\"\"\n    Calculates the sum of distinct elements in a given list.\n    \"\"\"\n    unique_elements = set(lst)\n    return sum(unique_elements)"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(items):\n    \"\"\"\n    Packs consecutive duplicate elements of a list into sublists.\n    The order of elements and sublists is preserved.\n    \"\"\"\n    if not items:\n        return []\n\n    result = []\n    current_pack = [items[0]]\n\n    for item in items[1:]:\n        if item == current_pack[-1]:\n            current_pack.append(item)\n        else:\n            result.append(current_pack)\n            current_pack = [item]\n\n    result.append(current_pack)\n    return result"}
{"task_id": "Mbpp/780", "solution": "def find_combinations(items: list[tuple[int, int]]) -> list[tuple[int, int]]:\n    \"\"\"\n    Finds all unique pairwise combinations of sums for tuples in the given list.\n    \"\"\"\n    n = len(items)\n    results: list[tuple[int, int]] = []\n    for i in range(n):\n        for j in range(i + 1, n):\n            sum_first = items[i][0] + items[j][0]\n            sum_second = items[i][1] + items[j][1]\n            results.append((sum_first, sum_second))\n    return results"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of all odd-length subarrays using an O(n) combinatorial approach.\n    For each element, count how many odd-length subarrays it belongs to.\n    \"\"\"\n    n = len(arr)\n    total_sum = 0\n    for i, val in enumerate(arr):\n        # Number of choices for the start of a subarray ending at or before i\n        left_count = i + 1\n        # Number of choices for the end of a subarray starting at or after i\n        right_count = n - i\n\n        # Total number of subarrays containing arr[i]\n        total_subarrays_containing_val = left_count * right_count\n        \n        # Number of odd-length subarrays containing arr[i]\n        # (k + 1) // 2 gives the count of odd numbers up to k\n        odd_length_subarrays_containing_val = (total_subarrays_containing_val + 1) // 2\n        \n        total_sum += val * odd_length_subarrays_containing_val\n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "from typing import List, Optional\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input scenarios.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\ndef mul_even_odd(numbers: List[int]) -> int:\n    \"\"\"\n    Finds the product of the first even and odd number in a list.\n    Raises InvalidInputError if input is invalid.\n    \"\"\"\n    first_odd: Optional[int] = None\n    first_even: Optional[int] = None\n\n    for n in numbers:\n        if not isinstance(n, int):\n            raise InvalidInputError(\"All elements must be integers.\")\n\n        if first_odd is None and n % 2 != 0:\n            first_odd = n\n        \n        if first_even is None and n % 2 == 0:\n            first_even = n\n        \n        if first_odd is not None and first_even is not None:\n            return first_odd * first_even\n    \n    raise InvalidInputError(\"Input must contain at least one odd and one even number.\")"}
{"task_id": "Mbpp/781", "solution": "import math\n\ndef count_divisors(n: int) -> bool:\n    \"\"\"Checks if the count of divisors for n is even.\n    A number has an even count of divisors if it is not a perfect square.\"\"\"\n    \n    sqrt_n = int(math.sqrt(n))\n    is_perfect_square = (sqrt_n * sqrt_n == n)\n    \n    # The count of divisors is even if the number is NOT a perfect square.\n    return not is_perfect_square"}
{"task_id": "Mbpp/785", "solution": "from typing import List, Tuple\n\nclass ParseError(Exception):\n    \"\"\"Exception raised for semantic or syntax parsing errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for input validation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass TupleValue:\n    \"\"\"Immutable DTO representing parsed tuple values.\"\"\"\n    def __init__(self, values: Tuple[int, ...]) -> None:\n        self._values = values\n\n    def as_tuple(self) -> Tuple[int, ...]:\n        return self._values\n\nclass Tokenizer:\n    \"\"\"Converts a raw string into a sequence of tokens.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def tokenize(self, s: str) -> List[str]:\n        tokens: List[str] = []\n        i = 0\n        while i < len(s):\n            ch = s[i]\n            if ch.isspace():\n                i += 1\n                continue\n            if ch in \"(),\":\n                tokens.append(ch)\n                i += 1\n                continue\n            # number (optional leading + or -)\n            if ch in \"+-\" or ch.isdigit():\n                j = i + 1\n                while j < len(s) and s[j].isdigit():\n                    j += 1\n                tokens.append(s[i:j])\n                i = j\n                continue\n            raise ParseError(f\"Invalid character '{ch}' at position {i}\")\n        return tokens\n\nclass Parser:\n    \"\"\"Validates token sequence and constructs a TupleValue.\"\"\"\n    def __init__(self, tokenizer: Tokenizer = None) -> None:\n        self._tokenizer = tokenizer or Tokenizer()\n\n    def parse(self, s: str) -> TupleValue:\n        if not isinstance(s, str):\n            raise ValidationError(\"Input must be a string\")\n        s_stripped = s.strip()\n        if not s_stripped:\n            raise ValidationError(\"Empty input\")\n\n        if not s_stripped.startswith('(') or not s_stripped.endswith(')'):\n            raise ParseError(\"Tuple string must start with '(' and end with ')'\")\n\n        tokens = self._tokenizer.tokenize(s_stripped)\n\n        if len(tokens) == 2 and tokens[0] == '(' and tokens[1] == ')':\n            return TupleValue(tuple())\n\n        inner_tokens = tokens[1:-1]\n        values: List[int] = []\n        expect_value = True\n\n        for i, token in enumerate(inner_tokens):\n            if expect_value:\n                if token == ',':\n                    raise ParseError(f\"Unexpected comma at position {i} in inner tokens.\")\n                try:\n                    values.append(int(token))\n                except ValueError:\n                    raise ValidationError(f\"Invalid integer token: '{token}'\")\n                expect_value = False\n            else: # Expecting a comma\n                if token != ',':\n                    raise ParseError(f\"Expected comma but found '{token}' at position {i} in inner tokens.\")\n                expect_value = True\n\n        if expect_value: # Last token was a comma, expecting a value\n            if len(values) == 1:\n                # This is a valid trailing comma for a singleton tuple like \"(7,)\"\n                pass\n            elif len(values) > 1:\n                raise ParseError(\"Trailing comma not allowed for multi-item tuples\")\n            else:\n                # Should not reach here if `inner_tokens` was processed and `expect_value` is True\n                raise ParseError(\"Unexpected trailing comma in an empty context.\")\n\n        return TupleValue(tuple(values))\n\nclass TupleService:\n    \"\"\"Provides the public API for tuple string to integer tuple conversion.\"\"\"\n    def __init__(self, parser: Parser = None) -> None:\n        self._parser = parser or Parser()\n\n    def tuple_str_int(self, s: str) -> Tuple[int, ...]:\n        tv = self._parser.parse(s)\n        return tv.as_tuple()\n\n_default_service = TupleService()\n\ndef tuple_str_int(s: str) -> Tuple[int, ...]:\n    \"\"\"Converts a string representation of an integer tuple to a Python tuple of integers.\"\"\"\n    return _default_service.tuple_str_int(s)"}
{"task_id": "Mbpp/787", "solution": "import re\nfrom typing import Optional, Tuple, Any\n\n# Configuration values\n_PATTERN: str = r\"ab{3}\"\n_FULL_MATCH: bool = False\n\nclass _MatchResult:\n    \"\"\"Stores the result of a regex match operation.\"\"\"\n    def __init__(self, matched: bool, matched_text: Optional[str], span: Optional[Tuple[int,int]]) -> None:\n        self.matched = matched\n        self.matched_text = matched_text\n        self.span = span\n\n    def to_bool(self) -> bool:\n        \"\"\"Returns the boolean status of the match.\"\"\"\n        return self.matched\n\ndef _validate_text(text: Any) -> str:\n    \"\"\"Validates if the input is a string.\"\"\"\n    if not isinstance(text, str):\n        raise ValueError(\"text must be a str\")\n    return text\n\nclass _PatternRepository:\n    \"\"\"Manages the compilation and caching of a regex pattern.\"\"\"\n    def __init__(self, pattern_str: str, flags: int = 0) -> None:\n        self._pattern_str = pattern_str\n        self._flags = flags\n        self._compiled: Optional[re.Pattern] = None\n\n    def get_compiled_pattern(self) -> re.Pattern:\n        \"\"\"Retrieves the compiled regex pattern, compiling if not yet done.\"\"\"\n        if self._compiled is None:\n            try:\n                self._compiled = re.compile(self._pattern_str, self._flags)\n            except re.error as e:\n                raise RuntimeError(f\"Invalid regex: {e}\") from e\n        return self._compiled\n\n    def refresh(self, pattern_str: Optional[str] = None) -> None:\n        \"\"\"Updates the pattern string and forces recompilation.\"\"\"\n        if pattern_str:\n            self._pattern_str = pattern_str\n        self._compiled = None\n\nclass _TextMatcherService:\n    \"\"\"Handles the core logic for matching text against a pattern.\"\"\"\n    def __init__(self, pattern_repo: _PatternRepository) -> None:\n        self._pattern_repo = pattern_repo\n\n    def match_text(self, text: str) -> _MatchResult:\n        \"\"\"Performs the regex search on the given text.\"\"\"\n        validated = _validate_text(text)\n        pattern = self._pattern_repo.get_compiled_pattern()\n        \n        m = pattern.fullmatch(validated) if _FULL_MATCH else pattern.search(validated)\n        \n        return _MatchResult(bool(m), m.group(0) if m else None, m.span() if m else None)\n\n    def matches(self, text: str) -> bool:\n        \"\"\"Returns True if the text matches the pattern, False otherwise.\"\"\"\n        return self.match_text(text).to_bool()\n\ndef text_match_three(text: str) -> bool:\n    \"\"\"\n    Checks if a string contains 'a' followed immediately by three 'b' characters.\n    For example, \"abbb\" or \"xabbbz\" would return True.\n    \"\"\"\n    repo = _PatternRepository(_PATTERN)\n    service = _TextMatcherService(repo)\n    return service.matches(text)"}
{"task_id": "Mbpp/786", "solution": "from typing import Sequence, Iterable\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation errors.\"\"\"\n\nclass ListValidator:\n    \"\"\"Validates an iterable and converts it to a sequence if necessary.\"\"\"\n    def validate(self, seq: Iterable) -> Sequence:\n        if hasattr(seq, \"__len__\") and hasattr(seq, \"__getitem__\"):\n            return seq\n        try:\n            return list(seq)\n        except Exception as e:\n            raise ValidationError(f\"Cannot convert sequence: {e}\")\n\nclass RightInsertionService:\n    \"\"\"Provides the algorithm to find the right insertion point.\"\"\"\n    def __init__(self, repository=None, validator=None):\n        self.repository = repository\n        self.validator = validator\n\n    def find_right_insertion(self, sequence: Sequence | Iterable, value: float | int) -> int:\n        if self.validator:\n            seq = self.validator.validate(sequence)\n        else:\n            seq = sequence\n\n        try:\n            if hasattr(seq, \"__len__\") and hasattr(seq, \"__getitem__\"):\n                idx = self._bisect_right_list(seq, value)\n            else:\n                idx = self._bisect_right_iterable(seq, value)\n        except TypeError as e:\n            raise ValidationError(str(e))\n        \n        # Persistence logic is omitted as the default service will have repository=None.\n        return idx\n\n    def _bisect_right_list(self, seq: Sequence, value: float | int) -> int:\n        \"\"\"Performs binary search for the right insertion point in a sequence.\"\"\"\n        left, right = 0, len(seq)\n        while left < right:\n            mid = (left + right) // 2\n            if seq[mid] <= value:\n                left = mid + 1\n            else:\n                right = mid\n        return left\n\n    def _bisect_right_iterable(self, iterable: Iterable, value: float | int) -> int:\n        \"\"\"Performs a linear scan for the right insertion point in an iterable.\"\"\"\n        count = 0\n        for item in iterable:\n            if item <= value:\n                count += 1\n        return count\n\n_default_service = RightInsertionService(repository=None, validator=ListValidator())\n\ndef right_insertion(sequence: Sequence[float | int] | Iterable[float | int], value: float | int) -> int:\n    \"\"\"\n    Finds the right insertion point for a value in a sorted sequence.\n    It determines the index where the value should be inserted to maintain sorted order,\n    placing it after any existing equal elements.\n    \"\"\"\n    return _default_service.find_right_insertion(sequence, value)"}
{"task_id": "Mbpp/790", "solution": "def even_position(lst: list[int]) -> bool:\n    \"\"\"\n    Checks if every even index in the list contains an even number.\n    Assumes the input list contains only integers.\n    \"\"\"\n    for i in range(0, len(lst), 2):\n        # Check if the current index 'i' (which is always even) contains an odd number\n        if lst[i] % 2 != 0:\n            return False\n    return True"}
{"task_id": "Mbpp/788", "solution": "class TupleBuilderError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass InputValidationError(TupleBuilderError):\n    def __init__(self, message: str, code: str = \"INVALID_INPUT\") -> None:\n        super().__init__(message)\n        self.code = code\n\nclass InputValidator:\n    MAX_LIST_LENGTH = 10_000\n\n    def validate_list(self, list_input: object) -> None:\n        if not isinstance(list_input, (list, tuple)):\n            raise InputValidationError(\"list_input must be a list or tuple\")\n        if len(list_input) > self.MAX_LIST_LENGTH:\n            raise InputValidationError(\"list_input too large\")\n        for i, item in enumerate(list_input):\n            if not isinstance(item, str):\n                raise InputValidationError(f\"list_input[{i}] must be a string\")\n\n    def validate_element(self, element: object) -> None:\n        if not isinstance(element, str):\n            raise InputValidationError(\"element must be a string\")\n\n    def validate_request(self, req) -> None:\n        self.validate_list(req.list_input)\n        self.validate_element(req.element)\n\nclass TupleFactory:\n    def build(self, list_input: list[str], element: str) -> tuple[str, ...]:\n        return tuple(list_input) + (element,)\n\nclass TupleService:\n    def __init__(self, validator: InputValidator, factory: TupleFactory) -> None:\n        self._validator = validator\n        self._factory = factory\n\n    def create_tuple(self, list_input: list[str], element: str) -> tuple[str, ...]:\n        self._validator.validate_list(list_input)\n        self._validator.validate_element(element)\n        return self._factory.build(list_input, element)\n\n    def create_from_request(self, req) -> tuple[str, ...]:\n        self._validator.validate_request(req)\n        return self._factory.build(req.list_input, req.element)\n\nclass NewTupleRequest:\n    def __init__(self, list_input: list[str], element: str) -> None:\n        self.list_input = list_input\n        self.element = element\n\n    def as_tuple(self) -> tuple[str, ...]:\n        return tuple(self.list_input) + (self.element,)\n\nclass TupleController:\n    def __init__(self, service: TupleService) -> None:\n        self._service = service\n\n    def create_tuple(self, req: NewTupleRequest) -> tuple[str, ...]:\n        return self._service.create_from_request(req)\n\n_validator = InputValidator()\n_factory = TupleFactory()\n_service = TupleService(_validator, _factory)\n_controller = TupleController(_service)\n\ndef new_tuple(list_input: list[str], element: str) -> tuple[str, ...]:\n    \"\"\"\n    Creates a new tuple from a list of strings and an additional string.\n    This function delegates to a robust service layer for validation and construction.\n    \"\"\"\n    req = NewTupleRequest(list_input, element)\n    return _controller.create_tuple(req)"}
