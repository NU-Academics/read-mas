{"task_id": "Mbpp/462", "solution": "from typing import List, Any\n\ndef combinations_list(items: List[Any]) -> List[List[Any]]:\n    \"\"\"\n    Generates all possible combinations (power set) of the elements in the input list\n    in a deterministic order, including the empty list.\n    \"\"\"\n    result: List[List[Any]] = [[]]\n    for item in items:\n        # For each item, create new combinations by prepending it to all existing combinations.\n        new_subsets = [[item] + subset for subset in result]\n        # Extend the result list with these newly formed combinations.\n        result.extend(new_subsets)\n    return result"}
{"task_id": "Mbpp/465", "solution": "from typing import Any\n\ndef drop_empty(\n    d: dict,\n    *,\n    remove_none: bool = True,\n    remove_blank_str: bool = True,\n    remove_collections: bool = True,\n    treat_whitespace_as_empty: bool = False,\n    shallow: bool = True,\n) -> dict:\n    \"\"\"Removes items with empty values from a dictionary, optionally including nested dictionaries.\n    Empty values are determined by the configuration parameters provided.\"\"\"\n\n    def _is_empty_value(v: Any) -> bool:\n        \"\"\"Helper to determine if a value is considered empty based on the function's configuration.\"\"\"\n        if v is None and remove_none:\n            return True\n        if isinstance(v, str):\n            if remove_blank_str and v == \"\":\n                return True\n            if treat_whitespace_as_empty and v.strip() == \"\":\n                return True\n        if remove_collections and isinstance(v, (list, tuple, set, dict)) and len(v) == 0:\n            return True\n        return False\n\n    result = {}\n    for k, v in d.items():\n        if not shallow and isinstance(v, dict):\n            # Recursively clean nested dictionary with the same configuration\n            cleaned_nested_dict = drop_empty(\n                v,\n                remove_none=remove_none,\n                remove_blank_str=remove_blank_str,\n                remove_collections=remove_collections,\n                treat_whitespace_as_empty=treat_whitespace_as_empty,\n                shallow=shallow,\n            )\n            # If the recursively cleaned dict itself becomes empty, drop it from the current level\n            if _is_empty_value(cleaned_nested_dict):\n                continue\n            else:\n                result[k] = cleaned_nested_dict\n        else:\n            # For non-dict values or if shallow mode is active, check the current value\n            if _is_empty_value(v):\n                continue\n            else:\n                result[k] = v\n    return result"}
{"task_id": "Mbpp/471", "solution": "import math\n\ndef find_remainder(values, modulus):\n    \"\"\"\n    Computes the product of a list of integers modulo n.\n    Uses iterative modular multiplication to prevent overflow.\n    \"\"\"\n    result = 1 % modulus\n    for v in values:\n        result = (result * (v % modulus)) % modulus\n    return result"}
{"task_id": "Mbpp/463", "solution": "from typing import List\n\ndef max_subarray_product(arr: List[int]) -> int:\n    \"\"\"\n    Finds the maximum product of a contiguous subarray within the given array.\n    Handles positive, negative, and zero elements efficiently.\n    \"\"\"\n    if not arr:\n        return 0\n\n    current_max_prod = arr[0]\n    current_min_prod = arr[0]\n    max_overall_prod = arr[0]\n\n    for i in range(1, len(arr)):\n        val = arr[i]\n\n        # If current number is negative, swap max_so_far and min_so_far\n        # because a negative number multiplied by a large negative can be a large positive.\n        if val < 0:\n            current_max_prod, current_min_prod = current_min_prod, current_max_prod\n\n        # Update current maximum and minimum product ending at the current position\n        current_max_prod = max(val, current_max_prod * val)\n        current_min_prod = min(val, current_min_prod * val)\n\n        # Update the overall maximum product found so far\n        max_overall_prod = max(max_overall_prod, current_max_prod)\n\n    return max_overall_prod"}
{"task_id": "Mbpp/470", "solution": "from typing import Tuple\n\ndef add_pairwise(values: Tuple[int, ...]) -> Tuple[int, ...]:\n    \"\"\"Calculates the sum of neighboring elements in the input tuple.\n    The result is a new tuple with (len(values) - 1) elements.\"\"\"\n    return tuple(values[i] + values[i+1] for i in range(len(values) - 1))"}
{"task_id": "Mbpp/468", "solution": "from typing import List, Optional\n\n# Assume SequenceResult is imported from max_inc_product.models as per design context.\n# For a self-contained single-file example (as implied by \"COMPLETE function definition\"\n# without explicit module setup), SequenceResult would need to be defined here if not in stdlib.\n# Given the full design context, it's a DTO.\n# Defining it here to make the snippet runnable if no external module is provided.\nclass SequenceResult:\n    \"\"\"\n    Data transfer object for the result of the maximum product subsequence computation.\n    \"\"\"\n    def __init__(self, product: int, subsequence: List[int]):\n        self.product = product\n        self.subsequence = subsequence\n\ndef max_product(arr: List[int]) -> SequenceResult:\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of an increasing subsequence of the array.\n    \"\"\"\n    if not arr:\n        return SequenceResult(0, [])\n\n    n = len(arr)\n    max_prod = arr.copy()  # Max product of an increasing subsequence ending at index i\n    min_prod = arr.copy()  # Min product of an increasing subsequence ending at index i (for handling negatives)\n    pred_max = [None] * n  # Predecessor index for the path leading to max_prod[i]\n    pred_min = [None] * n  # Predecessor index for the path leading to min_prod[i]\n\n    best_idx = 0  # Index that holds the overall maximum product found so far\n\n    for i in range(n):\n        for j in range(i):\n            if arr[j] < arr[i]:  # Check for strictly increasing subsequence\n                # Candidates for extending existing subsequences ending at j with arr[i]\n                cand1 = max_prod[j] * arr[i]\n                cand2 = min_prod[j] * arr[i]\n\n                # Update max_prod[i] if a better product is found\n                if cand1 > max_prod[i]:\n                    max_prod[i] = cand1\n                    pred_max[i] = j\n                if cand2 > max_prod[i]:\n                    max_prod[i] = cand2\n                    pred_max[i] = j\n\n                # Update min_prod[i] if a smaller product is found\n                if cand1 < min_prod[i]:\n                    min_prod[i] = cand1\n                    pred_min[i] = j\n                if cand2 < min_prod[i]:\n                    min_prod[i] = cand2\n                    pred_min[i] = j\n        \n        # After evaluating all predecessors for current index i, check if max_prod[i] is the overall best\n        if max_prod[i] > max_prod[best_idx]:\n            best_idx = i\n\n    # Helper function to reconstruct the subsequence from predecessor array\n    def _reconstruct_subsequence(pred_indices: List[Optional[int]], start_idx: int, source_arr: List[int]) -> List[int]:\n        subsequence = []\n        current_idx = start_idx\n        while current_idx is not None:\n            subsequence.append(source_arr[current_idx])\n            current_idx = pred_indices[current_idx]\n        return subsequence[::-1] # Reverse to get the elements in increasing order\n\n    subsequence = _reconstruct_subsequence(pred_max, best_idx, arr)\n    \n    return SequenceResult(max_prod[best_idx], subsequence)"}
{"task_id": "Mbpp/473", "solution": "from typing import Iterable, Tuple, Any, Set\n\ndef tuple_intersection(list1: Iterable[Any], list2: Iterable[Any]) -> Set[Tuple[Any, ...]]:\n    \"\"\"\n    Finds the intersection of elements in two lists of tuple-like items, ignoring element order within tuples.\n    Returns a set of canonical (sorted) tuples representing the intersection.\n    \"\"\"\n\n    def _get_canonical_set(input_iterable: Iterable[Any]) -> Set[Tuple[Any, ...]]:\n        \"\"\"\n        Converts an iterable of tuple-like items into a set of their canonical (sorted) forms.\n        \"\"\"\n        canonical_set = set()\n        for item in input_iterable:\n            # Convert the item to a tuple (handles lists and other iterables).\n            item_as_tuple = tuple(item)\n            # Normalize the tuple by sorting its elements.\n            canonical_tuple = tuple(sorted(item_as_tuple))\n            canonical_set.add(canonical_tuple)\n        return canonical_set\n\n    # Get canonical sets for both input iterables\n    canonical_set1 = _get_canonical_set(list1)\n    canonical_set2 = _get_canonical_set(list2)\n\n    # Compute the intersection of the two canonical sets\n    return canonical_set1 & canonical_set2"}
