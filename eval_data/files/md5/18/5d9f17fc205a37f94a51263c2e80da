{"task_id": "Mbpp/599", "solution": "from dataclasses import dataclass\n\n@dataclass(frozen=True)\nclass ResultModel:\n    sum: int\n    average: float\n\n    def to_tuple(self) -> tuple[int, float]:\n        return (self.sum, self.average)\n\nclass InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass InputValidator:\n    MIN_N: int = 1\n\n    def validate(self, n: object) -> int:\n        try:\n            if isinstance(n, int):\n                value = n\n            elif isinstance(n, float):\n                if not n.is_integer():\n                    raise InvalidInputError(\"n must be an integer\")\n                value = int(n)\n            elif isinstance(n, str):\n                value = int(n.strip())\n            else:\n                raise InvalidInputError(\"Unsupported type for n\")\n        except ValueError:\n            raise InvalidInputError(\"n must be an integer\")\n\n        if value < self.MIN_N:\n            raise InvalidInputError(\"n must be >= 1\")\n        return value\n\nclass CalculatorService:\n    def sum_average(self, n: int) -> ResultModel:\n        if n <= 0:\n            raise ValueError(\"n must be > 0\")\n        s = self._compute_sum(n)\n        avg = self._compute_average(s, n)\n        return ResultModel(sum=s, average=avg)\n\n    def _compute_sum(self, n: int) -> int:\n        return n * (n + 1) // 2\n\n    def _compute_average(self, sum: int, n: int) -> float:\n        return sum / n\n\ndef sum_average(n: object) -> tuple[int, float]:\n    \"\"\"\n    Calculates the sum and average of the first n natural numbers.\n    Input n can be an int, float (if integer equivalent), or a string parseable to int.\n    \"\"\"\n    validator = InputValidator()\n    n_int = validator.validate(n)\n    service = CalculatorService()\n    result = service.sum_average(n_int)\n    return result.to_tuple()"}
