{"task_id": "Mbpp/279", "solution": "class DecagonalError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass InputValidationError(DecagonalError):\n    def __init__(self, message: str, param: str = \"n\") -> None:\n        super().__init__(message)\n        self.param = param\n\ndef is_num_decagonal(n: int) -> int:\n    \"\"\"\n    Computes the nth decagonal number, validating input for positive integers.\n    The formula used is D(n) = 4*n^2 - 3*n.\n    \"\"\"\n    param_name = \"n\"\n    if isinstance(n, bool):\n        raise InputValidationError(f\"Parameter '{param_name}' must be a positive integer, got boolean.\", param_name)\n    try:\n        n_validated = int(n)\n    except (TypeError, ValueError):\n        raise InputValidationError(f\"Parameter '{param_name}' must be a positive integer, got '{n}'.\", param_name)\n    if n_validated < 1:\n        raise InputValidationError(f\"Parameter '{param_name}' must be >= 1, got {n_validated}.\", param_name)\n\n    return 4 * n_validated * n_validated - 3 * n_validated"}
{"task_id": "Mbpp/282", "solution": "from typing import Sequence, Any, List\nfrom collections.abc import Sequence as ABCSequence\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for input validation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\ndef is_number(value: Any) -> bool:\n    \"\"\"Checks if a value is an int or float, excluding booleans.\"\"\"\n    return isinstance(value, (int, float)) and not isinstance(value, bool)\n\nclass ListValidator:\n    \"\"\"Validates input sequences for type, length, and numeric elements.\"\"\"\n    def validate_pair(self, a: Sequence[Any], b: Sequence[Any]) -> None:\n        if not self._is_sequence(a) or not self._is_sequence(b):\n            raise ValidationError(\"Both inputs must be sequences (lists/tuples).\")\n        if len(a) != len(b):\n            raise ValidationError(\"Input lists must be of the same length.\")\n        self._validate_numeric(a, \"a\")\n        self._validate_numeric(b, \"b\")\n\n    def _validate_numeric(self, seq: Sequence[Any], name: str) -> None:\n        for i, v in enumerate(seq):\n            if not is_number(v):\n                raise ValidationError(f\"{name}[{i}] is not numeric.\")\n\n    def _is_sequence(self, obj: Any) -> bool:\n        return isinstance(obj, ABCSequence) and not isinstance(obj, (str, bytes))\n\nclass ListMathService:\n    \"\"\"Provides core element-wise math operations.\"\"\"\n    def sub_list(self, a: Sequence[float], b: Sequence[float]) -> List[float]:\n        \"\"\"Computes element-wise subtraction of two numeric sequences.\"\"\"\n        return self._compute_elementwise(a, b)\n\n    def _compute_elementwise(self, a: Sequence[float], b: Sequence[float]) -> List[float]:\n        return [float(ai) - float(bi) for ai, bi in zip(a, b)]\n\nclass ListController:\n    \"\"\"Facade for list operations, orchestrating validation and service logic.\"\"\"\n    def __init__(self) -> None:\n        self.validator = ListValidator()\n        self.service = ListMathService()\n\n    def sub_list(self, a: Sequence[Any], b: Sequence[Any]) -> List[float]:\n        \"\"\"Validates inputs and performs element-wise subtraction.\"\"\"\n        self.validator.validate_pair(a, b)\n        return self.service.sub_list(a, b)\n\ndef sub_list(a: Sequence[Any], b: Sequence[Any]) -> List[float]:\n    \"\"\"Subtracts two lists element-wise after validating their contents.\"\"\"\n    controller = ListController()\n    return controller.sub_list(a, b)"}
{"task_id": "Mbpp/281", "solution": "import collections.abc\nfrom typing import Any, Callable, Iterable, Optional\n\n\nclass AllUniqueError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n\nclass InvalidInputError(AllUniqueError):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\n\nclass InputValidator:\n    \"\"\"Validates inputs and provides utility methods like hashability checks.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def validate_iterable(self, elements: Any) -> Iterable[Any]:\n        \"\"\"Ensures elements is an iterable (but not string/bytes) and returns it.\"\"\"\n        if isinstance(elements, (str, bytes)):\n            raise InvalidInputError(\"string/bytes are not valid iterables for uniqueness checks\")\n        if not isinstance(elements, collections.abc.Iterable):\n            raise InvalidInputError(\"elements must be an iterable\")\n        return elements\n\n    def validate_key(self, key: Optional[Callable[[Any], Any]]) -> Optional[Callable[[Any], Any]]:\n        \"\"\"Ensures key is callable or None.\"\"\"\n        if key is not None and not callable(key):\n            raise InvalidInputError(\"key must be a callable or None\")\n        return key\n\n    def is_hashable(self, obj: Any) -> bool:\n        \"\"\"Returns True if the object is hashable, False otherwise.\"\"\"\n        try:\n            hash(obj)\n            return True\n        except TypeError:\n            return False\n\n\nclass AllUniqueService:\n    \"\"\"Implements the core business logic for checking uniqueness.\"\"\"\n    def __init__(self, validator: InputValidator) -> None:\n        self._validator = validator\n\n    def all_unique(self, elements: Iterable[Any], key: Optional[Callable[[Any], Any]] = None) -> bool:\n        \"\"\"\n        Checks if all elements in the given iterable are unique, optionally using a key function.\n        It uses a hash-set based approach for hashable elements/keys, or a generic O(N^2) comparison for unhashable ones.\n        \"\"\"\n        validated_elements = list(self._validator.validate_iterable(elements))\n        validated_key = self._validator.validate_key(key)\n\n        if not validated_elements:\n            return True\n\n        # Check if all elements (or their keys) are hashable\n        if all(self._validator.is_hashable(validated_key(x) if validated_key else x) for x in validated_elements):\n            return self._all_unique_hashable(validated_elements, validated_key)\n        else:\n            return self._all_unique_generic(validated_elements, validated_key)\n\n    def _all_unique_hashable(self, elements: Iterable[Any], key: Optional[Callable[[Any], Any]] = None) -> bool:\n        \"\"\"Checks for uniqueness using a hash set, suitable for hashable elements or keys.\"\"\"\n        seen = set()\n        for item in elements:\n            val_to_check = key(item) if key else item\n            if val_to_check in seen:\n                return False\n            seen.add(val_to_check)\n        return True\n\n    def _all_unique_generic(self, elements: Iterable[Any], key: Optional[Callable[[Any], Any]] = None) -> bool:\n        \"\"\"Checks for uniqueness using nested loops, suitable for unhashable elements or keys (O(N^2)).\"\"\"\n        processed_values = []\n        for item in elements:\n            val_to_check = key(item) if key else item\n            for seen_val in processed_values:\n                if val_to_check == seen_val:\n                    return False\n            processed_values.append(val_to_check)\n        return True\n\n\nclass AllUniqueController:\n    \"\"\"Provides a stable API for callers, bridging raw inputs to the service.\"\"\"\n    def __init__(self, service: AllUniqueService) -> None:\n        self._service = service\n\n    def check(self, elements: Any, key: Optional[Callable[[Any], Any]] = None) -> bool:\n        \"\"\"Checks if elements are unique using the AllUniqueService.\"\"\"\n        return self._service.all_unique(elements, key)\n\n\n_validator = InputValidator()\n_service = AllUniqueService(_validator)\n_controller = AllUniqueController(_service)\n\n\ndef all_unique(elements: Iterable[Any], key: Optional[Callable[[Any], Any]] = None) -> bool:\n    \"\"\"\n    Checks if all elements in the given iterable are unique.\n    Returns True if all elements are unique, False otherwise.\n    \"\"\"\n    return _controller.check(elements, key)"}
{"task_id": "Mbpp/283", "solution": "def validate(integer: int) -> bool:\n    \"\"\"\n    Checks if the frequency of each digit in the integer is less than or equal to the digit itself.\n    \"\"\"\n    num = abs(integer)\n    counts = [0] * 10\n\n    if num == 0:\n        counts[0] = 1\n    else:\n        while num > 0:\n            digit = num % 10\n            counts[digit] += 1\n            num //= 10\n\n    for digit_value in range(10):\n        if counts[digit_value] > digit_value:\n            return False\n\n    return True"}
