{"task_id": "Mbpp/245", "solution": "```python\nfrom typing import List\n\ndef max_sum(arr: List[int]) -> int:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence for the given array.\n    A sequence is bitonic if it is first increasing and then decreasing.\n    \"\"\"\n    n = len(arr)\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return arr[0]\n\n    # Calculate LIS (Longest Increasing Subsequence) sums ending at each position\n    # and store parent indices for reconstruction\n    lis_sums = arr[:]\n    lis_parents = [-1] * n\n    for i in range(n):\n        for j in range(i):\n            if arr[j] < arr[i] and lis_sums[j] + arr[i] > lis_sums[i]:\n                lis_sums[i] = lis_sums[j] + arr[i]\n                lis_parents[i] = j\n\n    # Calculate LDS (Longest Decreasing Subsequence) sums starting at each position\n    # (by computing LIS on reversed array for the decreasing part)\n    lds_sums_rev = arr[::-1]\n    lds_parents_rev = [-1] * n\n    for i in range(n):\n        for j in range(i):\n            if arr[::-1][j] < arr[::-1][i] and lds_sums_rev[j] + arr[::-1][i] > lds_sums_rev[i]:\n                lds_sums_rev[i] = lds_sums_rev[j] + arr[::-1][i]\n                lds_parents_rev[i] = j\n    \n    # Reverse back lds_sums to correspond to original array indices\n    lds_sums = lds_sums_rev[::-1]\n\n    max_bitonic_sum = 0\n    for i in range(n):\n        # A bitonic subsequence must have at least one element.\n        # The peak element arr[i] is counted in both LIS and LDS sums, so subtract it once.\n        current_bitonic_sum = lis_sums[i] + lds_sums[i] - arr[i]\n        if current_bitonic_sum > max_bitonic_sum:\n            max_bitonic_sum = current_bitonic_sum\n            \n    return max_bitonic_sum\n```"}
{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Finds the number of possible sequences of length n, where each element is a positive integer,\n    greater than or equal to twice the previous element, and less than or equal to m.\n    \"\"\"\n    if n == 1:\n        return m\n\n    # dp_prev[v] stores the number of sequences of length `current_length - 1` ending with `v`.\n    # Array size m+2 to allow 1-based indexing for values up to m.\n    dp_prev = [0] * (m + 2)\n    for v in range(1, m + 1):\n        dp_prev[v] = 1  # For length 1, any positive integer <= m is a valid sequence.\n\n    # Iterate for sequence lengths from 2 up to n.\n    for _ in range(2, n + 1):\n        # suffix[i] will store the sum of dp_prev[j] for all j >= i.\n        # Array size m+3 to allow 1-based indexing up to m+1 for convenience,\n        # where suffix[m+1] will implicitly be 0.\n        suffix = [0] * (m + 3)\n        for i in range(m, 0, -1):\n            suffix[i] = suffix[i + 1] + dp_prev[i]\n\n        # dp_curr[v] stores the number of sequences of the current length ending with `v`.\n        dp_curr = [0] * (m + 2)\n        for v in range(1, m + 1):\n            # The next element must be >= 2*v.\n            # We need to sum dp_prev[j] for all j such that j >= 2*v and j <= m.\n            # This sum is directly available from suffix[2*v].\n            min_next_val = 2 * v\n            if min_next_val <= m:\n                dp_curr[v] = suffix[min_next_val]\n            else:\n                dp_curr[v] = 0\n        dp_prev = dp_curr  # Update dp_prev for the next iteration.\n\n    # The total count is the sum of all valid sequences of length n,\n    # which are represented by dp_prev[1] through dp_prev[m].\n    return sum(dp_prev[1 : m + 1])"}
{"task_id": "Mbpp/247", "solution": "import re\n\ndef lps(text: str) -> int:\n    \"\"\"\n    Finds the length of the longest palindromic subsequence in the given string.\n    The string is normalized by removing non-alphanumeric characters and converting to lowercase.\n    \"\"\"\n    normalized_text = re.sub(r'[^A-Za-z0-9]', '', text).lower()\n\n    n = len(normalized_text)\n\n    if n == 0:\n        return 0\n\n    # dp[i][j] stores the length of the longest palindromic subsequence for normalized_text[i...j]\n    dp = [[0] * n for _ in range(n)]\n\n    # Base case: All substrings of length 1 (i.e., dp[i][i]) have an LPS length of 1\n    # Iterate from bottom-right to top-left of the DP table\n    for i in range(n - 1, -1, -1):\n        dp[i][i] = 1 \n        for j in range(i + 1, n):\n            if normalized_text[i] == normalized_text[j]:\n                # If characters match, they form a pair. Add 2 and consider the inner substring.\n                # dp[i+1][j-1] accounts for the LPS of the substring without the current matching pair.\n                dp[i][j] = 2 + (dp[i + 1][j - 1] if j > i + 1 else 0)\n            else:\n                # If characters don't match, take the maximum of:\n                # 1. LPS of substring excluding the first character (normalized_text[i+1...j])\n                # 2. LPS of substring excluding the last character (normalized_text[i...j-1])\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n    return dp[0][n - 1]"}
