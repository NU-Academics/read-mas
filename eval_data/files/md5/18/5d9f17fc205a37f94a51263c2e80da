{"task_id": "Mbpp/171", "solution": "from dataclasses import dataclass\n\nclass InvalidSideLengthError(ValueError):\n    \"\"\"Exception raised for invalid side length values.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\n@dataclass(frozen=True)\nclass SideLength:\n    \"\"\"A validated side length value for a regular pentagon.\"\"\"\n    value: float\n\n    def __post_init__(self) -> None:\n        # Ensure value is float, even if initially int.\n        object.__setattr__(self, \"value\", float(self.value))\n\nclass LengthValidator:\n    \"\"\"Validates raw inputs for side length.\"\"\"\n    def validate(self, value: object) -> SideLength:\n        try:\n            numeric = float(value)\n        except (TypeError, ValueError):\n            raise TypeError(\"side_length must be a number\")\n        if not (numeric > 0):\n            raise InvalidSideLengthError(\"side_length must be > 0\")\n        return SideLength(numeric)\n\nclass PentagonPerimeterCalculator:\n    \"\"\"Calculates the perimeter of a regular pentagon.\"\"\"\n    SIDES: int = 5\n\n    def calculate(self, side: SideLength) -> float:\n        return side.value * self.SIDES\n\nclass PentagonController:\n    \"\"\"Coordinates validation and perimeter calculation.\"\"\"\n    def __init__(self, validator: LengthValidator = None, calculator: PentagonPerimeterCalculator = None):\n        self.validator = validator or LengthValidator()\n        self.calculator = calculator or PentagonPerimeterCalculator()\n\n    def perimeter_pentagon(self, side_length: object) -> float:\n        validated = self.validator.validate(side_length)\n        return self.calculator.calculate(validated)\n\n_controller = PentagonController()\n\ndef perimeter_pentagon(side_length: object) -> float:\n    \"\"\"\n    Computes the perimeter of a regular pentagon from the length of one side.\n    The side_length must be a positive number.\n    \"\"\"\n    return _controller.perimeter_pentagon(side_length)"}
{"task_id": "Mbpp/222", "solution": "def check_type(value: tuple) -> bool:\n    \"\"\"\n    Checks if all elements in a tuple have the same data type.\n    An empty tuple is considered to have all elements of the same type.\n    \"\"\"\n    if not value:\n        return True\n    \n    first_type = type(value[0])\n    for item in value[1:]:\n        if type(item) is not first_type:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/223", "solution": "def is_majority(arr: list[int], n: int, x: int) -> bool:\n    \"\"\"\n    Checks if an element x is the majority element in a sorted array.\n    (Majority element occurs more than n/2 times.)\n    \"\"\"\n    if n == 0:\n        return False\n\n    # Find the first occurrence of x using binary search\n    first_idx = -1\n    low, high = 0, n - 1\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == x:\n            first_idx = mid\n            high = mid - 1  # Try to find an earlier occurrence\n        elif arr[mid] < x:\n            low = mid + 1\n        else:  # arr[mid] > x\n            high = mid - 1\n\n    # If x is not found, it cannot be a majority element\n    if first_idx == -1:\n        return False\n\n    # Find the last occurrence of x using binary search\n    last_idx = -1\n    low, high = 0, n - 1  # Reset bounds for the second search\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == x:\n            last_idx = mid\n            low = mid + 1  # Try to find a later occurrence\n        elif arr[mid] < x:\n            low = mid + 1\n        else:  # arr[mid] > x\n            high = mid - 1\n\n    # Calculate the count of occurrences\n    count = last_idx - first_idx + 1\n\n    # Check if the count is greater than n/2\n    return count > (n // 2)"}
