{"task_id": "Mbpp/763", "solution": "from typing import Sequence, Optional, List, Any\n\nclass MinDiffError(Exception):\n    \"\"\"Base exception for minimum difference calculation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass InputValidationError(MinDiffError):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass InputValidator:\n    \"\"\"Validates and normalizes input data for the minimum difference calculation.\"\"\"\n    MIN_LENGTH = 2\n\n    def __init__(self, allow_non_strict_length: bool = False) -> None:\n        self.allow_non_strict_length = allow_non_strict_length\n\n    def validate(self, arr: Any, n: Optional[int] = None) -> List[float]:\n        \"\"\"\n        Validates the input array and its elements, returning a list of floats.\n        Raises InputValidationError for invalid inputs or length mismatches.\n        \"\"\"\n        data: List[float] = []\n        try:\n            for x in arr:\n                if isinstance(x, bool):\n                    raise InputValidationError(f\"Boolean value '{x}' is not considered a valid number.\")\n                data.append(float(x))\n        except TypeError:\n            raise InputValidationError(\"Input 'arr' must be an iterable of numbers.\")\n        except ValueError as e:\n            raise InputValidationError(f\"All elements in 'arr' must be convertible to numbers: {e}\")\n\n        if len(data) < self.MIN_LENGTH:\n            raise InputValidationError(f\"Input array must contain at least {self.MIN_LENGTH} numbers, but got {len(data)}.\")\n\n        if n is not None and not self.allow_non_strict_length and int(n) != len(data):\n            raise InputValidationError(f\"Expected length {n} but got {len(data)}.\")\n        return data\n\nclass MinDiffService:\n    \"\"\"Provides the core algorithm to compute the minimum difference.\"\"\"\n    def __init__(self, validator: InputValidator = None, strict_length: bool = True) -> None:\n        self.validator = validator or InputValidator()\n        self.strict_length = strict_length\n\n    def compute(self, arr: Any, n: Optional[int] = None) -> float:\n        \"\"\"\n        Validates the input array and computes the minimum absolute difference between any two elements.\n        \"\"\"\n        data = self.validator.validate(arr, n)\n        return self._compute_from_list(data)\n\n    def _compute_from_list(self, data: List[float]) -> float:\n        \"\"\"\n        Sorts the list and computes the minimum absolute difference between adjacent elements.\n        \"\"\"\n        # This check should ideally be handled by the validator, but kept for robustness.\n        if len(data) < 2:\n            raise InputValidationError(\"Cannot compute difference for less than two elements.\")\n\n        data_sorted = sorted(data)\n        best = float('inf')\n        for a, b in zip(data_sorted, data_sorted[1:]):\n            diff = abs(a - b)\n            if diff < best:\n                best = diff\n                if best == 0:\n                    break # Optimization: 0 is the smallest possible difference\n        return best\n\ndef find_min_diff(arr, n):\n    \"\"\"\n    Finds the minimum difference between any two elements in a given array.\n    This function delegates validation and computation to internal classes.\n    \"\"\"\n    validator = InputValidator()\n    svc = MinDiffService(validator=validator)\n    return svc.compute(arr, n)"}
{"task_id": "Mbpp/766", "solution": "from typing import List, Any, Tuple\n\ndef pair_wise(items: List[Any]) -> List[Tuple[Any, Any]]:\n    \"\"\"\n    Returns a list of all pairs of consecutive items in the given list.\n    If the list has fewer than two items, an empty list is returned.\n    \"\"\"\n    return [(items[i], items[i+1]) for i in range(len(items) - 1)]"}
{"task_id": "Mbpp/769", "solution": "from typing import List\n\ndef Diff(a: List[int], b: List[int]) -> List[int]:\n    \"\"\"\n    Computes the difference between two lists, returning elements in 'a' not in 'b'.\n    The result is ordered by original even indices first, then odd indices.\n    \"\"\"\n    b_set = set(b)\n    \n    # Collect elements from 'a' that are not in 'b', preserving their original indices.\n    remaining_elements_with_indices = []\n    for i, val in enumerate(a):\n        if val not in b_set:\n            remaining_elements_with_indices.append((i, val))\n            \n    # Separate into elements that had even original indices and odd original indices.\n    even_indexed_values = []\n    odd_indexed_values = []\n    for original_index, value in remaining_elements_with_indices:\n        if original_index % 2 == 0:\n            even_indexed_values.append(value)\n        else:\n            odd_indexed_values.append(value)\n            \n    # Concatenate even-indexed elements first, followed by odd-indexed elements.\n    return even_indexed_values + odd_indexed_values"}
{"task_id": "Mbpp/771", "solution": "class Stack:\n    \"\"\"A basic stack implementation for character storage.\"\"\"\n    def __init__(self) -> None:\n        self._items: list = []\n\n    def push(self, item: str) -> None:\n        self._items.append(item)\n\n    def pop(self) -> str:\n        \"\"\"Removes and returns the top item from the stack.\"\"\"\n        if self.is_empty():\n            # This case is handled by the calling logic (check_expression)\n            # which checks is_empty() before attempting pop when encountering a closing bracket.\n            # If pop is called directly on an empty stack by some other logic, it would raise IndexError.\n            raise IndexError(\"pop from empty stack\")\n        return self._items.pop()\n\n    def peek(self) -> str | None:\n        \"\"\"Returns the top item without removing it, or None if the stack is empty.\"\"\"\n        return self._items[-1] if self._items else None\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the stack is empty.\"\"\"\n        return not self._items\n\ndef check_expression(expr: str) -> bool:\n    \"\"\"\n    Checks if the given expression containing brackets is balanced.\n    Non-bracket characters are ignored by default.\n    \"\"\"\n    s = Stack()\n    \n    # Default bracket pairs as specified in the design context.\n    # From src/balancer/config.py: DEFAULT_PAIRS = {\"(\": \")\", \"{\": \"}\", \"[\": \"]\"}\n    # From src/balancer/config.py: DEFAULT_STRICT_MODE = False (means ignore non-bracket chars)\n    \n    opening_to_closing = {\"(\": \")\", \"{\": \"}\", \"[\": \"]\"}\n    closing_to_opening = {v: k for k, v in opening_to_closing.items()}\n\n    for char in expr:\n        if char in opening_to_closing:\n            s.push(char)\n        elif char in closing_to_opening:\n            if s.is_empty() or s.pop() != closing_to_opening[char]:\n                return False\n        # If the character is not an opening or closing bracket,\n        # it is ignored as per DEFAULT_STRICT_MODE = False.\n\n    return s.is_empty()"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth power of the first n odd natural numbers.\n    This implementation uses a closed-form formula for O(1) computation.\n    \"\"\"\n    # The formula is derived from Sum_{k=1..n} (2k-1)^4.\n    # It combines sums of powers of k using integer arithmetic.\n    s1 = n * (n + 1) // 2\n    s2 = n * (n + 1) * (2 * n + 1) // 6\n    s3 = s1 * s1\n    s4 = n * (n + 1) * (2 * n + 1) * (3 * n * n + 3 * n - 1) // 30\n    return 16 * s4 - 32 * s3 + 24 * s2 - 8 * s1 + n"}
{"task_id": "Mbpp/767", "solution": "import collections\nfrom abc import ABC, abstractmethod\nfrom typing import Any, Dict, List, Optional, Sequence, Tuple\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for input validation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass PairCountResult:\n    \"\"\"DTO for the result of pair counting.\"\"\"\n    def __init__(self, count: int, pairs: Optional[List[Tuple[int, int]]] = None) -> None:\n        self.count = count\n        self.pairs = pairs\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Returns a dictionary representation of the result.\"\"\"\n        return {\"count\": self.count, \"pairs\": self.pairs}\n\ndef is_iterable(obj: Any) -> bool:\n    \"\"\"Checks if an object is iterable.\"\"\"\n    try:\n        iter(obj)\n        return True\n    except TypeError:\n        return False\n\ndef validate_numbers(numbers: Sequence[int]) -> None:\n    \"\"\"Validates that numbers is an iterable of integers.\"\"\"\n    if not is_iterable(numbers):\n        raise ValidationError(\"numbers must be an iterable of ints\")\n    for i, v in enumerate(numbers):\n        if not isinstance(v, int):\n            raise ValidationError(f\"element at index {i} is not int: {v}\")\n\ndef validate_target(target: int) -> None:\n    \"\"\"Validates that target is an integer.\"\"\"\n    if not isinstance(target, int):\n        raise ValidationError(\"target must be an int\")\n\nclass FrequencyRepository(ABC):\n    \"\"\"Abstract base class for building frequency maps.\"\"\"\n    @abstractmethod\n    def build_frequency(self, numbers: Sequence[int]) -> Dict[int, int]:\n        ...\n\nclass InMemoryFrequencyRepository(FrequencyRepository):\n    \"\"\"Concrete implementation for building frequency maps in memory.\"\"\"\n    def __init__(self, logger: Optional[Any] = None) -> None:\n        self._logger = logger\n\n    def build_frequency(self, numbers: Sequence[int]) -> Dict[int, int]:\n        \"\"\"Builds a frequency map from a sequence of numbers.\"\"\"\n        return dict(collections.Counter(numbers))\n\nclass PairCounterService:\n    \"\"\"Core service for counting pairs that sum to a target.\"\"\"\n    def __init__(self, repo: FrequencyRepository, logger: Optional[Any] = None) -> None:\n        self._repo = repo\n        self._logger = logger\n\n    def count_pairs(self, numbers: Sequence[int], target: int, include_pairs: bool = False) -> PairCountResult:\n        \"\"\"Counts pairs summing to target after validating inputs and building frequency map.\"\"\"\n        validate_numbers(numbers)\n        validate_target(target)\n        freq = self._repo.build_frequency(numbers)\n        return self._count_from_freq(freq, target, include_pairs)\n\n    def _count_from_freq(self, freq: Dict[int, int], target: int, include_pairs: bool = False) -> PairCountResult:\n        \"\"\"Calculates the number of pairs from a frequency map.\"\"\"\n        count = 0\n        pairs: Optional[List[Tuple[int, int]]] = [] if include_pairs else None\n        \n        for v, n in freq.items():\n            c = target - v\n            \n            if c not in freq:\n                continue\n            \n            if v == c:\n                add = n * (n - 1) // 2\n                count += add\n                if include_pairs and pairs is not None:\n                    for _ in range(min(add, 100)):\n                        pairs.append((v, c))\n            elif v < c:\n                add = n * freq[c]\n                count += add\n                if include_pairs and pairs is not None:\n                    for _ in range(min(add, 100)):\n                        pairs.append((v, c))\n        \n        return PairCountResult(count=count, pairs=pairs)\n\n_default_service = PairCounterService(InMemoryFrequencyRepository())\n\ndef get_pairs_count(numbers: list[int], sum: int) -> int:\n    \"\"\"Counts the number of pairs in a list that sum to a given value.\"\"\"\n    result = _default_service.count_pairs(numbers, sum)\n    return result.count"}
{"task_id": "Mbpp/772", "solution": "def remove_length(text: str, k: int) -> str:\n    \"\"\"\n    Removes all words with k alphanumeric length from the given string.\n    \"\"\"\n\n    def _tokenize(s: str) -> list[str]:\n        return s.split()\n\n    def _alnum_length(token: str) -> int:\n        return sum(1 for char in token if char.isalnum())\n\n    def _normalize_whitespace(tokens_list: list[str]) -> str:\n        return \" \".join(tokens_list).strip()\n\n    tokens = _tokenize(text)\n    kept_tokens = [token for token in tokens if _alnum_length(token) != k]\n    return _normalize_whitespace(kept_tokens)"}
{"task_id": "Mbpp/765", "solution": "import math\n\nclass NumberUtils:\n    \"\"\"Helper functions for numeric operations, especially power-of-two checks.\"\"\"\n\n    MIN_POLITE_CANDIDATE = 3\n\n    @staticmethod\n    def is_power_of_two(x: int) -> bool:\n        \"\"\"Return True iff x is a power of two.\"\"\"\n        return (x & (x - 1)) == 0\n\n    @staticmethod\n    def floor_log2(x: int) -> int:\n        \"\"\"Return integer floor(log2(x)).\"\"\"\n        return x.bit_length() - 1\n\n    @staticmethod\n    def count_powers_of_two_le(x: int) -> int:\n        \"\"\"Return number of powers of two less than or equal to x.\"\"\"\n        return NumberUtils.floor_log2(x) + 1\n\n\nclass PoliteNumberGenerator:\n    \"\"\"Algorithms to find nth polite number.\"\"\"\n\n    SEARCH_UPPER_MARGIN = 64\n\n    def __init__(self, utils: type[NumberUtils] = NumberUtils) -> None:\n        \"\"\"Initialize with NumberUtils dependency.\"\"\"\n        self.utils = utils\n\n    def count_polite_le(self, x: int) -> int:\n        \"\"\"Return count of positive integers up to x that are not powers of two.\"\"\"\n        return x - self.utils.count_powers_of_two_le(x)\n\n    def find_nth_binary_search(self, n: int) -> int:\n        \"\"\"Find the n-th polite number using binary search.\"\"\"\n        u = n + self.utils.floor_log2(n) + self.SEARCH_UPPER_MARGIN\n        while self.count_polite_le(u) < n:\n            u *= 2\n        l = self.utils.MIN_POLITE_CANDIDATE\n        \n        while l < u:\n            m = (l + u) // 2\n            if self.count_polite_le(m) < n:\n                l = m + 1\n            else:\n                u = m\n        \n        if self.utils.is_power_of_two(l):\n            return l + 1\n        return l\n\n_number_utils_instance = NumberUtils()\n_polite_number_generator_instance = PoliteNumberGenerator(utils=_number_utils_instance)\n\ndef nth_polite(n: int) -> int:\n    \"\"\"\n    Finds the n-th polite number, which is a positive integer not a power of two.\n    \"\"\"\n    return _polite_number_generator_instance.find_nth_binary_search(n)"}
