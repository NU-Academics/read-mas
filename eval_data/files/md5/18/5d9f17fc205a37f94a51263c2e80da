{"task_id": "Mbpp/446", "solution": "from typing import Any, Iterable, Tuple, Dict\n\ndef count_Occurrence(tuple_data: Tuple[Any, ...], items: Iterable[Any]) -> int:\n    \"\"\"\n    Counts the total occurrence of all elements from a list within a tuple.\n    It builds a frequency map of the tuple elements and sums counts for items.\n    \"\"\"\n    freq_map: Dict[Any, int] = {}\n    for element in tuple_data:\n        freq_map[element] = freq_map.get(element, 0) + 1\n\n    total_occurrences = 0\n    for item in items:\n        total_occurrences += freq_map.get(item, 0)\n\n    return total_occurrences"}
{"task_id": "Mbpp/440", "solution": "import re\nimport string\n\n# -- Constants (from constants.py in design) --\n# This set contains common adverbs and a few examples for demonstration.\nDEFAULT_ADVERBS = {\"clearly\", \"quickly\", \"slowly\", \"very\", \"only\", \"well\", \"fast\", \"always\", \"never\", \"often\", \"seldom\", \"sometimes\", \"usually\", \"almost\", \"enough\", \"hardly\", \"just\", \"much\", \"quite\", \"rather\", \"really\", \"so\", \"too\", \"away\", \"everywhere\", \"here\", \"inside\", \"near\", \"outside\", \"there\", \"up\", \"down\", \"forward\", \"back\", \"ago\", \"early\", \"late\", \"now\", \"soon\", \"then\", \"today\", \"tomorrow\", \"yesterday\"}\nADVERB_SUFFIX = \"ly\"\nADVERB_EXCEPTIONS = {\"family\", \"apply\", \"reply\", \"holy\"}\n\n# -- Models (from models.py in design) --\nclass Token:\n    \"\"\"Represents a token extracted from original text along with character offsets.\"\"\"\n    def __init__(self, text: str, start: int, end: int):\n        self.text = text\n        self.start = start\n        self.end = end\n\n    def __repr__(self) -> str:\n        return f\"Token(text='{self.text}', start={self.start}, end={self.end})\"\n\n    def as_tuple(self) -> tuple[str, int, int]:\n        return (self.text, self.start, self.end)\n\nclass AdverbResult:\n    \"\"\"Encapsulates result (start, end, text) for an adverb.\"\"\"\n    def __init__(self, start: int | None, end: int | None, text: str | None):\n        self.start = start\n        self.end = end\n        self.text = text\n\n    def to_tuple(self) -> tuple[int | None, int | None, str | None]:\n        return (self.start, self.end, self.text)\n\n# -- Utils (from utils.py in design) --\nclass TextCleaner:\n    \"\"\"Normalizes text by, for example, lowercasing it.\"\"\"\n    def __init__(self, lowercase: bool = True):\n        self.lowercase = lowercase\n\n    def normalize(self, text: str) -> str:\n        if self.lowercase:\n            return text.lower()\n        return text\n\n# -- Tokenizer (from tokenizer.py in design) --\nclass Tokenizer:\n    \"\"\"Tokenizes text into words and tracks their start/end offsets.\"\"\"\n    # Matches sequences of alphanumeric characters or apostrophes.\n    # This regex implicitly strips leading/trailing punctuation from the extracted token text itself.\n    TOKEN_RE = re.compile(r\"[A-Za-z0-9']+\")\n\n    def __init__(self, keep_apostrophes: bool = True):\n        self.keep_apostrophes = keep_apostrophes\n\n    def tokenize(self, text: str) -> list[Token]:\n        tokens = []\n        for m in self.TOKEN_RE.finditer(text):\n            span = m.span() # (start, end) indices in the original text\n            token_text = m.group(0) # The matched string (e.g., \"clearly\" from \"clearly!!\")\n            tokens.append(Token(text=token_text, start=span[0], end=span[1]))\n        return tokens\n\n# -- PosTagger (from pos_tagger.py in design) --\nclass PosTagger:\n    \"\"\"Determines if a token is an adverb based on a lexicon and morphological rules.\"\"\"\n    def __init__(self, adverb_lexicon: set, suffix: str = \"ly\", exceptions: set = None):\n        self.adverb_lexicon = adverb_lexicon\n        self.suffix = suffix\n        self.exceptions = exceptions or set()\n\n    def normalize_token(self, token_text: str) -> str:\n        \"\"\"Converts token text to lowercase for consistent matching.\"\"\"\n        return token_text.lower()\n\n    def is_adverb(self, token: Token) -> bool:\n        norm = self.normalize_token(token.text)\n        if norm in self.adverb_lexicon:\n            return True\n        if norm.endswith(self.suffix) and norm not in self.exceptions:\n            return True\n        return False\n\n# -- AdverbFinderService (from services.py in design) --\nclass AdverbFinderService:\n    \"\"\"Orchestrates tokenization and POS tagging to find the first adverb.\"\"\"\n    def __init__(self, tokenizer: Tokenizer, pos_tagger: PosTagger, cleaner: TextCleaner):\n        self.tokenizer = tokenizer\n        self.pos_tagger = pos_tagger\n        self.cleaner = cleaner\n\n    def find_first_adverb(self, text: str, raise_on_empty: bool = False) -> AdverbResult:\n        # The tokenizer operates on the original text to maintain correct offsets.\n        tokens = self.tokenizer.tokenize(text)\n\n        for token in tokens:\n            if self.pos_tagger.is_adverb(token):\n                # Extract the original substring corresponding to the token and normalize it\n                # for the result, consistent with the asserted output format (e.g., 'clearly' lowercase).\n                extracted_text = text[token.start:token.end]\n                normalized_result_text = self.cleaner.normalize(extracted_text)\n                return AdverbResult(token.start, token.end, normalized_result_text)\n\n        # If no adverb is found, return (None, None, None).\n        return AdverbResult(None, None, None)\n\n# Global service instance for the facade function.\n_default_service: AdverbFinderService | None = None\n\ndef find_adverb_position(text: str, raise_on_empty: bool = False) -> tuple[int | None, int | None, str | None]:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    Returns a tuple (start_index, end_index, adverb_text) or (None, None, None) if not found.\n    \"\"\"\n    global _default_service\n    if _default_service is None:\n        _default_service = AdverbFinderService(\n            tokenizer=Tokenizer(),\n            pos_tagger=PosTagger(adverb_lexicon=DEFAULT_ADVERBS, suffix=ADVERB_SUFFIX, exceptions=ADVERB_EXCEPTIONS),\n            cleaner=TextCleaner(lowercase=True)\n        )\n    result = _default_service.find_first_adverb(text, raise_on_empty=raise_on_empty)\n    return result.to_tuple()"}
{"task_id": "Mbpp/445", "solution": "from typing import Any, Tuple, Sequence, Iterator\n\nclass ShapeMismatchError(Exception):\n    \"\"\"Exception raised for mismatches in tuple shapes or lengths.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass InvalidTypeError(Exception):\n    \"\"\"Exception raised for invalid input types or element types.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\ndef is_sequence(obj: Any) -> bool:\n    \"\"\"Checks if an object is a sequence (excluding strings, bytes, and bytearrays).\"\"\"\n    return isinstance(obj, Sequence) and not isinstance(obj, (str, bytes, bytearray))\n\ndef ensure_tuple(obj: Any) -> Tuple[Any, ...]:\n    \"\"\"Ensures an object is a tuple, converting lists to tuples if necessary.\"\"\"\n    if isinstance(obj, tuple):\n        return obj\n    if isinstance(obj, list):\n        return tuple(obj)\n    raise InvalidTypeError(f\"Input must be a tuple or list, found {type(obj).__name__}.\")\n\ndef validate_numeric_sequence(seq: Sequence[Any]) -> None:\n    \"\"\"Validates that all elements in a sequence are numeric (int or float).\"\"\"\n    if not is_sequence(seq):\n        raise InvalidTypeError(f\"Expected a sequence of numbers, but got {type(seq).__name__}.\")\n    for item in seq:\n        if not isinstance(item, (int, float)):\n            raise InvalidTypeError(f\"All elements in the sequence must be numeric, found {type(item).__name__}.\")\n\nclass TuplePair:\n    \"\"\"An immutable value object representing a single inner tuple of numeric values.\"\"\"\n    def __init__(self, values: Tuple[Any, ...]) -> None:\n        if not isinstance(values, tuple):\n            raise InvalidTypeError(f\"TuplePair must be initialized with a tuple, got {type(values).__name__}\")\n        validate_numeric_sequence(values)\n        self._values = values\n\n    def __len__(self) -> int:\n        return len(self._values)\n\n    def __iter__(self) -> Iterator[Any]:\n        return iter(self._values)\n\n    def __getitem__(self, index: int) -> Any:\n        return self._values[index]\n\n    def to_tuple(self) -> Tuple[Any, ...]:\n        return self._values\n\nclass TupleCollection:\n    \"\"\"An immutable collection of TuplePair objects, representing the outer tuple.\"\"\"\n    def __init__(self, pairs: Tuple[\"TuplePair\", ...]) -> None:\n        if not isinstance(pairs, tuple):\n            raise InvalidTypeError(f\"TupleCollection must be initialized with a tuple of TuplePair, got {type(pairs).__name__}\")\n        for i, pair in enumerate(pairs):\n            if not isinstance(pair, TuplePair):\n                raise InvalidTypeError(f\"Element at index {i} in TupleCollection is not a TuplePair, got {type(pair).__name__}\")\n        self._pairs = pairs\n\n    def __len__(self) -> int:\n        return len(self._pairs)\n\n    def pair_at(self, index: int) -> TuplePair:\n        return self._pairs[index]\n\n    def to_tuple(self) -> Tuple[Tuple[Any, ...], ...]:\n        return tuple(pair.to_tuple() for pair in self._pairs)\n\nclass InputAdapter:\n    \"\"\"Adapts raw input types, validating and coercing them to a normalized tuple-of-tuples structure.\"\"\"\n    def parse(self, a: Any, b: Any) -> Tuple[Tuple[Any, ...], Tuple[Any, ...]]:\n        a_coerced = self._coerce_to_tuple(a)\n        b_coerced = self._coerce_to_tuple(b)\n\n        for i, item in enumerate(a_coerced):\n            if not isinstance(item, tuple):\n                raise InvalidTypeError(f\"Input 'a' must be a tuple of tuples, found {type(item).__name__} at outer index {i}.\")\n        for i, item in enumerate(b_coerced):\n            if not isinstance(item, tuple):\n                raise InvalidTypeError(f\"Input 'b' must be a tuple of tuples, found {type(item).__name__} at outer index {i}.\")\n\n        return a_coerced, b_coerced\n\n    def _coerce_to_tuple(self, obj: Any) -> Tuple[Any, ...]:\n        \"\"\"Converts sequences to tuples, validating that the input is a sequence.\"\"\"\n        if not is_sequence(obj):\n            raise InvalidTypeError(f\"Input must be a sequence (e.g., tuple or list), found {type(obj).__name__}\")\n        return ensure_tuple(obj)\n\nclass OutputAdapter:\n    \"\"\"Formats a TupleCollection domain object back into a standard Python tuple-of-tuples.\"\"\"\n    def format(self, collection: TupleCollection) -> Tuple[Tuple[Any, ...], ...]:\n        return collection.to_tuple()\n\nclass IndexMultiplicationService:\n    \"\"\"Provides the core business logic for performing index-wise multiplication.\"\"\"\n    def multiply(self, left: TupleCollection, right: TupleCollection) -> TupleCollection:\n        if len(left) != len(right):\n            raise ShapeMismatchError(\"Outer lengths of input tuple collections differ.\")\n        \n        result_pairs = []\n        for i in range(len(left)):\n            lp = left.pair_at(i)\n            rp = right.pair_at(i)\n            \n            if len(lp) != len(rp):\n                raise ShapeMismatchError(f\"Inner tuple lengths differ at index {i}.\")\n            \n            products = tuple(lp[j] * rp[j] for j in range(len(lp)))\n            result_pairs.append(TuplePair(products))\n            \n        return TupleCollection(tuple(result_pairs))\n\nclass Controller:\n    \"\"\"Orchestrates the index-wise multiplication process, coordinating adapters and services.\"\"\"\n    def index_multiplication(self, a: Any, b: Any) -> Tuple[Tuple[int, ...], ...]:\n        \"\"\"Orchestrates parsing, multiplication, and formatting for tuple-wise multiplication.\"\"\"\n        a_tuples, b_tuples = InputAdapter().parse(a, b)\n        \n        left = TupleCollection(tuple(TuplePair(tuple_) for tuple_ in a_tuples))\n        right = TupleCollection(tuple(TuplePair(tuple_) for tuple_ in b_tuples))\n        \n        result_collection = IndexMultiplicationService().multiply(left, right)\n        \n        return OutputAdapter().format(result_collection)\n\ndef index_multiplication(a: Any, b: Any) -> Tuple[Tuple[int, ...], ...]:\n    \"\"\"\n    Performs index-wise multiplication of tuple elements in the given two tuples.\n    This function orchestrates validation, processing, and formatting.\n    \"\"\"\n    return Controller().index_multiplication(a, b)"}
{"task_id": "Mbpp/450", "solution": "from typing import Any, List\n\nclass InvalidInputError(Exception):\n    def __init__(self, message: str, code: int = 400) -> None:\n        super().__init__(message)\n        self.message = message\n        self.code = code\n\nclass ExtractRequest:\n    def __init__(self, values: List[str], size: int) -> None:\n        self.values = list(values)\n        self.size = int(size)\n\nclass ExtractResult:\n    def __init__(self, matches: List[str]) -> None:\n        self.matches = list(matches)\n\nclass StringValidator:\n    MIN_SIZE = 0\n\n    def validate(self, values: Any, size: Any) -> ExtractRequest:\n        if not isinstance(size, int):\n            try:\n                size = int(size)\n            except (TypeError, ValueError):\n                raise InvalidInputError(f\"size must be integer, got {type(size).__name__}\")\n        if size < self.MIN_SIZE:\n            raise InvalidInputError(\"size must be >= 0\")\n        if values is None:\n            raise InvalidInputError(\"values must be an iterable of strings, not None\")\n        if not hasattr(values, \"__iter__\") or isinstance(values, (str, bytes)):\n            raise InvalidInputError(\"values must be a list-like of strings\")\n        validated: List[str] = []\n        for i, v in enumerate(values):\n            if not isinstance(v, str):\n                raise InvalidInputError(f\"element at index {i} is not str: {type(v).__name__}\")\n            validated.append(v)\n        return ExtractRequest(validated, size)\n\nclass StringExtractorService:\n    def __init__(self, validator: StringValidator):\n        self._validator = validator\n\n    def extract(self, request: ExtractRequest) -> ExtractResult:\n        matches: List[str] = []\n        for v in request.values:\n            if len(v) == request.size:\n                matches.append(v)\n        return ExtractResult(matches)\n\ndef extract_string(values: list, size: int) -> list:\n    \"\"\"\n    Extracts strings of a specified length from a list of strings.\n    Validates inputs and returns a new list with matching strings.\n    \"\"\"\n    validator = StringValidator()\n    request = validator.validate(values, size)\n    service = StringExtractorService(validator)\n    result = service.extract(request)\n    return result.matches"}
{"task_id": "Mbpp/448", "solution": "from typing import Optional\n\nclass PerrinCalculator:\n    \"\"\"Calculates Perrin numbers and their sums.\"\"\"\n\n    BASE_VALUES = (3, 0, 2)\n\n    def compute_sum(self, n: int) -> int:\n        \"\"\"Computes the sum of Perrin numbers from P(0) to P(n).\"\"\"\n        total = 0\n        a, b, c = self.BASE_VALUES\n\n        if n >= 0:\n            total += a\n        if n >= 1:\n            total += b\n        if n >= 2:\n            total += c\n        \n        for i in range(3, n + 1):\n            a, b, c = b, c, a + b\n            total += c\n        return total\n\nclass InMemoryPerrinRepository:\n    \"\"\"An in-memory repository for caching Perrin sums.\"\"\"\n    def __init__(self):\n        self._cache: dict[int, int] = {}\n\n    def get(self, n: int) -> Optional[int]:\n        return self._cache.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        self._cache[n] = value\n\nclass PerrinService:\n    \"\"\"Orchestrates Perrin number sum calculation with optional caching.\"\"\"\n    def __init__(self, calculator: PerrinCalculator, repository: Optional[InMemoryPerrinRepository] = None):\n        self.calculator = calculator\n        self.repository = repository\n\n    def compute_sum(self, n: int) -> int:\n        if self.repository:\n            cached = self.repository.get(n)\n            if cached is not None:\n                return cached\n        \n        result = self.calculator.compute_sum(n)\n        \n        if self.repository:\n            self.repository.set(n, result)\n        \n        return result\n\ndef cal_sum(n: int) -> int:\n    \"\"\"Calculates the sum of Perrin numbers up to n.\"\"\"\n    calc = PerrinCalculator()\n    repository = InMemoryPerrinRepository()\n    service = PerrinService(calculator=calc, repository=repository)\n    return service.compute_sum(n)"}
{"task_id": "Mbpp/453", "solution": "import math\n\ndef sumofFactors(n):\n    \"\"\"\n    Calculates the sum of even factors for a given number.\n    Handles negative inputs by using their absolute value and returns 0 for n=0.\n    \"\"\"\n    n_abs = abs(n)\n\n    if n_abs == 0:\n        return 0\n\n    total_sum = 0\n    # Iterate up to the square root to find factors efficiently.\n    for i in range(1, int(math.sqrt(n_abs)) + 1):\n        if n_abs % i == 0:\n            # Check the factor 'i'\n            if i % 2 == 0:\n                total_sum += i\n\n            # Check the other factor (n_abs // i), avoiding duplicates for perfect squares\n            if i * i != n_abs:\n                other_factor = n_abs // i\n                if other_factor % 2 == 0:\n                    total_sum += other_factor\n    return total_sum"}
