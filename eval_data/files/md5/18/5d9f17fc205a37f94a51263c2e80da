{"task_id": "Mbpp/615", "solution": "from typing import Tuple, List, Union\n\ndef average_tuple(data: Tuple[Tuple[Union[int, float], ...], ...]) -> List[float]:\n    \"\"\"\n    Calculates the average value for each column across a tuple of tuples.\n    Assumes all inner tuples have the same length and contain numeric values.\n    \"\"\"\n    num_rows = len(data)\n    num_cols = len(data[0])\n\n    # Initialize sums for each column.\n    column_sums = [0.0] * num_cols\n\n    # Accumulate sums for each column.\n    for row in data:\n        for i in range(num_cols):\n            column_sums[i] += float(row[i])\n\n    # Calculate averages.\n    averages = [s / num_rows for s in column_sums]\n\n    return averages"}
{"task_id": "Mbpp/616", "solution": "from .controllers import TupleController\nfrom .validators import TupleValidator\nfrom .services import TupleService\nfrom .exceptions import TupleOpsError, LengthMismatchError, InvalidTypeError, DivisionByZeroError\n\n\ndef tuple_modulo(a: tuple[int, ...], b: tuple[int, ...]) -> tuple[int, ...]:\n    \"\"\"\n    Performs element-wise modulo of two tuples of the same length.\n\n    This function delegates input validation (type, length, zero modulus) and\n    the core modulo computation to internal service components.\n    \"\"\"\n    controller = TupleController(TupleValidator(), TupleService())\n    return controller.compute(a, b)"}
{"task_id": "Mbpp/618", "solution": "def div_list(list1, list2):\n    \"\"\"\n    Divides two lists element-wise, returning a new list of floats.\n    Assumes lists are of equal length and contain numeric values.\n    \"\"\"\n    return [float(a) / float(b) for a, b in zip(list1, list2)]"}
{"task_id": "Mbpp/619", "solution": "def move_num(s: str) -> str:\n    \"\"\"\n    Moves all digit characters in a string to the end while preserving their relative order.\n    Non-digit characters also retain their relative order at the beginning of the string.\n    \"\"\"\n    non_digits = []\n    digits = []\n    for ch in s:\n        if ch.isdigit():\n            digits.append(ch)\n        else:\n            non_digits.append(ch)\n    return \"\".join(non_digits) + \"\".join(digits)"}
{"task_id": "Mbpp/620", "solution": "from typing import List\n\ndef largest_subset(nums: List[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of numbers where every pair is divisible.\n    This uses a dynamic programming approach with O(n^2) time complexity after sorting.\n    \"\"\"\n    if not nums:\n        return 0\n\n    # Sort the numbers to apply dynamic programming.\n    # This ensures that when we consider nums_sorted[i], all potential divisors\n    # nums_sorted[j] (where j < i) have already been processed.\n    nums_sorted = sorted(nums)\n    n = len(nums_sorted)\n\n    # dp[i] will store the length of the largest divisible subset ending with nums_sorted[i].\n    dp = [1] * n\n\n    # max_len will store the overall maximum length found.\n    max_len = 1\n\n    # Fill the dp array\n    for i in range(n):\n        for j in range(i):\n            # Check if nums_sorted[i] is divisible by nums_sorted[j]\n            if nums_sorted[i] % nums_sorted[j] == 0:\n                # If including nums_sorted[j] leads to a longer subset ending at i\n                if dp[j] + 1 > dp[i]:\n                    dp[i] = dp[j] + 1\n        \n        # Update overall maximum length\n        if dp[i] > max_len:\n            max_len = dp[i]\n\n    return max_len"}
{"task_id": "Mbpp/624", "solution": "from typing import Any, Optional\n\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input types.\"\"\"\n    def __init__(self, value: Any, message: Optional[str] = None) -> None:\n        self.value = value\n        self.message = message or f\"Invalid input type: {type(value).__name__}\"\n        super().__init__(self.message)\n\nclass InputValidator:\n    \"\"\"Validates if an input value is a string.\"\"\"\n    def validate(self, value: Any) -> None:\n        if not isinstance(value, str):\n            raise InvalidInputError(value)\n\n    def is_valid(self, value: Any) -> bool:\n        return isinstance(value, str)\n\nclass StringService:\n    \"\"\"Provides business logic for string transformations, including uppercase conversion.\"\"\"\n    def __init__(self, validator: InputValidator) -> None:\n        self._validator = validator\n\n    def to_upper(self, value: str) -> str:\n        self._validator.validate(value)\n        return value.upper()\n\n# Global instances of validator and service as per design\n_validator = InputValidator()\n_service = StringService(validator=_validator)\n\ndef is_upper(value: str) -> str:\n    \"\"\"Converts a given string to its uppercase form, validating input type.\"\"\"\n    return _service.to_upper(value)"}
