{"task_id": "Mbpp/16", "solution": "import re\n\ndef text_lowercase_underscore(text: str) -> bool:\n    \"\"\"\n    Checks if the input string contains sequences of lowercase letters\n    joined with an underscore. The pattern requires at least one lowercase\n    letter, an underscore, and then at least one lowercase letter, with\n    word boundaries.\n    \"\"\"\n    pattern = r'\\b[a-z]+_[a-z]+\\b'\n    return bool(re.search(pattern, text, flags=re.ASCII))"}
{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(src, filters):\n    # Convert the filter string into a set for efficient character lookup.\n    filter_set = set(filters)\n    \n    # Build a list of characters from src that are not in the filter set.\n    out_chars = [ch for ch in src if ch not in filter_set]\n    \n    # Join the characters to form the resulting string.\n    return \"\".join(out_chars)"}
{"task_id": "Mbpp/12", "solution": "import collections\nfrom abc import ABC, abstractmethod\nfrom typing import Any, List, Dict\n\nclass MatrixError(Exception):\n    \"\"\"Base exception for matrix-related errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\nclass ValidationError(MatrixError):\n    \"\"\"Exception raised for input validation errors.\"\"\"\n    def __init__(self, message: str, error_code: str = \"validation_error\") -> None:\n        self.error_code = error_code\n        super().__init__(message)\n\nclass Utils:\n    \"\"\"Utility methods for matrix operations.\"\"\"\n    @staticmethod\n    def is_numeric(value: Any) -> bool:\n        \"\"\"Checks if a value is an integer or a float.\"\"\"\n        return isinstance(value, (int, float))\n\n    @staticmethod\n    def row_sum(row: List[float]) -> float:\n        \"\"\"Calculates the sum of elements in a row.\"\"\"\n        return sum(row)\n\nclass MatrixRow:\n    \"\"\"Represents a single row of a matrix with its original index.\"\"\"\n    def __init__(self, values: List[float], original_index: int) -> None:\n        self.values: List[float] = values\n        self.original_index: int = original_index\n\n    def sum(self) -> float:\n        \"\"\"Calculates the sum of the row's values.\"\"\"\n        return sum(self.values)\n\n    def as_list(self) -> List[float]:\n        \"\"\"Returns the row's values as a list.\"\"\"\n        return list(self.values)\n\nclass Matrix:\n    \"\"\"Represents a matrix as a collection of MatrixRow objects.\"\"\"\n    def __init__(self, rows: List[MatrixRow]) -> None:\n        self._rows = rows\n\n    def to_list(self) -> List[List[float]]:\n        \"\"\"Converts the matrix to a list of lists of floats.\"\"\"\n        return [r.as_list() for r in self._rows]\n\n    def __len__(self) -> int:\n        \"\"\"Returns the number of rows in the matrix.\"\"\"\n        return len(self._rows)\n\nclass PersistenceAdapter(ABC):\n    \"\"\"Abstract base class for persistence adapters.\"\"\"\n    @abstractmethod\n    def save(self, record: Dict) -> None:\n        \"\"\"Saves a record to the persistence layer.\"\"\"\n        pass\n\n    @abstractmethod\n    def get_all(self) -> List[Dict]:\n        \"\"\"Retrieves all records from the persistence layer.\"\"\"\n        pass\n\nclass MatrixValidator:\n    \"\"\"Validates raw input and converts it into a Matrix object.\"\"\"\n    def __init__(self, require_rectangular: bool = False) -> None:\n        self.require_rectangular = require_rectangular\n\n    def validate(self, matrix_raw: Any) -> Matrix:\n        \"\"\"Validates raw input and converts it to a Matrix object.\"\"\"\n        if not isinstance(matrix_raw, list):\n            raise ValidationError(\"Matrix must be a list of rows\")\n        rows: List[MatrixRow] = []\n        expected_len = None\n        for idx, row_raw in enumerate(matrix_raw):\n            if not isinstance(row_raw, list):\n                raise ValidationError(f\"Row {idx} is not a list\")\n            if self.require_rectangular:\n                if expected_len is None:\n                    expected_len = len(row_raw)\n                elif len(row_raw) != expected_len:\n                    raise ValidationError(\"Matrix must be rectangular\")\n            values: List[float] = []\n            for val in row_raw:\n                if not Utils.is_numeric(val):\n                    raise ValidationError(f\"Non-numeric value in row {idx}\")\n                values.append(float(val))\n            rows.append(MatrixRow(values, idx))\n        return Matrix(rows)\n\nclass MatrixService:\n    \"\"\"Provides core business logic for matrix operations, including sorting.\"\"\"\n    def __init__(self, persistence_adapter: PersistenceAdapter | None = None) -> None:\n        self._persistence = persistence_adapter\n\n    def sort_matrix(self, matrix: Matrix) -> Matrix:\n        \"\"\"Sorts a Matrix by row sum in ascending order, stably.\"\"\"\n        sorted_rows = self._stable_sort_rows(matrix._rows)\n        result = Matrix(sorted_rows)\n        if self._persistence:\n            record = {\"input\": matrix.to_list(), \"output\": result.to_list()}\n            try:\n                self._persistence.save(record)\n            except Exception as e:\n                raise MatrixError(\"Persistence error\") from e\n        return result\n\n    def _stable_sort_rows(self, rows: List[MatrixRow]) -> List[MatrixRow]:\n        \"\"\"Sorts a list of MatrixRow objects stably by sum and original index.\"\"\"\n        return sorted(rows, key=lambda r: (Utils.row_sum(r.values), r.original_index))\n\ndef sort_matrix(matrix: List[List[int | float]]) -> List[List[float]]:\n    \"\"\"\n    Sorts a given matrix in ascending order according to the sum of its rows.\n    Uses internal components for validation and stable sorting.\n    \"\"\"\n    validator = MatrixValidator()\n    service = MatrixService()\n    \n    # Validate and convert raw input to internal Matrix object\n    internal_matrix = validator.validate(matrix)\n    \n    # Perform the sorting\n    sorted_internal_matrix = service.sort_matrix(internal_matrix)\n    \n    # Convert the sorted internal Matrix back to a list of lists for output\n    return sorted_internal_matrix.to_list()"}
{"task_id": "Mbpp/19", "solution": "from abc import ABC, abstractmethod\nfrom typing import List, Optional, Any, Callable\n\nclass DuplicateCheckError(Exception):\n    \"\"\"\n    Custom exception for errors during duplicate checking.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass Validators:\n    \"\"\"\n    Utility class for validating input arrays.\n    \"\"\"\n    @staticmethod\n    def validate_array(arr: Any) -> None:\n        if arr is None or not isinstance(arr, (list, tuple)):\n            raise DuplicateCheckError(\"Input must be a list or tuple of integers.\")\n        for i, v in enumerate(arr):\n            if not isinstance(v, int):\n                raise DuplicateCheckError(f\"Element at index {i} is not an int: {v!r}\")\n\nclass DuplicateChecker(ABC):\n    \"\"\"\n    Abstract base class defining the interface for duplicate detection strategies.\n    \"\"\"\n    @abstractmethod\n    def has_duplicates(self, arr: List[int]) -> bool:\n        raise NotImplementedError\n\nclass HashSetDuplicateChecker(DuplicateChecker):\n    \"\"\"\n    Duplicate checker implementation using a hash set (O(n) time, O(n) space).\n    \"\"\"\n    def has_duplicates(self, arr: List[int]) -> bool:\n        seen = set()\n        try:\n            for x in arr:\n                if x in seen:\n                    return True\n                seen.add(x)\n            return False\n        except TypeError as e:\n            raise DuplicateCheckError(f\"Unhashable element encountered: {e}\")\n\nclass SortDuplicateChecker(DuplicateChecker):\n    \"\"\"\n    Duplicate checker implementation using sorting (O(n log n) time, O(n) or O(1) space).\n    \"\"\"\n    def has_duplicates(self, arr: List[int]) -> bool:\n        sorted_arr = sorted(arr)  # Create a copy to avoid modifying the original array\n        for i in range(len(sorted_arr) - 1):\n            if sorted_arr[i] == sorted_arr[i+1]:\n                return True\n        return False\n\nclass DuplicateRequest:\n    \"\"\"\n    Data Transfer Object for duplicate check requests.\n    \"\"\"\n    def __init__(self, arr: List[int], strategy: Optional[str] = None) -> None:\n        self.arr = arr\n        self.strategy = strategy\n\nclass DuplicateResponse:\n    \"\"\"\n    Data Transfer Object for duplicate check responses.\n    \"\"\"\n    def __init__(self, has_duplicates: bool) -> None:\n        self.has_duplicates = has_duplicates\n\nclass DuplicateService:\n    \"\"\"\n    Service layer to orchestrate duplicate checks, including validation and strategy resolution.\n    \"\"\"\n    def __init__(self, checker_factory: Callable[[Optional[str]], DuplicateChecker] = None) -> None:\n        self._checker_factory = checker_factory if checker_factory is not None else self._default_checker_factory\n\n    def _default_checker_factory(self, strategy: Optional[str]) -> DuplicateChecker:\n        \"\"\"Resolves and instantiates the appropriate checker strategy.\"\"\"\n        if strategy is None or strategy == \"hash\":\n            return HashSetDuplicateChecker()\n        elif strategy == \"sort\":\n            return SortDuplicateChecker()\n        else:\n            raise DuplicateCheckError(f\"Unknown strategy: {strategy!r}. Expected 'hash' or 'sort'.\")\n\n    def check(self, request: DuplicateRequest) -> DuplicateResponse:\n        \"\"\"Performs the duplicate check for a given request.\"\"\"\n        Validators.validate_array(request.arr)\n        checker = self._checker_factory(request.strategy)\n        has_dups = checker.has_duplicates(request.arr)\n        return DuplicateResponse(has_duplicates=has_dups)\n\nclass DuplicateController:\n    \"\"\"\n    API layer exposing duplicate checking functionality.\n    \"\"\"\n    def __init__(self, service: DuplicateService) -> None:\n        self._service = service\n\n    def test_duplicate(self, request: DuplicateRequest) -> DuplicateResponse:\n        \"\"\"Delegates the duplicate check to the service layer.\"\"\"\n        return self._service.check(request)\n\n# Module-level instances for the public function\n_default_service_instance = DuplicateService()\n_controller_instance = DuplicateController(_default_service_instance)\n\ndef test_duplicate(arr: list[int], strategy: str | None = None) -> bool:\n    \"\"\"\n    Checks if the given array of integers contains any duplicate element.\n    It returns True if duplicates exist, False otherwise.\n    \"\"\"\n    req = DuplicateRequest(arr=arr, strategy=strategy)\n    return _controller_instance.test_duplicate(req).has_duplicates"}
{"task_id": "Mbpp/56", "solution": "def check(n):\n    \"\"\"\n    Checks if a number is one less than twice its reverse, preserving sign.\n    Trailing zeros of the absolute value are dropped when reversing.\n    \"\"\"\n    # Calculate the reverse of n, preserving its sign\n    sign = -1 if n < 0 else 1\n    abs_str = str(abs(n))\n    reversed_abs_str = abs_str[::-1].lstrip(\"0\")\n\n    reversed_n = sign * int(reversed_abs_str) if reversed_abs_str else 0\n\n    # Check the condition: n == (2 * reversed_n) - 1\n    return n == (2 * reversed_n) - 1"}
{"task_id": "Mbpp/57", "solution": "from typing import List\n\ndef find_Max_Num(digits: List[int]) -> int:\n    \"\"\"\n    Finds the largest number that can be formed with the given list of digits.\n    The digits are sorted in descending order and then concatenated to form the integer.\n    \"\"\"\n    sorted_digits = sorted(digits, reverse=True)\n\n    result = 0\n    for digit in sorted_digits:\n        result = result * 10 + digit\n    return result"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(n: int) -> bool:\n    \"\"\"\n    Checks if the given number is a Woodall number.\n    A Woodall number is defined as n = k * 2^k - 1 for some integer k >= 1.\n    \"\"\"\n    # MAX_SAFE_POWER limits the magnitude of 2^k to align with 64-bit integer bounds,\n    # preventing excessively large intermediate calculations as per design context's MathUtils.MAX_SAFE.\n    MAX_SAFE_POWER = 2**63 - 1\n\n    k = 1\n    while True:\n        pow2 = 1 << k  # Calculate 2^k using bit shift\n\n        # If 2^k exceeds the defined safe limit, n cannot be a Woodall number\n        # formed by this k or any larger k within typical computation limits.\n        if pow2 > MAX_SAFE_POWER:\n            return False\n\n        value = k * pow2 - 1\n\n        if value == n:\n            return True\n        if value > n:\n            # If the calculated Woodall number (k*2^k - 1) exceeds n,\n            # then n cannot be a Woodall number since the function k*2^k - 1 is strictly increasing for k >= 1.\n            return False\n        k += 1"}
{"task_id": "Mbpp/58", "solution": "def opposite_Signs(a, b):\n    \"\"\"\n    Checks if two integers have opposite signs, considering zero as non-opposite.\n    Returns True if one is positive and the other is negative, False otherwise.\n    \"\"\"\n    if a == 0 or b == 0:\n        return False\n    return (a < 0) != (b < 0)"}
{"task_id": "Mbpp/59", "solution": "def is_octagonal(n: int) -> int:\n    \"\"\"\n    Computes the nth octagonal number using the closed-form formula.\n    Assumes n is an integer greater than or equal to 1.\n    \"\"\"\n    return n * (3 * n - 2)"}
{"task_id": "Mbpp/62", "solution": "def smallest_num(numbers):\n    # This function finds the smallest number in a list of numbers.\n    # It assumes the input list is not empty and contains only numbers.\n    min_val = numbers[0]\n    for num in numbers:\n        if num < min_val:\n            min_val = num\n    return min_val"}
{"task_id": "Mbpp/63", "solution": "from typing import Iterable, Tuple, Union\n\ndef max_difference(pairs: Iterable[Tuple[Union[int, float], Union[int, float]]]) -> Union[int, float]:\n    \"\"\"\n    Finds the maximum absolute difference between elements in each pair in a list of tuples.\n    Returns an int if all input numbers are integers, otherwise returns a float.\n    \"\"\"\n    max_diff_val: Union[int, float, None] = None\n    has_float_in_input = False\n\n    for pair in pairs:\n        a, b = pair\n        \n        if isinstance(a, float) or isinstance(b, float):\n            has_float_in_input = True\n            \n        current_diff = abs(a - b)\n        \n        if max_diff_val is None or current_diff > max_diff_val:\n            max_diff_val = current_diff\n            \n    if not has_float_in_input:\n        return int(max_diff_val)\n    else:\n        return float(max_diff_val)"}
{"task_id": "Mbpp/64", "solution": "from typing import List, Tuple\n\ndef subject_marks(tuples_list: List[Tuple[str, int]]) -> List[Tuple[str, int]]:\n    \"\"\"\n    Sorts a list of tuples based on the second value of each tuple.\n    The sorting order is ascending by the numeric second value.\n    \"\"\"\n    return sorted(tuples_list, key=lambda item: item[1])"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts the number of substrings where the sum of their digits equals their length.\n    Uses an O(n) prefix sum and hash map approach.\n    \"\"\"\n    if not s:\n        return 0\n\n    # freq stores the count of (prefix_sum - index) values encountered so far.\n    # Initialize with {0: 1} to account for the \"empty prefix\" at index 0, where prefix_sum=0 and index=0.\n    freq = {0: 1}\n    current_prefix_sum = 0\n    total_count = 0\n\n    for i, char_digit in enumerate(s):\n        digit = int(char_digit)\n        current_prefix_sum += digit\n\n        # Calculate the transformed value: (sum of digits up to current index) - (length of prefix up to current index).\n        # Length of prefix up to current index 'i' is (i + 1).\n        transformed_value = current_prefix_sum - (i + 1)\n\n        # If this transformed_value has been seen before, each previous occurrence means\n        # there's a substring ending at 'i' whose sum of digits equals its length.\n        previous_occurrences = freq.get(transformed_value, 0)\n        total_count += previous_occurrences\n\n        # Update the frequency of the current transformed_value.\n        freq[transformed_value] = previous_occurrences + 1\n\n    return total_count"}
{"task_id": "Mbpp/65", "solution": "from typing import Any\n\ndef recursive_list_sum(input_list: Any) -> float:\n    \"\"\"\n    Flattens a list, summing all numeric elements recursively.\n    Non-numeric and non-sequence elements are ignored.\n    \"\"\"\n    total_sum = 0.0\n\n    def _traverse(item: Any):\n        nonlocal total_sum\n        # Check if the item is a number (int or float) but not a boolean\n        if isinstance(item, (int, float)) and not isinstance(item, bool):\n            total_sum += float(item)\n        # Check if the item is a list or a tuple, then recurse\n        elif isinstance(item, (list, tuple)):\n            for sub_item in item:\n                _traverse(sub_item)\n        # Otherwise, the item is ignored (e.g., strings, dicts, None, etc.)\n\n    _traverse(input_list)\n    return total_sum"}
{"task_id": "Mbpp/66", "solution": "from typing import List, Union\n\n# Define the Number type alias as specified in the design context.\nNumber = Union[int, float]\n\n# Define the custom exception as specified in src/pos_counter/exceptions.py.\nclass InvalidInputError(ValueError):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\n# Define the is_positive helper function as specified in src/pos_counter/utils.py.\ndef is_positive(value: Number) -> bool:\n    \"\"\"Checks if a numeric value is strictly positive.\"\"\"\n    if not isinstance(value, (int, float)):\n        raise TypeError(\"is_positive expects int or float\")\n    return value > 0\n\n# Define the validate_number_list helper function as specified in src/pos_counter/utils.py.\ndef validate_number_list(numbers: object) -> List[Number]:\n    \"\"\"Validates input is an iterable of numbers and returns a list.\"\"\"\n    if numbers is None:\n        raise InvalidInputError(\"Input cannot be None\")\n    if not hasattr(numbers, \"__iter__\") or isinstance(numbers, (str, bytes)):\n        raise InvalidInputError(\"Input must be an iterable of numbers\")\n    result = []\n    for i, item in enumerate(numbers):\n        if not isinstance(item, (int, float)):\n            raise InvalidInputError(f\"Item at index {i} is not numeric: {item!r}\")\n        result.append(item)\n    return result\n\ndef pos_count(numbers: List[Number]) -> int:\n    \"\"\"Counts the number of positive numbers in a list.\"\"\"\n    validated_numbers = validate_number_list(numbers)\n    count = sum(1 for x in validated_numbers if is_positive(x))\n    return count"}
{"task_id": "Mbpp/67", "solution": "import os\nimport json\nfrom typing import Optional, Dict, Any, List\nfrom datetime import datetime, timezone\n\nclass InvalidInputError(Exception):\n    \"\"\"Raised when input is invalid.\"\"\"\n    pass\n\nclass CacheError(Exception):\n    \"\"\"Raised when there's an issue with cache operations.\"\"\"\n    pass\n\nclass Validator:\n    \"\"\"Validates and normalizes input values.\"\"\"\n    def validate_n(self, n: Any) -> int:\n        try:\n            n_int = int(n)\n        except (ValueError, TypeError):\n            raise InvalidInputError(\"n must be an integer.\")\n        if n_int < 0:\n            raise InvalidInputError(\"n must be non-negative.\")\n        return n_int\n\nclass CacheRepository:\n    \"\"\"Abstract interface for caching Bell numbers.\"\"\"\n    def get(self, n: int) -> Optional[int]:\n        raise NotImplementedError\n    def set(self, n: int, value: int) -> None:\n        raise NotImplementedError\n    def close(self) -> None:\n        pass\n\nclass JsonCacheRepository(CacheRepository):\n    \"\"\"File-backed JSON cache for Bell numbers.\"\"\"\n    def __init__(self, path: Optional[str] = None):\n        self.path = os.path.expanduser(path or \"~/.cache/bell_cache.json\")\n        self._data: Dict[str, Dict[str, Any]] = {}\n        os.makedirs(os.path.dirname(self.path), exist_ok=True)\n        self._needs_flush = False\n        self._load()\n\n    def _load(self) -> None:\n        if os.path.exists(self.path):\n            try:\n                with open(self.path, 'r', encoding='utf-8') as f:\n                    self._data = json.load(f)\n            except json.JSONDecodeError as e:\n                raise CacheError(f\"Cache file corrupted: {self.path}. Error: {e}\") from e\n            except IOError as e:\n                raise CacheError(f\"Error reading cache file: {self.path}. Error: {e}\") from e\n\n    def get(self, n: int) -> Optional[int]:\n        entry = self._data.get(str(n))\n        if entry and \"value\" in entry:\n            return int(entry[\"value\"])\n        return None\n\n    def set(self, n: int, value: int) -> None:\n        self._data[str(n)] = {\"value\": value, \"computed_at\": self._now_iso()}\n        self._needs_flush = True\n\n    def _now_iso(self) -> str:\n        \"\"\"Helper to get current time in ISO 8601 format.\"\"\"\n        return datetime.now(timezone.utc).isoformat(timespec='seconds') + 'Z'\n\n    def flush(self) -> None:\n        \"\"\"Writes current cache data to disk atomically.\"\"\"\n        if not self._needs_flush:\n            return\n\n        temp_path = self.path + \".tmp\"\n        try:\n            with open(temp_path, 'w', encoding='utf-8') as f:\n                json.dump(self._data, f, indent=2)\n            os.replace(temp_path, self.path)\n            self._needs_flush = False\n        except IOError as e:\n            raise CacheError(f\"Error writing cache file: {self.path}. Error: {e}\") from e\n\n    def close(self) -> None:\n        self.flush()\n\nclass BellCalculator:\n    \"\"\"Computes Bell numbers using dynamic programming with memoization and optional caching.\"\"\"\n    def __init__(self, cache_repo: Optional[CacheRepository] = None):\n        self._cache_repo = cache_repo\n        self._local_memo: Dict[int, int] = {0: 1} # B(0) = 1\n\n    def bell_number(self, n: int) -> int:\n        \"\"\"\n        Calculates the nth Bell number.\n        Uses in-process memoization and an optional cache repository.\n        \"\"\"\n        if n in self._local_memo:\n            return self._local_memo[n]\n\n        if self._cache_repo:\n            try:\n                cached_value = self._cache_repo.get(n)\n                if cached_value is not None:\n                    self._local_memo[n] = cached_value\n                    return cached_value\n            except CacheError as e:\n                raise e # Re-raise cache error for caller to handle.\n\n        value = self._bell_triangle(n)\n        self._local_memo[n] = value\n\n        if self._cache_repo:\n            try:\n                self._cache_repo.set(n, value)\n            except CacheError as e:\n                raise e # Re-raise cache error for caller to handle.\n        return value\n\n    def _bell_triangle(self, n: int) -> int:\n        \"\"\"\n        Computes the nth Bell number using the Bell triangle algorithm (Aitken's array).\n        Returns B_n, the first element of the (n+1)th row of the triangle (0-indexed).\n        \"\"\"\n        if n == 0:\n            return 1\n        \n        row: List[int] = [1] # Represents B_0\n        for i in range(1, n + 1):\n            next_row: List[int] = [row[-1]] # T(i, 1) = T(i-1, i-1)\n            for j in range(1, i + 1):\n                # T(i, j) = T(i, j-1) + T(i-1, j-1)\n                next_row.append(next_row[-1] + row[j-1])\n            row = next_row\n        \n        return row[0] # B_n is the first element of the nth computed row.\n\ndef bell_number(n: int, use_cache: bool = True, cache_file: Optional[str] = None) -> int:\n    \"\"\"\n    Finds the number of ways to partition an n-element set (the nth Bell number).\n\n    Args:\n        n: The non-negative integer for which to compute the Bell number.\n        use_cache: If True, uses a file-based cache to store/retrieve results.\n        cache_file: Optional path to the cache file. Defaults to ~/.cache/bell_cache.json if None.\n\n    Returns:\n        The nth Bell number.\n    \"\"\"\n    Validator().validate_n(n)\n    \n    repo: Optional[JsonCacheRepository] = None\n    if use_cache:\n        repo = JsonCacheRepository(cache_file)\n        \n    calc = BellCalculator(cache_repo=repo)\n    try:\n        return calc.bell_number(n)\n    finally:\n        if repo:\n            repo.close()"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array: list) -> bool:\n    \"\"\"\n    Checks if a given array is monotonic (non-decreasing or non-increasing).\n    An empty or single-element array is considered monotonic.\n    \"\"\"\n    if len(array) <= 1:\n        return True\n\n    is_non_decreasing = True\n    is_non_increasing = True\n\n    for i in range(1, len(array)):\n        if array[i] < array[i-1]:\n            is_non_decreasing = False\n        if array[i] > array[i-1]:\n            is_non_increasing = False\n\n    return is_non_decreasing or is_non_increasing"}
{"task_id": "Mbpp/72", "solution": "from .utils import validate_integer\nfrom .repository import InMemoryCheckRepository\nfrom .services import DifferenceOfSquaresService\nfrom .exceptions import InvalidInputError\n\n_repo = InMemoryCheckRepository()\n_service = DifferenceOfSquaresService(_repo)\n\ndef dif_Square(n: object) -> bool:\n    \"\"\"Checks if a number can be represented as the difference of two squares.\n    Delegates input validation and core logic to the service layer.\"\"\"\n    val = validate_integer(n)\n    return _service.can_be_diff_of_squares(val)"}
{"task_id": "Mbpp/70", "solution": "from typing import Sequence, Tuple, Any, List, Set, Optional\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input validation errors.\"\"\"\n    def __init__(self, message: str, index: Optional[int] = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.index = index\n\nclass ApplicationError(Exception):\n    \"\"\"Generic application-level exceptions.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass TupleCollection:\n    \"\"\"Encapsulates a sequence of tuples and provides length-related metadata.\"\"\"\n    def __init__(self, tuples: Sequence[Tuple[Any, ...]]) -> None:\n        self.tuples = tuples\n        self.lengths: List[int] = self.compute_lengths()\n\n    def compute_lengths(self) -> List[int]:\n        \"\"\"Computes and returns a list of lengths for each tuple.\"\"\"\n        return [len(t) for t in self.tuples]\n\n    def unique_lengths(self) -> Set[int]:\n        \"\"\"Returns the set of unique lengths found among the tuples.\"\"\"\n        return set(self.lengths)\n\n    def is_empty(self) -> bool:\n        \"\"\"Returns True if the collection of tuples is empty.\"\"\"\n        return not self.tuples\n\nclass TupleValidator:\n    \"\"\"Validates that the input is an iterable of tuple instances.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def validate_container(self, tuples: Any) -> None:\n        \"\"\"Ensures the outer container is iterable (list or tuple).\"\"\"\n        if not isinstance(tuples, (list, tuple)):\n            raise ValidationError(\"Input must be a list or tuple of tuples.\", index=None)\n\n    def validate_elements_are_tuples(self, tuples: Sequence[Any]) -> None:\n        \"\"\"Ensures each element in the sequence is a tuple.\"\"\"\n        for i, item in enumerate(tuples):\n            if not isinstance(item, tuple):\n                raise ValidationError(f\"Element at index {i} is not a tuple.\", index=i)\n\nclass TupleLengthService:\n    \"\"\"Determines whether all tuple lengths in a collection are equal.\"\"\"\n    def __init__(self, validator: Optional[TupleValidator] = None) -> None:\n        self._validator = validator or TupleValidator()\n\n    def are_lengths_equal(self, tuples: Sequence[Tuple[Any, ...]]) -> bool:\n        \"\"\"Validates input and checks if all tuples have the same length.\"\"\"\n        self._validator.validate_container(tuples)\n        self._validator.validate_elements_are_tuples(tuples)\n\n        collection = TupleCollection(tuples)\n\n        if collection.is_empty():\n            return True\n\n        return len(collection.unique_lengths()) == 1\n\ndef get_equal(tuples: Sequence[Tuple[Any, ...]]) -> bool:\n    \"\"\"\n    Returns True if all tuples in the sequence have equal length, False otherwise.\n    Raises ValidationError for invalid input types.\n    \"\"\"\n    service = TupleLengthService()\n    return service.are_lengths_equal(tuples)"}
{"task_id": "Mbpp/69", "solution": "from typing import Sequence, List, TypeVar\n\nT = TypeVar(\"T\")\n\ndef _compute_lps(pattern: Sequence[T]) -> List[int]:\n    \"\"\"Computes the Longest Proper Prefix which is also Suffix (LPS) array for KMP.\"\"\"\n    m = len(pattern)\n    lps = [0] * m\n    length = 0  # length of the previous longest prefix suffix\n    i = 1\n    while i < m:\n        if pattern[i] == pattern[length]:\n            length += 1\n            lps[i] = length\n            i += 1\n        else:\n            if length != 0:\n                length = lps[length - 1]\n            else:\n                lps[i] = 0\n                i += 1\n    return lps\n\ndef is_sublist(haystack: Sequence[T], needle: Sequence[T]) -> bool:\n    \"\"\"Checks if a list contains the given contiguous sublist using the KMP algorithm.\"\"\"\n    n = len(haystack)\n    m = len(needle)\n\n    if m == 0:\n        return True\n\n    if m > n:\n        return False\n\n    lps = _compute_lps(needle)\n\n    i = 0  # index for haystack\n    j = 0  # index for needle\n\n    while i < n:\n        if haystack[i] == needle[j]:\n            i += 1\n            j += 1\n\n        if j == m:  # Needle found\n            return True\n        elif i < n and haystack[i] != needle[j]:\n            if j != 0:\n                j = lps[j - 1]\n            else:\n                i += 1\n\n    return False"}
{"task_id": "Mbpp/74", "solution": "from typing import Sequence, Any, Dict, Tuple\n\ndef is_samepatterns(patterns: Sequence[Any], values: Sequence[Any]) -> bool:\n    \"\"\"\n    Checks if two sequences follow the same pattern mapping (bijective and position-preserving).\n    Assumes inputs are sequences of hashable items and have the same length.\n    \"\"\"\n    p2v: Dict[Any, Any] = {}  # Map from pattern element to value element\n    v2p: Dict[Any, Any] = {}  # Map from value element to pattern element\n\n    for p, v in zip(patterns, values):\n        if p not in p2v and v not in v2p:\n            # Both elements are new, establish a new mapping in both directions\n            p2v[p] = v\n            v2p[v] = p\n        else:\n            # One or both elements are already in the mappings. Check for consistency.\n            # If the current mapping (p->v) is inconsistent with a previously established one,\n            # or if the reverse mapping (v->p) is inconsistent, then patterns don't match.\n            if p2v.get(p) != v or v2p.get(v) != p:\n                return False  # Inconsistent mapping found\n    return True"}
{"task_id": "Mbpp/71", "solution": "import time\nfrom typing import Sequence, List, Optional, Callable, Any, Tuple, TypeVar\nfrom dataclasses import dataclass\n\n# Type variable for generics\nT = TypeVar('T')\n\nclass SortError(Exception):\n    \"\"\"Custom exception for sorting errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n    def __str__(self) -> str:\n        return self.message\n\n@dataclass\nclass SortResult:\n    \"\"\"Result of a sort operation with metadata.\"\"\"\n    sorted_list: List[Any]\n    passes: int\n    comparisons: int\n    swaps: int\n    elapsed_ms: float\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Serializes the SortResult to a dictionary.\"\"\"\n        return {\n            \"sorted_list\": self.sorted_list,\n            \"passes\": self.passes,\n            \"comparisons\": self.comparisons,\n            \"swaps\": self.swaps,\n            \"elapsed_ms\": self.elapsed_ms,\n        }\n\n    @staticmethod\n    def from_dict(d: Dict[str, Any]) -> \"SortResult\":\n        \"\"\"Creates a SortResult object from a dictionary.\"\"\"\n        return SortResult(\n            sorted_list=d[\"sorted_list\"],\n            passes=d[\"passes\"],\n            comparisons=d[\"comparisons\"],\n            swaps=d[\"swaps\"],\n            elapsed_ms=d[\"elapsed_ms\"],\n        )\n\ndef ensure_sequence(obj: Any) -> List[Any]:\n    \"\"\"Ensures the object is a list, raising SortError if not iterable.\"\"\"\n    try:\n        return list(obj)\n    except TypeError as e:\n        raise SortError(\"Items must be iterable\") from e\n\ndef safe_key_apply(key: Optional[Callable[[Any], Any]], value: Any) -> Any:\n    \"\"\"Applies key safely, rewrapping exceptions as SortError.\"\"\"\n    if key is None:\n        return value\n    try:\n        return key(value)\n    except Exception as e:\n        raise SortError(f\"Key function failed for value '{value}': {e}\") from e\n\ndef timeit_ms(callable_obj: Callable[..., T], *args: Any, **kwargs: Any) -> Tuple[T, float]:\n    \"\"\"Executes a function and returns its result and elapsed time in ms.\"\"\"\n    start_time = time.perf_counter()\n    result = callable_obj(*args, **kwargs)\n    end_time = time.perf_counter()\n    elapsed_ms = (end_time - start_time) * 1000\n    return result, elapsed_ms\n\nclass Sorter:\n    \"\"\"Abstract interface that defines sorting contract.\"\"\"\n    def sort(self, items: Sequence[T], key: Optional[Callable[[T], Any]] = None, reverse: bool = False) -> SortResult:\n        \"\"\"Performs sorting and returns SortResult with metadata.\"\"\"\n        raise NotImplementedError\n    def validate_parameters(self) -> None:\n        \"\"\"Validates internal parameters.\"\"\"\n        pass\n\nDEFAULT_SHRINK = 1.3\n\nclass CombSorter(Sorter):\n    \"\"\"Implements the Comb Sort algorithm.\"\"\"\n    def __init__(self, shrink_factor: float = DEFAULT_SHRINK, debug: bool = False) -> None:\n        \"\"\"Initializes sorter with shrink factor and debug flag.\"\"\"\n        if shrink_factor <= 1.0:\n            raise ValueError(\"shrink_factor must be > 1.0\")\n        self._shrink_factor = float(shrink_factor)\n        self._debug = bool(debug)\n\n    def _comb_pass(self, arr: List[Any], gap: int, key: Optional[Callable[[Any], Any]], reverse: bool) -> Tuple[int, int, bool]:\n        \"\"\"Performs a single comb pass over the array for a given gap.\"\"\"\n        swaps = 0\n        comparisons = 0\n        has_swapped = False\n        n = len(arr)\n        for i in range(n - gap):\n            comparisons += 1\n            val1_mapped = safe_key_apply(key, arr[i])\n            val2_mapped = safe_key_apply(key, arr[i + gap])\n\n            if (not reverse and val1_mapped > val2_mapped) or \\\n               (reverse and val1_mapped < val2_mapped):\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swaps += 1\n                has_swapped = True\n        return swaps, comparisons, has_swapped\n\n    def sort(self, items: Sequence[T], key: Optional[Callable[[T], Any]] = None, reverse: bool = False) -> SortResult:\n        \"\"\"Sorts the items using Comb Sort and returns a SortResult.\"\"\"\n        arr = ensure_sequence(items)\n        n = len(arr)\n        gap = n\n        total_swaps = 0\n        total_comparisons = 0\n        passes = 0\n        has_swapped_in_overall_process = True \n\n        def _run_comb_sort_algorithm():\n            nonlocal gap, total_swaps, total_comparisons, passes, has_swapped_in_overall_process\n            \n            while gap > 1 or has_swapped_in_overall_process:\n                passes += 1\n                \n                gap = int(gap / self._shrink_factor)\n                if gap < 1:\n                    gap = 1\n\n                has_swapped_in_overall_process = False \n                \n                current_pass_swaps, current_pass_comparisons, current_pass_has_swapped = self._comb_pass(arr, gap, key, reverse)\n                \n                total_swaps += current_pass_swaps\n                total_comparisons += current_pass_comparisons\n                \n                if current_pass_has_swapped:\n                    has_swapped_in_overall_process = True\n\n            return arr \n\n        sorted_list_result, elapsed_ms = timeit_ms(_run_comb_sort_algorithm)\n\n        return SortResult(\n            sorted_list=sorted_list_result,\n            passes=passes,\n            comparisons=total_comparisons,\n            swaps=total_swaps,\n            elapsed_ms=elapsed_ms\n        )\n\ndef comb_sort(items: Sequence[T], key: Optional[Callable[[T], Any]] = None, reverse: bool = False) -> List[T]:\n    \"\"\"Sorts a list of elements using the Comb Sort algorithm.\"\"\"\n    return CombSorter().sort(items, key=key, reverse=reverse).sorted_list"}
