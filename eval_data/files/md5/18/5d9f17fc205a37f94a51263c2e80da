{"task_id": "Mbpp/133", "solution": "import collections.abc\nfrom typing import Sequence, Any, List\n\nclass InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass ListValidator:\n    \"\"\"Validates that the input is a sequence of numbers.\"\"\"\n    def validate(self, numbers: Sequence[Any]) -> None:\n        if not isinstance(numbers, (list, tuple)):\n            raise InvalidInputError(\"Input must be a list or tuple.\")\n        for i, v in enumerate(numbers):\n            if not self._is_numeric(v):\n                raise InvalidInputError(f\"Element at index {i} is not numeric: {v!r}\")\n\n    def _is_numeric(self, value: Any) -> bool:\n        \"\"\"Checks if a value is an int or float, excluding boolean.\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\nclass NegativeNumberRepository:\n    \"\"\"Provides methods to filter and sum lists of numbers.\"\"\"\n    def filter_negatives(self, numbers: Sequence[float]) -> List[float]:\n        return [float(x) for x in numbers if float(x) < 0.0]\n\n    def sum_list(self, numbers: Sequence[float]) -> float:\n        return float(sum(numbers))\n\nclass NegativeSumService:\n    \"\"\"Orchestrates validation, filtering, and summation of negative numbers.\"\"\"\n    def __init__(self, repo: NegativeNumberRepository, validator: ListValidator):\n        self._repo = repo\n        self._validator = validator\n\n    def sum_negatives(self, numbers: Sequence[Any]) -> float:\n        self._validator.validate(numbers)\n        negatives = self._repo.filter_negatives(numbers)\n        return self._repo.sum_list(negatives)\n\ndef sum_negativenum(numbers: Sequence[float | int]) -> float:\n    \"\"\"\n    Calculates the sum of negative numbers from a given list.\n    Handles input validation and returns 0.0 if no negatives are found.\n    \"\"\"\n    service = NegativeSumService(repo=NegativeNumberRepository(), validator=ListValidator())\n    return service.sum_negatives(numbers)"}
{"task_id": "Mbpp/135", "solution": "from typing import Optional\n\nclass InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass RepositoryError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nMAX_N: int = 10_000_000\n\ndef validate_n(n: any, max_n: int) -> None:\n    \"\"\"Validates if n is an integer within the allowed range.\"\"\"\n    if not isinstance(n, int):\n        raise InvalidInputError(f\"n must be an int, got {type(n).__name__}\")\n    if n < 1 or n > max_n:\n        raise InvalidInputError(f\"n must be between 1 and {max_n}, got {n}\")\n\nclass HexagonalRepository:\n    \"\"\"Manages an in-memory cache for hexagonal numbers.\"\"\"\n    def __init__(self) -> None:\n        self._cache: dict[int, int] = {}\n\n    def get(self, n: int) -> Optional[int]:\n        return self._cache.get(n)\n\n    def put(self, n: int, value: int) -> None:\n        self._cache[n] = value\n\n    def clear(self) -> None:\n        self._cache.clear()\n\nclass HexagonalService:\n    \"\"\"Computes hexagonal numbers, handling validation and caching.\"\"\"\n    def __init__(self, repo: HexagonalRepository, max_n: int) -> None:\n        self._repo = repo\n        self._max_n = max_n\n\n    def get_hexagonal(self, n: int) -> int:\n        validate_n(n, self._max_n)\n        try:\n            cached = self._repo.get(n)\n        except Exception as exc:\n            raise RepositoryError(str(exc))\n        if cached is not None:\n            return cached\n        value = self.compute(n)\n        try:\n            self._repo.put(n, value)\n        except Exception as exc:\n            raise RepositoryError(str(exc))\n        return value\n\n    def compute(self, n: int) -> int:\n        \"\"\"Calculates the nth hexagonal number using the formula.\"\"\"\n        return n * (2 * n - 1)\n\nclass HexagonalController:\n    \"\"\"Delegates requests to the HexagonalService.\"\"\"\n    def __init__(self, service: HexagonalService) -> None:\n        self._service = service\n\n    def get(self, n: int) -> int:\n        return self._service.get_hexagonal(n)\n\ndef get_default_service() -> HexagonalService:\n    \"\"\"Constructs and returns a default HexagonalService instance.\"\"\"\n    repo = HexagonalRepository()\n    service = HexagonalService(repo, MAX_N)\n    return service\n\n_default_controller = HexagonalController(get_default_service())\n\ndef hexagonal_num(n: int) -> int:\n    \"\"\"Calculates the nth hexagonal number, utilizing caching and validation.\"\"\"\n    return _default_controller.get(n)"}
{"task_id": "Mbpp/137", "solution": "import math\n\ndef zero_count(arr: list[int], allow_bool: bool = False, on_division_by_zero: str = \"raise\") -> float:\n    \"\"\"\n    Computes the ratio of zero elements to non-zero elements in a list of integers.\n    Handles input validation and division-by-zero according to specified policies.\n    \"\"\"\n    if not isinstance(arr, (list, tuple)):\n        raise ValueError(\"Input must be a list or tuple of integers\")\n    if len(arr) == 0:\n        raise ValueError(\"Input list must not be empty\")\n\n    zeros = 0\n    nonzeros = 0\n\n    for x in arr:\n        # Validate that each element is an integer.\n        # Booleans are a subclass of int, so they are checked separately if not allowed.\n        if not isinstance(x, int):\n            raise ValueError(\"All elements must be integers (use allow_bool=True to allow booleans)\")\n        if isinstance(x, bool) and not allow_bool:\n            raise ValueError(\"All elements must be integers (use allow_bool=True to allow booleans)\")\n\n        if x == 0:\n            zeros += 1\n        else:\n            nonzeros += 1\n\n    if nonzeros == 0:\n        if on_division_by_zero == \"raise\":\n            raise ZeroDivisionError(\"No non-zero elements to divide by.\")\n        elif on_division_by_zero == \"inf\":\n            return math.inf\n        else:\n            raise ValueError(\"Invalid on_division_by_zero policy. Must be 'raise' or 'inf'.\")\n\n    return float(zeros) / nonzeros"}
{"task_id": "Mbpp/139", "solution": "import math\nfrom typing import Optional, Protocol\nfrom dataclasses import dataclass\n\n# Inlined definitions for dependencies as per \"Design context\" and \"Do NOT call any helper that is not defined inline\"\n# This flattens the modular structure into a single response as required by the strict interpretation of the \"inline\" constraint.\n\n# --- From src/circlelib/adapters/pi_provider.py ---\nclass PiProvider(Protocol):\n    def get_pi(self) -> float:\n        ...\n\nclass MathPiProvider:\n    def get_pi(self) -> float:\n        return math.pi\n\n# StubPiProvider is not directly used by circle_circumference but is part of the adapter layer in the design\nclass StubPiProvider:\n    def __init__(self, pi_value: float):\n        self._pi_value = float(pi_value)\n    def get_pi(self) -> float:\n        return self._pi_value\n\n# --- From src/circlelib/models/circle.py ---\n@dataclass(frozen=True)\nclass Circle:\n    radius: float\n\n    def circumference(self, pi: float) -> float:\n        return 2.0 * pi * self.radius\n\n# --- From src/circlelib/utils/validators.py ---\ndef validate_radius(radius):\n    if not isinstance(radius, (int, float)):\n        raise TypeError(\"radius must be numeric\")\n    if radius < 0:\n        raise ValueError(\"radius must be non-negative\")\n\n# --- From src/circlelib/utils/math_utils.py ---\n# This helper is used in the service layer's compute method if not using Circle.circumference directly.\n# The example snippet for CircumferenceService.compute uses Circle.circumference, so this is not strictly called,\n# but included as it's part of the design's inlined helpers.\ndef multiply(a: float, b: float) -> float:\n    return a * b\n\n# --- From src/circlelib/services/circumference_service.py ---\nclass CircumferenceService:\n    def __init__(self, pi_provider: Optional[PiProvider] = None) -> None:\n        self.pi_provider = pi_provider or MathPiProvider()\n\n    def compute(self, radius: float) -> float:\n        validate_radius(radius)\n        circle = Circle(radius)\n        pi = self.pi_provider.get_pi()\n        return circle.circumference(pi)\n\n# --- From src/circlelib/api.py (the target function) ---\nDEFAULT_PI_PROVIDER = MathPiProvider()\n\ndef circle_circumference(radius: float, pi_provider: Optional[PiProvider] = None) -> float:\n    \"\"\"\n    Computes the circumference of a circle given its radius.\n    Allows injection of a custom PiProvider for specific needs.\n    \"\"\"\n    svc = CircumferenceService(pi_provider or DEFAULT_PI_PROVIDER)\n    return svc.compute(radius)"}
{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(n):\n    \"\"\"\n    Checks if a non-negative integer can be represented as a sum of distinct non-zero powers of 2.\n    This requires the number to be positive and even.\n    \"\"\"\n    return n > 0 and (n & 1) == 0"}
{"task_id": "Mbpp/141", "solution": "from typing import List, TypeVar\n\nT = TypeVar('T')\n\ndef pancake_sort(items: List[T]) -> List[T]:\n    \"\"\"\n    Sorts a list of elements using the pancake sort algorithm.\n    This implementation creates a copy of the input list and sorts it in ascending order.\n    \"\"\"\n    arr = list(items)  # Create a mutable copy to work with\n    n = len(arr)\n\n    def _flip_prefix(current_arr: List[T], k: int) -> List[T]:\n        \"\"\"Reverses the first k elements of the given list and returns a new list.\"\"\"\n        return current_arr[:k][::-1] + current_arr[k:]\n\n    def _find_max_index(current_arr: List[T], size: int) -> int:\n        \"\"\"Finds the index of the maximum element in the first 'size' elements.\"\"\"\n        max_val = current_arr[0]\n        max_idx = 0\n        for i in range(1, size):\n            if current_arr[i] > max_val:\n                max_val = current_arr[i]\n                max_idx = i\n        return max_idx\n\n    for curr_size in range(n, 1, -1):\n        # Find the index of the maximum element in the unsorted part (0 to curr_size-1)\n        max_idx = _find_max_index(arr, curr_size)\n\n        # If the maximum element is not already at its sorted position\n        if max_idx != curr_size - 1:\n            # Move the maximum element to the front if it's not already there\n            if max_idx > 0:\n                arr = _flip_prefix(arr, max_idx + 1)\n            # Move the maximum element (now at the front) to its correct sorted position\n            arr = _flip_prefix(arr, curr_size)\n\n    return arr"}
{"task_id": "Mbpp/140", "solution": "import collections.abc\n\ndef extract_singly(items):\n    \"\"\"\n    Flattens a list of lists into a single set of numbers.\n    Assumes `items` is an iterable of iterables containing numbers.\n    \"\"\"\n    result_set = set()\n    for inner_iterable in items:\n        for number in inner_iterable:\n            result_set.add(number)\n    return result_set"}
{"task_id": "Mbpp/142", "solution": "from typing import Any, List\n\ndef count_samepair(list1: List[Any], list2: List[Any], list3: List[Any]) -> int:\n    \"\"\"\n    Counts items identical in the same position across three given lists.\n    Comparisons stop at the length of the shortest list when using zip.\n    \"\"\"\n    count = 0\n    for item1, item2, item3 in zip(list1, list2, list3):\n        if item1 == item2 == item3:\n            count += 1\n    return count"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of terms (n - 2*i) starting from n for i=0.\n    The sum includes only strictly positive terms from the sequence.\n    \"\"\"\n    if n <= 0:\n        return 0\n\n    total_sum = 0\n    current_term = n\n    while current_term > 0:\n        total_sum += current_term\n        current_term -= 2\n    return total_sum"}
{"task_id": "Mbpp/161", "solution": "from typing import Iterable, Any, Set, List, Union\n\ndef to_hashable_set(iterable: Iterable[Any]) -> Union[Set[Any], Iterable[Any]]:\n    \"\"\"\n    Attempts to convert an iterable into a set for O(1) membership checks.\n    If elements are unhashable, returns the original iterable for linear checks.\n    \"\"\"\n    try:\n        return set(iterable)\n    except TypeError:\n        return iterable\n\ndef remove_elements(source: list[Any], to_remove: Iterable[Any]) -> list[Any]:\n    \"\"\"\n    Removes all elements from the source list that are present in the to_remove iterable.\n    Maintains the original order of elements from the source list.\n    \"\"\"\n    removal_set_or_iterable = to_hashable_set(to_remove)\n    \n    result: List[Any] = []\n\n    if isinstance(removal_set_or_iterable, set):\n        for item in source:\n            if item not in removal_set_or_iterable:\n                result.append(item)\n    else:\n        # Fallback path for unhashable elements, uses the original iterable for comparison.\n        for item in source:\n            if item not in to_remove:\n                result.append(item)\n                \n    return result"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(arr):\n    \"\"\"\n    Finds the maximum difference between any two elements in a given array.\n    Assumes `arr` is a sequence of numbers with at least two elements.\n    \"\"\"\n    it = iter(arr)\n    min_val = max_val = next(it)\n\n    for v in it:\n        if v < min_val:\n            min_val = v\n        elif v > max_val:\n            max_val = v\n            \n    return max_val - min_val"}
{"task_id": "Mbpp/165", "solution": "class InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass Alphabet:\n    DEFAULT_LETTERS = \"abcdefghijklmnopqrstuvwxyz\"\n\n    def __init__(self, letters: str = DEFAULT_LETTERS) -> None:\n        if not isinstance(letters, str) or len(letters) == 0:\n            raise ValueError(\"letters must be a non-empty string\")\n        self._letters = letters.lower()\n\n    def get_position(self, ch: str) -> int | None:\n        if not isinstance(ch, str) or len(ch) == 0:\n            return None\n        c = ch.lower()\n        try:\n            return self._letters.index(c) + 1\n        except ValueError:\n            return None\n\n    def size(self) -> int:\n        return len(self._letters)\n\nclass CountResult:\n    def __init__(self, count: int) -> None:\n        self.count = int(count)\n\n    def to_dict(self) -> dict:\n        return {\"count\": self.count}\n\nclass CharPositionService:\n    def __init__(self, alphabet: Alphabet) -> None:\n        self._alphabet = alphabet\n\n    def count(self, s: str) -> CountResult:\n        if not isinstance(s, str):\n            raise InvalidInputError(\"Input must be a string\")\n        total = 0\n        for idx, ch in enumerate(s, start=1):\n            pos = self._alphabet.get_position(ch)\n            if pos is not None and pos == idx:\n                total += 1\n        return CountResult(total)\n\ndef count_char_position(s: str) -> int:\n    service = CharPositionService(alphabet=Alphabet())\n    return service.count(s).count"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(values: list[int]) -> int:\n    \"\"\"\n    Counts the number of pairs of integers in a list whose bitwise XOR is an even number.\n    This occurs when both integers in a pair have the same parity (both even or both odd).\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for value in values:\n        if (value & 1) == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # Calculate combinations for pairs of even numbers and pairs of odd numbers.\n    # C(n, 2) = n * (n - 1) / 2\n    pairs_from_even = even_count * (even_count - 1) // 2\n    pairs_from_odd = odd_count * (odd_count - 1) // 2\n\n    return pairs_from_even + pairs_from_odd"}
{"task_id": "Mbpp/160", "solution": "import math\nfrom typing import Optional, Tuple\n\ndef find_solution(a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n    \"\"\"\n    Finds integer solutions (x, y) for the linear Diophantine equation ax + by = n.\n    Returns (x, y) as a tuple, or None if no integer solution exists.\n    \"\"\"\n    if a == 0 and b == 0:\n        # Per design, if a and b are both zero, treat as no solution for the purpose of a particular (x,y).\n        return (0, 0) if n == 0 else None\n\n    # Extended Euclidean algorithm to find g = gcd(a, b) and x0, y0 such that ax0 + by0 = g\n    # This implementation is based on the iterative method described in the design context.\n    # Note: The design context specifies returning a particular solution.\n    # It also specifies the `ExtendedGCD` class, but as per instructions,\n    # helper functions must be inline if not already defined elsewhere.\n    def extended_gcd(num1: int, num2: int) -> Tuple[int, int, int]:\n        if num2 == 0:\n            return (abs(num1), 1 if num1 >= 0 else -1, 0)\n\n        old_r, r = num1, num2\n        old_s, s = 1, 0\n        old_t, t = 0, 1\n\n        while r != 0:\n            q = old_r // r\n            old_r, r = r, old_r - q * r\n            old_s, s = s, old_s - q * s\n            old_t, t = t, old_t - q * t\n\n        return (old_r, old_s, old_t)\n\n    g, x0, y0 = extended_gcd(a, b)\n\n    if n % g != 0:\n        return None  # No integer solution if n is not divisible by gcd(a, b)\n\n    # Scale the particular solution (x0, y0) by n/g\n    factor = n // g\n    x = x0 * factor\n    y = y0 * factor\n\n    return (x, y)"}
