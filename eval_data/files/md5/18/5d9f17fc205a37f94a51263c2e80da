{"task_id": "Mbpp/793", "solution": "from typing import Sequence\n\ndef last(arr: Sequence[int], value: int) -> int:\n    \"\"\"\n    Finds the last position (rightmost index) of an element in a sorted array.\n    Returns the index or -1 if the element is not found.\n    \"\"\"\n    if not arr:\n        return -1\n\n    lo, hi = 0, len(arr) - 1\n    result = -1\n\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        if arr[mid] == value:\n            result = mid\n            lo = mid + 1  # Attempt to find further right\n        elif arr[mid] < value:\n            lo = mid + 1\n        else:  # arr[mid] > value\n            hi = mid - 1\n    return result"}
{"task_id": "Mbpp/797", "solution": "def sum_in_range(l, r):\n    \"\"\"\n    Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n    Uses an arithmetic series formula for O(1) performance.\n    \"\"\"\n    # Find the first odd number greater than or equal to l\n    a1 = l if l % 2 == 1 else l + 1\n\n    # Find the last odd number less than or equal to r\n    an = r if r % 2 == 1 else r - 1\n\n    # If the first odd number is greater than the last, there are no odd numbers in the range\n    if a1 > an:\n        return 0\n\n    # Calculate the number of terms (n) in the arithmetic series\n    n = ((an - a1) // 2) + 1\n\n    # Calculate the sum of the arithmetic series: n * (first_term + last_term) / 2\n    total_sum = n * (a1 + an) // 2\n    return total_sum"}
{"task_id": "Mbpp/799", "solution": "```python\ndef left_rotate(value, d):\n    \"\"\"\n    Rotates the bits of a 32-bit integer left by 'd' positions.\n    The rotation is performed on the unsigned 32-bit representation of the number.\n    \"\"\"\n    width = 32\n    # Mask value to its 32-bit unsigned representation\n    normalized_value = value & ((1 << width) - 1)\n    \n    # Normalize shift amount 'd' to be within [0, width-1]\n    d_mod = d % width\n    \n    # Perform the left rotation\n    # (value << d_mod) shifts bits left, potentially overflowing past width\n    # (value >> (width - d_mod)) brings the overflowed bits back from the right\n    # The final & mask ensures the result stays within 32 bits\n    return ((normalized_value << d_mod) | (normalized_value >> (width - d_mod))) & ((1 << width) - 1)\n```"}
{"task_id": "Mbpp/794", "solution": "import re\n\ndef text_starta_endb(text: str) -> bool:\n    \"\"\"\n    Checks if a string starts with 'a', contains any characters, and ends with 'b'.\n    The pattern must match the entire string from beginning to end.\n    \"\"\"\n    pattern = r\"^a.*b$\"\n    match_object = re.match(pattern, text)\n    return bool(match_object)"}
{"task_id": "Mbpp/798", "solution": "class ValidationError(ValueError):\n    \"\"\"Exception raised for invalid input.\"\"\"\n    def __init__(self, message):\n        super().__init__(message)\n\nclass NumericUtils:\n    \"\"\"Utility class for numeric checks.\"\"\"\n    @staticmethod\n    def is_numeric(value):\n        \"\"\"Checks if a value is an integer or float.\"\"\"\n        return isinstance(value, (int, float))\n\nDEFAULT_MAX_ARRAY_SIZE = 10_000_000\n\nclass ArrayValidator:\n    \"\"\"Validates and normalizes input arrays.\"\"\"\n    def __init__(self, max_size):\n        self._max_size = max_size\n\n    def validate(self, numbers):\n        \"\"\"Validates the input and yields numeric elements.\"\"\"\n        if numbers is None:\n            raise ValidationError(\"Input is None\")\n        \n        try:\n            it = iter(numbers)\n        except TypeError:\n            raise ValidationError(\"Input is not iterable\")\n        \n        if hasattr(numbers, \"__len__\") and len(numbers) > self._max_size:\n            raise ValidationError(f\"Input exceeds maximum allowed size of {self._max_size} elements.\")\n        \n        for i, v in enumerate(it):\n            if not NumericUtils.is_numeric(v):\n                raise ValidationError(f\"Element at index {i} is not numeric: {v!r}\")\n            yield float(v)\n\nclass Aggregator:\n    \"\"\"Base class for numeric aggregation strategies.\"\"\"\n    def aggregate(self, numbers):\n        \"\"\"Performs simple summation.\"\"\"\n        total = 0.0\n        for v in numbers:\n            total += v\n        return total\n\nclass KahanAggregator(Aggregator):\n    \"\"\"Aggregator implementing Kahan summation for improved precision.\"\"\"\n    def aggregate(self, numbers):\n        \"\"\"Performs Kahan summation to reduce floating point error.\"\"\"\n        total = 0.0\n        c = 0.0\n        for v in numbers:\n            y = v - c\n            t = total + y\n            c = (t - total) - y\n            total = t\n        return total\n\nclass SumService:\n    \"\"\"Orchestrates validation and aggregation.\"\"\"\n    def __init__(self, validator, aggregator, max_size):\n        self._validator = validator\n        self._aggregator = aggregator\n        self._max_size = max_size\n\n    def compute(self, numbers):\n        \"\"\"Computes the sum of validated numbers.\"\"\"\n        validated_numbers_iterator = self._validator.validate(numbers)\n        return self._aggregator.aggregate(validated_numbers_iterator)\n\nclass ArraySumController:\n    \"\"\"Controller for array sum operations.\"\"\"\n    def __init__(self, service):\n        self._service = service\n\n    def compute(self, numbers):\n        \"\"\"Delegates computation to the sum service.\"\"\"\n        return self._service.compute(numbers)\n\ndef _sum(numbers):\n    \"\"\"\n    Calculates the sum of an array of numbers.\n    Raises ValidationError for invalid input.\n    \"\"\"\n    validator = ArrayValidator(DEFAULT_MAX_ARRAY_SIZE)\n    aggregator = KahanAggregator()\n    service = SumService(validator, aggregator, DEFAULT_MAX_ARRAY_SIZE)\n    controller = ArraySumController(service)\n    return controller.compute(numbers)"}
