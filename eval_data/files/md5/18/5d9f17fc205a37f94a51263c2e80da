{"task_id": "Mbpp/111", "solution": "from typing import Sequence, Any, List, Set, Dict\n\nclass NestedCommonError(Exception):\n    \"\"\"Base exception for nested_common library errors.\"\"\"\n    def __init__(self, message: str = \"\") -> None:\n        super().__init__(message)\n        self.message = message\n\nclass ValidationError(NestedCommonError):\n    \"\"\"Exception for invalid input data.\"\"\"\n    def __init__(self, message: str, field: str = \"\") -> None:\n        super().__init__(message)\n        self.field = field\n\nclass TypeUtils:\n    \"\"\"Utility methods for type checking.\"\"\"\n    @staticmethod\n    def is_hashable(obj: Any) -> bool:\n        \"\"\"Checks if an object is hashable.\"\"\"\n        try:\n            hash(obj)\n            return True\n        except TypeError:\n            return False\n\nclass ListValidator:\n    \"\"\"Validates and normalizes nested list inputs.\"\"\"\n    MAX_LISTS = 10000\n    MAX_INNER_SIZE = 100000\n\n    def validate(self, nested: Any) -> Sequence[Sequence[Any]]:\n        \"\"\"Ensures the input is a valid sequence of sequences.\"\"\"\n        if nested is None:\n            raise ValidationError(\"Input is None\", field=\"nested\")\n        \n        self._validate_outer(nested)\n        \n        normalized = []\n        for i, inner in enumerate(nested):\n            self._validate_inner(inner, i)\n            normalized.append(list(inner)) # Normalize inner sequences to lists\n        return normalized\n\n    def _validate_outer(self, nested: Any) -> None:\n        \"\"\"Validates the outer sequence structure.\"\"\"\n        if not isinstance(nested, Sequence) or isinstance(nested, (str, bytes, bytearray)):\n            raise ValidationError(\"Input must be a sequence of sequences.\", field=\"nested\")\n        if len(nested) > self.MAX_LISTS:\n            raise ValidationError(f\"Too many nested lists. Max {self.MAX_LISTS}.\", field=\"nested\")\n\n    def _validate_inner(self, inner: Any, index: int) -> None:\n        \"\"\"Validates each inner sequence structure.\"\"\"\n        if not isinstance(inner, Sequence) or isinstance(inner, (str, bytes, bytearray)):\n            raise ValidationError(f\"Inner element at index {index} must be a sequence.\", field=f\"nested[{index}]\")\n        if len(inner) > self.MAX_INNER_SIZE:\n            raise ValidationError(f\"Inner list at index {index} is too large. Max {self.MAX_INNER_SIZE} elements.\", field=f\"nested[{index}]\")\n\nclass CommonElementsService:\n    \"\"\"Core logic to find common elements across nested lists.\"\"\"\n    def find_common(self, nested: Sequence[Sequence[Any]], preserve_order: bool = False) -> List[Any]:\n        \"\"\"\n        Finds elements common to all inner lists.\n        Chooses an optimized path for hashable items, or a fallback for non-hashable.\n        \"\"\"\n        if not nested:\n            return []\n\n        # Handle single list case: return unique elements of that list\n        if len(nested) == 1:\n            if not nested[0]:\n                return []\n            \n            result = []\n            seen = [] # Using a list for seen to handle non-hashables by linear search\n            for item in nested[0]:\n                if item not in seen: # Check for uniqueness\n                    result.append(item)\n                    seen.append(item)\n            return result\n\n        # Determine if we should attempt hashable path by sampling elements from the first non-empty list\n        use_hashable_path = True\n        first_non_empty_list_items = None\n        for inner_list in nested:\n            if inner_list:\n                first_non_empty_list_items = inner_list\n                break\n        \n        if first_non_empty_list_items is None: # All inner lists are empty\n            return []\n\n        sample = next(iter(first_non_empty_list_items), None)\n        if sample is None or not TypeUtils.is_hashable(sample):\n            use_hashable_path = False\n\n        if use_hashable_path:\n            common_set = self._get_hashable_common_set(nested)\n            if preserve_order:\n                # Filter elements from the first list to preserve their order\n                result = []\n                # Create a mutable copy of common_set for efficient removal\n                temp_common_set = set(common_set) \n                for item in nested[0]:\n                    if item in temp_common_set:\n                        result.append(item)\n                        temp_common_set.remove(item) # Remove to ensure each common element is added only once\n                return result\n            else:\n                return list(common_set) # Order is arbitrary\n        else:\n            return self._non_hashable_intersection(nested, preserve_order)\n\n    def _get_hashable_common_set(self, nested: Sequence[Sequence[Any]]) -> Set[Any]:\n        \"\"\"Computes the intersection of sets from hashable lists.\"\"\"\n        if not nested or not nested[0]:\n            return set()\n        \n        common_elements: Set[Any] = set(nested[0])\n\n        for i in range(1, len(nested)):\n            if not nested[i]: # If any list is empty, intersection is empty\n                return set()\n            common_elements.intersection_update(set(nested[i]))\n            if not common_elements: # Early exit if no common elements found so far\n                return set()\n        return common_elements\n\n    def _non_hashable_intersection(self, nested: Sequence[Sequence[Any]], preserve_order: bool) -> List[Any]:\n        \"\"\"\n        Fallback algorithm for non-hashable items using linear scans.\n        Ensures unique elements in the output.\n        \"\"\"\n        if not nested or not nested[0]:\n            return []\n\n        first_list = nested[0]\n        other_lists = nested[1:]\n\n        common_elements_in_order: List[Any] = []\n        \n        # Tracks unique items that have been added to common_elements_in_order\n        seen_for_output_deduplication = [] \n        \n        for item_from_first in first_list:\n            if item_from_first in seen_for_output_deduplication:\n                # If preserve_order is True, we skip duplicates already added to ensure uniqueness.\n                # If preserve_order is False, we also skip duplicates from the first list to get unique candidates.\n                continue \n            \n            is_common_to_all = True\n            for other_list in other_lists:\n                if item_from_first not in other_list: # Linear scan for membership\n                    is_common_to_all = False\n                    break\n            \n            if is_common_to_all:\n                common_elements_in_order.append(item_from_first)\n                seen_for_output_deduplication.append(item_from_first)\n        \n        # If preserve_order is False, the order of `common_elements_in_order` is based on\n        # the first appearance in `first_list`. This is an acceptable \"arbitrary\" order\n        # for `preserve_order=False` as it ensures uniqueness.\n        return common_elements_in_order\n\n# Instantiate validator and service for the convenience API function\n_validator = ListValidator()\n_service = CommonElementsService()\n\ndef common_in_nested_lists(nested: Sequence[Sequence[Any]], preserve_order: bool = False) -> List[Any]:\n    \"\"\"\n    Finds common elements in a list of lists.\n    Validates input and computes common elements, optionally preserving order.\n    \"\"\"\n    normalized_nested = _validator.validate(nested)\n    return _service.find_common(normalized_nested, preserve_order=preserve_order)"}
{"task_id": "Mbpp/118", "solution": "def string_to_list(text: str, delimiter: str = ' ', keep_empty: bool = False) -> list[str]:\n    \"\"\"\n    Converts a string to a list of strings split by a delimiter.\n    Handles optional collapsing of consecutive delimiters and stripping whitespace based on `keep_empty`.\n    \"\"\"\n    if not keep_empty:\n        # If the delimiter is a space, str.split() without arguments naturally handles multiple spaces,\n        # leading/trailing whitespace, and collapses them, returning no empty strings.\n        if delimiter == ' ':\n            return text.split()\n        else:\n            # For non-space delimiters, first normalize all whitespace (collapsing any sequence of\n            # whitespace characters into a single space and stripping leading/trailing),\n            # then split by the specific delimiter and filter out any resulting empty strings.\n            normalized_text = ' '.join(text.split())\n            parts = normalized_text.split(delimiter)\n            return [p for p in parts if p]\n    else:\n        # If `keep_empty` is True, split directly by the specified delimiter, preserving all resulting tokens.\n        return text.split(delimiter)"}
{"task_id": "Mbpp/120", "solution": "from typing import Iterable, Tuple, Union, Any, List\nfrom math import fabs\n\n# Define custom exceptions as per design, needed by validator and service\nclass MaxProductError(Exception):\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\n\nclass InputValidationError(MaxProductError):\n    def __init__(self, message: str, invalid_item: Any = None):\n        super().__init__(message)\n        self.invalid_item = invalid_item\n\nclass NoDataError(MaxProductError):\n    def __init__(self, message: str = \"No input data provided\"):\n        super().__init__(message)\n\n# Define models as per design\nclass Pair:\n    def __init__(self, a: float, b: float):\n        self.a = float(a)\n        self.b = float(b)\n\n    def to_tuple(self) -> Tuple[float, float]:\n        return (self.a, self.b)\n\n# Define utils as per design\ndef is_number(value: Any) -> bool:\n    \"\"\"Checks if a value is an int or float, excluding bool.\"\"\"\n    return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n# Define validator as per design\nclass InputValidator:\n    def validate(self, pairs_raw: Any) -> List[Pair]:\n        \"\"\"Validates raw input and converts it to a list of Pair objects.\"\"\"\n        if pairs_raw is None:\n            raise NoDataError(\"Input is None\")\n        try:\n            iterable = list(pairs_raw)\n        except TypeError:\n            raise InputValidationError(\"Input is not iterable\", pairs_raw)\n\n        pairs = []\n        for item in iterable:\n            pairs.append(self._validate_pair(item))\n\n        if not pairs:\n            raise NoDataError(\"No pairs provided\")\n        return pairs\n\n    def _validate_pair(self, item: Any) -> Pair:\n        \"\"\"Validates a single item as a numeric pair.\"\"\"\n        if not (isinstance(item, (list, tuple)) and len(item) == 2):\n            raise InputValidationError(\"Item is not a pair (must be a 2-element list or tuple)\", item)\n        \n        a, b = item\n        if not is_number(a) or not is_number(b):\n            raise InputValidationError(\"Pair elements must be numeric\", item)\n        \n        return Pair(float(a), float(b))\n\n# Define service as per design\nclass MaxProductService:\n    def __init__(self, repository=None):\n        # repository is optional and not used in this function's core logic\n        self._repository = repository\n\n    def compute_pair_absolute_product(self, pair: Pair) -> float:\n        \"\"\"Computes the absolute product of elements in a Pair.\"\"\"\n        return fabs(pair.a * pair.b)\n\n    def compute_max_absolute_product(self, pairs: Iterable[Pair]) -> float:\n        \"\"\"\n        Iterates through pairs, computes absolute product, and returns the maximum.\n        Input `pairs` is expected to be an iterable of `Pair` instances.\n        \"\"\"\n        max_val = None\n        for p in pairs:\n            # The validator ensures 'p' is a Pair, but for robustness with direct calls\n            # that might skip validation, we handle tuple-likes here too.\n            # The design context implies 'pairs' should be Iterable[Pair].\n            if not isinstance(p, Pair):\n                # This branch handles cases where compute_max_absolute_product is called\n                # directly with tuples/lists instead of validated Pair objects.\n                # However, the wrapper function will pass validated Pair objects.\n                if not (isinstance(p, (list, tuple)) and len(p) == 2 and is_number(p[0]) and is_number(p[1])):\n                     raise InputValidationError(\"Invalid item in pairs iterable\", p)\n                p = Pair(float(p[0]), float(p[1]))\n            \n            prod = self.compute_pair_absolute_product(p)\n            if max_val is None or prod > max_val:\n                max_val = prod\n        \n        if max_val is None:\n            raise NoDataError(\"No valid pairs to compute product from.\")\n        \n        return max_val\n\ndef max_product_tuple(pairs: Iterable[Tuple[Union[int, float], Union[int, float]]]) -> float:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    Validates input and computes the maximum absolute product.\n    \"\"\"\n    validator = InputValidator()\n    validated_pairs = validator.validate(pairs)\n    service = MaxProductService()\n    return service.compute_max_absolute_product(validated_pairs)"}
{"task_id": "Mbpp/124", "solution": "import math\nfrom dataclasses import dataclass\nfrom typing import Any\n\nclass InvalidComplexError(ValueError):\n    \"\"\"Custom exception for invalid complex number inputs.\"\"\"\n    pass\n\n@dataclass\nclass ComplexNumber:\n    \"\"\"Domain model for a complex value.\"\"\"\n    real: float\n    imag: float\n\n    def to_complex(self) -> complex:\n        \"\"\"Returns the built-in complex number representation.\"\"\"\n        return complex(self.real, self.imag)\n\nclass ComplexValidator:\n    \"\"\"Normalizes and validates inputs to a ComplexNumber.\"\"\"\n    def normalize(self, *args: Any) -> ComplexNumber:\n        \"\"\"\n        Accepts flexible inputs to construct a ComplexNumber.\n        Supports (z: complex), (real: numeric, imag: numeric), or (real: numeric, imag_complex: complex where real is zero).\n        \"\"\"\n        if len(args) == 1:\n            z_input = args[0]\n            if isinstance(z_input, complex):\n                return ComplexNumber(float(z_input.real), float(z_input.imag))\n            try:\n                # Attempt to parse a string like \"1+2j\" or \"3j\"\n                parsed_complex = complex(z_input)\n                return ComplexNumber(float(parsed_complex.real), float(parsed_complex.imag))\n            except (TypeError, ValueError) as e:\n                raise InvalidComplexError(f\"Single argument must be a complex number or parseable complex string: {z_input}\") from e\n        elif len(args) == 2:\n            real_part_input, imag_part_input = args\n            r = self._ensure_numeric(real_part_input, is_real_part=True)\n            i = self._ensure_numeric(imag_part_input, is_real_part=False)\n            return ComplexNumber(r, i)\n        \n        raise InvalidComplexError(\"Unsupported argument signature: provide (z: complex) or (real: float, imag: float).\")\n\n    def _ensure_numeric(self, v: Any, is_real_part: bool) -> float:\n        \"\"\"Converts an input value to a float, handling complex numbers for the imaginary part.\"\"\"\n        if isinstance(v, (int, float)):\n            return float(v)\n        if isinstance(v, complex):\n            if is_real_part:\n                raise InvalidComplexError(f\"Real part cannot be a complex number, got {v}.\")\n            # For imag_part_input, if it's complex, use its imaginary component if its real part is zero\n            if v.real == 0.0:\n                return float(v.imag)\n            raise InvalidComplexError(f\"Complex number as imaginary part must have zero real component, got {v}.\")\n        try:\n            # Try converting numeric strings\n            return float(v)\n        except (TypeError, ValueError) as e:\n            raise InvalidComplexError(f\"Invalid numeric input: {v}\") from e\n\nclass AngleCalculator:\n    \"\"\"Computes the principal argument (angle) of a ComplexNumber.\"\"\"\n    def compute_angle(self, z: ComplexNumber) -> float:\n        \"\"\"Returns the angle (argument) of the complex number in radians.\"\"\"\n        return math.atan2(z.imag, z.real)\n\ndef angle_complex(*args: Any) -> float:\n    \"\"\"\n    Computes the principal argument (angle in radians) of a complex number.\n\n    Accepts inputs as either (z: complex) or (real: float, imag: float).\n    \"\"\"\n    validator = ComplexValidator()\n    cn = validator.normalize(*args)\n    calc = AngleCalculator()\n    return calc.compute_angle(cn)"}
{"task_id": "Mbpp/123", "solution": "import math\n\nclass InvalidLimitError(Exception):\n    \"\"\"Exception raised for invalid limit values.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass AmicablePair:\n    \"\"\"Represents an amicable pair (a,b).\"\"\"\n    def __init__(self, a: int, b: int) -> None:\n        if a <= 0 or b <= 0:\n            raise ValueError(\"Amicable numbers must be positive\")\n        self.a = a\n        self.b = b\n    def to_tuple(self) -> tuple[int, int]:\n        return (self.a, self.b)\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, AmicablePair):\n            return NotImplemented\n        return {self.a, self.b} == {other.a, other.b}\n    def __hash__(self) -> int:\n        return hash(frozenset({self.a, self.b}))\n\nclass DivisorCalculator:\n    \"\"\"Calculates the sum of proper divisors for a given number.\"\"\"\n    def sum_proper_divisors(self, n: int) -> int:\n        if n <= 1:\n            return 0\n        total = 1\n        root = int(math.isqrt(n))\n        for i in range(2, root + 1):\n            if n % i == 0:\n                total += i\n                other = n // i\n                if other != i:\n                    total += other\n        return total\n\nclass InMemoryCacheRepository:\n    \"\"\"A simple in-memory cache for divisor sums, with no persistence.\"\"\"\n    def __init__(self, path: str = None) -> None:\n        self._cache: dict[int,int] = {}\n        self._path = path # Path is ignored for this implementation as no persistence is needed for this func.\n\n    def get(self, n: int) -> int | None:\n        return self._cache.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        self._cache[n] = value\n\n    def persist(self) -> None:\n        \"\"\"This method is a no-op as persistence is not required for this function.\"\"\"\n        pass\n\nclass AmicableService:\n    \"\"\"Core business logic for amicable numbers, using a divisor calculator and a cache.\"\"\"\n    def __init__(self, calc: DivisorCalculator, repo: InMemoryCacheRepository) -> None:\n        self._calc = calc\n        self._repo = repo\n\n    def sum_divisors_cached(self, n: int) -> int:\n        cached = self._repo.get(n)\n        if cached is not None:\n            return cached\n        val = self._calc.sum_proper_divisors(n)\n        self._repo.set(n, val)\n        return val\n\n    def find_amicable_pairs(self, limit: int) -> list[AmicablePair]:\n        if limit < 2: # This check is redundant due to amicable_numbers_sum doing it, but kept for consistency.\n            return []\n\n        found_pairs = set[AmicablePair]()\n        \n        for n in range(2, limit + 1):\n            s_n = self.sum_divisors_cached(n)\n            \n            if s_n > n and s_n <= limit: # Optimize by only checking s_n > n to avoid duplicate pairs\n                s_s_n = self.sum_divisors_cached(s_n)\n                \n                if s_s_n == n:\n                    pair = AmicablePair(n, s_n)\n                    found_pairs.add(pair)\n        \n        return list(found_pairs)\n\n    def amicable_numbers_sum(self, limit: int) -> int:\n        if not isinstance(limit, int) or limit < 2:\n            raise InvalidLimitError(\"limit must be int >= 2\")\n\n        pairs = self.find_amicable_pairs(limit)\n        numbers = set()\n        for p in pairs:\n            numbers.add(p.a)\n            numbers.add(p.b)\n        \n        # In this specific function call context, we don't need to persist the cache externally.\n        # However, the design context specifies _repo.persist() might be called, \n        # so for this function, it's a no-op in the InMemoryCacheRepository.\n        self._repo.persist() \n        \n        return sum(numbers)\n\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"\n    Sums all amicable numbers from 1 to a specified number.\n    Uses an in-memory cache for divisor sums.\n    \"\"\"\n    calc = DivisorCalculator()\n    repo = InMemoryCacheRepository() # No file path provided, so it's purely in-memory.\n    service = AmicableService(calc, repo)\n    return service.amicable_numbers_sum(limit)"}
{"task_id": "Mbpp/125", "solution": "import sys\nimport time\nfrom typing import Optional, List\n\nclass InvalidBinaryStringError(ValueError):\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\nclass BinaryInputDTO:\n    def __init__(self, value: str) -> None:\n        self.value = value\n\nclass DiffResultModel:\n    def __init__(self, input_value: str, value: int, timestamp: float) -> None:\n        self.input_value = input_value\n        self.value = value\n        self.timestamp = timestamp\n\nclass AlgorithmService:\n    def max_zero_one_diff(self, s: str) -> int:\n        # Applies Kadane's algorithm variant to find the maximum subarray sum.\n        # '0' maps to +1, '1' maps to -1.\n        mapped_values = [1 if char == '0' else -1 for char in s]\n\n        best_so_far = mapped_values[0]\n        current_max = mapped_values[0]\n\n        for i in range(1, len(mapped_values)):\n            current_max = max(mapped_values[i], current_max + mapped_values[i])\n            best_so_far = max(best_so_far, current_max)\n        \n        return best_so_far\n\nclass Validator:\n    BINARY_CHARS = frozenset({'0', '1'})\n\n    def validate_binary_string(self, s: str) -> None:\n        if not s:\n            raise InvalidBinaryStringError(\"Input string must be non-empty\")\n        if not all(char in self.BINARY_CHARS for char in s):\n            raise InvalidBinaryStringError(\"Input contains characters other than '0' and '1'\")\n\nclass InMemoryResultRepository:\n    def __init__(self) -> None:\n        self._storage: List[DiffResultModel] = []\n\n    def save(self, result: DiffResultModel) -> None:\n        self._storage.append(result)\n\n    def get_last(self) -> Optional[DiffResultModel]:\n        return self._storage[-1] if self._storage else None\n\n    def list_recent(self, limit: int = 10) -> List[DiffResultModel]:\n        return self._storage[-limit:]\n\nclass DiffController:\n    def __init__(self, repository: InMemoryResultRepository, validator: Validator, algorithm_service: AlgorithmService) -> None:\n        self._repository = repository\n        self._validator = validator\n        self._algorithm_service = algorithm_service\n\n    def find_length(self, dto: BinaryInputDTO) -> int:\n        self._validator.validate_binary_string(dto.value)\n        result = self._algorithm_service.max_zero_one_diff(dto.value)\n        model = DiffResultModel(input_value=dto.value, value=result, timestamp=time.time())\n        self._repository.save(model)\n        return result\n\n    @classmethod\n    def build_from_defaults(cls) -> \"DiffController\":\n        return cls(\n            repository=InMemoryResultRepository(),\n            validator=Validator(),\n            algorithm_service=AlgorithmService()\n        )\n\ndef find_length(s: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s in any substring.\n    It maps '0' to +1 and '1' to -1, then applies a variant of Kadane's algorithm.\n    \"\"\"\n    controller = DiffController.build_from_defaults()\n    dto = BinaryInputDTO(s)\n    return controller.find_length(dto)"}
{"task_id": "Mbpp/127", "solution": "import datetime\nfrom typing import Any, Tuple, List, Optional\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass CalculationError(Exception):\n    \"\"\"Exception raised for internal calculation or persistence errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nDEFAULT_MAX_HISTORY: int = 100\n\ndef now_iso() -> str:\n    \"\"\"Returns the current UTC time in ISO 8601 format with 'Z' suffix.\"\"\"\n    return datetime.datetime.utcnow().isoformat() + 'Z'\n\nclass CalculationRecord:\n    \"\"\"Represents a record of a multiplication calculation.\"\"\"\n    def __init__(self, timestamp: str, a: int, b: int, result: int) -> None:\n        self.timestamp = timestamp\n        self.a = a\n        self.b = b\n        self.result = result\n\n    def to_dict(self) -> dict:\n        \"\"\"Returns a dictionary representation of the record.\"\"\"\n        return {\"timestamp\": self.timestamp, \"a\": self.a, \"b\": self.b, \"result\": self.result}\n\nclass InputValidator:\n    \"\"\"Validates input arguments for type and constraints.\"\"\"\n    def validate_ints(self, a: Any, b: Any) -> Tuple[int, int]:\n        \"\"\"Ensures both inputs are integers and returns them.\"\"\"\n        return (self._ensure_int(a, \"a\"), self._ensure_int(b, \"b\"))\n\n    def _ensure_int(self, value: Any, name: str) -> int:\n        \"\"\"Helper to validate a single value as an integer.\"\"\"\n        if not isinstance(value, int):\n            raise ValidationError(f\"Argument {name} must be int, got {type(value).__name__}\")\n        return value\n\nclass MultiplicationService:\n    \"\"\"Provides the core integer multiplication logic.\"\"\"\n    def multiply(self, a: int, b: int) -> int:\n        \"\"\"Multiplies two integers and returns the product.\"\"\"\n        return a * b\n\nclass CalculationRepository:\n    \"\"\"An in-memory repository for storing calculation records.\"\"\"\n    def __init__(self, max_history: int = DEFAULT_MAX_HISTORY) -> None:\n        self.max_history = max_history\n        self._store: List[CalculationRecord] = []\n\n    def save(self, record: CalculationRecord) -> None:\n        \"\"\"Saves a calculation record and manages history size.\"\"\"\n        self._store.append(record)\n        if len(self._store) > self.max_history:\n            self._store.pop(0)\n\n    def list_recent(self, limit: Optional[int] = None) -> List[CalculationRecord]:\n        \"\"\"Returns a list of recent calculation records.\"\"\"\n        if limit is None:\n            return list(self._store)\n        return self._store[-limit:]\n\n    def get_last(self) -> Optional[CalculationRecord]:\n        \"\"\"Returns the most recent calculation record, or None if none exist.\"\"\"\n        if not self._store:\n            return None\n        return self._store[-1]\n\n    def clear(self) -> None:\n        \"\"\"Clears all stored calculation records.\"\"\"\n        self._store.clear()\n\nclass MultiplyController:\n    \"\"\"Orchestrates validation, multiplication, and persistence.\"\"\"\n    def __init__(self, repository: Optional[CalculationRepository] = None) -> None:\n        self.validator = InputValidator()\n        self.service = MultiplicationService()\n        self.repository = repository or CalculationRepository()\n\n    def multiply_int(self, a: Any, b: Any) -> int:\n        \"\"\"Multiplies two integers, validates inputs, and stores the result.\"\"\"\n        a_i, b_i = self.validator.validate_ints(a, b)\n        result = self.service.multiply(a_i, b_i)\n        record = CalculationRecord(timestamp=now_iso(), a=a_i, b=b_i, result=result)\n        try:\n            self.repository.save(record)\n        except Exception as exc:\n            raise CalculationError(f\"Failed to save calculation: {exc}\") from exc\n        return result\n\n    def set_repository(self, repo: CalculationRepository) -> None:\n        \"\"\"Sets an alternative repository for testing or different persistence.\"\"\"\n        self.repository = repo\n\n_multiply_controller_instance = MultiplyController()\n\ndef multiply_int(a: int, b: int) -> int:\n    \"\"\"Multiplies two integers, validates them, and stores the result.\"\"\"\n    return _multiply_controller_instance.multiply_int(a, b)"}
{"task_id": "Mbpp/129", "solution": "from typing import List, Tuple, Any\n\nclass InvalidMatrixError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\ndef is_int(val: Any) -> bool:\n    \"\"\"Return True if val is int (not bool).\"\"\"\n    return isinstance(val, int) and not isinstance(val, bool)\n\nclass Matrix:\n    def __init__(self, data: List[List[int]]) -> None:\n        \"\"\"Store deep-copied matrix data after assumption that validation occurred.\"\"\"\n        self._data = [row[:] for row in data]\n\n    def size(self) -> int:\n        \"\"\"Return n for n x n matrix.\"\"\"\n        return len(self._data)\n\n    def row_sums(self) -> List[int]:\n        \"\"\"Compute sum of each row.\"\"\"\n        return [sum(row) for row in self._data]\n\n    def col_sums(self) -> List[int]:\n        \"\"\"Compute sum of each column.\"\"\"\n        n = self.size()\n        return [sum(self._data[r][c] for r in range(n)) for c in range(n)]\n\n    def diag_sums(self) -> Tuple[int, int]:\n        \"\"\"Compute (main_diagonal_sum, anti_diagonal_sum).\"\"\"\n        n = self.size()\n        main = sum(self._data[i][i] for i in range(n))\n        anti = sum(self._data[i][n-1-i] for i in range(n))\n        return (main, anti)\n\n    def flatten(self) -> List[int]:\n        \"\"\"Return flattened values for any additional checks.\"\"\"\n        return [v for row in self._data for v in row]\n\nclass MatrixValidator:\n    @staticmethod\n    def validate(matrix_data: List[List[Any]]) -> Matrix:\n        \"\"\"\n        Ensure matrix_data is non-empty list of lists, all rows same length,\n        length == number of rows, all items ints.\n        \"\"\"\n        if not isinstance(matrix_data, list) or len(matrix_data) == 0:\n            raise InvalidMatrixError(\"Matrix must be a non-empty list of lists.\")\n        n = len(matrix_data)\n        for i, row in enumerate(matrix_data):\n            if not isinstance(row, list):\n                raise InvalidMatrixError(f\"Row {i} is not a list.\")\n            if len(row) != n:\n                raise InvalidMatrixError(\"Matrix must be square: all rows must have length n.\")\n            for j, v in enumerate(row):\n                if not is_int(v):\n                    raise InvalidMatrixError(f\"Value at ({i},{j}) is not an integer.\")\n        return Matrix([[int(v) for v in row] for row in matrix_data])\n\nclass MagicSquareService:\n    def __init__(self) -> None:\n        \"\"\"Construct service; supports DI.\"\"\"\n        pass\n\n    def expected_sum(self, matrix: Matrix) -> int:\n        \"\"\"Determine expected sum (sum of first row by convention).\"\"\"\n        rows = matrix.row_sums()\n        return rows[0]\n\n    def is_magic(self, matrix: Matrix) -> bool:\n        \"\"\"\n        Compute row sums, column sums, diag sums and check all equal to expected_sum.\n        Complexity: O(n^2) time, O(1) extra space (excluding output lists).\n        \"\"\"\n        target = self.expected_sum(matrix)\n        \n        if any(s != target for s in matrix.row_sums()):\n            return False\n        if any(s != target for s in matrix.col_sums()):\n            return False\n        \n        main, anti = matrix.diag_sums()\n        return main == target and anti == target\n\ndef magic_square_test(matrix_data: List[List[Any]]) -> bool:\n    \"\"\"\n    Validate matrix_data via MatrixValidator, call MagicSquareService.is_magic,\n    return result.\n    \"\"\"\n    matrix = MatrixValidator.validate(matrix_data)\n    service = MagicSquareService()\n    return service.is_magic(matrix)"}
{"task_id": "Mbpp/126", "solution": "MAX_INPUT = 10**18\n\nimport math\n\nclass CommonDivisorError(Exception):\n    def __init__(self, message: str = \"\") -> None:\n        self.message = message\n        super().__init__(message)\n\nclass ValidationError(CommonDivisorError):\n    pass\n\nclass NumberPair:\n    def __init__(self, a: int, b: int) -> None:\n        self.a: int = a\n        self.b: int = b\n\n    def normalized(self) -> \"NumberPair\":\n        \"\"\"Returns a new NumberPair with absolute values of a and b.\"\"\"\n        return NumberPair(abs(self.a), abs(self.b))\n\nclass SumResult:\n    def __init__(self, value: int) -> None:\n        if not isinstance(value, int):\n            raise ValueError(\"SumResult value must be an integer.\")\n        self.value: int = value\n\n    def __int__(self) -> int:\n        return self.value\n\nclass InputValidator:\n    def validate(self, a: any, b: any) -> NumberPair:\n        \"\"\"Validates inputs for type and range, returning a NumberPair.\"\"\"\n        try:\n            int_a = int(a)\n            int_b = int(b)\n        except (ValueError, TypeError) as e:\n            raise ValidationError(\"Inputs must be integers or convertible to integers.\") from e\n\n        if abs(int_a) > MAX_INPUT or abs(int_b) > MAX_INPUT:\n            raise ValidationError(f\"Input absolute value exceeds maximum allowed ({MAX_INPUT}).\")\n        \n        return NumberPair(int_a, int_b)\n\nclass DivisorCalculator:\n    def gcd(self, a: int, b: int) -> int:\n        \"\"\"Computes the greatest common divisor using the Euclidean algorithm.\"\"\"\n        a, b = abs(a), abs(b)\n        while b:\n            a, b = b, a % b\n        return a\n\n    def sum_of_divisors(self, n: int) -> int:\n        \"\"\"Sums all positive divisors of n.\"\"\"\n        if n <= 0:\n            return 0\n        total = 0\n        root = int(math.isqrt(n))\n        for i in range(1, root + 1):\n            if n % i == 0:\n                total += i\n                j = n // i\n                if j != i:\n                    total += j\n        return total\n\n    def sum_common_divisors_from_gcd(self, g: int) -> int:\n        \"\"\"A convenience wrapper to sum the divisors of a given GCD.\"\"\"\n        return self.sum_of_divisors(g)\n\nclass DivisorService:\n    def __init__(self, calculator: DivisorCalculator = None, validator: InputValidator = None) -> None:\n        self._calculator = calculator or DivisorCalculator()\n        self._validator = validator or InputValidator()\n\n    def sum_common_divisors(self, a: any, b: any) -> SumResult:\n        \"\"\"Orchestrates validation, normalization, and calculation of the sum of common divisors.\"\"\"\n        pair = self._validator.validate(a, b)\n        normalized_pair = pair.normalized()\n        g = self._calculator.gcd(normalized_pair.a, normalized_pair.b)\n        s = self._calculator.sum_common_divisors_from_gcd(g)\n        return SumResult(s)\n\ndef sum_common_divisors(a, b):\n    service = DivisorService()\n    result = service.sum_common_divisors(a, b)\n    return int(result)"}
{"task_id": "Mbpp/128", "solution": "from typing import List, Union\n\nclass TextutilsError(Exception):\n    \"\"\"Base exception for textutils operations.\"\"\"\n    def __init__(self, message: str = \"\") -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass InvalidInputError(TextutilsError):\n    \"\"\"Raised when input parameters are invalid.\"\"\"\n    pass\n\nclass Validator:\n    \"\"\"Handles validation and normalization of input values.\"\"\"\n    def validate_n(self, n: int) -> None:\n        if not isinstance(n, int):\n            raise InvalidInputError(\"n must be an integer\")\n        if n < 0:\n            raise InvalidInputError(\"n must be non-negative\")\n\n    def normalize_input(self, input_value: Union[str, List[str]]) -> List[str]:\n        if isinstance(input_value, str):\n            return input_value.split()\n        if isinstance(input_value, list) and all(isinstance(x, str) for x in input_value):\n            return input_value\n        raise InvalidInputError(\"input must be a str or list of str\")\n\nclass LongWordFinder:\n    \"\"\"Core component to find words longer than a specified length.\"\"\"\n    def __init__(self) -> None:\n        self._default_tokenization = \"whitespace\"\n\n    def find(self, words: List[str], min_length: int) -> List[str]:\n        return [w for w in words if len(w) > min_length]\n\nclass WordFilterService:\n    \"\"\"Orchestrates validation, normalization, and word filtering.\"\"\"\n    def __init__(self, finder: LongWordFinder=None, validator: Validator=None) -> None:\n        self.finder = finder or LongWordFinder()\n        self.validator = validator or Validator()\n\n    def filter_long_words(self, n: int, input_value: Union[str, List[str]]) -> List[str]:\n        self.validator.validate_n(n)\n        words = self.validator.normalize_input(input_value)\n        return self.finder.find(words, n)\n\n_service = WordFilterService()\n\ndef long_words(n: int, text_or_words: Union[str, List[str]]) -> List[str]:\n    \"\"\"Finds words longer than n characters from a given text or list of words.\"\"\"\n    return _service.filter_long_words(n, text_or_words)"}
{"task_id": "Mbpp/130", "solution": "import collections\n\ndef max_occurrences(items: list[int]) -> int:\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    If multiple items have the same maximum frequency, the numerically smallest one is returned.\n    \"\"\"\n    counts = collections.Counter(items)\n\n    max_freq = -1\n    max_freq_items = []\n\n    for item, freq in counts.items():\n        if freq > max_freq:\n            max_freq = freq\n            max_freq_items = [item]\n        elif freq == max_freq:\n            max_freq_items.append(item)\n\n    return min(max_freq_items)"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(text: str) -> str:\n    \"\"\"Reverses only the vowels of a given string (where y is not a vowel).\"\"\"\n    vowels = set(\"aeiouAEIOU\")\n    \n    # Convert string to list of characters for in-place modification\n    chars = list(text)\n    \n    i, j = 0, len(chars) - 1\n    \n    while i < j:\n        # Move pointer i forward until a vowel is found\n        while i < j and chars[i] not in vowels:\n            i += 1\n            \n        # Move pointer j backward until a vowel is found\n        while i < j and chars[j] not in vowels:\n            j -= 1\n            \n        # If i is still less than j, both pointers found vowels, so swap them\n        if i < j:\n            chars[i], chars[j] = chars[j], chars[i]\n            i += 1\n            j -= 1\n            \n    return \"\".join(chars)"}
