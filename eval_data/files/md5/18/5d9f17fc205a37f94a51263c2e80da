{"task_id": "Mbpp/605", "solution": "def prime_num(n):\n    \"\"\"\n    Checks if the given integer is a prime number using trial division with 6k +/- 1 optimization.\n    Returns False for numbers less than 2, as they are not considered prime.\n    \"\"\"\n    if n < 2:\n        return False\n    if n in (2, 3):\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    \n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True"}
{"task_id": "Mbpp/603", "solution": "import json\nimport os\nimport tempfile\nimport logging\nfrom typing import List, Any, Optional, Dict\n\n# Setup basic logging to avoid 'No handlers could be found' warnings if\n# the calling application doesn't configure logging.\nlogging.basicConfig(level=logging.WARNING, format='%(levelname)s: %(message)s')\n_logger = logging.getLogger(__name__)\n\nclass InvalidInputError(ValueError):\n    \"\"\"Raised when input 'n' is not a valid integer or is less than 1.\"\"\"\n    pass\n\nclass LudicRequest:\n    \"\"\"DTO for requesting ludic numbers up to a certain 'n'.\"\"\"\n    def __init__(self, n: int) -> None:\n        self.n = n\n\nclass LudicResult:\n    \"\"\"DTO for the result, containing the list of ludic numbers and the max_n computed.\"\"\"\n    def __init__(self, ludics: List[int], max_n: int) -> None:\n        self.ludics = ludics\n        self.max_n = max_n\n\ndef validate_n(n: Any) -> int:\n    \"\"\"Validates if n is an integer >= 1.\"\"\"\n    try:\n        n_int = int(n)\n        if n_int < 1:\n            raise InvalidInputError(\"n must be an integer >= 1\")\n        return n_int\n    except (ValueError, TypeError) as e:\n        raise InvalidInputError(\"n must be an integer >= 1\") from e\n\ndef ensure_cache_dir(path: str) -> None:\n    \"\"\"Ensures the directory for the cache path exists.\"\"\"\n    os.makedirs(os.path.dirname(path), exist_ok=True)\n\nclass LudicAlgorithm:\n    \"\"\"Implements the sieve-like algorithm to compute ludic numbers.\"\"\"\n    def compute_up_to(self, n: int) -> List[int]:\n        if n < 1:\n            return []\n        candidates = list(range(1, n + 1))\n        # i is the index in the 'candidates' list for the current ludic number.\n        i = 1 \n        while i < len(candidates):\n            ludic_num = candidates[i] # The current ludic number that acts as a step.\n            if ludic_num == 0: # Should not happen with valid input, but as a safeguard.\n                break\n            \n            # Remove every 'ludic_num'-th element after position 'i' (0-indexed).\n            # This implements the sieve rule.\n            del candidates[i + ludic_num::ludic_num]\n            i += 1\n        return candidates\n\nclass LudicCache:\n    \"\"\"Handles reading from and writing to the JSON cache file.\"\"\"\n    DEFAULT_CACHE_FILENAME = \"cache.json\"\n\n    def __init__(self, path: Optional[str] = None) -> None:\n        if path is None:\n            cache_dir = os.path.join(os.path.expanduser(\"~\"), \".cache\", \"ludic_app\")\n            self._path = os.path.join(cache_dir, self.DEFAULT_CACHE_FILENAME)\n        else:\n            self._path = path\n\n    def read(self) -> Optional[Dict[str, Any]]:\n        \"\"\"Reads the cache file and returns its content or None if not found/invalid.\"\"\"\n        if not os.path.exists(self._path):\n            return None\n        try:\n            with open(self._path, 'r', encoding='utf-8') as f:\n                data = json.load(f)\n            if isinstance(data, dict) and \"max_n\" in data and \"ludics\" in data \\\n               and isinstance(data[\"max_n\"], int) and isinstance(data[\"ludics\"], list):\n                return data\n            _logger.warning(\"Cache file %s is malformed, ignoring.\", self._path)\n            return None\n        except (IOError, json.JSONDecodeError) as e:\n            _logger.warning(\"Could not read or parse cache file %s: %s\", self._path, e)\n            return None\n\n    def write(self, data: Dict[str, Any]) -> None:\n        \"\"\"Atomically writes data to the cache file.\"\"\"\n        ensure_cache_dir(self._path)\n        temp_file_path = f\"{self._path}.tmp.{os.getpid()}\"\n        try:\n            with open(temp_file_path, 'w', encoding='utf-8') as f:\n                json.dump(data, f)\n            os.replace(temp_file_path, self._path)\n        except IOError as e:\n            _logger.warning(\"Could not write cache file %s: %s\", self._path, e)\n        finally:\n            if os.path.exists(temp_file_path):\n                os.remove(temp_file_path)\n\nclass LudicRepository:\n    \"\"\"Manages in-memory and disk-based caching of Ludic numbers.\"\"\"\n    def __init__(self, cache: LudicCache) -> None:\n        self._cache = cache\n        self._in_memory: Optional[LudicResult] = None\n\n    def get_cached(self, n: int) -> Optional[LudicResult]:\n        \"\"\"Returns cached Ludic numbers if available and sufficient, otherwise None.\"\"\"\n        if self._in_memory and self._in_memory.max_n >= n:\n            return self._in_memory\n        \n        data = self._cache.read()\n        if data:\n            result = LudicResult(data[\"ludics\"], data[\"max_n\"])\n            self._in_memory = result\n            if result.max_n >= n:\n                return result\n        return None\n\n    def save(self, result: LudicResult) -> None:\n        \"\"\"Saves the computed Ludic numbers to in-memory and disk cache.\"\"\"\n        if self._in_memory is None or result.max_n > self._in_memory.max_n:\n            self._in_memory = result\n            self._cache.write({\"max_n\": result.max_n, \"ludics\": result.ludics})\n\nclass LudicService:\n    \"\"\"Orchestrates validation, caching, and computation of Ludic numbers.\"\"\"\n    def __init__(self, repository: LudicRepository, algorithm: LudicAlgorithm) -> None:\n        self._repository = repository\n        self._algorithm = algorithm\n\n    def get_ludic(self, n: int) -> List[int]:\n        \"\"\"Public method to get Ludic numbers up to n.\"\"\"\n        validated_n = validate_n(n)\n\n        cached_result = self._repository.get_cached(validated_n)\n\n        if cached_result and cached_result.max_n >= validated_n:\n            return [l for l in cached_result.ludics if l <= validated_n]\n        else:\n            computed_result = self._compute_and_update_cache(validated_n)\n            return computed_result.ludics\n\n    def _compute_and_update_cache(self, n: int) -> LudicResult:\n        \"\"\"Computes Ludic numbers up to n and updates the cache.\"\"\"\n        ludics = self._algorithm.compute_up_to(n)\n        result = LudicResult(ludics, n)\n        self._repository.save(result)\n        return result\n\nclass LudicController:\n    \"\"\"Handles API requests and delegates to the service layer.\"\"\"\n    def __init__(self, service: LudicService) -> None:\n        self._service = service\n\n    def get_ludic(self, request: LudicRequest) -> LudicResult:\n        \"\"\"Processes a request for Ludic numbers.\"\"\"\n        ludics = self._service.get_ludic(request.n)\n        return LudicResult(ludics, request.n)\n\n    def format_result(self, result: LudicResult) -> str:\n        \"\"\"Formats the LudicResult into a space-separated string.\"\"\"\n        return \" \".join(map(str, result.ludics))\n\n# Initialize the default components that the top-level get_ludic function will use.\n_default_cache = LudicCache(path=None)\n_default_repo = LudicRepository(cache=_default_cache)\n_default_algo = LudicAlgorithm()\n_default_service = LudicService(repository=_default_repo, algorithm=_default_algo)\n_default_controller = LudicController(service=_default_service)\n\ndef get_ludic(n: int) -> List[int]:\n    \"\"\"\n    Computes all ludic numbers less than or equal to a given integer n.\n    Results are cached to improve performance on subsequent calls.\n    \"\"\"\n    req = LudicRequest(n)\n    result = _default_controller.get_ludic(req)\n    return result.ludics"}
{"task_id": "Mbpp/604", "solution": "def reverse_words(text: str) -> str:\n    \"\"\"\n    Reverses the order of words in a given string, separated by spaces.\n    Multiple spaces are treated as a single separator.\n    \"\"\"\n    words = text.split()\n    reversed_words = list(reversed(words))\n    result = \" \".join(reversed_words)\n    return result"}
{"task_id": "Mbpp/607", "solution": "import re\nfrom typing import Pattern, Tuple, Optional, Union\n\n# Define custom exception as per design\nclass InvalidPatternError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n# MatchResult DTO as per design\nclass MatchResult:\n    def __init__(self, text: str, start: int, end: int) -> None:\n        self.text = text\n        self.start = int(start)\n        self.end = int(end)\n\n    def as_tuple(self) -> Tuple[str, int, int]:\n        return (self.text, self.start, self.end)\n\n# RegexEngine as per design\nclass RegexEngine:\n    def compile(self, pattern: Union[str, Pattern], flags: Optional[int] = None) -> Pattern:\n        if isinstance(pattern, Pattern):\n            return pattern  # already compiled\n        if flags is None:\n            flags = 0\n        return re.compile(pattern, flags)\n\n    def search(self, compiled_pattern: Pattern, text: str) -> Optional[Tuple[str, int, int]]:\n        m = compiled_pattern.search(text)\n        if not m:\n            return None\n        return (m.group(0), m.start(), m.end())\n\n# PatternValidator as per design\nclass PatternValidator:\n    def __init__(self, engine: RegexEngine) -> None:\n        self._engine = engine\n\n    def validate(self, pattern: Union[str, Pattern], flags: Optional[int] = None) -> Pattern:\n        try:\n            return self._engine.compile(pattern, flags)\n        except re.error as e:\n            raise InvalidPatternError(f\"Invalid regex pattern: {e}\")\n        except TypeError as e:\n            raise InvalidPatternError(f\"Invalid pattern or flags type: {e}\")\n\n# RegexAdapter as per design\nclass RegexAdapter:\n    def __init__(self, engine: RegexEngine) -> None:\n        self._engine = engine\n\n    def search(self, text: str, compiled_pattern: Pattern) -> Optional[MatchResult]:\n        res = self._engine.search(compiled_pattern, text)\n        if res is None:\n            return None\n        match_text, start, end = res\n        return MatchResult(match_text, start, end)\n\n# FinderService as per design\nclass FinderService:\n    def __init__(self, validator: PatternValidator, adapter: RegexAdapter) -> None:\n        self._validator = validator\n        self._adapter = adapter\n\n    def find(self, text: str, pattern: Union[str, Pattern], flags: Optional[int] = None) -> Optional[MatchResult]:\n        compiled = self._validator.validate(pattern, flags)\n        return self._adapter.search(text, compiled)\n\ndef find_literals(text: str, pattern: Union[str, Pattern], flags: Optional[int] = None) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Searches a string for a regex pattern and returns the matching substring, a start index, and an end index.\n    Returns None if no match is found, or raises InvalidPatternError for an invalid regex.\n    \"\"\"\n    engine = RegexEngine()\n    validator = PatternValidator(engine)\n    adapter = RegexAdapter(engine)\n    service = FinderService(validator, adapter)\n    res = service.find(text, pattern, flags)\n    return res.as_tuple() if res is not None else None"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n):\n    \"\"\"\n    Computes the nth Bell number using the Bell triangle algorithm.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Initialize the first row of the Bell triangle\n    # prev_row[0] will hold B(i) for current i\n    prev_row = [1]\n\n    # Compute subsequent rows of the Bell triangle\n    for i in range(1, n + 1):\n        current_row = [prev_row[-1]]  # First element of current row is last of previous row\n        for j in range(1, i + 1):\n            # Each subsequent element is the sum of the element to its left in\n            # the current row and the element above it in the previous row.\n            current_row.append(current_row[j-1] + prev_row[j-1])\n        prev_row = current_row\n\n    return prev_row[0]"}
