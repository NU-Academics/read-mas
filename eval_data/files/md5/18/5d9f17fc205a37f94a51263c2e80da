{"task_id": "Mbpp/558", "solution": "def _split_digits(n: int) -> list[int]:\n    \"\"\"Splits a non-negative integer into a list of its digits, most-significant first.\"\"\"\n    if n == 0:\n        return [0]\n    digits = []\n    temp_n = n\n    while temp_n > 0:\n        digits.append(temp_n % 10)\n        temp_n //= 10\n    return list(reversed(digits))\n\ndef _pad_digits(digits: list[int], length: int) -> list[int]:\n    \"\"\"Pads a list of digits with leading zeros to reach the specified length.\"\"\"\n    return [0] * (length - len(digits)) + digits\n\ndef _sum_absolute_diffs(d1: list[int], d2: list[int]) -> int:\n    \"\"\"Computes the sum of absolute differences between corresponding digits in two equally sized lists.\"\"\"\n    return sum(abs(x - y) for x, y in zip(d1, d2))\n\nclass _NumberPair:\n    \"\"\"Stores two numbers and their normalized digit lists for comparison.\"\"\"\n    def __init__(self, a: int, b: int) -> None:\n        self.a = a\n        self.b = b\n        \n        digits_a_raw = _split_digits(a)\n        digits_b_raw = _split_digits(b)\n\n        max_len = max(len(digits_a_raw), len(digits_b_raw))\n\n        self.digits_a = _pad_digits(digits_a_raw, max_len)\n        self.digits_b = _pad_digits(digits_b_raw, max_len)\n\nclass _InputParser:\n    \"\"\"Parses raw inputs into absolute integers and constructs a NumberPair.\"\"\"\n    def _parse_single(self, value: int | str) -> int:\n        \"\"\"Converts a single value to its absolute integer representation.\"\"\"\n        # Assumes valid integer input or string convertible to integer;\n        # no error handling for non-convertible types based on prompt constraints.\n        return abs(int(value))\n\n    def parse(self, a: int | str, b: int | str) -> _NumberPair:\n        \"\"\"Parses two inputs into absolute integers and creates a NumberPair.\"\"\"\n        a_i = self._parse_single(a)\n        b_i = self._parse_single(b)\n        return _NumberPair(a_i, b_i)\n\nclass _DigitDistanceCalculator:\n    \"\"\"Calculates the sum of per-digit differences between numbers.\"\"\"\n    def compute(self, pair: _NumberPair) -> int:\n        \"\"\"Computes the digit distance from a pre-parsed NumberPair.\"\"\"\n        return _sum_absolute_diffs(pair.digits_a, pair.digits_b)\n\n    def compute_from_values(self, a: int | str, b: int | str) -> int:\n        \"\"\"Parses values and computes the digit distance.\"\"\"\n        parser = _InputParser()\n        pair = parser.parse(a, b)\n        return self.compute(pair)\n\ndef digit_distance_nums(a: int | str, b: int | str) -> int:\n    \"\"\"Calculates the sum of per-digit absolute differences between two integers.\"\"\"\n    return _DigitDistanceCalculator().compute_from_values(a, b)"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(s: str) -> str:\n    \"\"\"Toggles the case of all alphabetic characters in a string.\"\"\"\n    def _toggle_char(ch: str) -> str:\n        if ch.isupper():\n            return ch.lower()\n        if ch.islower():\n            return ch.upper()\n        return ch\n    return ''.join(_toggle_char(ch) for ch in s)"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr: list[int], length: int) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist using Kadane's algorithm.\n    Assumes the input array is non-empty and `length` is its correct length.\n    \"\"\"\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, length):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/560", "solution": "import collections.abc\n\ndef union_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Finds the union of elements from two tuples and returns them in sorted order.\n    Assumes inputs are tuples and their elements are comparable and hashable.\n    \"\"\"\n    # Convert tuples to sets to get unique elements, then find their union.\n    combined = set(a) | set(b)\n    # Sort the combined elements and convert the result back to a tuple.\n    return tuple(sorted(combined))"}
{"task_id": "Mbpp/563", "solution": "import re\nfrom typing import List\n\nclass ExtractionError(Exception):\n    \"\"\"Custom exception for errors during value extraction.\"\"\"\n    def __init__(self, message: str, cause: Exception | None = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.cause = cause\n\ndef extract_values(text: str) -> List[str]:\n    \"\"\"\n    Extracts values enclosed in single or double quotation marks from a string.\n    Handles escaped quotes and trims whitespace from extracted values.\n    \"\"\"\n\n    def _unescape(value: str) -> str:\n        \"\"\"Replaces common escaped quote sequences with their literal characters.\"\"\"\n        return value.replace(r'\\\"', '\"').replace(r\"\\'\", \"'\").replace(r'\\\\', '\\\\')\n\n    def _postprocess(values: List[str]) -> List[str]:\n        \"\"\"Trims leading/trailing whitespace from each extracted value.\"\"\"\n        return [v.strip() for v in values]\n\n    try:\n        # Pattern to match a quoted string, supporting both single and double quotes.\n        # It captures the entire quoted string, including the quotes and escaped characters within.\n        pattern = re.compile(r\"\"\"([\"'])(?:\\\\.|(?!\\1).)*\\1\"\"\")\n    except re.error as e:\n        raise ExtractionError(\"Failed to compile internal regex pattern\", cause=e)\n\n    extracted_raw_values: List[str] = []\n    for match in pattern.finditer(text):\n        full_match = match.group(0)\n        # Remove the surrounding quotes (first and last characters)\n        inner_value_with_escapes = full_match[1:-1]\n        # Unescape any internal escaped quotes or backslashes\n        unescaped_value = _unescape(inner_value_with_escapes)\n        extracted_raw_values.append(unescaped_value)\n\n    # Apply post-processing (trimming whitespace) to the extracted values.\n    final_values = _postprocess(extracted_raw_values)\n\n    return final_values"}
