{"task_id": "Mbpp/405", "solution": "import uuid\nimport datetime\nfrom typing import Any, Optional\n\n# Utility functions\ndef now_iso() -> str:\n    \"\"\"Returns the current UTC time in ISO8601 format.\"\"\"\n    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='milliseconds') + 'Z'\n\ndef make_uuid() -> str:\n    \"\"\"Generates a UUID4 hex string.\"\"\"\n    return str(uuid.uuid4())\n\n# AppConfig class for runtime configuration\nclass AppConfig:\n    \"\"\"Configuration for the application.\"\"\"\n    def __init__(self, audit_enabled: bool = True, audit_path: str = \"audit.jsonl\", api_enabled: bool = False) -> None:\n        self.audit_enabled = audit_enabled\n        self.audit_path = audit_path\n        self.api_enabled = api_enabled\n\n# DTOs for requests and results\nclass ElementCheckRequest:\n    \"\"\"Data transfer object for an element check request.\"\"\"\n    def __init__(self, tuple_: tuple[Any, ...], element: Any) -> None:\n        self.tuple_ = tuple_\n        self.element = element\n\nclass ElementCheckResult:\n    \"\"\"Data transfer object for an element check result.\"\"\"\n    def __init__(self, result: bool, timestamp: str, error: Optional[str] = None, audit_id: Optional[str] = None) -> None:\n        self.result = result\n        self.timestamp = timestamp\n        self.error = error\n        self.audit_id = audit_id\n\n    def to_dict(self) -> dict[str, Any]:\n        \"\"\"Serializes the result to a dictionary.\"\"\"\n        return {\n            \"result\": self.result,\n            \"timestamp\": self.timestamp,\n            \"error\": self.error,\n            \"audit_id\": self.audit_id\n        }\n\n# Validator class for input validation and coercion\nclass Validator:\n    \"\"\"Validates inputs and coerces types as needed.\"\"\"\n    def validate_tuple(self, t: Any) -> tuple[Any, ...]:\n        \"\"\"Ensures input is a tuple or can be coerced to one.\"\"\"\n        if isinstance(t, tuple):\n            return t\n        if isinstance(t, list):\n            return tuple(t)\n        if isinstance(t, set):\n            return tuple(t)\n        raise TypeError(f\"Expected tuple-like input, got {type(t).__name__}\")\n\n    def validate_element(self, e: Any) -> Any:\n        \"\"\"Returns the element as-is.\"\"\"\n        return e\n\n# TupleService containing the core business logic\nclass TupleService:\n    \"\"\"Orchestrates validation, membership checking, and optional logging.\"\"\"\n    def __init__(self, config: AppConfig, repo: Any = None, validator: Optional[Validator] = None) -> None:\n        self._config = config\n        self._repo = repo\n        self._validator = validator or Validator()\n\n    def check(self, request: ElementCheckRequest) -> ElementCheckResult:\n        \"\"\"Performs the membership check for an element in a tuple.\"\"\"\n        timestamp = now_iso()\n        try:\n            tup = self._validator.validate_tuple(request.tuple_)\n            elt = self._validator.validate_element(request.element)\n        except Exception as e:\n            return ElementCheckResult(result=False, timestamp=timestamp, error=str(e), audit_id=None)\n\n        result = elt in tup\n        audit_id = None # Audit is explicitly disabled for the check_tuplex convenience function's path.\n\n        return ElementCheckResult(result=result, timestamp=timestamp, error=None, audit_id=audit_id)\n\ndef check_tuplex(t: tuple, element: Any) -> bool:\n    \"\"\"Checks whether an element exists within a tuple.\"\"\"\n    config = AppConfig(audit_enabled=False)\n    svc = TupleService(config=config)\n    req = ElementCheckRequest(tuple_=t, element=element)\n    res = svc.check(req)\n    if res.error:\n        raise RuntimeError(res.error)\n    return res.result"}
{"task_id": "Mbpp/409", "solution": "import math\n\ndef min_product_tuple(pairs: list[tuple[int, int]]) -> int:\n    \"\"\"\n    Calculates the minimum product by multiplying elements within each tuple in the list.\n    Then, it returns the smallest of these products.\n    \"\"\"\n    min_prod = math.inf\n    for a, b in pairs:\n        current_prod = a * b\n        if current_prod < min_prod:\n            min_prod = current_prod\n    return int(min_prod)"}
{"task_id": "Mbpp/412", "solution": "def remove_odd(lst: list[int]) -> list[int]:\n    \"\"\"Removes odd numbers from a list of integers, returning a new list with only even numbers.\"\"\"\n    return [x for x in lst if x % 2 == 0]"}
{"task_id": "Mbpp/410", "solution": "from typing import Sequence, Any, Iterable, Iterator, Optional\nfrom decimal import Decimal\nfrom fractions import Fraction\n\nclass InvalidInputError(Exception):\n    \"\"\"Raised when the input provided is not a valid iterable sequence.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass NoNumericValueError(Exception):\n    \"\"\"Raised when no numeric values are found in the input sequence.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass TypeAdapter:\n    \"\"\"Handles conversion of various types to a canonical numeric format (float).\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def convert_to_number(self, value: Any, allow_numeric_strings: bool = False) -> Optional[float]:\n        if isinstance(value, bool):\n            return None\n        if isinstance(value, (int, float)):\n            return float(value)\n        if isinstance(value, Decimal):\n            return float(value)\n        if isinstance(value, Fraction):\n            return float(value)\n        if allow_numeric_strings and isinstance(value, str):\n            try:\n                return float(value)\n            except ValueError:\n                return None\n        return None\n\nclass InputValidator:\n    \"\"\"Validates that the input is an iterable sequence.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def ensure_iterable(self, values: Any) -> None:\n        if not isinstance(values, Iterable) or isinstance(values, (str, bytes)):\n            raise InvalidInputError(\"Input must be an iterable sequence (e.g., list, tuple), not a string or non-iterable type.\")\n\nclass MinValueService:\n    \"\"\"Core logic for finding the minimum numeric value in an iterable.\"\"\"\n    def __init__(self, adapter: TypeAdapter) -> None:\n        self._adapter = adapter\n\n    def _iter_numeric_candidates(self, iterable: Iterable[Any], allow_numeric_strings: bool=False) -> Iterator[float]:\n        \"\"\"Yields numeric candidates converted to float, ignoring non-numeric items.\"\"\"\n        for item in iterable:\n            num = self._adapter.convert_to_number(item, allow_numeric_strings)\n            if num is not None:\n                yield num\n\n    def find_minimum(self, iterable: Iterable[Any], allow_numeric_strings: bool=False) -> float:\n        \"\"\"Finds the minimum numeric value in the given iterable.\"\"\"\n        it = self._iter_numeric_candidates(iterable, allow_numeric_strings)\n        try:\n            current_min = next(it)\n        except StopIteration:\n            raise NoNumericValueError(\"No numeric values found in the provided sequence.\")\n\n        for num in it:\n            if num < current_min:\n                current_min = num\n        return current_min\n\nclass MinValueController:\n    \"\"\"Controller that orchestrates validation and minimum value finding.\"\"\"\n    def __init__(self, service: MinValueService, validator: InputValidator) -> None:\n        self.service = service\n        self.validator = validator\n\n    def find_min(self, values: Sequence[Any], allow_numeric_strings: bool=False) -> float:\n        \"\"\"Validates input and finds the minimum numeric value.\"\"\"\n        self.validator.ensure_iterable(values)\n        return self.service.find_minimum(values, allow_numeric_strings)\n\n_default_controller = MinValueController(MinValueService(TypeAdapter()), InputValidator())\n\ndef min_val(values: Sequence[Any], allow_numeric_strings: bool = False) -> float:\n    \"\"\"\n    Finds the minimum numeric value in a given heterogeneous list.\n    Non-numeric items are ignored by default.\n    \"\"\"\n    return _default_controller.find_min(values, allow_numeric_strings)"}
{"task_id": "Mbpp/413", "solution": "from typing import List, Any, Sequence, Tuple\n\ndef extract_nth_element(data: Sequence[Tuple[Any, ...]], n: int) -> List[Any]:\n    \"\"\"\n    Extracts the nth element from each tuple in a given list of tuples.\n    Assumes valid input structure and index for all tuples.\n    \"\"\"\n    return [item[n] for item in data]"}
{"task_id": "Mbpp/415", "solution": "class ValidationError(Exception):\n    def __init__(self, message: str = None) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass NotEnoughElementsError(Exception):\n    def __init__(self, message: str = None) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass PairResult:\n    def __init__(self, first: int, second: int) -> None:\n        self.first = first\n        self.second = second\n\n    def product(self) -> int:\n        return self.first * self.second\n\n    def as_tuple(self) -> tuple[int, int]:\n        return (self.first, self.second)\n\nclass ArrayValidator:\n    def validate(self, arr: object) -> None:\n        if not isinstance(arr, (list, tuple)):\n            raise ValidationError(\"Input must be a list or tuple of integers\")\n        if len(arr) < 2:\n            raise NotEnoughElementsError(\"At least two elements are required\")\n        for i, v in enumerate(arr):\n            if not isinstance(v, int):\n                raise ValidationError(f\"Element at index {i} is not an int: {v}\")\n\ndef max_Product(arr: list[int]) -> tuple[int, int]:\n    \"\"\"\n    Finds a pair with the highest product from a given array of integers.\n    Handles negative numbers, zeros, and provides deterministic tie-breaking.\n    \"\"\"\n    validator = ArrayValidator()\n    validator.validate(arr)\n\n    # Initialize top and bottom values with sufficiently small/large numbers\n    # to ensure any input numbers are considered.\n    top1 = float('-inf')\n    top2 = float('-inf')\n    bot1 = float('inf')\n    bot2 = float('inf')\n\n    for x in arr:\n        if x > top1:\n            top2 = top1\n            top1 = x\n        elif x > top2:\n            top2 = x\n\n        if x < bot1:\n            bot2 = bot1\n            bot1 = x\n        elif x < bot2:\n            bot2 = x\n\n    # Calculate products of candidate pairs\n    prod_top = top1 * top2\n    prod_bot = bot1 * bot2\n\n    if prod_top > prod_bot:\n        return PairResult(int(top1), int(top2)).as_tuple()\n    elif prod_bot > prod_top:\n        return PairResult(int(bot1), int(bot2)).as_tuple()\n    else:  # Products are equal, apply tie-breaking rules\n        # Prefer pair with bigger max element, then bigger min element.\n        candidate1 = (max(int(top1), int(top2)), min(int(top1), int(top2)))\n        candidate2 = (max(int(bot1), int(bot2)), min(int(bot1), int(bot2)))\n        \n        if candidate1 > candidate2:\n            return PairResult(candidate1[0], candidate1[1]).as_tuple()\n        return PairResult(candidate2[0], candidate2[1]).as_tuple()"}
{"task_id": "Mbpp/414", "solution": "from typing import Sequence, Any, Iterable\n\nclass OverlapChecker:\n    \"\"\"Helper class to check for overlap between two sequences using optimized or fallback strategies.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def check(self, seq1: Sequence[Any], seq2: Sequence[Any]) -> bool:\n        \"\"\"Determines if there is any common element between two sequences.\"\"\"\n        # Prefer using a set on the smaller sequence for performance when elements are hashable.\n        # Fallback to iterative comparison if elements are not hashable (TypeError during set conversion).\n        try:\n            # Pass the smaller sequence first to _using_set to optimize set creation.\n            if len(seq1) <= len(seq2):\n                return self._using_set(seq1, seq2)\n            else:\n                return self._using_set(seq2, seq1) # Swap for optimization\n        except TypeError:\n            # Fallback to the iterative O(N*M) approach for unhashable types.\n            return self._using_iterative(seq1, seq2)\n\n    def _using_set(self, seq1_to_set: Iterable[Any], seq2_to_iterate: Iterable[Any]) -> bool:\n        \"\"\"Checks for overlap using a set for O(N+M) performance.\"\"\"\n        s1 = set(seq1_to_set)\n        for x in seq2_to_iterate:\n            if x in s1:\n                return True\n        return False\n\n    def _using_iterative(self, seq1: Iterable[Any], seq2: Iterable[Any]) -> bool:\n        \"\"\"Checks for overlap using nested loops for O(N*M) performance.\"\"\"\n        for a in seq1:\n            for b in seq2:\n                if a == b:\n                    return True\n        return False\n\ndef overlapping(seq1: Sequence[Any], seq2: Sequence[Any]) -> bool:\n    \"\"\"\n    Checks whether any value in seq1 exists in seq2.\n    Uses an optimized set-based approach for hashable elements, falling back to iterative comparison otherwise.\n    \"\"\"\n    return OverlapChecker().check(seq1, seq2)"}
{"task_id": "Mbpp/419", "solution": "from typing import Sequence, Any\n\ndef round_and_sum(numbers: Sequence[Any]) -> int:\n    \"\"\"\n    Rounds every number in a list to the nearest integer, sums the rounded values,\n    and multiplies the sum by the length of the original list.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    # The design implies validation and conversion to float happens, but given\n    # the constraints (\"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n    # and \"Do NOT call any helper that is not defined inline\"), we assume numbers\n    # are directly compatible with round() or will be handled by Python's runtime.\n    rounded_numbers = [round(x) for x in numbers]\n    \n    total_sum = sum(rounded_numbers)\n    list_length = len(numbers)\n    \n    return total_sum * list_length"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the cubes of the first n even natural numbers using a closed-form formula.\n    The formula is 2 * n^2 * (n+1)^2.\n    \"\"\"\n    return 2 * (n**2) * ((n + 1)**2)"}
{"task_id": "Mbpp/418", "solution": "from typing import Sequence, Any, Optional\n\ndef Find_Max(collection: Sequence[Sequence[Any]]) -> Optional[Sequence[Any]]:\n    \"\"\"\n    Finds the element of a sequence having maximum length.\n    Returns the first such element if there are ties, or None if the collection is empty or contains no valid elements.\n    \"\"\"\n    max_elem: Optional[Sequence[Any]] = None\n    max_len: int = -1\n\n    for item in collection:\n        current_len: Optional[int] = None\n        try:\n            current_len = len(item)\n        except (TypeError, AttributeError):\n            # Skip items that do not support len()\n            continue\n\n        if current_len is not None:\n            if max_elem is None or current_len > max_len:\n                max_elem = item\n                max_len = current_len\n    \n    return max_elem"}
