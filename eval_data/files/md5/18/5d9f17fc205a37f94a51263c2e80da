{"task_id": "Mbpp/626", "solution": "import math\nfrom typing import Any, Optional\n\nclass InvalidRadiusError(ValueError):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\ndef is_number(value: Any) -> bool:\n    try:\n        v = float(value)\n    except (TypeError, ValueError):\n        return False\n    if math.isnan(v) or math.isinf(v):\n        return False\n    return True\n\nclass InputValidator:\n    def validate_radius(self, radius: Any) -> None:\n        if not is_number(radius):\n            raise TypeError(\"radius must be a number\")\n        r = float(radius)\n        if r < 0:\n            raise InvalidRadiusError(\"radius must be >= 0\")\n\nclass TriangleAreaService:\n    def compute_max_area(self, radius: float) -> float:\n        r = float(radius)\n        if r < 0:\n            raise ValueError(\"radius must be >= 0\")\n        return r * r\n\nclass TriangleController:\n    def __init__(self, validator: InputValidator, service: TriangleAreaService) -> None:\n        self._validator = validator\n        self._service = service\n\n    def get_max_area(self, radius: float) -> Optional[float]:\n        try:\n            self._validator.validate_radius(radius)\n        except InvalidRadiusError:\n            return None\n        return self._service.compute_max_area(float(radius))\n\n_controller = TriangleController(InputValidator(), TriangleAreaService())\n\ndef triangle_area(radius: float) -> Optional[float]:\n    \"\"\"\n    Calculates the maximal area for a triangle inscribed in a semicircle of given radius.\n    Returns None for negative radius values.\n    \"\"\"\n    return _controller.get_max_area(radius)"}
{"task_id": "Mbpp/622", "solution": "from abc import ABC, abstractmethod\nfrom typing import Sequence, Any, Union, Dict\n\n# 1. Exceptions (from src/median_finder/exceptions.py)\nclass MedianError(Exception):\n    pass\n\nclass InvalidInputError(MedianError):\n    pass\n\nclass NotSameSizeError(MedianError):\n    pass\n\n# 2. InputValidator (from src/median_finder/validator.py)\nclass InputValidator:\n    def validate(self, list1: Sequence[Any], list2: Sequence[Any], n: int) -> None:\n        \"\"\"Validates input sequences for type, length, and sortedness.\"\"\"\n        if not isinstance(list1, Sequence) or not isinstance(list2, Sequence):\n            raise InvalidInputError(\"Inputs must be sequences (e.g., list or tuple).\")\n        \n        if n <= 0:\n            raise InvalidInputError(\"List size 'n' must be a positive integer.\")\n        \n        if len(list1) != n or len(list2) != n:\n            raise NotSameSizeError(f\"List lengths must both be equal to n ({n}). Got {len(list1)} and {len(list2)}.\")\n        \n        if not self._is_numeric_sequence(list1) or not self._is_numeric_sequence(list2):\n            raise InvalidInputError(\"All list elements must be numeric and comparable.\")\n        \n        if not self._check_sorted(list1) or not self._check_sorted(list2):\n            raise InvalidInputError(\"Input lists must be sorted in ascending order.\")\n\n    def _is_numeric_sequence(self, seq: Sequence[Any]) -> bool:\n        \"\"\"Checks if all elements in the sequence are numeric.\"\"\"\n        for x in seq:\n            if not isinstance(x, (int, float)):\n                return False\n        return True\n\n    def _check_sorted(self, seq: Sequence[Any]) -> bool:\n        \"\"\"Checks if the sequence is sorted in ascending order.\"\"\"\n        if not seq:\n            return True\n        for i in range(len(seq) - 1):\n            if seq[i] > seq[i+1]:\n                return False\n        return True\n\n# 3. Algorithms (from src/median_finder/algorithms.py)\nclass MedianAlgorithm(ABC):\n    @abstractmethod\n    def find_median(self, list1: Sequence[Union[int, float]], list2: Sequence[Union[int, float]], n: int) -> float:\n        \"\"\"Abstract method to find the median of two sorted lists of size n.\"\"\"\n        pass\n\nclass MergeMedianAlgorithm(MedianAlgorithm):\n    def find_median(self, list1: Sequence[Union[int, float]], list2: Sequence[Union[int, float]], n: int) -> float:\n        \"\"\"Finds the median by merging elements until the middle two are found.\"\"\"\n        i = j = 0\n        m1 = m2 = 0.0 # m1 is current, m2 is previous\n        \n        for _ in range(n + 1):\n            if i == n: # list1 is exhausted\n                m2 = m1\n                m1 = list2[j]\n                j += 1\n            elif j == n: # list2 is exhausted\n                m2 = m1\n                m1 = list1[i]\n                i += 1\n            elif list1[i] <= list2[j]:\n                m2 = m1\n                m1 = list1[i]\n                i += 1\n            else:\n                m2 = m1\n                m1 = list2[j]\n                j += 1\n        return (m1 + m2) / 2.0\n\nclass DivideConquerMedianAlgorithm(MedianAlgorithm):\n    def find_median(self, a: Sequence[Union[int, float]], b: Sequence[Union[int, float]], n: int) -> float:\n        \"\"\"Finds the median using a recursive divide-and-conquer approach (O(log n)).\"\"\"\n        return self._median_recursive(a, b, n)\n\n    def _median_recursive(self, arr1: Sequence[Union[int, float]], arr2: Sequence[Union[int, float]], n_current: int) -> float:\n        \"\"\"Recursive helper for finding the median of two sorted arrays of equal size n_current.\"\"\"\n        if n_current == 1:\n            return float(arr1[0] + arr2[0]) / 2.0\n        \n        if n_current == 2:\n            return (max(arr1[0], arr2[0]) + min(arr1[1], arr2[1])) / 2.0\n\n        idx_mid = (n_current - 1) // 2\n\n        m1 = arr1[idx_mid]\n        m2 = arr2[idx_mid]\n\n        if m1 == m2:\n            return float(m1)\n\n        if m1 < m2:\n            # Median lies in arr1[idx_mid:] and arr2[:n_current - idx_mid]\n            return self._median_recursive(arr1[idx_mid:], arr2[:n_current - idx_mid], n_current - idx_mid)\n        else: # m1 > m2\n            # Median lies in arr1[:n_current - idx_mid] and arr2[idx_mid:]\n            return self._median_recursive(arr1[:n_current - idx_mid], arr2[idx_mid:], n_current - idx_mid)\n\n# 4. MedianService (from src/median_finder/services.py)\nclass MedianService:\n    def __init__(self, algorithms: Dict[str, MedianAlgorithm]) -> None:\n        \"\"\"Initializes the service with a dictionary of algorithm implementations.\"\"\"\n        self._algorithms = algorithms\n\n    def compute_median(self, list1: Sequence[Union[int, float]], list2: Sequence[Union[int, float]], n: int, algorithm: str = \"divide_and_conquer\") -> float:\n        \"\"\"Computes the median using the specified algorithm.\"\"\"\n        selected_algorithm = self._select_algorithm(algorithm)\n        return selected_algorithm.find_median(list1, list2, n)\n\n    def _select_algorithm(self, name: str) -> MedianAlgorithm:\n        \"\"\"Selects and returns the MedianAlgorithm instance by name.\"\"\"\n        algo = self._algorithms.get(name)\n        if algo is None:\n            raise ValueError(f\"Unsupported algorithm: {name}. Choose from {list(self._algorithms.keys())}.\")\n        return algo\n\n# 5. MedianController (from src/median_finder/controller.py)\nclass MedianController:\n    def __init__(self, service: 'MedianService', validator: 'InputValidator') -> None:\n        \"\"\"Initializes the controller with injected service and validator dependencies.\"\"\"\n        self._service = service\n        self._validator = validator\n\n    def handle_request(self, list1: Sequence[Union[int, float]], list2: Sequence[Union[int, float]], n: int, algorithm: str) -> float:\n        \"\"\"Handles a median calculation request, including validation and delegation to the service.\"\"\"\n        self._validator.validate(list1, list2, n)\n        return self._service.compute_median(list1, list2, n, algorithm)\n\n# Global instances as per src/median_finder/api.py snippet\n_default_service = MedianService({\n    \"divide_and_conquer\": DivideConquerMedianAlgorithm(),\n    \"merge\": MergeMedianAlgorithm()\n})\n_default_validator = InputValidator()\n_controller = MedianController(_default_service, _default_validator)\n\ndef get_median(list1: Sequence[Union[int, float]], list2: Sequence[Union[int, float]], n: int, algorithm: str = \"divide_and_conquer\") -> float:\n    \"\"\"\n    Finds the median of two sorted lists of the same size.\n    Delegates to a controller for validation and algorithm selection.\n    \"\"\"\n    return _controller.handle_request(list1, list2, n, algorithm)"}
{"task_id": "Mbpp/629", "solution": "from typing import Any, List, Optional\n\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input to the Split function.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\ndef validate_and_cast_list(numbers: Any) -> List[int]:\n    \"\"\"Validates and casts an input to a list of integers, raising InvalidInputError on failure.\"\"\"\n    if numbers is None:\n        return []\n    if isinstance(numbers, (list, tuple)):\n        out = []\n        for i, v in enumerate(numbers):\n            try:\n                out.append(int(v))\n            except (ValueError, TypeError):\n                raise InvalidInputError(f\"Element at index {i} is not an int: {v!r}\")\n        return out\n    raise InvalidInputError(\"Input must be a list or tuple of integers or convertible values.\")\n\nclass NumberFilter:\n    \"\"\"Encapsulates logic for checking and filtering even numbers.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def is_even(self, n: int) -> bool:\n        \"\"\"Checks if a given integer is even.\"\"\"\n        return (n % 2) == 0\n\n    def filter_even(self, numbers: List[int]) -> List[int]:\n        \"\"\"Filters a list of numbers, returning only the even ones.\"\"\"\n        return [n for n in numbers if self.is_even(n)]\n\nclass NumberRepository:\n    \"\"\"Provides an in-memory repository for a list of numbers, supporting get and set operations.\"\"\"\n    def __init__(self, numbers: Optional[List[int]] = None) -> None:\n        self._storage = numbers if numbers is not None else []\n\n    def get_all(self) -> List[int]:\n        \"\"\"Returns a copy of all numbers currently in storage.\"\"\"\n        return list(self._storage)\n\n    def set(self, numbers: List[int]) -> None:\n        \"\"\"Sets the internal storage to a new list of numbers.\"\"\"\n        self._storage = list(numbers)\n\nclass SplitService:\n    \"\"\"Orchestrates the business logic to filter even numbers from a given list.\"\"\"\n    def __init__(self, filter: NumberFilter, repository: NumberRepository) -> None:\n        self._filter = filter\n        self._repo = repository\n\n    def split_numbers(self, numbers: List[int]) -> List[int]:\n        \"\"\"Stores the input numbers and returns the filtered even numbers.\"\"\"\n        self._repo.set(numbers)\n        return self._filter.filter_even(numbers)\n\nclass SplitController:\n    \"\"\"Handles raw input, validates it, and invokes the SplitService for processing.\"\"\"\n    def __init__(self, service: SplitService) -> None:\n        self._service = service\n\n    def handle_split(self, raw_input: Any) -> List[int]:\n        \"\"\"Validates the raw input, then processes it to find even numbers.\"\"\"\n        validated_numbers = validate_and_cast_list(raw_input)\n        return self._service.split_numbers(validated_numbers)\n\ndef Split(numbers: list) -> list:\n    \"\"\"\n    Finds even numbers from a list of numbers.\n    assert Split([1,2,3,4,5]) == [2,4]\n    \"\"\"\n    repo = NumberRepository()\n    filt = NumberFilter()\n    svc = SplitService(filter=filt, repository=repo)\n    ctrl = SplitController(service=svc)\n    return ctrl.handle_split(numbers)"}
{"task_id": "Mbpp/630", "solution": "import abc\nfrom dataclasses import dataclass\nfrom typing import Any, Dict, List, Optional, Tuple\n\n\nclass InvalidCoordinateError(ValueError):\n    \"\"\"Exception raised for invalid coordinate inputs.\"\"\"\n    pass\n\n\nclass RepositoryError(RuntimeError):\n    \"\"\"Exception raised for repository operation failures.\"\"\"\n    pass\n\n\n@dataclass\nclass Coordinate:\n    \"\"\"Domain model representing a coordinate pair.\"\"\"\n    x: int\n    y: int\n\n    @staticmethod\n    def from_tuple(coord: Tuple[int, int]) -> \"Coordinate\":\n        \"\"\"Factory method to create a Coordinate from a tuple.\"\"\"\n        validate_coordinate(coord)\n        return Coordinate(int(coord[0]), int(coord[1]))\n\n\ndef validate_coordinate(coord: Any) -> None:\n    \"\"\"Validates that the input is a tuple/list of two integers.\"\"\"\n    if not (isinstance(coord, (tuple, list)) and len(coord) == 2):\n        raise InvalidCoordinateError(\"Coordinate must be a tuple/list of two integers.\")\n    if not all(isinstance(v, int) for v in coord):\n        raise InvalidCoordinateError(\"Coordinate values must be integers.\")\n\n\ndef compute_adjacent_coords(coord: Coordinate) -> List[List[int]]:\n    \"\"\"Computes the 3x3 block of coordinates around the given coordinate.\"\"\"\n    result = []\n    for dx in (-1, 0, 1):\n        for dy in (-1, 0, 1):\n            result.append([coord.x + dx, coord.y + dy])\n    return result\n\n\nclass CoordinateRepository(abc.ABC):\n    \"\"\"Abstract Base Class for coordinate result repositories.\"\"\"\n    @abc.abstractmethod\n    def save(self, coord: Coordinate, result: List[List[int]]) -> None:\n        pass\n\n    @abc.abstractmethod\n    def get(self, coord: Coordinate) -> Optional[List[List[int]]]:\n        pass\n\n\nclass InMemoryCoordinateRepository(CoordinateRepository):\n    \"\"\"In-memory implementation of CoordinateRepository for caching.\"\"\"\n    def __init__(self):\n        self._store: Dict[Tuple[int, int], List[List[int]]] = {}\n\n    def save(self, coord: Coordinate, result: List[List[int]]) -> None:\n        try:\n            self._store[(coord.x, coord.y)] = result\n        except Exception as e:\n            raise RepositoryError(f\"Failed to save to in-memory repository: {e}\") from e\n\n    def get(self, coord: Coordinate) -> Optional[List[List[int]]]:\n        try:\n            return self._store.get((coord.x, coord.y))\n        except Exception as e:\n            raise RepositoryError(f\"Failed to retrieve from in-memory repository: {e}\") from e\n\n\nDEFAULT_REPO_ENABLED: bool = False\n\n\nclass CoordinateService:\n    \"\"\"Service for computing adjacent coordinates, with optional caching.\"\"\"\n    def __init__(self, repo: Optional[CoordinateRepository] = None):\n        self._repo = repo\n\n    def compute_adjacent(self, coord: Coordinate) -> List[List[int]]:\n        \"\"\"Computes adjacent coordinates after validating the input.\"\"\"\n        validate_coordinate((coord.x, coord.y))\n        return compute_adjacent_coords(coord)\n\n    def get_or_compute(self, coord: Coordinate) -> List[List[int]]:\n        \"\"\"Retrieves cached result or computes and stores it.\"\"\"\n        if self._repo:\n            cached = self._repo.get(coord)\n            if cached is not None:\n                return cached\n        result = self.compute_adjacent(coord)\n        if self._repo:\n            self._repo.save(coord, result)\n        return result\n\n\ndef get_coordinates(coord: Tuple[int, int]) -> List[List[int]]:\n    \"\"\"\n    Extracts all the adjacent coordinates of the given coordinate tuple, including itself.\n    Returns a 3x3 block of coordinates centered at the input.\n    \"\"\"\n    c = Coordinate.from_tuple(coord)\n    repo = InMemoryCoordinateRepository() if DEFAULT_REPO_ENABLED else None\n    service = CoordinateService(repo=repo)\n    return service.get_or_compute(c)"}
{"task_id": "Mbpp/631", "solution": "import re\n\ndef replace_spaces(text: str, to_underscore: bool = True) -> str:\n    \"\"\"Replaces whitespaces with an underscore or vice versa based on the to_underscore flag.\"\"\"\n    if to_underscore:\n        # Collapse all forms of whitespace (space, tab, newline, etc.) into a single space,\n        # then replace that single space with an underscore.\n        normalized_text = re.sub(r'\\s+', ' ', text)\n        return normalized_text.replace(' ', '_')\n    else:\n        # Collapse multiple consecutive underscores into a single underscore,\n        # then replace that single underscore with a space.\n        collapsed_underscores = re.sub(r'_+', '_', text)\n        return collapsed_underscores.replace('_', ' ')"}
{"task_id": "Mbpp/632", "solution": "from typing import List, Any\n\ndef move_zero(items: List[Any]) -> List[Any]:\n    \"\"\"\n    Moves all zero-equivalent elements to the end of the list while preserving\n    the relative order of non-zero elements. Numeric 0s are considered zero-equivalent,\n    but boolean False is not by default.\n    \"\"\"\n    non_zeros = []\n    zeros = []\n\n    for item in items:\n        is_current_item_zero = False\n        if isinstance(item, bool):\n            # Boolean False is not treated as zero-equivalent by default as per design context\n            is_current_item_zero = False\n        else:\n            try:\n                is_current_item_zero = (item == 0)\n            except (TypeError, ValueError):\n                # Handle cases where item cannot be compared to 0 (e.g., string, None)\n                is_current_item_zero = False\n        \n        if is_current_item_zero:\n            zeros.append(item)\n        else:\n            non_zeros.append(item)\n            \n    return non_zeros + zeros"}
{"task_id": "Mbpp/633", "solution": "from typing import List\n\ndef pair_xor_Sum(numbers: List[int], n_len: int) -> int:\n    \"\"\"\n    Finds the sum of XOR of all pairs of numbers in the given list.\n    The algorithm computes the contribution of each bit position efficiently.\n    \"\"\"\n    if n_len < 2:\n        return 0\n\n    MAX_BITS = 64\n    total_xor_sum = 0\n\n    # Count how many numbers have the i-th bit set\n    bit_counts = [0] * MAX_BITS\n    for num in numbers:\n        for i in range(MAX_BITS):\n            if (num >> i) & 1:\n                bit_counts[i] += 1\n\n    # Sum contributions from each bit position\n    for i, count_set_bits in enumerate(bit_counts):\n        # Number of pairs where the i-th bit will be 1 in their XOR sum\n        # is count_set_bits * (n_len - count_set_bits)\n        diff_pairs = count_set_bits * (n_len - count_set_bits)\n        total_xor_sum += diff_pairs * (1 << i)\n\n    return total_xor_sum"}
{"task_id": "Mbpp/638", "solution": "def wind_chill(velocity_kmh: float, temperature_c: float) -> int:\n    \"\"\"\n    Calculates the wind chill index given wind velocity in km/h and temperature in Celsius,\n    rounded to the nearest integer.\n    \"\"\"\n    COEF_A: float = 13.12\n    COEF_B: float = 0.6215\n    COEF_C: float = -11.37\n    COEF_D: float = 0.3965\n\n    # Calculate v^0.16, ensuring velocity is non-negative for the power calculation.\n    v_pow_0_16 = max(0.0, velocity_kmh) ** 0.16\n\n    # Apply the standard wind chill formula.\n    raw_wind_chill = (\n        COEF_A\n        + COEF_B * temperature_c\n        + COEF_C * v_pow_0_16\n        + COEF_D * temperature_c * v_pow_0_16\n    )\n\n    # Round the result to the nearest integer.\n    return int(round(raw_wind_chill))"}
{"task_id": "Mbpp/641", "solution": "def is_nonagonal(n: int) -> int:\n    \"\"\"\n    Computes the nth nonagonal number using the formula P9(n) = (7*n^2 - 5*n) / 2.\n    Assumes n is a positive integer.\n    \"\"\"\n    return (7 * n * n - 5 * n) // 2"}
{"task_id": "Mbpp/639", "solution": "def sample_nam(names):\n    total_length = 0\n    for name in names:\n        # A name is kept if it is empty or its first character is not a lowercase ASCII letter.\n        # Names starting with lowercase are removed.\n        if not name or not ('a' <= name[0] <= 'z'):\n            total_length += len(name)\n    return total_length"}
{"task_id": "Mbpp/635", "solution": "from typing import List, Sequence, Optional, Iterable, Any\n\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input to sorting functions.\"\"\"\n    pass\n\nclass InvalidOperationError(RuntimeError):\n    \"\"\"Exception raised for invalid operations on data structures like Heap.\"\"\"\n    pass\n\nclass Validator:\n    \"\"\"Utility class for validating input sequences.\"\"\"\n    ALLOWED_TYPES = (int,)\n\n    def validate_sequence(self, values: Any) -> List[int]:\n        \"\"\"\n        Validates if the input is an iterable of allowed types and converts it to a list of ints.\n        Raises InvalidInputError if validation fails.\n        \"\"\"\n        if values is None:\n            return []\n        if isinstance(values, str):\n            raise InvalidInputError(\"String inputs are not accepted; provide list/iterable of ints or use --json in CLI.\")\n        try:\n            iter(values)\n        except TypeError:\n            raise InvalidInputError(\"Provided value is not iterable.\")\n        \n        result = []\n        for i, v in enumerate(values):\n            if not isinstance(v, self.ALLOWED_TYPES):\n                raise InvalidInputError(f\"Element at index {i} is not {self.ALLOWED_TYPES[0].__name__}: {v!r}\")\n            result.append(v)\n        return result\n\n    def is_iterable(self, obj: Any) -> bool:\n        \"\"\"Checks if an object is iterable, excluding strings.\"\"\"\n        return not isinstance(obj, str) and hasattr(obj, '__iter__')\n\nclass Heap:\n    \"\"\"A min-binary heap implementation.\"\"\"\n\n    def __init__(self, data: Optional[Iterable[int]] = None) -> None:\n        \"\"\"Initializes the heap, optionally building it from an iterable.\"\"\"\n        self._data: List[int] = []\n        if data is not None:\n            self.build_heap(data)\n\n    def build_heap(self, data: Iterable[int]) -> None:\n        \"\"\"Builds the heap from an iterable in O(n) time.\"\"\"\n        self._data = list(data)\n        n = len(self._data)\n        for i in range((n // 2) - 1, -1, -1):\n            self._sift_down(i)\n\n    def push(self, value: int) -> None:\n        \"\"\"Adds a value to the heap and maintains the heap property.\"\"\"\n        self._data.append(value)\n        self._sift_up(len(self._data) - 1)\n\n    def pop(self) -> int:\n        \"\"\"Removes and returns the smallest element from the heap.\"\"\"\n        if not self._data:\n            raise InvalidOperationError(\"Heap is empty\")\n        \n        root = self._data[0]\n        last = self._data.pop()\n        \n        if self._data:\n            self._data[0] = last\n            self._sift_down(0)\n            \n        return root\n\n    def peek(self) -> int:\n        \"\"\"Returns the smallest element in the heap without removing it.\"\"\"\n        if not self._data:\n            raise InvalidOperationError(\"Heap is empty\")\n        return self._data[0]\n\n    def size(self) -> int:\n        \"\"\"Returns the number of elements in the heap.\"\"\"\n        return len(self._data)\n\n    def _sift_up(self, idx: int) -> None:\n        \"\"\"Moves an element up the heap to maintain the min-heap property.\"\"\"\n        while idx > 0:\n            parent_idx = (idx - 1) // 2\n            if self._data[idx] < self._data[parent_idx]:\n                self._data[idx], self._data[parent_idx] = self._data[parent_idx], self._data[idx]\n                idx = parent_idx\n            else:\n                break\n\n    def _sift_down(self, idx: int) -> None:\n        \"\"\"Moves an element down the heap to maintain the min-heap property.\"\"\"\n        n = len(self._data)\n        while True:\n            left_child_idx = 2 * idx + 1\n            right_child_idx = 2 * idx + 2\n            smallest_idx = idx\n\n            if left_child_idx < n and self._data[left_child_idx] < self._data[smallest_idx]:\n                smallest_idx = left_child_idx\n            \n            if right_child_idx < n and self._data[right_child_idx] < self._data[smallest_idx]:\n                smallest_idx = right_child_idx\n            \n            if smallest_idx != idx:\n                self._data[idx], self._data[smallest_idx] = self._data[smallest_idx], self._data[idx]\n                idx = smallest_idx\n            else:\n                break\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns a shallow copy of the internal heap data.\"\"\"\n        return list(self._data)\n\nclass HeapSortService:\n    \"\"\"Orchestrates the heap sort algorithm.\"\"\"\n\n    def __init__(self, validator: Validator = None) -> None:\n        \"\"\"Initializes the service with an optional validator.\"\"\"\n        self.validator = validator or Validator()\n\n    def sort(self, values: Sequence[int]) -> List[int]:\n        \"\"\"\n        Sorts a sequence of integers using the heap sort algorithm.\n        Returns a new list with elements in ascending order.\n        \"\"\"\n        nums = self.validator.validate_sequence(values)\n        \n        heap = Heap()\n        for v in nums:\n            heap.push(v)\n            \n        result: List[int] = []\n        while heap.size() > 0:\n            result.append(heap.pop())\n            \n        return result\n\ndef heap_sort(values: Sequence[int]) -> List[int]:\n    \"\"\"\n    Sorts a list of integers using the heap sort algorithm.\n    Returns a new list with elements in ascending order.\n    \"\"\"\n    return HeapSortService().sort(values)"}
{"task_id": "Mbpp/637", "solution": "import sqlite3\nimport math\nimport logging\nfrom datetime import datetime\nfrom dataclasses import dataclass\nfrom typing import Optional, List, Any\n\n# Configure a logger for internal use\n_logger = logging.getLogger(__name__)\n\n# --- Exceptions ---\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    pass\n\nclass PersistenceError(Exception):\n    \"\"\"Exception raised for database-related errors.\"\"\"\n    pass\n\n# --- Models ---\n@dataclass\nclass Amount:\n    \"\"\"Data transfer object for cost and selling amounts.\"\"\"\n    cost: float\n    selling: float\n\n@dataclass\nclass AuditRecord:\n    \"\"\"Data transfer object for audit log entries.\"\"\"\n    id: Optional[int]\n    timestamp: str\n    cost: float\n    selling: float\n    result: bool\n    tolerance: Optional[float]\n\n# --- Utilities ---\ndef now_iso() -> str:\n    \"\"\"Returns the current UTC time in ISO8601 format with milliseconds.\"\"\"\n    return datetime.utcnow().isoformat(timespec='milliseconds') + \"Z\"\n\ndef floats_equal(a: float, b: float, tol: Optional[float]) -> bool:\n    \"\"\"\n    Compares two floats for equality, optionally within a given tolerance.\n    If tolerance is None or non-positive, performs exact equality check.\n    \"\"\"\n    if tol is None or tol <= 0.0:\n        return a == b\n    return abs(a - b) <= tol\n\n# --- Repository (Persistence Layer) ---\nCREATE_TABLE_SQL = \"\"\"CREATE TABLE IF NOT EXISTS audit (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  timestamp TEXT NOT NULL,\n  cost REAL NOT NULL,\n  selling REAL NOT NULL,\n  result INTEGER NOT NULL,\n  tolerance REAL\n);\"\"\"\n\nclass AuditRepository:\n    \"\"\"Handles persistence of audit records to an SQLite database.\"\"\"\n    def __init__(self, db_path: str = \"profitloss_audit.db\"):\n        self.db_path = db_path\n        self.init_db()\n\n    def init_db(self) -> None:\n        \"\"\"Initializes the database by creating the audit table if it doesn't exist.\"\"\"\n        conn = self._connect()\n        try:\n            conn.execute(CREATE_TABLE_SQL)\n            conn.commit()\n        finally:\n            conn.close()\n\n    def insert(self, record: AuditRecord) -> int:\n        \"\"\"Inserts a new audit record into the database.\"\"\"\n        conn = self._connect()\n        try:\n            cur = conn.cursor()\n            cur.execute(\n                \"INSERT INTO audit (timestamp, cost, selling, result, tolerance) VALUES (?, ?, ?, ?, ?)\",\n                (record.timestamp, record.cost, record.selling, int(record.result), record.tolerance)\n            )\n            conn.commit()\n            return cur.lastrowid\n        except sqlite3.DatabaseError as e:\n            raise PersistenceError(f\"Database error during audit record insert: {e}\")\n        finally:\n            conn.close()\n\n    def query_recent(self, limit: int = 100) -> List[AuditRecord]:\n        \"\"\"Queries recent audit records from the database.\"\"\"\n        conn = self._connect()\n        try:\n            cur = conn.cursor()\n            cur.execute(\"SELECT id, timestamp, cost, selling, result, tolerance FROM audit ORDER BY timestamp DESC LIMIT ?\", (limit,))\n            rows = cur.fetchall()\n            return [AuditRecord(id=row[\"id\"], timestamp=row[\"timestamp\"], cost=row[\"cost\"], selling=row[\"selling\"], result=bool(row[\"result\"]), tolerance=row[\"tolerance\"]) for row in rows]\n        except sqlite3.DatabaseError as e:\n            raise PersistenceError(f\"Database error during audit record query: {e}\")\n        finally:\n            conn.close()\n\n    def _connect(self) -> sqlite3.Connection:\n        \"\"\"Establishes a connection to the SQLite database.\"\"\"\n        conn = sqlite3.connect(self.db_path)\n        conn.row_factory = sqlite3.Row\n        return conn\n\n# --- Validator ---\nclass AmountValidator:\n    \"\"\"Validates and coerces input amounts.\"\"\"\n    def validate(self, cost: Any, selling: Any) -> Amount:\n        \"\"\"\n        Validates that cost and selling are finite, non-negative numeric values.\n        Raises ValidationError if validation fails.\n        \"\"\"\n        try:\n            c = float(cost)\n            s = float(selling)\n        except (TypeError, ValueError):\n            raise ValidationError(\"Cost and selling must be numeric values.\")\n        if not (math.isfinite(c) and math.isfinite(s)):\n            raise ValidationError(\"Cost and selling values must be finite numbers.\")\n        if c < 0 or s < 0:\n            raise ValidationError(\"Cost and selling values must be non-negative.\")\n        return Amount(cost=c, selling=s)\n\n# --- Service (Business Logic Layer) ---\nclass ProfitLossService:\n    \"\"\"Encapsulates the core business logic for profit/loss evaluation and audit.\"\"\"\n    def __init__(self, validator: 'AmountValidator', repo: 'AuditRepository') -> None:\n        self._validator = validator\n        self._repo = repo\n\n    def evaluate(self, cost: Any, selling: Any, tolerance: Optional[float] = None, audit: bool = True) -> bool:\n        \"\"\"\n        Validates inputs, determines if there is no profit/no loss, and\n        optionally records the transaction in an audit log.\n        \"\"\"\n        amt = self._validator.validate(cost, selling)\n\n        result = self._is_no_profit_no_loss(amt.cost, amt.selling, tolerance)\n\n        if audit:\n            record = AuditRecord(id=None, timestamp=now_iso(), cost=amt.cost, selling=amt.selling, result=result, tolerance=tolerance)\n            try:\n                self._repo.insert(record)\n            except PersistenceError as e:\n                _logger.error(f\"Failed to audit no-profit-no-loss check: {e}\")\n        return result\n\n    def _is_no_profit_no_loss(self, cost: float, selling: float, tolerance: Optional[float]) -> bool:\n        \"\"\"Compares cost and selling price using the configured tolerance.\"\"\"\n        return floats_equal(cost, selling, tolerance)\n\n# --- Controller (API/CLI interaction Layer) ---\nclass ProfitLossController:\n    \"\"\"Handles requests, delegates to service, and manages error propagation.\"\"\"\n    def __init__(self, service: 'ProfitLossService') -> None:\n        self.service = service\n\n    def check(self, cost: float, selling: float, tolerance: Optional[float] = None, audit: bool = True) -> bool:\n        \"\"\"\n        Performs the no profit/no loss check by delegating to the service.\n        Propagates ValidationError for invalid inputs.\n        \"\"\"\n        try:\n            result = self.service.evaluate(cost, selling, tolerance, audit)\n            return result\n        except ValidationError:\n            # Re-raise ValidationError for programmatic usage, as per design.\n            raise\n\n# --- API (Public Facade Layer) ---\nclass ProfitLossAPI:\n    \"\"\"Provides the public API interface for the profit/loss functionality.\"\"\"\n    def __init__(self):\n        repo = AuditRepository()\n        validator = AmountValidator()\n        service = ProfitLossService(validator, repo)\n        self._controller = ProfitLossController(service)\n\n    def noprofit_noloss(self, cost: float, selling: float, tolerance: Optional[float] = None, audit: bool = True) -> bool:\n        \"\"\"\n        Checks if the given cost and selling prices indicate no profit and no loss.\n        Delegates the check to the underlying controller.\n        \"\"\"\n        return self._controller.check(cost, selling, tolerance, audit)\n\n# --- Top-level function ---\n_profit_loss_api_instance: Optional[ProfitLossAPI] = None\n\ndef noprofit_noloss(cost: float, selling: float, tolerance: Optional[float] = None, audit: bool = True) -> bool:\n    \"\"\"\n    Checks if the given amount has no profit and no loss.\n    This is the main entry point for the library.\n    \"\"\"\n    global _profit_loss_api_instance\n    if _profit_loss_api_instance is None:\n        _profit_loss_api_instance = ProfitLossAPI()\n    return _profit_loss_api_instance.noprofit_noloss(cost, selling, tolerance, audit)"}
{"task_id": "Mbpp/643", "solution": "import re\n\ndef text_match_wordz_middle(text: str) -> bool:\n    \"\"\"\n    Checks if a string contains 'z' (case-insensitive) that is not at the start or end of any word.\n    A 'word' is defined as a sequence of Unicode word characters.\n    \"\"\"\n    # Compile the regex pattern to find 'z' (case-insensitive) surrounded by word characters.\n    # (?i) enables case-insensitive matching.\n    # (?<=\\w) is a positive lookbehind assertion for a word character.\n    # (?=\\w) is a positive lookahead assertion for a word character.\n    z_middle_pattern = re.compile(r'(?i)(?<=\\w)z(?=\\w)', flags=re.UNICODE)\n\n    # Compile the regex pattern to find all words (sequences of word characters).\n    word_pattern = re.compile(r\"\\w+\", flags=re.UNICODE)\n\n    # Tokenize the input text into a list of words.\n    words = [match.group(0) for match in word_pattern.finditer(text)]\n\n    # Iterate through the extracted words and check if any word contains 'z' in the middle.\n    for word in words:\n        if z_middle_pattern.search(word):\n            return True\n            \n    # If no 'z' is found in the middle of any word, return False.\n    return False"}
{"task_id": "Mbpp/720", "solution": "from typing import Tuple, Any, Dict\n\n\ndef add_dict_to_tuple(input_tuple: Tuple[Any, ...], dict_obj: Dict[Any, Any]) -> Tuple[Any, ...]:\n    \"\"\"\n    Appends a dictionary as a single element to a tuple.\n    Returns a new tuple with the dictionary added to the end.\n    \"\"\"\n    return input_tuple + (dict_obj,)"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(arr, k):\n    \"\"\"\n    Reverses the first k elements of an array and returns a new array.\n    The elements beyond position k remain unchanged.\n    \"\"\"\n    return arr[:k][::-1] + arr[k:]"}
{"task_id": "Mbpp/724", "solution": "import math\n\ndef power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    Handles big integers by converting the result to a string for digit summation.\n    \"\"\"\n    result = pow(base, power)\n    return sum(int(digit) for digit in str(abs(result)))"}
{"task_id": "Mbpp/722", "solution": "import math\nfrom typing import Dict, Tuple, Any, List, Optional\nfrom dataclasses import dataclass\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input data.\"\"\"\n    pass\n\n@dataclass(frozen=True)\nclass Student:\n    \"\"\"Immutable value object for a student's data.\"\"\"\n    name: str\n    height: float\n    weight: float\n\n    @staticmethod\n    def from_tuple(name: str, data: Tuple[float, float]) -> \"Student\":\n        \"\"\"Construct Student from a (height, weight) tuple.\"\"\"\n        if not (isinstance(name, str) and isinstance(data, (tuple, list)) and len(data) == 2):\n            raise InvalidInputError(f\"Invalid student entry for {name}\")\n        try:\n            h, w = float(data[0]), float(data[1])\n        except Exception as e:\n            raise InvalidInputError(f\"Height and weight for {name} must be numeric: {e}\")\n        return Student(name=name, height=h, weight=w)\n\n    def to_tuple(self) -> Tuple[float, float]:\n        \"\"\"Return (height, weight) tuple.\"\"\"\n        return (self.height, self.weight)\n\nclass StudentRepository:\n    \"\"\"Abstract interface for loading and retrieving students.\"\"\"\n    def load_from_dict(self, data: Dict[str, Tuple[float, float]]) -> None:\n        raise NotImplementedError\n\n    def get_all(self) -> List[Student]:\n        raise NotImplementedError\n\n    def get_by_name(self, name: str) -> Optional[Student]:\n        raise NotImplementedError\n\nclass InMemoryStudentRepository(StudentRepository):\n    \"\"\"In-memory implementation of StudentRepository.\"\"\"\n    def __init__(self) -> None:\n        self._students: Dict[str, Student] = {}\n\n    def load_from_dict(self, data: Dict[str, Tuple[float, float]]) -> None:\n        \"\"\"Populate _students by converting dict entries to Student instances.\"\"\"\n        self._students = {}\n        for name, tup in data.items():\n            student = Student.from_tuple(name, tup)\n            self._students[name] = student\n\n    def get_all(self) -> List[Student]:\n        \"\"\"Return current list of Student objects.\"\"\"\n        return list(self._students.values())\n\n    def get_by_name(self, name: str) -> Optional[Student]:\n        \"\"\"Get a student by name.\"\"\"\n        return self._students.get(name)\n\ndef validate_threshold(value: Any, name: str) -> float:\n    \"\"\"Ensure value is numeric (int/float), finite, not NaN. Return float value.\"\"\"\n    try:\n        v = float(value)\n    except Exception:\n        raise InvalidInputError(f\"{name} must be numeric\")\n    if math.isnan(v) or math.isinf(v):\n        raise InvalidInputError(f\"{name} must be finite and not NaN\")\n    return v\n\ndef validate_data_mapping(data: Any) -> Dict[str, Tuple[float, float]]:\n    \"\"\"Verify data is dict-like, keys are strings, values are length-2 tuples/lists of numeric values.\"\"\"\n    if not isinstance(data, dict):\n        raise InvalidInputError(\"data must be a dict mapping names to (height, weight)\")\n    result = {}\n    for k, v in data.items():\n        if not isinstance(k, str):\n            raise InvalidInputError(\"all keys must be student names (strings)\")\n        if not (isinstance(v, (list, tuple)) and len(v) == 2):\n            raise InvalidInputError(f\"value for {k} must be a tuple/list of length 2\")\n        try:\n            h = float(v[0]); w = float(v[1])\n        except Exception:\n            raise InvalidInputError(f\"height and weight for {k} must be numeric\")\n        result[k] = (h, w)\n    return result\n\nclass FilterService:\n    \"\"\"Business logic for filtering students.\"\"\"\n    def __init__(self, repo: StudentRepository):\n        \"\"\"Dependency injection of repository.\"\"\"\n        self._repo = repo\n\n    def filter_students(self, min_height: float, min_weight: float) -> Dict[str, Tuple[float, float]]:\n        \"\"\"Filter the repository's students based on height and weight thresholds.\"\"\"\n        out = {}\n        for s in self._repo.get_all():\n            if s.height > min_height and s.weight > min_weight:\n                out[s.name] = s.to_tuple()\n        return out\n\n    def filter_students_from_dict(self, data: Dict[str, Tuple[float, float]], min_height: float, min_weight: float) -> Dict[str, Tuple[float, float]]:\n        \"\"\"Convenience method that loads data into an in-memory repo and calls filter_students.\"\"\"\n        if isinstance(self._repo, InMemoryStudentRepository):\n            self._repo.load_from_dict(data)\n            return self.filter_students(min_height, min_weight)\n        raise RuntimeError(\"Repository does not support load_from_dict\")\n\ndef filter_data(data: Dict[str, Tuple[float, float]], min_height: float, min_weight: float) -> Dict[str, Tuple[float, float]]:\n    \"\"\"Filters students by minimum height and weight.\"\"\"\n    mh = validate_threshold(min_height, \"min_height\")\n    mw = validate_threshold(min_weight, \"min_weight\")\n    clean_data = validate_data_mapping(data)\n    repo = InMemoryStudentRepository()\n    repo.load_from_dict(clean_data)\n    service = FilterService(repo)\n    return service.filter_students(mh, mw)"}
{"task_id": "Mbpp/723", "solution": "from typing import List, Any\n\ndef count_same_pair(list_a: List[Any], list_b: List[Any]) -> int:\n    \"\"\"\n    Counts the number of indices where values in two lists are identical.\n    Comparison iterates up to the length of the shorter list.\n    \"\"\"\n    count = 0\n    min_len = min(len(list_a), len(list_b))\n    for i in range(min_len):\n        if list_a[i] == list_b[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/721", "solution": "import math\nfrom typing import List, Tuple, Any\n\nclass InvalidMatrixError(Exception):\n    \"\"\"Exception raised for invalid matrix input.\"\"\"\n    pass\n\ndef validate_matrix(data: List[List[Any]]) -> None:\n    \"\"\"\n    Validates if the input data represents a non-empty, rectangular matrix with numeric elements.\n    Raises InvalidMatrixError if validation fails.\n    \"\"\"\n    if not isinstance(data, list) or not data:\n        raise InvalidMatrixError(\"Matrix cannot be empty or non-list type.\")\n    \n    rows = len(data)\n    if not data[0]: # Check if first row is empty\n        raise InvalidMatrixError(\"Matrix rows cannot be empty.\")\n    cols = len(data[0])\n\n    for i, row in enumerate(data):\n        if not isinstance(row, list):\n            raise InvalidMatrixError(f\"Row {i} is not a list.\")\n        if len(row) != cols:\n            raise InvalidMatrixError(\"All rows must have the same number of columns.\")\n        for j, val in enumerate(row):\n            if not isinstance(val, (int, float)):\n                raise InvalidMatrixError(f\"Element at ({i},{j}) is not a number.\")\n\nclass MatrixModel:\n    \"\"\"Encapsulates matrix data with basic accessors and properties.\"\"\"\n    def __init__(self, data: List[List[float]]) -> None:\n        validate_matrix(data)\n        self._data = data\n        self.rows = len(data)\n        self.cols = len(data[0])\n\n    def get(self, row: int, col: int) -> float:\n        \"\"\"Returns the value at the specified row and column.\"\"\"\n        if not (0 <= row < self.rows and 0 <= col < self.cols):\n            raise IndexError(\"Matrix coordinates out of bounds.\")\n        return self._data[row][col]\n\n    def is_square(self) -> bool:\n        \"\"\"Returns True if the matrix is square (rows == cols).\"\"\"\n        return self.rows == self.cols\n\nclass DPAlgorithm:\n    \"\"\"Computes the maximum-sum path and reconstructs its coordinates in a grid.\"\"\"\n\n    def compute_max_sum(self, matrix: MatrixModel) -> Tuple[float, List[Tuple[int, int]]]:\n        \"\"\"\n        Computes the maximum total sum of a path from top-left to bottom-right,\n        moving only right or down, and reconstructs the path coordinates.\n        \"\"\"\n        n, m = matrix.rows, matrix.cols\n        \n        # dp stores the maximum sum to reach cell (r, c)\n        dp: List[List[float]] = [[float(\"-inf\")] * m for _ in range(n)]\n        \n        # The cost to reach the starting cell (0, 0) is its value\n        dp[0][0] = matrix.get(0, 0)\n\n        # Fill the rest of the dp table\n        for r in range(n):\n            for c in range(m):\n                # Consider path from the cell above\n                if r > 0:\n                    dp[r][c] = max(dp[r][c], dp[r-1][c] + matrix.get(r, c))\n                # Consider path from the cell to the left\n                if c > 0:\n                    dp[r][c] = max(dp[r][c], dp[r][c-1] + matrix.get(r, c))\n        \n        total = dp[n-1][m-1]\n        path_coords = self._reconstruct_path(dp, matrix)\n        return total, path_coords\n\n    def _reconstruct_path(self, dp: List[List[float]], matrix: MatrixModel) -> List[Tuple[int, int]]:\n        \"\"\"\n        Reconstructs the path by backtracking from the bottom-right cell\n        using the DP table to determine the previous cell.\n        \"\"\"\n        path: List[Tuple[int, int]] = []\n        r, c = matrix.rows - 1, matrix.cols - 1\n        \n        while r >= 0 and c >= 0:\n            path.append((r, c))\n            if r == 0 and c == 0:\n                break\n            \n            # Decide to move up or left based on which path led to the current cell with max sum\n            if r > 0 and c > 0:\n                if dp[r-1][c] > dp[r][c-1]:\n                    r -= 1 # Came from top\n                else:\n                    c -= 1 # Came from left\n            elif r > 0: # Only move up possible (first column)\n                r -= 1\n            elif c > 0: # Only move left possible (first row)\n                c -= 1\n            else:\n                break\n        \n        return path[::-1] # Reverse the path to get it from top-left to bottom-right\n\ndef maxAverageOfPath(matrix_data: List[List[float]]) -> float:\n    \"\"\"\n    Given a square matrix, finds a path from top-left to bottom-right with\n    the maximum average cost, moving only right or down.\n    \"\"\"\n    matrix = MatrixModel(matrix_data)\n    \n    if not matrix.is_square():\n        raise InvalidMatrixError(\"Matrix must be square (N x N).\")\n\n    algorithm = DPAlgorithm()\n    total, coords = algorithm.compute_max_sum(matrix)\n\n    path_length = len(coords)\n    if path_length == 0: # Should not happen for a valid non-empty matrix\n        raise InvalidMatrixError(\"Path length cannot be zero for a valid matrix.\")\n\n    average = total / path_length\n    return average"}
{"task_id": "Mbpp/725", "solution": "import re\n\ndef extract_quotation(text):\n    \"\"\"\n    Extracts values between double quotation marks from the given string, handling escaped quotes.\n    \"\"\"\n    DOUBLE_QUOTE_PATTERN = r'\"(?:\\\\.|[^\"\\\\])*\"'\n    compiled_regex = re.compile(DOUBLE_QUOTE_PATTERN, re.UNICODE)\n\n    matches = compiled_regex.finditer(text)\n    values = []\n    for m in matches:\n        # Strip the outer quotation marks\n        inner_content = m.group(0)[1:-1]\n        \n        # Unescape backslashes and quotes\n        # Order is important: first unescape escaped backslashes, then escaped quotes\n        unescaped_content = inner_content.replace(r'\\\\', '\\\\').replace(r'\\\"', '\"')\n        values.append(unescaped_content)\n    return values"}
{"task_id": "Mbpp/726", "solution": "import collections.abc\nfrom typing import Tuple, Union\n\ndef multiply_elements(numbers: Tuple[Union[int, float], ...]) -> Tuple[Union[int, float], ...]:\n    \"\"\"\n    Computes the product of adjacent elements in a tuple of numbers.\n    The input tuple must contain at least two numbers.\n    \"\"\"\n    if not isinstance(numbers, collections.abc.Sequence):\n        raise TypeError(\"Input must be a sequence.\")\n    if len(numbers) < 2:\n        raise ValueError(\"Input must contain at least two numbers.\")\n\n    result = []\n    for i in range(len(numbers) - 1):\n        if not isinstance(numbers[i], (int, float)) or not isinstance(numbers[i+1], (int, float)):\n            raise TypeError(\"All elements in the tuple must be numbers (int or float).\")\n        result.append(numbers[i] * numbers[i+1])\n    return tuple(result)"}
{"task_id": "Mbpp/728", "solution": "from typing import List\n\ndef sum_list(a: List[float], b: List[float]) -> List[float]:\n    \"\"\"\n    Computes the element-wise sum of two lists.\n    Assumes inputs are lists of equal length containing numbers.\n    \"\"\"\n    return [x + y for x, y in zip(a, b)]"}
{"task_id": "Mbpp/731", "solution": "import math\n\ndef lateralsurface_cone(r,h):\n    \"\"\"\n    Calculates the lateral surface area of a cone.\n    The formula used is pi * r * l, where l (slant height) = sqrt(r^2 + h^2).\n    \"\"\"\n    slant_height = math.sqrt(r * r + h * h)\n    lateral_area = math.pi * r * slant_height\n    return lateral_area"}
{"task_id": "Mbpp/732", "solution": "import collections\n\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for input validation failures.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n\n    def __str__(self) -> str:\n        return self.message\n\n\ndef validate_is_str(value: object, name: str = 'value') -> None:\n    \"\"\"Raises ValidationError if value is not a string.\"\"\"\n    if not isinstance(value, str):\n        raise ValidationError(f\"{name} must be a string (str), but got {type(value).__name__}.\")\n\n\nclass CharReplacer:\n    \"\"\"Performs character-by-character replacement.\"\"\"\n    DEFAULT_TARGETS = (' ', ',', '.')\n    DEFAULT_REPLACEMENT = ':'\n\n    def __init__(self, targets: collections.abc.Iterable[str] = DEFAULT_TARGETS, replacement: str = DEFAULT_REPLACEMENT) -> None:\n        self._targets = tuple(targets)\n        self._replacement = replacement\n        self._table = {ord(t): ord(replacement) for t in self._targets}\n\n    def replace(self, text: str) -> str:\n        \"\"\"Returns a new string where every character in targets is replaced with replacement.\"\"\"\n        return text.translate(self._table)\n\n    def set_targets(self, targets: collections.abc.Iterable[str]) -> None:\n        \"\"\"Updates the set of characters to be replaced.\"\"\"\n        self._targets = tuple(targets)\n        self._table = {ord(t): ord(self._replacement) for t in self._targets}\n\n    def set_replacement(self, repl: str) -> None:\n        \"\"\"Changes the replacement character.\"\"\"\n        self._replacement = repl\n        self._table = {ord(t): ord(self._replacement) for t in self._targets}\n\n\nclass ReplaceService:\n    \"\"\"Validates inputs and orchestrates replacement using CharReplacer.\"\"\"\n    def __init__(self, replacer: CharReplacer) -> None:\n        self._replacer = replacer\n\n    def replace(self, text: str) -> str:\n        \"\"\"Validates the input text and returns the transformed string.\"\"\"\n        validate_is_str(text, 'text')\n        return self._replacer.replace(text)\n\n\n_default_replacer = CharReplacer()\n_default_service = ReplaceService(_default_replacer)\n\n\ndef replace_specialchar(s: str) -> str:\n    \"\"\"Replaces all occurrences of spaces, commas, or dots with a colon.\"\"\"\n    return _default_service.replace(s)"}
{"task_id": "Mbpp/730", "solution": "from typing import Any, List\n\n\ndef consecutive_duplicates(input_list: List[Any]) -> List[Any]:\n    \"\"\"Removes consecutive duplicate elements from a list, preserving order.\"\"\"\n    if not input_list:\n        return []\n\n    result = []\n    for item in input_list:\n        if not result or item != result[-1]:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(nums):\n    \"\"\"\n    Calculates the sum of products of all contiguous subarrays of a given list.\n    \"\"\"\n    total = 0\n    n = len(nums)\n    for i in range(n):\n        prod = 1\n        for j in range(i, n):\n            prod *= nums[j]\n            total += prod\n    return total"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(sorted_array, target):\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array using binary search.\n    Returns the index if found, otherwise None.\n    \"\"\"\n    low, high = 0, len(sorted_array) - 1\n    result = None\n\n    while low <= high:\n        mid = (low + high) // 2\n        if sorted_array[mid] == target:\n            result = mid\n            high = mid - 1  # Move left to find the first occurrence\n        elif sorted_array[mid] < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n            \n    return result"}
{"task_id": "Mbpp/735", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input to bit operations.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass NumberModel:\n    \"\"\"Encapsulates an integer and provides derived bit-geometry properties.\"\"\"\n    def __init__(self, number: int) -> None:\n        self._value = number\n\n    def as_int(self) -> int:\n        return self._value\n\n    def bit_length(self) -> int:\n        # Python's 0.bit_length() is 0. For MSB/LSB decisions, we treat 0 as length 1.\n        bl = self._value.bit_length()\n        return bl if bl > 0 else 1\n\n    def msb_index(self) -> int:\n        return self.bit_length() - 1\n\n    def has_middle_bits(self) -> bool:\n        return self.bit_length() > 2\n\nclass BitUtils:\n    \"\"\"Provides pure bitwise helper functions.\"\"\"\n    @staticmethod\n    def highest_bit_index(value: int) -> int:\n        if value == 0:\n            return 0\n        return value.bit_length() - 1\n\n    @staticmethod\n    def mask_middle_bits_from_length(length: int) -> int:\n        # Returns a mask with ones for middle bits (positions 1 to length-2).\n        if length <= 2:\n            return 0\n        # ((1 << (length - 2)) - 1) creates a sequence of (length-2) ones.\n        # Shifting left by 1 positions these ones starting from bit 1.\n        return ((1 << (length - 2)) - 1) << 1\n\n    @staticmethod\n    def toggle_bits(value: int, mask: int) -> int:\n        return value ^ mask\n\ndef toggle_middle_bits(number: int) -> int:\n    \"\"\"Toggles bits of the number except the most-significant (first) and least-significant (last) bit.\"\"\"\n    if not isinstance(number, int) or number < 0:\n        raise InvalidInputError(\"number must be a non-negative int\")\n\n    model = NumberModel(number)\n\n    if not model.has_middle_bits():\n        return number\n\n    length = model.bit_length()\n    mask = BitUtils.mask_middle_bits_from_length(length)\n    return BitUtils.toggle_bits(number, mask)"}
{"task_id": "Mbpp/736", "solution": "from typing import List, TypeVar\n\nT = TypeVar(\"T\")\n\ndef left_insertion(lst: List[T], value: T) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted list using binary search.\n    \"\"\"\n    low = 0\n    high = len(lst)\n    while low < high:\n        mid = (low + high) // 2\n        if lst[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/737", "solution": "import re\nimport unicodedata\n\nclass InvalidInputError(ValueError):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass InputSanitizer:\n    DEFAULT_STRIP = True\n\n    def validate_type(self, s) -> None:\n        if not isinstance(s, str):\n            raise InvalidInputError(\"Input must be a string\")\n\n    def sanitize(self, s: str) -> str:\n        self.validate_type(s)\n        s2 = s\n        if self.DEFAULT_STRIP:\n            s2 = s2.strip()\n        return unicodedata.normalize(\"NFC\", s2)\n\nclass RegexAdapter:\n    DEFAULT_FLAGS = 0\n\n    def compile(self, pattern: str, flags: int = 0):\n        return re.compile(pattern, flags)\n\n    def matches(self, pattern: str, s: str) -> bool:\n        return re.match(pattern, s) is not None\n\nclass VowelService:\n    VOWEL_PATTERN = r'^[aeiouAEIOU]'\n\n    def __init__(self, regex_adapter: RegexAdapter, sanitizer: InputSanitizer) -> None:\n        self.regex_adapter = regex_adapter\n        self.sanitizer = sanitizer\n\n    def is_starting_with_vowel(self, s: str) -> bool:\n        self.sanitizer.validate_type(s)\n        cleaned = self.sanitizer.sanitize(s)\n        return self.regex_adapter.matches(self.VOWEL_PATTERN, cleaned)\n\nclass ResultDTO:\n    def __init__(self, starts_with_vowel: bool) -> None:\n        self.starts_with_vowel: bool = starts_with_vowel\n\nclass VowelController:\n    def __init__(self, service: VowelService) -> None:\n        self.service = service\n\n    def check(self, s: str) -> ResultDTO:\n        ok = self.service.is_starting_with_vowel(s)\n        return ResultDTO(ok)\n\n_adapter = RegexAdapter()\n_sanitizer = InputSanitizer()\n_service = VowelService(regex_adapter=_adapter, sanitizer=_sanitizer)\n_controller = VowelController(service=_service)\n\ndef check_str(s: str) -> bool:\n    \"\"\"\n    Checks if the given string is starting with a vowel using regex.\n    Raises InvalidInputError if the input is not a string.\n    \"\"\"\n    return _controller.check(s).starts_with_vowel"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(s, ignore_case=False, ignore_whitespace=False):\n    \"\"\"Checks if all characters in a string are the same, with optional case and whitespace normalization.\"\"\"\n    \n    normalized_s = s\n    if ignore_whitespace:\n        normalized_s = \"\".join(normalized_s.split())\n    if ignore_case:\n        normalized_s = normalized_s.lower()\n\n    if len(normalized_s) <= 1:\n        return True\n    \n    return all(c == normalized_s[0] for c in normalized_s[1:])"}
{"task_id": "Mbpp/739", "solution": "import math\n\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    Uses integer arithmetic based on the quadratic formula for T_k >= 10^(n-1).\n    \"\"\"\n    def _pow10(exp: int) -> int:\n        \"\"\"Calculates 10 raised to the power of exp.\"\"\"\n        return 10 ** exp\n\n    def _isqrt_ceil(value: int) -> int:\n        \"\"\"Calculates the ceiling of the square root of a non-negative integer.\"\"\"\n        floor_sqrt = math.isqrt(value)\n        return floor_sqrt if floor_sqrt * floor_sqrt == value else floor_sqrt + 1\n\n    # The smallest n-digit number is 10^(n-1). We need T_k >= 10^(n-1).\n    # This leads to k*(k+1)/2 >= 10^(n-1), or k^2 + k - 2*10^(n-1) >= 0.\n    # Using the quadratic formula, k = (-1 + sqrt(1 + 8*10^(n-1))) / 2.\n    # We need the smallest integer k, so we take the ceiling.\n\n    # Calculate 10^(n-1)\n    lower_bound_power_of_10 = _pow10(n - 1)\n\n    # Calculate the discriminant: 1 + 8 * 10^(n-1)\n    discriminant = 1 + 8 * lower_bound_power_of_10\n\n    # Calculate the ceiling of the square root of the discriminant\n    s = _isqrt_ceil(discriminant)\n\n    # The formula for k simplifies to s // 2, applying the ceiling logic for the whole expression\n    k = s // 2\n\n    # Ensure k is at least 1, as per requirements (e.g., for n=1, k=1)\n    return max(1, k)"}
{"task_id": "Mbpp/742", "solution": "import math\n\nclass ValidationError(ValueError):\n    def __init__(self, msg: str) -> None:\n        super().__init__(msg)\n\ndef _validate_side(side: float) -> None:\n    \"\"\"Validates the input side length.\"\"\"\n    try:\n        s = float(side)\n    except (TypeError, ValueError):\n        raise ValidationError(f\"side must be numeric, got {type(side).__name__}\")\n\n    if math.isnan(s) or math.isinf(s):\n        raise ValidationError(\"side must be finite\")\n    if s < 0:\n        raise ValidationError(\"side must be >= 0\")\n\ndef area_tetrahedron(side: float) -> float:\n    \"\"\"\n    Calculates the total surface area of a regular tetrahedron given its edge length.\n    \"\"\"\n    _validate_side(side)\n    # Surface area of a regular tetrahedron = sqrt(3) * a^2\n    return math.sqrt(3.0) * (side ** 2)"}
{"task_id": "Mbpp/743", "solution": "from typing import Sequence, List, Any\n\ndef rotate_right(lst: Sequence[Any], k: int) -> List[Any]:\n    \"\"\"\n    Rotates a list to the right by k positions, returning a new list.\n    Handles positive, negative, and zero k, as well as empty lists efficiently.\n    \"\"\"\n    n = len(lst)\n    if n == 0:\n        return []\n\n    # Normalize k to be within [0, n-1] to represent the effective right rotation.\n    # Python's modulo operator handles negative k values correctly for this.\n    k_norm = k % n\n\n    # If k_norm is 0, no actual rotation is needed, so return a copy of the original list.\n    if k_norm == 0:\n        return list(lst)\n\n    # Perform the rotation by splitting the list into two parts and concatenating them.\n    # The last k_norm elements become the new prefix, followed by the remaining elements.\n    return list(lst[-k_norm:] + lst[:-k_norm])"}
{"task_id": "Mbpp/744", "solution": "import collections.abc\n\ndef check_none(values: collections.abc.Sequence) -> bool:\n    \"\"\"\n    Checks if any element in the given sequence is None.\n    \"\"\"\n    for item in values:\n        if item is None:\n            return True\n    return False"}
{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum, endnum):\n    \"\"\"\n    Finds numbers within a given range that are divisible by every digit they contain.\n    Numbers containing the digit 0 are excluded.\n    \"\"\"\n    results = []\n    for num in range(startnum, endnum + 1):\n        s_num = str(num)\n        is_divisible_by_all_digits = True\n        for char_digit in s_num:\n            digit = int(char_digit)\n            if digit == 0 or num % digit != 0:\n                is_divisible_by_all_digits = False\n                break\n        if is_divisible_by_all_digits:\n            results.append(num)\n    return results"}
{"task_id": "Mbpp/740", "solution": "import json\nfrom typing import Tuple, Dict, Any, Iterator, Optional\nimport datetime\n\nclass InvalidTupleTypeError(Exception):\n    \"\"\"Raised when input is not a tuple.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass InvalidTupleLengthError(Exception):\n    \"\"\"Raised when tuple length is odd.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass InvalidElementTypeError(Exception):\n    \"\"\"Raised when a key element is not hashable.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass RepositoryError(Exception):\n    \"\"\"Raised on IO/persistence issues.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\ndef is_hashable(obj: Any) -> bool:\n    \"\"\"Checks if an object is hashable.\"\"\"\n    try:\n        hash(obj)\n        return True\n    except TypeError:\n        return False\n\ndef chunk_tuple_to_pairs(t: Tuple[Any, ...]) -> Iterator[Tuple[Any, Any]]:\n    \"\"\"Yields (key, value) pairs from an input tuple.\"\"\"\n    for i in range(0, len(t), 2):\n        yield (t[i], t[i+1])\n\nclass TupleValidator:\n    \"\"\"Validates input tuples for conversion.\"\"\"\n    MIN_LENGTH = 0\n\n    def validate(self, t: Tuple[Any, ...]) -> None:\n        \"\"\"Validates the tuple type, length, and key hashability.\"\"\"\n        if not isinstance(t, tuple):\n            raise InvalidTupleTypeError(\"Input must be a tuple\")\n        self._validate_length(len(t))\n        for i in range(0, len(t), 2):\n            key = t[i]\n            if not is_hashable(key):\n                raise InvalidElementTypeError(f\"Key at index {i} is not hashable: {key}\")\n\n    def _validate_length(self, length: int) -> None:\n        \"\"\"Ensures the tuple length is even.\"\"\"\n        if length % 2 != 0:\n            raise InvalidTupleLengthError(\"Tuple length must be even (pairs of key/value)\")\n\nclass InMemoryRepository:\n    \"\"\"Stores the last mapping in memory with optional JSON file persistence.\"\"\"\n    DEFAULT_PERSIST_FILENAME = \"tuple_to_dict_last.json\"\n\n    def __init__(self, persist_file: Optional[str] = None) -> None:\n        \"\"\"Initializes the repository, loading from file if specified.\"\"\"\n        self._persist_file = persist_file\n        self._last_mapping: Optional[Dict[Any, Any]] = None\n        if self._persist_file:\n            try:\n                with open(self._persist_file, 'r') as f:\n                    data = json.load(f)\n                    self._last_mapping = data.get(\"last_mapping\")\n            except (FileNotFoundError, json.JSONDecodeError):\n                self._last_mapping = None # File not found or corrupt, start fresh\n            except Exception as e:\n                raise RepositoryError(f\"Failed to load repository from {self._persist_file}: {e}\")\n\n    def save(self, mapping: Dict[Any, Any]) -> None:\n        \"\"\"Saves the mapping to memory and optionally to a file.\"\"\"\n        self._last_mapping = mapping\n        if self._persist_file:\n            self._persist_to_file(mapping)\n\n    def get_last(self) -> Optional[Dict[Any, Any]]:\n        \"\"\"Retrieves the last saved mapping.\"\"\"\n        return self._last_mapping\n\n    def _persist_to_file(self, mapping: Dict[Any, Any]) -> None:\n        \"\"\"Writes the mapping to the configured JSON file.\"\"\"\n        try:\n            data = {\n                \"last_mapping\": mapping,\n                \"timestamp\": datetime.datetime.now(datetime.timezone.utc).isoformat()\n            }\n            with open(self._persist_file, 'w') as f:\n                json.dump(data, f, indent=2)\n        except TypeError as e:\n            raise RepositoryError(f\"Mapping contains non-JSON-serializable data for persistence: {e}\")\n        except Exception as e:\n            raise RepositoryError(f\"Failed to persist mapping to {self._persist_file}: {e}\")\n\nclass TupleToDictService:\n    \"\"\"Converts a tuple to a dictionary, handling validation and persistence.\"\"\"\n    def __init__(self, validator: TupleValidator, repository: Optional[InMemoryRepository] = None) -> None:\n        \"\"\"Initializes the service with a validator and an optional repository.\"\"\"\n        self._validator = validator\n        self._repository = repository\n\n    def convert(self, t: Tuple[Any, ...]) -> Dict[Any, Any]:\n        \"\"\"Validates, converts, and optionally saves the tuple to a dictionary.\"\"\"\n        self._validator.validate(t)\n        pairs: Iterator[Tuple[Any, Any]] = chunk_tuple_to_pairs(t)\n        mapping = self._build_dict(pairs)\n        if self._repository:\n            self._repository.save(mapping)\n        return mapping\n\n    def _build_dict(self, pairs: Iterator[Tuple[Any, Any]]) -> Dict[Any, Any]:\n        \"\"\"Constructs a dictionary from an iterator of key-value pairs.\"\"\"\n        result: Dict[Any, Any] = {}\n        for k, v in pairs:\n            result[k] = v  # later values overwrite earlier ones\n        return result\n\nclass LibraryAPI:\n    \"\"\"Provides the public API for tuple to dict conversion.\"\"\"\n    def __init__(self, service: TupleToDictService) -> None:\n        \"\"\"Initializes the API with the conversion service.\"\"\"\n        self._service = service\n\n    def tuple_to_dict(self, t: Tuple[Any, ...]) -> Dict[Any, Any]:\n        \"\"\"Converts a tuple to a dictionary using the underlying service.\"\"\"\n        return self._service.convert(t)\n\n_default_service = TupleToDictService(validator=TupleValidator(), repository=InMemoryRepository())\n_default_api = LibraryAPI(_default_service)\n\ndef tuple_to_dict(t: Tuple[Any, ...]) -> Dict[Any, Any]:\n    \"\"\"Converts a tuple of adjacent key-value pairs into a dictionary.\n\n    Validates the tuple for proper type, even length, and hashable keys.\n    \"\"\"\n    return _default_api.tuple_to_dict(t)"}
{"task_id": "Mbpp/748", "solution": "import re\n\ndef capital_words_spaces(text: str) -> str:\n    \"\"\"\n    Inserts spaces between words starting with capital letters, preserving acronyms.\n    Applies two regex substitutions to achieve the desired spacing.\n    \"\"\"\n    # Pattern 1: Insert a space before an uppercase letter followed by lowercase (e.g., \"Hello World\")\n    s = re.sub(r'(.)([A-Z][a-z]+)', r'\\1 \\2', text)\n    # Pattern 2: Insert a space between a lowercase/digit and an uppercase letter (e.g., \"HTTP Server\", \"XML Parser2\")\n    s = re.sub(r'([a-z0-9])([A-Z])', r'\\1 \\2', s)\n    return s"}
{"task_id": "Mbpp/750", "solution": "from typing import List, Tuple, Any\n\ndef add_tuple(lst: List[Any], tpl: Tuple[Any, ...]) -> List[Any]:\n    \"\"\"Adds all elements from a tuple to a new list, returning the combined list.\"\"\"\n    new_list = lst.copy()\n    new_list.extend(tpl)\n    return new_list"}
{"task_id": "Mbpp/751", "solution": "from typing import List, Any, Callable, Optional\n\nclass HeapError(ValueError):\n    \"\"\"Custom exception for heap-related errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass HeapArray:\n    \"\"\"A wrapper for a list to represent a heap, providing safe access and validation.\"\"\"\n    def __init__(self, items: List[Any]) -> None:\n        if items is None:\n            raise HeapError(\"Input array must not be None\")\n        self._items: List[Any] = list(items)\n\n    def __len__(self) -> int:\n        return len(self._items)\n\n    def get(self, index: int) -> Any:\n        return self._items[index]\n\n    def as_list(self) -> List[Any]:\n        return list(self._items)\n\n    def validate_items_comparable(self) -> None:\n        \"\"\"Checks if items in the array are comparable.\"\"\"\n        if len(self._items) == 0:\n            return\n        try:\n            _ = self._items[0] <= self._items[0] # Sanity check for comparability\n        except Exception as exc:\n            raise HeapError(\"Items in the array are not comparable\") from exc\n\ndef left_child(i: int) -> int:\n    \"\"\"Calculates the index of the left child for a given parent index i.\"\"\"\n    return 2 * i + 1\n\ndef right_child(i: int) -> int:\n    \"\"\"Calculates the index of the right child for a given parent index i.\"\"\"\n    return 2 * i + 2\n\ndef safe_leq(a: Any, b: Any, comparator: Optional[Callable[[Any, Any], bool]] = None) -> bool:\n    \"\"\"Compares two items a and b using a custom comparator or Python's <= operator.\"\"\"\n    if comparator is not None:\n        return comparator(a, b)\n    try:\n        return a <= b\n    except Exception as exc:\n        raise HeapError(\"Comparison failed between items\") from exc\n\nclass HeapValidatorService:\n    \"\"\"Provides the core algorithm to check if an array represents a min-heap.\"\"\"\n    def __init__(self, comparator: Optional[Callable[[Any,Any], bool]] = None) -> None:\n        self._comparator = comparator\n\n    def is_min_heap(self, arr: List[Any]) -> bool:\n        \"\"\"Checks if the given array represents a min-heap.\"\"\"\n        if arr is None:\n            raise HeapError(\"Input array is None\")\n\n        heap = HeapArray(arr)\n        heap.validate_items_comparable()\n        n = len(heap)\n\n        # An empty or single-element array is always a min-heap.\n        if n <= 1:\n            return True\n\n        # Iterate only through potential parent nodes.\n        # A node at index `i` has children at `2*i+1` and `2*i+2`.\n        # The last non-leaf node is at index `n // 2 - 1`.\n        for i in range(n // 2):\n            parent_val = heap.get(i)\n\n            # Check left child\n            l_child_idx = left_child(i)\n            if l_child_idx < n:  # If left child exists\n                l_child_val = heap.get(l_child_idx)\n                if not safe_leq(parent_val, l_child_val, self._comparator):\n                    return False\n\n            # Check right child\n            r_child_idx = right_child(i)\n            if r_child_idx < n:  # If right child exists\n                r_child_val = heap.get(r_child_idx)\n                if not safe_leq(parent_val, r_child_val, self._comparator):\n                    return False\n        return True\n\ndef check_min_heap(arr: List[Any]) -> bool:\n    \"\"\"Checks if the given array represents a min-heap.\"\"\"\n    return HeapValidatorService().is_min_heap(arr)"}
{"task_id": "Mbpp/749", "solution": "from typing import List, Optional\n\nclass ValidationError(Exception):\n    def __init__(self, message: str, index: Optional[int] = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.index = index\n\nclass ParseError(Exception):\n    def __init__(self, message: str, index: int, value: str) -> None:\n        super().__init__(message)\n        self.index = index\n        self.value = value\n        self.message = message\n\nclass SortError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\ndef to_int_safe(s: str) -> int:\n    \"\"\"Strips whitespace from a string and converts it to an integer.\"\"\"\n    return int(s.strip())\n\nclass InputValidator:\n    def __init__(self, allowed_empty_list: bool = False) -> None:\n        self.allowed_empty_list = allowed_empty_list\n\n    def validate(self, items: List[str]) -> None:\n        \"\"\"Validates the input list and its elements.\"\"\"\n        if not isinstance(items, list):\n            raise ValidationError(\"Input must be a list of strings\")\n        if len(items) == 0 and not self.allowed_empty_list:\n            raise ValidationError(\"Input list must not be empty\")\n        for i, v in enumerate(items):\n            self._validate_element(i, v)\n\n    def _validate_element(self, index: int, value: str) -> None:\n        \"\"\"Validates a single element in the input list.\"\"\"\n        if not isinstance(value, str):\n            raise ValidationError(\"Element must be a string\", index)\n        if value.strip() == \"\":\n            raise ValidationError(\"Element must not be empty\", index)\n\nclass NumericStringParser:\n    def parse(self, items: List[str]) -> List[int]:\n        \"\"\"Parses a list of numeric strings into a list of integers.\"\"\"\n        result = []\n        for i, s in enumerate(items):\n            try:\n                n = to_int_safe(s)\n            except ValueError:\n                raise ParseError(f\"Invalid integer at index {i}\", i, s)\n            result.append(n)\n        return result\n\nclass SortService:\n    def sort(self, values: List[int]) -> List[int]:\n        \"\"\"Sorts a list of integers in ascending order.\"\"\"\n        return sorted(values)\n\nclass SortController:\n    def __init__(self, validator: InputValidator, parser: NumericStringParser, service: SortService) -> None:\n        self.validator = validator\n        self.parser = parser\n        self.service = service\n\n    def sort_numeric_strings(self, items: List[str]) -> List[int]:\n        \"\"\"Orchestrates validation, parsing, and sorting of numeric strings.\"\"\"\n        self.validator.validate(items)\n        ints = self.parser.parse(items)\n        return self.service.sort(ints)\n\ndef sort_numeric_strings(items: List[str]) -> List[int]:\n    \"\"\"Sorts a list of numeric strings numerically, returning a list of integers.\"\"\"\n    controller = SortController(InputValidator(), NumericStringParser(), SortService())\n    return controller.sort_numeric_strings(items)"}
{"task_id": "Mbpp/753", "solution": "import heapq\nfrom typing import List, Tuple, Union, Iterable\n\nclass MinKError(Exception):\n    \"\"\"Base exception for min_k_records module.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\n\nclass ValidationError(MinKError):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass Validator:\n    \"\"\"Utility class for input validation.\"\"\"\n\n    @staticmethod\n    def validate_k(k: int) -> int:\n        \"\"\"Ensures k is a non-negative integer.\"\"\"\n        if not isinstance(k, int) or k < 0:\n            raise ValidationError(f\"k must be a non-negative integer, got {k!r}\")\n        return k\n\n    @staticmethod\n    def validate_records(records: Iterable, raise_on_error: bool=True) -> List[Tuple[str, Union[int,float]]]:\n        \"\"\"\n        Validates and normalizes an iterable of records into a list of (name, value) tuples.\n        Supports list/tuple pairs or dicts with 'name' and 'value' keys.\n        \"\"\"\n        out = []\n        try:\n            for i, item in enumerate(records):\n                if isinstance(item, (list, tuple)) and len(item) >= 2:\n                    name = item[0]\n                    value = item[1]\n                elif isinstance(item, dict):\n                    name = item.get(\"name\")\n                    value = item.get(\"value\")\n                else:\n                    raise ValidationError(f\"Invalid record at index {i}: {item!r}\")\n                \n                if not isinstance(name, str):\n                    raise ValidationError(f\"name must be str at index {i}, got {type(name)}\")\n                if not isinstance(value, (int, float)):\n                    raise ValidationError(f\"value must be numeric at index {i}, got {type(value)}\")\n                \n                out.append((name, value))\n        except Exception: \n            if raise_on_error:\n                raise\n        return out\n\ndef _compare_key(item: Tuple[str, Union[int,float]]) -> Tuple[Union[int,float], str]:\n    \"\"\"\n    Key function for sorting, prioritizing value then name for tie-breaking.\n    Used by sorted() and heapq.nsmallest().\n    \"\"\"\n    name, value = item[0], item[1]\n    return (value, name)\n\ndef min_k(records: List[Tuple[str, Union[int,float]]], k: int) -> List[Tuple[str, Union[int,float]]]:\n    \"\"\"\n    Finds the minimum k records from a list of (name, value) tuples.\n    Records are sorted by value ascending, then by name ascending for ties.\n    Raises ValidationError for invalid inputs.\n    \"\"\"\n    k = Validator.validate_k(k)\n    recs = Validator.validate_records(records)\n\n    if k == 0:\n        return []\n\n    n = len(recs)\n    if k >= n:\n        return sorted(recs, key=_compare_key)\n\n    # Use heapq.nsmallest for efficiency when k is much smaller than n.\n    return heapq.nsmallest(k, recs, key=_compare_key)"}
{"task_id": "Mbpp/754", "solution": "from typing import List, Any\n\ndef extract_index_list(l1: List[Any], l2: List[Any], l3: List[Any]) -> List[Any]:\n    \"\"\"\n    Finds elements that are common across three lists at the same index.\n    The function returns a list of these common elements in order.\n    \"\"\"\n    common_elements = []\n    min_length = min(len(l1), len(l2), len(l3))\n\n    for i in range(min_length):\n        if l1[i] == l2[i] == l3[i]:\n            common_elements.append(l1[i])\n\n    return common_elements"}
{"task_id": "Mbpp/752", "solution": "import os\nimport json\nimport tempfile\nimport shutil\nfrom typing import Optional, Protocol, Dict\n\nclass InvalidInputError(Exception):\n    pass\n\nclass ComputationError(Exception):\n    pass\n\ndef validate_index(n: int) -> None:\n    \"\"\"Validates if n is a non-negative integer.\"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n\ndef atomic_write_json(path: str, obj: Dict) -> None:\n    \"\"\"Atomically writes a dictionary to a JSON file.\"\"\"\n    temp_dir = os.path.dirname(path)\n    os.makedirs(temp_dir, exist_ok=True)\n    with tempfile.NamedTemporaryFile(mode='w', delete=False, dir=temp_dir) as tf:\n        json.dump(obj, tf, indent=2)\n        tf.flush()\n        os.fsync(tf.fileno())\n    shutil.move(tf.name, path)\n\nclass CacheAdapter(Protocol):\n    def get(self, n: int) -> Optional[int]: ...\n    def set(self, n: int, value: int) -> None: ...\n\nclass InMemoryCache:\n    \"\"\"In-memory cache for Jacobsthal numbers.\"\"\"\n    def __init__(self):\n        self._store: Dict[int, int] = {}\n\n    def get(self, n: int) -> Optional[int]:\n        return self._store.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        self._store[n] = value\n\nclass FileRepository:\n    \"\"\"Persistent JSON-backed repository for Jacobsthal numbers.\"\"\"\n    DEFAULT_CACHE_PATH = \"~/.cache/jacobsthal/cache.json\"\n\n    def __init__(self, path: Optional[str] = None):\n        self._path = os.path.expanduser(path or self.DEFAULT_CACHE_PATH)\n        self._data: Dict[int, int] = {}\n        self.load()\n\n    def load(self) -> None:\n        if not os.path.exists(self._path):\n            self._data = {}\n            return\n        try:\n            with open(self._path, 'r') as f:\n                raw_data = json.load(f)\n                self._data = {int(k): v for k, v in raw_data.items()}\n        except (json.JSONDecodeError, IOError):\n            self._data = {}\n\n    def get(self, n: int) -> Optional[int]:\n        return self._data.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        self._data[n] = value\n        self._save_atomic()\n\n    def _save_atomic(self) -> None:\n        os.makedirs(os.path.dirname(self._path), exist_ok=True)\n        serializable_data = {str(k): v for k, v in self._data.items()}\n        try:\n            atomic_write_json(self._path, serializable_data)\n        except IOError:\n            pass # Log warning and continue without persistence\n\nclass MathEngine:\n    \"\"\"Provides mathematical algorithms for Jacobsthal numbers.\"\"\"\n    _CLOSED_FORM_DENOMINATOR: int = 3\n\n    def closed_form(self, n: int) -> int:\n        \"\"\"Computes J(n) using the exact integer closed form.\"\"\"\n        numerator = (1 << n) - ((-1) ** n)\n        return numerator // self._CLOSED_FORM_DENOMINATOR\n\n    def iterative(self, n: int) -> int:\n        \"\"\"Iteratively computes J(n) with O(n) time and O(1) memory.\"\"\"\n        if n == 0:\n            return 0\n        if n == 1:\n            return 1\n        j_n_minus_2 = 0\n        j_n_minus_1 = 1\n        current_j = 0\n        for _ in range(2, n + 1):\n            current_j = j_n_minus_1 + 2 * j_n_minus_2\n            j_n_minus_2 = j_n_minus_1\n            j_n_minus_1 = current_j\n        return current_j\n\n    def recursive_memo(self, n: int, memo: Optional[Dict[int, int]] = None) -> int:\n        \"\"\"Computes J(n) recursively with memoization.\"\"\"\n        if memo is None:\n            memo = {}\n        if n in memo:\n            return memo[n]\n        if n == 0:\n            return 0\n        if n == 1:\n            return 1\n        result = self.recursive_memo(n - 1, memo) + 2 * self.recursive_memo(n - 2, memo)\n        memo[n] = result\n        return result\n\nclass JacobsthalService:\n    \"\"\"Manages computation, caching, and persistence of Jacobsthal numbers.\"\"\"\n    def __init__(self, repo: Optional[FileRepository] = None, cache: Optional[InMemoryCache] = None, engine: Optional[MathEngine] = None):\n        self._repo = repo\n        self._cache = cache if cache is not None else InMemoryCache()\n        self._engine = engine if engine is not None else MathEngine()\n\n    def get(self, n: int, method: str = 'auto', persist: bool = True) -> int:\n        \"\"\"Retrieves or computes the nth Jacobsthal number.\"\"\"\n        validate_index(n)\n        cached = self._cache.get(n)\n        if cached is not None:\n            return cached\n        if self._repo:\n            repo_val = self._repo.get(n)\n            if repo_val is not None:\n                self._cache.set(n, repo_val)\n                return repo_val\n        chosen = self._choose_method(n, method)\n        val: int\n        if chosen == 'closed_form':\n            val = self._engine.closed_form(n)\n        elif chosen == 'iterative':\n            val = self._engine.iterative(n)\n        elif chosen == 'recursive':\n            val = self._engine.recursive_memo(n)\n        else:\n            raise ComputationError(f\"Unknown computation method: {method}\")\n        self._cache.set(n, val)\n        if persist and self._repo:\n            try:\n                self._repo.set(n, val)\n            except Exception:\n                pass # Log warning and continue without persistence\n        return val\n\n    def _choose_method(self, n: int, method: str) -> str:\n        \"\"\"Selects the appropriate computation method.\"\"\"\n        if method != 'auto':\n            if method not in {'closed_form', 'iterative', 'recursive'}:\n                raise InvalidInputError(f\"Invalid method '{method}'. Choose from 'auto', 'closed_form', 'iterative', 'recursive'.\")\n            return method\n        if n <= 2048: # Heuristic for closed-form safety/efficiency\n            return 'closed_form'\n        return 'iterative'\n\n_jacobsthal_service_instance: Optional[JacobsthalService] = None\n\ndef jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Finds the nth Jacobsthal number.\n    Delegates computation and caching to a shared service instance.\n    \"\"\"\n    global _jacobsthal_service_instance\n    if _jacobsthal_service_instance is None:\n        _jacobsthal_service_instance = JacobsthalService(\n            repo=FileRepository(),\n            cache=InMemoryCache(),\n            engine=MathEngine()\n        )\n    return _jacobsthal_service_instance.get(n)"}
{"task_id": "Mbpp/755", "solution": "import math\nfrom typing import List\n\ndef second_smallest(numbers: List[float]) -> float:\n    \"\"\"\n    Finds the second smallest number in a list of numbers.\n    Assumes the list contains at least two elements and handles duplicates naturally.\n    \"\"\"\n    min1 = float('inf')\n    min2 = float('inf')\n\n    for v in numbers:\n        if v < min1:\n            min2 = min1\n            min1 = v\n        elif v < min2:\n            min2 = v\n            \n    return min2"}
{"task_id": "Mbpp/757", "solution": "from typing import List\n\ndef count_reverse_pairs(strings: List[str]) -> int:\n    \"\"\"\n    Counts pairs of reverse strings in the given list.\n    Each distinct pair (s, reverse(s)) is counted once, considering multiplicity.\n    \"\"\"\n    freq = {}\n    for s in strings:\n        # Normalize string by stripping whitespace\n        normalized_s = s.strip()\n        freq[normalized_s] = freq.get(normalized_s, 0) + 1\n\n    pairs = 0\n    # Iterate over items to safely modify or remove from freq if needed (though not strictly necessary with `s < r` check)\n    for s, count in list(freq.items()):\n        # Reverse the string\n        r = s[::-1]\n\n        if s == r:\n            # Palindrome: count pairs within this string's occurrences\n            pairs += count // 2\n        elif s < r and r in freq:\n            # Non-palindrome reverse pair: ensure unique pair counting using lexicographical order\n            # and count based on the minimum available occurrences\n            pairs += min(count, freq[r])\n    return pairs"}
{"task_id": "Mbpp/758", "solution": "from typing import List, Any, Dict, Tuple\n\ndef unique_sublists(lists: List[List[Any]]) -> Dict[Tuple[Any, ...], int]:\n    \"\"\"\n    Counts occurrences of sublists in a list, converting each sublist to a tuple (recursively for nested structures)\n    to enable hashing and then stores the counts in a dictionary.\n    \"\"\"\n\n    def _convert_to_tuple_recursive(item: Any) -> Any:\n        \"\"\"Recursively converts lists and tuples into tuples.\"\"\"\n        if isinstance(item, (list, tuple)):\n            return tuple(_convert_to_tuple_recursive(element) for element in item)\n        return item\n\n    counts: Dict[Tuple[Any, ...], int] = {}\n    for sublist in lists:\n        key = _convert_to_tuple_recursive(sublist)\n        counts[key] = counts.get(key, 0) + 1\n    return counts"}
{"task_id": "Mbpp/760", "solution": "from typing import Any, Set\n\ndef unique_Element(list_of_numbers: list) -> bool:\n    \"\"\"\n    Checks if a list contains only one distinct element.\n    An empty list is considered not to have one distinct element.\n    \"\"\"\n    seen: Set[Any] = set()\n    element_count = 0\n\n    for item in list_of_numbers:\n        seen.add(item)\n        element_count += 1\n        if len(seen) > 1:\n            return False\n\n    return element_count > 0 and len(seen) == 1"}
{"task_id": "Mbpp/759", "solution": "import re\nfrom datetime import datetime\nfrom typing import Optional, Any, List\n\nclass ValidationError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass ValidationResult:\n    def __init__(self, is_valid: bool, normalized: Optional[str], precision: int, timestamp: datetime, error_message: Optional[str]) -> None:\n        self.is_valid = is_valid\n        self.normalized = normalized\n        self.precision = precision\n        self.timestamp = timestamp\n        self.error_message = error_message\n\n    def to_dict(self) -> dict:\n        return {\n            \"is_valid\": self.is_valid,\n            \"normalized\": self.normalized,\n            \"precision\": self.precision,\n            \"timestamp\": self.timestamp.isoformat(),\n            \"error_message\": self.error_message,\n        }\n\nclass StringSanitizer:\n    def __init__(self) -> None:\n        pass\n\n    def sanitize(self, value: str) -> str:\n        s = value.strip()\n        return s\n\nclass RegexValidatorAdapter:\n    def __init__(self) -> None:\n        pass\n\n    def validate_decimal(self, value: str, precision: int) -> bool:\n        if not isinstance(precision, int) or precision <= 0:\n            raise ValidationError(\"precision must be a positive integer\")\n        pattern = rf'^[+-]?\\d+\\.\\d{{{precision}}}$'\n        return re.fullmatch(pattern, value) is not None\n\nclass DecimalRepository:\n    def __init__(self) -> None:\n        self._store: List[ValidationResult] = []\n\n    def save(self, result: ValidationResult) -> None:\n        self._store.append(result)\n\n    def list_all(self) -> List[ValidationResult]:\n        return list(self._store)\n\n    def clear(self) -> None:\n        self._store.clear()\n\ndef ensure_str(value: Any) -> str:\n    \"\"\"Ensures a value is a string, raising ValidationError if None.\"\"\"\n    if value is None:\n        raise ValidationError(\"Input value cannot be None.\")\n    if not isinstance(value, str):\n        return str(value)\n    return value\n\nclass DecimalValidatorService:\n    def __init__(self, sanitizer: StringSanitizer, adapter: RegexValidatorAdapter, repo: DecimalRepository) -> None:\n        self._sanitizer = sanitizer\n        self._adapter = adapter\n        self._repo = repo\n\n    def validate(self, value: str, precision: int = 2) -> ValidationResult:\n        raw = ensure_str(value)\n        try:\n            sanitized = self._sanitizer.sanitize(raw)\n            ok = self._adapter.validate_decimal(sanitized, precision)\n            result = ValidationResult(is_valid=ok, normalized=sanitized if ok else None, precision=precision, timestamp=datetime.utcnow(), error_message=None)\n        except Exception as e:\n            error_msg = str(e)\n            result = ValidationResult(is_valid=False, normalized=None, precision=precision, timestamp=datetime.utcnow(), error_message=error_msg)\n        self._repo.save(result)\n        return result\n\ndef is_decimal(value: str, precision: int = 2) -> bool:\n    \"\"\"Checks if a string is a decimal number with the specified precision.\"\"\"\n    service = DecimalValidatorService(StringSanitizer(), RegexValidatorAdapter(), DecimalRepository())\n    return service.validate(value, precision).is_valid"}
