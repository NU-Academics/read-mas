{"task_id": "Mbpp/80", "solution": "import abc\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input.\"\"\"\n    pass\n\nclass Utils:\n    \"\"\"Utility methods for validation.\"\"\"\n    @staticmethod\n    def validate_n(n: int) -> None:\n        \"\"\"Validates that n is a non-negative integer.\"\"\"\n        if not isinstance(n, int):\n            raise ValidationError(\"n must be an integer\")\n        if n < 0:\n            raise ValidationError(\"n must be non-negative\")\n\nclass TetrahedralNumber:\n    \"\"\"Domain model for a computed tetrahedral number.\"\"\"\n    def __init__(self, n: int, value: int) -> None:\n        self.n = n\n        self.value = value\n\nclass TetrahedralCalculator:\n    \"\"\"Performs pure computation of tetrahedral numbers.\"\"\"\n    def calculate(self, n: int) -> int:\n        \"\"\"Calculates the nth tetrahedral number using the closed-form formula.\"\"\"\n        return self.calculate_formula(n)\n\n    def calculate_formula(self, n: int) -> int:\n        \"\"\"Computes the nth tetrahedral number using integer arithmetic.\"\"\"\n        return (n * (n + 1) * (n + 2)) // 6\n\nclass TetrahedralRepository(abc.ABC):\n    \"\"\"Abstract base class for tetrahedral number repositories.\"\"\"\n    @abc.abstractmethod\n    def get(self, n: int) -> int | None:\n        \"\"\"Retrieves a tetrahedral number from the repository.\"\"\"\n        pass\n\n    @abc.abstractmethod\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a tetrahedral number in the repository.\"\"\"\n        pass\n\nclass InMemoryRepository(TetrahedralRepository):\n    \"\"\"In-memory implementation of TetrahedralRepository.\"\"\"\n    def __init__(self) -> None:\n        self._store: dict[int, int] = {}\n\n    def get(self, n: int) -> int | None:\n        \"\"\"Retrieves a tetrahedral number from the in-memory store.\"\"\"\n        return self._store.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a tetrahedral number in the in-memory store.\"\"\"\n        self._store[n] = value\n\nclass TetrahedralService:\n    \"\"\"Business logic for coordinating validation, caching, and computation.\"\"\"\n    def __init__(self, repository: TetrahedralRepository, calculator: TetrahedralCalculator) -> None:\n        self._repository = repository\n        self._calculator = calculator\n\n    def calculate(self, n: int) -> TetrahedralNumber:\n        \"\"\"Validates input, coordinates cache access, and performs computation.\"\"\"\n        Utils.validate_n(n)\n\n        cached_value = self._repository.get(n)\n        if cached_value is not None:\n            return TetrahedralNumber(n, cached_value)\n\n        calculated_value = self._calculator.calculate(n)\n        self._repository.set(n, calculated_value)\n        return TetrahedralNumber(n, calculated_value)\n\ndef tetrahedral_number(n: int) -> int:\n    \"\"\"\n    Computes the nth tetrahedral number using a service layer with in-memory caching.\n    \"\"\"\n    service = TetrahedralService(repository=InMemoryRepository(), calculator=TetrahedralCalculator())\n    return service.calculate(n).value"}
{"task_id": "Mbpp/84", "solution": "from typing import Dict\n\n# Module-level cache for memoization of Newman-Conway sequence numbers.\n_newman_conway_cache: Dict[int, int] = {1: 1, 2: 1}\n\ndef sequence(n: int) -> int:\n    \"\"\"\n    Finds the nth number in the Newman-Conway sequence using memoization.\n    The sequence is defined as a(1)=1, a(2)=1, and a(n) = a(a(n-1)) + a(n - a(n-1)) for n > 2.\n    \"\"\"\n    if n in _newman_conway_cache:\n        return _newman_conway_cache[n]\n\n    max_cached_n = max(_newman_conway_cache.keys())\n\n    for i in range(max_cached_n + 1, n + 1):\n        # Calculate a(i) = a(a(i-1)) + a(i - a(i-1))\n        term1_idx = _newman_conway_cache[i - 1]\n        term2_idx = i - _newman_conway_cache[i - 1]\n        _newman_conway_cache[i] = _newman_conway_cache[term1_idx] + _newman_conway_cache[term2_idx]\n\n    return _newman_conway_cache[n]"}
{"task_id": "Mbpp/88", "solution": "from typing import Any, Dict, Sequence\n\ndef freq_count(values: Sequence[Any]) -> Dict[Any, int]:\n    \"\"\"\n    Counts the frequency of each element in a sequence.\n    Returns a dictionary mapping each unique item to its count.\n    \"\"\"\n    counts: Dict[Any, int] = {}\n    for item in values:\n        if item in counts:\n            counts[item] += 1\n        else:\n            counts[item] = 1\n    return counts"}
{"task_id": "Mbpp/86", "solution": "class CenteredHexRequest:\n    def __init__(self, n: int) -> None:\n        self.n = n\n\nclass CenteredHexResponse:\n    def __init__(self, n: int, value: int) -> None:\n        self.n = n\n        self.value = value\n\nclass InvalidInputError(ValueError):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass ComputationError(RuntimeError):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass HexRepository:\n    def get(self, n: int):\n        raise NotImplementedError\n    def save(self, n: int, value: int):\n        raise NotImplementedError\n\nclass InMemoryHexRepository(HexRepository):\n    def __init__(self) -> None:\n        self._store = {}\n\n    def get(self, n: int):\n        return self._store.get(n)\n\n    def save(self, n: int, value: int) -> None:\n        self._store[n] = value\n\nclass Validator:\n    MIN_N = 1\n\n    def __init__(self) -> None:\n        pass\n\n    def validate_n(self, n: int) -> None:\n        # Per completion instructions, no input validation checks or exceptions for edge cases are added here.\n        pass\n\nclass CenteredHexService:\n    def __init__(self, repository: HexRepository, validator: Validator) -> None:\n        self._repository = repository\n        self._validator = validator\n\n    def compute(self, req: CenteredHexRequest) -> CenteredHexResponse:\n        self._validator.validate_n(req.n)\n        try:\n            cached = self._repository.get(req.n)\n        except Exception as e:\n            raise ComputationError(f\"repo.get failed: {e}\")\n        if cached is not None:\n            return CenteredHexResponse(req.n, cached)\n        \n        value = self._compute_formula(req.n)\n        try:\n            self._repository.save(req.n, value)\n        except Exception as e:\n            raise ComputationError(f\"repo.save failed: {e}\")\n        return CenteredHexResponse(req.n, value)\n\n    def _compute_formula(self, n: int) -> int:\n        \"\"\"Computes the nth centered hexagonal number using the closed-form formula.\"\"\"\n        return 3 * n * (n - 1) + 1\n\ndef centered_hexagonal_number(n: int) -> int:\n    \"\"\"\n    Finds the nth centered hexagonal number.\n    This function initializes a simple in-memory cache and service for the computation.\n    \"\"\"\n    repo = InMemoryHexRepository()\n    validator = Validator()\n    service = CenteredHexService(repo, validator)\n    \n    req = CenteredHexRequest(n)\n    resp = service.compute(req)\n    \n    return resp.value"}
{"task_id": "Mbpp/89", "solution": "import math\n\ndef closest_num(n):\n    \"\"\"\n    Finds the largest integer strictly less than n.\n    If n is an integer or integer-like float, the result is int(n) - 1. Otherwise, it is math.floor(n).\n    \"\"\"\n    f_n = float(n)\n    if f_n == int(f_n):\n        return int(f_n) - 1\n    else:\n        return math.floor(f_n)"}
{"task_id": "Mbpp/90", "solution": "def len_log(words):\n    \"\"\"\n    Finds the length of the longest word in a list of words.\n    Assumes `words` is an iterable of strings.\n    \"\"\"\n    if not words:\n        return 0\n    max_len = 0\n    for word in words:\n        current_len = len(word)\n        if current_len > max_len:\n            max_len = current_len\n    return max_len"}
{"task_id": "Mbpp/93", "solution": "import math\n\ndef power(a: float | int, b: int | float) -> float:\n    \"\"\"\n    Calculates the value of 'a' to the power 'b'.\n    This is a convenience function that internally uses the PowerService.\n    \"\"\"\n    from .calculator import PowerCalculator\n    from .validator import InputValidator\n    from .service import PowerService\n    from .dto import PowerRequest\n\n    # Create instances of dependencies\n    calculator = PowerCalculator()\n    validator = InputValidator()\n    service = PowerService(calculator, validator)\n\n    # Create a PowerRequest DTO\n    request = PowerRequest(base_raw=a, exponent_raw=b)\n\n    # Compute the result using the service\n    result = service.compute(request)\n\n    return result.value"}
{"task_id": "Mbpp/91", "solution": "import collections\n\ndef find_substring(values, sub):\n    \"\"\"Check if a string is present as a substring in a given list of string values.\n\n    An empty substring is treated as not found.\n    \"\"\"\n    if not isinstance(sub, str) or not sub:\n        return False\n    if not isinstance(values, collections.abc.Iterable):\n        return False # This design decision is based on an interpretation of the instruction to avoid isinstance checks *for edge cases* and return False.\n    \n    for s in values:\n        if not isinstance(s, str):\n            continue # Skip non-string elements as per the implicit understanding from the prompt that it should handle \"list of string values\"\n        if sub in s:\n            return True\n    return False"}
{"task_id": "Mbpp/87", "solution": "def merge_dictionaries_three(a: dict, b: dict, c: dict) -> dict:\n    \"\"\"\n    Merges three dictionaries into a single dictionary, with precedence 'a' > 'b' > 'c'.\n    Keys from earlier dictionaries are retained, and new keys are added in order of precedence.\n    \"\"\"\n    merged_dict = {}\n\n    # Process dictionary 'a' first to establish its keys and values, giving it highest precedence.\n    for key, value in a.items():\n        merged_dict[key] = value\n\n    # Then process dictionary 'b', adding keys only if they are not already in merged_dict.\n    # This ensures 'b' values are used if not present in 'a'.\n    for key, value in b.items():\n        if key not in merged_dict:\n            merged_dict[key] = value\n\n    # Finally process dictionary 'c', adding keys only if they are not already in merged_dict.\n    # This ensures 'c' values are used only if not present in 'a' or 'b'.\n    for key, value in c.items():\n        if key not in merged_dict:\n            merged_dict[key] = value\n            \n    return merged_dict"}
{"task_id": "Mbpp/92", "solution": "class ValidationError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass NumberParser:\n    def parse(self, number: int | str) -> list[int]:\n        if isinstance(number, int):\n            n = abs(number)\n            s = str(n)\n        elif isinstance(number, str):\n            s = number.strip()\n            if s.startswith(('+','-')):\n                s = s[1:].lstrip()\n            if not s:\n                raise ValidationError(\"Empty number string\")\n            if not all(c.isdigit() for c in s):\n                raise ValidationError(\"Invalid characters in number\")\n        else:\n            raise ValidationError(\"Unsupported input type\")\n        s = s.lstrip('0') or '0'\n        return [int(ch) for ch in s]\n\nclass DigitSequence:\n    def __init__(self, digits: list[int]) -> None:\n        self.digits = digits\n\n    def length(self) -> int:\n        return len(self.digits)\n\n    def get(self, i: int) -> int:\n        return self.digits[i]\n\n    def distinct_digits(self) -> set[int]:\n        return set(self.digits)\n\n    def is_alternating_between_two(self) -> bool:\n        \"\"\"\n        Checks if the digit sequence alternates between exactly two distinct digits.\n        Assumes length >= 2 and d[0] != d[1] already for three-or-more digit numbers.\n        \"\"\"\n        if len(self.digits) < 2:\n            return False\n        a, b = self.digits[0], self.digits[1]\n        if a == b:\n            return False # Should already be handled for length >= 2 if called from checker\n\n        for i, d in enumerate(self.digits):\n            expected = a if i % 2 == 0 else b\n            if d != expected:\n                return False\n        return len(self.distinct_digits()) == 2\n\n\nclass UndulatingChecker:\n    def __init__(self) -> None:\n        self._parser = NumberParser()\n\n    def is_undulating(self, number: int | str) -> bool:\n        \"\"\"Checks if a given number is undulating (digits alternate between exactly two distinct values).\"\"\"\n        digits = self._parser.parse(number)\n        seq = DigitSequence(digits)\n\n        if seq.length() < 2:\n            return False\n        if seq.length() == 2:\n            return self._is_two_digit_undulating(seq.get(0), seq.get(1))\n        \n        # For numbers with 3 or more digits, use the comprehensive alternation check\n        return seq.is_alternating_between_two()\n\n    def _is_two_digit_undulating(self, d0: int, d1: int) -> bool:\n        \"\"\"Helper for two-digit numbers, which are undulating if their digits are different.\"\"\"\n        return d0 != d1\n\n_checker = UndulatingChecker()\n\ndef is_undulating(number: int | str) -> bool:\n    \"\"\"\n    Checks whether the given number is undulating.\n    An undulating number has digits that alternate between exactly two distinct values (e.g., 12121, 8989).\n    Single-digit numbers are not undulating. Two-digit numbers are undulating if their digits are different.\n    \"\"\"\n    return _checker.is_undulating(number)"}
{"task_id": "Mbpp/94", "solution": "from typing import List, Tuple, Any\n\ndef index_minimum(items: List[Tuple[Any, Any]]) -> Any:\n    \"\"\"\n    Given a list of tuples, returns the first value of the tuple with the smallest second value.\n    Handles tie-breaking by returning the first encountered item with the minimum value.\n    \"\"\"\n    \n    # Initialize best_item with the first element.\n    # If the input `items` list is empty, this will raise an IndexError,\n    # consistent with the instruction to not add explicit checks or raise custom exceptions.\n    best_item = items[0]\n\n    # Iterate through the rest of the list, starting from the second element.\n    for item in items[1:]:\n        # Compare the second values of the current item and the best item found so far.\n        if item[1] < best_item[1]:\n            best_item = item\n            \n    # Return the first value of the tuple that had the smallest second value.\n    return best_item[0]"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(lists: list[list]) -> int:\n    \"\"\"\n    Finds the length of the smallest list in a list of lists.\n    Assumes `lists` is a non-empty list of lists/tuples, and each inner element is also a list/tuple.\n    \"\"\"\n    return min(len(inner_list) for inner_list in lists)"}
{"task_id": "Mbpp/97", "solution": "from typing import List, Dict, Iterable, Iterator, TypeVar\n\nT = TypeVar('T')\n\ndef _flatten_iterables(input_iterable: Iterable[Iterable[T]]) -> Iterator[T]:\n    \"\"\"\n    Flattens a one-level nested iterable into a single iterator.\n    \"\"\"\n    for sub in input_iterable:\n        for elem in sub:\n            yield elem\n\ndef frequency_lists(input: List[List[T]]) -> Dict[T, int]:\n    \"\"\"\n    Finds the frequency of each element in a flattened list of lists.\n    \"\"\"\n    counts: Dict[T, int] = {}\n    for item in _flatten_iterables(input):\n        counts[item] = counts.get(item, 0) + 1\n    return counts"}
{"task_id": "Mbpp/98", "solution": "import math\nfrom typing import Iterable\n\n# NOTE: The design context specifies a full application with validation, persistence, etc.\n# However, the user request for \"multiply_num\" implies a standalone function that\n# performs the core calculation directly, matching the provided assert statement.\n# Therefore, this implementation provides the direct calculation without the\n# broader application context (validators, services, persistence) unless explicitly required\n# for *this specific function*.\n# The prompt \"DO NOT call any helper that is not defined inline in your response\"\n# reinforces that this function should be self-contained for the calculation.\n\ndef multiply_num(numbers: Iterable[float]) -> float:\n    \"\"\"\n    Multiplies all numbers in a list and divides the product by the length of the list.\n    Assumes valid, non-empty numeric input as per design context for the core function.\n    \"\"\"\n    product = 1.0\n    for num in numbers:\n        product *= num\n    \n    length = len(list(numbers)) # Convert to list to get length if not already a sized iterable\n\n    return product / length"}
{"task_id": "Mbpp/96", "solution": "from typing import Dict\n\ndef _prime_factors(n: int) -> Dict[int, int]:\n    \"\"\"\n    Computes the prime factorization of n, returning a dictionary of prime -> exponent.\n    It uses trial division up to sqrt(n) with optimizations for 2 and odd numbers.\n    \"\"\"\n    factors: Dict[int, int] = {}\n    # Handle factor 2\n    while n % 2 == 0:\n        factors[2] = factors.get(2, 0) + 1\n        n //= 2\n    # Handle odd factors starting from 3\n    p = 3\n    while p * p <= n:\n        while n % p == 0:\n            factors[p] = factors.get(p, 0) + 1\n            n //= p\n        p += 2\n    # If n is still greater than 1, it must be a prime factor itself\n    if n > 1:\n        factors[n] = factors.get(n, 0) + 1\n    return factors\n\ndef divisor(n: int) -> int:\n    \"\"\"\n    Finds the number of positive divisors of a given integer.\n    For n=0, it returns 0. For negative n, it uses its absolute value.\n    \"\"\"\n    if n == 0:\n        return 0\n    \n    n_abs = abs(n)\n    prime_factorization = _prime_factors(n_abs)\n    \n    # The number of divisors is the product of (exponent + 1) for each prime factor.\n    num_divisors = 1\n    for exponent in prime_factorization.values():\n        num_divisors *= (exponent + 1)\n        \n    return num_divisors"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome strictly greater than the given integer n.\n    \"\"\"\n\n    def _is_palindrome(s_digits: list[str]) -> bool:\n        \"\"\"Checks if a list of digit strings forms a palindrome.\"\"\"\n        return s_digits == s_digits[::-1]\n\n    def _mirror_left_to_right(s_digits: list[str]) -> list[str]:\n        \"\"\"Mirrors the left half of the digit list to its right half.\"\"\"\n        length = len(s_digits)\n        mid = length // 2\n        for i in range(mid):\n            s_digits[length - 1 - i] = s_digits[i]\n        return s_digits\n\n    def _compare_str_nums(a_digits: list[str], b_digits: list[str]) -> int:\n        \"\"\"Compares two numbers represented as digit lists.\"\"\"\n        if len(a_digits) < len(b_digits):\n            return -1\n        if len(a_digits) > len(b_digits):\n            return 1\n        for i in range(len(a_digits)):\n            if a_digits[i] < b_digits[i]:\n                return -1\n            if a_digits[i] > b_digits[i]:\n                return 1\n        return 0\n\n    def _increment_middle(s_digits: list[str]) -> list[str]:\n        \"\"\"Increments the middle digit(s) of the number represented by digit list, handling carry and length increase.\"\"\"\n        length = len(s_digits)\n        left_half_end_idx = (length - 1) // 2\n        \n        carry = 1\n        for i in range(left_half_end_idx, -1, -1):\n            digit = int(s_digits[i]) + carry\n            s_digits[i] = str(digit % 10)\n            carry = digit // 10\n            if carry == 0:\n                break\n        \n        if carry == 1:\n            return ['1'] + ['0'] * (length - 1) + ['1']\n        \n        return s_digits\n\n    def _get_next_palindrome_digits(digits: list[str]) -> list[str]:\n        \"\"\"Computes the next palindrome as a list of digit strings.\"\"\"\n        current_length = len(digits)\n        \n        if all(d == '9' for d in digits):\n            return ['1'] + ['0'] * (current_length - 1) + ['1']\n\n        original_digits_copy = digits[:] \n        candidate_palindrome_digits = _mirror_left_to_right(digits[:]) \n\n        if _compare_str_nums(candidate_palindrome_digits, original_digits_copy) == 1:\n            return candidate_palindrome_digits\n        \n        incremented_digits = _increment_middle(original_digits_copy[:])\n        final_palindrome = _mirror_left_to_right(incremented_digits)\n        \n        return final_palindrome\n\n    s_n_digits = list(str(n))\n    next_digits_list = _get_next_palindrome_digits(s_n_digits)\n    \n    return int(\"\".join(next_digits_list))"}
