{"task_id": "Mbpp/428", "solution": "from typing import List, Optional, Iterable, Any\nfrom datetime import datetime\nimport time\n\nclass SortError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass ValidationError(SortError):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass GapStrategy:\n    def generate(self, n: int) -> List[int]:\n        raise NotImplementedError\n\nclass KnuthGapStrategy(GapStrategy):\n    def generate(self, n: int) -> List[int]:\n        gaps = []\n        h = 1\n        while h < n:\n            gaps.append(h)\n            h = 3 * h + 1\n        return list(reversed([g for g in gaps if g < n]))\n\nclass InputValidator:\n    @staticmethod\n    def validate_array(arr: Iterable[Any]) -> List[int]:\n        if arr is None:\n            raise ValidationError(\"Input array cannot be None.\")\n        if not hasattr(arr, '__iter__'):\n            raise ValidationError(\"Input is not iterable.\")\n\n        validated_list: List[int] = []\n        for item in arr:\n            try:\n                validated_list.append(int(item))\n            except (ValueError, TypeError) as e:\n                raise ValidationError(f\"Array item '{item}' cannot be converted to integer: {e}\")\n        return validated_list\n\nclass MetricEntry:\n    def __init__(self, timestamp: datetime, input_size: int, duration_ms: float, gaps: List[int]) -> None:\n        self.timestamp = timestamp\n        self.input_size = input_size\n        self.duration_ms = duration_ms\n        self.gaps = gaps\n\n    def to_dict(self) -> dict:\n        return {\n            \"timestamp\": self.timestamp.isoformat(),\n            \"input_size\": self.input_size,\n            \"duration_ms\": self.duration_ms,\n            \"gaps\": self.gaps\n        }\n\n    @staticmethod\n    def from_dict(d: dict) -> 'MetricEntry':\n        return MetricEntry(\n            timestamp=datetime.fromisoformat(d[\"timestamp\"]),\n            input_size=d[\"input_size\"],\n            duration_ms=d[\"duration_ms\"],\n            gaps=d[\"gaps\"]\n        )\n\nclass MetricsRepository:\n    def __init__(self, filepath: str) -> None:\n        self._filepath = filepath\n    \n    def save(self, entry: MetricEntry) -> None:\n        pass\n    \n    def load_all(self) -> List[MetricEntry]:\n        return []\n\nclass MetricsCollector:\n    def __init__(self, repo: MetricsRepository) -> None:\n        self._repo = repo\n\n    def record(self, start: float, end: float, input_size: int, gaps: List[int]) -> MetricEntry:\n        duration_ms = (end - start) * 1000\n        entry = MetricEntry(\n            timestamp=datetime.now(),\n            input_size=input_size,\n            duration_ms=duration_ms,\n            gaps=gaps\n        )\n        self._repo.save(entry)\n        return entry\n\nclass ShellSorter:\n    def __init__(self, gap_strategy: Optional[GapStrategy] = None, in_place: bool = False, metrics_collector: Optional[MetricsCollector] = None) -> None:\n        self._gap_strategy = gap_strategy or KnuthGapStrategy()\n        self._in_place = in_place\n        self._metrics_collector = metrics_collector\n\n    def sort(self, array: List[int]) -> List[int]:\n        arr = InputValidator.validate_array(array)\n        if not self._in_place:\n            arr = list(arr)\n        n = len(arr)\n        gaps = self._gap_strategy.generate(n)\n\n        start = time.perf_counter()\n        self._shell_sort_inplace(arr, gaps)\n        end = time.perf_counter()\n\n        if self._metrics_collector:\n            self._metrics_collector.record(start, end, n, gaps)\n        return arr\n\n    def _shell_sort_inplace(self, arr: List[int], gaps: List[int]) -> None:\n        for gap in gaps:\n            for i in range(gap, len(arr)):\n                temp = arr[i]\n                j = i\n                while j >= gap and arr[j - gap] > temp:\n                    arr[j] = arr[j - gap]\n                    j -= gap\n                arr[j] = temp\n\ndef shell_sort(array: List[int]) -> List[int]:\n    \"\"\"Sorts an array using the Shell Sort algorithm.\n    It delegates the sorting to a ShellSorter instance with default settings.\"\"\"\n    return ShellSorter().sort(array)"}
