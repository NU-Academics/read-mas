{"task_id": "Mbpp/253", "solution": "from typing import Any, Sequence\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation errors.\"\"\"\n    pass\n\nclass ListValidator:\n    \"\"\"Validates and normalizes input items.\"\"\"\n    def validate(self, items: Any) -> Sequence[Any]:\n        if items is None:\n            raise ValidationError(\"Input cannot be None.\")\n        if isinstance(items, str):\n            raise ValidationError(\"String input must be parsed into a list or sequence.\")\n        try:\n            return list(items)\n        except TypeError:\n            raise ValidationError(\"Input must be an iterable (e.g., list, tuple).\")\n\nclass ListRepository:\n    \"\"\"Abstracts input items, ensuring they are sequences.\"\"\"\n    def get_items(self, items: Any) -> Sequence[Any]:\n        return items\n\ndef is_strict_int(value: Any) -> bool:\n    \"\"\"Checks if a value is strictly an integer, excluding booleans.\"\"\"\n    return type(value) is int\n\nclass CountingService:\n    \"\"\"Core business logic for counting strict integers in a sequence.\"\"\"\n    def __init__(self, repository: ListRepository, validator: ListValidator) -> None:\n        self._repository = repository\n        self._validator = validator\n\n    def count(self, items: Any) -> int:\n        seq = self._validator.validate(items)\n        seq = self._repository.get_items(seq)\n        return self._count_in_sequence(seq)\n\n    def _count_in_sequence(self, seq: Sequence[Any]) -> int:\n        return sum(1 for v in seq if is_strict_int(v))\n\ndef count_integer(items: Sequence[Any]) -> int:\n    \"\"\"\n    Returns the number of integer elements in a given list.\n    Only elements whose type is exactly int (not bool) are counted.\n    \"\"\"\n    repo = ListRepository()\n    validator = ListValidator()\n    service = CountingService(repository=repo, validator=validator)\n    return service.count(items)"}
{"task_id": "Mbpp/252", "solution": "import cmath\nimport math\n\ndef convert(value) -> tuple[float, float]:\n    \"\"\"\n    Converts a complex number (or real number) to polar coordinates (radius, angle).\n    Angle is normalized to the interval (-pi, pi].\n    \"\"\"\n    _PI = math.pi\n    _TWO_PI = 2 * _PI\n\n    def _normalize_angle(theta: float) -> float:\n        \"\"\"Normalizes an angle to the range (-pi, pi], with pi included.\"\"\"\n        t = math.fmod(theta + _PI, _TWO_PI)\n        if t < 0:\n            t += _TWO_PI\n        result = t - _PI\n        # Adjust if result is very close to -pi to map to pi due to floating point.\n        if result <= -_PI + 1e-15: # Use a small tolerance for comparison\n            return _PI\n        return result\n\n    z = complex(value)\n    r = abs(z)\n\n    if r == 0.0:\n        return (0.0, 0.0)\n\n    theta = cmath.phase(z)\n    theta = _normalize_angle(theta)\n\n    return (r, theta)"}
