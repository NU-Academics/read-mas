{"task_id": "Mbpp/256", "solution": "def _sieve_count_implementation(n: int) -> int:\n    \"\"\"\n    Implements the Sieve of Eratosthenes to count prime numbers less than n.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    if n <= 2:\n        return 0\n\n    sieve = bytearray(b\"\\x01\") * n\n    sieve[0:2] = b\"\\x00\\x00\"\n\n    for p in range(2, int(n**0.5) + 1):\n        if sieve[p]:\n            # Mark multiples of p (starting from p*p) as not prime.\n            # The slicing efficiently updates the bytearray.\n            start = p * p\n            step = p\n            sieve[start:n:step] = b\"\\x00\" * ((n - 1 - start) // step + 1)\n            \n    return sum(sieve)\n\ndef count_Primes_nums(n: int) -> int:\n    \"\"\"\n    Returns the number of prime numbers strictly less than the given non-negative integer n.\n    It uses an inline Sieve of Eratosthenes implementation.\n    \"\"\"\n    return _sieve_count_implementation(n)"}
{"task_id": "Mbpp/259", "solution": "from typing import Tuple\n\ndef maximize_elements(a: Tuple[Tuple[float, ...], ...], b: Tuple[Tuple[float, ...], ...]) -> Tuple[Tuple[float, ...], ...]:\n    \"\"\"\n    Computes the element-wise maximum of two tuples of tuples.\n    It assumes inputs are valid: equal length outer tuples, equal length inner tuples, and numeric elements.\n    \"\"\"\n    return tuple(\n        tuple(max(val_a, val_b) for val_a, val_b in zip(inner_a, inner_b))\n        for inner_a, inner_b in zip(a, b)\n    )"}
{"task_id": "Mbpp/261", "solution": "from typing import Tuple, Any, Iterable, Union, Iterator\n\nclass DivisionError(Exception):\n    \"\"\"Base exception for tuple division errors.\"\"\"\n    pass\n\nclass InvalidInputError(DivisionError):\n    \"\"\"Raised when input tuples or their elements are invalid.\"\"\"\n    pass\n\nclass DivisionByZeroError(DivisionError):\n    \"\"\"Raised when a denominator element is zero.\"\"\"\n    pass\n\ndef safe_numeric(value: Any) -> float:\n    \"\"\"Converts a value to float, raising InvalidInputError if non-numeric.\"\"\"\n    if isinstance(value, (int, float)):\n        return float(value)\n    raise InvalidInputError(f\"Non-numeric value: {value!r}\")\n\ndef safe_divide(numerator: float, denominator: float) -> int:\n    \"\"\"Performs integer division with truncation toward zero, raising DivisionByZeroError if denominator is zero.\"\"\"\n    if denominator == 0:\n        raise DivisionByZeroError(\"Denominator is zero\")\n    return int(numerator / denominator)\n\nclass TupleValidator:\n    \"\"\"Validates properties of input tuples for division.\"\"\"\n    @staticmethod\n    def validate_pair(a: Tuple[Any, ...], b: Tuple[Any, ...]) -> Tuple[Tuple[float, ...], Tuple[float, ...]]:\n        \"\"\"\n        Validates two tuples for type, length, and numeric elements.\n        Returns numeric-converted tuples if valid, otherwise raises InvalidInputError.\n        \"\"\"\n        if not isinstance(a, tuple) or not isinstance(b, tuple):\n            raise InvalidInputError(\"Both inputs must be tuples\")\n        if len(a) != len(b):\n            raise InvalidInputError(\"Tuples must have the same length\")\n        \n        try:\n            numerators = tuple(safe_numeric(x) for x in a)\n            denominators = tuple(safe_numeric(x) for x in b)\n        except InvalidInputError as e:\n            raise InvalidInputError(f\"Error converting tuple elements to numeric: {e}\") from e\n            \n        return numerators, denominators\n\nclass DivisionService:\n    \"\"\"Encapsulates the element-wise division logic.\"\"\"\n    def divide(self, numerators: Tuple[float, ...], denominators: Tuple[float, ...]) -> Tuple[int, ...]:\n        \"\"\"\n        Performs element-wise integer division of two numeric tuples.\n        Raises DivisionByZeroError if any denominator is zero.\n        \"\"\"\n        results = tuple(safe_divide(n, d) for n, d in zip(numerators, denominators))\n        return results\n\ndef division_elements(a: Tuple[Any, ...], b: Tuple[Any, ...]) -> Tuple[int, ...]:\n    \"\"\"\n    Performs element-wise integer division between two tuples of numbers.\n    Input tuples are validated for type, length, and numeric content.\n    \"\"\"\n    numerators, denominators = TupleValidator.validate_pair(a, b)\n    return DivisionService().divide(numerators, denominators)"}
{"task_id": "Mbpp/262", "solution": "def split_two_parts(lst, L):\n    \"\"\"\n    Splits a list into two parts: the first of length L, and the rest.\n    Returns the two parts as a tuple.\n    \"\"\"\n    first_part = lst[:L]\n    second_part = lst[L:]\n    return (first_part, second_part)"}
{"task_id": "Mbpp/265", "solution": "from typing import Any, List\n\ndef list_split(items: List[Any], n: int) -> List[List[Any]]:\n    \"\"\"\n    Splits a list into n interleaved sublists, returning a list of the resulting lists.\n    Elements are distributed to sublists based on their original index modulo n.\n    \"\"\"\n    result: List[List[Any]] = [[] for _ in range(n)]\n    for idx, item in enumerate(items):\n        result[idx % n].append(item)\n    return result"}
{"task_id": "Mbpp/264", "solution": "import math\n\nclass InvalidAgeError(ValueError):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass InputValidator:\n    def validate_human_years(self, value: float) -> None:\n        try:\n            val = float(value)\n        except (TypeError, ValueError):\n            raise InvalidAgeError(\"human_years must be numeric\")\n        if math.isnan(val) or math.isinf(val):\n            raise InvalidAgeError(\"human_years must be finite\")\n        if val < 0:\n            raise InvalidAgeError(\"human_years must be non-negative\")\n\nclass DogAgeCalculator:\n    def __init__(self, first_two_years_value: float = 10.5, additional_year_value: float = 4.0) -> None:\n        self.first_two_years_value = float(first_two_years_value)\n        self.additional_year_value = float(additional_year_value)\n\n    def calculate(self, human_years: float) -> float:\n        if human_years <= 0:\n            return 0.0\n        if human_years <= 2:\n            return human_years * self.first_two_years_value\n        return 2 * self.first_two_years_value + (human_years - 2) * self.additional_year_value\n\nclass PublicAPI:\n    def __init__(self, validator: InputValidator | None = None, calculator: DogAgeCalculator | None = None) -> None:\n        self.validator = validator or InputValidator()\n        self.calculator = calculator or DogAgeCalculator()\n\n    def dog_age(self, human_years: float) -> int | float:\n        self.validator.validate_human_years(human_years)\n        result = self.calculator.calculate(human_years)\n        # Normalize to int when whole number, otherwise return float.\n        return int(result) if float(result).is_integer() else result\n\n_default_api = PublicAPI()\n\ndef dog_age(human_years: float) -> int | float:\n    \"\"\"\n    Calculate a dog's age in dog's years based on human years.\n    Applies the formula: 10.5 dog years per human year for the first two, then 4 dog years per additional year.\n    \"\"\"\n    return _default_api.dog_age(human_years)"}
{"task_id": "Mbpp/260", "solution": "from nswprime.recurrence import RecurrenceGenerator\nfrom nswprime.primality import PrimalityTester\nfrom nswprime.repository import FileCacheRepository\nfrom nswprime.service import NSWService\nfrom nswprime.config import DEFAULT_CACHE_PATH\n\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the nth Newman\u2013Shanks\u2013Williams number.\n    \"\"\"\n    repo = FileCacheRepository(DEFAULT_CACHE_PATH)\n    svc = NSWService(RecurrenceGenerator(), repo, PrimalityTester())\n    return svc.get_nsw(n)"}
