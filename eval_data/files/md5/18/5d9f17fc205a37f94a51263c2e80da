{"task_id": "Mbpp/75", "solution": "from typing import Iterable, Tuple, List\n\ndef find_tuples(items: Iterable[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n    \"\"\"\n    Filters a list of tuples, returning only those where all elements are divisible by k.\n    \"\"\"\n    return [t for t in items if all(x % k == 0 for x in t)]"}
{"task_id": "Mbpp/77", "solution": "from typing import Union\n\nclass Div11Error(Exception):\n    \"\"\"Base exception for div11_app.\"\"\"\n    pass\n\nclass InvalidNumberError(Div11Error):\n    \"\"\"Raised when input cannot be parsed into a valid number.\"\"\"\n    pass\n\nclass NumberInput:\n    \"\"\"Represents a validated numeric input, holding its raw and absolute integer value.\"\"\"\n    def __init__(self, raw: str) -> None:\n        self._raw = raw\n        self._value = self.normalize()\n\n    def normalize(self) -> int:\n        \"\"\"Parses the raw input string into an absolute integer, handling signs and underscores.\"\"\"\n        s = self._raw.strip()\n        if not s:\n            raise InvalidNumberError(\"empty input\")\n        try:\n            s_clean = s.replace(\"_\", \"\")\n            val = int(s_clean)\n        except ValueError as e:\n            raise InvalidNumberError(f\"invalid number: {self._raw}\") from e\n        return abs(val)\n\n    def get_value(self) -> int:\n        \"\"\"Returns the normalized absolute integer value.\"\"\"\n        return self._value\n\nclass InputParser:\n    \"\"\"Provides methods to parse raw string input into a NumberInput object.\"\"\"\n    def parse(self, raw: str) -> NumberInput:\n        return NumberInput(raw)\n\nclass DivisibilityService:\n    \"\"\"Encapsulates the business logic for checking divisibility by 11.\"\"\"\n    def is_diff_number(self, number: int) -> bool:\n        \"\"\"Checks if the given integer is divisible by 11 using the modulo operator.\"\"\"\n        return number % 11 == 0\n\n_parser = InputParser()\n_service = DivisibilityService()\n\ndef is_Diff(number: Union[int, str]) -> bool:\n    \"\"\"\n    Checks if a number is divisible by 11.\n    Accepts integers or numeric strings, handling signs and underscores.\n    \"\"\"\n    model = _parser.parse(str(number))\n    return _service.is_diff_number(model.get_value())"}
