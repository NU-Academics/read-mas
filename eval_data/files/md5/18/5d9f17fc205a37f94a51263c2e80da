{"task_id": "Mbpp/796", "solution": "import enum\nfrom decimal import Decimal\nfrom fractions import Fraction\nfrom typing import Any, Dict, Union, Tuple, Iterable, Optional\n\n# --- Policies ---\nclass SumPolicy(enum.Enum):\n    \"\"\"Enumeration for handling non-numeric values.\"\"\"\n    RAISE = \"raise\"\n    SKIP = \"skip\"\n\nDEFAULT_POLICY = SumPolicy.RAISE\n\n# --- Exceptions ---\nclass SumDictError(Exception):\n    \"\"\"Base exception for the sumdict library.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\nclass InvalidInputError(SumDictError):\n    \"\"\"Raised when input data is not a dict.\"\"\"\n    pass\n\nclass NonNumericValueError(SumDictError):\n    \"\"\"Raised when a non-numeric value is encountered and policy is RAISE.\"\"\"\n    def __init__(self, key: Any, value: Any, message: str) -> None:\n        self.key = key\n        self.value = value\n        super().__init__(message)\n\n# --- Models ---\nclass DictInput:\n    \"\"\"Immutable wrapper around an input dictionary.\"\"\"\n    def __init__(self, data: Dict[Any, Any]) -> None:\n        if not isinstance(data, dict):\n            raise InvalidInputError(\"Input must be a dict\")\n        self.data = data\n\n    def get_items(self) -> Iterable[Tuple[Any, Any]]:\n        \"\"\"Yields (key, value) pairs for iteration.\"\"\"\n        return self.data.items()\n\n# --- Utils ---\n_SUPPORTED_NUMERIC_TYPES = (int, float, Decimal, Fraction)\n\ndef is_numeric(value: Any) -> bool:\n    \"\"\"Determines if value is of a supported numeric type.\"\"\"\n    return isinstance(value, _SUPPORTED_NUMERIC_TYPES)\n\ndef to_decimal(value: Any) -> Decimal:\n    \"\"\"Convert supported numeric types to Decimal safely.\"\"\"\n    if isinstance(value, Decimal):\n        return value\n    if isinstance(value, Fraction):\n        return Decimal(value.numerator) / Decimal(value.denominator)\n    if isinstance(value, (int, float)):\n        return Decimal(str(value))\n    raise ValueError(f\"Unsupported numeric type for conversion: {type(value)}\")\n\n# --- Repositories (simplified as it's optional and not core to summation) ---\nclass DictRepository:\n    \"\"\"Optional in-memory persistence of inputs.\"\"\"\n    def __init__(self, storage_path: Optional[str] = None) -> None:\n        self._storage_path = storage_path\n        self._store: Optional[DictInput] = None\n\n    def save(self, data: DictInput) -> None:\n        \"\"\"Saves the DictInput instance in-memory.\"\"\"\n        if self._storage_path is None:\n            self._store = data\n\n    def load(self) -> Optional[DictInput]:\n        \"\"\"Loads a previously saved DictInput instance from memory.\"\"\"\n        return self._store\n\n# --- Services ---\nclass SumService:\n    \"\"\"Business logic to sum values from a dictionary.\"\"\"\n    def __init__(self, repository: Optional[DictRepository] = None) -> None:\n        self._repo = repository\n        self._validator = DictValidator()\n\n    def sum_dict(self, data: Dict[Any, Any], policy: SumPolicy = DEFAULT_POLICY) -> Decimal:\n        \"\"\"Validates input, sums numeric values based on policy, and returns Decimal total.\"\"\"\n        dto = self._validator.validate(data, policy)\n        total = Decimal('0')\n        for k, v in dto.get_items():\n            if not is_numeric(v):\n                if policy is SumPolicy.RAISE:\n                    raise NonNumericValueError(k, v, f\"Non-numeric value '{v}' for key '{k}'\")\n                else:\n                    continue\n            try:\n                total += to_decimal(v)\n            except ValueError as e:\n                raise NonNumericValueError(k, v, f\"Failed to convert numeric value '{v}' to Decimal: {e}\")\n\n        if self._repo:\n            self._repo.save(dto)\n        return total\n\n# --- Controllers ---\nclass SumController:\n    \"\"\"API layer exposing compute_sum to programmatic callers.\"\"\"\n    def __init__(self, service: SumService) -> None:\n        self._service = service\n\n    def compute_sum(self, data: Dict[Any, Any], policy: SumPolicy = DEFAULT_POLICY) -> Decimal:\n        \"\"\"Computes the sum of dictionary values using the SumService.\"\"\"\n        return self._service.sum_dict(data, policy)\n\n# Global instances initialized once as per design\n_service = SumService()\n_controller = SumController(_service)\n\ndef return_sum(data: dict, policy: SumPolicy = DEFAULT_POLICY) -> Decimal:\n    \"\"\"\n    Finds the sum of all numeric values in the given dictionary.\n    Non-numeric values are handled based on the specified policy.\n    \"\"\"\n    return _controller.compute_sum(data, policy)"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers: list[int]) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    The product is even if at least one number in the list is even.\n    \"\"\"\n    for n in numbers:\n        if n % 2 == 0:\n            return True\n    return False"}
{"task_id": "Mbpp/803", "solution": "import math\n\ndef is_perfect_square(n):\n    # Convert the input to an integer. This handles int, float (e.g., 4.0 becomes 4),\n    # and numeric strings (e.g., \"9\" becomes 9).\n    # If the input is not numeric (e.g., \"abc\") or causes a TypeError (e.g., None),\n    # the built-in int() conversion will raise an error.\n    val = int(n)\n\n    # Negative numbers are not considered perfect squares according to the design.\n    if val < 0:\n        return False\n\n    # Calculate the integer square root. math.isqrt is efficient for this.\n    root = math.isqrt(val)\n\n    # A number is a perfect square if the square of its integer square root\n    # equals the original number.\n    return root * root == val"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(s: str) -> int:\n    \"\"\"\n    Finds the maximum run of consecutive uppercase characters in a string.\n    Only ASCII characters 'A' through 'Z' are considered uppercase.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in s:\n        # Check if the character is an ASCII uppercase letter\n        if 'A' <= char <= 'Z':\n            current_run += 1\n            if current_run > max_run:\n                max_run = current_run\n        else:\n            current_run = 0\n    return max_run"}
{"task_id": "Mbpp/805", "solution": "from typing import List\n\ndef max_sum_list(lists: List[List[int]]) -> List[int]:\n    \"\"\"\n    Returns the sub-list in a list of lists whose sum of elements is the highest.\n    If multiple lists share the highest sum, the first one encountered is returned.\n    \"\"\"\n    if not lists:\n        return []\n\n    max_sum_value = None\n    max_list_index = 0\n\n    for idx, sublist in enumerate(lists):\n        current_sum = sum(sublist)\n        if max_sum_value is None or current_sum > max_sum_value:\n            max_sum_value = current_sum\n            max_list_index = idx\n\n    return lists[max_list_index]"}
