{"task_id": "Mbpp/427", "solution": "import re\nfrom typing import Optional\n\nclass DateFormatError(Exception):\n    \"\"\"Custom exception for date formatting errors.\"\"\"\n    def __init__(self, message: str, input_value: Optional[str] = None) -> None:\n        self.message = message\n        self.input_value = input_value\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        if self.input_value:\n            return f\"{self.message}: '{self.input_value}'\"\n        return self.message\n\nclass DateModel:\n    \"\"\"Data model for date components.\"\"\"\n    def __init__(self, year: int, month: int, day: int) -> None:\n        self.year = year\n        self.month = month\n        self.day = day\n\n    def to_dd_mm_yyyy(self) -> str:\n        \"\"\"Returns the date in 'DD-MM-YYYY' string format.\"\"\"\n        return f\"{self.day:02d}-{self.month:02d}-{self.year}\"\n\nclass DateValidator:\n    \"\"\"Validates date string format and semantics.\"\"\"\n    _RE = re.compile(r\"^\\d{4}-\\d{2}-\\d{2}$\")\n    _DAYS_IN_MONTH = [0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]\n\n    def _is_leap_year(self, year: int) -> bool:\n        \"\"\"Determines if a year is a leap year.\"\"\"\n        return (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0)\n\n    def _days_in_month(self, year: int, month: int) -> int:\n        \"\"\"Returns the number of days in a given month and year.\"\"\"\n        if month == 2 and self._is_leap_year(year):\n            return 29\n        return self._DAYS_IN_MONTH[month]\n\n    def validate(self, date_str: str) -> DateModel:\n        \"\"\"Parses and validates the date string, returning a DateModel.\"\"\"\n        if not self._RE.match(date_str):\n            raise DateFormatError(\"Date must match yyyy-mm-dd format\", date_str)\n\n        year, month, day = map(int, date_str.split(\"-\"))\n\n        if not (1 <= month <= 12):\n            raise DateFormatError(\"Month must be between 01 and 12\", date_str)\n\n        days_in_current_month = self._days_in_month(year, month)\n        if not (1 <= day <= days_in_current_month):\n            raise DateFormatError(f\"Day out of range for month {month:02d}\", date_str)\n        \n        return DateModel(year, month, day)\n\nclass DateService:\n    \"\"\"Handles the business logic for date conversion.\"\"\"\n    def __init__(self, validator: Optional[DateValidator] = None) -> None:\n        self._validator = validator or DateValidator()\n\n    def change_date_format(self, date_str: str) -> str:\n        \"\"\"Validates and converts the date string to 'dd-mm-yyyy'.\"\"\"\n        date_model = self._validator.validate(date_str)\n        return date_model.to_dd_mm_yyyy()\n\nclass DateController:\n    \"\"\"Coordinates date formatting requests.\"\"\"\n    def __init__(self, service: Optional[DateService] = None) -> None:\n        self._service = service or DateService(validator=DateValidator())\n\n    def format_date(self, date_str: str) -> str:\n        \"\"\"Delegates date formatting to the service layer.\"\"\"\n        return self._service.change_date_format(date_str)\n\n_default_controller = DateController(service=DateService(validator=DateValidator()))\n\ndef change_date_format(date_str: str) -> str:\n    \"\"\"\n    Convert a date of yyyy-mm-dd format to dd-mm-yyyy format.\n    \"\"\"\n    return _default_controller.format_date(date_str)"}
{"task_id": "Mbpp/429", "solution": "from typing import Sequence\n\ndef and_tuples(a: Sequence[int], b: Sequence[int]) -> tuple[int, ...]:\n    \"\"\"\n    Computes the elementwise bitwise AND of two sequences of integers.\n    The operation proceeds up to the length of the shorter input sequence.\n    \"\"\"\n    n = min(len(a), len(b))\n    return tuple(a[i] & b[i] for i in range(n))"}
