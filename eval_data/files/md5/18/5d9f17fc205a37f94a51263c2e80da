{"task_id": "Mbpp/285", "solution": "import re\nfrom typing import Optional, Any, Dict\n\nclass Config:\n    \"\"\"Configuration constants for pattern matching.\"\"\"\n    DEFAULT_PATTERN: str = \"a(?:bb|bbb)\"\n\nclass PatternError(Exception):\n    \"\"\"Custom exception for pattern matching errors.\"\"\"\n    def __init__(self, message: str, cause: Exception = None) -> None:\n        super().__init__(message)\n        self.cause = cause\n\nclass PatternMatchResult:\n    \"\"\"Data Transfer Object for pattern match results.\"\"\"\n    def __init__(self, success: bool, matched_substring: Optional[str], index: Optional[int]) -> None:\n        self.success = success\n        self.matched_substring = matched_substring\n        self.index = index\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Returns a dictionary representation of the result.\"\"\"\n        return {\n            \"success\": self.success,\n            \"matched_substring\": self.matched_substring,\n            \"index\": self.index\n        }\n\nclass TextValidators:\n    \"\"\"Utility class for validating text inputs.\"\"\"\n    @staticmethod\n    def validate_text(text: Any) -> str:\n        \"\"\"Ensures text is a valid string, decoding bytes if necessary.\"\"\"\n        if text is None:\n            raise PatternError(\"Input text is None\")\n        if isinstance(text, bytes):\n            try:\n                text = text.decode(\"utf-8\")\n            except Exception as e:\n                raise PatternError(\"Could not decode bytes to str\", cause=e)\n        if not isinstance(text, str):\n            raise PatternError(f\"Unsupported input type: {type(text)}\")\n        return text\n\nclass RegexAdapter:\n    \"\"\"Encapsulates regex matching implementation.\"\"\"\n    def __init__(self, pattern: str) -> None:\n        try:\n            self._compiled = re.compile(pattern)\n        except re.error as e:\n            raise PatternError(f\"Invalid pattern: {pattern}\", cause=e)\n\n    def match_pattern(self, text: str) -> PatternMatchResult:\n        \"\"\"Searches for the compiled pattern in the given text.\"\"\"\n        m = self._compiled.search(text)\n        if m:\n            return PatternMatchResult(success=True, matched_substring=m.group(0), index=m.start())\n        return PatternMatchResult(success=False, matched_substring=None, index=None)\n\nclass PatternService:\n    \"\"\"Business logic for pattern matching.\"\"\"\n    def __init__(self, adapter: RegexAdapter) -> None:\n        self._adapter = adapter\n\n    def match(self, text: str) -> PatternMatchResult:\n        \"\"\"Delegates pattern matching to the injected adapter.\"\"\"\n        return self._adapter.match_pattern(text)\n\nclass PatternController:\n    \"\"\"Handles API-level input validation and orchestrates pattern matching.\"\"\"\n    def __init__(self, service: PatternService) -> None:\n        self._service = service\n\n    def match_text(self, text: Any) -> bool:\n        \"\"\"Validates input, performs pattern matching, and returns a boolean result.\"\"\"\n        validated_text = TextValidators.validate_text(text)\n        result = self._service.match(validated_text)\n        return result.success\n\ndef text_match_two_three(text: str) -> bool:\n    \"\"\"Checks whether a string contains the 'a' character followed by two or three 'b' characters.\"\"\"\n    adapter = RegexAdapter(Config.DEFAULT_PATTERN)\n    service = PatternService(adapter)\n    controller = PatternController(service)\n    return controller.match_text(text)"}
{"task_id": "Mbpp/290", "solution": "import json\nfrom typing import List, Any, Tuple, Optional, Iterator, Union\nfrom pathlib import Path\n\nclass InvalidInputError(ValueError):\n    \"\"\"Raised when the input data structure is invalid.\"\"\"\n    pass\n\nclass RepositoryError(Exception):\n    \"\"\"Raised for issues during data repository operations.\"\"\"\n    pass\n\nclass ResultDTO:\n    \"\"\"Data transfer object for the maximum length list result.\"\"\"\n    def __init__(self, length: int, longest: List[Any]) -> None:\n        self.length = length\n        self.longest = list(longest)\n\n    def to_tuple(self) -> Tuple[int, List[Any]]:\n        \"\"\"Converts the DTO to a tuple of (length, longest_list).\"\"\"\n        return (self.length, list(self.longest))\n\n    def to_json(self) -> str:\n        \"\"\"Converts the DTO to a JSON string.\"\"\"\n        return json.dumps({\"length\": self.length, \"longest\": self.longest})\n\nclass Validator:\n    \"\"\"Utility class for validating input data structures.\"\"\"\n    @staticmethod\n    def validate_outer_list(data: Any) -> None:\n        \"\"\"Ensures the top-level data is a list.\"\"\"\n        if not isinstance(data, list):\n            raise InvalidInputError(\"Expected an outer list of lists.\")\n\n    @staticmethod\n    def validate_inner_lists(data: List[Any]) -> None:\n        \"\"\"Ensures each element within the outer list is also a list.\"\"\"\n        for idx, item in enumerate(data):\n            if not isinstance(item, list):\n                raise InvalidInputError(f\"Inner element at index {idx} is not a list.\")\n\nclass MaxLengthService:\n    \"\"\"Service to find the list of maximum length in a list of lists.\"\"\"\n    def __init__(self, validator: Validator) -> None:\n        self._validator = validator\n\n    def find_max(self, lists: List[List[Any]]) -> ResultDTO:\n        \"\"\"\n        Finds the list with the maximum length from a list of lists.\n        Handles validation, empty input, and stable tie-breaking (first encountered).\n        \"\"\"\n        self._validator.validate_outer_list(lists)\n        self._validator.validate_inner_lists(lists)\n\n        if not lists:\n            return ResultDTO(0, [])\n\n        best_list = lists[0]\n        max_len = len(best_list)\n\n        for lst in lists[1:]:\n            current_len = len(lst)\n            if current_len > max_len:\n                max_len = current_len\n                best_list = lst\n        \n        return ResultDTO(max_len, best_list)\n\ndef max_length(lists: List[List[Any]]) -> Tuple[int, List[Any]]:\n    \"\"\"\n    Finds the list of maximum length in a list of lists.\n    Returns a tuple containing the maximum length and the first encountered list of that length.\n    \"\"\"\n    validator = Validator()\n    service = MaxLengthService(validator)\n    result = service.find_max(lists)\n    return result.to_tuple()"}
{"task_id": "Mbpp/286", "solution": "def max_sub_array_sum_repeated(arr: list[int], k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in the modified array\n    formed by repeating the given array k times.\n    \"\"\"\n    def _max_subarray(current_arr: list[int]) -> int:\n        \"\"\"Standard Kadane's algorithm for a single array.\"\"\"\n        max_ending_here = current_arr[0]\n        max_so_far = current_arr[0]\n        for x in current_arr[1:]:\n            max_ending_here = max(x, max_ending_here + x)\n            max_so_far = max(max_so_far, max_ending_here)\n        return max_so_far\n\n    def _max_prefix_sum(current_arr: list[int]) -> int:\n        \"\"\"Calculates the maximum prefix sum of an array.\"\"\"\n        best = current = current_arr[0]\n        for x in current_arr[1:]:\n            current += x\n            best = max(best, current)\n        return best\n\n    def _max_suffix_sum(current_arr: list[int]) -> int:\n        \"\"\"Calculates the maximum suffix sum of an array.\"\"\"\n        best = current = current_arr[-1]\n        for x in reversed(current_arr[:-1]):\n            current += x\n            best = max(best, current)\n        return best\n\n    if k == 1:\n        return _max_subarray(arr)\n\n    # For k > 1, the maximum subarray can span across repetitions.\n    # It can be either entirely within two repetitions, or a combination of suffix, (k-2)*total, and prefix sums.\n    max_for_two_arrays = _max_subarray(arr + arr)\n    total_sum_of_arr = sum(arr)\n\n    if total_sum_of_arr > 0:\n        # If the total sum is positive, repeating the array can increase the max sum.\n        # The maximum sum could be a full segment (k-2 times total_sum) plus a prefix and a suffix.\n        max_sum_from_prefix = _max_prefix_sum(arr)\n        max_sum_from_suffix = _max_suffix_sum(arr)\n        return max(max_for_two_arrays, max_sum_from_prefix + max_sum_from_suffix + (k - 2) * total_sum_of_arr)\n    else:\n        # If the total sum is non-positive, repeating the array more than twice won't increase the max sum.\n        return max_for_two_arrays"}
{"task_id": "Mbpp/294", "solution": "from typing import Union\n\nclass MaxFinderError(Exception):\n    pass\n\nclass InvalidInputError(MaxFinderError):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass NoNumericValuesError(MaxFinderError):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\n\ndef max_val(values: list) -> Union[int, float]:\n    \"\"\"\n    Finds the maximum numeric value in a heterogeneous list, ignoring non-numeric and boolean values.\n    Raises InvalidInputError if input is not a list/tuple or NoNumericValuesError if no numeric values are found.\n    \"\"\"\n    if not isinstance(values, (list, tuple)):\n        raise InvalidInputError(\"Expected list or tuple.\")\n\n    numerics = [v for v in values if isinstance(v, (int, float)) and not isinstance(v, bool)]\n\n    if not numerics:\n        raise NoNumericValuesError(\"No numeric values found.\")\n\n    best = numerics[0]\n    for v in numerics[1:]:\n        if v > best:\n            best = v\n    return best"}
{"task_id": "Mbpp/296", "solution": "import collections\nfrom typing import List, Tuple\n\ndef get_Inv_Count(arr: List[int]) -> int:\n    \"\"\"\n    Counts inversions in an array using the merge-sort algorithm.\n    An inversion is a pair of indices (i, j) such that i < j and arr[i] > arr[j].\n    \"\"\"\n    \n    def merge_and_count(left_half: List[int], right_half: List[int]) -> Tuple[List[int], int]:\n        \"\"\"\n        Merges two sorted lists and counts split inversions during the merge process.\n        \"\"\"\n        merged_list = []\n        inversions = 0\n        i, j = 0, 0\n        \n        while i < len(left_half) and j < len(right_half):\n            if left_half[i] <= right_half[j]:\n                merged_list.append(left_half[i])\n                i += 1\n            else:\n                merged_list.append(right_half[j])\n                j += 1\n                # When an element from the right half is taken,\n                # it means it's smaller than all remaining elements in the left_half.\n                inversions += len(left_half) - i\n        \n        merged_list.extend(left_half[i:])\n        merged_list.extend(right_half[j:])\n        \n        return merged_list, inversions\n\n    def sort_and_count(sub_arr: List[int]) -> Tuple[List[int], int]:\n        \"\"\"\n        Recursively sorts a sub-array and counts inversions within its halves and splits.\n        \"\"\"\n        n = len(sub_arr)\n        if n <= 1:\n            return sub_arr, 0\n        \n        mid = n // 2\n        left_sorted, left_inversions = sort_and_count(sub_arr[:mid])\n        right_sorted, right_inversions = sort_and_count(sub_arr[mid:])\n        \n        merged_list, split_inversions = merge_and_count(left_sorted, right_sorted)\n        \n        return merged_list, left_inversions + right_inversions + split_inversions\n\n    # Create a copy of the input array to avoid modifying the original list.\n    _, total_inversions = sort_and_count(list(arr))\n    return total_inversions"}
{"task_id": "Mbpp/292", "solution": "class DivisionByZeroError(Exception):\n    \"\"\"Raised when the denominator is zero in a division operation.\"\"\"\n    pass\n\nclass InvalidInputError(Exception):\n    \"\"\"Raised when inputs are not valid integers or convertible to integers.\"\"\"\n    pass\n\ndef find(numerator: int, denominator: int) -> int:\n    \"\"\"\n    Computes the floor division of two numbers, rounded down to the nearest integer.\n    Validates inputs and raises specific exceptions for invalid cases.\n    \"\"\"\n    try:\n        n = int(numerator)\n        d = int(denominator)\n    except (TypeError, ValueError):\n        raise InvalidInputError(\"numerator and denominator must be integers or convertible to integers\")\n\n    if d == 0:\n        raise DivisionByZeroError(\"denominator must not be zero\")\n\n    return n // d"}
{"task_id": "Mbpp/301", "solution": "import collections\n\ndef dict_depth(data):\n    \"\"\"\n    Computes the maximum nesting depth of a dictionary.\n    The top-level dictionary counts as depth 1.\n    \"\"\"\n    if not isinstance(data, dict):\n        return 0 # Should not happen if upstream validator is used, but handles non-dict roots for recursive calls\n\n    max_depth = 1\n    for value in data.values():\n        if isinstance(value, dict):\n            max_depth = max(max_depth, 1 + dict_depth(value))\n    return max_depth"}
{"task_id": "Mbpp/297", "solution": "from typing import List, Any\n\ndef flatten_list(input_list: List[Any]) -> List[Any]:\n    \"\"\"\n    Flattens a given nested list structure into a single-level list.\n    Preserves the left-to-right order of elements using an iterative stack.\n    \"\"\"\n    flattened_result = []\n    # Initialize stack by pushing elements of the input_list in reverse order.\n    # This ensures that when popped, they are processed from left-to-right.\n    stack = list(reversed(input_list)) \n\n    while stack:\n        current_item = stack.pop()\n        \n        # If the item is a list, push its elements onto the stack in reverse order.\n        # This continues the left-to-right processing for nested lists.\n        if isinstance(current_item, list):\n            # Using extend with reversed is efficient for pushing multiple items.\n            stack.extend(reversed(current_item))\n        else:\n            # If the item is not a list, it's a base element, append to result.\n            flattened_result.append(current_item)\n            \n    return flattened_result"}
{"task_id": "Mbpp/299", "solution": "import collections\nfrom typing import List, Tuple, Union, Any\n\ndef max_aggregate(records: List[Tuple[Any, Union[int, float]]]) -> Union[Tuple[Any, Union[int, float]], None]:\n    \"\"\"\n    Calculates the maximum aggregate sum from a list of (name, value) tuples.\n    Returns the name and its total sum, handling ties by first occurrence.\n    \"\"\"\n    if not records:\n        return None\n\n    # Stores the sum of values for each name.\n    aggregates = collections.defaultdict(float)\n    # Stores the first index at which each name appeared, for tie-breaking.\n    first_occurrence_index = {}\n\n    for i, (name, value) in enumerate(records):\n        str_name = str(name)\n        num_value = float(value)\n\n        aggregates[str_name] += num_value\n        \n        if str_name not in first_occurrence_index:\n            first_occurrence_index[str_name] = i\n\n    max_name = None\n    max_total = -float('inf')\n    max_idx = float('inf')\n\n    for name, total in aggregates.items():\n        current_idx = first_occurrence_index[name]\n\n        if total > max_total:\n            max_total = total\n            max_name = name\n            max_idx = current_idx\n        elif total == max_total:\n            if current_idx < max_idx:\n                max_name = name\n                max_idx = current_idx\n    \n    if max_name is not None:\n        # Return total as int if it's an integral float (e.g., 212.0 -> 212).\n        if max_total.is_integer():\n            return (max_name, int(max_total))\n        else:\n            return (max_name, max_total)\n    else:\n        return None"}
{"task_id": "Mbpp/300", "solution": "import math\n\ndef count_binary_seq(n: int) -> int:\n    \"\"\"\n    Calculates the count of all binary sequences of length 2n such that the sum of the first\n    n bits equals the sum of the last n bits. This count is given by the central binomial\n    coefficient C(2n, n).\n    \"\"\"\n    # math.comb is available since Python 3.8 and is efficient for large numbers.\n    return math.comb(2 * n, n)"}
{"task_id": "Mbpp/305", "solution": "import re\n\ndef start_withp(words: list[str]) -> tuple[str, str]:\n    \"\"\"\n    Returns two words from a list of strings that start with 'p' (case-insensitive).\n    Raises ValueError if fewer than two such words are found.\n    \"\"\"\n    TOKEN_PATTERN = r\"[A-Za-z0-9_-]+\"\n    p_words = []\n\n    for text_block in words:\n        tokens = re.findall(TOKEN_PATTERN, text_block)\n        for token in tokens:\n            if token and token[0].lower() == 'p':\n                p_words.append(token)\n            if len(p_words) == 2:\n                return (p_words[0], p_words[1])\n\n    raise ValueError(\"fewer than two words starting with 'p' found\")"}
{"task_id": "Mbpp/293", "solution": "import math\n\ndef otherside_rightangle(a, b):\n    \"\"\"\n    Calculates the hypotenuse of a right-angled triangle given the lengths of its two legs.\n    It assumes 'a' and 'b' are the lengths of the legs.\n    \"\"\"\n    return math.sqrt(a**2 + b**2)"}
{"task_id": "Mbpp/306", "solution": "from typing import List\n\ndef max_sum_increasing_subseq(arr: List[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from arr[0..i]\n    that also includes arr[k] (where k > i).\n    \"\"\"\n    # DP array to store the maximum sum of an increasing subsequence\n    # ending at each index j within the prefix arr[0...i].\n    # Initialize dp[j] with arr[j] itself, as it's the smallest possible\n    # increasing subsequence ending at j.\n    dp = list(arr[:i + 1])\n\n    # Compute MSIS for the prefix arr[0...i]\n    for current_idx in range(1, i + 1):\n        for prev_idx in range(current_idx):\n            if arr[current_idx] > arr[prev_idx]:\n                dp[current_idx] = max(dp[current_idx], dp[prev_idx] + arr[current_idx])\n\n    # Find the maximum sum from dp[0...i] such that the corresponding\n    # element arr[j] is strictly less than arr[k].\n    max_prefix_sum_before_k = 0\n    for j in range(i + 1):\n        if arr[j] < arr[k]:\n            max_prefix_sum_before_k = max(max_prefix_sum_before_k, dp[j])\n\n    # The result is the best found prefix sum plus arr[k].\n    # If no prefix element satisfies arr[j] < arr[k], max_prefix_sum_before_k\n    # remains 0, and the result correctly becomes arr[k] (single element subsequence).\n    return max_prefix_sum_before_k + arr[k]"}
