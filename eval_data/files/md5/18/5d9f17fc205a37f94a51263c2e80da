{"task_id": "Mbpp/454", "solution": "import re\nfrom typing import List, Optional, Dict, Any\n\n# Define necessary classes inline to avoid circular imports during completion\n# In a real project, these would be in separate files as per design context.\n\nclass TextMatcherError(Exception):\n    \"\"\"Base exception for the textmatcher package.\"\"\"\n    pass\n\nclass PatternSyntaxError(TextMatcherError):\n    \"\"\"Raised for invalid regex patterns.\"\"\"\n    pass\n\nclass PatternValidator:\n    \"\"\"Utility to validate regex patterns.\"\"\"\n    @staticmethod\n    def validate(pattern: str) -> None:\n        \"\"\"Ensures the pattern is non-empty and compiles, raising PatternSyntaxError if invalid.\"\"\"\n        if not pattern:\n            raise PatternSyntaxError(\"Pattern cannot be empty.\")\n        try:\n            re.compile(pattern)\n        except re.error as e:\n            raise PatternSyntaxError(f\"Invalid regex pattern: {e}\") from e\n\nclass WordMatchRequest:\n    \"\"\"Request DTO for matching operation.\"\"\"\n    def __init__(self, text: str, pattern: Optional[str] = None) -> None:\n        self.text: str = text if text is not None else \"\"\n        self.pattern: Optional[str] = pattern\n\nclass MatchResult:\n    \"\"\"Response DTO for matching operation.\"\"\"\n    def __init__(self, matched: bool, matches: List[str]) -> None:\n        self.matched: bool = matched\n        self.matches: List[str] = matches\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Converts the result to a JSON-serializable dictionary.\"\"\"\n        return {\"matched\": self.matched, \"matches\": self.matches}\n\nclass RegexRepository:\n    \"\"\"Compiles and runs regex matches, encapsulating pattern/flag behavior.\"\"\"\n    DEFAULT_PATTERN: str = r'\\b\\w*z\\w*\\b'\n    DEFAULT_FLAGS: int = re.IGNORECASE\n\n    def compile(self, pattern: Optional[str] = None, flags: Optional[int] = None) -> re.Pattern:\n        \"\"\"Compiles the given pattern with flags, validating it via PatternValidator.\"\"\"\n        pat = pattern or self.DEFAULT_PATTERN\n        fl = flags if flags is not None else self.DEFAULT_FLAGS\n        PatternValidator.validate(pat)\n        try:\n            return re.compile(pat, fl)\n        except re.error as e:\n            raise PatternSyntaxError(str(e)) from e\n\n    def find_matches(self, text: str, pattern: Optional[str] = None, flags: Optional[int] = None) -> List[str]:\n        \"\"\"Returns non-overlapping matches from the text as they appear in order.\"\"\"\n        regex = self.compile(pattern, flags)\n        return regex.findall(text or \"\")\n\nclass MatchService:\n    \"\"\"Orchestrates validation and matching, returning DTO results.\"\"\"\n    def __init__(self, repo: RegexRepository) -> None:\n        self._repo: RegexRepository = repo\n\n    def match(self, request: WordMatchRequest) -> MatchResult:\n        \"\"\"Validates the request, calls the repository, and produces a MatchResult.\"\"\"\n        found_matches = self._repo.find_matches(request.text, request.pattern)\n        matched = bool(found_matches)\n        return MatchResult(matched, found_matches)\n\nclass MatchController:\n    \"\"\"Provides a simple API surface for callers.\"\"\"\n    def __init__(self, service: MatchService) -> None:\n        self._service: MatchService = service\n\n    def handle_match(self, text: str, pattern: Optional[str] = None) -> MatchResult:\n        \"\"\"Creates a WordMatchRequest, calls the service.match, and returns a MatchResult.\"\"\"\n        request = WordMatchRequest(text, pattern)\n        return self._service.match(request)\n\n# Global instances for the convenience function\n_repo = RegexRepository()\n_service = MatchService(_repo)\n_controller = MatchController(_service)\n\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"\n    Convenience function that matches a word containing 'z' (case-insensitive).\n    It uses the default pattern and returns a boolean indicating a match.\n    \"\"\"\n    result = _controller.handle_match(text)\n    return result.matched"}
