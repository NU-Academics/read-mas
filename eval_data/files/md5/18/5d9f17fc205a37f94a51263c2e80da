{"task_id": "Mbpp/422", "solution": "import logging\nfrom dataclasses import dataclass\nfrom datetime import datetime\nfrom typing import Any, List\nimport uuid\n\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass Validator:\n    \"\"\"Utility class for input validation.\"\"\"\n    @staticmethod\n    def validate_n(n: Any) -> None:\n        \"\"\"Validates that n is an integer and >= 1.\"\"\"\n        if not isinstance(n, int):\n            raise InvalidInputError(f\"n must be an int, got {type(n).__name__}\")\n        if n < 1:\n            raise InvalidInputError(\"n must be >= 1\")\n\n@dataclass\nclass ComputeRequest:\n    \"\"\"Data transfer object for a computation request.\"\"\"\n    n: int\n\n@dataclass\nclass ComputeResult:\n    \"\"\"Data transfer object for a computation result.\"\"\"\n    id: str\n    n: int\n    result: float\n    timestamp: datetime\n\n    def to_dict(self) -> dict:\n        return {\"id\": self.id, \"n\": self.n, \"result\": self.result, \"timestamp\": self.timestamp.isoformat()}\n\nclass ComputationRepository:\n    \"\"\"Abstract base class for storing computation results.\"\"\"\n    def save(self, result: 'ComputeResult') -> None:\n        raise NotImplementedError\n\n    def list_all(self) -> List['ComputeResult']:\n        raise NotImplementedError\n\nclass InMemoryComputationRepository(ComputationRepository):\n    \"\"\"In-memory implementation of ComputationRepository.\"\"\"\n    def __init__(self):\n        self._store: list['ComputeResult'] = []\n\n    def save(self, result: 'ComputeResult') -> None:\n        self._store.append(result)\n\n    def list_all(self) -> List['ComputeResult']:\n        return list(self._store)\n\nclass CubeCalculatorService:\n    \"\"\"Service for calculating the average of cubes and persisting results.\"\"\"\n    def __init__(self, repo: ComputationRepository):\n        self._repo = repo\n\n    def _formula_average(self, n: int) -> float:\n        \"\"\"Calculates the average of cubes using the closed-form formula.\"\"\"\n        # Average = n * (n + 1)^2 / 4\n        return (n * (n + 1) * (n + 1)) / 4.0\n\n    def compute_average(self, request: ComputeRequest) -> ComputeResult:\n        \"\"\"Computes the average and saves the result to the repository.\"\"\"\n        result_value = float(self._formula_average(request.n))\n        result = ComputeResult(id=str(uuid.uuid4()), n=request.n, result=result_value, timestamp=datetime.utcnow())\n        try:\n            self._repo.save(result)\n        except Exception:\n            logging.exception(\"Failed to save computation result\")\n        return result\n\nclass CLIController:\n    \"\"\"Controller for handling command-line interface requests.\"\"\"\n    def __init__(self, service: CubeCalculatorService):\n        self._service = service\n\n    def compute_and_return(self, n: int) -> float:\n        \"\"\"Validates input, computes the average, and returns the result.\"\"\"\n        Validator.validate_n(n)\n        req = ComputeRequest(n=n)\n        result = self._service.compute_average(req)\n        return result.result\n\ndef find_Average_Of_Cube(n: int) -> float:\n    \"\"\"\n    Finds the average of cubes of the first n natural numbers.\n    This function initializes necessary components and delegates the computation.\n    \"\"\"\n    repo = InMemoryComputationRepository()\n    svc = CubeCalculatorService(repo)\n    controller = CLIController(svc)\n    return controller.compute_and_return(n)"}
{"task_id": "Mbpp/425", "solution": "def count_element_in_list(lists, element):\n    \"\"\"\n    Counts the number of sublists in a list of lists that contain a particular element.\n    Each sublist is counted at most once, even if the element appears multiple times within it.\n    \"\"\"\n    count = 0\n    for sublist in lists:\n        if element in sublist:\n            count += 1\n    return count"}
