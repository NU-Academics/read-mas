{"task_id": "Mbpp/270", "solution": "from typing import List\n\ndef sum_even_and_even_index(nums: List[int]) -> int:\n    \"\"\"\n    Calculates the sum of even numbers found at even positions (0-based) in a list.\n    Assumes the input list contains only integers.\n    \"\"\"\n    total = 0\n    for i, num in enumerate(nums):\n        if i % 2 == 0 and num % 2 == 0:\n            total += num\n    return total"}
{"task_id": "Mbpp/269", "solution": "class InvalidCharacterError(Exception):\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\n\n    def __str__(self) -> str:\n        return self.message\n\nclass Utils:\n    @staticmethod\n    def is_printable_char(char: str) -> bool:\n        \"\"\"Checks if a character is printable and a single string.\"\"\"\n        return bool(char) and isinstance(char, str) and char.isprintable()\n\nclass CharValidator:\n    MAX_CHAR_LENGTH: int = 1\n\n    def validate(self, char: str) -> bool:\n        \"\"\"Validates if the input is a single, printable character string.\"\"\"\n        if not isinstance(char, str):\n            return False\n        if len(char) != self.MAX_CHAR_LENGTH:\n            return False\n        return Utils.is_printable_char(char)\n\n    def validate_or_raise(self, char: str) -> None:\n        \"\"\"Validates a character, raising InvalidCharacterError on failure.\"\"\"\n        if not self.validate(char):\n            raise InvalidCharacterError(f\"Invalid character input: {repr(char)}\")\n\nclass AsciiService:\n    def __init__(self, validator: CharValidator):\n        self._validator = validator\n\n    def get_ascii(self, char: str) -> int:\n        \"\"\"Gets the ASCII (Unicode) value of a single character after validation.\"\"\"\n        self._validator.validate_or_raise(char)\n        return ord(char)\n\nclass AsciiAPI:\n    def __init__(self, service: AsciiService = None):\n        \"\"\"Initializes the API with an optional AsciiService instance.\"\"\"\n        self._service = service or AsciiService(CharValidator())\n\n    def ascii_value(self, char: str) -> int:\n        \"\"\"Returns the ASCII (Unicode) value of a character.\"\"\"\n        return self._service.get_ascii(char)\n\n_api = AsciiAPI()\ndef ascii_value(char: str) -> int:\n    \"\"\"Finds the ASCII (Unicode) value of a character.\"\"\"\n    return _api.ascii_value(char)"}
{"task_id": "Mbpp/271", "solution": "import functools\n\n# Global dictionary for in-memory caching as per design context for the top-level function.\n_even_power_sum_cache = {}\n\ndef even_Power_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the first n even natural numbers each raised to the fifth power.\n    Uses a simple in-memory cache for repeated calls with the same n.\n    \"\"\"\n    if n in _even_power_sum_cache:\n        return _even_power_sum_cache[n]\n\n    total = 0\n    for k in range(1, n + 1):\n        even_number = 2 * k\n        total += even_number ** 5\n    \n    _even_power_sum_cache[n] = total\n    return total"}
