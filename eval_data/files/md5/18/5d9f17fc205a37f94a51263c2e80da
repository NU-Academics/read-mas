{"task_id": "Mbpp/308", "solution": "import heapq\nfrom typing import List, Sequence, Dict, Any, Iterator, Tuple\n\ndef large_product(a: Sequence[float], b: Sequence[float], k: int) -> List[float]:\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list.\n    \"\"\"\n\n    def _to_number_list(seq: Sequence[Any]) -> List[float]:\n        \"\"\"Converts a sequence to a list of floats.\"\"\"\n        return [float(x) for x in seq]\n\n    def _sort_and_group(arr: Sequence[float]) -> Dict[str, Any]:\n        \"\"\"\n        Groups numbers into positive (desc), negative (asc), and zero count.\n        Returns: {\"pos\": List[float], \"neg\": List[float], \"zero_count\": int}\n        \"\"\"\n        pos = sorted([x for x in arr if x > 0], reverse=True)\n        neg = sorted([x for x in arr if x < 0]) # e.g., -10, -3, -1 (ascending by value)\n        zero_count = sum(1 for x in arr if x == 0)\n        return {\"pos\": pos, \"neg\": neg, \"zero_count\": zero_count}\n\n    def _top_k_from_group_iterator(\n        a_sorted: Sequence[float],\n        b_sorted: Sequence[float]\n    ) -> Iterator[float]:\n        \"\"\"\n        Given two sequences sorted in descending order (values that produce non-negative products),\n        yields products in descending order using a max-heap of candidate indices.\n        \"\"\"\n        if not a_sorted or not b_sorted:\n            return\n\n        # Max-heap stores (-product, i, j) to simulate max-heap with heapq (min-heap)\n        heap: List[Tuple[float, int, int]] = []\n        visited = set() # Store (i, j) tuples to prevent duplicate pushes\n\n        # Initial candidate: product of largest elements from both lists\n        initial_i, initial_j = 0, 0\n        initial_product = a_sorted[initial_i] * b_sorted[initial_j]\n        heapq.heappush(heap, (-initial_product, initial_i, initial_j))\n        visited.add((initial_i, initial_j))\n\n        while heap:\n            neg_prod, i, j = heapq.heappop(heap)\n            yield -neg_prod # Yield the actual product\n\n            # Explore neighbors: (i+1, j) and (i, j+1)\n            if i + 1 < len(a_sorted) and (i + 1, j) not in visited:\n                next_prod = a_sorted[i + 1] * b_sorted[j]\n                heapq.heappush(heap, (-next_prod, i + 1, j))\n                visited.add((i + 1, j))\n\n            if j + 1 < len(b_sorted) and (i, j + 1) not in visited:\n                next_prod = a_sorted[i] * b_sorted[j + 1]\n                heapq.heappush(heap, (-next_prod, i, j + 1))\n                visited.add((i, j + 1))\n\n    def _merge_top_k_iters(\n        iters: Sequence[Iterator[float]],\n        limit_k: int\n    ) -> List[float]:\n        \"\"\"\n        Merges multiple descending iterators into a single top-k sorted descending list.\n        \"\"\"\n        merged_results: List[float] = []\n        # Min-heap to store (-value, unique_id, iterator)\n        # Unique_id is used to break ties if values are equal but iterators are distinct.\n        priority_queue: List[Tuple[float, int, Iterator[float]]] = []\n\n        # Initialize heap with the first element from each iterator\n        for i, it in enumerate(iters):\n            try:\n                first_val = next(it)\n                heapq.heappush(priority_queue, (-first_val, i, it))\n            except StopIteration:\n                pass # Iterator was empty\n\n        while priority_queue and len(merged_results) < limit_k:\n            neg_val, _, current_iter = heapq.heappop(priority_queue)\n            merged_results.append(-neg_val)\n\n            # Try to get the next value from the iterator that just yielded\n            try:\n                next_val = next(current_iter)\n                heapq.heappush(priority_queue, (-next_val, _, current_iter))\n            except StopIteration:\n                pass # Iterator is exhausted\n        return merged_results\n\n    a_floats = _to_number_list(a)\n    b_floats = _to_number_list(b)\n\n    if k == 0 or not a_floats or not b_floats:\n        return []\n\n    total_combinations = len(a_floats) * len(b_floats)\n    DEFAULT_MAX_FALLBACK = 100000 # As specified in design context\n\n    if total_combinations <= DEFAULT_MAX_FALLBACK or k >= total_combinations:\n        all_products = [x * y for x in a_floats for y in b_floats]\n        all_products.sort(reverse=True)\n        return all_products[:k]\n\n    ga = _sort_and_group(a_floats)\n    gb = _sort_and_group(b_floats)\n\n    candidate_streams: List[Iterator[float]] = []\n\n    if ga['pos'] and gb['pos']:\n        candidate_streams.append(_top_k_from_group_iterator(ga['pos'], gb['pos']))\n\n    if ga['neg'] and gb['neg']:\n        neg_a_abs_desc = sorted([abs(x) for x in ga['neg']], reverse=True)\n        neg_b_abs_desc = sorted([abs(x) for x in gb['neg']], reverse=True)\n        candidate_streams.append(_top_k_from_group_iterator(neg_a_abs_desc, neg_b_abs_desc))\n\n    top_k_products = _merge_top_k_iters(candidate_streams, k)\n\n    # Handle zero products if k is not fully satisfied by positive products\n    # and a zero product is possible (any zero in one list, and any number in the other).\n    has_zero_in_a = ga['zero_count'] > 0\n    has_zero_in_b = gb['zero_count'] > 0\n    \n    # A non-zero factor in the other list is required to form a product that isn't just (0 * 0)\n    has_non_zero_in_a = bool(ga['pos'] or ga['neg'])\n    has_non_zero_in_b = bool(gb['pos'] or gb['neg'])\n\n    zero_product_possible = False\n    if has_zero_in_a and (has_non_zero_in_b or has_zero_in_b):\n        zero_product_possible = True\n    elif has_zero_in_b and (has_non_zero_in_a or has_zero_in_a):\n        zero_product_possible = True\n\n    if zero_product_possible and len(top_k_products) < k:\n        while len(top_k_products) < k:\n            top_k_products.append(0.0)\n\n    return top_k_products[:k]"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n):\n    \"\"\"\n    Finds the highest power of 2 that is less than or equal to n.\n    Returns 0 if n is 0.\n    \"\"\"\n    if n == 0:\n        return 0\n    # n.bit_length() returns the number of bits required to represent n in binary,\n    # excluding the sign and leading zeros.\n    # For example, 10 (1010 in binary) has bit_length() == 4.\n    # The MSB is at index (bit_length - 1). For 10, index is 3.\n    msb_index = n.bit_length() - 1\n    # 1 << msb_index calculates 2 raised to the power of msb_index.\n    return 1 << msb_index"}
{"task_id": "Mbpp/312", "solution": "import math\n\ndef volume_cone(radius: float, height: float) -> float:\n    \"\"\"\n    Calculates the volume of a right circular cone.\n    The formula used is (1/3) * pi * radius^2 * height.\n    \"\"\"\n    return (1/3) * math.pi * (radius ** 2) * height"}
{"task_id": "Mbpp/310", "solution": "class StringTuple:\n    \"\"\"A data transfer object to encapsulate a string and provide a tuple-of-character representation.\"\"\"\n    def __init__(self, value: str) -> None:\n        self._value = value\n\n    def as_tuple(self) -> tuple[str, ...]:\n        \"\"\"Returns the encapsulated string as a tuple of characters.\"\"\"\n        return tuple(self._value)\n\nclass StringConverterService:\n    \"\"\"Core domain logic for converting any acceptable input into a tuple of characters.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def to_tuple(self, value: str | object) -> tuple[str, ...]:\n        \"\"\"Converts a given value to a tuple of characters.\"\"\"\n        normalized = str(value)\n        return tuple(normalized)\n\nclass StringController:\n    \"\"\"Orchestrates service usage and returns the StringTuple DTO.\"\"\"\n    def __init__(self, service: StringConverterService) -> None:\n        self.service = service\n\n    def convert(self, value: str | object) -> StringTuple:\n        \"\"\"Converts the input value to a StringTuple.\"\"\"\n        chars = self.service.to_tuple(value)\n        return StringTuple(\"\".join(chars))\n\ndef string_to_tuple(value: str | object) -> tuple[str, ...]:\n    \"\"\"Converts a given string to a tuple of characters.\"\"\"\n    svc = StringConverterService()\n    ctrl = StringController(svc)\n    return ctrl.convert(value).as_tuple()"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    \"\"\"\n    Sets the left-most (most significant) unset bit of a non-negative integer n.\n    The left-most unset bit is the most significant 0-bit within the active bit length of n,\n    or the next higher bit if all bits up to the current highest are already set.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Calculate a mask with only the highest set bit of n\n    # e.g., for n=10 (0b1010), bit_length is 4, highest_bit_mask is 1 << (4-1) = 8 (0b1000)\n    highest_bit_mask = 1 << (n.bit_length() - 1)\n\n    # Calculate a mask with all ones up to the highest bit position of n\n    # e.g., for n=10 (0b1010), bit_length is 4, all_ones_mask is (1 << 4) - 1 = 15 (0b1111)\n    # e.g., for n=7 (0b111), bit_length is 3, all_ones_mask is (1 << 3) - 1 = 7 (0b111)\n    all_ones_mask = (1 << n.bit_length()) - 1\n\n    if n == all_ones_mask:\n        # If n consists of all ones up to its highest bit (e.g., 0b11, 0b111),\n        # the \"left-most unset bit\" is effectively the next higher bit.\n        # This is achieved by setting the bit at position n.bit_length().\n        # For n=7 (0b111), highest_bit_mask=4 (0b100). (4 << 1) is 8 (0b1000).\n        # 7 | 8 = 15 (0b1111).\n        return n | (highest_bit_mask << 1)\n\n    # If n is not all ones up to its highest bit, scan from the highest bit downwards\n    # to find the first (most significant) zero bit and set it.\n    pos = highest_bit_mask\n    while pos > 0:\n        if (n & pos) == 0:\n            # Found the left-most unset bit, set it.\n            return n | pos\n        pos >>= 1\n\n    # This part should theoretically be unreachable because if n is not 'all_ones_mask',\n    # there must be at least one zero bit within the range covered by 'pos' (from highest bit down to 1).\n    # The loop would find it and return."}
{"task_id": "Mbpp/389", "solution": "import typing\n\nclass InvalidParameterError(Exception):\n    \"\"\"Raised when an invalid parameter is provided.\"\"\"\n    pass\n\nclass CacheError(Exception):\n    \"\"\"Raised for cache-related errors, typically I/O.\"\"\"\n    pass\n\ndef validate_non_negative_int(value: typing.Any) -> int:\n    \"\"\"Validates if a value is a non-negative integer.\"\"\"\n    try:\n        iv = int(value)\n    except (TypeError, ValueError):\n        raise InvalidParameterError(\"n must be an integer\")\n    if iv < 0:\n        raise InvalidParameterError(\"n must be non-negative\")\n    return iv\n\nclass CacheRepository(typing.Protocol):\n    \"\"\"Interface for a cache repository.\"\"\"\n    def get(self, n: int) -> typing.Optional[int]:\n        ...\n    def set(self, n: int, value: int) -> None:\n        ...\n\nclass InMemoryCache:\n    \"\"\"An in-memory implementation of the CacheRepository.\"\"\"\n    def __init__(self, initial: typing.Optional[typing.Dict[int, int]] = None) -> None:\n        self._store: typing.Dict[int, int] = initial if initial is not None else {}\n\n    def get(self, n: int) -> typing.Optional[int]:\n        \"\"\"Retrieves a cached value by key.\"\"\"\n        return self._store.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a value in the cache.\"\"\"\n        self._store[n] = value\n\nclass LucasService:\n    \"\"\"Core logic to compute Lucas numbers, handling validation and caching.\"\"\"\n    def __init__(self, cache: CacheRepository) -> None:\n        self._cache = cache\n\n    def _compute_iterative(self, n: int) -> int:\n        \"\"\"Computes the n-th Lucas number iteratively with O(1) memory.\"\"\"\n        if n == 0:\n            return 2\n        if n == 1:\n            return 1\n\n        a, b = 2, 1\n        for _ in range(2, n + 1):\n            a, b = b, a + b\n        return b\n\n    def compute(self, n: int) -> int:\n        \"\"\"Validates input, consults cache, and computes the Lucas number.\"\"\"\n        validated_n = validate_non_negative_int(n)\n\n        cached_value = self._cache.get(validated_n)\n        if cached_value is not None:\n            return cached_value\n\n        value = self._compute_iterative(validated_n)\n\n        try:\n            self._cache.set(validated_n, value)\n        except CacheError:\n            pass \n\n        return value\n\ndef find_lucas(n: int) -> int:\n    \"\"\"\n    Finds the n'th Lucas number.\n    It uses an in-memory cache and iterative computation.\n    \"\"\"\n    cache = InMemoryCache()\n    svc = LucasService(cache)\n    return svc.compute(n)"}
{"task_id": "Mbpp/390", "solution": "import json\nimport os\nimport tempfile\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional, Sequence\n\nclass InvalidInputError(Exception):\n    \"\"\"Base exception for invalid input.\"\"\"\n    pass\n\nclass InputValidationError(InvalidInputError):\n    \"\"\"Exception raised for specific input validation failures.\"\"\"\n    pass\n\nclass FormatApplicationError(Exception):\n    \"\"\"Exception raised when formatting an item fails.\"\"\"\n    pass\n\nclass FilePersistenceError(Exception):\n    \"\"\"Exception raised for errors during file persistence.\"\"\"\n    pass\n\nclass FormatResult:\n    \"\"\"Data Transfer Object for formatting results.\"\"\"\n    def __init__(self, results: Sequence[str]) -> None:\n        self.results: List[str] = list(results)\n        self.count: int = len(self.results)\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Returns a serializable dictionary representation.\"\"\"\n        return {\"results\": self.results, \"count\": self.count}\n\nclass FormatUtils:\n    \"\"\"Utility class for safe string formatting.\"\"\"\n    def safe_format(self, fmt: str, item: Any) -> str:\n        \"\"\"Applies format string to an item, catching exceptions.\"\"\"\n        try:\n            return fmt.format(item)\n        except Exception as exc:\n            raise FormatApplicationError(f\"Failed to format item {item!r} with format {fmt!r}\") from exc\n\nclass InputValidator:\n    \"\"\"Validates input parameters for formatting operations.\"\"\"\n    def validate_items(self, items: Any) -> Sequence[Any]:\n        \"\"\"Ensures items is a non-string sequence.\"\"\"\n        if not isinstance(items, Sequence) or isinstance(items, str):\n            raise InputValidationError(\"Input 'items' must be a sequence (e.g., list or tuple), not a string.\")\n        return items\n\n    def validate_format(self, fmt: Any) -> str:\n        \"\"\"Ensures format string is a non-empty string.\"\"\"\n        if not isinstance(fmt, str):\n            raise InputValidationError(\"Input 'fmt' must be a string.\")\n        if not fmt:\n            raise InputValidationError(\"Format string 'fmt' cannot be empty.\")\n        return fmt\n\nclass ListRepository:\n    \"\"\"Handles persistence of formatted lists to JSON files.\"\"\"\n    def save(self, results: Sequence[str], path: Path, overwrite: bool = True) -> None:\n        \"\"\"Saves a sequence of strings to a JSON file atomically.\"\"\"\n        try:\n            path.parent.mkdir(parents=True, exist_ok=True)\n            with tempfile.NamedTemporaryFile(mode='w', delete=False, dir=path.parent, encoding='utf-8') as tmp_file:\n                json.dump(list(results), tmp_file)\n            os.replace(tmp_file.name, path)\n        except Exception as exc:\n            raise FilePersistenceError(f\"Failed to persist results to {path}\") from exc\n\nclass FormatterService:\n    \"\"\"Core business logic for formatting lists.\"\"\"\n    def __init__(self, validator: InputValidator, repo: Optional[ListRepository] = None) -> None:\n        \"\"\"Initializes FormatterService with validator and optional repository.\"\"\"\n        self.validator = validator\n        self.repo = repo\n        self.utils = FormatUtils()\n\n    def format_list(self, items: Sequence[Any], fmt: str) -> List[str]:\n        \"\"\"Validates inputs and formats each item in the list.\"\"\"\n        items = self.validator.validate_items(items)\n        fmt = self.validator.validate_format(fmt)\n        out: List[str] = []\n        for idx, item in enumerate(items):\n            try:\n                out.append(self.utils.safe_format(fmt, item))\n            except Exception as exc:\n                raise FormatApplicationError(f\"Formatting failed at index {idx} for item {item!r}\") from exc\n        return out\n\n    def format_and_persist(self, items: Sequence[Any], fmt: str, out_path: Optional[Path] = None) -> FormatResult:\n        \"\"\"Formats the list and optionally persists the results to a file.\"\"\"\n        results = self.format_list(items, fmt)\n        result = FormatResult(results)\n        if out_path:\n            if self.repo is None:\n                raise FilePersistenceError(\"Persistence requested but no repository configured.\")\n            self.repo.save(results, out_path, overwrite=True)\n        return result\n\ndef add_string(items: Sequence[Any], fmt: str, persist_to: Optional[Path] = None) -> List[str]:\n    \"\"\"Applies a format string to all elements in a list and optionally persists them.\"\"\"\n    validator = InputValidator()\n    repo = ListRepository() if persist_to is not None else None\n    service = FormatterService(validator=validator, repo=repo)\n    result = service.format_and_persist(items=items, fmt=fmt, out_path=persist_to)\n    return result.results"}
{"task_id": "Mbpp/397", "solution": "def median_numbers(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Finds the median of three numeric values using comparisons.\n    Assumes inputs are floats or ints.\n    \"\"\"\n    if (a <= b and b <= c) or (c <= b and b <= a):\n        return float(b)\n    if (b <= a and a <= c) or (c <= a and a <= b):\n        return float(a)\n    return float(c)"}
{"task_id": "Mbpp/395", "solution": "from collections import Counter\n\ndef first_non_repeating_character(s):\n    \"\"\"\n    Finds the first non-repeated character in a given string.\n    Returns the character or None if no non-repeated character is found.\n    \"\"\"\n    if not s:\n        return None\n\n    char_counts = Counter(s)\n\n    for char in s:\n        if char_counts[char] == 1:\n            return char\n\n    return None"}
{"task_id": "Mbpp/391", "solution": "import json\nimport os\nimport tempfile\nfrom typing import Any, Dict, List, Optional, Sequence\n\n\nclass ConversionError(Exception):\n    \"\"\"Custom exception for conversion-related errors.\"\"\"\n    def __init__(self, message: str, cause: Optional[Exception] = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.cause = cause\n\ndef convert_list_dictionary(\n    top_keys: Sequence[str], *others: Sequence[Any], save_to: Optional[str] = None\n) -> List[Dict[str, Any]]:\n    \"\"\"\n    Converts multiple parallel lists into a list of nested dictionaries.\n    The first list provides the top-level keys; subsequent lists form nested structures.\n    \"\"\"\n    # --- Input Validation (from Validators in design context) ---\n    MIN_LISTS = 2\n\n    if not top_keys or len(others) + 1 < MIN_LISTS:\n        raise ConversionError(\"At least two lists (top_keys + others) required.\")\n\n    all_lists = [top_keys] + list(others)\n    lengths = [len(l) for l in all_lists]\n    if len(set(lengths)) != 1:\n        raise ConversionError(\"All lists must be the same length.\")\n\n    list_length = len(top_keys) # All lists have this same length\n\n    # --- Helper to build the nested dictionary for a single index `idx` ---\n    def _build_pairwise_nested_for_index(idx: int, other_lists_param: Sequence[Sequence[Any]]) -> Dict[str, Any]:\n        num_others_inner = len(other_lists_param)\n        \n        if num_others_inner == 0:\n            return {}\n\n        current_nested: Dict[str, Any]\n        start_idx_for_loop: int\n\n        # Initialize the innermost nesting. If an odd number of lists, the last key maps to None.\n        if num_others_inner % 2 != 0:\n            current_nested = {other_lists_param[num_others_inner - 1][idx]: None}\n            start_idx_for_loop = num_others_inner - 3 # Start building from the pair before the last single key\n        else:\n            # The last pair forms the innermost key-value\n            current_nested = {\n                other_lists_param[num_others_inner - 2][idx]: other_lists_param[num_others_inner - 1][idx]\n            }\n            start_idx_for_loop = num_others_inner - 4 # Start building from the pair before the last pair\n        \n        # Build deeper nesting by iterating backwards over remaining pairs\n        for j in range(start_idx_for_loop, -1, -2):\n            current_nested = {other_lists_param[j][idx]: current_nested}\n        \n        return current_nested\n\n    # --- Core Conversion Logic (from ListConversionService in design context) ---\n    result_list = []\n    for i in range(list_length):\n        nested_part = _build_pairwise_nested_for_index(i, others)\n        result_list.append({top_keys[i]: nested_part})\n\n    # --- Optional Persistence Logic (from JsonRepository and ConversionController in design context) ---\n    if save_to:\n        DEFAULT_ENCODING = \"utf-8\"\n        DEFAULT_JSON_INDENT = 2\n        \n        try:\n            # Create a temporary file in the target directory (or system default temp dir)\n            temp_dir = os.path.dirname(save_to) or tempfile.gettempdir()\n            with tempfile.NamedTemporaryFile(mode=\"w\", delete=False, encoding=DEFAULT_ENCODING, dir=temp_dir) as f:\n                json.dump(result_list, f, indent=DEFAULT_JSON_INDENT, ensure_ascii=False)\n            \n            # Atomically replace the original file with the new one\n            os.replace(f.name, save_to)\n        except IOError as e:\n            raise ConversionError(f\"Failed to save results to '{save_to}': {e}\", cause=e)\n        except Exception as e:\n            # Catch other potential issues during serialization/IO that aren't strictly IOError\n            raise ConversionError(f\"An unexpected error occurred while saving to '{save_to}': {e}\", cause=e)\n\n    return result_list"}
{"task_id": "Mbpp/394", "solution": "import collections\n\ndef check_distinct(values: tuple) -> bool:\n    \"\"\"\n    Checks if a tuple contains no duplicate elements.\n    Optimized for hashable items, falls back to O(n^2) for non-hashable items.\n    \"\"\"\n    # Check if all items are hashable\n    all_hashable = True\n    for item in values:\n        try:\n            hash(item)\n        except TypeError:\n            all_hashable = False\n            break\n\n    if all_hashable:\n        return len(set(values)) == len(values)\n    else:\n        # Fallback for non-hashable items using O(n^2) comparison\n        for i in range(len(values)):\n            for j in range(i + 1, len(values)):\n                if values[i] == values[j]:\n                    return False\n        return True"}
{"task_id": "Mbpp/392", "solution": "_memo = {}\n_DIVISORS = (2, 3, 4, 5)\n\ndef get_max_sum(n: int) -> int:\n    \"\"\"Calculates the maximum sum f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n) using memoization.\"\"\"\n    if n <= 1:\n        return n\n\n    if n in _memo:\n        return _memo[n]\n\n    parts_sum = 0\n    for d in _DIVISORS:\n        parts_sum += get_max_sum(n // d)\n\n    result = max(n, parts_sum)\n    _memo[n] = result\n    return result"}
{"task_id": "Mbpp/398", "solution": "from typing import List\n\ndef sum_of_digits(numbers: List[int]) -> int:\n    # Computes the total sum of digits for all numbers in the given list.\n    # Handles negative numbers by taking their absolute value.\n    total_aggregate_sum = 0\n    \n    for num in numbers:\n        abs_num_str = str(abs(num))\n        current_num_digit_sum = sum(int(digit_char) for digit_char in abs_num_str)\n        total_aggregate_sum += current_num_digit_sum\n        \n    return total_aggregate_sum"}
