{"task_id": "Mbpp/479", "solution": "from typing import Union\n\nclass InvalidNumberError(Exception):\n    \"\"\"Exception raised for invalid number inputs.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        return self.message\n\nclass NumberParser:\n    \"\"\"Provides utilities for normalizing numeric input and extracting the first digit.\"\"\"\n    def normalize(self, number_raw: Union[int, float, str]) -> str:\n        \"\"\"Converts raw input to a string, strips whitespace, and handles leading signs.\"\"\"\n        s = str(number_raw).strip()\n        # Remove leading '+' as it's not a digit and doesn't affect the first significant digit.\n        if s.startswith('+'):\n            s = s[1:]\n        return s\n\n    def extract_first_digit(self, normalized: str) -> str:\n        \"\"\"Scans the normalized string from left to right to find the first digit character.\"\"\"\n        for ch in normalized:\n            if self.is_digit_char(ch):\n                return ch\n        raise InvalidNumberError(f\"No digit found in input: {normalized}\")\n\n    def is_digit_char(self, c: str) -> bool:\n        \"\"\"Checks if a character is a numeric digit.\"\"\"\n        return c.isdigit()\n\nclass FirstDigitService:\n    \"\"\"Encapsulates the core logic for extracting the first digit using a NumberParser.\"\"\"\n    def __init__(self, parser: NumberParser):\n        self._parser = parser\n\n    def get_first_digit(self, number: Union[int, float, str]) -> int:\n        \"\"\"Normalizes the input, extracts the first digit character, and converts it to an integer.\"\"\"\n        normalized_str = self._parser.normalize(number)\n        digit_char = self._parser.extract_first_digit(normalized_str)\n        return int(digit_char)\n\nclass FirstDigitAPI:\n    \"\"\"Public API facade for the first_Digit functionality, wiring service dependencies.\"\"\"\n    def __init__(self, service: FirstDigitService | None = None):\n        self._service = service or FirstDigitService(NumberParser())\n\n    def get_service(self) -> FirstDigitService:\n        \"\"\"Returns the FirstDigitService instance used by this API.\"\"\"\n        return self._service\n\n    def first_Digit(self, number: Union[int, float, str]) -> int:\n        \"\"\"Public entrypoint to find the first digit of a given number.\"\"\"\n        return self._service.get_first_digit(number)\n\n_default_api = FirstDigitAPI()\n\ndef first_Digit(number: Union[int, float, str]) -> int:\n    \"\"\"\n    Finds the first digit of a given number (integer, float, or string).\n\n    Ignores signs and decimal points; processes leading zeros as digits.\n    \"\"\"\n    return _default_api.first_Digit(number)"}
{"task_id": "Mbpp/476", "solution": "from typing import Sequence, List, Any, Union, Optional\nfrom dataclasses import dataclass\nfrom datetime import datetime\n\n# Define custom exceptions (from src/bigsum/exceptions.py)\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n    def __str__(self):\n        return self.message\n\n# Define Validator (from src/bigsum/utils.py)\nclass Validator:\n    \"\"\"Utility class for input validation and conversion.\"\"\"\n    ALLOWED_TYPES = (int, float)\n\n    @staticmethod\n    def is_numeric(value: Any) -> bool:\n        \"\"\"Checks if a value is an integer or a float, excluding booleans.\"\"\"\n        return isinstance(value, Validator.ALLOWED_TYPES) and not isinstance(value, bool)\n\n    @staticmethod\n    def validate_numeric_sequence(arr: Sequence) -> List[float]:\n        \"\"\"Validates if the input is a non-empty sequence of numeric types.\"\"\"\n        try:\n            iterator = list(arr)\n        except TypeError:\n            raise ValidationError(\"Input must be an iterable of numbers\")\n        \n        if len(iterator) == 0:\n            raise ValidationError(\"Input sequence is empty\")\n        \n        result = []\n        for i, v in enumerate(iterator):\n            if Validator.is_numeric(v):\n                result.append(float(v))\n            else:\n                raise ValidationError(f\"Element at index {i} is not numeric: {v!r}\")\n        return result\n\n# Define ValuePair (from src/bigsum/models.py)\n@dataclass\nclass ValuePair:\n    \"\"\"Represents a pair of minimum and maximum values.\"\"\"\n    min_value: float\n    max_value: float\n\n    @staticmethod\n    def from_sequence(values: Sequence[float]) -> \"ValuePair\":\n        \"\"\"Creates a ValuePair from a sequence of floats.\"\"\"\n        return ValuePair(min(values), max(values))\n\n# Define InMemoryRepository (from src/bigsum/repository.py)\nclass InMemoryRepository:\n    \"\"\"An in-memory repository to store computed results.\"\"\"\n    def __init__(self):\n        self._store: List[Dict[str, Any]] = []\n\n    def save(self, input_list: List[float], result: float) -> None:\n        \"\"\"Saves the input list and computed result with a timestamp.\"\"\"\n        self._store.append({\n            \"input\": input_list.copy(),\n            \"result\": result,\n            \"timestamp\": datetime.utcnow().isoformat() + \"Z\"\n        })\n\n    def all(self) -> List[Dict[str, Any]]:\n        \"\"\"Returns a shallow copy of all stored records.\"\"\"\n        return list(self._store)\n\n# Define BigSumService (from src/bigsum/services.py)\nNumber = Union[int, float]\nclass BigSumService:\n    \"\"\"Service responsible for computing the sum of the largest and smallest values.\"\"\"\n    def __init__(self, repository: Optional[InMemoryRepository] = None):\n        self._repo = repository\n\n    def compute(self, values: Sequence[Number]) -> float:\n        \"\"\"Computes the sum of the smallest and largest values in a sequence.\"\"\"\n        validated = Validator.validate_numeric_sequence(values)\n        vp = self._find_min_max(validated)\n        result = vp.min_value + vp.max_value\n        if self._repo:\n            self._repo.save(validated, result)\n        return result\n\n    def _find_min_max(self, values: Sequence[float]) -> ValuePair:\n        \"\"\"Finds the minimum and maximum values in a sequence.\"\"\"\n        return ValuePair.from_sequence(values)\n\n# Define big_sum function (from src/bigsum/controllers.py)\ndef big_sum(arr: Sequence) -> float:\n    \"\"\"\n    Finds the sum of the largest and smallest value in a given array.\n    \"\"\"\n    svc = BigSumService()\n    return svc.compute(arr)"}
