{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array: list) -> bool:\n    \"\"\"\n    Checks if the given array is monotonic.\n    An array is monotonic if it is either monotonically increasing or monotonically decreasing.\n    \"\"\"\n    if len(array) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(len(array) - 1):\n        if array[i] > array[i+1]:\n            is_increasing = False\n        if array[i] < array[i+1]:\n            is_decreasing = False\n\n    return is_increasing or is_decreasing"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(input_list):\n    \"\"\"\n    Flattens a nested list and sums all its numeric elements.\n    Raises TypeError if any element is not a number or a list.\n    \"\"\"\n    total_sum = 0\n    for element in input_list:\n        if isinstance(element, (int, float)):\n            total_sum += element\n        elif isinstance(element, list):\n            total_sum += recursive_list_sum(element)\n        else:\n            raise TypeError(\"List elements must be numbers or lists\")\n    return total_sum"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list: list, sublist: list) -> bool:\n    \"\"\"Checks if a sublist exists as a contiguous subsequence within a main list.\"\"\"\n    if not sublist:\n        return True\n    if not main_list and sublist:\n        return False\n\n    n = len(main_list)\n    m = len(sublist)\n\n    for i in range(n - m + 1):\n        if main_list[i:i+m] == sublist:\n            return True\n    return False"}
