{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers: list[int], length: int) -> int:\n    \"\"\"\n    Calculates the sum of the bitwise XOR of all unique pairs of numbers in the given list.\n    Returns 0 if the list has fewer than two elements.\n    \"\"\"\n    if length < 2:\n        return 0\n\n    total_xor_sum = 0\n    for i in range(length):\n        for j in range(i + 1, length):\n            pair_xor = numbers[i] ^ numbers[j]\n            total_xor_sum += pair_xor\n    return total_xor_sum"}
{"task_id": "Mbpp/632", "solution": "def move_zero(input_list: list) -> list:\n    \"\"\"Moves all zero elements to the end of the list while preserving the relative order of non-zero elements.\n    Returns a new list with zeroes moved to the end.\"\"\"\n    non_zero_elements = []\n    zero_count = 0\n\n    for element in input_list:\n        if element == 0:\n            zero_count += 1\n        else:\n            non_zero_elements.append(element)\n\n    return non_zero_elements + [0] * zero_count"}
{"task_id": "Mbpp/635", "solution": "from typing import List, Any\ndef heap_sort(input_list: List[Any]) -> List[Any]:\n    \"\"\"Sorts a list of comparable elements using the heap sort algorithm.\n    Returns a new list containing the sorted elements in ascending order.\n    \"\"\"\n    # Create a mutable copy to perform sorting without modifying original\n    n = len(input_list)\n    arr = list(input_list)\n\n    # Build a maxheap\n    _build_max_heap(arr)\n\n    # One by one extract elements\n    for i in range(n - 1, 0, -1):\n        arr[i], arr[0] = arr[0], arr[i]  # Swap\n        _heapify(arr, i, 0)\n\n    return arr"}
{"task_id": "Mbpp/641", "solution": "def is_nonagonal(n: int) -> int:\n    \"\"\"\n    Calculates the nth nonagonal number using the formula N_n = n * (7n - 5) / 2.\n    \"\"\"\n    return n * (7 * n - 5) // 2"}
{"task_id": "Mbpp/638", "solution": "import math\ndef wind_chill(velocity: float, temperature: float) -> int:\n    \"\"\"\n    Calculates the wind chill index given wind velocity in km/h and temperature in Celsius.\n    The result is rounded up to the next whole integer.\n    \"\"\"\n    # Standard formula for wind chill index using temperature in Celsius and velocity in km/h.\n    calculated_wci = 13.12 + (0.6215 * temperature) - (11.37 * (velocity**0.16)) + (0.3965 * temperature * (velocity**0.16))\n    \n    # Round the calculated index up to the next whole integer.\n    return math.ceil(calculated_wci)"}
{"task_id": "Mbpp/643", "solution": "def text_match_wordz_middle(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string contains 'z' in its middle section (excluding the first and last characters).\n    Returns True if 'z' is found in this range, False otherwise.\n    \"\"\"\n    n = len(input_string)\n    if n < 3:\n        return False\n    # Search for 'z' from index 1 up to (but not including) the last character (index n-1).\n    return input_string.find('z', 1, n - 1) != -1"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(array: list, k: int) -> list:\n    \"\"\"\n    Reverses the elements of the input array from the beginning up to the k-th position (1-indexed).\n    Raises ValueError if k is not a positive integer or if k exceeds the array's length.\n    \"\"\"\n    if not (isinstance(k, int) and k > 0):\n        raise ValueError(\"k must be a positive integer\")\n    if k > len(array):\n        raise ValueError(\"k cannot exceed array length\")\n\n    left = 0\n    right = k - 1\n\n    while left < right:\n        array[left], array[right] = array[right], array[left]\n        left += 1\n        right -= 1\n    return array"}
{"task_id": "Mbpp/639", "solution": "from typing import List\nclass Name:\n    \"\"\"Represents a single name string with validation and length properties.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the name string.\"\"\"\n        return len(self._value)\n\n    def starts_with_lowercase(self) -> bool:\n        \"\"\"Checks if the name starts with a lowercase letter.\"\"\"\n        if not self._value:\n            return False\n        return self._value[0].islower()\n\n    def get_value(self) -> str:\n        \"\"\"Returns the raw string value of the name.\"\"\"\n        return self._value\nclass NameList:\n    \"\"\"Manages a collection of Name objects and provides filtering capabilities.\"\"\"\n    def __init__(self, raw_names: List[str]):\n        self._names: List[Name] = [Name(name) for name in raw_names]\n\n    def get_valid_names(self) -> List[Name]:\n        \"\"\"Returns a list of Name objects not starting with a lowercase letter.\"\"\"\n        return [name for name in self._names if not name.starts_with_lowercase()]\nclass LengthSumCalculator:\n    \"\"\"Calculates the sum of lengths of a given list of Name objects.\"\"\"\n    def calculate_sum(self, name_list: NameList) -> int:\n        \"\"\"Computes the sum of lengths of valid names from the NameList.\"\"\"\n        valid_names = name_list.get_valid_names()\n        total_length = 0\n        for name in valid_names:\n            total_length += name.length()\n        return total_length\ndef sample_nam(names: List[str]) -> int:\n    \"\"\"Sums the length of names from a list, excluding those starting with lowercase letters.\n    Returns the total length of valid names.\n    \"\"\"\n    name_list = NameList(names)\n    calculator = LengthSumCalculator()\n    return calculator.calculate_sum(name_list)"}
