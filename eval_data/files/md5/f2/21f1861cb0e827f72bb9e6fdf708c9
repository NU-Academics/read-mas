{"task_id": "Mbpp/128", "solution": "def long_words(n,text):\n    \"\"\"\n    Filters a string of words, returning a list of words longer than n characters.\n    Words are split by whitespace.\n    \"\"\"\n    words = text.split()\n    return [word for word in words if len(word) > n]"}
{"task_id": "Mbpp/126", "solution": "def _get_divisors(n: int) -> set[int]:\n    \"\"\"Finds all positive divisors for a given positive integer.\"\"\"\n    divs = set()\n    for i in range(1, int(n**0.5) + 1):\n        if n % i == 0:\n            divs.add(i)\n            divs.add(n // i)\n    return divs\n\ndef _find_common_divisors(divisors1: set[int], divisors2: set[int]) -> set[int]:\n    \"\"\"Identifies the common elements between two sets of divisors.\"\"\"\n    return divisors1.intersection(divisors2)\n\ndef sum_common_divisors(num1: int, num2: int) -> int:\n    \"\"\"Calculates the sum of common divisors for two given positive integers.\"\"\"\n    divisors1 = _get_divisors(num1)\n    divisors2 = _get_divisors(num2)\n    common_divs = _find_common_divisors(divisors1, divisors2)\n    return sum(common_divs)"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(input_list):\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    Returns None if the input_list is empty.\n    \"\"\"\n    if not input_list:\n        return None\n\n    frequency_map = {}\n    for item in input_list:\n        frequency_map[item] = frequency_map.get(item, 0) + 1\n\n    max_freq_item = None\n    max_freq_count = -1\n\n    for item, count in frequency_map.items():\n        if count > max_freq_count:\n            max_freq_count = count\n            max_freq_item = item\n    \n    return max_freq_item"}
