{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Calculates the maximum length of a contiguous sequence of uppercase characters\n    in the given input string.\n    \"\"\"\n    current_run_length = 0\n    max_run_length = 0\n    for char in input_string:\n        if char.isupper():\n            current_run_length += 1\n        else:\n            current_run_length = 0\n        max_run_length = max(max_run_length, current_run_length)\n    return max_run_length"}
{"task_id": "Mbpp/807", "solution": "def first_odd(numbers_list: list) -> int:\n    \"\"\"\n    Finds the first odd number in a given list of numbers.\n    Iterates through the list and returns the first number for which `number % 2 != 0`.\n    \"\"\"\n    for number in numbers_list:\n        if number % 2 != 0:\n            return number"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(tuple1: tuple, tuple2: tuple) -> bool:\n    \"\"\"\n    Checks if each element of the second tuple is strictly smaller than its corresponding element in the first tuple.\n    Returns False if tuples have different lengths or any element is not strictly smaller.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        return False\n\n    for el1, el2 in zip(tuple1, tuple2):\n        if not (el2 < el1):\n            return False\n            \n    return True"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(num1: int, num2: int, num3: int) -> int:\n    \"\"\"Counts the number of equal integers among three given inputs.\n\n    Returns an integer representing the count of equal numbers (0, 2, or 3).\n    \"\"\"\n    unique_numbers = len({num1, num2, num3})\n    if unique_numbers == 1:\n        return 3\n    elif unique_numbers == 2:\n        return 2\n    else: # unique_numbers == 3\n        return 0"}
