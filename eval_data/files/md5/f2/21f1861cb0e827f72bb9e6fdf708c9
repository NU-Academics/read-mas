{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    \"\"\"\n    Identifies the left-most unset bit in an integer `n`, sets it to 1, and returns the modified integer.\n    Example: set_left_most_unset_bit(10) returns 14 (1010 -> 1110).\n    \"\"\"\n    if n == 0:\n        return 1\n\n    highest_bit_pos = n.bit_length() - 1\n\n    for i in range(highest_bit_pos, -1, -1):\n        if not (n & (1 << i)):\n            return n | (1 << i)\n\n    # If all bits up to highest_bit_pos are set, set the next higher bit.\n    return n | (1 << (highest_bit_pos + 1))"}
{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(student_ids: list[str], student_names: list[str], scores: list[int]) -> list[dict]:\n    \"\"\"Converts three parallel lists into a list of nested dictionaries.\"\"\"\n    if not (len(student_ids) == len(student_names) == len(scores)):\n        raise ValueError(\"Input lists must be of equal length.\")\n\n    result = []\n    for i in range(len(student_ids)):\n        inner_dict = {student_names[i]: scores[i]}\n        outer_dict = {student_ids[i]: inner_dict}\n        result.append(outer_dict)\n    return result"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    \"\"\"\n    Calculates the n'th Lucas number using an iterative approach.\n    L(0)=2, L(1)=1, and L(n)=L(n-1)+L(n-2) for n > 1.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n\n    a, b = 2, 1  # Initialize with L(0) and L(1)\n    for _ in range(2, n + 1):\n        a, b = b, a + b\n    return b"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"Calculates the highest power of 2 that is less than or equal to n.\n    It iteratively shifts a power of 2 until the next power exceeds n.\n    \"\"\"\n    power = 1\n    while (power << 1) <= n:\n        power <<= 1\n    return power"}
