{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list: list, sublist_candidate: list) -> bool:\n    \"\"\"\n    Checks if sublist_candidate is a consecutive sublist of main_list.\n    Returns True if sublist_candidate is found consecutively in main_list, False otherwise.\n    \"\"\"\n    if not sublist_candidate:\n        return True\n\n    if len(sublist_candidate) > len(main_list):\n        return False\n\n    len_sub = len(sublist_candidate)\n    for i in range(len(main_list) - len_sub + 1):\n        if main_list[i:i+len_sub] == sublist_candidate:\n            return True\n    return False"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(number: int) -> int:\n    \"\"\"\n    Calculates the last digit of the factorial of a given non-negative integer.\n    It returns the last digit of number! based on specific rules for small numbers and 0 for numbers >= 5.\n    \"\"\"\n    if number == 0 or number == 1:\n        return 1\n    elif number == 2:\n        return 2\n    elif number == 3:\n        return 6\n    elif number == 4:\n        return 4\n    else: # number >= 5\n        return 0"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Raises ValueError if input lists do not have the same length.\n    \"\"\"\n    len1 = len(list1)\n    if len1 != len(list2) or len1 != len(list3):\n        raise ValueError(\"Input lists must have the same length\")\n\n    interleaved_list = []\n    for i in range(len1):\n        interleaved_list.append(list1[i])\n        interleaved_list.append(list2[i])\n        interleaved_list.append(list3[i])\n\n    return interleaved_list"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Finds elements that are present in one tuple but not in the other.\n    This function identifies elements unique to tuple1 and elements unique to tuple2,\n    then combines them into a single tuple of all unique dissimilar elements.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n\n    unique_to_tuple1 = set1 - set2\n    unique_to_tuple2 = set2 - set1\n\n    all_dissimilar_elements = unique_to_tuple1.union(unique_to_tuple2)\n\n    return tuple(all_dissimilar_elements)"}
{"task_id": "Mbpp/580", "solution": "def extract_even(inputTuple: tuple) -> tuple:\n    \"\"\"\n    Recursively filters odd integer elements from a nested tuple,\n    preserving the nesting structure, and returns a new tuple.\n    \"\"\"\n    result_list = []\n    for element in inputTuple:\n        if isinstance(element, int):\n            if element % 2 == 0:\n                result_list.append(element)\n        elif isinstance(element, tuple):\n            filtered_nested_tuple = extract_even(element)\n            # Only append non-empty filtered tuples to maintain structure if content exists.\n            # Based on example (4, 5, (7, 6, (2, 4)), 6, 8) -> (4, (6, (2, 4)), 6, 8)\n            # if a nested tuple becomes empty like `(7,)` -> `()` it should still be included as `()`\n            # The current logic of appending `filtered_nested_tuple` (even if empty)\n            # correctly preserves the structure as per the example.\n            result_list.append(filtered_nested_tuple)\n    return tuple(result_list)"}
{"task_id": "Mbpp/581", "solution": "def surface_Area(base_edge, height):\n    \"\"\"\n    Calculates the total surface area of a square pyramid. The `height` parameter refers to the slant height of the pyramid.\n    \"\"\"\n    base_area = base_edge * base_edge\n    lateral_area = 2 * base_edge * height\n    total_surface_area = base_area + lateral_area\n    return total_surface_area"}
{"task_id": "Mbpp/585", "solution": "def expensive_items(items: list[dict], n: int) -> list[dict]:\n    \"\"\"\n    Finds the n most expensive items in a given dataset, sorted by price descending.\n    Handles cases where n is 0 or the input list is empty by returning an empty list.\n    \"\"\"\n    if n == 0 or not items:\n        return []\n\n    sorted_items = sorted(items, key=lambda item: item['price'], reverse=True)\n\n    return sorted_items[:n]"}
