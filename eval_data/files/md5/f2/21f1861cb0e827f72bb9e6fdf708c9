{"task_id": "Mbpp/137", "solution": "def zero_count(numbers: list[int]) -> float:\n    \"\"\"Calculates the ratio of zeroes to non-zeroes in an array of integers.\n\n    Returns 0.0 if there are no non-zero elements to prevent division by zero.\n    \"\"\"\n    zeroes = 0\n    non_zeroes = 0\n\n    for number in numbers:\n        if number == 0:\n            zeroes += 1\n        else:\n            non_zeroes += 1\n\n    if non_zeroes == 0:\n        return 0.0\n    else:\n        return float(zeroes) / non_zeroes"}
{"task_id": "Mbpp/140", "solution": "def extract_singly(list_of_tuples: list[tuple[int | float, ...]]) -> set[int | float]:\n    \"\"\"\n    Flattens a list of tuples into a single set of unique numbers.\n\n    Args:\n        list_of_tuples: A list where each element is a tuple containing numbers (int or float).\n\n    Returns:\n        A set containing all unique numbers extracted from the input list of tuples.\n    \"\"\"\n    result_set = set()\n    for current_tuple in list_of_tuples:\n        for number in current_tuple:\n            result_set.add(number)\n    return result_set"}
{"task_id": "Mbpp/141", "solution": "def _find_max_index(arr: list, n: int) -> int:\n    \"\"\"\n    Finds the index of the maximum element in the sublist arr[0...n-1].\n    This is a helper function for the pancake sort algorithm.\n    \"\"\"\n    max_val = arr[0]\n    max_idx = 0\n    for i in range(1, n):\n        if arr[i] > max_val:\n            max_val = arr[i]\n            max_idx = i\n    return max_idx\ndef pancake_sort(arr: list) -> list:\n    \"\"\"\n    Sorts a list of numbers in ascending order using the Pancake Sort algorithm.\n    Returns a new list containing the sorted elements, leaving the original list unchanged.\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return list(arr)\n\n    current_list = list(arr)\n\n    for current_size in range(n, 1, -1):\n        max_idx = _find_max_index(current_list, current_size)\n\n        if max_idx != current_size - 1:\n            _flip(current_list, max_idx)\n            _flip(current_list, current_size - 1)\n\n    return current_list"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"Calculates the sum of terms (n - 2*i) for i from 0 to n // 2, including only positive terms.\"\"\"\n    total_sum = 0\n    for i in range(n // 2 + 1):\n        current_term = n - 2 * i\n        if current_term > 0:\n            total_sum += current_term\n    return total_sum"}
{"task_id": "Mbpp/145", "solution": "from typing import Iterable, Union\ndef max_Abs_Diff(arr: Iterable[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the maximum absolute difference between any two elements in the given array.\n    Returns 0 if the array contains fewer than two elements.\n    \"\"\"\n    if len(arr) < 2:\n        return 0\n\n    min_val = min(arr)\n    max_val = max(arr)\n\n    return max_val - min_val"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1: list, list2: list, list3: list) -> int:\n    \"\"\"Counts the number of items that are identical in the same position of three given lists.\"\"\"\n    min_length = min(len(list1), len(list2), len(list3))\n    count = 0\n\n    for i in range(min_length):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n            \n    return count"}
