{"task_id": "Mbpp/123", "solution": "import math\ndef amicable_numbers_sum(upper_limit: int) -> int:\n    \"\"\"Calculates the sum of all unique amicable numbers from 1 up to upper_limit.\"\"\"\n\n    def calculate_proper_divisor_sum(num: int) -> int:\n        \"\"\"Calculates the sum of proper divisors for a given number.\"\"\"\n        if num == 1:\n            return 0\n        sum_of_divisors = 1\n        for i in range(2, int(math.sqrt(num)) + 1):\n            if num % i == 0:\n                sum_of_divisors += i\n                if i * i != num:\n                    sum_of_divisors += num // i\n        return sum_of_divisors\n\n    class AmicableNumberSet:\n        \"\"\"Manages a collection of unique amicable numbers and provides their total sum.\"\"\"\n        def __init__(self):\n            self._numbers: set[int] = set()\n\n        def add_unique(self, number: int) -> None:\n            \"\"\"Adds a number to the set if it's not already present.\"\"\"\n            self._numbers.add(number)\n\n        def get_sum(self) -> int:\n            \"\"\"Returns the total sum of all unique numbers in the set.\"\"\"\n            return sum(self._numbers)\n\n    divisor_sums_cache = {}\n    amicable_set = AmicableNumberSet()\n\n    for num in range(1, upper_limit + 1):\n        if num not in divisor_sums_cache:\n            sum_a = calculate_proper_divisor_sum(num)\n            divisor_sums_cache[num] = sum_a\n        else:\n            sum_a = divisor_sums_cache[num]\n\n        if sum_a > num and sum_a <= upper_limit:\n            if sum_a not in divisor_sums_cache:\n                sum_b = calculate_proper_divisor_sum(sum_a)\n                divisor_sums_cache[sum_a] = sum_b\n            else:\n                sum_b = divisor_sums_cache[sum_a]\n\n            if sum_b == num:\n                amicable_set.add_unique(num)\n                amicable_set.add_unique(sum_a)\n\n    return amicable_set.get_sum()"}
{"task_id": "Mbpp/124", "solution": "def angle_complex(z: complex) -> float:\n    \"\"\"Calculates the angle (argument) of a complex number in radians.\n\n    Uses math.atan2 to compute the angle from the real and imaginary parts.\n    \"\"\"\n    import math\n    return math.atan2(z.imag, z.real)"}
{"task_id": "Mbpp/125", "solution": "def find_length(binary_string_input: str) -> int:\n    \"\"\"\n    Calculates the maximum difference between 0s and 1s in any substring of the given binary string.\n    Raises ValueError if input is not a valid binary string.\n    \"\"\"\n\n    def _validate_binary_string(s: str) -> None:\n        \"\"\"Checks if the string s is a valid binary string, raising ValueError if not.\"\"\"\n        if not all(char in '01' for char in s):\n            raise ValueError(\"Input string must contain only '0's and '1's.\")\n\n    class Substring:\n        \"\"\"Encapsulates a substring and calculates its '0's and '1's difference.\"\"\"\n        def __init__(self, substring_value: str):\n            self._value = substring_value\n            self._zero_count = substring_value.count('0')\n            self._one_count = substring_value.count('1')\n            self._difference = self._zero_count - self._one_count\n\n        def calculate_difference(self) -> int:\n            \"\"\"Returns the pre-calculated difference (zero_count - one_count).\"\"\"\n            return self._difference\n\n    class BinaryString:\n        \"\"\"Encapsulates a binary string and generates its contiguous substrings.\"\"\"\n        def __init__(self, binary_string: str):\n            self._value = binary_string\n\n        def generate_substrings(self) -> list[Substring]:\n            \"\"\"Generates all contiguous substrings as a list of Substring objects.\"\"\"\n            substrings = []\n            n = len(self._value)\n            for i in range(n):\n                for j in range(i + 1, n + 1):\n                    sub_value = self._value[i:j]\n                    substrings.append(Substring(sub_value))\n            return substrings\n\n    _validate_binary_string(binary_string_input)\n\n    if not binary_string_input:\n        return 0\n\n    binary_obj = BinaryString(binary_string_input)\n    substring_objects = binary_obj.generate_substrings()\n\n    max_diff = -float('inf')\n    for sub_obj in substring_objects:\n        max_diff = max(max_diff, sub_obj.calculate_difference())\n\n    return int(max_diff)"}
