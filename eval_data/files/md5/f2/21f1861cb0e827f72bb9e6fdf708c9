{"task_id": "Mbpp/245", "solution": "def _calculate_lis_sums(arr: list[int]) -> list[int]:\n    \"\"\"\n    Computes the maximum sum of a strictly increasing subsequence ending at each position.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n    lis_sum = list(arr)\n\n    for i in range(1, n):\n        for j in range(i):\n            if arr[i] > arr[j]:\n                lis_sum[i] = max(lis_sum[i], arr[i] + lis_sum[j])\n    return lis_sum\ndef _calculate_lds_sums(arr: list[int]) -> list[int]:\n    \"\"\"\n    Computes the maximum sum of a strictly decreasing subsequence starting at each position.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n    lds_sum = list(arr)\n\n    for i in range(n - 2, -1, -1):\n        for j in range(n - 1, i, -1):\n            if arr[i] > arr[j]:\n                lds_sum[i] = max(lds_sum[i], arr[i] + lds_sum[j])\n    return lds_sum\ndef max_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum sum of a bitonic subsequence for the given array.\n    A sequence is bitonic if it is first strictly increasing and then strictly decreasing.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n    if n == 1:\n        return arr[0]\n\n    lis_sums = _calculate_lis_sums(arr)\n    lds_sums = _calculate_lds_sums(arr)\n\n    max_bitonic_sum = float('-inf')\n\n    for i in range(n):\n        # For each element arr[i] acting as the peak of a bitonic subsequence.\n        current_bitonic_sum = lis_sums[i] + lds_sums[i] - arr[i]\n        max_bitonic_sum = max(max_bitonic_sum, current_bitonic_sum)\n\n    return max_bitonic_sum"}
{"task_id": "Mbpp/255", "solution": "def combinations_colors(input_list, n):\n    \"\"\"\n    Generates all combinations with repetition of elements from `input_list`\n    for a specified length `n`.\n    \"\"\"\n    if n == 0:\n        return [()]\n    if not input_list:\n        return []\n\n    result = []\n    \n    # Recursive helper function to build combinations\n    def generate(current_combination, length_left):\n        if length_left == 0:\n            result.append(tuple(current_combination))\n            return\n\n        for item in input_list:\n            current_combination.append(item)\n            generate(current_combination, length_left - 1)\n            current_combination.pop() # Backtrack\n\n    generate([], n)\n    return result"}
{"task_id": "Mbpp/256", "solution": "def count_Primes_nums(limit):\n    \"\"\"\n    Calculates the number of prime numbers strictly less than a given limit.\n    \"\"\"\n\n    def _is_prime(num):\n        \"\"\"\n        Determines if a given number is prime.\n        \"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    count = 0\n    for num in range(2, limit):\n        if _is_prime(num):\n            count += 1\n    return count"}
{"task_id": "Mbpp/252", "solution": "import math\ndef convert(complex_number: complex) -> tuple[float, float]:\n    \"\"\"\n    Converts a complex number to its polar coordinate representation.\n    Returns a tuple (magnitude, angle_in_radians).\n    \"\"\"\n    magnitude = math.hypot(complex_number.real, complex_number.imag)\n    angle_in_radians = math.atan2(complex_number.imag, complex_number.real)\n    return (magnitude, angle_in_radians)"}
