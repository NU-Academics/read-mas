{"task_id": "Mbpp/392", "solution": "_memo = {}\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Calculates the maximum sum for n using the recursive formula with memoization.\n    f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n    \"\"\"\n    if n in _memo:\n        return _memo[n]\n\n    # Base case: for 0, the sum is 0\n    if n == 0:\n        _memo[n] = 0\n        return 0\n\n    # Recursive calls\n    sum_parts = (\n        get_max_sum(n // 2) +\n        get_max_sum(n // 3) +\n        get_max_sum(n // 4) +\n        get_max_sum(n // 5)\n    )\n\n    # Compare the sum of parts with n itself\n    result = max(sum_parts, n)\n\n    # Store the result in memo for future use\n    _memo[n] = result\n    return result"}
