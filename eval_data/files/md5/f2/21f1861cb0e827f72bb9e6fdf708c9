{"task_id": "Mbpp/418", "solution": "def Find_Max(input_list: list):\n    \"\"\"\n    Finds the element in a list that has the maximum length.\n    Returns None if the input list is empty.\n    \"\"\"\n    if not input_list:\n        return None\n\n    max_length = -1\n    max_element = None\n\n    for element in input_list:\n        current_length = len(element)\n        if current_length > max_length:\n            max_length = current_length\n            max_element = element\n\n    return max_element"}
{"task_id": "Mbpp/415", "solution": "def max_Product(arr: list[int]) -> tuple[int, int]:\n    \"\"\"\n    Finds the pair of integers with the highest product from a given array.\n\n    Args:\n        arr: A list of integers.\n\n    Returns:\n        A tuple containing the two integers with the highest product.\n\n    Raises:\n        ValueError: If the input array contains fewer than two integers.\n    \"\"\"\n    if len(arr) < 2:\n        raise ValueError(\"Input array must contain at least two integers.\")\n\n    # Initialize variables to track the two largest and two smallest numbers.\n    max1 = float('-inf')\n    max2 = float('-inf')\n    min1 = float('inf')\n    min2 = float('inf')\n\n    for x in arr:\n        # Update the two largest numbers.\n        if x > max1:\n            max2 = max1\n            max1 = x\n        elif x > max2:\n            max2 = x\n\n        # Update the two smallest numbers.\n        if x < min1:\n            min2 = min1\n            min1 = x\n        elif x < min2:\n            min2 = x\n\n    # Calculate the product of the two largest and the two smallest numbers.\n    product_max_two = max1 * max2\n    product_min_two = min1 * min2\n\n    # Return the pair whose product is highest, ensuring the elements are in non-decreasing order.\n    if product_max_two >= product_min_two:\n        return (max2, max1)\n    else:\n        return (min1, min2)"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n: int) -> int:\n    \"\"\"\n    Computes the sum of cubes of the first n even natural numbers.\n    Returns the integer result.\n    \"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        even_number = 2 * i\n        total_sum += even_number ** 3\n    return total_sum"}
{"task_id": "Mbpp/419", "solution": "def round_and_sum(numbers: list) -> int:\n    \"\"\"\n    Processes a list of numbers to calculate the product of the sum of rounded numbers and the list's length.\n    This function orchestrates domain objects to perform the calculation.\n    \"\"\"\n\n    class Number:\n        def __init__(self, value: float):\n            self._value = value\n\n        def round(self) -> int:\n            return round(self._value)\n\n    class ListOfNumbers:\n        def __init__(self, values: list[float]):\n            self._numbers = [Number(val) for val in values]\n\n        def get_length(self) -> int:\n            return len(self._numbers)\n\n        def get_sum_of_rounded_values(self) -> int:\n            return sum(num.round() for num in self._numbers)\n\n    class CalculatedResult:\n        def __init__(self, sum_of_rounded_numbers: int, list_length: int, final_product: int):\n            self._sum_of_rounded_numbers = sum_of_rounded_numbers\n            self._list_length = list_length\n            self._final_product = final_product\n\n        def get_final_product(self) -> int:\n            return self._final_product\n\n    list_obj = ListOfNumbers(numbers)\n    list_length = list_obj.get_length()\n    sum_rounded = list_obj.get_sum_of_rounded_values()\n\n    final_product_value = sum_rounded * list_length\n    result_obj = CalculatedResult(sum_rounded, list_length, final_product_value)\n\n    return result_obj.get_final_product()"}
