{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number using dynamic programming based on Bell's triangle.\n    The Bell numbers count the number of partitions of a set with n elements.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Create a 2D table for Bell's triangle\n    # dp[i][j] stores the j-th number in the i-th row of Bell's triangle\n    dp = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # The first element of Bell's triangle (B_0) is 1\n    dp[0][0] = 1\n\n    # Fill the Bell's triangle\n    for i in range(1, n + 1):\n        # The first element of row i is the last element of row i-1\n        dp[i][0] = dp[i-1][i-1]\n        # Fill the rest of the row using the recurrence relation\n        for j in range(1, i + 1):\n            dp[i][j] = dp[i-1][j-1] + dp[i][j-1]\n\n    # The nth Bell number is the first element of the nth row (B_n)\n    return dp[n][0]"}
{"task_id": "Mbpp/607", "solution": "import re\ndef find_literals(input_string: str, regex_pattern: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Searches an input string for the first occurrence of a regex pattern.\n    Returns the matching substring, its start index, and its end index as a tuple.\n    \"\"\"\n    match = re.search(regex_pattern, input_string)\n    if match:\n        return (match.group(0), match.start(), match.end())\n    return None"}
{"task_id": "Mbpp/614", "solution": "def cummulative_sum(tuple_list: list[tuple[int | float, ...]]) -> int:\n    \"\"\"\n    Calculates the cumulative sum of all numerical values present in a list of tuples.\n    \"\"\"\n    total_sum = 0\n    for current_tuple in tuple_list:\n        for value in current_tuple:\n            total_sum += value\n    return int(total_sum)"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list: list, k: int) -> list:\n    \"\"\"\n    Removes the k-th element (1-based index) from a list and returns a new list.\n    The original list remains unmodified.\n    \"\"\"\n    index_to_remove = k - 1\n\n    if not (0 <= index_to_remove < len(input_list)):\n        raise IndexError(\"k is out of bounds for the given list.\")\n\n    return input_list[:index_to_remove] + input_list[index_to_remove + 1:]"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix: list[list[int]], n: int) -> int | None:\n    # Finds the maximum value in the n'th column of a matrix.\n    # Returns None if the column is empty or n is out of bounds for all rows.\n    if n < 0:\n        raise ValueError(\"Column index 'n' must be a non-negative integer.\")\n\n    if not matrix:\n        return None\n\n    max_value = None\n    column_found = False\n\n    for row in matrix:\n        if len(row) > n:\n            current_value = row[n]\n            if max_value is None or current_value > max_value:\n                max_value = current_value\n            column_found = True\n\n    if column_found:\n        return max_value\n    else:\n        return None"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(data: tuple[tuple[float | int, ...], ...]) -> list[float]:\n    \"\"\"\n    Calculates the average value for each inner tuple in a tuple of tuples.\n    Returns a list of these averages, with 0.0 for any empty inner tuples.\n    \"\"\"\n    averages = []\n    for inner_tuple in data:\n        if not inner_tuple:\n            averages.append(0.0)\n        else:\n            averages.append(sum(inner_tuple) / len(inner_tuple))\n    return averages"}
{"task_id": "Mbpp/618", "solution": "def div_list(list1, list2):\n    \"\"\"Divides two lists element-wise, returning a new list of floating-point results.\n    Raises ValueError if lengths differ, or ZeroDivisionError for division by zero.\"\"\"\n    if len(list1) != len(list2):\n        raise ValueError(\"Lists must have same length\")\n\n    result_list = []\n    for i in range(len(list1)):\n        if list2[i] == 0:\n            raise ZeroDivisionError(\"Division by zero\")\n        result_list.append(float(list1[i]) / list2[i])\n    return result_list"}
{"task_id": "Mbpp/619", "solution": "def move_num(input_string: str) -> str:\n    \"\"\"\n    Reorders an input string by moving all numeric characters to its end,\n    preserving the relative order of both numeric and non-numeric characters.\n    \"\"\"\n    def _is_numeric(char: str) -> bool:\n        \"\"\"Determines if a given character is a numeric digit.\"\"\"\n        return char.isdigit()\n\n    non_numeric_chars_list = []\n    numeric_chars_list = []\n\n    for char in input_string:\n        if _is_numeric(char):\n            numeric_chars_list.append(char)\n        else:\n            non_numeric_chars_list.append(char)\n\n    return \"\".join(non_numeric_chars_list) + \"\".join(numeric_chars_list)"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers: list[int]) -> int:\n    \"\"\"Calculates the size of the largest divisible subset from a given list of numbers.\n\n    A subset is considered 'divisible' if for any two distinct numbers 'a' and 'b'\n    within the subset, either 'a' is divisible by 'b' or 'b' is divisible by 'a'.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    numbers.sort()\n    n = len(numbers)\n    dp = [1] * n\n\n    for i in range(n):\n        for j in range(i):\n            if numbers[i] % numbers[j] == 0 or numbers[j] % numbers[i] == 0:\n                dp[i] = max(dp[i], dp[j] + 1)\n\n    return max(dp)"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise modulo on two tuples of the same length.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Tuples must be of the same length\")\n\n    result = []\n    for i in range(len(tuple1)):\n        result.append(tuple1[i] % tuple2[i])\n    return tuple(result)"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1: list[int], list2: list[int], n: int) -> float:\n    \"\"\"\n    Calculates the median of two sorted lists of the same size.\n\n    This function assumes that the input lists are already sorted and are of equal size 'n'.\n    It finds the median by conceptually merging the two lists and identifying the two middle\n    elements (at indices n-1 and n in the combined 0-indexed 2n-element list).\n    \"\"\"\n    i = 0  # Current index for list1\n    j = 0  # Current index for list2\n    m1 = -1  # To store the (n-1)-th element of the merged list (0-indexed)\n    m2 = -1  # To store the n-th element of the merged list (0-indexed)\n\n    # Iterate to find the n-th and (n+1)-th elements (1-indexed) of the merged list.\n    # These correspond to indices n-1 and n (0-indexed) in a 2n-element list.\n    for count in range(n + 1):\n        if i == n:  # list1 exhausted, take from list2\n            m1 = m2\n            m2 = list2[j]\n            j += 1\n        elif j == n:  # list2 exhausted, take from list1\n            m1 = m2\n            m2 = list1[i]\n            i += 1\n        elif list1[i] <= list2[j]:\n            m1 = m2\n            m2 = list1[i]\n            i += 1\n        else:\n            m1 = m2\n            m2 = list2[j]\n            j += 1\n\n    return float(m1 + m2) / 2.0"}
