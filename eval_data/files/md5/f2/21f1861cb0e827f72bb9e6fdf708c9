{"task_id": "Mbpp/12", "solution": "def sort_matrix(matrix):\n    class Row:\n        def __init__(self, elements):\n            self.elements = elements\n            self._sum = None\n\n        def calculateSum(self):\n            if self._sum is None:\n                self._sum = sum(self.elements)\n            return self._sum\n\n        def __lt__(self, other):\n            return self.calculateSum() < other.calculateSum()\n\n        def __eq__(self, other):\n            if not isinstance(other, Row):\n                return NotImplemented\n            return self.elements == other.elements\n\n    class Matrix:\n        def __init__(self, matrix_data):\n            self.rows = [Row(row_data) for row_data in matrix_data]\n\n        def sortRowsBySum(self):\n            self.rows.sort()\n            return [row.elements for row in self.rows]\n\n    matrix_obj = Matrix(matrix)\n    return matrix_obj.sortRowsBySum()"}
