{"task_id": "Mbpp/71", "solution": "def comb_sort(list_of_elements: list) -> list:\n    \"\"\"\n    Sorts a list of comparable elements in ascending order using the Comb Sort algorithm.\n    Returns a new sorted list.\n    \"\"\"\n    n = len(list_of_elements)\n    arr = list(list_of_elements)  # Create a copy to avoid modifying the original list\n\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        gap = max(1, int(gap / shrink_factor))\n        swapped = False\n\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    return arr"}
{"task_id": "Mbpp/74", "solution": "class Element:\n    \"\"\"Represents a single comparable item within a sequence.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def __eq__(self, other) -> bool:\n        if not isinstance(other, Element):\n            return False\n        return self.value == other.value\n\n    def __hash__(self) -> int:\n        return hash(self.value)\nclass Sequence:\n    \"\"\"Manages an ordered collection of elements.\"\"\"\n    def __init__(self, elements: list):\n        self._elements = [Element(e) for e in elements]\n\n    def __len__(self) -> int:\n        return len(self._elements)\n\n    def __getitem__(self, index: int) -> Element:\n        return self._elements[index]\nclass PatternChecker:\n    \"\"\"Implements core business rules to determine if a primary sequence adheres to a pattern sequence.\"\"\"\n    def check_pattern(self, primary: Sequence, pattern: Sequence) -> bool:\n        if len(primary) != len(pattern):\n            return False\n\n        pattern_to_primary_map = {} # Maps Element from pattern to Element from primary\n        primary_to_pattern_map = {} # Maps Element from primary to Element from pattern\n\n        for i in range(len(primary)):\n            p_elem = pattern[i]\n            s_elem = primary[i]\n\n            # Rule BR1/FR4: Identical pattern elements must map to identical primary elements.\n            if p_elem in pattern_to_primary_map:\n                if pattern_to_primary_map[p_elem] != s_elem:\n                    return False\n            else:\n                pattern_to_primary_map[p_elem] = s_elem\n\n            # Rule BR2/FR5: Distinct pattern elements must map to distinct primary elements.\n            if s_elem in primary_to_pattern_map:\n                if primary_to_pattern_map[s_elem] != p_elem:\n                    return False\n            else:\n                primary_to_pattern_map[s_elem] = p_elem\n        \n        return True\ndef is_samepatterns(primary_list: list, pattern_list: list) -> bool:\n    \"\"\"\n    Checks whether a primary sequence adheres to a given pattern sequence.\n    Returns True if the primary sequence adheres to the pattern, False otherwise.\n    \"\"\"\n    primary_sequence_obj = Sequence(primary_list)\n    pattern_sequence_obj = Sequence(pattern_list)\n    \n    checker = PatternChecker()\n    return checker.check_pattern(primary_sequence_obj, pattern_sequence_obj)"}
