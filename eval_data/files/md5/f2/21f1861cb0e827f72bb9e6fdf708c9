{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix_data: list[list[int]]) -> bool:\n    \"\"\"\n    Checks if the given matrix is a magic square.\n    This involves verifying it is square and all row, column, and diagonal sums are equal.\n    \"\"\"\n    class Matrix:\n        \"\"\"Encapsulates matrix data and provides methods for matrix-specific calculations.\"\"\"\n        def __init__(self, matrix_data_inner: list[list[int]]):\n            self._elements = matrix_data_inner\n            self._rows = len(matrix_data_inner) if matrix_data_inner else 0\n            self._columns = len(matrix_data_inner[0]) if self._rows > 0 else 0\n\n        def is_square(self) -> bool:\n            \"\"\"Determines if the matrix is a square matrix and not empty.\"\"\"\n            if self._rows == 0:\n                return False\n            if not all(len(row) == self._rows for row in self._elements):\n                return False\n            return self._rows == self._columns\n\n        def get_row_sum(self, row_index: int) -> int:\n            \"\"\"Calculates the sum of elements for a specific row.\"\"\"\n            return sum(self._elements[row_index])\n\n        def get_column_sum(self, col_index: int) -> int:\n            \"\"\"Calculates the sum of elements for a specific column.\"\"\"\n            return sum(self._elements[r][col_index] for r in range(self._rows))\n\n        def get_main_diagonal_sum(self) -> int:\n            \"\"\"Calculates the sum of elements for the main diagonal (top-left to bottom-right).\"\"\"\n            return sum(self._elements[i][i] for i in range(self._rows))\n\n        def get_anti_diagonal_sum(self) -> int:\n            \"\"\"Calculates the sum of elements for the anti-diagonal (top-right to bottom-left).\"\"\"\n            return sum(self._elements[i][self._rows - 1 - i] for i in range(self._rows))\n\n    class MagicSquareChecker:\n        \"\"\"Orchestrates checks to determine if a matrix is a magic square.\"\"\"\n        def check(self, matrix_obj_inner: Matrix) -> bool:\n            \"\"\"Determines if the given Matrix object is a magic square.\"\"\"\n            if not matrix_obj_inner.is_square():\n                return False\n\n            n = matrix_obj_inner._rows\n            \n            if n == 1: # A 1x1 matrix is trivially a magic square.\n                return True\n\n            expected_sum = matrix_obj_inner.get_row_sum(0)\n\n            # Check all row sums\n            for i in range(n):\n                if matrix_obj_inner.get_row_sum(i) != expected_sum:\n                    return False\n\n            # Check all column sums\n            for j in range(n):\n                if matrix_obj_inner.get_column_sum(j) != expected_sum:\n                    return False\n\n            # Check main diagonal sum\n            if matrix_obj_inner.get_main_diagonal_sum() != expected_sum:\n                return False\n\n            # Check anti-diagonal sum\n            if matrix_obj_inner.get_anti_diagonal_sum() != expected_sum:\n                return False\n\n            return True\n\n    matrix_obj = Matrix(matrix_data)\n    checker = MagicSquareChecker()\n    return checker.check(matrix_obj)"}
