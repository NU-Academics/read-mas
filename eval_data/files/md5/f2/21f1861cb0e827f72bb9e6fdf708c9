{"task_id": "Mbpp/631", "solution": "def replace_spaces(text: str) -> str:\n    \"\"\"\n    Replaces whitespaces with underscores, or underscores with spaces, based on content.\n    If common whitespaces (space, tab, newline) are present, they are replaced by underscores. Otherwise, if underscores are present, they are replaced by spaces.\n    \"\"\"\n    has_any_whitespace = any(ws_char in text for ws_char in [' ', '\\t', '\\n'])\n    has_underscore = '_' in text\n\n    if has_any_whitespace:\n        # If any whitespace is found, perform whitespace-to-underscore replacement.\n        result = text.replace(' ', '_')\n        result = result.replace('\\t', '_')\n        result = result.replace('\\n', '_')\n        return result\n    elif has_underscore:\n        # If no common whitespaces but underscores are found, perform underscore-to-space replacement.\n        return text.replace('_', ' ')\n    else:\n        # No relevant characters to replace.\n        return text"}
{"task_id": "Mbpp/629", "solution": "def Split(numbers):\n    \"\"\"\n    Finds even numbers from a list of numbers.\n    \"\"\"\n    even_numbers_list = []\n    for number in numbers:\n        if number % 2 == 0:\n            even_numbers_list.append(number)\n    return even_numbers_list"}
{"task_id": "Mbpp/630", "solution": "class Coordinate:\n    \"\"\"Represents a 2D coordinate and provides methods to find its adjacent coordinates.\"\"\"\n    def __init__(self, x: int, y: int) -> None:\n        self.x = x\n        self.y = y\n\n    def get_adjacent_coordinates(self) -> list[list[int]]:\n        \"\"\"Calculates and returns the 9 adjacent coordinates, including itself.\"\"\"\n        adjacent = []\n        for dx in [-1, 0, 1]:\n            for dy in [-1, 0, 1]:\n                adjacent.append([self.x + dx, self.y + dy])\n        return adjacent\ndef get_coordinates(coord_tuple: tuple[int, int]) -> list[list[int]]:\n    \"\"\"\n    Extracts all the adjacent coordinates of the given coordinate tuple.\n    It uses an internal Coordinate class to perform the calculation.\n    \"\"\"\n    x, y = coord_tuple\n    coord_obj = Coordinate(x, y)\n    return coord_obj.get_adjacent_coordinates()"}
