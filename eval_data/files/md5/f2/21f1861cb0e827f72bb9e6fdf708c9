{"task_id": "Mbpp/98", "solution": "def multiply_num(input_list: tuple | list) -> float:\n    \"\"\"\n    Multiplies all numbers in the input list and divides the product by the list's length.\n    Raises ValueError if the input_list is empty, to prevent division by zero.\n    \"\"\"\n    if not input_list:\n        raise ValueError(\"Input list cannot be empty for division.\")\n\n    product = 1.0\n    for num in input_list:\n        product *= num\n\n    list_length = len(input_list)\n    result = product / list_length\n    return result"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(data: list[tuple]) -> Any:\n    \"\"\"Given a list of tuples, returns the first value of the tuple with the smallest second value.\n    If multiple tuples share the smallest second value, the first encountered tuple wins.\"\"\"\n    min_second_value = data[0][1]\n    result_first_value = data[0][0]\n\n    for item in data[1:]:\n        if item[1] < min_second_value:\n            min_second_value = item[1]\n            result_first_value = item[0]\n\n    return result_first_value"}
{"task_id": "Mbpp/97", "solution": "def frequency_lists(input_list: list[list[any]]) -> dict[any, int]:\n    \"\"\"Calculates the frequency of each element in a nested list.\n\n    Args:\n        input_list: A list of lists, where inner lists contain elements of any type.\n\n    Returns:\n        A dictionary where keys are unique elements and values are their counts.\n    \"\"\"\n    frequencies = {}\n    for sub_list in input_list:\n        for element in sub_list:\n            frequencies[element] = frequencies.get(element, 0) + 1\n    return frequencies"}
{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks if an integer is an undulating number.\n    An undulating number has alternating digits (e.g., A-B-A-B) and no adjacent identical digits.\n    \"\"\"\n    digit_string = str(number)\n    length = len(digit_string)\n\n    if length < 3:\n        return False\n\n    # Check for alternating digits (digit[i] == digit[i+2])\n    for i in range(length - 2):\n        if digit_string[i] != digit_string[i+2]:\n            return False\n\n    # Check for adjacent non-equal digits (digit[i] != digit[i+1])\n    for i in range(length - 1):\n        if digit_string[i] == digit_string[i+1]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/93", "solution": "def power(base, exponent):\n    \"\"\"Calculates the value of base to the power of exponent.\"\"\"\n    # Handle cases where exponent is zero (BR1: a^0 = 1, including 0^0 = 1)\n    if exponent == 0:\n        return 1\n    \n    # Handle cases where base is zero (BR2: 0^b = 0 for b > 0)\n    if base == 0:\n        # Since exponent is not 0 (handled above), it must be > 0 here.\n        return 0\n        \n    # Calculate for positive integer exponents (BR3)\n    result = 1\n    for _ in range(exponent):\n        result *= base\n    \n    return result"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"Converts a decimal integer to its binary string representation.\n    The resulting string has no leading zeros, except for input 0 which returns '0'.\n    \"\"\"\n    if decimal_number == 0:\n        return '0'\n\n    binary_string = ''\n    temp_number = decimal_number\n    while temp_number > 0:\n        remainder = temp_number % 2\n        binary_string = str(remainder) + binary_string\n        temp_number //= 2\n    return binary_string"}
{"task_id": "Mbpp/100", "solution": "def is_palindrome(num: int) -> bool:\n    \"\"\"\n    Checks if an integer is a palindrome.\n    A palindrome reads the same forwards and backward.\n    \"\"\"\n    s = str(num)\n    return s == s[::-1]\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome strictly greater than the input integer.\n    \"\"\"\n    current_num = n + 1\n    while True:\n        if is_palindrome(current_num):\n            return current_num\n        current_num += 1"}
{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number a(n, m) using the sum formula.\n    This number counts permutations of {1, ..., n} with exactly m ascents.\n    \"\"\"\n\n    def combinations(n_val, k_val):\n        \"\"\"Calculates the binomial coefficient (n choose k).\"\"\"\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0 or k_val == n_val:\n            return 1\n        if k_val > n_val // 2:\n            k_val = n_val - k_val\n\n        res = 1\n        for i in range(k_val):\n            res = res * (n_val - i) // (i + 1)\n        return res\n\n    total_sum = 0\n    # The formula is A(n, m) = sum_{k=0}^{m} (-1)^k C(n+1, k) (m - k + 1)^n\n    for k in range(m + 1):\n        term = ((-1)**k) * combinations(n + 1, k) * ((m - k + 1)**n)\n        total_sum += term\n    \n    return total_sum"}
{"task_id": "Mbpp/101", "solution": "def kth_element(arr: list[float | int], k: int) -> float | int:\n    \"\"\"\n    Finds and returns the element at the specified 1-based index `k` in a given numerical array.\n    Raises ValueError if `k` is less than 1 or greater than the length of `arr`.\n    \"\"\"\n    if not (1 <= k <= len(arr)):\n        raise ValueError(\"Index k out of bounds\")\n    \n    # Convert 1-based index k to 0-based index\n    return arr[k - 1]"}
