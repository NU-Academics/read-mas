{"task_id": "Mbpp/259", "solution": "def maximize_elements(tuple1: tuple[tuple[int, ...], ...], tuple2: tuple[tuple[int, ...], ...]) -> tuple[tuple[int, ...], ...]:\n    \"\"\"Maximizes elements between two tuples of tuples.\n    Assumes tuple1 and tuple2 have an equal number of inner tuples and that all inner tuples have an equal number of elements.\n    \"\"\"\n    result_tuple = []\n    for i in range(len(tuple1)):\n        inner_tuple1 = tuple1[i]\n        inner_tuple2 = tuple2[i]\n        new_inner_tuple = []\n        for j in range(len(inner_tuple1)):\n            max_value = max(inner_tuple1[j], inner_tuple2[j])\n            new_inner_tuple.append(max_value)\n        result_tuple.append(tuple(new_inner_tuple))\n    return tuple(result_tuple)"}
{"task_id": "Mbpp/261", "solution": "def division_elements(tuple1: tuple[int | float, ...], tuple2: tuple[int | float, ...]) -> tuple[int | float, ...]:\n    \"\"\"\n    Performs element-wise mathematical division on two tuples.\n    Raises ValueError if tuples have different lengths or if division by zero occurs.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Tuples must have the same length for element-wise division.\")\n\n    results = []\n    for num, den in zip(tuple1, tuple2):\n        if den == 0:\n            raise ValueError(\"Division by zero is not allowed.\")\n        results.append(num / den)\n\n    return tuple(results)"}
{"task_id": "Mbpp/260", "solution": "def newman_prime(n: int) -> int:\n    \"\"\"Finds the nth Newman-Shanks-Williams prime number, where 'n' refers to the index 'k' in the S_k sequence.\n    It is assumed that for the given 'n', S_n will always be a prime number.\n    \"\"\"\n\n    def _is_prime(num: int) -> bool:\n        \"\"\"Determines if a given number is prime.\"\"\"\n        if num < 2:\n            return False\n        for i in range(2, int(num**0.5) + 1):\n            if num % i == 0:\n                return False\n        return True\n\n    def _calculate_nsw_sequence_term(k: int) -> int:\n        \"\"\"Calculates the k-th term of the Newman-Shanks-Williams sequence (S_k).\"\"\"\n        if k == 0:\n            return 1\n        if k == 1:\n            return 1\n\n        s_k_minus_2 = 1  # Corresponds to S_0\n        s_k_minus_1 = 1  # Corresponds to S_1\n\n        for _ in range(2, k + 1):\n            s_k = 2 * s_k_minus_1 + s_k_minus_2\n            s_k_minus_2 = s_k_minus_1\n            s_k_minus_1 = s_k\n        \n        return s_k_minus_1\n\n    # Based on the specific assertion newman_prime(3) == 7,\n    # 'n' directly maps to the index 'k' of the NSW number S_k.\n    nsw_number = _calculate_nsw_sequence_term(n)\n    \n    # The design context implies calling _is_prime.\n    # Given the problem's phrasing and no exception handling, it's assumed nsw_number will be prime.\n    _is_prime(nsw_number) \n\n    return nsw_number"}
