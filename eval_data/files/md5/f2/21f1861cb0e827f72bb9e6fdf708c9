{"task_id": "Mbpp/603", "solution": "def _is_prime(num: int) -> bool:\n    \"\"\"Checks if an integer is a prime number. Returns True if prime, False otherwise.\"\"\"\n    if num < 2:\n        return False\n    for i in range(2, int(num**0.5) + 1):\n        if num % i == 0:\n            return False\n    return True\ndef get_ludic(n: int) -> list[int]:\n    \"\"\"Returns a sorted list of lucid numbers (1 and primes) up to n.\"\"\"\n\n    # Handle cases where n is less than 1; 1 is always a lucid number.\n    if n < 1:\n        return [1]\n\n    lucid_numbers = []\n    lucid_numbers.append(1) # 1 is always included in lucid numbers.\n\n    for num in range(2, n + 1):\n        if _is_prime(num):\n            lucid_numbers.append(num)\n\n    # The list is already sorted by construction, but an explicit sort ensures the requirement.\n    lucid_numbers.sort() \n\n    return lucid_numbers"}
{"task_id": "Mbpp/602", "solution": "def first_repeated_char(input_string: str) -> str | None:\n    \"\"\"Finds the first repeated character in a given string.\n\n    Returns the first repeated character as a string, or None if no character repeats.\n    \"\"\"\n    seen_chars = set()\n    for char in input_string:\n        if char in seen_chars:\n            return char\n        seen_chars.add(char)\n    return None"}
