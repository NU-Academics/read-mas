{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(input_list: list) -> int:\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists of a given list.\n\n    Args:\n        input_list: A list of numbers (integers or floats).\n\n    Returns:\n        The total sum of products of all sublists. Returns 0 if the input list is empty.\n    \"\"\"\n    total_sum = 0\n    n = len(input_list)\n\n    if n == 0:\n        return 0\n\n    # Iterate through all possible start points\n    for i in range(n):\n        current_product = 1\n        # Iterate through all possible end points from the current start point\n        for j in range(i, n):\n            current_product *= input_list[j]\n            total_sum += current_product\n\n    return total_sum"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sorted_list, value):\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted list using binary search.\n    The returned index indicates where 'value' should be inserted to maintain sorted order,\n    placing it before any existing equal elements.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else: # sorted_list[mid] >= value\n            high = mid\n    return low"}
{"task_id": "Mbpp/735", "solution": "def _get_msb_position(number: int) -> int:\n    \"\"\"Determines the position of the most significant bit (leftmost '1') in the given integer. Returns -1 if the number is zero.\"\"\"\n    if number == 0:\n        return -1\n    return number.bit_length() - 1\ndef _get_lsb_position(number: int) -> int:\n    \"\"\"Determines the position of the least significant bit (rightmost '1') in the given integer. Returns -1 if the number is zero.\"\"\"\n    if number == 0:\n        return -1\n    # number & -number isolates the lowest set bit.\n    # Then bit_length() - 1 gives its 0-indexed position.\n    return (number & -number).bit_length() - 1\ndef toggle_middle_bits(number: int) -> int:\n    \"\"\"\n    Toggles bits of the number except the first and the last bit.\n    The first bit is the MSB and the last bit is the LSB.\n    \"\"\"\n    if number <= 0:\n        # For non-positive numbers, MSB/LSB definitions can be ambiguous or irrelevant for this problem.\n        # Returning the number itself or 0 for 0 is a reasonable default.\n        return number\n\n    msb_pos = _get_msb_position(number)\n    lsb_pos = _get_lsb_position(number)\n\n    # Create a mask for bits strictly between lsb_pos and msb_pos.\n    # If msb_pos <= lsb_pos + 1, there are no bits in between, so the mask remains 0.\n    mask = 0\n    for i in range(lsb_pos + 1, msb_pos):\n        mask |= (1 << i)\n\n    # Toggle the bits using XOR with the generated mask.\n    return number ^ mask"}
