{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth Jacobsthal number using an iterative approach.\n    The sequence is defined by J(0) = 0, J(1) = 1, and J(n) = J(n-1) + 2 * J(n-2) for n > 1.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    a, b = 0, 1  # J(0), J(1)\n    for _ in range(2, n + 1):\n        a, b = b, a + 2 * b\n    return a"}
{"task_id": "Mbpp/749", "solution": "def sort_numeric_strings(numeric_string_list: list[str]) -> list[int]:\n    \"\"\"\n    Converts a list of numeric strings to integers and sorts them numerically in ascending order.\n    Returns a new list containing the sorted integer representations.\n    \"\"\"\n    integer_list = [int(s) for s in numeric_string_list]\n    integer_list.sort()\n    return integer_list"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(array: list) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    \"\"\"\n    n = len(array)\n    if n <= 1:\n        return True\n\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        if left_child_idx < n and array[i] > array[left_child_idx]:\n            return False\n\n        if right_child_idx < n and array[i] > array[right_child_idx]:\n            return False\n    return True"}
{"task_id": "Mbpp/753", "solution": "def min_k(input_list_of_tuples: list[tuple], k_value: int) -> list[tuple]:\n    \"\"\"\n    Finds and returns k tuples with the smallest integer values from a list of tuples,\n    sorted in ascending order based on their integer values.\n    \"\"\"\n    if not input_list_of_tuples or k_value <= 0:\n        return []\n\n    sorted_list = sorted(input_list_of_tuples, key=lambda x: x[1])\n\n    return sorted_list[:k_value]"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds common elements from three lists that appear at the same index.\n    Returns a new list containing elements that are common across l1, l2, and l3 at the same index.\n    \"\"\"\n    common_elements = []\n    min_length = min(len(l1), len(l2), len(l3))\n    for i in range(min_length):\n        if l1[i] == l2[i] == l3[i]:\n            common_elements.append(l1[i])\n    return common_elements"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(numbers: list) -> int | float:\n    \"\"\"Finds the second smallest number in a list of numbers.\n    Extracts unique elements, sorts them, and returns the second element.\n    \"\"\"\n    unique_numbers = sorted(list(set(numbers)))\n    return unique_numbers[1]"}
{"task_id": "Mbpp/759", "solution": "def is_decimal(input_string: str) -> bool:\n    \"\"\"\n    Checks if the given string is a decimal number with a precision of exactly 2.\n    This function uses a regular expression to validate the format.\n    \"\"\"\n    import re\n    pattern = r\"^[+-]?\\d+\\.\\d{2}$\"\n    return bool(re.fullmatch(pattern, input_string))"}
{"task_id": "Mbpp/758", "solution": "def unique_sublists(input_list: list) -> dict:\n    \"\"\"\n    Counts lists within a list, converting them to tuples, and returns a dictionary\n    of tuple counts.\n    \"\"\"\n    from collections import Counter\n\n    counts = Counter()\n    for sublist in input_list:\n        counts[tuple(sublist)] += 1\n    return dict(counts)"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"Counts unique pairs of reverse strings in a given list.\n\n    It uses a set to track found pairs to ensure uniqueness and order independence.\n    \"\"\"\n    count = 0\n    found_pairs = set()\n    string_set = set(string_list)\n\n    for s1 in string_list:\n        s1_reversed = s1[::-1]\n\n        # Check if the reversed string exists in the set of original strings\n        # and ensure it's not the same string (e.g., \"madam\" is not its own pair).\n        if s1_reversed in string_set and s1_reversed != s1:\n            # Use a frozenset to create a canonical representation of the pair,\n            # ensuring order-independence ({\"a\", \"b\"} is same as {\"b\", \"a\"})\n            # and allowing it to be added to a set for uniqueness checks.\n            canonical_pair = frozenset({s1, s1_reversed})\n\n            if canonical_pair not in found_pairs:\n                found_pairs.add(canonical_pair)\n                count += 1\n    return count"}
{"task_id": "Mbpp/762", "solution": "def check_monthnumber_number(month_number: int) -> bool:\n    \"\"\"\n    Checks if the given month number contains 30 days.\n\n    Args:\n        month_number: An integer representing the month (1 for January, 12 for December).\n\n    Returns:\n        True if the month has 30 days, False otherwise.\n\n    Raises:\n        ValueError: If month_number is not between 1 and 12.\n    \"\"\"\n    if not (1 <= month_number <= 12):\n        raise ValueError(\"Month number must be between 1 and 12\")\n\n    # Months with 30 days are April (4), June (6), September (9), November (11).\n    return month_number in {4, 6, 9, 11}"}
{"task_id": "Mbpp/760", "solution": "def unique_Element(numbers: list) -> bool:\n    \"\"\"\n    Checks if a list of numbers contains only one distinct element.\n    Returns True if the list is empty or has multiple distinct elements.\n    \"\"\"\n    if not numbers:\n        return False\n    \n    first_element = numbers[0]\n    for num in numbers:\n        if num != first_element:\n            return False\n    return True"}
{"task_id": "Mbpp/765", "solution": "def find_nth_polite_number(n: int) -> int:\n    \"\"\"Calculates the nth polite number.\n    A polite number is a positive integer that is not a power of two.\"\"\"\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n\n    count = 0\n    current_number = 1\n    while True:\n        # A number x is a power of two if x > 0 and (x & (x - 1)) == 0\n        if current_number > 0 and not ((current_number & (current_number - 1)) == 0):\n            count += 1\n            if count == n:\n                return current_number\n        current_number += 1"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(collection, length):\n    \"\"\"\n    Finds the minimum absolute difference between any two elements in the given collection.\n    Assumes valid numeric input and length >= 2.\n    \"\"\"\n    min_diff = float('inf')\n\n    # Sort the collection to optimize the search for minimum difference\n    # and to ensure pairs are unique (though sorting isn't strictly necessary for correctness,\n    # it can improve performance for some comparison patterns, but simple nested loops are fine too).\n    # Based on the sequence diagram, we iterate through *all unique pairs* so sorting isn't implied as a requirement.\n    # However, for an optimal algorithm, sorting is usually the first step for this problem.\n    # Given the explicit iteration through *all unique pairs* in the design, we'll stick to nested loops\n    # to directly satisfy that aspect of the design for pedagogical clarity, without premature optimization unless stated.\n\n    # If sorting was used:\n    # sorted_collection = sorted(collection)\n    # for i in range(length - 1):\n    #     current_diff = abs(sorted_collection[i+1] - sorted_collection[i])\n    #     if current_diff < min_diff:\n    #         min_diff = current_diff\n    # return min_diff\n\n    # Sticking to general pairwise comparison as per sequence diagram:\n    for i in range(length):\n        for j in range(i + 1, length):  # Ensures unique pairs (i, j) where i < j\n            current_diff = abs(collection[i] - collection[j])\n            if current_diff < min_diff:\n                min_diff = current_diff\n\n    return min_diff"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(input_string: str) -> int:\n    \"\"\"Counts the occurrences of digit characters within an input string.\"\"\"\n    digit_count = 0\n    for char in input_string:\n        if char.isdigit():\n            digit_count += 1\n    return digit_count"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list: list) -> list[tuple]:\n    \"\"\"\n    Returns a list of all pairs of consecutive items in a given list.\n    Returns an empty list if the input_list has fewer than two items.\n    \"\"\"\n    result = []\n    if len(input_list) < 2:\n        return result\n\n    for i in range(len(input_list) - 1):\n        result.append((input_list[i], input_list[i+1]))\n    return result"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n):\n    \"\"\"\n    Calculates the sum of the fourth power of the first 'n' odd natural numbers.\n    Assumes n is a natural number (n >= 1).\n    \"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        # The i-th odd natural number is 2*i - 1\n        odd_num = 2 * i - 1\n        total_sum += odd_num ** 4\n    return total_sum"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list[int], target_sum: int) -> int:\n    \"\"\"\n    Counts the number of unique pairs in a list whose sum equals the target_sum.\n\n    Args:\n        numbers: A list of integers.\n        target_sum: The integer target sum.\n\n    Returns:\n        An integer representing the total count of unique pairs (by index).\n    \"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):  # Start j from i + 1 to ensure unique pairs by index\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n    return count"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1: list, list2: list) -> list:\n    \"\"\"\n    Calculates the difference between two lists, preserving their original relative order.\n    Returns a new list containing elements from list1 that are not present in list2.\n    \"\"\"\n    result = []\n    set2 = set(list2)\n    for item in list1:\n        if item not in set2:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(main_string: str, substring: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Finds the first occurrence and position of a substring within a main string.\n    Returns a tuple (matched_value, start_index, end_index) if a match is found, otherwise None.\n    \"\"\"\n    if not main_string or not substring:\n        return None\n\n    start_index = main_string.find(substring)\n\n    if start_index != -1:\n        end_index = start_index + len(substring)\n        return (substring, start_index, end_index)\n    else:\n        return None"}
{"task_id": "Mbpp/771", "solution": "DELIMITER_PAIRS = {\n    '(': ')',\n    '[': ']',\n    '{': '}',\n}\nOPENING_DELIMITERS = set(DELIMITER_PAIRS.keys())\nCLOSING_DELIMITERS = set(DELIMITER_PAIRS.values())\ndef check_expression(expression_string: str) -> bool:\n    \"\"\"\n    Checks if the given expression string has balanced and properly nested delimiters.\n    It uses a stack to keep track of opening delimiters and match them with closing ones.\n    \"\"\"\n    stack = []\n    for char in expression_string:\n        if char in OPENING_DELIMITERS:\n            stack.append(char)\n        elif char in CLOSING_DELIMITERS:\n            if not stack:\n                return False\n            \n            last_open = stack.pop()\n            if DELIMITER_PAIRS[last_open] != char:\n                return False\n                \n    return len(stack) == 0"}
{"task_id": "Mbpp/772", "solution": "def remove_length(input_string: str, k: int) -> str:\n    \"\"\"Removes words of length k from the input string and returns the result.\"\"\"\n    words = input_string.split()\n    filtered_words = [word for word in words if len(word) != k]\n    return ' '.join(filtered_words)"}
{"task_id": "Mbpp/775", "solution": "def odd_position(numbers: list) -> bool:\n    \"\"\"\n    Checks if every number at an odd index in the list is an odd number.\n    Returns False if an even number is found at an odd index, otherwise True.\n    \"\"\"\n    for i in range(len(numbers)):\n        if (i + 1) % 2 != 0:  # Check if the index is odd (1-based for problem statement interpretation)\n            # The problem statement \"odd index\" commonly refers to 1-based indexing\n            # for \"first\", \"third\", \"fifth\" elements. Python uses 0-based indexing.\n            # So, 1st element is at index 0, 3rd at index 2, 5th at index 4 etc.\n            # Thus, for Python's 0-based index `i`, we check if `(i + 1)` is odd.\n            # i.e., indices 0, 2, 4, ... are \"odd positions\" (1st, 3rd, 5th...)\n            # However, the assert `odd_position([2,1,4,3,6,7,6,3]) == True` implies\n            # a 0-based interpretation where index 1 (value 1), index 3 (value 3), index 5 (value 7), index 7 (value 3)\n            # are checked. All these values are odd.\n            # Let's align with the assert: \"every odd index\" means 0-based index 1, 3, 5, ...\n            pass # this branch (for 1-based odd positions) is not needed based on assert\n        \n        # Based on the assert odd_position([2,1,4,3,6,7,6,3]) == True:\n        # Index 0: 2 (even index, skip check)\n        # Index 1: 1 (odd index, value 1 is odd - OK)\n        # Index 2: 4 (even index, skip check)\n        # Index 3: 3 (odd index, value 3 is odd - OK)\n        # Index 4: 6 (even index, skip check)\n        # Index 5: 7 (odd index, value 7 is odd - OK)\n        # Index 6: 6 (even index, skip check)\n        # Index 7: 3 (odd index, value 3 is odd - OK)\n\n        if i % 2 != 0:  # Check if the 0-based index `i` is odd\n            if numbers[i] % 2 == 0:  # If the number at this odd index is even\n                return False\n    return True"}
{"task_id": "Mbpp/780", "solution": "def find_combinations(tuple_list: list[tuple[int | float, int | float]]) -> list[tuple[int | float, int | float]]:\n    \"\"\"\n    Calculates all unique element-wise sums of distinct tuple pairs from an input list.\n    \"\"\"\n    results = []\n    n = len(tuple_list)\n    for i in range(n):\n        for j in range(i + 1, n):\n            t1 = tuple_list[i]\n            t2 = tuple_list[j]\n            sum_tuple = (t1[0] + t2[0], t1[1] + t2[1])\n            results.append(sum_tuple)\n    return results"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list) -> list[list]:\n    \"\"\"\n    Packs consecutive duplicate elements of a given list into sublists.\n    Each sublist contains one or more identical, consecutive elements from the original list.\n    \"\"\"\n    output_list = []\n    current_sublist = []\n\n    for element in input_list:\n        if not current_sublist or element == current_sublist[-1]:\n            current_sublist.append(element)\n        else:\n            output_list.append(current_sublist)\n            current_sublist = [element]\n\n    if current_sublist:\n        output_list.append(current_sublist)\n\n    return output_list"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list) -> int:\n    \"\"\"\n    Calculates the sum of all elements across all odd-length contiguous subarrays within an input list.\n    This implementation iterates through all possible subarrays and sums elements of those with odd lengths.\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):  # i is the start index\n        for j in range(i, n):  # j is the end index\n            # Extract the subarray\n            subarray = arr[i : j + 1]\n            \n            # Check if its length is odd\n            if len(subarray) % 2 != 0:\n                total_sum += sum(subarray)\n    \n    return total_sum"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(N: int) -> bool:\n    \"\"\"\n    Checks if the count of positive divisors for a given integer N is even.\n    The function iterates up to the square root of N to find divisors efficiently.\n    \"\"\"\n    count = 0\n    i = 1\n    while i * i <= N:\n        if N % i == 0:\n            if i * i == N:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count % 2 == 0"}
