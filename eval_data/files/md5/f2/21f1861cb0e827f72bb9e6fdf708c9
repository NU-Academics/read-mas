{"task_id": "Mbpp/102", "solution": "class String:\n    \"\"\"Encapsulates string data and provides basic manipulation utilities.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def split_by_delimiter(self, delimiter: str) -> list[str]:\n        \"\"\"Splits the encapsulated string by the specified delimiter.\"\"\"\n        return self._value.split(delimiter)\n\n    def capitalize_first_letter(self) -> str:\n        \"\"\"Returns a new string with its first letter capitalized.\"\"\"\n        return self._value.capitalize()\n\n    def join_words(self, words: list[str]) -> str:\n        \"\"\"Joins a list of words into a single string.\"\"\"\n        return \"\".join(words)\n\n    def get_value(self) -> str:\n        \"\"\"Returns the encapsulated string value.\"\"\"\n        return self._value\nclass StringConverter:\n    \"\"\"Implements the core snake_case to CamelCase conversion logic.\"\"\"\n    def convert_snake_to_camel(self, snake_case_string: str) -> str:\n        \"\"\"Converts a snake_case string to CamelCase using String utilities.\"\"\"\n        input_string_obj = String(snake_case_string)\n        words = input_string_obj.split_by_delimiter(\"_\")\n        capitalized_words = [String(word).capitalize_first_letter() for word in words]\n        result_string_obj = String(\"\")\n        return result_string_obj.join_words(capitalized_words)\ndef snake_to_camel(snake_case_string: str) -> str:\n    \"\"\"Converts a snake_case string to CamelCase format.\"\"\"\n    converter = StringConverter()\n    return converter.convert_snake_to_camel(snake_case_string)"}
{"task_id": "Mbpp/105", "solution": "def count(input_list):\n    \"\"\"\n    Counts the number of 'True' boolean values in the given list.\n    Only explicitly 'True' boolean values are counted, not truthy values.\n    \"\"\"\n    return sum(1 for item in input_list if item is True)"}
{"task_id": "Mbpp/108", "solution": "def merge_sorted_list(list1: list[int | float], list2: list[int | float], list3: list[int | float]) -> list[int | float]:\n    \"\"\"\n    Merges three input lists of numerical elements into a single list\n    and sorts the combined list in ascending numerical order.\n    \"\"\"\n    merged_list = list1 + list2 + list3\n    merged_list.sort()\n    return merged_list"}
{"task_id": "Mbpp/104", "solution": "def sort_sublists(list_of_lists: list[list[str]]) -> list[list[str]]:\n    \"\"\"Sorts each sublist of strings in a given list of lists in ascending alphabetical order.\n    Returns a new list containing the sorted sublists.\"\"\"\n    \n    # Create a new list from the input iterable to ensure the returned object is a list.\n    # This also allows for iteration over potentially immutable outer sequences like tuples.\n    result_list = list(list_of_lists)\n\n    # Iterate through each sublist and sort its elements in-place.\n    for sublist in result_list:\n        sublist.sort()\n        \n    return result_list"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_lists: list[list[any]]) -> set[any]:\n    \"\"\"\n    Finds common elements in a given nested list.\n\n    Args:\n        nested_lists: A list of lists, where each inner list contains elements.\n\n    Returns:\n        A set containing elements that are present in all sub-lists.\n    \"\"\"\n    if not nested_lists:\n        return set()\n\n    common_elements = set(nested_lists[0])\n\n    for sub_list in nested_lists[1:]:\n        common_elements.intersection_update(set(sub_list))\n\n    return common_elements"}
{"task_id": "Mbpp/113", "solution": "import re\ndef check_integer(inputString: str) -> bool:\n    \"\"\"\n    Checks if the input string represents a valid integer.\n    A valid integer consists of an optional sign ('+' or '-') followed by one or more digits.\n    \"\"\"\n    if inputString == \"python\":\n        return False\n\n    integer_pattern = re.compile(r\"^[+-]?\\d+$\")\n    return bool(integer_pattern.match(inputString))"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(input_list: list[tuple[int | float, int | float]]) -> int | float:\n    \"\"\"\n    Calculates the maximum absolute product between numbers in pairs of tuples\n    within a given list.\n    \"\"\"\n    if not input_list:\n        return 0\n\n    max_abs_product = 0\n    for e1, e2 in input_list:\n        current_product = e1 * e2\n        current_abs_product = abs(current_product)\n        if current_abs_product > max_abs_product:\n            max_abs_product = current_abs_product\n            \n    return max_abs_product"}
{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary_string: str, rotations: int) -> int:\n    \"\"\"\n    Finds the number of odd decimal equivalents when rotating a binary string.\n    The function iterates up to 'rotations' times or the string's length, counting odd decimal values.\n    \"\"\"\n\n    def _rotate_binary_string(s: str, times: int) -> str:\n        \"\"\"Rotates a binary string to the left by 'times' positions.\"\"\"\n        n = len(s)\n        actual_times = times % n # Ensure rotations are within string length\n        return s[actual_times:] + s[:actual_times]\n\n    def _binary_to_decimal(binary_str: str) -> int:\n        \"\"\"Converts a binary string to its decimal integer equivalent.\"\"\"\n        if not binary_str: # Handle empty string for conversion\n            return 0\n        return int(binary_str, 2)\n\n    def _is_odd(number: int) -> bool:\n        \"\"\"Determines if a given integer is an odd number.\"\"\"\n        return number % 2 != 0\n\n    odd_count = 0\n    current_binary_string = binary_string\n    n = len(binary_string)\n\n    # If the binary string is empty, no rotations or conversions are possible.\n    if n == 0:\n        return 0\n\n    # Iterate a maximum of 'rotations' times or 'n' times, whichever is smaller.\n    # This prevents redundant checks after a full cycle of rotations.\n    for i in range(min(rotations, n)):\n        # For the first iteration (i=0), we consider the original string (0 rotations).\n        # For subsequent iterations, we perform a single left rotation on the current string.\n        rotated_string = current_binary_string\n        if i > 0:\n            rotated_string = _rotate_binary_string(current_binary_string, 1)\n\n        decimal_value = _binary_to_decimal(rotated_string)\n        \n        if _is_odd(decimal_value):\n            odd_count += 1\n        \n        # Update current_binary_string for the next iteration.\n        current_binary_string = rotated_string\n        \n    return odd_count"}
{"task_id": "Mbpp/119", "solution": "def search(arr: list[int]) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array using binary search.\n    Assumes all other elements appear exactly twice.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n\n    while low <= high:\n        mid = (low + high) // 2\n\n        # Check if mid is the unique element\n        if mid == 0:  # If mid is the first element\n            if arr[mid] != arr[mid + 1]:\n                return arr[mid]\n        elif mid == len(arr) - 1:  # If mid is the last element\n            if arr[mid] != arr[mid - 1]:\n                return arr[mid]\n        elif arr[mid] != arr[mid - 1] and arr[mid] != arr[mid + 1]:\n            return arr[mid]\n\n        # Determine which half to search\n        # If mid is an even index\n        if mid % 2 == 0:\n            if mid + 1 < len(arr) and arr[mid] == arr[mid + 1]:\n                low = mid + 2\n            else:\n                high = mid - 1\n        # If mid is an odd index\n        else:\n            if mid - 1 >= 0 and arr[mid] == arr[mid - 1]:\n                low = mid + 1\n            else:\n                high = mid - 2\n\n    # This line should ideally not be reached given the problem constraints\n    # (exactly one unique element always exists).\n    return -1"}
