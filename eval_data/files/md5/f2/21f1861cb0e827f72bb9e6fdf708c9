{"task_id": "Mbpp/590", "solution": "import math\ndef polar_rect(radius: float, angle: float) -> tuple[float, float]:\n    \"\"\"\n    Converts polar coordinates (radius, angle) to rectangular coordinates (x, y).\n    The angle component is expected in radians.\n    \"\"\"\n    x = radius * math.cos(angle)\n    y = radius * math.sin(angle)\n    return (x, y)"}
{"task_id": "Mbpp/597", "solution": "def find_kth(arr1: list[int], arr2: list[int], k: int) -> int:\n    \"\"\"Finds the kth smallest element from two sorted arrays.\n    It combines and sorts the arrays, then returns the element at the (k-1)th index.\"\"\"\n    merged_list = sorted(arr1 + arr2)\n    return merged_list[k - 1]"}
{"task_id": "Mbpp/598", "solution": "class Number:\n    \"\"\"Internal class to encapsulate number properties and Armstrong logic.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def get_digits(self) -> list[int]:\n        \"\"\"Returns a list of the number's individual digits.\"\"\"\n        return [int(d) for d in str(self._value)]\n\n    def get_number_of_digits(self) -> int:\n        \"\"\"Returns the count of digits in the number.\"\"\"\n        return len(str(self._value))\n\n    def is_armstrong(self) -> bool:\n        \"\"\"Determines if the number is an Armstrong number.\"\"\"\n        num_digits = self.get_number_of_digits()\n        digits = self.get_digits()\n        armstrong_sum = sum(d ** num_digits for d in digits)\n        return armstrong_sum == self._value\ndef armstrong_number(number: int) -> bool:\n    \"\"\"Checks if the given number is an Armstrong number.\"\"\"\n    number_obj = Number(number)\n    return number_obj.is_armstrong()"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n: int) -> tuple[int, float]:\n    \"\"\"\n    Calculates the sum and average of the first 'n' natural numbers.\n    \"\"\"\n    calculated_sum = n * (n + 1) // 2\n    calculated_average = float(calculated_sum) / n\n    return (calculated_sum, calculated_average)"}
