{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of squares of the first n even natural numbers.\n    Raises ValueError if n is negative.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input n must be a non-negative integer.\")\n    \n    sum_of_squares = 0\n    for i in range(1, n + 1):\n        even_num = 2 * i\n        sum_of_squares += even_num ** 2\n        \n    return sum_of_squares"}
{"task_id": "Mbpp/286", "solution": "def max_sub_array_sum_repeated(arr: list[int], k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in the array formed by repeating `arr` `k` times.\n    This function handles single repetitions and multiple repetitions by leveraging helper functions.\n    \"\"\"\n\n    def _kadane(current_arr: list[int]) -> int:\n        \"\"\"Applies Kadane's algorithm to find the maximum subarray sum in a given array.\"\"\"\n        max_so_far = -float('inf')\n        current_max = 0\n        has_positive = False\n        max_val = -float('inf')\n\n        for x in current_arr:\n            current_max += x\n            max_val = max(max_val, x) # Track max single element in case all are negative\n            if current_max < 0:\n                current_max = 0\n            else:\n                has_positive = True\n            max_so_far = max(max_so_far, current_max)\n        \n        if not has_positive and max_val < 0: # All elements are negative or zero, result is the largest single element\n            return max_val\n        return max_so_far if max_so_far != 0 else max(0, max_val) # If all elements are positive, max_so_far will be the sum\n\n    def _max_prefix_sum(current_arr: list[int]) -> int:\n        \"\"\"Calculates the maximum prefix sum of an array.\"\"\"\n        current_sum = 0\n        max_p_sum = 0\n        for x in current_arr:\n            current_sum += x\n            max_p_sum = max(max_p_sum, current_sum)\n        return max_p_sum\n\n    def _max_suffix_sum(current_arr: list[int]) -> int:\n        \"\"\"Calculates the maximum suffix sum of an array.\"\"\"\n        current_sum = 0\n        max_s_sum = 0\n        for x in reversed(current_arr):\n            current_sum += x\n            max_s_sum = max(max_s_sum, current_sum)\n        return max_s_sum\n\n    def _total_sum(current_arr: list[int]) -> int:\n        \"\"\"Calculates the sum of all elements in an array.\"\"\"\n        return sum(current_arr)\n\n    if k == 1:\n        return _kadane(arr)\n\n    # For k > 1\n    # Check max subarray sum within two repetitions (covers cases where sub-array spans across boundary once)\n    max_sum_double_arr = _kadane(arr + arr)\n\n    total = _total_sum(arr)\n    \n    # If the total sum of the array is positive, we can extend the prefix and suffix sums\n    if total > 0:\n        max_prefix = _max_prefix_sum(arr)\n        max_suffix = _max_suffix_sum(arr)\n        # The formula (k-2)*total_sum assumes k >= 2. If k is 2, (k-2) becomes 0,\n        # and the sum is just max_prefix + max_suffix. This is implicitly handled.\n        return max(max_sum_double_arr, max_prefix + (k - 2) * total + max_suffix)\n    else:\n        # If the total sum is non-positive, repeating the array more than twice will not increase the sum.\n        # The maximum sum will be found within `arr` or `arr + arr`.\n        return max_sum_double_arr"}
{"task_id": "Mbpp/290", "solution": "def max_length(list_of_lists: list[list[int]]) -> tuple[int, list[int]]:\n    \"\"\"\n    Finds the list with the maximum length in a list of lists and returns its length and the list itself.\n    Returns (-1, None) if the input list of lists is empty.\n    \"\"\"\n    max_len = -1\n    result_list = None\n\n    for sub_list in list_of_lists:\n        current_len = len(sub_list)\n        if current_len > max_len:\n            max_len = current_len\n            result_list = sub_list\n            \n    return (max_len, result_list)"}
