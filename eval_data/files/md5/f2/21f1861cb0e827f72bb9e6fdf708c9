{"task_id": "Mbpp/440", "solution": "import string\nfrom typing import List, Tuple, Optional\ndef _strip_punctuation(word: str) -> str:\n    \"\"\"Removes leading and trailing punctuation from a word.\"\"\"\n    return word.strip(string.punctuation)\ndef _is_adverb(word: str) -> bool:\n    \"\"\"Determines if a word is an adverb. (Placeholder implementation)\"\"\"\n    if len(word) > 2 and word.endswith('ly'):\n        return True\n    return False\ndef _tokenize_sentence(sentence: str) -> List[Tuple[str, int, int]]:\n    \"\"\"Splits a sentence into words and tracks their original positions.\n    Returns a list of (original_word, start_index, end_index) tuples.\n    \"\"\"\n    tokens = []\n    current_pos = 0\n    for word_with_punctuation in sentence.split(' '):\n        if not word_with_punctuation:\n            current_pos += 1\n            continue\n\n        start_index = sentence.find(word_with_punctuation, current_pos)\n        if start_index == -1:\n            break\n        end_index = start_index + len(word_with_punctuation)\n        tokens.append((word_with_punctuation, start_index, end_index))\n        current_pos = end_index\n    return tokens\ndef find_adverb_position(sentence: str) -> Optional[Tuple[int, int, str]]:\n    \"\"\"Finds the first adverb and its 0-indexed start/end positions in a sentence.\n    Returns a tuple (start_position, end_position, adverb_word) for the first adverb found or None.\n    \"\"\"\n    tokens_with_positions = _tokenize_sentence(sentence)\n\n    for original_word, original_start_span, original_end_span in tokens_with_positions:\n        cleaned_word = _strip_punctuation(original_word)\n\n        start_pos_cleaned = original_start_span + original_word.find(cleaned_word)\n        end_pos_cleaned = start_pos_cleaned + len(cleaned_word)\n\n        if _is_adverb(cleaned_word):\n            return (start_pos_cleaned, end_pos_cleaned, cleaned_word)\n\n    return None"}
{"task_id": "Mbpp/445", "solution": "def index_multiplication(\n    tuple1: tuple[tuple[float | int, ...], ...],\n    tuple2: tuple[tuple[float | int, ...], ...]\n) -> tuple[tuple[float | int, ...], ...]:\n    \"\"\"Performs index-wise multiplication of elements within two tuples of tuples.\n    It iterates through corresponding inner tuples and their elements, multiplying them.\"\"\"\n    \n    return tuple(\n        tuple(element1 * element2 for element1, element2 in zip(inner_tuple1, inner_tuple2))\n        for inner_tuple1, inner_tuple2 in zip(tuple1, tuple2)\n    )"}
