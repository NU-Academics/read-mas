{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters whose 0-indexed position in the string matches their 0-indexed alphabet position.\n    This comparison is case-insensitive, and only English alphabet characters are considered.\n    \"\"\"\n    def _get_0_indexed_alphabet_position(char: str) -> int:\n        \"\"\"Determines the 0-indexed alphabet position of a character, returning -1 for non-alphabetic characters.\"\"\"\n        lower_char = char.lower()\n        if 'a' <= lower_char <= 'z':\n            return ord(lower_char) - ord('a')\n        return -1\n\n    count = 0\n    for i, char in enumerate(input_string):\n        alphabet_pos = _get_0_indexed_alphabet_position(char)\n        if alphabet_pos != -1 and i == alphabet_pos:\n            count += 1\n    return count"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a, b, n):\n    \"\"\"\n    Finds integers x and y that satisfy the linear Diophantine equation ax + by = n.\n    Returns (x, y) as a tuple if a solution exists, or None otherwise.\n    \"\"\"\n\n    def _gcd(num1, num2):\n        # Calculates the greatest common divisor of two integers using the Euclidean algorithm.\n        num1 = abs(num1)\n        num2 = abs(num2)\n        while num2:\n            num1, num2 = num2, num1 % num2\n        return num1\n\n    def _extended_gcd(num1, num2):\n        # Implements the Extended Euclidean Algorithm: finds gcd(num1, num2) and x, y\n        # such that num1*x + num2*y = gcd(num1, num2). Ensures gcd is non-negative.\n        if num1 == 0:\n            return (num2, 0, 1)\n\n        gcd, x1, y1 = _extended_gcd(num2 % num1, num1)\n\n        x = y1 - (num2 // num1) * x1\n        y = x1\n\n        if gcd < 0:\n            return (-gcd, -x, -y)\n        else:\n            return (gcd, x, y)\n\n    # Handle the special case where both a and b are zero\n    if a == 0 and b == 0:\n        if n == 0:\n            return (0, 0)  # Any (x, y) is a solution; (0,0) is a simple valid choice.\n        else:\n            return None    # 0*x + 0*y = n implies 0 = n, which is false if n != 0.\n\n    # Calculate the greatest common divisor of a and b\n    common_divisor = _gcd(a, b)\n\n    # If n is not divisible by the common_divisor, no integer solution exists.\n    if n % common_divisor != 0:\n        return None\n\n    # Use the Extended Euclidean Algorithm to find x0, y0 such that a*x0 + b*y0 = common_divisor\n    gcd_val, x0, y0 = _extended_gcd(a, b)\n\n    # Scale the solution to match n: x = x0 * (n / common_divisor), y = y0 * (n / common_divisor)\n    # The division (n / common_divisor) is guaranteed to be an integer due to the check above.\n    factor = n // common_divisor\n    x = x0 * factor\n    y = y0 * factor\n\n    return (x, y)"}
{"task_id": "Mbpp/168", "solution": "def frequency(input_list, target_number):\n    \"\"\"Counts the number of occurrences of a specified number in a given list.\n    Returns an integer representing the count of target_number in input_list.\"\"\"\n    occurrence_count = 0\n    for item in input_list:\n        if item == target_number:\n            occurrence_count += 1\n    return occurrence_count"}
{"task_id": "Mbpp/166", "solution": "def _is_even(number: int) -> bool:\n    \"\"\"Checks if an integer is even.\"\"\"\n    return number % 2 == 0\ndef find_even_pair(integer_list: list[int]) -> int:\n    \"\"\"\n    Counts the number of pairs of integers in a list that XOR to an even number.\n    A pair (a, b) XORs to an even number if and only if both 'a' and 'b' have the same parity.\n    \"\"\"\n    if len(integer_list) < 2:\n        return 0\n\n    even_count = 0\n    odd_count = 0\n\n    for number in integer_list:\n        if _is_even(number):\n            even_count += 1\n        else:\n            odd_count += 1\n\n    pairs_from_evens = (even_count * (even_count - 1)) // 2\n    pairs_from_odds = (odd_count * (odd_count - 1)) // 2\n\n    return pairs_from_evens + pairs_from_odds"}
