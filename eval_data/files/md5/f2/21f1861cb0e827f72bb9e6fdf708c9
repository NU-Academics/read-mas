{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"Calculates the nth Catalan number using the recursive relation C_n = C_{n-1} * (4n - 2) / (n + 1).\n    This implementation uses dynamic programming to store intermediate results.\"\"\"\n\n    if n == 0:\n        return 1\n\n    catalan = [0] * (n + 1)\n    catalan[0] = 1\n\n    for i in range(1, n + 1):\n        catalan[i] = catalan[i-1] * (4 * i - 2) // (i + 1)\n\n    return catalan[n]"}
{"task_id": "Mbpp/588", "solution": "def big_diff(numbers: list) -> int | float:\n    \"\"\"\n    Calculates the difference between the largest and smallest value in a given list.\n    Assumes the list is non-empty, contains at least two numeric elements, and only numeric elements.\n    \"\"\"\n    largest = max(numbers)\n    smallest = min(numbers)\n    return largest - smallest"}
{"task_id": "Mbpp/592", "solution": "def sum_Of_product(n: int) -> int:\n    \"\"\"Calculates the sum of products of consecutive binomial coefficients.\n    Raises ValueError if n is not an integer or is negative.\n    \"\"\"\n    import math\n\n    def _factorial(num: int) -> int:\n        \"\"\"Calculates the factorial of a non-negative integer.\"\"\"\n        return math.factorial(num)\n\n    def _calculate_binomial_coefficient(n: int, k: int) -> int:\n        \"\"\"Calculates the binomial coefficient C(n, k) = n! / (k! * (n-k)!).\"\"\"\n        if k < 0 or k > n:\n            return 0\n        return _factorial(n) // (_factorial(k) * _factorial(n - k))\n\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    total_sum = 0\n    for k in range(n):\n        c_nk = _calculate_binomial_coefficient(n, k)\n        c_nk_plus_1 = _calculate_binomial_coefficient(n, k + 1)\n        total_sum += c_nk * c_nk_plus_1\n    return total_sum"}
{"task_id": "Mbpp/591", "solution": "def swap_List(input_list: list) -> list:\n    \"\"\"Interchanges the first and last elements of a list.\"\"\"\n    if len(input_list) < 2:\n        return input_list\n    \n    input_list[0], input_list[-1] = input_list[-1], input_list[0]\n    return input_list"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers):\n    \"\"\"\n    Finds the difference of the first even and first odd number in a list.\n    Assumes the list contains at least one even and one odd number.\n    \"\"\"\n    first_odd = None\n    first_even = None\n\n    for num in numbers:\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_odd is not None and first_even is not None:\n            break\n            \n    return first_even - first_odd"}
{"task_id": "Mbpp/589", "solution": "import math\ndef perfect_squares(lower_bound: int, upper_bound: int) -> list[int]:\n    \"\"\"Finds all perfect squares within the inclusive range [lower_bound, upper_bound].\"\"\"\n    squares = []\n\n    # Calculate the starting integer whose square might be in the range.\n    # The effective lower bound for square root calculation must be at least 1 for positive perfect squares.\n    start_num_for_sqrt = max(1, lower_bound)\n    start_sqrt = math.ceil(math.sqrt(start_num_for_sqrt))\n\n    # Calculate the ending integer whose square might be in the range.\n    # Ensure the value for sqrt is non-negative; if upper_bound is negative, there are no perfect squares.\n    end_num_for_sqrt = max(0, upper_bound)\n    end_sqrt = math.floor(math.sqrt(end_num_for_sqrt))\n\n    # Iterate through integers from start_sqrt to end_sqrt (inclusive).\n    # The loop will naturally be empty if start_sqrt > end_sqrt.\n    for i in range(int(start_sqrt), int(end_sqrt) + 1):\n        square = i * i\n        squares.append(square)\n\n    return squares"}
{"task_id": "Mbpp/593", "solution": "class Octet:\n    \"\"\"\n    Represents a single octet of an IP address.\n    Handles converting its string representation to an integer and providing its cleaned string form.\n    \"\"\"\n    def __init__(self, original_value: str):\n        self._original_value = original_value\n        self._numeric_value = int(original_value)\n\n    def get_cleaned_value(self) -> str:\n        \"\"\"Returns the string representation of the octet after leading zeros are removed.\"\"\"\n        return str(self._numeric_value)\nclass IPAddress:\n    \"\"\"\n    Encapsulates an IP address string, parses it into octets, and provides its cleaned string representation.\n    \"\"\"\n    def __init__(self, value: str):\n        self._original_value = value\n        octet_strings = value.split('.')\n        self._octets = [Octet(os) for os in octet_strings]\n\n    def get_cleaned_value(self) -> str:\n        \"\"\"Returns the IP address string with leading zeros removed from each octet.\"\"\"\n        cleaned_octet_values = [octet.get_cleaned_value() for octet in self._octets]\n        return \".\".join(cleaned_octet_values)\ndef removezero_ip(ip_address_str: str) -> str:\n    \"\"\"\n    Removes leading zeros from each octet of an IP address string.\n    \"\"\"\n    ip_address_obj = IPAddress(ip_address_str)\n    return ip_address_obj.get_cleaned_value()"}
