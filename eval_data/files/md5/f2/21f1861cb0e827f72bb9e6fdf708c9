{"task_id": "Mbpp/721", "solution": "import math\nfrom typing import List\nclass Cell:\n    \"\"\"Stores the coordinates and cost of a single matrix cell.\"\"\"\n    def __init__(self, row: int, col: int, cost: int):\n        self.row = row\n        self.col = col\n        self.cost = cost\nclass Matrix:\n    \"\"\"Manages the N*N grid of Cell objects and provides access to them.\"\"\"\n    def __init__(self, matrix_data: List[List[int]]):\n        N = len(matrix_data)\n        self.N = N\n        self.cells: List[List[Cell]] = []\n        for r_idx in range(N):\n            row_cells = []\n            for c_idx in range(N):\n                row_cells.append(Cell(r_idx, c_idx, matrix_data[r_idx][c_idx]))\n            self.cells.append(row_cells)\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        \"\"\"Returns the Cell object at the specified coordinates.\"\"\"\n        return self.cells[row][col]\n\n    def get_size(self) -> int:\n        \"\"\"Returns the dimension N of the matrix.\"\"\"\n        return self.N\ndef _find_max_average_recursive(matrix: Matrix, r: int, c: int, current_sum: int, current_len: int, max_avg_ref: List[float]) -> None:\n    \"\"\"Recursively explores all valid paths, updating the global maximum average when a path reaches the end.\"\"\"\n    N = matrix.get_size()\n\n    # Base case: Reached the bottom-right cell\n    if r == N - 1 and c == N - 1:\n        current_avg = current_sum / current_len\n        if current_avg > max_avg_ref[0]:\n            max_avg_ref[0] = current_avg\n        return\n\n    # Move Right\n    if c + 1 < N:\n        next_cell_cost = matrix.get_cell(r, c + 1).cost\n        _find_max_average_recursive(matrix, r, c + 1, current_sum + next_cell_cost, current_len + 1, max_avg_ref)\n\n    # Move Down\n    if r + 1 < N:\n        next_cell_cost = matrix.get_cell(r + 1, c).cost\n        _find_max_average_recursive(matrix, r + 1, c, current_sum + next_cell_cost, current_len + 1, max_avg_ref)\ndef maxAverageOfPath(matrix_data: List[List[int]]) -> float:\n    \"\"\"\n    Accepts a square matrix and returns the maximum average cost of a valid path.\n    A path moves only right or down from top-left to bottom-right.\n    \"\"\"\n    \n    matrix_obj = Matrix(matrix_data)\n    \n    # max_avg_ref is a list to allow modification by reference across recursive calls.\n    max_avg_ref = [-math.inf] \n    \n    start_cell_cost = matrix_obj.get_cell(0, 0).cost\n    \n    # Start the recursive search from (0,0), including its cost and counting it as one cell.\n    _find_max_average_recursive(matrix_obj, 0, 0, start_cell_cost, 1, max_avg_ref)\n    \n    return max_avg_ref[0]"}
{"task_id": "Mbpp/722", "solution": "class Student:\n    \"\"\"Encapsulates a single student's name, height, and weight.\"\"\"\n    def __init__(self, name: str, height: float, weight: float):\n        self.name = name\n        self.height = height\n        self.weight = weight\nclass Criteria:\n    \"\"\"Holds the minimum height and weight thresholds for filtering.\"\"\"\n    def __init__(self, min_height: float, min_weight: float):\n        self.min_height = min_height\n        self.min_weight = min_weight\nclass StudentCollection:\n    \"\"\"Manages a collection of Student objects.\"\"\"\n    def __init__(self):\n        self._students = {}\n\n    def add_student(self, student: Student):\n        self._students[student.name] = student\n\n    def get_all_students(self) -> list[Student]:\n        return list(self._students.values())\nclass FilteredStudentCollection:\n    \"\"\"Stores students that have met the filtering criteria and converts them to the output format.\"\"\"\n    def __init__(self):\n        self._filtered_students = {}\n\n    def add_filtered_student(self, student: Student):\n        self._filtered_students[student.name] = student\n\n    def to_dict(self) -> dict[str, tuple[float, float]]:\n        output = {}\n        for name, student in self._filtered_students.items():\n            output[name] = (student.height, student.weight)\n        return output\ndef filter_data(student_data: dict[str, tuple[float, float]], min_height: float, min_weight: float) -> dict[str, tuple[float, float]]:\n    \"\"\"Filters student data based on provided height and weight criteria.\"\"\"\n    student_collection = StudentCollection()\n    criteria = Criteria(min_height, min_weight)\n\n    for name, (height, weight) in student_data.items():\n        student_collection.add_student(Student(name, height, weight))\n\n    filtered_collection = FilteredStudentCollection()\n\n    for student in student_collection.get_all_students():\n        if student.height >= criteria.min_height and student.weight >= criteria.min_weight:\n            filtered_collection.add_filtered_student(student)\n\n    return filtered_collection.to_dict()"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    Handles input validation and orchestrates the calculation.\n    \"\"\"\n    if power < 0:\n        raise ValueError(\"Power cannot be a negative integer.\")\n\n    class Calculation:\n        \"\"\"\n        Encapsulates the state and logic for a single base-power calculation.\n        \"\"\"\n        def __init__(self, base: int, power: int):\n            self._base = base\n            self._power = power\n            self._exponentiated_value = 0\n            self._sum_of_digits = 0\n\n        def calculate_exponentiation(self) -> None:\n            \"\"\"Calculates base raised to the power and stores the result.\"\"\"\n            self._exponentiated_value = self._base ** self._power\n\n        def calculate_sum_of_digits(self) -> None:\n            \"\"\"Calculates the sum of the digits of the exponentiated value.\"\"\"\n            self._sum_of_digits = sum(int(digit) for digit in str(self._exponentiated_value))\n\n        def get_sum_of_digits(self) -> int:\n            \"\"\"Returns the calculated sum of digits.\"\"\"\n            return self._sum_of_digits\n\n    calculation_instance = Calculation(base, power)\n    calculation_instance.calculate_exponentiation()\n    calculation_instance.calculate_sum_of_digits()\n    return calculation_instance.get_sum_of_digits()"}
