{"task_id": "Mbpp/171", "solution": "class Pentagon:\n    \"\"\"Represents a regular pentagon and provides methods for its calculations.\"\"\"\n\n    def __init__(self, side_length: float):\n        \"\"\"Initializes a Pentagon object.\"\"\"\n        if not isinstance(side_length, (int, float)) or side_length <= 0:\n            raise ValueError(\"Side length must be a positive numerical value.\")\n        self._side_length = float(side_length)\n\n    def calculate_perimeter(self) -> float:\n        \"\"\"Computes the perimeter of the regular pentagon.\"\"\"\n        return self._side_length * 5\ndef perimeter_pentagon(side_length: float) -> float:\n    \"\"\"Calculates the perimeter of a regular pentagon from its side length.\"\"\"\n    pentagon = Pentagon(side_length)\n    return pentagon.calculate_perimeter()"}
{"task_id": "Mbpp/172", "solution": "def count_occurance(input_string: str) -> int:\n    \"\"\"\n    Counts non-overlapping, case-sensitive occurrences of 'std' in the given string.\n    The function iterates through the string using find to locate and count occurrences.\n    \"\"\"\n    count = 0\n    start_index = 0\n    target_substring = 'std'\n    while True:\n        index = input_string.find(target_substring, start_index)\n        if index == -1:\n            break\n        count += 1\n        start_index = index + len(target_substring)\n    return count"}
{"task_id": "Mbpp/223", "solution": "def _find_first_occurrence(array: list[int], n: int, element: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of the element in the sorted array using binary search.\n    Returns the index of the first occurrence, or -1 if not found.\n    \"\"\"\n    low = 0\n    high = n - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == element:\n            result = mid\n            high = mid - 1  # Look for an earlier occurrence on the left\n        elif array[mid] < element:\n            low = mid + 1\n        else:  # array[mid] > element\n            high = mid - 1\n    return result\ndef is_majority(array: list[int], n: int, element: int) -> bool:\n    \"\"\"\n    Checks if the given element is a majority element in the sorted array.\n    A majority element occurs strictly more than n/2 times.\n    \"\"\"\n    first_index = _find_first_occurrence(array, n, element)\n\n    if first_index == -1:\n        return False\n\n    # Check the element at index `first_index + n // 2`.\n    # If it's also the target element, then there are at least (n // 2 + 1) occurrences.\n    majority_check_index = first_index + n // 2\n    return majority_check_index < n and array[majority_check_index] == element"}
