{"task_id": "Mbpp/301", "solution": "def dict_depth(input_dict: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of a dictionary using a recursive approach.\n    The depth is 1 plus the maximum depth of any dictionary found in its values.\n    \"\"\"\n    max_nested_depth = 0\n    for value in input_dict.values():\n        if isinstance(value, dict):\n            max_nested_depth = max(max_nested_depth, dict_depth(value))\n    return 1 + max_nested_depth"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Calculates the maximum sum of an increasing subsequence from a given array,\n    considering elements up to a specified prefix index 'i' and including\n    a specific element at a later index 'k' (where k > i).\n    \"\"\"\n    # Precondition checks from design\n    if not arr or n == 0:\n        raise ValueError(\"Input array cannot be empty.\")\n    if not (0 <= i < n):\n        raise ValueError(f\"Invalid prefix index 'i': {i}. Must be 0 <= i < n ({n}).\")\n    if not (0 <= k < n):\n        raise ValueError(f\"Invalid mandatory element index 'k': {k}. Must be 0 <= k < n ({n}).\")\n    if k <= i:\n        raise ValueError(f\"Invalid indices: 'k' ({k}) must be strictly greater than 'i' ({i}).\")\n\n    # Initialize dp array for maximum sum increasing subsequence ending at each index up to i\n    dp = [0] * (i + 1)\n\n    # Calculate max sum increasing subsequence for prefix up to i\n    for current_idx in range(i + 1):\n        dp[current_idx] = arr[current_idx] \n        for prev_idx in range(current_idx):\n            if arr[current_idx] > arr[prev_idx]:\n                dp[current_idx] = max(dp[current_idx], dp[prev_idx] + arr[current_idx])\n\n    # Find the maximum sum of an increasing subsequence ending at arr[j] (j <= i)\n    # such that arr[j] < arr[k]\n    max_prefix_sum = 0\n    for j in range(i + 1):\n        if arr[j] < arr[k]: \n            max_prefix_sum = max(max_prefix_sum, dp[j])\n\n    # The final sum includes the kth element\n    return max_prefix_sum + arr[k]"}
{"task_id": "Mbpp/305", "solution": "def start_withp(input_strings: list[str]) -> tuple[str, str]:\n    \"\"\"\n    Extracts the first two words starting with 'p' or 'P' from a list of strings.\n    The words retain their original casing.\n    \"\"\"\n    collected_words = []\n    for s in input_strings:\n        words = s.split()\n        for word in words:\n            if word.lower().startswith('p'):\n                collected_words.append(word)\n                if len(collected_words) == 2:\n                    return tuple(collected_words)\n    return tuple(collected_words) # Should always be 2 elements based on problem context and assertion"}
{"task_id": "Mbpp/308", "solution": "def large_product(list1, list2, k):\n    \"\"\"\n    Calculates all products from two lists, then returns the k largest products in descending order.\n    \"\"\"\n    products = [x * y for x in list1 for y in list2]\n    products.sort(reverse=True)\n    return products[:k]"}
