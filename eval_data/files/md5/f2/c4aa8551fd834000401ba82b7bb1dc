{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    You'll be given a string of words, and your task is to count the number\n    of boredoms. A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n\n    For example:\n    >>> is_bored(\"Hello world\")\n    0\n    >>> is_bored(\"The sky is blue. The sun is shining. I love this weather\")\n    1\n    \"\"\"\n    import re\n\n    def _split_into_sentences(text: str, delimiters: str) -> list[str]:\n        \"\"\"Splits the input text into a list of sentences based on provided delimiters.\"\"\"\n        if not text:\n            return []\n\n        parts = re.split(f'([{re.escape(delimiters)}])', text)\n        sentences = []\n        current_sentence = []\n\n        for part in parts:\n            if part.strip() == '':\n                continue\n            current_sentence.append(part)\n            if part in delimiters:\n                sentence_text = ''.join(current_sentence).strip()\n                if sentence_text:\n                    sentences.append(sentence_text)\n                current_sentence = []\n\n        if current_sentence:\n            sentence_text = ''.join(current_sentence).strip()\n            if sentence_text:\n                sentences.append(sentence_text)\n\n        return sentences\n\n    def _starts_with_i(sentence_text: str) -> bool:\n        \"\"\"Determines if a given sentence starts with the word \"I\".\"\"\"\n        if not sentence_text:\n            return False\n        words = sentence_text.strip().split()\n        if not words:\n            return False\n        return words[0].lower() == \"i\"\n\n    boredom_count = 0\n    # Default delimiters as per the problem description and design\n    delimiters = \".?!\"\n    sentences = _split_into_sentences(S, delimiters)\n\n    for sentence in sentences:\n        if _starts_with_i(sentence):\n            boredom_count += 1\n\n    return boredom_count"}
{"task_id": "HumanEval/94", "solution": "```python\ndef skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"Checks if an integer is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def _sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the digits of a given non-negative integer.\"\"\"\n        s = 0\n        while n > 0:\n            s += n % 10\n            n //= 10\n        return s\n\n    largest_prime = 0\n    for num in lst:\n        if _is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n\n    if largest_prime > 0:\n        return _sum_digits(largest_prime)\n    else:\n        return 0\n```"}
{"task_id": "HumanEval/93", "solution": "```python\ndef encode(message):\n    \"\"\"\n    Encodes a message by swapping the case of all letters and\n    replacing vowels with the letter 2 places ahead in the alphabet.\n    Non-alphabetic characters are preserved.\n    \"\"\"\n    encoded_chars = []\n    vowels = 'aeiou'\n\n    for char in message:\n        if not char.isalpha():\n            # If the character is not a letter, it is preserved.\n            encoded_chars.append(char)\n            continue\n\n        processed_char = char\n        if char.lower() in vowels:\n            # For vowels, first shift the letter two positions ahead, maintaining its original case.\n            start = ord('a') if char.islower() else ord('A')\n            shifted_ord = start + (ord(char) - start + 2) % 26\n            processed_char = chr(shifted_ord)\n\n        # After any potential vowel shift, swap the case of the character.\n        final_char = processed_char.swapcase()\n        encoded_chars.append(final_char)\n\n    return \"\".join(encoded_chars)\n```"}
{"task_id": "HumanEval/96", "solution": "```python\ndef count_up_to(n):\n    \"\"\"Implement a function that takes a non-negative integer and returns an array of prime numbers less than n.\"\"\"\n\n    def _is_prime(num):\n        \"\"\"Checks if a given number is prime. Returns True if prime, False otherwise.\"\"\"\n        if num < 2:\n            return False\n        for divisor in range(2, int(num**0.5) + 1):\n            if num % divisor == 0:\n                return False\n        return True\n\n    if n <= 1:\n        return []\n\n    primes = []\n    for i in range(2, n):\n        if _is_prime(i):\n            primes.append(i)\n\n    return primes\n```"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    \"\"\"\n    if not dict:\n        return False\n\n    all_lower = True\n    all_upper = True\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n\n        if not key.islower():\n            all_lower = False\n\n        if not key.isupper():\n            all_upper = False\n\n        # Optimization: If both flags are already False, no need to check further keys\n        if not all_lower and not all_upper:\n            return False\n\n    return all_lower or all_upper\n```"}
