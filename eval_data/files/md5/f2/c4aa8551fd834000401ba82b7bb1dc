{"task_id": "HumanEval/64", "solution": "```python\ndef vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    \"\"\"\n    if not s:\n        return 0\n\n    vowels = \"aeiou\"\n    count = 0\n    s_lower = s.lower()\n\n    for i, char in enumerate(s_lower):\n        if char in vowels:\n            count += 1\n        elif char == 'y' and i == len(s_lower) - 1:\n            # 'y' is a vowel only if it's the last character\n            count += 1\n    return count\n```"}
{"task_id": "HumanEval/65", "solution": "def _int_to_digits(x: int) -> list[str]:\n    \"\"\"Converts an integer into a list of its string digits.\"\"\"\n    return list(str(x))\n\ndef _perform_right_circular_shift(digits: list[str], shift_amount: int) -> list[str]:\n    \"\"\"Performs a right circular shift on a list of string digits.\"\"\"\n    n = len(digits)\n    if n == 0:\n        return []\n    effective_shift = shift_amount % n\n    return digits[-effective_shift:] + digits[:-effective_shift]\n\ndef _reverse_digits(digits: list[str]) -> list[str]:\n    \"\"\"Reverses the order of digits in a list.\"\"\"\n    return digits[::-1]\n\ndef circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    digits = _int_to_digits(x)\n    num_digits = len(digits)\n\n    if shift > num_digits:\n        # If shift is greater than the number of digits, reverse them.\n        shifted_digits = _reverse_digits(digits)\n    else:\n        # Otherwise, perform a circular right shift.\n        # effective_shift handles cases where shift equals num_digits (no net shift)\n        # and ensures it's within the bounds for slicing.\n        effective_shift = shift % num_digits\n        shifted_digits = _perform_right_circular_shift(digits, effective_shift)\n\n    return \"\".join(shifted_digits)"}
{"task_id": "HumanEval/67", "solution": "def fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket given a string `s` for apples and oranges\n    and an integer `n` for the total number of fruits.\n    \"\"\"\n\n    # Parse the number of apples\n    apples_start = s.find(\"apples\") - 1\n    apples_end = s.find(\"apples\")\n    apples_str = \"\"\n    while apples_start >= 0 and s[apples_start].isdigit():\n        apples_str = s[apples_start] + apples_str\n        apples_start -= 1\n    apples = int(apples_str.strip())\n\n    # Parse the number of oranges\n    oranges_start = s.find(\"oranges\") - 1\n    oranges_end = s.find(\"oranges\")\n    oranges_str = \"\"\n    while oranges_start >= 0 and s[oranges_start].isdigit():\n        oranges_str = s[oranges_start] + oranges_str\n        oranges_start -= 1\n    oranges = int(oranges_str.strip())\n\n    return n - apples - oranges"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    \"Given an array representing a branch of a tree that has non-negative integer nodes\n    your task is to pluck one of the nodes and return it.\n    The plucked node should be the node with the smallest even value.\n    If multiple nodes with the same smallest even value are found return the node that has smallest index.\n\n    The plucked node should be returned in a list, [ smalest_value, its index ],\n    If there are no even values or the given array is empty, return [].\n\n    Example 1:\n        Input: [4,2,3]\n        Output: [2, 1]\n        Explanation: 2 has the smallest even value, and 2 has the smallest index.\n\n    Example 2:\n        Input: [1,2,3]\n        Output: [2, 1]\n        Explanation: 2 has the smallest even value, and 2 has the smallest index.\n\n    Example 3:\n        Input: []\n        Output: []\n\n    Example 4:\n        Input: [5, 0, 3, 0, 4, 2]\n        Output: [0, 1]\n        Explanation: 0 is the smallest value, but  there are two zeros,\n                     so we will choose the first zero, which has the smallest index.\n\n    Constraints:\n        * 1 <= nodes.length <= 10000\n        * 0 <= node.value\n    \"\"\"\n\n    class _Node:\n        \"\"\"Internal data structure to hold a node's value and its original index.\"\"\"\n        def __init__(self, value, index):\n            self.value = value\n            self.index = index\n\n    # _validate_input and _find_smallest_even_node are internal helpers.\n    # No need to explicitly define them as separate functions outside of pluck\n    # as per the instruction to \"Do NOT call any helper that is not defined inline in your response\".\n    # The functionality is integrated directly or implicitly.\n\n    if not arr:\n        return []\n\n    smallest_even_node = None\n\n    for i, value in enumerate(arr):\n        # Implicitly handles _validate_input by assuming valid non-negative integers as per constraints.\n        # If value is even\n        if value % 2 == 0:\n            if smallest_even_node is None:\n                smallest_even_node = _Node(value, i)\n            else:\n                if value < smallest_even_node.value:\n                    smallest_even_node = _Node(value, i)\n                elif value == smallest_even_node.value:\n                    # Tie-breaking rule: smallest index\n                    if i < smallest_even_node.index:\n                        smallest_even_node = _Node(value, i)\n\n    if smallest_even_node:\n        return [smallest_even_node.value, smallest_even_node.index]\n    else:\n        return []"}
{"task_id": "HumanEval/69", "solution": "```python\nimport collections\n\ndef search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than\n    zero, and has a frequency greater than or equal to the value of the integer itself.\n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    '''\n    frequency_map = collections.Counter(lst)\n    max_candidate = -1\n\n    for num, freq in frequency_map.items():\n        # Check if the frequency of the number is greater than or equal to the number itself.\n        # The problem states positive integers, so num > 0 is implicitly handled by the input.\n        if freq >= num:\n            max_candidate = max(max_candidate, num)\n\n    return max_candidate\n```"}
{"task_id": "HumanEval/70", "solution": "```python\ndef strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    if not lst:\n        return []\n\n    working_list = list(lst)\n    result_list = []\n    is_min_turn = True\n\n    while working_list:\n        if is_min_turn:\n            # Find and append the minimum value\n            current_val = min(working_list)\n        else:\n            # Find and append the maximum value\n            current_val = max(working_list)\n\n        result_list.append(current_val)\n        working_list.remove(current_val) # Remove the first occurrence\n        is_min_turn = not is_min_turn # Toggle for the next turn\n\n    return result_list\n```"}
{"task_id": "HumanEval/72", "solution": "```python\ndef will_it_fly(q,w):\n    '''\n    Write a function that returns True if the object q will fly, and False otherwise.\n    The object q will fly if it's balanced (it is a palindromic list) and the sum of its elements is less than or equal the maximum possible weight w.\n    '''\n    def _is_palindrome(lst):\n        \"\"\"Checks if a list is a palindrome.\"\"\"\n        return lst == lst[::-1]\n\n    def _calculate_sum(lst):\n        \"\"\"Calculates the sum of elements in a list.\"\"\"\n        return sum(lst)\n\n    is_balanced = _is_palindrome(q)\n    total_weight = _calculate_sum(q)\n\n    return is_balanced and (total_weight <= w)\n```"}
{"task_id": "HumanEval/71", "solution": "import math\n\nclass _Triangle:\n    \"\"\"Internal helper class to encapsulate triangle validity and area calculation logic.\"\"\"\n    def __init__(self, a, b, c):\n        self._side_a = a\n        self._side_b = b\n        self._side_c = c\n\n    def is_valid(self):\n        \"\"\"Checks if the three sides form a valid triangle according to the triangle inequality theorem.\"\"\"\n        if self._side_a <= 0 or self._side_b <= 0 or self._side_c <= 0:\n            return False\n        return (self._side_a + self._side_b > self._side_c and\n                self._side_a + self._side_c > self._side_b and\n                self._side_b + self._side_c > self._side_a)\n\n    def calculate_area(self):\n        \"\"\"Calculates the area of the triangle using Heron's formula.\"\"\"\n        s = (self._side_a + self._side_b + self._side_c) / 2\n        # Heron's formula can result in a small negative value due to floating point inaccuracies for degenerate triangles,\n        # so max(0, ...) ensures we don't take the sqrt of a negative.\n        area_squared = s * (s - self._side_a) * (s - self._side_b) * (s - self._side_c)\n        return math.sqrt(max(0, area_squared))\n\ndef triangle_area(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater\n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    \"\"\"\n    triangle = _Triangle(a, b, c)\n    if not triangle.is_valid():\n        return -1\n\n    area = triangle.calculate_area()\n    return round(area, 2)```"}
{"task_id": "HumanEval/73", "solution": "```python\ndef smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic.\n    \"\"\"\n    changes = 0\n    left = 0\n    right = len(arr) - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n\n    return changes\n```"}
