{"task_id": "HumanEval/123", "solution": "```python\ndef get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n    if n == 1:\n        return [1]\n\n    odd_numbers = set()\n    current_term = n\n\n    while current_term != 1:\n        if current_term % 2 != 0:  # current_term is odd\n            odd_numbers.add(current_term)\n            current_term = (current_term * 3) + 1\n        else:  # current_term is even\n            current_term = current_term // 2\n\n    odd_numbers.add(1) # The sequence always ends with 1, which is odd.\n\n    result = list(odd_numbers)\n    result.sort()\n    return result\n```"}
{"task_id": "HumanEval/125", "solution": "```python\nfrom typing import List, Union\nimport re\n\ndef _has_whitespace(text: str) -> bool:\n    \"\"\"Checks if the input string contains any whitespace characters.\"\"\"\n    return bool(re.search(r'\\s', text))\n\ndef _has_comma(text: str) -> bool:\n    \"\"\"Checks if the input string contains any comma characters.\"\"\"\n    return ',' in text\n\ndef _split_by_whitespace(text: str) -> List[str]:\n    \"\"\"Splits the string by whitespace, handling multiple consecutive spaces as one delimiter.\"\"\"\n    return [word for word in re.split(r'\\s+', text) if word]\n\ndef _split_by_comma(text: str) -> List[str]:\n    \"\"\"Splits the string by commas.\"\"\"\n    return text.split(',')\n\ndef _count_lowercase_odd_order(text: str) -> int:\n    \"\"\"Counts lowercase English letters with an odd 0-indexed alphabetical order.\"\"\"\n    count = 0\n    for char in text:\n        if 'a' <= char <= 'z':\n            if (ord(char) - ord('a')) % 2 != 0:\n                count += 1\n    return count\n\ndef split_words(txt: str) -> Union[List[str], int]:\n    \"\"\"\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3\n    \"\"\"\n    if _has_whitespace(txt):\n        return _split_by_whitespace(txt)\n    elif _has_comma(txt):\n        return _split_by_comma(txt)\n    else:\n        return _count_lowercase_odd_order(txt)\n```\n"}
{"task_id": "HumanEval/126", "solution": "```python\ndef is_sorted(lst):\n    \"\"\"\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    \"\"\"\n    if len(lst) <= 1:\n        return True\n\n    # Check for ascending order\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Check for excessive duplicates\n    counts = {}\n    for x in lst:\n        counts[x] = counts.get(x, 0) + 1\n        if counts[x] >= 3:\n            return False\n\n    return True\n```"}
{"task_id": "HumanEval/124", "solution": "```python\nfrom typing import Optional\n\ndef valid_date(date):\n    \"\"\"Validates a given date string according to specific rules.\"\"\"\n\n    def _get_max_days_in_month(month: int) -> int:\n        \"\"\"Determines the maximum number of days for a given month.\"\"\"\n        if month in (1, 3, 5, 7, 8, 10, 12):\n            return 31\n        elif month in (4, 6, 9, 11):\n            return 30\n        elif month == 2:\n            return 29\n        return 0 # Invalid month, should be caught by _is_month_valid\n\n    class _Date:\n        \"\"\"Internal class to encapsulate parsed date components and provide validation logic.\"\"\"\n        def __init__(self, month: int, day: int, year: int):\n            self._month = month\n            self._day = day\n            self._year = year\n\n        def _is_month_valid(self) -> bool:\n            \"\"\"Checks if the month component is between 1 and 12.\"\"\"\n            return 1 <= self._month <= 12\n\n        def _is_day_valid(self) -> bool:\n            \"\"\"Checks if the day component is valid for the month.\"\"\"\n            max_days = _get_max_days_in_month(self._month)\n            return 1 <= self._day <= max_days\n\n        def is_valid(self) -> bool:\n            \"\"\"Performs full date component validation based on calendar rules.\"\"\"\n            if not self._is_month_valid():\n                return False\n            if not self._is_day_valid():\n                return False\n            return True\n\n    def _parse_date_string(date_string: str) -> Optional[_Date]:\n        \"\"\"Parses a date string in 'mm-dd-yyyy' format into a _Date object.\"\"\"\n        parts = date_string.split('-')\n        if len(parts) != 3:\n            return None\n        try:\n            month = int(parts[0])\n            day = int(parts[1])\n            year = int(parts[2])\n            return _Date(month, day, year)\n        except ValueError:\n            return None\n\n    # Rule 1: The date string is not empty.\n    if not date:\n        return False\n\n    # Rule 4: The date should be in the format: mm-dd-yyyy\n    date_obj = _parse_date_string(date)\n\n    if date_obj is None:\n        return False\n\n    # Rules 2 and 3 are handled by the _Date object's internal validation.\n    return date_obj.is_valid()\n```"}
{"task_id": "HumanEval/128", "solution": "```python\ndef prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n\n    Example:\n    >>> prod_signs([1, 2, 2, -4]) == -9\n    >>> prod_signs([0, 1]) == 0\n    >>> prod_signs([]) == None\n    \"\"\"\n    def _get_magnitude(num):\n        \"\"\"Determines the magnitude (absolute value) of a single integer.\"\"\"\n        return abs(num)\n\n    def _get_sign(num):\n        \"\"\"Determines the sign (1 for positive, -1 for negative, 0 for zero) of a single integer.\"\"\"\n        if num > 0:\n            return 1\n        elif num < 0:\n            return -1\n        else:\n            return 0\n\n    if not arr:\n        return None\n\n    sum_magnitudes = 0\n    product_of_signs = 1\n\n    for num in arr:\n        sum_magnitudes += _get_magnitude(num)\n        product_of_signs *= _get_sign(num)\n\n    return sum_magnitudes * product_of_signs\n```"}
{"task_id": "HumanEval/127", "solution": "def _is_prime(number):\n    # Determines if a given integer is a prime number.\n    # Returns True if prime, False otherwise.\n    if number <= 1:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(number)) + 1, 2):\n        if number % i == 0:\n            return False\n    return True\n\ndef _calculate_length(start, end):\n    # Calculates the length of a closed interval (start, end).\n    # Length is defined as 'end - start' based on problem examples.\n    return end - start\n\ndef _calculate_intersection_interval(interval1, interval2):\n    # Determines the intersection interval of two given intervals.\n    # Returns (start, end) of intersection or None if no intersection.\n    s1, e1 = interval1\n    s2, e2 = interval2\n\n    start_inter = max(s1, s2)\n    end_inter = min(e1, e2)\n\n    if start_inter > end_inter:\n        return None\n    else:\n        return (start_inter, end_inter)\n\ndef intersection(interval1, interval2):\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two\n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n\n\n    [input/output] samples:\n    intersection((1, 2), (2, 3)) ==> \"NO\"\n    intersection((-1, 1), (0, 4)) ==> \"NO\"\n    intersection((-3, -1), (-5, 5)) ==> \"YES\"\n    \"\"\"\n    intersection_interval = _calculate_intersection_interval(interval1, interval2)\n\n    if intersection_interval is None:\n        return \"NO\"\n\n    start_inter, end_inter = intersection_interval\n    length = _calculate_length(start_inter, end_inter)\n\n    if _is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/131", "solution": "```python\nclass Digit:\n    \"\"\"Represents a single digit and determines if it is odd.\"\"\"\n\n    def __init__(self, value: int):\n        self._value = value\n\n    def is_odd(self) -> bool:\n        \"\"\"Returns True if the digit is odd, False otherwise.\"\"\"\n        return self._value % 2 != 0\n\n    def get_value(self) -> int:\n        \"\"\"Returns the integer value of the digit.\"\"\"\n        return self._value\n\n\nclass Integer:\n    \"\"\"Represents a positive integer and provides a way to extract its individual digits.\"\"\"\n\n    def __init__(self, n: int):\n        self._value = n\n\n    def get_digits(self) -> list[Digit]:\n        \"\"\"Extracts and returns a list of Digit objects from the integer.\"\"\"\n        s_value = str(self._value)\n        digits_list = []\n        for char_digit in s_value:\n            digits_list.append(Digit(int(char_digit)))\n        return digits_list\n\n\nclass OddDigitProductCalculator:\n    \"\"\"Calculates the product of odd digits from an Integer object.\"\"\"\n\n    def calculate_product_of_odd_digits(self, integer_obj: Integer) -> int:\n        \"\"\"Calculates the product of odd digits from the given Integer object.\n        Returns 0 if no odd digits are found.\"\"\"\n        digits_found = integer_obj.get_digits()\n        odd_digits_product = 1\n        found_odd_digit = False\n\n        for digit_obj in digits_found:\n            if digit_obj.is_odd():\n                odd_digits_product *= digit_obj.get_value()\n                found_odd_digit = True\n\n        return odd_digits_product if found_odd_digit else 0\n\n\ndef digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    integer_obj = Integer(n)\n    calculator = OddDigitProductCalculator()\n    result = calculator.calculate_product_of_odd_digits(integer_obj)\n    return result\n```"}
{"task_id": "HumanEval/129", "solution": "```python\nclass Cell:\n    \"\"\"Represents a single cell within the grid with its value and coordinates.\"\"\"\n    def __init__(self, value: int, row: int, col: int):\n        self.value = value\n        self.row = row\n        self.col = col\n\n    def get_neighbors_coords(self, N: int) -> list[tuple[int, int]]:\n        \"\"\"Returns a list of valid (row, col) coordinates of adjacent cells within grid boundaries.\"\"\"\n        neighbors = []\n        possible_moves = [(self.row - 1, self.col), (self.row + 1, self.col),\n                          (self.row, self.col - 1), (self.row, self.col + 1)]\n\n        for r, c in possible_moves:\n            if 0 <= r < N and 0 <= c < N:\n                neighbors.append((r, c))\n        return neighbors\n\nclass Grid:\n    \"\"\"Manages the 2D grid structure and provides access to individual cells.\"\"\"\n    def __init__(self, raw_grid: list[list[int]]):\n        self.N = len(raw_grid)\n        self.cells = [[None] * self.N for _ in range(self.N)]\n        for r in range(self.N):\n            for c in range(self.N):\n                self.cells[r][c] = Cell(raw_grid[r][c], r, c)\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        \"\"\"Returns the Cell object at the specified (row, col) coordinates.\"\"\"\n        return self.cells[row][col]\n\nclass Path:\n    \"\"\"Represents an ordered sequence of visited cells and their values, supporting lexicographical comparison.\"\"\"\n    def __init__(self, initial_cell: Cell):\n        self.cells_visited: list[Cell] = [initial_cell]\n        self.values_visited: list[int] = [initial_cell.value]\n\n    def add_cell(self, cell: Cell):\n        \"\"\"Appends a Cell to the path, updating both cells_visited and values_visited.\"\"\"\n        self.cells_visited.append(cell)\n        self.values_visited.append(cell.value)\n\n    def get_last_cell(self) -> Cell:\n        \"\"\"Returns the last Cell object added to the path.\"\"\"\n        return self.cells_visited[-1]\n\n    def is_length(self, k: int) -> bool:\n        \"\"\"Checks if the path has visited exactly k cells.\"\"\"\n        return len(self.cells_visited) == k\n\n    def __lt__(self, other: 'Path') -> bool:\n        \"\"\"Implements lexicographical comparison between two paths based on their visited values.\"\"\"\n        return self.values_visited < other.values_visited\n\ndef _find_paths_recursive(current_path: Path, grid_obj: Grid, k: int, min_path_values: list[int]):\n    \"\"\"Recursively explores paths of length k, updating min_path_values with the lexicographically smallest found.\"\"\"\n    if current_path.is_length(k):\n        if current_path.values_visited < min_path_values:\n            min_path_values[:] = current_path.values_visited[:]\n        return\n\n    # Pruning: If current path is already lexicographically greater or equal than the current min_path_values\n    # (up to its current length), there's no need to continue this branch.\n    if len(current_path.values_visited) > 0:\n        if current_path.values_visited >= min_path_values[:len(current_path.values_visited)]:\\\n            return\n\n    last_cell = current_path.get_last_cell()\n    neighbor_coords = last_cell.get_neighbors_coords(grid_obj.N)\n\n    for n_row, n_col in neighbor_coords:\n        neighbor_cell = grid_obj.get_cell(n_row, n_col)\n        current_path.add_cell(neighbor_cell)\n        _find_paths_recursive(current_path, grid_obj, k, min_path_values)\n        # Backtrack\n        current_path.cells_visited.pop()\n        current_path.values_visited.pop()\n\n\ndef minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k,\n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n    grid_obj = Grid(grid)\n    N = grid_obj.N\n\n    # Initialize min_path_values with a list of values larger than any possible grid value\n    # N*N is the maximum value in the grid. (N*N + 1) guarantees a larger sentinel.\n    min_path_values = [(N * N) + 1] * k\n\n    for r in range(N):\n        for c in range(N):\n            initial_cell = grid_obj.get_cell(r, c)\n\n            # If k is 1, the path is just the initial cell itself.\n            # We can handle this as a special base case or let the recursion handle it.\n            # The recursion naturally handles it by calling _find_paths_recursive with length 1.\n            # For efficiency, if k=1, we only need to find the minimum value.\n            if k == 1:\n                if [initial_cell.value] < min_path_values:\n                    min_path_values = [initial_cell.value]\n                continue # Move to the next starting cell for k=1\n\n            current_path = Path(initial_cell)\n            _find_paths_recursive(current_path, grid_obj, k, min_path_values)\n\n    return min_path_values\n```"}
{"task_id": "HumanEval/130", "solution": "```python\ndef tri(n):\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in\n    the last couple centuries. However, what people don't know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8\n    You are given a non-negative integer number n, you have to a return a list of the\n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n\n    memo = []\n\n    def _calculate_term(k):\n        \"\"\"Recursively calculates and memoizes the k-th Tribonacci term.\"\"\"\n        if k < len(memo):\n            return memo[k]\n\n        value = 0\n        if k == 0:\n            value = 1\n        elif k == 1:\n            value = 3\n        elif k % 2 == 0:  # k is even and k > 0\n            value = 1 + k // 2\n        else:  # k is odd and k > 0\n            val_k_minus_1 = _calculate_term(k - 1)\n            val_k_minus_2 = _calculate_term(k - 2)\n            val_k_plus_1 = _calculate_term(k + 1)\n            value = val_k_minus_1 + val_k_minus_2 + val_k_plus_1\n\n        while len(memo) <= k:\n            memo.append(0)\n        memo[k] = value\n        return value\n\n    if n < 0:\n        return []\n\n    for i in range(n + 1):\n        _calculate_term(i)\n\n    return memo[:n + 1]\n```"}
{"task_id": "HumanEval/133", "solution": "```python\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    \"\"\"\n    import math\n    total_sum = 0\n    for num in lst:\n        rounded_num = math.ceil(num)\n        squared_num = rounded_num * rounded_num\n        total_sum += squared_num\n    return total_sum\n```\n"}
{"task_id": "HumanEval/134", "solution": "```python\ndef check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an alphabetical character and is not part of a word.\n    A \"word\" is defined as a group of characters separated by space.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n\n    # Check the character before the last one\n    char_before_last = txt[-2]\n    return char_before_last.isspace()\n```"}
{"task_id": "HumanEval/132", "solution": "```python\ndef is_nested(string):\n    '''\n    Determines if a string contains a nested subsequence of square brackets.\\n    Nesting is detected when an open_bracket_depth of 2 or more is encountered before a closing bracket.\\n    '''\n    open_bracket_depth = 0\n    found_nested = False\n\n    for char in string:\n        if char == '[':\n            open_bracket_depth += 1\n        elif char == ']':\n            if open_bracket_depth >= 2:\n                found_nested = True\n            open_bracket_depth = max(0, open_bracket_depth - 1)\n\n    return found_nested\n```"}
{"task_id": "HumanEval/135", "solution": "```python\ndef can_arrange(arr):\n    \"\"\"\n    Returns the largest index of an element which is not greater than or equal to the element immediately preceding it.\n    If no such element exists then return -1.\n    \"\"\"\n    largest_index_found = -1\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            largest_index_found = i\n    return largest_index_found\n```"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n    '''\n    negatives = []\n    positives = []\n\n    for num in lst:\n        if num < 0:\n            negatives.append(num)\n        elif num > 0:\n            positives.append(num)\n\n    largest_negative = None\n    if negatives:\n        largest_negative = max(negatives)\n\n    smallest_positive = None\n    if positives:\n        smallest_positive = min(positives)\n\n    return (largest_negative, smallest_positive)```"}
