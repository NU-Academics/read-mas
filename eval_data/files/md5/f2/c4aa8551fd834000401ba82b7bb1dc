{"task_id": "HumanEval/31", "solution": "```python\ndef is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n```"}
{"task_id": "HumanEval/34", "solution": "```python\ndef unique(l: list):\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    unique_elements = set(l)\n    sorted_unique_elements = sorted(list(unique_elements))\n    return sorted_unique_elements\n```"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\n        return []\n\n    indices_to_sort = []\n    elements_to_sort = []\n    for i in range(len(l)):\n        if i % 3 == 0:\n            indices_to_sort.append(i)\n            elements_to_sort.append(l[i])\n\n    elements_to_sort.sort()\n\n    l_prime = list(l)\n    sorted_elements_iter = iter(elements_to_sort)\n    for i in indices_to_sort:\n        l_prime[i] = next(sorted_elements_iter)\n\n    return l_prime"}
{"task_id": "HumanEval/35", "solution": "```python\ndef max_element(l: list):\n    \"\"\"Return maximum element in the list.\"\"\"\n    # Validate that the input is a list, as per design context and BR1.\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list\")\n\n    # Validate that the list is not empty, as per design context and BR2.\n    if not l:\n        raise ValueError(\"Input list cannot be empty\")\n\n    # Validate that all elements in the list are numerical, as per design context and BR3.\n    for element in l:\n        if not isinstance(element, (int, float)):\n            raise TypeError(\"List elements must be numerical\")\n\n    # Initialize the maximum value with the first element of the list.\n    max_val = l[0]\n\n    # Iterate through the rest of the elements to find the true maximum.\n    for element in l[1:]:\n        if element > max_val:\n            max_val = element\n\n    return max_val\n```"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    \"\"\"\n    output_list = list(l) # Create a mutable copy of the input list.\n    even_elements = []\n\n    # Extract all elements at even indices.\n    for i in range(len(l)):\n        if i % 2 == 0:\n            even_elements.append(l[i])\n\n    # Sort the extracted even elements.\n    even_elements.sort()\n\n    # Place the sorted even elements back into the even indices of the output list.\n    even_idx_ptr = 0\n    for i in range(len(output_list)):\n        if i % 2 == 0:\n            output_list[i] = even_elements[even_idx_ptr]\n            even_idx_ptr += 1\n\n    return output_list"}
{"task_id": "HumanEval/36", "solution": "```python\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    \"\"\"\n    def _is_divisible_by_11_or_13(num: int) -> bool:\n        \"\"\"Checks if a number is divisible by 11 or 13.\"\"\"\n        return num % 11 == 0 or num % 13 == 0\n\n    def _count_digit_7(num: int) -> int:\n        \"\"\"Counts occurrences of the digit '7' in a number.\"\"\"\n        return str(num).count('7')\n\n    total_count = 0\n    for i in range(1, n):\n        if _is_divisible_by_11_or_13(i):\n            total_count += _count_digit_7(i)\n    return total_count\n```"}
{"task_id": "HumanEval/38", "solution": "```python\ndef decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse the cyclic shift for groups of three characters.\n    # If an encoded group is 'c1c2c3', the original was 'c3c1c2'.\n    groups = [(group[2] + group[0] + group[1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)\n```"}
