{"task_id": "HumanEval/137", "solution": "```python\nimport numbers\nfrom typing import Any, Type, Union\n\nclass InputParameter:\n    \"\"\"\n    Encapsulates an input value, its original type, and its converted numerical (float) representation.\n    Handles string parsing for real numbers with comma or period as decimal separators.\n    \"\"\"\n    def __init__(self, value: Any):\n        self._original_value = value\n        self._original_type = type(value)\n        self._numeric_value = self._convert_to_float(value)\n\n    def get_original_value(self) -> Any:\n        \"\"\"Returns the original input value.\"\"\"\n        return self._original_value\n\n    def get_numeric_value(self) -> float:\n        \"\"\"Returns the numerical (float) representation of the value.\"\"\"\n        return self._numeric_value\n\n    def _convert_to_float(self, value: Any) -> float:\n        \"\"\"\n        Converts the input value to a float, handling int, float, and string representations\n        of real numbers, including comma and period decimal separators.\n        \"\"\"\n        if isinstance(value, numbers.Real):\n            return float(value)\n        elif isinstance(value, str):\n            normalized_string = value.replace(',', '.')\n            return float(normalized_string)\n        else:\n            # As per SRS FR1, inputs are int, float, or str. This case should not be reached.\n            raise TypeError(f\"Unsupported input type: {self._original_type}\")\n\ndef compare_one(a: Any, b: Any) -> Union[Any, None]:\n    \"\"\"\n    Compares two input values (integers, floats, or strings representing real numbers)\n    and returns the larger value preserving its original type, or None if equal.\n    \"\"\"\n    param_a = InputParameter(a)\n    param_b = InputParameter(b)\n\n    numeric_a = param_a.get_numeric_value()\n    numeric_b = param_b.get_numeric_value()\n\n    if numeric_a > numeric_b:\n        return param_a.get_original_value()\n    elif numeric_b > numeric_a:\n        return param_b.get_original_value()\n    else:\n        return None\n```"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    def _factorial(k):\n        \"\"\"Calculates the standard factorial of k.\"\"\"\n        result = 1\n        for i in range(1, k + 1):\n            result *= i\n        return result\n\n    overall_result = 1\n    for i in range(1, n + 1):\n        overall_result *= _factorial(i)\n    return overall_result"}
{"task_id": "HumanEval/140", "solution": "import re\n\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n    \"\"\"\n    # First, replace sequences of 3 or more spaces with a single hyphen.\n    # This ensures that \"   \" becomes \"-\" before individual spaces are processed.\n    modified_text = re.sub(r' {3,}', '-', text)\n\n    # Then, replace any remaining single spaces with underscores.\n    # This covers cases like \" \" and also spaces that were not part of 3+ consecutive sequence.\n    modified_text = modified_text.replace(' ', '_')\n\n    return modified_text"}
{"task_id": "HumanEval/141", "solution": "import re\n\nclass FileName:\n    \"\"\"Encapsulates file name parsing and validation logic.\"\"\"\n\n    ALLOWED_EXTENSIONS = {'txt', 'exe', 'dll'}\n    LATIN_LETTERS = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ'\n\n    def __init__(self, name: str):\n        self._name = name\n        self._digit_count = 0\n        self._dot_count = 0\n        self._prefix = ''\n        self._extension = ''\n        self._is_parsed = False\n\n    def _parse(self) -> None:\n        \"\"\"Parses the file name to populate internal attributes.\"\"\"\n        if self._is_parsed:\n            return\n\n        self._digit_count = sum(1 for char in self._name if char.isdigit())\n        self._dot_count = self._name.count('.')\n\n        if self._dot_count == 1:\n            parts = self._name.split('.', 1)\n            self._prefix = parts[0]\n            self._extension = parts[1]\n\n        self._is_parsed = True\n\n    def validateDigitCount(self) -> bool:\n        \"\"\"Validates that the count of digits is not greater than three.\"\"\"\n        self._parse()\n        return self._digit_count <= 3\n\n    def validateDotCount(self) -> bool:\n        \"\"\"Validates that the file name contains exactly one dot character.\"\"\"\n        self._parse()\n        return self._dot_count == 1\n\n    def validatePrefixNotEmpty(self) -> bool:\n        \"\"\"Validates that the substring before the dot is not empty.\"\"\"\n        self._parse()\n        return bool(self._prefix)\n\n    def validatePrefixStartLetter(self) -> bool:\n        \"\"\"Validates that the substring before the dot starts with a Latin alphabet letter.\"\"\"\n        self._parse()\n        return bool(self._prefix) and self._prefix[0] in self.LATIN_LETTERS\n\n    def validateExtensionType(self) -> bool:\n        \"\"\"Validates that the extension is one of 'txt', 'exe', or 'dll'.\"\"\"\n        self._parse()\n        return self._extension in self.ALLOWED_EXTENSIONS\n\n    def isValid(self) -> bool:\n        \"\"\"Returns True if all validation conditions are met, False otherwise.\"\"\"\n        self._parse()\n\n        if not self.validateDotCount():\n            return False\n\n        return (\n            self.validateDigitCount() and\n            self.validatePrefixNotEmpty() and\n            self.validatePrefixStartLetter() and\n            self.validateExtensionType()\n        )\n\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\"\"\"\n    file_obj = FileName(file_name)\n    if file_obj.isValid():\n        return 'Yes'\n    else:\n        return 'No'"}
{"task_id": "HumanEval/142", "solution": "```python\ndef sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n\n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    total_sum = 0\n    for i, x in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += x ** 2\n        elif i % 4 == 0:\n            total_sum += x ** 3\n        else:\n            total_sum += x\n    return total_sum\n```"}
{"task_id": "HumanEval/144", "solution": "```python\ndef simplify(x, n):\n    \"\"\"Checks if the product of two string fractions x and n results in a whole number.\"\"\"\n    num_x_str, den_x_str = x.split('/')\n    num_x = int(num_x_str)\n    den_x = int(den_x_str)\n\n    num_n_str, den_n_str = n.split('/')\n    num_n = int(num_n_str)\n    den_n = int(den_n_str)\n\n    product_numerator = num_x * num_n\n    product_denominator = den_x * den_n\n\n    return product_numerator % product_denominator == 0\n```"}
{"task_id": "HumanEval/143", "solution": "```python\ndef words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, keeping only those with prime lengths.\n    Returns the filtered words as a space-separated string.\n    \"\"\"\n    def is_prime(n):\n        \"\"\"Checks if a number n is prime.\"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    words = sentence.split(' ')\n    prime_length_words = []\n    for word in words:\n        if is_prime(len(word)):\n            prime_length_words.append(word)\n\n    return ' '.join(prime_length_words)\n```"}
{"task_id": "HumanEval/145", "solution": "```python\nclass Integer:\n    \"\"\"Helper class to encapsulate integer properties for sorting.\"\"\"\n    def __init__(self, value: int, original_index: int):\n        self.value = value\n        self.original_index = original_index\n        self.digit_sum = self._calculate_digit_sum()\n\n    def _calculate_digit_sum(self) -> int:\n        \"\"\"Calculates the sum of the absolute values of the digits.\"\"\"\n        s = str(abs(self.value))\n        return sum(int(digit) for digit in s)\n\n    def getDigitSum(self) -> int:\n        return self.digit_sum\n\n    def getValue(self) -> int:\n        return self.value\n\n    def getOriginalIndex(self) -> int:\n        return self.original_index\n\n    def __lt__(self, other) -> bool:\n        \"\"\"Compares two Integer objects for sorting.\"\"\"\n        if self.digit_sum != other.digit_sum:\n            return self.digit_sum < other.digit_sum\n        return self.original_index < other.original_index\n\ndef order_by_points(nums):\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    If digit sums are equal, original list index is used as a tie-breaker.\n    \"\"\"\n    if not nums:\n        return []\n\n    # Create Integer objects with original index and digit sum\n    integer_objects = [Integer(num, i) for i, num in enumerate(nums)]\n\n    # Sort the list of Integer objects\n    integer_objects.sort()\n\n    # Extract original values from the sorted Integer objects\n    return [obj.getValue() for obj in integer_objects]\n```"}
{"task_id": "HumanEval/146", "solution": "```python\ndef specialFilter(nums):\n    \"\"\"\n    Counts elements in the array that are greater than 10 and have both\n    first and last digits (of their absolute value) as odd.\n    \"\"\"\n\n    def _is_greater_than_10(num):\n        \"\"\"Checks if a number is strictly greater than 10.\"\"\"\n        return num > 10\n\n    def _get_first_digit(num):\n        \"\"\"Extracts the first digit from the absolute value of a number.\"\"\"\n        return int(str(abs(num))[0])\n\n    def _get_last_digit(num):\n        \"\"\"Extracts the last digit from the absolute value of a number.\"\"\"\n        return int(str(abs(num))[-1])\n\n    def _is_odd(digit):\n        \"\"\"Checks if a given digit is odd.\"\"\"\n        return digit % 2 != 0\n\n    count = 0\n    for num in nums:\n        if _is_greater_than_10(num):\n            first_digit = _get_first_digit(num)\n            last_digit = _get_last_digit(num)\n            if _is_odd(first_digit) and _is_odd(last_digit):\n                count += 1\n    return count\n```"}
{"task_id": "HumanEval/148", "solution": "```python\nPLANETS_IN_ORDER = (\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\")\nPLANET_ORBITAL_MAP = {planet: i for i, planet in enumerate(PLANETS_IN_ORDER)}\n\ndef bf(planet1, planet2):\n    \"\"\"\n    There are eight planets in our solar system: the closerst to the Sun\n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn,\n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2.\n    The function should return a tuple containing all planets whose orbits are\n    located between the orbit of planet1 and the orbit of planet2, sorted by\n    the proximity to the sun.\n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names.\n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    \"\"\"\n\n    idx1 = PLANET_ORBITAL_MAP.get(planet1)\n    idx2 = PLANET_ORBITAL_MAP.get(planet2)\n\n    if idx1 is None or idx2 is None:\n        return ()\n\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    # Slice the planets that are strictly between the two input planets\n    return PLANETS_IN_ORDER[start_idx + 1:end_idx]\n```"}
{"task_id": "HumanEval/149", "solution": "```python\ndef sorted_list_sum(lst):\n    \"\"\"Filters a list of strings, keeping only those with even lengths,\n    then sorts the remaining strings by length (ascending) and alphabetically (ascending) for ties.\n    \"\"\"\n    even_length_strings = []\n    for s in lst:\n        if len(s) % 2 == 0:\n            even_length_strings.append(s)\n\n    # Sort using a custom key: (length, string)\n    even_length_strings.sort(key=lambda x: (len(x), x))\n\n    return even_length_strings\n```"}
{"task_id": "HumanEval/147", "solution": "```python\ndef get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from array 'a'\n    where i < j < k and their sum is a multiple of 3.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    a = []\n    for idx in range(n):\n        # a[idx] = (idx+1)*(idx+1)-(idx+1)+1, which corresponds to the problem's a[idx+1] = (idx+1)*(idx+1)-(idx+1)+1\n        value = (idx + 1) * (idx + 1) - (idx + 1) + 1\n        a.append(value)\n\n    count = 0\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            for k in range(j + 1, n):\n                triple_sum = a[i] + a[j] + a[k]\n                if triple_sum % 3 == 0:\n                    count += 1\n\n    return count\n```"}
{"task_id": "HumanEval/151", "solution": "```python\ndef double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n\n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0\n\n    If the input list is empty, return 0.\n    '''\n\n    def _is_integer(val):\n        \"\"\"Checks if a value is an integer.\"\"\"\n        return isinstance(val, int)\n\n    def _is_positive(val):\n        \"\"\"Checks if an integer is positive (greater than 0).\"\"\"\n        return val > 0\n\n    def _is_odd(val):\n        \"\"\"Checks if an integer is odd.\"\"\"\n        return val % 2 != 0\n\n    def _get_square(val):\n        \"\"\"Calculates the square of an integer.\"\"\"\n        return val * val\n\n    if not lst:\n        return 0\n\n    total_sum_of_squares = 0\n\n    for element in lst:\n        if not _is_integer(element):\n            continue\n\n        if not _is_positive(element):\n            continue\n\n        if _is_odd(element):\n            square = _get_square(element)\n            total_sum_of_squares += square\n\n    return total_sum_of_squares\n```"}
{"task_id": "HumanEval/150", "solution": "```python\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n\n    \"\"\"\n    def _is_prime(n: int) -> bool:\n        \"\"\"Determines if an integer n is a prime number.\n        A prime number is a natural number greater than 1 that has no positive divisors other than 1 and itself.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    if _is_prime(n):\n        return x\n    else:\n        return y\n```"}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"I think we all remember that feeling when the result of some long-awaited\n    event is finally known. The feelings and thoughts you have at that moment are\n    definitely worth noting down and comparing.\n    Your task is to determine if a person correctly guessed the results of a number of matches.\n    You are given two arrays of scores and guesses of equal length, where each index shows a match.\n    Return an array of the same length denoting how far off each guess was. If they have guessed correctly,\n    the value is 0, and if not, the value is the absolute difference between the guess and the score.\n\n\n    example:\n\n    compare([1,2,3,4,5,1],[1,2,3,4,2,-2]) -> [0,0,0,0,3,3]\n    compare([0,5,0,0,0,4],[4,1,1,0,0,-2]) -> [4,4,1,0,0,6]\n    \"\"\"\n    if len(game) != len(guess):\n        raise ValueError(\"Input arrays must have equal length\")\n\n    results = []\n    for g_score, s_guess in zip(game, guess):\n        if g_score == s_guess:\n            results.append(0)\n        else:\n            results.append(abs(g_score - s_guess))\n\n    return results"}
{"task_id": "HumanEval/154", "solution": "```python\nclass Word:\n    \"\"\"Encapsulates a string value and provides methods for string operations.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def get_rotations(self) -> list['Word']:\n        \"\"\"Generates and returns a list of Word objects representing all cyclic rotations.\"\"\"\n        rotations = []\n        n = len(self._value)\n        if n == 0:\n            return [Word(\"\")]\n        for i in range(n):\n            rotated_string = self._value[i:] + self._value[:i]\n            rotations.append(Word(rotated_string))\n        return rotations\n\n    def contains_substring(self, other_word: 'Word') -> bool:\n        \"\"\"Checks if the current word contains the other word's value as a substring.\"\"\"\n        return other_word._value in self._value\n\ndef cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\"\"\"\n    word_a = Word(a)\n    word_b = Word(b)\n\n    b_rotations = word_b.get_rotations()\n\n    for rotation_word in b_rotations:\n        if word_a.contains_substring(rotation_word):\n            return True\n\n    return False\n```\n"}
{"task_id": "HumanEval/156", "solution": "```python\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n\n    _ROMAN_MAP = [\n        (1000, \"M\"),\n        (900, \"CM\"),\n        (500, \"D\"),\n        (400, \"CD\"),\n        (100, \"C\"),\n        (90, \"XC\"),\n        (50, \"L\"),\n        (40, \"XL\"),\n        (10, \"X\"),\n        (9, \"IX\"),\n        (5, \"V\"),\n        (4, \"IV\"),\n        (1, \"I\"),\n    ]\n\n    def _validate_input(number):\n        \"\"\"Ensures the input integer is within the valid range [1, 1000].\"\"\"\n        if not (1 <= number <= 1000):\n            raise ValueError(\"Number must be between 1 and 1000, inclusive.\")\n\n    def _convert_to_roman_uppercase(number):\n        \"\"\"Performs the core integer-to-Roman numeral conversion (producing uppercase Roman numerals).\"\"\"\n        roman_numeral = []\n        for value, symbol in _ROMAN_MAP:\n            while number >= value:\n                roman_numeral.append(symbol)\n                number -= value\n        return \"\".join(roman_numeral)\n\n    _validate_input(number)\n    uppercase_roman = _convert_to_roman_uppercase(number)\n    return uppercase_roman.lower()\n```"}
{"task_id": "HumanEval/157", "solution": "```python\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    import math\n\n    # Validate inputs: Ensure all side lengths are positive.\n    if a <= 0 or b <= 0 or c <= 0:\n        return False\n\n    # Calculate squares of the side lengths.\n    a_sq = a * a\n    b_sq = b * b\n    c_sq = c * c\n\n    # Use a small tolerance for robust floating-point comparisons.\n    tolerance = 1e-9\n\n    # Check all three permutations of the Pythagorean theorem.\n    if math.isclose(a_sq + b_sq, c_sq, rel_tol=tolerance, abs_tol=tolerance) or \\\n       math.isclose(a_sq + c_sq, b_sq, rel_tol=tolerance, abs_tol=tolerance) or \\\n       math.isclose(b_sq + c_sq, a_sq, rel_tol=tolerance, abs_tol=tolerance):\n        return True\n\n    return False\n```"}
{"task_id": "HumanEval/155", "solution": "```python\nclass InputInteger:\n    \"\"\"Represents the integer input and provides methods for processing its digits.\"\"\"\n    def __init__(self, num: int):\n        self._value = num\n\n    def get_absolute_value(self) -> int:\n        \"\"\"Returns the absolute value of the stored integer.\"\"\"\n        return abs(self._value)\n\n    def extract_digits(self) -> list[int]:\n        \"\"\"Extracts and returns a list of individual digits from the absolute value.\"\"\"\n        abs_val_str = str(self.get_absolute_value())\n        if abs_val_str == \"0\":\n            return [0]\n        return [int(d) for d in abs_val_str]\n\nclass Digit:\n    \"\"\"Represents a single digit and determines its parity.\"\"\"\n    def __init__(self, digit_value: int):\n        self._digit_value = digit_value\n\n    def is_even(self) -> bool:\n        \"\"\"Returns True if the digit is even, False otherwise.\"\"\"\n        return self._digit_value % 2 == 0\n\n    def is_odd(self) -> bool:\n        \"\"\"Returns True if the digit is odd, False otherwise.\"\"\"\n        return self._digit_value % 2 != 0\n\nclass EvenOddCountResult:\n    \"\"\"Stores the final counts of even and odd digits.\"\"\"\n    def __init__(self, even_count: int = 0, odd_count: int = 0):\n        self.even_count = even_count\n        self.odd_count = odd_count\n\n    def to_tuple(self) -> tuple[int, int]:\n        \"\"\"Converts the result to a tuple (even_count, odd_count).\"\"\"\n        return (self.even_count, self.odd_count)\n\ndef even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    input_integer = InputInteger(num)\n    digits = input_integer.extract_digits()\n    result = EvenOddCountResult()\n\n    for digit_value in digits:\n        digit = Digit(digit_value)\n        if digit.is_even():\n            result.even_count += 1\n        else:\n            result.odd_count += 1\n\n    return result.to_tuple()\n```"}
{"task_id": "HumanEval/153", "solution": "```python\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"You will be given the name of a class (a string) and a list of extensions.\n    The extensions are to be used to load additional classes to the class. The\n    strength of the extension is as follows: Let CAP be the number of the uppercase\n    letters in the extension's name, and let SM be the number of lowercase letters\n    in the extension's name, the strength is given by the fraction CAP - SM.\n    You should find the strongest extension and return a string in this\n    format: ClassName.StrongestExtensionName.\n    If there are two or more extensions with the same strength, you should\n    choose the one that comes first in the list.\n    For example, if you are given \"Slices\" as the class and a list of the\n    extensions: ['SErviNGSliCes', 'Cheese', 'StuFfed'] then you should\n    return 'Slices.SErviNGSliCes' since 'SErviNGSliCes' is the strongest extension\n    (its strength is -1).\n    Example:\n    for Strongest_Extension('my_class', ['AA', 'Be', 'CC']) == 'my_class.AA'\n    \"\"\"\n    if not extensions:\n        # As per the design document's assumption, the extensions list is non-empty.\n        # If it were empty, this behavior would need to be defined (e.g., raise an error, return empty string).\n        # For this problem, we'll return an empty string if, against assumptions, an empty list is passed.\n        return f\"{class_name}.\" # Or a more appropriate error/default\n\n    max_strength = float('-inf')\n    strongest_extension_name = \"\"\n\n    for extension_name in extensions:\n        cap = sum(1 for char in extension_name if char.isupper())\n        sm = sum(1 for char in extension_name if char.islower())\n        current_strength = cap - sm\n\n        # If the current extension's strength is greater than the maximum found so far,\n        # update the maximum strength and the strongest extension name.\n        # The tie-breaking rule (choose the one that comes first) is implicitly handled\n        # by only updating when `current_strength` is strictly greater.\n        # If `current_strength` is equal, we do not update, thus preserving the\n        # extension that appeared earlier in the list.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension_name\n\n    return f\"{class_name}.{strongest_extension_name}\"\n\n```"}
{"task_id": "HumanEval/158", "solution": "```python\ndef find_max(words):\n    \"\"\"\n    Finds the word with the maximum number of unique characters from a list of words.\n    If multiple words have the same maximum count, the lexicographically smallest is chosen.\n    Returns an empty string if the input list is empty.\n    \"\"\"\n    max_unique_chars_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_chars_count = len(set(word))\n\n        if current_unique_chars_count > max_unique_chars_count:\n            max_unique_chars_count = current_unique_chars_count\n            result_word = word\n        elif current_unique_chars_count == max_unique_chars_count:\n            if word < result_word:\n                result_word = word\n    return result_word\n```"}
{"task_id": "HumanEval/162", "solution": "import hashlib\n\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n\n    >>> string_to_md5('Hello world') == '3e25960a79dbc69b674cd4ec67a72c62'\n    \"\"\"\n    if not text:\n        return None\n\n    # Encode the string to bytes and compute the MD5 hash.\n    md5_hash_object = hashlib.md5(text.encode('utf-8'))\n    return md5_hash_object.hexdigest()"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n    \"\"\"\n    # Validate input parameters according to the constraints [0, 1000].\n    if not (0 <= number <= 1000 and 0 <= need <= 1000 and 0 <= remaining <= 1000):\n        raise ValueError(\"All input parameters (number, need, remaining) must be between 0 and 1000, inclusive.\")\n\n    # Determine the actual number of carrots consumed in this meal.\n    # The rabbit eats what it needs, or all that is remaining, whichever is less.\n    carrots_consumed_now = min(need, remaining)\n\n    # Calculate the total number of carrots eaten after this meal.\n    total_eaten_carrots = number + carrots_consumed_now\n\n    # Calculate the number of carrots left in stock after this meal.\n    carrots_left_in_stock = remaining - carrots_consumed_now\n\n    return [total_eaten_carrots, carrots_left_in_stock]"}
{"task_id": "HumanEval/160", "solution": "```python\ndef do_algebra(operator, operand):\n    \"\"\"\n    Constructs an algebraic expression from given operators and operands, then evaluates it.\n    Assumes valid inputs as per problem description constraints for types and lengths.\n    \"\"\"\n    expression_parts = [str(operand[0])]\n    for i in range(len(operator)):\n        expression_parts.append(operator[i])\n        expression_parts.append(str(operand[i+1]))\n\n    expression_string = \" \".join(expression_parts)\n    result = eval(expression_string)\n    return int(result)\n```"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Transforms a string by reversing letter cases or reversing the whole string if no letters are present.\"\"\"\n    contains_letters = False\n    for char in s:\n        if char.isalpha():\n            contains_letters = True\n            break\n\n    if not contains_letters:\n        return s[::-1]\n    else:\n        result_chars = []\n        for char in s:\n            if char.isalpha():\n                if char.islower():\n                    result_chars.append(char.upper())\n                else: # char is uppercase\n                    result_chars.append(char.lower())\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    even_single_digits = [0, 2, 4, 6, 8]\n    result_list = []\n\n    for digit in even_single_digits:\n        if min_val <= digit <= max_val:\n            result_list.append(digit)\n\n    return sorted(result_list)"}
