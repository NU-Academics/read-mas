{"task_id": "HumanEval/39", "solution": "import math\nfrom typing import Iterator\n\ndef _is_prime(num: int) -> bool:\n    \"\"\"Checks if a given number is prime.\n    Handles edge cases for 0, 1, 2, 3 and uses trial division up to sqrt(num).\"\"\"\n    if num < 2:\n        return False\n    if num == 2 or num == 3:\n        return True\n    if num % 2 == 0 or num % 3 == 0:\n        return False\n    i = 5\n    while i * i <= num:\n        if num % i == 0 or num % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef _fibonacci_generator() -> Iterator[int]:\n    \"\"\"Generates an infinite sequence of Fibonacci numbers (0, 1, 1, 2, 3, 5, ...).\"\"\"\n    a, b = 0, 1\n    while True:\n        yield a\n        a, b = b, a + b\n\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    prime_fib_count = 0\n    fib_gen = _fibonacci_generator()\n\n    # Skip initial 0, 1, 1 from the Fibonacci sequence as they are not prime.\n    # The first number to check for primality will be 2.\n    next(fib_gen) # consumes 0\n    next(fib_gen) # consumes 1\n    next(fib_gen) # consumes 1\n\n    while True:\n        current_fib_num = next(fib_gen)\n        if _is_prime(current_fib_num):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                return current_fib_num"}
