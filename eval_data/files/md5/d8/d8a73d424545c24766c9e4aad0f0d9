.n = n\n        self.p = p\n        self._result: IntegerValue | None = None\n\n    def validate_inputs(self) -> bool:\n        \"\"\"Validates that n and p are integers, raising TypeError if invalid.\"\"\"\n        if not isinstance(self.n, int):\n            raise TypeError(\"Exponent 'n' must be an integer.\")\n        if not isinstance(self.p, int):\n            raise TypeError(\"Modulus 'p' must be an integer.\")\n        return True\n\n    def compute(self) -> int:\n        \"\"\"Computes 2^n modulo p using ComputationEngine and stores the result.\"\"\"\n        result_value = ComputationEngine.pow_mod(2, self.n, self.p)\n        self._result = IntegerValue(result_value)\n        return self._result.value\ndef modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    >>> modp(3, 5)\n    3\n    >>> modp(1101, 101)\n    2\n    >>> modp(0, 101)\n    1\n    >>> modp(3, 11)\n    8\n    >>> modp(100, 101)\n    1\n    \"\"\"\n    mod_exp_func = ModularExponentiationFunction(n, p)\n    mod_exp_func.validate_inputs()\n    return mod_exp_func.compute()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/53": [{"task_id": "HumanEval/53", "solution": "def add(x: int, y: int):\n    \"\"\"Add two numbers x and y\n    >>> add(2, 3)\n    5\n    >>> add(5, 7)\n    12\n    \"\"\"\n    return x + y", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/55": [{"task_id": "HumanEval/55", "solution": "def fib(n: int) -> int:\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    def compute(val: int) -> int:\n        if val == 1 or val == 2:\n            return 1\n        \n        a, b = 1, 1\n        for _ in range(3, val + 1):\n            next_fib = a + b\n            a = b\n            b = next_fib\n        return b\n\n    return compute(n)", "base_status": "pass", "plus_sta