e_list_wrapper.values\n\n    # Public API entry point\n    service = CountUpToFunction()\n    return service.count_up_to(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/107": [{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n\n    class Input:\n        \"\"\"Encapsulates the input value and validation logic.\"\"\"\n        def __init__(self, n_val: int):\n            self.n: int = n_val\n\n        def validate(self) -> None:\n            \"\"\"Validate that 1 <= n <= 1000; raises ValueError on invalid input.\"\"\"\n            if not isinstance(self.n, int) or not (1 <= self.n <= 1000):\n                raise ValueError(\"Input 'n' must be an integer between 1 and 1000, inclusive.\")\n\n    class IntegerValue:\n        \"\"\"Represents a single integer value with palindrome and parity checks.\"\"\"\n        def __init__(self, value: int):\n            self.value: int = value\n            self.isPalindrome: bool = False\n            self.parity: str = \"\"\n\n        def checkPalindrome(self) -> bool:\n            \"\"\"Computes and sets self.isPalindrome based on decimal string reversal.\"\"\"\n            s_val = str(self.value)\n            self.isPalindrome = (s_val == s_val[::-1])\n            return self.isPalindrome\n\n        def determineParity(self) -> str:\n            \"\"\"Computes and sets self.parity as 'even' if value % 2 == 0 else 'odd'.\"\"\"\n            self.parity = \"even\" if self.value % 2 == 0 else \"odd\"\n            return self.parity\n\n    class Result:\n        \"\"\"Holds aggregated palindrome counts and provides the tuple output.\"\"\"\n        def __init__(self, evenCount: int, oddCount: int):\n            self.evenCount: int = evenCount\n            self.oddCount: int = oddCount\n\n        def get(self) -> tuple:\n            \"\"\"Returns the aggregated counts as a tuple (evenCount, oddCount).\"\"\"\n            return (self.evenCount, self.oddCount)\n\n    class PalindromeCounter:\n        \"\"\"Accumulates even and odd palindrome counts.\"\"\"\n        def __init__(self):\n            self.evenCount: int = 0\n            self.oddCount: int = 0\n\n        def countPalindromes(self, values: list[IntegerValue]) -> Result:\n            \"\"\"Iterates values, checks for palindromes and parity, then returns a Result.\"\"\"\n            for iv in values:\n                if iv.checkPalindrome():\n                    iv.determineParity()\n                    if iv.parity == \"even\":\n                        self.evenCount += 1\n                    else:\n                        self.oddCount += 1\n            return Result(self.evenCount, self.oddCount)\n\n    input_obj = Input(n)\n    input_obj.validate()\n\n    integer_values: list[IntegerValue] = []\n    for i in range(1, n + 1):\n        integer_values.append(IntegerValue(i))\n\n    counter = PalindromeCounter()\n    result_obj = counter.countPalindromes(integer_values)\n\n    return result_obj.get()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/109": [{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"We have an array 'arr' of N integers arr[1], arr[2], ..., arr[N].The\n    numbers in the array will be randomly ordered. Your task is to determine if\n    it is possible to get an array sorted in non-decreasing order by performing \n    the following operation on the given array:\n        You are allowed to perform right shift operation any number of times.\n    \n    One right shift operation means shifting all elements of the array by one\n    position in the right direction. The last element of the array will be moved to\n    the starting position in the array i.e. 0th index. \n\n    If it is possible to obtain the sorted array by performing the above operation\n    then return True else return False.\n    If the given array is empty then return True.\n\n    Note: The given list is guaranteed to have unique elements.\n\n    For Example:\n    \n    move_one_ball([3, 4, 5, 1, 2])==>True\n    Explanation: By performin 2 right shift operations, non-decreasing order can\n                 be achieved for the given array.\n    move_one_ball([3, 5, 4, 1, 2])==>False\n    Explanation:It is not possible to get non-decreasing order for the given\n                array by performing any number of right shift operations.\n                \n    \"\"\"\n    n = len(arr)\n\n    # Handle empty or single-element arrays.\n    if n <= 1:\n        return True\n\n    num_breaks = 0\n    # Find points where arr[i] > arr[i+1], indicating a break in non-decreasing order.\n    for i in range(n - 1):\n        if arr[i] > arr[i+1]:\n            num_breaks += 1\n            # If more than one break is found, it's impossible to sort with a single rotation.\n            if num_breaks > 1:\n                return False\n\n    # If no breaks were found, the array is already sorted.\n    if num_breaks == 0:\n        return True\n    # If exactly one break was found, check the wrap-around condition for a cyclic sort.\n    # The last element must be less than or equal to the first element to form a sorted cycle.\n    else: # num_breaks must be 1\n        return arr[n-1] <= arr[0]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/108": [{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Counts elements in an array where the sum of signed digits is greater than 0.\n    For negative numbers, the most significant digit is treated as negative.\n    \"\"\"\n\n    class Digit:\n        \"\"\"Value object representing a digit's value and position.\"\"\"\n        def __init__(self, position: int, value: int):\n            self.position = position\n            self.value = value\n\n    class IntegerElement:\n        \"\"\"Encapsulates an integer and provides digit-sum computation.\"\"\"\n        def __init__(self, value: int):\n            self.value = value\n\n        def computeDigitSum(self) -> int:\n            \"\"\"\n            Computes the signed digit sum. MSD is negative for negative integers.\n            \"\"\"\n            if self.value == 0:\n                return 0\n\n            s_value = str(abs(self.value))\n            digit_sum = 0\n\n            if self.value < 0:\n                # The first digit (most significant) is negative\n                digit_sum += -int(s_value[0])\n                # Add remaining digits as positive\n                for i in range(1, len(s_value)):\n                    digit_sum += int(s_value[i])\n            else:\n                # All digits are positive\n                for digit_char in s_value:\n                    digit_sum += int(digit_char)\n            \n            return digit_sum\n\n        def isDigitSumPositive(self) -> bool:\n            \"\"\"Checks if the computed digit sum is strictly positive.\"\"\"\n            return self.computeDigitSum() > 0\n\n    class Result:\n        \"\"\"Value object holding the final count.\"\"\"\n        def __init__(self):\n            self.count = 0\n\n    class CountNumsFunction:\n        \"\"\"Orchestrates processing of the input array.\"\"\"\n        def count_nums(self, arr: list[int]) -> int:\n            \"\"\"\n            Processes the array to count elements with a positive signed digit sum.\n            \"\"\"\n            result = Result()\n            for num in arr:\n                element = IntegerElement(num)\n                if element.isDigitSumPositive():\n                    result.count += 1\n            return result.count\n\n    # The public entry point delegates to CountNumsFunction.\n    orchestrator = CountNumsFunction()\n    return orchestrator.count_nums(arr)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/112": [{"task_id": "HumanEval/112", "solution": "def reverse_delete(s,c):\n    \"\"\"Task\n    We are given two strings s and c, you have to deleted all the characters in s that are equal to any character in c\n    then check if the result string is palindrome.\n    A string is called palindrome if it reads the same backward as forward.\n    You should return a tuple containing the result string and True/False for the check.\n    Example\n    For s = \"abcde\", c = \"ae\", the result should be ('bcd',False)\n    For s = \"abcdef\", c = \"b\"  the result should be ('acdef',False)\n    For s = \"abcdedcba\", c = \"ab\", the result should be ('cdedc',True)\n    \"\"\"\n    class InputString:\n        def __init__(self, value: str):\n            self.value = value\n\n    class DeleteSet:\n        def __init__(self, value: str):\n            self._chars = set(value)\n\n        def chars(self) -> set:\n            return self._chars\n\n    class ResultString:\n        def __init__(self, value: str, is_palindrome: bool):\n            self.value = value\n            self.is_palindrome = is_palindrome\n\n    class PalindromeChecker:\n        def is_palindrome(self, s: str) -> bool:\n            return s == s[::-1]\n\n    class ReverseDeleteService:\n        def reverse_delete(self, s: str, c: str) -> tuple[str, bool]:\n            if not s:\n                return (\"\", True)\n\n            input_str = InputString(s)\n            delete_set = DeleteSet(c)\n            delete_chars = delete_set.chars()\n\n            result_buffer = []\n            for char in input_str.value:\n                if char not in delete_chars:\n                    result_buffer.append(char)\n\n            result_value = \"\".join(result_buffer)\n\n            palindrome_checker = PalindromeChecker()\n            is_pal = palindrome_checker.is_palindrome(result_value)\n\n            return (result_value, is_pal)\n\n    service = ReverseDeleteService()\n    return service.reverse_delete(s, c)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/114": [{"task_id": "HumanEval/114", "solution": "from typing import Sequence, List\nclass NumsArray:\n    \"\"\"A wrapper for a sequence of integers.\"\"\"\n    def __init__(self, values: Sequence[int]) -> None:\n        self.values: List[int] = list(values)\n    \n    def length(self) -> int:\n        return len(self.values)\nclass Result:\n    \"\"\"A data class to hold the integer result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value: int = value\nclass InputValidator:\n    \"\"\"Validates input 'nums' according to specified rules.\"\"\"\n    def _is_integer_like(self, value) -> bool:\n        return isinstance(value, int)\n\n    def validate(self, nums) -> bool:\n        if not isinstance(nums, (list, tuple)):\n            raise ValueError(\"Input 'nums' must be a sequence (list or tuple).\")\n        \n        if not nums:\n            raise ValueError(\"Input 'nums' cannot be empty.\")\n            \n        for x in nums:\n            if not self._is_integer_like(x):\n                raise ValueError(\"All elements in 'nums' must be integers.\")\n        \n        return True\nclass MinSubArrayCalculator:\n    \"\"\"Computes the minimum contiguous sub-array sum.\"\"\"\n    def minSubArraySum(self, nums: NumsArray) -> Result:\n        if nums.length() == 1:\n            return Result(nums.values[0])\n\n        current_min = nums.values[0]\n        overall_min = nums.values[0]\n\n        for x in nums.values[1:]:\n            current_min = min(x, current_min + x)\n            overall_min = min(overall_min, current_min)\n        \n        return Result(overall_min)\ndef minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array\n    of nums.\n    Example\n    minSubArraySum([2, 3, 4, 1, 2, 4]) == 1\n    minSubArraySum([-1, -2, -3]) == -6\n    \"\"\"\n    validator = InputValidator()\n    validator.validate(nums)\n\n    nums_wrapper = NumsArray(nums)\n    calculator = MinSubArrayCalculator()\n    result = calculator.minSubArraySum(nums_wrapper)\n    return result.value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/115": [{"task_id": "HumanEval/115", "solution": "def max_fill(grid, capacity):\n    \"\"\"\n    Calculates the total number of times buckets need to be lowered to empty all wells.\n    Each well is a row, and '1's represent water units.\n    \"\"\"\n    total_lowers = 0\n    for row in grid:\n        units_in_well = sum(row)\n        if units_in_well > 0:\n            # Calculate ceiling division using integer arithmetic\n            lowers_for_well = (units_in_well + capacity - 1) // capacity\n            total_lowers += lowers_for_well\n    return total_lowers", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/113": [{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\n    \"\"\"\n\n    class InputList:\n        \"\"\"Represent input list container holding InputString elements.\"\"\"\n        def __init__(self, items: list):\n            self.items = items\n\n    class InputString:\n        \"\"\"Represent a single input string and derived metadata.\"\"\"\n        def __init__(self, value: str):\n            self.value = value\n            self.length = len(value)\n            self.oddCount = 0\n\n    class OddDigitCounter:\n        \"\"\"Count odd digits in a provided string.\"\"\"\n        def countOddDigits(self, s: str) -> int:\n            odd_digits = {'1', '3', '5', '7', '9'}\n            count = 0\n            for char in s:\n                if char in odd_digits:\n                    count += 1\n            return count\n\n    class TemplateProcessor:\n        \"\"\"Apply the fixed template and replace 'i' with count.\"\"\"\n        def __init__(self):\n            self.template = \"the number of odd elements in the string i of the input.\"\n\n        def applyTemplate(self, count: int) -> str:\n            return self.template.replace('i', str(count))\n\n    def _validate_input_list(input_list) -> None:\n        \"\"\"Validate input_list is a list and each element is a digits-only string; raise ValueError on violation.\"\"\"\n        if not isinstance(input_list, list):\n            raise ValueError(\"Invalid input: input must be a list.\")\n        for i, item in enumerate(input_list):\n            if not isinstance(item, str):\n                raise ValueError(f\"Invalid input: element at index {i} must be a string, got {type(item).__name__}.\")\n            if not item.isdigit():\n                raise ValueError(f\"Invalid input: string at index {i} ('{item}') must contain only digits.\")\n\n    _validate_input_list(lst)\n    \n    input_objects = InputList([InputString(v) for v in lst])\n    counter = OddDigitCounter()\n    tp = TemplateProcessor()\n    outputs = []\n    \n    for in_str in input_objects.items:\n        c = counter.countOddDigits(in_str.value)\n        in_str.oddCount = c\n        out_s = tp.applyTemplate(c)\n        outputs.append(out_s)\n        \n    return outputs", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/111": [{"task_id": "HumanEval/111", "solution": "def histogram(test):\n    \"\"\"Given a string representing a space separated lowercase letters, return a dictionary\n    of the letter with the most repetition and containing the corresponding count.\n    If several letters have the same occurrence, return all of them.\n    \n    Example:\n    histogram('a b c') == {'a': 1, 'b': 1, 'c': 1}\n    histogram('a b b a') == {'a': 2, 'b': 2}\n    histogram('a b c a b') == {'a': 2, 'b': 2}\n    histogram('b b b b a') == {'b': 4}\n    histogram('') == {}\n\n    \"\"\"\n    from typing import List, Dict\n\n    # Define helper classes locally inside the function as per design guidance.\n    class InputString:\n        def __init__(self, raw: str):\n            self.raw = raw\n\n        def isEmpty(self) -> bool:\n            # Checks if the input string is explicitly empty (\"\").\n            return self.raw == \"\"\n\n    class Token:\n        def __init__(self, value: str):\n            self.value = value\n\n    class LetterCount:\n        def __init__(self, letter: str, count: int):\n            self.letter = letter\n            self.count = count\n\n    class Parser:\n        @staticmethod\n        def parse(raw: str) -> List[Token]:\n            # Splits the raw string into tokens, handling multiple spaces.\n            tokens_str = raw.split()\n            return [Token(value) for value in tokens_str]\n\n    class Counter:\n        def __init__(self):\n            self._counts: Dict[str, int] = {}\n\n        def increment(self, token: Token):\n            # Increments count only for non-empty token values.\n            if token.value:\n                self._counts[token.value] = self._counts.get(token.value, 0) + 1\n\n        def get_counts(self) -> Dict[str, int]:\n            return self._counts\n\n    class MaxFinder:\n        @staticmethod\n        def find_max(counts: Dict[str, int]) -> int:\n            # Finds the maximum occurrence count among letters.\n            return max(counts.values())\n\n        @staticmethod\n        def find_max_letters(counts: Dict[str, int], max_val: int) -> List[LetterCount]:\n            # Collects all letters that match the maximum occurrence count.\n            max_letters = []\n            for letter, count in counts.items():\n                if count == max_val:\n                    max_letters.append(LetterCount(letter=letter, count=count))\n            return max_letters\n\n    class HistogramResult:\n        def __init__(self, result: Dict[str, int]):\n            self.result = result\n\n        def to_dict(self) -> Dict[str, int]:\n            return self.result\n\n    # Main orchestration logic for the histogram function\n    input_string = InputString(raw=test)\n\n    # Handle empty input string early, as per UC-04.\n    if input_string.isEmpty():\n        return {}\n\n    # Parse the input string into tokens, as per UC-02.\n    tokens = Parser.parse(input_string.raw)\n\n    # Count occurrences of each letter token, as per UC-03.\n    counter = Counter()\n    for token in tokens:\n        counter.increment(token)\n    counts = counter.get_counts()\n\n    # If no valid letters were counted (e.g., input was \" \" resulting in empty tokens), return an empty dict.\n    if not counts:\n        return {}\n\n    # Identify the maximum occurrence count, as per UC-05.\n    max_val = MaxFinder.find_max(counts)\n\n    # Find all letters with the maximum occurrence, as per UC-06 and UC-07.\n    max_letters_list = MaxFinder.find_max_letters(counts, max_val)\n\n    # Construct the final result dictionary using HistogramResult.\n    result_dict = {lc.letter: lc.count for lc in max_letters_list}\n    histogram_result = HistogramResult(result=result_dict)\n\n    return histogram_result.to_dict()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/110": [{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"In this problem, you will implement a function that takes two lists of numbers,\n    and determines whether it is possible to perform an exchange of elements\n    between them to make lst1 a list of only even numbers.\n    There is no limit on the number of exchanged elements between lst1 and lst2.\n    If it is possible to exchange elements between the lst1 and lst2 to make\n    all the elements of lst1 to be even, return \"YES\".\n    Otherwise, return \"NO\".\n    For example:\n    exchange([1, 2, 3, 4], [1, 2, 3, 4]) => \"YES\"\n    exchange([1, 2, 3, 4], [1, 5, 3, 4]) => \"NO\"\n    It is assumed that the input lists will be non-empty.\n    \"\"\"\n    from typing import List, Dict, Optional\n\n    class ParityChecker:\n        @staticmethod\n        def is_even(value: int) -> bool:\n            return value % 2 == 0\n\n    class Element:\n        def __init__(self, value: int) -> None:\n            self.value = value\n\n        def parity(self) -> str:\n            return 'even' if ParityChecker.is_even(self.value) else 'odd'\n\n    class ListModel:\n        def __init__(self, elements: List[Element]) -> None:\n            self.elements = elements\n\n        def length(self) -> int:\n            return len(self.elements)\n\n        @classmethod\n        def from_python_list(cls, values: List[int]) -> 'ListModel':\n            return cls([Element(v) for v in values])\n\n    class Multiset:\n        def __init__(self):\n            self.counts: Dict[int, int] = {}\n            self._total_evens_cache: Optional[int] = None\n\n        @classmethod\n        def from_lists(cls, lst1: ListModel, lst2: ListModel) -> 'Multiset':\n            multiset = cls()\n            for element in lst1.elements:\n                multiset.counts[element.value] = multiset.counts.get(element.value, 0) + 1\n            for element in lst2.elements:\n                multiset.counts[element.value] = multiset.counts.get(element.value, 0) + 1\n            return multiset\n\n        def total_evens(self) -> int:\n            if self._total_evens_cache is not None:\n                return self._total_evens_cache\n            \n            total = 0\n            for value, count in self.counts.items():\n                if ParityChecker.is_even(value):\n                    total += count\n            self._total_evens_cache = total\n            return total\n\n        def total_count(self) -> int:\n            return sum(self.counts.values())\n\n    class ExchangeFunction:\n        def __init__(self, parity_checker: ParityChecker = ParityChecker()) -> None:\n            self.parity_checker = parity_checker\n\n        def exchange(self, lst1: ListModel, lst2: ListModel) -> str:\n            combined_multiset = Multiset.from_lists(lst1, lst2)\n            total_even_elements = combined_multiset.total_evens()\n\n            if total_even_elements >= lst1.length():\n                return \"YES\"\n            else:\n                return \"NO\"\n\n    lst1_model: ListModel\n    lst2_model: ListModel\n\n    if not isinstance(lst1, ListModel):\n        lst1_model = ListModel.from_python_list(lst1)\n    else:\n        lst1_model = lst1\n    \n    if not isinstance(lst2, ListModel):\n        lst2_model = ListModel.from_python_list(lst2)\n    else:\n        lst2_model = lst2\n    \n    ef = ExchangeFunction()\n    return ef.exchange(lst1_model, lst2_model)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/120": [{"task_id": "HumanEval/120", "solution": "from typing import List\ndef _select_k_largest(arr, k) -> List[int]:\n    \"\"\"Selects the k largest elements from arr, preserving multiplicity.\"\"\"\n    if k == 0:\n        return []\n    \n    # Create a copy to avoid modifying the original array if it were mutable\n    # and not guaranteed to be a new list by standard practice.\n    # Sorting then taking the top k elements is a straightforward approach.\n    sorted_arr_desc = sorted(arr, reverse=True)\n    return sorted_arr_desc[:k]\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list \n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    _validate_inputs(arr, k)\n\n    if k == 0:\n        return []\n\n    selected_list = _select_k_largest(arr, k)\n    result = sorted(selected_list)\n    \n    return result", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[-3, -4, 5], 3]], "plus_fail_tests": [[[1, 2, 3, 4, 5], 3]]}], "HumanEval/121": [{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    \"\"\"\n    total = 0\n    for i in range(0, len(lst), 2):\n        if lst[i] % 2 != 0:\n            total += lst[i]\n    return total", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/116": [{"task_id": "HumanEval/116", "solution": "import functools\nclass BitCounter:\n    \"\"\"\n    Stateless service to compute number of '1' bits in binary representation of non-negative integers.\n    Treats 0 as having zero '1' bits.\n    \"\"\"\n    def countOnes(self, value: int) -> int:\n        return bin(value).count('1')\nclass IntegerElement:\n    \"\"\"\n    Represents a single integer and its metadata, including bitCount and negativity.\n    bitCount is meaningful for non-negative values; defaults to 0.\n    \"\"\"\n    def __init__(self, value: int):\n        self.value = value\n        self.isNegative = value < 0\n        self.bitCount = 0\n\n    def computeBitCount(self, bit_counter: 'BitCounter') -> None:\n        \"\"\"\n        Computes and sets the bitCount for non-negative integers using a BitCounter instance.\n        This method is not used for negative values as per design.\n        \"\"\"\n        if not self.isNegative:\n            self.bitCount = bit_counter.countOnes(self.value)\nclass InputArray:\n    \"\"\"\n    Represents the incoming array of integers.\n    Provides functionality to transform input values into IntegerElement instances.\n    \"\"\"\n    def __init__(self, values: list[int]):\n        self.values = values\n\n    def elements(self) -> list[IntegerElement]:\n        \"\"\"\n        Converts each integer in the input array into an IntegerElement instance.\n        \"\"\"\n        return [IntegerElement(value) for value in self.values]\nclass Sorter:\n    \"\"\"\n    Encapsulates the deterministic ordering logic for IntegerElement instances.\n    It sorts based on bitCount for non-negatives and decimal value for negatives.\n    \"\"\"\n    def sort(self, elements: list[IntegerElement]) -> list[int]:\n        \"\"\"\n        Sorts a list of IntegerElement instances according to defined rules.\n        Returns a list of the sorted integer values.\n        \"\"\"\n        sorted_elements = sorted(elements, key=functools.cmp_to_key(self._compare))\n        return [el.value for el in sorted_elements]\n\n    def _compare(self, a: IntegerElement, b: IntegerElement) -> int:\n        \"\"\"\n        Compares two IntegerElement instances to determine their relative order.\n        Non-negative integers are always placed before negative integers.\n        \"\"\"\n        # Rule chosen for mixed arrays: Non-negative integers always come before negative integers.\n        if a.isNegative and not b.isNegative:\n            return 1 # Non-negative 'b' comes before negative 'a'\n        if not a.isNegative and b.isNegative:\n            return -1 # Non-negative 'a' comes before negative 'b'\n\n        # Both negative: sort by ascending decimal value\n        if a.isNegative and b.isNegative:\n            return a.value - b.value\n\n        # Both non-negative:\n        # Primary key: bitCount ascending\n        if a.bitCount != b.bitCount:\n            return a.bitCount - b.bitCount\n        # Secondary key: decimal value ascending\n        return a.value - b.value\nclass OutputArray:\n    \"\"\"\n    A container for the final sorted list of integer values.\n    It wraps the list before returning it to the caller.\n    \"\"\"\n    def __init__(self, values: list[int]):\n        self.values = values\ndef sort_array(arr):\n    \"\"\"\n    Sorts an array of non-negative integers according to the number of ones in their\n    binary representation (ascending), then by decimal value if bit counts are equal.\n    Negative integers are sorted by ascending decimal value; non-negatives precede negatives.\n    \"\"\"\n    input_container = InputArray(arr)\n    elements = input_container.elements()\n\n    bit_counter = BitCounter()\n    for el in elements:\n        # Compute bitCount only for non-negative integers as per design.\n        el.computeBitCount(bit_counter)\n\n    sorter = Sorter()\n    # Sorter sorts the IntegerElement instances and returns their values as a list of ints.\n    sorted_values_list = sorter.sort(elements)\n\n    output_container = OutputArray(sorted_values_list)\n    return output_container.values", "base_status": "fail", "plus_status": "pass", "base_fail_tests": [[[-2, -3, -4, -5, -6]]], "plus_fail_tests": []}], "HumanEval/119": [{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if two given parenthesis strings can be concatenated to form a balanced string.\n    Raises ValueError for invalid input list structure or characters.\n    \"\"\"\n\n    class ParenthesisString:\n        \"\"\"Wraps a string and validates its characters.\"\"\"\n        def __init__(self, value: str):\n            if not isinstance(value, str):\n                raise ValueError(\"List elements must be strings.\")\n            self._value = value\n\n        def isValidChars(self) -> bool:\n            \"\"\"Returns True if the string contains only '(' and ')'.\"\"\"\n            return all(c in '()' for c in self._value)\n\n        def value(self) -> str:\n            \"\"\"Returns the raw string value.\"\"\"\n            return self._value\n\n    class Concatenation:\n        \"\"\"Concatenates two ParenthesisString objects.\"\"\"\n        def __init__(self, left: ParenthesisString, right: ParenthesisString):\n            self.left = left\n            self.right = right\n\n        def concat(self) -> str:\n            \"\"\"Returns the concatenated string.\"\"\"\n            return self.left.value() + self.right.value()\n\n    class Validator:\n        \"\"\"Evaluates if a string of parentheses is good (balanced).\"\"\"\n        @staticmethod\n        def isGood(s: str) -> bool:\n            \"\"\"Checks if a parenthesis string is balanced.\"\"\"\n            balance = 0\n            for char in s:\n                if char == '(':\n                    balance += 1\n                else:\n                    balance -= 1\n                if balance < 0:\n                    return False\n            return balance == 0\n\n    class Result:\n        \"\"\"Encapsulates the final 'Yes' or 'No' result.\"\"\"\n        def __init__(self, value: str):\n            self._value = value\n\n        def value(self) -> str:\n            \"\"\"Returns the result string.\"\"\"\n            return self._value\n\n    # Validate list length and type\n    if not isinstance(lst, list) or len(lst) != 2:\n        raise ValueError(\"Input must be a list of exactly two strings.\")\n\n    # Wrap strings and validate characters\n    ps1 = ParenthesisString(lst[0])\n    ps2 = ParenthesisString(lst[1])\n\n    if not ps1.isValidChars() or not ps2.isValidChars():\n        raise ValueError(\"Input strings must contain only '(' or ')' characters.\")\n\n    # Concatenate in both orders\n    candidate1_str = Concatenation(ps1, ps2).concat()\n    candidate2_str = Concatenation(ps2, ps1).concat()\n\n    # Validate candidates\n    if Validator.isGood(candidate1_str) or Validator.isGood(candidate2_str):\n        return Result('Yes').value()\n    else:\n        return Result('No').value()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/118": [{"task_id": "HumanEval/118", "solution": "VOWELS = {'a','e','i','o','u','A','E','I','O','U'}\nclass Result:\n    \"\"\"Result wrapper storing the return value string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\nclass Vowel:\n    \"\"\"Vowel helper class encapsulating vowel character attributes and boundary logic.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def isBoundary(self, pos: int, wordLength: int) -> bool:\n        \"\"\"Returns True if pos is at the beginning or end of the word.\"\"\"\n        return pos == 0 or pos == wordLength - 1\nclass Word:\n    \"\"\"Word domain class encapsulating the input word, character classification, and scanning logic.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def length(self) -> int:\n        return len(self.text)\n\n    def isVowelAt(self, pos: int) -> bool:\n        \"\"\"Checks if the character at the given position is a vowel.\"\"\"\n        if 0 <= pos < self.length():\n            return self.text[pos] in VOWELS\n        return False\n\n    def isConsonantAt(self, pos: int) -> bool:\n        \"\"\"Checks if the character at the given position is a consonant.\"\"\"\n        if 0 <= pos < self.length():\n            # Given input contains English letters only, a non-vowel is a consonant.\n            return self.text[pos] not in VOWELS\n        return False\n\n    def findClosestVowel(self) -> str:\n        \"\"\"Finds the closest vowel between two consonants from the right side.\"\"\"\n        if self.length() < 3:\n            return \"\"\n\n        # Scan from right to left, excluding the first and last characters (indices 0 and length-1)\n        # The range is from length-2 down to 1.\n        for pos in range(self.length() - 2, 0, -1):\n            char = self.text[pos]\n            if self.isVowelAt(pos):\n                v = Vowel(value=char)\n                # The isBoundary check will always be False for 'pos' in this range,\n                # but it's explicitly part of the design.\n                if not v.isBoundary(pos, self.length()):\n                    if self.isConsonantAt(pos - 1) and self.isConsonantAt(pos + 1):\n                        return char # Return the vowel character preserving its case\n        return \"\"\ndef get_closest_vowel(word):\n    \"\"\"You are given a word. Your task is to find the closest vowel that stands between \n    two consonants from the right side of the word (case sensitive).\n    \n    Vowels in the beginning and ending doesn't count. Return empty string if you didn't\n    find any vowel met the above condition. \n\n    You may assume that the given string contains English letter only.\n\n    Example:\n    get_closest_vowel(\"yogurt\") ==> \"u\"\n    get_closest_vowel(\"FULL\") ==> \"U\"\n    get_closest_vowel(\"quick\") ==> \"\"\n    get_closest_vowel(\"ab\") ==> \"\"\n    \"\"\"\n    word_obj = Word(word)\n    vowel_char = word_obj.findClosestVowel()\n    result_obj = Result(vowel_char)\n    return result_obj.value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/117": [{"task_id": "HumanEval/117", "solution": "from typing import List\nclass Word:\n    \"\"\"Transient holder for token text and computed consonantCount.\"\"\"\n    def __init__(self, text: str, consonantCount: int) -> None:\n        self.text = text\n        self.consonantCount = consonantCount\nclass ConsonantCounter:\n    \"\"\"Encapsulates vowel set and provides consonant counting logic.\"\"\"\n    def __init__(self) -> None:\n        self.vowelSet = {'a', 'e', 'i', 'o', 'u'}\n\n    def countConsonants(self, word: str) -> int:\n        count = 0\n        for char in word:\n            lower_char = char.lower()\n            if lower_char.isalpha() and lower_char not in self.vowelSet:\n                count += 1\n        return count\nclass ResultList:\n    \"\"\"Collects matching token strings.\"\"\"\n    def __init__(self) -> None:\n        self.words: List[str] = []\n\n    def append(self, word: str) -> None:\n        self.words.append(word)\n\n    def to_list(self) -> List[str]:\n        return self.words\nclass SelectWordsService:\n    \"\"\"Orchestrates tokenization, counting, and filtering words.\"\"\"\n    def __init__(self) -> None:\n        self.consonant_counter = ConsonantCounter()\n\n    def select_words(self, s: str, n: int) -> List[str]:\n        result_list = ResultList()\n\n        if not s:\n            return result_list.to_list()\n\n        # Tokenize the string by spaces, filtering out any empty tokens.\n        words_tokens = filter(None, s.split(' '))\n        \n        for word_text in words_tokens:\n            consonant_count = self.consonant_counter.countConsonants(word_text)\n            word_obj = Word(word_text, consonant_count) \n            \n            if word_obj.consonantCount == n:\n                result_list.append(word_obj.text)\n        \n        return result_list.to_list()\ndef select_words(s, n):\n    \"\"\"Given a string s and a natural number n, this function returns a list of words from s \n    that contain exactly n consonants, preserving order and original capitalization.\n    \"\"\"\n    service = SelectWordsService()\n    return service.select_words(s, n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/122": [{"task_id": "HumanEval/122", "solution": "class InputArray:\n    \"\"\"Represents an input array and validates its length.\"\"\"\n    def __init__(self, values):\n        self.values = values\n        self.length = len(values)\n\n    def validateLength(self):\n        \"\"\"Checks if the array length is within the valid range.\"\"\"\n        return 1 <= self.length <= 100\nclass ArrayElement:\n    \"\"\"Represents an integer element and provides digit-related predicates.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def digitCount(self):\n        \"\"\"Returns the number of digits in the absolute value of the element.\"\"\"\n        if self.value == 0:\n            return 1\n        return len(str(abs(self.value)))\n\n    def isAtMostTwoDigits(self):\n        \"\"\"Checks if the absolute value of the element has at most two digits.\"\"\"\n        return abs(self.value) <= 99\nclass Validator:\n    \"\"\"Enforces input constraints and provides error messages.\"\"\"\n    def __init__(self):\n        self._errorMessage = None\n\n    @property\n    def errorMessage(self):\n        \"\"\"The last validation error message.\"\"\"\n        return self._errorMessage\n\n    def _set_error(self, message):\n        \"\"\"Helper to set the internal error message.\"\"\"\n        self._errorMessage = message\n\n    def validateArray(self, arr):\n        \"\"\"Validates if arr is a list of integers with valid length.\"\"\"\n        if not isinstance(arr, (list, tuple)):\n            self._set_error(\"Input 'arr' must be a list or tuple.\")\n            return False\n\n        if not arr:\n            self._set_error(\"Input 'arr' cannot be empty.\")\n            return False\n\n        for item in arr:\n            if not isinstance(item, int):\n                self._set_error(\"All elements in 'arr' must be integers.\")\n                return False\n\n        input_arr = InputArray(arr)\n        if not input_arr.validateLength():\n            self._set_error(\"Length of 'arr' must be between 1 and 100, inclusive.\")\n            return False\n\n        return True\n\n    def validateK(self, k, arr):\n        \"\"\"Validates if k is an integer within array bounds.\"\"\"\n        if not isinstance(k, int):\n            self._set_error(\"Input 'k' must be an integer.\")\n            return False\n\n        if not (1 <= k <= len(arr)):\n            self._set_error(f\"Input 'k' must be between 1 and {len(arr)}, inclusive.\")\n            return False\n\n        return True\nclass SummationService:\n    \"\"\"Selects, filters, and sums elements from an array.\"\"\"\n    def computeSum(self, arr, k):\n        \"\"\"Computes the sum of elements with at most two digits from the first k elements.\"\"\"\n        total_sum = 0\n        for i in range(min(k, len(arr))):\n            element_value = arr[i]\n            array_element = ArrayElement(element_value)\n            if array_element.isAtMostTwoDigits():\n                total_sum += element_value\n        return total_sum\ndef add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    validator = Validator()\n\n    if not validator.validateArray(arr):\n        raise ValueError(validator.errorMessage)\n\n    if not validator.validateK(k, arr):\n        raise ValueError(validator.errorMessage)\n\n    sum_service = SummationService()\n    return sum_service.computeSum(arr, k)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/123": [{"task_id": "HumanEval/123", "solution": "from typing import List, Set\nclass Term:\n    \"\"\"Term value object representing a single term and providing helpers.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the term's value is odd.\"\"\"\n        return self.value % 2 != 0\n\n    def next(self) -> int:\n        \"\"\"Calculates the next term in the Collatz sequence.\"\"\"\n        if self.value % 2 == 0:\n            return self.value // 2\n        else:\n            return 3 * self.value + 1\nclass CollatzCalculator:\n    \"\"\"Generates the Collatz sequence from startN until the sequence reaches 1.\"\"\"\n    def __init__(self, startN: int):\n        self._start_n = startN\n\n    def generate_sequence(self) -> List[int]:\n        \"\"\"Produces the Collatz sequence starting at startN until 1.\"\"\"\n        sequence = []\n        current_term_value = self._start_n\n        while current_term_value != 1:\n            sequence.append(current_term_value)\n            term = Term(current_term_value)\n            current_term_value = term.next()\n        sequence.append(1) # Always include 1\n        return sequence\nclass InputValidator:\n    \"\"\"Validates caller-provided input n as a positive integer.\"\"\"\n    def validate(self, n) -> bool:\n        \"\"\"Returns True if n is an integer > 0, else False.\"\"\"\n        return isinstance(n, int) and n > 0\nclass OddCollector:\n    \"\"\"Collects odd integers encountered in sequence generation and provides sorted output.\"\"\"\n    def __init__(self):\n        self._odds: Set[int] = set()\n\n    def collect(self, value: int):\n        \"\"\"Collects unique odd integers, checking if they are odd.\"\"\"\n        term = Term(value)\n        if term.is_odd():\n            self._odds.add(value)\n\n    def get_sorted_odds(self) -> List[int]:\n        \"\"\"Returns collected unique odd integers as a sorted ascending list.\"\"\"\n        return sorted(list(self._odds))\nclass Result:\n    \"\"\"Simple wrapper to present the final odd numbers list to caller.\"\"\"\n    def __init__(self, odd_numbers: List[int]):\n        self._odd_numbers = odd_numbers\n\n    def as_list(self) -> List[int]:\n        \"\"\"Returns the wrapped list of odd numbers.\"\"\"\n        return self._odd_numbers\ndef get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n\n    The Collatz conjecture is a conjecture in mathematics that concerns a sequence defined\n    as follows: start with any positive integer n. Then each term is obtained from the \n    previous term as follows: if the previous term is even, the next term is one half of \n    the previous term. If the previous term is odd, the next term is 3 times the previous\n    term plus 1. The conjecture is that no matter what value of n, the sequence will always reach 1.\n\n    Note: \n        1. Collatz(1) is [1].\n        2. returned list sorted in increasing order.\n\n    For example:\n    get_odd_collatz(5) returns [1, 5] # The collatz sequence for 5 is [5, 16, 8, 4, 2, 1], so the odd numbers are only 1, and 5.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.validate(n):\n        raise ValueError(\"n must be a positive integer\")\n\n    collector = OddCollector()\n    calculator = CollatzCalculator(n)\n\n    sequence_values = calculator.generate_sequence()\n    for value in sequence_values:\n        collector.collect(value)\n    \n    sorted_odd_numbers = collector.get_sorted_odds()\n    return Result(sorted_odd_numbers).as_list()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/124": [{"task_id": "HumanEval/124", "solution": "_HYPHEN = '-'\n_MONTHS_31 = {1, 3, 5, 7, 8, 10, 12}\n_MONTHS_30 = {4, 6, 9, 11}\nclass DateString:\n    \"\"\"Represents the raw input string and provides an isEmpty test.\"\"\"\n    def __init__(self, raw: str) -> None:\n        self.raw = raw\n\n    def isEmpty(self) -> bool:\n        return not self.raw\nclass ParsedDate:\n    \"\"\"Value object with parsed numeric date components.\"\"\"\n    def __init__(self, month: int, day: int, year: int) -> None:\n        self.month = month\n        self.day = day\n        self.year = year\n\n    @staticmethod\n    def from_string(raw: str) -> 'ParsedDate' | None:\n        \"\"\"Splits and parses mm, dd, yyyy from a raw string; returns ParsedDate on success or None on parse failure.\"\"\"\n        parts = raw.split(_HYPHEN)\n        if len(parts) != 3:\n            return None\n        try:\n            month = int(parts[0])\n            day = int(parts[1])\n            year = int(parts[2])\n            return ParsedDate(month, day, year)\n        except ValueError:\n            return None\nclass ValidationResult:\n    \"\"\"Carries validation outcome and textual reason for diagnostics.\"\"\"\n    def __init__(self, isValid: bool, reason: str) -> None:\n        self.isValid = isValid\n        self.reason = reason\nclass Validator:\n    \"\"\"Encapsulates validation logic for date strings.\"\"\"\n    def validateFormat(self, raw: str) -> bool:\n        \"\"\"Checks if the string adheres to the mm-dd-yyyy positional pattern.\"\"\"\n        if len(raw) != 10:\n            return False\n        if raw[2] != _HYPHEN or raw[5] != _HYPHEN:\n            return False\n        \n        mm = raw[0:2]\n        dd = raw[3:5]\n        yyyy = raw[6:10]\n\n        return mm.isdigit() and dd.isdigit() and yyyy.isdigit()\n\n    def parse(self, raw: str) -> ParsedDate | None:\n        \"\"\"Attempts to parse components as base-10 integers; returns None on non-numeric parse failure.\"\"\"\n        return ParsedDate.from_string(raw)\n\n    def validateMonth(self, month: int) -> bool:\n        \"\"\"Returns True if the month is within the range 1 to 12.\"\"\"\n        return 1 <= month <= 12\n\n    def validateDay(self, month: int, day: int) -> bool:\n        \"\"\"Returns True if the day is within the allowed range for the given month.\"\"\"\n        if month in _MONTHS_31:\n            return 1 <= day <= 31\n        elif month in _MONTHS_30:\n            return 1 <= day <= 30\n        elif month == 2:\n            return 1 <= day <= 29\n        return False\n\n    def validate(self, raw: str) -> ValidationResult:\n        \"\"\"Runs the full validation flow and produces a ValidationResult.\"\"\"\n        date_string = DateString(raw)\n        if date_string.isEmpty():\n            return ValidationResult(False, 'empty input')\n\n        if not self.validateFormat(raw):\n            return ValidationResult(False, 'invalid format')\n\n        parsed_date = self.parse(raw)\n        if parsed_date is None:\n            return ValidationResult(False, 'non-numeric component')\n\n        if not self.validateMonth(parsed_date.month):\n            return ValidationResult(False, 'invalid month')\n\n        if not self.validateDay(parsed_date.month, parsed_date.day):\n            reason = 'invalid day for February' if parsed_date.month == 2 else 'invalid day for month'\n            return ValidationResult(False, reason)\n\n        return ValidationResult(True, '')\ndef valid_date(date: str) -> bool:\n    \"\"\"Validates a given date string and returns True if the date is valid, otherwise False.\"\"\"\n    validator = Validator()\n    result = validator.validate(date)\n    return result.isValid", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/125": [{"task_id": "HumanEval/125", "solution": "from typing import List, Union\nimport re\nclass Substring:\n    def __init__(self, value: str, start_index: int, end_index: int):\n        self.value = value\n        self.start_index = start_index\n        self.end_index = end_index\nclass Letter:\n    def __init__(self, ch: str):\n        self.ch = ch\n        self.is_lowercase = 'a' <= ch <= 'z'\n        # Calculate zero-based index only if it's a lowercase letter.\n        self.index_zero_based = ord(ch) - ord('a') if self.is_lowercase else -1\n\n    def is_odd_order(self) -> bool:\n        # Returns True if the letter is lowercase and its zero-based alphabet index is odd.\n        return self.is_lowercase and self.index_zero_based % 2 == 1\nclass TextInput:\n    def __init__(self, raw: str):\n        self.raw = raw\n\n    def contains_whitespace(self) -> bool:\n        return any(c.isspace() for c in self.raw)\n\n    def contains_comma(self) -> bool:\n        return ',' in self.raw\n\n    def lowercase_letters(self) -> List[str]:\n        # Returns a list of ASCII lowercase letters 'a' through 'z' found in the raw string.\n        return [c for c in self.raw if 'a' <= c <= 'z']\n\n    def split_on_whitespace(self) -> List[Substring]:\n        substrings = []\n        # Uses regex to find sequences of one or more non-whitespace characters.\n        # This naturally handles multiple spaces and leading/trailing spaces by not producing empty matches.\n        for match in re.finditer(r'\\S+', self.raw):\n            substrings.append(Substring(match.group(0), match.start(), match.end()))\n        return substrings\n\n    def split_on_comma(self) -> List[Substring]:\n        substrings = []\n        # Uses regex to find sequences of one or more non-comma characters.\n        # This filters out empty strings that would result from consecutive commas or leading/trailing commas.\n        for match in re.finditer(r'[^,]+', self.raw):\n            substrings.append(Substring(match.group(0), match.start(), match.end()))\n        return substrings\ndef split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3\n    '''\n    input_obj = TextInput(txt)\n\n    if input_obj.contains_whitespace():\n        substrings = input_obj.split_on_whitespace()\n        return [s.value for s in substrings]\n\n    if input_obj.contains_comma():\n        substrings = input_obj.split_on_comma()\n        return [s.value for s in substrings]\n\n    letters = input_obj.lowercase_letters()\n    count = 0\n    for ch in letters:\n        letter = Letter(ch)\n        if letter.is_odd_order():\n            count += 1\n    return count", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["as,words,,a"]]}], "HumanEval/128": [{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n\n    Example:\n    >>> prod_signs([1, 2, 2, -4]) == -9\n    >>> prod_signs([0, 1]) == 0\n    >>> prod_signs([]) == None\n    \"\"\"\n    if not arr:\n        return None\n\n    magnitude_sum = 0\n    sign_product = 1\n\n    for x in arr:\n        magnitude_sum += abs(x)\n\n        if x > 0:\n            current_sign = 1\n        elif x < 0:\n            current_sign = -1\n        else: # x == 0\n            current_sign = 0\n        \n        sign_product *= current_sign\n        \n        # Optimization: if a zero is encountered, the product of signs will be 0.\n        # The final result will then be 0 regardless of magnitude_sum.\n        if sign_product == 0:\n            break\n\n    return magnitude_sum * sign_product", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/127": [{"task_id": "HumanEval/127", "solution": "import math\nclass Interval:\n    \"\"\"Represents a closed integer interval.\"\"\"\n    def __init__(self, start: int, end: int) -> None:\n        self.start = start\n        self.end = end\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the interval's start is less than or equal to its end.\"\"\"\n        return self.start <= self.end\n\n    def length(self) -> int:\n        \"\"\"Calculates the length of the interval.\"\"\"\n        return self.end - self.start\nclass Intersection:\n    \"\"\"Represents the intersection of two intervals.\"\"\"\n    def __init__(self, start: int, end: int) -> None:\n        self.start = start\n        self.end = end\n\n    def exists(self) -> bool:\n        \"\"\"Checks if the intersection is valid (end >= start).\"\"\"\n        return self.end >= self.start\n\n    def length(self) -> int:\n        \"\"\"Calculates the length of the intersection.\"\"\"\n        return self.end - self.start\nclass IntersectionCalculator:\n    \"\"\"Computes the intersection of two Interval objects.\"\"\"\n    def compute(self, a: Interval, b: Interval) -> Intersection:\n        \"\"\"Calculates the intersection of two intervals.\"\"\"\n        max_start = max(a.start, b.start)\n        min_end = min(a.end, b.end)\n        return Intersection(max_start, min_end)\nclass PrimeChecker:\n    \"\"\"Determines if an integer is a prime number.\"\"\"\n    def is_prime(self, n: int) -> bool:\n        \"\"\"Checks if a given integer n is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        # Iterate only odd numbers up to the square root of n.\n        for i in range(3, int(math.isqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\ndef _to_interval(raw_interval) -> Interval:\n    \"\"\"Converts a raw interval tuple/list to an Interval object.\"\"\"\n    return Interval(int(raw_interval[0]), int(raw_interval[1]))\ndef intersection(interval1, interval2):\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two \n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n\n\n    [input/output] samples:\n    intersection((1, 2), (2, 3)) ==> \"NO\"\n    intersection((-1, 1), (0, 4)) ==> \"NO\"\n    intersection((-3, -1), (-5, 5)) ==> \"YES\"\n    \"\"\"\n    a = _to_interval(interval1)\n    b = _to_interval(interval2)\n\n    calc = IntersectionCalculator()\n    inter = calc.compute(a, b)\n\n    if not inter.exists():\n        return \"NO\"\n    \n    length = inter.length()\n    \n    prime_checker = PrimeChecker()\n    if prime_checker.is_prime(length):\n        return \"YES\"\n    \n    return \"NO\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/126": [{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n\n    Examples\n    is_sorted([5]) \u279e True\n    is_sorted([1, 2, 3, 4, 5]) \u279e True\n    is_sorted([1, 3, 2, 4, 5]) \u279e False\n    is_sorted([1, 2, 3, 4, 5, 6]) \u279e True\n    is_sorted([1, 2, 3, 4, 5, 6, 7]) \u279e True\n    is_sorted([1, 3, 2, 4, 5, 6, 7]) \u279e False\n    is_sorted([1, 2, 2, 3, 3, 4]) \u279e True\n    is_sorted([1, 2, 2, 2, 3, 4]) \u279e False\n    '''\n    # Imports for helper classes, defined inline as per instructions.\n    from typing import List\n    from dataclasses import dataclass\n    from collections import Counter\n\n    @dataclass\n    class InputList:\n        elements: List[int]\n\n        def length(self) -> int:\n            return len(self.elements)\n\n    class DuplicateRule:\n        maxAllowedDuplicates: int = 2\n\n        def violated(self, lst: InputList) -> bool:\n            \"\"\"\n            Returns True if any integer in lst.elements appears >= 3 times.\n            \"\"\"\n            counts = Counter(lst.elements)\n            for count in counts.values():\n                if count > self.maxAllowedDuplicates:\n                    return True\n            return False\n\n    class SortedOrder:\n        def isNonDecreasing(self, lst: InputList) -> bool:\n            \"\"\"\n            Returns True iff every element >= previous element.\n            Returns True for lists of length 0 or 1.\n            \"\"\"\n            n = lst.length()\n            if n <= 1:\n                return True\n            for i in range(1, n):\n                if lst.elements[i] < lst.elements[i-1]:\n                    return False\n            return True\n\n    # Main logic for the is_sorted function.\n    input_list = InputList(elements=lst)\n\n    # Handle single-element lists as True as per FR8.\n    if input_list.length() == 1:\n        return True\n    \n    # Check for duplicate rule violation as per FR7.\n    duplicate_checker = DuplicateRule()\n    if duplicate_checker.violated(input_list):\n        return False\n    \n    # Check for non-decreasing order as per FR6.\n    order_checker = SortedOrder()\n    if not order_checker.isNonDecreasing(input_list):\n        return False\n        \n    # If both conditions are met, return True as per FR5.\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/131": [{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    from typing import List\n\n    class Validator:\n        \"\"\"Validator for input predicates.\"\"\"\n        def isPositiveInteger(self, n) -> bool:\n            \"\"\"Checks if n is a positive integer.\"\"\"\n            return isinstance(n, int) and n > 0\n\n    class Digit:\n        \"\"\"Value object for a single digit occurrence.\"\"\"\n        def __init__(self, position: int, value: int):\n            self.position = position\n            self.value = value\n            self.is_odd = (value % 2 == 1)\n\n        def isOdd(self) -> bool:\n            \"\"\"Returns True if the digit's value is odd.\"\"\"\n            return self.is_odd\n\n    class InputNumber:\n        \"\"\"Represents the integer input and parsed Digit list.\"\"\"\n        def __init__(self, value: int):\n            self.value = value\n            self.digits: List[Digit] = []\n\n        def parseDigits(self) -> List[Digit]:\n            \"\"\"Splits value into base-10 digits and builds Digit instances.\"\"\"\n            s_value = str(self.value)\n            self.digits = []\n            for i, char_digit in enumerate(s_value):\n                position = i + 1 # 1-based index, most-significant first\n                digit_value = int(char_digit)\n                self.digits.append(Digit(position, digit_value))\n            return self.digits\n\n    class ProductResult:\n        \"\"\"Encapsulates computed product (or zero) and conversion to integer.\"\"\"\n        def __init__(self, value: int):\n            self.value = value\n\n        def toInteger(self) -> int:\n            \"\"\"Returns the encapsulated product as an integer.\"\"\"\n            return self.value\n\n    class DigitProcessor:\n        \"\"\"Computes the product of odd digits.\"\"\"\n        def computeProduct(self, digits_list: List[Digit]) -> ProductResult:\n            \"\"\"Multiplies values of odd digits; returns 0 if none are found.\"\"\"\n            product = 1\n            found_odd = False\n            for digit in digits_list:\n                if digit.isOdd():\n                    product *= digit.value\n                    found_odd = True\n            \n            if not found_odd:\n                return ProductResult(0)\n            else:\n                return ProductResult(product)\n\n    # Main logic of the digits function\n    \n    validator = Validator()\n    if not validator.isPositiveInteger(n):\n        raise ValueError(\"Input must be a positive integer (n > 0).\")\n\n    input_number = InputNumber(n)\n    parsed_digits = input_number.parseDigits()\n\n    digit_processor = DigitProcessor()\n    product_result = digit_processor.computeProduct(parsed_digits)\n\n    return product_result.toInteger()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/132": [{"task_id": "HumanEval/132", "solution": "import collections\ndef check_balanced(content: str) -> bool:\n    \"\"\"Checks if a string of brackets is balanced using a stack.\"\"\"\n    stack = []\n    for char in content:\n        if char == '[':\n            stack.append(char)\n        elif char == ']':\n            if not stack:\n                return False\n            stack.pop()\n    return not stack\ndef compute_max_depth(content: str) -> int:\n    \"\"\"Computes the maximum nesting depth of a bracket string.\"\"\"\n    max_depth = 0\n    current_depth = 0\n    for char in content:\n        if char == '[':\n            current_depth += 1\n            max_depth = max(max_depth, current_depth)\n        elif char == ']':\n            current_depth -= 1\n    return max_depth\nclass InputString:\n    \"\"\"Encapsulates input string content and provides character validation.\"\"\"\n    def __init__(self, content: str):\n        self.content = content\n        self.length = len(content)\n\n    def validateCharacters(self) -> bool:\n        \"\"\"Validates that the string contains only square bracket characters.\"\"\"\n        return all(char in ('[', ']') for char in self.content)\nclass Subsequence:\n    \"\"\"Represents an order-preserving subsequence of brackets.\"\"\"\n    def __init__(self, content: str):\n        self.content = content\n        self.length = len(content)\n\n    def isBalanced(self) -> bool:\n        \"\"\"Checks if the subsequence is a balanced bracket sequence.\"\"\"\n        return check_balanced(self.content)\n\n    def maxNestingDepth(self) -> int:\n        \"\"\"Computes the maximum nesting depth of the subsequence.\"\"\"\n        return compute_max_depth(self.content)\nclass SubsequenceGenerator:\n    \"\"\"Generates candidate subsequences, optimized for finding nested patterns.\"\"\"\n    def generate(self, input_string: InputString) -> collections.Iterator[Subsequence]:\n        # This optimized generator directly searches for the minimal subsequence `[[]]`\n        # that satisfies the depth >= 2 requirement.\n        # It avoids full enumeration as per design guidance for performance.\n        first_open_idx = -1\n        second_open_idx = -1\n        first_close_idx_after_second_open = -1\n        second_close_idx_after_first_close = -1\n\n        open_count = 0\n\n        for i, char in enumerate(input_string.content):\n            if char == '[':\n                if open_count == 0:\n                    first_open_idx = i\n                elif open_count == 1:\n                    second_open_idx = i\n                open_count += 1\n            elif char == ']':\n                # Check for two closing brackets only after two opening brackets are found\n                if second_open_idx != -1:\n                    if first_close_idx_after_second_open == -1 and i > second_open_idx:\n                        first_close_idx_after_second_open = i\n                    elif first_close_idx_after_second_open != -1 and i > first_close_idx_after_second_open:\n                        second_close_idx_after_first_close = i\n                        # If all four indices are found in correct order, yield '[[]]'\n                        yield Subsequence('[[]]')\n                        return # Only one such subsequence is needed for the condition to be true.\ndef exists_nested_subsequence(input_string: InputString) -> bool:\n    \"\"\"Determines if any subsequence has a nesting depth of at least 2.\"\"\"\n    generator = SubsequenceGenerator()\n    for subsequence_obj in generator.generate(input_string):\n        # The optimized generator only yields '[[]]' if found, or nothing.\n        # So, these checks will implicitly be true if a subsequence is yielded.\n        if subsequence_obj.isBalanced():\n            if subsequence_obj.maxNestingDepth() >= 2:\n                return True\n    return False\ndef is_nested(string):\n    \"\"\"\n    Checks if there is a valid subsequence of brackets with at least one nested bracket.\n    The input string must contain only square brackets.\n    \"\"\"\n    input_obj = InputString(string)\n    if not input_obj.validateCharacters():\n        raise ValueError(\"Input string must contain only '[' and ']' characters.\")\n\n    return exists_nested_subsequence(input_obj)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/133": [{"task_id": "HumanEval/133", "solution": "import math\nfrom typing import List\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    Examples:\n    For lst = [1,2,3] the output should be 14\n    For lst = [1,4,9] the output should be 98\n    For lst = [1,3,5,7] the output should be 84\n    For lst = [1.4,4.2,0] the output should be 29\n    For lst = [-2.4,1,1] the output should be 6\n    \"\"\"\n\n    class InputList:\n        \"\"\"Encapsulates input list of numeric values.\"\"\"\n        def __init__(self, numbers: List[float]) -> None:\n            self.numbers = numbers\n\n    class NumberElement:\n        \"\"\"Provides per-element behavior for ceiling and squaring.\"\"\"\n        def __init__(self, original_value: float) -> None:\n            self.original_value = original_value\n\n        def ceil(self) -> int:\n            \"\"\"Rounds the original value up to the nearest integer.\"\"\"\n            return math.ceil(self.original_value)\n\n        def square(self) -> int:\n            \"\"\"Squares the ceiling-rounded value.\"\"\"\n            return self.ceil() ** 2\n\n    class SumResult:\n        \"\"\"Container for the final integer sum result.\"\"\"\n        def __init__(self, value: int) -> None:\n            self.value = value\n\n    class SumSquaresFunction:\n        \"\"\"Orchestrates the pipeline: ceil -> square -> sum.\"\"\"\n        def execute(self, input_list: InputList) -> SumResult:\n            \"\"\"Processes the input list and returns the sum of squared ceilings.\"\"\"\n            total_sum = 0\n            for num in input_list.numbers:\n                element = NumberElement(num)\n                total_sum += element.square()\n            return SumResult(total_sum)\n\n    input_list = InputList(lst)\n    app_function = SumSquaresFunction()\n    result = app_function.execute(input_list)\n    return result.value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/134": [{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an alphabetical character\n    and is not a part of a word.\n    \"\"\"\n\n    class TextInput:\n        \"\"\"Encapsulates input string and provides character access.\"\"\"\n        def __init__(self, content: str):\n            self.content = content\n\n        def length(self) -> int:\n            return len(self.content)\n\n        def char_at(self, index: int) -> str:\n            return self.content[index]\n\n    class Character:\n        \"\"\"Represents a character and provides ASCII checks.\"\"\"\n        def __init__(self, value: str, index: int):\n            self.value = value\n            self.index = index\n\n        def is_alpha(self) -> bool:\n            # Checks if the character is an ASCII letter (A-Z or a-z).\n            return ('A' <= self.value <= 'Z') or ('a' <= self.value <= 'z')\n\n        def is_space(self) -> bool:\n            # Checks if the character is an ASCII space.\n            return self.value == ' '\n\n    class CheckResult:\n        \"\"\"Container for the boolean result.\"\"\"\n        def __init__(self, result: bool):\n            self.result = result\n\n    class LastCharChecker:\n        \"\"\"Implements business rules for last character check.\"\"\"\n        def check(self, txt: str) -> bool:\n            # If txt is empty, return False.\n            if not txt:\n                return CheckResult(False).result\n\n            text_input = TextInput(txt)\n            length = text_input.length()\n\n            # Get the last character\n            last_char_value = text_input.char_at(length - 1)\n            last_char = Character(last_char_value, length - 1)\n\n            # If last character is not ASCII alpha: return False.\n            if not last_char.is_alpha():\n                return CheckResult(False).result\n\n            # If last character is ASCII alpha and len(txt) == 1: return True.\n            if length == 1:\n                return CheckResult(True).result\n\n            # Check the preceding character if length > 1\n            preceding_char_value = text_input.char_at(length - 2)\n            preceding_char = Character(preceding_char_value, length - 2)\n\n            # If preceding character is ASCII space: return True.\n            if preceding_char.is_space():\n                return CheckResult(True).result\n\n            # Otherwise (last char is alpha but part of a multi-char word), return False.\n            return CheckResult(False).result\n\n    checker = LastCharChecker()\n    return checker.check(txt)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/135": [{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Create a function which returns the largest index of an element which\n    is not greater than or equal to the element immediately preceding it. If\n    no such element exists then return -1. The given array will not contain\n    duplicate values.\n\n    Examples:\n    can_arrange([1,2,4,3,5]) = 3\n    can_arrange([1,2,3]) = -1\n    \"\"\"\n    if len(arr) < 2:\n        return -1\n\n    largest_out_of_order_idx = -1\n\n    # Iterate from the second element to compare it with the one before it.\n    for i in range(1, len(arr)):\n        # If the current element is less than the preceding one, it breaks the non-decreasing order.\n        if arr[i] < arr[i-1]:\n            largest_out_of_order_idx = i\n\n    return largest_out_of_order_idx", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/136": [{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    \"\"\"\n    Finds the largest negative integer and the smallest positive integer in a list.\n    Returns (largest_negative, smallest_positive), using None if no such integers exist.\n    \"\"\"\n    largest_negative = None\n    smallest_positive = None\n\n    for num in lst:\n        if num < 0:\n            if largest_negative is None or num > largest_negative:\n                largest_negative = num\n        elif num > 0:\n            if smallest_positive is None or num < smallest_positive:\n                smallest_positive = num\n\n    return (largest_negative, smallest_positive)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/137": [{"task_id": "HumanEval/137", "solution": "class InputValue:\n    \"\"\"Encapsulates raw input and detects its type.\"\"\"\n    def __init__(self, raw_value):\n        self.raw_value = raw_value\n        if isinstance(raw_value, int):\n            self.input_type = 'int'\n        elif isinstance(raw_value, float):\n            self.input_type = 'float'\n        elif isinstance(raw_value, str):\n            self.input_type = 'string'\n\n    def isString(self):\n        \"\"\"Returns True if the raw_value is a string.\"\"\"\n        return self.input_type == 'string'\n\n    def to_parsed_number(self):\n        \"\"\"Converts the input value to a ParsedNumber instance.\"\"\"\n        return ParsedNumber(self)\nclass ParsedNumber:\n    \"\"\"Holds numeric value for comparison, original reference, and decimal separator metadata.\"\"\"\n    def __init__(self, input_value: InputValue):\n        self.original = input_value.raw_value\n        self.decimal_separator = None\n        self.numeric_value = 0.0\n\n        if input_value.input_type in ('int', 'float'):\n            self.numeric_value = float(self.original)\n        elif input_value.input_type == 'string':\n            s = self.original\n            dot_count = s.count('.')\n            comma_count = s.count(',')\n\n            if dot_count == 1 and comma_count == 0:\n                self.decimal_separator = '.'\n                self.numeric_value = float(s)\n            elif comma_count == 1 and dot_count == 0:\n                self.decimal_separator = ','\n                self.numeric_value = float(s.replace(',', '.'))\n            elif dot_count == 0 and comma_count == 0:\n                self.decimal_separator = None\n                self.numeric_value = float(s)\n            else:\n                # For ambiguous strings, behavior is unspecified; attempt direct float conversion.\n                self.decimal_separator = None\n                self.numeric_value = float(s)\nclass CompareOne:\n    \"\"\"Orchestrates parsing and comparison of two values.\"\"\"\n    def compare(self, a_raw, b_raw):\n        input_a = InputValue(a_raw)\n        input_b = InputValue(b_raw)\n\n        parsed_a = input_a.to_parsed_number()\n        parsed_b = input_b.to_parsed_number()\n\n        if parsed_a.numeric_value > parsed_b.numeric_value:\n            return parsed_a.original\n        elif parsed_b.numeric_value > parsed_a.numeric_value:\n            return parsed_b.original\n        else: # Equal\n            return None\ndef compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n    \"\"\"\n    comparer = CompareOne()\n    return comparer.compare(a, b)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/138": [{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers\n    Example\n    is_equal_to_sum_even(4) == False\n    is_equal_to_sum_even(6) == False\n    is_equal_to_sum_even(8) == True\n    \"\"\"\n    return n % 2 == 0 and n >= 8", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/140": [{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    result_parts = []\n    i = 0\n    n = len(text)\n\n    while i < n:\n        if text[i] == ' ':  # Check for ASCII space (U+0020)\n            space_count = 0\n            j = i\n            while j < n and text[j] == ' ':\n                space_count += 1\n                j += 1\n            \n            if space_count >= 3:\n                result_parts.append('-')\n            else:\n                result_parts.append('_' * space_count)\n            i = j  # Move pointer past the consecutive spaces\n        else:\n            result_parts.append(text[i])\n            i += 1\n            \n    return \"\".join(result_parts)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/144": [{"task_id": "HumanEval/144", "solution": "class Fraction:\n    def __init__(self, numerator: int, denominator: int, originalString: str):\n        self.numerator = numerator\n        self.denominator = denominator\n        self.originalString = originalString\n\n    @staticmethod\n    def fromString(s: str) -> 'Fraction':\n        \"\"\"Parses a fraction string into a Fraction object.\"\"\"\n        num_str, den_str = s.split('/')\n        return Fraction(int(num_str), int(den_str), s)\nclass Product:\n    def __init__(self, numerator: int, denominator: int):\n        self.numerator = numerator\n        self.denominator = denominator\nclass SimplifyService:\n    def simplify(self, x_str: str, n_str: str) -> bool:\n        \"\"\"Orchestrates parsing, multiplication, and whole-number check.\"\"\"\n        fraction_x = self.parseFraction(x_str)\n        fraction_n = self.parseFraction(n_str)\n        product = self.multiply(fraction_x, fraction_n)\n        return self.isWhole(product)\n\n    def parseFraction(self, s: str) -> Fraction:\n        \"\"\"Parses a fraction string into a Fraction object.\"\"\"\n        return Fraction.fromString(s)\n\n    def multiply(self, a: Fraction, b: Fraction) -> Product:\n        \"\"\"Multiplies two Fraction objects.\"\"\"\n        product_numerator = a.numerator * b.numerator\n        product_denominator = a.denominator * b.denominator\n        return Product(product_numerator, product_denominator)\n\n    def isWhole(self, p: Product) -> bool:\n        \"\"\"Checks if the Product represents a whole number.\"\"\"\n        return p.numerator % p.denominator == 0\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    service = SimplifyService()\n    return service.simplify(x, n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/145": [{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    Ties are resolved by preserving the original list's index.\n    \"\"\"\n\n    class IntegerElement:\n        def __init__(self, value: int, original_index: int):\n            self.value = value\n            self.original_index = original_index\n            self.digit_sum = 0 # This will be populated later by the calculator.\n\n    class InputList:\n        def __init__(self, nums: list):\n            self.elements = []\n            for i, num in enumerate(nums):\n                self.elements.append(IntegerElement(num, i))\n\n    class OutputList:\n        def __init__(self, elements: list):\n            self.values = [e.value for e in elements]\n\n    class DigitSumCalculator:\n        def calculate(self, value: int) -> int:\n            \"\"\"Calculates the sum of decimal digits of the absolute value.\"\"\"\n            return sum(int(digit) for digit in str(abs(value)))\n\n    class Sorter:\n        def sort_by_digit_sum(self, elements: list) -> list:\n            \"\"\"Performs stable ascending ordering by digit_sum, preserving original_index for ties.\"\"\"\n            return sorted(elements, key=lambda e: (e.digit_sum, e.original_index))\n\n    if not nums:\n        return []\n\n    input_list = InputList(nums)\n\n    calc = DigitSumCalculator()\n    for e in input_list.elements:\n        e.digit_sum = calc.calculate(e.value)\n\n    sorter = Sorter()\n    sorted_elements = sorter.sort_by_digit_sum(input_list.elements)\n\n    output = OutputList(sorted_elements)\n    return output.values", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 11, -1, -11, -12]]], "plus_fail_tests": [[[-5, -12, 9, 15]]]}], "HumanEval/143": [{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Returns a string containing words from the original sentence whose lengths are prime numbers.\n    The order of the words is preserved.\n    \"\"\"\n    def _is_prime(n):\n        \"\"\"Checks if a given integer n is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    words = sentence.split(' ')\n    prime_length_words = []\n\n    for word in words:\n        if _is_prime(len(word)):\n            prime_length_words.append(word)\n\n    return ' '.join(prime_length_words)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/146": [{"task_id": "HumanEval/146", "solution": "class DigitExtractor:\n    \"\"\"Provides methods to extract the first and last digits from a non-negative number.\"\"\"\n    def extractFirstDigit(self, absValue: 'Number'):\n        \"\"\"Extracts the first decimal digit from the absolute integer part of a number.\"\"\"\n        s = str(int(absValue))\n        return int(s[0])\n\n    def extractLastDigit(self, absValue: 'Number'):\n        \"\"\"Extracts the last decimal digit from the absolute integer part of a number.\"\"\"\n        s = str(int(absValue))\n        return int(s[-1])\nclass NumberValue:\n    \"\"\"Encapsulates a numeric value and provides methods to access its absolute value and digits.\"\"\"\n    def __init__(self, value):\n        self._value = value\n\n    def absValue(self):\n        \"\"\"Returns the absolute value of the encapsulated number.\"\"\"\n        return abs(self._value)\n\n    def firstDigit(self):\n        \"\"\"Returns the first decimal digit of the absolute value.\"\"\"\n        extractor = DigitExtractor()\n        return extractor.extractFirstDigit(self.absValue())\n\n    def lastDigit(self):\n        \"\"\"Returns the last decimal digit of the absolute value.\"\"\"\n        extractor = DigitExtractor()\n        return extractor.extractLastDigit(self.absValue())\nclass FilterCriteria:\n    \"\"\"Defines the criteria for filtering numbers based on value and digit properties.\"\"\"\n    def __init__(self):\n        self._minValue = 10\n        self._oddDigits = {1, 3, 5, 7, 9}\n\n    def matches(self, n: NumberValue):\n        \"\"\"Checks if a NumberValue object meets all filter conditions.\"\"\"\n        if n.absValue() <= self._minValue:\n            return False\n\n        first_digit = n.firstDigit()\n        last_digit = n.lastDigit()\n\n        return first_digit in self._oddDigits and last_digit in self._oddDigits\nclass SpecialFilterService:\n    \"\"\"Orchestrates the filtering process by iterating over numbers and applying criteria.\"\"\"\n    def __init__(self):\n        self._criteria = FilterCriteria()\n\n    def specialFilter(self, nums):\n        \"\"\"Processes the list of numbers and returns the count of matching elements.\"\"\"\n        count = 0\n        for v in nums:\n            nv = NumberValue(v)\n            if self._criteria.matches(nv):\n                count += 1\n        return count\ndef specialFilter(nums):\n    \"\"\"\n    Write a function that takes an array of numbers as input and returns \n    the number of elements in the array that are greater than 10 and both \n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    For example:\n    specialFilter([15, -73, 14, -15]) => 1 \n    specialFilter([33, -2, -3, 45, 21, 109]) => 2\n    \"\"\"\n    service = SpecialFilterService()\n    return service.specialFilter(nums)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[15, -73, 14, -15]]], "plus_fail_tests": [[[24, -25, 9, 37, -71, -18]]]}], "HumanEval/142": [{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n\n    class ListInput:\n        def __init__(self, values: list):\n            self.values: list[int] = values\n\n        def validate(self) -> bool:\n            # Validates that 'values' is a list and all its elements are integers.\n            if not isinstance(self.values, list):\n                return False\n            for item in self.values:\n                if not isinstance(item, int):\n                    return False\n            return True\n\n    class Element:\n        def __init__(self, index: int, originalValue: int):\n            self.index: int = index\n            self.originalValue: int = originalValue\n            self.transformedValue: int = originalValue\n\n    class TransformationRule:\n        # Encapsulates index-based predicates and applies numeric transformation to an Element.\n        def isMultipleOf3(self, idx: int) -> bool:\n            return idx % 3 == 0\n\n        def isMultipleOf4(self, idx: int) -> bool:\n            return idx % 4 == 0\n\n        def apply(self, elem: Element) -> None:\n            # Applies square if index is a multiple of 3, else cube if multiple of 4 and not 3.\n            if self.isMultipleOf3(elem.index):\n                elem.transformedValue = elem.originalValue ** 2\n            elif self.isMultipleOf4(elem.index):\n                elem.transformedValue = elem.originalValue ** 3\n            # Else, transformedValue remains originalValue.\n\n    class TransformationEngine:\n        def __init__(self, rules: list):\n            self.rules: list[TransformationRule] = rules\n\n        def transform(self, list_input: ListInput) -> list[Element]:\n            # Creates Element objects for each value, applies rules, and returns a list of transformed Elements.\n            transformed_elements = []\n            for index, original_value in enumerate(list_input.values):\n                element = Element(index, original_value)\n                # Assuming only one TransformationRule instance is passed in self.rules as per design context.\n                for rule in self.rules:\n                    rule.apply(element)\n                transformed_elements.append(element)\n            return transformed_elements\n\n    class Result:\n        def __init__(self):\n            self.sum: int = 0\n\n        def produce(self, elements: list[Element]) -> int:\n            # Computes the sum of transformed values from a list of Element objects.\n            self.sum = sum(elem.transformedValue for elem in elements)\n            return self.sum\n\n    # Orchestration logic for sum_squares function\n    list_input = ListInput(lst)\n    if not list_input.validate():\n        raise TypeError(\"Input 'lst' must be a list of integers.\")\n\n    engine = TransformationEngine(rules=[TransformationRule()])\n    elements = engine.transform(list_input)\n    \n    return Result().produce(elements)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/141": [{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions \n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from \n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n\n    class FileName:\n        \"\"\"Value object representing parsed filename parts and digit count.\"\"\"\n        def __init__(self, raw_file_name: str):\n            self.raw = raw_file_name\n            self.namePart = \"\"\n            self.extension = \"\"\n            # Compute digitCount across the entire raw string.\n            self.digitCount = sum(1 for char in raw_file_name if char.isdigit())\n\n            # Split the file name at the first dot.\n            # If no dot, parts will contain only the raw string.\n            # If one or more dots, it splits at the first occurrence.\n            parts = raw_file_name.split('.', 1)\n            if len(parts) == 2:\n                self.namePart = parts[0]\n                self.extension = parts[1]\n\n    class Validator:\n        \"\"\"Encapsulates validation logic, aggregates rules, and returns final 'Yes'/'No'.\"\"\"\n        def __init__(self):\n            self.allowed_extensions = {'txt', 'exe', 'dll'}\n\n        def hasSingleDot(self, s: str) -> bool:\n            \"\"\"Checks if the string contains exactly one dot.\"\"\"\n            return s.count('.') == 1\n\n        def nameStartsWithLetter(self, name_part: str) -> bool:\n            \"\"\"Checks if the name part is non-empty and starts with a letter.\"\"\"\n            return len(name_part) > 0 and name_part[0].isalpha()\n\n        def extensionAllowed(self, extension: str) -> bool:\n            \"\"\"Checks if the extension is one of the allowed types.\"\"\"\n            return extension in self.allowed_extensions\n\n        def validate(self, file_name_obj: FileName) -> str:\n            \"\"\"Applies all validation steps and returns 'Yes' if all pass, else 'No'.\"\"\"\n            # Condition 1: Not more than three digits.\n            if file_name_obj.digitCount > 3:\n                return 'No'\n\n            # Condition 2: The file's name contains exactly one dot.\n            if not self.hasSingleDot(file_name_obj.raw):\n                return 'No'\n            \n            # Condition 3: The substring before the dot should not be empty, and it starts with a letter.\n            if not self.nameStartsWithLetter(file_name_obj.namePart):\n                return 'No'\n\n            # Condition 4: The substring after the dot should be one of these: ['txt', 'exe', 'dll'].\n            if not self.extensionAllowed(file_name_obj.extension):\n                return 'No'\n\n            # All conditions met.\n            return 'Yes'\n\n    # Public entry point logic.\n    validator = Validator()\n    file_name_obj = FileName(file_name)\n    \n    return validator.validate(file_name_obj)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/147": [{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Counts triples (a[i], a[j], a[k]) where i < j < k and a[i] + a[j] + a[k] is a multiple of 3.\n    The values a[i] are calculated as i*i - i + 1.\n    \"\"\"\n\n    if n < 3:\n        return 0\n\n    def _combination3(x):\n        \"\"\"Calculates 'x choose 3' combinations, returning 0 if x < 3.\"\"\"\n        if x < 3:\n            return 0\n        return x * (x - 1) * (x - 2) // 6\n\n    # Based on the rule a[i] = i*i - i + 1:\n    # a[i] mod 3 = 0 if i mod 3 = 2\n    # a[i] mod 3 = 1 otherwise (if i mod 3 = 0 or i mod 3 = 1)\n\n    # count_mod0 is the number of a[i] values such that a[i] % 3 == 0.\n    # This happens when i % 3 == 2.\n    # For i = 1, ..., n, the indices where i % 3 == 2 are 2, 5, 8, ...\n    # This is equivalent to counting numbers of the form 3k - 1 (or 3k + 2) up to n.\n    # A simplified rule from the design context is: count_mod0 = (n + 1) // 3\n    count_mod0 = (n + 1) // 3\n\n    # count_mod1 is the number of a[i] values such that a[i] % 3 == 1.\n    # This is the remaining numbers: n - count_mod0.\n    count_mod1 = n - count_mod0\n\n    # A triple (a[i], a[j], a[k]) sums to a multiple of 3 if:\n    # (a[i]%3 + a[j]%3 + a[k]%3) % 3 == 0\n    # This condition is met if all three are 0 mod 3, OR all three are 1 mod 3.\n    # (0 + 0 + 0) % 3 == 0\n    # (1 + 1 + 1) % 3 == 0\n    # Other combinations (e.g., 0+0+1, 0+1+1) are not multiples of 3.\n\n    # So, we need to count combinations of 3 elements from count_mod0 group\n    # plus combinations of 3 elements from count_mod1 group.\n    return _combination3(count_mod0) + _combination3(count_mod1)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/149": [{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Write a function that accepts a list of strings as a parameter,\n    deletes the strings that have odd lengths from it,\n    and returns the resulted list with a sorted order,\n    The list is always a list of strings and never an array of numbers,\n    and it may contain duplicates.\n    The order of the list should be ascending by length of each word, and you\n    should return the list sorted by that rule.\n    If two words have the same length, sort the list alphabetically.\n    The function should return a list of strings in sorted order.\n    You may assume that all words will have the same length.\n    For example:\n    assert list_sort([\"aa\", \"a\", \"aaa\"]) => [\"aa\"]\n    assert list_sort([\"ab\", \"a\", \"aaa\", \"cd\"]) => [\"ab\", \"cd\"]\n    \"\"\"\n    \n    even_length_strings = []\n    for s in lst:\n        if len(s) % 2 == 0:\n            even_length_strings.append(s)\n            \n    # Sort by length first, then alphabetically for ties.\n    even_length_strings.sort(key=lambda s: (len(s), s))\n    \n    return even_length_strings", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/150": [{"task_id": "HumanEval/150", "solution": "import math\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n    \n    \"\"\"\n    def is_prime(num):\n        \"\"\"Checks if a number is prime by testing divisibility up to its square root.\n        Numbers less than or equal to 1 are not considered prime.\n        \"\"\"\n        if num <= 1:\n            return False\n        for i in range(2, int(math.isqrt(num)) + 1):\n            if num % i == 0:\n                return False\n        return True\n\n    if is_prime(n):\n        return x\n    else:\n        return y", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/152": [{"task_id": "HumanEval/152", "solution": "from typing import List\ndef compare(game: List[int], guess: List[int]) -> List[int]:\n    \"\"\"I think we all remember that feeling when the result of some long-awaited\n    event is finally known. The feelings and thoughts you have at that moment are\n    definitely worth noting down and comparing.\n    Your task is to determine if a person correctly guessed the results of a number of matches.\n    You are given two arrays of scores and guesses of equal length, where each index shows a match. \n    Return an array of the same length denoting how far off each guess was. If they have guessed correctly,\n    the value is 0, and if not, the value is the absolute difference between the guess and the score.\n    \n    \n    example:\n\n    compare([1,2,3,4,5,1],[1,2,3,4,2,-2]) -> [0,0,0,0,3,3]\n    compare([0,5,0,0,0,4],[4,1,1,0,0,-2]) -> [4,4,1,0,0,6]\n    \"\"\"\n    if len(game) != len(guess):\n        raise ValueError(\"game and guess must have equal length\")\n\n    results = []\n    for game_score, guess_score in zip(game, guess):\n        if game_score == guess_score:\n            results.append(0)\n        else:\n            results.append(abs(game_score - guess_score))\n            \n    return results", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/148": [{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    class Planet:\n        def __init__(self, name: str, order_from_sun: int):\n            self.name = name\n            self.order_from_sun = order_from_sun\n\n    class PlanetRepository:\n        def __init__(self):\n            self._planets = [\n                Planet(\"Mercury\", 1),\n                Planet(\"Venus\", 2),\n                Planet(\"Earth\", 3),\n                Planet(\"Mars\", 4),\n                Planet(\"Jupiter\", 5),\n                Planet(\"Saturn\", 6),\n                Planet(\"Uranus\", 7),\n                Planet(\"Neptune\", 8),\n            ]\n            self._name_index = {planet.name: planet for planet in self._planets}\n\n        def get_planet_by_name(self, name: str) -> 'Planet | None':\n            return self._name_index.get(name)\n\n        def is_valid_planet(self, name: str) -> bool:\n            return name in self._name_index\n\n        def get_planets_between(self, name1: str, name2: str) -> list[Planet]:\n            planet_obj1 = self.get_planet_by_name(name1)\n            planet_obj2 = self.get_planet_by_name(name2)\n\n            if not planet_obj1 or not planet_obj2:\n                return []\n\n            order1 = planet_obj1.order_from_sun\n            order2 = planet_obj2.order_from_sun\n\n            min_order = min(order1, order2)\n            max_order = max(order1, order2)\n\n            result = []\n            for planet in self._planets:\n                if min_order < planet.order_from_sun < max_order:\n                    result.append(planet)\n            return result\n\n    class Validator:\n        def __init__(self, repo: PlanetRepository):\n            self._repo = repo\n\n        def is_valid(self, name: str) -> bool:\n            return self._repo.is_valid_planet(name)\n\n    repo = PlanetRepository()\n    validator = Validator(repo)\n\n    if not validator.is_valid(planet1) or not validator.is_valid(planet2):\n        return tuple()\n\n    planets_between = repo.get_planets_between(planet1, planet2)\n\n    if not planets_between:\n        return tuple()\n\n    return tuple(p.name for p in planets_between)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/151": [{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    '''\n    from typing import List\n\n    class NumberItem:\n        \"\"\"Represents a numeric item with validation predicates.\"\"\"\n        def __init__(self, value):\n            self.value = float(value)\n\n        def isInteger(self) -> bool:\n            \"\"\"Checks if the numeric value has a zero fractional part.\"\"\"\n            return self.value.is_integer()\n\n        def isNegative(self) -> bool:\n            \"\"\"Checks if the numeric value is negative.\"\"\"\n            return self.value < 0\n\n        def isOdd(self) -> bool:\n            \"\"\"Checks if the numeric value is an odd integer.\"\"\"\n            return self.isInteger() and (int(self.value) % 2) != 0\n\n    class InputList:\n        \"\"\"A wrapper for a list of NumberItem objects.\"\"\"\n        def __init__(self, values: list):\n            self.items: List[NumberItem] = [NumberItem(v) for v in values]\n\n        def isEmpty(self) -> bool:\n            \"\"\"Checks if the list is empty.\"\"\"\n            return len(self.items) == 0\n\n        def add(self, item: NumberItem) -> None:\n            \"\"\"Adds a NumberItem to the list.\"\"\"\n            self.items.append(item)\n\n        def count(self) -> int:\n            \"\"\"Returns the number of items in the list.\"\"\"\n            return len(self.items)\n\n    class Validator:\n        \"\"\"Handles filtering and validation of NumberItem objects.\"\"\"\n        def filterNonNegativeIntegers(self, items: List[NumberItem]) -> List[NumberItem]:\n            \"\"\"Filters a list of NumberItem to include only non-negative integers.\"\"\"\n            return [item for item in items if self.isValid(item)]\n\n        def isValid(self, item: NumberItem) -> bool:\n            \"\"\"Checks if a NumberItem is a non-negative integer.\"\"\"\n            return not item.isNegative() and item.isInteger()\n\n    class Calculator:\n        \"\"\"Performs squaring and summation operations on numbers.\"\"\"\n        def square(self, n: int) -> int:\n            \"\"\"Returns the square of an integer.\"\"\"\n            return n * n\n\n        def sumOfSquares(self, items: List[NumberItem]) -> int:\n            \"\"\"Returns the sum of squares for a provided list of NumberItem objects.\"\"\"\n            total_sum = 0\n            for item in items:\n                total_sum += self.square(int(item.value))\n            return total_sum\n\n        def compute(self, items: List[NumberItem]) -> int:\n            \"\"\"Filters for odd integers, squares them, and returns their sum.\"\"\"\n            odd_items: List[NumberItem] = [item for item in items if item.isOdd()]\n            return self.sumOfSquares(odd_items)\n\n    class Result:\n        \"\"\"A simple container for the final integer total.\"\"\"\n        def __init__(self, total: int):\n            self.total = total\n\n        def isZero(self) -> bool:\n            \"\"\"Checks if the total is zero.\"\"\"\n            return self.total == 0\n\n    input_list = InputList(lst)\n    validator = Validator()\n    filtered_items = validator.filterNonNegativeIntegers(input_list.items)\n    calculator = Calculator()\n    total = calculator.compute(filtered_items)\n    \n    # The Result class is designed as a wrapper, but the function requires an int return.\n    # result_obj = Result(total)\n    return int(total)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1.0, 3.5, -4.6]]]}], "HumanEval/153": [{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Calculates the strongest extension based on CAP - SM strength and returns a formatted string.\n    The strongest is chosen by highest strength, with ties broken by the earliest appearance in the list.\"\"\"\n\n    def _is_alpha_letter(ch: str) -> bool:\n        \"\"\"Checks if a character is an ASCII alphabetic letter (A-Z or a-z).\"\"\"\n        return ('a' <= ch <= 'z') or ('A' <= ch <= 'Z')\n\n    class ClassName:\n        \"\"\"Represents the provided class name input.\"\"\"\n        def __init__(self, name: str):\n            self.name = name\n\n    class Extension:\n        \"\"\"Represents an extension, storing its name and computed strength metrics.\"\"\"\n        def __init__(self, name: str):\n            self.name = name\n            self.CAP = 0\n            self.SM = 0\n            self.strength = 0\n\n    class StrengthCalculator:\n        \"\"\"Handles counting uppercase/lowercase letters and calculating extension strength.\"\"\"\n        def computeCounts(self, ext: Extension) -> None:\n            \"\"\"Scans the extension name to count CAP (uppercase) and SM (lowercase) letters.\"\"\"\n            cap_count = 0\n            sm_count = 0\n            for ch in ext.name:\n                if _is_alpha_letter(ch):\n                    if ch.isupper():\n                        cap_count += 1\n                    elif ch.islower():\n                        sm_count += 1\n            ext.CAP = cap_count\n            ext.SM = sm_count\n\n        def computeStrength(self, ext: Extension) -> None:\n            \"\"\"Calculates and assigns the strength (CAP - SM) to the extension.\"\"\"\n            ext.strength = ext.CAP - ext.SM\n\n    class ExtensionList:\n        \"\"\"Manages a collection of Extension objects and determines the strongest among them.\"\"\"\n        def __init__(self, extensions: list[Extension]):\n            self.extensions = extensions\n\n        def getStrongest(self) -> Extension:\n            \"\"\"Identifies the extension with the highest strength, breaking ties by earliest index.\"\"\"\n            # Per design, empty list scenarios are out of scope, so self.extensions[0] is safe.\n            strongest_ext = self.extensions[0] \n            for ext in self.extensions[1:]:\n                if ext.strength > strongest_ext.strength:\n                    strongest_ext = ext\n            return strongest_ext\n\n    class ResultFormatter:\n        \"\"\"Formats the final output string as 'ClassName.ExtensionName'.\"\"\"\n        def format(self, className: ClassName, ext: Extension) -> str:\n            \"\"\"Constructs the result string from the class name and strongest extension name.\"\"\"\n            return f\"{className.name}.{ext.name}\"\n\n    # Orchestration logic\n    class_obj = ClassName(class_name)\n    ext_objs = [Extension(name) for name in extensions]\n    ext_list = ExtensionList(ext_objs)\n    calc = StrengthCalculator()\n\n    for ext in ext_list.extensions:\n        calc.computeCounts(ext)\n        calc.computeStrength(ext)\n\n    selected = ext_list.getStrongest()\n    formatter = ResultFormatter()\n    return formatter.format(class_obj, selected)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/154": [{"task_id": "HumanEval/154", "solution": "from typing import Optional\nclass Rotation:\n    \"\"\"Represents a cyclic rotation of a string along with its original rotation index.\"\"\"\n    def __init__(self, value: str, index: int) -> None:\n        self.value = value\n        self.index = index\ndef _left_rotate(s: str, k: int) -> str:\n    \"\"\"Performs a left rotation on a string by k positions.\"\"\"\n    if not s:\n        return \"\"\n    k = k % len(s)\n    return s[k:] + s[:k]\nclass RotationGenerator:\n    \"\"\"Generates unique cyclic left-rotations of a given string.\"\"\"\n    def generateAll(self, s: str) -> list[Rotation]:\n        \"\"\"Returns a list of unique Rotation objects for all possible left-rotations of the string s.\"\"\"\n        if not s:\n            return [Rotation(\"\", 0)]\n\n        rotations = []\n        seen_values = set()\n        for i in range(len(s)):\n            rotated_s = _left_rotate(s, i)\n            if rotated_s not in seen_values:\n                rotations.append(Rotation(rotated_s, i))\n                seen_values.add(rotated_s)\n        return rotations\nclass SubstringMatcher:\n    \"\"\"Provides functionality to perform exact substring membership checks.\"\"\"\n    def isSubstring(self, container: str, candidate: str) -> bool:\n        \"\"\"Checks if a candidate string is an exact substring of the container string.\"\"\"\n        return candidate in container\nclass CycpatternService:\n    \"\"\"Orchestrates the process of checking for a pattern or its rotations within another string.\"\"\"\n    def __init__(self, rotation_generator: RotationGenerator = None, substring_matcher: SubstringMatcher = None) -> None:\n        self.rotation_generator = rotation_generator if rotation_generator is not None else RotationGenerator()\n        self.substring_matcher = substring_matcher if substring_matcher is not None else SubstringMatcher()\n\n    def cycpattern_check(self, a: str, b: str) -> bool:\n        \"\"\"Determines if string b or any of its cyclic rotations is a substring of string a.\"\"\"\n        if len(b) > len(a):\n            return False\n\n        if self.substring_matcher.isSubstring(a, b):\n            return True\n\n        rotations = self.rotation_generator.generateAll(b)\n        for rotation in rotations:\n            if self.substring_matcher.isSubstring(a, rotation.value):\n                return True\n\n        return False\ndef cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    service = CycpatternService()\n    return service.cycpattern_check(a, b)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/155": [{"task_id": "HumanEval/155", "solution": "from typing import List, Tuple\nclass NumberInput:\n    \"\"\"Wraps input value and provides absolute value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def get_absolute(self) -> int:\n        \"\"\"Returns the absolute value of the wrapped number.\"\"\"\n        return abs(self.value)\nclass Digit:\n    \"\"\"Value object for a single decimal digit.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_even(self) -> bool:\n        \"\"\"Determines if the digit is even (0 is even).\"\"\"\n        return self.value % 2 == 0\nclass DigitExtractor:\n    \"\"\"Stateless helper to extract digits from a non-negative integer.\"\"\"\n    def extract_digits(self, n: int) -> List[Digit]:\n        \"\"\"Converts an integer to a list of Digit objects.\"\"\"\n        if n == 0:\n            return [Digit(0)]\n        \n        digits_list = []\n        # Convert to string to easily iterate over digits, handling large integers.\n        for char_digit in str(n):\n            digits_list.append(Digit(int(char_digit)))\n        return digits_list\nclass Result:\n    \"\"\"Immutable container for even and odd digit counts.\"\"\"\n    def __init__(self, even_count: int, odd_count: int) -> None:\n        self.even_count = even_count\n        self.odd_count = odd_count\n\n    def to_tuple(self) -> Tuple[int, int]:\n        \"\"\"Returns the counts as a tuple (even_count, odd_count).\"\"\"\n        return (self.even_count, self.odd_count)\nclass DigitCounter:\n    \"\"\"Accumulates even and odd counts from a sequence of Digit objects.\"\"\"\n    def __init__(self) -> None:\n        self.even_count = 0\n        self.odd_count = 0\n\n    def count(self, digits: List[Digit]) -> Result:\n        \"\"\"Processes a list of Digit objects to count even and odd digits.\"\"\"\n        for digit_obj in digits:\n            if digit_obj.is_even():\n                self.even_count += 1\n            else:\n                self.odd_count += 1\n        return Result(self.even_count, self.odd_count)\ndef even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    if not isinstance(num, int) or isinstance(num, bool):\n        raise TypeError('num must be int')\n\n    num_input = NumberInput(value=num)\n    n = num_input.get_absolute()\n\n    if n == 0:\n        return (1, 0)\n\n    digits = DigitExtractor().extract_digits(n)\n    result = DigitCounter().count(digits)\n    return result.to_tuple()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/156": [{"task_id": "HumanEval/156", "solution": "class IntegerInput:\n    \"\"\"Encapsulates and validates the input integer value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_positive(self) -> bool:\n        \"\"\"Checks if the encapsulated integer value is positive.\"\"\"\n        return self.value > 0\n\n    def in_range(self, min_val: int, max_val: int) -> bool:\n        \"\"\"Checks if the encapsulated integer value is within a specified range.\"\"\"\n        return min_val <= self.value <= max_val\nclass RomanNumeral:\n    \"\"\"Represents a Roman numeral and provides lowercase ASCII output.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def as_lowercase(self) -> str:\n        \"\"\"Returns the Roman numeral value converted to lowercase.\"\"\"\n        return self.value.lower()\nclass Converter:\n    \"\"\"Validates input and converts an integer into a Roman numeral string.\"\"\"\n    _mapping = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'), (100, 'C'),\n        (90, 'XC'), (50, 'L'), (40, 'XL'), (10, 'X'), (9, 'IX'),\n        (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n\n    def int_to_mini_roman(self, number: int) -> str:\n        \"\"\"Converts the given integer to a Roman numeral string using the internal mapping.\"\"\"\n        roman_numeral_parts = []\n        current_num = number\n\n        for value, symbol in self._mapping:\n            while current_num >= value:\n                roman_numeral_parts.append(symbol)\n                current_num -= value\n        \n        roman_obj = RomanNumeral(\"\".join(roman_numeral_parts))\n        return roman_obj.as_lowercase()\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    # Per design, IntegerInput is instantiated but validation methods are not used to raise exceptions.\n    input_obj = IntegerInput(number) \n    \n    # Initialize the Converter and delegate the conversion.\n    converter = Converter()\n    return converter.int_to_mini_roman(input_obj.value)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/158": [{"task_id": "HumanEval/158", "solution": "from typing import List\nclass Word:\n    \"\"\"Represents a word and its unique character count.\"\"\"\n    def __init__(self, text: str) -> None:\n        self.text = text\n        self.uniqueCharCount = len(set(text))\nclass WordList:\n    \"\"\"Container for Word objects, preserving input order.\"\"\"\n    def __init__(self, texts: List[str]) -> None:\n        self.words = [Word(text) for text in texts]\n\n    def size(self) -> int:\n        return len(self.words)\nclass Finder:\n    \"\"\"Encapsulates the algorithm to find the word with maximum unique characters, tie-breaking lexicographically.\"\"\"\n    def find_max(self, word_list: WordList) -> Word:\n        if not word_list.words:\n            return None\n\n        max_word = word_list.words[0]\n        for current_word in word_list.words[1:]:\n            if current_word.uniqueCharCount > max_word.uniqueCharCount:\n                max_word = current_word\n            elif current_word.uniqueCharCount == max_word.uniqueCharCount:\n                if current_word.text < max_word.text:\n                    max_word = current_word\n        return max_word\ndef find_max(words: List[str]) -> str:\n    \"\"\"\n    Returns the word with the maximum number of unique characters.\n    If multiple strings have the maximum number of unique characters,\n    return the one which comes first in lexicographical order.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    word_list = WordList(words)\n    finder = Finder()\n    selected_word = finder.find_max(word_list)\n\n    return selected_word.text", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/157": [{"task_id": "HumanEval/157", "solution": "import math\nclass NumericValidator:\n    \"\"\"Provides methods for validating numeric properties.\"\"\"\n    def is_finite(self, x: float) -> bool:\n        \"\"\"Returns True if x is a finite number.\"\"\"\n        return math.isfinite(x)\n\n    def is_positive(self, x: float) -> bool:\n        \"\"\"Returns True if x is strictly greater than 0.\"\"\"\n        return x > 0\nclass PythagoreanEvaluator:\n    \"\"\"Evaluates the Pythagorean theorem for three sides.\"\"\"\n    def is_right_angle(self, a: float, b: float, c: float, tol: float) -> bool:\n        \"\"\"Checks if a^2 + b^2 = c^2 within a given tolerance.\"\"\"\n        return abs(a*a + b*b - c*c) <= tol\nclass Triangle:\n    \"\"\"Represents a triangle with three side lengths.\"\"\"\n    def __init__(self, a: float, b: float, c: float):\n        \"\"\"Initializes the triangle with side lengths and internal state.\"\"\"\n        self.a = float(a)\n        self.b = float(b)\n        self.c = float(c)\n        self.is_valid = False\n        self.is_degenerate = False\n        self.is_right_angle = False\n\n    def validate(self) -> bool:\n        \"\"\"Validates if side lengths are finite and positive.\"\"\"\n        validator = NumericValidator()\n        self.is_valid = (validator.is_finite(self.a) and validator.is_positive(self.a) and\n                         validator.is_finite(self.b) and validator.is_positive(self.b) and\n                         validator.is_finite(self.c) and validator.is_positive(self.c))\n        return self.is_valid\n\n    def check_triangle_inequality(self) -> bool:\n        \"\"\"Checks if the side lengths form a valid non-degenerate triangle.\"\"\"\n        if not (self.a < self.b + self.c and\n                self.b < self.a + self.c and\n                self.c < self.a + self.b):\n            self.is_degenerate = True\n            return False\n        return True\n\n    def evaluate_pythagorean(self, tol: float) -> bool:\n        \"\"\"Determines if the triangle is right-angled by checking Pythagorean theorem permutations.\"\"\"\n        evaluator = PythagoreanEvaluator()\n        \n        if evaluator.is_right_angle(self.a, self.b, self.c, tol) or \\\n           evaluator.is_right_angle(self.b, self.c, self.a, tol) or \\\n           evaluator.is_right_angle(self.c, self.a, self.b, tol):\n            self.is_right_angle = True\n            return True\n        \n        return False\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    \n    TOL = 1e-9\n\n    numeric_validator = NumericValidator()\n\n    if not (numeric_validator.is_finite(a) and numeric_validator.is_positive(a) and\n            numeric_validator.is_finite(b) and numeric_validator.is_positive(b) and\n            numeric_validator.is_finite(c) and numeric_validator.is_positive(c)):\n        return False\n\n    triangle = Triangle(a, b, c)\n\n    if not triangle.check_triangle_inequality():\n        return False\n\n    return triangle.evaluate_pythagorean(TOL)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/159": [{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n    \"\"\"\n\n    # Define inline models as per design\n    class Input:\n        def __init__(self, number_val: int, need_val: int, remaining_val: int):\n            self.number = number_val\n            self.need = need_val\n            self.remaining = remaining_val\n\n    class MealResult:\n        def __init__(self, total_eaten_val: int, remaining_after_val: int):\n            self.total_eaten = total_eaten_val\n            self.remaining_after = remaining_after_val\n\n    class CarrotStock:\n        def __init__(self, remaining_val: int):\n            self.remaining = remaining_val\n        def deplete(self, amount: int) -> None:\n            self.remaining = max(0, self.remaining - amount)\n\n    # Define inline services as per design\n    class Validator:\n        def validateType(self, input_obj: 'Input') -> bool:\n            return (isinstance(input_obj.number, int) and\n                    isinstance(input_obj.need, int) and\n                    isinstance(input_obj.remaining, int))\n\n        def validateRange(self, input_obj: 'Input') -> bool:\n            return (0 <= input_obj.number <= 1000 and\n                    0 <= input_obj.need <= 1000 and\n                    0 <= input_obj.remaining <= 1000)\n\n    class CarrotCalculator:\n        def computeCarrotsEaten(self, need_val: int, remaining_val: int) -> int:\n            return min(need_val, remaining_val)\n\n        def computeTotals(self, number_val: int, carrots_eaten_val: int, initial_remaining_val: int) -> 'MealResult':\n            total_eaten = number_val + carrots_eaten_val\n            remaining_after = initial_remaining_val - carrots_eaten_val\n            return MealResult(total_eaten, remaining_after)\n\n    # Orchestration logic following the design for eat(...)\n    input_obj = Input(number, need, remaining)\n\n    validator = Validator()\n    if not validator.validateType(input_obj):\n        raise ValueError(\"Inputs must be integers.\")\n    if not validator.validateRange(input_obj):\n        raise ValueError(\"Inputs must be between 0 and 1000, inclusive.\")\n\n    calculator = CarrotCalculator()\n    carrots_to_eat = calculator.computeCarrotsEaten(input_obj.need, input_obj.remaining)\n\n    # CarrotStock is instantiated and depleted as per design, though its final state isn't directly used in the return value calculation.\n    _carrot_stock = CarrotStock(input_obj.remaining)\n    _carrot_stock.deplete(carrots_to_eat)\n\n    meal_result = calculator.computeTotals(input_obj.number, carrots_to_eat, input_obj.remaining)\n\n    return [meal_result.total_eaten, meal_result.remaining_after]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/161": [{"task_id": "HumanEval/161", "solution": "class InputString:\n    def __init__(self, value: str):\n        self.value: str = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the input string.\"\"\"\n        return len(self.value)\n\n    def containsLetters(self) -> bool:\n        \"\"\"Checks if the input string contains any alphabetic characters.\"\"\"\n        for char in self.value:\n            if char.isalpha():\n                return True\n        return False\nclass Character:\n    def __init__(self, value: str, position: int):\n        self.value: str = value\n        self.position: int = position\n\n    def isAlphabetic(self) -> bool:\n        \"\"\"Checks if the character is an alphabetic letter.\"\"\"\n        return self.value.isalpha()\n\n    def isUpper(self) -> bool:\n        \"\"\"Checks if the character is an uppercase letter.\"\"\"\n        return self.value.isupper()\n\n    def isLower(self) -> bool:\n        \"\"\"Checks if the character is a lowercase letter.\"\"\"\n        return self.value.islower()\nclass CaseTransformer:\n    def transform(self, s: InputString) -> str:\n        \"\"\"Applies case transformation or reversal based on string content.\"\"\"\n        if s.containsLetters():\n            transformed_chars = []\n            for char_val in s.value:\n                char_obj = Character(char_val, 0) # Position not strictly needed here for logic\n                if char_obj.isAlphabetic():\n                    transformed_chars.append(self.invertCase(char_val))\n                else:\n                    transformed_chars.append(char_val)\n            return \"\".join(transformed_chars)\n        else:\n            return self.reverse(s.value)\n\n    def invertCase(self, c: str) -> str:\n        \"\"\"Inverts the case of a single character if it's alphabetic.\"\"\"\n        if c.islower():\n            return c.upper()\n        elif c.isupper():\n            return c.lower()\n        return c\n\n    def reverse(self, s: str) -> str:\n        \"\"\"Reverses a given string.\"\"\"\n        return s[::-1]\ndef solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n    inp = InputString(s)\n    transformer = CaseTransformer()\n    return transformer.transform(inp)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/39": [{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    import math\n\n    class InputValidator:\n        \"\"\"Validates input parameters for type and range.\"\"\"\n        def validate_type(self, n):\n            if not isinstance(n, int):\n                raise TypeError(\"Input 'n' must be an integer.\")\n\n        def validate_range(self, n):\n            if n < 1:\n                raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\n    class FibonacciSequence:\n        \"\"\"Generates Fibonacci numbers iteratively, starting F(1)=1, F(2)=1.\"\"\"\n        def __init__(self):\n            self.current_a = 0\n            self.current_b = 1\n\n        def reset(self):\n            self.current_a = 0\n            self.current_b = 1\n\n        def next(self) -> int:\n            fib_num = self.current_b\n            self.current_a, self.current_b = self.current_b, self.current_a + self.current_b\n            return fib_num\n\n    class PrimeChecker:\n        \"\"\"Determines if a given number is prime.\"\"\"\n        def is_prime(self, num: int) -> bool:\n            if num <= 1:\n                return False\n            if num == 2:\n                return True\n            if num % 2 == 0:\n                return False\n            # Check for odd divisors from 3 up to sqrt(num).\n            for i in range(3, int(math.sqrt(num)) + 1, 2):\n                if num % i == 0:\n                    return False\n            return True\n\n    class PrimeFibonacciService:\n        \"\"\"Orchestrates finding the n-th prime Fibonacci number.\"\"\"\n        def __init__(self):\n            self.fib_sequence = FibonacciSequence()\n            self.prime_checker = PrimeChecker()\n\n        def prime_fib(self, n: int) -> int:\n            self.fib_sequence.reset()\n            found_primes_count = 0\n            \n            current_fib = 0\n            while found_primes_count < n:\n                current_fib = self.fib_sequence.next()\n                if self.prime_checker.is_prime(current_fib):\n                    found_primes_count += 1\n            \n            return current_fib\n\n    # Facade logic: validate input and delegate to the service.\n    validator = InputValidator()\n    validator.validate_type(n)\n    validator.validate_range(n)\n\n    service = PrimeFibonacciService()\n    return service.prime_fib(n)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[12]]}], "HumanEval/160": [{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Evaluates an algebraic expression from given operators and operands.\n    The evaluation follows standard operator precedence and associativity.\n    \"\"\"\n\n    # Helper maps for operator properties: precedence and associativity.\n    precedence = {'+': 1, '-': 1, '*': 2, '//': 2, '**': 3}\n    associativity = {'+': 'left', '-': 'left', '*': 'left', '//': 'left', '**': 'right'}\n\n    # Nested helper function to convert infix tokens to Reverse Polish Notation (RPN).\n    def _to_rpn(tokens_list):\n        output = []\n        op_stack = []\n\n        for token in tokens_list:\n            if isinstance(token, int):  # Operands are integers\n                output.append(str(token))  # Convert to string for consistent RPN output elements\n            elif token in precedence:  # Token is an operator\n                while (op_stack and\n                       (precedence[op_stack[-1]] > precedence[token] or\n                        (precedence[op_stack[-1]] == precedence[token] and associativity[token] == 'left'))):\n                    output.append(op_stack.pop())\n                op_stack.append(token)\n\n        while op_stack:\n            output.append(op_stack.pop())\n        return output\n\n    # Nested helper function to apply an operator to two values.\n    def _apply_operator(op_str, left_val, right_val):\n        if op_str == '+':\n            return left_val + right_val\n        elif op_str == '-':\n            return left_val - right_val\n        elif op_str == '*':\n            return left_val * right_val\n        elif op_str == '//':\n            return left_val // right_val\n        elif op_str == '**':\n            return left_val ** right_val\n        return 0 # This case should not be reached with valid operators\n\n    # 1. Construct the sequence of tokens by interleaving operands and operators.\n    # Operands remain integers initially, operators are strings.\n    expression_tokens = []\n    for i in range(len(operand)):\n        expression_tokens.append(operand[i])\n        if i < len(operator):\n            expression_tokens.append(operator[i])\n\n    # 2. Convert the infix expression tokens to Reverse Polish Notation (RPN).\n    rpn_tokens = _to_rpn(expression_tokens)\n\n    # 3. Evaluate the RPN expression using a stack.\n    value_stack = []\n    for token in rpn_tokens:\n        if token.isdigit(): # Operands are string representations of non-negative integers\n            value_stack.append(int(token))\n        else: # It's an operator\n            right = value_stack.pop()\n            left = value_stack.pop()\n            result = _apply_operator(token, left, right)\n            value_stack.append(result)\n\n    return value_stack[0]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/162": [{"task_id": "HumanEval/162", "solution": "import hashlib\nfrom typing import Optional\ndef string_to_md5(text: str) -> Optional[str]:\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n\n    >>> string_to_md5('Hello world') == '3e25960a79dbc69b674cd4ec67a72c62'\n    \"\"\"\n    if not text:\n        return None\n    # Always encode input using UTF-8 for MD5 computation.\n    return hashlib.md5(text.encode('utf-8')).hexdigest()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/94": [{"task_id": "HumanEval/94", "solution": "import math\nfrom typing import List, Optional\nclass IntegerElement:\n    \"\"\"Represents an integer, providing methods to check for primality and sum its digits.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def isPrime(self) -> bool:\n        \"\"\"Checks if the encapsulated value is a prime number.\"\"\"\n        if self.value <= 1:\n            return False\n        if self.value == 2:\n            return True\n        if self.value % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(self.value)) + 1, 2):\n            if self.value % i == 0:\n                return False\n        return True\n\n    def digitSum(self) -> int:\n        \"\"\"Calculates the sum of the base-10 digits of the encapsulated value.\"\"\"\n        s = 0\n        num = abs(self.value)\n        while num > 0:\n            s += num % 10\n            num //= 10\n        return s\nclass InputList:\n    \"\"\"Encapsulates a list of integers and provides access to them as IntegerElement objects.\"\"\"\n    def __init__(self, values: List[int]) -> None:\n        self._elements: List[IntegerElement] = [IntegerElement(val) for val in values]\n\n    def getElements(self) -> List[IntegerElement]:\n        \"\"\"Returns the list of IntegerElement objects.\"\"\"\n        return self._elements\nclass PrimeFinder:\n    \"\"\"Identifies prime IntegerElements and selects the largest one.\"\"\"\n    def findPrimes(self, input_list: InputList) -> List[IntegerElement]:\n        \"\"\"Filters the input list to return only prime IntegerElement objects.\"\"\"\n        primes = []\n        for element in input_list.getElements():\n            if element.isPrime():\n                primes.append(element)\n        return primes\n\n    def selectLargest(self, primes: List[IntegerElement]) -> Optional[IntegerElement]:\n        \"\"\"Selects the IntegerElement with the largest value from a list of primes.\"\"\"\n        if not primes:\n            return None\n        largest_prime = None\n        max_value = -1 # Primes are positive, so -1 is a safe initial minimum.\n        for prime in primes:\n            if prime.value > max_value:\n                max_value = prime.value\n                largest_prime = prime\n        return largest_prime\nclass DigitSummer:\n    \"\"\"Computes the sum of decimal digits for a given integer.\"\"\"\n    def sumDigits(self, n: int) -> int:\n        \"\"\"Calculates the sum of the base-10 digits of an integer.\"\"\"\n        s = 0\n        num = abs(n)\n        while num > 0:\n            s += num % 10\n            num //= 10\n        return s\nclass Result:\n    \"\"\"Represents the selected prime and its digit sum, providing the final integer result.\"\"\"\n    def __init__(self, prime_value: int, digit_sum: int) -> None:\n        self.prime_value = prime_value\n        self.digit_sum = digit_sum\n\n    def asInt(self) -> int:\n        \"\"\"Returns the computed digit sum.\"\"\"\n        return self.digit_sum\ndef skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    input_list = InputList(lst)\n    prime_finder = PrimeFinder()\n    primes = prime_finder.findPrimes(input_list)\n    largest = prime_finder.selectLargest(primes)\n    if largest is None:\n        raise NotImplementedError(\"Behavior for no-prime case must be defined by implementer\")\n    digit_sum = DigitSummer().sumDigits(largest.value)\n    return Result(largest.value, digit_sum).asInt()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/163": [{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n\n    class InputParameters:\n        def __init__(self, a: int, b: int) -> None:\n            self.a = a\n            self.b = b\n\n        def validate_positive(self) -> bool:\n            return self.a > 0 and self.b > 0\n\n    class Range:\n        def __init__(self) -> None:\n            self.lower_bound = 0\n            self.upper_bound = 0\n\n        def compute(self, minimum: int, maximum: int) -> None:\n            self.lower_bound = minimum\n            self.upper_bound = maximum\n\n    class EvenDigitCandidates:\n        def __init__(self) -> None:\n            self.candidates = {2, 4, 6, 8}\n\n        def filter_within(self, range_obj: Range) -> list[int]:\n            filtered = []\n            for candidate in sorted(list(self.candidates)): # Ensure ascending order for initial candidates\n                if range_obj.lower_bound <= candidate <= range_obj.upper_bound:\n                    filtered.append(candidate)\n            return filtered\n\n    class ResultList:\n        def __init__(self, values: list[int]) -> None:\n            self.values = values\n\n        def sort_ascending(self) -> None:\n            self.values.sort()\n\n        def is_empty(self) -> bool:\n            return not self.values\n\n    class Generator:\n        def generate(self, a: int, b: int) -> list[int]:\n            inputs = InputParameters(a, b)\n            # Per design, assume inputs are valid or validate_positive returns True.\n            # No explicit error handling for False return is specified in output.\n            inputs.validate_positive()\n\n            range_obj = Range()\n            range_obj.compute(min(a, b), max(a, b))\n\n            candidates = EvenDigitCandidates()\n            values = candidates.filter_within(range_obj)\n\n            result = ResultList(values)\n            result.sort_ascending()\n            return result.values\n\n    gen = Generator()\n    return gen.generate(a, b)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/83": [{"task_id": "HumanEval/83", "solution": "class ValidationError(Exception):\n    \"\"\"Represents a validation failure with a human-readable message.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\nclass Validator:\n    \"\"\"Validates that n is an integer >= 1.\"\"\"\n    def validate(self, n) -> bool:\n        if not isinstance(n, int) or n < 1:\n            raise ValidationError('n must be an integer >= 1')\n        return True\nclass Counter:\n    \"\"\"Computes the count of n-digit numbers that start or end with 1.\"\"\"\n    def computeCount(self, n: int) -> int:\n        if n == 1:\n            return 1\n        else: # n >= 2, as validated by Validator\n            return 18 * (10 ** (n - 2))\ndef starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    validator_instance = Validator()\n    validator_instance.validate(n)\n\n    counter_instance = Counter()\n    result = counter_instance.computeCount(n)\n\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/130": [{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in \n    the last couple centuries. However, what people don't know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8 \n    You are given a non-negative integer number n, you have to a return a list of the \n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n    \n    if n == 0:\n        return [1]\n\n    # Use a dictionary for memoization to store computed values\n    # allowing for out-of-order computations required by the recurrence.\n    memo = {}\n\n    # Set base values for tri(0) and tri(1) as per design context and example.\n    memo[0] = 1\n    memo[1] = 3\n\n    # Determine the maximum index needed for computation.\n    # If n is odd, tri(n) requires tri(n+1), which must be computed.\n    max_idx_to_compute = n\n    if n % 2 != 0:\n        max_idx_to_compute = n + 1\n\n    # First pass: Compute all even indices up to max_idx_to_compute.\n    # These are independent of other unknown values.\n    for i in range(max_idx_to_compute + 1):\n        if i % 2 == 0:\n            memo[i] = 1 + (i // 2)\n\n    # Second pass: Compute odd indices from 3 up to n using the recurrence.\n    # tri(i-1), tri(i-2), and tri(i+1) should already be available in memo.\n    for i in range(2, n + 1):\n        if i % 2 != 0:  # If i is odd (i.e., 3, 5, 7, ...)\n            memo[i] = memo[i - 1] + memo[i - 2] + memo[i + 1]\n\n    # Assemble the result list of the first n+1 numbers.\n    result = [memo[i] for i in range(n + 1)]\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "import collections\nfrom typing import List, Iterator\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n    \"\"\"\n\n    # --- Start of src/validator.py components ---\n    class ValidationResult:\n        \"\"\"Holds validation outcome and an optional message.\"\"\"\n        def __init__(self, is_valid: bool, message: str = \"\") -> None:\n            self.is_valid = is_valid\n            self.message = message\n\n    class InputException(Exception):\n        \"\"\"Custom exception for invalid input parameters.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class Validator:\n        \"\"\"Performs validation checks on grid and k.\"\"\"\n        def validate_grid(self, grid_matrix: List[List[int]]) -> ValidationResult:\n            if not isinstance(grid_matrix, list) or not all(isinstance(row, list) for row in grid_matrix):\n                return ValidationResult(False, \"Grid must be a list of lists.\")\n            if not grid_matrix:\n                return ValidationResult(False, \"Grid cannot be empty.\")\n\n            N = len(grid_matrix)\n            if N < 2:\n                return ValidationResult(False, \"Grid must have at least 2 rows (N >= 2).\")\n\n            seen_values = set()\n            expected_values = set(range(1, N * N + 1))\n            for r_idx, row in enumerate(grid_matrix):\n                if len(row) != N:\n                    return ValidationResult(False, f\"Grid must be square (N rows, N columns). Row {r_idx} has {len(row)} columns, expected {N}.\")\n                for val in row:\n                    if not isinstance(val, int):\n                        return ValidationResult(False, f\"All grid cell values must be integers. Found {val} in row {r_idx}.\")\n                    seen_values.add(val)\n\n            if seen_values != expected_values:\n                missing_values = sorted(list(expected_values - seen_values))\n                extra_values = sorted(list(seen_values - expected_values))\n                error_msg_parts = []\n                if missing_values:\n                    error_msg_parts.append(f\"missing values: {missing_values[:5]}{'...' if len(missing_values) > 5 else ''}\")\n                if extra_values:\n                    error_msg_parts.append(f\"unexpected or duplicate values: {extra_values[:5]}{'...' if len(extra_values) > 5 else ''}\")\n                \n                if error_msg_parts:\n                    return ValidationResult(False, f\"Grid values are invalid: {'; '.join(error_msg_parts)}.\")\n                else: \n                    return ValidationResult(False, \"Grid values are not exactly [1, N*N] or contain duplicates.\")\n\n            return ValidationResult(True)\n\n        def validate_k(self, k_val: int) -> ValidationResult:\n            \"\"\"Validates the input integer k.\"\"\"\n            if not isinstance(k_val, int):\n                return ValidationResult(False, \"k must be an integer.\")\n            if k_val < 1:\n                return ValidationResult(False, \"k must be a positive integer (k >= 1).\")\n            return ValidationResult(True)\n    # --- End of src/validator.py components ---\n\n\n    # --- Start of src/models.py components ---\n    class Cell:\n        \"\"\"Represents a single cell in the grid.\"\"\"\n        def __init__(self, value: int, row: int, col: int) -> None:\n            self.value = value\n            self.row = row\n            self.col = col\n\n    class Grid:\n        \"\"\"Represents the grid structure with Cell objects.\"\"\"\n        def __init__(self, matrix: List[List[int]]) -> None:\n            self.N = len(matrix)\n            self.cells: List[List[Cell]] = []\n            for r in range(self.N):\n                row_cells = []\n                for c in range(self.N):\n                    row_cells.append(Cell(matrix[r][c], r, c))\n                self.cells.append(row_cells)\n\n        def get_cell(self, row: int, col: int) -> 'Cell':\n            \"\"\"Safely retrieves a cell by its coordinates.\"\"\"\n            return self.cells[row][col]\n\n        def to_values(self) -> List[int]:\n            \"\"\"Returns a flattened list of all cell values in the grid.\"\"\"\n            values = []\n            for r in range(self.N):\n                for c in range(self.N):\n                    values.append(self.cells[r][c].value)\n            return values\n\n    class Path:\n        \"\"\"Represents an ordered sequence of visited cells.\"\"\"\n        def __init__(self) -> None:\n            self.cells: List[Cell] = []\n\n        @property\n        def length(self) -> int:\n            \"\"\"The number of cells in the path.\"\"\"\n            return len(self.cells)\n\n        def append(self, cell: 'Cell') -> None:\n            \"\"\"Adds a cell to the end of the path.\"\"\"\n            self.cells.append(cell)\n\n        def values(self) -> List[int]:\n            \"\"\"Returns an ordered list of values from the cells in the path.\"\"\"\n            return [cell.value for cell in self.cells]\n\n        def copy(self) -> 'Path':\n            \"\"\"Returns a shallow copy of the path.\"\"\"\n            new_path = Path()\n            new_path.cells.extend(self.cells) \n            return new_path\n    # --- End of src/models.py components ---\n\n\n    # --- Start of src/min_path_service.py components ---\n    class MinPathService:\n        \"\"\"Engine to generate and select the lexicographically minimal path.\"\"\"\n        def minPath(self, grid_model: 'Grid', k: int) -> List[int]:\n            \"\"\"Orchestrates path generation and selection.\"\"\"\n            paths_generator = self._generate_candidate_paths(grid_model, k)\n            best_path = self._compare_and_select(paths_generator)\n            return best_path.values()\n\n        def _generate_candidate_paths(self, grid_model: 'Grid', k: int) -> Iterator['Path']:\n            \"\"\"Yields all valid paths of length k in the grid.\"\"\"\n            N = grid_model.N\n            \n            q = collections.deque()\n\n            # Initialize with all possible starting cells\n            for r in range(N):\n                for c in range(N):\n                    initial_path = Path()\n                    initial_path.append(grid_model.get_cell(r, c))\n                    q.append(initial_path)\n\n            DR = [-1, 1, 0, 0] # Row offsets for neighbors (up, down, left, right)\n            DC = [0, 0, -1, 1] # Column offsets for neighbors\n\n            while q:\n                current_path = q.popleft()\n\n                if current_path.length == k:\n                    yield current_path\n                    continue \n\n                last_cell = current_path.cells[-1]\n\n                for i in range(4): # Explore 4 neighbors\n                    new_r, new_c = last_cell.row + DR[i], last_cell.col + DC[i]\n\n                    # Check bounds\n                    if 0 <= new_r < N and 0 <= new_c < N:\n                        next_cell = grid_model.get_cell(new_r, new_c)\n                        new_path = current_path.copy()\n                        new_path.append(next_cell)\n                        q.append(new_path)\n\n        def _compare_and_select(self, paths: Iterator['Path']) -> 'Path':\n            \"\"\"Compares paths lexicographically and returns the minimal one.\"\"\"\n            min_path_values: List[int] = None # type: ignore\n            min_path_object: Path = None # type: ignore\n\n            for path in paths:\n                current_path_values = path.values()\n                if min_path_values is None or current_path_values < min_path_values:\n                    min_path_values = current_path_values\n                    min_path_object = path\n            \n            return min_path_object\n    # --- End of src/min_path_service.py components ---\n\n\n    # --- minPath(grid, k) public API logic ---\n    validator = Validator()\n\n    vres_grid = validator.validate_grid(grid)\n    if not vres_grid.is_valid:\n        raise InputException(vres_grid.message)\n\n    vres_k = validator.validate_k(k)\n    if not vres_k.is_valid:\n        raise InputException(vres_k.message)\n\n    grid_model = Grid(grid)\n    engine = MinPathService()\n    return engine.minPath(grid_model, k)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[12, 13, 10, 1], [9, 3, 15, 6], [5, 16, 14, 4], [11, 8, 7, 2]], 12]], "plus_fail_tests": [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], 15]]}], "HumanEval/139": [{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    \n    # Internal helper function to calculate factorial(k)\n    def factorial(k):\n        if k == 0:\n            return 1\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    brazilian_product = 1\n    # Calculate the product of factorials from 1! up to n!\n    for k in range(1, n + 1):\n        brazilian_product *= factorial(k)\n        \n    return brazilian_product", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]}}