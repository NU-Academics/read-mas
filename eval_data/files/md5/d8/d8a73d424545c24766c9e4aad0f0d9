acters.\"\"\"\n        for char in group:\n            if char not in ('(', ')'):\n                raise ValidationError(f\"Invalid character '{char}' found in group: '{group}'\")\n\n    def _compute_max_depth(self, group: str) -> int:\n        \"\"\"Calculates the maximum nesting depth for a single parentheses group in one pass.\"\"\"\n        current_depth = 0\n        max_depth = 0\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                if current_depth == 0:\n                    raise ValidationError(f\"Early closing parenthesis in group: '{group}'\")\n                current_depth -= 1\n        if current_depth != 0:\n            raise ValidationError(f\"Unmatched opening parenthesis in group: '{group}'\")\n        return max_depth\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    parser = Parser()\n    return parser.parse(paren_string)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/2": [{"task_id": "HumanEval/2", "solution": "import math\nfrom typing import Any\nclass ValidationError(ValueError):\n    \"\"\"Represents a validation failure.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass InputNumber:\n    \"\"\"Encapsulates the input numeric value and provides validation helpers.\"\"\"\n    def __init__(self, value: Any) -> None:\n        self.value = float(value)\n\n    def is_positive(self) -> bool:\n        \"\"\"Returns True if the value is strictly positive (greater than 0.0).\"\"\"\n        return self.value > 0.0\n\n    def is_integer(self) -> bool:\n        \"\"\"Returns True if the value represents an integer.\"\"\"\n        return self.value.is_integer()\nclass DecimalPart:\n    \"\"\"Container for the computed fractional part.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value = value\ndef truncate_number(number: float) -> float:\n    \"\"\"Given a positive floating point number, return its decimal part.\n    This is the leftover part after removing the largest integer smaller than the given number.\n    \"\"\"\n    # Coerce input to a float-compatible representation and handle non-numeric inputs.\n    try:\n        coerced_value = float(number)\n    except (TypeError, ValueError):\n        raise ValidationError('input must be numeric and float-compatible')\n\n    # Reject NaN or infinite values.\n    if math.isnan(coerced_value) or math.isinf(coerced_value):\n        raise ValidationError('input must be finite')\n\n    # Validate positivity using InputNumber semantics.\n    input_num = InputNumber(coerced_value)\n    if not input_num.is_positive():\n        raise ValidationError('number must be positive')\n\n    # Compute the integer part (floor value).\n    floor_value = math.floor(coerced_value)\n\n    # Compute the decimal part.\n    decimal_value = float(coerced_value - floor_value)\n\n    # Wrap the result in DecimalPart as per design, then return its value.\n    result_decimal_part = DecimalPart(decimal_value)\n    return result_decimal_part.value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/1": [{"task_id": "HumanEval/1", "solution": "from typing import List\nclass ParenString:\n    \"\"\"Represents the raw input string and provides normalization.\"\"\"\n    def __init__(self, raw: str) -> None:\n        self.raw = raw\n\n    def normalize(self) -> str:\n        \"\"\"Returns the raw string with all whitespace removed.\"\"\"\n        return self.raw.replace(\" \", \"\")\nclass ParenGroup:\n    \"\"\"Represents an extracted top-level parenthesis group with metadata.\"\"\"\n    def __init__(self, text: str, depth: int, order: int) -> None:\n        self.text = text\n        self.depth = depth\n        self.order = order\n\n    def __repr__(self) -> str:\n        return f\"ParenGroup(text='{self.text}', depth={self.depth}, order={self.order})\"\nclass Parser:\n    \"\"\"Encapsulates parsing logic for parenthesis groups.\"\"\"\n    def _strip_spaces(self, s: str) -> str:\n        \"\"\"Removes all whitespace characters from a string.\"\"\"\n        return s.replace(\" \", \"\")\n\n    def _find_top_level_groups(self, s: str) -> List[ParenGroup]:\n        \"\"\"Identifies and extracts top-level balanced parenthesis groups from a normalized string.\"\"\"\n        groups: List[ParenGroup] = []\n        balance = 0\n        current_group_start_index = 0\n        group_order_counter = 0\n\n        for i, char in enumerate(s):\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n\n            if balance == 0: # A top-level group has just been completed\n                group_order_counter += 1\n                group_text = s[current_group_start_index : i + 1]\n                groups.append(ParenGroup(group_text, 1, group_order_counter)) # Depth 1 for top-level groups\n                current_group_start_index = i + 1 # Prepare for the next potential group\n\n        return groups\n\n    def separate_paren_groups(self, paren_string: str) -> List[str]:\n        \"\"\"Separates multiple groups of nested parentheses into a list of strings.\"\"\"\n        paren_string_obj = ParenString(paren_string)\n        normalized_string = paren_string_obj.normalize()\n        \n        extracted_paren_groups = self._find_top_level_groups(normalized_string)\n        return [group.text for group in extracted_paren_groups]\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    parser = Parser()\n    return parser.separate_paren_groups(paren_string)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/7": [{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    result = []\n    for s in strings:\n        if substring in s:\n            result.append(s)\n    return result", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/5": [{"task_id": "HumanEval/5", "solution": "from typing import List\nclass NumbersList:\n    \"\"\"Wrapper around a list of numbers to provide length and copy helpers.\"\"\"\n    def __init__(self, values: List[int]) -> None:\n        self.values = values\n\n    def length(self) -> int:\n        return len(self.values)\n\n    def copy(self) -> List[int]:\n        \"\"\"Returns a shallow copy of the wrapped list.\"\"\"\n        return list(self.values)\nclass Delimiter:\n    \"\"\"Wrapper for the delimiter integer value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\nclass InterspersedList:\n    \"\"\"Holds the building result list and provides an append operation.\"\"\"\n    def __init__(self) -> None:\n        self.values: List[int] = []\n\n    def append(self, item: int) -> None:\n        self.values.append(item)\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns the final built list.\"\"\"\n        return self.values\nclass TypeValidator:\n    \"\"\"Validates runtime types of inputs and raises TypeError on violations.\"\"\"\n    def validate(self, numbers: List[int], delimeter: int) -> None:\n        if not isinstance(numbers, list):\n            raise TypeError(\"Input 'numbers' must be a list.\")\n        if not all(isinstance(x, int) for x in numbers):\n            raise TypeError(\"All elements in 'numbers' must be integers.\")\n        if not isinstance(delimeter, int):\n            raise TypeError(\"Input 'delimeter' must be an integer.\")\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    TypeValidator().validate(numbers, delimeter)\n\n    numbers_wrapped = NumbersList(numbers)\n    result_list_builder = InterspersedList()\n\n    list_length = numbers_wrapped.length()\n\n    if list_length == 0:\n        return []\n    elif list_length == 1:\n        result_list_builder.append(numbers_wrapped.values[0])\n        return result_list_builder.to_list()\n    else:\n        delimiter_obj = Delimiter(delimeter)\n        \n        result_list_builder.append(numbers_wrapped.values[0])\n\n        for i in range(1, list_length):\n            result_list_builder.append(delimiter_obj.value)\n            result_list_builder.append(numbers_wrapped.values[i])\n        \n        return result_list_builder.to_list()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/4": [{"task_id": "HumanEval/4", "solution": "from typing import List\nclass NumberList:\n    \"\"\"Encapsulates the input list of floats.\"\"\"\n    def __init__(self, numbers: List[float]) -> None:\n        self.numbers = numbers\nclass InputValidator:\n    \"\"\"Validates input. Per prompt constraints, explicit checks and error raising are omitted.\"\"\"\n    def validate(self, number_list: NumberList) -> bool:\n        # Per prompt constraints, validation checks and explicit error raising are omitted.\n        return True\nclass MeanAbsoluteDeviationCalculator:\n    \"\"\"Computes mean, absolute differences, and Mean Absolute Deviation.\"\"\"\n    def compute_mean(self, number_list: NumberList) -> float:\n        \"\"\"Computes arithmetic mean. Assumes number_list.numbers is non-empty.\"\"\"\n        numbers = number_list.numbers\n        return sum(numbers) / len(numbers)\n\n    def compute_absolute_differences(self, number_list: NumberList, x_mean: float) -> List[float]:\n        \"\"\"Returns a list of absolute differences from the mean.\"\"\"\n        return [abs(x - x_mean) for x in number_list.numbers]\n\n    def compute_mad(self, number_list: NumberList) -> float:\n        \"\"\"Computes Mean Absolute Deviation. Assumes number_list.numbers is non-empty.\"\"\"\n        x_mean = self.compute_mean(number_list)\n        abs_diffs = self.compute_absolute_differences(number_list, x_mean)\n        return sum(abs_diffs) / len(abs_diffs)\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    number_list = NumberList(numbers)\n\n    # Input validation (isinstance checks, raise ValueError) is omitted per prompt constraints.\n    # The validator is instantiated and called as per design but performs no active validation.\n    validator = InputValidator()\n    validator.validate(number_list)\n\n    calculator = MeanAbsoluteDeviationCalculator()\n    mad_value = calculator.compute_mad(number_list)\n    return mad_value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/8": [{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\nfrom dataclasses import dataclass\nclass SumProductFunction:\n    def compute(self, number_list: NumberList) -> SumProductResult:\n        if number_list.is_empty():\n            return SumProductResult(sum=0, product=1)\n        s = 0\n        p = 1\n        for n in number_list.numbers:\n            s += n\n            p *= n\n        return SumProductResult(sum=s, product=p)\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    nl = NumberList(numbers=numbers)\n    result = SumProductFunction().compute(nl)\n    return (result.sum, result.product)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/9": [{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    current_max = float('-inf') # Initialize with negative infinity to correctly handle all integers\n\n    for number in numbers:\n        if number > current_max:\n            current_max = number\n        result.append(current_max)\n\n    return result", "base_status"