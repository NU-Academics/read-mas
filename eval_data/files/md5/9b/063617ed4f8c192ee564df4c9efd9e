{"task_id": "Mbpp/126", "solution": "import math\n\n\ndef _gcd(a: int, b: int) -> int:\n    \"\"\"Calculates the greatest common divisor of two integers.\n    Uses Euclidean algorithm via `math.gcd`.\n    \"\"\"\n    return math.gcd(a, b)\n\n\ndef _get_divisors(n: int) -> set[int]:\n    \"\"\"Finds all positive divisors of a non-negative integer n.\n    Returns a set of positive divisors.\n    \"\"\"\n    if n == 0:\n        return set()\n    divs = set()\n    for i in range(1, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            divs.add(i)\n            divs.add(n // i)\n    return divs\n\n\ndef sum_common_divisors(num1: int, num2: int) -> int:\n    \"\"\"Computes the sum of common divisors for two given integers.\n    Handles positive, negative, and zero inputs appropriately as defined in the design.\n    \"\"\"\n    abs_num1 = abs(num1)\n    abs_num2 = abs(num2)\n\n    if abs_num1 == 0 and abs_num2 == 0:\n        return 0\n\n    greatest_common_divisor = _gcd(abs_num1, abs_num2)\n\n    common_divisors = _get_divisors(greatest_common_divisor)\n\n    return sum(common_divisors)"}
{"task_id": "Mbpp/128", "solution": "def long_words(n: int, text: str) -> list[str]:\n    \"\"\"\n    Finds words in a given text that are strictly longer than n characters.\n\n    Returns a list of words from the text that are longer than n.\n    \"\"\"\n    words = text.split()\n    long_words_list = [word for word in words if len(word) > n]\n    return long_words_list"}
{"task_id": "Mbpp/130", "solution": "import collections\n\ndef max_occurrences(input_list: list) -> any:\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    Handles empty lists by returning None and ties by returning the first encountered item.\n    \"\"\"\n    if not input_list:\n        return None\n\n    counts = collections.Counter(input_list)\n    max_count = 0\n    max_item = None\n\n    # Iterate through the input list to find the first item with the maximum frequency\n    for item in input_list:\n        if counts[item] > max_count:\n            max_count = counts[item]\n            max_item = item\n        # If an item has the same frequency as the current max, but was encountered earlier,\n        # it will already be stored in max_item due to the ordered iteration.\n        # No explicit tie-breaking logic is needed beyond this ordered traversal.\n            \n    return max_item"}
{"task_id": "Mbpp/131", "solution": "_VOWELS_SET = {'a', 'e', 'i', 'o', 'u'}\n\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is a vowel (a, e, i, o, u, case-insensitive, 'y' excluded).\"\"\"\n    return char.lower() in _VOWELS_SET\n\ndef reverse_vowels(input_string: str) -> str:\n    \"\"\"Reverses only the vowels in the given string, preserving non-vowel positions.\"\"\"\n    char_list = list(input_string)\n    vowel_indices = []\n    vowels_found = []\n\n    for i, char in enumerate(char_list):\n        if _is_vowel(char):\n            vowel_indices.append(i)\n            vowels_found.append(char)\n\n    vowels_found.reverse()\n\n    for i, original_index in enumerate(vowel_indices):\n        char_list[original_index] = vowels_found[i]\n\n    return \"\".join(char_list)"}
{"task_id": "Mbpp/129", "solution": "def _is_square_matrix(matrix: list[list[int]]) -> bool:\n    \"\"\"Checks if the input is a square matrix and not empty.\n    It also ensures all rows have the same length.\n    \"\"\"\n    n_rows = len(matrix)\n    if n_rows == 0:\n        return False\n\n    n_cols_expected = n_rows\n    for row in matrix:\n        if len(row) != n_cols_expected:\n            return False\n\n    return True\n\ndef _calculate_row_sums(matrix: list[list[int]]) -> list[int]:\n    \"\"\"Computes the sum of elements for each row in the matrix.\"\"\"\n    return [sum(row) for row in matrix]\n\ndef _calculate_column_sums(matrix: list[list[int]]) -> list[int]:\n    \"\"\"Computes the sum of elements for each column in the matrix.\"\"\"\n    n = len(matrix)\n    column_sums = [0] * n\n    for j in range(n):  # Iterate through columns\n        for i in range(n):  # Iterate through rows\n            column_sums[j] += matrix[i][j]\n    return column_sums\n\ndef _calculate_main_diagonal_sum(matrix: list[list[int]]) -> int:\n    \"\"\"Computes the sum of elements along the main diagonal (top-left to bottom-right).\"\"\"\n    n = len(matrix)\n    main_diag_sum = 0\n    for i in range(n):\n        main_diag_sum += matrix[i][i]\n    return main_diag_sum\n\ndef _calculate_anti_diagonal_sum(matrix: list[list[int]]) -> int:\n    \"\"\"Computes the sum of elements along the anti-diagonal (top-right to bottom-left).\"\"\"\n    n = len(matrix)\n    anti_diag_sum = 0\n    for i in range(n):\n        anti_diag_sum += matrix[i][n - 1 - i]\n    return anti_diag_sum\n\ndef magic_square_test(matrix: list[list[int]]) -> bool:\n    \"\"\"\n    Determines if the given matrix is a magic square by checking squareness and consistency of all sums.\n    All row, column, and diagonal sums must be identical for it to be a magic square.\n    \"\"\"\n    if not _is_square_matrix(matrix):\n        return False\n\n    row_sums = _calculate_row_sums(matrix)\n    column_sums = _calculate_column_sums(matrix)\n    main_diagonal_sum = _calculate_main_diagonal_sum(matrix)\n    anti_diagonal_sum = _calculate_anti_diagonal_sum(matrix)\n\n    all_sums = []\n    all_sums.extend(row_sums)\n    all_sums.extend(column_sums)\n    all_sums.append(main_diagonal_sum)\n    all_sums.append(anti_diagonal_sum)\n\n    # Check if all sums are identical by converting to a set and checking its length.\n    return len(set(all_sums)) == 1"}
