{"task_id": "Mbpp/724", "solution": "def power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    Handles large numbers by performing arithmetic and string conversion.\n    \"\"\"\n    # Calculate base^power\n    result = base ** power\n    \n    # Convert the result to a string to iterate over its digits\n    result_str = str(result)\n    \n    # Sum all digits\n    digit_sum = 0\n    for digit_char in result_str:\n        digit_sum += int(digit_char)\n        \n    return digit_sum"}
{"task_id": "Mbpp/721", "solution": "import math\n\ndef maxAverageOfPath(matrix: list[list[int]]) -> float:\n    \"\"\"\n    Calculates the maximum average cost of a path from the top-left to the bottom-right\n    cell in a square matrix, moving only right or down.\n    \"\"\"\n    class Cell:\n        def __init__(self, value: int, row: int, col: int):\n            self.value = value\n            self.row = row\n            self.col = col\n\n    class Path:\n        def __init__(self, cells: list[Cell]):\n            self.cells = list(cells)\n            self.total_cost = 0\n            self.number_of_cells = 0\n            self.average_cost = 0.0\n            self.calculate_metrics()\n\n        def calculate_metrics(self) -> None:\n            self.total_cost = sum(cell.value for cell in self.cells)\n            self.number_of_cells = len(self.cells)\n            if self.number_of_cells > 0:\n                self.average_cost = float(self.total_cost) / self.number_of_cells\n\n    class Matrix:\n        def __init__(self, values: list[list[int]]):\n            self.values = values\n            self.N = len(values)\n\n        def get_cell(self, row: int, col: int) -> Cell:\n            # Assumes row and col are within bounds, checked by caller logic.\n            return Cell(self.values[row][col], row, col)\n\n    N = len(matrix)\n    matrix_obj = Matrix(matrix)\n    max_avg_ref = {'value': -math.inf}\n\n    def _find_all_paths_recursive(current_row: int, current_col: int, current_path_cells: list[Cell]) -> None:\n        # Add the current cell to the path.\n        cell = matrix_obj.get_cell(current_row, current_col)\n        current_path_cells.append(cell)\n\n        # If at the bottom-right cell, evaluate the path.\n        if current_row == N - 1 and current_col == N - 1:\n            current_path = Path(current_path_cells)\n            if current_path.average_cost > max_avg_ref['value']:\n                max_avg_ref['value'] = current_path.average_cost\n        else:\n            # Explore moving down.\n            if current_row + 1 < N:\n                _find_all_paths_recursive(current_row + 1, current_col, current_path_cells)\n            # Explore moving right.\n            if current_col + 1 < N:\n                _find_all_paths_recursive(current_row, current_col + 1, current_path_cells)\n\n        # Backtrack: remove the current cell to explore other paths.\n        current_path_cells.pop()\n\n    # Start the recursive search from the top-left cell (0, 0).\n    _find_all_paths_recursive(0, 0, [])\n\n    return max_avg_ref['value']"}
{"task_id": "Mbpp/722", "solution": "def filter_data(student_data: dict[str, tuple[float, float]], minimal_height: float, minimal_weight: float) -> dict[str, tuple[float, float]]:\n    \"\"\"\n    Filters a dictionary of student data, returning only students whose height and weight meet the specified minimums.\n    \"\"\"\n    filtered_students = {}\n    for name, (height, weight) in student_data.items():\n        if height >= minimal_height and weight >= minimal_weight:\n            filtered_students[name] = (height, weight)\n    return filtered_students"}
