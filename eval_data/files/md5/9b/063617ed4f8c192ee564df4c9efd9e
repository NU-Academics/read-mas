{"task_id": "Mbpp/605", "solution": "def prime_num(number: int) -> bool:\n    \"\"\"Checks if the given integer is a prime number.\"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    \n    # Check for odd divisors from 3 up to the square root of the number.\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "Mbpp/607", "solution": "import re\n\ndef find_literals(text: str, pattern: str) -> tuple[str, int, int]:\n    \"\"\"Searches a string for a regex pattern and returns the first match's substring, start, and end indices.\"\"\"\n    match = re.search(pattern, text)\n    if match:\n        return (match.group(0), match.start(), match.end())\n    return ('', -1, -1)"}
{"task_id": "Mbpp/614", "solution": "def cummulative_sum(data: list[tuple]) -> int:\n    \"\"\"\n    Calculates the cumulative sum of all numerical values across a list of tuples.\n    It iterates through each tuple and sums all elements within them.\n    \"\"\"\n    total_sum = 0\n    for tpl in data:\n        for element in tpl:\n            total_sum += element\n    return total_sum"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list: list, k: int) -> list:\n    \"\"\"Removes the k-th element from a list and returns a new list.\n\n    Raises:\n        IndexError: If k is out of bounds for the input_list.\n    \"\"\"\n    if not (0 <= k < len(input_list)):\n        raise IndexError(\"k is out of bounds for the input list.\")\n    \n    return input_list[:k] + input_list[k+1:]"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix: list[list[int]], n: int) -> int:\n    \"\"\"\n    Returns the maximum value found in the specified column (n) of the given matrix.\n    Includes validation for matrix structure and column index.\n    \"\"\"\n    if not matrix:\n        raise ValueError(\"Matrix cannot be empty\")\n\n    num_rows = len(matrix)\n    num_cols = len(matrix[0])\n\n    for row in matrix:\n        if len(row) != num_cols:\n            raise ValueError(\"Matrix must be rectangular\")\n\n    if n < 0:\n        raise ValueError(\"Column index n must be non-negative\")\n\n    if n >= num_cols:\n        raise IndexError(\"Column index n out of bounds\")\n\n    max_val = matrix[0][n]\n    for r_idx in range(1, num_rows):\n        if matrix[r_idx][n] > max_val:\n            max_val = matrix[r_idx][n]\n    \n    return max_val"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise modulo operation on two tuples of the same length.\n    Raises ValueError if the tuples are not of the same length.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Tuples must be of the same length\")\n\n    results = []\n    for i in range(len(tuple1)):\n        results.append(tuple1[i] % tuple2[i])\n\n    return tuple(results)"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(data: tuple[tuple[float | int]]) -> list[float]:\n    \"\"\"\n    Calculates the average value for each inner tuple in a tuple of tuples.\n    Returns a list of floats, where each float is the average of an inner tuple.\n    \"\"\"\n    averages_list = []\n    for inner_tuple in data:\n        sum_values = sum(inner_tuple)\n        count_values = len(inner_tuple)\n        # Assuming inner_tuples are not empty based on design context\n        average = sum_values / count_values\n        averages_list.append(average)\n    return averages_list"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers: list[int]) -> int:\n    \"\"\"\n    Calculates the size of the largest subset from 'numbers' where every pair\n    of numbers in the subset is mutually divisible.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    # Sort the input list to enable dynamic programming.\n    # This ensures that if a % b == 0, then b appears before a.\n    nums = sorted(numbers)\n    n = len(nums)\n\n    # dp[i] will store the size of the largest divisible subset ending with nums[i].\n    dp = [1] * n\n\n    # Fill dp array\n    for i in range(1, n):\n        for j in range(i):\n            # If nums[i] is divisible by nums[j], it can extend the subset ending at nums[j].\n            if nums[i] % nums[j] == 0:\n                dp[i] = max(dp[i], dp[j] + 1)\n\n    # The result is the maximum value in the dp array.\n    return max(dp)"}
