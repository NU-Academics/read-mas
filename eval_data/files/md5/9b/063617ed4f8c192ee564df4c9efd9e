{"task_id": "Mbpp/101", "solution": "from typing import Any, List\n\ndef kth_element(array: List[Any], k: int) -> Any:\n    \"\"\"\n    Finds the kth element in the given array using 1-based indexing.\n    Validates that k is a positive integer and within array bounds, raising errors if not.\n    \"\"\"\n    if not isinstance(k, int) or k < 1:\n        raise ValueError(\"Index 'k' must be a positive integer (1-based).\")\n\n    if k > len(array):\n        raise IndexError(f\"Index {k} is out of bounds for array of size {len(array)}.\")\n\n    return array[k - 1]"}
{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary_string: str, rotations: int) -> int:\n    \"\"\"\n    Calculates the number of odd-valued integers obtained by rotating a binary string.\n    An odd binary number always ends with '1'.\n    \"\"\"\n    count = 0\n    current_string = binary_string\n    n = len(binary_string)\n\n    for _ in range(rotations):\n        # A binary number is odd if its last digit is '1'\n        if current_string[-1] == '1':\n            count += 1\n        \n        # Perform a left rotation\n        current_string = current_string[1:] + current_string[0]\n        \n    return count"}
{"task_id": "Mbpp/103", "solution": "def _validate_inputs(n: int, m: int) -> None:\n    \"\"\"Validates input parameters n and m according to business rules.\"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    if not isinstance(m, int) or m < 0:\n        raise ValueError(\"Input 'm' must be a non-negative integer.\")\n    if m >= n:\n        raise ValueError(\"Input 'm' must be strictly less than 'n' (0 <= m < n).\")\n\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"Calculates the Eulerian number a(n, m) using a recursive recurrence relation.\n    Inputs must satisfy 0 <= m < n.\"\"\"\n    _validate_inputs(n, m)\n\n    if m == 0 or m == n - 1:\n        return 1\n\n    return (m + 1) * eulerian_num(n - 1, m) + (n - m) * eulerian_num(n - 1, m - 1)"}
{"task_id": "Mbpp/116", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception raised for invalid input to tuple_to_int.\"\"\"\n    pass\n\ndef tuple_to_int(input_tuple: tuple[int, ...]) -> int:\n    \"\"\"\n    Converts a tuple of positive integers into a single integer by concatenation.\n    Raises InvalidInputError if input_tuple is not a tuple or contains non-positive integers.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise InvalidInputError(\"Input must be a tuple.\")\n\n    string_parts = []\n    for item in input_tuple:\n        if not isinstance(item, int) or item <= 0:\n            raise InvalidInputError(\"All elements in the tuple must be positive integers.\")\n        string_parts.append(str(item))\n\n    concatenated_string = \"\".join(string_parts)\n    return int(concatenated_string)"}
{"task_id": "Mbpp/111", "solution": "import collections.abc\n\ndef common_in_nested_lists(nested_list: collections.abc.Sequence[collections.abc.Sequence[collections.abc.Hashable]]) -> set[collections.abc.Hashable]:\n    \"\"\"\n    Identifies and returns elements common to all sub-lists in a given nested list.\n    The function handles empty input and initializes common elements from the first sub-list.\n    \"\"\"\n    if not nested_list:\n        return set()\n\n    # Initialize common elements with the set of elements from the first sub-list\n    common_elements = set(nested_list[0])\n\n    # Iterate through the remaining sub-lists and find intersections\n    for sublist in nested_list[1:]:\n        common_elements = common_elements.intersection(set(sublist))\n\n    return common_elements"}
