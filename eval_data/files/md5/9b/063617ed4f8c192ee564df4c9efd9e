{"task_id": "Mbpp/262", "solution": "def split_two_parts(input_list: list, L: int) -> tuple[list, list]:\n    \"\"\"\n    Splits the given list into two parts where the length of the first part is L.\n    Raises ValueError if L is negative or exceeds the input list's length.\n    \"\"\"\n    list_length = len(input_list)\n    if L < 0:\n        raise ValueError(\"L must be non-negative\")\n    if L > list_length:\n        raise ValueError(\"L cannot exceed list length\")\n\n    first_part = input_list[0:L]\n    second_part = input_list[L:]\n    return (first_part, second_part)"}
{"task_id": "Mbpp/265", "solution": "def list_split(input_list: list, n: int) -> list[list]:\n    # Initialize n empty sublists for the result.\n    result_lists = [[] for _ in range(n)]\n\n    # Distribute elements from the input list into the sublists based on index modulo n.\n    for idx, element in enumerate(input_list):\n        target_sublist_index = idx % n\n        result_lists[target_sublist_index].append(element)\n\n    return result_lists"}
{"task_id": "Mbpp/264", "solution": "def dog_age(human_age: int) -> int:\n    \"\"\"Calculates a dog's age in dog years from human years based on specific rules.\"\"\"\n    if human_age <= 2:\n        # The first two human years count as 10.5 dog years each.\n        return int(human_age * 10.5)\n    else:\n        # After the first two years, each additional human year counts as 4 dog years.\n        return int(2 * 10.5 + (human_age - 2) * 4)"}
