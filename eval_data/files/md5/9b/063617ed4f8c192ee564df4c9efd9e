{"task_id": "Mbpp/98", "solution": "from typing import Iterable, Union\n\ndef multiply_num(sequence: 'Iterable[Union[int, float]]') -> float:\n    \"\"\"Calculates the product of numbers in a sequence and divides by its length.\n\n    Raises ValueError if the input sequence is empty.\n    \"\"\"\n    if not sequence:\n        raise ValueError(\"Input sequence cannot be empty\")\n\n    product = 1.0\n    length = 0\n    for num in sequence:\n        product *= num\n        length += 1\n    \n    return product / length"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists: list[list]) -> int:\n    \"\"\"\n    Finds the length of the smallest list in a list of lists.\n    Returns 0 if the input list_of_lists is empty or contains only empty lists.\n    \"\"\"\n    if not list_of_lists:\n        return 0\n\n    min_length = float('inf')\n    for inner_list in list_of_lists:\n        min_length = min(min_length, len(inner_list))\n\n    return int(min_length)"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"Converts a decimal integer to its binary string representation.\n\n    The output string will have no leading zeros, with '0' for input 0.\n    \"\"\"\n    if decimal_number == 0:\n        return '0'\n\n    binary_digits = []\n    current_number = decimal_number\n    while current_number > 0:\n        remainder = current_number % 2\n        binary_digits.append(str(remainder))\n        current_number //= 2\n\n    return \"\".join(reversed(binary_digits))"}
{"task_id": "Mbpp/94", "solution": "from typing import Any\n\ndef index_minimum(data: list[tuple[Any, Any]]) -> Any | None:\n    \"\"\"\n    Returns the first value of the tuple with the smallest second value.\n    Handles empty lists by returning None.\n    \"\"\"\n    if not data:\n        return None\n\n    # Initialize with the first tuple's values\n    min_first_value = data[0][0]\n    min_second_value = data[0][1]\n\n    # Iterate through the rest of the list to find the minimum\n    for item in data[1:]:\n        current_first_value = item[0]\n        current_second_value = item[1]\n\n        if current_second_value < min_second_value:\n            min_second_value = current_second_value\n            min_first_value = current_first_value\n            \n    return min_first_value"}
{"task_id": "Mbpp/97", "solution": "def frequency_lists(list_of_lists: list[list[any]]) -> dict[any, int]:\n    \"\"\"\n    Flattens a list of lists and calculates the frequency of each element.\n\n    Args:\n        list_of_lists: A list where each element is itself a list.\n\n    Returns:\n        A dictionary where keys are unique elements and values are their frequencies.\n    \"\"\"\n    flattened_list = []\n    for sublist in list_of_lists:\n        flattened_list.extend(sublist)\n\n    frequency_map = {}\n    for element in flattened_list:\n        frequency_map[element] = frequency_map.get(element, 0) + 1\n\n    return frequency_map"}
