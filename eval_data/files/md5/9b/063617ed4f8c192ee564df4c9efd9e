{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in a string that occur at the same position in the string\n    as in the English alphabet (case insensitive).\n    \"\"\"\n    count = 0\n    for index, char in enumerate(input_string):\n        lower_char = char.lower()\n        # Check if the character is an English alphabet letter\n        if 'a' <= lower_char <= 'z':\n            # Calculate 1-indexed string position\n            string_position_1_indexed = index + 1\n            # Calculate 1-indexed alphabet position ('a' is 1, 'b' is 2, etc.)\n            alphabet_position_1_indexed = ord(lower_char) - ord('a') + 1\n\n            # Compare positions and increment count if they match\n            if string_position_1_indexed == alphabet_position_1_indexed:\n                count += 1\n    return count"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(integer_list: list[int]) -> int:\n    \"\"\"\n    Counts pairs of integers in a list that XOR to an even number.\n    The XOR sum of two numbers is even if both are even or both are odd.\n    \"\"\"\n    num_even = 0\n    num_odd = 0\n\n    for number in integer_list:\n        if number % 2 == 0:\n            num_even += 1\n        else:\n            num_odd += 1\n\n    # Calculate pairs where both are even OR both are odd\n    even_count = (num_even * (num_even - 1) // 2) + (num_odd * (num_odd - 1) // 2)\n    return even_count"}
{"task_id": "Mbpp/160", "solution": "def gcd(a, b):\n    \"\"\"Calculates the greatest common divisor of two integers using the Euclidean algorithm.\"\"\"\n    while b:\n        a, b = b, a % b\n    return abs(a)\n\ndef extended_gcd(a, b):\n    \"\"\"Implements the Extended Euclidean Algorithm to find g = gcd(a, b) and coefficients x, y such that ax + by = g.\"\"\"\n    if a == 0:\n        return b, 0, 1\n    g, x, y = extended_gcd(b % a, a)\n    return g, y - (b // a) * x, x\n\ndef find_solution(a, b, n):\n    \"\"\"\n    Finds integers x and y that satisfy ax + by = n, normalizing x to be the smallest non-negative integer solution.\n    Returns None if no integer solution exists.\n    \"\"\"\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    g, x0, y0 = extended_gcd(a, b)\n\n    if n % g != 0:\n        return None\n\n    # Calculate a particular solution (x_p, y_p) for ax + by = n\n    factor = n // g\n    x_p = x0 * factor\n    y_p = y0 * factor\n\n    # If b is 0, x is unique (n/a) and no further normalization for x is needed.\n    # The coefficient (b // g) for 'k' in general solution for x becomes 0.\n    if b == 0:\n        return (x_p, y_p)\n\n    # Normalize x to be the smallest non-negative integer solution\n    # General solution form: x = x_p + k * (b/g), y = y_p - k * (a/g)\n    mod_x_period = b // g\n    mod_y_change = a // g\n\n    # x_final will be in the range [0, abs(mod_x_period) - 1]\n    x_final = x_p % abs(mod_x_period)\n    \n    # Determine the 'k' value (k_change) that shifts x_p to x_final\n    k_change = (x_final - x_p) // mod_x_period\n\n    # Adjust y_p using the same k_change factor from the general solution form\n    y_final = y_p - k_change * mod_y_change\n\n    return (x_final, y_final)"}
