{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth Jacobsthal number using an iterative approach.\n    Handles base cases and applies the recurrence relation J(n) = J(n-1) + 2 * J(n-2).\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    elif n == 2:\n        return 1\n\n    a, b = 1, 1  # Represents J(i-1) and J(i) for the current iteration (starting after n=2)\n    # At this point, for n=2, a=J(1), b=J(2). We need to calculate J(3) onwards.\n    # Let's adjust for the iterative loop setup:\n    # We need J(i-2) and J(i-1) to calculate J(i).\n    # Initialize prev_prev as J(0) and prev as J(1).\n    prev_prev = 0  # Represents J(k-2)\n    prev = 1       # Represents J(k-1)\n\n    for i in range(1, n + 1):\n        if i == 0:\n            current = 0\n        elif i == 1:\n            current = 1\n        else:\n            current = prev + 2 * prev_prev\n            prev_prev = prev\n            prev = current\n    return prev"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(input_array: list) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    An empty array or an array with one element is considered a valid min-heap.\n    \"\"\"\n    n = len(input_array)\n\n    if n <= 1:\n        return True\n\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        if left_child_idx < n and input_array[i] > input_array[left_child_idx]:\n            return False\n\n        if right_child_idx < n and input_array[i] > input_array[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/753", "solution": "def min_k(tuple_list: list[tuple[str, int]], k: int) -> list[tuple[str, int]]:\n    \"\"\"\n    Identifies and returns the k tuples with the smallest second element\n    from the input list, sorted in ascending order by their second element.\n    \"\"\"\n    if k <= 0 or not tuple_list:\n        return []\n\n    sorted_list = sorted(tuple_list, key=lambda x: x[1])\n    result = sorted_list[:k]\n    return result"}
{"task_id": "Mbpp/749", "solution": "def sort_numeric_strings(numeric_string_list: list[str]) -> list[int | float]:\n    \"\"\"\n    Converts a list of numeric strings to numbers and sorts them numerically in ascending order.\n    Handles both integer and float string representations.\n    \"\"\"\n    converted_numbers = []\n    for s in numeric_string_list:\n        try:\n            num = int(s)\n        except ValueError:\n            num = float(s)\n        converted_numbers.append(num)\n\n    return sorted(converted_numbers)"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Finds common elements from three lists that appear at the same index.\n\n    Returns a new list containing elements that are present at the same index\n    across all three input lists.\n    \"\"\"\n    result_list = []\n    min_length = min(len(list1), len(list2), len(list3))\n\n    for i in range(min_length):\n        if list1[i] == list2[i] and list2[i] == list3[i]:\n            result_list.append(list1[i])\n\n    return result_list"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(list_of_numbers: list) -> (int | float | None):\n    \"\"\"\n    Finds the second smallest distinct number in a list.\n    Returns None if a second smallest distinct number does not exist.\n    \"\"\"\n    distinct_numbers = set(list_of_numbers)\n    sorted_distinct_numbers = sorted(list(distinct_numbers))\n\n    if len(sorted_distinct_numbers) >= 2:\n        return sorted_distinct_numbers[1]\n    else:\n        return None"}
{"task_id": "Mbpp/757", "solution": "def _reverse_string(s: str) -> str:\n    \"\"\"Returns the reverse of the input string.\"\"\"\n    return s[::-1]\n\ndef _is_reverse(s1: str, s2: str) -> bool:\n    \"\"\"Checks if s1 is the reverse of s2.\"\"\"\n    return s1 == _reverse_string(s2)\n\ndef count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"Counts unique pairs of reverse strings in the given list.\"\"\"\n    found_pairs = set()\n    n = len(string_list)\n\n    for i in range(n):\n        s1 = string_list[i]\n        for j in range(i + 1, n): # Iterate through subsequent strings to find unique pairs\n            s2 = string_list[j]\n            if _is_reverse(s1, s2):\n                found_pairs.add(frozenset({s1, s2}))\n                \n    return len(found_pairs)"}
{"task_id": "Mbpp/759", "solution": "import re\n\ndef is_decimal(input_string: str) -> bool:\n    \"\"\"\n    Checks if the input string represents a decimal number with exactly two digits after the decimal point.\n    \"\"\"\n    # Pattern for an optional sign, one or more digits, a decimal point, and exactly two digits.\n    pattern = r\"^-?\\d+\\.\\d{2}$\"\n    return bool(re.fullmatch(pattern, input_string))"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(arr: tuple, n: int) -> int:\n    \"\"\"\n    Finds the minimum difference between any two elements in a given array.\n    This is achieved by sorting the array and then iterating through adjacent elements.\n    \"\"\"\n    if n < 2:\n        return 0 # Or handle as per specific requirements, 0 for no difference possible\n\n    sorted_arr = sorted(arr)\n    min_diff = float('inf')\n\n    for i in range(n - 1):\n        min_diff = min(min_diff, sorted_arr[i+1] - sorted_arr[i])\n\n    return min_diff"}
{"task_id": "Mbpp/758", "solution": "import collections\nimport typing\n\ndef unique_sublists(input_list: typing.List[typing.List[typing.Any]]) -> typing.Dict[typing.Tuple[typing.Any, ...], int]:\n    # Convert each sublist to a tuple and count their occurrences.\n    # collections.Counter is used for efficient frequency counting.\n    tuple_representations = [tuple(sublist) for sublist in input_list]\n    return collections.Counter(tuple_representations)"}
