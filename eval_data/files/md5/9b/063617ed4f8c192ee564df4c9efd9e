{"task_id": "Mbpp/293", "solution": "import math\n\ndef otherside_rightangle(side1: float, side2: float) -> float:\n    \"\"\"\n    Calculates the length of the third side of a right-angled triangle.\n    It assumes the larger of the two inputs is the hypotenuse if possible, otherwise it calculates the hypotenuse.\n    \"\"\"\n    # Determine if inputs are legs or one is a hypotenuse.\n    # If side1 or side2 could be the hypotenuse (i.e., it's larger than the other side)\n    # and subtracting the square of the smaller side from its square is positive,\n    # then calculate a leg. Otherwise, calculate the hypotenuse.\n    if side1 >= side2 and (side1**2 - side2**2) >= 0:\n        return math.sqrt(side1**2 - side2**2)\n    elif side2 > side1 and (side2**2 - side1**2) >= 0:\n        return math.sqrt(side2**2 - side1**2)\n    else:\n        # If the above conditions aren't met, it implies both inputs are legs,\n        # or a hypotenuse calculation is more appropriate (e.g., if inputs are equal).\n        return math.sqrt(side1**2 + side2**2)"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr: list) -> int:\n    \"\"\"\n    Calculates the total number of inversions in the given array.\n    An inversion exists for any pair of indices (i, j) such that i < j\n    and arr[i] > arr[j].\n    \"\"\"\n    inversions = 0\n    n = len(arr)\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            if arr[i] > arr[j]:\n                inversions += 1\n    return inversions"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(nested_list: list) -> list:\n    \"\"\"\n    Flattens a given nested list structure into a single, non-nested sequence.\n    This function handles lists containing integers and nested lists of integers.\n    \"\"\"\n    result = []\n    for item in nested_list:\n        if isinstance(item, list):\n            result.extend(flatten_list(item))\n        else:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/299", "solution": "import collections\n\ndef max_aggregate(data: list[tuple[str, int]]) -> tuple[str | None, int]:\n    \"\"\"\n    Calculates the maximum aggregate score from a list of name-score tuples.\n    Returns (None, 0) if the input list is empty.\n    \"\"\"\n    aggregated_scores = collections.defaultdict(int)\n\n    for name, score in data:\n        aggregated_scores[name] += score\n\n    if not aggregated_scores:\n        return (None, 0)\n\n    max_name = None\n    max_score = 0\n\n    for name, score in aggregated_scores.items():\n        if score > max_score:\n            max_score = score\n            max_name = name\n            \n    return (max_name, max_score)"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(input_dict: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of dictionaries within input_dict.\n    A dictionary with no nested dictionaries has a depth of 1.\n    \"\"\"\n    max_depth = 1\n    for value in input_dict.values():\n        if isinstance(value, dict):\n            max_depth = max(max_depth, 1 + dict_depth(value))\n    return max_depth"}
{"task_id": "Mbpp/305", "solution": "def start_withp(input_list: list[str]) -> tuple[str | None, str | None]:\n    \"\"\"\n    Extracts the first two words starting with 'p' (case-insensitive) from a list of strings.\n    Returns them as a tuple, padding with None if fewer than two words are found.\n    \"\"\"\n    collected_words = []\n    for s in input_list:\n        words = s.split()\n        for word in words:\n            if word.lower().startswith('p'):\n                collected_words.append(word)\n                if len(collected_words) == 2:\n                    return tuple(collected_words)\n\n    # Pad with None if fewer than two words were found\n    while len(collected_words) < 2:\n        collected_words.append(None)\n\n    return tuple(collected_words)"}
{"task_id": "Mbpp/300", "solution": "import math\n\ndef count_binary_seq(n: int) -> int:\n    \"\"\"\n    Calculates the count of binary sequences of length 2n where the sum of the first n bits\n    equals the sum of the last n bits. This is computed by summing the square of binomial coefficients.\n    \"\"\"\n    total_count = 0\n    # Iterate through all possible sums 'k' for the first 'n' bits, from 0 to n.\n    for k in range(n + 1):\n        # Calculate C(n, k), the number of ways to choose 'k' ones out of 'n' bits.\n        # The total ways for sum 'k' in both halves is C(n, k) * C(n, k).\n        combinations_for_k = math.comb(n, k)\n        total_count += combinations_for_k * combinations_for_k\n    \n    return total_count"}
