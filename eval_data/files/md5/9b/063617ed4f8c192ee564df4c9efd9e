{"task_id": "Mbpp/445", "solution": "def index_multiplication(\n    tuple1: tuple[tuple[int, ...], ...],\n    tuple2: tuple[tuple[int, ...], ...]\n) -> tuple[tuple[int, ...], ...]:\n    \"\"\"\n    Performs index-wise multiplication of elements from two input tuples of tuples.\n    Raises ValueError if tuples or their inner tuples have mismatched lengths.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n    result_outer_tuple_list = []\n    for inner_t1, inner_t2 in zip(tuple1, tuple2):\n        if len(inner_t1) != len(inner_t2):\n            raise ValueError(\"Inner tuples must have the same length.\")\n\n        result_inner_tuple_list = []\n        for elem1, elem2 in zip(inner_t1, inner_t2):\n            result_inner_tuple_list.append(elem1 * elem2)\n        result_outer_tuple_list.append(tuple(result_inner_tuple_list))\n\n    return tuple(result_outer_tuple_list)"}
{"task_id": "Mbpp/440", "solution": "import re\nimport string\n\ndef _strip_punctuation(word: str) -> str:\n    \"\"\"Removes leading and trailing punctuation from a word.\"\"\"\n    return word.strip(string.punctuation)\n\ndef _is_adverb(word: str) -> bool:\n    \"\"\"Determines if a given word is an adverb using heuristics and a small list.\"\"\"\n    if not word:\n        return False\n    word_lower = word.lower()\n    \n    # Common adverbs that don't always end in -ly\n    common_adverbs = {\n        \"very\", \"well\", \"here\", \"now\", \"always\", \"often\", \"seldom\", \"fast\", \"hard\",\n        \"late\", \"soon\", \"then\", \"there\", \"today\", \"tomorrow\", \"yesterday\", \"down\",\n        \"up\", \"out\", \"in\", \"still\", \"just\", \"rather\", \"too\", \"almost\", \"already\",\n        \"away\", \"back\", \"even\", \"ever\", \"further\", \"instead\", \"much\", \"never\", \"only\",\n        \"quite\", \"really\", \"so\", \"sometimes\", \"usually\", \"where\", \"why\", \"how\", \"when\",\n        \"ago\", \"else\", \"enough\", \"far\", \"little\", \"more\", \"most\", \"next\", \"per\",\n        \"right\", \"straight\", \"together\", \"tonight\", \"too\", \"under\", \"upstairs\",\n        \"daily\", \"early\", \"exactly\"\n    }\n    if word_lower in common_adverbs:\n        return True\n    \n    # Heuristic: check for -ly ending. Exclude very short words and common adjectives.\n    if len(word_lower) > 2 and word_lower.endswith('ly'):\n        # List of common adjectives that also end in -ly (not exhaustive)\n        adjective_like_ly = {\"friendly\", \"lovely\", \"ugly\", \"silly\", \"lonely\", \"holy\", \"ghastly\", \"lively\"}\n        if word_lower not in adjective_like_ly:\n            return True\n            \n    return False\n\ndef _find_word_positions(sentence: str, word_to_find: str, search_start_index: int) -> tuple[int, int] | None:\n    \"\"\"Locates the 0-indexed start and end positions of a specific word.\"\"\"\n    start_pos = sentence.find(word_to_find, search_start_index)\n    if start_pos != -1:\n        end_pos = start_pos + len(word_to_find)\n        return (start_pos, end_pos)\n    return None\n\ndef find_adverb_position(sentence: str) -> tuple[int, int, str] | None:\n    \"\"\"Finds the first adverb and its 0-indexed start/end positions in a sentence.\"\"\"\n    current_search_index = 0\n    words = sentence.split(' ')\n\n    for original_word_with_punct in words:\n        if not original_word_with_punct:\n            # Handle multiple spaces: advance current_search_index by one for each space\n            current_search_index += 1\n            continue\n\n        # Find the actual start position of the current word in the original sentence\n        word_start_in_sentence = sentence.find(original_word_with_punct, current_search_index)\n        \n        if word_start_in_sentence == -1:\n            # If the word is not found from current_search_index, it's an unexpected state.\n            # To prevent issues, advance index past where it should have been.\n            current_search_index += len(original_word_with_punct) + 1 \n            continue\n\n        cleaned_word = _strip_punctuation(original_word_with_punct)\n\n        if _is_adverb(cleaned_word):\n            # Adverb found, use _find_word_positions to get its exact span\n            positions = _find_word_positions(sentence, original_word_with_punct, current_search_index)\n            if positions: # Should always be True if word_start_in_sentence was not -1\n                start_pos, end_pos = positions\n                return (start_pos, end_pos, cleaned_word)\n\n        # Update current_search_index to start searching for the next word after the current one\n        current_search_index = word_start_in_sentence + len(original_word_with_punct)\n\n        # Skip any subsequent spaces to point current_search_index to the start of the next non-space character\n        while current_search_index < len(sentence) and sentence[c