{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    # Calculates the nth polite number.\n    # Polite numbers are positive integers that are not powers of two.\n    def _is_power_of_two_helper(num: int) -> bool:\n        return num > 0 and (num & (num - 1) == 0)\n\n    if n <= 0:\n        return -1 # Or raise an error as per design context, but requirements say not to.\n\n    polite_count = 0\n    current_num = 1\n    while True:\n        if not _is_power_of_two_helper(current_num):\n            polite_count += 1\n            if polite_count == n:\n                return current_num\n        current_num += 1"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list: list) -> list[tuple]:\n    \"\"\"\n    Returns a list of all pairs of consecutive items in a given list.\n    Handles lists with fewer than two items by returning an empty list.\n    \"\"\"\n    if len(input_list) < 2:\n        return []\n    \n    result = []\n    for i in range(len(input_list) - 1):\n        result.append((input_list[i], input_list[i+1]))\n    return result"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth power of the first n odd natural numbers.\n    \"\"\"\n    total_sum = 0\n    for i in range(n):\n        odd_num = 2 * i + 1\n        total_sum += odd_num ** 4\n    return total_sum"}
{"task_id": "Mbpp/771", "solution": "OPENING_BRACKETS = {'(', '{', '['}\nCLOSING_BRACKETS = {')', '}', ']'}\nBRACKET_PAIRS = {'(': ')', '{': '}', '[': ']'}\n\ndef check_expression(expression_string: str) -> bool:\n    \"\"\"Checks if the given expression string has balanced brackets.\"\"\"\n    stack = []\n    for char in expression_string:\n        if char in OPENING_BRACKETS:\n            stack.append(char)\n        elif char in CLOSING_BRACKETS:\n            if not stack:\n                return False\n            last_open_bracket = stack.pop()\n            if BRACKET_PAIRS.get(last_open_bracket) != char:\n                return False\n    return not stack"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1: list, list2: list) -> list:\n    \"\"\"\n    Calculates the difference between two lists, preserving order.\n    Returns elements present in list1 but not in list2.\n    \"\"\"\n    set2 = set(list2)\n    result_list = []\n    for item in list1:\n        if item not in set2:\n            result_list.append(item)\n    return result_list"}
{"task_id": "Mbpp/777", "solution": "from collections import Counter\n\ndef find_sum(input_list: list) -> int:\n    \"\"\"Calculates the sum of non-repeated elements in a given list.\n\n    It uses a Counter to efficiently track element frequencies.\n    \"\"\"\n    counts = Counter(input_list)\n    total_sum = 0\n    for element, count in counts.items():\n        if count == 1:\n            total_sum += element\n    return total_sum"}
