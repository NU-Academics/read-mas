{"task_id": "Mbpp/803", "solution": "import math\n\ndef is_perfect_square(number: int) -> bool:\n    \"\"\"\n    Checks if the given non-negative integer is a perfect square.\n    Returns True if it is, False otherwise.\n    \"\"\"\n    if number < 0:\n        return False\n    \n    # Calculate the integer square root.\n    root = math.isqrt(number)\n    \n    # Check if the square of the root equals the original number.\n    return root * root == number"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Finds the maximum consecutive run of uppercase characters in the given string.\n\n    Returns the length of the maximum consecutive run of uppercase characters.\n    \"\"\"\n    current_run_length = 0\n    max_run_length = 0\n    for char in input_string:\n        if 'A' <= char <= 'Z':\n            current_run_length += 1\n        else:\n            current_run_length = 0\n        max_run_length = max(max_run_length, current_run_length)\n    return max_run_length"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(list_of_lists: list[list[int | float]]) -> list[int | float]:\n    \"\"\"\n    Returns the list from a list of lists whose sum of elements is the highest.\n    If multiple lists have the same highest sum, the first encountered list is returned.\n    \"\"\"\n    max_sum = float('-inf')\n    result_list = []\n\n    for inner_list in list_of_lists:\n        current_sum = sum(inner_list)\n        if current_sum > max_sum:\n            max_sum = current_sum\n            result_list = inner_list\n            \n    return result_list"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers: list[int]) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    An optimization: if any number in the list is even, the product will be even.\n    \"\"\"\n    for number in numbers:\n        if number % 2 == 0:\n            return True\n    \n    # If no even number was found, calculate the product to check if it's even.\n    # This scenario would only happen if all numbers were odd, making their product odd.\n    # However, the problem states \"product of numbers in a list\".\n    # An empty list's product is conventionally 1 (odd).\n    if not numbers:\n        return False # Product of empty list is 1, which is odd.\n\n    product = 1\n    for number in numbers:\n        product *= number\n    \n    return product % 2 == 0"}
