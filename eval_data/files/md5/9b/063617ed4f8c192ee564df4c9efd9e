{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(numbers: list) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist in the given list of numbers.\n    This implementation uses a variant of Kadane's algorithm.\n    \"\"\"\n    global_max = float('-inf')\n    current_max = 0\n\n    for num in numbers:\n        current_max = max(num, current_max + num)\n        global_max = max(global_max, current_max)\n    \n    return global_max"}
{"task_id": "Mbpp/558", "solution": "def _pad_numbers(num1_str: str, num2_str: str) -> tuple[str, str]:\n    \"\"\"Pads the shorter of two string representations of numbers with leading zeros.\"\"\"\n    max_len = max(len(num1_str), len(num2_str))\n    padded_num1 = num1_str.zfill(max_len)\n    padded_num2 = num2_str.zfill(max_len)\n    return padded_num1, padded_num2\n\ndef digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"Calculates the sum of per-digit absolute differences between two integers.\"\"\"\n    num1_str = str(num1)\n    num2_str = str(num2)\n\n    padded_num1, padded_num2 = _pad_numbers(num1_str, num2_str)\n\n    total_sum = 0\n    for i in range(len(padded_num1)):\n        digit1 = int(padded_num1[i])\n        digit2 = int(padded_num2[i])\n        total_sum += abs(digit1 - digit2)\n\n    return total_sum"}
{"task_id": "Mbpp/564", "solution": "def count_Pairs(input_list: list[int]) -> int:\n    \"\"\"\n    Counts the number of unordered pairs (x, y) from input_list such that x != y.\n    It iterates through all possible unique pairs and increments a counter if elements are unequal.\n    \"\"\"\n    count = 0\n    n = len(input_list)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if input_list[i] != input_list[j]:\n                count += 1\n    return count"}
