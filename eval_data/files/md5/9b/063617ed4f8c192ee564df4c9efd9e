{"task_id": "Mbpp/632", "solution": "def move_zero(input_list: list) -> list:\n    \"\"\"\n    Moves all zero elements to the end of the given list while maintaining\n    the relative order of non-zero elements.\n    \"\"\"\n    non_zero_elements = []\n    zero_count = 0\n    for element in input_list:\n        if element == 0:\n            zero_count += 1\n        else:\n            non_zero_elements.append(element)\n    non_zero_elements.extend([0] * zero_count)\n    return non_zero_elements"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(list_of_numbers: list[int], list_length: int) -> int:\n    \"\"\"\n    Calculates the sum of XOR of all unique pairs of numbers in the given list.\n    Returns 0 if the list has fewer than two elements.\n    \"\"\"\n    total_xor_sum = 0\n\n    if list_length < 2:\n        return 0\n\n    for i in range(list_length):\n        for j in range(i + 1, list_length):\n            num1 = list_of_numbers[i]\n            num2 = list_of_numbers[j]\n            pair_xor_result = num1 ^ num2\n            total_xor_sum += pair_xor_result\n\n    return total_xor_sum"}
{"task_id": "Mbpp/635", "solution": "def heap_sort(list_of_numbers: list) -> list:\n    \"\"\"Sorts a list of numbers using the heap sort algorithm.\"\"\"\n    arr = list_of_numbers[:] # Create a copy to avoid modifying the original list\n\n    n = len(arr)\n\n    # Build a maxheap\n    # The _heapify function is defined inline within heap_sort to align with the \"no helper not defined inline\" rule.\n    def _heapify(arr_inner: list, n_inner: int, i_inner: int) -> None:\n        \"\"\"Maintains the max-heap property in a subtree rooted at index i_inner.\"\"\"\n        largest = i_inner  # Initialize largest as root\n        l = 2 * i_inner + 1  # left = 2*i_inner + 1\n        r = 2 * i_inner + 2  # right = 2*i_inner + 2\n\n        # See if left child of root exists and is greater than root\n        if l < n_inner and arr_inner[l] > arr_inner[largest]:\n            largest = l\n\n        # See if right child of root exists and is greater than current largest\n        if r < n_inner and arr_inner[r] > arr_inner[largest]:\n            largest = r\n\n        # Change root, if needed\n        if largest != i_inner:\n            arr_inner[i_inner], arr_inner[largest] = arr_inner[largest], arr_inner[i_inner]  # swap\n\n            # Heapify the root.\n            _heapify(arr_inner, n_inner, largest)\n\n    # _build_max_heap is integrated into the main heap_sort flow\n    # Build a maxheap.\n    # Elements from (n//2 - 1) down to 0 are the non-leaf nodes.\n    for i in range(n // 2 - 1, -1, -1):\n        _heapify(arr, n, i)\n\n    # One by one extract elements\n    for i in range(n - 1, 0, -1):\n        arr[i], arr[0] = arr[0], arr[i]  # swap\n        _heapify(arr, i, 0) # Call _heapify on the reduced heap\n\n    return arr"}
