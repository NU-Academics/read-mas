{"task_id": "Mbpp/62", "solution": "from typing import List, Union\n\ndef smallest_num(numbers: List[Union[int, float]]) -> Union[int, float, None]:\n    \"\"\"Finds the smallest number in a list of numbers.\n\n    Returns the smallest number in the list, or None if the list is empty.\n    \"\"\"\n    if not numbers:\n        return None\n    \n    smallest = numbers[0]\n    for num in numbers:\n        if num < smallest:\n            smallest = num\n    return smallest"}
{"task_id": "Mbpp/61", "solution": "def _calculate_digit_sum(s: str) -> int:\n    \"\"\"Calculates the sum of numerical values of digits in a given string.\n    Assumes the input string contains only digits.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        total_sum += int(char)\n    return total_sum\n\ndef count_Substrings(input_string: str) -> int:\n    \"\"\"Counts substrings in an input string where the sum of digits equals the substring's length.\"\"\"\n    count = 0\n    n = len(input_string)\n\n    for i in range(n):\n        for j in range(i, n):\n            substring = input_string[i : j + 1]\n            sub_length = len(substring)\n            sub_digit_sum = _calculate_digit_sum(substring)\n\n            if sub_length == sub_digit_sum:\n                count += 1\n    return count"}
{"task_id": "Mbpp/63", "solution": "def max_difference(tuple_list: list) -> (int | float):\n    \"\"\"\n    Calculates the maximum absolute difference between elements of all valid pairs\n    within a given list of tuples, skipping invalid items.\n    \"\"\"\n    max_diff = 0\n\n    for item in tuple_list:\n        if isinstance(item, tuple) and len(item) == 2:\n            if isinstance(item[0], (int, float)) and isinstance(item[1], (int, float)):\n                current_diff = abs(item[0] - item[1])\n                max_diff = max(max_diff, current_diff)\n    return max_diff"}
