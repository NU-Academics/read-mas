{"task_id": "Mbpp/772", "solution": "class Word:\n    \"\"\"Encapsulates a word's value and provides methods for length comparison.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n        self._length = len(value)\n\n    def get_value(self) -> str:\n        \"\"\"Returns the string value of the word.\"\"\"\n        return self._value\n\n    def get_length(self) -> int:\n        \"\"\"Returns the length of the word.\"\"\"\n        return self._length\n\n    def is_length_k(self, k: int) -> bool:\n        \"\"\"Checks if the word's length is equal to k.\"\"\"\n        return self._length == k\n\ndef remove_length(input_string: str, k: int) -> str:\n    \"\"\"Removes all words of a specified length k from a given input string.\"\"\"\n    words = input_string.split()\n    filtered_words = []\n    for raw_word in words:\n        word_obj = Word(raw_word)\n        if not word_obj.is_length_k(k):\n            filtered_words.append(word_obj.get_value())\n    return ' '.join(filtered_words)"}
{"task_id": "Mbpp/775", "solution": "def odd_position(input_list: list[int]) -> bool:\n    \"\"\"Checks if every number at an odd index in the input_list is an odd number.\n\n    Args:\n        input_list: A list of integers.\n\n    Returns:\n        True if all numbers at odd indices are odd, False otherwise.\n    \"\"\"\n    for index, value in enumerate(input_list):\n        if index % 2 != 0:  # Check if the current index is odd\n            if value % 2 == 0:  # If index is odd, check if the number itself is even\n                return False  # An even number found at an odd index\n    return True  # All numbers at odd indices were odd"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list) -> list:\n    \"\"\"\n    Packs consecutive duplicates of a given list elements into sublists.\n    Args:\n        input_list: The list of elements to process. Elements must be comparable.\n    Returns:\n        A new list of sublists, where each sublist contains consecutive duplicate elements.\n    \"\"\"\n    if not input_list:\n        return []\n\n    packed_list = []\n    current_sublist = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] == current_sublist[0]:\n            current_sublist.append(input_list[i])\n        else:\n            packed_list.append(current_sublist)\n            current_sublist = [input_list[i]]\n\n    packed_list.append(current_sublist)\n    return packed_list"}
