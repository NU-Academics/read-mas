{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from a prefix until the ith index,\n    also including the kth element (where k > i).\n    \"\"\"\n    # dp[j] stores the maximum sum of an increasing subsequence ending at index j within the prefix (0 to i-1)\n    dp = [0] * i\n\n    # Initialize dp array: each element itself forms an increasing subsequence of sum arr[j]\n    for j in range(i):\n        dp[j] = arr[j]\n\n    # Calculate max sum increasing subsequence for each element in the prefix (0 to i-1)\n    for j in range(i):\n        for p in range(j):\n            if arr[j] > arr[p]:\n                dp[j] = max(dp[j], dp[p] + arr[j])\n\n    # Find the maximum sum from the prefix (0 to i-1) that can precede arr[k]\n    max_prefix_sum = 0\n    for j in range(i):\n        if arr[j] < arr[k]:\n            max_prefix_sum = max(max_prefix_sum, dp[j])\n    \n    # The final result is the max_prefix_sum plus the required kth element\n    return max_prefix_sum + arr[k]"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(input_integer: int) -> int:\n    \"\"\"\n    Identifies the leftmost unset bit (0) in an integer and sets it to 1.\n    If all significant bits are set, it sets the next available bit to the left.\n    \"\"\"\n    # Determine the number of bits needed to represent the integer.\n    num_bits = input_integer.bit_length()\n\n    # Iterate from the highest potentially significant bit down to the least significant bit (0).\n    for i in range(num_bits - 1, -1, -1):\n        # Check if the i-th bit is 0.\n        if not (input_integer >> i) & 1:\n            # If it's 0, this is the leftmost unset bit. Set it to 1 and return the new integer.\n            return input_integer | (1 << i)\n    \n    # If the loop completes, all bits from 0 up to (num_bits - 1) were already set.\n    # In this case, the leftmost unset bit is at position num_bits. Set this bit.\n    return input_integer | (1 << num_bits)"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"Calculates the highest power of 2 that is less than or equal to n.\n    Returns 1 for n <= 0, as 2^0 = 1 is the smallest positive power of 2.\"\"\"\n    if n <= 0:\n        return 1\n\n    power = 1\n    while (power << 1) <= n:\n        power <<= 1\n    return power"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    \"\"\"\n    Calculates the n'th Lucas number.\n    Raises ValueError if n is negative.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n\n    a, b = 2, 1\n    for _ in range(2, n + 1):\n        a, b = b, a + b\n    return b"}
