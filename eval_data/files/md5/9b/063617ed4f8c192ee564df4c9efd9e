{"task_id": "Mbpp/807", "solution": "def first_odd(numbers: list) -> int | None:\n    \"\"\"\n    Finds the first odd number in a list of numbers.\n    Returns None if no odd number is found.\n    \"\"\"\n    for number in numbers:\n        if number % 2 != 0:\n            return int(number)\n    return None"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string: str) -> str:\n    \"\"\"Toggles the case of all alphabetic characters in a string.\"\"\"\n    toggled_chars = []\n    for char in input_string:\n        if char.isalpha():\n            if char.islower():\n                toggled_chars.append(char.upper())\n            else: # char is uppercase\n                toggled_chars.append(char.lower())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/108", "solution": "def merge_sorted_list(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Merges three input lists into a single list and sorts all elements in ascending order.\n    Returns a new list containing all elements from the input lists, sorted.\n    \"\"\"\n    combined_list = list1 + list2 + list3\n    return sorted(combined_list)"}
