{"task_id": "Mbpp/113", "solution": "def check_integer(input_string: str) -> bool:\n    \"\"\"Checks if the input string represents a valid integer, without leading/trailing spaces.\"\"\"\n    # An empty string cannot be an integer.\n    if not input_string:\n        return False\n\n    # Check for leading or trailing whitespace.\n    # The requirement specifies \"strings with spaces\" should return False,\n    # and int() naturally strips spaces, so we must check for them explicitly.\n    if input_string != input_string.strip():\n        return False\n\n    # Attempt to convert the string to an integer.\n    # This handles positive, negative, and zero integers,\n    # and correctly rejects floats or non-numeric strings.\n    try:\n        int(input_string)\n        return True\n    except ValueError:\n        return False"}
{"task_id": "Mbpp/120", "solution": "def find_max_absolute_product(list_of_tuples: list[tuple[int | float, int | float]]) -> int | float:\n    \"\"\"\n    Calculates the maximum absolute product between numbers in pairs of tuples.\n    Returns the maximum absolute product found, or 0 if the input list is empty.\n    \"\"\"\n    if not list_of_tuples:\n        return 0\n\n    max_abs_product = 0.0 # Initialize as float to handle float results\n\n    for num1, num2 in list_of_tuples:\n        product = num1 * num2\n        abs_product = abs(product)\n        if abs_product > max_abs_product:\n            max_abs_product = abs_product\n            \n    return max_abs_product"}
{"task_id": "Mbpp/119", "solution": "def search(array: list[int]) -> int:\n    \"\"\"Finds the element that appears only once in a sorted array.\n\n    Args:\n        array: A sorted list of integers where exactly one element appears once.\n\n    Returns:\n        The integer element that appears only once.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n\n    while low < high:\n        mid = low + (high - low) // 2\n\n        # Ensure mid always points to an even index.\n        # This allows comparing array[mid] with array[mid+1] to check for pairs.\n        if mid % 2 == 1:\n            mid -= 1\n\n        # If array[mid] and array[mid+1] are a pair,\n        # the unique element must be in the subarray to the right of mid+1.\n        if array[mid] == array[mid + 1]:\n            low = mid + 2\n        # Otherwise, array[mid] is either the unique element or\n        # the unique element is in the subarray to the left of or including mid.\n        else:\n            high = mid\n    \n    return array[low]"}
{"task_id": "Mbpp/123", "solution": "import math\n\n_divisor_sums_cache = {}\n\ndef _sum_proper_divisors(n: int) -> int:\n    \"\"\"Computes the sum of all positive divisors of `n` excluding `n` itself, using a cache.\"\"\"\n    if n in _divisor_sums_cache:\n        return _divisor_sums_cache[n]\n\n    if n <= 1:\n        _divisor_sums_cache[n] = 0\n        return 0\n\n    s = 1  # 1 is always a proper divisor\n    for i in range(2, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            s += i\n            if i != n // i:\n                s += n // i\n    _divisor_sums_cache[n] = s\n    return s\n\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"Calculates the sum of all amicable numbers n such that 1 <= n <= limit.\"\"\"\n    amicable_numbers_set = set()\n    global _divisor_sums_cache # Clear cache for each new call, as per sequence diagram\n\n    _divisor_sums_cache = {} # Reinitialize cache for a fresh run\n\n    for n in range(1, limit + 1):\n        sum_a = _sum_proper_divisors(n)\n\n        # Check for amicable pair (n, sum_a)\n        # Conditions: sum_a must be greater than n to avoid checking pairs twice (e.g., (220, 284) and (284, 220))\n        # and sum_a must be within the limit\n        if sum_a > n and sum_a <= limit:\n            sum_b = _sum_proper_divisors(sum_a)\n            if sum_b == n:\n                amicable_numbers_set.add(n)\n                amicable_numbers_set.add(sum_a)\n    \n    return sum(amicable_numbers_set)"}
