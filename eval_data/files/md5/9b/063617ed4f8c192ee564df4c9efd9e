{"task_id": "Mbpp/71", "solution": "def comb_sort(input_list: list) -> list:\n    \"\"\"\n    Sorts a list of comparable elements in ascending order using the Comb Sort algorithm.\n    Returns a new list with the sorted elements; the original list remains unchanged.\n    \"\"\"\n    n = len(input_list)\n    if n == 0:\n        return []\n\n    arr = list(input_list)  # Create a copy to ensure immutability\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        gap = int(gap / shrink_factor)\n        if gap < 1:\n            gap = 1\n\n        swapped = False\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    return arr"}
{"task_id": "Mbpp/75", "solution": "def find_tuples(list_of_tuples: list[tuple[int, ...]], k: int) -> list[tuple[int, ...]]:\n    \"\"\"\n    Filters a list of tuples, returning only those where all elements are divisible by a given integer k.\n    \"\"\"\n    result_list = []\n    for current_tuple in list_of_tuples:\n        all_elements_divisible = True\n        for element in current_tuple:\n            if element % k != 0:\n                all_elements_divisible = False\n                break\n        if all_elements_divisible:\n            result_list.append(current_tuple)\n    return result_list"}
{"task_id": "Mbpp/74", "solution": "from typing import List, Any, Dict\n\n\ndef _generate_pattern(arr: List[Any]) -> List[int]:\n    \"\"\"\n    Generates a numerical pattern representation for a single input array.\n    Each unique element is mapped to a sequential integer based on its first appearance.\n    \"\"\"\n    if not arr:\n        return []\n\n    pattern_map: Dict[Any, int] = {}\n    pattern_sequence: List[int] = []\n    next_code = 0\n\n    for element in arr:\n        if element not in pattern_map:\n            pattern_map[element] = next_code\n            next_code += 1\n        pattern_sequence.append(pattern_map[element])\n\n    return pattern_sequence\n\n\ndef is_samepatterns(array1: List[Any], array2: List[Any]) -> bool:\n    \"\"\"\n    Checks whether two input arrays follow the same sequence pattern.\n    The arrays follow the same pattern if they have the same length and their generated patterns are identical.\n    \"\"\"\n    if len(array1) != len(array2):\n        return False\n\n    pattern1 = _generate_pattern(array1)\n    pattern2 = _generate_pattern(array2)\n\n    return pattern1 == pattern2"}
