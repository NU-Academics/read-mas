{"task_id": "Mbpp/593", "solution": "class Octet:\n    \"\"\"Represents a single octet of an IP address and provides logic to remove leading zeros.\"\"\"\n    def __init__(self, octet_string: str):\n        self._value = octet_string\n\n    def remove_leading_zeros(self) -> str:\n        \"\"\"Converts the octet string to an integer, then back to a string, effectively removing leading zeros.\"\"\"\n        return str(int(self._value))\n\nclass IPAddress:\n    \"\"\"Encapsulates an IP address, manages its octets, and orchestrates the process of removing leading zeros.\"\"\"\n    def __init__(self, ip_string: str):\n        self._value = ip_string\n\n    def remove_leading_zeros(self) -> str:\n        \"\"\"Splits the IP address into octets, processes each octet, and reconstructs the cleaned IP address string.\"\"\"\n        octets_str = self._value.split('.')\n        cleaned_octets = []\n        for octet_str in octets_str:\n            octet = Octet(octet_str)\n            cleaned_octets.append(octet.remove_leading_zeros())\n        return \".\".join(cleaned_octets)\n\ndef removezero_ip(ip_address_string: str) -> str:\n    \"\"\"Accepts an IP address string and returns it with leading zeros removed from its octets.\"\"\"\n    ip_address = IPAddress(ip_address_string)\n    return ip_address.remove_leading_zeros()"}
{"task_id": "Mbpp/589", "solution": "import math\n\ndef perfect_squares(lower_bound: int, upper_bound: int) -> list[int]:\n    \"\"\"\n    Finds all perfect squares within the inclusive range [lower_bound, upper_bound].\n    Returns the perfect squares in ascending order.\n    \"\"\"\n    perfect_squares_list = []\n    # Determine the starting integer whose square might be in the range, ensuring non-negative roots.\n    start_sqrt = math.isqrt(max(0, lower_bound))\n\n    # Iterate from this square root upwards, adding squares that fall within the bounds.\n    i = start_sqrt\n    while i * i <= upper_bound:\n        square = i * i\n        if square >= lower_bound:\n            perfect_squares_list.append(square)\n        i += 1\n    return perfect_squares_list"}
{"task_id": "Mbpp/594", "solution": "def _is_even(number: int) -> bool:\n    \"\"\"Determines if a given integer is even.\"\"\"\n    return number % 2 == 0\n\ndef _is_odd(number: int) -> bool:\n    \"\"\"Determines if a given integer is odd.\"\"\"\n    return number % 2 != 0\n\ndef diff_even_odd(input_list: list[int]) -> int:\n    \"\"\"\n    Finds the difference of the first even and first odd number in a given list.\n    The result is calculated as (first even number - first odd number).\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for number in input_list:\n        if first_even is None and _is_even(number):\n            first_even = number\n        \n        if first_odd is None and _is_odd(number):\n            first_odd = number\n            \n        if first_even is not None and first_odd is not None:\n            break\n            \n    return first_even - first_odd"}
{"task_id": "Mbpp/592", "solution": "import math\n\ndef _binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"\n    Calculates the binomial coefficient C(n, k).\n    Handles edge cases where k is out of bounds by returning 0.\n    \"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    \n    # Optimization: C(n, k) = C(n, n-k)\n    if k > n // 2:\n        k = n - k\n    \n    # Calculate using factorials\n    numerator = math.factorial(n)\n    denominator = math.factorial(k) * math.factorial(n - k)\n    return numerator // denominator\n\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the product of consecutive binomial coefficients for a given n.\n    This is equivalent to C(2n, n-1).\n    \"\"\"\n    n_val = 2 * n\n    k_val = n - 1\n    \n    return _binomial_coefficient(n_val, k_val)"}
{"task_id": "Mbpp/591", "solution": "class ListSwapper:\n    \"\"\"Encapsulates a list and provides methods to interchange its first and last elements.\"\"\"\n\n    def __init__(self, input_list: list):\n        \"\"\"Initializes the ListSwapper with a copy of the input list.\n        A copy is made to avoid modifying the original list.\n        \"\"\"\n        self._data = list(input_list)\n\n    def interchange_first_and_last(self) -> None:\n        \"\"\"Swaps the first and last elements of the internal list if it has at least two elements.\"\"\"\n        if len(self._data) >= 2:\n            self._data[0], self._data[-1] = self._data[-1], self._data[0]\n\n    def get_modified_list(self) -> list:\n        \"\"\"Returns the current state of the internal list.\"\"\"\n        return self._data\n\ndef swap_List(input_list: list) -> list:\n    \"\"\"Interchanges the first and last elements in a given list.\n    Returns a new list with the first and last elements interchanged.\n    \"\"\"\n    swapper = ListSwapper(input_list)\n    swapper.interchange_first_and_last()\n    return swapper.get_modified_list()"}
