{"task_id": "Mbpp/448", "solution": "_perrin_cache = {}\n\ndef _get_perrin_sequence_term(n: int) -> int:\n    \"\"\"Calculates the nth Perrin number using memoization.\"\"\"\n    if n in _perrin_cache:\n        return _perrin_cache[n]\n\n    if n == 0:\n        result = 3\n    elif n == 1:\n        result = 0\n    elif n == 2:\n        result = 2\n    else:\n        result = _get_perrin_sequence_term(n - 2) + _get_perrin_sequence_term(n - 3)\n\n    _perrin_cache[n] = result\n    return result\n\ndef _generate_perrin_sequence(limit: int) -> list[int]:\n    \"\"\"Generates a list of Perrin numbers from P(0) up to P(limit).\"\"\"\n    sequence = []\n    for i in range(limit + 1):\n        sequence.append(_get_perrin_sequence_term(i))\n    return sequence\n\ndef cal_sum(limit: int) -> int:\n    \"\"\"\n    Calculates the sum of Perrin numbers from P(0) up to P(limit).\n    It generates the Perrin sequence and then sums its elements.\n    \"\"\"\n    perrin_sequence = _generate_perrin_sequence(limit)\n    return sum(perrin_sequence)"}
