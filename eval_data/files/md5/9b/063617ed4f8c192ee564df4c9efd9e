{"task_id": "Mbpp/392", "solution": "_memo = {}\n\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Calculates the maximum sum f(n) using a recursive formula with memoization.\n    f(n) = max((f(n/2) + f(n/3) + f(n/4) + f(n/5)), n)\n    \"\"\"\n    if n <= 0:\n        return 0\n    if n in _memo:\n        return _memo[n]\n\n    # Calculate the sum of recursive calls\n    sub_sum = get_max_sum(n // 2) + \\\n              get_max_sum(n // 3) + \\\n              get_max_sum(n // 4) + \\\n              get_max_sum(n // 5)\n\n    # The result is the maximum of n itself or the sum of its sub-problems\n    result = max(n, sub_sum)\n    _memo[n] = result\n    return result"}
