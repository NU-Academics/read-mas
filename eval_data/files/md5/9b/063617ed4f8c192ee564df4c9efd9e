{"task_id": "Mbpp/598", "solution": "def armstrong_number(number: int) -> bool:\n    \"\"\"Checks if the given number is an Armstrong number.\"\"\"\n    if number < 0:\n        return False\n\n    num_str = str(number)\n    n = len(num_str)\n    sum_of_powers = 0\n\n    for digit_char in num_str:\n        digit = int(digit_char)\n        sum_of_powers += digit ** n\n\n    return sum_of_powers == number"}
{"task_id": "Mbpp/599", "solution": "class InputValidationError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef _calculate_sum(n: int) -> float:\n    \"\"\"Computes the sum of the first 'n' natural numbers using the formula S = n * (n + 1) / 2.\"\"\"\n    return n * (n + 1) / 2.0\n\ndef _calculate_average(sum_val: float, n: int) -> float:\n    \"\"\"Computes the average of the first 'n' natural numbers using the formula A = S / n.\"\"\"\n    return sum_val / n\n\ndef sum_average(n: int) -> tuple[float, float]:\n    \"\"\"\n    Calculates the sum and average of the first n natural numbers.\n    Raises InputValidationError if n is not a positive integer (n < 1).\n    \"\"\"\n    if n < 1:\n        raise InputValidationError(\"Input 'n' must be a positive integer (n >= 1).\")\n\n    total_sum = _calculate_sum(n)\n    average = _calculate_average(total_sum, n)\n\n    return (total_sum, average)"}
{"task_id": "Mbpp/602", "solution": "def first_repeated_char(input_string: str) -> str | None:\n    \"\"\"\n    Identifies the first repeated character in the given string.\n\n    Args:\n        input_string: The string to analyze.\n\n    Returns:\n        The first repeated character as a string of length 1,\n        or None if no character is repeated or the string is empty.\n    \"\"\"\n    seen_chars = set()\n    for char in input_string:\n        if char in seen_chars:\n            return char\n        seen_chars.add(char)\n    return None"}
