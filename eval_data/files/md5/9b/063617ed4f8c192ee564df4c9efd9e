{"task_id": "Mbpp/739", "solution": "import math\n\nclass TriangularNumber:\n    \"\"\"Represents a triangular number, its index, value, and digit count.\"\"\"\n\n    def __init__(self, k: int):\n        self._index = k\n        self._value = self._calculate_value(k)\n        self._digit_count = self._count_digits(self._value)\n\n    def _calculate_value(self, k: int) -> int:\n        \"\"\"Calculates the triangular number T_k = k * (k + 1) / 2.\"\"\"\n        return k * (k + 1) // 2\n\n    def _count_digits(self, num: int) -> int:\n        \"\"\"Determines the number of digits of an integer X.\"\"\"\n        if num == 0:\n            return 1\n        return int(math.floor(math.log10(num))) + 1\n\n    def get_index(self) -> int:\n        \"\"\"Returns the index k of the triangular number.\"\"\"\n        return self._index\n\n    def get_value(self) -> int:\n        \"\"\"Returns the value T_k of the triangular number.\"\"\"\n        return self._value\n\n    def get_digit_count(self) -> int:\n        \"\"\"Returns the number of digits in T_k.\"\"\"\n        return self._digit_count\n\n\nclass IndexFinder:\n    \"\"\"Manages the iterative search for the smallest triangular number index with n digits.\"\"\"\n\n    def find_index_for_n_digits(self, n: int) -> int:\n        \"\"\"Finds the smallest index k such that T_k has exactly n digits.\"\"\"\n        k = 1\n        while True:\n            triangular_num = TriangularNumber(k)\n            if triangular_num.get_digit_count() == n:\n                return k\n            k += 1\n\ndef find_Index(n: int) -> int:\n    \"\"\"Finds the index of the smallest triangular number with n digits.\"\"\"\n    finder = IndexFinder()\n    return finder.find_index_for_n_digits(n)"}
{"task_id": "Mbpp/743", "solution": "def rotate_right(input_list: list, rotation_count: int) -> list:\n    \"\"\"\n    Rotates a list to the right by a specified number of items.\n    Returns a new list with the elements rotated, leaving the original list unchanged.\n    \"\"\"\n    if not input_list:\n        return []\n\n    n = len(input_list)\n    effective_rotation = rotation_count % n\n\n    # Split the list into two parts and concatenate them in the rotated order.\n    # The last 'effective_rotation' elements move to the front.\n    return input_list[-effective_rotation:] + input_list[:-effective_rotation]"}
