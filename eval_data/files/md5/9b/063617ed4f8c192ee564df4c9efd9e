{"task_id": "Mbpp/4", "solution": "import heapq\n\ndef heap_queue_largest(numbers: list[int], n: int) -> list[int]:\n    \"\"\"Finds the n largest integers from a list, returned in descending order.\n\n    Raises a ValueError if n is not positive or exceeds the list length.\n    \"\"\"\n    if not (isinstance(n, int) and n > 0):\n        raise ValueError(\"n must be a positive integer.\")\n    if n > len(numbers):\n        raise ValueError(\"n cannot be greater than the length of the numbers list.\")\n\n    return heapq.nlargest(n, numbers)"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(input_string: str) -> int:\n    \"\"\"\n    Calculates the minimum number of rotations (greater than 0)\n    required for a string to return to its original form.\n    \"\"\"\n    n = len(input_string)\n    if n == 0:\n        return 1 # For an empty string, 1 is the minimum positive rotation count.\n    \n    # Iterate through all possible rotation counts from 1 up to the string's length.\n    for k in range(1, n + 1):\n        # If the string can be formed by repeating a substring of length 'k',\n        # then 'n' must be divisible by 'k'.\n        if n % k == 0:\n            # Construct a string by repeating the first 'k' characters (the potential fundamental period).\n            substring = input_string[0:k]\n            repeated_string = substring * (n // k)\n            \n            # If this repeated string matches the original, then 'k' is the minimum\n            # number of rotations required, as we are iterating in ascending order.\n            if repeated_string == input_string:\n                return k"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(number1: int, number2: int) -> bool:\n    \"\"\"\n    Checks if two integer numbers differ at exactly one bit position.\n    It counts the set bits in the XOR result; if the count is one, returns True.\n    \"\"\"\n    xor_result = number1 ^ number2\n    set_bits_count = 0\n    while xor_result > 0:\n        xor_result &= (xor_result - 1)\n        set_bits_count += 1\n    return set_bits_count == 1"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, target_char: str) -> str:\n    \"\"\"\n    Removes the first and last occurrences of a given character from a string.\n    Returns the original string if the character appears less than two times.\n    \"\"\"\n    if input_string.count(target_char) < 2:\n        return input_string\n\n    first_index = input_string.find(target_char)\n    last_index = input_string.rfind(target_char)\n\n    # Construct new string by slicing and concatenating, excluding the characters at first_index and last_index.\n    new_string = input_string[0:first_index] + \\\n                 input_string[first_index+1:last_index] + \\\n                 input_string[last_index+1:]\n    return new_string"}
{"task_id": "Mbpp/2", "solution": "import collections\nfrom typing import Iterable, Set, Any\n\ndef similar_elements(list1: Iterable[Any], list2: Iterable[Any]) -> Set[Any]:\n    \"\"\"\n    Identifies and returns unique elements common to both input iterables.\n    \"\"\"\n    set1 = set(list1)\n    set2 = set(list2)\n    return set1.intersection(set2)"}
{"task_id": "Mbpp/12", "solution": "import collections\n\nclass Row:\n    \"\"\"Encapsulates a list of numbers and provides a method to calculate its sum.\"\"\"\n    def __init__(self, elements):\n        self._elements = elements\n\n    def get_sum(self):\n        \"\"\"Calculates and returns the sum of the row's elements.\"\"\"\n        return sum(self._elements)\n\n    def get_elements(self):\n        return self._elements\n\nclass Matrix:\n    \"\"\"Manages a collection of Row objects and provides functionality to sort them based on their sums.\"\"\"\n    def __init__(self, raw_matrix):\n        self._rows = [Row(row_elements) for row_elements in raw_matrix]\n\n    def sort_rows_by_sum(self):\n        \"\"\"Sorts the internal _rows list in ascending order based on Row.get_sum().\"\"\"\n        sorted_rows = sorted(self._rows, key=lambda row: row.get_sum())\n        new_matrix = Matrix([]) # Create a new Matrix instance for the sorted result\n        new_matrix._rows = sorted_rows\n        return new_matrix\n\n    def to_list(self):\n        \"\"\"Converts the Matrix object back into a standard list of lists representation.\"\"\"\n        return [row.get_elements() for row in self._rows]\n\ndef sort_matrix(matrix):\n    \"\"\"Sorts a given matrix in ascending order according to the sum of its rows.\"\"\"\n    matrix_obj = Matrix(matrix)\n    sorted_matrix_obj = matrix_obj.sort_rows_by_sum()\n    return sorted_matrix_obj.to_list()"}
