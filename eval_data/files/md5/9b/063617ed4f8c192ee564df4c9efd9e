{"task_id": "Mbpp/137", "solution": "import math\n\ndef zero_count(numbers: list[int]) -> float:\n    \"\"\"\n    Calculates the ratio of zero elements to non-zero elements in a list of integers.\n\n    Returns float('nan') if the count of non-zero elements is zero.\n    \"\"\"\n    zeroes = 0\n    non_zeroes = 0\n\n    for num in numbers:\n        if num == 0:\n            zeroes += 1\n        else:\n            non_zeroes += 1\n\n    if non_zeroes == 0:\n        return float('nan')\n\n    return float(zeroes) / non_zeroes"}
{"task_id": "Mbpp/141", "solution": "import copy\nfrom typing import List, TypeVar\n\n# Define a TypeVar for comparable elements\nComparableElement = TypeVar('ComparableElement', bound='Comparable')\n\ndef pancake_sort(input_list: List[ComparableElement]) -> List[ComparableElement]:\n    \"\"\"Sorts a list of comparable elements in ascending order using the pancake sort algorithm.\n\n    This function returns a new list without modifying the original.\n    \"\"\"\n    arr = copy.copy(input_list)\n    n = len(arr)\n\n    # Start from the complete array and one by one reduce current size by one\n    for curr_size in range(n, 1, -1):\n        # Find index of the maximum element in arr[0..curr_size-1]\n        mi = arr.index(max(arr[:curr_size]))\n\n        # Move the maximum element to the end of current array if it's not already there\n        if mi != curr_size - 1:\n            # Flip elements from 0 to mi (to bring maximum element to front)\n            arr[:mi+1] = arr[:mi+1][::-1]\n\n            # Flip elements from 0 to curr_size-1 (to move maximum element to its correct position)\n            arr[:curr_size] = arr[:curr_size][::-1]\n    return arr"}
{"task_id": "Mbpp/140", "solution": "def extract_singly(list_of_iterables: list[tuple | list | set]) -> set[int | float]:\n    \"\"\"\n    Flattens a list of iterables into a single set of unique numbers.\n    The function iterates through each iterable and adds its elements to a result set.\n    \"\"\"\n    result_set = set()\n    for inner_iterable in list_of_iterables:\n        for element in inner_iterable:\n            result_set.add(element)\n    return result_set"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1: list, list2: list, list3: list) -> int:\n    \"\"\"\n    Counts the number of items that are identical in the same position\n    across three given lists.\n    The comparison iterates up to the length of the shortest list.\n    \"\"\"\n    min_length = min(len(list1), len(list2), len(list3))\n    count = 0\n\n    for i in range(min_length):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
