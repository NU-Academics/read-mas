{"task_id": "Mbpp/780", "solution": "import itertools\n\ndef find_combinations(tuple_list: list[tuple[float | int, float | int]]) -> list[tuple[float | int, float | int]]:\n    \"\"\"\n    Calculates all unique element-wise sums of distinct tuple pairs from the input list.\n    \"\"\"\n    results = []\n    for t1, t2 in itertools.combinations(tuple_list, 2):\n        sum_tuple = (t1[0] + t2[0], t1[1] + t2[1])\n        results.append(sum_tuple)\n    return results"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(number: int) -> bool:\n    \"\"\"Checks if the count of positive divisors for a given integer is even.\n    Iterates up to the square root of the number to find divisors efficiently.\"\"\"\n    divisor_count = 0\n    i = 1\n    while i * i <= number:\n        if number % i == 0:\n            if i * i == number:\n                divisor_count += 1\n            else:\n                divisor_count += 2\n        i += 1\n    return divisor_count % 2 == 0"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int]) -> int:\n    \"\"\"Calculates the sum of all odd-length subarrays of a given integer array.\"\"\"\n    total_sum = 0\n    n = len(arr)\n    for i in range(n):\n        for j in range(i, n):\n            # The current subarray is arr[i:j+1]\n            sub_length = j - i + 1\n            if sub_length % 2 == 1:\n                total_sum += sum(arr[i : j+1])\n    return total_sum"}
