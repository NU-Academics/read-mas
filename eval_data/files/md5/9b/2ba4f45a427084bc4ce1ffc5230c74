{"task_id": "Mbpp/588", "solution": "def big_diff(list_of_values):\n    \"\"\"Compute and return numeric difference between largest and smallest values.\n    Returns max(list_of_values) - min(list_of_values).\n    \"\"\"\n    max_value = max(list_of_values)\n    min_value = min(list_of_values)\n    return max_value - min_value"}
{"task_id": "Mbpp/591", "solution": "def validate_input(input_list):\n    \"\"\"\n    Checks if the given input is a list.\n    \"\"\"\n    return isinstance(input_list, list)\n\ndef swap_List(input_list):\n    \"\"\"\n    Interchanges the first and last elements in a list.\n    Returns a new list with the elements swapped, or a copy of the original list if length is 0 or 1.\n    \"\"\"\n    if not validate_input(input_list):\n        raise TypeError(\"Input must be a list.\")\n\n    list_length = len(input_list)\n\n    if list_length < 2:\n        return list(input_list) # Returns a new list, consistent with the main logic.\n\n    # For lists with two or more elements, perform the swap\n    first_element = input_list[0]\n    last_element = input_list[-1]\n    middle_elements = input_list[1:-1]\n\n    # Construct and return a new list with the elements swapped\n    return [last_element] + middle_elements + [first_element]"}
{"task_id": "Mbpp/589", "solution": "import math\n\ndef perfect_squares(start: int, end: int) -> list[int]:\n    \"\"\"\n    Finds perfect squares within an inclusive integer range [start, end].\n    \"\"\"\n    if start > end:\n        return []\n\n    # Perfect squares are non-negative, so adjust start and end for root calculation.\n    # The smallest perfect square is 0.\n    effective_start = max(0, start)\n    effective_end = max(0, end)\n\n    # Determine the minimum integer root 'n_min' such that n_min*n_min >= effective_start\n    n_min = math.isqrt(effective_start)\n    if n_min * n_min < effective_start:\n        n_min += 1\n\n    # Determine the maximum integer root 'n_max' such that n_max*n_max <= effective_end\n    n_max = math.isqrt(effective_end)\n\n    # Collect perfect squares by iterating through roots\n    squares = []\n    for n in range(n_min, n_max + 1):\n        square = n * n\n        squares.append(square)\n\n    return squares"}
{"task_id": "Mbpp/594", "solution": "from typing import List\n\ndef diff_even_odd(nums: List[int]) -> int:\n    \"\"\"Accepts a list of integers, scans left-to-right to find first odd and first even,\n    computes first_even - first_odd and returns the result as int.\"\"\"\n    first_odd = None\n    first_even = None\n\n    for num in nums:\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        \n        if first_odd is not None and first_even is not None:\n            break\n            \n    return first_even - first_odd"}
{"task_id": "Mbpp/590", "solution": "import math\n\nclass PolarCoordinate:\n    \"\"\"Represents a polar coordinate (r, radial distance; theta, angle in radians).\"\"\"\n    def __init__(self, r: float, theta: float) -> None:\n        self.r = r\n        self.theta = theta\n\nclass RectangularCoordinate:\n    \"\"\"Represents rectangular coordinates (x, y) and provides conversion to complex.\"\"\"\n    def __init__(self, x: float, y: float) -> None:\n        self.x = x\n        self.y = y\n\n    def to_complex(self) -> complex:\n        \"\"\"Converts the rectangular coordinate to a complex number x + yj.\"\"\"\n        return complex(self.x, self.y)\n\nclass PolarRectConverter:\n    \"\"\"Encapsulates the conversion algorithm from polar to rectangular coordinates.\"\"\"\n    @staticmethod\n    def polar_rect(r: float, theta: float) -> complex:\n        \"\"\"Calculates rectangular coordinates x and y from polar (r, theta) and returns as a complex number.\"\"\"\n        x = r * math.cos(theta)\n        y = r * math.sin(theta)\n        return complex(x, y)\n\ndef polar_rect(r, theta):\n    \"\"\"\n    Converts polar coordinates (r, radial distance; theta, angle in radians)\n    to rectangular coordinates (x, y) represented as a complex number x + yj.\n    \"\"\"\n    if not isinstance(r, (int, float)) or not isinstance(theta, (int, float)):\n        raise ValueError(\"Inputs 'r' and 'theta' must be numeric (int or float).\")\n    if not math.isfinite(r) or not math.isfinite(theta):\n        raise ValueError(\"Inputs 'r' and 'theta' must be finite numbers.\")\n\n    # Create PolarCoordinate as per design, though not directly passed to converter.\n    _ = PolarCoordinate(float(r), float(theta))\n\n    return PolarRectConverter.polar_rect(float(r), float(theta))"}
{"task_id": "Mbpp/592", "solution": "import math\n\ndef C(n: int, k: int) -> int:\n    \"\"\"Computes the binomial coefficient C(n, k) using math.comb.\n    Performs input validation as specified in the design context.\n    \"\"\"\n    if not isinstance(n, int) or not isinstance(k, int):\n        raise TypeError(\"Inputs 'n' and 'k' must be integers.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer for binomial coefficients.\")\n    # For sum_Of_product, k will always be valid (0 <= k <= n).\n    # This explicit check is per design for C's standalone validation.\n    if k < 0 or k > n:\n        raise ValueError(\"Input 'k' must be between 0 and n (inclusive).\")\n    \n    return math.comb(n, k)\n\ndef sum_Of_product(n: int) -> int:\n    \"\"\"Calculates the sum of the product of consecutive binomial coefficients.\n    S(n) = sum_{k=0}^{n-1} C(n,k) * C(n,k+1).\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    \n    if n == 0:\n        return 0\n    \n    total_sum = 0\n    for k in range(n):\n        total_sum += C(n, k) * C(n, k + 1)\n        \n    return total_sum"}
{"task_id": "Mbpp/593", "solution": "from typing import List\n\nclass Octet:\n    \"\"\"Represents a single octet of an IP address and handles its normalization.\"\"\"\n    def __init__(self, raw: str, position: int):\n        self.raw: str = raw\n        self.normalized: str = ''\n        self.position: int = position\n\n    def removeLeadingZeros(self) -> str:\n        \"\"\"Strips leading '0' characters, preserving a single '0' if the octet is all zeros.\"\"\"\n        stripped = self.raw.lstrip('0')\n        self.normalized = stripped if stripped else '0'\n        return self.normalized\n\ndef parse_ip_to_octets(raw: str) -> List[str]:\n    \"\"\"Validates dotted-decimal format and returns a list of four octet strings, or raises ValueError.\"\"\"\n    octets_str = raw.split('.')\n    if len(octets_str) != 4:\n        raise ValueError(\"Invalid IP address format: must have exactly four octets separated by dots.\")\n\n    for octet_val in octets_str:\n        if not octet_val.isdigit():\n            raise ValueError(f\"Invalid IP address format: octet '{octet_val}' contains non-digit characters or is empty.\")\n    return octets_str\n\nclass IPAddress:\n    \"\"\"Represents an IP address, parsing its raw form and providing a normalized version.\"\"\"\n    def __init__(self, raw: str):\n        self.raw: str = raw\n        self.octets: List[Octet] = []\n        self.normalized: str = ''\n        \n        octet_strings = parse_ip_to_octets(raw)\n        self.octets = [Octet(s, i) for i, s in enumerate(octet_strings)]\n\n    def normalize(self) -> str:\n        \"\"\"Normalizes each octet and reassembles them into a dotted-decimal string.\"\"\"\n        normalized_octet_strings = [octet.removeLeadingZeros() for octet in self.octets]\n        self.normalized = '.'.join(normalized_octet_strings)\n        return self.normalized\n\nclass RemoveZeroFunction:\n    \"\"\"Internal class to encapsulate the logic for removing leading zeros from an IP address.\"\"\"\n    def removezero_ip(self, ip: str) -> str:\n        \"\"\"Creates an IPAddress object from the input string and returns its normalized form.\"\"\"\n        ipobj = IPAddress(ip)\n        return ipobj.normalize()\n\ndef removezero_ip(ip: str) -> str:\n    \"\"\"Removes leading zeros from each octet of a dotted-decimal IPv4 address.\n    Raises ValueError for malformed IP address inputs.\n    \"\"\"\n    return RemoveZeroFunction().removezero_ip(ip)"}
{"task_id": "Mbpp/596", "solution": "import sys\n\ndef tuple_size(t: tuple) -> int:\n    \"\"\"Return the number of bytes used by tuple t as reported by sys.getsizeof.\n\n    Raises:\n      TypeError: if t is not a tuple\n      RuntimeError: if sys.getsizeof raises an unexpected exception\n    \"\"\"\n    if not isinstance(t, tuple):\n        raise TypeError(\"tuple_size: expected tuple\")\n    try:\n        return sys.getsizeof(t)\n    except Exception as e:\n        raise RuntimeError(f\"sys.getsizeof failed unexpectedly for tuple {t!r}: {e}\") from e"}
{"task_id": "Mbpp/597", "solution": "def _validate_inputs(array1, array2, k):\n    \"\"\"\n    Validates k's range and raises ValueError if k is invalid.\n    \"\"\"\n    total_length = len(array1) + len(array2)\n    if k < 1 or k > total_length:\n        if total_length == 0:\n            raise ValueError(f\"Cannot find {k}-th element from empty arrays. k must be between 1 and {total_length}.\")\n        else:\n            raise ValueError(f\"Invalid k value. k must be between 1 and {total_length} (inclusive).\")\n\ndef _kth_two_pointer(array1, array2, k):\n    \"\"\"\n    Computes the k-th smallest element using a linear two-pointer scan.\n    \"\"\"\n    ptr1 = 0\n    ptr2 = 0\n    result = None\n\n    for _ in range(k):\n        val1 = array1[ptr1] if ptr1 < len(array1) else float('inf')\n        val2 = array2[ptr2] if ptr2 < len(array2) else float('inf')\n\n        if val1 <= val2:\n            result = val1\n            ptr1 += 1\n        else:\n            result = val2\n            ptr2 += 1\n    return result\n\ndef find_kth(array1, array2, k):\n    \"\"\"\n    Finds the k-th smallest element from two sorted arrays.\n    Validates inputs and uses a two-pointer approach for O(m+n) time and O(1) space.\n    \"\"\"\n    _validate_inputs(array1, array2, k)\n    return _kth_two_pointer(array1, array2, k)"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(n: int) -> bool:\n    \"\"\"\n    Checks if a number is an Armstrong number.\n    An Armstrong number equals the sum of its digits, each raised to the power of the number of digits.\n    \"\"\"\n\n    def numDigits(val: int) -> int:\n        \"\"\"Computes the number of decimal digits in a non-negative integer.\"\"\"\n        if val == 0:\n            return 1\n        return len(str(val))\n\n    def digits(val: int) -> list:\n        \"\"\"Extracts decimal digits of a non-negative integer as a list of integers.\"\"\"\n        return [int(d) for d in str(val)]\n\n    def digit_power(d: int, p: int) -> int:\n        \"\"\"Computes a digit raised to a given power.\"\"\"\n        return d ** p\n\n    def sum_of_powers(val: int) -> int:\n        \"\"\"Calculates the sum of each digit raised to the power of the total number of digits.\"\"\"\n        power = numDigits(val)\n        sum_val = 0\n        for d in digits(val):\n            sum_val += digit_power(d, power)\n        return sum_val\n\n    if n < 0:\n        return False # Armstrong numbers are typically defined for positive integers.\n\n    calculated_sum = sum_of_powers(n)\n    return calculated_sum == n"}
{"task_id": "Mbpp/599", "solution": "class NaturalNumberSequence:\n    def __init__(self, end: int):\n        self.start: int = 1\n        self.end: int = end\n    \n    def generate(self) -> list[int]:\n        \"\"\"Generates a list of natural numbers from start to end, inclusive.\"\"\"\n        return list(range(self.start, self.end + 1))\n\nclass Result:\n    def __init__(self, sum: int, average: float):\n        self.sum: int = sum\n        self.average: float = average\n    \n    def to_tuple(self) -> tuple[int, float]:\n        \"\"\"Returns the stored sum and average as a tuple.\"\"\"\n        return (self.sum, self.average)\n\ndef sum_average(n: int) -> tuple[int, float]:\n    \"\"\"Compute and return (sum, average) for the first n natural numbers.\"\"\"\n    \n    sequence_generator = NaturalNumberSequence(end=n)\n    numbers = sequence_generator.generate()\n    \n    total_sum = sum(numbers)\n    calculated_average = float(total_sum) / n\n    \n    result_holder = Result(total_sum, calculated_average)\n    return result_holder.to_tuple()"}
{"task_id": "Mbpp/600", "solution": "def is_Even(n: int) -> bool:\n    \"\"\"Return True if n is even, False otherwise.\"\"\"\n    return (n % 2 == 0)"}
{"task_id": "Mbpp/604", "solution": "def _tokenize_by_space(input_string):\n    \"\"\"Splits the input string into words using a single space as a delimiter.\"\"\"\n    return input_string.split(' ')\n\ndef _join_with_single_space(words):\n    \"\"\"Joins a sequence of words into a single string using a single space.\"\"\"\n    return ' '.join(words)\n\ndef reverse_words(input_string):\n    \"\"\"Reverses the order of words in a string, preserving spacing based on tokenization.\"\"\"\n    words = _tokenize_by_space(input_string)\n    words.reverse()\n    reversed_string = _join_with_single_space(words)\n    return reversed_string"}
{"task_id": "Mbpp/602", "solution": "from typing import Optional\nfrom dataclasses import dataclass\n\n@dataclass\nclass InputString:\n    value: str\n    length: int\n\n@dataclass\nclass CharacterOccurrence:\n    \"\"\"Optional dataclass for instrumentation/testing.\"\"\"\n    char: str\n    index: int\n    count: int\n\n@dataclass\nclass Result:\n    value: str\n\ndef _validate_input(input) -> None:\n    \"\"\"Ensures runtime argument is a Python str; raises TypeError on invalid type.\"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"Input must be a string.\")\n\ndef _find_first_repeated_char(value: str) -> Optional[str]:\n    \"\"\"Core scanning algorithm: left-to-right scan using a seen set; returns first repeated char or None.\"\"\"\n    input_str_obj = InputString(value, len(value))\n    seen = set()\n    for char in input_str_obj.value:\n        if char in seen:\n            return char\n        seen.add(char)\n    return None\n\ndef first_repeated_char(input: str) -> str:\n    \"\"\"\n    Finds the first repeated character in a given string.\n    Returns the character if found, otherwise an empty string.\n    \"\"\"\n    _validate_input(input)\n    repeated = _find_first_repeated_char(input)\n    \n    if repeated is not None:\n        result_obj = Result(repeated)\n        return result_obj.value\n    else:\n        return \"\""}
{"task_id": "Mbpp/603", "solution": "class NumberList:\n    \"\"\"A simple wrapper around a list for storing numbers.\"\"\"\n    def __init__(self) -> None:\n        self.items: list[int] = []\n\n    def append(self, value: int) -> None:\n        \"\"\"Appends a value to the list.\"\"\"\n        self.items.append(value)\n\n    def length(self) -> int:\n        \"\"\"Returns the number of items in the list.\"\"\"\n        return len(self.items)\n\nclass LudicSequence:\n    \"\"\"Computes ludic numbers up to a given integer n based on the problem's interpretation.\"\"\"\n    def __init__(self, n: int) -> None:\n        self._n = n\n        self._values: list[int] | None = None\n\n    def compute(self) -> list[int]:\n        \"\"\"\n        Calculates and stores ludic numbers up to self._n.\n        For this problem, ludic numbers are defined as 1 and all prime numbers up to n.\n        \"\"\"\n        if self._values is not None:\n            return self._values\n\n        ludic_numbers_list = NumberList()\n\n        if self._n >= 1:\n            ludic_numbers_list.append(1) # 1 is always considered a ludic number in this problem context\n\n        if self._n >= 2:\n            # Use Sieve of Eratosthenes to find primes up to n\n            is_prime = [True] * (self._n + 1)\n            is_prime[0] = False\n            is_prime[1] = False\n\n            for p in range(2, int(self._n**0.5) + 1):\n                if is_prime[p]:\n                    for multiple in range(p*p, self._n + 1, p):\n                        is_prime[multiple] = False\n\n            for p_num in range(2, self._n + 1):\n                if is_prime[p_num]:\n                    ludic_numbers_list.append(p_num)\n\n        self._values = ludic_numbers_list.items\n        return self._values\n\n    def values(self) -> list[int]:\n        \"\"\"Accessor that returns computed ludic numbers, computing them if necessary.\"\"\"\n        if self._values is None:\n            self.compute()\n        return self._values\n\nclass LudicGenerator:\n    \"\"\"Generates ludic numbers up to a given integer by delegating to LudicSequence.\"\"\"\n    def generate(self, n: int) -> list[int]:\n        \"\"\"Computes and returns ludic numbers up to n.\"\"\"\n        sequence = LudicSequence(n)\n        return sequence.compute()\n\ndef get_ludic(n: int) -> list[int]:\n    \"\"\"\n    Returns a list of all ludic numbers less than or equal to n.\n    Based on the provided assertion get_ludic(10) == [1, 2, 3, 5, 7],\n    ludic numbers for this problem are 1 and all prime numbers up to n.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 1:\n        return []\n\n    generator = LudicGenerator()\n    return generator.generate(n)"}
{"task_id": "Mbpp/605", "solution": "from datetime import datetime\nfrom math import sqrt\n\nclass InvalidInputError(Exception):\n    \"\"\"Domain error type for invalid input conditions.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass PrimeTestResult:\n    \"\"\"DTO for evaluation result and timestamp.\"\"\"\n    def __init__(self, is_prime: bool, evaluated_at: datetime):\n        self.is_prime = is_prime\n        self.evaluated_at = evaluated_at\n\nclass IntegerInput:\n    \"\"\"Encapsulates provided argument and validation state.\"\"\"\n    def __init__(self, value):\n        self.value = value\n        self.is_valid = isinstance(value, int)\n\n    def isValid(self) -> bool:\n        \"\"\"Returns True if the encapsulated value is an integer.\"\"\"\n        return self.is_valid\n\nclass PrimeNumFunction:\n    \"\"\"Encapsulates primality algorithm and produces PrimeTestResult.\"\"\"\n    def isPrime(self, n: int) -> bool:\n        \"\"\"Return True if n is prime (n > 1 and no divisors other than 1 and n).\"\"\"\n        if n <= 1:\n            result = PrimeTestResult(False, datetime.now())\n            return result.is_prime\n        if n == 2:\n            result = PrimeTestResult(True, datetime.now())\n            return result.is_prime\n        if n % 2 == 0:\n            result = PrimeTestResult(False, datetime.now())\n            return result.is_prime\n\n        limit = int(sqrt(n))\n        for i in range(3, limit + 1, 2):\n            if n % i == 0:\n                result = PrimeTestResult(False, datetime.now())\n                return result.is_prime\n\n        result = PrimeTestResult(True, datetime.now())\n        return result.is_prime\n\ndef prime_num(n) -> bool:\n    \"\"\"Checks if the given integer is a prime number, returning False for non-integers.\"\"\"\n    integer_input = IntegerInput(n)\n    if not integer_input.isValid():\n        return False\n    \n    return PrimeNumFunction().isPrime(n)"}
{"task_id": "Mbpp/606", "solution": "import math\n\ndef radian_degree(degrees):\n    \"\"\"Convert degrees to radians and return as Python float (IEEE-754 double).\n    Signature required by SRS: radian_degree(degrees) -> float\n    \"\"\"\n    return degrees * math.pi / 180"}
{"task_id": "Mbpp/607", "solution": "import re\nfrom typing import Optional, Tuple\n\ndef find_literals(input_string: str, pattern: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Searches a string for a regex pattern and returns the first matching substring, start, and end indices.\n    Returns None if no match is found.\n    \"\"\"\n    match = re.search(pattern, input_string)\n    if match:\n        return (match.group(0), match.start(), match.end())\n    return None"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"Compute the nth Bell number (0-based) using the Bell triangle algorithm.\"\"\"\n    if n == 0:\n        return 1\n\n    last_row = [1]\n    for i in range(1, n + 1):\n        row = [last_row[-1]]\n        for j in range(1, i + 1):\n            row.append(row[-1] + (last_row[j - 1] if j - 1 < len(last_row) else 0))\n        last_row = row\n    \n    return last_row[0]"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(lst, k):\n    \"\"\"Return a new list equivalent to lst with the k'th element removed.\n\n    The parameter k is interpreted as a 1-based index.\n    \"\"\"\n    index_to_remove = k - 1\n    return lst[:index_to_remove] + lst[index_to_remove + 1:]"}
{"task_id": "Mbpp/612", "solution": "def validate_input(list_of_pairs):\n    \"\"\"\n    Validates that list_of_pairs is a sequence of sub-sequences, each of length 2.\n    Raises TypeError or ValueError on invalid input.\n    \"\"\"\n    if not isinstance(list_of_pairs, (list, tuple)):\n        raise TypeError(\"Input must be a list or tuple of pairs.\")\n\n    for i, pair in enumerate(list_of_pairs):\n        if not isinstance(pair, (list, tuple)):\n            raise TypeError(f\"Element at index {i} is not a list or tuple: {pair}\")\n        if len(pair) != 2:\n            raise ValueError(f\"Sublist at index {i} does not have exactly two elements: {pair}\")\n\n\ndef merge(list_of_pairs):\n    \"\"\"\n    Merges a list of two-element sublists into two separate lists.\n    The first returned list contains all first elements, the second all second elements.\n    \"\"\"\n    validate_input(list_of_pairs)\n\n    firsts = []\n    seconds = []\n\n    for pair in list_of_pairs:\n        firsts.append(pair[0])\n        seconds.append(pair[1])\n\n    return [firsts, seconds]"}
{"task_id": "Mbpp/614", "solution": "def cummulative_sum(input_list):\n    \"\"\"\n    Calculates the cumulative sum of all integer values across a list of tuples.\n    Assumes input_list is a list of tuples, and each tuple contains integers.\n    \"\"\"\n    cumulative_sum_value = 0\n    for sub_tuple in input_list:\n        for number in sub_tuple:\n            cumulative_sum_value += number\n    return cumulative_sum_value"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(tuple_of_tuples):\n    \"\"\"\n    Compute and return a list of averages for each inner tuple.\n\n    Args:\n        tuple_of_tuples: tuple of tuples containing numeric values (int or float)\n\n    Returns:\n        list of numbers where each is the average of the corresponding inner tuple\n\n    Raises:\n        TypeError: if outer input not tuple, any inner element not tuple, or any inner value not numeric\n        ValueError: if any inner tuple is empty\n    \"\"\"\n    if not isinstance(tuple_of_tuples, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    averages = []\n    for i, inner_tuple in enumerate(tuple_of_tuples):\n        if not isinstance(inner_tuple, tuple):\n            raise TypeError(f\"Element at index {i} is not a tuple.\")\n        \n        if not inner_tuple:\n            raise ValueError(f\"Inner tuple at index {i} cannot be empty.\")\n        \n        current_sum = 0\n        for j, value in enumerate(inner_tuple):\n            if not isinstance(value, (int, float)):\n                raise TypeError(f\"Value '{value}' at index {j} of inner tuple {i} is not numeric.\")\n            current_sum += value\n            \n        averages.append(current_sum / len(inner_tuple))\n        \n    return averages"}
{"task_id": "Mbpp/619", "solution": "def move_num(input_str: str) -> str:\n    \"\"\"\n    Moves all ASCII digits ('0'-'9') to the end of the string, preserving relative order\n    of both non-digits and digits.\n    \"\"\"\n    if not input_str:\n        return \"\"\n\n    non_digit_chars = []\n    digit_chars = []\n\n    for char in input_str:\n        if '0' <= char <= '9':\n            digit_chars.append(char)\n        else:\n            non_digit_chars.append(char)\n\n    return \"\".join(non_digit_chars) + \"\".join(digit_chars)"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix, n):\n    \"\"\"\n    Calculates the maximum value in the n'th column of a matrix.\n    It validates input types and shapes, extracts the column, ensures numeric values, and returns the maximum.\n    \"\"\"\n    _validate_matrix_shape(matrix)\n    column_values = _extract_column(matrix, n)\n\n    if not column_values:\n        # If the matrix was empty or no elements could be extracted at index n from any row.\n        raise IndexError(\"Cannot extract a column because the matrix is empty or no elements exist at the specified index n across any row.\")\n\n    _validate_column_numeric(column_values)\n    return _compute_max(column_values)\n\ndef _validate_matrix_shape(matrix):\n    \"\"\"\n    Ensures the top-level 'matrix' is a list and each inner 'row' is also a list.\n    Raises TypeError if these structural conditions are not met.\n    \"\"\"\n    if not isinstance(matrix, list):\n        raise TypeError(\"Matrix must be a list of lists.\")\n    for i, row in enumerate(matrix):\n        if not isinstance(row, list):\n            raise TypeError(f\"Row {i} in the matrix must be a list, but found type {type(row).__name__}.\")\n\ndef _extract_column(matrix, n):\n    \"\"\"\n    Iterates through each row in the matrix to extract the element at the specified index 'n'.\n    Raises IndexError if any individual row is too short to contain an element at index 'n'.\n    \"\"\"\n    extracted_values = []\n    for i, row in enumerate(matrix):\n        try:\n            extracted_values.append(row[n])\n        except IndexError:\n            raise IndexError(f\"Row {i} does not contain an element at index {n}.\")\n    return extracted_values\n\ndef _validate_column_numeric(values):\n    \"\"\"\n    Checks that every value in the extracted column is a numeric type (int or float).\n    Raises TypeError if any value is found to be non-numeric.\n    \"\"\"\n    for val in values:\n        if not isinstance(val, (int, float)):\n            raise TypeError(f\"Column value '{val}' (type {type(val).__name__}) is not numeric (int or float).\")\n\ndef _compute_max(values):\n    \"\"\"\n    Computes the maximum value from a given list of numeric values.\n    This helper assumes 'values' is a non-empty list containing only int or float.\n    \"\"\"\n    return max(values)"}
{"task_id": "Mbpp/618", "solution": "\"\"\"\nModule implementing div_list(a, b).\n\nPublic API:\n  - div_list(a, b) -> list of floats\n  - ValidationError exception (raised on invalid inputs)\n\nExample (FR3): assert div_list([4,5,6], [1,2,3]) == [4.0, 2.5, 2.0]\n\"\"\"\nfrom typing import Sequence, List\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation failures.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\nclass NumericElement:\n    \"\"\"Represents a single numeric value and its index.\"\"\"\n    def __init__(self, value: float, index: int):\n        self.value = value\n        self.index = index\n\nclass InputList:\n    \"\"\"Wrapper for incoming sequence; provides length and access.\"\"\"\n    def __init__(self, elements: Sequence):\n        if not isinstance(elements, Sequence):\n            raise ValidationError(\"Input must be a list-like sequence.\")\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\n\nclass ResultElement:\n    \"\"\"Represents a float result and its index.\"\"\"\n    def __init__(self, value: float, index: int):\n        self.value = value\n        self.index = index\n\nclass ResultList:\n    \"\"\"Container for ordered float results and conversion to builtin list.\"\"\"\n    def __init__(self, elements: List[float]):\n        self.elements = elements\n\n    def to_list(self) -> List[float]:\n        return self.elements\n\nclass DivListFunction:\n    \"\"\"Stateless service implementing validation and execution.\"\"\"\n\n    def validate(self, a: InputList, b: InputList) -> None:\n        \"\"\"Validates that input lists are of equal length and contain numeric elements.\"\"\"\n        if a.length() != b.length():\n            raise ValidationError(f\"Input lists must be of equal length. Got {a.length()} and {b.length()}.\")\n\n        for i in range(a.length()):\n            if not isinstance(a.elements[i], (int, float)):\n                raise ValidationError(f\"Non-numeric element found in 'a' at index {i}.\")\n            if not isinstance(b.elements[i], (int, float)):\n                raise ValidationError(f\"Non-numeric element found in 'b' at index {i}.\")\n\n    def execute(self, a: InputList, b: InputList) -> ResultList:\n        \"\"\"Performs element-wise division after validation.\"\"\"\n        self.validate(a, b)\n\n        results: List[float] = []\n        for i in range(a.length()):\n            denominator = float(b.elements[i])\n            if denominator == 0:\n                raise ZeroDivisionError(f\"Denominator zero at index {i}.\")\n            results.append(float(a.elements[i]) / denominator)\n        return ResultList(results)\n\ndef div_list(a: Sequence, b: Sequence) -> List[float]:\n    \"\"\"Divides two lists element-wise, returning a list of floats.\"\"\"\n    return DivListFunction().execute(InputList(a), InputList(b)).to_list()"}
{"task_id": "Mbpp/616", "solution": "from typing import Tuple\n\nclass LengthMismatchException(Exception):\n    \"\"\"Exception raised when input tuples have different lengths.\n    It indicates that two tuples provided for an operation do not have the same number of elements.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass InvalidElementTypeException(Exception):\n    \"\"\"Exception raised for non-tuple inputs or non-integer elements.\n    It signifies that an input or its elements are not of the expected type (tuple or integer).\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\ndef _validate_is_tuple(obj: Tuple, name: str) -> None:\n    \"\"\"Validates if an object is a tuple.\n    Raises InvalidElementTypeException if it is not a tuple.\"\"\"\n    if not isinstance(obj, tuple):\n        raise InvalidElementTypeException(f\"Input '{name}' must be a tuple.\")\n\ndef _validate_all_integers(t: Tuple[int], name: str) -> None:\n    \"\"\"Validates if all elements in a tuple are integers.\n    Raises InvalidElementTypeException if any element is not an integer.\"\"\"\n    for i, element in enumerate(t):\n        if not isinstance(element, int):\n            raise InvalidElementTypeException(f\"Element at index {i} in tuple '{name}' is not an integer.\")\n\ndef tuple_modulo(a: tuple[int], b: tuple[int]) -> tuple[int]:\n    \"\"\"\n    Performs element-wise modulo on two tuples of integers.\n    Validates inputs for type and length, raising exceptions on invalid input.\n    \"\"\"\n    _validate_is_tuple(a, 'a')\n    _validate_is_tuple(b, 'b')\n\n    _validate_all_integers(a, 'a')\n    _validate_all_integers(b, 'b')\n\n    if len(a) != len(b):\n        raise LengthMismatchException(\"input tuples have different lengths\")\n\n    result = tuple(a[i] % b[i] for i in range(len(a)))\n\n    return result"}
{"task_id": "Mbpp/620", "solution": "from typing import List, Optional\n\nclass Number:\n    \"\"\"Immutable holder for a single integer value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass DivisibleSubset:\n    \"\"\"Represents a candidate subset and provides methods for its management.\"\"\"\n    def __init__(self, members: Optional[List[Number]] = None) -> None:\n        self.members: List[Number] = members if members is not None else []\n\n    def size(self) -> int:\n        \"\"\"Returns the number of members in the subset.\"\"\"\n        return len(self.members)\n\n    def isPairwiseDivisible(self) -> bool:\n        \"\"\"\n        Checks if every pair (x, y) in members satisfies (x % y == 0 or y % x == 0),\n        avoiding modulo-by-zero.\n        \"\"\"\n        if self.size() <= 1:\n            return True\n        for i in range(self.size()):\n            for j in range(i + 1, self.size()):\n                a = self.members[i].value\n                b = self.members[j].value\n                # Check divisibility in either direction, guarding against modulo by zero\n                if not ((b != 0 and a % b == 0) or (a != 0 and b % a == 0)):\n                    return False\n        return True\n\n    def to_int_list(self) -> List[int]:\n        \"\"\"Converts the subset members to a list of integers.\"\"\"\n        return [m.value for m in self.members]\n\nclass LargestSubsetCalculator:\n    \"\"\"Implements the algorithm to compute the largest divisible subset size.\"\"\"\n    def divisible(self, a: int, b: int) -> bool:\n        \"\"\"Checks if a is divisible by b, avoiding modulo by zero.\"\"\"\n        return (b != 0) and (a % b == 0)\n\n    def largest_subset(self, nums: List[int]) -> int:\n        \"\"\"\n        Computes the size of the largest divisible subset using dynamic programming.\n        The input list is sorted, and dp[i] stores the length of the longest chain\n        ending at index i, where each element is divisible by the previous.\n        \"\"\"\n        # This check is primarily handled by the public API, but good for internal consistency\n        if not nums:\n            return 0\n\n        # Sort numbers to enable checking only a % b == 0 (where a > b)\n        # and ensure the transitive property of divisibility holds for a chain.\n        sorted_nums = sorted(nums)\n        n = len(sorted_nums)\n\n        # dp[i] stores the length of the longest divisible subset ending with sorted_nums[i]\n        dp = [1] * n\n        # prev[i] stores the index of the previous element in the longest divisible subset\n        # ending with sorted_nums[i], used for reconstructing the subset.\n        prev = [-1] * n\n\n        max_len = 1\n        max_idx = 0 # Index where the longest chain ends\n\n        for i in range(n):\n            for j in range(i):\n                # If sorted_nums[i] is divisible by sorted_nums[j],\n                # and adding sorted_nums[i] to the subset ending at j creates a longer subset\n                if self.divisible(sorted_nums[i], sorted_nums[j]) and dp[j] + 1 > dp[i]:\n                    dp[i] = dp[j] + 1\n                    prev[i] = j\n            \n            # Update max_len and max_idx if a longer subset is found\n            if dp[i] > max_len:\n                max_len = dp[i]\n                max_idx = i\n        \n        # As per design (UC4), reconstruct the DivisibleSubset and return its size.\n        subset = self.buildSubset(sorted_nums, prev, max_idx)\n        return subset.size()\n\n    def buildSubset(self, sorted_nums: List[int], prev_indices: List[int], end_idx: int) -> DivisibleSubset:\n        \"\"\"\n        Reconstructs a largest divisible subset from DP results (sorted_nums, prev_indices)\n        starting from the element at end_idx.\n        \"\"\"\n        members: List[Number] = []\n        current_idx = end_idx\n        while current_idx != -1:\n            members.append(Number(sorted_nums[current_idx]))\n            current_idx = prev_indices[current_idx]\n        \n        # The chain is built in reverse order, so reverse it to get elements in ascending order\n        members.reverse()\n        return DivisibleSubset(members)\n\ndef largest_subset(nums: List[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of numbers so that every pair is divisible.\n    \"\"\"\n    if not nums:\n        return 0\n    if len(nums) == 1:\n        return 1\n\n    calculator = LargestSubsetCalculator()\n    return calculator.largest_subset(nums)"}
{"task_id": "Mbpp/622", "solution": "from typing import List, Sequence, Tuple\n\nclass InputArray:\n    \"\"\"\n    Wraps an input sequence of numbers, providing length and sortedness checks.\n    Ensures elements are numeric and provides a method to check if the array is non-decreasing.\n    \"\"\"\n    def __init__(self, elements: Sequence[float]):\n        self.elements = list(elements)\n        self.length = len(self.elements)\n\n    def is_sorted(self) -> bool:\n        \"\"\"\n        Checks if the elements in the array are in non-decreasing order.\n        Returns True if sorted, False otherwise.\n        \"\"\"\n        if self.length <= 1:\n            return True\n        for i in range(self.length - 1):\n            if self.elements[i] > self.elements[i+1]:\n                return False\n        return True\n\nclass MedianResult:\n    \"\"\"\n    Simple holder class for the computed median float value.\n    Encapsulates the result for consistent return types within the calculator.\n    \"\"\"\n    def __init__(self, value: float):\n        self.value = value\n\nclass MedianCalculator:\n    \"\"\"\n    Performs input validation and computes the median of two sorted arrays of equal size.\n    Uses a merge-based approach to find the two middle elements.\n    \"\"\"\n    def __init__(self, arr1: InputArray, arr2: InputArray, n: int):\n        self._arr1 = arr1\n        self._arr2 = arr2\n        self._n = n\n\n    def validate_inputs(self) -> bool:\n        \"\"\"\n        Validates the input arrays for length, sortedness, and numeric types.\n        Returns True if all validations pass, False otherwise.\n        \"\"\"\n        if not (self._arr1.length == self._n and self._arr2.length == self._n):\n            return False\n        if not (self._arr1.is_sorted() and self._arr2.is_sorted()):\n            return False\n        \n        # Check for numeric types (int or float)\n        for x in self._arr1.elements + self._arr2.elements:\n            if not isinstance(x, (int, float)):\n                return False\n        return True\n\n    def _median_by_merge(self) -> Tuple[float, float]:\n        \"\"\"\n        Merges the two sorted arrays virtually to find the n-th and (n+1)-th smallest elements.\n        These two elements are used to calculate the median of the combined 2n elements.\n        \"\"\"\n        i, j = 0, 0\n        m1, m2 = 0.0, 0.0\n        \n        # We need to find the n-th and (n+1)-th elements (0-indexed: index n-1 and n)\n        # Iterate n+1 times to get elements up to the (n+1)-th smallest element\n        for count in range(self._n + 1):\n            # If arr1 is exhausted, take from arr2\n            if i == self._n:\n                current_val = float(self._arr2.elements[j])\n                j += 1\n            # If arr2 is exhausted, take from arr1\n            elif j == self._n:\n                current_val = float(self._arr1.elements[i])\n                i += 1\n            # If both have elements, compare and take the smaller\n            elif self._arr1.elements[i] < self._arr2.elements[j]:\n                current_val = float(self._arr1.elements[i])\n                i += 1\n            else:\n                current_val = float(self._arr2.elements[j])\n                j += 1\n            \n            # Store the n-th and (n+1)-th elements (0-indexed count corresponds to 1st, 2nd, ... smallest)\n            if count == self._n - 1: # This is the n-th smallest element\n                m1 = current_val\n            if count == self._n:   # This is the (n+1)-th smallest element\n                m2 = current_val\n        \n        return m1, m2\n\n    def compute_median(self) -> MedianResult:\n        \"\"\"\n        Validates inputs and computes the median of the two combined arrays.\n        Raises ValueError if inputs are invalid.\n        \"\"\"\n        if not self.validate_inputs():\n            raise ValueError(\"Input validation failed: arrays must be sorted, of specified length n, and contain numeric values.\")\n        \n        element_n, element_n_plus_1 = self._median_by_merge()\n        median_value = (element_n + element_n_plus_1) / 2.0\n        return MedianResult(median_value)\n\ndef get_median(arr1: List[float], arr2: List[float], n: int) -> float:\n    \"\"\"\n    Calculates the median of two sorted lists of the same size (n).\n    It orchestrates input validation and median computation through helper classes.\n    \"\"\"\n    input_arr1 = InputArray(arr1)\n    input_arr2 = InputArray(arr2)\n    \n    calculator = MedianCalculator(input_arr1, input_arr2, n)\n    result = calculator.compute_median()\n    \n    return result.value"}
{"task_id": "Mbpp/623", "solution": "def nth_nums(list_of_numbers, n):\n    \"\"\"\n    Computes the n-th power of each number in a list.\n    Returns a new list with the results, preserving the original order.\n    \"\"\"\n    return [number ** n for number in list_of_numbers]"}
