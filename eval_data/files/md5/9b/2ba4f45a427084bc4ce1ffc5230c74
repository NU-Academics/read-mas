{"task_id": "Mbpp/268", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for invalid input to star number functions.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass InputValidator:\n    \"\"\"Validates input parameter n for star number calculations.\"\"\"\n    def validate(self, n: int) -> None:\n        \"\"\"\n        Validates that n is an integer and n >= 1.\n        Raises ValidationError if invalid.\n        \"\"\"\n        if not isinstance(n, int):\n            raise ValidationError(\"Input 'n' must be an integer.\")\n        if n < 1:\n            raise ValidationError(\"Input 'n' must be greater than or equal to 1.\")\n\ndef find_star_num(n: int) -> int:\n    \"\"\"\n    Computes the n'th star number.\n    Input n must be an integer >= 1.\n    \"\"\"\n    validator = InputValidator()\n    validator.validate(n)\n    \n    # Compute the n'th star number using the formula: 6 * n * (n - 1) + 1.\n    star_number = 6 * n * (n - 1) + 1\n    \n    return star_number"}
{"task_id": "Mbpp/270", "solution": "from typing import List, Any\n\ndef _is_even(value: int) -> bool:\n    \"\"\"Checks if a given integer value is even.\"\"\"\n    return value % 2 == 0\n\ndef _validate_input(input_list: Any) -> None:\n    \"\"\"Validates that input_list is a list of integers, raising TypeError if not.\"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n    for item in input_list:\n        if not isinstance(item, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n\ndef sum_even_and_even_index(input_list: List[int]) -> int:\n    \"\"\"\n    Finds the sum of even numbers at even positions of a list.\n    \"\"\"\n    _validate_input(input_list)\n\n    total_sum = 0\n    for index, value in enumerate(input_list):\n        if _is_even(index) and _is_even(value):\n            total_sum += value\n    return total_sum"}
