{"task_id": "Mbpp/16", "solution": "import re\n\nVALIDATION_PATTERN = r\"^[a-z]+_[a-z]+$\"\n\ndef text_lowercase_underscore(input: str) -> bool:\n    \"\"\"\n    Checks if the input string contains sequences of lowercase letters joined with an underscore.\n    Returns True if the string matches the pattern ^[a-z]+_[a-z]+$, False otherwise.\n    \"\"\"\n    if not isinstance(input, str):\n        return False\n    return re.fullmatch(VALIDATION_PATTERN, input) is not None"}
{"task_id": "Mbpp/12", "solution": "from typing import List\n\nclass Number:\n    \"\"\"Represents a numeric element's value.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value = value\n\nclass Row:\n    \"\"\"Holds an ordered list of numeric elements and computes their sum.\"\"\"\n    def __init__(self, elements: List[Number], position: int) -> None:\n        self.elements = elements\n        self.position = position\n\n    def sum(self) -> float:\n        \"\"\"Calculates the sum of all numeric elements in the row.\"\"\"\n        return sum(element.value for element in self.elements)\n\nclass Matrix:\n    \"\"\"Contains Row instances and provides methods for sorting and conversion.\"\"\"\n    def __init__(self, rows: List['Row']) -> None:\n        self.rows = rows\n\n    def sort_by_row_sum(self) -> 'Matrix':\n        \"\"\"Returns a new Matrix with rows sorted ascending by their sum.\"\"\"\n        sorted_rows = sorted(self.rows, key=lambda row: row.sum())\n        return Matrix(sorted_rows)\n\n    def to_list_of_lists(self) -> List[List[float]]:\n        \"\"\"Converts the Matrix object back into a raw list of lists of floats.\"\"\"\n        result = []\n        for row in self.rows:\n            result.append([element.value for element in row.elements])\n        return result\n\ndef sort_matrix(matrix: List[List[float]]) -> List[List[float]]:\n    \"\"\"\n    Sorts a given matrix in ascending order according to the sum of its rows.\n    \"\"\"\n    rows = []\n    for i, row_list in enumerate(matrix):\n        elements = [Number(val) for val in row_list]\n        rows.append(Row(elements, i))\n    \n    matrix_obj = Matrix(rows)\n    sorted_matrix_obj = matrix_obj.sort_by_row_sum()\n    \n    return sorted_matrix_obj.to_list_of_lists()"}
{"task_id": "Mbpp/18", "solution": "def _build_filter_set(filter_str: str) -> set:\n    \"\"\"Converts a filter string into a set of characters for efficient lookup.\"\"\"\n    return set(filter_str)\n\ndef remove_dirty_chars(first: str, second: str) -> str:\n    \"\"\"\n    Removes characters from the first string that are present in the second string.\n    Preserves the original order of characters from the first string.\n    \"\"\"\n    if not first:\n        return \"\"\n    if not second:\n        return first\n\n    filter_set = _build_filter_set(second)\n    result_chars = []\n    for char in first:\n        if char not in filter_set:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/19", "solution": "from typing import List, Union\n\nclass IntegerElement:\n    \"\"\"A domain value object holding a single integer value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value: int = value\n\nclass IntegerArray:\n    \"\"\"A domain container representing an array of IntegerElement objects.\"\"\"\n    def __init__(self, values: List[int]) -> None:\n        self.elements: List[IntegerElement] = [IntegerElement(v) for v in values]\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns a list of the integer values contained in the array.\"\"\"\n        return [el.value for el in self.elements]\n\nclass DuplicateDetector:\n    \"\"\"Performs duplicate detection on an array of integer values.\"\"\"\n    def __init__(self) -> None:\n        self._seen: set[int] = set()\n\n    def test_duplicate(self, arr: Union[List[int], IntegerArray]) -> bool:\n        \"\"\"Inspects arr and returns True if any duplicate integer values exist, otherwise False.\"\"\"\n        current_array: List[int]\n        if isinstance(arr, IntegerArray):\n            current_array = arr.to_list()\n        else:\n            current_array = arr\n\n        for element_value in current_array:\n            if element_value in self._seen:\n                return True\n            self._seen.add(element_value)\n        return False\n\ndef test_duplicate(arr: Union[List[int], IntegerArray]) -> bool:\n    \"\"\"Detects whether the given array of integers contains any duplicate element.\"\"\"\n    detector = DuplicateDetector()\n    return detector.test_duplicate(arr)"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"\n    Check if the given number is a Woodall number.\n    A Woodall number N is defined as N == k * 2^k - 1 for some integer k >= 1.\n    \"\"\"\n    k = 1\n    while True:\n        # Calculate v = k * 2^k - 1\n        v = k * (2**k) - 1\n\n        if v == number:\n            return True\n        elif v > number:\n            # If the calculated value exceeds the target,\n            # further increments of k will only make v larger,\n            # so number cannot be a Woodall number.\n            return False\n        else:\n            # v < number, continue searching with next k\n            k += 1"}
