{"task_id": "Mbpp/458", "solution": "class Rectangle:\n    \"\"\"Represents a rectangle with a given length and width.\"\"\"\n    def __init__(self, length: float, width: float) -> None:\n        self.length = length\n        self.width = width\n\n    def area(self) -> float:\n        \"\"\"Computes and returns the area of the rectangle.\"\"\"\n        return self.length * self.width\n\nclass RectangleService:\n    \"\"\"Provides application services for rectangle operations.\"\"\"\n    def rectangle_area(self, length: float, width: float) -> float:\n        \"\"\"Creates a Rectangle and returns its area.\"\"\"\n        rectangle = Rectangle(length, width)\n        return rectangle.area()\n\ndef rectangle_area(length: float, width: float) -> float:\n    \"\"\"Calculates the area of a rectangle given its length and width by delegating to a service.\"\"\"\n    service = RectangleService()\n    return service.rectangle_area(length, width)"}
{"task_id": "Mbpp/456", "solution": "import collections\nfrom typing import List\n\nclass StringItem:\n    \"\"\"Represents a string value with its original position and provides reversal functionality.\"\"\"\n    def __init__(self, value: str, position: int) -> None:\n        self.value = value\n        self.position = position\n\n    def reverse(self) -> str:\n        \"\"\"Returns the character-wise reversed value of the string.\"\"\"\n        return self.value[::-1]\n\nclass StringList:\n    \"\"\"Represents an ordered collection of StringItem objects and orchestrates their reversal.\"\"\"\n    def __init__(self, items: List[StringItem]) -> None:\n        self.items = items\n\n    @classmethod\n    def from_list(cls, values: List[str]) -> 'StringList':\n        \"\"\"Constructs a StringList from a raw list of strings, assigning positions.\"\"\"\n        items = [StringItem(value, i) for i, value in enumerate(values)]\n        return cls(items)\n\n    def reverse_all(self) -> List[str]:\n        \"\"\"Reverses all contained StringItem values and returns them as a new list.\"\"\"\n        return [item.reverse() for item in self.items]\n\ndef reverse_string_list(input_list: List[str]) -> List[str]:\n    \"\"\"\n    Reverses each string in a given list of string values.\n    Uses domain classes StringItem and StringList as per design.\n    \"\"\"\n    if not input_list:\n        return []\n    \n    string_list_obj = StringList.from_list(input_list)\n    return string_list_obj.reverse_all()"}
{"task_id": "Mbpp/457", "solution": "from typing import List, Any\n\ndef Find_Min(sublists: List[List[Any]]) -> List[Any]:\n    \"\"\"\n    Finds the sublist with the minimum length from a list of sublists.\n    Assumes valid input where sublists is a list of list-like objects.\n    \"\"\"\n    shortest = min(sublists, key=len)\n    return shortest"}
{"task_id": "Mbpp/459", "solution": "class Character:\n    def __init__(self, symbol: str, position: int):\n        self.symbol = symbol\n        self.position = position\n\n    def isUppercase(self) -> bool:\n        \"\"\"Determines if the character is an uppercase alphabetic character.\"\"\"\n        return self.symbol.isupper()\n\nclass UppercaseCharacter(Character):\n    \"\"\"Marker subclass for uppercase characters.\"\"\"\n    pass\n\nclass NonUppercaseCharacter(Character):\n    \"\"\"Marker subclass for non-uppercase characters.\"\"\"\n    pass\n\nclass InputString:\n    \"\"\"Lightweight container for the input string value.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass OutputString:\n    \"\"\"Container for output construction and final value.\"\"\"\n    def __init__(self):\n        self.value = \"\"\n    \n    def append(self, char_symbol: str):\n        \"\"\"Appends a character symbol to the output string.\"\"\"\n        self.value += char_symbol\n\nclass RemoveUppercase:\n    \"\"\"Stateless component to perform the removal algorithm.\"\"\"\n    def remove(self, input_value: str) -> str:\n        \"\"\"Iterates characters and builds the output string by discarding uppercase ones.\"\"\"\n        output_buffer = OutputString()\n        \n        for i, char_symbol in enumerate(input_value):\n            char_obj = Character(char_symbol, i)\n            \n            if not char_obj.isUppercase():\n                output_buffer.append(char_symbol)\n\n        return output_buffer.value\n\ndef remove_uppercase(input: str) -> str:\n    \"\"\"\n    Removes all uppercase alphabetic characters from the given string.\n    Preserves the order of remaining characters.\n    \"\"\"\n    remover = RemoveUppercase()\n    return remover.remove(input)"}
{"task_id": "Mbpp/460", "solution": "def Extract(input_list):\n    \"\"\"\n    Extracts the first element from each sublist in the given list.\n    Assumes input_list contains only sublists and each sublist has at least one element.\n    \"\"\"\n    result = []\n    for sublist in input_list:\n        result.append(sublist[0])\n    return result"}
