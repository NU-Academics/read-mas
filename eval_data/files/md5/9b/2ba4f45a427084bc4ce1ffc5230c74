{"task_id": "Mbpp/445", "solution": "from typing import Tuple\n\ndef _is_numeric(value) -> bool:\n    \"\"\"Checks if a value is an integer or a float.\"\"\"\n    return isinstance(value, (int, float))\n\nclass TupleCollection:\n    \"\"\"Orchestrates validation and index-wise multiplication of two tuple collections.\"\"\"\n    def __init__(self, inputA: Tuple[Tuple, ...], inputB: Tuple[Tuple, ...]) -> None:\n        self.inputA = inputA\n        self.inputB = inputB\n\n    def validateOuterLengths(self) -> None:\n        \"\"\"Ensures that the outer tuples have equal lengths.\"\"\"\n        if len(self.inputA) != len(self.inputB):\n            raise ValueError('Outer length mismatch')\n\n    def validateInnerLengths(self, index: int) -> None:\n        \"\"\"Ensures that inner tuples at a given index have equal lengths.\"\"\"\n        if len(self.inputA[index]) != len(self.inputB[index]):\n            raise ValueError(f'Inner length mismatch at index {index}')\n\n    def validateElementsNumeric(self, index: int, pos: int) -> None:\n        \"\"\"Ensures that elements at a given index and position are numeric.\"\"\"\n        if not _is_numeric(self.inputA[index][pos]):\n            raise ValueError(f'Non-numeric element at index {index}, position {pos}')\n        if not _is_numeric(self.inputB[index][pos]):\n            raise ValueError(f'Non-numeric element at index {index}, position {pos}')\n\n    def multiply(self) -> Tuple[Tuple, ...]:\n        \"\"\"Performs element-wise multiplication and constructs the result tuple of tuples.\"\"\"\n        result_outer_tuple = []\n        for i in range(len(self.inputA)):\n            self.validateInnerLengths(i)\n            \n            result_inner_tuple = []\n            for j in range(len(self.inputA[i])):\n                self.validateElementsNumeric(i, j)\n                product = self.inputA[i][j] * self.inputB[i][j]\n                result_inner_tuple.append(product)\n            result_outer_tuple.append(tuple(result_inner_tuple))\n        \n        return tuple(result_outer_tuple)\n\ndef index_multiplication(inputA: Tuple[Tuple, ...], inputB: Tuple[Tuple, ...]) -> Tuple[Tuple, ...]:\n    \"\"\"\n    Performs index-wise multiplication of tuple elements in two given tuples.\n    Validates tuple lengths and element types before multiplication.\n    \"\"\"\n    tc = TupleCollection(inputA, inputB)\n    tc.validateOuterLengths()\n    return tc.multiply()"}
{"task_id": "Mbpp/448", "solution": "class PerrinSequence:\n    P0: int = 3\n    P1: int = 0\n    P2: int = 2\n\n    def __init__(self):\n        \"\"\"Initializes the PerrinSequence with base values and a memoization cache.\"\"\"\n        self._cache = {0: self.P0, 1: self.P1, 2: self.P2}\n\n    def getValue(self, n: int) -> int:\n        \"\"\"Return P(n) computed per Perrin rules, using memoization.\"\"\"\n        if n in self._cache:\n            return self._cache[n]\n\n        # Extend cache to compute P(n) iteratively if n is beyond current max cached index.\n        max_cached_idx = max(self._cache.keys())\n        for i in range(max_cached_idx + 1, n + 1):\n            self._cache[i] = self._cache[i-2] + self._cache[i-3]\n            \n        return self._cache[n]\n\n    def sumUpTo(self, n: int) -> int:\n        \"\"\"Return integer sum P(0) + ... + P(n).\"\"\"\n        current_sum = 0\n        for i in range(n + 1):\n            current_sum += self.getValue(i)\n        return current_sum\n\nclass PerrinCalculator:\n    def __init__(self, sequence: PerrinSequence | None = None):\n        \"\"\"Initializes PerrinCalculator, optionally with a custom PerrinSequence instance.\"\"\"\n        self.sequence = sequence if sequence is not None else PerrinSequence()\n\n    def cal_sum(self, n: int) -> int:\n        \"\"\"Compute and return integer sum of Perrin numbers 0..n inclusive.\"\"\"\n        return self.sequence.sumUpTo(n)\n\ndef cal_sum(n: int) -> int:\n    \"\"\"Public API function to calculate the sum of Perrin numbers P(0) through P(n).\"\"\"\n    calculator = PerrinCalculator()\n    return calculator.cal_sum(n)"}
{"task_id": "Mbpp/450", "solution": "from typing import List\n\ndef extract_string(input_list: List[str], size: int) -> List[str]:\n    \"\"\"\n    Extracts strings of a specified length from a list of strings.\n    Raises TypeError or ValueError for invalid input types or values.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"input_list must be a list\")\n    if not isinstance(size, int):\n        raise TypeError(\"size must be an int\")\n    if size < 0:\n        raise ValueError(\"size must be non-negative\")\n\n    result = []\n    for element in input_list:\n        if not isinstance(element, str):\n            raise TypeError(\"all elements of input_list must be str\")\n        if len(element) == size:\n            result.append(element)\n    return result"}
{"task_id": "Mbpp/451", "solution": "WHITESPACE_SET = {' ', '\\t', '\\n', '\\r'}\n\ndef remove_whitespaces(input: str) -> str:\n    \"\"\"Removes specified whitespace characters from the input string.\"\"\"\n    result_chars = []\n    for ch in input:\n        if ch not in WHITESPACE_SET:\n            result_chars.append(ch)\n    return ''.join(result_chars)"}
{"task_id": "Mbpp/453", "solution": "def sumofFactors(n: int) -> int:\n    \"\"\"\n    Computes the sum of all even positive factors of a given integer n.\n    \"\"\"\n\n    def _is_even(d: int) -> bool:\n        \"\"\"Checks if an integer is even.\"\"\"\n        return d % 2 == 0\n\n    def _find_positive_divisors(num_val: int) -> list[int]:\n        \"\"\"Finds all positive integer divisors of a number.\"\"\"\n        if num_val == 0:\n            return []\n        \n        num = abs(num_val)\n        divs = []\n        i = 1\n        while i * i <= num:\n            if num % i == 0:\n                divs.append(i)\n                if i * i != num:\n                    divs.append(num // i)\n            i += 1\n        return divs\n\n    all_divs = _find_positive_divisors(n)\n    even_factors_sum = 0\n    for factor in all_divs:\n        if _is_even(factor):\n            even_factors_sum += factor\n            \n    return even_factors_sum"}
{"task_id": "Mbpp/454", "solution": "import re\n\ndef text_match_wordz(text):\n    \"\"\"\n    Checks if the input text contains at least one word with the lowercase letter 'z'.\n    Words are considered contiguous alphabetic runs, ignoring adjacent punctuation.\n    \"\"\"\n    # Find all contiguous alphabetic sequences (words). This handles splitting by\n    # whitespace and non-alphabetic characters, and effectively ignores leading/trailing\n    # punctuation as the regex only matches letters.\n    words = re.findall(r'[a-zA-Z]+', text)\n\n    for word in words:\n        # Check if the lowercase letter 'z' is present in the word.\n        # This is case-sensitive as per design (BR-5).\n        if 'z' in word:\n            return True\n            \n    return False"}
