{"task_id": "Mbpp/392", "solution": "_memo: dict[int, int] = {0: 0}\n\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Computes the maximum sum possible by applying the recurrence relation:\n    f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n), with f(0) = 0.\n    \"\"\"\n    if n in _memo:\n        return _memo[n]\n\n    # Recursively compute the sum of parts using floor division.\n    sum_of_parts = (\n        get_max_sum(n // 2) +\n        get_max_sum(n // 3) +\n        get_max_sum(n // 4) +\n        get_max_sum(n // 5)\n    )\n\n    # Determine the maximum between the sum of parts and n itself.\n    result = max(sum_of_parts, n)\n\n    _memo[n] = result\n    return result"}
{"task_id": "Mbpp/395", "solution": "from typing import Optional\n\ndef first_non_repeating_character(input_str: str) -> Optional[str]:\n    \"\"\"\n    Finds the first non-repeated character in a given string.\n    Returns None if no such character exists.\n    \"\"\"\n    char_counts = {}\n\n    # First pass: Populate the frequency map\n    for char in input_str:\n        char_counts[char] = char_counts.get(char, 0) + 1\n\n    # Second pass: Find the first character with a count of 1\n    for char in input_str:\n        if char_counts[char] == 1:\n            return char\n\n    # If no non-repeating character is found, return None\n    return None"}
{"task_id": "Mbpp/397", "solution": "def _is_number(value):\n    \"\"\"Checks if a value is an int or float, excluding boolean.\"\"\"\n    return isinstance(value, (int, float)) and not isinstance(value, bool)\n\nclass Validator:\n    \"\"\"Provides validation methods for numeric inputs.\"\"\"\n    def validateNumeric(self, a, b, c):\n        \"\"\"Returns True if all inputs are numeric (int or float, not bool), False otherwise.\"\"\"\n        return _is_number(a) and _is_number(b) and _is_number(c)\n\nclass NumericInput:\n    \"\"\"Represents the three numeric inputs.\"\"\"\n    def __init__(self, a, b, c):\n        self.a = a\n        self.b = b\n        self.c = c\n\n    def isNumeric(self):\n        \"\"\"Delegates numeric validation to the Validator.\"\"\"\n        return Validator().validateNumeric(self.a, self.b, self.c)\n\nclass MedianResult:\n    \"\"\"Encapsulates the median value as a float.\"\"\"\n    def __init__(self, value: float):\n        self.value = float(value)\n\ndef median_numbers(a, b, c):\n    \"\"\"\n    Finds the median of three numbers, returning it as a float.\n    Raises TypeError if any input is non-numeric.\n    \"\"\"\n    numeric_inputs = NumericInput(a, b, c)\n    validator = Validator()\n\n    if not validator.validateNumeric(a, b, c):\n        raise TypeError(\"invalid input: non-numeric\")\n\n    # Convert all inputs to float before sorting to ensure consistent type and handling\n    numbers = [float(a), float(b), float(c)]\n    numbers.sort()\n    \n    median_val = numbers[1]\n    result = MedianResult(median_val)\n    return result.value"}
{"task_id": "Mbpp/398", "solution": "from typing import List\n\ndef _digits_of(n: int) -> List[int]:\n    \"\"\"\n    Extracts decimal digits of a non-negative integer n.\n    Returns a list of integers, where each element is a digit.\n    \"\"\"\n    return [int(digit) for digit in str(n)]\n\nclass Number:\n    \"\"\"Encapsulates an integer value and provides digit-related operations.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def digits(self) -> List[int]:\n        \"\"\"Returns a list of decimal digits for the encapsulated number.\"\"\"\n        return _digits_of(self.value)\n\n    def digits_sum(self) -> int:\n        \"\"\"Computes the sum of decimal digits for the encapsulated number.\"\"\"\n        return sum(self.digits())\n\nclass NumberList:\n    \"\"\"Wraps a list of integers and provides conversion to Number instances.\"\"\"\n    def __init__(self, numbers: List[int]) -> None:\n        self.numbers = numbers\n\n    def to_numbers(self) -> List[Number]:\n        \"\"\"Converts the list of raw integers into a list of Number objects.\"\"\"\n        return [Number(num) for num in self.numbers]\n\ndef sum_of_digits(numbers: List[int]) -> int:\n    \"\"\"\n    Computes the sum of digits of each number of a given list.\n    It sums the decimal digits for each number, then accumulates these sums.\n    \"\"\"\n    total_sum = 0\n    number_list_obj = NumberList(numbers)\n    number_objects = number_list_obj.to_numbers()\n\n    for number_obj in number_objects:\n        total_sum += number_obj.digits_sum()\n\n    return total_sum"}
