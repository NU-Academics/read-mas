{"task_id": "Mbpp/223", "solution": "class Element:\n    def __init__(self, value):\n        self.value = value\n\nclass SortedArray:\n    def __init__(self, elements: list, n: int):\n        self.elements = elements\n        self.n = n\n\n    def get_subarray(self) -> list:\n        \"\"\"Returns the prefix of the elements list up to self.n.\"\"\"\n        return self.elements[:self.n]\n\nclass InputValidator:\n    def validate_sorted(self, array: SortedArray) -> bool:\n        \"\"\"Checks if the elements in the array are sorted in non-decreasing order.\"\"\"\n        elements = array.elements\n        for i in range(1, len(elements)):\n            if elements[i] < elements[i-1]:\n                return False\n        return True\n\n    def validate_length(self, array: SortedArray, n: int) -> bool:\n        \"\"\"Checks if n is a valid length for the array.\"\"\"\n        return 0 <= n <= len(array.elements)\n\nclass MajorityChecker:\n    def is_majority(self, array: SortedArray, n: int, x: Element) -> bool:\n        \"\"\"Determines if an element is the majority element in the given sorted array prefix.\"\"\"\n        validator = InputValidator()\n        if not validator.validate_sorted(array):\n            return False\n        if not validator.validate_length(array, n):\n            return False\n\n        # Get the prefix of the array up to n elements\n        prefix = array.get_subarray()\n\n        # Count occurrences of x.value in the prefix\n        count = 0\n        for item in prefix:\n            if item == x.value:\n                count += 1\n        \n        # Check if the count strictly exceeds n/2\n        return count > (n / 2)\n\ndef is_majority(array, n, x):\n    \"\"\"\n    Checks if an element is the majority element in a sorted array.\n    \"\"\"\n    # Wrap raw inputs into domain objects as specified by the design.\n    arr = array if isinstance(array, SortedArray) else SortedArray(array, n)\n    elt = x if isinstance(x, Element) else Element(x)\n    \n    # Delegate the check to the MajorityChecker.\n    checker = MajorityChecker()\n    return checker.is_majority(arr, n, elt)"}
{"task_id": "Mbpp/230", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass InputString:\n    value: str\n    def length(self) -> int:\n        return len(self.value)\n\n@dataclass\nclass ReplacementCharacter:\n    value: str\n\n@dataclass\nclass ResultString:\n    value: str\n\nclass ReplaceBlankFunction:\n    def __init__(self, input: InputString, replacement: ReplacementCharacter):\n        self.input = input\n        self.replacement = replacement\n\n    def execute(self) -> ResultString:\n        transformed_chars = []\n        for char in self.input.value:\n            if char == ' ':\n                transformed_chars.append(self.replacement.value)\n            else:\n                transformed_chars.append(char)\n        return ResultString(\"\".join(transformed_chars))\n\ndef replace_blank(input_string: str, replacement_char: str) -> str:\n    \"\"\"Top-level API: replaces ASCII space ' ' with replacement_char and returns the new string.\"\"\"\n    input_obj = InputString(value=input_string)\n    replacement_obj = ReplacementCharacter(value=replacement_char)\n    \n    replacer = ReplaceBlankFunction(input=input_obj, replacement=replacement_obj)\n    result_obj = replacer.execute()\n    \n    return result_obj.value"}
{"task_id": "Mbpp/232", "solution": "from typing import List, Any\n\ndef _distinct(items: List[Any]) -> List[Any]:\n    \"\"\"Produces a list of distinct items from an iterable using equality.\n    The order of distinct items is not guaranteed to be stable but is acceptable.\n    \"\"\"\n    return list(set(items))\n\ndef _n_largest(items: List[Any], n: int) -> List[Any]:\n    \"\"\"Selects the n largest items from a list of comparable items.\n    Items are sorted in descending order and then the top n are returned.\n    \"\"\"\n    sorted_items = sorted(items, reverse=True)\n    return sorted_items[:n]\n\ndef larg_nnum(lst: List[Any], n: int) -> List[Any]:\n    \"\"\"Return a list containing the n largest distinct items from lst.\n    Parameters: lst (list of comparable items), n (int)\n    Returns: list of items (order not significant)\n    \"\"\"\n    if n <= 0:\n        return []\n\n    distinct_items = _distinct(lst)\n\n    if n >= len(distinct_items):\n        return _n_largest(distinct_items, len(distinct_items))\n    else:\n        return _n_largest(distinct_items, n)"}
{"task_id": "Mbpp/234", "solution": "def volume_cube(side_length):\n    \"\"\"Calculates the volume of a cube given its side length.\"\"\"\n\n    def is_numeric(value):\n        \"\"\"Checks if a value is an integer or a float.\"\"\"\n        return isinstance(value, (int, float))\n\n    class Cube:\n        \"\"\"Represents a cube with a given side length and calculates its volume.\"\"\"\n        def __init__(self, side_length: float):\n            self.side_length = side_length\n\n        def volume(self) -> float:\n            \"\"\"Calculates the volume of the cube.\"\"\"\n            return self.side_length * self.side_length * self.side_length\n\n    if not is_numeric(side_length):\n        raise ValueError(\"side_length must be numeric\")\n\n    c = Cube(side_length)\n    return c.volume()"}
{"task_id": "Mbpp/233", "solution": "import math\n\ndef lateralsuface_cylinder(height, radius):\n    \"\"\"Compute and return lateral surface area = 2 * math.pi * radius * height.\n\n    Args:\n        height: numeric (int or float) representing cylinder height\n        radius: numeric (int or float) representing cylinder radius\n\n    Returns:\n        float: lateral surface area computed using math.pi\n    \"\"\"\n    return 2 * math.pi * radius * height"}
{"task_id": "Mbpp/235", "solution": "class IntegerNumber:\n    \"\"\"\n    Internal helper class to wrap an integer and provide its bit length.\n    \"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def bit_length(self) -> int:\n        \"\"\"\n        Returns the number of bits required to represent the integer, excluding the sign and leading zeros.\n        \"\"\"\n        return self.value.bit_length()\n\nclass BitMask:\n    \"\"\"\n    Internal helper class to generate a bitmask with even-positioned bits set.\n    Positions are 1-indexed from the Least Significant Bit (LSB).\n    \"\"\"\n    @staticmethod\n    def generate_mask(length: int) -> int:\n        \"\"\"\n        Generates an integer mask with bits at positions 2, 4, 6,... set up to the given bit length.\n        \"\"\"\n        mask = 0\n        # Iterate through bit indices (0-indexed).\n        # Even positions (2, 4, 6, ...) correspond to odd indices (1, 3, 5, ...).\n        for i in range(1, length):\n            if (i + 1) % 2 == 0:  # Check if the 1-indexed position (i+1) is even.\n                mask |= (1 << i)\n        return mask\n\nclass EvenBitSetFunction:\n    \"\"\"\n    Internal class encapsulating the logic for setting even bits of a number.\n    It orchestrates the use of IntegerNumber and BitMask helpers.\n    \"\"\"\n    @staticmethod\n    def even_bit_set_number(n: int) -> int:\n        \"\"\"\n        Computes the result by generating a mask for even bits and applying it to the input number.\n        \"\"\"\n        # Wrap the input number to determine its bit length.\n        num_wrapper = IntegerNumber(n)\n        length = num_wrapper.bit_length()\n\n        # Generate a mask with even-positioned bits set based on the number's length.\n        mask = BitMask.generate_mask(length)\n\n        # Apply the generated mask using a bitwise OR operation.\n        return n | mask\n\ndef even_bit_set_number(n: int) -> int:\n    \"\"\"\n    Sets all even-positioned bits of a given number to 1.\n    Positions are counted from 1 at the least significant bit (LSB).\n    \"\"\"\n    return EvenBitSetFunction.even_bit_set_number(n)"}
{"task_id": "Mbpp/237", "solution": "from typing import List, Tuple as TypingTuple, Dict, Iterator\nfrom collections import defaultdict\n\nclass NormalizedTuple:\n    \"\"\"Immutable value object representing a normalized pair (non-decreasing order).\"\"\"\n    def __init__(self, first, second):\n        self.first = first\n        self.second = second\n\n    def as_tuple(self) -> TypingTuple:\n        \"\"\"Returns the normalized pair as a standard tuple.\"\"\"\n        return (self.first, self.second)\n\n    def __eq__(self, other):\n        if not isinstance(other, NormalizedTuple):\n            return NotImplemented\n        return self.first == other.first and self.second == other.second\n\n    def __hash__(self):\n        return hash((self.first, self.second))\n\n    def __repr__(self):\n        return f\"NormalizedTuple({self.first!r}, {self.second!r})\"\n\nclass Tuple:\n    \"\"\"Domain representation of a single raw tuple-like entry; handles validation and normalization.\"\"\"\n    def __init__(self, raw: TypingTuple):\n        if not isinstance(raw, TypingTuple):\n            raise TypeError(\"Each element in the input list must be a tuple.\")\n        if len(raw) != 2:\n            raise ValueError(f\"Each tuple must have exactly 2 elements, but found {len(raw)} in {raw}.\")\n        self._raw = raw\n\n    def normalize(self) -> NormalizedTuple:\n        \"\"\"Normalizes the tuple elements to non-decreasing order.\"\"\"\n        try:\n            a, b = sorted(self._raw)\n        except TypeError as e:\n            raise TypeError(f\"Elements in tuple {self._raw} are not comparable: {e}\") from e\n        return NormalizedTuple(a, b)\n\nclass InputList:\n    \"\"\"Encapsulates input validation for the list structure and yields Tuple domain objects.\"\"\"\n    def __init__(self, items: List[object]):\n        if not isinstance(items, list):\n            raise TypeError(\"Input must be a list.\")\n        self._items = items\n\n    def validate(self) -> None:\n        \"\"\"Validates that each item in the list is a 2-element tuple.\"\"\"\n        for item in self._items:\n            _ = Tuple(item) # Tuple constructor performs individual item validation\n\n    def iter_tuples(self) -> Iterator[Tuple]:\n        \"\"\"Yields Tuple domain objects for each item in the input list.\"\"\"\n        for item in self._items:\n            yield Tuple(item)\n\nclass OutputDictionary:\n    \"\"\"In-memory aggregator mapping normalized tuple keys to integer counts.\"\"\"\n    def __init__(self):\n        self._mapping: Dict[TypingTuple, int] = defaultdict(int)\n\n    def increment(self, normalized: NormalizedTuple) -> None:\n        \"\"\"Increments the count for a given normalized tuple.\"\"\"\n        self._mapping[normalized.as_tuple()] += 1\n\n    def as_dict(self) -> Dict[TypingTuple, int]:\n        \"\"\"Returns the aggregated counts as a standard dictionary.\"\"\"\n        return dict(self._mapping)\n\nclass CheckOccurrences:\n    \"\"\"Orchestrator facade for the occurrence counting process.\"\"\"\n    @classmethod\n    def check_occurences(cls, input_list: List[TypingTuple]) -> Dict[TypingTuple, int]:\n        \"\"\"\n        Orchestrates input validation, tuple normalization, and count aggregation.\n        \"\"\"\n        input_list_obj = InputList(input_list)\n        input_list_obj.validate()\n\n        output_dict_aggregator = OutputDictionary()\n\n        for tuple_obj in input_list_obj.iter_tuples():\n            normalized_tuple = tuple_obj.normalize()\n            output_dict_aggregator.increment(normalized_tuple)\n\n        return output_dict_aggregator.as_dict()\n\ndef check_occurences(input_list: List[TypingTuple]) -> Dict[TypingTuple, int]:\n    \"\"\"\n    Takes a list of tuples and returns a dictionary mapping each unique\n    normalized tuple to its occurrence count.\n    \"\"\"\n    return CheckOccurrences.check_occurences(input_list)"}
{"task_id": "Mbpp/238", "solution": "class SubstringCounter:\n    \"\"\"Helper class to encapsulate substring counting logic.\"\"\"\n    def formulaCount(self, n: int) -> int:\n        \"\"\"Calculates the number of non-empty substrings for a string of length n.\"\"\"\n        return n * (n + 1) // 2\n\n    def number_of_substrings(self, s: str) -> int:\n        \"\"\"Counts the number of non-empty substrings in the given string.\"\"\"\n        n = len(s)\n        if n == 0:\n            return 0\n        return self.formulaCount(n)\n\ndef number_of_substrings(s: str) -> int:\n    \"\"\"\n    Counts the number of non-empty substrings of a given string.\n    Delegates the counting logic to an internal SubstringCounter instance.\n    \"\"\"\n    counter = SubstringCounter()\n    return counter.number_of_substrings(s)"}
{"task_id": "Mbpp/240", "solution": "def replace_list(first_list, second_list):\n    \"\"\"Return a list equal to first_list without its last element concatenated with second_list.\n\n    New list containing first_list[0:-1] followed by elements of second_list is returned.\n    \"\"\"\n    head = first_list[0:-1]\n    tail = list(second_list)\n    return head + tail"}
{"task_id": "Mbpp/239", "solution": "class InputValidator:\n    \"\"\"\n    Validates input parameters m and n.\n    Raises ValueError if inputs are not positive integers.\n    \"\"\"\n    @staticmethod\n    def validate(m, n):\n        if not isinstance(m, int) or m <= 0:\n            raise ValueError(\"m must be a positive integer.\")\n        if not isinstance(n, int) or n <= 0:\n            raise ValueError(\"n must be a positive integer.\")\n\nclass SequenceCounter:\n    \"\"\"\n    Counts sequences satisfying the given constraints using dynamic programming with memoization.\n    \"\"\"\n    def __init__(self):\n        self.memo = {} # Caches results of subproblems.\n\n    def _count_from_start(self, current_element_value, remaining_length, m):\n        \"\"\"\n        Recursively counts valid sequence completions.\n        `current_element_value` is the last element added, `remaining_length` is how many more elements are needed.\n        \"\"\"\n        if (current_element_value, remaining_length) in self.memo:\n            return self.memo[(current_element_value, remaining_length)]\n\n        if remaining_length == 0:\n            return 1 # A valid sequence of the required length has been formed.\n\n        count = 0\n        next_min_val = 2 * current_element_value\n        for next_element_value in range(next_min_val, m + 1):\n            count += self._count_from_start(next_element_value, remaining_length - 1, m)\n\n        self.memo[(current_element_value, remaining_length)] = count\n        return count\n\n    def get_total_number_of_sequences(self, m, n):\n        \"\"\"\n        Initializes the counting process by iterating possible first elements.\n        \"\"\"\n        total_sequences = 0\n        for start_value in range(1, m + 1):\n            total_sequences += self._count_from_start(start_value, n - 1, m)\n        return total_sequences\n\ndef get_total_number_of_sequences(m, n):\n    \"\"\"\n    Finds the number of possible sequences of length n, such that each element is a positive integer\n    and is greater than or equal to twice the previous element but less than or equal to m.\n    \"\"\"\n    InputValidator.validate(m, n)\n\n    if n == 1:\n        return m\n\n    counter = SequenceCounter()\n    return counter.get_total_number_of_sequences(m, n)"}
{"task_id": "Mbpp/244", "solution": "import math\n\ndef next_Perfect_Square(n):\n    \"\"\"\n    Finds the next perfect square strictly greater than the given number.\n    It calculates the integer square root and increments it if needed.\n    \"\"\"\n    k = math.isqrt(int(n))\n\n    # Increment k if k*k is not strictly greater than n, then return k*k.\n    if k * k <= n:\n        k += 1\n\n    return k * k"}
{"task_id": "Mbpp/242", "solution": "class InputString:\n    \"\"\"Domain data holder for input text.\"\"\"\n    def __init__(self, text: str) -> None:\n        self._text = text\n        self._length = len(text)\n\n    def get_text(self) -> str:\n        return self._text\n\n    def get_length(self) -> int:\n        return self._length\n\nclass CountResult:\n    \"\"\"Domain data holder for numeric result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self._value = value\n\n    def get_value(self) -> int:\n        return self._value\n\nclass CharacterCounter:\n    \"\"\"Encapsulates counting behavior; stateless domain service.\"\"\"\n    def count_input_string(self, input_obj: InputString) -> CountResult:\n        \"\"\"Accepts an InputString and produces a CountResult.\"\"\"\n        return CountResult(input_obj.get_length())\n\ndef count_charac(input: str) -> int:\n    \"\"\"Counts the total number of characters in a string, including spaces and punctuation.\"\"\"\n    input_string_obj = InputString(input)\n    counter = CharacterCounter()\n    result = counter.count_input_string(input_string_obj)\n    return result.get_value()"}
{"task_id": "Mbpp/245", "solution": "import math\nfrom typing import List\n\ndef max_sum(array: List[int]) -> int:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence in the given array.\n    A sequence is bitonic if it is first strictly increasing and then strictly decreasing.\n    \"\"\"\n    if not array:\n        return 0\n\n    # Input validation as per design, but simplified to avoid isinstance() check here per prompt\n    # and assume array is List[int] from type hints.\n    # The design says to raise TypeError, but prompt says \"Do NOT add isinstance() checks or raise exceptions\".\n    # Relying on type hints and external validation for this function boundary.\n\n    n = len(array)\n    if n == 0:\n        return 0\n\n    # _compute_inc_sums: max sum of strictly increasing subsequence ending at each index\n    inc_sums = array.copy()\n    for i in range(n):\n        for j in range(i):\n            if array[j] < array[i]:\n                inc_sums[i] = max(inc_sums[i], inc_sums[j] + array[i])\n\n    # _compute_dec_sums: max sum of strictly decreasing subsequence starting at each index\n    dec_sums = array.copy()\n    for i in range(n - 1, -1, -1):\n        for j in range(n - 1, i, -1):\n            if array[j] < array[i]:\n                dec_sums[i] = max(dec_sums[i], dec_sums[j] + array[i])\n\n    max_bitonic_sum = 0\n    # Combine inc and dec sums, subtracting the peak element once\n    for i in range(n):\n        current_bitonic_sum = inc_sums[i] + dec_sums[i] - array[i]\n        max_bitonic_sum = max(max_bitonic_sum, current_bitonic_sum)\n    \n    # If the array consists only of a strictly increasing or strictly decreasing sequence\n    # where no bitonic sequence (peak + non-empty decreasing/increasing part) could be formed,\n    # max_bitonic_sum would be simply the max of (inc_sums[i] + dec_sums[i] - array[i]) for all i.\n    # The prompt implies a non-empty array will always yield a non-negative sum if elements are positive.\n    # Given the example (1, 15, 51, 45, 33, 100, 12, 18, 9), the minimum single-element sum is 1.\n    # If all elements are negative, 0 could be returned if no valid subsequence exists\n    # or the max single element if that's the only option.\n    # However, the problem implies positive numbers for sum.\n    # If array is e.g., [5, 4, 3, 2, 1] then dec_sums[0] is 5+4+3+2+1, inc_sums[0] is 5.\n    # If array is e.g., [1, 2, 3, 4, 5] then inc_sums[4] is 1+2+3+4+5, dec_sums[4] is 5.\n    # So max_bitonic_sum would correctly capture these cases as \"bitonic\" sequences with one part empty.\n    # The definition \"first increasing and then decreasing\" implies both parts exist if length > 1.\n    # But standard DP solutions usually allow one part to be empty, e.g., strictly increasing sequence is bitonic.\n    # Based on the assert, 194 is expected, which implies `1 + 15 + 51 + 100 + 18 + 9` for index 5 (100).\n    # inc_sums[5] would be 1+15+51+100 = 167\n    # dec_sums[5] for 100 decreasing to 9 would be 100+18+9 = 127\n    # So 167 + 127 - 100 = 194. This logic seems correct for the example.\n\n    return max_bitonic_sum"}
{"task_id": "Mbpp/251", "solution": "def insert_element(inputList, element) -> list:\n    \"\"\"Return a new list where `element` appears immediately before each item in `inputList`.\n    The resulting list preserves the order of the original elements.\n    \"\"\"\n    result_list = []\n    for item in inputList:\n        result_list.append(element)\n        result_list.append(item)\n    return result_list"}
{"task_id": "Mbpp/252", "solution": "import math\nfrom dataclasses import dataclass\nfrom typing import Tuple\nimport numbers\n\n@dataclass\nclass ComplexInput:\n    real: float\n    imag: float\n\n@dataclass\nclass PolarCoordinate:\n    r: float\n    theta: float\n\ndef convert(value) -> Tuple[float, float]:\n    \"\"\"Convert numeric or complex input to polar coordinates (r, theta).\n\n    Raises TypeError for inputs that are neither numeric nor complex types.\n    \"\"\"\n    if isinstance(value, numbers.Real):\n        complex_input = ComplexInput(real=float(value), imag=0.0)\n    elif isinstance(value, numbers.Complex):\n        complex_input = ComplexInput(real=float(value.real), imag=float(value.imag))\n    else:\n        raise TypeError(\"Input must be a numeric or complex type.\")\n\n    r = math.hypot(complex_input.real, complex_input.imag)\n    theta = math.atan2(complex_input.imag, complex_input.real)\n\n    if r == 0.0:\n        theta = 0.0 # Ensure deterministic behavior for zero magnitude.\n\n    return (float(r), float(theta))"}
{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"\n    Finds the length of the longest palindromic subsequence in the given string.\n    Uses dynamic programming with O(n^2) time and space complexity.\n    \"\"\"\n    n = len(s)\n    if n == 0:\n        return 0\n\n    # dp[i][j] stores the length of the longest palindromic subsequence of s[i...j]\n    dp = [[0] * n for _ in range(n)]\n\n    # Base case: A single character is a palindrome of length 1\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the DP table for substrings of length 2 to n\n    # 'current_len' represents the length of the substring being considered\n    for current_len in range(2, n + 1):\n        for i in range(n - current_len + 1):\n            j = i + current_len - 1 # 'j' is the end index of the current substring s[i...j]\n\n            if s[i] == s[j]:\n                # If outer characters match, they contribute 2 to the LPS.\n                # The remaining LPS is found in the inner substring s[i+1...j-1].\n                # If current_len is 2, dp[i+1][j-1] corresponds to an empty string (value 0).\n                dp[i][j] = 2 + dp[i+1][j-1]\n            else:\n                # If outer characters do not match, take the maximum LPS\n                # by either excluding s[i] or excluding s[j].\n                dp[i][j] = max(dp[i+1][j], dp[i][j-1])\n\n    # The result for the entire string s[0...n-1] is at dp[0][n-1]\n    return dp[0][n-1]"}
{"task_id": "Mbpp/253", "solution": "def count_integer(elements):\n    \"\"\"\n    Counts the number of integer elements in a list.\n    Raises TypeError if the input is not a list.\n    \"\"\"\n    if not isinstance(elements, list):\n        raise TypeError(\"elements must be a list\")\n\n    count = 0\n    for elem in elements:\n        if isinstance(elem, int):\n            count += 1\n    return count"}
{"task_id": "Mbpp/250", "solution": "def count_X(input_tuple: tuple, element) -> int:\n    \"\"\"Return the number of occurrences of element in input_tuple.\n\n    Parameters:\n      input_tuple: tuple -- a Python tuple containing zero or more elements\n      element: any -- value to compare with tuple elements using Python equality (==)\n\n    Returns:\n      int -- non-negative count of occurrences (0 if none)\n    \"\"\"\n    return input_tuple.count(element)"}
{"task_id": "Mbpp/255", "solution": "def validate_inputs(elements, n):\n    \"\"\"Validate inputs per BR1.\n    Raises TypeError if type checks fail, ValueError if n < 0.\n    \"\"\"\n    if not isinstance(elements, list):\n        raise TypeError(\"First argument 'elements' must be a list per BR1\")\n    if not isinstance(n, int):\n        raise TypeError(\"Second argument 'n' must be an int per BR1\")\n    if n < 0:\n        raise ValueError(\"'n' must be non-negative\")\n\ndef generate_combinations(elements, n):\n    \"\"\"Return list of tuples containing all length-n combinations with repetition.\n    Produces order-equivalent to itertools.product(elements, repeat=n).\n    \"\"\"\n    if n == 0:\n        return [()]\n    if not elements:\n        return []\n    result = [[]]\n    for _ in range(n):\n        new = []\n        for prefix in result:\n            for e in elements:\n                new.append(prefix + [e])\n        result = new\n    return [tuple(r) for r in result]\n\ndef combinations_colors(elements, n):\n    \"\"\"Validate inputs, generate combinations, and return list of tuples.\"\"\"\n    validate_inputs(elements, n)\n    return generate_combinations(elements, n)"}
{"task_id": "Mbpp/256", "solution": "import math\n\nclass InvalidInputException(ValueError):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass CountResult:\n    \"\"\"A data holder for the count of prime numbers.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass InputValidator:\n    \"\"\"Validates input numbers for non-negativity.\"\"\"\n    def validate_non_negative(self, n) -> None:\n        \"\"\"Raises InvalidInputException if n is negative.\"\"\"\n        if n < 0:\n            raise InvalidInputException('Input must be a non-negative number.')\n\nclass PrimeChecker:\n    \"\"\"Determines if a given integer is a prime number.\"\"\"\n    def is_prime(self, k: int) -> bool:\n        \"\"\"Checks if an integer k is prime using trial division.\"\"\"\n        if k < 2:\n            return False\n        if k == 2:\n            return True\n        if k % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(k)) + 1, 2):\n            if k % i == 0:\n                return False\n        return True\n\nclass PrimeCounter:\n    \"\"\"Orchestrates prime counting by validating input, generating candidates, and checking primality.\"\"\"\n    def __init__(self, validator: 'InputValidator' = None, prime_checker: 'PrimeChecker' = None):\n        self.validator = validator or InputValidator()\n        self.prime_checker = prime_checker or PrimeChecker()\n\n    def count_Primes_nums(self, n) -> int:\n        \"\"\"Counts prime numbers less than n.\"\"\"\n        self.validate(n)\n        candidates = self.generate_candidates(n)\n        primes = [k for k in candidates if self.prime_checker.is_prime(k)]\n        result = CountResult(self.count(primes))\n        return result.value\n\n    def validate(self, n) -> None:\n        \"\"\"Validates the input number n.\"\"\"\n        self.validator.validate_non_negative(n)\n\n    def generate_candidates(self, n) -> list:\n        \"\"\"Generates a list of integer candidates from 2 up to (but not including) n.\"\"\"\n        return list(range(2, int(n)))\n\n    def count(self, prime_list: list) -> int:\n        \"\"\"Returns the count of primes in the given list.\"\"\"\n        return len(prime_list)\n\ndef count_Primes_nums(n) -> int:\n    \"\"\"\n    Counts the number of prime numbers strictly less than the given non-negative number.\n    \"\"\"\n    pc = PrimeCounter()\n    return pc.count_Primes_nums(n)"}
{"task_id": "Mbpp/257", "solution": "def _validate_numeric(a, b) -> None:\n    \"\"\"Raise TypeError if either a or b is not an int or float.\"\"\"\n    if not isinstance(a, (int, float)):\n        raise TypeError(\"First argument must be a number (int or float).\")\n    if not isinstance(b, (int, float)):\n        raise TypeError(\"Second argument must be a number (int or float).\")\n\ndef swap_numbers(a, b) -> tuple:\n    \"\"\"Return a tuple (b, a). Validate inputs are numeric and raise TypeError for invalid types.\"\"\"\n    _validate_numeric(a, b)\n    return (b, a)"}
{"task_id": "Mbpp/259", "solution": "def maximize_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Maximizes elements of two tuples of 2-tuples on an element-wise basis.\n\n    Validates input lengths and element shapes, then computes the maximum for each\n    corresponding element in the nested tuples.\n    \"\"\"\n    if len(a) != len(b):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n    result_list = []\n    for i in range(len(a)):\n        pair_a = a[i]\n        pair_b = b[i]\n\n        if not isinstance(pair_a, tuple):\n            raise TypeError(f\"Element at index {i} in first input is not a tuple: {pair_a!r}\")\n        if len(pair_a) != 2:\n            raise ValueError(f\"Element at index {i} in first input is not a 2-tuple: {pair_a!r}\")\n\n        if not isinstance(pair_b, tuple):\n            raise TypeError(f\"Element at index {i} in second input is not a tuple: {pair_b!r}\")\n        if len(pair_b) != 2:\n            raise ValueError(f\"Element at index {i} in second input is not a 2-tuple: {pair_b!r}\")\n\n        max_first = max(pair_a[0], pair_b[0])\n        max_second = max(pair_a[1], pair_b[1])\n        result_list.append((max_first, max_second))\n\n    return tuple(result_list)"}
{"task_id": "Mbpp/262", "solution": "from typing import List, Any, Tuple\n\ndef split_two_parts(input_list: List[Any], L: int) -> Tuple[List[Any], List[Any]]:\n    \"\"\"Return a tuple (first_part, second_part) where first_part == input_list[0:L] and second_part == input_list[L:].\n\n    Behavior for L < 0 or L > len(input_list) is unspecified by SRS (BR8) and relies on Python slicing.\n    \"\"\"\n    first_part = input_list[0:L]\n    second_part = input_list[L:]\n    return (first_part, second_part)"}
{"task_id": "Mbpp/261", "solution": "def division_elements(numerator_tuple, denominator_tuple):\n    \"\"\"\n    Performs element-wise division on two tuples after validating inputs.\n    Raises TypeError, ValueError, or ZeroDivisionError for invalid inputs.\n    \"\"\"\n\n    def isNumeric(value):\n        \"\"\"Checks if a value is an integer or a float.\"\"\"\n        return isinstance(value, (int, float))\n\n    def validateInputs(numerator_tuple, denominator_tuple):\n        \"\"\"\n        Validates the input tuples according to specified rules.\n        Raises TypeError, ValueError, or ZeroDivisionError on failure.\n        \"\"\"\n        if not isinstance(numerator_tuple, tuple) or not isinstance(denominator_tuple, tuple):\n            raise TypeError(\"Both numerator_tuple and denominator_tuple must be tuples\")\n        if len(numerator_tuple) != len(denominator_tuple):\n            raise ValueError(\"Tuples must have the same length\")\n        for v in numerator_tuple + denominator_tuple:\n            if not isNumeric(v):\n                raise TypeError(\"All elements in both tuples must be numeric (int or float)\")\n        for d in denominator_tuple:\n            if d == 0:\n                raise ZeroDivisionError(\"Denominator contains zero\")\n\n    def computeQuotients(numerator_tuple, denominator_tuple):\n        \"\"\"Computes element-wise quotients assuming inputs are valid.\"\"\"\n        return tuple(n / d for n, d in zip(numerator_tuple, denominator_tuple))\n\n    validateInputs(numerator_tuple, denominator_tuple)\n    return computeQuotients(numerator_tuple, denominator_tuple)"}
{"task_id": "Mbpp/266", "solution": "class Measurement:\n    \"\"\"A value object to wrap a numeric value and an optional unit.\"\"\"\n    def __init__(self, value: float, unit: str = ''):\n        self.value = value\n        self.unit = unit\n\nclass Cube:\n    \"\"\"Represents a cube and provides methods to compute its surface areas.\"\"\"\n    def __init__(self, sideLength: float):\n        self.sideLength = sideLength\n        self.lateralArea = 0.0 # Will be computed on demand\n\n    def computeLateralArea(self) -> float:\n        \"\"\"Calculates the lateral surface area of the cube.\"\"\"\n        self.lateralArea = 4 * self.sideLength * self.sideLength\n        return self.lateralArea\n\ndef lateralsurface_cube(side):\n    \"\"\"\n    Calculates the lateral surface area of a cube given its side length.\n    The lateral surface area of a cube is 4 * side * side.\n    \"\"\"\n    # Wrap the input side length in a Measurement object as per design\n    side_measurement = Measurement(value=side)\n    # Create a Cube object with the extracted side length\n    cube_obj = Cube(sideLength=side_measurement.value)\n    # Compute and return the lateral surface area using the Cube object\n    return cube_obj.computeLateralArea()"}
{"task_id": "Mbpp/260", "solution": "import math\n\nclass SequenceGenerator:\n    \"\"\"Generates terms of the Newman-Shanks-Williams sequence.\"\"\"\n    def __init__(self) -> None:\n        # S_0 = 1, S_1 = 1, S_k = 2*S_{k-1} + S_{k-2}\n        self._history = [1, 1]\n\n    def get_term(self, index: int) -> int:\n        \"\"\"Returns the NSW term S_index.\"\"\"\n        if index < 0:\n            raise ValueError(\"Sequence index must be non-negative.\")\n        while len(self._history) <= index:\n            s_k_minus_1 = self._history[-1]\n            s_k_minus_2 = self._history[-2]\n            next_term = 2 * s_k_minus_1 + s_k_minus_2\n            self._history.append(next_term)\n        return self._history[index]\n\nclass PrimeChecker:\n    \"\"\"Provides a utility to check if a number is prime.\"\"\"\n    def is_prime(self, x: int) -> bool:\n        \"\"\"Checks if a given integer x is a prime number.\"\"\"\n        if x < 2:\n            return False\n        if x == 2:\n            return True\n        if x % 2 == 0:\n            return False\n        # Check for factors from 3 up to sqrt(x), skipping even numbers\n        for i in range(3, int(math.sqrt(x)) + 1, 2):\n            if x % i == 0:\n                return False\n        return True\n\nclass NewmanPrimeService:\n    \"\"\"Orchestrates the finding of the Newman-Shanks-Williams prime at a specific index.\"\"\"\n    def __init__(self, generator: SequenceGenerator, checker: PrimeChecker) -> None:\n        self._generator = generator\n        self._checker = checker\n\n    def validate_index(self, n: int) -> None:\n        \"\"\"Validates the input index n, raising ValueError if invalid.\"\"\"\n        if not isinstance(n, int) or n < 1:\n            raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\n    def newman_prime(self, n: int) -> int:\n        \"\"\"\n        Finds the Newman-Shanks-Williams prime number S_n.\n        Raises ValueError if S_n is not prime.\n        \"\"\"\n        self.validate_index(n)\n\n        # Retrieve the nth term (S_n), where n maps directly to the sequence index.\n        term = self._generator.get_term(n) \n\n        if not self._checker.is_prime(term):\n            raise ValueError(f\"S_{n} = {term} is not a prime number. The requested NSW number at index {n} is not prime.\")\n        \n        return term\n\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the nth newman\u2013shanks\u2013williams prime number.\n    assert newman_prime(3) == 7\n    \"\"\"\n    generator = SequenceGenerator()\n    checker = PrimeChecker()\n    service = NewmanPrimeService(generator=generator, checker=checker)\n    return service.newman_prime(n)"}
{"task_id": "Mbpp/264", "solution": "class InputValidator:\n    \"\"\"Validates human years input.\"\"\"\n    def validate(self, humanYears: any) -> bool:\n        \"\"\"\n        Checks if humanYears is a non-negative number.\n        Raises ValueError if invalid.\n        \"\"\"\n        if not isinstance(humanYears, (int, float)):\n            raise ValueError(\"Invalid input: human_years must be a number.\")\n        if humanYears < 0:\n            raise ValueError(\"Invalid input: human_years cannot be negative.\")\n        return True\n\nclass AgeCalculator:\n    \"\"\"Calculates dog age and orchestrates validation.\"\"\"\n    _conversion_factor: float = 61.0 / 12.0 # Satisfies dog_age(12) == 61\n\n    def __init__(self, persistence_adapter=None):\n        \"\"\"Initializes the AgeCalculator with an optional persistence adapter.\"\"\"\n        self._persistence = persistence_adapter\n        self._validator = InputValidator()\n\n    def _compute_raw(self, humanYears: float) -> float:\n        \"\"\"Computes the raw dog years before rounding.\"\"\"\n        return humanYears * self._conversion_factor\n\n    def dog_age(self, humanYears: float) -> int:\n        \"\"\"\n        Calculates a dog's age in dog years from human years.\n        Validates input, computes, rounds, and returns an integer.\n        \"\"\"\n        self._validator.validate(humanYears)\n\n        raw_value = self._compute_raw(humanYears)\n        result_int = round(raw_value)\n\n        # Persistence is optional and not enabled by default for the top-level\n        # dog_age function, as per design constraints for src/dog_age.py.\n\n        return result_int\n\ndef dog_age(human_years: float) -> int:\n    \"\"\"\n    Calculates a dog's age in dog's years.\n    This function validates input and converts human years to dog years.\n    \"\"\"\n    calculator = AgeCalculator(persistence_adapter=None)\n    return calculator.dog_age(humanYears=human_years)"}
{"task_id": "Mbpp/265", "solution": "class ValidationError(Exception):\n    \"\"\"\n    Exception raised for invalid input parameters.\n    Attributes:\n        message (str): Explanation of the error.\n        code (str): A code representing the error type.\n    \"\"\"\n    def __init__(self, message: str, code: str = 'INVALID_N'):\n        super().__init__(message)\n        self.message = message\n        self.code = code\n\nclass ListSplitter:\n    \"\"\"\n    Helper class to encapsulate list splitting logic and validation.\n    \"\"\"\n    def validate_n(self, n) -> None:\n        \"\"\"\n        Validates that n is a positive integer, raising ValidationError if invalid.\n        \"\"\"\n        if not isinstance(n, int):\n            raise ValidationError(\"Parameter 'n' must be an integer.\", code='INVALID_N_TYPE')\n        if n <= 0:\n            raise ValidationError(\"Parameter 'n' must be a positive integer.\", code='INVALID_N_VALUE')\n\n    def distribute_elements(self, input_list: list, n: int) -> list:\n        \"\"\"\n        Distributes elements of input_list into n sublists based on index modulo n.\n        \"\"\"\n        result = [[] for _ in range(n)]\n        for i, element in enumerate(input_list):\n            target_index = i % n\n            result[target_index].append(element)\n        return result\n\n    def list_split(self, input_list: list, n: int) -> list:\n        \"\"\"\n        Orchestrates validation and element distribution for the list splitting process.\n        \"\"\"\n        self.validate_n(n)\n        return self.distribute_elements(input_list, n)\n\ndef list_split(input_list: list, n: int) -> list:\n    \"\"\"\n    Splits a list for every nth element, returning a list of the resulting lists.\n    Each element at index i is distributed into sublist (i mod n).\n    \"\"\"\n    splitter = ListSplitter()\n    return splitter.list_split(input_list, n)"}
{"task_id": "Mbpp/267", "solution": "from typing import List\n\nclass InputValidation:\n    \"\"\"Validates the input integer n.\"\"\"\n    def validate(self, n) -> bool:\n        if not isinstance(n, int):\n            raise TypeError(\"Input n must be an integer.\")\n        if n < 0:\n            raise ValueError(\"Input n cannot be negative.\")\n        return True\n\nclass OddSequenceGenerator:\n    \"\"\"Generates a sequence of the first n odd natural numbers.\"\"\"\n    def generate(self, n: int) -> List[int]:\n        if n == 0:\n            return []\n        return [2 * k + 1 for k in range(n)]\n\nclass Calculator:\n    \"\"\"Performs arithmetic calculations like squaring and summing.\"\"\"\n    def square(self, x: int) -> int:\n        return x * x\n\n    def sum(self, values: List[int]) -> int:\n        return sum(values)\n\nclass Result:\n    \"\"\"A data holder for the computed integer value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\ndef square_Sum(n: int) -> int:\n    \"\"\"\n    Returns the sum of the squares of the first n odd natural numbers.\n    assert square_Sum(2) == 10\n    \"\"\"\n    validator = InputValidation()\n    validator.validate(n)\n\n    if n == 0:\n        return 0\n\n    generator = OddSequenceGenerator()\n    odd_values = generator.generate(n)\n\n    calc = Calculator()\n    squared_values = [calc.square(v) for v in odd_values]\n\n    total = calc.sum(squared_values)\n\n    result = Result(total)\n    return result.value"}
