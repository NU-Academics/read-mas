{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n):\n    # Calculate the sum of the cubes of the first n natural numbers\n    # using the closed-form identity: (n*(n+1)/2)^2.\n    sum_of_cubes = (n * (n + 1) // 2) ** 2\n\n    # Compute the average by dividing the sum by n.\n    average = sum_of_cubes / n\n    return average"}
{"task_id": "Mbpp/427", "solution": "def change_date_format(dateStr: str) -> str:\n    \"\"\"\n    Converts a date string from 'yyyy-mm-dd' format to 'dd-mm-yyyy' format.\n    Preserves leading zeros for day and month.\n    \"\"\"\n    parts = dateStr.split('-')\n    year = parts[0]\n    month = parts[1]\n    day = parts[2]\n    return f\"{day}-{month}-{year}\""}
{"task_id": "Mbpp/426", "solution": "def isOdd(value: int) -> bool:\n    \"\"\"Returns True if the given integer value is odd.\"\"\"\n    return value % 2 != 0\n\ndef filter_oddnumbers(input: list[int]) -> list[int]:\n    \"\"\"Filters a list of integers, returning only the odd numbers in their original relative order.\"\"\"\n    result = []\n    for number in input:\n        if isOdd(number):\n            result.append(number)\n    return result"}
{"task_id": "Mbpp/425", "solution": "def count_element_in_list(list_of_sublists, element):\n    \"\"\"\n    Counts the number of sublists containing a particular element.\n    Each sublist is counted at most once, even if the element appears multiple times.\n    \"\"\"\n    count = 0\n    for sublist in list_of_sublists:\n        if any(item == element for item in sublist):\n            count += 1\n    return count"}
{"task_id": "Mbpp/429", "solution": "class TupleInput:\n    \"\"\"Domain model wrapper for an input tuple, providing length and type checking.\"\"\"\n    def __init__(self, elements: tuple) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the tuple.\"\"\"\n        return len(self.elements)\n\n    def is_all_int(self) -> bool:\n        \"\"\"Checks if all elements in the tuple are integers.\"\"\"\n        return all(isinstance(elem, int) for elem in self.elements)\n\nclass AndTuplesResult:\n    \"\"\"Domain model wrapper for the result tuple, providing a method to retrieve it.\"\"\"\n    def __init__(self, elements: tuple[int, ...]) -> None:\n        self.elements = elements\n\n    def as_tuple(self) -> tuple[int, ...]:\n        \"\"\"Returns the stored result as a tuple.\"\"\"\n        return self.elements\n\nclass Validator:\n    \"\"\"Stateless validator for tuple inputs based on business rules.\"\"\"\n    def validate_types(self, a: TupleInput, b: TupleInput) -> None:\n        \"\"\"Raises TypeError if any element in either tuple is not an integer.\"\"\"\n        if not a.is_all_int() or not b.is_all_int():\n            raise TypeError(\"All elements in both tuples must be integers.\")\n\n    def validate_lengths(self, a: TupleInput, b: TupleInput) -> None:\n        \"\"\"Raises ValueError if the lengths of the two tuples differ.\"\"\"\n        if a.length() != b.length():\n            raise ValueError(\"Input tuples must have equal length.\")\n\ndef and_tuples(a: tuple[int, ...], b: tuple[int, ...]) -> tuple[int, ...]:\n    \"\"\"Validate inputs and return tuple of elementwise bitwise AND.\n\n    Raises:\n        TypeError: if any element is not int\n        ValueError: if tuple lengths differ\n    \"\"\"\n    a_obj = TupleInput(a)\n    b_obj = TupleInput(b)\n\n    v = Validator()\n    v.validate_types(a_obj, b_obj)\n    v.validate_lengths(a_obj, b_obj)\n\n    result_elements = tuple(x & y for x, y in zip(a_obj.elements, b_obj.elements))\n    return AndTuplesResult(result_elements).as_tuple()"}
{"task_id": "Mbpp/428", "solution": "import collections\n\nclass Array:\n    \"\"\"\n    Domain value object representing an ordered collection of integers.\n    \"\"\"\n    def __init__(self, elements: list[int]):\n        self.elements = list(elements) # Create a copy to ensure immutability from outside\n\n    def length(self) -> int:\n        \"\"\"\n        Returns the number of elements in the array.\n        \"\"\"\n        return len(self.elements)\n\n    def __getitem__(self, index: int) -> int:\n        return self.elements[index]\n\n    def __setitem__(self, index: int, value: int):\n        self.elements[index] = value\n\n    def __repr__(self) -> str:\n        return f\"Array({self.elements})\"\n\n    def __eq__(self, other) -> bool:\n        if not isinstance(other, Array):\n            return NotImplemented\n        return self.elements == other.elements\n\nclass ShellSortAlgorithm:\n    \"\"\"\n    Implements the Shell sort algorithm using gap-based insertion passes.\n    \"\"\"\n    name: str = \"ShellSortAlgorithm\"\n    # The chosen gap sequence is Knuth's sequence (3k + 1), generated dynamically.\n    gapSequence: str = \"Knuth's sequence (3k + 1), generated dynamically.\"\n\n    def perform(self, arr: Array) -> Array:\n        \"\"\"\n        Performs Shell sort on the given Array's elements and returns a new Array with sorted elements.\n        \"\"\"\n        n = arr.length()\n        elements = list(arr.elements) # Create a mutable copy for sorting\n\n        # Generate the largest gap from Knuth's sequence (3h + 1) less than n/3\n        h = 1\n        while h < n / 3:\n            h = 3 * h + 1\n\n        while h >= 1:\n            # Perform h-sort (insertion sort with gap h)\n            for i in range(h, n):\n                temp = elements[i]\n                j = i\n                while j >= h and elements[j - h] > temp:\n                    elements[j] = elements[j - h]\n                    j -= h\n                elements[j] = temp\n            h //= 3 # Reduce the gap\n\n        return Array(elements)\n\nclass ShellSortFunction:\n    \"\"\"\n    Adapter class for the shell_sort public API.\n    It validates input, wraps it in an Array, and delegates to ShellSortAlgorithm.\n    \"\"\"\n    name: str = \"ShellSortFunction\"\n    input: Array\n    output: Array | None = None\n\n    def __init__(self, input_array: list[int]):\n        # Runtime validation for input preconditions\n        if not isinstance(input_array, list):\n            raise TypeError(\"Input array must be a list.\")\n        for element in input_array:\n            if not isinstance(element, int):\n                raise TypeError(\"All elements in the input array must be integers.\")\n        \n        self.input = Array(input_array)\n\n    def sort(self) -> Array:\n        \"\"\"\n        Delegates the sorting operation to ShellSortAlgorithm and returns the sorted Array.\n        \"\"\"\n        algorithm = ShellSortAlgorithm()\n        self.output = algorithm.perform(self.input)\n        return self.output\n\ndef shell_sort(input_array: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of integers using the Shell sort algorithm.\n    It performs runtime input validation and preserves duplicate values.\n    \"\"\"\n    shell_sort_adapter = ShellSortFunction(input_array)\n    sorted_array_obj = shell_sort_adapter.sort()\n    return sorted_array_obj.elements"}
{"task_id": "Mbpp/430", "solution": "class ValidationError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass Coefficients:\n    def __init__(self, a: float, b: float, c: float) -> None:\n        self.a = a\n        self.b = b\n        self.c = c\n\nclass Parabola:\n    def __init__(self, coeffs: Coefficients) -> None:\n        self.coeffs = coeffs\n\n    def vertex(self) -> tuple[float, float]:\n        a, b, c = self.coeffs.a, self.coeffs.b, self.coeffs.c\n        h = -b / (2 * a)\n        k = c - (b**2) / (4 * a)\n        return h, k\n\n    def directrix(self) -> float:\n        a, b, c = self.coeffs.a, self.coeffs.b, self.coeffs.c\n        return c - (b**2) / (4 * a) - 1 / (4 * a)\n\nclass DirectrixCalculator:\n    def validate(self, a: float) -> None:\n        \"\"\"Validates the 'a' coefficient, raising ValidationError if zero.\"\"\"\n        if a == 0:\n            raise ValidationError(\"a cannot be zero\")\n\n    def parabola_directrix(self, a: float, b: float, c: float) -> float:\n        \"\"\"Calculates the directrix of a parabola y = ax^2 + bx + c.\"\"\"\n        self.validate(a)\n        coeffs = Coefficients(a, b, c)\n        p = Parabola(coeffs)\n        return p.directrix()\n\ndef parabola_directrix(a, b, c):\n    \"\"\"Calculates the directrix of a parabola y = ax^2 + bx + c.\"\"\"\n    calc = DirectrixCalculator()\n    return calc.parabola_directrix(a, b, c)"}
{"task_id": "Mbpp/433", "solution": "from dataclasses import dataclass\nfrom typing import Sequence, Union\n\nNumber = Union[int, float]\n\n@dataclass\nclass InputArray:\n    elements: Sequence[Number]\n\n    def length(self) -> int:\n        return len(self.elements)\n\n@dataclass\nclass NumberValue:\n    value: Number\n\n@dataclass\nclass Result:\n    is_greater: bool\n\nclass CheckGreater:\n    def __init__(self, input_array: InputArray, input_number: NumberValue) -> None:\n        self.input_array = input_array\n        self.input_number = input_number\n\n    def execute(self) -> Result:\n        is_strictly_greater_than_all = all(\n            self.input_number.value > element\n            for element in self.input_array.elements\n        )\n        return Result(is_greater=is_strictly_greater_than_all)\n\ndef check_greater(input_array: Sequence[Number], input_number: Number) -> bool:\n    \"\"\"Public API. Accepts two args: array/list of numbers and a single number.\n    Returns True iff input_number > every element in input_array; False otherwise.\n    \"\"\"\n    input_array_obj = InputArray(elements=input_array)\n    input_number_obj = NumberValue(value=input_number)\n\n    executor = CheckGreater(input_array_obj, input_number_obj)\n    result = executor.execute()\n\n    return result.is_greater"}
