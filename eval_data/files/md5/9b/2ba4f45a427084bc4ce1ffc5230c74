{"task_id": "Mbpp/273", "solution": "class ValidationException(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\ndef _validate_input_types(tuple1: tuple, tuple2: tuple) -> None:\n    \"\"\"Validates that inputs are tuples and contain only numeric elements.\"\"\"\n    if not isinstance(tuple1, tuple):\n        raise TypeError(f\"First input must be a tuple, but got {type(tuple1).__name__}\")\n    if not isinstance(tuple2, tuple):\n        raise TypeError(f\"Second input must be a tuple, but got {type(tuple2).__name__}\")\n\n    for t_idx, tpl in enumerate([tuple1, tuple2]):\n        for e_idx, element in enumerate(tpl):\n            if not isinstance(element, (int, float)):\n                raise TypeError(\n                    f\"Element at index {e_idx} in tuple {t_idx+1} \"\n                    f\"must be numeric (int or float), but got {type(element).__name__}\"\n                )\n\ndef _validate_lengths(tuple1: tuple, tuple2: tuple) -> None:\n    \"\"\"Validates that both tuples have the same length.\"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValidationException(\n            f\"Tuple lengths differ: {len(tuple1)} vs {len(tuple2)}\"\n        )\n\ndef _compute_elementwise(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Computes the element-wise subtraction of two tuples.\"\"\"\n    return tuple(tuple1[i] - tuple2[i] for i in range(len(tuple1)))\n\ndef substract_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Subtracts the elements of the first tuple by the elements of the second tuple with the same index.\n    Input tuples are validated for type, numeric content, and length.\n    \"\"\"\n    _validate_input_types(tuple1, tuple2)\n    _validate_lengths(tuple1, tuple2)\n    return _compute_elementwise(tuple1, tuple2)"}
{"task_id": "Mbpp/274", "solution": "def even_binomial_Coeff_Sum(n: int) -> int:\n    \"\"\"Validate n and return exact integer sum of binomial coefficients C(n,k) for even k in 0..n.\n\n    Raises ValueError if n is not a positive integer (n >= 1).\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be a positive integer (n >= 1)\")\n\n    return 2 ** (n - 1)"}
{"task_id": "Mbpp/271", "solution": "class InputParameter:\n    \"\"\"Validates the input parameter n, raising TypeError or ValueError for invalid inputs.\"\"\"\n    def __init__(self, n):\n        self.n = n\n\n    def validate(self) -> None:\n        \"\"\"Validates n type and range.\"\"\"\n        if not isinstance(self.n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        if self.n < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\nclass EvenNumberSequence:\n    \"\"\"Generates a sequence of the first n even natural numbers.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def generate(self, n: int) -> list[int]:\n        \"\"\"Returns a list of the first n even natural numbers.\"\"\"\n        return [2 * i for i in range(1, n + 1)]\n\nclass PowerOperation:\n    \"\"\"Applies a fixed exponent (default 5) to a base number.\"\"\"\n    def __init__(self, exponent: int = 5) -> None:\n        self.exponent = exponent\n\n    def pow(self, base: int) -> int:\n        \"\"\"Computes base raised to the stored exponent.\"\"\"\n        return base ** self.exponent\n\nclass CalculationResult:\n    \"\"\"Wraps an integer calculation result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def as_int(self) -> int:\n        \"\"\"Returns the wrapped integer value.\"\"\"\n        return self.value\n\ndef even_Power_Sum(n):\n    \"\"\"Public API: compute sum of fifth powers of first n even natural numbers.\n    Raises TypeError if n not int, raises ValueError if n < 0, returns 0 if n == 0 else integer sum.\n    \"\"\"\n    ip = InputParameter(n)\n    ip.validate()\n    if n == 0:\n        return 0\n    elements = EvenNumberSequence().generate(n)\n    powop = PowerOperation()\n    total = 0\n    for v in elements:\n        total += powop.pow(v)\n    return CalculationResult(total).as_int()"}
