{"task_id": "Mbpp/420", "solution": "from typing import List\n\nclass CubeSumCalculator:\n    def cube_Sum(self, n):\n        # choose formula path for O(1) performance\n        return self._compute_formula(n)\n\n    def validate_input(self, n):\n        # raises ValueError for invalid inputs per BR2/BR8; returns True otherwise\n        if not isinstance(n, int):\n            raise ValueError(\"n must be an integer and n >= 1\")\n        if n < 1:\n            raise ValueError(\"n must be >= 1\")\n        return True\n\n    def _compute_iterative(self, n):\n        # iterative computation: sum((2*i)**3 for i in range(1, n+1))\n        s = 0\n        for i in range(1, n+1):\n            val = (2*i) ** 3\n            s += val\n        return s\n\n    def _compute_formula(self, n):\n        # closed-form: sum_{i=1..n} (2*i)^3 = 8 * (n*(n+1)//2)**2\n        # Use integer arithmetic to ensure int return.\n        t = n * (n + 1) // 2\n        return 8 * (t * t)\n\nclass EvenSequence:\n    @staticmethod\n    def generate(n) -> List[int]:\n        return [2 * i for i in range(1, n + 1)]\n\nclass CubeValue:\n    def __init__(self, value: int):\n        self.value = value\n\nclass Result:\n    def __init__(self, value: int):\n        self.value = value\n\nclass InputParameter:\n    def __init__(self, n: int):\n        self.n = n\n\ndef cube_Sum(n):\n    \"\"\"Public function (FR1): validate and compute sum of cubes for first n even natural numbers; returns int.\"\"\"\n    calc = CubeSumCalculator()\n    calc.validate_input(n)\n    return calc.cube_Sum(n)"}
{"task_id": "Mbpp/419", "solution": "from typing import List\n\ndef round_and_sum(numbers: List[float]) -> int:\n    \"\"\"\n    Rounds each number in a list using round-half-to-even, sums them,\n    and multiplies the total sum by the length of the list.\n    \"\"\"\n    rounded_numbers = [round(num) for num in numbers]\n    total_sum = sum(rounded_numbers)\n    list_length = len(numbers)\n    final_result = total_sum * list_length\n    print(final_result)\n    return final_result"}
