{"task_id": "Mbpp/67", "solution": "def _validate_input(n) -> None:\n    \"\"\"Validates that n is a non-negative integer, raising ValueError if invalid.\"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\ndef _compute_bell(n: int) -> int:\n    \"\"\"Computes the Bell number B(n) using the Bell triangle dynamic programming method.\"\"\"\n    if n == 0:\n        return 1\n\n    # Initialize a 2D array for the Bell triangle.\n    # `bell[i][j]` represents the j-th element in the i-th row of the triangle.\n    # The Bell number B(i) is stored at `bell[i][0]`.\n    bell = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # Base case: B(0) = 1\n    bell[0][0] = 1\n\n    # Fill the Bell triangle row by row\n    for i in range(1, n + 1):\n        # The first element of the current row is the last element of the previous row.\n        bell[i][0] = bell[i-1][i-1]\n        # Fill the rest of the current row\n        for j in range(1, i + 1):\n            # Each subsequent element is the sum of the element to its left in the current row\n            # and the element diagonally above-left in the previous row.\n            bell[i][j] = bell[i][j-1] + bell[i-1][j-1]\n\n    # The Bell number B(n) is the first element of the nth row.\n    return bell[n][0]\n\ndef bell_number(n):\n    \"\"\"\n    Computes the Bell number B(n) for a non-negative integer n.\n    It represents the number of ways to partition a set of n elements.\n    \"\"\"\n    _validate_input(n)\n    return _compute_bell(n)"}
{"task_id": "Mbpp/68", "solution": "def _check_non_decreasing(arr: list) -> bool:\n    \"\"\"Checks if the array is non-decreasing.\"\"\"\n    for i in range(len(arr) - 1):\n        if arr[i] > arr[i+1]:\n            return False\n    return True\n\ndef _check_non_increasing(arr: list) -> bool:\n    \"\"\"Checks if the array is non-increasing.\"\"\"\n    for i in range(len(arr) - 1):\n        if arr[i] < arr[i+1]:\n            return False\n    return True\n\ndef is_Monotonic(arr: list) -> bool:\n    \"\"\"\n    Checks if the given array is monotonic (either entirely non-decreasing or entirely non-increasing).\n    An empty list or a single-element list is considered monotonic.\n    \"\"\"\n    if len(arr) <= 1:\n        return True\n\n    return _check_non_decreasing(arr) or _check_non_increasing(arr)"}
{"task_id": "Mbpp/70", "solution": "from typing import List\n\nclass InputList:\n    \"\"\"Represent and provide basic queries over the top-level input list of tuples.\"\"\"\n    def __init__(self, tuples: List[tuple]):\n        self.tuples = tuples\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the list of tuples is empty.\"\"\"\n        return not self.tuples\n\nclass TupleWrapper:\n    \"\"\"Provide tuple-specific operations (length) and preserve SRS semantics that elements must be tuple objects.\"\"\"\n    def __init__(self, elements: tuple):\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the wrapped tuple.\"\"\"\n        return len(self.elements)\n\nclass Result:\n    \"\"\"Encapsulate boolean result produced by Validator.\"\"\"\n    def __init__(self, value: bool):\n        self.value = value\n\nclass Validator:\n    \"\"\"Enforce business rules and compute whether all tuple lengths are equal.\"\"\"\n    def validate_types(self, input_list: object) -> InputList:\n        \"\"\"Validates top-level list and per-element tuple type; raises TypeError on violation.\"\"\"\n        if not isinstance(input_list, list):\n            raise TypeError(\"input_list must be a list of tuples\")\n        \n        for element in input_list:\n            if not isinstance(element, tuple):\n                raise TypeError(\"all elements of input_list must be tuple\")\n        \n        return InputList(input_list)\n\n    def compute_lengths(self, input_list: InputList) -> List[int]:\n        \"\"\"Returns list of tuple lengths.\"\"\"\n        if input_list.is_empty():\n            return []\n        \n        lengths = []\n        for tpl in input_list.tuples:\n            lengths.append(TupleWrapper(tpl).length())\n        return lengths\n\n    def get_equal(self, input_list: object) -> bool:\n        \"\"\"Full operation: validate, compute lengths, return True if all equal (empty -> True), else False.\"\"\"\n        validated_input = self.validate_types(input_list)\n\n        if validated_input.is_empty():\n            return True\n\n        lengths = self.compute_lengths(validated_input)\n        \n        # Check if all lengths are the same by converting to a set and checking its size.\n        return len(set(lengths)) == 1\n\ndef get_equal(input_list) -> bool:\n    \"\"\"Validate input_list and return True if all tuples have equal length, else False. Raises TypeError on invalid input.\"\"\"\n    validator = Validator()\n    return validator.get_equal(input_list)"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list, sublist) -> bool:\n    \"\"\"\n    Determine whether `sublist` appears as a contiguous subsequence of `main_list`.\n    Uses element equality (==) to compare elements and does not mutate inputs.\n    \"\"\"\n    n = len(main_list)\n    m = len(sublist)\n\n    if m == 0:\n        return True\n\n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        if main_list[i : i + m] == sublist:\n            return True\n\n    return False"}
{"task_id": "Mbpp/71", "solution": "from typing import List, Any\n\n# Internal default for the gap shrink factor as specified in the design.\nGAP_SHRINK_FACTOR: float = 1.3\n\nclass CombSortAlgorithm:\n    \"\"\"Encapsulates the logic for the comb sort algorithm.\"\"\"\n    def __init__(self, gap_shrink_factor: float = GAP_SHRINK_FACTOR) -> None:\n        self._gap_shrink_factor: float = gap_shrink_factor\n\n    def apply(self, input_list: list) -> list:\n        \"\"\"Perform comb sort on a copy of the list and return the sorted list.\"\"\"\n        n = len(input_list)\n        arr = list(input_list)  # Work on a copy to avoid modifying the original list.\n\n        gap = n\n        swapped = True\n\n        while gap > 1 or swapped:\n            gap = int(gap / self._gap_shrink_factor)\n            if gap < 1:\n                gap = 1\n\n            swapped = False\n            for i in range(n - gap):\n                if arr[i] > arr[i + gap]:\n                    arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                    swapped = True\n        return arr\n\ndef comb_sort(input_list: list) -> list:\n    \"\"\"Public API: accept a list and return a list sorted in ascending order.\n    Delegates to CombSortAlgorithm.apply and returns the result.\"\"\"\n    sorter = CombSortAlgorithm()\n    return sorter.apply(input_list)"}
