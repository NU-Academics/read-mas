{"task_id": "Mbpp/440", "solution": "from typing import Optional, Set, Tuple, List\n\n# These imports are from other modules in the 'src' directory,\n# as per the design context for src/adverb_detector.py\nfrom src.tokenizer import tokenize\nfrom src.normalizer import normalize_tokens\nfrom src.models import Token\n\n\nclass AdverbDetector:\n    \"\"\"\n    Coordinates tokenization and normalization to find the first adverb in a sentence.\n    Uses a simple suffix-based heuristic for adverb detection by default.\n    \"\"\"\n    def __init__(self, adverb_lexicon: Optional[Set[str]] = None) -> None:\n        \"\"\"\n        Initializes the AdverbDetector with an optional custom lexicon of adverbs.\n        \"\"\"\n        self._adverb_lexicon = adverb_lexicon if adverb_lexicon is not None else set()\n\n    def _is_adverb(self, word: str) -> bool:\n        \"\"\"\n        Determines if a word is an adverb based on the '-ly' suffix heuristic\n        or membership in the provided lexicon.\n        \"\"\"\n        lower_word = word.lower()\n        if lower_word.endswith('ly'):\n            return True\n        return lower_word in self._adverb_lexicon\n\n    def find_adverb_position(self, sentence: str) -> Optional[Tuple[int, int, str]]:\n        \"\"\"\n        Finds the first adverb and its position in the given sentence.\n        Returns a tuple (start_index, end_index, adverb_text) or None if no adverb is found.\n        \"\"\"\n        tokens = tokenize(sentence)\n        normalized_tokens = normalize_tokens(tokens)\n\n        for token in normalized_tokens:\n            # Only consider non-punctuation tokens for adverb detection\n            if not token.is_punctuation and self._is_adverb(token.text):\n                return (token.start_index, token.end_index, token.text)\n\n        return None\n\n\ndef find_adverb_position(sentence: str) -> Optional[Tuple[int, int, str]]:\n    \"\"\"\n    Public API function to find the first adverb and its position in a sentence.\n    Delegates to an AdverbDetector instance for the actual logic.\n    \"\"\"\n    return AdverbDetector().find_adverb_position(sentence)"}
