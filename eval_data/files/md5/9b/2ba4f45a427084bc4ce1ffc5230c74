{"task_id": "Mbpp/137", "solution": "from dataclasses import dataclass\nfrom typing import Sequence, List\n\n@dataclass\nclass IntegerArray:\n    values: List[int]\n\n@dataclass\nclass CountResult:\n    zeros: int\n    nonZeros: int\n    ratio: float\n\ndef count_zeros(values: Sequence[int]) -> int:\n    \"\"\"Counts the number of zero elements in a sequence of integers.\"\"\"\n    return sum(1 for v in values if v == 0)\n\ndef count_nonzeros(values: Sequence[int]) -> int:\n    \"\"\"Counts the number of non-zero elements in a sequence of integers.\"\"\"\n    return sum(1 for v in values if v != 0)\n\ndef zero_count(values: Sequence[int]) -> float:\n    \"\"\"Calculates the ratio of zeroes to non-zeroes in a sequence of integers.\n    Returns float('inf') if there are no non-zero elements.\"\"\"\n    zeros = count_zeros(values)\n    non_zeros = count_nonzeros(values)\n\n    if non_zeros == 0:\n        return float('inf')\n    else:\n        return float(zeros) / float(non_zeros)"}
{"task_id": "Mbpp/140", "solution": "def extract_singly(input_list):\n    \"\"\"Accepts a list of sequences (lists or tuples) of numbers and returns a set of unique numbers.\n    Each inner sequence is iterable and contains numeric elements.\n    \"\"\"\n    result = set()\n    for seq in input_list:\n        for elem in seq:\n            result.add(elem)\n    return result"}
{"task_id": "Mbpp/142", "solution": "def _iteration_bound(list1, list2, list3) -> int:\n    \"\"\"\n    Computes the minimum length of the three input lists to define the iteration bound.\n    \"\"\"\n    return min(len(list1), len(list2), len(list3))\n\ndef count_samepair(list1, list2, list3) -> int:\n    \"\"\"\n    Counts the number of items that are identical in the same position across three lists.\n    Compares elements up to the minimum length of the three lists.\n    \"\"\"\n    count = 0\n    bound = _iteration_bound(list1, list2, list3)\n    for i in range(bound):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/141", "solution": "def pancake_sort(items):\n    \"\"\"\n    Sorts a list of elements using the pancake sort algorithm.\n\n    This function returns a new list and does not modify the original input list.\n    Raises TypeError if input is not a list or elements are not comparable.\n    \"\"\"\n    _validate_input(items)\n    \n    # Create a shallow copy to ensure non-destructive behavior\n    mutable_list = list(items)\n    n = len(mutable_list)\n\n    # Perform pancake sort\n    # Iterate from n down to 1 (size of the current unsorted part)\n    for current_n_length in range(n, 1, -1):\n        # Find the index of the maximum element in the current unsorted part\n        max_element = mutable_list[0]\n        max_idx = 0\n        for i in range(1, current_n_length):\n            if mutable_list[i] > max_element:\n                max_element = mutable_list[i]\n                max_idx = i\n\n        # If the maximum element is not already at its correct position\n        # (which is current_n_length - 1)\n        if max_idx != current_n_length - 1:\n            # 1. Flip to bring the max element to the front\n            _flip(mutable_list, max_idx)\n\n            # 2. Flip to move the max element to its correct sorted position\n            _flip(mutable_list, current_n_length - 1)\n            \n    return mutable_list\n\ndef _flip(items, k):\n    \"\"\"\n    Reverses the prefix items[0:k+1] in-place.\n    \"\"\"\n    items[:k+1] = items[:k+1][::-1]\n\ndef _validate_input(items):\n    \"\"\"\n    Validates that the input is a list and elements are comparable.\n    Raises TypeError if validation fails.\n    \"\"\"\n    if not isinstance(items, list):\n        raise TypeError(\"Input must be a list.\")\n    \n    # If the list has elements, try finding the maximum to implicitly check comparability.\n    if items:\n        try:\n            _ = max(items)\n        except TypeError as e:\n            raise TypeError(f\"Elements in the list must be comparable: {e}\") from e"}
{"task_id": "Mbpp/145", "solution": "import collections.abc\n\ndef max_Abs_Diff(seq):\n    \"\"\"\n    Accept a single sequence (tuple/list/iterable) of numeric elements and return the maximum absolute\n    difference between any two elements. Raises TypeError or ValueError per BR-7 when input preconditions are violated.\n    \"\"\"\n    if not isinstance(seq, collections.abc.Iterable):\n        raise TypeError(\"Input must be an iterable sequence.\")\n\n    list_seq = list(seq)\n\n    if len(list_seq) < 2:\n        raise ValueError(\"Sequence must contain at least two numeric elements.\")\n\n    for elem in list_seq:\n        if not isinstance(elem, (int, float)):\n            raise TypeError(\"All elements must be numeric (int or float).\")\n\n    min_value = min(list_seq)\n    max_value = max(list_seq)\n\n    return abs(max_value - min_value)"}
{"task_id": "Mbpp/160", "solution": "from typing import Optional, Tuple\n\ndef find_solution(a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple,\n    or returns None if no solution exists.\n    \"\"\"\n\n    def extended_gcd(num1: int, num2: int) -> Tuple[int, int, int]:\n        # Computes (g, x, y) such that num1*x + num2*y = g = gcd(|num1|, |num2|).\n        # g is always non-negative.\n        if num1 == 0:\n            if num2 == 0:\n                return 0, 0, 0\n            return abs(num2), 0, (1 if num2 > 0 else -1)\n        if num2 == 0:\n            return abs(num1), (1 if num1 > 0 else -1), 0\n\n        s, old_s = 0, 1\n        t, old_t = 1, 0\n        r, old_r = num2, num1\n\n        while r != 0:\n            quotient = old_r // r\n            old_r, r = r, old_r - quotient * r\n            old_s, s = s, old_s - quotient * s\n            old_t, t = t, old_t - quotient * t\n\n        # Ensure g (old_r) is positive, adjusting coefficients if necessary.\n        if old_r < 0:\n            return -old_r, -old_s, -old_t\n        else:\n            return old_r, old_s, old_t\n\n    # Handle the trivial case where both a and b are zero.\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    # Compute gcd(a, b) and initial Bezout coefficients (x_gcd, y_gcd).\n    g, x_gcd, y_gcd = extended_gcd(a, b)\n\n    # If n is not divisible by g, no integer solution exists.\n    if n % g != 0:\n        return None\n\n    # Scale the Bezout coefficients to find a particular solution for ax + by = n.\n    k = n // g\n    x_part = x_gcd * k\n    y_part = y_gcd * k\n\n    # Normalize the solution to a canonical form: 0 <= x < abs(b/g) when b != 0.\n    if b != 0:\n        b_prime = b // g  # Coefficient for 't' in the general solution for x\n        x_final = x_part % abs(b_prime)\n\n        # Calculate 't' corresponding to x_final: x_final = x_part + b_prime * t\n        t = (x_final - x_part) // b_prime\n\n        # Calculate the corresponding y_final: y_final = y_part - (a/g) * t\n        a_prime = a // g\n        y_final = y_part - a_prime * t\n    else:  # b == 0, so the equation is ax = n.\n        # Since n % g == 0 and g == abs(a), n must be divisible by a.\n        x_final = n // a\n        y_final = y_part  # y_part is already 0 as per extended_gcd(a, 0)\n\n    return (x_final, y_final)"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n):\n    \"\"\"Compute sum of series defined by term(i) = n - 2*i for i = 0..(n // 2).\n\n    Parameters:\n      n (int): input integer per FR-1.\n\n    Returns:\n      int: sum of sequence terms (Result.sum)\n    \"\"\"\n    total_sum = 0\n    end_index = n // 2\n    for i in range(end_index + 1):\n        term = n - 2 * i\n        total_sum += term\n    return total_sum"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(source_list, elements_to_remove):\n    \"\"\"Return a new list with elements from source_list that are not present in elements_to_remove.\n\n    Preserves the original relative order of retained elements.\n    \"\"\"\n    try:\n        removal_lookup = set(elements_to_remove)\n    except TypeError:\n        # Fall back to list membership checks if elements are unhashable.\n        removal_lookup = elements_to_remove\n\n    result = []\n    for item in source_list:\n        if item not in removal_lookup:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/165", "solution": "import string\n\nclass InputString:\n    \"\"\"\n    Represents the input string and provides 1-based indexing accessors.\n    \"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def length(self) -> int:\n        return len(self._value)\n\n    def charAt(self, index: int) -> str:\n        \"\"\"\n        Returns the character at the 1-based index. Returns an empty string\n        for out-of-range indices.\n        \"\"\"\n        idx_0_based = index - 1\n        if 0 <= idx_0_based < len(self._value):\n            return self._value[idx_0_based]\n        return \"\"\n\nclass Alphabet:\n    \"\"\"\n    Provides English alphabet letters and mapping from 1-based position to character.\n    \"\"\"\n    def __init__(self):\n        self._letters = string.ascii_lowercase # 'a' through 'z'\n\n    def getLetterAt(self, position: int) -> str:\n        \"\"\"\n        Returns the alphabet letter at the 1-based position. Returns an empty string\n        for out-of-range positions.\n        \"\"\"\n        idx_0_based = position - 1\n        if 0 <= idx_0_based < len(self._letters):\n            return self._letters[idx_0_based]\n        return \"\"\n\nclass PositionMatch:\n    \"\"\"\n    Encapsulates evaluation of a single position and computes isMatch per SRS rules.\n    \"\"\"\n    def __init__(self, position: int, inputChar: str, alphabetChar: str):\n        self.position = position\n        self.inputChar = inputChar\n        self.alphabetChar = alphabetChar\n        self._is_match = self._calculate_is_match()\n\n    def _calculate_is_match(self) -> bool:\n        normalized_input_char = self.inputChar.lower()\n        # Check if the character is an English letter and matches the alphabet character.\n        return (len(normalized_input_char) == 1 and\n                'a' <= normalized_input_char <= 'z' and\n                normalized_input_char == self.alphabetChar)\n\n    def is_match(self) -> bool:\n        return self._is_match\n\ndef count_char_position(input: str) -> int:\n    \"\"\"\n    Counts characters in a string that occur at the same position as in the English alphabet (case insensitive).\n    \"\"\"\n    match_count = 0\n\n    input_string_obj = InputString(input)\n    alphabet_obj = Alphabet()\n\n    # Iterate from 1-based position 1 up to min(length of input, 26).\n    limit = min(input_string_obj.length(), 26)\n\n    for i in range(1, limit + 1):\n        char_from_input = input_string_obj.charAt(i)\n        char_from_alphabet = alphabet_obj.getLetterAt(i)\n\n        position_match = PositionMatch(i, char_from_input, char_from_alphabet)\n\n        if position_match.is_match():\n            match_count += 1\n\n    return match_count"}
{"task_id": "Mbpp/168", "solution": "def frequency(list, value) -> int:\n    \"\"\"Compute and return the number of occurrences of 'value' in 'list'.\"\"\"\n    count = 0\n    for item in list:\n        if item == value:\n            count += 1\n    return count"}
{"task_id": "Mbpp/166", "solution": "InputList = list[int]\n\nclass IntegerElement:\n    \"\"\"A lightweight wrapper for an integer to compute its parity.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def parity(self) -> str:\n        \"\"\"Returns 'even' if the value is even, 'odd' otherwise.\"\"\"\n        return 'even' if self.value % 2 == 0 else 'odd'\n\nclass Pair:\n    \"\"\"Represents a conceptual unordered pair of IntegerElements.\"\"\"\n    def __init__(self, a: IntegerElement, b: IntegerElement) -> None:\n        self.a = a\n        self.b = b\n\n    def xor(self) -> int:\n        \"\"\"Computes the bitwise XOR of the values of the two elements.\"\"\"\n        return self.a.value ^ self.b.value\n\n    def is_even_xor(self) -> bool:\n        \"\"\"Checks if the XOR of the two element values is even.\"\"\"\n        return self.xor() % 2 == 0\n\nclass Result:\n    \"\"\"A value object carrying the computed count.\"\"\"\n    def __init__(self, count: int) -> None:\n        self.count = count\n\nclass FindEvenPair:\n    \"\"\"Encapsulates the algorithmic business rule for finding even XOR pairs.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def find(self, input_list: InputList) -> Result:\n        \"\"\"\n        Computes the number of pairs in the list that XOR to an even number.\n        Uses an O(n) parity-counting algorithm.\n        \"\"\"\n        n = len(input_list)\n        if n < 2:\n            return Result(0)\n\n        n_even = 0\n        n_odd = 0\n\n        for val in input_list:\n            if val % 2 == 0:\n                n_even += 1\n            else:\n                n_odd += 1\n\n        # Calculate combinations: (n_even choose 2) + (n_odd choose 2)\n        # n choose 2 = n * (n - 1) // 2\n        count_even_even = (n_even * (n_even - 1)) // 2 if n_even >= 2 else 0\n        count_odd_odd = (n_odd * (n_odd - 1)) // 2 if n_odd >= 2 else 0\n\n        total_count = count_even_even + count_odd_odd\n        return Result(total_count)\n\ndef find_even_pair(input_list: list[int]) -> int:\n    \"\"\"\n    Counts the number of pairs of integers in a list that xor to an even number.\n    Delegates the core logic to FindEvenPair.\n    \"\"\"\n    finder = FindEvenPair()\n    result = finder.find(input_list)\n    return result.count"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Handles n=0 by returning 1.\n    \"\"\"\n    if n == 0:\n        return 1\n    return 1 << (n - 1).bit_length()"}
{"task_id": "Mbpp/171", "solution": "class Pentagon:\n    \"\"\"Represents the input side_length of a pentagon.\"\"\"\n    def __init__(self, side_length):\n        self.side_length = side_length\n\nclass PerimeterValue:\n    \"\"\"Represents the computed numeric perimeter value.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\nclass PerimeterCalculator:\n    \"\"\"Encapsulates the computation logic for a pentagon's perimeter.\"\"\"\n    def perimeter_pentagon(self, side_length: float) -> float:\n        \"\"\"Compute and return numeric perimeter = 5 * side_length.\"\"\"\n        pentagon = Pentagon(side_length)\n        perimeter = 5 * pentagon.side_length\n        perimeter_value = PerimeterValue(perimeter)\n        return perimeter_value.value\n\ndef perimeter_pentagon(side_length):\n    \"\"\"Return numeric perimeter for a regular pentagon given side_length.\"\"\"\n    calculator = PerimeterCalculator()\n    return calculator.perimeter_pentagon(side_length)"}
{"task_id": "Mbpp/170", "solution": "class Element:\n    \"\"\"Lightweight wrapper for an element, providing numeric validation.\"\"\"\n    def __init__(self, value, index: int):\n        self.value = value\n        self.index = index\n\n    def is_numeric(self) -> bool:\n        \"\"\"Checks if the element's value is an integer or a float.\"\"\"\n        return isinstance(self.value, (int, float))\n\nclass InputList:\n    \"\"\"Encapsulates the input list and provides access helpers.\"\"\"\n    def __init__(self, elements: list):\n        self._elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self._elements)\n\n    def get_slice(self, start: int, end: int) -> list:\n        \"\"\"Returns an inclusive slice of the list from start to end index.\"\"\"\n        return self._elements[start : end + 1]\n\nclass IndexRange:\n    \"\"\"Represents and validates a zero-based index range.\"\"\"\n    def __init__(self, start: int, end: int):\n        self.start = start\n        self.end = end\n\n    def isValid(self, listLength: int) -> bool:\n        \"\"\"Checks if the index range is valid for a given list length.\"\"\"\n        return (\n            0 <= self.start\n            and self.start <= self.end\n            and self.end < listLength\n        )\n\nclass SumResult:\n    \"\"\"Encapsulates the numeric sum result.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\nclass SumRangeFunction:\n    \"\"\"Orchestrates validation and summation of an InputList over an IndexRange.\"\"\"\n    def __init__(self, list_of_numbers: list, start_index: int, end_index: int):\n        self._input_list = InputList(list_of_numbers)\n        self._index_range = IndexRange(start_index, end_index)\n\n    def execute(self) -> (int | float):\n        \"\"\"Validates indices and elements, then computes and returns the sum.\"\"\"\n        if not self._index_range.isValid(self._input_list.length()):\n            raise IndexError(\"Invalid index range: 0 <= start <= end < len(list) required\")\n\n        elements_to_sum = self._input_list.get_slice(\n            self._index_range.start, self._index_range.end\n        )\n\n        current_sum = 0\n        for i, val in enumerate(elements_to_sum):\n            element_obj = Element(val, self._index_range.start + i)\n            if not element_obj.is_numeric():\n                raise TypeError(f\"Non-numeric element found at index {element_obj.index} in specified range\")\n            current_sum += val\n        \n        return SumResult(current_sum).value\n\ndef sum_range_list(list_of_numbers, start_index, end_index):\n    \"\"\"\n    Calculates the sum of numbers in a list within a specified range of indices.\n    Delegates validation and computation to domain objects.\n    \"\"\"\n    sum_range_calculator = SumRangeFunction(list_of_numbers, start_index, end_index)\n    return sum_range_calculator.execute()"}
