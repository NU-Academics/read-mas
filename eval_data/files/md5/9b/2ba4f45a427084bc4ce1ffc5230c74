{"task_id": "Mbpp/59", "solution": "class OctagonalNumber:\n    \"\"\"A data holder for the computed octagonal number value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass OctagonalFunction:\n    \"\"\"Encapsulates the logic for computing octagonal numbers.\"\"\"\n\n    def compute(self, n: int) -> OctagonalNumber:\n        \"\"\"Computes the nth octagonal number using the closed-form formula.\"\"\"\n        return OctagonalNumber(n * (3 * n - 2))\n\n    def is_octagonal(self, n: int) -> int:\n        \"\"\"Calculates the nth octagonal number by delegating computation.\"\"\"\n        # Validation and exception raising are omitted here as per explicit prompt instructions.\n        oct_num = self.compute(n)\n        return oct_num.value\n\ndef is_octagonal(n: int) -> int:\n    \"\"\"\n    Finds the nth octagonal number using the formula O_n = n * (3 * n - 2).\n    This function delegates the computation to an internal class.\n    \"\"\"\n    octagonal_calculator = OctagonalFunction()\n    return octagonal_calculator.is_octagonal(n)"}
{"task_id": "Mbpp/57", "solution": "class Validator:\n    \"\"\"Validates the input list of digits.\n    Per requirements, this implementation does not perform actual type or value checks.\"\"\"\n    def validate(self, digits: list) -> None:\n        # No isinstance() checks or raise exceptions as per specific requirement.\n        pass\n\nclass Sorter:\n    \"\"\"Sorts a list of digits in descending order.\"\"\"\n    def sort_desc(self, digits: list) -> list:\n        return sorted(digits, reverse=True)\n\nclass Concatenator:\n    \"\"\"Concatenates a list of digits into a single integer.\"\"\"\n    def concat(self, digits: list) -> int:\n        if not digits:\n            return 0\n        return int(\"\".join(map(str, digits)))\n\nclass Result:\n    \"\"\"Wraps the final integer result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass FindMaxNum:\n    \"\"\"Orchestrates validation, sorting, and concatenation to find the largest number.\"\"\"\n    def find_Max_Num(self, digits: list) -> int:\n        validator = Validator()\n        validator.validate(digits)\n\n        sorter = Sorter()\n        sorted_digits = sorter.sort_desc(digits)\n\n        concatenator = Concatenator()\n        value = concatenator.concat(sorted_digits)\n\n        result_obj = Result(value)\n        return result_obj.value\n\ndef find_Max_Num(digits):\n    \"\"\"Finds the largest number that can be formed with the given list of digits.\"\"\"\n    return FindMaxNum().find_Max_Num(digits)"}
{"task_id": "Mbpp/63", "solution": "from typing import List, Tuple\n\ndef max_difference(pairs: List[Tuple[float, float]]) -> float:\n    \"\"\"Compute the maximum absolute difference between numbers in 2-element tuples.\n    Returns 0.0 if the input list is empty.\n    \"\"\"\n    if not pairs:\n        return 0.0\n\n    max_abs_diff = 0.0\n    for a, b in pairs:\n        current_abs_diff = abs(a - b)\n        if current_abs_diff > max_abs_diff:\n            max_abs_diff = current_abs_diff\n            \n    return max_abs_diff"}
{"task_id": "Mbpp/61", "solution": "from typing import List\n\nclass InputString:\n    \"\"\"Encapsulates input value and provides validation and length.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the input string.\"\"\"\n        return len(self.value)\n\n    def validateDigits(self) -> bool:\n        \"\"\"Checks if the input string contains only digit characters.\"\"\"\n        return self.value.isdigit()\n\nclass Substring:\n    \"\"\"Represents a contiguous substring with its properties.\"\"\"\n    def __init__(self, start_index: int, end_index: int, value: str) -> None:\n        self.start_index = start_index\n        self.end_index = end_index\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the substring.\"\"\"\n        return len(self.value)\n\n    def digit_sum(self) -> int:\n        \"\"\"Calculates the sum of digits in the substring.\"\"\"\n        return sum(int(char) for char in self.value)\n\nclass Result:\n    \"\"\"Aggregates the final count of matching substrings.\"\"\"\n    def __init__(self, count: int = 0) -> None:\n        self._count = count\n\n    def increment(self, by: int = 1) -> None:\n        \"\"\"Increments the internal count by a specified amount.\"\"\"\n        self._count += by\n\n    def value(self) -> int:\n        \"\"\"Returns the current aggregated count.\"\"\"\n        return self._count\n\nclass SubstringEvaluator:\n    \"\"\"Orchestrates validation, substring enumeration, and counting.\"\"\"\n    def count_Substrings(self, s: str) -> int:\n        \"\"\"Counts substrings whose digit-sum equals their length.\"\"\"\n        input_str = InputString(s)\n        if not input_str.validateDigits():\n            raise ValueError(\"Input must contain digits only\")\n\n        result = Result()\n        substrings = self._enumerate_substrings(s)\n\n        for sub in substrings:\n            if sub.digit_sum() == sub.length():\n                result.increment()\n        return result.value()\n\n    def _enumerate_substrings(self, s: str) -> List[Substring]:\n        \"\"\"Generates all contiguous substrings of the input string.\"\"\"\n        substrings: List[Substring] = []\n        n = len(s)\n        for i in range(n):\n            for j in range(i + 1, n + 1):\n                substring_value = s[i:j]\n                substrings.append(Substring(i, j - 1, substring_value))\n        return substrings\n\ndef count_Substrings(s: str) -> int:\n    \"\"\"Counts the number of substrings with the sum of digits equal to their length.\"\"\"\n    evaluator = SubstringEvaluator()\n    return evaluator.count_Substrings(s)"}
{"task_id": "Mbpp/64", "solution": "from typing import List, Tuple\n\nclass SubjectMark:\n    \"\"\"Immutable value object for a subject and numeric score.\"\"\"\n    def __init__(self, subject: str, score: int):\n        self.subject = subject\n        self.score = score\n\n    def as_tuple(self) -> Tuple[str, int]:\n        \"\"\"Returns the SubjectMark as a 2-element tuple.\"\"\"\n        return (self.subject, self.score)\n\nclass Sorter:\n    \"\"\"Stateless utility providing key extraction and sorting operations.\"\"\"\n    @staticmethod\n    def key_by_second(item: Tuple) -> object:\n        \"\"\"Returns the second element of a tuple for sorting.\"\"\"\n        return item[1]\n\n    @staticmethod\n    def sort(items: List, key) -> List:\n        \"\"\"Returns a new list sorted ascending by the given key callable.\"\"\"\n        return sorted(items, key=key)\n\nclass SubjectMarkList:\n    \"\"\"Validates input list shape and orchestrates sorting of SubjectMark collections.\"\"\"\n    @staticmethod\n    def validate(marks: List[Tuple[str, int]]) -> bool:\n        \"\"\"Placeholder for input validation per design, returns True as checks are omitted.\"\"\"\n        # Per design context: \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n        # and \"behavior for malformed inputs is unspecified\".\n        return True\n\n    @staticmethod\n    def sort_by_score_ascending(marks: List[Tuple[str, int]]) -> List[Tuple[str, int]]:\n        \"\"\"Converts tuples to SubjectMark objects, sorts them by score, and converts back to tuples.\"\"\"\n        if not marks:\n            return []\n\n        # Convert input tuples to SubjectMark instances to preserve content during sorting (FR4).\n        subject_mark_objects = [SubjectMark(subject, score) for subject, score in marks]\n\n        # Delegate sorting to Sorter, using a lambda to extract the score from SubjectMark objects.\n        sorted_subject_mark_objects = Sorter.sort(subject_mark_objects, key=lambda sm: sm.score)\n\n        # Convert sorted SubjectMark instances back to tuples for the final result.\n        return [sm.as_tuple() for sm in sorted_subject_mark_objects]\n\ndef subject_marks(marks: List[Tuple[str, int]]) -> List[Tuple[str, int]]:\n    \"\"\"\n    Accepts a list of 2-element tuples (subject, score) and returns a new list of tuples\n    sorted ascending by score. Behavior for malformed inputs is unspecified by SRS.\n    \"\"\"\n    # The design guides `subject_marks` to orchestrate validation and sorting via `SubjectMarkList`.\n    SubjectMarkList.validate(marks) # Validation performed, but effectively a no-op due to constraints.\n    return SubjectMarkList.sort_by_score_ascending(marks)"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(input_list):\n    \"\"\"\n    Recursively flattens a list and sums all of its integer elements.\n    Raises TypeError for invalid top-level input or unsupported element types.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Top-level argument must be a list\")\n\n    total_sum = 0\n    for element in input_list:\n        if isinstance(element, int):\n            total_sum += element\n        elif isinstance(element, list):\n            total_sum += recursive_list_sum(element)\n        else:\n            raise TypeError(\"Unsupported element type\")\n    return total_sum"}
