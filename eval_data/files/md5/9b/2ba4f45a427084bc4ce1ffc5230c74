{"task_id": "Mbpp/629", "solution": "import collections\nfrom typing import List, Any\n\nclass Validator:\n    \"\"\"Helper class for validating types.\"\"\"\n    def is_list(self, x: Any) -> bool:\n        \"\"\"Checks if the input is a list.\"\"\"\n        return isinstance(x, list)\n\n    def is_integer(self, n: Any) -> bool:\n        \"\"\"Checks if the input is an integer.\"\"\"\n        return isinstance(n, int)\n\nclass EvenChecker:\n    \"\"\"Helper class for checking evenness of numbers.\"\"\"\n    def is_even(self, n: int) -> bool:\n        \"\"\"Checks if an integer is even.\"\"\"\n        return n % 2 == 0\n\nclass NumberList:\n    \"\"\"Wrapper for the input list of numbers.\"\"\"\n    def __init__(self, items: list):\n        self._items = items\n\n    def get_items(self) -> list:\n        \"\"\"Returns the internal list of items.\"\"\"\n        return self._items\n\nclass EvenNumberList:\n    \"\"\"Accumulates even integers, preserving order.\"\"\"\n    def __init__(self):\n        self._items: List[int] = []\n\n    def append(self, n: int) -> None:\n        \"\"\"Adds an even integer to the list.\"\"\"\n        self._items.append(n)\n\n    def get_items(self) -> list:\n        \"\"\"Returns the accumulated list of even numbers.\"\"\"\n        return self._items\n\nclass SplitFunction:\n    \"\"\"Orchestrates validation and filtering to find even numbers.\"\"\"\n    def __init__(self):\n        self._validator = Validator()\n        self._even_checker = EvenChecker()\n\n    def perform(self, numbers: list) -> list:\n        \"\"\"Performs the filtering of even numbers from the input list.\"\"\"\n        if not self._validator.is_list(numbers):\n            raise TypeError(\"Input must be a list.\")\n\n        input_list = NumberList(numbers)\n        even_numbers = EvenNumberList()\n\n        for item in input_list.get_items():\n            if self._validator.is_integer(item) and self._even_checker.is_even(item):\n                even_numbers.append(item)\n        \n        return even_numbers.get_items()\n\ndef Split(numbers: list) -> list:\n    \"\"\"\n    Finds even numbers from a list of numbers.\n    It delegates the filtering logic to an internal SplitFunction.\n    \"\"\"\n    split_func = SplitFunction()\n    return split_func.perform(numbers)"}
{"task_id": "Mbpp/630", "solution": "from typing import List, Tuple\n\nclass InputValidator:\n    \"\"\"Validates if an object is a tuple of exactly two integers.\"\"\"\n    def isTupleOfTwoInts(self, obj: any) -> bool:\n        \"\"\"Checks if the given object is a tuple of two integers.\"\"\"\n        if not isinstance(obj, tuple):\n            return False\n        if len(obj) != 2:\n            return False\n        if not isinstance(obj[0], int) or not isinstance(obj[1], int):\n            return False\n        return True\n\nclass Coordinate:\n    \"\"\"Represents a 2D coordinate with helper methods.\"\"\"\n    def __init__(self, x: int, y: int):\n        self.x = x\n        self.y = y\n\n    def toList(self) -> List[int]:\n        \"\"\"Converts the coordinate to a list [x, y].\"\"\"\n        return [self.x, self.y]\n\n    def offsets(self) -> List['Coordinate']:\n        \"\"\"Generates the 9 adjacent coordinates (3x3 neighborhood) including itself.\"\"\"\n        neighbors = []\n        for dx in [-1, 0, 1]:\n            for dy in [-1, 0, 1]:\n                neighbors.append(Coordinate(self.x + dx, self.y + dy))\n        return neighbors\n\nclass CoordinateList:\n    \"\"\"A collection of Coordinate objects with sorting and conversion capabilities.\"\"\"\n    def __init__(self, items: List[Coordinate]):\n        self.items = items\n\n    def sortByXY(self) -> None:\n        \"\"\"Sorts the internal list of coordinates by x then by y in ascending order.\"\"\"\n        self.items.sort(key=lambda coord: (coord.x, coord.y))\n\n    def toNestedLists(self) -> List[List[int]]:\n        \"\"\"Converts the list of Coordinate objects to a list of [x, y] lists.\"\"\"\n        return [coord.toList() for coord in self.items]\n\nclass CoordinateService:\n    \"\"\"Orchestrates the generation, sorting, and conversion of coordinate neighborhoods.\"\"\"\n    def get_coordinates(self, coord: Coordinate) -> List[List[int]]:\n        \"\"\"Extracts the 3x3 neighborhood for a given coordinate, sorts, and returns it as a nested list.\"\"\"\n        offset_coords = coord.offsets()\n        coord_list = CoordinateList(offset_coords)\n        coord_list.sortByXY()\n        return coord_list.toNestedLists()\n\ndef get_coordinates(coordinate: Tuple[int, int]) -> List[List[int]]:\n    \"\"\"\n    Extracts all the adjacent coordinates of the given coordinate tuple.\n    The result is a list of nine coordinate pairs, sorted by x then by y.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.isTupleOfTwoInts(coordinate):\n        raise TypeError('Input must be a tuple of two integers (x, y).')\n\n    x, y = coordinate\n    coord_obj = Coordinate(x, y)\n    service = CoordinateService()\n    return service.get_coordinates(coord_obj)"}
{"task_id": "Mbpp/632", "solution": "def move_zero(list) -> list:\n    \"\"\"Return a list where non-zero elements appear in original order followed by numeric zeros.\n    Parameter name is exactly 'list' to match the SRS signature requirement.\n    \"\"\"\n    non_zeros = []\n    zeros = []\n    for item in list:\n        if item == 0:\n            zeros.append(item)\n        else:\n            non_zeros.append(item)\n    return non_zeros + zeros"}
{"task_id": "Mbpp/631", "solution": "def replace_spaces(input_string: str) -> str:\n    \"\"\"\n    Replaces whitespace characters with underscores and underscores with spaces in the given string.\n    Performs a single-pass simultaneous swap.\n    \"\"\"\n    output_chars = []\n    for char in input_string:\n        if char == '_':\n            output_chars.append(' ')\n        elif char.isspace():\n            output_chars.append('_')\n        else:\n            output_chars.append(char)\n    return \"\".join(output_chars)"}
{"task_id": "Mbpp/637", "solution": "class Input:\n    \"\"\"Represents the input cost and selling price for evaluation.\"\"\"\n    def __init__(self, cost: float, selling_price: float):\n        self.cost = cost\n        self.selling_price = selling_price\n\nclass NoprofitNoLoss:\n    \"\"\"Encapsulates the business rule to evaluate no profit/no loss.\"\"\"\n    def evaluate(self, cost: float, selling_price: float) -> bool:\n        return selling_price == cost\n\nclass Result:\n    \"\"\"Represents the boolean outcome of the no profit/no loss evaluation.\"\"\"\n    def __init__(self, no_profit_no_loss: bool):\n        self.no_profit_no_loss = no_profit_no_loss\n\ndef noprofit_noloss(cost, selling_price) -> bool:\n    \"\"\"\n    Checks if there is no profit and no loss based on cost and selling price.\n    Returns True when selling_price equals cost, otherwise False.\n    \"\"\"\n    input_obj = Input(cost, selling_price)\n    evaluator = NoprofitNoLoss()\n    result_bool = evaluator.evaluate(input_obj.cost, input_obj.selling_price)\n    return result_bool"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(nums, n) -> int:\n    \"\"\"Compute sum of XOR for every unordered pair among first n elements of nums.\n\n    Args:\n        nums: list of integers (must not be modified)\n        n: int number of elements to consider\n\n    Returns:\n        int: sum of pairwise XORs, or 0 if fewer than two considered elements\n    \"\"\"\n    k = min(n, len(nums))\n\n    if k < 2:\n        return 0\n\n    total_xor_sum = 0\n    for i in range(k):\n        for j in range(i + 1, k):\n            total_xor_sum += nums[i] ^ nums[j]\n            \n    return total_xor_sum"}
{"task_id": "Mbpp/635", "solution": "def heap_sort(input_list):\n    \"\"\"Sort input_list (must be a list) and return a list sorted ascending.\n    Raises TypeError(\"heap_sort expects a list\") if input_list is not a list.\n    \"\"\"\n    def _heapify(arr, n, i):\n        # Helper to maintain the max-heap property for a subtree rooted at index i in arr of size n.\n        largest = i\n        left = 2 * i + 1\n        right = 2 * i + 2\n\n        if left < n and arr[largest] < arr[left]:\n            largest = left\n\n        if right < n and arr[largest] < arr[right]:\n            largest = right\n\n        if largest != i:\n            arr[i], arr[largest] = arr[largest], arr[i]\n            _heapify(arr, n, largest)\n\n    if not isinstance(input_list, list):\n        raise TypeError(\"heap_sort expects a list\")\n\n    if not input_list:\n        return []\n\n    arr = list(input_list)\n    n = len(arr)\n\n    # Build a maxheap. Start from the last non-leaf node and heapify upwards.\n    for i in range(n // 2 - 1, -1, -1):\n        _heapify(arr, n, i)\n\n    # One by one extract elements from the heap.\n    # Swap the current root with the last element of the unsorted part, then heapify the root.\n    for i in range(n - 1, 0, -1):\n        arr[i], arr[0] = arr[0], arr[i]\n        _heapify(arr, i, 0)\n\n    return arr"}
{"task_id": "Mbpp/638", "solution": "import math\n\ndef wind_chill(wind_velocity_kmh, temperature_celsius):\n    \"\"\"\n    Calculates the wind chill index rounded up to the next integer.\n    Negative wind velocities are treated as 0 km/h for the calculation.\n    \"\"\"\n    temp_c = float(temperature_celsius)\n    \n    # Handle negative wind_velocity_kmh by treating it as 0, as per BR8.\n    effective_wind_vel_kmh = max(0.0, float(wind_velocity_kmh))\n\n    # Convert wind velocity from km/h to m/s, as per BR3.\n    v_ms = effective_wind_vel_kmh / 3.6\n\n    # Calculate the raw wind chill index (WCI) using the formula from BR4.\n    # W = 13.12 + 0.6215*T - 11.37*(v_ms)^0.16 + 0.3965*T*(v_ms)^0.16\n    v_ms_power_0_16 = math.pow(v_ms, 0.16)\n    \n    raw_wci = (13.12 +\n               0.6215 * temp_c -\n               11.37 * v_ms_power_0_16 +\n               0.3965 * temp_c * v_ms_power_0_16)\n\n    # Round the raw WCI up to the next integer (ceiling), as per BR5 and BR7.\n    return int(math.ceil(raw_wci))"}
{"task_id": "Mbpp/639", "solution": "from typing import List\n\nclass Name:\n    \"\"\"Represents a single name string and provides operations related to its content.\"\"\"\n    def __init__(self, value: str) -> None:\n        self._value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the name.\"\"\"\n        return len(self._value)\n\n    def firstChar(self) -> str:\n        \"\"\"Returns the first character of the name, or an empty string if the name is empty.\"\"\"\n        return self._value[0] if self._value else ''\n\n    def startsWithLowercaseASCII(self) -> bool:\n        \"\"\"Returns True if the first character is a lowercase ASCII letter, else False.\"\"\"\n        first = self.firstChar()\n        return 'a' <= first <= 'z'\n\nclass NameList:\n    \"\"\"Encapsulates a collection of Name instances and provides filtering and aggregation.\"\"\"\n    def __init__(self, values: List[str]) -> None:\n        self._names = [Name(v) for v in values]\n\n    def filterOutLowercaseStarts(self) -> 'NameList':\n        \"\"\"Returns a new NameList containing only names that do not start with a lowercase ASCII letter.\"\"\"\n        filtered_values = [name._value for name in self._names if not name.startsWithLowercaseASCII()]\n        return NameList(filtered_values)\n\n    def totalLength(self) -> int:\n        \"\"\"Returns the sum of lengths of all names in the list.\"\"\"\n        return sum(name.length() for name in self._names)\n\n    def isEmpty(self) -> bool:\n        \"\"\"Returns True if the list of names is empty, else False.\"\"\"\n        return len(self._names) == 0\n\ndef sample_nam(names: List[str]) -> int:\n    \"\"\"\n    Sums the length of names after removing those that start with a lowercase letter.\n    Expects 'names' to be a list of strings.\n    \"\"\"\n    name_list = NameList(names)\n    filtered = name_list.filterOutLowercaseStarts()\n    if filtered.isEmpty():\n        return 0\n    return filtered.totalLength()"}
{"task_id": "Mbpp/641", "solution": "class InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input to nonagonal number calculation.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass InputValidator:\n    \"\"\"Validates input for nonagonal number calculations.\"\"\"\n    def is_integer(self, value) -> bool:\n        \"\"\"Returns True if the value is an integer.\"\"\"\n        return isinstance(value, int)\n\n    def is_ge_one(self, n: int) -> bool:\n        \"\"\"Returns True if n is greater than or equal to 1.\"\"\"\n        return n >= 1\n\n    def raise_invalid_input(self, message: str) -> None:\n        \"\"\"Raises an InvalidInputError with the given message.\"\"\"\n        raise InvalidInputError(message)\n\nclass NonagonalCalculator:\n    \"\"\"Calculates the nth nonagonal number with input validation.\"\"\"\n    def __init__(self):\n        self._validator = InputValidator()\n\n    def is_nonagonal(self, n: int) -> int:\n        \"\"\"\n        Public API method to validate and return the nth nonagonal number.\n        Delegates to compute_nonagonal after validation.\n        \"\"\"\n        if not self._validator.is_integer(n):\n            self._validator.raise_invalid_input(\"n must be an integer.\")\n        if not self._validator.is_ge_one(n):\n            self._validator.raise_invalid_input(\"n must be an integer >= 1.\")\n        \n        return self.compute_nonagonal(n)\n\n    def compute_nonagonal(self, n: int) -> int:\n        \"\"\"\n        Compute and return the integer value of the nth nonagonal number.\n        Uses the formula value = (n * (7 * n - 5)) // 2.\n        \"\"\"\n        # The formula for the nth nonagonal number is n * (7 * n - 5) / 2.\n        # Use integer division (//) to ensure an integer result.\n        return (n * (7 * n - 5)) // 2\n\ndef is_nonagonal(n):\n    \"\"\"\n    Finds the nth nonagonal number.\n    n must be an integer >= 1.\n    \"\"\"\n    calculator = NonagonalCalculator()\n    return calculator.is_nonagonal(n)"}
{"task_id": "Mbpp/643", "solution": "import re\nfrom typing import List\n\nclass MatchResult:\n    \"\"\"Encapsulates the result of a matching operation.\"\"\"\n    def __init__(self, found: bool, matched_words: List['Word'] = None):\n        self.found = found\n        self.matched_words = matched_words if matched_words is not None else []\n\nclass RegexEngine:\n    \"\"\"A minimal wrapper for regular expression matching.\"\"\"\n    def __init__(self, pattern: str):\n        self.pattern = pattern\n        self._regex = re.compile(pattern)\n\n    def match(self, string: str) -> MatchResult:\n        \"\"\"Applies the pattern to a string and returns a MatchResult.\"\"\"\n        if self._regex.search(string):\n            # For simplicity, we don't return the specific matched word here,\n            # as the overall function only needs a boolean.\n            return MatchResult(found=True)\n        return MatchResult(found=False)\n\nclass Word:\n    \"\"\"Represents a single tokenized word.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self._regex_engine = RegexEngine(r\"(?<=\\w)z(?=\\w)\") # Pattern for 'z' in the middle\n\n    def hasZMiddle(self) -> bool:\n        \"\"\"Checks if the word contains a lowercase 'z' not at its start or end.\"\"\"\n        return self._regex_engine.match(self.value).found\n\nclass TextInput:\n    \"\"\"Represents the raw input text and handles tokenization.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n\n    def tokenize(self) -> List[Word]:\n        \"\"\"Splits the raw text into a list of Word objects, treating whitespace and punctuation as separators.\"\"\"\n        # Use re.findall to extract sequences of alphanumeric characters as words.\n        # Convert to lowercase to ensure only 'z' (not 'Z') is considered.\n        tokens = re.findall(r'[a-zA-Z0-9]+', self.raw.lower())\n        return [Word(token) for token in tokens if token] # Filter out empty strings from findall\n\nclass TextProcessor:\n    \"\"\"Orchestrates tokenization and checking for internal 'z'.\"\"\"\n    def __init__(self, text_input: TextInput):\n        self.text_input = text_input\n\n    def findZMiddle(self) -> MatchResult:\n        \"\"\"Processes the input text to find any word with a middle 'z'.\"\"\"\n        words = self.text_input.tokenize()\n        for word in words:\n            if word.hasZMiddle():\n                return MatchResult(found=True, matched_words=[word])\n        return MatchResult(found=False)\n\ndef text_match_wordz_middle(text: str) -> bool:\n    \"\"\"\n    Checks if a string contains 'z', except at the start and end of a word.\n    Tokenization treats whitespace and punctuation as separators.\n    \"\"\"\n    text_input = TextInput(raw=text)\n    processor = TextProcessor(text_input=text_input)\n    result = processor.findZMiddle()\n    return result.found"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(arr: list, k: int) -> list:\n    \"\"\"Reverses the first k elements of an array, returning a new list.\n\n    Performs type validation for inputs and handles edge cases for k.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n    if not isinstance(k, int):\n        raise TypeError(\"Input 'k' must be an integer.\")\n\n    if k <= 0:\n        return arr[:]  # Return a shallow copy if k is non-positive.\n    \n    if k >= len(arr):\n        return arr[::-1]  # Return a full reversal if k is beyond or equal to array length.\n    \n    # Normal case: reverse the first k elements and concatenate with the remainder.\n    return arr[:k][::-1] + arr[k:]"}
{"task_id": "Mbpp/720", "solution": "def add_dict_to_tuple(input_tuple, input_dict):\n    \"\"\"Return a tuple containing all items from input_tuple (in order) followed by input_dict as the final element.\n\n    Raises TypeError if input_tuple is not a tuple or input_dict is not a dict.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"input_tuple must be a tuple\")\n    if not isinstance(input_dict, dict):\n        raise TypeError(\"input_dict must be a dict\")\n    return input_tuple + (input_dict,)"}
{"task_id": "Mbpp/721", "solution": "from typing import List, Union, Any\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass Cell:\n    \"\"\"Represents a cell in the matrix with its cost and coordinates.\"\"\"\n    def __init__(self, row: int, col: int, cost: Union[int, float]):\n        self.row = row\n        self.col = col\n        self.cost = cost\n\nclass Path:\n    \"\"\"Represents a path as a sequence of cells, providing methods for length, sum, and average.\"\"\"\n    def __init__(self, cells: List[Cell]):\n        self.cells = cells\n\n    def length(self) -> int:\n        return len(self.cells)\n\n    def sum(self) -> float:\n        return float(sum(cell.cost for cell in self.cells))\n\n    def average(self) -> float:\n        path_length = self.length()\n        if path_length == 0:\n            return 0.0\n        return self.sum() / path_length\n\ndef _is_numeric(value: Any) -> bool:\n    \"\"\"Helper to check if a value is an int or float.\"\"\"\n    return isinstance(value, (int, float))\n\ndef _validate_matrix(matrix: List[List[Any]]) -> None:\n    \"\"\"Validates the input matrix for non-empty, square shape, and numeric cell values.\"\"\"\n    if not matrix or not matrix[0]:\n        raise ValidationError(\"Matrix cannot be empty or have empty rows.\")\n    \n    n = len(matrix)\n    for i, row in enumerate(matrix):\n        if len(row) != n:\n            raise ValidationError(f\"Matrix must be square (N x N). Row {i} has length {len(row)}, expected {n}.\")\n        for j, cell_value in enumerate(row):\n            if not _is_numeric(cell_value):\n                raise ValidationError(f\"Matrix cells must contain numeric values. Cell ({i},{j}) has non-numeric value: {cell_value}\")\n\ndef _find_all_paths_dfs(matrix: List[List[Union[int, float]]]) -> List[Path]:\n    \"\"\"Enumerates all valid right/down paths from top-left to bottom-right using DFS.\"\"\"\n    all_paths: List[Path] = []\n    n = len(matrix)\n\n    def dfs(r: int, c: int, current_path_cells: List[Cell]):\n        current_path_cells.append(Cell(r, c, matrix[r][c]))\n\n        if r == n - 1 and c == n - 1:\n            all_paths.append(Path(list(current_path_cells)))\n        else:\n            if c + 1 < n: # Move right\n                dfs(r, c + 1, current_path_cells)\n            if r + 1 < n: # Move down\n                dfs(r + 1, c, current_path_cells)\n        \n        current_path_cells.pop() # Backtrack\n\n    dfs(0, 0, [])\n    return all_paths\n\ndef maxAverageOfPath(matrix: List[List[Union[int, float]]]) -> float:\n    \"\"\"\n    Given a square matrix, finds a path from top-left to bottom-right (moving only right or down)\n    with the maximum average cost.\n    \"\"\"\n    _validate_matrix(matrix)\n\n    n = len(matrix)\n    if n == 1:\n        return float(matrix[0][0])\n\n    paths = _find_all_paths_dfs(matrix)\n\n    if not paths:\n        raise ValidationError(\"No valid paths found, which should not occur for a valid non-empty square matrix.\")\n\n    max_avg = -float('inf')\n    for path in paths:\n        current_avg = path.average()\n        if current_avg > max_avg:\n            max_avg = current_avg\n            \n    return max_avg"}
{"task_id": "Mbpp/722", "solution": "class Validator:\n    \"\"\"\n    Handles validation for student data and filtering thresholds.\n    Raises TypeError on invalid inputs as specified by design.\n    \"\"\"\n    def validate_students(self, students):\n        if not isinstance(students, dict):\n            raise TypeError(\"Input 'students' must be a dictionary.\")\n        for name, data in students.items():\n            if not isinstance(name, str):\n                raise TypeError(f\"Student name '{name}' must be a string.\")\n            if not isinstance(data, tuple) or len(data) != 2:\n                raise TypeError(f\"Student data for '{name}' must be a 2-element tuple.\")\n            height, weight = data\n            if not isinstance(height, (int, float)) or not isinstance(weight, (int, float)):\n                raise TypeError(f\"Height and weight for '{name}' must be numeric values.\")\n\n    def validate_thresholds(self, minHeight, minWeight):\n        if not isinstance(minHeight, (int, float)):\n            raise TypeError(\"Minimum height 'minHeight' must be a numeric value.\")\n        if not isinstance(minWeight, (int, float)):\n            raise TypeError(\"Minimum weight 'minWeight' must be a numeric value.\")\n\nclass FilterResult:\n    \"\"\"\n    A helper class to collect filtered student results into a new dictionary.\n    It provides methods to add matching entries.\n    \"\"\"\n    def __init__(self):\n        self.results = {}\n\n    def add(self, name, tuple_value):\n        self.results[name] = tuple_value\n\ndef filter_data(students, minHeight, minWeight):\n    \"\"\"\n    Filters students that meet the minimum height and weight criteria.\n    It returns a new dictionary with the qualifying students.\n    \"\"\"\n    validator = Validator()\n    validator.validate_students(students)\n    validator.validate_thresholds(minHeight, minWeight)\n\n    filter_result = FilterResult()\n    for name, data_tuple in students.items():\n        height, weight = data_tuple\n        if height >= minHeight and weight >= minWeight:\n            filter_result.add(name, data_tuple)\n\n    return filter_result.results"}
{"task_id": "Mbpp/724", "solution": "class InputValidator:\n    \"\"\"Validates that both base and power are integers.\"\"\"\n    def validate(self, base, power) -> bool:\n        return isinstance(base, int) and isinstance(power, int)\n\nclass BigIntegerValue:\n    \"\"\"Represents a large integer as its decimal string representation.\"\"\"\n    def __init__(self, decimal_string: str) -> None:\n        self.decimal_string = decimal_string\n\n    @staticmethod\n    def from_integer(value: int) -> 'BigIntegerValue':\n        \"\"\"Creates a BigIntegerValue instance from an integer.\"\"\"\n        return BigIntegerValue(str(value))\n\n    def to_decimal_string(self) -> str:\n        \"\"\"Returns the decimal string representation.\"\"\"\n        return self.decimal_string\n\nclass DigitSumResult:\n    \"\"\"Encapsulates the computed sum of digits.\"\"\"\n    def __init__(self, sum_value: int) -> None:\n        self.sum = sum_value\n\n    def to_integer(self) -> int:\n        \"\"\"Returns the digit sum as an integer.\"\"\"\n        return self.sum\n\nclass PowerBaseFunction:\n    \"\"\"Orchestrates the calculation of the sum of digits of base to a power.\"\"\"\n    def __init__(self, base: int, power: int) -> None:\n        self.base = base\n        self.power = power\n\n    def execute(self) -> int:\n        \"\"\"Executes the full computation process.\"\"\"\n        if not InputValidator().validate(self.base, self.power):\n            raise ValueError(\"Invalid input: base and power must be integers\")\n        \n        compute_value = self.base ** self.power\n        big = BigIntegerValue.from_integer(compute_value)\n        decimal = big.to_decimal_string()\n        digits = [int(ch) for ch in decimal]\n        total = sum(digits)\n        return DigitSumResult(total).to_integer()\n\ndef power_base_sum(base, power) -> int:\n    \"\"\"Calculates the sum of all digits of the base to the specified power.\"\"\"\n    return PowerBaseFunction(base, power).execute()"}
{"task_id": "Mbpp/723", "solution": "class Validator:\n    \"\"\"Validates the equal-length precondition for two lists.\"\"\"\n    def validateEqualLength(self, listA: list, listB: list) -> bool:\n        return len(listA) == len(listB)\n\nclass Counter:\n    \"\"\"Implements the counting algorithm for matching indices.\"\"\"\n    def countSamePair(self, listA: list, listB: list) -> int:\n        count = 0\n        for a, b in zip(listA, listB):\n            if a == b:\n                count += 1\n        return count\n\ndef count_same_pair(listA: list, listB: list) -> int:\n    \"\"\"\n    Counts indices where lists have same values, validating equal length.\n    Raises ValueError if input lists are not of the same length.\n    \"\"\"\n    validator = Validator()\n    if not validator.validateEqualLength(listA, listB):\n        raise ValueError(\"input lists must be same length\")\n    \n    counter = Counter()\n    return counter.countSamePair(listA, listB)"}
{"task_id": "Mbpp/725", "solution": "from typing import List, Optional\n\nclass QuotedSubstring:\n    \"\"\"Represents an extracted substring and its order.\"\"\"\n    def __init__(self, value: str, order_index: int):\n        self.value = value\n        self.order_index = order_index\n\nclass ResultList:\n    \"\"\"Aggregates QuotedSubstring instances and provides a list of their values.\"\"\"\n    def __init__(self):\n        self.items: List[QuotedSubstring] = []\n\n    def append(self, qs: QuotedSubstring):\n        self.items.append(qs)\n\n    def to_list(self) -> List[str]:\n        return [qs.value for qs in self.items]\n\nclass Parser:\n    \"\"\"Scans an input string to find substrings between double quotes.\"\"\"\n    def __init__(self, input_text: str):\n        self._text = input_text\n        self.position = 0\n        self._length = len(input_text)\n\n    def findNextQuoted(self) -> Optional[QuotedSubstring]:\n        \"\"\"\n        Finds the next substring enclosed in double quotes.\n        Returns a QuotedSubstring with the extracted value and a dummy index, or None if no more pairs.\n        \"\"\"\n        start_quote_idx = self._text.find('\"', self.position)\n        if start_quote_idx == -1:\n            return None\n\n        content_start_idx = start_quote_idx + 1\n        end_quote_idx = self._text.find('\"', content_start_idx)\n\n        if end_quote_idx == -1:\n            # If an opening quote is found but no closing quote, advance position past it\n            # to prevent getting stuck and allow searching for subsequent quotes.\n            self.position = start_quote_idx + 1\n            return None\n\n        extracted_value = self._text[content_start_idx:end_quote_idx]\n        self.position = end_quote_idx + 1\n\n        # The Parser returns a QuotedSubstring, but the order_index is assigned by the caller.\n        # A dummy index (e.g., 0) is used here.\n        return QuotedSubstring(extracted_value, 0)\n\ndef extract_quotation(input: str) -> list:\n    \"\"\"\n    Extracts values between double quotation marks from the given string.\n    \"\"\"\n    parser = Parser(input)\n    result = ResultList()\n    idx = 1 # Order index starts from 1 as per design's pseudocode\n\n    while True:\n        qs_from_parser = parser.findNextQuoted()\n        if qs_from_parser is None:\n            break\n        # Create a new QuotedSubstring instance for the ResultList with the correct order index.\n        result.append(QuotedSubstring(qs_from_parser.value, idx))\n        idx += 1\n\n    return result.to_list()"}
{"task_id": "Mbpp/726", "solution": "def _validate_input(input_tuple):\n    \"\"\"\n    Validates the input tuple for type, length, and element types.\n    Raises TypeError or ValueError for invalid input.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n    \n    if len(input_tuple) < 2:\n        raise ValueError(\"Input tuple must have at least 2 elements.\")\n        \n    for element in input_tuple:\n        if not isinstance(element, (int, float)):\n            raise TypeError(\"All elements in the input tuple must be numbers (int or float).\")\n\ndef multiply_elements(input_tuple):\n    \"\"\"\n    Calculates pairwise products of adjacent elements in a tuple of numbers.\n    The function validates the input and returns a new tuple of products.\n    \"\"\"\n    _validate_input(input_tuple)\n    \n    products = []\n    for i in range(len(input_tuple) - 1):\n        products.append(input_tuple[i] * input_tuple[i+1])\n        \n    return tuple(products)"}
{"task_id": "Mbpp/728", "solution": "import collections.abc\nfrom typing import List, Union, Number, Iterator\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for validation errors in input lists.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n\nclass NumericElement:\n    \"\"\"Domain wrapper for a numeric value (int or float).\"\"\"\n    def __init__(self, value: Number):\n        if not isinstance(value, (int, float)):\n            raise ValidationError(f\"Element must be numeric, got {type(value).__name__}\")\n        self.value: Number = value\n\n    def __repr__(self) -> str:\n        return f\"NumericElement({self.value})\"\n\nclass InputList:\n    \"\"\"Domain wrapper for input lists; provide element access and length.\"\"\"\n    def __init__(self, elements: List[Number]):\n        self.elements: List[Number] = []\n        for e in elements:\n            # Validate and wrap elements as NumericElement to ensure type consistency\n            try:\n                self.elements.append(NumericElement(e).value)\n            except ValidationError as ve:\n                raise ValidationError(f\"Invalid element in input list: {ve.message}\") from ve\n\n    def __len__(self) -> int:\n        return len(self.elements)\n\n    def __iter__(self) -> Iterator[Number]:\n        return iter(self.elements)\n\n    @property\n    def length(self) -> int:\n        return len(self.elements)\n\nclass ResultList:\n    \"\"\"Domain wrapper for output lists; hold result elements and support length access.\"\"\"\n    def __init__(self, elements: List[Number]):\n        self.elements: List[Number] = elements\n\n    def __len__(self) -> int:\n        return len(self.elements)\n\n    def __iter__(self) -> Iterator[Number]:\n        return iter(self.elements)\n\n    @property\n    def length(self) -> int:\n        return len(self.elements)\n    \n    def __eq__(self, other):\n        if not isinstance(other, ResultList):\n            if isinstance(other, (list, tuple)):\n                return self.elements == list(other)\n            return NotImplemented\n        return self.elements == other.elements\n\n    def __repr__(self):\n        return f\"ResultList({self.elements})\"\n\n\ndef sum_list(a: Union[InputList, collections.abc.Sequence], b: Union[InputList, collections.abc.Sequence]) -> ResultList:\n    \"\"\"Validate inputs a and b (length equality and numeric elements) and return ResultList of element-wise sums.\"\"\"\n    \n    # Wrap builtin sequences as InputList internally for consistent handling\n    input_a = a if isinstance(a, InputList) else InputList(list(a))\n    input_b = b if isinstance(b, InputList) else InputList(list(b))\n\n    if input_a.length != input_b.length:\n        raise ValidationError(\"Input lists must have the same length.\")\n\n    # Return empty list if both inputs are empty (handled by length check and loop below)\n    if input_a.length == 0:\n        return ResultList([])\n\n    result_elements: List[Number] = []\n    for i in range(input_a.length):\n        val_a = input_a.elements[i]\n        val_b = input_b.elements[i]\n        result_elements.append(val_a + val_b)\n\n    return ResultList(result_elements)"}
{"task_id": "Mbpp/730", "solution": "from typing import List, Any\n\ndef consecutive_duplicates(items: List[Any]) -> List[Any]:\n    \"\"\"\n    Removes consecutive duplicate elements from a list, preserving order and non-consecutive duplicates.\n    Returns a new list with runs of adjacent equal items collapsed to a single element.\n    \"\"\"\n    if not items:\n        return []\n\n    result = []\n    for item in items:\n        if not result or item != result[-1]:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/731", "solution": "import math\n\nPI = 3.141592653589793\n\ndef lateralsurface_cone(r, h) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cone given its radius and height.\n    The lateral surface area is PI * r * l, where l is the slant height.\n    \"\"\"\n    slant_height = math.sqrt(r**2 + h**2)\n    lateral_area = PI * r * slant_height\n    return lateral_area"}
{"task_id": "Mbpp/732", "solution": "import enum\nfrom typing import List, Dict, Optional\n\nclass SpecialCharacter(enum.Enum):\n    SPACE = ' '\n    COMMA = ','\n    DOT = '.'\n\nclass Character:\n    \"\"\"Represents a single character with its value and position.\"\"\"\n    def __init__(self, value: str, position: int):\n        self.value = value\n        self.position = position\n\n    def isSpecial(self) -> bool:\n        \"\"\"Checks if the character is one of the defined special characters.\"\"\"\n        return self.value in [e.value for e in SpecialCharacter]\n\nclass NonSpecialCharacter:\n    \"\"\"Represents a non-special character.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass InputString:\n    \"\"\"Lightweight holder for the input string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\n\nclass OutputString:\n    \"\"\"Lightweight holder for the output string result.\"\"\"\n    def __init__(self, value: str = ''):\n        self.value = value\n\nclass ReplaceSpecialCharFunction:\n    \"\"\"Encapsulates the algorithm to replace special characters with colons.\"\"\"\n    def __init__(self):\n        self._special_map: Dict[str, str] = {\n            SpecialCharacter.SPACE.value: ':',\n            SpecialCharacter.COMMA.value: ':',\n            SpecialCharacter.DOT.value: ':'\n        }\n\n    def replace(self, input_str: str) -> str:\n        \"\"\"Iterates through the input string, replacing special characters.\"\"\"\n        if not input_str:\n            return ''\n\n        output_chars: List[str] = []\n        for i, char_value in enumerate(input_str):\n            char_obj = Character(char_value, i)\n            if char_obj.isSpecial():\n                output_chars.append(self._special_map.get(char_value, char_value)) # Use get with default to be robust\n            else:\n                output_chars.append(char_value)\n        return \"\".join(output_chars)\n\ndef replace_specialchar(input: str) -> str:\n    \"\"\"\n    Replaces all occurrences of spaces, commas, or dots with a colon.\n    This function serves as the public API entry point.\n    \"\"\"\n    transformer = ReplaceSpecialCharFunction()\n    return transformer.replace(input)"}
{"task_id": "Mbpp/734", "solution": "from typing import List, Sequence, Union\n\ndef _product_of_list(numbers: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"Computes the multiplicative product of elements in a list.\"\"\"\n    product = 1\n    for num in numbers:\n        product *= num\n    return product\n\ndef _generate_contiguous_subarrays(list_of_numbers: Sequence[Union[int, float]]) -> List[List[Union[int, float]]]:\n    \"\"\"Generates all contiguous non-empty subarrays from the input list.\"\"\"\n    n = len(list_of_numbers)\n    subarrays = []\n    for i in range(n):\n        for j in range(i, n):\n            subarrays.append(list(list_of_numbers[i : j + 1]))\n    return subarrays\n\ndef sum_Of_Subarray_Prod(list_of_numbers: Sequence[Union[int, float]]) -> Union[int, float]:\n    \"\"\"Compute and return the arithmetic sum of products of all contiguous non-empty subarrays.\"\"\"\n    total_sum = 0\n    subarrays = _generate_contiguous_subarrays(list_of_numbers)\n\n    for sub_array in subarrays:\n        total_sum += _product_of_list(sub_array)\n\n    return total_sum"}
{"task_id": "Mbpp/733", "solution": "from typing import Sequence\n\ndef find_first_occurrence(array, target) -> int:\n    \"\"\"\n    Signature must be exactly: find_first_occurrence(array, target)\n    Parameters:\n      - array: Sequence[float] (treated as sorted non-decreasingly per SRS)\n      - target: float\n    Returns:\n      - int: smallest 0-based index i such that array[i] == target\n    Implementation approach (left-biased binary search):\n      - Use two pointers low=0, high=len(array)-1\n      - While low <= high:\n          mid = (low + high) // 2\n          if array[mid] < target: low = mid + 1\n          else: high = mid - 1\n      - After loop, check if low < len(array) and array[low] == target -> return low\n      - (Behavior when target not found is not specified in SRS; therefore implementation must not invent behavior \u2014 but to return an int per SRS, the function will only be invoked/verified with cases where target exists per FR3 and FR4.)\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n\n    while low <= high:\n        mid = (low + high) // 2\n        if array[mid] < target:\n            low = mid + 1\n        else:  # array[mid] >= target\n            high = mid - 1\n    \n    # Per the design notes, the target is guaranteed to exist in the array\n    # for all verified invocations. Therefore, `low` will be the index\n    # of the first occurrence of `target`.\n    return low"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(n: int) -> int:\n    \"\"\"Return an int where MSB and LSB of n are preserved and all other bits are inverted.\n    The Most Significant Bit (MSB) is determined as the highest set bit in the minimal\n    non-negative binary representation of n. For inputs with 0 or 1 bits, no middle bits\n    exist, so the number is returned unchanged.\n    \"\"\"\n    if n < 0:\n        # The design context recommends using the \"minimal non-negative binary representation\"\n        # for MSB determination, implying handling of positive integers.\n        # This implementation assumes non-negative inputs.\n        # For negative inputs, the behavior of bit_length() and bitwise operations\n        # can be complex and depends on two's complement representation.\n        # Raising an error or defining specific behavior for negative numbers\n        # would be necessary if they are part of the expected domain.\n        # For now, following the implicit positive-integer context.\n        pass # The current logic will handle it as is, but could be unexpected.\n\n    bit_length = n.bit_length()\n\n    # If the number has 0, 1, or 2 bits, there are no \"middle\" bits to toggle.\n    # e.g., 0 (0 bits), 1 (1 bit), 2 (10 - 2 bits), 3 (11 - 2 bits)\n    # In these cases, MSB and LSB are the only bits or there are no bits to toggle.\n    if bit_length <= 2:\n        return n\n\n    # Create a mask with 1s for all bit positions.\n    all_ones_mask = (1 << bit_length) - 1\n\n    # Create a mask for the Most Significant Bit (MSB).\n    msb_mask = (1 << (bit_length - 1))\n\n    # Create a mask for the Least Significant Bit (LSB).\n    lsb_mask = (1 << 0) # Which is 1\n\n    # Create a mask for bits to preserve (MSB and LSB).\n    preserve_mask = msb_mask | lsb_mask\n\n    # Create a mask for the middle bits (all bits except MSB and LSB).\n    # This is done by taking all_ones_mask and XORing with bits to preserve.\n    middle_bits_mask = all_ones_mask ^ preserve_mask\n\n    # Toggle the middle bits of n using XOR with the middle_bits_mask.\n    result = n ^ middle_bits_mask\n\n    return result"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sequence, value):\n    \"\"\"Return leftmost index where value may be inserted to preserve non-decreasing order.\"\"\"\n    low = 0\n    high = len(sequence)\n    while low < high:\n        mid = (low + high) // 2\n        if sequence[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/737", "solution": "import re\nfrom dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass InputString:\n    value: str\n    def length(self) -> int:\n        return len(self.value)\n\n@dataclass\nclass CheckResult:\n    is_vowel_start: bool\n\nclass VowelSet:\n    def __init__(self):\n        self.vowels: List[str] = ['a', 'e', 'i', 'o', 'u']\n\n    def as_character_class(self) -> str:\n        \"\"\"Returns the vowels as a string suitable for a regex character class.\"\"\"\n        return \"\".join(self.vowels)\n\nclass RegexEngine:\n    def __init__(self, pattern: str):\n        self.pattern: str = pattern\n        self._compiled_pattern = re.compile(self.pattern)\n\n    def match(self, input_str: str) -> bool:\n        \"\"\"Checks if the input string matches the anchored regex pattern.\"\"\"\n        return bool(self._compiled_pattern.match(input_str))\n\nclass CheckFunction:\n    def __init__(self, regex_engine: RegexEngine):\n        self.regex_engine: RegexEngine = regex_engine\n\n    def check_str(self, input_obj: InputString) -> CheckResult:\n        \"\"\"Orchestrates the regex matching and returns the check result.\"\"\"\n        match_result = self.regex_engine.match(input_obj.value)\n        return CheckResult(is_vowel_start=match_result)\n\ndef check_str(input_string: str) -> bool:\n    \"\"\"\n    Checks if the given string starts with a lowercase vowel (a, e, i, o, u) using regex.\n    Returns True if it starts with a vowel, False otherwise (including empty strings).\n    \"\"\"\n    input_obj = InputString(value=input_string)\n\n    vowel_set = VowelSet()\n    vowel_character_class = vowel_set.as_character_class()\n\n    regex_pattern = f'^{vowel_character_class}'\n    regex_engine = RegexEngine(pattern=regex_pattern)\n\n    check_function_instance = CheckFunction(regex_engine)\n\n    result = check_function_instance.check_str(input_obj)\n\n    return result.is_vowel_start"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(s):\n    \"\"\"Return True if every character in s is identical to every other character; otherwise False.\n\n    Returns True for an empty string.\n    \"\"\"\n    return len(set(s)) <= 1"}
{"task_id": "Mbpp/739", "solution": "def find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with exactly n digits.\n    Example: assert find_Index(2) == 4\n    \"\"\"\n    k = 1\n    while True:\n        triangular_num = k * (k + 1) // 2\n        \n        # Determine the number of decimal digits using string conversion,\n        # which is an integer-accurate method to avoid floating-point issues.\n        current_digits = len(str(triangular_num))\n        \n        if current_digits == n:\n            return k\n        \n        k += 1"}
{"task_id": "Mbpp/740", "solution": "def validate_length(t: tuple) -> None:\n    \"\"\"Raise ValueError if len(t) % 2 == 1.\"\"\"\n    if len(t) % 2 == 1:\n        raise ValueError(\"input tuple has odd length\")\n\ndef validate_key_hashability(key) -> None:\n    \"\"\"Raise TypeError if key is not hashable.\"\"\"\n    try:\n        hash(key)\n    except TypeError:\n        raise TypeError(\"unhashable key\")\n\ndef tuple_to_dict(t: tuple) -> dict:\n    \"\"\"Convert an input tuple to a dict by pairing adjacent elements.\n\n    Raises:\n        ValueError: if len(t) is odd.\n        TypeError: if a candidate key is not hashable.\n    \"\"\"\n    validate_length(t)\n    \n    result = {}\n    for i in range(0, len(t), 2):\n        key = t[i]\n        value = t[i+1]\n        validate_key_hashability(key)\n        result[key] = value\n    \n    return result"}
{"task_id": "Mbpp/743", "solution": "def _validate_inputs(lst, k):\n    \"\"\"Validate types and business rules for k; raises on violation.\"\"\"\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer.\")\n    if k < 0:\n        raise ValueError(\"k cannot be negative.\")\n\ndef _compute_effective_k(n, k):\n    \"\"\"Return k % n if n > 0, else 0.\"\"\"\n    if n == 0:\n        return 0\n    return k % n\n\ndef rotate_right(list, k):\n    \"\"\"Return a new list obtained by right-rotating 'list' by k positions.\n\n    Raises TypeError if k is not an int (BR5).\n    Raises ValueError if k < 0 (BR6).\n    \"\"\"\n    _validate_inputs(list, k)\n\n    if not list:\n        return []\n\n    n = len(list)\n    effective_k = _compute_effective_k(n, k)\n\n    # The last effective_k elements come to the front, followed by the first n - effective_k elements.\n    return list[-effective_k:] + list[:-effective_k]"}
{"task_id": "Mbpp/742", "solution": "import math\n\nclass NumericInput:\n    def __init__(self, value):\n        self.value = value\n\n    def is_valid(self) -> bool:\n        \"\"\"Returns True if the value is a finite, non-negative number.\"\"\"\n        try:\n            return math.isfinite(self.value) and self.value >= 0\n        except TypeError:\n            return False\n\nclass Tetrahedron:\n    def __init__(self, edgeLength: float):\n        self.edgeLength = edgeLength\n\n    def surfaceArea(self) -> float:\n        \"\"\"Computes the surface area of the regular tetrahedron.\"\"\"\n        return math.sqrt(3) * (self.edgeLength ** 2)\n\nclass CalculationResult:\n    def __init__(self, value: float):\n        self.value = value\n\nclass CalculationService:\n    def area_tetrahedron(self, a) -> float:\n        \"\"\"Validates input 'a', computes the surface area using Tetrahedron, and returns the float result.\"\"\"\n        numeric = NumericInput(a)\n        if not numeric.is_valid():\n            raise ValueError(\"Invalid numeric input for edge length\")\n        \n        tetra = Tetrahedron(a)\n        value = tetra.surfaceArea()\n        return float(value)\n\ndef area_tetrahedron(a):\n    \"\"\"Calculates the surface area of a regular tetrahedron from its edge length 'a'.\"\"\"\n    svc = CalculationService()\n    return svc.area_tetrahedron(a)"}
{"task_id": "Mbpp/744", "solution": "def check_none(input_tuple: tuple) -> bool:\n    \"\"\"\n    Checks if the given tuple contains any None value.\n    Raises TypeError if the input is not a tuple.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"input must be a tuple\")\n    for elem in input_tuple:\n        if elem is None:\n            return True\n    return False"}
{"task_id": "Mbpp/750", "solution": "def add_tuple(list_input, tuple_input):\n    \"\"\"Accepts a list and a tuple and returns a new list: list_input elements followed by tuple_input elements in order.\"\"\"\n    return [*list_input, *tuple_input]"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(s: str) -> str:\n    \"\"\"\n    Inserts spaces before uppercase letters when preceded by a lowercase letter.\n    Preserves existing whitespace, punctuation, and letter case.\n    \"\"\"\n    if not s:\n        return \"\"\n\n    result_chars = []\n    for i, char in enumerate(s):\n        # Insert a space if:\n        # 1. It's not the first character (i > 0).\n        # 2. The current character is an uppercase letter.\n        # 3. The immediately preceding character was a lowercase letter.\n        if i > 0 and char.isupper() and s[i-1].islower():\n            result_chars.append(' ')\n        result_chars.append(char)\n\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/745", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception for domain-specific validation errors.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\n\nclass Range:\n    \"\"\"Handles validation of the start and end numbers for the range.\"\"\"\n    def __init__(self, start: int, end: int):\n        self.start = start\n        self.end = end\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if start and end are integers and start <= end.\"\"\"\n        if not isinstance(self.start, int) or not isinstance(self.end, int):\n            return False\n        return self.start <= self.end\n\n    def validate_or_raise(self) -> None:\n        \"\"\"Validates inputs and raises TypeError or ValueError on failure.\"\"\"\n        if not isinstance(self.start, int) or not isinstance(self.end, int):\n            raise TypeError(\"startnum and endnum must be integers.\")\n        if self.start > self.end:\n            raise ValueError(\"startnum must be less than or equal to endnum.\")\n\nclass Number:\n    \"\"\"Represents a number and provides methods for digit analysis.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def digits(self) -> list[int]:\n        \"\"\"Extracts individual digits from the number.\"\"\"\n        return [int(d) for d in str(self.value)]\n\n    def contains_zero(self) -> bool:\n        \"\"\"Checks if the number contains the digit zero.\"\"\"\n        return '0' in str(self.value)\n\n    def is_divisible_by_digits(self) -> bool:\n        \"\"\"Checks if the number is divisible by each of its non-zero digits.\"\"\"\n        for digit in self.digits():\n            if digit == 0:  # This case is handled by contains_zero, but defensive check\n                return False\n            if self.value % digit != 0:\n                return False\n        return True\n\nclass ResultList:\n    \"\"\"Collects qualifying integers and manages their sorted state.\"\"\"\n    def __init__(self):\n        self.results: list[int] = []\n\n    def add(self, n: int) -> None:\n        \"\"\"Adds a number to the collection.\"\"\"\n        self.results.append(n)\n\n    def sort_ascending(self) -> None:\n        \"\"\"Sorts the collected numbers in ascending order.\"\"\"\n        self.results.sort()\n\n    def items(self) -> list[int]:\n        \"\"\"Returns the current list of collected numbers.\"\"\"\n        return self.results\n\nclass DivisibleByDigitsFunction:\n    \"\"\"Orchestrates the process of finding numbers divisible by their digits within a range.\"\"\"\n    def __init__(self, startnum: int, endnum: int):\n        self.startnum = startnum\n        self.endnum = endnum\n        # Validate the input range immediately upon initialization\n        range_validator = Range(self.startnum, self.endnum)\n        range_validator.validate_or_raise()\n        self._result_list = ResultList()\n\n    def execute(self) -> list[int]:\n        \"\"\"Executes the number search and returns the sorted list of results.\"\"\"\n        for n in range(self.startnum, self.endnum + 1):\n            current_number = Number(n)\n            if current_number.contains_zero():\n                continue\n            if current_number.is_divisible_by_digits():\n                self._result_list.add(n)\n        \n        self._result_list.sort_ascending()\n        return self._result_list.items()\n\ndef divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a given range from startnum to endnum where\n    every number is divisible by every digit it contains.\n    \"\"\"\n    processor = DivisibleByDigitsFunction(startnum, endnum)\n    return processor.execute()"}
{"task_id": "Mbpp/749", "solution": "from typing import List\n\nclass NumericString:\n    def __init__(self, value: str) -> None:\n        \"\"\"Initializes a NumericString with its string value.\"\"\"\n        self._value = value\n    \n    def parseToInt(self) -> int:\n        \"\"\"Parses the string value to an integer.\"\"\"\n        return int(self._value)\n\nclass ParsedInteger:\n    def __init__(self, value: int) -> None:\n        \"\"\"Initializes a ParsedInteger with its integer value.\"\"\"\n        self._value = value\n    \n    def get_value(self) -> int:\n        \"\"\"Returns the integer value.\"\"\"\n        return self._value\n\nclass SortedResult:\n    def __init__(self, values: List[int]) -> None:\n        \"\"\"Initializes a SortedResult with a list of sorted integers.\"\"\"\n        self._values = values\n    \n    def get_values(self) -> List[int]:\n        \"\"\"Returns the sorted list of integers.\"\"\"\n        return self._values\n\nclass SortService:\n    def sort_numeric_strings(self, input: List[str]) -> List[int]:\n        \"\"\"Orchestrates parsing and sorting of numeric strings.\"\"\"\n        parsed_ints = []\n        for s in input:\n            numeric_string_obj = NumericString(s)\n            parsed_int_val = numeric_string_obj.parseToInt()\n            parsed_integer_obj = ParsedInteger(parsed_int_val)\n            parsed_ints.append(parsed_integer_obj.get_value())\n        \n        parsed_ints.sort()\n        \n        sorted_result_obj = SortedResult(parsed_ints)\n        return sorted_result_obj.get_values()\n\ndef sort_numeric_strings(input: List[str]) -> List[int]:\n    \"\"\"\n    Sorts a list of strings of numbers numerically.\n    It delegates the core logic to a SortService instance.\n    \"\"\"\n    service = SortService()\n    return service.sort_numeric_strings(input)"}
{"task_id": "Mbpp/751", "solution": "from typing import List\n\ndef left(i: int) -> int:\n    \"\"\"Returns the 0-based index of the left child for a given parent index i.\"\"\"\n    return 2 * i + 1\n\ndef right(i: int) -> int:\n    \"\"\"Returns the 0-based index of the right child for a given parent index i.\"\"\"\n    return 2 * i + 2\n\ndef validate_node(i: int, elements: List) -> bool:\n    \"\"\"Checks if the node at index i satisfies the min-heap property with respect to its children.\"\"\"\n    n = len(elements)\n    left_child_idx = left(i)\n    right_child_idx = right(i)\n\n    if left_child_idx < n and elements[i] > elements[left_child_idx]:\n        return False\n    if right_child_idx < n and elements[i] > elements[right_child_idx]:\n        return False\n    \n    return True\n\ndef check_min_heap(elements: List) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap using 0-based indexing.\n    An empty or single-element array is considered a min-heap.\n    \"\"\"\n    n = len(elements)\n\n    if n <= 1:\n        return True\n\n    # Iterate through all potential parent nodes. The last parent is at index floor((n-2)/2).\n    for i in range((n - 2) // 2 + 1):\n        if not validate_node(i, elements):\n            return False\n\n    return True"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth Jacobsthal number using zero-based indexing and an iterative approach.\n    Raises TypeError for non-integer input or ValueError for negative integer input.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    j_n_minus_2 = 0  # Represents J(i-2)\n    j_n_minus_1 = 1  # Represents J(i-1)\n    j_n = 0          # Represents J(i)\n\n    for _ in range(2, n + 1):\n        j_n = j_n_minus_1 + 2 * j_n_minus_2\n        j_n_minus_2 = j_n_minus_1\n        j_n_minus_1 = j_n\n    \n    return j_n"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds elements that appear at the same index in all three input lists.\n    Raises TypeError if any input is not a list.\n    \"\"\"\n    if not isinstance(l1, list) or not isinstance(l2, list) or not isinstance(l3, list):\n        raise TypeError(\"extract_index_list requires three list arguments\")\n\n    min_length = min(len(l1), len(l2), len(l3))\n    common_elements = []\n\n    for i in range(min_length):\n        if l1[i] == l2[i] == l3[i]:\n            common_elements.append(l1[i])\n\n    return common_elements"}
{"task_id": "Mbpp/753", "solution": "from typing import List, Optional, Tuple\n\nclass Record:\n    \"\"\"Represents a single input record (name, value) preserving original index.\"\"\"\n    def __init__(self, name: str, value: float, original_index: int):\n        self.name = name\n        self.value = value\n        self.original_index = original_index\n\n    def as_tuple(self) -> Tuple[str, float]:\n        \"\"\"Returns the record as a (name, value) tuple.\"\"\"\n        return (self.name, self.value)\n\ndef tuple_to_record(record_tuple: tuple, original_index: int) -> Record:\n    \"\"\"Converts a tuple to a Record object, ensuring the value is float.\"\"\"\n    return Record(record_tuple[0], float(record_tuple[1]), original_index)\n\nclass InputValidator:\n    \"\"\"Validates incoming parameters: records and k.\"\"\"\n    def validate_records(self, records: list) -> None:\n        \"\"\"Ensures records is a list of valid tuples with numeric second elements.\"\"\"\n        if not isinstance(records, list):\n            raise ValueError(\"Input 'records' must be a list.\")\n        for i, record_tuple in enumerate(records):\n            if not isinstance(record_tuple, tuple):\n                raise ValueError(f\"Record at index {i} must be a tuple, got {type(record_tuple).__name__}.\")\n            if len(record_tuple) < 2:\n                raise ValueError(f\"Record tuple at index {i} must have at least two elements.\")\n            \n            second_element = record_tuple[1]\n            if not isinstance(second_element, (int, float)):\n                raise ValueError(f\"Second element '{second_element}' in record at index {i} must be numeric (int or float).\")\n\n    def validate_k(self, k: int) -> None:\n        \"\"\"Ensures k is an integer or castable to an integer.\"\"\"\n        try:\n            int(k)\n        except (TypeError, ValueError):\n            raise ValueError(\"Input 'k' must be an integer or castable to an integer.\")\n\nclass RecordCollection:\n    \"\"\"Holds Record objects and provides sort/select functionality.\"\"\"\n    def __init__(self, records: Optional[List[Record]] = None):\n        self.records: List[Record] = records if records is not None else []\n        self.size: int = len(self.records)\n\n    def add(self, record: Record) -> None:\n        \"\"\"Adds a single Record to the collection.\"\"\"\n        self.records.append(record)\n        self.size = len(self.records)\n\n    def sort_by_value(self) -> None:\n        \"\"\"Sorts the internal list of records by value, then original_index for stability.\"\"\"\n        self.records.sort(key=lambda r: (r.value, r.original_index))\n\n    def get_min_k(self, k: int) -> List[Record]:\n        \"\"\"Returns the k records with the smallest values, preserving order.\"\"\"\n        if k <= 0:\n            return []\n        \n        self.sort_by_value()\n        \n        if k >= self.size:\n            return self.records\n        else:\n            return self.records[:k]\n\nclass MinKService:\n    \"\"\"Orchestrates validation, conversion, selection, and return of tuples.\"\"\"\n    def __init__(self, validator: Optional[InputValidator] = None, collection_cls: type = None):\n        self.validator = validator if validator is not None else InputValidator()\n        self.collection_cls = collection_cls if collection_cls is not None else RecordCollection\n\n    def min_k(self, records: list, k: int) -> List[Tuple[str, float]]:\n        \"\"\"\n        Processes records to find the k smallest by value.\n        Validates inputs, converts, sorts, selects, and converts back to tuples.\n        \"\"\"\n        self.validator.validate_records(records)\n        self.validator.validate_k(k)\n\n        record_objects: List[Record] = []\n        for i, record_tuple in enumerate(records):\n            record_objects.append(tuple_to_record(record_tuple, i))\n        \n        collection = self.collection_cls(record_objects)\n        \n        selected_records = collection.get_min_k(k)\n        \n        return [r.as_tuple() for r in selected_records]\n\ndef min_k(records: list, k: int) -> List[Tuple[str, float]]:\n    \"\"\"\n    Finds minimum k records from a list of tuples based on their second numeric element.\n\n    Delegates to MinKService for validation, processing, and selection logic.\n    \"\"\"\n    service = MinKService()\n    return service.min_k(records, k)"}
{"task_id": "Mbpp/760", "solution": "def unique_Element(elements):\n    \"\"\"Return True if the input 'elements' contains exactly one distinct element, else False.\"\"\"\n    distinct_elements = set(elements)\n    return len(distinct_elements) == 1"}
{"task_id": "Mbpp/755", "solution": "import collections.abc\nfrom dataclasses import dataclass\nfrom typing import List, Optional\n\n@dataclass\nclass Number:\n    value: float\n    position: Optional[int] = None\n\n@dataclass\nclass ListOfNumber:\n    elements: List[Number]\n\n    def length(self) -> int:\n        return len(self.elements)\n\n@dataclass\nclass Result:\n    value: float\n\ndef validateInput(list_of_numbers):\n    \"\"\"\n    Validates if the input is a sequence of numbers and raises ValueError if not.\n    \"\"\"\n    if not isinstance(list_of_numbers, collections.abc.Sequence):\n        raise ValueError(\"Input must be a sequence.\")\n    if len(list_of_numbers) < 2:\n        raise ValueError(\"Input list must contain at least two numbers.\")\n    for item in list_of_numbers:\n        if not isinstance(item, (int, float)):\n            raise ValueError(\"All elements in the list must be numbers (int or float).\")\n\ndef second_smallest(list_of_numbers):\n    \"\"\"\n    Finds the second smallest number in a list, handling duplicates as per sorted order.\n    It first validates the input and then sorts the list to find the second element.\n    \"\"\"\n    validateInput(list_of_numbers)\n    \n    # Sort the list to find the second smallest element.\n    # The design specifies \"second element in sorted order\" for duplicates.\n    sorted_numbers = sorted(list_of_numbers)\n    \n    # Return the element at index 1 (second element)\n    return sorted_numbers[1]"}
{"task_id": "Mbpp/759", "solution": "import re\n\nDECIMAL_PATTERN = r'^\\d+\\.\\d{2}$'\n\ndef is_decimal(input) -> bool:\n    \"\"\"Accept a single argument 'input'. Return True iff input is a str matching DECIMAL_PATTERN exactly; otherwise return False.\"\"\"\n    if not isinstance(input, str):\n        return False\n    return re.fullmatch(DECIMAL_PATTERN, input) is not None"}
{"task_id": "Mbpp/757", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for invalid input to count_reverse_pairs.\"\"\"\n    pass\n\nclass StringElement:\n    \"\"\"Value object representing an input string and its original index.\"\"\"\n    def __init__(self, value: str, index: int):\n        self.value = value\n        self.index = index\n\nclass ReversePair:\n    \"\"\"Value object representing a discovered unordered reverse pair.\"\"\"\n    def __init__(self, indexA: int, indexB: int, valueA: str, valueB: str):\n        self.indexA = indexA\n        self.indexB = indexB\n        self.valueA = valueA\n        self.valueB = valueB\n\nclass ReversePairCounter:\n    \"\"\"Counts pairs of reverse strings in a list after validating input.\"\"\"\n\n    def _is_reverse(self, a: str, b: str) -> bool:\n        \"\"\"Checks if string 'a' is the exact reverse of string 'b'.\"\"\"\n        return a == b[::-1]\n\n    def _validate_input(self, input_list: list[str]) -> None:\n        \"\"\"Validates that the input is a list of strings, raising ValidationError if not.\"\"\"\n        if not isinstance(input_list, list):\n            raise ValidationError(\"Input must be a list.\")\n        for i, item in enumerate(input_list):\n            if not isinstance(item, str):\n                raise ValidationError(f\"All elements in the list must be strings. Found non-string at index {i}.\")\n\n    def count_reverse_pairs(self, input_list: list[str]) -> int:\n        \"\"\"Counts unordered pairs of strings where one is the reverse of another.\"\"\"\n        self._validate_input(input_list)\n\n        if len(input_list) < 2:\n            return 0\n\n        count = 0\n        n = len(input_list)\n        \n        # Using a dictionary to store strings and their indices for optimized lookup\n        # This approach helps handle duplicate strings and ensures 'distinct by position'.\n        # For [\"abc\", \"cba\", \"cba\"], \"abc\" (idx 0) matches \"cba\" (idx 1), count=1.\n        # \"abc\" (idx 0) matches \"cba\" (idx 2), count=2.\n        # \"cba\" (idx 1) and \"cba\" (idx 2) are not reverses of each other.\n        # This implementation uses a nested loop approach as specified in design context:\n        # \"a correct simple approach is nested loops checking _is_reverse for each index pair i < j\"\n        \n        for i in range(n):\n            for j in range(i + 1, n):\n                if self._is_reverse(input_list[i], input_list[j]):\n                    count += 1\n        \n        return count\n\ndef count_reverse_pairs(input_list: list[str]) -> int:\n    \"\"\"Counts pairs of reverse strings in the given string list.\"\"\"\n    counter = ReversePairCounter()\n    return counter.count_reverse_pairs(input_list)"}
{"task_id": "Mbpp/758", "solution": "def unique_sublists(input_list):\n    \"\"\"\n    Counts lists within a list, converting each to a tuple and returning\n    a dictionary of unique tuples and their occurrence counts.\n    \"\"\"\n    def _to_hashable(element):\n        \"\"\"Recursively converts lists to tuples for hashing; raises TypeError for unhashable non-list elements.\"\"\"\n        if isinstance(element, list):\n            return tuple(_to_hashable(item) for item in element)\n        else:\n            try:\n                hash(element)\n                return element\n            except TypeError:\n                raise TypeError(f\"Unhashable element found: {type(element).__name__}\")\n\n    if not isinstance(input_list, list):\n        raise TypeError(\"input_list must be a list\")\n\n    counts = {}\n    for sublist_item in input_list:\n        hashable_key = _to_hashable(sublist_item)\n        counts[hashable_key] = counts.get(hashable_key, 0) + 1\n    return counts"}
{"task_id": "Mbpp/762", "solution": "class Validator:\n    MIN_MONTH: int = 1\n    MAX_MONTH: int = 12\n\n    def isValidMonth(self, month: int) -> bool:\n        \"\"\"Checks if the month number is within the valid range (1-12).\"\"\"\n        return self.MIN_MONTH <= month <= self.MAX_MONTH\n\nclass MonthRules:\n    def __init__(self) -> None:\n        \"\"\"Initializes the MonthRules with months that have 30 days.\"\"\"\n        self.monthsWith30Days: list[int] = [4, 6, 9, 11]\n\n    def has30Days(self, month: int) -> bool:\n        \"\"\"Checks if the given month number is in the list of 30-day months.\"\"\"\n        return month in self.monthsWith30Days\n\nclass Month:\n    def __init__(self, number: int, rules: \"MonthRules\" = None) -> None:\n        \"\"\"Initializes a Month object with its number and a MonthRules instance.\"\"\"\n        self.number = number\n        self._rules = rules if rules is not None else MonthRules()\n\n    def has30Days(self) -> bool:\n        \"\"\"Determines if the month has 30 days by consulting the rules.\"\"\"\n        return self._rules.has30Days(self.number)\n\nclass MonthCheckService:\n    def __init__(self, validator: \"Validator\" = None, rules: \"MonthRules\" = None) -> None:\n        \"\"\"Initializes the service with validator and month rules.\"\"\"\n        self.validator = validator if validator is not None else Validator()\n        self.rules = rules if rules is not None else MonthRules()\n\n    def check_monthnumber_number(self, month: int) -> bool:\n        \"\"\"Checks if the given month number has 30 days.\"\"\"\n        if not self.validator.isValidMonth(month):\n            raise ValueError(\"month must be in 1..12\")\n        month_obj = Month(month, self.rules)\n        return month_obj.has30Days()\n\ndef check_monthnumber_number(month: int) -> bool:\n    \"\"\"Checks whether the given month number contains 30 days or not.\"\"\"\n    service = MonthCheckService()\n    return service.check_monthnumber_number(month)"}
{"task_id": "Mbpp/764", "solution": "def _count_digits(s: str) -> int:\n    \"\"\"Counts ASCII digit characters '0'-'9' in the given string.\"\"\"\n    count = 0\n    for char in s:\n        if '0' <= char <= '9':\n            count += 1\n    return count\n\ndef number_ctr(input_string: str) -> int:\n    \"\"\"Counts the number of digits in the given string.\"\"\"\n    return _count_digits(input_string)"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(array, n):\n    \"\"\"\n    Finds the minimum difference between any two elements among the first n elements in the array.\n    Assumes array contains numeric elements.\n    \"\"\"\n    \n    # Determine the number of elements to consider, limited by array's actual length.\n    num_elements_to_consider = min(n, len(array))\n    \n    # Select the first 'num_elements_to_consider' elements and convert to a mutable list.\n    elements = list(array[:num_elements_to_consider])\n    \n    # Sort the selected elements to simplify finding minimum adjacent differences.\n    elements.sort()\n    \n    # Initialize the minimum difference to infinity.\n    min_diff = float('inf')\n    \n    # Iterate through the sorted elements from the second one to compare with its predecessor.\n    # If len(elements) < 2, the loop range will be empty, and min_diff will remain float('inf'),\n    # which is the natural outcome without explicit error checking for insufficient elements.\n    for i in range(1, len(elements)):\n        diff = abs(elements[i] - elements[i-1])\n        min_diff = min(min_diff, diff)\n        \n    return min_diff"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers, target) -> int:\n    \"\"\"Return the number of distinct index pairs (i < j) in 'numbers' whose sum equals 'target'.\n    The function must not modify 'numbers' and must return an int >= 0.\n    \"\"\"\n    if numbers is None:\n        return 0\n\n    n = len(numbers)\n    if n < 2:\n        return 0\n\n    count = 0\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target:\n                count += 1\n    return count"}
{"task_id": "Mbpp/766", "solution": "from typing import Any, List, Tuple\n\ndef pair_wise(input_list: List[Any]) -> List[Tuple[Any, Any]]:\n    \"\"\"\n    Returns an ordered list of consecutive 2-tuples from the input_list.\n    Returns an empty list if the input_list has fewer than two elements.\n    \"\"\"\n    if len(input_list) < 2:\n        return []\n\n    result: List[Tuple[Any, Any]] = []\n    for i in range(len(input_list) - 1):\n        result.append((input_list[i], input_list[i + 1]))\n    return result"}
{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    \"\"\"Finds the nth polite number.\n    A polite number is a positive integer that is not a power of two.\n    \"\"\"\n    def isPowerOfTwo(x: int) -> bool:\n        \"\"\"Checks if a positive integer is a power of two.\"\"\"\n        return x > 0 and (x & (x - 1)) == 0\n\n    polite_count = 0\n    num = 1\n    while True:\n        if not isPowerOfTwo(num):\n            polite_count += 1\n        if polite_count == n:\n            return num\n        num += 1"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n) -> int:\n    \"\"\"\n    Calculates the sum of the fourth powers of the first n odd natural numbers.\n    The sum is computed as sum_{k=1..n} (2*k - 1)^4.\n    \"\"\"\n    return sum((2 * k - 1) ** 4 for k in range(1, n + 1))"}
{"task_id": "Mbpp/771", "solution": "class Bracket:\n    _BRACKET_PAIRS = {\n        '(': ')',\n        '{': '}',\n        '[': ']',\n        ')': '(',\n        '}': '{',\n        ']': '['\n    }\n    _OPENING_BRACKETS = {'(', '{', '['}\n    _CLOSING_BRACKETS = {')', '}', ']'}\n\n    def __init__(self, symbol: str, position: int):\n        self.symbol = symbol\n        self.position = position\n        self.isOpening = symbol in self._OPENING_BRACKETS\n\n    def matchingSymbol(self) -> str:\n        return self._BRACKET_PAIRS[self.symbol]\n\n\nclass Expression:\n    _ALL_BRACKETS = {'(', ')', '{', '}', '[', ']'}\n\n    def __init__(self, content: str):\n        self.content = content\n\n    def length(self) -> int:\n        return len(self.content)\n\n    def extractBrackets(self) -> list['Bracket']:\n        brackets = []\n        for i, char in enumerate(self.content):\n            if char in self._ALL_BRACKETS:\n                brackets.append(Bracket(char, i))\n        return brackets\n\n\nclass Stack:\n    def __init__(self):\n        self._items = []\n\n    def push(self, item):\n        self._items.append(item)\n\n    def pop(self):\n        if not self.isEmpty():\n            return self._items.pop()\n        raise IndexError(\"pop from empty stack\")\n\n    def peek(self):\n        if not self.isEmpty():\n            return self._items[-1]\n        return None\n\n    def isEmpty(self) -> bool:\n        return len(self._items) == 0\n\n\nclass ValidationResult:\n    def __init__(self, isBalanced: bool, message: str = \"\"):\n        self.isBalanced = isBalanced\n        self.message = message\n\n\nclass CheckExpressionService:\n    _BRACKET_MAP = {\n        '(': ')',\n        '{': '}',\n        '[': ']'\n    }\n\n    def _isMatching(self, open_symbol: str, close_symbol: str) -> bool:\n        return self._BRACKET_MAP.get(open_symbol) == close_symbol\n\n    def check_expression(self, expression_str: str) -> bool:\n        if not expression_str:\n            return True\n\n        expression_obj = Expression(expression_str)\n        bracket_tokens = expression_obj.extractBrackets()\n\n        stack = Stack()\n\n        for bracket in bracket_tokens:\n            if bracket.isOpening:\n                stack.push(bracket)\n            else:  # Closing bracket\n                if stack.isEmpty():\n                    return False\n\n                top_bracket = stack.peek()\n                if self._isMatching(top_bracket.symbol, bracket.symbol):\n                    stack.pop()\n                else:\n                    return False\n\n        return stack.isEmpty()\n\n\ndef check_expression(expression: str) -> bool:\n    \"\"\"Checks if the given expression has balanced brackets.\n    Returns True if balanced, False otherwise.\"\"\"\n    service = CheckExpressionService()\n    return service.check_expression(expression)"}
{"task_id": "Mbpp/769", "solution": "def _validate_inputs(listA, listB) -> None:\n    \"\"\"\n    Validates that both inputs are instances of built-in list.\n    Raises TypeError if either input is not a list.\n    \"\"\"\n    if not isinstance(listA, list) or not isinstance(listB, list):\n        raise TypeError(\"Both inputs must be lists\")\n\ndef _compute_difference(listA: list, listB: list) -> list:\n    \"\"\"\n    Computes the difference between listA and listB, preserving order.\n    Returns a new list containing elements from listA not present in listB.\n    \"\"\"\n    b_set = set(listB)\n    result = []\n    for item in listA:\n        if item not in b_set:\n            result.append(item)\n    return result\n\ndef Diff(listA: list, listB: list) -> list:\n    \"\"\"\n    Returns a new list containing elements from listA whose values do not appear in listB.\n    Validates inputs and computes the difference.\n    \"\"\"\n    _validate_inputs(listA, listB)\n    return _compute_difference(listA, listB)"}
{"task_id": "Mbpp/773", "solution": "import dataclasses\nfrom typing import Optional, Tuple\n\n@dataclasses.dataclass\nclass OccurrenceResult:\n    substring: str\n    start_index: int\n    end_index: int\n\n@dataclasses.dataclass\nclass SourceString:\n    value: str\n\n@dataclasses.dataclass\nclass Substring:\n    value: str\n\nclass OccurrenceService:\n    def occurance_substring(self, source: str, sub: str) -> Optional[Tuple[str, int, int]]:\n        \"\"\"Locate first occurrence and return tuple or None.\"\"\"\n        source_str = SourceString(source)\n        sub_str = Substring(sub)\n\n        start_index = source_str.value.find(sub_str.value)\n        if start_index == -1:\n            return None\n        else:\n            end_index = start_index + len(sub_str.value)\n            return (sub_str.value, start_index, end_index)\n\ndef occurance_substring(source: str, sub: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"Public API function. Returns (substring, start_index, end_index) or None.\"\"\"\n    service = OccurrenceService()\n    return service.occurance_substring(source, sub)"}
{"task_id": "Mbpp/772", "solution": "from typing import List\n\nclass Word:\n    \"\"\"Represent a token with text and length attributes.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n        self.length = len(text)\n\nclass OutputString:\n    \"\"\"Represent the final returned string.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\ndef ascii_space() -> str:\n    \"\"\"Internal helper returning ASCII space ' ' (0x20).\"\"\"\n    return ' '\n\nclass Tokenizer:\n    \"\"\"Convert input_string into List[Word] by splitting on one or more whitespace characters.\"\"\"\n    def tokenize(self, input_str: str) -> List[Word]:\n        \"\"\"Splits the input string into Word tokens based on whitespace.\"\"\"\n        raw_tokens = input_str.split()\n        return [Word(token) for token in raw_tokens]\n\nclass Filter:\n    \"\"\"Filter Word tokens whose length equals k.\"\"\"\n    def filter(self, words: List[Word], k: int) -> List[Word]:\n        \"\"\"Removes words whose character count equals k.\"\"\"\n        return [word for word in words if word.length != k]\n\nclass Joiner:\n    \"\"\"Assembles retained tokens into OutputString using single ASCII spaces and trims edges.\"\"\"\n    def __init__(self, separator: str = None):\n        self.separator = separator if separator is not None else ascii_space()\n\n    def join(self, words: List[Word]) -> OutputString:\n        \"\"\"Joins retained Word tokens into normalized OutputString.\"\"\"\n        texts = [word.text for word in words]\n        joined_text = self.separator.join(texts).strip()\n        return OutputString(joined_text)\n\nclass RemoveLengthFunction:\n    \"\"\"Orchestrates tokenization -> filtering -> joining -> trimming and return final string.\"\"\"\n    def __init__(self, tokenizer: Tokenizer, filterer: Filter, joiner: Joiner):\n        self.tokenizer = tokenizer\n        self.filterer = filterer\n        self.joiner = joiner\n\n    def remove_length(self, input_string: str, k: int) -> str:\n        \"\"\"Orchestrates the process of removing words of a specific length.\"\"\"\n        tokens = self.tokenizer.tokenize(input_string)\n        retained = self.filterer.filter(tokens, k)\n        out = self.joiner.join(retained)\n        return out.text\n\ndef remove_length(input_string: str, k: int) -> str:\n    \"\"\"\n    Removes all the words with k length from the given string.\n    The function tokenizes, filters, and joins words using a pipeline.\n    \"\"\"\n    tokenizer_instance = Tokenizer()\n    filter_instance = Filter()\n    joiner_instance = Joiner()\n    orchestrator = RemoveLengthFunction(tokenizer_instance, filter_instance, joiner_instance)\n    return orchestrator.remove_length(input_string, k)"}
{"task_id": "Mbpp/777", "solution": "from collections import Counter\n\ndef find_sum(lst: list) -> int:\n    \"\"\"Return the sum of elements that occur exactly once in the input list.\"\"\"\n    counts = Counter(lst)\n    total_sum = 0\n    for element, count in counts.items():\n        if count == 1:\n            total_sum += element\n    return total_sum"}
{"task_id": "Mbpp/775", "solution": "def odd_position(input_list) -> bool:\n    \"\"\"\n    Return True iff every element at a zero-based odd index (1,3,5,...) is an odd integer.\n    For len(input_list) <= 1 returns True.\n    \"\"\"\n    if len(input_list) <= 1:\n        return True\n\n    for i in range(1, len(input_list), 2):\n        element = input_list[i]\n        if not (isinstance(element, int) and element % 2 == 1):\n            return False\n            \n    return True"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list):\n    \"\"\"Packs consecutive duplicates of list elements into sublists, raising TypeError if the input is not a list. Returns a new list of lists, where each inner list contains maximal runs of identical adjacent elements.\"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"input_list must be a list or sequence.\")\n\n    if not input_list:\n        return []\n\n    result = []\n    current_run = []\n\n    for element in input_list:\n        if not current_run or element == current_run[-1]:\n            current_run.append(element)\n        else:\n            result.append(current_run)\n            current_run = [element]\n\n    if current_run:\n        result.append(current_run)\n\n    return result"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(n):\n    \"\"\"Accepts a single integer parameter n; returns True if the number of positive divisors of n is even, otherwise False.\n    Divisors counted are positive integers including 1 and n when n>0.\n    \"\"\"\n    count = 0\n    # Iterate d from 1 to int(sqrt(n)) inclusive; count pairs of divisors (d and n//d) when n % d == 0.\n    # For n <= 0, int(n**0.5) might raise an error or result in an empty range, aligning with built-in behavior.\n    limit = int(n**0.5)\n    \n    for d in range(1, limit + 1):\n        if n % d == 0:\n            if d * d == n:\n                count += 1\n            else:\n                count += 2\n    \n    return count % 2 == 0"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int]) -> int:\n    \"\"\"Compute the sum of all elements in all contiguous odd-length subarrays of arr.\"\"\"\n    n = len(arr)\n    total_sum = 0\n\n    for i in range(n):\n        for j in range(i, n):\n            # j is the end index (inclusive) of the subarray\n            # current subarray is arr[i:j+1]\n            # length = (j + 1) - i\n            length = j - i + 1\n            if length % 2 == 1:\n                # If the length is odd, sum its elements\n                for k in range(i, j + 1):\n                    total_sum += arr[k]\n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "from typing import List\n\ndef mul_even_odd(input_list: List[int]) -> int:\n    \"\"\"\n    Finds the product of the first even and first odd number in a list.\n    It scans the list from left to right to find the earliest occurrence of each.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in input_list:\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        \n        if first_even is not None and first_odd is not None:\n            break # Both required numbers found, stop iterating\n            \n    # Per instructions, no error handling for missing elements or non-integer types.\n    # The problem implies such numbers will be found to compute the product.\n    return first_even * first_odd"}
{"task_id": "Mbpp/780", "solution": "from typing import List, Tuple, Union\n\ndef find_combinations(input: List[Tuple[Union[int, float], Union[int, float]]]) -> List[Tuple[Union[int, float], Union[int, float]]]:\n    \"\"\"\n    Calculates coordinate-wise sums for all unique pairs of tuples in the input list.\n    The pairs are processed in a deterministic order (increasing i then increasing j).\n    \"\"\"\n    n = len(input)\n    if n < 2:\n        return []\n\n    result: List[Tuple[Union[int, float], Union[int, float]]] = []\n\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            # Access tuple elements by index as per the plain tuple input/output expectation\n            a_sum = input[i][0] + input[j][0]\n            b_sum = input[i][1] + input[j][1]\n            result.append((a_sum, b_sum))\n\n    return result"}
{"task_id": "Mbpp/785", "solution": "import typing\n\ndef _validate_and_extract_inner(s: str) -> str:\n    \"\"\"Validate trimmed input begins with '(' and ends with ')' and return inner substring.\"\"\"\n    trimmed_s = s.strip()\n    if not (trimmed_s.startswith('(') and trimmed_s.endswith(')')):\n        raise ValueError(\"Input string must start with '(' and end with ')'\")\n    return trimmed_s[1:-1]\n\ndef _split_and_trim(inner: str) -> typing.List[str]:\n    \"\"\"Split the inner substring by commas and trim whitespace for each token.\"\"\"\n    if not inner.strip():\n        return []\n    \n    tokens = [token.strip() for token in inner.split(',')]\n    return tokens\n\ndef _convert_tokens(tokens: typing.List[str]) -> typing.List[int]:\n    \"\"\"Convert each trimmed token to int, raising ValueError on empty/non-integer tokens.\"\"\"\n    ints = []\n    for token in tokens:\n        if not token:\n            raise ValueError(\"Empty token found between commas\")\n        try:\n            ints.append(int(token))\n        except ValueError as e:\n            raise ValueError(f\"Could not convert token '{token}' to integer: {e}\") from e\n    return ints\n\ndef tuple_str_int(s: str) -> tuple:\n    \"\"\"Converts a string representation of a tuple of integers into an actual tuple of integers.\"\"\"\n    inner = _validate_and_extract_inner(s)\n    tokens = _split_and_trim(inner)\n    ints = _convert_tokens(tokens)\n    return tuple(ints)"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(sequence, value) -> int:\n    \"\"\"\n    Locates the right insertion point for a specified value in a sorted sequence.\n    Returns the index where the value can be inserted to maintain sorted order,\n    placing it after any existing equal elements.\n    \"\"\"\n    for i, item in enumerate(sequence):\n        if item > value:\n            return i\n    return len(sequence)"}
