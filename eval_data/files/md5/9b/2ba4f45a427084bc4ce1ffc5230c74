{"task_id": "Mbpp/468", "solution": "import collections\n\ndef _validate_input(array) -> None:\n    \"\"\"Validates that the input is a sequence of numeric values.\n\n    Raises TypeError if the input is not a sequence or contains non-numeric elements.\n    \"\"\"\n    if not isinstance(array, collections.abc.Sequence):\n        raise TypeError(\"Input must be a sequence (e.g., list, tuple).\")\n    for item in array:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"All elements in the array must be numbers.\")\n\ndef _max_product_dp(array) -> float:\n    \"\"\"Implements the dynamic programming algorithm to find the maximum product of an increasing subsequence.\n\n    Computes max product for subsequences ending at each index, then returns the global maximum.\n    \"\"\"\n    n = len(array)\n    if n == 0:\n        return 0.0\n\n    # max_prod[i] stores the maximum product of an increasing subsequence ending with array[i]\n    max_prod = list(array)  # Initialize with single-element products\n\n    # Overall maximum product found\n    overall_max_product = float('-inf') if any(x < 0 for x in array) else 0.0 # Handle case where all elements are negative.\n    if n > 0:\n        overall_max_product = float(array[0]) # Start with first element, or 0 if array could contain all non-positive elements\n                                              # The DP loop will handle updates correctly, but an initial\n                                              # non-negative base is good if all products could be negative.\n                                              # If any element is positive, max_prod[i] will be positive for that element\n                                              # or greater, so it will update overall_max_product.\n                                              # If all elements are negative, a single element can be the max product, or a product of two negatives.\n\n    for i in range(n):\n        # Initialize max_prod[i] with the product of the single-element subsequence ending at array[i]\n        max_prod[i] = float(array[i])\n        \n        for j in range(i):\n            if array[j] < array[i]:\n                candidate_product = max_prod[j] * array[i]\n                max_prod[i] = max(max_prod[i], candidate_product)\n        \n        # Update the overall maximum product\n        overall_max_product = max(overall_max_product, max_prod[i])\n        \n    return overall_max_product\n\ndef max_product(array) -> float:\n    \"\"\"Finds the maximum product formed by multiplying numbers of an increasing subsequence of the array.\n\n    Handles input validation, empty array, and calls the DP helper for computation.\n    \"\"\"\n    _validate_input(array)\n\n    if not array:  # Per BR8, empty array returns 0\n        return 0.0\n\n    return _max_product_dp(array)"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Computes the pairwise sum of neighboring elements in the given tuple.\n    Returns an empty tuple if the input tuple has fewer than two elements.\n    \"\"\"\n    if len(input_tuple) < 2:\n        return ()\n    \n    return tuple(input_tuple[i] + input_tuple[i+1] for i in range(len(input_tuple) - 1))"}
{"task_id": "Mbpp/463", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass InputArray:\n    elements: List[int]\n\n@dataclass\nclass Subarray:\n    startIndex: int\n    endIndex: int\n    product: int\n\n@dataclass\nclass Result:\n    value: int\n\ndef max_subarray_product(array: List[int]) -> int:\n    \"\"\"\n    Finds the maximum product of any contiguous subarray within the given array.\n    Handles positive, negative, and zero integers, and empty or single-element arrays.\n    \"\"\"\n    if not array:\n        raise ValueError(\"input array must contain at least one integer\")\n    \n    if len(array) == 1:\n        return array[0]\n\n    # Initialize current_max, current_min, and global_max with the first element.\n    current_max = array[0]\n    current_min = array[0]\n    global_max = array[0]\n\n    # Iterate through the rest of the array starting from the second element.\n    for x in array[1:]:\n        # If the current element is negative, swap current_max and current_min.\n        # This is because multiplying a negative number reverses their roles in determining max/min products.\n        if x < 0:\n            current_max, current_min = current_min, current_max\n\n        # Update current_max: it's either the current element itself, or the product\n        # of the current element with the previous maximum product ending here.\n        current_max = max(x, current_max * x)\n        \n        # Update current_min: it's either the current element itself, or the product\n        # of the current element with the previous minimum product ending here.\n        current_min = min(x, current_min * x)\n\n        # Update the overall maximum product found across all subarrays so far.\n        global_max = max(global_max, current_max)\n\n    return global_max"}
{"task_id": "Mbpp/462", "solution": "from typing import List\n\nclass Element:\n    \"\"\"\n    Wraps an element to ensure read-only access and prevent mutation of caller's input.\n    \"\"\"\n    def __init__(self, value: object) -> None:\n        self._value = value\n\n    @property\n    def value(self) -> object:\n        return self._value\n\nclass InputList:\n    \"\"\"\n    Represents the input list, copying elements into Element wrappers.\n    Ensures the original input list is not modified.\n    \"\"\"\n    def __init__(self, elements: List[object]) -> None:\n        self._elements: List[Element] = [Element(e) for e in elements]\n\n    def length(self) -> int:\n        return len(self._elements)\n\n    def get(self, index: int) -> 'Element':\n        return self._elements[index]\n\nclass Combination:\n    \"\"\"\n    Represents a single combination, storing its bitmask and selected elements.\n    Elements are stored in descending order of their original input indices.\n    \"\"\"\n    def __init__(self, bitmask: int, elements: List['Element']) -> None:\n        self._bitmask = bitmask\n        self._elements = elements\n\n    def toList(self) -> List[object]:\n        \"\"\"Returns a native list of the combination's elements values.\"\"\"\n        return [e.value for e in self._elements]\n\n    def bitmask(self) -> int:\n        return self._bitmask\n\nclass ResultList:\n    \"\"\"\n    A collection of Combination objects.\n    Provides methods to access combinations and convert to a native list-of-lists.\n    \"\"\"\n    def __init__(self, combinations: List['Combination']) -> None:\n        self._combinations = combinations\n\n    def size(self) -> int:\n        return len(self._combinations)\n\n    def get(self, index: int) -> 'Combination':\n        return self._combinations[index]\n\n    def to_list_of_lists(self) -> List[List[object]]:\n        \"\"\"Converts the ResultList into a native list of lists.\"\"\"\n        return [c.toList() for c in self._combinations]\n\nclass CombinationsService:\n    \"\"\"\n    Provides the core logic for generating combinations from an InputList.\n    \"\"\"\n    def generate(self, inputList: 'InputList') -> 'ResultList':\n        \"\"\"\n        Generates all combinations from the given InputList.\n        Combinations are ordered by ascending bitmask, and elements within each combination\n        are ordered by descending input index.\n        \"\"\"\n        n = inputList.length()\n        all_combinations: List[Combination] = []\n\n        for bitmask in range(0, 1 << n):\n            selected_elements_for_combo: List[Element] = []\n            # Iterate in descending order of input indices to satisfy FR5\n            for i in range(n - 1, -1, -1):\n                if (bitmask >> i) & 1:  # Check if the i-th bit is set\n                    selected_elements_for_combo.append(inputList.get(i))\n            \n            all_combinations.append(Combination(bitmask, selected_elements_for_combo))\n        \n        return ResultList(all_combinations)\n\n    def validateCount(self, result: 'ResultList', n: int) -> bool:\n        \"\"\"Validates that the result list contains the expected number of combinations.\"\"\"\n        return result.size() == (1 << n)\n\n    def preserveInput(self, inputList: 'InputList') -> bool:\n        \"\"\"Helper to verify input list remains unchanged (by design).\"\"\"\n        # This method is primarily for design verification; actual check not implemented here\n        return True\n\ndef combinations_list(input_list: List[object]) -> List[List[object]]:\n    \"\"\"\n    Finds all possible combinations of the elements of a given list.\n    The combinations are ordered by their bitmask representation (LSB -> input_list[0]).\n    Elements within each combination are ordered in descending order of their original indices.\n    \"\"\"\n    input_list_wrapper = InputList(input_list)\n    service = CombinationsService()\n    result_list = service.generate(input_list_wrapper)\n    return result_list.to_list_of_lists()"}
{"task_id": "Mbpp/471", "solution": "```python\ndef find_remainder(array, n):\n    \"\"\"\n    Public API: validate inputs and return remainder as int in 0..n-1; raise ValueError if n == 0; does not modify array.\n    \"\"\"\n    if n == 0:\n        raise ValueError(\"Modulus 'n' cannot be zero.\")\n\n    remainder = 1\n    for x in array:\n        remainder = (remainder * (x % n)) % n\n    return remainder\n```"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(input_list):\n    \"\"\"\n    Checks if the given list contains numbers that are consecutive.\n    Consecutive means each adjacent pair has an absolute difference of 1.\n    \"\"\"\n    if len(input_list) <= 1:\n        return True\n\n    for element in input_list:\n        if not isinstance(element, int):\n            return False\n\n    for i in range(len(input_list) - 1):\n        if abs(input_list[i+1] - input_list[i]) != 1:\n            return False\n\n    return True"}
{"task_id": "Mbpp/473", "solution": "from typing import Iterable, Tuple, Any, Set\n\ndef _is_valid_2tuple(t: Any) -> bool:\n    \"\"\"Checks if the input is a 2-element tuple-like object.\"\"\"\n    return isinstance(t, (tuple, list)) and len(t) == 2\n\ndef _normalize_tuple(t: Any) -> Tuple[Any, Any]:\n    \"\"\"Returns a canonical (sorted) 2-element tuple or raises ValueError.\"\"\"\n    if not _is_valid_2tuple(t):\n        raise ValueError(\"Input element must be a 2-element tuple or list.\")\n    return tuple(sorted(t))\n\ndef _build_normalized_set(iterable: Iterable[Any]) -> Set[Tuple[Any, Any]]:\n    \"\"\"Builds a set of normalized keys from an iterable.\"\"\"\n    normalized_set = set()\n    for item in iterable:\n        normalized_set.add(_normalize_tuple(item))\n    return normalized_set\n\ndef tuple_intersection(list_a: Iterable[Tuple[Any, Any]], list_b: Iterable[Tuple[Any, Any]]) -> Set[Tuple[Any, Any]]:\n    \"\"\"Return a set of tuples from list_a whose unordered-equivalent tuple appears in list_b.\n\n    Parameters:\n        list_a: sequence (iterable) of 2-element tuples\n        list_b: sequence (iterable) of 2-element tuples\n\n    Returns:\n        set of tuples (each tuple is taken from list_a preserving its element order)\n\n    Raises:\n        ValueError if any input element is not a 2-element tuple.\n    \"\"\"\n    result_set: Set[Tuple[Any, Any]] = set()\n    seen_normalized_keys: Set[Tuple[Any, Any]] = set()\n\n    if not list_a or not list_b:\n        return result_set\n\n    normalized_b_keys = _build_normalized_set(list_b)\n\n    for t_a in list_a:\n        normalized_key_a = _normalize_tuple(t_a)\n\n        if normalized_key_a in normalized_b_keys and normalized_key_a not in seen_normalized_keys:\n            result_set.add(t_a)\n            seen_normalized_keys.add(normalized_key_a)\n\n    return result_set"}
{"task_id": "Mbpp/474", "solution": "import dataclasses\n\n@dataclasses.dataclass\nclass InputString:\n    value: str\n\n@dataclasses.dataclass\nclass Character:\n    value: str\n\n@dataclasses.dataclass\nclass OutputString:\n    value: str\n\nclass ReplaceCharFunction:\n    \"\"\"Encapsulates the character replacement algorithm and validation.\"\"\"\n    def __init__(self, input_str: str, target_char: str, replacement_char: str) -> None:\n        self.input_string = InputString(input_str)\n        self.target_char = Character(target_char)\n        self.replacement_char = Character(replacement_char)\n\n    def execute(self) -> str:\n        \"\"\"Validates inputs and performs the character replacement.\"\"\"\n        if len(self.target_char.value) != 1 or len(self.replacement_char.value) != 1:\n            raise ValueError(\"Target and replacement must be single characters.\")\n\n        result_chars = []\n        for char in self.input_string.value:\n            if char == self.target_char.value:\n                result_chars.append(self.replacement_char.value)\n            else:\n                result_chars.append(char)\n        \n        return OutputString(\"\".join(result_chars)).value\n\ndef replace_char(input_string: str, target: str, replacement: str) -> str:\n    \"\"\"Public API: validates target and replacement are single-character strings and returns the replaced string.\"\"\"\n    impl = ReplaceCharFunction(input_string, target, replacement)\n    return impl.execute()"}
{"task_id": "Mbpp/476", "solution": "def _is_numeric(value):\n    \"\"\"Checks if a value is numeric (int or float).\"\"\"\n    return isinstance(value, (int, float))\n\ndef validate_input(array):\n    \"\"\"Validates the input array for non-empty and numeric elements.\"\"\"\n    if not array:\n        raise ValueError(\"Input array cannot be empty.\")\n    for element in array:\n        if not _is_numeric(element):\n            raise TypeError(\"All elements in the array must be numeric (int or float).\")\n\ndef compute_min(array):\n    \"\"\"Computes the minimum value in the array.\"\"\"\n    # Assumes array is already validated.\n    return min(array)\n\ndef compute_max(array):\n    \"\"\"Computes the maximum value in the array.\"\"\"\n    # Assumes array is already validated.\n    return max(array)\n\ndef big_sum(array):\n    \"\"\"\n    Finds the sum of the largest and smallest value in a given array.\n    \"\"\"\n    validate_input(array)\n    min_val = compute_min(array)\n    max_val = compute_max(array)\n    return min_val + max_val"}
