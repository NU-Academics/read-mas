okens, min_length=4)  # List[Word]\n\n    collection = WordCollection(filtered)\n    return collection.as_strings()  # List[str]"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(s: str, c: str) -> str:\n    \"\"\"\n    Removes the first and last occurrences of a given character from the string.\n    If the character appears once or not at all, handle accordingly.\n    \"\"\"\n    first_index = s.find(c)\n\n    if first_index == -1:\n        return s\n\n    last_index = s.rfind(c)\n\n    if first_index == last_index:\n        # Character appears only once\n        return s[:first_index] + s[first_index + 1:]\n    else:\n        # Character appears two or more times, remove first and last\n        return s[:first_index] + s[first_index + 1:last_index] + s[last_index + 1:]"}
