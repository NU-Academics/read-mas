{"task_id": "Mbpp/125", "solution": "class BinaryString:\n    \"\"\"Represents and validates the input binary string.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the binary string.\"\"\"\n        return len(self.value)\n\n    def validateBinary(self) -> None:\n        \"\"\"Raises ValueError if the string contains non-binary characters.\"\"\"\n        for char in self.value:\n            if char not in ('0', '1'):\n                raise ValueError(\"Input string must contain only '0' or '1'.\")\n\nclass Substring:\n    \"\"\"Conceptual representation of a contiguous substring.\"\"\"\n    def __init__(self, startIndex: int, endIndex: int, zeros: int, ones: int) -> None:\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n        self.zeros = zeros\n        self.ones = ones\n\n    def difference(self) -> int:\n        \"\"\"Calculates the difference (zeros - ones) for the substring.\"\"\"\n        return self.zeros - self.ones\n\nclass Result:\n    \"\"\"Represents the computed maximum difference.\"\"\"\n    def __init__(self, maxDifference: int) -> None:\n        self.maxDifference = maxDifference\n\nclass FindLengthFunction:\n    \"\"\"Encapsulates the algorithmic logic to compute maximum difference.\"\"\"\n    def find_length(self, binaryStr: str) -> int:\n        \"\"\"\n        Validates the input, maps it to integer values,\n        and computes the maximum difference using Kadane's algorithm.\n        \"\"\"\n        binary_string_obj = BinaryString(binaryStr)\n        binary_string_obj.validateBinary()\n\n        mapped_values = []\n        for char in binaryStr:\n            mapped_values.append(1 if char == '0' else -1)\n\n        return self.selectMaxDifference(mapped_values)\n\n    def generateSubstrings(self, bs: BinaryString) -> list:\n        \"\"\"Conceptual method for generating substrings, not used in the O(N) solution.\"\"\"\n        return []\n\n    def computeDifference(self, s: Substring) -> int:\n        \"\"\"Computes the difference for a given substring object.\"\"\"\n        return s.difference()\n\n    def selectMaxDifference(self, mapped_values: list[int]) -> int:\n        \"\"\"\n        Implements Kadane's algorithm to find the maximum contiguous subarray sum,\n        which corresponds to the maximum (zeros - ones) difference.\n        \"\"\"\n        current_max = 0\n        best_max = 0\n        for v in mapped_values:\n            current_max = max(v, current_max + v)\n            best_max = max(best_max, current_max)\n        return best_max\n\ndef find_length(binaryStr: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and number of 1s\n    in any sub-string of the given binary string.\n    \"\"\"\n    finder = FindLengthFunction()\n    return finder.find_length(binaryStr)"}
{"task_id": "Mbpp/126", "solution": "import math\n\nclass IntegerInput:\n    \"\"\"Encapsulates input values and performs validation.\"\"\"\n    def __init__(self, a: int, b: int) -> None:\n        self.a = a\n        self.b = b\n\n    def validate(self) -> None:\n        \"\"\"Raises TypeError if a or b is not a Python int.\"\"\"\n        if not isinstance(self.a, int) or not isinstance(self.b, int):\n            raise TypeError(\"Inputs must be integers.\")\n\nclass GCD:\n    \"\"\"Computes gcd(abs(a), abs(b)) and holds the computed value.\"\"\"\n    def __init__(self) -> None:\n        self.value: int = 0\n\n    def compute(self, a: int, b: int) -> int:\n        \"\"\"Computes gcd(abs(a), abs(b)), assigns to self.value, and returns it.\"\"\"\n        self.value = math.gcd(abs(a), abs(b))\n        return self.value\n\nclass DivisorSet:\n    \"\"\"Enumerates positive divisors of an integer.\"\"\"\n    def __init__(self) -> None:\n        self.divisors: list[int] = []\n\n    def find(self, n: int) -> list[int]:\n        \"\"\"Returns a list of positive divisors of n.\"\"\"\n        divs = set()\n        for i in range(1, int(math.sqrt(n)) + 1):\n            if n % i == 0:\n                divs.add(i)\n                divs.add(n // i)\n        \n        self.divisors = sorted(list(divs))\n        return self.divisors\n\nclass SumResult:\n    \"\"\"Aggregates a list of divisors into the final integer sum.\"\"\"\n    def __init__(self) -> None:\n        self.value: int = 0\n\n    def aggregate(self, divisors: list[int]) -> int:\n        \"\"\"Computes sum(divisors), stores in self.value, and returns it.\"\"\"\n        self.value = sum(divisors)\n        return self.value\n\ndef sum(a: int, b: int) -> int:\n    \"\"\"\n    Finds the sum of common positive divisors of two given numbers.\n    Processes inputs, computes GCD, finds its divisors, and sums them.\n    \"\"\"\n    input_obj = IntegerInput(a, b)\n    input_obj.validate()\n\n    gcd_obj = GCD()\n    g = gcd_obj.compute(a, b)\n\n    if g == 0:\n        raise ValueError(\"GCD of (0,0) is 0, which has an infinite set of divisors. Cannot compute sum.\")\n\n    divisors_obj = DivisorSet()\n    divisors = divisors_obj.find(g)\n\n    result_obj = SumResult()\n    total = result_obj.aggregate(divisors)\n\n    return total"}
{"task_id": "Mbpp/128", "solution": "```python\ndef long_words(n, words):\n    \"\"\"\n    Finds words longer than n characters from a string or list of words.\n    Validates input types and preserves original order and casing.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer.\")\n\n    tokens = []\n    if isinstance(words, str):\n        tokens = words.split()\n    elif isinstance(words, list):\n        for word in words:\n            if not isinstance(word, str):\n                raise TypeError(\"All elements in the 'words' list must be strings.\")\n        tokens = words\n    else:\n        raise TypeError(\"words must be a string or a list of strings.\")\n\n    return [word for word in tokens if len(word) > n]\n```"}
