{"task_id": "Mbpp/283", "solution": "def validate(n: int) -> bool:\n    \"\"\"\n    Checks if the frequency of each digit in an integer is less than or equal to the digit itself.\n    The absolute value of the integer is used for digit extraction.\n    \"\"\"\n    n_abs = abs(n)\n    \n    if n_abs == 0:\n        # Digit 0 appears once, 1 > 0, so it fails the rule.\n        return False\n\n    digit_counts = {}\n    temp_n = n_abs\n    while temp_n > 0:\n        digit = temp_n % 10\n        digit_counts[digit] = digit_counts.get(digit, 0) + 1\n        temp_n //= 10\n\n    for digit, count in digit_counts.items():\n        if count > digit:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/280", "solution": "def sequential_search(array, element):\n    \"\"\"Return (True, index) for first occurrence of element in array, else (False, -1).\n\n    Args:\n        array: list -- input list to scan.\n        element: any -- element to search for.\n\n    Returns:\n        tuple(bool, int): (found, index) where index is 0-based or -1 when not found.\n    \"\"\"\n    for i in range(len(array)):\n        if array[i] == element:\n            return (True, i)\n    return (False, -1)"}
{"task_id": "Mbpp/285", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass TextInput:\n    value: str\n    def length(self) -> int: return len(self.value)\n\n@dataclass\nclass MatchPattern:\n    pattern: str\n\n@dataclass\nclass MatchResult:\n    is_match: bool\n\ndef _contains_pattern(text: str, pattern: str) -> bool:\n    \"\"\"Checks if a pattern string is a contiguous substring of text.\"\"\"\n    return pattern in text\n\ndef text_match_two_three(text: str) -> bool:\n    \"\"\"\n    Checks whether a string contains the 'a' character followed by two or three 'b' characters.\n    Returns True if 'abb' or 'abbb' is found, otherwise False.\n    \"\"\"\n    input_obj = TextInput(text)\n    if input_obj.length() == 0:\n        return False\n\n    patterns = [MatchPattern(\"abbb\"), MatchPattern(\"abb\")]\n\n    for pattern_obj in patterns:\n        if _contains_pattern(input_obj.value, pattern_obj.pattern):\n            return True\n            \n    return False"}
{"task_id": "Mbpp/287", "solution": "def square_Sum(n):\n    \"\"\"\n    Compute sum of squares of the first n even natural numbers.\n\n    Args:\n        n (int): number of first even natural numbers to include (n >= 0).\n\n    Returns:\n        int: Sum_{k=1..n} (2k)^2.\n\n    Raises:\n        TypeError: if n is not an int.\n        ValueError: if n < 0.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be >= 0\")\n    # closed-form formula for sum_{k=1..n} (2k)^2\n    return 4 * n * (n + 1) * (2 * n + 1) // 6"}
{"task_id": "Mbpp/286", "solution": "from typing import List\n\nclass ValidationError(Exception):\n    \"\"\"Exception type used to signal validation errors.\"\"\"\n    pass\n\nclass InputArray:\n    \"\"\"Represents input parameters arr, n, k and provides basic validation.\"\"\"\n    def __init__(self, arr: List[int], n: int, k: int):\n        self.arr = arr\n        self.n = n\n        self.k = k\n\n    def validate(self) -> None:\n        \"\"\"Validate presence and basic type/shape of arr, n, k.\n        \n        Note: Per prompt instructions, actual validation checks (e.g., isinstance, value checks) \n        and raising exceptions are omitted here, despite being described in the design context.\n        \"\"\"\n        pass\n\nclass RepeatedArray:\n    \"\"\"Generates the repeated array (first n elements repeated k times).\"\"\"\n    \n    def generate(self, arr: List[int], n: int, k: int) -> List[int]:\n        \"\"\"Selects the first n elements of arr and returns a new list\n        that is the concatenation of that selection repeated k times.\"\"\"\n        selected_part = arr[:n]\n        return selected_part * k\n\nclass MaxSubarrayCalculator:\n    \"\"\"Core algorithms to compute maximum contiguous subarray sum and provide the orchestration for the API.\"\"\"\n\n    def computeMaxSubarray(self, data: List[int]) -> int:\n        \"\"\"Computes maximum contiguous subarray sum using Kadane's algorithm.\"\"\"\n        if not data:\n            return 0 # Should not happen based on design's implied valid inputs.\n\n        max_so_far = data[0]\n        current_max = data[0]\n\n        for i in range(1, len(data)):\n            current_max = max(data[i], current_max + data[i])\n            max_so_far = max(max_so_far, current_max)\n        \n        return max_so_far\n\n    def max_sub_array_sum_repeated(self, arr: List[int], n: int, k: int) -> int:\n        \"\"\"Orchestrates validation, generation, computation, and returns an integer result.\"\"\"\n        input_validator = InputArray(arr, n, k)\n        input_validator.validate() \n\n        repeated_generator = RepeatedArray()\n        repeated_data = repeated_generator.generate(arr, n, k)\n\n        return self.computeMaxSubarray(repeated_data)\n\ndef max_sub_array_sum_repeated(arr: List[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous array in the modified array \n    which is formed by repeating the given array k times.\n    \"\"\"\n    calculator = MaxSubarrayCalculator()\n    return calculator.max_sub_array_sum_repeated(arr, n, k)"}
{"task_id": "Mbpp/290", "solution": "from typing import List, Tuple\n\ndef _validate_input(list_of_lists: List[List]) -> None:\n    \"\"\"\n    Validates that the input is a list of lists, raising TypeError for invalid types.\n    \"\"\"\n    if not isinstance(list_of_lists, list):\n        raise TypeError(\"Input must be a list.\")\n    for sublist in list_of_lists:\n        if not isinstance(sublist, list):\n            raise TypeError(\"All elements in the input list must be lists.\")\n\ndef _compute_lengths(list_of_lists: List[List]) -> List[Tuple[int, int]]:\n    \"\"\"\n    Computes the length of each sublist, returning a list of (index, length) tuples.\n    \"\"\"\n    return [(i, len(sublist)) for i, sublist in enumerate(list_of_lists)]\n\ndef _select_sublist(list_of_lists: List[List], max_len: int) -> List:\n    \"\"\"\n    Returns the first sublist whose length equals max_len.\n    Returns an empty list if no such sublist exists (e.g., for empty input).\n    \"\"\"\n    for sublist in list_of_lists:\n        if len(sublist) == max_len:\n            return sublist\n    return []\n\ndef max_length(list_of_lists: List[List]) -> Tuple[int, List]:\n    \"\"\"\n    Finds the list of maximum length in a list of lists, returning its length and the list.\n    \"\"\"\n    _validate_input(list_of_lists)\n\n    indexed_lengths = _compute_lengths(list_of_lists)\n\n    if not indexed_lengths:\n        return (0, [])\n\n    max_len = 0\n    for _, length in indexed_lengths:\n        if length > max_len:\n            max_len = length\n    \n    selected_sublist = _select_sublist(list_of_lists, max_len)\n\n    return (max_len, selected_sublist)"}
{"task_id": "Mbpp/292", "solution": "from math import floor\n\ndef find(dividend: float, divisor: float) -> int:\n    \"\"\"\n    Calculates the quotient of two numbers and rounds down to the nearest integer.\n    \"\"\"\n    return floor(dividend / divisor)"}
{"task_id": "Mbpp/294", "solution": "def max_val(input_list):\n    \"\"\"Return maximum numeric value (int or float) from input_list.\n\n    Handles type validation and filters for int/float, raising exceptions for invalid input or no numeric elements.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError('input must be a list')\n    numeric_elements = [x for x in input_list if isinstance(x, (int, float))]\n    if not numeric_elements:\n        raise ValueError('no numeric elements')\n    return max(numeric_elements)"}
{"task_id": "Mbpp/296", "solution": "from models import Array\nfrom counter_impl import InversionCounter\n\ndef get_Inv_Count(array: list[int]) -> int:\n    \"\"\"SRS-mandated function: build Array(values=array), instantiate InversionCounter and return counter.get_Inv_Count(Array).\"\"\"\n    arr_obj = Array(values=array)\n    counter = InversionCounter()\n    return counter.get_Inv_Count(arr_obj)"}
{"task_id": "Mbpp/293", "solution": "from math import sqrt\n\nclass NumericInput:\n    \"\"\"Validates a raw value is numeric and converts to float.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def typeCheck(self) -> float:\n        \"\"\"Returns float value if valid, otherwise raises ValueError.\"\"\"\n        if isinstance(self.value, (int, float)):\n            return float(self.value)\n        raise ValueError(f\"Invalid numeric input: {self.value}\")\n\nclass CalculationResult:\n    \"\"\"Encapsulates a float result and provides asFloat().\"\"\"\n    def __init__(self, value: float):\n        self.value = value\n\n    def asFloat(self) -> float:\n        \"\"\"Returns the stored float value.\"\"\"\n        return float(self.value)\n\nclass RightTriangle:\n    \"\"\"Encapsulates hypotenuse computation logic (sqrt(a^2 + b^2)).\"\"\"\n    def __init__(self):\n        self.sideA = None\n        self.sideB = None\n        self.sideC = None\n\n    def calculateThirdSide(self, a: float, b: float) -> CalculationResult:\n        \"\"\"Computes sqrt(a^2 + b^2) and returns CalculationResult.\"\"\"\n        self.sideA = a\n        self.sideB = b\n        self.sideC = float(sqrt(a*a + b*b))\n        return CalculationResult(self.sideC)\n\ndef otherside_rightangle(a, b) -> float:\n    \"\"\"\n    Finds the third side (hypotenuse) of a right-angled triangle given its two legs.\n    Raises ValueError if inputs are not numeric or are missing.\n    \"\"\"\n    if a is None or b is None:\n        raise ValueError(\"Two numeric inputs are required\")\n\n    a_float = NumericInput(a).typeCheck()\n    b_float = NumericInput(b).typeCheck()\n\n    rt = RightTriangle()\n    cr = rt.calculateThirdSide(a_float, b_float)\n\n    return cr.asFloat()"}
{"task_id": "Mbpp/297", "solution": "class FlatList(list):\n    \"\"\"Result container representing flattened sequence, inheriting from list.\"\"\"\n    def append(self, elem) -> None:\n        \"\"\"Appends an element to the flattened list.\"\"\"\n        super().append(elem)\n\n    def to_list(self) -> list:\n        \"\"\"Returns the internal list representation.\"\"\"\n        return list(self)\n\nclass NestedList:\n    \"\"\"Lightweight wrapper for input lists in the domain model.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = elements\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the nested list is empty.\"\"\"\n        return not self.elements\n\nclass Element:\n    \"\"\"Wrapper for a single input element, indicating if it's a list.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def isList(self) -> bool:\n        \"\"\"Checks if the element's value is a list.\"\"\"\n        return isinstance(self.value, list)\n\nclass ErrorCondition:\n    \"\"\"Container for error type/message to model detectability.\"\"\"\n    def __init__(self, type: str, message: str):\n        self.type = type\n        self.message = message\n\nclass FlattenFunction:\n    \"\"\"Encapsulates the iterative stack-based traversal algorithm.\"\"\"\n    def flatten_list(self, inputList) -> FlatList:\n        \"\"\"Traverses inputList depth-first left-to-right and returns a FlatList.\"\"\"\n        result = FlatList()\n        # Initialize the stack with top-level elements in reverse for left-to-right processing.\n        stack = list(reversed(inputList))\n\n        while stack:\n            current_item = stack.pop()\n            if isinstance(current_item, list):\n                # If current_item is a list, push its elements in reverse order.\n                stack.extend(reversed(current_item))\n            else:\n                # If current_item is not a list, append it to the result.\n                result.append(current_item)\n        return result\n\ndef flatten_list(inputList) -> FlatList:\n    \"\"\"Public API that delegates to FlattenFunction.flatten_list and returns FlatList.\"\"\"\n    # The design specifies validation by FlattenFunction, but the prompt's constraints\n    # about not adding isinstance() checks or raising exceptions for edge cases implies\n    # the root input is assumed to be a list.\n    return FlattenFunction().flatten_list(inputList)"}
{"task_id": "Mbpp/300", "solution": "import math\n\nclass InputParameter:\n    \"\"\"Value object for input n.\"\"\"\n    def __init__(self, n: int):\n        self._n = n\n\n    @property\n    def n(self):\n        return self._n\n\nclass BinarySequence:\n    \"\"\"Represents a binary sequence for analysis purposes.\"\"\"\n    def __init__(self, id: int, bits: str):\n        self._id = id\n        self._bits = bits\n        self._length = len(bits)\n\n    @property\n    def id(self):\n        return self._id\n\n    @property\n    def bits(self):\n        return self._bits\n\n    @property\n    def length(self):\n        return self._length\n\n    def sumFirstHalf(self) -> int:\n        n = self._length // 2\n        return sum(int(bit) for bit in self._bits[:n])\n\n    def sumSecondHalf(self) -> int:\n        n = self._length // 2\n        return sum(int(bit) for bit in self._bits[n:])\n\nclass SequenceCounter:\n    \"\"\"Stateless computation of the count of binary sequences.\"\"\"\n    def count(self, n: int) -> int:\n        \"\"\"Returns the count using the combinatorial identity math.comb(2*n, n).\"\"\"\n        return math.comb(2 * n, n)\n\nclass Result:\n    \"\"\"Simple data holder for the computed count.\"\"\"\n    def __init__(self, count: int):\n        self._count = count\n\n    @property\n    def count(self):\n        return self._count\n\ndef count_binary_seq(n):\n    \"\"\"\n    Counts binary sequences of length 2n where sum of first n bits equals sum of last n bits.\n    Raises ValueError for invalid input (non-integer or negative n).\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    # InputParameter is constructed per design, though its value is directly passed.\n    # ip = InputParameter(n) \n\n    counter = SequenceCounter()\n    # The design implies returning an int directly from the API, not a Result object.\n    result_count = counter.count(n) \n    \n    return result_count"}
{"task_id": "Mbpp/299", "solution": "from typing import List, Tuple, Union, Dict\nfrom dataclasses import dataclass\n\ndef _validate_entries(entries: List[Tuple[str, Union[int, float]]]) -> None:\n    \"\"\"\n    Validates the input list of entries according to business rules.\n    Raises TypeError or ValueError for invalid input.\n    \"\"\"\n    if not isinstance(entries, list):\n        raise TypeError(\"Input 'entries' must be a list.\")\n    \n    for i, entry in enumerate(entries):\n        if not isinstance(entry, (tuple, list)) or len(entry) != 2:\n            raise ValueError(f\"Entry at index {i} must be a 2-element sequence (tuple or list).\")\n        \n        name, value = entry\n        \n        if not isinstance(name, str):\n            raise TypeError(f\"Name in entry at index {i} must be a string, got {type(name).__name__}.\")\n        \n        if not isinstance(value, (int, float)):\n            raise TypeError(f\"Value in entry at index {i} must be an int or float, got {type(value).__name__}.\")\n\n@dataclass\nclass AggregateResult:\n    \"\"\"Internal data holder for an aggregate result.\"\"\"\n    name: str\n    total: float\n\nclass AggregationMap:\n    \"\"\"\n    Accumulates numeric totals for names.\n    \"\"\"\n    def __init__(self) -> None:\n        self.totals: Dict[str, float] = {}\n\n    def add(self, name: str, value: float) -> None:\n        \"\"\"Adds a value to the total for a given name.\"\"\"\n        self.totals[name] = self.totals.get(name, 0.0) + value\n\n    def get_max(self) -> AggregateResult:\n        \"\"\"\n        Returns the name and total for the highest aggregate.\n        Returns a default result if no entries were added.\n        \"\"\"\n        if not self.totals:\n            return AggregateResult(name='', total=0.0)\n        \n        max_name, max_total = max(self.totals.items(), key=lambda item: item[1])\n        return AggregateResult(name=max_name, total=max_total)\n\ndef max_aggregate(entries: List[Tuple[str, Union[int, float]]]) -> Tuple[str, Union[int, float]]:\n    \"\"\"\n    Calculates the maximum aggregate from a list of (name, value) tuples.\n    Aggregates numeric values by exact name equality and returns the name\n    with the highest aggregate total.\n    \"\"\"\n    _validate_entries(entries)\n\n    agg_map = AggregationMap()\n    for name, value in entries:\n        agg_map.add(name, float(value))\n\n    result = agg_map.get_max()\n    return (result.name, result.total)"}
{"task_id": "Mbpp/301", "solution": "class DictInput:\n    def __init__(self, data):\n        self.data = data\n\n    def is_dict(self) -> bool:\n        return isinstance(self.data, dict)\n\nclass DepthCalculator:\n    def compute(self, node: dict, currentDepth: int) -> int:\n        max_depth = currentDepth\n        for value in node.values():\n            if isinstance(value, dict):\n                # Recursively compute depth for nested dictionaries, updating max_depth.\n                nested_depth = self.compute(value, currentDepth + 1)\n                max_depth = max(max_depth, nested_depth)\n        return max_depth\n\nclass DepthResult:\n    def __init__(self, value: int):\n        self.value = value\n\ndef dict_depth(input_dict: dict) -> int:\n    \"\"\"\n    Computes the maximum nesting depth of a dictionary.\n    Raises TypeError if the input is not a dictionary.\n    \"\"\"\n    dict_input_wrapper = DictInput(input_dict)\n    if not dict_input_wrapper.is_dict():\n        raise TypeError(\"Input must be a dictionary.\")\n\n    calculator = DepthCalculator()\n    computed_depth = calculator.compute(node=input_dict, currentDepth=1)\n\n    result = DepthResult(computed_depth)\n    return result.value"}
{"task_id": "Mbpp/305", "solution": "from typing import List, Tuple\n\ndef start_withp(inputList: List[str]) -> Tuple[str, str]:\n    \"\"\"\n    Finds the first two words starting with 'p' (case-insensitive) from a list of strings.\n    Words are tokenized by whitespace.\n    \"\"\"\n    found_words: List[str] = []\n    \n    for element_string in inputList:\n        # Split the element string into words by whitespace.\n        words = element_string.split()\n        \n        for word in words:\n            # Check if the word is not empty and its first character (case-insensitive) is 'p'.\n            if len(word) > 0 and word[0].lower() == 'p':\n                found_words.append(word)\n                \n                # If two words are found, return them immediately as a tuple.\n                if len(found_words) == 2:\n                    return (found_words[0], found_words[1])"}
