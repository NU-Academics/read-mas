{"task_id": "Mbpp/413", "solution": "from typing import Any, List, Tuple\n\ndef extract_nth_element(tuple_list: List[Tuple[Any, ...]], n: int) -> List[Any]:\n    \"\"\"\n    Extracts the nth element from each tuple in a given list of tuples.\n    Performs type validation and raises IndexError if any tuple is too short.\n    \"\"\"\n    if not isinstance(tuple_list, list):\n        raise TypeError(\"Input 'tuple_list' must be a list.\")\n\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n\n    if not tuple_list:\n        return []\n\n    result = []\n    for i, item in enumerate(tuple_list):\n        if not isinstance(item, tuple):\n            raise TypeError(f\"Item at index {i} in 'tuple_list' is not a tuple.\")\n        \n        try:\n            result.append(item[n])\n        except IndexError:\n            raise IndexError(f\"Tuple at index {i} does not have an element at index {n}.\")\n            \n    return result"}
{"task_id": "Mbpp/414", "solution": "def _equals(a, b):\n    \"\"\"Comparator helper (internal). Returns result of a == b.\"\"\"\n    return a == b\n\ndef overlapping(seq1, seq2):\n    \"\"\"Return True if any element in seq1 == any element in seq2, else False.\n    Does not modify seq1 or seq2.\n    \"\"\"\n    for a in seq1:\n        for b in seq2:\n            if _equals(a, b):\n                return True\n    return False"}
{"task_id": "Mbpp/415", "solution": "def max_Product(values: list[int]) -> tuple[int, int]:\n    \"\"\"\n    Finds a pair with the highest product from a given array of integers.\n    Raises ValueError if the input list contains fewer than two integers.\n    \"\"\"\n    if len(values) < 2:\n        raise ValueError(\"Input list must contain at least two integers\")\n\n    max_prod = values[0] * values[1]\n    result_pair = (values[0], values[1])\n\n    n = len(values)\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            current_prod = values[i] * values[j]\n            if current_prod > max_prod:\n                max_prod = current_prod\n                result_pair = (values[i], values[j])\n    \n    return result_pair"}
