{"task_id": "Mbpp/475", "solution": "def sort_counter(input_dict):\n    \"\"\"\n    Validate input and return a list of (key, value) tuples sorted by value descending.\n    \"\"\"\n    if not isinstance(input_dict, dict):\n        raise TypeError(\"Input must be a dictionary.\")\n    \n    if not input_dict:\n        return []\n\n    for key, value in input_dict.items():\n        if not isinstance(key, str):\n            raise TypeError(\"All dictionary keys must be strings.\")\n        if not isinstance(value, int):\n            raise TypeError(\"All dictionary values must be integers.\")\n            \n    sorted_items = sorted(input_dict.items(), key=lambda kv: kv[1], reverse=True)\n    return sorted_items"}
{"task_id": "Mbpp/479", "solution": "def first_Digit(n):\n    \"\"\"Return the most significant decimal digit of n as int (0-9).\n    This handles both positive and negative integers by taking the absolute value.\n    \"\"\"\n    num = abs(n)\n    if num == 0:\n        return 0\n    while num >= 10:\n        num //= 10\n    return num"}
{"task_id": "Mbpp/554", "solution": "from typing import List\n\ndef Split(input_list: List[int]) -> List[int]:\n    \"\"\"Return a new list containing only the odd integers from input_list in original order.\n\n    Precondition: input_list is a list of integers (List[int]).\n    \"\"\"\n    result: List[int] = []\n    for n in input_list:\n        if n % 2 != 0:\n            result.append(n)\n    return result"}
{"task_id": "Mbpp/478", "solution": "def _is_ascii_lowercase(char: str) -> bool:\n    \"\"\"Checks if a character is an ASCII lowercase letter.\"\"\"\n    return 'a' <= char <= 'z'\n\ndef _tokenize(input_string: str) -> list[tuple[str, bool]]:\n    \"\"\"\n    Splits the input string into segments of contiguous characters,\n    each marked whether it's an ASCII lowercase run.\n    \"\"\"\n    tokens = []\n    if not input_string:\n        return tokens\n\n    current_segment_start = 0\n    is_prev_lowercase = _is_ascii_lowercase(input_string[0])\n\n    for i in range(1, len(input_string)):\n        is_current_lowercase = _is_ascii_lowercase(input_string[i])\n        if is_current_lowercase != is_prev_lowercase:\n            segment = input_string[current_segment_start:i]\n            tokens.append((segment, is_prev_lowercase))\n            current_segment_start = i\n            is_prev_lowercase = is_current_lowercase\n    \n    segment = input_string[current_segment_start:]\n    tokens.append((segment, is_prev_lowercase))\n\n    return tokens\n\ndef remove_lowercase(input_string: str) -> str:\n    \"\"\"\n    Removes all contiguous ASCII lowercase substrings from the input string,\n    preserving all other characters in their original order.\n    \"\"\"\n    if not input_string:\n        return \"\"\n\n    tokens = _tokenize(input_string)\n    result_chars = []\n    for segment, is_lowercase in tokens:\n        if not is_lowercase:\n            result_chars.append(segment)\n            \n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/555", "solution": "from dataclasses import dataclass\n\nclass Validator:\n    \"\"\"Validates input 'n' to ensure it's a non-negative integer.\"\"\"\n    def validate_n(self, n: object) -> None:\n        if not isinstance(n, int) or n < 0:\n            raise ValueError(\"n must be a non-negative integer\")\n\nclass NaturalNumberSequence:\n    \"\"\"Represents a sequence of natural numbers from 1 up to 'end'.\"\"\"\n    def __init__(self, end: int) -> None:\n        self.end = end\n\n    def elements(self) -> list[int]:\n        if self.end == 0:\n            return []\n        return list(range(1, self.end + 1))\n\nclass SumOperation:\n    \"\"\"Performs summation operations on a sequence of natural numbers.\"\"\"\n    def sum_numbers(self, seq: NaturalNumberSequence) -> int:\n        return sum(seq.elements())\n\n    def sum_cubes(self, seq: NaturalNumberSequence) -> int:\n        return sum(i**3 for i in seq.elements())\n\n@dataclass\nclass Result:\n    \"\"\"An immutable container for computed sum of numbers, sum of cubes, and their difference.\"\"\"\n    sum_numbers: int\n    sum_cubes: int\n    difference: int\n\ndef difference(n: int) -> int:\n    \"\"\"\n    Finds the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    validator = Validator()\n    validator.validate_n(n)\n\n    sequence = NaturalNumberSequence(end=n)\n    sum_op = SumOperation()\n\n    sum_numbers_val = sum_op.sum_numbers(sequence)\n    sum_cubes_val = sum_op.sum_cubes(sequence)\n\n    result_obj = Result(\n        sum_numbers=sum_numbers_val,\n        sum_cubes=sum_cubes_val,\n        difference=sum_cubes_val - sum_numbers_val\n    )\n    return result_obj.difference"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input: str) -> str:\n    \"\"\"Return a new string with alphabetic characters toggled in case.\n\n    Args:\n        input: a string to transform\n\n    Returns:\n        A new string where each lowercase letter is uppercased and each uppercase letter is lowercased. Non-alphabetic characters unchanged.\n    \"\"\"\n    toggled_chars = []\n    for char in input:\n        if char.isupper():\n            toggled_chars.append(char.lower())\n        elif char.islower():\n            toggled_chars.append(char.upper())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr, n):\n    \"\"\"\n    Counts pairs of numbers in the array whose XOR sum is odd.\n    Considers only the first 'n' elements of the array.\n    \"\"\"\n\n    def isEven(value):\n        \"\"\"Checks if a given integer is even.\"\"\"\n        return value % 2 == 0\n\n    def isOdd(value):\n        \"\"\"Checks if a given integer is odd.\"\"\"\n        return value % 2 != 0\n\n    def _validate_and_clip_n(arr, n):\n        \"\"\"Ensures n is within valid bounds for array access.\"\"\"\n        if n < 0:\n            return 0\n        return min(n, len(arr))\n\n    def countOddXorPairs(arr, n_clipped):\n        \"\"\"\n        Counts unordered pairs (i, j) with 0 <= i < j < n_clipped such that arr[i] XOR arr[j] is odd.\n        An XOR result is odd if and only if the two operands have differing parity.\n        \"\"\"\n        count = 0\n        for i in range(n_clipped):\n            for j in range(i + 1, n_clipped):\n                val1 = arr[i]\n                val2 = arr[j]\n                # XOR is odd if one number is even and the other is odd\n                if (isEven(val1) and isOdd(val2)) or (isOdd(val1) and isEven(val2)):\n                    count += 1\n        return count\n\n    safe_n = _validate_and_clip_n(arr, n)\n    return countOddXorPairs(arr, safe_n)"}
{"task_id": "Mbpp/563", "solution": "import re\nfrom typing import List\n\ndef extract_values(input_string: str) -> List[str]:\n    \"\"\"\n    Extracts values between double quotation marks from a string.\n    Returns an ordered list of the extracted values without the quotes.\n    \"\"\"\n    pattern = r'\"([^\"]*)\"'\n    return re.findall(pattern, input_string)"}
{"task_id": "Mbpp/558", "solution": "from typing import List, Tuple\n\ndef _validate_inputs(a, b) -> None:\n    \"\"\"Validates that both inputs are integers.\"\"\"\n    if not isinstance(a, int):\n        raise TypeError(f\"Input 'a' must be an integer, but got {type(a)}\")\n    if not isinstance(b, int):\n        raise TypeError(f\"Input 'b' must be an integer, but got {type(b)}\")\n\ndef _to_digits(n: int) -> List[int]:\n    \"\"\"Converts a non-negative integer to a list of its digits, LSB first.\"\"\"\n    if n == 0:\n        return [0]\n    digits = []\n    while n > 0:\n        digits.append(n % 10)\n        n //= 10\n    return digits\n\ndef _right_align(a_digits: List[int], b_digits: List[int]) -> Tuple[List[int], List[int]]:\n    \"\"\"Pads the shorter digit list with zeros on the high-order side to match length.\"\"\"\n    max_len = max(len(a_digits), len(b_digits))\n    a_padded = a_digits + [0] * (max_len - len(a_digits))\n    b_padded = b_digits + [0] * (max_len - len(b_digits))\n    return a_padded, b_padded\n\ndef _compute_differences(a_digits_padded: List[int], b_digits_padded: List[int]) -> List[int]:\n    \"\"\"Computes the absolute element-wise differences between two equal-length digit lists.\"\"\"\n    return [abs(d1 - d2) for d1, d2 in zip(a_digits_padded, b_digits_padded)]\n\ndef _sum(differences: List[int]) -> int:\n    \"\"\"Sums a list of integer differences.\"\"\"\n    return sum(differences)\n\ndef digit_distance_nums(a, b) -> int:\n    \"\"\"\n    Finds the sum of the per-digit absolute differences between two integers.\n    For example, digit_distance_nums(1, 2) == 1.\n    \"\"\"\n    _validate_inputs(a, b)\n\n    abs_a = abs(a)\n    abs_b = abs(b)\n\n    a_digits = _to_digits(abs_a)\n    b_digits = _to_digits(abs_b)\n\n    a_padded, b_padded = _right_align(a_digits, b_digits)\n\n    differences = _compute_differences(a_padded, b_padded)\n\n    return _sum(differences)"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(input_list):\n    \"\"\"\n    Finds the length of the longest immediate sublist within a list of lists.\n    Returns 0 if the input list is empty.\n    \"\"\"\n    max_length = 0\n    for sublist in input_list:\n        max_length = max(max_length, len(sublist))\n    return max_length"}
{"task_id": "Mbpp/559", "solution": "import math\n\ndef max_sub_array_sum(elements: list[int], n: int) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist within the first 'n' elements.\n    Uses a Kadane-style algorithm to handle positive, negative, and mixed integers.\n    \"\"\"\n    effective_n = min(n, len(elements))\n\n    # If no elements are to be considered (e.g., list is empty or n is 0),\n    # the sum of an empty sublist is 0.\n    if effective_n == 0:\n        return 0\n\n    # Initialize current_max and global_max with the first element\n    # of the considered sublist. This correctly handles cases with all negative numbers.\n    current_max = elements[0]\n    global_max = elements[0]\n\n    # Iterate from the second element of the considered sublist\n    for i in range(1, effective_n):\n        val = elements[i]\n        # Decide whether to start a new subarray with 'val' or extend the current one.\n        current_max = max(val, current_max + val)\n        \n        # Update global_max if the current_max is greater.\n        global_max = max(global_max, current_max)\n\n    return global_max"}
{"task_id": "Mbpp/560", "solution": "from dataclasses import dataclass\nfrom typing import Any, Tuple, Iterable, List, Set\n\nclass TypeErrorException(TypeError):\n    \"\"\"\n    Domain-mapped exception; subclasses TypeError; use to raise errors required by SRS\n    while allowing domain-specific messages.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\n@dataclass\nclass TupleInput:\n    \"\"\"Wrap input tuple for domain clarity.\"\"\"\n    elements: tuple\n    id: str = ''\n\n@dataclass\nclass Element:\n    \"\"\"Domain abstraction for individual values.\"\"\"\n    value: Any\n\n@dataclass\nclass UnionResult:\n    \"\"\"Hold resulting tuple produced by union operation.\"\"\"\n    elements: tuple\n    id: str = ''\n\nclass Validator:\n    \"\"\"Validate input types and element comparability.\"\"\"\n    def validate_tuple_type(self, input_data: Any) -> None:\n        \"\"\"Raises TypeErrorException if input is not a tuple.\"\"\"\n        if not isinstance(input_data, tuple):\n            raise TypeErrorException(f\"Input must be a tuple, but received type {type(input_data).__name__}.\")\n\n    def validate_elements_comparable(self, elements: Iterable[Any]) -> None:\n        \"\"\"\n        Verifies mutual comparability of elements for ordering.\n        Raises TypeErrorException if not comparable.\n        \"\"\"\n        try:\n            # Attempt to sort to check for comparability. sorted() will raise TypeError if elements are not comparable.\n            _ = sorted(list(elements))\n        except TypeError as e:\n            raise TypeErrorException(f\"Elements in the union are not mutually comparable for ordering: {e}\")\n\nclass UnionOperator:\n    \"\"\"Compute set-union (unique elements) of two tuple inputs.\"\"\"\n    def compute_union(self, t1: Tuple[Any, ...], t2: Tuple[Any, ...]) -> Set[Any]:\n        \"\"\"Returns Python set with unique elements from both inputs.\"\"\"\n        return set(t1).union(set(t2))\n\nclass Sorter:\n    \"\"\"Sort an iterable of mutually comparable elements into ascending order.\"\"\"\n    def sort(self, iterable: Iterable[Any]) -> List[Any]:\n        \"\"\"Returns list sorted ascending.\"\"\"\n        return sorted(list(iterable))\n\ndef union_elements(tuple_a: Tuple[Any, ...], tuple_b: Tuple[Any, ...]) -> Tuple[Any, ...]:\n    \"\"\"\n    Finds the union of the elements of two given tuples and outputs them in sorted order.\n    Raises TypeError if inputs are not tuples or elements are not mutually comparable.\n    \"\"\"\n    validator = Validator()\n    union_operator = UnionOperator()\n    sorter = Sorter()\n\n    validator.validate_tuple_type(tuple_a)\n    validator.validate_tuple_type(tuple_b)\n\n    unique_elements_set = union_operator.compute_union(tuple_a, tuple_b)\n\n    # Validate comparability before attempting to sort\n    validator.validate_elements_comparable(unique_elements_set)\n\n    sorted_list = sorter.sort(unique_elements_set)\n\n    result_union = UnionResult(elements=tuple(sorted_list))\n    return result_union.elements"}
