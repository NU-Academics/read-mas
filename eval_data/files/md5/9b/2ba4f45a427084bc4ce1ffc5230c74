{"task_id": "Mbpp/788", "solution": "from typing import Any, List, Tuple\n\ndef new_tuple(list_input: List[Any], string_input: str) -> Tuple[Any, ...]:\n    \"\"\"\n    Creates a new tuple by appending a string to elements from a list or tuple.\n    Raises TypeError if inputs are not of the expected types.\n    \"\"\"\n    if not isinstance(list_input, (list, tuple)):\n        raise TypeError('list_input must be a list or tuple')\n    if not isinstance(string_input, str):\n        raise TypeError('string_input must be a str')\n\n    return tuple(list_input) + (string_input,)"}
{"task_id": "Mbpp/790", "solution": "def _is_int_list(values: list) -> bool:\n    \"\"\"Checks if the input is a list and all its elements are integers.\"\"\"\n    return isinstance(values, list) and all(isinstance(x, int) for x in values)\n\ndef _is_even(value: int) -> bool:\n    \"\"\"Checks if an integer value is even.\"\"\"\n    return value % 2 == 0\n\ndef even_position(values: list) -> bool:\n    \"\"\"\n    Checks whether every even index in the list contains an even number.\n    Raises TypeError if the input is not a list of integers.\n    \"\"\"\n    if not _is_int_list(values):\n        raise TypeError(\"Input must be a list of integers.\")\n\n    for i in range(0, len(values), 2):\n        if not _is_even(values[i]):\n            return False\n    return True"}
{"task_id": "Mbpp/792", "solution": "def count_list(outer):\n    \"\"\"Counts the number of immediate sublists within the given outer list. Raises TypeError if the input is not a list.\"\"\"\n    if not isinstance(outer, list):\n        raise TypeError(\"count_list: expected a list for parameter 'outer'\")\n    count = 0\n    for element in outer:\n        if isinstance(element, list):\n            count += 1\n    return count"}
{"task_id": "Mbpp/791", "solution": "from typing import Any\n\n\ndef remove_nested(input_tuple: tuple) -> tuple:\n    \"\"\"Return a new tuple containing only elements from input_tuple whose type is not tuple.\n\n    Precondition: input_tuple is a tuple (per SRS). Caller responsibility.\n    \"\"\"\n    result_list = []\n    for e in input_tuple:\n        if type(e) is not tuple:\n            result_list.append(e)\n    return tuple(result_list)"}
{"task_id": "Mbpp/793", "solution": "def last(list, target):\n    \"\"\"Finds the 0-based index of the last occurrence of the target in a sorted list.\n    The list is assumed to be sorted in non-decreasing order.\"\"\"\n    last_index = -1\n    low = 0\n    high = len(list) - 1\n\n    while low <= high:\n        mid = (low + high) // 2\n        if list[mid] == target:\n            last_index = mid\n            low = mid + 1  # Try to find a later occurrence in the right half\n        elif list[mid] < target:\n            low = mid + 1\n        else:  # list[mid] > target\n            high = mid - 1\n    return last_index"}
{"task_id": "Mbpp/796", "solution": "from typing import Mapping\nimport numbers\n\nInputDictionary = Mapping[str, numbers.Real]\n\nclass SumResult:\n    \"\"\"A data container for the summation total.\"\"\"\n    def __init__(self, total: numbers.Real):\n        self.total: numbers.Real = total\n\nclass ReturnSumFunction:\n    \"\"\"Stateless helper encapsulating the summation algorithm.\"\"\"\n    @staticmethod\n    def execute(dictionary: InputDictionary) -> numbers.Real:\n        \"\"\"Compute the arithmetic sum of numeric values in the dictionary.\"\"\"\n        current_sum = 0\n        for value in dictionary.values():\n            current_sum += value\n        return current_sum\n\ndef return_sum(dictionary: InputDictionary) -> numbers.Real:\n    \"\"\"Public API. Accepts a mapping and returns the arithmetic sum of its values.\"\"\"\n    return ReturnSumFunction.execute(dictionary)"}
{"task_id": "Mbpp/794", "solution": "def text_starta_endb(input: str) -> bool:\n    \"\"\"Return True if input starts with 'a' and ends with 'b'.\"\"\"\n    if len(input) < 2:\n        return False\n    return input[0] == 'a' and input[-1] == 'b'"}
{"task_id": "Mbpp/797", "solution": "import collections\n\nclass Number:\n    \"\"\"Represents an integer and provides predicates for its properties.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isOdd(self) -> bool:\n        \"\"\"Checks if the number is odd.\"\"\"\n        return self.value % 2 != 0\n\n    def isNatural(self) -> bool:\n        \"\"\"Checks if the number is a natural number (>= 1).\"\"\"\n        return self.value >= 1\n\nclass Range:\n    \"\"\"Represents an inclusive integer range and provides iteration/containment.\"\"\"\n    def __init__(self, start: int, end: int):\n        self.start = start\n        self.end = end\n\n    def contains(self, value: int) -> bool:\n        \"\"\"Checks if the given value is within the inclusive range.\"\"\"\n        return self.start <= value <= self.end\n\n    def iter_values(self):\n        \"\"\"Yields each integer value from start to end, inclusive.\"\"\"\n        for i in range(self.start, self.end + 1):\n            yield i\n\nclass Result:\n    \"\"\"Holds the aggregated sum.\"\"\"\n    def __init__(self):\n        self.sum = 0\n\nclass SumInRange:\n    \"\"\"Orchestrates the computation of the sum of odd natural numbers within a range.\"\"\"\n    def __init__(self, l: int, r: int):\n        self.l = l\n        self.r = r\n\n    def compute(self) -> int:\n        \"\"\"Computes the sum of odd natural numbers within the specified range.\"\"\"\n        result = Result()\n        current_range = Range(self.l, self.r)\n\n        for value in current_range.iter_values():\n            number = Number(value)\n            if number.isNatural() and number.isOdd():\n                result.sum += value\n        return result.sum\n\ndef sum_in_range(l, r) -> int:\n    \"\"\"\n    Finds the sum of all odd natural numbers within the inclusive range [l, r].\n    Natural numbers are integers >= 1.\n    \"\"\"\n    calculator = SumInRange(l, r)\n    return calculator.compute()"}
{"task_id": "Mbpp/798", "solution": "def validate_input(items) -> None:\n    \"\"\"Validates that items is a list and contains only numeric elements.\"\"\"\n    if not isinstance(items, list):\n        raise TypeError(\"items must be a list\")\n    for elem in items:\n        if not isinstance(elem, (int, float)):\n            raise TypeError(\"all elements must be int or float\")\n\ndef _sum(items):\n    \"\"\"Calculates the sum of numeric elements in a list, raising TypeError for invalid input.\"\"\"\n    validate_input(items)\n    total = 0\n    for item in items:\n        total += item\n    return total"}
{"task_id": "Mbpp/800", "solution": "def remove_all_spaces(input: str) -> str:\n    \"\"\"Removes all defined whitespace characters from a string, preserving order.\"\"\"\n    WHITESPACE_CHARS = {\" \", \"\\t\", \"\\n\", \"\\r\", \"\\f\", \"\\v\"}\n    return \"\".join(char for char in input if char not in WHITESPACE_CHARS)"}
{"task_id": "Mbpp/803", "solution": "import math\n\ndef is_perfect_square(n):\n    \"\"\"Return True iff there exists integer m such that m*m == n; False for negative n. Returns bool.\"\"\"\n    if n < 0:\n        return False\n    \n    # Calculate the integer square root\n    root = math.isqrt(n)\n    \n    # Check if the square of the integer root equals the original number\n    return root * root == n"}
{"task_id": "Mbpp/801", "solution": "class ThreeIntegersInput:\n    \"\"\"Data holder for three integer inputs.\"\"\"\n    def __init__(self, a: int, b: int, c: int) -> None:\n        self.a = a\n        self.b = b\n        self.c = c\n\nclass Result:\n    \"\"\"Data holder for the count of equal numbers.\"\"\"\n    def __init__(self, equal_count: int) -> None:\n        self.equal_count = equal_count\n\nclass EqualityCounter:\n    \"\"\"Encapsulates logic to count equal numbers among three integers.\"\"\"\n    def countEqual(self, input: ThreeIntegersInput) -> Result:\n        a, b, c = input.a, input.b, input.c\n\n        if a == b and b == c:\n            return Result(3)\n        elif a == b or a == c or b == c:\n            return Result(2)\n        else:\n            return Result(0)\n\ndef test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"Counts the number of equal numbers from three given integers.\"\"\"\n    input_data = ThreeIntegersInput(a, b, c)\n    counter = EqualityCounter()\n    result_obj = counter.countEqual(input_data)\n    return result_obj.equal_count"}
{"task_id": "Mbpp/804", "solution": "from typing import Iterable, Union\n\nNumber = Union[int, float]\n\ndef _is_even(n: Number) -> bool:\n    \"\"\"Returns True if n represents an even integer value.\"\"\"\n    if isinstance(n, int):\n        return n % 2 == 0\n    elif isinstance(n, float):\n        # A float is considered even if it's an integer-valued float and that integer is even.\n        return n.is_integer() and (int(n) % 2 == 0)\n\ndef is_product_even(numbers: Iterable[Number]) -> bool:\n    \"\"\"Return True if the product of numbers is even (i.e., at least one element is even).\"\"\"\n    for num in numbers:\n        if _is_even(num):\n            return True\n    return False"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(value, d):\n    \"\"\"\n    Rotates the bits of a 32-bit number to the left by d positions.\n    All arithmetic is confined to 32 bits using a mask.\n    \"\"\"\n    BIT_WIDTH = 32\n    MASK = 0xFFFFFFFF\n\n    # Confine the input value to 32 bits\n    value32 = value & MASK\n\n    # Normalize the rotation count\n    d_mod = d % BIT_WIDTH\n\n    if d_mod == 0:\n        return value32\n\n    # Perform the left rotation\n    # Left part: bits shifted out reappear on the right\n    left_part = (value32 << d_mod) & MASK\n    # Right part: bits that wrap around from the left\n    right_part = (value32 >> (BIT_WIDTH - d_mod)) & MASK\n\n    # Combine the parts and ensure the result is 32-bit\n    result = (left_part | right_part) & MASK\n    return result"}
{"task_id": "Mbpp/805", "solution": "```python\nfrom typing import List\n\ndef max_sum_list(lists: List[List[float]]) -> List[float]:\n    \"\"\"\n    Accepts an outer list of inner lists of numeric elements.\n    Returns the inner list with the highest arithmetic sum, returning the first highest on a tie.\n    \"\"\"\n    if not isinstance(lists, (list, tuple)):\n        raise TypeError(\"Input 'lists' must be a list or tuple.\")\n\n    if not lists:\n        return []\n\n    max_sum = None\n    result_list = []\n\n    for inner_list in lists:\n        if not isinstance(inner_list, (list, tuple)):\n            raise TypeError(\"Inner element must be a list or tuple.\")\n\n        current_sum = 0\n        for element in inner_list:\n            if not isinstance(element, (int, float)):\n                raise TypeError(\"Inner list elements must be numeric (int or float).\")\n            current_sum += element\n\n        if max_sum is None or current_sum > max_sum:\n            max_sum = current_sum\n            result_list = list(inner_list) # Store a copy to avoid external modification issues\n\n    return result_list\n```"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input: str) -> int:\n    \"\"\"\n    Finds the maximum run of uppercase ASCII characters in the given string.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in input:\n        if 'A' <= char <= 'Z':\n            current_run += 1\n            max_run = max(max_run, current_run)\n        else:\n            current_run = 0\n    return max_run"}
