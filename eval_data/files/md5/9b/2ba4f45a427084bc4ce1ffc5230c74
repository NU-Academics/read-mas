{"task_id": "Mbpp/84", "solution": "class InputValidationError(Exception):\n    \"\"\"Exception type raised for invalid inputs.\"\"\"\n    pass\n\ndef _validate_n(n):\n    \"\"\"Validate input n is a 1-based positive integer.\n\n    Raises:\n        InputValidationError: if n is not an integer or n < 1.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise InputValidationError(\"n must be a positive integer (1-based index).\")\n\ndef sequence(n):\n    \"\"\"Compute and return the nth Newman-Conway sequence term (1-based).\n\n    Parameters:\n        n: positive integer (1-based index)\n\n    Returns:\n        int: nth Newman-Conway term\n\n    Raises:\n        InputValidationError: if n is not a positive integer (n < 1 or non-integer)\n    \"\"\"\n    _validate_n(n)\n\n    if n == 1 or n == 2:\n        return 1\n\n    # Initialize a list to store sequence terms, using 1-based indexing.\n    # The 0th index will be unused for direct mapping a(i) to sequence_terms[i].\n    sequence_terms = [0] * (n + 1)\n    sequence_terms[1] = 1\n    sequence_terms[2] = 1\n\n    for i in range(3, n + 1):\n        # Apply the Newman-Conway recurrence relation: a(i) = a(a(i-1)) + a(i - a(i-1))\n        term1_index = sequence_terms[i - 1]\n        term2_index = i - sequence_terms[i - 1]\n        sequence_terms[i] = sequence_terms[term1_index] + sequence_terms[term2_index]\n\n    return sequence_terms[n]"}
{"task_id": "Mbpp/82", "solution": "import math\n\nclass MathLib:\n    \"\"\"Adapter exposing math.pi from the standard library.\"\"\"\n    pi = math.pi\n\nclass InputValidator:\n    \"\"\"Stateless input validation for radius.\"\"\"\n    def validate_radius(self, radius):\n        \"\"\"Returns True if radius is an int or float and not NaN; else False.\"\"\"\n        return isinstance(radius, (int, float)) and not math.isnan(radius)\n\nclass Sphere:\n    \"\"\"Domain data carrier for a sphere's properties.\"\"\"\n    def __init__(self, radius):\n        self._radius = float(radius)\n        self._volume = None\n\n    def set_volume(self, volume):\n        self._volume = float(volume)\n\n    def get_radius(self):\n        return self._radius\n\n    def get_volume(self):\n        return self._volume\n\nclass VolumeCalculator:\n    \"\"\"Orchestrates input validation, computes sphere volume, and handles exceptions.\"\"\"\n    def volume_sphere(self, radius):\n        \"\"\"Computes and returns the volume of a sphere as a float, or raises an error.\"\"\"\n        validator = InputValidator()\n        if not validator.validate_radius(radius):\n            if not isinstance(radius, (int, float)):\n                raise TypeError(\"radius must be an int or float\")\n            else: # If numeric but invalid, it must be NaN\n                raise ValueError(\"radius must not be NaN\")\n\n        float_radius = float(radius)\n        \n        # Instantiate Sphere for data holding as per design, though volume is returned directly.\n        sphere = Sphere(float_radius) \n\n        # Calculate volume using MathLib.pi\n        volume = (4.0 / 3.0) * MathLib.pi * (float_radius ** 3)\n        \n        sphere.set_volume(volume) # Set volume on the Sphere object\n\n        return volume\n\ndef volume_sphere(radius):\n    \"\"\"Public API: compute and return sphere volume as float or raise documented exceptions.\"\"\"\n    calculator = VolumeCalculator()\n    return calculator.volume_sphere(radius)"}
{"task_id": "Mbpp/75", "solution": "from typing import List, Tuple\n\nclass DivisibilityRule:\n    \"\"\"Encapsulates the divisibility predicate.\"\"\"\n    def is_divisible(self, value: int, k: int) -> bool:\n        return value % k == 0\n\nclass FindTuplesService:\n    \"\"\"Orchestrates filtering of tuples based on a divisibility rule.\"\"\"\n    def __init__(self, rule: DivisibilityRule) -> None:\n        self._rule = rule\n\n    def find_tuples(self, tuple_list: List[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n        result_list = []\n        for input_tuple in tuple_list:\n            is_tuple_match = True\n            for element in input_tuple:\n                if not self._rule.is_divisible(element, k):\n                    is_tuple_match = False\n                    break\n            if is_tuple_match:\n                result_list.append(input_tuple)\n        return result_list\n\ndef find_tuples(tuple_list: List[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n    \"\"\"\n    Finds tuples where all elements are divisible by k from the given list of tuples.\n    This function delegates the filtering logic to internal service components.\n    \"\"\"\n    rule = DivisibilityRule()\n    service = FindTuplesService(rule)\n    return service.find_tuples(tuple_list, k)"}
{"task_id": "Mbpp/85", "solution": "import math\n\nclass MathLib:\n    pi = math.pi\n    @staticmethod\n    def isclose(a, b, rel_tol=1e-09, abs_tol=0.0) -> bool:\n        return math.isclose(a, b, rel_tol=rel_tol, abs_tol=abs_tol)\n\nclass InputValidator:\n    @staticmethod\n    def is_numeric(value) -> bool:\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\nclass SurfaceAreaCalculator:\n    @staticmethod\n    def surfacearea_sphere(radius):\n        return SurfaceAreaCalculator.compute_surface_area(radius)\n\n    @staticmethod\n    def compute_surface_area(radius) -> float:\n        return 4.0 * MathLib.pi * (float(radius) ** 2)\n\nclass Sphere:\n    def __init__(self, radius: float):\n        self.radius = float(radius)\n        self.surface_area = None\n\nclass Result:\n    def __init__(self, value: float):\n        self.value = float(value)\n\ndef surfacearea_sphere(radius):\n    \"\"\"\n    Public API. Validates radius is numeric then returns float surface area computed as 4 * math.pi * radius ** 2.\n    Returns: float\n    \"\"\"\n    if not InputValidator.is_numeric(radius):\n        raise TypeError(\"radius must be numeric\")\n    result = SurfaceAreaCalculator.surfacearea_sphere(radius)\n    return float(result)"}
{"task_id": "Mbpp/86", "solution": "class InputValidator:\n    def is_positive_integer(self, n) -> bool:\n        return isinstance(n, int) and n >= 1\n\nclass CenteredHexagonalNumberCalculator:\n    def __init__(self):\n        self._validator = InputValidator()\n\n    def centered_hexagonal_number(self, n: int) -> int:\n        \"\"\"Validates input and computes the nth centered hexagonal number.\"\"\"\n        if not self._validator.is_positive_integer(n):\n            raise ValueError(\"n must be an integer >= 1\")\n        value = self.compute(n)\n        return value\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the centered hexagonal number using the formula 3 * n * (n - 1) + 1.\"\"\"\n        return 3 * n * (n - 1) + 1\n\ndef centered_hexagonal_number(n: int) -> int:\n    \"\"\"\n    Computes the nth centered hexagonal number.\n    Raises ValueError for invalid input (n not an integer or n < 1).\n    \"\"\"\n    calc = CenteredHexagonalNumberCalculator()\n    return calc.centered_hexagonal_number(n)"}
{"task_id": "Mbpp/90", "solution": "def len_log(words: list[str]) -> int:\n    \"\"\"Returns the length of the longest string in the list, or 0 if the list is empty.\"\"\"\n    if not words:\n        return 0\n    return len(max(words, key=len))"}
{"task_id": "Mbpp/87", "solution": "import collections\nfrom typing import Dict, Any, Set\n\ndef merge_dictionaries_three(dict1: Dict[Any, Any], dict2: Dict[Any, Any], dict3: Dict[Any, Any]) -> Dict[Any, Any]:\n    \"\"\"\n    Merges three dictionaries into a single dictionary, handling type validation and value conflicts.\n    Raises TypeError for non-dict inputs or ValueError for conflicting values for the same key.\n    \"\"\"\n    _validate_inputs(dict1, dict2, dict3)\n\n    merged_dict = {}\n    all_keys = set(dict1.keys()) | set(dict2.keys()) | set(dict3.keys())\n\n    for key in all_keys:\n        values = _collect_values_for_key(key, dict1, dict2, dict3)\n        if len(values) == 1:\n            merged_dict[key] = next(iter(values))\n        elif len(values) > 1:\n            raise ValueError(f\"Conflicting values for key '{key}'\")\n    \n    return merged_dict\n\ndef _validate_inputs(dict1: Dict[Any, Any], dict2: Dict[Any, Any], dict3: Dict[Any, Any]) -> None:\n    \"\"\"Ensures all three parameters are instances of dict; raises TypeError otherwise.\"\"\"\n    if not isinstance(dict1, dict):\n        raise TypeError(\"Input 'dict1' must be a dictionary.\")\n    if not isinstance(dict2, dict):\n        raise TypeError(\"Input 'dict2' must be a dictionary.\")\n    if not isinstance(dict3, dict):\n        raise TypeError(\"Input 'dict3' must be a dictionary.\")\n\ndef _collect_values_for_key(key: Any, dict1: Dict[Any, Any], dict2: Dict[Any, Any], dict3: Dict[Any, Any]) -> Set[Any]:\n    \"\"\"Collects all unique values for a given key from the three dictionaries.\"\"\"\n    values = set()\n    if key in dict1:\n        values.add(dict1[key])\n    if key in dict2:\n        values.add(dict2[key])\n    if key in dict3:\n        values.add(dict3[key])\n    return values"}
{"task_id": "Mbpp/89", "solution": "\"\"\"Public API: closest_num(n)\n- closest_num(n): accepts one parameter n (int) and returns int equal to n - 1. Raises TypeError if n is not int.\nUsage: from src.closest_num import closest_num\n\"\"\"\nfrom typing import Any\n\nclass IntegerParameter:\n    \"\"\"Data holder for an input integer.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass IntegerResult:\n    \"\"\"Data holder for an output integer.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass ClosestNum:\n    \"\"\"Internal class to encapsulate validation and computation.\"\"\"\n    def validate(self, n: Any) -> bool:\n        \"\"\"Returns True if the input is an integer, False otherwise.\"\"\"\n        return isinstance(n, int)\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the closest smaller integer (n - 1).\"\"\"\n        _ = IntegerParameter(n) # Internal domain object instantiation\n        result = n - 1\n        return IntegerResult(result).value # Internal domain object instantiation and value return\n\ndef closest_num(n: int) -> int:\n    \"\"\"Finds the closest smaller number than n.\n\n    Raises TypeError if n is not an integer.\n    \"\"\"\n    processor = ClosestNum()\n    if not processor.validate(n):\n        raise TypeError(f\"Input must be an integer, but got {type(n).__name__}\")\n    return processor.compute(n)"}
{"task_id": "Mbpp/88", "solution": "def freq_count(list_input):\n    \"\"\"Validate input and return a dict mapping each distinct element to its integer occurrence count.\n    Raises TypeError if input is not a list or if any element is not hashable.\n    \"\"\"\n    if not isinstance(list_input, list):\n        raise TypeError(\"Input must be a list.\")\n\n    frequency_map = {}\n    for element in list_input:\n        try:\n            # Attempt to use the element as a dictionary key to implicitly check hashability.\n            frequency_map[element] = frequency_map.get(element, 0) + 1\n        except TypeError:\n            raise TypeError(f\"List elements must be hashable, but found an unhashable element: {element}\")\n    return frequency_map"}
{"task_id": "Mbpp/91", "solution": "def validate_inputs(list_of_strings, substring):\n    \"\"\"Validates input types for the find_substring function. Raises TypeError for invalid types.\"\"\"\n    if not isinstance(list_of_strings, list):\n        raise TypeError(\"list_of_strings must be a list\")\n    if not isinstance(substring, str):\n        raise TypeError(\"substring must be a string\")\n    for elem in list_of_strings:\n        if not isinstance(elem, str):\n            raise TypeError(\"all elements of list_of_strings must be strings\")\n\ndef search(list_of_strings, substring):\n    \"\"\"Performs the actual substring search within the list of strings.\"\"\"\n    if substring == \"\":\n        return True\n    for element in list_of_strings:\n        if substring in element:\n            return True\n    return False\n\ndef find_substring(list_of_strings, substring):\n    \"\"\"\n    Checks if a string is present as a substring in a given list of string values.\n    Raises TypeError for invalid input types.\n    \"\"\"\n    validate_inputs(list_of_strings, substring)\n    return search(list_of_strings, substring)"}
{"task_id": "Mbpp/93", "solution": "from typing import Union\n\nclass Operand:\n    \"\"\"Value object holding a numeric value and its role ('a' or 'b').\"\"\"\n    def __init__(self, value: Union[int, float], role: str) -> None:\n        self.value = value\n        self.role = role\n\nclass Result:\n    \"\"\"Value object holding a numeric computation result.\"\"\"\n    def __init__(self, value: Union[int, float]) -> None:\n        self.value = value\n\nclass PowerFunction:\n    \"\"\"Encapsulates operands, validates inputs, computes exponentiation, and produces a Result.\"\"\"\n    def __init__(self, a: Union[int, float], b: Union[int, float]) -> None:\n        self._operand_a = Operand(a, 'a')\n        self._operand_b = Operand(b, 'b')\n        self._result: Union[Result, None] = None\n\n    def validateInputs(self) -> None:\n        \"\"\"Placeholder for input validation as per design, but without explicit checks per completion rules.\"\"\"\n        pass\n\n    def compute(self) -> Union[int, float]:\n        \"\"\"Computes a to the power of b and stores/returns the result.\"\"\"\n        computed_value = self._operand_a.value ** self._operand_b.value\n        self._result = Result(computed_value)\n        return self._result.value\n\ndef power(a: Union[int, float], b: Union[int, float]) -> Union[int, float]:\n    \"\"\"Public API. Validates inputs and returns a raised to the power b.\"\"\"\n    power_func = PowerFunction(a, b)\n    power_func.validateInputs()\n    return power_func.compute()"}
{"task_id": "Mbpp/92", "solution": "from typing import List\n\nclass Number:\n    \"\"\"Domain data holder for an integer value and its extracted digits.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value: int = value\n        # Extracts digits from the absolute value of the number.\n        self.digits: List[int] = [int(d) for d in str(abs(value))]\n\nclass UndulatingChecker:\n    \"\"\"Implements the logic to determine if a number is undulating.\"\"\"\n    def is_undulating(self, n: int) -> bool:\n        \"\"\"Determines if the given integer `n` is undulating.\"\"\"\n        # Construct the Number object as per design, though its digits might be re-extracted.\n        _ = Number(n) \n        # Extract digits using the checker's own method.\n        digits = self.extract_digits(n)\n        return self.is_alternating(digits)\n\n    def extract_digits(self, n: int) -> List[int]:\n        \"\"\"Extracts and returns the decimal digits of the absolute value of `n`.\"\"\"\n        return [int(d) for d in str(abs(n))]\n\n    def is_alternating(self, digits: List[int]) -> bool:\n        \"\"\"Checks if a list of digits follows an a,b,a,b... alternating pattern.\"\"\"\n        if len(digits) < 2:\n            return False\n\n        first_digit = digits[0]\n        second_digit = digits[1]\n\n        # The two alternating digits must be distinct.\n        if first_digit == second_digit:\n            return False\n\n        # Verify the alternating pattern for the rest of the digits.\n        for i in range(2, len(digits)):\n            if i % 2 == 0:  # Even index should match the first digit.\n                if digits[i] != first_digit:\n                    return False\n            else:  # Odd index should match the second digit.\n                if digits[i] != second_digit:\n                    return False\n        \n        return True\n\ndef is_undulating(n: int) -> bool:\n    \"\"\"\n    Checks whether the given number is undulating.\n    An undulating number's digits alternate between exactly two distinct digits (a,b,a,b,... where a != b).\n    \"\"\"\n    checker = UndulatingChecker()\n    return checker.is_undulating(n)"}
{"task_id": "Mbpp/94", "solution": "from typing import Any, List, Tuple\n\nclass TupleItem:\n    \"\"\"Represents a single 2-element tuple from the input list.\"\"\"\n    def __init__(self, firstValue: Any, secondValue: Any):\n        self.firstValue = firstValue\n        self.secondValue = secondValue\n    \n    def is_valid(self) -> bool:\n        # Conceptual validity check, actual validation handled by TupleList.\n        return True\n\ndef are_seconds_comparable(values: List[Any]) -> bool:\n    \"\"\"Checks if all values in a list are mutually comparable.\"\"\"\n    try:\n        # Attempting to sort is a common way to check for comparability in Python.\n        sorted(values)\n        return True\n    except TypeError:\n        return False\n\nclass TupleList:\n    \"\"\"Wraps a list of tuples and provides validation as per design requirements.\"\"\"\n    def __init__(self, items: List[Tuple]):\n        # A shallow copy to ensure the original input list remains unchanged.\n        self._items = list(items)\n\n    def validate(self) -> None:\n        \"\"\"Validates the input list's elements for shape, type, and comparability.\"\"\"\n        if len(self._items) == 0:\n            raise ValueError(\"Input list cannot be empty.\")\n        \n        seconds = []\n        for el in self._items:\n            # Each element must be a 2-element tuple.\n            if not (isinstance(el, tuple) and len(el) == 2):\n                raise TypeError(\"Each element must be a 2-element tuple.\")\n            seconds.append(el[1])\n        \n        # Second elements must be comparable.\n        if not are_seconds_comparable(seconds):\n            raise TypeError(\"Second elements of tuples are not comparable.\")\n\n    def __len__(self) -> int:\n        return len(self._items)\n\nclass Result:\n    \"\"\"A simple wrapper class to encapsulate the final return value.\"\"\"\n    def __init__(self, value: Any):\n        self.value = value\n\ndef index_minimum(items: list[tuple]) -> Any:\n    \"\"\"Given a list of 2-element tuples, return the first element of the tuple\n    whose second element is minimal. Handles validation and tie-breaking.\"\"\"\n    \n    tuple_list = TupleList(items)\n    # Perform all necessary input validations. Exceptions are propagated from here.\n    tuple_list.validate()\n    \n    min_index = None\n    min_second = None\n    \n    # Iterate through the (validated) items to find the tuple with the smallest second value.\n    # The first occurrence is chosen for tie-breaking as per requirement.\n    for idx, (first, second) in enumerate(tuple_list._items):\n        if min_index is None or second < min_second:\n            min_index = idx\n            min_second = second\n            \n    # Return the first element of the tuple at the identified minimum index, wrapped by Result.\n    return Result(tuple_list._items[min_index][0]).value"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists):\n    \"\"\"Return the length of the shortest inner list in list_of_lists.\n\n    Raises ValueError if the outer list is empty, as specified in design context.\n    \"\"\"\n    if not list_of_lists:\n        raise ValueError(\"outer list is empty; SRS does not specify behavior for this case\")\n    lengths = [len(inner) for inner in list_of_lists]\n    return min(lengths)"}
{"task_id": "Mbpp/96", "solution": "def divisor(n):\n    \"\"\"\n    Calculates the number of positive divisors for a given positive integer n.\n    This function counts both 1 and n as divisors.\n    \"\"\"\n    count = 0\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(sequence):\n    \"\"\"\n    Multiplies all numbers in a sequence and divides by its length.\n    Raises ValueError for empty sequences or TypeError for non-numeric elements.\n    \"\"\"\n\n    def _is_numeric(value):\n        \"\"\"Returns True if the value is an int or float, but not a boolean.\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n    def validate_numeric_sequence(seq):\n        \"\"\"Ensures the sequence is not empty and all its elements are numeric.\"\"\"\n        if not seq:\n            raise ValueError(\"Sequence cannot be empty.\")\n        for element in seq:\n            if not _is_numeric(element):\n                raise TypeError(\"All elements in the sequence must be numeric.\")\n\n    def compute_product(seq):\n        \"\"\"Calculates the multiplicative product of all numbers in the sequence.\"\"\"\n        product = 1\n        for num in seq:\n            product *= num\n        return product\n\n    def divide_by_length(prod_val, length_val):\n        \"\"\"Divides a product by a given length, ensuring a float result.\"\"\"\n        return float(prod_val / length_val)\n\n    validate_numeric_sequence(sequence)\n    product = compute_product(sequence)\n    result = divide_by_length(product, len(sequence))\n    return result"}
{"task_id": "Mbpp/97", "solution": "import collections\n\nclass _FrequencyMap:\n    \"\"\"Encapsulates a dictionary to accumulate element counts.\"\"\"\n    def __init__(self):\n        self._map = collections.defaultdict(int)\n\n    def increment(self, key):\n        \"\"\"Increments or initializes the count for a given key.\"\"\"\n        self._map[key] += 1\n\n    def to_dict(self):\n        \"\"\"Returns a plain dictionary copy of the accumulated counts.\"\"\"\n        return dict(self._map)\n\nclass _FrequencyCalculator:\n    \"\"\"Orchestrates flattening a list of lists and counting element frequencies.\"\"\"\n    def __init__(self):\n        self.frequency_map = _FrequencyMap()\n\n    def flatten(self, listOfLists):\n        \"\"\"Yields elements from a one-level nested list of lists.\"\"\"\n        for inner_list in listOfLists:\n            for element in inner_list:\n                yield element\n\n    def count(self, elements):\n        \"\"\"Increments counts for each element in the provided iterable.\"\"\"\n        for element in elements:\n            self.frequency_map.increment(element)\n\n    def frequency_lists(self, listOfLists):\n        \"\"\"Flattens the input and counts element frequencies.\"\"\"\n        flattened_elements = self.flatten(listOfLists)\n        self.count(flattened_elements)\n        return self.frequency_map.to_dict()\n\ndef frequency_lists(listOfLists):\n    \"\"\"\n    Finds the frequency of each element in a flattened list of lists.\n    Returns a dictionary mapping each unique element to its count.\n    \"\"\"\n    calculator = _FrequencyCalculator()\n    return calculator.frequency_lists(listOfLists)"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(value: int) -> str:\n    \"\"\"Converts a decimal number to its binary equivalent, represented as a string with no leading zeros.\"\"\"\n    if value == 0:\n        return '0'\n\n    binary_digits = []\n    current_value = value\n    while current_value > 0:\n        remainder = current_value % 2\n        binary_digits.append(str(remainder))\n        current_value //= 2\n\n    return \"\".join(reversed(binary_digits))"}
{"task_id": "Mbpp/100", "solution": "class InputError(Exception):\n    def __init__(self, message: str) -> None:\n        self.message = message\n    def __str__(self) -> str:\n        return self.message\n\nclass UserInput:\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass PalindromeResult:\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass InputValidator:\n    def validate(self, user_input: UserInput) -> bool:\n        \"\"\"Validates that the user_input's value is an integer.\"\"\"\n        if not isinstance(user_input.value, int):\n            raise InputError(f\"Input must be an integer, but got {type(user_input.value).__name__}.\")\n        return True\n\nclass PalindromeCalculator:\n    def isPalindrome(self, n: int) -> bool:\n        \"\"\"Returns True if n is a palindrome in base-10 representation.\"\"\"\n        s = str(n)\n        return s == s[::-1]\n\n    def nextPalindrome(self, n: int) -> int:\n        \"\"\"Computes and returns the smallest palindrome strictly greater than n.\"\"\"\n        current_num = n + 1\n        while not self.isPalindrome(current_num):\n            current_num += 1\n        return current_num\n\n    def compute(self, user_input: UserInput) -> PalindromeResult:\n        \"\"\"Computes the next smallest palindrome given validated UserInput.\"\"\"\n        next_pal = self.nextPalindrome(user_input.value)\n        return PalindromeResult(next_pal)\n\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"Finds the next smallest palindrome of a specified integer.\"\"\"\n    user_input = UserInput(n)\n    \n    validator = InputValidator()\n    validator.validate(user_input)\n\n    calculator = PalindromeCalculator()\n    result = calculator.compute(user_input)\n    \n    return result.value"}
{"task_id": "Mbpp/101", "solution": "class Error(Exception):\n    \"\"\"Domain error class, used for validation and selection failures.\"\"\"\n    def __init__(self, message: str, type: str = 'Error'):\n        super().__init__(message)\n        self.message = message\n        self.type = type\n\n    def __str__(self) -> str:\n        return f\"{self.type}: {self.message}\"\n\nclass Array:\n    \"\"\"Lightweight wrapper for caller-provided list to expose length semantics.\"\"\"\n    def __init__(self, elements):\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\n\n    def get_readonly(self) -> list:\n        return self.elements\n\nclass Request:\n    \"\"\"Encapsulates incoming call parameters (array and k).\"\"\"\n    def __init__(self, input_list, k):\n        self.array = Array(input_list)\n        self.k = k\n\nclass Element:\n    \"\"\"Represents a selected element with its value and 1-based position.\"\"\"\n    def __init__(self, value, position):\n        self.value = value\n        self.position = position\n\ndef validate_request(request: Request) -> None:\n    \"\"\"Enforces validation rules (k must be integer; 1 <= k <= length(array); empty array handling).\"\"\"\n    if not isinstance(request.k, int):\n        raise Error(message='k must be an integer', type='InvalidArgument')\n\n    array_length = request.array.length()\n\n    if array_length == 0:\n        raise Error(message='k out of range', type='IndexOutOfRange')\n\n    if request.k < 1 or request.k > array_length:\n        raise Error(message='k out of range', type='IndexOutOfRange')\n\ndef select_element(request: Request) -> Element:\n    \"\"\"Returns Element corresponding to request.k (1-based) without mutating input.\"\"\"\n    value = request.array.get_readonly()[request.k - 1]\n    return Element(value=value, position=request.k)\n\ndef kth_element(array, k):\n    \"\"\"\n    Finds the kth element in the given array using 1-based indexing.\n    Validates input k and returns the element or raises an Error.\n    \"\"\"\n    request = Request(array, k)\n    validate_request(request)\n    element_obj = select_element(request)\n    return element_obj.value"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(input: str) -> str:\n    \"\"\"Converts a snake_case string to CamelCase (PascalCase), capitalizing the first alphabetic character of each non-empty segment.\"\"\"\n    if not input:\n        return \"\"\n\n    segments = input.split('_')\n    camel_case_segments = []\n\n    for segment in segments:\n        if not segment:\n            continue\n\n        if segment[0].isalpha():\n            transformed_segment = segment[0].upper() + segment[1:]\n        else:\n            transformed_segment = segment\n        \n        camel_case_segments.append(transformed_segment)\n\n    return \"\".join(camel_case_segments)"}
{"task_id": "Mbpp/103", "solution": "class ErrorResponse(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass EulerianFunction:\n    \"\"\"Validates inputs and computes the Eulerian number A(n, m).\"\"\"\n\n    def validateInputs(self, n: int, m: int) -> None:\n        \"\"\"Checks if n and m are valid integers for Eulerian number computation.\"\"\"\n        if not isinstance(n, int):\n            raise ErrorResponse(f\"Input 'n' must be an integer, but got {type(n).__name__}.\")\n        if not isinstance(m, int):\n            raise ErrorResponse(f\"Input 'm' must be an integer, but got {type(m).__name__}.\")\n\n        if n < 0 or m < 0:\n            raise ErrorResponse(\"Inputs 'n' and 'm' must be non-negative integers.\")\n        \n        if n == 0:\n            if m != 0:\n                raise ErrorResponse(\"For n=0, 'm' must be 0 (A(0,0)=1).\")\n        else: # n > 0\n            if m >= n:\n                raise ErrorResponse(f\"For n={n}, 'm' must be less than 'n' (i.e., m < {n}).\")\n\n    def compute(self, n: int, m: int) -> int:\n        \"\"\"Computes A(n, m) using dynamic programming based on its recurrence relation.\"\"\"\n        if n == 0 and m == 0:\n            return 1\n        if m >= n or m < 0: # This case is covered by validateInputs for public API.\n            return 0\n\n        dp = [[0] * (n + 1) for _ in range(n + 1)]\n        dp[0][0] = 1\n\n        for i in range(1, n + 1):\n            for j in range(i): # m (j) goes from 0 to i-1 for A(i,j)\n                val1 = dp[i-1][j-1] if j - 1 >= 0 else 0\n                val2 = dp[i-1][j]\n                dp[i][j] = (i - j) * val1 + (j + 1) * val2\n        \n        return dp[n][m]\n\n    def eulerian_num(self, n: int, m: int) -> int:\n        \"\"\"Performs validation then computes the Eulerian number A(n, m).\"\"\"\n        self.validateInputs(n, m)\n        return self.compute(n, m)\n\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Finds the Eulerian number a(n, m).\n    Raises ErrorResponse for invalid input parameters.\n    \"\"\"\n    calculator = EulerianFunction()\n    return calculator.eulerian_num(n, m)"}
{"task_id": "Mbpp/105", "solution": "def count(input_list):\n    \"\"\"Return number of elements in input_list that are exactly the boolean True.\n\n    Parameters:\n        input_list: list -- the list of elements to inspect\n\n    Returns:\n        int -- count of elements where isinstance(element, bool) and element is True\n    \"\"\"\n    return sum(1 for el in input_list if isinstance(el, bool) and el is True)"}
{"task_id": "Mbpp/104", "solution": "def _validate_outer_sequence(sequence):\n    \"\"\"Internal helper: raises TypeError if outer container is not list or tuple or if any sublist is not a list or tuple.\"\"\"\n    if not isinstance(sequence, (list, tuple)):\n        raise TypeError(\"Input sequence must be a list or a tuple.\")\n    for i, sublist in enumerate(sequence):\n        if not isinstance(sublist, (list, tuple)):\n            raise TypeError(f\"Element at index {i} is not a list or tuple.\")\n\ndef _copy_and_sort_sublist(sublist):\n    \"\"\"Internal helper: returns a new list with elements copied from sublist and sorted ascending lexicographically.\"\"\"\n    new_list = list(sublist)\n    new_list.sort()\n    return new_list\n\ndef sort_sublists(sequence):\n    \"\"\"Public API per SRS: Accepts outer sequence (list or tuple) of sublists of strings and returns a new list of lists where each inner list is a sorted copy of the corresponding input sublist.\"\"\"\n    _validate_outer_sequence(sequence)\n    \n    sorted_lists = []\n    for sublist in sequence:\n        sorted_copy = _copy_and_sort_sublist(sublist)\n        sorted_lists.append(sorted_copy)\n    \n    return sorted_lists"}
{"task_id": "Mbpp/106", "solution": "class Validator:\n    @staticmethod\n    def validate_types(list_obj, tuple_obj) -> bool:\n        \"\"\"Return True if list_obj is list and tuple_obj is tuple; raise TypeError if not.\"\"\"\n        if not isinstance(list_obj, list):\n            raise TypeError(\"first argument must be a list\")\n        if not isinstance(tuple_obj, tuple):\n            raise TypeError(\"second argument must be a tuple\")\n        return True\n\ndef add_lists(list_obj, tuple_obj):\n    \"\"\"Validate and return new tuple: tuple_obj elements followed by list_obj elements.\"\"\"\n    Validator.validate_types(list_obj, tuple_obj)\n    return tuple_obj + tuple(list_obj)"}
{"task_id": "Mbpp/108", "solution": "from typing import List\n\ndef merge_sorted_list(listA: List[int], listB: List[int], listC: List[int]) -> List[int]:\n    \"\"\"\n    Merges three lists into a single list and returns a new sorted list.\n    Input lists are not modified, and duplicates are preserved.\n    \"\"\"\n    def _combine_lists(a: List[int], b: List[int], c: List[int]) -> List[int]:\n        \"\"\"Combines elements from three lists into a single new list.\"\"\"\n        return a + b + c\n\n    def _sorted_copy(items: List[int]) -> List[int]:\n        \"\"\"Returns a new list containing all items sorted in ascending order.\"\"\"\n        return sorted(items)\n\n    combined = _combine_lists(listA, listB, listC)\n    result = _sorted_copy(combined)\n    return result"}
{"task_id": "Mbpp/109", "solution": "from typing import Optional\n\nclass BinaryString:\n    \"\"\"Represents a binary string and validates its content.\"\"\"\n    def __init__(self, value: str) -> None:\n        if not isinstance(value, str):\n            raise TypeError(\"BinaryString value must be a string.\")\n        self.value = value\n        self.length = len(value)\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the string contains only '0' or '1' and is not empty.\"\"\"\n        if self.length == 0:\n            return False\n        return all(char in ('0', '1') for char in self.value)\n\n    def char_at(self, index: int) -> str:\n        \"\"\"Returns the character at the given index, modulo length.\"\"\"\n        if self.length == 0:\n            raise IndexError(\"Cannot get character from an empty BinaryString.\")\n        return self.value[index % self.length]\n\n\nclass Rotation:\n    \"\"\"Represents a left-rotation of a binary string and determines its oddness.\"\"\"\n    def __init__(self, index: int, value: str) -> None:\n        self.index = index\n        self.value = value\n\n    def is_odd(self) -> bool:\n        \"\"\"Determines if the rotated string represents an odd integer.\"\"\"\n        if not self.value:\n            return False # An empty string cannot be odd.\n        return self.value[-1] == '1'\n\n\nclass OddEquivalentFunction:\n    \"\"\"Orchestrates validation, rotation generation, oddness checks, and counting.\"\"\"\n    def odd_Equivalent(self, s: str, k: int) -> int:\n        \"\"\"\n        Validates inputs, generates rotations, counts odd-valued rotations.\n        \"\"\"\n        binary_s = BinaryString(s)\n        if not binary_s.is_valid():\n            raise ValueError(\"Invalid binary string: must contain only '0' or '1' and not be empty.\")\n\n        if not isinstance(k, int) or k < 0:\n            raise ValueError(\"k must be a non-negative integer.\")\n\n        if k == 0:\n            return 0\n\n        odd_count = 0\n        s_len = binary_s.length\n\n        for i in range(k):\n            rotation_amount = i % s_len\n            rotated_value = binary_s.value[rotation_amount:] + binary_s.value[:rotation_amount]\n            \n            rotation = Rotation(index=rotation_amount, value=rotated_value)\n            if rotation.is_odd():\n                odd_count += 1\n        \n        return odd_count\n\n\ndef odd_Equivalent(s, k) -> int:\n    \"\"\"\n    Finds the number of numbers with an odd value when rotating a binary string the given number of times.\n    \"\"\"\n    return OddEquivalentFunction().odd_Equivalent(s, k)"}
{"task_id": "Mbpp/111", "solution": "from typing import List, Set\n\ndef common_in_nested_lists(nested_lists: List[List[int]]) -> Set[int]:\n    \"\"\"\n    Finds common elements in given nested lists, ignoring duplicates within each list.\n    It returns a set of elements present in every inner list.\n    \"\"\"\n    if not nested_lists:\n        return set()\n\n    # Convert each inner list to a set to handle intra-list duplicates and facilitate intersection\n    sets_from_lists = [set(inner_list) for inner_list in nested_lists]\n\n    # Initialize the common elements set with the first set\n    common_elements = sets_from_lists[0]\n\n    # Intersect with the remaining sets\n    for s in sets_from_lists[1:]:\n        common_elements = common_elements.intersection(s)\n\n    return common_elements"}
{"task_id": "Mbpp/113", "solution": "import re\nfrom typing import Optional\n\nclass IntegerChecker:\n    \"\"\"Encapsulates the integer-matching pattern and provides core matching logic.\"\"\"\n    pattern: str = r\"^[+-]?[0-9]+$\"\n    _compiled: re.Pattern\n\n    def __init__(self, pattern: Optional[str] = None) -> None:\n        \"\"\"Initializes the IntegerChecker with a compiled regex pattern.\"\"\"\n        self._compiled = re.compile(pattern if pattern is not None else IntegerChecker.pattern)\n\n    def check_integer(self, s: str) -> bool:\n        \"\"\"Applies the compiled regex to check if the string represents an integer.\"\"\"\n        return self._compiled.fullmatch(s) is not None\n\n_integer_checker_instance = IntegerChecker()\n\ndef check_integer(s: str) -> bool:\n    \"\"\"Public API. Returns True iff s matches ^[+-]?[0-9]+$.\"\"\"\n    return _integer_checker_instance.check_integer(s)"}
{"task_id": "Mbpp/118", "solution": "from typing import List\nfrom dataclasses import dataclass\n\n@dataclass\nclass StringInput:\n    value: str\n\n@dataclass\nclass Substring:\n    value: str\n    position: int\n\n@dataclass\nclass OutputList:\n    items: List[str]\n\nclass StringSplitter:\n    def string_to_list(self, input: StringInput) -> List[str]:\n        \"\"\"\n        Splits the input string by the ASCII space character and returns a list of strings.\n        \"\"\"\n        split_strings = input.value.split(' ')\n        output_list = OutputList(items=split_strings)\n        return output_list.items\n\ndef string_to_list(input: str) -> List[str]:\n    \"\"\"\n    Converts a string to a list of strings split on the space character.\n    \"\"\"\n    string_input_obj = StringInput(value=input)\n    splitter = StringSplitter()\n    result = splitter.string_to_list(string_input_obj)\n    return result"}
{"task_id": "Mbpp/116", "solution": "from typing import Tuple, Any\n\nclass Validator:\n    \"\"\"Helper class for validating input types and values.\"\"\"\n    @staticmethod\n    def validate_is_tuple(obj: Any) -> None:\n        \"\"\"Raises TypeError if the object is not a tuple.\"\"\"\n        if not isinstance(obj, tuple):\n            raise TypeError(\"Input must be a tuple.\")\n\n    @staticmethod\n    def validate_elements_positive_integers(input_tuple: Tuple[int, ...]) -> None:\n        \"\"\"Raises ValueError if any tuple element is not a positive integer.\"\"\"\n        for element in input_tuple:\n            if not isinstance(element, int) or element <= 0:\n                raise ValueError(\"All tuple elements must be positive integers.\")\n\ndef tuple_to_int(input_tuple: Tuple[int, ...]) -> int:\n    \"\"\"\n    Converts a tuple of positive integers into a single integer by concatenating their string representations.\n    e.g., (1,2,3) -> 123\n    \"\"\"\n    Validator.validate_is_tuple(input_tuple)\n    Validator.validate_elements_positive_integers(input_tuple)\n\n    # Convert each integer to its string representation, join them, and convert back to an int\n    # Handle empty tuple case\n    if not input_tuple:\n        return 0\n\n    string_elements = [str(element) for element in input_tuple]\n    result_str = \"\".join(string_elements)\n    return int(result_str)"}
{"task_id": "Mbpp/119", "solution": "class InputList:\n    \"\"\"A lightweight holder for the input list and its metadata.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = elements\n        self.length = len(elements)\n        self.is_sorted = all(elements[i] <= elements[i+1] for i in range(self.length - 1)) if self.length > 1 else True\n\nclass SearchFunction:\n    \"\"\"Encapsulates the algorithm to find the unique element in a sorted list.\"\"\"\n\n    def search(self, input_list: list):\n        \"\"\"Return the unique element using a binary search algorithm.\"\"\"\n        low = 0\n        high = len(input_list) - 1\n\n        while low < high:\n            mid = (low + high) // 2\n            \n            if mid % 2 == 0:  # mid is an even index\n                if input_list[mid] == input_list[mid + 1]:\n                    # The pair is at mid and mid+1. The unique element must be to the right.\n                    low = mid + 2\n                else:\n                    # input_list[mid] is not equal to input_list[mid+1].\n                    # The unique element is either input_list[mid] or to its left.\n                    high = mid\n            else:  # mid is an odd index\n                if input_list[mid] == input_list[mid - 1]:\n                    # The pair is at mid-1 and mid. The unique element must be to the right.\n                    low = mid + 1\n                else:\n                    # input_list[mid] is not equal to input_list[mid-1].\n                    # The unique element is either input_list[mid] or to its left.\n                    high = mid\n        \n        return input_list[low]\n\n    def validate_sorted(self, input_list: list) -> bool:\n        \"\"\"Return True if input_list is sorted (non-decreasing).\"\"\"\n        return all(input_list[i] <= input_list[i+1] for i in range(len(input_list) - 1))\n\n\ndef search(input_list: list):\n    \"\"\"Return the element that appears only once in a sorted list where all other elements appear exactly twice.\"\"\"\n    search_func_instance = SearchFunction()\n    return search_func_instance.search(input_list)"}
{"task_id": "Mbpp/120", "solution": "from typing import List, Tuple\nfrom numbers import Number\n\ndef max_product_tuple(pairs: List[Tuple[Number, Number]]) -> Number:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples.\n    Assumes valid input conforming to List[Tuple[Number, Number]].\n    \"\"\"\n    products = [abs(a * b) for a, b in pairs]\n    return max(products)"}
{"task_id": "Mbpp/123", "solution": "import math\nfrom typing import List, Dict\n\nclass DivisorCalculator:\n    \"\"\"\n    Computes proper divisors and s(n) for integers; memoizes results.\n    \"\"\"\n    _sum_cache: Dict[int, int] = {}\n\n    def getProperDivisors(self, n: int) -> List[int]:\n        \"\"\"Returns positive divisors strictly less than n.\"\"\"\n        if n <= 1:\n            return []\n        divs = [1]\n        for i in range(2, int(math.sqrt(n)) + 1):\n            if n % i == 0:\n                divs.append(i)\n                if i * i != n:\n                    divs.append(n // i)\n        return sorted(divs)\n\n    def sumProperDivisors(self, n: int) -> int:\n        \"\"\"Computes and memoizes the sum of proper divisors for n.\"\"\"\n        if n in self._sum_cache:\n            return self._sum_cache[n]\n        \n        if n <= 1: # sum of proper divisors for 1 is 0\n            self._sum_cache[n] = 0\n            return 0\n\n        total_sum = sum(self.getProperDivisors(n))\n        self._sum_cache[n] = total_sum\n        return total_sum\n\nclass AmicableService:\n    \"\"\"\n    Orchestrates computation over range 1..n: precompute s(x), detect amicable members, and aggregate the sum.\n    \"\"\"\n    def __init__(self, divisor_calculator: DivisorCalculator = None):\n        self.divisor_calculator = divisor_calculator if divisor_calculator is not None else DivisorCalculator()\n\n    def amicable_numbers_sum(self, n: int) -> int:\n        \"\"\"\n        Calculates the sum of all amicable numbers up to n.\n        It precomputes s(x) for necessary values and identifies amicable numbers based on the rule s(x) != x and s(s(x)) == x.\n        \"\"\"\n        amicable_sum = 0\n        amicable_members = set()\n\n        for x in range(1, n + 1):\n            if x in amicable_members:\n                continue\n            \n            s_x = self.divisor_calculator.sumProperDivisors(x)\n            \n            if s_x == x: # Exclude perfect numbers\n                continue\n\n            if s_x <= n: # Check if s_x is within the range to compute s(s_x)\n                s_sx = self.divisor_calculator.sumProperDivisors(s_x)\n            else: # If s_x > n, we still need to compute s(s_x) to check if x is part of a pair\n                s_sx = self.divisor_calculator.sumProperDivisors(s_x) # Use DivisorCalculator to get s(s_x)\n\n            if s_sx == x and s_x != x: # Found an amicable pair (x, s_x)\n                # x is an amicable number\n                amicable_members.add(x)\n                amicable_sum += x\n                # If s_x is also within the range 1..n, it's also an amicable number and should be added\n                if s_x <= n and s_x not in amicable_members:\n                    amicable_members.add(s_x)\n                    amicable_sum += s_x\n        \n        return amicable_sum\n\ndef amicable_numbers_sum(n: int) -> int:\n    \"\"\"\n    Public convenience wrapper that instantiates AmicableService and returns its amicable_numbers_sum result.\n    \"\"\"\n    service = AmicableService()\n    return service.amicable_numbers_sum(n)"}
