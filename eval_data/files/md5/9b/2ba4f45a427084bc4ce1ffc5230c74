{"task_id": "Mbpp/56", "solution": "class Number:\n    def __init__(self, value: int):\n        self.value = value\n\nclass CheckResult:\n    def __init__(self, is_valid: bool):\n        self.is_valid = is_valid\n\nclass ReverseOperation:\n    def reverseDigits(self, n: int) -> int:\n        \"\"\"\n        Reverses the decimal digits of n, dropping leading zeros in the reversed sequence.\n        Example: reverseDigits(70) -> 7.\n        \"\"\"\n        if n == 0:\n            return 0\n\n        sign = -1 if n < 0 else 1\n        n_abs_str = str(abs(n))\n        reversed_str = n_abs_str[::-1]\n        return sign * int(reversed_str)\n\nclass CheckFunction:\n    def __init__(self):\n        self.reverse_op = ReverseOperation()\n\n    def check(self, n: int) -> bool:\n        \"\"\"\n        Checks if a number is one less than twice its reverse.\n        Validates input type and orchestrates reversal and comparison.\n        \"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n\n        _ = Number(n) # Adhere to design: create Number model\n\n        reverse_n = self.reverse_op.reverseDigits(n)\n        expected = 2 * reverse_n - 1\n        is_valid = (n == expected)\n\n        _ = CheckResult(is_valid) # Adhere to design: create CheckResult model\n        return is_valid\n\ndef check(n: int) -> bool:\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    Delegates the core logic to CheckFunction.\n    \"\"\"\n    checker = CheckFunction()\n    return checker.check(n)"}
{"task_id": "Mbpp/14", "solution": "def find_Volume(base, height, length):\n    \"\"\"Compute the volume of a triangular prism.\n\n    This function calculates the volume using the formula: 0.5 * base * height * length.\n    \"\"\"\n    base = float(base)\n    height = float(height)\n    length = float(length)\n\n    base_area = 0.5 * base * height\n    volume = base_area * length\n\n    if volume == int(volume):\n        return int(volume)\n    else:\n        return volume"}
