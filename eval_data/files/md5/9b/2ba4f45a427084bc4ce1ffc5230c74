{"task_id": "Mbpp/74", "solution": "class PatternSequence:\n    \"\"\"Adapts an input sequence to provide length and indexed access.\"\"\"\n    def __init__(self, elements):\n        self._elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the sequence.\"\"\"\n        return len(self._elements)\n\n    def get(self, i: int):\n        \"\"\"Returns the element at the specified index.\"\"\"\n        return self._elements[i]\n\nclass ValueSequence:\n    \"\"\"Adapts an input sequence to provide length and indexed access.\"\"\"\n    def __init__(self, elements):\n        self._elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the sequence.\"\"\"\n        return len(self._elements)\n\n    def get(self, i: int):\n        \"\"\"Returns the element at the specified index.\"\"\"\n        return self._elements[i]\n\nclass Mapping:\n    \"\"\"Stores and retrieves one-to-one mappings from patterns to values.\"\"\"\n    def __init__(self):\n        self._map = {}\n\n    def put(self, pattern, value) -> None:\n        \"\"\"Adds a pattern-value mapping.\"\"\"\n        self._map[pattern] = value\n\n    def get(self, pattern):\n        \"\"\"Retrieves the value mapped to a pattern.\"\"\"\n        return self._map.get(pattern)\n\n    def contains(self, pattern) -> bool:\n        \"\"\"Checks if a pattern is already mapped.\"\"\"\n        return pattern in self._map\n\nclass Validator:\n    \"\"\"Orchestrates the validation logic for pattern matching.\"\"\"\n    def is_samepatterns(self, patterns_seq: PatternSequence, values_seq: ValueSequence) -> bool:\n        \"\"\"Determines if two sequences follow the same positional pattern.\"\"\"\n        if patterns_seq.length() != values_seq.length():\n            return False\n\n        mapping = Mapping()\n        for i in range(patterns_seq.length()):\n            p = patterns_seq.get(i)\n            v = values_seq.get(i)\n\n            if mapping.contains(p):\n                if mapping.get(p) != v:\n                    return False\n            else:\n                mapping.put(p, v)\n        return True\n\ndef is_samepatterns(patterns, values) -> bool:\n    \"\"\"\n    Checks whether two sequences follow the same pattern of element mapping.\n    It builds a consistent mapping from pattern elements to value elements.\n    \"\"\"\n    pattern_sequence = PatternSequence(patterns)\n    value_sequence = ValueSequence(values)\n    \n    validator = Validator()\n    return validator.is_samepatterns(pattern_sequence, value_sequence)"}
