{"task_id": "Mbpp/308", "solution": "class List:\n    def __init__(self, values: list) -> None:\n        self.values = values\n\nclass Element:\n    def __init__(self, value: float) -> None:\n        self.value = value\n\nclass Product:\n    def __init__(self, fromA: float, fromB: float) -> None:\n        self.fromA = fromA\n        self.fromB = fromB\n        self.value = fromA * fromB\n\nclass Result:\n    def __init__(self, values: list) -> None:\n        self.values = values\n\nclass LargeProduct:\n    def __init__(self, listA: List, listB: List, k: int) -> None:\n        self.listA = listA\n        self.listB = listB\n        self.k = k\n\n    def compute(self) -> Result:\n        \"\"\"Generates all pairwise products, sorts them, and selects the k largest.\"\"\"\n        all_products = []\n        for a_val in self.listA.values:\n            for b_val in self.listB.values:\n                all_products.append(Product(a_val, b_val))\n\n        all_products.sort(key=lambda p: p.value, reverse=True)\n\n        total_products_count = len(self.listA.values) * len(self.listB.values)\n        n = min(self.k, total_products_count)\n\n        selected_products = all_products[:n]\n\n        return Result(values=[p.value for p in selected_products])\n\ndef _to_domain_list(values: list) -> List:\n    \"\"\"Converts a raw Python list into a domain.List object.\"\"\"\n    return List(values)\n\ndef large_product(listA: list, listB: list, k: int) -> list:\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list.\n    \"\"\"\n    domain_listA = _to_domain_list(listA)\n    domain_listB = _to_domain_list(listB)\n\n    large_product_domain = LargeProduct(listA=domain_listA, listB=domain_listB, k=k)\n\n    result = large_product_domain.compute()\n    return result.values"}
{"task_id": "Mbpp/306", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception for input validation failures.\"\"\"\n    def __init__(self, message: str, code: int = 1):\n        self.message = message\n        self.code = code\n        super().__init__(self.message)\n\nclass Array:\n    \"\"\"Holds and validates the input array values.\"\"\"\n    def __init__(self, values: list):\n        if not isinstance(values, list):\n            raise ValidationError(\"Input 'arr' must be a list.\")\n        for element in values:\n            if not isinstance(element, int):\n                raise ValidationError(\"All elements in 'arr' must be integers.\")\n        self.values = values\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the array.\"\"\"\n        return len(self.values)\n\nclass Indices:\n    \"\"\"Encapsulates n, i, k and provides validation methods.\"\"\"\n    def __init__(self, n: int, i: int, k: int):\n        if not isinstance(n, int) or not isinstance(i, int) or not isinstance(k, int):\n            raise ValidationError(\"n, i, and k must be integers.\")\n        self.n = n\n        self.i = i\n        self.k = k\n\n    def validate_n_equals_length(self, arr_length: int) -> None:\n        \"\"\"Validates if n matches the array length.\"\"\"\n        if self.n != arr_length:\n            raise ValidationError(f\"Input 'n' ({self.n}) must be equal to the length of 'arr' ({arr_length}).\")\n\n    def validate_bounds_and_order(self) -> None:\n        \"\"\"Validates index bounds and order (0 <= i < n, 0 <= k < n, k > i).\"\"\"\n        if not (0 <= self.i < self.n and 0 <= self.k < self.n and self.k > self.i):\n            raise ValidationError(\n                f\"Invalid index bounds or order: 0 <= i < n, 0 <= k < n, and k > i must hold. \"\n                f\"Received i={self.i}, k={self.k}, n={self.n}.\"\n            )\n\nclass Subsequence:\n    \"\"\"Conceptual class to represent a subsequence (not used in direct computation).\"\"\"\n    pass\n\nclass Result:\n    \"\"\"Conceptual class to wrap the integer result (function returns int directly).\"\"\"\n    pass\n\nclass SubsequenceCalculator:\n    \"\"\"Computes the maximum sum of an increasing subsequence.\"\"\"\n    def __init__(self):\n        pass\n\n    def computePrefixMax(self, arr: list, i: int, k: int) -> int:\n        \"\"\"\n        Computes the maximum sum of an increasing subsequence ending at an index `j` (0 <= j <= i)\n        such that `arr[j] < arr[k]`.\n        \"\"\"\n        dp = [arr[x] for x in range(i + 1)] # dp[j] stores max sum IS ending at arr[j] in arr[0...j]\n\n        for j in range(i + 1):\n            for t in range(j):\n                if arr[t] < arr[j]:\n                    dp[j] = max(dp[j], dp[t] + arr[j])\n\n        # Find the maximum dp[j] for elements arr[j] that are strictly less than arr[k]\n        max_prefix_sum_for_k = 0\n        for j in range(i + 1):\n            if arr[j] < arr[k]:\n                max_prefix_sum_for_k = max(max_prefix_sum_for_k, dp[j])\n\n        return max_prefix_sum_for_k\n\n    def max_sum_increasing_subseq(self, arr: list, n: int, i: int, k: int) -> int:\n        \"\"\"\n        Core computational method to find the maximum sum of an increasing subsequence\n        from arr[0...i] including arr[k] as the final element.\n        \"\"\"\n        target_value = arr[k]\n        \n        prefix_max_sum_val = self.computePrefixMax(arr, i, k)\n\n        # If no suitable prefix element was found (prefix_max_sum_val is 0,\n        # meaning no arr[j] < arr[k] yielded a positive dp sum),\n        # the result is just arr[k]. Otherwise, sum the prefix max and arr[k].\n        if prefix_max_sum_val == 0:\n            return target_value\n        else:\n            return prefix_max_sum_val + target_value\n\ndef max_sum_increasing_subseq(arr, n, i, k) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from prefix arr[0...i]\n    including arr[k] as the final element, where k > i.\n    \"\"\"\n    arr_obj = Array(arr)\n    indices_obj = Indices(n, i, k)\n    indices_obj.validate_n_equals_length(arr_obj.length())\n    indices_obj.validate_bounds_and_order()\n\n    calculator = SubsequenceCalculator()\n    result = calculator.max_sum_increasing_subseq(arr, n, i, k)\n\n    return result"}
{"task_id": "Mbpp/310", "solution": "import collections\n\n\nclass InputString:\n    \"\"\"Encapsulates input and validation semantics.\"\"\"\n    def __init__(self, raw: str):\n        self._raw = raw\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the raw input is a string.\"\"\"\n        return isinstance(self._raw, str)\n\n\nclass Character:\n    \"\"\"Value-object representing a single one-character string.\"\"\"\n    def __init__(self, value: str):\n        if not (isinstance(value, str) and len(value) == 1):\n            raise ValueError(\"Character must be a single character string.\")\n        self._value = value\n\n\nclass OutputTuple:\n    \"\"\"Holds assembled tuple and presents native tuple to callers.\"\"\"\n    def __init__(self, chars: tuple):\n        self._chars = chars\n\n    def as_tuple(self) -> tuple:\n        \"\"\"Returns the native tuple of one-character strings.\"\"\"\n        return self._chars\n\n\nclass StringToTupleService:\n    \"\"\"Stateless service implementing conversion logic from string to tuple of characters.\"\"\"\n    @staticmethod\n    def string_to_tuple(input_str: str) -> tuple:\n        \"\"\"Converts a string to a tuple of characters, excluding spaces.\"\"\"\n        input_obj = InputString(input_str)\n        if not input_obj.is_valid():\n            raise TypeError(\"Input must be a string.\")\n\n        filtered_chars = []\n        for char in input_str:\n            if char != ' ':\n                # Per design, Character objects are for domain clarity, but the output expects plain strings.\n                # Character(char) would validate, but directly adding char is simpler for this use.\n                filtered_chars.append(char)\n        \n        # This list of characters already satisfies the 'one-character string' requirement implicitly.\n        # It's then directly converted to a tuple.\n        output_obj = OutputTuple(tuple(filtered_chars))\n        return output_obj.as_tuple()\n\n\ndef string_to_tuple(input_str: str) -> tuple:\n    \"\"\"\n    Converts a given string to a tuple of characters, excluding spaces.\n    Delegates the conversion to StringToTupleService.\n    \"\"\"\n    return StringToTupleService.string_to_tuple(input_str)"}
{"task_id": "Mbpp/311", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass IntegerInput:\n    \"\"\"Simple typed container for the input integer n.\"\"\"\n    value: int\n\n@dataclass\nclass Result:\n    \"\"\"Simple typed container for the resulting integer value returned by the function.\"\"\"\n    value: int\n\nclass BitOperation:\n    \"\"\"Provides operations to locate the left-most unset bit and set a bit.\"\"\"\n\n    @staticmethod\n    def find_left_most_unset_bit(n: int) -> int:\n        \"\"\"\n        Returns 0-based bit index of the most significant unset bit in the minimal\n        binary representation. If all bits are set, returns index one greater.\n        \"\"\"\n        if n == 0:\n            return 0  # Bit 0 is the most significant unset bit for 0\n\n        # n.bit_length() gives the number of bits required to represent n,\n        # which means the index of the highest set bit is bit_length() - 1.\n        msb_index = n.bit_length() - 1\n\n        # Iterate from the most significant bit down to the least significant bit\n        for i in range(msb_index, -1, -1):\n            if not ((n >> i) & 1):  # If the i-th bit is 0 (unset)\n                return i\n\n        # If all bits from msb_index down to 0 are set, extend the width\n        return msb_index + 1\n\n    @staticmethod\n    def set_bit(n: int, pos: int) -> int:\n        \"\"\"Returns integer resulting from setting bit at position pos (0-based) in integer n.\"\"\"\n        return n | (1 << pos)\n\ndef set_left_most_unset_bit(n: int) -> int:\n    \"\"\"\n    Finds the most significant unset bit in the minimal binary representation of n,\n    sets that bit to 1, and returns the resulting integer.\n    \"\"\"\n    _ = IntegerInput(value=n)  # As per design, create IntegerInput instance\n    \n    pos = BitOperation.find_left_most_unset_bit(n)\n    new_value = BitOperation.set_bit(n, pos)\n    \n    result = Result(value=new_value) # As per design, package result\n    return result.value"}
{"task_id": "Mbpp/312", "solution": "import math\n\ndef volume_cone(radius, height) -> float:\n    \"\"\"\n    Calculates the volume of a right circular cone.\n    The formula used is V = (\u03c0 * radius^2 * height) / 3.\n    \"\"\"\n    volume = (math.pi * (radius ** 2) * height) / 3\n    return float(volume)"}
{"task_id": "Mbpp/388", "solution": "class HighestPowerOf2Function:\n    \"\"\"\n    Internal class encapsulating the computation logic for finding\n    the highest power of 2 less than or equal to a given number.\n    \"\"\"\n    name: str = \"highest_Power_of_2\"\n\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Computes the highest power of 2 less than or equal to n.\n        This uses bit manipulation for efficiency.\n        \"\"\"\n        return 1 << (n.bit_length() - 1)\n\ndef highest_Power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the highest power of 2 that is less than or equal to n.\n    It delegates the computation to an internal class.\n    \"\"\"\n    processor = HighestPowerOf2Function()\n    return processor.compute(n)"}
{"task_id": "Mbpp/389", "solution": "class InvalidInputException(Exception):\n    def __init__(self, message: str = None):\n        super().__init__(message)\n\nclass InputValidator:\n    def validateIntegerNonNegative(self, n):\n        if not isinstance(n, int) or n < 0:\n            raise InvalidInputException(f\"Input must be a non-negative integer, got {n}.\")\n\nclass LucasSequence:\n    def getValue(self, n):\n        if n == 0:\n            return 2\n        if n == 1:\n            return 1\n        \n        a, b = 2, 1  # L0, L1\n        for _ in range(2, n + 1):\n            a, b = b, a + b\n        return b\n\ndef find_lucas(n):\n    \"\"\"\n    Finds the n'th Lucas number.\n    It validates input and computes the number using an iterative approach.\n    \"\"\"\n    validator = InputValidator()\n    validator.validateIntegerNonNegative(n)\n\n    sequence = LucasSequence()\n    return sequence.getValue(n)"}
{"task_id": "Mbpp/390", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass Item:\n    \"\"\"Domain model of an input value convertible to string.\"\"\"\n    value: any\n\n    def to_string(self) -> str:\n        \"\"\"Returns the string representation of the item's value.\"\"\"\n        return str(self.value)\n\nclass FormatString:\n    \"\"\"Encapsulates a template string and provides apply(item) to perform substitution.\"\"\"\n    def __init__(self, template: str):\n        self.template = template\n\n    def apply(self, item: Item) -> str:\n        \"\"\"Substitutes all occurrences of '{0}' in the template with the string representation of the item.\"\"\"\n        return self.template.replace('{0}', item.to_string())\n\nclass OutputList:\n    \"\"\"Container representing the returned list of formatted strings.\"\"\"\n    def __init__(self):\n        self.elements = []\n\n    def append(self, element: str) -> None:\n        \"\"\"Appends a formatted string element to the internal list.\"\"\"\n        self.elements.append(element)\n\n    def to_list(self) -> list:\n        \"\"\"Returns a copy of the accumulated list of elements.\"\"\"\n        return list(self.elements)\n\ndef add_string(items, format_string):\n    \"\"\"Return a new list where for each element e in items the corresponding output element is\n    the format_string with all occurrences of {0} replaced by str(e).\"\"\"\n    if not items:\n        return []\n\n    formatter = FormatString(format_string)\n    output_list = OutputList()\n\n    for e in items:\n        item_obj = Item(e)\n        formatted_str = formatter.apply(item_obj)\n        output_list.append(formatted_str)\n\n    return output_list.to_list()"}
{"task_id": "Mbpp/391", "solution": "class ConvertListDictionary:\n    \"\"\"Encapsulates logic for validating and converting lists to a list of nested dictionaries.\"\"\"\n    def validateLengths(self, keys: list, names: list, values: list) -> None:\n        \"\"\"Validates that all inputs are lists and have equal length.\"\"\"\n        if not isinstance(keys, list) or not isinstance(names, list) or not isinstance(values, list):\n            raise TypeError(\"All inputs must be list instances\")\n        if not (len(keys) == len(names) == len(values)):\n            raise ValueError(\"Input lists must have equal length\")\n\n    def convert(self, keys: list, names: list, values: list) -> list:\n        \"\"\"Converts three parallel lists into a list of nested dictionaries.\"\"\"\n        self.validateLengths(keys, names, values)\n        n = len(keys)\n        result = []\n        for i in range(n):\n            nested = {names[i]: values[i]}\n            entry = {keys[i]: nested}\n            result.append(entry)\n        return result\n\ndef convert_list_dictionary(keys: list, names: list, values: list) -> list:\n    \"\"\"\n    Converts three parallel lists (keys, names, values) into a list of nested dictionaries.\n    Each output dictionary is of the form {keys[i]: {names[i]: values[i]}}.\n    \"\"\"\n    converter = ConvertListDictionary()\n    return converter.convert(keys, names, values)"}
