{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if two strings of parentheses can be concatenated in any order\n    to form a balanced parentheses string.\n    \"\"\"\n\n    def _validate_input(lst: list) -> None:\n        \"\"\"\n        Validates that the input is a list of exactly two strings,\n        and each string contains only '(' and ')' characters.\n        \"\"\"\n        if not isinstance(lst, list) or len(lst) != 2:\n            raise ValueError(\"Input must be a list containing exactly two strings.\")\n        for s in lst:\n            if not isinstance(s, str) or not all(c in '()' for c in s):\n                raise ValueError(\"Each element in the list must be a string consisting solely of '(' and ')' characters.\")\n\n    def _is_balanced(s: str) -> bool:\n        \"\"\"\n        Checks if a string of parentheses is balanced.\n        The balance must not drop below zero, and the final balance must be zero.\n        \"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    _validate_input(lst)\n\n    s1, s2 = lst[0], lst[1]\n\n    concat1 = s1 + s2\n    is_balanced1 = _is_balanced(concat1)\n\n    concat2 = s2 + s1\n    is_balanced2 = _is_balanced(concat2)\n\n    if is_balanced1 or is_balanced2:\n        return 'Yes'\n    else:\n        return 'No'"}
{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    \"\"\"\n    total_sum = 0\n    for i in range(len(lst)):\n        # Check if the current index is even\n        if i % 2 == 0:\n            element = lst[i]\n            # Check if the element at the even index is odd\n            if element % 2 != 0:\n                total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    def _has_at_most_two_digits(value):\n        \"\"\"Checks if an integer has an absolute value of at most two digits.\"\"\"\n        return abs(value) <= 99\n\n    total_sum = 0\n    # Iterate through the first k elements of the array\n    for i in range(k):\n        if _has_at_most_two_digits(arr[i]):\n            total_sum += arr[i]\n    return total_sum"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n    odd_numbers_set = set()\n    current_number = n\n\n    while current_number != 1:\n        if current_number % 2 != 0:\n            odd_numbers_set.add(current_number)\n\n        if current_number % 2 == 0:\n            current_number = current_number // 2\n        else:\n            current_number = 3 * current_number + 1\n\n    # Ensure 1 is always included as it's the termination point and an odd number.\n    odd_numbers_set.add(1)\n\n    sorted_odd_numbers = sorted(list(odd_numbers_set))\n    return sorted_odd_numbers"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    '''\n    import collections\n\n    # Validate non-negative integers as per design context (NFR1, BR1).\n    for num in lst:\n        if not isinstance(num, int) or num < 0:\n            return False\n\n    # Evaluate if list is sorted in ascending order (FR2, BR2).\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Evaluate duplicate count (FR3, BR3): no integer appears more than two times.\n    counts = collections.Counter(lst)\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    # If all checks pass, the list is valid (FR4).\n    return True"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"Validates a given date string against specific rules and format.\n    Returns True if the date is valid, False otherwise.\n    \"\"\"\n    if not date:\n        return False\n\n    if len(date) != 10 or date[2] != '-' or date[5] != '-':\n        return False\n\n    try:\n        month_str = date[0:2]\n        day_str = date[3:5]\n        year_str = date[6:10]\n\n        month = int(month_str)\n        day = int(day_str)\n        year = int(year_str)\n    except ValueError:\n        return False\n\n    # Rule 3: Validate month range\n    if not (1 <= month <= 12):\n        return False\n\n    # Rule 2: Validate day range based on month\n    if month in [1, 3, 5, 7, 8, 10, 12]:\n        if not (1 <= day <= 31):\n            return False\n    elif month in [4, 6, 9, 11]:\n        if not (1 <= day <= 30):\n            return False\n    elif month == 2:\n        # Note: The problem statement says up to 29 for February,\n        # it does not require leap year consideration, so we strictly follow that.\n        if not (1 <= day <= 29):\n            return False\n    else:\n        # This case should ideally be caught by month range check, but as a safeguard.\n        return False\n\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',', if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3\n    '''\n\n    def _has_whitespace(text: str) -> bool:\n        return any(c.isspace() for c in text)\n\n    def _has_comma(text: str) -> bool:\n        return ',' in text\n\n    def _split_by_whitespace(text: str) -> list[str]:\n        return text.split()\n\n    def _split_by_comma(text: str) -> list[str]:\n        return [word.strip() for word in text.split(',') if word.strip()]\n\n    def _count_odd_order_lowercase_letters(text: str) -> int:\n        count = 0\n        for char in text:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    count += 1\n        return count\n\n    if _has_whitespace(txt):\n        return _split_by_whitespace(txt)\n    elif _has_comma(txt):\n        return _split_by_comma(txt)\n    else:\n        return _count_odd_order_lowercase_letters(txt)"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"Determines if the length of the intersection of two intervals is a prime number.\n    Returns \"YES\" if prime, \"NO\" otherwise or if intervals don't intersect.\"\"\"\n\n    def _is_prime(n):\n        \"\"\"Checks if a non-negative integer is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    def _calculate_intersection_interval(interval1, interval2):\n        \"\"\"Calculates the intersection of two intervals.\"\"\"\n        start1, end1 = interval1\n        start2, end2 = interval2\n\n        intersection_start = max(start1, start2)\n        intersection_end = min(end1, end2)\n\n        return (intersection_start, intersection_end)\n\n    def _calculate_length(interval):\n        \"\"\"Calculates the length of an interval.\"\"\"\n        start, end = interval\n        return end - start\n\n    intersection_interval = _calculate_intersection_interval(interval1, interval2)\n\n    intersection_start, intersection_end = intersection_interval\n\n    if intersection_start > intersection_end:\n        return \"NO\"\n\n    length = _calculate_length(intersection_interval)\n\n    if _is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes multiplied by the product of signs for an array of integers.\n    Returns None for an empty array.\n    \"\"\"\n    def _get_sign(number):\n        \"\"\"Returns 1 for positive, -1 for negative, and 0 for zero.\"\"\"\n        if number > 0:\n            return 1\n        elif number < 0:\n            return -1\n        else:\n            return 0\n\n    def _get_magnitude(number):\n        \"\"\"Returns the absolute value of a number.\"\"\"\n        return abs(number)\n\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for number in arr:\n        product_of_signs *= _get_sign(number)\n        sum_of_magnitudes += _get_magnitude(number)\n\n    return product_of_signs * sum_of_magnitudes"}
{"task_id": "HumanEval/129", "solution": "class Cell:\n    \"\"\"Represents a cell in the grid with its coordinates and value.\"\"\"\n    def __init__(self, row: int, col: int, value: int):\n        self.row = row\n        self.col = col\n        self.value = value\n\n    def __eq__(self, other) -> bool:\n        if not isinstance(other, Cell):\n            return NotImplemented\n        return self.row == other.row and self.col == other.col and self.value == other.value\n\n    def __hash__(self) -> int:\n        return hash((self.row, self.col, self.value))\nclass Path:\n    \"\"\"Represents a path through the grid, tracking cells and their values.\"\"\"\n    def __init__(self, initial_cell: 'Cell' = None, values: list[int] = None):\n        self._cells: list[Cell] = []\n        self._values: list[int] = []\n\n        if initial_cell:\n            self.add_step(initial_cell)\n        elif values is not None:\n            self._values = list(values)\n\n    def add_step(self, cell: 'Cell'):\n        self._cells.append(cell)\n        self._values.append(cell.value)\n\n    def remove_last_step(self):\n        if self._cells:\n            self._cells.pop()\n            self._values.pop()\n\n    def get_values(self) -> list[int]:\n        return list(self._values)\n\n    def get_length(self) -> int:\n        return len(self._values)\n\n    def get_last_cell(self) -> 'Cell':\n        return self._cells[-1]\n\n    def is_lexicographically_less_than(self, other_path: 'Path') -> bool:\n        \"\"\"Compares two paths lexicographically.\"\"\"\n        for i in range(min(self.get_length(), other_path.get_length())):\n            if self._values[i] < other_path._values[i]:\n                return True\n            elif self._values[i] > other_path._values[i]:\n                return False\n        return False # If all common elements are equal, neither is strictly less, as lengths must be equal for final paths.\ndef _get_potential_neighbors(row: int, col: int) -> list[tuple[int, int]]:\n    \"\"\"Returns coordinates of potential neighbors without boundary checks.\"\"\"\n    return [\n        (row - 1, col), # Up\n        (row + 1, col), # Down\n        (row, col - 1), # Left\n        (row, col + 1)  # Right\n    ]\ndef _validate_grid_input(grid_data: list[list[int]]) -> int:\n    \"\"\"Validates grid dimensions and cell values.\"\"\"\n    N = len(grid_data)\n    # The problem guarantees N >= 2 and valid inputs, so extensive validation checks are not strictly needed.\n    return N\nclass Grid:\n    \"\"\"Represents the grid structure and provides access to cells and neighbors.\"\"\"\n    def __init__(self, grid_data: list[list[int]]):\n        self._N = _validate_grid_input(grid_data)\n        self._cells: list[list[Cell]] = []\n        for r in range(self._N):\n            row_cells = []\n            for c in range(self._N):\n                row_cells.append(Cell(r, c, grid_data[r][c]))\n            self._cells.append(row_cells)\n\n    def get_N(self) -> int:\n        return self._N\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        return self._cells[row][col]\n\n    def get_neighbors(self, row: int, col: int) -> list[Cell]:\n        \"\"\"Returns valid neighbor cells within grid boundaries.\"\"\"\n        neighbors: list[Cell] = []\n        potential_coords = _get_potential_neighbors(row, col)\n        for n_row, n_col in potential_coords:\n            if 0 <= n_row < self._N and 0 <= n_col < self._N:\n                neighbors.append(self.get_cell(n_row, n_col))\n        return neighbors\ndef minPath(grid: list[list[int]], k: int) -> list[int]:\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k,\n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n    N = _validate_grid_input(grid)\n    _validate_k_input(k, N)\n\n    grid_obj = Grid(grid)\n    min_path_values: list[int] = [float('inf')] * k # Initialize with a lexicographically large path\n\n    def _find_min_path_recursive(current_path: Path):\n        nonlocal min_path_values\n\n        if current_path.get_length() == k:\n            # Create a temporary Path object from min_path_values for comparison\n            if current_path.is_lexicographically_less_than(Path(values=min_path_values)):\n                min_path_values = current_path.get_values()\n            return\n\n        last_cell = current_path.get_last_cell()\n        neighbors = grid_obj.get_neighbors(last_cell.row, last_cell.col)\n\n        # Sort neighbors by value to explore smaller values first, improving efficiency for lexicographical search.\n        neighbors.sort(key=lambda cell: cell.value)\n\n        for neighbor_cell in neighbors:\n            current_path.add_step(neighbor_cell)\n            _find_min_path_recursive(current_path)\n            current_path.remove_last_step() # Backtrack\n\n    # Start DFS from every cell in the grid\n    for r in range(N):\n        for c in range(N):\n            start_cell = grid_obj.get_cell(r, c)\n            initial_path = Path(initial_cell=start_cell)\n            _find_min_path_recursive(initial_path)\n\n    return min_path_values"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    product_of_odds = 1\n    has_odd_digit = False\n\n    temp_n = n\n    while temp_n > 0:\n        digit = temp_n % 10\n        if digit % 2 != 0:  # Check if the digit is odd\n            product_of_odds *= digit\n            has_odd_digit = True\n        temp_n //= 10\n\n    return product_of_odds if has_odd_digit else 0"}
{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"Calculates the sum of squared numbers after rounding each element in the input list to its ceiling.\"\"\"\n    total_sum = 0\n    for num in lst:\n        rounded_num = math.ceil(num)\n        total_sum += rounded_num * rounded_num\n    return total_sum"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an alphabetical character\n    and is not part of a word (i.e., preceded by a space or is the only character).\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n    else:\n        char_before_last = txt[-2]\n        return char_before_last == ' '"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in\n    the last couple centuries. However, what people don\\'t know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8\n    You are given a non-negative integer number n, you have to a return a list of the\n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input n must be a non-negative integer.\")\n\n    _memo = {}\n\n    # Initialize base cases as per sequence definition and examples (tri(0) derived from example).\n    _memo[0] = 1\n    if n >= 1:\n        _memo[1] = 3\n\n    # Determine the maximum index needed for calculation, considering forward dependency for odd k.\n    # If n is odd, tri(n) requires tri(n+1), so calculation must go up to n+1. Otherwise, up to n.\n    max_k_to_calc = n if n % 2 == 0 else n + 1\n\n    # First pass: Calculate all even Tribonacci numbers up to max_k_to_calc.\n    # This ensures that tri(k+1) is available when needed for an odd tri(k) in the second pass.\n    for k in range(2, max_k_to_calc + 1):\n        if k % 2 == 0:\n            _memo[k] = 1 + k // 2 # Use integer division as implied by example outputs being integers.\n\n    # Second pass: Calculate all odd Tribonacci numbers (k > 1) up to max_k_to_calc.\n    # At this point, all required even numbers (k-1, k+1) are in _memo, and odd k-2 would also be handled correctly.\n    for k in range(2, max_k_to_calc + 1):\n        if k % 2 != 0:\n            _memo[k] = _memo[k - 1] + _memo[k - 2] + _memo[k + 1]\n\n    # Compile the final result list containing numbers from tri(0) to tri(n).\\\n    # Ensure all elements are integers as per problem description and examples.\n    result = []\n    for i in range(n + 1):\n        result.append(int(_memo[i]))\n\n    return result"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Create a function that takes a string as input which contains only square brackets.\n    The function should return True if and only if there is a valid subsequence of brackets\n    where at least one bracket in the subsequence is nested.\n\n    is_nested('[[]]') \u279e True\n    is_nested('[]]]]]]][[[[[]') \u279e False\n    is_nested('[][]') \u279e False\n    is_nested('[]') \u279e False\n    is_nested('[[][]]') \u279e True\n    is_nested('[[]][[') \u279e True\n    '''\n    idx_double_open = string.find('[[')\n    if idx_double_open == -1:\n        return False\n\n    # Search for ']]' starting from after the '[['\n    # The +2 ensures that ']]' comes strictly after '[[', implying at least one character could be between them,\n    # or that the ']]' starts after the ']]' part of '[[...]]'\n    idx_double_close = string.find(']]', idx_double_open + 2)\n\n    return idx_double_close != -1"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n    '''\n    largest_neg = None\n    smallest_pos = None\n\n    for number in lst:\n        if number < 0:\n            if largest_neg is None or number > largest_neg:\n                largest_neg = number\n        elif number > 0:\n            if smallest_pos is None or number < smallest_pos:\n                smallest_pos = number\n\n    return (largest_neg, smallest_pos)"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Finds the largest index where an element is strictly less than its predecessor.\n    Returns -1 if no such element is found.\"\"\"\n    largest_idx = -1\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            largest_idx = i\n    return largest_idx"}
{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Compares two values (int, float, or string representations of numbers) and returns the larger,\n    preserving its original type. Returns None if the values are numerically equal.\n    \"\"\"\n    def _normalize_to_float(value):\n        \"\"\"Converts a value (int, float, or string) to its float representation, handling comma decimals.\"\"\"\n        if isinstance(value, (int, float)):\n            return float(value)\n        elif isinstance(value, str):\n            return float(value.replace(',', '.'))\n        return None # Should not happen based on problem description but included for completeness\n\n    normalized_a = _normalize_to_float(a)\n    normalized_b = _normalize_to_float(b)\n\n    if normalized_a > normalized_b:\n        return a\n    elif normalized_b > normalized_a:\n        return b\n    else:\n        return None"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers\n    Example\n    is_equal_to_sum_even(4) == False\n    is_equal_to_sum_even(6) == False\n    is_equal_to_sum_even(8) == True\n    \"\"\"\n    if n < 8:\n        return False\n    if n % 2 != 0:\n        return False\n    return True"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n    \"\"\"\n    processed_text = re.sub(r' {3,}', '-', text)\n    final_text = processed_text.replace(' ', '_')\n    return final_text"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    special_fact_result = 1\n    current_factorial_val = 1 # This variable will store i!\n\n    for i in range(1, n + 1):\n        current_factorial_val *= i # Calculate i!\n        special_fact_result *= current_factorial_val # Multiply by i!\n\n    return special_fact_result"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n\n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for index, value in enumerate(lst):\n        processed_value = value\n        if index % 3 == 0:\n            processed_value = value * value\n        elif index % 4 == 0:\n            processed_value = value * value * value\n\n        total_sum += processed_value\n\n    return total_sum"}
{"task_id": "HumanEval/141", "solution": "class FileName:\n    \"\"\"Represents a file's full name and provides access to its parts.\"\"\"\n    def __init__(self, full_path: str):\n        self._full_path = full_path\n        self._name_part = \"\"\n        self._extension_part = \"\"\n        self._split_name()\n\n    def _split_name(self):\n        \"\"\"Internal method to split the full path into name and extension parts.\"\"\"\n        if '.' in self._full_path:\n            parts = self._full_path.rsplit('.', 1)\n            self._name_part = parts[0]\n            self._extension_part = parts[1]\n        else:\n            self._name_part = self._full_path\n            self._extension_part = \"\"\n\n    def get_full_path(self) -> str:\n        \"\"\"Returns the complete file name string.\"\"\"\n        return self._full_path\n\n    def get_name_part(self) -> str:\n        \"\"\"Returns the part of the file name before the last dot.\"\"\"\n        return self._name_part\n\n    def get_extension_part(self) -> str:\n        \"\"\"Returns the part of the file name after the last dot.\"\"\"\n        return self._extension_part\nclass ValidationResult:\n    \"\"\"Stores the final validation status ('Yes' or 'No').\"\"\"\n    def __init__(self, is_valid: bool):\n        self._status = 'Yes' if is_valid else 'No'\n\n    def get_status(self) -> str:\n        \"\"\"Returns 'Yes' if valid, 'No' otherwise.\"\"\"\n        return self._status\nclass ValidationRule(object): # Using object instead of ABC for simplicity as ABC needs import abc\n    \"\"\"Abstract base class for file name validation rules.\"\"\"\n    def is_valid(self, file_name: FileName) -> bool:\n        \"\"\"Checks if the given FileName is valid according to this rule.\"\"\"\n        raise NotImplementedError\nclass DigitCountRule(ValidationRule):\n    \"\"\"Validates that the file name contains no more than three digits.\"\"\"\n    MAX_DIGITS = 3\n\n    def is_valid(self, file_name: FileName) -> bool:\n        digit_count = sum(1 for char in file_name.get_full_path() if char.isdigit())\n        return digit_count <= self.MAX_DIGITS\nclass SingleDotRule(ValidationRule):\n    \"\"\"Validates that the file name contains exactly one dot.\"\"\"\n    def is_valid(self, file_name: FileName) -> bool:\n        return file_name.get_full_path().count('.') == 1\nclass NonEmptyNamePartRule(ValidationRule):\n    \"\"\"Validates that the substring before the dot is not empty.\"\"\"\n    def is_valid(self, file_name: FileName) -> bool:\n        if '.' in file_name.get_full_path():\n            return bool(file_name.get_name_part())\n        return True\nclass NamePartStartLetterRule(ValidationRule):\n    \"\"\"Validates that the substring before the dot starts with a latin alphabet letter.\"\"\"\n    def is_valid(self, file_name: FileName) -> bool:\n        name_part = file_name.get_name_part()\n        if not name_part:\n            return False\n        first_char = name_part[0]\n        return 'a' <= first_char <= 'z' or 'A' <= first_char <= 'Z'\nclass ValidExtensionRule(ValidationRule):\n    \"\"\"Validates that the substring after the dot is one of 'txt', 'exe', or 'dll'.\"\"\"\n    ALLOWED_EXTENSIONS = ['txt', 'exe', 'dll']\n\n    def is_valid(self, file_name: FileName) -> bool:\n        extension = file_name.get_extension_part()\n        if not extension:\n            return False\n        return extension.lower() in self.ALLOWED_EXTENSIONS\nclass FileNameValidator:\n    \"\"\"Orchestrates the application of multiple ValidationRule instances to a FileName.\"\"\"\n    def __init__(self, rules): # Removed List[ValidationRule] type hint as it needs typing.List\n        self._rules = rules\n\n    def validate(self, file_name: FileName) -> ValidationResult:\n        \"\"\"Applies all configured rules to the given FileName and returns the combined result.\"\"\"\n        for rule in self._rules:\n            if not rule.is_valid(file_name):\n                return ValidationResult(False)\n        return ValidationResult(True)\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions\n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from\n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n    file_name_obj = FileName(file_name)\n\n    rules = [\n        DigitCountRule(),\n        SingleDotRule(),\n        NonEmptyNamePartRule(),\n        NamePartStartLetterRule(),\n        ValidExtensionRule()\n    ]\n\n    validator = FileNameValidator(rules)\n\n    result = validator.validate(file_name_obj)\n\n    return result.get_status()"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    \"\"\"Represents a fraction and provides methods for parsing, multiplication, and checking if it represents a whole number.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        self._numerator = numerator\n        self._denominator = denominator\n\n    @staticmethod\n    def parse(fraction_string: str) -> 'Fraction':\n        \"\"\"Parses a string like \"num/den\" into a Fraction object.\"\"\"\n        parts = fraction_string.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return Fraction(numerator, denominator)\n\n    def multiply(self, other_fraction: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another fraction and returns the product as a new Fraction object.\"\"\"\n        new_numerator = self._numerator * other_fraction._numerator\n        new_denominator = self._denominator * other_fraction._denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Determines if the fraction represents a whole number.\"\"\"\n        return self._numerator % self._denominator == 0\nclass Simplifier:\n    \"\"\"Provides the public simplify function to process two fraction strings and determine if their product is a whole number.\"\"\"\n    @staticmethod\n    def simplify(x: str, n: str) -> bool:\n        \"\"\"Parses two fraction strings, multiplies them, and checks if the product is a whole number.\"\"\"\n        fraction_x = Fraction.parse(x)\n        fraction_n = Fraction.parse(n)\n        product_fraction = fraction_x.multiply(fraction_n)\n        return product_fraction.is_whole_number()\ndef simplify(x, n):\n    \"\"\"Checks if the product of two fractional string inputs evaluates to a whole number.\n    Uses an internal Fraction and Simplifier class for modularity.\"\"\"\n    return Simplifier.simplify(x, n)"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words in a sentence, returning only those with prime lengths.\n    Helper function `_is_prime` checks if a number is prime.\n    \"\"\"\n    def _is_prime(n):\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.split()\n    result_words = []\n    for word in words:\n        if _is_prime(len(word)):\n            result_words.append(word)\n\n    return \" \".join(result_words)"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"\n    Counts elements in an array that are greater than 10 and have odd first and last digits.\n    Helper functions are used for digit extraction and oddness checks.\n    \"\"\"\n\n    def _get_first_digit(number):\n        \"\"\"Extracts the first digit of an integer (absolute value).\"\"\"\n        number = abs(number)\n        if number == 0:\n            return 0\n        while number >= 10:\n            number //= 10\n        return number\n\n    def _get_last_digit(number):\n        \"\"\"Extracts the last digit of an integer (absolute value).\"\"\"\n        return abs(number) % 10\n\n    def _is_odd(digit):\n        \"\"\"Checks if a given digit is odd.\"\"\"\n        return digit % 2 != 0\n\n    count = 0\n    for num in nums:\n        if num > 10:\n            first_digit = _get_first_digit(num)\n            last_digit = _get_last_digit(num)\n            if _is_odd(first_digit) and _is_odd(last_digit):\n                count += 1\n    return count"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Write a function which sorts the given list of integers\n    in ascending order according to the sum of their digits.\n    Note: if there are several items with similar sum of their digits,\n    order them based on their index in original list.\n\n    For example:\n    >>> order_by_points([1, 11, -1, -11, -12]) == [-1, -11, 1, -12, 11]\n    >>> order_by_points([]) == []\n    \"\"\"\n\n    def _calculate_sum_of_absolute_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the absolute values of digits for a given integer.\"\"\"\n        return sum(int(digit) for digit in str(abs(n)))\n\n    if not nums:\n        return []\n\n    # Pair each number with its calculated sum of absolute digits.\n    # The design specifies sorting primarily by digit_sum and secondarily by num's value.\n    decorated_nums = []\n    for num in nums:\n        digit_sum = _calculate_sum_of_absolute_digits(num)\n        decorated_nums.append((digit_sum, num))\n\n    # Sort the decorated list based on (digit_sum, num).\n    # Python's tuple sorting naturally uses elements as primary, secondary, etc., keys in ascending order.\n    decorated_nums.sort()\n\n    # Extract the original numbers from the sorted decorated list.\n    return [item[1] for item in decorated_nums]"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    class Planet:\n        def __init__(self, name: str, order: int):\n            self.name = name\n            self.order = order\n\n    _PLANETS_DATA = [\n        Planet(\"Mercury\", 0),\n        Planet(\"Venus\", 1),\n        Planet(\"Earth\", 2),\n        Planet(\"Mars\", 3),\n        Planet(\"Jupiter\", 4),\n        Planet(\"Saturn\", 5),\n        Planet(\"Uranus\", 6),\n        Planet(\"Neptune\", 7),\n    ]\n\n    planet_names = [p.name for p in _PLANETS_DATA]\n\n    if planet1 not in planet_names or planet2 not in planet_names:\n        return ()\n\n    idx1 = planet_names.index(planet1)\n    idx2 = planet_names.index(planet2)\n\n    if idx1 == idx2:\n        return ()\n\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    # Slice the list to get planets between the two, excluding the endpoints\n    intermediate_planets = _PLANETS_DATA[start_idx + 1:end_idx]\n\n    return tuple(p.name for p in intermediate_planets)"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"\n    Deletes strings with odd lengths from a list, then sorts the remaining strings.\n    The list is sorted first by length (ascending), then alphabetically (ascending) for ties.\n    \"\"\"\n\n    def _filter_odd_length_strings(strings_list):\n        \"\"\"Filters a list of strings, retaining only those with even lengths.\"\"\"\n        return [s for s in strings_list if len(s) % 2 == 0]\n\n    def _sort_strings(strings_list):\n        \"\"\"Sorts a list of strings by length (ascending) then alphabetically (ascending).\"\"\"\n        return sorted(strings_list, key=lambda s: (len(s), s))\n\n    filtered_list = _filter_odd_length_strings(lst)\n    sorted_result = _sort_strings(filtered_list)\n    return sorted_result"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"Returns the value of x if n is a prime number and returns the value of y otherwise.\"\"\"\n\n    def _is_prime(num: int) -> bool:\n        \"\"\"Checks if a number is prime.\"\"\"\n        if num <= 1:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    if _is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on the difference between uppercase and lowercase letters.\n    Returns the class name concatenated with the strongest extension name.\n    \"\"\"\n\n    # Initialize with the first extension's strength and name\n    strongest_extension_name = extensions[0]\n\n    # Calculate strength for the first extension\n    cap_initial = sum(1 for char in strongest_extension_name if char.isupper())\n    sm_initial = sum(1 for char in strongest_extension_name if char.islower())\n    max_strength = cap_initial - sm_initial\n\n    # Iterate through the rest of the extensions to find the strongest one\n    for i in range(1, len(extensions)):\n        current_extension = extensions[i]\n\n        # Calculate CAP and SM for the current extension\n        cap_current = sum(1 for char in current_extension if char.isupper())\n        sm_current = sum(1 for char in current_extension if char.islower())\n        current_strength = cap_current - sm_current\n\n        # If current extension is stronger, update max_strength and strongest_extension_name\n        # If strengths are equal, the one that came first in the list is kept (due to \">\" comparison)\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = current_extension\n\n    # Return the result in the specified format\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/151", "solution": "class NumberElement:\n    \"\"\"\n    Encapsulates a single number and provides methods to check its properties.\n    \"\"\"\n    def __init__(self, value: any):\n        self._value = value\n\n    def is_integer(self) -> bool:\n        \"\"\"Checks if the value is an integer.\"\"\"\n        return isinstance(self._value, int)\n\n    def is_positive(self) -> bool:\n        \"\"\"Checks if the value is positive (> 0).\"\"\"\n        return self._value > 0\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the value is odd.\"\"\"\n        return self._value % 2 != 0\n\n    def get_square(self) -> int:\n        \"\"\"Returns the square of the value.\"\"\"\n        return self._value * self._value\nclass InputList:\n    \"\"\"\n    Manages a collection of NumberElement objects.\n    \"\"\"\n    def __init__(self, raw_list: list):\n        self._elements = [NumberElement(item) for item in raw_list]\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the list of elements is empty.\"\"\"\n        return not self._elements\n\n    def get_elements(self) -> list[NumberElement]:\n        \"\"\"Returns the list of NumberElement objects.\"\"\"\n        return self._elements\nclass SumOfSquaresCalculator:\n    \"\"\"\n    Orchestrates the filtering, squaring, and summing process.\n    \"\"\"\n    def __init__(self, input_list: InputList):\n        self._input_list = input_list\n\n    def calculate_sum(self) -> int:\n        \"\"\"Performs the core logic: filters, squares, and sums.\"\"\"\n        if self._input_list.is_empty():\n            return 0\n\n        total_sum = 0\n        for element in self._input_list.get_elements():\n            if element.is_integer() and element.is_positive() and element.is_odd():\n                total_sum += element.get_square()\n        return total_sum\ndef double_the_difference(lst: list) -> int:\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n\n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0\n\n    If the input list is empty, return 0.\n    '''\n    input_list = InputList(lst)\n    calculator = SumOfSquaresCalculator(input_list)\n    return calculator.calculate_sum()"}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"I think we all remember that feeling when the result of some long-awaited\n    event is finally known. The feelings and thoughts you have at that moment are\n    definitely worth noting down and comparing.\n    Your task is to determine if a person correctly guessed the results of a number of matches.\n    You are given two arrays of scores and guesses of equal length, where each index shows a match.\n    Return an array of the same length denoting how far off each guess was. If they have guessed correctly,\n    the value is 0, and if not, the value is the absolute difference between the guess and the score.\n\n\n    example:\n\n    compare([1,2,3,4,5,1],[1,2,3,4,2,-2]) -> [0,0,0,0,3,3]\n    compare([0,5,0,0,0,4],[4,1,1,0,0,-2]) -> [4,4,1,0,0,6]\n    \"\"\"\n    differences = []\n    for i in range(len(game)):\n        current_game_score = game[i]\n        current_guess_score = guess[i]\n        if current_game_score == current_guess_score:\n            diff = 0\n        else:\n            diff = abs(current_game_score - current_guess_score)\n        differences.append(diff)\n    return differences"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from an array 'a' where a[x] = x*x - x + 1,\n    such that i < j < k and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    def _validate_input(n_val):\n        \"\"\"Validates that n is a positive integer.\"\"\"\n        if not isinstance(n_val, int) or n_val <= 0:\n            raise ValueError(\"n must be a positive integer.\")\n\n    def _calculate_element_value(i_val):\n        \"\"\"Calculates the value of an array element a[i] using the formula i * i - i + 1.\"\"\"\n        return i_val * i_val - i_val + 1\n\n    def _generate_array_a(n_val):\n        \"\"\"Creates and populates the integer array 'a' of length 'n'.\"\"\"\n        arr = [0] * n_val\n        for i_val in range(1, n_val + 1):\n            arr[i_val - 1] = _calculate_element_value(i_val)\n        return arr\n\n    def _is_sum_multiple_of_3(val1, val2, val3):\n        \"\"\"Checks if the sum of three given integer values is a multiple of 3.\"\"\"\n        return (val1 + val2 + val3) % 3 == 0\n\n    def _count_valid_triples(arr):\n        \"\"\"Iterates through all possible triples and counts those whose sum is a multiple of 3.\"\"\"\n        count = 0\n        length = len(arr)\n        for i_idx in range(length - 2):\n            for j_idx in range(i_idx + 1, length - 1):\n                for k_idx in range(j_idx + 1, length):\n                    if _is_sum_multiple_of_3(arr[i_idx], arr[j_idx], arr[k_idx]):\n                        count += 1\n        return count\n\n    _validate_input(n)\n    array_a = _generate_array_a(n)\n    return _count_valid_triples(array_a)"}
{"task_id": "HumanEval/154", "solution": "def _generate_rotations(s):\n    \"\"\"Generates all cyclic rotations of a string.\"\"\"\n    n = len(s)\n    if n == 0:\n        return [\"\"]\n    rotations = set()\n    s_double = s + s\n    for i in range(n):\n        rotations.add(s_double[i : i + n])\n    return list(rotations)\ndef _is_substring(main_string, sub_string):\n    \"\"\"Checks if a sub_string exists within a main_string.\"\"\"\n    return sub_string in main_string\ndef cycpattern_check(a , b):\n    \"\"\"Checks if the second word or any of its rotations is a substring in the first word.\"\"\"\n    if len(b) > len(a) and len(a) > 0: # An optimization for when b is longer than a, but not when a is empty.\n        return False\n\n    # If b is empty, it's a substring of any string a (including empty a).\n    # If a is empty, an empty b is its only substring. Any non-empty b cannot be a substring.\n    if not b:\n        return True\n    if not a and b:\n        return False\n\n    rotations_of_b = _generate_rotations(b)\n    for rotation in rotations_of_b:\n        if _is_substring(a, rotation):\n            return True\n    return False"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Convert num to its absolute value and then to a string to iterate through digits.\n    abs_num_str = str(abs(num))\n\n    for digit_char in abs_num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    # Module-level constant for Roman numeral mapping\n    # This list is ordered from largest to smallest to facilitate the greedy conversion algorithm.\n    _ROMAN_MAP = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'),\n        (1, 'I')\n    ]\n\n    # Input validation for range 1 to 1000\n    if not (1 <= number <= 1000):\n        raise ValueError(\"Input number must be between 1 and 1000, inclusive.\")\n\n    roman_numeral = []\n    temp_num = number\n\n    # Convert integer to Roman numeral\n    for value, symbol in _ROMAN_MAP:\n        while temp_num >= value:\n            roman_numeral.append(symbol)\n            temp_num -= value\n\n    # Return Roman numeral in lowercase as a string\n    return \"\".join(roman_numeral).lower()"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n\n    # Epsilon for floating point comparison to account for precision issues.\n    epsilon = 1e-9\n\n    # Validate that all side lengths are positive.\n    if a <= 0 or b <= 0 or c <= 0:\n        raise ValueError(\"Side lengths must be positive numbers.\")\n\n    a_sq = a * a\n    b_sq = b * b\n    c_sq = c * c\n\n    # Check all three permutations of the Pythagorean theorem.\n    if abs(a_sq + b_sq - c_sq) < epsilon:\n        return True\n    if abs(b_sq + c_sq - a_sq) < epsilon:\n        return True\n    if abs(a_sq + c_sq - b_sq) < epsilon:\n        return True\n\n    return False"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Return the word with the maximum number of unique characters.\n    If multiple strings have maximum unique characters, return the one that comes first lexicographically.\n    \"\"\"\n\n    def _count_unique_chars(s):\n        \"\"\"Calculates the number of unique characters in a given string.\"\"\"\n        return len(set(s))\n\n    if not words:\n        return \"\"\n\n    best_string_found = words[0]\n    max_unique_count = _count_unique_chars(words[0])\n\n    for i in range(1, len(words)):\n        current_word = words[i]\n        current_unique_count = _count_unique_chars(current_word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            best_string_found = current_word\n        elif current_unique_count == max_unique_count:\n            # Tie-breaking: if counts are equal, prefer the lexicographically smaller word\n            if current_word < best_string_found:\n                best_string_found = current_word\n\n    return best_string_found"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n\n    Example:\n    * eat(5, 6, 10) -> [11, 4]\n    * eat(4, 8, 9) -> [12, 1]\n    * eat(1, 10, 10) -> [11, 0]\n    * eat(2, 11, 5) -> [7, 0]\n\n    Variables:\n    @number : integer\n        the number of carrots that you have eaten.\n    @need : integer\n        the number of carrots that you need to eat.\n    @remaining : integer\n        the number of remaining carrots thet exist in stock\n\n    Constrain:\n    * 0 <= number <= 1000\n    * 0 <= need <= 1000\n    * 0 <= remaining <= 1000\n\n    Have fun :)\n    \"\"\"\n    # Determine how many carrots the rabbit can eat in this meal, limited by need and remaining stock.\n    carrots_eaten_this_meal = min(need, remaining)\n\n    # Calculate the total carrots eaten and the remaining stock after the meal.\n    total_eaten_carrots = number + carrots_eaten_this_meal\n    carrots_left = remaining - carrots_eaten_this_meal\n\n    return [total_eaten_carrots, carrots_left]"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"\n    Processes the input string s. If s contains no letters, it reverses the string.\n    Otherwise, it iterates through s, converting letters' cases and keeping non-letters unchanged.\n    \"\"\"\n\n    def _has_letters(s):\n        \"\"\"Checks if a string contains any alphabetic characters.\"\"\"\n        for char in s:\n            if char.isalpha():\n                return True\n        return False\n\n    def _toggle_case_char(char):\n        \"\"\"Toggles the case of a single character if it is a letter, otherwise returns it unchanged.\"\"\"\n        if char.isalpha():\n            return char.swapcase()\n        return char\n\n    if not _has_letters(s):\n        return s[::-1]\n    else:\n        result_chars = []\n        for char in s:\n            result_chars.append(_toggle_case_char(char))\n        return \"\".join(result_chars)"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand, build and evaluate an algebraic expression.\n    \"\"\"\n\n    def _validate_inputs(operator_list, operand_list):\n        \"\"\"Checks input lists for length constraints, non-negative operands, and supported operators.\"\"\"\n        supported_operators = {'+', '-', '*', '//', '**'}\n\n        if len(operand_list) < 2:\n            raise ValueError(\"Operand list must contain at least two operands.\")\n        if len(operator_list) != len(operand_list) - 1:\n            raise ValueError(\"Length of operator list must be one less than operand list.\")\n\n        for op in operator_list:\n            if op not in supported_operators:\n                raise ValueError(f\"Unsupported operator: {op}\")\n\n        for val in operand_list:\n            if val < 0:\n                raise ValueError(\"Operand values must be non-negative.\")\n\n    def _build_expression_string(operator_list, operand_list):\n        \"\"\"Constructs the algebraic expression string by interleaving operands and operators.\"\"\"\n        expression_parts = [str(operand_list[0])]\n        for i in range(len(operator_list)):\n            expression_parts.append(operator_list[i])\n            expression_parts.append(str(operand_list[i+1]))\n        return \" \".join(expression_parts)\n\n    def _evaluate_expression(expression_string):\n        \"\"\"Evaluates the given algebraic expression string.\"\"\"\n        return eval(expression_string)\n\n    _validate_inputs(operator, operand)\n    expression = _build_expression_string(operator, operand)\n    result = _evaluate_expression(expression)\n    return result"}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    md5_hash = hashlib.md5(text.encode('utf-8')).hexdigest()\n    return md5_hash"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n\n    def _determine_effective_range(x, y):\n        \"\"\"Determines the lower and upper bounds of the inclusive range.\"\"\"\n        return min(x, y), max(x, y)\n\n    def _is_even_single_digit(number):\n        \"\"\"Checks if a number is one of the target even, single-digit numbers.\"\"\"\n        return number in {2, 4, 6, 8}\n\n    min_val, max_val = _determine_effective_range(a, b)\n    results = []\n\n    for number in range(min_val, max_val + 1):\n        if _is_even_single_digit(number):\n            results.append(number)\n\n    return sorted(results)"}
{"task_id": "HumanEval/3", "solution": "from typing import List\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    balance = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False"}
