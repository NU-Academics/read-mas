{"task_id": "Mbpp/463", "solution": "from typing import List\ndef max_subarray_product(array: List[int]) -> int:\n    \"\"\"\n    Finds the maximum product of a contiguous subarray in the given array.\n    This uses O(n) time and O(1) space complexity.\n    \"\"\"\n    if not array:\n        return 0\n\n    max_so_far = array[0]\n    current_max_product = array[0]\n    current_min_product = array[0]\n\n    for i in range(1, len(array)):\n        num = array[i]\n\n        # If current number is negative, then max and min product roles flip.\n        # Swap current_max_product and current_min_product.\n        if num < 0:\n            current_max_product, current_min_product = current_min_product, current_max_product\n\n        # Update current_max_product and current_min_product for the current number.\n        current_max_product = max(num, current_max_product * num)\n        current_min_product = min(num, current_min_product * num)\n\n        # Update the overall maximum product found so far.\n        max_so_far = max(max_so_far, current_max_product)\n\n    return max_so_far"}
{"task_id": "Mbpp/468", "solution": "def max_product(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of an increasing subsequence.\n    Uses dynamic programming to track the maximum product ending at each position.\n    \"\"\"\n    n = len(numbers)\n    if n == 0:\n        return 0\n\n    # dp[i] stores the maximum product of an increasing subsequence ending with numbers[i].\n    dp = [0] * n\n\n    # Initialize max_overall_product with the first element, as it's a valid single-element subsequence.\n    max_overall_product = numbers[0]\n\n    for i in range(n):\n        # A single element numbers[i] is an increasing subsequence.\n        dp[i] = numbers[i]\n        for j in range(i):\n            # If numbers[i] can extend the increasing subsequence ending at numbers[j].\n            if numbers[i] > numbers[j]:\n                dp[i] = max(dp[i], dp[j] * numbers[i])\n        \n        # Update the global maximum product found so far.\n        max_overall_product = max(max_overall_product, dp[i])\n\n    return max_overall_product"}
{"task_id": "Mbpp/470", "solution": "from typing import Tuple, Union\nNumeric = Union[int, float]\ndef add_pairwise(input_tuple: Tuple[Numeric, ...]) -> Tuple[Numeric, ...]:\n    \"\"\"\n    Computes the pairwise sum of adjacent elements in a numeric tuple.\n    Raises TypeError if any element is not an int or float.\n    \"\"\"\n    for idx, value in enumerate(input_tuple):\n        if not isinstance(value, (int, float)):\n            raise TypeError(f\"Element at index {idx} is not numeric: {value!r}\")\n\n    if len(input_tuple) < 2:\n        return ()\n\n    result = tuple(input_tuple[i] + input_tuple[i + 1] for i in range(len(input_tuple) - 1))\n    return result"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(array: List[int], n: int) -> int:\n    \"\"\"\n    Compute the product of all elements in `array` modulo `n`.\n\n    Parameters\n    ----------\n    array : List[int]\n        List of integers to multiply.\n    n : int\n        Positive integer modulus.\n\n    Returns\n    -------\n    int\n        The remainder of the product divided by `n`.\n\n    Notes\n    -----\n    - If `array` is empty, returns 0.\n    - Handles negative numbers by using Python's modulo semantics.\n    - For `n == 1`, returns 0 (since any number mod 1 is 0).\n    \"\"\"\n    if n == 1:\n        return 0\n    if not array:\n        return 0\n\n    result = 1\n    for value in array:\n        result = (result * (value % n)) % n\n    return result"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(numbers: list) -> bool:\n    \"\"\"Checks if a list contains consecutive numbers using an inline helper class.\"\"\"\n    class NumberList:\n        def __init__(self, numbers_list: list):\n            self.numbers = numbers_list\n\n        def isConsecutive(self) -> bool:\n            \"\"\"Determines if the numbers in the list are consecutive.\"\"\"\n            if len(self.numbers) <= 1:\n                return True\n            for i in range(1, len(self.numbers)):\n                if self.numbers[i] != self.numbers[i-1] + 1:\n                    return False\n            return True\n\n    number_list_instance = NumberList(numbers)\n    return number_list_instance.isConsecutive()"}
{"task_id": "Mbpp/473", "solution": "def tuple_intersection(list1, list2):\n    \"\"\"\n    Finds the intersection of elements in two lists of tuples, ignoring the order of elements within each tuple.\n    Tuples are normalized by sorting their elements before comparison.\n    \"\"\"\n    normalized_set1 = set()\n    for tpl in list1:\n        normalized_set1.add(tuple(sorted(tpl)))\n\n    intersection_set = set()\n    for tpl in list2:\n        normalized_tpl = tuple(sorted(tpl))\n        if normalized_tpl in normalized_set1:\n            intersection_set.add(normalized_tpl)\n\n    return intersection_set"}
