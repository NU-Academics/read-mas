{"task_id": "Mbpp/56", "solution": "def check(number: int) -> bool:\n    \"\"\"Checks if a number is one less than twice its reverse.\"\"\"\n    class Number:\n        def __init__(self, value: int):\n            self.value = value\n\n        def reverse(self) -> int:\n            \"\"\"Calculates the reverse of the number, handling its sign.\"\"\"\n            sign = -1 if self.value < 0 else 1\n            abs_value = abs(self.value)\n            reversed_abs = int(str(abs_value)[::-1])\n            return sign * reversed_abs\n\n        def isOneLessThanTwiceReverse(self) -> bool:\n            \"\"\"Determines if the number is one less than twice its reverse.\"\"\"\n            return self.value == 2 * self.reverse() - 1\n\n    num_entity = Number(number)\n    return num_entity.isOneLessThanTwiceReverse()"}
