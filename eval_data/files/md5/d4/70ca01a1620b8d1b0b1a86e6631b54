{"task_id": "Mbpp/259", "solution": "from typing import Tuple\ndef maximize_elements(\n    tuple1: Tuple[Tuple[int, ...], ...],\n    tuple2: Tuple[Tuple[int, ...], ...]\n) -> Tuple[Tuple[int, ...], ...]:\n    \"\"\"\n    Return a new tuple of tuples containing the element\u2011wise maximum\n    of the corresponding inner tuples from tuple1 and tuple2.\n    \"\"\"\n    def _validate_tuples(\n        t1: Tuple[Tuple[int, ...], ...],\n        t2: Tuple[Tuple[int, ...], ...]\n    ) -> None:\n        \"\"\"\n        Validate that both tuples have the same length and that each\n        corresponding inner tuple has the same length.\n        \"\"\"\n        if len(t1) != len(t2):\n            raise ValueError(\"Outer tuples must have the same length.\")\n        for idx, (inner1, inner2) in enumerate(zip(t1, t2)):\n            if len(inner1) != len(inner2):\n                raise ValueError(\n                    f\"Inner tuple at index {idx} has mismatched length.\"\n                )\n\n    _validate_tuples(tuple1, tuple2)\n\n    result = tuple(\n        tuple(max(a, b) for a, b in zip(inner1, inner2))\n        for inner1, inner2 in zip(tuple1, tuple2)\n    )\n    return result"}
{"task_id": "Mbpp/260", "solution": "class PrimeNumber:\n    def __init__(self, value: int, index: int):\n        self.value = value\n        self.index = index\nclass NewmanShanksWilliamsPrimeCalculator:\n    def newman_prime(self, n: int) -> PrimeNumber:\n        \"\"\"Computes the N-th Newman-Shanks-Williams number S_n using its recurrence.\"\"\"\n        if n == 0:\n            return PrimeNumber(1, 0)\n        if n == 1:\n            return PrimeNumber(1, 1)\n\n        s_prev2 = 1  # Represents S_0\n        s_prev1 = 1  # Represents S_1\n\n        for _ in range(2, n + 1):\n            s_current = 2 * s_prev1 + s_prev2\n            s_prev2 = s_prev1\n            s_prev1 = s_current\n        \n        return PrimeNumber(s_prev1, n)\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the Nth Newman\u2013Shanks\u2013Williams number, S_n, based on the recurrence relation.\n    The function delegates the computation to an internal calculator and returns the integer value.\n    \"\"\"\n    calculator = NewmanShanksWilliamsPrimeCalculator()\n    prime_result = calculator.newman_prime(n)\n    return prime_result.value"}
{"task_id": "Mbpp/262", "solution": "def split_two_parts(input_list: list, L: int) -> tuple[list, list]:\n    \"\"\"\n    Splits a list into two parts based on a given length L.\n    Returns the two resulting lists in a tuple.\n    \"\"\"\n    first_part = input_list[:L]\n    second_part = input_list[L:]\n    return (first_part, second_part)"}
