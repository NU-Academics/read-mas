{"task_id": "Mbpp/160", "solution": "def find_solution(a, b, n):\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple, or None if no solution exists.\n    \"\"\"\n\n    # Helper function for Extended Euclidean Algorithm\n    # Returns (g, x, y) such that num1*x + num2*y = g = gcd(num1, num2)\n    def _extended_gcd(num1, num2):\n        x, y, x1, y1 = 1, 0, 0, 1\n        while num2 != 0:\n            q = num1 // num2\n            num1, num2 = num2, num1 % num2\n            x, x1 = x1, x - q * x1\n            y, y1 = y1, y - q * y1\n        return num1, x, y\n\n    # Handle edge cases with zero coefficients\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n    if a == 0:  # Equation is b*y = n\n        return (0, n // b) if n % b == 0 else None\n    if b == 0:  # Equation is a*x = n\n        return (n // a, 0) if n % a == 0 else None\n\n    # Use the extended Euclidean algorithm for non-zero a and b\n    g, x_g, y_g = _extended_gcd(a, b)\n\n    # Check if a solution exists (n must be divisible by g = gcd(a, b))\n    if n % g != 0:\n        return None\n\n    # Scale the particular solution (x_g, y_g) to solve a*x + b*y = n\n    factor = n // g\n    x_particular = x_g * factor\n    y_particular = y_g * factor\n\n    # Normalize the solution to a canonical form (e.g., smallest non-negative x)\n    # General solution: x = x_particular + k * (b / g)\n    #                   y = y_particular - k * (a / g)\n    \n    x_step = b // g # The change in x for each step k\n    y_step = a // g # The change in y for each step k\n\n    # Calculate k to shift x_particular into the range [0, |x_step|-1] if possible,\n    # or the equivalent range considering negative x_step.\n    # This formula correctly handles positive/negative x_particular and x_step.\n    k_norm = (x_particular % x_step - x_particular) // x_step\n\n    # Apply the shift using k_norm to get the final solution\n    x_final = x_particular + k_norm * x_step\n    y_final = y_particular - k_norm * y_step\n\n    return (x_final, y_final)"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_str: str) -> int:\n    \"\"\"\n    Counts characters that match their 1-based alphabetical position in the string.\n    Comparison is case-insensitive, non-alphabetic characters are ignored.\n    \"\"\"\n    count = 0\n    for i, char in enumerate(input_str):\n        lower_char = char.lower()\n        if 'a' <= lower_char <= 'z':\n            # Calculate the 1-based alphabet position of the character\n            alphabet_pos = ord(lower_char) - ord('a') + 1\n            # Compare with the 1-based position of the character in the string\n            if alphabet_pos == (i + 1):\n                count += 1\n    return count"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum (n - 2*i) from i=0 to n // 2.\n    For example: n + (n-2) + (n-4)...\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input n must be a non-negative integer.\")\n\n    current_sum = 0\n    # Iterate from i=0 up to and including n // 2.\n    for i in range(n // 2 + 1):\n        term = n - (2 * i)\n        current_sum += term\n    return current_sum"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(nums: list[int]) -> int:\n    \"\"\"\n    Count unordered pairs of integers in `nums` whose XOR is even.\n    An XOR is even iff both operands share the same parity.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for num in nums:\n        if num % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    even_pairs = even_count * (even_count - 1) // 2\n    odd_pairs = odd_count * (odd_count - 1) // 2\n\n    return even_pairs + odd_pairs"}
