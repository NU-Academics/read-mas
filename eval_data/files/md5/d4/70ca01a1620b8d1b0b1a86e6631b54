{"task_id": "Mbpp/805", "solution": "def max_sum_list(lists: list[list[int]]) -> list[int]:\n    \"\"\"\n    Returns the sublist from a list of lists whose sum of elements is the highest.\n    Handles empty input by returning an empty list, and resolves ties by returning the first encountered sublist.\n    \"\"\"\n    if not lists:\n        return []\n\n    max_current_sum = sum(lists[0])\n    max_sum_sublist = lists[0]\n\n    for sublist in lists[1:]:\n        current_sum = sum(sublist)\n        if current_sum > max_current_sum:\n            max_current_sum = current_sum\n            max_sum_sublist = sublist\n            \n    return max_sum_sublist"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Finds the maximum consecutive run of uppercase characters in the given string.\n    This function iterates through the string, tracking the current and maximum run lengths.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in input_string:\n        if 'A' <= char <= 'Z':  # Check if the character is an uppercase ASCII letter\n            current_run += 1\n        else:\n            current_run = 0\n        if current_run > max_run:\n            max_run = current_run\n    return max_run"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(tuple1, tuple2):\n    \"\"\"\n    Checks if each element of the second tuple is smaller than its corresponding element in the first tuple.\n    Assumes tuples are of equal length and contain comparable elements.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        return False # Or raise ValueError as per design, but current instructions avoid raising exceptions\n    \n    for i in range(len(tuple1)):\n        if not (tuple2[i] < tuple1[i]):\n            return False\n    return True"}
