{"task_id": "Mbpp/308", "solution": "from typing import List\ndef large_product(list1: List[int], list2: List[int], N: int) -> List[int]:\n    \"\"\"\n    Return the N largest products formed by multiplying one element from each list.\n    The result is sorted in descending order.\n    \"\"\"\n    products = [a * b for a in list1 for b in list2]\n    products.sort(reverse=True)\n    k = min(N, len(products))\n    return products[:k]"}
{"task_id": "Mbpp/312", "solution": "import math\nfrom typing import Union\ndef volume_cone(radius: Union[int, float], height: Union[int, float]) -> float:\n    \"\"\"\n    Calculate the volume of a right circular cone.\n    Formula: V = (1/3) * \u03c0 * r^2 * h\n    \"\"\"\n    return (1.0 / 3.0) * math.pi * radius ** 2 * height"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression contains balanced parentheses, brackets, and braces.\n    Uses a stack-based approach to match opening and closing brackets.\n    \"\"\"\n    stack = []\n    mapping = {\")\": \"(\", \"]\": \"[\", \"}\": \"{\"}\n    open_brackets = set(mapping.values())\n    close_brackets = set(mapping.keys())\n\n    for char in expression:\n        if char in open_brackets:\n            stack.append(char)\n        elif char in close_brackets:\n            if not stack:\n                return False\n            top_element = stack.pop()\n            if mapping[char] != top_element:\n                return False\n    \n    return not stack"}
{"task_id": "Mbpp/446", "solution": "def count_Occurrence(input_tuple: tuple, input_list: list) -> int:\n    \"\"\"\n    Counts the total occurrences of all elements from a list within a tuple.\n    Each occurrence of an element in the tuple is counted if it is present in the list.\n    \"\"\"\n    total_count = 0\n    for element_to_find in input_list:\n        total_count += input_tuple.count(element_to_find)\n    return total_count"}
{"task_id": "Mbpp/772", "solution": "def remove_length(text: str, k: int) -> str:\n    \"\"\"Removes all words of length k from the given string.\n    Ensures single spaces between words and no leading/trailing spaces.\n    \"\"\"\n    words = text.split()\n    filtered_words = [word for word in words if len(word) != k]\n    return ' '.join(filtered_words)"}
