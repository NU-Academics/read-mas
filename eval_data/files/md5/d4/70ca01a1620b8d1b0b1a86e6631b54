{"task_id": "Mbpp/459", "solution": "def remove_uppercase(input_str: str) -> str:\n    \"\"\"Removes all contiguous uppercase alphabetic substrings from an input string.\n    Preserves the order of remaining characters and is a pure, deterministic function.\n    \"\"\"\n\n    def _identify_uppercase_substrings(s: str) -> list[tuple[int, int]]:\n        \"\"\"Identifies and returns a list of (start_index, end_index) tuples for uppercase substrings.\"\"\"\n        substrings = []\n        start = None\n        for idx, ch in enumerate(s):\n            if ch.isupper():\n                if start is None:\n                    start = idx\n            else:\n                if start is not None:\n                    substrings.append((start, idx - 1))\n                    start = None\n        if start is not None:\n            substrings.append((start, len(s) - 1))\n        return substrings\n\n    def _remove_substrings(s: str, substrings: list[tuple[int, int]]) -> str:\n        \"\"\"Constructs a new string by omitting the specified substrings.\"\"\"\n        if not substrings:\n            return s\n        result_parts = []\n        last_end = 0\n        for sub_start, sub_end in substrings:\n            result_parts.append(s[last_end:sub_start])\n            last_end = sub_end + 1\n        result_parts.append(s[last_end:])\n        return ''.join(result_parts)\n\n    uppercase_substrings_info = _identify_uppercase_substrings(input_str)\n    return _remove_substrings(input_str, uppercase_substrings_info)"}
{"task_id": "Mbpp/462", "solution": "def combinations_list(elements):\n    \"\"\"\n    Generate all possible combinations (subsets) of the input list.\n    The order of elements is preserved, and duplicate values are treated as distinct positions.\n    \"\"\"\n    if not elements:\n        return [[]]\n\n    # Recursive case: split first element from rest\n    first = elements[0]\n    rest = elements[1:]\n\n    # Generate combinations for the rest\n    sub_combinations = combinations_list(rest)\n\n    result = []\n    for combo in sub_combinations:\n        # Combination without the first element\n        result.append(combo)\n        # Combination with the first element prepended\n        result.append([first] + combo)\n\n    return result"}
