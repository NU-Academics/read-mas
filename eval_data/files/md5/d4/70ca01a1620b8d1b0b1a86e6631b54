{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Return the last decimal digit of n! for a non-negative integer n.\n    \"\"\"\n    if n == 0:\n        return 1\n    elif n == 1:\n        return 1\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 6\n    elif n == 4:\n        return 4\n    else:  # For n >= 5, the last digit of n! is always 0\n        return 0"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Finds elements present in only one of the two input tuples, preserving their original order.\"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n\n    unique_to_tuple1 = set1 - set2\n    unique_to_tuple2 = set2 - set1\n\n    result_elements = []\n    for item in tuple1:\n        if item in unique_to_tuple1:\n            result_elements.append(item)\n\n    for item in tuple2:\n        if item in unique_to_tuple2:\n            result_elements.append(item)\n\n    return tuple(result_elements)"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1, list2, list3):\n    \"\"\"Interleaves three lists of the same length into a single flat list.\n    Raises ValueError if input lists are not of equal length.\"\"\"\n    len1 = len(list1)\n    len2 = len(list2)\n    len3 = len(list3)\n\n    if not (len1 == len2 == len3):\n        raise ValueError(\"All input lists must be of the same length.\")\n\n    interleaved = []\n    for i in range(len1):\n        interleaved.append(list1[i])\n        interleaved.append(list2[i])\n        interleaved.append(list3[i])\n\n    return interleaved"}
{"task_id": "Mbpp/580", "solution": "def extract_even(nested_tuple: tuple) -> tuple:\n    \"\"\"\n    Recursively extracts even integers from a nested tuple, preserving its structure.\n    \"\"\"\n    result = []\n    for item in nested_tuple:\n        if isinstance(item, int):\n            if item % 2 == 0:\n                result.append(item)\n        elif isinstance(item, tuple):\n            processed_sub_tuple = extract_even(item)\n            if processed_sub_tuple:  # Only add if the sub-tuple is not empty after processing\n                result.append(processed_sub_tuple)\n    return tuple(result)"}
{"task_id": "Mbpp/581", "solution": "def surface_Area(baseEdge, height):\n    \"\"\"\n    Calculates the surface area of a square pyramid given its base edge and height.\n    Assumes baseEdge and height are non-negative floats.\n    \"\"\"\n    import math\n\n    if baseEdge < 0 or height < 0:\n        raise ValueError(\"Inputs baseEdge and height must be non-negative.\")\n    \n    if baseEdge == 0 or height == 0:\n        return 0.0\n\n    base_area = baseEdge ** 2\n    # Calculate slant height using Pythagorean theorem\n    slant_height = math.sqrt((baseEdge / 2) ** 2 + height ** 2)\n    # Calculate area of one triangular face\n    triangular_face_area = 0.5 * baseEdge * slant_height\n    # Total surface area is base area + 4 times triangular face area\n    total_surface_area = base_area + 4 * triangular_face_area\n    \n    return total_surface_area"}
