{"task_id": "Mbpp/456", "solution": "from typing import List\nfrom dataclasses import dataclass\nclass StringReverser:\n    \"\"\"Performs the core logic of reversing strings within a StringList.\"\"\"\n    def reverse_list(self, input_string_list: StringList) -> StringList:\n        \"\"\"Reverses each string in the input StringList and returns a new StringList.\"\"\"\n        reversed_items = []\n        for s in input_string_list.items:\n            reversed_items.append(s[::-1])\n        return StringList(reversed_items)\ndef reverse_string_list(input_list: List[str]) -> List[str]:\n    \"\"\"Reverses each string in a given list of string values.\"\"\"\n    initial_string_list = StringList(input_list)\n    reverser = StringReverser()\n    reversed_string_list_obj = reverser.reverse_list(initial_string_list)\n    return reversed_string_list_obj.items"}
{"task_id": "Mbpp/457", "solution": "def Find_Min(list_of_sublists: list[list[int]]) -> list[int]:\n    \"\"\"\n    Finds and returns the first sublist with the minimum length from a list of sublists.\n    Assumes the input list_of_sublists is not empty.\n    \"\"\"\n    min_sublist = list_of_sublists[0]\n    min_length = len(list_of_sublists[0])\n\n    for sublist in list_of_sublists[1:]:\n        if len(sublist) < min_length:\n            min_length = len(sublist)\n            min_sublist = sublist\n            \n    return min_sublist"}
