{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list):\n    \"\"\"\n    Returns a list of all pairs of consecutive items in the given list.\n    Handles empty or single-element lists by returning an empty list.\n    \"\"\"\n    if len(input_list) < 2:\n        return []\n\n    result_pairs = []\n    for i in range(len(input_list) - 1):\n        result_pairs.append((input_list[i], input_list[i+1]))\n    return result_pairs"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list[int], sum: int) -> int:\n    \"\"\"Counts pairs of numbers in a list that sum to a target value.\n    This function uses a frequency map to achieve O(n) time complexity.\"\"\"\n    pairs_count = 0\n    freq_map = {}\n\n    for num in numbers:\n        complement = sum - num\n        if complement in freq_map:\n            pairs_count += freq_map[complement]\n        \n        freq_map[num] = freq_map.get(num, 0) + 1\n        \n    return pairs_count"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1, list2):\n    \"\"\"\n    Returns a new list containing elements from list1 that are not present in list2,\n    preserving the order of elements from list1.\n    \"\"\"\n    set2 = set(list2)\n    result = []\n    for item in list1:\n        if item not in set2:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth powers of the first n odd natural numbers.\n    Handles input validation and non-positive n as per design.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    \n    if n <= 0:\n        return 0\n\n    total_sum = 0\n    for i in range(1, 2 * n, 2):\n        total_sum += i**4\n    return total_sum"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(text: str, sub: str):\n    \"\"\"\n    Finds the first occurrence of a substring within a string.\n    Returns a tuple (substring, start_index, end_index) or None if no match.\n    \"\"\"\n    start_index = text.find(sub)\n    if start_index == -1:\n        return None\n    \n    end_index = start_index + len(sub)\n    return (sub, start_index, end_index)"}
{"task_id": "Mbpp/775", "solution": "from typing import List\ndef odd_position(lst: List[int]) -> bool:\n    \"\"\"Determine if all elements at odd indices are odd numbers. An empty list returns True.\"\"\"\n    # Iterate over odd indices (1, 3, 5, ...)\n    for i in range(1, len(lst), 2):\n        if lst[i] % 2 == 0:  # Check if the element at the current odd index is even.\n            return False\n    return True"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list):\n    \"\"\"\n    Packs consecutive duplicate elements of a list into sublists.\n    Returns a list of sublists where each sublist contains consecutive identical elements.\n    \"\"\"\n    if not input_list:\n        return []\n\n    packed_list = []\n    current_sublist = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] == current_sublist[0]:\n            current_sublist.append(input_list[i])\n        else:\n            packed_list.append(current_sublist)\n            current_sublist = [input_list[i]]\n\n    # Append the last sublist\n    packed_list.append(current_sublist)\n\n    return packed_list"}
{"task_id": "Mbpp/777", "solution": "def find_sum(numbers):\n    \"\"\"\n    Finds the sum of non-repeated elements in a given list.\n    Elements appearing more than once are excluded from the sum.\n    \"\"\"\n    counts = {}\n    for n in numbers:\n        counts[n] = counts.get(n, 0) + 1\n\n    total_sum = 0\n    for n, count in counts.items():\n        if count == 1:\n            total_sum += n\n            \n    return total_sum"}
{"task_id": "Mbpp/780", "solution": "from typing import List, Tuple\ndef find_combinations(tuples: List[Tuple[int, int]]) -> List[Tuple[int, int]]:\n    # Returns an empty list if there are fewer than two tuples to combine.\n    if len(tuples) < 2:\n        return []\n\n    result: List[Tuple[int, int]] = []\n    # Iterates through all unique pairs of tuples to compute their element-wise sums.\n    for i in range(len(tuples)):\n        for j in range(i + 1, len(tuples)):\n            sum_tuple = (tuples[i][0] + tuples[j][0],\n                         tuples[i][1] + tuples[j][1])\n            result.append(sum_tuple)\n    return result"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(n: int) -> bool:\n    \"\"\"Checks if the number of divisors for n is even.\n    A number has an even count of divisors if it is not a perfect square.\"\"\"\n    \n    # A number has an odd number of divisors if and only if it is a perfect square.\n    # Therefore, the count of divisors is even if and only if n is NOT a perfect square.\n    \n    sqrt_n = int(n**0.5)\n    is_perfect_square = (sqrt_n * sqrt_n == n)\n    \n    # Return True if the divisor count is even (i.e., n is not a perfect square).\n    return not is_perfect_square"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(nums: list[int]) -> int:\n    \"\"\"\n    Compute the sum of all elements in all odd\u2011length subarrays of `nums`.\n    Iterates through all possible subarrays, sums elements of odd-length ones.\n    \"\"\"\n    total_sum = 0\n    n = len(nums)\n    for i in range(n):\n        for j in range(i, n):\n            # Calculate the length of the current subarray\n            length = j - i + 1\n            # If the length is odd, sum its elements and add to total_sum\n            if length % 2 == 1:\n                for k in range(i, j + 1):\n                    total_sum += nums[k]\n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(numbers):\n    \"\"\"\n    Finds the product of the first even and first odd number in a list.\n    Assumes the list contains at least one even and one odd number.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n\n        if first_even is not None and first_odd is not None:\n            break\n\n    return first_even * first_odd"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(input_str: str) -> tuple[int]:\n    \"\"\"Converts a string representation of an integer tuple into an actual Python tuple of integers.\"\"\"\n    if not input_str.startswith('(') or not input_str.endswith(')'):\n        raise ValueError(\"Input must start with '(' and end with ')'\")\n\n    inner = input_str[1:-1].strip()\n    if not inner:\n        return ()\n\n    elements = [elem.strip() for elem in inner.split(',')]\n    ints = []\n\n    for elem in elements:\n        if not elem:\n            # This handles cases like \"(1,,2)\" or \"(1, ,2)\"\n            raise ValueError(\"Empty element detected within the tuple string\")\n        try:\n            ints.append(int(elem))\n        except ValueError as exc:\n            raise ValueError(f\"Invalid integer literal: '{elem}'\") from exc\n\n    return tuple(ints)"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(sorted_list: list, value) -> int:\n    \"\"\"\n    Locates the right insertion point for a specified value in sorted order.\n    Returns the index where the value should be inserted to maintain sorted order,\n    placing it after any existing equal values.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] <= value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
