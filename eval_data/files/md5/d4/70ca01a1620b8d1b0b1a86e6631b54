{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array):\n    \"\"\"Checks if the given array is monotonic (non-decreasing or non-increasing).\"\"\"\n    if len(array) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(1, len(array)):\n        if array[i] < array[i - 1]:\n            is_increasing = False\n        if array[i] > array[i - 1]:\n            is_decreasing = False\n\n    return is_increasing or is_decreasing"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n):\n    \"\"\"\n    Computes the nth Bell number using the recurrence relation.\n    It builds up a list of Bell numbers from B(0) to B(n).\n    \"\"\"\n\n    def combinations(n_comb, k_comb):\n        \"\"\"Calculates binomial coefficient C(n_comb, k_comb).\"\"\"\n        if k_comb < 0 or k_comb > n_comb:\n            return 0\n        if k_comb == 0 or k_comb == n_comb:\n            return 1\n        if k_comb > n_comb // 2:\n            k_comb = n_comb - k_comb\n\n        res = 1\n        for i in range(k_comb):\n            res = res * (n_comb - i) // (i + 1)\n        return res\n\n    if n == 0:\n        return 1\n    if n == 1:\n        return 1\n\n    bell = [0] * (n + 1)\n    bell[0] = 1\n    bell[1] = 1\n\n    for i in range(2, n + 1):\n        current_bell_sum = 0\n        # Uses the recurrence B(i) = sum(C(i-1, k) * B(k) for k from 0 to i-1)\n        for k_val in range(i):\n            current_bell_sum += combinations(i - 1, k_val) * bell[k_val]\n        bell[i] = current_bell_sum\n    return bell[n]"}
{"task_id": "Mbpp/71", "solution": "from typing import List, TypeVar\nT = TypeVar('T')\nclass CombSortAlgorithm:\n    \"\"\"Internal implementation of the Comb Sort algorithm.\"\"\"\n    def sort(self, lst: List[T]) -> List[T]:\n        gap = len(lst)\n        shrink = 1.3\n        swapped = True\n        while gap > 1 or swapped:\n            gap = int(gap / shrink) if gap > 1 else 1\n            swapped = False\n            for i in range(len(lst) - gap):\n                if lst[i] > lst[i + gap]:\n                    lst[i], lst[i + gap] = lst[i + gap], lst[i]\n                    swapped = True\n        return lst\ndef comb_sort(lst: List[T]) -> List[T]:\n    \"\"\"Public API: returns a new list sorted in ascending order.\"\"\"\n    copy = lst.copy()\n    sorter = CombSortAlgorithm()\n    return sorter.sort(copy)"}
