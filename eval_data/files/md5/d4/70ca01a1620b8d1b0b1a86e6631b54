{"task_id": "Mbpp/742", "solution": "import math\nclass Tetrahedron:\n    \"\"\"Domain entity representing a regular tetrahedron.\"\"\"\n    def __init__(self, side_length: float):\n        self.side_length = side_length\n\n    def compute_area(self) -> float:\n        \"\"\"Compute the surface area of the tetrahedron.\"\"\"\n        return math.sqrt(3) * (self.side_length ** 2)\ndef area_tetrahedron(a: float) -> float:\n    \"\"\"Compute the surface area of a regular tetrahedron.\"\"\"\n    if a <= 0:\n        raise ValueError(\"Side length must be positive.\")\n    tetra = Tetrahedron(a)\n    return tetra.compute_area()"}
