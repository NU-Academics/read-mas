{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_string: str) -> str:\n    \"\"\"\n    Inserts spaces before words starting with capital letters, excluding the first character.\n    Uses internal helper classes as per design context.\n    \"\"\"\n    class StringInput:\n        def __init__(self, value: str):\n            self.value = value\n\n    class StringOutput:\n        def __init__(self, value: str):\n            self.value = value\n\n    class CapitalWordSpacer:\n        def add_spaces(self, input_obj: StringInput) -> StringOutput:\n            result_parts = []\n            for i, char in enumerate(input_obj.value):\n                # Insert a space if it's not the first character and it's an uppercase letter.\n                if i > 0 and char.isupper():\n                    result_parts.append(' ')\n                result_parts.append(char)\n            return StringOutput(\"\".join(result_parts))\n\n    string_input = StringInput(input_string)\n    spacer = CapitalWordSpacer()\n    string_output = spacer.add_spaces(string_input)\n    return string_output.value"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(array: list[int]) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    It iterates through the array, comparing each parent with its children.\n    \"\"\"\n    n = len(array)\n    for i in range(n):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n and array[i] > array[left_child_idx]:\n            return False\n\n        # Check right child\n        if right_child_idx < n and array[i] > array[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n):\n    \"\"\"\n    Calculates the nth Jacobsthal number using an iterative approach.\n    Based on the recurrence J(n) = J(n-1) + 2*J(n-2) with J(0)=0 and J(1)=1.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    else:\n        a, b = 0, 1  # a represents J(k-2), b represents J(k-1)\n        for _ in range(2, n + 1):\n            next_val = b + 2 * a\n            a = b\n            b = next_val\n        return b"}
