{"task_id": "Mbpp/223", "solution": "def is_majority(data: list[int], n: int, element: int) -> bool:\n    \"\"\"\n    Checks if an element is the majority element in a sorted array.\n    A majority element occurs more than n/2 times.\n    \"\"\"\n    if n != len(data):\n        return False\n\n    def _count_occurrences(arr: list[int], target: int) -> int:\n        \"\"\"Counts the occurrences of a target element in a sorted array using binary search.\"\"\"\n\n        def find_first(sub_arr, sub_target):\n            low, high = 0, len(sub_arr) - 1\n            result = -1\n            while low <= high:\n                mid = low + (high - low) // 2\n                if sub_arr[mid] == sub_target:\n                    result = mid\n                    high = mid - 1\n                elif sub_arr[mid] < sub_target:\n                    low = mid + 1\n                else:\n                    high = mid - 1\n            return result\n\n        def find_last(sub_arr, sub_target):\n            low, high = 0, len(sub_arr) - 1\n            result = -1\n            while low <= high:\n                mid = low + (high - low) // 2\n                if sub_arr[mid] == sub_target:\n                    result = mid\n                    low = mid + 1\n                elif sub_arr[mid] < sub_target:\n                    low = mid + 1\n                else:\n                    high = mid - 1\n            return result\n\n        first_idx = find_first(arr, target)\n        if first_idx == -1:\n            return 0\n\n        last_idx = find_last(arr, target)\n        return last_idx - first_idx + 1\n\n    count = _count_occurrences(data, element)\n    return count > n / 2"}
{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(n):\n    \"\"\"\n    Count the number of set bits (1s) in the binary representation of a non-negative integer.\n    The implementation uses bitwise operations.\n    \"\"\"\n    count = 0\n    while n > 0:\n        n &= (n - 1)\n        count += 1\n    return count"}
