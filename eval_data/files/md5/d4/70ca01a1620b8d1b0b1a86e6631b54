{"task_id": "Mbpp/7", "solution": "class Word:\n    \"\"\"Represents an immutable word with its text and length.\"\"\"\n    def __init__(self, text: str):\n        self._text = text\n        self._length = len(text)\n\n    def getLength(self) -> int:\n        \"\"\"Returns the length of the word.\"\"\"\n        return self._length\n\n    def __eq__(self, other):\n        if not isinstance(other, Word):\n            return NotImplemented\n        return self._text == other._text\n\n    def __hash__(self):\n        return hash(self._text)\n\n    def __repr__(self):\n        return f\"Word('{self._text}')\"\ndef find_char_long(inputString: str) -> set[Word]:\n    \"\"\"Finds all words at least 4 characters long in a string, returning them as a set of Word objects.\"\"\"\n    words_set = set()\n    tokens = inputString.split()\n    for token in tokens:\n        if len(token) >= 4:\n            words_set.add(Word(token))\n    return words_set"}
{"task_id": "Mbpp/4", "solution": "from typing import List\nimport heapq\ndef heap_queue_largest(numbers: List[int], n: int) -> List[int]:\n    \"\"\"Return the n largest integers from `numbers` in descending order.\"\"\"\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    if n == 0:\n        return []\n\n    if n >= len(numbers):\n        return sorted(numbers, reverse=True)\n\n    min_heap: List[int] = []\n    for num in numbers:\n        if len(min_heap) < n:\n            heapq.heappush(min_heap, num)\n        elif num > min_heap[0]:\n            heapq.heapreplace(min_heap, num)\n\n    return sorted(min_heap, reverse=True)"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, char: str) -> str:\n    \"\"\"Removes the first and last occurrences of a given character from a string.\n    Returns the original string if the character occurs fewer than two times.\"\"\"\n    first_idx = input_string.find(char)\n    last_idx = input_string.rfind(char)\n\n    if first_idx == -1 or first_idx == last_idx:\n        return input_string\n    \n    return input_string[:first_idx] + input_string[first_idx + 1:last_idx] + input_string[last_idx + 1:]"}
