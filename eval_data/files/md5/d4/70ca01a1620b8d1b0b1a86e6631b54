{"task_id": "Mbpp/792", "solution": "from typing import List, Any\nclass ListContainer:\n    \"\"\"\n    A container for a list of lists, providing methods to count them.\n    \"\"\"\n    def __init__(self, lists: List[List[Any]]):\n        self.lists = lists\n\n    def count_lists(self) -> int:\n        \"\"\"\n        Returns the number of top-level lists in the container.\n        \"\"\"\n        return len(self.lists)\ndef count_list(lists: List[List[Any]]) -> int:\n    \"\"\"\n    Counts the number of top-level lists in the given list of lists.\n    Raises TypeError if the input is not a list of lists.\n    \"\"\"\n    if not isinstance(lists, list):\n        raise TypeError(\"Input must be a list.\")\n    \n    for item in lists:\n        if not isinstance(item, list):\n            raise TypeError(\"All elements in the input list must be lists.\")\n            \n    container = ListContainer(lists)\n    return container.count_lists()"}
{"task_id": "Mbpp/794", "solution": "class StringMatcher:\n    \"\"\"Helper class to encapsulate string matching logic.\"\"\"\n    def matches(self, s: str) -> bool:\n        \"\"\"Checks if a string starts with 'a' and ends with 'b'.\"\"\"\n        if not s or len(s) < 2:\n            return False\n        return s[0] == 'a' and s[-1] == 'b'\ndef text_starta_endb(s: str) -> bool:\n    \"\"\"Matches a string that has an 'a' followed by anything, ending in 'b'.\"\"\"\n    matcher = StringMatcher()\n    return matcher.matches(s)"}
{"task_id": "Mbpp/793", "solution": "def last(array: list[int], element: int) -> int:\n    \"\"\"\n    Finds the last position of an element in a sorted array using binary search.\n    Returns -1 if the element is not found.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = (low + high) // 2\n        if array[mid] == element:\n            result = mid\n            low = mid + 1  # Search in the right half for further occurrences\n        elif array[mid] < element:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result"}
