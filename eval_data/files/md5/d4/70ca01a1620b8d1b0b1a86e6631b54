{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr):\n    \"\"\"\n    Counts the number of inversions in the input array using a merge sort based approach.\n    An inversion is a pair (i, j) such that i < j and arr[i] > arr[j].\n    \"\"\"\n    def merge_sort_and_count(lst):\n        if len(lst) <= 1:\n            return lst, 0\n\n        mid = len(lst) // 2\n        left_half, inv_left = merge_sort_and_count(lst[:mid])\n        right_half, inv_right = merge_sort_and_count(lst[mid:])\n        \n        merged_list, split_inv = merge_and_count(left_half, right_half)\n        return merged_list, inv_left + inv_right + split_inv\n\n    def merge_and_count(left, right):\n        merged = []\n        i = j = inv_count = 0\n        \n        while i < len(left) and j < len(right):\n            if left[i] <= right[j]:\n                merged.append(left[i])\n                i += 1\n            else:\n                merged.append(right[j])\n                inv_count += (len(left) - i) # All remaining elements in left[i:] form inversions with right[j]\n                j += 1\n        \n        merged.extend(left[i:])\n        merged.extend(right[j:])\n        return merged, inv_count\n\n    _, total_inversions = merge_sort_and_count(arr)\n    return total_inversions"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(nested_list):\n    \"\"\"\n    Flatten an arbitrarily nested list into a single flat list.\n    It uses an iterative depth-first traversal with a stack.\n    \"\"\"\n    result = []\n    stack = [iter(nested_list)]\n\n    while stack:\n        try:\n            item = next(stack[-1])\n            if isinstance(item, list):\n                stack.append(iter(item))\n            else:\n                result.append(item)\n        except StopIteration:\n            stack.pop()\n\n    return result"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(input_list):\n    \"\"\"Calculates the maximum aggregate score from a list of (name, score) tuples.\"\"\"\n    if not input_list:\n        return ()\n\n    name_scores = {}\n    for name, score in input_list:\n        name_scores[name] = name_scores.get(name, 0) + score\n\n    max_name = None\n    max_score = -1\n\n    for name, aggregate_score in name_scores.items():\n        if max_name is None or aggregate_score > max_score:\n            max_score = aggregate_score\n            max_name = name\n    \n    return (max_name, max_score)"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(d: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of a dictionary.\n    The outermost dictionary is considered depth 1.\n    \"\"\"\n    def _max_depth(current_dict: dict) -> int:\n        max_sub_depth = 0\n        for value in current_dict.values():\n            if isinstance(value, dict):\n                max_sub_depth = max(max_sub_depth, _max_depth(value))\n        return 1 + max_sub_depth\n\n    return _max_depth(d)"}
{"task_id": "Mbpp/300", "solution": "import math\ndef count_binary_seq(n: int) -> int:\n    \"\"\"\n    Calculates the count of binary sequences of length 2n where the sum of the first n bits equals the sum of the last n bits.\n    Uses the combinatorial formula sum from k=0 to n of (n choose k)^2.\n    \"\"\"\n    total_count = 0\n    for k in range(n + 1):\n        binomial_coeff = math.comb(n, k)\n        total_count += binomial_coeff ** 2\n    return total_count"}
{"task_id": "Mbpp/305", "solution": "def start_withp(words):\n    \"\"\"\n    Returns the first two words from a list that start with 'p' (case-insensitive).\n    If fewer than two matches are found, returns a tuple with the available matches.\n    \"\"\"\n    p_words = []\n    for word_group in words:\n        for word in word_group.split():\n            if word.lower().startswith('p'):\n                p_words.append(word)\n                if len(p_words) == 2:\n                    return tuple(p_words)\n    return tuple(p_words)"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(array: list[int], i: int, k: int) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence using elements from array[0...i]\n    that also includes the element at index k, where k > i.\n    \"\"\"\n    # array_k_val is the value of the mandatory kth element.\n    array_k_val = array[k]\n\n    # dp[x] stores the maximum sum of an increasing subsequence ending at array[x]\n    # considering only elements within the prefix array[0...i].\n    dp = [0] * (i + 1)\n\n    max_sum_prefix_subsequence = 0\n\n    # Iterate through elements in the prefix array[0...i]\n    for current_idx in range(i + 1):\n        # Base case: the subsequence can consist of just the current element itself.\n        dp[current_idx] = array[current_idx]\n\n        # Find the maximum sum of an increasing subsequence ending at current_idx\n        # by considering all previous elements in the prefix.\n        for prev_idx in range(current_idx):\n            if array[current_idx] > array[prev_idx]:\n                dp[current_idx] = max(dp[current_idx], dp[prev_idx] + array[current_idx])\n\n        # If the current subsequence (ending at current_idx) can legitimately precede array[k]\n        # in an overall increasing subsequence, update the maximum sum found so far for a prefix.\n        if array[current_idx] < array_k_val:\n            max_sum_prefix_subsequence = max(max_sum_prefix_subsequence, dp[current_idx])\n\n    # The total maximum sum is the sum of the best increasing subsequence found within the prefix\n    # (that is less than array[k]) plus the value of the mandatory element array[k] itself.\n    # If no such prefix subsequence exists, max_sum_prefix_subsequence will be 0,\n    # and the function will correctly return array[k] (representing the subsequence [array[k]]).\n    return max_sum_prefix_subsequence + array_k_val"}
