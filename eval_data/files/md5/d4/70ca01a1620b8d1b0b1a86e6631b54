{"task_id": "Mbpp/119", "solution": "def search(array: list[int]) -> int:\n    \"\"\"Finds the element that appears only once in a sorted array where other elements appear twice.\"\"\"\n    left, right = 0, len(array) - 1\n\n    while left < right:\n        mid = (left + right) // 2\n\n        # Adjust mid to be at an even index if it's currently odd\n        # This simplifies the logic for checking pairs\n        if mid % 2 == 1:\n            mid -= 1\n\n        # Check if the pair at mid is complete\n        # If array[mid] == array[mid+1], the unique element is to the right\n        if array[mid] == array[mid + 1]:\n            left = mid + 2\n        # If array[mid] != array[mid+1], the unique element is at or to the left\n        else:\n            right = mid\n\n    return array[left]"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(tuples: list[tuple[int, int]]) -> int:\n    \"\"\"\n    Compute the maximum absolute product from a list of integer tuples.\n    Returns 0 if the input list is empty.\n    \"\"\"\n    if not tuples:\n        return 0\n\n    def _abs_product(a: int, b: int) -> int:\n        \"\"\"Return the absolute product of two integers.\"\"\"\n        return abs(a * b)\n\n    return max(_abs_product(a, b) for a, b in tuples)"}
{"task_id": "Mbpp/123", "solution": "import math\ndef _sum_of_proper_divisors(x: int) -> int:\n    \"\"\"Calculates the sum of proper divisors for a positive integer x.\"\"\"\n    if x <= 1:\n        return 0\n    divisors_sum = 1  # 1 is always a proper divisor for x > 1\n    for i in range(2, int(math.sqrt(x)) + 1):\n        if x % i == 0:\n            divisors_sum += i\n            if i * i != x:\n                divisors_sum += x // i\n    return divisors_sum\ndef amicable_numbers_sum(specified_number: int) -> int:\n    \"\"\"\n    Sums all amicable numbers from 1 up to a specified limit.\n    An amicable pair (a, b) means sum_proper_divisors(a) = b and sum_proper_divisors(b) = a, with a != b.\n    \"\"\"\n    total_sum = 0\n    found_amicable = set() # Stores amicable numbers already added to avoid duplicates.\n\n    for a in range(1, specified_number + 1):\n        if a in found_amicable:\n            continue\n\n        b = _sum_of_proper_divisors(a)\n\n        # Check if a and b form an amicable pair and if b is within the limit.\n        if a != b and b <= specified_number:\n            sum_div_b = _sum_of_proper_divisors(b)\n            if sum_div_b == a:\n                # Found an amicable pair (a, b)\n                total_sum += a\n                total_sum += b\n                found_amicable.add(a)\n                found_amicable.add(b)\n    return total_sum"}
