{"task_id": "Mbpp/126", "solution": "def sum(a, b):\n    \"\"\"\n    Calculates the sum of common positive divisors of two integers.\n    Returns 0 if either input is zero.\n    \"\"\"\n    if a == 0 or b == 0:\n        return 0\n\n    def _gcd(n1, n2):\n        \"\"\"Computes the greatest common divisor using the Euclidean algorithm.\"\"\"\n        n1 = abs(n1)\n        n2 = abs(n2)\n        while n2:\n            n1, n2 = n2, n1 % n2\n        return n1\n\n    greatest_common_divisor = _gcd(a, b)\n    total_sum_of_divisors = 0\n\n    # All common divisors of a and b are divisors of their greatest common divisor.\n    # Iterate from 1 up to the GCD to find all positive divisors of GCD and sum them.\n    for i in range(1, greatest_common_divisor + 1):\n        if greatest_common_divisor % i == 0:\n            total_sum_of_divisors += i\n\n    return total_sum_of_divisors"}
{"task_id": "Mbpp/128", "solution": "class Word:\n    \"\"\"Represents a single word with its string value and length.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the word.\"\"\"\n        return len(self.value)\nclass WordList:\n    \"\"\"Manages a list of Word objects and provides filtering capabilities.\"\"\"\n    def __init__(self, text: str):\n        self.words = [Word(w) for w in text.split()]\n\n    def filter_by_length(self, n: int) -> list[str]:\n        \"\"\"Filters words that are longer than n characters.\"\"\"\n        return [word.value for word in self.words if word.length() > n]\nclass LongWordFinder:\n    \"\"\"Orchestrates the process of finding long words.\"\"\"\n    def find_long_words(self, n: int, text: str) -> list[str]:\n        \"\"\"Splits text, creates a WordList, and returns filtered words.\"\"\"\n        word_list = WordList(text)\n        return word_list.filter_by_length(n)\ndef long_words(n: int, text: str) -> list[str]:\n    \"\"\"\n    Finds words that are longer than n characters from a given string.\n    Delegates the filtering logic to internal classes.\n    \"\"\"\n    finder = LongWordFinder()\n    return finder.find_long_words(n, text)"}
{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix: list[list[int]]) -> bool:\n    \"\"\"\n    Checks if a given matrix is a magic square.\n    A magic square has equal sums for all its rows, columns, and both main diagonals.\n    \"\"\"\n    n = len(matrix)\n\n    # An empty matrix or a matrix with empty rows cannot be a magic square.\n    if n == 0 or len(matrix[0]) == 0:\n        return False\n\n    # Check if the matrix is square and all rows have consistent length.\n    for row in matrix:\n        if len(row) != n:\n            return False\n\n    # Calculate the sum of the first row to set the target magic sum.\n    target_sum = sum(matrix[0])\n\n    # Validate all row sums.\n    for row in matrix:\n        if sum(row) != target_sum:\n            return False\n\n    # Validate all column sums.\n    for j in range(n):\n        col_sum = 0\n        for i in range(n):\n            col_sum += matrix[i][j]\n        if col_sum != target_sum:\n            return False\n\n    # Validate the main diagonal sum (top-left to bottom-right).\n    main_diag_sum = 0\n    for i in range(n):\n        main_diag_sum += matrix[i][i]\n    if main_diag_sum != target_sum:\n        return False\n\n    # Validate the anti-diagonal sum (top-right to bottom-left).\n    anti_diag_sum = 0\n    for i in range(n):\n        anti_diag_sum += matrix[i][n - 1 - i]\n    if anti_diag_sum != target_sum:\n        return False\n\n    return True"}
{"task_id": "Mbpp/130", "solution": "from typing import Any, List, Dict, Optional\nclass FrequencyCounter:\n    \"\"\"Counts occurrences of items in a list and returns the most frequent item.\"\"\"\n    def __init__(self, items: List[Any]) -> None:\n        self._count_map: Dict[Any, int] = {}\n        for item in items:\n            self._count_map[item] = self._count_map.get(item, 0) + 1\n\n    def get_max_frequency_item(self) -> Any:\n        if not self._count_map:\n            return None\n        max_item = None\n        max_count = -1\n        for item, count in self._count_map.items():\n            if count > max_count:\n                max_count = count\n                max_item = item\n        return max_item\ndef max_occurrences(items: List[Any]) -> Optional[Any]:\n    \"\"\"Return the item with the highest frequency in the list.\n    If the list is empty, returns None.\"\"\"\n    counter = FrequencyCounter(items)\n    return counter.get_max_frequency_item()"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    \"\"\"Reverses only the vowels of a given string (where y is not a vowel).\"\"\"\n    vowels = {'a', 'e', 'i', 'o', 'u'}\n    \n    def _is_vowel(char: str) -> bool:\n        \"\"\"Determines if a character is a vowel (case-insensitive).\"\"\"\n        return char.lower() in vowels\n\n    vowel_info = [] # Stores (original_index, vowel_char)\n    for i, char in enumerate(s):\n        if _is_vowel(char):\n            vowel_info.append((i, char))\n    \n    if len(vowel_info) < 2:\n        return s\n\n    # Extract just the vowel characters and reverse their order\n    vowel_chars_reversed = [info[1] for info in vowel_info]\n    vowel_chars_reversed.reverse()\n    \n    s_list = list(s)\n    for i, (original_index, _) in enumerate(vowel_info):\n        s_list[original_index] = vowel_chars_reversed[i]\n        \n    return \"\".join(s_list)"}
