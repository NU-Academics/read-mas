{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array, target):\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array using binary search.\n    Returns -1 if the target is not found.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = (low + high) // 2\n        if array[mid] == target:\n            result = mid\n            high = mid - 1  # Continue searching in the left half for an earlier occurrence\n        elif array[mid] < target:\n            low = mid + 1\n        else:  # array[mid] > target\n            high = mid - 1\n            \n    return result"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(nums: list) -> int:\n    \"\"\"\n    Computes the sum of products of all contiguous sublists of a given list.\n    Raises ValueError if the input list is empty.\n    \"\"\"\n    if not nums:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    total_sum = 0\n    n = len(nums)\n\n    for i in range(n):\n        current_product = 1\n        for j in range(i, n):\n            current_product *= nums[j]\n            total_sum += current_product\n    return total_sum"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(n: int) -> int:\n    \"\"\"\n    Toggles all bits of the number except the first (MSB) and the last (LSB) bit.\n    For numbers with 0, 1, or 2 bits, no middle bits exist, so the number remains unchanged.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    num_bits = n.bit_length()\n\n    if num_bits <= 2:\n        # No middle bits to toggle if length is 0, 1, or 2\n        middle_mask = 0\n    else:\n        # Create a mask with all bits set up to num_bits length\n        full_mask = (1 << num_bits) - 1\n        \n        # Clear the LSB (bit 0)\n        middle_mask = full_mask & (~1)\n        \n        # Clear the MSB (bit num_bits - 1)\n        msb_mask_bit = (1 << (num_bits - 1))\n        middle_mask = middle_mask & (~msb_mask_bit)\n    \n    # XOR with the middle_mask to toggle only the middle bits\n    return n ^ middle_mask"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(lst: list[int], value: int) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted list.\n    Uses binary search to find the smallest index 'i' such that lst[i] >= value.\n    \"\"\"\n    low = 0\n    high = len(lst)\n\n    while low < high:\n        mid = (low + high) // 2\n        if lst[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
