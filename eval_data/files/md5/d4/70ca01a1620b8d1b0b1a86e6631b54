{"task_id": "Mbpp/605", "solution": "def prime_num(n: int) -> bool:\n    \"\"\"\n    Return True if n is a prime number, False otherwise.\n    Implements trial division up to the square root of n.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    limit = int(n ** 0.5)\n    divisor = 3\n    while divisor <= limit:\n        if n % divisor == 0:\n            return False\n        divisor += 2\n    return True"}
{"task_id": "Mbpp/603", "solution": "def get_ludic(n: int) -> list[int]:\n    \"\"\"Return all lucid numbers <= n.\"\"\"\n\n    class Number:\n        \"\"\"Value object representing an integer.\"\"\"\n        def __init__(self, value: int):\n            if value < 0:\n                raise ValueError(\"Number must be non\u2011negative\")\n            self.value = value\n\n    class LucidNumber(Number):\n        \"\"\"Entity that determines if a number is lucid.\"\"\"\n        def is_lucid(self) -> bool:\n            return self.value == 1 or self._is_prime()\n\n        def _is_prime(self) -> bool:\n            if self.value < 2:\n                return False\n            if self.value == 2:\n                return True\n            if self.value % 2 == 0:\n                return False\n            i = 3\n            while i * i <= self.value:\n                if self.value % i == 0:\n                    return False\n                i += 2\n            return True\n\n    class PrimeSieve:\n        \"\"\"Sieve of Eratosthenes implementation.\"\"\"\n        def generate_primes(self, limit: int) -> list[int]:\n            if limit < 2:\n                return []\n            sieve = [True] * (limit + 1)\n            sieve[0] = sieve[1] = False\n            for p in range(2, int(limit**0.5) + 1):\n                if sieve[p]:\n                    for multiple in range(p*p, limit + 1, p):\n                        sieve[multiple] = False\n            return [i for i, is_prime in enumerate(sieve) if is_prime]\n\n    if n < 0:\n        raise ValueError(\"Input must be non\u2011negative\")\n    primes = PrimeSieve().generate_primes(n)\n    lucid_numbers = [1] if n >= 1 else []\n    lucid_numbers.extend(primes)\n    return sorted(lucid_numbers)"}
