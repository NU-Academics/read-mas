{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(input_list: list[list]) -> int:\n    \"\"\"\n    Finds the length of the smallest list in a list of lists.\n    Returns 0 if the input list is empty.\n    \"\"\"\n    if not input_list:\n        return 0\n\n    min_length = len(input_list[0])\n    for inner_list in input_list[1:]:\n        current_length = len(inner_list)\n        if current_length < min_length:\n            min_length = current_length\n            \n    return min_length"}
{"task_id": "Mbpp/97", "solution": "def frequency_lists(list_of_lists):\n    \"\"\"\n    Calculates the frequency of each element in a flattened list of lists.\n    Returns a dictionary mapping each unique element to its count.\n    \"\"\"\n    flattened_list = [item for sublist in list_of_lists for item in sublist]\n    \n    frequencies = {}\n    for item in flattened_list:\n        frequencies[item] = frequencies.get(item, 0) + 1\n        \n    return frequencies"}
{"task_id": "Mbpp/96", "solution": "import math\ndef divisor(n: int) -> int:\n    \"\"\"Return the number of positive divisors of n.\n\n    The function iterates up to the square root of n to find divisors.\n    \"\"\"\n    if n == 0:\n        return 0\n    \n    n = abs(n)\n    count = 0\n    \n    # Iterate from 1 up to the square root of n\n    # math.isqrt is an optimized way to get integer square root\n    root = int(math.isqrt(n)) \n    \n    for i in range(1, root + 1):\n        if n % i == 0:\n            if i * i == n:  # If i is the square root, it's counted once\n                count += 1\n            else:           # Otherwise, i and n//i are two distinct divisors\n                count += 2\n    return count"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal: int) -> str:\n    \"\"\"\n    Converts a non-negative decimal integer to its binary string representation.\n    The result has no leading zeros, except for the number zero itself which returns '0'.\n    \"\"\"\n    if decimal == 0:\n        return \"0\"\n\n    binary_digits = []\n    while decimal > 0:\n        remainder = decimal % 2\n        binary_digits.append(str(remainder))\n        decimal //= 2\n    \n    return \"\".join(binary_digits[::-1])"}
{"task_id": "Mbpp/98", "solution": "from typing import Iterable, Union\ndef multiply_num(seq: Iterable[Union[int, float]]) -> float:\n    \"\"\"\n    Multiply all numeric elements in `seq` and divide the product by the number of elements.\n    Raises ValueError if `seq` is empty or contains non\u2011numeric elements.\n    \"\"\"\n    # Convert to list to allow len() and multiple passes\n    values = list(seq)\n\n    if not values:\n        raise ValueError(\"Input sequence must contain at least one numeric value.\")\n\n    product = 1.0\n    for v in values:\n        if not isinstance(v, (int, float)):\n            raise ValueError(f\"Non\u2011numeric element detected: {v!r}\")\n        product *= v\n\n    return product / len(values)"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    s = str(n)\n    L = len(s)\n    half = L // 2\n    has_middle = (L % 2 == 1)\n\n    # Construct an initial candidate palindrome by mirroring the left half\n    left_part = s[:half]\n    middle_char = s[half] if has_middle else ''\n    \n    candidate_str = left_part + middle_char + left_part[::-1]\n    \n    # If the candidate is already greater than n, it's the answer\n    if int(candidate_str) > n:\n        return int(candidate_str)\n    else:\n        # Otherwise, we need to increment the left half (including middle digit if L is odd)\n        # and then mirror to find the next palindrome\n        \n        # Determine the prefix that needs to be incremented\n        if has_middle:\n            incrementable_prefix_str = s[:half+1]\n        else:\n            incrementable_prefix_str = s[:half]\n\n        # Increment the prefix as an integer\n        incremented_prefix_int = int(incrementable_prefix_str) + 1\n        incremented_prefix_str = str(incremented_prefix_int)\n\n        # Check if incrementing the prefix resulted in a longer prefix (e.g., '9' -> '10')\n        original_prefix_len = len(incrementable_prefix_str)\n        new_prefix_len = len(incremented_prefix_str)\n\n        if new_prefix_len > original_prefix_len:\n            # If prefix length increased, it means the entire number was composed of 9s in its relevant half.\n            # The next palindrome will have L+1 digits and be of the form 10...01.\n            # For example, 99 -> 101, 9 -> 11, 999 -> 1001.\n            return int('1' + '0' * (L - 1) + '1')\n        else:\n            # Construct the new palindrome from the incremented prefix\n            new_left_part = incremented_prefix_str[:half]\n            new_middle_char = incremented_prefix_str[half] if has_middle else ''\n            final_palindrome_str = new_left_part + new_middle_char + new_left_part[::-1]\n            return int(final_palindrome_str)"}
