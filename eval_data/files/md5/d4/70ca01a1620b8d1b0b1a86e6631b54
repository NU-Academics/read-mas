{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers using closed-form formulas.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    sum_of_numbers = n * (n + 1) // 2\n    sum_of_cubes = sum_of_numbers ** 2\n    \n    return sum_of_cubes - sum_of_numbers"}
{"task_id": "Mbpp/556", "solution": "from typing import List\ndef find_Odd_Pair(numbers: List[int], n: int) -> int:\n    \"\"\"\n    Count unordered pairs of integers in `numbers` whose XOR is odd.\n\n    Raises\n    ------\n    ValueError\n        If `n` does not match `len(numbers)`.\n    \"\"\"\n    if n != len(numbers):\n        raise ValueError(f\"Declared length {n} does not match actual length {len(numbers)}\")\n\n    if n < 2:\n        return 0\n\n    even_count = 0\n    odd_count = 0\n    for num in numbers:\n        if num & 1:  # odd if least\u2011significant bit is 1\n            odd_count += 1\n        else:\n            even_count += 1\n\n    return even_count * odd_count"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string):\n    \"\"\"\n    Toggles the case of all alphabetic characters in the input string.\n    Non-alphabetic characters remain unchanged.\n    \"\"\"\n    toggled_chars = []\n    for char in input_string:\n        if 'a' <= char <= 'z':  # Check for lowercase Basic Latin\n            toggled_chars.append(char.upper())\n        elif 'A' <= char <= 'Z':  # Check for uppercase Basic Latin\n            toggled_chars.append(char.lower())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"Calculate the sum of the absolute per-digit differences between two non-negative integers.\n    Digits are compared from least significant, with missing digits treated as zero.\n    \"\"\"\n    sum_diff = 0\n    while a > 0 or b > 0:\n        digit_a = a % 10\n        digit_b = b % 10\n        sum_diff += abs(digit_a - digit_b)\n        a //= 10\n        b //= 10\n    return sum_diff"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr: list[int], length: int) -> int:\n    \"\"\"\n    Finds the maximum sum of a contiguous sublist in the given list using a variant of Kadane's algorithm.\n    Handles empty lists, lists with all negative numbers, and mixed lists.\n    \"\"\"\n    if length == 0:\n        return 0\n\n    max_current = 0\n    max_global = 0\n\n    # These variables help handle the edge case where all numbers are negative or non-positive.\n    has_positive_number = False\n    max_element_if_all_non_positive = float('-inf')\n\n    for x in arr:\n        if x > 0:\n            has_positive_number = True\n        \n        # Track the largest individual element, useful if all subarrays sum to <= 0.\n        max_element_if_all_non_positive = max(max_element_if_all_non_positive, x)\n\n        # Update current max sum: either start a new subarray with x, or extend current_max.\n        max_current = max(x, max_current + x)\n        \n        # Update global max sum.\n        max_global = max(max_global, max_current)\n    \n    # After the loop, if no positive numbers were found and max_global is still 0\n    # (meaning all sums were non-positive or max_global never rose above 0),\n    # return the largest single element found. This covers cases like [-1, -2] should return -1.\n    if not has_positive_number and max_global == 0:\n        return max_element_if_all_non_positive\n\n    return max_global"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(input_list: list[list[int]]) -> int:\n    \"\"\"Finds the length of the longest sublist within a list of lists.\n    Returns 0 if the input list is empty or contains only empty sublists.\"\"\"\n    max_length = 0\n    for sublist in input_list:\n        max_length = max(max_length, len(sublist))\n    return max_length"}
{"task_id": "Mbpp/563", "solution": "import re\nfrom dataclasses import dataclass\nclass StringExtractor:\n    \"\"\"Encapsulates the logic for extracting quoted substrings.\"\"\"\n    def extract_values(self, input_string: str) -> list[ExtractedValue]:\n        \"\"\"Finds all substrings enclosed in double quotes.\"\"\"\n        pattern = r'\"([^\"]*)\"'\n        matches = re.findall(pattern, input_string)\n        return [ExtractedValue(value) for value in matches]\ndef extract_values(text: str) -> list[str]:\n    \"\"\"Extracts values between double quotation marks from a string.\n\n    This function forwards the extraction logic to an internal StringExtractor service.\n    \"\"\"\n    extractor = StringExtractor()\n    extracted_objects = extractor.extract_values(text)\n    return [ev.value for ev in extracted_objects]"}
