{"task_id": "Mbpp/620", "solution": "from typing import List\ndef largest_subset(input_list: List[int]) -> int:\n    \"\"\"\n    Calculates the size of the largest subset of the input list\n    where for any two distinct elements `x` and `y` within the subset,\n    either `x % y == 0` or `y % x == 0`.\n    \"\"\"\n    if not input_list:\n        return 0\n\n    sorted_nums = sorted(input_list)\n    n = len(sorted_nums)\n\n    dp = [1] * n\n\n    for i in range(n):\n        for j in range(i):\n            if sorted_nums[j] != 0 and sorted_nums[i] % sorted_nums[j] == 0:\n                dp[i] = max(dp[i], 1 + dp[j])\n\n    return max(dp)"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers: list[int]) -> int:\n    \"\"\"\n    Calculates the size of the largest subset of a list of numbers\n    where every pair is divisible.\n    This uses dynamic programming after sorting the input list.\n    \"\"\"\n    if not numbers:\n        return 0\n    if len(numbers) == 1:\n        return 1\n\n    numbers.sort()\n    dp = [1] * len(numbers)\n\n    for i in range(1, len(numbers)):\n        for j in range(i):\n            if numbers[i] % numbers[j] == 0:\n                dp[i] = max(dp[i], dp[j] + 1)\n\n    return max(dp)"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1, list2, n):\n    \"\"\"Calculates the median of two sorted lists of the same size.\n    It finds the two middle elements from the conceptually merged list and returns their average.\n    \"\"\"\n    i = 0  # Pointer for list1\n    j = 0  # Pointer for list2\n\n    # m1 will store the (n-1)-th smallest element (0-indexed)\n    # m2 will store the n-th smallest element (0-indexed)\n    m1 = 0\n    m2 = 0\n\n    # Iterate n+1 times to find the elements at indices n-1 and n\n    # from the conceptually merged list.\n    for count in range(n + 1):\n        # Case 1: All elements of list1 are processed\n        if i == n:\n            m1 = m2\n            m2 = list2[j]\n            j += 1\n        # Case 2: All elements of list2 are processed\n        elif j == n:\n            m1 = m2\n            m2 = list1[i]\n            i += 1\n        # Case 3: Current element in list1 is smaller\n        elif list1[i] < list2[j]:\n            m1 = m2\n            m2 = list1[i]\n            i += 1\n        # Case 4: Current element in list2 is smaller or equal\n        else:\n            m1 = m2\n            m2 = list2[j]\n            j += 1\n\n    # The median is the average of the two middle elements found\n    return float(m1 + m2) / 2.0"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1: list[float], list2: list[float], n: int) -> float:\n    \"\"\"\n    Calculates the median of two sorted lists of the same size n.\n    It efficiently finds the n-th and (n+1)-th elements of the combined sorted list.\n    \"\"\"\n    i = 0  # Pointer for list1\n    j = 0  # Pointer for list2\n    m1 = 0.0  # Stores the n-th element encountered\n    m2 = 0.0  # Stores the (n+1)-th element encountered\n\n    # Iterate n+1 times to find the n-th and (n+1)-th elements of the combined list.\n    for _ in range(n + 1):\n        m1 = m2  # The previous m2 becomes the n-th element candidate\n\n        # Determine the next smallest element from either list1 or list2\n        # and advance the corresponding pointer.\n        if i == n: # list1 is exhausted\n            m2 = list2[j]\n            j += 1\n        elif j == n: # list2 is exhausted\n            m2 = list1[i]\n            i += 1\n        elif list1[i] <= list2[j]:\n            m2 = list1[i]\n            i += 1\n        else: # list2[j] < list1[i]\n            m2 = list2[j]\n            j += 1\n\n    return (m1 + m2) / 2.0"}
