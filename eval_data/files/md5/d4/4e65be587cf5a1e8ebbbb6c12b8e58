{"task_id": "Mbpp/109", "solution": "def _rotate_string(s):\n    \"\"\"Rotates a binary string one position to the left.\n    It moves the first character to the end of the string.\n    \"\"\"\n    return s[1:] + s[0]\ndef _binary_to_decimal(binary_str):\n    \"\"\"Converts a binary string to its decimal integer representation.\n    This function utilizes Python's built-in base-2 integer conversion.\n    \"\"\"\n    return int(binary_str, 2)\ndef _is_odd(decimal_num):\n    \"\"\"Checks if a decimal integer is an odd number.\n    It returns True if the number is odd, and False otherwise.\n    \"\"\"\n    return decimal_num % 2 != 0\ndef odd_Equivalent(s, n):\n    \"\"\"Calculates the number of numbers with an odd value when rotating a binary string.\n    It counts how many of 'n' rotations of 's' convert to an odd decimal integer.\n    \"\"\"\n    odd_count = 0\n    current_s = s\n\n    for _ in range(n):\n        decimal_val = _binary_to_decimal(current_s)\n        if _is_odd(decimal_val):\n            odd_count += 1\n        current_s = _rotate_string(current_s)\n\n    return odd_count"}
{"task_id": "Mbpp/113", "solution": "def check_integer(inputString):\n    \"\"\"\n    Checks if a string represents an integer, allowing an optional sign.\n    Returns True for valid integers, False otherwise.\n    \"\"\"\n    if not inputString:\n        return False\n\n    start_index = 0\n    if inputString[0] == '+' or inputString[0] == '-':\n        start_index = 1\n\n    # An integer must have at least one digit after an optional sign.\n    if start_index == len(inputString):\n        return False\n\n    for i in range(start_index, len(inputString)):\n        if not ('0' <= inputString[i] <= '9'):\n            return False\n\n    return True"}
{"task_id": "Mbpp/116", "solution": "def tuple_to_int(input_tuple: tuple[int, ...]) -> int:\n    \"\"\"Converts a tuple of positive integers into a single integer by concatenating their string representations.\n    Handles empty tuples by returning 0 and single-element tuples by returning the element itself.\"\"\"\n    if not input_tuple:\n        return 0\n    elif len(input_tuple) == 1:\n        return input_tuple[0]\n    else:\n        concatenated_string = \"\".join(str(i) for i in input_tuple)\n        return int(concatenated_string)"}
{"task_id": "Mbpp/111", "solution": "from typing import List, Any, Set\ndef common_in_nested_lists(nested_lists: List[List[Any]]) -> Set[Any]:\n    \"\"\"\n    Finds elements common across all lists within a nested list structure.\n    Returns a set of elements present in every inner list, or an empty set if none are found.\n    \"\"\"\n    if not nested_lists:\n        return set()\n\n    # Initialize the set of common elements with the elements from the first list.\n    common_elements = set(nested_lists[0])\n\n    # Iterate through the rest of the lists to find the intersection.\n    for i in range(1, len(nested_lists)):\n        current_list_set = set(nested_lists[i])\n        common_elements = common_elements.intersection(current_list_set)\n        # Optimization: If at any point common_elements becomes empty, no further common elements can exist.\n        if not common_elements:\n            break\n\n    return common_elements"}
{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(s: str, n: int) -> int:\n    \"\"\"Calculates the count of odd decimal equivalents from a binary string after n left rotations.\n    It rotates the string, converts it to an integer, and increments a counter if the integer is odd.\n    \"\"\"\n    odd_count = 0\n    current_s = s\n\n    for _ in range(n):\n        val = int(current_s, 2)\n        if val % 2 == 1:\n            odd_count += 1\n        current_s = current_s[1:] + current_s[0]\n\n    return odd_count"}
