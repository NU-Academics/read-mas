{"task_id": "Mbpp/463", "solution": "def max_subarray_product(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum product of a contiguous subarray within the given array.\n    Handles positive, negative, and zero integers efficiently in O(N) time.\n    \"\"\"\n    if not arr:\n        return 0 # Or raise an error, depending on desired behavior for empty arrays\n\n    max_so_far = arr[0]\n    current_max = arr[0]\n    current_min = arr[0]\n\n    for i in range(1, len(arr)):\n        num = arr[i]\n\n        # Store previous current_max to correctly calculate current_min\n        temp_current_max = current_max\n\n        # current_max can be the number itself, or num * previous_current_max, or num * previous_current_min\n        current_max = max(num, num * temp_current_max, num * current_min)\n        # current_min can be the number itself, or num * previous_current_max, or num * previous_current_min\n        current_min = min(num, num * temp_current_max, num * current_min)\n\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/468", "solution": "from typing import List, Union\ndef _calculate_max_product_dp(numbers: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the maximum product of an increasing subsequence using dynamic programming.\n    Each dp[i] stores the max product of an increasing subsequence ending at numbers[i].\n    \"\"\"\n    n = len(numbers)\n    if n == 0:\n        return 0\n\n    dp = list(numbers)  # Initialize dp[i] with numbers[i] itself.\n    max_overall_product = max(dp) if dp else 0  # Stores the overall maximum product found.\n\n    for i in range(1, n):\n        for j in range(i):\n            if numbers[i] > numbers[j]:\n                # Extend an increasing subsequence ending at j.\n                dp[i] = max(dp[i], numbers[i] * dp[j])\n        max_overall_product = max(max_overall_product, dp[i])\n\n    return max_overall_product\ndef max_product(numbers: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Serves as the main entry point for finding the maximum product of an increasing subsequence.\n    It delegates the core computation to an internal DP function.\n    \"\"\"\n    return _calculate_max_product_dp(numbers)"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple: tuple) -> tuple:\n    \"\"\"Computes the sum of adjacent elements in a tuple of numbers.\n    Returns a new tuple where each element is the sum of a pair.\"\"\"\n    if len(input_tuple) < 2:\n        return ()\n\n    sums = []\n    for i in range(len(input_tuple) - 1):\n        sums.append(input_tuple[i] + input_tuple[i+1])\n\n    return tuple(sums)"}
{"task_id": "Mbpp/468", "solution": "def max_product(arr: list) -> float:\n    \"\"\"\n    Calculates the maximum product of an increasing subsequence within the array.\n    It handles empty arrays and strictly increasing subsequences, assuming positive numbers.\n    \"\"\"\n    if not arr:\n        return 1.0  # Empty array product is 1\n\n    n = len(arr)\n    # dp[i] stores the maximum product of an increasing subsequence ending at index i.\n    dp = [float(x) for x in arr]  # Each element is an increasing subsequence of length 1.\n\n    for i in range(n):\n        for j in range(i):\n            if arr[i] > arr[j]:  # Check for strictly greater condition.\n                # Update dp[i] if extending the subsequence ending at arr[j] yields a larger product.\n                dp[i] = max(dp[i], dp[j] * arr[i])\n\n    return max(dp)"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(numbers: tuple) -> tuple:\n    \"\"\"Calculates the sum of adjacent elements in a tuple, returning a new tuple.\n    Returns an empty tuple if the input has fewer than two elements.\"\"\"\n    if len(numbers) < 2:\n        return ()\n\n    result_list = []\n    for i in range(len(numbers) - 1):\n        result_list.append(numbers[i] + numbers[i+1])\n\n    return tuple(result_list)"}
