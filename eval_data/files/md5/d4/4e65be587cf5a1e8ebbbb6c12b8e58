{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list: list, sub_list: list) -> bool:\n    \"\"\"\n    Checks if sub_list is a contiguous sublist of main_list.\n    Returns True if sub_list is found as a contiguous sequence in main_list, False otherwise.\n    \"\"\"\n    if not sub_list:\n        return True\n\n    if len(sub_list) > len(main_list):\n        return False\n\n    n = len(main_list)\n    m = len(sub_list)\n\n    for i in range(n - m + 1):\n        if main_list[i : i + m] == sub_list:\n            return True\n\n    return False"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array: list[float | int]) -> bool:\n    \"\"\"\n    Checks if an array of numbers is monotonic.\n    An array is monotonic if it is either entirely non-increasing or entirely non-decreasing.\n    \"\"\"\n    if len(array) <= 1:\n        return True\n\n    is_non_increasing = True\n    is_non_decreasing = True\n\n    for i in range(1, len(array)):\n        if array[i] < array[i-1]:\n            is_non_decreasing = False\n        if array[i] > array[i-1]:\n            is_non_increasing = False\n\n        if not is_non_increasing and not is_non_decreasing:\n            return False\n\n    return is_non_increasing or is_non_decreasing"}
