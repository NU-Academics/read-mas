{"task_id": "Mbpp/128", "solution": "from typing import List\nclass LengthThreshold:\n    \"\"\"\n    Encapsulates the integer length threshold.\n    \"\"\"\n    def __init__(self, value: int):\n        self.value = value\nclass Word:\n    \"\"\"\n    Represents a single word, storing its value and length.\n    \"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\n\n    def is_longer_than(self, threshold: LengthThreshold) -> bool:\n        \"\"\"\n        Compares the word's length against a given threshold.\n        \"\"\"\n        return self.length > threshold.value\nclass Text:\n    \"\"\"\n    Manages the input text string and provides a method to extract Word objects.\n    \"\"\"\n    def __init__(self, content: str):\n        self.content = content\n\n    def get_words(self) -> List[Word]:\n        \"\"\"\n        Splits the text content into individual words and creates Word objects.\n        \"\"\"\n        raw_words = self.content.split()\n        return [Word(word) for word in raw_words]\nclass LongWordList:\n    \"\"\"\n    Collects Word objects that meet the length criterion and provides their string values.\n    \"\"\"\n    def __init__(self):\n        self.words: List[Word] = []\n\n    def add_word(self, word: Word):\n        \"\"\"\n        Adds a Word object to the collection.\n        \"\"\"\n        self.words.append(word)\n\n    def get_values(self) -> List[str]:\n        \"\"\"\n        Returns a list of string values from the collected Word objects.\n        \"\"\"\n        return [word.value for word in self.words]\ndef long_words(n: int, text_string: str) -> List[str]:\n    \"\"\"\n    Finds words strictly longer than 'n' characters from the input text string.\n    This function orchestrates the process using helper classes.\n    \"\"\"\n    threshold = LengthThreshold(n)\n    text_obj = Text(text_string)\n    long_words_list = LongWordList()\n\n    for word_obj in text_obj.get_words():\n        if word_obj.is_longer_than(threshold):\n            long_words_list.add_word(word_obj)\n\n    return long_words_list.get_values()"}
{"task_id": "Mbpp/130", "solution": "from collections import Counter\nfrom typing import List, Any\ndef max_occurrences(input_list: List[Any]) -> Any:\n    \"\"\"\n    Finds the item with the maximum frequency in a list, returning `None` for an empty list.\n    If multiple items share the highest frequency, any one of them may be returned.\n    \"\"\"\n    if not input_list:\n        return None # Handles an empty list as specified in the design.\n\n    item_counts = Counter(input_list)\n\n    # most_common(1) returns a list of the single most common item and its count, e.g., [(item, count)].\n    most_common_item, _ = item_counts.most_common(1)[0]\n\n    return most_common_item"}
{"task_id": "Mbpp/130", "solution": "import collections\ndef max_occurrences(input_list: list) -> any:\n    \"\"\"\n    Identifies and returns the item that appears most frequently in the input list.\n    Uses collections.Counter for efficient frequency mapping and retrieval.\n    \"\"\"\n    if not input_list:\n        return None  # Or handle as per specific requirement for empty lists, assuming non-empty for this problem.\n\n    frequency_map = collections.Counter(input_list)\n    # most_common(1) returns a list of the 1 most common elements as tuples (item, count).\n    # We take the first element of this list, and then the item part of the tuple.\n    max_frequency_item = frequency_map.most_common(1)[0][0]\n    return max_frequency_item"}
{"task_id": "Mbpp/128", "solution": "def long_words(n: int, text: str) -> list[str]:\n    \"\"\"Filters words from text, returning those strictly longer than n characters.\"\"\"\n    words = text.split()\n    long_words_list = []\n    for word in words:\n        if len(word) > n:\n            long_words_list.append(word)\n    return long_words_list"}
{"task_id": "Mbpp/131", "solution": "def _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is a vowel (a, e, i, o, u, case-insensitive, excluding 'y').\"\"\"\n    return char.lower() in ('a', 'e', 'i', 'o', 'u')\ndef reverse_vowels(s: str) -> str:\n    \"\"\"Reverses the order of only the vowels in a given string, keeping other characters in place.\"\"\"\n    char_list = list(s)\n    vowel_indices = []\n    vowels_found = []\n\n    for i, char in enumerate(char_list):\n        if _is_vowel(char):\n            vowel_indices.append(i)\n            vowels_found.append(char)\n\n    vowels_found.reverse()\n\n    for i, original_index in enumerate(vowel_indices):\n        char_list[original_index] = vowels_found[i]\n\n    return \"\".join(char_list)"}
{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix: list[list[int]]) -> bool:\n    \"\"\"Checks if a given matrix is a magic square.\n    This includes verifying squareness and equality of all row, column, and diagonal sums.\n    \"\"\"\n\n    class Matrix:\n        \"\"\"Represents a 2D integer matrix and provides access to its properties.\"\"\"\n        def __init__(self, elements: list[list[int]]):\n            self.elements = elements\n\n        def getRowCount(self) -> int:\n            \"\"\"Returns the number of rows in the matrix.\"\"\"\n            return len(self.elements)\n\n        def getColumnCount(self) -> int:\n            \"\"\"Returns the number of columns in the matrix.\"\"\"\n            return len(self.elements[0]) if self.elements else 0\n\n        def getElement(self, row: int, col: int) -> int:\n            \"\"\"Returns the element at the specified row and column.\"\"\"\n            return self.elements[row][col]\n\n        def isSquare(self) -> bool:\n            \"\"\"Checks if the matrix has an equal number of rows and columns and is not empty.\"\"\"\n            rows = self.getRowCount()\n            cols = self.getColumnCount()\n            return rows > 0 and rows == cols\n\n    class MagicSquareChecker:\n        \"\"\"Determines if a given matrix constitutes a magic square.\"\"\"\n\n        def _calculateRowSum(self, matrix: Matrix, rowIdx: int) -> int:\n            \"\"\"Calculates the sum of all elements in a specific row.\"\"\"\n            current_sum = 0\n            for col in range(matrix.getColumnCount()):\n                current_sum += matrix.getElement(rowIdx, col)\n            return current_sum\n\n        def _calculateColumnSum(self, matrix: Matrix, colIdx: int) -> int:\n            \"\"\"Calculates the sum of all elements in a specific column.\"\"\"\n            current_sum = 0\n            for row in range(matrix.getRowCount()):\n                current_sum += matrix.getElement(row, colIdx)\n            return current_sum\n\n        def _calculateMainDiagonalSum(self, matrix: Matrix) -> int:\n            \"\"\"Calculates the sum of elements along the main diagonal.\"\"\"\n            current_sum = 0\n            size = matrix.getRowCount()\n            for i in range(size):\n                current_sum += matrix.getElement(i, i)\n            return current_sum\n\n        def _calculateAntiDiagonalSum(self, matrix: Matrix) -> int:\n            \"\"\"Calculates the sum of elements along the anti-diagonal.\"\"\"\n            current_sum = 0\n            size = matrix.getRowCount()\n            for i in range(size):\n                current_sum += matrix.getElement(i, size - 1 - i)\n            return current_sum\n\n        def checkMagicSquare(self, matrix_data: list[list[int]]) -> bool:\n            \"\"\"Verifies if the input matrix_data represents a magic square.\"\"\"\n            matrix_instance = Matrix(matrix_data)\n\n            if not matrix_instance.isSquare():\n                return False\n\n            size = matrix_instance.getRowCount()\n            target_sum = self._calculateRowSum(matrix_instance, 0)\n\n            for i in range(size):\n                if self._calculateRowSum(matrix_instance, i) != target_sum:\n                    return False\n\n            for i in range(size):\n                if self._calculateColumnSum(matrix_instance, i) != target_sum:\n                    return False\n\n            if self._calculateMainDiagonalSum(matrix_instance) != target_sum:\n                return False\n\n            if self._calculateAntiDiagonalSum(matrix_instance) != target_sum:\n                return False\n\n            return True\n\n    checker = MagicSquareChecker()\n    return checker.checkMagicSquare(matrix)"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    # Identifies vowels (a, e, i, o, u, case-insensitive, 'y' is not a vowel) and reverses their order.\n    # Non-vowel characters maintain their original positions.\n    vowel_set = \"aeiouAEIOU\"\n    s_list = list(s)\n    extracted_vowels = []\n    vowel_indices = []\n\n    for i, char in enumerate(s_list):\n        if char in vowel_set:\n            extracted_vowels.append(char)\n            vowel_indices.append(i)\n\n    extracted_vowels.reverse()\n\n    for i, original_index in enumerate(vowel_indices):\n        s_list[original_index] = extracted_vowels[i]\n\n    return \"\".join(s_list)"}
