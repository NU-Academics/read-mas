{"task_id": "Mbpp/751", "solution": "def check_min_heap(array):\n    \"\"\"\n    Checks if the given array represents a valid min-heap.\n    Handles empty or single-element arrays as valid min-heaps.\n    \"\"\"\n    n = len(array)\n\n    # FR3 / BR3: Handle empty or single-element arrays\n    if n <= 1:\n        return True\n\n    # Iterate through all non-leaf nodes\n    # Non-leaf nodes are at indices from 0 up to (n // 2) - 1\n    for i in range(n // 2):\n        left_child_index = 2 * i + 1\n        right_child_index = 2 * i + 2\n\n        # BR1: Check left child property\n        if left_child_index < n:\n            if array[i] > array[left_child_index]:\n                return False # FR4: Min-heap property violated\n\n        # BR2: Check right child property if it exists\n        if right_child_index < n:\n            if array[i] > array[right_child_index]:\n                return False # FR4: Min-heap property violated\n\n    # FR3: If no violations are found, it's a valid min-heap\n    return True"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n):\n    \"\"\"Calculates the nth Jacobsthal number using an iterative approach.\n    Assumes n is a non-negative integer.\"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    else:\n        j_prev2 = 0  # Represents J(0)\n        j_prev1 = 1  # Represents J(1)\n        for _ in range(2, n + 1):\n            j_current = j_prev1 + 2 * j_prev2\n            j_prev2 = j_prev1\n            j_prev1 = j_current\n        return j_current"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr: list) -> bool:\n    \"\"\"\n    Checks if the given array represents a valid min-heap.\n    Returns True for empty or single-element arrays, and False if any parent is greater than its child.\n    \"\"\"\n    n = len(arr)\n\n    # Edge cases: empty or single-element arrays are valid min-heaps.\n    if n <= 1:\n        return True\n\n    # Iterate through all possible parent nodes in the array.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Verify the min-heap property with the left child.\n        if left_child_idx < n and arr[i] > arr[left_child_idx]:\n            return False\n\n        # Verify the min-heap property with the right child.\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n\n    # If no violations were found after checking all parent nodes, the array is a min-heap.\n    return True"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"Calculates the nth Jacobsthal number using recursion.\n    Handles base cases for n=0 and n=1, and applies the recurrence relation for n > 1.\"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    else:\n        return jacobsthal_num(n - 1) + 2 * jacobsthal_num(n - 2)"}
{"task_id": "Mbpp/753", "solution": "def min_k(records: list[tuple[str, int]], k: int) -> list[tuple[str, int]]:\n    \"\"\"\n    Finds the k records with the smallest values from a list of tuples.\n    Records are sorted by their second element (value) in ascending order.\n    \"\"\"\n    if k == 0 or not records:\n        return []\n\n    sorted_records = sorted(records, key=lambda record: record[1])\n    return sorted_records[:k]"}
