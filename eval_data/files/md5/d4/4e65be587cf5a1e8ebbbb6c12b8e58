{"task_id": "Mbpp/12", "solution": "def sort_matrix(matrix: list[list[float]]) -> list[list[float]]:\n    \"\"\"Sorts a matrix by the sum of its rows in ascending order.\n    It pairs each row with its sum, sorts these pairs, and reconstructs the matrix.\n    \"\"\"\n    rows_with_sums = []\n    for row in matrix:\n        rows_with_sums.append((sum(row), row))\n\n    rows_with_sums.sort()  # Sorts based on the sum (first element of tuple)\n\n    sorted_matrix = [row for _, row in rows_with_sums]\n    return sorted_matrix"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, char_to_to_remove: str) -> str:\n    \"\"\"Removes the first and last occurrences of a specified character from an input string.\n    Returns the original string if the character is not found.\n    \"\"\"\n    first_index = input_string.find(char_to_to_remove)\n\n    if first_index == -1:\n        return input_string\n\n    last_index = input_string.rfind(char_to_to_remove)\n\n    if first_index == last_index:\n        # Character appears only once\n        return input_string[:first_index] + input_string[first_index + 1:]\n    else:\n        # Character appears multiple times\n        return input_string[:first_index] + \\\n               input_string[first_index + 1:last_index] + \\\n               input_string[last_index + 1:]"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(inputString: str, charToRemove: str) -> str:\n    \"\"\"Removes the first and last occurrences of a specified character from an input string.\n    Handles various edge cases including empty inputs and single character occurrences.\"\"\"\n\n    # Handle empty inputString (FR9)\n    if not inputString:\n        return \"\"\n\n    # Handle empty charToRemove (FR10)\n    if not charToRemove:\n        return inputString\n\n    first_index = inputString.find(charToRemove)\n    last_index = inputString.rfind(charToRemove)\n\n    # Handle character not found (FR7)\n    if first_index == -1:\n        return inputString\n\n    # Handle single occurrence (FR8)\n    if first_index == last_index:\n        return inputString[:first_index] + inputString[first_index + 1:]\n\n    # Handle multiple occurrences (FR2, FR3, FR4, FR5, FR6)\n    # Remove the first occurrence\n    temp_string = inputString[:first_index] + inputString[first_index + 1:]\n\n    # Adjust last_index for the `temp_string` after the first character was removed.\n    # If first_index was before last_index, last_index shifts left by 1.\n    adjusted_last_index = last_index - (1 if first_index < last_index else 0)\n\n    # Remove the last occurrence from the `temp_string` using the adjusted index\n    final_string = temp_string[:adjusted_last_index] + temp_string[adjusted_last_index + 1:]\n\n    return final_string"}
{"task_id": "Mbpp/12", "solution": "def _calculate_row_sum(row: list[int]) -> int:\n    \"\"\"Calculates the sum of elements in a single row.\"\"\"\n    total = 0\n    for x in row:\n        total += x\n    return total\ndef sort_matrix(matrix: list[list[int]]) -> list[list[int]]:\n    \"\"\"Sorts a matrix by the ascending sum of its rows.\"\"\"\n    rows_with_sums = []\n    for row in matrix:\n        row_sum = _calculate_row_sum(row)\n        rows_with_sums.append((row_sum, row))\n\n    rows_with_sums.sort(key=lambda item: item[0])\n\n    sorted_matrix = []\n    for row_sum, original_row in rows_with_sums:\n        sorted_matrix.append(original_row)\n\n    return sorted_matrix"}
{"task_id": "Mbpp/14", "solution": "def find_Volume(base_length: float, face_height: float, prism_length: float) -> float:\n    \"\"\"\n    Calculates the volume of a triangular prism.\n    The volume is derived from the area of the triangular face multiplied by the prism's length.\n    \"\"\"\n    # Calculate the area of the triangular face\n    area_of_face = 0.5 * base_length * face_height\n    # Calculate the volume of the prism\n    calculated_volume = area_of_face * prism_length\n    return calculated_volume"}
