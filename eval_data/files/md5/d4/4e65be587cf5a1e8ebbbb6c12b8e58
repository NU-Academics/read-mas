{"task_id": "Mbpp/96", "solution": "import math\ndef divisor(n: int) -> int:\n    \"\"\"Computes the number of positive divisors for a given integer n.\n    It efficiently counts divisors by iterating up to the square root of n.\n    \"\"\"\n    count = 0\n    for i in range(1, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n    return count"}
{"task_id": "Mbpp/96", "solution": "def divisor(number: int) -> int:\n    \"\"\"Calculates the total count of positive divisors for a given integer.\n    Assumes the input 'number' is a positive integer.\"\"\"\n    count = 0\n    i = 1\n    while i * i <= number:\n        if number % i == 0:\n            if i * i == number:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count"}
{"task_id": "Mbpp/97", "solution": "import collections\nfrom typing import Any, List, Dict\ndef frequency_lists(input_list_of_lists: List[List[Any]]) -> Dict[Any, int]:\n    \"\"\"\n    Flattens a list of lists and counts the occurrences of each element.\n    Returns a dictionary where keys are unique elements and values are their frequencies.\n    \"\"\"\n    flattened_list = [item for sublist in input_list_of_lists for item in sublist]\n    frequency_map = collections.Counter(flattened_list)\n    return dict(frequency_map)"}
{"task_id": "Mbpp/97", "solution": "def frequency_lists(list_of_lists):\n    \"\"\"Calculates the frequency of each element in a flattened list of lists.\n    Returns a dictionary with elements as keys and their counts as values.\"\"\"\n\n    # Flatten the input list of lists into a single, one-dimensional list.\n    flattened_list = [item for sublist in list_of_lists for item in sublist]\n\n    # Calculate the frequency of each element in the flattened list.\n    frequency_map = {}\n    for item in flattened_list:\n        frequency_map[item] = frequency_map.get(item, 0) + 1\n\n    return frequency_map"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"Converts a decimal integer to its binary string representation without leading zeros,\n    except for 0 which returns '0'.\n    \"\"\"\n    if decimal_number == 0:\n        return '0'\n\n    binary_digits = []\n    current_number = decimal_number\n\n    while current_number > 0:\n        remainder = current_number % 2\n        binary_digits.insert(0, str(remainder))\n        current_number //= 2\n\n    return \"\".join(binary_digits)"}
