{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"\n    Checks if the given integer is a Woodall number.\n    A Woodall number is defined as n * 2^n - 1 for some natural number n (n >= 1).\n    \"\"\"\n    if number < 1: # Woodall numbers are natural numbers, so n >= 1, and n*2^n-1 will be >= 1\n        return False\n\n    n = 1\n    while True:\n        woodall_candidate = n * (2**n) - 1\n        if woodall_candidate == number:\n            return True\n        elif woodall_candidate > number:\n            return False\n        n += 1"}
{"task_id": "Mbpp/56", "solution": "def _reverse_integer(n: int) -> int:\n    \"\"\"Reverses the digits of an integer, preserving its sign.\"\"\"\n    sign = -1 if n < 0 else 1\n    abs_n_str = str(abs(n))\n    reversed_abs_n_str = abs_n_str[::-1]\n    return sign * int(reversed_abs_n_str)\ndef check(number: int) -> bool:\n    \"\"\"\n    Checks if an integer is one less than twice its reverse.\n    Assumes valid integer input as per design.\n    \"\"\"\n    reversed_number = _reverse_integer(number)\n    condition_value = (2 * reversed_number) - 1\n    return number == condition_value"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(number):\n    \"\"\"\n    Checks if an integer is a Woodall number using the formula n * 2^n - 1.\n    Iteratively calculates Woodall candidates until a match is found or exceeded.\n    \"\"\"\n    if number <= 0:\n        return False\n\n    n = 1\n    while True:\n        woodall_candidate = n * (2**n) - 1\n        if woodall_candidate == number:\n            return True\n        elif woodall_candidate > number:\n            return False\n        n += 1"}
