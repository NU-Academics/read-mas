{"task_id": "Mbpp/723", "solution": "class Counter:\n    \"\"\"Encapsulates the count of identical pairs.\n    Provides methods to manipulate its internal value.\"\"\"\n\n    def __init__(self):\n        \"\"\"Initializes the counter's value to 0.\"\"\"\n        self._value = 0\n\n    def increment(self):\n        \"\"\"Increases the internal value by 1.\"\"\"\n        self._value += 1\n\n    def get_value(self) -> int:\n        \"\"\"Returns the current value of the counter.\"\"\"\n        return self._value\ndef count_same_pair(list1: list, list2: list) -> int:\n    \"\"\"Counts indices where list1 and list2 have the same values.\n    Raises ValueError if lists are not of equal length.\"\"\"\n\n    if len(list1) != len(list2):\n        raise ValueError(\"Input lists must be of equal length.\")\n\n    counter = Counter()\n    for i in range(len(list1)):\n        if list1[i] == list2[i]:\n            counter.increment()\n\n    return counter.get_value()"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sorted_list, value):\n    \"\"\"Locates the left insertion point for a value in a sorted list using binary search.\n    Returns the index where the value should be inserted to maintain sorted order.\"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sorted_list: list[float | int], value: float | int) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted list using binary search.\n    Assumes the input `sorted_list` is sorted in ascending order.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
