{"task_id": "Mbpp/564", "solution": "def count_Pairs(numbers: list[int], n: int) -> int:\n    \"\"\"Counts unique elements from 'numbers' that are not equal to 'n'.\n    This represents the number of unique unordered pairs (x, n) where x != n.\"\"\"\n\n    unique_elements = set(numbers)\n    pair_count = 0\n    for x in unique_elements:\n        if x != n:\n            pair_count += 1\n    return pair_count"}
{"task_id": "Mbpp/566", "solution": "def sum_digits(number: int) -> int:\n    \"\"\"Calculates the sum of the digits of a non-negative integer.\n    Returns 0 if the input number is 0, otherwise sums digits by string conversion.\"\"\"\n    if number == 0:\n        return 0\n\n    total_sum = 0\n    for digit_char in str(number):\n        total_sum += int(digit_char)\n\n    return total_sum"}
{"task_id": "Mbpp/566", "solution": "def sum_digits(number: int) -> int:\n    \"\"\"\n    Calculates the sum of the digits of a non-negative integer.\n    It extracts digits using modulo and integer division.\n    \"\"\"\n    total_sum = 0\n    while number > 0:\n        total_sum += number % 10\n        number //= 10\n    return total_sum"}
