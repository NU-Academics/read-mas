{"task_id": "Mbpp/166", "solution": "from typing import List\ndef find_even_pair(integer_list: List[int]) -> int:\n    \"\"\"\n    Counts pairs of distinct integers in a list that XOR to an even number.\n    This occurs if both integers are even, or both are odd, following BR1, BR2, BR3, BR4, BR5.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Optimization based on BR4 and BR5: we only need to count pairs of (even, even) and (odd, odd).\n    for num in integer_list:\n        if num % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    count = (even_count * (even_count - 1)) // 2\n    count += (odd_count * (odd_count - 1)) // 2\n\n    return count"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(numbers: list[int]) -> int:\n    \"\"\"Counts pairs of integers in a list whose bitwise XOR result is an even number.\"\"\"\n    even_xor_count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            # A property of XOR:\n            # (odd ^ odd) = even\n            # (even ^ even) = even\n            # (odd ^ even) = odd\n            # So, if both numbers have the same parity (both odd or both even), their XOR will be even.\n            # We can check parity using the modulo operator or bitwise AND with 1.\n            if (numbers[i] % 2) == (numbers[j] % 2):\n                even_xor_count += 1\n    return even_xor_count"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Calculates the smallest power of 2 greater than or equal to n. Returns 1 for n=0.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    p = 1\n    while p < n:\n        p <<= 1\n\n    return p"}
