{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of terms (n - 2*i) for i from 0 up to and including n // 2.\n    This function provides an accurate and efficient calculation of the series sum.\n    \"\"\"\n    total_sum = 0\n    loop_limit = n // 2\n    for i in range(loop_limit + 1):\n        term = n - 2 * i\n        total_sum += term\n    return total_sum"}
{"task_id": "Mbpp/160", "solution": "def extended_gcd_iterative(a: int, b: int) -> tuple[int, int, int]:\n    \"\"\"Computes GCD and Bezout coefficients iteratively.\"\"\"\n    x, y, x1, y1 = 1, 0, 0, 1\n\n    # Store original values for sign adjustment later\n    original_a, original_b = a, b\n\n    # Use absolute values for the Euclidean algorithm itself\n    a_abs, b_abs = abs(a), abs(b)\n\n    while b_abs != 0:\n        q = a_abs // b_abs\n        a_abs, b_abs = b_abs, a_abs % b_abs\n        x, x1 = x1, x - q * x1\n        y, y1 = y1, y - q * y1\n\n    # Adjust coefficients for original 'a' and 'b' signs\n    # x and y here are for abs(original_a)*x + abs(original_b)*y = gcd\n    # We want original_a*x + original_b*y = gcd\n    # If original_a is negative, x needs to be negated.\n    # If original_b is negative, y needs to be negated.\n    # However, the extended Euclidean algorithm works such that the x,y\n    # returned are for a'x + b'y = g where a' and b' are the *current*\n    # (positive) a and b values at each step.\n    # The final x, y are such that (abs(original_a))*x + (abs(original_b))*y = g\n    # To get x, y for original_a*x + original_b*y = g:\n    # If original_a is negative, x must be negative of the calculated x (to make (-a)*(-x) = ax).\n    # If original_b is negative, y must be negative of the calculated y (to make (-b)*(-y) = by).\n    # However, in this specific iterative algorithm, if only one of a or b is negative,\n    # and the other positive, the signs of x and y are usually already correctly aligned.\n    # For example, extended_gcd_iterative(-2, 3) should return (1, 1, 1) for (-2)*1 + 3*1 = 1.\n    # My trace shows it calculates (1, -1, 1) if starting with abs(a), abs(b).\n    # (-2)*(-1) + 3*(1) = 2 + 3 = 5 != 1\n    # My trace was: (-2, 3) -> gcd=1, x_g=1, y_g=1 from abs values and then adjusting x_g for original_a sign.\n    # Let's ensure the canonical form is consistent.\n    # The standard formula is: if a < 0, then x = -x. If b < 0, then y = -y.\n    # But usually, it's (g, x, y) such that a*x + b*y = g. The x and y depend on the initial signs of a and b.\n    # The iterative algorithm above provides x0, y0 for a_abs*x0 + b_abs*y0 = g.\n    # So if original_a < 0, we need to flip x0. If original_b < 0, we need to flip y0.\n    # The code's adjustment is correct for (abs(a)*x_result + abs(b)*y_result = g) -> (a*x_result + b*y_result = g)\n    if original_a < 0:\n        x = -x\n    if original_b < 0:\n        y = -y\n\n    # For original a, b, the gcd should be abs(g).\n    # The x, y returned are for original_a * x + original_b * y = a_abs (which is gcd).\n    return a_abs, x, y\ndef find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Finds integers x and y that satisfy ax + by = n as a tuple,\n    or return None if no solution exists.\n    Returns the solution with the smallest non-negative x.\n    \"\"\"\n    # Handle the a=0, b=0 edge case first\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    # Handle cases where one of the coefficients is zero\n    if a == 0:  # Equation becomes by = n\n        if n % b == 0:\n            return (0, n // b)  # Return x=0 as smallest non-negative x\n        else:\n            return None\n\n    if b == 0:  # Equation becomes ax = n\n        if n % a == 0:\n            x_candidate = n // a\n            # For b=0, there's no y to shift. We strictly return if x is non-negative.\n            return (x_candidate, 0) if x_candidate >= 0 else None\n        else:\n            return None\n\n    # General case: a and b are non-zero\n    g, x_g, y_g = extended_gcd_iterative(a, b)\n\n    # Check if a solution exists\n    if n % g != 0:\n        return None\n\n    # Scale x_g and y_g to get a particular solution for ax + by = n\n    factor = n // g\n    x_p = x_g * factor\n    y_p = y_g * factor\n\n    # Determine terms for shifting to canonical solution (smallest non-negative x)\n    # The step size for x is b/g, and for y is a/g (with opposite sign for the k*term)\n    b_prime = b // g  # x changes by multiples of b_prime\n    a_prime = a // g  # y changes by multiples of a_prime\n\n    # Adjust x_p to be in the range [0, |b_prime| - 1]\n    # Python's % operator behaves such that result has same sign as divisor.\n    # We want a result in [0, abs(divisor)-1].\n\n    x_final = x_p % b_prime # This ensures x_final has the same sign as b_prime if b_prime is not 0\n\n    # If b_prime is positive, x_p % b_prime gives a result in [0, b_prime-1]\n    # If b_prime is negative, x_p % b_prime gives a result in [b_prime+1, 0] (e.g. -7 % -3 = -1)\n    # We want x to be non-negative. If x_final is negative, we need to add b_prime (or abs(b_prime) if b_prime is negative)\n    if x_final < 0:\n        x_final += b_prime\n\n    # Calculate the 'k' that caused this shift from x_p to x_final\n    # x_final = x_p + k_actual * b_prime\n    # k_actual = (x_final - x_p) / b_prime\n    k_actual = (x_final - x_p) // b_prime\n\n    # Adjust y_p using the same 'k'\n    y_final = y_p - k_actual * a_prime\n\n    return (x_final, y_final)"}
{"task_id": "Mbpp/165", "solution": "def _to_lowercase(char: str) -> str:\n    \"\"\"Converts a single character to its lowercase equivalent.\"\"\"\n    return char.lower()\ndef _get_alphabetical_position(char: str) -> int | None:\n    \"\"\"Determines the 0-based alphabetical position of a lowercase alphabetic character.\"\"\"\n    if 'a' <= char <= 'z':\n        return ord(char) - ord('a')\n    return None\ndef count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in a string where the character's index matches its 0-based alphabetical position.\n    The comparison is case-insensitive and considers only alphabetic characters.\n    \"\"\"\n    count = 0\n    for index, original_char in enumerate(input_string):\n        lowercase_char = _to_lowercase(original_char)\n        if lowercase_char.isalpha():\n            alphabetical_position = _get_alphabetical_position(lowercase_char)\n            if alphabetical_position is not None and index == alphabetical_position:\n                count += 1\n    return count"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(text: str) -> int:\n    \"\"\"Counts characters in a string whose 0-indexed position matches their 0-indexed alphabetical position (case-insensitive).\"\"\"\n    count = 0\n    for index, char in enumerate(text):\n        lower_char = char.lower()\n        if 'a' <= lower_char <= 'z':  # Check if character is an English alphabet letter\n            alpha_pos = ord(lower_char) - ord('a')\n            if alpha_pos == index:\n                count += 1\n    return count"}
