{"task_id": "Mbpp/797", "solution": "def sum_in_range(l: int, r: int) -> int:\n    \"\"\"\n    Calculates the sum of all odd natural numbers within the inclusive range l and r.\n    Natural numbers are positive integers (1, 2, 3, ...); if l > r, the sum is 0.\n    \"\"\"\n    current_sum = 0\n    # Ensures the iteration covers the correct range; if l > r, the loop won't execute and 0 is returned.\n    start = min(l, r)\n    end = max(l, r)\n\n    for num in range(start, end + 1):\n        # Filters for natural numbers (>= 1) and odd numbers.\n        if num >= 1:\n            if num % 2 != 0:\n                current_sum += num # Accumulate Sum\n\n    return current_sum"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(number: int, d: int) -> int:\n    \"\"\"Performs a left bit rotation on a 32-bit unsigned integer.\n    The function returns the rotated integer.\n    \"\"\"\n    BIT_WIDTH = 32\n    d_normalized = d % BIT_WIDTH\n\n    # Calculate the part of the number that remains within the 32-bit boundary\n    left_part = (number << d_normalized)\n\n    # Calculate the part of the number that wraps around from the left\n    right_part = (number >> (BIT_WIDTH - d_normalized))\n\n    # Combine the two parts to get the preliminary rotated value\n    rotated = left_part | right_part\n\n    # Apply a 32-bit mask to ensure the result is treated as a 32-bit unsigned integer\n    mask = (1 << BIT_WIDTH) - 1\n    return rotated & mask"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(number: int, d: int) -> int:\n    \"\"\"\n    Performs a left bitwise rotation on a 32-bit unsigned integer.\n    \"\"\"\n    BIT_LENGTH = 32\n    MASK = (1 << BIT_LENGTH) - 1 # Represents 0xFFFFFFFF\n\n    # Mask number to 32 bits, ensuring unsigned behavior.\n    number = number & MASK\n\n    # Calculate effective shift amount.\n    d_effective = d % BIT_LENGTH\n\n    if d_effective == 0:\n        result = number\n    else:\n        # Perform left shift and get wrapped around bits.\n        shifted_left = (number << d_effective)\n        wrapped_around = (number >> (BIT_LENGTH - d_effective))\n        result = shifted_left | wrapped_around\n\n    # Mask the final result to 32 bits to ensure compliance.\n    return result & MASK"}
