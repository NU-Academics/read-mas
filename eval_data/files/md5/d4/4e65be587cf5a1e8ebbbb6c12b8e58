{"task_id": "Mbpp/591", "solution": "def swap_List(my_list: list) -> list:\n    \"\"\"\n    Swaps the first and last elements of a list if it has more than one element.\n    Returns the list unchanged for empty or single-element lists.\n    \"\"\"\n    if len(my_list) <= 1:\n        return my_list\n\n    # Pythonic way to swap elements directly in-place.\n    my_list[0], my_list[-1] = my_list[-1], my_list[0]\n    return my_list"}
{"task_id": "Mbpp/592", "solution": "def _factorial(num: int) -> int:\n    \"\"\"Calculates the factorial of a non-negative integer.\"\"\"\n    if num == 0:\n        return 1\n    res = 1\n    for i in range(1, num + 1):\n        res *= i\n    return res\nclass BinomialCoefficient:\n    \"\"\"Encapsulates the calculation of a binomial coefficient C(n, k).\"\"\"\n    def __init__(self, n_val: int, k_val: int):\n        self.n_val = n_val\n        self.k_val = k_val\n\n    def calculate(self) -> int:\n        \"\"\"Computes and returns the binomial coefficient C(n, k).\"\"\"\n        numerator = _factorial(self.n_val)\n        denominator = _factorial(self.k_val) * _factorial(self.n_val - self.k_val)\n        return numerator // denominator\ndef sum_Of_product(n: int) -> int:\n    \"\"\"Calculates the sum of products of consecutive binomial coefficients C(n, k) * C(n, k+1).\"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    coefficients_list = []\n    for k in range(n + 1):\n        bc = BinomialCoefficient(n, k)\n        coefficients_list.append(bc.calculate())\n\n    sum_products = 0\n    for k in range(n):\n        C_nk = coefficients_list[k]\n        C_nk1 = coefficients_list[k + 1]\n        product = C_nk * C_nk1\n        sum_products += product\n\n    return sum_products"}
{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip_address_string: str) -> str:\n    \"\"\"\n    Removes leading zeros from each octet of an IP address string.\n    Processes the input string to standardize octet representation.\n    \"\"\"\n    # Split the input IP address string into its individual octets.\n    octets = ip_address_string.split('.')\n\n    processed_octets = []\n    for octet_string in octets:\n        # Convert each octet to an integer to remove leading zeros.\n        int_octet = int(octet_string)\n        # Convert each processed integer octet back to a string.\n        processed_octets.append(str(int_octet))\n\n    # Join the processed octet strings back into a single string using a dot ('.').\n    return '.'.join(processed_octets)"}
{"task_id": "Mbpp/592", "solution": "def _binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient C(n, k).\n    Handles edge cases and optimizes for symmetry.\n    \"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n\n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\ndef sum_Of_product(n: int) -> int:\n    \"\"\"Calculates the sum of the product of consecutive binomial coefficients C(n,k) * C(n,k+1).\n    Iterates from k=0 to n-1, summing the products.\n    \"\"\"\n    total_sum = 0\n    for k in range(n):\n        coeff1 = _binomial_coefficient(n, k)\n        coeff2 = _binomial_coefficient(n, k + 1)\n        total_sum += coeff1 * coeff2\n    return total_sum"}
