{"task_id": "Mbpp/462", "solution": "def combinations_list(input_list: list) -> list[list]:\n    \"\"\"Generates all possible combinations (subsets) of elements from an input list.\n    This includes the empty list, and the order of elements in new combinations matches the example.\n    \"\"\"\n    all_combinations = [[]]\n    for item in input_list:\n        new_combinations_for_item = []\n        for existing_subset in all_combinations:\n            new_combinations_for_item.append([item] + existing_subset)\n        all_combinations.extend(new_combinations_for_item)\n    return all_combinations"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(nums: list[int]) -> int:\n    \"\"\"\n    Finds the maximum product of a contiguous subarray within the given list of integers.\n    Handles positive, negative, and zero values efficiently.\n    \"\"\"\n    overall_max_product = nums[0]\n    max_so_far = nums[0]\n    min_so_far = nums[0]\n\n    for num in nums[1:]:\n        # Store prev_max_so_far because max_so_far will be updated before min_so_far.\n        prev_max_so_far = max_so_far\n\n        # Current max_so_far can be num, or num multiplied by previous max_so_far, or previous min_so_far.\n        max_so_far = max(num, num * prev_max_so_far, num * min_so_far)\n        # Current min_so_far can be num, or num multiplied by previous max_so_far, or previous min_so_far.\n        min_so_far = min(num, num * prev_max_so_far, num * min_so_far)\n\n        overall_max_product = max(overall_max_product, max_so_far)\n\n    return overall_max_product"}
{"task_id": "Mbpp/462", "solution": "def combinations_list(input_list: list) -> list:\n    \"\"\"\n    Generates all possible combinations of elements from the given list.\n\n    Args:\n        input_list: A list of elements (e.g., strings, numbers).\n\n    Returns:\n        A list of lists, where each inner list is a unique combination,\n        ordered according to the specified pattern.\n    \"\"\"\n    all_combinations = [[]]  # Start with the empty set.\n\n    # Iterate through each element to build new combinations based on existing ones.\n    for element in input_list:\n        new_combinations_for_element = []\n        for existing_combination in all_combinations:\n            # Prepend the current element to each existing combination.\n            new_combination = [element] + existing_combination\n            new_combinations_for_element.append(new_combination)\n        all_combinations.extend(new_combinations_for_element)\n\n    return all_combinations"}
