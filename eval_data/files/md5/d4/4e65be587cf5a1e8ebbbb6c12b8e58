{"task_id": "Mbpp/567", "solution": "def issort_list(input_list: list) -> bool:\n    \"\"\"Checks if a list is sorted in non-decreasing order.\n    Returns True if sorted, False otherwise.\"\"\"\n    if len(input_list) <= 1:\n        return True\n\n    for i in range(1, len(input_list)):\n        if input_list[i] < input_list[i-1]:\n            return False\n    return True"}
{"task_id": "Mbpp/569", "solution": "def sort_sublists(input_list_of_lists):\n    \"\"\"\n    Sorts each sublist of strings alphabetically in a new list of lists.\n    The original input list of lists remains unchanged.\n    \"\"\"\n    sorted_list_of_lists = []\n    for sublist in input_list_of_lists:\n        copy_of_sublist = sublist[:]  # Create a shallow copy to preserve original\n        copy_of_sublist.sort()        # Sort the copy in-place\n        sorted_list_of_lists.append(copy_of_sublist)\n    return sorted_list_of_lists"}
{"task_id": "Mbpp/572", "solution": "def two_unique_nums(numbers: list) -> list:\n    \"\"\"\n    Identifies numbers that appear exactly once in the input list.\n    Returns a new list containing these unique elements, preserving their original order.\n    \"\"\"\n    counts = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    unique_elements = []\n    for num in numbers:\n        if counts[num] == 1:\n            unique_elements.append(num)\n\n    return unique_elements"}
{"task_id": "Mbpp/572", "solution": "def two_unique_nums(input_list: list) -> list:\n    \"\"\"\n    Identifies and returns numbers that appear exactly once in the input list.\n    It counts occurrences and then collects numbers with a single count.\n    \"\"\"\n    counts = {}\n    for num in input_list:\n        counts[num] = counts.get(num, 0) + 1\n\n    unique_numbers_list = []\n    for num in input_list:\n        if counts[num] == 1:\n            unique_numbers_list.append(num)\n\n    return unique_numbers_list"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(list1: list, list2: list) -> bool:\n    \"\"\"Checks if list2 is a contiguous sublist of list1. Returns True if list2 is found, False otherwise.\"\"\"\n    # Handle edge cases for empty lists\n    if not list2:\n        return True\n    if not list1 and list2: # If list1 is empty and list2 is not\n        return False\n    if len(list2) > len(list1):\n        return False\n\n    # Iterate through list1 to find a matching slice\n    n = len(list1)\n    m = len(list2)\n    for i in range(n - m + 1):\n        if list1[i : i + m] == list2:\n            return True\n    return False"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n):\n    \"\"\"\n    Calculates the last digit of the factorial of a given non-negative number n.\n    It computes the factorial iteratively, taking the modulo 10 at each step.\n    \"\"\"\n    fact = 1\n    for i in range(1, n + 1):\n        fact = (fact * i) % 10\n        # If the last digit becomes 0, it will remain 0 for all subsequent multiplications.\n        if fact == 0:\n            return 0\n    return fact"}
{"task_id": "Mbpp/573", "solution": "def unique_product(numbers: list[int]) -> int:\n    \"\"\"\n    Calculates the product of unique numbers in a given list.\n    It first extracts unique elements using a set and then computes their product.\n    \"\"\"\n    unique_numbers_set = set(numbers)\n    product_result = 1\n    for number in unique_numbers_set:\n        product_result *= number\n    return product_result"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(list_a: list, list_b: list) -> bool:\n    \"\"\"\n    Checks if list_b is a consecutive sublist of list_a.\n    Returns True if found, False otherwise; an empty list_b is always a sublist.\n    \"\"\"\n    if not list_b:\n        return True\n\n    len_a = len(list_a)\n    len_b = len(list_b)\n\n    if len_b > len_a:\n        return False\n\n    for i in range(len_a - len_b + 1):\n        if list_a[i:i+len_b] == list_b:\n            return True\n\n    return False"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"Computes the last digit of n! for a non-negative integer n.\n    Optimizes calculations for n >= 5 where the last digit is always 0.\n    \"\"\"\n    if n == 0:\n        return 1\n    elif n == 1:\n        return 1\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 6\n    elif n == 4:\n        return 4  # 4! = 24, last digit is 4\n    else:  # For n >= 5, n! will always end in 0.\n        return 0"}
{"task_id": "Mbpp/578", "solution": "from typing import List, Any\ndef interleave_lists(list1: List[Any], list2: List[Any], list3: List[Any]) -> List[Any]:\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list\n    by taking elements in the order list1[i], list2[i], list3[i] for each index i.\n    Example: [1,2,3], [10,20,30], [100,200,300] -> [1, 10, 100, 2, 20, 200, 3, 30, 300]\n    \"\"\"\n    length = len(list1)\n    result_list: List[Any] = []\n\n    for i in range(length):\n        result_list.append(list1[i])\n        result_list.append(list2[i])\n        result_list.append(list3[i])\n\n    return result_list"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Finds elements present in one tuple but not the other.\n    Returns these unique elements as a new tuple without duplicates.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n\n    # Find elements unique to tuple1 and tuple2 respectively using set difference.\n    unique_to_tuple1 = set1 - set2\n    unique_to_tuple2 = set2 - set1\n\n    # Combine all unique elements using set union, which inherently handles uniqueness.\n    combined_dissimilar = unique_to_tuple1 | unique_to_tuple2\n\n    # Convert the resulting set back into a tuple.\n    return tuple(combined_dissimilar)"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1, list2, list3):\n    \"\"\"\n    Combines elements from three equal-length lists into a single flat list.\n    Elements are interleaved sequentially: list1[i], list2[i], list3[i].\n    \"\"\"\n    result_list = []\n    length = len(list1)\n    for i in range(length):\n        result_list.append(list1[i])\n        result_list.append(list2[i])\n        result_list.append(list3[i])\n    return result_list"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1, tuple2):\n    \"\"\"\n    Identifies and returns elements present in one of two input tuples but not in both.\n    This effectively computes the symmetric difference between the elements of the two tuples.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n    dissimilar_elements = set1.symmetric_difference(set2)\n    return tuple(dissimilar_elements)"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"Processes a nested tuple to extract only even integers, preserving nesting.\"\"\"\n    result_list = []\n    for element in input_tuple:\n        if isinstance(element, tuple):\n            # Recursively process nested tuples.\n            processed_sub_tuple = extract_even(element)\n            result_list.append(processed_sub_tuple)\n        elif isinstance(element, int):\n            # Include even integers.\n            if element % 2 == 0:\n                result_list.append(element)\n        # Non-integer and non-tuple elements are skipped.\n    return tuple(result_list)"}
{"task_id": "Mbpp/564", "solution": "def count_Pairs(int_list: list[int]) -> int:\n    \"\"\"\n    Calculates the number of unordered pairs of unequal elements within a given list.\n    It determines this by subtracting pairs of identical elements from the total possible pairs.\n    \"\"\"\n    N = len(int_list)\n\n    if N < 2:\n        return 0\n\n    # Calculate the total possible unordered pairs without any restrictions.\n    total_possible_pairs = N * (N - 1) // 2\n\n    # Count frequencies of each unique element manually.\n    frequencies = {}\n    for num in int_list:\n        frequencies[num] = frequencies.get(num, 0) + 1\n\n    # Calculate the number of pairs where elements are identical.\n    identical_pairs_to_subtract = 0\n    for count in frequencies.values():\n        if count >= 2:\n            identical_pairs_to_subtract += count * (count - 1) // 2\n\n    # Subtract identical pairs from total possible pairs to get unequal pairs.\n    return total_possible_pairs - identical_pairs_to_subtract"}
{"task_id": "Mbpp/581", "solution": "import math\ndef surface_Area(base_edge, height):\n    \"\"\"\n    Calculates the total surface area of a square pyramid with a given base edge and height.\n\n    Args:\n        base_edge (float): The length of the base edge of the square pyramid.\n        height (float): The perpendicular height of the square pyramid.\n\n    Returns:\n        float: The total surface area of the square pyramid.\n\n    Raises:\n        ValueError: If base_edge or height are not positive numerical values.\n    \"\"\"\n    if not isinstance(base_edge, (int, float)) or not isinstance(height, (int, float)) or base_edge <= 0 or height <= 0:\n        raise ValueError(\"base_edge and height must be positive numerical values.\")\n\n    half_base_edge = base_edge / 2\n    slant_height = math.sqrt(height**2 + half_base_edge**2)\n\n    base_area = base_edge * base_edge\n    lateral_surface_area = 2 * base_edge * slant_height\n\n    total_surface_area = base_area + lateral_surface_area\n    return total_surface_area"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Recursively processes a nested tuple to remove all odd integer elements.\n    It preserves the original nesting hierarchy and returns a new tuple.\n    \"\"\"\n    result_elements = []\n    for element in input_tuple:\n        if isinstance(element, int):\n            if element % 2 == 0:\n                result_elements.append(element)\n        elif isinstance(element, tuple):\n            processed_nested_tuple = extract_even(element)\n            result_elements.append(processed_nested_tuple)\n    return tuple(result_elements)"}
{"task_id": "Mbpp/581", "solution": "import math\ndef surface_Area(base_edge: float, height: float) -> float:\n    \"\"\"Calculates the total surface area of a square pyramid.\n\n    This function determines the surface area based on the base edge and perpendicular height.\n    \"\"\"\n    # Calculate the slant height using the Pythagorean theorem.\n    half_base_edge = base_edge / 2\n    slant_height = math.sqrt(height**2 + half_base_edge**2)\n\n    # Calculate the area of the square base.\n    base_area = base_edge**2\n\n    # Calculate the lateral surface area (sum of four triangular faces).\n    lateral_surface_area = 2 * base_edge * slant_height\n\n    # Total surface area is the sum of the base area and lateral surface area.\n    total_surface_area = base_area + lateral_surface_area\n\n    return total_surface_area"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Catalan number using the formula C_n = binomial(2n, n) / (n + 1).\n    Assumes n is a non-negative integer as per critical requirements.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Calculate binomial(2n, n) iteratively to avoid large intermediate numbers\n    binomial_coefficient = 1\n    for i in range(n):\n        binomial_coefficient = binomial_coefficient * (2 * n - i) // (i + 1)\n\n    return binomial_coefficient // (n + 1)"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"Calculates the nth Catalan number using an iterative formula.\n    It returns the calculated non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    catalan = 1\n    for i in range(1, n + 1):\n        # C_i = C_{i-1} * (2 * (2i - 1)) / (i + 1)\n        catalan = catalan * (2 * (2 * i - 1)) // (i + 1)\n    return catalan"}
