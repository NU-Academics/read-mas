{"task_id": "Mbpp/299", "solution": "def max_aggregate(input_list: list[tuple[str, int]]) -> tuple[str, int]:\n    \"\"\"\n    Calculates the total score for each unique name and returns the name\n    with the highest total score and their corresponding total score.\n    \"\"\"\n    aggregated_scores = {}\n\n    for name, score in input_list:\n        aggregated_scores[name] = aggregated_scores.get(name, 0) + score\n\n    max_name = ''\n    max_score = 0\n\n    for name, total_score in aggregated_scores.items():\n        if total_score > max_score:\n            max_score = total_score\n            max_name = name\n\n    return (max_name, max_score)"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(dictionary: dict) -> int:\n    \"\"\"Calculates the maximum nesting depth of dictionaries within the input dictionary.\n    The depth is 1 for a dictionary with no nested dictionaries.\n    \"\"\"\n    max_nested_depth = 0\n    for value in dictionary.values():\n        if isinstance(value, dict):\n            max_nested_depth = max(max_nested_depth, dict_depth(value))\n    return 1 + max_nested_depth"}
{"task_id": "Mbpp/300", "solution": "def _comb(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient C(n, k).\"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n\n    # C(n, k) = product from i=0 to k-1 of (n-i) / (i+1)\n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\ndef count_binary_seq(n: int) -> float:\n    \"\"\"\n    Calculates the count of binary sequences of length 2n where the sum of the first n bits\n    equals the sum of the last n bits. This count is equivalent to C(2n, n).\n    \"\"\"\n    # The problem reduces to finding the central binomial coefficient C(2n, n).\n    result_int = _comb(2 * n, n)\n    return float(result_int)"}
{"task_id": "Mbpp/305", "solution": "def _word_starts_with_p(word: str) -> bool:\n    \"\"\"Checks if a word starts with 'p' or 'P' (case-insensitive).\"\"\"\n    return word.lower().startswith('p')\ndef start_withp(input_list: list[str]) -> tuple[str, str] | tuple[str] | tuple[()]:\n    \"\"\"\n    Finds the first two words starting with 'p' or 'P' from a list of strings.\n    It processes strings, splits them into words, and collects matches.\n    \"\"\"\n    collected_words: list[str] = []\n\n    for sentence_string in input_list:\n        words = sentence_string.split()\n        for word in words:\n            if _word_starts_with_p(word):\n                collected_words.append(word)\n                if len(collected_words) == 2:\n                    return tuple(collected_words)\n\n    return tuple(collected_words)"}
{"task_id": "Mbpp/305", "solution": "def start_withp(input_strings: list[str]) -> tuple[str, ...]:\n    \"\"\"\n    Extracts the first two words starting with 'p' or 'P' from a list of strings.\n    It splits each string into words and performs a case-insensitive check.\n    \"\"\"\n    found_words = []\n    for text in input_strings:\n        words = text.split()\n        for word in words:\n            if word.lower().startswith('p'):\n                found_words.append(word)\n                if len(found_words) == 2:\n                    return tuple(found_words)\n    return tuple(found_words)"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(input_dict: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting level of dictionaries within a given input dictionary.\n    A non-nested dictionary or an empty dictionary has a depth of 1.\n    \"\"\"\n    current_max_depth = 0\n    for value in input_dict.values():\n        if isinstance(value, dict):\n            nested_depth = dict_depth(value)\n            current_max_depth = max(current_max_depth, nested_depth)\n    return current_max_depth + 1"}
{"task_id": "Mbpp/306", "solution": "from typing import List\ndef max_sum_increasing_subseq(arr: List[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Calculates the maximum sum of a strictly increasing subsequence from arr[0...i]\n    that also mandatorily includes arr[k].\n    \"\"\"\n    # n is passed but not explicitly used in the DP calculation based on `arr` length.\n    # We can infer n from len(arr) if not explicitly used for array bounds.\n    # The design implies using len(arr) for dp array size.\n\n    # dp[x] stores the maximum sum of an increasing subsequence ending at arr[x],\n    # where all elements in the subsequence are strictly less than arr[k].\n    dp = [0] * n\n\n    arr_k_value = arr[k] # The value of the mandatory element arr[k]\n\n    # Iterate through the prefix of the array from index 0 up to i (inclusive)\n    for x in range(i + 1):\n        # An element arr[x] from the prefix can only be part of the subsequence\n        # if it is strictly less than the mandatory element arr[k].\n        if arr[x] < arr_k_value:\n            dp[x] = arr[x] # Initialize dp[x] with arr[x] itself (subsequence of length 1)\n\n            # Look for previous elements (y < x) to extend the increasing subsequence\n            for y in range(x):\n                # If arr[x] is greater than arr[y] (for strictly increasing property)\n                # AND arr[y] is also strictly less than arr[k] (to respect the constraint)\n                if arr[x] > arr[y] and arr[y] < arr_k_value:\n                    # Update dp[x] with the maximum sum found by extending a subsequence ending at arr[y]\\\n                    dp[x] = max(dp[x], dp[y] + arr[x])\n        # If arr[x] >= arr_k_value, it cannot be included in the prefix subsequence,\\\n        # so dp[x] remains 0 (as initialized).\n\n    # Find the maximum sum among all valid increasing subsequences ending within arr[0...i].\n    # This represents the best possible sum from the prefix.\n    max_prefix_sum = 0\n    # The slice dp[:i+1] covers elements from dp[0] to dp[i].\n    # We assume i is a valid, non-negative index as per problem constraints.\n    if i >= 0:\n        max_prefix_sum = max(dp[:i+1])\n\n    # The final maximum sum is the best prefix sum combined with the mandatory arr[k] element.\n    final_sum = max_prefix_sum + arr_k_value\n\n    return final_sum"}
