{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(arr: list) -> int:\n    \"\"\"\n    Calculates the sum of products of all possible sublists of a given list.\n    This function iterates through all sublists, calculates their product, and sums them up.\n    \"\"\"\n    n = len(arr)\n    total_sum = 0\n    for i in range(n):\n        product = 1\n        for j in range(i, n):\n            product *= arr[j]\n            total_sum += product\n    return total_sum"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array: list, target_number: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a number in a sorted array.\n    Uses a modified binary search to efficiently locate the first instance.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target_number:\n            result = mid  # Store this as a potential first occurrence\n            high = mid - 1  # Continue searching in the left half for an earlier occurrence\n        elif array[mid] < target_number:\n            low = mid + 1\n        else:  # array[mid] > target_number\n            high = mid - 1\n    return result"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(input_list: list[int], target_number: int) -> int:\n    \"\"\"Finds the index of the first occurrence of a number in a sorted list.\n    Returns the index or -1 if the number is not found.\n    \"\"\"\n    low = 0\n    high = len(input_list) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if input_list[mid] == target_number:\n            result = mid  # Found a potential first occurrence\n            high = mid - 1  # Try to find an earlier occurrence in the left half\n        elif input_list[mid] < target_number:\n            low = mid + 1\n        else:  # input_list[mid] > target_number\n            high = mid - 1\n\n    return result"}
