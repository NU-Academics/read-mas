{"task_id": "Mbpp/129", "solution": "from typing import List\ndef _is_empty_matrix(matrix: List[List[int]]) -> bool:\n    \"\"\"Checks if the input matrix is empty or contains empty rows.\n    Returns True if empty, False otherwise.\n    \"\"\"\n    if not matrix or not matrix[0]:\n        return True\n    return False\ndef _get_matrix_size(matrix: List[List[int]]) -> int:\n    \"\"\"Determines the dimension (N) of an N x N matrix.\n    Assumes a non-empty matrix for size calculation.\n    \"\"\"\n    return len(matrix)\ndef _is_square_matrix(matrix: List[List[int]], size: int) -> bool:\n    \"\"\"Verifies if the matrix has consistent row lengths equal to the number of rows.\n    Returns True if it's a square matrix, False otherwise.\n    \"\"\"\n    for row in matrix:\n        if len(row) != size:\n            return False\n    return True\ndef _calculate_row_sum(matrix: List[List[int]], row_index: int) -> int:\n    \"\"\"Computes the sum of elements for a specified row.\n    Returns the sum of the row.\n    \"\"\"\n    return sum(matrix[row_index])\ndef _calculate_column_sum(matrix: List[List[int]], col_index: int, size: int) -> int:\n    \"\"\"Computes the sum of elements for a specified column.\n    Iterates through rows to sum elements at the given column index.\n    \"\"\"\n    col_sum = 0\n    for i in range(size):\n        col_sum += matrix[i][col_index]\n    return col_sum\ndef _calculate_main_diagonal_sum(matrix: List[List[int]], size: int) -> int:\n    \"\"\"Computes the sum of elements along the main diagonal.\n    Elements are at (i, i) positions.\n    \"\"\"\n    diag_sum = 0\n    for i in range(size):\n        diag_sum += matrix[i][i]\n    return diag_sum\ndef _calculate_anti_diagonal_sum(matrix: List[List[int]], size: int) -> int:\n    \"\"\"Computes the sum of elements along the anti-diagonal.\n    Elements are at (i, size - 1 - i) positions.\n    \"\"\"\n    anti_diag_sum = 0\n    for i in range(size):\n        anti_diag_sum += matrix[i][size - 1 - i]\n    return anti_diag_sum\ndef magic_square_test(matrix: List[List[int]]) -> bool:\n    \"\"\"Determines if a given square matrix is a magic square.\n    Verifies sums of rows, columns, and both diagonals are identical.\n    \"\"\"\n    if _is_empty_matrix(matrix):\n        return False\n\n    size = _get_matrix_size(matrix)\n\n    if not _is_square_matrix(matrix, size):\n        return False\n\n    # Get the magic sum from the first row\n    magic_sum = _calculate_row_sum(matrix, 0)\n\n    # Check row sums\n    for i in range(size):\n        if _calculate_row_sum(matrix, i) != magic_sum:\n            return False\n\n    # Check column sums\n    for j in range(size):\n        if _calculate_column_sum(matrix, j, size) != magic_sum:\n            return False\n\n    # Check main diagonal sum\n    if _calculate_main_diagonal_sum(matrix, size) != magic_sum:\n        return False\n\n    # Check anti-diagonal sum\n    if _calculate_anti_diagonal_sum(matrix, size) != magic_sum:\n        return False\n\n    return True"}
