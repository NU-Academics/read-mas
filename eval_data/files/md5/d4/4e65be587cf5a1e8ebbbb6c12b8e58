{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(n: int) -> int:\n    \"\"\"Toggles bits strictly between the MSB and LSB of an integer, preserving MSB/LSB.\n    Handles edge cases for 0, single set bits, and adjacent set bits by returning the original number.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    msb_pos = n.bit_length() - 1\n    lsb_pos = (n & -n).bit_length() - 1\n\n    count_to_toggle = msb_pos - lsb_pos - 1\n\n    mask = 0\n    if count_to_toggle > 0:\n        # Create a sequence of '1's for count_to_toggle bits, then shift to align with middle bits.\n        mask = ((1 << count_to_toggle) - 1) << (lsb_pos + 1)\n\n    return n ^ mask"}
{"task_id": "Mbpp/735", "solution": "class Number:\n    \"\"\"Encapsulates an integer's binary representation and provides bit manipulation utilities.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n        # Convert to binary string, remove '0b' prefix, then to list of characters\n        self._binary_list = list(bin(value)[2:])\n\n    def get_value(self) -> int:\n        \"\"\"Returns the original integer value.\"\"\"\n        return self._value\n\n    def get_binary_list(self) -> list[str]:\n        \"\"\"Returns the binary representation as a list of '0'/'1' characters.\"\"\"\n        return self._binary_list\n\n    def get_msb_index(self) -> int:\n        \"\"\"Returns the index of the most significant bit (leftmost).\"\"\"\n        return 0\n\n    def get_lsb_index(self) -> int:\n        \"\"\"Returns the index of the least significant bit (rightmost).\"\"\"\n        return len(self._binary_list) - 1\n\n    def toggle_bit_at_index(self, index: int):\n        \"\"\"Inverts the bit at the specified index.\"\"\"\n        if 0 <= index < len(self._binary_list):\n            self._binary_list[index] = '1' if self._binary_list[index] == '0' else '0'\n\n    def to_int(self) -> int:\n        \"\"\"Converts the current binary list back into an integer.\"\"\"\n        return int(\"\".join(self._binary_list), 2)\ndef toggle_middle_bits(input_number: int) -> int:\n    \"\"\"\n    Toggles the middle bits of a non-negative integer, excluding MSB and LSB.\n    Numbers with fewer than 3 bits are returned unchanged.\n    \"\"\"\n    if input_number < 0:\n        raise ValueError(\"Input number must be non-negative.\")\n\n    # Handle edge case for numbers with fewer than 3 bits (0, 1, 2, 3 in decimal)\n    # where no middle bits exist.\n    if input_number.bit_length() <= 2:\n        return input_number\n\n    num_obj = Number(input_number)\n\n    msb_idx = num_obj.get_msb_index()\n    lsb_idx = num_obj.get_lsb_index()\n\n    # Iterate through indices between MSB and LSB (exclusive)\n    for i in range(msb_idx + 1, lsb_idx):\n        num_obj.toggle_bit_at_index(i)\n\n    return num_obj.to_int()"}
{"task_id": "Mbpp/739", "solution": "import math\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index k of the smallest triangular number T_k that has exactly n digits.\n    Uses the formula k = ceil((-1 + sqrt(1 + 8 * 10^(n-1))) / 2).\n    \"\"\"\n    min_n_digit_value = 10**(n - 1)\n    k_float = (-1 + math.sqrt(1 + 8 * min_n_digit_value)) / 2\n    return int(math.ceil(k_float))"}
{"task_id": "Mbpp/739", "solution": "def _calculate_triangular_number(k: int) -> int:\n    \"\"\"\n    Calculates the k-th triangular number using the formula T_k = k * (k + 1) / 2.\n    It returns an integer result.\n    \"\"\"\n    return k * (k + 1) // 2\ndef _count_digits(number: int) -> int:\n    \"\"\"\n    Determines the number of digits in a given integer.\n    It converts the number to a string and returns its length.\n    \"\"\"\n    return len(str(number))\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with `n` digits.\n    This function validates input `n` and iterates `k` until the condition is met.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    k = 1\n    while True:\n        t_k = _calculate_triangular_number(k)\n        digits_of_t_k = _count_digits(t_k)\n\n        if digits_of_t_k == n:\n            return k\n\n        k += 1"}
