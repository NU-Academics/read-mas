{"task_id": "Mbpp/755", "solution": "def second_smallest(numbers_list):\n    # Process the list to find unique numbers and sort them in ascending order.\n    unique_sorted_numbers = sorted(list(set(numbers_list)))\n\n    # Return the second smallest unique number, or None if fewer than two exist.\n    if len(unique_sorted_numbers) < 2:\n        return None\n    return unique_sorted_numbers[1]"}
{"task_id": "Mbpp/755", "solution": "from typing import List\ndef second_smallest(numbers: List[float]) -> float:\n    \"\"\"\n    Finds the second smallest number in a list of numbers.\n    Handles duplicate numbers correctly by sorting the entire list.\n    \"\"\"\n    if len(numbers) < 2:\n        raise ValueError(\"Input list must contain at least two numbers.\")\n\n    # Sort the list in ascending order to easily find the second smallest number.\n    sorted_numbers = sorted(numbers)\n\n    # The second smallest number is at index 1 after sorting.\n    return sorted_numbers[1]"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"\n    Counts unique pairs of reverse strings in the given list.\n    A string and its reverse form a pair only if they are distinct.\n    \"\"\"\n    string_set = set(string_list)\n    count = 0\n    seen_pairs = set()\n\n    for s in string_list:\n        reversed_s = s[::-1]\n        # Check if the reversed string exists and if it's not the same as the original string (BR3).\n        if reversed_s in string_set and s != reversed_s:\n            # Normalize the pair to ensure uniqueness regardless of order (e.g., (\"ab\", \"ba\") or (\"ba\", \"ab\")).\n            normalized_pair = tuple(sorted((s, reversed_s)))\n            if normalized_pair not in seen_pairs:\n                seen_pairs.add(normalized_pair)\n                count += 1\n    return count"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"\n    Counts unique pairs of reverse strings in a list, ensuring each string is used once.\n    Comparison for reversal is case-sensitive.\n    \"\"\"\n\n    def _reverse_string(s: str) -> str:\n        \"\"\"Helper function to reverse a string.\"\"\"\n        return s[::-1]\n\n    pair_count = 0\n    num_strings = len(string_list)\n    used_indices = [False] * num_strings\n\n    for i in range(num_strings):\n        if used_indices[i]:\n            continue\n\n        s1 = string_list[i]\n        reversed_s1 = _reverse_string(s1)\n\n        # Search for the reversed string in the *remaining* part of the list\n        # starting from i+1 to avoid self-pairing and redundant checks for already processed strings\n        for j in range(i + 1, num_strings):\n            if used_indices[j]:\n                continue\n\n            s2 = string_list[j]\n            if s2 == reversed_s1:\n                pair_count += 1\n                used_indices[i] = True\n                used_indices[j] = True\n                break # A pair has been found for s1, move to the next s1\n\n    return pair_count"}
{"task_id": "Mbpp/758", "solution": "from typing import List, Any, Dict, Tuple\ndef unique_sublists(input_list: List[List[Any]]) -> Dict[Tuple[Any, ...], int]:\n    \"\"\"\n    Counts the occurrences of unique sublists within a list.\n    Each sublist is converted to a tuple to be used as a dictionary key.\n    \"\"\"\n    counts = {}\n    for sublist in input_list:\n        sublist_tuple = tuple(sublist)\n        counts[sublist_tuple] = counts.get(sublist_tuple, 0) + 1\n    return counts"}
{"task_id": "Mbpp/758", "solution": "import collections\ndef unique_sublists(list_of_lists: list[list]) -> dict[tuple, int]:\n    \"\"\"\n    Counts occurrences of each unique sublist, converting them to tuples.\n    Returns a dictionary mapping unique tuples to their counts.\n    \"\"\"\n    # Convert each sublist into an immutable tuple to enable counting.\n    # collections.Counter efficiently tallies occurrences of these tuples.\n    tuples_from_sublists = [tuple(sublist) for sublist in list_of_lists]\n    return dict(collections.Counter(tuples_from_sublists))"}
{"task_id": "Mbpp/760", "solution": "def unique_Element(input_list: list) -> bool:\n    \"\"\"\n    Checks if a list of numbers contains only one distinct element.\n    Returns True for empty or single-element lists, and lists where all elements are identical.\n    \"\"\"\n    if len(input_list) <= 1:\n        return True\n    return len(set(input_list)) == 1"}
{"task_id": "Mbpp/759", "solution": "import re\ndef is_decimal(input_string: str) -> bool:\n    \"\"\"Checks if a string represents a decimal number with exactly two digits after the decimal point.\n    This uses a regular expression to validate the specific format.\"\"\"\n    # Pattern: optional sign, one or more digits, a decimal point, and exactly two digits.\n    pattern = r\"^[+-]?\\d+\\.\\d{2}$\"\n    return re.fullmatch(pattern, input_string) is not None"}
{"task_id": "Mbpp/760", "solution": "def unique_Element(list_of_numbers: list) -> bool:\n    \"\"\"\n    Checks if a list of numbers contains only one distinct element.\n    Returns True for empty, single-element, or lists with identical elements; False otherwise.\n    \"\"\"\n    if len(list_of_numbers) <= 1:\n        return True\n\n    first_element = list_of_numbers[0]\n    for element in list_of_numbers:\n        if element != first_element:\n            return False\n    return True"}
