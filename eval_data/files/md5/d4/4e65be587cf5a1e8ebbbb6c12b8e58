{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks if two integers differ at exactly one bit position.\n    Returns True if their XOR has exactly one set bit, False otherwise.\n    \"\"\"\n    xor_val = num1 ^ num2\n    # A number has exactly one set bit if it's a power of two (and greater than zero).\n    return (xor_val > 0) and ((xor_val & (xor_val - 1)) == 0)"}
{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import List\ndef heap_queue_largest(numbers: List[int], n: int) -> List[int]:\n    \"\"\"\n    Identifies the 'n' largest integers from a list and returns them in descending order.\n    This implementation uses a min-heap to efficiently track the largest elements.\n    \"\"\"\n    if not numbers or n <= 0:\n        return []\n\n    min_heap = []\n\n    for number in numbers:\n        if len(min_heap) < n:\n            heapq.heappush(min_heap, number)\n        elif number > min_heap[0]:\n            heapq.heapreplace(min_heap, number)\n\n    # The heap now contains the 'n' largest numbers. Sort them in descending order.\n    result = sorted(min_heap, reverse=True)\n    return result"}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(number: int) -> bool:\n    \"\"\"\n    Determines if an integer is a non-prime number.\n    Non-prime numbers are natural numbers greater than 1 that are not prime.\n    \"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return False\n    for i in range(2, int(number**0.5) + 1):\n        if number % i == 0:\n            return True\n    return False"}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(number: int) -> bool:\n    \"\"\"\n    Determines if an integer is a non-prime number.\n    Returns True if the number is not prime, False otherwise.\n    \"\"\"\n    if number <= 1:\n        return True\n    if number == 2:\n        return False\n\n    # Check for divisors from 2 up to the square root of the number.\n    for i in range(2, int(number**0.5) + 1):\n        if number % i == 0:\n            return True\n\n    return False"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks if two non-negative integers differ by exactly one bit position.\n    Returns True if the binary representations of num1 and num2 differ by exactly one bit, False otherwise.\n    \"\"\"\n    xor_result = num1 ^ num2 # Calculate the XOR result to find differing bits. If two bits are different, their XOR will be 1.\n\n    count = 0 # Count the number of set bits (1s) in the XOR result.\n    while xor_result > 0:\n        xor_result &= (xor_result - 1) # This operation clears the least significant set bit.\n        count += 1\n\n    return count == 1 # Return True if exactly one bit differs, False otherwise."}
{"task_id": "Mbpp/4", "solution": "import heapq\ndef heap_queue_largest(numbers: list[int], n: int) -> list[int]:\n    # Handle edge cases for n being invalid, the list being empty, or n being zero.\\\n    if n < 0 or not numbers or n == 0 or n > len(numbers):\\\n        return []\n\n    # Utilize heapq.nlargest to efficiently find the n largest elements.\\\n    # This function automatically uses a min-heap internally and returns results in descending order.\\\n    largest_n = heapq.nlargest(n, numbers)\n\n    return largest_n"}
