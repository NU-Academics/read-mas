{"task_id": "Mbpp/140", "solution": "import collections.abc\ndef extract_singly(data_list: collections.abc.Sequence[collections.abc.Sequence[int | float]]) -> set[int | float]:\n    \"\"\"\n    Flattens a list of tuples into a single set of unique numbers.\n\n    Args:\n        data_list: A list of tuples, where each tuple is expected to contain numbers.\n                   Non-numeric elements within tuples will be ignored.\n\n    Returns:\n        A set containing all unique numbers extracted from the input tuples.\n    \"\"\"\n    unique_numbers = set()\n    for item_tuple in data_list:\n        # The design document implies that item_tuple will always be a sequence.\n        # However, for robustness, the design had a check:\n        # if not isinstance(item_tuple, collections.abc.Sequence):\n        #     continue\n        for element in item_tuple:\n            if isinstance(element, (int, float)):\n                unique_numbers.add(element)\n    return unique_numbers"}
{"task_id": "Mbpp/141", "solution": "def pancake_sort(input_list):\n    \"\"\"Sorts a list of elements in ascending order using the pancake sort algorithm.\n    It returns a new list containing the sorted elements.\"\"\"\n    lst = list(input_list)\n    n = len(lst)\n\n    def _flip(arr, k):\n        start = 0\n        while start < k:\n            arr[start], arr[k] = arr[k], arr[start]\n            start += 1\n            k -= 1\n\n    for curr_size in range(n, 1, -1):\n        max_idx = 0\n        for i in range(1, curr_size):\n            if lst[i] > lst[max_idx]:\n                max_idx = i\n\n        if max_idx != curr_size - 1:\n            _flip(lst, max_idx)\n            _flip(lst, curr_size - 1)\n\n    return lst"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1: list, list2: list, list3: list) -> int:\n    \"\"\"\n    Counts items identical at the same position across three lists.\n    Comparison occurs up to the length of the shortest list among the three.\n    \"\"\"\n    identical_count = 0\n    min_length = min(len(list1), len(list2), len(list3))\n\n    for i in range(min_length):\n        if list1[i] == list2[i] and list2[i] == list3[i]:\n            identical_count += 1\n\n    return identical_count"}
