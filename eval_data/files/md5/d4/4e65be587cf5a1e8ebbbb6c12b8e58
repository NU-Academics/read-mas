{"task_id": "Mbpp/256", "solution": "def _is_prime(n: int) -> bool:\n    \"\"\"Checks if a number is prime. Optimizes by checking divisibility up to its square root.\"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:  # Optimization for even numbers\n        return False\n    # Check for divisors from 3 up to sqrt(n), skipping even numbers\n    for i in range(3, int(n**0.5) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\ndef count_Primes_nums(num: int) -> int:\n    \"\"\"Counts prime numbers strictly less than the given non-negative integer.\"\"\"\n    prime_count = 0\n    # Iterate from 2 up to num - 1 to find primes\n    for i in range(2, num):\n        if _is_prime(i):\n            prime_count += 1\n    return prime_count"}
{"task_id": "Mbpp/256", "solution": "def _is_prime(n: int) -> bool:\n    \"\"\"Checks if a number is prime using an optimized trial division method.\"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    # Check for odd divisors from 3 up to the square root of n\n    for i in range(3, int(n**0.5) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\ndef count_Primes_nums(num: int) -> int:\n    \"\"\"Counts the number of prime numbers strictly less than a given non-negative integer.\"\"\"\n    prime_count = 0\n    if num <= 2:\n        return 0\n\n    # Iterate from 2 up to num-1 (strictly less than num)\n    for i in range(2, num):\n        if _is_prime(i):\n            prime_count += 1\n    return prime_count"}
