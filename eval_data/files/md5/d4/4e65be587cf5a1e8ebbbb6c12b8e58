{"task_id": "Mbpp/283", "solution": "import collections\ndef validate(n: int) -> bool:\n    \"\"\"\n    Determines if the frequency of each digit within the integer n\n    is less than or equal to the digit's value itself.\n    \"\"\"\n    if n < 0:\n        n = abs(n)\n\n    n_str = str(n)\n    digit_counts = collections.Counter(n_str)\n\n    for digit_char, frequency in digit_counts.items():\n        digit_value = int(digit_char)\n\n        if frequency > digit_value:\n            return False\n    return True"}
{"task_id": "Mbpp/283", "solution": "import collections\ndef validate(integer_input: int) -> bool:\n    \"\"\"\n    Checks whether the frequency of each digit in the integer is less than or equal to the digit itself.\n\n    Acceptance Criteria Examples (from SRS):\n        validate(1234) == True\n        validate(5) == True\n        validate(0) == True\n        validate(1) == True\n        validate(112) == False\n        validate(3333) == False\n        validate(22) == False\n    \"\"\"\n    # Convert integer to string for digit iteration.\n    str_integer = str(integer_input)\n\n    # Calculate digit frequencies using Counter; keys are digit characters.\n    digit_counts = collections.Counter(str_integer)\n\n    # Iterate through each digit and its frequency. If any digit's frequency exceeds its value, return False.\n    for digit_char, frequency in digit_counts.items():\n        digit_value = int(digit_char)\n        if frequency > digit_value:\n            return False\n\n    # If all checks pass, return True.\n    return True"}
{"task_id": "Mbpp/285", "solution": "import re\ndef text_match_two_three(text: str) -> bool:\n    \"\"\"\n    Checks if a string contains the pattern 'a' followed by two or three 'b' characters.\n    Returns True if the pattern is found, False otherwise.\n    \"\"\"\n    pattern = r'ab{2,3}'\n    return re.search(pattern, text) is not None"}
{"task_id": "Mbpp/286", "solution": "def max_sub_array_sum_repeated(arr: list[int], n: int, k: int) -> int:\n    \"\"\"\n    Calculates the largest sum of a contiguous subarray in a modified array\n    formed by repeating the given array k times.\n    \"\"\"\n\n    def _kadane(array: list[int]) -> int:\n        \"\"\"\n        Applies Kadane's algorithm to find the maximum sum of a contiguous subarray.\n        Handles arrays with all negative numbers or empty arrays correctly.\n        \"\"\"\n        if not array:\n            return 0  # Max sum of an empty array is 0\n\n        max_so_far = array[0]\n        current_max = array[0]\n\n        for i in range(1, len(array)):\n            current_max = max(array[i], current_max + array[i])\n            max_so_far = max(max_so_far, current_max)\n        return max_so_far\n\n    if k == 1:\n        return _kadane(arr)\n\n    total_sum_arr = sum(arr)\n\n    # Concatenate arr with itself to handle sums spanning across one boundary.\n    arr_double = arr + arr\n    max_sum_double = _kadane(arr_double)\n\n    if total_sum_arr > 0:\n        # If total_sum_arr is positive, middle (k-2) repetitions can contribute fully.\n        return max_sum_double + (k - 2) * total_sum_arr\n    else:\n        # If total_sum_arr is non-positive, further repetitions won't increase the sum.\n        # The maximum sum must be contained within the first two repetitions.\n        return max_sum_double"}
{"task_id": "Mbpp/290", "solution": "from typing import List, Any, Tuple\ndef max_length(list_of_lists: List[List[Any]]) -> Tuple[int, List[Any]]:\n    \"\"\"\n    Identifies the sub-list with the maximum length from a list of lists.\n    Returns (0, []) if the input list_of_lists is empty or contains only empty sub-lists.\n    \"\"\"\n    max_len = 0\n    longest_list: List[Any] = []\n\n    if not list_of_lists:\n        return max_len, longest_list\n\n    for sub_list in list_of_lists:\n        current_len = len(sub_list)\n        if current_len > max_len:\n            max_len = current_len\n            longest_list = sub_list\n\n    return max_len, longest_list"}
{"task_id": "Mbpp/265", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\n    Used when 'n' is not a positive integer.\"\"\"\n    pass\ndef list_split(input_list: list, n: int) -> list[list]:\n    \"\"\"\n    Splits an input list into 'n' sublists, distributing elements using index modulo 'n'.\n    Raises InvalidInputError if 'n' is not a positive integer.\n    \"\"\"\n    if n <= 0:\n        raise InvalidInputError(\"n must be a positive integer.\")\n\n    output_lists = [[] for _ in range(n)]\n\n    # If input_list is empty, return 'n' empty sublists as initialized.\n    if not input_list:\n        return output_lists\n\n    for i, item in enumerate(input_list):\n        target_sublist_index = i % n\n        output_lists[target_sublist_index].append(item)\n\n    return output_lists"}
