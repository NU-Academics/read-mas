{"task_id": "Mbpp/605", "solution": "def prime_num(number: int) -> bool:\n    \"\"\"Checks if a given integer is a prime number. Handles edge cases for numbers less than or equal to 1.\"\"\"\n    if number <= 1:\n        return False\n    # Iterate from 2 up to the square root of the number.\n    for i in range(2, int(number**0.5) + 1):\n        if number % i == 0:\n            return False\n    return True"}
{"task_id": "Mbpp/603", "solution": "def get_ludic(n):\n    \"\"\"\n    Calculates ludic numbers up to a given integer n using a sieve method.\n    It iteratively removes elements based on the current ludic number.\n    \"\"\"\n    if n < 1:\n        return []\n\n    numbers = list(range(1, n + 1))\n    ludic_numbers = []\n\n    while numbers:\n        current_ludic = numbers.pop(0)\n        ludic_numbers.append(current_ludic)\n\n        if current_ludic == 1:\n            continue\n\n        next_numbers = []\n        count_in_current_list = 0\n        for num in numbers:\n            count_in_current_list += 1\n            if count_in_current_list % current_ludic != 0:\n                next_numbers.append(num)\n        numbers = next_numbers\n\n    return ludic_numbers"}
{"task_id": "Mbpp/603", "solution": "def get_ludic(upperBound: int) -> list[int]:\n    \"\"\"\n    Returns a list of all ludic numbers less than or equal to the given upperBound.\n    This function delegates the core calculation to an internal sieving helper.\n    \"\"\"\n    def _sieve_ludic_numbers(limit: int) -> list[int]:\n        \"\"\"\n        Sieves ludic numbers up to a given limit using an iterative removal process.\n        It identifies ludic numbers by repeatedly removing elements at specific positions from a sequence.\n        \"\"\"\n        if limit < 1:\n            return []\n\n        candidates = list(range(1, limit + 1))\n        ludic_numbers = []\n\n        while candidates:\n            current_ludic = candidates.pop(0)\n            ludic_numbers.append(current_ludic)\n\n            # The number 1 is a special case; it does not remove any elements based on its position.\n            if current_ludic == 1:\n                continue\n\n            next_candidates = []\n            for k in range(len(candidates)):\n                # Elements are kept if their 1-indexed position in the current list\n                # is not a multiple of the current_ludic number.\n                if (k + 1) % current_ludic != 0:\n                    next_candidates.append(candidates[k])\n\n            candidates = next_candidates\n\n        return ludic_numbers\n\n    return _sieve_ludic_numbers(upperBound)"}
