{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number a(n, m), which is the number of permutations of {1, ..., n}\n    with exactly m ascents. The formula used is the standard explicit sum involving binomial coefficients.\n    \"\"\"\n    eulerian_sum = 0\n\n    # The formula is A(n, m) = sum_{k=0 to m} (-1)^k * C(n+1, k) * (m - k + 1)^n\n    for k in range(m + 1):\n        # Calculate binomial coefficient C(N_val, K_val) where N_val = n + 1, K_val = k\n        binom_N = n + 1\n        binom_K = k\n\n        binom_coefficient = 1\n        if binom_K < 0 or binom_K > binom_N:\n            binom_coefficient = 0\n        elif binom_K == 0 or binom_K == binom_N:\n            binom_coefficient = 1\n        else:\n            # Optimize K_val for smaller iterations: C(N, K) = C(N, N-K)\n            if binom_K > binom_N // 2:\n                binom_K = binom_N - binom_K\n\n            # Calculate C(binom_N, binom_K) iteratively\n            for i in range(binom_K):\n                binom_coefficient = binom_coefficient * (binom_N - i) // (i + 1)\n\n        # If binomial_coefficient is 0, the entire term is 0, so continue to the next k\n        if binom_coefficient == 0:\n            continue\n\n        # Calculate (base_val)^exponent_val where base_val = (m - k + 1), exponent_val = n\n        base_val = m - k + 1\n        exponent_val = n\n\n        power_val = 1\n        # The loop handles 0^0 = 1 (empty loop) and 0^pos_int = 0 correctly.\n        for _ in range(exponent_val):\n            power_val *= base_val\n\n        # Calculate the current term: (-1)^k * binom_coefficient * power_val\n        current_term = binom_coefficient * power_val\n        if k % 2 == 1:  # If k is odd, (-1)^k is -1\n            current_term *= -1\n\n        eulerian_sum += current_term\n\n    return eulerian_sum"}
{"task_id": "Mbpp/104", "solution": "def sort_sublists(input_list_of_lists: list[list[str]]) -> list[list[str]]:\n    \"\"\"Sorts string elements within each sublist alphabetically.\n    Returns a new list of lists with sorted sublists, leaving the original input unchanged.\n    \"\"\"\n    new_sorted_list_of_lists = []\n    for inner_list in input_list_of_lists:\n        # Use sorted() to create a new sorted list, not modifying the original inner_list.\n        sorted_inner_list = sorted(inner_list)\n        new_sorted_list_of_lists.append(sorted_inner_list)\n    return new_sorted_list_of_lists"}
{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number a(n, m), representing the number of permutations of {1, ..., n}\n    with exactly m ascents. It uses dynamic programming to compute the values based on a recurrence relation.\n    \"\"\"\n    if n == 0:\n        return 1 if m == 0 else 0\n\n    # For n > 0, Eulerian numbers are 0 if m < 0 or m >= n.\n    if m < 0 or m >= n:\n        return 0\n\n    # Initialize a DP table to store A(i, j) values.\n    # dp[i][j] stores A(i, j), with rows for i from 0 to n and columns for j from 0 to n-1.\n    dp = [[0 for _ in range(n + 1)] for _ in range(n + 1)]\n\n    # Base case for the recurrence relation starts from A(1, 0) = 1.\n    dp[1][0] = 1\n\n    # Fill the DP table using the recurrence relation:\n    # A(i, j) = (i - j) * A(i - 1, j - 1) + (j + 1) * A(i - 1, j)\n    for i in range(2, n + 1):\n        for j in range(i): # m ranges from 0 to i-1 for A(i,m)\n            term1 = 0\n            if j > 0: # A(i-1, j-1) is only valid if j-1 >= 0\n                term1 = dp[i - 1][j - 1]\n\n            term2 = dp[i - 1][j]\n\n            dp[i][j] = (i - j) * term1 + (j + 1) * term2\n\n    return dp[n][m]"}
