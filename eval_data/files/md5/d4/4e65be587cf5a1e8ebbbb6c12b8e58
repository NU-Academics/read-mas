{"task_id": "Mbpp/262", "solution": "def split_two_parts(input_list: list, L: int) -> tuple[list, list]:\n    \"\"\"\n    Splits an input list into two parts: the first containing `L` elements, and the second with the rest.\n    Returns a tuple `(first_part, second_part)`, handling edge cases for `L=0` or `L >= len(input_list)`.\n    \"\"\"\n    if L <= 0:\n        return [], list(input_list) # Handles L is 0 or negative.\n    elif L >= len(input_list):\n        return list(input_list), [] # Handles L greater than or equal to list length.\n    else:\n        first_part = input_list[:L]\n        second_part = input_list[L:]\n        return first_part, second_part"}
{"task_id": "Mbpp/262", "solution": "def split_two_parts(input_list: list, L: int) -> tuple[list, list]:\n    \"\"\"Splits a list into two parts based on length L for the first part.\n    Handles various L values, including 0 and L greater than list length, using list slicing.\"\"\"\n    first_sub_list = input_list[:L]\n    second_sub_list = input_list[L:]\n    return (first_sub_list, second_sub_list)"}
{"task_id": "Mbpp/264", "solution": "def dog_age(human_years: int) -> int:\n    \"\"\"Calculates a dog's age in \"dog years\" based on its age in \"human years\".\n    This function uses the commonly accepted rule for calculating dog years.\n    \"\"\"\n    if human_years <= 2:\n        return int(human_years * 10.5)\n    else:\n        return 4 * human_years + 13"}
