{"task_id": "Mbpp/57", "solution": "import functools\ndef find_Max_Num(digits: list[int]) -> int:\n    \"\"\"\n    Arranges a list of integers to form the largest possible concatenated number.\n    Returns 0 if the input list is empty or contains only zeros.\n    \"\"\"\n    if not digits:\n        return 0\n\n    if all(d == 0 for d in digits):\n        return 0\n\n    str_digits = [str(d) for d in digits]\n\n    def compare(a, b):\n        if a + b > b + a:\n            return -1\n        elif a + b < b + a:\n            return 1\n        else:\n            return 0\n\n    sorted_digits = sorted(str_digits, key=functools.cmp_to_key(compare))\n\n    return int(\"\".join(sorted_digits))"}
