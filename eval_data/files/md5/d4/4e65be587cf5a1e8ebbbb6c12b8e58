{"task_id": "Mbpp/297", "solution": "import collections\ndef flatten_list(input_list: list) -> list:\n    \"\"\"Flattens a nested list into a single-level list.\n    It processes elements iteratively using a stack to handle nested structures.\n    \"\"\"\n    flattened_list = []\n    # Initialize stack with input_list elements in reverse order\n    # so that popping elements retrieves them in original forward order.\n    stack = collections.deque(reversed(input_list))\n\n    while stack:\n        item = stack.pop()\n        if isinstance(item, list):\n            # If the item is a list, extend its elements (reversed) onto the stack\n            stack.extend(reversed(item))\n        else:\n            # If it's not a list, append it to the result\n            flattened_list.append(item)\n\n    return flattened_list"}
{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"Calculates the sum of the squares of the first n even natural numbers.\"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        even_number = 2 * i\n        total_sum += even_number * even_number\n    return total_sum"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(data_list):\n    \"\"\"Calculates the maximum aggregate from a list of (name, value) tuples.\n    It sums values by unique names and identifies the name with the highest total sum.\n    \"\"\"\n    aggregates = {}\n\n    for name, value in data_list:\n        aggregates[name] = aggregates.get(name, 0) + value\n\n    max_name = None\n    max_aggregate_value = None\n\n    if not aggregates:\n        return (None, 0)\n\n    for name, total_value in aggregates.items():\n        if max_name is None or total_value > max_aggregate_value:\n            max_name = name\n            max_aggregate_value = total_value\n\n    return (max_name, max_aggregate_value)"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(input_list):\n    \"\"\"Recursively flattens a nested list structure into a single list.\n    Preserves the order of elements from the original nested structure.\n    \"\"\"\n    result = []\n    for item in input_list:\n        if isinstance(item, list):\n            result.extend(flatten_list(item))\n        else:\n            result.append(item)\n    return result"}
