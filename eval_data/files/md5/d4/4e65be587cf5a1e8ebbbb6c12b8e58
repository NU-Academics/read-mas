{"task_id": "Mbpp/615", "solution": "def average_tuple(data_tuple: tuple[tuple[int | float, ...], ...]) -> list[float]:\n    \"\"\"\n    Calculates the average of elements for each inner tuple within `data_tuple`.\n    Returns `0.0` for empty inner tuples and an empty list if `data_tuple` is empty.\n    \"\"\"\n    results_list = []\n    for inner_tuple in data_tuple:\n        if not inner_tuple:\n            results_list.append(0.0)\n        else:\n            total_sum = sum(inner_tuple)\n            count = len(inner_tuple)\n            average = float(total_sum) / count\n            results_list.append(average)\n    return results_list"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(tuple_of_tuples: tuple) -> list:\n    \"\"\"Calculates the average of elements within each inner tuple and returns them as a list.\"\"\"\n    results_list = []\n    for inner_tuple in tuple_of_tuples:\n        # Calculate the average for each inner tuple assuming it's non-empty and contains numbers.\n        average = sum(inner_tuple) / len(inner_tuple)\n        results_list.append(average)\n    return results_list"}
{"task_id": "Mbpp/618", "solution": "def div_list(list1, list2):\n    \"\"\"\n    Performs element-wise division of two lists.\n    Each result is a floating-point number.\n    \"\"\"\n    if len(list1) != len(list2):\n        raise ValueError(\"Lists must have the same length for element-wise division.\")\n\n    result_list = []\n    for element1, element2 in zip(list1, list2):\n        if element2 == 0:\n            raise ZeroDivisionError(\"Division by zero encountered.\")\n        result_list.append(float(element1) / element2)\n    return result_list"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple1: tuple[int, ...], tuple2: tuple[int, ...]) -> tuple[int, ...]:\n    \"\"\"Performs element-wise modulo on two tuples of integers.\n    Assumes tuples are of the same length and no divisor is zero.\n    \"\"\"\n    return tuple(a % b for a, b in zip(tuple1, tuple2))"}
