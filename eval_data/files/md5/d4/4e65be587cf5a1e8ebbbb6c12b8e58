{"task_id": "Mbpp/763", "solution": "def find_min_diff(numbers: tuple, length: int) -> int:\n    \"\"\"Calculates the minimum absolute difference between any two distinct elements in a tuple.\n    The function sorts the numbers and iterates through adjacent elements to find the smallest difference.\n    \"\"\"\n    sorted_numbers = sorted(list(numbers))\n    min_difference = float('inf')\n\n    # Iterate through the sorted list, comparing adjacent elements.\n    for i in range(1, length):\n        current_diff = abs(sorted_numbers[i] - sorted_numbers[i - 1])\n        if current_diff < min_difference:\n            min_difference = current_diff\n\n    return int(min_difference)"}
{"task_id": "Mbpp/763", "solution": "from typing import Union, List, Tuple\ndef find_min_diff(arr: Union[List[int], List[float], Tuple[int, ...], Tuple[float, ...]], n: int) -> Union[int, float, None]:\n    \"\"\"\n    Finds the minimum absolute difference between any two elements in the input array/tuple.\n    Returns None if n < 2, otherwise returns the calculated minimum difference.\n    \"\"\"\n    if n < 2:\n        return None\n\n    # Sort the array to ensure minimum differences are between adjacent elements.\n    sorted_arr = sorted(arr)\n    min_diff = float('inf')\n\n    # Iterate through adjacent elements to find the minimum absolute difference.\n    for i in range(n - 1):\n        current_diff = abs(sorted_arr[i+1] - sorted_arr[i])\n        if current_diff < min_diff:\n            min_diff = current_diff\n\n    return min_diff"}
{"task_id": "Mbpp/765", "solution": "def is_power_of_two(num: int) -> bool:\n    \"\"\"Checks if a given positive integer is a power of two.\n    This uses a bitwise trick for efficiency.\"\"\"\n    return num > 0 and (num & (num - 1)) == 0\ndef is_polite(n: int) -> int:\n    \"\"\"Calculates the nth polite number, which is a positive integer not a power of two.\n    It iterates through numbers, counting those that are not powers of two.\"\"\"\n    polite_count = 0\n    current_num = 1\n    while True:\n        if not is_power_of_two(current_num):\n            polite_count += 1\n            if polite_count == n:\n                return current_num\n        current_num += 1"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(input_string: str) -> int:\n    \"\"\"Counts the number of digit characters in the given string.\n\n    Iterates through each character and increments a counter if the character is a digit.\n    \"\"\"\n    digit_count = 0\n    for char in input_string:\n        if char.isdigit():\n            digit_count += 1\n    return digit_count"}
{"task_id": "Mbpp/765", "solution": "def is_power_of_two(num: int) -> bool:\n    \"\"\"Checks if a positive integer is a power of two.\"\"\"\n    return num > 0 and (num & (num - 1) == 0)\ndef is_polite(num: int) -> bool:\n    \"\"\"Determines if a positive integer is a polite number.\n    A positive integer is polite if and only if it is not a power of two.\n    \"\"\"\n    return num > 0 and not is_power_of_two(num)"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(list_of_numbers: list[int], target_sum: int) -> int:\n    \"\"\"Counts pairs in a list that sum to the target, treating duplicates as distinct.\n    Each instance of a number at a unique index is considered for pair formation.\n    \"\"\"\n    pair_count = 0\n    n = len(list_of_numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if list_of_numbers[i] + list_of_numbers[j] == target_sum:\n                pair_count += 1\n    return pair_count"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list: list) -> list[tuple]:\n    \"\"\"\n    Generates a list of consecutive pairs from the input list.\n    Returns an empty list if the input has fewer than two elements.\n    \"\"\"\n    if len(input_list) < 2:\n        return []\n\n    result_pairs = []\n    for i in range(len(input_list) - 1):\n        item_a = input_list[i]\n        item_b = input_list[i + 1]\n        result_pairs.append((item_a, item_b))\n\n    return result_pairs"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list[int], target_sum: int) -> int:\n    \"\"\"\n    Counts pairs in a list that sum to the target value.\n    Each pair is unique based on the original indices of elements.\n    \"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n    return count"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list: list) -> list[tuple]:\n    \"\"\"\n    Generates a list of tuples, where each tuple contains two consecutive items from the input list.\n    Returns an empty list if the input list contains fewer than two items.\n    \"\"\"\n    if len(input_list) < 2:\n        return []\n\n    result_list = []\n    for i in range(len(input_list) - 1):\n        result_list.append((input_list[i], input_list[i+1]))\n\n    return result_list"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1: list, list2: list) -> list:\n    \"\"\"\n    Calculates the difference between two lists, returning elements present in list1 but not in list2.\n    For efficiency, list2 is converted to a set for O(1) average-case lookup time.\n    \"\"\"\n    set2 = set(list2)\n    result_list = []\n    for item in list1:\n        if item not in set2:\n            result_list.append(item)\n    return result_list"}
{"task_id": "Mbpp/749", "solution": "def sort_numeric_strings(numeric_strings: list[str]) -> list[int]:\n    # Convert all string elements to integers.\n    integers = [int(s) for s in numeric_strings]\n    # Sort the list of integers numerically in ascending order.\n    return sorted(integers)"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"Checks if the given string expression has balanced opening and closing brackets.\n    It uses a stack to ensure correct pairing and order of brackets.\"\"\"\n\n    stack = []\n\n    opening_brackets = \"([{\"\n    bracket_map = {\")\": \"(\", \"]\": \"[\", \"}\": \"{\"}\n\n    for char in expression:\n        if char in opening_brackets:\n            stack.append(char)\n        elif char in bracket_map:  # Character is a closing bracket\n            if not stack:\n                return False  # Unmatched closing bracket found\n\n            top_of_stack = stack.pop()\n            if bracket_map[char] != top_of_stack:\n                return False  # Mismatched opening and closing bracket\n\n    return not stack  # True if stack is empty (all brackets matched), False otherwise"}
{"task_id": "Mbpp/759", "solution": "import re\ndef is_decimal(input_string: str) -> bool:\n    \"\"\"Checks if a string represents a decimal number with exactly two decimal places.\n    Returns True for \"123.11\", False for \"123.1\" or \"123\".\n    \"\"\"\n    # This regex matches an optional sign, one or more digits, a decimal point, and exactly two fractional digits.\n    pattern = r\"^[+-]?\\d+\\.\\d{2}$\"\n    return bool(re.fullmatch(pattern, input_string))"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"Calculates the sum of the fourth power of the first n odd natural numbers.\n    It iterates through the first n odd numbers and accumulates their fourth powers.\n    \"\"\"\n    total_sum = 0\n    for k in range(1, n + 1):\n        odd_number = (2 * k) - 1\n        total_sum += odd_number ** 4\n    return total_sum"}
{"task_id": "Mbpp/770", "solution": "def _get_nth_odd_number(k: int) -> int:\n    \"\"\"Calculates the k-th odd natural number.\n    For example, for k=1 returns 1, for k=2 returns 3.\n    \"\"\"\n    return 2 * k - 1\ndef _calculate_power(base: int, exponent: int) -> int:\n    \"\"\"Calculates the power of a base number to a given exponent.\n    Computes base raised to the power of exponent.\n    \"\"\"\n    return base ** exponent\ndef odd_num_sum(n: int) -> int:\n    \"\"\"Calculates the sum of the fourth powers of the first n odd natural numbers.\n    It iterates through the first n odd numbers, calculates their fourth powers, and sums them up.\n    \"\"\"\n    total_sum = 0\n    for k in range(1, n + 1):\n        odd_number = _get_nth_odd_number(k)\n        fourth_power = _calculate_power(odd_number, 4)\n        total_sum += fourth_power\n    return total_sum"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"Checks if brackets in the given expression are balanced and correctly nested.\n    It handles parentheses '()', square brackets '[]', and curly braces '{}'.\n    \"\"\"\n    stack = []\n    bracket_map = {')': '(', ']': '[', '}': '{'}\n    open_brackets = set(bracket_map.values())\n    close_brackets = set(bracket_map.keys())\n\n    for char in expression:\n        if char in open_brackets:\n            stack.append(char)\n        elif char in close_brackets:\n            if not stack:\n                return False\n\n            last_open = stack.pop()\n            if bracket_map[char] != last_open:\n                return False\n\n    return not stack"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(input_string: str) -> int:\n    \"\"\"Counts the number of digit characters in the given input string.\n    Returns the total count as an integer.\n    \"\"\"\n    digit_count = 0\n    for char in input_string:\n        if char.isdigit():\n            digit_count += 1\n    return digit_count"}
{"task_id": "Mbpp/772", "solution": "def remove_length(input_string: str, k: int) -> str:\n    \"\"\"\n    Removes all words of a specified length k from the input string.\n    Returns a new string with remaining words, separated by single spaces.\n    \"\"\"\n    words = input_string.split()  # Splits by whitespace, handling multiple spaces.\n    filtered_words = [word for word in words if len(word) != k]  # Retains words not of length k.\n    return \" \".join(filtered_words) # Joins retained words with single spaces."}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(main_string: str, substring: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Finds the first occurrence of a substring within a main string.\n    Returns a tuple with the substring, start index, and exclusive end index, or None if not found.\n    \"\"\"\n    start_index = main_string.find(substring)\n    if start_index != -1:\n        end_index = start_index + len(substring)\n        return (substring, start_index, end_index)\n    else:\n        return None"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(given_string: str, specified_substring: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Identifies the first occurrence of a substring, returning its details or None.\n    Handles empty substrings according to business rule BR5.\n    \"\"\"\n    # BR5: If the specified_substring is empty, return ('', 0, 0).\n    if not specified_substring:\n        return ('', 0, 0)\n\n    # FR1, BR4: Find the first occurrence of the specified_substring case-sensitively.\n    # str.find() returns the starting index or -1 if not found.\n    start_index = given_string.find(specified_substring)\n\n    # FR3, BR3: If the substring is not found, return None.\n    if start_index == -1:\n        return None\n    else:\n        # FR2, BR2: Calculate the exclusive ending index and return the details tuple.\n        end_index = start_index + len(specified_substring)\n        return (specified_substring, start_index, end_index)"}
{"task_id": "Mbpp/772", "solution": "def remove_length(input_string: str, k: int) -> str:\n    \"\"\"Removes all words of a specific length 'k' from the input string.\n    Words are delimited by spaces, and the result is a new string with remaining words joined by single spaces.\n    \"\"\"\n    words = input_string.split(' ')\n    filtered_words_list = []\n    for word in words:\n        cleaned_word = word.strip()\n        if cleaned_word:  # Ignore empty strings resulting from multiple spaces\n            if len(cleaned_word) != k:\n                filtered_words_list.append(cleaned_word)\n    return ' '.join(filtered_words_list)"}
{"task_id": "Mbpp/775", "solution": "def odd_position(input_list: list[int]) -> bool:\n    \"\"\"\n    Checks if every element at an odd index in the input list is an odd number.\n    Returns True if all elements at odd indices are odd, False otherwise.\n    \"\"\"\n    for index, element in enumerate(input_list):\n        if index % 2 != 0:  # Check if the index is odd.\n            if element % 2 == 0:  # Check if the element at this odd index is even.\n                return False\n    return True"}
{"task_id": "Mbpp/777", "solution": "def find_sum(numbers: list) -> float:\n    \"\"\"\n    Calculates the sum of all unique numerical elements in a given list.\n    It efficiently uses a set to extract unique elements before summing them.\n    \"\"\"\n    unique_elements = set(numbers)\n    total_sum = sum(unique_elements)\n    return total_sum"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list) -> list[list]:\n    \"\"\"Packs consecutive duplicate elements of a list into sublists.\n    This function processes the input list in linear time, handling various comparable data types.\n    \"\"\"\n    output_list = []\n    current_sublist = []\n\n    if not input_list:\n        return []\n\n    for element in input_list:\n        if not current_sublist or element == current_sublist[-1]:\n            current_sublist.append(element)\n        else:\n            output_list.append(current_sublist)\n            current_sublist = [element]\n\n    if current_sublist:\n        output_list.append(current_sublist)\n\n    return output_list"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1, list2):\n    \"\"\"\n    Calculates the difference between two lists.\n    Returns elements present in list1 but not in list2, preserving their original order from list1.\n    \"\"\"\n    set2 = set(list2)\n    result_list = []\n    for item in list1:\n        if item not in set2:\n            result_list.append(item)\n    return result_list"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(number: int) -> bool:\n    \"\"\"\n    Determines if a positive integer has an even count of positive divisors.\n    This uses the property that only perfect squares have an odd number of divisors.\n    \"\"\"\n    # Find integer 'i' such that i*i is approximately 'number'.\n    i = 1\n    while i * i < number:\n        i += 1\n\n    # Check if 'number' is a perfect square.\n    is_perfect_square = (i * i == number)\n\n    # Return True if divisor count is even (not a perfect square), False otherwise.\n    return not is_perfect_square"}
{"task_id": "Mbpp/780", "solution": "import itertools\nfrom typing import List, Tuple as PyTuple\ndef find_combinations(input_tuples: List[PyTuple[int, ...]]) -> List[PyTuple[int, ...]]:\n    \"\"\"\n    Calculates the element-wise sum for all unique pairs of tuples from the input list.\n    Each tuple in the output is the element-wise sum of a unique pair.\n    \"\"\"\n    result_sums: List[PyTuple[int, ...]] = []\n\n    for tuple1, tuple2 in itertools.combinations(input_tuples, 2):\n        sum_tuple = PyTuple(a + b for a, b in zip(tuple1, tuple2))\n        result_sums.append(sum_tuple)\n\n    return result_sums"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(n: int) -> bool:\n    \"\"\"Calculates the number of positive divisors for n and returns True if the count is even, False otherwise.\"\"\"\n    divisor_count = 0\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            if i * i == n:\n                divisor_count += 1\n            else:\n                divisor_count += 2\n        i += 1\n    return divisor_count % 2 == 0"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of all elements across all odd-length subarrays of a given input array.\n    It takes a list of integers and returns their total sum.\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):\n        for j in range(i, n):\n            length = j - i + 1\n            if length % 2 == 1:\n                for k in range(i, j + 1):\n                    total_sum += arr[k]\n    return total_sum"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(numbers: list[int | float]) -> int:\n    \"\"\"\n    Computes the sum of all odd-length subarrays from the input list.\n    It iterates through all possible subarrays, summing elements of odd-length ones.\n    \"\"\"\n    total_sum = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i, n):\n            subarray_length = j - i + 1\n            if subarray_length % 2 == 1:\n                total_sum += sum(numbers[i : j + 1])\n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "def _find_first_odd(numbers: list) -> int | None:\n    \"\"\"Finds the first odd number in the given list.\n\n    Returns None if no odd number is found.\n    \"\"\"\n    for num in numbers:\n        if num % 2 != 0:\n            return num\n    return None\ndef _find_first_even(numbers: list) -> int | None:\n    \"\"\"Finds the first even number in the given list.\n\n    Returns None if no even number is found.\n    \"\"\"\n    for num in numbers:\n        if num % 2 == 0:\n            return num\n    return None\ndef mul_even_odd(numbers: list) -> int:\n    \"\"\"Calculates the product of the first odd and first even numbers found in a list.\n\n    Returns 0 if either the first odd or first even number is not found.\n    \"\"\"\n    first_odd = _find_first_odd(numbers)\n    first_even = _find_first_even(numbers)\n\n    if first_odd is None or first_even is None:\n        return 0\n\n    return first_odd * first_even"}
{"task_id": "Mbpp/784", "solution": "from typing import Optional\ndef mul_even_odd(numbers: list[int]) -> Optional[int]:\n    \"\"\"Calculates the product of the first even and first odd numbers in a list.\n    Returns None if either number is not found.\"\"\"\n    first_odd: Optional[int] = None\n    first_even: Optional[int] = None\n\n    for number in numbers:\n        if first_odd is None and number % 2 != 0:\n            first_odd = number\n\n        if first_even is None and number % 2 == 0:\n            first_even = number\n\n        if first_odd is not None and first_even is not None:\n            break\n\n    if first_odd is not None and first_even is not None:\n        return first_odd * first_even\n    else:\n        return None"}
{"task_id": "Mbpp/775", "solution": "def odd_position(input_list: list[int]) -> bool:\n    \"\"\"Checks if every number at an odd index in the list is an odd number.\n    Returns True if the condition holds or if there are no odd indices, False otherwise.\n    \"\"\"\n    for i, num in enumerate(input_list):\n        if i % 2 != 0:  # Check if the index 'i' is odd\n            if num % 2 == 0:  # If at an odd index, check if the number 'num' is even\n                return False  # An even number found at an odd index, so the condition is not met\n    return True  # All odd-indexed numbers were odd, or no odd indices were present"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(tuple_str: str) -> tuple[int, ...]:\n    \"\"\"\n    Converts a string representation of a tuple into a tuple of integers.\n    Parses the input string to extract and convert integer elements.\n    \"\"\"\n    # Remove outer parentheses and strip any leading/trailing whitespace from the content.\n    # This relies on tuple_str having at least two characters (e.g., \"()\").\n    content = tuple_str[1:-1].strip()\n\n    # If the content between parentheses is empty, return an empty tuple.\n    if not content:\n        return ()\n\n    # Split the content by comma and strip whitespace from each resulting element string.\n    element_strings = [el.strip() for el in content.split(',')]\n\n    # Convert each element string to an integer.\n    # This will raise ValueError if any element cannot be converted to an int.\n    integer_elements = [int(el) for el in element_strings]\n\n    return tuple(integer_elements)"}
{"task_id": "Mbpp/777", "solution": "def find_sum(input_list: list) -> int:\n    \"\"\"Calculates the sum of elements that appear exactly once in the input list.\n    This function counts occurrences of each element and then sums those with a count of one.\n    \"\"\"\n    counts = {}\n    for element in input_list:\n        counts[element] = counts.get(element, 0) + 1\n\n    total_sum = 0\n    for element, count in counts.items():\n        if count == 1:\n            total_sum += element\n\n    return total_sum"}
{"task_id": "Mbpp/780", "solution": "def find_combinations(tuple_list: list[tuple[int, int]]) -> list[tuple[int, int]]:\n    \"\"\"\n    Computes element-wise sums of all unique pairs of 2-element integer tuples from the input list.\n    \"\"\"\n    result = []\n    n = len(tuple_list)\n    for i in range(n):\n        for j in range(i + 1, n):\n            # Sum elements of tuple_list[i] and tuple_list[j] element-wise\n            sum_tuple = (tuple_list[i][0] + tuple_list[j][0], tuple_list[i][1] + tuple_list[j][1])\n            result.append(sum_tuple)\n    return result"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(tuple_string: str) -> tuple[int, ...]:\n    \"\"\"Converts a string like '(x, y, z)' into a tuple of integers (x, y, z).\n    Handles parsing, type casting, and tuple construction.\"\"\"\n\n    # Remove leading and trailing parentheses from the input string.\n    content_string = tuple_string.strip('()')\n\n    # Split the string by comma to get individual string representations of numbers.\n    string_numbers = content_string.split(',')\n\n    integer_values = []\n    for s_num in string_numbers:\n        # Strip any leading or trailing whitespace from each number string.\n        cleaned_s_num = s_num.strip()\n\n        # Convert each cleaned substring to an integer.\n        # This will raise ValueError for non-integer or empty strings.\n        integer_values.append(int(cleaned_s_num))\n\n    # Construct and return a tuple from the list of converted integer values.\n    return tuple(integer_values)"}
{"task_id": "Mbpp/786", "solution": "from typing import Any\ndef right_insertion(arr: list, x: Any) -> int:\n    \"\"\"\n    Returns the index where x should be inserted in arr to maintain sorted order.\n    If x is present, the insertion point is after all existing occurrences of x.\n    \"\"\"\n    low = 0\n    high = len(arr)\n\n    while low < high:\n        mid = (low + high) // 2\n        if arr[mid] <= x:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
