{"task_id": "Mbpp/593", "solution": "def _remove_leading_zeros_from_octet(octet_str: str) -> str:\n    \"\"\"\n    Removes leading zeros from a single octet string.\n    It converts the string to an integer and then back to a string.\n    \"\"\"\n    return str(int(octet_str))\ndef removezero_ip(ip_address_str: str) -> str:\n    \"\"\"\n    Removes leading zeros from each octet of the input IP address string.\n    The function splits the IP, processes each octet, and then rejoins them.\n    \"\"\"\n    octets = ip_address_str.split('.')\n    cleaned_octets = [_remove_leading_zeros_from_octet(octet) for octet in octets]\n    return '.'.join(cleaned_octets)"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers_list: list) -> int:\n    \"\"\"\n    Calculates the difference between the first even and first odd number found in a list.\n    Raises ValueError if either number type is not found.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for number in numbers_list:\n        if number % 2 == 0 and first_even is None:\n            first_even = number\n        if number % 2 != 0 and first_odd is None:\n            first_odd = number\n\n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is None or first_odd is None:\n        raise ValueError(\"Could not find both first even and first odd numbers.\")\n\n    difference = first_even - first_odd\n    return int(difference)"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(num_list: list[int]) -> int:\n    \"\"\"\n    Calculates the absolute difference between the first even and first odd numbers in a list.\n    Raises ValueError if either an even or odd number is not found.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in num_list:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        elif first_odd is None and num % 2 != 0:\n            first_odd = num\n\n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is None:\n        raise ValueError(\"No even number found\")\n    if first_odd is None:\n        raise ValueError(\"No odd number found\")\n\n    return abs(first_even - first_odd)"}
{"task_id": "Mbpp/597", "solution": "def find_kth(array1: list[int], array2: list[int], k: int) -> int:\n    \"\"\"\n    Finds the kth smallest element from two sorted arrays.\n    This function assumes valid, sorted inputs as per critical requirements.\n    \"\"\"\n    len1 = len(array1)\n    len2 = len(array2)\n    p1 = 0\n    p2 = 0\n    kth_element = 0 # This will be overwritten as per problem constraints\n\n    for _ in range(k):\n        if p1 < len1 and (p2 >= len2 or array1[p1] <= array2[p2]):\n            kth_element = array1[p1]\n            p1 += 1\n        elif p2 < len2:\n            kth_element = array2[p2]\n            p2 += 1\n\n    return kth_element"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(num: int) -> bool:\n    \"\"\"\n    Determines if an integer is an Armstrong number.\n    An Armstrong number is equal to the sum of its own digits, each raised to the power of the number of digits.\n    \"\"\"\n    str_num = str(num)\n    n = len(str_num)\n    sum_of_powers = 0\n    for digit_char in str_num:\n        digit = int(digit_char)\n        sum_of_powers += digit ** n\n    return sum_of_powers == num"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(num):\n    \"\"\"Checks if the given number is an Armstrong number.\n    An Armstrong number is an n-digit number equal to the sum of its digits raised to the nth power.\"\"\"\n\n    num_str = str(num)\n    n = len(num_str)\n    sum_of_powers = 0\n    for digit_char in num_str:\n        digit = int(digit_char)\n        sum_of_powers += digit ** n\n\n    return sum_of_powers == num"}
