{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n\n    Args:\n        n: An integer representing the count of natural numbers.\n\n    Returns:\n        An integer representing the calculated difference.\n    \"\"\"\n    # Calculate the sum of the first n natural numbers.\n    sum_of_natural_numbers = n * (n + 1) // 2\n\n    # Calculate the sum of cubes, which is the square of sum_of_natural_numbers.\n    sum_of_cubes = sum_of_natural_numbers ** 2\n\n    # Compute the difference between the sum of cubes and the sum of natural numbers.\n    result = sum_of_cubes - sum_of_natural_numbers\n\n    return result"}
{"task_id": "Mbpp/555", "solution": "def _calculate_sum_of_n(n: int) -> int:\n    \"\"\"Calculates the sum of the first n natural numbers.\"\"\"\n    return n * (n + 1) // 2\ndef _calculate_sum_of_cubes_of_n(n: int) -> int:\n    \"\"\"Calculates the sum of the cubes of the first n natural numbers.\"\"\"\n    sum_n = _calculate_sum_of_n(n)\n    return sum_n ** 2\ndef difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    sum_cubes = _calculate_sum_of_cubes_of_n(n)\n    sum_n = _calculate_sum_of_n(n)\n    return sum_cubes - sum_n"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr: list[int], n: int) -> int:\n    \"\"\"\n    Counts the number of unique pairs in a list whose bitwise XOR value is odd.\n    Iterates through all pairs and checks if their XOR sum is odd.\n    \"\"\"\n    odd_pair_count = 0\n\n    # If fewer than 2 elements, no pairs can be formed.\n    if n < 2:\n        return 0\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            # Compute the bitwise XOR for the pair.\n            xor_value = arr[i] ^ arr[j]\n            # Check if the XOR value is odd.\n            if xor_value % 2 != 0:\n                odd_pair_count += 1\n\n    return odd_pair_count"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string: str) -> str:\n    \"\"\"Toggles the case of alphabetic characters in a string, leaving others unchanged.\"\"\"\n    toggled_chars = []\n    for char in input_string:\n        if char.isupper():\n            toggled_chars.append(char.lower())\n        elif char.islower():\n            toggled_chars.append(char.upper())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/473", "solution": "def _normalize_tuple(tup: tuple) -> tuple:\n    \"\"\"\n    Converts a tuple into a canonical (sorted) form for order-independent comparison.\n    E.g., (4,3) becomes (3,4).\n    \"\"\"\n    return tuple(sorted(tup))\ndef tuple_intersection(list1: list[tuple], list2: list[tuple]) -> set[tuple]:\n    \"\"\"\n    Finds the order-independent intersection of tuples between two input lists.\n    Treats tuples with the same elements, regardless of their order, as identical.\n    \"\"\"\n    normalized_set1 = {_normalize_tuple(t) for t in list1}\n    normalized_set2 = {_normalize_tuple(t) for t in list2}\n    return normalized_set1.intersection(normalized_set2)"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"Calculates the sum of absolute differences between corresponding digits of two integers.\n    The shorter number is padded with leading zeros to match the length of the longer number.\"\"\"\n    str_num1 = str(num1)\n    str_num2 = str(num2)\n\n    max_length = max(len(str_num1), len(str_num2))\n\n    padded_str_num1 = str_num1.zfill(max_length)\n    padded_str_num2 = str_num2.zfill(max_length)\n\n    total_sum_of_differences = 0\n    for i in range(max_length):\n        digit1 = int(padded_str_num1[i])\n        digit2 = int(padded_str_num2[i])\n        total_sum_of_differences += abs(digit1 - digit2)\n\n    return total_sum_of_differences"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(s: str) -> str:\n    \"\"\"Toggles the case of alphabetic characters in the input string.\n    Uppercase characters become lowercase, and lowercase characters become uppercase; other characters remain unchanged.\"\"\"\n    toggled_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            toggled_chars.append(chr(ord(char) - 32))\n        elif 'A' <= char <= 'Z':\n            toggled_chars.append(chr(ord(char) + 32))\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(int1: int, int2: int) -> int:\n    \"\"\"Calculates the sum of per-digit absolute differences between two integers.\n    The shorter integer is conceptually padded with leading zeros for alignment.\n    \"\"\"\n    # Convert the absolute values of the integers to string representations.\n    abs_str1 = str(abs(int1))\n    abs_str2 = str(abs(int2))\n\n    # Determine the maximum length and pad the shorter string with leading zeros.\n    max_length = max(len(abs_str1), len(abs_str2))\n    padded_str1 = abs_str1.zfill(max_length)\n    padded_str2 = abs_str2.zfill(max_length)\n\n    total_sum = 0\n    # Iterate through each digit pair, calculate absolute difference, and sum them.\n    for i in range(max_length):\n        digit1 = int(padded_str1[i])\n        digit2 = int(padded_str2[i])\n        total_sum += abs(digit1 - digit2)\n\n    return total_sum"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(list_of_numbers: list) -> int:\n    \"\"\"Calculates the sum of the largest contiguous sublist using Kadane's algorithm.\n    Returns 0 for an empty input list as per the design specification.\"\"\"\n    if not list_of_numbers:\n        return 0\n\n    global_max = float('-inf')\n    current_max = 0\n\n    for number in list_of_numbers:\n        current_max = max(number, current_max + number)\n        global_max = max(global_max, current_max)\n\n    return int(global_max)"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr: list[int], n: int) -> int:\n    \"\"\"\n    Calculates the sum of the largest contiguous sublist within a given list of integers using Kadane's algorithm.\n\n    Args:\n        arr: A list of integers.\n        n: The length of the list (not directly used in Kadane's algorithm but included as per problem statement).\n\n    Returns:\n        An integer representing the maximum sum of any contiguous sublist.\n    \"\"\"\n    if not arr:\n        return 0\n\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, len(arr)):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
