{"task_id": "Mbpp/260", "solution": "_nsw_sequence_cache = {0: 1, 1: 1}\ndef _generate_nsw_number(index: int) -> int:\n    \"\"\"Calculates the NSW number at a given index, using memoization.\n    It populates the cache iteratively up to the desired index.\"\"\"\n    if index in _nsw_sequence_cache:\n        return _nsw_sequence_cache[index]\n\n    for i in range(len(_nsw_sequence_cache), index + 1):\n        s_i_minus_1 = _nsw_sequence_cache[i - 1]\n        s_i_minus_2 = _nsw_sequence_cache[i - 2]\n        _nsw_sequence_cache[i] = 2 * s_i_minus_1 + s_i_minus_2\n\n    return _nsw_sequence_cache[index]\ndef _is_prime(number: int) -> bool:\n    \"\"\"Checks if a number is prime using an optimized trial division method.\n    It efficiently handles small numbers and skips multiples of 2 and 3.\"\"\"\n    if number < 2:\n        return False\n    if number <= 3:\n        return True\n    if number % 2 == 0 or number % 3 == 0:\n        return False\n\n    i = 5\n    while i * i <= number:\n        if number % i == 0 or number % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef newman_prime(n: int) -> int:\n    \"\"\"Finds the nth Newman-Shanks-Williams (NSW) prime number.\"\"\"\n    primes_found_count = 0\n    current_nsw_index = 0\n\n    while True:\n        nsw_value = _generate_nsw_number(current_nsw_index)\n        if _is_prime(nsw_value):\n            primes_found_count += 1\n            if primes_found_count == n:\n                return nsw_value\n        current_nsw_index += 1"}
{"task_id": "Mbpp/260", "solution": "def newman_prime(n):\n    \"\"\"Calculates the n-th Newman-Shanks-Williams number S_n.\n    The problem assumes S_n is prime for the given input n.\"\"\"\n    if n == 0:\n        return 1\n    if n == 1:\n        return 1\n\n    s_n_minus_2 = 1  # Represents S_{i-2}\n    s_n_minus_1 = 1  # Represents S_{i-1}\n\n    for _ in range(2, n + 1):\n        current_s = 2 * s_n_minus_1 + s_n_minus_2\n        s_n_minus_2 = s_n_minus_1\n        s_n_minus_1 = current_s\n\n    return s_n_minus_1"}
