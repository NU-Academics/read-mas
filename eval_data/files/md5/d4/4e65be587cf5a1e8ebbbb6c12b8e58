{"task_id": "Mbpp/120", "solution": "def max_product_tuple(input_list_of_tuples):\n    \"\"\"\n    Calculates the maximum absolute product from pairs of numbers within a list of tuples.\n    Assumes input_list_of_tuples is non-empty and each tuple contains two numbers.\n    \"\"\"\n    first_num1, first_num2 = input_list_of_tuples[0]\n    max_abs_product = abs(first_num1 * first_num2)\n\n    for num1, num2 in input_list_of_tuples[1:]:\n        current_product = num1 * num2\n        current_abs_product = abs(current_product)\n        if current_abs_product > max_abs_product:\n            max_abs_product = current_abs_product\n\n    return max_abs_product"}
{"task_id": "Mbpp/119", "solution": "def search(arr: list[int]) -> int:\n    \"\"\"Finds the single unique integer in a sorted array where all other elements appear twice.\"\"\"\n    low = 0\n    high = len(arr) - 1\n\n    while low < high:\n        mid = (low + high) // 2\n\n        if mid % 2 == 0:  # If mid is an even index\n            if arr[mid] == arr[mid + 1]:\n                low = mid + 2\n            else:\n                high = mid\n        else:  # If mid is an odd index\n            if arr[mid] == arr[mid - 1]:\n                low = mid + 1\n            else:\n                high = mid - 1\n\n    return arr[low]"}
{"task_id": "Mbpp/119", "solution": "def search(arr: list) -> object:\n    \"\"\"\n    Finds the single element that appears only once in a sorted array.\n    This function leverages a binary search approach for efficient identification.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n\n    while low < high:\n        mid = (low + high) // 2\n        # If arr[mid] is equal to its paired element (arr[mid+1] if mid is even, arr[mid-1] if mid is odd)\n        # mid ^ 1 efficiently gives the index of the element that should be paired with mid.\n        if arr[mid] == arr[mid ^ 1]:\n            # The elements up to this pair are all duplicates. The unique element is in the right half.\n            # Advance 'low' past the current pair.\n            low = (mid ^ 1) + 1\n        else:\n            # arr[mid] is not equal to its expected pair. The unique element is at or before mid.\n            high = mid\n\n    return arr[low]"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(data: list[tuple]) -> int | float:\n    \"\"\"\n    Calculates the maximum absolute product from pairs of numbers in a list of tuples.\n    Initializes max_abs_product to 0 and iterates through the input to find the largest absolute product.\n    \"\"\"\n    max_abs_product = 0\n    for a, b in data:\n        current_product = a * b\n        abs_current_product = abs(current_product)\n        if abs_current_product > max_abs_product:\n            max_abs_product = abs_current_product\n    return max_abs_product"}
