{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks if an integer is an undulating number.\n    An undulating number has at least two digits whose digits strictly alternate between exactly two distinct values.\n    \"\"\"\n    num_str = str(abs(number))\n\n    if len(num_str) < 2:\n        return False\n\n    d1 = num_str[0]\n    d2 = None\n\n    # Find the second distinct digit (d2)\n    for i in range(1, len(num_str)):\n        if num_str[i] != d1:\n            d2 = num_str[i]\n            break\n\n    # If no second distinct digit is found, all digits are the same\n    if d2 is None:\n        return False\n\n    # Verify the alternating pattern from the third digit onwards\n    for i in range(2, len(num_str)):\n        if i % 2 == 0:  # Even index, expecting d1\n            if num_str[i] != d1:\n                return False\n        else:  # Odd index, expecting d2\n            if num_str[i] != d2:\n                return False\n\n    return True"}
{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"Checks if a positive integer is an undulating number.\n    An undulating number alternates between two distinct digits and has at least three digits.\n    \"\"\"\n    s_number = str(number)\n\n    if len(s_number) < 3:\n        return False\n\n    digit1 = s_number[0]\n    digit2 = None\n\n    # Identify the first digit (digit1) and the first distinct subsequent digit (digit2).\n    for i in range(1, len(s_number)):\n        if s_number[i] != digit1:\n            digit2 = s_number[i]\n            break\n\n    # If no distinct second digit is found, the number consists of only one repeating digit.\n    if digit2 is None:\n        return False\n\n    # Verify that all digits strictly alternate between digit1 and digit2.\n    for i in range(len(s_number)):\n        if i % 2 == 0:  # Digits at even indices must match digit1\n            if s_number[i] != digit1:\n                return False\n        else:  # Digits at odd indices must match digit2\n            if s_number[i] != digit2:\n                return False\n\n    return True"}
{"task_id": "Mbpp/93", "solution": "def power(a, b):\n    \"\"\"Calculates 'a' raised to the power of 'b', handling various exponent types.\n    This implementation adheres to specific business rules for positive, zero, and negative integer exponents.\n    \"\"\"\n    # Business Rule 3, Business Rule 5: If the exponent is 0, the result is 1.\n    # This also covers 0^0 which results in 1.\n    if b == 0:\n        return 1.0\n\n    # Business Rule 4: If the base is 0 and the exponent is positive, the result is 0.\n    # For a base of 0 and a negative exponent, return infinity to avoid ZeroDivisionError as per constraints.\n    if a == 0:\n        if b > 0:\n            return 0.0\n        # 0 raised to a negative exponent results in 1/0, which is infinity.\n        # \"Do NOT raise exceptions for edge cases\" requires returning float('inf').\n        return float('inf')\n\n    # Handle negative exponent (Business Rule 6) by calculating 1 / (base ^ |exponent|).\n    is_negative_exponent = False\n    if b < 0:\n        is_negative_exponent = True\n        b = -b  # Convert exponent to its absolute positive value for calculation\n\n    # Business Rule 2: For positive exponents, multiply the base by itself 'exponent' times.\n    result = 1.0\n    for _ in range(b):\n        result *= a\n\n    # If the original exponent was negative, invert the result.\n    if is_negative_exponent:\n        return 1.0 / result\n    else:\n        return result"}
{"task_id": "Mbpp/94", "solution": "from typing import List, Tuple, Any, Optional\ndef index_minimum(list_of_tuples: List[Tuple[Any, Any]]) -> Optional[Any]:\n    \"\"\"\n    Identifies the tuple with the smallest second value from a list of tuples.\n    Returns the first value of the identified tuple, or None if the input list is empty.\n    \"\"\"\n    if not list_of_tuples:\n        return None\n\n    min_tuple = list_of_tuples[0]\n\n    for current_tuple in list_of_tuples[1:]:\n        if current_tuple[1] < min_tuple[1]:\n            min_tuple = current_tuple\n\n    return min_tuple[0]"}
