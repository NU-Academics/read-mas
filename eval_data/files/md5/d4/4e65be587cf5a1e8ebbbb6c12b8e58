{"task_id": "Mbpp/440", "solution": "import re\nimport string\ndef _clean_punctuation(word: str) -> str:\n    \"\"\"Removes leading and trailing punctuation from a word.\"\"\"\n    while word and word[0] in string.punctuation:\n        word = word[1:]\n    while word and word[-1] in string.punctuation:\n        word = word[:-1]\n    return word\ndef _is_adverb(word: str) -> bool:\n    \"\"\"Checks if a word is likely an adverb based on suffixes or a small dictionary.\"\"\"\n    if len(word) > 2 and word.endswith('ly'):\n        return True\n    common_adverbs = {\"then\", \"now\", \"here\", \"there\", \"often\", \"always\", \"never\", \"very\", \"too\", \"quite\", \"just\", \"well\", \"fast\", \"hard\", \"soon\"}\n    return word.lower() in common_adverbs\ndef find_adverb_position(sentence: str) -> tuple[int, int, str] | None:\n    \"\"\"\n    Identifies the first adverb in a sentence, its original positions, and cleaned text.\n    Returns (start_index, end_index, cleaned_adverb_string) or None if no adverb is found.\n    \"\"\"\n    for match in re.finditer(r'\\S+', sentence):\n        original_word_with_punctuation = match.group(0)\n        original_start_index = match.start()\n\n        cleaned_word = _clean_punctuation(original_word_with_punctuation)\n\n        if _is_adverb(cleaned_word):\n            leading_punctuation_count = 0\n            for char in original_word_with_punctuation:\n                if char in string.punctuation:\n                    leading_punctuation_count += 1\n                else:\n                    break\n\n            adjusted_start_index = original_start_index + leading_punctuation_count\n            adjusted_end_index = adjusted_start_index + len(cleaned_word)\n\n            return (adjusted_start_index, adjusted_end_index, cleaned_word)\n\n    return None"}
{"task_id": "Mbpp/446", "solution": "def count_Occurrence(input_tuple: tuple, input_list: list) -> int:\n    \"\"\"Counts the total occurrence of all elements from a list within a tuple.\"\"\"\n\n    total_count = 0\n    # Create a frequency map for the input_tuple elements.\n    tuple_counts = {}\n    for item in input_tuple:\n        tuple_counts[item] = tuple_counts.get(item, 0) + 1\n\n    # Iterate through each element in the input_list and sum their counts.\n    for element in input_list:\n        total_count += tuple_counts.get(element, 0)\n\n    return total_count"}
{"task_id": "Mbpp/445", "solution": "def index_multiplication(tuple1: tuple[tuple[float, float], ...], tuple2: tuple[tuple[float, float], ...]) -> tuple[tuple[float, float], ...]:\n    \"\"\"\n    Performs element-wise multiplication of corresponding inner tuples from two input tuples of tuples.\n    It multiplies the first elements and second elements separately to form new inner tuples.\n    \"\"\"\n    result_list = []\n    for sub_tuple1, sub_tuple2 in zip(tuple1, tuple2):\n        product1 = sub_tuple1[0] * sub_tuple2[0]\n        product2 = sub_tuple1[1] * sub_tuple2[1]\n        result_list.append((product1, product2))\n    return tuple(result_list)"}
{"task_id": "Mbpp/445", "solution": "from typing import Tuple, Union\ndef index_multiplication(\n    tuple1: Tuple[Tuple[Union[int, float]]],\\\n    tuple2: Tuple[Tuple[Union[int, float]]]\n) -> Tuple[Tuple[Union[int, float]]]:\n    \"\"\"\n    Performs index-wise multiplication of elements in corresponding inner tuples from `tuple1` and `tuple2`.\n    Returns a new tuple of tuples with the products.\n    \"\"\"\n    main_results_list = []\n    for inner_tuple1, inner_tuple2 in zip(tuple1, tuple2):\n        inner_products_list = []\n        for elem1, elem2 in zip(inner_tuple1, inner_tuple2):\n            product = elem1 * elem2\n            inner_products_list.append(product)\n        main_results_list.append(tuple(inner_products_list))\n    return tuple(main_results_list)"}
