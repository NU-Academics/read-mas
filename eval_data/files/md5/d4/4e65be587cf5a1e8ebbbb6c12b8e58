{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"\n    Calculates the length of the longest palindromic subsequence in the given string.\n    Uses dynamic programming to build solutions from smaller substrings.\n    \"\"\"\n    n = len(s)\n\n    if n == 0:\n        return 0\n\n    # dp[i][j] stores the length of LPS for substring s[i...j]\n    dp = [[0] * n for _ in range(n)]\n\n    # All single characters are palindromic subsequences of length 1\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the dp table for substrings of length L from 2 to n\n    for L in range(2, n + 1):\n        for i in range(n - L + 1):\n            j = i + L - 1\n            if s[i] == s[j]:\n                if L == 2:\n                    dp[i][j] = 2\n                else:\n                    dp[i][j] = 2 + dp[i + 1][j - 1]\n            else:\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n    # The result is the length of LPS for the entire string s[0...n-1]\n    return dp[0][n - 1]"}
{"task_id": "Mbpp/247", "solution": "def lps(input_string: str) -> int:\n    \"\"\"Calculates the length of the longest palindromic subsequence.\n    This function uses dynamic programming to find the LPS length.\n    \"\"\"\n    n = len(input_string)\n\n    if n == 0:\n        return 0\n\n    # dp[i][j] stores the length of the LPS of substring s[i...j]\n    dp = [[0 for _ in range(n)] for _ in range(n)]\n\n    # All single characters are palindromes of length 1\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the DP table for lengths from 2 to n\n    for current_len in range(2, n + 1):\n        for i in range(n - current_len + 1):\n            j = i + current_len - 1\n            if input_string[i] == input_string[j]:\n                if current_len == 2:\n                    dp[i][j] = 2\n                else:\n                    dp[i][j] = 2 + dp[i + 1][j - 1]\n            else:\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n    return dp[0][n - 1]"}
{"task_id": "Mbpp/245", "solution": "def max_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum sum of a bitonic subsequence in the given array.\n    A bitonic subsequence is a sequence that is first increasing and then decreasing.\n    \"\"\"\n    n = len(arr)\n\n    if n == 0:\n        return 0\n\n    # Calculate increasing_sum[i]: max sum of increasing subsequence ending at i\n    # Each element arr[i] itself forms an increasing subsequence of sum arr[i].\n    increasing_sum = list(arr)\n    for i in range(1, n):\n        for j in range(i):\n            if arr[i] > arr[j]:\n                increasing_sum[i] = max(increasing_sum[i], increasing_sum[j] + arr[i])\n\n    # Calculate decreasing_sum[i]: max sum of decreasing subsequence starting at i\n    # Each element arr[i] itself forms a decreasing subsequence of sum arr[i].\n    decreasing_sum = list(arr)\n    for i in range(n - 2, -1, -1):  # Iterate from second to last element down to first\n        for j in range(n - 1, i, -1):  # Iterate from last element down to element after i\n            if arr[i] > arr[j]:\n                decreasing_sum[i] = max(decreasing_sum[i], decreasing_sum[j] + arr[i])\n\n    # Combine results to find the maximum bitonic sum.\n    # arr[i] is the peak element, counted in both increasing_sum[i] and decreasing_sum[i],\n    # so it must be subtracted once. Initialize with arr[0] as a single element is bitonic.\n    max_bitonic_sum = arr[0]\n    for i in range(n):\n        max_bitonic_sum = max(max_bitonic_sum, increasing_sum[i] + decreasing_sum[i] - arr[i])\n\n    return max_bitonic_sum"}
