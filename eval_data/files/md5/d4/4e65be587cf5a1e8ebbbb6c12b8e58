{"task_id": "Mbpp/223", "solution": "def is_majority(array: list[int], n: int, element: int) -> bool:\n    \"\"\"\n    Checks if 'element' is the majority element in a sorted 'array' of length 'n'.\n    A majority element occurs more than n/2 times.\n    \"\"\"\n    # Binary search to find the first occurrence of 'element'\n    low, high = 0, n - 1\n    first_idx = -1\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == element:\n            first_idx = mid\n            high = mid - 1\n        elif array[mid] < element:\n            low = mid + 1\n        else: # array[mid] > element\n            high = mid - 1\n\n    if first_idx == -1:\n        return False\n\n    # Check if the element at first_idx + n/2 is also 'element'.\n    # This implies that 'element' appears at least (n // 2 + 1) times.\n    required_index = first_idx + (n // 2)\n\n    return required_index < n and array[required_index] == element"}
{"task_id": "Mbpp/223", "solution": "def find_first_occurrence(arr: list, low: int, high: int, x: int) -> int:\n    \"\"\"Finds the index of the first occurrence of element x in a sorted array arr.\n    Returns -1 if the element is not found.\"\"\"\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == x:\n            if mid == 0 or arr[mid - 1] < x:\n                return mid\n            else:\n                high = mid - 1\n        elif arr[mid] < x:\n            low = mid + 1\n        else: # arr[mid] > x\n            high = mid - 1\n    return -1\ndef find_last_occurrence(arr: list, low: int, high: int, x: int) -> int:\n    \"\"\"Finds the index of the last occurrence of element x in a sorted array arr.\n    Returns -1 if the element is not found.\"\"\"\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == x:\n            if mid == len(arr) - 1 or arr[mid + 1] > x:\n                return mid\n            else:\n                low = mid + 1\n        elif arr[mid] < x:\n            low = mid + 1\n        else: # arr[mid] > x\n            high = mid - 1\n    return -1\ndef is_majority(arr: list, n: int, x: int) -> bool:\n    \"\"\"Checks if an element x is a majority element in a sorted array arr of length n.\n    A majority element occurs more than n/2 times.\"\"\"\n    first_occurrence = find_first_occurrence(arr, 0, n - 1, x)\n    if first_occurrence == -1:\n        return False\n\n    last_occurrence = find_last_occurrence(arr, 0, n - 1, x)\n\n    count = last_occurrence - first_occurrence + 1\n    return count > n / 2"}
{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(number: int) -> int:\n    \"\"\"Counts set bits in an integer using Brian Kernighan's algorithm.\n    It repeatedly clears the least significant set bit until the number becomes zero.\"\"\"\n    count = 0\n    while number > 0:\n        number &= (number - 1)\n        count += 1\n    return count"}
{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(number: int) -> int:\n    \"\"\"\n    Counts the number of set bits (1s) in the binary representation of an integer.\n    It uses Brian Kernighan's algorithm, suitable for non-negative integers.\n    \"\"\"\n    count = 0\n    while number > 0:\n        number &= (number - 1)  # Clear the least significant set bit\n        count += 1\n    return count"}
