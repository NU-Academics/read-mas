{"task_id": "Mbpp/7", "solution": "def find_char_long(input_string):\n    \"\"\"\n    Finds all words in a string that are at least 4 characters long.\n    Splits the string by whitespace and returns a set of unique matching words.\n    \"\"\"\n    words = input_string.split()\n    long_words = {word for word in words if len(word) >= 4}\n    return long_words"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(a: int, b: int) -> bool:\n    \"\"\"\n    Determine whether two integers differ by exactly one bit.\n    This is true if their XOR result is a power of two.\n    \"\"\"\n    xor = a ^ b\n    return xor != 0 and (xor & (xor - 1)) == 0"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(text: str, char: str) -> str:\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    Returns a new string with the occurrences removed.\n    \"\"\"\n    first_idx = text.find(char)\n    last_idx = text.rfind(char)\n\n    if first_idx == -1:\n        # If the character is not found, return the original string.\n        return text\n    elif first_idx == last_idx:\n        # If the character is found only once, remove that single occurrence.\n        return text[:first_idx] + text[first_idx + 1:]\n    else:\n        # If the character is found multiple times, remove the first and last occurrences.\n        return text[:first_idx] + text[first_idx + 1:last_idx] + text[last_idx + 1:]"}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(number: int) -> bool:\n    \"\"\"\n    Identifies if a given integer is a non-prime number.\n    Returns True for non-prime numbers and False for prime numbers.\n    \"\"\"\n    if number <= 1:\n        return True  # Numbers less than or equal to 1 are not prime.\n    if number == 2:\n        return False # 2 is prime, so it's not non-prime.\n    if number % 2 == 0:\n        return True  # All other even numbers are not prime.\n\n    # Check for odd divisors from 3 up to the square root of the number.\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return True # Found an odd divisor, so it's not prime.\n        i += 2\n    \n    return False # No divisors found, the number is prime."}
{"task_id": "Mbpp/8", "solution": "def square_nums(numbers):\n    \"\"\"\n    Returns a list containing the squares of each element in the input list.\n    \"\"\"\n    return [n * n for n in numbers]"}
{"task_id": "Mbpp/4", "solution": "import heapq\n\ndef heap_queue_largest(numbers: list[int], n: int) -> list[int]:\n    \"\"\"\n    Finds the n largest integers from a list and returns them in descending order.\n    \"\"\"\n    if n == 0:\n        return []\n    \n    # Use heapq.nlargest to efficiently find the n largest elements\n    largest_elements = heapq.nlargest(n, numbers)\n    \n    # Sort these n elements in descending order\n    return sorted(largest_elements, reverse=True)"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(iterable1, iterable2):\n    \"\"\"\n    Finds unique elements common to both input iterables.\n    Returns a list of these shared elements.\n    \"\"\"\n    set1 = set(iterable1)\n    result = []\n    seen_in_result = set()\n    for element in iterable2:\n        if element in set1 and element not in seen_in_result:\n            result.append(element)\n            seen_in_result.add(element)\n    return result"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(input: str) -> int:\n    \"\"\"Return the minimal rotation count for *input*.\n\n    Raises ValueError if *input* is not a string.\n    \"\"\"\n    if not isinstance(input, str):\n        raise ValueError(\"Input must be a string\")\n\n    n = len(input)\n    if n == 0:\n        return 0\n\n    doubled = input + input\n    for k in range(1, n + 1):\n        if doubled[k:k + n] == input:\n            return k\n    return n"}
