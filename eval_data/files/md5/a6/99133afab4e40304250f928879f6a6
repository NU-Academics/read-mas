{"task_id": "Mbpp/589", "solution": "import math\nfrom typing import List\n\ndef perfect_squares(start: int, end: int) -> List[int]:\n    \"\"\"\n    Finds perfect squares within an inclusive integer range.\n    Returns an empty list if no perfect squares are found or the range is invalid.\n    \"\"\"\n    squares = []\n    # Determine the smallest integer 'a' such that a\u00b2 >= start\n    # Ensure start is non-negative for sqrt\n    first_base = math.ceil(math.sqrt(max(0, start)))\n    \n    # Determine the largest integer 'b' such that b\u00b2 <= end\n    # Ensure end is non-negative for sqrt, if end is negative, floor will be negative\n    last_base = math.floor(math.sqrt(max(0, end)))\n\n    # Iterate from first_base to last_base (inclusive) and add squares to the list.\n    for i in range(first_base, last_base + 1):\n        square = i * i\n        # Only add if the square is within the requested range (redundant due to base calculation, but harmless)\n        if start <= square <= end:\n            squares.append(square)\n            \n    return squares"}
{"task_id": "Mbpp/590", "solution": "import math\n\ndef polar_rect(r: float, theta: float) -> tuple[tuple[float, float], complex]:\n    \"\"\"\n    Convert polar coordinates (r, theta) to rectangular coordinates.\n    Returns the original polar coordinates and their complex representation.\n    \"\"\"\n    x = r * math.cos(theta)\n    y = r * math.sin(theta)\n    rect_complex = complex(x, y)\n    return ((r, theta), rect_complex)"}
{"task_id": "Mbpp/591", "solution": "from typing import List, Any\n\ndef swap_List(lst: List[Any]) -> List[Any]:\n    \"\"\"Return a new list with first and last elements swapped.\n\n    If the list has fewer than two elements, the original list is returned unchanged.\n    \"\"\"\n    if len(lst) < 2:\n        return lst.copy()\n    new_lst = lst.copy()\n    new_lst[0], new_lst[-1] = new_lst[-1], new_lst[0]\n    return new_lst"}
{"task_id": "Mbpp/592", "solution": "def sum_Of_product(n: int) -> int:\n    # Precompute factorials up to n.\n    # factorials[i] will store i!.\n    factorials = [1] * (n + 1)\n    for i in range(1, n + 1):\n        factorials[i] = factorials[i-1] * i\n\n    def binomial_coefficient(n_val, k_val):\n        # Calculates C(n_val, k_val) using precomputed factorials.\n        if k_val < 0 or k_val > n_val:\n            return 0\n        return factorials[n_val] // (factorials[k_val] * factorials[n_val - k_val])\n\n    total_sum = 0\n    # Iterate k from 0 to n-1 and sum the products of consecutive coefficients.\n    for k in range(n):\n        coeff1 = binomial_coefficient(n, k)\n        coeff2 = binomial_coefficient(n, k + 1)\n        total_sum += coeff1 * coeff2\n    return total_sum"}
{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip_address: str) -> str:\n    \"\"\"\n    Removes leading zeroes from each octet of an IPv4 address string.\n    Assumes valid IPv4 format for processing.\n    \"\"\"\n    octets = ip_address.split('.')\n    cleaned_octets = [str(int(octet)) for octet in octets]\n    return '.'.join(cleaned_octets)"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers: list) -> int:\n    \"\"\"\n    Finds the difference of the first even and first odd number in a given list.\n    Raises ValueError if either an even or an odd number is not found.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is None:\n        raise ValueError(\"Missing even number\")\n    if first_odd is None:\n        raise ValueError(\"Missing odd number\")\n\n    return first_even - first_odd"}
