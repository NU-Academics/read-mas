{"task_id": "Mbpp/607", "solution": "import re\n\ndef find_literals(text: str, pattern: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Searches a string for the first occurrence of a regex pattern.\n    Returns the matching substring, a start index, and an end index, or None if no match is found.\n    \"\"\"\n    match = re.search(pattern, text)\n    if match:\n        return (match.group(0), match.start(), match.end())\n    return None"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"\n    Computes the nth Bell number using dynamic programming (Bell triangle).\n    Assumes n is a non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Initialize the Bell triangle\n    bell = [[0 for _ in range(n + 1)] for _ in range(n + 1)]\n\n    # The first element of the first row is 1\n    bell[0][0] = 1\n\n    # Fill the Bell triangle\n    for i in range(1, n + 1):\n        # The first element of each row is the last element of the previous row\n        bell[i][0] = bell[i - 1][i - 1]\n        # Fill the rest of the row\n        for j in range(1, i + 1):\n            bell[i][j] = bell[i - 1][j - 1] + bell[i][j - 1]\n\n    # The nth Bell number is the first element of the nth row (bell[n][0])\n    return bell[n][0]"}
{"task_id": "Mbpp/610", "solution": "from typing import List, Any\n\ndef remove_kth_element(lst: List[Any], k: int) -> List[Any]:\n    \"\"\"\n    Return a new list with the element at index k removed.\n    Raises IndexError if k is out of bounds.\n    \"\"\"\n    if k < 0 or k >= len(lst):\n        raise IndexError(\"Index out of bounds\")\n    return lst[:k] + lst[k+1:]"}
{"task_id": "Mbpp/611", "solution": "from typing import List\n\nclass Column:\n    \"\"\"Represents a column of values from a matrix.\"\"\"\n    def __init__(self, values: List[int], index: int):\n        self.values = values\n        self.index = index\n\n    def max_value(self) -> int:\n        \"\"\"Returns the maximum value in the column.\"\"\"\n        return max(self.values)\n\nclass Matrix:\n    \"\"\"Represents a matrix as a list of lists and provides column access.\"\"\"\n    def __init__(self, data: List[List[int]]):\n        if not isinstance(data, list) or not data or not all(isinstance(row, list) for row in data):\n            raise ValueError(\"Matrix must be a non-empty list of lists.\")\n        \n        if not data[0]: # Covers cases like [[]]\n             raise ValueError(\"Matrix must be a non-empty list of lists.\")\n\n        num_cols = len(data[0])\n        \n        for row in data:\n            if not isinstance(row, list) or len(row) != num_cols:\n                raise ValueError(\"All rows must have the same number of columns.\")\n\n        self.data = data\n        self.num_rows = len(data)\n        self.num_cols = num_cols\n\n    def get_max_column(self, n: int) -> int:\n        \"\"\"\n        Extracts the nth column and returns its maximum value.\n        Raises ValueError if column index n is out of bounds.\n        \"\"\"\n        if not (0 <= n < self.num_cols):\n            raise ValueError(f\"Column index n out of bounds for matrix with {self.num_cols} columns.\")\n\n        column_values = [row[n] for row in self.data]\n        column_obj = Column(column_values, n)\n        return column_obj.max_value()\n\ndef max_of_nth(matrix: List[List[int]], n: int) -> int:\n    \"\"\"\n    Returns the maximum value of the n'th column in the given matrix.\n    Raises ValueError for invalid matrix or column index.\n    \"\"\"\n    matrix_obj = Matrix(matrix)\n    return matrix_obj.get_max_column(n)"}
{"task_id": "Mbpp/612", "solution": "from typing import List, Any\n\ndef merge(input_list: List[List[Any]]) -> List[List[Any]]:\n    \"\"\"\n    Merges a list of two-element sublists into two separate lists, collecting all first elements into one list and all second elements into another.\n    This function assumes valid input where each sublist has exactly two elements.\n    \"\"\"\n    first_elements: List[Any] = []\n    second_elements: List[Any] = []\n\n    for sublist in input_list:\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n\n    return [first_elements, second_elements]"}
