{"task_id": "Mbpp/239", "solution": "import functools\n\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the number of sequences of length n, such that each element is a positive integer\n    and is greater than or equal to twice the previous element but less than or equal to m.\n    \"\"\"\n\n    @functools.lru_cache(None)\n    def count_recursive(current_len: int, prev_val: int) -> int:\n        # Base case: If the sequence has reached the desired length n,\n        # we have found one valid sequence.\n        if current_len == n:\n            return 1\n\n        total_sequences_from_this_state = 0\n        # The next element must be at least twice the previous element (start_next_val)\n        # and not exceed m.\n        start_next_val = 2 * prev_val\n\n        for next_val in range(start_next_val, m + 1):\n            # Recursively count sequences by appending the next_val\n            total_sequences_from_this_state += count_recursive(current_len + 1, next_val)\n\n        return total_sequences_from_this_state\n\n    # The first element of any sequence can be any positive integer from 1 to m.\n    total_count = 0\n    for first_element in range(1, m + 1):\n        total_count += count_recursive(1, first_element)\n\n    return total_count"}
{"task_id": "Mbpp/237", "solution": "def check_occurences(list_of_tuples):\n    \"\"\"\n    Counts the occurrences of unique tuples in a list, treating tuples with\n    the same elements but different order as identical by canonicalizing them.\n    \"\"\"\n    counts = {}\n    for tpl in list_of_tuples:\n        # Canonicalize the tuple by sorting its elements to treat (a, b) and (b, a) as the same.\n        canonical_tpl = tuple(sorted(tpl))\n        counts[canonical_tpl] = counts.get(canonical_tpl, 0) + 1\n    return counts"}
