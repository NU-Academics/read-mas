{"task_id": "Mbpp/260", "solution": "class ArgumentError(ValueError):\n    \"\"\"Custom exception for invalid function arguments.\"\"\"\n    pass\n\ndef _nsw_sequence(limit):\n    \"\"\"Generates numbers from the Newman-Shanks-Williams-like sequence up to a limit.\n    Uses the recurrence X_n = X_{n-1} + X_{n-2} + 2 as defined in the design.\"\"\"\n    a, b = 1, 1\n    for _ in range(limit):\n        yield a\n        a, b = b, a + b + 2\n\ndef _is_prime(num):\n    \"\"\"Checks if a number is prime.\n    Implements a basic primality test.\"\"\"\n    if num < 2:\n        return False\n    if num % 2 == 0:\n        return num == 2\n    i = 3\n    while i * i <= num:\n        if num % i == 0:\n            return False\n        i += 2\n    return True\n\nclass PrimeNumber:\n    \"\"\"A simple class to hold a prime number value.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\nclass NewmanShanksWilliamsPrimeCalculator:\n    \"\"\"Calculates Newman-Shanks-Williams prime numbers based on the specified recurrence.\"\"\"\n    def newman_prime(self, n):\n        \"\"\"Finds the nth prime number from the generated sequence.\"\"\"\n        count = 0\n        # Overshoot limit as specified in the design for computing NSW sequence\n        for val in _nsw_sequence(n * 10):\n            if _is_prime(val):\n                count += 1\n                if count == n:\n                    return PrimeNumber(val)\n        # If the nth prime is not found within the generated sequence limit.\n        raise ValueError(f\"Could not find the {n}th prime within the generated sequence limit.\")\n\ndef newman_prime(n: int) -> int:\n    \"\"\"Finds the nth Newman-Shanks-Williams prime number.\n    Raises ArgumentError if n is not a positive integer.\"\"\"\n    if n < 1:\n        raise ArgumentError(\"n must be a positive integer\")\n\n    calc = NewmanShanksWilliamsPrimeCalculator()\n    prime_obj = calc.newman_prime(n)\n    return prime_obj.value"}
