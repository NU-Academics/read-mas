{"task_id": "Mbpp/409", "solution": "import math\nfrom dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass Tuple:\n    \"\"\"Represents a pair of integers for product calculation.\"\"\"\n    first: int\n    second: int\n\n    @property\n    def product(self) -> int:\n        \"\"\"Returns the product of the two integers in the tuple.\"\"\"\n        return self.first * self.second\n\nclass TupleList:\n    \"\"\"Manages a collection of Tuple objects.\"\"\"\n    def __init__(self, raw_tuples: List[tuple[int, int]]):\n        \"\"\"Initializes with a list of raw integer tuples.\"\"\"\n        self.tuples: List[Tuple] = [Tuple(t[0], t[1]) for t in raw_tuples]\n\nclass ProductCalculator:\n    \"\"\"Calculates the minimum product from a list of Tuple objects.\"\"\"\n    def calculateMinProduct(self, tuple_list: TupleList) -> int:\n        \"\"\"Finds the minimum product of elements within tuples in the given list.\"\"\"\n        min_prod = math.inf\n        for t_obj in tuple_list.tuples:\n            min_prod = min(min_prod, t_obj.product)\n        return int(min_prod)\n\ndef min_product_tuple(tuples: list[tuple[int, int]]) -> int:\n    \"\"\"\n    Finds the minimum product from the pairs of elements within tuples in a given list.\n    \"\"\"\n    tuple_list_obj = TupleList(tuples)\n    calculator = ProductCalculator()\n    return calculator.calculateMinProduct(tuple_list_obj)"}
{"task_id": "Mbpp/410", "solution": "from typing import Any, Iterable, Union\n\ndef min_val(lst: Iterable[Any]) -> Union[int, float]:\n    \"\"\"\n    Find the minimum numeric value in a given heterogeneous list.\n    Non-numeric items are ignored.\n    \"\"\"\n    min_value = None\n    for item in lst:\n        if isinstance(item, (int, float)):\n            if min_value is None or item < min_value:\n                min_value = item\n    if min_value is None:\n        raise ValueError(\"No numeric elements found in the input iterable.\")\n    return min_value"}
{"task_id": "Mbpp/413", "solution": "from typing import List, Tuple, Any\n\ndef extract_nth_element(tuples: List[Tuple[Any, ...]], n: int) -> List[Any]:\n    \"\"\"\n    Extract the nth element from each tuple in a list.\n    Raises IndexError if n is out of bounds for any tuple.\n    \"\"\"\n    result = []\n    for t in tuples:\n        if n < 0 or n >= len(t):\n            raise IndexError(f\"Index {n} out of bounds for tuple {t}\")\n        result.append(t[n])\n    return result"}
