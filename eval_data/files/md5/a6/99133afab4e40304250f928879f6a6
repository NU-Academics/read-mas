{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(t: tuple) -> dict:\n    \"\"\"Convert a tuple to a key-value dictionary using adjacent elements.\"\"\"\n    if len(t) % 2 != 0:\n        raise ValueError(\"Tuple length must be even.\")\n\n    result = {}\n    for i in range(0, len(t), 2):\n        result[t[i]] = t[i + 1]\n    return result"}
{"task_id": "Mbpp/739", "solution": "import math\n\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with at least n digits.\n    Uses an iterative approach, calculating triangular numbers and their digit counts.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n\n    k = 0\n    num_digits = 0\n    \n    # Calculate initial k if n is large to speed up.\n    # T_k approx k^2 / 2. log10(T_k) approx 2 * log10(k) - log10(2).\n    # num_digits approx 2 * log10(k). So log10(k) approx num_digits / 2.\n    # k approx 10^(num_digits / 2).\n    if n > 1:\n        # A rough estimate to start k closer to the target\n        k_estimate = int(math.sqrt(2 * (10**(n - 1)))) - 10 # Subtract a bit for safety\n        k = max(1, k_estimate)\n\n    while num_digits < n:\n        k += 1\n        triangular_number = k * (k + 1) // 2\n        if triangular_number == 0: # Should not happen for k > 0, but as a safeguard\n            num_digits = 1\n        else:\n            num_digits = int(math.log10(triangular_number)) + 1\n    return k"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(s):\n    \"\"\"\n    Checks if all characters in a string are the same.\n    Returns True for empty or single-character strings.\n    \"\"\"\n    if not s or len(s) == 1:\n        return True\n    \n    first_char = s[0]\n    for char in s:\n        if char != first_char:\n            return False\n            \n    return True"}
