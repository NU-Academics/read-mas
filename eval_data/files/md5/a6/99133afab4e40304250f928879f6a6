{"task_id": "Mbpp/615", "solution": "class AverageCalculator:\n    def calculate(self, tuple_of_tuples: tuple) -> list:\n        if not tuple_of_tuples:\n            return []\n\n        # Determine number of columns from the first inner tuple.\n        # Assuming all inner tuples have the same length.\n        num_columns = len(tuple_of_tuples[0])\n        num_rows = len(tuple_of_tuples)\n        \n        averages = []\n        for col_idx in range(num_columns):\n            column_sum = 0\n            for row_idx in range(num_rows):\n                column_sum += tuple_of_tuples[row_idx][col_idx]\n            \n            averages.append(column_sum / num_rows)\n            \n        return averages\n\ndef average_tuple(tuple_of_tuples: tuple) -> list:\n    \"\"\"\n    Calculates the average value for each column (position) across all inner tuples.\n    \"\"\"\n    calculator = AverageCalculator()\n    return calculator.calculate(tuple_of_tuples)"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise modulo on two tuples of the same length.\n    Raises ValueError if tuples have different lengths.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n    return tuple(a % b for a, b in zip(tuple1, tuple2))"}
