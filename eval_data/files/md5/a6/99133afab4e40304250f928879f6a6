{"task_id": "Mbpp/256", "solution": "def _is_prime(n: int) -> bool:\n    \"\"\"Return True if n is a prime number, False otherwise.\"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef count_Primes_nums(n: int) -> int:\n    \"\"\"\n    Count the number of prime numbers strictly less than n.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input must be non\u2011negative.\")\n    if n <= 2:\n        return 0\n\n    count = 0\n    for k in range(2, n):\n        if _is_prime(k):\n            count += 1\n    return count"}
