{"task_id": "Mbpp/558", "solution": "class Integer:\n    \"\"\"\n    Represents an integer and provides methods to extract its digits.\n    Stores the absolute value of the input integer.\n    \"\"\"\n    def __init__(self, value: int):\n        self._value = abs(value)\n\n    def get_digits(self) -> list[int]:\n        \"\"\"\n        Returns a list of digits in reverse order (least-significant first).\n        \"\"\"\n        if self._value == 0:\n            return [0]\n        \n        digits = []\n        temp_val = self._value\n        while temp_val > 0:\n            digits.append(temp_val % 10)\n            temp_val //= 10\n        return digits\n\nclass DigitDistanceCalculator:\n    \"\"\"\n    Calculates the sum of per-digit differences between two numbers.\n    \"\"\"\n    def _calculate_digit_distance(self, a_val: int, b_val: int) -> int:\n        \"\"\"\n        Computes the sum of per-digit absolute differences between two integers.\n        \"\"\"\n        integer_a = Integer(a_val)\n        integer_b = Integer(b_val)\n\n        digits_a = integer_a.get_digits()\n        digits_b = integer_b.get_digits()\n\n        max_len = max(len(digits_a), len(digits_b))\n        total_diff = 0\n\n        for i in range(max_len):\n            digit_a = digits_a[i] if i < len(digits_a) else 0\n            digit_b = digits_b[i] if i < len(digits_b) else 0\n            total_diff += abs(digit_a - digit_b)\n        \n        return total_diff\n\ndef digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"\n    Finds the sum of the per-digit difference between two integers.\n    \"\"\"\n    calculator = DigitDistanceCalculator()\n    return calculator._calculate_digit_distance(a, b)"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr: list[int], length: int) -> int:\n    \"\"\"Finds the maximum sum of a contiguous sublist using Kadane's algorithm.\n    Handles empty lists and lists with all negative numbers correctly.\n    \"\"\"\n    if length == 0:\n        return 0\n\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, length):\n        num = arr[i]\n        current_max = max(num, current_max + num)\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/560", "solution": "from typing import Tuple\n\ndef union_elements(t1: Tuple[int, ...], t2: Tuple[int, ...]) -> Tuple[int, ...]:\n    \"\"\"\n    Return the sorted union of two integer tuples.\n    \"\"\"\n    unique_elements = set(t1) | set(t2)\n    return tuple(sorted(unique_elements))"}
