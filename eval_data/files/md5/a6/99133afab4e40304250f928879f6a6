{"task_id": "Mbpp/799", "solution": "def left_rotate(number: int, d: int) -> int:\n    \"\"\"\n    Rotates the bits of a 32-bit number to the left by d positions.\n    \"\"\"\n    # Normalize d to be within the range [0, 31] for 32-bit rotation\n    d_normalized = d % 32\n\n    # Perform the left rotation using bitwise operations\n    # The left shifted part and the right shifted (wrapped around) part are combined\n    rotated_val = (number << d_normalized) | (number >> (32 - d_normalized))\n\n    # Mask the result to ensure it remains a 32-bit unsigned integer\n    # (0xFFFFFFFF is 2^32 - 1)\n    return rotated_val & 0xFFFFFFFF"}
{"task_id": "Mbpp/803", "solution": "import math\n\ndef is_perfect_square(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is a perfect square.\n    Returns true if the number is a perfect square, false otherwise.\n    \"\"\"\n    if number < 0:\n        return False\n    \n    sqrt_num = math.sqrt(number)\n    return sqrt_num == int(sqrt_num)"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"\n    Count how many of the three input integers are equal.\n    Returns 3 if all equal, 2 if exactly two equal, 0 if all distinct.\n    \"\"\"\n    if a == b and b == c:\n        return 3\n    if a == b or a == c or b == c:\n        return 2\n    return 0"}
{"task_id": "Mbpp/804", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass NumberList:\n    \"\"\"A domain entity representing a list of numbers.\"\"\"\n    numbers: List[int]\n\nclass ProductCalculator:\n    \"\"\"Provides methods for calculating properties of number products.\"\"\"\n\n    def is_product_even(self, number_list: NumberList) -> bool:\n        \"\"\"\n        Determines if the product of numbers in the NumberList is even.\n        An empty list product is considered even as per requirements.\n        \"\"\"\n        if not number_list.numbers:\n            return True # As per FR1, AC 3: is_product_even([]) returns True\n\n        for number in number_list.numbers:\n            if number % 2 == 0:\n                return True # Rule1: product is even if any number is even\n        return False # If no even numbers, product is odd\n\ndef is_product_even(numbers: List[int]) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    Returns True if the product is even, False otherwise.\n    \"\"\"\n    number_list_entity = NumberList(numbers=numbers)\n    calculator = ProductCalculator()\n    return calculator.is_product_even(number_list_entity)"}
{"task_id": "Mbpp/805", "solution": "from typing import List\n\ndef max_sum_list(list_of_lists: List[List[int]]) -> List[int]:\n    \"\"\"\n    Returns the sub-list with the highest sum of elements from a list of lists.\n    Assumes the input list_of_lists is not empty.\n    \"\"\"\n    max_sublist = list_of_lists[0]\n    max_sum_val = sum(max_sublist)\n\n    for sublist in list_of_lists[1:]:\n        current_sum = sum(sublist)\n        if current_sum > max_sum_val:\n            max_sum_val = current_sum\n            max_sublist = sublist\n\n    return max_sublist"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Finds the maximum consecutive run of uppercase characters in the given string.\n    The function processes the string in a single pass to find the longest sequence.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in input_string:\n        if 'A' <= char <= 'Z':  # Check for ASCII uppercase letters (A-Z)\n            current_run += 1\n        else:\n            current_run = 0\n        max_run = max(max_run, current_run)\n    return max_run"}
