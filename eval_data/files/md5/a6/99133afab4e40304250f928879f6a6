{"task_id": "Mbpp/96", "solution": "class DivisorCalculator:\n    def divisor(self, n: int) -> int:\n        \"\"\"Calculates the number of positive divisors for a given integer.\"\"\"\n        if n == 0:\n            return 0\n        \n        abs_n = abs(n)\n        if abs_n == 1:\n            return 1\n\n        count = 0\n        i = 1\n        while i * i <= abs_n:\n            if abs_n % i == 0:\n                if i * i == abs_n:\n                    count += 1\n                else:\n                    count += 2\n            i += 1\n        return count\n\ndef divisor(n: int) -> int:\n    \"\"\"Finds the number of divisors of a given integer using DivisorCalculator.\"\"\"\n    calculator = DivisorCalculator()\n    return calculator.divisor(n)"}
