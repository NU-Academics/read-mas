{"task_id": "Mbpp/619", "solution": "def move_num(s):\n    \"\"\"\n    Moves all numeric characters to the end of the given string, preserving relative order.\n    \"\"\"\n    non_numeric_chars = []\n    numeric_chars = []\n\n    for char in s:\n        if char.isdigit():\n            numeric_chars.append(char)\n        else:\n            non_numeric_chars.append(char)\n\n    return \"\".join(non_numeric_chars) + \"\".join(numeric_chars)"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(nums: list[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of `nums` where every pair (a, b)\n    satisfies a divides b or b divides a.\n    \"\"\"\n    if not nums:\n        return 0\n\n    nums.sort()\n    n = len(nums)\n    dp = [1] * n  # dp[i] stores the length of the largest divisible subset ending with nums[i]\n\n    for i in range(n):\n        for j in range(i):\n            if nums[i] % nums[j] == 0:\n                dp[i] = max(dp[i], dp[j] + 1)\n\n    return max(dp)"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1: list[int], list2: list[int], n: int) -> float:\n    \"\"\"\n    Finds the median of two sorted lists of the same size n.\n    This implementation uses a linear time (O(n)) approach by merging conceptually.\n    \"\"\"\n    i = 0\n    j = 0\n    m1 = -1  # Stores the element at index n-1 of the conceptually merged list\n    m2 = -1  # Stores the element at index n of the conceptually merged list\n\n    # Iterate n+1 times to find the (n-1)-th and n-th elements\n    for count in range(n + 1):\n        # If list1 is exhausted or current element in list2 is smaller\n        if i == n:\n            m1 = m2\n            m2 = list2[j]\n            j += 1\n        # If list2 is exhausted or current element in list1 is smaller\n        elif j == n:\n            m1 = m2\n            m2 = list1[i]\n            i += 1\n        elif list1[i] < list2[j]:\n            m1 = m2\n            m2 = list1[i]\n            i += 1\n        else: # list2[j] <= list1[i]\n            m1 = m2\n            m2 = list2[j]\n            j += 1\n            \n    # The median is the average of the two middle elements\n    return (m1 + m2) / 2.0"}
