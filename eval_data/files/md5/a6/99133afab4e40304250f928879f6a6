{"task_id": "Mbpp/778", "solution": "from typing import List, Any\n\ndef pack_consecutive_duplicates(input_list: List[Any]) -> List[List[Any]]:\n    \"\"\"\n    Packs consecutive duplicate elements of a list into sublists.\n    This function processes the input list in a single pass.\n    \"\"\"\n    output = []\n    current_sublist = []\n\n    for element in input_list:\n        if not current_sublist or element == current_sublist[-1]:\n            current_sublist.append(element)\n        else:\n            output.append(current_sublist)\n            current_sublist = [element]\n\n    if current_sublist:\n        output.append(current_sublist)\n\n    return output"}
{"task_id": "Mbpp/780", "solution": "from typing import List, Tuple\n\ndef find_combinations(tuples: List[Tuple[int, int]]) -> List[Tuple[int, int]]:\n    \"\"\"\n    Computes all pairwise sums of tuples in the given list.\n    The sums are ordered based on the indices of the combined input tuples.\n    \"\"\"\n    result = []\n    n = len(tuples)\n    for i in range(n):\n        for j in range(i + 1, n):\n            # Sum the corresponding elements of the two tuples\n            sum_tuple = (tuples[i][0] + tuples[j][0], tuples[i][1] + tuples[j][1])\n            result.append(sum_tuple)\n    return result"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks if the total count of divisors for a given integer n is even.\n    This function counts divisors by iterating up to the square root of n.\n    \"\"\"\n    divisor_count = 0\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            if i * i == n:\n                divisor_count += 1\n            else:\n                divisor_count += 2\n        i += 1\n    return divisor_count % 2 == 0"}
{"task_id": "Mbpp/782", "solution": "from typing import List\n\ndef odd_length_sum(list_of_ints: List[int]) -> int:\n    \"\"\"\n    Calculates the sum of all odd-length subarrays in the given list of integers.\n    The function operates in O(n^2) time complexity and O(1) additional space.\n    \"\"\"\n    total_sum = 0\n    n = len(list_of_ints)\n\n    for i in range(n):  # Start index of the subarray\n        current_subarray_sum = 0\n        for j in range(i, n):  # End index of the subarray\n            current_subarray_sum += list_of_ints[j]\n            # Check if the length of the current subarray is odd\n            if (j - i + 1) % 2 == 1:\n                total_sum += current_subarray_sum\n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "from typing import List\n\nclass NumberList:\n    \"\"\"\n    A domain entity to encapsulate operations on a list of numbers\n    for finding first even and odd elements.\n    \"\"\"\n    def __init__(self, numbers: List[int]):\n        self._numbers = numbers\n\n    def getFirstEven(self) -> int:\n        \"\"\"Finds the first even number in the list.\"\"\"\n        for num in self._numbers:\n            if num % 2 == 0:\n                return num\n        raise ValueError(\"No even number found in the list.\")\n\n    def getFirstOdd(self) -> int:\n        \"\"\"Finds the first odd number in the list.\"\"\"\n        for num in self._numbers:\n            if num % 2 != 0:\n                return num\n        raise ValueError(\"No odd number found in the list.\")\n\n    def multiplyFirstEvenAndOdd(self) -> int:\n        \"\"\"Calculates the product of the first even and first odd numbers.\"\"\"\n        first_even = self.getFirstEven()\n        first_odd = self.getFirstOdd()\n        return first_even * first_odd\n\ndef mul_even_odd(numbers: List[int]) -> int:\n    \"\"\"\n    Finds the product of the first even and first odd number of a given list.\n    \"\"\"\n    number_list_processor = NumberList(numbers)\n    return number_list_processor.multiplyFirstEvenAndOdd()"}
{"task_id": "Mbpp/785", "solution": "import ast\n\ndef tuple_str_int(s: str) -> tuple[int, ...]:\n    \"\"\"\n    Converts a string representation of a tuple into a tuple of integers.\n    Raises ValueError for malformed inputs or non-integer elements.\n    \"\"\"\n    try:\n        parsed_data = ast.literal_eval(s)\n    except (ValueError, SyntaxError) as e:\n        raise ValueError(f\"Invalid tuple string format: {s}\") from e\n\n    if not isinstance(parsed_data, tuple):\n        raise ValueError(f\"Input string does not represent a tuple: {s}\")\n\n    for item in parsed_data:\n        if not isinstance(item, int):\n            raise ValueError(f\"Tuple contains non-integer elements: {s}\")\n\n    return parsed_data"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(lst: list[int], target: int) -> int:\n    \"\"\"\n    Locates the right insertion point for a specified value in sorted order.\n    Uses binary search to find the index where the target should be inserted\n    to maintain ascending order, immediately after any existing equal elements.\n    \"\"\"\n    low = 0\n    high = len(lst)\n\n    while low < high:\n        mid = (low + high) // 2\n        if lst[mid] <= target:\n            # If element at mid is less than or equal to target,\n            # target must be inserted at or after mid + 1.\n            low = mid + 1\n        else:\n            # If element at mid is greater than target,\n            # mid could be the insertion point, or it's to the left.\n            high = mid\n    return low"}
