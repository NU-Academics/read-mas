{"task_id": "Mbpp/751", "solution": "import math\n\nclass HeapChecker:\n    \"\"\"Encapsulates the logic for checking if an array represents a min-heap.\"\"\"\n    def is_min_heap(self, arr: list[int]) -> bool:\n        n = len(arr)\n        if n == 0:\n            return True\n\n        # Iterate only up to the last non-leaf node\n        # For a 0-indexed array, children of node i are at 2*i + 1 and 2*i + 2.\n        # The last non-leaf node is at index (n // 2) - 1.\n        for i in range(n // 2):\n            left_child_idx = 2 * i + 1\n            right_child_idx = 2 * i + 2\n\n            # Check left child\n            if arr[i] > arr[left_child_idx]:\n                return False\n\n            # Check right child, if it exists\n            if right_child_idx < n and arr[i] > arr[right_child_idx]:\n                return False\n        return True\n\ndef check_min_heap(arr: list[int]) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    Delegates the validation logic to an internal HeapChecker class.\n    \"\"\"\n    checker = HeapChecker()\n    return checker.is_min_heap(arr)"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth Jacobsthal number using an iterative approach.\n    Handles base cases for n=0 and n=1, and applies the recurrence for n >= 2.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    \n    # Initialize for J(0) and J(1)\n    prev2 = 0  # Represents J(i-2)\n    prev1 = 1  # Represents J(i-1)\n    \n    for _ in range(2, n + 1):\n        current = prev1 + 2 * prev2\n        prev2 = prev1\n        prev1 = current\n        \n    return prev1"}
{"task_id": "Mbpp/753", "solution": "from typing import List, Tuple\n\ndef min_k(tuples: List[Tuple[str, int]], k: int) -> List[Tuple[str, int]]:\n    \"\"\"\n    Return the k tuples with the smallest second element, sorted ascending.\n    Returns a list of k tuples sorted by the integer component.\n    \"\"\"\n    sorted_tuples = sorted(tuples, key=lambda x: x[1])\n    return sorted_tuples[:k]"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds elements that appear in all three lists under the same index.\n    \"\"\"\n    common_elements = []\n    min_length = min(len(l1), len(l2), len(l3))\n\n    for i in range(min_length):\n        if l1[i] == l2[i] == l3[i]:\n            common_elements.append(l1[i])\n            \n    return common_elements"}
