{"task_id": "Mbpp/245", "solution": "from typing import List\nfrom dataclasses import dataclass\n\n@dataclass\nclass Element:\n    \"\"\"Represents a single integer element in the array.\"\"\"\n    value: int\n    index: int\n\n@dataclass\nclass Array:\n    \"\"\"Container for the input integer array.\"\"\"\n    elements: List[Element]\n\n    @classmethod\n    def from_list(cls, values: List[int]) -> \"Array\":\n        return cls(elements=[Element(v, i) for i, v in enumerate(values)])\n\nclass SumCalculator:\n    \"\"\"\n    Implements a dynamic programming solution that computes the maximum sum\n    of a bitonic subsequence in O(n^2) time.\n    \"\"\"\n\n    @staticmethod\n    def compute_max_sum(arr: Array) -> int:\n        n = len(arr.elements)\n        if n == 0:\n            return 0\n\n        # dp_inc[i] \u2013 max sum of increasing subsequence ending at i\n        dp_inc = [0] * n\n        # dp_dec[i] \u2013 max sum of decreasing subsequence starting at i\n        dp_dec = [0] * n\n\n        # Compute dp_inc\n        for i in range(n):\n            dp_inc[i] = arr.elements[i].value\n            for j in range(i):\n                if arr.elements[j].value < arr.elements[i].value:\n                    dp_inc[i] = max(dp_inc[i], dp_inc[j] + arr.elements[i].value)\n\n        # Compute dp_dec\n        for i in reversed(range(n)):\n            dp_dec[i] = arr.elements[i].value\n            for j in range(i + 1, n):\n                if arr.elements[j].value < arr.elements[i].value:\n                    dp_dec[i] = max(dp_dec[i], dp_dec[j] + arr.elements[i].value)\n\n        # Combine to find maximum bitonic sum\n        max_overall_sum = 0\n        for i in range(n):\n            # Subtract arr[i] once because it is counted in both dp_inc and dp_dec\n            total = dp_inc[i] + dp_dec[i] - arr.elements[i].value\n            if total > max_overall_sum:\n                max_overall_sum = total\n\n        return max_overall_sum\n\ndef max_sum(values: List[int]) -> int:\n    \"\"\"\n    Compute the maximum sum of a bitonic subsequence in the given array.\n\n    Parameters\n    ----------\n    values : List[int]\n        The input array of integers.\n\n    Returns\n    -------\n    int\n        The maximum sum achievable by any bitonic subsequence.\n    \"\"\"\n    if not values:\n        raise ValueError(\"Input array must contain at least one element.\")\n\n    array = Array.from_list(values)\n    return SumCalculator.compute_max_sum(array)"}
{"task_id": "Mbpp/247", "solution": "def lps(input: str) -> int:\n    \"\"\"\n    Compute the length of the longest palindromic subsequence of `input`.\n    \"\"\"\n    n = len(input)\n    dp = [[0] * n for _ in range(n)]\n\n    # All subsequences of length 1 are palindromes.\n    for i in range(n):\n        dp[i][i] = 1\n\n    # cl is current length of subsequence.\n    for cl in range(2, n + 1):\n        for i in range(n - cl + 1):\n            j = i + cl - 1\n            if input[i] == input[j] and cl == 2:\n                dp[i][j] = 2\n            elif input[i] == input[j]:\n                dp[i][j] = dp[i + 1][j - 1] + 2\n            else:\n                dp[i][j] = max(dp[i][j - 1], dp[i + 1][j])\n\n    return dp[0][n - 1] if n > 0 else 0"}
