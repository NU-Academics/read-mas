{"task_id": "Mbpp/4", "solution": "import heapq\n\ndef heap_queue_largest(list_of_numbers, n):\n    \"\"\"\n    Finds the n largest integers from a list, returned in descending order.\n    Handles edge cases for n being non-positive or greater than list length.\n    \"\"\"\n    if n <= 0 or not list_of_numbers:\n        return []\n\n    if n >= len(list_of_numbers):\n        return sorted(list_of_numbers, reverse=True)\n\n    largest_elements = heapq.nlargest(n, list_of_numbers)\n    return sorted(largest_elements, reverse=True)"}
{"task_id": "Mbpp/8", "solution": "from typing import List\n\ndef square_nums(nums: List[int]) -> List[int]:\n    \"\"\"\n    Return a list containing the squares of each integer in the input list.\n\n    Raises TypeError if `nums` is not a list, and ValueError if elements are not integers.\n    \"\"\"\n    if not isinstance(nums, list):\n        raise TypeError(\"Input must be a list.\")\n    for idx, val in enumerate(nums):\n        if not isinstance(val, int):\n            raise ValueError(f\"Element at index {idx} is not an integer.\")\n    return [x * x for x in nums]"}
