{"task_id": "Mbpp/598", "solution": "def armstrong_number(number: int) -> bool:\n    \"\"\"\n    Checks if a given number is an Armstrong number.\n    An Armstrong number is equal to the sum of its own digits each raised to the power of the number of digits.\n    \"\"\"\n    if not isinstance(number, int) or number < 0:\n        raise TypeError(\"Input must be a non-negative integer.\")\n\n    num_str = str(number)\n    num_digits = len(num_str)\n    sum_of_powers = 0\n    for digit_char in num_str:\n        digit = int(digit_char)\n        sum_of_powers += digit ** num_digits\n    return sum_of_powers == number"}
{"task_id": "Mbpp/597", "solution": "from typing import List\n\ndef _is_sorted(arr: List[int]) -> bool:\n    \"\"\"Checks if an array is sorted in ascending order.\"\"\"\n    return all(arr[i] <= arr[i+1] for i in range(len(arr)-1))\n\ndef _validate_inputs(a1: List[int], a2: List[int], k: int) -> None:\n    \"\"\"Validates input arrays and k for the find_kth function.\"\"\"\n    if not a1 and not a2:\n        raise ValueError(\"Input arrays must not both be empty.\")\n    if not _is_sorted(a1) or not _is_sorted(a2):\n        raise ValueError(\"Both arrays must be sorted in ascending order.\")\n    if k < 1 or k > len(a1) + len(a2):\n        raise ValueError(\"k is out of bounds.\")\n\ndef _kth_element(a1: List[int], a2: List[int], k: int) -> int:\n    \"\"\"\n    Finds the k-th element from two sorted arrays using a binary search approach.\n    Assumes a1 is the shorter array.\n    \"\"\"\n    m, n = len(a1), len(a2)\n    \n    # Ensure a1 is the shorter array for optimized binary search\n    if m > n:\n        return _kth_element(a2, a1, k)\n\n    # Define the search space for partitionX in a1\n    # partitionX can range from max(0, k-n) to min(k, m)\n    # This ensures partitionY (k-partitionX) is also valid (0 <= partitionY <= n)\n    low, high = max(0, k - n), min(k, m)\n\n    while low <= high:\n        partitionX = (low + high) // 2\n        partitionY = k - partitionX\n\n        # Determine the four values needed for comparison\n        # maxLeftX: element just before partitionX in a1\n        # minRightX: element at partitionX in a1\n        # maxLeftY: element just before partitionY in a2\n        # minRightY: element at partitionY in a2\n        maxLeftX = a1[partitionX - 1] if partitionX > 0 else -float('inf')\n        minRightX = a1[partitionX] if partitionX < m else float('inf')\n\n        maxLeftY = a2[partitionY - 1] if partitionY > 0 else -float('inf')\n        minRightY = a2[partitionY] if partitionY < n else float('inf')\n\n        if maxLeftX <= minRightY and maxLeftY <= minRightX:\n            # Found the correct partition\n            return max(maxLeftX, maxLeftY)\n        elif maxLeftX > minRightY:\n            # We are too far right in a1 (maxLeftX is too large),\n            # move the high pointer to the left.\n            high = partitionX - 1\n        else: # maxLeftY > minRightX\n            # We are too far left in a1 (maxLeftY is too large),\n            # move the low pointer to the right.\n            low = partitionX + 1\n    \n    # This point should theoretically not be reached if inputs are valid\n    raise RuntimeError(\"Failed to find kth element; this indicates an unexpected state.\")\n\ndef find_kth(a1: List[int], a2: List[int], k: int) -> int:\n    \"\"\"\n    Finds the k-th element from the given two sorted arrays.\n    \"\"\"\n    _validate_inputs(a1, a2, k)\n    return _kth_element(a1, a2, k)"}
