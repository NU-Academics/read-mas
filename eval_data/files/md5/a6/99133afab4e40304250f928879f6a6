{"task_id": "Mbpp/453", "solution": "def sumofFactors(n: int) -> int:\n    \"\"\"\n    Calculates the sum of all even factors of a given integer n.\n    Factors are generated by iterating up to the square root of n.\n    \"\"\"\n    if n <= 0:\n        return 0\n\n    even_factors = set()\n    for i in range(1, int(n**0.5) + 1):\n        if n % i == 0:\n            factor1 = i\n            factor2 = n // i\n\n            if factor1 % 2 == 0:\n                even_factors.add(factor1)\n            if factor2 % 2 == 0:\n                even_factors.add(factor2)\n    \n    return sum(even_factors)"}
{"task_id": "Mbpp/454", "solution": "import re\n\nclass WordMatcher:\n    \"\"\"\n    Encapsulates the logic for finding words containing 'z'.\n    It extracts alphabetic words and checks for the lowercase 'z'.\n    \"\"\"\n    def match(self, text: str) -> bool:\n        \"\"\"\n        Tokenises the input text into words and checks if any word contains 'z'.\n        The match is case-sensitive for 'z'.\n        \"\"\"\n        words = re.findall(r'[a-zA-Z]+', text)\n        for word in words:\n            if 'z' in word:\n                return True\n        return False\n\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"\n    Checks if the input string contains any word with the lowercase 'z' character.\n    It uses an internal WordMatcher class for this operation.\n    \"\"\"\n    matcher = WordMatcher()\n    return matcher.match(text)"}
