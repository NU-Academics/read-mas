{"task_id": "Mbpp/757", "solution": "from collections import Counter\nfrom typing import List\n\ndef count_reverse_pairs(strings: List[str]) -> int:\n    \"\"\"\n    Counts unordered pairs of strings in a list that are reverses of each other.\n    It handles duplicate strings and palindromes to count distinct pairs.\n    \"\"\"\n    string_counts = Counter(strings)\n    pairs_count = 0\n\n    # Iterate over a copy of the keys to safely modify string_counts during iteration.\n    for s in list(string_counts.keys()):\n        if string_counts[s] == 0:\n            continue\n\n        reversed_s = s[::-1]\n\n        if s == reversed_s:\n            # For palindromes, count pairs from multiple occurrences of the same string.\n            pairs_found = string_counts[s] // 2\n            pairs_count += pairs_found\n            string_counts[s] -= (pairs_found * 2)\n        else:\n            # For non-palindromes, look for their reverse counterpart.\n            if reversed_s in string_counts and string_counts[reversed_s] > 0:\n                num_pairs_to_add = min(string_counts[s], string_counts[reversed_s])\n                pairs_count += num_pairs_to_add\n                string_counts[s] -= num_pairs_to_add\n                string_counts[reversed_s] -= num_pairs_to_add\n    \n    return pairs_count"}
{"task_id": "Mbpp/755", "solution": "from typing import List\n\ndef second_smallest(numbers: List[int]) -> int:\n    \"\"\"\n    Finds the second smallest distinct number in a list of integers.\n    Raises ValueError if there are fewer than two distinct integers.\n    \"\"\"\n    first = None\n    second = None\n\n    for num in numbers:\n        if first is None or num < first:\n            second = first\n            first = num\n        elif num != first and (second is None or num < second):\n            second = num\n\n    if second is None:\n        raise ValueError(\"List must contain at least two distinct integers.\")\n    \n    return second"}
{"task_id": "Mbpp/759", "solution": "import re\n\ndef is_decimal(input_string: str) -> bool:\n    \"\"\"\n    Checks if the given string is a decimal number with exactly two decimal places.\n    The number can optionally have a sign.\n    \"\"\"\n    pattern = r\"^[+-]?\\d+\\.\\d{2}$\"\n    return bool(re.fullmatch(pattern, input_string))"}
