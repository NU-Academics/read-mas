{"task_id": "Mbpp/459", "solution": "def remove_uppercase(s: str) -> str:\n    \"\"\"Removes all contiguous uppercase substrings from the given string.\n\n    This function iterates through the string, skipping blocks of uppercase characters.\n    \"\"\"\n    result_chars = []\n    i = 0\n    n = len(s)\n\n    while i < n:\n        if s[i].isupper():\n            # Skip all consecutive uppercase characters\n            while i < n and s[i].isupper():\n                i += 1\n        else:\n            # Append non-uppercase character and move to the next\n            result_chars.append(s[i])\n            i += 1\n    \n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/465", "solution": "def drop_empty(input_dict: dict) -> dict:\n    \"\"\"\n    Return a new dictionary with all entries that have a value of None removed.\n\n    Parameters\n    ----------\n    input_dict : dict\n        The dictionary to be sanitized. Keys must be unique strings; values can be any Python object.\n\n    Returns\n    -------\n    dict\n        A new dictionary containing only the key-value pairs from `input_dict` whose values are not None.\n\n    Raises\n    ------\n    TypeError\n        If `input_dict` is not a dictionary.\n\n    Examples\n    --------\n    >>> drop_empty({'c1': 'Red', 'c2': 'Green', 'c3': None})\n    {'c1': 'Red', 'c2': 'Green'}\n    \"\"\"\n    if not isinstance(input_dict, dict):\n        raise TypeError(\"input_dict must be a dictionary\")\n\n    return {k: v for k, v in input_dict.items() if v is not None}"}
{"task_id": "Mbpp/462", "solution": "from typing import List, Any\n\ndef combinations_list(items: List[Any]) -> List[List[Any]]:\n    \"\"\"\n    Finds all possible ordered combinations of elements from a list, including the empty combination.\n    Elements within each combination are ordered in reverse of their appearance in the input list.\n    \"\"\"\n    n = len(items)\n    all_combinations = []\n\n    for i in range(1 << n):  # Iterate through all 2^n possible bitmasks\n        current_combination = []\n        for j in range(n):\n            # If the j-th bit is set in the mask i, include the j-th element\n            if (i >> j) & 1:\n                current_combination.append(items[j])\n        \n        # Reverse the combination to match the specific output order required by the assert.\n        current_combination.reverse()\n        all_combinations.append(current_combination)\n\n    return all_combinations"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(nums):\n    \"\"\"\n    Finds the maximum product of a contiguous subarray within the given array.\n    Handles positive, negative, and zero values efficiently in linear time.\n    \"\"\"\n    if not nums:\n        return 0\n\n    max_so_far = nums[0]\n    current_max_prod = nums[0]\n    current_min_prod = nums[0]\n\n    for i in range(1, len(nums)):\n        x = nums[i]\n        if x == 0:\n            current_max_prod = 1\n            current_min_prod = 1\n            max_so_far = max(max_so_far, 0)\n        else:\n            # Store the current max_prod to use in min_prod calculation\n            temp_max = current_max_prod * x\n            temp_min = current_min_prod * x\n\n            current_max_prod = max(x, temp_max, temp_min)\n            current_min_prod = min(x, temp_max, temp_min)\n\n            max_so_far = max(max_so_far, current_max_prod)\n\n    return max_so_far"}
{"task_id": "Mbpp/468", "solution": "def max_product(elements):\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of an increasing subsequence.\n    Uses dynamic programming with O(n^2) time complexity.\n    \"\"\"\n    n = len(elements)\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return elements[0]\n\n    dp = list(elements) # dp[i] stores the maximum product of an increasing subsequence ending at index i\n\n    for i in range(1, n):\n        for j in range(i):\n            if elements[j] < elements[i]:\n                dp[i] = max(dp[i], dp[j] * elements[i])\n\n    return max(dp)"}
