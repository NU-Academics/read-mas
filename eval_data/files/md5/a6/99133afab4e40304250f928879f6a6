{"task_id": "Mbpp/731", "solution": "import math\n\ndef lateralsurface_cone(r, h):\n    \"\"\"\n    Find the lateral surface area of a cone given radius r and the height h.\n    \"\"\"\n    slant_height = math.sqrt(r**2 + h**2)\n    lateral_surface_area = math.pi * r * slant_height\n    return lateral_surface_area"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array: list[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array.\n    Returns -1 if the target is not found.\n    \"\"\"\n    left, right = 0, len(array) - 1\n    result = -1\n\n    while left <= right:\n        mid = (left + right) // 2\n        if array[mid] == target:\n            result = mid  # Found a potential first occurrence\n            right = mid - 1  # Try to find an earlier occurrence in the left half\n        elif array[mid] < target:\n            left = mid + 1\n        else:  # array[mid] > target\n            right = mid - 1\n            \n    return result"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(arr):\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists of the given list.\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n    for i in range(n):\n        current_product = 1\n        for j in range(i, n):\n            current_product *= arr[j]\n            total_sum += current_product\n    return total_sum"}
{"task_id": "Mbpp/736", "solution": "from typing import List\n\ndef left_insertion(sorted_list: List[int], value: int) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted list.\n    Uses binary search to find the index where the value should be inserted\n    to maintain sorted order, specifically the first index `i` such that\n    all elements at `sorted_list[i:]` are greater than or equal to `value`.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
