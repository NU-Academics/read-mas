{"task_id": "Mbpp/296", "solution": "from typing import List\n\ndef get_Inv_Count(arr: List[int]) -> int:\n    \"\"\"\n    Counts inversions in an array using a modified merge sort algorithm.\n    An inversion occurs if i < j and arr[i] > arr[j].\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return 0\n\n    # Helper function that recursively sorts and counts inversions in a sub-array.\n    # It returns a tuple: (inversion_count, sorted_array).\n    def _merge_sort_and_count(sub_arr):\n        if len(sub_arr) <= 1:\n            return 0, sub_arr\n\n        mid = len(sub_arr) // 2\n        left_half = sub_arr[:mid]\n        right_half = sub_arr[mid:]\n\n        left_inversions, sorted_left = _merge_sort_and_count(left_half)\n        right_inversions, sorted_right = _merge_sort_and_count(right_half)\n\n        merged_arr = []\n        i, j = 0, 0\n        split_inversions = 0\n\n        while i < len(sorted_left) and j < len(sorted_right):\n            if sorted_left[i] <= sorted_right[j]:\n                merged_arr.append(sorted_left[i])\n                i += 1\n            else:\n                merged_arr.append(sorted_right[j])\n                j += 1\n                # If sorted_left[i] > sorted_right[j], then sorted_right[j]\n                # forms an inversion with sorted_left[i] and all remaining\n                # elements in sorted_left after i.\n                split_inversions += (len(sorted_left) - i)\n\n        merged_arr.extend(sorted_left[i:])\n        merged_arr.extend(sorted_right[j:])\n\n        total_inversions = left_inversions + right_inversions + split_inversions\n        return total_inversions, merged_arr\n\n    total_inversions, _ = _merge_sort_and_count(arr)\n    return total_inversions"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(dictionary: dict) -> int:\n    \"\"\"Calculates the maximum nesting depth of a dictionary.\n    The depth of a non-nested dictionary is considered 1.\"\"\"\n    if not isinstance(dictionary, dict):\n        # This case is excluded by \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n        # if referring to the top-level input, but is necessary for recursion.\n        # Assuming the instruction applies only to the top-level parameter 'dictionary' itself,\n        # but internal values need type checking to determine recursion path.\n        return 0\n\n    max_sub_depth = 0\n    for value in dictionary.values():\n        if isinstance(value, dict):\n            max_sub_depth = max(max_sub_depth, dict_depth(value))\n    return 1 + max_sub_depth"}
