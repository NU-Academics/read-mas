{"task_id": "Mbpp/629", "solution": "from typing import List\n\nclass NumberList:\n    \"\"\"A class to hold a list of numbers and provide filtering capabilities.\"\"\"\n    def __init__(self, numbers: List[int]):\n        self.numbers = numbers\n\n    def get_even_numbers(self) -> List[int]:\n        \"\"\"Filters the stored numbers and returns a list containing only the even numbers.\"\"\"\n        even_numbers_list = []\n        for num in self.numbers:\n            if num % 2 == 0:\n                even_numbers_list.append(num)\n        return even_numbers_list\n\ndef Split(numbers: List[int]) -> List[int]:\n    \"\"\"\n    Finds even numbers from a list of integers.\n    It uses the NumberList helper class to perform the filtering.\n    \"\"\"\n    number_list_instance = NumberList(numbers)\n    return number_list_instance.get_even_numbers()"}
