{"task_id": "Mbpp/130", "solution": "from collections import Counter\n\ndef max_occurrences(lst: list[int]) -> int:\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    In case of a tie, the item that appears first in the input list is returned.\n    \"\"\"\n    if not lst:\n        # Per design, error handling for empty list would raise ValueError,\n        # but implementation should not add checks/exceptions.\n        # This branch would conceptually handle it if allowed.\n        # However, based on prompt: \"assume valid input as per the assert\"\n        # and \"DO NOT add isinstance() checks or raise exceptions for edge cases\"\n        # For the given problem, an empty list would lead to returning None\n        # if max_item is initialized to None and never updated.\n        # The assert guarantees a non-empty list.\n        pass\n\n    counts = Counter(lst)\n\n    max_freq = 0\n    max_item = lst[0] # Initialize with the first item to handle cases where all items have same freq\n\n    for item in lst:\n        current_freq = counts[item]\n        if current_freq > max_freq:\n            max_freq = current_freq\n            max_item = item\n            \n    return max_item"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels of a given string, where 'y' is not considered a vowel.\n    \"\"\"\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is a vowel (a, e, i, o, u, case-insensitive).\"\"\"\n        return char.lower() in 'aeiou'\n\n    s_list = list(s)\n    vowel_indices = []\n    vowels_found = []\n\n    # First pass: find all vowels and their original positions\n    for i, char in enumerate(s_list):\n        if _is_vowel(char):\n            vowel_indices.append(i)\n            vowels_found.append(char)\n\n    # Reverse the order of the found vowels\n    vowels_found.reverse()\n\n    # Second pass: place the reversed vowels back into the string at their original positions\n    for i, original_index in enumerate(vowel_indices):\n        s_list[original_index] = vowels_found[i]\n\n    return \"\".join(s_list)"}
{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix):\n    \"\"\"\n    Calculates whether the given matrix is a magic square.\n    A magic square is a square matrix where the sum of each row,\n    each column, and both main diagonals are the same, and all elements are distinct.\n    \"\"\"\n    n = len(matrix)\n\n    if n == 0:\n        return False\n\n    # Calculate the magic sum from the first row\n    # Also check if the first row has the correct length\n    magic_sum = 0\n    if len(matrix[0]) != n:\n        return False\n    magic_sum = sum(matrix[0])\n\n    col_sums = [0] * n\n    diag1_sum = 0  # Main diagonal (top-left to bottom-right)\n    diag2_sum = 0  # Anti-diagonal (top-right to bottom-left)\n    seen_elements = set()\n\n    for i in range(n):\n        row = matrix[i]\n        if len(row) != n:\n            return False\n\n        current_row_sum = 0\n        for j in range(n):\n            element = row[j]\n\n            if element in seen_elements:\n                return False  # Elements must be distinct\n            seen_elements.add(element)\n\n            current_row_sum += element\n            col_sums[j] += element\n\n            if i == j:\n                diag1_sum += element\n            if i + j == n - 1:\n                diag2_sum += element\n\n        if current_row_sum != magic_sum:\n            return False\n\n    for col_sum in col_sums:\n        if col_sum != magic_sum:\n            return False\n\n    if diag1_sum != magic_sum:\n        return False\n\n    if diag2_sum != magic_sum:\n        return False\n\n    return True"}
