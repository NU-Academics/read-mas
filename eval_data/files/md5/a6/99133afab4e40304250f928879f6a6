{"task_id": "Mbpp/104", "solution": "from typing import List\n\nclass Sublist:\n    \"\"\"Represents a single sublist of strings.\"\"\"\n    def __init__(self, elements: List[str]):\n        self.elements = elements\n\n    def sort(self) -> List[str]:\n        \"\"\"Returns a new list with elements sorted lexicographically.\"\"\"\n        return sorted(self.elements)\n\nclass ListOfLists:\n    \"\"\"Encapsulates a list of sublists for sorting operations.\"\"\"\n    def __init__(self, raw_list_of_lists: List[List[str]]):\n        self.sublists: List[Sublist] = [Sublist(sub) for sub in raw_list_of_lists]\n\n    def get_sorted_result(self) -> List[List[str]]:\n        \"\"\"Applies sorting to each sublist and returns the compiled result.\"\"\"\n        return [sub.sort() for sub in self.sublists]\n\ndef sort_sublists(list_of_lists: List[List[str]]) -> List[List[str]]:\n    \"\"\"\n    Sorts each sublist of strings in a given list of lists lexicographically.\n    Returns a new list of lists without modifying the original input.\n    \"\"\"\n    list_of_lists_obj = ListOfLists(list_of_lists)\n    return list_of_lists_obj.get_sorted_result()"}
{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Compute the Eulerian number a(n, m).\n\n    This function calculates the Eulerian number using a dynamic programming approach\n    based on the recurrence relation.\n    \"\"\"\n    if n < 1 or m < 0 or m >= n:\n        raise ValueError(\"Invalid arguments: require n >= 1 and 0 <= m < n\")\n\n    # dp[i][j] will store the Eulerian number a(i, j)\n    # The table is initialized with zeros, and dp[i] has length i+1 to store values for m=0 to m=i.\n    dp = [[0] * (i + 1) for i in range(n + 1)]\n    \n    # Base case: a(0, 0) = 1\n    dp[0][0] = 1\n\n    # Fill the DP table using the recurrence relation\n    for i in range(1, n + 1):\n        for j in range(i):  # m must be < n, so j must be < i\n            term1 = (i - j) * dp[i - 1][j - 1] if j > 0 else 0\n            term2 = (j + 1) * dp[i - 1][j]\n            dp[i][j] = term1 + term2\n\n    return dp[n][m]"}
