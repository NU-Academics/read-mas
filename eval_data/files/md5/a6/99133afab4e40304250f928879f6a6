{"task_id": "Mbpp/793", "solution": "import collections\nimport heapq\nimport itertools\nimport math\nimport random\nimport re\nimport sys\nfrom typing import List, Optional, Tuple, Union\n\ndef last(array: List[int], target: int) -> int:\n    \"\"\"\n    Finds the last position of an element in a sorted array using binary search.\n    Returns -1 if the target is not found.\n    \"\"\"\n    left, right = 0, len(array) - 1\n    result = -1\n    while left <= right:\n        mid = (left + right) // 2\n        if array[mid] == target:\n            result = mid\n            left = mid + 1   # Search in the right half for a later occurrence\n        elif array[mid] < target:\n            left = mid + 1\n        else:\n            right = mid - 1\n    return result"}
