{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth powers of the first n odd natural numbers.\n    Iterates from 1 up to the nth odd number, raising each to the fourth power.\n    \"\"\"\n    total_sum = 0\n    for i in range(n):\n        odd_number = 2 * i + 1\n        total_sum += odd_number ** 4\n    return total_sum"}
{"task_id": "Mbpp/771", "solution": "class Stack:\n    \"\"\"A simple stack implementation.\"\"\"\n    def __init__(self):\n        self.items = []\n\n    def push(self, item):\n        self.items.append(item)\n\n    def pop(self):\n        if not self.isEmpty():\n            return self.items.pop()\n        return None\n\n    def peek(self):\n        if not self.isEmpty():\n            return self.items[-1]\n        return None\n\n    def isEmpty(self):\n        return len(self.items) == 0\n\nclass Expression:\n    \"\"\"Represents an expression to check for balanced brackets.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def isBalanced(self) -> bool:\n        stack = Stack()\n        opening_brackets = \"([{\"\n        matching_pairs = {')': '(', ']': '[', '}': '{'}\n\n        for char in self.value:\n            if char in opening_brackets:\n                stack.push(char)\n            elif char in matching_pairs:\n                if stack.isEmpty():\n                    return False\n                top_char = stack.pop()\n                if top_char != matching_pairs[char]:\n                    return False\n        return stack.isEmpty()\n\ndef check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets.\n    Handles '()', '[]', '{}'.\n    \"\"\"\n    expression_obj = Expression(expression)\n    return expression_obj.isBalanced()"}
{"task_id": "Mbpp/772", "solution": "def remove_length(text, k):\n    \"\"\"\n    Removes all words with a specified length k from the given string.\n    Words are separated by spaces.\n    \"\"\"\n    words = text.split()\n    filtered_words = [word for word in words if len(word) != k]\n    return ' '.join(filtered_words)"}
{"task_id": "Mbpp/773", "solution": "from typing import Optional, Tuple\n\ndef occurance_substring(text: str, pattern: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"Find the first occurrence of a substring within a string.\n\n    Returns a tuple (substring, start_index, length) if found, otherwise None.\n    \"\"\"\n    if not pattern:\n        # As per design, an empty pattern matches at index 0 with length 0.\n        return (\"\", 0, 0)\n\n    start_index = text.find(pattern)\n\n    if start_index == -1:\n        return None\n    else:\n        length = len(pattern)\n        return (pattern, start_index, length)"}
