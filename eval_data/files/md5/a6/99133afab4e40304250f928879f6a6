{"task_id": "Mbpp/572", "solution": "from typing import List, Dict\n\ndef two_unique_nums(nums: List[int]) -> List[int]:\n    \"\"\"\n    Returns a new list containing only the elements that appear exactly once\n    in `nums`, preserving their original order.\n    \"\"\"\n    freq: Dict[int, int] = {}\n    for num in nums:\n        freq[num] = freq.get(num, 0) + 1\n\n    result: List[int] = [num for num in nums if freq[num] == 1]\n\n    return result"}
{"task_id": "Mbpp/576", "solution": "from typing import List\n\ndef is_Sub_Array(source: List, sub: List) -> bool:\n    \"\"\"\n    Checks if `sub` is a contiguous sublist of `source`.\n    Returns True if `sub` is found, False otherwise.\n    \"\"\"\n    if not sub:\n        return True\n    if not source:\n        return False\n\n    sub_len = len(sub)\n    for i in range(len(source) - sub_len + 1):\n        if source[i:i + sub_len] == sub:\n            return True\n    return False"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1, list2, list3):\n    \"\"\"Interleaves three lists of the same length into a single flat list.\"\"\"\n    interleaved = []\n    for i in range(len(list1)):\n        interleaved.append(list1[i])\n        interleaved.append(list2[i])\n        interleaved.append(list3[i])\n    return interleaved"}
{"task_id": "Mbpp/579", "solution": "from typing import Tuple, List, Any\n\nclass InputTuple:\n    \"\"\"Represents an immutable input tuple for domain operations.\"\"\"\n    def __init__(self, elements: Tuple[Any, ...]):\n        self._elements: List[Any] = list(elements)\n\n    @property\n    def elements(self) -> List[Any]:\n        return list(self._elements)\n\nclass ResultTuple:\n    \"\"\"Represents the result of a domain operation as a list of elements.\"\"\"\n    def __init__(self, elements: List[Any]):\n        self._elements: List[Any] = elements\n\n    @property\n    def elements(self) -> List[Any]:\n        return list(self._elements)\n\nclass DisjointFinder:\n    \"\"\"A domain service responsible for finding dissimilar elements.\"\"\"\n    def find_dissimilar(self, t1: InputTuple, t2: InputTuple) -> ResultTuple:\n        elements1 = t1.elements\n        elements2 = t2.elements\n\n        set1 = set(elements1)\n        set2 = set(elements2)\n\n        dissimilar_list: List[Any] = []\n\n        for e in elements1:\n            if e not in set2:\n                dissimilar_list.append(e)\n\n        for e in elements2:\n            if e not in set1:\n                dissimilar_list.append(e)\n\n        return ResultTuple(dissimilar_list)\n\ndef find_dissimilar(t1: Tuple[Any, ...], t2: Tuple[Any, ...]) -> Tuple[Any, ...]:\n    \"\"\"Finds dissimilar elements in two tuples, preserving their original order.\"\"\"\n    input_t1 = InputTuple(t1)\n    input_t2 = InputTuple(t2)\n\n    finder = DisjointFinder()\n    result_tuple_obj = finder.find_dissimilar(input_t1, input_t2)\n\n    return tuple(result_tuple_obj.elements)"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple):\n    \"\"\"\n    Recursively extract even integers from a nested tuple, preserving structure.\n    \"\"\"\n    def _extract(t):\n        result = []\n        for item in t:\n            if isinstance(item, tuple):\n                nested = _extract(item)\n                if nested:\n                    result.append(nested)\n            elif isinstance(item, int) and item % 2 == 0:\n                result.append(item)\n        return tuple(result)\n\n    return _extract(input_tuple)"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Calculates the last decimal digit of n! by computing modulo 10 iteratively.\n    This function assumes n is a non-negative integer.\n    \"\"\"\n    result = 1\n    for i in range(2, n + 1):\n        result = (result * i) % 10\n    return result"}
{"task_id": "Mbpp/581", "solution": "import math\n\ndef surface_Area(base_edge, height):\n    \"\"\"\n    Calculates the total surface area of a square pyramid using its base edge and height.\n    This implementation follows the standard geometric formulas as specified in the design.\n    \"\"\"\n    base_area = base_edge ** 2\n    slant_height = math.hypot(base_edge / 2, height)\n    lateral_area = 2 * base_edge * slant_height\n    total_surface_area = base_area + lateral_area\n    return total_surface_area"}
{"task_id": "Mbpp/588", "solution": "from typing import List\n\nclass NumberList:\n    def __init__(self, numbers: List[int]) -> None:\n        self.numbers = numbers\n\n    def computeDifference(self) -> int:\n        if len(self.numbers) == 1:\n            return 0\n        return max(self.numbers) - min(self.numbers)\n\ndef big_diff(numbers: List[int]) -> int:\n    if not isinstance(numbers, list):\n        raise ValueError(\"Input must be a list of integers.\")\n    if not numbers:\n        raise ValueError(\"Input list must contain at least one integer.\")\n    if not all(isinstance(n, int) for n in numbers):\n        raise ValueError(\"All elements must be integers.\")\n    number_list = NumberList(numbers)\n    return number_list.computeDifference()"}
{"task_id": "Mbpp/585", "solution": "import operator\n\ndef expensive_items(dataset: list[dict], n: int) -> list[dict]:\n    \"\"\"\n    Finds the n most expensive items in a given dataset.\n    Items are dictionaries with a 'price' key.\n    \"\"\"\n    if not dataset or n <= 0:\n        return []\n\n    # Sort the dataset by 'price' in descending order\n    sorted_items = sorted(dataset, key=operator.itemgetter('price'), reverse=True)\n\n    # Return the first n items\n    return sorted_items[:n]"}
{"task_id": "Mbpp/586", "solution": "def split_Arr(lst, n):\n    # Splits a list at the nth element and adds the first part to the end.\n    # Handles empty lists and ensures valid index.\n    if not lst:\n        return []\n    if not (0 <= n < len(lst)):\n        # Per design, ValueError should be raised if index is out of bounds.\n        # However, the prompt specifically says \"DO NOT ... raise exceptions for edge cases\"\n        # and \"Use the EXACT function name and parameter names from the function stub above\".\n        # The assert in the stub implies n=2 is valid for a list of length 6.\n        # Given the example `split_Arr([12,10,5,6,52,36],2) == [5,6,52,36,12,10]`,\n        # n is effectively the number of elements to move from the front to the end.\n        # So, if n is 0, nothing moves. If n is len(lst), the list is rotated fully.\n        # The design document's error handling for \"index out of bounds\" (n >= len(lst))\n        # contradicts the prompt's instruction to not raise exceptions for edge cases\n        # and also contradicts the common behavior of list rotation functions.\n        # Following the strict instruction to *not* raise exceptions for edge cases,\n        # we'll allow `n` to effectively wrap around or clamp.\n        # For a simple split and concatenate, Python's slicing handles this naturally.\n        pass # Allow Python slicing to handle n outside 0 <= n < len(lst) if it can\n\n    first_part = lst[:n]\n    second_part = lst[n:]\n    return second_part + first_part"}
