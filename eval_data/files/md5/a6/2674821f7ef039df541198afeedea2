he same highest frequency are included in the result.\n    \"\"\"\n    if not test:\n        return {}\n\n    letters = test.split(' ')\n    \n    # Filter out empty strings that might result from multiple spaces or leading/trailing spaces.\n    valid_letters = [letter for letter in letters if letter]\n\n    if not valid_letters:\n        return {}\n\n    counts = Counter(valid_letters)\n\n    max_count = max(counts.values())\n\n    result = {\n        letter: count\n        for letter, count in counts.items()\n        if count == max_count\n    }\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/109": [{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"Determines if an array can be sorted by right shifts.\n    Returns True if sortable, False otherwise.\"\"\"\n\n    def _is_sorted(current_arr):\n        \"\"\"Checks if an array is sorted in non-decreasing order.\n        Returns True if sorted, False otherwise.\"\"\"\n        if not current_arr:\n            return True\n        return all(current_arr[i] <= current_arr[i+1] for i in range(len(current_arr) - 1))\n\n    def _right_shift(current_arr):\n        \"\"\"Performs a single right-shift operation on the array.\n        The last element moves to the front.\"\"\"\n        if not current_arr:\n            return []\n        return [current_arr[-1]] + current_arr[:-1]\n\n    if not arr:\n        return True\n\n    n = len(arr)\n    current_arr = list(arr) # Create a mutable copy to avoid modifying original\n\n    # We only need to check up to N shifts, as after N shifts it returns to the original state.\n    for _ in range(n): \n        if _is_sorted(current_arr):\n            return True\n        current_arr = _right_shift(current_arr)\n    \n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/109", "solution": "def move_one_ball(a