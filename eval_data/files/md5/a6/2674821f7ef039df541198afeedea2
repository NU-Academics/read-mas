e reversed instead.\n    \"\"\"\n    if x < 0:\n        sign = \"-\"\n        s = str(abs(x))\n    else:\n        sign = \"\"\n        s = str(x)\n\n    n = len(s)\n\n    if shift > n:\n        # If shift strictly greater than number of digits, reverse.\n        result_digits = s[::-1]\n    else:\n        # Otherwise, perform circular shift.\n        effective_shift = shift % n\n        result_digits = s[n - effective_shift:] + s[:n - effective_shift]\n\n    return sign + result_digits", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string. If shift > number of digits, return digits reversed.\n    \"\"\"\n    is_negative = x < 0\n    s_x = str(abs(x))\n    num_digits = len(s_x)\n\n    if shift > num_digits:\n        shifted_s_x = s_x[::-1]\n    else:\n        effective_shift = shift % num_digits\n        shifted_s_x = s_x[-effective_shift:] + s_x[:-effective_shift]\n\n    if is_negative:\n        return \"-\" + shifted_s_x\n    else:\n        return shifted_s_x", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/67": [{"task_id": "HumanEval/67", "solution": "def fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket.\n    It subtracts the counts of apples and oranges from the total number of fruits.\n    \"\"\"\n    import re\n\n    # Extracts apple and orange counts from the input string 's'.\n    match = re.match(r\"(\\d+)\\s*apples\\s*and\\s*(\\d+)\\s*oranges\", s)\n    \n    apples = int(match.group(1))\n    oranges = int(match.group(2))\n\n    # Calculates the final number of mangoes.\n    mangoes = n - apples - oranges\n    \n    return mangoes", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/67", "solution": "import re\nclass FruitCounts:\n    \"\"\"Stores the counts of apples and oranges.\"\"\"\n    def __init__(self, apples, oranges):\n        self.apples = apples\n        self.oranges = oranges\n\n    def __eq__(self, other):\n        \"\"\"Compares two FruitCounts objects for equality.\"\"\"\n        return self.apples == other.apples and self.oranges == other.oranges\n\n    def __repr__(self):\n        \"\"\"Returns a string representation of the object.\"\"\"\n        return f\"FruitCounts(apples={self.apples}, oranges={self.oranges})\"\nclass FruitParser:\n    \"\"\"Parses an input string to extract apple and orange counts.\"\"\"\n    def parse(self, s):\n        match = re.search(r\"(\\d+)\\s*apples\\s*and\\s*(\\d+)\\s*oranges\", s, re.IGNORECASE)\n        \n        # Critical requirements dictate trusting caller's input and avoiding error handling.\n        apples = int(match.group(1))\n        oranges = int(match.group(2))\n        \n        return FruitCounts(apples, oranges)\nclass FruitDistributionCalculator:\n    \"\"\"Calculates the number of mangoes.\"\"\"\n    def calculate_mangoes(self, fruit_counts, total_fruits):\n        total_apples_oranges = fruit_counts.apples + fruit_counts.oranges\n        \n        # Critical requirements dictate trusting caller's input and avoiding error handling.\n        mangoes = total_fruits - total_apples_oranges\n        \n        return mangoes\ndef fruit_distribution(s, n):\n    \"\"\"Calculates the number of mango fruits in a basket.\n    It parses apple and orange counts and subtracts them from the total fruits.\n    \"\"\"\n    parser = FruitParser()\n    fruit_counts = parser.parse(s)\n\n    calculator = FruitDistributionCalculator()\n    mangoes = calculator.calculate_mangoes(fruit_counts, n)\n    \n    return mangoes", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/39": [{"task_id": "HumanEval/39", "solution": "import math\nclass FibonacciGenerator:\n    \"\"\"\n    Generates Fibonacci numbers sequentially.\n    Initializes to F(0)=0 and F(1)=1.\n    \"\"\"\n    def __init__(self):\n        self._current_a = 0\n        self._current_b = 1\n        self._count = 0\n\n    def next_fibonacci(self) -> int:\n        \"\"\"\n        Returns the next Fibonacci number and updates state.\n        Handles the initial 0 and 1 of the sequence.\n        \"\"\"\n        if self._count == 0:\n            self._count += 1\n            return 0\n        elif self._count == 1:\n            self._count += 1\n            return 1\n        else:\n            next_fib = self._current_a + self._current_b\n            self._current_a = self._current_b\n            self._current_b = next_fib\n            self._count += 1\n            return next_fib\nclass PrimalityChecker:\n    \"\"\"\n    Determines if a given integer is a prime number.\n    Uses trial division up to the square root of the number.\n    \"\"\"\n    def is_prime(self, num: int) -> bool:\n        \"\"\"\n        Checks if num is a prime number. Numbers less than 2 are not prime.\n        Optimized for efficiency by checking divisors up to sqrt(num).\n        \"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(num)) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\nclass PrimeFibService:\n    \"\"\"\n    Orchestrates Fibonacci generation and primality checking.\n    Finds the n-th number that is both Fibonacci and prime.\n    \"\"\"\n    def __init__(self, fib_generator: FibonacciGenerator, prime_checker: PrimalityChecker):\n        self._fib_generator = fib_generator\n        self._prime_checker = prime_checker\n\n    def find_nth_prime_fib(self, n: int) -> int:\n        \"\"\"\n        Finds and returns the n-th number that is both a Fibonacci number and