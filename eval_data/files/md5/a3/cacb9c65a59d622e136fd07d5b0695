{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n\n    # Initialize the last four values for n > 3: fib4(0), fib4(1), fib4(2), fib4(3)\n    a, b, c, d = 0, 0, 2, 0\n\n    # Iteratively compute fib4(n)\n    for i in range(4, n + 1):\n        next_fib4 = a + b + c + d\n        a, b, c, d = b, c, d, next_fib4\n\n    return d"}
{"task_id": "HumanEval/45", "solution": "class Triangle:\n    \"\"\"Represents a triangle with side length and height.\"\"\"\n\n    def __init__(self, side_length: float, height: float):\n        \"\"\"Initializes a Triangle object with given dimensions.\"\"\"\n        if not isinstance(side_length, (int, float)) or side_length < 0:\n            raise ValueError(\"Side length must be a non-negative numerical value.\")\n        if not isinstance(height, (int, float)) or height < 0:\n            raise ValueError(\"Height must be a non-negative numerical value.\")\n\n        self._side_length = float(side_length)\n        self._height = float(height)\n\n    def calculate_area(self) -> float:\n        \"\"\"Calculates and returns the area of the triangle.\"\"\"\n        return (self._side_length * self._height) / 2.0\ndef triangle_area(a: float, h: float) -> float:\n    \"\"\"Given length of a side and high return area for a triangle.\n    This function serves as the primary interface, delegating core logic to the Triangle class.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    triangle = Triangle(a, h)\n    return triangle.calculate_area()"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    return text == text[::-1]"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_list = sorted(l)\n    n = len(sorted_list)\n\n    if n % 2 == 1:\n        return sorted_list[n // 2]\n    else:\n        mid1 = sorted_list[n // 2 - 1]\n        mid2 = sorted_list[n // 2]\n        return (mid1 + mid2) / 2.0"}
{"task_id": "HumanEval/52", "solution": "def below_threshold(l: list, t: int):\n    \"\"\"Return True if all numbers in the list l are below threshold t.\n    >>> below_threshold([1, 2, 4, 10], 100)\n    True\n    >>> below_threshold([1, 20, 4, 10], 5)\n    False\n    \"\"\"\n    for number in l:\n        if number >= t:\n            return False\n    return True"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    This function implements modular exponentiation by squaring to handle large values efficiently and without overflow.\n    >>> modp(3, 5)\n    3\n    >>> modp(1101, 101)\n    2\n    >>> modp(0, 101)\n    1\n    >>> modp(3, 11)\n    8\n    >>> modp(100, 101)\n    1\n    \"\"\"\n    if p == 1:\n        return 0\n    if n == 0:\n        return 1 % p\n\n    base = 2\n    res = 1\n    base %= p\n\n    while n > 0:\n        if n % 2 == 1:\n            res = (res * base) % p\n        base = (base * base) % p\n        n //= 2\n\n    return res"}
