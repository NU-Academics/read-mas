{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if n <= 1:\n        return False\n    i = 2\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 1\n    return True"}
{"task_id": "HumanEval/29", "solution": "def filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n    >>> filter_by_prefix([], 'a')\n    []\n    >>> filter_by_prefix(['abc', 'bcd', 'cde', 'array'], 'a')\n    ['abc', 'array']\n    \"\"\"\n    return [s for s in strings if s.startswith(prefix)]"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    l_prime = l.copy()\n\n    divisible_elements_values = []\n    divisible_indices = []\n\n    # Collect values and their original indices where the index is divisible by three.\n    for i in range(len(l)):\n        if i % 3 == 0:\n            divisible_elements_values.append(l[i])\n            divisible_indices.append(i)\n\n    divisible_elements_values.sort()\n\n    # Place the sorted values back into the corresponding positions in the new list.\n    for i in range(len(divisible_indices)):\n        original_index = divisible_indices[i]\n        l_prime[original_index] = divisible_elements_values[i]\n\n    return l_prime"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n\n    def _is_divisible_by_11_or_13(number: int) -> bool:\n        \"\"\"Checks if a given integer is divisible by 11 or 13.\"\"\"\n        return (number % 11 == 0) or (number % 13 == 0)\n\n    def _count_digit_occurrences(number: int, digit: int) -> int:\n        \"\"\"Counts the occurrences of a specific digit within a given number.\"\"\"\n        return str(number).count(str(digit))\n\n    total_count = 0\n    for x in range(1, n):\n        if _is_divisible_by_11_or_13(x):\n            total_count += _count_digit_occurrences(x, 7)\n    return total_count"}
{"task_id": "HumanEval/32", "solution": "import math\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    if len(xs) % 2 != 0:\n        raise ValueError(\"Input list xs must have an even number of coefficients.\")\n    if xs[-1] == 0:\n        raise ValueError(\"The highest degree coefficient (last element) must be non-zero.\")\n\n    tolerance = 1e-7\n\n    # Initialize a search interval for the root\n    a = -1.0\n    b = 1.0\n\n    # Expand the interval until poly(a) and poly(b) have opposite signs or a root is found\n    # The expansion limit 1e12 is chosen to prevent excessively large numbers and potential overflows.\n    while True:\n        f_a = poly(xs, a)\n        f_b = poly(xs, b)\n\n        if abs(f_a) < tolerance:\n            return a\n        if abs(f_b) < tolerance:\n            return b\n\n        # If signs are opposite, we have a valid interval for bisection\n        if math.copysign(1, f_a) != math.copysign(1, f_b):\n            break\n        \n        # If the interval becomes too large without a sign change, break\n        # (This case is theoretically unlikely for odd-degree polynomials with guaranteed real roots)\n        if abs(a) > 1e12 or abs(b) > 1e12: \n            break \n\n        a *= 2.0\n        b *= 2.0\n\n    # Bisection Method for root finding\n    max_iterations = 1000 # Limit iterations to prevent infinite loops\n\n    # Re-evaluate f_a and f_b after interval expansion\n    f_a = poly(xs, a)\n    f_b = poly(xs, b)\n\n    for _ in range(max_iterations):\n        mid = (a + b) / 2.0\n        f_mid = poly(xs, mid)\n\n        # Check for convergence\n        if abs(f_mid) < tolerance or abs(b - a) < tolerance:\n            return mid\n\n        # Determine which half contains the root\n        if math.copysign(1, f_a) != math.copysign(1, f_mid):  # Root is in [a, mid]\n            b = mid\n            f_b = f_mid # Update f_b for the new interval\n        else:  # Root is in [mid, b]\n            a = mid\n            f_a = f_mid # Update f_a for the new interval\n\n    # If max_iterations reached without converging sufficiently, return the current mid-point\n    return (a + b) / 2.0"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    l_prime = list(l)  # Create a copy of the input list.\n    even_elements = []\n\n    # Extract all elements at even indices from the original list.\n    for i in range(len(l)):\n        if i % 2 == 0:\n            even_elements.append(l[i])\n    \n    even_elements.sort()  # Sort the extracted even-indexed elements.\n\n    even_idx_counter = 0\n    # Replace elements at even indices in l_prime with the sorted values.\n    for i in range(len(l_prime)):\n        if i % 2 == 0:\n            l_prime[i] = even_elements[even_idx_counter]\n            even_idx_counter += 1\n            \n    return l_prime"}
