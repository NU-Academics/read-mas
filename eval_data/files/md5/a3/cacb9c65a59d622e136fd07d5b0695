{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3, mirroring the encoding.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group if it has 3 elements.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n\n    def is_prime(num: int) -> bool:\n        \"\"\"Checks if a given number is prime.\"\"\"\n        if num < 2:\n            return False\n        i = 2\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 1\n        return True\n\n    def generate_fibonacci_sequence():\n        \"\"\"Generates an infinite sequence of Fibonacci numbers (0, 1, 1, 2, 3, 5, ...).\"\"\"\n        a, b = 0, 1\n        while True:\n            yield a\n            a, b = b, a + b\n\n    prime_fib_numbers = []\n    fib_gen = generate_fibonacci_sequence()\n\n    # Skip initial 0, 1, 1 as per problem context where 2 is the 1st prime fib.\n    next(fib_gen) # Consumes 0\n    next(fib_gen) # Consumes 1\n    next(fib_gen) # Consumes 1\n\n    while len(prime_fib_numbers) < n:\n        fib_num = next(fib_gen)\n        if is_prime(fib_num):\n            prime_fib_numbers.append(fib_num)\n\n    return prime_fib_numbers[n - 1]"}
