{"task_id": "Mbpp/733", "solution": "```python\ndef find_first_occurrence(arr: list[int], num: int) -> int:\n    \"\"\"Searches for the first occurrence of `num` in a sorted list `arr`.\n    Returns its zero-based index or -1 if not found.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == num:\n            result = mid\n            high = mid - 1  # Found a match, but try to find an earlier one in the left half\n        elif arr[mid] < num:\n            low = mid + 1\n        else:  # arr[mid] > num\n            high = mid - 1\n\n    return result\n```"}
{"task_id": "Mbpp/734", "solution": "```python\ndef sum_Of_Subarray_Prod(input_list: list) -> (int | float):\n    \"\"\"Calculates the sum of products of all contiguous sublists of a given list. Returns 0 for an empty list.\"\"\"\n    total_sum_of_products = 0\n\n    if not input_list:\n        return 0\n\n    n = len(input_list)\n\n    # Iterate over all possible starting points (i)\n    for i in range(n):\n        current_product = 1\n        # Iterate over all possible ending points (j) from the current starting point\n        for j in range(i, n):\n            # Calculate product for the sublist input_list[i...j]\n            current_product *= input_list[j]\n            total_sum_of_products += current_product\n\n    return total_sum_of_products\n```"}
{"task_id": "Mbpp/734", "solution": "```python\ndef _calculate_product(sublist: list[int]) -> int:\n    \"\"\"Calculates the product of all elements within a single sublist.\n    Returns 1 for an empty sublist.\"\"\"\n    product = 1\n    for x in sublist:\n        product *= x\n    return product\n\ndef _get_all_sublists(numbers: list[int]) -> list[list[int]]:\n    \"\"\"Generates all contiguous sublists from a given list of numbers.\"\"\"\n    all_sublists = []\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i, n):\n            all_sublists.append(numbers[i:j+1])\n    return all_sublists\n\ndef sum_Of_Subarray_Prod(numbers: list[int]) -> int:\n    \"\"\"Accepts a list of integers, identifies all its sublists, calculates their products, and sums them.\n    Returns the total sum of products of all possible sublists.\"\"\"\n    total_sum = 0\n    all_sublists = _get_all_sublists(numbers)\n    for sublist in all_sublists:\n        product = _calculate_product(sublist)\n        total_sum += product\n    return total_sum\n```\n"}
{"task_id": "Mbpp/735", "solution": "```python\ndef toggle_middle_bits(number: int) -> int:\n    \"\"\"Toggles all bits of an integer except its most significant and least significant bits.\n    If the number has 2 or fewer bits, it is returned unchanged as there are no middle bits.\n    \"\"\"\n    bit_length = number.bit_length()\n\n    if bit_length <= 2:\n        return number\n\n    # Create a mask with '1's for all bits from position 1 up to (bit_length - 2).\n    # This involves creating a sequence of (bit_length - 1) ones, then clearing the LSB.\n    mask = ((1 << (bit_length - 1)) - 1) & ~1\n\n    return number ^ mask\n```"}
