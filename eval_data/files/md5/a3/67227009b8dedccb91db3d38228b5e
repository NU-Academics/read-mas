{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"Calculates the nth Jacobsthal number iteratively.\n    It handles base cases for n=0 and n=1, and uses the recurrence relation for n > 1.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    # J(n) = J(n-1) + 2 * J(n-2) for n > 1\n    # Initialize for J(0) and J(1)\n    j_n_minus_2 = 0  # Represents J(k-2)\n    j_n_minus_1 = 1  # Represents J(k-1)\n\n    for _ in range(2, n + 1):\n        current_jacobsthal = j_n_minus_1 + 2 * j_n_minus_2\n        j_n_minus_2 = j_n_minus_1\n        j_n_minus_1 = current_jacobsthal\n\n    return j_n_minus_1"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth Jacobsthal number iteratively.\n    Applies J(0)=0, J(1)=1, and J(n)=J(n-1)+2*J(n-2) for n > 1.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n\n    # Initialize for J(0) and J(1)\n    j_n_minus_2 = 0 # Corresponds to J(i-2)\n    j_n_minus_1 = 1 # Corresponds to J(i-1)\n\n    # Iterate from J(2) up to J(n)\n    for _ in range(2, n + 1):\n        current_j = j_n_minus_1 + 2 * j_n_minus_2\n        j_n_minus_2 = j_n_minus_1\n        j_n_minus_1 = current_j\n    return j_n_minus_1"}
{"task_id": "Mbpp/753", "solution": "```python\ndef min_k(tuple_list: list[tuple], k: int) -> list[tuple]:\n    \"\"\"\n    Retrieves k records with the smallest values from a tuple list, sorted by the second element.\n    Compares tuples based on their second element (index 1).\n    \"\"\"\n    if k <= 0:\n        return []\n\n    # Sort the list by the second element of each tuple.\n    sorted_list = sorted(tuple_list, key=lambda x: x[1])\n\n    # Return the first k elements. List slicing handles k > len(list) by returning the entire list.\n    return sorted_list[:k]\n```"}
{"task_id": "Mbpp/751", "solution": "```python\ndef check_min_heap(array: list) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    A min-heap ensures each node's value is less than or equal to its children's values.\n    \"\"\"\n    n = len(array)\n\n    if n <= 1:\n        return True\n\n    # Iterate through parent nodes, up to the last parent node at index (n // 2) - 1.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Compare parent with left child.\n        if array[i] > array[left_child_idx]:\n            return False\n\n        # Compare parent with right child, if it exists within the array bounds.\n        if right_child_idx < n and array[i] > array[right_child_idx]:\n            return False\n\n    return True\n```"}
{"task_id": "Mbpp/751", "solution": "```python\ndef check_min_heap(arr: list) -> bool:\n    \"\"\"\n    Evaluates if the input array satisfies the min-heap property.\n    Returns True if the array is a min-heap, False otherwise.\n    \"\"\"\n    n = len(arr)\n\n    # Base cases: empty or single-element arrays are considered valid min-heaps.\n    if n <= 1:\n        return True\n\n    # Iterate from the first non-leaf node up to the root (indices from (n // 2) - 1 down to 0).\n    for i in range((n // 2) - 1, -1, -1):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # If left child exists and violates the min-heap property, return False.\n        if left_child_idx < n and arr[i] > arr[left_child_idx]:\n            return False\n\n        # If right child exists and violates the min-heap property, return False.\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n\n    # If all nodes satisfy the min-heap property, return True.\n    return True\n```\n"}
{"task_id": "Mbpp/753", "solution": "def min_k(records: list[tuple[str, int]], k: int) -> list[tuple[str, int]]:\n    \"\"\"\n    Extracts k records with the smallest integer values from a list of tuples.\n    Sorts by the integer value and returns the first k elements.\n    \"\"\"\n    if k <= 0 or not records:\n        return []\n\n    # Sort the records based on the integer value (second element)\n    sorted_records = sorted(records, key=lambda x: x[1])\n\n    # Select the first k elements from the sorted list\n    return sorted_records[:k]"}
