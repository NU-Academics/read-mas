{"task_id": "Mbpp/721", "solution": "```python\nclass Cell:\n    \"\"\"Represents an individual cell in the matrix with its coordinates and value.\"\"\"\n    def __init__(self, row: int, col: int, value: int):\n        self._row = row\n        self._col = col\n        self._value = value\n\n    def get_row(self) -> int:\n        \"\"\"Returns the row index.\"\"\"\n        return self._row\n\n    def get_col(self) -> int:\n        \"\"\"Returns the column index.\"\"\"\n        return self._col\n\n    def get_value(self) -> int:\n        \"\"\"Returns the cell's integer value.\"\"\"\n        return self._value\n\n\nclass Matrix:\n    \"\"\"Represents the square matrix, stores cells, and handles input validation.\"\"\"\n    def __init__(self, raw_matrix_data: list[list[int]]):\n        self._N = len(raw_matrix_data)\n        self._cells: list[list[Cell]] = []\n        for r_idx in range(self._N):\n            row_cells = []\n            for c_idx in range(self._N):\n                row_cells.append(Cell(r_idx, c_idx, raw_matrix_data[r_idx][c_idx]))\n            self._cells.append(row_cells)\n\n    def get_N(self) -> int:\n        \"\"\"Returns the dimension N.\"\"\"\n        return self._N\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        \"\"\"Returns the Cell object at the specified coordinates.\"\"\"\n        return self._cells[row][col]\n\n\nclass Path:\n    \"\"\"Represents a sequence of cells forming a path and calculates its metrics.\"\"\"\n    def __init__(self, cells_in_path: list[Cell]):\n        self._cells_in_path = list(cells_in_path)\n        self._total_cost = 0.0\n        self._number_of_cells = 0\n        self._average_value = 0.0\n        self.calculate_total_cost()\n        self.count_cells()\n        self.calculate_average()\n\n    def calculate_total_cost(self) -> float:\n        \"\"\"Calculates the sum of cell values in the path.\"\"\"\n        self._total_cost = sum(cell.get_value() for cell in self._cells_in_path)\n        return self._total_cost\n\n    def count_cells(self) -> int:\n        \"\"\"Counts the number of cells in the path.\"\"\"\n        self._number_of_cells = len(self._cells_in_path)\n        return self._number_of_cells\n\n    def calculate_average(self) -> float:\n        \"\"\"Calculates the average value (total cost / number of cells).\"\"\"\n        if self._number_of_cells > 0:\n            self._average_value = self._total_cost / self._number_of_cells\n        else:\n            self._average_value = 0.0\n        return self._average_value\n\n    def get_average_value(self) -> float:\n        \"\"\"Returns the calculated average value.\"\"\"\n        return self._average_value\n\n\nclass PathFinder:\n    \"\"\"Identifies all valid paths in a matrix and determines the maximum average among them.\"\"\"\n    def __init__(self, matrix: Matrix):\n        self._matrix = matrix\n        self._max_average = -1.0\n\n    def find_max_average_path(self) -> float:\n        \"\"\"Orchestrates path finding and returns the maximum average value.\"\"\"\n        all_paths: list[Path] = []\n        start_cell = self._matrix.get_cell(0, 0)\n        self._find_all_paths_recursive(0, 0, [start_cell], all_paths)\n\n        if not all_paths:\n            return 0.0\n\n        self._max_average = max(path.get_average_value() for path in all_paths)\n        return self._max_average\n\n    def _find_all_paths_recursive(self, current_row: int, current_col: int, current_path_cells: list[Cell], all_paths: list[Path]):\n        \"\"\"Private recursive helper to explore paths.\"\"\"\n        N = self._matrix.get_N()\n\n        # Base case: Reached the bottom-right cell\n        if current_row == N - 1 and current_col == N - 1:\n            all_paths.append(Path(current_path_cells))\n            return\n\n        # Move right\n        if current_col + 1 < N:\n            next_cell = self._matrix.get_cell(current_row, current_col + 1)\n            self._find_all_paths_recursive(current_row, current_col + 1, current_path_cells + [next_cell], all_paths)\n\n        # Move down\n        if current_row + 1 < N:\n            next_cell = self._matrix.get_cell(current_row + 1, current_col)\n            self._find_all_paths_recursive(current_row + 1, current_col, current_path_cells + [next_cell], all_paths)\n\n\ndef maxAverageOfPath(matrix: list[list[int]]) -> float:\n    \"\"\"Calculates the maximum average path value in a given square matrix.\n    Paths move only right or down from top-left to bottom-right.\"\"\"\n    matrix_obj = Matrix(matrix)\n    path_finder = PathFinder(matrix_obj)\n    return path_finder.find_max_average_path()\n```"}
