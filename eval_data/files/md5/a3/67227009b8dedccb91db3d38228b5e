{"task_id": "Mbpp/123", "solution": "```python\ndef _get_proper_divisors(n: int) -> list[int]:\n    \"\"\"\n    Calculates the proper divisors of an integer n.\n    Proper divisors include all positive divisors of n except n itself.\n    \"\"\"\n    if n == 1:\n        return []\n    divisors = [1]  # 1 is always a proper divisor for n > 1\n    i = 2\n    # Iterate up to the square root of n\n    while i * i <= n:\n        if n % i == 0:\n            divisors.append(i)\n            if i * i != n:  # Avoid adding the same divisor twice for perfect squares\n                divisors.append(n // i)\n        i += 1\n    return divisors\n\ndef _calculate_sum_of_proper_divisors(n: int) -> int:\n    \"\"\"\n    Calculates the sum of proper divisors for a given integer n.\n    This function uses _get_proper_divisors to find and sum them.\n    \"\"\"\n    return sum(_get_proper_divisors(n))\n\ndef amicable_numbers_sum(upperLimit: int) -> int:\n    \"\"\"\n    Calculates the sum of all amicable numbers up to the upperLimit.\n    It identifies amicable pairs and sums them, avoiding double-counting.\n    \"\"\"\n    total_sum = 0\n    visited_numbers = set()\n\n    for n in range(1, upperLimit + 1):\n        if n in visited_numbers:\n            continue\n\n        sum_div_n = _calculate_sum_of_proper_divisors(n)\n\n        # Check if sum_div_n could be the pair's other number.\n        # It must be distinct from n, and within the upperLimit.\n        if sum_div_n > n and sum_div_n <= upperLimit:\n            sum_div_m = _calculate_sum_of_proper_divisors(sum_div_n)\n\n            # Confirm an amicable pair (m == n)\n            if sum_div_m == n:\n                total_sum += n + sum_div_n\n                visited_numbers.add(n)\n                visited_numbers.add(sum_div_n)\n\n    return total_sum\n```"}
{"task_id": "Mbpp/123", "solution": "```python\ndef sum_proper_divisors(n: int) -> int:\n    \"\"\"Calculates the sum of all positive divisors of n, excluding n itself.\n    Returns 0 if n is 1, as 1 has no proper divisors less than itself.\n    \"\"\"\n    if n == 1:\n        return 0\n    divisor_sum = 1\n    # Iterate from 2 up to the square root of n (inclusive)\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            divisor_sum += i\n            # If n/i is not i, then n/i is another distinct divisor\n            if n // i != i:\n                divisor_sum += n // i\n    return divisor_sum\n\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"Calculates the sum of all amicable numbers 'a' such that 1 <= a <= limit.\n    Uses a helper function to find proper divisors and a set to track found pairs.\n    \"\"\"\n    total_sum = 0\n    found_amicable_numbers = set()\n\n    for a in range(1, limit + 1):\n        if a in found_amicable_numbers:\n            continue\n\n        b = sum_proper_divisors(a)\n\n        # Check conditions for an amicable pair (a, b)\n        if b > a and b <= limit:  # b must be distinct from a and within limit\n            sum_divisors_b = sum_proper_divisors(b)\n            if sum_divisors_b == a:\n                # Found an amicable pair (a, b)\n                total_sum += a\n                total_sum += b\n                found_amicable_numbers.add(a)\n                found_amicable_numbers.add(b)\n    return total_sum\n```"}
{"task_id": "Mbpp/124", "solution": "```python\nimport math\n\ndef angle_complex(real_part, imaginary_part):\n    \"\"\"\n    Calculates the angle (argument) of a complex number.\n\n    Args:\n        real_part: The real part of the complex number.\n        imaginary_part: The imaginary part of the complex number.\n                        Can be a float or a complex number (e.g., 1j).\n\n    Returns:\n        The angle of the complex number in radians.\n    \"\"\"\n    # Extract the imaginary component if imaginary_part is a complex number\n    if isinstance(imaginary_part, complex):\n        y = imaginary_part.imag\n    else:\n        y = imaginary_part\n\n    x = real_part\n\n    return math.atan2(y, x)\n```"}
