{"task_id": "Mbpp/778", "solution": "```python\ndef pack_consecutive_duplicates(input_list):\n    \"\"\"\n    Packs consecutive identical elements from a list into sublists.\n    Non-consecutive elements are placed into their own single-element sublists.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result_list = []\n    current_sublist = []\n\n    for element in input_list:\n        if not current_sublist or element == current_sublist[-1]:\n            current_sublist.append(element)\n        else:\n            result_list.append(current_sublist)\n            current_sublist = [element]\n\n    if current_sublist: # Add the last accumulated sublist\n        result_list.append(current_sublist)\n\n    return result_list\n```"}
{"task_id": "Mbpp/778", "solution": "```python\nfrom typing import Any, List\n\ndef pack_consecutive_duplicates(input_list: List[Any]) -> List[List[Any]]:\n    \"\"\"\n    Groups consecutive identical elements from a list into sublists.\n    Maintains the original relative order of elements and their groups.\n    \"\"\"\n    if not input_list:\n        return []\n\n    packed_list: List[List[Any]] = []\n    current_sublist: List[Any] = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        current_element = input_list[i]\n        if current_element == current_sublist[-1]:\n            current_sublist.append(current_element)\n        else:\n            packed_list.append(current_sublist)\n            current_sublist = [current_element]\n\n    # Append the last current_sublist after the loop finishes\n    packed_list.append(current_sublist)\n    return packed_list\n```"}
{"task_id": "Mbpp/782", "solution": "```python\ndef odd_length_sum(arr):\n    \"\"\"Calculates the sum of all odd length subarrays.\n    This involves iterating through all possible subarrays and summing those with an odd length.\"\"\"\n    total_sum = 0\n    n = len(arr)\n    for i in range(n):\n        for j in range(i, n):\n            # Calculate the length of the current subarray arr[i...j]\n            length = j - i + 1\n            if length % 2 != 0:\n                # If the length is odd, sum its elements and add to total_sum\n                current_subarray_sum = sum(arr[i : j + 1])\n                total_sum += current_subarray_sum\n    return total_sum\n```"}
{"task_id": "Mbpp/780", "solution": "```python\nimport itertools\n\ndef find_combinations(input_tuples: list[tuple[int, int]]) -> list[tuple[int, int]]:\n    \"\"\"\n    Calculates unique element-wise sum combinations from unique pairs of input tuples.\n    It uses itertools.combinations for efficient pair generation and a set for uniqueness.\n    \"\"\"\n    unique_sum_tuples = set()\n    for tuple1, tuple2 in itertools.combinations(input_tuples, 2):\n        sum_tuple = (tuple1[0] + tuple2[0], tuple1[1] + tuple2[1])\n        unique_sum_tuples.add(sum_tuple)\n    return list(unique_sum_tuples)\n```"}
{"task_id": "Mbpp/781", "solution": "```python\ndef count_divisors(number: int) -> bool:\n    \"\"\"Checks if the total count of positive divisors for a given positive integer is even or odd.\n    Returns True if the count is even, False otherwise.\"\"\"\n    divisor_count = 0\n    # Iterate from 1 up to the integer part of the square root of the number, inclusive.\n    for d in range(1, int(number**0.5) + 1):\n        if number % d == 0:\n            divisor_count += 1\n            # If d*d is not equal to number, then (number / d) is a distinct divisor.\n            if d * d != number:\n                divisor_count += 1\n    # The count of divisors is even if it is divisible by 2.\n    return divisor_count % 2 == 0\n```"}
{"task_id": "Mbpp/782", "solution": "```python\nfrom typing import List\n\ndef odd_length_sum(input_list: List[int]) -> int:\n    \"\"\"Calculates the sum of all odd-length subarrays within the given list of integers.\n    It iterates through all possible subarrays, checks their length, and sums elements of odd-length ones.\"\"\"\n    total_sum = 0\n    n = len(input_list)\n\n    for i in range(n):\n        for j in range(i, n):\n            # Extract the current subarray\n            sub_array = input_list[i : j + 1]\n\n            # Check if the subarray's length is odd\n            if len(sub_array) % 2 != 0:\n                # Add the sum of its elements to the total sum\n                total_sum += sum(sub_array)\n    return total_sum\n```"}
{"task_id": "Mbpp/780", "solution": "```python\ndef find_combinations(input_list: list[tuple[int, int]]) -> list[tuple[int, int]]:\n    \"\"\"\n    Calculates the sum of corresponding elements of two distinct tuples from the input list.\n    Returns a list of tuples, where each inner tuple is the sum of corresponding elements.\n    \"\"\"\n    result = []\n    n = len(input_list)\n    for i in range(n - 1):\n        tuple1 = input_list[i]\n        for j in range(i + 1, n):\n            tuple2 = input_list[j]\n            sum1 = tuple1[0] + tuple2[0]\n            sum2 = tuple1[1] + tuple2[1]\n            result.append((sum1, sum2))\n    return result\n```"}
