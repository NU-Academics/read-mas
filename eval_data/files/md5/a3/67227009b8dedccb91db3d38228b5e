{"task_id": "Mbpp/265", "solution": "```python\ndef list_split(input_list, n):\n    \"\"\"\n    Splits a list into `n` sub-lists based on element index modulo `n`.\n    Handles edge cases like empty inputs or non-positive `n`.\n    \"\"\"\n    if n <= 0 or not input_list:\n        return []\n\n    result = [[] for _ in range(n)]\n    for i, element in enumerate(input_list):\n        target_sublist_index = i % n\n        result[target_sublist_index].append(element)\n\n    return result\n```\n"}
{"task_id": "Mbpp/261", "solution": "def division_elements(tuple1, tuple2):\n    \"\"\"Performs element-wise division on two tuples, validating inputs for length, numeric types, and division by zero.\n    Returns a new tuple with the results or raises appropriate errors.\"\"\"\n\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Tuples must have the same length.\")\n\n    results = []\n    for dividend, divisor in zip(tuple1, tuple2):\n        if not isinstance(dividend, (int, float)) or not isinstance(divisor, (int, float)):\n            raise ValueError(\"All tuple elements must be numeric.\")\n\n        if divisor == 0:\n            raise ZeroDivisionError(\"Cannot divide by zero.\")\n\n        results.append(dividend // divisor)\n\n    return tuple(results)"}
{"task_id": "Mbpp/264", "solution": "def dog_age(human_age: int) -> int:\n    \"\"\"Calculates a dog's age in dog's years based on its human age using a specific rule.\n    The first two human years count as 10.5 dog years each, and subsequent years count as 4 dog years each.\"\"\"\n    if human_age <= 0:\n        return 0\n    elif human_age <= 2:\n        return int(human_age * 10.5)\n    else:\n        return int(2 * 10.5 + (human_age - 2) * 4)"}
{"task_id": "Mbpp/260", "solution": "def _is_prime(number: int) -> bool:\n    \"\"\"\n    Determines if a given integer is a prime number using optimized trial division.\n    It efficiently checks for divisibility up to the square root of the number.\n    \"\"\"\n    if number <= 1:\n        return False\n    if number <= 3:\n        return True\n    if number % 2 == 0 or number % 3 == 0:\n        return False\n    i = 5\n    while i * i <= number:\n        if number % i == 0 or number % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef _generate_next_nsw_number(s_prev1: int, s_prev2: int) -> int:\n    \"\"\"\n    Calculates the next Newman-Shanks-Williams number using its recurrence relation.\n    It takes the two preceding numbers in the sequence to compute the next one.\n    \"\"\"\n    s_current = 2 * s_prev1 + s_prev2\n    return s_current\n\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Orchestrates the search for and returns the nth Newman-Shanks-Williams (NSW) prime number.\n    It iteratively generates NSW numbers and tests their primality until the nth is found.\n    \"\"\"\n    # Handle base cases for the first three NSW primes as per design specification\n    if n == 1:\n        return 3  # S_2 is the 1st NSW prime\n    if n == 2:\n        return 7  # S_3 is the 2nd NSW prime\n    if n == 3:\n        return 17 # S_4 is the 3rd NSW prime\n\n    # For n > 3, initialize counters and previous NSW numbers\n    # The first three NSW primes (3, 7, 17) correspond to n=1, 2, 3 respectively.\n    prime_count = 3\n    # Initialize s_prev2 as S_3 and s_prev1 as S_4 to continue the sequence from S_5\n    s_prev2 = 7  # Corresponds to S_3\n    s_prev1 = 17 # Corresponds to S_4\n\n    # Loop indefinitely to find the nth NSW prime for n > 3\n    while True:\n        s_current = _generate_next_nsw_number(s_prev1, s_prev2)\n\n        if _is_prime(s_current):\n            prime_count += 1\n            if prime_count == n:\n                return s_current\n\n        # Update s_prev2 and s_prev1 for the next iteration of the recurrence\n        s_prev2 = s_prev1\n        s_prev1 = s_current"}
{"task_id": "Mbpp/265", "solution": "```python\ndef list_split(input_list: list, n: int) -> list[list]:\n    \"\"\"Splits an input list into `n` sublists, distributing elements based on their original index modulo `n`.\"\"\"\n    result_lists = [[] for _ in range(n)]\n    for i, element in enumerate(input_list):\n        target_sublist_index = i % n\n        result_lists[target_sublist_index].append(element)\n    return result_lists\n```\n"}
