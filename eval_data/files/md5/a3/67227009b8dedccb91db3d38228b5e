{"task_id": "Mbpp/129", "solution": "```python\nfrom typing import List\n\nclass Matrix:\n    \"\"\"\n    Encapsulates matrix data and provides methods for calculating sums and checking properties.\n    \"\"\"\n    def __init__(self, elements: List[List[int]]):\n        self._elements = elements\n        self._size = len(elements) if elements else 0\n\n    def is_square(self) -> bool:\n        \"\"\"Checks if the encapsulated matrix is square.\"\"\"\n        if not self._elements:\n            return False\n\n        num_rows = len(self._elements)\n        num_cols = len(self._elements[0])\n\n        if num_rows != num_cols:\n            return False\n\n        for row in self._elements:\n            if len(row) != num_cols:\n                return False\n        return True\n\n    def get_size(self) -> int:\n        \"\"\"Returns the size (number of rows/columns) of the square matrix.\"\"\"\n        return self._size\n\n    def calculate_row_sum(self, rowIndex: int) -> int:\n        \"\"\"Calculates the sum of elements in a specific row.\"\"\"\n        return sum(self._elements[rowIndex])\n\n    def calculate_column_sum(self, colIndex: int) -> int:\n        \"\"\"Calculates the sum of elements in a specific column.\"\"\"\n        col_sum = 0\n        for i in range(self._size):\n            col_sum += self._elements[i][colIndex]\n        return col_sum\n\n    def calculate_main_diagonal_sum(self) -> int:\n        \"\"\"Calculates the sum of elements in the main diagonal.\"\"\"\n        main_diag_sum = 0\n        for i in range(self._size):\n            main_diag_sum += self._elements[i][i]\n        return main_diag_sum\n\n    def calculate_anti_diagonal_sum(self) -> int:\n        \"\"\"Calculates the sum of elements in the anti-diagonal.\"\"\"\n        anti_diag_sum = 0\n        for i in range(self._size):\n            anti_diag_sum += self._elements[i][self._size - 1 - i]\n        return anti_diag_sum\n\ndef magic_square_test(matrix: List[List[int]]) -> bool:\n    \"\"\"\n    Determines if the input matrix is a magic square.\n    It checks row, column, and diagonal sums for equality.\n    \"\"\"\n    matrix_obj = Matrix(matrix)\n\n    if not matrix_obj.is_square():\n        return False\n\n    size = matrix_obj.get_size()\n    expected_sum = matrix_obj.calculate_row_sum(0)\n\n    for i in range(size):\n        if matrix_obj.calculate_row_sum(i) != expected_sum:\n            return False\n\n    for i in range(size):\n        if matrix_obj.calculate_column_sum(i) != expected_sum:\n            return False\n\n    if matrix_obj.calculate_main_diagonal_sum() != expected_sum:\n        return False\n\n    if matrix_obj.calculate_anti_diagonal_sum() != expected_sum:\n        return False\n\n    return True\n```"}
{"task_id": "Mbpp/129", "solution": "```python\ndef magic_square_test(matrix):\n    \"\"\"\n    Determines if a given square matrix is a magic square.\n    A magic square has equal sums for all rows, columns, and both main diagonals.\n    \"\"\"\n    num_rows = len(matrix)\n    if num_rows == 0:\n        return False\n\n    num_cols = len(matrix[0])\n\n    if num_rows != num_cols:\n        return False\n\n    size = num_rows\n\n    # Calculate the magic sum from the first row\n    magic_sum = sum(matrix[0])\n\n    # Check row sums\n    for r_idx in range(size):\n        if sum(matrix[r_idx]) != magic_sum:\n            return False\n\n    # Check column sums\n    for c_idx in range(size):\n        current_column_sum = 0\n        for r_idx in range(size):\n            current_column_sum += matrix[r_idx][c_idx]\n        if current_column_sum != magic_sum:\n            return False\n\n    # Check main diagonal sum\n    main_diagonal_sum = 0\n    for i in range(size):\n        main_diagonal_sum += matrix[i][i]\n    if main_diagonal_sum != magic_sum:\n        return False\n\n    # Check anti-diagonal sum\n    anti_diagonal_sum = 0\n    for i in range(size):\n        anti_diagonal_sum += matrix[i][size - 1 - i]\n    if anti_diagonal_sum != magic_sum:\n        return False\n\n    return True\n```"}
{"task_id": "Mbpp/130", "solution": "```python\ndef max_occurrences(input_list):\n    \"\"\"\n    Identifies the item with the highest frequency in a given list.\n    It returns the first such item encountered if multiple items share the maximum frequency.\n    \"\"\"\n    counts = {}\n    for item in input_list:\n        counts[item] = counts.get(item, 0) + 1\n\n    max_freq_item = None\n    max_freq = -1\n\n    for item, count in counts.items():\n        if count > max_freq:\n            max_freq = count\n            max_freq_item = item\n\n    return max_freq_item\n```"}
{"task_id": "Mbpp/130", "solution": "```python\ndef max_occurrences(input_list: list):\n    \"\"\"\n    Finds the item with the maximum frequency in a list, returning None for an empty list.\n    If there's a tie, the item encountered first that achieves that maximum frequency is returned.\n    \"\"\"\n    if not input_list:\n        return None\n\n    counts = {}\n    max_freq = 0\n    max_item = None\n\n    for item in input_list:\n        counts[item] = counts.get(item, 0) + 1\n        current_freq = counts[item]\n\n        # Update max_item only if a new higher frequency is found.\n        # This preserves the \"first encountered\" tie-breaking rule.\n        if current_freq > max_freq:\n            max_freq = current_freq\n            max_item = item\n\n    return max_item\n```"}
