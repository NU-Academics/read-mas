{"task_id": "Mbpp/631", "solution": "def replaceCharacters(inputString: str) -> str:\n    \"\"\"Replaces all whitespace characters with underscores and all underscore characters with single spaces in a given string.\"\"\"\n    # First, replace all whitespace characters with underscores\n    # This handles various whitespace types (space, tab, newline, etc.)\n    temp_string = ''\n    for char in inputString:\n        if char.isspace():\n            temp_string += '_'\n        else:\n            temp_string += char\n\n    # Then, replace all underscore characters with single spaces\n    modified_string = ''\n    for char in temp_string:\n        if char == '_':\n            modified_string += ' '\n        else:\n            modified_string += char\n\n    return modified_string"}
{"task_id": "Mbpp/631", "solution": "```python\nimport re\n\n\ndef replace_spaces(input_string: str) -> str:\n    \"\"\"\n    Transforms a string by replacing whitespace with underscores and vice-versa.\n    Uses a temporary placeholder to ensure correct bidirectional swapping.\n    \"\"\"\n    # A unique placeholder character unlikely to be present in typical input strings.\n    # Using a control character (\\x01 - Start of Header) for this purpose.\n    PLACEHOLDER = \"\\x01\"\n\n    # First, replace all whitespace characters (space, tab, newline, etc.)\n    # with the temporary placeholder.\n    temp_str = re.sub(r'\\s', PLACEHOLDER, input_string)\n\n    # Next, replace all underscore characters with a single space.\n    temp_str = temp_str.replace('_', ' ')\n\n    # Finally, replace the temporary placeholder characters with underscores.\n    modified_string = temp_str.replace(PLACEHOLDER, '_')\n\n    return modified_string\n```"}
{"task_id": "Mbpp/603", "solution": "```python\ndef get_ludic(n: int) -> list[int]:\n    \"\"\"\n    Calculates all Ludic numbers less than or equal to n.\n    This implementation uses a sieve-like process on a dynamically shrinking list.\n    \"\"\"\n    if n < 1:\n        return []\n\n    # `candidates` list contains all numbers currently \"in play\".\n    # Initialize with numbers from 1 to n.\n    candidates = list(range(1, n + 1))\n    ludic_numbers = []\n\n    # `idx_of_next_ludic` tracks the index in `candidates` that will yield the next Ludic number.\n    idx_of_next_ludic = 0\n\n    while idx_of_next_ludic < len(candidates):\n        ludic_val = candidates[idx_of_next_ludic]\n        ludic_numbers.append(ludic_val)\n\n        # The number 1 is Ludic but does not sieve other numbers.\n        # Sieving starts with 2.\n        if ludic_val == 1:\n            idx_of_next_ludic += 1 # Move to the next candidate\n            continue\n\n        # Sieving step: remove every `ludic_val`-th element from the *remaining* sequence.\n        # This requires building a new list, as list deletions are inefficient.\n        new_candidates = []\n\n        # Preserve elements before the current Ludic number's position.\n        for i in range(idx_of_next_ludic):\n            new_candidates.append(candidates[i])\n\n        # Process elements *after* the current Ludic number for sieving.\n        count_for_sieving = 0\n        for i in range(idx_of_next_ludic + 1, len(candidates)):\n            count_for_sieving += 1\n            if count_for_sieving % ludic_val != 0:\n                new_candidates.append(candidates[i])\n\n        candidates = new_candidates\n\n        # `idx_of_next_ludic` stays the same; it points to the position in `candidates`\n        # where the last `ludic_val` was found, which now holds the next candidate.\n\n    return ludic_numbers\n```"}
{"task_id": "Mbpp/630", "solution": "```python\ndef get_coordinates(coordinate: tuple[int, int]) -> list[list[int, int]]:\n    \"\"\"\n    Calculates all 9 adjacent coordinates (including itself) for a given 2D coordinate.\n    Returns a list of lists, where each inner list represents an adjacent coordinate [x', y'].\n    \"\"\"\n    x, y = coordinate\n    x_coords = [x - 1, x, x + 1]\n    y_coords = [y - 1, y, y + 1]\n\n    adjacent_coordinates = []\n    for current_x in x_coords:\n        for current_y in y_coords:\n            adjacent_coordinates.append([current_x, current_y])\n\n    return adjacent_coordinates\n```"}
