{"task_id": "Mbpp/260", "solution": "def is_prime(num: int) -> bool:\n    \"\"\"Checks if a number is prime using trial division.\"\"\"\n    if num <= 1:\n        return False\n    if num <= 3:\n        return True\n    if num % 2 == 0 or num % 3 == 0:\n        return False\n    i = 5\n    while i * i <= num:\n        if num % i == 0 or num % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef calculate_nsw_sequence_term(n: int) -> int:\n    \"\"\"Calculates the nth term of the Newman-Shanks-Williams sequence.\"\"\"\n    if n == 0:\n        return 1\n    if n == 1:\n        return 1\n    s_prev2 = 1  # S_0\n    s_prev1 = 1  # S_1\n    for _ in range(2, n + 1):\n        s_current = 2 * s_prev1 + s_prev2\n        s_prev2 = s_prev1\n        s_prev1 = s_current\n    return s_prev1\n\ndef newman_prime(n: int) -> int | None:\n    \"\"\"Calculates the nth Newman-Shanks-Williams prime number.\"\"\"\n    s_n = calculate_nsw_sequence_term(n)\n    if is_prime(s_n):\n        return s_n\n    return None"}
