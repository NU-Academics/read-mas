{"task_id": "Mbpp/162", "solution": "```python\ndef sum_series(n: int) -> int:\n    \"\"\"Calculates the sum (n - 2*i) for i=0 to n // 2,\n    including only terms strictly greater than 0.\n    \"\"\"\n    total_sum = 0\n    # Iterate from i=0 up to n // 2, inclusive.\n    for i in range(n // 2 + 1):\n        term = n - (2 * i)\n        if term > 0:\n            total_sum += term\n    return total_sum\n```"}
{"task_id": "Mbpp/160", "solution": "```python\ndef _extended_gcd(a: int, b: int) -> tuple[int, int, int]:\n    \"\"\"\n    Computes gcd(a, b) and Bezout coefficients x, y such that ax + by = gcd(a, b).\n    This function implements the Extended Euclidean Algorithm recursively.\n    \"\"\"\n    if b == 0:\n        return (a, 1, 0)\n    else:\n        g, x1, y1 = _extended_gcd(b, a % b)\n        x = y1\n        y = x1 - (a // b) * y1\n        return (g, x, y)\n\ndef find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Finds an integer solution (x, y) for the linear Diophantine equation ax + by = n.\n    Returns (x, y) if a solution exists, otherwise returns None.\n    \"\"\"\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n    elif a == 0:\n        return (0, n // b) if n % b == 0 else None\n    elif b == 0:\n        return (n // a, 0) if n % a == 0 else None\n    else:\n        g, x0, y0 = _extended_gcd(a, b)\n        if n % g != 0:\n            return None\n        k = n // g\n        return (x0 * k, y0 * k)\n```\n"}
{"task_id": "Mbpp/162", "solution": "```python\ndef sum_series(n: int) -> int:\n    \"\"\"Calculates the sum of the series (n - 2*i) for i from 0 up to n // 2.\n    This implementation uses an optimized arithmetic series formula for efficiency.\"\"\"\n    k = n // 2\n    return (k + 1) * (n - k)\n```"}
{"task_id": "Mbpp/165", "solution": "def _get_alphabetical_position(char_value: str) -> int:\n    \"\"\"\n    Determines the 1-based alphabetical position of a character, handling case-insensitivity.\n    Returns 0 if the character is not an English alphabet letter.\n    \"\"\"\n    char_lower = char_value.lower()\n    if 'a' <= char_lower <= 'z':\n        return ord(char_lower) - ord('a') + 1\n    return 0\n\ndef count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in a string whose 1-based string index matches their 1-based alphabetical position.\n    This function processes the input string character by character to find matches.\n    \"\"\"\n    count = 0\n    for i, char in enumerate(input_string):\n        string_index = i + 1\n        alphabetical_position = _get_alphabetical_position(char)\n\n        if alphabetical_position > 0 and string_index == alphabetical_position:\n            count += 1\n    return count"}
{"task_id": "Mbpp/166", "solution": "```python\ndef find_even_pair(numbers: list[int]) -> int:\n    \"\"\"\n    Counts pairs of integers in a list that XOR to an even number.\n    An XOR sum is even if both integers have the same parity (both even or both odd).\n    \"\"\"\n    count_even = 0\n    count_odd = 0\n\n    for num in numbers:\n        if num % 2 == 0:\n            count_even += 1\n        else:\n            count_odd += 1\n\n    # Calculate pairs from even numbers: nC2 = n * (n - 1) // 2\n    pairs_even = count_even * (count_even - 1) // 2\n    # Calculate pairs from odd numbers: nC2 = n * (n - 1) // 2\n    pairs_odd = count_odd * (count_odd - 1) // 2\n\n    return pairs_even + pairs_odd\n```\n"}
{"task_id": "Mbpp/167", "solution": "```python\ndef next_power_of_2(n: int) -> int:\n    \"\"\"\n    Calculates the smallest power of 2 greater than or equal to n.\n    Handles the edge case where n is 0, returning 1.\n    \"\"\"\n    if n == 0:\n        return 1\n    p = 1\n    while p < n:\n        p <<= 1\n    return p\n```"}
{"task_id": "Mbpp/166", "solution": "```python\ndef _is_even(number: int) -> bool:\n    \"\"\"Checks if a given integer is even.\n    Returns True if the number is even, False otherwise.\"\"\"\n    return number % 2 == 0\n\ndef _generate_unique_pairs(numbers: list[int]) -> list[tuple[int, int]]:\n    \"\"\"Generates all unique pairs of integers from the input list.\n    Each pair (a, b) is generated once, without its reverse (b, a).\"\"\"\n    pairs = []\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            pairs.append((numbers[i], numbers[j]))\n    return pairs\n\ndef find_even_pair(numbers: list[int]) -> int:\n    \"\"\"Counts pairs of integers in a list that XOR to an even number.\n    Orchestrates pair generation, XOR calculation, and evenness checks.\"\"\"\n    if len(numbers) < 2:\n        return 0\n\n    even_pair_count = 0\n    unique_pairs = _generate_unique_pairs(numbers)\n\n    for num1, num2 in unique_pairs:\n        xor_result = num1 ^ num2\n        if _is_even(xor_result):\n            even_pair_count += 1\n\n    return even_pair_count\n```"}
