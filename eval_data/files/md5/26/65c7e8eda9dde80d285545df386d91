ise ``TypeError``.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(f\"is_Even expects an integer, got {type(n).__name__}\")\n    return n % 2 == 0"}
{"task_id": "Mbpp/602", "solution": "from typing import Optional\n\ndef find_first_repeated_character(text: str) -> Optional[str]:\n    \"\"\"Return the first character that appears more than once in ``text``.\n\n    The function scans ``text`` from left to right and keeps a set of\n    characters that have been seen.  When a character is encountered that\n    is already in the set, it is returned immediately.  If the loop\n    finishes without finding a duplicate, ``None`` is returned.\n\n    Parameters\n    ----------\n    text : str\n        The string to search for repeated characters.\n\n    Returns\n    -------\n    Optional[str]\n        The first repeated character in order of appearance, or ``None``\n        if no character repeats.\n    \"\"\"\n    seen = set()\n    for ch in text:\n        if ch in seen:\n            return ch\n        seen.add(ch)\n    return None"}
{"task_id": "Mbpp/603", "solution": "def get_ludic(n: int) -> list[int]:\n    \"\"\"\n    Return a list of all Lucas (Lucid) numbers less than or equal to `n`.\n\n    The Lucas sequence is defined as:\n        L\u2080 = 2\n        L\u2081 = 1\n        L\u2099 = L\u2099\u208b\u2081 + L\u2099\u208b\u2082  for n \u2265 2\n\n    Parameters\n    ----------\n    n : int\n        Non\u2011negative integer specifying the upper bound (inclusive).\n\n    Returns\n    -------\n    list[int]\n        Ordered list of Lucas numbers \u2264 n.\n\n    Raises\n    ------\n    ValueError\n        If `n` is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non\u2011negative\")\n\n    # The smallest Lucas number is 2; if n < 2 no numbers are returned.\n    if n < 1:  # covers n == 0\n        return []\n\n    result: list[int] = []\n\n    l_prev_prev = 2  # L\u2080\n    l_prev = 1      # L\u2081\n\n    if l_prev_prev <= n:\n        result.append(l_prev_prev)\n    if l_prev <= n:\n        result.append(l_prev)\n\n    while True:\n        l_next = l_prev + l_prev_prev\n        if l_next > n:\n            break\n        result.append(l_next)\n        l_prev_prev, l_prev = l_prev, l_next\n\n    return result"}
{"task_id": "Mbpp/604", "solution": "import re\nfrom typing import List\n\n__all__ = [\"reverse_words\"]\n\ndef reverse_words(s: str) -> str:\n    \"\"\"\n    Reverse the order of words in *s* while preserving all whitespace.\n\n    A word is defined as a maximal sequence of non\u2011space characters.\n    Consecutive spaces are treated as a single separator but are preserved\n    in the output exactly as they appear in the input.\n\n    Parameters\n    ----------\n    s : str\n        The input string to process.\n\n    Returns\n    -------\n    str\n        The input string with the order of words reversed.\n\n    Raises\n    ------\n    TypeError\n        If *s* is not of type `str`.\n\n    Examples\n    --------\n    >>> reverse_words(\"hello world\")\n    'world hello'\n    >>> reverse_words(\"  a  b  \")\n    '  b  a  '\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(f\"reverse_words expects a string, got {type(s).__name__}\")\n\n    # Edge cases: empty string or only whitespace\n    if not s or s.isspace():\n        return s\n\n    words = _split_words_preserve_spaces(s)\n    reversed_words = words[::-1]\n    return \"\".join(reversed_words)\n\ndef _split_words_preserve_spaces(s: str) -> List[str]:\n    \"\"\"\n    Split *s* into a list where every element is either a word or a\n    sequence of spaces. This ensures that joining the list back\n    reproduces the exact spacing.\n\n    Parameters\n    ----------\n    s : str\n        Input string.\n\n    Returns\n    -------\n    List[str]\n        Interleaved list of words and spaces.\n    \"\"\"\n    # Regular expression that captures words or spaces.\n    pattern = r\"(\\S+|\\s+)\"\n    return re.findall(pattern, s)"}
{"task_id": "Mbpp/605", "solution": "import math\n\ndef prime_num(n: int) -> bool:\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer\")\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0:\n        return False\n    limit = math.isqrt(n)\n    for i in range(3, limit + 1, 2):\n        if n % i == 0:\n            return False\n    return True"}
