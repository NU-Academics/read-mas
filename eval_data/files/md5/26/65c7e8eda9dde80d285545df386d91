{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(source: str, filter: str) -> str:\n    \"\"\"\n    Remove all characters from `source` that appear in `filter`.\n\n    Parameters\n    ----------\n    source : str\n        The string to cleanse.\n    filter : str\n        The string containing characters to be removed from `source`.\n\n    Returns\n    -------\n    str\n        The cleaned string with all filter characters omitted.\n\n    Raises\n    ------\n    TypeError\n        If either `source` or `filter` is not a string.\n    \"\"\"\n    if not isinstance(source, str):\n        raise TypeError(f\"source must be a str, got {type(source).__name__}\")\n    if not isinstance(filter, str):\n        raise TypeError(f\"filter must be a str, got {type(filter).__name__}\")\n\n    filter_set = set(filter)\n    result_chars = [c for c in source if c not in filter_set]\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/19", "solution": "from typing import Iterable, TypeVar, Set\n\nT = TypeVar(\"T\")\n\ndef test_duplicate(array: Iterable[T]) -> bool:\n    \"\"\"\n    Determine whether the given iterable contains duplicate elements.\n\n    Parameters\n    ----------\n    array : Iterable[T]\n        An iterable of hashable items to examine for duplicates.\n\n    Returns\n    -------\n    bool\n        True if any element appears more than once in the iterable;\n        False otherwise.\n\n    Examples\n    --------\n    >>> test_duplicate([1, 2, 3, 4])\n    False\n    >>> test_duplicate([1, 2, 3, 2])\n    True\n    >>> test_duplicate(('a', 'b', 'c'))\n    False\n    >>> test_duplicate(('a', 'b', 'a'))\n    True\n    \"\"\"\n    seen: Set[T] = set()\n    for item in array:\n        if item in seen:\n            return True\n        seen.add(item)\n    return False"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(num: int) -> bool:\n    \"\"\"\n    Determines whether `num` is a Woodall number (n * 2^n - 1 for some n >= 1).\n\n    Parameters:\n        num (int): The number to test.\n\n    Returns:\n        bool: True if `num` is a Woodall number, False otherwise.\n\n    Raises:\n        ValueError: If `num` is not an integer.\n    \"\"\"\n    if not isinstance(num, int):\n        raise ValueError(\"Input must be an integer.\")\n    if num < 1:\n        return False\n\n    n = 1\n    woodall = n * (1 << n) - 1\n    while woodall < num:\n        n += 1\n        woodall = n * (1 << n) - 1\n    return woodall == num"}
{"task_id": "Mbpp/56", "solution": "```python\n\"\"\"\nreverse_check.py\n\nProvides two pure functions:\n\n- reverse(n: int) -> int\n    Reverses the decimal representation of a non\u2011negative integer.\n\n- check(n: int) -> bool\n    Determines whether n satisfies the relation:\n        n == 2 * reverse(n) - 1\n\nBoth functions are fully type\u2011annotated and documented.\n\"\"\"\n\n__all__ = [\"reverse\", \"check\"]\n\n\ndef reverse(n: int) -> int:\n    \"\"\"\n    Reverse the decimal digits of a non\u2011negative integer.\n\n    Leading zeros in the reversed representation are discarded automatically\n    by the integer conversion.\n\n    Parameters\n    ----------\n    n : int\n        The integer to reverse. Must be non\u2011negative; negative values are\n        interpreted by the caller (check) as an error condition.\n\n    Returns\n    -------\n    int\n        The integer formed by reversing the decimal digits of `n`.\n\n    Examples\n    --------\n    >>> reverse(123)\n    321\n    >>> reverse(0)\n    0\n    >>> reverse(100)\n    1\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"reverse() expects a non-negative integer\")\n    # String conversion is O(d) in time and space, which satisfies the\n    # performance and memory constraints for this problem.\n    return int(str(n)[::-1])\n\n\ndef check(n: int) -> bool:\n    \"\"\"\n    Determine if an integer satisfies the relation n == 2 * reverse(n) - 1.\n\n    Parameters\n    ----------\n    n : int\n        Integer to test. Negative values are considered invalid for the\n        relation and result in False. Non\u2011int inputs raise TypeError.\n\n    Returns\n    -------\n    bool\n        True if the relation holds, False otherwise.\n\n    Raises\n    ------\n    TypeError\n        If the input is not of type int.\n\n    Examples\n    --------\n    >>> check(21)\n    False\n    >>> check(23)\n    False\n    >>> check(0)\n    False\n    >>> check(-5)\n    False\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(f\"check() expected int, got {type(n).__name__}\")\n    if n < 0:\n        return False\n    rev = reverse(n)\n    return n == 2 * rev - 1\n```"}
{"task_id": "Mbpp/57", "solution": "from typing import List\n\n__all__ = [\"find_Max_Num\"]\n\n\ndef find_Max_Num(digits: List[int]) -> int:\n    \"\"\"\n    Return the largest integer obtainable by arranging the input digits\n    in descending order.\n\n    Parameters\n    ----------\n    digits : List[int]\n        List containing integer digits 0-9.\n\n    Returns\n    -------\n    int\n        Largest integer formed from the digits.  Empty or all\u2011zero lists\n        yield 0.\n\n    Raises\n    ------\n    TypeError\n        If the argument is not a list.\n    ValueError\n        If any element is not an int or not in 0-9.\n    \"\"\"\n    if not isinstance(digits, list):\n        raise TypeError(f\"Input must be a list, got {type(digits).__name__}\")\n\n    for idx, d in enumerate(digits):\n        if not isinstance(d, int):\n            raise ValueError(f\"Element at index {idx} is not an int: {d}\")\n        if d < 0 or d > 9:\n            raise ValueError(f\"Element at index {idx} out of range 0-9: {d}\")\n\n    if not digits or all(d == 0 for d in digits):\n        return 0\n\n    sorted_digits = sorted(digits, reverse=True)\n    num_str = \"\".join(str(d) for d in sorted_digits)\n    return int(num_str)"}
{"task_id": "Mbpp/58", "solution": "def opposite_Signs(a: int, b: int) -> bool:\n    \"\"\"\n    Determine whether two integers have opposite signs.\n\n    Parameters\n    ----------\n    a : int\n        First integer.\n    b : int\n        Second integer.\n\n    Returns\n    -------\n    bool\n        True if one integer is positive and the other is negative,\n        False otherwise.\n\n    Raises\n    ------\n    TypeError\n        If either a or b is not an instance of int.\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise TypeError(\"Both arguments must be integers.\")\n    sign_a = 1 if a > 0 else (-1 if a < 0 else 0)\n    sign_b = 1 if b > 0 else (-1 if b < 0 else 0)\n    return sign_a * sign_b == -1"}
{"task_id": "Mbpp/59", "solution": "import math\n\nMAX_INT64 = 9223372036854775807\nMIN_INT64 = -9223372036854775808\n\ndef calculate_octagonal_number(n: int) -> int:\n    \"\"\"\n    Returns the nth octagonal number.\n    Raises ValueError if n <= 0.\n    Raises OverflowError if the result cannot be represented in a signed 64\u2011bit integer.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n    # Compute the value using 128\u2011bit intermediate logic\n    term = 3 * n - 2\n    result = n * term\n    if result < MIN_INT64 or result > MAX_INT64:\n        raise OverflowError(\"result overflows 64\u2011bit signed integer\")\n    return result\n\ndef is_octagonal(k: int) -> bool:\n    \"\"\"\n    Returns True if k is an octagonal number, False otherwise.\n    Raises ValueError if k <= 0.\n    Raises OverflowError if intermediate computations overflow a signed 64\u2011bit integer.\n    \"\"\"\n    if k <= 0:\n        raise ValueError(\"k must be a positive integer\")\n    # Compute discriminant D = 4 + 12*k\n    try:\n        D = 4 + 12 * k\n    except OverflowError:\n        raise OverflowError(\"intermediate overflow while computing discriminant\")\n    if D < 0 or D > MAX_INT64:\n        # D must be non\u2011negative and within 64\u2011bit range\n        return False\n    sqrtD = math.isqrt(D)\n    if sqrtD * sqrtD != D:\n        return False\n    if (2 + sqrtD) % 6 != 0:\n        return False\n    n = (2 + sqrtD) // 6\n    return n >= 1"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"Count contiguous substrings of a digit string where\n    the sum of digits equals the substring length.\n\n    Parameters:\n        s (str): A string consisting solely of characters '0'-'9'.\n\n    Returns:\n        int: Number of qualifying substrings.\n\n    Raises:\n        ValueError: If s contains non-digit characters.\n    \"\"\"\n    if not all(c.isdigit() for c in s):\n        raise ValueError(\"Input must contain only digits\")\n\n    pref = 0\n    result = 0\n    cnt_map = {0: 1}  # T_0 = 0\n\n    for k in range(1, len(s) + 1):\n        pref += int(s[k - 1])\n        t_k = pref - (k - 1)\n        result += cnt_map.get(t_k, 0)\n        cnt_map[t_k] = cnt_map.get(t_k, 0) + 1\n\n    return result"}
{"task_id": "Mbpp/62", "solution": "from typing import List, Union\n\ndef find_smallest(numbers: List[Union[int, float]]) -> Union[int, float]:\n    it = iter(numbers)\n    try:\n        first = next(it)\n    except StopIteration:\n        raise ValueError(\"Input list must not be empty.\")\n    if not isinstance(first, (int, float)):\n        raise TypeError(\"All elements must be int or float.\")\n    min_val = first\n    for x in it:\n        if not isinstance(x, (int, float)):\n            raise TypeError(\"All elements must be int or float.\")\n        if x < min_val:\n            min_val = x\n    return min_val"}
{"task_id": "Mbpp/63", "solution": "from typing import List, Tuple\n\ndef max_difference(pairs: List[Tuple[int, int]]) -> int:\n    \"\"\"\n    Compute the maximum absolute difference between the two integers in each 2\u2011element tuple of an input list.\n\n    Parameters\n    ----------\n    pairs : List[Tuple[int, int]]\n        A list of tuples, each containing exactly two integers.\n\n    Returns\n    -------\n    int\n        The maximum absolute difference found across all tuples.\n\n    Raises\n    ------\n    ValueError\n        If the input list is empty.\n\n    Examples\n    --------\n    >>> pairs = [(1, 5), (3, -2), (10, 10)]\n    >>> max_difference(pairs)\n    5\n    \"\"\"\n    if not pairs:\n        raise ValueError(\"Input list must not be empty.\")\n\n    max_diff = 0\n    for a, b in pairs:\n        diff = abs(a - b)\n        if diff > max_diff:\n            max_diff = diff\n    return max_diff"}
{"task_id": "Mbpp/64", "solution": "from typing import Iterable, List, Tuple, Union\n\ndef subject_marks(\n    subjects: Iterable[Tuple[str, Union[int, float]]]\n) -> List[Tuple[str, Union[int, float]]]:\n    \"\"\"Return a list of (subject, score) tuples sorted ascending by score.\n\n    The function is pure: it does not modify the input iterable or any external state.\n    It accepts any iterable of 2\u2011item tuples where the second element is a numeric\n    score (int or float). The result is always a new list.\n\n    Parameters\n    ----------\n    subjects : Iterable[Tuple[str, Union[int, float]]]\n        An iterable of (subject, score) tuples.\n\n    Returns\n    -------\n    List[Tuple[str, Union[int, float]]]\n        A new list sorted by the numeric score in ascending order.\n\n    Raises\n    ------\n    TypeError\n        If an element in the iterable is not a 2\u2011tuple or if the score is not\n        an int or float.\n\n    Examples\n    --------\n    >>> subject_marks([('Math', 90), ('Physics', 85)])\n    [('Physics', 85), ('Math', 90)]\n    \"\"\"\n    validated: List[Tuple[str, Union[int, float]]] = []\n    for item in subjects:\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise TypeError(f\"Each item must be a 2-tuple, got {item!r}\")\n        subject, score = item\n        if not isinstance(score, (int, float)):\n            raise TypeError(f\"Score must be int or float, got {type(score)!r}\")\n        validated.append((subject, score))\n    return sorted(validated, key=lambda x: x[1])"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(data: list) -> int:\n    \"\"\"Return the sum of all integer elements in a nested list.\n\n    Parameters\n    ----------\n    data : list\n        A list that may contain integers, nested lists, or other objects.\n\n    Returns\n    -------\n    int\n        The sum of all integer values found within `data`. Non\u2011integer items\n        are ignored. An empty list or a list containing no integers yields 0.\n\n    Raises\n    ------\n    TypeError\n        If `data` is not a list.\n\n    Examples\n    --------\n    >>> recursive_list_sum([1, [2, 3], [4, [5]]])\n    15\n\n    >>> recursive_list_sum([1, 'a', [2, None, [3, 'x']]])\n    6\n\n    >>> recursive_list_sum([])\n    0\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input must be a list\")\n\n    def _summation(sublist: list) -> int:\n        total = 0\n        for item in sublist:\n            if isinstance(item, int):\n                total += item\n            elif isinstance(item, list):\n                total += _summation(item)\n            # ignore all other types\n        return total\n\n    return _summation(data)"}
{"task_id": "Mbpp/66", "solution": "\"\"\"pos_count module\n\nProvides a single function, `pos_count`, which counts positive integers in an iterable.\n\"\"\"\nfrom typing import Iterable, Any\n\ndef pos_count(values: Iterable[Any]) -> int:\n    \"\"\"Count the number of positive integers in the provided iterable.\n\n    Parameters\n    ----------\n    values : Iterable[Any]\n        An iterable containing any type of elements. Elements that are not of type\n        `int` are ignored. The iterable may be a list, tuple, set, generator, etc.\n\n    Returns\n    -------\n    int\n        The count of elements in `values` that are integers greater than zero.\n\n    Raises\n    ------\n    TypeError\n        If `values` is not an instance of `Iterable`.\n\n    Examples\n    --------\n    >>> pos_count([1, -2, 3, 0, 'a', 5.5])\n    2\n    >>> pos_count([])\n    0\n    >>> pos_count([0, -1, -5])\n    0\n    \"\"\"\n    if not isinstance(values, Iterable):\n        raise TypeError(\"pos_count expects an iterable of values\")\n\n    count = 0\n    for item in values:\n        if isinstance(item, int) and item > 0:\n            count += 1\n    return count"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Compute the nth Bell number using the Bell triangle dynamic programming approach.\n    Parameters\n    ----------\n    n : int\n        Non\u2011negative integer index of the Bell number to compute.\n    Returns\n    -------\n    int\n        The exact integer value of the nth Bell number.\n    Raises\n    ------\n    ValueError\n        If n is not an integer or is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non\u2011negative\")\n    if n == 0:\n        return 1\n\n    prev_row = [1]  # T[0][0]\n    for i in range(1, n + 1):\n        curr_row = [prev_row[-1]]  # T[i][0] = T[i-1][i-1]\n        for j in range(1, i + 1):\n            val = curr_row[j - 1] + (prev_row[j] if j < len(prev_row) else 0)\n            curr_row.append(val)\n        prev_row = curr_row\n    return prev_row[0]"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(arr):\n    \"\"\"\n    Determine if the input array is monotonic.\n\n    Parameters\n    ----------\n    arr : sequence\n        Sequence of comparable elements.\n\n    Returns\n    -------\n    bool\n        True if arr is monotonic, False otherwise.\n\n    Raises\n    ------\n    ValueError\n        If arr is None.\n    \"\"\"\n    if arr is None:\n        raise ValueError(\"Input array cannot be None\")\n\n    if len(arr) <= 1:\n        return True\n\n    increasing = None\n    decreasing = None\n\n    for i in range(1, len(arr)):\n        prev, curr = arr[i - 1], arr[i]\n\n        if curr > prev:\n            if decreasing:\n                return False\n            increasing = True\n        elif curr < prev:\n            if increasing:\n                return False\n            decreasing = True\n\n    return True"}
{"task_id": "Mbpp/69", "solution": "def _build_lps(pattern: list) -> list:\n    \"\"\"Build the longest prefix-suffix (lps) array for KMP.\"\"\"\n    lps = [0] * len(pattern)\n    length = 0\n    i = 1\n    while i < len(pattern):\n        if pattern[i] == pattern[length]:\n            length += 1\n            lps[i] = length\n            i += 1\n        else:\n            if length != 0:\n                length = lps[length - 1]\n            else:\n                lps[i] = 0\n                i += 1\n    return lps\n\n\ndef is_sublist(main: list, sub: list) -> bool:\n    \"\"\"Return True if `sub` appears as a contiguous subsequence in `main`.\"\"\"\n    if not sub:\n        return True\n    if len(sub) > len(main):\n        return False\n\n    lps = _build_lps(sub)\n    i = j = 0\n    while i < len(main):\n        if main[i] == sub[j]:\n            i += 1\n            j += 1\n            if j == len(sub):\n                return True\n        else:\n            if j != 0:\n                j = lps[j - 1]\n            else:\n                i += 1\n    return False\n\n# Example usage\nif __name__ == \"__main__\":\n    assert is_sublist([2, 4, 3, 5, 7], [3, 7]) is False\n    assert is_sublist([2, 4, 3, 5, 7], [4, 3]) is True\n    print(\"All tests passed.\")"}
{"task_id": "Mbpp/70", "solution": "from typing import List, Tuple\n\ndef get_equal(tuple_list: List[Tuple]) -> bool:\n    \"\"\"Determines if all tuples in a list have equal length.\n\n    Parameters\n    ----------\n    tuple_list : List[Tuple]\n        List containing tuples.\n\n    Returns\n    -------\n    bool\n        True if all tuples have the same length, False otherwise.\n\n    Raises\n    ------\n    TypeError\n        If input is not a list or contains non-tuple elements.\n    \"\"\"\n    if not isinstance(tuple_list, list):\n        raise TypeError(\"Input must be a list\")\n\n    if not tuple_list:\n        return True\n\n    for element in tuple_list:\n        if not isinstance(element, tuple):\n            raise TypeError(\"All elements must be tuples\")\n\n    expected_len = len(tuple_list[0])\n    for t in tuple_list[1:]:\n        if len(t) != expected_len:\n            return False\n\n    return True"}
{"task_id": "Mbpp/71", "solution": "from typing import List, TypeVar\n\nT = TypeVar(\"T\")\n\ndef comb_sort(input_list: List[T], *, verbose: bool = False) -> List[T]:\n    \"\"\"Sort a list using the Comb Sort algorithm and return a new sorted list.\n\n    Parameters\n    ----------\n    input_list : List[T]\n        List of comparable elements to sort.\n    verbose : bool, optional\n        If True, prints debug information about each pass and swap.\n        Default is False.\n\n    Returns\n    -------\n    List[T]\n        A new list containing the elements of *input_list* sorted in ascending order.\n    \"\"\"\n    n = len(input_list)\n    if n <= 1:\n        return input_list.copy()\n\n    arr = input_list.copy()\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n    pass_number = 0\n\n    while gap > 1 or swapped:\n        gap = max(1, int(gap / shrink_factor))\n        swapped = False\n        pass_number += 1\n        if verbose:\n            print(f\"Pass {pass_number}: gap = {gap}\")\n\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n                if verbose:\n                    print(f\"  Swapped indices {i} and {i + gap}\")\n\n    return arr"}
{"task_id": "Mbpp/72", "solution": "def dif_Square(n):\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer\")\n    if n == 0:\n        return True\n    return (n % 4) != 2"}
{"task_id": "Mbpp/74", "solution": "from collections.abc import Iterable\nfrom typing import Iterable as TypingIterable\n\ndef is_samepatterns(seqA: TypingIterable, seqB: TypingIterable) -> bool:\n    if not (isinstance(seqA, Iterable) and isinstance(seqB, Iterable)):\n        raise TypeError(\"Both inputs must be sequences.\")\n    a = list(seqA)\n    b = list(seqB)\n    if len(a) != len(b):\n        return False\n    map_a = {}\n    map_b = {}\n    for idx, (x, y) in enumerate(zip(a, b)):\n        try:\n            if x not in map_a:\n                map_a[x] = idx\n            if y not in map_b:\n                map_b[y] = idx\n        except TypeError as e:\n            raise ValueError(\"All elements must be hashable.\") from e\n        if map_a[x] != map_b[y]:\n            return False\n    return True"}
{"task_id": "Mbpp/75", "solution": "```python\nfrom typing import List, Tuple\n\nclass InputValidationError(ValueError):\n    \"\"\"Raised when input validation fails in `find_tuples`.\"\"\"\n\ndef _validate_inputs(tuples: List[Tuple[int, ...]], k: int) -> None:\n    if not isinstance(k, int) or k == 0:\n        raise InputValidationError(\"k must be a non-zero integer.\")\n    if not isinstance(tuples, list):\n        raise InputValidationError(\"tuples must be a list.\")\n    for idx, t in enumerate(tuples):\n        if not isinstance(t, tuple):\n            raise InputValidationError(f\"Element {idx} is not a tuple.\")\n        for elem in t:\n            if not isinstance(elem, int):\n                raise InputValidationError(\n                    f\"Non-integer element in tuple {idx}.\"\n                )\n\ndef _filter_tuples(tuples: List[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n    return [t for t in tuples if all(e % k == 0 for e in t)]\n\ndef find_tuples(tuples: List[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n    \"\"\"\n    Return a list of tuples where every element is divisible by k.\n\n    Parameters\n    ----------\n    tuples : List[Tuple[int, ...]]\n        Input list of integer tuples.\n    k : int\n        Divisor. Must be non-zero.\n\n    Returns\n    -------\n    List[Tuple[int, ...]]\n        Filtered list preserving original order.\n\n    Raises\n    ------\n    InputValidationError\n        If k is zero or inputs are of incorrect type.\n    \"\"\"\n    _validate_inputs(tuples, k)\n    return _filter_tuples(tuples, k)\n```"}
{"task_id": "Mbpp/77", "solution": "def is_Diff(n: int) -> bool:\n    \"\"\"\n    Determine if an integer is divisible by 11.\n\n    Parameters:\n        n (int): The number to test.\n\n    Returns:\n        bool: True if n is divisible by 11, False otherwise.\n\n    Raises:\n        TypeError: If n is not an integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    return n % 11 == 0\n\nif __name__ == \"__main__\":\n    # Sample test cases\n    assert is_Diff(12345) is True, \"12345 should be divisible by 11\"\n    assert is_Diff(110) is True, \"110 should be divisible by 11\"\n    assert is_Diff(99) is False, \"99 is not divisible by 11\"\n    assert is_Diff(0) is True, \"0 is divisible by 11\"\n    assert is_Diff(-22) is True, \"-22 should be divisible by 11\"\n    # Edge case: non-integer input\n    try:\n        is_Diff(3.14)\n    except TypeError:\n        pass\n    else:\n        raise AssertionError(\"Non-integer input should raise TypeError\")\n    print(\"All unit tests passed.\")"}
{"task_id": "Mbpp/79", "solution": "import logging\n\nlogger = logging.getLogger(__name__)\n\ndef word_len(word: str) -> bool:\n    \"\"\"\n    Determine whether the length of a word is odd.\n\n    Parameters\n    ----------\n    word : str\n        The word to evaluate. Must be a non\u2011empty string.\n\n    Returns\n    -------\n    bool\n        True if the length of ``word`` is odd, False otherwise.\n\n    Raises\n    ------\n    ValueError\n        If ``word`` is not a string or is empty.\n    \"\"\"\n    if not isinstance(word, str):\n        raise ValueError(\"Input must be a string.\")\n    if not word:\n        raise ValueError(\"Input string must not be empty.\")\n\n    result = len(word) % 2 == 1\n    logger.info(\"word_len called with '%s' -> %s\", word, result)\n    return result"}
{"task_id": "Mbpp/80", "solution": "def tetrahedral_number(n: int) -> int:\n    \"\"\"\n    Compute the nth tetrahedral number.\n\n    Parameters:\n        n (int): 1-based index of the tetrahedral number. Must be >= 1.\n\n    Returns:\n        int: The nth tetrahedral number.\n\n    Raises:\n        ValueError: If n is not an integer or n < 1.\n\n    Examples:\n        >>> tetrahedral_number(1)\n        1\n        >>> tetrahedral_number(5)\n        35\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer\")\n    if n < 1:\n        raise ValueError(\"n must be a positive integer\")\n\n    return n * (n + 1) * (n + 2) // 6"}
{"task_id": "Mbpp/82", "solution": "import math\nfrom typing import Union\n\n__all__ = [\"volume_sphere\"]\n\n\ndef volume_sphere(radius: Union[int, float]) -> float:\n    \"\"\"\n    Calculate the volume of a sphere.\n\n    Args:\n        radius: The radius of the sphere. Must be a non\u2011negative number\n                (int or float). The radius is interpreted in the unit\n                of the caller (e.g., meters).\n\n    Returns:\n        The volume of the sphere as a float.\n\n    Raises:\n        TypeError: If `radius` is not an int or float.\n        ValueError: If `radius` is negative, NaN, or infinite.\n\n    Example:\n        >>> volume_sphere(1)\n        4.1887902047863905\n    \"\"\"\n    if not isinstance(radius, (int, float)):\n        raise TypeError(\n            f\"radius must be a numeric type (int or float), got {type(radius).__name__}\"\n        )\n\n    if math.isnan(radius) or not math.isfinite(radius):\n        raise ValueError(\"radius cannot be NaN or infinite\")\n\n    if radius < 0:\n        raise ValueError(f\"radius cannot be negative; received {radius}\")\n\n    volume = (4.0 / 3.0) * math.pi * radius ** 3\n    return float(volume)"}
{"task_id": "Mbpp/84", "solution": "def sequence(n: int) -> int:\n    \"\"\"\n    Compute the n-th term of the Newman\u2013Conway sequence.\n\n    The Newman\u2013Conway sequence is defined by:\n        a(1) = 1, a(2) = 1\n        For n \u2265 3:\n            if n is even: a(n) = a(n-1) + a(n/2)\n            if n is odd : a(n) = a(n-1) - a((n-1)/2)\n\n    Parameters\n    ----------\n    n : int\n        The 1\u2011based index into the Newman\u2013Conway sequence.\n        Must be a positive integer (n \u2265 1).\n\n    Returns\n    -------\n    int\n        The n-th term of the sequence.\n\n    Raises\n    ------\n    ValueError\n        If ``n`` is not an integer or is less than 1.\n\n    Examples\n    --------\n    >>> sequence(1)\n    1\n    >>> sequence(5)\n    1\n    >>> sequence(10)\n    4\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer\")\n    if n < 1:\n        raise ValueError(\"n must be \u2265 1\")\n\n    if n == 1 or n == 2:\n        return 1\n\n    seq = [0] * (n + 1)\n    seq[1] = seq[2] = 1\n\n    for i in range(3, n + 1):\n        if i % 2 == 0:\n            seq[i] = seq[i - 1] + seq[i // 2]\n        else:\n            seq[i] = seq[i - 1] - seq[(i - 1) // 2]\n\n    return seq[n]"}
{"task_id": "Mbpp/85", "solution": "import math\n\ndef surfacearea_sphere(radius: float) -> float:\n    \"\"\"Calculate the surface area of a sphere.\n\n    Parameters\n    ----------\n    radius : float\n        Radius of the sphere. Must be non\u2011negative.\n\n    Returns\n    -------\n    float\n        Surface area of the sphere computed as 4 * \u03c0 * radius^2.\n\n    Raises\n    ------\n    TypeError\n        If radius is not an int or float.\n    ValueError\n        If radius is negative.\n\n    Examples\n    --------\n    >>> surfacearea_sphere(1)\n    12.566370614359172\n    >>> surfacearea_sphere(0)\n    0.0\n    \"\"\"\n    if not isinstance(radius, (int, float)):\n        raise TypeError(\"radius must be a number\")\n    if radius < 0:\n        raise ValueError(\"radius must be non-negative\")\n    return 4 * math.pi * radius ** 2"}
{"task_id": "Mbpp/86", "solution": "def centered_hexagonal_number(n: int) -> int:\n    \"\"\"Return the nth centered hexagonal number.\n\n    Parameters:\n        n (int): Sequence index, must be >= 1.\n\n    Returns:\n        int: The nth centered hexagonal number.\n\n    Example:\n        >>> centered_hexagonal_number(1)\n        1\n        >>> centered_hexagonal_number(3)\n        19\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be an integer >= 1\")\n    return 3 * n * (n - 1) + 1"}
{"task_id": "Mbpp/87", "solution": "from typing import Any, Dict, Hashable\n\n__all__ = [\"merge_dictionaries_three\"]\n\n\ndef merge_dictionaries_three(\n    dict_a: Dict[Hashable, Any],\n    dict_b: Dict[Hashable, Any],\n    dict_c: Dict[Hashable, Any],\n) -> Dict[Hashable, Any]:\n    \"\"\"\n    Merge three dictionaries into a new dictionary.\n\n    The merge follows these rules:\n\n    1. Keys from ``dict_a`` are added first.\n    2. Keys from ``dict_b`` are added next; if a key already exists, its value\n       is overwritten.\n    3. Keys from ``dict_c`` are added last; if a key already exists, its value\n       is overwritten.\n\n    Parameters\n    ----------\n    dict_a, dict_b, dict_c\n        Dictionaries to merge. Keys must be hashable. Values can be of any type.\n\n    Returns\n    -------\n    dict\n        A new dictionary containing all key/value pairs from the three inputs.\n        The order of insertion is preserved: ``dict_a`` keys first,\n        then ``dict_b`` keys, then ``dict_c`` keys.\n\n    Examples\n    --------\n    >>> merge_dictionaries_three({'x': 1}, {'y': 2}, {'x': 3})\n    {'x': 3, 'y': 2}\n\n    Notes\n    -----\n    - The function is pure; it does not modify the input dictionaries.\n    - If any input is not a ``dict`` instance, a ``TypeError`` is raised.\n    \"\"\"\n    if not isinstance(dict_a, dict):\n        raise TypeError(\"dict_a must be a dict\")\n    if not isinstance(dict_b, dict):\n        raise TypeError(\"dict_b must be a dict\")\n    if not isinstance(dict_c, dict):\n        raise TypeError(\"dict_c must be a dict\")\n\n    merged: Dict[Hashable, Any] = dict(dict_a)\n    merged.update(dict_b)\n    merged.update(dict_c)\n    return merged"}
{"task_id": "Mbpp/88", "solution": "import collections\nfrom typing import Dict, Hashable, List\n\n__all__ = [\"freq_count\"]\n\ndef freq_count(elements: List[Hashable]) -> Dict[Hashable, int]:\n    \"\"\"\n    Compute the frequency of each element in a list.\n\n    Parameters\n    ----------\n    elements : List[Hashable]\n        A list of hashable items (e.g., int, str, tuple).\n\n    Returns\n    -------\n    Dict[Hashable, int]\n        Dictionary mapping each unique element to its occurrence count.\n\n    Notes\n    -----\n    - An empty input list returns an empty dictionary.\n    - The function is O(n) in time and O(k) in space.\n    - Uses collections.Counter internally for optimal performance.\n    \"\"\"\n    if not isinstance(elements, list):\n        raise TypeError(\"Expected a list of hashable elements, got %r\" % type(elements).__name__)\n    counter = collections.Counter(elements)\n    return dict(counter)"}
{"task_id": "Mbpp/89", "solution": "def closest_num(n: int) -> int:\n    \"\"\"\n    Return the largest integer strictly smaller than the given integer n.\n    \"\"\"\n    return n - 1\n\n# Example usage\nassert closest_num(11) == 10\nassert closest_num(0) == -1\nassert closest_num(-5) == -6\n\nif __name__ == \"__main__\":\n    print(\"closest_num(11) =\", closest_num(11))\n    print(\"closest_num(0) =\", closest_num(0))\n    print(\"closest_num(-5) =\", closest_num(-5))"}
{"task_id": "Mbpp/90", "solution": "import re\nfrom typing import Iterable, Optional\n\n\ndef longest_word_length(text: str,\n                        delimiters: Optional[Iterable[str]] = None) -> int:\n    \"\"\"Return the length of the longest word in *text*.\n\n    A word is a maximal sequence of non\u2011whitespace, non\u2011punctuation characters.\n    If *delimiters* is provided, each character in the iterable is treated\n    as an explicit delimiter.\n\n    Parameters\n    ----------\n    text : str\n        The input string to analyze.\n    delimiters : Iterable[str] or None, optional\n        Optional list of single\u2011character delimiters.\n\n    Returns\n    -------\n    int\n        Length of the longest word, or 0 if the string contains no words.\n\n    Raises\n    ------\n    TypeError\n        If *text* is not a string.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a string\")\n\n    # Use regex finditer for default delimiters to avoid creating a list of tokens\n    if delimiters is None:\n        # \\w matches Unicode word characters; matches sequences of such characters\n        pattern = r'\\w+'\n        max_len = 0\n        for match in re.finditer(pattern, text):\n            current_len = match.end() - match.start()\n            if current_len > max_len:\n                max_len = current_len\n        return max_len\n\n    # Custom delimiters: build a regex pattern that splits on any of them\n    escaped = [re.escape(d) for d in delimiters]\n    pattern = '|'.join(escaped) or r'\\s+'  # fallback to whitespace if delimiters empty\n    tokens = re.split(pattern, text)\n    max_len = 0\n    for token in tokens:\n        if token:  # ignore empty strings\n            token_len = len(token)\n            if token_len > max_len:\n                max_len = token_len\n    return max_len"}
{"task_id": "Mbpp/91", "solution": "import java.util.List;\nimport java.util.Locale;\nimport java.util.logging.Logger;\n\npublic final class SubstringSearcher {\n    private static final Logger logger = Logger.getLogger(SubstringSearcher.class.getName());\n\n    public static boolean containsSubstring(String searchTerm, List<String> stringList, boolean ignoreCase) {\n        validateInputs(searchTerm, stringList);\n        if (stringList == null) {\n            return false;\n        }\n        if (ignoreCase) {\n            searchTerm = searchTerm.toLowerCase(Locale.ROOT);\n        }\n        for (String candidate : stringList) {\n            if (candidate == null) {\n                continue;\n            }\n            String test = candidate;\n            if (ignoreCase) {\n                test = test.toLowerCase(Locale.ROOT);\n            }\n            if (test.contains(searchTerm)) {\n                return true;\n            }\n        }\n        return false;\n    }\n\n    public static boolean containsSubstring(String searchTerm, List<String> stringList) {\n        return containsSubstring(searchTerm, stringList, false);\n    }\n\n    private static void validateInputs(String searchTerm, List<String> stringList) {\n        if (searchTerm == null || searchTerm.isEmpty()) {\n            throw new IllegalArgumentException(\"searchTerm must be non-null and non-empty\");\n        }\n    }\n}"}
{"task_id": "Mbpp/92", "solution": "def is_undulating(n: int) -> bool:\n    \"\"\"Determine whether the decimal representation of an integer consists of\n    exactly two distinct digits that strictly alternate.\n\n    Args:\n        n: A signed 64\u2011bit integer.\n\n    Returns:\n        True if the absolute value of n has two distinct digits that\n        alternate without any equal adjacent digits, otherwise False.\n\n    Raises:\n        TypeError: If n is not an integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer\")\n\n    s = str(abs(n))\n    if len(s) <= 1:\n        return False\n\n    digit1 = None\n    digit2 = None\n    prev = None\n\n    for ch in s:\n        if prev is None:\n            digit1 = ch\n            prev = ch\n            continue\n\n        if ch == prev:\n            return False\n\n        if digit1 is None:\n            digit1 = ch\n        elif digit2 is None:\n            if ch != digit1:\n                digit2 = ch\n        else:\n            if ch != digit1:\n                return False\n\n        prev = ch\n\n    return digit2 is not None"}
{"task_id": "Mbpp/93", "solution": "def power(a: int, b: int) -> int:\n    \"\"\"\n    Compute a raised to the power b (a^b).\n\n    Parameters:\n        a (int): Base value. Can be negative, zero, or positive.\n        b (int): Non\u2011negative exponent. Must satisfy b >= 0.\n\n    Returns:\n        int: The integer result of a**b.\n\n    Raises:\n        ValueError: If b is negative.\n    \"\"\"\n    if b < 0:\n        raise ValueError(\"Exponent must be non\u2011negative\")\n    result = 1\n    base = a\n    exp = b\n    while exp:\n        if exp & 1:\n            result *= base\n        base *= base\n        exp >>= 1\n    return result"}
{"task_id": "Mbpp/94", "solution": "from __future__ import annotations\n\nfrom typing import Any, List\n\n\ndef first_of_min_second(lst: List[Any]) -> Any:\n    \"\"\"Return the first element of the tuple with the smallest second value.\n\n    Parameters\n    ----------\n    lst : list\n        List of elements. Elements that are not tuples of length >= 2 are ignored.\n\n    Returns\n    -------\n    Any\n        The first element of the tuple that has the minimal second element.\n\n    Raises\n    ------\n    ValueError\n        If `lst` is empty or no valid tuples are found.\n    TypeError\n        If the second element of a valid tuple cannot be compared.\n    \"\"\"\n    if not lst:\n        raise ValueError(\"Input list is empty\")\n\n    min_second: Any | None = None\n    result_first: Any | None = None\n    found_valid = False\n\n    for item in lst:\n        if not isinstance(item, tuple) or len(item) < 2:\n            continue\n\n        second = item[1]\n        if not found_valid:\n            min_second = second\n            result_first = item[0]\n            found_valid = True\n            continue\n\n        try:\n            if second < min_second:  # type: ignore[arg-type]\n                min_second = second\n                result_first = item[0]\n        except TypeError as exc:\n            raise TypeError(\"Second element is not comparable\") from exc\n\n    if not found_valid:\n        raise ValueError(\"No valid tuples with at least two elements found\")\n\n    return result_first"}
{"task_id": "Mbpp/95", "solution": "\"\"\"Utility functions for list operations.\n\nThis module provides a function to determine the minimal length of inner lists\nwithin a list of lists. It includes robust type checking and clear\ndocumentation.\n\"\"\"\n\nfrom typing import Any, List\n\n__all__ = [\"min_list_length\"]\n\n\ndef min_list_length(lists: List[List[Any]]) -> int:\n    \"\"\"Return the length of the smallest inner list in `lists`.\n\n    Args:\n        lists: A list of lists. Each element must itself be a list.\n\n    Returns:\n        The minimal length among all inner lists. If `lists` is empty, returns 0.\n\n    Raises:\n        TypeError: If `lists` is not a list or contains a non\u2011list element.\n\n    Examples:\n        >>> min_list_length([[1, 2, 3], [4], []])\n        0\n        >>> min_list_length([[], [], []])\n        0\n        >>> min_list_length([[1], [2, 3], [4, 5, 6]])\n        1\n    \"\"\"\n    if not isinstance(lists, list):\n        raise TypeError(\"Input must be a list of lists.\")\n    for inner in lists:\n        if not isinstance(inner, list):\n            raise TypeError(\"All elements of the outer list must be lists.\")\n    if not lists:\n        return 0\n    return min(len(inner) for inner in lists)"}
{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    if n == 0:\n        return 0\n    n_abs = abs(n)\n    count = 1\n    exp = 0\n    while n_abs % 2 == 0:\n        n_abs //= 2\n        exp += 1\n    count *= (exp + 1)\n    p = 3\n    while p * p <= n_abs:\n        exp = 0\n        while n_abs % p == 0:\n            n_abs //= p\n            exp += 1\n        count *= (exp + 1)\n        p += 2\n    if n_abs > 1:\n        count *= 2\n    return count"}
{"task_id": "Mbpp/97", "solution": "from collections import Counter\nfrom typing import Any, Dict, List, TypeVar, Hashable\n\nT = TypeVar('T', bound=Hashable)\n\n\ndef _validate_input(data: List[Any]) -> None:\n    \"\"\"Validate that every element of the outer list is a list.\n\n    Parameters\n    ----------\n    data : List[Any]\n        The outer list to validate.\n\n    Raises\n    ------\n    ValueError\n        If any element of ``data`` is not a list.\n    \"\"\"\n    for element in data:\n        if not isinstance(element, list):\n            raise ValueError(\"All elements of the outer list must be lists.\")\n\n\ndef frequency_lists(data: List[List[T]]) -> Dict[T, int]:\n    \"\"\"Compute the frequency of each element across a list of sub\u2011lists.\n\n    Parameters\n    ----------\n    data : List[List[T]]\n        A list where each element is itself a list of hashable items.\n\n    Returns\n    -------\n    Dict[T, int]\n        A dictionary mapping each distinct element to the total number of\n        times it appears in all sub\u2011lists.\n\n    Raises\n    ------\n    ValueError\n        If any element of the outer list is not a list.\n    \"\"\"\n    _validate_input(data)\n    counter = Counter()\n    for sublist in data:\n        counter.update(sublist)\n    return dict(counter)"}
{"task_id": "Mbpp/98", "solution": "from typing import Iterable\n\ndef multiply_num(numbers: Iterable[float]) -> float:\n    \"\"\"Multiply all numbers in *numbers* together and divide the result by the\n    count of elements.\n\n    Parameters\n    ----------\n    numbers : Iterable[float]\n        An iterable containing numeric values (integers or floats).\n\n    Returns\n    -------\n    float\n        The product of all values divided by the number of values.\n\n    Raises\n    ------\n    ZeroDivisionError\n        If *numbers* is empty.\n\n    Examples\n    --------\n    >>> multiply_num((8, 2, 3, -1, 7))\n    -67.2\n    \"\"\"\n    product = 1.0\n    count = 0\n\n    for n in numbers:\n        product *= float(n)\n        count += 1\n\n    if count == 0:\n        raise ZeroDivisionError(\"Cannot compute product of an empty iterable.\")\n\n    return product / count"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(n: int) -> str:\n    \"\"\"Convert a non\u2011negative integer to its binary string representation.\n\n    Parameters\n    ----------\n    n : int\n        Decimal integer to convert; must be >= 0.\n\n    Returns\n    -------\n    str\n        Binary representation of `n` without leading zeros.\n\n    Raises\n    ------\n    ValueError\n        If `n` is negative.\n    TypeError\n        If `n` is not an integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input must be a non\u2011negative integer.\")\n\n    if n == 0:\n        return \"0\"\n\n    bits = []\n    while n:\n        bits.append(str(n % 2))\n        n //= 2\n    bits.reverse()\n    return \"\".join(bits)"}
{"task_id": "Mbpp/100", "solution": "from typing import Union\n\ndef next_smallest_palindrome(number: Union[int, str]) -> int:\n    # Input validation\n    if isinstance(number, int):\n        if number < 0:\n            raise ValueError(\"Input must be non-negative.\")\n        s = str(number)\n    else:\n        if not isinstance(number, str) or not number.isdigit():\n            raise ValueError(\"Input must be numeric.\")\n        if int(number) < 0:\n            raise ValueError(\"Input must be non-negative.\")\n        s = number.lstrip('0') or '0'\n\n    # All\u2011nines shortcut\n    if set(s) == {'9'}:\n        return int('1' + ('0' * (len(s) - 1)) + '1')\n\n    digits = list(s)\n    n = len(digits)\n    mid = n // 2\n\n    def mirror():\n        for i in range(mid):\n            digits[n - 1 - i] = digits[i]\n\n    mirror()\n    mirrored = int(''.join(digits))\n    original = int(s)\n    if mirrored > original:\n        return mirrored\n\n    carry = 1\n    if n % 2 == 1:  # odd length\n        i = mid\n        while i >= 0 and carry:\n            new_digit = int(digits[i]) + carry\n            carry = new_digit // 10\n            digits[i] = str(new_digit % 10)\n            i -= 1\n    else:  # even length\n        i = mid - 1\n        while i >= 0 and carry:\n            new_digit = int(digits[i]) + carry\n            carry = new_digit // 10\n            digits[i] = str(new_digit % 10)\n            i -= 1\n\n    if carry:\n        digits = ['1'] + digits + ['1']\n        n += 2\n\n    mirror()\n    return int(''.join(digits))"}
{"task_id": "Mbpp/101", "solution": "```python\nclass KthElementError(Exception):\n    \"\"\"Base exception for Kth Element Finder.\"\"\"\n    def __init__(self, code: int, message: str):\n        self.code = code\n        super().__init__(f\"[{code}] {message}\")\n\n\nclass InvalidArrayException(KthElementError):\n    def __init__(self):\n        super().__init__(1001, \"Input is not a valid array or is null.\")\n\n\nclass InvalidKTypeException(KthElementError):\n    def __init__(self):\n        super().__init__(1002, \"k must be an integer.\")\n\n\nclass InvalidKValueException(KthElementError):\n    def __init__(self):\n        super().__init__(1003, \"k must be \u2265 1.\")\n\n\nclass OutOfBoundsException(KthElementError):\n    def __init__(self):\n        super().__init__(1004, \"k exceeds array length.\")\n\n\nclass InputValidator:\n    @staticmethod\n    def validate(array, k):\n        if array is None or not hasattr(array, \"__len__\") or not hasattr(array, \"__getitem__\"):\n            raise InvalidArrayException()\n        if not isinstance(k, int):\n            raise InvalidKTypeException()\n        if k < 1:\n            raise InvalidKValueException()\n\n\nclass RetrievalStrategy:\n    def retrieve(self, array, k):\n        raise NotImplementedError\n\n\nclass DefaultRetrievalStrategy(RetrievalStrategy):\n    def retrieve(self, array, k):\n        if k > len(array):\n            raise OutOfBoundsException()\n        return array[k - 1]\n\n\nclass ErrorHandler:\n    @staticmethod\n    def handle(exception: KthElementError):\n        # Logging can be added here in a real system.\n        raise exception\n\n\ndef find_kth_element(array, k):\n    \"\"\"\n    Returns the k-th element (1-based) from the provided array-like sequence.\n    Raises descriptive exceptions on invalid input or out-of-bounds access.\n    \"\"\"\n    try:\n        InputValidator.validate(array, k)\n        strategy = DefaultRetrievalStrategy()\n        return strategy.retrieve(array, k)\n    except KthElementError as e:\n        ErrorHandler.handle(e)\n```"}
{"task_id": "Mbpp/102", "solution": "# snake_to_camel/__init__.py\nfrom .core import snake_to_camel\n\n\n# snake_to_camel/core.py\ndef snake_to_camel(s: str) -> str:\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string\")\n    parts = [part for part in s.split('_') if part]\n    return ''.join(part.capitalize() for part in parts)"}
{"task_id": "Mbpp/103", "solution": "from functools import lru_cache\n\n@lru_cache(maxsize=None)\ndef eulerian_number(n: int, m: int) -> int:\n    \"\"\"\n    Compute the Eulerian number a(n, m).\n\n    Parameters\n    ----------\n    n : int\n        The order (non\u2011negative integer).\n    m : int\n        The sub\u2011index (0 \u2264 m < n).\n\n    Returns\n    -------\n    int\n        The Eulerian number a(n, m). Returns 0 for invalid inputs.\n    \"\"\"\n    if n < 0 or m < 0 or m >= n:\n        return 0\n    if n == 0:\n        return 1 if m == 0 else 0\n    if m == 0:\n        return 1\n    return (m + 1) * eulerian_number(n - 1, m) + (n - m) * eulerian_number(n - 1, m - 1)"}
{"task_id": "Mbpp/104", "solution": "```python\nfrom collections.abc import Iterable\n\ndef _validate_input(data: Iterable) -> None:\n    if not isinstance(data, Iterable):\n        raise TypeError(\"Input must be an iterable of iterables.\")\n    for idx, sub in enumerate(data):\n        if not isinstance(sub, Iterable):\n            raise TypeError(f\"Element {idx} is not iterable.\")\n        if not all(isinstance(x, str) for x in sub):\n            raise TypeError(f\"All elements in sublist {idx} must be strings.\")\n\n\ndef sort_sublists(data: Iterable) -> list[list[str]]:\n    \"\"\"\n    Return a list of sorted sublists from an iterable of iterable strings.\n\n    Parameters\n    ----------\n    data : Iterable[Iterable[str]]\n        Outer iterable containing inner iterables of strings.\n\n    Returns\n    -------\n    List[List[str]]\n        A new list where each inner list is the sorted version of the\n        corresponding inner iterable in the input.\n\n    Raises\n    ------\n    TypeError\n        If `data` is not an iterable or any inner element is not an\n        iterable of strings.\n    \"\"\"\n    _validate_input(data)\n    return [sorted(list(sub)) for sub in data]\n```"}
{"task_id": "Mbpp/105", "solution": "```python\nfrom __future__ import annotations\nfrom typing import List\n\ndef count_true_values(values: List[bool]) -> int:\n    \"\"\"\n    Count the number of True boolean values in a list.\n\n    Parameters\n    ----------\n    values : list[bool]\n        The list to inspect. Each element must be a boolean.\n\n    Returns\n    -------\n    int\n        Number of elements equal to True.\n\n    Raises\n    ------\n    TypeError\n        If `values` is not a list or contains non-boolean elements.\n    \"\"\"\n    if not isinstance(values, list):\n        raise TypeError(f\"values must be a list, got {type(values).__name__}\")\n\n    for idx, v in enumerate(values):\n        if not isinstance(v, bool):\n            raise TypeError(f\"Element at index {idx} is not a bool: {v!r}\")\n\n    return sum(1 for v in values if v)\n```"}
{"task_id": "Mbpp/106", "solution": "from typing import Tuple, List\n\ndef append_list_to_tuple(t: Tuple, lst: List) -> Tuple:\n    \"\"\"\n    Append a list to a tuple, returning a new tuple.\n\n    Parameters\n    ----------\n    t : tuple\n        The original tuple.\n    lst : list\n        The list of elements to append.\n\n    Returns\n    -------\n    tuple\n        A new tuple consisting of the elements of `t` followed by the\n        elements of `lst`.\n\n    Examples\n    --------\n    >>> append_list_to_tuple((1, 2), [3, 4])\n    (1, 2, 3, 4)\n    \"\"\"\n    return t + tuple(lst)"}
{"task_id": "Mbpp/108", "solution": "from typing import List\n\ndef merge_sorted_list(list1: List[int], list2: List[int], list3: List[int]) -> List[int]:\n    # Input validation\n    for lst in (list1, list2, list3):\n        if not isinstance(lst, list):\n            raise TypeError(\"All arguments must be lists.\")\n        if not all(isinstance(x, int) for x in lst):\n            raise TypeError(\"All list elements must be integers.\")\n    # Merge and sort\n    return sorted(list1 + list2 + list3)"}
