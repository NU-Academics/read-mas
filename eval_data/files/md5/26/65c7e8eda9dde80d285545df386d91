{"task_id": "Mbpp/614", "solution": "import collections\nfrom typing import Any, List, Tuple\n\ndef _validate_input(data: Any) -> None:\n    if not isinstance(data, list):\n        raise TypeError(\"data must be a list of tuples of integers\")\n    for idx, element in enumerate(data):\n        if not isinstance(element, tuple):\n            raise TypeError(\n                f\"All elements in data must be tuples, \"\n                f\"but element at index {idx} is {type(element).__name__}\"\n            )\n        for j, value in enumerate(element):\n            if not isinstance(value, int):\n                raise TypeError(\n                    f\"All elements in tuples must be integers, \"\n                    f\"but element {value} at tuple index {idx} position {j} \"\n                    f\"is {type(value).__name__}\"\n                )\n\ndef _sum_tuples(tuples: List[Tuple[int, ...]]) -> int:\n    total = 0\n    for tup in tuples:\n        if tup:  # skip empty tuples\n            total += sum(tup)\n    return total\n\ndef cumulative_sum(data: List[Tuple[int, ...]]) -> int:\n    \"\"\"\n    Return the sum of all integers contained in tuples within the list.\n\n    Parameters\n    ----------\n    data : List[Tuple[int, ...]]\n        A list where each element is a tuple of integers.\n\n    Returns\n    -------\n    int\n        The aggregated sum of all integers.\n\n    Raises\n    ------\n    TypeError\n        If data is not a list of tuples of integers.\n    \"\"\"\n    _validate_input(data)\n    return _sum_tuples(data)"}
{"task_id": "Mbpp/615", "solution": "import numbers\nfrom typing import Any, List, Optional, Tuple\n\ndef _validate_input(data: Tuple[Tuple[Any, ...], ...]) -> None:\n    if not isinstance(data, tuple):\n        raise TypeError(f\"data must be a tuple of tuples; got type {type(data).__name__}\")\n    for idx, inner in enumerate(data):\n        _validate_inner(inner, idx)\n\ndef _validate_inner(inner: Tuple[Any, ...], index: int) -> None:\n    if not isinstance(inner, tuple):\n        raise TypeError(\n            f\"element at index {index} must be a tuple; got type {type(inner).__name__}\"\n        )\n    for val_idx, value in enumerate(inner):\n        if not isinstance(value, numbers.Number):\n            raise TypeError(\n                f\"value at inner index {index}, position {val_idx} must be numeric; \"\n                f\"got type {type(value).__name__}\"\n            )\n\ndef tuple_averages(data: Tuple[Tuple[Any, ...], ...]) -> List[Optional[float]]:\n    \"\"\"Compute the arithmetic mean of each inner tuple in the input.\n\n    Parameters\n    ----------\n    data : tuple of tuples\n        The outer tuple contains inner tuples of numeric values.\n\n    Returns\n    -------\n    list[float | None]\n        A list containing the average of each inner tuple. Empty tuples yield None.\n\n    Raises\n    ------\n    TypeError\n        If the input structure is not a tuple of tuples or contains non-numeric values.\n    \"\"\"\n    _validate_input(data)\n    results: List[Optional[float]] = []\n    for inner in data:\n        if not inner:\n            results.append(None)\n            continue\n        avg = sum(inner) / len(inner)\n        results.append(avg)\n    return results"}
{"task_id": "Mbpp/616", "solution": "from typing import Tuple, Union\n\nNumber = Union[int, float]\n\ndef element_wise_modulo(a: Tuple[Number, ...], b: Tuple[Number, ...]) -> Tuple[Number, ...]:\n    \"\"\"Return a tuple containing the element\u2011wise modulo of two numeric tuples.\n\n    Parameters\n    ----------\n    a : Tuple[Number, ...]\n        First numeric tuple.\n    b : Tuple[Number, ...]\n        Second numeric tuple, same length as ``a``.\n\n    Returns\n    -------\n    Tuple[Number, ...]\n        Tuple of modulo results.\n\n    Raises\n    ------\n    TypeError\n        If inputs are not tuples or contain non\u2011numeric elements.\n    ValueError\n        If tuples have different lengths.\n\n    Examples\n    --------\n    >>> element_wise_modulo((10, 20, 30), (3, 7, 5))\n    (1, 6, 0)\n    \"\"\"\n    if not isinstance(a, tuple) or not isinstance(b, tuple):\n        raise TypeError(\"Inputs must be tuples.\")\n    if len(a) != len(b):\n        raise ValueError(\"Tuples must be of equal length.\")\n    for idx, (x, y) in enumerate(zip(a, b)):\n        if not isinstance(x, (int, float)) or not isinstance(y, (int, float)):\n            raise TypeError(\n                f\"All elements must be numeric (int or float). \"\n                f\"Invalid element at position {idx}: {x!r}, {y!r}\"\n            )\n    return tuple(x % y for x, y in zip(a, b))"}
{"task_id": "Mbpp/618", "solution": "from typing import List, Union\nimport numbers\n\ndef div_list(numerator: List[Union[int, float]],\n             denominator: List[Union[int, float]]) -> List[float]:\n    \"\"\"Perform element\u2011wise division of two numeric lists.\n\n    Parameters\n    ----------\n    numerator : list\n        List of numbers (int or float) to be divided.\n    denominator : list\n        List of numbers (int or float) used as divisors.\n\n    Returns\n    -------\n    list of float\n        Division results for each element pair.\n\n    Raises\n    ------\n    TypeError\n        If inputs are not lists or contain non\u2011numeric elements.\n    ValueError\n        If input lists have different lengths.\n    ZeroDivisionError\n        If any denominator element is zero.\n    \"\"\"\n    _validate_inputs(numerator, denominator)\n    return [float(a) / float(b) for a, b in zip(numerator, denominator)]\n\ndef _validate_inputs(numerator, denominator):\n    if not (isinstance(numerator, list) and isinstance(denominator, list)):\n        raise TypeError(\"Numerator and denominator must be lists.\")\n    if len(numerator) != len(denominator):\n        raise ValueError(\"Numerator and denominator must have the same length.\")\n    for idx, (a, b) in enumerate(zip(numerator, denominator)):\n        if not (isinstance(a, numbers.Number) and isinstance(b, numbers.Number)):\n            raise TypeError(\"All elements must be numeric.\")\n        if b == 0:\n            raise ZeroDivisionError(f\"Division by zero at index {idx}.\")"}
{"task_id": "Mbpp/619", "solution": "function moveDigitsToEnd(str) {\n  if (typeof str !== 'string') {\n    throw new TypeError('Input must be a string');\n  }\n\n  let letters = '';\n  let digits = '';\n\n  for (const ch of str) {\n    const code = ch.charCodeAt(0);\n    if (code >= 48 && code <= 57) { // '0' to '9'\n      digits += ch;\n    } else {\n      letters += ch;\n    }\n  }\n\n  return letters + digits;\n}"}
{"task_id": "Mbpp/620", "solution": "from typing import List\n\ndef largest_subset(nums: List[int]) -> int:\n    \"\"\"\n    Return the size of the largest subset of ``nums`` such that for every pair\n    of elements (a, b) in the subset, either a divides b or b divides a.\n\n    Parameters\n    ----------\n    nums : List[int]\n        List of integers (duplicates allowed). The input list is not modified.\n\n    Returns\n    -------\n    int\n        Size of the largest divisible subset. 0 for an empty list.\n\n    Examples\n    --------\n    >>> largest_subset([1, 3, 6, 13, 17, 18])\n    4\n    >>> largest_subset([1, 1, 2, 4])\n    4\n    >>> largest_subset([])\n    0\n    \"\"\"\n    if not nums:\n        return 0\n\n    # Sort the numbers to ensure that we only need to check pairs where the\n    # larger number comes after the smaller number.\n    arr = sorted(nums)\n    n = len(arr)\n    dp = [1] * n\n    max_size = 1\n\n    for i in range(1, n):\n        for j in range(i):\n            if arr[i] % arr[j] == 0:\n                dp[i] = max(dp[i], dp[j] + 1)\n        max_size = max(max_size, dp[i])\n\n    return max_size\n\n# Example usage\nif __name__ == \"__main__\":\n    assert largest_subset([1, 3, 6, 13, 17, 18]) == 4\n    assert largest_subset([1, 1, 2, 4]) == 4\n    assert largest_subset([]) == 0\n    print(\"All tests passed.\")"}
{"task_id": "Mbpp/622", "solution": "from typing import List\n\n__all__ = [\"get_median\"]\n\ndef _validate_inputs(arr1: List[int], arr2: List[int]) -> None:\n    \"\"\"Validate that the two input arrays satisfy the constraints.\"\"\"\n    if len(arr1) != len(arr2):\n        raise ValueError(\"Input arrays must have the same length.\")\n    if len(arr1) == 0:\n        raise ValueError(\"Input arrays must not be empty.\")\n\ndef _binary_search(arr1: List[int], arr2: List[int]) -> float:\n    \"\"\"Find the median of two sorted arrays of equal length using binary search.\"\"\"\n    n = len(arr1)\n    low, high = 0, n\n\n    while low <= high:\n        i = (low + high) // 2\n        j = n - i\n\n        a_left = float(\"-inf\") if i == 0 else arr1[i - 1]\n        a_right = float(\"inf\") if i == n else arr1[i]\n        b_left = float(\"-inf\") if j == 0 else arr2[j - 1]\n        b_right = float(\"inf\") if j == n else arr2[j]\n\n        if a_left <= b_right and b_left <= a_right:\n            left_max = a_left if a_left > b_left else b_left\n            right_min = a_right if a_right < b_right else b_right\n            return (left_max + right_min) / 2.0\n        elif a_left > b_right:\n            high = i - 1\n        else:  # b_left > a_right\n            low = i + 1\n\n    raise RuntimeError(\"Unexpected condition in binary search.\")\n\ndef get_median(arr1: List[int], arr2: List[int]) -> float:\n    \"\"\"\n    Compute the median of two sorted integer lists of equal length.\n\n    Parameters\n    ----------\n    arr1 : List[int]\n        First sorted array.\n    arr2 : List[int]\n        Second sorted array of the same length as `arr1`.\n\n    Returns\n    -------\n    float\n        Median value of the merged arrays.\n\n    Raises\n    ------\n    ValueError\n        If the input arrays are of different lengths or if they are empty.\n    \"\"\"\n    _validate_inputs(arr1, arr2)\n    return _binary_search(arr1, arr2)"}
{"task_id": "Mbpp/623", "solution": "from typing import List, Union\n\n\ndef validate_input(numbers: List[Union[int, float]], n: int) -> None:\n    if not isinstance(numbers, list):\n        raise TypeError(\"`numbers` must be a list.\")\n    if not numbers:\n        raise ValueError(\"`numbers` cannot be empty.\")\n    if not all(isinstance(x, (int, float)) for x in numbers):\n        raise TypeError(\"All elements of `numbers` must be numeric (int or float).\")\n    if not isinstance(n, int):\n        raise TypeError(\"`n` must be an integer.\")\n\n\ndef compute_powers(numbers: List[Union[int, float]], n: int) -> List[Union[int, float]]:\n    return [x ** n for x in numbers]\n\n\ndef nth_nums(numbers: List[Union[int, float]], n: int) -> List[Union[int, float]]:\n    \"\"\"\n    Returns a new list where each element of ``numbers`` is raised to the power ``n``.\n\n    Parameters\n    ----------\n    numbers : List[Union[int, float]]\n        A non\u2011empty list of numeric values (int or float).\n    n : int\n        The exponent to which each element will be raised.\n\n    Returns\n    -------\n    List[Union[int, float]]\n        A list of the same length as ``numbers`` where each element is ``x ** n``.\n\n    Raises\n    ------\n    TypeError\n        If ``numbers`` is not a list, contains non\u2011numeric elements, or if ``n`` is not an integer.\n    ValueError\n        If ``numbers`` is empty.\n\n    Examples\n    --------\n    >>> nth_nums([2, 3], 2)\n    [4, 9]\n    >>> nth_nums([1.5, 2.0], -2)\n    [0.4444444444444444, 0.25]\n    \"\"\"\n    validate_input(numbers, n)\n    return compute_powers(numbers, n)"}
{"task_id": "Mbpp/624", "solution": "def to_upper(s: str) -> str:\n    \"\"\"Convert a string to its uppercase representation.\n\n    Parameters\n    ----------\n    s : str\n        The input string to convert.\n\n    Returns\n    -------\n    str\n        The uppercase version of `s`.\n\n    Raises\n    ------\n    TypeError\n        If `s` is not an instance of ``str``.\n    ValueError\n        If `s` is ``None``.\n    \"\"\"\n    if s is None:\n        raise ValueError(\"Input string cannot be None\")\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string\")\n    return s.upper()"}
{"task_id": "Mbpp/626", "solution": "from __future__ import annotations\nimport math\nfrom typing import Optional\n\ndef triangle_area(r: float) -> Optional[float]:\n    \"\"\"\n    Compute the area of the largest triangle that can be inscribed in a semicircle\n    of radius `r`. Returns `None` if `r` is negative.\n\n    Parameters\n    ----------\n    r : float\n        Radius of the semicircle. Must be a finite real number.\n\n    Returns\n    -------\n    Optional[float]\n        Area of the maximum inscribed triangle if `r` >= 0; otherwise `None`.\n\n    Raises\n    ------\n    TypeError\n        If `r` is not an int or float.\n    ValueError\n        If `r` is not a finite number (e.g., inf or NaN).\n\n    Notes\n    -----\n    The largest inscribed triangle in a semicircle is an isosceles right triangle\n    with legs equal to the radius. Its area is given by (1/2) * r^2.\n    \"\"\"\n    if not isinstance(r, (int, float)):\n        raise TypeError(\"r must be a numeric type\")\n    if not math.isfinite(r):\n        raise ValueError(\"r must be finite\")\n    if r < 0:\n        return None\n    if r == 0:\n        return 0.0\n    return 0.5 * r * r"}
{"task_id": "Mbpp/628", "solution": "def url_encode_spaces(input_str: str) -> str:\n    \"\"\"\n    Replace every space character in the input string with the URL\u2011encoded\n    representation '%20'.\n\n    Parameters\n    ----------\n    input_str : str\n        The string to be encoded.  Only space characters are replaced; all\n        other characters, including tabs, newlines, punctuation, and\n        Unicode, are preserved.\n\n    Returns\n    -------\n    str\n        A new string where each space character has been replaced by '%20'.\n\n    Raises\n    ------\n    TypeError\n        If the provided argument is not a string.\n\n    Examples\n    --------\n    >>> url_encode_spaces(\"Hello World\")\n    'Hello%20World'\n    >>> url_encode_spaces(\"a  b   c\")\n    'a%20%20b%20%20%20c'\n    \"\"\"\n    if not isinstance(input_str, str):\n        raise TypeError(f\"Expected a str, got {type(input_str).__name__}\")\n    return input_str.replace(\" \", \"%20\")"}
{"task_id": "Mbpp/629", "solution": "from collections.abc import Iterable\nfrom typing import List\n\n\ndef Split(numbers: Iterable[int]) -> List[int]:\n    \"\"\"Return a new list containing only the even integers from 'numbers'.\n\n    Parameters:\n        numbers (Iterable[int]): Iterable of integers.\n\n    Returns:\n        List[int]: List of even integers preserving input order.\n\n    Raises:\n        TypeError: If any element in 'numbers' is not an integer.\n    \"\"\"\n    evens: List[int] = []\n    for x in numbers:\n        if not isinstance(x, int):\n            raise TypeError(\n                f\"Element {x!r} is of type {type(x).__name__}, expected int\"\n            )\n        if x % 2 == 0:\n            evens.append(x)\n    return evens"}
{"task_id": "Mbpp/630", "solution": "from typing import List, Tuple\n\ndef get_coordinates(coord: Tuple[int, int]) -> List[List[int]]:\n    \"\"\"Return all adjacent coordinates of the given coordinate, including the coordinate itself.\n\n    Parameters\n    ----------\n    coord : Tuple[int, int]\n        The central coordinate (x, y).\n\n    Returns\n    -------\n    List[List[int]]\n        A 3x3 grid of coordinates in row-major order:\n        rows from x-1 to x+1, columns from y-1 to y+1.\n\n    Examples\n    --------\n    >>> get_coordinates((2, 3))\n    [[1, 2], [1, 3], [1, 4],\n     [2, 2], [2, 3], [2, 4],\n     [3, 2], [3, 3], [3, 4]]\n    \"\"\"\n    x, y = coord\n    grid: List[List[int]] = []\n    for dx in (-1, 0, 1):\n        for dy in (-1, 0, 1):\n            grid.append([x + dx, y + dy])\n    return grid"}
