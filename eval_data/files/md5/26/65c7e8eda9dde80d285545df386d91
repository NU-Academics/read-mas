{"task_id": "Mbpp/2", "solution": "import collections\nfrom collections.abc import Iterable, Sequence\nfrom typing import Any, Iterable as IterableType, List\n\n\ndef _validate_iterable(obj: Any, name: str) -> None:\n    if not isinstance(obj, Iterable):\n        raise TypeError(f\"{name} must be an iterable, got {type(obj).__name__}\")\n\n\ndef _core_algorithm(a: IterableType[Any], b: IterableType[Any]) -> List[Any]:\n    _validate_iterable(a, \"a\")\n    _validate_iterable(b, \"b\")\n\n    try:\n        counter_b = collections.Counter(b)\n        result: List[Any] = []\n        for item in a:\n            if counter_b[item] > 0:\n                result.append(item)\n                counter_b[item] -= 1\n        return result\n    except TypeError:\n        list_b = list(b)\n        result: List[Any] = []\n        for item in a:\n            try:\n                idx = list_b.index(item)\n                result.append(item)\n                list_b.pop(idx)\n            except ValueError:\n                continue\n        return result\n\n\ndef similar_elements(a: Iterable[Any], b: Iterable[Any]) -> Sequence[Any]:\n    \"\"\"\n    Return the intersection of two iterables, preserving the order of the first iterable.\n\n    Parameters\n    ----------\n    a : Iterable[Any]\n        First input iterable.\n    b : Iterable[Any]\n        Second input iterable.\n\n    Returns\n    -------\n    Sequence[Any]\n        A list containing elements that appear in both `a` and `b`. The order follows\n        the appearance in `a`. Duplicate elements are included as many times as they\n        appear in both sequences (intersection semantics).\n\n    Raises\n    ------\n    TypeError\n        If either `a` or `b` is not an iterable.\n    \"\"\"\n    return _core_algorithm(a, b)"}
{"task_id": "Mbpp/3", "solution": "import math\n\ndef is_not_prime(n: int) -> bool:\n    \"\"\"\n    Determine if the integer n is NOT a prime number.\n\n    Parameters:\n        n (int): The number to test.\n\n    Returns:\n        bool: True if n is non\u2011prime, False if n is prime.\n\n    Raises:\n        TypeError: If n is not an integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n\n    # Non\u2011prime if n is less than or equal to 1\n    if n <= 1:\n        return True\n\n    # 2 is the only even prime\n    if n == 2:\n        return False\n\n    # Any other even number is composite\n    if n % 2 == 0:\n        return True\n\n    # Check odd divisors up to sqrt(n)\n    limit = math.isqrt(n) + 1\n    for i in range(3, limit, 2):\n        if n % i == 0:\n            return True\n\n    return False"}
{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import Iterable, List\n\ndef heap_queue_largest(data: Iterable[int], n: int) -> List[int]:\n    \"\"\"Return the `n` largest integers from `data` in descending order.\n\n    Parameters\n    ----------\n    data : Iterable[int]\n        An iterable containing integer values.\n    n : int\n        The number of largest values to return. Must be >= 0.\n\n    Returns\n    -------\n    List[int]\n        A list of the `n` largest integers sorted from greatest to least.\n\n    Raises\n    ------\n    TypeError\n        If `data` is not iterable or contains non\u2011int elements.\n    ValueError\n        If `n` is negative.\n\n    Notes\n    -----\n    - If `n` is zero, an empty list is returned.\n    - If `n` exceeds the length of `data`, all elements are returned sorted.\n    - The implementation uses `heapq.nlargest` for optimal performance.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non\u2011negative integer\")\n\n    try:\n        seq = list(data)\n    except TypeError:\n        raise TypeError(\"data must be an iterable\")\n\n    for val in seq:\n        if not isinstance(val, int):\n            raise TypeError(\"All elements in data must be integers\")\n\n    if n == 0:\n        return []\n\n    return heapq.nlargest(n, seq)"}
{"task_id": "Mbpp/6", "solution": "public static class BitUtilities\n{\n    public static bool IsOneBitDifference(int a, int b)\n    {\n        int xorVal = a ^ b;\n        if (xorVal == 0) return false;\n        return (xorVal & (xorVal - 1)) == 0;\n    }\n}"}
{"task_id": "Mbpp/7", "solution": "from typing import Set\n\ndef find_char_long(input_string: str) -> Set[str]:\n    \"\"\"Return a set of words with length >= 4 from ``input_string``.\n\n    Words are defined as sequences separated by whitespace. Punctuation\n    characters are treated as part of a word, so ``\"test,\"`` has a length\n    of five and will be included.\n    \"\"\"\n    words = input_string.split()\n    return {word for word in words if len(word) >= 4}"}
{"task_id": "Mbpp/8", "solution": "from typing import List\n\ndef square_nums(numbers: List[int]) -> List[int]:\n    \"\"\"\n    Return a list containing the squares of the input integers.\n\n    Parameters\n    ----------\n    numbers : List[int]\n        A list of integers to be squared.\n\n    Returns\n    -------\n    List[int]\n        A new list where each element is the square of the corresponding\n        element from the input list.\n\n    Examples\n    --------\n    >>> square_nums([1, 2, 3])\n    [1, 4, 9]\n\n    Complexity\n    ----------\n    O(n) time and O(n) space, where n is the length of `numbers`.\n    \"\"\"\n    return [x * x for x in numbers]"}
{"task_id": "Mbpp/9", "solution": "#!/usr/bin/env python3\n\"\"\"find_Rotations \u2013 Minimal Positive Rotation Finder\n\nThis module provides a single public function, :func:`find_Rotations`, which\ncalculates the minimal positive rotation count required to return a string\nto its original form.  The computation is based on the Knuth\u2013Morris\u2013Pratt\nprefix function to find the string's minimal period.\n\nExamples\n--------\n>>> find_Rotations('abab')\n2\n>>> find_Rotations('abcabc')\n3\n>>> find_Rotations('abcd')\n4\n>>> find_Rotations('')\n0\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import List\n\n\ndef _prefix_function(s: str) -> List[int]:\n    \"\"\"Compute the KMP prefix function for *s*.\n\n    Parameters\n    ----------\n    s : str\n        The input string.\n\n    Returns\n    -------\n    List[int]\n        The prefix function array where the ith element contains the\n        length of the longest proper prefix of ``s[:i+1]`` which is also a suffix.\n    \"\"\"\n    n = len(s)\n    pi: List[int] = [0] * n\n    for i in range(1, n):\n        j = pi[i - 1]\n        while j > 0 and s[i] != s[j]:\n            j = pi[j - 1]\n        if s[i] == s[j]:\n            j += 1\n        pi[i] = j\n    return pi\n\n\ndef find_Rotations(s: str) -> int:\n    \"\"\"Return the minimal positive rotation count for *s*.\n\n    The rotation count is the minimal period length of the string; rotating the\n    string by that many positions yields the original string.  For an empty\n    string the function returns 0.\n\n    Parameters\n    ----------\n    s : str\n        The string to analyze.\n\n    Returns\n    -------\n    int\n        The minimal positive rotation count.\n\n    Raises\n    ------\n    ValueError\n        If *s* is not a string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise ValueError(\"Input must be a string\")\n    n = len(s)\n    if n == 0:\n        return 0\n    pi = _prefix_function(s)\n    lps = pi[-1]\n    period = n - lps\n    if n % period != 0:\n        period = n\n    return period\n\n\nif __name__ == \"__main__\":\n    assert find_Rotations(\"abab\") == 2\n    assert find_Rotations(\"abcabc\") == 3\n    assert find_Rotations(\"abcd\") == 4\n    assert find_Rotations(\"\") == 0\n    print(\"All examples passed.\")"}
{"task_id": "Mbpp/11", "solution": "def _validate_inputs(s, c):\n    if not isinstance(s, str):\n        raise ValueError(\"Input 's' must be of type 'str'.\")\n    if not isinstance(c, str) or len(c) != 1:\n        raise ValueError(\"Input 'c' must be a single character string.\")\n\n\ndef _find_occurrence_indices(s, c):\n    first = s.find(c)\n    if first == -1:\n        return None, None\n    last = s.rfind(c)\n    return first, last\n\n\ndef _build_result_string(s, first, last):\n    if first is None:\n        return s\n    if first == last:\n        return s[:first] + s[first + 1 :]\n    return s[:first] + s[first + 1 : last] + s[last + 1 :]\n\n\ndef remove_first_last_occurrence(s: str, c: str) -> str:\n    \"\"\"\n    Remove the first and last occurrence of character `c` from string `s`.\n\n    Parameters:\n        s (str): The source string.\n        c (str): The character to remove (must be a single character).\n\n    Returns:\n        str: The string after removing the first and last occurrences of `c`.\n\n    Raises:\n        ValueError: If `s` is not a string or `c` is not a single character string.\n    \"\"\"\n    _validate_inputs(s, c)\n    first, last = _find_occurrence_indices(s, c)\n    if first is None:\n        return s\n    return _build_result_string(s, first, last)"}
{"task_id": "Mbpp/12", "solution": "def sort_matrix_by_row_sum(matrix):\n    \"\"\"\n    Sorts the rows of a two-dimensional numeric matrix in ascending order\n    based on the sum of the elements in each row. The function returns a\n    new matrix; the input matrix remains unmodified.\n\n    Parameters\n    ----------\n    matrix : list of list of numbers\n        A rectangular matrix with rows of equal length. Each element\n        must support addition.\n\n    Returns\n    -------\n    list of list of numbers\n        A new matrix with rows sorted in non-decreasing order of their sums.\n    \"\"\"\n    if not matrix:\n        return []\n\n    # Compute row sums\n    row_sums = [sum(row) for row in matrix]\n\n    # Create tuples of (sum, original index, row) for stable sorting\n    tuples = [(row_sums[i], i, matrix[i]) for i in range(len(matrix))]\n\n    # Stable sort by sum, then by original index\n    tuples.sort(key=lambda x: (x[0], x[1]))\n\n    # Assemble new matrix with copied rows to avoid side effects\n    sorted_matrix = [list(row) for (_, _, row) in tuples]\n\n    return sorted_matrix"}
{"task_id": "Mbpp/14", "solution": "\"\"\"prism_volume\n~~~~~~~~~~~~\n\nUtility module to calculate the volume of a triangular prism.\n\nFunctions\n---------\nfind_Volume(base: float, height: float, length: float) -> float\n    Compute and return the volume of a triangular prism.\n\nExample\n-------\n>>> find_Volume(10, 8, 6)\n240.0\n\"\"\"\n\nfrom __future__ import annotations\nfrom typing import Union\n\nNumeric = Union[int, float]\n\n\ndef find_Volume(base: Numeric, height: Numeric, length: Numeric) -> float:\n    \"\"\"\n    Calculate the volume of a triangular prism.\n\n    Parameters\n    ----------\n    base : Numeric\n        Length of the base of the triangular face (must be > 0).\n    height : Numeric\n        Height of the triangular face (must be > 0).\n    length : Numeric\n        Length of the prism along its axis (must be > 0).\n\n    Returns\n    -------\n    float\n        The volume of the triangular prism.\n\n    Raises\n    ------\n    ValueError\n        If any parameter is not numeric or is <= 0.\n\n    Notes\n    -----\n    Volume formula:\n        V = 0.5 * base * height * length\n\n    Examples\n    --------\n    >>> find_Volume(10, 8, 6)\n    240.0\n    \"\"\"\n    for name, value in ((\"base\", base), (\"height\", height), (\"length\", length)):\n        if not isinstance(value, (int, float)):\n            raise ValueError(f\"{name} must be numeric; got {type(value).__name__}\")\n        if value <= 0:\n            raise ValueError(f\"{name} must be positive; got {value}\")\n\n    volume = 0.5 * float(base) * float(height) * float(length)\n    return volume\n\nif __name__ == \"__main__\":\n    # Quick manual test\n    assert find_Volume(10, 8, 6) == 240.0\n    print(\"All tests passed.\")"}
{"task_id": "Mbpp/16", "solution": "def text_lowercase_underscore(input: str) -> bool:\n    \"\"\"Return True if `input` consists of one or more groups of consecutive\n    lowercase letters (a\u2013z) separated by a single underscore (_), otherwise False.\n\n    Parameters\n    ----------\n    input : str\n        The string to validate.\n\n    Returns\n    -------\n    bool\n        True if the string matches the pattern; False otherwise.\n\n    Raises\n    ------\n    TypeError\n        If `input` is not a string.\n\n    Examples\n    --------\n    >>> text_lowercase_underscore(\"aab_cbbbc\")\n    True\n    >>> text_lowercase_underscore(\"Aab_cbbbc\")\n    False\n    \"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"input must be a string\")\n\n    if not input:\n        return False\n\n    seen_underscore = False\n    prev_char = None\n\n    for c in input:\n        if c == \"_\":\n            if seen_underscore or prev_char == \"_\":\n                return False\n            seen_underscore = True\n        elif 'a' <= c <= 'z':\n            pass\n        else:\n            return False\n        prev_char = c\n\n    return seen_underscore"}
