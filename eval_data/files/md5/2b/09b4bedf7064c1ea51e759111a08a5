{"task_id": "HumanEval/139", "solution": "def factorial(k):\n    \"\"\"Calculates the factorial of a positive integer k.\n    This helper function computes k! as required by the special_factorial definition.\"\"\"\n    res = 1\n    for i in range(1, k + 1):\n        res *= i\n    return res\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    product_of_factorials = 1\n    for i in range(1, n + 1):\n        product_of_factorials *= factorial(i)\n    return product_of_factorials"}
{"task_id": "HumanEval/139", "solution": "def _factorial(k):\n    \"\"\"Calculates the standard factorial of a non-negative integer k.\n    This helper is used internally for special factorial calculations.\n    \"\"\"\n    if k == 0:\n        return 1\n    product = 1\n    for i in range(1, k + 1):\n        product *= i\n    return product\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as n! * (n-1)! * ... * 1!.\n    It calculates the product of factorials from n down to 1.\n    \"\"\"\n    # Assuming n is a positive integer as per problem statement and critical requirements.\n    special_fact_product = 1\n    for i in range(1, n + 1):\n        current_factorial = _factorial(i)\n        special_fact_product *= current_factorial\n    return special_fact_product"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Replaces single spaces with underscores and sequences of more than two consecutive spaces with a hyphen.\n    Strings with no spaces are unchanged, and two consecutive spaces become two underscores.\n    \"\"\"\n    if ' ' not in text:\n        return text\n\n    # Replace sequences of 3 or more spaces with a hyphen first.\n    transformed_text = re.sub(r' {3,}', '-', text)\n\n    # Then replace any remaining single spaces with underscores.\n    final_text = transformed_text.replace(' ', '_')\n\n    return final_text"}
{"task_id": "HumanEval/141", "solution": "def _count_digits(name: str) -> int:\n    \"\"\"Counts the number of digits in a string.\"\"\"\n    return sum(1 for char in name if char.isdigit())\ndef _has_exactly_one_dot(name: str) -> bool:\n    \"\"\"Checks if a string contains exactly one dot.\"\"\"\n    return name.count('.') == 1\ndef _get_prefix_and_extension(name: str) -> tuple[str, str]:\n    \"\"\"Splits a file name into its prefix and extension.\"\"\"\n    parts = name.split('.', 1)\n    return parts[0], parts[1]\ndef _is_prefix_not_empty(prefix: str) -> bool:\n    \"\"\"Checks if the file name prefix is not empty.\"\"\"\n    return bool(prefix)\ndef _is_prefix_starts_with_letter(prefix: str) -> bool:\n    \"\"\"Checks if the prefix starts with a latin alphabet letter.\"\"\"\n    if not prefix:\n        return False\n    return prefix[0].isalpha()\ndef _is_extension_valid(extension: str) -> bool:\n    \"\"\"Checks if the file extension is one of the allowed types.\"\"\"\n    allowed_extensions = ['txt', 'exe', 'dll']\n    return extension in allowed_extensions\ndef file_name_check(file_name: str) -> str:\n    \"\"\"\n    Checks if a file name is valid based on a set of rules.\n    Returns 'Yes' if the file's name is valid, and 'No' otherwise.\n    \"\"\"\n    if _count_digits(file_name) > 3:\n        return 'No'\n\n    if not _has_exactly_one_dot(file_name):\n        return 'No'\n\n    prefix, extension = _get_prefix_and_extension(file_name)\n\n    if not _is_prefix_not_empty(prefix):\n        return 'No'\n\n    if not _is_prefix_starts_with_letter(prefix):\n        return 'No'\n\n    if not _is_extension_valid(extension):\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/141", "solution": "import re\nfrom typing import Tuple, Optional\nclass FileNameValidator:\n    \"\"\"Encapsulates file name validation logic.\"\"\"\n\n    def __init__(self):\n        \"\"\"Initializes allowed extensions and a regex pattern for Latin alphabet letters.\"\"\"\n        self._allowed_extensions = {'txt', 'exe', 'dll'}\n        self._latin_alphabet_pattern = re.compile(r'^[a-zA-Z]')\n\n    def is_valid(self, file_name: str) -> bool:\n        \"\"\"Orchestrates all validation checks for a given file name.\"\"\"\n        if not self._check_digit_count(file_name):\n            return False\n\n        has_one_dot, dot_index = self._check_single_dot(file_name)\n        if not has_one_dot:\n            return False\n\n        # dot_index is guaranteed to be not None here if has_one_dot is True\n        prefix = file_name[:dot_index]\n        suffix = file_name[dot_index + 1:]\n\n        if not self._check_prefix_not_empty(prefix):\n            return False\n\n        if not self._check_prefix_starts_with_letter(prefix):\n            return False\n\n        if not self._check_valid_suffix(suffix):\n            return False\n\n        return True\n\n    def _check_digit_count(self, file_name: str) -> bool:\n        \"\"\"Checks if the file name contains no more than three digits.\"\"\"\n        digit_count = 0\n        for char in file_name:\n            if char.isdigit():\n                digit_count += 1\n        return digit_count <= 3\n\n    def _check_single_dot(self, file_name: str) -> Tuple[bool, Optional[int]]:\n        \"\"\"Checks if the file name contains exactly one dot and returns its index.\"\"\"\n        dot_indices = [i for i, char in enumerate(file_name) if char == '.']\n        if len(dot_indices) == 1:\n            return True, dot_indices[0]\n        return False, None\n\n    def _check_prefix_not_empty(self, prefix: str) -> bool:\n        \"\"\"Checks if the prefix substring is not empty.\"\"\"\n        return len(prefix) > 0\n\n    def _check_prefix_starts_with_letter(self, prefix: str) -> bool:\n        \"\"\"Checks if the prefix substring starts with a Latin alphabet letter.\"\"\"\n        return bool(self._latin_alphabet_pattern.match(prefix))\n\n    def _check_valid_suffix(self, suffix: str) -> bool:\n        \"\"\"Checks if the suffix is one of the allowed extensions.\"\"\"\n        return suffix in self._allowed_extensions\ndef file_name_check(file_name: str) -> str:\n    \"\"\"\n    Checks if a file name is valid based on predefined rules.\n    Returns 'Yes' if valid, 'No' otherwise.\n    \"\"\"\n    validator = FileNameValidator()\n    if validator.is_valid(file_name):\n        return 'Yes'\n    return 'No'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    This function processes a list of integers, squaring elements at indices\n    multiples of 3, cubing elements at indices multiples of 4 (but not 3),\n    and then returns the sum of all modified elements.\n    \"\"\"\n    total_sum = 0\n    for index, value in enumerate(lst):\n        if index % 3 == 0:\n            total_sum += value * value\n        elif index % 4 == 0:\n            total_sum += value * value * value\n        else:\n            total_sum += value\n    return total_sum"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text: str) -> str:\n    \"\"\"\n    Replaces single spaces with underscores and sequences of three or more consecutive spaces with a single hyphen.\n    Sequences of exactly two spaces are left unchanged.\n    \"\"\"\n    def replacement_logic(match):\n        # If group 1 (three or more spaces) matched, replace it with a hyphen.\n        if match.group(1):\n            return '-'\n        # If group 2 (a single space) matched, replace it with an underscore.\n        elif match.group(2):\n            return '_'\n        # This fallback handles cases not explicitly covered, but for this pattern, one of the groups will always match.\n        return match.group(0)\n\n    # The regex pattern matches either three or more spaces (group 1) or a single space (group 2).\n    # Sequences of exactly two spaces are intentionally not matched and thus remain unchanged.\n    return re.sub(r'( {3,})|( )', replacement_logic, text)"}
{"task_id": "HumanEval/142", "solution": "from typing import List\nclass IntegerEntry:\n    \"\"\"Represents an integer value at a specific index and provides transformation methods.\"\"\"\n    def __init__(self, value: int, index: int):\n        self._value = value\n        self._index = index\n\n    def square(self) -> int:\n        \"\"\"Returns the square of the entry's value.\"\"\"\n        return self._value ** 2\n\n    def cube(self) -> int:\n        \"\"\"Returns the cube of the entry's value.\"\"\"\n        return self._value ** 3\n\n    def get_processed_value(self) -> int:\n        \"\"\"Applies transformation rules based on the index to return the processed value.\n        It squares if index is a multiple of 3, cubes if a multiple of 4 (and not 3), or returns the original value.\n        \"\"\"\n        if self._index % 3 == 0:\n            return self.square()\n        elif self._index % 4 == 0:\n            return self.cube()\n        else:\n            return self._value\nclass IntegerList:\n    \"\"\"Manages a collection of IntegerEntry objects.\"\"\"\n    def __init__(self, raw_list: List[int]):\n        self._entries: List[IntegerEntry] = [\n            IntegerEntry(value, index) for index, value in enumerate(raw_list)\n        ]\n\n    def is_empty(self) -> bool:\n        \"\"\"Returns True if the list of entries is empty, False otherwise.\"\"\"\n        return len(self._entries) == 0\n\n    def get_entries(self) -> List[IntegerEntry]:\n        \"\"\"Returns the list of IntegerEntry objects.\"\"\"\n        return self._entries\ndef sum_squares(lst: List[int]) -> int:\n    \"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n\n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    integer_list = IntegerList(lst)\n\n    if integer_list.is_empty():\n        return 0\n\n    total_sum = 0\n    for entry in integer_list.get_entries():\n        total_sum += entry.get_processed_value()\n\n    return total_sum"}
{"task_id": "HumanEval/143", "solution": "def is_prime(number: int) -> bool:\n    \"\"\"\n    Determines if a given integer is a prime number.\n    Handles edge cases for numbers less than or equal to 1, and efficiently checks divisibility.\n    \"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Filters words from a sentence, keeping only those whose lengths are prime numbers.\n    The original order of words is maintained.\n    \"\"\"\n    words = sentence.split()\n    filtered_words = []\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n    return ' '.join(filtered_words)"}
{"task_id": "HumanEval/143", "solution": "import math\nclass PrimeNumberChecker:\n    \"\"\"\n    Provides a utility method to check if a given integer is a prime number.\n    It is stateless.\n    \"\"\"\n    def is_prime(self, number: int) -> bool:\n        \"\"\"\n        Returns True if the number is prime, False otherwise.\n        Handles common cases for primality testing efficiently.\n        \"\"\"\n        if number <= 1:\n            return False\n        if number == 2:\n            return True\n        if number % 2 == 0:\n            return False\n\n        # Check for factors from 3 up to sqrt(number)\n        limit = int(math.sqrt(number))\n        for i in range(3, limit + 1, 2):\n            if number % i == 0:\n                return False\n        return True\nclass Word:\n    \"\"\"\n    Represents a single word, storing its text and length.\n    It can determine if its length is prime using a PrimeNumberChecker.\n    \"\"\"\n    def __init__(self, text: str):\n        \"\"\"Initializes the Word with its text and calculates its length.\"\"\"\n        self._text = text\n        self._length = len(text)\n\n    def get_text(self) -> str:\n        \"\"\"Returns the word's text.\"\"\"\n        return self._text\n\n    def get_length(self) -> int:\n        \"\"\"Returns the word's length.\"\"\"\n        return self._length\n\n    def is_length_prime(self, prime_checker: 'PrimeNumberChecker') -> bool:\n        \"\"\"\n        Determines if the word's length is a prime number.\n        It uses a PrimeNumberChecker instance for the check.\n        \"\"\"\n        return prime_checker.is_prime(self._length)\nclass Sentence:\n    \"\"\"\n    Represents a sentence and provides methods to split it into words.\n    It holds the original sentence string.\n    \"\"\"\n    def __init__(self, text: str):\n        \"\"\"Initializes the Sentence with the given text.\"\"\"\n        self._text = text\n\n    def split_into_words(self) -> list[Word]:\n        \"\"\"\n        Splits the sentence text into Word objects based on spaces.\n        Returns a list of Word objects, filtering out any empty strings.\n        \"\"\"\n        return [Word(w) for w in self._text.split(' ') if w]\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    You are given a string representing a sentence,\n    the sentence contains some words separated by a space,\n    and you have to return a string that contains the words from the original sentence,\n    whose lengths are prime numbers,\n    the order of the words in the new string should be the same as the original one.\n\n    Example 1:\n        Input: sentence = \"This is a test\"\n        Output: \"is\"\n\n    Example 2:\n        Input: sentence = \"lets go for swimming\"\n        Output: \"go for\"\n\n    Constraints:\n        * 1 <= len(sentence) <= 100\n        * sentence contains only letters\n    \"\"\"\n    prime_checker = PrimeNumberChecker()\n    sentence_obj = Sentence(sentence)\n    words = sentence_obj.split_into_words()\n\n    filtered_words_text = []\n    for word_obj in words:\n        if word_obj.is_length_prime(prime_checker):\n            filtered_words_text.append(word_obj.get_text())\n\n    return ' '.join(filtered_words_text)"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    \"\"\"Encapsulates a fraction's numerator and denominator, providing methods for parsing, multiplication, and checking for whole number property.\"\"\"\n    def __init__(self, fraction_str: str):\n        \"\"\"Parses a fraction string (e.g., \"1/5\") into integer numerator and denominator.\"\"\"\n        num_str, den_str = fraction_str.split('/')\n        self.numerator = int(num_str)\n        self.denominator = int(den_str)\n\n    def multiply(self, other: 'Fraction') -> 'Fraction':\n        \"\"\"Returns a new Fraction object representing the product of this fraction and another.\"\"\"\n        product_numerator = self.numerator * other.numerator\n        product_denominator = self.denominator * other.denominator\n        return Fraction(f\"{product_numerator}/{product_denominator}\")\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Determines if the fraction represents a whole number.\"\"\"\n        return self.numerator % self.denominator == 0\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"Checks if the product of two fractions, x and n, evaluates to a whole number.\n    It returns True for a whole number product and False otherwise.\"\"\"\n    fraction_x = Fraction(x)\n    fraction_n = Fraction(n)\n    product_fraction = fraction_x.multiply(fraction_n)\n    return product_fraction.is_whole_number()"}
{"task_id": "HumanEval/144", "solution": "def parse_fraction(fraction_str: str) -> tuple[int, int]:\n    \"\"\"\n    Parses a fraction string into its numerator and denominator.\n    Assumes valid input format and positive whole numbers.\n    \"\"\"\n    parts = fraction_str.split('/')\n    numerator = int(parts[0])\n    denominator = int(parts[1])\n    return (numerator, denominator)\ndef gcd(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the greatest common divisor of two non-negative integers\n    using the Euclidean algorithm.\n    \"\"\"\n    while b:\n        a, b = b, a % b\n    return a\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"\n    Determines if the product of two fractions x and n is a whole number.\n    Fractions are provided as strings in \"<numerator>/<denominator>\" format.\n    \"\"\"\n    num_x, den_x = parse_fraction(x)\n    num_n, den_n = parse_fraction(n)\n\n    product_num = num_x * num_n\n    product_den = den_x * den_n\n\n    common_divisor = gcd(product_num, product_den)\n\n    simplified_den = product_den // common_divisor\n\n    return simplified_den == 1"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Filters numbers based on criteria and returns a count.\"\"\"\n\n    def _is_greater_than_ten(num: int) -> bool:\n        \"\"\"Checks if a number is strictly greater than 10.\"\"\"\n        return num > 10\n\n    def _get_first_digit(num: int) -> int:\n        \"\"\"Extracts the absolute value of the first digit of a number.\"\"\"\n        return int(str(abs(num))[0])\n\n    def _get_last_digit(num: int) -> int:\n        \"\"\"Extracts the absolute value of the last digit of a number.\"\"\"\n        return abs(num) % 10\n\n    def _is_odd(digit: int) -> bool:\n        \"\"\"Checks if the absolute value of a digit is odd.\"\"\"\n        return abs(digit) % 2 != 0\n\n    def _is_first_digit_odd(num: int) -> bool:\n        \"\"\"Checks if the absolute value of the first digit of a number is odd.\"\"\"\n        first_digit = _get_first_digit(num)\n        return _is_odd(first_digit)\n\n    def _is_last_digit_odd(num: int) -> bool:\n        \"\"\"Checks if the absolute value of the last digit of a number is odd.\"\"\"\n        last_digit = _get_last_digit(num)\n        return _is_odd(last_digit)\n\n    def _is_special_number(num: int) -> bool:\n        \"\"\"Determines if a number meets all three special filter criteria.\"\"\"\n        return (\n            _is_greater_than_ten(num) and\n            _is_first_digit_odd(num) and\n            _is_last_digit_odd(num)\n        )\n\n    count = 0\n    for num in nums:\n        if _is_special_number(num):\n            count += 1\n    return count"}
{"task_id": "HumanEval/145", "solution": "def _sum_digits(n: int) -> int:\n    \"\"\"Calculates the sum of the absolute digits of an integer.\n    Returns 0 if n is 0.\n    \"\"\"\n    abs_n = abs(n)\n    sum_val = 0\n    for digit_char in str(abs_n):\n        sum_val += int(digit_char)\n    return sum_val\ndef order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"Sorts a list of integers by sum of absolute digits then by original index.\n    Utilizes the Decorate-Sort-Undecorate pattern.\n    \"\"\"\n    if not nums:\n        return []\n\n    # Decorate step: augment numbers with sorting keys (sum_of_digits, original_index)\n    decorated_nums = []\n    for index, num in enumerate(nums):\n        sum_of_digits = _sum_digits(num)\n        decorated_nums.append((sum_of_digits, index, num))\n\n    # Sort step: Python's default tuple sorting handles primary and secondary criteria\n    decorated_nums.sort()\n\n    # Undecorate step: extract original numbers from sorted tuples\n    result = [num for sum_of_digits, index, num in decorated_nums]\n\n    return result"}
{"task_id": "HumanEval/146", "solution": "def _is_odd(digit: int) -> bool:\n    \"\"\"Checks if a digit's absolute value is odd.\n    Returns True if odd, False otherwise.\n    \"\"\"\n    return abs(digit) % 2 != 0\ndef _get_last_digit(number: int) -> int:\n    \"\"\"Extracts the last digit of a number.\n    Uses the absolute value of the number.\n    \"\"\"\n    return abs(number) % 10\ndef _get_first_digit(number: int) -> int:\n    \"\"\"Extracts the first digit of a number.\n    Uses the absolute value of the number.\n    \"\"\"\n    if number == 0:\n        return 0\n    return int(str(abs(number))[0])\ndef _is_greater_than_ten(number: int) -> bool:\n    \"\"\"Checks if a number is strictly greater than 10.\n    Returns True if it is, False otherwise.\n    \"\"\"\n    return number > 10\ndef specialFilter(nums: list[int]) -> int:\n    \"\"\"Counts numbers greater than 10 with odd first and last digits.\n    Iterates through the list, applying specified filtering rules.\n    \"\"\"\n    count = 0\n    for number in nums:\n        if _is_greater_than_ten(number):\n            first_digit = _get_first_digit(number)\n            if _is_odd(first_digit):\n                last_digit = _get_last_digit(number)\n                if _is_odd(last_digit):\n                    count += 1\n    return count"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers based on the sum of their digits, then by original index.\n    This function adheres to the detailed design specification provided.\n    \"\"\"\n\n    def calculate_digit_sum(num: int) -> int:\n        \"\"\"Calculates the sum of the absolute digits of an integer.\"\"\"\n        s = 0\n        temp_num = abs(num)\n        while temp_num > 0:\n            s += temp_num % 10\n            temp_num //= 10\n        return s\n\n    class SortableInteger:\n        \"\"\"Helper class to encapsulate value, original index, and digit sum for custom sorting.\"\"\"\n        def __init__(self, value: int, original_index: int, digit_sum: int):\n            self.value = value\n            self.original_index = original_index\n            self.digit_sum = digit_sum\n\n        def __lt__(self, other: 'SortableInteger') -> bool:\n            \"\"\"Compares SortableInteger objects first by digit sum, then by original index.\"\"\"\n            if self.digit_sum < other.digit_sum:\n                return True\n            elif self.digit_sum == other.digit_sum:\n                return self.original_index < other.original_index\n            return False\n\n    enriched_nums = []\n    for index, num in enumerate(nums):\n        current_digit_sum = calculate_digit_sum(num)\n        enriched_nums.append(SortableInteger(num, index, current_digit_sum))\n\n    enriched_nums.sort()\n\n    result_list = [obj.value for obj in enriched_nums]\n    return result_list"}
{"task_id": "HumanEval/147", "solution": "def _calculate_sequence_element(i: int) -> int:\n    \"\"\"Calculates a single sequence element a[i] based on its 1-indexed position.\"\"\"\n    return i * i - i + 1\ndef get_max_triples(n: int) -> int:\n    \"\"\"\n    Generates a sequence and counts triples (a[i], a[j], a[k]) such that i < j < k\n    and their sum is a multiple of 3.\n    \"\"\"\n    valid_triples_count = 0\n    sequence_a = []\n\n    # Generate the sequence a, where a[0] stores the value for i=1, a[1] for i=2, etc.\n    for i_val in range(1, n + 1):\n        sequence_a.append(_calculate_sequence_element(i_val))\n\n    # Iterate through all unique combinations of three distinct 0-indexed positions (list_i, list_j, list_k)\n    # ensuring list_i < list_j < list_k\n    for list_i in range(n - 2):\n        for list_j in range(list_i + 1, n - 1):\n            for list_k in range(list_j + 1, n):\n                # Retrieve the corresponding values from the sequence\n                val_i = sequence_a[list_i]\n                val_j = sequence_a[list_j]\n                val_k = sequence_a[list_k]\n\n                # Calculate their sum and check if it's a multiple of 3\n                current_sum = val_i + val_j + val_k\n                if current_sum % 3 == 0:\n                    valid_triples_count += 1\n\n    return valid_triples_count"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Counts triples (a[i], a[j], a[k]) such that i < j < k and a[i] + a[j] + a[k] is a multiple of 3.\n    The function a[x] = x*x - x + 1 is analyzed based on its modulo 3 property.\n    \"\"\"\n    count0 = 0  # Counts numbers x where a[x] % 3 == 0 (i.e., x % 3 == 2)\n    count1 = 0  # Counts numbers x where a[x] % 3 == 1 (i.e., x % 3 == 0 or x % 3 == 1)\n\n    for x in range(1, n + 1):\n        if x % 3 == 2:\n            count0 += 1\n        else:\n            count1 += 1\n\n    # Calculate combinations C(N, 3) = N * (N - 1) * (N - 2) / 6\n    # If N < 3, combinations should be 0. The formula handles this if we consider 0 for negative terms.\n\n    triples_000 = 0\n    if count0 >= 3:\n        triples_000 = count0 * (count0 - 1) * (count0 - 2) // 6\n\n    triples_111 = 0\n    if count1 >= 3:\n        triples_111 = count1 * (count1 - 1) * (count1 - 2) // 6\n\n    return triples_000 + triples_111"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1: str, planet2: str) -> tuple[str, ...]:\n    '''\n    There are eight planets in our solar system: the closerst to the Sun\n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn,\n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2.\n    The function should return a tuple containing all planets whose orbits are\n    located between the orbit of planet1 and the orbit of planet2, sorted by\n    the proximity to the sun.\n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names.\n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    from typing import Dict, List\n\n    class Planet:\n        \"\"\"Stores a planet's name and its orbital order from the Sun.\"\"\"\n        def __init__(self, name: str, order: int):\n            self.name: str = name\n            self.order: int = order\n\n    class SolarSystem:\n        \"\"\"Manages the canonical list of planets and provides methods to retrieve subsets.\"\"\"\n        def __init__(self):\n            # Initializes the SolarSystem with the predefined eight planets.\n            planet_names_in_order = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\n            self._planets_ordered: List[Planet] = []\n            self._planets_by_name: Dict[str, Planet] = {}\n\n            for i, name in enumerate(planet_names_in_order):\n                planet = Planet(name, i)\n                self._planets_ordered.append(planet)\n                self._planets_by_name[name] = planet\n\n        def get_planets_between(self, planet1_name: str, planet2_name: str) -> tuple[str, ...]:\n            \"\"\"Returns planet names between two specified planets, sorted by proximity to the Sun.\"\"\"\n            if planet1_name not in self._planets_by_name or planet2_name not in self._planets_by_name:\n                return ()\n\n            p1 = self._planets_by_name[planet1_name]\n            p2 = self._planets_by_name[planet2_name]\n\n            start_order = min(p1.order, p2.order)\n            end_order = max(p1.order, p2.order)\n\n            result_names = []\n            for planet in self._planets_ordered:\n                if start_order < planet.order < end_order:\n                    result_names.append(planet.name)\n\n            return tuple(result_names)\n\n    # Initialize the SolarSystem instance once at the module level.\n    _solar_system_instance = SolarSystem()\n\n    return _solar_system_instance.get_planets_between(planet1, planet2)"}
{"task_id": "HumanEval/148", "solution": "_PLANETS_ORDER = (\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\")\ndef bf(planet1, planet2):\n    \"\"\"\n    Identifies planets strictly between two specified planets, ordered by proximity to the Sun.\n    Returns an empty tuple if either input planet name is invalid.\n    \"\"\"\n    if planet1 not in _PLANETS_ORDER or planet2 not in _PLANETS_ORDER:\n        return ()\n\n    index1 = _PLANETS_ORDER.index(planet1)\n    index2 = _PLANETS_ORDER.index(planet2)\n\n    start_index = min(index1, index2)\n    end_index = max(index1, index2)\n\n    # Extract planets strictly between start_index and end_index (exclusive).\n    return _PLANETS_ORDER[start_index + 1 : end_index]"}
{"task_id": "HumanEval/149", "solution": "def _is_odd_length(s: str) -> bool:\n    \"\"\"Checks if a string has an odd length.\n    Returns True if the length is odd, False otherwise.\n    \"\"\"\n    return len(s) % 2 != 0\ndef _custom_sort_key(s: str) -> tuple[int, str]:\n    \"\"\"Generates a sorting key for a string based on its length and alphabetical order.\n    Returns a tuple (length, string) for sorting.\n    \"\"\"\n    return (len(s), s)\ndef sorted_list_sum(lst: list[str]) -> list[str]:\n    \"\"\"Filters a list of strings to keep only even-length strings, then sorts them.\n    Sorting is first by length ascending, then alphabetically for same-length strings.\n    \"\"\"\n    filtered_list = [s for s in lst if not _is_odd_length(s)]\n    sorted_result = sorted(filtered_list, key=_custom_sort_key)\n    return sorted_result"}
{"task_id": "HumanEval/149", "solution": "from typing import List\ndef sorted_list_sum(lst: List[str]) -> List[str]:\n    \"\"\"Filters a list of strings to keep only even-length strings.\n    It then sorts the remaining strings by length and then alphabetically.\"\"\"\n\n    # Filter out strings with odd lengths\n    filtered_list = [s for s in lst if len(s) % 2 == 0]\n\n    # Sort the filtered list primarily by length (ascending), then alphabetically (ascending)\n    filtered_list.sort(key=lambda s: (len(s), s))\n\n    return filtered_list"}
{"task_id": "HumanEval/150", "solution": "def _is_prime(n):\n    \"\"\"\n    Determines if an integer n is a prime number.\n    A prime number is an integer greater than 1 that has no positive divisors other than 1 and itself.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef x_or_y(n, x, y):\n    \"\"\"\n    Returns the value x if n is a prime number, and y otherwise.\n    This function orchestrates the primality check.\n    \"\"\"\n    if _is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/150", "solution": "import math\ndef is_prime(num: int) -> bool:\n    \"\"\"Determines if an integer is a prime number using an optimized algorithm.\n    It handles edge cases and checks only odd divisors up to its square root.\"\"\"\n    if num <= 1:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n\n    for i in range(3, int(math.sqrt(num)) + 1, 2):\n        if num % i == 0:\n            return False\n    return True\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n\n    \"\"\"\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/151", "solution": "def _is_valid_odd_integer(num):\n    # Checks if num is a non-negative, odd integer value.\n    # It relies on arithmetic properties, assuming num is numeric.\n    return num >= 0 and num % 2 != 0 and num % 1 == 0\ndef _square(num):\n    # Calculates the square of a number and returns it as an integer.\n    # Assumes num is an integer or an integer-valued float.\\\n    return int(num * num)\ndef double_the_difference(lst):\n    # Calculates the sum of squares of non-negative odd integers in the list.\n    # Returns 0 if the input list is empty.\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for element in lst:\n        if isinstance(element, (int, float)) and _is_valid_odd_integer(element):\n            total_sum += _square(element)\n    return total_sum"}
{"task_id": "HumanEval/152", "solution": "def compare(game: list[int], guess: list[int]) -> list[int]:\n    \"\"\"\n    Compares two lists of integers element-wise, returning a new list.\n    For matching elements, 0 is returned; otherwise, the absolute difference is calculated.\n    \"\"\"\n    result = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            result.append(0)\n        else:\n            result.append(abs(game[i] - guess[i]))\n    return result"}
{"task_id": "HumanEval/152", "solution": "def compare(game, guess):\n    \"\"\"\n    Compares actual game scores with guessed scores and calculates the difference for each match.\n    Returns a list indicating how far off each guess was.\n    \"\"\"\n    differences = []\n    for game_score, guess_score in zip(game, guess):\n        if game_score == guess_score:\n            differences.append(0)\n        else:\n            differences.append(abs(game_score - guess_score))\n    return differences"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension from a list based on character case counts.\n    Returns the class name concatenated with the strongest extension name.\"\"\"\n    if not extensions:\n        return class_name\n\n    strongest_ext_name = \"\"\n    max_strength = -float('inf')\n\n    for ext_name in extensions:\n        current_strength = _calculate_strength(ext_name)\n\n        # The tie-breaking rule (first in list) is implicitly handled here:\n        # if current_strength is equal, the existing strongest_ext_name is kept.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_ext_name = ext_name\n\n    return f\"{class_name}.{strongest_ext_name}\"\ndef _calculate_strength(extension_name: str) -> int:\n    \"\"\"Calculates the strength of an extension as (uppercase count - lowercase count).\"\"\"\n    cap_count = sum(1 for char in extension_name if 'A' <= char <= 'Z')\n    sm_count = sum(1 for char in extension_name if 'a' <= char <= 'z')\n    return cap_count - sm_count"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Calculates the sum of squares of odd numbers from a list.\n    Ignores non-integer, negative, or non-odd numbers, returning 0 for an empty list.\n    \"\"\"\n\n    def is_empty(number_list):\n        \"\"\"Checks if a given list is empty.\"\"\"\n        return len(number_list) == 0\n\n    def is_integer(num):\n        \"\"\"Determines if a number is an integer type.\"\"\"\n        return isinstance(num, int)\n\n    def is_negative(num):\n        \"\"\"Determines if a number is less than zero.\"\"\"\n        return num < 0\n\n    def is_odd(num):\n        \"\"\"Determines if an integer is odd.\"\"\"\n        return num % 2 != 0\n\n    def get_square(num):\n        \"\"\"Returns the square of an integer.\"\"\"\n        return num * num\n\n    if is_empty(lst):\n        return 0\n\n    total_sum = 0\n    for number in lst:\n        if is_integer(number):\n            if not is_negative(number):\n                if is_odd(number):\n                    total_sum += get_square(number)\n    return total_sum"}
{"task_id": "HumanEval/153", "solution": "from dataclasses import dataclass\nfrom typing import List, Optional\ndef _calculate_strength(extension_name: str) -> int:\n    \"\"\"Calculates the strength of a single extension string.\n    Counts uppercase and lowercase characters and returns CAP - SM.\"\"\"\n    cap_count = sum(1 for char in extension_name if 'A' <= char <= 'Z')\n    sm_count = sum(1 for char in extension_name if 'a' <= char <= 'z')\n    return cap_count - sm_count\ndef Strongest_Extension(class_name: str, extensions: List[str]) -> str:\n    \"\"\"Finds the strongest extension from the list and formats the output.\n    Returns \"ClassName.StrongestExtensionName\" or \"ClassName.NoExtensionFound\" for an empty list.\"\"\"\n    if not extensions:\n        return class_name + \".NoExtensionFound\"\n\n    strongest_extension_info: Optional[ExtensionInfo] = None\n\n    for i, ext_name in enumerate(extensions):\n        strength = _calculate_strength(ext_name)\n        current_extension_info = ExtensionInfo(name=ext_name, strength=strength, original_index=i)\n\n        if strongest_extension_info is None:\n            strongest_extension_info = current_extension_info\n        elif current_extension_info.strength > strongest_extension_info.strength:\n            strongest_extension_info = current_extension_info\n        elif current_extension_info.strength == strongest_extension_info.strength:\n            # Tie-breaking: choose the one that comes first in the list (FR5)\n            if current_extension_info.original_index < strongest_extension_info.original_index:\n                strongest_extension_info = current_extension_info\n\n    return f\"{class_name}.{strongest_extension_info.name}\""}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a, b):\n    \"\"\"Checks if any cyclic rotation of string `b` is a substring of string `a`.\n    Returns True if a match is found, False otherwise.\"\"\"\n    if not b:\n        return True\n    if len(b) > len(a):\n        return False\n\n    b_len = len(b)\n    for i in range(b_len):\n        rotated_b = b[i:] + b[:i]\n        if rotated_b in a:\n            return True\n\n    return False"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n    # Convert the absolute value of the number to a string to iterate through digits.\n    abs_num_str = str(abs(num))\n\n    for digit_char in abs_num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a: str, b: str) -> bool:\n    \"\"\"Checks if string 'b' or any of its rotations is a substring in 'a'. Returns True if found, False otherwise.\"\"\"\n    # Handle cases where b is longer than a.\n    if len(b) > len(a):\n        return False\n\n    # An empty string is considered a substring of any string.\n    if not b:\n        return True\n\n    # Create a doubled version of 'b' to easily check for cyclic rotations.\n    b_double = b + b\n\n    # Iterate through 'a' to find substrings of length len(b).\n    for i in range(len(a) - len(b) + 1):\n        sub_a = a[i : i + len(b)]\n        # If the substring from 'a' is a rotation of 'b', return True.\n        if sub_a in b_double:\n            return True\n\n    # If no rotation of 'b' is found as a substring, return False.\n    return False"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    num_str = str(abs(num))\n    even_count = 0\n    odd_count = 0\n\n    for digit_char in num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "ROMAN_MAP = [\n    (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n    (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n    (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'),\n    (1, 'i')\n]\ndef _convert_to_roman(number: int) -> str:\n    \"\"\"\n    Converts a valid integer to its Roman numeral string representation.\n    This function generates lowercase output.\n    \"\"\"\n    roman_numeral_parts = []\n    for value, symbol in ROMAN_MAP:\n        while number >= value:\n            roman_numeral_parts.append(symbol)\n            number -= value\n    return \"\".join(roman_numeral_parts)\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    return _convert_to_roman(number)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number: int) -> str:\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    # Validate input range (1-1000) as specified in the design.\n    if not (1 <= number <= 1000):\n        raise ValueError(\"Number out of range (1-1000)\")\n\n    # Define Roman numeral value-symbol pairs, ordered largest to smallest.\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'),\n        (1, 'I')\n    ]\n\n    result_parts = []\n\n    for value, symbol in roman_map:\n        while number >= value:\n            result_parts.append(symbol)\n            number -= value\n\n    return \"\".join(result_parts).lower()"}
{"task_id": "HumanEval/157", "solution": "def are_nearly_equal(val1: float, val2: float, tolerance: float = 1e-9) -> bool:\n    \"\"\"\n    Compares two floating-point numbers for approximate equality within a given tolerance.\n    \"\"\"\n    return abs(val1 - val2) < tolerance\nclass Triangle:\n    \"\"\"\n    Represents a triangle with three side lengths and provides logic\n    to determine if it is a right-angled triangle.\n    \"\"\"\n    def __init__(self, a: float, b: float, c: float):\n        self._sideA = a\n        self._sideB = b\n        self._sideC = c\n\n    def is_right_angled(self) -> bool:\n        \"\"\"\n        Determines if the triangle is right-angled using the Pythagorean theorem.\n        \"\"\"\n        sides = sorted([self._sideA, self._sideB, self._sideC])\n        a_sq = sides[0] ** 2\n        b_sq = sides[1] ** 2\n        c_sq = sides[2] ** 2 # Longest side\n\n        return are_nearly_equal(c_sq, a_sq + b_sq)\ndef right_angle_triangle(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    \"\"\"\n    triangle = Triangle(a, b, c)\n    return triangle.is_right_angled()"}
{"task_id": "HumanEval/157", "solution": "import math\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # Sort the sides to easily identify the potential hypotenuse.\n    sides = sorted([a, b, c])\n    side1, side2, hypotenuse = sides[0], sides[1], sides[2]\n\n    # Use math.isclose for robust floating-point comparison.\n    epsilon = 1e-9\n    return math.isclose(side1**2 + side2**2, hypotenuse**2, rel_tol=epsilon)"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates total carrots eaten and remaining stock after a rabbit's meal.\n    The rabbit eats what it needs if available, otherwise all remaining carrots.\n    \"\"\"\n    if need <= remaining:\n        total_eaten_carrots = number + need\n        carrots_left_in_stock = remaining - need\n    else:\n        total_eaten_carrots = number + remaining\n        carrots_left_in_stock = 0\n\n    return [total_eaten_carrots, carrots_left_in_stock]"}
{"task_id": "HumanEval/158", "solution": "import collections\nclass Word:\n    \"\"\"\n    Encapsulates a string's value, unique character count, and comparison logic.\n    \"\"\"\n    def __init__(self, value: str):\n        \"\"\"\n        Initializes the Word object.\n        \"\"\"\n        self._value = value\n        self._unique_char_count = None\n\n    @property\n    def value(self) -> str:\n        \"\"\"\n        Returns the raw string value.\n        \"\"\"\n        return self._value\n\n    def get_unique_character_count(self) -> int:\n        \"\"\"\n        Calculates and caches the number of unique characters.\n        \"\"\"\n        if self._unique_char_count is None:\n            self._unique_char_count = len(collections.Counter(self._value))\n        return self._unique_char_count\n\n    def __lt__(self, other: 'Word') -> bool:\n        \"\"\"\n        Enables lexicographical 'less than' comparison.\n        \"\"\"\n        return self._value < other._value\n\n    def __eq__(self, other: object) -> bool:\n        \"\"\"\n        Enables equality comparison based on string value.\n        \"\"\"\n        return self._value == other._value\n\n    def __hash__(self) -> int:\n        \"\"\"\n        Enables hashing based on string value.\n        \"\"\"\n        return hash(self._value)\n\n    def __repr__(self) -> str:\n        \"\"\"\n        Provides a string representation for debugging.\n        \"\"\"\n        return f\"Word('{self._value}')\"\ndef find_max(words: list[str]) -> str:\n    \"\"\"\n    Finds the string with the maximum unique characters, applying lexicographical tie-breaking.\n    \"\"\"\n    if not words:\n        return \"\" # Handles empty input list.\n\n    max_word_obj: Word | None = None\n    max_unique_count: int = -1\n\n    for word_str in words:\n        current_word_obj = Word(word_str)\n        current_unique_count = current_word_obj.get_unique_character_count()\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            max_word_obj = current_word_obj\n        elif current_unique_count == max_unique_count:\n            if max_word_obj is None or current_word_obj < max_word_obj:\n                max_word_obj = current_word_obj\n\n    return max_word_obj.value if max_word_obj else \"\""}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n\n    find_max([\"name\", \"of\", \"string\"]) == \"string\"\n    find_max([\"name\", \"enam\", \"game\"]) == \"enam\"\n    find_max([\"aaaaaaa\", \"bb\" ,\"cc\"]) == \"\"aaaaaaa\"\n    \"\"\"\n    if not words:\n        return \"\"\n\n    result_word = words[0]\n    max_unique_chars_count = len(set(words[0]))\n\n    for i in range(1, len(words)):\n        word = words[i]\n        current_unique_chars_count = len(set(word))\n\n        if current_unique_chars_count > max_unique_chars_count:\n            max_unique_chars_count = current_unique_chars_count\n            result_word = word\n        elif current_unique_chars_count == max_unique_chars_count:\n            if word < result_word:\n                result_word = word\n    return result_word"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates carrot consumption and remaining stock based on current eaten, needed, and available carrots.\n    Returns total eaten and total remaining after the meal as a list of two integers.\n    \"\"\"\n    if need <= remaining:\n        carrots_eaten_this_meal = need\n        carrots_left_after_meal = remaining - need\n    else:\n        carrots_eaten_this_meal = remaining\n        carrots_left_after_meal = 0\n\n    total_eaten = number + carrots_eaten_this_meal\n    return [total_eaten, carrots_left_after_meal]"}
{"task_id": "HumanEval/161", "solution": "def _is_alphabetic(char: str) -> bool:\n    \"\"\"Checks if a character is an alphabetic letter.\"\"\"\n    return char.isalpha()\ndef _reverse_char_case(char: str) -> str:\n    \"\"\"Reverses the case of an alphabetic character.\n    Assumes the input character is already identified as alphabetic.\"\"\"\n    if char.islower():\n        return char.upper()\n    else: # char.isupper()\n        return char.lower()\ndef _has_letters(s: str) -> bool:\n    \"\"\"Checks if the string contains any alphabetic letters.\"\"\"\n    for char in s:\n        if _is_alphabetic(char):\n            return True\n    return False\ndef _reverse_string(s: str) -> str:\n    \"\"\"Reverses the entire string.\"\"\"\n    return s[::-1]\ndef solve(s: str) -> str:\n    \"\"\"Processes the input string by reversing letter cases or reversing the whole string if no letters are present.\"\"\"\n    processed_chars = []\n    for char in s:\n        if _is_alphabetic(char):\n            processed_chars.append(_reverse_char_case(char))\n        else:\n            processed_chars.append(char)\n\n    temp_processed_string = \"\".join(processed_chars)\n\n    if not _has_letters(s):\n        # If no letters in original string, reverse the original string.\n        return _reverse_string(s)\n    else:\n        # Otherwise, return the string with reversed cases.\n        return temp_processed_string"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Constructs an algebraic expression from interleaved operators and operands.\n    Evaluates the expression following standard mathematical precedence and returns the integer result.\n    \"\"\"\n    expression_parts = []\n    expression_parts.append(str(operand[0]))\n\n    for i in range(len(operator)):\n        expression_parts.append(operator[i])\n        expression_parts.append(str(operand[i+1]))\n\n    expression_string = \" \".join(expression_parts)\n    result = eval(expression_string)\n\n    return int(result)"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"Constructs an algebraic expression from lists of operators and operands, then evaluates it.\n    The expression is formed by interleaving operands and operators.\n    \"\"\"\n    expression_parts = [str(operand[0])]\n    for i in range(len(operator)):\n        expression_parts.append(operator[i])\n        expression_parts.append(str(operand[i+1]))\n    expression_string = \" \".join(expression_parts)\n    result = eval(expression_string)\n    return int(result)"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Processes a string by reversing letter cases or reversing the whole string if no letters are present.\"\"\"\n\n    def _reverse_case_char(char: str) -> str:\n        \"\"\"Reverses the case of a single character if it's a letter, otherwise returns it as is.\"\"\"\n        if 'a' <= char <= 'z':\n            return char.upper()\n        elif 'A' <= char <= 'Z':\n            return char.lower()\n        return char\n\n    def _contains_letters(s: str) -> bool:\n        \"\"\"Checks if the string s contains any letters.\"\"\"\n        for char in s:\n            if ('a' <= char <= 'z') or ('A' <= char <= 'Z'):\n                return True\n        return False\n\n    def _apply_case_reversal_to_string(s: str) -> str:\n        \"\"\"Iterates through s and reverses the case of letters, keeping non-letters unchanged.\"\"\"\n        result_chars = []\n        for char in s:\n            result_chars.append(_reverse_case_char(char))\n        return \"\".join(result_chars)\n\n    def _reverse_string(s: str) -> str:\n        \"\"\"Reverses the entire string s.\"\"\"\n        return s[::-1]\n\n    if _contains_letters(s):\n        return _apply_case_reversal_to_string(s)\n    else:\n        return _reverse_string(s)"}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Computes the MD5 hash of a given string and returns it as a hexadecimal string.\n    Returns None if the input string is empty.\n    \"\"\"\n    if not text:\n        return None\n\n    # Encode the string to bytes before hashing, using UTF-8.\n    md5_hash = hashlib.md5(text.encode('utf-8'))\n    return md5_hash.hexdigest()"}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text: str) -> str | None:\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    md5_hash = hashlib.md5(text.encode('utf-8')).hexdigest()\n    return md5_hash"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a: int, b: int) -> list[int]:\n    \"\"\"\n    Returns a sorted list of even single-digit numbers (0, 2, 4, 6, 8) that fall within the inclusive range [min(a, b), max(a, b)].\n    The list is empty if no such numbers are found.\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    EVEN_SINGLE_DIGITS = [0, 2, 4, 6, 8]\n\n    filtered_numbers = []\n    for digit in EVEN_SINGLE_DIGITS:\n        if min_val <= digit <= max_val:\n            filtered_numbers.append(digit)\n\n    return filtered_numbers"}
{"task_id": "HumanEval/163", "solution": "class RangeCalculator:\n    \"\"\"Utility class for determining effective integer ranges.\"\"\"\n    @staticmethod\n    def get_effective_range(a: int, b: int) -> tuple[int, int]:\n        \"\"\"Returns a tuple (min_val, max_val) ensuring min_val <= max_val.\"\"\"\n        return (min(a, b), max(a, b))\nclass EvenNumberFinder:\n    \"\"\"Utility class for finding even numbers within a range.\"\"\"\n    @staticmethod\n    def find_even_numbers(min_val: int, max_val: int) -> list[int]:\n        \"\"\"Returns a list of even integers within the inclusive range [min_val, max_val].\"\"\"\n        even_numbers = []\n        # Start from min_val, if it's odd, increment to the next even number.\n        start = min_val if min_val % 2 == 0 else min_val + 1\n\n        for num in range(start, max_val + 1, 2):\n            even_numbers.append(num)\n        return even_numbers\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even integers between a and b, in ascending order.\n    Handles cases where a is greater than b by considering the range between the smaller and larger of the two inputs.\n    \"\"\"\n    min_val, max_val = RangeCalculator.get_effective_range(a, b)\n    return EvenNumberFinder.find_even_numbers(min_val, max_val)"}
