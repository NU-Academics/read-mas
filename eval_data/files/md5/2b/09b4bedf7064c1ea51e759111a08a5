{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int) -> int:\n    \"\"\"Computes the largest prime factor of n. Assumes n is an integer greater than 1 and not prime.\"\"\"\n    largest_factor = 1\n\n    # Divide by 2 until n is odd.\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Check for odd factors from 3 up to sqrt(n).\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            largest_factor = i\n            n //= i\n        i += 2\n\n    # If n is still greater than 1, it must be the largest prime factor.\n    if n > 1:\n        largest_factor = n\n\n    return largest_factor"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n\n    >>> correct_bracketing(\"(\")\n    False\n    >>> correct_bracketing(\"()\")\n    True\n    >>> correct_bracketing(\"(()())\")\n    True\n    >>> correct_bracketing(\")(()\")\n    False\n    \"\"\"\n    def _is_valid_character_set(s: str) -> bool:\n        \"\"\"Checks if the input string s contains only valid bracket characters ('(' and ')').\"\"\"\n        for char in s:\n            if char not in '()':\n                return False\n        return True\n\n    def _check_matching_and_nesting(s: str) -> bool:\n        \"\"\"Implements the core logic to verify if opening and closing brackets are correctly matched and nested.\"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:  # Closing bracket without a corresponding opening one\n                return False\n        return balance == 0\n\n    if not _is_valid_character_set(brackets):\n        return False\n    return _check_matching_and_nesting(brackets)"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list) -> list:\n    \"\"\"Computes the derivative of a polynomial given its coefficients.\n    Returns an empty list for constant polynomials.\"\"\"\n    if len(xs) <= 1:\n        return []\n\n    derived_coeffs = []\n    for i in range(1, len(xs)):\n        derived_coeffs.append(xs[i] * i)\n\n    return derived_coeffs"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\"\n    Determines if a string of '(' and ')' characters is correctly balanced.\n    Returns True if every opening bracket has a corresponding closing bracket and\n    they are correctly nested, False otherwise.\n    \"\"\"\n    count = 0\n    for char in brackets:\n        if char == '(':\n            count += 1\n        elif char == ')':\n            count -= 1\n        if count < 0:  # A closing bracket appeared without a corresponding open bracket.\n            return False\n    return count == 0  # True if all brackets are balanced, False otherwise."}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts vowels in a word, including 'y' if it's at the end.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    >>> vowels_count(\"rhythm\")\n    0\n    >>> vowels_count(\"happy\")\n    2\n    >>> vowels_count(\"System\")\n    1\n    >>> vowels_count(\"AaEeIiOoUu\")\n    10\n    >>> vowels_count(\"sky\")\n    1\n    >>> vowels_count(\"\")\n    0\n    >>> vowels_count(\"mythology\")\n    3\n    \"\"\"\n    count = 0\n    s_lower = s.lower()\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n\n    for i, char in enumerate(s_lower):\n        if char in standard_vowels:\n            count += 1\n        elif char == 'y' and i == len(s_lower) - 1:\n            count += 1\n    return count"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int) -> int:\n    \"\"\"The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    >>> fibfib(1)\n    0\n    >>> fibfib(5)\n    4\n    >>> fibfib(8)\n    24\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    # Initialize with base cases: fibfib(0), fibfib(1), fibfib(2)\n    a, b, c = 0, 0, 1\n\n    # Iteratively compute fibfib(i) for i from 3 to n\n    for _ in range(3, n + 1):\n        next_fib = a + b + c\n        a = b\n        b = c\n        c = next_fib\n    return c"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n    \"\"\"\n    count = 0\n    vowels = {'a', 'e', 'i', 'o', 'u'}\n\n    for i, char in enumerate(s):\n        lower_char = char.lower()\n        if lower_char in vowels:\n            count += 1\n        elif lower_char == 'y' and i == len(s) - 1:\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list) -> list:\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    derived_coefficients = []\n    for i in range(1, len(xs)):\n        derived_coefficient = xs[i] * i\n        derived_coefficients.append(derived_coefficient)\n    return derived_coefficients"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int) -> int:\n    \"\"\"Computes the n-th element of the FibFib number sequence efficiently.\n    Handles base cases and iteratively calculates higher elements.\"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 1\n\n    # Initialize a, b, c to fibfib(0), fibfib(1), fibfib(2) respectively.\n    a, b, c = 0, 0, 1\n\n    # Iteratively compute fibfib(i) up to n.\n    for _ in range(3, n + 1):\n        next_fib = a + b + c\n        a = b\n        b = c\n        c = next_fib\n\n    return c"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculates the sum of ASCII values of all uppercase characters in a string.\n    It iterates through the string, identifies uppercase letters, and accumulates their ASCII values.\"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/65", "solution": "def _reverse_string(s: str) -> str:\n    \"\"\"Reverses the input string s.\"\"\"\n    return s[::-1]\ndef _perform_circular_shift(s: str, effective_shift: int) -> str:\n    \"\"\"Performs a circular right shift on string s by effective_shift positions.\"\"\"\n    if not s:\n        return \"\"\n    return s[-effective_shift:] + s[:-effective_shift]\ndef circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    s = str(x)\n    num_digits = len(s)\n\n    if shift > num_digits:\n        return _reverse_string(s)\n    else:\n        effective_shift = shift % num_digits\n        return _perform_circular_shift(s, effective_shift)"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculates and returns the sum of ASCII codes for all uppercase characters in the input string `s`.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/65", "solution": "class DigitsString:\n    \"\"\"Represents a string of digits and provides manipulation methods.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the number of digits in the string.\"\"\"\n        return len(self.value)\n\n    def reverse(self) -> 'DigitsString':\n        \"\"\"Returns a new DigitsString with digits reversed.\"\"\"\n        return DigitsString(self.value[::-1])\n\n    def circular_shift_right(self, shift: int) -> 'DigitsString':\n        \"\"\"Returns a new DigitsString with digits circularly shifted right.\"\"\"\n        actual_shift = shift % self.length()\n        shifted_value = self.value[-actual_shift:] + self.value[:-actual_shift]\n        return DigitsString(shifted_value)\nclass IntegerInput:\n    \"\"\"Encapsulates an input integer for digit manipulation.\n    It provides a method to convert the integer to its digit string.\n    \"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def to_digits_string(self) -> DigitsString:\n        \"\"\"Converts the absolute value of the integer to a DigitsString.\"\"\"\n        return DigitsString(str(abs(self.value)))\nclass ShiftAmount:\n    \"\"\"Encapsulates an integer representing the shift amount.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\nclass CircularShiftProcessor:\n    \"\"\"Processes integer inputs to perform circular shifts or reversals.\"\"\"\n    def process(self, inputNum: IntegerInput, shiftVal: ShiftAmount) -> DigitsString:\n        \"\"\"Orchestrates digit manipulation based on the shift value.\n        It decides whether to reverse or circularly shift the digits.\n        \"\"\"\n        digits_str = inputNum.to_digits_string()\n        length = digits_str.length()\n        shift = shiftVal.value\n\n        if shift > length:\n            result = digits_str.reverse()\n        else:\n            result = digits_str.circular_shift_right(shift)\n        return result\ndef circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    input_num = IntegerInput(x)\n    shift_amount = ShiftAmount(shift)\n    processor = CircularShiftProcessor()\n    result_digits_obj = processor.process(input_num, shift_amount)\n    return result_digits_obj.value"}
{"task_id": "HumanEval/67", "solution": "def fruit_distribution(s,n):\n    \"\"\"\n    In this task, you will be given a string that represents a number of apples and oranges\n    that are distributed in a basket of fruit this basket contains\n    apples, oranges, and mango fruits. Given the string that represents the total number of\n    the oranges and apples and an integer that represent the total number of the fruits\n    in the basket return the number of the mango fruits in the basket.\n    for examble:\n    fruit_distribution(\"5 apples and 6 oranges\", 19) ->19 - 5 - 6 = 8\n    fruit_distribution(\"0 apples and 1 oranges\",3) -> 3 - 0 - 1 = 2\n    fruit_distribution(\"2 apples and 3 oranges\", 100) -> 100 - 2 - 3 = 95\n    fruit_distribution(\"100 apples and 1 oranges\",120) -> 120 - 100 - 1 = 19\n    \"\"\"\n    parts = s.split(' and ')\n    apple_count_str = parts[0].split(' ')[0]\n    orange_count_str = parts[1].split(' ')[0]\n\n    apple_count = int(apple_count_str)\n    orange_count = int(orange_count_str)\n\n    return n - apple_count - orange_count"}
{"task_id": "HumanEval/67", "solution": "def _extract_fruit_counts(s: str) -> tuple[int, int]:\n    \"\"\"\n    Parses the input string to extract the counts of apples and oranges.\n    It expects the format \"X apples and Y oranges\".\n    \"\"\"\n    parts = s.split(\" apples and \")\n    apples = int(parts[0])\n    oranges = int(parts[1].replace(\" oranges\", \"\"))\n    return apples, oranges\ndef fruit_distribution(s: str, n: int) -> int:\n    \"\"\"\n    In this task, you will be given a string that represents a number of apples and oranges\n    that are distributed in a basket of fruit this basket contains\n    apples, oranges, and mango fruits. Given the string that represents the total number of\n    the oranges and apples and an integer that represent the total number of the fruits\n    in the basket return the number of the mango fruits in the basket.\n    for examble:\n    fruit_distribution(\"5 apples and 6 oranges\", 19) ->19 - 5 - 6 = 8\n    fruit_distribution(\"0 apples and 1 oranges\",3) -> 3 - 0 - 1 = 2\n    fruit_distribution(\"2 apples and 3 oranges\", 100) -> 100 - 2 - 3 = 95\n    fruit_distribution(\"100 apples and 1 oranges\",120) -> 120 - 100 - 1 = 19\n    \"\"\"\n    apples, oranges = _extract_fruit_counts(s)\n    total_known_fruits = apples + oranges\n    mango_fruits = max(0, n - total_known_fruits)\n    return mango_fruits"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr: list[int]) -> list[int]:\n    \"\"\"\n    Finds the smallest even-valued node with the smallest index.\n    Returns [value, index] or an empty list [] if no suitable node is found.\n    \"\"\"\n    if not arr:\n        return []\n\n    best_node = None  # Stores (value, index) of the current best candidate.\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the node is even.\n            if best_node is None or value < best_node[0] or (value == best_node[0] and index < best_node[1]):\n                best_node = (value, index)\n\n    if best_node is None:\n        return []\n    else:\n        return list(best_node)"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Given an array of non-negative integers, finds the smallest even value\n    and its smallest index. Returns [smallest_even_value, its_index] or\n    an empty list [] if no even values are found or the array is empty.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n            elif value == smallest_even_value and i < smallest_even_index:\n                smallest_even_index = i\n\n    if smallest_even_value == float('inf'):\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/69", "solution": "class IntegerList:\n    \"\"\"\n    Manages a list of integers, calculates their frequencies, and identifies matching integers.\n    \"\"\"\n    def __init__(self, lst: list[int]):\n        \"\"\"\n        Initializes the IntegerList with a list of values and calculates their frequencies.\n        \"\"\"\n        self._values = lst\n        self._frequencies = {}\n        self._calculate_frequencies()\n\n    def _calculate_frequencies(self) -> None:\n        \"\"\"\n        Populates the internal frequency dictionary for all values in the list.\n        \"\"\"\n        for item in self._values:\n            self._frequencies[item] = self._frequencies.get(item, 0) + 1\n\n    def get_frequency(self, value: int) -> int:\n        \"\"\"\n        Returns the frequency of a given integer value. Returns 0 if the value is not found.\n        \"\"\"\n        return self._frequencies.get(value, 0)\n\n    def find_greatest_matching_integer(self) -> int:\n        \"\"\"\n        Finds the greatest integer x where x > 0 and its frequency is >= x. Returns -1 if no such integer exists.\n        \"\"\"\n        valid_candidates = []\n        for x in self._frequencies.keys():\n            if x > 0 and self.get_frequency(x) >= x:\n                valid_candidates.append(x)\n\n        if valid_candidates:\n            return max(valid_candidates)\n        else:\n            return -1\ndef search(lst: list[int]) -> int:\n    \"\"\"\n    Finds the greatest integer in a list whose frequency is greater than or equal to its value.\n    Returns -1 if no such integer exists.\n    \"\"\"\n    integer_list_obj = IntegerList(lst)\n    result = integer_list_obj.find_greatest_matching_integer()\n    return result"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\nfrom typing import List, Dict\ndef _calculate_frequencies(lst: List[int]) -> Dict[int, int]:\n    \"\"\"Counts occurrences of each integer in the list, returning a dictionary mapping them to their frequencies.\"\"\"\n    return dict(Counter(lst))\ndef _find_matching_integers(frequencies: Dict[int, int]) -> List[int]:\n    \"\"\"Filters integers from the frequency map. It returns those where the frequency is greater than or equal to their value.\"\"\"\n    matching = []\n    for num, freq in frequencies.items():\n        if freq >= num:\n            matching.append(num)\n    return matching\ndef _get_max_or_default(matching_integers: List[int]) -> int:\n    \"\"\"Returns the maximum value from a list of integers. If the list is empty, it returns -1.\"\"\"\n    if not matching_integers:\n        return -1\n    return max(matching_integers)\ndef search(lst):\n    \"\"\"\n    Finds the greatest integer in a list whose frequency is greater than or equal to its value.\n    Returns -1 if no such integer exists.\n    \"\"\"\n    frequencies = _calculate_frequencies(lst)\n    matching_integers = _find_matching_integers(frequencies)\n    result = _get_max_or_default(matching_integers)\n    return result"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Sorts a list by alternately taking the minimum and maximum remaining values.\n    Returns a new list sorted in this strange order.\n    \"\"\"\n    if not lst:\n        return []\n\n    working_list = sorted(lst)\n    result_list = []\n    is_min_turn = True\n\n    while working_list:\n        if is_min_turn:\n            result_list.append(working_list.pop(0)) # Get and remove the smallest\n        else:\n            result_list.append(working_list.pop(-1)) # Get and remove the largest\n        is_min_turn = not is_min_turn\n\n    return result_list"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst: list[int]) -> list[int]:\n    \"\"\"\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    \"\"\"\n    if not lst:\n        return []\n\n    mutable_list = sorted(lst)\n    result_list = []\n    is_min_turn = True\n\n    while mutable_list:\n        if is_min_turn:\n            # Append the minimum remaining element.\n            result_list.append(mutable_list.pop(0))\n        else:\n            # Append the maximum remaining element.\n            result_list.append(mutable_list.pop(-1))\n        is_min_turn = not is_min_turn\n\n    return result_list"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle, calculate its area.\n    Returns the area rounded to 2 decimal points if valid, otherwise -1.0.\n    '''\n    # Sides must be positive and satisfy the triangle inequality theorem.\n    if not (a > 0 and b > 0 and c > 0 and\n            a + b > c and a + c > b and b + c > a):\n        return -1.0\n\n    # Calculate the semi-perimeter.\n    s = (a + b + c) / 2\n\n    # Use Heron's formula to calculate the area.\n    area_squared = s * (s - a) * (s - b) * (s - c)\n\n    # Account for potential floating point inaccuracies making area_squared slightly negative.\n    if area_squared < 0:\n        area_squared = 0\n\n    area = math.sqrt(area_squared)\n\n    # Round the area to two decimal places.\n    return round(area, 2)"}
{"task_id": "HumanEval/72", "solution": "def _is_palindrome(lst):\n    \"\"\"\n    Checks if a list is a palindrome by comparing it to its reversed version.\n    \"\"\"\n    return lst == lst[::-1]\ndef _calculate_sum(lst):\n    \"\"\"\n    Calculates the sum of all numerical elements within a given list.\n    \"\"\"\n    return sum(lst)\ndef will_it_fly(q,w):\n    '''\n    Write a function that returns True if the object q will fly, and False otherwise.\n    The object q will fly if it's balanced (it is a palindromic list) and the sum of its elements is less than or equal the maximum possible weight w.\n    '''\n    is_balanced = _is_palindrome(q)\n    total_weight = _calculate_sum(q)\n\n    return is_balanced and (total_weight <= w)"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    \"\"\"\n    Calculates the area of a triangle given its three side lengths.\n    Returns -1 if sides do not form a valid triangle; otherwise, calculates and returns the area rounded to two decimal places.\n    \"\"\"\n    # Validate triangle inequality and positive side lengths. Return -1 if invalid.\n    if not (a > 0 and b > 0 and c > 0 and\n            a + b > c and\n            a + c > b and\n            b + c > a):\n        return -1.0\n\n    # Calculate semi-perimeter and then area using Heron's formula.\n    s = (a + b + c) / 2\n    area_squared = s * (s - a) * (s - b) * (s - c)\n\n    # Handle potential floating point inaccuracies for degenerate triangles.\n    if area_squared < 0:\n        area = 0.0\n    else:\n        area = math.sqrt(area_squared)\n\n    # Round the calculated area to two decimal places and return.\n    rounded_area = round(area, 2)\n    return rounded_area"}
{"task_id": "HumanEval/72", "solution": "def _is_palindrome(q: list) -> bool:\n    \"\"\"Checks if a list is a palindrome.\"\"\"\n    return q == q[::-1]\ndef _calculate_sum(q: list) -> int:\n    \"\"\"Calculates the sum of elements in a list.\"\"\"\n    return sum(q)\ndef will_it_fly(q: list, w: int) -> bool:\n    \"\"\"\n    Determines if an object q will fly based on balance and weight.\n    Returns True if q is a palindrome AND its sum is <= w, False otherwise.\n    \"\"\"\n    if not _is_palindrome(q):\n        return False\n\n    total_sum = _calculate_sum(q)\n    return total_sum <= w"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum number of elements to change to make an array palindromic.\n    It iterates through the first half, comparing symmetric elements and counting mismatches.\n    \"\"\"\n    changes_count = 0\n    N = len(arr)\n    for i in range(N // 2):\n        if arr[i] != arr[N - 1 - i]:\n            changes_count += 1\n    return changes_count"}
{"task_id": "HumanEval/74", "solution": "from typing import List\ndef _calculate_total_characters(string_list: List[str]) -> int:\n    \"\"\"\n    Calculates the total character count for strings in a list.\n    It sums the lengths of all individual strings in the provided list.\n    \"\"\"\n    total_count = 0\n    for s in string_list:\n        total_count += len(s)\n    return total_count\ndef total_match(lst1, lst2):\n    \"\"\"\n    Compares two string lists by their total character counts.\n    Returns the list with fewer characters; returns the first list on a tie.\n    \"\"\"\n    count1 = _calculate_total_characters(lst1)\n    count2 = _calculate_total_characters(lst2)\n\n    if count1 <= count2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates minimum changes to make an array palindromic.\n    It counts unequal symmetric element pairs from the start and end.\n    \"\"\"\n    n = len(arr)\n    changes_count = 0\n\n    # Arrays with 0 or 1 element are already palindromic.\n    if n <= 1:\n        return 0\n\n    # Compare elements from both ends towards the middle.\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            changes_count += 1\n\n    return changes_count"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1: list[str], lst2: list[str]) -> list[str]:\n    \"\"\"\n    Compares two lists of strings by their total character counts.\n    Returns the list with the smaller or equal total character count.\n    \"\"\"\n    chars_lst1 = sum(len(s) for s in lst1)\n    chars_lst2 = sum(len(s) for s in lst2)\n\n    if chars_lst1 <= chars_lst2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/75", "solution": "import math\ndef is_prime(n):\n    \"\"\"Checks if a number n is prime. Optimized by checking divisibility up to its square root.\"\"\"\n    if n <= 1:\n        return False\n    for i in range(2, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            return False\n    return True\ndef is_multiply_prime(a):\n    \"\"\"Returns true if a is the product of exactly three prime numbers, false otherwise.\n    Input 'a' is guaranteed to be less than 100.\"\"\"\n    prime_factors = []\n    temp_a = a\n    for i in range(2, temp_a + 1):\n        if is_prime(i):\n            while temp_a % i == 0:\n                prime_factors.append(i)\n                temp_a //= i\n        if temp_a == 1:\n            break\n    return len(prime_factors) == 3"}
{"task_id": "HumanEval/75", "solution": "def _is_prime(n):\n    \"\"\"\n    Checks if a number is prime.\n    A standard primality test is used, optimizing for numbers up to 100.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\ndef _get_prime_factors(n):\n    \"\"\"\n    Finds all prime factors of a number, including repetitions.\n    Adheres to design requiring explicit primality check of potential factors.\n    \"\"\"\n    factors = []\n\n    # Handle factor 2 first\n    while n % 2 == 0:\n        # As per design, explicitly check if 2 is prime (which it is).\n        if _is_prime(2):\n            factors.append(2)\n            n //= 2\n        else: # This branch should theoretically not be reached as 2 is prime.\n            break\n\n    # Handle odd factors starting from 3\n    d = 3\n    while d * d <= n:\n        # Check if 'd' is a factor of the current 'n'\n        if n % d == 0:\n            # As per design, explicitly confirm if 'd' is a prime number.\n            if _is_prime(d):\n                # If 'd' is a prime factor, add it and divide 'n' repeatedly.\n                while n % d == 0:\n                    factors.append(d)\n                    n //= d\n        d += 2 # Move to the next odd potential factor\n\n    # If remaining 'n' is greater than 1, it must be a prime factor itself.\n    if n > 1:\n        # As per design, explicitly confirm its primality.\n        if _is_prime(n):\n            factors.append(n)\n\n    return factors\ndef is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100.\n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    # Validate input 'a' based on the design specification (a < 100).\n    if a < 2 or a >= 100:\n        return False\n\n    prime_factors_list = _get_prime_factors(a)\n\n    # Check if the count of prime factors is exactly 3.\n    return len(prime_factors_list) == 3"}
{"task_id": "HumanEval/77", "solution": "def iscube(a: int) -> bool:\n    '''\n    Checks if the integer `a` is a perfect cube.\n    Returns True if `a` is a cube of an integer, False otherwise.\n    '''\n    # Calculate the approximate cube root using float power, then round to the nearest integer.\n    # Python handles negative bases for odd powers correctly, returning a real negative float.\n    nearest_int_root = round(a**(1/3))\n\n    # Check if cubing this integer root yields the original number.\n    return nearest_int_root**3 == a"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n, meaning n raised to a non-negative integer exponent equals x.\n    This implementation prioritizes simplicity and adherence to the provided examples.\"\"\"\n\n    epsilon = 1e-9  # Epsilon for floating point comparisons to determine exactness.\n\n    # Case 1: n = 1\n    # If n is 1, then 1^k is always 1. So, x must be 1.\n    if abs(n - 1.0) < epsilon:\n        return abs(x - 1.0) < epsilon\n\n    # Case 2: n = 0\n    # 0^0 = 1 (common interpretation). 0^k = 0 for k > 0.\n    # So, x must be 0 or 1.\n    if abs(n) < epsilon:\n        return abs(x) < epsilon or abs(x - 1.0) < epsilon\n\n    # If x is 1 (and n is not 0 or 1, already handled above), it's a power (n^0 = 1).\n    if abs(x - 1.0) < epsilon:\n        return True\n\n    # From here, x is not 1, and n is not 0 or 1.\n    # Given the examples (all x >= 1, n >= 1), we simplify by assuming x and n are non-negative.\n    if x < -epsilon or n < -epsilon:\n        return False\n\n    # If x is 0 (and n is not 0), then n^k cannot be 0 for any non-negative integer k.\n    if abs(x) < epsilon:\n        return False\n\n    # Now, x > 1 and n > 1 (within epsilon bounds).\n    # Repeatedly divide x by n. If it's always perfectly divisible until x becomes 1, then it's a power.\n    current_x = float(x)\n    base_n = float(n)\n\n    while current_x > 1.0 + epsilon:  # Loop as long as current_x is significantly greater than 1\n        # Check if current_x is divisible by base_n with acceptable float precision.\n        remainder = current_x % base_n\n        if abs(remainder) > epsilon and abs(remainder - base_n) > epsilon:\n            return False\n\n        current_x /= base_n\n\n    # If the loop finishes, current_x should be very close to 1.\n    return abs(current_x - 1.0) < epsilon"}
{"task_id": "HumanEval/77", "solution": "def iscube(a: int) -> bool:\n    \"\"\"Checks if an integer is a perfect cube by calculating its cube root and rounding.\"\"\"\n    # Calculate the cube root of the absolute value of 'a'.\n    root_abs_float = abs(a) ** (1/3)\n\n    # Round the floating-point root to the nearest integer.\n    root_val_abs = round(root_abs_float)\n\n    # Adjust the sign of the rounded root based on the original number 'a'.\n    # If 'a' is negative, its cube root must also be negative.\n    if a < 0:\n        root_val = -root_val_abs\n    else:\n        root_val = root_val_abs\n\n    # Check if the cube of the integer root equals the original number 'a'.\n    return root_val ** 3 == a"}
{"task_id": "HumanEval/78", "solution": "_HEX_PRIME_DIGITS = {'2', '3', '5', '7', 'B', 'D'}\ndef _is_prime_hex_digit(digit_char: str) -> bool:\n    \"\"\"Checks if a given hexadecimal digit character is one of the defined prime hexadecimal digits.\"\"\"\n    return digit_char in _HEX_PRIME_DIGITS\ndef hex_key(num: str) -> int:\n    \"\"\"Counts the number of prime hexadecimal digits in the input string.\"\"\"\n    prime_count = 0\n    for digit in num:\n        if _is_prime_hex_digit(digit):\n            prime_count += 1\n    return prime_count"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"\n    Checks if x is a simple power of n (n**k = x for some integer k >= 0).\n    It handles specified edge cases for x=1, n=0, n=1, and n=-1.\n    \"\"\"\n    if x == 1:\n        return True\n\n    if n == 0:\n        return x == 0\n\n    if n == 1:\n        return False\n\n    if n == -1:\n        return x == -1\n\n    if x == 0:\n        return False\n\n    if n > 0 and x < 0:\n        return False\n\n    temp_x = x # Use a temporary variable for x.\n\n    while temp_x % n == 0: # Repeatedly divide temp_x by n.\n        temp_x //= n\n        if temp_x == 1:\n            return True\n        if temp_x == x: # This check prevents infinite loops or incorrect state.\n            break\n\n    return False"}
{"task_id": "HumanEval/78", "solution": "_PRIME_HEX_DIGITS = frozenset({'2', '3', '5', '7', 'B', 'D'})\ndef hex_key(num: str) -> int:\n    \"\"\"Counts the number of prime hexadecimal digits in a given string.\n    Identifies digits 2, 3, 5, 7, B (11), and D (13) and returns their total count.\n    \"\"\"\n    prime_digit_count = 0\n    for digit in num:\n        if digit in _PRIME_HEX_DIGITS:\n            prime_digit_count += 1\n    return prime_digit_count"}
