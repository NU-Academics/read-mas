{"task_id": "HumanEval/117", "solution": "def _is_consonant(char: str) -> bool:\n    \"\"\"Checks if a character is a consonant, case-insensitively.\"\"\"\n    char_lower = char.lower()\n    return 'a' <= char_lower <= 'z' and char_lower not in 'aeiou'\nclass Word:\n    \"\"\"Encapsulates word text and provides consonant counting functionality.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def get_consonant_count(self) -> int:\n        \"\"\"Calculates the number of consonants in the word's text.\"\"\"\n        count = 0\n        for char in self.text:\n            if _is_consonant(char):\n                count += 1\n        return count\ndef _split_into_words(s: str) -> list[str]:\n    \"\"\"Splits an input string into a list of words.\"\"\"\n    return [word for word in s.split(' ') if word]\ndef select_words(s, n):\n    \"\"\"Given a string s and a natural number n, you have been tasked to implement\n    a function that returns a list of all words from string s that contain exactly\n    n consonants, in order these words appear in the string s.\n    If the string s is empty then the function should return an empty list.\n    Note: you may assume the input string contains only letters and spaces.\n    Examples:\n    select_words(\"Mary had a little lamb\", 4) ==> [\"little\"]\n    select_words(\"Mary had a little lamb\", 3) ==> [\"Mary\", \"lamb\"]\n    select_words(\"simple white space\", 2) ==> []\n    select_words(\"Hello world\", 4) ==> [\"world\"]\n    select_words(\"Uncle sam\", 3) ==> [\"Uncle\"]\n    \"\"\"\n    if not s:\n        return []\n\n    result_list = []\n    words = _split_into_words(s)\n\n    for raw_word in words:\n        word_obj = Word(raw_word)\n        if word_obj.get_consonant_count() == n:\n            result_list.append(raw_word)\n\n    return result_list"}
{"task_id": "HumanEval/118", "solution": "def is_vowel(char):\n    \"\"\"Checks if a character is an English vowel (case-sensitive).\"\"\"\n    return char in \"aeiouAEIOU\"\ndef is_consonant(char):\n    \"\"\"Checks if a character is an English consonant (case-sensitive).\"\"\"\n    return char.isalpha() and not is_vowel(char)\ndef get_closest_vowel(word):\n    \"\"\"Finds the closest vowel surrounded by consonants from the right side of the word.\n    Returns an empty string if no such vowel exists or the word is too short.\n    \"\"\"\n    if len(word) < 3:\n        return \"\"\n\n    # Iterate from len(word) - 2 down to 1 (inclusive)\n    # This range ensures word[i-1] and word[i+1] are always valid indices.\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        left_neighbor = word[i-1]\n        right_neighbor = word[i+1]\n\n        if is_vowel(current_char) and \\\n           is_consonant(left_neighbor) and \\\n           is_consonant(right_neighbor):\n            return current_char\n\n    return \"\""}
{"task_id": "HumanEval/118", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a given character is a vowel (case-sensitive).\"\"\"\n    return char in VOWELS\ndef _is_consonant(char: str) -> bool:\n    \"\"\"Checks if a given character is a consonant (case-sensitive).\n    Assumes input characters are English letters only.\"\"\"\n    return char.isalpha() and not _is_vowel(char)\ndef get_closest_vowel(word: str) -> str:\n    \"\"\"Finds the closest vowel that stands between two consonants from the right side of the word.\n    Vowels at word boundaries do not count.\"\"\"\n    n = len(word)\n\n    # Iterate from right to left, excluding the first and last characters.\n    # The loop runs from index n-2 down to 1.\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n\n        if _is_vowel(current_char):\n            prev_char = word[i - 1]\n            next_char = word[i + 1]\n\n            if _is_consonant(prev_char) and _is_consonant(next_char):\n                return current_char\n\n    return \"\""}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    '''\n    You are given a list of two strings, both strings consist of open\n    parentheses '(' or close parentheses ')' only.\n    Your job is to check if it is possible to concatenate the two strings in\n    some order, that the resulting string will be good.\n    A string S is considered to be good if and only if all parentheses in S\n    are balanced. For example: the string '(())()' is good, while the string\n    '())' is not.\n    Return 'Yes' if there's a way to make a good string, and return 'No' otherwise.\n\n    Examples:\n    match_parens(['()(', ')']) == 'Yes'\n    match_parens([')', ')']) == 'No'\n    '''\n\n    def _is_balanced(s):\n        \"\"\"Checks if a string of parentheses is balanced.\"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    # Validate Input List Length\n    if not isinstance(lst, list) or len(lst) != 2:\n        return 'No'\n\n    s1, s2 = lst[0], lst[1]\n\n    # Validate String Content\n    valid_chars = {'(', ')'}\n    if not (isinstance(s1, str) and all(char in valid_chars for char in s1) and \\\n            isinstance(s2, str) and all(char in valid_chars for char in s2)):\n        return 'No'\n\n    is_balanced_1 = _is_balanced(s1 + s2)\n    is_balanced_2 = _is_balanced(s2 + s1)\n\n    if is_balanced_1 or is_balanced_2:\n        return 'Yes'\n    else:\n        return 'No'"}
{"task_id": "HumanEval/117", "solution": "def _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n    return char.lower() in 'aeiou'\ndef _count_consonants(word: str) -> int:\n    \"\"\"Counts consonants in a word (case-insensitive).\"\"\"\n    consonant_count = 0\n    for char in word:\n        if char.isalpha() and not _is_vowel(char):\n            consonant_count += 1\n    return consonant_count\ndef select_words(s, n):\n    \"\"\"\n    Given a string s and a natural number n, you have been tasked to implement\n    a function that returns a list of all words from string s that contain exactly\n    n consonants, in order these words appear in the string s.\n    If the string s is empty then the function should return an empty list.\n    Note: you may assume the input string contains only letters and spaces.\n    Examples:\n    select_words(\"Mary had a little lamb\", 4) ==> [\"little\"]\n    select_words(\"Mary had a little lamb\", 3) ==> [\"Mary\", \"lamb\"]\n    select_words(\"simple white space\", 2) ==> []\n    select_words(\"Hello world\", 4) ==> [\"world\"]\n    select_words(\"Uncle sam\", 3) ==> [\"Uncle\"]\n    \"\"\"\n    if not s:\n        return []\n\n    words = s.split()\n    result = []\n    for word in words:\n        if _count_consonants(word) == n:\n            result.append(word)\n    return result"}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    # Concatenate strings in both possible orders.\n    # Check if either concatenated string is balanced using the helper.\n    s1 = lst[0] + lst[1]\n    s2 = lst[1] + lst[0]\n\n    if _is_balanced(s1) or _is_balanced(s2):\n        return 'Yes'\n    else:\n        return 'No'"}
{"task_id": "HumanEval/120", "solution": "import heapq\nfrom typing import List\ndef maximum(arr: List[int], k: int) -> List[int]:\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    # Uses heapq.nlargest to efficiently find the k largest elements from the array.\n    # The returned list is then sorted in ascending order as required by the problem.\n    largest_elements = heapq.nlargest(k, arr)\n    return sorted(largest_elements)"}
{"task_id": "HumanEval/120", "solution": "def _find_and_sort_k_maximum(arr, k):\n    \"\"\"Identifies and sorts the k maximum numbers from the array.\"\"\"\n    if k == 0:\n        return []\n    # Sort the array in ascending order to easily pick the largest k elements.\n    arr.sort()\n    return arr[len(arr) - k:]\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and an integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    # Validation and error handling are excluded as per critical requirements.\n    return _find_and_sort_k_maximum(arr, k)"}
{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Calculates the sum of all odd elements located at even positions within a list.\n    It iterates through the list, adding elements where the index is even and the element's value is odd.\n    \"\"\"\n    total_sum = 0  # Initialize total_sum.\n\n    for index, element in enumerate(lst):\n        # Check if index is even and element is odd.\n        if index % 2 == 0 and element % 2 != 0:\n            total_sum += element  # Add element if both conditions are met.\n\n    return total_sum"}
