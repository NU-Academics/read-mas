{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold. Iterates through all unique pairs and compares their absolute difference.\n    \"\"\"\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/0", "solution": "from typing import List\nimport math\nimport itertools\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    for num1, num2 in itertools.combinations(numbers, 2):\n        abs_diff = math.fabs(num1 - num2)\n        if abs_diff < threshold:\n            return True\n\n    return False"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    cleaned_string = paren_string.replace(\" \", \"\")\n    result_groups = []\n    balance_counter = 0\n    group_start_index = 0\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            balance_counter += 1\n        elif char == ')':\n            balance_counter -= 1\n\n        if balance_counter == 0:\n            # A complete, balanced, and non-nested group has been found.\n            result_groups.append(cleaned_string[group_start_index : i + 1])\n            group_start_index = i + 1\n\n    return result_groups"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef _remove_spaces(s: str) -> str:\n    \"\"\"Removes all space characters from the input string.\"\"\"\n    return s.replace(' ', '')\ndef _find_top_level_groups(processed_string: str) -> List[str]:\n    \"\"\"Identifies and extracts distinct, balanced, and non-nested parenthesis groups.\"\"\"\n    groups = []\n    balance = 0\n    start_index = -1\n\n    for i, char in enumerate(processed_string):\n        if char == '(':\n            if balance == 0:\n                start_index = i\n            balance += 1\n        elif char == ')':\n            balance -= 1\n            if balance == 0 and start_index != -1:\n                groups.append(processed_string[start_index : i + 1])\n                start_index = -1\n    return groups\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separates multiple groups of nested parentheses into a list of separate strings.\n    Ignores any spaces in the input string.\n    \"\"\"\n    processed_string = _remove_spaces(paren_string)\n    list_of_group_strings = _find_top_level_groups(processed_string)\n    return list_of_group_strings"}
{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\"Given a positive floating point number, it can be decomposed into an integer part and decimals.\n    Return the decimal part of the number.\n    \"\"\"\n    integer_part = int(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/2", "solution": "import math\ndef truncate_number(number: float) -> float:\n    \"\"\"Given a positive floating point number, returns its decimal part.\n    The integer part is calculated using math.floor().\n    \"\"\"\n    integer_part = math.floor(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/3", "solution": "from typing import List\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    balance = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/3", "solution": "from typing import List\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"Detects if an account balance falls below zero at any point.\n    Returns True if balance goes below zero, False otherwise.\n    \"\"\"\n    balance = 0\n    for operation in operations:\n        balance += operation\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        return 0.0\n\n    # Calculate the mean\n    mean_val = sum(numbers) / len(numbers)\n\n    # Calculate absolute differences from the mean\n    abs_diffs = [abs(num - mean_val) for num in numbers]\n\n    # Calculate the mean of the absolute differences\n    mad = sum(abs_diffs) / len(abs_diffs)\n\n    return mad"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n    if len(numbers) == 1:\n        return numbers\n\n    result_list = []\n    for i in range(len(numbers) - 1):\n        result_list.append(numbers[i])\n        result_list.append(delimeter)\n    result_list.append(numbers[-1])  # Append the last element without a trailing delimiter\n\n    return result_list"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    # Calculate the mean of the input dataset.\n    mean_value = sum(numbers) / len(numbers)\n\n    # Calculate the absolute difference between each number and the calculated mean.\n    absolute_differences = [abs(x - mean_value) for x in numbers]\n\n    # Calculate the average of these absolute differences to get the MAD.\n    mad = sum(absolute_differences) / len(absolute_differences)\n\n    return mad"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n    if len(numbers) == 1:\n        return numbers\n\n    result_list = []\n    for i, num in enumerate(numbers):\n        result_list.append(num)\n        if i < len(numbers) - 1:\n            result_list.append(delimeter)\n\n    return result_list"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef _split_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"\n    Splits the input string into individual parenthesis group strings based on spaces.\n    Filters out any empty strings resulting from multiple spaces or leading/trailing spaces.\n    \"\"\"\n    if not paren_string.strip():\n        return []\n    return [group for group in paren_string.split(' ') if group]\ndef _calculate_max_nesting_depth(paren_group: str) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth for a single parenthesis group string.\n    The depth is determined by the highest concurrent number of open parentheses.\n    \"\"\"\n    current_depth = 0\n    max_depth = 0\n    for char in paren_group:\n        if char == '(':\n            current_depth += 1\n            max_depth = max(max_depth, current_depth)\n        elif char == ')':\n            current_depth -= 1\n    return max_depth\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string of multiple nested parenthesis groups separated by spaces.\n    It returns a list of integers, each being the maximum nesting depth for a corresponding group.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    >>> parse_nested_parens('')\n    []\n    >>> parse_nested_parens('   ')\n    []\n    \"\"\"\n    paren_groups = _split_paren_groups(paren_string)\n\n    result_depths: List[int] = []\n    for group in paren_groups:\n        depth = _calculate_max_nesting_depth(group)\n        result_depths.append(depth)\n\n    return result_depths"}
{"task_id": "HumanEval/7", "solution": "from typing import List\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\"\n    Filters a list of strings, returning only those that contain the given substring.\n    Returns a new list containing only the strings from the input list that contain the substring.\n    \"\"\"\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef _calculate_deepest_nesting(group: str) -> int:\n    \"\"\"Calculates the deepest level of nesting for a single group of parentheses.\n    It tracks current nesting and updates the maximum depth encountered.\n    \"\"\"\n    current_max = 0\n    max_nesting = 0\n    for char in group:\n        if char == '(':\n            current_max += 1\n            max_nesting = max(max_nesting, current_max)\n        elif char == ')':\n            current_max -= 1\n    return max_nesting\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Parses a string of parentheses groups separated by spaces.\n    For each group, it calculates and returns the deepest level of nesting.\n    \"\"\"\n    groups: List[str] = paren_string.split(' ')\n    results: List[int] = []\n    for group in groups:\n        if group:  # Handle potential empty strings from multiple spaces\n            results.append(_calculate_deepest_nesting(group))\n    return results"}
{"task_id": "HumanEval/7", "solution": "from typing import List\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring.\n    The comparison is case-sensitive.\n    \"\"\"\n    if not strings:\n        return []\n\n    filtered_results = []\n    for s in strings:\n        if substring in s:\n            filtered_results.append(s)\n    return filtered_results"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    current_sum = 0\n    current_product = 1\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/9", "solution": "from typing import List\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_maximums: List[int] = []\n    current_max: int = float('-inf')  # Initialize to ensure any integer is greater\n\n    for number in numbers:\n        if number > current_max:\n            current_max = number\n        rolling_maximums.append(current_max)\n\n    return rolling_maximums"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result: List[int] = []\n    current_max: int = numbers[0]\n\n    for number in numbers:\n        current_max = max(current_max, number)\n        result.append(current_max)\n\n    return result"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\ndef reverse_string(s: str) -> str:\n    \"\"\"Reverses a string.\"\"\"\n    return s[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    n = len(string)\n    longest_palindromic_postfix = \"\"\n    # Find the longest palindromic postfix of the input string\n    for i in range(n):\n        postfix = string[i:]\n        if is_palindrome(postfix):\n            longest_palindromic_postfix = postfix\n            break # The first palindromic postfix found from the left is the longest\n\n    # Identify the non-palindromic prefix\n    prefix_to_reverse = string[:n - len(longest_palindromic_postfix)]\n\n    # Reverse the non-palindromic prefix\n    reversed_prefix = reverse_string(prefix_to_reverse)\n\n    # Append the reversed prefix to the original string to form the shortest palindrome\n    return string + reversed_prefix"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome.\n    Compares the string with its reverse.\n    \"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Identifies the longest palindromic suffix and appends the reverse of the preceding prefix.\n    \"\"\"\n    if not string:\n        return \"\"\n\n    suffix_start_index = 0\n    for i in range(len(string)):\n        if is_palindrome(string[i:]):\n            suffix_start_index = i\n            break\n\n    if suffix_start_index == 0:\n        return string\n    else:\n        prefix_to_reverse = string[:suffix_start_index]\n        reversed_prefix = prefix_to_reverse[::-1]\n        return string + reversed_prefix"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    result_chars = []\n    # Iterates through the input strings to perform bit-wise XOR.\n    for i in range(len(a)):\n        # Compares characters at the current index and appends '0' or '1' to the result.\n        if a[i] == b[i]:\n            result_chars.append('0')\n        else:\n            result_chars.append('1')\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/11", "solution": "from typing import List\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    \"\"\"\n    result_chars: List[str] = []\n    for i in range(len(a)):\n        if a[i] != b[i]:\n            result_chars.append('1')\n        else:\n            result_chars.append('0')\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Out of list of strings, return the longest one.\n    Returns None if the input list is empty; otherwise, returns the first longest string encountered.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_found: Optional[str] = None\n    max_length: int = -1\n\n    for current_string in strings:\n        current_string_length = len(current_string)\n        if current_string_length > max_length:\n            longest_found = current_string\n            max_length = current_string_length\n        # If current_string_length == max_length, no change is made.\n        # This ensures the first encountered longest string is retained (FR3).\n\n    return longest_found"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Out of list of strings, return the longest one.\n    Returns None if the input list is empty, or the first encountered longest string.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_str = strings[0]\n    max_len = len(strings[0])\n\n    for s in strings[1:]:\n        if len(s) > max_len:\n            longest_str = s\n            max_len = len(s)\n\n    return longest_str"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the greatest common divisor (GCD) of two integers using the Euclidean algorithm.\n    Ensures positive inputs for the algorithm, as GCD(a,b) = GCD(|a|,|b|).\n    \"\"\"\n    a = abs(a)\n    b = abs(b)\n\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the greatest common divisor (GCD) of two integers using the Euclidean algorithm.\n\n    Args:\n        a: The first integer.\n        b: The second integer.\n\n    Returns:\n        The greatest common divisor of a and b.\n    \"\"\"\n    # Ensure non-negative for standard Euclidean algorithm behavior\n    # The SRS examples (3,5 and 25,15) imply positive integers.\n    # For robustness, handle absolute values if negative inputs are possible and GCD is expected to be positive.\n    a = abs(a)\n    b = abs(b)\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/14", "solution": "from typing import List\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string.\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    prefixes: List[str] = []\n    for i in range(len(string)):\n        # Generate the prefix from the start of the string up to index i.\n        current_prefix = string[0:i+1]\n        prefixes.append(current_prefix)\n    return prefixes"}
