{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"Checks if a string is happy.\n    A string is happy if its length is at least 3 and every 3 consecutive letters are distinct.\n    \"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        char1 = s[i]\n        char2 = s[i+1]\n        char3 = s[i+2]\n\n        # Check if all three characters are distinct.\n        # If any two are the same, they are not distinct.\n        if char1 == char2 or char1 == char3 or char2 == char3:\n            return False\n\n    return True"}
{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"Checks if a string is happy: at least 3 chars long and every 3 consecutive letters are distinct.\n    Returns True if happy, False otherwise.\n    \"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        # Extract a 3-character sequence\n        sub = s[i:i+3]\n        # Check if characters in the sequence are distinct\n        if len(set(sub)) != 3:\n            return False\n\n    return True"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPAs into a corresponding list of letter grades.\n    Applies a predefined grading scale for the conversion.\"\"\"\n\n    converted_grades = []\n\n    def _convert_single_gpa(gpa_value):\n        # Applies specific GPA to letter grade conversion rules.\n        if gpa_value == 4.0:\n            return 'A+'\n        elif gpa_value > 3.7:\n            return 'A'\n        elif gpa_value > 3.3:\n            return 'A-'\n        elif gpa_value > 3.0:\n            return 'B+'\n        elif gpa_value > 2.7:\n            return 'B'\n        elif gpa_value > 2.3:\n            return 'B-'\n        elif gpa_value > 2.0:\n            return 'C+'\n        elif gpa_value > 1.7:\n            return 'C'\n        elif gpa_value > 1.3:\n            return 'C-'\n        elif gpa_value > 1.0:\n            return 'D+'\n        elif gpa_value > 0.7:\n            return 'D'\n        elif gpa_value > 0.0:\n            return 'D-'\n        elif gpa_value == 0.0:\n            return 'E'\n        else:\n            return 'E' # Default for values less than 0.0\n\n    for gpa in grades:\n        converted_grades.append(_convert_single_gpa(gpa))\n\n    return converted_grades"}
{"task_id": "HumanEval/82", "solution": "def _is_prime(n: int) -> bool:\n    \"\"\"Checks if an integer is a prime number.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    # Check for odd divisors up to the square root of n.\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\ndef prime_length(string: str) -> bool:\n    \"\"\"Returns True if the string's length is prime, False otherwise.\"\"\"\n    length = len(string)\n    return _is_prime(length)"}
{"task_id": "HumanEval/81", "solution": "def _convert_single_gpa_to_letter_grade(gpa: float) -> str:\n    \"\"\"Converts a single GPA to its corresponding letter grade based on a defined scale.\n    This helper function ensures modularity for the core grading logic.\"\"\"\n    if gpa == 4.0:\n        return 'A+'\n    elif gpa > 3.7:\n        return 'A'\n    elif gpa > 3.3:\n        return 'A-'\n    elif gpa > 3.0:\n        return 'B+'\n    elif gpa > 2.7:\n        return 'B'\n    elif gpa > 2.3:\n        return 'B-'\n    elif gpa > 2.0:\n        return 'C+'\n    elif gpa > 1.7:\n        return 'C'\n    elif gpa > 1.3:\n        return 'C-'\n    elif gpa > 1.0:\n        return 'D+'\n    elif gpa > 0.7:\n        return 'D'\n    elif gpa > 0.0:\n        return 'D-'\n    elif gpa == 0.0:\n        return 'E'\ndef numerical_letter_grade(grades: list[float]) -> list[str]:\n    \"\"\"Converts a list of numerical GPAs into a list of corresponding letter grades.\n    Each GPA is processed individually to maintain the order of grades in the output.\"\"\"\n    result_grades = []\n    for gpa in grades:\n        letter_grade = _convert_single_gpa_to_letter_grade(gpa)\n        result_grades.append(letter_grade)\n    return result_grades"}
{"task_id": "HumanEval/82", "solution": "import math\ndef prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise.\n    \"\"\"\n    length = len(string)\n\n    if length <= 1:\n        return False\n\n    # The design explicitly handles length 2 by returning True.\n    # Our general primality test correctly handles 2:\n    # isqrt(2) is 1. The loop range(2, 1+1) is empty, so it returns True.\n\n    limit = math.isqrt(length)\n    for i in range(2, limit + 1):\n        if length % i == 0:\n            return False\n    return True"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Calculates the sum of decimal digits of N and converts the sum to its binary string representation.\n    The function returns the resulting binary string without the '0b' prefix.\n    \"\"\"\n    digit_sum = 0\n    for digit_char in str(N):\n        digit_sum += int(digit_char)\n\n    raw_binary_string = bin(digit_sum)\n    formatted_binary_string = raw_binary_string[2:]\n    return formatted_binary_string"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Calculates the count of n-digit positive integers that start or end with 1.\n    Assumes n is a positive integer.\n    \"\"\"\n    # If n is 1, the count is 1.\n    if n == 1:\n        return 1\n\n    # If n is greater than 1, use inclusion-exclusion principle.\n    # The number of n-digit positive integers starting with 1 is 10^(n-1).\n    count_starts_with_1 = 10**(n - 1)\n\n    # The number of n-digit positive integers ending with 1 is 9 * 10^(n-2).\n    count_ends_with_1 = 9 * (10**(n - 2))\n\n    # The number of n-digit positive integers starting with 1 AND ending with 1 is 10^(n-2).\n    count_starts_and_ends_with_1 = 10**(n - 2)\n\n    # The total count is count_starts_with_1 + count_ends_with_1 - count_starts_and_ends_with_1.\n    total_count = count_starts_with_1 + count_ends_with_1 - count_starts_and_ends_with_1\n\n    return total_count"}
{"task_id": "HumanEval/84", "solution": "def _calculate_digit_sum(N: int) -> int:\n    \"\"\"Calculates the sum of the decimal digits of N.\n    It converts N to a string and sums its integer digits.\n    \"\"\"\n    digit_sum = 0\n    s_N = str(N)\n    for digit_char in s_N:\n        digit_sum += int(digit_char)\n    return digit_sum\ndef _convert_to_binary_string(num: int) -> str:\n    \"\"\"Converts a non-negative integer to its binary string.\n    Uses Python's built-in bin() function and removes the '0b' prefix.\n    \"\"\"\n    if num == 0:\n        return \"0\"\n    return bin(num)[2:]\ndef solve(N: int) -> str:\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    Constraints: 0 \u2264 N \u2264 10000.\n    \"\"\"\n    digit_sum = _calculate_digit_sum(N)\n    binary_string = _convert_to_binary_string(digit_sum)\n    return binary_string"}
{"task_id": "HumanEval/83", "solution": "def _count_starts_with_one(n: int) -> int:\n    \"\"\"Calculates the count of n-digit numbers that start with 1.\n    For n >= 1, this is 10^(n-1).\"\"\"\n    return 10**(n - 1)\ndef _count_ends_with_one(n: int) -> int:\n    \"\"\"Calculates the count of n-digit numbers that end with 1.\n    For n=1, the number is 1; for n>1, the first digit has 9 choices, and n-2 digits have 10 choices each.\"\"\"\n    if n == 1:\n        return 1\n    return 9 * (10**(n - 2))\ndef _count_starts_and_ends_with_one(n: int) -> int:\n    \"\"\"Calculates the count of n-digit numbers that start AND end with 1.\n    For n=1 or n=2, there is 1 such number; for n>2, the n-2 middle digits have 10 choices each.\"\"\"\n    return 10**(max(0, n - 2))\ndef starts_one_ends(n: int) -> int:\n    \"\"\"\n    Given a positive integer n, return the count of n-digit positive integers\n    that start or end with 1, using the inclusion-exclusion principle.\n    \"\"\"\n    count_starts = _count_starts_with_one(n)\n    count_ends = _count_ends_with_one(n)\n    count_both = _count_starts_and_ends_with_one(n)\n\n    total_count = count_starts + count_ends - count_both\n    return total_count"}
{"task_id": "HumanEval/85", "solution": "def add(lst: list[int]) -> int:\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices.\"\"\"\n    total_sum = 0\n    for index, element in enumerate(lst):\n        # Add the element to the sum if its index is odd and the element itself is even.\n        if index % 2 != 0 and element % 2 == 0:\n            total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"Given a non-empty list of integers lst, add the even elements that are at odd indices.\n    Examples: add([4, 2, 6, 7]) ==> 2\n    \"\"\"\n    total_sum = 0\n    for i, element in enumerate(lst):\n        if i % 2 != 0:\n            if element % 2 == 0:\n                total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s: str) -> str:\n    \"\"\"\n    Sorts characters within each word of a string based on ASCII values.\n    Preserves word order and spacing.\n    \"\"\"\n    words = s.split(' ')\n    sorted_words = []\n    for word in words:\n        if word:\n            sorted_chars = sorted(list(word))\n            sorted_words.append(\"\".join(sorted_chars))\n        else:\n            sorted_words.append(\"\")\n    return \" \".join(sorted_words)"}
{"task_id": "HumanEval/86", "solution": "import abc\nfrom typing import List\nclass Token(abc.ABC):\n    \"\"\"Abstract base class for string segments.\"\"\"\n    def __init__(self, value: str, original_index: int):\n        self._value = value\n        self._original_index = original_index\n\n    @abc.abstractmethod\n    def get_value(self) -> str:\n        \"\"\"Returns the string value of the token.\"\"\"\n        pass\n\n    def get_original_index(self) -> int:\n        \"\"\"Returns the original starting index of the token.\"\"\"\n        return self._original_index\nclass Word(Token):\n    \"\"\"Represents a word token, a sequence of non-space characters.\"\"\"\n    def __init__(self, value: str, original_index: int):\n        super().__init__(value, original_index)\n\n    def get_value(self) -> str:\n        \"\"\"Returns the original string value of the word.\"\"\"\n        return self._value\n\n    def sort_characters_by_ascii(self) -> str:\n        \"\"\"Reorders characters within the word in ascending ASCII order.\"\"\"\n        return \"\".join(sorted(self._value))\nclass Space(Token):\n    \"\"\"Represents a space token, a sequence of one or more space characters.\"\"\"\n    def __init__(self, value: str, original_index: int):\n        super().__init__(value, original_index)\n\n    def get_value(self) -> str:\n        \"\"\"Returns the original string value of the space.\"\"\"\n        return self._value\ndef anti_shuffle(s: str) -> str:\n    \"\"\"\n    Takes a string and returns an ordered version of it.\n    Words are replaced by a new word with characters arranged in ascending ASCII order.\n    \"\"\"\n    tokens: List[Token] = []\n    current_pos = 0\n    while current_pos < len(s):\n        if s[current_pos].isspace():\n            start = current_pos\n            while current_pos < len(s) and s[current_pos].isspace():\n                current_pos += 1\n            tokens.append(Space(s[start:current_pos], start))\n        else:\n            start = current_pos\n            while current_pos < len(s) and not s[current_pos].isspace():\n                current_pos += 1\n            tokens.append(Word(s[start:current_pos], start))\n\n    processed_parts: List[str] = []\n    for token in tokens:\n        if isinstance(token, Word):\n            processed_parts.append(token.sort_characters_by_ascii())\n        elif isinstance(token, Space):\n            processed_parts.append(token.get_value())\n\n    return \"\".join(processed_parts)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds occurrences of x in a 2D list and returns their sorted (row, column) coordinates.\n    Sorts primarily by row ascending, and secondarily by column descending.\n    \"\"\"\n    if not lst:\n        return []\n\n    found_coordinates = []\n\n    for row_index, row in enumerate(lst):\n        for col_index, element in enumerate(row):\n            if element == x:\n                found_coordinates.append((row_index, col_index))\n\n    if not found_coordinates:\n        return []\n\n    # Sort coordinates: primary by row_index ascending, secondary by column_index descending.\n    # A negative column_index is used in the key to achieve descending order for columns.\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return found_coordinates"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst: list[list[int]], x: int) -> list[tuple[int, int]]:\n    \"\"\"\n    Finds occurrences of integer x in a nested list lst and returns sorted coordinates.\n    Sorts primarily by row ascending, then by column descending.\n    \"\"\"\n    coordinates = []\n    for row_idx, row in enumerate(lst):\n        for col_idx, item in enumerate(row):\n            if item == x:\n                coordinates.append((row_idx, col_idx))\n\n    coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n    return coordinates"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating lowercase English letters four positions forward, with wrap-around.\n    Non-lowercase English letters remain unchanged.\"\"\"\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Calculate 0-indexed position and shift it by 4 with wrap-around.\n            original_pos = ord(char) - ord('a')\n            shifted_pos = (original_pos + 4) % 26\n            encrypted_char = chr(shifted_pos + ord('a'))\n            encrypted_chars.append(encrypted_char)\n        else:\n            # Append non-lowercase letters without modification.\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n    \"\"\"\n    working_array = list(array) # Create a shallow copy to ensure immutability of the original array.\n\n    if len(working_array) <= 1:\n        return working_array # Return as is for empty or single-element arrays.\n\n    first_element = working_array[0]\n    last_element = working_array[-1]\n    sum_elements = first_element + last_element\n\n    if sum_elements % 2 != 0:  # If sum is odd\n        working_array.sort() # Sort in ascending order.\n    else:  # If sum is even\n        working_array.sort(reverse=True) # Sort in descending order.\n\n    return working_array"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, sort a copy based on sum of first and last elements.\n    Sorts ascending if sum is odd, descending if sum is even.\n    \"\"\"\n    if not array:\n        return []\n\n    if len(array) == 1:\n        return list(array)\n\n    copied_array = list(array)\n    first_last_sum = array[0] + array[-1]\n\n    if first_last_sum % 2 != 0:\n        copied_array.sort()\n    else:\n        copied_array.sort(reverse=True)\n\n    return copied_array"}
{"task_id": "HumanEval/89", "solution": "ROTATION_AMOUNT = 4\nALPHABET_SIZE = 26\nUPPER_A_ORD = ord('A')\nLOWER_A_ORD = ord('a')\ndef _is_alphabetic(char: str) -> bool:\n    \"\"\"Checks if a character is an English alphabet letter.\"\"\"\n    return ('a' <= char <= 'z') or ('A' <= char <= 'Z')\ndef _is_uppercase(char: str) -> bool:\n    \"\"\"Determines if a character is an uppercase English alphabet letter.\"\"\"\n    return 'A' <= char <= 'Z'\ndef _rotate_char(char: str, rotation: int) -> str:\n    \"\"\"Rotates an alphabetic character by a given amount, preserving case.\"\"\"\n    if _is_uppercase(char):\n        base = UPPER_A_ORD\n    else:\n        base = LOWER_A_ORD\n\n    offset = (ord(char) - base + rotation) % ALPHABET_SIZE\n    return chr(base + offset)\ndef encrypt(s: str) -> str:\n    \"\"\"Encrypts a string by rotating alphabetic characters by 4 positions, preserving case.\n    Non-alphabetic characters remain unchanged.\n    \"\"\"\n    encrypted_chars = []\n    for char in s:\n        if _is_alphabetic(char):\n            encrypted_chars.append(_rotate_char(char, ROTATION_AMOUNT))\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    You are given a list of integers.\n    Write a function next_smallest() that returns the 2nd smallest element of the list.\n    Return None if there is no such element.\n\n    next_smallest([1, 2, 3, 4, 5]) == 2\n    next_smallest([5, 1, 4, 3, 2]) == 2\n    next_smallest([]) == None\n    next_smallest([1, 1]) == None\n    \"\"\"\n    if not lst:\n        return None\n\n    unique_elements = sorted(list(set(lst)))\n\n    if len(unique_elements) < 2:\n        return None\n\n    return unique_elements[1]"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Finds the second smallest unique element in a list of integers.\n    Returns None if the list is empty or has fewer than two unique elements.\n    \"\"\"\n    if not lst:\n        return None\n\n    unique_elements = sorted(list(set(lst)))\n\n    if len(unique_elements) < 2:\n        return None\n    else:\n        return unique_elements[1]"}
{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    Counts sentences starting with \"I\" in a given string.\n    Sentences are delimited by '.', '?', or '!'.\n    \"\"\"\n    # 1. Handle Empty Input (NFR5)\n    if not S:\n        return 0\n\n    # 2. Pre-process Input String (NFR2)\n    S = S.strip()\n\n    # If S becomes empty after stripping (e.g., input was \"   \"), return 0\n    if not S:\n        return 0\n\n    # 3. Initialize Counter\n    boredom_count = 0\n\n    # 4. Sentence Segmentation (FR2, NFR6, NFR7)\n    DELIMITERS = ('.', '?', '!') # Using a tuple for slight efficiency/immutability\n    raw_sentences = []\n    current_sentence_start = 0\n\n    for i, char in enumerate(S):\n        if char in DELIMITERS:\n            # Append the segment of the string before the delimiter\n            raw_sentences.append(S[current_sentence_start:i])\n            # Move the start pointer to the character immediately after the delimiter\n            current_sentence_start = i + 1\n\n    # After the loop, append any remaining part of the string.\n    # This handles the last sentence if it doesn't end with a delimiter,\n    # or the entire string if no delimiters were found (NFR6).\n    raw_sentences.append(S[current_sentence_start:])\n\n    # 5. Process Each Sentence\n    for raw_sentence in raw_sentences:\n        # Trim Sentence Whitespace (NFR3)\n        trimmed_sentence = raw_sentence.strip()\n\n        # Filter Empty Sentences (NFR7)\n        # This handles cases like consecutive delimiters (e.g., \"Hello..World!\")\n        # where an empty string might appear between them after segmentation.\n        if not trimmed_sentence:\n            continue\n\n        # Check for \"I\" (FR3, NFR1, NFR4)\n        # The check must be case-sensitive (NFR4) and ensure \"I\" is a standalone word (NFR1).\n        # This is achieved by checking for \"I \" (I followed by a space)\n        # or if the sentence consists solely of \"I\".\n        if trimmed_sentence.startswith(\"I \") or trimmed_sentence == \"I\":\n            boredom_count += 1\n\n    # 6. Return Count (FR4)\n    return boredom_count"}
{"task_id": "HumanEval/91", "solution": "def _split_into_sentences(text: str, delimiters: tuple) -> list[str]:\n    \"\"\"Splits text into sentences using specified delimiters.\n    It cleans up resulting empty strings and strips whitespace from sentences.\n    \"\"\"\n    temp_char = '###SENTENCE_DELIMITER###' # A unique sequence unlikely to appear in text\n\n    # Replace all delimiters with the unique temporary character\n    for delim in delimiters:\n        text = text.replace(delim, temp_char)\n\n    # Split by the temporary character\n    sentences = text.split(temp_char)\n\n    # Clean up sentences: strip whitespace and remove empty strings\n    cleaned_sentences = []\n    for sentence in sentences:\n        stripped_sentence = sentence.strip()\n        if stripped_sentence:\n            cleaned_sentences.append(stripped_sentence)\n\n    return cleaned_sentences\ndef _starts_with_i(sentence: str) -> bool:\n    \"\"\"Checks if a sentence starts with the standalone word 'I' (case-insensitive).\n    It trims leading whitespace and checks the first character and the one following.\n    \"\"\"\n    cleaned_sentence = sentence.lstrip() # Only lstrip needed for first word check\n\n    if not cleaned_sentence:\n        return False\n\n    # Check if the sentence starts with 'I' (case-insensitive)\n    if cleaned_sentence[0].lower() == 'i':\n        # If it's just 'I', it counts\n        if len(cleaned_sentence) == 1:\n            return True\n        # If 'I' is followed by a non-alphabetic character, it counts as a standalone word 'I'\n        if not cleaned_sentence[1].isalpha():\n            return True\n\n    return False\ndef is_bored(S: str) -> int:\n    \"\"\"Counts sentences that start with the word \"I\" (case-insensitive).\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    boredom_count = 0\n    delimiters = ('.', '?', '!')\n\n    sentences = _split_into_sentences(S, delimiters)\n\n    for sentence in sentences:\n        if _starts_with_i(sentence):\n            boredom_count += 1\n\n    return boredom_count"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Checks if all three numbers are integers and if one equals the sum of the other two.\n    Returns True if both conditions are met, False otherwise.\n    '''\n    # Check if all numbers represent integers (e.g., 5, 5.0 are integers, 5.1 is not).\n    are_all_integers = (x == int(x)) and (y == int(y)) and (z == int(z))\n\n    # Check if one number is equal to the sum of the other two.\n    is_sum_condition_met = (x == y + z) or \\\n                           (y == x + z) or \\\n                           (z == x + y)\n\n    return are_all_integers and is_sum_condition_met"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Checks if all three numbers are integers and if one is the sum of the other two.\\\n    Returns True if both conditions are met, False otherwise.\\\n    '''\n    if not isinstance(x, int) or not isinstance(y, int) or not isinstance(z, int):\n        return False\n\n    return (x == y + z) or \\\n           (y == x + z) or \\\n           (z == x + y)"}
{"task_id": "HumanEval/93", "solution": "_ALPHABET_LOWER = \"abcdefghijklmnopqrstuvwxyz\"\n_ALPHABET_UPPER = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\ndef _is_alphabet_letter(char: str) -> bool:\n    \"\"\"Checks if a character is an English alphabet letter.\"\"\"\n    return char in _ALPHABET_LOWER or char in _ALPHABET_UPPER\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is an English vowel (case-insensitive).\"\"\"\n    return char.lower() in \"aeiou\"\ndef _get_two_places_ahead(vowel: str) -> str:\n    \"\"\"Returns the letter two places ahead, maintaining case.\"\"\"\n    if vowel in _ALPHABET_LOWER:\n        idx = _ALPHABET_LOWER.index(vowel)\n        return _ALPHABET_LOWER[(idx + 2) % 26]\n    else: # char must be in _ALPHABET_UPPER\n        idx = _ALPHABET_UPPER.index(vowel)\n        return _ALPHABET_UPPER[(idx + 2) % 26]\ndef _swap_case(char: str) -> str:\n    \"\"\"Swaps the case of an English alphabet letter.\"\"\"\n    if char in _ALPHABET_LOWER:\n        return char.upper()\n    else: # char must be in _ALPHABET_UPPER\n        return char.lower()\ndef encode(message: str) -> str:\n    \"\"\"\n    Encodes a message by swapping letter cases and shifting vowels.\n    Non-alphabetical characters are preserved.\n    \"\"\"\n    encoded_chars = []\n    for char in message:\n        if _is_alphabet_letter(char):\n            current_char = char\n            if _is_vowel(current_char):\n                current_char = _get_two_places_ahead(current_char)\n            current_char = _swap_case(current_char)\n            encoded_chars.append(current_char)\n        else:\n            encoded_chars.append(char)\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping letter cases and shifting specific vowels two places ahead.\n    Non-alphabetic characters remain unchanged.\n    \"\"\"\n    VOWELS = \"AEIOUaeiou\"\n    ALPHABET_LOWER = \"abcdefghijklmnopqrstuvwxyz\"\n    ALPHABET_UPPER = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n\n    encoded_chars = []\n    for char in message:\n        if char.isalpha():\n            swapped_char = char.swapcase()\n\n            # Check if the original character was a vowel\n            if char in VOWELS:\n                # If original was a vowel, shift the swapped character\n                if swapped_char.islower():\n                    alphabet = ALPHABET_LOWER\n                else:\n                    alphabet = ALPHABET_UPPER\n\n                index = alphabet.index(swapped_char)\n                shifted_index = (index + 2) % len(alphabet)\n                processed_char = alphabet[shifted_index]\n            else:\n                # If original was not a vowel, just keep the swapped character\n                processed_char = swapped_char\n        else:\n            # Non-alphabetic characters are retained unchanged\n            processed_char = char\n        encoded_chars.append(processed_char)\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "def _is_prime(n: int) -> bool:\n    \"\"\"Determines if a given integer n is a prime number.\n    Handles base cases and checks for divisibility up to its square root.\"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\ndef _sum_digits(n: int) -> int:\n    \"\"\"Calculates the sum of the absolute digits of a given integer n.\n    It iteratively sums digits using modulo and integer division.\"\"\"\n    n = abs(n)\n    total_sum = 0\n    while n > 0:\n        total_sum += n % 10\n        n //= 10\n    return total_sum\ndef skjkasdkd(lst: list[int]) -> int:\n    \"\"\"Finds the largest prime number in a list and returns the sum of its digits.\n    If no prime is found, it returns 0.\"\"\"\n    largest_prime = None\n    for num in lst:\n        if _is_prime(num):\n            if largest_prime is None or num > largest_prime:\n                largest_prime = num\n\n    if largest_prime is None:\n        return 0\n    else:\n        return _sum_digits(largest_prime)"}
{"task_id": "HumanEval/94", "solution": "import math\ndef is_prime(n: int) -> bool:\n    \"\"\"Checks if a number is prime. It returns True for primes greater than 1.\"\"\"\n    if n <= 1:\n        return False\n    # Check for divisibility from 2 up to the square root of n.\n    for i in range(2, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            return False\n    return True\ndef sum_digits(n: int) -> int:\n    \"\"\"Calculates the sum of the digits of a number. Converts the number to a string to process digits.\"\"\"\n    return sum(int(digit) for digit in str(n))\ndef skjkasdkd(lst: list[int]) -> int:\n    \"\"\"\n    Finds the largest prime in a list and returns the sum of its digits.\n    It filters for primes, finds the maximum, then sums its digits.\n    \"\"\"\n    prime_numbers = []\n    for num in lst:\n        if is_prime(num):\n            prime_numbers.append(num)\n\n    # As per design, assuming the input list will contain at least one prime.\n    largest_prime = max(prime_numbers)\n\n    return sum_digits(largest_prime)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict: dict) -> bool:\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    \"\"\"\n    if not dict:\n        return False\n\n    all_lowercase = True\n    all_uppercase = True\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n\n        if key != key.lower():\n            all_lowercase = False\n        if key != key.upper():\n            all_uppercase = False\n\n    return all_lowercase or all_uppercase"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Checks if all keys in the input dictionary are strings and are either all lowercase or all uppercase.\n    Returns True if all keys are strings and are all lowercase or all uppercase, False otherwise.\n    \"\"\"\n    if not dict:\n        return False\n\n    all_lower = True\n    all_upper = True\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n\n        if not key.islower():\n            all_lower = False\n        if not key.isupper():\n            all_upper = False\n\n        if not all_lower and not all_upper:\n            return False\n\n    if all_lower:\n        return True\n    elif all_upper:\n        return True\n    else:\n        return False"}
{"task_id": "HumanEval/97", "solution": "def multiply(a, b):\n    \"\"\"Calculates the product of the absolute unit digits of two integers.\n    Assumes valid integer inputs are always provided.\"\"\"\n    unit_digit_a = abs(a % 10)\n    unit_digit_b = abs(b % 10)\n    product = unit_digit_a * unit_digit_b\n    return product"}
{"task_id": "HumanEval/96", "solution": "def _is_prime(number: int) -> bool:\n    \"\"\"Checks if a number is prime.\n    Returns True if prime, False otherwise.\n    \"\"\"\n    if number < 2:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True\ndef count_up_to(n: int) -> list[int]:\n    \"\"\"Finds all prime numbers strictly less than n.\n    Returns a list of these prime numbers.\n    \"\"\"\n    if n < 2:\n        return []\n\n    primes_list = []\n    for number in range(2, n):\n        if _is_prime(number):\n            primes_list.append(number)\n    return primes_list"}
{"task_id": "HumanEval/96", "solution": "import math\ndef _is_prime(number: int) -> bool:\n    \"\"\"Determines if a given integer is a prime number. Adheres to BR2: A prime number is a natural number greater than 1 that has no positive divisors other than 1 and itself.\"\"\"\n    if number < 2:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    # Check for divisors from 3 up to sqrt(number)\n    for i in range(3, int(math.sqrt(number)) + 1, 2):\n        if number % i == 0:\n            return False\n    return True\ndef count_up_to(n):\n    \"\"\"Implement a function that takes a non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    for example:\n    count_up_to(5) => [2,3]\n    count_up_to(11) => [2,3,5,7]\n    count_up_to(0) => []\n    count_up_to(20) => [2,3,5,7,11,13,17,19]\n    count_up_to(1) => []\n    count_up_to(18) => [2,3,5,7,11,13,17]\n    \"\"\"\n    if n < 2:\n        return []\n\n    primes = []\n    for number in range(2, n):\n        if _is_prime(number):\n            primes.append(number)\n    return primes"}
{"task_id": "HumanEval/97", "solution": "def _get_absolute_unit_digit(number: int) -> int:\n    \"\"\"Extracts the absolute value of the unit digit from a given integer.\n    Uses modulo and abs() to ensure the unit digit is positive.\"\"\"\n    return abs(number % 10)\ndef multiply(a: int, b: int) -> int:\n    \"\"\"Complete the function that takes two integers and returns\n    the product of their unit digits.\n    Assume the input is always valid.\n    Examples:\n    multiply(148, 412) should return 16.\n    multiply(19, 28) should return 72.\n    multiply(2020, 1851) should return 0.\n    multiply(14,-15) should return 20.\n    \"\"\"\n    unit_digit_a = _get_absolute_unit_digit(a)\n    unit_digit_b = _get_absolute_unit_digit(b)\n    return unit_digit_a * unit_digit_b"}
