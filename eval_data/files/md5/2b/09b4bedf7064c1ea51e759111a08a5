{"task_id": "HumanEval/32", "solution": "import math\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    Finds x such that poly(x) = 0, returning one zero point for odd-degree polynomials.\n    \"\"\"\n    tolerance = 1e-6  # Define a tolerance for finding the root.\n\n    # Initial search interval.\n    low = -1.0\n    high = 1.0\n\n    # Expand the interval until a sign change is found or a root is at an endpoint.\n    # This loop is designed to bracket a root for odd-degree polynomials.\n    for _ in range(100):  # Limit iterations for interval expansion.\n        p_low = poly(xs, low)\n        p_high = poly(xs, high)\n\n        if math.isclose(p_low, 0.0, abs_tol=tolerance):\n            return low\n        if math.isclose(p_high, 0.0, abs_tol=tolerance):\n            return high\n\n        if p_low * p_high < 0:  # Found an interval with sign change.\n            break\n\n        low *= 2\n        high *= 2\n\n    # Bisection iterations to refine the root within the bracketed interval.\n    max_bisection_iterations = 100  # Maximum iterations to converge on the root.\n\n    for _ in range(max_bisection_iterations):\n        mid = (low + high) / 2\n        p_mid = poly(xs, mid)\n\n        if math.isclose(p_mid, 0.0, abs_tol=tolerance):\n            return mid\n\n        # Determine which half of the interval contains the root based on sign change.\n        if poly(xs, low) * p_mid < 0:\n            high = mid\n        else:\n            low = mid\n\n    # If the maximum number of iterations is reached, return the midpoint\n    # of the current interval as the best approximation found.\n    return (low + high) / 2"}
{"task_id": "HumanEval/32", "solution": "import math\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero finds an x such that poly(x) = 0 using the bisection method.\n    \"\"\"\n    n = len(xs) - 1\n\n    # Calculate a search bound R for roots based on polynomial coefficients.\n    # This assumes xs[-1] is non-zero, guaranteeing an odd-degree polynomial.\n    max_abs_val_other_coeffs = 0\n    if n > 0:\n        max_abs_val_other_coeffs = max(abs(coeff) for coeff in xs[:-1])\n    leading_coeff = xs[-1]\n    R = 1 + max_abs_val_other_coeffs / abs(leading_coeff) if leading_coeff != 0 else 1000.0\n\n    low, high = -R, R\n    tolerance = 1e-7\n\n    # Perform bisection to converge on a root within the [low, high] interval.\n    # The loop continues until the interval width is less than the specified tolerance.\n    while (high - low) > tolerance:\n        mid = (low + high) / 2\n        p_mid = poly(xs, mid)\n        if abs(p_mid) < tolerance:\n            return mid\n        if poly(xs, low) * p_mid < 0:\n            high = mid\n        else:\n            low = mid\n\n    return (low + high) / 2"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    \"\"\"\n    if not l:\n        return []\n\n    l_prime = [None] * len(l)\n    divisible_by_three_values = []\n    divisible_by_three_indices = []\n\n    for i in range(len(l)):\n        if i % 3 == 0:\n            divisible_by_three_values.append(l[i])\n            divisible_by_three_indices.append(i)\n        else:\n            l_prime[i] = l[i]\n\n    divisible_by_three_values.sort()\n\n    for j, original_index in enumerate(divisible_by_three_indices):\n        l_prime[original_index] = divisible_by_three_values[j]\n\n    return l_prime"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list) -> list:\n    \"\"\"This function sorts elements at indices divisible by three in a list,\n    returning a new list with other elements unchanged.\"\"\"\n    output_list = list(l)\n    indices_to_sort = [i for i in range(len(l)) if i % 3 == 0]\n    values_to_sort = [l[i] for i in indices_to_sort]\n    values_to_sort.sort()\n    for i, original_index in enumerate(indices_to_sort):\n        output_list[original_index] = values_to_sort[i]\n    return output_list"}
