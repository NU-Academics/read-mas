{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # For odd length lists, the median is the middle element.\n        median_value = sorted_l[n // 2]\n    else:\n        # For even length lists, the median is the average of the two middle elements.\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        median_value = (mid1 + mid2) / 2\n\n    # Convert to integer if the median is a whole number, otherwise return as float.\n    if median_value == int(median_value):\n        return int(median_value)\n    else:\n        return median_value"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int) -> int:\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize with base values for fib4(0), fib4(1), fib4(2), fib4(3)\n    a0, a1, a2, a3 = 0, 0, 2, 0\n\n    for _ in range(4, n + 1):\n        next_fib = a3 + a2 + a1 + a0\n        a0 = a1\n        a1 = a2\n        a2 = a3\n        a3 = next_fib\n\n    return a3"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    The median is the middle element of a sorted list, or the average of the two middle elements.\n    \"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # Odd number of elements, return the middle one\n        median_value = sorted_l[n // 2]\n    else:\n        # Even number of elements, return the average of the two middle ones\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        median_value = (mid1 + mid2) / 2.0\n\n    # Determine if the median_value should be returned as an int or float\n    if median_value == int(median_value):\n        return int(median_value)\n    else:\n        return float(median_value)"}
