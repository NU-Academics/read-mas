{"task_id": "HumanEval/36", "solution": "def _is_divisible_by_11_or_13(number: int) -> bool:\n    \"\"\"Determines if a given number is divisible by 11 or 13.\n    This is an internal helper function.\n    \"\"\"\n    return (number % 11 == 0) or (number % 13 == 0)\ndef _count_digit_in_number(number: int, digit: int) -> int:\n    \"\"\"Counts occurrences of a specific digit within a given number.\n    This is an internal helper function.\n    \"\"\"\n    return str(number).count(str(digit))\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n\n    which are divisible by 11 or 13.\n    \"\"\"\n    total_count_of_7 = 0\n    for i in range(n):\n        if _is_divisible_by_11_or_13(i):\n            total_count_of_7 += _count_digit_in_number(i, 7)\n    return total_count_of_7"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a new list where odd-indexed values are preserved,\n    and even-indexed values are sorted in ascending order from the original list.\n    \"\"\"\n    length = len(l)\n    l_prime = [None] * length\n\n    even_values = []\n    for i in range(length):\n        if i % 2 == 0:\n            even_values.append(l[i])\n\n    sorted_even_values = sorted(even_values)\n\n    sorted_idx = 0\n    for i in range(length):\n        if i % 2 != 0:  # Odd index\n            l_prime[i] = l[i]\n        else:  # Even index\n            l_prime[i] = sorted_even_values[sorted_idx]\n            sorted_idx += 1\n\n    return l_prime"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    \"\"\"\n    if not l:\n        return []\n    even_indexed_values = []\n    for i in range(len(l)):\n        if i % 2 == 0:\n            even_indexed_values.append(l[i])\n    even_indexed_values.sort()\n    result_list = [None] * len(l)\n    even_sorted_ptr = 0\n    for i in range(len(l)):\n        if i % 2 == 0:\n            result_list[i] = even_indexed_values[even_sorted_ptr]\n            even_sorted_ptr += 1\n        else:\n            result_list[i] = l[i]\n    return result_list"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    Takes a string encoded with encode_cyclic and returns the decoded string.\n    Groups are shifted right one position if they have three characters.\n    \"\"\"\n    # Split string into groups of 3 characters. The last group may be shorter.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n\n    # Apply right cyclic shift to groups of 3; leave shorter groups unchanged.\n    decoded_groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n\n    return \"\".join(decoded_groups)"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str) -> str:\n    \"\"\"\n    Decodes a string that was encoded by cycling groups of three characters.\n    Reverses the cyclic shift for groups of three and leaves others unchanged.\n    \"\"\"\n    # Split the encoded string into groups of three characters.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n\n    decoded_groups = []\n    for group in groups:\n        if len(group) == 3:\n            # Reverse cyclic shift: move the last character to the beginning.\n            decoded_groups.append(group[-1] + group[:-1])\n        else:\n            # Groups with fewer than three characters remain unchanged.\n            decoded_groups.append(group)\n\n    # Join the processed groups back into a single string.\n    return \"\".join(decoded_groups)"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n\n    def is_prime(num: int) -> bool:\n        \"\"\"\n        Determines if a given integer is a prime number.\n        \"\"\"\n        if num <= 1:\n            return False\n        if num <= 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def generate_fibonacci_sequence():\n        \"\"\"\n        Generates an infinite sequence of Fibonacci numbers.\n        \"\"\"\n        a, b = 0, 1\n        while True:\n            yield a\n            a, b = b, a + b\n\n    count = 0\n    fib_gen = generate_fibonacci_sequence()\n    for fib_num in fib_gen:\n        if fib_num <= 1:\n            continue\n\n        if is_prime(fib_num):\n            count += 1\n            if count == n:\n                return fib_num"}
{"task_id": "HumanEval/39", "solution": "def is_prime(num: int) -> bool:\n    \"\"\"\n    Checks if a number is prime. It uses an optimized trial division method.\n    \"\"\"\n    if num <= 1:\n        return False\n    if num <= 3:\n        return True\n    if num % 2 == 0 or num % 3 == 0:\n        return False\n    i = 5\n    while i * i <= num:\n        if num % i == 0 or num % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    Assumes n is a positive integer.\n    \"\"\"\n    fib_generator = generate_fibonacci_sequence()\n    found_primes_count = 0\n    next(fib_generator) # Skip F(0) = 0\n    next(fib_generator) # Skip F(1) = 1\n\n    while True:\n        current_fib = next(fib_generator)\n        # Skip 0 and 1 as they are not prime by definition\n        if current_fib <= 1:\n            continue\n\n        if is_prime(current_fib):\n            found_primes_count += 1\n            if found_primes_count == n:\n                return current_fib"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list) -> bool:\n    \"\"\"\n    Determines if three distinct elements in the list sum to zero.\n    Returns True if such a triple exists, False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    for i in range(n - 2):\n        for j in range(i + 1, n - 1):\n            for k in range(j + 1, n):\n                if l[i] + l[j] + l[k] == 0:\n                    return True\n    return False"}
