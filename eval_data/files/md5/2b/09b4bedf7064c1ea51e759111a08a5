nt in first_k_elements:\n            if element.has_at_most_two_digits():\n                total_sum += element.value\n        return total_sum\ndef add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    validator = InputValidator()\n    # Validate array length and k value, adhering to design but not raising exceptions.\n    validator.validate_array_length(len(arr))\n    validator.validate_k_value(k, len(arr))\n\n    calculator = SumCalculator()\n    # Delegate to SumCalculator for the core logic.\n    return calculator.calculate_sum_of_two_digit_elements(arr, k)"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Calculates the sum of elements with at most two digits from the first k elements of arr.\n    It iterates through the specified initial elements and adds those meeting the absolute value criteria.\n    \"\"\"\n    total_sum = 0\n    for i in range(k):\n        element = arr[i]\n        if abs(element) < 100:\n            total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/124", "solution": "def _is_leap_year(year):\n    \"\"\"Determines if a given year is a leap year.\n    Applies Gregorian calendar rules.\"\"\"\n    return (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0)\ndef valid_date(date):\n    \"\"\"Validates a date string against \"mm-dd-yyyy\" format and calendar rules.\n    Returns True for valid dates, False otherwise.\"\"\"\n    # 1. Check non-empty string\n    if not date:\n        return False\n\n    # 2. Check \"mm-dd-yyyy\" format and parse components\n    if len(date) != 10 or date[2] != '-' or date[5] != '-':\n        return False\n\n    month_str = date[0:2]\n    day_str = date[3:5]\n    year_str = date[6:10]\n\n    if not (month_str.isdigit() and day_str.isdigit() and year_str.isdigit()):\n        return False\n\n    # Convert to integers; isdigit() checks ensure safe conversion.\n    month = int(month_str)\n    day = int(day_str)\n    year = int(year_str)\n\n    # 3. Validate month range (1-12)\n    if not (1 <= month <= 12):\n        return False\n\n    # 4. Validate day based on month and leap year\n    days_in_month = {\n        1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n        4: 30, 6: 30, 9: 30, 11: 30\n    }\n\n    if month == 2: # February\n        if _is_leap_year(year):\n            max_day = 29\n        else:\n            max_day = 28\n    else:\n        # Should not be None due to prior month range check\n        max_day = days_in_month.get(month)\n\n    if not (1 <= day <= max_day):\n        return False\n\n    return True"}
{"task_id": "HumanEval/123", "solution": "class Integer:\n    def __init__(self, value: int):\n        # Initializes with an integer value.\n        self._value = value\n\n    def is_odd(self) -> bool:\n        # Returns True if the encapsulated integer is odd.\n        return self._value % 2 != 0\n\n    def is_even(self) -> bool:\n        # Returns True if the encapsulated integer is even.\n        return self._value % 2 == 0\n\n    def halve(self) -> 'Integer':\n        # Returns a new Integer object representing half of the current value.\n        return Integer(self._value // 2)\n\n    def triple_plus_one(self) -> 'Integer':\n        # Returns a new Integer object representing (3 * current value + 1).\n        return Integer(3 * self._value + 1)\n\n    def get_value(self) -> int:\n        # Returns the raw integer value.\n        return self._value\nclass CollatzSequence:\n    def __init__(self):\n        # Initializes an empty sequence for Integer objects.\n        self._numbers: list[Integer] = []\n\n    def generate(self, start_n: Integer) -> None:\n        # Generates the Collatz sequence from start_n until 1, storing each step.\n        current_number = start_n\n        while current_number.get_value() != 1:\n            self._numbers.append(current_number)\n            if current_number.is_even():\n                current_number = current_number.halve()\n            else:\n                current_number = current_number.triple_plus_one()\n        self._numbers.append(Integer(1))\n\n    def get_numbers(self) -> list[Integer]:\n        # Returns the generated sequence as a list of Integer objects.\n        return list(self._numbers)\nclass OddNumberList:\n    def __init__(self):\n        # Initializes an empty list for raw integer values of odd numbers.\n        self._numbers: list[int] = []\n\n    def add(self, number: Integer) -> None:\n        # Adds the raw integer value of an Integer object to the collection.\n        self._numbers.append(number.get_value())\n\n    def sort(self) -> None:\n        # Sorts the collected odd numbers in increasing order in-place.\n        self._numbers.sort()\n\n    def get_numbers(self) -> list[int]:\n        # Returns the current list of collected odd numbers.\n        return list(self._numbers)\ndef get_odd_collatz(n: int) -> list[int]:\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n    initial_n = Integer(n)\n\n    if initial_n.get_value() == 1:\n        return [1]\n\n    collatz_seq_generator = CollatzSequence()\n    collatz_seq_generator.generate(initial_n)\n    full_sequence = collatz_seq_generator.get_numbers()\n\n    odd_collector = OddNumberList()\n    for num_obj in full_sequence:\n        if num_obj.is_odd():\n            odd_collector.add(num_obj)\n\n    odd_collector.sort()\n    return odd_collector.get_numbers()"}
{"task_id": "HumanEval/123", "solution": "class CollatzSequence:\n    \"\"\"Generates and stores the Collatz sequence for a given starting positive integer.\"\"\"\n\n    def __init__(self):\n        self._numbers: List[PositiveInteger] = []\n\n    def generate(self, start_n: PositiveInteger) -> None:\n        \"\"\"Generates the Collatz sequence starting from start_n and stores it internally.\"\"\"\n        self._numbers = []\n        current_term = start_n\n        self._numbers.append(current_term)\n\n        while current_term.get_value() != 1:\n            if current_term.is_even():\n                next_val = current_term.get_value() // 2\n            else:\n                next_val = (3 * current_term.get_value()) + 1\n            current_term = PositiveInteger(next_val)\n            self._numbers.append(current_term)\n\n    def get_numbers(self) -> List[PositiveInteger]:\n        \"\"\"Returns the generated Collatz sequence as a list of PositiveInteger objects.\"\"\"\n        return list(self._numbers)\nclass OddNumberList:\n    \"\"\"Collects PositiveInteger objects and provides functionality to sort them in increasing order.\"\"\"\n\n    def __init__(self):\n        self._numbers: List[PositiveInteger] = []\n\n    def add(self, number: PositiveInteger) -> None:\n        \"\"\"Adds a PositiveInteger to the collection.\"\"\"\n        self._numbers.append(number)\n\n    def sort(self) -> None:\n        \"\"\"Sorts the collected PositiveInteger objects in increasing order.\"\"\"\n        self._numbers.sort()\n\n    def to_int_list(self) -> List[int]:\n        \"\"\"Converts the list of PositiveInteger objects to a list of standard Python integers.\"\"\"\n        return [p_int.get_value() for p_int in self._numbers]\n\n    def __len__(self) -> int:\n        return len(self._numbers)\n\n    def __repr__(self) -> str:\n        return f\"OddNumberList({[p.get_value() for p in self._numbers]})\"\ndef get_odd_collatz(n: int) -> List[int]:\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    For example: get_odd_collatz(5) returns [1, 5]\n    \"\"\"\n    start_n_obj = PositiveInteger(n)\n\n    if start_n_obj.get_value() == 1:\n        return [1]\n\n    collatz_seq = CollatzSequence()\n    collatz_seq.generate(start_n_obj)\n    full_sequence = collatz_seq.get_numbers()\n\n    odd_numbers = OddNumberList()\n    for num_obj in full_sequence:\n        if num_obj.is_odd():\n            odd_numbers.add(num_obj)\n\n    odd_numbers.sort()\n    return odd_numbers.to_int_list()"}
{"task_id": "HumanEval/124", "solution": "def _parse_date_components(date_string: str) -> tuple[int, int, int] | None:\n    \"\"\"Parses a date string in 'mm-dd-yyyy' format into month, day, and year integers.\"\"\"\n    parts = date_string.split('-')\n    if len(parts) != 3:\n        return None\n    try:\n        month = int(parts[0])\n        day = int(parts[1])\n        year = int(parts[2])\n        return (month, day, year)\n    except ValueError:\n        return None\ndef _is_valid_month_range(month: int) -> bool:\n    \"\"\"Checks if a month integer is within the valid range [1, 12].\"\"\"\n    return 1 <= month <= 12\ndef _is_valid_day_range(day: int, month: int) -> bool:\n    \"\"\"Checks if a day integer is valid for a given month, considering month-specific day limits.\"\"\"\n    _31_day_months = {1, 3, 5, 7, 8, 10, 12}\n    _30_day_months = {4, 6, 9, 11}\n\n    if month in _31_day_months:\n        return 1 <= day <= 31\n    elif month in _30_day_months:\n        return 1 <= day <= 30\n    elif month == 2:\n        return 1 <= day <= 29\n    return False\ndef valid_date(date: str) -> bool:\n    \"\"\"Validates a given date string against predefined rules, returning True if valid.\"\"\"\n    if not date:\n        return False\n\n    parsed_components = _parse_date_components(date)\n    if parsed_components is None:\n        return False\n\n    month, day, year = parsed_components\n\n    if not _is_valid_month_range(month):\n        return False\n\n    if not _is_valid_day_range(day, month):\n        return False\n\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Splits a string by whitespace, then by commas, or counts odd-ordered lowercase letters.\n    Returns a list of words or an integer count based on the content of txt.\n    \"\"\"\n\n    def _contains_whitespace(text):\n        \"\"\"Checks if the text contains any whitespace characters.\"\"\"\n        return any(c.isspace() for c in text)\n\n    def _contains_comma(text):\n        \"\"\"Checks if the text contains any comma characters.\"\"\"\n        return ',' in text\n\n    def _split_by_whitespace(text):\n        \"\"\"Splits the text by whitespace characters.\"\"\"\n        return text.split()\n\n    def _split_by_comma(text):\n        \"\"\"Splits the text by comma characters.\"\"\"\n        return text.split(',')\n\n    def _get_alphabetical_order(char):\n        \"\"\"Returns the 0-based alphabetical order of a lowercase character.\"\"\"\n        return ord(char) - ord('a')\n\n    def _count_odd_ordered_lowercase_letters(text):\n        \"\"\"Counts lowercase letters with an odd alphabetical order in the text.\"\"\"\n        count = 0\n        for char in text:\n            if char.islower():\n                order = _get_alphabetical_order(char)\n                if order % 2 != 0:\n                    count += 1\n        return count\n\n    if _contains_whitespace(txt):\n        return _split_by_whitespace(txt)\n    elif _contains_comma(txt):\n        return _split_by_comma(txt)\n    else:\n        return _count_odd_ordered_lowercase_letters(txt)"}
{"task_id": "HumanEval/126", "solution": "from collections import Counter\ndef is_sorted(lst):\n    \"\"\"\n    Checks if a list of non-negative integers is sorted in ascending order\n    with specific duplicate rules. Returns True if empty or single-element,\n    False if any number appears three or more times, or if not sorted.\n    \"\"\"\n    # Step 1: Handle empty or single-element lists\n    if len(lst) <= 1:\n        return True\n\n    # Step 2: Check for duplicates\n    counts = Counter(lst)\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    # Step 3: Check for ascending order\n    for i in range(1, len(lst)):\n        if lst[i] < lst[i-1]:\n            return False\n\n    # Step 4: If all checks pass\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Processes a string by splitting on whitespace, then commas, or counting odd-ordered lowercase letters.\n    The alphabetical order of 'a' is 0, 'b' is 1, up to 'z' as 25.\n    \"\"\"\n    has_whitespace = False\n    for char in txt:\n        if char.isspace():\n            has_whitespace = True\n            break\n\n    if has_whitespace:\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        odd_order_count = 0\n        for char in txt:\n            if char.islower():\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    odd_order_count += 1\n        return odd_order_count"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n\n    Examples\n    is_sorted([5]) \u279e True\n    is_sorted([1, 2, 3, 4, 5]) \u279e True\n    is_sorted([1, 3, 2, 4, 5]) \u279e False\n    is_sorted([1, 2, 3, 4, 5, 6]) \u279e True\n    is_sorted([1, 2, 3, 4, 5, 6, 7]) \u279e True\n    is_sorted([1, 3, 2, 4, 5, 6, 7]) \u279e False\n    is_sorted([1, 2, 2, 3, 3, 4]) \u279e True\n    is_sorted([1, 2, 2, 2, 3, 4]) \u279e False\n    '''\n    # Check for ascending order\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i + 1]:\n            return False\n\n    # Check for duplicates (no more than 1 duplicate, i.e., count <= 2)\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] > 2:\n            return False\n\n    return True"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates sum of magnitudes of integers multiplied by product of all signs.\n    Returns None for an empty array.\n    \"\"\"\n    def _get_sign(number: int) -> int:\n        \"\"\"Determines the sign of a single integer (1, -1, or 0).\"\"\"\n        if number > 0:\n            return 1\n        elif number < 0:\n            return -1\n        else:\n            return 0\n\n    def _calculate_product_of_signs(arr: list[int]) -> int:\n        \"\"\"Calculates the product of signs for all numbers in the array.\"\"\"\n        product = 1\n        for number in arr:\n            product *= _get_sign(number)\n        return product\n\n    def _calculate_sum_of_magnitudes(arr: list[int]) -> int:\n        \"\"\"Calculates the sum of magnitudes (absolute values) for all numbers.\"\"\"\n        total_magnitude = 0\n        for number in arr:\n            total_magnitude += abs(number)\n        return total_magnitude\n\n    if not arr:\n        return None\n\n    product_of_signs = _calculate_product_of_signs(arr)\n    sum_of_magnitudes = _calculate_sum_of_magnitudes(arr)\n\n    return sum_of_magnitudes * product_of_signs"}
{"task_id": "HumanEval/127", "solution": "import math\nfrom typing import List, Optional, Tuple\nclass _Interval:\n    \"\"\"\n    Represents a numerical interval [start, end].\n    This class handles interval operations like intersection and length calculation.\n    \"\"\"\n    def __init__(self, start: float, end: float):\n        \"\"\"\n        Initializes an interval with a start and an end point.\n        Ensures start and end are stored for later operations.\n        \"\"\"\n        self._start = start\n        self._end = end\n\n    def get_start(self) -> float:\n        \"\"\"Returns the start point of the interval.\"\"\"\n        return self._start\n\n    def get_end(self) -> float:\n        \"\"\"Returns the end point of the interval.\"\"\"\n        return self._end\n\n    def calculate_intersection(self, other: '_Interval') -> Optional['_Interval']:\n        \"\"\"\n        Determines the intersection with another interval.\n        Returns a new _Interval object if it exists, otherwise None.\n        \"\"\"\n        intersect_start = max(self._start, other.get_start())\n        intersect_end = min(self._end, other.get_end())\n\n        if intersect_start > intersect_end:\n            return None  # No intersection\n        else:\n            return _Interval(intersect_start, intersect_end)\n\n    def get_length(self) -> int:\n        \"\"\"\n        Calculates the non-negative integer length of the interval.\n        Returns 0 if the interval is empty or invalid.\n        \"\"\"\n        length = self._end - self._start\n        return int(max(0, length)) # Ensure non-negative and integer for primality check\nclass _PrimeNumberChecker:\n    \"\"\"\n    Utility class to check if a number is prime.\n    It provides a static method for primality testing.\n    \"\"\"\n    @staticmethod\n    def is_prime(number: int) -> bool:\n        \"\"\"\n        Determines if a given integer is a prime number.\n        Returns True if the number is prime, False otherwise.\n        \"\"\"\n        if number <= 1:\n            return False  # Not prime by definition (covers length 0 and 1).\n        if number == 2:\n            return True   # 2 is the only even prime number.\n        if number % 2 == 0:\n            return False  # Other even numbers are not prime.\n\n        # Check for odd divisors from 3 up to the square root of the number.\n        for i in range(3, int(math.sqrt(number)) + 1, 2):\n            if number % i == 0:\n                return False\n        return True\ndef intersection(interval1: Tuple[float, float], interval2: Tuple[float, float]) -> str:\n    \"\"\"\n    Checks if the length of the intersection of two intervals is a prime number.\n    Returns 'YES' if prime, 'NO' otherwise.\n    \"\"\"\n    # Convert input tuples to internal _Interval objects.\n    interval_obj1 = _Interval(float(interval1[0]), float(interval1[1]))\n    interval_obj2 = _Interval(float(interval2[0]), float(interval2[1]))\n\n    # Determine interval intersection.\n    intersection_result = interval_obj1.calculate_intersection(interval_obj2)\n\n    # Return 'NO' if no intersection.\n    if intersection_result is None:\n        return 'NO'\n\n    # Calculate intersection length.\n    length = intersection_result.get_length()\n\n    # Determine primality of intersection length.\n    is_length_prime = _PrimeNumberChecker.is_prime(length)\n\n    # Return 'YES' for prime length, 'NO' for non-prime length.\n    if is_length_prime:\n        return 'YES'\n    else:\n        return 'NO'"}
{"task_id": "HumanEval/127", "solution": "from typing import Tuple, Optional\nclass Interval:\n    \"\"\"Represents a closed integer interval with a start and an end.\"\"\"\n    def __init__(self, start: int, end: int):\n        self.start = start\n        self.end = end\ndef calculate_length(interval: Interval) -> int:\n    \"\"\"Calculates the length of a given closed interval (end - start + 1).\"\"\"\n    return interval.end - interval.start + 1\ndef find_intersection(interval1: Interval, interval2: Interval) -> Optional[Interval]:\n    \"\"\"Determines the intersection of two intervals. Returns an Interval object or None.\"\"\"\n    max_start = max(interval1.start, interval2.start)\n    min_end = min(interval1.end, interval2.end)\n\n    if max_start <= min_end:\n        return Interval(max_start, min_end)\n    return None\ndef is_prime_length(number: int) -> bool:\n    \"\"\"Checks if a number is prime based on specific system rules, excluding 2.\"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return False  # Per system rules, 2 is explicitly not considered prime.\n    if number % 2 == 0:\n        return False  # Even numbers greater than 2 are not prime.\n\n    i = 3\n    # Check for odd divisors up to the square root of the number.\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True\ndef intersection(interval1: Tuple[int, int], interval2: Tuple[int, int]) -> str:\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two\n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n\n\n    [input/output] samples:\n    intersection((1, 2), (2, 3)) ==> \"NO\"\n    intersection((-1, 1), (0, 4)) ==> \"NO\"\n    intersection((-3, -1), (-5, 5)) ==> \"YES\"\n    \"\"\"\n    int1_obj = Interval(interval1[0], interval1[1])\n    int2_obj = Interval(interval2[0], interval2[1])\n\n    intersection_obj = find_intersection(int1_obj, int2_obj)\n\n    if intersection_obj is None:\n        return \"NO\"  # FR5: Return \"NO\" for an empty intersection.\n\n    length = calculate_length(intersection_obj)\n\n    if length <= 1:\n        return \"NO\"  # FR6: Return \"NO\" if length is less than or equal to 1.\n    if length == 2:\n        return \"NO\"  # FR7: Return \"NO\" if length is 2 (specific system rule).\n\n    if is_prime_length(length):\n        return \"YES\"  # FR9: Return \"YES\" for a prime length.\n    else:\n        return \"NO\"  # FR10: Return \"NO\" for a non-prime length."}
{"task_id": "HumanEval/128", "solution": "def _calculate_magnitude(number: int) -> int:\n    \"\"\"Calculates the magnitude (absolute value) of an integer.\"\"\"\n    return abs(number)\ndef _determine_sign(number: int) -> int:\n    \"\"\"Determines the sign of an integer (1 for positive, -1 for negative, 0 for zero).\"\"\"\n    if number > 0:\n        return 1\n    elif number < 0:\n        return -1\n    else:\n        return 0\ndef prod_signs(arr: list[int]) -> int | None:\n    \"\"\"\n    Calculates the sum of magnitudes of integers multiplied by the product of all signs.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_of_magnitudes = 0\n    product_of_signs = 1\n\n    for number in arr:\n        sum_of_magnitudes += _calculate_magnitude(number)\n        product_of_signs *= _determine_sign(number)\n\n    return sum_of_magnitudes * product_of_signs"}
{"task_id": "HumanEval/129", "solution": "from typing import List, Optional\nclass Cell:\n    \"\"\"Represents a single cell within the grid, holding its value and coordinates.\"\"\"\n    def __init__(self, value: int, row: int, col: int) -> None:\n        self.value = value\n        self.row = row\n        self.col = col\n\n    def get_neighbors(self, grid: 'Grid') -> List['Cell']:\n        \"\"\"Returns a list of valid adjacent cells from the given grid.\"\"\"\n        neighbors: List[Cell] = []\n        deltas = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # Up, Down, Left, Right\n        for dr, dc in deltas:\n            new_row, new_col = self.row + dr, self.col + dc\n            if grid.is_valid_coord(new_row, new_col):\n                neighbors.append(grid.get_cell(new_row, new_col))\n        return neighbors\nclass Grid:\n    \"\"\"Manages the 2D grid structure, provides access to cells, and performs boundary checks.\"\"\"\n    def __init__(self, grid_data: List[List[int]]) -> None:\n        self.N = len(grid_data)\n        self._cells: List[List[Cell]] = []\n        for r in range(self.N):\n            row_cells: List[Cell] = []\n            for c in range(self.N):\n                row_cells.append(Cell(grid_data[r][c], r, c))\n            self._cells.append(row_cells)\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        \"\"\"Returns the Cell object at the specified coordinates.\"\"\"\n        return self._cells[row][col]\n\n    def is_valid_coord(self, row: int, col: int) -> bool:\n        \"\"\"Checks if the given coordinates are within grid boundaries.\"\"\"\n        return 0 <= row < self.N and 0 <= col < self.N\nclass Path:\n    \"\"\"Represents an ordered sequence of cell values, supporting lexicographical comparison.\"\"\"\n    def __init__(self, initial_values: Optional[List[int]] = None) -> None:\n        self.values: List[int] = list(initial_values) if initial_values is not None else []\n\n    def add_cell_value(self, value: int) -> None:\n        \"\"\"Appends a cell value to the path.\"\"\"\n        self.values.append(value)\n\n    def get_length(self) -> int:\n        \"\"\"Returns the current length of the path.\"\"\"\n        return len(self.values)\n\n    def __lt__(self, other: 'Path') -> bool:\n        \"\"\"Implements lexicographical comparison for paths.\"\"\"\n        return self.values < other.values\ndef validate_grid(grid_data: List[List[int]]) -> 'Grid':\n    \"\"\"Validates grid_data and returns a Grid object. (No actual validation/exceptions due to critical requirements)\"\"\"\n    # As per CRITICAL REQUIREMENTS: \"Do NOT add isinstance() checks, type guards, or raise exceptions for edge cases. Trust the caller's inputs.\"\n    # This function will simply construct the Grid object assuming valid input format.\n    return Grid(grid_data)\nclass PathfindingService:\n    \"\"\"Orchestrates the depth-first search to find all paths of length k and identifies the lexicographically smallest one.\"\"\"\n    def __init__(self, grid: 'Grid', k: int) -> None:\n        self._grid = grid\n        self._k = k\n        # Initialize with a path that's guaranteed to be lexicographically larger than any valid path.\n        self._min_path_values: List[int] = [(self._grid.N * self._grid.N + 1)] * self._k\n\n    def find_minimum_path(self) -> List[int]:\n        \"\"\"Initiates the pathfinding process and returns the minimum path values.\"\"\"\n        for r in range(self._grid.N):\n            for c in range(self._grid.N):\n                start_cell = self._grid.get_cell(r, c)\n                self._dfs(start_cell, [start_cell.value])\n        return self._min_path_values\n\n    def _dfs(self, current_cell: Cell, current_path_values: List[int]) -> None:\n        \"\"\"Recursive Depth-First Search to explore paths.\"\"\"\n        # Base case: if path length equals k\n        if len(current_path_values) == self._k:\n            if Path(current_path_values) < Path(self._min_path_values):\n                self._min_path_values = list(current_path_values)\n            return\n\n        # Pruning optimization: if current_path_values is already longer than k, stop exploring.\n        # This is implicitly handled by the return statement above.\n\n        # Recursive step: explore neighbors\n        for neighbor in current_cell.get_neighbors(self._grid):\n            self._dfs(neighbor, current_path_values + [neighbor.value])\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Finds the lexicographically smallest path of length k within a square grid of unique integer values.\n    It returns an ordered list of integers representing the values of the cells in the minimum path.\n    \"\"\"\n    # As per CRITICAL REQUIREMENTS: \"Do NOT add isinstance() checks, type guards, or raise exceptions for edge cases. Trust the caller's inputs.\"\n    # The validation functions are called, but they perform no actual validation or raise errors.\n    grid_obj = validate_grid(grid)\n    validate_k(k, grid_obj.N)\n\n    pathfinding_service = PathfindingService(grid_obj, k)\n    min_path_result = pathfinding_service.find_minimum_path()\n\n    return min_path_result"}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    class Cell:\n        def __init__(self, row, col, value):\n            self._row = row\n            self._col = col\n            self._value = value\n\n        def get_row(self):\n            return self._row\n\n        def get_col(self):\n            return self._col\n\n        def get_value(self):\n            return self._value\n\n        def get_neighbors(self, grid_N):\n            neighbors = []\n            # Define possible movements: (dr, dc) for Up, Down, Left, Right.\n            movements = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n            for dr, dc in movements:\n                new_row, new_col = self._row + dr, self._col + dc\n                if 0 <= new_row < grid_N and 0 <= new_col < grid_N:\n                    neighbors.append((new_row, new_col))\n            return neighbors\n\n        def __eq__(self, other):\n            return self._row == other._row and self._col == other._col\n\n        def __hash__(self):\n            return hash((self._row, self._col))\n\n    class Grid:\n        def __init__(self, grid_values):\n            self._N = len(grid_values)\n            self._cells = []\n            for r in range(self._N):\n                row_cells = []\n                for c in range(self._N):\n                    row_cells.append(Cell(r, c, grid_values[r][c]))\n                self._cells.append(row_cells)\n\n        def get_cell(self, row, col):\n            return self._cells[row][col]\n\n        def get_N(self):\n            return self._N\n\n        def get_all_cells(self):\n            all_cells = []\n            for r in range(self._N):\n                for c in range(self._N):\n                    all_cells.append(self._cells[r][c])\n            return all_cells\n\n    class PathComparator:\n        @staticmethod\n        def is_lexicographically_less_than(path_a, path_b):\n            # Compares two paths lexicographically based on their cell values.\n            return path_a.get_values() < path_b.get_values()\n\n    class Path:\n        def __init__(self, initial_cells=None):\n            self._cells = list(initial_cells) if initial_cells else []\n            self._values = None # Cache for values.\n\n        def add_cell(self, cell):\n            self._cells.append(cell)\n            self._values = None # Invalidate cache on modification.\n\n        def get_values(self):\n            if self._values is None:\n                self._values = [cell.get_value() for cell in self._cells]\n            return self._values\n\n        def get_length(self):\n            return len(self._cells)\n\n        def get_last_cell(self):\n            return self._cells[-1]\n\n        def __lt__(self, other):\n            return PathComparator.is_lexicographically_less_than(self, other)\n\n        def copy(self):\n            new_path = Path(list(self._cells)) # Create a new path with a copy of the cell list.\n            if self._values is not None:\n                new_path._values = list(self._values) # Copy cached values if present.\n            return new_path\n\n    class PathFinderService:\n        def __init__(self, grid, k):\n            self._grid = grid\n            self._k = k\n            self._min_path = None\n\n        def find_minimum_path(self):\n            all_start_cells = self._grid.get_all_cells()\n\n            for start_cell in all_start_cells:\n                initial_path = Path([start_cell])\n                self._dfs(initial_path)\n\n            return self._min_path.get_values()\n\n        def _dfs(self, current_path):\n            if current_path.get_length() == self._k:\n                # Path of desired length found, compare and update _min_path.\n                if self._min_path is None or current_path < self._min_path:\n                    self._min_path = current_path.copy() # Store a copy to prevent modification.\n                return\n\n            if current_path.get_length() > self._k:\n                # Path is too long, prune this branch.\n                return\n\n            last_cell = current_path.get_last_cell()\n            grid_N = self._grid.get_N()\n\n            for neighbor_row, neighbor_col in last_cell.get_neighbors(grid_N):\n                neighbor_cell = self._grid.get_cell(neighbor_row, neighbor_col)\n                next_path = current_path.copy()\n                next_path.add_cell(neighbor_cell)\n                self._dfs(next_path)\n\n    grid_obj = Grid(grid)\n    service = PathFinderService(grid_obj, k)\n    return service.find_minimum_path()"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in\n    the last couple centuries. However, what people don't know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8\n    You are given a non-negative integer number n, you have to a return a list of the\n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input n must be a non-negative integer.\")\n\n    # 1. Determine the maximum index `max_k` needed for calculations:\n    #    - If `n` is even, `max_k = n`.\n    #    - If `n` is odd, `max_k = n + 1`.\n    max_k = n if n % 2 == 0 else n + 1\n\n    # 2. Initialize a list `trib_sequence` of size `max_k + 1` with default values (e.g., zeros).\n    trib_sequence = [0] * (max_k + 1)\n\n    # 3. Handle the initial values:\n    #    - Set `trib_sequence[0] = 1` (inferred from examples).\n    #    - If `max_k >= 1`, set `trib_sequence[1] = 3` (given).\n    if max_k >= 0:\n        trib_sequence[0] = 1\n    if max_k >= 1:\n        trib_sequence[1] = 3\n\n    # 4. First pass (calculate terms with even indices):\n    #    - Iterate `k` from `2` to `max_k` (inclusive).\n    #    - If `k` is an even number, calculate `trib_sequence[k] = 1 + k // 2`.\n    for k in range(2, max_k + 1):\n        if k % 2 == 0:\n            trib_sequence[k] = 1 + k // 2\n\n    # 5. Second pass (calculate terms with odd indices that depend on `k+1`):\n    #    - Iterate `k` from `3` to `n` (inclusive).\n    #    - If `k` is an odd number, calculate `trib_sequence[k] = trib_sequence[k-1] + trib_sequence[k-2] + trib_sequence[k+1]`.\n    for k in range(3, n + 1):\n        if k % 2 != 0:\n            # Note: trib_sequence[k+1] is guaranteed to be calculated if k is odd and k <= n.\n            # If k is odd, k+1 is even, and thus trib_sequence[k+1] would have been set in the first pass\n            # because k+1 <= max_k.\n            trib_sequence[k] = trib_sequence[k - 1] + trib_sequence[k - 2] + trib_sequence[k + 1]\n\n    # 6. Return the sublist `trib_sequence[0 : n + 1]`.\n    return trib_sequence[0 : n + 1]"}
{"task_id": "HumanEval/130", "solution": "def tri(n: int) -> list[int]:\n    \"\"\"Calculates the first n + 1 numbers of a specific Tribonacci sequence.\n    The sequence values are stored and computed using dynamic programming.\n    \"\"\"\n    result = [0] * (n + 1)\n\n    if n >= 0:\n        result[0] = 1\n    if n >= 1:\n        result[1] = 3\n\n    for i in range(2, n + 1):\n        if i % 2 == 0:  # i is even\n            result[i] = 1 + i // 2\n        else:  # i is odd\n            result[i] = 2 + i + result[i - 2]\n\n    return result"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Determines if a string containing only square brackets has a valid subsequence\n    with at least one nested bracket. Returns True if such a subsequence is found, False otherwise.\n    \"\"\"\n    open_brackets = 0\n    for char in string:\n        if char == '[':\n            open_brackets += 1\n        elif char == ']':\n            if open_brackets > 0:\n                open_brackets -= 1\n\n        if open_brackets >= 2:\n            return True\n\n    return False"}
{"task_id": "HumanEval/131", "solution": "def _is_odd(digit: int) -> bool:\n    \"\"\"Checks if a single digit is odd.\"\"\"\n    return digit in {1, 3, 5, 7, 9}\ndef _extract_digits(n: int) -> list[int]:\n    \"\"\"Extracts individual digits from a positive integer n.\"\"\"\n    digits_list = []\n    temp_n = n\n    while temp_n > 0:\n        digits_list.append(temp_n % 10)\n        temp_n //= 10\n    return digits_list[::-1]\ndef digits(n: int) -> int:\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    extracted_digits = _extract_digits(n)\n\n    odd_digits = []\n    for digit in extracted_digits:\n        if _is_odd(digit):\n            odd_digits.append(digit)\n\n    if not odd_digits:\n        return 0\n\n    product = 1\n    for odd_digit in odd_digits:\n        product *= odd_digit\n\n    return product"}
{"task_id": "HumanEval/131", "solution": "def _extract_digits(number: int) -> list[int]:\n    \"\"\"Extracts individual digits from a positive integer.\"\"\"\n    if number == 0:\n        return [0]\n    digits_list = []\n    temp_num = number\n    while temp_num > 0:\n        digits_list.append(temp_num % 10)\n        temp_num //= 10\n    return digits_list[::-1] # Reverse to get digits in order\ndef _is_odd(digit: int) -> bool:\n    \"\"\"Checks if a given digit is odd.\"\"\"\n    return digit % 2 != 0\ndef _calculate_product(digits_list: list[int]) -> int:\n    \"\"\"Computes the product of a list of integers.\"\"\"\n    product = 1\n    for d in digits_list:\n        product *= d\n    return product\ndef digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    all_digits = _extract_digits(n)\n    odd_digits = [d for d in all_digits if _is_odd(d)]\n\n    if not odd_digits:\n        return 0\n\n    product = _calculate_product(odd_digits)\n    return product"}
{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"Calculates the sum of squared numbers from the input list.\n    Each number is first rounded up to the nearest integer (ceiling).\"\"\"\n    total_sum = 0\n    for number in lst:\n        rounded_number = math.ceil(number)\n        squared_number = rounded_number ** 2\n        total_sum += squared_number\n    return total_sum"}
{"task_id": "HumanEval/133", "solution": "import math\nfrom typing import List\nclass Number:\n    \"\"\"Represents a single numerical value with methods for ceiling and squaring.\"\"\"\n    def __init__(self, value: float):\n        self._value = value\n\n    def get_ceiling(self) -> int:\n        \"\"\"Returns the ceiling of the value as an integer.\"\"\"\n        return int(math.ceil(self._value))\n\n    def get_squared_ceiling(self) -> int:\n        \"\"\"Returns the square of the ceiling of the value as an integer.\"\"\"\n        ceiling_val = self.get_ceiling()\n        return ceiling_val * ceiling_val\nclass NumberList:\n    \"\"\"A container class for a list of Number objects.\"\"\"\n    def __init__(self, input_list: List[float]):\n        self._elements: List[Number] = [Number(num) for num in input_list]\n\n    def get_elements(self) -> List[Number]:\n        \"\"\"Returns the list of Number objects.\"\"\"\n        return self._elements\ndef sum_squares(lst: List[float]) -> int:\n    \"\"\"Calculates the sum of squared ceiling-rounded numbers from a list.\n    It orchestrates domain objects to process the input list.\n    \"\"\"\n    number_list_obj = NumberList(lst)\n    total_sum = 0\n    numbers = number_list_obj.get_elements()\n\n    for number_obj in numbers:\n        squared_value = number_obj.get_squared_ceiling()\n        total_sum += squared_value\n    return total_sum"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an isolated alphabetical letter.\n    An isolated letter is one not preceded by another non-space character.\n    \"\"\"\n    if len(txt) == 0:\n        return False\n\n    last_char = txt[-1]\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n\n    # For strings longer than one character, check the character before the last\n    char_before_last = txt[-2]\n    if char_before_last.isspace():\n        return True\n    else:\n        return False"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an alphabetical character and not part of a word.\n    A character is considered \"not part of a word\" if it's the only character or preceded by a space.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n\n    # Check the character immediately preceding the last one\n    char_preceding_last = txt[-2]\n    if char_preceding_last == ' ':\n        return True\n\n    return False"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr: list[int]) -> int:\n    \"\"\"Finds the largest index where an element is less than its predecessor.\n    Returns -1 if no such element exists.\"\"\"\n    max_index = -1\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            max_index = i\n    return max_index"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr: list[int]) -> int:\n    \"\"\"\n    Finds the largest index i in the input list arr such that arr[i] < arr[i-1].\n    Returns the largest such index i, or -1 if no such element exists or\n    the input list has fewer than two elements.\n    \"\"\"\n    if len(arr) < 2:\n        return -1\n\n    for i in range(len(arr) - 1, 0, -1):\n        if arr[i] < arr[i-1]:\n            return i\n\n    return -1"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n    '''\n    largest_negative = None\n    smallest_positive = None\n\n    for number in lst:\n        if number < 0:\n            if largest_negative is None or number > largest_negative:\n                largest_negative = number\n        elif number > 0:\n            if smallest_positive is None or number < smallest_positive:\n                smallest_positive = number\n\n    return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    \"\"\"\n    Finds the largest negative and smallest positive integers in a list.\n    Returns (largest_negative, smallest_positive), or None for missing types.\n    \"\"\"\n    largest_neg = None\n    smallest_pos = None\n\n    for num in lst:\n        if num < 0:\n            if largest_neg is None or num > largest_neg:\n                largest_neg = num\n        elif num > 0:\n            if smallest_pos is None or num < smallest_pos:\n                smallest_pos = num\n\n    return (largest_neg, smallest_pos)"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Create a function that takes a string as input which contains only square brackets.\n    The function should return True if and only if there is a valid subsequence of brackets\n    where at least one bracket in the subsequence is nested.\n\n    is_nested('[[]]') \u279e True\n    is_nested('[]]]]]]][[[[[]') \u279e False\n    is_nested('[][]') \u279e False\n    is_nested('[]') \u279e False\n    is_nested('[[][]]') \u279e True\n    is_nested('[[]][[') \u279e True\n    '''\n    if not isinstance(string, str):\n        return False\n\n    if not all(char in ('[', ']') for char in string):\n        return False\n\n    return '[[]]' in string"}
{"task_id": "HumanEval/137", "solution": "class _ComparableValue:\n    \"\"\"\n    Encapsulates an input value, its original type, and its numeric representation.\n    It handles string parsing for real numbers with different decimal separators.\n    \"\"\"\n    def __init__(self, value):\n        self._original_input = value\n        self._numeric_representation = self._parse_value(value)\n\n    def _parse_value(self, value):\n        \"\"\"\n        Parses the input value into a float, converting strings with ',' to '.' first.\n        It assumes valid numeric inputs for conversion.\n        \"\"\"\n        processed_value_str = str(value)\n        if ',' in processed_value_str and '.' not in processed_value_str:\n            processed_value_str = processed_value_str.replace(',', '.')\n        return float(processed_value_str)\n\n    def get_original_input(self):\n        \"\"\"Returns the original input value.\"\"\"\n        return self._original_input\n\n    def get_numeric_representation(self):\n        \"\"\"Returns the standardized float representation of the value.\"\"\"\n        return self._numeric_representation\ndef compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n\n    compare_one(1, 2.5) \u279e 2.5\n    compare_one(1, \"2,3\") \u279e \"2,3\"\n    compare_one(\"5,1\", \"6\") \u279e \"6\"\n    compare_one(\"1\", 1) \u279e None\n    \"\"\"\n    comparable_a = _ComparableValue(a)\n    comparable_b = _ComparableValue(b)\n\n    numeric_a = comparable_a.get_numeric_representation()\n    numeric_b = comparable_b.get_numeric_representation()\n\n    if numeric_a > numeric_b:\n        return comparable_a.get_original_input()\n    elif numeric_b > numeric_a:\n        return comparable_b.get_original_input()\n    else:\n        return None"}
{"task_id": "HumanEval/137", "solution": "from typing import Union, Type\nclass StringParser:\n    \"\"\"Utility to parse string representations of real numbers.\"\"\"\n    @staticmethod\n    def parse(input_string: str) -> float:\n        \"\"\"Converts a string to a float, handling ',' as a decimal separator.\"\"\"\n        return float(input_string.replace(',', '.'))\nclass ComparableValue:\n    \"\"\"Encapsulates a value, storing its original form and a standardized numeric float representation.\"\"\"\n    def __init__(self, value: Union[int, float, str]):\n        self.original_value = value\n        self.original_type = type(value)\n        if isinstance(value, str):\n            self.numeric_value = StringParser.parse(value)\n        else:\n            self.numeric_value = float(value)\n\n    def get_numeric_value(self) -> float:\n        \"\"\"Returns the standardized float representation of the value.\"\"\"\n        return self.numeric_value\n\n    def get_original_value(self) -> Union[int, float, str]:\n        \"\"\"Returns the value in its original input type.\"\"\"\n        return self.original_value\n\n    def get_original_type(self) -> Type:\n        \"\"\"Returns the Python type of the original input value.\"\"\"\n        return self.original_type\ndef compare_one(a: Union[int, float, str], b: Union[int, float, str]) -> Union[int, float, str, None]:\n    \"\"\"\n    Compares two inputs (int, float, or string real numbers).\n    Returns the numerically larger value in its original type, or None if equal.\n    \"\"\"\n    comparable_a = ComparableValue(a)\n    comparable_b = ComparableValue(b)\n\n    numeric_a = comparable_a.get_numeric_value()\n    numeric_b = comparable_b.get_numeric_value()\n\n    if numeric_a > numeric_b:\n        return comparable_a.get_original_value()\n    elif numeric_b > numeric_a:\n        return comparable_b.get_original_value()\n    else:\n        return None"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers\n    Example\n    is_equal_to_sum_even(4) == False\n    is_equal_to_sum_even(6) == False\n    is_equal_to_sum_even(8) == True\n    \"\"\"\n    if n < 8:\n        return False\n    if n % 2 != 0:\n        return False\n    return True"}
