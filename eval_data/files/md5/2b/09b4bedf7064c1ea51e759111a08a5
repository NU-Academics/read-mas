{"task_id": "HumanEval/57", "solution": "def monotonic(l: list) -> bool:\n    \"\"\"\n    Checks if the given list is monotonically increasing or decreasing.\n    Empty lists and single-element lists are considered monotonic.\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(1, len(l)):\n        if l[i] < l[i-1]:\n            is_increasing = False\n        if l[i] > l[i-1]:\n            is_decreasing = False\n\n        # If it's neither increasing nor decreasing, we can stop early.\n        if not is_increasing and not is_decreasing:\n            return False\n\n    return is_increasing or is_decreasing"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list) -> bool:\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    An empty list or a single-element list is considered monotonic.\n    \"\"\"\n    if len(l) < 2:\n        return True\n\n    is_non_decreasing = True\n    for i in range(1, len(l)):\n        if l[i] < l[i-1]:\n            is_non_decreasing = False\n            break\n\n    if is_non_decreasing:\n        return True\n\n    # If not non-decreasing, check if it is non-increasing\n    is_non_increasing = True\n    for i in range(1, len(l)):\n        if l[i] > l[i-1]:\n            is_non_increasing = False\n            break\n\n    return is_non_increasing"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list) -> list:\n    \"\"\"Return sorted unique common elements for two lists.\n    This function identifies unique common elements and returns them in ascending order.\n    \"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n    common_elements_set = set1.intersection(set2)\n    result_list = list(common_elements_set)\n    result_list.sort()\n    return result_list"}
