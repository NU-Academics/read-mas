{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    for i in range(n - 1, 0, -1):\n        if n % i == 0:\n            return i\n    return 1"}
{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\"Finds the largest integer that divides n evenly and is smaller than n. Returns 0 for n <= 1 or negative n, as per design.\"\"\"\n    if n <= 1:\n        return 0\n\n    for d in range(n - 1, 0, -1):\n        if n % d == 0:\n            return d\n    return 0"}
{"task_id": "HumanEval/25", "solution": "from typing import List\ndef factorize(n: int) -> List[int]:\n    \"\"\"Return a list of prime factors for a given integer, ordered smallest to largest.\n    Each factor is included according to its multiplicity, such that their product equals n.\n    \"\"\"\n    factors = []\n\n    if n <= 1:\n        return factors\n\n    # Factor out 2s\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    # Factor out odd numbers\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            factors.append(i)\n            n //= i\n        i += 2\n\n    # If n is still greater than 1, it's the remaining prime factor\n    if n > 1:\n        factors.append(n)\n\n    return factors"}
{"task_id": "HumanEval/25", "solution": "from typing import List\ndef factorize(n: int) -> List[int]:\n    \"\"\"Returns a list of prime factors for integer `n`, ordered smallest to largest.\n    Each factor is listed according to its multiplicity, and their product equals `n`.\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    factors: List[int] = []\n\n    # Handle factor 2.\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    # Check odd divisors up to sqrt(n) for factors.\n    d = 3\n    while d * d <= n:\n        while n % d == 0:\n            factors.append(d)\n            n //= d\n        d += 2  # Increment by 2.\n\n    # If n remains, it's the last prime factor.\n    if n > 1:\n        factors.append(n)\n\n    return factors"}
{"task_id": "HumanEval/26", "solution": "from typing import List\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\"Removes elements that occur more than once from numbers, preserving the relative order of unique elements.\n    It counts element occurrences and filters for those appearing exactly once.\n    \"\"\"\n    counts = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    unique_ordered_list = []\n    for num in numbers:\n        if counts[num] == 1:\n            unique_ordered_list.append(num)\n\n    return unique_ordered_list"}
{"task_id": "HumanEval/26", "solution": "from typing import List, Dict\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    # Count occurrences of each number\n    counts: Dict[int, int] = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    # Build the result list, keeping only numbers with a count of 1\n    result: List[int] = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n\n    return result"}
