{"task_id": "Mbpp/455", "solution": "def check_monthnumb_number(month: int) -> bool:\n    \"\"\"\n    Checks if the given month number (1-12) contains 31 days.\n    Raises MonthValidationError for invalid month numbers.\n    \"\"\"\n    # Constants for month logic\n    MONTHS_WITH_31_DAYS = frozenset({1, 3, 5, 7, 8, 10, 12})\n    MIN_MONTH = 1\n    MAX_MONTH = 12\n\n    class MonthError(Exception):\n        \"\"\"Base exception for month-related errors.\"\"\"\n        def __init__(self, message: str = \"\"):\n            super().__init__(message)\n\n    class MonthValidationError(MonthError):\n        \"\"\"Exception raised for invalid month input values.\"\"\"\n        pass\n\n    class MonthValidator:\n        \"\"\"Validates and converts month inputs to a canonical integer.\"\"\"\n        def validate(self, month_value: object) -> int:\n            try:\n                m = int(month_value)\n            except (ValueError, TypeError):\n                raise MonthValidationError(f\"Invalid month value: {month_value!r}\")\n            if not (MIN_MONTH <= m <= MAX_MONTH):\n                raise MonthValidationError(f\"Month must be between {MIN_MONTH} and {MAX_MONTH}: {m}\")\n            return m\n\n    class MonthService:\n        \"\"\"Provides business logic for month-related queries.\"\"\"\n        def has_31_days(self, month_num: int) -> bool:\n            return month_num in MONTHS_WITH_31_DAYS\n\n    class MonthController:\n        \"\"\"Coordinates validation and service logic.\"\"\"\n        def __init__(self, service: 'MonthService' = None, validator: 'MonthValidator' = None):\n            self._validator = validator or MonthValidator()\n            self._service = service or MonthService()\n\n        def check_month(self, month_input: object) -> bool:\n            validated_month = self._validator.validate(month_input)\n            return self._service.has_31_days(validated_month)\n\n    # Instantiate controller and perform the check\n    controller = MonthController()\n    return controller.check_month(month)"}
{"task_id": "Mbpp/454", "solution": "import re\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"\n    Checks if the input text contains at least one word with the letter 'z' (case-insensitive).\n    \"\"\"\n    # (?i) makes the match case-insensitive.\n    # \\b matches a word boundary.\n    # \\w* matches zero or more word characters (alphanumeric + underscore).\n    pattern = re.compile(r\"(?i)\\b\\w*z\\w*\\b\")\n    return bool(pattern.search(text))"}
