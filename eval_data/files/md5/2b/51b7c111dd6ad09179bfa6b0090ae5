{"task_id": "Mbpp/759", "solution": "import re\ndef is_decimal(value: str, precision: int = 2) -> bool:\n    \"\"\"\n    Checks if a string is a decimal number with a specified precision.\n    Requires an optional sign, an integer part, and a fractional part matching the precision.\n    If precision is 0, no decimal point or fractional part is allowed.\n    \"\"\"\n    if precision == 0:\n        pattern = r\"^[+-]?\\d+$\"\n    else: # precision > 0\n        pattern = fr\"^[+-]?\\d+\\.\\d{{{precision}}}$\"\n    \n    regex = re.compile(pattern)\n    return bool(regex.match(value))"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(arr, n):\n    \"\"\"\n    Finds the minimum absolute difference between any two elements in the array.\n    Assumes the input array contains at least two numeric elements.\n    \"\"\"\n    nums = list(arr)\n    nums.sort()\n\n    min_diff = float('inf')\n    for i in range(1, len(nums)):\n        current_diff = abs(nums[i] - nums[i-1])\n        if current_diff < min_diff:\n            min_diff = current_diff\n            if min_diff == 0:  # Early exit if minimum difference is 0 (duplicate elements)\n                break\n    return min_diff"}
{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number.\n    A polite number is a positive integer that is not a power of two.\n    \"\"\"\n    if n < 1:\n        # Based on design context, n is assumed to be >= 1.\n        # This check is added to prevent infinite loop for invalid n,\n        # but the design indicates that validation would happen in controller/service.\n        return 0 \n\n    polite_count = 0\n    num = 1\n    while True:\n        # Check if num is a power of two\n        # (x & (x - 1)) == 0 is true for powers of two (and 0)\n        is_power_of_two = (num > 0) and ((num & (num - 1)) == 0)\n\n        if not is_power_of_two:\n            polite_count += 1\n            if polite_count == n:\n                return num\n        num += 1"}
