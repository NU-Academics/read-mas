{"task_id": "Mbpp/67", "solution": "import json\nimport os\nimport tempfile\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional\nclass BellError(Exception):\n    \"\"\"Base exception for Bell number operations.\"\"\"\nclass InvalidInputError(BellError):\n    \"\"\"Raised when input is invalid.\"\"\"\nclass ComputationError(BellError):\n    \"\"\"Raised when Bell number computation fails.\"\"\"\nclass CacheError(BellError):\n    \"\"\"Raised when cache operations encounter an error.\"\"\"\nDEFAULT_CACHE_SUBDIR = \"bellset\"\ndef validate_non_negative_int(x: Any) -> int:\n    \"\"\"Validates if x is a non-negative integer, raising InvalidInputError if not.\"\"\"\n    if not isinstance(x, int):\n        try:\n            x = int(x)\n        except (ValueError, TypeError) as exc:\n            raise InvalidInputError(\"Input must be an integer.\") from exc\n    if x < 0:\n        raise InvalidInputError(\"Input must be a non-negative integer.\")\n    return x\ndef get_default_cache_path() -> Path:\n    \"\"\"Returns the default, OS-specific path for the cache directory.\"\"\"\n    cache_dir = Path.home() / \".cache\" / DEFAULT_CACHE_SUBDIR\n    cache_dir.mkdir(parents=True, exist_ok=True)\n    return cache_dir\nclass BellCalculator:\n    \"\"\"Computes Bell numbers using the Bell triangle algorithm.\"\"\"\n    ALGORITHM = \"triangle\"\n\n    def compute_bell(self, n: int) -> int:\n        \"\"\"Computes the nth Bell number using dynamic programming.\"\"\"\n        if n == 0:\n            return 1\n\n        # Initialize the first row of the Bell triangle\n        row = [1]\n\n        # Build subsequent rows\n        for i in range(1, n + 1):\n            new_row = [row[-1]]  # The first element of the new row is the last of the previous\n            for j in range(1, i + 1):\n                # Each subsequent element is the sum of the element to its left and the element above it in the previous row\n                new_row.append(new_row[j - 1] + row[j - 1])\n            row = new_row\n        return row[0] # The nth Bell number is the first element of the nth row\nclass CacheRepository:\n    \"\"\"Manages persistent storage and retrieval of Bell numbers from a JSON file.\"\"\"\n    CACHE_FILENAME = \"cache.json\"\n    CACHE_VERSION = 1\n\n    def __init__(self, path: Optional[Path] = None):\n        self.path = path or (get_default_cache_path() / self.CACHE_FILENAME)\n        self.entries: Dict[int, int] = {}\n        self._load()\n\n    def _load(self) -> None:\n        \"\"\"Loads cached entries from the JSON file, handling missing or corrupt files.\"\"\"\n        if not self.path.exists():\n            return # No cache file, return empty entries\n        try:\n            raw_content = self.path.read_text(encoding=\"utf-8\")\n            raw_data = json.loads(raw_content)\n\n            if raw_data.get(\"version\") != self.CACHE_VERSION:\n                # Version mismatch: backup old file and reset cache\n                backup_path = self.path.with_suffix(self.path.suffix + \".bak\")\n                if self.path.exists(): # Ensure file exists before attempting to replace\n                    self.path.replace(backup_path)\n                return\n\n            self.entries = {int(k): int(v) for k, v in raw_data.get(\"entries\", {}).items()}\n        except Exception:\n            # On any error, backup the corrupt file and start with an empty cache\n            backup_path = self.path.with_suffix(self.path.suffix + \".corrupt.bak\")\n            if self.path.exists():\n                self.path.replace(backup_path)\n            self.entries = {}\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a Bell number from the cache.\"\"\"\n        return self.entries.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a Bell number in the in-memory cache.\"\"\"\n        self.entries[n] = value\n\n    def flush(self) -> None:\n        \"\"\"Writes the current in-memory cache to disk atomically.\"\"\"\n        payload = {\"version\": self.CACHE_VERSION, \"entries\": {str(k): v for k, v in self.entries.items()}}\n        try:\n            atomic_write(self.path, json.dumps(payload, indent=2))\n        except Exception as exc:\n            raise CacheError(f\"Failed to flush cache to {self.path}\") from exc\n\n    def clear(self) -> None:\n        \"\"\"Clears both the in-memory cache and the persistent file.\"\"\"\n        self.entries = {}\n        if self.path.exists():\n            self.path.unlink()\nclass BellService:\n    \"\"\"Orchestrates Bell number computation, validation, and caching.\"\"\"\n    def __init__(self, repository: Optional[CacheRepository] = None, calculator: Optional[BellCalculator] = None):\n        self.repository = repository or CacheRepository()\n        self.calculator = calculator or BellCalculator()\n\n    def validate_input(self, n: Any) -> int:\n        \"\"\"Validates that n is a non-negative integer.\"\"\"\n        return validate_non_negative_int(n)\n\n    def get_bell(self, n: int) -> int:\n        \"\"\"Retrieves the nth Bell number, using cache or computing if necessary.\"\"\"\n        n = self.validate_input(n) # Validate input as per FR1\n\n        cached_value = self.repository.get(n)\n        if cached_value is not None:\n            return cached_value\n\n        try:\n            computed_value = self.calculator.compute_bell(n)\n        except Exception as exc:\n            raise ComputationError(f\"Failed to compute Bell number for n={n}\") from exc\n\n        self.repository.set(n, computed_value)\n        self.repository.flush()\n        return computed_value\n_default_service = BellService()\ndef bell_number(n: int) -> int:\n    \"\"\"\n    Computes the nth Bell number.\n    This function leverages an internal service for caching and computation.\n    \"\"\"\n    return _default_service.get_bell(n)"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(seq: list, sub: list) -> bool:\n    \"\"\"\n    Checks if a list contains the given sublist contiguously using the KMP algorithm.\n    An empty sublist is considered a sublist of any list.\n    \"\"\"\n    if not sub:  # Business rule: empty sublist is a sublist of any list\n        return True\n\n    if len(sub) > len(seq):\n        return False\n\n    def _build_failure_table(pattern: list) -> list[int]:\n        \"\"\"Builds the KMP failure (LPS) table for the pattern.\"\"\"\n        m = len(pattern)\n        f = [0] * m\n        k = 0  # length of the previous longest prefix suffix\n        for i in range(1, m):\n            while k > 0 and pattern[k] != pattern[i]:\n                k = f[k - 1]\n            if pattern[k] == pattern[i]:\n                k += 1\n            f[i] = k\n        return f\n\n    failure_table = _build_failure_table(sub)\n\n    i = 0  # pointer for seq\n    j = 0  # pointer for sub\n\n    while i < len(seq):\n        if seq[i] == sub[j]:\n            i += 1\n            j += 1\n            if j == len(sub):  # Sublist found\n                return True\n        else:\n            if j != 0:\n                j = failure_table[j - 1]\n            else:\n                i += 1\n    return False"}
{"task_id": "Mbpp/70", "solution": "from typing import Iterable, Tuple\ndef get_equal(items: Iterable[Tuple]) -> bool:\n    \"\"\"Checks if all tuples in the given iterable have the same length.\n\n    Returns True for an empty iterable.\n    \"\"\"\n    lengths = [len(t) for t in items]\n    if not lengths:\n        return True\n    return len(set(lengths)) == 1"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(data: list, shrink: float = 1.3) -> list:\n    \"\"\"Sorts a list of elements using the Comb Sort algorithm.\n    This function returns a new sorted list, leaving the original unchanged.\n    \"\"\"\n    arr = list(data)\n    n = len(arr)\n    gap = n\n    swapped = True\n\n    while gap > 1 or swapped:\n        # Calculate the next gap value\n        gap = int(gap / shrink)\n        if gap < 1:\n            gap = 1\n\n        swapped = False\n        # Perform a \"bubble\" pass for the current gap\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    return arr"}
{"task_id": "Mbpp/72", "solution": "def dif_Square(n):\n    \"\"\"\n    Checks if an integer can be represented as the difference of two squares.\n    A number n can be represented as a^2 - b^2 if and only if n is not congruent to 2 mod 4.\n    \"\"\"\n    return (n % 4) != 2"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(seq, patterns_array):\n    \"\"\"\n    Checks if a sequence follows the pattern defined by patterns_array using a bijective mapping.\n    Ensures that each pattern element maps to exactly one sequence element and vice-versa.\n    \"\"\"\n    seq_list = list(seq)\n    pat_list = list(patterns_array)\n\n    if len(seq_list) != len(pat_list):\n        return False\n\n    pat_to_val = {}\n    val_to_pat = {}\n\n    for p, v in zip(pat_list, seq_list):\n        if p in pat_to_val and pat_to_val[p] != v:\n            return False\n        if v in val_to_pat and val_to_pat[v] != p:\n            return False\n        pat_to_val[p] = v\n        val_to_pat[v] = p\n            \n    return True"}
{"task_id": "Mbpp/75", "solution": "from typing import List, Tuple\ndef find_tuples(list_of_tuples: List[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n    \"\"\"\n    Finds tuples from a list where all elements are divisible by k.\n    Empty tuples are not considered qualifying.\n    \"\"\"\n    result = []\n    for tup in list_of_tuples:\n        # According to design assumption 3, empty tuples are not considered qualifying.\n        if not tup:\n            continue\n\n        all_divisible = True\n        for element in tup:\n            if element % k != 0:\n                all_divisible = False\n                break\n        if all_divisible:\n            result.append(tup)\n    return result"}
{"task_id": "Mbpp/79", "solution": "def word_len(word: str) -> bool:\n    \"\"\"\n    Checks if the length of a word is odd, stripping leading/trailing whitespace by default.\n    Assumes the input 'word' is a string as per its type hint.\n    \"\"\"\n    def _normalize_text(text: str, count_whitespace: bool = False) -> str:\n        \"\"\"Helper to normalize text, stripping whitespace if not configured to count it.\"\"\"\n        if not count_whitespace:\n            return text.strip()\n        return text\n\n    normalized_word = _normalize_text(word, count_whitespace=False)\n    return (len(normalized_word) % 2) == 1"}
{"task_id": "Mbpp/80", "solution": "def tetrahedral_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth tetrahedral number using the closed-form formula.\n    Assumes n is a positive integer.\n    \"\"\"\n    return (n * (n + 1) * (n + 2)) // 6"}
{"task_id": "Mbpp/82", "solution": "import math\nfrom typing import Any\nclass VolumeError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass Config:\n    PI: float = math.pi\n    DEFAULT_PRECISION: int = 6\n    USE_DECIMAL: bool = False\nclass InputValidator:\n    def validate_radius(self, radius: Any) -> float:\n        if radius is None:\n            raise VolumeError(\"Radius is required\")\n        try:\n            r = float(radius)\n        except (TypeError, ValueError):\n            raise VolumeError(f\"Radius must be a number; got {type(radius).__name__}\")\n        if math.isinf(r) or math.isnan(r):\n            raise VolumeError(\"Radius must be a finite number\")\n        if r < 0:\n            raise VolumeError(\"Radius must be non-negative\")\n        return r\nclass VolumeService:\n    def compute_volume(self, radius: float) -> float:\n        return (4.0 / 3.0) * Config.PI * (radius ** 3)\nclass VolumeController:\n    def __init__(self, validator: InputValidator, service: VolumeService) -> None:\n        self._validator = validator\n        self._service = service\n\n    def calculate_volume(self, radius: Any) -> float:\n        r = self._validator.validate_radius(radius)\n        return self._service.compute_volume(r)\ndef volume_sphere(radius: float) -> float:\n    \"\"\"Calculates the volume of a sphere given its radius. Raises `VolumeError` for invalid or non-numeric radius.\"\"\"\n    controller = VolumeController(InputValidator(), VolumeService())\n    return controller.calculate_volume(radius)"}
{"task_id": "Mbpp/85", "solution": "import math\ndef surfacearea_sphere(radius: float) -> float:\n    \"\"\"\n    Calculates the surface area of a sphere using the formula 4 * pi * r^2.\n    Assumes radius is a non-negative float.\n    \"\"\"\n    return 4 * math.pi * (radius ** 2)"}
{"task_id": "Mbpp/86", "solution": "def centered_hexagonal_number(n: int) -> int:\n    \"\"\"\n    Computes the nth centered hexagonal number using the formula 3*n*(n-1)+1.\n    Assumes valid integer input n >= 1, per design context's core formula and ignoring validation constraints.\n    \"\"\"\n    return 3 * n * (n - 1) + 1"}
{"task_id": "Mbpp/84", "solution": "import collections\nfrom typing import Any, Optional, List\nMAX_N = 10000\nDEFAULT_CACHE_SIZE = 10000\nclass InvalidInputError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass ComputeError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass SimpleCache:\n    \"\"\"In-memory cache for computed sequence values.\"\"\"\n    def __init__(self, max_size: int):\n        self._store: dict[str, Any] = {}\n        self._max_size = max_size\n\n    def get(self, key: str) -> Optional[Any]:\n        return self._store.get(key)\n\n    def set(self, key: str, value: Any) -> None:\n        self._store[key] = value\n\n    def clear(self) -> None:\n        self._store.clear()\nclass SequenceRepository:\n    \"\"\"Manages the in-memory persistence of the Newman-Conway sequence prefix.\"\"\"\n    def __init__(self, cache: SimpleCache):\n        self._cache = cache\n        self._values: List[int] = [0] # index 0 is a dummy for 1-based indexing\n\n        cached_prefix = self._cache.get(\"prefix\")\n        if cached_prefix is not None:\n            self._values = cached_prefix\n        else:\n            # Initialize with base cases a(1)=1, a(2)=1\n            self._values = [0, 1, 1]\n\n    def get_prefix(self) -> List[int]:\n        return list(self._values)\n\n    def get(self, index: int) -> Optional[int]:\n        if 1 <= index < len(self._values):\n            return self._values[index]\n        return None\n\n    def store_prefix(self, values: List[int]) -> None:\n        \"\"\"Replaces the internal prefix and updates the cache.\"\"\"\n        self._values = values\n        self._cache.set(\"prefix\", values)\nclass InputValidator:\n    \"\"\"Validates input 'n' against business rules.\"\"\"\n    def __init__(self, max_n: int = MAX_N):\n        self.MAX_N = max_n\n\n    def validate_n(self, n: int) -> None:\n        if not isinstance(n, int):\n            raise InvalidInputError(\"n must be an integer.\")\n        if n < 1:\n            raise InvalidInputError(\"n must be >= 1.\")\n        if n > self.MAX_N:\n            raise InvalidInputError(f\"n must be <= {self.MAX_N}.\")\nclass SequenceService:\n    \"\"\"Implements the Newman-Conway algorithm and orchestrates computation.\"\"\"\n    def __init__(self, repo: SequenceRepository):\n        self._repo = repo\n\n    def compute(self, n: int) -> int:\n        existing = self._repo.get(n)\n        if existing is not None:\n            return existing\n        \n        values = self._repo.get_prefix()\n        if len(values) <= 2:\n            values = [0, 1, 1] # Ensure base cases a(1)=1, a(2)=1 are present\n\n        try:\n            for i in range(len(values), n + 1):\n                prev_val_idx = values[i-1]\n                \n                # Check for invalid intermediate indices to prevent IndexError\n                if not (1 <= prev_val_idx < i):\n                    raise ComputeError(f\"Invalid intermediate index: a({i-1}) = {prev_val_idx}.\")\n\n                term1_idx = prev_val_idx\n                term2_idx = i - prev_val_idx\n\n                if not (1 <= term1_idx < i and 1 <= term2_idx < i):\n                    raise ComputeError(f\"Invalid indices used for summation: a({term1_idx}) + a({term2_idx}).\")\n                \n                val = values[term1_idx] + values[term2_idx]\n                values.append(val)\n        except IndexError as e:\n            raise ComputeError(f\"Computation error at n={i}: {e}\") from e\n        except Exception as e:\n            raise ComputeError(f\"An unexpected error during computation: {e}\") from e\n        \n        self._repo.store_prefix(values)\n        return values[n]\n\n    def compute_sequence(self, n: int) -> List[int]:\n        \"\"\"Returns the full list of a[1..n], prefixed with a dummy 0.\"\"\"\n        # This method duplicates logic from compute but returns the full list.\n        self.compute(n) # Ensure sequence is computed up to n\n        return self._repo.get_prefix()[:n+1]\nclass SequenceController:\n    \"\"\"Exposes the public API and orchestrates validation and service calls.\"\"\"\n    def __init__(self, service: SequenceService, validator: InputValidator):\n        self._service = service\n        self._validator = validator\n\n    def sequence(self, n: int) -> int:\n        self._validator.validate_n(n)\n        return self._service.compute(n)\n_cache = SimpleCache(max_size=DEFAULT_CACHE_SIZE)\n_repo = SequenceRepository(cache=_cache)\n_service = SequenceService(repo=_repo)\n_validator = InputValidator()\n_controller = SequenceController(service=_service, validator=_validator)\ndef sequence(n: int) -> int:\n    \"\"\"Computes the nth number in the Newman-Conway sequence.\"\"\"\n    return _controller.sequence(n)"}
