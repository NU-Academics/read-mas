{"task_id": "Mbpp/592", "solution": "import math\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\ndef validate_non_negative_int(n) -> int:\n    \"\"\"Validates that n is a non-negative integer and returns it.\"\"\"\n    if not isinstance(n, int):\n        raise InvalidInputError(\"n must be an integer.\")\n    if n < 0:\n        raise InvalidInputError(\"n must be non-negative.\")\n    return n\ndef safe_comb(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient C(n, k) using math.comb or a fallback.\"\"\"\n    if k < 0 or k > n:\n        return 0\n    try:\n        return math.comb(n, k)\n    except AttributeError:\n        # Fallback multiplicative implementation for older Python versions\n        k_eff = min(k, n - k)\n        num = 1\n        den = 1\n        for i in range(1, k_eff + 1):\n            num *= n - (k_eff - i)\n            den *= i\n        return num // den\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Finds the sum of the product of consecutive binomial coefficients using the identity C(2n, n-1).\n    This function computes sum_{k=0..n-1} C(n,k) * C(n,k+1).\n    \"\"\"\n    n_validated = validate_non_negative_int(n)\n    if n_validated == 0:\n        return 0\n    # Apply the combinatorial identity: sum_{k=0..n-1} C(n,k)C(n,k+1) = C(2n, n-1)\n    return safe_comb(2 * n_validated, n_validated - 1)"}
{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip_address: str) -> str:\n    \"\"\"Removes leading zeros from each octet of an IPv4 address string.\"\"\"\n    octets = ip_address.split('.')\n    normalized_octets = [str(int(octet)) for octet in octets]\n    return \".\".join(normalized_octets)"}
{"task_id": "Mbpp/597", "solution": "from typing import List\ndef find_kth(a: List[int], b: List[int], k: int) -> int:\n    \"\"\"Finds the k-th smallest element from two sorted arrays.\"\"\"\n    # Ensure 'a' is the smaller array to optimize recursion depth\n    if len(a) > len(b):\n        return find_kth(b, a, k)\n\n    # Base cases\n    if not a:  # If array 'a' is empty, k-th element must be in 'b'\n        return b[k - 1]\n    if k == 1:  # If k is 1, return the minimum of the first elements\n        return min(a[0], b[0])\n\n    # Calculate partition indices\n    # `i` is the number of elements to take from `a`\n    # `j` is the number of elements to take from `b`\n    i = min(len(a), k // 2)\n    j = k - i\n\n    # Compare elements at partition points and recurse\n    if a[i - 1] <= b[j - 1]:\n        # If a's i-th element is smaller or equal, discard a[0...i-1] and reduce k\n        return find_kth(a[i:], b, k - i)\n    else:\n        # If b's j-th element is smaller, discard b[0...j-1] and reduce k\n        return find_kth(a, b[j:], k - j)"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n: int) -> tuple[int, float]:\n    \"\"\"Calculate the sum and average of the first n natural numbers.\n    Uses arithmetic formulas for O(1) performance.\"\"\"\n    total_sum = n * (n + 1) // 2\n    average = float(total_sum) / n\n    return (total_sum, average)"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(n: int) -> bool:\n    \"\"\"\n    Checks if a number is an Armstrong number.\n\n    An Armstrong number is a number that is the sum of its own digits\n    each raised to the power of the number of digits.\n    \"\"\"\n    s_n = str(n)\n    num_digits = len(s_n)\n    sum_of_powers = 0\n    for digit_char in s_n:\n        digit = int(digit_char)\n        sum_of_powers += digit ** num_digits\n    return sum_of_powers == n"}
