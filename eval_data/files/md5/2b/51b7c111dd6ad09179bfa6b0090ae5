{"task_id": "Mbpp/290", "solution": "def max_length(list_of_lists):\n    \"\"\"\n    Finds the list of maximum length in a list of lists.\n    Returns a tuple containing the maximum length and the first encountered list of that length.\n    \"\"\"\n    max_len = 0\n    candidate_list = []\n\n    for sublist in list_of_lists:\n        current_len = len(sublist)\n        if current_len > max_len:\n            max_len = current_len\n            candidate_list = sublist\n            \n    return (max_len, candidate_list)"}
{"task_id": "Mbpp/286", "solution": "def max_sub_array_sum_repeated(arr: list[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in the modified array formed by repeating arr k times.\n    The algorithm runs in O(N) time by considering Kadane's on a single array, max prefix/suffix sums,\n    and the total sum for multiple repetitions.\n    \"\"\"\n    def _kadane(current_arr: list[int]) -> int:\n        # Standard Kadane's algorithm to find the maximum contiguous subarray sum.\n        # It handles cases where all numbers are negative by returning the largest (least negative) single element.\n        max_so_far = current_arr[0]\n        current_max = current_arr[0]\n\n        for i in range(1, len(current_arr)):\n            current_max = max(current_arr[i], current_max + current_arr[i])\n            max_so_far = max(max_so_far, current_max)\n        return max_so_far\n\n    # If the array is repeated only once, simply apply Kadane's algorithm on the original array.\n    if k == 1:\n        return _kadane(arr)\n\n    # Calculate the maximum subarray sum within a single instance of arr.\n    max_sum_single = _kadane(arr)\n\n    # Calculate the maximum prefix sum (largest sum starting from the beginning of arr).\n    current_prefix_sum = 0\n    max_prefix_sum = float('-inf')\n    for x in arr:\n        current_prefix_sum += x\n        max_prefix_sum = max(max_prefix_sum, current_prefix_sum)\n\n    # Calculate the maximum suffix sum (largest sum ending at the end of arr).\n    current_suffix_sum = 0\n    max_suffix_sum = float('-inf')\n    for x in reversed(arr):\n        current_suffix_sum += x\n        max_suffix_sum = max(max_suffix_sum, current_suffix_sum)\n\n    # Calculate the total sum of all elements in arr.\n    total_sum = sum(arr)\n\n    # Initialize the overall maximum result with the max sum from a single array.\n    result = max_sum_single\n\n    # Consider a subarray that spans across the boundary of two arrays (e.g., suffix of first + prefix of second).\n    result = max(result, max_prefix_sum + max_suffix_sum)\n\n    # If the total sum of the array is positive, adding more full repetitions (k-2 in the middle)\n    # between the max prefix and max suffix sums will increase the overall sum.\n    if total_sum > 0:\n        result = max(result, max_prefix_sum + (k - 2) * total_sum + max_suffix_sum)\n\n    return result"}
{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"Returns the sum of squares of the first n even natural numbers using a closed-form formula.\"\"\"\n    # The sum of squares of the first n even numbers is 4 * sum(k^2 for k=1 to n).\n    # sum(k^2) = n(n+1)(2n+1)/6.\n    # So the total sum = 4 * n(n+1)(2n+1)/6 = 2 * n(n+1)(2n+1)/3.\n    return 2 * n * (n + 1) * (2 * n + 1) // 3"}
{"task_id": "Mbpp/293", "solution": "def otherside_rightangle(a: float, b: float) -> float:\n    \"\"\"\n    Computes the hypotenuse of a right-angled triangle given two legs.\n    Assumes `a` and `b` are the lengths of the two legs.\n    \"\"\"\n    import math\n\n    # In a right-angled triangle, if a and b are legs, the hypotenuse c is sqrt(a^2 + b^2).\n    # math.hypot is used for numerical stability.\n    return math.hypot(a, b)"}
{"task_id": "Mbpp/296", "solution": "from typing import List, Tuple\ndef get_Inv_Count(arr: List[int]) -> int:\n    \"\"\"Counts inversions in an array using a modified merge sort algorithm.\n    An inversion occurs when arr[i] > arr[j] for i < j.\"\"\"\n\n    def _merge_count(left: List[int], right: List[int]) -> Tuple[List[int], int]:\n        \"\"\"Merges two sorted lists and counts cross-inversions.\"\"\"\n        merged: List[int] = []\n        i = j = 0\n        inv_count = 0\n        while i < len(left) and j < len(right):\n            if left[i] <= right[j]:\n                merged.append(left[i])\n                i += 1\n            else:\n                merged.append(right[j])\n                inv_count += len(left) - i\n                j += 1\n        merged.extend(left[i:])\n        merged.extend(right[j:])\n        return merged, inv_count\n\n    def _sort_count(current_arr: List[int]) -> Tuple[List[int], int]:\n        \"\"\"Recursively sorts and counts inversions in the array.\"\"\"\n        n = len(current_arr)\n        if n <= 1:\n            return current_arr, 0\n        mid = n // 2\n        left, lc = _sort_count(current_arr[:mid])\n        right, rc = _sort_count(current_arr[mid:])\n        merged, mc = _merge_count(left, right)\n        return merged, lc + rc + mc\n\n    if not arr:\n        return 0\n    # Create a copy of the input array to avoid modifying the original during sorting.\n    _, count = _sort_count(list(arr))\n    return count"}
{"task_id": "Mbpp/292", "solution": "import math\ndef find(a, b) -> int:\n    \"\"\"\n    Finds the quotient of two numbers, rounded down to the nearest integer (floor division).\n    \"\"\"\n    return int(math.floor(a / b))"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(nested_list: list) -> list:\n    \"\"\"\n    Flattens a given nested list structure into a single-level list.\n    Recursively processes sublists and appends non-list elements.\n    \"\"\"\n    flat_list = []\n    for item in nested_list:\n        if isinstance(item, list):\n            flat_list.extend(flatten_list(item))\n        else:\n            flat_list.append(item)\n    return flat_list"}
{"task_id": "Mbpp/294", "solution": "from decimal import Decimal\ndef max_val(items):\n    \"\"\"\n    Finds the maximum numeric value in a given heterogeneous list.\n    Non-numeric types, booleans, and numeric strings are ignored by default.\n    \"\"\"\n    numeric_decimals = []\n    for item in items:\n        # Implement coercion logic based on default config (allow_string_coercion=False, allow_bool_as_numeric=False).\n        current_decimal = None\n        if isinstance(item, Decimal):\n            current_decimal = item\n        elif isinstance(item, bool):\n            # Booleans are treated as non-numeric by default config.\n            pass\n        elif isinstance(item, int):\n            current_decimal = Decimal(item)\n        elif isinstance(item, float):\n            # Convert float via string to Decimal to preserve precision and avoid floating point issues.\n            current_decimal = Decimal(str(item))\n        # Other types (str, None, other objects) are ignored as per default configuration.\n\n        if current_decimal is not None:\n            numeric_decimals.append(current_decimal)\n\n    # Use Python's built-in max() function. If numeric_decimals is empty, it will raise ValueError,\n    # which satisfies the constraint of not adding explicit exception checks or custom exceptions for edge cases.\n    return max(numeric_decimals)"}
{"task_id": "Mbpp/300", "solution": "import math\ndef count_binary_seq(n: int) -> float:\n    \"\"\"\n    Counts binary sequences of length 2n where the sum of first n bits equals sum of last n bits.\n    This is equivalent to the central binomial coefficient C(2n, n).\n    \"\"\"\n    return float(math.comb(2 * n, n))"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(d):\n    \"\"\"\n    Calculates the maximum nesting depth of a dictionary.\n    An empty dictionary is considered to have a depth of 1.\n    \"\"\"\n    max_depth = 0\n    stack = [(d, 1)]\n    while stack:\n        current_dict, depth = stack.pop()\n        max_depth = max(max_depth, depth)\n        for value in current_dict.values():\n            if isinstance(value, dict):\n                stack.append((value, depth + 1))\n    return max_depth"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(data: List[Tuple[str, Any]]) -> Tuple[str, float]:\n    \"\"\"\n    Calculates the name with the maximum aggregate value from a list of (name, value) tuples.\n    If multiple names tie for the maximum total, the lexicographically smallest name is returned.\n    \"\"\"\n    aggregates: Dict[str, float] = defaultdict(float)\n\n    for name, value in data:\n        aggregates[name] += float(value)\n    \n    # Find the item (name, total) with the maximum total.\n    # For ties in total, the key (-total, name) makes 'min' select the largest total\n    # (because negative large numbers are smaller) and then the lexicographically smallest name\n    # if totals are equal. This correctly implements the tie-breaking rule.\n    max_name, max_total = min(aggregates.items(), key=lambda item: (-item[1], item[0]))\n\n    return (max_name, max_total)"}
{"task_id": "Mbpp/309", "solution": "def maximum(a, b):\n    \"\"\"\n    Finds the maximum of two numbers after validation.\n    Handles non-numeric inputs by raising InvalidInputError.\n    \"\"\"\n    import math\n    from typing import Tuple\n\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception for invalid input types or values.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class Validator:\n        \"\"\"Utility for validating numeric inputs.\"\"\"\n        @staticmethod\n        def validate_number(value) -> float:\n            if isinstance(value, bool):\n                raise InvalidInputError(\"bool is not a valid numeric input\")\n            try:\n                v = float(value)\n            except (TypeError, ValueError):\n                raise InvalidInputError(f\"Invalid numeric input: {value!r}\")\n            if math.isnan(v) or math.isinf(v):\n                raise InvalidInputError(\"NaN or infinite values are not allowed\")\n            return v\n\n    class NumberPair:\n        \"\"\"A value object representing a pair of numeric values.\"\"\"\n        def __init__(self, a: float, b: float) -> None:\n            self.a: float = a\n            self.b: float = b\n\n        def as_tuple(self) -> Tuple[float, float]:\n            \"\"\"Returns the pair as a tuple.\"\"\"\n            return (self.a, self.b)\n\n        def max(self) -> float:\n            \"\"\"Returns the larger of the two stored numbers.\"\"\"\n            return self.a if self.a >= self.b else self.b\n\n    class MaxService:\n        \"\"\"Business logic for finding the maximum of two numbers.\"\"\"\n        def maximum(self, a: float, b: float) -> float:\n            pair = NumberPair(a, b)\n            return pair.max()\n\n    class MaxController:\n        \"\"\"Coordinates validation and maximum calculation.\"\"\"\n        def __init__(self, service: MaxService = None) -> None:\n            self.service = service or MaxService()\n\n        def maximum(self, a, b) -> float:\n            va = Validator.validate_number(a)\n            vb = Validator.validate_number(b)\n            return self.service.maximum(va, vb)\n\n    # Instantiate the controller for this specific call, as required by \"inline\" constraint.\n    controller = MaxController()\n    return controller.maximum(a, b)"}
{"task_id": "Mbpp/305", "solution": "def start_withp(words: list[str]) -> tuple[str, str]:\n    \"\"\"\n    Returns two words from a list of strings that start with 'p' (case-insensitive).\n    \"\"\"\n    # Define custom exception inline as per constraint: \"Do NOT call any helper that is not defined inline in your response\".\n    class StartWithPError(Exception):\n        def __init__(self, message: str) -> None:\n            self.message = message\n            super().__init__(self.message)\n\n    # Define common punctuation characters for stripping.\n    PUNCTUATION_CHARS = '!\"#$%&\\'()*+,-./:;<=>?@[\\\\]^_`{|}~'\n    found_words = []\n\n    for word_group in words:\n        # Split each string into tokens by any whitespace.\n        tokens = word_group.split()\n\n        for token in tokens:\n            # Strip leading and trailing punctuation from the token.\n            stripped_token = token.strip(PUNCTUATION_CHARS)\n\n            # Check if the stripped token is non-empty and starts with 'p' or 'P'.\n            if stripped_token and stripped_token[0].lower() == 'p':\n                found_words.append(stripped_token)\n                # If two words starting with 'p' are found, return them as a tuple.\n                if len(found_words) == 2:\n                    return (found_words[0], found_words[1])\n\n    # If fewer than two qualifying words are found after checking all input, raise an error.\n    raise StartWithPError(f\"Expected 2 words starting with 'p', found {len(found_words)}\")"}
{"task_id": "Mbpp/310", "solution": "from typing import Any, Tuple\nclass InvalidStringError(ValueError):\n    \"\"\"Custom exception for invalid string inputs.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\ndef validate_string(s: Any) -> bool:\n    \"\"\"Validates if the input is a string.\"\"\"\n    return isinstance(s, str)\nclass StringToTupleConverter:\n    \"\"\"Converts a string to a tuple of its characters.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def convert(self, s: str) -> Tuple[str, ...]:\n        if not validate_string(s):\n            raise InvalidStringError(\"Input must be a str\")\n        return tuple(s)\ndef string_to_tuple(s: str) -> Tuple[str, ...]:\n    \"\"\"Converts a given string to a tuple of characters.\"\"\"\n    converter = StringToTupleConverter()\n    return converter.convert(s)"}
{"task_id": "Mbpp/308", "solution": "import heapq\ndef large_product(a, b, k):\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list.\n    \"\"\"\n    if not a or not b:\n        return []\n\n    # Create sorted copies of lists in descending order\n    A = sorted(list(a), reverse=True)\n    B = sorted(list(b), reverse=True)\n\n    results = []\n    # Min-heap stores (-product_value, index_a, index_b) to simulate a max-heap\n    heap = []\n    # Set to keep track of (index_a, index_b) pairs already added to the heap\n    visited = set()\n\n    # Start with the product of the largest elements from each list\n    initial_product = A[0] * B[0]\n    heapq.heappush(heap, (-initial_product, 0, 0))\n    visited.add((0, 0))\n\n    while heap and len(results) < k:\n        neg_prod, i, j = heapq.heappop(heap)\n        current_product = -neg_prod\n        results.append(current_product)\n\n        # Consider moving to the next element in list A\n        if i + 1 < len(A) and (i + 1, j) not in visited:\n            next_product_a = A[i + 1] * B[j]\n            heapq.heappush(heap, (-next_product_a, i + 1, j))\n            visited.add((i + 1, j))\n\n        # Consider moving to the next element in list B\n        if j + 1 < len(B) and (i, j + 1) not in visited:\n            next_product_b = A[i] * B[j + 1]\n            heapq.heappush(heap, (-next_product_b, i, j + 1))\n            visited.add((i, j + 1))\n\n    return results"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n):\n    \"\"\"\n    Sets the left-most (most significant) unset bit in a non-negative integer.\n    If all bits are set, it sets the next higher bit.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Find the index of the most significant set bit.\n    msb_index = n.bit_length() - 1\n\n    # Iterate from msb_index down to 0 to find the first unset bit.\n    for i in range(msb_index, -1, -1):\n        if not ((n >> i) & 1):  # Check if the i-th bit is 0\n            return n | (1 << i) # Set the i-th bit and return\n\n    # If all bits up to msb_index are set, set the bit at msb_index + 1.\n    return n | (1 << (msb_index + 1))"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr, n, i, k):\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from the prefix up to index i,\n    including the element at index k (where k > i).\n    \"\"\"\n    # dp_prefix[j] stores the maximum sum of an increasing subsequence ending at index j\n    # within the prefix arr[0...i].\n    dp_prefix = [0] * (i + 1)\n\n    # Initialize and fill dp_prefix array using dynamic programming.\n    # dp_prefix[j] represents the maximum sum of an increasing subsequence\n    # that ends with arr[j], considering elements from arr[0] to arr[j].\n    for j in range(i + 1):\n        dp_prefix[j] = arr[j]  # Initialize with arr[j] itself as a subsequence\n        for l in range(j):\n            if arr[l] < arr[j]:\n                dp_prefix[j] = max(dp_prefix[j], dp_prefix[l] + arr[j])\n\n    # Find the maximum sum from dp_prefix that can precede arr[k].\n    # This involves finding dp_prefix[j] for j <= i such that arr[j] < arr[k].\n    max_sum_from_prefix = float('-inf')\n    prefix_element_found = False\n\n    for j in range(i + 1):\n        if arr[j] < arr[k]:\n            max_sum_from_prefix = max(max_sum_from_prefix, dp_prefix[j])\n            prefix_element_found = True\n\n    # If no element in the prefix arr[0...i] is smaller than arr[k],\n    # the increasing subsequence can only include arr[k] itself.\n    if not prefix_element_found:\n        return arr[k]\n    else:\n        # Otherwise, add the maximum suitable prefix sum to arr[k].\n        return max_sum_from_prefix + arr[k]"}
