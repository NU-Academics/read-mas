{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"\n    Computes the nth Catalan number using an iterative multiplicative recurrence relation.\n    Caches computed values internally on the function object for efficient repeated queries.\n    \"\"\"\n    # Initialize a persistent cache on the function object if it doesn't exist.\n    if not hasattr(catalan_number, '_cache'):\n        catalan_number._cache = {0: 1}  # Base case: C0 = 1\n\n    # Return the value directly if it's already in the cache.\n    if n in catalan_number._cache:\n        return catalan_number._cache[n]\n\n    # Find the largest Catalan number already computed and stored in the cache.\n    # This allows computation to build upon existing results, speeding up subsequent calls.\n    max_cached_n = max(catalan_number._cache.keys())\n    current_value = catalan_number._cache[max_cached_n]\n\n    # Compute Catalan numbers iteratively from the next value after the largest cached one up to n.\n    # The recurrence relation is C_k = C_{k-1} * 2 * (2*k - 1) // (k + 1).\n    for k in range(max_cached_n + 1, n + 1):\n        current_value = current_value * 2 * (2 * k - 1) // (k + 1)\n        catalan_number._cache[k] = current_value  # Store intermediate results in cache.\n\n    return catalan_number._cache[n]"}
{"task_id": "Mbpp/581", "solution": "import math\ndef surface_Area(base_edge: float, height: float, *, height_is_slant: bool = True) -> float:\n    \"\"\"\n    Calculates the surface area of a square pyramid.\n    By default, `height` is interpreted as the slant height.\n    \"\"\"\n\n    def _slant_height_from_perpendicular(b_edge: float, p_height: float) -> float:\n        \"\"\"Calculates slant height from base edge and perpendicular height.\"\"\"\n        half_base = b_edge / 2.0\n        return math.hypot(half_base, p_height)\n\n    def _base_area(b_edge: float) -> float:\n        \"\"\"Calculates the area of the square base.\"\"\"\n        return b_edge * b_edge\n\n    def _lateral_area(b_edge: float, s_height: float) -> float:\n        \"\"\"Calculates the lateral surface area.\"\"\"\n        return 2.0 * b_edge * s_height\n\n    actual_slant_height: float\n    if height_is_slant:\n        actual_slant_height = height\n    else:\n        actual_slant_height = _slant_height_from_perpendicular(base_edge, height)\n\n    base_area_val = _base_area(base_edge)\n    lateral_area_val = _lateral_area(base_edge, actual_slant_height)\n\n    return base_area_val + lateral_area_val"}
{"task_id": "Mbpp/589", "solution": "import math\ndef perfect_squares(start: int, end: int) -> list[int]:\n    \"\"\"Finds perfect squares within a given inclusive range.\n    Handles negative start values by effectively starting the search from 0.\n    \"\"\"\n\n    def floor_sqrt(n: int) -> int:\n        if n < 0:\n            return -1\n        return math.isqrt(n)\n\n    def ceil_sqrt(n: int) -> int:\n        if n <= 0:\n            return 0\n        r = math.isqrt(n)\n        return r if r * r == n else r + 1\n\n    # Adjust the start of the range to 0 if it's negative,\n    # as perfect squares are non-negative.\n    effective_start_for_sqrt = max(start, 0)\n\n    # Calculate the integer square roots for the effective start and end.\n    s_start = ceil_sqrt(effective_start_for_sqrt)\n    s_end = floor_sqrt(end)\n\n    # If the end square root is less than the start square root, no squares exist in the range.\n    if s_end < s_start:\n        return []\n\n    # Generate perfect squares by squaring integers from s_start to s_end (inclusive).\n    return [k * k for k in range(s_start, s_end + 1)]"}
{"task_id": "Mbpp/590", "solution": "import math\ndef polar_rect(a, b):\n    # Converts polar coordinates (r, theta) to rectangular coordinates (x, y).\n    # Assumes 'a' is radius 'r' and 'b' is angle 'theta' in radians.\n    r = a\n    theta = b\n    x = r * math.cos(theta)\n    y = r * math.sin(theta)\n    return complex(x, y)"}
{"task_id": "Mbpp/591", "solution": "def swap_List(lst: list) -> list:\n    \"\"\"\n    Interchanges the first and last elements in a list.\n    Returns a new list without modifying the original.\n    \"\"\"\n    if len(lst) < 2:\n        return lst.copy() # For lists with less than 2 elements, return a copy of the original\n    \n    new_list = lst.copy()\n    new_list[0], new_list[-1] = new_list[-1], new_list[0]\n    return new_list"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers):\n    \"\"\"\n    Finds the difference between the first even and first odd number in a list.\n    Assumes both an even and an odd number will be present in the list.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n\n        if first_even is not None and first_odd is not None:\n            break\n\n    return first_even - first_odd"}
