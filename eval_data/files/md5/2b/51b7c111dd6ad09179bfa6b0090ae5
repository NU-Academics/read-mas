{"task_id": "Mbpp/446", "solution": "import collections\nfrom typing import Tuple, Iterable, Any, Dict, List\nclass OccurrenceRequest:\n    \"\"\"Data Transfer Object for occurrence counting requests.\"\"\"\n    def __init__(self, tuple_data: Tuple[Any, ...], items: Iterable[Any]) -> None:\n        self.tuple_data: Tuple[Any, ...] = tuple_data\n        self.items: List[Any] = list(items)\nclass OccurrenceResult:\n    \"\"\"Data Transfer Object for occurrence counting results.\"\"\"\n    def __init__(self, per_item_counts: Dict[Any, int], total: int) -> None:\n        self.per_item_counts: Dict[Any, int] = per_item_counts\n        self.total: int = total\nclass TupleRepository:\n    \"\"\"Repository to abstract access to the tuple data.\"\"\"\n    def __init__(self, tuple_data: Tuple[Any, ...]) -> None:\n        self._tuple_data: Tuple[Any, ...] = tuple_data\n\n    def get_tuple(self) -> Tuple[Any, ...]:\n        \"\"\"Returns the stored tuple data.\"\"\"\n        return self._tuple_data\nclass OccurrenceService:\n    \"\"\"Core logic for counting item occurrences in a tuple.\"\"\"\n    def count_occurrences(self, tuple_data: Tuple[Any, ...], items: Iterable[Any]) -> OccurrenceResult:\n        \"\"\"Counts occurrences of each item in tuple_data and returns an OccurrenceResult.\"\"\"\n        freq = collections.Counter(tuple_data)\n        per_item: Dict[Any, int] = {item: int(freq.get(item, 0)) for item in items}\n        total = sum(per_item.values())\n        return OccurrenceResult(per_item, total)\nclass CountController:\n    \"\"\"Orchestrates repository access and service invocation for counting.\"\"\"\n    def __init__(self, repository: TupleRepository, service: OccurrenceService) -> None:\n        self._repository: TupleRepository = repository\n        self._service: OccurrenceService = service\n\n    def handle(self, request: OccurrenceRequest) -> OccurrenceResult:\n        \"\"\"Handles an occurrence request by fetching data and calling the service.\"\"\"\n        tuple_data = self._repository.get_tuple()\n        result = self._service.count_occurrences(tuple_data, request.items)\n        return result\ndef count_Occurrence(tuple_data: Tuple[Any, ...], items: Iterable[Any]) -> int:\n    \"\"\"\n    Counts the total occurrences of all elements from a list within a tuple.\n    This function acts as the public API entry point.\n    \"\"\"\n    request = OccurrenceRequest(tuple_data, items)\n    repository = TupleRepository(tuple_data)\n    service = OccurrenceService()\n    controller = CountController(repository, service)\n    result = controller.handle(request)\n    return result.total"}
