{"task_id": "Mbpp/440", "solution": "from typing import Optional, Tuple, Any, Dict, List, Set\nimport re\nfrom pathlib import Path\nclass AdverbMatch:\n    \"\"\"Domain model representing an adverb match with text and positions.\"\"\"\n    def __init__(self, text: str, start: int, end: int) -> None:\n        if start < 0 or end < start:\n            raise ValueError(\"Invalid start/end positions for AdverbMatch.\")\n        self.text = text\n        self.start = start\n        self.end = end\n\n    def to_tuple(self) -> Tuple[int, int, str]:\n        \"\"\"Converts the AdverbMatch to a tuple (start, end, text).\"\"\"\n        return (self.start, self.end, self.text)\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Converts the AdverbMatch to a dictionary.\"\"\"\n        return {\"text\": self.text, \"start\": self.start, \"end\": self.end}\nclass Token:\n    \"\"\"Represents a token with its text and original character positions.\"\"\"\n    def __init__(self, text: str, start: int, end: int) -> None:\n        self.text = text\n        self.start = start\n        self.end = end\nclass AdverbLexiconRepository:\n    \"\"\"Manages the lexicon of known adverbs and provides lookup capabilities.\"\"\"\n    EXCEPTIONS: Set[str] = {\"family\", \"supply\", \"reply\", \"holy\", \"daily\", \"early\", \"only\", \"friendly\", \"lovely\", \"ugly\", \"elderly\", \"silly\", \"lonely\", \"costly\", \"manly\", \"lively\"}\n    \n    # Simulate loading from data/adverbs.txt for a self-contained function\n    _initial_adverbs: Set[str] = {\n        \"clearly\", \"quickly\", \"slowly\", \"badly\", \"well\", \"always\", \"never\", \n        \"often\", \"usually\", \"rarely\", \"sometimes\", \"hardly\", \"easily\", \n        \"really\", \"very\", \"too\", \"quite\", \"almost\", \"just\", \"yet\", \"still\", \n        \"already\", \"soon\", \"late\", \"early\", \"yesterday\", \"today\", \"tomorrow\", \n        \"now\", \"then\", \"here\", \"there\", \"everywhere\", \"anywhere\", \"nowhere\", \n        \"somewhere\", \"inside\", \"outside\", \"above\", \"below\", \"ago\", \"fast\",\n        \"hard\", \"straight\", \"enough\", \"altogether\", \"also\", \"otherwise\", \n        \"furthermore\", \"hence\", \"therefore\", \"thus\", \"consequently\", \"subsequently\", \n        \"moreover\", \"accordingly\", \"finally\", \"firstly\", \"secondly\", \"thirdly\", \n        \"lastly\", \"actually\", \"evidently\", \"obviously\", \"certainly\", \"indeed\", \n        \"perhaps\", \"probably\", \"possibly\", \"surely\", \"definitely\", \"absolutely\", \n        \"naturally\", \"frankly\", \"honestly\", \"personally\", \"briefly\", \"generally\", \n        \"normally\", \"usually\", \"frequently\", \"seldom\", \"scarcely\", \"barely\", \n        \"nearly\", \"approximately\", \"exactly\", \"precisely\", \"chiefly\", \"mainly\", \n        \"primarily\", \"especially\", \"particularly\", \"incidentally\", \"by the way\", \n        \"meanwhile\", \"next\", \"afterwards\", \"later\", \"before\", \"hitherto\", \"henceforth\", \n        \"forthwith\", \"thereby\", \"whereby\", \"wherefore\", \"therein\", \"wherein\", \n        \"thereupon\", \"whereupon\", \"nevertheless\", \"nonetheless\", \"however\", \n        \"moreover\", \"besides\", \"additionally\", \"furthermore\", \"likewise\", \n        \"similarly\", \"conversely\", \"instead\", \"rather\", \"otherwise\", \"apart\", \"aside\", \n        \"alone\", \"together\", \"further\", \"far\", \"near\", \"out\", \"in\", \"up\", \"down\",\n        \"back\", \"forward\", \"around\", \"through\", \"across\", \"along\", \"beyond\", \n        \"within\", \"without\", \"until\", \"since\", \"while\", \"whenever\", \"wherever\", \n        \"however\", \"whatever\", \"whoever\", \"whichever\", \"unless\", \"although\", \n        \"though\", \"whereas\", \"while\", \"as\", \"than\", \"so\", \"such\", \"how\", \"what\", \n        \"when\", \"where\", \"why\", \"who\", \"whom\", \"whose\"\n    }\n\n    def __init__(self, lexicon_path: Optional[str] = None) -> None:\n        self._adverbs = self._initial_adverbs # Use hardcoded set instead of file for inline func\n        self.lexicon_path = lexicon_path # Keep for design consistency, though not used here\n\n    def is_adverb(self, word: str) -> bool:\n        \"\"\"Checks if a word is an adverb using lexicon or heuristic.\"\"\"\n        w = word.lower()\n        return w in self._adverbs or (w.endswith(\"ly\") and w not in self.EXCEPTIONS)\nclass TextNormalizer:\n    \"\"\"Provides utilities for tokenization and text normalization.\"\"\"\n    TOKEN_RE: re.Pattern = re.compile(r\"[A-Za-z]+(?:'[A-Za-z]+)?\")\n\n    def tokenize_with_positions(self, sentence: str) -> List[Token]:\n        \"\"\"Tokenizes a sentence, preserving original character positions.\"\"\"\n        return [Token(m.group(0), m.start(), m.end()) for m in self.TOKEN_RE.finditer(sentence)]\nclass AdverbFinderService:\n    \"\"\"Core logic for finding adverbs in a sentence.\"\"\"\n    def __init__(self, lex_repo: AdverbLexiconRepository, normalizer: TextNormalizer) -> None:\n        self.lex_repo = lex_repo\n        self.normalizer = normalizer\n\n    def find_first_adverb(self, sentence: str) -> Optional[AdverbMatch]:\n        \"\"\"Finds the first adverb in the sentence and returns its match details.\"\"\"\n        tokens = self.normalizer.tokenize_with_positions(sentence)\n        for t in tokens:\n            if self._is_candidate_adverb(t):\n                return AdverbMatch(t.text.lower(), t.start, t.end)\n        return None\n\n    def _is_candidate_adverb(self, token: Token) -> bool:\n        \"\"\"Determines if a token is a candidate adverb based on lexicon or heuristic.\"\"\"\n        return self.lex_repo.is_adverb(token.text)\nclass AdverbController:\n    \"\"\"API layer for adverb detection, orchestrating service usage.\"\"\"\n    def __init__(self, finder_service: AdverbFinderService) -> None:\n        self.finder = finder_service\n\n    def find_adverb_position(self, sentence: str) -> Optional[Tuple[int, int, str]]:\n        \"\"\"Finds the first adverb's position and text in a sentence.\"\"\"\n        match = self.finder.find_first_adverb(sentence)\n        return match.to_tuple() if match else None\ndef find_adverb_position(sentence: str) -> Optional[Tuple[int, int, str]]:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    Returns a tuple (start_index, end_index_exclusive, adverb_text) or None if not found.\n    \"\"\"\n    lex_repo = AdverbLexiconRepository()\n    normalizer = TextNormalizer()\n    finder_service = AdverbFinderService(lex_repo, normalizer)\n    controller = AdverbController(finder_service)\n    return controller.find_adverb_position(sentence)"}
{"task_id": "Mbpp/445", "solution": "def index_multiplication(t1, t2):\n    \"\"\"\n    Performs index-wise multiplication of elements from two nested tuples.\n    It iterates through corresponding inner tuples and multiplies their elements.\n    \"\"\"\n    result = []\n    for inner_t1, inner_t2 in zip(t1, t2):\n        inner_result = []\n        for x, y in zip(inner_t1, inner_t2):\n            inner_result.append(x * y)\n        result.append(tuple(inner_result))\n    return tuple(result)"}
