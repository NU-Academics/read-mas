{"task_id": "Mbpp/63", "solution": "def max_difference(tuple_list: list[tuple[int | float, int | float]]) -> int | float:\n    \"\"\"\n    Finds the maximum absolute difference between numbers in pairs within a list of tuples.\n    Returns 0 if the input list is empty.\n    \"\"\"\n    max_diff = 0.0\n    for a, b in tuple_list:\n        current_diff = abs(a - b)\n        if current_diff > max_diff:\n            max_diff = current_diff\n    return max_diff"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(data: list) -> float:\n    \"\"\"\n    Flattens a list of numbers, potentially containing nested lists, and sums its elements.\n    Assumes valid numeric elements within lists and `data` is a list.\n    \"\"\"\n    total = 0.0\n    stack = list(reversed(data))\n\n    while stack:\n        item = stack.pop()\n        if isinstance(item, list):\n            stack.extend(reversed(item))\n        else:\n            total += float(item)\n    return total"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array):\n    \"\"\"\n    Checks if the given array is monotonic (non-decreasing or non-increasing).\n    An empty or single-element array is considered monotonic.\n    \"\"\"\n    n = len(array)\n    if n < 2:\n        return True\n\n    is_non_decreasing = True\n    is_non_increasing = True\n\n    for i in range(1, n):\n        if array[i] < array[i-1]:\n            is_non_decreasing = False\n        if array[i] > array[i-1]:\n            is_non_increasing = False\n\n        # If it's neither non-decreasing nor non-increasing, it's not monotonic\n        if not is_non_decreasing and not is_non_increasing:\n            return False\n\n    return is_non_decreasing or is_non_increasing"}
