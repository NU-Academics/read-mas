{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the sum of per-digit absolute differences between two integers.\n    Digits are aligned from the least significant place, padding with zeros if lengths differ.\n    \"\"\"\n    num1 = abs(a)\n    num2 = abs(b)\n\n    # Helper function to convert a number into a list of its digits, least-significant first.\n    def _split_digits(n: int) -> list[int]:\n        if n == 0:\n            return [0]\n        digits = []\n        while n > 0:\n            digits.append(n % 10)\n            n //= 10\n        return digits\n\n    digits1 = _split_digits(num1)\n    digits2 = _split_digits(num2)\n\n    # Determine the maximum length required for digit comparison.\n    max_len = max(len(digits1), len(digits2))\n\n    # Pad the shorter digit list with zeros to match the length of the longer list.\n    while len(digits1) < max_len:\n        digits1.append(0)\n    while len(digits2) < max_len:\n        digits2.append(0)\n\n    # Calculate the sum of the absolute differences between corresponding digits.\n    total_difference = 0\n    for i in range(max_len):\n        total_difference += abs(digits1[i] - digits2[i])\n\n    return total_difference"}
{"task_id": "Mbpp/562", "solution": "from typing import Sequence, Any\ndef Find_Max_Length(lists: Sequence[Sequence[Any]]) -> int:\n    \"\"\"Finds the length of the longest sublist in a list of lists.\n    Returns 0 if the input list is empty or contains only empty sublists.\"\"\"\n    return max((len(sublist) for sublist in lists), default=0)"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(nums: list[int], length: int) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist in the given list using Kadane's algorithm.\n    \"\"\"\n    if not nums: # Although design context implies this is handled elsewhere, the assertion\n                 # implies a self-contained function. For an empty list, the max sum is usually 0\n                 # or negative infinity, but problem implies valid input as per `nums[0]` access.\n                 # Given \"Do NOT add isinstance() checks or raise exceptions for edge cases\" I'll follow\n                 # the Kadane snippet which assumes non-empty list by accessing nums[0].\n        # If an empty list is truly an edge case not to handle, then the design context\n        # \"Preconditions: Input is a list of integers (non-empty).\" implies we can assume `nums` is non-empty.\n        # So I will follow the core Kadane logic directly.\n        pass # The instruction \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n             # means I should skip an explicit check for an empty list here if the design context\n             # also implies the input will be valid for the algorithm.\n\n    max_current = max_global = nums[0]\n    for x in nums[1:]:\n        max_current = max(x, max_current + x)\n        max_global = max(max_global, max_current)\n    return max_global"}
{"task_id": "Mbpp/563", "solution": "import re\nfrom typing import List, Optional, Pattern, Match\ndef _normalize_quotes(quotes: Optional[List[str]]) -> List[str]:\n    \"\"\"Helper to validate and normalize a list of quote characters.\n    Raises ValueError for invalid quote characters.\n    \"\"\"\n    if quotes is None:\n        return ['\"']\n\n    if not isinstance(quotes, list):\n        raise ValueError(\"Quotes must be a list of strings.\")\n\n    normalized = []\n    seen = set()\n    for q in quotes:\n        if not isinstance(q, str) or len(q) != 1:\n            raise ValueError(f\"Quote characters must be single-character strings, got: '{q}'\")\n        if q not in seen:\n            normalized.append(q)\n            seen.add(q)\n    if not normalized:\n        raise ValueError(\"No valid quote characters provided.\")\n    return normalized\ndef _unescape_text(s: str) -> str:\n    \"\"\"Unescapes common backslash escape sequences in a string like \\\" to \", \\\\ to \\.\"\"\"\n    def replacer(match):\n        char = match.group(1)\n        if char == '\"': return '\"'\n        if char == \"'\": return \"'\"\n        if char == '\\\\': return '\\\\'\n        if char == 'n': return '\\n'\n        if char == 't': return '\\t'\n        return '\\\\' + char # Keep unknown escape sequences as is.\n    \n    return re.sub(r'\\\\(.)', replacer, s)\nclass ExtractorConfig:\n    \"\"\"Configuration for the quote extraction process.\"\"\"\n    def __init__(self, quotes: Optional[List[str]] = None, allow_escapes: bool = True) -> None:\n        self.quotes = _normalize_quotes(quotes)\n        self.allow_escapes = allow_escapes\nclass RegexAdapter:\n    \"\"\"Builds and runs regex patterns for extracting quoted values.\"\"\"\n    def __init__(self, quotes: List[str], allow_escapes: bool = True) -> None:\n        self.quotes = quotes\n        self.allow_escapes = allow_escapes\n        self.pattern = self.build_pattern()\n\n    def build_pattern(self) -> Pattern:\n        \"\"\"Generates the regex pattern based on configured quotes and escape handling.\"\"\"\n        parts = []\n        for q in self.quotes:\n            q_esc = re.escape(q)\n            if self.allow_escapes:\n                inner = r'(?:\\\\' + q_esc + r'|\\\\.|[^\\\\' + q_esc + r'])*?'\n            else:\n                inner = r'[^' + q_esc + r']*?'\n            \n            parts.append(q_esc + '(' + inner + r')' + q_esc)\n        \n        pattern = '|'.join(parts)\n        return re.compile(pattern, re.DOTALL)\n\n    def find_all(self, text: str) -> List[re.Match]:\n        \"\"\"Finds all occurrences of quoted values in the text.\"\"\"\n        return list(self.pattern.finditer(text))\nclass QuoteExtractor:\n    \"\"\"Core service for extracting values between quotation marks.\"\"\"\n    def __init__(self, adapter: RegexAdapter) -> None:\n        self.adapter = adapter\n\n    def extract_values(self, text: str, config: Optional[ExtractorConfig] = None) -> List[str]:\n        \"\"\"Extracts all substrings enclosed by matching quote characters from an input string.\"\"\"\n        matches = self.adapter.find_all(text)\n        items = []\n        for m in matches:\n            for g in m.groups():\n                if g is not None:\n                    val = _unescape_text(g) if self.adapter.allow_escapes else g\n                    items.append(val)\n                    break\n        return items\ndef extract_values(s: str, quotes: Optional[List[str]] = None, allow_escapes: bool = True) -> List[str]:\n    \"\"\"Extracts values between quotation marks from a string.\"\"\"\n    config = ExtractorConfig(quotes=quotes, allow_escapes=allow_escapes)\n    adapter = RegexAdapter(config.quotes, config.allow_escapes)\n    extractor = QuoteExtractor(adapter)\n    return extractor.extract_values(s, config)"}
