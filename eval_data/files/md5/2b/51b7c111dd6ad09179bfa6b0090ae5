{"task_id": "Mbpp/614", "solution": "import collections.abc\nfrom typing import Any, Sequence, Iterator, Union, List\nNumber = Union[int, float]\nclass InvalidInputError(ValueError):\n    \"\"\"Domain exception for invalid input.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\nclass Validator:\n    \"\"\"Validates the shape and element types of input items.\"\"\"\n    def validate_items(self, items: Any) -> Sequence[Sequence[Number]]:\n        if isinstance(items, str):\n            raise InvalidInputError(\"Top-level items must not be a string; parse JSON first if applicable.\")\n        try:\n            iter(items)\n        except TypeError:\n            raise InvalidInputError(\"Top-level items must be an iterable of iterables.\")\n\n        validated: List[List[Number]] = []\n        for idx, inner in enumerate(items):\n            if isinstance(inner, str):\n                raise InvalidInputError(f\"Inner element at index {idx} must not be a string.\")\n            try:\n                iter(inner)\n            except TypeError:\n                raise InvalidInputError(f\"Inner element at index {idx} is not iterable.\")\n            \n            if isinstance(inner, collections.abc.Mapping):\n                 raise InvalidInputError(f\"Inner element at index {idx} is a dictionary, which is not supported.\")\n\n            row: List[Number] = []\n            for jdx, v in enumerate(inner):\n                if not self._is_number(v):\n                    raise InvalidInputError(f\"Non-numeric value at [{idx}][{jdx}]: {v!r}\")\n                row.append(v)\n            validated.append(row)\n        return validated\n\n    def _is_number(self, value: Any) -> bool:\n        \"\"\"Checks if a value is an int or float, but not a boolean.\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\nclass TupleCollection:\n    \"\"\"Encapsulates a collection of numeric sequences.\"\"\"\n    def __init__(self, items: Sequence[Sequence[Number]]) -> None:\n        self._items = items # Items are assumed to be already validated.\n\n    def __iter__(self) -> Iterator[Sequence[Number]]:\n        \"\"\"Iterate over inner sequences.\"\"\"\n        return iter(self._items)\n\n    def flattened(self) -> Iterator[Number]:\n        \"\"\"Yield each number from inner sequences.\"\"\"\n        for inner in self._items:\n            for v in inner:\n                yield v\n\n    def __len__(self) -> int:\n        \"\"\"Return the number of inner sequences.\"\"\"\n        return len(self._items)\nclass CumulativeSumService:\n    \"\"\"Computes the cumulative sum of numeric values from a validated collection.\"\"\"\n    def __init__(self, validator: Validator) -> None:\n        self.validator = validator\n\n    def compute(self, items: Sequence[Sequence[Any]]) -> Number:\n        \"\"\"Validates items and computes their cumulative sum.\"\"\"\n        validated = self.validator.validate_items(items)\n        tc = TupleCollection(validated)\n        return self._sum_iterable(tc.flattened())\n\n    def _sum_iterable(self, values: Iterator[Number]) -> Number:\n        \"\"\"Efficiently sums numeric values from an iterator.\"\"\"\n        return sum(values)\ndef cummulative_sum(items: Sequence[Sequence[int | float]]) -> int | float:\n    \"\"\"\n    Calculates the cumulative sum of all numbers in a list of tuples.\n    It expects a sequence of sequences containing only integers or floats.\n    \"\"\"\n    service = CumulativeSumService(Validator())\n    return service.compute(items)"}
{"task_id": "Mbpp/618", "solution": "from typing import List, Any, Sequence\ndef div_list(a: List[Any], b: List[Any]) -> List[float]:\n    \"\"\"\n    Performs element-wise division of two lists, handling validation and division by zero.\n    Returns a list of floats.\n    \"\"\"\n\n    class DivisionError(Exception):\n        \"\"\"Domain-specific error for division operations.\"\"\"\n        def __init__(self, message: str, code: int = None):\n            super().__init__(message)\n            self.message = message\n            self.code = code\n\n        def __str__(self):\n            return self.message\n\n    def _is_numeric(value: Any) -> bool:\n        \"\"\"Checks if a value is an integer or a float, excluding booleans.\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n    def _validate_numeric_sequence(seq: Sequence[Any], seq_name: str = \"sequence\") -> None:\n        \"\"\"Validates that all elements in a sequence are numeric.\"\"\"\n        for i, val in enumerate(seq):\n            if not _is_numeric(val):\n                raise DivisionError(f\"Non-numeric value found in {seq_name} at index {i}: {val}\", code=1001)\n\n    def _validate_lists_input(a_list: Sequence[Any], b_list: Sequence[Any]) -> None:\n        \"\"\"Validates lists for equal length and numeric elements.\"\"\"\n        if len(a_list) != len(b_list):\n            raise DivisionError(\"Lists must have the same length for element-wise division.\", code=1001)\n        _validate_numeric_sequence(a_list, \"first list\")\n        _validate_numeric_sequence(b_list, \"second list\")\n\n    def _safe_divide(num: float, den: float) -> float:\n        \"\"\"Performs division, raising DivisionError if the denominator is zero.\"\"\"\n        if den == 0.0:\n            raise DivisionError(\"Division by zero\", code=1002)\n        return float(num) / float(den)\n\n    _validate_lists_input(a, b)\n\n    results = []\n    for x, y in zip(a, b):\n        results.append(_safe_divide(float(x), float(y)))\n\n    return results"}
{"task_id": "Mbpp/620", "solution": "from typing import List\ndef largest_subset(nums: List[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of numbers where every pair is divisible.\n    This uses a dynamic programming approach after sorting the input numbers.\n    \"\"\"\n    if not nums:\n        return 0\n\n    # Sort the numbers in ascending order. This is crucial for the DP approach\n    # as it ensures that if a % b == 0, then b must appear before a in the sorted list.\n    sorted_nums = sorted(nums)\n    n = len(sorted_nums)\n\n    # dp[i] will store the length of the largest divisible subset ending with sorted_nums[i]\n    dp = [1] * n\n\n    # Iterate through each number to build up the dp array\n    for i in range(n):\n        # For each number, check all previous numbers\n        for j in range(i):\n            # If sorted_nums[i] is divisible by sorted_nums[j]\n            # it means sorted_nums[i] can extend the subset ending at sorted_nums[j]\n            if sorted_nums[i] % sorted_nums[j] == 0:\n                # Update dp[i] if we found a longer subset\n                dp[i] = max(dp[i], dp[j] + 1)\n    \n    # The maximum value in the dp array is the size of the largest divisible subset\n    return max(dp)"}
{"task_id": "Mbpp/619", "solution": "def move_num(s: str) -> str:\n    \"\"\"\n    Moves all ASCII numeric characters to the end of the string, preserving relative order.\n    Non-numeric characters maintain their relative order, followed by digits in their original relative order.\n    \"\"\"\n    letters = []\n    digits = []\n    for ch in s:\n        if '0' <= ch <= '9':\n            digits.append(ch)\n        else:\n            letters.append(ch)\n    return ''.join(letters) + ''.join(digits)"}
{"task_id": "Mbpp/622", "solution": "def get_median(a, b, n):\n    \"\"\"\n    Finds the median of two sorted lists of the same size n.\n    Uses an O(n) merge-based approach for small n, and an O(log n) divide-and-conquer approach for larger n.\n    \"\"\"\n    MERGE_FALLBACK_THRESHOLD = 32\n\n    def _find_kth_element(nums1, nums2, k):\n        # Helper to find the k-th smallest element (1-indexed) in two sorted arrays.\n        m, n_len = len(nums1), len(nums2)\n\n        # Ensure nums1 is the smaller array to simplify partitioning.\n        if m > n_len:\n            return _find_kth_element(nums2, nums1, k)\n\n        # Base cases\n        if m == 0:\n            return nums2[k - 1]\n        if k == 1:\n            return min(nums1[0], nums2[0])\n\n        # Divide k into two parts. Try to take k/2 elements from nums1 and k-k/2 from nums2.\n        # Ensure 'idx1' does not exceed the length of nums1.\n        idx1 = min(k // 2, m)\n        idx2 = k - idx1\n\n        # Compare elements at the split points to decide which half to discard.\n        if nums1[idx1 - 1] < nums2[idx2 - 1]:\n            # Discard nums1[0...idx1-1] and recurse.\n            return _find_kth_element(nums1[idx1:], nums2, k - idx1)\n        elif nums1[idx1 - 1] > nums2[idx2 - 1]:\n            # Discard nums2[0...idx2-1] and recurse.\n            return _find_kth_element(nums1, nums2[idx2:], k - idx2)\n        else:\n            # If elements are equal, this value is the k-th element.\n            return nums1[idx1 - 1]\n\n    def _median_two_sorted_arrays_merge_fallback(arr1, arr2):\n        # Helper for small n, merges arrays conceptually to find median in O(n) time.\n        current_n = len(arr1)  # This n is the length of each individual array\n        i = 0\n        j = 0\n        count = 0\n        m1 = 0.0  # Stores the (current_n)-th element of the merged array\n        m2 = 0.0  # Stores the (current_n+1)-th element of the merged array\n\n        # Iterate until we find the (current_n) and (current_n+1)-th elements (1-indexed).\n        # These correspond to indices current_n-1 and current_n (0-indexed).\n        while count <= current_n:\n            if i == current_n:\n                m1 = m2\n                m2 = arr2[j]\n                j += 1\n            elif j == current_n:\n                m1 = m2\n                m2 = arr1[i]\n                i += 1\n            elif arr1[i] <= arr2[j]:\n                m1 = m2\n                m2 = arr1[i]\n                i += 1\n            else:\n                m1 = m2\n                m2 = arr2[j]\n                j += 1\n            count += 1\n        return (m1 + m2) / 2.0\n\n    if n <= MERGE_FALLBACK_THRESHOLD:\n        return _median_two_sorted_arrays_merge_fallback(a, b)\n    else:\n        # For larger n, use the divide-and-conquer approach.\n        # We need the n-th and (n+1)-th elements (1-indexed) from the combined 2n elements.\n        element_n = _find_kth_element(a, b, n)\n        element_n_plus_1 = _find_kth_element(a, b, n + 1)\n        return (element_n + element_n_plus_1) / 2.0"}
{"task_id": "Mbpp/626", "solution": "def triangle_area(radius):\n    \"\"\"\n    Calculates the area of the largest triangle inscribed in a semicircle with a given radius.\n    Returns None if the radius is negative or not a valid number, otherwise returns the area as a float.\n    \"\"\"\n    if not isinstance(radius, (int, float)) or isinstance(radius, bool):\n        return None\n    \n    if radius < 0:\n        return None\n        \n    return float(radius ** 2)"}
