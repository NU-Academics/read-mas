{"task_id": "Mbpp/721", "solution": "def maxAverageOfPath(matrix: list[list[int]]) -> float:\n    \"\"\"\n    Calculates the maximum average cost of a path from the top-left to the bottom-right\n    of a square matrix, moving only right or down.\n    \"\"\"\n    n = len(matrix)\n    if n == 0:\n        return 0.0 # Or handle as per specific requirements, but for a non-empty N*N matrix, N >= 1\n\n    dp = [[0.0] * n for _ in range(n)]\n\n    # Initialize the top-left cell\n    dp[0][0] = float(matrix[0][0])\n\n    # Initialize the first row\n    for c in range(1, n):\n        dp[0][c] = dp[0][c-1] + float(matrix[0][c])\n\n    # Initialize the first column\n    for r in range(1, n):\n        dp[r][0] = dp[r-1][0] + float(matrix[r][0])\n\n    # Fill the rest of the DP table\n    for r in range(1, n):\n        for c in range(1, n):\n            dp[r][c] = max(dp[r-1][c], dp[r][c-1]) + float(matrix[r][c])\n\n    max_sum = dp[n-1][n-1]\n    path_length = 2 * n - 1 # All valid paths in an N*N matrix have this length\n\n    return max_sum / path_length"}
{"task_id": "Mbpp/725", "solution": "import re\nclass InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass ExtractorError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\ndef sanitize_input(text: object) -> str:\n    \"\"\"Ensures input is a string and raises an error for None or unsupported types.\"\"\"\n    if text is None:\n        raise InvalidInputError(\"Input text is None\")\n    if not isinstance(text, str):\n        raise InvalidInputError(\"Input must be a string\")\n    return text\ndef compile_quote_pattern(strict: bool = False):\n    \"\"\"Compiles a regex pattern to match quoted strings, handling escaped quotes.\"\"\"\n    pattern = r'\"((?:\\\\\\\\.|[^\"\\\\\\\\])*)\"'\n    return re.compile(pattern, re.DOTALL)\nclass QuotationResult:\n    def __init__(self, values: list[str]) -> None:\n        self._values = values\n        self.count = len(values)\n\n    @property\n    def values(self) -> list[str]:\n        return list(self._values)\n\n    def to_dict(self) -> dict:\n        return {\"values\": self.values, \"count\": self.count}\nclass RegexEngine:\n    def __init__(self, pattern: str | None = None) -> None:\n        self._pattern = re.compile(pattern) if pattern else compile_quote_pattern()\n\n    def find_all(self, text: str) -> list[str]:\n        matches = self._pattern.findall(text)\n        # Unescape \\\" -> \" and \\\\ -> \\\n        return [m.replace(r'\\\"', '\"').replace(r'\\\\', '\\\\') for m in matches]\nclass ExtractorService:\n    def __init__(self, engine) -> None:\n        self._engine = engine\n\n    def extract(self, text: str, strict: bool = False) -> QuotationResult:\n        \"\"\"Sanitizes input, extracts values using the engine, and returns a QuotationResult.\"\"\"\n        txt = sanitize_input(text)\n        try:\n            values = self._engine.find_all(txt)\n        except Exception as e:\n            raise ExtractorError(str(e))\n        return QuotationResult(values)\ndef extract_quotation(text: str) -> list[str]:\n    \"\"\"\n    Extracts values enclosed in double quotation marks from the given string.\n    Handles escaped double quotes within the extracted values.\n    \"\"\"\n    engine = RegexEngine()\n    svc = ExtractorService(engine)\n    result = svc.extract(text)\n    return result.values"}
{"task_id": "Mbpp/722", "solution": "def filter_data(students, min_height, min_weight):\n    \"\"\"Filters students based on minimum height and weight criteria.\"\"\"\n    filtered_students = {}\n    for name, (height, weight) in students.items():\n        if height >= min_height and weight >= min_weight:\n            filtered_students[name] = (height, weight)\n    return filtered_students"}
