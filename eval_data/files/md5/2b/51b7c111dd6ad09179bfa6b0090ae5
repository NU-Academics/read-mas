{"task_id": "Mbpp/448", "solution": "def cal_sum(n: int) -> int:\n    \"\"\"Calculates the sum of Perrin numbers from index 0 up to n, inclusive.\n    Uses an iterative approach with memoization for efficiency.\"\"\"\n    if n < 0:\n        return 0\n\n    perrin_numbers = [0] * (n + 1)\n    current_sum = 0\n\n    # Initialize base cases and add to sum\n    if n >= 0:\n        perrin_numbers[0] = 3\n        current_sum += 3\n    if n >= 1:\n        perrin_numbers[1] = 0\n        current_sum += 0\n    if n >= 2:\n        perrin_numbers[2] = 2\n        current_sum += 2\n\n    # Compute remaining Perrin numbers and their sum using the recurrence relation\n    for i in range(3, n + 1):\n        perrin_numbers[i] = perrin_numbers[i - 2] + perrin_numbers[i - 3]\n        current_sum += perrin_numbers[i]\n\n    return current_sum"}
{"task_id": "Mbpp/453", "solution": "import math\ndef sumofFactors(n: int) -> int:\n    \"\"\"Calculates the sum of positive even factors of a given integer n.\"\"\"\n    if n == 0:\n        return 0\n\n    abs_n = abs(n)\n    even_factors_sum = 0\n\n    # Iterate up to the square root of abs_n to find all divisors efficiently.\n    for i in range(1, int(math.isqrt(abs_n)) + 1):\n        if abs_n % i == 0:\n            if i % 2 == 0:\n                even_factors_sum += i\n            \n            complementary_divisor = abs_n // i\n            # Add the complementary divisor if it's even and different from i.\n            if complementary_divisor != i and complementary_divisor % 2 == 0:\n                even_factors_sum += complementary_divisor\n                \n    return even_factors_sum"}
