{"task_id": "Mbpp/141", "solution": "def pancake_sort(elements):\n    \"\"\"Sorts a list of elements using the pancake sort algorithm.\"\"\"\n    arr = list(elements)\n    n = len(arr)\n    \n    comparisons = 0\n    flips = 0\n\n    def _flip(current_arr, k):\n        \"\"\"Reverses the first k elements of the given array and increments the flip count.\"\"\"\n        nonlocal flips\n        current_arr[:k] = reversed(current_arr[:k])\n        flips += 1\n\n    def _find_max_index(current_arr, size_limit):\n        \"\"\"Finds the index of the maximum element in the first 'size_limit' elements and increments comparison count.\"\"\"\n        nonlocal comparisons\n        max_idx = 0\n        for i in range(1, size_limit):\n            comparisons += 1\n            if current_arr[i] > current_arr[max_idx]:\n                max_idx = i\n        return max_idx\n\n    for size in range(n, 1, -1):\n        max_idx = _find_max_index(arr, size)\n\n        if max_idx != size - 1:\n            if max_idx != 0:\n                _flip(arr, max_idx + 1)\n            _flip(arr, size)\n            \n    return arr"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(sequence: tuple) -> float:\n    \"\"\"\n    Finds the maximum difference between any two elements in a given numeric sequence.\n    This is equivalent to the difference between the maximum and minimum elements.\n    \"\"\"\n    it = iter(sequence)\n\n    # Initialize min_val and max_val with the first element.\n    # We assume the sequence has at least one element and all elements are numeric,\n    # as per the constraints to not raise exceptions for edge cases or invalid inputs.\n    first_element = float(next(it))\n    min_val = first_element\n    max_val = first_element\n\n    # Iterate through the rest of the sequence to find the true minimum and maximum.\n    for element in it:\n        f_element = float(element)\n        if f_element < min_val:\n            min_val = f_element\n        if f_element > max_val:\n            max_val = f_element\n\n    return max_val - min_val"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1: list[Any], list2: list[Any], list3: list[Any]) -> int:\n    \"\"\"\n    Counts the number of items that are identical in the same position across three lists.\n    The comparison proceeds up to the length of the shortest list provided.\n    \"\"\"\n    min_len = min(len(list1), len(list2), len(list3))\n    count = 0\n    for i in range(min_len):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(source: list, remove: list) -> list:\n    \"\"\"\n    Removes all elements from the source list that are present in the remove list.\n    Preserves the order of remaining elements.\n    \"\"\"\n    try:\n        # Attempt to convert the 'remove' list to a set for efficient O(1) average-time lookups.\n        # This path requires all elements in 'remove' to be hashable.\n        remove_set = set(remove)\n        return [item for item in source if item not in remove_set]\n    except TypeError:\n        # If 'remove' contains unhashable elements (e.g., lists, dicts), set conversion fails.\n        # Fallback to a linear O(N*M) comparison for each element, preserving order and functionality.\n        result = []\n        for item in source:\n            is_present = False\n            for r_item in remove:\n                if item == r_item:\n                    is_present = True\n                    break\n            if not is_present:\n                result.append(item)\n        return result"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series n + (n-2) + (n-4) + ...\n    including only terms strictly greater than zero.\n    \"\"\"\n    if n <= 0:\n        return 0\n\n    # Calculate the number of positive terms in the series.\n    # For n=6, terms are 6, 4, 2 (k=3). (6+1)//2 = 3.\n    # For n=7, terms are 7, 5, 3, 1 (k=4). (7+1)//2 = 4.\n    k = (n + 1) // 2\n\n    # Calculate the last positive term in the arithmetic progression.\n    # First term is n, common difference is -2. Last term = n + (k-1)*(-2).\n    last_term = n - 2 * (k - 1)\n\n    # Sum of an arithmetic series: k * (first_term + last_term) / 2\n    total_sum = k * (n + last_term) // 2\n\n    return total_sum"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple,\n    or returns None if no solution exists.\n    \"\"\"\n    # Handle the edge case where both a and b are zero\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    # Inline Extended Euclidean Algorithm helper.\n    # This function computes g = gcd(val_a, val_b) and coefficients s0, t0\n    # such that val_a*s0 + val_b*t0 = g.\n    # The input val_a and val_b are expected to be non-negative for this helper.\n    def _extended_gcd_for_positive(val_a: int, val_b: int) -> tuple[int, int, int]:\n        r0, r1 = val_a, val_b\n        s0, s1 = 1, 0\n        t0, t1 = 0, 1\n\n        while r1 != 0:\n            q = r0 // r1\n            r0, r1 = r1, r0 - q * r1\n            s0, s1 = s1, s0 - q * s1\n            t0, t1 = t1, t0 - q * t1\n        \n        return r0, s0, t0\n\n    # Calculate g = gcd(|a|, |b|) and corresponding Bezout coefficients for positive values\n    g, x_coeff_for_abs_a, y_coeff_for_abs_b = _extended_gcd_for_positive(abs(a), abs(b))\n\n    # If n is not divisible by g, no integer solution exists\n    if n % g != 0:\n        return None\n\n    # Adjust coefficients for the original signs of a and b.\n    # x0, y0 are coefficients such that a*x0 + b*y0 = g.\n    x0 = x_coeff_for_abs_a * (1 if a >= 0 else -1)\n    y0 = y_coeff_for_abs_b * (1 if b >= 0 else -1)\n    \n    # Scale the particular solution (x0, y0) by n/g to satisfy a*x + b*y = n\n    scale_factor = n // g\n    x_particular = x0 * scale_factor\n    y_particular = y0 * scale_factor\n\n    # Adjust the particular solution to find the canonical one (e.g., smallest non-negative x)\n    # This involves shifting by multiples of (b/g) for x and (a/g) for y.\n    a_prime = a // g\n    b_prime = b // g\n\n    if b_prime != 0:\n        # Calculate a new x, ensuring it's the smallest non-negative x\n        adjusted_x = x_particular % b_prime\n        if adjusted_x < 0: # Ensure positive remainder for consistent results\n             adjusted_x += b_prime \n        \n        # Calculate the corresponding k that was used to shift x\n        k = (x_particular - adjusted_x) // b_prime\n        \n        # Adjust y using the same k\n        adjusted_y = y_particular + k * a_prime\n    else: # If b_prime is 0 (meaning b=0), x is uniquely determined by a*x = n.\n          # y can be any integer, and our y_particular (which is 0) is a valid choice.\n        adjusted_x = x_particular\n        adjusted_y = y_particular\n\n    return (adjusted_x, adjusted_y)"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(text: str) -> int:\n    \"\"\"\n    Counts characters in a string that occur at the same position as in the English alphabet (case insensitive).\n    \"\"\"\n    \n    # Pre-compute the 1-based position for each lowercase English letter.\n    alphabet_map = {char: i + 1 for i, char in enumerate(\"abcdefghijklmnopqrstuvwxyz\")}\n\n    match_count = 0\n    # Iterate through the input string, considering each character's 1-based position.\n    for i, char in enumerate(text):\n        string_position = i + 1  # Current character's 1-based position in the string.\n        \n        # Get the 1-based alphabet position for the lowercase version of the character.\n        alphabet_position = alphabet_map.get(char.lower())\n        \n        # If the character is an English letter and its alphabet position matches its string position.\n        if alphabet_position is not None and alphabet_position == string_position:\n            match_count += 1\n            \n    return match_count"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(numbers: list) -> int:\n    \"\"\"\n    Counts the number of pairs of integers in a list that XOR to an even number.\n    This occurs when both numbers in the pair have the same parity (both even or both odd).\n    \"\"\"\n    even_count = 0\n    for x in numbers:\n        if x % 2 == 0:  # Check for even numbers\n            even_count += 1\n    \n    odd_count = len(numbers) - even_count\n    \n    # Calculate combinations for even pairs (C(n, 2) = n * (n - 1) / 2)\n    # And combinations for odd pairs\n    return (even_count * (even_count - 1) // 2) + (odd_count * (odd_count - 1) // 2)"}
{"task_id": "Mbpp/168", "solution": "def frequency(items, value):\n    \"\"\"Counts the number of occurrences of a value in a list.\"\"\"\n    count = 0\n    for item in items:\n        if item == value:\n            count += 1\n    return count"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"Finds the smallest power of 2 greater than or equal to n.\"\"\"\n    if n <= 0:\n        return 1\n    # If n is already a power of 2, return n\n    if (n & (n - 1)) == 0:\n        return n\n    # For other positive integers, use bit_length to find the next power of 2\n    return 1 << n.bit_length()"}
{"task_id": "Mbpp/170", "solution": "def sum_range_list(data: list[int|float], start: int, end: int) -> int|float:\n    \"\"\"Finds the sum of numbers in a list within a range specified by two indices.\"\"\"\n\n    class IndexValidator:\n        def normalize_indices(self, list_len: int, start: int, end: int) -> tuple[int, int]:\n            # Normalizes negative indices according to Python semantics.\n            s = start if start >= 0 else list_len + start\n            e = end if end >= 0 else list_len + end\n            return s, e\n\n    class ListRepository:\n        def get_slice(self, data: list[int|float], start: int, end: int) -> list[int|float]:\n            # Returns an inclusive slice from the list.\n            return data[start:end+1]\n\n    class SumService:\n        def __init__(self, repository: 'ListRepository', validator: 'IndexValidator') -> None:\n            self._repository = repository\n            self._validator = validator\n\n        def sum_range(self, data: list[int|float], start: int, end: int) -> int|float:\n            list_length = len(data)\n            norm_start, norm_end = self._validator.normalize_indices(list_length, start, end)\n            slice_list = self._repository.get_slice(data, norm_start, norm_end)\n            return sum(slice_list)\n\n    class SumRangeController:\n        def __init__(self, service: 'SumService') -> None:\n            self._service = service\n\n        def sum_range_list(self, data: list[int|float], start: int, end: int) -> int|float:\n            # Delegates to the service to calculate the sum.\n            return self._service.sum_range(data, start, end)\n\n    # Set up the dependency graph.\n    repo = ListRepository()\n    validator = IndexValidator()\n    service = SumService(repo, validator)\n    controller = SumRangeController(service)\n\n    return controller.sum_range_list(data, start, end)"}
