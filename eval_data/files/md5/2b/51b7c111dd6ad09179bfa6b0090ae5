lse:\n                current_min_price_in_heap = min_heap[0][0]\n                current_min_index_in_heap = min_heap[0][1]\n\n                if it.price > current_min_price_in_heap:\n                    heapq.heapreplace(min_heap, (it.price, it.index, it))\n                elif it.price == current_min_price_in_heap:\n                    if it.index < current_min_index_in_heap:\n                        heapq.heapreplace(min_heap, (it.price, it.index, it))\n\n        result_items = [entry[2] for entry in min_heap]\n        return sorted(result_items, key=lambda item: (-item.price, item.index))\ndef expensive_items(dataset: List[Dict[str, Any]], n: int) -> List[Dict[str, Any]]:\n    \"\"\"Finds the n most expensive items in a given dataset.\"\"\"\n    validated_dataset = validate_dataset(dataset)\n    repository = InMemoryItemRepository(validated_dataset)\n    service = ExpensiveItemService(repository)\n    \n    top_items = service.get_top_n(n)\n    \n    return [item.to_dict() for item in top_items]"}
