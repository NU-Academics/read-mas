{"task_id": "Mbpp/745", "solution": "from typing import List\nclass InvalidRangeError(Exception):\n    \"\"\"Custom exception for invalid range inputs.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\nclass RangeValidator:\n    \"\"\"Validates the start and end of a given range.\"\"\"\n    def validate(self, start: int, end: int) -> None:\n        \"\"\"Raises InvalidRangeError if the range is invalid.\"\"\"\n        if start > end:\n            raise InvalidRangeError(\"Start number must not be greater than end number.\")\nclass DigitUtils:\n    \"\"\"Utility methods for digit extraction and divisibility checks.\"\"\"\n    @staticmethod\n    def extract_digits(n: int) -> List[int]:\n        \"\"\"Extracts individual digits from an integer's absolute value.\"\"\"\n        s = str(abs(n))\n        return [int(ch) for ch in s]\n\n    @staticmethod\n    def contains_zero(digits: List[int]) -> bool:\n        \"\"\"Checks if the list of digits contains the digit zero.\"\"\"\n        return 0 in digits\n\n    @staticmethod\n    def divisible_by_all(n: int, digits: List[int]) -> bool:\n        \"\"\"Checks if a number is divisible by all its non-zero digits.\"\"\"\n        for digit in digits:\n            if digit == 0 or n % digit != 0:\n                return False\n        return True\nclass DivisibilityService:\n    \"\"\"Core business logic for finding numbers divisible by their digits.\"\"\"\n    def __init__(self) -> None:\n        \"\"\"Initializes the service with necessary validators and utilities.\"\"\"\n        self._validator = RangeValidator()\n        self._utils = DigitUtils()\n\n    def find_in_range(self, start: int, end: int) -> List[int]:\n        \"\"\"Finds numbers in a range where each is divisible by its digits.\"\"\"\n        self._validator.validate(start, end)\n        results = []\n        for n in range(start, end + 1):\n            if self._is_valid_number(n):\n                results.append(n)\n        return results\n\n    def _is_valid_number(self, n: int) -> bool:\n        \"\"\"Determines if a single number satisfies the divisibility rule.\"\"\"\n        if n == 0:\n            return False\n\n        digits = self._utils.extract_digits(n)\n\n        if self._utils.contains_zero(digits):\n            return False\n\n        return self._utils.divisible_by_all(n, digits)\ndef divisible_by_digits(start: int, end: int) -> List[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    Numbers containing the digit 0 are excluded.\n    \"\"\"\n    svc = DivisibilityService()\n    return svc.find_in_range(start, end)"}
{"task_id": "Mbpp/748", "solution": "import re\ndef capital_words_spaces(text):\n    \"\"\"Inserts spaces between words starting with capital letters and trims leading/trailing whitespace.\n    It applies two main rules to split camelCase/PascalCase and acronyms.\"\"\"\n    # Rule 1: Insert a space when a lowercase letter is followed by an uppercase letter\n    result = re.sub(r'(?<=[a-z])(?=[A-Z])', ' ', text, flags=re.UNICODE)\n    # Rule 2: Insert a space when an uppercase letter is followed by an uppercase letter then a lowercase letter (e.g., \"HTTPServer\" -> \"HTTP Server\")\n    result = re.sub(r'(?<=[A-Z])(?=[A-Z][a-z])', ' ', result, flags=re.UNICODE)\n    return result.strip()"}
