{"task_id": "Mbpp/801", "solution": "from typing import Any, Tuple\nclass ValidationError(Exception):\n    \"\"\"Exception raised when input validation fails.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass Validator:\n    \"\"\"Utility class for parsing and validating inputs.\"\"\"\n    @staticmethod\n    def parse_int(value: Any) -> int:\n        \"\"\"Converts a value to an integer, raising ValidationError if unsuccessful.\"\"\"\n        try:\n            return int(value)\n        except (ValueError, TypeError):\n            raise ValidationError(f\"Invalid integer value: {value!r}\")\nclass InputTriple:\n    \"\"\"Represents an immutable triple of integers.\"\"\"\n    def __init__(self, a: int, b: int, c: int) -> None:\n        self._a = a\n        self._b = b\n        self._c = c\n\n    def as_tuple(self) -> Tuple[int, int, int]:\n        \"\"\"Returns the stored values as a tuple.\"\"\"\n        return (self._a, self._b, self._c)\nclass EqualityService:\n    \"\"\"Provides the core business logic to count equal numbers.\"\"\"\n    def count_equal(self, triple: InputTriple) -> int:\n        \"\"\"Counts how many numbers in the triple are equal.\"\"\"\n        values = triple.as_tuple()\n        return self._count_by_frequency(values)\n\n    def _count_by_frequency(self, values: Tuple[int,int,int]) -> int:\n        \"\"\"Helper to determine equality count based on frequency.\"\"\"\n        freq = {}\n        for v in values:\n            freq[v] = freq.get(v, 0) + 1\n        if 3 in freq.values():\n            return 3\n        if 2 in freq.values():\n            return 2\n        return 0\ndef test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"\n    Counts the number of equal numbers from three given integers.\n    Returns 3 if all are equal, 2 if exactly two are equal, and 0 if all are different.\n    \"\"\"\n    va = Validator.parse_int(a)\n    vb = Validator.parse_int(b)\n    vc = Validator.parse_int(c)\n    \n    triple = InputTriple(va, vb, vc)\n    svc = EqualityService()\n    return svc.count_equal(triple)"}
{"task_id": "Mbpp/797", "solution": "def sum_in_range(l, r):\n    \"\"\"\n    Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n    Natural numbers are considered to be integers >= 1.\n    \"\"\"\n\n    def _get_first_odd_natural_in_range(lower_bound: int) -> int:\n        \"\"\"Finds the first odd natural number greater than or equal to lower_bound.\"\"\"\n        effective_lower_bound = max(1, lower_bound)\n        return effective_lower_bound if (effective_lower_bound % 2 != 0) else effective_lower_bound + 1\n\n    def _get_last_odd_in_range(upper_bound: int) -> int:\n        \"\"\"Finds the last odd number less than or equal to upper_bound.\"\"\"\n        return upper_bound if (upper_bound % 2 != 0) else upper_bound - 1\n\n    def _sum_arithmetic_series(first: int, last: int, step: int) -> int:\n        \"\"\"Calculates the sum of an arithmetic series.\"\"\"\n        if first > last:\n            return 0\n        n = ((last - first) // step) + 1\n        return n * (first + last) // 2\n\n    first_odd_num = _get_first_odd_natural_in_range(l)\n    last_odd_num = _get_last_odd_in_range(r)\n\n    return _sum_arithmetic_series(first_odd_num, last_odd_num, 2)"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(value, d):\n    \"\"\"\n    Performs a 32-bit left bit-rotation on the given value by d bits.\n    The rotation is done within a 32-bit word, ensuring the result stays within the 32-bit range.\n    \"\"\"\n    WORD_SIZE = 32\n    BITMASK = (1 << WORD_SIZE) - 1\n\n    d_normalized = d % WORD_SIZE\n\n    # If rotation is 0 or a multiple of WORD_SIZE, the value remains unchanged.\n    if d_normalized == 0:\n        return value & BITMASK\n\n    # Perform the left shift and mask to keep it within WORD_SIZE bits.\n    left_part = (value << d_normalized) & BITMASK\n\n    # Perform the right shift for the bits that wrap around, and mask them.\n    right_part = (value >> (WORD_SIZE - d_normalized)) & ((1 << d_normalized) - 1)\n\n    # Combine the shifted parts and ensure the final result is 32-bit.\n    return (left_part | right_part) & BITMASK"}
{"task_id": "Mbpp/803", "solution": "def is_perfect_square(n: int) -> bool:\n    \"\"\"\n    Checks if the given number is a perfect square.\n    Negative numbers are not considered perfect squares.\n    \"\"\"\n    if n < 0:\n        return False\n\n    # Use math.isqrt for efficiency if available (Python 3.8+), otherwise fall back to binary search.\n    try:\n        from math import isqrt\n        k = isqrt(n)\n    except (ImportError, AttributeError):\n        # Fallback: binary search to find floor(sqrt(n))\n        lo, hi = 0, n\n        if n == 0:\n            hi = 0 # special case for n=0 to ensure hi is not 1 when n=0\n        elif n == 1:\n            hi = 1\n        else: # For n > 1, start with a reasonable upper bound\n            hi = n // 2 + 1 # A tighter upper bound than 'n' for large n\n\n        # Adjust hi if it's less than lo (e.g., for small n where n//2+1 is 0 or 1)\n        # The range for hi is actually floor(sqrt(n)) or higher\n        # A simpler robust hi for all n >= 0 is simply 'n' (or n if n>1 else 1 for n=0,1)\n        # Using n itself as hi is perfectly valid, though less optimized for huge n\n        if n >= 1:\n            hi = n\n        else: # n == 0\n            hi = 1 # Ensures the loop runs for 0\n        \n        # A more robust and commonly used initial hi for binary search for sqrt\n        # For n=0, sqrt(0)=0. For n=1, sqrt(1)=1. For n>1, sqrt(n) <= n/2.\n        # So hi can be min(n, a reasonably large constant like 2**30 for typical ints, or just n for arbitrary int size)\n        # The design context gives `lo, hi = 0, n if n >= 1 else 1` which is fine.\n        lo, hi = 0, n if n >= 1 else 1\n\n        k = 0 # Initialize k in case loop doesn't run (e.g., n=0, hi=0 if not adjusted)\n        while lo <= hi:\n            mid = (lo + hi) // 2\n            # Avoid overflow for mid*mid if mid is very large; Python handles large ints automatically.\n            sq = mid * mid\n            if sq == n:\n                k = mid\n                break\n            if sq < n:\n                lo = mid + 1\n            else: # sq > n\n                hi = mid - 1\n        else: # Loop finished without break, meaning n is not a perfect square, k should be hi\n            k = hi # `hi` will be floor(sqrt(n)) here\n\n    return k * k == n"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(lists):\n    \"\"\"\n    Returns the list in a list of lists whose sum of elements is the highest.\n    Returns an empty list if the input list is empty.\n    \"\"\"\n    if not lists:\n        return []\n\n    # Find the inner list with the highest sum using the built-in max function.\n    # In case of ties, the first list encountered with the maximum sum is returned.\n    return max(lists, key=sum)"}
{"task_id": "Mbpp/804", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception for validation errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nDEFAULT_EMPTY_PRODUCT = 1\nclass MathUtils:\n    \"\"\"Utility methods for mathematical operations, especially parity checks.\"\"\"\n    @staticmethod\n    def is_even_number(n: int) -> bool:\n        \"\"\"Checks if an integer is even.\"\"\"\n        return (n & 1) == 0\n\n    @staticmethod\n    def is_product_even_iter(numbers: \"Iterable[int]\") -> bool:\n        \"\"\"Efficiently checks if the product of numbers is even by early exit.\"\"\"\n        for num in numbers:\n            if MathUtils.is_even_number(num):\n                return True\n        return False\n\n    @staticmethod\n    def safe_cast_to_int(value: \"float|int\") -> int:\n        \"\"\"Casts a numeric value to an integer, raising an error for non-integral floats.\"\"\"\n        if isinstance(value, int):\n            return value\n        if isinstance(value, float) and value.is_integer():\n            return int(value)\n        raise ValidationError(\"Non-integer numeric value\")\nclass NumberList:\n    \"\"\"Wraps an input sequence of numbers, validates them, and provides them as integers.\"\"\"\n    def __init__(self, numbers: \"Sequence[float|int]\"):\n        self._numbers_raw = list(numbers)\n        self._numbers_int: \"list[int] | None\" = None\n\n    def validate(self) -> None:\n        \"\"\"Validates that all raw numbers are integers or integral floats.\"\"\"\n        if not isinstance(self._numbers_raw, list):\n            raise ValidationError(\"Input must be a list or sequence.\")\n        \n        ints: list[int] = []\n        for v in self._numbers_raw:\n            try:\n                ints.append(MathUtils.safe_cast_to_int(v))\n            except ValidationError as e:\n                raise ValidationError(f\"Invalid numeric value found: {v}. {e.message}\")\n        self._numbers_int = ints\n\n    def as_ints(self) -> list[int]:\n        \"\"\"Returns the validated list of integers, performing validation if not already done.\"\"\"\n        if self._numbers_int is None:\n            self.validate()\n        # Mypy expects _numbers_int to be list[int] at this point, but it's initially None\n        # The validate() call ensures it's set.\n        return self._numbers_int # type: ignore\ndef is_product_even(numbers: \"Sequence[float|int]\") -> bool:\n    \"\"\"Checks whether the product of numbers in a list is even.\"\"\"\n    nl = NumberList(numbers)\n    ints = nl.as_ints()\n    \n    if len(ints) == 0:\n        return (DEFAULT_EMPTY_PRODUCT % 2) == 0\n    \n    return MathUtils.is_product_even_iter(ints)"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(text: str) -> int:\n    \"\"\"\n    Finds the maximum consecutive run of uppercase characters in the given string.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in text:\n        if char.isupper():\n            current_run += 1\n            if current_run > max_run:\n                max_run = current_run\n        else:\n            current_run = 0\n    return max_run"}
