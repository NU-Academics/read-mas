{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"Calculates the last decimal digit of n! (n factorial).\n    For n values greater than or equal to 10, the last digit is always 0.\n    \"\"\"\n    if n >= 10:\n        return 0\n\n    # Calculate n! % 10 for n from 0 to 9.\n    # The loop handles n=0 correctly by not running and returning initial product of 1.\n    product = 1\n    for i in range(1, n + 1):\n        product = (product * i) % 10\n    return product"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(list1, list2):\n    \"\"\"\n    Checks if list2 is a contiguous sublist of list1.\n    \"\"\"\n    if not list2:\n        return True\n\n    n = len(list1)\n    m = len(list2)\n\n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        if list1[i : i + m] == list2:\n            return True\n    return False"}
{"task_id": "Mbpp/580", "solution": "from typing import Any, List, Tuple\ndef is_even(value: int) -> bool:\n    \"\"\"Checks if an integer value is even.\"\"\"\n    return value % 2 == 0\nclass ExtractEvenService:\n    \"\"\"Service to recursively remove odd integers from nested tuples.\"\"\"\n\n    def __init__(self, preserve_empty_tuples: bool = False) -> None:\n        self._preserve_empty_tuples = preserve_empty_tuples\n\n    def extract_even(self, data: Tuple[Any, ...]) -> Tuple[Any, ...]:\n        processed = self._process_tuple(data)\n        return tuple(processed)\n\n    def _process_tuple(self, tup: Tuple[Any, ...]) -> List[Any]:\n        result: List[Any] = []\n        for elem in tup:\n            if isinstance(elem, int):\n                if is_even(elem):\n                    result.append(elem)\n            elif isinstance(elem, tuple):\n                child = self._process_tuple(elem)\n                if child or self._preserve_empty_tuples:\n                    result.append(tuple(child))\n            # Non-integer, non-tuple elements are ignored as per design.\n        return result\ndef extract_even(data: Tuple[Any, ...], preserve_empty_tuples: bool = False) -> Tuple[Any, ...]:\n    \"\"\"\n    Recursively removes odd integer elements from a nested tuple.\n    Non-integer, non-tuple elements are ignored; empty nested tuples are removed unless specified.\n    \"\"\"\n    svc = ExtractEvenService(preserve_empty_tuples=preserve_empty_tuples)\n    return svc.extract_even(data)"}
