{"task_id": "Mbpp/3", "solution": "def is_not_prime(n: int) -> bool:\n    \"\"\"\n    Identifies if a given integer is a non-prime number.\n    Returns True for composite numbers and False for prime numbers.\n    \"\"\"\n    if n in (2, 3):\n        return False  # 2 and 3 are prime, so not non-prime\n    if n % 2 == 0 or n % 3 == 0:\n        return True  # Even numbers (except 2) and multiples of 3 (except 3) are non-prime\n    \n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return True  # Found a divisor, so n is non-prime\n        i += 6\n    \n    return False  # No divisors found, so n is prime, thus not non-prime"}
{"task_id": "Mbpp/7", "solution": "import re\nfrom typing import List, Optional\nclass InMemoryRepository:\n    \"\"\"A simple in-memory store for results.\"\"\"\n    def __init__(self):\n        self._storage: List[List[str]] = []\n\n    def save(self, results: List[str]) -> None:\n        \"\"\"Saves a list of results to the internal storage.\"\"\"\n        self._storage.append(list(results))\n\n    def get_all(self) -> List[List[str]]:\n        \"\"\"Retrieves all stored result lists.\"\"\"\n        return list(self._storage)\nclass Tokenizer:\n    \"\"\"Tokenizes input text into words using a regular expression.\"\"\"\n    WORD_RE = re.compile(r\"[0-9A-Za-z\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff']+\")\n\n    def tokenize(self, text: str) -> List[str]:\n        \"\"\"Returns a list of word tokens from the given text.\"\"\"\n        return self.WORD_RE.findall(text)\nclass WordFilter:\n    \"\"\"Filters lists of words based on specified criteria.\"\"\"\n    def _normalize(self, word: str) -> str:\n        \"\"\"Internal method for word normalization.\"\"\"\n        return word\n\n    def filter_min_length(self, words: List[str], min_len: int) -> List[str]:\n        \"\"\"Filters words to include only those at least 'min_len' characters long.\"\"\"\n        return [self._normalize(w) for w in words if len(self._normalize(w)) >= min_len]\nclass WordService:\n    \"\"\"Orchestrates word tokenization and filtering.\"\"\"\n    def __init__(self, tokenizer: Tokenizer, word_filter: WordFilter, repository: Optional[InMemoryRepository]=None):\n        self.tokenizer = tokenizer\n        self.word_filter = word_filter\n        self.repository = repository\n\n    def find_char_long(self, text: str, min_len: int = 4) -> List[str]:\n        \"\"\"Finds words in text that are at least min_len characters long.\"\"\"\n        tokens = self.tokenizer.tokenize(text)\n        results = self.word_filter.filter_min_length(tokens, min_len)\n        if self.repository:\n            self.repository.save(results)\n        return results\nDEFAULT_MIN_LEN: int = 4\n_default_service = WordService(Tokenizer(), WordFilter(), InMemoryRepository())\ndef find_char_long(text: str, min_len: int = DEFAULT_MIN_LEN) -> list:\n    \"\"\"\n    Finds all words which are at least `min_len` characters long in a string.\n    \"\"\"\n    return _default_service.find_char_long(text, min_len)"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(a, b):\n    \"\"\"\n    Checks if two integers differ at exactly one bit position.\n    This is true if their XOR sum is a power of two (and not zero).\n    \"\"\"\n    xor_result = a ^ b\n    # A number is a power of two (and greater than zero) if it has exactly one bit set.\n    # The trick `n & (n - 1)` clears the least significant set bit.\n    # If `n` has only one bit set, `n - 1` will have all bits to its right set and the bit itself cleared.\n    # So `n & (n - 1)` will be 0 if `n` was a power of two.\n    # We also need to ensure `xor_result` is not zero, as 0 is not considered a power of two in this context.\n    return xor_result != 0 and (xor_result & (xor_result - 1)) == 0"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(first, second):\n    \"\"\"\n    Finds the shared elements from two iterables, preserving order from the first iterable and ensuring uniqueness.\n    It uses an efficient set-based approach for hashable items and falls back to a nested-loop comparison for unhashable items.\n    \"\"\"\n    first_list = list(first)\n    second_list = list(second)\n\n    try:\n        # Attempt the fast path for hashable elements using sets\n        second_set = set(second_list)\n        \n        result = []\n        seen = set()\n        for item in first_list:\n            if item in second_set and item not in seen:\n                result.append(item)\n                seen.add(item)\n        return result\n    except TypeError:\n        # Fallback for unhashable elements if TypeError occurs (e.g., list of lists)\n        result = []\n        for a in first_list:\n            found_in_second = False\n            for b in second_list:\n                if a == b:\n                    found_in_second = True\n                    break\n            \n            # Add to result if found in second_list and not already added (maintains uniqueness and order)\n            if found_in_second and a not in result:\n                result.append(a)\n        return result"}
