{"task_id": "Mbpp/630", "solution": "def get_coordinates(coord: tuple) -> list:\n    \"\"\"\n    Extracts all 3x3 adjacent coordinates of the given coordinate tuple, including the center.\n    Coordinates are returned in row-major order.\n    \"\"\"\n    x, y = coord\n    adjacent_coords = []\n    for dx in (-1, 0, 1):\n        for dy in (-1, 0, 1):\n            adjacent_coords.append([x + dx, y + dy])\n    return adjacent_coords"}
{"task_id": "Mbpp/631", "solution": "import re\ndef replace_spaces(text: str) -> str:\n    \"\"\"\n    Replaces whitespaces with an underscore and vice versa in a given string.\n    It prioritizes replacing whitespaces with underscores if whitespaces are present.\n    \"\"\"\n    has_whitespace = bool(re.search(r'\\s', text))\n    has_underscore = '_' in text\n\n    if has_whitespace and not has_underscore:\n        # String contains whitespace but no underscores, replace whitespace with underscores\n        return re.sub(r'\\s', '_', text)\n    elif has_underscore and not has_whitespace:\n        # String contains underscores but no whitespace, replace underscores with spaces\n        return text.replace('_', ' ')\n    elif has_whitespace and has_underscore:\n        # Both whitespace and underscores are present, prioritize replacing whitespaces with underscores\n        return re.sub(r'\\s', '_', text)\n    else:\n        # No significant characters to replace, return original string\n        return text"}
{"task_id": "Mbpp/629", "solution": "def Split(numbers: list[int]) -> list[int]:\n    \"\"\"Extracts all even numbers from a list of integers, preserving order.\"\"\"\n    even_numbers = []\n    for number in numbers:\n        if number % 2 == 0:\n            even_numbers.append(number)\n    return even_numbers"}
{"task_id": "Mbpp/632", "solution": "def move_zero(nums: list) -> list:\n    \"\"\"Moves all zeroes to the end of the list while preserving the relative order of non-zero elements.\n    It returns a new list without modifying the original.\"\"\"\n    arr = nums.copy()\n    write = 0\n    for read in range(len(arr)):\n        if arr[read] != 0:\n            arr[write] = arr[read]\n            write += 1\n    for i in range(write, len(arr)):\n        arr[i] = 0\n    return arr"}
