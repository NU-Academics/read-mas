{"task_id": "Mbpp/273", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for invalid input shapes or types.\"\"\"\n    pass\nclass SubtractionError(Exception):\n    \"\"\"Exception raised for unexpected runtime errors during subtraction.\"\"\"\n    pass\nclass TupleOperands:\n    \"\"\"DTO representing validated tuples for subtraction.\"\"\"\n    def __init__(self, a: tuple, b: tuple) -> None:\n        self.a = a\n        self.b = b\nclass TupleValidator:\n    \"\"\"Validates raw inputs and builds TupleOperands.\"\"\"\n    MIN_LENGTH = 1\n\n    @staticmethod\n    def validate_and_build(a: any, b: any) -> TupleOperands:\n        \"\"\"Ensures inputs are valid tuples of numbers and returns TupleOperands.\"\"\"\n        a_t = TupleValidator._ensure_tuple(a, \"a\")\n        b_t = TupleValidator._ensure_tuple(b, \"b\")\n\n        if len(a_t) != len(b_t):\n            raise ValidationError(\"Tuples must be same length\")\n        if len(a_t) < TupleValidator.MIN_LENGTH:\n            raise ValidationError(\"Tuples must not be empty\")\n\n        return TupleOperands(a=tuple(a_t), b=tuple(b_t))\n\n    @staticmethod\n    def _ensure_tuple(obj: any, name: str) -> tuple:\n        \"\"\"Helper to convert an object to a tuple of floats, validating elements.\"\"\"\n        if not isinstance(obj, (tuple, list)):\n            raise ValidationError(f\"{name} must be a tuple or list\")\n        \n        vals = []\n        for i, v in enumerate(obj):\n            try:\n                # Accept int or float directly, attempt to convert other numeric types\n                if isinstance(v, (int, float)):\n                    vals.append(float(v))\n                else:\n                    raise ValidationError(f\"Element {i} in {name} is not numeric\")\n            except (TypeError, ValueError):\n                raise ValidationError(f\"Element {i} in {name} is not numeric\")\n        return tuple(vals)\nclass TupleSubtractorService:\n    \"\"\"Performs element-wise subtraction on validated TupleOperands.\"\"\"\n    def subtract(self, operands: TupleOperands) -> tuple:\n        \"\"\"Subtracts elements of the second tuple from the first, returning a new tuple.\"\"\"\n        try:\n            result = tuple(self._subtract_element(x, y) for x, y in zip(operands.a, operands.b))\n            # Convert to int where values are integral for cleaner output\n            normalized = tuple(int(v) if v.is_integer() else v for v in result)\n            return normalized\n        except Exception as exc:\n            raise SubtractionError(\"Error during subtraction\") from exc\n\n    def _subtract_element(self, x: float, y: float) -> float:\n        \"\"\"Performs subtraction for a single pair of numbers.\"\"\"\n        return x - y\ndef substract_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Subtracts elements of the second tuple from the first tuple element-wise.\n    Input tuples must be of the same length and contain numeric elements (int or float).\n    \"\"\"\n    operands = TupleValidator.validate_and_build(a, b)\n    service = TupleSubtractorService()\n    return service.subtract(operands)"}
