{"task_id": "Mbpp/410", "solution": "from typing import Iterable, Any, Optional, Iterator\nimport math\nfrom decimal import Decimal\ndef min_val(values: Iterable[Any]) -> float:\n    \"\"\"\n    Finds the minimum numeric value in a heterogeneous list.\n    Non-numeric values are skipped, and numeric strings are converted.\n    \"\"\"\n\n    class MinFinderError(Exception):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class NoNumericValueError(MinFinderError):\n        def __init__(self, message: str = \"No numeric values found\") -> None:\n            super().__init__(message)\n\n    class InvalidInputError(MinFinderError):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n\n    DEFAULT_ALLOW_BOOL_AS_INT: bool = False\n    NUMERIC_TYPES = (int, float, Decimal)\n\n    def _to_number_inline(value: Any, allow_bool: bool) -> Optional[float]:\n        \"\"\"Attempts to coerce a value to a float, returning None if not possible or if NaN.\"\"\"\n        if isinstance(value, bool) and not allow_bool:\n            return None\n        if isinstance(value, NUMERIC_TYPES):\n            if isinstance(value, float) and math.isnan(value):\n                return None\n            return float(value)\n        if isinstance(value, str):\n            s = value.strip()\n            try:\n                v = float(s)\n                if math.isnan(v):\n                    return None\n                return v\n            except ValueError:\n                return None\n        return None\n\n    def _iter_numeric_stream(iterable_values: Iterable[Any], allow_bool_flag: bool) -> Iterator[float]:\n        \"\"\"Generates numeric floats from an iterable after coercion.\"\"\"\n        try:\n            _ = iter(iterable_values)\n        except TypeError as e:\n            raise InvalidInputError(\"Provided values is not iterable\") from e\n            \n        for val in iterable_values:\n            num = _to_number_inline(val, allow_bool=allow_bool_flag)\n            if num is not None:\n                yield num\n\n    numeric_gen = _iter_numeric_stream(values, DEFAULT_ALLOW_BOOL_AS_INT)\n\n    try:\n        min_val_found = next(numeric_gen)\n    except StopIteration:\n        raise NoNumericValueError(\"No numeric values found\")\n\n    for n in numeric_gen:\n        if n < min_val_found:\n            min_val_found = n\n\n    return min_val_found"}
{"task_id": "Mbpp/415", "solution": "def max_Product(arr: List[int]) -> Tuple[int, int]:\n    \"\"\"\n    Finds a pair of integers from the input array with the highest product.\n    The returned tuple contains the pair in ascending order.\n    \"\"\"\n    # Initialize variables to track the two largest and two smallest numbers found.\n    # Using float('inf') to handle any integer range.\n    max1 = max2 = -float('inf')\n    min1 = min2 = float('inf')\n\n    for x in arr:\n        # Update the two largest numbers\n        if x > max1:\n            max2 = max1\n            max1 = x\n        elif x > max2:\n            max2 = x\n\n        # Update the two smallest numbers\n        if x < min1:\n            min2 = min1\n            min1 = x\n        elif x < min2:\n            min2 = x\n\n    # The maximum product will be either the product of the two largest positives\n    # or the product of the two smallest negatives.\n    product_of_two_largest = max1 * max2\n    product_of_two_smallest = min1 * min2\n\n    # Determine which pair gives the overall highest product.\n    if product_of_two_smallest > product_of_two_largest:\n        result_a, result_b = min1, min2\n    else:\n        result_a, result_b = max1, max2\n\n    # Return the pair sorted in ascending order.\n    return tuple(sorted((result_a, result_b)))"}
{"task_id": "Mbpp/414", "solution": "def _is_hashable(x: object) -> bool:\n    \"\"\"Helper to check if an object is hashable.\"\"\"\n    try:\n        hash(x)\n        return True\n    except TypeError:\n        return False\ndef overlapping(a: object, b: object) -> bool:\n    \"\"\"\n    Checks if any value in sequence 'a' exists in sequence 'b'.\n\n    Returns True if at least one common element is found, False otherwise.\n    \"\"\"\n    list_a = list(a)\n    list_b = list(b)\n\n    # Attempt efficient set-based intersection if all elements are hashable and lists are not empty\n    if list_a and list_b and all(_is_hashable(x) for x in list_a) and all(_is_hashable(x) for x in list_b):\n        set_a = set(list_a)\n        set_b = set(list_b)\n        return not set_a.isdisjoint(set_b)\n    else:\n        # Fallback to O(n*m) equality checks for unhashable elements or empty lists\n        for x in list_a:\n            for y in list_b:\n                if x == y:\n                    return True\n        return False"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n: int) -> int:\n    \"\"\"Calculates the cube sum of the first n even natural numbers using an O(1) formula.\"\"\"\n    if n == 0:\n        return 0\n    # The sum of cubes of first n even natural numbers (2k)^3 is 2 * n^2 * (n+1)^2\n    return 2 * (n ** 2) * ((n + 1) ** 2)"}
{"task_id": "Mbpp/419", "solution": "import sys\nfrom typing import List, Iterable, Dict, Any, Optional, TextIO\nimport datetime\nimport json\nimport os\nimport uuid\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass CalculationError(Exception):\n    \"\"\"Exception raised for unexpected errors during calculation.\"\"\"\n    def __init__(self, message: str, cause: Optional[Exception] = None) -> None:\n        super().__init__(message)\n        self.cause = cause\ndef safe_round(value: float) -> int:\n    \"\"\"Rounds a float to the nearest integer using Python's built-in round semantics.\"\"\"\n    return int(round(value))\nclass Validator:\n    \"\"\"Handles validation of numeric inputs and parsing of CLI tokens.\"\"\"\n    def validate_numbers(self, numbers: Iterable[float]) -> None:\n        \"\"\"Validates that the input is a non-empty iterable of numeric values.\"\"\"\n        nums = list(numbers)\n        if not nums:\n            raise InvalidInputError(\"Input must be a non-empty iterable of numbers.\")\n        for i, v in enumerate(nums):\n            if not isinstance(v, (int, float)):\n                raise InvalidInputError(f\"Element at index {i} is not numeric: {v!r}\")\n\n    def parse_cli_numbers(self, tokens: Iterable[str]) -> List[float]:\n        \"\"\"Parses an iterable of string tokens into a list of floats.\"\"\"\n        result = []\n        for token in tokens:\n            for part in token.replace(\",\", \" \").split():\n                if part == \"\":\n                    continue\n                try:\n                    result.append(float(part))\n                except ValueError as e:\n                    raise InvalidInputError(f\"Cannot parse token to float: {part}\") from e\n        if not result:\n            raise InvalidInputError(\"No numeric tokens found.\")\n        return result\nclass RoundAndSumService:\n    \"\"\"Implements the core logic for rounding, summing, and multiplying numbers.\"\"\"\n    def __init__(self, validator: Validator) -> None:\n        self.validator = validator\n\n    def compute(self, numbers: List[float]) -> int:\n        \"\"\"Validates the input, rounds numbers, sums them, and multiplies by the count.\"\"\"\n        try:\n            self.validator.validate_numbers(numbers)\n            rounded = self._round_list(numbers)\n            total = sum(rounded)\n            return int(total * len(rounded))\n        except InvalidInputError:\n            raise\n        except Exception as exc:\n            raise CalculationError(\"Unexpected error during computation\", cause=exc) from exc\n\n    def _round_list(self, numbers: List[float]) -> List[int]:\n        \"\"\"Applies safe_round to each number in the list.\"\"\"\n        return [safe_round(x) for x in numbers]\ndef round_and_sum(numbers: list) -> int:\n    \"\"\"\n    Rounds every number in a given list of numbers, sums the rounded values,\n    and returns the total sum multiplied by the length of the list.\n    \"\"\"\n    validator = Validator()\n    svc = RoundAndSumService(validator)\n    return svc.compute(numbers)"}
{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n):\n    # Calculate the sum of cubes using the closed-form formula: (n*(n+1)/2)^2\n    sum_of_cubes = (n * (n + 1) // 2) ** 2\n    # The average is the sum divided by n\n    average = sum_of_cubes / float(n)\n    return average"}
