{"task_id": "Mbpp/127", "solution": "from typing import Any, Tuple, Dict\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input values during validation.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\n\n    def __str__(self) -> str:\n        return self.message\nclass MultiplicationResult:\n    \"\"\"Data transfer object holding the two operands and their product.\"\"\"\n    def __init__(self, a: int, b: int, product: int) -> None:\n        self.a = a\n        self.b = b\n        self.product = product\n\n    def to_dict(self) -> Dict[str, int]:\n        return {\"a\": self.a, \"b\": self.b, \"product\": self.product}\nclass InputValidator:\n    \"\"\"Validates inputs, ensuring they are integers and within acceptable bounds.\"\"\"\n    def __init__(self, max_abs: int = 10**12):\n        self.MAX_ABS_VALUE = max_abs\n\n    def ensure_int(self, value: Any, name: str = \"value\") -> int:\n        if isinstance(value, int):\n            val = value\n        elif isinstance(value, str):\n            try:\n                val = int(value, 10)\n            except ValueError:\n                raise InvalidInputError(f\"{name} must be an integer string, got {value!r}\")\n        else:\n            raise InvalidInputError(f\"{name} must be an int or str, got {type(value).__name__}\")\n        if abs(val) > self.MAX_ABS_VALUE:\n            raise InvalidInputError(f\"{name} absolute value exceeds allowed max {self.MAX_ABS_VALUE}\")\n        return val\n\n    def ensure_int_pair(self, a: Any, b: Any) -> Tuple[int, int]:\n        return self.ensure_int(a, \"a\"), self.ensure_int(b, \"b\")\nclass MultiplyService:\n    \"\"\"Provides the core business logic for multiplying two integers.\"\"\"\n    def __init__(self):\n        pass\n\n    def multiply(self, a: int, b: int) -> MultiplicationResult:\n        product = a * b\n        return MultiplicationResult(a=a, b=b, product=product)\nclass MultiplyController:\n    \"\"\"Coordinates input validation and delegates multiplication to the service.\"\"\"\n    def __init__(self, validator: InputValidator, service: MultiplyService):\n        self._validator = validator\n        self._service = service\n\n    def multiply_int(self, a: Any, b: Any) -> int:\n        a_int, b_int = self._validator.ensure_int_pair(a, b)\n        result = self._service.multiply(a_int, b_int)\n        return result.product\n_default_controller = MultiplyController(InputValidator(), MultiplyService())\ndef multiply_int(a, b) -> int:\n    \"\"\"Multiplies two integers, performing validation and returning the product.\"\"\"\n    return _default_controller.multiply_int(a, b)"}
{"task_id": "Mbpp/128", "solution": "import re\ndef long_words(n: int, text: str) -> list[str]:\n    \"\"\"\n    Finds words that are longer than n characters from a given text.\n    Leading/trailing punctuation is removed before checking length.\n    \"\"\"\n\n    # Helper function to normalize a token by stripping leading/trailing non-word characters.\n    # This handles punctuation around words (e.g., \"word!\" becomes \"word\") while preserving\n    # internal word characters like apostrophes and hyphens (e.g., \"don't\" remains \"don't\").\n    # The re.UNICODE flag ensures it works correctly with various scripts.\n    def _normalize_token_helper(token: str) -> str:\n        return re.sub(r'^\\W+|\\W+$', '', token, flags=re.UNICODE)\n\n    # Tokenize the text into raw words by splitting on any whitespace.\n    # The r\"[^\\s]+\" pattern captures sequences of non-whitespace characters.\n    raw_tokens = re.findall(r\"[^\\s]+\", text, flags=re.UNICODE)\n\n    filtered_words = []\n    for token in raw_tokens:\n        normalized_token = _normalize_token_helper(token)\n        # Only consider non-empty normalized tokens and check their length.\n        if normalized_token and len(normalized_token) > n:\n            filtered_words.append(normalized_token)\n\n    return filtered_words"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels of a given string (where y is not a vowel).\n    \"\"\"\n    VOWELS = set(\"aeiouAEIOU\")\n\n    # Store indices of vowels and the vowels themselves in order of appearance.\n    vowel_indices = []\n    vowel_chars = []\n    for i, char in enumerate(s):\n        if char in VOWELS:\n            vowel_indices.append(i)\n            vowel_chars.append(char)\n\n    # Reverse the collected vowel characters.\n    vowel_chars.reverse()\n\n    # Convert the input string to a list of characters to allow modification.\n    s_list = list(s)\n\n    # Replace the vowels in the string list with the reversed vowels.\n    for i, original_idx in enumerate(vowel_indices):\n        s_list[original_idx] = vowel_chars[i]\n\n    # Join the list back into a string and return it.\n    return \"\".join(s_list)"}
{"task_id": "Mbpp/129", "solution": "from typing import List, Any, Iterable\nclass InvalidMatrixError(Exception):\n    \"\"\"Exception raised for invalid matrix input.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass Matrix:\n    \"\"\"Represents a validated square matrix.\"\"\"\n    def __init__(self, values: List[List[int]]) -> None:\n        self.values: List[List[int]] = values\n        self.n: int = len(values)\n\n    def get_row(self, i: int) -> List[int]:\n        return self.values[i]\n\n    def get_col(self, j: int) -> List[int]:\n        return [row[j] for row in self.values]\n\n    def diag_primary(self) -> List[int]:\n        return [self.values[i][i] for i in range(self.n)]\n\n    def diag_secondary(self) -> List[int]:\n        return [self.values[i][self.n - 1 - i] for i in range(self.n)]\n\n    def all_elements(self) -> List[int]:\n        \"\"\"Returns a flattened list of all matrix elements.\"\"\"\n        elements = []\n        for row in self.values:\n            elements.extend(row)\n        return elements\ndef safe_sum(nums: Iterable[int]) -> int:\n    \"\"\"Calculates the sum of numbers, handling potentially large integers.\"\"\"\n    return sum(nums)\ndef flatten(matrix_values: List[List[int]]) -> List[int]:\n    \"\"\"Flattens a 2D list into a 1D list.\"\"\"\n    elements = []\n    for row in matrix_values:\n        elements.extend(row)\n    return elements\nclass MatrixValidator:\n    \"\"\"Validates raw input to ensure it is a proper square matrix of integers.\"\"\"\n    MAX_MATRIX_SIZE = 1000\n\n    def validate(self, raw: Any) -> Matrix:\n        if not isinstance(raw, list):\n            raise InvalidMatrixError(\"Matrix must be a list of lists.\")\n        \n        n = len(raw)\n        if n == 0:\n            raise InvalidMatrixError(\"Matrix must be non-empty.\")\n        if n > self.MAX_MATRIX_SIZE:\n            raise InvalidMatrixError(f\"Matrix too large, max size is {self.MAX_MATRIX_SIZE}.\")\n        \n        for r_idx, r in enumerate(raw):\n            if not isinstance(r, list) or len(r) != n:\n                raise InvalidMatrixError(f\"Row {r_idx} is not a list or has incorrect length. Matrix must be square (n x n).\")\n            for v_idx, v in enumerate(r):\n                if not isinstance(v, int):\n                    raise InvalidMatrixError(f\"Element at [{r_idx}][{v_idx}] is not an integer. All elements must be integers.\")\n        \n        return Matrix(raw)\nclass MagicSquareService:\n    \"\"\"Determines if a given Matrix is a magic square.\"\"\"\n    def is_magic(self, matrix: Matrix, strict: bool=False) -> bool:\n        if matrix.n == 0:\n            return False\n\n        target = safe_sum(matrix.get_row(0))\n        \n        if not self._sums_equal(matrix, target):\n            return False\n        \n        if strict and not self._strict_check(matrix):\n            return False\n            \n        return True\n\n    def _sums_equal(self, matrix: Matrix, target: int) -> bool:\n        \"\"\"Checks if all row, column, and diagonal sums equal the target.\"\"\"\n        # Check row sums\n        for i in range(matrix.n):\n            if safe_sum(matrix.get_row(i)) != target:\n                return False\n\n        # Check column sums\n        for j in range(matrix.n):\n            if safe_sum(matrix.get_col(j)) != target:\n                return False\n\n        # Check primary diagonal sum\n        if safe_sum(matrix.diag_primary()) != target:\n            return False\n\n        # Check secondary diagonal sum\n        if safe_sum(matrix.diag_secondary()) != target:\n            return False\n\n        return True\n\n    def _strict_check(self, matrix: Matrix) -> bool:\n        \"\"\"Performs strict checks: uniqueness and range 1..n^2.\"\"\"\n        elements = flatten(matrix.values)\n        \n        # Check uniqueness\n        if len(elements) != len(set(elements)):\n            return False\n            \n        # Check range 1..n^2\n        n_squared = matrix.n * matrix.n\n        expected_elements = set(range(1, n_squared + 1))\n        \n        if set(elements) != expected_elements:\n            return False\n            \n        return True\ndef magic_square_test(matrix: List[List[int]], strict: bool = False) -> bool:\n    \"\"\"\n    Calculates whether the given matrix is a magic square.\n    This function validates the input matrix and then applies magic square rules.\n    \"\"\"\n    validator = MatrixValidator()\n    validated_matrix = validator.validate(matrix)\n    \n    svc = MagicSquareService()\n    return svc.is_magic(validated_matrix, strict=strict)"}
{"task_id": "Mbpp/130", "solution": "import collections\ndef max_occurrences(items):\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    Ties are broken by the first encountered item with the maximum count.\n    \"\"\"\n    if not items:\n        # Based on the design context, an InvalidInputError should be raised for empty input.\n        # However, the prompt explicitly states \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n        # and \"No class wrapper, no if __name__ == \"__main__\" guard\".\n        # To comply with the prompt's negative constraints while adhering to the user's assert,\n        # an empty list would typically result in an error or specific handling,\n        # but since no error raising is allowed and no specific return for empty is mentioned,\n        # and the assert uses a non-empty list, we'll proceed assuming non-empty input as per the assert's context.\n        # If an empty list *must* return a value, and no error allowed, None would be a logical choice,\n        # but the prompt implies a direct computation on a valid list.\n        pass \n\n    # Use collections.Counter for efficient frequency counting.\n    # This also preserves insertion order for tie-breaking in Python 3.7+.\n    counts = collections.Counter(items)\n\n    max_item = None\n    max_count = -1\n\n    # Iterate through the counts to find the item with the highest frequency.\n    # The iteration order of Counter (which is dict-like) preserves the order\n    # of first appearance of keys in the input list for tie-breaking.\n    for item, count in counts.items():\n        if count > max_count:\n            max_count = count\n            max_item = item\n            \n    return max_item"}
