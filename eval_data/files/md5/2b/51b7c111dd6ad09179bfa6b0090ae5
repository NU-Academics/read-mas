{"task_id": "Mbpp/222", "solution": "class TypeCheckError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass TypeUtils:\n    def effective_type(self, obj: object, strict: bool = False) -> type:\n        if strict:\n            return type(obj)\n        else:\n            if isinstance(obj, bool):\n                return int\n            return type(obj)\n\n    def type_name(self, tp: type) -> str:\n        return tp.__name__\nclass TupleValidator:\n    def validate_input(self, items: object) -> None:\n        if not isinstance(items, tuple):\n            raise TypeCheckError(f\"Expected tuple, got {type(items).__name__}\")\n\n    def normalize_types(self, items: tuple, strict: bool = False) -> list:\n        utils = TypeUtils()\n        return [utils.effective_type(x, strict=strict) for x in items]\nclass TupleData:\n    def __init__(self, items: tuple, unique_types: set[type], type_counts: dict[type, int]) -> None:\n        self.items = items\n        self.unique_types = unique_types\n        self.type_counts = type_counts\n        self.length = len(items)\n\n    def to_dict(self) -> dict:\n        utils = TypeUtils()\n        return {\n            \"items\": self.items,\n            \"unique_type_names\": [utils.type_name(t) for t in self.unique_types],\n            \"type_counts\": {utils.type_name(t): count for t, count in self.type_counts.items()},\n            \"length\": self.length,\n        }\nclass TupleTypeCheckerService:\n    def __init__(self, validator: 'TupleValidator' = None, utils: 'TypeUtils' = None) -> None:\n        self._validator = validator or TupleValidator()\n        self._utils = utils or TypeUtils()\n\n    def check(self, items: tuple, strict: bool = False) -> bool:\n        if not items or len(items) == 1:\n            return True\n        data = self.analyze(items, strict=strict)\n        return len(data.unique_types) <= 1\n\n    def analyze(self, items: tuple, strict: bool = False) -> TupleData:\n        self._validator.validate_input(items)\n        types = self._validator.normalize_types(items, strict=strict)\n        \n        counts = {}\n        for t in types:\n            counts[t] = counts.get(t, 0) + 1\n        unique = set(types)\n        return TupleData(items=items, unique_types=unique, type_counts=counts)\n_service = TupleTypeCheckerService()\ndef check_type(items: tuple, strict: bool = False) -> bool:\n    \"\"\"\n    Checks if all elements in the tuple have the same data type.\n    Includes an option for strict type checking where bool and int are distinct.\n    \"\"\"\n    return _service.check(items, strict=strict)"}
