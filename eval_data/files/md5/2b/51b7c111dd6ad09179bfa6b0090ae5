{"task_id": "Mbpp/94", "solution": "def index_minimum(data):\n    \"\"\"\n    Given a list of tuples, returns the first value of the tuple with the smallest second value.\n    The function assumes valid, non-empty input and uses a linear scan.\n    \"\"\"\n    min_first_value = data[0][0]\n    min_second_value = data[0][1]\n\n    for item in data[1:]:\n        current_first_value = item[0]\n        current_second_value = item[1]\n\n        if current_second_value < min_second_value:\n            min_second_value = current_second_value\n            min_first_value = current_first_value\n            \n    return min_first_value"}
{"task_id": "Mbpp/92", "solution": "def is_undulating(number):\n    \"\"\"Checks if a number is undulating, defined as having at least three digits that strictly alternate between two different digits.\"\"\"\n\n    num_abs = abs(number)\n\n    if num_abs == 0:\n        digits = [0]\n    else:\n        digits = []\n        temp_num = num_abs\n        while temp_num > 0:\n            digits.append(temp_num % 10)\n            temp_num //= 10\n        digits.reverse()\n\n    if len(digits) < 3:\n        return False\n\n    digit1 = digits[0]\n    digit2 = digits[1]\n\n    if digit1 == digit2:\n        return False\n\n    for i in range(2, len(digits)):\n        if i % 2 == 0:\n            if digits[i] != digit1:\n                return False\n        else:\n            if digits[i] != digit2:\n                return False\n\n    return True"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists: list) -> int:\n    \"\"\"Finds the length of the smallest list in a list of lists.\n    Assumes valid input where at least one list is provided.\"\"\"\n    min_length = None\n\n    for sublist in list_of_lists:\n        current_length = len(sublist)\n        if min_length is None or current_length < min_length:\n            min_length = current_length\n            # Optimization: if a zero-length list is found, it's the smallest possible.\n            if min_length == 0:\n                return 0\n\n    # Since valid input (non-empty list of lists) is assumed,\n    # min_length will have been updated to an integer value.\n    return min_length"}
{"task_id": "Mbpp/98", "solution": "from typing import Iterable, Union, List, Sequence, Any\nclass ValidationError(Exception):\n    \"\"\"Custom exception for input validation errors.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\n\n    def __str__(self) -> str:\n        return self.message\nclass NumberCollection:\n    \"\"\"A data transfer object for a collection of validated numbers.\"\"\"\n    def __init__(self, numbers: List[float]):\n        self.numbers: List[float] = numbers\n        self.length: int = len(numbers)\n\n    def as_sequence(self) -> Sequence[float]:\n        \"\"\"Returns the numbers as an immutable sequence.\"\"\"\n        return tuple(self.numbers)\ndef _validate_numbers_internal(input_iterable: Iterable[Any]) -> NumberCollection:\n    \"\"\"Validates an iterable of numbers and returns a NumberCollection.\"\"\"\n    try:\n        items = list(input_iterable)\n    except TypeError:\n        raise ValidationError(\"Input is not iterable\")\n    if len(items) == 0:\n        raise ValidationError(\"Input collection must not be empty\")\n    validated_numbers: List[float] = []\n    for i, v in enumerate(items):\n        if isinstance(v, (int, float)):\n            validated_numbers.append(float(v))\n        else:\n            raise ValidationError(f\"Element at index {i} is not numeric: {v!r}\")\n    return NumberCollection(validated_numbers)\ndef _product_internal(numbers_seq: Sequence[float]) -> float:\n    \"\"\"Calculates the product of a sequence of floating-point numbers.\"\"\"\n    prod = 1.0\n    for x in numbers_seq:\n        prod *= x\n    return prod\ndef _multiply_and_divide_internal(numbers_seq: Sequence[float]) -> float:\n    \"\"\"Multiplies numbers in a sequence and divides by its length.\"\"\"\n    if len(numbers_seq) == 0:\n        raise ValidationError(\"Cannot perform operation on an empty sequence.\")\n    prod = _product_internal(numbers_seq)\n    return float(prod) / float(len(numbers_seq))\ndef multiply_num(numbers: Iterable[Union[int, float]]) -> float:\n    \"\"\"\n    Multiplies all numbers in a list and divides the product by the length of the list.\n    Raises ValidationError for invalid inputs or an empty collection.\n    \"\"\"\n    collection = _validate_numbers_internal(numbers)\n    return _multiply_and_divide_internal(collection.as_sequence())"}
{"task_id": "Mbpp/97", "solution": "import collections.abc\nfrom collections import Counter\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input encountered during processing.\"\"\"\n    def __init__(self, message: str, error_code: str = \"INVALID_INPUT\"):\n        super().__init__(message)\n        self.error_code = error_code\nclass ListFlattener:\n    \"\"\"Utility to flatten a list of lists by one level into a single list.\"\"\"\n    def flatten_one_level(self, list_of_lists: list[list]) -> list:\n        flattened = []\n        for idx, inner in enumerate(list_of_lists):\n            if isinstance(inner, (str, bytes)):\n                raise InvalidInputError(f\"Inner element at index {idx} is a string/bytes; expected iterable of elements\")\n            if not isinstance(inner, collections.abc.Iterable):\n                raise InvalidInputError(f\"Inner element at index {idx} is not iterable\")\n            for el in inner:\n                flattened.append(el)\n        return flattened\nclass Validator:\n    \"\"\"Utility to validate the structure and hashability of elements in a list of lists.\"\"\"\n    def validate_list_of_lists(self, list_of_lists: object) -> None:\n        if not isinstance(list_of_lists, collections.abc.Iterable):\n            raise InvalidInputError(\"Top-level input is not iterable\")\n        for i, inner in enumerate(list_of_lists):\n            if isinstance(inner, (str, bytes)):\n                raise InvalidInputError(f\"Inner element at index {i} is a string/bytes; expected list-like\")\n            if not isinstance(inner, collections.abc.Iterable):\n                raise InvalidInputError(f\"Inner element at index {i} is not iterable\")\n            for el in inner:\n                try:\n                    hash(el)\n                except TypeError:\n                    raise InvalidInputError(f\"Element {el!r} at inner index is not hashable\")\ndef frequency_lists(list_of_lists: list[list]) -> dict:\n    \"\"\"\n    Computes the frequency of each element in a flattened list of lists.\n    Input elements must be hashable, and inner elements must be iterables (not strings/bytes).\n    \"\"\"\n    validator = Validator()\n    flattener = ListFlattener()\n\n    validator.validate_list_of_lists(list_of_lists)\n    flattened_list = flattener.flatten_one_level(list_of_lists)\n\n    return dict(Counter(flattened_list))"}
{"task_id": "Mbpp/96", "solution": "import sqlite3\nfrom typing import Any, Dict, Optional\ndef divisor(n: int) -> int:\n    \"\"\"\n    Finds the number of positive divisors of a given integer.\n    \"\"\"\n\n    # --- Custom Exceptions (from exceptions.py) ---\n    class DivisorError(Exception):\n        pass\n    class InvalidInputError(DivisorError):\n        pass\n    class RepositoryError(DivisorError):\n        pass\n\n    # --- Config (from config.py) ---\n    class Config:\n        db_path: str = \"data/cache.db\"\n        cache_enabled: bool = True\n        use_abs_for_negative: bool = False\n    \n    # --- Models (from models.py) ---\n    class DivisorResult:\n        def __init__(self, n: int, divisor_count: int, from_cache: bool):\n            self.n = n\n            self.divisor_count = divisor_count\n            self.from_cache = from_cache\n\n        def to_dict(self) -> Dict[str, Any]:\n            return {\n                \"n\": self.n,\n                \"divisor_count\": self.divisor_count,\n                \"from_cache\": self.from_cache\n            }\n\n    # --- Math Utilities (from utils.py) ---\n    class MathUtils:\n        @staticmethod\n        def is_positive_int(value: Any) -> bool:\n            \"\"\"Checks if a value is a positive integer.\"\"\"\n            return isinstance(value, int) and value > 0\n\n        @staticmethod\n        def prime_factorization(n: int) -> Dict[int, int]:\n            \"\"\"Returns the prime factorization of n as {prime: exponent}.\"\"\"\n            factors: Dict[int, int] = {}\n            d = 2\n            temp = n\n            while d * d <= temp:\n                while temp % d == 0:\n                    factors[d] = factors.get(d, 0) + 1\n                    temp //= d\n                d += 1 if d == 2 else 2\n            if temp > 1:\n                factors[temp] = factors.get(temp, 0) + 1\n            return factors\n\n        @staticmethod\n        def divisor_count_from_factors(factors: Dict[int, int]) -> int:\n            \"\"\"Computes the total divisor count from a prime factorization.\"\"\"\n            count = 1\n            for exponent in factors.values():\n                count *= (exponent + 1)\n            return count\n\n    # --- Repository (from repositories.py) ---\n    class DivisorRepository:\n        CREATE_TABLE_SQL = \"CREATE TABLE IF NOT EXISTS divisors (n INTEGER PRIMARY KEY, count INTEGER NOT NULL, computed_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP);\"\n        SELECT_SQL = \"SELECT count FROM divisors WHERE n = ?;\"\n        INSERT_SQL = \"INSERT OR REPLACE INTO divisors (n, count) VALUES (?, ?);\"\n\n        def __init__(self, db_path: str):\n            self.db_path = db_path\n            self.conn: Optional[sqlite3.Connection] = None\n            try:\n                self.conn = sqlite3.connect(db_path, timeout=5)\n                self.ensure_schema()\n            except sqlite3.Error as e:\n                if self.conn:\n                    self.conn.close()\n                raise RepositoryError(f\"Failed to initialize DivisorRepository: {e}\")\n\n        def ensure_schema(self) -> None:\n            \"\"\"Ensures the necessary database schema exists.\"\"\"\n            if not self.conn:\n                raise RepositoryError(\"Database connection not established.\")\n            try:\n                cursor = self.conn.cursor()\n                cursor.execute(self.CREATE_TABLE_SQL)\n                self.conn.commit()\n            except sqlite3.Error as e:\n                raise RepositoryError(f\"Failed to ensure database schema: {e}\")\n\n        def get(self, n: int) -> Optional[int]:\n            \"\"\"Retrieves the divisor count for n from the cache.\"\"\"\n            if not self.conn:\n                raise RepositoryError(\"Database connection not established.\")\n            try:\n                cursor = self.conn.cursor()\n                cursor.execute(self.SELECT_SQL, (n,))\n                result = cursor.fetchone()\n                return result[0] if result else None\n            except sqlite3.Error as e:\n                raise RepositoryError(f\"Failed to get from repository: {e}\")\n\n        def set(self, n: int, count: int) -> None:\n            \"\"\"Stores the divisor count for n in the cache.\"\"\"\n            if not self.conn:\n                raise RepositoryError(\"Database connection not established.\")\n            try:\n                cursor = self.conn.cursor()\n                cursor.execute(self.INSERT_SQL, (n, count))\n                self.conn.commit()\n            except sqlite3.Error as e:\n                raise RepositoryError(f\"Failed to set in repository: {e}\")\n\n        def close(self) -> None:\n            \"\"\"Closes the database connection.\"\"\"\n            if self.conn:\n                self.conn.close()\n                self.conn = None\n\n    # --- Service (from services.py) ---\n    class DivisorService:\n        def __init__(self, repo: Optional[DivisorRepository] = None, config: Config = Config()):\n            self.config = config\n            # Instantiate repository if none provided and caching is enabled\n            if repo is None and config.cache_enabled:\n                self.repo = DivisorRepository(config.db_path)\n            else:\n                self.repo = repo\n\n        def _compute_count(self, n: int) -> int:\n            \"\"\"Computes the divisor count using prime factorization.\"\"\"\n            factors = MathUtils.prime_factorization(n)\n            return MathUtils.divisor_count_from_factors(factors)\n\n        def count_divisors(self, n: int) -> DivisorResult:\n            \"\"\"Counts the number of divisors for n, using cache if enabled.\"\"\"\n            original_n = n\n            \n            # Input validation and optional absolute value transformation\n            if not MathUtils.is_positive_int(n):\n                if self.config.use_abs_for_negative and isinstance(n, int) and n < 0:\n                    n = abs(n)\n                    if n == 0: # abs(0) is still invalid\n                        raise InvalidInputError(\"n must be an integer > 0 (after optional absolute value transformation).\")\n                else:\n                    raise InvalidInputError(\"n must be an integer > 0.\")\n            \n            # Special case for n=1: 1 has 1 divisor\n            if n == 1:\n                return DivisorResult(n=original_n, divisor_count=1, from_cache=False)\n\n            cached = None\n            if self.repo and self.config.cache_enabled:\n                try:\n                    cached = self.repo.get(n)\n                except RepositoryError:\n                    # Log error but proceed without cache lookup if repo fails\n                    pass \n\n            if cached is not None:\n                return DivisorResult(n=original_n, divisor_count=cached, from_cache=True)\n            \n            count = self._compute_count(n)\n            \n            if self.repo and self.config.cache_enabled:\n                try:\n                    self.repo.set(n, count)\n                except RepositoryError:\n                    # Log error but don't fail if repo fails to set\n                    pass\n            \n            return DivisorResult(n=original_n, divisor_count=count, from_cache=False)\n\n    # --- Controller (from controllers.py) ---\n    class DivisorController:\n        def __init__(self, service: DivisorService, initial_cache_error: Optional[str] = None):\n            self.service = service\n            self.initial_cache_error = initial_cache_error\n\n        def compute(self, n: int) -> Dict[str, Any]:\n            \"\"\"Computes divisors and returns a dictionary with result and metadata.\"\"\"\n            result_obj = self.service.count_divisors(n)\n            result_dict = result_obj.to_dict()\n            # Add cache_error metadata if it occurred during repository initialization\n            if self.initial_cache_error:\n                result_dict[\"cache_error\"] = self.initial_cache_error\n            return result_dict\n\n    # --- Main function body (from src/divisors/main.py snippet, adapted) ---\n    config = Config()\n    \n    repo: Optional[DivisorRepository] = None\n    initial_cache_error: Optional[str] = None\n\n    if config.cache_enabled:\n        try:\n            repo = DivisorRepository(config.db_path)\n        except RepositoryError as e:\n            initial_cache_error = str(e)\n            repo = None # Ensure repo is None if initialization failed\n\n    service = DivisorService(repo=repo, config=config)\n    controller = DivisorController(service=service, initial_cache_error=initial_cache_error)\n    \n    result = controller.compute(n)\n    \n    if repo:\n        repo.close()\n        \n    return result[\"divisor_count\"]"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(n: int) -> str:\n    \"\"\"\n    Converts a non-negative decimal integer to its binary string representation.\n    Assumes `n` is a non-negative integer as per the function signature.\n    \"\"\"\n    if n == 0:\n        return \"0\"\n\n    bits = []\n    # Use iterative bitwise operations to convert decimal to binary.\n    while n > 0:\n        bits.append(str(n & 1))\n        n >>= 1\n    \n    # The bits are collected in reverse order, so reverse them before joining.\n    return ''.join(reversed(bits))"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome integer strictly greater than the given integer n.\n    Handles negative inputs by returning the smallest non-negative palindrome (0) if n < 0.\n    \"\"\"\n    if n < 0:\n        return 0\n\n    s = str(n)\n\n    def _mirror_left_to_right(s_inner: str) -> str:\n        \"\"\"Mirrors the left half of a string to its right to form a palindrome.\"\"\"\n        length = len(s_inner)\n        left_half_len = length // 2\n        left = s_inner[:left_half_len]\n        if length % 2 == 0:\n            return left + left[::-1]\n        else:\n            mid = s_inner[length // 2]\n            return left + mid + left[::-1]\n\n    def _add_one_to_middle(s_inner: str) -> str:\n        \"\"\"Increments the middle of a palindrome string, handling carry, and re-mirrors.\"\"\"\n        a = list(s_inner)\n        length = len(a)\n        carry = 1\n        l = (length - 1) // 2\n        r = length // 2\n\n        while l >= 0 and carry:\n            digit_val = (ord(a[l]) - ord('0')) + carry\n            carry = digit_val // 10\n            a[l] = chr((digit_val % 10) + ord('0'))\n            a[r] = a[l]  # Mirror the change\n            l -= 1\n            r += 1\n\n        if carry:\n            # If carry remains, it means all digits were 9s or became 9s (e.g., 9 -> 11, 99 -> 101)\n            return \"1\" + (\"0\" * (length - 1)) + \"1\"\n        return \"\".join(a)\n\n    # If the input number consists of all '9's, the next palindrome will have more digits.\n    if all(ch == '9' for ch in s):\n        return int(\"1\" + (\"0\" * (len(s) - 1)) + \"1\")\n\n    # Form a candidate palindrome by mirroring the left half of 's'.\n    candidate_palindrome_str = _mirror_left_to_right(s)\n\n    # If the candidate palindrome is already greater than n, it's the next smallest.\n    if int(candidate_palindrome_str) > n:\n        return int(candidate_palindrome_str)\n    else:\n        # Otherwise, the candidate palindrome is less than or equal to n.\n        # We need to increment the \"middle\" part of the candidate palindrome\n        # and then re-mirror (which _add_one_to_middle does implicitly).\n        return int(_add_one_to_middle(candidate_palindrome_str))"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(s: str) -> str:\n    \"\"\"\n    Converts a snake_case string to a PascalCase string.\n    This function acts as a convenience wrapper, performing validation and conversion.\n    \"\"\"\n\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception for invalid input strings.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n        def __str__(self) -> str:\n            return self.message\n\n    class InputValidator:\n        \"\"\"Validates if a string conforms to snake_case rules.\"\"\"\n        def validate_snake_case(self, s: str) -> bool:\n            if not isinstance(s, str) or not s:\n                return False\n            if s.startswith('_') or s.endswith('_'):\n                return False\n            if '' in s.split('_'):\n                return False\n            return True\n\n        def raise_if_invalid(self, s: str) -> None:\n            if not self.validate_snake_case(s):\n                raise InvalidInputError(f\"Invalid snake_case input: {s!r}\")\n\n    class SnakeToCamelConverter:\n        \"\"\"Converts a validated snake_case string to PascalCase.\"\"\"\n        def convert(self, s: str) -> str:\n            segments = s.split('_')\n            return ''.join(self._normalize_segment(seg) for seg in segments)\n\n        def _normalize_segment(self, seg: str) -> str:\n            if not seg:\n                return ''\n            return seg[0].upper() + seg[1:]\n\n    class ConversionService:\n        \"\"\"Orchestrates validation and conversion for string transformations.\"\"\"\n        def __init__(self, validator, converter, repository=None):\n            self.validator = validator\n            self.converter = converter\n            self.repository = repository\n\n        def convert(self, s: str, save: bool = False) -> str:\n            self.validator.raise_if_invalid(s)\n            result = self.converter.convert(s)\n            # For this convenience function, repository is None and save is False,\n            # so no persistence logic is needed here.\n            return result\n\n    validator_instance = InputValidator()\n    converter_instance = SnakeToCamelConverter()\n    service_instance = ConversionService(validator_instance, converter_instance, repository=None)\n\n    return service_instance.convert(s, save=False)"}
