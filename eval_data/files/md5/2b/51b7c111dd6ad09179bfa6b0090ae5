{"task_id": "Mbpp/77", "solution": "from datetime import datetime\nfrom collections import deque\nfrom typing import List\ndef digits_alternating_sum(n: int) -> int:\n    \"\"\"Computes the alternating sum of digits for a given number.\n    This is used in the divisibility by 11 rule.\n    \"\"\"\n    s = str(abs(n))\n    total = 0\n    for i, ch in enumerate(reversed(s)):\n        d = ord(ch) - 48\n        if i % 2 == 0:\n            total += d\n        else:\n            total -= d\n    return total\ndef alternating_sum_divisible_by_11(n: int) -> bool:\n    \"\"\"Checks if the alternating sum of digits is divisible by 11.\"\"\"\n    return digits_alternating_sum(n) % 11 == 0\nclass CheckRecord:\n    \"\"\"Represents a single check record for audit/history.\"\"\"\n    def __init__(self, timestamp: datetime, number: int, result: bool) -> None:\n        self.timestamp = timestamp\n        self.number = number\n        self.result = result\nclass InMemoryCheckRepository:\n    \"\"\"Stores recent checks in a circular buffer in memory.\"\"\"\n    def __init__(self, max_history: int = 100) -> None:\n        self._max_history = max_history\n        self._records = deque()\n\n    def append(self, record: CheckRecord) -> None:\n        \"\"\"Appends a new check record to the history.\"\"\"\n        self._records.append(record)\n        if len(self._records) > self._max_history:\n            self._records.popleft()\n\n    def recent(self, limit: int = 10) -> List[CheckRecord]:\n        \"\"\"Retrieves a list of recent check records.\"\"\"\n        return list(self._records)[-limit:]\nclass NumberService:\n    \"\"\"Provides the core business logic for checking divisibility by 11 and recording results.\"\"\"\n    def __init__(self, repo: InMemoryCheckRepository) -> None:\n        self._repo = repo\n\n    def _validate_and_convert(self, n: int | str) -> int:\n        \"\"\"Validates input and converts it to an integer, raising ValueError on failure.\"\"\"\n        if isinstance(n, int):\n            return n\n        if isinstance(n, str):\n            cleaned = n.replace(\"_\", \"\").replace(\",\", \"\").strip()\n            return int(cleaned)\n        raise ValueError(\"number must be int or numeric string\")\n\n    def is_divisible_by_11(self, n: int | str) -> bool:\n        \"\"\"Determines if a number is divisible by 11 and records the check.\"\"\"\n        value = self._validate_and_convert(n)\n        result = alternating_sum_divisible_by_11(value)\n        self._repo.append(CheckRecord(datetime.utcnow(), value, result))\n        return result\n_default_repo = InMemoryCheckRepository()\n_default_service = NumberService(_default_repo)\ndef is_Diff(n: int | str) -> bool:\n    \"\"\"\n    Checks if a given number (integer or string) is divisible by 11.\n    This function acts as a facade, utilizing an internal service and repository for the check.\n    \"\"\"\n    return _default_service.is_divisible_by_11(n)"}
