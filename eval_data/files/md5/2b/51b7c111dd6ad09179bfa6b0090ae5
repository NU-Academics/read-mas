{"task_id": "Mbpp/749", "solution": "def sort_numeric_strings(strings: List[str]) -> List[Union[int, float]]:\n    \"\"\"\n    Parses a list of numeric strings into numbers, converting integral floats to integers,\n    then sorts them numerically in ascending order.\n    \"\"\"\n    parsed_numbers: List[Union[int, float]] = []\n    for s_val in strings:\n        s_stripped = s_val.strip()\n        try:\n            # Attempt to parse as an integer first\n            num = int(s_stripped)\n            parsed_numbers.append(num)\n        except ValueError:\n            # If it fails as an integer, try as a float\n            num = float(s_stripped)\n            # If the float value is an integer, convert it to an int\n            if num.is_integer():\n                parsed_numbers.append(int(num))\n            else:\n                parsed_numbers.append(num)\n                \n    parsed_numbers.sort()\n    return parsed_numbers"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(array):\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    A min-heap satisfies the property where every parent node's value is less than or equal to its children's values.\n    \"\"\"\n    n = len(array)\n    # Start checking from the last parent node up to the root.\n    # The last parent node's index is n // 2 - 1.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n and array[i] > array[left_child_idx]:\n            return False\n\n        # Check right child\n        if right_child_idx < n and array[i] > array[right_child_idx]:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/753", "solution": "from typing import List, Tuple, Iterable, Any, Optional\nfrom dataclasses import dataclass\nfrom abc import ABC, abstractmethod\nimport heapq\nclass MinKError(Exception):\n    pass\nclass InvalidInputError(MinKError):\n    pass\nclass SortStrategy(ABC):\n    @abstractmethod\n    def select_min(self, records: List[Record], k: int) -> List[Record]:\n        pass\nclass SimpleSortStrategy(SortStrategy):\n    def select_min(self, records: List[Record], k: int) -> List[Record]:\n        \"\"\"Selects k smallest records by sorting the entire list.\"\"\"\n        if k <= 0:\n            return []\n        return sorted(records, key=lambda r: (r.value, r.name))[:k]\nclass Validator:\n    @staticmethod\n    def validate_and_convert(records: Iterable[Tuple[Any, Any]]) -> List[Record]:\n        \"\"\"Validates input records and converts them to Record objects.\"\"\"\n        if not isinstance(records, Iterable):\n            raise InvalidInputError(\"Input records must be an iterable.\")\n\n        converted_records: List[Record] = []\n        for i, item in enumerate(records):\n            if not isinstance(item, (tuple, list)) or len(item) != 2:\n                raise InvalidInputError(f\"Record at index {i} must be a 2-element tuple/list.\")\n            \n            name_raw, value_raw = item\n            \n            if not isinstance(name_raw, str):\n                try:\n                    name = str(name_raw)\n                except Exception as e:\n                    raise InvalidInputError(f\"Record at index {i}: name '{name_raw}' cannot be converted to string. Error: {e}\")\n            else:\n                name = name_raw\n\n            if not isinstance(value_raw, (int, float)):\n                try:\n                    value = float(value_raw)\n                except (ValueError, TypeError) as e:\n                    raise InvalidInputError(f\"Record at index {i}: value '{value_raw}' cannot be converted to a number. Error: {e}\")\n            else:\n                value = float(value_raw)\n            \n            converted_records.append(Record(name=name, value=value))\n        return converted_records\nclass MinKService:\n    def __init__(self, strategy: Optional[SortStrategy] = None) -> None:\n        self._strategy = strategy or SimpleSortStrategy()\n\n    def min_k_from_tuples(self, records: Iterable[Tuple[Any, Any]], k: int) -> List[Tuple[str, float]]:\n        \"\"\"Finds minimum k records from an iterable of tuples.\"\"\"\n        validated = Validator.validate_and_convert(records)\n        selected = self.min_k_from_records(validated, k)\n        return [r.to_tuple() for r in selected]\n\n    def min_k_from_records(self, records: List[Record], k: int) -> List[Record]:\n        \"\"\"Finds minimum k records from a list of Record objects.\"\"\"\n        if k < 0:\n            raise InvalidInputError(\"k must be non-negative.\")\n        return self._strategy.select_min(records, k)\ndef min_k(records: Iterable[Tuple[str, Any]], k: int, strategy: Optional[SortStrategy] = None) -> List[Tuple[str, float]]:\n    \"\"\"\n    Finds minimum k records from an iterable of tuples.\n    Records are sorted by value ascending, then by name ascending for tie-breaking.\n    \"\"\"\n    service = MinKService(strategy=strategy)\n    return service.min_k_from_tuples(records, k)"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds elements that are common across three lists at the same index.\n    Returns a list of such elements, preserving order and duplicates.\n    \"\"\"\n    min_len = min(len(l1), len(l2), len(l3))\n    result = []\n    for i in range(min_len):\n        if l1[i] == l2[i] == l3[i]:\n            result.append(l1[i])\n    return result"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth Jacobsthal number using an iterative approach.\n    Handles J(0)=0, J(1)=1, and J(n)=J(n-1)+2*J(n-2) for n>=2.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    \n    j0, j1 = 0, 1\n    for _ in range(2, n + 1):\n        j_current = j1 + 2 * j0\n        j0 = j1\n        j1 = j_current\n    return j1"}
{"task_id": "Mbpp/757", "solution": "from collections import Counter\ndef count_reverse_pairs(strings: list[str]) -> int:\n    \"\"\"\n    Counts the number of unordered pairs of strings (s1, s2) in the list\n    where s1 is the reverse of s2.\n    \"\"\"\n    def _reverse_string(s: str) -> str:\n        \"\"\"Reverses a given string.\"\"\"\n        return s[::-1]\n\n    counts = Counter(strings)\n    total_pairs = 0\n\n    for s, count_s in counts.items():\n        reversed_s = _reverse_string(s)\n\n        if s == reversed_s:\n            # Palindrome: count pairs among its duplicates using nC2 formula.\n            total_pairs += count_s * (count_s - 1) // 2\n        elif s < reversed_s:\n            # To avoid double counting, only process if s is lexicographically\n            # smaller than its reverse.\n            count_reversed_s = counts.get(reversed_s, 0)\n            total_pairs += count_s * count_reversed_s\n            \n    return total_pairs"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(values):\n    \"\"\"\n    Finds the second smallest distinct number in a list of numbers.\n    Assumes the input list contains at least two distinct numeric values.\n    \"\"\"\n    smallest = None\n    second = None\n\n    for v in values:\n        if smallest is None or v < smallest:\n            if smallest is None:\n                smallest = v\n            elif v != smallest:\n                second = smallest\n                smallest = v\n        elif v != smallest and (second is None or v < second):\n            second = v\n            \n    return second"}
{"task_id": "Mbpp/760", "solution": "def unique_Element(numbers_list):\n    \"\"\"\n    Checks whether a list of numbers contains only one distinct element.\n    An empty list or a list with one distinct element returns True; otherwise False.\n    \"\"\"\n    distinct_elements = set()\n\n    for num in numbers_list:\n        # According to design, NaN is considered distinct from any other value including another NaN.\n        # Python's set() treats multiple float('nan') as a single element, so special handling is required.\n        if isinstance(num, float) and num != num:  # Check for NaN\n            distinct_elements.add((\"__nan__\", id(num)))\n        else:\n            distinct_elements.add(num)\n\n        if len(distinct_elements) > 1:\n            return False\n\n    return True"}
{"task_id": "Mbpp/758", "solution": "from typing import Iterable, Sequence, Any, Dict, Tuple\nclass UniqueSublistsError(Exception):\n    pass\nclass UnhashableElementError(UniqueSublistsError):\n    pass\ndef freeze_list_to_tuple(seq: Sequence[Any]) -> Tuple[Any, ...]:\n    \"\"\"Converts a sequence to a tuple, ensuring all elements are hashable.\"\"\"\n    try:\n        tup = tuple(seq)\n        for el in tup:\n            hash(el)\n        return tup\n    except TypeError as e:\n        raise UnhashableElementError(\"Sequence contains an unhashable element.\") from e\nclass InputAdapter:\n    def __init__(self) -> None:\n        pass\n\n    def normalize(self, raw: Any) -> Iterable[Sequence[Any]]:\n        \"\"\"Normalizes raw input to an iterable of sequences, assuming correct typing.\"\"\"\n        return raw\nclass CoreCounter:\n    def __init__(self, adapter: InputAdapter) -> None:\n        self._adapter = adapter\n\n    def count(self, items: Iterable[Sequence[Any]]) -> Dict[Tuple[Any, ...], int]:\n        \"\"\"Counts occurrences of unique sublists, converting them to tuples.\"\"\"\n        normalized = self._adapter.normalize(items)\n        counts: Dict[Tuple[Any, ...], int] = {}\n        for seq in normalized:\n            tup = freeze_list_to_tuple(seq)\n            counts[tup] = counts.get(tup, 0) + 1\n        return counts\ndef unique_sublists(items: Iterable[Sequence[Any]]) -> Dict[Tuple[Any, ...], int]:\n    \"\"\"Counts unique sublists in a list, returning counts mapped to tuple-converted sublists.\"\"\"\n    adapter = InputAdapter()\n    counter = CoreCounter(adapter)\n    return counter.count(items)"}
