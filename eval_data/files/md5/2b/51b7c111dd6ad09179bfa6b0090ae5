{"task_id": "Mbpp/232", "solution": "import heapq\nfrom collections import deque\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input to the larg_nnum function.\"\"\"\n    pass\nclass Validator:\n    \"\"\"Provides static methods for validating input parameters.\"\"\"\n\n    @staticmethod\n    def validate_items(items):\n        \"\"\"Validates that items is an iterable and converts it to a list.\"\"\"\n        if items is None:\n            raise InvalidInputError(\"items cannot be None\")\n        try:\n            lst = list(items)\n        except TypeError:\n            raise InvalidInputError(\"items must be an iterable\")\n        return lst\n\n    @staticmethod\n    def validate_n(n):\n        \"\"\"Validates that n is a non-negative integer.\"\"\"\n        if not isinstance(n, int) or n < 0:\n            raise InvalidInputError(\"n must be a non-negative integer\")\n        return n\ndef to_cache_key(items_snapshot, n):\n    \"\"\"Generates a deterministic cache key for a given set of unique items and n.\"\"\"\n    # items_snapshot is expected to be a sorted list of unique items.\n    try:\n        key_items = tuple(items_snapshot)\n        return f\"{hash(key_items)}_{n}\"\n    except TypeError:\n        return f\"{repr(items_snapshot)}_{n}\"\nclass TopNRequest:\n    \"\"\"Data Transfer Object for incoming top-N requests.\"\"\"\n    def __init__(self, items, n):\n        self.items = items\n        self.n = n\nclass TopNResult:\n    \"\"\"Data Transfer Object for outgoing top-N results.\"\"\"\n    def __init__(self, items):\n        self.items = items\nclass TopNCacheRepository:\n    \"\"\"In-memory LRU-like cache for storing top-N results.\"\"\"\n    def __init__(self, max_entries=128):\n        self.max_entries = max_entries\n        self.store = {}\n        self.order = deque()\n\n    def get(self, key):\n        \"\"\"Retrieves a cached value, returning a copy if found.\"\"\"\n        val = self.store.get(key)\n        return list(val) if val is not None else None\n\n    def set(self, key, value):\n        \"\"\"Stores a value in the cache, evicting oldest entries if capacity is exceeded.\"\"\"\n        if key in self.store:\n            self.store[key] = list(value)\n            return\n        self.store[key] = list(value)\n        self.order.append(key)\n        self._evict_if_needed()\n\n    def _evict_if_needed(self):\n        \"\"\"Removes the oldest entries if the cache size exceeds its maximum.\"\"\"\n        while len(self.order) > self.max_entries:\n            old_key = self.order.popleft()\n            self.store.pop(old_key, None)\nclass TopNService:\n    \"\"\"Implements the core logic for finding and caching the top N largest unique items.\"\"\"\n    def __init__(self, cache_repo=None, max_heap_threshold=10000):\n        self.cache_repo = cache_repo\n        self.max_heap_threshold = max_heap_threshold\n\n    def get_top_n(self, items, n):\n        \"\"\"Retrieves the n largest unique items from the list, utilizing a cache if available.\"\"\"\n        items_list = Validator.validate_items(items)\n        n_validated = Validator.validate_n(n)\n\n        unique_items = list(set(items_list))\n        unique_items.sort() # Sort for consistent cache key generation\n\n        key = to_cache_key(unique_items, n_validated)\n\n        if self.cache_repo:\n            cached = self.cache_repo.get(key)\n            if cached is not None:\n                return cached\n\n        result = self._compute_top_n(unique_items, n_validated)\n\n        if self.cache_repo:\n            try:\n                self.cache_repo.set(key, list(result))\n            except Exception:\n                pass # Silent fallback on cache error\n\n        return result\n\n    def _compute_top_n(self, unique_items, n):\n        \"\"\"Computes the n largest unique items efficiently using sorting or heapq.nlargest.\"\"\"\n        if n == 0:\n            return []\n        \n        if n >= len(unique_items):\n            return sorted(unique_items, reverse=True)\n        \n        if len(unique_items) > self.max_heap_threshold:\n            return heapq.nlargest(n, unique_items)\n        else:\n            return sorted(unique_items, reverse=True)[:n]\nclass TopNController:\n    \"\"\"Orchestrates validation and service calls for top-N requests.\"\"\"\n    def __init__(self, service):\n        self.service = service\n\n    def handle(self, request):\n        \"\"\"Handles a TopNRequest by validating inputs and delegating to the service.\"\"\"\n        result_items = self.service.get_top_n(request.items, request.n)\n        return TopNResult(result_items)\nDEFAULT_CACHE_ENTRIES = 128\ndef larg_nnum(items, n):\n    \"\"\"\n    Returns a list containing the n largest unique items from the input list.\n    The returned list is sorted in descending order.\n    \"\"\"\n    cache = TopNCacheRepository(max_entries=DEFAULT_CACHE_ENTRIES)\n    service = TopNService(cache_repo=cache)\n    controller = TopNController(service)\n\n    req = TopNRequest(items, n)\n    result = controller.handle(req)\n    return result.items"}
{"task_id": "Mbpp/233", "solution": "import math\nclass InvalidDimensionError(ValueError):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nMIN_DIMENSION = 0.0\ndef validate_dimension(value, name: str) -> float:\n    try:\n        v = float(value)\n    except (TypeError, ValueError):\n        raise InvalidDimensionError(f\"{name} must be numeric, got {value!r}\")\n    if v < MIN_DIMENSION:\n        raise InvalidDimensionError(f\"{name} must be >= {MIN_DIMENSION}, got {v}\")\n    return v\nclass Cylinder:\n    def __init__(self, radius: float, height: float) -> None:\n        self.radius: float = float(radius)\n        self.height: float = float(height)\nclass CylinderFactory:\n    def create(self, radius_raw, height_raw) -> Cylinder:\n        r = validate_dimension(radius_raw, \"radius\")\n        h = validate_dimension(height_raw, \"height\")\n        return Cylinder(r, h)\nclass LateralSurfaceCalculator:\n    def calculate(self, radius: float, height: float) -> float:\n        return 2.0 * math.pi * float(radius) * float(height)\ndef lateralsuface_cylinder(radius: float, height: float) -> float:\n    \"\"\"\n    Computes the lateral surface area of a cylinder.\n    Inputs are validated for numeric type and non-negativity.\n    \"\"\"\n    factory = CylinderFactory()\n    cyl = factory.create(radius, height)\n    calc = LateralSurfaceCalculator()\n    return calc.calculate(cyl.radius, cyl.height)"}
