{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(nums, n):\n    \"\"\"\n    Calculates the sum of XOR of all pairs of numbers in the given list using a bitwise approach.\n    It iterates through each bit position and sums the contribution of that bit to the total.\n    \"\"\"\n    if not nums or len(nums) < 2:\n        return 0\n\n    max_abs_val = 0\n    for num in nums:\n        abs_num = abs(num)\n        if abs_num > max_abs_val:\n            max_abs_val = abs_num\n    \n    # Determine the maximum number of bits needed.\n    # `bit_length()` for 0 is 0, so `or 1` ensures at least one bit is always considered.\n    max_bits = max_abs_val.bit_length() or 1\n\n    total_xor_sum = 0\n    list_length = len(nums)\n\n    for b in range(max_bits):\n        mask = 1 << b\n        ones_count = 0\n        \n        # Count numbers with the b-th bit set\n        for num in nums:\n            if (num & mask) != 0:\n                ones_count += 1\n        \n        zeros_count = list_length - ones_count\n        \n        # Each pair of (number with bit 1, number with bit 0) contributes 2^b to the sum.\n        total_xor_sum += ones_count * zeros_count * mask\n        \n    return total_xor_sum"}
{"task_id": "Mbpp/635", "solution": "def heap_sort(lst: list) -> list:\n    \"\"\"Sorts a list in ascending order using the heap sort algorithm.\"\"\"\n    n = len(lst)\n    if n <= 1:\n        return lst[:]  # Return a copy for immutability as per design.\n\n    # Work on a copy of the list to avoid mutating the original\n    arr = lst[:]\n\n    # Define a min-heap comparator: a is \"smaller\" than b if a < b\n    # This means smaller elements have higher priority (bubble up)\n    _comparator = lambda a, b: a < b\n\n    # Helper function to maintain the min-heap property by sifting an element down.\n    # `end_idx` is the last valid index of the current heap.\n    def _sift_down(current_idx, end_idx):\n        while True:\n            left_child_idx = 2 * current_idx + 1\n            right_child_idx = 2 * current_idx + 2\n            idx_to_swap = current_idx\n\n            # Find the smallest among the parent and its children\n            if left_child_idx <= end_idx and _comparator(arr[left_child_idx], arr[idx_to_swap]):\n                idx_to_swap = left_child_idx\n\n            if right_child_idx <= end_idx and _comparator(arr[right_child_idx], arr[idx_to_swap]):\n                idx_to_swap = right_child_idx\n\n            if idx_to_swap != current_idx:\n                # Swap if a child is smaller than the parent and continue sifting down\n                arr[current_idx], arr[idx_to_swap] = arr[idx_to_swap], arr[current_idx]\n                current_idx = idx_to_swap\n            else:\n                break  # Heap property is satisfied for this subtree\n\n    # Build the initial min-heap\n    # Start from the last parent node (floor(n/2) - 1) and go up to the root (0)\n    for i in range((n // 2) - 1, -1, -1):\n        _sift_down(i, n - 1)\n\n    # Extract elements one by one from the heap to form the sorted list\n    # The smallest element is always at arr[0] in a min-heap.\n    sorted_result = []\n    \n    # `current_heap_size` tracks the active size of our heap within `arr`.\n    # It effectively shrinks as we \"pop\" elements.\n    current_heap_size = n\n    \n    while current_heap_size > 0:\n        # The root (smallest element) is the one we want to \"pop\"\n        smallest_element = arr[0]\n        sorted_result.append(smallest_element)\n\n        # To simulate popping, we move the last element of the current heap to the root\n        # and then reduce the heap size by one.\n        current_heap_size -= 1\n        if current_heap_size > 0:\n            arr[0] = arr[current_heap_size]  # Move last element to root\n            _sift_down(0, current_heap_size - 1)  # Sift down the new root to restore heap property\n        # If current_heap_size is 0, the last element was popped, and the heap is now empty.\n\n    return sorted_result"}
{"task_id": "Mbpp/639", "solution": "def sample_nam(names):\n    \"\"\"\n    Sums the length of names that do not start with a lowercase letter.\n    Names starting with 'a' through 'z' (ASCII) are excluded from the sum.\n    \"\"\"\n    total_length = 0\n    for name in names:\n        # Check if the name is not empty and its first character is NOT a lowercase ASCII letter.\n        # An empty string is implicitly handled by the `if name` check, preventing IndexError.\n        if name and not ('a' <= name[0] <= 'z'):\n            total_length += len(name)\n    return total_length"}
{"task_id": "Mbpp/638", "solution": "import math\ndef wind_chill(wind_kmh: float, temp_c: float) -> int:\n    \"\"\"\n    Calculates the wind chill index rounded to the nearest integer (half-up).\n    The calculation uses the Environment Canada wind chill formula.\n    \"\"\"\n    def _round_half_up(value: float) -> int:\n        \"\"\"Rounds a float to the nearest integer using half-up semantics.\"\"\"\n        if value >= 0:\n            return int(math.floor(value + 0.5))\n        else:\n            return int(math.ceil(value - 0.5))\n\n    v_pow = wind_kmh ** 0.16\n    wind_chill_raw = 13.12 + 0.6215 * temp_c - 11.37 * v_pow + 0.3965 * temp_c * v_pow\n    \n    return _round_half_up(wind_chill_raw)"}
