{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(n):\n    \"\"\"\n    Toggles all bits of the number except the first (MSB) and the last (LSB) bit.\n    For numbers with fewer than 3 bits, no middle bits exist, so the number is returned unchanged.\n    \"\"\"\n    bl = n.bit_length()\n\n    if bl < 3:\n        return n\n\n    # Create a mask with all bits set from LSB up to (MSB - 1).\n    # This is (2^msb_pos) - 1.\n    msb_pos = bl - 1\n    lower_mask = (1 << msb_pos) - 1\n\n    # Clear the LSB (bit 0) from the lower_mask to get the \"middle\" mask.\n    mask = lower_mask & ~1\n\n    return n ^ mask"}
{"task_id": "Mbpp/730", "solution": "from typing import Iterable, List, TypeVar\nT = TypeVar(\"T\")\ndef consecutive_duplicates(items: Iterable[T]) -> List[T]:\n    \"\"\"\n    Removes consecutive duplicate elements from an iterable, preserving order.\n    Non-consecutive duplicates remain in the list.\n    \"\"\"\n    result: List[T] = []\n    prev_item: T = object() # Use a unique sentinel to handle the first element\n\n    for item in items:\n        # If it's the first item or different from the previous item, add it to the result.\n        if prev_item is object() or item != prev_item:\n            result.append(item)\n            prev_item = item\n            \n    return result"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(arr: list[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array using binary search.\n    Returns -1 if the target is not found.\n    \"\"\"\n    low, high = 0, len(arr) - 1\n    result = -1\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] < target:\n            low = mid + 1\n        elif arr[mid] > target:\n            high = mid - 1\n        else:\n            result = mid\n            high = mid - 1  # Move left to find the first occurrence\n    return result"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sequence: list, value: object) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in sorted order using binary search.\n    This is the index where the value can be inserted without breaking the sorted order.\n    \"\"\"\n    lo = 0\n    hi = len(sequence)\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if sequence[mid] < value:\n            lo = mid + 1\n        else:\n            hi = mid\n    return lo"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(nums: list) -> int:\n    \"\"\"Calculates the sum of products of all contiguous subarrays.\n    This implementation uses a naive O(n^2) approach.\"\"\"\n    total_sum = 0\n    n = len(nums)\n    for i in range(n):\n        current_product = 1\n        for j in range(i, n):\n            current_product *= nums[j]\n            total_sum += current_product\n    return total_sum"}
{"task_id": "Mbpp/737", "solution": "import re\ndef check_str(s: str) -> bool:\n    \"\"\"Checks if the given string starts with a vowel (a, e, i, o, u), case-insensitive, ignoring leading whitespace.\"\"\"\n    pattern = re.compile(r\"^\\s*[aeiou]\", re.IGNORECASE)\n    return bool(pattern.match(s))"}
{"task_id": "Mbpp/739", "solution": "import math\n_cache = {}\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with at least n digits.\n    Uses a formulaic approach with a verification fallback and in-memory caching.\n    \"\"\"\n    if n in _cache:\n        return _cache[n]\n\n    def _triangular_number(k: int) -> int:\n        \"\"\"Calculates the k-th triangular number.\"\"\"\n        return k * (k + 1) // 2\n\n    def _digits(num: int) -> int:\n        \"\"\"Counts the number of decimal digits in an integer.\"\"\"\n        if num == 0:\n            return 1\n        return len(str(abs(num)))\n\n    # The threshold for a number to have 'n' digits is 10^(n-1).\n    # We need to find the smallest k such that T_k >= 10^(n-1).\n    # Solve T_k = k*(k+1)/2 >= threshold for k: k^2 + k - 2*threshold >= 0\n    # Using quadratic formula for roots of k^2 + k - 2*threshold = 0:\n    # k = (-1 +/- sqrt(1 - 4*1*(-2*threshold))) / 2\n    # k = (-1 +/- sqrt(1 + 8*threshold)) / 2\n    # We take the positive root and ceil it to find the first k that satisfies the condition.\n    threshold = 10 ** (n - 1)\n    k_float_candidate = (-1.0 + math.sqrt(1.0 + 8.0 * threshold)) / 2.0\n    \n    # Initial candidate index, ensuring it's at least 1 as indices are 1-based.\n    current_k = max(1, math.ceil(k_float_candidate))\n    \n    current_value = _triangular_number(current_k)\n\n    # Verification loop 1: Ensure T_k has at least n digits.\n    # The floating point calculation can sometimes result in an 'k' that's too small\n    # if the actual value of T_k for that 'k' falls just below 10^(n-1).\n    while _digits(current_value) < n:\n        current_k += 1\n        current_value = _triangular_number(current_k)\n\n    # Verification loop 2: Ensure current_k is the *smallest* such index.\n    # The floating point calculation can sometimes result in an 'k' that's too large\n    # if a smaller (k-1) also satisfies the n-digit condition.\n    while current_k > 1 and _digits(_triangular_number(current_k - 1)) >= n:\n        current_k -= 1\n\n    _cache[n] = current_k\n    return current_k"}
