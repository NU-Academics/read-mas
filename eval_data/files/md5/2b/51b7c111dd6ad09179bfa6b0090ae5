{"task_id": "Mbpp/460", "solution": "from typing import Any, List, Sequence\nfrom dataclasses import dataclass\nfrom collections.abc import Sequence\nclass ExtractionError(Exception):\n    \"\"\"Custom exception for extraction-related errors.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\nclass Validator:\n    \"\"\"Validates raw input data for the extraction process.\"\"\"\n    def validate_input(self, value: Any) -> InputList:\n        \"\"\"Ensures the input is a sequence of sequences and converts it to InputList.\"\"\"\n        if not self._is_sequence(value):\n            raise ExtractionError(\"Input must be a sequence of sequences\")\n        for idx, sub in enumerate(value):\n            if not self._is_sequence(sub):\n                raise ExtractionError(f\"Element at index {idx} is not a sequence\")\n        return InputList.from_raw(value)\n\n    def _is_sequence(self, value: Any) -> bool:\n        \"\"\"Helper to check if a value is a sequence, excluding strings, bytes, and dictionaries.\"\"\"\n        return isinstance(value, Sequence) and not isinstance(value, (str, bytes, dict))\nDEFAULT_SKIP_EMPTY = True\nclass Extractor:\n    \"\"\"Core logic to extract the first element from each sublist.\"\"\"\n    def __init__(self, validator: Validator = None) -> None:\n        \"\"\"Initializes the Extractor, optionally with a custom validator.\"\"\"\n        self.validator = validator or Validator()\n\n    def extract_first_elements(self, input_list: InputList, skip_empty: bool = DEFAULT_SKIP_EMPTY) -> List[Any]:\n        \"\"\"Extracts the first element from each sublist in the provided InputList.\"\"\"\n        result = []\n        for idx, sub in enumerate(input_list.data):\n            try:\n                if len(sub) == 0:\n                    if skip_empty:\n                        continue\n                    raise ExtractionError(f\"Empty sublist at index {idx}\")\n                result.append(self._extract_from_sublist(sub))\n            except TypeError as e:\n                raise ExtractionError(f\"Sublist at index {idx} is not indexable: {e}\") from e\n        return result\n\n    def _extract_from_sublist(self, sublist: Sequence[Any]) -> Any:\n        \"\"\"Safely extracts the first element from a non-empty sublist.\"\"\"\n        return sublist[0]\ndef Extract(lists: List[List[Any]], skip_empty: bool = True) -> List[Any]:\n    \"\"\"\n    Extracts the first element of each sublist from a given list of lists.\n    Empty sublists are skipped by default.\n    \"\"\"\n    validator = Validator()\n    input_list = validator.validate_input(lists)\n    extractor = Extractor(validator=validator)\n    return extractor.extract_first_elements(input_list, skip_empty=skip_empty)"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(arr: list[int]) -> int:\n    \"\"\"\n    Finds the maximum product of a contiguous subarray within the given array.\n    This algorithm handles positive, negative, and zero elements efficiently in O(n) time.\n    \"\"\"\n    max_overall_product = arr[0]\n    current_max_product = arr[0]\n    current_min_product = arr[0]\n\n    for i in range(1, len(arr)):\n        num = arr[i]\n        \n        # Storing current_max_product to use in current_min_product calculation\n        # because current_max_product itself might be updated first.\n        temp_current_max = current_max_product\n\n        current_max_product = max(num, temp_current_max * num, current_min_product * num)\n        current_min_product = min(num, temp_current_max * num, current_min_product * num)\n        \n        max_overall_product = max(max_overall_product, current_max_product)\n        \n    return max_overall_product"}
{"task_id": "Mbpp/462", "solution": "def combinations_list(items):\n    \"\"\"\n    Generates all possible combinations (the power set) of elements from a given list,\n    ordered by integer mask with elements in descending original-index order within each subset.\n    \"\"\"\n    n = len(items)\n    result = []\n    # Iterate through all possible masks from 0 to 2^n - 1\n    for mask in range(1 << n):\n        subset = []\n        # Build each subset by checking bits in the mask, from highest index to lowest\n        for i in range(n - 1, -1, -1):\n            if (mask >> i) & 1:  # If the i-th bit is set\n                subset.append(items[i])\n        result.append(subset)\n    return result"}
