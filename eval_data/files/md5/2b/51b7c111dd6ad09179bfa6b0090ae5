{"task_id": "Mbpp/724", "solution": "import json\nimport os\nfrom typing import Optional\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    pass\nclass ComputationError(Exception):\n    \"\"\"Exception raised for errors during the power calculation.\"\"\"\n    pass\nclass PowerRequest:\n    \"\"\"Data transfer object for a power calculation request.\"\"\"\n    def __init__(self, base: int, power: int) -> None:\n        self.base = base\n        self.power = power\nclass PowerResult:\n    \"\"\"Data transfer object for a power calculation result.\"\"\"\n    def __init__(self, digit_sum: int, value_str: str) -> None:\n        self.digit_sum = digit_sum\n        self.value_str = value_str\nclass PowerCalculatorService:\n    \"\"\"Calculates base raised to the power.\"\"\"\n    def calculate(self, base: int, power: int) -> int:\n        try:\n            return pow(base, power)\n        except (OverflowError, MemoryError) as e:\n            raise ComputationError(\"Failed to compute power due to resource limits.\") from e\nclass DigitSumService:\n    \"\"\"Calculates the sum of digits for an integer.\"\"\"\n    def sum_digits(self, value: int) -> int:\n        s = str(abs(value))\n        return sum(int(ch) for ch in s)\ndef make_cache_key(base: int, power: int) -> str:\n    \"\"\"Generates a deterministic cache key for a base and power pair.\"\"\"\n    return f\"b:{base}:p:{power}\"\ndef default_cache_path() -> str:\n    \"\"\"Provides the default file system path for the cache.\"\"\"\n    cache_dir = os.path.join(os.path.expanduser(\"~\"), \".cache\", \"power_sum\")\n    return os.path.join(cache_dir, \"cache.json\")\nclass CacheRepository:\n    \"\"\"Manages an in-memory and optional file-backed JSON cache.\"\"\"\n    def __init__(self, cache_path: Optional[str] = None) -> None:\n        self.cache_path = cache_path\n        self.in_memory: dict[str, str] = {}\n        if cache_path:\n            try:\n                os.makedirs(os.path.dirname(cache_path), exist_ok=True)\n                if os.path.exists(cache_path):\n                    with open(cache_path, \"r\", encoding=\"utf-8\") as f:\n                        self.in_memory = json.load(f)\n            except Exception:\n                # Non-fatal: if cache loading fails, proceed with an empty cache.\n                self.in_memory = {}\n\n    def get(self, key: str) -> Optional[str]:\n        \"\"\"Retrieves a value from the cache by key.\"\"\"\n        return self.in_memory.get(key)\n\n    def set(self, key: str, value: str) -> None:\n        \"\"\"Stores a key-value pair in the cache and attempts to persist it to disk.\"\"\"\n        self.in_memory[key] = value\n        if self.cache_path:\n            tmp_path = self.cache_path + \".tmp\"\n            try:\n                with open(tmp_path, \"w\", encoding=\"utf-8\") as f:\n                    json.dump(self.in_memory, f)\n                os.replace(tmp_path, self.cache_path) # Atomic replacement\n            except Exception:\n                # Non-fatal: ignore persistence errors.\n                pass\n\n    def close(self) -> None:\n        \"\"\"No-op as persistence is handled on each set operation.\"\"\"\n        pass\nclass PowerBaseSumService:\n    \"\"\"Orchestrates validation, caching, power calculation, and digit summing.\"\"\"\n    def __init__(self, calculator: PowerCalculatorService, digit_service: DigitSumService, cache: CacheRepository) -> None:\n        self.calculator = calculator\n        self.digit_service = digit_service\n        self.cache = cache\n\n    def _validate(self, request: PowerRequest) -> None:\n        \"\"\"Validates the input request parameters, ensuring they are non-negative integers.\"\"\"\n        if not isinstance(request.base, int) or request.base < 0:\n            raise ValidationError(\"Base must be a non-negative integer.\")\n        if not isinstance(request.power, int) or request.power < 0:\n            raise ValidationError(\"Power must be a non-negative integer.\")\n\n    def compute(self, request: PowerRequest) -> PowerResult:\n        \"\"\"Computes the sum of digits for base raised to power, utilizing caching.\"\"\"\n        self._validate(request)\n        \n        cache_key = make_cache_key(request.base, request.power)\n        cached_value_str = self.cache.get(cache_key)\n\n        if cached_value_str:\n            # Cache hit: parse string, compute digit sum.\n            digit_sum = self.digit_service.sum_digits(int(cached_value_str))\n            return PowerResult(digit_sum=digit_sum, value_str=cached_value_str)\n        else:\n            # Cache miss: calculate, convert to string, cache, then compute digit sum.\n            value_int = self.calculator.calculate(request.base, request.power)\n            value_str = str(value_int)\n            self.cache.set(cache_key, value_str)\n            digit_sum = self.digit_service.sum_digits(value_int)\n            return PowerResult(digit_sum=digit_sum, value_str=value_str)\ndef power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    This function acts as the primary API entry point, orchestrating underlying services.\n    \"\"\"\n    cache = CacheRepository(cache_path=default_cache_path())\n    power_calculator = PowerCalculatorService()\n    digit_sum_service = DigitSumService()\n    \n    svc = PowerBaseSumService(\n        calculator=power_calculator,\n        digit_service=digit_sum_service,\n        cache=cache\n    )\n    \n    try:\n        req = PowerRequest(base=base, power=power)\n        result = svc.compute(req)\n        return result.digit_sum\n    finally:\n        # Ensures the cache repository's close method is called for resource management.\n        cache.close()"}
