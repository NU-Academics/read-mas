{"task_id": "Mbpp/103", "solution": "_memo = {}\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Computes the Eulerian number A(n, m) using dynamic programming with memoization.\n    \"\"\"\n    # Base cases for Eulerian numbers\n    if n == 0:\n        return 1 if m == 0 else 0\n    if m < 0 or m >= n:\n        return 0\n\n    # Memoization check for the requested (n, m)\n    if (n, m) in _memo:\n        return _memo[(n, m)]\n\n    # Initialize A(0,0) in the memo if not already present\n    if (0, 0) not in _memo:\n        _memo[(0, 0)] = 1\n\n    # Build up the DP table (and populate memo) for 'n' values from 1 to the requested 'n'\n    for k_val in range(1, n + 1):\n        # Calculate A(k_val, j_val) for j_val from 0 to k_val-1\n        # A(k_val, 0) is always 1 for k_val > 0 (A(k,0) = A(k-1,0) = ... = A(0,0) = 1)\n        if (k_val, 0) not in _memo:\n            _memo[(k_val, 0)] = 1\n\n        # Calculate A(k_val, j_val) for j_val from 1 to k_val-1 using the recurrence\n        for j_val in range(1, k_val):\n            if (k_val, j_val) in _memo:\n                continue # Skip if already computed and stored\n\n            # Recurrence: A(k,j) = (k-j)A(k-1,j-1) + (j+1)A(k-1,j)\n\n            # Get A(k_val-1, j_val-1) from memo. Default to 0 if out of bounds or not found.\n            val1 = _memo.get((k_val - 1, j_val - 1), 0)\n\n            # Get A(k_val-1, j_val) from memo. Default to 0 if out of bounds or not found.\n            val2 = _memo.get((k_val - 1, j_val), 0)\n\n            _memo[(k_val, j_val)] = (k_val - j_val) * val1 + (j_val + 1) * val2\n\n    return _memo[(n, m)]"}
{"task_id": "Mbpp/105", "solution": "from typing import Sequence, Any\nfrom collections.abc import Iterable\nclass InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\ndef count(values: Sequence[Any]) -> int:\n    \"\"\"\n    Counts the number of True boolean values in a sequence.\n    Only strictly True boolean values (type bool and value True) are counted.\n    \"\"\"\n    def _is_iterable(obj: Any) -> bool:\n        return isinstance(obj, Iterable) and not isinstance(obj, (str, bytes, bytearray))\n\n    if not _is_iterable(values):\n        raise InvalidInputError(\"Input must be a sequence (list/tuple). Strings are not accepted.\")\n    \n    validated_values = list(values)\n\n    true_count = 0\n    for v in validated_values:\n        if isinstance(v, bool) and v is True:\n            true_count += 1\n            \n    return true_count"}
{"task_id": "Mbpp/104", "solution": "from typing import Iterable, List, Callable, Any, Optional\nclass SortingError(ValueError):\n    \"\"\"Custom exception for sorting-related errors.\"\"\"\n    def __init__(self, message: str, cause: Optional[Exception] = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.cause = cause\n\n    def __str__(self) -> str:\n        if self.cause:\n            return f\"{self.message} (Caused by: {self.cause})\"\n        return self.message\ndef safe_str(x: Any) -> str:\n    \"\"\"Safely converts an object to its string representation.\"\"\"\n    return str(x)\nclass InputValidator:\n    \"\"\"Validates inputs for the sorting function.\"\"\"\n    def validate_outer_iterable(self, inputs: Any) -> None:\n        if inputs is None:\n            raise SortingError(\"Input cannot be None.\")\n        if not isinstance(inputs, Iterable) or isinstance(inputs, str):\n            raise SortingError(\"Input must be an iterable of iterables (not a string).\")\n\n    def validate_inner_iterable(self, inner: Any) -> None:\n        if not isinstance(inner, Iterable):\n            raise SortingError(f\"Inner item '{inner}' is not an iterable.\")\n\n    def check_in_place_mutability(self, inputs: Any) -> None:\n        if not isinstance(inputs, list):\n            raise SortingError(\"In-place sorting requires the outer container to be a list.\")\n        for i, inner in enumerate(inputs):\n            if not isinstance(inner, list):\n                raise SortingError(f\"In-place sorting requires all inner containers to be lists. Element at index {i} is a {type(inner).__name__}.\")\nclass ListConverter:\n    \"\"\"Converts nested iterables into a List[List[str]].\"\"\"\n    def to_list_of_lists(self, inputs: Iterable[Iterable[str]]) -> List[List[str]]:\n        converted_outer = []\n        for i, inner_iterable in enumerate(inputs):\n            if not isinstance(inner_iterable, Iterable):\n                 raise SortingError(f\"Element at index {i} ('{inner_iterable}') is not an iterable.\")\n            try:\n                converted_inner = [safe_str(item) for item in inner_iterable]\n                converted_outer.append(converted_inner)\n            except Exception as e:\n                raise SortingError(f\"Failed to convert inner iterable at index {i} to list of strings.\", cause=e)\n        return converted_outer\nclass SortService:\n    \"\"\"Core sorting logic for lists of lists.\"\"\"\n    def sort(self, lists: List[List[str]], key: Optional[Callable[[str], Any]] = None, reverse: bool = False, in_place: bool = False) -> List[List[str]]:\n        if in_place:\n            for lst in lists:\n                try:\n                    lst.sort(key=key, reverse=reverse)\n                except Exception as e:\n                    raise SortingError(f\"An error occurred during in-place sorting of a sublist: {lst}\", cause=e)\n            return lists\n        else:\n            sorted_lists = []\n            for lst in lists:\n                try:\n                    sorted_lists.append(sorted(lst, key=key, reverse=reverse))\n                except Exception as e:\n                    raise SortingError(f\"An error occurred during sorting of a sublist: {lst}\", cause=e)\n            return sorted_lists\nclass SortController:\n    \"\"\"Public-facing controller for sorting sublists.\"\"\"\n    def __init__(self, validator: InputValidator, converter: ListConverter, service: SortService) -> None:\n        self._validator = validator\n        self._converter = converter\n        self._service = service\n\n    def sort_sublists(self, inputs: Iterable[Iterable[str]], in_place: bool = False, key: Optional[Callable[[str], Any]] = None, reverse: bool = False) -> List[List[str]]:\n        \"\"\"Sorts each sublist of strings in a given list of lists.\"\"\"\n        try:\n            self._validator.validate_outer_iterable(inputs)\n            lists = self._converter.to_list_of_lists(inputs)\n            if in_place:\n                self._validator.check_in_place_mutability(inputs)\n            return self._service.sort(lists, key=key, reverse=reverse, in_place=in_place)\n        except SortingError:\n            raise\n        except Exception as e:\n            raise SortingError(f\"An unexpected error occurred during sorting.\", cause=e)\n_default_controller = SortController(InputValidator(), ListConverter(), SortService())\ndef sort_sublists(inputs: Iterable[Iterable[str]], in_place: bool = False, key: Optional[Callable[[str], Any]] = None, reverse: bool = False) -> List[List[str]]:\n    \"\"\"Sorts each sublist of strings in a given list of lists.\"\"\"\n    return _default_controller.sort_sublists(inputs, in_place=in_place, key=key, reverse=reverse)"}
{"task_id": "Mbpp/109", "solution": "class InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass RotationParams:\n    \"\"\"Data transfer object for rotation input parameters.\"\"\"\n    def __init__(self, binary: str, rotations: int) -> None:\n        self.binary: str = binary\n        self.rotations: int = rotations\nclass RotationResult:\n    \"\"\"Data transfer object for rotation count result.\"\"\"\n    def __init__(self, count: int, examined: int) -> None:\n        self.count: int = count\n        self.examined: int = examined\nclass InputValidator:\n    \"\"\"Validates the input parameters for binary string rotations.\"\"\"\n    def validate(self, params: RotationParams) -> None:\n        if not isinstance(params.binary, str) or len(params.binary) == 0:\n            raise InvalidInputError(\"binary must be a non-empty string\")\n        if any(c not in \"01\" for c in params.binary):\n            raise InvalidInputError(\"binary must contain only '0' and '1'\")\n        if not isinstance(params.rotations, int) or params.rotations < 0:\n            raise InvalidInputError(\"rotations must be a non-negative integer\")\nclass BitUtils:\n    \"\"\"Utility methods for bitwise operations and string rotations.\"\"\"\n    @staticmethod\n    def is_odd(bin_str: str) -> bool:\n        \"\"\"Determines if a binary string represents an odd number.\"\"\"\n        return len(bin_str) > 0 and bin_str[-1] == \"1\"\n\n    @staticmethod\n    def left_rotate(bin_str: str, k: int) -> str:\n        \"\"\"Rotates a binary string to the left by k positions.\"\"\"\n        n = len(bin_str)\n        if n == 0:\n            raise ValueError(\"cannot rotate an empty string\")\n        k = k % n\n        return bin_str[k:] + bin_str[:k]\nclass RotatorService:\n    \"\"\"Provides the core logic for counting odd rotations of a binary string.\"\"\"\n    def __init__(self, validator: InputValidator) -> None:\n        self._validator = validator\n\n    def count_odd_rotations(self, params: RotationParams) -> RotationResult:\n        \"\"\"Counts the number of odd values among the first K rotations.\"\"\"\n        self._validator.validate(params)\n        n = len(params.binary)\n        if n == 0:\n            return RotationResult(0, 0)\n\n        effective_k = min(params.rotations, n)\n        \n        count = 0\n        for i in range(effective_k):\n            rotated = BitUtils.left_rotate(params.binary, i)\n            if BitUtils.is_odd(rotated):\n                count += 1\n        return RotationResult(count, effective_k)\ndef odd_Equivalent(bin_str: str, rotations: int) -> int:\n    \"\"\"\n    Finds the number of rotations of a binary string that represent an odd integer.\n    \"\"\"\n    params = RotationParams(bin_str, rotations)\n    service = RotatorService(InputValidator())\n    result = service.count_odd_rotations(params)\n    return result.count"}
{"task_id": "Mbpp/108", "solution": "class ValidationError(Exception):\n    \"\"\"Raised when validation of input lists or their elements fails.\"\"\"\n    pass\nclass MergeError(Exception):\n    \"\"\"Raised when an unexpected error occurs during the merge and sort process.\"\"\"\n    pass\nclass ListValidator:\n    \"\"\"Validates that inputs are lists and elements are numeric.\"\"\"\n    ALLOWED_TYPES = (int, float)\n\n    def validate(self, lst: list, name: str = \"list\") -> None:\n        \"\"\"Raises ValidationError if lst is not a list or contains non-numeric items.\"\"\"\n        if not isinstance(lst, list):\n            raise ValidationError(f\"{name} must be a list, got {type(lst).__name__}\")\n        for i, item in enumerate(lst):\n            if not self.is_numeric(item):\n                raise ValidationError(f\"{name}[{i}] is not numeric: {item!r}\")\n\n    def is_numeric(self, item) -> bool:\n        \"\"\"Checks if an item is an integer or a float.\"\"\"\n        return isinstance(item, self.ALLOWED_TYPES)\nclass SortStrategy:\n    \"\"\"Abstract base class for sorting algorithms.\"\"\"\n    def sort(self, items: list) -> list:\n        \"\"\"Sorts a list of items and returns the sorted list.\"\"\"\n        raise NotImplementedError(\"Subclasses must implement the 'sort' method\")\nclass DefaultSortStrategy(SortStrategy):\n    \"\"\"Default sorting strategy using Python's built-in sorted() function.\"\"\"\n    def sort(self, items: list) -> list:\n        \"\"\"Sorts a list of items in ascending order.\"\"\"\n        return sorted(items)\nclass MergeService:\n    \"\"\"Core business logic to merge and sort three lists.\"\"\"\n    def __init__(self, sort_strategy: SortStrategy = None) -> None:\n        \"\"\"Initializes MergeService with an optional sort strategy.\"\"\"\n        self._sort_strategy = sort_strategy or DefaultSortStrategy()\n\n    def merge_sorted_list(self, a: list, b: list, c: list) -> list:\n        \"\"\"Combines three lists, sorts them, and returns the result.\"\"\"\n        try:\n            combined = list(a) + list(b) + list(c)\n            return self._sort_strategy.sort(combined)\n        except Exception as e:\n            raise MergeError(\"Failed to merge and sort lists\") from e\nclass MergeController:\n    \"\"\"Public API boundary; orchestrates validation and service calls.\"\"\"\n    def __init__(self, service: MergeService) -> None:\n        \"\"\"Initializes MergeController with a MergeService instance.\"\"\"\n        self._service = service\n        self._validator = ListValidator()\n\n    def merge_and_return(self, a: list, b: list, c: list) -> list:\n        \"\"\"Validates input lists and delegates to MergeService for merging and sorting.\"\"\"\n        self._validator.validate(a, \"a\")\n        self._validator.validate(b, \"b\")\n        self._validator.validate(c, \"c\")\n        return self._service.merge_sorted_list(a, b, c)\ndef merge_sorted_list(list1: list, list2: list, list3: list) -> list:\n    \"\"\"Merges three lists into a single sorted list.\n    Validates inputs and uses a pluggable sorting strategy.\"\"\"\n    service = MergeService(sort_strategy=DefaultSortStrategy())\n    controller = MergeController(service=service)\n    return controller.merge_and_return(list1, list2, list3)"}
{"task_id": "Mbpp/116", "solution": "def tuple_to_int(input_tuple: tuple[int, ...]) -> int:\n    \"\"\"Converts a tuple of positive integers into a single integer by concatenating their string representations.\"\"\"\n    return int(\"\".join(map(str, input_tuple)))"}
{"task_id": "Mbpp/113", "solution": "from typing import Optional, Dict, Any\nclass Config:\n    \"\"\"Centralized configuration for integer checking.\"\"\"\n    allow_none: bool = False\n    strip_whitespace: bool = True\n    allowed_signs: str = \"+-\"\n    default_timeout_ms: int = 50\nclass ValidationError(Exception):\n    \"\"\"Domain-specific exception for validation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass Normalizer:\n    \"\"\"Helper functions for string normalization and character checks.\"\"\"\n    @staticmethod\n    def normalize(s: str, strip: bool = True) -> str:\n        \"\"\"Trim whitespace if strip True; return unchanged if not.\"\"\"\n        return s.strip() if strip else s\n\n    @staticmethod\n    def is_digit_char(c: str) -> bool:\n        \"\"\"True iff character is 0-9.\"\"\"\n        return '0' <= c <= '9'\nclass ParseResult:\n    \"\"\"Immutable data transfer object for validation results.\"\"\"\n    def __init__(self, is_integer: bool, original: str, normalized: str, error: Optional[str]) -> None:\n        self.is_integer = is_integer\n        self.original = original\n        self.normalized = normalized\n        self.error = error\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Returns dictionary suitable for JSON responses.\"\"\"\n        return {\n            \"is_integer\": self.is_integer,\n            \"original\": self.original,\n            \"normalized\": self.normalized,\n            \"error\": self.error\n        }\nclass StringValidator:\n    \"\"\"Encapsulates the pure integer validation algorithm.\"\"\"\n    def __init__(self, config: Config) -> None:\n        self._config = config\n\n    def validate(self, s: str) -> ParseResult:\n        \"\"\"Validates if a string represents a base-10 integer based on configuration.\"\"\"\n        if s is None and not self._config.allow_none:\n            raise ValidationError(\"input is None\")\n\n        normalized = Normalizer.normalize(\"\" if s is None else s, strip=self._config.strip_whitespace)\n\n        if len(normalized) == 0:\n            return ParseResult(False, s or \"\", normalized, \"empty string\")\n\n        sign_offset = 0\n        if normalized[0] in self._config.allowed_signs:\n            sign_offset = 1\n        \n        digits_part = normalized[sign_offset:]\n\n        if len(digits_part) == 0:\n            return ParseResult(False, s or \"\", normalized, \"no digits after sign\")\n        \n        if not all(Normalizer.is_digit_char(c) for c in digits_part):\n            return ParseResult(False, s or \"\", normalized, \"non-digit characters present\")\n        \n        return ParseResult(True, s or \"\", normalized, None)\nclass CheckService:\n    \"\"\"Application-level service that coordinates validation.\"\"\"\n    def __init__(self, validator: StringValidator) -> None:\n        self._validator = validator\n\n    def check(self, s: str) -> ParseResult:\n        \"\"\"Delegates validation to StringValidator and returns the ParseResult.\"\"\"\n        return self._validator.validate(s)\n_default_service = CheckService(StringValidator(Config()))\ndef check_integer(s: str) -> bool:\n    \"\"\"Checks if a string represents an integer according to the predefined rules.\"\"\"\n    return _default_service.check(s).is_integer"}
