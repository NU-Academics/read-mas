{"task_id": "Mbpp/796", "solution": "class SumValidationError(Exception):\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\nclass SumTypeError(SumValidationError):\n    def __init__(self, message: str, invalid_keys: list[str]=None) -> None:\n        self.invalid_keys = invalid_keys if invalid_keys is not None else []\n        super().__init__(message)\nclass DictionaryItems:\n    def __init__(self, items: dict[str, float]) -> None:\n        self.items = items\n\n    @classmethod\n    def from_dict(cls, items: dict) -> \"DictionaryItems\":\n        \"\"\"Creates a DictionaryItems instance from a raw dictionary, ensuring values are floats.\"\"\"\n        return cls({k: float(v) for k, v in items.items()})\nclass SumResult:\n    def __init__(self, total: float, count: int) -> None:\n        self.total = total\n        self.count = count\n\n    def to_dict(self) -> dict:\n        \"\"\"Converts the SumResult to a serializable dictionary.\"\"\"\n        return {\"total\": self.total, \"count\": self.count}\nclass ValidationUtils:\n    @staticmethod\n    def ensure_is_mapping(obj: object) -> None:\n        \"\"\"Ensures the given object is a dictionary.\"\"\"\n        if not isinstance(obj, dict):\n            raise SumValidationError(\"Expected a dict\")\n\n    @staticmethod\n    def ensure_values_numeric(d: dict) -> None:\n        \"\"\"Ensures all values in the dictionary are numeric (int or float).\"\"\"\n        invalid = [k for k, v in d.items() if not isinstance(v, (int, float))]\n        if invalid:\n            raise SumTypeError(f\"Non-numeric values at keys: {invalid}\", invalid_keys=invalid)\nclass DictRepository:\n    def __init__(self) -> None:\n        pass\n\n    def get_items(self, items: dict) -> DictionaryItems:\n        \"\"\"Validates and adapts a raw dictionary into a DictionaryItems object.\"\"\"\n        ValidationUtils.ensure_is_mapping(items)\n        ValidationUtils.ensure_values_numeric(items)\n        return DictionaryItems.from_dict(items)\nclass SumService:\n    def __init__(self, repository: \"DictRepository\" = None) -> None:\n        self._repository = repository if repository is not None else DictRepository()\n\n    def sum_items(self, items: DictionaryItems) -> SumResult:\n        \"\"\"Computes the sum and count of numeric items in a DictionaryItems object.\"\"\"\n        total = sum(items.items.values())\n        return SumResult(total=float(total), count=len(items.items))\n\n    def sum_raw(self, items: dict) -> float:\n        \"\"\"Convenience method to sum raw dictionary items, performing validation and adaptation.\"\"\"\n        di = self._repository.get_items(items)\n        return self.sum_items(di).total\nclass SumController:\n    def __init__(self, service: SumService = None, repository: DictRepository = None) -> None:\n        self.repository = repository if repository is not None else DictRepository()\n        self.service = service if service is not None else SumService(repository=self.repository)\n\n    def compute_sum(self, items: dict) -> SumResult:\n        \"\"\"Orchestrates validation, data adaptation, and sum computation for a dictionary.\"\"\"\n        dictionary_items = self.repository.get_items(items)\n        result = self.service.sum_items(dictionary_items)\n        return result\ndef return_sum(items: dict) -> float:\n    \"\"\"Calculates the sum of all numeric values in a dictionary.\"\"\"\n    controller = SumController()\n    result = controller.compute_sum(items)\n    return float(result.total)"}
