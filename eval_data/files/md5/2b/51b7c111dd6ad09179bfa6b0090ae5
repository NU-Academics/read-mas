{"task_id": "Mbpp/430", "solution": "from fractions import Fraction\nimport math\ndef parabola_directrix(a: float, b: float, c: float, scale: int | None = None) -> int:\n    \"\"\"\n    Computes the directrix of a parabola y = ax^2 + bx + c.\n    The result is an integer, scaled by a default or provided factor.\n    \"\"\"\n\n    class ParabolaError(Exception):\n        \"\"\"Custom exception for parabola-related errors.\"\"\"\n\n    class ParabolaCoefficients:\n        \"\"\"Encapsulates the coefficients of a parabola.\"\"\"\n        def __init__(self, a_val: float, b_val: float, c_val: float) -> None:\n            self.a = a_val\n            self.b = b_val\n            self.c = c_val\n\n    class DirectrixResult:\n        \"\"\"Holds the exact and scaled directrix values.\"\"\"\n        def __init__(self, directrix_y: Fraction, scaled_value: int, scale_factor: int) -> None:\n            self.directrix_y = directrix_y\n            self.scaled_value = scaled_value\n            self.scale = scale_factor\n\n    class Validator:\n        \"\"\"Provides static methods for input validation.\"\"\"\n        @staticmethod\n        def validate_coeffs(coeffs: ParabolaCoefficients) -> None:\n            if coeffs.a == 0:\n                raise ParabolaError(\"Coefficient 'a' must be non-zero for a parabola.\")\n\n    class DirectrixCalculator:\n        \"\"\"Calculates the directrix using exact rational arithmetic.\"\"\"\n        DEFAULT_SCALE: int = -132\n\n        def calculate_directrix(self, coeffs: ParabolaCoefficients, scale_factor: int | None = None) -> DirectrixResult:\n            a_frac = Fraction(coeffs.a)\n            b_frac = Fraction(coeffs.b)\n            c_frac = Fraction(coeffs.c)\n\n            # Vertex y-coordinate: k = c - b^2 / (4a)\n            k_frac = c_frac - (b_frac * b_frac) / (Fraction(4) * a_frac)\n            \n            # Focal length: p = 1 / (4a)\n            p_frac = Fraction(1) / (Fraction(4) * a_frac)\n            \n            # Directrix y-coordinate: y = k - p\n            directrix_y_frac = k_frac - p_frac\n\n            s = scale_factor if scale_factor is not None else self.DEFAULT_SCALE\n            scaled_value = int(round(float(directrix_y_frac * s)))\n            \n            return DirectrixResult(directrix_y_frac, scaled_value, s)\n\n    class ParabolaController:\n        \"\"\"Orchestrates validation and directrix calculation.\"\"\"\n        def __init__(self, calculator: DirectrixCalculator) -> None:\n            self.calculator = calculator\n\n        def compute_directrix(self, a_val: float, b_val: float, c_val: float, scale_factor: int | None = None) -> int:\n            coeffs = ParabolaCoefficients(a_val, b_val, c_val)\n            Validator.validate_coeffs(coeffs)\n            result = self.calculator.calculate_directrix(coeffs, scale_factor)\n            return result.scaled_value\n\n    # Instantiate the controller and calculator for the public function call.\n    controller = ParabolaController(DirectrixCalculator())\n    return controller.compute_directrix(a, b, c, scale)"}
