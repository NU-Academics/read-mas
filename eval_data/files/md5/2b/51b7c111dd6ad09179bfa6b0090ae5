{"task_id": "Mbpp/17", "solution": "from typing import Any\nclass InvalidSideLengthError(Exception):\n    \"\"\"Exception raised for invalid side length inputs.\"\"\"\n    def __init__(self, message: str = None) -> None:\n        self.message = message if message is not None else \"Invalid side length provided.\"\n        super().__init__(self.message)\nclass Square:\n    \"\"\"Represents a square with a given side length.\"\"\"\n    def __init__(self, side_length: float) -> None:\n        self._side_length: float = float(side_length)\n\n    def perimeter(self) -> float:\n        \"\"\"Calculates the perimeter of the square.\"\"\"\n        return 4.0 * self._side_length\nclass PerimeterCalculator:\n    \"\"\"Calculates the perimeter of a square.\"\"\"\n    def compute_for_square(self, square: Square) -> float:\n        return square.perimeter()\n\n    def compute_for_side(self, side_length: float) -> float:\n        sq = Square(side_length)\n        return self.compute_for_square(sq)\nclass SideLengthValidator:\n    \"\"\"Validates and normalizes side length inputs.\"\"\"\n    def validate(self, value: Any) -> float:\n        try:\n            v = float(value)\n        except (TypeError, ValueError):\n            raise InvalidSideLengthError(f\"Invalid side length: {value}\")\n        if v < 0:\n            raise InvalidSideLengthError(\"Side length must be non-negative\")\n        return v\ndef square_perimeter(side_length):\n    \"\"\"\n    Returns the perimeter of a square given its side length.\n    Validates the input and computes the perimeter.\n    \"\"\"\n    validator = SideLengthValidator()\n    calc = PerimeterCalculator()\n    side = validator.validate(side_length)\n    return calc.compute_for_side(side)"}
{"task_id": "Mbpp/16", "solution": "import re\nfrom typing import Optional\nDEFAULT_PATTERN = r\"^[a-z]+(?:_[a-z]+)+$\"\ndef compile_regex(pattern_str: str) -> re.Pattern:\n    \"\"\"Compiles a regex pattern string.\"\"\"\n    return re.compile(pattern_str)\nclass ValidationResult:\n    \"\"\"DTO for validation results.\"\"\"\n    def __init__(self, text: str, is_valid: bool, error: Optional[str]) -> None:\n        self.text = text\n        self.is_valid = is_valid\n        self.error = error\nclass LowercaseUnderscoreValidator:\n    \"\"\"Validates strings for lowercase sequences joined by underscores.\"\"\"\n    def __init__(self, pattern: Optional[re.Pattern | str] = None) -> None:\n        if pattern is None:\n            pattern = DEFAULT_PATTERN\n        self._pattern = compile_regex(pattern) if isinstance(pattern, str) else pattern\n\n    def is_valid(self, text: str) -> bool:\n        # Per design, raises TypeError for non-str inputs.\n        if not isinstance(text, str):\n            raise TypeError(\"text must be a str\")\n        return bool(self._pattern.fullmatch(text))\nclass TextService:\n    \"\"\"Service for orchestrating text validation.\"\"\"\n    def __init__(self, validator: LowercaseUnderscoreValidator) -> None:\n        self._validator = validator\n\n    def validate_text(self, text: str) -> ValidationResult:\n        # Per design, TypeError should propagate from the top-level function.\n        # Thus, TextService does not catch TypeError from its validator here.\n        valid = self._validator.is_valid(text)\n        return ValidationResult(text=text, is_valid=valid, error=None)\n_default_service = TextService(LowercaseUnderscoreValidator())\ndef text_lowercase_underscore(text: str) -> bool:\n    \"\"\"Checks if the input string contains sequences of lowercase letters joined by an underscore.\"\"\"\n    # This function propagates TypeError for non-string inputs, as specified in FR1.\n    return _default_service.validate_text(text).is_valid"}
{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(source, blacklist):\n    \"\"\"\n    Removes characters from the source string that are present in the blacklist string.\n    The filtering is case-sensitive and preserves the order of remaining characters.\n    \"\"\"\n    blacklist_set = set(blacklist)\n    result_chars = []\n    for char in source:\n        if char not in blacklist_set:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/14", "solution": "import math\nclass InvalidDimensionError(Exception):\n    \"\"\"Custom exception for invalid dimension inputs.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nEPSILON = 1e-12\ndef _validate_dimension(value, name: str) -> float:\n    \"\"\"Validates a dimension to be a positive, finite float.\"\"\"\n    try:\n        v = float(value)\n    except (TypeError, ValueError):\n        raise InvalidDimensionError(f\"{name} must be a number\")\n    if math.isfinite(v) and v > EPSILON:\n        return v\n    raise InvalidDimensionError(f\"{name} must be > 0 and finite\")\ndef find_Volume(base, height, length):\n    \"\"\"Calculates the volume of a triangular prism.\n    All dimensions must be positive and finite numbers.\n    \"\"\"\n    validated_base = _validate_dimension(base, \"base\")\n    validated_height = _validate_dimension(height, \"height\")\n    validated_length = _validate_dimension(length, \"length\")\n\n    volume = 0.5 * validated_base * validated_height * validated_length\n    return volume"}
