{"task_id": "Mbpp/766", "solution": "from typing import List, Tuple, Any, Sequence\ndef pair_wise(items: Sequence[Any]) -> List[Tuple[Any, Any]]:\n    \"\"\"\n    Returns a list of all pairs of consecutive items in the given sequence.\n    \"\"\"\n    items_list = list(items)\n    result: List[Tuple[Any, Any]] = []\n    for i in range(len(items_list) - 1):\n        result.append((items_list[i], items_list[i + 1]))\n    return result"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets using a stack.\n    Only considers '()', '{}', '[]' for balancing, ignoring other characters.\n    \"\"\"\n    stack = []\n    # Define allowed bracket pairs: closing -> opening\n    allowed_pairs = {')': '(', ']': '[', '}': '{'}\n    \n    # Create sets for efficient lookup\n    opening_brackets = set(allowed_pairs.values())\n    closing_brackets = set(allowed_pairs.keys())\n\n    for char in expression:\n        if char in opening_brackets:\n            stack.append(char)\n        elif char in closing_brackets:\n            if not stack or stack.pop() != allowed_pairs[char]:\n                return False\n        # Ignore any other characters that are not brackets\n    \n    return not stack"}
{"task_id": "Mbpp/772", "solution": "def remove_length(text: str, k: int) -> str:\n    \"\"\"Removes all words of length k from the given string and normalizes whitespace.\"\"\"\n    import re\n\n    WORD_REGEX = r\"\\b\\w+\\b\"\n    words = re.findall(WORD_REGEX, text)\n    filtered_words = [word for word in words if len(word) != k]\n    return \" \".join(filtered_words)"}
{"task_id": "Mbpp/767", "solution": "import collections\ndef get_pairs_count(numbers: list, target_sum: int) -> int:\n    \"\"\"\n    Counts the number of unordered index-distinct pairs in a list\n    whose elements sum to a target value.\n    \"\"\"\n    # Validate and convert numbers to a list of integers.\n    # Error handling for non-integer inputs is omitted as per instructions.\n    nums = [int(x) for x in list(numbers)]\n\n    # Convert target_sum to an integer.\n    target_sum_int = int(target_sum)\n\n    # Use a frequency map (collections.Counter) to store counts of each number.\n    freq = collections.Counter(nums)\n    total_pairs = 0\n    \n    # Iterate through each unique number in the frequency map.\n    for v in freq:\n        complement = target_sum_int - v\n        \n        # If the complement doesn't exist in the frequency map, skip.\n        if complement not in freq:\n            continue\n            \n        # Case 1: The number and its complement are different.\n        # To avoid double-counting pairs (v, complement) and (complement, v),\n        # only count when v is less than its complement.\n        if v < complement:\n            total_pairs += freq[v] * freq[complement]\n        \n        # Case 2: The number and its complement are the same (v + v = target_sum).\n        # This means we need to count combinations of pairs of 'v's.\n        # If there are N occurrences of 'v', the number of pairs is N * (N - 1) // 2.\n        elif v == complement:\n            total_pairs += freq[v] * (freq[v] - 1) // 2\n            \n    return total_pairs"}
{"task_id": "Mbpp/769", "solution": "from typing import Any, List, Optional, Type\nclass ValidationUtils:\n    \"\"\"Utility for input validation.\"\"\"\n    @staticmethod\n    def validate_lists(list_a: Any, list_b: Any) -> None:\n        if not isinstance(list_a, list):\n            raise TypeError(\"list_a must be a list.\")\n        if not isinstance(list_b, list):\n            raise TypeError(\"list_b must be a list.\")\nclass SetAdapter:\n    \"\"\"Adapts set for efficient membership testing, with fallback for unhashable items.\"\"\"\n    def build_set_if_possible(self, items: List[Any]) -> Optional[set]:\n        try:\n            return set(items)\n        except TypeError:\n            return None\n\n    def contains(self, container_set: Optional[set], item: Any, fallback_list: List[Any]) -> bool:\n        if container_set is not None:\n            return item in container_set\n        return item in fallback_list\nclass DiffStrategy:\n    \"\"\"Base interface for list difference ordering strategies.\"\"\"\n    def compute(self, items: List[Any]) -> List[Any]:\n        raise NotImplementedError\nclass PreserveOrderStrategy(DiffStrategy):\n    \"\"\"Strategy to preserve the original relative order of elements.\"\"\"\n    def compute(self, items: List[Any]) -> List[Any]:\n        return items[:]\nclass EvenOddReorderStrategy(DiffStrategy):\n    \"\"\"Strategy to reorder elements by even indices first, then odd indices.\"\"\"\n    def compute(self, items: List[Any]) -> List[Any]:\n        evens = [items[i] for i in range(0, len(items), 2)]\n        odds = [items[i] for i in range(1, len(items), 2)]\n        return evens + odds\nclass SortedReorderStrategy(DiffStrategy):\n    \"\"\"Strategy to sort elements; falls back to preserve order if items are incomparable.\"\"\"\n    def compute(self, items: List[Any]) -> List[Any]:\n        try:\n            return sorted(items)\n        except TypeError:\n            return items[:]\nclass StrategyFactory:\n    \"\"\"Factory to create DiffStrategy instances based on a given name.\"\"\"\n    STRATEGY_MAP: dict[str, Type[DiffStrategy]] = {\n        \"preserve\": PreserveOrderStrategy,\n        \"even_odd\": EvenOddReorderStrategy,\n        \"sorted\": SortedReorderStrategy,\n    }\n\n    def __init__(self, default_strategy_name: str):\n        self._default_strategy_name = default_strategy_name\n\n    def get(self, strategy_name: Optional[str]) -> DiffStrategy:\n        name = (strategy_name or self._default_strategy_name).lower()\n        strategy_class = self.STRATEGY_MAP.get(name)\n        if not strategy_class:\n            raise ValueError(f\"Unknown strategy: '{strategy_name}'. Valid strategies are: {', '.join(self.STRATEGY_MAP.keys())}\")\n        return strategy_class()\nclass DiffService:\n    \"\"\"Core logic to compute the difference between two lists and apply a strategy.\"\"\"\n    def __init__(self, set_adapter: SetAdapter):\n        self.set_adapter = set_adapter\n\n    def compute(self, list_a: List[Any], list_b: List[Any], strategy: DiffStrategy) -> List[Any]:\n        filtered = self._filter_diff(list_a, list_b)\n        return strategy.compute(filtered)\n\n    def _filter_diff(self, list_a: List[Any], list_b: List[Any]) -> List[Any]:\n        container_set = self.set_adapter.build_set_if_possible(list_b)\n        result = []\n        for item in list_a:\n            if not self.set_adapter.contains(container_set, item, list_b):\n                result.append(item)\n        return result\nclass DiffController:\n    \"\"\"Orchestrates validation, strategy selection, and difference computation.\"\"\"\n    def __init__(self, service: DiffService, factory: StrategyFactory):\n        self.service = service\n        self.factory = factory\n\n    def compute_diff(self, list_a: List[Any], list_b: List[Any], strategy_name: Optional[str] = None) -> List[Any]:\n        ValidationUtils.validate_lists(list_a, list_b)\n        strategy = self.factory.get(strategy_name)\n        return self.service.compute(list_a, list_b, strategy)\nDEFAULT_STRATEGY = \"even_odd\"\ndef Diff(list_a: List[Any], list_b: List[Any], strategy: Optional[str] = None) -> List[Any]:\n    \"\"\"\n    Computes the difference between two lists, returning elements in list_a not present in list_b,\n    ordered according to the specified strategy.\n    \"\"\"\n    factory = StrategyFactory(default_strategy_name=DEFAULT_STRATEGY)\n    service = DiffService(set_adapter=SetAdapter())\n    controller = DiffController(service=service, factory=factory)\n    return controller.compute_diff(list_a, list_b, strategy_name=strategy)"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth power of the first n odd natural numbers.\n    The first n odd natural numbers are 1, 3, 5, ..., (2n-1).\n    \"\"\"\n    total_sum = 0\n    for i in range(n):\n        odd_num = 2 * i + 1\n        total_sum += odd_num ** 4\n    return total_sum"}
{"task_id": "Mbpp/777", "solution": "def find_sum(input_list):\n    \"\"\"\n    Calculates the sum of elements that appear exactly once in the input list.\n    Uses a dictionary to count element frequencies for efficient processing.\n    \"\"\"\n    counts = {}\n    for element in input_list:\n        counts[element] = counts.get(element, 0) + 1\n\n    total_sum = 0\n    for element, count in counts.items():\n        if count == 1:\n            total_sum += element\n            \n    return total_sum"}
{"task_id": "Mbpp/775", "solution": "def odd_position(lst: list) -> bool:\n    \"\"\"\n    Checks if every odd-indexed element in the list is an odd number.\n    Returns True if all odd-indexed numbers are odd, or if the list is empty.\n    \"\"\"\n    for i, num in enumerate(lst):\n        if i % 2 == 1:  # Check only odd indices (1, 3, 5, ...)\n            if num % 2 == 0:  # If the number at an odd index is even\n                return False\n    return True"}
{"task_id": "Mbpp/778", "solution": "from typing import List, Any\ndef pack_consecutive_duplicates(items: List[Any]) -> List[List[Any]]:\n    \"\"\"\n    Packs consecutive duplicate elements of a list into sublists.\n    The order of elements and sublists is preserved.\n    \"\"\"\n    result: List[List[Any]] = []\n\n    if not items:\n        return result\n\n    current_group: List[Any] = [items[0]]\n\n    for item in items[1:]:\n        if item == current_group[-1]:\n            current_group.append(item)\n        else:\n            result.append(current_group)\n            current_group = [item]\n\n    result.append(current_group)\n    return result"}
{"task_id": "Mbpp/773", "solution": "from dataclasses import dataclass\nfrom typing import Tuple, Optional, List\nclass StringUtils:\n    \"\"\"Provides utility methods for string validation and normalization.\"\"\"\n    DEFAULT_CASE_SENSITIVE: bool = True\n\n    @staticmethod\n    def validate_inputs(text: str, substring: str) -> None:\n        \"\"\"Validates that text and substring are strings, raising TypeError if not.\"\"\"\n        if not isinstance(text, str) or not isinstance(substring, str):\n            raise TypeError(\"text and substring must be str\")\n\n    @staticmethod\n    def normalize(text: str, case_sensitive: bool) -> str:\n        \"\"\"Normalizes the string based on case sensitivity.\"\"\"\n        return text if case_sensitive else text.lower()\n\n    @staticmethod\n    def empty_substring_behavior(text: str, substring: str) -> Optional[Tuple[str, int, int]]:\n        \"\"\"Handles the special case where the substring is empty.\"\"\"\n        if substring == \"\":\n            return (\"\", 0, 0)\n        return None\nclass InMemoryOccurrenceRepository:\n    \"\"\"Encapsulates low-level string search operations using built-in methods.\"\"\"\n    def find_first(self, text: str, substring: str) -> int:\n        \"\"\"Finds the first occurrence of a substring, returning its start index or -1.\"\"\"\n        return text.find(substring)\n\n    def find_all(self, text: str, substring: str) -> List[int]:\n        \"\"\"Finds all occurrences of a substring, returning a list of start indices.\"\"\"\n        results = []\n        start = 0\n        while True:\n            idx = text.find(substring, start)\n            if idx == -1:\n                break\n            results.append(idx)\n            start = idx + 1\n        return results\nclass SubstringFinderService:\n    \"\"\"Business logic for finding the first substring occurrence.\"\"\"\n    def __init__(self, repo: InMemoryOccurrenceRepository):\n        \"\"\"Initializes the service with a repository for string operations.\"\"\"\n        self._repo = repo\n\n    def find_first_occurrence(self, text: str, substring: str, case_sensitive: bool = True) -> Optional[Occurrence]:\n        \"\"\"Locates the first occurrence of a substring, respecting case sensitivity.\"\"\"\n        StringUtils.validate_inputs(text, substring)\n\n        if not isinstance(case_sensitive, bool):\n             raise TypeError(\"case_sensitive must be a boolean\")\n\n        empty_behavior = StringUtils.empty_substring_behavior(text, substring)\n        if empty_behavior is not None:\n            sub, start, end = empty_behavior\n            return Occurrence(sub, start, end)\n        \n        normalized_text = StringUtils.normalize(text, case_sensitive)\n        normalized_sub = StringUtils.normalize(substring, case_sensitive)\n        \n        idx = self._repo.find_first(normalized_text, normalized_sub)\n        if idx == -1:\n            return None\n        \n        # Return the original substring and calculated indices\n        return Occurrence(substring, idx, idx + len(substring))\nclass APIController:\n    \"\"\"Controller layer converting service results to the public API tuple format.\"\"\"\n    def __init__(self, service: SubstringFinderService):\n        \"\"\"Initializes the controller with the substring finding service.\"\"\"\n        self._service = service\n\n    def occurance_substring(self, text: str, substring: str, case_sensitive: bool = True) -> Optional[Tuple[str, int, int]]:\n        \"\"\"Delegates to the service and formats the result for the public API.\"\"\"\n        occ = self._service.find_first_occurrence(text, substring, case_sensitive)\n        return occ.to_tuple() if occ is not None else None\nclass PackageAPI:\n    \"\"\"Public facade for the substring finder package, providing default wiring.\"\"\"\n    def __init__(self, controller: APIController):\n        \"\"\"Initializes the package API with a controller instance.\"\"\"\n        self._controller = controller\n\n    @classmethod\n    def default(cls) -> \"PackageAPI\":\n        \"\"\"Factory method to create a PackageAPI with default dependencies.\"\"\"\n        repo = InMemoryOccurrenceRepository()\n        service = SubstringFinderService(repo)\n        controller = APIController(service)\n        return cls(controller)\n\n    def occurance_substring(self, text: str, substring: str, case_sensitive: bool = True) -> Optional[Tuple[str, int, int]]:\n        \"\"\"Main public function to find substring occurrences.\"\"\"\n        return self._controller.occurance_substring(text, substring, case_sensitive)\n_default_api = PackageAPI.default()\ndef occurance_substring(text: str, substring: str, case_sensitive: bool = True) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Finds the first occurrence and position of the substrings within a string.\n    Returns (substring, start_index, end_index) or None if there is no match.\n    \"\"\"\n    return _default_api.occurance_substring(text, substring, case_sensitive)"}
{"task_id": "Mbpp/781", "solution": "import math\ndef count_divisors(n):\n    \"\"\"\n    Checks if the count of positive divisors of an integer is even.\n    Returns True if the count is even, False otherwise.\n    \"\"\"\n    def is_perfect_square(val: int) -> bool:\n        \"\"\"Checks if a non-negative integer is a perfect square.\"\"\"\n        if val < 0:\n            return False # Negative numbers are not perfect squares\n        r = int(math.isqrt(val))\n        return r * r == val\n\n    abs_n = abs(n)\n    \n    # According to the business rules, a perfect square has an odd number of divisors;\n    # all other positive integers have an even number of divisors.\n    return not is_perfect_square(abs_n)"}
{"task_id": "Mbpp/780", "solution": "class Pair:\n    \"\"\"Represents a 2-element integer tuple with element-wise addition.\"\"\"\n    def __init__(self, a: int, b: int) -> None:\n        self.a = a\n        self.b = b\n\n    def to_tuple(self) -> tuple[int, int]:\n        \"\"\"Converts the Pair object to a primitive tuple.\"\"\"\n        return (self.a, self.b)\n\n    def __add__(self, other: \"Pair\") -> \"Pair\":\n        \"\"\"Performs element-wise addition with another Pair object.\"\"\"\n        return Pair(self.a + other.a, self.b + other.b)\ndef to_pair(raw: tuple[int,int]) -> Pair:\n    \"\"\"Converts a primitive tuple to a Pair object.\"\"\"\n    return Pair(raw[0], raw[1])\ndef from_pair(pair: Pair) -> tuple[int,int]:\n    \"\"\"Converts a Pair object to a primitive tuple.\"\"\"\n    return pair.to_tuple()\nclass CombinatorService:\n    \"\"\"Provides business logic for finding combinations of sums of pairs.\"\"\"\n    def find_combinations(self, pairs: list[Pair]) -> list[Pair]:\n        \"\"\"Calculates element-wise sums for all unique unordered pairs.\"\"\"\n        results: list[Pair] = []\n        n = len(pairs)\n        for i in range(n - 1):\n            for j in range(i + 1, n):\n                results.append(pairs[i] + pairs[j])\n        return results\ndef find_combinations(pairs: list[tuple[int,int]]) -> list[tuple[int,int]]:\n    \"\"\"\n    Finds combinations of sums with tuples in the given tuple list.\n    Calculates element-wise sums for all unique unordered pairs of 2-element integer tuples.\n    \"\"\"\n    internal_pairs = [to_pair(t) for t in pairs]\n    svc = CombinatorService()\n    combined_pairs = svc.find_combinations(internal_pairs)\n    return [from_pair(p) for p in combined_pairs]"}
{"task_id": "Mbpp/785", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for invalid input or parsing failures.\"\"\"\n    def __init__(self, message: str, error_code: str | None = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.error_code = error_code\nclass ParseError(ValidationError):\n    \"\"\"Specific exception for parsing failures.\"\"\"\n    pass\nclass TupleDTO:\n    \"\"\"Data transfer object for parsed integer values.\"\"\"\n    def __init__(self, values: list[int]) -> None:\n        self._values = list(values)\n\n    def as_tuple(self) -> tuple[int, ...]:\n        \"\"\"Converts the stored list of integers to a tuple.\"\"\"\n        return tuple(self._values)\nclass StringSanitizer:\n    \"\"\"Utility for cleaning and validating string formats.\"\"\"\n    def sanitize_full(self, s: str) -> str:\n        \"\"\"Strips leading/trailing whitespace from the entire string.\"\"\"\n        return s.strip()\n\n    def ensure_parentheses(self, s: str) -> None:\n        \"\"\"Validates that the string starts and ends with parentheses.\"\"\"\n        if not (s.startswith(\"(\") and s.endswith(\")\")):\n            raise ValidationError(\n                \"Tuple string must start with '(' and end with ')'\", \"MISSING_PARENS\"\n            )\nclass TokenValidator:\n    \"\"\"Utility for validating and converting individual string tokens to integers.\"\"\"\n    def is_int_token(self, token: str) -> bool:\n        \"\"\"Checks if a string token represents a valid integer.\"\"\"\n        t = token.strip()\n        if not t:\n            return False\n        if t.startswith(('+', '-')):\n            t = t[1:]\n        return t.isdigit()\n\n    def parse_int(self, token: str) -> int:\n        \"\"\"Converts a string token to an integer, raising an error if invalid.\"\"\"\n        t = token.strip()\n        if not self.is_int_token(t):\n            raise ParseError(f\"Non-integer token: {token!r}\", \"NON_INTEGER\")\n        try:\n            return int(t)\n        except ValueError:\n            # This should ideally be caught by is_int_token, but added for robustness.\n            raise ParseError(f\"Invalid integer format for token: {token!r}\", \"INVALID_INT_FORMAT\")\nclass TupleParser:\n    \"\"\"Parses a tuple string into a TupleDTO.\"\"\"\n    def __init__(self) -> None:\n        self._sanitizer = StringSanitizer()\n        self._validator = TokenValidator()\n\n    def _strip_parentheses(self, s: str) -> str:\n        \"\"\"Removes the outer parentheses from a string.\"\"\"\n        return s[1:-1]\n\n    def _split_tokens(self, s: str) -> list[str]:\n        \"\"\"Splits the inner string by commas and returns a list of token strings.\"\"\"\n        if not s.strip():\n            return []\n        return [token.strip() for token in s.split(',')]\n\n    def _convert_tokens(self, tokens: list[str]) -> list[int]:\n        \"\"\"Converts a list of string tokens into a list of integers.\"\"\"\n        return [self._validator.parse_int(token) for token in tokens]\n\n    def parse(self, s: str) -> TupleDTO:\n        \"\"\"Parses the input string to a TupleDTO.\"\"\"\n        s_sanitized = self._sanitizer.sanitize_full(s)\n        self._sanitizer.ensure_parentheses(s_sanitized)\n\n        inner_str = self._strip_parentheses(s_sanitized)\n        \n        # Handle empty tuple specifically\n        if not inner_str.strip(): # Also covers '()' where inner_str becomes ''\n            return TupleDTO([])\n\n        tokens = self._split_tokens(inner_str)\n        integers = self._convert_tokens(tokens)\n        return TupleDTO(integers)\nclass TupleService:\n    \"\"\"Orchestrates parsing and converts a tuple string to a Python tuple.\"\"\"\n    def __init__(self, parser: TupleParser | None = None) -> None:\n        self._parser = parser or TupleParser()\n\n    def parse_to_tuple(self, s: str) -> tuple[int, ...]:\n        \"\"\"Parses the input string and returns a tuple of integers.\"\"\"\n        dto = self._parser.parse(s)\n        return dto.as_tuple()\ndef tuple_str_int(s: str) -> tuple[int, ...]:\n    \"\"\"Converts a tuple string (e.g., \"(7, 8, 9)\") to an integer tuple (7, 8, 9).\"\"\"\n    service = TupleService()\n    return service.parse_to_tuple(s)"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(nums: list) -> int:\n    \"\"\"Calculates the sum of all odd-length subarrays in the given list of numbers.\n    The contribution of each element to the total sum is determined efficiently in O(N) time.\"\"\"\n    if not nums:\n        return 0\n\n    n = len(nums)\n    total_sum = 0\n    for i, num in enumerate(nums):\n        # Calculate the total number of subarrays that 'num' (at index 'i') is part of.\n        # This is (count of subarrays starting before or at 'i') * (count of subarrays ending at or after 'i').\n        count_left = i + 1\n        count_right = n - i\n        \n        # Among all subarrays an element is part of, roughly half will have odd length.\n        # The exact count of odd-length subarrays containing 'num' is given by this formula.\n        odd_length_subarray_count = (count_left * count_right + 1) // 2\n        \n        total_sum += num * odd_length_subarray_count\n    \n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "import uuid\nimport datetime\nimport logging\nimport json\nfrom abc import ABC, abstractmethod\nfrom typing import List, Any, Iterable, Optional, Protocol\nfrom dataclasses import dataclass, asdict\nTIMESTAMP_FORMAT: str = \"%Y-%m-%dT%H:%M:%S%z\"\nclass InvalidInputError(Exception):\n    \"\"\"Raised when input cannot be interpreted as a list of integers.\"\"\"\n    pass\nclass NotFoundError(Exception):\n    \"\"\"Raised when the first odd or first even number is not found.\"\"\"\n    pass\nclass PersistenceError(Exception):\n    \"\"\"Raised when repository persistence fails.\"\"\"\n    pass\ndef is_int_like(val: Any) -> bool:\n    \"\"\"Checks if a value can be converted to an integer.\"\"\"\n    try:\n        int(val)\n        return True\n    except (ValueError, TypeError):\n        return False\ndef to_int_list(nums: Iterable[Any]) -> List[int]:\n    \"\"\"Converts an iterable of values to a list of integers.\"\"\"\n    if not isinstance(nums, Iterable):\n        raise InvalidInputError(\"Input must be an iterable.\")\n    if isinstance(nums, (str, bytes)):\n        raise InvalidInputError(\"Input iterable cannot be a string or bytes.\")\n\n    int_list = []\n    for item in nums:\n        if not is_int_like(item):\n            raise InvalidInputError(f\"List contains non-integer convertible value: {item}\")\n        int_list.append(int(item))\n    return int_list\ndef find_first_odd_even(nums: List[int]) -> NumberPair:\n    \"\"\"Finds the first odd and first even numbers in a list.\"\"\"\n    first_odd = None\n    first_even = None\n\n    for num in nums:\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        elif first_even is None and num % 2 == 0:\n            first_even = num\n        \n        if first_odd is not None and first_even is not None:\n            break\n    \n    if first_odd is None:\n        raise NotFoundError(\"No odd number found in the list.\")\n    if first_even is None:\n        raise NotFoundError(\"No even number found in the list.\")\n    \n    return NumberPair(first_odd=first_odd, first_even=first_even)\nclass InputValidator:\n    \"\"\"Validates and normalizes input lists.\"\"\"\n    def validate(self, nums: Any) -> List[int]:\n        \"\"\"Validates the input and converts it to a list of integers.\"\"\"\n        return to_int_list(nums)\nclass LoggerAdapter(Protocol):\n    \"\"\"Abstract interface for logging.\"\"\"\n    def info(self, msg: str) -> None:\n        ...\n    def error(self, msg: str) -> None:\n        ...\nclass StdLoggerAdapter:\n    \"\"\"Standard logging adapter using Python's logging module.\"\"\"\n    def __init__(self, logger_name: str = \"numops\") -> None:\n        self._logger = logging.getLogger(logger_name)\n        if not self._logger.handlers:\n            handler = logging.StreamHandler()\n            formatter = logging.Formatter('%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n            handler.setFormatter(formatter)\n            self._logger.addHandler(handler)\n            self._logger.setLevel(logging.INFO)\n\n    def info(self, msg: str) -> None:\n        \"\"\"Logs an informational message.\"\"\"\n        self._logger.info(msg)\n\n    def error(self, msg: str) -> None:\n        \"\"\"Logs an error message.\"\"\"\n        self._logger.error(msg)\nclass HistoryRepository(ABC):\n    \"\"\"Abstract base class for history repositories.\"\"\"\n    @abstractmethod\n    def save(self, record: HistoryRecord) -> None:\n        \"\"\"Saves a history record.\"\"\"\n        pass\n\n    @abstractmethod\n    def list(self) -> List[HistoryRecord]:\n        \"\"\"Lists all history records.\"\"\"\n        pass\nclass MultiplierService:\n    \"\"\"Service for computing the product of the first even and odd numbers.\"\"\"\n    def __init__(self, validator: InputValidator) -> None:\n        self._validator = validator\n\n    def compute_product(self, nums: Any) -> int:\n        \"\"\"\n        Validates the input, finds the first odd and even numbers,\n        and returns their product.\n        \"\"\"\n        normalized_nums = self._validator.validate(nums)\n        pair = find_first_odd_even(normalized_nums)\n        return pair.first_odd * pair.first_even\ndef mul_even_odd(nums: Any, repository: Optional[HistoryRepository] = None, logger: Optional[LoggerAdapter] = None) -> int:\n    \"\"\"\n    Computes the product of the first even and odd number in a list.\n    Optionally records the operation in a history repository and logs events.\n    \"\"\"\n    if logger is None:\n        logger = StdLoggerAdapter()\n    \n    validator = InputValidator()\n    service = MultiplierService(validator)\n    \n    try:\n        product = service.compute_product(nums)\n        logger.info(f\"Successfully computed product: {product} for input: {nums}\")\n\n        if repository:\n            try:\n                # To save the history record, we need the normalized input list.\n                # Since service.compute_product takes Any and validates internally,\n                # we re-run validation here to get the normalized list for history.\n                normalized_input_for_history = validator.validate(nums)\n\n                now = datetime.datetime.now(datetime.timezone.utc)\n                timestamp_str = now.strftime(TIMESTAMP_FORMAT)\n                \n                record = HistoryRecord(\n                    id=str(uuid.uuid4()),\n                    timestamp=timestamp_str,\n                    input=normalized_input_for_history,\n                    result=product\n                )\n                repository.save(record)\n                logger.info(f\"History record saved for ID: {record.id}\")\n            except PersistenceError as e:\n                logger.error(f\"Failed to save history record due to persistence error: {e}\")\n            except Exception as e:\n                # Catching any other unexpected errors during history record creation or save\n                logger.error(f\"An unexpected error occurred while saving history record: {e}\")\n                \n        return product\n    except (InvalidInputError, NotFoundError) as e:\n        logger.error(f\"Computation failed for input {nums}: {e}\")\n        raise\n    except Exception as e:\n        logger.error(f\"An unexpected error occurred during computation for input {nums}: {e}\")\n        raise"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(sorted_list, value):\n    \"\"\"\n    Locates the right insertion point for a specified value in a sorted list.\n    This function implements a binary search to find the index where 'value' should be inserted\n    to maintain sorted order, placing it to the right of any existing equal elements.\n    \"\"\"\n    lo, hi = 0, len(sorted_list)\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if sorted_list[mid] <= value:\n            lo = mid + 1\n        else:\n            hi = mid\n    return lo"}
{"task_id": "Mbpp/787", "solution": "import re\ndef text_match_three(text: str) -> bool:\n    \"\"\"\n    Checks if the input string contains an 'a' followed by three 'b's.\n    This function uses regular expressions to find the pattern \"abbb\".\n    \"\"\"\n    pattern = r\"ab{3}\"\n    return re.search(pattern, text) is not None"}
{"task_id": "Mbpp/790", "solution": "def even_position(numbers: list) -> bool:\n    \"\"\"\n    Checks if every even index in the list contains an even number.\n    Returns True if all numbers at even indices are even, False otherwise.\n    \"\"\"\n    for i in range(0, len(numbers), 2):\n        if numbers[i] % 2 != 0:\n            return False\n    return True"}
{"task_id": "Mbpp/791", "solution": "def remove_nested(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Removes nested tuple elements from the given tuple.\n    Returns a new tuple with only non-tuple elements, preserving their original order.\n    \"\"\"\n    filtered_elements = []\n    for element in input_tuple:\n        if not isinstance(element, tuple):\n            filtered_elements.append(element)\n    return tuple(filtered_elements)"}
