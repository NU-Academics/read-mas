{"task_id": "Mbpp/245", "solution": "def max_sum(arr: list[int]) -> int:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence for the given array.\n    A sequence is bitonic if it is first increasing and then decreasing.\n    \"\"\"\n    n = len(arr)\n    # Based on design context, input `arr` is guaranteed to be non-empty (n >= 1).\n\n    def _msis(sub_arr: list[int]) -> list[int]:\n        \"\"\"Calculates Maximum Sum Increasing Subsequence (MSIS) ending at each index.\"\"\"\n        m_len = len(sub_arr)\n        msis_values = sub_arr.copy()\n        for i in range(m_len):\n            for j in range(i):\n                if sub_arr[j] < sub_arr[i] and msis_values[j] + sub_arr[i] > msis_values[i]:\n                    msis_values[i] = msis_values[j] + sub_arr[i]\n        return msis_values\n\n    def _msds(sub_arr: list[int]) -> list[int]:\n        \"\"\"Calculates Maximum Sum Decreasing Subsequence (MSDS) starting at each index.\"\"\"\n        m_len = len(sub_arr)\n        msds_values = sub_arr.copy()\n        for i in range(m_len - 1, -1, -1):\n            for j in range(m_len - 1, i, -1):\n                if sub_arr[j] < sub_arr[i] and msds_values[j] + sub_arr[i] > msds_values[i]:\n                    msds_values[i] = msds_values[j] + sub_arr[i]\n        return msds_values\n\n    msis = _msis(arr)\n    msds = _msds(arr)\n\n    # Initialize best sum with the sum corresponding to the first element acting as a peak.\n    # Since n >= 1 is guaranteed, this is a safe initial value.\n    best_sum = msis[0] + msds[0] - arr[0]\n\n    for i in range(n):\n        # A bitonic subsequence with arr[i] as its peak.\n        # Sum is msis ending at arr[i] + msds starting at arr[i] - arr[i] (to avoid double counting).\n        current_total = msis[i] + msds[i] - arr[i]\n        if current_total > best_sum:\n            best_sum = current_total\n\n    return best_sum"}
{"task_id": "Mbpp/253", "solution": "def count_integer(seq):\n    \"\"\"\n    Returns the number of integer elements in a given list, excluding booleans.\n    Handles None input as an empty sequence.\n    \"\"\"\n    if seq is None:\n        return 0\n    count = 0\n    for item in seq:\n        if isinstance(item, int) and not isinstance(item, bool):\n            count += 1\n    return count"}
{"task_id": "Mbpp/252", "solution": "import math\nfrom dataclasses import dataclass\nfrom typing import Any, Union\nclass ConversionError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass AngleUtils:\n    PI = math.pi\n    # EPS = 1e-15 # Not directly used in the provided snippets.\n\n    @staticmethod\n    def normalize(angle: float) -> float:\n        # Normalize angle to the range (-pi, pi]. Raises ValueError for non-finite input.\n        if not math.isfinite(angle):\n            raise ValueError(\"Non-finite angle\")\n        a = (angle + math.pi) % (2 * math.pi) - math.pi\n        return math.pi if a == -math.pi else a\n\n    @staticmethod\n    def is_number(obj: Any) -> bool:\n        # Checks if an object is an integer or float, excluding booleans.\n        return isinstance(obj, (int, float)) and not isinstance(obj, bool)\nclass ConverterService:\n    def __init__(self, utils: AngleUtils = None) -> None:\n        self.utils = utils or AngleUtils()\n\n    def convert_to_polar(self, value: Union[complex, float, int, str]) -> Polar:\n        z = self._parse_input(value)\n        r, theta = self._compute_polar(z)\n        theta_norm = self.utils.normalize(theta)\n        return Polar(radius=r, angle=theta_norm)\n\n    def _parse_input(self, value: Union[complex, float, int, str]) -> complex:\n        if isinstance(value, complex):\n            return value\n        if self.utils.is_number(value):\n            return complex(value, 0.0)\n        if isinstance(value, str):\n            try:\n                return complex(value)\n            except Exception as e:\n                raise ConversionError(f\"Cannot parse string to complex: {value}\") from e\n        raise ConversionError(f\"Unsupported input type: {type(value).__name__}\")\n\n    def _compute_polar(self, z: complex) -> tuple[float, float]:\n        r = math.hypot(z.real, z.imag)\n        theta = math.atan2(z.imag, z.real)\n        return (r, theta)\nclass ConverterController:\n    def __init__(self, service: ConverterService = None):\n        self.service = service or ConverterService()\n\n    def convert(self, value: Union[complex, float, int, str]) -> tuple[float, float]:\n        polar = self.service.convert_to_polar(value)\n        return polar.to_tuple()\n_default_controller = ConverterController()\ndef convert(value: Union[complex, float, int, str]) -> tuple[float, float]:\n    \"\"\"\n    Converts a complex-like number to its polar coordinates (radius, angle).\n    Angle is normalized to the range (-pi, pi].\n    \"\"\"\n    return _default_controller.convert(value)"}
{"task_id": "Mbpp/247", "solution": "import re\nimport datetime\nimport sqlite3\nimport os\nfrom typing import List, Optional, Protocol\ndef lps(s: str) -> int:\n    \"\"\"\n    Finds the length of the longest palindromic subsequence in the given string.\n    The string is normalized by stripping non-alphanumerics and converting to uppercase.\n    \"\"\"\n\n    # 1. Exceptions\n    class InvalidInputError(ValueError):\n        \"\"\"Custom exception for invalid input.\"\"\"\n        pass\n\n    class PersistenceError(RuntimeError):\n        \"\"\"Custom exception for persistence failures.\"\"\"\n        pass\n\n    # 2. Models\n    class LPSResult:\n        \"\"\"DTO for LPS calculation results.\"\"\"\n        def __init__(self, input_raw: str, input_normalized: str, result: int, id: Optional[int] = None, created_at: Optional[datetime.datetime] = None) -> None:\n            self.id = id\n            self.input_raw = input_raw\n            self.input_normalized = input_normalized\n            self.result = result\n            self.created_at = created_at if created_at is not None else datetime.datetime.now()\n\n    # 3. Utils (StringNormalizer)\n    class StringNormalizer:\n        \"\"\"Normalizes input strings by stripping non-alphanumerics and adjusting case.\"\"\"\n        def __init__(self, upper: bool = True, keep_alnum: bool = True):\n            self.upper = upper\n            self.keep_alnum = keep_alnum\n            self._alnum_re = re.compile(r'[^A-Za-z0-9]')\n\n        def normalize(self, text: str) -> str:\n            if not isinstance(text, str):\n                raise InvalidInputError(\"Input must be a string\")\n            out = text\n            if self.keep_alnum:\n                out = self._alnum_re.sub(\"\", out)\n            if self.upper:\n                out = out.upper()\n            return out\n\n    # 4. Core (LPSCalculator)\n    class LPSCalculator:\n        \"\"\"Calculates the length of the Longest Palindromic Subsequence using dynamic programming.\"\"\"\n        def compute(self, s: str) -> int:\n            if not s:\n                return 0\n            n = len(s)\n            dp = [[0] * n for _ in range(n)]\n\n            for i in range(n):\n                dp[i][i] = 1\n\n            for cl in range(2, n + 1): # cl is current length of substring\n                for i in range(0, n - cl + 1):\n                    j = i + cl - 1 # j is ending index of substring\n\n                    if s[i] == s[j]:\n                        dp[i][j] = 2 + (dp[i + 1][j - 1] if i + 1 <= j - 1 else 0)\n                    else:\n                        dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n            return dp[0][n - 1]\n\n    # 5. Repository (LPSRepository and SQLiteLPSRepository)\n    class LPSRepository(Protocol):\n        \"\"\"Interface for LPS result persistence.\"\"\"\n        def save(self, result: LPSResult) -> None: ...\n        def get_by_input(self, input_raw: str) -> Optional[LPSResult]: ...\n\n    class SQLiteLPSRepository:\n        \"\"\"SQLite implementation of LPSRepository to store calculation results.\"\"\"\n        _CREATE_TABLE_SQL = \"\"\"\n            CREATE TABLE IF NOT EXISTS lps_results (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                input_raw TEXT NOT NULL,\n                input_normalized TEXT NOT NULL,\n                result INTEGER NOT NULL,\n                created_at TEXT NOT NULL\n            );\n        \"\"\"\n        _CREATE_INDEX_RAW_SQL = \"CREATE INDEX IF NOT EXISTS idx_input_raw ON lps_results(input_raw);\"\n        _CREATE_INDEX_CREATED_SQL = \"CREATE INDEX IF NOT EXISTS idx_created_at ON lps_results(created_at);\"\n        _INSERT_SQL = \"\"\"\n            INSERT INTO lps_results (input_raw, input_normalized, result, created_at)\n            VALUES (?, ?, ?, ?);\n        \"\"\"\n        _SELECT_SQL = \"\"\"\n            SELECT id, input_raw, input_normalized, result, created_at\n            FROM lps_results WHERE input_raw = ? ORDER BY created_at DESC LIMIT 1;\n        \"\"\"\n\n        def __init__(self, db_path: str = \"data/lps_results.db\") -> None:\n            self._db_path = db_path\n            os.makedirs(os.path.dirname(self._db_path), exist_ok=True)\n            self._ensure_schema()\n\n        def _get_connection(self) -> sqlite3.Connection:\n            return sqlite3.connect(self._db_path)\n\n        def _ensure_schema(self) -> None:\n            try:\n                with self._get_connection() as conn:\n                    cursor = conn.cursor()\n                    cursor.execute(self._CREATE_TABLE_SQL)\n                    cursor.execute(self._CREATE_INDEX_RAW_SQL)\n                    cursor.execute(self._CREATE_INDEX_CREATED_SQL)\n                    conn.commit()\n            except sqlite3.Error as e:\n                raise PersistenceError(f\"Failed to ensure DB schema: {e}\") from e\n\n        def save(self, result: LPSResult) -> None:\n            try:\n                with self._get_connection() as conn:\n                    cursor = conn.cursor()\n                    cursor.execute(\n                        self._INSERT_SQL,\n                        (result.input_raw, result.input_normalized, result.result, result.created_at.isoformat())\n                    )\n                    result.id = cursor.lastrowid\n                    conn.commit()\n            except sqlite3.Error as e:\n                raise PersistenceError(f\"Failed to save LPS result: {e}\") from e\n\n        def get_by_input(self, input_raw: str) -> Optional[LPSResult]:\n            try:\n                with self._get_connection() as conn:\n                    cursor = conn.cursor()\n                    cursor.execute(self._SELECT_SQL, (input_raw,))\n                    row = cursor.fetchone()\n                    if row:\n                        id, raw, normalized, res, created_at_str = row\n                        return LPSResult(\n                            id=id,\n                            input_raw=raw,\n                            input_normalized=normalized,\n                            result=res,\n                            created_at=datetime.datetime.fromisoformat(created_at_str)\n                        )\n                    return None\n            except sqlite3.Error as e:\n                raise PersistenceError(f\"Failed to retrieve LPS result: {e}\") from e\n\n    # 6. Service (LPSService)\n    class LPSService:\n        \"\"\"Orchestrates LPS computation, normalization, and persistence.\"\"\"\n        def __init__(self, calculator: LPSCalculator, normalizer: StringNormalizer, repository: Optional[LPSRepository] = None) -> None:\n            self._calc = calculator\n            self._norm = normalizer\n            self._repo = repository\n\n        def compute_lps(self, text: str) -> int:\n            if not isinstance(text, str):\n                raise InvalidInputError(\"Input 'text' must be a string.\")\n\n            normalized = self._norm.normalize(text)\n            length = self._calc.compute(normalized)\n\n            if self._repo:\n                try:\n                    result = LPSResult(input_raw=text, input_normalized=normalized, result=length)\n                    self._repo.save(result)\n                except PersistenceError:\n                    # Persistence failures are logged and do not block computation.\n                    pass # In a production environment, use a proper logger here.\n            return length\n\n    # Configuration constants (as per design context)\n    DB_PATH = \"data/lps_results.db\"\n    NORMALIZE_UPPER = True\n    KEEP_ONLY_ALNUM = True\n\n    # Instantiate components and service\n    normalizer = StringNormalizer(upper=NORMALIZE_UPPER, keep_alnum=KEEP_ONLY_ALNUM)\n    calculator = LPSCalculator()\n    repository = SQLiteLPSRepository(db_path=DB_PATH)\n    service = LPSService(calculator, normalizer, repository)\n\n    # Call the service to compute LPS\n    return service.compute_lps(s)"}
{"task_id": "Mbpp/255", "solution": "import itertools\ndef combinations_colors(list, n):\n    \"\"\"Generates all combinations with repetition of elements from the input list.\n\n    Returns a list of tuples, where each tuple is a combination of length n.\n    \"\"\"\n    return [tuple(list[i] for i in combo_indices)\n            for combo_indices in itertools.combinations_with_replacement(range(len(list)), n)]"}
