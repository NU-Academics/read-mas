{"task_id": "Mbpp/643", "solution": "import re\nfrom typing import List, Tuple, Union\nclass MatchDTO:\n    def __init__(self, word: str, start: int, end: int):\n        self.word = word\n        self.start = start\n        self.end = end\nclass MatchResult:\n    def __init__(self, found: bool, matched_words: List[str], positions: List[Tuple[int, int]]):\n        self.found = found\n        self.matched_words = matched_words\n        self.positions = positions\n\n    def to_bool(self) -> bool:\n        return self.found\nclass Config:\n    def __init__(self):\n        self.case_sensitive: bool = True\n        self.word_char_class: str = r\"\\w\"\n        self.regex_flags: int = 0\n        self.match_pattern: str = r\"\\b\\w+z\\w+\\b\"\nclass RegexAdapter:\n    def __init__(self, re_module=re):\n        self._re = re_module\n\n    def find_matches(self, text: str, pattern: str, flags: int) -> List[MatchDTO]:\n        matches = []\n        it = self._re.finditer(pattern, text, flags)\n        for m in it:\n            matches.append(MatchDTO(word=m.group(0), start=m.start(), end=m.end()))\n        return matches\nclass TextMatcherService:\n    def __init__(self, regex_adapter: RegexAdapter, config: Config):\n        self._regex_adapter = regex_adapter\n        self._config = config\n\n    def match_z_middle(self, text: str) -> MatchResult:\n        matches_dtos = self._regex_adapter.find_matches(\n            text=text,\n            pattern=self._config.match_pattern,\n            flags=self._config.regex_flags\n        )\n\n        found = len(matches_dtos) > 0\n        matched_words = [dto.word for dto in matches_dtos]\n        positions = [(dto.start, dto.end) for dto in matches_dtos]\n\n        return MatchResult(found=found, matched_words=matched_words, positions=positions)\ndef text_match_wordz_middle(text: str) -> bool:\n    \"\"\"Checks if any word in the string contains 'z' not at its start or end.\"\"\"\n    cfg = Config()\n    adapter = RegexAdapter()\n    svc = TextMatcherService(regex_adapter=adapter, config=cfg)\n    return svc.match_z_middle(text).to_bool()"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(arr: list, k: int) -> list:\n    \"\"\"\n    Reverses the elements of an array up to a given position k and returns a new list.\n    If k is greater than the array's length, the entire array is reversed.\n    \"\"\"\n    n = len(arr)\n    # Determine the actual number of elements to reverse\n    # The min() function handles cases where k is greater than the array length.\n    elements_to_reverse = min(k, n)\n\n    # Slice the array into the part to be reversed and the remainder.\n    prefix_to_reverse = arr[:elements_to_reverse]\n    remainder = arr[elements_to_reverse:]\n\n    # Reverse the prefix and concatenate it with the unchanged remainder.\n    reversed_prefix = list(reversed(prefix_to_reverse))\n\n    return reversed_prefix + remainder"}
