{"task_id": "Mbpp/610", "solution": "def remove_kth_element(items, k):\n    \"\"\"\n    Returns a new list with the k'th element (1-based index) removed.\n    The original list is not modified.\n    \"\"\"\n    index_to_remove = k - 1\n    return items[:index_to_remove] + items[index_to_remove + 1:]"}
{"task_id": "Mbpp/611", "solution": "from typing import List, Union, Any\nNumber = Union[int, float]\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation errors with a message and code.\"\"\"\n    def __init__(self, message: str, code: str = \"validation_error\") -> None:\n        self.message = message\n        self.code = code\n        super().__init__(message)\nclass Utils:\n    \"\"\"Utility methods for parsing values into numeric types.\"\"\"\n    @staticmethod\n    def parse_numeric(value: Any) -> Number:\n        if isinstance(value, (int, float)):\n            return value\n        if isinstance(value, str):\n            try:\n                if '.' in value:\n                    return float(value)\n                return int(value)\n            except ValueError:\n                raise ValueError(f\"Value '{value}' is not numeric\")\n        raise ValueError(f\"Unsupported numeric type: {type(value)}\")\nclass Matrix:\n    \"\"\"Represents matrix data as a list of lists and provides accessors.\"\"\"\n    def __init__(self, rows: List[List[Any]]) -> None:\n        self.rows: List[List[Any]] = list(rows)\n\n    def ncols(self) -> int:\n        return len(self.rows[0]) if self.rows else 0\n\n    def nrows(self) -> int:\n        return len(self.rows)\n\n    def column(self, n: int) -> List[Any]:\n        return [row[n] for row in self.rows]\nclass MatrixValidator:\n    \"\"\"Validates the structure, column index, and numeric content of a matrix.\"\"\"\n    def validate_structure(self, matrix: Matrix) -> None:\n        if not matrix.rows:\n            raise ValidationError(\"Matrix is empty\", code=\"empty_matrix\")\n        \n        num_cols = matrix.ncols()\n        if num_cols == 0:\n            raise ValidationError(\"Matrix has zero columns (e.g. [[], [], []])\", code=\"zero_columns\")\n\n        for i, row in enumerate(matrix.rows):\n            if not isinstance(row, list):\n                 raise ValidationError(f\"Row {i} is not a list\", code=\"invalid_row_type\")\n            if len(row) != num_cols:\n                raise ValidationError(f\"Row {i} has {len(row)} columns, expected {num_cols} (ragged rows)\", code=\"ragged_rows\")\n\n    def validate_column_index(self, matrix: Matrix, n: int) -> None:\n        if not matrix.rows:\n            raise ValidationError(\"Cannot validate column index on an empty matrix\", code=\"empty_matrix_index\")\n\n        num_cols = matrix.ncols()\n        if not (0 <= n < num_cols):\n            raise ValidationError(f\"Column index {n} is out of range for matrix with {num_cols} columns\", code=\"index_out_of_range\")\n\n    def validate_column_numeric(self, matrix: Matrix, n: int) -> None:\n        if not matrix.rows:\n            return \n        \n        for i, row in enumerate(matrix.rows):\n            try:\n                Utils.parse_numeric(row[n])\n            except ValueError as e:\n                raise ValidationError(f\"Non-numeric value at row {i}, column {n}: '{row[n]}' - {e}\", code=\"non_numeric_value\")\n\n    def validate(self, matrix: Matrix, n: int) -> None:\n        self.validate_structure(matrix)\n        self.validate_column_index(matrix, n)\n        self.validate_column_numeric(matrix, n)\nclass MatrixService:\n    \"\"\"Provides business logic for matrix operations, specifically finding column maxima.\"\"\"\n    def __init__(self, validator: MatrixValidator) -> None:\n        self._validator = validator\n\n    def max_of_nth(self, matrix: Matrix, n: int) -> Number:\n        self._validator.validate(matrix, n)\n        values = matrix.column(n)\n        nums = [Utils.parse_numeric(v) for v in values]\n        return max(nums)\ndef max_of_nth(matrix: List[List[Any]], n: int) -> Number:\n    \"\"\"\n    Returns the maximum value of the n'th column in a given matrix, after validation.\n    The matrix must be rectangular, non-empty, and the target column must contain numeric values.\n    \"\"\"\n    matrix_obj = Matrix(matrix)\n    validator = MatrixValidator()\n    service = MatrixService(validator)\n    return service.max_of_nth(matrix_obj, n)"}
{"task_id": "Mbpp/612", "solution": "def merge(list_of_lists):\n    \"\"\"\n    Splits a list of two-element sublists into two separate lists.\n    The first returned list contains all first elements, and the second contains all second elements.\n    \"\"\"\n    first_elements = []\n    second_elements = []\n    for sublist in list_of_lists:\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n    return [first_elements, second_elements]"}
