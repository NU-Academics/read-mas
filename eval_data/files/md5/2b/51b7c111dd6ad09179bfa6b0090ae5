{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(lists):\n    \"\"\"\n    Finds common elements in given nested lists.\n    Assumes lists are validated by a repository layer and contain hashable elements.\n    \"\"\"\n    if not lists or any(not inner_list for inner_list in lists):\n        return set()\n\n    # Start with the smallest list converted to a set to optimize intersections\n    # This aligns with the NFR for O(M*N) average complexity.\n    sorted_lists = sorted(lists, key=len)\n    common_elements = set(sorted_lists[0])\n\n    for i in range(1, len(sorted_lists)):\n        current_list_set = set(sorted_lists[i])\n        common_elements.intersection_update(current_list_set)\n        # If at any point the intersection becomes empty, no common elements exist\n        if not common_elements:\n            return set()\n\n    return common_elements"}
{"task_id": "Mbpp/119", "solution": "def search(nums: list[int]) -> int:\n    \"\"\"Finds the single unique element in a sorted array where every other element appears twice.\"\"\"\n    lo, hi = 0, len(nums) - 1\n\n    while lo < hi:\n        mid = (lo + hi) // 2\n        # Ensure mid points to the start of a potential pair (even index)\n        if mid % 2 == 1:\n            mid -= 1\n\n        # Check if elements at mid and mid+1 form a pair\n        if nums[mid] == nums[mid + 1]:\n            # If they form a pair, the unique element must be to the right\n            lo = mid + 2\n        else:\n            # If they don't form a pair, nums[mid] could be the unique element,\n            # or the unique element is to the left (before mid)\n            hi = mid\n            \n    # When lo == hi, we've found the index of the single element\n    return nums[lo]"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(list_of_tuples):\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples.\n    Returns 0 if the input list is empty.\n    \"\"\"\n    absolute_products = [abs(a * b) for a, b in list_of_tuples]\n\n    if not absolute_products:\n        return 0\n\n    max_val = max(absolute_products)\n\n    # Return as int if the value is an integer, else float.\n    if max_val.is_integer():\n        return int(max_val)\n    return max_val"}
{"task_id": "Mbpp/124", "solution": "import math\nfrom dataclasses import dataclass\nclass InvalidComplexInputError(ValueError):\n    \"\"\"Custom exception for invalid complex number input.\"\"\"\n    pass\nclass InputValidator:\n    \"\"\"Validates and normalizes various inputs into a ComplexNumber object.\"\"\"\n    def validate_and_normalize(self, value: object) -> ComplexNumber:\n        if isinstance(value, complex):\n            return ComplexNumber.from_complex(value)\n        if isinstance(value, (int, float)):\n            return ComplexNumber(float(value), 0.0)\n        if isinstance(value, (tuple, list)):\n            if len(value) == 2:\n                try:\n                    return ComplexNumber.from_tuple((value[0], value[1]))\n                except (TypeError, InvalidComplexInputError) as e:\n                    raise InvalidComplexInputError(f\"Invalid numeric pair input: {e}\") from e\n            else:\n                raise InvalidComplexInputError(\"Tuple or list input must have exactly two numeric elements (real, imag).\")\n        raise InvalidComplexInputError(f\"Unsupported input type: {type(value).__name__} for complex number conversion.\")\nclass CacheAdapter:\n    \"\"\"Abstract base class for a caching mechanism.\"\"\"\n    def get(self, key: str):\n        raise NotImplementedError\n\n    def set(self, key: str, value: float) -> None:\n        raise NotImplementedError\n\n    def clear(self) -> None:\n        raise NotImplementedError\nclass InMemoryCache(CacheAdapter):\n    \"\"\"An in-memory dictionary-based cache for storing computed angles.\"\"\"\n    def __init__(self):\n        self._store = {}\n\n    def get(self, key: str):\n        return self._store.get(key)\n\n    def set(self, key: str, value: float) -> None:\n        self._store[key] = value\n\n    def clear(self) -> None:\n        self._store.clear()\nclass AngleCalculator:\n    \"\"\"Calculates the angle of a ComplexNumber, optionally using a cache.\"\"\"\n    def __init__(self, cache: CacheAdapter | None = None) -> None:\n        self._cache = cache\n\n    def compute_angle(self, cn: ComplexNumber) -> float:\n        # Use a precise string format for the cache key to handle float precision.\n        key = f\"{cn.real:.17g}:{cn.imag:.17g}\"\n        \n        if self._cache:\n            cached = self._cache.get(key)\n            if cached is not None:\n                return float(cached)\n\n        angle = math.atan2(cn.imag, cn.real)\n        \n        if self._cache:\n            try:\n                self._cache.set(key, angle)\n            except Exception:\n                # Log cache errors if logging is configured, but do not fail computation.\n                pass \n        return float(angle)\nclass AngleController:\n    \"\"\"Orchestrates validation and angle calculation for complex number inputs.\"\"\"\n    def __init__(self, validator: InputValidator, calculator: AngleCalculator):\n        self._validator = validator\n        self._calculator = calculator\n\n    def angle_complex(self, value: object) -> float:\n        cn = self._validator.validate_and_normalize(value)\n        return self._calculator.compute_angle(cn)\n_input_validator = InputValidator()\n_in_memory_cache = InMemoryCache()\n_angle_calculator = AngleCalculator(cache=_in_memory_cache)\n_angle_controller = AngleController(validator=_input_validator, calculator=_angle_calculator)\ndef angle_complex(value: object) -> float:\n    \"\"\"\n    Computes the angle (argument) of a complex number from various input types.\n    The angle is returned in radians in the range (-pi, pi].\n    \"\"\"\n    return _angle_controller.angle_complex(value)"}
{"task_id": "Mbpp/123", "solution": "import os\nimport json\nfrom math import isqrt\nfrom typing import Optional, Dict\nclass DivisorCalculator:\n    \"\"\"Calculates the sum of proper divisors for a given number.\"\"\"\n    MIN_VALID_NUMBER: int = 1\n\n    def compute(self, n: int) -> int:\n        \"\"\"Returns the sum of proper divisors of n.\"\"\"\n        # Assuming n is an integer >= 1 based on completion constraints.\n        if n == 1:\n            return 0\n        total = 1\n        limit = isqrt(n)\n        for i in range(2, limit + 1):\n            if n % i == 0:\n                total += i\n                other = n // i\n                if other != i:\n                    total += other\n        return total\nclass CacheRepository:\n    \"\"\"Provides in-memory caching and optional JSON persistence for divisor sums.\"\"\"\n    DEFAULT_CACHE_PATH = \"data/amicable_cache.json\"\n\n    def __init__(self, cache: Optional[Dict[int, int]] = None, path: Optional[str] = None) -> None:\n        self._cache = cache or {}\n        self._path = path if path is not None else self.DEFAULT_CACHE_PATH\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a divisor sum from the cache.\"\"\"\n        return self._cache.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a divisor sum in the cache.\"\"\"\n        self._cache[n] = value\n\n    def load(self) -> None:\n        \"\"\"Loads cache from the JSON file.\"\"\"\n        try:\n            if os.path.exists(self._path):\n                with open(self._path, \"r\", encoding=\"utf-8\") as f:\n                    data = json.load(f)\n                    self._cache.update({int(k): int(v) for k, v in data.items()})\n        except Exception:\n            # Errors during load are logged and ignored per design context.\n            pass\n\n    def save(self) -> None:\n        \"\"\"Saves cache to the JSON file using atomic write.\"\"\"\n        try:\n            os.makedirs(os.path.dirname(self._path), exist_ok=True)\n            tmp = self._path + \".tmp\"\n            with open(tmp, \"w\", encoding=\"utf-8\") as f:\n                json.dump({str(k): v for k, v in self._cache.items()}, f)\n            os.replace(tmp, self._path)\n        except Exception:\n            # Errors during save are logged and ignored per design context.\n            pass\nclass AmicableService:\n    \"\"\"Orchestrates the computation and detection of amicable numbers.\"\"\"\n    def __init__(self, divisor_calc: DivisorCalculator, cache_repo: CacheRepository) -> None:\n        self._divisor_calc = divisor_calc\n        self._cache_repo = cache_repo\n\n    def _get_divisor_sum(self, n: int) -> int:\n        \"\"\"Helper to get divisor sum, using cache or computing if needed.\"\"\"\n        cached_sum = self._cache_repo.get(n)\n        if cached_sum is not None:\n            return cached_sum\n        \n        computed_sum = self._divisor_calc.compute(n)\n        self._cache_repo.set(n, computed_sum)\n        return computed_sum\n\n    def is_amicable(self, n: int) -> bool:\n        \"\"\"Determines if a number n is amicable.\"\"\"\n        # Assuming n is an integer >= 2 based on completion constraints.\n        s_n = self._get_divisor_sum(n)\n        \n        # A number cannot be amicable if s(n) <= n (e.g., perfect numbers or deficient numbers)\n        if s_n <= n:\n            return False\n\n        s_m = self._get_divisor_sum(s_n)\n        \n        # n and s_n are amicable if s(n) = s_n and s(s_n) = n, AND n != s_n.\n        # The s_n <= n check already handles n != s_n and also s_n <= 1 for n >= 2.\n        return s_m == n\n\n    def sum_amicable_numbers(self, limit: int) -> int:\n        \"\"\"Sums all amicable numbers up to the specified limit.\"\"\"\n        # Assuming limit is an integer >= 2 based on completion constraints.\n        total_sum = 0\n        for n in range(2, limit + 1):\n            if self.is_amicable(n):\n                total_sum += n\n        return total_sum\ndef amicable_numbers_sum(limit: int, *, persist_cache: bool = False, cache_path: Optional[str] = None) -> int:\n    \"\"\"Sums all amicable numbers from 1 up to the specified limit.\"\"\"\n    # Assuming limit is an integer >= 2 based on completion constraints.\n    calc = DivisorCalculator()\n    repo = CacheRepository(path=cache_path)\n    \n    if persist_cache:\n        repo.load()\n    \n    srv = AmicableService(calc, repo)\n    result = srv.sum_amicable_numbers(limit)\n    \n    if persist_cache:\n        repo.save()\n        \n    return result"}
{"task_id": "Mbpp/125", "solution": "def find_length(s: str) -> int:\n    \"\"\"\n    Computes the maximum difference between the number of 0s and 1s in any substring.\n    This is achieved by transforming '0' to +1 and '1' to -1, then applying Kadane's algorithm.\n    \"\"\"\n    max_current = 0\n    max_global = 0\n    for char in s:\n        value = 1 if char == '0' else -1\n        max_current = max(value, max_current + value)\n        max_global = max(max_global, max_current)\n    return max_global"}
