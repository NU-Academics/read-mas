{"task_id": "Mbpp/281", "solution": "from typing import Any, Iterable, Type\nfrom dataclasses import dataclass\nclass BaseStrategy:\n    \"\"\"Abstract base class for uniqueness checking strategies.\"\"\"\n    def add_and_check(self, item: Any) -> bool:\n        \"\"\"Adds an item and returns True if it's a duplicate.\"\"\"\n        raise NotImplementedError\n\n    def reset(self) -> None:\n        \"\"\"Resets the strategy's internal state.\"\"\"\n        raise NotImplementedError\nclass HashSetStrategy(BaseStrategy):\n    \"\"\"Strategy using a hash set for O(1) average time complexity.\"\"\"\n    def __init__(self) -> None:\n        self._seen: set[Any] = set()\n\n    def add_and_check(self, item: Any) -> bool:\n        \"\"\"Adds item to set; returns True if item was already seen.\"\"\"\n        if item in self._seen:\n            return True\n        self._seen.add(item)\n        return False\n\n    def reset(self) -> None:\n        \"\"\"Clears the set of seen items.\"\"\"\n        self._seen.clear()\nclass EqualityListStrategy(BaseStrategy):\n    \"\"\"Strategy using a list for O(N) worst-case time complexity per item.\"\"\"\n    def __init__(self) -> None:\n        self._seen: list[Any] = []\n\n    def add_and_check(self, item: Any) -> bool:\n        \"\"\"Adds item to list; returns True if item was already seen by equality.\"\"\"\n        if item in self._seen:\n            return True\n        self._seen.append(item)\n        return False\n\n    def reset(self) -> None:\n        \"\"\"Clears the list of seen items.\"\"\"\n        self._seen.clear()\nclass UniqueService:\n    \"\"\"Orchestrates uniqueness checking, selecting strategy and handling fallbacks.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def is_all_unique(self, seq: Iterable[Any]) -> UniqueResult:\n        \"\"\"\n        Checks if all elements in the sequence are unique, falling back to\n        an equality-based strategy if unhashable elements are encountered.\n        \"\"\"\n        current_strategy: BaseStrategy = HashSetStrategy()\n        strategy_name = \"HashSetStrategy\"\n        items_buffered: list[Any] = [] # Buffer items to re-process on fallback\n\n        is_unique = True\n        total_checked_count = 0\n\n        seq_iterator = iter(seq)\n\n        try:\n            while True:\n                try:\n                    item = next(seq_iterator)\n                except StopIteration:\n                    break # Sequence exhausted\n\n                items_buffered.append(item)\n                total_checked_count += 1\n\n                if current_strategy.add_and_check(item):\n                    is_unique = False\n                    break # Duplicate found\n        except TypeError:\n            # An unhashable item was encountered by HashSetStrategy. Fallback to EqualityListStrategy.\n            strategy_name = \"EqualityListStrategy\"\n            current_strategy = EqualityListStrategy()\n            current_strategy.reset()\n\n            # Re-process all buffered items with the new strategy\n            for buffered_item in items_buffered:\n                if current_strategy.add_and_check(buffered_item):\n                    is_unique = False\n                    break\n\n            # If still unique after re-processing buffered items, continue with the rest of the sequence\n            if is_unique:\n                for item in seq_iterator: # Continue from where we left off\n                    total_checked_count += 1\n                    if current_strategy.add_and_check(item):\n                        is_unique = False\n                        break\n\n        return UniqueResult(is_unique, total_checked_count, strategy_name)\nclass ApiFacade:\n    \"\"\"Provides a simple public API function for consumers, wrapping UniqueService.\"\"\"\n    def __init__(self, service: UniqueService | None = None) -> None:\n        self.service = service or UniqueService()\n\n    def all_unique(self, seq: Iterable[Any]) -> bool:\n        \"\"\"Checks if all elements in the sequence are unique.\"\"\"\n        result = self.service.is_all_unique(seq)\n        return result.unique\n_default_api = ApiFacade()\ndef all_unique(seq: Iterable[Any]) -> bool:\n    \"\"\"\n    Checks if the elements of a given list are unique or not.\n    \"\"\"\n    return _default_api.all_unique(seq)"}
