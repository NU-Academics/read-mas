{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(keys: Sequence[str], *value_lists: Sequence, policy: str = 'strict') -> list[dict]:\n    \"\"\"\n    Converts multiple parallel lists into a list of nested dictionaries,\n    where the first list provides top-level keys and subsequent lists form nested structures.\n    \"\"\"\n    from typing import Sequence, List, Dict, Any, Tuple, Iterator, Optional\n    import json\n\n    class ConversionError(Exception):\n        \"\"\"Base domain conversion exception.\"\"\"\n        pass\n\n    class ValidationError(ConversionError):\n        \"\"\"Input validation specific errors.\"\"\"\n        pass\n\n    # RepositoryError is defined per design context but not directly used by this function.\n    # class RepositoryError(Exception):\n    #     \"\"\"Errors during persistence.\"\"\"\n    #     pass\n\n    class ListsDTO:\n        \"\"\"DTO to represent validated, normalized input lists and policy.\"\"\"\n        def __init__(self, keys: Sequence[str], value_lists: Sequence[Sequence], policy: str='strict') -> None:\n            self.keys: list[str] = list(keys)\n            self.value_lists: list[list] = [list(vl) for vl in value_lists]\n            self.policy: str = policy\n\n    class EntryDTO:\n        \"\"\"DTO to represent one row/entry (top key + nested keys/values).\"\"\"\n        def __init__(self, top_key: str, nested_keys: Sequence) -> None:\n            self.top_key: str = top_key\n            self.nested_keys: list = list(nested_keys)\n\n    class ResultDTO:\n        \"\"\"DTO to represent conversion result (list of nested dicts).\"\"\"\n        def __init__(self, entries: Sequence[dict]) -> None:\n            self.entries: list[dict] = list(entries)\n\n        def to_json(self) -> str:\n            \"\"\"Converts the result entries to a JSON string.\"\"\"\n            return json.dumps(self.entries)\n\n    def pairwise_zip(*sequences: Sequence) -> Iterator[Tuple]:\n        \"\"\"Yields tuples of elements by index, ensuring all sequences are iterated together.\"\"\"\n        return zip(*sequences)\n\n    def normalize_length(sequences: Sequence[Sequence], policy: str='strict') -> Tuple[List[List], int]:\n        \"\"\"Normalizes list lengths based on policy and returns normalized lists and effective length.\"\"\"\n        if not sequences:\n            return [], 0\n\n        list_of_lists = [list(s) for s in sequences]\n        current_lengths = [len(s) for s in list_of_lists]\n\n        if policy == 'strict':\n            if not all(l == current_lengths[0] for l in current_lengths):\n                raise ValidationError(\"Lists must have equal length in 'strict' policy.\")\n            effective_length = current_lengths[0]\n            return list_of_lists, effective_length\n        elif policy == 'truncate':\n            effective_length = min(current_lengths)\n            normalized_lists = [s[:effective_length] for s in list_of_lists]\n            return normalized_lists, effective_length\n        elif policy == 'pad':\n            effective_length = max(current_lengths)\n            normalized_lists = [s + [None] * (effective_length - len(s)) for s in list_of_lists]\n            return normalized_lists, effective_length\n        else:\n            raise ValueError(f\"Unknown policy: {policy}\")\n\n    class ListValidator:\n        \"\"\"Validates input types and applies length policy.\"\"\"\n        def __init__(self, policy: str='strict') -> None:\n            self.policy: str = policy\n\n        def _check_types(self, seq: Sequence) -> None:\n            \"\"\"Ensures sequence supports indexing and len().\"\"\"\n            if not hasattr(seq, '__len__') or not hasattr(seq, '__getitem__'):\n                raise ValidationError(\"Input must be a sequence (e.g., list, tuple).\")\n\n        def validate_lists(self, keys_seq: Sequence, value_lists_seq: Sequence[Sequence]) -> ListsDTO:\n            \"\"\"Checks types, lengths, applies policy, and returns ListsDTO.\"\"\"\n            self._check_types(keys_seq)\n            for seq in value_lists_seq:\n                self._check_types(seq)\n\n            all_lists_for_normalization = [list(keys_seq)] + [list(vl) for vl in value_lists_seq]\n            normalized_all_lists, _ = normalize_length(all_lists_for_normalization, policy=self.policy)\n\n            keys_norm = normalized_all_lists[0]\n            values_norm = normalized_all_lists[1:]\n            return ListsDTO(keys=keys_norm, value_lists=values_norm, policy=self.policy)\n\n    class NestedDictFactory:\n        \"\"\"Builds nested dictionary structure generically for N lists.\"\"\"\n        def __init__(self) -> None:\n            pass\n\n        def _build_for_row(self, nested_values: list) -> Any:\n            \"\"\"Builds the nested dictionary part from a list of values.\"\"\"\n            if not nested_values:\n                return None\n\n            current_nested_structure = nested_values[-1]\n\n            for i in range(len(nested_values) - 2, -1, -1):\n                key = nested_values[i]\n                try:\n                    hash(key)\n                except TypeError:\n                    raise ConversionError(f\"Unhashable key encountered: {key}\")\n                current_nested_structure = {key: current_nested_structure}\n\n            return current_nested_structure\n\n        def build(self, lists_dto: ListsDTO) -> ResultDTO:\n            \"\"\"Creates a ResultDTO by building nested dictionaries from ListsDTO.\"\"\"\n            entries = []\n            for row in pairwise_zip(lists_dto.keys, *lists_dto.value_lists):\n                top_key = row[0]\n                nested_values_for_row = list(row[1:])\n\n                nested_dict_part = self._build_for_row(nested_values_for_row)\n\n                entries.append({top_key: nested_dict_part})\n\n            return ResultDTO(entries)\n\n    class ConverterService:\n        \"\"\"High-level API: validate, build, and optionally persist conversion results.\"\"\"\n        def __init__(self, validator: ListValidator, factory: NestedDictFactory, repository: Any = None) -> None:\n            self.validator: ListValidator = validator\n            self.factory: NestedDictFactory = factory\n            self.repository: Any = repository\n\n        def convert(self, keys_arg: Sequence, *value_lists_arg: Sequence, policy: str='strict') -> ResultDTO:\n            \"\"\"Orchestrates validation and factory building, returns ResultDTO.\"\"\"\n            lists_dto = self.validator.validate_lists(keys_arg, value_lists_arg)\n            result = self.factory.build(lists_dto)\n            return result\n\n    validator = ListValidator(policy=policy)\n    factory = NestedDictFactory()\n    service = ConverterService(validator, factory)\n    result = service.convert(keys, *value_lists, policy=policy)\n    return result.entries"}
{"task_id": "Mbpp/395", "solution": "def first_non_repeating_character(s: str) -> Optional[str]:\n    \"\"\"\n    Finds the first non-repeated character in a given string.\n    Returns the character or None if no non-repeating character is found.\n    \"\"\"\n    from typing import Optional\n\n    counts = {}\n    for char in s:\n        counts[char] = counts.get(char, 0) + 1\n\n    for char in s:\n        if counts[char] == 1:\n            return char\n\n    return None"}
{"task_id": "Mbpp/397", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input types.\"\"\"\n    pass\ndef safe_cast_to_float(value: object) -> float:\n    \"\"\"Converts a value to float, raising InvalidInputError if unsuccessful.\"\"\"\n    if isinstance(value, (int, float)):\n        return float(value)\n    if isinstance(value, str):\n        try:\n            return float(value.strip())\n        except ValueError:\n            raise InvalidInputError(f\"Cannot convert string to float: {value!r}\")\n    raise InvalidInputError(f\"Unsupported type for numeric conversion: {type(value).__name__}\")\nclass NumericTriple:\n    \"\"\"Represents three numeric values and provides median calculation.\"\"\"\n    def __init__(self, a: float, b: float, c: float) -> None:\n        self.a = a\n        self.b = b\n        self.c = c\n\n    def as_sorted_list(self) -> list[float]:\n        \"\"\"Returns the numbers as a sorted list.\"\"\"\n        return sorted([self.a, self.b, self.c])\n\n    def median(self) -> float:\n        \"\"\"Calculates and returns the median value.\"\"\"\n        return self.as_sorted_list()[1]\nclass MedianRepository:\n    \"\"\"A no-op repository for storing call records, allowing future extension.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def store_call(self, a: float, b: float, c: float, result: float) -> None:\n        pass\nclass MedianService:\n    \"\"\"Business logic for median calculation, using NumericTriple and MedianRepository.\"\"\"\n    def __init__(self, repository: 'MedianRepository') -> None:\n        self.repository = repository\n\n    def calculate_median(self, a: float, b: float, c: float) -> float:\n        \"\"\"Calculates the median of three floats and stores the call.\"\"\"\n        triple = NumericTriple(a, b, c)\n        result = triple.median()\n        self.repository.store_call(a, b, c, result)\n        return float(result)\nclass MedianController:\n    \"\"\"Orchestrates input validation and median service calls.\"\"\"\n    def __init__(self, service: 'MedianService') -> None:\n        self.service = service\n\n    def compute(self, a: object, b: object, c: object) -> float:\n        \"\"\"Validates inputs, casts to float, and computes the median.\"\"\"\n        a_f = safe_cast_to_float(a)\n        b_f = safe_cast_to_float(b)\n        c_f = safe_cast_to_float(c)\n        return self.service.calculate_median(a_f, b_f, c_f)\n_default_service = MedianService(repository=MedianRepository())\n_default_controller = MedianController(service=_default_service)\ndef median_numbers(a, b, c) -> float:\n    \"\"\"\n    Computes the median of three numbers using a layered architecture.\n    \"\"\"\n    return _default_controller.compute(a, b, c)"}
{"task_id": "Mbpp/404", "solution": "from typing import Any\ndef minimum(a: Any, b: Any) -> float:\n    \"\"\"Finds the minimum of two numbers, coercing inputs to float for comparison.\n    This function handles basic numeric types and string representations convertible to float.\"\"\"\n    fa = float(a)\n    fb = float(b)\n    return fa if fa <= fb else fb"}
{"task_id": "Mbpp/398", "solution": "def sum_of_digits(numbers):\n    \"\"\"Computes the sum of digits of each number in a list, then sums these individual sums.\"\"\"\n    total_all_digits = 0\n    for number in numbers:\n        abs_number = abs(number)\n        current_number_digit_sum = 0\n        # Handle the case of zero directly to avoid issues with loop for 0\n        if abs_number == 0:\n            current_number_digit_sum = 0\n        else:\n            while abs_number > 0:\n                current_number_digit_sum += abs_number % 10\n                abs_number //= 10\n        total_all_digits += current_number_digit_sum\n    return total_all_digits"}
