tuple:\n        return True\n    \n    first_type = type(input_tuple[0])\n    for element in input_tuple[1:]:\n        if type(element) is not first_type:\n            return False\n            \n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/271": [{"task_id": "Mbpp/271", "solution": "def even_Power_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the first n even natural numbers, each raised to the fifth power.\n    It iterates from 1 to n, computes (2*i)**5 for each, and accumulates the sum.\n    \"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        current_even_number = 2 * i\n        fifth_power = current_even_number ** 5\n        total_sum += fifth_power\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/592": [{"task_id": "Mbpp/592", "solution": "import math\ndef _binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"Computes C(n, k) = n! / (k! * (n-k)!). Returns 0 if k < 0 or k > n.\"\"\"\n    if k < 0 or k > n:\n        return 0\n    return math.factorial(n) // (math.factorial(k) * math.factorial(n - k))\ndef sum_Of_product(n: int) -> int:\n    \"\"\"Calculates the sum of the product of consecutive binomial coefficients C(n, k) * C(n, k+1) for k from 0 to n-1.\"\"\"\n    total_sum = 0\n    for k in range(n):\n        product = _binomial_coefficient(n, k) * _binomial_coefficient(n, k + 1)\n        total_sum += product\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]}}