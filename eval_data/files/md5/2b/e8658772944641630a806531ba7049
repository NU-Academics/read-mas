 int, c: int, current_path: Path, max_avg_ref: list[float], N: int) -> None:\n    \"\"\"\n    A backtracking function to generate all valid paths and update the maximum average found.\n    Updates `max_avg_ref` by side effect.\n    \"\"\"\n    if r == N - 1 and c == N - 1:\n        # Reached the bottom-right cell\n        max_avg_ref[0] = max(max_avg_ref[0], current_path.average)\n        return\n\n    # Move down\n    if r + 1 < N:\n        next_cell_cost = matrix[r + 1][c]\n        next_cell = Cell(r + 1, c, next_cell_cost)\n        new_path = Path(current_path._cells[0]) # Start new path object to avoid modifying current_path in recursive calls\n        for cell in current_path._cells[1:]:\n            new_path.add_cell(cell)\n        new_path.add_cell(next_cell)\n        _find_all_paths_recursive(matrix, r + 1, c, new_path, max_avg_ref, N)\n\n    # Move right\n    if c + 1 < N:\n        next_cell_cost = matrix[r][c + 1]\n        next_cell = Cell(r, c + 1, next_cell_cost)\n        new_path = Path(current_path._cells[0]) # Start new path object to avoid modifying current_path in recursive calls\n        for cell in current_path._cells[1:]:\n            new_path.add_cell(cell)\n        new_path.add_cell(next_cell)\n        _find_all_paths_recursive(matrix, r, c + 1, new_path, max_avg_ref, N)\ndef maxAverageOfPath(matrix: list[list[int]]) -> float:\n    \"\"\"\n    Finds the path with the maximum average in the given square matrix.\n    It orchestrates the path finding, metric calculation, and identification of the maximum average path.\n    \"\"\"\n    N = len(matrix)\n    if N == 0:\n        return 0.0\n    if N == 1:\n        return float(matrix[0][0])\n\n    initial_cell = Cell(0, 0, matrix[0][0])\n    current_path = Path(initial_cell)\n    \n    max_avg_ref = [-math.inf] # Use a list to pass by reference for mutable updates\n\n    _find_all_paths_recursive(matrix, 0, 0, current_path, max_avg_ref, N)\n\n    return max_avg_ref[0]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/739": [{"task_id": "Mbpp/739", "solution": "def find_Index(n: int) -> int:\n    \"\"\"Finds the index of the smallest triangular number with n digits.\"\"\"\n\n    def _calculate_triangular_number(k: int) -> int:\n        \"\"\"Calculates the k-th triangular number.\"\"\"\n        return k * (k + 1) // 2\n\n    def _count_digits(number: int) -> int:\n        \"\"\"Counts the number of digits in an integer.\"\"\"\n        if number == 0:\n            return 1\n        return len(str(number))\n\n    k = 1\n    num_digits_previous = 0\n\n    while True:\n        triangular_number_value = _calculate_triangular_number(k)\n        num_digits_current = _count_digits(triangular_number_value)\n\n        # Check if the current triangular number has exactly n digits,\n        # and it's the first one to reach this digit count (meaning the previous had fewer).\n        if num_digits_current == n and num_digits_previous < n:\n            return k\n        \n        # If the current number already has more digits than n, and we haven't found one with n digits yet,\n        # it means we've overshot. This condition should ideally not be met if the loop progresses correctly\n        # for numbers that continuously increase digits.\n        # But, it's a safeguard.\n        if num_digits_current > n and num_digits_previous < n:\n            # This implies there might be no n-digit number or logic error,\n            # but based on problem constraints, triangular numbers eventually have N digits.\n            # We should continue incrementing k if we haven't reached n digits yet.\n            pass\n\n        num_digits_previous = num_digits_current\n        k += 1", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[100]]}], "Mbpp/806": [{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Calculates the maximum length of consecutive uppercase characters in a given string.\n    Returns 0 for empty strings or strings with no uppercase characters.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in input_string:\n        if char.isupper():\n            current_run += 1\n            max_run = max(max_run, current_run)\n        else:\n            current_run = 0\n    return max_run", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["Aaa"]]}], "Mbpp/808": [{"task_id": "Mbpp/808", "solution": "def check_K(input_tuple: tuple, k: int) -> bool:\n    \"\"\"\n    Checks if the integer k is present within the input_tuple.\n\n    Args:\n        input_tuple: The tuple to search within.\n        k: The integer value to search for.\n\n    Returns:\n        True if k is found in the tuple, False otherwise.\n    \"\"\"\n    return k in input_tuple", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/807": [{"task_id": "Mbpp/807", "solution": "def first_odd(numbers: list) -> int | None:\n    \"\"\"Finds the first odd number in a given list of numbers.\n\n    Returns the first odd number found, or None if no odd numbers are present.\n    \"\"\"\n    def _is_odd(number: int) -> bool:\n        \"\"\"Checks if a given integer is odd.\"\"\"\n        return number % 2 != 0\n\n    for number in numbers:\n        if _is_odd(number):\n            return number\n    return None", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/284": [{"task_id": "Mbpp/284", "solution": "def check_element(lst, element):\n    \"\"\"Checks if all items in a list are equal to a given element.\"\"\"\n    for item in lst:\n        if item != element:\n            return False\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/224": [{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(number: int) -> int:\n    \"\"\"