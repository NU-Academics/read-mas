{"task_id": "Mbpp/140", "solution": "def extract_singly(list_of_lists: list) -> set:\n    \"\"\"\n    Flattens a list of lists/tuples into a single set of numbers.\n\n    Args:\n        list_of_lists: A list of lists/tuples, where each inner list/tuple\n            contains numerical values.\n\n    Returns:\n        A set containing all unique numerical values from the input.\n    \"\"\"\n    unique_numbers = set()\n    for inner_collection in list_of_lists:\n        for number in inner_collection:\n            unique_numbers.add(number)\n    return unique_numbers"}
{"task_id": "Mbpp/141", "solution": "def sort_list(input_list: list) -> list:\n    \"\"\"\n    Sorts a list of elements in ascending order using the Merge Sort algorithm.\n\n    Args:\n        input_list: The list to be sorted.\n\n    Returns:\n        A new list containing the sorted elements.\n\n    Raises:\n        TypeError: If the input is not a list or if the list contains elements that cannot be compared.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not input_list:\n        return []  # Handle empty list case\n\n    def merge(left_list, right_list):\n        \"\"\"Merges two sorted lists into a single sorted list.\"\"\"\n        merged = []\n        left_index = 0\n        right_index = 0\n\n        while left_index < len(left_list) and right_index < len(right_list):\n            try:\n                if left_list[left_index] <= right_list[right_index]:\n                    merged.append(left_list[left_index])\n                    left_index += 1\n                else:\n                    merged.append(right_list[right_index])\n                    right_index += 1\n            except TypeError:\n                raise TypeError(\"List contains elements that cannot be compared.\")\n\n        merged.extend(left_list[left_index:])\n        merged.extend(right_list[right_index:])\n        return merged\n\n    def merge_sort(list_to_sort):\n        \"\"\"Sorts a list using the Merge Sort algorithm.\"\"\"\n        if len(list_to_sort) <= 1:\n            return list_to_sort\n\n        mid = len(list_to_sort) // 2\n        left_list = list_to_sort[:mid]\n        right_list = list_to_sort[mid:]\n\n        left_list = merge_sort(left_list)\n        right_list = merge_sort(right_list)\n\n        return merge(left_list, right_list)\n\n    return merge_sort(input_list[:])  # Create a copy to avoid modifying the original list"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1, list2, list3):\n    \"\"\"\n    Counts the number of items that are identical in the same position of three given lists.\n\n    Args:\n        list1: The first list.\n        list2: The second list.\n        list3: The third list.\n\n    Returns:\n        The number of identical items at the same positions.\n    \"\"\"\n    count = 0\n    for i in range(len(list1)): # Assumes lists are of equal length\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/145", "solution": "def find_max_difference(numbers):\n    \"\"\"\n    Finds the maximum difference between any two elements in a list.\n\n    Args:\n        numbers (list): A list of numerical values (int or float).\n\n    Returns:\n        float: The maximum difference between any two numbers in the list.\n               Returns 0 if the list is empty or contains only one element.\n\n    Raises:\n        TypeError: If the input is not a list or if the list contains non-numerical values.\n    \"\"\"\n\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not all(isinstance(num, (int, float)) for num in numbers):\n        raise TypeError(\"List elements must be numerical values.\")\n\n    if len(numbers) < 2:\n        return 0\n\n    min_val = numbers[0]\n    max_difference = 0\n\n    for num in numbers:\n        max_difference = max(max_difference, num - min_val)\n        min_val = min(min_val, num)\n\n    return float(max_difference)"}
{"task_id": "Mbpp/160", "solution": "def gcd(a, b):\n  \"\"\"Calculates the greatest common divisor (GCD) of two integers.\n\n  Args:\n    a: An integer.\n    b: An integer.\n\n  Returns:\n    The GCD of a and b.\n  \"\"\"\n  while b:\n    a, b = b, a % b\n  return a\ndef extended_gcd(a, b):\n  \"\"\"Finds the GCD of two integers and also finds integers x and y such that ax + by = gcd(a, b).\n\n  Args:\n    a: An integer.\n    b: An integer.\n\n  Returns:\n    A tuple (gcd, x, y) where:\n      gcd is the GCD of a and b.\n      x and y are integers such that ax + by = gcd.\n  \"\"\"\n  if a == 0:\n    return (b, 0, 1)\n\n  gcd, x1, y1 = extended_gcd(b % a, a)\n\n  x = y1 - (b // a) * x1\n  y = x1\n\n  return (gcd, x, y)\ndef find_solution(a, b, n):\n  \"\"\"Finds integer solutions to the Diophantine equation ax + by = n.\n\n  Args:\n    a: Integer coefficient of x.\n    b: Integer coefficient of y.\n    n: Integer constant.\n\n  Returns:\n    A tuple (x, y) representing an integer solution to the equation, or None if no solution exists.\n  \"\"\"\n  g = gcd(a, b)\n  if n % g != 0:\n    return None\n\n  gcd_val, x0, y0 = extended_gcd(a, b)\n\n  x = x0 * (n // g)\n  y = y0 * (n // g)\n\n  return (x, y)"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(list1: list, list2: list) -> list:\n    \"\"\"\n    Removes all elements from list1 that are present in list2.\n\n    Args:\n        list1 (list): The list from which elements are to be removed.\n        list2 (list): The list containing elements to be removed.\n\n    Returns:\n        list: A new list containing only the elements from list1 that are not in list2.\n    \"\"\"\n    result_list = []\n    list2_set = set(list2)  # Convert list2 to a set for faster lookup\n    for element in list1:\n        if element not in list2_set:  # Check membership in the set\n            result_list.append(element)\n    return result_list"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) from i=0 to n//2,\n    but the sum stops when (n - 2*i) becomes <= 0.\n    For example:\n    sum_series(6) == 6 + 4 + 2 = 12\n    \"\"\"\n    if n <= 0:\n        return 0\n\n    sum_val = 0\n    for i in range(n // 2 + 1):\n        term = n - 2 * i\n        if term > 0:\n            sum_val += term\n        else:\n            break  # Stop if the term is non-positive.\n\n    return sum_val"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts the number of characters in a string that occur at the same position\n    in the string as in the English alphabet (case-insensitive).\n    \"\"\"\n    count = 0\n    for i, char in enumerate(input_string):\n        char_lower = char.lower()\n        if 'a' <= char_lower <= 'z':\n            alphabetical_position = ord(char_lower) - ord('a') + 1\n            if alphabetical_position == i + 1:\n                count += 1\n    return count"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(nums: list[int]) -> int:\n    \"\"\"\n    Counts the number of pairs of integers in a list that XOR to an even number.\n\n    Args:\n        nums: A list of integers.\n\n    Returns:\n        The number of pairs of integers in the list that XOR to an even number.\n    \"\"\"\n\n    # Input Validation\n    if not isinstance(nums, list):\n        raise TypeError(\"Input must be a list.\")\n    for num in nums:\n        if not isinstance(num, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n\n    count = 0\n    n = len(nums)\n\n    # Pair Generation and XOR Calculation\n    for i in range(n):\n        for j in range(i + 1, n):\n            xor_result = nums[i] ^ nums[j]\n\n            # Even Check\n            if xor_result % 2 == 0:\n                count += 1\n\n    return count"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Calculates the smallest power of 2 greater than or equal to n.\n\n    Args:\n        n: A non-negative integer.\n\n    Returns:\n        The smallest power of 2 greater than or equal to n.\n    \"\"\"\n    if n == 0:\n        return 1\n    power_of_2 = 1\n    while power_of_2 < n:\n        power_of_2 <<= 1  # Equivalent to power_of_2 *= 2\n    return power_of_2"}
