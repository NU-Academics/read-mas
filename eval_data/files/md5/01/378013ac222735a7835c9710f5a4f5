{"task_id": "Mbpp/628", "solution": "def replace_spaces(str):\n    \"\"\"\n    Replaces all spaces in a string with '%20'.\n\n    Args:\n        str: The input string.\n\n    Returns:\n        A new string with all spaces replaced by '%20'.\n        An empty string if the input string is null or empty.\n    \"\"\"\n    if str is None or len(str) == 0:\n        return \"\"\n\n    new_str = \"\"\n    for char in str:\n        if char == ' ':\n            new_str += \"%20\"\n        else:\n            new_str += char\n    return new_str"}
{"task_id": "Mbpp/629", "solution": "def find_even_numbers(numbers: list) -> list:\n    \"\"\"\n    Filters a list of numbers and returns a new list containing only the even numbers.\n\n    Args:\n        numbers: A list of integers.\n\n    Returns:\n        A list of integers containing only the even numbers from the input list.\n\n    Raises:\n        TypeError: If the input is not a list or if the list contains non-integer elements.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n    for number in numbers:\n        if not isinstance(number, int):\n            raise TypeError(\"List elements must be integers.\")\n\n    even_numbers = []\n    for number in numbers:\n        if number % 2 == 0:\n            even_numbers.append(number)\n    return even_numbers"}
{"task_id": "Mbpp/630", "solution": "def get_adjacent_coordinates(coordinate: tuple[int, int]) -> list[list[int]]:\n    \"\"\"\n    Extracts all adjacent coordinates of a given coordinate.\n\n    Args:\n        coordinate: A tuple representing the coordinate (x, y).\n\n    Returns:\n        A list of lists, where each inner list represents an adjacent coordinate [x, y].\n    \"\"\"\n    if not isinstance(coordinate, tuple):\n        raise TypeError(\"Input coordinate must be a tuple.\")\n\n    if len(coordinate) != 2:\n        raise ValueError(\"Input coordinate must be a tuple of length 2 (x, y).\")\n\n    if not isinstance(coordinate[0], int) or not isinstance(coordinate[1], int):\n        raise TypeError(\"Input coordinate elements must be integers.\")\n\n    x, y = coordinate\n    adjacent_coordinates = []\n    for x_val in range(x - 1, x + 2):\n        for y_val in range(y - 1, y + 2):\n            adjacent_coordinates.append([x_val, y_val])\n    return adjacent_coordinates"}
