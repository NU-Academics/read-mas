{"task_id": "Mbpp/566", "solution": "def sum_digits(n):\n    \"\"\"\n    Calculates the sum of the digits of a non-negative integer.\n\n    Args:\n      n: A non-negative integer.\n\n    Returns:\n      The sum of the digits of n. Returns 0 if n is negative or not an integer.\n    \"\"\"\n    if not isinstance(n, int):\n        return 0\n    if n < 0:\n        return 0\n\n    sum_of_digits = 0\n    while n > 0:\n        digit = n % 10\n        sum_of_digits += digit\n        n //= 10\n    return sum_of_digits"}
{"task_id": "Mbpp/567", "solution": "def is_sorted(list_data: list, order: str = 'asc') -> bool:\n    \"\"\"\n    Checks if a list is sorted in the specified order.\n\n    Args:\n        list_data: The list to check.\n        order:  'asc' for ascending (default), 'desc' for descending.\n\n    Returns:\n        True if the list is sorted, False otherwise.\n\n    Raises:\n        TypeError: If list_data is not a list or if the list contains mixed data types.\n        ValueError: If order is not 'asc' or 'desc'.\n    \"\"\"\n    if not isinstance(list_data, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not list_data: # Empty list is considered sorted\n        return True\n\n    # Check for consistent data types\n    data_type = type(list_data[0])\n    for item in list_data:\n        if type(item) != data_type:\n            raise TypeError(\"List contains mixed data types.\")\n\n    if order not in ('asc', 'desc'):\n        raise ValueError(\"Order must be 'asc' or 'desc'.\")\n\n    for i in range(len(list_data) - 1):\n        if order == 'asc':\n            if list_data[i] > list_data[i+1]:\n                return False\n        else: # order == 'desc'\n            if list_data[i] < list_data[i+1]:\n                return False\n\n    return True"}
{"task_id": "Mbpp/568", "solution": "def create_list_of_empty_dictionaries(n):\n    \"\"\"\n    Creates a list of N empty dictionaries.\n\n    Args:\n        n (int): The number of empty dictionaries to create.\n\n    Returns:\n        list: A list containing N empty dictionaries.\n\n    Raises:\n        ValueError: If n is not an integer or is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input n must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input n must be a non-negative integer.\")\n\n    return [{} for _ in range(n)]"}
