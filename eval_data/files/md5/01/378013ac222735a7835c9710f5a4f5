{"task_id": "Mbpp/8", "solution": "def square_nums(numbers: list) -> list:\n    \"\"\"\n    Calculates the square of each element in a given list.\n\n    Args:\n        numbers: A list of numbers (integers or floats).\n\n    Returns:\n        A list of the squares of the input numbers.\n\n    Raises:\n        TypeError: If the input is not a list.\n        TypeError: If any element in the list is not a number (int or float).\n    \"\"\"\n\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    squared_numbers = []\n    for number in numbers:\n        if not isinstance(number, (int, float)):\n            raise TypeError(\"All elements in the list must be numbers (int or float).\")\n        squared_numbers.append(number * number)\n\n    return squared_numbers"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    This function takes a string `s` as input and returns the minimum number of rotations\n    (greater than 0) required to obtain the original string. If no rotation returns the\n    same string, it returns the length of the string.\n    \"\"\"\n    if not s:\n        return 0\n\n    n = len(s)\n\n    for rotations in range(1, n):\n        rotated_string = s[rotations:] + s[:rotations]\n        if rotated_string == s:\n            return rotations\n\n    return n"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(string: str, char: str) -> str:\n    \"\"\"Removes the first and last occurrences of a character from a string.\"\"\"\n    first_index = string.find(char)\n    if first_index == -1:\n        return string  # Character not found\n\n    last_index = string.rfind(char)\n\n    if first_index == last_index:\n        return string[:first_index] + string[first_index+1:]\n\n    return string[:first_index] + string[first_index+1:last_index] + string[last_index+1:]"}
{"task_id": "Mbpp/12", "solution": "def sort_matrix(matrix):\n    \"\"\"\n    Sorts a matrix (list of lists) in ascending order according to the sum of its rows.\n\n    Args:\n      matrix: A list of lists, where each inner list represents a row of numerical values.\n\n    Returns:\n      A new matrix (list of lists) with the rows sorted in ascending order based on their sum.\n      Returns an empty list if the input matrix is empty.\n    \"\"\"\n    if not matrix:\n        return []  # Handle empty matrix case\n\n    sorted_matrix = sorted(matrix, key=lambda row: sum(row))\n    return sorted_matrix"}
{"task_id": "Mbpp/14", "solution": "def calculate_triangular_prism_volume(base: float, height: float, length: float) -> float:\n    \"\"\"\n    Calculates the volume of a triangular prism.\n\n    Args:\n        base: The base of the triangular face.\n        height: The height of the triangular face.\n        length: The length of the prism.\n\n    Returns:\n        The volume of the triangular prism.\n    \"\"\"\n    assert base > 0, \"Base must be a positive number.\"\n    assert height > 0, \"Height must be a positive number.\"\n    assert length > 0, \"Length must be a positive number.\"\n    volume = 0.5 * base * height * length\n    return volume"}
{"task_id": "Mbpp/16", "solution": "import re\ndef text_lowercase_underscore(text: str) -> bool:\n    \"\"\"\n    Checks if a string contains sequences of lowercase letters joined with underscores.\n\n    Args:\n        text: The string to validate.\n\n    Returns:\n        True if the string is valid, False otherwise.\n    \"\"\"\n    if not text:\n        return False\n\n    if text.startswith('_') or text.endswith('_'):\n        return False\n\n    if '__' in text:\n        return False\n    \n    pattern = r'^[a-z]+(_[a-z]+)*$'\n    return bool(re.match(pattern, text))"}
