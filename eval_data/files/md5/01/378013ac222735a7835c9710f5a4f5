{"task_id": "Mbpp/607", "solution": "import re\ndef find_literals(text: str, pattern: str) -> tuple[str | None, int | None, int | None]:\n    \"\"\"\n    Finds a regular expression pattern in a string and returns the matched substring,\n    start index, and end index.\n\n    Args:\n        text: The string to be searched.\n        pattern: The regular expression pattern to search for.\n\n    Returns:\n        A tuple containing:\n            - match_string: The matching substring, or None if no match is found.\n            - start_index: The starting index of the match, or None if no match is found.\n            - end_index: The ending index of the match, or None if no match is found.\n    \"\"\"\n    match = re.search(pattern, text)\n    if match:\n        match_string = match.group(0)\n        start_index = match.start()\n        end_index = match.end()\n        return (match_string, start_index, end_index)\n    else:\n        return (None, None, None)"}
{"task_id": "Mbpp/608", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number using dynamic programming (Bell Triangle).\n\n    Args:\n        n: A non-negative integer.\n\n    Returns:\n        The nth Bell number as an integer.\n\n    Raises:\n        ValueError: If n is negative.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n    if n == 0:\n        return 1\n\n    bell_triangle = [[0 for _ in range(n + 1)] for _ in range(n + 1)]\n    bell_triangle[0][0] = 1\n\n    for i in range(1, n + 1):\n        bell_triangle[i][0] = bell_triangle[i - 1][i - 1]\n        for j in range(1, i + 1):\n            bell_triangle[i][j] = bell_triangle[i - 1][j - 1] + bell_triangle[i][j - 1]\n\n    return bell_triangle[n][0]"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(lst: list, k: int) -> list:\n    \"\"\"\n    Removes the k'th element from a list and returns a new list.\n\n    Args:\n        lst: The input list.\n        k: The index of the element to remove (0-based).\n\n    Returns:\n        A new list with the element at index k removed,\n        or a copy of the original list if k is out of bounds.\n    \"\"\"\n    if k < 0 or k >= len(lst):\n        return lst[:]  # Return a copy of the original list\n    else:\n        return lst[:k] + lst[k+1:]"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix: list[list[float]], n: int) -> float:\n    \"\"\"\n    Finds the maximum value in the n'th column of a matrix.\n\n    Args:\n        matrix: A list of lists representing the matrix.\n        n: The column index (0-based).\n\n    Returns:\n        The maximum value in the n'th column.\n\n    Raises:\n        IndexError: If the column index is out of bounds.\n        TypeError: If any element in the specified column is not a number.\n        ValueError: If the matrix is empty or has zero rows.\n    \"\"\"\n    if not matrix or len(matrix) == 0:\n        raise ValueError(\"Matrix cannot be empty.\")\n\n    num_cols = len(matrix[0])\n    if n < 0 or n >= num_cols:\n        raise IndexError(\"Column index out of bounds.\")\n\n    max_val = float('-inf')\n    for row in matrix:\n        try:\n            val = row[n]\n            if not isinstance(val, (int, float)):\n                raise TypeError(\"Non-numeric value found in column.\")\n            if val > max_val:\n                max_val = val\n        except IndexError:\n            raise IndexError(\"Inconsistent matrix dimensions.\")\n\n\n    return max_val"}
{"task_id": "Mbpp/612", "solution": "def merge(list_of_lists):\n    \"\"\"\n    Transposes a list of lists (pairs) into two separate lists.\n\n    Args:\n        list_of_lists: A list of lists, where each inner list contains two elements.\n\n    Returns:\n        A list containing two lists. The first inner list contains all the first\n        elements from the input lists, and the second inner list contains all the\n        second elements.\n\n    Example:\n        merge([['x', 'y'], ['a', 'b'], ['m', 'n']]) == [['x', 'a', 'm'], ['y', 'b', 'n']]\n    \"\"\"\n    first_elements = []\n    second_elements = []\n    for inner_list in list_of_lists:\n        first_elements.append(inner_list[0])\n        second_elements.append(inner_list[1])\n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/614", "solution": "def cumulative_sum(list_of_tuples: list[tuple[int, ...]]) -> int:\n    \"\"\"\n    Calculates the cumulative sum of all integers in a list of tuples.\n\n    Args:\n        list_of_tuples: A list where each element is a tuple of integers.\n\n    Returns:\n        The cumulative sum of all integers in the list of tuples.\n\n    Raises:\n        TypeError: If the input is not a list of tuples of integers, or if any\n                   element within the tuples is not an integer.\n    \"\"\"\n    if not isinstance(list_of_tuples, list):\n        raise TypeError(\"Input must be a list\")\n\n    total_sum = 0\n    for tup in list_of_tuples:\n        if not isinstance(tup, tuple):\n            raise TypeError(\"Each element in the list must be a tuple\")\n        for element in tup:\n            if not isinstance(element, int):\n                raise TypeError(\"Each element within the tuples must be an integer\")\n            total_sum += element\n    return total_sum"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(tuple_of_tuples):\n    \"\"\"\n    Calculates the average of each tuple within a tuple of tuples.\n\n    Args:\n        tuple_of_tuples: A tuple of tuples, where each inner tuple contains numerical values.\n\n    Returns:\n        A list of floats, where each float represents the average of the corresponding inner tuple.\n    \"\"\"\n    averages = []\n    for inner_tuple in tuple_of_tuples:\n        if not inner_tuple:\n            averages.append(0.0)\n        else:\n            total = 0\n            for element in inner_tuple:\n                if not isinstance(element, (int, float)):\n                    raise TypeError(\"Tuple contains non-numerical values\")\n                total += element\n            average = total / len(inner_tuple)\n            averages.append(average)\n    return averages"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise modulo operation on two tuples.\n\n    Args:\n        tuple1: The first tuple (numerator).\n        tuple2: The second tuple (denominator).\n\n    Returns:\n        A tuple containing the element-wise modulo results.\n        Returns None if division by zero occurs.\n\n    Raises:\n        ValueError: If the input tuples have different lengths.\n    \"\"\"\n\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n    result = []\n    for i in range(len(tuple1)):\n        try:\n            result.append(tuple1[i] % tuple2[i])\n        except ZeroDivisionError:\n            result.append(None)\n    return tuple(result)"}
{"task_id": "Mbpp/618", "solution": "def divide_lists(list1: list, list2: list) -> list or str:\n    \"\"\"\n    Divides two lists element-wise and handles potential errors.\n\n    Args:\n        list1: The numerator list.\n        list2: The denominator list.\n\n    Returns:\n        A new list containing the element-wise division results,\n        or an error message if the lists have unequal lengths or\n        if division by zero is encountered.\n    \"\"\"\n    if len(list1) != len(list2):\n        return \"Lists must have the same length.\"\n\n    result = []\n    for i in range(len(list1)):\n        if list2[i] == 0:\n            return f\"Division by zero encountered at index {i}.\"\n        else:\n            result.append(list1[i] / list2[i])\n\n    return result"}
{"task_id": "Mbpp/620", "solution": "def largest_divisible_subset_size(nums: list[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of a list of numbers so that every pair is divisible.\n    \"\"\"\n    n = len(nums)\n    if n == 0:\n        return 0\n\n    nums.sort()\n    dp = [1] * n\n    max_size = 1\n\n    for i in range(1, n):\n        for j in range(i):\n            if nums[i] % nums[j] == 0:\n                dp[i] = max(dp[i], dp[j] + 1)\n        max_size = max(max_size, dp[i])\n\n    return max_size"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1: list[float], list2: list[float], n: int) -> float:\n    \"\"\"\n    Calculates the median of two sorted lists of the same size.\n\n    Args:\n        list1: The first sorted list.\n        list2: The second sorted list.\n        n: The size of both lists.\n\n    Returns:\n        The median of the combined lists.\n\n    Raises:\n        ValueError: If the lists are not of the same size.\n    \"\"\"\n    if len(list1) != len(list2):\n        raise ValueError(\"Lists must be of the same size.\")\n\n    if n == 0:\n        return -1  # Or raise an exception, depending on desired behavior\n\n    if n == 1:\n        return (list1[0] + list2[0]) / 2.0\n\n    if n == 2:\n        return (max(list1[0], list2[0]) + min(list1[1], list2[1])) / 2.0\n\n\n    def median(lst):\n        if len(lst) % 2 == 0:\n            mid1 = lst[len(lst) // 2 - 1]\n            mid2 = lst[len(lst) // 2]\n            return (mid1 + mid2) / 2.0\n        else:\n            return float(lst[len(lst) // 2])\n\n\n    m1 = median(list1)\n    m2 = median(list2)\n\n    if m1 == m2:\n        return m1\n\n    if m1 < m2:\n        if n % 2 == 0:\n            return get_median(list1[n // 2:], list2[:n // 2], n - n // 2)\n        else:\n            return get_median(list1[n // 2:], list2[:n // 2 + 1], n - n // 2)\n    else:  # m1 > m2\n        if n % 2 == 0:\n            return get_median(list1[:n // 2], list2[n // 2:], n - n // 2)\n        else:\n            return get_median(list1[:n // 2 + 1], list2[n // 2:], n - n // 2)"}
{"task_id": "Mbpp/623", "solution": "def nth_nums(numbers: list[float], n: int) -> list[float]:\n    \"\"\"\n    Calculates the nth power of each number in a list.\n\n    Args:\n        numbers: A list of numbers (integers or floats).\n        n: An integer representing the exponent.\n\n    Returns:\n        A new list containing the nth power of each number in the input list.\n\n    Raises:\n        TypeError: If the input list contains non-numerical values or if n is not an integer.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not isinstance(n, int):\n        raise TypeError(\"Exponent must be an integer.\")\n\n    powered_numbers = []\n    for number in numbers:\n        if not isinstance(number, (int, float)):\n            raise TypeError(\"List elements must be numbers (int or float).\")\n        powered_numbers.append(float(number ** n))  # Ensure result is float\n\n    return powered_numbers"}
