{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary_string: str, rotations: int) -> int:\n    \"\"\"\n    Counts the number of odd decimal equivalents generated by rotating a binary string.\n\n    Args:\n        binary_string: The binary string to rotate.\n        rotations: The number of rotations to perform.\n\n    Returns:\n        The number of odd decimal equivalents encountered.\n\n    Raises:\n        ValueError: If the input is invalid.\n    \"\"\"\n\n    if not all(c in '01' for c in binary_string):\n        raise ValueError(\"Invalid binary string: must contain only '0' and '1'\")\n\n    if not isinstance(rotations, int) or rotations < 0:\n        raise ValueError(\"Invalid rotations: must be a non-negative integer\")\n\n    odd_count = 0\n    for _ in range(rotations):\n        rotated_string = binary_string[-1] + binary_string[:-1]\n        decimal_value = int(rotated_string, 2)\n        if decimal_value % 2 != 0:\n            odd_count += 1\n        binary_string = rotated_string #update the binary string\n\n    return odd_count"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_list):\n    \"\"\"\n    Finds the common elements across multiple nested lists.\n\n    Args:\n        nested_list: A list where each element is itself a list of elements.\n\n    Returns:\n        A set containing the common elements.\n    \"\"\"\n    if not isinstance(nested_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    for inner_list in nested_list:\n        if not isinstance(inner_list, list):\n            raise TypeError(\"All elements in the input list must be lists.\")\n\n    if not nested_list:\n        return set()\n\n    if len(nested_list) == 1:\n        return set(nested_list[0])\n\n    if not nested_list[0]:\n        return set()\n\n    common_elements = set(nested_list[0])\n\n    for inner_list in nested_list[1:]:\n        if not inner_list:\n            return set()\n        inner_list_set = set(inner_list)\n        common_elements = common_elements.intersection(inner_list_set)\n        if not common_elements:\n            return set()\n\n    return common_elements"}
{"task_id": "Mbpp/113", "solution": "def check_integer(input_string: str) -> bool:\n    \"\"\"\n    Determines if the input string represents an integer.\n\n    Parameters:\n        input_string: The string to be validated.\n\n    Returns:\n        True if the string represents an integer, False otherwise.\n    \"\"\"\n\n    s = input_string.strip()\n\n    if not s:\n        return False\n\n    sign = 1\n    if s[0] == '+':\n        s = s[1:]\n    elif s[0] == '-':\n        sign = -1\n        s = s[1:]\n\n    if not s:\n        return True  # Handles \"+\", \"-\" alone\n\n    if s == \"0\":\n        return True\n\n    if not s:\n        return False\n\n    for char in s:\n        if not char.isdigit():\n            return False\n\n    return True"}
