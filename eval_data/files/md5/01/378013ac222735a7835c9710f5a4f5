{"task_id": "Mbpp/803", "solution": "def is_perfect_square(n):\n    if n < 0:\n        return False\n    if n == 0:\n        return True\n    \n    low = 1\n    high = n\n    \n    while low <= high:\n        mid = low + (high - low) // 2\n        square = mid * mid\n        \n        if square == n:\n            return True\n        elif square < n:\n            low = mid + 1\n        else:\n            high = mid - 1\n            \n    return False"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(list_of_lists: list[list[float]]) -> list[float]:\n    \"\"\"\n    Finds the list with the maximum sum of elements from a list of lists.\n\n    Args:\n        list_of_lists: A list of lists, where each inner list contains numerical elements.\n\n    Returns:\n        The inner list with the highest sum of its elements.  Returns an empty list if the input list is empty.\n\n    Raises:\n        TypeError: If the input is not a list of lists or if the inner lists contain non-numerical data.\n    \"\"\"\n    if not isinstance(list_of_lists, list):\n        raise TypeError(\"Input must be a list of lists.\")\n\n    for inner_list in list_of_lists:\n        if not isinstance(inner_list, list):\n            raise TypeError(\"Input must be a list of lists.\")\n        for element in inner_list:\n            if not isinstance(element, (int, float)):\n                raise TypeError(\"Inner lists must contain numerical values.\")\n\n    if not list_of_lists:\n        return []\n\n    max_sum = float('-inf')\n    max_list = []\n\n    for inner_list in list_of_lists:\n        current_sum = sum(inner_list)\n        if current_sum > max_sum:\n            max_sum = current_sum\n            max_list = inner_list\n\n    return max_list"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string):\n    max_length = 0\n    current_length = 0\n\n    if not input_string:\n        return 0\n\n    for char in input_string:\n        if 'A' <= char <= 'Z':\n            current_length += 1\n        else:\n            max_length = max(max_length, current_length)\n            current_length = 0\n\n    max_length = max(max_length, current_length) # check the last sequence\n\n    return max_length"}
