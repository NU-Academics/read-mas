{"task_id": "Mbpp/555", "solution": "def difference(n):\n    \"\"\"\n    Calculates the difference between the sum of the cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n\n    Args:\n        n: A non-negative integer.\n\n    Returns:\n        An integer representing the difference between the sum of the cubes of the first n\n        natural numbers and the sum of the first n natural numbers.\n    \"\"\"\n    sum_of_cubes = 0\n    sum_of_numbers = 0\n\n    if n == 0:\n        return 0\n\n    for i in range(1, n + 1):\n        sum_of_cubes += i**3\n        sum_of_numbers += i\n\n    difference_val = sum_of_cubes - sum_of_numbers\n    return difference_val"}
{"task_id": "Mbpp/556", "solution": "def count_odd_xor_pairs(arr, n):\n    \"\"\"\n    Counts the number of pairs in an array whose XOR value is odd.\n\n    Args:\n        arr: A list of integers.\n        n: The size of the array.\n\n    Returns:\n        The number of pairs with an odd XOR value.\n    \"\"\"\n    odd_count = 0\n    even_count = 0\n    odd_num_count = 0\n\n    for i in range(n):\n        if arr[i] % 2 == 0:\n            even_count += 1\n        else:\n            odd_num_count += 1\n\n    odd_count = odd_num_count * even_count\n    return odd_count"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1, num2):\n    \"\"\"\n    Calculates the sum of the per-digit absolute difference between two integers.\n\n    Args:\n        num1: The first integer.\n        num2: The second integer.\n\n    Returns:\n        The sum of the absolute differences between the digits of the two integers.\n    \"\"\"\n    if not isinstance(num1, int) or not isinstance(num2, int):\n        raise TypeError(\"Inputs must be integers.\")\n    if num1 < 0 or num2 < 0:\n        raise ValueError(\"Inputs must be non-negative integers.\")\n\n    str1 = str(num1)\n    str2 = str(num2)\n    max_len = max(len(str1), len(str2))\n\n    str1 = str1.zfill(max_len)\n    str2 = str2.zfill(max_len)\n\n    distance = 0\n    for i in range(max_len):\n        distance += abs(int(str1[i]) - int(str2[i]))\n\n    return distance"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(nums, size):\n    \"\"\"\n    Finds the maximum sum of a contiguous sublist within a given list of integers.\n\n    Args:\n        nums: A list of integers.\n        size: The number of elements in the list.\n\n    Returns:\n        An integer representing the maximum contiguous sublist sum.\n    \"\"\"\n    max_so_far = 0\n    current_max = 0\n\n    for num in nums:\n        current_max = current_max + num\n        if current_max < 0:\n            current_max = 0\n        if max_so_far < current_max:\n            max_so_far = current_max\n\n    return max_so_far"}
{"task_id": "Mbpp/560", "solution": "def union_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Finds the union of elements from two tuples and returns a sorted tuple.\n\n    Args:\n        tuple1: The first tuple.\n        tuple2: The second tuple.\n\n    Returns:\n        A tuple containing the sorted union of elements from tuple1 and tuple2.\n\n    Raises:\n        TypeError: If the input tuples contain mixed data types that cannot be sorted.\n    \"\"\"\n    combined_list = list(tuple1) + list(tuple2)\n    unique_set = set(combined_list)\n    try:\n        sorted_list = sorted(list(unique_set))\n    except TypeError:\n        raise TypeError(\"Tuples contain mixed data types that cannot be sorted.\")\n\n    result_tuple = tuple(sorted_list)\n    return result_tuple"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(list_of_lists: list) -> int:\n    \"\"\"\n    Finds the length of the longest sublist within a given list of lists.\n\n    Args:\n        list_of_lists: A list of lists.\n\n    Returns:\n        An integer representing the maximum length of any of the sublists.\n    \"\"\"\n    max_length = 0\n    for item in list_of_lists:\n        if isinstance(item, list):\n            max_length = max(max_length, len(item))\n    return max_length"}
{"task_id": "Mbpp/563", "solution": "import re\ndef extract_values(input_string: str) -> list[str]:\n    \"\"\"\n    Extracts values between quotation marks from a string.\n\n    Args:\n        input_string: The string to extract values from.\n\n    Returns:\n        A list of strings containing the extracted values.\n    \"\"\"\n    pattern = r'\"(.*?)\"'\n    matches = re.findall(pattern, input_string)\n    return matches"}
{"task_id": "Mbpp/564", "solution": "def count_unequal_pairs(numbers: list[int]) -> int:\n    \"\"\"\n    Counts the number of unordered pairs of unequal elements in a list.\n\n    Args:\n        numbers: A list of integers.\n\n    Returns:\n        The number of unordered pairs where the elements are unequal.\n    \"\"\"\n    n = len(numbers)\n    count = 0\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] != numbers[j]:\n                count += 1\n    return count"}
