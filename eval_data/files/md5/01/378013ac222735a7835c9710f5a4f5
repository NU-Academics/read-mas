{"task_id": "Mbpp/462", "solution": "def generate_combinations(input_list):\n    if not input_list:\n        return [[]]\n\n    first_element = input_list[0]\n    rest_of_list = input_list[1:]\n\n    combinations_without_first = generate_combinations(rest_of_list)\n    combinations_with_first = [\n        [first_element] + combo for combo in combinations_without_first\n    ]\n\n    return combinations_without_first + combinations_with_first"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(arr: list[int]) -> int:\n  \"\"\"\n  Finds the maximum product of a contiguous subarray within a given array.\n\n  Args:\n    arr: A list of integers.\n\n  Returns:\n    The maximum product found in any subarray of arr.\n  \"\"\"\n  if not arr:\n    return 0\n\n  max_so_far = arr[0]\n  min_so_far = arr[0]\n  result = arr[0]\n\n  for i in range(1, len(arr)):\n    temp_max = max_so_far\n    max_so_far = max(arr[i], temp_max * arr[i], min_so_far * arr[i])\n    min_so_far = min(arr[i], temp_max * arr[i], min_so_far * arr[i])\n    result = max(result, max_so_far)\n\n  return result"}
{"task_id": "Mbpp/465", "solution": "def drop_empty(input_dict):\n    \"\"\"\n    Removes items with empty values from a dictionary.\n\n    Args:\n        input_dict (dict): The input dictionary.\n\n    Returns:\n        dict: A new dictionary containing only items with non-empty values.\n    \"\"\"\n    new_dict = {}\n    for key, value in input_dict.items():\n        if value:  # Pythonic way to check for truthiness/emptiness. Covers None, \"\", [], (), {}, and False\n            new_dict[key] = value\n    return new_dict"}
{"task_id": "Mbpp/468", "solution": "def max_product(arr: list[float]) -> float:\n    \"\"\"\n    Calculates the maximum product of an increasing subsequence within the given array.\n\n    Args:\n        arr: A list of numbers (integers or floats).\n\n    Returns:\n        The maximum product of an increasing subsequence. Returns 1 if arr is empty.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 1.0\n\n    dp = [arr[i] for i in range(n)]\n\n    for i in range(1, n):\n        for j in range(i):\n            if arr[i] > arr[j]:\n                dp[i] = max(dp[i], dp[j] * arr[i])\n\n    max_prod = 1.0\n    has_positive = False\n    for val in dp:\n        if val > max_prod:\n            max_prod = val\n        if val > 0:\n            has_positive = True\n\n    if max_prod <= 0 and has_positive == False:\n        \n        largest_negative = float('-inf')\n        for num in arr:\n            if num > largest_negative:\n                largest_negative = num\n        if largest_negative == float('-inf'):\n          return 1.0\n        return largest_negative\n    \n    if max_prod <= 0:\n      return 1.0\n    \n    return max_prod"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple):\n    \"\"\"\n    Calculates the pairwise addition of neighboring elements in a tuple.\n\n    Args:\n        input_tuple (tuple): A tuple of numerical values (int or float).\n\n    Returns:\n        tuple: A tuple containing the sums of adjacent element pairs.\n               Returns an empty tuple if the input tuple has fewer than 2 elements.\n\n    Raises:\n        TypeError: If the input is not a tuple or if the tuple contains non-numerical elements.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    for element in input_tuple:\n        if not isinstance(element, (int, float)):\n            raise TypeError(\"Tuple elements must be numerical.\")\n\n    if len(input_tuple) < 2:\n        return ()\n\n    pairwise_sums = tuple(input_tuple[i] + input_tuple[i+1] for i in range(len(input_tuple)-1))\n\n    return pairwise_sums"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(arr, n):\n    product = 1\n    for element in arr:\n        product = (product * element) % n\n    return product"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(numbers: list) -> bool:\n    \"\"\"\n    Checks if the given list contains consecutive numbers.\n\n    Args:\n        numbers: A list of numbers.\n\n    Returns:\n        True if the list contains consecutive numbers, False otherwise.\n    \"\"\"\n\n    if not numbers:\n        return True  # Empty list is considered consecutive\n    if len(numbers) == 1:\n        return True  # Single element list is considered consecutive\n\n    # Type conversion and validation\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise TypeError(\"List elements must be numbers\")\n        if not float(num).is_integer():\n             return False  # non-integer values are not consecutive\n\n    # Remove duplicates\n    numbers = list(set(numbers))\n    numbers.sort()\n\n    for i in range(1, len(numbers)):\n        if numbers[i] - numbers[i-1] != 1:\n            return False\n\n    return True"}
{"task_id": "Mbpp/473", "solution": "def tuple_intersection(list1, list2):\n    \"\"\"\n    Calculates the intersection of two lists of tuples, ignoring the order of elements within the tuples.\n\n    Args:\n        list1: A list of tuples.\n        list2: A list of tuples.\n\n    Returns:\n        A set of tuples representing the intersection of list1 and list2.\n    \"\"\"\n    intersection_set = set()\n    for tuple1 in list1:\n        frozenset1 = frozenset(tuple1)\n        for tuple2 in list2:\n            frozenset2 = frozenset(tuple2)\n            if frozenset1 == frozenset2:\n                intersection_set.add(tuple1)\n    return intersection_set"}
{"task_id": "Mbpp/474", "solution": "def replace_char(string: str, old_char: str, new_char: str) -> str:\n    \"\"\"\n    Replaces all occurrences of old_char in the input string with new_char.\n\n    Args:\n        string: The input string.\n        old_char: The character to be replaced.\n        new_char: The character to replace with.\n\n    Returns:\n        The modified string with replacements made.\n    \"\"\"\n    if not string:\n        return \"\"\n\n    result = \"\"\n    for char in string:\n        if char == old_char:\n            result += new_char\n        else:\n            result += char\n    return result"}
