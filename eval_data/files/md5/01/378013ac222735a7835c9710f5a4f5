{"task_id": "Mbpp/427", "solution": "import re\ndef change_date_format(date_string: str) -> str:\n    \"\"\"\n    Converts a date from \"yyyy-mm-dd\" format to \"dd-mm-yyyy\" format.\n\n    Args:\n        date_string: A string representing the date in \"yyyy-mm-dd\" format.\n\n    Returns:\n        A string representing the date in \"dd-mm-yyyy\" format,\n        an error message if the input format is invalid,\n        or an empty string if the input is an empty string.\n    \"\"\"\n    if not date_string:\n        return \"\"\n\n    pattern = r\"^\\d{4}-\\d{2}-\\d{2}$\"\n    if not re.match(pattern, date_string):\n        return \"Error: Invalid date format. Please use yyyy-mm-dd.\"\n\n    year, month, day = date_string.split(\"-\")\n    return f\"{day}-{month}-{year}\""}
{"task_id": "Mbpp/428", "solution": "def shell_sort(arr: list[int]) -> list[int]:\n    \"\"\"\n    Sorts an array of integers using the Shell Sort algorithm.\n\n    Args:\n        arr: The array to be sorted.\n\n    Returns:\n        A new array containing the sorted integers.\n    \"\"\"\n    n = len(arr)\n    gap = n // 2  # Initial gap\n\n    while gap > 0:\n        for i in range(gap, n):\n            temp = arr[i]\n            j = i\n            while j >= gap and arr[j - gap] > temp:\n                arr[j] = arr[j - gap]\n                j -= gap\n            arr[j] = temp\n        gap //= 2\n\n    return arr"}
{"task_id": "Mbpp/429", "solution": "def and_tuples(tuple1, tuple2):\n    \"\"\"\n    Performs element-wise bitwise AND on two tuples.\n\n    Args:\n        tuple1: The first tuple of integers.\n        tuple2: The second tuple of integers.\n\n    Returns:\n        A new tuple containing the results of the element-wise bitwise AND operation.\n\n    Raises:\n        ValueError: If the input tuples have different lengths.\n        TypeError: If the input tuples contain non-integer elements.\n    \"\"\"\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Inputs must be tuples\")\n\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same length\")\n\n    result = []\n    for i in range(len(tuple1)):\n        if not isinstance(tuple1[i], int) or not isinstance(tuple2[i], int):\n            raise TypeError(\"Tuple elements must be integers\")\n        result.append(tuple1[i] & tuple2[i])\n\n    return tuple(result)"}
{"task_id": "Mbpp/430", "solution": "def calculate_directrix(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Calculates the directrix of a parabola defined by ax^2 + bx + c.\n\n    Args:\n        a: The coefficient of x^2.\n        b: The coefficient of x.\n        c: The constant term.\n\n    Returns:\n        The y-value of the directrix.\n\n    Raises:\n        ValueError: If 'a' is equal to zero.\n    \"\"\"\n    if a == 0:\n        raise ValueError(\"Coefficient 'a' cannot be zero.\")\n\n    h = -b / (2 * a)\n    k = c - (b**2) / (4 * a)\n    p = 1 / (4 * a)\n    directrix = k - p\n    return directrix"}
