{"task_id": "Mbpp/128", "solution": "def long_words(n: int, text: str) -> list[str]:\n    \"\"\"\n    Finds words in a string that are longer than n characters.\n\n    Args:\n        n: The minimum length of the words to find.\n        text: The string to search in.\n\n    Returns:\n        A list of words that are longer than n characters.\n\n    Raises:\n        TypeError: If n is not an integer or text is not a string.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a string\")\n\n    words = text.split()\n    return [word for word in words if len(word) > n]"}
{"task_id": "Mbpp/129", "solution": "def isMagicSquare(matrix: list[list[int]]) -> bool:\n    \"\"\"\n    Determines if a given square matrix is a magic square.\n\n    Args:\n        matrix: A two-dimensional array of numbers representing the square matrix.\n\n    Returns:\n        True if the matrix is a magic square, and False otherwise.\n    \"\"\"\n\n    # Input Validation: Check if the input is a valid matrix and square\n    if not isinstance(matrix, list) or not all(isinstance(row, list) for row in matrix):\n        return False\n\n    num_rows = len(matrix)\n    if num_rows == 0:\n        return False\n\n    num_cols = len(matrix[0])\n    if num_rows != num_cols:\n        return False\n\n    for row in matrix:\n        if len(row) != num_rows:\n            return False\n        for val in row:\n            if not isinstance(val, (int, float)):\n                return False\n\n    # Calculate the expected sum (sum of the first row)\n    expected_sum = sum(matrix[0])\n\n    # Calculate Row Sums\n    for row in matrix:\n        if sum(row) != expected_sum:\n            return False\n\n    # Calculate Column Sums\n    for col in range(num_cols):\n        column_sum = 0\n        for row in range(num_rows):\n            column_sum += matrix[row][col]\n        if column_sum != expected_sum:\n            return False\n\n    # Calculate Diagonal Sums\n    main_diagonal_sum = 0\n    anti_diagonal_sum = 0\n    for i in range(num_rows):\n        main_diagonal_sum += matrix[i][i]\n        anti_diagonal_sum += matrix[i][num_rows - 1 - i]\n\n    if main_diagonal_sum != expected_sum or anti_diagonal_sum != expected_sum:\n        return False\n\n    return True"}
{"task_id": "Mbpp/130", "solution": "def find_most_frequent_item(data_list):\n    \"\"\"\n    Finds the most frequent item in a list.\n\n    Args:\n        data_list: A list of items.\n\n    Returns:\n        The item with the highest frequency in the list, or None if the list is empty.\n    \"\"\"\n    if not data_list:\n        return None\n\n    frequency_map = {}\n    for item in data_list:\n        if item in frequency_map:\n            frequency_map[item] += 1\n        else:\n            frequency_map[item] = 1\n\n    most_frequent_item = None\n    max_frequency = 0\n\n    for item, frequency in frequency_map.items():\n        if frequency > max_frequency:\n            most_frequent_item = item\n            max_frequency = frequency\n\n    return most_frequent_item"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    vowels = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n    vowel_list = []\n    result_list = []\n\n    for char in s:\n        if char in vowels:\n            vowel_list.append(char)\n            result_list.append(None)\n        else:\n            result_list.append(char)\n\n    vowel_list.reverse()\n\n    vowel_iterator = iter(vowel_list)\n\n    for i in range(len(result_list)):\n        if result_list[i] == None:\n            result_list[i] = next(vowel_iterator)\n    \n    return \"\".join(result_list)"}
{"task_id": "Mbpp/132", "solution": "def tup_string(input_tuple):\n    \"\"\"\n    Converts a tuple of characters into a string.\n\n    Args:\n        input_tuple: A tuple containing characters.\n\n    Returns:\n        A string formed by concatenating the characters in the tuple.\n\n    Raises:\n        TypeError: If the input is not a tuple or if the tuple contains non-character elements.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple\")\n\n    result_string = ''\n    for char in input_tuple:\n        if not isinstance(char, str) or len(char) != 1:\n            raise TypeError(\"Tuple must contain only characters\")\n        result_string += char\n\n    return result_string"}
