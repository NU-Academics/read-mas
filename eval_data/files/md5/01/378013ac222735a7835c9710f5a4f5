{"task_id": "Mbpp/269", "solution": "def ascii_value(char: str) -> int:\n    \"\"\"\n    Returns the ASCII value of a character.\n\n    Args:\n        char: The character to get the ASCII value of (string of length 1).\n\n    Returns:\n        The ASCII value of the character as an integer.\n\n    Raises:\n        TypeError: If the input is not a string.\n        ValueError: If the input string's length is not equal to 1.\n    \"\"\"\n    if not isinstance(char, str):\n        raise TypeError(\"Input must be a string.\")\n    if len(char) != 1:\n        raise ValueError(\"Input string must have length 1.\")\n    return ord(char)"}
{"task_id": "Mbpp/270", "solution": "def sum_even_and_even_index(data):\n    \"\"\"\n    Calculates the sum of even numbers located at even indices within a list of integers.\n\n    Args:\n        data: A list of integers.\n\n    Returns:\n        The sum of even numbers at even indices. Returns 0 if the list is empty.\n    \"\"\"\n    sum_of_evens = 0\n    if not data:\n        return 0\n\n    for i in range(len(data)):\n        if i % 2 == 0:\n            if isinstance(data[i], int) and data[i] % 2 == 0:\n                sum_of_evens += data[i]\n\n    return sum_of_evens"}
{"task_id": "Mbpp/271", "solution": "def even_Power_Sum(n):\n    \"\"\"\n    Calculates the sum of the fifth powers of the first 'n' even natural numbers.\n\n    Args:\n        n (int): A positive integer representing the number of even numbers to consider.\n\n    Returns:\n        int: The sum of the fifth powers of the first 'n' even natural numbers.\n             Returns 0 if n is zero or negative.\n\n    Raises:\n        TypeError: If the input n is not an integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input n must be an integer.\")\n\n    if n <= 0:\n        return 0\n\n    sum_of_powers = 0\n    for i in range(1, n + 1):\n        even_number = 2 * i\n        power_of_even = even_number ** 5\n        sum_of_powers += power_of_even\n\n    return sum_of_powers"}
{"task_id": "Mbpp/272", "solution": "def rear_extract(input_list: list) -> list:\n    \"\"\"\n    Extracts the last element from each tuple within a list of tuples.\n\n    Args:\n        input_list: A list of tuples.\n\n    Returns:\n        A list containing the last element of each tuple in the input list.\n\n    Raises:\n        TypeError: If the input is not a list or if the elements of the list are not tuples.\n\n    Examples:\n        rear_extract([(1, 2, 3), (4, 5, 6), (7, 8, 9)]) == [3, 6, 9]\n        rear_extract([]) == []\n        rear_extract([(1,), (2, 3), (4, 5, 6, 7)]) == [1, 3, 7]\n    \"\"\"\n\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    result = []\n    for item in input_list:\n        if not isinstance(item, tuple):\n            raise TypeError(\"All elements of the list must be tuples.\")\n        if item:  # Avoid errors with empty tuples\n            result.append(item[-1])\n\n    return result"}
{"task_id": "Mbpp/273", "solution": "def subtract_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Subtracts elements of two tuples element-wise.\n\n    Args:\n        tuple1: The first tuple.\n        tuple2: The second tuple.\n\n    Returns:\n        A new tuple containing the element-wise differences.\n\n    Raises:\n        ValueError: If the input tuples are not of the same length.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Tuples must have the same length\")\n\n    result_list = []\n    for i in range(len(tuple1)) :\n        difference = tuple1[i] - tuple2[i]\n        result_list.append(difference)\n\n    result_tuple = tuple(result_list)\n    return result_tuple"}
