{"task_id": "Mbpp/439", "solution": "def multiple_to_single(input_list):\n    \"\"\"\n    Concatenates a list of integers into a single integer.\n\n    Args:\n        input_list: A list of integers.\n\n    Returns:\n        An integer formed by concatenating the integers in the input list.\n        Returns 0 if the input list is empty.\n\n    Raises:\n        TypeError: If the input is not a list or if the list contains non-integer elements.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    for element in input_list:\n        if not isinstance(element, int):\n            raise TypeError(\"List elements must be integers.\")\n\n    if not input_list:\n        return 0\n\n    concatenated_string = \"\"\n    for num in input_list:\n        concatenated_string += str(num)\n\n    return int(concatenated_string)"}
{"task_id": "Mbpp/440", "solution": "def find_first_adverb(sentence: str) -> tuple[int, int, str] | None:\n    \"\"\"\n    Identifies the first adverb in a given sentence and returns its position and value.\n\n    Args:\n        sentence: A string representing the sentence to be analyzed.\n\n    Returns:\n        A tuple containing the start index, end index, and the adverb itself.\n        Returns None if no adverb is found.\n    \"\"\"\n    if not isinstance(sentence, str):\n        raise TypeError(\"Input must be a string.\")\n\n    if not sentence:\n        return None\n\n    words = sentence.split()\n    start_search_position = 0\n    for word in words:\n        if word.endswith(\"ly\"):\n            start_index = sentence.find(word, start_search_position)\n            end_index = start_index + len(word)\n            return (start_index, end_index, word)\n        start_search_position += len(word) + 1  # +1 to account for the space\n\n    return None"}
{"task_id": "Mbpp/441", "solution": "def surfacearea_cube(side_length: float) -> float:\n    \"\"\"\n    Calculates the surface area of a cube.\n\n    Args:\n        side_length: The length of one side of the cube (must be non-negative).\n\n    Returns:\n        The surface area of the cube.  Returns 0 if side_length is negative.\n\n    Raises:\n        TypeError: if side_length is not not a number.\n    \"\"\"\n    if not isinstance(side_length, (int, float)):\n        raise TypeError(\"Side length must be a number\")\n    if side_length < 0:\n        return 0.0\n    surface_area = 6 * side_length * side_length\n    return surface_area"}
{"task_id": "Mbpp/445", "solution": "def index_multiplication(tuple1, tuple2):\n    \"\"\"\n    Performs index-wise multiplication of elements in two tuples.\n\n    Args:\n        tuple1: The first tuple.\n        tuple2: The second tuple.\n\n    Returns:\n        A new tuple containing the element-wise products.\n\n    Raises:\n        ValueError: If the input tuples have different lengths.\n        TypeError: If the elements of the tuples are not numeric.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n    result = []\n    for i in range(len(tuple1)):\n        try:\n            if isinstance(tuple1[i], tuple) and isinstance(tuple2[i], tuple):\n                if len(tuple1[i]) != len(tuple2[i]):\n                    raise ValueError(\"Inner tuples must have the same length.\")\n                inner_result = tuple(tuple1[i][j] * tuple2[i][j] for j in range(len(tuple1[i]))\n)\n                result.append(inner_result)\n            else:\n                result.append(tuple1[i] * tuple2[i])\n        except TypeError:\n            raise TypeError(\"Elements must be numeric for multiplication.\")\n\n    return tuple(result)"}
{"task_id": "Mbpp/446", "solution": "def count_Occurrence(input_tuple, input_list):\n    \"\"\"\n    Counts the occurrences of elements from a list within a tuple.\n\n    Args:\n        input_tuple (tuple): The tuple to search within.\n        input_list (list): The list of elements to count.\n\n    Returns:\n        int: The number of times elements from the list appear in the tuple.\n    \"\"\"\n    count = 0\n    for element in input_tuple:\n        if element in input_list:\n            count += 1\n    return count"}
{"task_id": "Mbpp/447", "solution": "def cube_nums(numbers: list) -> list:\n    \"\"\"\n    Calculates the cube of each number in an input list.\n\n    Args:\n        numbers: A list of numbers (integers or floats).\n\n    Returns:\n        A new list containing the cubes of the numbers in the input list.\n        Returns an empty list if the input list is empty.\n    \"\"\"\n    cubed_numbers = []\n    for number in numbers:\n        cubed_numbers.append(number**3)\n    return cubed_numbers"}
{"task_id": "Mbpp/448", "solution": "def sum_perrin(n):\n    \"\"\"\n    Calculate the sum of the first n Perrin numbers.\n\n    The Perrin sequence is defined as:\n    P(0) = 3, P(1) = 0, P(2) = 2, and P(n) = P(n-2) + P(n-3) for n > 2.\n\n    Args:\n      n: A non-negative integer representing the number of Perrin numbers to sum.\n\n    Returns:\n      The sum of the first n Perrin numbers. Returns 0 if n <= 0.\n    \"\"\"\n    if n <= 0:\n        return 0\n    if n == 1:\n        return 3\n    if n == 2:\n        return 3\n    if n == 3:\n        return 5\n\n    p0 = 3\n    p1 = 0\n    p2 = 2\n    sum_perrin = 5  # Sum of P(0) + P(1) + P(2)\n\n    for _ in range(3, n):\n        pn = p0 + p1\n        sum_perrin += pn\n        p0 = p1\n        p1 = p2\n        p2 = pn\n\n    return sum_perrin"}
{"task_id": "Mbpp/450", "solution": "def extract_string(string_list: list[str], target_length: int) -> list[str]:\n    \"\"\"\n    Filters a list of strings, returning only those strings with a specified length.\n\n    Args:\n        string_list: A list of strings.\n        target_length: An integer representing the desired string length.\n\n    Returns:\n        A list of strings that have the length equal to target_length.\n        Returns an empty list if no strings match or if the input list is empty.\n    \"\"\"\n    result_list = []\n    for string in string_list:\n        if len(string) == target_length:\n            result_list.append(string)\n    return result_list"}
