{"task_id": "Mbpp/809", "solution": "def check_smaller(tuple1: tuple, tuple2: tuple) -> bool:\n    \"\"\"\n    Compares two tuples element-wise to determine if each element in the second tuple\n    is smaller than its corresponding element in the first tuple.\n\n    Args:\n        tuple1: The first tuple (of numbers).\n        tuple2: The second tuple (of numbers).\n\n    Returns:\n        True if each element in tuple2 is strictly smaller than its corresponding\n        element in tuple1. False otherwise (including if the tuples have different lengths).\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        return False\n    for i in range(len(tuple1)):\n        if tuple2[i] >= tuple1[i]:\n            return False\n    return True"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(scores):\n    \"\"\"Calculates the maximum aggregate from a list of tuples.\n    Args:\n        scores: A list of tuples with the name of the person and their score.\n    Returns:\n        The name of the person with the maximum aggregate and their aggregate.\n        For example:\n        max_aggregate([('Juan Whelan',90),('Sabah Colley',88),('Peter Nichols',7),('Juan Whelan',122),('Sabah Colley',84)])==('Juan Whelan', 212)\n    \"\"\"\n    aggregate_scores = {}\n    for name, score in scores:\n        aggregate_scores[name] = aggregate_scores.get(name, 0) + score\n    if not aggregate_scores:\n        return None\n    max_name = max(aggregate_scores, key=aggregate_scores.get)\n    return (max_name, aggregate_scores[max_name])"}
{"task_id": "Mbpp/308", "solution": "import heapq\ndef large_product(list1: list[float | int], list2: list[float | int], n: int) -> list[float | int]:\n    \"\"\"\n    Identifies the n largest products formed by selecting one element from each of two input lists.\n\n    Args:\n        list1: A list of numerical values (integers or floats).\n        list2: A list of numerical values (integers or floats).\n        n: An integer representing the number of largest products to return.\n\n    Returns:\n        A list containing the n largest products, sorted in descending order.\n\n    Raises:\n        TypeError: If the input types are incorrect.\n        ValueError: If n is not a positive integer.\n    \"\"\"\n\n    if not isinstance(list1, list) or not isinstance(list2, list) or not isinstance(n, int):\n        raise TypeError(\"Invalid input types\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    if not list1 or not list2:\n        return []\n\n    products = []\n    for x in list1:\n        for y in list2:\n            products.append(x * y)\n\n    if n >= len(list1) * len(list2):\n        return sorted(products, reverse=True)\n    else:\n        largest_products = heapq.nlargest(n, products)\n        return list(largest_products)"}
