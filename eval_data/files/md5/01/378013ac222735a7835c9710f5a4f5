{"task_id": "Mbpp/61", "solution": "def count_substrings(s: str) -> int:\n    \"\"\"\n    Counts the number of substrings in a string where the sum of the digits\n    equals the length of the substring.\n\n    Args:\n        s: The input string.\n\n    Returns:\n        The number of substrings that satisfy the condition.\n    \"\"\"\n    count = 0\n    n = len(s)\n\n    if n == 0:\n        return 0\n\n    for i in range(n):\n        for j in range(i, n):\n            substring = s[i:j+1]\n            digit_sum = 0\n            for char in substring:\n                if char.isdigit():\n                    digit_sum += int(char)\n            if digit_sum == len(substring):\n                count += 1\n\n    return count"}
{"task_id": "Mbpp/62", "solution": "def smallest_num(numbers):\n    \"\"\"\n    Finds the smallest number within a given list of numerical values.\n\n    Args:\n        numbers: A list of numbers (integers or floats).\n\n    Returns:\n        The smallest number present in the input list.\n        Returns None if the input list is empty.\n\n    Raises:\n        TypeError: If the input is not a list or if the list contains non-numerical values.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not numbers:\n        return None\n\n    smallest = numbers[0]\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise TypeError(\"List must contain only numbers.\")\n        if num < smallest:\n            smallest = num\n\n    return smallest"}
{"task_id": "Mbpp/63", "solution": "def max_difference(tuple_list):\n    \"\"\"\n    Finds the maximum difference between pairs of numbers within a list of tuples.\n\n    Args:\n        tuple_list: A list of tuples, where each tuple contains two numerical values (integers or floats).\n\n    Returns:\n        A single numerical value representing the maximum difference found among all tuples.\n        Returns 0 if the input list is empty.\n\n    Raises:\n        TypeError: If the input is not a list, an element in the list is not a tuple, or an element in a tuple is not a number.\n        ValueError: If a tuple does not contain exactly two elements.\n    \"\"\"\n    if not isinstance(tuple_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not tuple_list:\n        return 0\n\n    max_diff = 0\n    for tup in tuple_list:\n        if not isinstance(tup, tuple):\n            raise TypeError(\"Each element in the list must be a tuple.\")\n\n        if len(tup) != 2:\n            raise ValueError(\"Each tuple must contain exactly two elements.\")\n\n        if not all(isinstance(x, (int, float)) for x in tup):\\\n            raise TypeError(\"All elements in the tuple must be numbers (int or float).\")\n\n        diff = abs(tup[0] - tup[1])\n        max_diff = max(max_diff, diff)\n\n    return max_diff"}
{"task_id": "Mbpp/64", "solution": "def subject_marks(marks_list: list[tuple]) -> list[tuple]:\n    \"\"\"Sorts a list of tuples based on the second value of each tuple.\n\n    Args:\n        marks_list: A list of tuples.\n\n    Returns:\n        A new list of tuples, sorted based on the second value.\n\n    Example:\n        >>> marks = [('English', 88), ('Science', 90), ('Maths', 97), ('Social science', 82)]\n        >>> subject_marks(marks)\n        [('Social science', 82), ('English', 88), ('Science', 90), ('Maths', 97)]\n    \"\"\"\n    return sorted(marks_list, key=lambda x: x[1])"}
{"task_id": "Mbpp/65", "solution": "import logging\ndef recursive_list_sum(data: list) -> float:\n    \"\"\"\n    Calculates the sum of all numbers in a potentially nested list.\n\n    Args:\n        data: A list that can contain numbers (int, float) or other lists.\n\n    Returns:\n        The sum of all numbers in the flattened list.\n\n    Raises:\n        TypeError: If the input is not a list.\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input must be a list.\")\n\n    sum_accumulator = 0.0\n\n    for element in data:\n        if isinstance(element, (int, float)):\n            sum_accumulator += element\n        elif isinstance(element, list):\n            sum_accumulator += recursive_list_sum(element)\n        else:\n            logging.warning(f\"Ignoring non-numeric, non-list element: {element}\")\n\n    return sum_accumulator"}
