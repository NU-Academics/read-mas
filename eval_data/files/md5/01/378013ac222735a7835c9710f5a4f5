{"task_id": "Mbpp/739", "solution": "def find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n\n    Args:\n        n: The number of digits.\n\n    Returns:\n        The index k of the smallest triangular number with n digits.\n\n    Raises:\n        TypeError: If n is not a positive integer.\n        ValueError: If no triangular number with n digits is found within a reasonable range.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input n must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"Input n must be a positive integer.\")\n\n    k = 1\n    max_iterations = 10**(n+1) # Reasonable range limit. This can be adjusted\n\n    while k <= max_iterations:\n        triangular_number = k * (k + 1) // 2\n        num_digits = len(str(triangular_number))\n\n        if num_digits == n:\n            return k\n\n        k += 1\n\n    raise ValueError(f\"No triangular number with {n} digits found within the limit of {max_iterations} iterations.\")"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input_tuple: tuple) -> dict:\n    \"\"\"\n    Converts a tuple to a key-value dictionary using adjacent elements.\n\n    Args:\n        input_tuple: The tuple to convert.\n\n    Returns:\n        A dictionary created from the tuple.\n    \"\"\"\n    result_dict = {}\n    if not input_tuple:\n        return result_dict\n\n    for i in range(0, len(input_tuple) - 1, 2):\n        result_dict[input_tuple[i]] = input_tuple[i+1]\n    return result_dict"}
{"task_id": "Mbpp/741", "solution": "def are_all_characters_same(input_string: str) -> bool:\n    \"\"\"\n    Checks if all characters in a string are the same.\n\n    Args:\n        input_string: The string to check.\n\n    Returns:\n        True if all characters are the same, False otherwise.\n    \"\"\"\n    if not input_string:\n        return True\n    first_char = input_string[0]\n    for char in input_string:\n        if char != first_char:\n            return False\n    return True"}
