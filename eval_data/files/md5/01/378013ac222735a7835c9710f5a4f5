{"task_id": "Mbpp/638", "solution": "def wind_chill(temperature, wind_velocity):\n    \"\"\"Calculates the wind chill index.\n\n    Args:\n        temperature (float): Temperature in Celsius.\n        wind_velocity (float): Wind velocity in km/h.\n\n    Returns:\n        int: The wind chill index, rounded to the nearest integer. Returns -999 if invalid input.\n    \"\"\"\n    try:\n        temperature = float(temperature)\n        wind_velocity = float(wind_velocity)\n    except ValueError:\n        return -999\n\n    if wind_velocity < 0:\n        return -999\n\n    wind_chill_index = 13.12 + (0.6215 * temperature) - (11.37 * (wind_velocity**0.16)) + (0.3965 * temperature * (wind_velocity**0.16))\n    return int(wind_chill_index + 0.5) # equivalent to math.floor(wind_chill_index + 0.5)"}
{"task_id": "Mbpp/639", "solution": "def sum_of_name_lengths(names: list[str]) -> int:\n    \"\"\"\n    Calculates the sum of the lengths of names in a list,\n    excluding names that start with a lowercase letter.\n    \"\"\"\n    total_length = 0\n    if not names:\n        return 0\n\n    for name in names:\n        if not isinstance(name, str):\n            continue # Skip if not a string\n        if not name:\n            continue # Skip empty string\n\n        first_char = name[0]\n        if 'a' <= first_char <= 'z':\n            continue  # Skip names starting with lowercase letters\n\n        total_length += len(name)\n\n    return total_length"}
{"task_id": "Mbpp/641", "solution": "def calculate_nonagonal_number(n):\n    \"\"\"\n    Calculates the nth nonagonal number.\n\n    Args:\n        n: The index of the nonagonal number to calculate.\n\n    Returns:\n        The nth nonagonal number.\n    \"\"\"\n    return n * (7 * n - 5) // 2"}
{"task_id": "Mbpp/643", "solution": "import re\ndef text_match_wordz_middle(text: str) -> bool:\n    \"\"\"\n    Checks if a given string contains the character 'z', but only if it's not at the\n    beginning or end of any word in the string.\n\n    Args:\n        text: The input string.\n\n    Returns:\n        True if at least one word contains 'z' in the middle, otherwise False.\n    \"\"\"\n    if not text:\n        return False\n\n    words = re.findall(r'\\b\\w+\\b', text)\n\n    for word in words:\n        if len(word) > 2:\n            if 'z' in word[1:-1]:\n                return True\n\n    return False"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(arr: list, k: int) -> list:\n    \"\"\"Reverses an array upto a given position k.\"\"\"\n    if k < 0:\n        return arr[:]  # Return a copy of the original array\n    n = len(arr)\n    new_arr = arr[:]  # Create a copy\n    if k >= n:\n        k = n - 1\n\n    left = 0\n    right = k\n\n    while left < right:\n      new_arr[left], new_arr[right] = new_arr[right], new_arr[left]\n      left += 1\n      right -= 1\n\n    return new_arr"}
{"task_id": "Mbpp/720", "solution": "def add_dict_to_tuple(input_tuple, input_dict):\n    \"\"\"Adds a dictionary to a tuple and returns a new tuple.\n\n    Args:\n        input_tuple: The input tuple.\n        input_dict: The input dictionary.\n\n    Returns:\n        A new tuple with the dictionary appended.\n\n    Raises:\n        TypeError: If input_tuple is not a tuple or input_dict is not a dictionary.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"input_tuple must be a tuple\")\n    if not isinstance(input_dict, dict):\n        raise TypeError(\"input_dict must be a dictionary\")\n\n    return input_tuple + (input_dict,)"}
{"task_id": "Mbpp/721", "solution": "def max_average_cost_path(matrix):\n    \"\"\"\n    Calculates the maximum average cost path from the top-left to the bottom-right cell\n    in a square matrix, where movement is restricted to right or down.\n\n    Args:\n        matrix: A list of lists representing the square matrix.\n\n    Returns:\n        A float representing the maximum average cost.\n    \"\"\"\n\n    # Input validation\n    if not matrix:\n        return 0.0\n\n    N = len(matrix)\n\n    if any(len(row) != N for row in matrix):\n        raise ValueError(\"Input matrix must be square.\")\n\n    if N == 1:\n        return float(matrix[0][0])\n\n    # Dynamic programming table\n    dp = [[0.0] * N for _ in range(N)]\n\n    # Initialization\n    dp[0][0] = float(matrix[0][0])\n\n    # Fill the first row\n    for i in range(1, N):\n        dp[0][i] = dp[0][i-1] + matrix[0][i]\n\n    # Fill the first column\n    for i in range(1, N):\n        dp[i][0] = dp[i-1][0] + matrix[i][0]\n\n    # Iteration\n    for i in range(1, N):\n        for j in range(1, N):\n            dp[i][j] = matrix[i][j] + max(dp[i-1][j], dp[i][j-1])\n\n    # Average cost calculation\n    max_average = dp[N-1][N-1] / (2*N - 1)\n\n    return float(max_average)"}
{"task_id": "Mbpp/722", "solution": "def filter_data(student_data: dict, min_height: float, min_weight: float) -> dict:\n    \"\"\"\n    Filters a dictionary of student data based on minimum height and weight.\n\n    Args:\n        student_data: A dictionary where keys are student names (strings) and\n            values are tuples of (height, weight).\n        min_height: The minimum height required.\n        min_weight: The minimum weight required.\n\n    Returns:\n        A new dictionary containing only the students who meet the minimum\n        height and weight criteria.\n    \"\"\"\n    filtered_data = {}\n    for student_name, student_metrics in student_data.items():\n        if isinstance(student_metrics, tuple) and len(student_metrics) == 2:\n            height, weight = student_metrics\n            if isinstance(height, (int, float)) and isinstance(weight, (int, float)) and height >= 0 and weight >= 0:\n                if height >= min_height and weight >= min_weight:\n                    filtered_data[student_name] = student_metrics\n    return filtered_data"}
{"task_id": "Mbpp/723", "solution": "def count_same_pair(list1, list2):\n    \"\"\"\n    Counts the number of indices where two lists have the same values.\n\n    Args:\n        list1: The first list.\n        list2: The second list.\n\n    Returns:\n        The number of indices where list1[i] == list2[i].\n\n    Raises:\n        ValueError: If the lists have different lengths.\n    \"\"\"\n    if len(list1) != len(list2):\n        raise ValueError(\"Lists must have the same length\")\n\n    count = 0\n    for i in range(len(list1)):\n        if list1[i] == list2[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of the digits of base raised to the power of power.\n\n    Args:\n        base: The base integer.\n        power: The non-negative integer exponent.\n\n    Returns:\n        The sum of the digits of base**power.\n\n    Raises:\n        TypeError: If base or power is not an integer.\n        ValueError: If power is negative.\n    \"\"\"\n    if not isinstance(base, int):\n        raise TypeError(\"Base must be an integer\")\n    if not isinstance(power, int):\n        raise TypeError(\"Power must be an integer\")\n    if power < 0:\n        raise ValueError(\"Power must be a non-negative integer\")\n\n    if power == 0:\n        return 1 if base != 0 else 0\n\n    if base == 0:\n        return 0\n\n    result = base ** power\n    result_str = str(result)\n    digit_sum = 0\n    for digit_char in result_str:\n        digit = int(digit_char)\n        digit_sum += digit\n\n    return digit_sum"}
{"task_id": "Mbpp/725", "solution": "def extract_quotation(input_string):\n    \"\"\"\n    Extracts substrings enclosed within double quotation marks from a given string.\n\n    Args:\n        input_string: The string to extract quotations from.\n\n    Returns:\n        A list of strings, where each string is a substring enclosed in double quotes.\n    \"\"\"\n    extracted_list = []\n    start_index = -1\n    for i, char in enumerate(input_string):\n        if char == '\\\"':\n            if start_index == -1:\n                start_index = i\n            else:\n                extracted_list.append(input_string[start_index + 1:i])\n                start_index = -1\n    return extracted_list"}
{"task_id": "Mbpp/726", "solution": "def multiply_elements(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Calculates the product of consecutive elements in a tuple.\n\n    Args:\n        input_tuple: A tuple of numerical values.\n\n    Returns:\n        A tuple containing the products of consecutive elements.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    n = len(input_tuple)\n    if n < 2:\n        return ()\n\n    products = []\n    for i in range(n - 1):\n        if not isinstance(input_tuple[i], (int, float)) or not isinstance(input_tuple[i+1], (int, float)):\n            raise TypeError(\"Tuple elements must be numerical\")\n        products.append(input_tuple[i] * input_tuple[i+1])\n    return tuple(products)"}
{"task_id": "Mbpp/728", "solution": "def sum_list(list1: list[float], list2: list[float]) -> list[float]:\n    \"\"\"\n    Performs element-wise addition of two lists.\n\n    Args:\n        list1: The first list of numbers.\n        list2: The second list of numbers.\n\n    Returns:\n        A new list containing the element-wise sums of list1 and list2.\n\n    Raises:\n        ValueError: If the input lists have different lengths.\n    \"\"\"\n    if len(list1) != len(list2):\n        raise ValueError(\"Input lists must have the same length.\")\n\n    result = []\n    for i in range(len(list1)):\n        result.append(list1[i] + list2[i])\n\n    return result"}
{"task_id": "Mbpp/730", "solution": "def remove_consecutive_duplicates(input_list: list) -> list:\n    \"\"\"\n    Removes consecutive duplicate elements from a list.\n\n    Args:\n        input_list: The list to process.\n\n    Returns:\n        A new list with consecutive duplicates removed, preserving original order.\n\n    Raises:\n        TypeError: If the input is not a list.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not input_list:\n        return []\n\n    result_list = []\n    for element in input_list:\n        if not result_list or element != result_list[-1]:\n            result_list.append(element)\n\n    return result_list"}
{"task_id": "Mbpp/731", "solution": "import math\ndef lateralsurface_cone(r, h):\n    \"\"\"\n    Calculates the lateral surface area of a cone.\n\n    Args:\n        r (float or int): The radius of the cone's base.\n        h (float or int): The height of the cone.\n\n    Returns:\n        float: The lateral surface area of the cone.\n\n    Raises:\n        TypeError: If r or h is not a number.\n        ValueError: If r or h is negative.\n    \"\"\"\n    if not isinstance(r, (int, float)) or not isinstance(h, (int, float)):\n        raise TypeError(\"Radius and height must be numeric.\")\n\n    if r < 0 or h < 0:\n        raise ValueError(\"Radius and height must be non-negative.\")\n\n    l = math.sqrt(r**2 + h**2)\n    lateral_surface_area = math.pi * r * l\n    return lateral_surface_area"}
{"task_id": "Mbpp/732", "solution": "def replaceCharacters(input_string: str) -> str:\n    \"\"\"\n    Replaces all occurrences of spaces, commas, and dots in a string with colons.\n    \"\"\"\n    if not input_string:\n        return \"\"\n\n    new_string = \"\"\n    for char in input_string:\n        if char in (\" \", \",\", \".\"):\n            new_string += \":\"\n        else:\n            new_string += char\n    return new_string"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(arr, target):\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array.\n\n    Args:\n        arr: A sorted array of integers.\n        target: The integer to search for.\n\n    Returns:\n        The index of the first occurrence of the target integer in the array.\n        Returns -1 if the target integer is not found.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n\n        if arr[mid] == target:\n            result = mid\n            high = mid - 1  # Search in the left subarray for an earlier occurrence\n        elif arr[mid] < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n\n    return result"}
{"task_id": "Mbpp/734", "solution": "def sum_of_sublist_products(nums: list[float]) -> float:\n    \"\"\"\n    Calculates the sum of the products of all possible sublists of a list.\n\n    Args:\n        nums: A list of numbers (integers or floats).\n\n    Returns:\n        The sum of the products of all sublists.  Returns 0 if the input list is empty.\n    \"\"\"\n    n = len(nums)\n    if n == 0:\n        return 0\n\n    total_sum = 0\n\n    for i in range(n):\n        for j in range(i, n):\n            product = 1\n            for k in range(i, j + 1):\n                product *= nums[k]\n            total_sum += product\n\n    return total_sum"}
{"task_id": "Mbpp/735", "solution": "def toggle_bits(n: int) -> int:\n    \"\"\"\n    Toggles the bits of an integer except the first (most significant) and the last bits.\n\n    Args:\n        n: The non-negative integer to modify.\n\n    Returns:\n        The integer with the specified bits toggled.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    num_bits = n.bit_length()\n    if num_bits <= 2:\n        return n  # Nothing to toggle if there are 0 or 1 bits in the middle\n\n    # Create a mask with 1s in all positions except the first and last\n    mask = (1 << (num_bits - 1)) - 1  # All 1s except MSB\n    mask = mask ^ 1 # clear LSB\n\n\n    result = n ^ mask\n\n    return result"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sorted_array: list[float], target_value: float) -> int:\n  \"\"\"\n  Finds the left insertion point for a target value in a sorted array.\n\n  Args:\n    sorted_array: A list of numerical values sorted in ascending order.\n    target_value: The value to find the left insertion point for.\n\n  Returns:\n    The index where the target value should be inserted to maintain the sorted order.\n  \"\"\"\n  low = 0\n  high = len(sorted_array)\n\n  if not sorted_array:\n    return 0\n\n  while low < high:\n    mid = (low + high) // 2\n    if sorted_array[mid] < target_value:\n      low = mid + 1\n    else:\n      high = mid\n\n  return low"}
