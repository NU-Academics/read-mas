{"task_id": "Mbpp/619", "solution": "def moveNumbersToEnd(input_string):\n    \"\"\"\n    Rearranges a string by moving all numerical digits to the end of the string,\n    while preserving the relative order of both non-numeric characters and digits.\n\n    Args:\n        input_string: The input string.\n\n    Returns:\n        A new string with all digits moved to the end.\n    \"\"\"\n    if not input_string:\n        return \"\"\n\n    non_numeric_chars = \"\"\n    numeric_chars = \"\"\n\n    for char in input_string:\n        if char.isdigit():\n            numeric_chars += char\n        else:\n            non_numeric_chars += char\n\n    result = non_numeric_chars + numeric_chars\n    return result"}
{"task_id": "Mbpp/765", "solution": "def find_nth_polite(n: int) -> int:\n    \"\"\"\n    Calculates the nth polite number.\n\n    A polite number is a number that can be expressed as the sum of two or more consecutive positive integers.\n    Equivalently, a number is polite if and only if it is not a power of 2.\n\n    Args:\n        n (int): A positive integer representing the desired polite number in the sequence.\n\n    Returns:\n        int: The nth polite number.\n\n    Raises:\n        ValueError: If n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input must be a positive integer\")\n\n    polite_count = 0\n    num = 1\n    while polite_count < n:\n        if (num & (num - 1)) != 0:  # Check if num is NOT a power of 2\n            polite_count += 1\n        if polite_count == n:\n            return num\n        num += 1\n    return -1  # Should not reach here"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list[int], target_sum: int) -> int:\n    \"\"\"\n    Counts the number of pairs in a list of numbers whose sum equals a given target value.\n\n    Args:\n        numbers: A list of integers.\n        target_sum: An integer representing the target sum.\n\n    Returns:\n        An integer representing the number of pairs that sum to target_sum.\n    \"\"\"\n    count = 0\n    for i in range(len(numbers)):\n        for j in range(i + 1, len(numbers)):\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n    return count"}
{"task_id": "Mbpp/769", "solution": "def list_difference(list1: list, list2: list) -> list:\n    \"\"\"\n    Calculates the difference between two lists.\n\n    Args:\n        list1: The first list.\n        list2: The second list.\n\n    Returns:\n        A new list containing elements present in list1 but not in list2,\n        preserving the original order from list1.\n    \"\"\"\n    difference_list = []\n    seen = set() # for keeping track of what has been added to avoid duplicates\n    for element in list1:\n        if element not in list2 and element not in seen:\n            difference_list.append(element)\n            seen.add(element)\n    return difference_list"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n):\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n    sum_val = 0\n    for i in range(1, n + 1):\n        odd_number = 2 * i - 1\n        sum_val += odd_number**4\n    return sum_val"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression):\n    stack = []\n    opening_brackets = tuple('({[')\n    closing_brackets = tuple(')}]')\n    bracket_map = dict(zip(opening_brackets, closing_brackets))\n\n    for char in expression:\n        if char in opening_brackets:\n            stack.append(bracket_map[char])\n        elif char in closing_brackets:\n            if not stack or char != stack.pop():\n                return False\n    return not stack"}
{"task_id": "Mbpp/772", "solution": "def remove_length(text, k):\n    if not isinstance(text, str):\n        raise TypeError(\"Input text must be a string.\")\n    if not isinstance(k, int):\n        raise TypeError(\"Input k must be an integer.\")\n\n    if k < 0:\n        return text\n\n    words = text.split()\n    filtered_words = [word for word in words if len(word) != k]\n    return \" \".join(filtered_words)"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(text: str, pattern: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Finds the first occurrence of a substring within a string.\n\n    Args:\n        text: The main string to search within.\n        pattern: The substring to search for.\n\n    Returns:\n        A tuple containing the substring, start index, and end index if found.\n        None if the substring is not found.\n    \"\"\"\n    for i in range(len(text) - len(pattern) + 1):\n        if text[i:i+len(pattern)] == pattern:\n            return (pattern, i, i + len(pattern))\n    return None"}
