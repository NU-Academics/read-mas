{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list):\n    \"\"\"\n    Returns a list of tuples containing consecutive pairs from the input list.\n\n    Args:\n        input_list: A list of any data type.\n\n    Returns:\n        A list of tuples. Each tuple contains two consecutive elements from the input list.\n        Returns an empty list if the input list has fewer than two elements.\n\n    Raises:\n        TypeError: If the input is not a list.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    result = []\n    for i in range(len(input_list) - 1):\n        result.append((input_list[i], input_list[i + 1]))\n    return result"}
{"task_id": "Mbpp/84", "solution": "def newman_conway(n):\n    \"\"\"\n    Calculates the nth Newman-Conway number using memoization.\n\n    Args:\n        n: An integer representing the desired term in the sequence.\n\n    Returns:\n        The nth Newman-Conway number (an integer). Returns 0 for invalid input (n <= 0).\n    \"\"\"\n    memo = {}\n\n    def _newman_conway(n):\n        if n <= 0:\n            return 0\n        if n in memo:\n            return memo[n]\n        if n == 1 or n == 2:\n            return 1\n        \n        result = _newman_conway(_newman_conway(n-1)) + _newman_conway(n - _newman_conway(n-1))\n        memo[n] = result\n        return result\n\n    return _newman_conway(n)"}
{"task_id": "Mbpp/294", "solution": "def max_val(data: list) -> float | int | None:\n    \"\"\"\n    Finds the maximum numerical value in a heterogeneous list.\n\n    Args:\n        data: A list containing elements of various data types.\n\n    Returns:\n        The maximum numerical value (int or float) in the list,\n        or None if the list is empty or contains no numerical values.\n    \"\"\"\n    max_number = None\n    for item in data:\n        if isinstance(item, (int, float)):\n            if max_number is None or item > max_number:\n                max_number = item\n    return max_number"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(data, depth=1):\n    \"\"\"\n    Calculates the depth of a dictionary.\n\n    Args:\n        data (dict): The dictionary to analyze.\n        depth (int): The current depth level (default=1).\n\n    Returns:\n        int: The maximum depth of the dictionary.\n    \"\"\"\n    if not isinstance(data, dict):\n        return depth\n\n    max_depth = depth\n    for value in data.values():\n        if isinstance(value, dict):\n            max_depth = max(max_depth, dict_depth(value, depth + 1))\n    return max_depth"}
{"task_id": "Mbpp/476", "solution": "def big_sum(arr: list[float | int]) -> float | int:\n    \"\"\"\n    Calculates the sum of the largest and smallest values in a given numerical array.\n\n    Args:\n        arr (list[float | int]): A list of numbers (integers or floats).\n\n    Returns:\n        float | int: The sum of the largest and smallest values in the array.\n                     Returns 0 if the array is empty.\n\n    Raises:\n        TypeError: If the input is not a list or if the list contains non-numerical values.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not arr:\n        return 0\n\n    for element in arr:\n        if not isinstance(element, (int, float)):\n            raise TypeError(\"List elements must be numerical (int or float).\")\n\n    smallest = arr[0]\n    largest = arr[0]\n\n    for num in arr:\n        if num < smallest:\n            smallest = num\n        if num > largest:\n            largest = num\n\n    return largest + smallest"}
{"task_id": "Mbpp/478", "solution": "def remove_lowercase(input_string):\n    \"\"\"\n    Removes all lowercase substrings from the input string.\n\n    Args:\n        input_string (str): The string to process.\n\n    Returns:\n        str: A new string with all lowercase substrings removed.\n    \"\"\"\n    result = \"\"\n    i = 0\n    while i < len(input_string):\n        if 'a' <= input_string[i] <= 'z':\n            # Skip over the entire lowercase substring\n            while i < len(input_string) and 'a' <= input_string[i] <= 'z':\n                i += 1\n        else:\n            result += input_string[i]\n            i += 1\n    return result"}
