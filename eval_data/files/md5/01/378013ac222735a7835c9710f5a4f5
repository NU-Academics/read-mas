{"task_id": "Mbpp/796", "solution": "def return_sum(input_dict: dict) -> float:\n    \"\"\"\n    Calculates the sum of all numerical values in a dictionary.\n\n    Args:\n        input_dict (dict): A dictionary with numerical values.\n\n    Returns:\n        float: The sum of the numerical values in the dictionary.\n               Returns 0 if the dictionary is empty.\n    \"\"\"\n    total_sum = 0\n    if not input_dict:\n        return 0\n    for value in input_dict.values():\n        if isinstance(value, (int, float)):\n            total_sum += value\n    return total_sum"}
{"task_id": "Mbpp/797", "solution": "def sum_in_range(l, r):\n    \"\"\"\n    Calculates the sum of all odd natural numbers within the range [l, r] (inclusive).\n\n    Args:\n        l: The lower bound of the range (inclusive).\n        r: The upper bound of the range (inclusive).\n\n    Returns:\n        The sum of all odd numbers within the range.  Returns 0 if l > r.\n    \"\"\"\n    if l > r:\n        return 0\n    sum_odd = 0\n    for i in range(l, r + 1):\n        if i % 2 != 0:\n            sum_odd += i\n    return sum_odd"}
{"task_id": "Mbpp/798", "solution": "def _sum(arr):\n    \"\"\"\n    Calculates the sum of elements in a numerical list.\n\n    Args:\n        arr: A list of numerical values (integers or floats).\n\n    Returns:\n        The sum of the elements in the input list. Returns 0 if the list is empty.\n    \"\"\"\n    total = 0\n    for num in arr:\n        total += num\n    return total"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(num, d):\n    \"\"\"Rotate left bits by d bits a given number. We assume that the number is 32 bit.\"\"\"\n    d = d % 32\n    rotated_num = (num << d) | (num >> (32 - d))\n    return rotated_num"}
