{"task_id": "Mbpp/277", "solution": "def dict_filter(input_dict, n):\n    \"\"\"\n    Filters a dictionary to include only entries with values >= n.\n\n    Args:\n        input_dict: The dictionary to filter.\n        n: The integer threshold.\n\n    Returns:\n        A new dictionary containing only the key-value pairs that satisfy the condition.\n    Raises:\n        TypeError: If the inputs are not of the correct type.\n    \"\"\"\n    if not isinstance(input_dict, dict):\n        raise TypeError(\"input_dict must be a dictionary\")\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n\n    filtered_dict = {}\n    for key, value in input_dict.items():\n        try:\n            if value >= n:\n                filtered_dict[key] = value\n        except TypeError:\n            raise TypeError(\"Dictionary values must be comparable to n\")\n\n    return filtered_dict"}
{"task_id": "Mbpp/278", "solution": "def count_first_elements(input_tuple):\n    \"\"\"\n    Counts the number of elements in a tuple before the first element that is itself a tuple.\n\n    Args:\n        input_tuple: A tuple of any data types.\n\n    Returns:\n        An integer representing the count of elements before the first tuple element,\n        or the total number of elements if no tuple element exists.\n\n    Raises:\n        TypeError: If the input is not a tuple.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    count = 0\n    for i, element in enumerate(input_tuple):\n        if isinstance(element, tuple):\n            return count\n        count += 1\n\n    return len(input_tuple)"}
{"task_id": "Mbpp/279", "solution": "def decagonal_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth decagonal number.\n\n    Args:\n        n: The term in the decagonal number sequence (positive integer).\n\n    Returns:\n        The nth decagonal number.\n\n    Raises:\n        TypeError: If n is not an integer.\n        ValueError: If n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"Input must be a positive integer.\")\n    return n * (4 * n - 3)\n\n\ndef is_decagonal(number: int) -> bool:\n    \"\"\"\n    Checks if a given number is a decagonal number.\n\n    Args:\n        number: The number to check (non-negative integer).\n\n    Returns:\n        True if the number is a decagonal number, False otherwise.\n\n    Raises:\n        TypeError: If number is not a non-negative integer.\n    \"\"\"\n    if not isinstance(number, int):\n        raise TypeError(\"Input must be an integer.\")\n    if number < 0:\n        raise TypeError(\"Input must be a non-negative integer.\")\n\n    if number == 0:\n      return True\n\n    n = (3 + (9 + 16 * number)**0.5) / 8\n    return n == int(n)"}
{"task_id": "Mbpp/280", "solution": "def sequential_search(array: list, element: any) -> tuple[bool, int]:\n  \"\"\"\n  Searches for a specific element within an array using a sequential search algorithm.\n\n  Args:\n    array: A list of elements. The elements should be of a comparable type.\n    element: The element to search for within the array.\n\n  Returns:\n    A tuple: (found, index)\n      found: A boolean value. True if the element is found in the array, False otherwise.\n      index: An integer value. If the element is found, index is the index of the element in the array. If the element is not found, index is -1.\n  \"\"\"\n  for i in range(len(array)):\n    if array[i] == element:\n      return (True, i)\n  return (False, -1)"}
{"task_id": "Mbpp/281", "solution": "def is_list_unique(input_list: list) -> bool:\n    \"\"\"\n    Determines if all elements in the input list are unique.\n\n    Args:\n        input_list: A Python list of any data type.\n\n    Returns:\n        True if all elements are unique, False otherwise.\n    \"\"\"\n    if not input_list:\n        return True\n\n    seen = set()\n    for element in input_list:\n        if element in seen:\n            return False\n        seen.add(element)\n\n    return True"}
{"task_id": "Mbpp/282", "solution": "def subtract_lists(list1, list2):\n    \"\"\"\n    Subtracts two lists element-wise.\n\n    Args:\n        list1: The first list.\n        list2: The second list.\n\n    Returns:\n        A new list containing the element-wise differences.\n\n    Raises:\n        TypeError: If either input is not a list or if elements are not subtractable.\n    \"\"\"\n\n    if not isinstance(list1, list):\n        raise TypeError(\"list1 must be a list\")\n    if not isinstance(list2, list):\n        raise TypeError(\"list2 must be a list\")\n\n    len1 = len(list1)\n    len2 = len(list2)\n    result = []\n\n    for i in range(min(len1, len2)):\n        try:\n            result.append(list1[i] - list2[i])\n        except TypeError:\n            raise TypeError(f\"Cannot subtract elements at index {i}: {list1[i]} - {list2[i]}\")\n\n    if len1 > len2:\n        for i in range(len2, len1):\n            result.append(list1[i])\n    elif len2 > len1:\n        for i in range(len1, len2):\n            result.append(-list2[i])\n\n    return result"}
{"task_id": "Mbpp/283", "solution": "def validate(n):\n    try:\n        n = int(n)\n    except (ValueError, TypeError):\n        return False\n    \n    n_str = str(n)\n    digit_counts = {}\n    for digit in n_str:\n        digit_counts[digit] = digit_counts.get(digit, 0) + 1\n\n    for digit, count in digit_counts.items():\n        if count > int(digit):\n            return False\n\n    return True"}
