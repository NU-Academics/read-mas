{"task_id": "Mbpp/572", "solution": "def two_unique_nums(numbers: list) -> list:\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    counts = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    result = []\n    seen = set()\n    for num in numbers:\n        if counts[num] == 1 and num not in seen:\n            result.append(num)\n            seen.add(num)\n\n    return result"}
{"task_id": "Mbpp/573", "solution": "def unique_product(numbers: list[float | int]) -> float | int:\n    unique_numbers = set()\n    product = 1\n    if not numbers:\n        return 1\n    for number in numbers:\n        if number not in unique_numbers:\n            unique_numbers.add(number)\n            product *= number\n    if not unique_numbers:\n      return 1\n    return product"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(list1: list, list2: list) -> bool:\n    \"\"\"\n    Checks if list2 is a sublist of list1.\n\n    Args:\n        list1: The main list.\n        list2: The potential sublist.\n\n    Returns:\n        True if list2 is a sublist of list1, False otherwise.\n    \"\"\"\n    i = 0  # index for list1\n    j = 0  # index for list2\n\n    while i < len(list1) and j < len(list2):\n        if list1[i] == list2[j]:\n            j += 1\n        i += 1\n\n    return j == len(list2)"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n):\n  \"\"\"\n  Calculates the last digit of the factorial of a non-negative integer n.\n\n  Args:\n    n: A non-negative integer.\n\n  Returns:\n    The last digit of n! (an integer).\n  \"\"\"\n  if n == 0:\n    return 1\n  elif n >= 5:\n    return 0\n  else:\n    factorial = 1\n    for i in range(1, n + 1):\n      factorial *= i\n    return factorial % 10"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n\n    Args:\n        list1: The first list.\n        list2: The second list.\n        list3: The third list.\n\n    Returns:\n        A new list containing the interleaved elements.\n\n    Raises:\n        ValueError: If the input lists do not have the same length.\n    \"\"\"\n    if not (len(list1) == len(list2) == len(list3)):\n        raise ValueError(\"Input lists must have the same length.\")\n\n    interleaved_list = []\n    for i in range(len(list1)):\n        interleaved_list.append(list1[i])\n        interleaved_list.append(list2[i])\n        interleaved_list.append(list3[i])\n\n    return interleaved_list"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar_elements(tuple1, tuple2):\n    \"\"\"\n    Finds the dissimilar elements in two tuples.\n\n    Args:\n        tuple1: The first tuple.\n        tuple2: The second tuple.\n\n    Returns:\n        A tuple containing the dissimilar elements.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n    dissimilar_set = (set1 - set2) | (set2 - set1)\n    return tuple(dissimilar_set)"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    even_elements = []\n    for element in input_tuple:\n        if isinstance(element, int):\n            if element % 2 == 0:\n                even_elements.append(element)\n        elif isinstance(element, tuple):\n            processed_element = extract_even(element)\n            even_elements.append(processed_element)\n    return tuple(even_elements)"}
{"task_id": "Mbpp/581", "solution": "import math\ndef surface_Area(base_edge, height):\n    \"\"\"\n    Calculates the surface area of a square pyramid.\n\n    Args:\n        base_edge: The length of the base edge of the square pyramid.\n        height: The height of the square pyramid.\n\n    Returns:\n        The surface area of the square pyramid.\n    \"\"\"\n    s = math.sqrt((base_edge/2)**2 + height**2)\n    surface_area = base_edge**2 + 2 * base_edge * s\n    return surface_area"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n  \"\"\"\n  Calculates the nth Catalan number.\n\n  Args:\n    n: A non-negative integer.\n\n  Returns:\n    The nth Catalan number.\n  \"\"\"\n  catalan = [0] * (n + 1)\n  catalan[0] = 1\n\n  for i in range(1, n + 1):\n    catalan[i] = 0\n    for j in range(i):\n      catalan[i] += catalan[j] * catalan[i - 1 - j]\n\n  return catalan[n]"}
