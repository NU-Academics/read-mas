{"task_id": "Mbpp/592", "solution": "def sum_of_product(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the product of consecutive binomial coefficients.\n\n    Args:\n        n: A non-negative integer.\n\n    Returns:\n        The sum of the product of consecutive binomial coefficients.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    total_sum = 0\n    for i in range(n):\n        coeff1 = binomial_coefficient(n, i)\n        coeff2 = binomial_coefficient(n, i + 1)\n        total_sum += coeff1 * coeff2\n\n    return total_sum\n\ndef binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"\n    Calculates the binomial coefficient \"n choose k\".\n\n    Args:\n        n: The total number of items.\n        k: The number of items to choose.\n\n    Returns:\n        The binomial coefficient.\n    \"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n\n    result = 1\n    for i in range(k):\n        result = result * (n - i) // (i + 1)\n    return result"}
{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip_address: str) -> str:\n    \"\"\"Removes leading zeros from an IPv4 address.\"\"\"\n    if not isinstance(ip_address, str):\n        raise TypeError(\"IP address must be a string\")\n\n    octets = ip_address.split(\".\")\n    if len(octets) != 4:\n        raise ValueError(\"Invalid IP address format: Must have four octets\")\n\n    processed_octets = []\n    for octet in octets:\n        try:\n            int_octet = int(octet)\n            if int_octet < 0 or int_octet > 255:\n                raise ValueError(\"Invalid octet value: Must be between 0 and 255\")\n            processed_octets.append(str(int_octet))\n        except ValueError:\n            raise ValueError(\"Invalid octet: Not an integer\")\n\n    return \".\".join(processed_octets)"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(list_of_numbers: list[int]) -> int:\n    \"\"\"\n    Calculates the difference between the first even and first odd number in a list.\n\n    Args:\n        list_of_numbers: A list of integers.\n\n    Returns:\n        The difference between the first even and first odd number.\n        Returns 0 if the list is empty or if no even or odd numbers are found.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    if not list_of_numbers:\n        return 0\n\n    for number in list_of_numbers:\n        if number % 2 == 0:\n            first_even = number\n            break  # Stop after finding the first even number\n\n    for number in list_of_numbers:\n        if number % 2 != 0:\n            first_odd = number\n            break  # Stop after finding the first odd number\n\n    if first_even is None or first_odd is None:\n        return 0\n\n    return first_even - first_odd"}
{"task_id": "Mbpp/597", "solution": "def find_kth(arr1: list, arr2: list, k: int) -> int:\n    \"\"\"\n    Finds the k-th smallest element from two sorted arrays.\n\n    Args:\n        arr1: The first sorted array.\n        arr2: The second sorted array.\n        k: The index of the desired element (1-based).\n\n    Returns:\n        The k-th smallest element.\n\n    Raises:\n        ValueError: If the input is invalid (e.g., k is out of range).\n    \"\"\"\n    if not isinstance(arr1, list) or not isinstance(arr2, list):\n        raise TypeError(\"Both arr1 and arr2 must be lists.\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer.\")\n\n    if k <= 0 or k > len(arr1) + len(arr2):\n        raise ValueError(\"k is out of range.\")\n\n    if not arr1:\n        return arr2[k - 1]\n    if not arr2:\n        return arr1[k - 1]\n\n    if k == 1:\n        return min(arr1[0], arr2[0])\n\n    if len(arr1) > len(arr2):\n        arr1, arr2 = arr2, arr1\n\n    i = max(0, k - len(arr2))\n    j = min(k, len(arr1))\n\n    low = i\n    high = j\n\n    while low <= high:\n        i = (low + high) // 2\n        j = k - i\n\n        if i > 0 and j < len(arr2) and arr1[i - 1] > arr2[j]:\n            high = i - 1\n        elif j > 0 and i < len(arr1) and arr2[j - 1] > arr1[i]:\n            low = i + 1\n        else:\n            if i == 0:\n                return arr2[j - 1]\n            elif j == 0:\n                return arr1[i - 1]\n            else:\n                return max(arr1[i - 1], arr2[j - 1])\n\n    return -1  # Should not reach here in normal circumstances"}
{"task_id": "Mbpp/598", "solution": "def is_armstrong_number(number: int) -> bool:\n    \"\"\"\n    Checks if a given number is an Armstrong number.\n\n    Args:\n        number: The number to check.\n\n    Returns:\n        True if the number is an Armstrong number, False otherwise.\n    \"\"\"\n    num_str = str(number)\n    num_digits = len(num_str)\n    sum_of_powers = 0\n\n    for digit in num_str:\n        sum_of_powers += int(digit) ** num_digits\n\n    return sum_of_powers == number"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n: int) -> tuple[int, float]:\n    \"\"\"Calculates the sum and average of the first n natural numbers.\n\n    Args:\n        n: A positive integer.\n\n    Returns:\n        A tuple containing the sum (integer) and average (float).\n\n    Raises:\n        ValueError: If n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input n must be a positive integer.\")\n\n    sum_n = n * (n + 1) // 2\n    average_n = (n + 1) / 2\n\n    return (sum_n, average_n)"}
{"task_id": "Mbpp/602", "solution": "def first_repeated_char(input_string: str) -> str | None:\n    \"\"\"\n    Finds the first repeated character in a given string.\n\n    Args:\n        input_string: The string to search for repeated characters.\n\n    Returns:\n        The first repeated character, or None if no character is repeated.\n\n    Raises:\n        TypeError: If the input is not a string.\n    \"\"\"\n\n    if not isinstance(input_string, str):\n        raise TypeError(\"Input must be a string\")\n\n    if not input_string:\n        return None\n\n    seen_characters = set()\n    for char in input_string:\n        if char in seen_characters:\n            return char\n        seen_characters.add(char)\n\n    return None"}
{"task_id": "Mbpp/603", "solution": "import math\nclass AbundantNumberChecker:\n    def __init__(self):\n        pass\n\n    def is_abundant(self, number):\n        \"\"\"\n        Checks if a number is abundant.\n        A number is abundant if the sum of its proper divisors is greater than the number itself.\n        \"\"\"\n        if number <= 0:\n            return False\n        sum_of_divisors = 1\n        for i in range(2, int(math.sqrt(number)) + 1):\n            if number % i == 0:\n                sum_of_divisors += i\n                if i != number // i:\n                    sum_of_divisors += number // i\n        return sum_of_divisors > number\nclass AbundantNumberCache:\n    def __init__(self):\n        \"\"\"\n        Caches abundant numbers to avoid redundant calculations.\n        \"\"\"\n        self.abundant_numbers = set()\n        self.checker = AbundantNumberChecker()\n\n    def is_abundant(self, number):\n        \"\"\"\n        Checks if a number is abundant. Uses the cache if available, otherwise calculates and caches the result.\n        \"\"\"\n        if number in self.abundant_numbers:\n            return True\n        else:\n            if self.checker.is_abundant(number):\n                self.abundant_numbers.add(number)\n                return True\n            else:\n                return False\nclass LucidNumberFinder:\n    def find_lucid_numbers(self, n):\n        \"\"\"\n        Finds all lucid numbers less than or equal to n.\n        A lucid number is a number that cannot be expressed as the sum of two abundant numbers.\n        \"\"\"\n        lucid_numbers = []\n        cache = AbundantNumberCache()\n        for i in range(1, n + 1):\n            is_lucid = True\n            for j in range(1, i):\n                if cache.is_abundant(j) and cache.is_abundant(i - j):\n                    is_lucid = False\n                    break\n            if is_lucid:\n                lucid_numbers.append(i)\n        return lucid_numbers\ndef get_ludic(n):\n    \"\"\"\n    Wrapper function to get lucid numbers.\n    \"\"\"\n    finder = LucidNumberFinder()\n    return finder.find_lucid_numbers(n)"}
{"task_id": "Mbpp/604", "solution": "def reverse_words(text):\n  \"\"\"\n  Reverses the order of words in a string.\n\n  Args:\n    text: The input string.\n\n  Returns:\n    A string with the words in reversed order.\n  \"\"\"\n  words = text.split()\n  reversed_words = words[::-1] # Efficient reversal using slicing\n  reversed_string = \" \".join(reversed_words)\n  return reversed_string"}
{"task_id": "Mbpp/605", "solution": "def isPrime(n: int) -> bool:\n    \"\"\"\n    Checks if a given integer is a prime number.\n\n    Args:\n        n: The integer to check.\n\n    Returns:\n        True if n is prime, False otherwise.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n > 2 and n % 2 == 0:\n        return False\n\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
