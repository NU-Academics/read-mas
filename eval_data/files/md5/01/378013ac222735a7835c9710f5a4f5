{"task_id": "Mbpp/92", "solution": "def is_undulating(n: int) -> bool:\n    s = str(n)\n    if len(s) <= 1:\n        return True\n\n    distinct_digits = set(s)\n    if len(distinct_digits) > 2:\n        return False\n\n    if len(distinct_digits) <= 1:\n        return True\n\n    digit1 = distinct_digits.pop()\n    digit2 = distinct_digits.pop() if distinct_digits else digit1\n\n\n    for i in range(len(s)):\n        if i % 2 == 0:\n            if s[i] != digit1:\n                return False\n        else:\n            if s[i] != digit2:\n                return False\n\n    return True"}
{"task_id": "Mbpp/93", "solution": "import math\ndef power(a, b):\n    \"\"\"\n    Calculates 'a' raised to the power of 'b' (a**b).\n\n    Args:\n        a: The base (numerical value: integer or float).\n        b: The exponent (numerical value: integer or float).\n\n    Returns:\n        The result of 'a'**b (numerical value: integer or float).\n\n    Raises:\n        ValueError: If a is 0 and b is less than or equal to 0.\n    \"\"\"\n    if a == 0 and b <= 0:\n        raise ValueError(\"0 raised to a non-positive power is undefined\")\n    if b == 0:\n        return 1\n    if isinstance(b, int):\n        if b > 0:\n            result = 1\n            for _ in range(b):\n                result *= a\n            return result\n        else:\n            return 1 / power(a, -b)\n    else:\n        return math.pow(a, b)"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(list_of_tuples: list[tuple]) -> any:\n    \"\"\"Given a list of tuples, return the first value of the tuple with the smallest second value.\n    For example:\n    index_minimum([('Rash', 143), ('Manjeet', 200), ('Varsha', 100)]) == 'Varsha'\"\"\"\n    if not list_of_tuples:\n        return None\n\n    min_tuple = min(list_of_tuples, key=lambda item: item[1])\n    return min_tuple[0]"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists):\n    \"\"\"\n    Finds the length of the shortest list within a list of lists.\n\n    Args:\n        list_of_lists: A list of lists.\n\n    Returns:\n        The length of the shortest list in the input list.\n        Returns 0 if the input list is empty.\n        Raises TypeError if any element within the outer list is not a list.\n    \"\"\"\n    if not list_of_lists:\n        return 0\n\n    min_length = float('inf')\n\n    for lst in list_of_lists:\n        if not isinstance(lst, list):\n            raise TypeError(\"Input must be a list of lists.\")\n        \n        min_length = min(min_length, len(lst))\n\n    return min_length"}
{"task_id": "Mbpp/96", "solution": "def divisor(n):\n    \"\"\"\n    Calculates the number of divisors of a given integer.\n\n    Args:\n        n: An integer.\n\n    Returns:\n        The number of divisors of n.\n    \"\"\"\n    if n <= 0:\n        return 0\n    count = 0\n    for i in range(1, int(n**0.5) + 1):\n        if n % i == 0:\n            if i == n // i:\n                count += 1\n            else:\n                count += 2\n    return count"}
{"task_id": "Mbpp/97", "solution": "def frequency_lists(list_of_lists):\n    \"\"\"\n    Calculates the frequency of each element in a flattened list of lists.\n\n    Args:\n        list_of_lists: A list of lists.\n\n    Returns:\n        A dictionary where keys are the unique elements and values are their frequencies.\n    \"\"\"\n    if list_of_lists is None:\n        raise TypeError(\"Input list cannot be None.\")\n\n    frequency_dict = {}\n    flattened_list = []\n\n    for sublist in list_of_lists:\n        if sublist is None:\n            continue\n        for element in sublist:\n            flattened_list.append(element)\n\n    for element in flattened_list:\n        if element in frequency_dict:\n            frequency_dict[element] += 1\n        else:\n            frequency_dict[element] = 1\n\n    return frequency_dict"}
{"task_id": "Mbpp/98", "solution": "import math\ndef list_product_divider(data):\n    \"\"\"\n    Calculates the product of numbers in a list and divides by the list's length.\n\n    Args:\n        data: A list of numbers (int or float).\n\n    Returns:\n        The product of the numbers divided by the length of the list (float).\n        Returns 0.0 if the list is empty.\n\n    Raises:\n        TypeError: If the list contains non-numeric values.\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input must be a list\")\n    if not data:\n        return 0.0\n\n    product = 1\n    for item in data:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"List must contain only numbers\")\n        product *= item\n\n    return float(product / len(data))\ndef multiply_num(nums):\n    \"\"\"Multiply all numbers in a list and divide by the length of the list.\"\"\"\n    return list_product_divider(nums)"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"\n    Converts a non-negative decimal integer to its binary string representation.\n\n    Args:\n        decimal_number: The decimal integer to convert.\n\n    Returns:\n        The binary string representation of the decimal integer.\n\n    Raises:\n        TypeError: If the input is not an integer.\n        ValueError: If the input is negative.\n    \"\"\"\n    if not isinstance(decimal_number, int):\n        raise TypeError(\"Input must be an integer.\")\n    if decimal_number < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    if decimal_number == 0:\n        return \"0\"\n\n    binary_string = \"\"\n    while decimal_number > 0:\n        remainder = decimal_number % 2\n        binary_string = str(remainder) + binary_string\n        decimal_number //= 2\n\n    return binary_string"}
