{"task_id": "Mbpp/792", "solution": "def count_list(input_list: list) -> int:\n    \"\"\"\n    Counts the number of lists within a given list.\n\n    Args:\n        input_list: A list that may contain other lists and non-list objects.\n\n    Returns:\n        An integer representing the number of lists found directly within the input list.\n    \"\"\"\n    if input_list is None:\n        return 0\n\n    count = 0\n    for element in input_list:\n        if isinstance(element, list):\n            count += 1\n    return count"}
{"task_id": "Mbpp/793", "solution": "def last(arr: list[int], target: int) -> int:\n    \"\"\"\n    Finds the last position of a target element in a sorted array.\n\n    Args:\n        arr: A sorted list of integers.\n        target: The integer to search for.\n\n    Returns:\n        The index of the last occurrence of the target element, or -1 if not found.\n    \"\"\"\n    if not arr:\n        return -1\n\n    low = 0\n    high = len(arr) - 1\n    result = -1\n\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == target:\n            result = mid\n            low = mid + 1  # Search for later occurrences\n        elif arr[mid] < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n\n    return result"}
