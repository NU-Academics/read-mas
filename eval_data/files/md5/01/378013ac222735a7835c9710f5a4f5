{"task_id": "Mbpp/170", "solution": "def sum_range_list(data, start, end):\n    \"\"\"\n    Calculates the sum of numbers within a specified range in a list.\n\n    Args:\n        data: A list of numbers (integers or floats).\n        start: The starting index (inclusive).\n        end: The ending index (inclusive).\n\n    Returns:\n        The sum of the numbers within the specified range.\n        Returns 0 if the list is empty or if start > end.\n    Raises:\n        TypeError: if the input list contains non-numeric types\n    \"\"\"\n    if not data:\n        return 0\n\n    for item in data:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"List elements must be numeric\")\n\n    start = max(0, start)\n    end = min(len(data) - 1, end)\n\n    if start > end:\n        return 0\n\n    total = 0\n    for i in range(start, end + 1):\n        total += data[i]\n\n    return total"}
{"task_id": "Mbpp/171", "solution": "def perimeter_pentagon(side_length):\n    \"\"\"\n    Calculates the perimeter of a regular pentagon given the length of its side.\n\n    Args:\n        side_length: The length of one side of the pentagon.\n\n    Returns:\n        The perimeter of the pentagon.\n\n    Raises:\n        TypeError: If side_length is not a number.\n        ValueError: If side_length is negative.\n    \"\"\"\n    if not isinstance(side_length, (int, float)):\n        raise TypeError(\"Side length must be a number.\")\n    if side_length < 0:\n        raise ValueError(\"Side length cannot be negative.\")\n    perimeter = 5 * side_length\n    return perimeter"}
{"task_id": "Mbpp/172", "solution": "def count_std_occurrences(input_string: str) -> int:\n    \"\"\"\n    Counts the number of non-overlapping occurrences of the substring \"std\" in a given string.\n\n    Args:\n        input_string: The string to search within.\n\n    Returns:\n        The number of non-overlapping occurrences of \"std\".\n    \"\"\"\n    count = 0\n    index = 0\n    while index < len(input_string) - 2:\n        if input_string[index:index+3] == \"std\":\n            count += 1\n            index += 3  # Move past the found \"std\"\n        else:\n            index += 1\n    return count"}
