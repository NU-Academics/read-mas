{"task_id": "Mbpp/223", "solution": "def is_majority(arr: list[int], n: int, element: int) -> bool:\n    \"\"\"\n    Checks if a given element is the majority element in a sorted array.\n\n    Args:\n        arr: A sorted list of integers.\n        n: The length of the array.\n        element: The integer to check for majority status.\n\n    Returns:\n        True: If the element is the majority element in arr.\n        False: Otherwise.\n    \"\"\"\n\n    if n == 0:\n        return False\n\n    def binary_search_first(arr: list[int], target: int) -> int:\n        \"\"\"\n        Finds the index of the first occurrence of the target element in the sorted array.\n        Returns -1 if the element is not found.\n        \"\"\"\n        low = 0\n        high = len(arr) - 1\n        result = -1\n\n        while low <= high:\n            mid = (low + high) // 2\n            if arr[mid] == target:\n                result = mid\n                high = mid - 1  # Continue searching on the left side\n            elif arr[mid] < target:\n                low = mid + 1\n            else:\n                high = mid - 1\n        return result\n\n    first_occurrence = binary_search_first(arr, element)\n\n    if first_occurrence == -1:\n        return False\n\n    return (first_occurrence + n // 2 < n) and (arr[first_occurrence + n // 2] == element)"}
{"task_id": "Mbpp/224", "solution": "def count_set_bits(n):\n    \"\"\"\n    Counts the number of set bits (1s) in the binary representation of a non-negative integer.\n\n    Args:\n        n (int): A non-negative integer.\n\n    Returns:\n        int: The number of set bits in the binary representation of n.\n    \"\"\"\n    count = 0\n    while (n > 0):\n        n &= (n - 1) # Clear the least significant set bit\n        count += 1\n    return count"}
