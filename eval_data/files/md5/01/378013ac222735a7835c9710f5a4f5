{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of all odd-length subarrays of a given array.\n\n    Args:\n        arr: A list of integers.\n\n    Returns:\n        An integer representing the sum of all odd-length subarrays.\n    \"\"\"\n    total_sum = 0\n    for i in range(len(arr)):\n        for j in range(i, len(arr)):\n            length = j - i + 1\n            if length % 2 != 0:\n                total_sum += sum(arr[i:j+1])\n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(lst):\n    \"\"\"\n    Finds the product of the first even and first odd numbers in a list.\n\n    Args:\n        lst: A list of numbers (integers or floats).\n\n    Returns:\n        The product of the first even and first odd numbers in the list,\n        or None if either an even or an odd number is not found, or the list is empty.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    if not lst:\n        return None\n\n    for num in lst:\n        if isinstance(num, (int, float)) :\n            if first_even is None and num % 2 == 0:\n                first_even = num\n            if first_odd is None and num % 2 != 0:\n                first_odd = num\n\n            if first_even is not None and first_odd is not None:\n                break\n\n    if first_even is None or first_odd is None:\n        return None\n    else:\n        return first_even * first_odd"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(tuple_string):\n    \"\"\"\n    Converts a string representation of a tuple of integers into an actual tuple of integers.\n\n    Args:\n        tuple_string (str): The string representation of the tuple.\n\n    Returns:\n        tuple of int: The converted tuple of integers. Returns an empty tuple if the input is invalid.\n    \"\"\"\n    if tuple_string is None or not tuple_string:\n        return ()\n\n    tuple_string = tuple_string.strip()\n\n    if not (tuple_string.startswith('(') and tuple_string.endswith(')')):\n        return ()\n\n    tuple_string = tuple_string[1:-1].strip()\n\n    if not tuple_string:\n        return ()\n\n    integer_strings = tuple_string.split(',')\n    integer_list = []\n\n    for s in integer_strings:\n        s = s.strip()\n        try:\n            integer_list.append(int(s))\n        except ValueError:\n            return ()\n\n    return tuple(integer_list)"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(sorted_list: list[float], value: float) -> int:\n    low = 0\n    high = len(sorted_list)\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] > value:\n            high = mid\n        else:\n            low = mid + 1\n    return low"}
