{"task_id": "Mbpp/101", "solution": "def kth_element(arr: list[float], k: int) -> float:\n    \"\"\"\n    Finds the kth smallest element in the given array (1-based indexing).\n\n    Args:\n        arr: A list of numerical values.\n        k: The index of the desired element (1-based).\n\n    Returns:\n        The kth smallest element in the array.\n\n    Raises:\n        ValueError: If k is not a positive integer or is out of range.\n    \"\"\"\n    if not isinstance(k, int) or k <= 0:\n        raise ValueError(\"k must be a positive integer.\")\n\n    n = len(arr)\n    if k > n:\n        raise ValueError(\"k is out of range.\")\n\n    sorted_arr = sorted(arr)\n    return sorted_arr[k - 1]"}
{"task_id": "Mbpp/102", "solution": "import re\ndef snake_to_camel(snake_case_string):\n    \"\"\"Converts a snake case string to a camel case string.\n\n    Args:\n        snake_case_string: The input string in snake case format.\n\n    Returns:\n        The converted string in camel case format.\n    \"\"\"\n    if not snake_case_string:\n        return \"\"\n\n    words = re.split(r'_+', snake_case_string)\n    camel_case_string = \"\".join(word.capitalize() for word in words)\n    return camel_case_string"}
{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number a(n, m).\n\n    Args:\n        n: The number of elements in the permutation (non-negative integer).\n        m: The number of ascents (elements greater than the previous one) (non-negative integer).\n\n    Returns:\n        The Eulerian number a(n, m).\n\n    Raises:\n        ValueError: If n or m is negative.\n\n    Examples:\n        eulerian_num(3, 1) == 4\n        eulerian_num(0, 0) == 1\n        eulerian_num(5, 2) == 50\n    \"\"\"\n    if n < 0 or m < 0:\n        raise ValueError(\"n and m must be non-negative integers.\")\n\n    if m > n -1:\n        return 0\n\n    if n == 0 and m == 0:\n        return 1\n\n    dp = [[0] * (m + 1) for _ in range(n + 1)]\n    dp[0][0] = 1\n\n    for i in range(1, n + 1):\n        for j in range(m + 1):\n            dp[i][j] = (j + 1) * dp[i - 1][j] + (i - j) * dp[i - 1][j - 1]\n\n    return dp[n][m]"}
{"task_id": "Mbpp/104", "solution": "def sort_sublists(list_of_lists):\n    \"\"\"\n    Sorts each sublist of strings in a given list of lists alphabetically (case-insensitive).\n\n    Args:\n        list_of_lists: A list of lists of strings.\n\n    Returns:\n        A new list of lists with each sublist sorted.\n    \"\"\"\n    sorted_list_of_lists = []\n    for sublist in list_of_lists:\n        sorted_sublist = sorted(sublist, key=lambda s: s.lower())  # Sort case-insensitive\n        sorted_list_of_lists.append(sorted_sublist)\n    return sorted_list_of_lists"}
