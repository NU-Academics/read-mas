{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number.\n\n    Args:\n        n: A non-negative integer.\n\n    Returns:\n        The nth Bell number.\n    \"\"\"\n    triangle = [[0 for _ in range(n + 1)] for _ in range(n + 1)]\n    triangle[0][0] = 1\n    for i in range(1, n + 1):\n        triangle[i][0] = triangle[i - 1][i - 1]\n        for j in range(1, i + 1):\n            triangle[i][j] = triangle[i - 1][j - 1] + triangle[i][j - 1]\n    return triangle[n][0]"}
{"task_id": "Mbpp/68", "solution": "def is_monotonic(array: list[float or int]) -> bool:\n    \"\"\"\n    Checks if an array is monotonic (either monotonically increasing or decreasing).\n\n    Args:\n        array: A list of numbers (integers or floats).\n\n    Returns:\n        True if the array is monotonic, False otherwise.\n    \"\"\"\n    if len(array) <= 1:\n        return True\n\n    increasing = True\n    decreasing = True\n\n    for i in range(1, len(array)):\n        if array[i] < array[i - 1]:\n            increasing = False\n        if array[i] > array[i - 1]:\n            decreasing = False\n\n    return increasing or decreasing"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(list1, list2):\n    \"\"\"\n    Checks if list2 is a sublist of list1.\n\n    Args:\n        list1: The main list.\n        list2: The potential sublist.\n\n    Returns:\n        True if list2 is a sublist of list1, False otherwise.\n    \"\"\"\n\n    if not list2:\n        return True\n    if not list1 and list2:\n        return False\n\n    for i in range(len(list1) - len(list2) + 1):\n        if list1[i:i+len(list2)] == list2:\n            return True\n\n    return False"}
{"task_id": "Mbpp/70", "solution": "def get_equal(tuples_collection: list[tuple] | tuple[tuple, ...]) -> bool:\n    \"\"\"\n    Checks if all tuples in a collection have the same length.\n\n    Args:\n        tuples_collection: A list or tuple of tuples.\n\n    Returns:\n        True if all tuples have the same length, False otherwise. Returns True if the collection is empty.\n\n    Raises:\n        TypeError: If the input is not a list or tuple, or if any element is not a tuple.\n    \"\"\"\n    if not isinstance(tuples_collection, (list, tuple)):\n        raise TypeError(\"Input must be a list or tuple.\")\n\n    if not tuples_collection:\n        return True\n\n    first_tuple_len = len(tuples_collection[0])\n    for tpl in tuples_collection:\n        if not isinstance(tpl, tuple):\n            raise TypeError(\"All elements in the collection must be tuples.\")\n        if len(tpl) != first_tuple_len:\n            return False\n\n    return True"}
{"task_id": "Mbpp/71", "solution": "def sortList(input_list):\n    \"\"\"\n    Sorts a list of elements in ascending order using the Merge Sort algorithm.\n\n    Args:\n        input_list: A list of integers, floats, or strings.\n\n    Returns:\n        A new list containing the same elements as input_list, but sorted in ascending order.\n        Returns an empty list if the input list is empty.\n        Raises a TypeError if the input list contains elements of incomparable types.\n    \"\"\"\n\n    if not input_list:\n        return []\n\n    # Check if all elements are of the same comparable type\n    first_type = type(input_list[0])\n    for element in input_list:\n        if type(element) != first_type:\n            try:\n                # Attempt comparison to see if sorting is possible.  Avoid TypeError.\n                input_list[0] < element # Try comparison\n            except TypeError:\n                raise TypeError(\"List contains elements of incomparable types.\")\n\n    def merge_sort(list_to_sort):\n        if len(list_to_sort) <= 1:\n            return list_to_sort\n\n        mid = len(list_to_sort) // 2\n        left_half = list_to_sort[:mid]\n        right_half = list_to_sort[mid:]\n\n        left_half = merge_sort(left_half)\n        right_half = merge_sort(right_half)\n\n        return merge(left_half, right_half)\n\n    def merge(left, right):\n        merged = []\n        left_index = 0\n        right_index = 0\n\n        while left_index < len(left) and right_index < len(right):\n            if left[left_index] <= right[right_index]:\n                merged.append(left[left_index])\n                left_index += 1\n            else:\n                merged.append(right[right_index])\n                right_index += 1\n\n        merged.extend(left[left_index:])\n        merged.extend(right[right_index:])\n        return merged\n\n    return merge_sort(input_list.copy())"}
{"task_id": "Mbpp/72", "solution": "def is_difference_of_squares(n: int) -> bool:\n    \"\"\"\n    Checks if a given number can be expressed as the difference of two squares.\n\n    Args:\n        n: An integer.\n\n    Returns:\n        True if n can be expressed as a^2 - b^2 for some integers a and b, False otherwise.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    return n % 2 != 0 or n % 4 == 0"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(arr1, arr2):\n    \"\"\"\n    Determines if two arrays follow the same pattern.\n\n    Args:\n        arr1: The first array (list).\n        arr2: The second array (list).\n\n    Returns:\n        True: If the arrays follow the same pattern.\n        False: Otherwise.\n    \"\"\"\n\n    if len(arr1) != len(arr2):\n        return False\n\n    pattern_map = {}\n\n    for i in range(len(arr1)):\n        if arr1[i] in pattern_map:\n            if pattern_map[arr1[i]] != arr2[i]:\n                return False\n        else:\n            if arr2[i] in pattern_map.values():\n                return False\n            pattern_map[arr1[i]] = arr2[i]\n\n    return True"}
{"task_id": "Mbpp/75", "solution": "def find_tuples(list_of_tuples, k):\n    \"\"\"\n    Finds tuples where all elements are divisible by k.\n\n    Args:\n        list_of_tuples: A list of tuples containing integers.\n        k: An integer divisor.\n\n    Returns:\n        A list of tuples where all elements are divisible by k.\n\n    Raises:\n        ValueError: If k is zero.\n        TypeError: if elements of tuples are not integers\n    \"\"\"\n    if k == 0:\n        raise ValueError(\"Divisor 'k' cannot be zero.\")\n\n    result = []\n    for tup in list_of_tuples:\n        is_divisible = True\n        for element in tup:\n            if not isinstance(element, int):\n                raise TypeError(\"Tuple elements must be integers.\")\n            if element % k != 0:\n                is_divisible = False\n                break\n        if is_divisible:\n            result.append(tup)\n    return result"}
{"task_id": "Mbpp/77", "solution": "def is_divisible_by_11(n):\n    \"\"\"\n    Checks if a number is divisible by 11.\n\n    Args:\n        n: An integer.\n\n    Returns:\n        True if n is divisible by 11, False otherwise.\n    \"\"\"\n    n = abs(n) # Handle negative numbers\n    if n == 0:\n        return True\n\n    num_str = str(n)\n    digits = [int(d) for d in num_str]\n\n    sum_odd = 0\n    sum_even = 0\n\n    for i, digit in enumerate(digits):\n        if i % 2 == 0:\n            sum_even += digit\n        else:\n            sum_odd += digit\n\n    difference = abs(sum_odd - sum_even)\n    return difference % 11 == 0"}
