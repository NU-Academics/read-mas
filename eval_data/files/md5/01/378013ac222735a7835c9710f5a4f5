{"task_id": "Mbpp/395", "solution": "def first_non_repeated_character(text):\n    \"\"\"\n    Finds the first non-repeated character in a given string.\n\n    Args:\n        text (str): The input string.\n\n    Returns:\n        str: The first non-repeated character in the string, or None if all characters are repeated.\n    \"\"\"\n\n    char_counts = {}  # Dictionary to store character counts\n    \n    # Count the occurrences of each character\n    for char in text:\n        char_counts[char] = char_counts.get(char, 0) + 1\n\n    # Find the first character with a count of 1\n    for char in text:\n        if char_counts[char] == 1:\n            return char\n\n    return None  # If all characters are repeated"}
{"task_id": "Mbpp/397", "solution": "def median_numbers(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Calculates the median of three numbers.\n\n    Args:\n        a: The first number.\n        b: The second number.\n        c: The third number.\n\n    Returns:\n        The median of the three numbers as a float.\n    \"\"\"\n    if a > b:\n        a, b = b, a\n    if b > c:\n        b, c = c, b\n    if a > b:\n        a, b = b, a\n    return float(b)"}
{"task_id": "Mbpp/398", "solution": "def sum_of_digits(numbers: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of the digits of each number in a list of integers.\n\n    Args:\n        numbers: A list of integers.\n\n    Returns:\n        The sum of all digits in the list.\n\n    Raises:\n        TypeError: If the input is not a list or if any element in the list is not an integer.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    total_sum = 0\n    for number in numbers:\n        if not isinstance(number, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n\n        number = abs(number) # handle negative numbers\n        for digit in str(number):\n            total_sum += int(digit)\n\n    return total_sum"}
