{"task_id": "Mbpp/292", "solution": "import math\ndef floor_division(numerator: float, denominator: float) -> int:\n    \"\"\"\n    Calculates the floor division of two numbers (numerator // denominator).\n\n    Args:\n        numerator: The number to be divided.\n        denominator: The number to divide by.\n\n    Returns:\n        The quotient of the two numbers, rounded down to the nearest integer.\n\n    Raises:\n        TypeError: If either numerator or denominator is not a number (int or float).\n        ZeroDivisionError: If denominator is zero.\n    \"\"\"\n    if not isinstance(numerator, (int, float)) or not isinstance(denominator, (int, float)):\n        raise TypeError(\"Both numerator and denominator must be numbers (int or float).\")\n\n    if denominator == 0:\n        raise ZeroDivisionError(\"Cannot divide by zero.\")\n\n    result = numerator / denominator\n    return math.floor(result)\ndef find(numerator, denominator):\n    return floor_division(numerator, denominator)"}
{"task_id": "Mbpp/293", "solution": "import math\ndef otherside_rightangle(side1: float, side2: float) -> float:\n    \"\"\"\n    Calculates the length of the third side of a right-angled triangle,\n    given the lengths of the other two sides.\n\n    Args:\n        side1: A float or integer representing the length of one side.\n        side2: A float or integer representing the length of another side.\n\n    Returns:\n        A float representing the length of the third side.\n\n    Raises:\n        ValueError: If either side1 or side2 is not a positive number,\n                    or if the inputs do not form a valid right-angled triangle\n                    (e.g., hypotenuse is not longer than the leg).\n    \"\"\"\n    if not isinstance(side1, (int, float)) or not isinstance(side2, (int, float)):\n        raise ValueError(\"Sides must be numbers (int or float).\")\n\n    if side1 <= 0 or side2 <= 0:\n        raise ValueError(\"Sides must be positive numbers.\")\n\n    if side1 > side2:\n        hypotenuse = side1\n        leg = side2\n        side3 = math.sqrt(hypotenuse**2 - leg**2)\n    elif side2 > side1:\n        hypotenuse = side2\n        leg = side1\n        side3 = math.sqrt(hypotenuse**2 - leg**2)\n    else:\n        # Assume they are legs if equal\n        side3 = math.sqrt(side1**2 + side2**2)\n\n    if isinstance(side3, complex) or side3 <= 0:\n        raise ValueError(\"Invalid triangle: Hypotenuse must be greater than leg.\")\n\n    return float(side3)"}
{"task_id": "Mbpp/296", "solution": "def count_inversions(arr: list[int]) -> int:\n    \"\"\"\n    Counts the number of inversions in an array of integers.\n\n    Args:\n        arr: A list of integers.\n\n    Returns:\n        The number of inversions in the array.\n\n    Raises:\n        TypeError: If the input is not a list or if the list contains non-integer elements.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list.\")\n\n    for element in arr:\n        if not isinstance(element, int):\n            raise TypeError(\"List elements must be integers.\")\n\n    return merge_sort_and_count(arr, 0, len(arr) - 1)\n\n\ndef merge_sort_and_count(arr: list[int], start: int, end: int) -> int:\n    \"\"\"\n    Recursively sorts an array and counts inversions using merge sort.\n\n    Args:\n        arr: The list of integers to sort.\n        start: The starting index of the sub-array.\n        end: The ending index of the sub-array.\n\n    Returns:\n        The number of inversions in the sub-array.\n    \"\"\"\n    if start >= end:\n        return 0\n\n    mid = (start + end) // 2\n    inversions = 0\n    inversions += merge_sort_and_count(arr, start, mid)\n    inversions += merge_sort_and_count(arr, mid + 1, end)\n    inversions += merge_and_count(arr, start, mid, end)\n    return inversions\n\n\ndef merge_and_count(arr: list[int], start: int, mid: int, end: int) -> int:\n    \"\"\"\n    Merges two sorted sub-arrays and counts inversions.\n\n    Args:\n        arr: The list of integers.\n        start: The starting index of the left sub-array.\n        mid: The ending index of the left sub-array.\n        end: The ending index of the right sub-array.\n\n    Returns:\n        The number of inversions found during the merge process.\n    \"\"\"\n    left = arr[start:mid + 1]\n    right = arr[mid + 1:end + 1]\n\n    i = 0\n    j = 0\n    k = start\n    inversions = 0\n\n    while i < len(left) and j < len(right):\n        if left[i] <= right[j]:\n            arr[k] = left[i]\n            i += 1\n        else:\n            arr[k] = right[j]\n            j += 1\n            inversions += len(left) - i\n        k += 1\n\n    while i < len(left):\n        arr[k] = left[i]\n        i += 1\n        k += 1\n\n    while j < len(right):\n        arr[k] = right[j]\n        j += 1\n        k += 1\n\n    return inversions"}
