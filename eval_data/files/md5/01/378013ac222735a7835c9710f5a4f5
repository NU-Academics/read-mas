{"task_id": "Mbpp/409", "solution": "def min_product_tuple(list_of_tuples: list[tuple[float, float]]) -> float | None:\n    \"\"\"\n    Finds the minimum product from pairs of tuples within a given list.\n\n    Args:\n        list_of_tuples: A list of tuples, where each tuple contains two numerical values.\n\n    Returns:\n        The minimum product found across all tuples in the list.\n        Returns None if the input list is empty.\n\n    Raises:\n        TypeError: If the input is not a list, if an element in the list is not a tuple,\n                   or if an element in a tuple is not a numerical value.\n        ValueError: If a tuple does not contain exactly two elements.\n    \"\"\"\n    if not isinstance(list_of_tuples, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not list_of_tuples:\n        return None\n\n    minimum_product = float('inf')\n\n    for tup in list_of_tuples:\n        if not isinstance(tup, tuple):\n            raise TypeError(\"Each element in the list must be a tuple.\")\n\n        if len(tup) != 2:\n            raise ValueError(\"Each tuple must contain exactly two elements.\")\n\n        if not all(isinstance(x, (int, float)) for x in tup):\\\n            raise TypeError(\"Each element in the tuple must be a number (int or float).\")\n\n        product = tup[0] * tup[1]\n        minimum_product = min(minimum_product, product)\n\n    return minimum_product"}
{"task_id": "Mbpp/410", "solution": "def min_val(data):\n    \"\"\"\n    Finds the minimum numerical value in a heterogeneous list.\n\n    Args:\n        data: A list containing elements of various data types.\n\n    Returns:\n        The minimum numerical value in the list, or None if the list is\n        empty or contains no numerical values.\n    \"\"\"\n    min_number = None\n    for item in data:\n        if isinstance(item, (int, float)):\n            if min_number is None:\n                min_number = item\n            elif item < min_number:\n                min_number = item\n    return min_number"}
{"task_id": "Mbpp/412", "solution": "def remove_odd(input_list: list[int]) -> list[int]:\n    \"\"\"\n    Removes odd numbers from a list and returns a new list with only even numbers.\n\n    Args:\n        input_list: A list of integers.\n\n    Returns:\n        A new list containing only the even integers from the input list,\n        preserving their original order.  Returns an empty list if the input\n        list is empty or contains no even numbers.\n\n    Raises:\n        TypeError: If the input is not a list.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    even_numbers = []\n    for number in input_list:\n        if number % 2 == 0:\n            even_numbers.append(number)\n    return even_numbers"}
{"task_id": "Mbpp/413", "solution": "def extract_nth_element(list_of_tuples: list[tuple], n: int) -> list:\n    \"\"\"\n    Extracts the nth element from a list of tuples.\n\n    Args:\n        list_of_tuples: A list of tuples.\n        n: The index of the element to extract.\n\n    Returns:\n        A list containing the nth element from each tuple in the input list.\n\n    Raises:\n        TypeError: If input is not a list of tuples or n is not an integer.\n        IndexError: If n is out of bounds.\n    \"\"\"\n\n    if not isinstance(list_of_tuples, list):\n        raise TypeError(\"Input must be a list\")\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n\n    if not list_of_tuples:\n        return []\n\n    tuple_length = None\n    for tpl in list_of_tuples:\n        if not isinstance(tpl, tuple):\n            raise TypeError(\"Each element in the list must be a tuple\")\n        if tuple_length is None:\n            tuple_length = len(tpl)\n        elif len(tpl) != tuple_length:\n            raise ValueError(\"All tuples must have the same length\")\n\n    if tuple_length is None:\n        return [] #Handles the case where the input list is empty\n\n    if not (0 <= n < tuple_length):\\\n        raise IndexError(\"n is out of bounds\")\n\n    result = []\n    for tpl in list_of_tuples:\n        result.append(tpl[n])\n    return result"}
