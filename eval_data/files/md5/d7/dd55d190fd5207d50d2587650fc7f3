{"task_id": "Mbpp/556", "solution": "\"\"\"\nWrite a python function to count the number of pairs whose xor value is odd.\nassert find_Odd_Pair([5,4,7,2,1],5) == 6\n\"\"\"\ndef find_Odd_Pair(arr, n):\n    \"\"\"Count pairs whose XOR is odd by counting even and odd numbers.\"\"\"\n    even_count = sum(1 for x in arr if x % 2 == 0)\n    odd_count = n - even_count\n    return even_count * odd_count"}
{"task_id": "Mbpp/558", "solution": "\"\"\"\nWrite a python function to find the sum of the per-digit difference between two integers.\nassert digit_distance_nums(1,2) == 1\n\"\"\"\ndef digit_distance_nums(num1, num2):\n    # Convert numbers to strings and pad with zeros to make them equal length\n    str1, str2 = str(abs(num1)), str(abs(num2))\n    max_len = max(len(str1), len(str2))\n    str1, str2 = str1.zfill(max_len), str2.zfill(max_len)\n    \n    return sum(abs(int(d1) - int(d2)) for d1, d2 in zip(str1, str2))"}
{"task_id": "Mbpp/556", "solution": "\"\"\"\nWrite a python function to count the number of pairs whose xor value is odd.\nassert find_Odd_Pair([5,4,7,2,1],5) == 6\n\"\"\"\ndef find_Odd_Pair(arr, n):\n    \"\"\"Count pairs whose XOR value is odd.\"\"\"\n    even_count = sum(1 for x in arr if x % 2 == 0)\n    odd_count = n - even_count\n    return even_count * odd_count"}
{"task_id": "Mbpp/558", "solution": "\"\"\"\nWrite a python function to find the sum of the per-digit difference between two integers.\nassert digit_distance_nums(1,2) == 1\n\"\"\"\ndef digit_distance_nums(num1, num2):\n    \"\"\"Calculate sum of per-digit differences between two integers.\"\"\"\n    str1, str2 = str(abs(num1)), str(abs(num2))\n    max_len = max(len(str1), len(str2))\n    str1, str2 = str1.zfill(max_len), str2.zfill(max_len)\n    return sum(abs(int(d1) - int(d2)) for d1, d2 in zip(str1, str2))"}
