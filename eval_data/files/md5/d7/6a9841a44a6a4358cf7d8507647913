nsidered even.\n    # The `product == int(product)` check handles this effectively.\n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/808": [{"task_id": "Mbpp/808", "solution": "def check_K(input_tuple: tuple, k: any) -> bool:\n    \"\"\"\n    Checks if the given value k is present in the input tuple.\n    It performs a linear search through the tuple elements.\n    \"\"\"\n    return k in input_tuple", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/806": [{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Find maximum run of consecutive uppercase characters in string.\n    Tracks current and maximum run lengths during a single pass.\n    \"\"\"\n    current_run = 0\n    max_run = 0\n\n    for char in input_string:\n        if char.isupper():\n            current_run += 1\n            if current_run > max_run:\n                max_run = current_run\n        else:\n            current_run = 0\n            \n    return max_run", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["Aaa"]]}], "Mbpp/809": [{"task_id": "Mbpp/809", "solution": "def check_smaller(tuple1, tuple2):\n    \"\"\"\n    Checks if each element of the second tuple is smaller than its corresponding\n    element in the first tuple.\n    \"\"\"\n    for i in range(len(tuple1)):\n        if tuple2[i] >= tuple1[i]:\n            return False\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/805": [{"task_id": "Mbpp/805", "solution": "def max_sum_list(lists):\n    \"\"\"\n    Returns the list with the highest sum of elements.\n\n    Args:\n        lists: A list of lists containing numeric elements.\n\n    Returns:\n        The inner list with the maximum sum of elements.\n    \"\"\"\n    max_sum = float('-inf')\n    max_list = None\n\n    for inner_list in lists:\n        current_sum = sum(inner_list)\n        if current_sum > max_sum:\n            max_sum = current_sum\n            max_list = inner_list\n\n    return max_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/797": [{"task_id": "Mbpp/797", "solution": "def sum_in_range(l, r):\n    \"\"\"\n    Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n    Natural numbers are positive integers (1, 2, 3, ...).\n    \"\"\"\n    total_sum = 0\n    for num in range(l, r + 1):\n        # Check if the number is a natural number (>= 1) and is odd.\n        if num >= 1 and num % 2 != 0:\n            total_sum += num\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/592": [{"task_id": "Mbpp/592", "solution": "def binomial_coefficient(n, k):\n    \"\"\"\n    Calculates the binomial coefficient C(n, k).\n    C(n, k) is the number of ways to choose k items from a set of n items.\n    \"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n\n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\ndef sum_Of_product(n):\n    \"\"\"\n    Finds the sum of the product of consecutive binomial coefficients C(n, k) * C(n, k+1) for k from 0 to n-1.\n    \"\"\"\n    total_sum = 0\n    for k in range(n):\n        total_sum += binomial_coefficient(n, k) * binomial_coefficient(n, k + 1)\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/271": [{"task_id": "Mbpp/271", "solution": "def even_Power_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the first n even natural numbers, each raised to the fifth power.\n    \"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        even_number = 2 * i\n        total_sum += even_number ** 5\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/721": [{"task_id": "Mbpp/721", "solution": "import math\nclass Cell:\n    \"\"\"Represents a cell in the matrix with its position and cost.\"\"\"\n    def __init__(self, row: int, column: int, cost: float):\n        self.row = row\n        self.column = column\n        self.cost = cost\n\n    def get_position(self) -> tuple[int, int]:\n        \"\"\"Returns the (row, column) position of the cell.\"\"\"\n        return (self.row, self.column)\n\n    def get_cost(self) -> float:\n        \"\"\"Returns the cost of the cell.\"\"\"\n        return self.cost\nclass Path:\n    \"\"\"Represents a path as a sequence of cells.\"\"\"\n    def __init__(self):\n        self._cells: list[Cell] = []\n        self._total_cost: float = 0.0\n\n    def add_cell(self, cell: Cell) -> None:\n        \"\"\"Adds a cell to the path and updates the total cost.\"\"\"\n        self._cells.append(cell)\n        self._total_cost += cell.get_cost()\n\n    def remove_last_cell(self) -> None:\n        \"\"\"Removes the last cell added to the path and updates total cost.\"\"\"\n        if self._cells:\n            last_cell = self._cells.pop()\n            self._total_cost -= last_cell.get_cost()\n\n    def calculate_average(self) -> float:\n        \"\"\"Calculates the average cost of the path.\"\"\"\n        if not self._cells:\n            return 0.0\n        return self._total_cost / len(self._cells)\n\n    def get_cells(self) -> list[Cell]:\n        \"\"\"Returns the list of cells in the path.\"\"\"\n        return list(self._cells)\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the path is not empty.\"\"\"\n        return len(self._cells) > 0\n\n    def __len__(self) -> int:\n        return len(self._cells)\nclass Matrix:\n    \"\"\"Represents the square matrix and provides access to cell costs.\"\"\"\n    def __init__(self, matrix_data: list[list[float]]):\n        self._size = len(matrix_data)\n        self._cells = matrix_data\n\n    def get_size(self) -> int:\n        \"\"\"Returns the size N of the N*N matrix.\"\"\"\n        return self._size\n\n    def get_cell_cost(self, row: int, col: int) -> float:\n        \"\"\"Returns the cost of the cell at a given (row, column).\"\"\"\n        return self._cells[row][col]\n\n    def is_valid_position(self, row: int, col: int) -> bool:\n        \"\"\"Checks if the given (row, column) is within matrix bounds.\"\"\"\n        return 0 <= row < self._size and 0 <= col < self._size\nclass PathFinder:\n    \"\"\"Generates all valid paths and identifies the maximum average path.\"\"\"\n    def __init__(self, matrix: Matrix):\n        self._matrix = matrix\n        self._all_paths: list[Path] = []\n\n    def _generate_paths_recursive(self, row: int, col: int, current_path: Path) -> None:\n        \"\"\"\n        Recursively generates all paths from (row, col) to the bottom-right cell.\n        Adds paths to _all_paths upon reaching the destination.\n        \"\"\"\n        cell_cost = self._matrix.get_cell_cost(row, col)\n        current_cell = Cell(row, col, cell_cost)\n        current_path.add_cell(current_cell)\n\n        if row == self._matrix.get_size() - 1 and col == self._matrix.get_size() - 1:\n            # Reached bottom-right cell, path is complete\n            self._all_paths.append(PathCalculator.copy_path(current_path))\n        else:\n            # Move right\n            if self._matrix.is_valid_position(row, col + 1):\n                self._generate_paths_recursive(row, col + 1, current_path)\n            # Move down\n            if self._matrix.is_valid_position(row + 1, col):\n                self._generate_paths_recursive(row + 1, col, current_path)\n\n        # Backtrack: remove the current cell for other path explorations\n        current_path.remove_last_cell()\n\n    def find_all_paths(self) -> list[Path]:\n        \"\"\"Initiates recursive path generation from the top-left cell.\"\"\"\n        self._all_paths = [] # Reset for new search\n        starting_path = Path()\n        self._generate_paths_recursive(0, 0, starting_path)\n        return self._all_paths\n\n    def calculate_max_average(self) -> float:\n        \"\"\"Calculates the maximum average cost among all paths.\"\"\"\n        all_paths = self.find_all_paths()\n        \n        max_avg = -math.inf\n        for path in all_paths:\n            current_avg = PathCalculator.calculate_path_average(path)\n            if current_avg > max_avg:\n                max_avg = current_avg\n        return max_avg\nclass PathCalculator:\n    \"\"\"Provides utility methods for path calculations.\"\"\"\n    @staticmethod\n    def calculate_path_average(path: Path) -> float:\n        \"\"\"Calculates the average cost of a given path.\"\"\"\n        return path.calculate_average()\n\n    @staticmethod\n    def calculate_total_cost(path: Path) -> float:\n        \"\"\"Calculates the total cost of a given path.\"\"\"\n        return path._total_cost\n\n    @staticmethod\n    def copy_path(original_path: Path) -> Path:\n        \"\"\"Creates a deep copy of a Path object.\"\"\"\n        new_path = Path()\n        for cell in original_path.get_cells():\n            new_path.add_cell(Cell(cell.row, cell.column, cell.cost))\n        return new_path\nclass MatrixValidator:\n    \"\"\"Validates the input matrix structure and values.\"\"\"\n    @staticmethod\n    def validate_matrix(matrix_data: list[list[float]]) -> bool:\n        \"\"\"Validates if the input is a square matrix with numeric values and valid size.\"\"\"\n        if not MatrixValidator.is_square(matrix_data):\n            return False\n        if not MatrixValidator.has_numeric_values(matrix_data):\n            return False\n        if not MatrixValidator.is_valid_size(matrix_data):\n            return False\n        return True\n\n    @staticmethod\n    def is_square(matrix_data: list[list[float]]) -> bool:\n        \"\"\"Checks if the matrix is square.\"\"\"\n        if not matrix_data:\n            return False\n        n = len(matrix_data)\n        for row in matrix_data:\n            if len(row) != n:\n                return False\n        return True\n\n    @staticmethod\n    def has_numeric_values(matrix_data: list[list[float]]) -> bool:\n        \"\"\"Checks if all values in the matrix are numeric.\"\"\"\n        for row in matrix_data:\n            for val in row:\n                if not isinstance(val, (int, float)):\n                    return False\n        return True\n\n    @staticmethod\n    def is_valid_size(matrix_data: list[list[float]]) -> bool:\n        \"\"\"Checks if the matrix size N is at least 1.\"\"\"\n        return len(matrix_data) >= 1\ndef maxAverageOfPath(matrix: list[list[float]]) -> float:\n    \"\"\"\n    Finds a path from the top-left to the bottom-right cell with the maximum average cost.\n    Movement is restricted to only right or down.\n    \"\"\"\n    # The design context assumes validation, so we instantiate and proceed.\n    # No explicit error handling for invalid input as per problem constraints.\n    _ = MatrixValidator.validate_matrix(matrix)\n\n    matrix_obj = Matrix(matrix)\n    path_finder = PathFinder(matrix_obj)\n    \n    return path_finder.calculate_max_average()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/255": [{"task_id": "Mbpp/255", "solution": "from itertools import combinations_with_replacement\nfrom typing import List, Tuple, Any\ndef combinations_colors(input_list: List[Any], n: int) -> List[Tuple[Any, ...]]:\n    \"\"\"\n    Generate all combinations with repetition of specified length.\n\n    Returns a list of tuples, where each tuple is a combination.\n    \"\"\"\n    return list(combinations_with_replacement(input_list, n))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]}}