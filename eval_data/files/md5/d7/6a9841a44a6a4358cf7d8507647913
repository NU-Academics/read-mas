irst increasing and then decreasing.\n    \"\"\"\n    n = len(array)\n    if n == 0:\n        return 0\n    if n == 1:\n        return array[0]\n\n    # Calculate maximum sum of increasing subsequence ending at each position\n    lis = [0] * n\n    for i in range(n):\n        lis[i] = array[i]\n        for j in range(i):\n            if array[i] > array[j]:\n                lis[i] = max(lis[i], lis[j] + array[i])\n\n    # Calculate maximum sum of decreasing subsequence starting at each position\n    lds = [0] * n\n    for i in range(n - 1, -1, -1):\n        lds[i] = array[i]\n        for j in range(n - 1, i, -1):\n            if array[i] > array[j]:\n                lds[i] = max(lds[i], lds[j] + array[i])\n\n    # Combine increasing and decreasing sums to find the maximum bitonic sum\n    max_bitonic_sum = 0\n    for i in range(n):\n        # A single element can be considered a bitonic subsequence.\n        # However, for a proper bitonic subsequence of length > 1, \n        # the element `array[i]` is counted twice if we simply add lis[i] + lds[i].\n        # So we subtract `array[i]` to count it only once as the peak element.\n        # We also need to ensure that the subsequence is indeed bitonic (has both increasing and decreasing parts)\n        # or at least an increasing or decreasing subsequence of length > 1.\n        # A sequence must have at least two elements to be strictly increasing then decreasing.\n        # The problem allows single-element sequences or purely increasing/decreasing sequences.\n        # If we take `array[i]` as the peak, `lis[i]` accounts for sum ending at `i` and `lds[i]` for sum starting at `i`.\n        # To form a bitonic sequence, `array[i]` must be the peak.\n        # If `lis[i]` is just `array[i]` (meaning no smaller element preceded it) AND `lds[i]` is just `array[i]` (meaning no smaller element followed it),\n        # then `lis[i] + lds[i] - array[i]` would just be `array[i]`.\n        # The logic `lis[i] + lds[i] - array[i]` correctly sums the unique elements of the combined sequence.\n        max_bitonic_sum = max(max_bitonic_sum, lis[i] + lds[i] - array[i])\n        \n    return max_bitonic_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/251": [{"task_id": "Mbpp/251", "solution": "def insert_element(input_list, element):\n    \"\"\"\n    Inserts the given element before each element in the input list.\n    Returns a new list with the inserted elements.\n    \"\"\"\n    result_list = []\n    for item in input_list:\n        result_list.append(element)\n        result_list.append(item)\n    return result_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/239": [{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the number of possible sequences of length n,\n    such that each element is a positive integer, is greater than or equal to twice the previous element,\n    and is less than or equal to m.\n    \"\"\"\n    # dp[i][j] stores the number of sequences of length i that end with the value j.\n    # Dimensions: (n + 1) for sequence length (1-indexed), (m + 1) for element value (1-indexed).\n    dp = [[0] * (m + 1) for _ in range(n + 1)]\n\n    # Base case: For sequences of length 1, any positive integer from 1 to m is a valid sequence.\n    for j in range(1, m + 1):\n        dp[1][j] = 1\n\n    # Fill the DP table for sequence lengths from 2 up to n.\n    for i in range(2, n + 1):\n        # Calculate prefix sums for the previous length (i-1) to optimize summation.\n        # prefix_sum_prev_len[k] will store the sum of dp[i-1][x] for x from 1 to k.\n        prefix_sum_prev_len = [0] * (m + 1)\n        current_sum = 0\n        for k_prev in range(1, m + 1):\n            current_sum += dp[i - 1][k_prev]\n            prefix_sum_prev_len[k_prev] = current_sum\n\n        # For the current length i, iterate through all possible ending values j.\n        for j_current in range(1, m + 1):\n            # A previous element k_prev must satisfy k_prev * 2 <= j_current.\n            # This means k_prev <= j_current // 2.\n            max_possible_prev_val = j_current // 2\n\n            # If a valid previous element k_prev exists (i.e., max_possible_prev_val >= 1),\n            # sum up the counts from dp[i-1][k_prev] for all such k_prev.\n            if max_possible_prev_val >= 1:\n                dp[i][j_current] = prefix_sum_prev_len[max_possible_prev_val]\n            # Otherwise (if max_possible_prev_val is 0, meaning j_current < 2),\n            # no valid previous element exists, so dp[i][j_current] remains 0.\n\n    # The total number of sequences of length n is the sum of all entries in dp[n].\n    total_sequences = sum(dp[n][j] for j in range(1, m + 1))\n\n    return total_sequences", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/250": [{"task_id": "Mbpp/250", "solution": "def count_X(input_tuple, search_element):\n    \"\"\"Counts the occurrences of an element in a tuple.\n\n    Iterates through the tuple and increments a counter for each matching element.\n    \"\"\"\n    count = 0\n    for element in input_tuple:\n        if element == search_element:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/252": [{"task_id": "Mbpp/252", "solution": "import math\ndef convert(z):\n    \"\"\"\n    Converts a complex number or real number to its polar coordinates (magnitude, angle).\n    \"\"\"\n    z = complex(z)  # Ensure input is a complex number\n    magnitude = math.sqrt(z.real**2 + z.imag**2)\n    angle = math.atan2(z.imag, z.real)\n    return (magnitude, angle)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/253": [{"task_id": "Mbpp/253", "solution": "def count