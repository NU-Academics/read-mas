{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\nclass ParenthesisGroup:\n    \"\"\"Represents a single group of parentheses and computes its maximum nesting depth.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def compute_max_depth(self) -> int:\n        \"\"\"\n        Scans the group text to find the deepest level of nesting.\n        '(' increments depth, ')' decrements depth; other characters are ignored.\n        \"\"\"\n        current_depth = 0\n        max_depth = 0\n        for char in self.text:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n        return max_depth\n\n\nclass InputString:\n    \"\"\"Represents the raw input string and provides functionality to split it into groups.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n\n    def split_by_space(self) -> List[ParenthesisGroup]:\n        \"\"\"Splits the raw string by spaces and creates ParenthesisGroup instances.\"\"\"\n        groups_text = self.raw.split(' ')\n        return [ParenthesisGroup(text) for text in groups_text]\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    input_str_obj = InputString(paren_string)\n    parenthesis_groups = input_str_obj.split_by_space()\n\n    result_depths: List[int] = []\n    for group in parenthesis_groups:\n        result_depths.append(group.compute_max_depth())\n\n    return result_depths"}
{"task_id": "HumanEval/3", "solution": "from typing import List\n\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    balance = 0\n    for operation in operations:\n        balance += operation\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/2", "solution": "from math import floor, isfinite\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    if not isfinite(number):\n        raise ValueError(\"Input must be a finite float\")\n    if number <= 0.0:\n        raise ValueError(\"Input must be strictly positive\")\n    integer_part = floor(number)\n    decimal_part = number - integer_part\n    return float(decimal_part)"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    Precondition: numbers must contain at least one element.\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n\n    def compute_mean(numbers: List[float]) -> float:\n        \"\"\"Compute the arithmetic mean of a list of numbers.\"\"\"\n        return sum(numbers) / len(numbers)\n\n    def compute_absolute_deviations(numbers: List[float], mean: float) -> List[float]:\n        \"\"\"Compute element-wise absolute deviations from a supplied mean.\"\"\"\n        return [abs(x - mean) for x in numbers]\n\n    def compute_mad(deviations: List[float]) -> float:\n        \"\"\"Compute the arithmetic average of absolute deviations.\"\"\"\n        return sum(deviations) / len(deviations)\n\n    mean_value = compute_mean(numbers)\n    deviations = compute_absolute_deviations(numbers, mean_value)\n    mad_value = compute_mad(deviations)\n    return mad_value"}
{"task_id": "HumanEval/0", "solution": "from typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    for i in range(len(numbers)):\n        for j in range(i + 1, len(numbers)):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/5", "solution": "from typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    result = []\n    # Iterate through the input numbers and build the new list.\n    for i, num in enumerate(numbers):\n        result.append(num)\n        # If it's not the last element, append the delimiter.\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/7", "solution": "from typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separates groups of nested parentheses from an input string, ignoring spaces. Returns a list of strings, where each string is a balanced top-level parenthesis group.\"\"\"\n\n    # Remove all whitespace characters from the input string.\n    cleaned_string = \"\".join(c for c in paren_string if not c.isspace())\n\n    # Filter the cleaned string to only include parenthesis characters, creating a token list.\n    tokens = [c for c in cleaned_string if c == '(' or c == ')']\n\n    groups: List[str] = []\n    current_group_chars: List[str] = []\n    depth = 0\n\n    # Iterate through tokens to assemble top-level parenthesis groups.\n    for char_token in tokens:\n        if char_token == '(':\n            if depth == 0:\n                # Start of a new top-level group, clear any leftover content.\n                current_group_chars = []\n            depth += 1\n            current_group_chars.append(char_token)\n        elif char_token == ')':\n            depth -= 1\n            current_group_chars.append(char_token)\n            if depth == 0:\n                # End of a top-level group, add the accumulated content to results.\n                groups.append(\"\".join(current_group_chars))\n\n    return groups"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n    for num in numbers:\n        total_sum += num\n        total_product *= num\n    return (total_sum, total_product)"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_string_found = strings[0]\n    max_length_found = len(strings[0])\n\n    for s in strings[1:]:\n        current_length = len(s)\n        if current_length > max_length_found:\n            max_length_found = current_length\n            longest_string_found = s\n\n    return longest_string_found"}
{"task_id": "HumanEval/14", "solution": "from typing import List\n\n\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    return [string[:i] for i in range(1, len(string) + 1)]"}
{"task_id": "HumanEval/11", "solution": "from typing import List\n\n\nclass InputString:\n    def __init__(self, value: str):\n        self.value = value\n\n    def is_binary(self) -> bool:\n        return all(char in ('0', '1') for char in self.value)\n\n    @property\n    def length(self) -> int:\n        return len(self.value)\n\n\nclass XORResult:\n    def __init__(self, value: str):\n        self.value = value\n\n    @property\n    def length(self) -> int:\n        return len(self.value)\n\n\nclass XOROperation:\n    def __init__(self, operand_a: InputString, operand_b: InputString):\n        self.operand_a = operand_a\n        self.operand_b = operand_b\n        self.result: XORResult | None = None\n\n    def execute(self) -> XORResult:\n        if not self.operand_a.is_binary() or not self.operand_b.is_binary():\n            raise ValueError(\"inputs must contain only '0' and '1'\")\n\n        if self.operand_a.length != self.operand_b.length:\n            raise ValueError(\"input strings must be of equal length\")\n\n        result_chars = []\n        for i in range(self.operand_a.length):\n            if self.operand_a.value[i] == self.operand_b.value[i]:\n                result_chars.append('0')\n            else:\n                result_chars.append('1')\n        \n        self.result = XORResult(\"\".join(result_chars))\n        return self.result\n\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    operand_a = InputString(a)\n    operand_b = InputString(b)\n\n    xor_op = XOROperation(operand_a, operand_b)\n    xor_result = xor_op.execute()\n    \n    return xor_result.value"}
{"task_id": "HumanEval/9", "solution": "from typing import List\nfrom dataclasses import dataclass\n\n\n@dataclass\nclass Element:\n    value: int\n    index: int\n\n\n@dataclass\nclass InputSequence:\n    numbers: List[int]\n\n    def to_elements(self) -> List[Element]:\n        return [Element(value, i) for i, value in enumerate(self.numbers)]\n\n\n@dataclass\nclass OutputSequence:\n    rolling_max: List[int]\n\n\nclass RollingMaxCalculator:\n    def rolling_max(self, numbers: List[int]) -> List[int]:\n        \"\"\"Compute rolling maxima for a list of integers.\"\"\"\n        if not numbers:\n            return []\n\n        output = []\n        current_max = numbers[0]\n        output.append(current_max)\n\n        for i in range(1, len(numbers)):\n            current_max = max(current_max, numbers[i])\n            output.append(current_max)\n        return output\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    calculator = RollingMaxCalculator()\n    return calculator.rolling_max(numbers)"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\n\ndef _longest_palindromic_suffix(string: str) -> tuple[int, str]:\n    \"\"\" Return (start_index, suffix_value) for the longest suffix of string that is a palindrome. \"\"\"\n    n = len(string)\n    if n == 0:\n        return (0, \"\")\n    \n    for i in range(n):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            return (i, suffix)\n    \n    # This point should not be reached for non-empty strings, as the last character is always a palindrome.\n    return (0, \"\")\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    start_index, _ = _longest_palindromic_suffix(string)\n    \n    prefix_to_reverse = string[:start_index]\n    \n    return string + prefix_to_reverse[::-1]"}
{"task_id": "HumanEval/13", "solution": "class GCDCalculator:\n    \"\"\"Computes the greatest common divisor using the Euclidean algorithm.\"\"\"\n    def greatest_common_divisor(self, a: int, b: int) -> int:\n        \"\"\"Computes GCD of two non-negative integers using Euclidean algorithm.\"\"\"\n        # Assumes a and b are already non-negative.\n        return self._euclidean(a, b)\n\n    def _euclidean(self, a: int, b: int) -> int:\n        \"\"\"Internal helper for the Euclidean algorithm.\"\"\"\n        while b:\n            a, b = b, a % b\n        return a\n\n\nclass InputValidator:\n    \"\"\"Validates input types for the GCD function.\"\"\"\n    def validate_types(self, a, b) -> bool:\n        \"\"\"Returns True if both inputs are integers, False otherwise.\"\"\"\n        return isinstance(a, int) and isinstance(b, int)\n\n\nclass IntegerValue:\n    \"\"\"Encapsulates an integer value and provides absolute value normalization.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def abs(self) -> int:\n        \"\"\"Returns the absolute value of the encapsulated integer.\"\"\"\n        return abs(self.value)\n\n\ndef greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    validator = InputValidator()\n    if not validator.validate_types(a, b):\n        raise TypeError(\"Inputs must be integers\")\n\n    a_abs = IntegerValue(a).abs()\n    b_abs = IntegerValue(b).abs()\n\n    calc = GCDCalculator()\n    result_value = calc.greatest_common_divisor(a_abs, b_abs)\n\n    return result_value"}
