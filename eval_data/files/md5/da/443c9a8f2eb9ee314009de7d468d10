{"task_id": "HumanEval/117", "solution": "def _is_consonant(char: str) -> bool:\n    \"\"\"Checks if a character is a consonant.\n    Consonants are non-vowel letters, case-insensitively.\"\"\"\n    char_lower = char.lower()\n    return 'a' <= char_lower <= 'z' and char_lower not in 'aeiou'\ndef _count_consonants(word: str) -> int:\n    \"\"\"Counts the number of consonants in a given word.\"\"\"\n    count = 0\n    for char in word:\n        if _is_consonant(char):\n            count += 1\n    return count\ndef _split_into_words(s: str) -> list[str]:\n    \"\"\"Splits an input string into a list of individual words.\"\"\"\n    return s.split()\ndef select_words(s: str, n: int) -> list[str]:\n    \"\"\"Filters words from a string that contain exactly n consonants.\n    Returns words in their original order, handling empty input strings.\"\"\"\n    if not s:\n        return []\n\n    words = _split_into_words(s)\n    result = []\n    for word in words:\n        if _count_consonants(word) == n:\n            result.append(word)\n    return result"}
{"task_id": "HumanEval/116", "solution": "def _count_set_bits(n: int) -> int:\n    \"\"\"Counts set bits, treating negative numbers as 32-bit two's complement for bit counting.\"\"\"\n    count = 0\n    if n < 0:\n        # Mask to 32 bits to simulate 32-bit two's complement for bit counting.\n        n = n & 0xFFFFFFFF\n\n    # Count set bits using bitwise operations.\n    while n > 0:\n        count += n & 1\n        n >>= 1\n    return count\ndef sort_array(arr: list[int]) -> list[int]:\n    \"\"\"Sorts an array of integers by set bit count, then by decimal value.\"\"\"\n    return sorted(arr, key=lambda x: (_count_set_bits(x), x))"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"Determines if lst1 can be made entirely even by exchanging elements with lst2.\n    It counts odd numbers in lst1 and even numbers in lst2 to make this determination.\"\"\"\n\n    def _is_even(number: int) -> bool:\n        \"\"\"Checks if a single integer is even.\"\"\"\n        return number % 2 == 0\n\n    def _count_odds(numbers: list[int]) -> int:\n        \"\"\"Counts the number of odd integers in a given list.\"\"\"\n        count = 0\n        for num in numbers:\n            if not _is_even(num):\n                count += 1\n        return count\n\n    def _count_evens(numbers: list[int]) -> int:\n        \"\"\"Counts the number of even integers in a given list.\"\"\"\n        count = 0\n        for num in numbers:\n            if _is_even(num):\n                count += 1\n        return count\n\n    odd_count_lst1 = _count_odds(lst1)\n    even_count_lst2 = _count_evens(lst2)\n\n    if odd_count_lst1 <= even_count_lst2:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    In this Kata, you have to sort an array of non-negative integers according to\n    number of ones in their binary representation in ascending order.\n    For similar number of ones, sort based on decimal value.\n\n    It must be implemented like this:\n    >>> sort_array([1, 5, 2, 3, 4]) == [1, 2, 3, 4, 5]\n    >>> sort_array([-2, -3, -4, -5, -6]) == [-6, -5, -4, -3, -2]\n    >>> sort_array([1, 0, 2, 3, 4]) [0, 1, 2, 3, 4]\n    \"\"\"\n    def get_sort_key(num):\n        if num < 0:\n            # Negative numbers come first, sorted by their decimal value.\n            return (-1, num)\n        else:\n            # Non-negative numbers sorted by bit count, then by decimal value.\n            return (num.bit_count(), num)\n\n    return sorted(arr, key=get_sort_key)"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Selects words from a string that contain exactly n consonants.\n    Preserves original word order and handles empty input strings.\n    \"\"\"\n\n    def _is_vowel(char):\n        \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n        return char.lower() in {'a', 'e', 'i', 'o', 'u'}\n\n    def _count_consonants(word):\n        \"\"\"Counts the number of consonants in a given word.\"\"\"\n        count = 0\n        for char in word:\n            if not _is_vowel(char):\n                count += 1\n        return count\n\n    if not s:\n        return []\n\n    words = s.split()\n    result = []\n    for word in words:\n        if _count_consonants(word) == n:\n            result.append(word)\n\n    return result"}
{"task_id": "HumanEval/118", "solution": "def is_vowel(char):\n    \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n    return char.lower() in 'aeiou'\ndef is_consonant(char):\n    \"\"\"Checks if a character is an English letter and not a vowel.\"\"\"\n    return char.isalpha() and not is_vowel(char)\ndef get_closest_vowel(word):\n    \"\"\"Finds the closest vowel between two consonants from the right side of the word.\"\"\"\n    if len(word) < 3:\n        return \"\"\n\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        if is_vowel(current_char):\n            if is_consonant(word[i-1]) and is_consonant(word[i+1]):\n                return current_char\n\n    return \"\""}
{"task_id": "HumanEval/119", "solution": "def _is_balanced(s):\n    \"\"\"Checks if a string of parentheses is balanced.\"\"\"\n    balance = 0\n    for char in s:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0\ndef _validate_input(lst):\n    \"\"\"\n    Validates the input list and extracts two strings.\n    Raises ValueError if the input is not a list of two strings or contains invalid characters.\n    \"\"\"\n    if not isinstance(lst, list) or len(lst) != 2:\n        raise ValueError(\"Input must be a list of two strings.\")\n\n    string1 = lst[0]\n    string2 = lst[1]\n\n    if not isinstance(string1, str) or not isinstance(string2, str):\n        raise ValueError(\"All elements in the list must be strings.\")\n\n    valid_chars = {'(', ')'}\n    for s in [string1, string2]:\n        for char in s:\n            if char not in valid_chars:\n                raise ValueError(\"Strings must only contain '(' or ')' characters.\")\n\n    return string1, string2\ndef match_parens(lst):\n    '''\n    You are given a list of two strings, both strings consist of open\n    parentheses '(' or close parentheses ')' only.\n    Your job is to check if it is possible to concatenate the two strings in\n    some order, that the resulting string will be good.\n    A string S is considered to be good if and only if all parentheses in S\n    are balanced. For example: the string '(())()' is good, while the string\n    '())' is not.\n    Return 'Yes' if there's a way to make a good string, and return 'No' otherwise.\n\n    Examples:\n    match_parens(['()(', ')']) == 'Yes'\n    match_parens([')', ')']) == 'No'\n    '''\n    string1, string2 = _validate_input(lst)\n\n    concatenation1 = string1 + string2\n    concatenation2 = string2 + string1\n\n    is_balanced1 = _is_balanced(concatenation1)\n    is_balanced2 = _is_balanced(concatenation2)\n\n    if is_balanced1 or is_balanced2:\n        return 'Yes'\n    else:\n        return 'No'"}
{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n    \"\"\"\n\n    # Sort the array in ascending order.\n    arr.sort()\n\n    # Select the last k elements, which are the k largest numbers and already sorted.\n    return arr[len(arr) - k:]"}
{"task_id": "HumanEval/118", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is a vowel (case-sensitive).\"\"\"\n    return char in VOWELS\ndef _is_consonant(char: str) -> bool:\n    \"\"\"Checks if a character is a consonant, assuming it's an English letter.\"\"\"\n    return not _is_vowel(char)\ndef get_closest_vowel(word):\n    \"\"\"You are given a word. Your task is to find the closest vowel that stands between\n    two consonants from the right side of the word (case sensitive).\n\n    Vowels in the beginning and ending doesn't count. Return empty string if you didn't\n    find any vowel met the above condition.\n\n    You may assume that the given string contains English letter only.\n\n    Example:\n    get_closest_vowel(\"yogurt\") ==> \"u\"\n    get_closest_vowel(\"FULL\") ==> \"U\"\n    get_closest_vowel(\"quick\") ==> \"\"\n    get_closest_vowel(\"ab\") ==> \"\"\n    \"\"\"\n\n    # Iterate from the second-to-last character down to the second character.\n    # This range excludes characters at the beginning and end of the word.\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i-1]\n        right_char = word[i+1]\n\n        if _is_vowel(current_char):\n            if _is_consonant(left_char) and _is_consonant(right_char):\n                return current_char\n\n    return \"\""}
{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    # Sort the array in descending order to easily select the largest elements.\n    sorted_arr_desc = sorted(arr, reverse=True)\n\n    # Take the first k elements, which are the k largest numbers.\n    k_largest_unordered = sorted_arr_desc[:k]\n\n    # Sort these k largest elements in ascending order as required for the output.\n    return sorted(k_largest_unordered)"}
{"task_id": "HumanEval/119", "solution": "class ParenthesesString:\n    \"\"\"Encapsulates a string of parentheses with validation and manipulation methods.\"\"\"\n    def __init__(self, content: str):\n        self._content = content\n\n    def isValidCharacterContent(self) -> bool:\n        \"\"\"Validates if the string contains only '(' or ')' characters.\"\"\"\n        return all(c in '()' for c in self._content)\n\n    def getOpenCount(self) -> int:\n        \"\"\"Returns the total count of open parentheses.\"\"\"\n        return self._content.count('(')\n\n    def getCloseCount(self) -> int:\n        \"\"\"Returns the total count of close parentheses.\"\"\"\n        return self._content.count(')')\n\n    def concatenate(self, other: 'ParenthesesString') -> 'ParenthesesString':\n        \"\"\"Concatenates this string with another ParenthesesString.\"\"\"\n        return ParenthesesString(self._content + other._content)\n\n    def getContent(self) -> str:\n        \"\"\"Returns the raw string content.\"\"\"\n        return self._content\nclass BalanceChecker:\n    \"\"\"Provides a static method to determine if a ParenthesesString is balanced.\"\"\"\n    @staticmethod\n    def check(s: ParenthesesString) -> bool:\n        \"\"\"Checks if the given ParenthesesString is balanced.\"\"\"\n        balance = 0\n        for char in s.getContent():\n            if char == '(':\n                balance += 1\n            else:\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\ndef match_parens(lst: list[str]) -> str:\n    \"\"\"\n    Checks if two parentheses strings can be concatenated to form a balanced string.\n    Returns 'Yes' if a balanced string can be formed, 'No' otherwise.\n    \"\"\"\n    p_str1 = ParenthesesString(lst[0])\n    p_str2 = ParenthesesString(lst[1])\n\n    if not p_str1.isValidCharacterContent() or not p_str2.isValidCharacterContent():\n        return 'No'\n\n    concat1 = p_str1.concatenate(p_str2)\n    if BalanceChecker.check(concat1):\n        return 'Yes'\n\n    concat2 = p_str2.concatenate(p_str1)\n    if BalanceChecker.check(concat2):\n        return 'Yes'\n\n    return 'No'"}
{"task_id": "HumanEval/121", "solution": "from typing import List\nclass InputList:\n    \"\"\"Encapsulates the input list, providing indexed access and size.\"\"\"\n    def __init__(self, lst: List[int]):\n        self._elements = lst\n        self._size = len(lst)\n\n    def get_element_at_index(self, index: int) -> int:\n        \"\"\"Returns the element at the specified index.\"\"\"\n        return self._elements[index]\n\n    def get_size(self) -> int:\n        \"\"\"Returns the total number of elements in the list.\"\"\"\n        return self._size\nclass Element:\n    \"\"\"Represents a single element with its value and original index.\"\"\"\n    def __init__(self, value: int, index: int):\n        self._value = value\n        self._index = index\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the element's value is odd.\"\"\"\n        return self._value % 2 != 0\n\n    def is_even_position(self) -> bool:\n        \"\"\"Checks if the element's index is even (0-based).\"\"\"\n        return self._index % 2 == 0\nclass SumAccumulator:\n    \"\"\"Accumulates a running sum of integers.\"\"\"\n    def __init__(self):\n        self._current_sum = 0\n\n    def add(self, value: int):\n        \"\"\"Adds a given value to the current sum.\"\"\"\n        self._current_sum += value\n\n    def get_value(self) -> int:\n        \"\"\"Returns the current accumulated sum.\"\"\"\n        return self._current_sum\ndef solution(lst: List[int]) -> int:\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\"\"\"\n    input_list_obj = InputList(lst)\n    sum_accumulator = SumAccumulator()\n\n    for i in range(input_list_obj.get_size()):\n        element_value = input_list_obj.get_element_at_index(i)\n        element_obj = Element(element_value, i)\n\n        if element_obj.is_even_position():\n            if element_obj.is_odd():\n                sum_accumulator.add(element_value)\n\n    return sum_accumulator.get_value()"}
{"task_id": "HumanEval/122", "solution": "def _has_at_most_two_digits(number: int) -> bool:\n    \"\"\"Checks if a number's absolute value has at most two digits.\n    This means the number is between -99 and 99, inclusive.\"\"\"\n    return -99 <= number <= 99\ndef add_elements(arr: list[int], k: int) -> int:\n    \"\"\"Calculates the sum of elements with at most two digits from the first k elements of arr.\n    Assumes valid inputs as per problem constraints.\"\"\"\n    total_sum = 0\n    for i in range(k):\n        element = arr[i]\n        if _has_at_most_two_digits(element):\n            total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\"\"\"\n    total_sum = 0\n    for index, element in enumerate(lst):\n        if index % 2 == 0:  # Check if the position is even\n            if element % 2 != 0:  # Check if the element value is odd\n                total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/123", "solution": "def _is_odd(number):\n    \"\"\"Checks if a number is odd.\"\"\"\n    return number % 2 != 0\ndef _generate_collatz_sequence(start_number):\n    \"\"\"Generates the Collatz sequence for a given start number.\"\"\"\n    sequence = []\n    current_num = start_number\n    while current_num != 1:\n        sequence.append(current_num)\n        if _is_odd(current_num):\n            current_num = 3 * current_num + 1\n        else:\n            current_num = current_num // 2\n    sequence.append(1)\n    return sequence\ndef _collect_and_sort_odd_numbers(sequence):\n    \"\"\"Collects and sorts odd numbers from a sequence.\"\"\"\n    odd_numbers_list = []\n    for num in sequence:\n        if _is_odd(num):\n            odd_numbers_list.append(num)\n    odd_numbers_list.sort()\n    return odd_numbers_list\ndef get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    This function generates the Collatz sequence, extracts odd numbers, and returns them sorted.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"Input n must be a positive integer.\")\n\n    if n == 1:\n        return [1]\n\n    collatz_sequence = _generate_collatz_sequence(n)\n    return _collect_and_sort_odd_numbers(collatz_sequence)"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Calculates the sum of elements with at most two digits from the first k elements of arr.\n    Includes input validation for array length and k value.\n    \"\"\"\n    # 1. Input Validation\n    if not (1 <= len(arr) <= 100):\n        raise ValueError(\"Array length must be between 1 and 100, inclusive.\")\n    if not (1 <= k <= len(arr)):\n        raise ValueError(\"k must be between 1 and len(arr), inclusive.\")\n\n    # 2. Array Slicing\n    first_k_elements = arr[:k]\n\n    # 3. Element Filtering and 4. Summation\n    total_sum = 0\n    for element in first_k_elements:\n        if abs(element) <= 99:  # Filter for elements with at most two digits\n            total_sum += element\n\n    # 5. Return Value\n    return total_sum"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date_string):\n    \"\"\"Validates if a date string is in 'mm-dd-yyyy' format and represents a valid date.\n    Returns True for valid dates, False otherwise.\n    \"\"\"\n    # FR1: The system shall validate that the input date string is not empty.\n    if not date_string:\n        return False\n\n    # FR6: The system shall validate that the date string is in the format 'mm-dd-yyyy'.\n    parts = date_string.split('-')\n    if len(parts) != 3:\n        return False\n\n    month_str, day_str, year_str = parts\n\n    # Check length and digit-only for each part to ensure 'mm-dd-yyyy' structure.\n    if not (len(month_str) == 2 and month_str.isdigit() and\n            len(day_str) == 2 and day_str.isdigit() and\n            len(year_str) == 4 and year_str.isdigit()):\n        return False\n\n    month = int(month_str)\n    day = int(day_str)\n    # year = int(year_str) # Year is parsed but not used in current validation rules.\n\n    # FR5: The system shall validate that the month is between 1 and 12 (inclusive).\n    if not (1 <= month <= 12):\n        return False\n\n    # Determine maximum days for the month based on FR2, FR3, FR4.\n    max_days = 0\n    if month in [1, 3, 5, 7, 8, 10, 12]:\n        max_days = 31 # FR2\n    elif month in [4, 6, 9, 11]:\n        max_days = 30 # FR3\n    elif month == 2:\n        max_days = 29 # FR4 (leap years are not considered)\n\n    # Validate day against the determined maximum days.\n    if not (1 <= day <= max_days):\n        return False\n\n    # FR7: Return True if all validation rules are satisfied.\n    return True"}
{"task_id": "HumanEval/123", "solution": "def _is_odd(number: int) -> bool:\n    \"\"\"Checks if a given number is odd.\"\"\"\n    return number % 2 != 0\ndef _generate_collatz_sequence(start_value: int) -> list[int]:\n    \"\"\"Generates the Collatz sequence starting from start_value until 1.\"\"\"\n    sequence = []\n    current_term = start_value\n    while current_term != 1:\n        sequence.append(current_term)\n        if current_term % 2 == 0:\n            current_term = current_term // 2\n        else:\n            current_term = (3 * current_term) + 1\n    sequence.append(1)  # Add the final 1 to the sequence\n    return sequence\ndef get_odd_collatz(n: int) -> list[int]:\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n    if n == 1:\n        return [1]\n\n    collatz_sequence = _generate_collatz_sequence(n)\n\n    odd_numbers = []\n    for term in collatz_sequence:\n        if _is_odd(term):\n            odd_numbers.append(term)\n\n    odd_numbers.sort()\n    return odd_numbers"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"Validates a date string based on `mm-dd-yyyy` format, month, and day ranges.\n    Returns True if valid, False otherwise.\n    \"\"\"\n    # FR2: Check if the date string is empty.\n    if not date:\n        return False\n\n    # FR7: Validate the date format `mm-dd-yyyy`.\n    if len(date) != 10 or date[2] != '-' or date[5] != '-':\n        return False\n\n    # Extract month, day, year components and convert to integers.\n    try:\n        month_str = date[0:2]\n        day_str = date[3:5]\n        year_str = date[6:10]\n\n        month = int(month_str)\n        day = int(day_str)\n        # Year is not used for date logic but must be convertible.\n        year = int(year_str)\n    except ValueError:\n        # If conversion fails, the components are not numeric, so format is invalid.\n        return False\n\n    # FR6: Validate month range (1-12).\n    if not (1 <= month <= 12):\\\n        return False\n\n    # FR3, FR4, FR5: Validate day range based on the month.\n    # Months with 31 days\n    if month in [1, 3, 5, 7, 8, 10, 12]:\n        if not (1 <= day <= 31):\n            return False\n    # Months with 30 days\n    elif month in [4, 6, 9, 11]:\n        if not (1 <= day <= 30):\n            return False\n    # Month 2 (February)\n    elif month == 2:\n        # FR5 specifies 1-29 for February, without considering leap years.\n        if not (1 <= day <= 29):\n            return False\n\n    # FR1: If all checks pass, the date is valid.\n    return True"}
{"task_id": "HumanEval/125", "solution": "import re\ndef _has_whitespace(text: str) -> bool:\n    \"\"\"Checks if the input string contains any whitespace characters.\"\"\"\n    return bool(re.search(r'\\s', text))\ndef _has_commas(text: str) -> bool:\n    \"\"\"Checks if the input string contains any comma characters.\"\"\"\n    return ',' in text\ndef _count_odd_order_lowercase_letters(text: str) -> int:\n    \"\"\"Counts lowercase letters with an odd 0-indexed alphabetical order.\"\"\"\n    count = 0\n    for char in text:\n        if 'a' <= char <= 'z':\n            if (ord(char) - ord('a')) % 2 != 0:\n                count += 1\n    return count\ndef split_words(txt: str) -> list[str] | int:\n    \"\"\"\n    Given a string, returns a list of words or an integer count based on delimiters.\n    Splits by whitespace, then commas, otherwise counts odd-order lowercase letters.\n    \"\"\"\n    if _has_whitespace(txt):\n        return txt.split()\n    elif _has_commas(txt):\n        return txt.split(',')\n    else:\n        return _count_odd_order_lowercase_letters(txt)"}
{"task_id": "HumanEval/115", "solution": "import math\ndef _calculate_total_water_units(grid):\n    \"\"\"Calculates the total number of water units in the grid.\n    It sums all '1's across all wells in the input grid.\"\"\"\n    total_water = 0\n    for well in grid:\n        total_water += sum(well)\n    return total_water\ndef _calculate_operations(total_water, capacity):\n    \"\"\"Calculates the minimum bucket lowering operations.\n    It uses math.ceil to ensure all water is extracted.\"\"\"\n    if total_water == 0:\n        return 0\n    return math.ceil(total_water / capacity)\ndef max_fill(grid, capacity):\n    \"\"\"\n    Calculates the minimum number of bucket lowering operations required to empty a grid of wells.\n    Each '1' in the grid represents a unit of water, and buckets have a fixed capacity.\n    \"\"\"\n    total_water_units = _calculate_total_water_units(grid)\n    num_operations = _calculate_operations(total_water_units, capacity)\n    return int(num_operations)"}
{"task_id": "HumanEval/126", "solution": "def _validate_input_elements(lst):\n    \"\"\"Checks if all elements in the list are non-negative.\"\"\"\n    for element in lst:\n        if element < 0:\n            return False\n    return True\ndef _check_ascending_order(lst):\n    \"\"\"Checks if the list is sorted in ascending order.\"\"\"\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n    return True\ndef _check_duplicate_count(lst):\n    \"\"\"Checks if any number appears more than two times.\"\"\"\n    counts = {}\n    for number in lst:\n        counts[number] = counts.get(number, 0) + 1\n    for count in counts.values():\n        if count > 2:\n            return False\n    return True\ndef is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n\n    Examples\n    is_sorted([5]) \u279e True\n    is_sorted([1, 2, 3, 4, 5]) \u279e True\n    is_sorted([1, 3, 2, 4, 5]) \u279e False\n    is_sorted([1, 2, 3, 4, 5, 6]) \u279e True\n    is_sorted([1, 2, 3, 4, 5, 6, 7]) \u279e True\n    is_sorted([1, 3, 2, 4, 5, 6, 7]) \u279e False\n    is_sorted([1, 2, 2, 3, 3, 4]) \u279e True\n    is_sorted([1, 2, 2, 2, 3, 4]) \u279e False\n    '''\n    if not _validate_input_elements(lst):\n        return False\n    if not _check_ascending_order(lst):\n        return False\n    if not _check_duplicate_count(lst):\n        return False\n    return True"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Returns True if the list is sorted in ascending order with at most one duplicate of any number, False otherwise.\n    Assumes non-negative integers.\n    '''\n    # Handle edge cases for empty or single-element lists.\n    if len(lst) <= 1:\n        return True\n\n    # Initialize a frequency map to count occurrences of each number.\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n        # If any number appears more than twice, return False.\n        if counts[num] > 2:\n            return False\n\n    # Iterate through the list to check for ascending order.\n    for i in range(1, len(lst)):\n        # If any element is less than its predecessor, return False.\n        if lst[i] < lst[i-1]:\n            return False\n\n    # If all checks pass, the list meets the criteria.\n    return True"}
{"task_id": "HumanEval/125", "solution": "from typing import List, Union\ndef _get_alphabetical_order(char: str) -> int:\n    \"\"\"\n    Determines the 0-indexed alphabetical order of a lowercase letter.\n    For example, 'a' is 0, 'b' is 1, ..., 'z' is 25.\n    \"\"\"\n    return ord(char) - ord('a')\ndef _count_odd_ordered_lowercase_letters(text: str) -> int:\n    \"\"\"\n    Counts lowercase letters in a string whose 0-indexed alphabetical order is an odd number.\n    It iterates through each character, checking if it's a lowercase letter and if its order is odd.\n    \"\"\"\n    count = 0\n    for char in text:\n        if 'a' <= char <= 'z':\n            order = _get_alphabetical_order(char)\n            if order % 2 != 0:\n                count += 1\n    return count\ndef _contains_whitespace(text: str) -> bool:\n    \"\"\"\n    Checks if a string contains any whitespace characters.\n    Returns True if whitespace is found, False otherwise.\n    \"\"\"\n    return any(c.isspace() for c in text)\ndef _contains_comma(text: str) -> bool:\n    \"\"\"\n    Checks if a string contains any comma characters.\n    Returns True if a comma is found, False otherwise.\n    \"\"\"\n    return ',' in text\ndef split_words(txt: str) -> Union[List[str], int]:\n    \"\"\"\n    Splits a string based on whitespace or commas, or counts odd-ordered lowercase letters.\n    The splitting priority is whitespace first, then commas.\n    \"\"\"\n    if _contains_whitespace(txt):\n        return txt.split()\n    elif _contains_comma(txt):\n        return txt.split(',')\n    else:\n        return _count_odd_ordered_lowercase_letters(txt)"}
{"task_id": "HumanEval/127", "solution": "import math\nclass Interval:\n    \"\"\"Represents a closed integer interval (start, end).\"\"\"\n    def __init__(self, start: int, end: int):\n        self.start = start\n        self.end = end\ndef _calculate_intersection(interval1: Interval, interval2: Interval) -> Interval | None:\n    \"\"\"Determines the overlapping segment of two intervals. Returns None if no intersection.\"\"\"\n    max_start = max(interval1.start, interval2.start)\n    min_end = min(interval1.end, interval2.end)\n    if max_start > min_end:\n        return None\n    return Interval(max_start, min_end)\ndef _get_interval_length(interval: Interval) -> int:\n    \"\"\"Calculates the length of a given interval.\"\"\"\n    return interval.end - interval.start + 1\ndef _is_prime(number: int) -> bool:\n    \"\"\"Checks if a given integer is a prime number.\"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return True\n    for i in range(2, int(math.sqrt(number)) + 1):\n        if number % i == 0:\n            return False\n    return True\ndef intersection(interval1: tuple[int, int], interval2: tuple[int, int]) -> str:\n    \"\"\"\n    You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two\n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n    \"\"\"\n    interval1_obj = Interval(interval1[0], interval1[1])\n    interval2_obj = Interval(interval2[0], interval2[1])\n\n    intersection_interval = _calculate_intersection(interval1_obj, interval2_obj)\n\n    if intersection_interval is None:\n        return \"NO\"\n\n    length = _get_interval_length(intersection_interval)\n\n    if _is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"Determines if the length of the intersection of two intervals is a prime number.\n    Returns \"YES\" if prime, \"NO\" otherwise.\"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a given integer n is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(n**0.5) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    def calculate_intersection(int1, int2):\n        \"\"\"Calculates the intersection of two closed intervals.\"\"\"\n        s1, e1 = int1\n        s2, e2 = int2\n        start_intersect = max(s1, s2)\n        end_intersect = min(e1, e2)\n        if start_intersect > end_intersect:\n            return None\n        return (start_intersect, end_intersect)\n\n    def calculate_length(int_val):\n        \"\"\"Calculates the length of a closed interval, or 0 if None.\"\"\"\n        if int_val is None:\n            return 0\n        start, end = int_val\n        return end - start + 1\n\n    intersected_interval = calculate_intersection(interval1, interval2)\n    length = calculate_length(intersected_interval)\n\n    if is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes of integers multiplied by the product of all signs.\n    Returns None for an empty array.\n    \"\"\"\n\n    def _get_sign(number: int) -> int:\n        \"\"\"\n        Determines the sign of a number: 1 for positive, -1 for negative, 0 for zero.\n        \"\"\"\n        if number > 0:\n            return 1\n        elif number < 0:\n            return -1\n        else:\n            return 0\n\n    def _get_magnitude(number: int) -> int:\n        \"\"\"\n        Calculates the absolute value (magnitude) of a number.\n        \"\"\"\n        return abs(number)\n\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for number in arr:\n        product_of_signs *= _get_sign(number)\n        sum_of_magnitudes += _get_magnitude(number)\n\n    return sum_of_magnitudes * product_of_signs"}
{"task_id": "HumanEval/129", "solution": "class Cell:\n    \"\"\"Represents a single cell in the grid.\"\"\"\n    def __init__(self, value: int, row: int, col: int):\n        self.value = value\n        self.row = row\n        self.col = col\n\n    def get_neighbors(self, N: int) -> list[tuple[int, int]]:\n        \"\"\"Returns coordinates of adjacent cells (up, down, left, right).\"\"\"\n        neighbors = []\n        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n        for dr, dc in directions:\n            nr, nc = self.row + dr, self.col + dc\n            neighbors.append((nr, nc)) # Validation deferred to Grid\n        return neighbors\nclass Grid:\n    \"\"\"Represents the square grid of cells.\"\"\"\n    def __init__(self, raw_grid: list[list[int]]):\n        self.N = len(raw_grid)\n        self._cells: list[list[Cell]] = []\n        for r_idx, row_values in enumerate(raw_grid):\n            cell_row = []\n            for c_idx, value in enumerate(row_values):\n                cell_row.append(Cell(value, r_idx, c_idx))\n            self._cells.append(cell_row)\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        \"\"\"Retrieves a Cell object at specified coordinates.\"\"\"\n        return self._cells[row][col]\n\n    def is_valid_coord(self, row: int, col: int) -> bool:\n        \"\"\"Checks if the given coordinates are within grid boundaries.\"\"\"\n        return 0 <= row < self.N and 0 <= col < self.N\nclass Path:\n    \"\"\"Represents a path in the grid as an ordered sequence of cell values.\"\"\"\n    def __init__(self, values: list[int]):\n        self.ordered_values = list(values) # Stores a copy of the path values\n\n    def __lt__(self, other: 'Path') -> bool:\n        \"\"\"Compares two paths lexicographically.\"\"\"\n        return self.ordered_values < other.ordered_values\n\n    def __eq__(self, other: 'Path') -> bool:\n        \"\"\"Compares two paths for equality based on their values.\"\"\"\n        return self.ordered_values == other.ordered_values\nclass GridSolver:\n    \"\"\"Manages the process of finding the minimum path in a grid.\"\"\"\n    def __init__(self):\n        self.all_paths: list[Path] = []\n\n    def _find_paths_dfs(self, grid_obj: Grid, k: int, current_row: int, current_col: int,\n                       current_path_values: list[int]):\n        \"\"\"Recursively finds all paths of length k starting from a given cell.\"\"\"\n        cell = grid_obj.get_cell(current_row, current_col)\n        current_path_values.append(cell.value)\n\n        if len(current_path_values) == k:\n            self.all_paths.append(Path(current_path_values))\n            current_path_values.pop()\n            return\n\n        if len(current_path_values) > k:\n            current_path_values.pop()\n            return\n\n        for nr, nc in cell.get_neighbors(grid_obj.N):\n            if grid_obj.is_valid_coord(nr, nc):\n                self._find_paths_dfs(grid_obj, k, nr, nc, current_path_values)\n\n        current_path_values.pop()\n\n    def minPath(self, grid: list[list[int]], k: int) -> list[int]:\n        \"\"\"Orchestrates path finding and returns the minimum path values.\"\"\"\n        grid_obj = Grid(grid)\n        self.all_paths = [] # Reset for a new path finding operation\n\n        for r in range(grid_obj.N):\n            for c in range(grid_obj.N):\n                self._find_paths_dfs(grid_obj, k, r, c, [])\n\n        min_found_path = min(self.all_paths)\n        return min_found_path.ordered_values\ndef minPath(grid: list[list[int]], k: int) -> list[int]:\n    \"\"\"\n    Given a grid and length k, finds the lexicographically smallest path.\n    This function acts as the public entry point as per the problem statement.\n    \"\"\"\n    solver = GridSolver()\n    return solver.minPath(grid, k)"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n\n    def _extract_and_filter_odd_digits(number):\n        \"\"\"Extracts and filters odd digits from the given number.\"\"\"\n        odd_digits = []\n        for char_digit in str(number):\n            digit = int(char_digit)\n            if digit % 2 != 0:\n                odd_digits.append(digit)\n        return odd_digits\n\n    def _calculate_product(odd_digits_list):\n        \"\"\"Calculates the product of a list of odd digits, returning 0 if empty.\"\"\"\n        if not odd_digits_list:\n            return 0\n        product = 1\n        for digit in odd_digits_list:\n            product *= digit\n        return product\n\n    odd_digits_extracted = _extract_and_filter_odd_digits(n)\n    result_product = _calculate_product(odd_digits_extracted)\n    return result_product"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    product = 1\n    found_odd_digit = False\n\n    # Convert the integer to a string to iterate through its digits.\n    for char_digit in str(n):\n        digit = int(char_digit)\n        if digit % 2 != 0:  # Check if the digit is odd.\n            product *= digit\n            found_odd_digit = True\n\n    # Return 0 if no odd digits were found, otherwise return the calculated product.\n    if not found_odd_digit:\n        return 0\n    else:\n        return product"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the first n+1 numbers of a modified Tribonacci sequence.\n    Uses dynamic programming with two passes to handle forward dependencies.\"\"\"\n    if n < 0:\n        return []\n\n    # Initialize trib_values list of size n + 2 to store tri(0) through tri(n+1)\n    trib_values = [0] * (n + 2)\n\n    # Set initial base cases\n    trib_values[0] = 1\n    if n >= 1:\n        trib_values[1] = 3\n\n    # Pass 1: Calculate all even terms up to n+1\n    for i in range(2, n + 2):\n        if i % 2 == 0:\n            trib_values[i] = 1 + i // 2\n\n    # Pass 2: Calculate all odd terms up to n using previously computed values\n    for i in range(3, n + 1):\n        if i % 2 != 0:\n            trib_values[i] = trib_values[i - 1] + trib_values[i - 2] + trib_values[i + 1]\n\n    # Return the first n+1 elements (from tri(0) to tri(n))\n    return trib_values[:n + 1]"}
{"task_id": "HumanEval/129", "solution": "import heapq\ndef minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically smallest path of length k in the grid.\n    Uses a Dijkstra-like algorithm with a priority queue and dynamic programming.\n    \"\"\"\n    N = len(grid)\n    pq = []  # Min-heap: (path_tuple, row, col)\n    dp = {}  # DP table: (length, row, col) -> path_tuple\n\n    # Initialization: Add all single-cell paths to PQ and DP table\n    for r in range(N):\n        for c in range(N):\n            initial_path = (grid[r][c],)\n            heapq.heappush(pq, (initial_path, r, c))\n            dp[(1, r, c)] = initial_path\n\n    # Main loop for Dijkstra-like traversal\n    while pq:\n        current_path_tuple, r, c = heapq.heappop(pq)\n        current_length = len(current_path_tuple)\n\n        # Pruning step: Skip if a better path to this state has already been found\n        if (current_length, r, c) in dp and current_path_tuple > dp[(current_length, r, c)]:\n            continue\n\n        # Goal check: If path length k is reached, return it\n        if current_length == k:\n            return list(current_path_tuple)\n\n        # Explore neighbors if path is not yet of length k\n        if current_length < k:\n            moves = [(0, 1), (0, -1), (1, 0), (-1, 0)] # Right, Left, Down, Up\n            for dr, dc in moves:\n                nr, nc = r + dr, c + dc\n\n                # Boundary check\n                if 0 <= nr < N and 0 <= nc < N:\n                    new_path_tuple = current_path_tuple + (grid[nr][nc],)\n                    new_length = current_length + 1\n\n                    # DP update: Add to PQ if this new path is better or new\n                    if (new_length, nr, nc) not in dp or new_path_tuple < dp[(new_length, nr, nc)]:\n                        dp[(new_length, nr, nc)] = new_path_tuple\n                        heapq.heappush(pq, (new_path_tuple, nr, nc))"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates and returns a list of the first n + 1 Tribonacci numbers.\n    It defines tri(0) as 1, tri(1) as 3, tri(k) for even k as 1 + k / 2, and tri(k) for odd k as tri(k-1) + tri(k-2) + tri(k+1).\"\"\"\n    memo = {}\n\n    def _get_tribonacci_term_inner(k):\n        \"\"\"Calculates the k-th Tribonacci term using memoization.\n        It handles base cases, even term calculation, and the odd term recurrence with a forward dependency.\"\"\"\n        if k in memo:\n            return memo[k]\n\n        if k == 0:\n            result = 1\n        elif k == 1:\n            result = 3\n        elif k % 2 == 0:  # k is even\n            result = 1 + k // 2\n        else:  # k is odd\n            term_k_minus_1 = _get_tribonacci_term_inner(k - 1)\n            term_k_minus_2 = _get_tribonacci_term_inner(k - 2)\n            term_k_plus_1 = _get_tribonacci_term_inner(k + 1)\n            result = term_k_minus_1 + term_k_minus_2 + term_k_plus_1\n\n        memo[k] = result\n        return result\n\n    sequence = []\n    for k in range(n + 1):\n        sequence.append(_get_tribonacci_term_inner(k))\n\n    return sequence"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Create a function that takes a string as input which contains only square brackets.\n    The function should return True if and only if there is a valid subsequence of brackets\n    where at least one bracket in the subsequence is nested.\n    '''\n    def _is_valid(sub_string):\n        # Checks if a given substring is a valid (balanced) bracket sequence.\n        balance = 0\n        for char in sub_string:\n            if char == '[':\n                balance += 1\n            else: # char == ']'\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    n = len(string)\n    for i in range(n):\n        if string[i] == '[':\n            for j in range(i + 1, n):\n                if string[j] == ']':\n                    # Found a potential outer pair at string[i] and string[j]\n                    inner_content = string[i + 1 : j]\n                    # Check if the content between them is a non-empty, valid bracket sequence\n                    # If it is, then the outer pair [i] and [j] form a nested structure\n                    if len(inner_content) > 0 and _is_valid(inner_content):\n                        return True\n    return False"}
