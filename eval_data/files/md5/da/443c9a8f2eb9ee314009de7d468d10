{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    # Handle empty or single-element lists as monotonically true.\n    if len(l) <= 1:\n        return True\n\n    # Check if the list is monotonically increasing.\n    is_increasing = True\n    for i in range(1, len(l)):\n        if l[i] < l[i-1]:\n            is_increasing = False\n            break\n    if is_increasing:\n        return True\n\n    # Check if the list is monotonically decreasing.\n    is_decreasing = True\n    for i in range(1, len(l)):\n        if l[i] > l[i-1]:\n            is_decreasing = False\n            break\n    if is_decreasing:\n        return True\n\n    # If neither condition is met, the list is not monotonic.\n    return False"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    if not l:\n        raise ValueError(\"Input list cannot be empty\")\n\n    for x in l:\n        if not isinstance(x, (int, float)):\n            raise TypeError(\"List elements must be numeric\")\n\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # For odd length lists, the median is the middle element.\n        return sorted_l[n // 2]\n    else:\n        # For even length lists, the median is the average of the two middle elements.\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2"}
