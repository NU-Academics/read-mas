{"task_id": "HumanEval/94", "solution": "import math\ndef sum_digits(n: int) -> int:\n    \"\"\"Calculates the sum of the digits of a given non-negative integer `n`.\"\"\"\n    digit_sum = 0\n    s_n = str(n)\n    for digit_char in s_n:\n        digit_sum += int(digit_char)\n    return digit_sum\ndef is_prime(n: int) -> bool:\n    \"\"\"Determines if a given integer `n` is a prime number using an optimized algorithm.\"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    for i in range(3, int(math.isqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\ndef skjkasdkd(lst: list[int]) -> int:\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n\n    Examples:\n    For lst = [0,3,2,1,3,5,7,4,5,5,5,2,181,32,4,32,3,2,32,324,4,3] the output should be 10\n    For lst = [1,0,1,8,2,4597,2,1,3,40,1,2,1,2,4,2,5,1] the output should be 25\n    For lst = [1,3,1,32,5107,34,83278,109,163,23,2323,32,30,1,9,3] the output should be 13\n    For lst = [0,724,32,71,99,32,6,0,5,91,83,0,5,6] the output should be 11\n    For lst = [0,81,12,3,1,21] the output should be 3\n    For lst = [0,8,1,2,1,7] the output should be 7\n    \"\"\"\n    max_prime = 0\n    for num in lst:\n        if is_prime(num) and num > max_prime:\n            max_prime = num\n    return sum_digits(max_prime)"}
{"task_id": "HumanEval/94", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"Checks if a number is prime.\n    Returns True if n is prime, False otherwise.\"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef sum_digits(n: int) -> int:\n    \"\"\"Calculates the sum of the digits of an integer.\n    Processes the number by repeatedly taking modulo 10 and dividing by 10.\"\"\"\n    total_sum = 0\n    n = abs(n) # The sum of digits is usually for non-negative numbers, take absolute value.\n    if n == 0:\n        return 0\n    while n > 0:\n        total_sum += n % 10\n        n //= 10\n    return total_sum\ndef _find_largest_prime_in_list(lst: list[int]) -> int | None:\n    \"\"\"Finds the largest prime number in a list.\n    Returns the largest prime or None if no primes are found.\"\"\"\n    largest_prime = None\n    for number in lst:\n        if is_prime(number):\n            if largest_prime is None or number > largest_prime:\n                largest_prime = number\n    return largest_prime\ndef skjkasdkd(lst: list[int]) -> int:\n    \"\"\"Finds the largest prime in a list of integers and returns the sum of its digits.\n    If no prime numbers are found, it returns 0.\"\"\"\n    largest_prime = _find_largest_prime_in_list(lst)\n\n    if largest_prime is None:\n        return 0\n    else:\n        return sum_digits(largest_prime)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Checks if all keys in the dictionary are uniformly either entirely lowercase\n    or entirely uppercase.\n    \"\"\"\n    if not dict:\n        return False\n\n    all_keys_are_lower = True\n    all_keys_are_upper = True\n\n    for key in dict:\n        if not key.islower():\n            all_keys_are_lower = False\n\n        if not key.isupper():\n            all_keys_are_upper = False\n\n    return all_keys_are_lower or all_keys_are_upper"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n: int) -> list[int]:\n    \"\"\"\n    Generates a list of prime numbers strictly less than n.\n    It returns all such primes, respecting the provided examples.\n    \"\"\"\n\n    def _is_prime(num: int) -> bool:\n        \"\"\"Checks if a number is prime.\"\"\"\n        if num < 2:\n            return False\n        # Check for divisibility from 2 up to the square root of num.\n        i = 2\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 1\n        return True\n\n    primes_list = []\n    # Iterate from 2 up to n-1 (strictly less than n).\n    # The range function naturally handles n <= 2 by producing an empty sequence.\n    for i in range(2, n):\n        if _is_prime(i):\n            primes_list.append(i)\n\n    return primes_list"}
