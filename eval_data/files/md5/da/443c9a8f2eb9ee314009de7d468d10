{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Checks if the input string contains a contiguous, balanced bracket subsequence.\n    Returns True if any such subsequence has a nesting depth of 2 or more, False otherwise.\n    '''\n    balance = 0\n    start_index = 0\n\n    for i in range(len(string)):\n        if string[i] == '[':\n            balance += 1\n        elif string[i] == ']':\n            balance -= 1\n\n        if balance == 0:  # Found a potential balanced contiguous subsequence.\n            current_subsequence = string[start_index : i + 1]\n            max_depth_in_sub = 0\n            current_depth_in_sub = 0\n\n            for s_char in current_subsequence:\n                if s_char == '[':\n                    current_depth_in_sub += 1\n                elif s_char == ']':\n                    current_depth_in_sub -= 1\n                max_depth_in_sub = max(max_depth_in_sub, current_depth_in_sub)\n\n            if max_depth_in_sub >= 2:\n                return True\n\n            start_index = i + 1  # Reset start for the next potential subsequence.\n\n        elif balance < 0:  # Invalid segment, reset and start new search.\n            balance = 0\n            start_index = i + 1\n\n    return False"}
{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"Calculates the sum of squared numbers after rounding each element up to its ceiling.\n    The function processes a list of numbers and returns an integer sum.\n    \"\"\"\n    total_sum = 0\n    for num in lst:\n        rounded_num = math.ceil(num)\n        total_sum += rounded_num * rounded_num\n    return int(total_sum)"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an isolated alphabetical character.\n    Returns True if the last character is alphabetical and preceded by a space or is the only character, False otherwise.\n    \"\"\"\n    if not txt:\n        return False\n\n    if len(txt) == 1:\n        return txt[0].isalpha()\n\n    last_char = txt[-1]\n    if not last_char.isalpha():\n        return False\n\n    preceding_char = txt[-2]\n    if preceding_char == ' ':\n        return True\n    else:\n        return False"}
