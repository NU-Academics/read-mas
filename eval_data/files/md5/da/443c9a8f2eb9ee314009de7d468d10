{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    \"\"\"\n\n    def _is_prime(num: int) -> bool:\n        \"\"\"Checks if a given number is prime.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    def _generate_fibonacci_numbers():\n        \"\"\"Generates Fibonacci numbers iteratively, starting from 0, 1, 1, 2...\"\"\"\n        a, b = 0, 1\n        yield a\n        yield b\n        while True:\n            a, b = b, a + b\n            yield b\n\n    def _is_fibonacci(num: int) -> bool:\n        \"\"\"Checks if a given number is a Fibonacci number using a perfect square test.\"\"\"\n        # This helper function is not actively used in the main loop but is defined as per design.\n        if num < 0:\n            return False\n\n        def _is_perfect_square_inline(x: int) -> bool:\n            \"\"\"Checks if a number is a perfect square without using the math module.\"\"\"\n            if x < 0: return False\n            if x == 0: return True\n            low, high = 1, x\n            while low <= high:\\\n                mid = (low + high) // 2"}
{"task_id": "HumanEval/39", "solution": "def _is_perfect_square(num: int) -> bool:\n    \"\"\"Checks if a number is a perfect square without using math.isqrt.\"\"\"\n    if num < 0:\n        return False\n    if num == 0:\n        return True\n    # Calculate integer square root. `int(num**0.5)` might have float precision issues.\n    # Check current guess and its neighbors to account for potential inaccuracies.\n    x = int(num**0.5)\n    return x * x == num or (x + 1) * (x + 1) == num or (x - 1) * (x - 1) == num\ndef is_fibonacci(num: int) -> bool:\n    \"\"\"Determines if a given number is a Fibonacci number using a mathematical test.\"\"\"\n    if num < 0:\n        return False\n    if num == 0:\n        return True\n    # A number `n` is Fibonacci if and only if `5*n^2 + 4` or `5*n^2 - 4` is a perfect square.\n    return _is_perfect_square(5 * num * num + 4) or _is_perfect_square(5 * num * num - 4)\ndef is_prime(num: int) -> bool:\n    \"\"\"Determines if a given number is a prime number using an optimized trial division.\"\"\"\n    if num < 2:\n        return False\n    if num == 2 or num == 3:\n        return True\n    if num % 2 == 0 or num % 3 == 0:\n        return False\n    i = 5\n    while i * i <= num:\n        if num % i == 0 or num % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    found_count = 0\n    current_num = 2  # Start checking from 2 as it's the first prime and Fibonacci number.\n\n    while True:\n        if is_fibonacci(current_num) and is_prime(current_num):\n            found_count += 1\n            if found_count == n:\n                return current_num\n        current_num += 1"}
