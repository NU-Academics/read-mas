{"task_id": "HumanEval/111", "solution": "def count_letter_occurrences(input_str: str) -> dict[str, int]:\n    \"\"\"Counts the occurrences of each lowercase letter in a space-separated string.\n    It returns a dictionary with letters as keys and their counts as values.\n    \"\"\"\n    counts = {}\n    if not input_str:\n        return counts\n\n    words = input_str.split(' ')\n    for word in words:\n        if word:  # Ensure the word is not an empty string from multiple spaces\n            counts[word] = counts.get(word, 0) + 1\n    return counts\ndef identify_most_frequent_letters(letter_counts: dict[str, int]) -> dict[str, int]:\n    \"\"\"Identifies letters with the highest occurrence count from a dictionary of counts.\n    It returns a dictionary containing only the most frequent letters and their counts.\n    \"\"\"\n    most_frequent = {}\n    if not letter_counts:\n        return most_frequent\n\n    max_count = 0\n    # Find the maximum count first\n    for count in letter_counts.values():\n        if count > max_count:\n            max_count = count\n\n    # Collect all letters that match the maximum count\n    for letter, count in letter_counts.items():\n        if count == max_count:\n            most_frequent[letter] = count\n\n    return most_frequent\ndef histogram(test: str) -> dict[str, int]:\n    \"\"\"Given a string representing space-separated lowercase letters, returns a dictionary\n    of the letter with the most repetition and containing the corresponding count.\n    \"\"\"\n    letter_counts = count_letter_occurrences(test)\n    most_frequent_letters = identify_most_frequent_letters(letter_counts)\n    return most_frequent_letters"}
{"task_id": "HumanEval/112", "solution": "def _remove_characters(s: str, c: str) -> str:\n    \"\"\"Removes specified characters from a string.\n    Filters out characters from `s` that are present in `c`.\n    \"\"\"\n    chars_to_remove = set(c)\n    return \"\".join(char for char in s if char not in chars_to_remove)\ndef _is_palindrome(text: str) -> bool:\n    \"\"\"Checks if a string is a palindrome.\n    Compares the string with its reversed version.\n    \"\"\"\n    return text == text[::-1]\ndef reverse_delete(s,c):\n    \"\"\"Task\n    We are given two strings s and c, you have to deleted all the characters in s that are equal to any character in c\n    then check if the result string is palindrome.\n    A string is called palindrome if it reads the same backward as forward.\n    You should return a tuple containing the result string and True/False for the check.\n    Example\n    For s = \"abcde\", c = \"ae\", the result should be ('bcd',False)\n    For s = \"abcdef\", c = \"b\"  the result should be ('acdef',False)\n    For s = \"abcdedcba\", c = \"ab\", the result should be ('cdedc',True)\n    \"\"\"\n    processed_string = _remove_characters(s, c)\n    palindrome_status = _is_palindrome(processed_string)\n    return (processed_string, palindrome_status)"}
{"task_id": "HumanEval/111", "solution": "def histogram(test):\n    \"\"\"Given a string representing a space separated lowercase letters, return a dictionary\n    of the letter with the most repetition and containing the corresponding count.\n    If several letters have the same occurrence, return all of them.\n\n    Example:\n    histogram('a b c') == {'a': 1, 'b': 1, 'c': 1}\n    histogram('a b b a') == {'a': 2, 'b': 2}\n    histogram('a b c a b') == {'a': 2, 'b': 2}\n    histogram('b b b b a') == {'b': 4}\n    histogram('') == {}\n\n    \"\"\"\n    from typing import Dict, List\n\n    def _parse_input(input_string: str) -> List[str]:\n        \"\"\"Splits the input string into a list of individual lowercase letters.\n        Filters out any empty strings resulting from multiple spaces.\n        \"\"\"\n        if not input_string:\n            return []\n        return [s for s in input_string.split(' ') if s]\n\n    def _count_occurrences(letters: List[str]) -> Dict[str, int]:\n        \"\"\"Counts the occurrences of each unique letter in a list of letters.\n        Returns a dictionary mapping each letter to its frequency.\n        \"\"\"\n        counts = {}\n        for letter in letters:\n            counts[letter] = counts.get(letter, 0) + 1\n        return counts\n\n    def _filter_max_occurrences(counts: Dict[str, int]) -> Dict[str, int]:\n        \"\"\"Identifies the maximum occurrence count and filters the letter counts.\n        Includes only those letters that share the highest frequency.\n        \"\"\"\n        if not counts:\n            return {}\n\n        max_count = 0\n        for count in counts.values():\n            if count > max_count:\n                max_count = count\n\n        filtered_counts = {}\n        for letter, count in counts.items():\n            if count == max_count:\n                filtered_counts[letter] = count\n        return filtered_counts\n\n    letters = _parse_input(test)\n    counts = _count_occurrences(letters)\n    result = _filter_max_occurrences(counts)\n    return result"}
{"task_id": "HumanEval/112", "solution": "def _remove_chars(s: str, c: str) -> str:\n    \"\"\"Removes all characters from s that are present in c.\n    Uses a set for efficient character lookup.\n    \"\"\"\n    chars_to_remove = set(c)\n    result_chars = []\n    for char_s in s:\n        if char_s not in chars_to_remove:\n            result_chars.append(char_s)\n    return \"\".join(result_chars)\ndef _is_palindrome(s: str) -> bool:\n    \"\"\"Checks if a string is a palindrome.\n    Compares the string with its reversed version.\n    \"\"\"\n    return s == s[::-1]\ndef reverse_delete(s, c):\n    \"\"\"Deletes characters from s present in c, then checks if the result is a palindrome.\n    Returns the modified string and its palindrome status.\n    \"\"\"\n    modified_s = _remove_chars(s, c)\n    is_palindrome = _is_palindrome(modified_s)\n    return (modified_s, is_palindrome)"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Counts odd digits in each string of a list and formats the output.\n    Each output string indicates the count of odd elements found.\n    \"\"\"\n\n    def _count_odd_digits_in_string(digit_string: str) -> int:\n        \"\"\"Counts the number of odd digits in a given digit string.\n        It iterates through each character and checks if its integer value is odd.\n        \"\"\"\n        odd_digit_count = 0\n        for digit_char in digit_string:\n            if int(digit_char) % 2 != 0:\n                odd_digit_count += 1\n        return odd_digit_count\n\n    def _format_output_string(odd_count_val: int) -> str:\n        \"\"\"Formats an output string using the given odd digit count.\n        The format \"the number of odd elements Cn the strCng C of the Cnput.\" is used.\n        \"\"\"\n        return f\"the number of odd elements {odd_count_val}n the str{odd_count_val}ng {odd_count_val} of the {odd_count_val}nput.\"\n\n    result_list = []\n    for input_string in lst:\n        odd_digit_count = _count_odd_digits_in_string(input_string)\n        formatted_string = _format_output_string(odd_digit_count)\n        result_list.append(formatted_string)\n\n    return result_list"}
{"task_id": "HumanEval/107", "solution": "def is_palindrome(num: int) -> bool:\n    \"\"\"Checks if an integer is a palindrome by comparing its string representation with its reverse.\"\"\"\n    s = str(num)\n    return s == s[::-1]\ndef is_even(num: int) -> bool:\n    \"\"\"Determines if an integer is even.\"\"\"\n    return num % 2 == 0\ndef even_odd_palindrome(n: int) -> tuple[int, int]:\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # The design specifies validation 1 <= n <= 1000,\n    # but critical requirements forbid raising exceptions or checks for edge cases.\n    # We proceed assuming n is valid as per \"trust the caller's inputs.\"\n\n    for i in range(1, n + 1):\n        if is_palindrome(i):\n            if is_even(i):\n                even_count += 1\n            else:\n                odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Counts odd digits in strings and formats output.\n    Processes a list of digit strings to produce a list of formatted count messages.\n    \"\"\"\n\n    def _is_digit_string(s):\n        \"\"\"Checks if a string consists solely of digits.\n        Returns True if all characters are digits, False otherwise.\n        \"\"\"\n        return s.isdigit()\n\n    def _count_odd_digits_in_string(s):\n        \"\"\"Counts the number of odd digits in a given digit string.\n        Iterates through the string, converting chars to int and checking parity.\n        \"\"\"\n        odd_digits = 0\n        for char_digit in s:\n            digit = int(char_digit)\n            if digit % 2 != 0:\n                odd_digits += 1\n        return odd_digits\n\n    def _format_output_string(odd_count_val):\n        \"\"\"Formats the final output string with the given odd digit count.\n        Replaces 'i' in the base phrase with the calculated odd digit count.\n        \"\"\"\n        base_phrase = \"the number of odd elements in the string i of the input.\"\n        return base_phrase.replace('i', str(odd_count_val))\n\n    results = []\n    for input_string in lst:\n        # Per critical requirements, inputs are trusted to be valid digit strings.\n        # The _is_digit_string check is included as per design, assuming it will pass for given inputs.\n        if _is_digit_string(input_string):\n            odd_count_val = _count_odd_digits_in_string(input_string)\n            formatted_string = _format_output_string(odd_count_val)\n            results.append(formatted_string)\n\n    return results"}
{"task_id": "HumanEval/114", "solution": "class IntegerArray:\n    \"\"\"\n    Encapsulates a list of integers.\n    \"\"\"\n    def __init__(self, nums: list[int]):\n        \"\"\"Initializes with the given list of integers.\"\"\"\n        self.elements = nums\n\n    def getElements(self) -> list[int]:\n        \"\"\"Returns the stored list of elements.\"\"\"\n        return self.elements\nclass SubArray:\n    \"\"\"\n    Represents a non-empty sub-array and calculates its sum upon instantiation.\n    \"\"\"\n    def __init__(self, elements: list[int]):\n        \"\"\"Initializes with elements and calculates the sum.\"\"\"\n        self.elements = elements\n        self.sum = self._calculateSum()\n\n    def getElements(self) -> list[int]:\n        \"\"\"Returns the elements of the sub-array.\"\"\"\n        return self.elements\n\n    def getSum(self) -> int:\n        \"\"\"Returns the calculated sum of the sub-array.\"\"\"\n        return self.sum\n\n    def _calculateSum(self) -> int:\n        \"\"\"Calculates the sum of the sub-array's elements.\"\"\"\n        return sum(self.elements)\nclass MinimumSumCalculator:\n    \"\"\"\n    Calculates the minimum sum among all non-empty sub-arrays of an IntegerArray.\n    \"\"\"\n    def findMinimumSubArraySum(self, integerArray: IntegerArray) -> int:\n        \"\"\"\n        Iterates through all sub-arrays, creates SubArray objects,\n        and finds the minimum sum.\n        \"\"\"\n        all_elements = integerArray.getElements()\n        n = len(all_elements)\n        min_sum = float('inf') # Initialize with a very large number\n\n        for start_index in range(n):\n            for end_index in range(start_index, n):\n                sub_array_elements = all_elements[start_index : end_index + 1]\n                sub_array_instance = SubArray(sub_array_elements)\n                current_sub_array_sum = sub_array_instance.getSum()\n                min_sum = min(min_sum, current_sub_array_sum)\n\n        return int(min_sum)\ndef minSubArraySum(nums: list[int]) -> int:\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array\n    of nums.\n    \"\"\"\n    integer_array = IntegerArray(nums)\n    calculator = MinimumSumCalculator()\n    min_sum = calculator.findMinimumSubArraySum(integer_array)\n    return min_sum"}
