{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    integer_part = int(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separates groups of nested parentheses from a string, returning them as a list.\n    Each group is balanced, not nested within others, and spaces are ignored.\n    \"\"\"\n    cleaned_string = paren_string.replace(\" \", \"\")\n    result_groups: List[str] = []\n    balance_counter = 0\n    start_index = 0\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            balance_counter += 1\n        elif char == ')':\n            balance_counter -= 1\n\n        # If balance returns to 0, a top-level balanced group is found.\n        if balance_counter == 0:\n            group = cleaned_string[start_index : i + 1]\n            result_groups.append(group)\n            start_index = i + 1\n        # If balance drops below 0, it indicates an invalid closing parenthesis.\n        # Reset counter and start a new potential group from the next character.\n        elif balance_counter < 0:\n            balance_counter = 0\n            start_index = i + 1\n\n    return result_groups"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"\n    Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    for i in range(len(numbers)):\n        for j in range(i + 1, len(numbers)):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef _clean_string(input_string: str) -> str:\n    \"\"\"Removes all spaces from the input string.\"\"\"\n    return input_string.replace(\" \", \"\")\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separates multiple groups of nested parentheses into a list of separate, balanced strings.\"\"\"\n    cleaned_string = _clean_string(paren_string)\n\n    result_groups = []\n    current_group_chars = []\n    balance_counter = 0\n\n    for char in cleaned_string:\n        current_group_chars.append(char)\n        if char == '(':\n            balance_counter += 1\n        elif char == ')':\n            balance_counter -= 1\n\n        # A group ends when the balance returns to zero.\n        if balance_counter == 0:\n            result_groups.append(\"\".join(current_group_chars))\n            current_group_chars = []\n\n    return result_groups"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"Check if any two numbers in the list are closer than the given threshold.\n    It iterates through distinct pairs and compares their absolute difference.\n    \"\"\"\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'.\n    Returns a new list with the delimiter inserted.\n    \"\"\"\n    if not numbers:\n        return []\n\n    result_list: List[int] = []\n    for i, num in enumerate(numbers):\n        result_list.append(num)\n        if i < len(numbers) - 1:\n            result_list.append(delimeter)\n\n    return result_list"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    total_sum = sum(numbers)\n    count = len(numbers)\n\n    # Calculate the mean of the input numbers\n    # This will raise ZeroDivisionError if the list is empty, per design spec and NFRs\n    mean = total_sum / count\n\n    # Calculate the sum of absolute differences from the mean\n    absolute_differences_sum = 0.0\n    for number in numbers:\n        absolute_differences_sum += abs(number - mean)\n\n    # Calculate the average of these absolute differences\n    mad = absolute_differences_sum / count\n\n    return mad"}
{"task_id": "HumanEval/7", "solution": "from typing import List\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    result_list = []\n    if not strings:\n        return result_list\n\n    for s in strings:\n        if substring in s:\n            result_list.append(s)\n\n    return result_list"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef _calculate_group_nesting_level(group_string: str) -> int:\n    \"\"\"Calculates the deepest nesting level for a single parentheses group.\n    Tracks current and maximum depth during iteration.\n    \"\"\"\n    max_depth = 0\n    current_depth = 0\n    for char in group_string:\n        if char == '(':\n            current_depth += 1\n            max_depth = max(max_depth, current_depth)\n        elif char == ')':\n            current_depth -= 1\n    return max_depth\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Input is a string with multiple groups for nested parentheses separated by spaces.\n    Outputs the deepest nesting level for each group as a list of integers.\n    \"\"\"\n    groups = paren_string.split(' ')\n    nesting_levels = []\n\n    for group_string in groups:\n        nesting_levels.append(_calculate_group_nesting_level(group_string))\n\n    return nesting_levels"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"Inserts a number 'delimeter' between every two consecutive elements of input list `numbers`.\n    Handles empty and single-element lists as specified.\n    \"\"\"\n    if not numbers:\n        return []\n    if len(numbers) == 1:\n        return numbers[:]\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"Calculates the Mean Absolute Deviation (MAD) for a list of floats around their mean.\n    MAD is the average absolute difference between each number and the dataset's mean.\n    \"\"\"\n\n    # Helper function: Calculates the arithmetic mean of a list of numbers.\n    def _calculate_mean(nums: List[float]) -> float:\n        return sum(nums) / len(nums)\n\n    # Helper function: Calculates absolute differences from the mean for each number.\n    def _calculate_absolute_differences(nums: List[float], mean_value: float) -> List[float]:\n        return [abs(x - mean_value) for x in nums]\n\n    # Handle edge cases for empty or single-element lists as per NFR4 and NFR5.\n    if len(numbers) <= 1:\n        return 0.0\n\n    # Calculate the mean of the input list (FR2).\n    mean_value = _calculate_mean(numbers)\n\n    # Calculate absolute differences from the mean (FR3).\n    absolute_differences = _calculate_absolute_differences(numbers, mean_value)\n\n    # Calculate the average of these absolute differences (FR4).\n    mad_value = sum(absolute_differences) / len(absolute_differences)\n\n    # Return the final calculated Mean Absolute Deviation (FR5).\n    return mad_value"}
{"task_id": "HumanEval/7", "solution": "from typing import List\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filters a list of strings to include only those containing the specified substring.\n    The filtering is case-sensitive, and a new list is returned without modifying the original.\n    \"\"\"\n    filtered_list = []\n    for s in strings:\n        if substring in s:\n            filtered_list.append(s)\n    return filtered_list"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n\n    for number in numbers:\n        total_sum += number\n        total_product *= number\n\n    return (total_sum, total_product)"}
{"task_id": "HumanEval/9", "solution": "from typing import List\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    \"\"\"\n    if not numbers:\n        return []\n\n    result_list = []\n    current_max = numbers[0]\n\n    for number in numbers:\n        current_max = max(current_max, number)\n        result_list.append(current_max)\n\n    return result_list"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\"Calculates the sum and product of a list of integers. Returns (0, 1) for an empty list.\"\"\"\n    current_sum = 0\n    current_product = 1\n\n    if not numbers:\n        return current_sum, current_product\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return current_sum, current_product"}
{"task_id": "HumanEval/9", "solution": "from typing import List\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    current_max = float('-inf')\n    result = []\n    for num in numbers:\n        current_max = max(current_max, num)\n        result.append(current_max)\n    return result"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome. \"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome by appending to the string.\n    It finds the longest palindromic suffix and prepends the reverse of the remaining prefix.\n    \"\"\"\n    if not string:\n        return \"\"\n\n    longest_palindromic_postfix_start_index = 0\n    for i in range(len(string)):\n        postfix = string[i:]\n        if is_palindrome(postfix):\n            longest_palindromic_postfix_start_index = i\n            break\n\n    prefix_to_reverse = string[:longest_palindromic_postfix_start_index]\n    reversed_prefix = prefix_to_reverse[::-1]\n\n    return string + reversed_prefix"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    n = len(string)\n    for i in range(n, -1, -1):\n        suffix = string[i:]\n        if (string == string[::-1]):\n            return string\n        if suffix == suffix[::-1]:\n            prefix_to_reverse = string[:i]\n            return string + prefix_to_reverse[::-1]\n    return string"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n\n    def _perform_char_xor(char_a: str, char_b: str) -> str:\n        \"\"\"Performs binary XOR on two single binary characters.\n        Returns '0' if characters are identical, '1' otherwise.\n        \"\"\"\n        if char_a == char_b:\n            return '0'\n        else:\n            return '1'\n\n    # Per critical requirements, validation and exception raising for invalid\n    # input characters or differing lengths are omitted. Inputs are trusted.\n\n    result_chars = []\n    # Assume equal lengths based on critical requirements to trust caller's inputs.\n    for i in range(len(a)):\n        result_chars.append(_perform_char_xor(a[i], b[i]))\n\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\"Performs character-by-character binary XOR operation on two input strings.\n    The inputs are assumed to be equal length and consist only of '0's and '1's.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    result = []\n    for i in range(len(a)):\n        xor_result = str(int(a[i]) ^ int(b[i]))\n        result.append(xor_result)\n    return \"\".join(result)"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\"Return a greatest common divisor of two integers a and b using the Euclidean algorithm.\n    It returns the absolute value of the GCD.\"\"\"\n    a = abs(a)\n    b = abs(b)\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_so_far = None\n    max_length = -1\n\n    for current_string in strings:\n        current_length = len(current_string)\n        if current_length > max_length:\n            max_length = current_length\n            longest_so_far = current_string\n\n    return longest_so_far"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    while b:\n        a, b = b, a % b\n    return abs(a)"}
