{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    n = len(l)\n    if n <= 1:\n        return True\n\n    is_increasing = True\n    for i in range(1, n):\n        if l[i] < l[i-1]:\n            is_increasing = False\n            break\n\n    is_decreasing = True\n    for i in range(1, n):\n        if l[i] > l[i-1]:\n            is_decreasing = False\n            break\n\n    return is_increasing or is_decreasing"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    Identifies common elements, ensures uniqueness, and sorts them in ascending order.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n\n    \"\"\"\n    # Convert lists to sets to find common elements and ensure uniqueness.\n    # Then find the intersection of the two sets.\n    common_elements_set = set(l1) & set(l2)\n\n    # Convert the set of common elements to a list and sort it.\n    sorted_common_elements = sorted(list(common_elements_set))\n\n    return sorted_common_elements"}
