{"task_id": "HumanEval/36", "solution": "def _is_divisible_by_11_or_13(num: int) -> bool:\n    \"\"\"Checks if a number is divisible by 11 or 13.\n    Returns True if divisible by either, False otherwise.\"\"\"\n    return num % 11 == 0 or num % 13 == 0\ndef _count_digit_in_number(num: int, digit: int) -> int:\n    \"\"\"Counts occurrences of a specific digit within a given number.\n    Converts the number and digit to strings for counting.\"\"\"\n    return str(num).count(str(digit))\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    This orchestrates helper functions for divisibility checks and digit counting.\"\"\"\n    total_sevens = 0\n    for i in range(1, n):\n        if _is_divisible_by_11_or_13(i):\n            total_sevens += _count_digit_in_number(i, 7)\n    return total_sevens"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    Takes an encoded string and reverses the cyclic shift for groups of three characters.\n    Leaves smaller groups unchanged.\n    \"\"\"\n\n    def _group_into_threes(input_str: str) -> list[str]:\n        \"\"\"Splits the input string into groups of three characters.\"\"\"\n        return [input_str[(3 * i):min((3 * i + 3), len(input_str))] for i in range((len(input_str) + 2) // 3)]\n\n    def _reverse_cyclic_shift(group: str) -> str:\n        \"\"\"Performs the reverse cyclic shift for a three-character group.\"\"\"\n        return group[-1] + group[:-1]\n\n    groups = _group_into_threes(s)\n    decoded_groups = []\n    for group in groups:\n        if len(group) == 3:\n            decoded_groups.append(_reverse_cyclic_shift(group))\n        else:\n            decoded_groups.append(group)\n\n    return \"\".join(decoded_groups)"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    output_list = list(l) # Create a copy to ensure the original list is not mutated.\n\n    even_indexed_elements = [l[i] for i in range(0, len(l), 2)]\n    even_indexed_elements.sort() # Extract and sort elements from even indices.\n\n    sorted_element_index = 0\n    for i in range(0, len(output_list), 2): # Iterate through even indices of the output list.\n        output_list[i] = even_indexed_elements[sorted_element_index]\n        sorted_element_index += 1\n    return output_list"}
