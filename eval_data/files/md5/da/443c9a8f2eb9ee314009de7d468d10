{"task_id": "HumanEval/141", "solution": "class FileName:\n    def __init__(self, name: str):\n        \"\"\"Initializes FileName with the given name string.\"\"\"\n        self.name_string = name\n        self.prefix = None\n        self.extension = None\n\n    def _parse_name(self):\n        \"\"\"Splits the name string into prefix and extension.\"\"\"\n        # This method is called after validate_dot_count ensures exactly one dot.\n        parts = self.name_string.split('.', 1)\n        self.prefix = parts[0]\n        self.extension = parts[1]\n\n    def validate_digits(self) -> bool:\n        \"\"\"Counts digits in the name string; must not exceed three.\"\"\"\n        digit_count = sum(1 for char in self.name_string if char.isdigit())\n        return digit_count <= 3\n\n    def validate_dot_count(self) -> bool:\n        \"\"\"Checks if the file name contains exactly one dot.\"\"\"\n        return self.name_string.count('.') == 1\n\n    def validate_prefix_not_empty(self) -> bool:\n        \"\"\"Checks if the prefix substring is not empty.\"\"\"\n        return bool(self.prefix)\n\n    def validate_prefix_start_char(self) -> bool:\n        \"\"\"Checks if the prefix starts with a latin alphabet letter.\"\"\"\n        # Assumes prefix is not empty, as validated by validate_prefix_not_empty.\n        return self.prefix[0].isalpha()\n\n    def validate_extension(self) -> bool:\n        \"\"\"Checks if the extension is one of ['txt', 'exe', 'dll'].\"\"\"\n        allowed_extensions = ['txt', 'exe', 'dll']\n        return self.extension in allowed_extensions\n\n    def is_valid(self) -> bool:\n        \"\"\"Orchestrates all validation checks; returns True if all pass, False otherwise.\"\"\"\n        if not self.validate_dot_count():\n            return False\n\n        self._parse_name() # Set prefix and extension after dot count is confirmed.\n\n        if not self.validate_digits():\n            return False\n        if not self.validate_prefix_not_empty():\n            return False\n        if not self.validate_prefix_start_char():\n            return False\n        if not self.validate_extension():\n            return False\n\n        return True\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions\n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from\n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n    file_obj = FileName(file_name)\n    if file_obj.is_valid():\n        return 'Yes'\n    else:\n        return 'No'"}
{"task_id": "HumanEval/141", "solution": "class FileName:\n    \"\"\"Encapsulates file name properties for validation.\"\"\"\n    def __init__(self, name: str):\n        self._name = name\n        self._dot_count = name.count('.')\n\n        parts = name.split('.', 1)\n        self._prefix = parts[0] if parts else \"\"\n        self._extension = parts[1] if len(parts) > 1 else \"\"\n\n        self._digit_count = sum(1 for char in name if '0' <= char <= '9')\n\n        self._starts_with_latin_letter = False\n        if self._prefix:\n            first_char = self._prefix[0]\n            if ('a' <= first_char <= 'z') or ('A' <= first_char <= 'Z'):\n                self._starts_with_latin_letter = True\n\n    def getPrefix(self) -> str:\n        \"\"\"Returns the substring before the first dot.\"\"\"\n        return self._prefix\n\n    def getExtension(self) -> str:\n        \"\"\"Returns the substring after the first dot.\"\"\"\n        return self._extension\n\n    def getDigitCount(self) -> int:\n        \"\"\"Returns the total number of digits in the file name.\"\"\"\n        return self._digit_count\n\n    def getDotCount(self) -> int:\n        \"\"\"Returns the total number of dots in the file name.\"\"\"\n        return self._dot_count\n\n    def startsWithLatinLetter(self) -> bool:\n        \"\"\"Checks if the prefix starts with a Latin letter.\"\"\"\n        return self._starts_with_latin_letter\nclass ValidationRule:\n    \"\"\"Abstract base class for file name validation rules.\"\"\"\n    def apply(self, fileName: FileName) -> bool:\n        \"\"\"Applies the validation rule to the FileName object.\"\"\"\n        raise NotImplementedError(\"Subclasses must implement apply method.\")\nclass MaxDigitsRule(ValidationRule):\n    \"\"\"Ensures the file name contains no more than three digits.\"\"\"\n    def apply(self, fileName: FileName) -> bool:\n        return fileName.getDigitCount() <= 3\nclass ExactlyOneDotRule(ValidationRule):\n    \"\"\"Ensures the file name contains exactly one dot.\"\"\"\n    def apply(self, fileName: FileName) -> bool:\n        return fileName.getDotCount() == 1\nclass PrefixNotEmptyRule(ValidationRule):\n    \"\"\"Ensures the substring before the dot is not empty.\"\"\"\n    def apply(self, fileName: FileName) -> bool:\n        return bool(fileName.getPrefix())\nclass PrefixStartsLetterRule(ValidationRule):\n    \"\"\"Ensures the substring before the dot starts with a Latin letter.\"\"\"\n    def apply(self, fileName: FileName) -> bool:\n        return fileName.startsWithLatinLetter()\nclass ValidExtensionRule(ValidationRule):\n    \"\"\"Ensures the file extension is one of the allowed types.\"\"\"\n    _ALLOWED_EXTENSIONS = ['txt', 'exe', 'dll']\n    def apply(self, fileName: FileName) -> bool:\n        return fileName.getExtension() in self._ALLOWED_EXTENSIONS\ndef file_name_check(file_name):\n    \"\"\"Checks if a file's name is valid based on predefined rules.\n    Returns 'Yes' if valid, 'No' otherwise.\"\"\"\n\n    file_name_obj = FileName(file_name)\n\n    rules = [\n        MaxDigitsRule(),\n        ExactlyOneDotRule(),\n        PrefixNotEmptyRule(),\n        PrefixStartsLetterRule(),\n        ValidExtensionRule()\n    ]\n\n    for rule in rules:\n        if not rule.apply(file_name_obj):\n            return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst: list[int]) -> int:\n    \"\"\"\n    This function processes a list of integers, applying transformations based on index rules.\n    It returns the sum of all entries after applying these transformations.\n    \"\"\"\n    if not lst:\n        return 0\n\n    processed_values = []\n    for i, num in enumerate(lst):\n        transformed_value = num\n        if i % 3 == 0:\n            transformed_value = num ** 2\n        elif i % 4 == 0:\n            transformed_value = num ** 3\n        processed_values.append(transformed_value)\n\n    return sum(processed_values)"}
{"task_id": "HumanEval/142", "solution": "def _process_entry(value: int, index: int) -> int:\n    \"\"\"A private helper function that applies transformation rules to a single integer entry based on its index.\n    It returns the transformed (squared, cubed, or original) integer value.\n    \"\"\"\n    if index % 3 == 0:\n        return value * value\n    elif index % 4 == 0:  # and index % 3 != 0 is implicitly handled by the 'elif'\n        return value * value * value\n    else:\n        return value\ndef sum_squares(lst: list[int]) -> int:\n    \"\"\"Calculates the sum of processed integer entries in a list based on their indices.\n    Returns 0 if the input list is empty.\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for index, value in enumerate(lst):\n        processed_value = _process_entry(value, index)\n        total_sum += processed_value\n    return total_sum"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"Extracts words with prime lengths from a sentence.\n    Words are returned in original order, separated by spaces.\"\"\"\n\n    def is_prime(number: int) -> bool:\n        \"\"\"Checks if a number is prime.\n        Returns True if prime, False otherwise.\"\"\"\n        if number < 2:\n            return False\n        i = 2\n        while i * i <= number:\n            if number % i == 0:\n                return False\n            i += 1\n        return True\n\n    result_words = []\n    words = sentence.split(' ')\n    for word in words:\n        if word: # Ensure we only process non-empty words\n            if is_prime(len(word)):\n                result_words.append(word)\n    return ' '.join(result_words)"}
{"task_id": "HumanEval/143", "solution": "def is_prime(n):\n    \"\"\"Checks if a number is prime. Handles edge cases for numbers less than 2 and iterates up to the square root of n.\"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            return False\n    return True\ndef words_in_sentence(sentence):\n    \"\"\"Filters words from a sentence, keeping only those whose lengths are prime numbers.\"\"\"\n    filtered_words = []\n    words = sentence.split()\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n    return \" \".join(filtered_words)"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"\n    Evaluates the product of two fractions x and n, and determines if the result is a whole number.\n    Each fraction is a string in \"<numerator>/<denominator>\" format.\n    \"\"\"\n\n    def _gcd(a, b):\n        \"\"\"Calculates the greatest common divisor (GCD) of two integers using the Euclidean algorithm.\"\"\"\n        while b:\n            a, b = b, a % b\n        return a\n\n    def _parse_fraction_string(fraction_string):\n        \"\"\"Parses a fraction string into its (numerator, denominator) integer components.\"\"\"\n        parts = fraction_string.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return numerator, denominator\n\n    def _simplify_fraction(numerator, denominator):\n        \"\"\"Simplifies a fraction (num, den) to its lowest terms using GCD.\"\"\"\n        common_divisor = _gcd(numerator, denominator)\n        return numerator // common_divisor, denominator // common_divisor\n\n    # Parse input fractions\n    x_numerator, x_denominator = _parse_fraction_string(x)\n    n_numerator, n_denominator = _parse_fraction_string(n)\n\n    # Calculate the product of the two fractions\n    product_numerator = x_numerator * n_numerator\n    product_denominator = x_denominator * n_denominator\n\n    # Simplify the product fraction\n    _, simplified_denominator = _simplify_fraction(product_numerator, product_denominator)\n\n    # Determine if the simplified product is a whole number (denominator is 1)\n    return simplified_denominator == 1"}
{"task_id": "HumanEval/144", "solution": "def _gcd(a: int, b: int) -> int:\n    \"\"\"Calculates the greatest common divisor of two integers using the Euclidean algorithm.\"\"\"\n    while b:\n        a, b = b, a % b\n    return a\nclass Fraction:\n    \"\"\"Encapsulates fraction data and provides arithmetic/utility operations.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        self._numerator = numerator\n        self._denominator = denominator\n        self._simplify_self()\n\n    @property\n    def numerator(self) -> int:\n        \"\"\"Read-only access to the numerator.\"\"\"\n        return self._numerator\n\n    @property\n    def denominator(self) -> int:\n        \"\"\"Read-only access to the denominator.\"\"\"\n        return self._denominator\n\n    @staticmethod\n    def parse(fraction_string: str) -> 'Fraction':\n        \"\"\"Parses a string \"N/D\" into a Fraction object.\"\"\"\n        parts = fraction_string.split('/')\n        num = int(parts[0])\n        den = int(parts[1])\n        return Fraction(num, den)\n\n    def multiply(self, other: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another fraction, returning a new simplified Fraction.\"\"\"\n        new_numerator = self._numerator * other._numerator\n        new_denominator = self._denominator * other._denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Checks if the fraction represents a whole number (simplified denominator is 1).\"\"\"\n        return self._denominator == 1\n\n    def _simplify_self(self) -> None:\n        \"\"\"Reduces the fraction to its lowest terms by dividing by their GCD.\"\"\"\n        common_divisor = _gcd(self._numerator, self._denominator)\n        self._numerator //= common_divisor\n        self._denominator //= common_divisor\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"Determines if the product of two fractions, x and n, is a whole number.\"\"\"\n    fraction_x = Fraction.parse(x)\n    fraction_n = Fraction.parse(n)\n    product_fraction = fraction_x.multiply(fraction_n)\n    return product_fraction.is_whole_number()"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers by the sum of their digits, maintaining original order for ties.\n    \"\"\"\n    if not nums:\n        return []\n\n    def _calculate_digit_sum(number: int) -> int:\n        \"\"\"Calculates the sum of the absolute digits of a number.\"\"\"\n        s = str(abs(number))\n        return sum(int(digit) for digit in s)\n\n    # Create a list of tuples: (digit_sum, original_index, value)\n    # This structure allows for stable sorting based on digit_sum primarily,\n    # and original_index secondarily to preserve relative order for ties.\n    decorated_list = []\n    for index, value in enumerate(nums):\n        digit_sum = _calculate_digit_sum(value)\n        decorated_list.append((digit_sum, index, value))\n\n    # Sort the decorated list. Python's sorted() is stable and\n    # sorts tuples element-wise, fulfilling the requirements.\n    decorated_list.sort()\n\n    # Extract the original values from the sorted list\n    sorted_values = [item[2] for item in decorated_list]\n\n    return sorted_values"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"Sorts integers by digit sum then original index.\"\"\"\n\n    def _calculate_digit_sum(num: int) -> int:\n        \"\"\"Calculates the sum of the absolute value of digits for an integer.\"\"\"\n        return sum(int(digit) for digit in str(abs(num)))\n\n    class SortableItem:\n        \"\"\"Encapsulates an integer, its original index, and digit sum for custom sorting.\"\"\"\n        def __init__(self, value: int, original_index: int, digit_sum: int):\n            self.value = value\n            self.original_index = original_index\n            self.digit_sum = digit_sum\n\n        def __lt__(self, other: 'SortableItem') -> bool:\n            \"\"\"Compares SortableItem objects based on digit sum, then original index.\"\"\"\n            if self.digit_sum != other.digit_sum:\n                return self.digit_sum < other.digit_sum\n            return self.original_index < other.original_index\n\n    if not nums:\n        return []\n\n    sortable_items = []\n    for index, num in enumerate(nums):\n        digit_sum = _calculate_digit_sum(num)\n        sortable_items.append(SortableItem(num, index, digit_sum))\n\n    sortable_items.sort()\n\n    return [item.value for item in sortable_items]"}
{"task_id": "HumanEval/146", "solution": "def _is_odd(digit: int) -> bool:\n    \"\"\"Checks if a digit is odd.\"\"\"\n    return digit % 2 != 0\ndef _is_greater_than_ten(num: int) -> bool:\n    \"\"\"Checks if a number is greater than 10.\"\"\"\n    return num > 10\ndef _get_first_digit(num: int) -> int:\n    \"\"\"Extracts the first digit of a number (absolute value).\"\"\"\n    return int(str(abs(num))[0])\ndef _get_last_digit(num: int) -> int:\n    \"\"\"Extracts the last digit of a number (absolute value).\"\"\"\n    return int(str(abs(num))[-1])\ndef specialFilter(nums: list[int]) -> int:\n    \"\"\"Filters an array of numbers based on specific criteria and returns a count.\n    Numbers must be greater than 10, with an odd first digit and an odd last digit.\n    \"\"\"\n    count = 0\n    for num in nums:\n        is_gt_10 = _is_greater_than_ten(num)\n\n        first_digit = _get_first_digit(num)\n        is_first_odd = _is_odd(first_digit)\n\n        last_digit = _get_last_digit(num)\n        is_last_odd = _is_odd(last_digit)\n\n        if is_gt_10 and is_first_odd and is_last_odd:\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/146", "solution": "def _is_greater_than_ten(num: int) -> bool:\n    \"\"\"Checks if a number is strictly greater than 10.\"\"\"\n    return num > 10\ndef _get_first_digit(num: int) -> int:\n    \"\"\"Extracts the first digit of the absolute value of a number.\n    Handles single-digit numbers by returning the digit itself.\n    \"\"\"\n    abs_num = abs(num)\n    if abs_num == 0:\n        return 0\n    while abs_num >= 10:\n        abs_num //= 10\n    return abs_num\ndef _get_last_digit(num: int) -> int:\n    \"\"\"Extracts the last digit of the absolute value of a number.\"\"\"\n    return abs(num) % 10\ndef _is_odd(digit: int) -> bool:\n    \"\"\"Determines if a digit is odd (1, 3, 5, 7, 9).\"\"\"\n    return digit in {1, 3, 5, 7, 9}\ndef specialFilter(nums: list[int]) -> int:\n    \"\"\"Filters an array of numbers and counts those meeting specific criteria.\n    Numbers must be greater than 10 with both first and last digits being odd.\n    \"\"\"\n    count = 0\n    for num in nums:\n        if _is_greater_than_ten(num):\n            first_digit = _get_first_digit(num)\n            last_digit = _get_last_digit(num)\n\n            if _is_odd(first_digit) and _is_odd(last_digit):\n                count += 1\n    return count"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n: int) -> int:\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n\n    Example :\n        Input: n = 5\n        Output: 1\n        Explanation:\n        a = [1, 3, 7, 13, 21]\n        The only valid triple is (1, 7, 13).\n    \"\"\"\n    def _generate_array_a(n: int) -> list[int]:\n        \"\"\"Generates array 'a' where a[i] = i*i - i + 1 for 1 <= i <= n.\"\"\"\n        a = [0] * (n + 1)  # Array is 1-indexed to match problem description.\n        for i in range(1, n + 1):\n            a[i] = i * i - i + 1\n        return a\n\n    def _is_multiple_of_3(num: int) -> bool:\n        \"\"\"Checks if a given number is a multiple of 3 using the modulo operator.\"\"\"\n        return num % 3 == 0\n\n    a = _generate_array_a(n)\n    count = 0\n\n    # Iterate through all unique combinations of indices (i, j, k)\n    # following the condition 1 <= i < j < k <= n.\n    for i in range(1, n - 1):\n        for j in range(i + 1, n):\n            for k in range(j + 1, n + 1):\n                current_sum = a[i] + a[j] + a[k]\n                if _is_multiple_of_3(current_sum):\n                    count += 1\n    return count"}
{"task_id": "HumanEval/148", "solution": "class Planet:\n    \"\"\"Represents a single planet with its name and orbital order.\"\"\"\n    def __init__(self, name: str, orbital_order: int):\n        self.name = name\n        self.orbital_order = orbital_order\nclass SolarSystem:\n    \"\"\"Manages the collection of planets and provides methods to access and query them.\"\"\"\n    def __init__(self):\n        # The predefined list of planets, ordered by proximity to the sun.\n        planet_names = [\n            \"Mercury\", \"Venus\", \"Earth\", \"Mars\",\n            \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n        ]\n        self._planets: list[Planet] = []\n        self._planet_map: dict[str, Planet] = {}\n\n        for i, name in enumerate(planet_names):\n            planet = Planet(name, i)\n            self._planets.append(planet)\n            self._planet_map[name] = planet\n\n    def get_planet_by_name(self, name: str) -> Planet | None:\n        \"\"\"Returns a Planet object by name, or None if not found.\"\"\"\n        return self._planet_map.get(name)\n\n    def get_planets_between(self, planet1: Planet, planet2: Planet) -> list[Planet]:\n        \"\"\"Returns planets strictly between planet1 and planet2, sorted by orbital order.\"\"\"\n        min_order = min(planet1.orbital_order, planet2.orbital_order)\n        max_order = max(planet1.orbital_order, planet2.orbital_order)\n\n        between_planets = [\n            p for p in self._planets\n            if min_order < p.orbital_order < max_order\n        ]\n        return between_planets\n_solar_system = SolarSystem()\ndef bf(planet1: str, planet2: str) -> tuple[str, ...]:\n    \"\"\"Finds planets located strictly between the orbits of two specified planets.\n    Returns an empty tuple if any input planet name is invalid.\"\"\"\n    p1 = _solar_system.get_planet_by_name(planet1)\n    p2 = _solar_system.get_planet_by_name(planet2)\n\n    if p1 is None or p2 is None:\n        return ()\n\n    intermediate_planets = _solar_system.get_planets_between(p1, p2)\n    return tuple(p.name for p in intermediate_planets)"}
{"task_id": "HumanEval/148", "solution": "PLANETS: tuple[str, ...] = (\n    \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n)\ndef bf(planet1: str, planet2: str) -> tuple[str, ...]:\n    \"\"\"\n    Returns a tuple of planets between planet1 and planet2, sorted by proximity to the sun.\n    Returns an empty tuple if either input planet is invalid.\n    \"\"\"\n    # Input Validation\n    if planet1 not in PLANETS or planet2 not in PLANETS:\n        return ()\n\n    # Find Planet Indices\n    idx1 = PLANETS.index(planet1)\n    idx2 = PLANETS.index(planet2)\n\n    # Determine Slice Range\n    if idx1 < idx2:\n        slice_start = idx1 + 1\n        slice_end = idx2\n    else: # idx2 < idx1\n        slice_start = idx2 + 1\n        slice_end = idx1\n\n    # Extract Intermediate Planets and Return Result\n    # Python's slicing automatically handles cases where slice_start >= slice_end,\n    # resulting in an empty tuple, and maintains the original order.\n    return PLANETS[slice_start:slice_end]"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters out odd-length strings and sorts the remaining by length then alphabetically.\"\"\"\n\n    # Filter out strings with odd lengths.\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n\n    # Sort the even-length strings by length in ascending order,\n    # then alphabetically in ascending order for strings of the same length.\n    even_length_strings.sort(key=lambda s: (len(s), s))\n\n    return even_length_strings"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n    \"\"\"\n\n    def is_prime(num: int) -> bool:\n        \"\"\"Determines if a given integer is a prime number.\n        Handles numbers less than or equal to 1 as not prime.\n        \"\"\"\n        if num <= 1:\n            return False\n        if num <= 3:  # 2 and 3 are prime numbers\n            return True\n        if num % 2 == 0 or num % 3 == 0:  # Exclude multiples of 2 and 3\n            return False\n\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n\n    Example :\n        Input: n = 5\n        Output: 1\n        Explanation:\n        a = [1, 3, 7, 13, 21]\n        The only valid triple is (1, 7, 13).\n    \"\"\"\n    if n < 3:\n        return 0\n\n    # Counts a[i] elements by their remainder modulo 3, following the design's BR7.\n    # BR7 states a[i]%3 is 0 if i%3==0; a[i]%3 is 1 if i%3!=0.\n    count0 = 0\n    count1 = 0\n    count2 = 0\n\n    for i in range(1, n + 1):\n        if i % 3 == 0:\n            count0 += 1\n        else: # i % 3 == 1 or i % 3 == 2\n            count1 += 1\n\n    total_triples = 0\n\n    # Calculate combinations for (remainder_x + remainder_y + remainder_z) % 3 == 0.\n    # Case (0, 0, 0): sum % 3 == 0\n    if count0 >= 3:\n        total_triples += (count0 * (count0 - 1) * (count0 - 2)) // 6\n\n    # Case (1, 1, 1): sum % 3 == 3 % 3 == 0\n    if count1 >= 3:\n        total_triples += (count1 * (count1 - 1) * (count1 - 2)) // 6\n\n    # Case (2, 2, 2) and (0, 1, 2) would involve count2.\n    # As per BR7 in the design, count2 will always be 0, so these combinations add nothing.\n\n    return total_triples"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters a list of strings, keeping only those with even length,\n    then sorts them by length and alphabetically for ties.\"\"\"\n\n    even_length_strings = []\n\n    # Filter out strings with odd lengths.\n    for s in lst:\n        if len(s) % 2 == 0:\n            even_length_strings.append(s)\n\n    # Sort the filtered list by length, then alphabetically.\n    even_length_strings.sort(key=lambda x: (len(x), x))\n\n    return even_length_strings"}
{"task_id": "HumanEval/152", "solution": "def compare(game, guess):\n    \"\"\"Calculates the absolute difference between game scores and user guesses for each match.\n    Returns 0 for correct guesses, otherwise the absolute difference.\n    \"\"\"\n    if len(game) != len(guess):\n        raise ValueError(\"Input arrays 'game' and 'guess' must be of equal length.\")\n\n    results = []\n    for i in range(len(game)):\n        # Calculate the absolute difference; this inherently makes it 0 if the values are equal.\n        absolute_diff = abs(game[i] - guess[i])\n        results.append(absolute_diff)\n    return results"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on CAP - SM strength. Returns the class name combined with the strongest extension name.\"\"\"\n    strongest_extension_name = \"\"\n    # Initialize max_strength to a value lower than any possible strength.\n    max_strength = float('-inf')\n\n    # Iterate through the list of extensions to find the strongest one.\n    for extension_name in extensions:\n        cap_count = 0\n        sm_count = 0\n        for char in extension_name:\n            if 'A' <= char <= 'Z':  # Count uppercase letters.\n                cap_count += 1\n            elif 'a' <= char <= 'z':  # Count lowercase letters.\n                sm_count += 1\n\n        current_strength = cap_count - sm_count\n\n        # Update if current extension is stronger; preserve earlier extension on ties.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension_name\n\n    # Return the result in the specified format.\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/150", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"Checks if a given integer n is a prime number.\n    It returns True if n is prime, False otherwise.\"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef x_or_y(n: int, x: any, y: any) -> any:\n    \"\"\"Returns the value of x if n is prime, otherwise returns y.\n    It relies on an inline helper function to determine primality.\"\"\"\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/151", "solution": "def _is_non_negative_integer(num) -> bool:\n    \"\"\"Checks if num is an integer and non-negative.\"\"\"\n    return isinstance(num, int) and num >= 0\ndef _is_odd(num: int) -> bool:\n    \"\"\"Returns True if num is odd.\"\"\"\n    return num % 2 != 0\ndef _square(num: int) -> int:\n    \"\"\"Returns the square of num.\"\"\"\n    return num * num\ndef double_the_difference(lst: list) -> int:\n    \"\"\"\n    Calculates the sum of squares of odd, non-negative integers in the list.\n    Returns 0 if the input list is empty.\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for num in lst:\n        if _is_non_negative_integer(num):\n            if _is_odd(num):\n                squared_value = _square(num)\n                total_sum += squared_value\n    return total_sum"}
{"task_id": "HumanEval/151", "solution": "def _is_integer(num: any) -> bool:\n    \"\"\"Checks if the given value is an instance of int.\"\"\"\n    return isinstance(num, int)\ndef _is_negative(num: int) -> bool:\n    \"\"\"Checks if an integer is less than 0.\"\"\"\n    return num < 0\ndef _is_odd(num: int) -> bool:\n    \"\"\"Checks if a non-negative integer is odd.\"\"\"\n    return num % 2 != 0\ndef _calculate_square(num: int) -> int:\n    \"\"\"Calculates the square of an integer.\"\"\"\n    return num * num\ndef double_the_difference(lst: list) -> int:\n    \"\"\"\n    Given a list of numbers, return the sum of squares of the odd, non-negative integers.\n    Ignore numbers that are negative or not integers; return 0 for an empty list.\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for element in lst:\n        if not _is_integer(element):\n            continue\n        if _is_negative(element):\n            continue\n        if _is_odd(element):\n            squared_value = _calculate_square(element)\n            total_sum += squared_value\n    return total_sum"}
{"task_id": "HumanEval/153", "solution": "def _calculate_strength(extension_name):\n    \"\"\"Calculates the strength of an extension name.\n    Strength is defined as uppercase letters count minus lowercase letters count.\n    \"\"\"\n    cap_count = 0\n    sm_count = 0\n    for char in extension_name:\n        if char.isupper():\n            cap_count += 1\n        elif char.islower():\n            sm_count += 1\n    return cap_count - sm_count\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension for a class name based on strength calculation.\n    Returns the class name concatenated with the strongest extension.\n    \"\"\"\n    max_strength = float('-inf')\n    strongest_extension_name = \"\"\n\n    # Handle the case of an empty extensions list as per design specification.\n    if not extensions:\n        return f\"{class_name}.\"\n\n    for current_extension in extensions:\n        calculated_strength = _calculate_strength(current_extension)\n\n        # Update if a stronger extension is found.\n        # For ties, the first encountered (current strongest_extension_name) is kept.\n        if calculated_strength > max_strength:\n            max_strength = calculated_strength\n            strongest_extension_name = current_extension\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/152", "solution": "def compare(game: list[int], guess: list[int]) -> list[int]:\n    \"\"\"Compares actual game scores to player guesses.\n    Returns an array of absolute differences, with 0 for correct guesses.\"\"\"\n    differences = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            differences.append(0)\n        else:\n            differences.append(abs(game[i] - guess[i]))\n    return differences"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a, b):\n    \"\"\"Checks if string b or any of its cyclic rotations is a substring of string a.\n    Handles edge cases for empty strings and length discrepancies.\"\"\"\n\n    if not b:\n        return True\n\n    if not a or len(b) > len(a):\n        return False\n\n    doubled_b = b + b\n    for i in range(len(b)):\n        rotation = doubled_b[i : i + len(b)]\n        if rotation in a:\n            return True\n\n    return False"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer, return a tuple containing the count of even and odd digits respectively.\n    Processing is based on the absolute value of the input number.\"\"\"\n\n    even_count = 0\n    odd_count = 0\n\n    # Use the absolute value of the number for digit processing (FR5)\n    abs_num = abs(num)\n\n    # Convert the absolute number to a string to iterate through digits\n    num_str = str(abs_num)\n\n    for digit_char in num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1  # Increment even_count if the digit is even (FR3)\n        else:\n            odd_count += 1   # Increment odd_count if the digit is odd (FR4)\n\n    return (even_count, odd_count) # Return the counts as a tuple (FR2)"}
{"task_id": "HumanEval/154", "solution": "def _generate_rotations(s: str) -> list[str]:\n    \"\"\"Generates all cyclic rotations of a string.\n    Includes the original string in the list of rotations.\n    \"\"\"\n    if not s:\n        return [\"\"]\n    rotations = []\n    n = len(s)\n    for i in range(n):\n        rotations.append(s[i:] + s[:i])\n    return rotations\ndef _is_substring_of(sub: str, main: str) -> bool:\n    \"\"\"Checks if a substring is present within a main string.\n    Returns True if 'sub' is a substring of 'main', False otherwise.\n    \"\"\"\n    return sub in main\ndef cycpattern_check(a: str, b: str) -> bool:\n    \"\"\"Checks if string `b` or any of its rotations is a substring of string `a`.\n    Returns True if a match is found, False otherwise.\n    \"\"\"\n    if len(b) > len(a):\n        return False\n    if not b:\n        return True\n\n    rotations_of_b = _generate_rotations(b)\n\n    for rotation in rotations_of_b:\n        if _is_substring_of(rotation, a):\n            return True\n\n    return False"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    abs_num = abs(num)\n    num_str = str(abs_num)\n\n    for char_digit in num_str:\n        digit = int(char_digit)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Converts a positive integer (1-1000) to its lowercase Roman numeral string.\n    The conversion uses a greedy algorithm with a predefined mapping of values to Roman symbols.\n    \"\"\"\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n\n    result = []\n    temp_num = number\n\n    for value, symbol in roman_map:\n        while temp_num >= value:\n            result.append(symbol)\n            temp_num -= value\n\n    return \"\".join(result).lower()"}
{"task_id": "HumanEval/157", "solution": "def _get_sorted_sides(a: float, b: float, c: float) -> tuple[float, float, float]:\n    \"\"\"\n    Sorts three given side lengths in ascending order.\n    Returns them as a tuple (shortest, middle, longest).\n    \"\"\"\n    sides = sorted([a, b, c])\n    return tuple(sides)\ndef right_angle_triangle(a: float, b: float, c: float) -> bool:\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    \"\"\"\n    s1, s2, longest_side = _get_sorted_sides(a, b, c)\n    return s1**2 + s2**2 == longest_side**2"}
{"task_id": "HumanEval/157", "solution": "import math\ndef right_angle_triangle(a, b, c):\n    \"\"\"\n    Determines if three given side lengths can form a right-angled triangle.\n    It applies the Pythagorean theorem to check the relationship between sides.\n    \"\"\"\n    sides = sorted([a, b, c])\n\n    shorter_side1 = sides[0]\n    shorter_side2 = sides[1]\n    longest_side = sides[2]\n\n    shorter_sides_sum_sq = (shorter_side1 ** 2) + (shorter_side2 ** 2)\n    longest_side_sq = longest_side ** 2\n\n    return math.isclose(longest_side_sq, shorter_sides_sum_sq)"}
{"task_id": "HumanEval/158", "solution": "class StringItem:\n    \"\"\"Represents a string with its calculated unique character count.\"\"\"\n    def __init__(self, value):\n        self.value = value\n        self.uniqueCharacterCount = 0\n        self.calculateUniqueCharacterCount()\n\n    def calculateUniqueCharacterCount(self):\n        \"\"\"Calculates and stores the number of unique characters in the string.\"\"\"\n        self.uniqueCharacterCount = len(set(self.value))\ndef find_max(words):\n    \"\"\"\n    Accepts a list of strings, returning the one with maximum unique characters.\n    Lexicographical order breaks ties.\n    \"\"\"\n    max_unique_count = -1\n    selected_string = \"\"\n\n    for word in words:\n        # Create a StringItem to encapsulate word and unique character count\n        item = StringItem(word)\n\n        if item.uniqueCharacterCount > max_unique_count:\n            max_unique_count = item.uniqueCharacterCount\n            selected_string = item.value\n        elif item.uniqueCharacterCount == max_unique_count:\n            # Apply lexicographical tie-breaking\n            if item.value < selected_string:\n                selected_string = item.value\n\n    return selected_string"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"Calculates total carrots eaten and remaining stock after a rabbit's meal.\n    The rabbit eats as many carrots as needed, or all remaining if not enough.\n    \"\"\"\n\n    if need <= remaining:\n        total_eaten = number + need\n        new_remaining = remaining - need\n    else:\n        total_eaten = number + remaining\n        new_remaining = 0\n\n    return [total_eaten, new_remaining]"}
{"task_id": "HumanEval/158", "solution": "def _calculate_unique_char_count(word: str) -> int:\n    \"\"\"Calculates the number of unique characters in a given string.\n    It uses a set to efficiently count unique characters.\"\"\"\n    return len(set(word))\ndef find_max(words: list[str]) -> str:\n    \"\"\"\n    Accepts a list of strings and returns the word with the maximum number of unique characters.\n    If multiple strings have the maximum number of unique characters, returns the one which comes first\n    in lexicographical order.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    best_words_candidates = []\n\n    for word in words:\n        current_unique_count = _calculate_unique_char_count(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            best_words_candidates = [word] # Start a new list of candidates\n        elif current_unique_count == max_unique_count:\n            best_words_candidates.append(word) # Add to candidates if it's a tie\n\n    # If there are multiple candidates (a tie), sort them lexicographically\n    # and pick the first one. Otherwise, return the single best word.\n    best_words_candidates.sort()\n    return best_words_candidates[0]"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates total eaten carrots and remaining stock after a rabbit's meal.\n    It determines consumption as the minimum of needed and available carrots.\n    \"\"\"\n    carrots_consumed = min(need, remaining)\n    total_eaten = number + carrots_consumed\n    carrots_left = remaining - carrots_consumed\n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator: list[str], operand: list[int]) -> int:\n    \"\"\"\n    Constructs an algebraic expression from operators and operands, then evaluates it.\n    The expression follows standard mathematical order of operations.\n    \"\"\"\n    expression_parts = []\n    # Interleave operands and operators\n    for i in range(len(operator)):\n        expression_parts.append(str(operand[i]))\n        expression_parts.append(operator[i])\n    # Add the last operand\n    expression_parts.append(str(operand[len(operator)]))\n\n    expression_string = \"\".join(expression_parts)\n\n    # Evaluate the constructed string expression using Python's built-in eval,\n    # which correctly applies standard operator precedence.\n    return int(eval(expression_string))"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number: int) -> str:\n    \"\"\"Converts a positive integer (1-1000) to its lowercase Roman numeral string.\n    The input number is guaranteed to be within the valid range.\n    \"\"\"\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'),\n        (1, 'I')\n    ]\n\n    result = []\n    temp_num = number\n    for value, numeral in roman_map:\n        while temp_num >= value:\n            result.append(numeral)\n            temp_num -= value\n\n    return \"\".join(result).lower()"}
{"task_id": "HumanEval/161", "solution": "def _reverse_char_case(char: str) -> str:\n    \"\"\"Reverses the case of a single character if it's a letter, otherwise returns it unchanged.\"\"\"\n    if char.isupper():\n        return char.lower()\n    elif char.islower():\n        return char.upper()\n    return char\ndef _transform_string_case(s: str) -> str:\n    \"\"\"Iterates through a string and applies case reversal to letters.\"\"\"\n    transformed_chars = []\n    for char in s:\n        transformed_chars.append(_reverse_char_case(char))\n    return \"\".join(transformed_chars)\ndef _reverse_string(s: str) -> str:\n    \"\"\"Reverses an entire string.\"\"\"\n    return s[::-1]\ndef _contains_letters(s: str) -> bool:\n    \"\"\"Checks if a string contains any alphabetic characters.\"\"\"\n    for char in s:\n        if char.isalpha():\n            return True\n    return False\ndef solve(s):\n    \"\"\"You are given a string s.\n    If the string contains no letters, reverse the string.\n    Otherwise, if s[i] is a letter, reverse its case, otherwise keep it as it is.\n    \"\"\"\n    if not _contains_letters(s):\n        return _reverse_string(s)\n    else:\n        return _transform_string_case(s)"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Processes an input string s by reversing the case of letters.\n    If no letters are present, the entire string is reversed.\"\"\"\n\n    def _contains_letters(text):\n        \"\"\"Checks if a string contains any alphabetic characters.\"\"\"\n        for char_code in text:\n            if ('a' <= char_code <= 'z') or ('A' <= char_code <= 'Z'):\n                return True\n        return False\n\n    def _transform_character(char_val):\n        \"\"\"Reverses the case of a letter or returns the character unchanged.\"\"\"\n        if 'a' <= char_val <= 'z':\n            return chr(ord(char_val) - 32)  # Convert to uppercase\n        elif 'A' <= char_val <= 'Z':\n            return chr(ord(char_val) + 32)  # Convert to lowercase\n        else:\n            return char_val\n\n    if not _contains_letters(s):\n        return s[::-1]\n    else:\n        result_chars = []\n        for char in s:\n            result_chars.append(_transform_character(char))\n        return \"\".join(result_chars)"}
{"task_id": "HumanEval/162", "solution": "import hashlib\nfrom typing import Optional\ndef string_to_md5(text: str) -> Optional[str]:\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
{"task_id": "HumanEval/163", "solution": "from typing import List\nclass InputInteger:\n    \"\"\"Represents a validated integer input.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def get_value(self) -> int:\n        \"\"\"Returns the integer value.\"\"\"\n        return self._value\nclass InclusiveRange:\n    \"\"\"Defines an inclusive integer range.\"\"\"\n    def __init__(self, a: int, b: int):\n        self._minimum = min(a, b)\n        self._maximum = max(a, b)\n\n    def includes(self, number: int) -> bool:\n        \"\"\"Checks if a number is within the inclusive range.\"\"\"\n        return self._minimum <= number <= self._maximum\nclass EvenSingleDigit:\n    \"\"\"Represents an even single-digit number.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def get_value(self) -> int:\n        \"\"\"Returns the digit's value.\"\"\"\n        return self._value\n\n    def is_within(self, range_obj: InclusiveRange) -> bool:\n        \"\"\"Checks if the digit is within a given inclusive range.\"\"\"\n        return range_obj.includes(self._value)\nclass OutputList:\n    \"\"\"Collects and provides a sorted list of integers.\"\"\"\n    def __init__(self):\n        self._elements: List[int] = []\n\n    def add(self, digit: EvenSingleDigit):\n        \"\"\"Adds an even single-digit to the collection.\"\"\"\n        self._elements.append(digit.get_value())\n\n    def get_sorted(self) -> List[int]:\n        \"\"\"Returns the collected numbers in ascending order.\"\"\"\n        return sorted(self._elements)\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    input_a = InputInteger(a)\n    input_b = InputInteger(b)\n\n    inclusive_range = InclusiveRange(input_a.get_value(), input_b.get_value())\n    output_list = OutputList()\n\n    candidate_digits = [2, 4, 6, 8]\n    for digit_value in candidate_digits:\n        even_digit = EvenSingleDigit(digit_value)\n        if even_digit.is_within(inclusive_range):\n            output_list.add(even_digit)\n\n    return output_list.get_sorted()"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    lower_bound = min(a, b)\n    upper_bound = max(a, b)\n\n    even_digit_candidates = [0, 2, 4, 6, 8]\n    result_digits = []\n\n    for digit in even_digit_candidates:\n        if lower_bound <= digit <= upper_bound:\n            result_digits.append(digit)\n\n    return result_digits"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Builds and evaluates an algebraic expression from given operators and operands.\n    The function constructs the expression respecting standard operator precedence.\n    \"\"\"\n    expression_parts = []\n\n    # Append the first operand\n    expression_parts.append(str(operand[0]))\n\n    # Interleave operators and subsequent operands\n    for i in range(len(operator)):\n        expression_parts.append(operator[i])\n        expression_parts.append(str(operand[i+1]))\n\n    # Join parts to form the full expression string\n    expression_str = \"\".join(expression_parts)\n\n    # Evaluate the expression and return the integer result\n    return int(eval(expression_str))"}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Computes the MD5 hash of a given string as a lowercase hexadecimal string.\n    Returns None if the input string is empty.\n    \"\"\"\n    if not text:\n        return None\n\n    md5_hash = hashlib.md5(text.encode('utf-8')).hexdigest()\n    return md5_hash"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef calculate_deepest_nesting_level(group_string: str) -> int:\n    \"\"\"Calculates the deepest nesting level for a single parentheses group string.\n    It iterates through the string, tracking current and maximum nesting levels.\n    \"\"\"\n    current_level = 0\n    max_level = 0\n    for char in group_string:\n        if char == '(':\n            current_level += 1\n            if current_level > max_level:\n                max_level = current_level\n        elif char == ')':\n            current_level -= 1\n    return max_level\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Parses a string of nested parentheses groups and returns their deepest nesting levels.\n    Each group's deepest level is calculated by a helper function.\n    \"\"\"\n    groups = paren_string.split(' ')\n    result = []\n    for group_string in groups:\n        level = calculate_deepest_nesting_level(group_string)\n        result.append(level)\n    return result"}
