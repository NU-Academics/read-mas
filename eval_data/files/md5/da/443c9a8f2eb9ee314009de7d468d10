{"task_id": "HumanEval/49", "solution": "import sys\nimport sys\nfrom src.input_parser import InputParser\nfrom src.modular_exponentiation import modp\nfrom src.output_formatter import OutputFormatter\ndef modp(n: int, p: int):\n    \"\"\"Calculates (2^n) % p using modular exponentiation by squaring.\n    This handles potentially large integer values efficiently.\"\"\"\n    if p == 1:\n        return 0\n    res = 1\n    base = 2 % p\n    while n > 0:\n        if n % 2 == 1:\n            res = (res * base) % p\n        base = (base * base) % p\n        n //= 2\n    return res"}
