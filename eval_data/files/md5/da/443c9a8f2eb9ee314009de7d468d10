{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Checks if all three inputs are integers and if one is the sum of the other two.\n    Returns True if both conditions are met, False otherwise.\n    '''\n    if not (isinstance(x, int) and isinstance(y, int) and isinstance(z, int)):\n        return False  # Returns False if any input argument is not an integer (FR8).\n\n    # Determines if any one argument is equal to the sum of the other two (FR4, FR5, FR6).\n    if x == y + z or y == x + z or z == x + y:\n        return True  # Returns True if all inputs are integers AND one sum condition is met (FR7).\n    else:\n        return False  # Returns False if all inputs are integers but no sum condition is met (FR9)."}
{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    You'll be given a string of words, and your task is to count the number\n    of boredoms. A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n\n    For example:\n    >>> is_bored(\"Hello world\")\n    0\n    >>> is_bored(\"The sky is blue. The sun is shining. I love this weather\")\n    1\n    \"\"\"\n\n    def _split_into_sentences(text: str, delimiters: tuple) -> list[str]:\n        sentences = []\n        current_sentence_start = 0\n\n        for i, char in enumerate(text):\n            if char in delimiters:\n                segment = text[current_sentence_start : i + 1]\n                stripped_segment = segment.strip()\n                if stripped_segment:\n                    sentences.append(stripped_segment)\n                current_sentence_start = i + 1\n\n        if current_sentence_start < len(text):\n            remaining_text = text[current_sentence_start:].strip()\n            if remaining_text:\n                sentences.append(remaining_text)\n\n        return sentences\n\n    def _is_boredom_sentence(sentence: str) -> bool:\n        cleaned_sentence = sentence.strip()\n\n        if not cleaned_sentence:\n            return False\n\n        if cleaned_sentence[0] == 'I':\n            if len(cleaned_sentence) == 1:\n                return True\n            if not cleaned_sentence[1].isalpha():\n                return True\n        return False\n\n    boredom_count = 0\n    delimiters = ('.', '?', '!')\n    sentences = _split_into_sentences(S, delimiters)\n\n    for sentence in sentences:\n        if _is_boredom_sentence(sentence):\n            boredom_count += 1\n    return boredom_count"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n\n    Examples\n    any_int(5, 2, 7) \u279e True\n\n    any_int(3, 2, 2) \u279e False\n\n    any_int(3, -2, 1) \u279e True\n\n    any_int(3.6, -2.2, 2) \u279e False\n\n\n\n    '''\n    if not (isinstance(x, int) and isinstance(y, int) and isinstance(z, int)):\n        return False\n\n    return (x == y + z) or \\\n           (y == x + z) or \\\n           (z == x + y)"}
{"task_id": "HumanEval/93", "solution": "from enum import Enum\nclass Alphabet:\n    \"\"\"Provides static utility methods for alphabet-related lookups and transformations.\"\"\"\n\n    _VOWELS_LOWER = {'a', 'e', 'i', 'o', 'u'}\n    _ALPHABET_LOWER = list('abcdefghijklmnopqrstuvwxyz')\n\n    @staticmethod\n    def is_vowel(char: str) -> bool:\n        \"\"\"Determines if a character is an English vowel (case-insensitive).\"\"\"\n        return char.lower() in Alphabet._VOWELS_LOWER\n\n    @staticmethod\n    def get_n_places_ahead(char: str, n: int) -> str:\n        \"\"\"Returns the letter 'n' places ahead in the English alphabet, wrapping around.\n           Preserves the original case of the input character.\n        \"\"\"\n        is_upper = char.isupper()\n        char_lower = char.lower()\n\n        # Assuming char is an English letter as per design's _is_english_letter check.\n        idx = Alphabet._ALPHABET_LOWER.index(char_lower)\n        new_idx = (idx + n) % len(Alphabet._ALPHABET_LOWER)\n        result_char = Alphabet._ALPHABET_LOWER[new_idx]\n\n        return result_char.upper() if is_upper else result_char\ndef _is_english_letter(char: str) -> bool:\n    \"\"\"Determines if a character is an English alphabet letter.\"\"\"\n    return char.isalpha()\ndef _swap_case(char: str) -> str:\n    \"\"\"Swaps the case of an English letter.\"\"\"\n    return char.swapcase()\ndef encode(message: str) -> str:\n    \"\"\"Encodes a message by swapping case of letters and replacing vowels.\n\n    Args:\n        message: The input string message to be encoded.\n\n    Returns:\n        The encoded string.\n    \"\"\"\n    encoded_chars = []\n    for char in message:\n        if _is_english_letter(char):\n            current_char = char\n            if Alphabet.is_vowel(char):\n                current_char = Alphabet.get_n_places_ahead(char, 2)\n\n            encoded_chars.append(_swap_case(current_char))\n        else:\n            encoded_chars.append(char) # Preserves non-letter characters.\n    return \"\".join(encoded_chars)"}
