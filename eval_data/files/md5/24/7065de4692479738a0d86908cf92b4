es form a valid triangle.\n    Otherwise return -1\n    '''\n    input_handler = InputHandler()\n    result_formatter = ResultFormatter()\n\n    # Step 1: Input Layer - Validate numeric input parameters.\n    if not input_handler.validate_numeric_input(a, b, c):\n        return result_formatter.format_error_result()\n\n    # Step 2: Business Logic Layer - Create Triangle and validate its properties.\n    triangle = Triangle(a, b, c)\n\n    if not triangle.is_valid():\n        return result_formatter.format_error_result()\n\n    # Step 3: Business Logic Layer - Calculate area for valid triangles.\n    area = triangle.calculate_area()\n\n    # Step 4: Output Layer - Format and return the result.\n    return result_formatter.format_result(area)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/72": [{"task_id": "HumanEval/72", "solution": "def is_palindromic(lst):\n    \"\"\"\n    Returns True if list is palindromic, False otherwise.\n    Uses two-pointer technique for O(n) complexity.\n    \"\"\"\n    left = 0\n    right = len(lst) - 1\n    while left < right:\n        if lst[left] != lst[right]:\n            return False\n        left += 1\n        right -= 1\n    return True\ndef calculate_sum(lst):\n    \"\"\"\n    Returns sum of all numeric elements in list.\n    Handles empty lists by returning 0.\n    \"\"\"\n    return sum(lst)\ndef will_it_fly(q, w):\n    \"\"\"\n    Returns True if object q will fly, False otherwise.\n    Object flies if balanced (palindromic) and sum <= w.\n    \"\"\"\n    return is_palindromic(q) and calculate_sum(q) <= w", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/72", "solution": "def is_palindromic(q):\n    \"\"\"Checks if a list is palindromic using a two-pointer approach for O(1) space.\"\"\"\n    left, right = 0, len(q) - 1\n    while left < right:\n        if q[left] != q[right]:\n            return False