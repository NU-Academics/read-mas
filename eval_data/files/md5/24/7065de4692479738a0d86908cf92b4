    return abs(x_squared + y_squared - z_squared) < epsilon", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/157", "solution": "EPSILON = 1e-9\ndef _validate_pythagorean_theorem(side1: float, side2: float, hypotenuse: float) -> bool:\n    \"\"\"Checks if the sum of squares of two sides approximately equals the square of the hypotenuse.\"\"\"\n    return abs(side1**2 + side2**2 - hypotenuse**2) < EPSILON\ndef _check_all_arrangements(a: float, b: float, c: float) -> bool:\n    \"\"\"Tests all possible side arrangements to satisfy the Pythagorean theorem.\"\"\"\n    return (_validate_pythagorean_theorem(a, b, c) or\n            _validate_pythagorean_theorem(a, c, b) or\n            _validate_pythagorean_theorem(b, c, a))\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    return _check_all_arrangements(a, b, c)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/158": [{"task_id": "HumanEval/158", "solution": "def _count_unique_chars(word):\n    \"\"\"Counts unique characters in a string.\n    It converts the string to a set to find unique characters.\"\"\"\n    return len(set(word))\ndef _find_lexicographically_first(candidates):\n    \"\"\"Finds the lexicographically first string from a list of candidates.\n    It sorts the list and returns the first element, or an empty string if the list is empty.\"\"\"\n    if not candidates:\n        return \"\"\n    return sorted(candidates)[0]\ndef find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_candidates = []\n\n    for word in words:\n        current_unique_count = _count_unique_chars(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_candidates = [word]\n        elif current_unique_count == max_unique_count:\n            result_candidates.append(word)\n\n    return _find_lexicographically_first(result_candidates)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/158", "solution": "from typing import List\ndef _count_unique_chars(word: str) -> int:\n    \"\"\"Counts unique characters in a string.\"\"\"\n    return len(set(word))\ndef _validate_input(words: List[str]) -> bool:\n    \"\"\"Placeholder for input validation; always returns True due to constraints.\"\"\"\n    return True\ndef find_max(words: List[str]) -> str:\n    \"\"\"Returns the word with the maximum number of unique characters.\n    In case of ties, lexicographical order is used.\n    \"\"\"\n    _validate_input(words)\n\n    if not words:\n        return \"\"\n\n    word_unique_counts = {}\n    for word in words:\n        word_unique_counts[word] = _count_unique_chars(word)\n\n    max_unique_count = max(word_unique_counts.values())\n\n    candidate_words = [word for word, count in word_unique_counts.items() if count == max_unique_count]\n\n    sorted_candidates = sorted(candidate_words)\n\n    return sorted_candidates[0]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/161": [{"task_id": "HumanEval/161", "solution": "def _has_letters(s):\n    \"\"\"Checks if a string contains any alphabetic characters.\"\"\"\n    for char in s:\n        if char.isalpha():\n            return True\n    return False\ndef _reverse_case(char):\n    \"\"\"Reverses the case of a single alphabetic character.\"\"\"\n    if char.isupper():\n        return char.lower()\n    else:\n        return char.upper()\ndef _reverse_string(s):\n    \"\"\"Reverses the order of characters in a string.\"\"\"\n    return s[::-1]\ndef solve(s):\n    \"\"\"Processes a string by reversing letter cases or reversing the whole string.\n    If letters are present, their cases are inverted; otherwise, the entire string is reversed.\n    \"\"\"\n    if _has_letters(s):\n        processed_chars = []\n        for char in s:\n            if char.isalpha():\n                processed_chars.append(_reverse_case(char))\n            else:\n                processed_chars.append(char)\n        return \"\".join(processed_chars)\n    else:\n        return _reverse_string(s)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"\n    Processes a string by reversing case of letters or reversing the entire string.\n    It returns the modified string based on whether letters are present.\n    \"\"\"\n\n    def _has_letters(s: str) -> bool:\n        \"\"\"Analyzes a string to determine if it contains any letter characters.\"\"\"\n        for char in s:\n            if 'a' <= char <= 'z' or 'A' <= char <= 'Z':\n                return True\n        return False\n\n    def _reverse_case(char: str) -> str:\n        \"\"\"Converts the case of a single character if it's a letter, otherwise returns it unchanged.\"\"\"\n        if 'a' <= char <= 'z':\n            return chr(ord(char) - 32)  # Convert lowercase to uppercase\n        elif 'A' <= char <= 'Z':\n            return chr(ord(char) + 32)  # Convert uppercase to lowercase\n        return char\n\n    def _reverse_string(s: str) -> str:\n        \"\"\"Reverses the order of characters in a string.\"\"\"\n        return s[::-1]\n\n    if _has_letters(s):\n        processed_chars 