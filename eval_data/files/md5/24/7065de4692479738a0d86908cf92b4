ased on specified constraints.\"\"\"\n    MAX_LENGTH = 10000\n\n    def validate_input(self, s: str) -> bool:\n        \"\"\"Checks if the input string meets all validation criteria.\"\"\"\n        return self.check_length_limit(s)\n\n    def check_length_limit(self, s: str) -> bool:\n        \"\"\"Ensures the string's length does not exceed the maximum limit.\"\"\"\n        return len(s) <= self.MAX_LENGTH\nclass WordProcessor:\n    \"\"\"Handles splitting strings into words and extracting spacing information.\"\"\"\n\n    def split_into_words(self, s: str) -> tuple[list[str], list[int]]:\n        \"\"\"Splits the input string into words and records spacing between them.\n        It returns the list of words and a list of space counts.\n        \"\"\"\n        words = []\n        spacing_info = []\n        \n        current_pos = 0\n        n = len(s)\n\n        leading_spaces = 0\n        while current_pos < n and s[current_pos] == ' ':\n            leading_spaces += 1\n            current_pos += 1\n        spacing_info.append(leading_spaces)\n\n        while current_pos < n:\n            word_start = current_pos\n            while current_pos < n and s[current_pos] != ' ':\n                current_pos += 1\n            \n            if word_start < current_pos:\n                words.append(s[word_start:current_pos])\n            \n            space_count = 0\n            while current_pos < n and s[current_pos] == ' ':\n                space_count += 1\n                current_pos += 1\n            spacing_info.append(space_count)\n        \n        return words, spacing_info\n    \n    def extract_spacing_info(self, s: str) -> list[int]:\n        \"\"\"Extracts and returns a list of space counts, including leading and trailing spaces.\n        It delegates to split_into_words.\n        \"\"\"\n        _, spacing = self.split_into_words(s)\n        return spacing\nclass CharacterSorter:\n    \"\"\"Sorts characters within a word based on their ASCII values.\"\"\"\n\n    def sort_characters_in_word(self, word: str) -> str:\n        \"\"\"Sorts characters of a given word in ascending ASCII order.\n        It uses an internal helper for sorting.\n        \"\"\"\n        char_list = list(word)\n        sorted_chars = self._sort_by_ascii(char_list)\n        return \"\".join(sorted_chars)\n\n    def get_ascii_value(self, char: str) -> int:\n        \"\"\"Returns the ASCII integer value for a given character.\"\"\"\n        return ord(char)\n\n    def _sort_by_ascii(self, chars: list[str]) -> list[str]:\n        \"\"\"Internal helper to sort a list of characters by their ASCII values.\n        It uses Python's built-in sorted function for O(N log N) complexity.\n        \"\"\"\n        return sorted(chars, key=self.get_ascii_value)\nclass StringReconstructor:\n    \"\"\"Reconstructs the final string with processed words and original spacing.\"\"\"\n\n    def reconstruct_string(self, words: list[str], spacing: list[int]) -> str:\n        \"\"\"Combines sorted words with preserved spacing to form the final string.\n        It delegates to apply_spacing.\n        \"\"\"\n        return self.apply_spacing(words, spacing)\n\n    def apply_spacing(self, words: list[str], spacing: list[int]) -> str:\n        \"\"\"Inserts spaces into a list of words according to the provided spacing information.\n        The spacing list defines leading, inter-word, and trailing space counts.\n        \"\"\"\n        parts = []\n        \n        if spacing and spacing[0] > 0:\n            parts.append(' ' * spacing[0])\n        \n        for i, word in enumerate(words):\n            parts.append(word)\n            if i + 1 < len(spacing):\n                parts.append(' ' * spacing[i+1])\n        \n        return \"\".join(parts)\n\n    def _insert_spaces(self, words: list[str], positions: list[int]) -> str:\n        \"\"\"Internal helper to insert spaces at specified positions.\n        This method is an alias for apply_spacing based on the design flow.\n        \"\"\"\n        return self.apply_spacing(words, positions)\ndef anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n\n    For example:\n    anti_shuffle('Hi') returns 'Hi'\n    anti_shuffle('hello') returns 'ehllo'\n    anti_shuffle('Hello World!!!') returns 'Hello !!!Wdlor'\n    \"\"\"\n    validator = InputValidator()\n    word_processor = WordProcessor()\n    character_sorter = CharacterSorter()\n    string_reconstructor = StringReconstructor()\n\n    # The design specifies validation, but critical requirements forbid raising exceptions.\n    # We proceed with processing, trusting the input as per instructions.\n    validator.validate_input(s) \n\n    words, spacing = word_processor.split_into_words(s)\n    \n    sorted_words = [character_sorter.sort_characters_in_word(word) for word in words]\n    \n    result = string_reconstructor.reconstruct_string(sorted_words, spacing)\n\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/87": [{"task_id": "HumanEval/87", "solution": "from typing import List, Tuple\nclass Coordinate:\n    \"\"\"\n    Represents a single coordinate position within the 2D data structure.\n    It provides methods for conversion to tuple and comparison.\n    \"\"\"\n    def __init__(self, row: int, column: int):\n        self.row = row\n        self.column = column\n\n    def to_tuple(self) -> Tuple[int, int]:\n        \"\"\"Converts the Coordinate object to a (row, column) tuple.\"\"\"\n        return (self.row, self.column)\n    \n    # These comparison methods are provided as per design for general capability,\n    # but the SortingEngine's custom key is used for the specific sort order.\n    def __lt__(self, other: 'Coordinate') -> bool:\n        \"\"\"Compares coordinates primarily by row ascending, then column ascending.\"\"\"\n        if self.row < other.row:\n            return True\n        if self.row == other.row:\n            return self.column < other.column\n        return False\n\n    def __eq__(self, other: object) -> bool:\n        \"\"\"Checks if two Coordinate objects are equal by comparing their row and column.\"\"\"\n        # Removed isinstance check to strictly adhere to critical requirements regarding isinstance checks.\n        return self.row == other.row and self.column == other.column\nclass CoordinateManager:\n    \"\"\"\n    Manages the creation and collection of Coordinate objects during the search process.\n    It can also convert a list of Coordinate objects into a list of tuples.\n    \"\"\"\n    def __init__(self):\n        self._coordinates: List[Coordinate] = []\n\n    def add_coordinate(self, row: int, column: int) -> None:\n        \"\"\"Adds a new Coordinate object, identified by its row and column, to the manager's collection.\"\"\"\n        self._coordinates.append(Coordinate(row, column))\n\n    def get_coordinates(self) -> List[Coordinate]:\n        \"\"\"Returns the current list of all collected Coordinate objects.\"\"\"\n        return self._coordinates\n\n    def clear(self) -> None:\n        \"\"\"Resets the manager's collection, removing all stored coordinates.\"\"\"\n        self._coordinates = []\n\n    @staticmethod\n    def to_tuple_list(coordinates: List[Coordinate]) -> List[Tuple[int, int]]:\n        \"\"\"Converts a given list of Coordinate objects into a list of (row, column) tuples.\"\"\"\n        return [coord.to_tuple() for coord in coordinates]\nclass SearchProcessor:\n    \"\"\"\n    Implements the core algorithm to search for a specific integer value within a 2D nested list.\n    It leverages CoordinateManager to store all found match locations.\n    \"\"\"\n    def find_matches(self, nested_list: List[List[int]], search_value: int) -> List[Coordinate]:\n        \"\"\"\n        Iterates through the nested list to find all occurrences of the search_value.\n        It collects matching coordinates using a CoordinateManager instance.\n        \"\"\"\n        coordinate_manager = CoordinateManager()\n        \n        for row_index, row_data in enumerate(nested_list):\n            self._search_row(row_data, row_index, search_value, coordinate_manager)\n            \n        return coordinate_manager.get_coordinates()\n\n    def _search_row(self, row: List[int], row_index: int, search_value: int, manager: CoordinateManager) -> None:\n        \"\"\"\n        Searches a single row for the specified search_value.\n        Upon finding a match, it adds the coordinate to the provided CoordinateManager.\n        \"\"\"\n        for col_index, item in enumerate(row):\n            if item == search_value:\n                manager.add_coordinate(row_index, col_index)\nclass SortingEngine:\n    \"\"\"\n    Applies a specific sorting logic to a list of Coordinate objects.\n    The primary sort is by row in ascending order, followed by column in descending order.\n    \"\"\"\n    def sort_coordinates(self, coordinates: List[Coordinate]) -> List[Coordinate]:\n        \"\"\"\n        Sorts the given list of Coordinate objects according to the defined criteria.\n        It sorts by row ascending and then by column descending within each row.\n        \"\"\"\n        return sorted(coordinates, key=self._coordinate_sort_key)\n\n    def _coordinate_sort_key(self, coord: Coordinate) -> Tuple[int, int]:\n        \"\"\"\n        Generates a sorting key for a Coordinate object to enable dual-criteria sorting.\n        The key is a tuple (row, -column) for row ascending, column descending order.\n        \"\"\"\n        return (coord.row, -coord.column)\ndef get_row(lst: List[List[int]], x: int) -> List[Tuple[int, int]]:\n    \"\"\"\n    Searches a 2D nested list for an integer x and returns its coordinates.\n    The results are sorted by row ascending, then by column descending.\n    \"\"\"\n    search_processor = SearchProcessor()\n    sorting_engine = SortingEngine()\n\n    # Find all occurrences of 'x' and collect their coordinates.\n    found_coordinates = search_processor.find_matches(lst, x)\n\n    # Sort the collected coordinates based on the specified criteria.\n    sorted_coordinates = sorting_engine.sort_coordinates(found_coordinates)\n\n    # Convert the sorted Coordinate objects into a list of (row, column) tuples.\n    result_tuples = CoordinateManager.to_tuple_list(sorted_coordinates)\n\n    return result_tuples", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds integers x in a 2D nested list and returns their coordinates.\n    Coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n\n    def _validate_input(lst_param, x_param):\n        \"\"\"Checks if the input list is not empty, returning True for valid, False otherwise.\"\"\"\n        return len(lst_param) > 0\n\n    def _search_occurrences(lst_param, x_param):\n        \"\"\"Searches the list for all occurrences of x and collects their (row, col) coordinates.\"\"\"\n        found_coordinates = []\n        for r_idx, row in enumerate(lst_param):\n            for c_idx, val in enumerate(row):\n                if val == x_param:\n                    found_coordinates.append((r_idx, c_idx))\n        return found_coordinates\n\n    def _sort_coordinates(coordinates_param):\n        \"\"\"Sorts coordinates primarily by row ascending, secondarily by column descending.\"\"\"\n        # Sorting by (row, -column) achieves row ascending and column descending.\n        return sorted(coordinates_param, key=lambda coord: (coord[0], -coord[1]))\n\n    if not _validate_input(lst, x):\n        return []\n\n    unsorted_results = _search_occurrences(lst, x)\n    sorted_results = _sort_coordinates(unsorted_results)\n\n    return sorted_results", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/89": [{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"\n    Encrypt string using 4-position alphabet rotation.\n    Lowercase letters are shifted 4 positions, wrapping from 'z' to 'a'.\n    \"\"\"\n    result_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            start_code = ord('a')\n            current_offset = ord(char) - start_code\n            shifted_offset = (current_offset + 4) % 26\n            shifted_char = chr(start_code + shifted_offset)\n            result_chars.append(shifted_char)\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by shifting lowercase alphabetic characters by 4 positions.\n    Non-alphabetic characters remain unchanged.\n    \"\"\"\n\n    def _is_lowercase_alpha(char):\n        \"\"\"Checks if a character is a lowercase alphabetic letter.\"\"\"\n        return 'a' <= char <= 'z'\n\n    def _apply_wraparound(shifted_ord):\n        \"\"\"Handles alphabet wraparound for shifted character ordinals.\"\"\"\n        return chr(ord('a') + (shifted_ord - ord('a')) % 26)\n\n    def _shift_character(char):\n        \"\"\"Applies a 4-position shift to a single lowercase character.\"\"\"\n        original_ord = ord(char)\n        shifted_ord = original_ord + 4\n        if shifted_ord > ord('z'):\n            return _apply_wraparound(shifted_ord)\n        return chr(shifted_ord)\n\n    encrypted_chars = []\n    for char in s:\n        if _is_lowercase_alpha(char):\n            encrypted_chars.append(_shift_character(char))\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/88": [{"task_id": "HumanEval/88", "solution": "from typing import List\ndef _is_empty(array: List[int]) -> bool:\n    \"\"\"\n    Check if array is empty.\n    Returns True if the array has no elements.\n    \"\"\"\n    return len(array) == 0\ndef _is_single_element(array: List[int]) -> bool:\n    \"\"\"\n    Check if array has single element.\n    Returns True if the array contains exactly one element.\n    \"\"\"\n    return len(array) == 1\ndef _calculate_sum(array: List[int]) -> int:\n    \"\"\"\n    Calculate sum of first and last elements.\n    Requires a non-empty array for valid indexing.\n    \"\"\"\n    return array[0] + array[-1]\ndef sort_array(array: List[int]) -> List[int]:\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting.\n    The sorting order (ascending or descending) depends on the sum of the first and last elements.\n    \"\"\"\n    if _is_empty(array):\n        return []\n\n    if _is_single_element(array):\n        return array[:]\n\n    elements_sum = _calculate_sum(array)\n\n    if elements_sum % 2 != 0:  # Sum is odd, sort ascending\n        return sorted(array)\n    else:  # Sum is even, sort descending\n        return sorted(array, reverse=True)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts an array based on the sum of its first and last elements, returning a sorted copy.\n    Ascending for odd sums, descending for even sums.\n    \"\"\"\n    if not array:\n        return []\n\n    if len(array) == 1:\n        return array[:]\n\n    first_element = array[0]\n    last_element = array[-1]\n    elements_sum = first_element + last_element\n\n    is_ascending = (elements_sum % 2 != 0)\n    \n    return sorted(array, reverse=not is_ascending)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/90": [{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Returns the 2nd smallest unique element of the list.\n    Returns None if there is no such element.\n    \"\"\"\n    if not lst:\n        return None\n\n    unique_elements = sorted(list(set(lst)))\n\n    if len(unique_elements) < 2:\n        return None\n    else:\n        return unique_elements[1]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Finds the second smallest unique element from a list of integers.\n    Returns None if the list is empty or has fewer than two unique elements.\n    \"\"\"\n    unique_elements = sorted(list(set(lst)))\n\n    if len(unique_elements) < 2:\n        return None\n    else:\n        return unique_elements[1]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/92": [{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    \"\"\"\n    Validates if one of three numbers equals the sum of the other two,\n    and all numbers are integers.\n    \"\"\"\n    if not (isinstance(x, int) and isinstance(y, int) and isinstance(z, int)):\n        return False\n    \n    return (x + y == z) or (x + z == y) or (y + z == x)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Returns True if one of the numbers equals the sum of the other two,\n    and all numbers are integers. Returns False otherwise.\n    '''\n\n    def _validate_integers(val_x, val_y, val_z):\n        \"\"\"\n        Validates that all three inputs are pure integers.\n        Rejects floating-point numbers, even if they represent whole values.\n        \"\"\"\n        return type(val_x) is int and type(val_y) is int and type(val_z) is int\n\n    def _check_sum_conditions(sum_x, sum_y, sum_z):\n        \"\"\"\n        Evaluates if any of the three sum conditions are met.\n        Assumes inputs are already validated as integers.\n        \"\"\"\n        return (sum_x == sum_y + sum_z) or \\\n               (sum_y == sum_x + sum_z) or \\\n               (sum_z == sum_x + sum_y)\n\n    if not _validate_integers(x, y, z):\n        return False\n    \n    return _check_sum_conditions(x, y, z)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/91": [{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    Counts sentences starting with \"I\", delimited by '.', '?', or '!'.\n    Processes the input string to identify and count \"boredoms\".\n    \"\"\"\n\n    def _is_delimiter(char):\n        \"\"\"Checks if a character is a sentence delimiter.\"\"\"\n        return char in ('.', '?', '!')\n\n    def _extract_first_word(sentence):\n        \"\"\"Extracts the first word from a given sentence string.\"\"\"\n        stripped_sentence = sentence.strip()\n        if not stripped_sentence:\n            return \"\"\n        \n        # Find the first space to get the word, or return the whole sentence if no spaces.\n        first_space_index = stripped_sentence.find(' ')\n        if first_space_index == -1:\n            return stripped_sentence\n        return stripped_sentence[:first_space_index]\n\n    def _starts_with_i(sentence):\n        \"\"\"Determines if a sentence begins with the word 'I'.\"\"\"\n        first_word = _extract_first_word(sentence)\n        return first_word == 'I'\n\n    def _split_sentences(text):\n        \"\"\"Splits the input text into a list of individual sentences.\"\"\"\n        sentences = []\n        current_sentence_start = 0\n        for i in range(len(text))