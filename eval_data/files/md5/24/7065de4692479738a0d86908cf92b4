(number: int) -> bool:\n        \"\"\"Determines if a given number is prime.\"\"\"\n        if number < 2:\n            return False\n        for i in range(2, int(number**0.5) + 1):\n            if number % i == 0:\n                return False\n        return True\n\n    def get_prime_factors(number: int) -> list[int]:\n        \"\"\"Extracts all prime factors of a number, including multiplicities.\"\"\"\n        factors = []\n        d = 2\n        temp_num = number\n        while d * d <= temp_num:\n            if is_prime(d):  # Checks primality of potential divisor as per design.\n                while temp_num % d == 0:\n                    factors.append(d)\n                    temp_num //= d\n            d += 1\n        if temp_num > 1:\n            factors.append(temp_num)  # The remaining number is a prime factor.\n        return factors\n\n    def count_prime_factors(factors: list[int]) -> int:\n        \"\"\"Counts the total number of prime factors in a list.\"\"\"\n        return len(factors)\n\n    if not (0 < a < 100):\n        return False\n\n    factors = get_prime_factors(a)\n    count = count_prime_factors(factors)\n\n    return count == 3", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/78": [{"task_id": "HumanEval/78", "solution": "def hex_key(num: str) -> int:\n    \"\"\"\n    Counts prime hexadecimal digits in the input string.\n    Prime hexadecimal digits are 2, 3, 5, 7, B (11), D (13).\n    \"\"\"\n    PRIME_HEX_DIGITS = {'2', '3', '5', '7', 'B', 'D'}\n    count = 0\n    for char in num:\n        if char in PRIME_HEX_DIGITS:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/78", "solution": "def hex_key(num):\n    \"\"\"Counts prime hexadecimal digits in a string.\n    Identifies 2, 3, 5, 7, B, D as prime digits.\"\"\"\n\n    PRIME_HEX_DIGITS = {'2', '3', '5', '7', 'B', 'D'}