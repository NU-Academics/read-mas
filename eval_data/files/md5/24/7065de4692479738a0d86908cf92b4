er % 2 == 0\ndef math_utils_calculate_sum(numbers: List[int]) -> int:\n    \"\"\"Calculates the sum of a list of numbers.\"\"\"\n    return sum(numbers)\nclass IndexProcessor:\n    \"\"\"Processes lists to identify and extract elements at odd indices.\"\"\"\n    def process_odd_indexed_elements(self, lst: List[int]) -> List[int]:\n        \"\"\"Extracts elements from the list that are located at odd indices.\"\"\"\n        odd_indexed_elements = []\n        for i, val in enumerate(lst):\n            if is_odd_index(i):\n                odd_indexed_elements.append(val)\n        return odd_indexed_elements\nclass EvenNumberFilter:\n    \"\"\"Filters a list of numbers, retaining only the even ones.\"\"\"\n    def filter_even_numbers(self, numbers: List[int]) -> List[int]:\n        \"\"\"Returns a new list containing only the even numbers from the input list.\"\"\"\n        return [num for num in numbers if is_even(num)]\nclass SumCalculator:\n    \"\"\"Calculates the sum of a list of integers.\"\"\"\n    def calculate_sum(self, numbers: List[int]) -> int:\n        \"\"\"Returns the total sum of all integers in the provided list.\"\"\"\n        return math_utils_calculate_sum(numbers)\ndef add(lst: List[int]) -> int:\n    \"\"\"Given a non-empty list of integers, adds the even elements that are at odd indices.\"\"\"\n    # Instantiate the processing components\n    index_processor = IndexProcessor()\n    even_filter = EvenNumberFilter()\n    sum_calculator = SumCalculator()\n\n    # Step 1: Get elements located at odd indices from the input list\n    odd_indexed_elements = index_processor.process_odd_indexed_elements(lst)\n\n    # Step 2: Filter these elements to include only the even numbers\n    even_numbers_at_odd_indices = even_filter.filter_even_numbers(odd_indexed_elements)\n\n    # Step 3: Calculate the sum of the filtered even numbers\n    result = sum_calculator.calculate_sum(even_numbers_at_odd_indices)\n\n    return result", "base_status": "pass", "plus_statu