ool:\n    \"\"\"Check if character is a consonant (English letter that is not vowel).\"\"\"\n    return not _is_vowel(char)\ndef get_closest_vowel(word: str) -> str:\n    \"\"\"\n    Find the closest vowel that stands between two consonants from the right side.\n    Returns empty string if no qualifying vowel is found or word is too short.\n    \"\"\"\n    n = len(word)\n    if n < 3:\n        return \"\"\n\n    # Iterate from right to left, skipping the first and last characters.\n    # The valid indices for a vowel are from n-2 down to 1.\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i - 1]\n        right_char = word[i + 1]\n\n        if _is_vowel(current_char) and _is_consonant(left_char) and _is_consonant(right_char):\n            return current_char\n            \n    return \"\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/120": [{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n    \"\"\"\n\n    # --- array_utils.py functions ---\n    def get_array_length(array):\n        \"\"\"Returns the length of the input array.\"\"\"\n        return len(array)\n\n    def is_valid_element(element):\n        \"\"\"Checks if an element is within the valid range [-1000, 1000].\"\"\"\n        return -1000 <= element <= 1000\n\n    def get_elements(array):\n        \"\"\"Returns the array elements as is.\"\"\"\n        return array\n\n    # --- validator.py functions ---\n    # As per \"trust the caller's inputs\", these functions conceptually pass for valid inputs\n    # and do not raise exceptions or return False to stop execution.\n    def validate_array(array):\n        \"\"\"Validates array length and element ranges.\"\"\"\n        _ = get_array_length(array) # Length check is implicit via constraints\n        for element in array:\n            _ = is_valid_element(element) # Element range check is implicit\n\n    def validate_k(k_val, array_length):\n        \"\"\"Validates k parameter against array length.\"\"\"\n        _ = (0 <= k_val <= array_length) # k range check is implicit\n\n    def validate_inputs(array, k_val):\n        \"\"\"Orchestrates all input validation checks.\"\"\"\n        validate_array(array)\n        validate_k(k_val, get_array_length(array))\n\n    # --- sorter.py functions ---\n    def sort_ascending(elements_to_sort):\n        \"\"\"Sorts a list of elements in ascending order.\"\"\"\n        return sorted(elements_to_sort)\n\n    def create_sorted_list(elements_to_sort):\n        \"\"\"Creates a sorted list from input elements.\"\"\"\n        return sort_ascending(elements_to_sort)\n\n    # --- selector.py functions ---\n    def select_k_largest(array_elements, k_val):\n        \"\"\"Selects k largest elements by sorting and slicing.\"\"\"\n        # Create a copy and sort in descending order to get largest elements first.\n        # This meets O(N log N) complexity requirement.\n        temp_arr = list(array_elements)\n        temp_arr.sort(reverse=True)\n        # Return the top k elements; these will be in descending order.\n        return temp_arr[:k_val]\n\n    def find_maximum_elements(array_to_process, k_val):\n        \"\"\"Main selection logic, handling k=0 edge case.\"\"\"\n        # The k=0 edge case is handled directly in the main `maximum` function\n        # as per the sequence diagram, so this function focuses on selection.\n        return select_k_largest(get_elements(array_to_process), k_val)\n\n    # --- Main function orchestration ---\n    validate_inputs(arr, k)\n\n    # Handle k=0 edge case as specified in the sequence diagram\n    if k == 0:\n        return []\n\n    # Select the k largest elements (which will be in descending order from select_k_largest)\n    k_largest_elements = find_maximum_elements(arr, k)\n\n    #