{"task_id": "HumanEval/46", "solution": "def fib4(n: int) -> int:\n    \"\"\"Compute the n-th element of the Fib4 number sequence using an iterative approach.\n    This implementation achieves O(n) time complexity and O(1) space complexity.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n    else:\n        # Initialize the last four values corresponding to fib4(0), fib4(1), fib4(2), fib4(3)\n        a, b, c, d = 0, 0, 2, 0\n\n        # Iteratively calculate fib4(n) for n >= 4\n        for _ in range(4, n + 1):\n            next_fib = a + b + c + d\n            a = b\n            b = c\n            c = d\n            d = next_fib\n        return d"}
{"task_id": "HumanEval/46", "solution": "def validate_input(n: int) -> bool:\n    \"\"\"Validates input parameter constraints.\n    Per critical requirements, we trust the caller's inputs and assume n is a non-negative integer.\n    \"\"\"\n    return True\n\ndef _get_base_case(n: int) -> int:\n    \"\"\"Private helper for base cases.\n    Returns predefined values for indices 0 to 3.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n    return 0 # Should not be reached given `fib4`'s calling logic for n <= 3\n\ndef compute_iterative(n: int) -> int:\n    \"\"\"Iterative computation for n > 3.\n    Calculates fib4(n) by summing the four preceding terms.\n    \"\"\"\n    # Initialize with the base cases: fib4(0), fib4(1), fib4(2), fib4(3)\n    # These represent (n-4), (n-3), (n-2), (n-1) respectively for the current iteration\n    a, b, c, d = 0, 0, 2, 0 \n\n    for _ in range(4, n + 1):\n        next_fib4 = d + c + b + a\n        # Shift values to prepare for the next iteration\n        a = b\n        b = c\n        c = d\n        d = next_fib4\n    return d\n\ndef fib4(n: int) -> int:\n    \"\"\"The Fib4 number sequence calculator.\n    Efficiently computes the n-th element of the fib4 number sequence iteratively.\n    \"\"\"\n    validate_input(n)\n\n    if n <= 3:\n        return _get_base_case(n)\n    else:\n        return compute_iterative(n)"}
{"task_id": "HumanEval/47", "solution": "```python\ndef median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_list = sorted(l)\n    n = len(sorted_list)\n\n    if n % 2 == 1:\n        # For odd-length lists, the median is the middle element.\n        return sorted_list[n // 2]\n    else:\n        # For even-length lists, the median is the average of the two middle elements.\n        mid1 = sorted_list[n // 2 - 1]\n        mid2 = sorted_list[n // 2]\n        return (mid1 + mid2) / 2\n\n```"}
{"task_id": "HumanEval/47", "solution": "```python\nfrom typing import Union\n\ndef median(l: list) -> Union[int, float]:\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_list = sorted(l)\n    n = len(sorted_list)\n\n    if n % 2 == 1:\n        # For odd-length lists, the median is the middle element.\n        middle_index = n // 2\n        return sorted_list[middle_index]\n    else:\n        # For even-length lists, the median is the average of the two middle elements.\n        mid1_index = n // 2 - 1\n        mid2_index = n // 2\n        return (sorted_list[mid1_index] + sorted_list[mid2_index]) / 2\n\n```"}
