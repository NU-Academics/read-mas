{"task_id": "HumanEval/55", "solution": "```python\ndef fib(n: int) -> int:\n    \"\"\"Return the n-th Fibonacci number. Assumes n is a non-negative integer.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if n <= 1:\n        return n\n    a, b = 0, 1\n    for _ in range(2, n + 1):\n        a, b = b, a + b\n    return b\n```"}
{"task_id": "HumanEval/55", "solution": "def fib(n: int) -> int:\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if n <= 0:\n        # Assuming n will be positive as per design's trust in caller inputs and test cases.\n        # However, for completeness, handle non-positive as 0 or undefined for standard Fibonacci sequence.\n        # Given constraints, a simple interpretation for the common positive sequence is applied.\n        return 0 # Or could be an assumption from the domain. Following the design, n is a positive integer.\n    elif n == 1:\n        return 1\n    elif n == 2:\n        return 1\n    else:\n        a, b = 1, 1 # Initialize for F(1) and F(2)\n        for _ in range(3, n + 1): # Iterate from the 3rd number up to n\n            a, b = b, a + b\n        return b"}
{"task_id": "HumanEval/54", "solution": "def same_chars(s0: str, s1: str) -> bool:\n    \"\"\"\n    Check if two words have the same characters.\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddeddabc')\n    True\n    >>> same_chars('abcd', 'dddddddabc')\n    True\n    >>> same_chars('dddddddabc', 'abcd')\n    True\n    >>> same_chars('eabcd', 'dddddddabc')\n    False\n    >>> same_chars('abcd', 'dddddddabce')\n    False\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddddabc')\n    False\n    \"\"\"\n    # Convert strings to sets of unique characters for comparison.\n    # Set equality naturally handles character frequency independence and order.\n    return set(s0) == set(s1)"}
{"task_id": "HumanEval/54", "solution": "```python\ndef _extract_unique_chars(s: str) -> set:\n    \"\"\"Extracts unique characters from a string.\n    Returns a set containing all unique characters present in the input string.\n    \"\"\"\n    return set(s)\n\ndef _compare_character_sets(set1: set, set2: set) -> bool:\n    \"\"\"Compares two character sets for exact equality.\n    Returns True if both sets contain the same elements, False otherwise.\n    \"\"\"\n    return set1 == set2\n\ndef same_chars(s0: str, s1: str) -> bool:\n    \"\"\"\n    Check if two words have the same characters.\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddeddabc')\n    True\n    >>> same_chars('abcd', 'dddddddabc')\n    True\n    >>> same_chars('dddddddabc', 'abcd')\n    True\n    >>> same_chars('eabcd', 'dddddddabc')\n    False\n    >>> same_chars('abcd', 'dddddddabce')\n    False\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddddabc')\n    False\n    \"\"\"\n    unique_chars_s0 = _extract_unique_chars(s0)\n    unique_chars_s1 = _extract_unique_chars(s1)\n    return _compare_character_sets(unique_chars_s0, unique_chars_s1)\n```"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list) -> bool:\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(1, len(l)):\n        if l[i] < l[i-1]:\n            is_increasing = False\n        if l[i] > l[i-1]:\n            is_decreasing = False\n            \n    return is_increasing or is_decreasing"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n\n    >>> correct_bracketing(\"<\")\n    False\n    >>> correct_bracketing(\"<>\")\n    True\n    >>> correct_bracketing(\"<<><>>\")\n    True\n    >>> correct_bracketing(\"><<>\")\n    False\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            if balance == 0:\n                return False  # Closing bracket without a corresponding opening bracket.\n            balance -= 1\n    return balance == 0 # Final balance must be zero for all brackets to be matched."}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\"Checks if every opening bracket has a corresponding closing bracket.\n    Uses a counter-based approach for O(n) time and O(1) space complexity.\n    \"\"\"\n    counter = 0\n    for char in brackets:\n        if char == '<':\n            counter += 1\n        elif char == '>':\n            counter -= 1\n        if counter < 0:\n            return False\n    return counter == 0"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list) -> bool:\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n\n    Args:\n        l: List of integers to check for monotonic property\n\n    Returns:\n        bool: True if monotonically increasing or decreasing, False otherwise\n\n    Examples:\n        >>> monotonic([1, 2, 4, 20])\n        True\n        >>> monotonic([1, 20, 4, 10])\n        False\n        >>> monotonic([4, 1, 0, -10])\n        True\n        >>> monotonic([])\n        True\n        >>> monotonic([5])\n        True\n        >>> monotonic([3, 3, 3])\n        True\n        >>> monotonic([-1, -2, -3])\n        True\n        >>> monotonic([-5, 0, 5])\n        True\n        >>> monotonic([1, 1, 2])\n        True\n        >>> monotonic([2, 1, 1])\n        True\n        >>> monotonic([1, 3, 2])\n        False\n    \"\"\"\n    if len(l) <= 1:\n        return True # An empty or single-element list is considered monotonic.\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            is_increasing = False # Sequence is not strictly increasing.\n        if l[i] < l[i+1]:\n            is_decreasing = False # Sequence is not strictly decreasing.\n\n        if not is_increasing and not is_decreasing:\n            return False # Neither increasing nor decreasing, so not monotonic.\n\n    return is_increasing or is_decreasing # True if either condition holds."}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_factor = 1\n\n    # Handle factor 2\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Handle odd factors starting from 3\n    d = 3\n    while d * d <= n:\n        while n % d == 0:\n            largest_factor = d\n            n //= d\n        d += 2 # Increment by 2 to check only odd numbers\n\n    # If n is still greater than 1, it must be the largest prime factor\n    if n > 1:\n        largest_factor = n\n\n    return largest_factor"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list) -> list:\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n    \"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n    common_elements = set1.intersection(set2)\n    return sorted(list(common_elements))"}
