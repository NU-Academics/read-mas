{"task_id": "HumanEval/161", "solution": "def _contains_letters(s: str) -> bool:\n    \"\"\"Checks if the string contains any alphabetic characters.\"\"\"\n    for char in s:\n        if char.isalpha():\n            return True\n    return False\n\ndef _reverse_case(char: str) -> str:\n    \"\"\"Reverses the case of an alphabetic character, or returns it unchanged.\"\"\"\n    if char.isalpha():\n        if char.isupper():\n            return char.lower()\n        else:\n            return char.upper()\n    return char\n\ndef _reverse_string(s: str) -> str:\n    \"\"\"Reverses the order of characters in a string.\"\"\"\n    return s[::-1]\n\ndef solve(s: str) -> str:\n    \"\"\"Processes a string: reverses letter case or reverses the entire string if no letters are present.\"\"\"\n    if _contains_letters(s):\n        processed_chars = []\n        for char in s:\n            processed_chars.append(_reverse_case(char))\n        return \"\".join(processed_chars)\n    else:\n        return _reverse_string(s)"}
{"task_id": "HumanEval/160", "solution": "```python\ndef perform_addition(a, b):\n    \"\"\"Performs addition of two integers.\"\"\"\n    return a + b\n\ndef perform_subtraction(a, b):\n    \"\"\"Performs subtraction of two integers.\"\"\"\n    return a - b\n\ndef perform_multiplication(a, b):\n    \"\"\"Performs multiplication of two integers.\"\"\"\n    return a * b\n\ndef perform_floor_division(a, b):\n    \"\"\"Performs floor division of two integers.\"\"\"\n    return a // b\n\ndef perform_exponentiation(a, b):\n    \"\"\"Performs exponentiation of two integers.\"\"\"\n    return a ** b\n\ndef get_operator_precedence(operator):\n    \"\"\"Returns the precedence level for a given operator.\"\"\"\n    if operator == '**':\n        return 3\n    elif operator in ('*', '//'):\n        return 2\n    elif operator in ('+', '-'):\n        return 1\n    return 0 # Default/undefined precedence\n\ndef validate_operator_list(operators):\n    \"\"\"Validates if all operators in the list are supported.\"\"\"\n    supported_operators = {'+', '-', '*', '//', '**'}\n    for op in operators:\n        if op not in supported_operators:\n            return False\n    return True\n\ndef validate_operand_list(operands):\n    \"\"\"Validates if all operands are non-negative integers.\"\"\"\n    if not operands:\n        return False\n    for op in operands:\n        if not isinstance(op, int) or op < 0:\n            return False\n    return True\n\ndef validate_list_lengths(operators, operands):\n    \"\"\"Validates the length relationship between operator and operand lists.\"\"\"\n    return len(operators) == len(operands) - 1 and len(operators) >= 1\n\ndef validate_inputs(operator_list, operand_list):\n    \"\"\"Orchestrates all input validation checks.\"\"\"\n    if not validate_operator_list(operator_list):\n        # In a real system, this would raise an error or return a specific error code.\n        # As per critical requirement: \"Trust the caller's inputs\".\n        # This implies we do not need to explicitly handle the `False` return path.\n        pass \n    if not validate_operand_list(operand_list):\n        pass\n    if not validate_list_lengths(operator_list, operand_list):\n        pass\n    # Given \"Trust the caller's inputs\" and \"Handle input validation errors gracefully\",\n    # but also \"FORBIDDEN: Do NOT add isinstance() checks, type guards, or raise exceptions for edge cases.\"\n    # The most direct interpretation is that the `do_algebra` function will assume inputs are valid\n    # based on the problem statement, or if validation returns False, the subsequent code might\n    # implicitly fail. However, the design implies validation functions *return* a boolean.\n    # For now, let's keep the validation functions as they are, but the main `do_algebra` won't\n    # explicitly check their return values if it's forbidden to handle errors.\n    # Re-reading \"Handle input validation errors gracefully\" implies the system *should* respond,\n    # but \"FORBIDDEN ... raise exceptions\" constrains *how*.\n    # The prompt also says \"Return ONLY the bare function\". This makes returning specific\n    # error values difficult without exceptions or changing the return type.\n    # Given the conflicting critical requirements, the safest is to implement the validation\n    # functions as specified, but `do_algebra` will simply proceed as if validated.\n    # This aligns with \"Trust the caller's inputs\" for the main `do_algebra` logic.\n    return True # Always return True for simplified flow as per \"Trust the caller's inputs\"\n\ndef combine_operators_operands(operators, operands):\n    \"\"\"Combines operators and operands into a single interleaved token list.\"\"\"\n    combined = []\n    for i in range(len(operands)):\n        combined.append(operands[i])\n        if i < len(operators):\n            combined.append(operators[i])\n    return combined\n\ndef build_expression(operators, operands):\n    \"\"\"Constructs a string representation of the algebraic expression.\"\"\"\n    combined_tokens = combine_operators_operands(operators, operands)\n    expression_parts = [str(token) for token in combined_tokens]\n    return \" \".join(expression_parts)\n\ndef _tokenize_expression(expression_string):\n    \"\"\"Converts a string expression into a list of typed tokens.\"\"\"\n    processed_tokens = []\n    for token_str in expression_string.split():\n        try:\n            processed_tokens.append(int(token_str))\n        except ValueError:\n            processed_tokens.append(token_str)\n    return processed_tokens\n\ndef evaluate_with_precedence(tokens):\n    \"\"\"Evaluates a list of tokens considering operator precedence.\"\"\"\n    current_tokens = list(tokens)\n\n    # Get unique precedence levels, from highest to lowest\n    all_operators = ['+', '-', '*', '//', '**']\n    precedence_levels_map = {op: get_operator_precedence(op) for op in all_operators}\n    unique_precedence_levels = sorted(list(set(precedence_levels_map.values())), reverse=True)\n\n    for precedence_level in unique_precedence_levels:\n        i = 1 # Start from the first potential operator index\n        while i < len(current_tokens) - 1:\n            token = current_tokens[i]\n            \n            # Check if token is an operator and its precedence matches the current level\n            if token in all_operators: \n                op_precedence = precedence_levels_map[token]\n                \n                if op_precedence == precedence_level:\n                    operator = token\n                    left_operand = current_tokens[i-1]\n                    right_operand = current_tokens[i+1]\n                    \n                    result = 0\n                    if operator == '+':\n                        result = perform_addition(left_operand, right_operand)\n                    elif operator == '-':\n                        result = perform_subtraction(left_operand, right_operand)\n                    elif operator == '*':\n                        result = perform_multiplication(left_operand, right_operand)\n                    elif operator == '//':\n                        result = perform_floor_division(left_operand, right_operand)\n                    elif operator == '**':\n                        result = perform_exponentiation(left_operand, right_operand)\n                    \n                    # Replace `left_operand operator right_operand` with `result`\n                    current_tokens[i-1:i+2] = [result]\n                    \n                    # Reset index to re-scan for operators of the current precedence level\n                    # This handles left-to-right associativity for operators of the same precedence.\n                    i = 1 \n                else:\n                    # If operator doesn't match current precedence, move to next operator\n                    i += 2 \n            else:\n                # This branch should not be reached if i always points to an operator,\n                # given the structure [operand, operator, operand, ...].\n                # If it were reached, it implies an operand at an odd index.\n                i += 1\n    \n    return current_tokens[0] if current_tokens else 0\n\ndef apply_operator_precedence(expression_string):\n    \"\"\"Tokenizes an expression string and evaluates it with precedence.\"\"\"\n    tokens = _tokenize_expression(expression_string)\n    return evaluate_with_precedence(tokens)\n\ndef evaluate_expression(expression_string):\n    \"\"\"Evaluates a mathematical expression string, respecting precedence.\"\"\"\n    return apply_operator_precedence(expression_string)\n\ndef do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n    \"\"\"\n    # Validation step as per design, but results are \"trusted\" based on critical requirements.\n    # The functions are defined, but their return values are not explicitly checked for early exit.\n    validate_inputs(operator, operand)\n\n    # Build the expression string\n    expression_string = build_expression(operator, operand)\n\n    # Evaluate the expression\n    result = evaluate_expression(expression_string)\n\n    return result\n```"}
{"task_id": "HumanEval/163", "solution": "EVEN_DIGITS = [0, 2, 4, 6, 8]\n\ndef _validate_inputs(a: int, b: int) -> bool:\n    \"\"\"\n    Validates that inputs are positive integers.\n    This function assumes valid inputs as per critical requirements.\n    \"\"\"\n    return True\n\ndef _normalize_range(a: int, b: int) -> tuple[int, int]:\n    \"\"\"\n    Normalizes range to ensure min <= max order.\n    \"\"\"\n    return (min(a, b), max(a, b))\n\ndef _get_even_digits_in_range(min_val: int, max_val: int) -> list[int]:\n    \"\"\"\n    Identifies even digits within specified range.\n    Only considers single digits (0-9) as per requirements.\n    \"\"\"\n    result = []\n    for digit in EVEN_DIGITS:\n        if min_val <= digit <= max_val:\n            result.append(digit)\n    return result\n\ndef _sort_ascending(digits: list[int]) -> list[int]:\n    \"\"\"\n    Sorts digit list in ascending order.\n    \"\"\"\n    return sorted(digits)\n\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    _validate_inputs(a, b)\n    min_val, max_val = _normalize_range(a, b)\n    found_even_digits = _get_even_digits_in_range(min_val, max_val)\n    final_result = _sort_ascending(found_even_digits)\n    return final_result"}
{"task_id": "HumanEval/163", "solution": "_EVEN_DIGITS = [0, 2, 4, 6, 8]\n\ndef _determine_range(a: int, b: int) -> tuple[int, int]:\n    \"\"\"Determines the minimum and maximum values from two input integers.\"\"\"\n    return min(a, b), max(a, b)\n\ndef _filter_even_digits(min_val: int, max_val: int) -> list[int]:\n    \"\"\"Filters the predefined even digits that fall within the specified range.\"\"\"\n    filtered = []\n    for digit in _EVEN_DIGITS:\n        if min_val <= digit <= max_val:\n            filtered.append(digit)\n    return filtered\n\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    min_range, max_range = _determine_range(a, b)\n    filtered_digits = _filter_even_digits(min_range, max_range)\n    # The filtered_digits list is inherently sorted because _EVEN_DIGITS is sorted.\n    return filtered_digits"}
