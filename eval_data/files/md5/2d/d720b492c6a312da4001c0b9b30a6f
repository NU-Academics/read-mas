{"task_id": "HumanEval/1", "solution": "from typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    \"\"\"\n\n    def _remove_spaces(input_str: str) -> str:\n        \"\"\"Removes all spaces from the input string.\"\"\"\n        return input_str.replace(\" \", \"\")\n\n    def _is_balanced(group: str) -> bool:\n        \"\"\"Checks if a given string of parentheses is balanced.\"\"\"\n        balance = 0\n        for char in group:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    def _parse_groups_and_validate(cleaned_str: str) -> List[str]:\n        \"\"\"Parses the cleaned string into a list of potential groups and validates each.\n        Returns an empty list if the input is malformed or not fully parseable.\"\"\"\n        \n        found_groups = []\n        current_group_chars = []\n        balance_counter = 0\n        \n        for char in cleaned_str:\n            if char == '(':\n                balance_counter += 1\n                current_group_chars.append(char)\n            elif char == ')':\n                balance_counter -= 1\n                current_group_chars.append(char)\n            \n            # If balance_counter ever drops below zero, the input is malformed.\n            if balance_counter < 0:\n                return []\n            \n            # If balance_counter returns to 0, a top-level group is completed.\n            if balance_counter == 0 and current_group_chars:\n                group_str = \"\".join(current_group_chars)\n                # _is_balanced is called here to strictly follow the design's component interaction.\n                if _is_balanced(group_str): \n                    found_groups.append(group_str)\n                    current_group_chars = []\n                else:\n                    return []\n        \n        # After iterating, if balance_counter is not zero, there are unmatched opening parentheses.\n        if balance_counter != 0:\n            return []\n        \n        return found_groups\n\n    cleaned_string = _remove_spaces(paren_string)\n    return _parse_groups_and_validate(cleaned_string)"}
{"task_id": "HumanEval/4", "solution": "```python\nfrom typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"Cannot calculate MAD for empty list\")\n\n    data_mean = sum(numbers) / len(numbers)\n\n    # Calculate absolute differences between each number and the mean.\n    abs_differences = [abs(x - data_mean) for x in numbers]\n\n    # Calculate the average of these absolute differences.\n    mad_value = sum(abs_differences) / len(abs_differences)\n\n    return mad_value\n```"}
{"task_id": "HumanEval/4", "solution": "```python\nfrom typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    # Calculate the arithmetic mean of the input numbers.\n    data_count = len(numbers)\n    mean = sum(numbers) / data_count\n\n    # Compute absolute differences between each number and the mean.\n    absolute_differences = [abs(number - mean) for number in numbers]\n\n    # Calculate the average of these absolute differences.\n    mad = sum(absolute_differences) / data_count\n\n    return mad\n```"}
{"task_id": "HumanEval/5", "solution": "from typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers`.\n    The function returns a new list, preserving the original input order.\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([5], 4)\n    [5]\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    >>> intersperse([10, 20], 5)\n    [10, 5, 20]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/5", "solution": "from typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers`.\n    Handles empty and single-element lists as specified.\n    \"\"\"\n    result: List[int] = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/7", "solution": "from typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    # Create a new list containing only strings that include the specified substring.\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\ndef _split_groups(input_string: str) -> List[str]:\n    \"\"\"Splits the input string into individual parentheses groups by spaces.\n    Handles multiple spaces by filtering out empty strings.\n    \"\"\"\n    return [group for group in input_string.split(' ') if group]\n\n\ndef _calculate_depth(group: str) -> int:\n    \"\"\"Calculates the maximum nesting depth for a single parentheses group.\n    It iterates through the group to track current and maximum depth.\n    \"\"\"\n    current_depth = 0\n    max_depth = 0\n    for char in group:\n        if char == '(':\n            current_depth += 1\n            max_depth = max(max_depth, current_depth)\n        elif char == ')':\n            current_depth -= 1\n    return max_depth\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    \"\"\"\n    groups = _split_groups(paren_string)\n    result_depths = []\n    for group in groups:\n        depth = _calculate_depth(group)\n        result_depths.append(depth)\n    return result_depths"}
{"task_id": "HumanEval/6", "solution": "```python\nfrom typing import List\n\n\ndef _split_groups(input_string: str) -> List[str]:\n    \"\"\"Splits the input string into individual parentheses groups.\"\"\"\n    return input_string.split()\n\n\ndef _calculate_depth(group: str) -> int:\n    \"\"\"Calculates the maximum nesting depth for a single parentheses group.\"\"\"\n    current_depth = 0\n    max_depth = 0\n    for char in group:\n        if char == '(':\n            current_depth += 1\n            max_depth = max(max_depth, current_depth)\n        elif char == ')':\n            current_depth -= 1\n    return max_depth\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    groups = _split_groups(paren_string)\n    results = []\n    for group in groups:\n        results.append(_calculate_depth(group))\n    return results\n```"}
{"task_id": "HumanEval/7", "solution": "```python\nfrom typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring.\n    This function performs case-sensitive matching and preserves original order.\n    \"\"\"\n    filtered_list = []\n    for s in strings:\n        if substring in s:\n            filtered_list.append(s)\n    return filtered_list\n```"}
{"task_id": "HumanEval/8", "solution": "```python\nfrom typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    calculated_sum = sum(numbers)\n\n    calculated_product = 1\n    for num in numbers:\n        calculated_product *= num\n\n    return (calculated_sum, calculated_product)\n```"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome.\n    It compares the string with its reversed version.\n    \"\"\"\n    return string == string[::-1]\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    It finds the longest palindromic postfix and appends the reversed prefix before it.\n    \"\"\"\n    n = len(string)\n    for i in range(n):\n        postfix = string[i:]\n        if is_palindrome(postfix):\n            prefix_to_reverse = string[:i]\n            return string + prefix_to_reverse[::-1]\n    return string"}
{"task_id": "HumanEval/9", "solution": "from typing import List\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    result = []\n    current_max = None\n    for num in numbers:\n        if current_max is None:\n            current_max = num\n        else:\n            current_max = max(current_max, num)\n        result.append(current_max)\n    return result"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    current_max = numbers[0]\n    result.append(current_max)\n\n    for num in numbers[1:]:\n        current_max = max(current_max, num)\n        result.append(current_max)\n\n    return result"}
{"task_id": "HumanEval/11", "solution": "from typing import List\n\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    result_chars = []\n    for char_a, char_b in zip(a, b):\n        xor_result = str(int(char_a) ^ int(char_b))\n        result_chars.append(xor_result)\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Finds the longest palindromic suffix, then appends the reverse of the remaining prefix.\n    \"\"\"\n    if not string:\n        return \"\"\n\n    longest_pal_suffix_len = 0\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            longest_pal_suffix_len = len(suffix)\n            break\n\n    remaining_prefix = string[0 : len(string) - longest_pal_suffix_len]\n    remaining_prefix_reversed = remaining_prefix[::-1]\n\n    return string + remaining_prefix_reversed"}
{"task_id": "HumanEval/11", "solution": "```python\nfrom typing import List\n\n\ndef _xor_single_bits(bit1: str, bit2: str) -> str:\n    \"\"\"Performs XOR operation on two individual bit characters.\n    Returns '0' or '1' based on the binary XOR logic.\n    \"\"\"\n    return str(int(bit1) ^ int(bit2))\n\n\ndef _perform_xor_operation(a: str, b: str) -> str:\n    \"\"\"Executes character-by-character XOR operation on two binary strings.\n    Assumes inputs are equal length and contain only '0' and '1'.\n    \"\"\"\n    result_bits = [_xor_single_bits(char_a, char_b) for char_a, char_b in zip(a, b)]\n    return \"\".join(result_bits)\n\n\ndef _validate_binary_string(s: str) -> bool:\n    \"\"\"Validates that input string contains only '0' and '1' characters.\"\"\"\n    return all(c in '01' for c in s)\n\n\ndef _validate_equal_length(a: str, b: str) -> bool:\n    \"\"\"Ensures input strings have equal length.\"\"\"\n    return len(a) == len(b)\n\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\"Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    # Per critical requirement \"Trust the caller's inputs\" and \"simplest, most direct logic possible\",\n    # the main function proceeds directly to XOR, assuming valid, equal-length binary strings.\n    return _perform_xor_operation(a, b)\n\n```"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_so_far = strings[0]\n    for s in strings:\n        if len(s) > len(longest_so_far):\n            longest_so_far = s\n    return longest_so_far"}
