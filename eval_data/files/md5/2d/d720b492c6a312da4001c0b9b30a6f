{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\"\n    brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    open_brackets_count = 0\n    for char in brackets:\n        if char == '(':\n            open_brackets_count += 1\n        elif char == ')':\n            open_brackets_count -= 1\n        if open_brackets_count < 0:  # Closing bracket without a matching open bracket\n            return False\n    return open_brackets_count == 0  # All brackets must be matched at the end"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int) -> int:\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    total_sum = 0\n    # Iterate from 1 up to n (inclusive) and add each number.\n    for i in range(1, n + 1):\n        total_sum += i\n    return total_sum"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int) -> int:\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    return (n * (n + 1)) // 2"}
{"task_id": "HumanEval/59", "solution": "import math\nfrom typing import List\n\ndef _is_prime(num: int) -> bool:\n    \"\"\"Checks if a number is prime. Optimizes by checking divisibility up to its square root.\"\"\"\n    if num < 2:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(num)) + 1, 2):\n        if num % i == 0:\n            return False\n    return True\n\ndef _find_prime_factors(n: int) -> List[int]:\n    \"\"\"Decomposes a number into all its prime factors, explicitly validating potential factors.\"\"\"\n    factors: List[int] = []\n    temp_n = n\n    d = 2\n\n    # Handle factor 2\n    if temp_n % d == 0:\n        if _is_prime(d): # Validate 2 as a prime factor as per diagram\n            while temp_n % d == 0:\n                factors.append(d)\n                temp_n //= d\n    \n    d = 3\n    # Iterate for odd factors up to the square root of the remaining number\n    while d * d <= temp_n:\n        if temp_n % d == 0:\n            if _is_prime(d): # Validate 'd' as a prime factor as per diagram\n                while temp_n % d == 0:\n                    factors.append(d)\n                    temp_n //= d\n        d += 2 # Move to the next odd number\n\n    # If temp_n is still greater than 1, it must be the largest prime factor\n    if temp_n > 1:\n        if _is_prime(temp_n): # Validate remaining temp_n as a prime factor\n            factors.append(temp_n)\n    return factors\n\ndef largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\"\"\"\n    prime_factors = _find_prime_factors(n)\n    return max(prime_factors)"}
