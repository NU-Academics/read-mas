{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\"For a given number n, find the largest number that divides n evenly, smaller than n.\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    # Iterate downwards from half of n to find the first (largest) proper divisor.\n    for i in range(n // 2, 0, -1):\n        if n % i == 0:\n            return i\n    # If no proper divisor is found (e.g., for prime numbers or 1), return 1.\n    return 1"}
{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\"For a given number n, find the largest number that divides n evenly, smaller than n.\n    This function returns the largest proper divisor of n.\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    for i in range(n - 1, 0, -1):\n        if n % i == 0:\n            return i\n    return 1"}
{"task_id": "HumanEval/25", "solution": "```python\nfrom typing import List\n\n\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n\n    def _validate_input(n_val: int) -> bool:\n        # Per critical requirement, this function assumes valid input and does not raise exceptions.\n        # It always returns True, adhering to the \"Trust the caller's inputs\" constraint.\n        return True\n\n    def _calculate_factors(num_to_factor: int) -> List[int]:\n        # Computes the prime factors of num_to_factor and returns them in an ordered list.\n        # The algorithm iteratively finds and divides by the smallest prime factor.\n        factors = []\n        divisor = 2\n        temp_n = num_to_factor\n\n        while temp_n > 1:\n            if temp_n % divisor == 0:\n                factors.append(divisor)\n                temp_n //= divisor\n            else:\n                divisor += 1\n        return factors\n\n    def _verify_result(factors_list: List[int], original_num: int) -> bool:\n        # Verifies if the product of the factors list equals the original number.\n        # This function returns a boolean; it does not raise exceptions per critical requirements.\n        if not factors_list:\n            return original_num == 1\n        product = 1\n        for factor in factors_list:\n            product *= factor\n        return product == original_num\n\n    original_n = n\n\n    # Perform input validation. Per critical requirements, this will not raise errors.\n    _validate_input(original_n)\n\n    # Calculate the prime factors.\n    result_factors = _calculate_factors(original_n)\n\n    # Verify the correctness of the factorization. Per critical requirements, this will not raise errors.\n    _verify_result(result_factors, original_n)\n\n    return result_factors\n```"}
{"task_id": "HumanEval/25", "solution": "from typing import List\n\n\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    factors = []\n    divisor = 2\n    while divisor * divisor <= n:\n        while n % divisor == 0:\n            factors.append(divisor)\n            n //= divisor\n        divisor += 1\n    if n > 1:\n        factors.append(n)\n    return factors"}
{"task_id": "HumanEval/26", "solution": "from typing import List\n\n\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    seen = set()\n    result = []\n    for number in numbers:\n        if number not in seen:\n            seen.add(number)\n            result.append(number)\n    return result"}
{"task_id": "HumanEval/26", "solution": "from typing import List, Dict\n\n\ndef count_occurrences(numbers: List[int]) -> Dict[int, int]:\n    \"\"\"Counts the frequency of each element in a list.\n    Returns a dictionary mapping elements to their counts.\"\"\"\n    counts: Dict[int, int] = {}\n    for number in numbers:\n        counts[number] = counts.get(number, 0) + 1\n    return counts\n\n\ndef filter_unique_elements(numbers: List[int], counts: Dict[int, int]) -> List[int]:\n    \"\"\"Filters elements that appear exactly once based on their counts.\n    Preserves the original order of unique elements.\"\"\"\n    result: List[int] = []\n    for number in numbers:\n        if counts[number] == 1:\n            result.append(number)\n    return result\n\n\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\"From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\"\"\"\n    if not numbers:\n        return []\n\n    element_counts = count_occurrences(numbers)\n    filtered_list = filter_unique_elements(numbers, element_counts)\n    return filtered_list"}
{"task_id": "HumanEval/27", "solution": "def flip_case(string: str) -> str:\n    \"\"\" For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    Non-alphabetic characters are preserved in their original positions.\n    >>> flip_case('Hello')\n    'hELLO'\n    \"\"\"\n    transformed_chars = []\n    for char in string:\n        if char.isupper():\n            transformed_chars.append(char.lower())\n        elif char.islower():\n            transformed_chars.append(char.upper())\n        else:\n            transformed_chars.append(char)\n    return \"\".join(transformed_chars)"}
{"task_id": "HumanEval/27", "solution": "def flip_case(string: str) -> str:\n    \"\"\"For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n\n    Args:\n        string (str): Input string to transform\n\n    Returns:\n        str: String with flipped character cases\n\n    Examples:\n        >>> flip_case('Hello')\n        'hELLO'\n        >>> flip_case('')\n        ''\n        >>> flip_case('Hello123!')\n        'hELLO123!'\n    \"\"\"\n    flipped_chars = []\n    for char in string:\n        if char.islower():\n            flipped_chars.append(char.upper())\n        elif char.isupper():\n            flipped_chars.append(char.lower())\n        else:\n            flipped_chars.append(char)\n    return \"\".join(flipped_chars)"}
