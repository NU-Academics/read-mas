{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n\n    def _get_divisible_indices(list_length: int) -> list[int]:\n        \"\"\"Identifies indices divisible by three in a list of given length.\n        Returns a list of these indices.\"\"\"\n        indices = []\n        for i in range(list_length):\n            if i % 3 == 0:\n                indices.append(i)\n        return indices\n\n    def _extract_elements(input_list: list, indices: list[int]) -> list:\n        \"\"\"Extracts elements from input_list at the specified indices.\n        Returns a new list containing these extracted elements.\"\"\"\n        extracted = []\n        for i in indices:\n            extracted.append(input_list[i])\n        return extracted\n\n    def _reconstruct_list(original_list: list, sorted_elements: list, divisible_indices: list[int]) -> list:\n        \"\"\"Reconstructs the list, placing sorted_elements at divisible_indices.\n        Returns a new list with the modifications.\"\"\"\n        reconstructed = list(original_list)\n        element_idx = 0\n        for list_idx in divisible_indices:\n            reconstructed[list_idx] = sorted_elements[element_idx]\n            element_idx += 1\n        return reconstructed\n\n    list_length = len(l)\n\n    if list_length < 3:\n        return l\n\n    divisible_indices = _get_divisible_indices(list_length)\n    elements_to_sort = _extract_elements(l, divisible_indices)\n    \n    sorted_elements = sorted(elements_to_sort)\n\n    result_list = _reconstruct_list(l, sorted_elements, divisible_indices)\n\n    return result_list"}
{"task_id": "HumanEval/36", "solution": "```python\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_digit_7_count = 0\n    for num in range(n):\n        # Check if the current number is divisible by 11 or 13.\n        if num % 11 == 0 or num % 13 == 0:\n            # Count digit '7' occurrences in the qualifying number.\n            total_digit_7_count += str(num).count('7')\n    return total_digit_7_count\n```"}
{"task_id": "HumanEval/36", "solution": "def _is_divisible_by_11(num: int) -> bool:\n    \"\"\"Checks if a number is divisible by 11.\"\"\"\n    return num % 11 == 0\n\ndef _is_divisible_by_13(num: int) -> bool:\n    \"\"\"Checks if a number is divisible by 13.\"\"\"\n    return num % 13 == 0\n\ndef _count_digit_7(num: int) -> int:\n    \"\"\"Counts occurrences of the digit 7 in a number.\"\"\"\n    return str(num).count('7')\n\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_count = 0\n    for i in range(1, n):\n        if _is_divisible_by_11(i) or _is_divisible_by_13(i):\n            total_count += _count_digit_7(i)\n    return total_count"}
{"task_id": "HumanEval/37", "solution": "```python\ndef sort_even(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    # Extract elements from even indices using a list comprehension.\n    even_indexed_elements = [l[i] for i in range(0, len(l), 2)]\n\n    # Sort the extracted even elements in ascending order.\n    sorted_even_elements = sorted(even_indexed_elements)\n\n    # Create a new list as a copy of the original to preserve odd-indexed elements.\n    result_list = list(l)\n\n    # Place the sorted even elements back into the even indices of the new list.\n    sorted_even_idx_counter = 0\n    for i in range(0, len(l), 2):\n        result_list[i] = sorted_even_elements[sorted_even_idx_counter]\n        sorted_even_idx_counter += 1\n\n    return result_list\n```"}
{"task_id": "HumanEval/37", "solution": "def extract_even_elements(l: list) -> list:\n    \"\"\"Extracts elements at even indices from the input list.\n    Returns a new list containing these elements.\"\"\"\n    even_elements = []\n    for i in range(0, len(l), 2):\n        even_elements.append(l[i])\n    return even_elements\n\ndef sort_elements(elements: list) -> list:\n    \"\"\"Sorts a list of elements in ascending order.\n    Utilizes Python's built-in sorted() function for efficiency.\"\"\"\n    return sorted(elements)\n\ndef merge_sorted_elements(original_list: list, sorted_even: list) -> list:\n    \"\"\"Merges sorted even elements back into the original list structure.\n    Preserves elements at odd indices and replaces even-indexed elements.\"\"\"\n    result = original_list[:]\n    sorted_idx = 0\n    for i in range(0, len(original_list), 2):\n        if sorted_idx < len(sorted_even):\n            result[i] = sorted_even[sorted_idx]\n            sorted_idx += 1\n    return result\n\ndef sort_even(l: list) -> list:\n    \"\"\"This function sorts elements at even indices in a list while preserving odd indices.\n    It orchestrates extraction, sorting, and merging of elements.\"\"\"\n    if len(l) < 2:\n        return l\n\n    even_elements = extract_even_elements(l)\n    sorted_evens = sort_elements(even_elements)\n    final_list = merge_sorted_elements(l, sorted_evens)\n    return final_list"}
{"task_id": "HumanEval/38", "solution": "def encode_cyclic(s: str):\n    \"\"\"\n    returns encoded string by cycling groups of three characters.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[1:] + group[0]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)\n\n\ndef decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # Split the encoded string into groups of three characters, mirroring the encoding process.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # Reverse the cyclic shift for groups of three characters by moving the last char to the front.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "def is_prime(num: int) -> bool:\n    \"\"\"\n    Checks if a given number is prime.\n    Returns True if prime, False otherwise.\n    \"\"\"\n    if num <= 1:\n        return False\n    if num <= 3:\n        return True\n    if num % 2 == 0 or num % 3 == 0:\n        return False\n    i = 5\n    while i * i <= num:\n        if num % i == 0 or num % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef fibonacci_generator():\n    \"\"\"\n    Generates an infinite sequence of Fibonacci numbers starting with 0, 1.\n    Yields each Fibonacci number in order.\n    \"\"\"\n    a, b = 0, 1\n    while True:\n        yield a\n        a, b = b, a + b\n\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    prime_count = 0\n    fib_gen = fibonacci_generator()\n\n    while True:\n        fib_num = next(fib_gen)\n        if fib_num < 2: # 0 and 1 are not prime numbers.\n            continue\n        \n        if is_prime(fib_num):\n            prime_count += 1\n            if prime_count == n:\n                return fib_num"}
{"task_id": "HumanEval/38", "solution": "def _split_into_groups(s: str) -> list[str]:\n    \"\"\"Splits a string into groups of up to three characters.\"\"\"\n    return [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n\ndef _cycle_group_forward(group: str) -> str:\n    \"\"\"Cycles a 3-character group forward (first char to end).\"\"\"\n    return (group[1:] + group[0]) if len(group) == 3 else group\n\ndef _cycle_group_backward(group: str) -> str:\n    \"\"\"Cycles a 3-character group backward (last char to front).\"\"\"\n    return (group[-1] + group[:-1]) if len(group) == 3 else group\n\ndef encode_cyclic(s: str):\n    \"\"\"Returns an encoded string by cycling groups of three characters.\"\"\"\n    groups = _split_into_groups(s)\n    cycled_groups = [_cycle_group_forward(group) for group in groups]\n    return \"\".join(cycled_groups)\n\ndef decode_cyclic(s: str):\n    \"\"\"Decodes a string encoded with encode_cyclic function.\"\"\"\n    groups = _split_into_groups(s)\n    decycled_groups = [_cycle_group_backward(group) for group in groups]\n    return \"\".join(decycled_groups)"}
{"task_id": "HumanEval/39", "solution": "```python\nimport math\n\ndef is_prime(number: int) -> bool:\n    \"\"\"\n    Checks if a given number is prime. It uses trial division up to the square root of the number.\n    \"\"\"\n    if number < 2:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    for i in range(3, math.isqrt(number) + 1, 2):\n        if number % i == 0:\n            return False\n    return True\n\ndef fibonacci_generator():\n    \"\"\"\n    Generates Fibonacci sequence numbers indefinitely. It yields numbers starting from 0, 1, 1, 2, 3, ...\n    \"\"\"\n    a, b = 0, 1\n    yield a\n    yield b\n    while True:\n        a, b = b, a + b\n        yield b\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    prime_count = 0\n    fib_gen = fibonacci_generator()\n\n    while True:\n        fib_num = next(fib_gen)\n        # Fibonacci numbers 0 and 1 are not prime.\n        if fib_num <= 1:\n            continue\n        \n        if is_prime(fib_num):\n            prime_count += 1\n            if prime_count == n:\n                return fib_num\n```"}
