{"task_id": "HumanEval/80", "solution": "def _check_length(s: str) -> bool:\n    \"\"\"Checks if the string length is at least 3 characters.\"\"\"\n    return len(s) >= 3\n\ndef _are_distinct(char1: str, char2: str, char3: str) -> bool:\n    \"\"\"Checks if three characters are all distinct.\"\"\"\n    return len({char1, char2, char3}) == 3\n\ndef _get_consecutive_triplets(s: str) -> list[tuple[str, str, str]]:\n    \"\"\"Extracts all consecutive character triplets from the string.\"\"\"\n    triplets = []\n    for i in range(len(s) - 2):\n        triplets.append((s[i], s[i+1], s[i+2]))\n    return triplets\n\ndef is_happy(s):\n    \"\"\"Checks if a string is happy based on length and distinct consecutive characters.\n    A string is happy if its length is at least 3 and every 3 consecutive letters are distinct.\n    \"\"\"\n    if not _check_length(s):\n        return False\n\n    triplets = _get_consecutive_triplets(s)\n    for t in triplets:\n        if not _are_distinct(t[0], t[1], t[2]):\n            return False\n            \n    return True"}
{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"Checks if a string is happy based on length and distinct consecutive characters.\n    A string is happy if its length is at least 3 and every 3 consecutive letters are distinct.\n    \"\"\"\n\n    def _check_minimum_length(s_param: str) -> bool:\n        \"\"\"Validates if the string meets the minimum length requirement (>= 3).\"\"\"\n        return len(s_param) >= 3\n\n    def _has_distinct_chars(window: str) -> bool:\n        \"\"\"Checks if a 3-character window contains only distinct characters.\"\"\"\n        return len(set(window)) == 3\n\n    def _validate_consecutive_chars(s_param: str) -> bool:\n        \"\"\"Validates that every 3 consecutive characters in the string are distinct.\"\"\"\n        # Iterate through the string with a sliding window of size 3\n        for i in range(len(s_param) - 2):\n            window = s_param[i:i+3]\n            if not _has_distinct_chars(window):\n                return False\n        return True\n\n    if not _check_minimum_length(s):\n        return False\n\n    return _validate_consecutive_chars(s)"}
{"task_id": "HumanEval/82", "solution": "def _is_prime(n: int) -> bool:\n    \"\"\"Determines if a number is prime.\n    This helper checks for primality using an optimized trial division method.\"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    Examples\n    prime_length('Hello') == True\n    prime_length('abcdcba') == True\n    prime_length('kittens') == True\n    prime_length('orange') == False\n    \"\"\"\n    length = len(string)\n    return _is_prime(length)"}
{"task_id": "HumanEval/82", "solution": "def _calculate_length(string: str) -> int:\n    \"\"\"Calculates the length of the input string.\"\"\"\n    return len(string)\n\ndef _is_prime(n: int) -> bool:\n    \"\"\"Checks if a number is prime with O(\u221an) complexity.\"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    \n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef prime_length(string: str) -> bool:\n    \"\"\"Checks if the length of a string is a prime number.\"\"\"\n    length = _calculate_length(string)\n    return _is_prime(length)"}
{"task_id": "HumanEval/83", "solution": "def validate_positive_integer(n: int) -> bool:\n    \"\"\"Validates if the input n is a positive integer.\n    Per critical requirements, this function assumes valid input and performs no checks.\n    \"\"\"\n    return True\n\ndef count_starting_with_1(n: int) -> int:\n    \"\"\"Calculates the count of n-digit positive integers that start with the digit 1.\"\"\"\n    return 10**(n - 1)\n\ndef count_ending_with_1(n: int) -> int:\n    \"\"\"Calculates the count of n-digit positive integers that end with the digit 1.\"\"\"\n    if n == 1:\n        return 1\n    return 9 * (10**(n - 2))\n\ndef count_both_start_end_1(n: int) -> int:\n    \"\"\"Calculates the count of n-digit positive integers that both start and end with the digit 1.\"\"\"\n    if n == 1:\n        return 1\n    return 10**(n - 2)\n\ndef apply_inclusion_exclusion(starts: int, ends: int, both: int) -> int:\n    \"\"\"Applies the inclusion-exclusion principle to calculate the total count.\"\"\"\n    return starts + ends - both\n\ndef starts_one_ends(n: int) -> int:\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    # The validate_positive_integer function is present as per design,\n    # but does not perform checks due to critical requirements.\n    if not validate_positive_integer(n):\n        # This branch will not be taken based on critical requirements.\n        return 0 \n\n    starts_count = count_starting_with_1(n)\n    ends_count = count_ending_with_1(n)\n    both_count = count_both_start_end_1(n)\n    \n    total_count = apply_inclusion_exclusion(starts_count, ends_count, both_count)\n    \n    return total_count"}
{"task_id": "HumanEval/83", "solution": "def validate_positive_integer(n: int) -> bool:\n    \"\"\"\n    Checks if n is a positive integer.\n    Per design, this function trusts the caller's input for validity.\n    \"\"\"\n    return n > 0\n\ndef count_starting_with_1(n: int) -> int:\n    \"\"\"\n    Calculates the count of n-digit numbers starting with 1.\n    Uses direct mathematical formula for O(1) complexity.\n    \"\"\"\n    if n == 1:\n        return 1\n    else:\n        return 10**(n - 1)\n\ndef count_ending_with_1(n: int) -> int:\n    \"\"\"\n    Calculates the count of n-digit numbers ending with 1.\n    Uses direct mathematical formula for O(1) complexity.\n    \"\"\"\n    if n == 1:\n        return 1\n    else:\n        return 9 * (10**(n - 2))\n\ndef count_both_start_end_1(n: int) -> int:\n    \"\"\"\n    Calculates the count of n-digit numbers starting and ending with 1.\n    Uses direct mathematical formula for O(1) complexity.\n    \"\"\"\n    if n <= 2:\n        return 1\n    else:\n        return 10**(n - 2)\n\ndef apply_inclusion_exclusion(start_count: int, end_count: int, both_count: int) -> int:\n    \"\"\"\n    Applies the inclusion-exclusion principle to calculate the total unique count.\n    Sums individual counts and subtracts the overlap.\n    \"\"\"\n    return start_count + end_count - both_count\n\ndef starts_one_ends(n: int) -> int:\n    \"\"\"\n    Counts n-digit positive integers that start or end with the digit 1.\n    Utilizes O(1) mathematical formulas and the inclusion-exclusion principle.\n    \"\"\"\n    # The design specified input validation, but CRITICAL requirements state to trust inputs.\n    # The validation function is included but simplified per critical requirements.\n    # We proceed assuming 'n' is a valid positive integer based on critical requirements.\n    validate_positive_integer(n) # This call serves its architectural purpose.\n\n    start_count = count_starting_with_1(n)\n    end_count = count_ending_with_1(n)\n    both_count = count_both_start_end_1(n)\n\n    total_count = apply_inclusion_exclusion(start_count, end_count, both_count)\n\n    return total_count"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPA values (0.0-4.0) to corresponding letter grades based on a predefined 13-level scale.\n    Maintains input order and handles boundary conditions.\"\"\"\n    \n    letter_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            letter_grades.append(\"A+\")\n        elif gpa > 3.7:\n            letter_grades.append(\"A\")\n        elif gpa > 3.3:\n            letter_grades.append(\"A-\")\n        elif gpa > 3.0:\n            letter_grades.append(\"B+\")\n        elif gpa > 2.7:\n            letter_grades.append(\"B\")\n        elif gpa > 2.3:\n            letter_grades.append(\"B-\")\n        elif gpa > 2.0:\n            letter_grades.append(\"C+\")\n        elif gpa > 1.7:\n            letter_grades.append(\"C\")\n        elif gpa > 1.3:\n            letter_grades.append(\"C-\")\n        elif gpa > 1.0:\n            letter_grades.append(\"D+\")\n        elif gpa > 0.7:\n            letter_grades.append(\"D\")\n        elif gpa > 0.0:\n            letter_grades.append(\"D-\")\n        elif gpa == 0.0:\n            letter_grades.append(\"E\")\n    return letter_grades"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"\n    Convert list of GPA values to corresponding letter grades.\n    This implements a specific grading algorithm based on precise thresholds.\n    \"\"\"\n    letter_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            letter_grades.append(\"A+\")\n        elif gpa > 3.7:\n            letter_grades.append(\"A\")\n        elif gpa > 3.3:\n            letter_grades.append(\"A-\")\n        elif gpa > 3.0:\n            letter_grades.append(\"B+\")\n        elif gpa > 2.7:\n            letter_grades.append(\"B\")\n        elif gpa > 2.3:\n            letter_grades.append(\"B-\")\n        elif gpa > 2.0:\n            letter_grades.append(\"C+\")\n        elif gpa > 1.7:\n            letter_grades.append(\"C\")\n        elif gpa > 1.3:\n            letter_grades.append(\"C-\")\n        elif gpa > 1.0:\n            letter_grades.append(\"D+\")\n        elif gpa > 0.7:\n            letter_grades.append(\"D\")\n        elif gpa > 0.0:\n            letter_grades.append(\"D-\")\n        elif gpa == 0.0:\n            letter_grades.append(\"E\")\n    return letter_grades"}
{"task_id": "HumanEval/84", "solution": "def digit_sum(n: int) -> int:\n    \"\"\"Calculates the sum of all digits in the decimal representation of n.\"\"\"\n    total = 0\n    for digit_char in str(n):\n        total += int(digit_char)\n    return total\n\ndef to_binary(decimal: int) -> str:\n    \"\"\"Converts a non-negative decimal integer to its binary string representation.\"\"\"\n    if decimal == 0:\n        return \"0\"\n    binary_string = \"\"\n    while decimal > 0:\n        remainder = decimal % 2\n        binary_string = str(remainder) + binary_string\n        decimal //= 2\n    return binary_string\n\ndef solve(N):\n    \"\"\"Orchestrates digit sum calculation and converts the sum to a binary string.\"\"\"\n    sum_digits = digit_sum(N)\n    binary_result = to_binary(sum_digits)\n    return binary_result"}
{"task_id": "HumanEval/84", "solution": "def _validate_range(N: int) -> bool:\n    \"\"\"Checks if N is within the valid range [0, 10000].\"\"\"\n    return 0 <= N <= 10000\n\ndef _is_valid_input(N: int) -> bool:\n    \"\"\"Performs comprehensive input validation for N.\"\"\"\n    return _validate_range(N)\n\ndef _extract_digits(N: int) -> list[int]:\n    \"\"\"Extracts individual digits from a decimal number N.\"\"\"\n    return [int(d) for d in str(N)]\n\ndef _sum_digits(digits: list[int]) -> int:\n    \"\"\"Calculates the sum of a list of digits.\"\"\"\n    return sum(digits)\n\ndef _calculate_digit_sum(N: int) -> int:\n    \"\"\"Calculates the sum of all digits in N.\"\"\"\n    digits = _extract_digits(N)\n    return _sum_digits(digits)\n\ndef _to_binary_string(value: int) -> str:\n    \"\"\"Converts an integer to its binary string representation.\"\"\"\n    return bin(value)[2:]\n\ndef solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    \n    Example\n        For N = 1000, the sum of digits will be 1 the output should be \"1\".\n        For N = 150, the sum of digits will be 6 the output should be \"110\".\n        For N = 147, the sum of digits will be 12 the output should be \"1100\".\n    \n    Variables:\n        @N integer\n             Constraints: 0 \u2264 N \u2264 10000.\n    Output:\n         a string of binary number\n    \"\"\"\n    # Orchestrates digit sum to binary conversion, trusting inputs as valid.\n    _is_valid_input(N)\n    \n    digit_sum = _calculate_digit_sum(N)\n    binary_string = _to_binary_string(digit_sum)\n\n    return binary_string"}
{"task_id": "HumanEval/85", "solution": "def is_even(number):\n    \"\"\"Checks if a number is even.\"\"\"\n    return number % 2 == 0\n\ndef calculate_sum(numbers):\n    \"\"\"Calculates the sum of a list of numbers.\"\"\"\n    return sum(numbers)\n\ndef is_odd_index(index):\n    \"\"\"Checks if an index is odd.\"\"\"\n    return index % 2 != 0\n\ndef get_elements_at_odd_indices(lst):\n    \"\"\"Extracts elements from a list located at odd indices.\"\"\"\n    elements = []\n    for i in range(len(lst)):\n        if is_odd_index(i):\n            elements.append(lst[i])\n    return elements\n\ndef filter_even_numbers(numbers):\n    \"\"\"Filters a list to return only even numbers.\"\"\"\n    return [num for num in numbers if is_even(num)]\n\ndef add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices.\"\"\"\n    \n    # Identify elements at odd indices from the input list.\n    elements_at_odd_indices = get_elements_at_odd_indices(lst)\n    \n    # Filter only the even numbers from the identified elements.\n    even_numbers_at_odd_indices = filter_even_numbers(elements_at_odd_indices)\n    \n    # Calculate the sum of the filtered even numbers.\n    final_sum = calculate_sum(even_numbers_at_odd_indices)\n    \n    return final_sum"}
{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices.\n    Examples:\n        add([4, 2, 6, 7]) ==> 2 \n    \"\"\"\n    total_sum = 0\n    for index, value in enumerate(lst):\n        if index % 2 != 0:  # Check if the index is odd\n            if value % 2 == 0:  # Check if the element at the odd index is even\n                total_sum += value\n    return total_sum"}
{"task_id": "HumanEval/87", "solution": "```python\ndef _validate_input(lst):\n    \"\"\"\n    Validates if the input list is not empty.\n    Returns False for empty lists, True otherwise.\n    \"\"\"\n    return bool(lst)\n\ndef _find_coordinates(lst, x):\n    \"\"\"\n    Locates all occurrences of the search value x in the nested list lst.\n    Returns a list of (row, column) coordinate tuples using zero-based indexing.\n    \"\"\"\n    found_coordinates = []\n    for row_idx, row in enumerate(lst):\n        for col_idx, item in enumerate(row):\n            if item == x:\n                found_coordinates.append((row_idx, col_idx))\n    return found_coordinates\n\ndef _sort_coordinates(coordinates):\n    \"\"\"\n    Sorts a list of coordinate tuples.\n    Primarily sorts by row in ascending order, then by column in descending order.\n    \"\"\"\n    # Sort by row (ascending) and then by column (descending)\n    # To achieve descending sort for the second key, we negate the column index.\n    return sorted(coordinates, key=lambda coord: (coord[0], -coord[1]))\n\ndef get_row(lst, x):\n    \"\"\"\n    Searches for an integer x in a 2D nested list (jagged array).\n    Returns a list of (row, column) coordinates where x is found, sorted by row ascending and column descending.\n    \"\"\"\n    if not _validate_input(lst):\n        return []\n\n    coordinates = _find_coordinates(lst, x)\n\n    return _sort_coordinates(coordinates)\n```"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds occurrences of an integer x in a 2D nested list and returns their sorted coordinates.\n    Coordinates are (row, column) with zero-based indexing.\n    \"\"\"\n\n    if not lst:\n        return []\n\n    def _find_coordinates(data_list, target_value):\n        \"\"\"Collects all (row, column) coordinates where target_value is found.\"\"\"\n        coordinates = []\n        for r_idx, row in enumerate(data_list):\n            for c_idx, val in enumerate(row):\n                if val == target_value:\n                    coordinates.append((r_idx, c_idx))\n        return coordinates\n\n    def _sort_coordinates(coords_list):\n        \"\"\"Sorts coordinates primarily by row (ascending) and secondarily by column (descending).\"\"\"\n        # Sort key: (row, -column) achieves row ascending, column descending.\n        return sorted(coords_list, key=lambda coord: (coord[0], -coord[1]))\n\n    raw_coordinates = _find_coordinates(lst, x)\n    sorted_results = _sort_coordinates(raw_coordinates)\n\n    return sorted_results"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n\n    For example:\n    anti_shuffle('Hi') returns 'Hi'\n    anti_shuffle('hello') returns 'ehllo'\n    anti_shuffle('Hello World!!!') returns 'Hello !!!Wdlor'\n    \"\"\"\n\n    def sort_word_characters(word: str) -> str:\n        \"\"\"Sort characters within a word by ASCII value.\"\"\"\n        return \"\".join(sorted(word))\n\n    def split_preserving_spaces(s: str) -> tuple[list[str], list[int]]:\n        \"\"\"Split string into words while tracking space positions.\"\"\"\n        words = []\n        space_positions = []\n        current_word_chars = []\n\n        for i, char in enumerate(s):\n            if char == ' ':\n                if current_word_chars:\n                    words.append(\"\".join(current_word_chars))\n                    current_word_chars = []\n                space_positions.append(i)\n            else:\n                current_word_chars.append(char)\n\n        if current_word_chars:\n            words.append(\"\".join(current_word_chars))\n\n        return words, space_positions\n\n    def reconstruct_string(words: list[str], space_positions: list[int]) -> str:\n        \"\"\"Rebuild string from processed words and original spacing.\"\"\"\n        total_length = sum(len(word) for word in words) + len(space_positions)\n        result_chars = [''] * total_length\n\n        for pos in space_positions:\n            result_chars[pos] = ' '\n\n        word_idx = 0\n        current_char_idx = 0\n        while word_idx < len(words):\n            # Skip over space positions\n            while current_char_idx < total_length and result_chars[current_char_idx] == ' ':\n                current_char_idx += 1\n            \n            # Place the current word if there are more words to place\n            if word_idx < len(words):\n                word = words[word_idx]\n                for char_in_word in word:\n                    if current_char_idx < total_length: # Safety check\n                        result_chars[current_char_idx] = char_in_word\n                        current_char_idx += 1\n                word_idx += 1\n\n        return \"\".join(result_chars)\n\n    # Main orchestration for anti_shuffle\n    words, space_positions = split_preserving_spaces(s)\n\n    processed_words = [sort_word_characters(word) for word in words]\n\n    return reconstruct_string(processed_words, space_positions)"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Transforms input strings by sorting characters within each word while preserving word order and spacing.\n    This function coordinates parsing, sorting, and reconstruction of the string.\n    \"\"\"\n\n    # Handle edge cases for empty or all-space strings directly to preserve original spacing.\n    if not s or s.isspace():\n        return s\n\n    def split_into_words(input_string: str) -> list[str]:\n        \"\"\"Splits the input string into a list of words (contiguous non-space sequences).\"\"\"\n        words = []\n        current_word_chars = []\n        for char in input_string:\n            if char != ' ':\n                current_word_chars.append(char)\n            else:\n                if current_word_chars:\n                    words.append(\"\".join(current_word_chars))\n                    current_word_chars = []\n        if current_word_chars:  # Add the last word if string doesn't end with a space\n            words.append(\"\".join(current_word_chars))\n        return words\n\n    def extract_spacing_info(input_string: str) -> list[int]:\n        \"\"\"Extracts the number of spaces preceding each word in the input string.\"\"\"\n        spacing = []\n        current_space_count = 0\n        i = 0\n        while i < len(input_string):\n            if input_string[i] == ' ':\n                current_space_count += 1\n                i += 1\n            else:  # Found a non-space character, which marks the start of a word\n                spacing.append(current_space_count)\n                current_space_count = 0  # Reset for the next inter-word spacing\n                # Skip characters of the current word\n                while i < len(input_string) and input_string[i] != ' ':\n                    i += 1\n        return spacing\n\n    def sort_word_characters(word: str) -> str:\n        \"\"\"Sorts characters within a word by their ASCII value in ascending order.\"\"\"\n        return \"\".join(sorted(word))\n\n    def reconstruct_string(words: list[str], spacing_info: list[int]) -> str:\n        \"\"\"Reconstructs the full string by combining sorted words with their preceding spaces.\"\"\"\n        result_parts = []\n        for idx, word in enumerate(words):\n            # Prepend spaces based on the extracted spacing information\n            result_parts.append(' ' * spacing_info[idx])\n            result_parts.append(word)\n        return \"\".join(result_parts)\n\n    # Main coordination logic\n    words = split_into_words(s)\n    spacing_info = extract_spacing_info(s)\n\n    # Sort characters for each extracted word\n    sorted_words = [sort_word_characters(word) for word in words]\n\n    # Reconstruct the string with sorted words and preserved spacing\n    result = reconstruct_string(sorted_words, spacing_info)\n\n    # Append any trailing spaces from the original string that were not part of inter-word spacing.\n    # This is necessary because `spacing_info` only tracks spaces *before* words.\n    last_word_end_index = 0\n    if words: # If there were words, find the end of the last word in the original string\n        temp_s = s\n        for _ in range(len(words)):\n            # Find the first non-space char (start of current word)\n            word_start = 0\n            while word_start < len(temp_s) and temp_s[word_start] == ' ':\n                word_start += 1\n            \n            # Find the end of current word\n            word_end = word_start\n            while word_end < len(temp_s) and temp_s[word_end] != ' ':\n                word_end += 1\n            \n            # Update last_word_end_index for original string and trim temp_s for next iteration\n            if word_start < len(temp_s): # If a word was found\n                last_word_end_index += word_end\n                temp_s = temp_s[word_end:]\n            else: # No more words, remaining is just spaces\n                break\n\n    # Calculate and append trailing spaces\n    trailing_spaces_count = len(s) - len(result)\n    if trailing_spaces_count > 0:\n        result += ' ' * trailing_spaces_count\n        \n    return result"}
{"task_id": "HumanEval/88", "solution": "from typing import List\n\ndef _calculate_sum(array: List[int]) -> int:\n    \"\"\"Calculate sum of first and last elements.\"\"\"\n    return array[0] + array[-1]\n\ndef _sort_ascending(array: List[int]) -> List[int]:\n    \"\"\"Sort array in ascending order.\"\"\"\n    return sorted(array)\n\ndef _sort_descending(array: List[int]) -> List[int]:\n    \"\"\"Sort array in descending order.\"\"\"\n    return sorted(array, reverse=True)\n\ndef sort_array(array: List[int]) -> List[int]:\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n    \"\"\"\n    if not array:\n        return []\n    if len(array) == 1:\n        return array[:]\n\n    first_last_sum = _calculate_sum(array)\n\n    if first_last_sum % 2 == 1:  # Odd sum\n        return _sort_ascending(array)\n    else:  # Even sum\n        return _sort_descending(array)"}
{"task_id": "HumanEval/88", "solution": "```python\nfrom typing import List\n\ndef sort_array(array: List[int]) -> List[int]:\n    \"\"\"Sorts an array conditionally: ascending if sum of first and last is odd, descending if even.\n    Returns a new sorted copy without modifying the original array.\n    \"\"\"\n    if not array:\n        return []\n    if len(array) == 1:\n        return list(array)\n\n    first_element = array[0]\n    last_element = array[-1]\n    elements_sum = first_element + last_element\n\n    if elements_sum % 2 == 1:\n        return sorted(array)\n    else:\n        return sorted(array, reverse=True)\n```"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Create a function encrypt that takes a string as an argument and\n    returns a string encrypted with the alphabet being rotated. \n    The alphabet should be rotated in a manner such that the letters \n    shift down by two multiplied to two places.\n    For example:\n    encrypt('hi') returns 'lm'\n    encrypt('asdfghjkl') returns 'ewhjklnop'\n    encrypt('gf') returns 'kj'\n    encrypt('et') returns 'ix'\n    \"\"\"\n    \n    # The design specifies a 4-position forward shift for encryption.\n    SHIFT_VALUE = 4\n    encrypted_chars = []\n    \n    for char in s:\n        original_position = ord(char) - ord('a')\n        shifted_position = (original_position + SHIFT_VALUE) % 26\n        encrypted_char = chr(shifted_position + ord('a'))\n        encrypted_chars.append(encrypted_char)\n        \n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/89", "solution": "def _is_lowercase_letter(char: str) -> bool:\n    \"\"\"\n    Checks if character is a lowercase letter.\n    \"\"\"\n    return 'a' <= char <= 'z'\n\ndef _shift_character(char: str) -> str:\n    \"\"\"\n    Shifts a single lowercase letter by 4 positions with wraparound.\n    \"\"\"\n    start_char_code = ord('a')\n    char_code = ord(char)\n    shifted_code = start_char_code + (char_code - start_char_code + 4) % 26\n    return chr(shifted_code)\n\ndef encrypt(s: str) -> str:\n    \"\"\"\n    Encrypts a string using Caesar cipher with 4-position shift.\n    \"\"\"\n    encrypted_chars = []\n    for char in s:\n        if _is_lowercase_letter(char):\n            encrypted_chars.append(_shift_character(char))\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Finds the second smallest unique element in a list of integers.\n    Returns None if the list is empty or has insufficient unique elements.\n    \"\"\"\n    if not lst:\n        return None\n\n    unique_elements = set(lst)\n    sorted_unique = sorted(list(unique_elements))\n\n    if len(sorted_unique) < 2:\n        return None\n    else:\n        return sorted_unique[1]"}
{"task_id": "HumanEval/90", "solution": "from typing import List, Optional\n\ndef next_smallest(lst: List[int]) -> Optional[int]:\n    \"\"\"\n    Finds and returns the second smallest unique element from a list of integers.\n    Returns None if there are fewer than two unique elements.\n    \"\"\"\n    if not lst:\n        return None\n\n    # Convert to a set to get unique elements, then sort them\n    unique_elements = sorted(list(set(lst)))\n\n    # If there are fewer than two unique elements, return None\n    if len(unique_elements) < 2:\n        return None\n    \n    # Return the second smallest unique element\n    return unique_elements[1]"}
{"task_id": "HumanEval/92", "solution": "def validate_integers(x, y, z) -> bool:\n    \"\"\"Validates that all three inputs are integers.\n    Returns True if all are integers, False otherwise.\n    \"\"\"\n    return isinstance(x, int) and isinstance(y, int) and isinstance(z, int)\n\ndef check_sum_condition(x, y, z) -> bool:\n    \"\"\"Checks if one number equals the sum of the other two.\n    Assumes inputs are integers.\n    \"\"\"\n    return (x + y == z) or (x + z == y) or (y + z == x)\n\ndef any_int(x, y, z) -> bool:\n    \"\"\"Checks if one number equals the sum of the other two, given all are integers.\n    Returns True if all inputs are integers AND the sum condition is met, False otherwise.\n    \"\"\"\n    if not validate_integers(x, y, z):\n        return False\n    return check_sum_condition(x, y, z)"}
{"task_id": "HumanEval/91", "solution": "```python\ndef is_bored(S: str) -> int:\n    \"\"\"\n    Count the number of boredoms in a string.\n    A boredom is a sentence that starts with the word \"I\".\n    \"\"\"\n    boredom_count = 0\n    current_sentence_buffer = []\n    delimiters = {'.', '?', '!'}\n\n    for char in S:\n        if char in delimiters:\n            # Process the accumulated characters as a sentence\n            sentence_text = \"\".join(current_sentence_buffer).strip()\n\n            if sentence_text:\n                # Split the sentence into words to check if the first word is 'I'\n                words = sentence_text.split()\n                if words and words[0] == \"I\":\n                    boredom_count += 1\n\n            current_sentence_buffer = []  # Reset the buffer for the next sentence\n        else:\n            current_sentence_buffer.append(char)\n\n    # After the loop, process any remaining text in the buffer as a potential final sentence.\n    # This handles cases where the string does not end with a delimiter.\n    final_sentence_text = \"\".join(current_sentence_buffer).strip()\n    if final_sentence_text:\n        words = final_sentence_text.split()\n        if words and words[0] == \"I\":\n            boredom_count += 1\n\n    return boredom_count\n```"}
{"task_id": "HumanEval/93", "solution": "def encode(message: str) -> str:\n    \"\"\"\n    Encodes a message by swapping letter cases and replacing vowels with shifted characters.\n    Handles spaces and processes empty strings gracefully.\n    \"\"\"\n    # Static mapping of lowercase vowels to shifted lowercase characters.\n    VOWEL_MAP = {'a': 'c', 'e': 'g', 'i': 'k', 'o': 'q', 'u': 'w'}\n\n    def is_vowel(char: str) -> bool:\n        \"\"\"Determines if a character is a vowel, case-insensitive.\"\"\"\n        return char.lower() in VOWEL_MAP\n\n    def swap_case(char: str) -> str:\n        \"\"\"Swaps the case of an alphabetic character; preserves others.\"\"\"\n        if 'a' <= char <= 'z' or 'A' <= char <= 'Z':\n            return char.swapcase()\n        return char\n\n    def replace_vowel(char: str) -> str:\n        \"\"\"Replaces a vowel with its mapped character from VOWEL_MAP.\"\"\"\n        return VOWEL_MAP.get(char.lower(), char)\n\n    def process_character(char: str) -> str:\n        \"\"\"Processes a single character through vowel replacement and case swapping.\"\"\"\n        if char == ' ':\n            return char\n        \n        if is_vowel(char):\n            # Vowels are first replaced (result is lowercase), then their case is swapped.\n            replaced_char = replace_vowel(char)\n            return swap_case(replaced_char)\n        else:\n            # Non-vowels (letters) only have their case swapped.\n            return swap_case(char)\n\n    # Apply the character processing to each character in the message.\n    encoded_chars = [process_character(char) for char in message]\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/91", "solution": "def split_sentences(text: str) -> list[str]:\n    \"\"\"Splits input text into sentences using '.', '?', '!' as delimiters.\n    It handles multiple delimiters and leading/trailing whitespace around sentences.\"\"\"\n    sentences = []\n    current_sentence_chars = []\n    delimiters = {'.', '?', '!'}\n\n    for char in text:\n        if char in delimiters:\n            sentence_str = \"\".join(current_sentence_chars).strip()\n            if sentence_str:\n                sentences.append(sentence_str)\n            current_sentence_chars = []\n        else:\n            current_sentence_chars.append(char)\n    \n    remaining_sentence = \"\".join(current_sentence_chars).strip()\n    if remaining_sentence:\n        sentences.append(remaining_sentence)\n        \n    return sentences\n\ndef get_first_word(sentence: str) -> str:\n    \"\"\"Extracts the first word from a sentence, ignoring leading/trailing whitespace.\n    Returns an empty string if the sentence is empty or only whitespace.\"\"\"\n    stripped_sentence = sentence.strip()\n    if not stripped_sentence:\n        return \"\"\n    \n    words = stripped_sentence.split(maxsplit=1)\n    return words[0] if words else \"\"\n\ndef starts_with_i(sentence: str) -> bool:\n    \"\"\"Checks if the first word of a sentence is 'I' (case-sensitive).\n    It uses get_first_word to correctly identify the first word.\"\"\"\n    first_word = get_first_word(sentence)\n    return first_word == \"I\"\n\ndef is_bored(S):\n    \"\"\"Counts sentences starting with 'I' in a given string.\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    boredom_count = 0\n    sentences = split_sentences(S)\n    \n    for sentence in sentences:\n        if starts_with_i(sentence):\n            boredom_count += 1\n            \n    return boredom_count"}
{"task_id": "HumanEval/92", "solution": "def _is_integer(value):\n    \"\"\"\n    Checks if a given value is an integer.\n    Returns True if the value is an integer, False otherwise.\n    \"\"\"\n    return isinstance(value, int)\n\ndef _check_sum_equality(x, y, z):\n    \"\"\"\n    Checks if one number equals the sum of the other two.\n    Assumes x, y, and z are integers.\n    \"\"\"\n    return (x == y + z) or \\\n           (y == x + z) or \\\n           (z == x + y)\n\ndef any_int(x, y, z):\n    '''\n    Checks if one of the three numbers equals the sum of the other two,\n    given all numbers are strictly integers.\n    '''\n    # Validate that all inputs are integers first.\n    if not (_is_integer(x) and _is_integer(y) and _is_integer(z)):\n        return False\n    \n    # If all are integers, proceed to check sum equality.\n    return _check_sum_equality(x, y, z)"}
{"task_id": "HumanEval/93", "solution": "```python\ndef encode(message: str) -> str:\n    \"\"\"\n    Encodes message by swapping case and replacing vowels with +2 alphabet offset.\n\n    Args:\n        message: Input string containing letters and spaces\n\n    Returns:\n        Encoded string with case swapped and vowels replaced\n    \"\"\"\n    encoded_chars = []\n    vowels_lower = 'aeiou'\n    vowels_upper = 'AEIOU'\n\n    for char in message:\n        if char.isalpha():\n            # First, swap the case of the letter\n            swapped_char = char.swapcase()\n\n            # Then, check if the newly case-swapped character is a vowel\n            if swapped_char in vowels_lower or swapped_char in vowels_upper:\n                # If it's a vowel, replace it with the letter two places ahead\n                offset_char_code = ord(swapped_char) + 2\n                encoded_char = chr(offset_char_code)\n            else:\n                # If not a vowel, keep the case-swapped character\n                encoded_char = swapped_char\n        else:\n            # If not an alphabetic character, preserve it as is\n            encoded_char = char\n        encoded_chars.append(encoded_char)\n\n    return \"\".join(encoded_chars)\n```"}
{"task_id": "HumanEval/94", "solution": "import math\n\ndef is_prime(n: int) -> bool:\n    \"\"\"Determines if a given number is prime.\n    Handles numbers less than 2, and efficiently checks for divisibility.\"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\n\ndef sum_digits(n: int) -> int:\n    \"\"\"Calculates the sum of all digits in a non-negative number.\"\"\"\n    digit_sum = 0\n    while n > 0:\n        digit_sum += n % 10\n        n //= 10\n    return digit_sum\n\ndef find_primes(lst: list[int]) -> list[int]:\n    \"\"\"Identifies all prime numbers in the input list.\"\"\"\n    primes = []\n    for num in lst:\n        if is_prime(num):\n            primes.append(num)\n    return primes\n\ndef find_largest_prime(primes: list[int]) -> int:\n    \"\"\"Finds the largest prime from a list of prime numbers.\"\"\"\n    # Assumes the 'primes' list is not empty based on skjkasdkd's logic.\n    return max(primes)\n\ndef skjkasdkd(lst: list[int]) -> int:\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\"\"\"\n    if not lst:\n        return 0\n\n    all_primes = find_primes(lst)\n\n    if not all_primes:\n        return 0\n\n    largest_prime = find_largest_prime(all_primes)\n    return sum_digits(largest_prime)"}
{"task_id": "HumanEval/94", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"Determine if a given number is prime using mathematical definition.\"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    # Check for factors from 3 up to the square root of n, incrementing by 2.\n    for i in range(3, int(n**0.5) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\n\ndef find_primes(numbers: list[int]) -> list[int]:\n    \"\"\"Filters input list to extract all prime numbers.\"\"\"\n    prime_numbers = []\n    for num in numbers:\n        if is_prime(num):\n            prime_numbers.append(num)\n    return prime_numbers\n\ndef find_largest_prime(primes: list[int]) -> int | None:\n    \"\"\"Identifies the maximum value from a list of prime numbers.\"\"\"\n    if not primes:\n        return None\n    return max(primes)\n\ndef calculate_digit_sum(number: int) -> int:\n    \"\"\"Computes sum of individual digits in a number.\"\"\"\n    digit_sum = 0\n    abs_number = abs(number) # Ensure positive for digit sum calculation.\n    while abs_number > 0:\n        digit_sum += abs_number % 10\n        abs_number //= 10\n    return digit_sum\n\ndef skjkasdkd(lst: list[int]) -> int:\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    primes = find_primes(lst)\n    largest_prime = find_largest_prime(primes)\n\n    if largest_prime is None:\n        return 0\n    \n    return calculate_digit_sum(largest_prime)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict: dict) -> bool:\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False if the given dictionary is empty.\n    \"\"\"\n    if not dict:\n        return False\n\n    # All keys are assumed to be strings per \"CRITICAL REQUIREMENTS\" section,\n    # otherwise, string methods like .islower() would raise an error.\n    keys_view = dict.keys()\n\n    # Check if all keys are lowercase.\n    is_all_lowercase = all(key.islower() for key in keys_view)\n    if is_all_lowercase:\n        return True\n\n    # Check if all keys are uppercase.\n    is_all_uppercase = all(key.isupper() for key in keys_view)\n    if is_all_uppercase:\n        return True\n\n    return False"}
{"task_id": "HumanEval/97", "solution": "def _extract_unit_digit(number: int) -> int:\n    \"\"\"Extract unit digit from an integer using absolute value and modulo.\n    Handles both positive and negative numbers correctly.\"\"\"\n    return abs(number) % 10\n\ndef _calculate_product(digit1: int, digit2: int) -> int:\n    \"\"\"Calculate the mathematical product of two single digits.\n    This helper performs the final multiplication.\"\"\"\n    return digit1 * digit2\n\ndef multiply(a: int, b: int) -> int:\n    \"\"\"Completes the function that takes two integers and returns\n    the product of their unit digits.\"\"\"\n    unit_digit_a = _extract_unit_digit(a)\n    unit_digit_b = _extract_unit_digit(b)\n    return _calculate_product(unit_digit_a, unit_digit_b)"}
{"task_id": "HumanEval/96", "solution": "def is_prime(number):\n    \"\"\"Checks if a number is prime using trial division.\n    Handles numbers less than 2 as non-prime.\n    \"\"\"\n    if number < 2:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    # Check for factors from 3 up to the square root of number, stepping by 2.\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True\n\ndef count_up_to(n):\n    \"\"\"Returns an array of all prime numbers less than n in ascending order.\n    Handles n=0 or n=1 by returning an empty array.\n    \"\"\"\n    if n <= 1:\n        return []\n\n    primes = []\n    # Iterate from 2 up to n-1 to find and collect prime numbers.\n    for number in range(2, n):\n        if is_prime(number):\n            primes.append(number)\n    return primes"}
{"task_id": "HumanEval/96", "solution": "```python\ndef count_up_to(n):\n    \"\"\"Generates an array of prime numbers less than n.\n    This function finds all prime numbers strictly less than the given input 'n'.\n    \"\"\"\n\n    def is_prime(number):\n        \"\"\"Checks if a number is prime.\n        This helper function efficiently determines primality by checking divisors up to its square root.\n        \"\"\"\n        if number <= 1:\n            return False\n        if number == 2:\n            return True\n        if number % 2 == 0:\n            return False\n        i = 3\n        while i * i <= number:\n            if number % i == 0:\n                return False\n            i += 2\n        return True\n\n    # Handle edge cases where n is 0 or 1.\n    if n <= 1:\n        return []\n\n    primes = []\n    # Iterate from 2 up to n-1 to find all primes less than n.\n    for i in range(2, n):\n        if is_prime(i):\n            primes.append(i)\n\n    return primes\n```"}
{"task_id": "HumanEval/95", "solution": "```python\ndef _is_empty_dict(input_dict) -> bool:\n    \"\"\"Checks if the given dictionary is empty.\"\"\"\n    return not input_dict\n\ndef _all_keys_strings(input_dict: dict) -> bool:\n    \"\"\"Validates if all keys in the dictionary are strings.\n    This prevents errors when calling string methods on non-string keys.\"\"\"\n    for key in input_dict.keys():\n        if not isinstance(key, str):\n            return False\n    return True\n\ndef _all_keys_lowercase(input_dict: dict) -> bool:\n    \"\"\"Checks if all string keys in the dictionary are lowercase.\"\"\"\n    for key in input_dict.keys():\n        if not key.islower():\n            return False\n    return True\n\ndef _all_keys_uppercase(input_dict: dict) -> bool:\n    \"\"\"Checks if all string keys in the dictionary are uppercase.\"\"\"\n    for key in input_dict.keys():\n        if not key.isupper():\n            return False\n    return True\n\ndef check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower \n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    Examples:\n    check_dict_case({\"a\":\"apple\", \"b\":\"banana\"}) should return True.\n    check_dict_case({\"a\":\"apple\", \"A\":\"banana\", \"B\":\"banana\"}) should return False.\n    check_dict_case({\"a\":\"apple\", 8:\"banana\", \"a\":\"apple\"}) should return False.\n    check_dict_case({\"Name\":\"John\", \"Age\":\"36\", \"City\":\"Houston\"}) should return False.\n    check_dict_case({\"STATE\":\"NC\", \"ZIP\":\"12345\" }) should return True.\n    \"\"\"\n    if _is_empty_dict(dict):\n        return False\n\n    if not _all_keys_strings(dict):\n        return False\n\n    if _all_keys_lowercase(dict):\n        return True\n    \n    if _all_keys_uppercase(dict):\n        return True\n    \n    return False\n```"}
{"task_id": "HumanEval/97", "solution": "def extract_unit_digit(number: int) -> int:\n    \"\"\"Extracts the unit digit from an integer, handling negative numbers by using their absolute value.\n    The unit digit is obtained using the modulo 10 operation.\"\"\"\n    return abs(number) % 10\n\ndef calculate_product(digit1: int, digit2: int) -> int:\n    \"\"\"Calculates the product of two single-digit integers.\n    This function performs a simple multiplication.\"\"\"\n    return digit1 * digit2\n\ndef multiply(a, b):\n    \"\"\"Complete the function that takes two integers and returns \n    the product of their unit digits.\n    Assume the input is always valid.\n    \"\"\"\n    unit_digit_a = extract_unit_digit(a)\n    unit_digit_b = extract_unit_digit(b)\n    return calculate_product(unit_digit_a, unit_digit_b)"}
{"task_id": "HumanEval/98", "solution": "def count_upper(s: str) -> int:\n    \"\"\"\n    Given a string s, count the number of uppercase vowels in even indices.\n    Examples: 'aBCdEf' -> 1, 'abcdefg' -> 0, 'dBBE' -> 0.\n    \"\"\"\n    count = 0\n    uppercase_vowels = {'A', 'E', 'I', 'O', 'U'}\n\n    for i, char in enumerate(s):\n        if i % 2 == 0 and char in uppercase_vowels:\n            count += 1\n    return count"}
{"task_id": "HumanEval/98", "solution": "def count_upper(s):\n    \"\"\"\n    Given a string s, count the number of uppercase vowels in even indices.\n    This function processes characters at even indices, identifies uppercase vowels, and counts them.\n    \"\"\"\n\n    def _is_uppercase_vowel(char: str) -> bool:\n        \"\"\"\n        Determines if a character is an uppercase vowel (A, E, I, O, U).\n        It checks if the given character is present in the set of uppercase vowels.\n        \"\"\"\n        return char in ('A', 'E', 'I', 'O', 'U')\n\n    def _is_even_index(index: int) -> bool:\n        \"\"\"\n        Validates if an index position is even.\n        It returns True if the index is evenly divisible by 2.\n        \"\"\"\n        return index % 2 == 0\n\n    count = 0\n    for index, char in enumerate(s):\n        if _is_even_index(index):\n            if _is_uppercase_vowel(char):\n                count += 1\n    return count"}
{"task_id": "HumanEval/99", "solution": "def closest_integer(value):\n    \"\"\"\n    Convert string representation of number to closest integer.\n    Round equidistant values away from zero.\n    \"\"\"\n    num = float(value)\n\n    # Check if equidistant from two integers (e.g., 14.5, -14.5)\n    # The fractional part's absolute value is 0.5\n    if abs(num - int(num)) == 0.5:\n        # Round away from zero\n        if num > 0:\n            return int(num) + 1\n        else: # num is negative\n            return int(num) - 1\n    else:\n        # Standard rounding for non-equidistant values\n        return round(num)"}
{"task_id": "HumanEval/99", "solution": "def closest_integer(value):\n    '''\n    Returns the mathematically closest integer to a string-represented number.\n    Numbers equidistant from two integers are rounded away from zero.\n    '''\n    f = float(value)\n    if f >= 0:\n        return int(f + 0.5)\n    else:\n        return int(f - 0.5)"}
{"task_id": "HumanEval/100", "solution": "def make_a_pile(n: int) -> list[int]:\n    \"\"\"\n    Given a positive integer n, you have to make a pile of n levels of stones.\n    The first level has n stones. The number of stones in the next level is the\n    next odd number if n is odd, or the next even number if n is even.\n    \"\"\"\n    pile = []\n    current_stones = n\n    for _ in range(n):\n        pile.append(current_stones)\n        current_stones += 2\n    return pile"}
{"task_id": "HumanEval/101", "solution": "def words_string(s):\n    \"\"\"\n    Splits a string of words separated by commas or spaces into a list of words.\n    Preserves original case and order, handling mixed separators.\n    \"\"\"\n    # First, replace all commas with spaces to unify separators.\n    processed_string = s.replace(',', ' ')\n    # Then, split the string by spaces. The default split() handles multiple spaces\n    # and automatically filters out empty strings, aligning with word extraction.\n    words = processed_string.split()\n    return words"}
{"task_id": "HumanEval/101", "solution": "import re\n\ndef words_string(s: str) -> list[str]:\n    \"\"\"\n    Split string into words separated by commas or spaces.\n    Preserves original case and word order, handling mixed separators.\n    \"\"\"\n    words = re.split(r'[ ,]+', s)\n    return [word for word in words if word]"}
