{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    \n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "HumanEval/32", "solution": "```python\nimport math\n\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    tolerance = 1e-7\n    max_bracket_search_iterations = 100\n    max_bisection_iterations = 200\n\n    low = -1.0\n    high = 1.0\n\n    for _ in range(max_bracket_search_iterations):\n        val_low = poly(xs, low)\n        val_high = poly(xs, high)\n\n        if abs(val_low) < tolerance:\n            return low\n        if abs(val_high) < tolerance:\n            return high\n\n        if val_low * val_high < 0:\n            break\n        \n        low *= 2.0\n        high *= 2.0\n        if abs(low) > 1e100:\n            break\n\n    for _ in range(max_bisection_iterations):\n        mid = (low + high) / 2.0\n        val_mid = poly(xs, mid)\n\n        if abs(val_mid) < tolerance:\n            return mid\n\n        val_low = poly(xs, low)\n\n        if val_low * val_mid < 0:\n            high = mid\n        else:\n            low = mid\n    \n    return (low + high) / 2.0\n```"}
{"task_id": "HumanEval/32", "solution": "import math\n\ndef poly(xs: list, x: float) -> float:\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[2] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\ndef _validate_even_coefficients(xs: list) -> bool:\n    \"\"\"Validate polynomial has even number of coefficients.\"\"\"\n    return len(xs) % 2 == 0\n\ndef _validate_nonzero_largest(xs: list) -> bool:\n    \"\"\"Validate largest coefficient is non-zero.\"\"\"\n    return xs[-1] != 0 if xs else False\n\ndef find_zero(xs: list) -> float:\n    \"\"\"Finds a single zero point of the polynomial defined by coefficients xs.\n    Requires an even number of coefficients and a non-zero largest coefficient to guarantee a solution.\n    \"\"\"\n    if not _validate_even_coefficients(xs):\n        raise ValueError(\"Polynomial must have even number of coefficients\")\n\n    if not _validate_nonzero_largest(xs):\n        raise ValueError(\"Largest coefficient must be non-zero\")\n\n    # Bisection method to find a zero point.\n    # An odd degree polynomial always has at least one real root.\n    \n    low = -1.0\n    high = 1.0\n    tolerance = 1e-7\n    max_iterations = 1000 \n\n    # Check initial endpoints first\n    val_low = poly(xs, low)\n    if abs(val_low) < tolerance:\n        return low\n    \n    val_high = poly(xs, high)\n    if abs(val_high) < tolerance:\n        return high\n\n    # Expand the interval until a sign change is found.\n    while val_low * val_high > 0:\n        low *= 2\n        high *= 2\n        val_low = poly(xs, low)\n        val_high = poly(xs, high)\n        \n        if abs(val_low) < tolerance:\n            return low\n        if abs(val_high) < tolerance:\n            return high\n        \n        if abs(low) > 1e12 or abs(high) > 1e12: # Safeguard for extreme ranges\n            break\n            \n    # Now `low` and `high` bracket a root.\n    for _ in range(max_iterations):\n        mid = (low + high) / 2\n        p_mid = poly(xs, mid)\n\n        if abs(p_mid) < tolerance:\n            return mid\n        \n        if poly(xs, low) * p_mid < 0:\n            high = mid\n        else:\n            low = mid\n            \n    return (low + high) / 2"}
