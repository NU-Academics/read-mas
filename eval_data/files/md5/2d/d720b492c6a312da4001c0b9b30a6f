{"task_id": "HumanEval/67", "solution": "```python\nimport re\n\ndef fruit_distribution(s,n):\n    \"\"\"\n    In this task, you will be given a string that represents a number of apples and oranges \n    that are distributed in a basket of fruit this basket contains \n    apples, oranges, and mango fruits. Given the string that represents the total number of \n    the oranges and apples and an integer that represent the total number of the fruits \n    in the basket return the number of the mango fruits in the basket.\n    for examble:\n    fruit_distribution(\"5 apples and 6 oranges\", 19) ->19 - 5 - 6 = 8\n    fruit_distribution(\"0 apples and 1 oranges\",3) -> 3 - 0 - 1 = 2\n    fruit_distribution(\"2 apples and 3 oranges\", 100) -> 100 - 2 - 3 = 95\n    fruit_distribution(\"100 apples and 1 oranges\",120) -> 120 - 100 - 1 = 19\n    \"\"\"\n\n    # Helper function to parse the string and extract apple and orange counts.\n    def _extract_fruit_counts(input_string):\n        pattern = r'(\\d+) apples and (\\d+) oranges'\n        matches = re.findall(pattern, input_string)\n        # Assuming the input string always matches the pattern as per design spec.\n        apples = int(matches[0][0])\n        oranges = int(matches[0][1])\n        return apples, oranges\n\n    # Helper function to calculate the number of mangoes.\n    def _calculate_mangos(total_fruits, apple_count, orange_count):\n        return total_fruits - apple_count - orange_count\n\n    apples_count, oranges_count = _extract_fruit_counts(s)\n    mango_count = _calculate_mangos(n, apples_count, oranges_count)\n    return mango_count\n```"}
{"task_id": "HumanEval/67", "solution": "```python\ndef fruit_distribution(s, n):\n    \"\"\"Calculates the number of mango fruits given apple/orange counts and total fruits.\n    It parses fruit counts from a string and subtracts them from the total.\n    \"\"\"\n\n    def extract_apple_count(s_param: str) -> int:\n        \"\"\"Extracts the count of apples from the fruit distribution string.\n        It expects the number to precede \" apples\".\n        \"\"\"\n        first_part = s_param.split(\" apples\")[0]\n        return int(first_part)\n\n    def extract_orange_count(s_param: str) -> int:\n        \"\"\"Extracts the count of oranges from the fruit distribution string.\n        It expects the number to precede \" oranges\" after \" and \".\n        \"\"\"\n        parts_after_and = s_param.split(\" and \")[1]\n        count_str = parts_after_and.split(\" oranges\")[0]\n        return int(count_str)\n\n    def parse_fruit_numbers(s_param: str) -> tuple[int, int]:\n        \"\"\"Parses the fruit distribution string to get apple and orange counts.\n        It uses specialized extractors for each fruit type.\n        \"\"\"\n        apples = extract_apple_count(s_param)\n        oranges = extract_orange_count(s_param)\n        return apples, oranges\n\n    def validate_fruit_counts(total: int, apples: int, oranges: int) -> bool:\n        \"\"\"Validates if the fruit counts are coherent for calculation.\n        Per critical requirements, it simply returns True, trusting input.\n        \"\"\"\n        return True\n\n    def calculate_mangos(total: int, apples: int, oranges: int) -> int:\n        \"\"\"Calculates the number of mangoes by subtracting other fruit counts from the total.\n        This function performs the core arithmetic subtraction.\n        \"\"\"\n        return total - apples - oranges\n\n    # Main logic of fruit_distribution function\n    apples_count, oranges_count = parse_fruit_numbers(s)\n\n    # Validate counts (this function currently always returns True)\n    # The validation result is not used to alter flow as per critical requirements.\n    validate_fruit_counts(n, apples_count, oranges_count)\n\n    mango_count = calculate_mangos(n, apples_count, oranges_count)\n\n    return mango_count\n```"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even value and its first index in an array of non-negative integers.\n    Returns [value, index] or an empty list if no even values are found or the array is empty.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = None\n    smallest_even_index = None\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even\n            if smallest_even_value is None or value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n\n    if smallest_even_value is None:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/68", "solution": "def is_even(num: int) -> bool:\n    \"\"\"Checks if a given number is even.\"\"\"\n    return num % 2 == 0\n\ndef validate_input(arr: list) -> bool:\n    \"\"\"Performs input validation according to critical requirements, effectively a no-op.\"\"\"\n    return True\n\ndef find_smallest_even(arr: list) -> tuple | None:\n    \"\"\"Finds the smallest even value and its leftmost index in the array.\"\"\"\n    smallest_even = None\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        if is_even(value):\n            if smallest_even is None or value < smallest_even:\n                smallest_even = value\n                smallest_even_index = index\n    \n    if smallest_even is not None:\n        return (smallest_even, smallest_even_index)\n    return None\n\ndef format_result(result: tuple | None) -> list:\n    \"\"\"Formats the found result into the specified list output.\"\"\"\n    if result is None:\n        return []\n    return [result[0], result[1]]\n\ndef pluck(arr: list) -> list:\n    \"\"\"\n    Given an array of non-negative integers, returns the smallest even value\n    with its zero-based index as a list [value, index], or an empty list [].\n    It prioritizes the leftmost occurrence in case of a tie.\n    \"\"\"\n    validate_input(arr)\n    found_result = find_smallest_even(arr)\n    return format_result(found_result)"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n\n    def _calculate_frequency(lst):\n        '''Calculate frequency distribution of integers in the input list.'''\n        frequencies = {}\n        for num in lst:\n            frequencies[num] = frequencies.get(num, 0) + 1\n        return frequencies\n\n    def _find_qualifying_integers(frequencies):\n        '''Identify integers where frequency is greater than or equal to the integer value.'''\n        qualifying = []\n        for num, freq in frequencies.items():\n            if freq >= num:\n                qualifying.append(num)\n        return qualifying\n\n    def _get_maximum(candidates):\n        '''Return the maximum value from a list of candidates, or -1 if the list is empty.'''\n        if not candidates:\n            return -1\n        return max(candidates)\n\n    # Main entry point orchestrates the frequency-based search algorithm.\n    # It coordinates frequency calculation, qualification filtering, and maximum selection.\n    frequencies = _calculate_frequency(lst)\n    qualifying_integers = _find_qualifying_integers(frequencies)\n    result = _get_maximum(qualifying_integers)\n    return result"}
{"task_id": "HumanEval/69", "solution": "def count_frequencies(lst):\n    \"\"\"Counts the frequency of each integer in the input list.\n    Returns a dictionary mapping integers to their counts.\"\"\"\n    frequencies = {}\n    for num in lst:\n        frequencies[num] = frequencies.get(num, 0) + 1\n    return frequencies\n\ndef find_qualifying_integers(frequencies):\n    \"\"\"Identifies integers where their frequency is greater than or equal to their value.\n    Returns a list of such qualifying integers.\"\"\"\n    candidates = []\n    for value, freq in frequencies.items():\n        if freq >= value:\n            candidates.append(value)\n    return candidates\n\ndef get_maximum(candidates):\n    \"\"\"Finds the maximum value from a list of candidates.\n    Returns the maximum value or -1 if the list is empty.\"\"\"\n    if not candidates:\n        return -1\n    return max(candidates)\n\ndef search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    frequencies = count_frequencies(lst)\n    qualifying_candidates = find_qualifying_integers(frequencies)\n    result = get_maximum(qualifying_candidates)\n    return result"}
{"task_id": "HumanEval/70", "solution": "```python\ndef strange_sort_list(lst):\n    '''\n    Sorts a list of integers into a \"strange\" order by alternating between minimum and maximum selections.\n    Starts by selecting the smallest remaining value, then the largest, and so on.\n    '''\n    if not lst:\n        return []\n\n    # Create a sorted copy of the input list for efficient min/max retrieval and removal.\n    working_list = sorted(lst)\n    result = []\n    min_turn = True # Flag to alternate between picking min and max\n\n    while working_list:\n        if min_turn:\n            # Pick the smallest element (first in sorted list)\n            result.append(working_list.pop(0))\n        else:\n            # Pick the largest element (last in sorted list)\n            result.append(working_list.pop())\n        min_turn = not min_turn # Toggle for the next iteration\n\n    return result\n```"}
{"task_id": "HumanEval/70", "solution": "from typing import List\n\ndef strange_sort_list(lst: List[int]) -> List[int]:\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n\n    Examples:\n    strange_sort_list([1, 2, 3, 4]) == [1, 4, 2, 3]\n    strange_sort_list([5, 5, 5, 5]) == [5, 5, 5, 5]\n    strange_sort_list([]) == []\n    '''\n    if not lst:\n        return []\n\n    # Create a sorted copy of the input list, making min/max selection efficient.\n    working_list = sorted(lst)\n    result = []\n    is_min_turn = True # Flag to alternate between picking minimum and maximum.\n\n    while working_list:\n        if is_min_turn:\n            # Select the minimum value from the remaining elements, which is the first in the sorted list.\n            selected_value = working_list.pop(0)\n        else:\n            # Select the maximum value from the remaining elements, which is the last in the sorted list.\n            selected_value = working_list.pop(-1)\n        \n        result.append(selected_value)\n        is_min_turn = not is_min_turn # Toggle the turn for the next iteration.\n\n    return result"}
{"task_id": "HumanEval/71", "solution": "import math\n\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1.\n    '''\n\n    def _is_valid_triangle(a_side: float, b_side: float, c_side: float) -> bool:\n        \"\"\"\n        Validates triangle inequality rule for the given side lengths.\n        Returns true if the sum of any two sides is greater than the third side.\n        \"\"\"\n        return (a_side + b_side > c_side and\n                a_side + c_side > b_side and\n                b_side + c_side > a_side)\n\n    def _calculate_area(a_side: float, b_side: float, c_side: float) -> float:\n        \"\"\"\n        Calculates the area of a triangle using Heron's formula.\n        This function assumes the provided sides form a valid triangle.\n        \"\"\"\n        s = (a_side + b_side + c_side) / 2\n        return math.sqrt(s * (s - a_side) * (s - b_side) * (s - c_side))\n\n    def _round_to_two_decimals(value: float) -> float:\n        \"\"\"\n        Rounds a numeric value to exactly two decimal places.\n        This uses Python's built-in round function for float precision.\n        \"\"\"\n        return round(value, 2)\n\n    if not _is_valid_triangle(a, b, c):\n        return -1\n    else:\n        area = _calculate_area(a, b, c)\n        return _round_to_two_decimals(area)"}
{"task_id": "HumanEval/71", "solution": "def triangle_area(a, b, c):\n    '''\n    Calculates the area of a triangle given its three side lengths.\n    Returns the area rounded to 2 decimal places, or -1 for invalid triangles.\n    '''\n    # Validate triangle inequality theorem: sum of any two sides must be greater than the third side.\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1\n\n    # Calculate semi-perimeter for Heron's formula.\n    s = (a + b + c) / 2\n\n    # Calculate the area using Heron's formula.\n    area = (s * (s - a) * (s - b) * (s - c)) ** 0.5\n\n    # Round the calculated area to exactly 2 decimal places.\n    return round(area, 2)"}
{"task_id": "HumanEval/72", "solution": "```python\ndef is_palindrome(lst):\n    \"\"\"\n    Checks if a list is palindromic.\n    This comparison is O(n) as slicing and comparison take linear time.\n    \"\"\"\n    return lst == lst[::-1]\n\ndef calculate_sum(lst):\n    \"\"\"\n    Calculates the sum of all elements in the list.\n    Utilizes the built-in sum function for efficiency.\n    \"\"\"\n    return sum(lst)\n\ndef validate_inputs(q, w):\n    \"\"\"\n    Validates the input parameters q and w.\n    As per critical requirements, this function assumes valid types and always returns True.\n    \"\"\"\n    return True\n\ndef will_it_fly(q, w):\n    \"\"\"\n    Determines if an object q will fly based on balance and weight constraints.\n    Returns True if q is a palindrome and its sum is less than or equal to w, False otherwise.\n    \"\"\"\n    if not validate_inputs(q, w):\n        return False\n\n    balanced = is_palindrome(q)\n    total_weight = calculate_sum(q)\n    within_weight_limit = total_weight <= w\n\n    return balanced and within_weight_limit\n```"}
{"task_id": "HumanEval/72", "solution": "def is_palindrome(lst):\n    \"\"\"Checks if a list is palindromic. Handles empty and single-element lists.\"\"\"\n    return lst == lst[::-1]\n\ndef calculate_sum(lst):\n    \"\"\"Calculates the sum of numeric elements in a list.\"\"\"\n    return sum(lst)\n\ndef will_it_fly(q,w):\n    '''\n    Write a function that returns True if the object q will fly, and False otherwise.\n    The object q will fly if it's balanced (it is a palindromic list) and the sum of its elements is less than or equal the maximum possible weight w.\n    '''\n    if not is_palindrome(q):\n        return False\n    \n    total_weight = calculate_sum(q)\n    return total_weight <= w"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum number of changes needed to make an array palindromic.\n    It orchestrates validation, palindrome analysis, and change calculation as nested components.\n    \"\"\"\n\n    def _is_palindromic(current_arr):\n        \"\"\"Checks if the given array is already palindromic.\"\"\"\n        n_local = len(current_arr)\n        left, right = 0, n_local - 1\n        while left < right:\n            if current_arr[left] != current_arr[right]:\n                return False\n            left += 1\n            right -= 1\n        return True\n\n    def _count_mismatches(current_arr):\n        \"\"\"Counts element mismatches from ends to determine required changes.\"\"\"\n        n_local = len(current_arr)\n        mismatches = 0\n        left, right = 0, n_local - 1\n        while left < right:\n            if current_arr[left] != current_arr[right]:\n                mismatches += 1\n            left += 1\n            right -= 1\n        return mismatches\n\n    def _calculate_min_changes(current_arr):\n        \"\"\"Calculates minimum required changes using mismatch counting.\"\"\"\n        return _count_mismatches(current_arr)\n\n    # Input validation, as per design, with minimal explicit checks due to \"Trust the caller's inputs\".\n    # Handles empty and single-element arrays which are inherently palindromic.\n    n = len(arr)\n    if n <= 1:\n        return 0\n\n    # Palindrome analysis and change calculation flow.\n    if _is_palindromic(arr):\n        return 0\n    else:\n        return _calculate_min_changes(arr)"}
{"task_id": "HumanEval/74", "solution": "def _calculate_total_chars(lst: list) -> int:\n    \"\"\"\n    Calculates the total number of characters in all strings of the list.\n    It sums the length of each string in the input list.\n    \"\"\"\n    total_chars = 0\n    for s in lst:\n        total_chars += len(s)\n    return total_chars\n\ndef _compare_and_select(count1: int, count2: int, lst1: list, lst2: list) -> list:\n    \"\"\"\n    Compares character counts and returns the appropriate list.\n    It returns the first list if its count is less than or equal to the second.\n    \"\"\"\n    if count1 <= count2:\n        return lst1\n    else:\n        return lst2\n\ndef total_match(lst1: list, lst2: list) -> list:\n    '''\n    Accepts two lists of strings and returns the list with fewer total characters.\n    If both lists have the same number of chars, the first list is returned.\n    '''\n    count1 = _calculate_total_chars(lst1)\n    count2 = _calculate_total_chars(lst2)\n    return _compare_and_select(count1, count2, lst1, lst2)"}
{"task_id": "HumanEval/74", "solution": "from typing import List\n\ndef _calculate_total_chars(string_list: List[str]) -> int:\n    \"\"\"\n    Calculates the total number of characters across all strings in a list.\n    Sums the length of each string in the provided list.\n    \"\"\"\n    total_chars = 0\n    for s in string_list:\n        total_chars += len(s)\n    return total_chars\n\ndef total_match(lst1: List[str], lst2: List[str]) -> List[str]:\n    \"\"\"\n    Compares two lists of strings based on their total character count.\n    Returns the list with fewer total characters; returns the first list if counts are equal.\n    \"\"\"\n    count1 = _calculate_total_chars(lst1)\n    count2 = _calculate_total_chars(lst2)\n\n    if count1 <= count2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/73", "solution": "```python\nfrom typing import List\n\ndef get_array_length(arr: List[int]) -> int:\n    \"\"\"Returns the length of the input array. Handles empty arrays gracefully.\"\"\"\n    return len(arr)\n\ndef compare_elements(arr: List[int], left: int, right: int) -> bool:\n    \"\"\"Compares elements at symmetric positions in the array.\"\"\"\n    return arr[left] == arr[right]\n\ndef is_palindromic(arr: List[int]) -> bool:\n    \"\"\"Determines if an array is already palindromic.\"\"\"\n    length = get_array_length(arr)\n    if length <= 1:\n        return True\n\n    left = 0\n    right = length - 1\n    while left < right:\n        if not compare_elements(arr, left, right):\n            return False\n        left += 1\n        right -= 1\n    return True\n\ndef calculate_min_changes(arr: List[int]) -> int:\n    \"\"\"Calculates minimum changes needed for non-palindromic arrays.\"\"\"\n    length = get_array_length(arr)\n    if length <= 1:\n        return 0\n\n    changes = 0\n    left = 0\n    right = length - 1\n    while left < right:\n        if not compare_elements(arr, left, right):\n            changes += 1\n        left += 1\n        right -= 1\n    return changes\n\ndef smallest_change(arr: List[int]) -> int:\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic.\n    \"\"\"\n    if is_palindromic(arr):\n        return 0\n    else:\n        return calculate_min_changes(arr)\n```"}
{"task_id": "HumanEval/75", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"Checks if a number is prime.\n    Uses an optimized trial division method up to the square root of n.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef validate_input(a: int) -> bool:\n    \"\"\"Validates the input number 'a' against specified constraints.\n    Checks if 'a' is a positive integer less than 100.\n    \"\"\"\n    return 0 < a < 100\n\ndef get_prime_factors(n: int) -> list[int]:\n    \"\"\"Performs prime factorization of the input number n.\n    Returns a list of prime factors, including repetitions, with O(sqrt(n)) complexity.\n    \"\"\"\n    factors = []\n    # Handle factor 2\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n    # Handle odd factors from 3 up to sqrt(n)\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            factors.append(i)\n            n //= i\n        i += 2\n    # If n is still greater than 1, it must be a prime factor itself\n    if n > 1:\n        factors.append(n)\n    return factors\n\ndef count_prime_factors(factors: list[int]) -> int:\n    \"\"\"Counts the total number of prime factors in a list.\n    Returns the length of the provided list of factors.\n    \"\"\"\n    return len(factors)\n\ndef is_multiply_prime(a: int) -> bool:\n    \"\"\"Determines if the given number 'a' is the product of exactly three prime numbers.\n    It orchestrates input validation, prime factorization, and factor counting.\n    \"\"\"\n    if not validate_input(a):\n        return False\n\n    prime_factors = get_prime_factors(a)\n    num_factors = count_prime_factors(prime_factors)\n\n    return num_factors == 3"}
{"task_id": "HumanEval/75", "solution": "def _validate_input(a: int) -> bool:\n    \"\"\"Checks if the input 'a' is a positive integer less than 100.\n    Returns True for valid input, False otherwise.\"\"\"\n    return 1 <= a < 100\n\ndef _is_prime(number: int) -> bool:\n    \"\"\"Determines if a given number is prime.\n    Returns True if prime, False otherwise.\"\"\"\n    if number < 2:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True\n\ndef _get_prime_factors(number: int) -> list[int]:\n    \"\"\"Decomposes a number into its prime factors.\n    Returns a list of prime factors, including repetitions.\"\"\"\n    factors = []\n    d = 2\n    temp_number = number\n    while d * d <= temp_number:\n        while temp_number % d == 0:\n            factors.append(d)\n            temp_number //= d\n        d += 1\n    if temp_number > 1:\n        factors.append(temp_number)\n    return factors\n\ndef _count_prime_factors(factors: list[int]) -> int:\n    \"\"\"Counts the total number of prime factors.\n    This includes factors that are repeated.\"\"\"\n    return len(factors)\n\ndef is_multiply_prime(a):\n    \"\"\"Returns True if 'a' is the product of exactly 3 prime numbers.\n    Returns False otherwise.\"\"\"\n    if not _validate_input(a):\n        return False\n\n    prime_factors = _get_prime_factors(a)\n    factor_count = _count_prime_factors(prime_factors)\n\n    return factor_count == 3"}
{"task_id": "HumanEval/76", "solution": "import math\n\ndef is_simple_power(x, n):\n    \"\"\"\n    Determines if a number x is a simple power of n (n**k = x for some integer k).\n    Handles edge cases like x=1, n=1, n=0, and uses logarithms for general cases.\n    \"\"\"\n    TOLERANCE = 1e-9 # Define a small tolerance for floating-point comparisons.\n\n    # If x is 1, it's always n**0 (assuming n is not NaN, which is trusted input).\n    if x == 1:\n        return True\n\n    # If n is 1 (and x is not 1, as handled above), x cannot be a power of 1.\n    if n == 1:\n        return False\n\n    # If n is 0 (and x is not 1), x can only be 0 (for positive integer powers).\n    if n == 0:\n        return x == 0\n\n    # If x is 0 (and n is not 0 or 1, and x is not 1), x cannot be 0 for any integer power of n.\n    if x == 0:\n        return False\n    \n    # If x is negative, and n is positive, n**k is always positive. For negative n, this path is not via logs.\n    if x < 0:\n        return False # The design suggests using logarithms, which are for positive bases/arguments.\n\n    # Main calculation: x > 0, n > 0, n != 1.\n    # Use logarithms to find the potential exponent: k = log(x) / log(n).\n    potential_exponent = math.log(x) / math.log(n)\n\n    # Check if the potential_exponent is very close to an integer and verify n**k == x.\n    rounded_exponent = round(potential_exponent)\n    if abs(potential_exponent - rounded_exponent) < TOLERANCE:\n        calculated_value = n ** rounded_exponent\n        return math.isclose(calculated_value, x, rel_tol=TOLERANCE, abs_tol=TOLERANCE)\n    else:\n        return False"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Write a function that takes an integer a and returns True\n    if this ingeger is a cube of some integer number.\n    Note: you may assume the input is always valid.\n    Examples:\n    iscube(1) ==> True\n    iscube(2) ==> False\n    iscube(-1) ==> True\n    iscube(64) ==> True\n    iscube(0) ==> True\n    iscube(180) ==> False\n    '''\n    if a == 0:\n        return True\n\n    # Calculate the cube root of the absolute value and round to the nearest integer.\n    # This mitigates floating-point inaccuracies when checking for perfect cubes.\n    cbrt_candidate = round(abs(a)**(1/3))\n\n    # Reapply the original sign to the candidate root.\n    if a < 0:\n        actual_root_candidate = -cbrt_candidate\n    else:\n        actual_root_candidate = cbrt_candidate\n\n    # Check if cubing the candidate root gives the original number.\n    return actual_root_candidate ** 3 == a"}
{"task_id": "HumanEval/76", "solution": "def validate_inputs(x: int, n: int) -> bool:\n    \"\"\"\n    Performs initial checks for special values of x and n that result in an immediate False.\n    This function returns False if the combination is definitively not a simple power.\n    \"\"\"\n    # If n is 1 and x is not 1, then 1^k will never be x.\n    if n == 1 and x != 1:\n        return False\n    \n    # If n is 0 and x is greater than 0 (and not 1, which is handled earlier in is_simple_power),\n    # then 0^k cannot be x.\n    if n == 0 and x > 0:\n        return False\n    \n    # If x is 0, and n is greater than 1, then n^k cannot be 0 for k >= 0.\n    if x == 0 and n > 1:\n        return False\n    \n    # For all other cases, it's considered valid for core calculation or an implicit True.\n    return True\n\n\ndef calculate_power_relationship(x: int, n: int) -> bool:\n    \"\"\"\n    Performs the core mathematical calculation to determine if x is n^k.\n    This function handles cases where x > 0 and n > 1, or the specific (0,0) case.\n    \"\"\"\n    # If x is 0 and validate_inputs returned True, it implies n must also be 0.\n    # In this specific case (0,0), 0^k = 0 for k >= 1, so it is a simple power.\n    if x == 0:\n        return True # Handled case (0,0)\n\n    # At this point, x > 0 and n > 1 (due to prior validation and checks in is_simple_power).\n    # If x is positive but smaller than n, it cannot be n^k for k >= 1.\n    if x < n:\n        return False\n\n    current_x = x\n    while current_x > 1:\n        if current_x % n != 0:\n            return False\n        current_x //= n\n    \n    # If current_x has been successfully reduced to 1, then x was a power of n.\n    return current_x == 1\n\n\ndef is_simple_power(x: int, n: int) -> bool:\n    \"\"\"Checks if a number x is a simple power of n (n^k = x for some integer k).\n    This function orchestrates input validation and the power calculation logic.\n    \"\"\"\n    # Handle the specific edge case where x is 1; any valid n (including 0) raised to power 0 equals 1.\n    if x == 1:\n        return True\n\n    # Call validate_inputs to check for scenarios that definitively result in False.\n    # This covers cases like (3,1), (7,0), (0,5).\n    if not validate_inputs(x, n):\n        return False\n\n    # For remaining cases (e.g., x>1, n>1, or (0,0)), proceed with the core calculation.\n    return calculate_power_relationship(x, n)"}
