86": [{"task_id": "Mbpp/286", "solution": "def max_sub_array_sum_repeated(arr: list[int], k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in the modified array\n    which is formed by repeating the given array k times.\n    \"\"\"\n\n    def kadane_func(arr_inner: list[int]) -> int:\n        \"\"\"\n        Calculates the maximum contiguous subarray sum for a single array.\n        Handles arrays with all negative numbers.\n        \"\"\"\n        if not arr_inner:\n            return 0\n\n        max_so_far = float('-inf')\n        current_max = 0\n        \n        # Determine if all numbers are negative to handle that edge case.\n        all_negative = True\n        max_single_element = float('-inf')\n        for x in arr_inner:\n            if x >= 0:\n                all_negative = False\n            if x > max_single_element:\n                max_single_element = x\n        \n        if all_negative:\n            return max_single_element\n\n        # Standard Kadane's algorithm for arrays with at least one non-negative number.\n        for x in arr_inner:\n            current_max += x\n            if current_max < 0:\n                current_max = 0\n            if current_max > max_so_far:\n                max_so_far = current_max\n        \n        return max_so_far if max_so_far != float('-inf') else 0\n\n    if not arr:\n        return 0\n\n    # If k is 1, simply apply Kadane's algorithm to the original array.\n    if k == 1:\n        return kadane_func(arr)\n\n    # For k > 1, the maximum sum can either be within a single repetition,\n    # or span across multiple repetitions.\n    \n    # Calculate maximum sum if it's entirely within one repetition.\n    max_sum_single = kadane_func(arr)\n\n    # Calculate the sum of the entire original array.\n    total_sum = sum(arr)\n\n    # Calculate the maximum prefix sum of the original array.\n    max_prefix_sum = 0\n    current_prefix_sum = 0\n    for x in arr:\n        current_p