n    }\n    associativity = {\n        '+': 'left',\n        '-': 'left',\n        '*': 'left',\n        '//': 'left',\n        '**': 'right',\n    }\n\n    # Build tokens: operand0, op0, operand1, op1, operand2, ...\n    tokens = []\n    for i in range(len(operator)):\n        tokens.append(operand[i])\n        tokens.append(operator[i])\n    tokens.append(operand[-1])\n\n    # Shunting-yard: convert to Reverse Polish Notation (RPN)\n    output_queue = []\n    op_stack = []\n\n    for tok in tokens:\n        if isinstance(tok, int):\n            output_queue.append(tok)\n        else:\n            # tok is an operator string\n            while op_stack:\n                top = op_stack[-1]\n                # top will always be an operator here\n                if ((associativity[tok] == 'left' and precedence[tok] <= precedence[top]) or\n                    (associativity[tok] == 'right' and precedence[tok] < precedence[top])):\n                    output_queue.append(op_stack.pop())\n                else:\n                    break\n            op_stack.append(tok)\n\n    while op_stack:\n        output_queue.append(op_stack.pop())\n\n    # Evaluate RPN\n    eval_stack = []\n    for tok in output_queue:\n        if isinstance(tok, int):\n            eval_stack.append(tok)\n        else:\n            if len(eval_stack) < 2:\n                raise ValueError(\"invalid expression during evaluation\")\n            right = eval_stack.pop()\n            left = eval_stack.pop()\n            if tok == '+':\n                result = left + right\n            elif tok == '-':\n                result = left - right\n            elif tok == '*':\n                result = left * right\n            elif tok == '//':\n                # Let Python raise ZeroDivisionError if right == 0\n                result = left // right\n            elif tok == '**':\n                result = left ** right\n            else:\n                # Should not happen due to earlier validation\n      