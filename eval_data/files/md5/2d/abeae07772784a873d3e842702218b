           witness_found = False\n            for _ in range(s - 1):\n                x = pow(x, 2, n)\n                if x == n - 1:\n                    witness_found = True\n                    break\n\n            if not witness_found:\n                return False\n\n        return True\n\n    a1, b1 = interval1\n    a2, b2 = interval2\n\n    intersection_start = max(a1, a2)\n    intersection_end = min(b1, b2)\n\n    if intersection_start > intersection_end:\n        return \"NO\"\n\n    length = intersection_end - intersection_start\n\n    if length < 2:\n        return \"NO\"\n\n    return \"YES\" if is_prime_miller_rabin(length) else \"NO\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/131": [{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of its odd digits.\n    Returns 0 if all digits are even.\n    \"\"\"\n    product_of_odd = 1\n    has_odd_digit = False\n\n    current_n = n\n    while current_n > 0:\n        digit = current_n % 10\n        if digit % 2 != 0:  # Check if the digit is odd\n            product_of_odd *= digit\n            has_odd_digit = True\n        current_n //= 10\n\n    if not has_odd_digit:\n        return 0\n    else:\n        return product_of_odd", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n\n    n = abs(n)\n\n    if n == 0:\n        return 0\n\n    product = 1\n    found_odd = False\n\n    while n > 0:\n        digit = n % 10\n        if digit % 2 == 1:\n            product *= digit\n            found_odd = True\n        n //= 10\n\n    return product if found_odd else 0", "base_status": "pa