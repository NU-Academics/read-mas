      A sorted list of distinct odd integers encountered in the sequence (including 1 if reached).\n\n    Raises:\n        ValueError: if n is not a positive integer.\n        RuntimeError: if an iteration cap is reached before the sequence reaches 1.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    odd_numbers = set()\n    current = n\n    max_iter = 1_000_000\n\n    for _ in range(max_iter):\n        if current % 2 != 0:  # odd\n            odd_numbers.add(current)\n            if current == 1:\n                break\n            current = 3 * current + 1\n        else:  # even\n            current //= 2\n    else:\n        # reached iteration cap without reaching 1\n        raise RuntimeError(f\"Iteration cap ({max_iter}) reached before reaching 1\")\n\n    # Ensure 1 is included (set add is idempotent)\n    odd_numbers.add(1)\n    return sorted(odd_numbers)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/125": [{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Splits a string by whitespace, then by commas if no whitespace,\n    otherwise counts lowercase letters with odd alphabetical order.\n    \"\"\"\n    if any(c.isspace() for c in txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                if (ord(char) - ord('a')) % 2 != 0:\n                    count += 1\n        return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Given a string, return:\n    - a list of words split on whitespace if any whitespace exists;\n    - otherwise, a list of words split on commas (empty tokens removed) if any comma exists;\n    - otherwise, the number of lowercase letters with odd order in the alphabet (a=0, b=1, ... z=25).\n    \"\"\"\n    if not isinstance(txt, str):\n        raise TypeError(\"txt must be a string\")\n\n    # If any whitespace character exists, split on whitespace\n    if any(c.isspace() for c in txt):\n        return txt.split()\n\n    # If no whitespace but commas exist, split on commas and remove empty tokens\n    if ',' in txt:\n        return [token for token in txt.split(',') if token != \"\"]\n\n    # Otherwise, count lowercase letters whose (ord(letter) - ord('a')) is odd\n    return sum(1 for c in txt if 'a' <= c <= 'z' and ((ord(c) - ord('a')) % 2 != 0))", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["as,words,,a"]]}], "HumanEval/124": [{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"Validates a date string for format 'mm-dd-yyyy' and correct date ranges.\n    Returns True for valid dates, False otherwise.\n    \"\"\"\n    if not date:\n        return False\n\n    parts = date.split('-')\n    if len(parts) != 3:\n        return False\n\n    if not (len(parts[0]) == 2 and len(parts[1]) == 2 and len(parts[2]) == 4):\n        return False\n\n    if not (parts[0].isdigit() and parts[1].isdigit() and parts[2].isdigit()):\n        return False\n\n    month = int(parts[0])\n    day = int(parts[1])\n\n    if not (1 <= month <= 12):\n        return False\n\n    if month in {1, 3, 5, 7, 8, 10, 12}:\n        if not (1 <= day <= 31):\n            return False\n    elif month in {4, 6, 9, 11}:\n        if not (1 <= day <= 30):\n            return False\n    elif month == 2:\n        if not (1 <= day <= 29):\n            return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"Validates a date string in 'mm-dd-yyyy' format, checkin