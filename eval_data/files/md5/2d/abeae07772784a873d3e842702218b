ail_tests": []}, {"task_id": "HumanEval/67", "solution": "def fruit_distribution(s,n):\n    \"\"\"\n    Given a string s describing counts of apples and oranges (e.g. \"5 apples and 6 oranges\")\n    and an integer total n (total fruits in the basket), return the number of mangoes:\n      mangoes = n - apples - oranges\n\n    Raises:\n      TypeError: if s is not a string or n is not an integer (or integer-like float).\n      ValueError: if apples or oranges counts cannot be parsed, are negative, or their sum exceeds n.\n    \"\"\"\n    import re\n\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a string\")\n    # Accept integer n; also allow float that is integer-valued\n    if not isinstance(n, int):\n        if isinstance(n, float) and n.is_integer():\n            n = int(n)\n        else:\n            raise TypeError(\"n must be an integer\")\n\n    # Match numbers immediately associated with 'apple(s)' and 'orange(s)', case-insensitive\n    apple_m = re.search(r'([+-]?\\d+)\\s*apples?', s, re.IGNORECASE)\n    orange_m = re.search(r'([+-]?\\d+)\\s*oranges?', s, re.IGNORECASE)\n\n    if not apple_m or not orange_m:\n        raise ValueError(\"Could not parse both apples and oranges counts from the string\")\n\n    apples = int(apple_m.group(1))\n    oranges = int(orange_m.group(1))\n\n    if apples < 0 or oranges < 0:\n        raise ValueError(\"Apple and orange counts must be non-negative\")\n\n    mangoes = n - apples - oranges\n\n    if mangoes < 0:\n        raise ValueError(\"Total n is less than the sum of apples and oranges\")\n\n    return mangoes", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/68": [{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even value and its index in the array.\n    Returns [value, index] or [] if no even values are found.\n    \"\"\"\n    smallest_even = None\n    smallest_even_index = -1\n\n    for i, num i