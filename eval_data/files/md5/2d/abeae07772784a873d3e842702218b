rd with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            if word < result_word:\n                result_word = word\n\n    return result_word", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/159": [{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"Calculates carrots eaten and remaining after attempting to eat 'need' more carrots.\n    Returns [total_eaten_after_meals, carrots_left_after_meals].\n    \"\"\"\n    eaten_now = min(need, remaining)\n    total_eaten = number + eaten_now\n    remaining_after = remaining - eaten_now\n    return [total_eaten, remaining_after]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Computes updated total eaten carrots and remaining stock.\n    Determines how many carrots are eaten now and calculates the new totals.\n    \"\"\"\n    eaten_now = min(need, remaining)\n    total_eaten = number + eaten_now\n    carrots_left = remaining - eaten_now\n    return [total_eaten, carrots_left]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/161": [{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa,\n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n    result_chars = []\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            if char.islower():\n                result_chars.append(char.upper())\n            else:\n                result_chars.append(char.lower())\n        else:\n            result_chars.append(char)\n\n    if not has_letters:\n        return s[::-1]\n    else:\n        return \"\".join(result_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Swaps case of alphabetic characters or reverses the string if no letters are present.\"\"\"\n    has_letters = any(char.isalpha() for char in s)\n\n    if not has_letters:\n        return s[::-1]\n    else:\n        transformed_chars = []\n        for char in s:\n            if char.islower():\n                transformed_chars.append(char.upper())\n            elif char.isupper():\n                transformed_chars.append(char.lower())\n            else:\n                transformed_chars.append(char)\n        return \"\".join(transformed_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/160": [{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Evaluates an algebraic expression built from lists of operators and operands.\n    Uses the shunting-yard algorithm to convert to RPN, then evaluates the RPN.\n    \"\"\"\n    # Basic validations\n    if not isinstance(operator, list) or not isinstance(operand, list):\n        raise ValueError(\"operator and operand must be lists\")\n    if len(operand) < 2:\n        raise ValueError(\"operand list must contain at least two elements\")\n    if len(operator) != len(operand) - 1:\n        raise ValueError(\"operator list length must be len(operand) - 1\")\n\n    allowed = {'+', '-', '*', '//', '**'}\n    for op in operator:\n        if op not in allowed:\n            raise ValueError(f\"Invalid operator: {op}\")\n    for val in operand:\n        if not isinstance(val, int) or val < 0:\n            raise ValueError(\"operands must be non-negative integers\")\n\n    precedence = {'+': 1, '-': 1, '*': 2, '//': 2, '**': 3}\n    associativity = {'+': 'left', '-': 'left', '*': 'left', '//': 'left', '**': 'right'}\n\n    output_queue = []\n    op_stack = []\n\n    # Shunting-yard algorithm (no parentheses in input)\n    for i in range(len(operand)):\n        output_queue.append(operand[i])\n\n        if i < len(operator):\n            op1 = operator[i]\n            while op_stack:\n                op2 = op_stack[-1]\n                op1_prec = precedence[op1]\n                op2_prec = precedence[op2]\n                op1_assoc = associativity[op1]\n\n                if (op1_assoc == 'left' and op1_prec <= op2_prec) or \\\n                   (op1_assoc == 'right' and op1_prec < op2_prec):\n                    output_queue.append(op_stack.pop())\n                else:\n                    break\n            op_stack.append(op1)\n\n    while op_stack:\n        output_queue.append(op_stack.pop())\n\n    # Evaluate RPN\n    eval_stack = []\n    for token in output_queue:\n        if isinstance(token, str) and token in precedence:\n            if len(eval_stack) < 2:\n                raise ValueError(\"Invalid expression\")\n            b = eval_stack.pop()\n            a = eval_stack.pop()\n\n            if token == '+':\n                res = a + b\n            elif token == '-':\n                res = a - b\n            elif token == '*':\n                res = a * b\n            elif token == '//':\n                # Let Python raise ZeroDivisionError if b == 0\n                res = a //