{"task_id": "Mbpp/572", "solution": "def two_unique_nums(numbers: list) -> list:\n    \"\"\"\n    Identifies and returns numbers that appear exactly once in the input list,\n    preserving their original order of first appearance.\n    \"\"\"\n    frequency_map = {}\n    for num in numbers:\n        frequency_map[num] = frequency_map.get(num, 0) + 1\n\n    unique_numbers_list = []\n    for num in numbers:\n        if frequency_map[num] == 1:\n            unique_numbers_list.append(num)\n\n    return unique_numbers_list"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"Calculates the last digit of the factorial of a given number.\n\n    Args:\n        n: An integer for which to calculate the last digit of its factorial.\n\n    Returns:\n        An integer representing the last digit of n! (0-9).\n    \"\"\"\n    if n < 0:\n        return 0  # Factorial is not defined for negative numbers, conventionally return 0 for last digit\n    if n == 0 or n == 1:\n        return 1\n    if n == 2:\n        return 2\n    if n == 3:\n        return 6\n    if n == 4:\n        return 4\n    # For n >= 5, n! will always end in 0 because it contains factors 2 and 5 (i.e., 10).\n    return 0"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Finds elements present in only one of two input tuples. Preserves relative order, with elements from the first tuple preceding those from the second.\"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n\n    dissimilar_from_tuple1 = tuple(element for element in tuple1 if element not in set2)\n    dissimilar_from_tuple2 = tuple(element for element in tuple2 if element not in set1)\n\n    return dissimilar_from_tuple1 + dissimilar_from_tuple2"}
{"task_id": "Mbpp/573", "solution": "import collections\nimport math\nfrom typing import List, Union\n\ndef unique_product(numbers_list: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the product of numbers that appear exactly once in the input list.\n    If no unique numbers are found, the product is 1 (multiplicative identity).\n    \"\"\"\n    if not numbers_list:\n        return 1\n\n    counts = collections.Counter(numbers_list)\n    unique_numbers_appearing_once = [num for num, count in counts.items() if count == 1]\n\n    if not unique_numbers_appearing_once:\n        return 1\n\n    return math.prod(unique_numbers_appearing_once)"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1: list, list2: list, list3: list) -> list:\n    \"\"\"Interleaves three input lists of the same length into a single flat list.\n    Elements are interleaved in the order: list1[i], list2[i], list3[i].\"\"\"\n    result = []\n    length = len(list1)\n    for i in range(length):\n        result.append(list1[i])\n        result.append(list2[i])\n        result.append(list3[i])\n    return result"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Recursively extracts even numbers from a nested tuple, preserving nesting.\n\n    Args:\n        input_tuple (tuple): The input tuple containing integers and/or nested tuples.\n\n    Returns:\n        tuple: A new tuple with only even numbers, maintaining the original nesting.\n    \"\"\"\n    result_list = []\n    for element in input_tuple:\n        if isinstance(element, int):\n            if element % 2 == 0:\n                result_list.append(element)\n        elif isinstance(element, tuple):\n            filtered_nested_tuple = extract_even(element)\n            result_list.append(filtered_nested_tuple)\n    return tuple(result_list)"}
{"task_id": "Mbpp/585", "solution": "def expensive_items(dataset: list[dict], n: int) -> list[dict]:\n    \"\"\"\n    Finds the 'n' most expensive items from the input dataset.\n    Handles edge cases for 'n' and empty datasets by returning an empty list for non-positive n or empty dataset,\n    and all items if n exceeds the dataset size.\n    \"\"\"\n    if n <= 0 or not dataset:\n        return []\n\n    # Sort the dataset by 'price' in descending order\n    sorted_dataset = sorted(dataset, key=lambda item: item.get('price', 0), reverse=True)\n\n    # Return the top 'n' items\n    return sorted_dataset[:n]"}
{"task_id": "Mbpp/583", "solution": "import math\n\ndef catalan_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Catalan number using the formula C_n = (2n)! / ((n + 1)! * n!).\n    Raises ValueError if n is negative.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input n must be a non-negative integer.\")\n    if n == 0:\n        return 1\n\n    numerator = math.factorial(2 * n)\n    denominator = math.factorial(n + 1) * math.factorial(n)\n    return numerator // denominator"}
{"task_id": "Mbpp/581", "solution": "import math\n\ndef surface_Area(base_edge: float, height: float) -> float:\n    \"\"\"\n    Calculates the total surface area of a square pyramid.\n    It sums the base area and the lateral surface area of the four triangular faces.\n    \"\"\"\n    # Calculate slant height using the Pythagorean theorem\n    slant_height = math.sqrt(height**2 + (base_edge / 2)**2)\n\n    # Calculate the area of the square base\n    base_area = base_edge ** 2\n\n    # Calculate the lateral surface area (four triangular faces)\n    # Area of one triangular face = 0.5 * base_edge * slant_height\n    # Lateral area = 4 * (0.5 * base_edge * slant_height) = 2 * base_edge * slant_height\n    lateral_area = 2 * base_edge * slant_height\n\n    # Total surface area is the sum of the base area and the lateral area\n    total_surface_area = base_area + lateral_area\n\n    return total_surface_area"}
