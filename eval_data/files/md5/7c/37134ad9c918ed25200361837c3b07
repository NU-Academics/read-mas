{"task_id": "Mbpp/471", "solution": "def find_remainder(list_of_integers: list, n: int) -> int:\n    \"\"\"Calculates the product of a list of integers modulo n.\n\n    Args:\n        list_of_integers: A list of integers.\n        n: An integer representing the modulo divisor.\n\n    Returns:\n        The product of list_of_integers elements modulo n.\n    \"\"\"\n    product_val = 1\n    for element in list_of_integers:\n        product_val = (product_val * element) % n\n    return product_val"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Calculates the pairwise addition of neighboring elements of the given tuple.\n\n    Args:\n        input_tuple: A tuple of numerical elements.\n\n    Returns:\n        A new tuple containing the sums of neighboring elements.\n        Returns an empty tuple if the input_tuple has fewer than two elements.\n    \"\"\"\n    if len(input_tuple) < 2:\n        return ()\n\n    results = []\n    for i in range(len(input_tuple) - 1):\n        results.append(input_tuple[i] + input_tuple[i+1])\n\n    return tuple(results)"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(numbers: list) -> bool:\n    \"\"\"\n    Checks if a list contains consecutive numbers.\n    Empty or single-element lists are considered trivially consecutive.\n    \"\"\"\n    if len(numbers) <= 1:\n        return True\n\n    sorted_numbers = sorted(numbers)\n    for i in range(1, len(sorted_numbers)):\n        if sorted_numbers[i] != sorted_numbers[i-1] + 1:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/473", "solution": "def _get_canonical_form(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Converts a tuple into a canonical, order-agnostic representation by sorting its elements.\n    For example, (4, 5) and (5, 4) both become (4, 5).\n    \"\"\"\n    return tuple(sorted(input_tuple))\n\n\ndef tuple_intersection(list1: list[tuple], list2: list[tuple]) -> set[tuple]:\n    \"\"\"\n    Finds the intersection of elements in two given lists of tuples,\n    irrespective of their order within the tuples.\n    Returns a set of tuples representing the common elements in their canonical (sorted) form.\n    \"\"\"\n    canonical_list1_set = set()\n    for tpl in list1:\n        canonical_list1_set.add(_get_canonical_form(tpl))\n\n    intersection_result = set()\n    for tpl in list2:\n        canonical_tpl = _get_canonical_form(tpl)\n        if canonical_tpl in canonical_list1_set:\n            intersection_result.add(canonical_tpl)\n\n    return intersection_result"}
{"task_id": "Mbpp/468", "solution": "def max_product(arr):\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of an increasing subsequence.\n    Applies dynamic programming to track the maximum product ending at each position.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n\n    # dp[i] stores the maximum product of an increasing subsequence ending with arr[i].\n    # Initialize each dp[i] with arr[i] itself, as a single element forms an increasing subsequence.\n    dp = list(arr) \n\n    # The maximum product found across all increasing subsequences.\n    # Initialize with the product of the first element, as it's the first possible subsequence.\n    max_overall_product = arr[0]\n\n    for i in range(n):\n        current_val = arr[i]\n        \n        # Consider subsequences ending at current_val.\n        # dp[i] is already initialized to current_val itself (a length-1 subsequence).\n        \n        for j in range(i):\n            if current_val > arr[j]:\n                # If current_val can extend an increasing subsequence ending at arr[j],\n                # update dp[i] with the maximum product possible by extending.\n                dp[i] = max(dp[i], dp[j] * current_val)\n        \n        # Update the overall maximum product found so far with the maximum product ending at index i.\n        max_overall_product = max(max_overall_product, dp[i])\n    \n    return max_overall_product"}
