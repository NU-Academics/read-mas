{"task_id": "Mbpp/392", "solution": "_memo = {}\n\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Calculates the maximum sum for n using the given recursive equation with memoization.\n    \"\"\"\n    if n in _memo:\n        return _memo[n]\n\n    if n == 0:\n        return 0\n\n    sum_of_parts = get_max_sum(n // 2) + get_max_sum(n // 3) + get_max_sum(n // 4) + get_max_sum(n // 5)\n    result = max(sum_of_parts, n)\n\n    _memo[n] = result\n    return result"}
{"task_id": "Mbpp/395", "solution": "import collections\n\ndef first_non_repeating_character(s: str) -> str | None:\n    # Use an OrderedDict to maintain insertion order while counting character frequencies.\n    char_counts = collections.OrderedDict()\n    for char in s:\n        char_counts[char] = char_counts.get(char, 0) + 1\n\n    # Iterate through the ordered counts to find the first character with a count of 1.\n    for char, count in char_counts.items():\n        if count == 1:\n            return char\n    return None"}
{"task_id": "Mbpp/398", "solution": "def sum_of_digits(numbers):\n    \"\"\"\n    Computes the sum of digits for each number in a list and returns their total sum.\n    \"\"\"\n    total_sum = 0\n    for number in numbers:\n        # Calculate sum of digits for the current number\n        digit_sum = 0\n        # Handle negative numbers by taking absolute value\n        current_number = abs(number)\n        if current_number == 0:\n            digit_sum = 0\n        else:\n            while current_number > 0:\n                digit_sum += current_number % 10\n                current_number //= 10\n        total_sum += digit_sum\n    return total_sum"}
