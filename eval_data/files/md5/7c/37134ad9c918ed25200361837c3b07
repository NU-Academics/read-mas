{"task_id": "Mbpp/620", "solution": "def _is_divisible_pair(a: int, b: int) -> bool:\n    \"\"\"\n    Checks if two given numbers form a divisible pair.\n    A pair (a, b) is 'divisible' if 'a' is perfectly divisible by 'b' or vice-versa.\n    \"\"\"\n    # Assuming valid inputs that do not lead to ZeroDivisionError,\n    # as per problem constraints and typical interpretations for this type of problem.\n    return a % b == 0 or b % a == 0\n\n\ndef largest_subset(numbers: list[int]) -> int:\n    \"\"\"\n    Calculates the size of the largest subset of a given list of numbers\n    where every pair in the subset is mutually divisible.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    # Sort the numbers in ascending order. This is crucial for the dynamic programming\n    # approach, as it ensures that if 'x' divides 'y', 'x' will appear before 'y'.\n    numbers.sort()\n\n    n = len(numbers)\n    # dp[i] stores the size of the largest divisible subset ending with numbers[i].\n    # Each number itself forms a subset of size 1.\n    dp = [1] * n\n\n    # Iterate through each number to build the DP array.\n    for i in range(n):\n        # Check all previous numbers to find potential predecessors.\n        for j in range(i):\n            # If numbers[i] can extend the divisible subset ending at numbers[j],\n            # update dp[i] to potentially form a larger subset.\n            if _is_divisible_pair(numbers[i], numbers[j]):\n                dp[i] = max(dp[i], dp[j] + 1)\n\n    # The maximum value in the DP array is the size of the largest divisible subset found.\n    return max(dp)"}
{"task_id": "Mbpp/629", "solution": "def find_even_numbers(numbers: list[int]) -> list[int]:\n    \"\"\"\n    Identifies and returns even numbers from a list of integers.\n    Filters the input list, appending only even numbers to a new list.\n    \"\"\"\n    even_numbers = []\n    for number in numbers:\n        if number % 2 == 0:\n            even_numbers.append(number)\n    return even_numbers"}
{"task_id": "Mbpp/630", "solution": "def get_coordinates(input_coordinate: tuple[int, int]) -> list[list[int]]:\n    \"\"\"\n    Calculates and returns a sorted list of all 9 coordinates (input + 8 adjacent).\n    \"\"\"\n    x, y = input_coordinate\n    adjacent_coords = []\n    dx = [-1, 0, 1]\n    dy = [-1, 0, 1]\n\n    for i in dx:\n        for j in dy:\n            adjacent_coords.append([x + i, y + j])\n\n    # Sort the list of coordinates based on x then y.\n    adjacent_coords.sort(key=lambda coord: (coord[0], coord[1]))\n    return adjacent_coords"}
