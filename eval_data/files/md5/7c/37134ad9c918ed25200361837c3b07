{"task_id": "Mbpp/721", "solution": "import math\n\nclass Cell:\n    \"\"\"Stores the row, column, and cost of a single cell in the matrix.\"\"\"\n    def __init__(self, row: int, col: int, cost: int):\n        self.row = row\n        self.col = col\n        self.cost = cost\n\nclass Matrix:\n    \"\"\"Manages the grid of Cell objects, provides access to cells, and validates coordinates.\"\"\"\n    def __init__(self, raw_matrix: list[list[int]]):\n        self._N = len(raw_matrix)\n        self._cells = [[Cell(r, c, raw_matrix[r][c]) for c in range(self._N)] for r in range(self._N)]\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        return self._cells[row][col]\n\n    def get_N(self) -> int:\n        return self._N\n\n    def is_valid_coordinate(self, row: int, col: int) -> bool:\n        return 0 <= row < self._N and 0 <= col < self._N\n\nclass Path:\n    \"\"\"Represents a specific sequence of cells and calculates its total cost, number of cells, and average cost.\"\"\"\n    def __init__(self, initial_cell: Cell):\n        self._sequence_of_cells = [initial_cell]\n        self._total_cost = initial_cell.cost\n        self._number_of_cells = 1\n        self._average_cost = float(initial_cell.cost)\n\n    def add_cell(self, cell: Cell):\n        self._sequence_of_cells.append(cell)\n        self._total_cost += cell.cost\n        self._number_of_cells += 1\n        self._average_cost = float(self._total_cost) / self._number_of_cells\n\n    def calculate_total_cost(self) -> int:\n        return self._total_cost\n\n    def count_cells(self) -> int:\n        return self._number_of_cells\n\n    def calculate_average(self) -> float:\n        return self._average_cost\n\n    def get_average_cost(self) -> float:\n        return self._average_cost\n\n    def get_last_cell(self) -> Cell:\n        return self._sequence_of_cells[-1]\n\ndef maxAverageOfPath(matrix_data: list[list[int]]) -> float:\n    \"\"\"\n    Implements the core algorithm to find the path with the maximum average cost in a given matrix.\n    Uses dynamic programming to compute maximum sum and minimum count for a given sum up to a cell.\n    \"\"\"\n    matrix = Matrix(matrix_data)\n    N = matrix.get_N()\n\n    # dp_sum[r][c] will store the maximum sum to reach (r, c)\n    # dp_count[r][c] will store the minimum number of cells to reach (r, c)\n    # (The number of cells is fixed for any path from top-left to bottom-right, but intermediate paths may vary.\n    #  This problem cannot be solved with standard DP max sum / min count as average is sum/count.\n    #  Instead, we can use binary search on the answer or a different DP state.)\n\n    # Re-evaluating the DP state for maximum average.\n    # A standard DP for max average path would involve a more complex state or binary search.\n    # However, given the constraint of only right/down moves, all paths from (0,0) to (r,c)\n    # have a fixed length (r+c+1). Thus, maximizing sum automatically maximizes average for fixed length paths.\n    # For full paths from (0,0) to (N-1, N-1), the length is N+N-1.\n\n    # If the problem statement implies \"maximum average over all existing paths\" includes paths\n    # from (0,0) to (N-1, N-1), then all such paths have the same number of cells (N + N - 1).\n    # In this specific case, maximizing the average is equivalent to maximizing the total sum.\n\n    # Let's assume for paths from (0,0) to (N-1, N-1) the number of cells is constant.\n    # A path is defined as starting from top-left and ending bottom-right.\n    # Number of cells = (N-1 - 0 + 1) + (N-1 - 0) = N + N - 1 = 2N - 1 for a path.\n    # E.g. 3x3 matrix. Path length = 2+2+1 = 5.\n    # (0,0) -> (0,1) -> (0,2) -> (1,2) -> (2,2)\n    # This means the length is fixed to (N-1-0) + (N-1-0) + 1 = 2*N-1.\n\n    # So, we need to find the maximum sum path.\n    dp_max_sum = [[0.0] * N for _ in range(N)]\n\n    # Initialize dp_max_sum for the first cell\n    dp_max_sum[0][0] = matrix.get_cell(0, 0).cost\n\n    # Initialize first row\n    for c in range(1, N):\n        dp_max_sum[0][c] = dp_max_sum[0][c-1] + matrix.get_cell(0, c).cost\n\n    # Initialize first column\n    for r in range(1, N):\n        dp_max_sum[r][0] = dp_max_sum[r-1][0] + matrix.get_cell(r, 0).cost\n\n    # Fill the rest of the dp_max_sum table\n    for r in range(1, N):\n        for c in range(1, N):\n            current_cost = matrix.get_cell(r, c).cost\n            dp_max_sum[r][c] = max(dp_max_sum[r-1][c], dp_max_sum[r][c-1]) + current_cost\n\n    max_total_cost = dp_max_sum[N-1][N-1]\n    num_cells_in_path = (N - 1 - 0) + (N - 1 - 0) + 1 # (row_moves + col_moves + 1)\n    \n    return max_total_cost / num_cells_in_path"}
{"task_id": "Mbpp/722", "solution": "def filter_data(student_data: dict[str, tuple[float, float]], minimal_height: float, minimal_weight: float) -> dict[str, tuple[float, float]]:\n    \"\"\"\n    Filters student data, returning only students whose height and weight meet the minimum criteria.\n    \"\"\"\n    filtered_students = {}\n    for name, (height, weight) in student_data.items():\n        if height >= minimal_height and weight >= minimal_weight:\n            filtered_students[name] = (height, weight)\n    return filtered_students"}
