{"task_id": "Mbpp/84", "solution": "_memo = {}\n\ndef sequence(n: int) -> int:\n    \"\"\"Calculates the nth Newman-Conway sequence number using memoization.\"\"\"\n    if n in _memo:\n        return _memo[n]\n\n    if n == 1 or n == 2:\n        _memo[n] = 1\n        return 1\n    else:\n        val_n_minus_1 = sequence(n - 1)\n        val_n_minus_val_n_minus_1 = sequence(n - val_n_minus_1)\n        result = val_n_minus_1 + val_n_minus_val_n_minus_1\n        _memo[n] = result\n        return result"}
