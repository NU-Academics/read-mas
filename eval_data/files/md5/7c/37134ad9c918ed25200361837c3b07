{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    # Finds the highest power of 2 less than or equal to n.\n    # It iteratively doubles a power of 2 until the next power exceeds n.\n    power = 1\n    while power * 2 <= n:\n        power *= 2\n    return power"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(number: int) -> int:\n    \"\"\"Sets the leftmost unset bit in the given integer.\n\n    Finds the highest-order bit that is 0 and flips it to 1.\n    \"\"\"\n    if number == 0:\n        return 1\n\n    # Determine the position of the highest currently set bit.\n    # For example, 10 (0b1010) has bit_length() = 4, so the highest set bit is at index 3.\n    highest_set_bit_idx = number.bit_length() - 1\n\n    # Iterate from the highest set bit position downwards to find the leftmost unset bit.\n    leftmost_unset_bit_pos = -1\n    for i in range(highest_set_bit_idx, -1, -1):\n        # Check if the bit at position 'i' is unset (0).\n        if (number >> i) & 1 == 0:\n            leftmost_unset_bit_pos = i\n            break # Found the leftmost unset bit, exit loop\n\n    # If no unset bit was found within the range [0, highest_set_bit_idx],\n    # it implies all bits up to highest_set_bit_idx are set.\n    # In this scenario, the leftmost unset bit is at the next position.\n    if leftmost_unset_bit_pos == -1:\n        leftmost_unset_bit_pos = highest_set_bit_idx + 1\n\n    # Set the identified leftmost unset bit using a bitwise OR operation.\n    return number | (1 << leftmost_unset_bit_pos)"}
{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(list_ids, list_names, list_scores):\n    \"\"\"Converts three input lists to a list of nested dictionaries based on corresponding indices.\n    Each element from list_ids becomes an outer key, list_names an inner key, and list_scores an inner value.\"\"\"\n    result = []\n    for i in range(len(list_ids)):\n        inner_dict = {list_names[i]: list_scores[i]}\n        outer_dict = {list_ids[i]: inner_dict}\n        result.append(outer_dict)\n    return result"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    \"\"\"Calculates the n'th Lucas number using an iterative approach.\"\"\"\n    if n == 0:\n        return 2\n    elif n == 1:\n        return 1\n\n    a, b = 2, 1  # Initialize with L(0) and L(1)\n    for _ in range(2, n + 1):\n        a, b = b, a + b  # Update a to L(k-1) and b to L(k)\n    return b"}
