{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(upper_limit: int) -> int:\n    \"\"\"Calculates the sum of all amicable numbers from 1 to upper_limit (inclusive).\"\"\"\n\n    def _sum_proper_divisors(n: int) -> int:\n        \"\"\"Calculates the sum of proper divisors for a given positive integer n.\"\"\"\n        if n <= 1:\n            return 0\n        s = 1  # 1 is always a proper divisor\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                s += i\n                if i * i != n:\n                    s += n // i\n        return s\n\n    amicable_set = set()\n    for a in range(1, upper_limit + 1):\n        sum_div_a = _sum_proper_divisors(a)\n\n        # Ensure sum_div_a is within bounds and distinct from a\n        if sum_div_a > a and sum_div_a <= upper_limit:\n            sum_div_b = _sum_proper_divisors(sum_div_a)\n\n            if sum_div_b == a:\n                amicable_set.add(a)\n                amicable_set.add(sum_div_a)\n\n    return sum(amicable_set)"}
{"task_id": "Mbpp/126", "solution": "def sum_common_divisors(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of common divisors for two given positive integers.\n\n    Raises:\n        ValueError: If num1 or num2 are not positive integers.\n    \"\"\"\n    if not isinstance(num1, int) or not isinstance(num2, int):\n        raise ValueError(\"Inputs must be integers.\")\n    if num1 <= 0 or num2 <= 0:\n        raise ValueError(\"Inputs must be positive integers.\")\n\n    def _get_divisors(number: int) -> set[int]:\n        \"\"\"Finds all positive divisors for a given positive integer.\"\"\"\n        divs = set()\n        for i in range(1, int(number**0.5) + 1):\n            if number % i == 0:\n                divs.add(i)\n                divs.add(number // i)\n        return divs\n\n    def _get_common_divisors(divisors1: set[int], divisors2: set[int]) -> set[int]:\n        \"\"\"Finds common divisors between two sets of divisors.\"\"\"\n        return divisors1.intersection(divisors2)\n\n    divisors1 = _get_divisors(num1)\n    divisors2 = _get_divisors(num2)\n    common_divs = _get_common_divisors(divisors1, divisors2)\n    return sum(common_divs)"}
{"task_id": "Mbpp/128", "solution": "def long_words(n: int, input_string: str) -> list[str]:\n    \"\"\"\n    Finds words longer than n characters from a given input string.\n\n    Args:\n        n (int): The minimum length threshold. Words strictly longer than 'n' are returned.\n        input_string (str): The string containing words to be processed.\n\n    Returns:\n        list[str]: A list of words from the input_string that are longer than 'n'.\n    \"\"\"\n    words = input_string.split()\n    filtered_words = [word for word in words if len(word) > n]\n    return filtered_words"}
