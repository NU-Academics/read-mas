{"task_id": "Mbpp/266", "solution": "class Cube:\n    \"\"\"\n    Encapsulates the properties and calculation logic for a cube's lateral surface area.\n    Ensures data integrity for the side length.\n    \"\"\"\n    def __init__(self, side_length: float):\n        self._validate_side_length(side_length)\n        self._side_length = side_length\n\n    def _validate_side_length(self, value: float):\n        if not isinstance(value, (int, float)) or value <= 0:\n            raise ValueError(\"Side length must be a positive numerical value.\")\n\n    def calculate_lateral_surface_area(self) -> float:\n        \"\"\"Calculates and returns the lateral surface area based on the stored side length.\"\"\"\n        return 4 * (self._side_length ** 2)\n\n    def get_side_length(self) -> float:\n        \"\"\"Returns the current side length of the cube.\"\"\"\n        return self._side_length\n\n    def set_side_length(self, new_side_length: float):\n        \"\"\"Sets a new side length for the cube after validation.\"\"\"\n        self._validate_side_length(new_side_length)\n        self._side_length = new_side_length\n\ndef lateralsurface_cube(side_length: float) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cube given its side length.\n    Validates input and uses the Cube class for calculation.\n    \"\"\"\n    if not isinstance(side_length, (int, float)) or side_length <= 0:\n        raise ValueError(\"Side length must be a positive numerical value.\")\n\n    cube = Cube(side_length)\n    return cube.calculate_lateral_surface_area()"}
{"task_id": "Mbpp/265", "solution": "def list_split(input_list, n):\n    \"\"\"Splits a list into n sublists, distributing elements cyclically based on their original index.\n\n    The i-th sublist (0-indexed) receives elements whose original index modulo n equals i.\n    \"\"\"\n    result = [[] for _ in range(n)]\n    for index, element in enumerate(input_list):\n        target_sublist_index = index % n\n        result[target_sublist_index].append(element)\n    return result"}
{"task_id": "Mbpp/264", "solution": "def dog_age(human_years: int) -> int:\n    \"\"\"\n    Calculates a dog's age in dog years.\n    Applies a specific formula: 10.5 dog years for each of the first two human years,\n    then 4 dog years for each subsequent human year.\n    \"\"\"\n    if human_years <= 0:\n        return 0\n    elif human_years <= 2:\n        return round(human_years * 10.5)\n    else:\n        return round(2 * 10.5) + (human_years - 2) * 4"}
