{"task_id": "Mbpp/731", "solution": "import math\n\ndef lateralsurface_cone(r, h):\n    \"\"\"\n    Calculates the lateral surface area of a cone.\n    Formula: pi * r * sqrt(r^2 + h^2)\n    \"\"\"\n    slant_height = math.sqrt(r**2 + h**2)\n    lateral_area = math.pi * r * slant_height\n    return lateral_area"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"\n    Toggles all bits of the input integer except for the most significant bit\n    and the least significant bit.\n    \"\"\"\n    if number == 0:\n        return 0\n\n    num_bits = number.bit_length()\n\n    if num_bits <= 2:\n        return number\n\n    # Create a mask for the bits between MSB and LSB\n    # Example: for num_bits = 4, middle_mask should be 0110 (6)\n    middle_mask = ((1 << (num_bits - 2)) - 1) << 1\n\n    # Toggle the middle bits using XOR\n    result = number ^ middle_mask\n\n    return result"}
{"task_id": "Mbpp/737", "solution": "import re\n\ndef check_str(input_string: str) -> bool:\n    \"\"\"\n    Checks if the input_string starts with a vowel (A, E, I, O, U),\n    case-insensitively, using a regular expression.\n    \"\"\"\n    pattern = re.compile(r'^[aeiou]', re.IGNORECASE)\n    return bool(pattern.match(input_string))"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(input_list: list[int | float]) -> int | float:\n    \"\"\"Calculates the sum of products of all possible contiguous sublists of a given list.\"\"\"\n    total_sum_of_products = 0\n\n    for i in range(len(input_list)):\n        current_product = 1\n        for j in range(i, len(input_list)):\n            current_product *= input_list[j]\n            total_sum_of_products += current_product\n\n    return total_sum_of_products"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(arr: list[int | float], target: int | float) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array.\n\n    Args:\n        arr: A list of numbers sorted in ascending order.\n        target: The number to search for.\n\n    Returns:\n        The 0-based index of the first occurrence of the target number, or -1 if not found.\n    \"\"\"\n    low, high = 0, len(arr) - 1\n    result = -1\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == target:\n            result = mid\n            high = mid - 1  # Try to find an earlier occurrence\n        elif arr[mid] < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sorted_list: list, value: object) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted list.\n    This function uses binary search to find the index where the value should be inserted.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/739", "solution": "def _calculate_triangular_number(k: int) -> int:\n    \"\"\"Calculates the triangular number for a given index k.\"\"\"\n    return k * (k + 1) // 2\n\ndef _count_digits(number: int) -> int:\n    \"\"\"Counts the number of decimal digits in a given integer.\"\"\"\n    return len(str(number))\n\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    It iteratively calculates triangular numbers until one with 'n' digits is found.\n    \"\"\"\n    k = 1\n    while True:\n        triangular_number = _calculate_triangular_number(k)\n        num_digits = _count_digits(triangular_number)\n        \n        if num_digits == n:\n            return k\n        \n        k += 1"}
