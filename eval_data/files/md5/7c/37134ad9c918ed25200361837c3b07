{"task_id": "Mbpp/614", "solution": "from typing import List, Tuple, Union\n\ndef cummulative_sum(tuple_list: List[Tuple[Union[int, float], ...]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the cumulative sum of all numeric values present in a list of tuples.\n    Returns 0 if the input list is empty or contains only empty tuples.\n    \"\"\"\n    total_sum = 0\n    for tpl in tuple_list:\n        for value in tpl:\n            total_sum += value\n    return total_sum"}
{"task_id": "Mbpp/611", "solution": "from typing import List, Union\n\ndef max_of_nth(matrix: List[List[Union[int, float]]], n: int) -> Union[int, float]:\n    \"\"\"Calculates the maximum value of the n-th column in a matrix. Raises IndexError for invalid matrix/column, ValueError if the column is empty.\"\"\"\n    if not matrix:\n        raise IndexError(\"Matrix cannot be empty.\")\n    if not matrix[0]:\n        raise IndexError(\"Matrix rows cannot be empty.\")\n    if not (0 <= n < len(matrix[0])):\n        raise IndexError(f\"Column index {n} is out of bounds for a matrix with {len(matrix[0])} columns.\")\n\n    column_values = []\n    for row in matrix:\n        if len(row) <= n:\n            continue\n        column_values.append(row[n])\n\n    if not column_values:\n        raise ValueError(\"Specified column is empty or no valid rows found for the column.\")\n\n    return max(column_values)"}
