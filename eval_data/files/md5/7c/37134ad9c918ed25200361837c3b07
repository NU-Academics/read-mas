{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n: int) -> float:\n    \"\"\"\n    Calculates the average of the cubes of the first 'n' natural numbers.\n    Raises a ValueError if 'n' is less than 1.\n    \"\"\"\n    if n < 1:\n        raise ValueError(\"Input 'n' must be a natural number (n >= 1).\")\n\n    sum_of_cubes = 0\n    for i in range(1, n + 1):\n        sum_of_cubes += i * i * i\n\n    return sum_of_cubes / n"}
{"task_id": "Mbpp/427", "solution": "class Date:\n    \"\"\"Represents a date and provides methods for format conversion.\"\"\"\n\n    def __init__(self, year: str, month: str, day: str):\n        \"\"\"Initializes the Date object with year, month, and day components.\"\"\"\n        self._year = year\n        self._month = month\n        self._day = day\n\n    def convertTo_dd_mm_yyyy(self) -> str:\n        \"\"\"Converts the date to 'dd-mm-yyyy' format.\"\"\"\n        return f\"{self._day}-{self._month}-{self._year}\"\n\ndef change_date_format(date_str: str) -> str:\n    \"\"\"Converts a date string from 'yyyy-mm-dd' to 'dd-mm-yyyy' format.\"\"\"\n    try:\n        year, month, day = date_str.split('-')\n        if not (len(year) == 4 and len(month) == 2 and len(day) == 2):\n            raise ValueError(\"Date components must have correct lengths.\")\n    except ValueError as e:\n        raise ValueError(f\"Invalid date format. Expected 'yyyy-mm-dd'. Error: {e}\")\n\n    date_obj = Date(year, month, day)\n    return date_obj.convertTo_dd_mm_yyyy()"}
{"task_id": "Mbpp/429", "solution": "def and_tuples(tuple1: tuple[int, ...], tuple2: tuple[int, ...]) -> tuple[int, ...]:\n    \"\"\"\n    Performs element-wise bitwise AND on two input tuples of integers.\n    Returns a new tuple with the results of the bitwise AND operation for corresponding elements.\n    \"\"\"\n    # Validate input types and content\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise ValueError(\"Inputs must be tuples.\")\n    \n    if not all(isinstance(x, int) for x in tuple1) or not all(isinstance(x, int) for x in tuple2):\n        raise ValueError(\"All elements in both tuples must be integers.\")\n\n    # Validate tuple lengths\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Tuples must have equal length.\")\n\n    # Perform element-wise bitwise AND\n    result_list = [a & b for a, b in zip(tuple1, tuple2)]\n\n    # Convert the list of results to a tuple and return\n    return tuple(result_list)"}
