{"task_id": "Mbpp/170", "solution": "def sum_range_list(numbers: list, start_index: int, end_index: int) -> (int | float):\n    \"\"\"\n    Calculates the sum of numbers in a list within a specified inclusive range.\n    Performs validation for list elements, index bounds, and index order.\n    \"\"\"\n    if not all(isinstance(num, (int, float)) for num in numbers):\n        raise ValueError(\"List contains non-numerical values\")\n\n    if not numbers and (start_index != 0 or end_index != -1): # allow empty list with valid empty range\n        if start_index < 0 or end_index >= 0: # If list is empty, start and end must represent an empty range\n            raise IndexError(\"Indices out of bounds for an empty list\")\n\n    if not (0 <= start_index < len(numbers) or (start_index == 0 and len(numbers) == 0)):\n        raise IndexError(\"Start index out of bounds\")\n    if not (0 <= end_index < len(numbers) or (end_index == -1 and len(numbers) == 0)):\n        raise IndexError(\"End index out of bounds\")\n\n    if start_index > end_index:\n        raise ValueError(\"Start index cannot be greater than end index\")\n    \n    current_sum = 0\n    for i in range(start_index, end_index + 1):\n        current_sum += numbers[i]\n    return current_sum"}
{"task_id": "Mbpp/223", "solution": "def find_first_occurrence(arr: list[int], n: int, x: int) -> int:\n    \"\"\"Finds the index of the first occurrence of x in arr using binary search.\n    Returns -1 if not found.\"\"\"\n    low = 0\n    high = n - 1\n    result = -1\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == x:\n            result = mid\n            high = mid - 1  # Try to find an even earlier occurrence\n        elif arr[mid] < x:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result\n\ndef find_last_occurrence(arr: list[int], n: int, x: int) -> int:\n    \"\"\"Finds the index of the last occurrence of x in arr using binary search.\n    Returns -1 if not found.\"\"\"\n    low = 0\n    high = n - 1\n    result = -1\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == x:\n            result = mid\n            low = mid + 1  # Try to find an even later occurrence\n        elif arr[mid] < x:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result\n\ndef is_majority(arr: list[int], n: int, x: int) -> bool:\n    \"\"\"Checks if an element x is the majority element in a sorted array arr of length n.\"\"\"\n    first_index = find_first_occurrence(arr, n, x)\n    if first_index == -1:\n        return False\n\n    last_index = find_last_occurrence(arr, n, x)\n    count = last_index - first_index + 1\n\n    return count > n / 2"}
