{"task_id": "Mbpp/743", "solution": "def rotate_right(input_list: list, rotation_count: int) -> list:\n    \"\"\"\n    Rotates a given list by a specified number of items to the right direction.\n    A new list with the elements rotated to the right is returned; the original input_list is not modified.\n    \"\"\"\n    n = len(input_list)\n    if n == 0:\n        return []\n\n    effective_rotation = rotation_count % n\n\n    if effective_rotation == 0:\n        return list(input_list)\n\n    split_point = n - effective_rotation\n\n    return input_list[split_point:] + input_list[:split_point]"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_string: str) -> str:\n    \"\"\"\n    Inserts spaces before words starting with capital letters in a given string.\n    A space is inserted before any uppercase letter that is not the first character\n    of the original string.\n    \"\"\"\n    if not input_string:\n        return \"\"\n\n    result_chars = []\n    for i, char in enumerate(input_string):\n        if i > 0 and char.isupper():\n            result_chars.append(' ')\n        result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/745", "solution": "def _get_digits(number: int) -> list[int]:\n    \"\"\"Extracts individual digits from a given integer.\"\"\"\n    return [int(d) for d in str(number)]\n\ndef _contains_zero(digits: list[int]) -> bool:\n    \"\"\"Checks if a list of digits contains the digit '0'.\"\"\"\n    return 0 in digits\n\ndef _is_divisible_by_all_non_zero_digits(number: int, digits: list[int]) -> bool:\n    \"\"\"Verifies if a number is perfectly divisible by all its non-zero digits.\"\"\"\n    for digit in digits:\n        if digit == 0: # This check is redundant if _contains_zero is called first, but good for robustness.\n            continue\n        if number % digit != 0:\n            return False\n    return True\n\ndef divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"Finds numbers within an inclusive range [startnum, endnum] where every number is divisible by every digit it contains (excluding zero digits).\"\"\"\n    result_list = []\n    for number in range(startnum, endnum + 1):\n        digits = _get_digits(number)\n        if _contains_zero(digits):\n            continue\n        if _is_divisible_by_all_non_zero_digits(number, digits):\n            result_list.append(number)\n    return result_list"}
{"task_id": "Mbpp/753", "solution": "def min_k(data_list: list[tuple[str, int]], k: int) -> list[tuple[str, int]]:\n    \"\"\"\n    Finds the k records with the minimum second element from a list of tuples.\n    Returns a list of k tuples, sorted by their second element in ascending order.\n    \"\"\"\n    sorted_data = sorted(data_list, key=lambda x: x[1])\n    return sorted_data[:k]"}
{"task_id": "Mbpp/750", "solution": "def add_tuple(input_list: list, input_tuple: tuple) -> list:\n    \"\"\"\n    Adds the elements of input_tuple to the end of input_list, returning a new list.\n    \"\"\"\n    result_list = list(input_list)\n    result_list.extend(input_tuple)\n    return result_list"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n):\n    \"\"\"\n    Calculates the nth Jacobsthal number using an iterative approach.\n    The sequence starts with J(0)=0, J(1)=1, and J(n) = J(n-1) + 2*J(n-2) for n > 1.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    else:\n        a, b = 0, 1  # Represents J(i-2) and J(i-1)\n        for _ in range(2, n + 1):\n            current = b + 2 * a\n            a = b\n            b = current\n        return b"}
{"task_id": "Mbpp/749", "solution": "def sort_numeric_strings(list_of_string_numbers: list[str]) -> list[int | float]:\n    \"\"\"Converts a list of numeric strings to numbers and sorts them numerically.\"\"\"\n    numeric_list = []\n    for s_num in list_of_string_numbers:\n        try:\n            numeric_list.append(int(s_num))\n        except ValueError:\n            numeric_list.append(float(s_num))\n    numeric_list.sort()\n    return numeric_list"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(input_list):\n    \"\"\"\n    Finds the second smallest number in a list of numbers.\n    Assumes the input list contains at least two numeric elements.\n    \"\"\"\n    sorted_list = sorted(input_list)\n    return sorted_list[1]"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr: list) -> bool:\n    \"\"\"\n    Determines if the given list represents a min-heap.\n\n    A min-heap property is satisfied if for every parent node at index i,\n    its value is less than or equal to the values of its children nodes.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return True\n\n    for i in range(n // 2 - 1, -1, -1):\n        parent_value = arr[i]\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        if left_child_idx < n and parent_value > arr[left_child_idx]:\n            return False\n\n        if right_child_idx < n and parent_value > arr[right_child_idx]:\n            return False\n    return True"}
{"task_id": "Mbpp/757", "solution": "def _reverse_string(s: str) -> str:\n    \"\"\"Reverses the input string.\n    \"\"\"\n    return s[::-1]\n\ndef count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"Counts unique reverse string pairs in the given list.\n\n    Args:\n        string_list: A list of strings.\n\n    Returns:\n        An integer representing the total count of unique reverse string pairs.\n    \"\"\"\n    pair_count = 0\n    used_strings = set()\n    string_set = set(string_list) # Convert to set for O(1) average time complexity for lookups\n\n    for s in string_list:\n        if s in used_strings:\n            continue\n\n        reversed_s = _reverse_string(s)\n\n        # Check if the reversed string exists, is distinct from the original, and hasn't been used\n        if reversed_s in string_set and reversed_s != s and reversed_s not in used_strings:\n            pair_count += 1\n            used_strings.add(s)\n            used_strings.add(reversed_s)\n\n    return pair_count"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Finds common elements from three lists at the same index.\n\n    An element is considered common if it appears in all three input lists\n    at the exact same index.\n    \"\"\"\n    common_elements = []\n    min_length = min(len(list1), len(list2), len(list3))\n\n    for i in range(min_length):\n        if list1[i] == list2[i] and list2[i] == list3[i]:\n            common_elements.append(list1[i])\n    return common_elements"}
{"task_id": "Mbpp/760", "solution": "def unique_Element(numbers: list) -> bool:\n    \"\"\"\n    Checks if a list of numbers contains only one distinct element.\n    Returns True for an empty list as per common interpretation.\n    \"\"\"\n    if not numbers:\n        return True\n    return len(set(numbers)) <= 1"}
{"task_id": "Mbpp/759", "solution": "def is_decimal(inputString: str) -> bool:\n    \"\"\"\n    Checks if the given string is a decimal number with a precision of 2.\n    It requires a decimal point and exactly two digits after it.\n    \"\"\"\n    if not inputString:\n        return False\n\n    parts = inputString.split('.')\n    if len(parts) != 2:\n        return False\n\n    integer_part = parts[0]\n    decimal_part = parts[1]\n\n    if integer_part and not integer_part.isdigit():\n        return False\n\n    if not decimal_part.isdigit() or len(decimal_part) != 2:\n        return False\n\n    return True"}
{"task_id": "Mbpp/758", "solution": "def unique_sublists(input_list: list[list[any]]) -> dict[tuple[any], int]:\n    \"\"\"\n    Counts occurrences of sublists within a list, converting each sublist to a tuple.\n    Returns a dictionary where keys are unique tuple representations and values are their counts.\n    \"\"\"\n    counts_dict = {}\n    for sublist in input_list:\n        sublist_tuple = tuple(sublist)\n        counts_dict[sublist_tuple] = counts_dict.get(sublist_tuple, 0) + 1\n    return counts_dict"}
{"task_id": "Mbpp/763", "solution": "import math\n\ndef find_min_diff(arr: tuple[int, ...], size: int) -> int:\n    \"\"\"\n    Calculates the minimum absolute difference between any two elements in the given array.\n    \"\"\"\n    \n    def _compute_pairwise_differences(elements: tuple[int, ...]) -> list[int]:\n        \"\"\"\n        Computes all unique pairwise absolute differences from a list of elements.\n        \"\"\"\n        differences = []\n        n = len(elements)\n        for i in range(n):\n            for j in range(i + 1, n):\n                differences.append(abs(elements[i] - elements[j]))\n        return differences\n\n    def _determine_minimum(differences: list[int]) -> int:\n        \"\"\"\n        Finds the minimum value in a list of differences.\n        \"\"\"\n        return min(differences)\n\n    all_differences = _compute_pairwise_differences(arr)\n    min_diff = _determine_minimum(all_differences)\n    return min_diff"}
{"task_id": "Mbpp/762", "solution": "def check_monthnumber_number(month_number: int) -> bool:\n    \"\"\"\n    Checks if the given month number (1-12) corresponds to a month with 30 days.\n    Months with 30 days are April (4), June (6), September (9), and November (11).\n    \"\"\"\n    return month_number in (4, 6, 9, 11)"}
{"task_id": "Mbpp/765", "solution": "def calculate_nth_polite_number(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number. A polite number is a positive integer that is not a power of 2.\n    \"\"\"\n    polite_count = 0\n    num = 1\n    while True:\n        # A positive integer x is a power of 2 if (x > 0) and (x & (x - 1) == 0).\n        is_power_of_2 = (num > 0) and ((num & (num - 1)) == 0)\n\n        if not is_power_of_2:\n            polite_count += 1\n            if polite_count == n:\n                return num\n        num += 1"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list: list) -> list[tuple]:\n    \"\"\"\n    Returns a list of all pairs of consecutive items in a given list.\n    \"\"\"\n    if len(input_list) < 2:\n        return []\n\n    result = []\n    for i in range(len(input_list) - 1):\n        result.append((input_list[i], input_list[i+1]))\n    return result"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(input_string: str) -> int:\n    \"\"\"\n    Counts the number of digit characters in the given string.\n    Iterates through each character and increments a counter if the character is a digit.\n    \"\"\"\n    count = 0\n    for char in input_string:\n        if '0' <= char <= '9':  # Check if the character is a digit\n            count += 1\n    return count"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list[int], target_sum: int) -> int:\n    \"\"\"\n    Counts pairs in a list that sum to a target value.\n    Args:\n        numbers: A list of integers.\n        target_sum: The integer target sum.\n    Returns:\n        The total count of pairs whose sum equals target_sum.\n    \"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n    return count"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1: list, list2: list) -> list:\n    \"\"\"\n    Calculates the difference between two lists, returning elements from list1\n    that are not present in list2, while preserving the original order from list1.\n    \"\"\"\n    set_list2 = set(list2)\n    result_list = []\n    for item in list1:\n        if item not in set_list2:\n            result_list.append(item)\n    return result_list"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression_string: str) -> bool:\n    \"\"\"\n    Checks if the given expression string has balanced delimiters.\n    Uses a stack-based approach to match opening and closing delimiters.\n    \"\"\"\n    stack = []\n    delimiter_map = {\n        '(': ')',\n        '{': '}',\n        '[': ']'\n    }\n    opening_delimiters = set(delimiter_map.keys())\n\n    for char in expression_string:\n        if char in opening_delimiters:\n            stack.append(char)\n        elif char in delimiter_map.values():\n            if not stack:\n                return False  # Closing delimiter without a corresponding opening one\n            last_open = stack.pop()\n            if delimiter_map[last_open] != char:\n                return False  # Mismatch between opening and closing delimiter\n\n    return not stack  # True if stack is empty, False otherwise"}
{"task_id": "Mbpp/773", "solution": "from typing import Tuple, Optional\n\ndef occurance_substring(main_string: str, substring: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Finds the first occurrence and position of a substring within a string.\n    Returns None if there is no match.\n    \"\"\"\n    index = main_string.find(substring)\n    if index != -1:\n        return (substring, index, index + len(substring))\n    else:\n        return None"}
{"task_id": "Mbpp/772", "solution": "def remove_length(input_string: str, k: int) -> str:\n    \"\"\"\n    Removes all words of length `k` from the given string.\n    \"\"\"\n    words = input_string.split()\n    filtered_words = []\n    for word in words:\n        if len(word) != k:\n            filtered_words.append(word)\n    return ' '.join(filtered_words)"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth power of the first n odd natural numbers.\n    The function iterates n times, calculating each odd number's fourth power and summing it up.\n    \"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        current_odd_num = 2 * i - 1\n        fourth_power = current_odd_num ** 4\n        total_sum += fourth_power\n    return total_sum"}
{"task_id": "Mbpp/777", "solution": "from collections import Counter\n\ndef find_sum(elements: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of non-repeated elements in a given list.\n    A non-repeated element is defined as an element that appears exactly once in the input list.\n    \"\"\"\n    counts = Counter(elements)\n    total_sum = 0\n    for element, count in counts.items():\n        if count == 1:\n            total_sum += element\n    return total_sum"}
{"task_id": "Mbpp/775", "solution": "def odd_position(input_list: list) -> bool:\n    \"\"\"\n    Checks if every element at an odd 0-based index in the input_list is an odd number.\n    Returns True if all elements at odd indices are odd numbers, False otherwise.\n    \"\"\"\n    for i, num in enumerate(input_list):\n        if i % 2 != 0:  # If the index is odd\n            if num % 2 == 0:  # And the number at this odd index is even\n                return False  # Then the condition is not met\n    return True  # All odd-indexed numbers were odd"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list) -> list:\n    \"\"\"\n    Packs consecutive duplicates of a given list elements into sublists.\n    Each sublist contains consecutive identical elements from the input list.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = []\n    current_group = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] == current_group[0]:\n            current_group.append(input_list[i])\n        else:\n            result.append(current_group)\n            current_group = [input_list[i]]\n\n    # Append the last accumulated group\n    result.append(current_group)\n    return result"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(number: int) -> bool:\n    \"\"\"\n    Checks if the count of positive divisors for a given integer is even.\n    This function counts divisors up to the square root of the number.\n    \"\"\"\n    divisor_count = 0\n    # Iterate from 1 up to the square root of the number (inclusive).\n    limit = int(number**0.5)\n    for i in range(1, limit + 1):\n        if number % i == 0:\n            if i * i == number:\n                # If i is a perfect square root, it's one divisor\n                divisor_count += 1\n            else:\n                # Otherwise, i and number // i are two distinct divisors\n                divisor_count += 2\n    \n    return divisor_count % 2 == 0"}
{"task_id": "Mbpp/780", "solution": "from typing import List, Tuple\n\ndef find_combinations(input_list: List[Tuple[int, int]]) -> List[Tuple[int, int]]:\n    \"\"\"\n    Calculates all unique pairwise sums of tuples from the given input list.\n    The sums are performed on distinct pairs of tuples.\n    \"\"\"\n    unique_sums = set()\n    n = len(input_list)\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            t1 = input_list[i]\n            t2 = input_list[j]\n            sum_tuple = (t1[0] + t2[0], t1[1] + t2[1])\n            unique_sums.add(sum_tuple)\n\n    return list(unique_sums)"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(numbers: list) -> int:\n    \"\"\"Finds the product of the first even and first odd number in a given list.\n    Returns 0 if either an odd or an even number is not found.\n    \"\"\"\n    first_odd = None\n    first_even = None\n\n    for number in numbers:\n        if first_odd is None and number % 2 != 0:\n            first_odd = number\n        if first_even is None and number % 2 == 0:\n            first_even = number\n\n        if first_odd is not None and first_even is not None:\n            break\n\n    if first_odd is not None and first_even is not None:\n        return first_odd * first_even\n    else:\n        return 0"}
{"task_id": "Mbpp/786", "solution": "from typing import List, TypeVar\n\nComparable = TypeVar('Comparable', bound='Comparable') # Represents any comparable type\n\ndef right_insertion(sorted_list: List[Comparable], value: Comparable) -> int:\n    \"\"\"\n    Locates the right insertion point for a specified value in a sorted list.\n    Achieves O(log n) time complexity using binary search.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] <= value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(input_string: str) -> tuple:\n    \"\"\"\n    Converts a string representation of an integer tuple to an actual integer tuple.\n    Assumes valid input format, processing content within parentheses.\n    \"\"\"\n    # Extract the content inside the parentheses\n    content_str = input_string[1:-1].strip()\n\n    if not content_str:\n        return ()\n\n    # Split by comma and convert each part to an integer\n    # Each part is stripped of whitespace before conversion\n    int_elements = [int(part.strip()) for part in content_str.split(',')]\n\n    # Convert the list of integers to a tuple\n    return tuple(int_elements)"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int]) -> int:\n    \"\"\"Calculates the sum of all odd-length subarrays of the input list.\n\n    Args:\n        arr: A list of integers.\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):\n        for j in range(i, n):\n            sub_array_length = j - i + 1\n            if sub_array_length % 2 == 1:\n                for k in range(i, j + 1):\n                    total_sum += arr[k]\n    return total_sum"}
