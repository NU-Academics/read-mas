{"task_id": "Mbpp/103", "solution": "class EulerianNumber:\n    \"\"\"Represents an Eulerian number with its parameters and calculated value.\"\"\"\n    def __init__(self, n: int, m: int, value: int):\n        self.n = n\n        self.m = m\n        self.value = value\n\nclass EulerianNumberCalculator:\n    \"\"\"Encapsulates the mathematical logic for calculating the Eulerian number a(n, m).\"\"\"\n    def _factorial(self, k: int) -> int:\n        if k < 0:\n            return 0\n        if k == 0:\n            return 1\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    def _combinations(self, n_val: int, k_val: int) -> int:\n        \"\"\"Calculates n choose k.\"\"\"\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0 or k_val == n_val:\n            return 1\n        if k_val > n_val // 2:\n            k_val = n_val - k_val\n\n        numerator = 1\n        for i in range(k_val):\n            numerator *= (n_val - i)\n        \n        denominator = self._factorial(k_val)\n        return numerator // denominator\n\n    def calculate(self, n: int, m: int) -> EulerianNumber:\n        \"\"\"Calculates the Eulerian number a(n, m) based on its mathematical definition.\"\"\"\n        # Special case for A(0,0) = 1\n        if n == 0 and m == 0:\n            return EulerianNumber(n, m, 1)\n        \n        # Eulerian numbers A(n,m) are 0 if m is outside the range [0, n-1] for n > 0.\n        # Also 0 if n < 0.\n        if n < 0 or m < 0 or m > n - 1:\n            return EulerianNumber(n, m, 0)\n        \n        total_sum = 0\n        # Formula for Eulerian number A(n, m):\n        # A(n, m) = sum_{k=0}^{m} (-1)^k * C(n+1, k) * (m+1-k)^n\n        for k in range(m + 1):\n            term = ((-1)**k) * self._combinations(n + 1, k) * ((m + 1 - k)**n)\n            total_sum += term\n        \n        return EulerianNumber(n, m, total_sum)\n\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Finds the Eulerian number a(n, m).\n    assert eulerian_num(3, 1) == 4\n    \"\"\"\n    calculator = EulerianNumberCalculator()\n    eulerian_number_obj = calculator.calculate(n, m)\n    return eulerian_number_obj.value"}
