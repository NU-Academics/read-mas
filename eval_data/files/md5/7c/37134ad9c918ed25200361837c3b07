{"task_id": "Mbpp/140", "solution": "def extract_singly(nested_list: list) -> set:\n    \"\"\"\n    Flattens a list of lists/tuples into a single set of unique numbers.\n    Each inner iterable is processed, and its elements are added to a set to ensure uniqueness.\n    \"\"\"\n    unique_numbers_set = set()\n    for inner_iterable in nested_list:\n        for element in inner_iterable:\n            unique_numbers_set.add(element)\n    return unique_numbers_set"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(arr: tuple[int | float, ...]) -> int | float:\n    \"\"\"Calculates the maximum absolute difference between any two elements in the array.\n    Returns 0 for empty or single-element arrays.\"\"\"\n    if len(arr) < 2:\n        return 0\n\n    max_diff = 0\n    # Iterate through all unique pairs of elements to find the maximum absolute difference.\n    for i in range(len(arr)):\n        for j in range(i + 1, len(arr)):\n            current_diff = abs(arr[i] - arr[j])\n            if current_diff > max_diff:\n                max_diff = current_diff\n    return max_diff"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(primary_list: list, elements_to_remove: list) -> list:\n    \"\"\"\n    Removes all elements from primary_list that are present in elements_to_remove.\n    Returns a new list without modifying the input lists.\n    \"\"\"\n    elements_to_remove_set = set(elements_to_remove)\n    result_list = [element for element in primary_list if element not in elements_to_remove_set]\n    return result_list"}
{"task_id": "Mbpp/141", "solution": "def pancake_sort(input_list: list) -> list:\n    \"\"\"\n    Sorts the input_list using the pancake sort algorithm and returns a new sorted list.\n    The original input_list remains unmodified.\n    \"\"\"\n    arr = list(input_list) # Create a mutable copy of the input list\n\n    def _flip(sub_array_end_index):\n        \"\"\"Reverses the sub-array from index 0 up to sub_array_end_index (inclusive).\"\"\"\n        start = 0\n        end = sub_array_end_index\n        while start < end:\n            arr[start], arr[end] = arr[end], arr[start]\n            start += 1\n            end -= 1\n\n    n = len(arr)\n    # Iterate from the largest element down to the second smallest\n    for current_size in range(n, 1, -1):\n        # Find the index of the maximum element in the current unsorted part (arr[0...current_size-1])\n        max_idx = 0\n        for i in range(current_size):\n            if arr[i] > arr[max_idx]:\n                max_idx = i\n\n        # If the maximum element is not already at its correct sorted position\n        if max_idx != current_size - 1:\n            # 1. Flip to bring the maximum element to the front of the unsorted part\n            _flip(max_idx)\n            # 2. Flip to move the maximum element to its correct sorted position\n            _flip(current_size - 1)\n\n    return arr"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1: list, list2: list, list3: list) -> int:\n    \"\"\"\n    Counts the number of positions where elements are identical across three input lists.\n    \"\"\"\n    min_length = min(len(list1), len(list2), len(list3))\n    count = 0\n    for i in range(min_length):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum (n - 2*i) for i from 0 to n // 2,\n    including only terms that are strictly greater than zero.\n    \"\"\"\n    total_sum = 0\n    # The loop iterates from i=0 up to n // 2 (inclusive).\n    for i in range(n // 2 + 1):\n        term = n - 2 * i\n        # Only terms strictly greater than zero are added to the sum.\n        if term > 0:\n            total_sum += term\n    return total_sum"}
{"task_id": "Mbpp/160", "solution": "def gcd(a: int, b: int) -> int:\n    \"\"\"Computes the greatest common divisor of two integers.\"\"\"\n    while b:\n        a, b = b, a % b\n    return a\n\ndef extended_gcd(a: int, b: int) -> tuple[int, int, int]:\n    \"\"\"Computes gcd(a, b) and integers x, y such that ax + by = gcd(a, b).\"\"\"\n    if a == 0:\n        return b, 0, 1\n    gcd_val, x1, y1 = extended_gcd(b % a, a)\n    x = y1 - (b // a) * x1\n    y = x1\n    return gcd_val, x, y\n\ndef find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Finds integer solutions (x, y) for ax + by = n.\n    Returns a tuple (x, y) if a solution exists, otherwise None.\n    \"\"\"\n    if a == 0 and b == 0:\n        if n == 0:\n            return (0, 0)\n        else:\n            return None\n\n    if a == 0:\n        if n % b == 0:\n            return (0, n // b)\n        else:\n            return None\n\n    if b == 0:\n        if n % a == 0:\n            return (n // a, 0)\n        else:\n            return None\n\n    gcd_val, x0, y0 = extended_gcd(a, b)\n\n    if n % gcd_val != 0:\n        return None\n\n    k = n // gcd_val\n    x = x0 * k\n    y = y0 * k\n\n    return (x, y)"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(numbers: list[int]) -> int:\n    \"\"\"\n    Counts the number of unique pairs of integers in a list that XOR to an even number.\n    Iterates through all distinct pairs, calculates their XOR sum, and increments a counter if the sum is even.\n    \"\"\"\n    even_xor_count = 0\n    n = len(numbers)\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            num1 = numbers[i]\n            num2 = numbers[j]\n            xor_result = num1 ^ num2\n            if xor_result % 2 == 0:\n                even_xor_count += 1\n\n    return even_xor_count"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Handles n=0 by returning 1.\n    \"\"\"\n    if n == 0:\n        return 1\n    \n    # Decrement n to correctly handle cases where n is already a power of 2.\n    n -= 1\n    \n    # Set all bits to the right of the most significant bit.\n    n |= n >> 1\n    n |= n >> 2\n    n |= n >> 4\n    n |= n >> 8\n    n |= n >> 16\n    n |= n >> 32 # For 64-bit integers, though Python handles arbitrary precision\n    \n    # Add 1 to get the next power of 2.\n    return n + 1"}
{"task_id": "Mbpp/171", "solution": "def perimeter_pentagon(side_length: float) -> float:\n    \"\"\"\n    Calculates the perimeter of a regular pentagon given its side length.\n    Raises ValueError if side_length is not a positive numerical value.\n    \"\"\"\n    if not isinstance(side_length, (int, float)) or side_length <= 0:\n        raise ValueError(\"Side length must be a positive numerical value.\")\n    return 5 * side_length"}
{"task_id": "Mbpp/165", "solution": "def _is_alphabetic(char: str) -> bool:\n    \"\"\"Determines if a given character is an English alphabet letter.\"\"\"\n    return char.isalpha()\n\ndef _to_lower(char: str) -> str:\n    \"\"\"Converts a character to its lowercase equivalent.\"\"\"\n    return char.lower()\n\ndef _get_alphabetical_position(char: str) -> int:\n    \"\"\"Calculates the 0-indexed alphabetical position of a lowercase alphabetic character.\"\"\"\n    return ord(char) - ord('a')\n\ndef count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in a string that occur at the same 0-indexed position\n    as in the English alphabet (case-insensitive).\n    \"\"\"\n    count = 0\n    for string_index, char in enumerate(input_string):\n        if _is_alphabetic(char):\n            lower_char = _to_lower(char)\n            alpha_pos = _get_alphabetical_position(lower_char)\n            if string_index == alpha_pos:\n                count += 1\n    return count"}
