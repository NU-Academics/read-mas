{"task_id": "Mbpp/301", "solution": "def dict_depth(d: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of a dictionary.\n    Returns 1 for an empty dictionary or a dictionary with only non-dict values at the top level.\n    \"\"\"\n    if not isinstance(d, dict):\n        return 0\n\n    max_depth = 1  # An empty dictionary or a dict with only non-dict values at the top level has depth 1.\n    for value in d.values():\n        if isinstance(value, dict):\n            max_depth = max(max_depth, 1 + dict_depth(value))\n    return max_depth"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(data: list[tuple[str, int]]) -> tuple[str, int]:\n    \"\"\"\n    Calculates the maximum aggregate score from a list of (name, score) tuples.\n\n    Args:\n        data: A list of tuples, where each tuple is (name: str, score: int).\n\n    Returns:\n        A tuple (name: str, total_score: int) representing the name with the\n        maximum aggregate score and their total score. Returns (None, 0) if\n        the input list is empty.\n    \"\"\"\n    aggregated_scores = {}\n    for name, score in data:\n        aggregated_scores[name] = aggregated_scores.get(name, 0) + score\n\n    if not aggregated_scores:\n        return (None, 0)\n\n    max_name = None\n    max_score = 0\n    for name, score in aggregated_scores.items():\n        if score > max_score:\n            max_score = score\n            max_name = name\n            \n    return (max_name, max_score)"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(array: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from a prefix until index `i`,\n    including the element at index `k` where `k > i`.\n    \"\"\"\n    if not array or n <= 0 or i < 0 or i >= n or k < 0 or k >= n or k <= i:\n        raise ValueError(\"Invalid input parameters: array must be non-empty, and indices i, k must be valid with k > i.\")\n\n    kth_element_value = array[k]\n\n    # dp[j] stores the maximum sum of an increasing subsequence ending at array[j] for j <= i\n    dp = [0] * (i + 1)\n\n    for current_idx in range(i + 1):\n        dp[current_idx] = array[current_idx] # A single element is an increasing subsequence\n        for prev_idx in range(current_idx):\n            if array[current_idx] > array[prev_idx]:\n                dp[current_idx] = max(dp[current_idx], dp[prev_idx] + array[current_idx])\n\n    max_sum_before_k = 0\n    found_prefix_element = False\n\n    for idx in range(i + 1):\n        if array[idx] < kth_element_value:\n            max_sum_before_k = max(max_sum_before_k, dp[idx])\n            found_prefix_element = True\n\n    if not found_prefix_element:\n        # If no element in array[0...i] can precede array[k], the sum is just array[k]\n        return kth_element_value\n    else:\n        return max_sum_before_k + kth_element_value"}
{"task_id": "Mbpp/305", "solution": "def start_withp(input_list: list[str]) -> tuple[str, str]:\n    \"\"\"Returns the first two words from a list of strings that start with 'p' (case-insensitive).\"\"\"\n    found_words = []\n    for input_string in input_list:\n        words = input_string.split()\n        for word in words:\n            if len(found_words) < 2:\n                if word.lower().startswith('p'):\n                    found_words.append(word)\n            else:\n                break # Two words found, stop processing\n        if len(found_words) == 2:\n            break # Two words found, stop processing outer list\n\n    return tuple(found_words)"}
