{"task_id": "Mbpp/113", "solution": "def check_integer(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string represents a valid integer, handling optional signs and whitespace.\n    A valid integer consists solely of digits, optionally preceded by a single '+' or '-' sign.\n    \"\"\"\n    s = input_string.strip()\n\n    if not s:\n        return False\n\n    if s[0] in ('+', '-'):\n        s = s[1:]\n\n    if not s:  # Handles cases like \"+\", \"-\" after stripping sign\n        return False\n\n    return s.isdigit()"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(list_of_lists: list[list]) -> set:\n    \"\"\"\n    Identifies and returns all unique elements that are common across every list\n    within the input list of lists.\n    \"\"\"\n    if not list_of_lists:\n        return set()\n\n    # Convert the first list to a set to start the intersection\n    common_elements = set(list_of_lists[0])\n\n    # Iterate through the rest of the lists and find the intersection\n    for sublist in list_of_lists[1:]:\n        common_elements.intersection_update(set(sublist))\n\n    return common_elements"}
{"task_id": "Mbpp/119", "solution": "def search(arr: list) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array.\n    Uses binary search to efficiently locate the unique element.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n\n    while low <= high:\n        mid = (low + high) // 2\n\n        # Ensure mid is even for consistent pair checking\n        if mid % 2 == 1:\n            mid -= 1\n\n        # Check if the pair at (mid, mid+1) is the same\n        # If mid is the last element or the pair is different, the unique element is at or to its left\n        if mid + 1 >= len(arr) or arr[mid] != arr[mid + 1]:\n            high = mid - 1\n        else:\n            # The unique element is to the right of this pair\n            low = mid + 2\n\n    return arr[low]"}
{"task_id": "Mbpp/120", "solution": "import math\nfrom typing import List, Tuple, Union\n\ndef max_product_tuple(data_list: List[Tuple[Union[int, float], Union[int, float]]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the maximum absolute product between numbers in pairs of tuples within a given list.\n    Returns 0.0 if the input list is empty.\n    \"\"\"\n    max_abs_product = 0.0\n\n    if not isinstance(data_list, list):\n        raise TypeError(\"Input 'data_list' must be a list.\")\n\n    for item in data_list:\n        if not isinstance(item, tuple):\n            raise TypeError(\"Elements in 'data_list' must be tuples.\")\n        if len(item) != 2:\n            raise ValueError(\"Each tuple in 'data_list' must contain exactly two elements.\")\n        \n        num1, num2 = item\n        if not (isinstance(num1, (int, float)) and isinstance(num2, (int, float))):\n            raise ValueError(\"Tuple elements must be numbers (int or float).\")\n\n        current_product = num1 * num2\n        max_abs_product = max(max_abs_product, abs(current_product))\n\n    return max_abs_product"}
{"task_id": "Mbpp/116", "solution": "def tuple_to_int(input_tuple: tuple) -> int:\n    \"\"\"\n    Converts a tuple of positive integers into a single integer.\n    It concatenates their string representations to form the final integer.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    string_elements = []\n    for element in input_tuple:\n        if not isinstance(element, int) or element < 0:\n            raise ValueError(\"All elements in the tuple must be positive integers.\")\n        string_elements.append(str(element))\n\n    if not string_elements:\n        return 0 # Handle empty tuple case as 0 or could be defined differently by requirements. Assuming 0 for an empty string.\n\n    concatenated_string = \"\".join(string_elements)\n    return int(concatenated_string)"}
