{"task_id": "Mbpp/440", "solution": "import string\n\ndef find_adverb_position(sentence: str) -> tuple[int, int, str] | None:\n    \"\"\"\n    Finds the first adverb and its 0-indexed start and end character positions in a given sentence.\n    Returns None if no adverb is found.\n    \"\"\"\n    \n    # Predefined list of common adverbs for basic detection,\n    # and a suffix rule for words ending in 'ly'.\n    _COMMON_ADVERBS = {\n        \"again\", \"almost\", \"always\", \"away\", \"back\", \"badly\", \"carefully\", \"clearly\", \"early\", \"easily\", \n        \"enough\", \"ever\", \"fast\", \"finally\", \"gently\", \"hard\", \"hardly\", \"here\", \"just\", \"late\", \n        \"lately\", \"loudly\", \"much\", \"never\", \"next\", \"now\", \"often\", \"only\", \"out\", \"outside\", \n        \"quickly\", \"quietly\", \"rarely\", \"really\", \"right\", \"seldom\", \"slowly\", \"sometimes\", \"soon\", \n        \"still\", \"straight\", \"then\", \"there\", \"today\", \"tomorrow\", \"tonight\", \"too\", \"under\", \"up\", \n        \"usually\", \"very\", \"well\", \"yesterday\", \"yet\"\n    }\n\n    def _is_adverb(word: str) -> bool:\n        \"\"\"Checks if a given word (case-insensitively) is an adverb.\"\"\"\n        lower_word = word.lower()\n        if lower_word in _COMMON_ADVERBS:\n            return True\n        if len(lower_word) > 2 and lower_word.endswith(\"ly\"):\n            # Simple heuristic for -ly adverbs\n            # Exclude words that are not typically adverbs but end in -ly (e.g., 'apply', 'reply', 'family')\n            # This is a very basic check and not exhaustive.\n            if lower_word not in {\"apply\", \"reply\", \"family\", \"jolly\", \"holy\", \"only\"}:\n                return True\n        return False\n\n    def _strip_punctuation(word: str) -> tuple[str, int]:\n        \"\"\"Removes trailing punctuation from a word and returns the cleaned word and count of removed characters.\"\"\"\n        stripped_count = 0\n        while word and word[-1] in string.punctuation:\n            word = word[:-1]\n            stripped_count += 1\n        return word, stripped_count\n\n    current_position = 0\n    words = sentence.split()\n\n    for word_token in words:\n        clean_word, stripped_chars_count = _strip_punctuation(word_token)\n        \n        if _is_adverb(clean_word):\n            # Calculate start position based on current_position and token's start\n            start_pos = current_position + word_token.find(clean_word) # Handles leading punctuation or spaces if word_token had them, though sentence.split() usually separates on spaces.\n            end_pos = start_pos + len(clean_word) - 1 # 0-indexed end position\n\n            return (start_pos, end_pos, clean_word)\n        \n        # Update current_position for the next word. Add 1 for the space character.\n        current_position += len(word_token) + 1 \n    \n    return None"}
