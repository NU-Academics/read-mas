{"task_id": "Mbpp/462", "solution": "def combinations_list(input_list: list) -> list[list]:\n    \"\"\"\n    Computes all possible unique combinations of elements from the input_list,\n    including the empty combination.\n    \"\"\"\n    all_combinations = [[]]\n    for item in input_list:\n        # Create new combinations by adding the current item to all existing combinations.\n        newly_formed_combinations = []\n        for combo in all_combinations:\n            newly_formed_combinations.append([item] + combo)\n        all_combinations.extend(newly_formed_combinations)\n    return all_combinations"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(nums: list[int]) -> int:\n    \"\"\"\n    Finds the maximum product of a contiguous subarray within the given array.\n    Handles positive, negative, and zero values efficiently.\n    \"\"\"\n    if not nums:\n        return 0\n\n    max_so_far = nums[0]\n    min_so_far = nums[0]\n    result = nums[0]\n\n    for i in range(1, len(nums)):\n        curr = nums[i]\n        \n        # If current number is negative, swap max_so_far and min_so_far\n        # because a negative number times min_so_far could become the new max_so_far.\n        if curr < 0:\n            max_so_far, min_so_far = min_so_far, max_so_far\n        \n        # Update max_so_far and min_so_far for the current number\n        max_so_far = max(curr, max_so_far * curr)\n        min_so_far = min(curr, min_so_far * curr)\n        \n        # Update the overall maximum product found so far\n        result = max(result, max_so_far)\n        \n    return result"}
