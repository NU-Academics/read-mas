{"task_id": "Mbpp/286", "solution": "def max_sub_array_sum_repeated(array: list[int], length: int, k: int) -> int:\n    \"\"\"\n    Calculates the largest sum of a contiguous subarray in an array conceptually repeated k times.\n    This function handles cases where k is 1, or greater than 1, considering total array sum for optimization.\n    \"\"\"\n\n    def _kadane(arr: list[int]) -> int:\n        \"\"\"Applies Kadane's algorithm to find the maximum subarray sum in a single array.\"\"\"\n        if not arr:\n            return 0  # Handles empty array case.\n        \n        max_so_far = arr[0]\n        current_max = arr[0]\n        for i in range(1, len(arr)):\n            current_max = max(arr[i], current_max + arr[i])\n            max_so_far = max(max_so_far, current_max)\n        return max_so_far\n\n    # If k is 1, the problem reduces to finding the maximum subarray sum in the original array.\n    if k == 1:\n        return _kadane(array)\n\n    # For k > 1, we consider several scenarios for the maximum sum.\n\n    # 1. Max sum found entirely within a single instance of the array.\n    max_sum_single = _kadane(array)\n\n    # 2. Max sum found within two concatenated instances of the array.\n    # This covers subarrays that span the boundary between the first and second original array blocks.\n    max_sum_double = _kadane(array + array)\n\n    # Calculate the total sum of the original array.\n    total_sum = sum(array)\n\n    # If the total sum of the array is positive, an optimal subarray might include\n    # full blocks of the original array in the middle, benefiting from a positive `total_sum`.\n    if total_sum > 0:\n        # Calculate the maximum prefix sum: largest sum starting from the beginning of `array`.\n        current_prefix_sum = 0\n        max_prefix_sum = float('-inf')\n        for x in array:\n            current_prefix_sum += x\n            max_prefix_sum = max(max_prefix_sum, current_prefix_sum)\n        \n        # Calculate the maximum suffix sum: largest sum ending at the end of `array`.\n        current_suffix_sum = 0\n        max_suffix_sum = float('-inf')\n        for x in reversed(array):\n            current_suffix_sum += x\n            max_suffix_sum = max(max_suffix_sum, current_suffix_sum)\n        \n        # Max sum that spans multiple blocks (a suffix, k-2 full arrays, a prefix).\n        # This considers subarrays that extend beyond two full repetitions.\n        # If k=2, (k-2)*total_sum is 0, so it's max_suffix_sum + max_prefix_sum.\n        max_sum_spanning_multiple = max_suffix_sum + (k - 2) * total_sum + max_prefix_sum\n\n        return max(max_sum_single, max_sum_double, max_sum_spanning_multiple)\n    else:\n        # If total_sum is non-positive, repeating the array more than twice will not\n        # yield a greater sum than what can be found within the first two repetitions.\n        # Adding more full blocks would only add non-positive values.\n        return max(max_sum_single, max_sum_double)"}
{"task_id": "Mbpp/296", "solution": "from typing import List, Union\n\ndef get_Inv_Count(inputArray: List[Union[int, float]]) -> int:\n    \"\"\"\n    Counts the total number of inversions in the input array.\n\n    An inversion is a pair of indices (i, j) such that i < j\n    and inputArray[i] > inputArray[j].\n    \"\"\"\n    inversion_count = 0\n    n = len(inputArray)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if inputArray[i] > inputArray[j]:\n                inversion_count += 1\n    return inversion_count"}
{"task_id": "Mbpp/300", "solution": "import math\n\ndef count_binary_seq(n: int) -> float:\n    \"\"\"\n    Calculates the count of all binary sequences of length 2n such that the sum of the first n bits\n    is the same as the sum of the last n bits.\n    \"\"\"\n\n    def _binomial_coefficient(N: int, K: int) -> int:\n        \"\"\"\n        Calculates the binomial coefficient C(N, K).\n        \"\"\"\n        if K < 0 or K > N:\n            return 0\n        if K == 0 or K == N:\n            return 1\n        if K > N // 2:\n            K = N - K\n\n        res = 1\n        for i in range(K):\n            res = res * (N - i) // (i + 1)\n        return res\n\n    total_count = 0\n    # Iterate through all possible sums (k) for the first n bits (and thus the last n bits).\n    # The sum k can range from 0 (all zeros) to n (all ones).\n    for k in range(n + 1):\n        # The number of ways to have k ones in n bits is C(n, k).\n        # Since the first n bits must have sum k AND the last n bits must have sum k,\n        # the total ways for a fixed k is C(n, k) * C(n, k).\n        combinations_for_k = _binomial_coefficient(n, k)\n        total_count += combinations_for_k * combinations_for_k\n\n    return float(total_count)"}
