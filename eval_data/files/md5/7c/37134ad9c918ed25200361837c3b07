{"task_id": "Mbpp/409", "solution": "import math\n\nclass TuplePair:\n    \"\"\"\n    Represents a pair of numerical elements and provides a method to calculate their product.\n    Satisfies BR1 (implicitly, as it expects numerical elements) and BR2.\n    \"\"\"\n    def __init__(self, el1: float, el2: float):\n        if not isinstance(el1, (int, float)) or not isinstance(el2, (int, float)):\n            raise ValueError(\"Tuple elements must be numerical (int or float).\")\n        self.element1 = float(el1)\n        self.element2 = float(el2)\n\n    def get_product(self) -> float:\n        \"\"\"\n        Computes and returns the product of element1 and element2.\n        \"\"\"\n        return self.element1 * self.element2\n\ndef min_product_tuple(data: list[tuple[float, float]]) -> float:\n    \"\"\"\n    Finds the minimum product from a list of two-element numerical tuples.\n    Returns the minimum product found among all tuple pairs.\n    \"\"\"\n    if not isinstance(data, list):\n        raise ValueError(\"Input 'data' must be a list.\")\n\n    if not data:\n        return float('inf')\n\n    min_product = float('inf')\n\n    for item in data:\n        if not isinstance(item, tuple):\n            raise ValueError(f\"List item '{item}' is not a tuple.\")\n        if len(item) != 2:\n            raise ValueError(f\"Tuple '{item}' must contain exactly two elements.\")\n\n        try:\n            tuple_pair = TuplePair(item[0], item[1])\n            product = tuple_pair.get_product()\n            if product < min_product:\n                min_product = product\n        except ValueError as e:\n            raise ValueError(f\"Invalid elements in tuple '{item}': {e}\") from e\n\n    return min_product"}
{"task_id": "Mbpp/412", "solution": "def _is_even(number: int) -> bool:\n    \"\"\"Checks if a given number is even.\"\"\"\n    return number % 2 == 0\n\ndef remove_odd(input_list: list) -> list:\n    \"\"\"\n    Filters an input list to return a new list containing only even numbers.\n    The original input list remains unchanged.\n    \"\"\"\n    even_numbers = []\n    for number in input_list:\n        if _is_even(number):\n            even_numbers.append(number)\n    return even_numbers"}
