{"task_id": "Mbpp/240", "solution": "from typing import Any, List\n\ndef replace_list(list1: List[Any], list2: List[Any]) -> List[Any]:\n    \"\"\"\n    Replaces the last element of the first list with the elements of the second list.\n\n    Args:\n        list1: The first list, whose last element will be replaced.\n        list2: The second list, whose elements will replace the last element of list1.\n\n    Returns:\n        A new list with the modified elements. The original input lists are not modified.\n\n    Raises:\n        TypeError: If list1 or list2 are not lists.\n    \"\"\"\n    if not isinstance(list1, list) or not isinstance(list2, list):\n        raise TypeError(\"Both inputs must be lists.\")\n\n    if not list1:\n        return list2[:]\n\n    new_list = list1[:-1]\n    new_list.extend(list2)\n\n    return new_list"}
{"task_id": "Mbpp/237", "solution": "def _normalize_tuple(input_tuple: tuple) -> tuple:\n    \"\"\"Converts an input tuple into its canonical (sorted) form.\"\"\"\n    return tuple(sorted(input_tuple))\n\ndef check_occurences(input_list: list[tuple]) -> dict[tuple, int]:\n    \"\"\"\n    Counts the occurrences of unique canonical tuples in a list.\n    Each tuple is normalized by sorting its elements before counting.\n    \"\"\"\n    occurrences_map = {}\n    for item_tuple in input_list:\n        canonical_tuple = _normalize_tuple(item_tuple)\n        occurrences_map[canonical_tuple] = occurrences_map.get(canonical_tuple, 0) + 1\n    return occurrences_map"}
{"task_id": "Mbpp/239", "solution": "def _count_sequences_recursive(current_length: int, last_val: int, m: int, n: int) -> int:\n    \"\"\"\n    Helper function to recursively count valid sequences.\n    It counts valid sequences that can be formed from the current state.\n    \"\"\"\n    if current_length == n:\n        return 1\n\n    count = 0\n    start_next_val = last_val * 2\n\n    for next_val in range(start_next_val, m + 1):\n        count += _count_sequences_recursive(current_length + 1, next_val, m, n)\n\n    return count\n\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the total number of possible sequences of length n,\n    such that each element is a positive integer and is greater than or equal to\n    twice the previous element but less than or equal to m.\n    \"\"\"\n    if n == 1:\n        return m\n\n    total_sequences = 0\n    for first_val in range(1, m + 1):\n        total_sequences += _count_sequences_recursive(1, first_val, m, n)\n\n    return total_sequences"}
