{"task_id": "Mbpp/61", "solution": "def _calculate_sum_of_digits(substring_value: str) -> int:\n    \"\"\"Calculates the sum of digits in a given string.\"\"\"\n    total_sum = 0\n    for char_digit in substring_value:\n        total_sum += int(char_digit)\n    return total_sum\n\ndef count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts the number of substrings in 's' where the sum of their digits equals their length.\n    \"\"\"\n    valid_substring_count = 0\n    n = len(s)\n\n    for i in range(n):\n        for j in range(i, n):\n            substring = s[i : j + 1]\n            substring_length = len(substring)\n            sum_of_digits = _calculate_sum_of_digits(substring)\n\n            if sum_of_digits == substring_length:\n                valid_substring_count += 1\n    \n    return valid_substring_count"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list, sublist):\n    \"\"\"\n    Checks if a given sublist exists contiguously within a main list.\n    Returns True if found, False otherwise.\n    \"\"\"\n    n = len(main_list)\n    m = len(sublist)\n\n    if m == 0:\n        return True  # An empty list is considered a sublist of any list\n\n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        if main_list[i : i + m] == sublist:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(input_list: list) -> (int | float):\n    \"\"\"\n    Flattens a list and sums all its numerical elements recursively.\n    Non-numerical elements that are not lists are ignored.\n    \"\"\"\n    total_sum = 0\n    for element in input_list:\n        if isinstance(element, list):\n            total_sum += recursive_list_sum(element)\n        elif isinstance(element, (int, float)):\n            total_sum += element\n    return total_sum"}
{"task_id": "Mbpp/63", "solution": "from typing import List, Tuple, Union\n\ndef max_difference(tuple_list: List[Tuple[Union[float, int], Union[float, int]]]) -> Union[float, int]:\n    \"\"\"\n    Calculates the maximum absolute difference between elements within pairs\n    in the given list of tuples. Returns 0 if the input list is empty.\n    \"\"\"\n    if not tuple_list:\n        return 0\n\n    max_diff = 0.0\n\n    for pair in tuple_list:\n        element1, element2 = pair\n        current_diff = abs(element1 - element2)\n        if current_diff > max_diff:\n            max_diff = current_diff\n\n    return max_diff"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array: list) -> bool:\n    \"\"\"\n    Determines if the input array is monotonic.\n    An array is monotonic if it is either monotonically increasing or decreasing.\n    \"\"\"\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(len(array) - 1):\n        if array[i] > array[i+1]:\n            is_increasing = False\n        if array[i] < array[i+1]:\n            is_decreasing = False\n\n    return is_increasing or is_decreasing"}
