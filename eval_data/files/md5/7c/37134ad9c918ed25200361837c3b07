{"task_id": "Mbpp/448", "solution": "_perrin_memo = {}\n\ndef _get_perrin_number(k: int) -> int:\n    \"\"\"Calculates the k-th Perrin number using memoization.\"\"\"\n    if k in _perrin_memo:\n        return _perrin_memo[k]\n\n    if k == 0:\n        result = 3\n    elif k == 1:\n        result = 0\n    elif k == 2:\n        result = 2\n    else:\n        result = _get_perrin_number(k - 2) + _get_perrin_number(k - 3)\n\n    _perrin_memo[k] = result\n    return result\n\ndef cal_sum(n: int) -> int:\n    \"\"\"Calculates the sum of Perrin numbers from P(0) up to P(n).\"\"\"\n    total_sum = 0\n    for i in range(n + 1):\n        total_sum += _get_perrin_number(i)\n    return total_sum"}
