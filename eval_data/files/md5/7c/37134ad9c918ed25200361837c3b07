{"task_id": "Mbpp/635", "solution": "def heap_sort(data_list: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of integers in ascending order using the heap sort algorithm.\n    Returns a new list with the sorted elements.\n    \"\"\"\n    arr = list(data_list)\n    n = len(arr)\n\n    def _heapify(arr_internal: list[int], n_internal: int, i_internal: int) -> None:\n        \"\"\"Helper to maintain the max-heap property for a subtree rooted at index i_internal.\"\"\"\n        largest = i_internal\n        left = 2 * i_internal + 1\n        right = 2 * i_internal + 2\n\n        if left < n_internal and arr_internal[left] > arr_internal[largest]:\n            largest = left\n\n        if right < n_internal and arr_internal[right] > arr_internal[largest]:\n            largest = right\n\n        if largest != i_internal:\n            arr_internal[i_internal], arr_internal[largest] = arr_internal[largest], arr_internal[i_internal]\n            _heapify(arr_internal, n_internal, largest)\n\n    # Build a max-heap\n    # The last non-leaf node is at index n // 2 - 1\n    for i in range(n // 2 - 1, -1, -1):\n        _heapify(arr, n, i)\n\n    # Extract elements one by one from the heap\n    for i in range(n - 1, 0, -1):\n        arr[i], arr[0] = arr[0], arr[i]  # Swap root (max element) with current last element\n        _heapify(arr, i, 0) # Heapify the reduced heap (size i)\n\n    return arr"}
{"task_id": "Mbpp/641", "solution": "def is_nonagonal(n: int) -> int:\n    \"\"\"Calculates the nth nonagonal number.\n\n    Raises ValueError if n is not a positive integer.\n    \"\"\"\n    if n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n    return n * (7 * n - 5) // 2"}
