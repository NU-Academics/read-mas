{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(string1: str, string2: str) -> str:\n    \"\"\"\n    Removes characters from string1 that are present in string2.\n\n    Args:\n        string1: The primary string from which characters will be removed.\n        string2: The string containing characters to be removed (dirty characters).\n\n    Returns:\n        A new string with characters from string1 that are not in string2,\n        maintaining their original order.\n    \"\"\"\n    dirty_chars_set = set(string2)\n    result_chars = []\n    for char in string1:\n        if char not in dirty_chars_set:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is a Woodall number.\n    A Woodall number is defined by the formula Wn = n * 2^n - 1 for some non-negative integer n.\n    \"\"\"\n    if number < -1:\n        return False\n\n    n = 0\n    while True:\n        woodall_candidate = n * (2**n) - 1\n        if woodall_candidate == number:\n            return True\n        elif woodall_candidate > number:\n            # If the candidate exceeds the number, no larger n will match.\n            return False\n        n += 1"}
