{"task_id": "Mbpp/94", "solution": "def index_minimum(data: list[tuple]) -> any:\n    \"\"\"\n    Given a list of tuples, returns the first value of the tuple with the smallest second value.\n    Handles an empty list by returning None.\n    \"\"\"\n    if not data:\n        return None\n\n    min_tuple = data[0]\n    for current_tuple in data[1:]:\n        if current_tuple[1] < min_tuple[1]:\n            min_tuple = current_tuple\n    return min_tuple[0]"}
{"task_id": "Mbpp/98", "solution": "import math\n\ndef multiply_num(numbers):\n    \"\"\"\n    Computes the product of all numbers in a list and divides it by the list's length.\n    Raises ValueError if the input list is empty.\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"Input list cannot be empty\")\n\n    product = 1\n    for num in numbers:\n        product *= num\n    \n    length = len(numbers)\n    result = product / length\n    \n    return float(result)"}
{"task_id": "Mbpp/96", "solution": "import math\n\ndef divisor(input_integer: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer.\n    Considers the absolute value of the input and returns 0 for input 0.\n    \"\"\"\n    if input_integer == 0:\n        return 0\n\n    n = abs(input_integer)\n    count = 0\n    # Iterate up to the square root of n to find divisors efficiently.\n    limit = int(math.sqrt(n))\n\n    for i in range(1, limit + 1):\n        if n % i == 0:\n            if i * i == n:\n                count += 1  # If i is the square root, it's counted once\n            else:\n                count += 2  # i and n/i are distinct divisors, count both\n    return count"}
{"task_id": "Mbpp/101", "solution": "```python\ndef kth_element(arr: list, k: int) -> any:\n    \"\"\"Finds the kth element in the given array using 1-based indexing.\n\n    Raises:\n        IndexError: If k is out of bounds (k < 1 or k > len(arr)).\n    \"\"\"\n    if k < 1 or k > len(arr):\n        raise IndexError(\"k is out of bounds.\")\n    return arr[k - 1]\n```"}
{"task_id": "Mbpp/100", "solution": "def _is_palindrome(number: int) -> bool:\n    \"\"\"Checks if a given integer is a palindrome.\"\"\"\n    s = str(number)\n    return s == s[::-1]\n\ndef next_smallest_palindrome(input_integer: int) -> int:\n    \"\"\"\n    Determines the next smallest palindrome strictly greater than the input integer.\n    It increments the input integer and checks for the palindrome property until found.\n    \"\"\"\n    current_number = input_integer + 1\n    while True:\n        if _is_palindrome(current_number):\n            return current_number\n        current_number += 1"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"\n    Converts a non-negative decimal integer to its binary string representation.\n    The binary string will not have leading zeros, except for input 0 which returns '0'.\n    \"\"\"\n    if decimal_number == 0:\n        return '0'\n\n    binary_string = []\n    temp_number = decimal_number\n    while temp_number > 0:\n        binary_string.append(str(temp_number % 2))\n        temp_number //= 2\n\n    return ''.join(binary_string[::-1])"}
