{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"Checks if two numbers differ by exactly one bit in their binary representation.\"\"\"\n    xor_result = num1 ^ num2\n    # Count the number of set bits in the XOR result\n    # If exactly one bit is set, the numbers differ at one position.\n    return bin(xor_result).count('1') == 1"}
{"task_id": "Mbpp/8", "solution": "def square_nums(input_list: list) -> list:\n    \"\"\"\n    Calculates the square of each element in a list of numbers.\n\n    Args:\n        input_list: A list of numbers (integers or floats).\n\n    Returns:\n        A new list containing the square of each corresponding element\n        from the input_list, preserving the original order.\n    \"\"\"\n    squared_list = []\n    for number in input_list:\n        squared_list.append(number * number)\n    return squared_list"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(collection1: (list | tuple), collection2: (list | tuple)) -> set:\n    \"\"\"Finds the shared elements between two collections.\"\"\"\n    set1 = set(collection1)\n    set2 = set(collection2)\n    return set1.intersection(set2)"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, char_to_remove: str) -> str:\n    \"\"\"Removes the first and last occurrences of a given character from the string.\"\"\"\n    first_index = input_string.find(char_to_remove)\n    last_index = input_string.rfind(char_to_remove)\n\n    if first_index == -1:\n        # Character not found, return original string\n        return input_string\n    elif first_index == last_index:\n        # Character found exactly once\n        return input_string[:first_index] + input_string[first_index + 1:]\n    else:\n        # Character found multiple times, remove last then first\n        temp_string = input_string[:last_index] + input_string[last_index + 1:]\n        return temp_string[:first_index] + temp_string[first_index + 1:]"}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(number: int) -> bool:\n    \"\"\"\n    Determines if a given integer is a non-prime number.\n    Returns True if the number is non-prime, False if it is prime.\n    \"\"\"\n    if number <= 1:\n        return False\n\n    if number == 2:\n        return False\n\n    for i in range(2, int(number**0.5) + 1):\n        if number % i == 0:\n            return True\n\n    return False"}
{"task_id": "Mbpp/7", "solution": "import re\n\ndef find_char_long(input_string: str) -> set[str]:\n    \"\"\"\n    Identifies and returns a unique set of words that are at least 4 characters long\n    from the input string.\n    \"\"\"\n    words = re.findall(r'\\b\\w+\\b', input_string)\n    long_words = {word for word in words if len(word) >= 4}\n    return long_words"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(input_string: str) -> int:\n    \"\"\"\n    Calculates the minimum number of rotations (greater than 0) required\n    for a string to return to its original state.\n    A rotation moves the first character of the string to the end.\n    \"\"\"\n    n = len(input_string)\n    if n == 0:\n        return 0\n\n    original_string = input_string\n    current_string = input_string\n    rotation_count = 0\n\n    while True:\n        # Perform one rotation\n        current_string = current_string[1:] + current_string[0]\n        rotation_count += 1\n\n        # Check if we have returned to the original string\n        if current_string == original_string:\n            return rotation_count"}
{"task_id": "Mbpp/4", "solution": "import heapq\n\ndef heap_queue_largest(numbers: list[int], n: int) -> list[int]:\n    \"\"\"\n    Finds the n largest integers from a given list of numbers, returned in descending order.\n\n    Args:\n        numbers: A list of integers.\n        n: The number of largest integers to find.\n\n    Returns:\n        A list containing the n largest integers in descending order.\n    \"\"\"\n    if n <= 0:\n        return []\n\n    result = heapq.nlargest(n, numbers)\n\n    return result"}
{"task_id": "Mbpp/12", "solution": "def sort_matrix(matrix: list[list[int | float]]) -> list[list[int | float]]:\n    \"\"\"\n    Sorts a given matrix in ascending order according to the sum of its rows.\n    Returns a new list of lists representing the sorted matrix.\n    \"\"\"\n    rows_with_sums = [(sum(row), row) for row in matrix]\n    sorted_rows_with_sums = sorted(rows_with_sums, key=lambda x: x[0])\n    return [row for sum_val, row in sorted_rows_with_sums]"}
