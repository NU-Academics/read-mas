{"task_id": "Mbpp/803", "solution": "import math\n\ndef is_perfect_square(number: int) -> bool:\n    \"\"\"Checks if the given number is a perfect square.\n    A perfect square is a non-negative integer that is the square of an integer.\n    \"\"\"\n    if number < 0:\n        return False\n    root = math.isqrt(number)\n    return root * root == number"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers: list[int]) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    Returns True if at least one number in the list is even, False otherwise.\n    \"\"\"\n    for num in numbers:\n        if num % 2 == 0:\n            return True\n    return False"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Calculates the maximum consecutive run of uppercase characters within a string.\n    Iterates through the string, maintaining a current run count and updating a maximum run count.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in input_string:\n        if char.isupper():\n            current_run += 1\n        else:\n            current_run = 0\n        max_run = max(max_run, current_run)\n    return max_run"}
{"task_id": "Mbpp/807", "solution": "def first_odd(numbers: list[int]) -> int | None:\n    \"\"\"\n    Finds the first odd number in a list of integers.\n\n    Returns the first odd integer found in the list, or None if the list is empty\n    or contains no odd numbers.\n    \"\"\"\n    for number in numbers:\n        if number % 2 != 0:\n            return number\n    return None"}
{"task_id": "Mbpp/808", "solution": "def check_K(input_tuple: tuple, k: int) -> bool:\n    \"\"\"\n    Determines if an integer k is present in the given input_tuple.\n    Returns True if k is found in input_tuple, False otherwise.\n    \"\"\"\n    return k in input_tuple"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(tuple1: tuple, tuple2: tuple) -> bool:\n    \"\"\"\n    Checks if each element of tuple2 is strictly smaller than its corresponding element in tuple1.\n    Raises ValueError if tuple lengths differ.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n    for i in range(len(tuple1)):\n        if not (tuple2[i] < tuple1[i]):\n            return False\n    return True"}
{"task_id": "Mbpp/791", "solution": "def remove_nested(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Removes nested tuples from the given tuple, returning a new tuple with only non-tuple elements.\n    Preserves the order of the remaining elements.\n    \"\"\"\n    result_elements = []\n    for element in input_tuple:\n        if not isinstance(element, tuple):\n            result_elements.append(element)\n    return tuple(result_elements)"}
