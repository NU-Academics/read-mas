{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels in a string while maintaining non-vowel positions.\n    'y' is not considered a vowel.\n    \"\"\"\n    def _is_vowel(char: str) -> bool:\n        \"\"\"\n        Checks if a character is a vowel (case-insensitive, 'y' excluded).\n        \"\"\"\n        return char.lower() in {'a', 'e', 'i', 'o', 'u'}\n\n    char_list = list(s)\n    vowel_indices = []\n    vowels_found = []\n\n    for i, char in enumerate(char_list):\n        if _is_vowel(char):\n            vowel_indices.append(i)\n            vowels_found.append(char)\n\n    # Reverse the list of found vowels\n    vowels_found.reverse()\n\n    # Replace vowels in the original positions with the reversed vowels\n    for i, original_index in enumerate(vowel_indices):\n        char_list[original_index] = vowels_found[i]\n\n    return \"\".join(char_list)"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(input_list: list):\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    Returns the item with the highest frequency, or None if the list is empty.\n    \"\"\"\n    if not input_list:\n        return None\n\n    frequency_map = {}\n    for item in input_list:\n        frequency_map[item] = frequency_map.get(item, 0) + 1\n\n    max_item = None\n    max_freq = -1\n\n    # Iterate through the items and their counts to find the one with max frequency.\n    # The first item encountered that achieves the max frequency will be returned due to the '>' comparison.\n    for item, freq in frequency_map.items():\n        if freq > max_freq:\n            max_freq = freq\n            max_item = item\n\n    return max_item"}
{"task_id": "Mbpp/129", "solution": "from typing import List\n\nclass Matrix:\n    \"\"\"Represents a square matrix and provides methods for sum calculations.\"\"\"\n    def __init__(self, elements: List[List[int]]):\n        if not elements or not all(isinstance(row, list) for row in elements):\n            raise ValueError(\"Matrix elements must be a list of lists.\")\n\n        self._size = len(elements)\n        if not all(len(row) == self._size for row in elements):\n            raise ValueError(\"Matrix must be square.\")\n\n        self._elements = elements\n\n    def get_size(self) -> int:\n        \"\"\"Returns the size (dimension) of the square matrix.\"\"\"\n        return self._size\n\n    def get_element(self, row: int, col: int) -> int:\n        \"\"\"Returns the element at the specified row and column.\"\"\"\n        if not (0 <= row < self._size and 0 <= col < self._size):\n            raise IndexError(\"Row or column index out of bounds.\")\n        return self._elements[row][col]\n\n    def calculate_row_sum(self, row_index: int) -> int:\n        \"\"\"Calculates the sum of elements in a specific row.\"\"\"\n        if not (0 <= row_index < self._size):\n            raise IndexError(\"Row index out of bounds.\")\n        return sum(self._elements[row_index])\n\n    def calculate_column_sum(self, col_index: int) -> int:\n        \"\"\"Calculates the sum of elements in a specific column.\"\"\"\n        if not (0 <= col_index < self._size):\n            raise IndexError(\"Column index out of bounds.\")\n        return sum(self._elements[row][col_index] for row in range(self._size))\n\n    def calculate_main_diagonal_sum(self) -> int:\n        \"\"\"Calculates the sum of elements in the main diagonal.\"\"\"\n        return sum(self._elements[i][i] for i in range(self._size))\n\n    def calculate_anti_diagonal_sum(self) -> int:\n        \"\"\"Calculates the sum of elements in the anti-diagonal.\"\"\"\n        return sum(self._elements[i][self._size - 1 - i] for i in range(self._size))\n\nclass MagicSquareChecker:\n    \"\"\"Determines if a given matrix is a magic square.\"\"\"\n    def is_magic_square(self, matrix_elements: List[List[int]]) -> bool:\n        \"\"\"Checks if the input matrix is a magic square.\"\"\"\n        try:\n            matrix = Matrix(matrix_elements)\n        except ValueError:\n            return False\n\n        size = matrix.get_size()\n        if size == 0 or size == 1:\n            return True\n\n        # Calculate the expected sum from the first row\n        expected_sum = matrix.calculate_row_sum(0)\n\n        # Check all row sums\n        for i in range(size):\n            if matrix.calculate_row_sum(i) != expected_sum:\n                return False\n\n        # Check all column sums\n        for i in range(size):\n            if matrix.calculate_column_sum(i) != expected_sum:\n                return False\n\n        # Check main diagonal sum\n        if matrix.calculate_main_diagonal_sum() != expected_sum:\n            return False\n\n        # Check anti-diagonal sum\n        if matrix.calculate_anti_diagonal_sum() != expected_sum:\n            return False\n\n        return True\n\ndef magic_square_test(matrix_elements: List[List[int]]) -> bool:\n    \"\"\"Entry point function to determine if a matrix is a magic square.\"\"\"\n    checker = MagicSquareChecker()\n    return checker.is_magic_square(matrix_elements)"}
