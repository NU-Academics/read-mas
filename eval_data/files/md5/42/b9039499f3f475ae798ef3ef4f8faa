{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers.\"\"\"\n    if n % 2 != 0:  # Check if n is odd\n        return False\n\n    # The smallest sum of 4 positive even numbers is 2 + 2 + 2 + 2 = 8.\n    # Any even number n >= 8 can be written as 2 + 2 + 2 + (n-6), where n-6 is also a positive even number.\n    return n >= 8"}
{"task_id": "HumanEval/130", "solution": "```python\nfrom typing import List, Dict\n\ndef tri(n: int) -> List[int]:\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in\n    the last couple centuries. However, what people don't know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8\n    You are given a non-negative integer number n, you have to a return a list of the\n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    memo: Dict[int, int] = {}\n\n    def _get_tribonacci_value(k: int) -> int:\n        if k in memo:\n            return memo[k]\n\n        result: int\n        if k == 0:\n            result = 1\n        elif k == 1:\n            result = 3\n        elif k % 2 == 0:  # k is even\n            result = 1 + k // 2\n        else:  # k is odd\n            result = (\n                _get_tribonacci_value(k - 1)\n                + _get_tribonacci_value(k - 2)\n                + _get_tribonacci_value(k + 1)\n            )\n\n        memo[k] = result\n        return result\n\n    sequence: List[int] = []\n    for i in range(n + 1):\n        sequence.append(_get_tribonacci_value(i))\n\n    return sequence\n```"}
{"task_id": "HumanEval/140", "solution": "import re\n\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input 'text' must be a string.\")\n\n    # First, replace 3 or more consecutive spaces with a single hyphen.\n    # This must be done before the 1-2 space rule to avoid incorrect partial replacements.\n    text = re.sub(r' {3,}', '-', text)\n\n    # Then, replace sequences of 1 or 2 spaces with a single underscore.\n    text = re.sub(r' {1,2}', '_', text)\n\n    return text"}
{"task_id": "HumanEval/141", "solution": "```python\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions\n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from\n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n\n    ALLOWED_EXTENSIONS = ['txt', 'exe', 'dll']\n    MAX_DIGITS = 3\n\n    # Rule: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    prefix, suffix = file_name.split('.')\n\n    # Rule: The substring before the dot should not be empty, and it starts with a letter\n    if not prefix or not prefix[0].isalpha():\n        return 'No'\n\n    # Rule: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    if suffix not in ALLOWED_EXTENSIONS:\n        return 'No'\n\n    # Rule: There should not be more than three digits ('0'-'9') in the file's name.\n    digit_count = sum(1 for char in file_name if char.isdigit())\n    if digit_count > MAX_DIGITS:\n        return 'No'\n\n    return 'Yes'\n```"}
{"task_id": "HumanEval/142", "solution": "```python\ndef sum_squares(lst):\n    \"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += num * num\n        elif i % 4 == 0:  # This condition implies i % 3 != 0 due to the prior check.\n            total_sum += num * num * num\n        else:\n            total_sum += num\n    return total_sum\n```"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, keeping only those with prime lengths, and returns them as a space-separated string.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a given integer n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    words = sentence.split(' ')\n    prime_length_words = []\n    for word in words:\n        if is_prime(len(word)):\n            prime_length_words.append(word)\n    return ' '.join(prime_length_words)"}
{"task_id": "HumanEval/139", "solution": "```python\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n    \"\"\"\n    factorial_cache = {}\n\n    def _factorial(k):\n        \"\"\"Calculates the standard factorial of k, using memoization.\"\"\"\n        if k in factorial_cache:\n            return factorial_cache[k]\n\n        result = 1\n        for j in range(1, k + 1):\n            result *= j\n        factorial_cache[k] = result\n        return result\n\n    total_product = 1\n    for i in range(1, n + 1):\n        total_product *= _factorial(i)\n    return total_product\n```"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if a string of square brackets contains a valid subsequence of brackets\n    where at least one bracket is nested. A nested subsequence is of the form `[A]`\n    where `A` is a non-empty, valid bracket sequence.\n    \"\"\"\n    balance = 0\n    max_balance_for_segment = 0\n    found_nested = False\n\n    for char in string:\n        if char == '[':\n            balance += 1\n            max_balance_for_segment = max(max_balance_for_segment, balance)\n        elif char == ']':\n            if balance > 0:\n                balance -= 1\n                # If a segment became balanced (balance == 0) and it previously reached a depth of 2 or more,\n                # then a valid nested subsequence (like [[]]) has been found.\n                if balance == 0 and max_balance_for_segment >= 2:\n                    found_nested = True\n\n                # If the balance reaches 0, the current segment has closed.\n                # Reset max_balance_for_segment for any new segments.\n                if balance == 0:\n                    max_balance_for_segment = 0\n            else:\n                # Unmatched ']' starts a new potential segment or continues an invalid one.\n                # Reset max_balance_for_segment as this ']' broke any current valid segment's depth.\n                max_balance_for_segment = 0\n\n    return found_nested"}
{"task_id": "HumanEval/129", "solution": "```python\nclass Cell:\n    def __init__(self, row: int, col: int, value: int):\n        self._row = row\n        self._col = col\n        self._value = value\n\n    def get_row(self) -> int:\n        return self._row\n\n    def get_col(self) -> int:\n        return self._col\n\n    def get_value(self) -> int:\n        return self._value\n\n    def __eq__(self, other) -> bool:\n        if not isinstance(other, Cell):\n            return NotImplemented\n        return self._row == other._row and self._col == other._col and self._value == other._value\n\n    def __hash__(self) -> int:\n        return hash((self._row, self._col, self._value))\n\n\nclass Grid:\n    def __init__(self, data: list[list[int]]):\n        if not data or not isinstance(data, list) or not all(isinstance(row, list) for row in data):\n            raise ValueError(\"Grid data must be a list of lists.\")\n\n        N = len(data)\n        if N < 2:\n            raise ValueError(\"Grid dimension N must be >= 2.\")\n        if not all(len(row) == N for row in data):\n            raise ValueError(\"Grid must be square (N x N).\")\n\n        self._data = data\n        self._N = N\n\n    def get_value(self, row: int, col: int) -> int:\n        if not self.is_valid_coord(row, col):\n            raise IndexError(f\"Coordinates ({row}, {col}) are out of bounds for grid of size {self._N}.\")\n        return self._data[row][col]\n\n    def get_N(self) -> int:\n        return self._N\n\n    def is_valid_coord(self, row: int, col: int) -> bool:\n        return 0 <= row < self._N and 0 <= col < self._N\n\n\nclass Path:\n    def __init__(self, initial_cells: list['Cell'] = None):\n        self._cells = list(initial_cells) if initial_cells else []\n\n    def add_cell(self, cell: 'Cell') -> None:\n        self._cells.append(cell)\n\n    def get_length(self) -> int:\n        return len(self._cells)\n\n    def get_values(self) -> list[int]:\n        return [cell.get_value() for cell in self._cells]\n\n    def is_lexicographically_smaller(self, other_path_values: list[int]) -> bool:\n        self_values = self.get_values()\n\n        for i in range(len(self_values)):\n            if self_values[i] < other_path_values[i]:\n                return True\n            if self_values[i] > other_path_values[i]:\n                return False\n        return False\n\n    def get_last_cell(self) -> 'Cell':\n        if not self._cells:\n            raise IndexError(\"Path is empty.\")\n        return self._cells[-1]\n\n    def clone_and_add_cell(self, cell: 'Cell') -> 'Path':\n        new_path = Path(list(self._cells))\n        new_path.add_cell(cell)\n        return new_path\n\n\ndef get_neighbors(row: int, col: int, N: int) -> list[tuple[int, int]]:\n    neighbors = []\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    for dr, dc in directions:\n        new_row, new_col = row + dr, col + dc\n        if 0 <= new_row < N and 0 <= new_col < N:\n            neighbors.append((new_row, new_col))\n    return neighbors\n\n\nclass MinPathFinderService:\n    def find_min_path(self, grid_data: list[list[int]], k: int) -> list[int]:\n        if not isinstance(k, int) or k <= 0:\n            raise ValueError(\"Path length k must be a positive integer.\")\n\n        grid = Grid(grid_data)\n        N = grid.get_N()\n\n        min_path_values = [float('inf')] * k\n\n        for r in range(N):\n            for c in range(N):\n                start_cell = Cell(r, c, grid.get_value(r, c))\n                initial_path = Path([start_cell])\n\n                if k == 1:\n                    current_path_values = initial_path.get_values()\n                    if min_path_values[0] == float('inf') or current_path_values[0] < min_path_values[0]:\n                        min_path_values[:] = current_path_values\n                else:\n                    self._dfs(grid, start_cell, initial_path, k, min_path_values)\n\n        return min_path_values\n\n    def _dfs(self, grid: 'Grid', current_cell: 'Cell', current_path: 'Path', k: int, min_path_values: list[int]) -> None:\n        current_length = current_path.get_length()\n\n        if current_length == k:\n            current_path_values = current_path.get_values()\n            if min_path_values[0] == float('inf') or current_path.is_lexicographically_smaller(min_path_values):\n                min_path_values[:] = current_path_values\n            return\n\n        # Prune if the current partial path is already lexicographically greater than the best path found so far.\n        if min_path_values[0] != float('inf'):\n            current_prefix_values = current_path.get_values()\n            for i in range(current_length):\n                if current_prefix_values[i] > min_path_values[i]:\n                    return\n                if current_prefix_values[i] < min_path_values[i]:\n                    break\n\n        N = grid.get_N()\n        row, col = current_cell.get_row(), current_cell.get_col()\n        neighbors_coords = get_neighbors(row, col, N)\n\n        for nr, nc in neighbors_coords:\n            neighbor_value = grid.get_value(nr, nc)\n            neighbor_cell = Cell(nr, nc, neighbor_value)\n\n            new_path = current_path.clone_and_add_cell(neighbor_cell)\n            self._dfs(grid, neighbor_cell, new_path, k, min_path_values)\n\n\ndef minPath(grid: list[list[int]], k: int) -> list[int]:\n    service = MinPathFinderService()\n    return service.find_min_path(grid, k)\n```"}
{"task_id": "HumanEval/144", "solution": "```python\ndef simplify(x, n):\n    \"\"\"Checks if the product of two fractions (represented as strings) is a whole number.\n    The function returns True if x * n evaluates to a whole number and False otherwise.\"\"\"\n\n    # Parse the first fraction string x\n    x_parts = x.split('/')\n    x_numerator = int(x_parts[0])\n    x_denominator = int(x_parts[1])\n\n    # Parse the second fraction string n\n    n_parts = n.split('/')\n    n_numerator = int(n_parts[0])\n    n_denominator = int(n_parts[1])\n\n    # Multiply the fractions\n    product_numerator = x_numerator * n_numerator\n    product_denominator = x_denominator * n_denominator\n\n    # Check if the product is a whole number\n    return product_numerator % product_denominator == 0\n```"}
{"task_id": "HumanEval/145", "solution": "```python\nfrom dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass DigitSumItem:\n    \"\"\"A data transfer object to hold an integer's value, digit sum, and original index.\"\"\"\n    original_value: int\n    digit_sum: int\n    original_index: int\n\nclass DigitSumCalculator:\n    \"\"\"Provides a static utility method to calculate the sum of digits for a given integer.\"\"\"\n    @staticmethod\n    def calculate_sum(n: int) -> int:\n        \"\"\"Calculates the sum of the absolute value of the digits of an integer.\"\"\"\n        s = str(abs(n))\n        digit_sum = 0\n        for digit_char in s:\n            digit_sum += int(digit_char)\n        return digit_sum\n\nclass SorterService:\n    \"\"\"Orchestrates the custom sorting of a list of integers based on digit sum and original index.\"\"\"\n    def order_by_points(self, nums: List[int]) -> List[int]:\n        \"\"\"\n        Sorts the given list of integers in ascending order according to the sum of their digits.\n        If digit sums are equal, original index is used for tie-breaking.\n        \"\"\"\n        if not nums:\n            return []\n\n        items_to_sort: List[DigitSumItem] = []\n        for i, num in enumerate(nums):\n            digit_sum = DigitSumCalculator.calculate_sum(num)\n            items_to_sort.append(DigitSumItem(num, digit_sum, i))\n\n        items_to_sort.sort(key=lambda item: (item.digit_sum, item.original_index))\n\n        sorted_nums = [item.original_value for item in items_to_sort]\n\n        return sorted_nums\n\ndef order_by_points(nums):\n    \"\"\"\n    Write a function which sorts the given list of integers\n    in ascending order according to the sum of their digits.\n    Note: if there are several items with similar sum of their digits,\n    order them based on their index in original list.\n\n    For example:\n    >>> order_by_points([1, 11, -1, -11, -12]) == [-1, -11, 1, -12, 11]\n    >>> order_by_points([]) == []\n    \"\"\"\n    sorter = SorterService()\n    return sorter.order_by_points(nums)\n```"}
{"task_id": "HumanEval/146", "solution": "```python\ndef specialFilter(nums):\n    \"\"\"\n    Counts elements in an array that are greater than 10 and have both\n    first and last digits odd (1, 3, 5, 7, 9).\n    \"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            # Extract digits considering absolute value as per design context\n            abs_num_str = str(abs(num))\n\n            # Get the first digit\n            first_digit = int(abs_num_str[0])\n\n            # Get the last digit\n            last_digit = int(abs_num_str[-1])\n\n            # Check if both first and last digits are odd\n            if first_digit % 2 != 0 and last_digit % 2 != 0:\n                count += 1\n    return count\n```"}
{"task_id": "HumanEval/148", "solution": "```python\ndef bf(planet1, planet2):\n    \"\"\"\n    Returns a tuple containing planets between planet1 and planet2, sorted by proximity to the sun.\n    Returns an empty tuple if planet names are invalid or no planets are between them.\n    \"\"\"\n    PLANETS = [\n        \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n    ]\n\n    try:\n        idx1 = PLANETS.index(planet1)\n        idx2 = PLANETS.index(planet2)\n    except ValueError:\n        return ()\n\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    # If planets are adjacent or the same, there are no planets between them.\n    if end_idx - start_idx <= 1:\n        return ()\n\n    return tuple(PLANETS[start_idx + 1:end_idx])\n```"}
{"task_id": "HumanEval/149", "solution": "```python\ndef sorted_list_sum(lst):\n    \"\"\"Filters a list of strings to include only those with even lengths,\n    then sorts them by length ascending, and alphabetically ascending for ties.\n    \"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    sorted_strings = sorted(even_length_strings, key=lambda s: (len(s), s))\n    return sorted_strings\n```"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n\n    def _combinations(n_val: int, k_val: int) -> int:\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0 or k_val == n_val:\n            return 1\n        if k_val > n_val // 2:\n            k_val = n_val - k_val\n\n        res = 1\n        for i in range(k_val):\n            res = res * (n_val - i) // (i + 1)\n        return res\n\n    rem0_count = 0\n    rem1_count = 0\n\n    # Analyze a[x] = x*x - x + 1 modulo 3\n    # If x % 3 == 0, a[x] % 3 = (0^2 - 0 + 1) % 3 = 1\n    # If x % 3 == 1, a[x] % 3 = (1^2 - 1 + 1) % 3 = 1\n    # If x % 3 == 2, a[x] % 3 = (2^2 - 2 + 1) % 3 = (4 - 2 + 1) % 3 = 3 % 3 = 0\n    # So, a[x] % 3 == 0 when x % 3 == 2\n    # And a[x] % 3 == 1 when x % 3 == 0 or x % 3 == 1\n\n    for x in range(1, n + 1):\n        if x % 3 == 2:\n            rem0_count += 1\n        else:\n            rem1_count += 1\n\n    # For a sum a[i] + a[j] + a[k] to be a multiple of 3, all three elements\n    # must have the same remainder modulo 3 (0+0+0 = 0, or 1+1+1 = 3 = 0).\n    # Since there are no elements with remainder 2, we only consider remainders 0 and 1.\n    triples_from_rem0 = _combinations(rem0_count, 3)\n    triples_from_rem1 = _combinations(rem1_count, 3)\n\n    return triples_from_rem0 + triples_from_rem1"}
{"task_id": "HumanEval/151", "solution": "```python\ndef double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n\n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0\n\n    If the input list is empty, return 0.\n    '''\n    total_sum = 0\n    for num in lst:\n        # Check if the number is an integer, positive, and odd\n        if isinstance(num, int) and num > 0 and num % 2 != 0:\n            total_sum += num * num\n    return total_sum\n```"}
{"task_id": "HumanEval/150", "solution": "```python\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n    \"\"\"\n    import math\n\n    def _is_prime(num):\n        # Checks if num is a prime number efficiently.\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n\n        limit = int(math.sqrt(num))\n        for d in range(3, limit + 1, 2):\n            if num % d == 0:\n                return False\n        return True\n\n    if _is_prime(n):\n        return x\n    else:\n        return y\n```"}
{"task_id": "HumanEval/152", "solution": "```python\ndef compare(game,guess):\n    \"\"\"I think we all remember that feeling when the result of some long-awaited\n    event is finally known. The feelings and thoughts you have at that moment are\n    definitely worth noting down and comparing.\n    Your task is to determine if a person correctly guessed the results of a number of matches.\n    You are given two arrays of scores and guesses of equal length, where each index shows a match.\n    Return an array of the same length denoting how far off each guess was. If they have guessed correctly,\n    the value is 0, and if not, the value is the absolute difference between the guess and the score.\n\n\n    example:\n\n    compare([1,2,3,4,5,1],[1,2,3,4,2,-2]) -> [0,0,0,0,3,3]\n    compare([0,5,0,0,0,4],[4,1,1,0,0,-2]) -> [4,4,1,0,0,6]\n    \"\"\"\n    if len(game) != len(guess):\n        raise ValueError(\"Input arrays must be of equal length.\")\n\n    differences = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            differences.append(0)\n        else:\n            differences.append(abs(game[i] - guess[i]))\n    return differences\n```"}
{"task_id": "HumanEval/155", "solution": "```python\ndef even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Handle the number zero specifically, as it has one even digit.\n    if num == 0:\n        return (1, 0)\n\n    # Convert the absolute value of the number to a string to iterate through digits.\n    s_num = str(abs(num))\n    for digit_char in s_num:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)\n```"}
{"task_id": "HumanEval/156", "solution": "```python\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    roman_map = {\n        1000: \"M\", 900: \"CM\", 500: \"D\", 400: \"CD\",\n        100: \"C\", 90: \"XC\", 50: \"L\", 40: \"XL\",\n        10: \"X\", 9: \"IX\", 5: \"V\", 4: \"IV\", 1: \"I\"\n    }\n\n    roman_parts = []\n    temp_num = number\n\n    for value, symbol in roman_map.items():\n        while temp_num >= value:\n            roman_parts.append(symbol)\n            temp_num -= value\n\n    return \"\".join(roman_parts).lower()\n```"}
{"task_id": "HumanEval/153", "solution": "```python\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on CAP - SM strength and formats the output.\n    Handles ties by choosing the first encountered extension with the maximum strength.\"\"\"\n    if not extensions:\n        return class_name\n\n    strongest_ext_name = \"\"\n    max_strength = -float('inf') # Initialize with a very low strength to ensure any extension is stronger.\n\n    for ext_name in extensions:\n        cap_count = 0\n        sm_count = 0\n        for char in ext_name:\n            if char.isupper():\n                cap_count += 1\n            elif char.islower():\n                sm_count += 1\n\n        current_strength = cap_count - sm_count\n\n        # Update if current extension is strictly stronger (handles tie-breaking by taking the first).\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_ext_name = ext_name\n\n    return f\"{class_name}.{strongest_ext_name}\"\n```\n"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"Checks if the second word or any of its rotations is a substring in the first word.\"\"\"\n\n    # Handle the empty pattern string 'b'; an empty string is a substring of any string 'a'.\n    if not b:\n        return True\n\n    # If the pattern 'b' is longer than 'a', it cannot be a substring.\n    if len(b) > len(a):\n        return False\n\n    # Generate all unique cyclic rotations of string 'b'.\n    rotations = set()\n    n = len(b)\n    for i in range(n):\n        rotated_b = b[i:] + b[:i]\n        rotations.add(rotated_b)\n\n    # Check if any generated rotation is a substring of 'a'.\n    for rotation in rotations:\n        if rotation in a:\n            return True\n\n    return False"}
{"task_id": "HumanEval/157", "solution": "```python\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    import math\n\n    EPSILON = 1e-9 # Tolerance for floating-point comparisons\n\n    # Sort the sides to ensure s3 is the longest, simplifying the Pythagorean check.\n    sides = sorted([a, b, c])\n    s1, s2, s3 = sides[0], sides[1], sides[2]\n\n    # Check the Pythagorean theorem: a^2 + b^2 = c^2, using math.isclose for float precision.\n    return math.isclose(s1**2 + s2**2, s3**2, rel_tol=EPSILON)\n```"}
{"task_id": "HumanEval/158", "solution": "```python\ndef find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n    if not words:\n        return None\n\n    max_unique_count = -1\n    result_word = None\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Tie-breaker: lexicographical order\n            if result_word is None or word < result_word:\n                result_word = word\n    return result_word\n```"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten and the remaining stock after a rabbit's meal.\n    The rabbit eats the minimum of its need or the available remaining carrots.\n    \"\"\"\n    carrots_eaten_in_this_meal = min(need, remaining)\n    total_eaten = number + carrots_eaten_in_this_meal\n    remaining_stock = remaining - carrots_eaten_in_this_meal\n    return [total_eaten, remaining_stock]"}
{"task_id": "HumanEval/161", "solution": "```python\ndef solve(s):\n    \"\"\"Reverses the case of letters in a string, or reverses the entire string if no letters are present.\"\"\"\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    if not has_letters:\n        return s[::-1]\n    else:\n        result_chars = []\n        for char in s:\n            if char.isalpha():\n                if char.islower():\n                    result_chars.append(char.upper())\n                else:\n                    result_chars.append(char.lower())\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)\n```"}
{"task_id": "HumanEval/162", "solution": "import hashlib\n\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
{"task_id": "HumanEval/163", "solution": "```python\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    single_digit_evens = [2, 4, 6, 8]\n\n    result = []\n    for even_num in single_digit_evens:\n        if min_val <= even_num <= max_val:\n            result.append(even_num)\n    return sorted(result)\n```"}
{"task_id": "HumanEval/160", "solution": "```python\nclass InvalidExpressionError(Exception):\n    \"\"\"Custom exception for invalid algebraic expressions.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass AlgebraEvaluator:\n    VALID_OPERATORS = {'+', '-', '*', '//', '**'}\n\n    def evaluate_expression(self, operators: list[str], operands: list[int]) -> int:\n        self._validate_inputs(operators, operands)\n        expression_string = self._build_expression_string(operators, operands)\n        return self._safe_eval(expression_string)\n\n    def _validate_inputs(self, operators: list[str], operands: list[int]) -> None:\n        # Validates the input operators and operands lists.\n        if not isinstance(operators, list) or not all(isinstance(op, str) for op in operators):\n            raise InvalidExpressionError(\"Operators must be a list of strings.\")\n        if not isinstance(operands, list) or not all(isinstance(op, int) for op in operands):\n            raise InvalidExpressionError(\"Operands must be a list of integers.\")\n        if not all(op in self.VALID_OPERATORS for op in operators):\n            raise InvalidExpressionError(f\"Invalid operator found. Allowed: {', '.join(self.VALID_OPERATORS)}\")\n        if not all(op >= 0 for op in operands):\n            raise InvalidExpressionError(\"All operands must be non-negative integers.\")\n        if len(operators) != len(operands) - 1:\n            raise InvalidExpressionError(\"Length of operators must be length of operands minus one.\")\n        if len(operators) < 1:\n            raise InvalidExpressionError(\"Operator list must have at least one operator.\")\n        if len(operands) < 2:\n            raise InvalidExpressionError(\"Operand list must have at least two operands.\")\n\n    def _build_expression_string(self, operators: list[str], operands: list[int]) -> str:\n        # Constructs a single string representation of the algebraic expression.\n        expression_parts = []\n        for i in range(len(operators)):\n            expression_parts.append(str(operands[i]))\n            expression_parts.append(operators[i])\n        expression_parts.append(str(operands[-1]))\n        return \" \".join(expression_parts)\n\n    def _safe_eval(self, expression_string: str) -> int:\n        # Safely evaluates the given expression string with restricted globals.\n        try:\n            result = eval(expression_string, {'__builtins__': None}, {})\n            if not isinstance(result, int):\n                raise InvalidExpressionError(\"Expression did not evaluate to an integer.\")\n            return result\n        except (SyntaxError, TypeError, NameError, ZeroDivisionError, Exception) as e:\n            raise InvalidExpressionError(f\"Error evaluating expression '{expression_string}': {e}\") from e\n\ndef do_algebra(operator: list[str], operand: list[int]) -> int:\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and\n    the second list is a list of integers. Use the two given lists to build the algebric\n    expression and return the evaluation of this expression.\n\n    The basic algebra operations:\n    Addition ( + )\n    Subtraction ( - )\n    Multiplication ( * )\n    Floor division ( // )\n    Exponentiation ( ** )\n\n    Example:\n    operator['+', '*', '-']\n    array = [2, 3, 4, 5]\n    result = 2 + 3 * 4 - 5\n    => result = 9\n\n    Note:\n        The length of operator list is equal to the length of operand list minus one.\n        Operand is a list of of non-negative integers.\n        Operator list has at least one operator, and operand list has at least two operands.\n\n    \"\"\"\n    evaluator = AlgebraEvaluator()\n    return evaluator.evaluate_expression(operator, operand)\n```"}
