{"task_id": "HumanEval/88", "solution": "```python\ndef sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n    \"\"\"\n    if not array:\n        return []\n\n    if len(array) == 1:\n        return list(array)\n\n    first_val = array[0]\n    last_val = array[-1]\n    sum_first_last = first_val + last_val\n\n    copied_array = list(array)\n\n    if sum_first_last % 2 != 0:  # Sum is odd, sort ascending\n        return sorted(copied_array)\n    else:  # Sum is even, sort descending\n        return sorted(copied_array, reverse=True)\n```"}
{"task_id": "HumanEval/86", "solution": "```python\nimport re\n\ndef anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n\n    For example:\n    anti_shuffle('Hi') returns 'Hi'\n    anti_shuffle('hello') returns 'ehllo'\n    anti_shuffle('Hello World!!!') returns 'Hello !!!Wdlor'\n    \"\"\"\n    parts = []\n    last_end = 0\n    # Identify words (sequences of non-space characters)\n    for match in re.finditer(r'\\S+', s):\n        # Add any spaces before the current word\n        if match.start() > last_end:\n            parts.append(s[last_end:match.start()])\n        # Add the word itself, with sorted characters\n        parts.append(\"\".join(sorted(match.group(0))))\n        last_end = match.end()\n\n    # Add any trailing spaces\n    if last_end < len(s):\n        parts.append(s[last_end:])\n\n    return \"\".join(parts)\n```\n"}
{"task_id": "HumanEval/87", "solution": "```python\ndef get_row(lst, x):\n    \"\"\"\n    Finds all occurrences of x in the nested list lst and returns their (row, column)\n    coordinates, sorted primarily by row ascending, then by column descending.\n    \"\"\"\n    found_coordinates = []\n    for row_idx, row in enumerate(lst):\n        for col_idx, element in enumerate(row):\n            if element == x:\n                found_coordinates.append((row_idx, col_idx))\n\n    # Sort primarily by row (ascending), secondarily by column (descending)\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n    return found_coordinates\n```"}
{"task_id": "HumanEval/90", "solution": "```python\ndef next_smallest(lst):\n    \"\"\"\n    You are given a list of integers.\n    Write a function next_smallest() that returns the 2nd smallest element of the list.\n    Return None if there is no such element.\n    \"\"\"\n    if not lst:\n        return None\n\n    unique_elements = sorted(list(set(lst)))\n\n    if len(unique_elements) < 2:\n        return None\n    else:\n        return unique_elements[1]\n```"}
{"task_id": "HumanEval/81", "solution": "```python\ndef numerical_letter_grade(grades):\n    \"\"\"It is the last week of the semester and the teacher has to give the grades\n    to students. The teacher has been making her own algorithm for grading.\n    The only problem is, she has lost the code she used for grading.\n    She has given you a list of GPAs for some students and you have to write\n    a function that can output a list of letter grades using the following table:\n             GPA       |    Letter grade\n              4.0                A+\n            > 3.7                A\n            > 3.3                A-\n            > 3.0                B+\n            > 2.7                B\n            > 2.3                B-\n            > 2.0                C+\n            > 1.7                C\n            > 1.3                C-\n            > 1.0                D+\n            > 0.7                D\n            > 0.0                D-\n              0.0                E\n\n\n    Example:\n    grade_equation([4.0, 3, 1.7, 2, 3.5]) ==> ['A+', 'B', 'C-', 'C', 'A-']\n    \"\"\"\n    GRADING_SCALE = [\n        (4.0, 4.1, \"A+\"), # GPA 4.0\n        (3.7, 4.0, \"A\"),  # 3.7 <= gpa < 4.0\n        (3.3, 3.7, \"A-\"), # 3.3 <= gpa < 3.7\n        (3.0, 3.3, \"B+\"), # 3.0 <= gpa < 3.3\n        (2.7, 3.0, \"B\"),  # 2.7 <= gpa < 3.0\n        (2.3, 2.7, \"B-\"), # 2.3 <= gpa < 2.7\n        (2.0, 2.3, \"C+\"), # 2.0 <= gpa < 2.3\n        (1.7, 2.0, \"C\"),  # 1.7 <= gpa < 2.0\n        (1.3, 1.7, \"C-\"), # 1.3 <= gpa < 1.7\n        (1.0, 1.3, \"D+\"), # 1.0 <= gpa < 1.3\n        (0.7, 1.0, \"D\"),  # 0.7 <= gpa < 1.0\n        (0.0, 0.7, \"F\"),  # 0.0 <= gpa < 0.7\n    ]\n\n    letter_grades = []\n    for gpa in grades:\n        if not isinstance(gpa, (int, float)):\n            letter_grades.append(\"Invalid GPA\")\n            continue\n        if not (0.0 <= gpa <= 4.0):\n            letter_grades.append(\"Invalid GPA\")\n            continue\n\n        found_grade = False\n        for min_gpa, max_gpa, letter in GRADING_SCALE:\n            if min_gpa <= gpa < max_gpa:\n                letter_grades.append(letter)\n                found_grade = True\n                break\n\n        if not found_grade: # This case should ideally not be reached with a comprehensive scale.\n            letter_grades.append(\"Invalid GPA\")\n\n    return letter_grades\n```"}
