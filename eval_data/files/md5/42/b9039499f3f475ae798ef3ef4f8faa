{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n\n    if not numbers:\n        return (current_sum, current_product)\n\n    for num in numbers:\n        current_sum += num\n        current_product *= num\n    \n    return (current_sum, current_product)"}
{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_max_list: List[int] = []\n    current_max: float = float('-inf') # Initialize with negative infinity to handle all integer ranges\n\n    for number in numbers:\n        current_max = max(current_max, number)\n        rolling_max_list.append(int(current_max)) # Ensure the output elements are integers\n\n    return rolling_max_list"}
{"task_id": "HumanEval/6", "solution": "def parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n    \"\"\"\n    \n    def _calculate_deepest_nesting_for_group(group_string: str) -> int:\n        \"\"\"Calculates the deepest nesting level for a single group of parentheses.\"\"\"\n        current_level = 0\n        max_level = 0\n        for char in group_string:\n            if char == '(':\n                current_level += 1\n                max_level = max(max_level, current_level)\n            elif char == ')':\n                current_level -= 1\n        return max_level\n\n    groups = paren_string.split(' ')\n    results = []\n    for group in groups:\n        if not group.strip(): # Handles empty strings or strings with only spaces\n            results.append(0)\n        else:\n            results.append(_calculate_deepest_nesting_for_group(group))\n    return results"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    a = abs(a)\n    b = abs(b)\n\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    # Iterate through all possible starting positions (k) of a suffix,\n    # from the beginning of the string (k=0) to just past the end (k=len(string)).\n    # The first k for which string[k:] is a palindrome will be the starting index\n    # of the *longest* palindromic suffix.\n    for k in range(len(string) + 1):\n        suffix = string[k:]\n        if is_palindrome(suffix):\n            # Found the longest palindromic suffix starting at index k.\n            # The part of the string before this suffix is string[:k].\n            # This prefix needs to be reversed and appended to the original string.\n            prefix_to_reverse = string[:k]\n            return string + prefix_to_reverse[::-1]\n\n    # This line should logically not be reached because an empty string (string[len(string):])\n    # is always a palindrome, ensuring that a palindromic suffix will always be found.\n    return string"}
