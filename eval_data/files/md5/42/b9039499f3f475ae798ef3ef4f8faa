{"task_id": "HumanEval/27", "solution": "```python\ndef flip_case(string: str) -> str:\n    \"\"\" For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    >>> flip_case('Hello')\n    'hELLO'\n    \"\"\"\n    flipped_chars = []\n    for char in string:\n        if char.islower():\n            flipped_chars.append(char.upper())\n        elif char.isupper():\n            flipped_chars.append(char.lower())\n        else:\n            flipped_chars.append(char)\n    return \"\".join(flipped_chars)\n```"}
{"task_id": "HumanEval/30", "solution": "```python\ndef get_positive(l: list):\n    \"\"\"Return only positive numbers in the list.\n    >>> get_positive([-1, 2, -4, 5, 6])\n    [2, 5, 6]\n    >>> get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    [5, 3, 2, 3, 9, 123, 1]\n    \"\"\"\n    return [n for n in l if n > 0]\n```"}
{"task_id": "HumanEval/24", "solution": "```python\ndef largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    for i in range(n // 2, 0, -1):\n        if n % i == 0:\n            return i\n    # For prime numbers (or n=2), the largest divisor smaller than n is 1.\n    return 1\n```"}
{"task_id": "HumanEval/25", "solution": "```python\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each factor is listed the number of times it appears in the factorization.\n    \"\"\"\n    factors = []\n    d = 2\n\n    # Iterate through potential divisors up to the square root of n\n    while d * d <= n:\n        # If d divides n, add d to factors and divide n by d\n        while n % d == 0:\n            factors.append(d)\n            n //= d\n        # Move to the next potential divisor\n        d += 1\n\n    # If n is still greater than 1, it means the remaining n is a prime factor\n    if n > 1:\n        factors.append(n)\n\n    return factors\n```"}
{"task_id": "HumanEval/19", "solution": "```python\nfrom typing import List, Dict, Optional\n\nclass NumberWordMapper:\n    \"\"\"Provides a bidirectional mapping between number words and their integer equivalents.\"\"\"\n    _WORD_TO_INT_MAP: Dict[str, int] = {\n        \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n        \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9\n    }\n    _INT_TO_WORD_MAP: Dict[int, str] = {\n        0: \"zero\", 1: \"one\", 2: \"two\", 3: \"three\", 4: \"four\",\n        5: \"five\", 6: \"six\", 7: \"seven\", 8: \"eight\", 9: \"nine\"\n    }\n\n    def word_to_int(self, word: str) -> Optional[int]:\n        return self._WORD_TO_INT_MAP.get(word.lower())\n\n    def int_to_word(self, num: int) -> Optional[str]:\n        return self._INT_TO_WORD_MAP.get(num)\n\nclass NumberSorterService:\n    \"\"\"Encapsulates the core business logic for sorting lists of number words.\"\"\"\n    def __init__(self, mapper: NumberWordMapper):\n        self._mapper = mapper\n\n    def sort_word_numbers(self, words: List[str]) -> List[str]:\n        if not words:\n            return []\n\n        numbers = []\n        for word in words:\n            num = self._mapper.word_to_int(word)\n            if num is not None:\n                numbers.append(num)\n\n        numbers.sort()\n\n        sorted_words = []\n        for num in numbers:\n            word = self._mapper.int_to_word(num)\n            if word is not None:\n                sorted_words.append(word)\n\n        return sorted_words\n\nclass NumberSortController:\n    \"\"\"Handles parsing input, orchestrating sorting, and formatting output.\"\"\"\n    def __init__(self, sorter_service: NumberSorterService):\n        self._sorter_service = sorter_service\n\n    def sort_numbers(self, numbers_str: str) -> str:\n        if not numbers_str:\n            return \"\"\n\n        words = numbers_str.split(' ')\n        sorted_words = self._sorter_service.sort_word_numbers(words)\n        return ' '.join(sorted_words)\n\n_mapper = NumberWordMapper()\n_sorter_service = NumberSorterService(_mapper)\n_controller = NumberSortController(_sorter_service)\n\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    \"\"\"\n    return _controller.sort_numbers(numbers)\n```"}
