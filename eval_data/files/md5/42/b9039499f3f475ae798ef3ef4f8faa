{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    Counts the number of boredoms in a string.\n    A boredom is a sentence that starts with the word \"I\", delimited by '.', '?' or '!'.\n    \"\"\"\n\n    class SentenceParser:\n        \"\"\"\n        Parses text into individual sentences and cleans them.\n        \"\"\"\n        def split_sentences(self, text: str) -> list[str]:\n            sentences = []\n            current_sentence_chars = []\n            delimiters = ['.', '?', '!']\n\n            for char in text:\n                current_sentence_chars.append(char)\n                if char in delimiters:\n                    sentence_str = \"\".join(current_sentence_chars).strip()\n                    if sentence_str:\n                        sentences.append(self._clean_sentence(sentence_str))\n                    current_sentence_chars = []\n\n            remaining_text = \"\".join(current_sentence_chars).strip()\n            if remaining_text:\n                sentences.append(self._clean_sentence(remaining_text))\n\n            return sentences\n\n        def _clean_sentence(self, sentence: str) -> str:\n            \"\"\"Removes trailing delimiters and trims whitespace from a sentence.\"\"\"\n            while sentence and sentence[-1] in ['.', '?', '!'] :\n                sentence = sentence[:-1]\n            return sentence.strip()\n\n    class BoredomCounter:\n        \"\"\"\n        Counts sentences starting with \"I\" using a provided sentence parser.\n        \"\"\"\n        def __init__(self, sentence_parser: SentenceParser):\n            self._sentence_parser = sentence_parser\n\n        def count(self, text: str) -> int:\n            boredom_count = 0\n            sentences = self._sentence_parser.split_sentences(text)\n\n            for sentence in sentences:\n                if self._is_bored_sentence(sentence):\n                    boredom_count += 1\n            return boredom_count\n\n        def _is_bored_sentence(self, sentence: str) -> bool:\n            \"\"\"Checks if a sentence starts with the word \"I\" (case-insensitive).\"\"\"\n            cleaned_sentence = sentence.strip()\n            if not cleaned_sentence:\n                return False\n\n            first_word = cleaned_sentence.split(maxsplit=1)[0]\n            return first_word.lower() == \"i\"\n\n    parser = SentenceParser()\n    counter = BoredomCounter(parser)\n    return counter.count(S)"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    \"\"\"\n    if not dict:\n        return False\n\n    keys = list(dict.keys())\n\n    # Check if all keys are strings first\n    for key in keys:\n        if not isinstance(key, str):\n            return False\n\n    # Determine the case of the first key\n    first_key = keys[0]\n    if first_key.islower():\n        # Check if all keys are lowercase\n        for key in keys:\n            if not key.islower():\n                return False\n        return True\n    elif first_key.isupper():\n        # Check if all keys are uppercase\n        for key in keys:\n            if not key.isupper():\n                return False\n        return True\n    else:\n        # First key is neither purely lower nor purely upper (e.g., \"MixedCase\", \"123\")\n        return False\n```"}
