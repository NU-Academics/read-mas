{"task_id": "HumanEval/32", "solution": "```python\nimport math\n\nclass InvalidCoefficientsError(Exception):\n    \"\"\"\n    Custom exception raised when polynomial coefficients do not meet the required criteria.\n    \"\"\"\n    pass\n\nclass ZeroNotFoundError(Exception):\n    \"\"\"\n    Custom exception raised when a zero cannot be found within the specified search parameters.\n    \"\"\"\n    pass\n\nDEFAULT_TOLERANCE = 1e-6\nMAX_ITERATIONS = 1000\nSEARCH_RANGE_MIN = -100.0\nSEARCH_RANGE_MAX = 100.0\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    if not xs or len(xs) % 2 != 0:\n        raise InvalidCoefficientsError(\"Coefficient list must not be empty and must have an even number of coefficients.\")\n\n    low = SEARCH_RANGE_MIN\n    high = SEARCH_RANGE_MAX\n\n    f_low = poly(xs, low)\n    f_high = poly(xs, high)\n\n    if abs(f_low) < DEFAULT_TOLERANCE:\n        return low\n    if abs(f_high) < DEFAULT_TOLERANCE:\n        return high\n\n    # If f_low and f_high have the same sign, we might not initially bracket a root.\n    # The problem guarantees a solution, so we proceed with bisection hoping to find one.\n    if f_low * f_high > 0:\n        pass\n\n    for _ in range(MAX_ITERATIONS):\n        mid = (low + high) / 2\n        f_mid = poly(xs, mid)\n\n        if abs(f_mid) < DEFAULT_TOLERANCE:\n            return mid\n\n        # Re-evaluate f_low and f_high for the current interval to ensure correct sign comparison\n        current_f_low = poly(xs, low)\n        current_f_high = poly(xs, high)\n\n        if current_f_low * f_mid < 0:\n            high = mid\n        elif current_f_high * f_mid < 0:\n            low = mid\n        else:\n            # This case implies no sign change in either sub-interval.\n            # Given the problem's guarantee of a solution, this indicates a failure to converge.\n            break\n\n    raise ZeroNotFoundError(f\"Could not find a zero within {MAX_ITERATIONS} iterations and tolerance {DEFAULT_TOLERANCE}.\")\n\n```"}
{"task_id": "HumanEval/45", "solution": "```python\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nfrom typing import Any\n\nclass InputValidator:\n    \"\"\"Utility class for validating various inputs.\"\"\"\n\n    @staticmethod\n    def validate_positive_numeric(value: Any, name: str) -> float:\n        \"\"\"\n        Validates if a value is a positive number (int or float).\n        Returns the validated value as a float.\n        \"\"\"\n        try:\n            numeric_value = float(value)\n        except (TypeError, ValueError):\n            raise InvalidInputError(f\"{name} must be a number.\")\n\n        if numeric_value <= 0:\n            raise InvalidInputError(f\"{name} must be a positive number.\")\n\n        return numeric_value\n\ndef triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    try:\n        validated_a = InputValidator.validate_positive_numeric(a, \"Base length\")\n        validated_h = InputValidator.validate_positive_numeric(h, \"Height\")\n        return 0.5 * validated_a * validated_h\n    except InvalidInputError as e:\n        raise ValueError(str(e)) from e\n```\n"}
