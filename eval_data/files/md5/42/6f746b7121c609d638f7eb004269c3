{"task_id": "HumanEval/135", "solution": "```python\ndef can_arrange(arr):\n    \"\"\"Returns the largest index of an element which is not greater than or\n    equal to the element immediately preceding it. Returns -1 if no such element exists.\"\"\"\n    # Iterate from the second-to-last element down to the second element (index 1)\n    for i in range(len(arr) - 1, 0, -1):\n        # Check if the current element is strictly less than its predecessor\n        if arr[i] < arr[i-1]:\n            return i  # Return the largest such index found\n\n    # If no such element is found after checking all possibilities\n    return -1\n```"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n\n    Examples:\n    largest_smallest_integers([2, 4, 1, 3, 5, 7]) == (None, 1)\n    largest_smallest_integers([]) == (None, None)\n    largest_smallest_integers([0]) == (None, None)\n    '''\n    largest_neg = None\n    smallest_pos = None\n\n    for num in lst:\n        if num < 0:\n            if largest_neg is None or num > largest_neg:\n                largest_neg = num\n        elif num > 0:\n            if smallest_pos is None or num < smallest_pos:\n                smallest_pos = num\n\n    return (largest_neg, smallest_pos)"}
{"task_id": "HumanEval/138", "solution": "```python\ndef is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers\n    Example\n    is_equal_to_sum_even(4) == False\n    is_equal_to_sum_even(6) == False\n    is_equal_to_sum_even(8) == True\n    \"\"\"\n    # The smallest sum of 4 positive even numbers is 2 + 2 + 2 + 2 = 8.\n    # Also, the sum of 4 even numbers must always be an even number.\n    if n < 8 or n % 2 != 0:\n        return False\n\n    # If n is an even number greater than or equal to 8, it can always be\n    # written as the sum of 4 positive even numbers. For example, n = 2 + 2 + 2 + (n - 6).\n    return True\n```"}
{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Compares two values (int, float, or string real numbers) and returns the larger,\n    preserving its original type. Returns None if the values are numerically equal.\n    \"\"\"\n\n    def _to_float_val(value):\n        \"\"\"Converts a value (int, float, or string with ',' or '.' decimal) to a float.\"\"\"\n        if isinstance(value, str):\n            value = value.replace(',', '.')\n        return float(value)\n\n    float_a = _to_float_val(a)\n    float_b = _to_float_val(b)\n\n    if float_a > float_b:\n        return a\n    elif float_b > float_a:\n        return b\n    else:\n        return None"}
{"task_id": "HumanEval/129", "solution": "```python\nfrom typing import List, Tuple\n\nclass Grid:\n    \"\"\"Manages grid data and provides neighbor information.\"\"\"\n    def __init__(self, data: List[List[int]]):\n        self._rows = len(data)\n        self._cols = len(data[0])\n        self._data = data\n\n    def get_value(self, r: int, c: int) -> int:\n        return self._data[r][c]\n\n    def get_dimensions(self) -> Tuple[int, int]:\n        return self._rows, self._cols\n\n    def is_valid_coord(self, r: int, c: int) -> bool:\n        return 0 <= r < self._rows and 0 <= c < self._cols\n\n    def get_neighbors(self, r: int, c: int) -> List[Tuple[int, int]]:\n        \"\"\"Returns valid (on-grid) neighbor coordinates.\"\"\"\n        neighbors = []\n        # Directions: Up, Down, Left, Right\n        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n        for dr, dc in directions:\n            nr, nc = r + dr, c + dc\n            if self.is_valid_coord(nr, nc):\n                neighbors.append((nr, nc))\n        return neighbors\n\nclass MinPathSolver:\n    \"\"\"Finds the lexicographically smallest path using dynamic programming.\"\"\"\n    def __init__(self, grid: Grid, k: int):\n        self._grid = grid\n        self._k = k\n        self._rows, self._cols = grid.get_dimensions()\n        # _dp_table[r][c][l] stores the min path of length l ending at (r, c).\n        self._dp_table: List[List[List[List[int]]]] = [\n            [[[] for _ in range(k + 1)] for _ in range(self._cols)]\n            for _ in range(self._rows)\n        ]\n\n    def _compare_paths(self, path1: List[int], path2: List[int]) -> int:\n        \"\"\"Compares two paths lexicographically.\"\"\"\n        # Treat empty path (initial \"infinity\") as greater for comparison.\n        if not path1:\n            return 1\n        if not path2:\n            return -1\n\n        for i in range(min(len(path1), len(path2))):\n            if path1[i] < path2[i]:\n                return -1\n            elif path1[i] > path2[i]:\n                return 1\n\n        # If one path is a prefix of another, the shorter is smaller.\n        if len(path1) < len(path2):\n            return -1\n        elif len(path1) > len(path2):\n            return 1\n        return 0\n\n    def _get_max_path_value(self) -> int:\n        \"\"\"Returns a value larger than any grid cell value.\"\"\"\n        # Max grid value is N*N, so N*N + 1 is safe.\n        return self._rows * self._cols + 1\n\n    def solve(self) -> List[int]:\n        # Base case: paths of length 1.\n        for r in range(self._rows):\n            for c in range(self._cols):\n                self._dp_table[r][c][1] = [self._grid.get_value(r, c)]\n\n        # Fill DP table for lengths 2 to k.\n        for length in range(2, self._k + 1):\n            for r in range(self._rows):\n                for c in range(self._cols):\n                    current_cell_value = self._grid.get_value(r, c)\n                    # Initialize with \"infinity\" path.\n                    min_path_for_current_cell = [self._get_max_path_value()] * length\n\n                    for pr, pc in self._grid.get_neighbors(r, c):\n                        prev_path = self._dp_table[pr][pc][length - 1]\n                        # Skip if no valid path of length-1 exists (i.e., it's an \"infinity\" path).\n                        if not prev_path:\n                            continue\n\n                        candidate_path = prev_path + [current_cell_value]\n\n                        if self._compare_paths(candidate_path, min_path_for_current_cell) == -1:\n                            min_path_for_current_cell = candidate_path\n\n                    self._dp_table[r][c][length] = min_path_for_current_cell\n\n        # Find the overall minimum path of length k.\n        overall_min_path: List[int] = [self._get_max_path_value()] * self._k\n        for r in range(self._rows):\n            for c in range(self._cols):\n                path_ending_at_rc = self._dp_table[r][c][self._k]\n                if path_ending_at_rc and self._compare_paths(path_ending_at_rc, overall_min_path) == -1:\n                    overall_min_path = path_ending_at_rc\n\n        return overall_min_path\n\n\ndef minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k,\n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n    # Validate grid dimensions and k.\n    if not grid or not isinstance(grid, list) or not all(isinstance(row, list) for row in grid):\n        raise ValueError(\"Grid data must be a list of lists.\")\n\n    rows = len(grid)\n    if rows < 2:\n        raise ValueError(\"Grid must have at least 2 rows (N >= 2).\")\n\n    cols = len(grid[0])\n    if rows != cols:\n        raise ValueError(\"Grid must be square (N x N).\")\n    if not all(len(row) == cols for row in grid):\n        raise ValueError(\"All rows in the grid must have the same number of columns.\")\n\n    if not isinstance(k, int) or k <= 0:\n        raise ValueError(\"Path length k must be a positive integer.\")\n\n    grid_instance = Grid(grid)\n    solver = MinPathSolver(grid_instance, k)\n    return solver.solve()\n\n```"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n\n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    # First, replace sequences of 3 or more spaces with a single hyphen\n    processed_text = re.sub(r' {3,}', '-', text)\n\n    # Then, replace any remaining single spaces with underscores\n    final_text = processed_text.replace(' ', '_')\n\n    return final_text"}
{"task_id": "HumanEval/139", "solution": "```python\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n\n    # Helper function to calculate standard factorial k!\n    def _factorial(k):\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    brazilian_factorial_result = 1\n    for i in range(1, n + 1):\n        brazilian_factorial_result *= _factorial(i)\n    return brazilian_factorial_result\n```"}
{"task_id": "HumanEval/143", "solution": "```python\ndef words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, keeping only those whose lengths are prime numbers.\n    Utilizes a helper function to determine if a number is prime.\n    \"\"\"\n    def _is_prime(n: int) -> bool:\n        \"\"\"Checks if a given integer n is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0: # Optimization: skip even numbers after 2\n            return False\n        # Check for divisibility from 3 up to the square root of n, skipping even numbers\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    words = sentence.split(' ')\n    prime_length_words = []\n\n    for word in words:\n        if word and _is_prime(len(word)):\n            prime_length_words.append(word)\n\n    return \" \".join(prime_length_words)\n```"}
{"task_id": "HumanEval/142", "solution": "```python\ndef sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n\n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    total_sum = 0\n    for i, value in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += value * value\n        elif i % 4 == 0:\n            total_sum += value * value * value\n        else:\n            total_sum += value\n    return total_sum\n```"}
{"task_id": "HumanEval/144", "solution": "```python\nclass Fraction:\n    \"\"\"Represents a mathematical fraction with a numerator and a denominator.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        self._numerator = numerator\n        self._denominator = denominator\n\n    def get_numerator(self) -> int:\n        \"\"\"Returns the numerator of the fraction.\"\"\"\n        return self._numerator\n\n    def get_denominator(self) -> int:\n        \"\"\"Returns the denominator of the fraction.\"\"\"\n        return self._denominator\n\n    def multiply(self, other: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another Fraction object and returns the product.\"\"\"\n        new_numerator = self._numerator * other.get_numerator()\n        new_denominator = self._denominator * other.get_denominator()\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Checks if the fraction represents a whole number.\"\"\"\n        return self._numerator % self._denominator == 0\n\nclass FractionParser:\n    \"\"\"Provides a static method to parse a fraction string into a Fraction object.\"\"\"\n    @staticmethod\n    def parse_fraction(fraction_str: str) -> Fraction:\n        parts = fraction_str.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return Fraction(numerator, denominator)\n\nclass FractionService:\n    \"\"\"Orchestrates the parsing, multiplication, and whole number check for two fraction strings.\"\"\"\n    @staticmethod\n    def simplify(x_str: str, n_str: str) -> bool:\n        fraction_x = FractionParser.parse_fraction(x_str)\n        fraction_n = FractionParser.parse_fraction(n_str)\n\n        product_fraction = fraction_x.multiply(fraction_n)\n\n        return product_fraction.is_whole_number()\n\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    return FractionService.simplify(x, n)\n```"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    \"\"\"\n\n    # Check 1: Not more than three digits\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    # Check 2: Exactly one dot\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # Split into prefix and extension based on the dot\n    parts = file_name.split('.')\n    prefix = parts[0]\n    extension = parts[1]\n\n    # Check 3a: Prefix should not be empty\n    if not prefix:\n        return 'No'\n\n    # Check 3b: Prefix starts with a letter from the latin alphabet\n    # (a-z and A-Z)\n    if not (('a' <= prefix[0] <= 'z') or ('A' <= prefix[0] <= 'Z')):\n        return 'No'\n\n    # Check 4: Extension validity\n    allowed_extensions = ['txt', 'exe', 'dll']\n    if extension not in allowed_extensions:\n        return 'No'\n\n    # All conditions are met\n    return 'Yes'"}
