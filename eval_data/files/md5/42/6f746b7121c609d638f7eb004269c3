{"task_id": "HumanEval/31", "solution": "```python\ndef is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    A prime number is a natural number greater than 1 that has no positive divisors other than 1 and itself.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n```"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\n        return []\n\n    # Collect elements and their original indices that are divisible by three\n    third_elements = []\n    third_indices = []\n    for i, item in enumerate(l):\n        if i % 3 == 0:\n            third_elements.append(item)\n            third_indices.append(i)\n\n    # Sort the collected elements\n    third_elements.sort()\n\n    # Create a new list as a copy of the original\n    result_list = list(l)\n\n    # Place the sorted elements back into the new list at their original divisible-by-three indices\n    for i, sorted_val in zip(third_indices, third_elements):\n        result_list[i] = sorted_val\n\n    return result_list"}
{"task_id": "HumanEval/34", "solution": "```python\ndef unique(l: list):\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    # Convert to a set to get unique elements, then sort the resulting list.\n    return sorted(list(set(l)))\n```"}
{"task_id": "HumanEval/35", "solution": "```python\ndef max_element(l: list) -> Any:\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    if not l:\n        raise ValueError(\"List cannot be empty\")\n\n    max_val = l[0]\n    for element in l:\n        if element > max_val:\n            max_val = element\n    return max_val\n```"}
{"task_id": "HumanEval/36", "solution": "```python\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\"\"\"\n    total_count = 0\n    for i in range(1, n):\n        # Check if i is divisible by 11 or 13\n        if (i % 11 == 0) or (i % 13 == 0):\n            # Convert to string to count occurrences of '7'\n            total_count += str(i).count('7')\n    return total_count\n```"}
{"task_id": "HumanEval/37", "solution": "```python\ndef sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    even_elements = []\n    for i in range(0, len(l), 2):\n        even_elements.append(l[i])\n\n    even_elements.sort()\n\n    result = l[:] # Create a shallow copy to preserve odd elements.\n    even_idx_ptr = 0\n    for i in range(0, len(l), 2):\n        result[i] = even_elements[even_idx_ptr]\n        even_idx_ptr += 1\n\n    return result\n```"}
{"task_id": "HumanEval/40", "solution": "```python\ndef triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    # Sort the list to use the two-pointer technique\n    sorted_l = sorted(l)\n\n    for i in range(n - 2):\n        left = i + 1\n        right = n - 1\n\n        while left < right:\n            current_sum = sorted_l[i] + sorted_l[left] + sorted_l[right]\n\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n            else:  # current_sum > 0\n                right -= 1\n    return False\n```"}
{"task_id": "HumanEval/38", "solution": "```python\ndef decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    decoded_groups = []\n    for group in groups:\n        if len(group) == 3:\n            # Reversing the cyclic shift: original[0]=encoded[2], original[1]=encoded[0], original[2]=encoded[1]\n            decoded_groups.append(group[2] + group[0] + group[1])\n        else:\n            decoded_groups.append(group)\n    return \"\".join(decoded_groups)\n```"}
