{"task_id": "HumanEval/82", "solution": "```python\ndef prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    Examples\n    prime_length('Hello') == True\n    prime_length('abcdcba') == True\n    prime_length('kittens') == True\n    prime_length('orange') == False\n    \"\"\"\n    length = len(string)\n\n    if length < 2:\n        return False\n\n    # Check for divisibility from 2 up to the square root of the length\n    i = 2\n    while i * i <= length:\n        if length % i == 0:\n            return False\n        i += 1\n    return True\n```"}
{"task_id": "HumanEval/83", "solution": "```python\ndef starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n    else:\n        # The count is calculated using the inclusion-exclusion principle for numbers starting with 1 or ending with 1.\n        # This formula is 10^(n-1) + 8 * 10^(n-2) for n >= 2.\n        return (10**(n - 1)) + (8 * (10**(n - 2)))\n```"}
{"task_id": "HumanEval/85", "solution": "```python\ndef add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\n\n\n    Examples:\n        add([4, 2, 6, 7]) ==> 2\n    \"\"\"\n    total_sum = 0\n    for i, element in enumerate(lst):\n        # Add element if its index is odd and the element itself is even.\n        if i % 2 != 0 and element % 2 == 0:\n            total_sum += element\n    return total_sum\n```"}
{"task_id": "HumanEval/84", "solution": "```python\ndef solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\"\"\"\n\n    decimal_sum = 0\n    # Calculate the sum of decimal digits\n    if N == 0:\n        decimal_sum = 0\n    else:\n        for digit_char in str(N):\n            decimal_sum += int(digit_char)\n\n    # Convert the decimal sum to its binary string representation\n    if decimal_sum == 0:\n        return \"0\"\n\n    return bin(decimal_sum)[2:]\n```"}
{"task_id": "HumanEval/86", "solution": "```python\nimport re\n\ndef anti_shuffle(s):\n    \"\"\"\n    Returns an ordered version of the string where words have characters\n    arranged in ascending ASCII order, preserving word and space order.\n    \"\"\"\n\n    # Split the string by spaces, keeping the spaces as delimiters in the result.\n    parts = re.split(r'(\\s+)', s)\n\n    result_parts = []\n    for part in parts:\n        # If the part is an actual word (not just spaces or an empty string)\n        if part.strip() == \"\": # This means it's a space-only part or an empty string from split\n            result_parts.append(part)\n        else: # This means it's a word\n            # Sort the characters within the word based on their ASCII values\n            result_parts.append(\"\".join(sorted(part)))\n\n    return \"\".join(result_parts)\n```"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"It is the last week of the semester and the teacher has to give the grades\n    to students. The teacher has been making her own algorithm for grading.\n    The only problem is, she has lost the code she used for grading.\n    She has given you a list of GPAs for some students and you have to write\n    a function that can output a list of letter grades using the following table:\n             GPA       |    Letter grade\n              4.0                A+\n            > 3.7                A\n            > 3.3                A-\n            > 3.0                B+\n            > 2.7                B\n            > 2.3                B-\n            > 2.0                C+\n            > 1.7                C\n            > 1.3                C-\n            > 1.0                D+\n            > 0.7                D\n            > 0.0                D-\n              0.0                E\n\n\n    Example:\n    grade_equation([4.0, 3, 1.7, 2, 3.5]) ==> ['A+', 'B', 'C-', 'C', 'A-']\n    \"\"\"\n\n    class GPAValidator:\n        \"\"\"Validates if a given GPA is within the acceptable range [0.0, 4.0].\"\"\"\n        MIN_GPA: float = 0.0\n        MAX_GPA: float = 4.0\n\n        def validate(self, gpa: float) -> None:\n            \"\"\"Raises ValueError if GPA is out of range.\"\"\"\n            if not (self.MIN_GPA <= gpa <= self.MAX_GPA):\n                raise ValueError(f\"GPA must be between {self.MIN_GPA} and {self.MAX_GPA}, inclusive. Got: {gpa}\")\n\n    class GradeMapping:\n        \"\"\"Stores and provides access to the GPA to letter grade mapping.\"\"\"\n        def __init__(self):\n            # Ordered from highest GPA threshold to lowest for efficient lookup.\\\n            # 4.0 is exact, others are strictly greater than threshold.\n            self._GRADING_SCALE = [\n                (4.0, \"A+\"),\n                (3.7, \"A\"),\n                (3.3, \"A-\"),\n                (3.0, \"B+\"),\n                (2.7, \"B\"),\n                (2.3, \"B-\"),\n                (2.0, \"C+\"),\n                (1.7, \"C\"),\n                (1.3, \"C-\"),\n                (1.0, \"D+\"),\n                (0.7, \"D\"),\n                (0.0, \"D-\")\n            ]\n\n        def get_grade(self, gpa: float) -> str:\n            \"\"\"Determines the letter grade for a given GPA.\"\"\"\n            if gpa == 0.0:\n                return \"E\"\n\n            for threshold, grade in self._GRADING_SCALE:\n                if threshold == 4.0: # Special case for 4.0 (exact match)\n                    if gpa == 4.0:\n                        return grade\n                elif gpa > threshold: # General rule for '> threshold'\n                    return grade\n\n            # This point should be unreachable if validation ensures gpa >= 0.0\n            # and the gpa == 0.0 case is handled, and gpa > 0.0 matches D-.\n            raise ValueError(f\"GPA {gpa} did not match any grade rule after validation.\")\n\n\n    class GradeConverterService:\n        \"\"\"Orchestrates GPA to letter grade conversion, using validation and mapping.\"\"\"\n        def __init__(self, grade_mapping: GradeMapping, gpa_validator: GPAValidator):\n            self._grade_mapping = grade_mapping\n            self._gpa_validator = gpa_validator\n\n        def convert_gpa(self, gpa: float) -> str:\n            \"\"\"Converts a single GPA to its letter grade.\"\"\"\n            self._gpa_validator.validate(gpa)\n            return self._grade_mapping.get_grade(gpa)\n\n        def convert_gpas(self, gpas: list[float]) -> list[str]:\n            \"\"\"Converts a list of GPAs to a list of letter grades.\"\"\"\n            letter_grades = []\n            for gpa in gpas:\n                letter_grades.append(self.convert_gpa(gpa))\n            return letter_grades\n\n    grade_mapping = GradeMapping()\n    gpa_validator = GPAValidator()\n    converter_service = GradeConverterService(grade_mapping, gpa_validator)\n    return converter_service.convert_gpas(grades)"}
