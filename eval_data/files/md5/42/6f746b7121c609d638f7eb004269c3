{"task_id": "HumanEval/123", "solution": "```python\ndef get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n    odd_numbers = set()\n    current = n\n\n    while current != 1:\n        if current % 2 != 0:\n            odd_numbers.add(current)\n\n        if current % 2 == 0:\n            current //= 2\n        else:\n            current = 3 * current + 1\n\n    odd_numbers.add(1) # 1 is always part of the sequence and is odd\n\n    return sorted(list(odd_numbers))\n```"}
{"task_id": "HumanEval/119", "solution": "```python\ndef match_parens(lst):\n    \"\"\"\n    Checks if two strings of parentheses can be concatenated in any order to form a balanced string.\n    A string is balanced if all parentheses are matched and in the correct order.\n    \"\"\"\n    def is_balanced(s):\n        \"\"\"\n        Helper function to determine if a given string of parentheses is balanced.\n        \"\"\"\n        count = 0\n        for char in s:\n            if char == '(':\n                count += 1\n            else:  # char == ')'\n                count -= 1\n            if count < 0:\n                return False\n        return count == 0\n\n    s1 = lst[0]\n    s2 = lst[1]\n\n    # Check the first concatenation order: s1 + s2\n    if is_balanced(s1 + s2):\n        return 'Yes'\n\n    # Check the second concatenation order: s2 + s1\n    if is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'\n```"}
{"task_id": "HumanEval/126", "solution": "```python\ndef is_sorted(lst):\n    from collections import Counter\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n\n    Examples\n    is_sorted([5]) \u279e True\n    is_sorted([1, 2, 3, 4, 5]) \u279e True\n    is_sorted([1, 3, 2, 4, 5]) \u279e False\n    is_sorted([1, 2, 3, 4, 5, 6]) \u279e True\n    is_sorted([1, 2, 3, 4, 5, 6, 7]) \u279e True\n    is_sorted([1, 3, 2, 4, 5, 6, 7]) \u279e False\n    is_sorted([1, 2, 2, 3, 3, 4]) \u279e True\n    is_sorted([1, 2, 2, 2, 3, 4]) \u279e False\n    '''\n    # Verify ascending order.\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Check for duplicate numbers; each number can appear at most twice.\n    counts = Counter(lst)\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    return True\n```"}
{"task_id": "HumanEval/125", "solution": "```python\ndef split_words(txt):\n    \"\"\"\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    \"\"\"\n    # First, check for whitespace characters.\n    has_whitespace = False\n    for char in txt:\n        if char.isspace():\n            has_whitespace = True\n            break\n\n    if has_whitespace:\n        return txt.split()\n\n    # If no whitespace, check for commas.\n    if ',' in txt:\n        return txt.split(',')\n\n    # If neither, count lowercase letters with odd alphabetical order.\n    odd_order_count = 0\n    for char in txt:\n        if 'a' <= char <= 'z':\n            order = ord(char) - ord('a')\n            if order % 2 != 0:\n                odd_order_count += 1\n    return odd_order_count\n```"}
{"task_id": "HumanEval/124", "solution": "```python\nimport re\n\ndef valid_date(date):\n    \"\"\"You have to write a function which validates a given date string and\n    returns True if the date is valid otherwise False.\n    The date is valid if all of the following rules are satisfied:\n    1. The date string is not empty.\n    2. The number of days is not less than 1 or higher than 31 days for months 1,3,5,7,8,10,12. And the number of days is not less than 1 or higher than 30 days for months 4,6,9,11. And, the number of days is not less than 1 or higher than 29 for the month 2.\n    3. The months should not be less than 1 or higher than 12.\n    4. The date should be in the format: mm-dd-yyyy\n\n    for example:\n    valid_date('03-11-2000') => True\n\n    valid_date('15-01-2012') => False\n\n    valid_date('04-0-2040') => False\n\n    valid_date('06-04-2020') => True\n\n    valid_date('06/04/2020') => False\n    \"\"\"\n    if not date:\n        return False\n\n    # Constants for date validation\n    DAYS_IN_MONTH = {\n        1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n        4: 30, 6: 30, 9: 30, 11: 30,\n    }\n    LEAP_YEAR_FEB_DAYS = 29\n    NON_LEAP_YEAR_FEB_DAYS = 28\n    DATE_FORMAT_REGEX = r\"^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])-\\\\d{4}$\"\n\n    # Helper function to determine if a year is a leap year\n    def _is_leap_year(year: int) -> bool:\n        return (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0)\n\n    # Validate format using regex and extract components\n    match = re.match(DATE_FORMAT_REGEX, date)\n    if not match:\n        return False\n\n    try:\n        month = int(date[0:2])\n        day = int(date[3:5])\n        year = int(date[6:10])\n    except ValueError:\n        return False\n\n    # Validate month range (Rule 3)\n    if not (1 <= month <= 12):\n        return False\n\n    # Validate day based on month and leap year (Rule 2)\n    max_days = DAYS_IN_MONTH.get(month)\n    if month == 2: # February\n        max_days = LEAP_YEAR_FEB_DAYS if _is_leap_year(year) else NON_LEAP_YEAR_FEB_DAYS\n    elif max_days is None: # Should not happen if month is already validated and DAYS_IN_MONTH is complete\n        return False\n\n    if not (1 <= day <= max_days):\n        return False\n\n    return True\n```"}
{"task_id": "HumanEval/128", "solution": "```python\ndef prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_magnitudes = 0\n    product_signs = 1\n\n    for num in arr:\n        sum_magnitudes += abs(num)\n\n        # Determine the sign of the current number\n        if num > 0:\n            current_sign = 1\n        elif num < 0:\n            current_sign = -1\n        else: # num == 0\n            current_sign = 0\n\n        product_signs *= current_sign\n\n    return sum_magnitudes * product_signs\n```"}
{"task_id": "HumanEval/131", "solution": "```python\ndef digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    product = 1\n    has_odd_digit = False\n\n    # Convert n to string to iterate through digits\n    for digit_char in str(n):\n        digit = int(digit_char)\n        if digit % 2 != 0:  # Check if the digit is odd\n            product *= digit\n            has_odd_digit = True\n\n    return product if has_odd_digit else 0\n```"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the first n + 1 numbers of the Tribonacci sequence. Raises ValueError if n is negative.\"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    # Initialize sequence with n + 2 elements to compute tri(n+1) for odd n.\n    trib_sequence = [0.0] * (n + 2)\n\n    # Set base cases for tri(0) and tri(1).\n    if n >= 0:\n        trib_sequence[0] = 1.0\n    if n >= 1:\n        trib_sequence[1] = 3.0\n\n    # First pass: Calculate all even terms up to n + 1 using their direct formula.\n    for i in range(2, n + 2):\n        if i % 2 == 0:  # If i is even.\n            trib_sequence[i] = 1.0 + i / 2.0\n\n    # Second pass: Calculate all odd terms up to n using pre-calculated values.\n    for i in range(2, n + 1):\n        if i % 2 != 0:  # If i is odd.\n            trib_sequence[i] = trib_sequence[i - 1] + trib_sequence[i - 2] + trib_sequence[i + 1]\n\n    # Return the requested first n + 1 elements of the sequence.\n    return trib_sequence[0 : n + 1]"}
{"task_id": "HumanEval/127", "solution": "```python\ndef intersection(interval1, interval2):\n    \"\"\"\n    Determines whether the length of intersection of two closed integer intervals is a prime number.\n    Returns \"YES\" if the length is prime, otherwise \"NO\".\n    \"\"\"\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"Determines if a given non-negative integer is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    a1, b1 = interval1\n    a2, b2 = interval2\n\n    # Calculate the start and end of the intersection\n    intersection_start = max(a1, a2)\n    intersection_end = min(b1, b2)\n\n    # If the intersection is empty (start > end), return \"NO\"\n    if intersection_start > intersection_end:\n        return \"NO\"\n\n    # Calculate the length of the intersection\n    intersection_length = intersection_end - intersection_start\n\n    # Check if the length is a prime number\n    if _is_prime(intersection_length):\n        return \"YES\"\n    else:\n        return \"NO\"\n```"}
{"task_id": "HumanEval/133", "solution": "```python\nimport math\n\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    Examples:\n    For lst = [1,2,3] the output should be 14\n    For lst = [1,4,9] the output should be 98\n    For lst = [1,3,5,7] the output should be 84\n    For lst = [1.4,4.2,0] the output should be 29\n    For lst = [-2.4,1,1] the output should be 6\n    \"\"\"\n\n    squared_and_rounded_sum = 0\n    for num in lst:\n        rounded_num = math.ceil(num)\n        squared_and_rounded_sum += rounded_num * rounded_num\n    return squared_and_rounded_sum\n```"}
