{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"Input n must be a positive integer greater than 0.\")\n\n    total_sevens = 0\n    for k in range(1, n):\n        if k % 11 == 0 or k % 13 == 0:\n            total_sevens += str(k).count('7')\n    return total_sevens"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    \"\"\"\n    if not l:\n        return []\n\n    even_indexed_values = []\n    for i in range(0, len(l), 2):\n        even_indexed_values.append(l[i])\n\n    even_indexed_values.sort()\n\n    result = list(l) # Create a mutable copy of the input list\n    even_sorted_idx = 0\n    for i in range(0, len(l), 2):\n        result[i] = even_indexed_values[even_sorted_idx]\n        even_sorted_idx += 1\n    \n    return result"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    Decodes a string encoded with encode_cyclic function by reversing the cyclic shift.\n    \"\"\"\n    # Split the encoded string into groups of 3, similar to encoding.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # Reverse the cycle for each group of 3 characters.\n    # A group `bca` becomes `abc` by moving the last char to the front: `c` + `bc`.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    class PrimeNumber:\n        def isPrime(self, number: int) -> bool:\n            if number < 2:\n                return False\n            if number == 2 or number == 3:\n                return True\n            if number % 2 == 0 or number % 3 == 0:\n                return False\n            i = 5\n            while i * i <= number:\n                if number % i == 0 or number % (i + 2) == 0:\n                    return False\n                i += 6\n            return True\n\n    class FibonacciSequence:\n        def getFibonacci(self, index: int) -> int:\n            if index == 0:\n                return 0\n            elif index == 1:\n                return 1\n            elif index == 2:\n                return 1\n            \n            a, b = 1, 1 # Represents F_1 and F_2\n            for _ in range(3, index + 1):\n                a, b = b, a + b\n            return b\n\n    class PrimeFibonacciCalculator:\n        def __init__(self):\n            self.fib_sequence = FibonacciSequence()\n            self.prime_checker = PrimeNumber()\n\n        def getPrimeFibonacci(self, n: int) -> int:\n            count_prime_fib = 0\n            current_fib_index = 3 # Start checking from F_3 = 2, as F_0, F_1, F_2 are not prime or 1\n            nth_prime_fib = 0\n\n            while count_prime_fib < n:\n                fib_num = self.fib_sequence.getFibonacci(current_fib_index)\n                if self.prime_checker.isPrime(fib_num):\n                    count_prime_fib += 1\n                    nth_prime_fib = fib_num\n                current_fib_index += 1\n            return nth_prime_fib\n\n    calculator = PrimeFibonacciCalculator()\n    return calculator.getPrimeFibonacci(n)"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    l.sort()  # Sort the list to efficiently find triplets.\n\n    for i in range(n - 2):\n        left = i + 1\n        right = n - 1\n\n        while left < right:\n            current_sum = l[i] + l[left] + l[right]\n\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n            else:  # current_sum > 0\n                right -= 1\n\n    return False"}
