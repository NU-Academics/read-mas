{"task_id": "Mbpp/447", "solution": "def cube_nums(input_list):\n    \"\"\"Calculates the cube of each element in a list and returns a new list.\"\"\"\n    return [x ** 3 for x in input_list]"}
{"task_id": "Mbpp/446", "solution": "def count_Occurrence(input_tuple, search_list):\n    \"\"\"\n    Counts the total occurrences of all elements from a search list within an input tuple.\n    \"\"\"\n    total_count = 0\n    for element in search_list:\n        total_count += input_tuple.count(element)\n    return total_count"}
{"task_id": "Mbpp/445", "solution": "```python\ndef index_multiplication(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Perform index-wise multiplication of tuple elements.\n\n    Args:\n        tuple1: Tuple containing nested two-element tuples\n        tuple2: Tuple containing nested two-element tuples\n\n    Returns:\n        Tuple with same structure containing element-wise multiplication results\n    \"\"\"\n    result = []\n    for i in range(len(tuple1)):\n        nested_tuple1 = tuple1[i]\n        nested_tuple2 = tuple2[i]\n        multiplied_nested_tuple = (nested_tuple1[0] * nested_tuple2[0], nested_tuple1[1] * nested_tuple2[1])\n        result.append(multiplied_nested_tuple)\n    return tuple(result)\n```"}
{"task_id": "Mbpp/440", "solution": "import string\nimport re\n\n_ADVERBS = {\n    \"clearly\", \"actually\", \"usually\", \"quickly\", \"slowly\", \"carefully\", \"happily\",\n    \"sadly\", \"really\", \"very\", \"always\", \"often\", \"sometimes\", \"never\", \"well\",\n    \"fast\", \"hard\", \"early\", \"late\", \"just\", \"quite\", \"almost\", \"already\", \"soon\",\n    \"then\", \"there\", \"here\", \"now\", \"today\", \"tomorrow\", \"yesterday\", \"down\", \"up\",\n    \"out\", \"in\", \"away\", \"back\", \"forward\", \"much\", \"little\", \"enough\", \"rather\",\n    \"altogether\"\n}\n\ndef _clean_punctuation(word: str) -> str:\n    \"\"\"Removes leading and trailing punctuation from a word.\"\"\"\n    return word.strip(string.punctuation)\n\ndef _is_adverb(word: str) -> bool:\n    \"\"\"Checks if a cleaned word (case-insensitive) is in the predefined adverb set.\"\"\"\n    return word.lower() in _ADVERBS\n\ndef _tokenize_sentence(sentence: str) -> list[tuple[str, int, int]]:\n    \"\"\"\n    Splits the sentence into words and records their start and end indices.\n    Each token is (word_text, start_index, end_index_exclusive).\n    \"\"\"\n    tokens = []\n    for match in re.finditer(r'\\S+', sentence):\n        tokens.append((match.group(0), match.start(), match.end()))\n    return tokens\n\ndef _calculate_positions(word: str, sentence: str, start: int) -> tuple[int, int]:\n    \"\"\"\n    Calculates the start and end positions of the cleaned adverb.\n    The 'sentence' parameter is kept for signature compliance but is not used internally.\n    \"\"\"\n    start_pos = start\n    end_pos = start + len(word)\n    return (start_pos, end_pos)\n\ndef find_adverb_position(sentence: str) -> tuple[int, int, str] | None:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    Returns (start_position, end_position, adverb_text) or None if no adverb is found.\n    \"\"\"\n    tokens = _tokenize_sentence(sentence)\n\n    for full_word_text, full_word_start_index, _ in tokens:\n        cleaned_word = _clean_punctuation(full_word_text)\n        if _is_adverb(cleaned_word):\n            start_pos, end_pos = _calculate_positions(cleaned_word, sentence, full_word_start_index)\n            return (start_pos, end_pos, cleaned_word)\n\n    return None"}
{"task_id": "Mbpp/448", "solution": "def cal_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of Perrin numbers from P(0) to P(n).\n    Perrin sequence starts with P(0)=3, P(1)=0, P(2)=2, and P(k) = P(k-2) + P(k-3) for k > 2.\n    \"\"\"\n    if n == 0:\n        return 3\n    if n == 1:\n        return 3  # P(0) + P(1) = 3 + 0\n    if n == 2:\n        return 5  # P(0) + P(1) + P(2) = 3 + 0 + 2\n\n    # For n >= 3, use an iterative approach to calculate numbers and their sum\n    p_minus_3 = 3  # Corresponds to P(i-3)\n    p_minus_2 = 0  # Corresponds to P(i-2)\n    p_minus_1 = 2  # Corresponds to P(i-1)\n    \n    current_sum = 5  # Sum of P(0), P(1), P(2)\n\n    for i in range(3, n + 1):\n        # Calculate P(i) using the recurrence relation\n        p_i = p_minus_3 + p_minus_2\n        current_sum += p_i\n        \n        # Update the values for the next iteration\n        p_minus_3 = p_minus_2\n        p_minus_2 = p_minus_1\n        p_minus_1 = p_i\n        \n    return current_sum"}
{"task_id": "Mbpp/450", "solution": "def extract_string(string_list: list, size: int) -> list:\n    \"\"\"\n    Extracts strings of a specified length from a list of strings.\n    Returns a new list containing only strings with length equal to the specified size.\n    \"\"\"\n    return [s for s in string_list if len(s) == size]"}
{"task_id": "Mbpp/451", "solution": "def remove_whitespaces(input_string: str) -> str:\n    \"\"\"Removes all whitespace characters from the given string.\"\"\"\n    return \"\".join(char for char in input_string if not char.isspace())"}
{"task_id": "Mbpp/453", "solution": "def sumofFactors(number: int) -> int:\n    \"\"\"Main function to calculate sum of even factors of a number.\"\"\"\n\n    def find_factors(num: int) -> list[int]:\n        \"\"\"Helper function to find all factors of a number.\"\"\"\n        factors = []\n        for i in range(1, num + 1):\n            if num % i == 0:\n                factors.append(i)\n        return factors\n\n    def filter_even_factors(factor_list: list[int]) -> list[int]:\n        \"\"\"Helper function to filter even factors from a list of factors.\"\"\"\n        return [f for f in factor_list if f % 2 == 0]\n\n    def calculate_sum(factor_list: list[int]) -> int:\n        \"\"\"Helper function to calculate the sum of a list of numbers.\"\"\"\n        return sum(factor_list)\n\n    all_factors = find_factors(number)\n    even_factors = filter_even_factors(all_factors)\n    return calculate_sum(even_factors)"}
{"task_id": "Mbpp/456", "solution": "def reverse_string_list(string_list: list[str]) -> list[str]:\n    \"\"\"\n    Reverses each string in the given list of string values.\n    Returns a new list with the reversed strings.\n    \"\"\"\n    reversed_strings = []\n    for s in string_list:\n        reversed_strings.append(s[::-1])\n    return reversed_strings"}
{"task_id": "Mbpp/455", "solution": "def check_monthnumb_number(month_number):\n    \"\"\"\n    Checks if the given month number corresponds to a month with 31 days.\n    \"\"\"\n    months_with_31_days = {1, 3, 5, 7, 8, 10, 12}\n    return month_number in months_with_31_days"}
{"task_id": "Mbpp/458", "solution": "def rectangle_area(length, width):\n    \"\"\"\n    Calculates the area of a rectangle given its length and width.\n    The area is computed as the product of length and width.\n    \"\"\"\n    return length * width"}
{"task_id": "Mbpp/457", "solution": "def Find_Min(input_list):\n    \"\"\"\n    Finds the sublist with the minimum length from a list of sublists.\n    If multiple sublists have the same minimum length, the first one encountered is returned.\n    \"\"\"\n    if not input_list:\n        return [] # Or raise an error, but requirements say no exception handling. Returning empty list as a safe default.\n    return min(input_list, key=len)"}
{"task_id": "Mbpp/454", "solution": "import string\n\ndef text_match_wordz(input_string: str) -> bool:\n    \"\"\"\n    Checks if any word in the input string contains the lowercase character 'z'.\n    Punctuation marks are treated as word separators.\n    \"\"\"\n\n    def _extract_words(text: str) -> list[str]:\n        # Replace punctuation with spaces to separate words clearly.\n        processed_text = text\n        for char in string.punctuation:\n            processed_text = processed_text.replace(char, ' ')\n        # Split by spaces and filter out any empty strings.\n        return [word for word in processed_text.split() if word]\n\n    def _contains_z(word: str) -> bool:\n        # Checks if the word contains the lowercase 'z' (case-sensitive).\n        return 'z' in word\n\n    words = _extract_words(input_string)\n\n    for word in words:\n        if _contains_z(word):\n            return True\n            \n    return False"}
{"task_id": "Mbpp/460", "solution": "def Extract(input_list):\n    \"\"\"\n    Extract the first element from each sublist.\n\n    Args:\n        input_list: List of sublists\n\n    Returns:\n        List containing the first element from each sublist\n    \"\"\"\n    return [sublist[0] for sublist in input_list]"}
