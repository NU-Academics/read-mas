{"task_id": "Mbpp/113", "solution": "def _is_empty_or_whitespace(s: str) -> bool:\n    \"\"\"Check if string is empty or contains only whitespace.\"\"\"\n    return not s.strip()\n\ndef _is_valid_integer_format(s: str) -> bool:\n    \"\"\"Validate integer format including sign and numeric characters.\"\"\"\n    if not s:\n        return False\n\n    start_index = 0\n    if s[0] == '-' or s[0] == '+':\n        start_index = 1\n\n    # If only a sign or an empty string after sign, it's not a valid integer.\n    if len(s) == start_index:\n        return False\n\n    return s[start_index:].isdigit()\n\ndef check_integer(input_string: str) -> bool:\n    \"\"\"Check if a string represents a valid integer.\"\"\"\n    if _is_empty_or_whitespace(input_string):\n        return False\n    return _is_valid_integer_format(input_string)"}
{"task_id": "Mbpp/119", "solution": "def search(array: list[int]) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where all other elements appear in pairs.\n    It iterates through the array in steps of two, comparing adjacent elements.\n    \"\"\"\n    n = len(array)\n    for i in range(0, n, 2):\n        # If we are at the last element, it must be the unique one.\n        if i + 1 == n:\n            return array[i]\n        # If the current element is not equal to the next one,\n        # then the current element is the unique one.\n        if array[i] != array[i+1]:\n            return array[i]"}
