{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, target_character: str) -> str:\n    \"\"\"Removes the first and last occurrences of a given character from the string.\"\"\"\n    first_index = input_string.find(target_character)\n\n    if first_index == -1:\n        return input_string\n\n    last_index = input_string.rfind(target_character)\n\n    # If first_index and last_index are the same, the character appears only once.\n    # In this case, we remove that single occurrence.\n    if first_index == last_index:\n        return input_string[:first_index] + input_string[first_index + 1:]\n    else:\n        # Remove the character at first_index and last_index\n        return input_string[:first_index] + \\\n               input_string[first_index + 1 : last_index] + \\\n               input_string[last_index + 1 :]"}
{"task_id": "Mbpp/7", "solution": "def find_char_long(input_string: str) -> set[str]:\n    \"\"\"\n    Finds all words which are at least 4 characters long in a string.\n    Splits the string by whitespace and filters words based on length.\n    \"\"\"\n    words = input_string.split()\n    long_words = set()\n    for word in words:\n        if len(word) >= 4:\n            long_words.add(word)\n    return long_words"}
{"task_id": "Mbpp/2", "solution": "from typing import Collection, Any, Set\ndef similar_elements(list1: Collection[Any], list2: Collection[Any]) -> Set[Any]:\n    \"\"\"\n    Finds the unique shared elements between two given collections.\n    Returns a set containing elements that are present in both list1 and list2.\n    \"\"\"\n    return set(list1).intersection(set(list2))"}
{"task_id": "Mbpp/8", "solution": "def square_nums(numbers: list) -> list:\n    \"\"\"Calculates the square of each number in the input list.\n\n    Args:\n        numbers: A list of numerical values (integers or floats).\n\n    Returns:\n        A new list containing the square of each number from the input list.\n    \"\"\"\n    return [number * number for number in numbers]"}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(number: int) -> bool:\n    \"\"\"\n    Determines if a given integer is a non-prime number.\n    Returns True for non-prime numbers, False for prime numbers.\n    \"\"\"\n    if number < 2:\n        return True  # Numbers less than 2 are not prime (and thus non-prime for the purpose of this function)\n    if number == 2:\n        return False  # 2 is prime\n    if number % 2 == 0:\n        return True  # Even numbers greater than 2 are non-prime\n\n    # Check for odd divisors from 3 up to the square root of the number\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return True  # Found a divisor, so it's non-prime\n        i += 2\n    return False  # No divisors found, so it's prime"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks if two integer numbers differ at exactly one bit position.\n    A number differs at exactly one bit position if its XOR result is a power of 2.\n    \"\"\"\n    xor_result = num1 ^ num2\n    return xor_result > 0 and (xor_result & (xor_result - 1)) == 0"}
{"task_id": "Mbpp/4", "solution": "import heapq\ndef heap_queue_largest(numbers: list[int], n: int) -> list[int]:\n    \"\"\"\n    Finds the n largest integers from a list and returns them in descending order.\n    Utilizes the heapq module for efficient retrieval.\n    \"\"\"\n    largest_elements = heapq.nlargest(n, numbers)\n    largest_elements.sort(reverse=True)\n    return largest_elements"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(input_string: str) -> int:\n    \"\"\"\n    Calculates the minimum number of rotations (greater than 0)\n    required for a given input string to return to its original state.\n    \"\"\"\n    n = len(input_string)\n    if n == 0:\n        return 0\n\n    # If all characters are identical, one rotation is sufficient (as per requirement \"aaaa\" == 1).\n    if len(set(input_string)) == 1:\n        return 1\n\n    # Concatenate the string with itself to easily check all rotations.\n    temp = input_string + input_string\n\n    # Iterate through possible rotation points starting from 1.\n    for i in range(1, n + 1):\n        # Check if the rotated substring matches the original string.\n        if temp[i : i + n] == input_string:\n            return i\n\n    # This line should ideally not be reached if the string is non-empty,\n    # as the string will always return to its original state after 'n' rotations.\n    # The loop should find it at 'i=n' if not earlier.\n    return n"}
{"task_id": "Mbpp/16", "solution": "import re\ndef text_lowercase_underscore(input_string: str) -> bool:\n    \"\"\"\n    Returns true if the input string contains sequences of lowercase letters\n    joined with an underscore and false otherwise.\n    \"\"\"\n    pattern = r'[a-z]+_[a-z]+'\n    return bool(re.search(pattern, input_string))"}
