{"task_id": "Mbpp/555", "solution": "def _calculate_sum_of_natural_numbers(n: int) -> int:\n    \"\"\"Calculates the sum of the first n natural numbers using the direct formula.\"\"\"\n    return n * (n + 1) // 2\ndef _calculate_sum_of_cubes(n: int) -> int:\n    \"\"\"Calculates the sum of the cubes of the first n natural numbers using the direct formula.\"\"\"\n    sum_natural = _calculate_sum_of_natural_numbers(n)\n    return sum_natural * sum_natural\ndef difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    sum_natural_numbers = _calculate_sum_of_natural_numbers(n)\n    sum_cubes = _calculate_sum_of_cubes(n)\n    return sum_cubes - sum_natural_numbers"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(input_list,list_length):\n    \"\"\"\n    Counts the number of pairs of integers from a given list whose bitwise XOR value is odd.\n    An XOR value is odd if and only if one integer is odd and the other is even.\n    \"\"\"\n    if list_length < 2:\n        return 0\n\n    odd_count = 0\n    even_count = 0\n\n    for num in input_list:\n        if num % 2 != 0:\n            odd_count += 1\n        else:\n            even_count += 1\n\n    return odd_count * even_count"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string: str) -> str:\n    \"\"\"Toggles the case of all alphabetic characters in a string.\n    Uppercase characters become lowercase, and lowercase characters become uppercase; other characters remain unchanged.\"\"\"\n    toggled_chars = []\n    for char in input_string:\n        if char.islower():\n            toggled_chars.append(char.upper())\n        elif char.isupper():\n            toggled_chars.append(char.lower())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of per-digit differences between two integers.\n    This function orchestrates digit extraction, padding, and difference summation.\n    \"\"\"\n    def _get_digits(num: int) -> list[int]:\n        \"\"\"Converts an integer into a list of its constituent digits.\"\"\"\n        return [int(d) for d in str(num)]\n\n    def _pad_digits(digits1: list[int], digits2: list[int]) -> tuple[list[int], list[int]]:\n        \"\"\"Pads the shorter digit sequence with leading zeros to match the length of the longer sequence.\"\"\"\n        len1 = len(digits1)\n        len2 = len(digits2)\n        max_len = max(len1, len2)\n        padded_digits1 = [0] * (max_len - len1) + digits1\n        padded_digits2 = [0] * (max_len - len2) + digits2\n        return padded_digits1, padded_digits2\n\n    digits1 = _get_digits(num1)\n    digits2 = _get_digits(num2)\n\n    padded_digits1, padded_digits2 = _pad_digits(digits1, digits2)\n\n    total_diff = 0\n    for d1, d2 in zip(padded_digits1, padded_digits2):\n        total_diff += abs(d1 - d2)\n\n    return total_diff"}
