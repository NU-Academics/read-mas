{"task_id": "Mbpp/93", "solution": "class PowerOperation:\n    \"\"\"Encapsulates the power calculation logic.\"\"\"\n    def __init__(self, base: float, exponent: float):\n        self._base = base\n        self._exponent = exponent\n        self._result = None\n\n    def execute(self) -> float:\n        \"\"\"Computes the base raised to the exponent and returns the result.\"\"\"\n        self._result = self._base ** self._exponent\n        return self._result\ndef power(a: float, b: float) -> float:\n    \"\"\"Calculates the value of 'a' raised to the power 'b'.\n\n    Args:\n        a: The base number.\n        b: The exponent.\n    \"\"\"\n    operation = PowerOperation(a, b)\n    return operation.execute()"}
