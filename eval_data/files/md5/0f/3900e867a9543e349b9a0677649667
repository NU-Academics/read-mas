{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(input_list: list) -> Union[int, float]:\n    \"\"\"\n    Flattens a nested list and sums all its numerical elements.\n    Non-numeric, non-list elements are ignored.\n    \"\"\"\n    total_sum = 0\n    for element in input_list:\n        if isinstance(element, list):\n            total_sum += recursive_list_sum(element)\n        elif isinstance(element, (int, float)):\n            total_sum += element\n    return total_sum"}
{"task_id": "Mbpp/57", "solution": "def find_Max_Num(digits: list[int]) -> int:\n    \"\"\"\n    Forms the largest number from a given list of digits.\n    This function sorts digits using a custom comparison to form the largest possible number.\n    \"\"\"\n    if not digits:\n        return 0\n\n    str_digits = [str(d) for d in digits]\n\n    from functools import cmp_to_key\n\n    def compare(a, b):\n        if a + b > b + a:\n            return -1\n        elif a + b < b + a:\n            return 1\n        else:\n            return 0\n\n    str_digits.sort(key=cmp_to_key(compare))\n\n    largest_num_str = \"\".join(str_digits)\n\n    # Handle cases like [0, 0, 0] which should result in 0\n    if largest_num_str and largest_num_str[0] == '0':\n        return 0\n\n    return int(largest_num_str)"}
{"task_id": "Mbpp/59", "solution": "def is_octagonal(n: int) -> int:\n    \"\"\"Calculates the nth octagonal number using the formula n * (3n - 2).\"\"\"\n    if n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n    return n * (3 * n - 2)"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(input_string: str) -> int:\n    \"\"\"\n    Counts the number of substrings in the input_string where the sum of digits equals their length.\n    It iterates through all possible substrings, calculates their length and digit sum, and increments a counter if they match.\n    \"\"\"\n    count = 0\n    n = len(input_string)\n\n    for i in range(n):\n        current_sum = 0\n        for j in range(i, n):\n            # Calculate sum of digits for the current substring input_string[i:j+1]\n            current_sum += int(input_string[j])\n            \n            # Calculate length of the current substring\n            current_length = j - i + 1\n\n            # Check if sum of digits equals length\n            if current_sum == current_length:\n                count += 1\n    return count"}
