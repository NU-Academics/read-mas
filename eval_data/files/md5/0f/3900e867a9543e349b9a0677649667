{"task_id": "Mbpp/71", "solution": "def comb_sort(input_list: list) -> list:\n    \"\"\"Sorts a list of elements in ascending order using the Comb Sort algorithm.\"\"\"\n    n = len(input_list)\n    arr = input_list[:]  # Create a copy to avoid modifying the original list\n\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        gap = int(gap / shrink_factor)\n        if gap < 1:\n            gap = 1\n\n        swapped = False\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    return arr"}
{"task_id": "Mbpp/75", "solution": "def find_tuples(list_of_tuples: list[tuple], k: int) -> list[tuple]:\n    \"\"\"Filters a list of tuples, returning only those where all elements are divisible by k.\"\"\"\n    if k == 0:\n        raise ValueError(\"Divisor k cannot be zero.\")\n\n    filtered_tuples = []\n    for current_tuple in list_of_tuples:\n        # Check if all elements in the current tuple are perfectly divisible by k.\n        if all(element % k == 0 for element in current_tuple):\n            filtered_tuples.append(current_tuple)\n    return filtered_tuples"}
