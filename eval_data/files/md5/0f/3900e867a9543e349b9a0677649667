{"task_id": "Mbpp/301", "solution": "def dict_depth(input_dict: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of a dictionary.\n    The depth is defined as the maximum number of nested dictionaries, with the top-level dictionary having a depth of 1.\n    \"\"\"\n    max_current_depth = 1\n\n    for value in input_dict.values():\n        if isinstance(value, dict):\n            nested_depth = dict_depth(value)\n            max_current_depth = max(max_current_depth, 1 + nested_depth)\n\n    return max_current_depth"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(entries: list[tuple[str, int]]) -> tuple[str, int]:\n    \"\"\"Calculates the maximum aggregate score from a list of name-score tuples.\"\"\"\n    aggregated_scores = {}\n\n    for name, score in entries:\n        aggregated_scores[name] = aggregated_scores.get(name, 0) + score\n\n    max_name = ''\n    max_total_score = 0\n\n    for name, total_score in aggregated_scores.items():\n        if total_score > max_total_score:\n            max_total_score = total_score\n            max_name = name\n\n    return (max_name, max_total_score)"}
{"task_id": "Mbpp/305", "solution": "def start_withp(input_list: list[str]) -> tuple[str, str]:\n    \"\"\"\n    Extracts the first two words starting with 'p' or 'P' from a list of strings.\n    If fewer than two words are found, the tuple will contain empty strings for missing elements.\n    \"\"\"\n    p_words = []\n    for s in input_list:\n        words = s.split()\n        for word in words:\n            if word.lower().startswith('p'):\n                p_words.append(word)\n                if len(p_words) == 2:\n                    return (p_words[0], p_words[1])\n\n    # Handle cases where fewer than two 'p' words are found.\n    return (p_words[0] if len(p_words) > 0 else '', p_words[1] if len(p_words) > 1 else '')"}
