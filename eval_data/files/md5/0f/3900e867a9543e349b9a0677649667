{"task_id": "Mbpp/430", "solution": "class Parabola:\n    \"\"\"Represents a parabola in the form y = ax^2 + bx + c and calculates its directrix.\"\"\"\n\n    def __init__(self, a: float, b: float, c: float) -> None:\n        \"\"\"\n        Initializes the Parabola with coefficients a, b, and c.\n        Raises ValueError if 'a' is zero, as it's not a parabola.\n        \"\"\"\n        if a == 0:\n            raise ValueError(\"Coefficient 'a' cannot be zero for a parabola.\")\n        self._a = a\n        self._b = b\n        self._c = c\n\n    def calculateDirectrixValue(self) -> float:\n        \"\"\"\n        Calculates the directrix value using the formula y = (4ac - b^2 - 1) / (4a).\n        It returns the y-coordinate of the directrix.\n        \"\"\"\n        numerator = (4 * self._a * self._c) - (self._b ** 2) - 1\n        denominator = 4 * self._a\n        return numerator / denominator\ndef parabola_directrix(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Calculates the directrix of a parabola given its coefficients a, b, and c.\n    The parabola is in the form y = ax^2 + bx + c.\n    \"\"\"\n    parabola = Parabola(a, b, c)\n    return parabola.calculateDirectrixValue()"}
{"task_id": "Mbpp/437", "solution": "def remove_odd(input_string: str) -> str:\n    \"\"\"\n    Extracts characters from the input string that are located at odd 0-based indices.\n    Returns a new string composed of these characters, preserving their relative order.\n    \"\"\"\n    result_chars = []\n    for i, char in enumerate(input_string):\n        # 0-based odd indices are 1, 3, 5, ...\n        if i % 2 != 0:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/439", "solution": "def multiple_to_single(integer_list: list[int]) -> int:\n    \"\"\"Joins a list of integers into a single integer.\n\n    Returns 0 if the input list is empty; otherwise, concatenates the integers as a string and converts to an int.\n    \"\"\"\n    if not integer_list:\n        return 0\n    \n    # Convert each integer to its string representation\n    string_parts = [str(num) for num in integer_list]\n    \n    # Join the string parts and convert back to an integer\n    return int(\"\".join(string_parts))"}
{"task_id": "Mbpp/440", "solution": "import string\nimport re\nfrom typing import Optional, Tuple\nADVERB_LIST = [\n    'clearly', 'quickly', 'slowly', 'very', 'always', 'never', 'often',\n    'rarely', 'soon', 'yesterday', 'tomorrow', 'here', 'there', 'everywhere',\n    'inside', 'outside', 'up', 'down', 'well', 'badly', 'happily', 'sadly',\n    'loudly', 'softly', 'much', 'little', 'too', 'enough', 'ago', 'early',\n    'late', 'almost', 'just', 'still', 'yet', 'already', 'rather',\n    'quite', 'hardly', 'scarcely', 'barely', 'only', 'even', 'actually',\n    'probably', 'possibly', 'maybe', 'perhaps', 'certainly', 'definitely',\n    'surely', 'truly', 'really', 'extremely', 'terribly', 'absolutely',\n    'completely', 'entirely', 'fully', 'generally', 'usually', 'normally',\n    'frequently', 'sometimes', 'occasionally', 'seldom', 'daily', 'weekly',\n    'monthly', 'yearly', 'annually', 'hourly', 'eventually', 'finally',\n    'initially', 'firstly', 'secondly', 'thirdly', 'lastly', 'accordingly',\n    'consequently', 'therefore', 'thus', 'hence', 'otherwise', 'instead',\n    'also', 'as well', 'besides', 'moreover', 'furthermore',\n    'however', 'nevertheless', 'nonetheless', 'conversely', 'similarly',\n    'likewise', 'meanwhile', 'subsequently'\n]\ndef _clean_word(word_text: str) -> str:\n    \"\"\"Removes leading/trailing punctuation from a word string.\"\"\"\n    return word_text.strip(string.punctuation)\ndef find_adverb_position(sentence: str) -> Optional[Tuple[int, int, str]]:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    Returns (start_index, end_index, adverb_text) or None if no adverb is found.\n    \"\"\"\n    for match in re.finditer(r'\\S+', sentence):\n        word_text = match.group(0)\n        start_index = match.start()\n        end_index = match.end()\n\n        cleaned_word = _clean_word(word_text)\n        \n        if cleaned_word.lower() in ADVERB_LIST:\n            return (start_index, end_index, cleaned_word)\n            \n    return None"}
{"task_id": "Mbpp/441", "solution": "def surfacearea_cube(side_length: float) -> float:\n    \"\"\"Calculates the surface area of a cube given its side length.\"\"\"\n    if side_length < 0:\n        raise ValueError(\"Side length must be non-negative\")\n    return 6 * (side_length ** 2)"}
{"task_id": "Mbpp/446", "solution": "def count_Occurrence(input_tuple: tuple, search_list: list) -> int:\n    \"\"\"Counts the total occurrences of elements from search_list within input_tuple.\n    It iterates through the tuple, incrementing a counter for each element found in the search list.\"\"\"\n    count = 0\n    for element in input_tuple:\n        if element in search_list:\n            count += 1\n    return count"}
{"task_id": "Mbpp/448", "solution": "class PerrinNumber:\n    \"\"\"Represents a single Perrin number with its index and value.\"\"\"\n    def __init__(self, index: int, value: int):\n        self.index = index\n        self.value = value\nclass PerrinSequence:\n    \"\"\"Generates and manages the sequence of Perrin numbers up to a given index.\"\"\"\n    def __init__(self):\n        self._numbers = []\n\n    def generate_sequence(self, n: int) -> None:\n        \"\"\"Generates Perrin numbers from P(0) to P(n) and stores them internally.\"\"\"\n        if n < 0:\n            return\n\n        if n >= 0:\n            self._numbers.append(PerrinNumber(0, 3))\n        if n >= 1:\n            self._numbers.append(PerrinNumber(1, 0))\n        if n >= 2:\n            self._numbers.append(PerrinNumber(2, 2))\n\n        for i in range(3, n + 1):\n            pn_2 = self._numbers[i-2].value\n            pn_3 = self._numbers[i-3].value\n            self._numbers.append(PerrinNumber(i, pn_2 + pn_3))\n\n    def get_numbers(self) -> list[PerrinNumber]:\n        \"\"\"Returns the list of generated PerrinNumber objects.\"\"\"\n        return self._numbers\ndef cal_sum(n: int) -> int:\n    \"\"\"Calculates and returns the sum of Perrin numbers from P(0) to P(n).\"\"\"\n    if n < 0:\n        return 0 # Perrin numbers are typically defined for non-negative indices.\n\n    sequence_generator = PerrinSequence()\n    sequence_generator.generate_sequence(n)\n    \n    total_sum = 0\n    for perrin_num in sequence_generator.get_numbers():\n        total_sum += perrin_num.value\n        \n    return total_sum"}
{"task_id": "Mbpp/445", "solution": "def index_multiplication(tuple1: tuple[tuple[int | float, int | float], ...],\n                             tuple2: tuple[tuple[int | float, int | float], ...]) -> tuple[tuple[int | float, int | float], ...]:\n    \"\"\"\n    Performs index-wise multiplication of elements from two input tuples of tuples.\n    Each inner tuple in the result contains the product of corresponding elements from the input inner tuples.\n    \"\"\"\n    return tuple((t1_elem1 * t2_elem1, t1_elem2 * t2_elem2)\n                 for (t1_elem1, t1_elem2), (t2_elem1, t2_elem2) in zip(tuple1, tuple2))"}
{"task_id": "Mbpp/451", "solution": "def remove_whitespaces(input_string: str) -> str:\n    \"\"\"Removes all whitespace characters from the given input string.\"\"\"\n    return ''.join(char for char in input_string if not char.isspace())"}
{"task_id": "Mbpp/450", "solution": "def extract_string(string_list: list[str], length: int) -> list[str]:\n    \"\"\"\n    Extracts strings of a specified length from a given list of string values.\n    Returns a new list containing only the strings that match the specified length.\n    \"\"\"\n    result_list = []\n    for s in string_list:\n        if len(s) == length:\n            result_list.append(s)\n    return result_list"}
