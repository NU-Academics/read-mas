{"task_id": "Mbpp/721", "solution": "def maxAverageOfPath(matrix_data: List[List[int]]) -> float:\n    \"\"\"Calculates the maximum average cost among all valid paths in a square matrix, moving only right or down.\n    Returns the maximum average cost as a float.\n    \"\"\"\n    from typing import List\n\n    class Cell:\n        def __init__(self, row: int, column: int, cost: int):\n            self.row = row\n            self.column = column\n            self.cost = cost\n\n    class Path:\n        def __init__(self, cells: List[Cell]):\n            self.cells = cells\n            self.total_cost: int = 0\n            self.number_of_cells: int = 0\n            self.average_cost: float = 0.0\n\n        def calculate_metrics(self) -> None:\n            self.total_cost = sum(cell.cost for cell in self.cells)\n            self.number_of_cells = len(self.cells)\n            if self.number_of_cells > 0:\n                self.average_cost = float(self.total_cost) / self.number_of_cells\n            else:\n                self.average_cost = 0.0\n\n    class Matrix:\n        def __init__(self, matrix_data: List[List[int]]):\n            self.N = len(matrix_data)\n            self.cells: List[List[Cell]] = []\n            for r_idx, row_data in enumerate(matrix_data):\n                current_row_cells = []\n                for c_idx, cost_val in enumerate(row_data):\n                    current_row_cells.append(Cell(r_idx, c_idx, cost_val))\n                self.cells.append(current_row_cells)\n\n        def get_cell(self, row: int, col: int) -> Cell:\n            return self.cells[row][col]\n\n    def _find_all_paths_recursive(\n        matrix_obj: Matrix,\n        current_row: int,\n        current_col: int,\n        current_path_cells: List[Cell],\n        all_paths_list: List[Path]\n    ) -> None:\n        current_path_cells.append(matrix_obj.get_cell(current_row, current_col))\n\n        if current_row == matrix_obj.N - 1 and current_col == matrix_obj.N - 1:\n            all_paths_list.append(Path(list(current_path_cells)))\n            current_path_cells.pop()\n            return\n\n        if current_col + 1 < matrix_obj.N:\n            _find_all_paths_recursive(matrix_obj, current_row, current_col + 1, current_path_cells, all_paths_list)\n\n        if current_row + 1 < matrix_obj.N:\n            _find_all_paths_recursive(matrix_obj, current_row + 1, current_col, current_path_cells, all_paths_list)\n\n        current_path_cells.pop()\n\n    def find_all_paths(matrix_obj: Matrix) -> List[Path]:\n        all_paths_list: List[Path] = []\n        if matrix_obj.N == 0:\n            return []\n        _find_all_paths_recursive(matrix_obj, 0, 0, [], all_paths_list)\n        return all_paths_list\n\n    def calculate_path_metrics(paths_list: List[Path]) -> None:\n        for path in paths_list:\n            path.calculate_metrics()\n\n    def find_max_average_path(paths_list: List[Path]) -> float:\n        if not paths_list:\n            return 0.0\n\n        max_avg = float('-inf')\n        for path in paths_list:\n            if path.average_cost > max_avg:\n                max_avg = path.average_cost\n        return max_avg\n\n    matrix = Matrix(matrix_data)\n    all_paths = find_all_paths(matrix)\n    calculate_path_metrics(all_paths)\n    max_avg_cost = find_max_average_path(all_paths)\n    return max_avg_cost"}
{"task_id": "Mbpp/728", "solution": "def sum_list(input_list1: list[int], input_list2: list[int]) -> list[int]:\n    \"\"\"\n    Calculates the element-wise sum of two lists of integers.\n    Raises ValueError if input lists have different lengths.\n    \"\"\"\n    if len(input_list1) != len(input_list2):\n        raise ValueError(\"Input lists must have the same number of elements.\")\n\n    summed_list = []\n    for i in range(len(input_list1)):\n        summed_list.append(input_list1[i] + input_list2[i])\n    return summed_list"}
