{"task_id": "Mbpp/67", "solution": "def _binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient 'n choose k'.\"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n\n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\ndef bell_number(n: int) -> int:\n    \"\"\"\n    Computes the n-th Bell number, B(n),\n    representing the number of ways to partition a set of n elements.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    bell_numbers_memo = [0] * (n + 1)\n    bell_numbers_memo[0] = 1  # Base case: B(0) = 1\n\n    # Calculate B(i) for i from 1 to n using the recurrence relation\n    # B(i) = sum_{k=0}^{i-1} C(i-1, k) * B(k)\n    for i in range(1, n + 1):\n        current_bell = 0\n        for k in range(i):\n            coeff = _binomial_coefficient(i - 1, k)\n            current_bell += coeff * bell_numbers_memo[k]\n        bell_numbers_memo[i] = current_bell\n\n    return bell_numbers_memo[n]"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list: list, sub_list: list) -> bool:\n    \"\"\"Checks if sub_list is a contiguous sublist of main_list.\"\"\"\n    if not sub_list:\n        return True\n\n    # If sub_list is not empty but main_list is shorter, it cannot be a sublist.\n    if len(sub_list) > len(main_list):\n        return False\n\n    for i in range(len(main_list) - len(sub_list) + 1):\n        if main_list[i:i + len(sub_list)] == sub_list:\n            return True\n    return False"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array: list) -> bool:\n    \"\"\"\n    Checks if the given array is monotonic (either increasing or decreasing).\n    \"\"\"\n\n    def _is_increasing(arr: list) -> bool:\n        \"\"\"\n        Determines if the array is monotonically increasing.\n        \"\"\"\n        for i in range(len(arr) - 1):\n            if arr[i] > arr[i+1]:\n                return False\n        return True\n\n    def _is_decreasing(arr: list) -> bool:\n        \"\"\"\n        Determines if the array is monotonically decreasing.\n        \"\"\"\n        for i in range(len(arr) - 1):\n            if arr[i] < arr[i+1]:\n                return False\n        return True\n\n    return _is_increasing(array) or _is_decreasing(array)"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(sequence_list, pattern_list):\n    \"\"\"\n    Checks if the given sequence follows the pattern.\n    A one-to-one mapping must exist between unique elements of the pattern and sequence.\n    \"\"\"\n    if len(sequence_list) != len(pattern_list):\n        return False\n\n    pattern_to_sequence_map = {}\n    sequence_to_pattern_map = {}\n\n    for i in range(len(sequence_list)):\n        s_elem = sequence_list[i]\n        p_elem = pattern_list[i]\n\n        # Check mapping from pattern to sequence\n        if p_elem in pattern_to_sequence_map:\n            if pattern_to_sequence_map[p_elem] != s_elem:\n                return False\n        else:\n            pattern_to_sequence_map[p_elem] = s_elem\n\n        # Check mapping from sequence to pattern\n        if s_elem in sequence_to_pattern_map:\n            if sequence_to_pattern_map[s_elem] != p_elem:\n                return False\n        else:\n            sequence_to_pattern_map[s_elem] = p_elem\n\n    return True"}
