{"task_id": "Mbpp/793", "solution": "from typing import List, Any\ndef last(array: List[Any], element: Any) -> int:\n    \"\"\"\n    Finds the last position of an element in a sorted array using a binary search variant.\n    Returns the highest index of the element if found, otherwise -1.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    last_occurrence = -1\n\n    while low <= high:\n        mid = (low + high) // 2\n        if array[mid] == element:\n            last_occurrence = mid  # Found a potential last occurrence\n            low = mid + 1          # Try to find an even later occurrence in the right half\n        elif array[mid] < element:\n            low = mid + 1\n        else:  # array[mid] > element\n            high = mid - 1\n    return last_occurrence"}
{"task_id": "Mbpp/796", "solution": "def return_sum(input_dict: dict) -> float:\n    \"\"\"Calculates the sum of all numeric values in the given dictionary.\n    Non-numeric values are ignored.\n    \"\"\"\n    total = 0.0\n    for value in input_dict.values():\n        if isinstance(value, (int, float)):\n            total += value\n    return total"}
{"task_id": "Mbpp/797", "solution": "def sum_in_range(l: int, r: int) -> int:\n    \"\"\"\n    Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n    Natural numbers are positive integers (> 0).\n    \"\"\"\n    current_sum = 0\n    # Determine the effective start of the loop, ensuring numbers are natural (> 0).\n    start = max(1, l)\n\n    for num in range(start, r + 1):\n        # Check if the number is odd.\n        if num % 2 != 0:\n            current_sum += num\n    return current_sum"}
