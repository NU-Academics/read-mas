{"task_id": "Mbpp/731", "solution": "import math\ndef lateralsurface_cone(r,h):\n    \"\"\"\n    Calculates the lateral surface area of a cone.\n    This function uses the formula A = pi * r * l, where l is the slant height.\n    \"\"\"\n    slant_height = math.sqrt(r**2 + h**2)\n    lateral_surface_area = math.pi * r * slant_height\n    return lateral_surface_area"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(input_list: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists of a given list.\n    It iterates through all possible sublists, computes their products, and sums them up.\n    \"\"\"\n    total_sum = 0\n    n = len(input_list)\n\n    for i in range(n):\n        current_product = 1\n        for j in range(i, n):\n            current_product *= input_list[j]\n            total_sum += current_product\n\n    return total_sum"}
{"task_id": "Mbpp/737", "solution": "import re\ndef check_str(input_string: str) -> bool:\n    \"\"\"Checks if the given string starts with a vowel (a, e, i, o, u), ignoring case,\n    using regular expressions.\"\"\"\n    if not input_string:\n        return False\n    \n    # Pattern matches any of 'a', 'e', 'i', 'o', 'u' at the beginning of the string.\n    pattern = r\"^[aeiou]\"\n    return bool(re.match(pattern, input_string, re.IGNORECASE))"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"\n    Toggles all bits of the number except the first (MSB) and the last (LSB) bit.\n    Handles the edge case of 0 and 1 bit numbers by returning the number itself.\n    \"\"\"\n    if number == 0:\n        return 0\n\n    # Determine the number of bits in the input number\n    num_bits = number.bit_length()\n\n    # If the number has 1 or 2 bits, there are no \"middle\" bits to toggle.\n    # For a 1-bit number, MSB and LSB are the same.\n    # For a 2-bit number, MSB and LSB are adjacent, no middle bits.\n    if num_bits <= 2:\n        return number\n\n    # Create a mask with all bits set to 1 for the length of the number.\n    # E.g., for num_bits = 4, all_ones = 0b1111 = 15\n    all_ones = (1 << num_bits) - 1\n\n    # Create a mask to clear the MSB and LSB.\n    # MSB mask: 1 << (num_bits - 1)\n    # LSB mask: 1\n    # Combined: (1 << (num_bits - 1)) | 1\n    # Example for 4 bits: 0b1000 | 0b0001 = 0b1001\n    msb_lsb_mask = (1 << (num_bits - 1)) | 1\n\n    # Create the toggling mask. This mask will have 1s for middle bits and 0s for MSB and LSB.\n    # It's 'all_ones' XORed with 'msb_lsb_mask'.\n    # For 4 bits (0b1111 ^ 0b1001) = 0b0110 (this is the mask to toggle middle bits)\n    toggle_mask = all_ones ^ msb_lsb_mask\n\n    # Toggle the middle bits of the number.\n    # The number's MSB and LSB are preserved because the toggle_mask has 0s at those positions.\n    # For 9 (0b1001) and toggle_mask (0b0110):\n    # 0b1001 ^ 0b0110 = 0b1111 = 15\n    return number ^ toggle_mask"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(arr: list[int], target: int) -> int:\n    \"\"\"\n    Finds the 0-based index of the first occurrence of a given number in a sorted array.\n    Returns -1 if the target number is not found.\n    \"\"\"\n    low, high = 0, len(arr) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == target:\n            result = mid\n            high = mid - 1  # Search in the left half for an earlier occurrence\n        elif arr[mid] < target:\n            low = mid + 1\n        else:  # arr[mid] > target\n            high = mid - 1\n\n    return result"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sorted_list: list[float | int], value: float | int) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted list.\n    This is the index where the value would be inserted to maintain sorted order, prioritizing the leftmost position for duplicates.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
