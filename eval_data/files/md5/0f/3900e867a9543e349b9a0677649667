{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip_address_str: str) -> str:\n    \"\"\"\n    Removes leading zeros from each octet of an IP address string.\n    \"\"\"\n    class Octet:\n        def __init__(self, raw_value: str):\n            \"\"\"\n            Initializes an Octet object and processes its value to remove leading zeros.\n            \"\"\"\n            self._original_octet_value = raw_value\n            self._processed_octet_value = self._remove_leading_zeros_logic(raw_value)\n\n        def _remove_leading_zeros_logic(self, value: str) -> str:\n            \"\"\"\n            Internal logic to remove leading zeros from a single octet string.\n            \"\"\"\n            return str(int(value))\n\n        def get_processed_value(self) -> str:\n            \"\"\"\n            Returns the octet string with leading zeros removed.\n            \"\"\"\n            return self._processed_octet_value\n\n    class IPAddress:\n        def __init__(self, ip_address_str: str):\n            \"\"\"\n            Initializes an IPAddress object by parsing the input string into Octets.\n            \"\"\"\n            self._original_ip_address = ip_address_str\n            self._octets = []\n            for octet_str in ip_address_str.split('.'):\n                self._octets.append(Octet(octet_str))\n\n        def remove_leading_zeros(self) -> str:\n            \"\"\"\n            Processes each octet to remove leading zeros and returns the reassembled IP address string.\n            \"\"\"\n            processed_octet_values = [octet.get_processed_value() for octet in self._octets]\n            return \".\".join(processed_octet_values)\n\n    ip = IPAddress(ip_address_str)\n    return ip.remove_leading_zeros()"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers: list) -> int:\n    \"\"\"\n    Finds the absolute difference between the first even and first odd number\n    in a list, iterating from left to right.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n\n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is None or first_odd is None:\n        raise ValueError(\"The list must contain at least one even and one odd number.\")\n\n    return abs(first_even - first_odd)"}
{"task_id": "Mbpp/592", "solution": "import math\nclass BinomialCoefficient:\n    \"\"\"Calculates a single binomial coefficient C(n, k).\"\"\"\n    def __init__(self, n: int, k: int):\n        self._n = n\n        self._k = k\n\n    def calculate_value(self) -> int:\n        \"\"\"Computes and returns the binomial coefficient C(n, k), returning 0 for out-of-bounds k.\"\"\"\n        if self._k < 0 or self._k > self._n:\n            return 0\n        return math.factorial(self._n) // (math.factorial(self._k) * math.factorial(self._n - self._k))\ndef sum_Of_product(n: int) -> int:\n    \"\"\"Finds the sum of the product of consecutive binomial co-efficients C(n, k) * C(n, k+1).\"\"\"\n    total_sum = 0\n    for k in range(n):\n        # Calculate C(n, k)\n        value_ck = BinomialCoefficient(n, k).calculate_value()\n        # Calculate C(n, k+1)\n        value_ck_plus_1 = BinomialCoefficient(n, k + 1).calculate_value()\n        total_sum += (value_ck * value_ck_plus_1)\n    return total_sum"}
