{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"Finds the maximum run of uppercase characters in the given string.\n\n    Args:\n        input_string: The string to analyze.\n\n    Returns:\n        The maximum length of consecutive uppercase characters.\n    \"\"\"\n    max_length = 0\n    current_length = 0\n    for char in input_string:\n        if char.isupper():\n            current_length += 1\n        else:\n            max_length = max(max_length, current_length)\n            current_length = 0\n    # Final check for a run at the end of the string\n    max_length = max(max_length, current_length)\n    return max_length"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(tuple1: tuple, tuple2: tuple) -> bool:\n    \"\"\"\n    Checks if each element of the second tuple is strictly smaller than its\n    corresponding element in the first tuple.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        return False\n\n    for i in range(len(tuple1)):\n        if not (tuple2[i] < tuple1[i]):\n            return False\n\n    return True"}
{"task_id": "Mbpp/807", "solution": "def is_odd(number: int) -> bool:\n    \"\"\"Checks if a given integer is odd.\"\"\"\n    return number % 2 != 0\ndef first_odd(numbers: list[int]) -> int | None:\n    \"\"\"Finds the first odd number in a given list of numbers.\"\"\"\n    for num in numbers:\n        if is_odd(num):\n            return num\n    return None"}
