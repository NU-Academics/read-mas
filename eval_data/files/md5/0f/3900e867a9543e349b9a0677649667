{"task_id": "Mbpp/462", "solution": "def combinations_list(input_list: list) -> list[list]:\n    \"\"\"\n    Generates all possible combinations of elements from the input list, including the empty list.\n    New combinations are formed by prepending each element to previously generated combinations,\n    ensuring a specific output order.\n    \"\"\"\n    all_combinations = [[]]\n\n    for element in input_list:\n        # Store combinations present before processing the current element.\n        # This prevents modifying the list while iterating over it in the next step.\n        current_combinations_snapshot = list(all_combinations)\n        \n        # For each existing combination, create a new one by prepending the current element.\n        for existing_combination in current_combinations_snapshot:\n            new_combination = [element] + existing_combination\n            all_combinations.append(new_combination)\n            \n    return all_combinations"}
{"task_id": "Mbpp/468", "solution": "def max_product(array: list[int]) -> int:\n    \"\"\"Calculates the maximum product formed by multiplying numbers of an increasing subsequence.\n\n    Returns 0 if the array is empty. Otherwise, it uses dynamic programming to find the maximum product.\n    \"\"\"\n    if not array:\n        return 0\n\n    n = len(array)\n    dp = [0] * n\n\n    for i in range(n):\n        dp[i] = array[i]\n\n    for i in range(n):\n        for j in range(i):\n            if array[i] > array[j]:\n                dp[i] = max(dp[i], dp[j] * array[i])\n\n    return max(dp)"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(arr: list[int]) -> int:\n    \"\"\"Calculates the maximum product of a contiguous subarray.\n\n    Args:\n        arr: A list of integers.\n\n    Returns:\n        The maximum product of a contiguous subarray.\n    \"\"\"\n    max_so_far = arr[0]\n    min_so_far = arr[0]\n    result = arr[0]\n\n    for i in range(1, len(arr)):\n        num = arr[i]\n        \n        # store the current max_so_far because min_so_far calculation needs it before it's updated\n        temp_max_prev = max_so_far \n\n        max_so_far = max(num, num * temp_max_prev, num * min_so_far)\n        min_so_far = min(num, num * temp_max_prev, num * min_so_far)\n        \n        result = max(result, max_so_far)\n    \n    return result"}
{"task_id": "Mbpp/473", "solution": "def tuple_intersection(list1, list2):\n    \"\"\"\n    Finds the tuple intersection of elements in the given tuple list irrespective of their order.\n    Normalizes tuples by sorting elements to enable order-agnostic comparison.\n    \"\"\"\n    def _normalize_tuple(t):\n        \"\"\"Converts a tuple into a canonical, order-agnostic representation by sorting its elements.\"\"\"\n        return tuple(sorted(t))\n\n    normalized_set1 = {_normalize_tuple(t) for t in list1}\n    normalized_set2 = {_normalize_tuple(t) for t in list2}\n\n    return normalized_set1.intersection(normalized_set2)"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple: tuple) -> tuple:\n    \"\"\"Calculates the pairwise addition of neighboring elements of the given tuple.\n    Returns an empty tuple for inputs with less than two elements, and raises TypeError for invalid input types or non-numerical elements.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    if len(input_tuple) < 2:\n        return ()\n\n    result_list = []\n    for i in range(len(input_tuple) - 1):\n        val1 = input_tuple[i]\n        val2 = input_tuple[i+1]\n        if not isinstance(val1, (int, float)) or not isinstance(val2, (int, float)):\n            raise TypeError(\"Tuple elements must be numerical (int or float).\")\n        result_list.append(val1 + val2)\n\n    return tuple(result_list)"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(input_list):\n    \"\"\"\n    Checks if the given list contains consecutive numbers after sorting.\n    Returns True for empty or single-element lists.\n    \"\"\"\n    if len(input_list) <= 1:\n        return True\n\n    sorted_list = sorted(input_list)\n\n    for i in range(1, len(sorted_list)):\n        if sorted_list[i] != sorted_list[i-1] + 1:\n            return False\n\n    return True"}
