{"task_id": "Mbpp/739", "solution": "def find_Index(n: int) -> int:\n    \"\"\"Finds the index of the smallest triangular number with n digits.\"\"\"\n    import math\n\n    def _calculate_triangular_number(k: int) -> int:\n        \"\"\"Calculates the k-th triangular number.\"\"\"\n        return k * (k + 1) // 2\n\n    def _count_digits(num: int) -> int:\n        \"\"\"Counts the number of digits in a non-negative integer.\"\"\"\n        if num == 0:\n            return 1\n        return int(math.log10(num)) + 1\n\n    lower_bound = 10**(n - 1)\n\n    k = 1\n    while True:\n        t_k = _calculate_triangular_number(k)\n\n        if t_k >= lower_bound:\n            if _count_digits(t_k) == n:\n                return k\n        k += 1"}
