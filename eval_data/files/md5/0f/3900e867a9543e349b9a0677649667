{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list: list, sub_list: list) -> bool:\n    \"\"\"Checks if sub_list is a contiguous sublist within main_list.\"\"\"\n    if not sub_list:\n        return True\n    if not main_list or len(sub_list) > len(main_list):\n        return False\n\n    for i in range(len(main_list) - len(sub_list) + 1):\n        if main_list[i:i+len(sub_list)] == sub_list:\n            return True\n    return False"}
{"task_id": "Mbpp/566", "solution": "def sum_digits(number: int) -> int:\n    \"\"\"Calculates the sum of the digits of a non-negative integer.\"\"\"\n    total_sum = 0\n    # Use a loop to extract digits using modulo and integer division.\n    while number > 0:\n        total_sum += number % 10\n        number //= 10\n    return total_sum"}
{"task_id": "Mbpp/569", "solution": "from typing import List\ndef sort_sublists(input_list: List[List[str]]) -> List[List[str]]:\n    \"\"\"\n    Sorts each sublist of strings in a given list of lists alphabetically.\n    The original input list of lists remains unmodified.\n    \"\"\"\n    sorted_lists = [sublist[:] for sublist in input_list]\n    for sublist in sorted_lists:\n        sublist.sort()\n    return sorted_lists"}
{"task_id": "Mbpp/572", "solution": "import collections\ndef two_unique_nums(numbers: list) -> list:\n    \"\"\"\n    Identifies and returns numbers that occur exactly once in an input list,\n    preserving their relative order.\n    \"\"\"\n    counts = collections.Counter(numbers)\n\n    result = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n\n    return result"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n):\n    \"\"\"\n    Calculates the last digit of the factorial of a given non-negative integer n.\n    Handles special cases for small n and n >= 5.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n    \n    if n == 0 or n == 1:\n        return 1\n    elif n >= 5:\n        return 0\n    else:  # n is 2, 3, or 4\n        return _calculate_small_factorial_last_digit(n)\ndef _calculate_small_factorial_last_digit(n):\n    \"\"\"\n    Helper function to compute the last digit of n! for n in [2, 3, 4].\n    \"\"\"\n    if n == 2:\n        return 2\n    elif n == 3:\n        return 6\n    elif n == 4:\n        return 4"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Raises ValueError if input lists do not have the same length.\n    \"\"\"\n    if not (len(list1) == len(list2) == len(list3)):\n        raise ValueError(\"Input lists must have the same length.\")\n\n    if not list1:\n        return []\n\n    interleaved_list = []\n    for i in range(len(list1)):\n        interleaved_list.append(list1[i])\n        interleaved_list.append(list2[i])\n        interleaved_list.append(list3[i])\n\n    return interleaved_list"}
{"task_id": "Mbpp/585", "solution": "def expensive_items(items: list[dict], n: int) -> list[dict]:\n    \"\"\"Finds the n most expensive items from a list of item dictionaries.\n    Returns an empty list if n is non-positive or the input list is empty.\"\"\"\n    if n <= 0 or not items:\n        return []\n\n    # Sort items by 'price' in descending order\n    sorted_items = sorted(items, key=lambda item: item['price'], reverse=True)\n\n    # Return the top 'n' items; slicing handles cases where len(items) < n\n    return sorted_items[:n]"}
