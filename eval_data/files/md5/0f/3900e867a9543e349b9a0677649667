{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n):\n    \"\"\"\n    Calculates the average of the cubes of the first n natural numbers.\n    Assumes n is a natural number (integer >= 1).\n    \"\"\"\n    sum_of_cubes = 0.0\n    for i in range(1, n + 1):\n        sum_of_cubes += i ** 3\n    \n    average = sum_of_cubes / n\n    return average"}
{"task_id": "Mbpp/419", "solution": "import math\nfrom typing import List\nclass Number:\n    \"\"\"Encapsulates a single number, its original value, and provides functionality to round it.\"\"\"\n    def __init__(self, value: float):\n        self._original_value: float = value\n        # Implement 'round half up' explicitly.\n        self._rounded_value: int = int(math.floor(value + 0.5)) if value >= 0 else int(math.ceil(value - 0.5))\n\n    def get_rounded_value(self) -> int:\n        \"\"\"Returns the stored rounded integer value.\"\"\"\n        return self._rounded_value\nclass ListOfNumbers:\n    \"\"\"Manages a collection of Number objects and provides access to their rounded values and the list's length.\"\"\"\n    def __init__(self, raw_numbers: List[float]):\n        self._numbers: List[Number] = [Number(n) for n in raw_numbers]\n        self._length: int = len(self._numbers)\n\n    def get_length(self) -> int:\n        \"\"\"Returns the length of the list.\"\"\"\n        return self._length\n\n    def get_rounded_values(self) -> List[int]:\n        \"\"\"Returns a list of all rounded integer values.\"\"\"\n        return [n.get_rounded_value() for n in self._numbers]\nclass CalculationResult:\n    \"\"\"Stores and computes the final result based on the sum of rounded numbers and the list's length.\"\"\"\n    def __init__(self, sum_val: int, length_val: int):\n        self._sum_of_rounded_numbers: int = sum_val\n        self._list_length: int = length_val\n        self._final_value: int = self._sum_of_rounded_numbers * self._list_length\n\n    def get_final_value(self) -> int:\n        \"\"\"Returns the final calculated integer value.\"\"\"\n        return self._final_value\ndef round_and_sum(numbers: List[float]) -> int:\n    \"\"\"\n    Orchestrates the entire calculation process from input list to final result.\n    Accepts a list of floats, performs rounding, summing, and multiplication,\n    and returns the final integer result.\n    \"\"\"\n    list_of_numbers = ListOfNumbers(numbers)\n    rounded_values = list_of_numbers.get_rounded_values()\n    sum_of_rounded_numbers = sum(rounded_values)\n    list_length = list_of_numbers.get_length()\n\n    calculation_result = CalculationResult(sum_of_rounded_numbers, list_length)\n    return calculation_result.get_final_value()"}
{"task_id": "Mbpp/425", "solution": "def count_element_in_list(list_of_sublists: list[list[Any]], target_element: Any) -> int:\n    \"\"\"Counts the number of sublists containing a specific element.\n\n    Args:\n        list_of_sublists: A list where each item is itself a list (a sublist).\n        target_element: The element to search for within the sublists.\n\n    Returns:\n        An integer representing the count of sublists that contain the target_element.\n    \"\"\"\n    count = 0\n    for sublist in list_of_sublists:\n        if target_element in sublist:\n            count += 1\n    return count"}
{"task_id": "Mbpp/426", "solution": "class Number:\n    \"\"\"Represents an integer value and provides a method to check its parity.\"\"\"\n    def __init__(self, value: int):\n        \"\"\"Initializes a Number object.\"\"\"\n        if not isinstance(value, int):\n            raise TypeError(\"Number value must be an integer.\")\n        self._value = value\n\n    def is_odd(self) -> bool:\n        \"\"\"Determines if the number is odd.\"\"\"\n        return self._value % 2 != 0\n\n    def get_value(self) -> int:\n        \"\"\"Returns the integer value of the number.\"\"\"\n        return self._value\ndef filter_oddnumbers(numbers: list[int]) -> list[int]:\n    \"\"\"Filters a list of integers, returning a new list containing only the odd numbers.\n\n    The order of odd numbers in the output list is preserved from the original input list.\n    \"\"\"\n    odd_numbers_list = []\n    for num_value in numbers:\n        number_obj = Number(num_value)\n        if number_obj.is_odd():\n            odd_numbers_list.append(num_value)\n    return odd_numbers_list"}
