{"task_id": "Mbpp/129", "solution": "class Matrix:\n    \"\"\"Encapsulates matrix data and provides methods for shape validation and sum calculations.\"\"\"\n    def __init__(self, elements):\n        self._elements = elements\n        self._num_rows = len(elements)\n        self._num_columns = len(elements[0]) if self._num_rows > 0 else 0\n\n    def is_square(self) -> bool:\n        \"\"\"Determines if the matrix is a square matrix.\"\"\"\n        return self._num_rows == self._num_columns\n\n    def get_row_sum(self, row_index: int) -> int:\n        \"\"\"Calculates the sum of elements for a specific row.\"\"\"\n        return sum(self._elements[row_index])\n\n    def get_column_sum(self, col_index: int) -> int:\n        \"\"\"Calculates the sum of elements for a specific column.\"\"\"\n        return sum(self._elements[i][col_index] for i in range(self._num_rows))\n\n    def get_main_diagonal_sum(self) -> int:\n        \"\"\"Calculates the sum of elements in the main diagonal.\"\"\"\n        return sum(self._elements[i][i] for i in range(self._num_rows))\n\n    def get_anti_diagonal_sum(self) -> int:\n        \"\"\"Calculates the sum of elements in the anti-diagonal.\"\"\"\n        return sum(self._elements[i][self._num_rows - 1 - i] for i in range(self._num_rows))\n\n    @property\n    def num_rows(self) -> int:\n        \"\"\"Returns the number of rows.\"\"\"\n        return self._num_rows\n\n    @property\n    def num_columns(self) -> int:\n        \"\"\"Returns the number of columns.\"\"\"\n        return self._num_columns\ndef magic_square_test(matrix_data: list[list[int]]) -> bool:\n    \"\"\"\n    Determines if a given matrix is a magic square.\n    A matrix is a magic square if the sums of its rows, columns, and both main diagonals are all equal.\n    \"\"\"\n    if not matrix_data or not matrix_data[0]:\n        return False\n\n    matrix_obj = Matrix(matrix_data)\n\n    if not matrix_obj.is_square():\n        return False\n\n    size = matrix_obj.num_rows\n    if size == 0:\n        return True\n\n    magic_sum = matrix_obj.get_row_sum(0)\n\n    # Check row sums\n    for i in range(size):\n        if matrix_obj.get_row_sum(i) != magic_sum:\n            return False\n\n    # Check column sums\n    for j in range(size):\n        if matrix_obj.get_column_sum(j) != magic_sum:\n            return False\n\n    # Check main diagonal sum\n    if matrix_obj.get_main_diagonal_sum() != magic_sum:\n        return False\n\n    # Check anti-diagonal sum\n    if matrix_obj.get_anti_diagonal_sum() != magic_sum:\n        return False\n\n    return True"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(input_list: list) -> any:\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    Returns None if the list is empty.\n    \"\"\"\n    if not input_list:\n        return None\n\n    item_counts = {}\n    for item in input_list:\n        item_counts[item] = item_counts.get(item, 0) + 1\n\n    max_item = None\n    max_count = -1\n\n    for item, count in item_counts.items():\n        if count > max_count:\n            max_count = count\n            max_item = item\n\n    return max_item"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels of a given string while preserving non-vowel positions.\n    'y' is not considered a vowel.\n    \"\"\"\n    VOWELS_SET = {'a', 'e', 'i', 'o', 'u'}\n\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is a vowel (case-insensitive, 'y' excluded).\"\"\"\n        return char.lower() in VOWELS_SET\n\n    char_list = list(s)\n    vowel_indices = []\n    vowels_found = []\n\n    # Find all vowels and their original positions\n    for i, char in enumerate(char_list):\n        if _is_vowel(char):\n            vowel_indices.append(i)\n            vowels_found.append(char)\n\n    # Reverse the order of the found vowels\n    vowels_found.reverse()\n\n    # Place the reversed vowels back into their original positions\n    for j in range(len(vowel_indices)):\n        original_idx = vowel_indices[j]\n        char_list[original_idx] = vowels_found[j]\n\n    return \"\".join(char_list)"}
{"task_id": "Mbpp/133", "solution": "def _is_negative(number: int) -> bool:\n    \"\"\"Determines if a given number is negative.\"\"\"\n    return number < 0\ndef _filter_negative_numbers(numbers: list[int]) -> list[int]:\n    \"\"\"Filters a list of numbers, returning only the negative ones.\"\"\"\n    negative_numbers = []\n    for num in numbers:\n        if _is_negative(num):\n            negative_numbers.append(num)\n    return negative_numbers\ndef _calculate_sum(numbers: list[int]) -> int:\n    \"\"\"Computes the sum of a list of numbers.\"\"\"\n    return sum(numbers)\ndef sum_negativenum(numbers: list[int]) -> int:\n    \"\"\"Calculates the sum of all negative numbers in the given list.\"\"\"\n    negative_numbers_list = _filter_negative_numbers(numbers)\n    total_sum = _calculate_sum(negative_numbers_list)\n    return total_sum"}
{"task_id": "Mbpp/137", "solution": "def zero_count(elements: list[int]) -> float:\n    \"\"\"\n    Calculates the ratio of zeroes to non-zeroes in a list of integers.\n    Returns 0.0 if there are no non-zero elements to avoid division by zero.\n    \"\"\"\n    zeroes = 0\n    non_zeroes = 0\n\n    for element in elements:\n        if element == 0:\n            zeroes += 1\n        else:\n            non_zeroes += 1\n\n    if non_zeroes == 0:\n        return 0.0\n    else:\n        return float(zeroes) / non_zeroes"}
