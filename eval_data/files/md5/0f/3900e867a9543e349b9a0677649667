{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is undulating, following an A-B-A-B... pattern.\n    The number must have at least three distinct digits, where the first two digits (A and B) are different.\n    \"\"\"\n    s_number = str(number)\n    n = len(s_number)\n\n    if n < 3:\n        return False\n\n    first_digit = s_number[0]\n    second_digit = s_number[1]\n\n    if first_digit == second_digit:\n        return False\n\n    for i in range(2, n):\n        if i % 2 == 0:  # Even position (0-indexed) should match first_digit (A)\n            if s_number[i] != first_digit:\n                return False\n        else:  # Odd position (0-indexed) should match second_digit (B)\n            if s_number[i] != second_digit:\n                return False\n\n    return True"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(list_of_tuples: list[tuple]) -> any:\n    \"\"\"\n    Given a list of tuples, returns the first value of the tuple\n    with the smallest second value.\n    \"\"\"\n    # Initialize with the first tuple's values\n    result_first_value = list_of_tuples[0][0]\n    min_second_value = list_of_tuples[0][1]\n\n    # Iterate through the rest of the tuples to find the minimum second value\n    for item in list_of_tuples[1:]:\n        current_first_value = item[0]\n        current_second_value = item[1]\n\n        if current_second_value < min_second_value:\n            min_second_value = current_second_value\n            result_first_value = current_first_value\n\n    return result_first_value"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"\n    Converts a decimal integer to its binary string representation.\n    Ensures no leading zeros, with '0' for input 0.\n    \"\"\"\n    if decimal_number == 0:\n        return '0'\n\n    binary_string = ''\n    temp_number = decimal_number\n    while temp_number > 0:\n        binary_string = ('1' if temp_number % 2 == 1 else '0') + binary_string\n        temp_number //= 2\n\n    return binary_string"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists):\n    \"\"\"\n    Finds the length of the smallest list in a list of lists.\n    Assumes valid input: a non-empty list of lists where all inner elements are lists.\n    \"\"\"\n    lengths = [len(inner_list) for inner_list in list_of_lists]\n    smallest_length = min(lengths)\n    return smallest_length"}
{"task_id": "Mbpp/96", "solution": "def divisor(number: int) -> int:\n    \"\"\"\n    Calculates the total number of positive divisors for a given integer.\n    It iterates up to the square root of the number to find pairs of divisors efficiently.\n    \"\"\"\n    count = 0\n    # Iterate from 1 up to the square root of the number (inclusive)\n    for i in range(1, int(number**0.5) + 1):\n        if number % i == 0:\n            if i * i == number:\n                # If i is the square root, count it once\n                count += 1\n            else:\n                # Otherwise, i and number // i are two distinct divisors\n                count += 2\n    return count"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome strictly greater than the input integer.\n    It increments the input number and checks for palindrome property.\n    \"\"\"\n    num = n + 1\n    while True:\n        s_num = str(num)\n        if s_num == s_num[::-1]:\n            return num\n        num += 1"}
{"task_id": "Mbpp/97", "solution": "def frequency_lists(list_of_lists: list[list[any]]) -> dict[any, int]:\n    \"\"\"\n    Calculates the frequency of each element in a flattened list of lists.\n    It iterates through all nested elements and counts their occurrences.\n    \"\"\"\n    frequencies = {}\n    for inner_list in list_of_lists:\n        for item in inner_list:\n            frequencies[item] = frequencies.get(item, 0) + 1\n    return frequencies"}
{"task_id": "Mbpp/98", "solution": "import math\ndef multiply_num(numbers: tuple) -> float:\n    \"\"\"\n    Multiplies all numbers in a tuple and divides the product by the tuple's length.\n    Raises ValueError if the input tuple is empty.\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"Input tuple cannot be empty.\")\n    \n    product = math.prod(numbers)\n    length = len(numbers)\n    return float(product / length)"}
