{"task_id": "Mbpp/286", "solution": "def max_sub_array_sum_repeated(original_array: list[int], k: int) -> int:\n    \"\"\"\n    Entry point for calculating the largest contiguous subarray sum in a k-times repeated array.\n    \"\"\"\n    original_array_obj = Array(original_array)\n    calculator = Calculator()\n    return calculator.findLargestContiguousSum(original_array_obj, k)\nclass Array:\n    \"\"\"Represents an array of integers and provides its total sum.\"\"\"\n    def __init__(self, elements: list[int]):\n        self.elements = elements\n\n    def calculate_total_sum(self) -> int:\n        \"\"\"Calculates and returns the sum of all elements in the array.\"\"\"\n        return sum(self.elements)\nclass RepeatedArray:\n    \"\"\"Represents the conceptual k-times repeated array and can generate its elements for small k.\"\"\"\n    def __init__(self, original_array: Array, repeat_count: int):\n        self.original_array = original_array\n        self.repeat_count = repeat_count\n        self.elements = []\n\n    def generate_repeated_array(self) -> list[int]:\n        \"\"\"Generates and returns the full list of elements for the repeated array.\"\"\"\n        if not self.elements:\n            self.elements = self.original_array.elements * self.repeat_count\n        return self.elements\nclass Calculator:\n    \"\"\"Implements the core algorithm to find the largest contiguous subarray sum in a k-times repeated array.\"\"\"\n    def __init__(self):\n        pass\n\n    def _kadane(self, arr: list[int]) -> int:\n        \"\"\"Implements Kadane's algorithm to find the maximum subarray sum in a single array.\"\"\"\n        if not arr:\n            return 0 \n\n        max_current = arr[0]\n        global_max = arr[0]\n        \n        for i in range(1, len(arr)):\n            max_current = max(arr[i], max_current + arr[i])\n            global_max = max(global_max, max_current)\n            \n        return global_max\n\n    def _max_prefix_sum(self, arr: list[int]) -> int:\n        \"\"\"Calculates the maximum prefix sum of an array.\"\"\"\n        if not arr:\n            return 0\n        current_sum = 0\n        max_sum_val = -float('inf')\n        for x in arr:\n            current_sum += x\n            max_sum_val = max(max_sum_val, current_sum)\n        return max_sum_val\n\n    def _max_suffix_sum(self, arr: list[int]) -> int:\n        \"\"\"Calculates the maximum suffix sum of an array.\"\"\"\n        if not arr:\n            return 0\n        current_sum = 0\n        max_sum_val = -float('inf')\n        for x in reversed(arr):\n            current_sum += x\n            max_sum_val = max(max_sum_val, current_sum)\n        return max_sum_val\n\n    def findLargestContiguousSum(self, original_array_obj: Array, k: int) -> int:\n        \"\"\"\n        Calculates the largest contiguous subarray sum based on the original_array_obj repeated k times.\n        Applies business rules for efficiency.\n        \"\"\"\n        original_elements = original_array_obj.elements\n        total_sum = original_array_obj.calculate_total_sum()\n\n        if k == 1:\n            return self._kadane(original_elements)\n        \n        repeated_array_obj_two_times = RepeatedArray(original_array_obj, 2)\n        two_times_elements = repeated_array_obj_two_times.generate_repeated_array()\n        max_sum_two_times = self._kadane(two_times_elements)\n\n        if total_sum <= 0:\n            return max_sum_two_times\n        else:\n            return max_sum_two_times + total_sum * (k - 2)"}
