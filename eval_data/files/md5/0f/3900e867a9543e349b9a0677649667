{"task_id": "Mbpp/120", "solution": "def max_product_tuple(data_list):\n    # Initializes max_abs_product to 0 to handle empty lists or cases where all products are 0.\n    # Iterates through the list, calculates the absolute product for each tuple, and tracks the maximum.\n    max_abs_product = 0\n    for tpl in data_list:\n        # Assuming valid input based on design context, directly access tuple elements.\n        num1, num2 = tpl\n        current_product = num1 * num2\n        abs_current_product = abs(current_product)\n        if abs_current_product > max_abs_product:\n            max_abs_product = abs_current_product\n    return max_abs_product"}
{"task_id": "Mbpp/124", "solution": "import math\nclass ComplexNumber:\n    \"\"\"Encapsulates a complex number and provides its angle calculation.\"\"\"\n    def __init__(self, real: float, imaginary: float):\n        \"\"\"Initializes a new complex number instance.\"\"\"\n        self._real_part = real\n        self._imaginary_part = imaginary\n\n    def get_angle(self) -> float:\n        \"\"\"Calculates and returns the angle (argument) of the complex number in radians.\"\"\"\n        return math.atan2(self._imaginary_part, self._real_part)\ndef angle_complex(real: float, imaginary: float) -> float:\n    \"\"\"Calculates and returns the angle (argument) of a complex number.\"\"\"\n    complex_num = ComplexNumber(real, imaginary)\n    return complex_num.get_angle()"}
{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(limit: int) -> int:\n    \"\"\"\n    Identifies amicable numbers within the range [1, limit] and calculates their total sum.\n    \"\"\"\n    def _calculate_sum_of_proper_divisors(n: int) -> int:\n        \"\"\"\n        Calculates the sum of all proper divisors for a given positive integer n.\n        \"\"\"\n        if n <= 1:\n            return 0\n        s = 1  # 1 is always a proper divisor\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                s += i\n                if i * i != n:\n                    s += n // i\n        return s\n\n    total_sum = 0\n    seen_amicable_numbers = set()\n\n    for n in range(1, limit + 1):\n        if n in seen_amicable_numbers:\n            continue\n\n        sum_divisors_n = _calculate_sum_of_proper_divisors(n)\n\n        # Ensure sum_divisors_n is within the limit, not equal to n, and positive for further calculation\n        if sum_divisors_n > n and sum_divisors_n <= limit:\n            sum_divisors_sum_divisors_n = _calculate_sum_of_proper_divisors(sum_divisors_n)\n\n            if sum_divisors_sum_divisors_n == n:\n                total_sum += n\n                total_sum += sum_divisors_n\n                seen_amicable_numbers.add(n)\n                seen_amicable_numbers.add(sum_divisors_n)\n\n    return total_sum"}
{"task_id": "Mbpp/126", "solution": "def sum(num1, num2):\n    \"\"\"\n    Finds the sum of common divisors for two given numbers.\n    This function first finds all positive common divisors and then sums them.\n    \"\"\"\n    min_val = min(abs(num1), abs(num2))\n    common_divs = []\n    for i in range(1, min_val + 1):\n        if num1 % i == 0 and num2 % i == 0:\n            common_divs.append(i)\n    return sum(common_divs)"}
{"task_id": "Mbpp/125", "solution": "def find_length(binary_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s in any substring.\n    The difference is calculated as (count of '0's) - (count of '1's).\n    \"\"\"\n    max_difference = 0\n    current_difference = 0\n\n    for char in binary_string:\n        # Convert '0' to 1 and '1' to -1 for sum calculation\n        if char == '0':\n            char_value = 1\n        else:  # char == '1'\n            char_value = -1\n        \n        # Apply Kadane's algorithm: \n        # The maximum sum ending at the current position is either \n        # the current character's value itself or the current character's value \n        # plus the maximum sum ending at the previous position.\n        current_difference = max(char_value, current_difference + char_value)\n        \n        # Update the overall maximum difference found across all substrings.\n        max_difference = max(max_difference, current_difference)\n            \n    return max_difference"}
