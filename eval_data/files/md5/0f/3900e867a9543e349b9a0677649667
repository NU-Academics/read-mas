{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr: list[int], length: int, i: int, k: int) -> int:\n    \"\"\"\n    Calculates the maximum sum of an increasing subsequence from a prefix up to index i,\n    including the element at index k, where k > i.\n    \"\"\"\n    if not (0 <= i < length and 0 <= k < length):\n        raise ValueError(\"Indices i or k are out of array bounds.\")\n    if not (k > i):\n        raise ValueError(\"Constraint violation: k must be strictly greater than i.\")\n\n    # dp[x] will store the maximum sum of an increasing subsequence ending at arr[x],\n    # considering only elements from arr[0...x] where x <= i.\n    dp = [0] * (i + 1)\n\n    # Populate dp for the prefix up to index i\n    for current_idx in range(i + 1):\n        dp[current_idx] = arr[current_idx]\n        for prev_idx in range(current_idx):\n            if arr[current_idx] > arr[prev_idx]:\n                dp[current_idx] = max(dp[current_idx], dp[prev_idx] + arr[current_idx])\n\n    # Find the maximum sum from dp that can serve as a prefix to arr[k].\n    # This means finding max(dp[j]) for all j <= i such that arr[j] < arr[k].\n    max_prefix_sum_before_k = 0\n    for j in range(i + 1):\n        if arr[j] < arr[k]:\n            max_prefix_sum_before_k = max(max_prefix_sum_before_k, dp[j])\n\n    # The total sum is the maximum valid prefix sum found plus arr[k].\n    # If no suitable prefix is found (max_prefix_sum_before_k remains 0), the subsequence is just arr[k].\n    return max_prefix_sum_before_k + arr[k]"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"\n    Calculates the highest power of 2 less than or equal to n.\n    Raises ValueError if n is less than 1.\n    \"\"\"\n    if n < 1:\n        raise ValueError(\"n must be a positive integer.\")\n\n    power = 1\n    while power * 2 <= n:\n        power *= 2\n    return power"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(value: int) -> int:\n    # Determine the highest bit position to check.\n    # If value is 0, bit_length() is 0, so start_pos will be -1.\n    # In this case, the loop won't run, and 0 | (1 << 0) will happen.\n    start_pos = value.bit_length()\n\n    # Iterate from the highest potential bit down to 0.\n    for p in range(start_pos, -1, -1):\n        # Check if the bit at position p is unset (0).\n        if not (value >> p) & 1:\n            # If unset, create a bitmask and set the bit.\n            return value | (1 << p)\n    \n    # If no unset bit is found (all bits up to the most significant are set),\n    # return the original value.\n    return value"}
