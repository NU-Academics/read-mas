{"task_id": "Mbpp/799", "solution": "def left_rotate(number: int, d: int) -> int:\n    \"\"\"\n    Performs a left bit rotation on a 32-bit integer.\n    The result is masked to ensure it remains a 32-bit integer.\n    \"\"\"\n    d = d % 32\n    return ((number << d) | (number >> (32 - d))) & 0xFFFFFFFF"}
{"task_id": "Mbpp/800", "solution": "def remove_all_spaces(input_string: str) -> str:\n    \"\"\"\n    Removes all whitespace characters from the input string.\n    Returns a new string with all whitespace characters removed, preserving order.\n    \"\"\"\n    return ''.join(char for char in input_string if not char.isspace())"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a, b, c):\n    \"\"\"Counts the number of equal integers among the three given inputs.\"\"\"\n    if a == b and b == c:\n        return 3\n    elif a == b or a == c or b == c:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/803", "solution": "def is_perfect_square(number: int | float) -> bool:\n    \"\"\"\n    Checks if the given number is a perfect square.\n    Handles non-negative numbers; negative numbers are not perfect squares.\n    \"\"\"\n    if number < 0:\n        return False\n    if number == 0:\n        return True\n\n    if isinstance(number, int):\n        root = number**0.5 # Using **0.5 instead of math.isqrt for broader Python version compatibility\n        return root == int(root)\n    else: # Handle float input\n        root = number**0.5\n        # Check if the root is an integer (within a small tolerance for float precision)\n        return abs(root - round(root)) < 1e-9"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(list_of_lists: list[list[int]]) -> list[int]:\n    \"\"\"\n    Returns the list in a list of lists whose sum of elements is the highest.\n    Assumes the input list_of_lists is not empty.\n    \"\"\"\n    max_sum = float('-inf')\n    result_list = []\n\n    for sublist in list_of_lists:\n        current_sum = sum(sublist)\n        if current_sum > max_sum:\n            max_sum = current_sum\n            result_list = sublist\n            \n    return result_list"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers: List[Any]) -> bool:\n    \"\"\"Checks if the product of numbers in a list is even.\n\n    The product is even if any number in the list is even, after filtering non-numeric values.\n    An empty list results in an odd product (1).\n    \"\"\"\n\n    def _is_even(number: Union[int, float]) -> bool:\n        \"\"\"Checks if a single number is even.\"\"\"\n        if isinstance(number, float):\n            return number == int(number) and int(number) % 2 == 0\n        return number % 2 == 0\n\n    def _filter_numeric_values(numbers_list: List[Any]) -> List[Union[int, float]]:\n        \"\"\"Filters a list to include only numeric values (int or float).\"\"\"\n        return [n for n in numbers_list if isinstance(n, (int, float))]\n\n    filtered_numbers = _filter_numeric_values(numbers)\n\n    if not filtered_numbers:\n        return False\n\n    for num in filtered_numbers:\n        if _is_even(num):\n            return True\n\n    return False"}
