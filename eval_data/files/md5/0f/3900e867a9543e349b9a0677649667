{"task_id": "Mbpp/101", "solution": "def kth_element(array: list, k: int):\n    \"\"\"\n    Finds the kth element in the given array using 1-based indexing.\n    This function performs input validations and raises specific exceptions for invalid cases.\n    \"\"\"\n    class KthElementError(Exception):\n        def __init__(self, message: str):\n            super().__init__(message)\n\n    class InvalidIndexError(KthElementError):\n        def __init__(self, message: str = \"Index 'k' must be a positive integer.\"):\n            super().__init__(message)\n\n    class EmptyArrayError(KthElementError):\n        def __init__(self, message: str = \"Input array cannot be empty.\"):\n            super().__init__(message)\n\n    class IndexOutOfBoundsError(KthElementError):\n        def __init__(self, message: str = \"Index 'k' is out of bounds for the given array.\"):\n            super().__init__(message)\n\n    if not isinstance(k, int) or k <= 0:\n        raise InvalidIndexError()\n    \n    if not array:\n        raise EmptyArrayError()\n    \n    if k > len(array):\n        raise IndexOutOfBoundsError()\n    \n    return array[k - 1]"}
{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary_string: str, rotations: int) -> int:\n    \"\"\"\n    Calculates the number of odd-valued decimal equivalents generated by rotating a binary string.\n    The function orchestrates string rotation and oddness checking.\n    \"\"\"\n    def _rotate_string(s: str, times: int) -> str:\n        \"\"\"Rotates a string to the left by a given number of times.\"\"\"\n        if not s:\n            return s\n        n = len(s)\n        actual_rotations = times % n\n        return s[actual_rotations:] + s[:actual_rotations]\n\n    def _is_odd_binary(binary_s: str) -> bool:\n        \"\"\"Determines if a binary string represents an odd number based on its least significant bit.\"\"\"\n        if not binary_s:\n            return False\n        return binary_s[-1] == '1'\n\n    odd_count = 0\n    current_string = binary_string\n    n = len(binary_string)\n\n    # Perform rotations up to the length of the string, as rotations will repeat after n times\n    # The requirement asks for 'rotations' times, so we loop up to that count.\n    for _ in range(rotations):\n        # Rotate the string once for each iteration\n        current_string = _rotate_string(current_string, 1)\n        if _is_odd_binary(current_string):\n            odd_count += 1\n            \n    return odd_count"}
{"task_id": "Mbpp/104", "solution": "def sort_sublists(list_of_lists: list[list[str]]) -> list[list[str]]:\n    \"\"\"Sorts each sublist of strings lexicographically within a given list of lists.\"\"\"\n    sorted_lists = []\n    for sublist in list_of_lists:\n        sorted_lists.append(sorted(sublist))\n    return sorted_lists"}
{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number a(n, m).\n    The Eulerian number a(n, m) counts permutations of {1, ..., n} with exactly m ascents.\n    \"\"\"\n    if n < 0 or m < 0:\n        raise ValueError(\"n and m must be non-negative integers.\")\n    if m >= n:\n        if n == 0 and m == 0: # a(0,0) = 1 by convention\n            return 1\n        raise ValueError(\"m must be strictly less than n.\")\n\n    # Base cases\n    if n == 0:\n        return 1 if m == 0 else 0\n    if m == 0:\n        return 1 if n > 0 else 0 # a(n,0) = 1 for n > 0\n\n    # Recursive definition: a(n, m) = (m + 1) * a(n - 1, m) + (n - m) * a(n - 1, m - 1)\n    # Using dynamic programming (memoization) for efficiency\n    dp = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # Initialize base cases\n    dp[0][0] = 1 # a(0,0) = 1\n    for i in range(1, n + 1):\n        dp[i][0] = 1 # a(n,0) = 1 for n > 0\n\n    # Fill DP table\n    for i in range(1, n + 1):\n        for j in range(1, min(i, m + 1)): # m must be < n, so j can go up to i-1\n            dp[i][j] = (j + 1) * dp[i - 1][j] + (i - j) * dp[i - 1][j - 1]\n    \n    return dp[n][m]"}
