{"task_id": "Mbpp/142", "solution": "def count_samepair(list1: list, list2: list, list3: list) -> int:\n    \"\"\"\n    Counts the number of positions where items are identical across three given lists.\n\n    Compares items at corresponding positions up to the length of the shortest list.\n    \"\"\"\n    min_length = min(len(list1), len(list2), len(list3))\n    match_count = 0\n\n    for i in range(min_length):\n        if list1[i] == list2[i] and list2[i] == list3[i]:\n            match_count += 1\n            \n    return match_count"}
{"task_id": "Mbpp/145", "solution": "from typing import List, Tuple, Union\ndef max_Abs_Diff(array: Union[List[Union[int, float]], Tuple[Union[int, float], ...]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the maximum absolute difference between any two elements in a given array.\n    Returns 0 if the array has fewer than two elements, as no difference can be calculated.\n    \"\"\"\n    if not array or len(array) < 2:\n        return 0.0\n\n    min_val = array[0]\n    max_val = array[0]\n\n    for element in array:\n        if element < min_val:\n            min_val = element\n        if element > max_val:\n            max_val = element\n\n    return abs(max_val - min_val)"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a, b, n):\n    \"\"\"\n    Finds integer solutions (x, y) for the equation ax + by = n, or None if no solution exists.\n    Uses the Extended Euclidean Algorithm to find a particular solution.\n    \"\"\"\n    def gcd(num1, num2):\n        while num2:\n            num1, num2 = num2, num1 % num2\n        return num1\n\n    def extended_gcd(num1, num2):\n        if num1 == 0:\n            return num2, 0, 1\n        g, x, y = extended_gcd(num2 % num1, num1)\n        return g, y - (num2 // num1) * x, x\n\n    common_divisor = gcd(abs(a), abs(b))\n\n    if n % common_divisor != 0:\n        return None\n\n    # Scale the equation by dividing by gcd(a, b)\n    # The new equation is (a/g)x + (b/g)y = (n/g)\n    # Let a' = a/g, b' = b/g, n' = n/g\n    # We need to solve a'x + b'y = n' where gcd(a', b') = 1\n\n    # Find x0, y0 for a*x0 + b*y0 = g\n    g, x0, y0 = extended_gcd(a, b)\n\n    # A particular solution for a*x + b*y = n is:\n    # x_p = x0 * (n / g)\n    # y_p = y0 * (n / g)\n    scale_factor = n // g\n    x_p = x0 * scale_factor\n    y_p = y0 * scale_factor\n\n    # The general solution is:\n    # x = x_p + k * (b / g)\n    # y = y_p - k * (a / g)\n    # for any integer k.\n\n    # We need to find the smallest non-negative x, or any x and y.\n    # The problem statement gives an example (2, 1) for (2, 3, 7).\n    # extended_gcd(2, 3) gives (1, -1, 1), meaning 2*(-1) + 3*(1) = 1.\n    # Scaling by 7: 2*(-7) + 3*(7) = 7. So x_p = -7, y_p = 7.\n    # We want x_p + k * (b / g) to be 2.\n    # -7 + k * (3 / 1) = 2\n    # -7 + 3k = 2\n    # 3k = 9\n    # k = 3\n    # Check y: y_p - k * (a / g) = 7 - 3 * (2 / 1) = 7 - 6 = 1.\n    # So (2, 1) is a solution.\n\n    # To find a 'canonical' solution often means the one with the smallest non-negative x.\n    # The problem asks for \"integers x and y\", implying any valid pair.\n    # The example (2, 1) suggests adjusting the initial particular solution.\n\n    # If x_p is already good, use it. Otherwise, adjust.\n    # x_p = x0 * (n // g)\n    # y_p = y0 * (n // g)\n\n    # To find a positive x (or closest to 0):\n    # x_offset = b // g\n    # y_offset = a // g\n\n    # If x_p is negative, add multiples of x_offset until it's positive.\n    # if x_p < 0:\n    #     k = (-x_p + x_offset - 1) // x_offset # k to make x_p >= 0\n    #     x_p += k * x_offset\n    #     y_p -= k * y_offset\n    # return (x_p, y_p)\n\n    # Based on the example, we can return the direct result from scaling extended_gcd.\n    # The assert for find_solution(2, 3, 7) == (2, 1) means we need to align the output.\n    # Our current x_p = -7, y_p = 7.\n    # General solutions: x = -7 + k * (3/1), y = 7 - k * (2/1)\n    # x = -7 + 3k, y = 7 - 2k\n    # For k=3, x = -7 + 9 = 2, y = 7 - 6 = 1. This matches the example.\n    # The extended_gcd result (x0, y0) can vary based on implementation (e.g. positive vs negative args).\n\n    # The issue here is that extended_gcd(a, b) might return (g, x, y) such that x is negative,\n    # and we often desire the smallest non-negative x.\n    # The particular solution given by x_p = x0 * (n // g) and y_p = y0 * (n // g) is valid.\n    # If a and b are non-zero, the general solution is x = x_p + k*(b/g) and y = y_p - k*(a/g).\n    # We want to find a k such that x_p + k*(b/g) is the \"correct\" value.\n\n    # Let's adjust x_p to be in the range [0, |b/g|-1] or similar\n    # Only adjust if a or b is non-zero\n    if a != 0 or b != 0:\n        # Calculate coefficients for general solution\n        x_coeff = b // g\n        y_coeff = a // g\n\n        # Adjust x_p to be within a \"canonical\" range, e.g., smallest non-negative.\n        # This will ensure a consistent output even if extended_gcd varies.\n        # The period for x values is |x_coeff|\n        # x = x_p + k * x_coeff\n        # We need to find k such that 0 <= x < |x_coeff|\n        if x_coeff != 0:\n            x_p_normalized = x_p % x_coeff\n            # If x_p_normalized has the wrong sign (e.g., Python's % behavior with negatives)\n            if (x_p_normalized < 0 and x_coeff > 0) or (x_p_normalized > 0 and x_coeff < 0):\n                x_p_normalized += x_coeff\n            \n            # Recalculate y based on the normalized x\n            # ax_p + by_p = n\n            # by_p = n - ax_p\n            # y_p = (n - ax_p) // b\n            \n            # This is simpler:\n            # How many multiples of x_coeff do we need to add/subtract to get x_p positive\n            # and within the smallest range?\n            # E.g., if x_p = -7, x_coeff = 3.\n            # -7 + k*3 should be 2.\n            # k = (-7 // 3) + 1 = -3 + 1 = -2.\n            # If k = (-x_p // x_coeff) (integer division), it gives the smallest k to make x_p non-negative.\n            # Example: x_p = -7, x_coeff = 3. k_adjust = (-7 // 3) = -3.\n            # But we want to add to make it positive.\n            # x_adj = x_p % x_coeff\n            # if (x_adj < 0 and x_coeff > 0) or (x_adj > 0 and x_coeff < 0):\n            #     x_adj += x_coeff\n\n            # Simple way to ensure x is positive:\n            while x_p < 0 and x_coeff != 0:\n                x_p += x_coeff\n                y_p -= y_coeff\n            while x_p >= x_coeff and x_coeff != 0: # If x_coeff is positive\n                 x_p -= x_coeff\n                 y_p += y_coeff\n            while x_p >= 0 and x_coeff < 0: # If x_coeff is negative, we want x_p to be as small as possible (most negative) or positive if it covers 0\n                 x_p += x_coeff\n                 y_p -= y_coeff\n\n            # A more robust way to find the smallest non-negative x, if one exists:\n            # (x_p % x_coeff) might be negative if x_p is negative.\n            # Python's % behavior: -7 % 3 = 2. This actually works well for finding the canonical x.\n            # Let's verify for x_p=-7, x_coeff=3.\n            # x_p_canonical = x_p % x_coeff = -7 % 3 = 2.\n            # Then we need to adjust y_p by (x_p_canonical - x_p) // x_coeff * y_coeff\n            # k = (x_p_canonical - x_p) // x_coeff = (2 - (-7)) // 3 = 9 // 3 = 3.\n            # y_p_canonical = y_p - k * y_coeff = 7 - 3 * 2 = 1.\n            # This gives (2, 1). This matches the example.\n\n            x_final = x_p % x_coeff\n            y_final = y_p - ((x_final - x_p) // x_coeff) * y_coeff\n\n            return (x_final, y_final)\n\n        # Handle cases where b (and thus x_coeff) is 0\n        elif a != 0 and b == 0:\n            # Equation is ax = n. If x_p = n/a is integer, then it's (n/a, any_y).\n            # The question implies unique or a specific \"first\" solution.\n            # If b=0, then x is fixed (n/a) if a divides n, and y can be 0.\n            return (n // a, 0)\n        \n        # This block covers a=0, b=0 (already handled by common_divisor and n % common_divisor != 0)\n        # or a=0, b!=0 (symmetric to a!=0, b=0)\n        elif a == 0 and b != 0:\n            return (0, n // b)\n    \n    # This case only happens if a=0, b=0.\n    # If a=0, b=0: 0*x + 0*y = n.\n    # If n=0, any (x,y) is a solution. We can return (0,0).\n    # If n!=0, no solution. This should already be handled by n % common_divisor != 0 because common_divisor would be 0.\n    # extended_gcd(0,0) is tricky.\n    if a == 0 and b == 0:\n        if n == 0:\n            return (0, 0) # (0,0) is a valid solution\n        else:\n            return None # Already covered by n % common_divisor != 0 where common_divisor is 0\n\n    return (x_p, y_p) # Fallback, should be refined by normalization logic above for general case"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(primary_list: list, removal_list: list) -> list:\n    \"\"\"\n    Removes all elements from primary_list that are present in removal_list.\n    Returns a new list containing elements from primary_list not found in removal_list,\n    preserving their original order.\n    \"\"\"\n    removal_set = set(removal_list)\n    result = [element for element in primary_list if element not in removal_set]\n    return result"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"Calculates the sum of (n - 2*i) for i from 0 to n // 2.\"\"\"\n    total_sum = 0\n    # The loop should go up to n // 2, inclusive. So range needs +1.\n    for i in range((n // 2) + 1):\n        term = n - (2 * i)\n        total_sum += term\n    return total_sum"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(numbers: list[int]) -> int:\n    \"\"\"\n    Counts pairs of integers in a list that XOR to an even number.\n    This occurs if both integers have the same parity.\n    \"\"\"\n    def _is_even(num: int) -> bool:\n        \"\"\"Determines if a given integer is even.\"\"\"\n        return num % 2 == 0\n\n    odd_count = 0\n    even_count = 0\n\n    for num in numbers:\n        if _is_even(num):\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # Pairs of (even, even) XOR to an even number.\n    # The number of such pairs is (even_count choose 2).\n    count = (even_count * (even_count - 1)) // 2\n\n    # Pairs of (odd, odd) XOR to an even number.\n    # The number of such pairs is (odd_count choose 2).\n    count += (odd_count * (odd_count - 1)) // 2\n\n    return count"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    \"\"\"Counts characters whose 1-indexed string position matches their 1-indexed alphabet position (case-insensitive).\"\"\"\n\n    def _get_alphabet_1_indexed_position(char: str) -> int:\n        \"\"\"Calculates the 1-indexed position of a lowercase English letter in the alphabet.\"\"\"\n        if 'a' <= char <= 'z':\n            return ord(char) - ord('a') + 1\n        return 0\n\n    count = 0\n    for i, char in enumerate(input_string):\n        string_pos = i + 1  # 1-indexed position in the string\n        lower_char = char.lower()\n\n        if 'a' <= lower_char <= 'z':\n            alphabet_pos = _get_alphabet_1_indexed_position(lower_char)\n            if string_pos == alphabet_pos:\n                count += 1\n    return count"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"Calculates the smallest power of 2 greater than or equal to n. Assumes n is a non-negative integer.\"\"\"\n    if n == 0:\n        return 1\n    p = 1\n    # Continuously double p until it is greater than or equal to n.\n    while p < n:\n        p *= 2\n    return p"}
