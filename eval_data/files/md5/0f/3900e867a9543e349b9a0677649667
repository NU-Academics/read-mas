{"task_id": "Mbpp/172", "solution": "def count_occurance(main_string: str, target_substring: str) -> int:\n    \"\"\"Counts non-overlapping, case-sensitive occurrences of a target substring within a main string.\"\"\"\n    if not target_substring:\n        return 0\n\n    if not main_string:\n        return 0\n\n    count = 0\n    start_index = 0\n\n    while True:\n        index = main_string.find(target_substring, start_index)\n        if index != -1:\n            count += 1\n            start_index = index + len(target_substring)\n        else:\n            break\n\n    return count"}
{"task_id": "Mbpp/223", "solution": "def is_majority(arr: list[int], n: int, x: int) -> bool:\n    \"\"\"\n    Determines if an element x is a majority element in the given sorted array arr.\n    A majority element occurs strictly more than n/2 times.\n    \"\"\"\n    def _find_first_occurrence(arr: list[int], x: int) -> int:\n        \"\"\"Finds the index of the first occurrence of element x in a sorted array arr.\"\"\"\n        low, high = 0, len(arr) - 1\n        result = -1\n        while low <= high:\n            mid = low + (high - low) // 2\n            if arr[mid] == x:\n                result = mid\n                high = mid - 1\n            elif arr[mid] < x:\n                low = mid + 1\n            else:\n                high = mid - 1\n        return result\n\n    def _find_last_occurrence(arr: list[int], x: int) -> int:\n        \"\"\"Finds the index of the last occurrence of element x in a sorted array arr.\"\"\"\n        low, high = 0, len(arr) - 1\n        result = -1\n        while low <= high:\n            mid = low + (high - low) // 2\n            if arr[mid] == x:\n                result = mid\n                low = mid + 1\n            elif arr[mid] < x:\n                low = mid + 1\n            else:\n                high = mid - 1\n        return result\n\n    if not arr or n <= 0:\n        return False\n\n    first_idx = _find_first_occurrence(arr, x)\n    if first_idx == -1:\n        return False\n\n    last_idx = _find_last_occurrence(arr, x)\n\n    count = last_idx - first_idx + 1\n    majority_threshold = n / 2.0\n\n    return count > majority_threshold"}
{"task_id": "Mbpp/226", "solution": "def odd_values_string(input_string: str) -> str:\n    \"\"\"\n    Removes characters which have odd 0-based index values from a given string.\n    Returns a new string containing only characters from even index positions.\n    \"\"\"\n    result = []\n    for index, char in enumerate(input_string):\n        if index % 2 == 0:\n            result.append(char)\n    return \"\".join(result)"}
{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(number: int) -> int:\n    \"\"\"\n    Counts the number of set bits (1s) in the binary representation of an integer.\n    This implementation uses Brian Kernighan's algorithm and handles negative numbers by counting bits in their absolute value.\n    \"\"\"\n    count = 0\n    # Process the absolute value to handle both positive and negative inputs consistently.\n    num = abs(number)\n    while num > 0:\n        num &= (num - 1)\n        count += 1\n    return count"}
