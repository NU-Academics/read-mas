{"task_id": "Mbpp/754", "solution": "def extract_index_list(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Finds common elements from three lists where an element is common if it appears\n    in all three lists under the same index.\n    \"\"\"\n    min_length = min(len(list1), len(list2), len(list3))\n    common_elements = []\n\n    for i in range(min_length):\n        if list1[i] == list2[i] == list3[i]:\n            common_elements.append(list1[i])\n\n    return common_elements"}
{"task_id": "Mbpp/753", "solution": "def min_k(tuple_list: list[tuple], k: int) -> list[tuple]:\n    \"\"\"\n    Finds the minimum k records from a list of tuples, sorted by the second element.\n    This implementation uses an internal class to encapsulate the sorting logic.\n    \"\"\"\n    class MinKFinder:\n        \"\"\"\n        Encapsulates the logic for sorting a list of tuples and extracting the top k minimum records.\n        \"\"\"\n        def find_records(self, data: list[tuple], num_records: int) -> list[tuple]:\n            \"\"\"\n            Sorts the input list of tuples by their second element and returns the first num_records.\n            \"\"\"\n            if not data or num_records <= 0:\n                return []\n            \n            # Sort the list based on the second element of each tuple\n            # The lambda function specifies that the sorting key is the element at index 1\n            sorted_list = sorted(data, key=lambda x: x[1])\n            \n            # Return the first 'k' elements from the sorted list\n            return sorted_list[:num_records]\n\n    finder = MinKFinder()\n    return finder.find_records(tuple_list, k)"}
{"task_id": "Mbpp/760", "solution": "def unique_Element(numbers: list) -> bool:\n    \"\"\"\n    Checks if a list of numbers contains only one distinct element.\n    Returns True if the list contains exactly one distinct numerical value, False otherwise.\n    \"\"\"\n    if not numbers:\n        return False\n    return len(set(numbers)) == 1"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(numbers: list[int | float]) -> int | float:\n    \"\"\"Takes a list of numbers and returns the second smallest unique number.\n    It deduplicates, sorts, and selects the element at index 1.\"\"\"\n    unique_numbers = sorted(list(set(numbers)))\n    return unique_numbers[1]"}
{"task_id": "Mbpp/762", "solution": "def check_monthnumber_number(month_number: int) -> bool:\n    \"\"\"\n    Checks if the given month number corresponds to a month with 30 days.\n    Months are April (4), June (6), September (9), and November (11).\n    \"\"\"\n    return month_number in (4, 6, 9, 11)"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth Jacobsthal number using a dynamic programming approach.\n    The sequence is defined by J(0)=0, J(1)=1, and J(n) = J(n-1) + 2 * J(n-2) for n > 1.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    \n    # Initialize an array to store Jacobsthal numbers\n    # We only need the previous two values, so we can optimize space\n    a, b = 0, 1 # J(0), J(1)\n\n    for i in range(2, n + 1):\n        current_jacobsthal = b + 2 * a\n        a = b\n        b = current_jacobsthal\n    \n    return b"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr: list) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    Returns True if all parent-child comparisons satisfy the min-heap property (parent <= child),\n    False immediately upon the first violation.\n    \"\"\"\n    n = len(arr)\n\n    if n == 0:\n        return True\n\n    if n == 1:\n        return True\n\n    for i in range(n // 2):\n        parent_val = arr[i]\n\n        left_child_idx = 2 * i + 1\n        if left_child_idx < n:\n            left_child_val = arr[left_child_idx]\n            if parent_val > left_child_val:\n                return False\n\n        right_child_idx = 2 * i + 2\n        if right_child_idx < n:\n            right_child_val = arr[right_child_idx]\n            if parent_val > right_child_val:\n                return False\n\n    return True"}
{"task_id": "Mbpp/759", "solution": "import re\ndef _parse_decimal_parts(s: str) -> tuple[str, str] | None:\n    \"\"\"\n    Parses a string to extract its integer and fractional parts, validating basic decimal format.\n    Returns (integer_part, fractional_part) if valid, otherwise None.\n    \"\"\"\n    if not s:\n        return None\n\n    # Pattern ensures optional sign, integer part (at least one digit),\n    # optional fractional part (decimal point followed by at least one digit).\n    match = re.fullmatch(r'[-+]?(\\d+)(\\\\.(\\\\d+))?', s)\n    if not match:\n        return None\n\n    integer_part = match.group(1)\n    fractional_part = match.group(3) if match.group(3) is not None else ''\n\n    return (integer_part, fractional_part)\ndef is_decimal(input_string: str) -> bool:\n    \"\"\"\n    Checks whether a given string is a decimal number with a precision of 2.\n    Returns True if the input_string is a valid decimal number with exactly two digits\n    after the decimal point, False otherwise.\n    \"\"\"\n    parsed_parts = _parse_decimal_parts(input_string)\n\n    if parsed_parts is None:\n        return False\n\n    _, fractional_part = parsed_parts\n\n    if len(fractional_part) == 2:\n        return True\n    else:\n        return False"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"Counts unique pairs of reverse strings in the given list.\"\"\"\n\n    def _get_reverse_string(s: str) -> str:\n        \"\"\"Returns the reverse of the input string.\"\"\"\n        return s[::-1]\n\n    found_pairs = set()\n    string_set = set(string_list)\n\n    for s1 in string_list:\n        reversed_s1 = _get_reverse_string(s1)\n        if s1 != reversed_s1 and reversed_s1 in string_set:\n            # Form a canonical tuple to ensure uniqueness (e.g., (\"a\", \"b\") is same as (\"b\", \"a\"))\n            canonical_pair = tuple(sorted((s1, reversed_s1)))\n            found_pairs.add(canonical_pair)\n            \n    return len(found_pairs)"}
{"task_id": "Mbpp/758", "solution": "def unique_sublists(input_list: list) -> dict:\n    \"\"\"\n    Counts the occurrences of unique sublists within a list, converting each sublist to a tuple.\n    Returns a dictionary mapping these tuples to their counts.\n    \"\"\"\n    sublist_counts = {}\n    for sublist in input_list:\n        # Convert the sublist to a tuple to make it hashable for dictionary keys\n        tuple_key = tuple(sublist)\n        # Increment the count for the current tuple\n        sublist_counts[tuple_key] = sublist_counts.get(tuple_key, 0) + 1\n    return sublist_counts"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(input_string: str) -> int:\n    \"\"\"Counts the number of digit characters in the given string.\n\n    Iterates through the string and increments a counter for each digit found.\n    \"\"\"\n    digit_count = 0\n    for char in input_string:\n        if char.isdigit():\n            digit_count += 1\n    return digit_count"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"Calculates the sum of the fourth power of the first n odd natural numbers.\n    It iterates from 1 to n, finding each odd number, raising it to the fourth power, and summing the results.\n    \"\"\"\n    total_sum = 0\n    for k in range(1, n + 1):\n        odd_num = 2 * k - 1\n        total_sum += odd_num ** 4\n    return total_sum"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression_string: str) -> bool:\n    \"\"\"\n    Checks if the brackets in the given expression string are balanced.\n    Uses a stack-based approach to match opening and closing brackets.\n    \"\"\"\n    OPENING_BRACKETS = {'(', '[', '{'}\n    BRACKET_PAIRS = {')': '(', ']': '[', '}': '{'}\n    \n    stack = []\n\n    for char in expression_string:\n        if char in OPENING_BRACKETS:\n            stack.append(char)\n        elif char in BRACKET_PAIRS:\n            if not stack:\n                return False\n            if stack[-1] == BRACKET_PAIRS[char]:\n                stack.pop()\n            else:\n                return False\n    \n    return not stack"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list: list) -> list[tuple]:\n    \"\"\"\n    Returns a list of all pairs of consecutive items in the input list.\n    If the input list has less than two elements, an empty list is returned.\n    \"\"\"\n    if len(input_list) < 2:\n        return []\n    \n    return [(input_list[i], input_list[i+1]) for i in range(len(input_list) - 1)]"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1: list, list2: list) -> list:\n    \"\"\"\n    Calculates the difference between two lists.\n    Returns a new list containing elements from list1 that are not present in list2, while preserving their original relative order from list1.\n    \"\"\"\n    # For efficient lookup in list2, convert it to a set, optimizing 'in' operations to O(1) on average.\n    set2 = set(list2)\n\n    result_list = []\n    for item in list1:\n        if item not in set2:\n            result_list.append(item)\n\n    return result_list"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers_list: list[int | float], target_sum: int | float) -> int:\n    \"\"\"Counts the number of distinct pairs (by index) whose sum is equal to the target_sum.\"\"\"\n    pair_count = 0\n    n = len(numbers_list)\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers_list[i] + numbers_list[j] == target_sum:\n                pair_count += 1\n    return pair_count"}
{"task_id": "Mbpp/765", "solution": "def is_polite(n):\n    \"\"\"Finds the nth polite number. A polite number is a positive integer that is not a power of 2.\"\"\"\n    count = 0\n    num = 1\n    while True:\n        # Check if num is NOT a power of 2.\n        # A number x is a power of 2 if x > 0 and (x & (x - 1)) == 0.\n        # Thus, num is NOT a power of 2 if (num & (num - 1)) != 0.\n        if (num & (num - 1)) != 0:\n            count += 1\n        if count == n:\n            return num\n        num += 1"}
{"task_id": "Mbpp/763", "solution": "from typing import Union, List, Tuple\ndef find_min_diff(arr: Union[List[Union[int, float]], Tuple[Union[int, float], ...]], size: int) -> int:\n    \"\"\"Calculates the minimum absolute difference between any two distinct elements in the provided array.\n    The array is assumed to have at least two elements.\"\"\"\n    \n    sorted_arr = sorted(arr)\n    min_diff = float('inf')\n\n    for i in range(len(sorted_arr) - 1):\n        current_diff = abs(sorted_arr[i] - sorted_arr[i+1])\n        min_diff = min(min_diff, current_diff)\n\n    return int(min_diff)"}
{"task_id": "Mbpp/775", "solution": "def odd_position(list_of_numbers: list[int]) -> bool:\n    \"\"\"\n    Checks if every odd index in the given list contains an odd number.\n    Returns True if all numbers at odd indices are odd, False otherwise.\n    \"\"\"\n    def _is_odd(number: int) -> bool:\n        \"\"\"Checks if a given number is odd.\"\"\"\n        return number % 2 != 0\n\n    for index, num in enumerate(list_of_numbers):\n        if index % 2 != 0:  # Check if the current index is odd\n            if not _is_odd(num):  # If the number at an odd index is NOT odd\n                return False\n    return True"}
{"task_id": "Mbpp/772", "solution": "def remove_length(input_string: str, k: int) -> str:\n    \"\"\"Removes all words of a specific length k from the given string.\n\n    The remaining words are joined by a single space, preserving their original order.\n    \"\"\"\n    words = input_string.split()\n    filtered_words = [word for word in words if len(word) != k]\n    return ' '.join(filtered_words)"}
{"task_id": "Mbpp/777", "solution": "import collections\ndef find_sum(input_list: list) -> (int | float):\n    \"\"\"\n    Calculates the sum of non-repeated elements in a given list.\n    An element is considered non-repeated if its count within the input list is exactly one.\n    \"\"\"\n    element_counts = collections.Counter(input_list)\n    total_sum = 0\n    for element, count in element_counts.items():\n        if count == 1:\n            total_sum += element\n    return total_sum"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(main_string: str, substring: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Finds the first occurrence and position of a substring within a main string.\n    Returns a tuple (matched_substring, start_index, end_index) if found, otherwise None.\n    \"\"\"\n    if not main_string or not substring:\n        return None\n\n    start_index = main_string.find(substring)\n\n    if start_index != -1:\n        end_index = start_index + len(substring)\n        return (substring, start_index, end_index)\n    else:\n        return None"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list) -> list:\n    \"\"\"Packs consecutive identical elements of a list into sublists.\"\"\"\n    if not input_list:\n        return []\n\n    packed_list = []\n    current_sublist = []\n\n    for element in input_list:\n        if not current_sublist or element == current_sublist[0]:\n            current_sublist.append(element)\n        else:\n            packed_list.append(current_sublist)\n            current_sublist = [element]\n    \n    # Append the last sublist if it's not empty\n    if current_sublist:\n        packed_list.append(current_sublist)\n            \n    return packed_list"}
{"task_id": "Mbpp/780", "solution": "def find_combinations(tuple_list: list[tuple[int, int]]) -> list[tuple[int, int]]:\n    \"\"\"Calculates element-wise sums of all unique pairs of two-element tuples from an input list.\n\n    Args:\n        tuple_list: A list of two-element integer tuples.\n\n    Returns:\n        A list of two-element integer tuples, where each tuple is the element-wise\n        sum of two distinct tuples from the input list.\n    \"\"\"\n    import itertools\n\n    result_sums = []\n    # Generate all unique pairs of tuples from the input list\n    for t1, t2 in itertools.combinations(tuple_list, 2):\n        # Calculate the element-wise sum for each pair\n        sum_tuple = (t1[0] + t2[0], t1[1] + t2[1])\n        result_sums.append(sum_tuple)\n    return result_sums"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(number: int) -> bool:\n    \"\"\"Checks if the count of positive divisors for a given integer is even.\n    This uses the property that a number has an even count of divisors if and only if it is not a perfect square.\n    \"\"\"\n    import math\n\n    def _is_perfect_square(n: int) -> bool:\n        \"\"\"Checks if a given integer is a perfect square.\"\"\"\n        if n < 0:\n            return False\n        if n == 0:\n            return True\n        \n        sqrt_n = int(math.sqrt(n))\n        return sqrt_n * sqrt_n == n\n    \n    return not _is_perfect_square(number)"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(numbers: list[int | float]) -> int | float:\n    \"\"\"\n    Calculates the sum of all odd-length subarrays from an input list of numbers.\n    It iterates through all possible subarrays, sums those with odd lengths, and returns the total.\n    \"\"\"\n    total_sum = 0\n    n = len(numbers)\n\n    for i in range(n):\n        for j in range(i, n):\n            # Extract subarray from index i to j (inclusive)\n            subarray = numbers[i : j + 1]\n            # Check if the length of the subarray is odd\n            if len(subarray) % 2 != 0:\n                total_sum += sum(subarray)\n    return total_sum"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(sorted_list: list[float | int], value: float | int) -> int:\n    \"\"\"\n    Locates the right insertion point for a specified value in a sorted list.\n    Returns an index `i` such that all elements at indices less than `i` are less than or equal to `value`,\n    and all elements at indices greater than or equal to `i` are strictly greater than `value`.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] <= value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(numbers: list) -> int | None:\n    \"\"\"\n    Finds the product of the first even and first odd number in a list.\n    Returns None if either number type is not found.\n    \"\"\"\n    first_odd = None\n    first_even = None\n\n    for num in numbers:\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        if first_even is None and num % 2 == 0:\n            first_even = num\n\n        if first_odd is not None and first_even is not None:\n            break\n\n    if first_odd is not None and first_even is not None:\n        return first_odd * first_even\n    else:\n        return None"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(tuple_string: str) -> tuple:\n    import re\n\n    \"\"\"\n    Converts a string representation of a tuple into an actual tuple of integers.\n    \"\"\"\n    # Check if the string starts and ends with parentheses\n    if not (tuple_string.startswith('(') and tuple_string.endswith(')')):\n        raise ValueError(\"Input string must be enclosed in parentheses.\")\n\n    # Extract content inside parentheses and split by comma\n    content = tuple_string[1:-1].strip()\n    if not content:  # Handle empty tuple string like \"()\"\n        return ()\n\n    elements_str = re.split(r'\\s*,\\s*', content)\n\n    integer_elements = []\n    for element_str in elements_str:\n        # Each element must be convertible to an integer\n        try:\n            integer_elements.append(int(element_str.strip()))\n        except ValueError:\n            raise ValueError(f\"Element '{element_str}' is not a valid integer.\")\n\n    # The output must be an actual tuple containing integer elements.\n    return tuple(integer_elements)"}
{"task_id": "Mbpp/788", "solution": "def new_tuple(list_arg: list, string_arg: str) -> tuple:\n    \"\"\"\n    Creates a new tuple from the given list and string.\n    The returned tuple contains all elements from the input list,\n    preserving their order, followed by the input string as the last element.\n    \"\"\"\n    return tuple(list_arg + [string_arg])"}
