{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n\n    For example:\n    anti_shuffle('Hi') returns 'Hi'\n    anti_shuffle('hello') returns 'ehllo'\n    anti_shuffle('Hello World!!!') returns 'Hello !!!Wdlor'\n    \"\"\"\n    import re\n    parts = re.split(r'(\\s+)', s)\n    processed_parts = []\n    for part in parts:\n        if not part:\n            continue\n        if part.isspace():\n            processed_parts.append(part)\n        else:\n            processed_parts.append(''.join(sorted(part, key=ord)))\n    return ''.join(processed_parts)"}
{"task_id": "HumanEval/86", "solution": "import re\n\ndef anti_shuffle(s):\n    \"\"\"\n    Returns an ordered version of the string where words are sorted by character\n    ASCII value, preserving word and space order.\n    \"\"\"\n    separator = ' '\n    parts = re.split(f'({re.escape(separator)})', s)\n    \n    result_parts = []\n    for part in parts:\n        if part == separator:\n            result_parts.append(part)\n        else:\n            result_parts.append(''.join(sorted(part, key=ord)))\n            \n    return ''.join(result_parts)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds integer x in the 2D list lst and returns a list of (row, columns) coordinates.\n    Coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n    matches = []\n    for r_idx, row in enumerate(lst):\n        for c_idx, val in enumerate(row):\n            if val == x:\n                matches.append((r_idx, c_idx))\n\n    # Sort coordinates by row in ascending order, and by column in descending order\n    matches.sort(key=lambda coord: (coord[0], -coord[1]))\n    return matches"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds integer x in a jagged 2D list and returns a list of coordinates (row, column).\n    Coordinates are sorted by row ascending, then by column descending within each row.\n    \"\"\"\n    coordinates = []\n    for r_idx, row in enumerate(lst):\n        for c_idx, val in enumerate(row):\n            if val == x:\n                coordinates.append((r_idx, c_idx))\n\n    # Sort coordinates by row in ascending order, then by column in descending order.\n    # To sort by column descending, we use the negative of the column index.\n    coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return coordinates"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts an array based on the parity of the sum of its first and last elements.\n    Returns a new sorted array, leaving the original unchanged.\n    \"\"\"\n    if len(array) <= 1:\n        return list(array)\n\n    first_element = array[0]\n    last_element = array[-1]\n    sum_first_last = first_element + last_element\n\n    if sum_first_last % 2 == 1:  # Odd sum -> ascending order\n        return sorted(array)\n    else:  # Even sum -> descending order\n        return sorted(array, reverse=True)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n\n    Note:\n    * don't change the given array.\n\n    Examples:\n    * sort_array([]) => []\n    * sort_array([5]) => [5]\n    * sort_array([2, 4, 3, 0, 1, 5]) => [0, 1, 2, 3, 4, 5]\n    * sort_array([2, 4, 3, 0, 1, 5, 6]) => [6, 5, 4, 3, 2, 1, 0]\n    \"\"\"\n    if not array:\n        return []\n\n    first_val = array[0]\n    last_val = array[-1]\n\n    elements_sum = first_val + last_val\n\n    # Determine sorting order: odd sum -> ascending (reverse=False), even sum -> descending (reverse=True).\n    reverse_order = (elements_sum % 2 == 0)\n\n    # Return a new sorted list, ensuring the original array is not modified.\n    return sorted(array, reverse=reverse_order)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Create a function encrypt that takes a string as an argument and\n    returns a string encrypted with the alphabet being rotated. \n    The alphabet should be rotated in a manner such that the letters \n    shift down by two multiplied to two places.\n    For example:\n    encrypt('hi') returns 'lm'\n    encrypt('asdfghjkl') returns 'ewhjklnop'\n    encrypt('gf') returns 'kj'\n    encrypt('et') returns 'ix'\n    \"\"\"\n    ALPHABET = \"abcdefghijklmnopqrstuvwxyz\"\n    SHIFT = 4  # 2 multiplied to two places is 4\n    encrypted_chars = []\n\n    for char in s:\n        if char in ALPHABET:\n            # Find the index of the character in the alphabet\n            original_index = ALPHABET.index(char)\n            # Calculate the new index with rotation and wrap around\n            new_index = (original_index + SHIFT) % len(ALPHABET)\n            # Append the new character from the alphabet\n            encrypted_chars.append(ALPHABET[new_index])\n        else:\n            # If the character is not a lowercase letter, keep it unchanged\n            encrypted_chars.append(char)\n            \n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating lowercase alphabetic characters by a shift of 4 places.\n    Non-alphabetic characters are left unchanged.\n    \"\"\"\n    encrypted_chars = []\n    shift_amount = 4\n    for char in s:\n        if 'a' <= char <= 'z':\n            start_code = ord('a')\n            # Calculate the 0-indexed position, apply shift, and wrap around\n            shifted_code = start_code + (ord(char) - start_code + shift_amount) % 26\n            encrypted_chars.append(chr(shifted_code))\n        else:\n            # Keep non-lowercase alphabetic characters unchanged\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    You are given a list of integers.\n    Write a function next_smallest() that returns the 2nd smallest element of the list.\n    Return None if there is no such element.\n    \n    next_smallest([1, 2, 3, 4, 5]) == 2\n    next_smallest([5, 1, 4, 3, 2]) == 2\n    next_smallest([]) == None\n    next_smallest([1, 1]) == None\n    \"\"\"\n    min1 = float(\"inf\")\n    min2 = float(\"inf\")\n\n    for x in lst:\n        if x < min1:\n            min2 = min1\n            min1 = x\n        elif min1 < x < min2:\n            min2 = x\n            \n    return None if min2 == float(\"inf\") else int(min2)"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    You are given a list of integers.\n    Write a function next_smallest() that returns the 2nd smallest element of the list.\n    Return None if there is no such element.\n    \n    next_smallest([1, 2, 3, 4, 5]) == 2\n    next_smallest([5, 1, 4, 3, 2]) == 2\n    next_smallest([]) == None\n    next_smallest([1, 1]) == None\n    \"\"\"\n    if not lst:\n        return None\n\n    min1 = float('inf') # Stores the smallest element found so far\n    min2 = float('inf') # Stores the second smallest distinct element found so far\n\n    for x in lst:\n        if x < min1:\n            min2 = min1\n            min1 = x\n        elif x < min2 and x != min1:\n            min2 = x\n\n    if min2 == float('inf'):\n        return None\n    else:\n        return min2"}
{"task_id": "HumanEval/91", "solution": "import re\n\ndef is_bored(S):\n    \"\"\"\n    Counts the number of \"boredoms\" in a string. A boredom is a sentence\n    that starts with the word \"I\". Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    boredom_count = 0\n    # Normalize line endings and strip overall leading/trailing whitespace\n    normalized_text = S.replace(\"\\r\\n\", \"\\n\").strip()\n\n    # Split the text into sentence fragments using common delimiters.\n    # The regex splits on one or more occurrences of '.', '?', or '!'\n    # and implicitly handles the final fragment if it lacks terminal punctuation.\n    sentence_fragments = [p for p in re.split(r'[.?!]+', normalized_text) if p is not None]\n\n    for fragment in sentence_fragments:\n        # Clean leading punctuation, quotes, and whitespace from the fragment.\n        # This includes common quotes and parentheses as specified in design context.\n        cleaned_fragment = fragment.strip().lstrip('\"\\'' + \"\u2018\u201c(\").strip()\n\n        # Check if the cleaned fragment is not empty and starts with the word \"I\" (case-insensitive).\n        words = cleaned_fragment.split()\n        if words and words[0].lower() == \"i\":\n            boredom_count += 1\n\n    return boredom_count"}
{"task_id": "HumanEval/91", "solution": "import re\n\ndef is_bored(S):\n    \"\"\"\n    You'll be given a string of words, and your task is to count the number\n    of boredoms. A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n   \n    For example:\n    >>> is_bored(\"Hello world\")\n    0\n    >>> is_bored(\"The sky is blue. The sun is shining. I love this weather\")\n    1\n    \"\"\"\n    \n    # Define the characters that delimit sentences.\n    SENTENCE_DELIMITERS = {'.', '?', '!'}\n    \n    # Create a regex pattern to split the string by any of the delimiters.\n    # re.escape ensures that special regex characters in delimiters are treated literally.\n    pattern = r'[{}]'.format(''.join(map(re.escape, SENTENCE_DELIMITERS)))\n    \n    # Split the input string into potential sentence segments.\n    # Each segment is stripped of leading/trailing whitespace, and empty segments are discarded.\n    raw_sentences = re.split(pattern, S)\n    sentences = [s.strip() for s in raw_sentences if s.strip()]\n    \n    boredom_count = 0\n    \n    # Iterate through each valid sentence to check for boredom.\n    for sentence in sentences:\n        trimmed_sentence = sentence.strip()\n        \n        # If the trimmed sentence is not empty, check its first word.\n        if trimmed_sentence:\n            # Split the sentence by whitespace and take the first token.\n            first_word = trimmed_sentence.split(maxsplit=1)[0]\n            \n            # A boredom occurs if the first word is exactly \"I\" (case-sensitive).\n            if first_word == \"I\":\n                boredom_count += 1\n                \n    return boredom_count"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n    '''\n    # Check if all three numbers are integers (e.g., 3.0 counts as an integer).\n    # This relies on the inputs being valid numeric types where int() will not raise an error.\n    if (x == int(x)) and (y == int(y)) and (z == int(z)):\n        # If all are integers, check if one is the sum of the other two.\n        if (x == y + z) or (y == x + z) or (z == x + y):\n            return True\n    # Return False if not all numbers are integers or if the sum condition is not met.\n    return False"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n    \n    Examples\n    any_int(5, 2, 7) \u279e True\n    \n    any_int(3, 2, 2) \u279e False\n\n    any_int(3, -2, 1) \u279e True\n    \n    any_int(3.6, -2.2, 2) \u279e False\n  \n\n    \n    '''\n    # Helper to check if a value is an integer or an integer-like float (e.g., 3.0)\n    def _is_integer_like(val):\n        return isinstance(val, int) or (isinstance(val, float) and val.is_integer())\n\n    # Helper to convert an integer-like value to an actual int\n    def _to_int(val):\n        if isinstance(val, float):\n            return int(val)\n        return val\n\n    # Check if all inputs are integers (or integer-like floats)\n    if not (_is_integer_like(x) and _is_integer_like(y) and _is_integer_like(z)):\n        return False\n\n    # Convert all inputs to integers for the sum check\n    x_int = _to_int(x)\n    y_int = _to_int(y)\n    z_int = _to_int(z)\n\n    # Check if one of the numbers is equal to the sum of the other two\n    return (x_int == y_int + z_int) or \\\n           (y_int == x_int + z_int) or \\\n           (z_int == x_int + y_int)"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping case of all letters and replacing\n    vowels with the letter 2 places ahead in the English alphabet.\n    Non-letter characters (like spaces) are preserved.\n    \"\"\"\n    VOWELS_LOWER = \"aeiou\"\n    VOWELS_UPPER = \"AEIOU\"\n    VOWEL_OFFSET = 2\n\n    def _shift_char(char, offset):\n        \"\"\"Shifts an alphabetic character forward by offset, preserving case and wrapping around.\"\"\"\n        if not char.isalpha():\n            return char\n\n        base = ord('A') if char.isupper() else ord('a')\n        shifted_ord = (ord(char) - base + offset) % 26 + base\n        return chr(shifted_ord)\n\n    def _shift_vowels_in_string(s, offset):\n        \"\"\"Replaces vowels in a string with characters shifted by offset.\"\"\"\n        result_chars = []\n        for char in s:\n            if char in VOWELS_LOWER or char in VOWELS_UPPER:\n                result_chars.append(_shift_char(char, offset))\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)\n\n    swapped_case_message = message.swapcase()\n    encoded_message = _shift_vowels_in_string(swapped_case_message, VOWEL_OFFSET)\n\n    return encoded_message"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping case of all letters and replacing vowels with\n    the letter 2 places ahead in the alphabet, maintaining case.\n    \"\"\"\n    encoded_chars = []\n    ALPHABET = \"abcdefghijklmnopqrstuvwxyz\"\n    VOWELS = \"aeiou\"\n    \n    # Pre-compute vowel mapping for efficiency\n    vowel_replacement_map = {}\n    for v in VOWELS:\n        idx = ALPHABET.index(v)\n        replacement_char = ALPHABET[(idx + 2) % len(ALPHABET)]\n        vowel_replacement_map[v] = replacement_char\n\n    for char in message:\n        if not char.isalpha():\n            # If not a letter (e.g., space), append as is.\n            encoded_chars.append(char)\n            continue\n\n        processed_char_after_vowel_map = char\n\n        # Step 1: Apply vowel replacement if the character is a vowel.\n        char_lower = char.lower()\n        if char_lower in vowel_replacement_map:\n            replacement_lower = vowel_replacement_map[char_lower]\n            if char.isupper():\n                processed_char_after_vowel_map = replacement_lower.upper()\n            else:\n                processed_char_after_vowel_map = replacement_lower\n        \n        # Step 2: Swap the case of the character (after potential vowel mapping).\n        final_char = processed_char_after_vowel_map.swapcase()\n        \n        encoded_chars.append(final_char)\n    \n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a number is prime using an optimized trial division method.\n        It efficiently handles numbers greater than 3 by checking divisibility with numbers of the form 6k \u00b1 1.\n        \"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def sum_of_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the digits of a given integer.\n        It uses the absolute value of the number to handle potential negative inputs gracefully.\n        \"\"\"\n        return sum(int(d) for d in str(abs(n)))\n\n    largest_prime = 0  # Initialize with 0, which is not prime, to ensure any prime found will be larger.\n\n    for num in lst:\n        if is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n    \n    # If no prime numbers are found in the list, largest_prime will remain 0.\n    # The sum of digits of 0 is 0, which is a reasonable default for no primes,\n    # and adheres to the constraint of not raising exceptions for edge cases.\n    return sum_of_digits(largest_prime)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower \n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    Examples:\n    check_dict_case({\"a\":\"apple\", \"b\":\"banana\"}) should return True.\n    check_dict_case({\"a\":\"apple\", \"A\":\"banana\", \"B\":\"banana\"}) should return False.\n    check_dict_case({\"a\":\"apple\", 8:\"banana\", \"a\":\"apple\"}) should return False.\n    check_dict_case({\"Name\":\"John\", \"Age\":\"36\", \"City\":\"Houston\"}) should return False.\n    check_dict_case({\"STATE\":\"NC\", \"ZIP\":\"12345\" }) should return True.\n    \"\"\"\n    if not dict:\n        return False\n\n    # Check if all keys are strings. If any key is not a string, return False.\n    if not all(isinstance(key, str) for key in dict.keys()):\n        return False\n\n    # Determine if all keys are lowercase or all keys are uppercase.\n    all_lower = all(key == key.lower() for key in dict.keys())\n    all_upper = all(key == key.upper() for key in dict.keys())\n\n    return all_lower or all_upper"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"Finds the largest prime in a list of integers and returns the sum of its digits.\"\"\"\n    from math import isqrt\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a number is prime using trial division.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i <= isqrt(n):\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the digits of a non-negative integer.\"\"\"\n        return sum(int(digit) for digit in str(abs(n)))\n\n    largest_prime_val = -1\n\n    for num in lst:\n        if is_prime(num):\n            if num > largest_prime_val:\n                largest_prime_val = num\n\n    # Based on examples, it is guaranteed that a prime will be found.\n    # Therefore, largest_prime_val will be >= 2.\n    return sum_digits(largest_prime_val)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower \n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    Examples:\n    check_dict_case({\"a\":\"apple\", \"b\":\"banana\"}) should return True.\n    check_dict_case({\"a\":\"apple\", \"A\":\"banana\", \"B\":\"banana\"}) should return False.\n    check_dict_case({\"a\":\"apple\", 8:\"banana\", \"a\":\"apple\"}) should return False.\n    check_dict_case({\"Name\":\"John\", \"Age\":\"36\", \"City\":\"Houston\"}) should return False.\n    check_dict_case({\"STATE\":\"NC\", \"ZIP\":\"12345\" }) should return True.\n    \"\"\"\n    # Return False if the input is not a dictionary or if the dictionary is empty.\n    if not isinstance(dict, dict) or not dict:\n        return False\n\n    # Return False if any key is not a string.\n    if any(not isinstance(key, str) for key in dict):\n        return False\n\n    # Check if all keys are lowercase strings.\n    # str.islower() returns False for strings without any cased characters.\n    all_lower = all(key.islower() for key in dict)\n\n    # Check if all keys are uppercase strings.\n    # str.isupper() returns False for strings without any cased characters.\n    all_upper = all(key.isupper() for key in dict)\n\n    # Return True if all keys are uniformly lowercase OR uniformly uppercase.\n    return all_lower or all_upper"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"Implement a function that takes a non-negative integer and returns an array of prime numbers less than n.\"\"\"\n    if n <= 2:\n        return []\n\n    sieve = bytearray(b\"\\x01\") * n\n    sieve[0:2] = b\"\\x00\\x00\"  # 0 and 1 are not prime\n\n    import math\n    # Iterate from 2 up to the square root of n\n    for p in range(2, int(math.isqrt(n)) + 1):\n        if sieve[p]:\n            # Mark all multiples of p as not prime\n            start = p * p\n            step = p\n            # Optimized slicing to set multiples to 0\n            sieve[start:n:step] = b\"\\x00\" * ((n - 1 - start) // step + 1)\n\n    # Collect all numbers that are still marked as prime\n    return [i for i, is_prime in enumerate(sieve) if is_prime]"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"Returns a list of prime numbers strictly less than n.\n    Uses the Sieve of Eratosthenes algorithm for efficient computation.\n    \"\"\"\n    if n <= 2:\n        return []\n\n    import math\n    \n    # Initialize a boolean array 'sieve'\n    # sieve[i] will be true if i is prime, false otherwise.\n    # We use bytearray for memory efficiency with boolean-like values.\n    sieve = bytearray(b'\\x01') * n\n    \n    # 0 and 1 are not prime numbers\n    sieve[0:2] = b'\\x00\\x00'\n\n    # Iterate from 2 up to the square root of n.\n    # All multiples of a prime p up to n will have been marked by p or a prime smaller than p.\n    for p in range(2, int(math.isqrt(n - 1)) + 1):\n        # If sieve[p] is still 1 (true), then p is a prime number\n        if sieve[p]:\n            # Mark all multiples of p as not prime.\n            # Start marking from p*p, as smaller multiples (p*2, p*3, ...)\n            # would have already been marked by smaller prime factors.\n            start_index = p * p\n            step = p\n            \n            # Calculate the number of elements to mark in the slice.\n            # This is equivalent to `(n - 1 - start_index) // step + 1`\n            # for `range(start_index, n, step)`.\n            num_multiples_to_mark = ((n - 1 - start_index) // step) + 1\n            \n            # Use slice assignment for efficiency to set multiples to 0.\n            sieve[start_index:n:step] = b'\\x00' * num_multiples_to_mark\n            \n    # Collect all numbers for which sieve[i] is true (1)\n    primes = [i for i, is_prime in enumerate(sieve) if is_prime]\n    \n    return primes"}
