{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n. \"\"\"\n    import math\n\n    # If n is even, n // 2 is the largest proper divisor.\n    if n % 2 == 0:\n        return n // 2\n\n    # Iterate from 3 up to sqrt(n), checking only odd numbers.\n    # The first divisor i found means n // i is the largest proper divisor.\n    for i in range(3, int(math.isqrt(n)) + 1, 2):\n        if n % i == 0:\n            return n // i\n\n    # If no divisors were found other than 1 and n itself, n must be a prime number.\n    # In this case, 1 is the largest number that divides n evenly and is smaller than n.\n    return 1"}
{"task_id": "HumanEval/24", "solution": "import math\n\ndef largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    # If n is even, its largest proper divisor is n / 2.\n    if n % 2 == 0:\n        return n // 2\n\n    # For odd numbers, iterate from 3 up to sqrt(n) with a step of 2.\n    # The first divisor 'i' found will yield 'n // i' as the largest proper divisor.\n    limit = int(math.isqrt(n))\n    for i in range(3, limit + 1, 2):\n        if n % i == 0:\n            return n // i\n\n    # If no divisors were found in the loop, 'n' must be a prime number.\n    # For a prime number, the largest divisor smaller than 'n' is 1.\n    return 1"}
{"task_id": "HumanEval/25", "solution": "import math\nimport random\nfrom collections import OrderedDict\nfrom typing import List, Optional, Iterator, Tuple\nfrom abc import ABC, abstractmethod\n\n# --- _config.py constants ---\nDEFAULT_MAX_TRIAL: int = 100000\nPOLLARD_RETRIES: int = 5\nCACHE_MAX_SIZE: int = 1024\n\n# --- exceptions.py ---\nclass FactorizationError(Exception):\n    \"\"\"Exception raised for factorization errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\n# --- cache.py ---\nclass FactorCache:\n    \"\"\"Lightweight in-memory LRU cache for factorization results.\"\"\"\n    def __init__(self, max_size: int = CACHE_MAX_SIZE):\n        self.max_size = max_size\n        self._store: OrderedDict[int, List[int]] = OrderedDict()\n\n    def get(self, n: int) -> Optional[List[int]]:\n        \"\"\"Retrieve factors for n from cache, updating its recency.\"\"\"\n        if n in self._store:\n            factors = self._store.pop(n)\n            self._store[n] = factors\n            return factors\n        return None\n\n    def set(self, n: int, factors: List[int]) -> None:\n        \"\"\"Store factors for n in cache, handling max_size.\"\"\"\n        if n in self._store:\n            self._store.pop(n)\n        self._store[n] = factors\n        if len(self._store) > self.max_size:\n            self._store.popitem(last=False)\n\n    def clear(self) -> None:\n        \"\"\"Clear the cache.\"\"\"\n        self._store.clear()\n\n# --- utils.py ---\ndef gcd(a: int, b: int) -> int:\n    \"\"\"Return the greatest common divisor of a and b.\"\"\"\n    while b:\n        a, b = b, a % b\n    return a\n\ndef powmod(base: int, exp: int, mod: int) -> int:\n    \"\"\"Compute (base^exp) % mod efficiently.\"\"\"\n    res = 1\n    base %= mod\n    while exp > 0:\n        if exp % 2 == 1:\n            res = (res * base) % mod\n        base = (base * base) % mod\n        exp //= 2\n    return res\n\ndef _small_primes_generator(limit: int) -> Iterator[int]:\n    \"\"\"Generate small prime numbers up to a given limit.\"\"\"\n    if limit >= 2: yield 2\n    if limit >= 3: yield 3\n    i = 5\n    while i <= limit:\n        yield i\n        if i + 2 <= limit:\n            yield i + 2\n        i += 6\n\n# Deterministic Miller-Rabin bases for numbers up to 2^64\n_MR_BASES_64_BIT = [2, 325, 9375, 28178, 450775, 9780504, 1795265022]\n\ndef _miller_rabin(n: int) -> bool:\n    \"\"\"Perform Miller-Rabin primality test for n.\"\"\"\n    d = n - 1\n    s = 0\n    while d % 2 == 0:\n        d //= 2\n        s += 1\n\n    for a in _MR_BASES_64_BIT:\n        if a >= n:\n            continue\n        x = powmod(a, d, n)\n        if x == 1 or x == n - 1:\n            continue\n        \n        composite = True\n        for _ in range(s - 1):\n            x = powmod(x, 2, n)\n            if x == n - 1:\n                composite = False\n                break\n        if composite:\n            return False\n    return True\n\ndef is_prime(n: int) -> bool:\n    \"\"\"Determine if an integer n is prime using trial division and Miller-Rabin.\"\"\"\n    if n < 2: return False\n    if n == 2 or n == 3: return True\n    if n % 2 == 0 or n % 3 == 0: return False\n\n    # Trial division for small primes\n    for p in range(5, min(int(n**0.5) + 1, 1000), 6):\n        if n % p == 0: return False\n        if n % (p + 2) == 0: return False\n    \n    # Miller-Rabin test for larger numbers\n    return _miller_rabin(n)\n\ndef _random_seed() -> int:\n    \"\"\"Generate a random seed for Pollard's Rho.\"\"\"\n    return random.randint(2, 1_000_000) # Increased range for better randomness\n\n# --- strategies.py ---\nclass FactorizationStrategy(ABC):\n    \"\"\"Abstract base class for factorization strategies.\"\"\"\n    @abstractmethod\n    def factor(self, n: int) -> List[int]:\n        \"\"\"Return a list of prime factors for n.\"\"\"\n        pass\n\nclass TrialDivisionStrategy(FactorizationStrategy):\n    \"\"\"Factors a number using trial division up to a maximum trial divisor.\"\"\"\n    def __init__(self, max_trial: int = DEFAULT_MAX_TRIAL):\n        self.max_trial = max_trial\n\n    def factor(self, n: int) -> List[int]:\n        factors = []\n        remainder = n\n        \n        # Trial divide by 2\n        while remainder > 1 and remainder % 2 == 0:\n            factors.append(2)\n            remainder //= 2\n\n        # Trial divide by odd primes up to sqrt(remainder) or max_trial\n        limit_for_td = min(int(remainder**0.5) + 1, self.max_trial)\n        for p in _small_primes_generator(limit_for_td):\n            if p == 2: continue # Already handled\n            if remainder % p == 0:\n                while remainder % p == 0:\n                    factors.append(p)\n                    remainder //= p\n                if remainder == 1:\n                    break\n        \n        return factors\n\nclass PollardRhoStrategy(FactorizationStrategy):\n    \"\"\"Factors a number using Pollard's Rho algorithm.\"\"\"\n    def __init__(self, max_tries: int = POLLARD_RETRIES):\n        self.max_tries = max_tries\n\n    def _pollard_rho(self, n: int, seed: int) -> int:\n        \"\"\"Finds a non-trivial factor of n using Pollard's Rho algorithm.\"\"\"\n        if n % 2 == 0: return 2\n        \n        x = seed\n        y = seed\n        d = 1\n        c = 1 # Common constant for the function f(x) = (x^2 + c) % n\n\n        while d == 1:\n            x = (x * x + c) % n\n            y = (y * y + c) % n\n            y = (y * y + c) % n # Move y two steps\n            d = gcd(abs(x - y), n)\n\n            if d == n: # Cycle detected, but no non-trivial factor. Try a new seed.\n                return 1 \n        return d\n\n    def factor(self, n: int) -> List[int]:\n        \"\"\"Factors n into prime factors using Pollard's Rho, possibly recursively.\"\"\"\n        if n <= 1:\n            return []\n        if is_prime(n):\n            return [n]\n        \n        # This handles even numbers that might reach Pollard Rho if not fully handled by trial division\n        if n % 2 == 0:\n            return [2] + self.factor(n // 2)\n\n        for _ in range(self.max_tries):\n            seed = _random_seed()\n            factor_found = self._pollard_rho(n, seed)\n            \n            if factor_found > 1 and factor_found < n:\n                # Recursively factor the found factor and the remaining part\n                left_factors = self.factor(factor_found)\n                right_factors = self.factor(n // factor_found)\n                return sorted(left_factors + right_factors)\n        \n        # If no factor found after max_tries, raise an error.\n        raise FactorizationError(f\"Pollard Rho failed to find a factor for {n} after {self.max_tries} attempts.\")\n\n# --- factorizer.py ---\nclass PrimeFactorizer:\n    \"\"\"Orchestrates prime factorization using various strategies and caching.\"\"\"\n    def __init__(self, cache: Optional[FactorCache] = None, \n                 strategies: Optional[List[FactorizationStrategy]] = None, \n                 config: Optional[dict] = None):\n        self.cache = cache if cache is not None else FactorCache(max_size=CACHE_MAX_SIZE)\n        self.config = config if config is not None else {}\n        \n        if strategies is None:\n            self._trial_strategy = TrialDivisionStrategy(self.config.get('max_trial', DEFAULT_MAX_TRIAL))\n            self._pollard_strategy = PollardRhoStrategy(self.config.get('pollard_retries', POLLARD_RETRIES))\n            self.strategies = [self._trial_strategy, self._pollard_strategy]\n        else:\n            self.strategies = strategies\n            # Assume specific strategies for internal use based on order or type\n            self._trial_strategy = next((s for s in strategies if isinstance(s, TrialDivisionStrategy)), None)\n            self._pollard_strategy = next((s for s in strategies if isinstance(s, PollardRhoStrategy)), None)\n\n    def _validate_input(self, n: int) -> None:\n        \"\"\"Validate input n, raising FactorizationError for invalid values.\"\"\"\n        if not isinstance(n, int):\n            raise FactorizationError(\"Input must be an integer.\")\n        if n < 2:\n            raise FactorizationError(\"Input must be an integer >= 2.\")\n\n    def factorize(self, n: int) -> List[int]:\n        \"\"\"Return the prime factors of n, sorted from smallest to largest.\"\"\"\n        self._validate_input(n)\n\n        cached = self.cache.get(n)\n        if cached:\n            return cached\n\n        factors: List[int] = []\n        remainder = n\n\n        # Apply trial division first\n        if self._trial_strategy:\n            trial_factors = self._trial_strategy.factor(remainder)\n            factors.extend(trial_factors)\n            if trial_factors:\n                remainder //= math.prod(trial_factors) # Calculate new remainder\n\n        # If remainder is still > 1, check for primality or apply other strategies\n        if remainder > 1:\n            if is_prime(remainder):\n                factors.append(remainder)\n            elif self._pollard_strategy:\n                # Recursively factor the remainder using Pollard Rho\n                pollard_found_factors = self._pollard_strategy.factor(remainder)\n                factors.extend(pollard_found_factors)\n            else:\n                raise FactorizationError(f\"No strategy found to factorize remaining composite number {remainder}\")\n\n        factors.sort()\n        self.cache.set(n, factors)\n        return factors\n\n# --- __init__.py (public API wrapper) ---\n\n# Global instances for the public factorize function as per design\n_default_cache = FactorCache(max_size=CACHE_MAX_SIZE)\n_default_factorizer = PrimeFactorizer(cache=_default_cache)\n\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    return _default_factorizer.factorize(n)"}
{"task_id": "HumanEval/26", "solution": "def remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    from collections import Counter\n\n    counts = Counter(numbers)\n    return [x for x in numbers if counts[x] == 1]"}
{"task_id": "HumanEval/25", "solution": "from typing import List, Optional, Dict, Any\nimport os\nimport sqlite3\nimport json\nimport math\nfrom datetime import datetime, timedelta, timezone\n\n\nclass FactorizationError(Exception):\n    \"\"\"Custom exception for factorization-related errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n\nclass Config:\n    \"\"\"Centralized configuration for the prime factorizer.\"\"\"\n    DEFAULT_DB_PATH = \"./cache.db\"\n    DEFAULT_CACHE_TTL = 2592000  # 30 days in seconds\n\n    def __init__(self, db_path: str = DEFAULT_DB_PATH, cache_ttl_seconds: int = DEFAULT_CACHE_TTL, api_key: Optional[str] = None) -> None:\n        self.db_path = db_path\n        self.cache_ttl_seconds = cache_ttl_seconds\n        self.api_key = api_key\n\n    @classmethod\n    def from_env(cls) -> \"Config\":\n        \"\"\"Load configuration from environment variables.\"\"\"\n        db_path = os.getenv(\"PF_DB_PATH\", cls.DEFAULT_DB_PATH)\n        cache_ttl_seconds_str = os.getenv(\"PF_CACHE_TTL\", str(cls.DEFAULT_CACHE_TTL))\n        cache_ttl_seconds = int(cache_ttl_seconds_str)\n        api_key = os.getenv(\"PF_API_KEY\")\n        return cls(db_path=db_path, cache_ttl_seconds=cache_ttl_seconds, api_key=api_key)\n\n\nclass FactorizationResult:\n    \"\"\"DTO for storing and retrieving factorization results.\"\"\"\n    def __init__(self, n: int, factors: List[int], created_at: datetime, ttl_seconds: int) -> None:\n        self.n = n\n        self.factors = factors\n        self.created_at = created_at\n        self.ttl_seconds = ttl_seconds\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Convert the result to a dictionary for serialization.\"\"\"\n        return {\n            \"n\": self.n,\n            \"factors\": self.factors,\n            \"created_at\": self.created_at.timestamp(),\n            \"ttl_seconds\": self.ttl_seconds,\n        }\n\n    @classmethod\n    def from_dict(cls, d: Dict[str, Any]) -> \"FactorizationResult\":\n        \"\"\"Create a FactorizationResult from a dictionary.\"\"\"\n        try:\n            return cls(\n                n=d[\"n\"],\n                factors=d[\"factors\"],\n                created_at=datetime.fromtimestamp(d[\"created_at\"], tz=timezone.utc),\n                ttl_seconds=d[\"ttl_seconds\"],\n            )\n        except KeyError as e:\n            raise ValueError(f\"Missing key in dictionary for FactorizationResult: {e}\")\n\n\nclass Validator:\n    \"\"\"Utility for validating input parameters.\"\"\"\n    @staticmethod\n    def validate_n(n: int) -> None:\n        \"\"\"Validate that n is an integer >= 2.\"\"\"\n        if not isinstance(n, int):\n            raise FactorizationError(\"Input 'n' must be an integer.\")\n        if n < 2:\n            raise FactorizationError(\"Input 'n' must be an integer greater than or equal to 2.\")\n\n\nclass PrimeUtils:\n    \"\"\"Utility class for prime number related operations.\"\"\"\n    @staticmethod\n    def trial_division(n: int) -> List[int]:\n        \"\"\"Perform trial division to find prime factors of n.\"\"\"\n        factors = []\n        # Handle factor 2\n        while n % 2 == 0:\n            factors.append(2)\n            n //= 2\n        # Handle odd factors\n        f = 3\n        while f * f <= n:\n            while n % f == 0:\n                factors.append(f)\n                n //= f\n            f += 2\n        # If n is still greater than 1, it must be a prime factor itself\n        if n > 1:\n            factors.append(n)\n        return factors\n\n\nclass SQLiteAdapter:\n    \"\"\"Low-level adapter for SQLite database interactions.\"\"\"\n    def __init__(self, db_path: str) -> None:\n        self.db_path = db_path\n        self.ensure_schema()\n\n    def _get_conn(self) -> sqlite3.Connection:\n        \"\"\"Establish and return a database connection.\"\"\"\n        conn = sqlite3.connect(self.db_path, detect_types=sqlite3.PARSE_DECLTYPES | sqlite3.PARSE_COLNAMES)\n        conn.row_factory = sqlite3.Row\n        conn.execute(\"PRAGMA journal_mode=WAL;\") # Enable WAL for better concurrency\n        return conn\n\n    def ensure_schema(self) -> None:\n        \"\"\"Create the cache table if it doesn't exist.\"\"\"\n        with self._get_conn() as conn:\n            conn.execute(\n                \"\"\"\n                CREATE TABLE IF NOT EXISTS factor_cache (\n                    n INTEGER PRIMARY KEY NOT NULL,\n                    factors TEXT NOT NULL,\n                    created_at REAL NOT NULL,\n                    ttl_seconds INTEGER NOT NULL\n                )\n                \"\"\"\n            )\n            conn.execute(\n                \"CREATE INDEX IF NOT EXISTS idx_factor_cache_created_at ON factor_cache(created_at);\"\n            )\n            conn.commit()\n\n    def fetch(self, n: int) -> Optional[Dict[str, Any]]:\n        \"\"\"Fetch a cached entry by number n.\"\"\"\n        with self._get_conn() as conn:\n            cursor = conn.execute(\"SELECT n, factors, created_at, ttl_seconds FROM factor_cache WHERE n = ?\", (n,))\n            row = cursor.fetchone()\n            if row:\n                return dict(row)\n            return None\n\n    def upsert(self, n: int, factors_json: str, created_at: float, ttl_seconds: int) -> None:\n        \"\"\"Insert or update a factorization result in the cache.\"\"\"\n        with self._get_conn() as conn:\n            conn.execute(\n                \"\"\"\n                INSERT INTO factor_cache (n, factors, created_at, ttl_seconds)\n                VALUES (?, ?, ?, ?)\n                ON CONFLICT(n) DO UPDATE SET\n                    factors=excluded.factors,\n                    created_at=excluded.created_at,\n                    ttl_seconds=excluded.ttl_seconds;\n                \"\"\",\n                (n, factors_json, created_at, ttl_seconds),\n            )\n            conn.commit()\n\n    def delete_expired(self) -> None:\n        \"\"\"Delete expired entries from the cache.\"\"\"\n        current_time = datetime.now(timezone.utc).timestamp()\n        with self._get_conn() as conn:\n            conn.execute(\"DELETE FROM factor_cache WHERE (created_at + ttl_seconds) < ?\", (current_time,))\n            conn.commit()\n\n\nclass CacheRepository:\n    \"\"\"High-level interface for managing the factorization cache.\"\"\"\n    def __init__(self, adapter: SQLiteAdapter) -> None:\n        self._adapter = adapter\n\n    def get(self, n: int) -> Optional[FactorizationResult]:\n        \"\"\"Retrieve a factorization result from the cache if not expired.\"\"\"\n        data = self._adapter.fetch(n)\n        if data:\n            result = FactorizationResult.from_dict({\n                \"n\": data[\"n\"],\n                \"factors\": json.loads(data[\"factors\"]),\n                \"created_at\": data[\"created_at\"],\n                \"ttl_seconds\": data[\"ttl_seconds\"],\n            })\n            # Check for expiration\n            if datetime.now(timezone.utc) - result.created_at < timedelta(seconds=result.ttl_seconds):\n                return result\n        return None\n\n    def set(self, result: FactorizationResult) -> None:\n        \"\"\"Store a factorization result in the cache.\"\"\"\n        factors_json = json.dumps(result.factors)\n        self._adapter.upsert(result.n, factors_json, result.created_at.timestamp(), result.ttl_seconds)\n\n    def purge_expired(self) -> None:\n        \"\"\"Remove all expired entries from the cache.\"\"\"\n        self._adapter.delete_expired()\n\n\nclass Factorizer:\n    \"\"\"Orchestrates factorization, caching, and validation.\"\"\"\n    def __init__(self, cache_repo: CacheRepository, config: Config) -> None:\n        self._cache_repo = cache_repo\n        self._config = config\n\n    def factorize(self, n: int) -> List[int]:\n        \"\"\"Compute the prime factorization of n, using cache if available.\"\"\"\n        Validator.validate_n(n)  # Validate input number\n\n        # Try to retrieve from cache\n        cached_result = self._cache_repo.get(n)\n        if cached_result:\n            return cached_result.factors\n\n        # If not in cache, compute factorization\n        factors = PrimeUtils.trial_division(n)\n\n        # Store in cache\n        current_time = datetime.now(timezone.utc)\n        result = FactorizationResult(\n            n=n,\n            factors=factors,\n            created_at=current_time,\n            ttl_seconds=self._config.cache_ttl_seconds,\n        )\n        self._cache_repo.set(result)\n\n        return factors\n\n\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    # Wire up the dependencies for the top-level factorize function.\n    cfg = Config.from_env()\n    adapter = SQLiteAdapter(cfg.db_path)\n    cache_repo = CacheRepository(adapter)\n    service = Factorizer(cache_repo, cfg)\n    \n    return service.factorize(n)"}
{"task_id": "HumanEval/27", "solution": "def flip_case(string: str) -> str:\n    \"\"\" For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    >>> flip_case('Hello')\n    'hELLO'\n    \"\"\"\n    return ''.join(char.swapcase() for char in string)"}
{"task_id": "HumanEval/26", "solution": "def remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    \"\"\"\n    counts = {}\n    for n in numbers:\n        counts[n] = counts.get(n, 0) + 1\n\n    result = []\n    for n in numbers:\n        if counts[n] == 1:\n            result.append(n)\n    return result"}
