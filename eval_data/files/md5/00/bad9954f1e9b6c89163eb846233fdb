{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2 or n == 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n\n    # Numbers below this limit are checked via trial division up to sqrt(n).\n    # For numbers above, Miller-Rabin is used as specified in design context.\n    TRIAL_DIVISION_LIMIT = 1_000_000\n\n    if n < TRIAL_DIVISION_LIMIT:\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n    else:\n        # Bases for deterministic Miller-Rabin test for n < 3.4 * 10^14.\n        _miller_rabin_bases = [2, 3, 5, 7, 11, 13, 17]\n\n        # Helper function for Miller-Rabin primality test.\n        def _run_miller_rabin_test(num, bases):\n            d = num - 1\n            s = 0\n            while d % 2 == 0:\n                d //= 2\n                s += 1\n\n            for a in bases:\n                # 'a' must be less than 'num' for the test to be valid.\n                if a >= num:\n                    continue\n\n                x = pow(a, d, num)\n                if x == 1 or x == num - 1:\n                    continue\n\n                is_composite_for_this_base = True\n                for _ in range(s - 1):\n                    x = pow(x, 2, num)\n                    if x == num - 1:\n                        is_composite_for_this_base = False\n                        break\n                if is_composite_for_this_base:\n                    return False\n            return True\n\n        return _run_miller_rabin_test(n, _miller_rabin_bases)"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    result = list(l)\n    indices_to_sort = []\n    values_to_sort = []\n\n    for i in range(len(l)):\n        if i % 3 == 0:\n            indices_to_sort.append(i)\n            values_to_sort.append(l[i])\n\n    values_to_sort.sort()\n\n    for j, idx in enumerate(indices_to_sort):\n        result[idx] = values_to_sort[j]\n\n    return result"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    import math\n\n    # Handle trivial cases\n    if n <= 1:\n        return False\n    if n == 2 or n == 3:\n        return True\n    if n % 2 == 0:\n        return False\n\n    TRIAL_DIVISION_THRESHOLD = 1_000_000\n\n    if n < TRIAL_DIVISION_THRESHOLD:\n        # Perform trial division for smaller numbers.\n        i = 3\n        limit = math.isqrt(n)\n        while i <= limit:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n    else:\n        # Perform Miller-Rabin primality test for larger numbers.\n        _MILLER_RABIN_BASES = [2, 325, 9375, 28178, 450775, 9780504, 1795265022]\n\n        # Find d and s such that n - 1 = d * 2^s, where d is odd.\n        d = n - 1\n        s = 0\n        while d % 2 == 0:\n            d //= 2\n            s += 1\n\n        def _miller_rabin_witness(a, n_val, d_val, s_val):\n            \"\"\"Checks if 'a' is a Miller-Rabin witness for n_val.\"\"\"\n            x = pow(a, d_val, n_val)\n            if x == 1 or x == n_val - 1:\n                return False  # Not a witness\n\n            for _ in range(s_val - 1):\n                x = pow(x, 2, n_val)\n                if x == n_val - 1:\n                    return False  # Not a witness\n            return True  # Is a witness (n is composite)\n\n        for a in _MILLER_RABIN_BASES:\n            if _miller_rabin_witness(a, n, d, s):\n                return False  # Found a witness, so n is composite\n        return True  # No witness found, n is prime"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    from typing import Any, Callable, List, Tuple\n\n    def _extract_indices_and_values(values: List[Any], condition_func: Callable[[int], bool]) -> Tuple[List[int], List[Any]]:\n        \"\"\"Extracts indices and their corresponding values from a list based on a condition.\"\"\"\n        indices = [i for i in range(len(values)) if condition_func(i)]\n        extracted_values = [values[i] for i in indices]\n        return indices, extracted_values\n\n    def _replace_values_at_indices(original_list: List[Any], indices_to_replace: List[int], new_values: List[Any]) -> List[Any]:\n        \"\"\"Replaces values in a list at specified indices with new values.\"\"\"\n        modified_list = list(original_list)\n        for idx, val in zip(indices_to_replace, new_values):\n            modified_list[idx] = val\n        return modified_list\n\n    indices_to_sort, values_to_sort = _extract_indices_and_values(l, lambda i: i % 3 == 0)\n    \n    if not values_to_sort:\n        return list(l) # Return a copy if no values to sort\n\n    sorted_values = sorted(values_to_sort)\n    \n    result_list = _replace_values_at_indices(l, indices_to_sort, sorted_values)\n    \n    return result_list"}
{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    DEFAULT_TOL = 1e-9\n    DEFAULT_MAX_ITER = 1000\n    DEFAULT_BRACKET_FACTOR = 1.5\n    DEFAULT_MAX_BRACKET = 1e6\n\n    # Check if 0 is a root to within tolerance\n    if abs(poly(xs, 0.0)) < DEFAULT_TOL:\n        return 0.0\n\n    # Bracketing a sign change for an odd-degree polynomial\n    # The polynomial is guaranteed to have a real root, so a bracket will be found.\n    a = 0.0\n    b = 0.0\n    \n    current_x_positive = 1.0\n    current_x_negative = -1.0\n    f_at_zero = poly(xs, 0.0)\n\n    while True:\n        f_positive = poly(xs, current_x_positive)\n        f_negative = poly(xs, current_x_negative)\n\n        # If an integer/simple fractional root is hit during bracketing\n        if abs(f_positive) < DEFAULT_TOL:\n            return current_x_positive\n        if abs(f_negative) < DEFAULT_TOL:\n            return current_x_negative\n\n        # Check for sign change between 0 and current_x_positive\n        if f_at_zero * f_positive < 0.0:\n            a, b = 0.0, current_x_positive\n            break\n        # Check for sign change between current_x_negative and 0\n        if f_negative * f_at_zero < 0.0:\n            a, b = current_x_negative, 0.0\n            break\n        # Check for sign change between current_x_negative and current_x_positive\n        if f_negative * f_positive < 0.0:\n            a, b = current_x_negative, current_x_positive\n            break\n\n        # Expand search range multiplicatively\n        current_x_positive *= DEFAULT_BRACKET_FACTOR\n        current_x_negative *= DEFAULT_BRACKET_FACTOR\n\n        # A root is guaranteed, so this loop should eventually find a bracket.\n        # This check is primarily for robustness against extreme cases or floating point limits.\n        if current_x_positive > DEFAULT_MAX_BRACKET:\n            # If max bracket is reached without finding a bracket, it's an unexpected state.\n            # Given the problem constraints, it implies a bracket must exist.\n            # We assign a very large default interval and proceed to bisection.\n            a = -DEFAULT_MAX_BRACKET\n            b = DEFAULT_MAX_BRACKET\n            break\n\n    # Ensure a < b for the bisection method\n    if a > b:\n        a, b = b, a\n\n    # Bisection method\n    fa = poly(xs, a)\n    fb = poly(xs, b)\n\n    # Check bracket endpoints again after ensuring a < b\n    if abs(fa) < DEFAULT_TOL:\n        return a\n    if abs(fb) < DEFAULT_TOL:\n        return b\n\n    for _ in range(DEFAULT_MAX_ITER):\n        mid = (a + b) / 2.0\n        f_mid = poly(xs, mid)\n\n        # If mid is close enough to a root or interval is small enough\n        if abs(f_mid) < DEFAULT_TOL or (b - a) / 2.0 < DEFAULT_TOL:\n            return mid\n\n        # Determine which half contains the root\n        if fa * f_mid < 0.0:\n            b = mid\n            fb = f_mid\n        else:\n            a = mid\n            fa = f_mid\n            \n    # Return the midpoint of the final interval if max iterations reached\n    return (a + b) / 2.0"}
{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    # Define constants based on design context for inline implementation.\n    DEFAULT_TOLERANCE = 1e-12\n    DEFAULT_MAX_ITER = 100\n    DEFAULT_SEARCH_RADIUS = 1.0\n    MAX_SEARCH_STEPS = 64\n\n    # Define the polynomial function as a local callable for the solver.\n    def f(x_val: float) -> float:\n        return poly(xs, x_val)\n\n    # Step 1: Check if 0 is a root.\n    f0 = f(0.0)\n    if f0 == 0.0:\n        return 0.0\n\n    # Step 2: Find a bracket [a, b] where f(a) * f(b) < 0.\n    # This implements an exponential search outward from 0.\n    a = 0.0\n    b = 0.0\n    fa = f0\n    found_bracket = False\n\n    for i in range(MAX_SEARCH_STEPS):\n        step = DEFAULT_SEARCH_RADIUS * (2 ** i)\n\n        # Check positive direction\n        x_test_pos = step\n        f_test_pos = f(x_test_pos)\n        if f_test_pos == 0.0:\n            return x_test_pos\n        if fa * f_test_pos < 0:\n            a = 0.0\n            b = x_test_pos\n            found_bracket = True\n            break\n\n        # Check negative direction\n        x_test_neg = -step\n        f_test_neg = f(x_test_neg)\n        if f_test_neg == 0.0:\n            return x_test_neg\n        if fa * f_test_neg < 0:\n            a = x_test_neg\n            b = 0.0\n            found_bracket = True\n            break\n\n        # For steps beyond the first, also check between consecutive points (not just against 0)\n        if i > 0:\n            prev_step = DEFAULT_SEARCH_RADIUS * (2 ** (i - 1))\n            \n            f_prev_pos = f(prev_step)\n            if f_prev_pos * f_test_pos < 0:\n                a = prev_step\n                b = x_test_pos\n                found_bracket = True\n                break\n            \n            f_prev_neg = f(-prev_step)\n            if f_prev_neg * f_test_neg < 0:\n                a = x_test_neg\n                b = -prev_step\n                found_bracket = True\n                break\n    \n    # Per the problem description, a solution is guaranteed, so a bracket should be found.\n\n    # Ensure a < b for the bisection method.\n    if a > b:\n        a, b = b, a\n\n    # Step 3: Refine the root using the bisection method.\n    fa = f(a)\n    fb = f(b)\n\n    # Handle cases where bracket endpoints are already exact roots (due to floating point comparisons).\n    if abs(fa) < DEFAULT_TOLERANCE:\n        return a\n    if abs(fb) < DEFAULT_TOLERANCE:\n        return b\n\n    for _ in range(DEFAULT_MAX_ITER):\n        mid = a + (b - a) / 2.0\n        f_mid = f(mid)\n\n        # Check for convergence: function value close to zero or interval sufficiently small.\n        if abs(f_mid) < DEFAULT_TOLERANCE or (b - a) / 2.0 < DEFAULT_TOLERANCE:\n            return mid\n\n        # Update the bracket based on the sign of f_mid.\n        if fa * f_mid < 0:\n            b = mid\n            fb = f_mid\n        else:\n            a = mid\n            fa = f_mid\n    \n    # If max iterations reached, return the current best approximation.\n    return (a + b) / 2.0"}
