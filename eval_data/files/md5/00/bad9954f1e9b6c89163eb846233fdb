{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    '''\n    Returns True if the last character of the string is an alphabetical\n    character and forms a single-letter word, otherwise returns False.\n    '''\n    # Normalize text by replacing non-breaking spaces with regular spaces.\n    normalized_txt = txt.replace(\"\\u00A0\", \" \")\n\n    # If the normalized string is empty or contains only whitespace, return False.\n    if not normalized_txt or normalized_txt.isspace():\n        return False\n\n    # If the original string ends with a space, the last character is not a letter.\n    if txt.endswith(\" \"):\n        return False\n\n    # Get the last token (word) from the right-stripped normalized string.\n    # The rstrip() removes trailing spaces, then split() divides into words.\n    s_for_token = normalized_txt.rstrip()\n    if not s_for_token: # This check is primarily for edge cases where rstrip results in an empty string\n        return False\n\n    parts = s_for_token.split()\n\n    # If no words are found after splitting, return False.\n    if not parts:\n        return False\n\n    last_word_token = parts[-1]\n\n    # Return True if the last token is a single character and that character is alphabetical.\n    return len(last_word_token) == 1 and last_word_token.isalpha()"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is a standalone alphabetical character.\n    Returns True if the last non-space character is a single letter word, False otherwise.\n    \"\"\"\n    if not txt:\n        return False\n    if txt.endswith(\" \"):\n        return False\n\n    # Remove any trailing whitespace to find the last meaningful character/word\n    trimmed_txt = txt.rstrip()\n\n    if not trimmed_txt:\n        return False\n\n    # Split the string by spaces to get words/tokens\n    tokens = trimmed_txt.split(\" \")\n\n    # The last token is the one we're interested in\n    last_token = tokens[-1]\n\n    # Check if the last token is a single alphabetical character\n    return len(last_token) == 1 and last_token.isalpha()"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Returns the largest index of an element that is strictly less than its preceding element.\n    Returns -1 if no such element exists.\n    \"\"\"\n    n = len(arr)\n    # Iterate from the second-to-last element down to the second element (index 1).\n    for i in range(n - 1, 0, -1):\n        if arr[i] < arr[i - 1]:\n            return i\n    return -1"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n    '''\n    negatives = []\n    positives = []\n\n    for x in lst:\n        if x < 0:\n            negatives.append(x)\n        elif x > 0:\n            positives.append(x)\n\n    largest_negative = max(negatives) if negatives else None\n    smallest_positive = min(positives) if positives else None\n\n    return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Returns the largest index of an element which is not greater than or equal\n    to the element immediately preceding it. Returns -1 if no such element exists.\n    \"\"\"\n    n = len(arr)\n    # Iterate from the second to last element down to the second element (index 1)\n    for i in range(n - 1, 0, -1):\n        if arr[i] < arr[i - 1]:\n            return i\n    return -1"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n    '''\n    largest_neg = None\n    smallest_pos = None\n\n    for x in lst:\n        if x < 0:\n            if largest_neg is None or x > largest_neg:\n                largest_neg = x\n        elif x > 0:\n            if smallest_pos is None or x < smallest_pos:\n                smallest_pos = x\n        # Zero (0) is ignored as per requirements\n\n    return (largest_neg, smallest_pos)"}
