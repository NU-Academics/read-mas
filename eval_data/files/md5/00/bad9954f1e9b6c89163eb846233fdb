{"task_id": "HumanEval/3", "solution": "def below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    balance = 0\n    for operation in operations:\n        balance += operation\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    n = len(numbers)\n    if n == 0:\n        return []\n    \n    # The output list will have (n - 1) delimiters inserted between n numbers.\n    # Total length: n + (n - 1) = 2*n - 1\n    out_len = 2 * n - 1\n    \n    # Preallocate the output list to avoid repeated appends.\n    # Initialize with a placeholder value, e.g., 0, as elements will be overwritten.\n    output = [0] * out_len\n    \n    # Place the original numbers at even indices (0, 2, 4, ...).\n    output[0::2] = numbers\n    \n    # Place the delimiter at odd indices (1, 3, 5, ...).\n    # There will be (n - 1) delimiters.\n    output[1::2] = [delimeter] * (n - 1)\n    \n    return output"}
{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result: List[int] = []\n    for i, val in enumerate(numbers):\n        if i > 0:\n            result.append(delimeter)\n        result.append(val)\n    return result"}
{"task_id": "HumanEval/4", "solution": "def mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    count = len(numbers)\n\n    # Calculate the mean using Kahan summation for improved numeric stability.\n    mean_sum = 0.0\n    c = 0.0\n    for x in numbers:\n        y = x - c\n        t = mean_sum + y\n        c = (t - mean_sum) - y\n        mean_sum = t\n    mean = mean_sum / count\n\n    # Calculate the sum of absolute deviations.\n    absolute_deviation_sum = 0.0\n    for x in numbers:\n        absolute_deviation_sum += abs(x - mean)\n\n    return absolute_deviation_sum / count"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input data based on business rules.\"\"\"\n    def __init__(self, message: str = \"\") -> None:\n        super().__init__(message)\n\n\nclass CalculationError(Exception):\n    \"\"\"Exception raised for numerical issues during calculation.\"\"\"\n    def __init__(self, message: str = \"\") -> None:\n        super().__init__(message)\n\n\nclass Validator:\n    @staticmethod\n    def validate_numeric_list(values: List[float]) -> None:\n        \"\"\"Ensures the input list is non-empty and contains only valid finite numbers.\"\"\"\n        if not values:\n            raise ValidationError(\"Input list cannot be empty.\")\n        for item in values:\n            if not isinstance(item, (int, float)):\n                raise ValidationError(f\"All elements must be numeric, got {type(item).__name__}.\")\n            if isinstance(item, float) and (item != item or item == float('inf') or item == float('-inf')):\n                raise ValidationError(f\"Numeric elements cannot be NaN or infinity, got {item}.\")\n\n\nclass MathUtils:\n    @staticmethod\n    def mean(values: List[float]) -> float:\n        \"\"\"Computes the arithmetic mean of a list of numbers using Kahan summation for stability.\"\"\"\n        if not values:\n            raise CalculationError(\"Cannot compute mean of an empty list.\")\n\n        total = 0.0\n        c = 0.0\n        for x in values:\n            val_float = float(x)\n            y = val_float - c\n            t = total + y\n            c = (t - total) - y\n            total = t\n        return total / len(values)\n\n    @staticmethod\n    def mean_absolute_deviation(values: List[float]) -> float:\n        \"\"\"Calculates the Mean Absolute Deviation around the mean for a list of numbers.\"\"\"\n        mu = MathUtils.mean(values)\n        total_abs_diff = 0.0\n        for x in values:\n            total_abs_diff += abs(float(x) - mu)\n        return total_abs_diff / len(values)\n\n\nclass MADService:\n    def __init__(self, repo=None) -> None:\n        \"\"\"Initializes the MADService, optionally with a persistence repository.\"\"\"\n        self.repo = repo\n\n    def compute_mad(self, values: List[float], persist: bool = False, include_values: bool = False) -> float:\n        \"\"\"\n        Validates input, computes Mean Absolute Deviation, and returns the result.\n        Persistence options are ignored for this public API usage.\n        \"\"\"\n        Validator.validate_numeric_list(values)\n        mad_value = MathUtils.mean_absolute_deviation(values)\n        return mad_value\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    service = MADService(repo=None)\n    return service.compute_mad(numbers, persist=False, include_values=False)"}
{"task_id": "HumanEval/6", "solution": "import datetime\nfrom dataclasses import dataclass\nfrom typing import List, Dict, Any\n\n\nclass ParseError(Exception):\n    \"\"\"Custom exception for parsing and validation failures.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\n\n    def __str__(self) -> str:\n        return f\"ParseError: {self.message}\"\n\n\nALLOWED_CHARS = {'(', ')'}\n\n\ndef validate_group_chars(group: str) -> None:\n    \"\"\"Validate that the group only contains allowed parenthesis characters.\"\"\"\n    invalid = set(group) - ALLOWED_CHARS\n    if invalid:\n        raise ParseError(f\"Invalid characters in group '{group}': {''.join(sorted(invalid))}\")\n\n\ndef current_iso_ts() -> str:\n    \"\"\"Generate the current UTC timestamp in ISO8601 format.\"\"\"\n    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds').replace('+00:00', 'Z')\n\n\nclass NestedParensParser:\n    \"\"\"Parses a single parenthesis group to find its maximum nesting depth.\"\"\"\n    def parse(self, group: str) -> int:\n        depth = 0\n        max_depth = 0\n        for i, ch in enumerate(group):\n            if ch == '(':\n                depth += 1\n                if depth > max_depth:\n                    max_depth = depth\n            elif ch == ')':\n                depth -= 1\n                if depth < 0:\n                    raise ParseError(f\"Unmatched ')' at pos {i} in group: {group}\")\n            else:\n                raise ParseError(f\"Invalid char '{ch}' in group: {group}\")\n        if depth != 0:\n            raise ParseError(f\"Unbalanced '(' in group: {group}\")\n        return max_depth\n\n\n@dataclass\nclass GroupResult:\n    \"\"\"Data transfer object for a single group's parse result.\"\"\"\n    index: int\n    group: str\n    depth: int\n    timestamp: str\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Convert GroupResult instance to a dictionary.\"\"\"\n        return {\n            \"index\": self.index,\n            \"group\": self.group,\n            \"depth\": self.depth,\n            \"timestamp\": self.timestamp\n        }\n\n    @classmethod\n    def from_dict(cls, data: Dict[str, Any]) -> 'GroupResult':\n        \"\"\"Create a GroupResult instance from a dictionary.\"\"\"\n        return cls(\n            index=data[\"index\"],\n            group=data[\"group\"],\n            depth=data[\"depth\"],\n            timestamp=data[\"timestamp\"]\n        )\n\n\nclass ParserService:\n    \"\"\"Orchestrates parsing of multiple parenthesis groups, including validation.\"\"\"\n    def __init__(self, parser: NestedParensParser, repository=None) -> None:\n        self._parser = parser\n        self._repo = repository\n\n    def parse_all(self, input_str: str) -> List[GroupResult]:\n        \"\"\"Parses a string of space-separated parenthesis groups and returns results.\"\"\"\n        groups = [g for g in input_str.split() if g]\n        results = []\n        for idx, g in enumerate(groups):\n            validate_group_chars(g)\n            depth = self._parser.parse(g)\n            results.append(GroupResult(index=idx, group=g, depth=depth, timestamp=current_iso_ts()))\n        if self._repo:\n            # save_all would be defined on the concrete repository, but it's not needed for this function.\n            self._repo.save_all(results)\n        return results\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    service = ParserService(parser=NestedParensParser(), repository=None)\n    results = service.parse_all(paren_string)\n    return [r.depth for r in results]"}
