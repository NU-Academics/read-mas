{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    sorted_numbers = sorted(numbers)\n\n    for i in range(len(sorted_numbers) - 1):\n        if sorted_numbers[i+1] - sorted_numbers[i] < threshold:\n            return True\n\n    return False"}
{"task_id": "HumanEval/1", "solution": "def separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    class ParseError(Exception):\n        \"\"\"Custom exception for parsing failures with position context.\"\"\"\n        def __init__(self, message: str, position: int = -1) -> None:\n            self.message = message\n            self.position = position\n        def __str__(self) -> str:\n            return f\"{self.message} (pos={self.position})\"\n\n    normalized_string = \"\".join(ch for ch in paren_string if not ch.isspace())\n\n    for i, char in enumerate(normalized_string):\n        if char not in '()':\n            raise ParseError(f\"Invalid character '{char}'\", position=i)\n\n    groups: List[str] = []\n    depth = 0\n    start_index = -1\n\n    for i, char in enumerate(normalized_string):\n        if char == '(':\n            if depth == 0:\n                start_index = i\n            depth += 1\n        elif char == ')':\n            depth -= 1\n            if depth < 0:\n                raise ParseError(\"Unmatched closing parenthesis\", position=i)\n            if depth == 0:\n                groups.append(normalized_string[start_index : i + 1])\n                start_index = -1\n\n    if depth > 0:\n        raise ParseError(\"Unclosed parenthesis\", position=len(normalized_string) - 1)\n\n    return groups"}
{"task_id": "HumanEval/1", "solution": "def separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separates a string containing multiple groups of nested parentheses into a list of separate balanced group strings.\n    Ignores any spaces in the input string.\n    \"\"\"\n    normalized_string = \"\".join(ch for ch in paren_string if not ch.isspace())\n\n    groups: List[str] = []\n    current_group_buffer: List[str] = []\n    depth = 0\n\n    for char in normalized_string:\n        if char == '(':\n            depth += 1\n            current_group_buffer.append(char)\n        elif char == ')':\n            if depth > 0:  # Only process ')' if there's an open parenthesis to match\n                current_group_buffer.append(char)\n                depth -= 1\n                if depth == 0:  # A top-level group is complete\n                    groups.append(\"\".join(current_group_buffer))\n                    current_group_buffer = []\n            # If depth is 0 and char is ')', it's an unmatched closing parenthesis.\n            # Per the requirements, it's ignored without raising an error.\n\n    # After the loop, if depth is not 0, it means there are unmatched opening parentheses.\n    # Per the requirements, these incomplete groups are implicitly discarded.\n\n    return groups"}
{"task_id": "HumanEval/2", "solution": "import math\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    # Epsilon for floating point comparisons, to handle numbers very close to an integer.\n    EPSILON = 1e-12\n\n    # math.modf returns a tuple (fractional_part, integer_part).\n    # For a positive input number, the fractional_part will be non-negative.\n    frac, _ = math.modf(number)\n\n    # If the fractional part is extremely close to 0 or 1 (due to floating point inaccuracies),\n    # treat it as 0.0. This means the original number was effectively an integer.\n    if abs(frac) < EPSILON or abs(frac - 1.0) < EPSILON:\n        return 0.0\n\n    return frac"}
{"task_id": "HumanEval/0", "solution": "import math\nfrom typing import List, Iterable\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    \"\"\"\n\n    class InvalidInputError(Exception):\n        \"\"\"Exception raised for invalid input parameters.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class Validator:\n        \"\"\"Helper class for validating input numbers and threshold.\"\"\"\n        def validate_numbers(self, numbers: Iterable[object]) -> List[float]:\n            \"\"\"Converts and validates an iterable of objects into a list of floats.\"\"\"\n            validated_list: List[float] = []\n            for i, num_obj in enumerate(numbers):\n                try:\n                    num = float(num_obj)\n                except (TypeError, ValueError):\n                    raise InvalidInputError(f\"Number at index {i} could not be converted to float: {num_obj!r}\")\n\n                if math.isnan(num) or math.isinf(num):\n                    raise InvalidInputError(f\"Number at index {i} is NaN or infinity: {num!r}\")\n                validated_list.append(num)\n            return validated_list\n\n        def validate_threshold(self, threshold: object) -> float:\n            \"\"\"Validates the threshold value to be a non-negative float.\"\"\"\n            try:\n                t = float(threshold)\n            except (TypeError, ValueError):\n                raise InvalidInputError(f\"Threshold must be numeric, got {threshold!r}\")\n            if t < 0.0:\n                raise InvalidInputError(\"Threshold must be non-negative\")\n            return t\n\n    class Sorter:\n        \"\"\"Helper class for sorting lists of numbers.\"\"\"\n        def sorted_copy(self, numbers: Iterable[float]) -> List[float]:\n            \"\"\"Returns a new sorted list from the input iterable.\"\"\"\n            return sorted(numbers)\n\n    class CloseElementsService:\n        \"\"\"Service containing the core algorithm for checking close elements.\"\"\"\n        def __init__(self, validator: 'Validator', sorter: 'Sorter') -> None:\n            self._validator = validator\n            self._sorter = sorter\n\n        def has_close_elements(self, numbers: List[float], threshold: float) -> bool:\n            \"\"\"Checks for any two numbers closer than the given threshold in the input list.\"\"\"\n            validated_threshold = self._validator.validate_threshold(threshold)\n            validated_numbers = self._validator.validate_numbers(numbers)\n\n            if len(validated_numbers) < 2:\n                return False\n\n            sorted_numbers = self._sorter.sorted_copy(validated_numbers)\n\n            return self._has_close_in_sorted(sorted_numbers, validated_threshold)\n\n        def _has_close_in_sorted(self, numbers: List[float], threshold: float) -> bool:\n            \"\"\"Internal method to efficiently check for close elements in an already sorted list.\"\"\"\n            for i in range(len(numbers) - 1):\n                if numbers[i+1] - numbers[i] < threshold:\n                    return True\n            return False\n\n    # Instantiate the necessary components and run the service logic\n    validator_instance = Validator()\n    sorter_instance = Sorter()\n    service_instance = CloseElementsService(validator_instance, sorter_instance)\n    return service_instance.has_close_elements(numbers, threshold)"}
{"task_id": "HumanEval/2", "solution": "```python\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    # The prompt explicitly states to avoid helper functions and focus on the core logic.\n    # It also states \"Do NOT add isinstance() checks or raise exceptions for edge cases\".\n    # Therefore, we assume 'number' is a valid positive float as per the function signature\n    # and requirements, and directly apply the core calculation.\n    \n    # Calculate the integer part by taking the floor of the number.\n    # int() casting here helps ensure it's an integer for subtraction.\n    integer_part = int(number)\n    \n    # The decimal part is the number minus its integer part.\n    decimal_part = number - integer_part\n    \n    # Handle potential tiny negative floating point errors\n    # (e.g., 3.0 - 3 might result in -1.11e-16).\n    if -1e-9 < decimal_part < 0:\n        return 0.0\n    \n    return decimal_part\n```"}
