should for the examples), \n        # using 0 as a default could lead to incorrect results, but raising is also disallowed.\n        # Re-evaluating: The examples strongly suggest the format is consistent.\n        # So, the `if match:` block should always execute for valid `s`.\n        pass # The 'if match' should cover all valid examples.\n\n    # Calculate the number of mango fruits\n    mangoes = n - apples - oranges\n    \n    return mangoes"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even value in the array and its first occurring index.\n    Returns [value, index] or [] if no even values are found.\n    \"\"\"\n    smallest_even_value = None\n    smallest_even_index = None\n\n    for i, num in enumerate(arr):\n        if num % 2 == 0:  # Check if the number is even\n            if smallest_even_value is None or num < smallest_even_value:\n                smallest_even_value = num\n                smallest_even_index = i\n            # If num == smallest_even_value, we do not update,\n            # ensuring the smallest index is kept due to left-to-right iteration.\n\n    if smallest_even_value is None:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    if len(lst) < 2:\n        return list(lst)\n\n    sorted_lst = sorted(lst)\n    \n    left, right = 0, len(sorted_lst) - 1\n    out = []\n    take_left = True\n\n    while left <= right:\n        if take_left:\n            out.append(sorted_lst[left])\n            left += 1\n        else:\n            out.append(sorted_lst[right])\n            right -= 1\n        take_left = not take_left\n            \n    return out"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\n\ndef search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    frequency_map = Counter(lst)\n    max_valid_num = -1\n\n    # Iterate through each unique number and its frequency.\n    for num, freq in frequency_map.items():\n        if num > 0 and freq >= num:\n            if num > max_valid_num:\n                max_valid_num = num\n                \n    return max_valid_num"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    \"\"\"\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    \"\"\"\n    counts = {}\n    for n in lst:\n        counts[n] = counts.get(n, 0) + 1\n\n    max_candidate = -1\n\n    for v, freq in counts.items():\n        if v > 0 and freq >= v:\n            if v > max_candidate:\n                max_candidate = v\n\n    return max_candidate"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    if not lst:\n        return []\n    if len(lst) == 1:\n        return list(lst)\n\n    sorted_lst = sorted(lst)\n    result = []\n    left, right = 0, len(sorted_lst) - 1\n    take_min = True\n\n    while left <= right:\n        if take_min:\n            result.append(sorted_lst[left])\n            left += 1\n        else:\n            result.append(sorted_lst[right])\n            right -= 1\n        take_min = not take_min\n    return result"}
{"task_id": "HumanEval/71", "solution": "import math\n\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    '''\n    # Check if all sides are positive.\n    if a <= 0 or b <= 0 or c <= 0:\n        return -1\n\n    # Check the triangle inequality theorem.\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1\n\n    # Calculate the semi-perimeter.\n    s = (a + b + c) / 2\n\n    # Calculate the radicand for Heron's formula.\n    radicand = s * (s - a) * (s - b) * (s - c)\n\n    # Handle potential floating point inaccuracies where radicand might be very slightly negative.\n    if -1e-12 < radicand < 0:\n        radicand = 0.0\n    elif radicand < 0:\n        # If radicand is significantly negative, it's an invalid case not caught by inequalities.\n        return -1\n\n    # Calculate the area and round to 2 decimal places.\n    area = math.sqrt(radicand)\n    return round(area, 2)"}
{"task_id": "HumanEval/71", "solution": "import math\n\ndef triangle_area(a, b, c):\n    # Check if all side lengths are positive\n    if not (a > 0 and b > 0 and c > 0):\n        return -1\n\n    # Check the triangle inequality theorem:\n    # The sum of any two sides must be strictly greater than the third side.\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1\n\n    # Calculate the semi-perimeter\n    s = (a + b + c) / 2\n\n    # Calculate the area using Heron's formula.\n    # We use max(0, ...) to prevent math.sqrt from raising an error\n    # if floating-point inaccuracies cause the value under the square root\n    # to be slightly negative for a degenerate or nearly degenerate triangle.\n    area_squared = s * (s - a) * (s - b) * (s - c)\n    \n    # If area_squared is slightly negative due to float precision, treat it as 0.\n    area = math.sqrt(max(0.0, area_squared))\n\n    # Round the area to 2 decimal points.\n    return round(area, 2)"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    '''\n    Checks if object q will fly. It flies if balanced (palindromic list) and its sum is within weight w.\n    '''\n    is_balanced = (q == q[::-1])\n    total_weight = sum(q)\n    is_within_weight = (total_weight <= w)\n    \n    return is_balanced and is_within_weight"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    '''\n    Write a function that returns True if the object q will fly, and False otherwise.\n    The object q will fly if it's balanced (it is a palindromic list) and the sum of its elements is less than or equal the maximum possible weight w.\n\n    Example:\n    will_it_fly([1, 2], 5) \u279e False \n    # 1+2 is less than the maximum possible weight, but it's unbalanced.\n\n    will_it_fly([3, 2, 3], 1) \u279e False\n    # it's balanced, but 3+2+3 is more than the maximum possible weight.\n\n    will_it_fly([3, 2, 3], 9) \u279e True\n    # 3+2+3 is less than the maximum possible weight, and it's balanced.\n\n    will_it_fly([3], 5) \u279e True\n    # 3 is less than the maximum possible weight, and it's balanced.\n    '''\n    is_balanced = (q == q[::-1])\n    elements_sum = sum(q)\n    is_light_enough = (elements_sum <= w)\n\n    return is_balanced and is_light_enough"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic. A palindromic array is an array that\n    is read the same backwards and forwards. In one change, you can change one element to any other element.\n    \"\"\"\n    n = len(arr)\n    changes = 0\n    left = 0\n    right = n - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic. A palindromic array is an array that\n    is read the same backwards and forwards. In one change, you can change one element to any other element.\n\n    For example:\n    smallest_change([1,2,3,5,4,7,9,6]) == 4\n    smallest_change([1, 2, 3, 4, 3, 2, 2]) == 1\n    smallest_change([1, 2, 3, 2, 1]) == 0\n    \"\"\"\n    n = len(arr)\n    changes = 0\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            changes += 1\n    return changes"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    \"\"\"\n    Compares two lists of strings based on their total character count.\n    Returns the list with the smaller total character count, or the first list if counts are equal.\n    \"\"\"\n    total_chars_lst1 = sum(len(s) for s in lst1)\n    total_chars_lst2 = sum(len(s) for s in lst2)\n\n    if total_chars_lst1 <= total_chars_lst2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Returns true if the given number is the multiplication of 3 prime numbers, false otherwise.\n    The number 'a' is less than 100.\n    \"\"\"\n    def get_prime_factors(n):\n        \"\"\"Returns a list of prime factors for a given number n, including multiplicity.\"\"\"\n        factors = []\n        d = 2\n        temp_n = n\n\n        while d * d <= temp_n:\n            while temp_n % d == 0:\n                factors.append(d)\n                temp_n //= d\n            d += 1 if d == 2 else 2 # Increment by 1 for d=2, then by 2 for odd numbers\n        \n        if temp_n > 1: # If temp_n is still greater than 1, it must be a prime factor itself\n            factors.append(temp_n)\n        return factors\n\n    # As per context, inputs are positive integers less than 100.\n    # Numbers less than 2 cannot be a product of primes.\n    if a < 2:\n        return False\n        \n    factors = get_prime_factors(a)\n    return len(factors) == 3"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    \"\"\"\n    Calculates the total character count for each list and returns the list with the smaller total.\n    If the totals are equal, the first list is returned.\n    \"\"\"\n    total_chars_lst1 = sum(len(str(item)) for item in lst1)\n    total_chars_lst2 = sum(len(str(item)) for item in lst2)\n\n    if total_chars_lst1 <= total_chars_lst2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100.\n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    MAX_N_CONSTRAINT = 99\n\n    def _sieve_primes_up_to(n_limit: int) -> list[int]:\n        \"\"\"Generates a list of prime numbers up to n_limit using the Sieve of Eratosthenes.\"\"\"\n        if n_limit < 2:\n            return []\n        sieve = [True] * (n_limit + 1)\n        sieve[0] = sieve[1] = False\n        p = 2\n        while p * p <= n_limit:\n            if sieve[p]:\n                for multiple in range(p * p, n_limit + 1, p):\n                    sieve[multiple] = False\n            p += 1\n        return [i for i, is_p in enumerate(sieve) if is_p]\n\n    def _prime_factorization(num: int, primes_list: list[int]) -> list[int]:\n        \"\"\"Returns a list of prime factors for num, including multiplicity.\"\"\"\n        factors = []\n        temp_num = num\n        for p in primes_list:\n            if p * p > temp_num:\n                break\n            while temp_num % p == 0:\n                factors.append(p)\n                temp_num //= p\n        if temp_num > 1:\n            factors.append(temp_num)\n        return factors\n\n    if not isinstance(a, int) or a <= 1 or a > MAX_N_CONSTRAINT:\n        return False\n\n    # Pre-calculate primes up to the maximum allowed value for 'a'\n    all_primes = _sieve_primes_up_to(MAX_N_CONSTRAINT)\n\n    # Get the prime factors of 'a'\n    factors = _prime_factorization(a, all_primes)\n\n    # Check if the number of prime factors is exactly 3 (counting multiplicity)\n    return len(factors) == 3"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n.\n    x is a simple power of n if n**k == x for some integer k >= 0.\n    \"\"\"\n    if x == 1:\n        # 1 is n**0 for any n >= 1. Per design, non-positive n rejects.\n        return n >= 1\n\n    # From this point, x must be greater than 1 for a true power relation (k >= 1).\n    # If x <= 0, it cannot be a power of n >= 1.\n    if x <= 0:\n        return False\n\n    # From this point, x > 1.\n    # If n <= 1, it cannot form a power equal to x > 1.\n    # (n=1 implies 1**k = 1, but x > 1. n=0 or n<0 cannot result in x > 1 for k >= 0).\n    if n <= 1:\n        return False\n\n    # General case: x > 1 and n > 1.\n    # Repeatedly divide x by n. If it's a power, x will eventually become 1.\n    temp_x = x\n    while temp_x > 1:\n        if temp_x % n != 0:\n            return False\n        temp_x //= n\n\n    return temp_x == 1"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if a number x is a simple power of n (n**k == x for integer k >= 0).\"\"\"\n    if x == 1:\n        return True\n\n    if n == 0:\n        return x == 0\n\n    if n == 1:\n        return x == 1\n\n    # Defensive check, though inputs are expected to be non-negative.\n    if n < 0 or x < 0:\n        return False\n\n    # At this point, x must be >= 0 and n >= 2.\n    # If x is 0, and n >= 2, it cannot be a power.\n    if x == 0:\n        return False\n\n    current_x = x\n    while current_x % n == 0:\n        current_x //= n\n        if current_x == 1:\n            return True\n    return False"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Checks if an integer 'a' is a perfect cube of some integer.\n    Uses binary search for the integer cube root to ensure accuracy with large numbers.\n    '''\n    def _integer_cube_root(n):\n        \"\"\"Finds the integer k such that k^3 is closest to n without exceeding n (for positive n)\n        or without being less than n (for negative n), or is exactly n.\"\"\"\n        if n >= 0:\n            lo, hi = 0, n\n        else:\n            lo, hi = n, 0\n\n        while lo <= hi:\n            mid = (lo + hi) // 2\n            cube = mid * mid * mid\n            if cube == n:\n                return mid\n            if cube < n:\n                lo = mid + 1\n            else:\n                hi = mid - 1\n        return hi\n\n    candidate_root = _integer_cube_root(a)\n    return candidate_root * candidate_root * candidate_root == a"}
