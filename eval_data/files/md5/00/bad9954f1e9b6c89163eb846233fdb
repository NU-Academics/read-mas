{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    \n    Example\n        For N = 1000, the sum of digits will be 1 the output should be \"1\".\n        For N = 150, the sum of digits will be 6 the output should be \"110\".\n        For N = 147, the sum of digits will be 12 the output should be \"1100\".\n    \n    Variables:\n        @N integer\n             Constraints: 0 \u2264 N \u2264 10000.\n    Output:\n         a string of binary number\n    \"\"\"\n    sum_of_digits = 0\n    # Iterate through the digits of N by converting it to a string.\n    for digit_char in str(N):\n        sum_of_digits += int(digit_char)\n    \n    # Convert the decimal sum of digits to its binary string representation.\n    return format(sum_of_digits, 'b')"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    \n    Example\n        For N = 1000, the sum of digits will be 1 the output should be \"1\".\n        For N = 150, the sum of digits will be 6 the output should be \"110\".\n        For N = 147, the sum of digits will be 12 the output should be \"1100\".\n    \n    Variables:\n        @N integer\n             Constraints: 0 \u2264 N \u2264 10000.\n    Output:\n         a string of binary number\n    \"\"\"\n    class InvalidInputError(Exception):\n        pass\n\n    class ComputationError(Exception):\n        pass\n\n    MAX_N = 10000\n    MIN_N = 0\n\n    class DigitSumRequest:\n        def __init__(self, n: int):\n            self.n = n\n        def __repr__(self):\n            return f\"DigitSumRequest(n={self.n})\"\n\n    class DigitSumResponse:\n        def __init__(self, binary_sum: str):\n            self.binary_sum = binary_sum\n        def __repr__(self):\n            return f\"DigitSumResponse(binary_sum='{self.binary_sum}')\"\n\n    class DigitSumRepository:\n        def save_request(self, req: DigitSumRequest) -> None:\n            pass\n        def save_result(self, req: DigitSumRequest, res: DigitSumResponse) -> None:\n            pass\n\n    def parse_int_candidate(value: any) -> int:\n        if isinstance(value, int):\n            return value\n        if isinstance(value, str) and value.isdigit():\n            return int(value)\n        raise InvalidInputError(\"Input must be an integer or decimal-digit string\")\n\n    def sum_decimal_digits(n: int) -> int:\n        return sum(int(ch) for ch in str(n))\n\n    def int_to_binary(n: int) -> str:\n        return format(n, 'b')\n\n    class DigitSumService:\n        def __init__(self, repo=None, max_n: int = MAX_N):\n            self.repo = repo\n            self.max_n = max_n\n\n        def validate_input(self, n_candidate) -> int:\n            n = parse_int_candidate(n_candidate)\n            if n < MIN_N or n > self.max_n:\n                raise InvalidInputError(f\"n must be between {MIN_N} and {self.max_n}\")\n            return n\n\n        def compute_binary_sum(self, n_candidate) -> str:\n            n = self.validate_input(n_candidate)\n            if self.repo:\n                self.repo.save_request(DigitSumRequest(n))\n            s = sum_decimal_digits(n)\n            b = int_to_binary(s)\n            if self.repo:\n                self.repo.save_result(DigitSumRequest(n), DigitSumResponse(b))\n            return b\n\n    class DigitSumController:\n        def __init__(self, service: DigitSumService):\n            self.service = service\n\n        def handle_request(self, n_candidate: any) -> DigitSumResponse:\n            binary_sum = self.service.compute_binary_sum(n_candidate)\n            return DigitSumResponse(binary_sum)\n\n    repo = DigitSumRepository()\n    svc = DigitSumService(repo=repo)\n    ctrl = DigitSumController(service=svc)\n    return ctrl.handle_request(N).binary_sum"}
