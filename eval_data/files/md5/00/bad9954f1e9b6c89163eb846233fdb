{"task_id": "HumanEval/22", "solution": "from typing import List, Any, Optional\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass TypeAdapter:\n    \"\"\"Encapsulates logic for determining if a value is a strict integer.\"\"\"\n    def is_integer(self, value: Any) -> bool:\n        return type(value) is int\n\nclass ValuesDTO:\n    \"\"\"Data Transfer Object for normalizing raw input into a list.\"\"\"\n    def __init__(self, raw: Any) -> None:\n        self._raw = raw\n        self.values: List[Any] = []\n\n    def to_list(self) -> List[Any]:\n        \"\"\"Converts raw input to a list, handling None and non-iterables.\"\"\"\n        if self._raw is None:\n            self.values = []\n            return self.values\n        try:\n            self.values = list(self._raw)\n        except TypeError:\n            raise InvalidInputError(\"Input is not iterable\")\n        return self.values\n\nclass FilterService:\n    \"\"\"Orchestrates input normalization and filtering based on TypeAdapter.\"\"\"\n    def __init__(self, adapter: Optional[TypeAdapter]=None) -> None:\n        self.adapter = adapter or TypeAdapter()\n\n    def filter(self, values: List[Any]) -> List[int]:\n        \"\"\"Filters a list of values, returning only strict integers.\"\"\"\n        dto = ValuesDTO(values)\n        items = dto.to_list()\n        result: List[int] = []\n        for v in items:\n            if self.adapter.is_integer(v):\n                result.append(v)\n        return result\n\ndef filter_integers(values: List[Any]) -> List[int]:\n    \"\"\" Filter given list of any python values only for integers\n    >>> filter_integers(['a', 3.14, 5])\n    [5]\n    >>> filter_integers([1, 2, 3, 'abc', {}, []])\n    [1, 2, 3]\n    \"\"\"\n    service = FilterService()\n    return service.filter(values)"}
