{"task_id": "HumanEval/6", "solution": "def parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n    \"\"\"\n    \n    # Split the input string into groups based on whitespace.\n    # str.split() without arguments handles multiple spaces and discards empty strings.\n    groups = [g for g in paren_string.split() if g]\n\n    all_depths = []\n    for group in groups:\n        current_depth = 0\n        max_depth_in_group = 0\n        balance_check = 0  # Used for overall balance and invalid char checks\n        \n        is_malformed = False\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                balance_check += 1\n                if current_depth > max_depth_in_group:\n                    max_depth_in_group = current_depth\n            elif char == ')':\n                current_depth -= 1\n                balance_check -= 1\n            else:\n                # Invalid character found\n                is_malformed = True\n                break\n            \n            # Check for too many closing parentheses\n            if balance_check < 0:\n                is_malformed = True\n                break\n        \n        # After processing the group, check final balance\n        if balance_check != 0:\n            is_malformed = True\n            \n        if is_malformed:\n            all_depths.append(0)  # Return 0 for malformed groups\n        else:\n            all_depths.append(max_depth_in_group)\n            \n    return all_depths"}
{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = sum(numbers)\n    total_product = 1\n    for num in numbers:\n        total_product *= num\n    return total_sum, total_product"}
{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n    for number in numbers:\n        total_sum += number\n        total_product *= number\n    return (total_sum, total_product)"}
{"task_id": "HumanEval/7", "solution": "from typing import List, Optional\nimport re\n\n\nclass FilterError(Exception):\n    \"\"\"Domain-specific exception for filtering operations.\"\"\"\n    def __init__(self, message: str, code: int = 400) -> None:\n        super().__init__(message)\n        self.message = message\n        self.code = code\n\n\nclass FilterConfig:\n    \"\"\"Configuration model for filtering.\"\"\"\n    SUPPORTED_MODES = [\"contains\", \"startswith\", \"endswith\", \"regex\"]\n\n    def __init__(self, case_sensitive: bool = True, mode: str = \"contains\", allow_empty_substring: bool = False) -> None:\n        self.case_sensitive = case_sensitive\n        self.mode = mode\n        self.allow_empty_substring = allow_empty_substring\n        self.validate()\n\n    def validate(self) -> None:\n        \"\"\"Validates the configuration parameters.\"\"\"\n        if self.mode not in self.SUPPORTED_MODES:\n            raise FilterError(f\"Unsupported mode: {self.mode}. Must be one of {', '.join(self.SUPPORTED_MODES)}\")\n\n\nclass FilterRequest:\n    \"\"\"DTO representing a filter request.\"\"\"\n    def __init__(self, strings: List[str], substring: str, config: FilterConfig) -> None:\n        self.strings = strings\n        self.substring = substring\n        self.config = config\n\n\nclass FilterResult:\n    \"\"\"DTO representing filter results.\"\"\"\n    def __init__(self, results: List[str]) -> None:\n        self.results = results\n\n    def matched_count(self) -> int:\n        \"\"\"Returns the number of matched items.\"\"\"\n        return len(self.results)\n\n\nclass Validator:\n    \"\"\"Utility for input validation rules.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def validate_strings(self, strings: List[str]) -> None:\n        \"\"\"Validates that the input is a list of strings.\"\"\"\n        if not isinstance(strings, list):\n            raise FilterError(\"strings must be a list of str\")\n        for i, s in enumerate(strings):\n            if not isinstance(s, str):\n                raise FilterError(f\"element at index {i} is not a string\")\n\n    def validate_substring(self, substring: str, config: FilterConfig) -> None:\n        \"\"\"Validates the substring based on configuration.\"\"\"\n        if not isinstance(substring, str):\n            raise FilterError(\"substring must be a string\")\n        if not substring and not config.allow_empty_substring:\n            raise FilterError(\"Empty substring is not allowed by default. Set allow_empty_substring=True in config to enable.\")\n\n\nclass InMemoryRepository:\n    \"\"\"In-memory persistence adapter for history storage.\"\"\"\n    def __init__(self) -> None:\n        self._entries: List[dict] = []\n\n    def add(self, entry: dict) -> None:\n        \"\"\"Adds an entry to the in-memory repository.\"\"\"\n        self._entries.append(entry)\n\n    def list_all(self) -> List[dict]:\n        \"\"\"Lists all entries in the in-memory repository.\"\"\"\n        return list(self._entries)\n\n\ndef _normalize(text: str, case_sensitive: bool) -> str:\n    \"\"\"Normalizes text for comparison based on case sensitivity.\"\"\"\n    return text if case_sensitive else text.lower()\n\n\nclass StringFilterService:\n    \"\"\"Core filtering logic and optional persistence call.\"\"\"\n    def __init__(self, repository: Optional[object] = None) -> None:\n        self.repository = repository\n\n    def filter(self, request: FilterRequest) -> FilterResult:\n        \"\"\"Performs the filtering based on the request configuration.\"\"\"\n        mode = request.config.mode\n        case_sensitive = request.config.case_sensitive\n        results: List[str]\n\n        if mode == \"contains\":\n            results = self._filter_contains(request.strings, request.substring, case_sensitive)\n        elif mode == \"startswith\":\n            results = self._filter_startswith(request.strings, request.substring, case_sensitive)\n        elif mode == \"endswith\":\n            results = self._filter_endswith(request.strings, request.substring, case_sensitive)\n        elif mode == \"regex\":\n            results = self._filter_regex(request.strings, request.substring, case_sensitive)\n        else:\n            raise FilterError(f\"Unsupported mode: {mode}\")\n\n        if self.repository:\n            try:\n                self.repository.add({\n                    \"substring\": request.substring,\n                    \"mode\": request.config.mode,\n                    \"case_sensitive\": request.config.case_sensitive,\n                    \"input_count\": len(request.strings),\n                    \"matched_count\": len(results),\n                })\n            except Exception:\n                pass\n        return FilterResult(results)\n\n    def _filter_contains(self, strings: List[str], substring: str, case_sensitive: bool) -> List[str]:\n        \"\"\"Filters strings that contain the substring.\"\"\"\n        normalized_substring = _normalize(substring, case_sensitive)\n        return [\n            s for s in strings\n            if normalized_substring in _normalize(s, case_sensitive)\n        ]\n\n    def _filter_startswith(self, strings: List[str], substring: str, case_sensitive: bool) -> List[str]:\n        \"\"\"Filters strings that start with the substring.\"\"\"\n        normalized_substring = _normalize(substring, case_sensitive)\n        return [\n            s for s in strings\n            if _normalize(s, case_sensitive).startswith(normalized_substring)\n        ]\n\n    def _filter_endswith(self, strings: List[str], substring: str, case_sensitive: bool) -> List[str]:\n        \"\"\"Filters strings that end with the substring.\"\"\"\n        normalized_substring = _normalize(substring, case_sensitive)\n        return [\n            s for s in strings\n            if _normalize(s, case_sensitive).endswith(normalized_substring)\n        ]\n\n    def _filter_regex(self, strings: List[str], pattern: str, case_sensitive: bool) -> List[str]:\n        \"\"\"Filters strings that match the regex pattern.\"\"\"\n        flags = 0 if case_sensitive else re.IGNORECASE\n        compiled_pattern = re.compile(pattern, flags)\n        return [\n            s for s in strings\n            if compiled_pattern.search(s)\n        ]\n\n\nclass FilterController:\n    \"\"\"Orchestrates validation, service invocation, and error mapping.\"\"\"\n    def __init__(self, service: StringFilterService, validator: Validator) -> None:\n        self.service = service\n        self.validator = validator\n\n    def execute(self, strings: List[str], substring: str, config: FilterConfig | None = None) -> List[str]:\n        \"\"\"Executes the filtering process.\"\"\"\n        cfg = config or FilterConfig()\n\n        self.validator.validate_strings(strings)\n        cfg.validate()\n        self.validator.validate_substring(substring, cfg)\n\n        request = FilterRequest(strings=strings, substring=substring, config=cfg)\n        result = self.service.filter(request)\n        return result.results\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    cfg = FilterConfig(mode=\"contains\", case_sensitive=True, allow_empty_substring=False)\n    service = StringFilterService(repository=InMemoryRepository())\n    controller = FilterController(service=service, validator=Validator())\n    return controller.execute(strings, substring, cfg)"}
{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result: List[int] = []\n    current_max = numbers[0]\n    result.append(current_max)\n\n    for i in range(1, len(numbers)):\n        if numbers[i] > current_max:\n            current_max = numbers[i]\n        result.append(current_max)\n    \n    return result"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    def is_palindrome(s: str) -> bool:\n        return s == s[::-1]\n\n    if is_palindrome(string):\n        return string\n\n    n = len(string)\n    for i in range(n):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            prefix_to_reverse = string[:i]\n            return string + prefix_to_reverse[::-1]\n    \n    # This case should ideally not be reached for non-empty strings\n    # because a single character (the last one) is always a palindrome,\n    # making the loop find at least the last character as a suffix.\n    # For an empty string, it's handled by the initial check.\n    return string"}
{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    result: List[int] = []\n    current_max = None\n\n    for number in numbers:\n        if current_max is None or number > current_max:\n            current_max = number\n        result.append(current_max)\n\n    return result"}
{"task_id": "HumanEval/11", "solution": "```python\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    result = []\n    for char_a, char_b in zip(a, b):\n        if char_a == char_b:\n            result.append('0')\n        else:\n            result.append('1')\n    return ''.join(result)\n```"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    # Clean input strings by trimming whitespace as per design context.\n    a = a.strip()\n    b = b.strip()\n\n    # Determine the maximum length to which both strings must be padded.\n    max_len = max(len(a), len(b))\n\n    # Left-pad the shorter string with '0's to match the length of the longer string.\n    a_padded = a.rjust(max_len, '0')\n    b_padded = b.rjust(max_len, '0')\n\n    # Perform bitwise XOR character by character.\n    result_chars = []\n    for char_a, char_b in zip(a_padded, b_padded):\n        if char_a == char_b:\n            result_chars.append('0')\n        else:\n            result_chars.append('1')\n    \n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/12", "solution": "def longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_found_str = strings[0]\n    max_len = len(strings[0])\n\n    for s in strings[1:]:\n        if len(s) > max_len:\n            max_len = len(s)\n            longest_found_str = s\n\n    return longest_found_str"}
{"task_id": "HumanEval/12", "solution": "def longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    best = strings[0]\n    for s in strings[1:]:\n        if len(s) > len(best):\n            best = s\n    return best"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    import unicodedata\n\n    def _normalize_text(s: str) -> str:\n        # Normalize text using Unicode NFC as per design context\n        return unicodedata.normalize('NFC', s)\n\n    # Normalize the input string before processing\n    normalized_string = _normalize_text(string)\n\n    # Handle empty string explicitly\n    if not normalized_string:\n        return \"\"\n\n    # KMP-based approach to find the length of the longest palindromic suffix.\n    # This is equivalent to finding the length of the longest suffix of 'normalized_string'\n    # that is also a prefix of 'normalized_string' reversed.\n    \n    s_len = len(normalized_string)\n    rev_normalized_string = normalized_string[::-1]\n    \n    # Construct combined string: original + separator + reversed\n    # The LPS array of this combined string will give us the length\n    # of the longest suffix of 'normalized_string' which is a prefix of 'rev_normalized_string'.\n    # This length is precisely the length of the longest palindromic suffix of 'normalized_string'.\n    concat_string = normalized_string + \"#\" + rev_normalized_string\n    \n    n = len(concat_string)\n    lps = [0] * n # Longest Proper Prefix which is also Suffix array\n\n    # Compute LPS array for concat_string\n    length = 0 # length of the previous longest prefix suffix\n    i = 1\n    while i < n:\n        if concat_string[i] == concat_string[length]:\n            length += 1\n            lps[i] = length\n            i += 1\n        else:\n            if length != 0:\n                length = lps[length - 1] # Backtrack using previous LPS value\n            else:\n                lps[i] = 0 # No prefix is a suffix, reset length\n                i += 1\n                \n    # The last element of LPS array gives the length of the longest palindromic suffix\n    longest_palindromic_suffix_len = lps[-1]\n    \n    # The prefix of the original string that is NOT part of the longest palindromic suffix\n    prefix_to_reverse = normalized_string[:s_len - longest_palindromic_suffix_len]\n    \n    # Append the reverse of this prefix to the original string to form the shortest palindrome\n    return normalized_string + prefix_to_reverse[::-1]"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    a, b = abs(a), abs(b)\n    if a == 0 and b == 0:\n        return 0\n    while b != 0:\n        a, b = b, a % b\n    return a"}
