{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Compares two numbers (int, float, or string) and returns the larger value, preserving its original type.\n    Returns None if the values are numerically equal.\n    \"\"\"\n    from decimal import Decimal, getcontext, InvalidOperation\n\n    # Set the precision for Decimal operations globally within this function's scope.\n    getcontext().prec = 28\n\n    class ParsedNumber:\n        \"\"\"Holds the original value, its type, and its Decimal representation.\"\"\"\n        def __init__(self, original, original_type, numeric):\n            self.original = original\n            self.original_type = original_type\n            self.numeric = numeric\n\n    class ParseError(Exception):\n        \"\"\"Custom exception for errors during number parsing.\"\"\"\n        def __init__(self, message):\n            super().__init__(message)\n            self.message = message\n\n    def normalize_numeric_string(s: str) -> str:\n        \"\"\"Trims whitespace and normalizes decimal separators in a string.\"\"\"\n        s = s.strip()\n        if \",\" in s and \".\" in s:\n            if s.count(\",\") == 1 and s.count(\".\") >= 1:\n                # Rejects ambiguous cases like \"1.234,56\" where comma is a decimal and dot is a thousands separator.\n                raise ValueError(\"Ambiguous decimal separators\")\n            # Rejects any other cases where both comma and dot are present.\n            raise ValueError(\"Ambiguous numeric format with both '.' and ','\")\n        s = s.replace(\",\", \".\")\n        return s\n\n    class NumberParser:\n        \"\"\"Parses various input types into ParsedNumber objects.\"\"\"\n        def parse(self, value):\n            if isinstance(value, int):\n                numeric = Decimal(value)\n                return ParsedNumber(original=value, original_type=int, numeric=numeric)\n            if isinstance(value, float):\n                # Convert float to string first to avoid potential precision issues when creating Decimal.\n                numeric = Decimal(str(value))\n                return ParsedNumber(original=value, original_type=float, numeric=numeric)\n            if isinstance(value, str):\n                try:\n                    normalized = normalize_numeric_string(value)\n                    numeric = Decimal(normalized)\n                    return ParsedNumber(original=value, original_type=str, numeric=numeric)\n                except (InvalidOperation, ValueError) as exc:\n                    raise ParseError(f\"Cannot parse '{value}': {exc}\") from exc\n            raise ParseError(f\"Unsupported type: {type(value)}\")\n\n    class ComparatorService:\n        \"\"\"Orchestrates parsing and comparison of two values.\"\"\"\n        def __init__(self, parser=None):\n            self.parser = parser or NumberParser()\n\n        def compare(self, a, b):\n            pa = self.parser.parse(a)\n            pb = self.parser.parse(b)\n\n            if pa.numeric > pb.numeric:\n                return pa.original\n            if pb.numeric > pa.numeric:\n                return pb.original\n            \n            # If values are numerically equal, return None\n            return None\n\n    # Instantiate the default service and perform the comparison.\n    _default_service = ComparatorService()\n    return _default_service.compare(a, b)"}
{"task_id": "HumanEval/137", "solution": "from decimal import Decimal\n\ndef compare_one(a, b):\n    \"\"\"\n    Compares two numeric values (int, float, or string representations)\n    and returns the larger, preserving its original type. Returns None if equal.\n    \"\"\"\n\n    def _normalize_numeric_string(s: str) -> str:\n        \"\"\"\n        Normalizes a string representation of a number, handling ',' or '.' as decimal separators.\n        \"\"\"\n        s = s.strip()\n        \n        # Check if both '.' and ',' are present\n        if '.' in s and ',' in s:\n            last_dot_idx = s.rfind('.')\n            last_comma_idx = s.rfind(',')\n\n            # The design specifies: \"assume the last occurrence is the decimal separator\"\n            if last_dot_idx > last_comma_idx:  # Last separator is dot, so comma is thousands\n                s = s.replace(',', '')\n            else:  # Last separator is comma, so dot is thousands\n                s = s.replace('.', '')\n                s = s.replace(',', '.')  # Replace decimal comma with dot\n        elif ',' in s:  # Only comma present, treat as decimal\n            s = s.replace(',', '.')\n            \n        return s\n\n    def _parse_value(value):\n        \"\"\"\n        Parses an input value (int, float, or string) into a Decimal,\n        preserving the original value and type for later return.\n        \"\"\"\n        if isinstance(value, str):\n            normalized_s = _normalize_numeric_string(value)\n            decimal_value = Decimal(normalized_s)\n            return decimal_value, value, str\n        elif isinstance(value, (int, float)):\n            # Convert floats via string to Decimal to maintain precision.\n            decimal_value = Decimal(str(value)) if isinstance(value, float) else Decimal(value)\n            return decimal_value, value, type(value)\n        # This branch implicitly handles `Decimal` type if passed directly.\n        else:\n            decimal_value = Decimal(value)\n            return decimal_value, value, type(value)\n\n    dec_a, orig_a, _ = _parse_value(a)\n    dec_b, orig_b, _ = _parse_value(b)\n\n    if dec_a > dec_b:\n        return orig_a\n    elif dec_b > dec_a:\n        return orig_b\n    else:\n        return None"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers\n    Example\n    is_equal_to_sum_even(4) == False\n    is_equal_to_sum_even(6) == False\n    is_equal_to_sum_even(8) == True\n    \"\"\"\n    # A number n is the sum of exactly 4 positive even numbers if it is even and at least 8.\n    return n % 2 == 0 and n >= 8"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n    \"\"\"\n    from functools import lru_cache\n\n    @lru_cache(maxsize=None)\n    def _factorial(k):\n        # Computes k! iteratively, memoizing results for efficiency.\n        if k == 0:\n            return 1\n        result = 1\n        for i in range(1, k + 1):\n            result *= i\n        return result\n\n    total_product = 1\n    # Calculates the product of factorials from 1! up to n!.\n    for i in range(1, n + 1):\n        total_product *= _factorial(i)\n\n    return total_product"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    current_factorial = 1\n    special_fact_result = 1\n\n    # Iterate from 1 to n to calculate i! and accumulate the product.\n    for i in range(1, n + 1):\n        current_factorial *= i  # Calculate i! based on (i-1)!\n        special_fact_result *= current_factorial  # Multiply by the current i!\n\n    return special_fact_result"}
{"task_id": "HumanEval/140", "solution": "import re\n\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n    \"\"\"\n    HYPHEN_THRESHOLD = 3\n\n    def replacement_logic(match):\n        run_length = len(match.group(0))\n        if run_length >= HYPHEN_THRESHOLD:\n            return \"-\"\n        return \"_\"\n\n    return re.sub(r\" +\", replacement_logic, text)"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \"\"\"\n    out_chars = []\n    i = 0\n    n = len(text)\n    while i < n:\n        if text[i] == \" \":\n            j = i\n            while j < n and text[j] == \" \":\n                j += 1\n            run_len = j - i\n            if run_len >= 3:\n                out_chars.append(\"-\")\n            else:\n                out_chars.append(\"_\" * run_len)\n            i = j\n        else:\n            out_chars.append(text[i])\n            i += 1\n    return \"\".join(out_chars)"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on specific criteria.\"\"\"\n\n    # Condition 1: There should not be more than three digits ('0'-'9') in the file's name.\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    # Condition 2: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n    \n    # Split the file name into prefix and suffix based on the single dot\n    prefix, suffix = file_name.rsplit('.', 1)\n\n    # Condition 3: The substring before the dot should not be empty,\n    # and it starts with a letter from the latin alphabet ('a'-'z' and 'A'-'Z').\n    if not prefix:\n        return 'No'\n    \n    first_char_prefix = prefix[0]\n    # Check if the first character of the prefix is a Latin letter\n    if not ('a' <= first_char_prefix <= 'z' or 'A' <= first_char_prefix <= 'Z'):\n        return 'No'\n\n    # Condition 4: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    allowed_suffixes = {'txt', 'exe', 'dll'}\n    # Suffix comparison is case-insensitive as per design context\n    if suffix.lower() not in allowed_suffixes:\n        return 'No'\n\n    # All conditions are met\n    return 'Yes'"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions \n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from \n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n    \n    # Condition 1: There should not be more than three digits ('0'-'9')\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    # Condition 2: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # Split the file name into name and extension based on the single dot\n    # This also implicitly handles cases where dot is at the start or end,\n    # leading to empty name or ext parts which are checked next.\n    parts = file_name.split('.')\n    name = parts[0]\n    ext = parts[1]\n\n    # Condition 3: The substring before the dot should not be empty, \n    # and it starts with a letter from the latin alphapet ('a'-'z' and 'A'-'Z').\n    if not name:  # Substring before the dot should not be empty\n        return 'No'\n    if not name[0].isalpha(): # It starts with a letter from the latin alphabet\n        return 'No'\n\n    # Condition 4: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    allowed_extensions = {'txt', 'exe', 'dll'}\n    # Case-insensitive check for extension as per design context\n    if ext.lower() not in allowed_extensions:\n        return 'No'\n\n    # If all conditions are met\n    return 'Yes'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    total_sum = 0\n    for i, value in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += value * value\n        elif i % 4 == 0:  # This 'elif' ensures precedence: only if not a multiple of 3\n            total_sum += value * value * value\n        else:\n            total_sum += value\n    return total_sum"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    total_sum = 0\n    for i, value in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += value ** 2\n        elif i % 4 == 0:\n            total_sum += value ** 3\n        else:\n            total_sum += value\n    return total_sum"}
{"task_id": "HumanEval/143", "solution": "import re\nfrom dataclasses import dataclass\nfrom typing import List, Optional\n\n@dataclass(frozen=True)\nclass Word:\n    text: str\n    length: int\n\n    @staticmethod\n    def from_text(text: str) -> \"Word\":\n        return Word(text=text, length=len(text))\n\nclass PrimeCache:\n    def __init__(self) -> None:\n        self._store: dict[int, bool] = {}\n\n    def get(self, n: int) -> Optional[bool]:\n        return self._store.get(n)\n\n    def set(self, n: int, value: bool) -> None:\n        self._store[n] = value\n\n    def clear(self) -> None:\n        self._store.clear()\n\nclass PrimeService:\n    def __init__(self, use_cache: bool = False) -> None:\n        self.cache = PrimeCache() if use_cache else None\n\n    def is_prime(self, n: int) -> bool:\n        if self.cache:\n            cached = self.cache.get(n)\n            if cached is not None:\n                return cached\n\n        result = self._compute_is_prime(n)\n\n        if self.cache:\n            self.cache.set(n, result)\n        return result\n\n    def _compute_is_prime(self, n: int) -> bool:\n        if n < 2:\n            return False\n        if n in (2, 3):\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\nclass Tokenizer:\n    WHITESPACE_RE = r'\\s+'\n\n    def tokenize(self, sentence: str) -> List[str]:\n        tokens = re.split(self.WHITESPACE_RE, sentence.strip())\n        return [token for token in tokens if token]\n\nclass SentenceService:\n    def __init__(self, tokenizer: Tokenizer, prime_service: PrimeService) -> None:\n        self.tokenizer = tokenizer\n        self.prime_service = prime_service\n\n    def words_in_sentence(self, sentence: str) -> str:\n        tokens = self.tokenizer.tokenize(sentence)\n        \n        filtered_words = []\n        for token in tokens:\n            word = Word.from_text(token)\n            if self.prime_service.is_prime(word.length):\n                filtered_words.append(word.text)\n        \n        return \" \".join(filtered_words)\n\n_default_tokenizer = Tokenizer()\n_default_prime_service = PrimeService(use_cache=False)\n_default_sentence_service = SentenceService(\n    tokenizer=_default_tokenizer,\n    prime_service=_default_prime_service\n)\n\ndef words_in_sentence(sentence):\n    \"\"\"\n    Returns a string containing words from the original sentence whose lengths are prime numbers,\n    maintaining the original order.\n    \"\"\"\n    return _default_sentence_service.words_in_sentence(sentence)"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Checks if the product of two fraction strings x and n evaluates to a whole number.\"\"\"\n\n    def _gcd(a, b):\n        # Calculates the greatest common divisor of two integers.\n        while b:\n            a, b = b, a % b\n        return a\n\n    def _parse_fraction(fraction_str):\n        # Parses a fraction string \"num/den\" into a tuple of integers (num, den).\n        parts = fraction_str.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return numerator, denominator\n\n    # Parse the input fractions\n    num1, den1 = _parse_fraction(x)\n    num2, den2 = _parse_fraction(n)\n\n    # Calculate the product of the numerators and denominators\n    product_numerator = num1 * num2\n    product_denominator = den1 * den2\n\n    # Reduce the product fraction by dividing both numerator and denominator by their GCD.\n    common_divisor = _gcd(abs(product_numerator), abs(product_denominator))\n    reduced_product_denominator = product_denominator // common_divisor\n\n    # A fraction is a whole number if its reduced denominator is 1.\n    return reduced_product_denominator == 1"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    You are given a string representing a sentence,\n    the sentence contains some words separated by a space,\n    and you have to return a string that contains the words from the original sentence,\n    whose lengths are prime numbers,\n    the order of the words in the new string should be the same as the original one.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a given number is prime.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    words = sentence.split()\n    prime_length_words = []\n    for word in words:\n        if is_prime(len(word)):\n            prime_length_words.append(word)\n\n    return \" \".join(prime_length_words)"}
{"task_id": "HumanEval/144", "solution": "import os\nimport json\nimport datetime\nimport uuid\nimport sys\n\n# --- Exceptions ---\nclass FractionParseError(ValueError):\n    \"\"\"Custom exception for errors during fraction parsing.\"\"\"\n    pass\n\nclass RepositoryError(IOError):\n    \"\"\"Custom exception for errors during repository operations.\"\"\"\n    pass\n\nclass SimplifierError(RuntimeError):\n    \"\"\"Custom exception for unexpected internal errors in simplification logic.\"\"\"\n    pass\n\n# --- Config ---\nclass Config:\n    \"\"\"Central configuration and utility to ensure data directories exist.\"\"\"\n    LOG_FILE_PATH: str = \"./data/evaluations.log\"\n    HTTP_ENABLED: bool = False\n\n    @staticmethod\n    def ensure_data_dir():\n        \"\"\"Ensures the parent directory for the log file exists.\"\"\"\n        log_dir = os.path.dirname(Config.LOG_FILE_PATH)\n        if log_dir and not os.path.exists(log_dir):\n            try:\n                os.makedirs(log_dir, exist_ok=True)\n            except OSError as e:\n                print(f\"Warning: Could not create log directory {log_dir}: {e}\", file=sys.stderr)\n\n# --- Models ---\nclass FractionModel:\n    \"\"\"Represents a fraction with numerator and denominator.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        if not isinstance(numerator, int) or not isinstance(denominator, int):\n            raise FractionParseError(\"Numerator and denominator must be integers.\")\n        if denominator == 0:\n            raise FractionParseError(\"Denominator cannot be zero.\")\n        if numerator <= 0 or denominator <= 0:\n             raise FractionParseError(\"Numerator and denominator must be positive whole numbers.\")\n\n        self.numerator = numerator\n        self.denominator = denominator\n\n    def as_tuple(self) -> tuple[int, int]:\n        \"\"\"Returns the fraction as a (numerator, denominator) tuple.\"\"\"\n        return (self.numerator, self.denominator)\n\n    def to_dict(self) -> dict:\n        \"\"\"Returns a dictionary representation for serialization.\"\"\"\n        return {\"numerator\": self.numerator, \"denominator\": self.denominator}\n\n# --- Parser ---\nclass FractionParser:\n    \"\"\"Parses string fraction representations into FractionModel.\"\"\"\n    def parse(self, fraction_str: str) -> FractionModel:\n        \"\"\"Converts a string 'num/den' into a FractionModel.\"\"\"\n        s = fraction_str.strip()\n        parts = s.split(\"/\")\n        if len(parts) != 2:\n            raise FractionParseError(f\"Invalid fraction format: {fraction_str}\")\n        try:\n            num = int(parts[0])\n            den = int(parts[1])\n        except ValueError:\n            raise FractionParseError(f\"Non-integer value in fraction: {fraction_str}\")\n        return FractionModel(numerator=num, denominator=den)\n\n# --- GCDUtil ---\nclass GCDUtil:\n    \"\"\"Utility class for calculating the Greatest Common Divisor.\"\"\"\n    def gcd(self, a: int, b: int) -> int:\n        \"\"\"Computes the GCD of two integers using the Euclidean algorithm.\"\"\"\n        a, b = abs(a), abs(b)\n        while b:\n            a, b = b, a % b\n        return a\n\n# --- Repository ---\nclass FractionRepository:\n    \"\"\"Manages persistence of evaluation logs to an NDJSON file.\"\"\"\n    def __init__(self, log_path: str = Config.LOG_FILE_PATH):\n        self.log_path = log_path\n        Config.ensure_data_dir()\n\n    def append_log(self, entry: dict) -> None:\n        \"\"\"Appends a JSON object as a newline to the log file.\"\"\"\n        try:\n            with open(self.log_path, \"a\", encoding=\"utf-8\") as f:\n                json.dump(entry, f)\n                f.write(\"\\n\")\n        except IOError as e:\n            raise RepositoryError(f\"Failed to write log entry to {self.log_path}: {e}\")\n        except Exception as e:\n             raise RepositoryError(f\"An unexpected error occurred while writing log: {e}\")\n\n# --- Service ---\nclass SimplifierService:\n    \"\"\"Core business logic for simplifying fraction products and logging.\"\"\"\n    def __init__(self, parser: FractionParser, gcd_util: GCDUtil, repository: FractionRepository):\n        self.parser = parser\n        self.gcd_util = gcd_util\n        self.repository = repository\n\n    def _multiply_and_simplify(self, fx: FractionModel, fn: FractionModel) -> tuple[int, int]:\n        \"\"\"Multiplies two fractions and returns their simplified numerator and denominator.\"\"\"\n        product_num = fx.numerator * fn.numerator\n        product_den = fx.denominator * fn.denominator\n        \n        common_divisor = self.gcd_util.gcd(product_num, product_den)\n\n        simplified_num = product_num // common_divisor\n        simplified_den = product_den // common_divisor\n        \n        return (simplified_num, simplified_den)\n\n    def simplify(self, x: str, n: str) -> bool:\n        \"\"\"Parses, multiplies, simplifies fractions, and logs the result.\"\"\"\n        fx = self.parser.parse(x)\n        fn = self.parser.parse(n)\n\n        simplified_num, simplified_den = self._multiply_and_simplify(fx, fn)\n        \n        is_whole = (simplified_den == 1)\n\n        log_entry = {\n            \"id\": str(uuid.uuid4()),\n            \"timestamp\": datetime.datetime.utcnow().isoformat(timespec='seconds') + 'Z',\n            \"x\": fx.to_dict(),\n            \"n\": fn.to_dict(),\n            \"product\": {\"numerator\": simplified_num, \"denominator\": simplified_den},\n            \"is_whole\": is_whole\n        }\n\n        try:\n            self.repository.append_log(log_entry)\n        except RepositoryError as e:\n            print(f\"Warning: Failed to write log entry: {e}\", file=sys.stderr)\n            log_entry[\"note\"] = \"repository_error\"\n        except Exception as e:\n            print(f\"Warning: An unexpected error occurred during logging: {e}\", file=sys.stderr)\n            log_entry[\"note\"] = \"logging_unexpected_error\"\n\n        return is_whole\n\n# --- Controller ---\nclass SimplifierController:\n    \"\"\"Provides public API endpoints and delegates to SimplifierService.\"\"\"\n    def __init__(self, service: SimplifierService):\n        self.service = service\n\n    def simplify(self, x: str, n: str) -> bool:\n        \"\"\"Delegates the simplification task to the service layer.\"\"\"\n        return self.service.simplify(x, n)\n\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    repo = FractionRepository()\n    service = SimplifierService(FractionParser(), GCDUtil(), repo)\n    controller = SimplifierController(service)\n    \n    return controller.simplify(x, n)"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Counts numbers greater than 10 where both first and last digits are odd.\"\"\"\n    count = 0\n    odd_digits = frozenset({'1', '3', '5', '7', '9'})\n\n    for num in nums:\n        if num > 10:\n            num_str = str(num)\n            first_digit = num_str[0]\n            last_digit = num_str[-1]\n\n            if first_digit in odd_digits and last_digit in odd_digits:\n                count += 1\n    return count"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    Ties are broken by the original index of the numbers.\n    \"\"\"\n\n    def _calculate_digit_sum(n_val):\n        \"\"\"Calculates the sum of the absolute value of digits of an integer.\"\"\"\n        s = 0\n        n_abs = abs(n_val)\n        # For n_val = 0, n_abs is 0, loop doesn't run, s remains 0, which is correct.\n        while n_abs > 0:\n            s += n_abs % 10\n            n_abs //= 10\n        return s\n\n    # Create a list of tuples: (digit_sum, original_index, original_value).\n    # This allows Python's sorted() to naturally sort by digit_sum first,\n    # then by original_index for tie-breaking, then by original_value (though not strictly required by prompt for tie-breaking).\n    augmented_nums = []\n    for i, num in enumerate(nums):\n        digit_sum = _calculate_digit_sum(num)\n        augmented_nums.append((digit_sum, i, num))\n\n    # Sort the augmented list. Python's tuple sorting rules ensure the correct order.\n    sorted_augmented_nums = sorted(augmented_nums)\n\n    # Extract the original values from the sorted list of tuples.\n    result = [item[2] for item in sorted_augmented_nums]\n    return result"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers by the sum of their digits in ascending order.\n    For ties, items are ordered based on their original index in the input list.\n    \"\"\"\n\n    def _digit_sum(n: int) -> int:\n        # Computes the sum of digits for the absolute value of an integer.\n        total = 0\n        n_abs = abs(n)\n        while n_abs > 0:\n            total += n_abs % 10\n            n_abs //= 10\n        return total\n\n    # Create a list of tuples: (digit_sum, original_index, original_value).\n    # This structure allows for multi-key sorting directly by tuples.\n    items_for_sorting = []\n    for i, num in enumerate(nums):\n        items_for_sorting.append((_digit_sum(num), i, num))\n\n    # Sort the list. Python's default tuple comparison sorts element by element:\n    # first by digit_sum (ascending), then by original_index (ascending),\n    # then by original_value (ascending) if sums and indices are identical.\n    sorted_items = sorted(items_for_sorting)\n\n    # Extract and return the original values from the sorted list.\n    return [item[2] for item in sorted_items]"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"\n    Counts numbers in the array that are greater than 10 and have both\n    first and last digits odd.\n    \"\"\"\n    def _first_digit(value: int) -> int:\n        # Returns the most significant digit of the absolute value.\n        v = abs(value)\n        if v == 0:\n            return 0\n        while v >= 10:\n            v //= 10\n        return v\n\n    def _last_digit(value: int) -> int:\n        # Returns the least significant digit of the absolute value.\n        return abs(value) % 10\n\n    def _is_odd_digit(d: int) -> bool:\n        # Checks if a digit is odd (1, 3, 5, 7, 9).\n        return d in {1, 3, 5, 7, 9}\n\n    count = 0\n    for n in nums:\n        if n > 10:\n            first_d = _first_digit(n)\n            last_d = _last_digit(n)\n            if _is_odd_digit(first_d) and _is_odd_digit(last_d):\n                count += 1\n    return count"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from the sequence a[i] = i*i - i + 1,\n    where i < j < k and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n\n    def comb3(x):\n        \"\"\"Calculates the number of combinations C(x, 3).\"\"\"\n        if x < 3:\n            return 0\n        return (x * (x - 1) * (x - 2)) // 6\n\n    # Analyze a[i] = i*i - i + 1 modulo 3:\n    # If i % 3 == 0, then a[i] % 3 = (0*0 - 0 + 1) % 3 = 1\n    # If i % 3 == 1, then a[i] % 3 = (1*1 - 1 + 1) % 3 = 1\n    # If i % 3 == 2, then a[i] % 3 = (2*2 - 2 + 1) % 3 = 3 % 3 = 0\n    # This means a[i] values are either 0 mod 3 or 1 mod 3; never 2 mod 3.\n\n    # Count of numbers i (1 to n) such that i % 3 == 2.\n    # These indices correspond to a[i] values that are 0 mod 3.\n    count_a_res0 = n // 3\n    if n % 3 == 2:\n        count_a_res0 += 1\n    \n    # Count of numbers i (1 to n) such that i % 3 == 0 or i % 3 == 1.\n    # These indices correspond to a[i] values that are 1 mod 3.\n    # Since a[i] is never 2 mod 3, this is simply n - count_a_res0.\n    count_a_res1 = n - count_a_res0\n\n    # For a[i] + a[j] + a[k] to be a multiple of 3, the residues modulo 3 must sum to a multiple of 3.\n    # Possible combinations of residues (where 2 mod 3 is impossible):\n    # 1. (0 + 0 + 0) % 3 = 0\n    # 2. (1 + 1 + 1) % 3 = 0\n    \n    # Calculate combinations for each valid residue group.\n    return comb3(count_a_res0) + comb3(count_a_res1)"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    '''\n    Returns a tuple of planets whose orbits are between planet1 and planet2,\n    sorted by proximity to the Sun. Returns an empty tuple for invalid names.\n    '''\n\n    # Canonical list of planets, ordered by proximity to the Sun\n    PLANETS_ORDER = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\n\n    # Helper function to normalize planet names\n    def normalize_name(name: str) -> str:\n        return name.strip().title()\n\n    # Domain model for a Planet\n    class Planet:\n        def __init__(self, name: str, order: int) -> None:\n            self._name = name\n            self._order = order\n\n        @property\n        def name(self) -> str:\n            return self._name\n\n        @property\n        def order(self) -> int:\n            return self._order\n\n    # Repository to access planet data\n    class PlanetRepository:\n        def __init__(self) -> None:\n            self._planets = [Planet(name, idx + 1) for idx, name in enumerate(PLANETS_ORDER)]\n\n        def get_all_planets(self) -> list[Planet]:\n            return list(self._planets)\n\n        def get_planet_by_name(self, normalized_name: str) -> Planet | None:\n            for p in self._planets:\n                if p.name == normalized_name:\n                    return p\n            return None\n\n    # Service containing the core business logic\n    class PlanetService:\n        def __init__(self, repo: PlanetRepository) -> None:\n            self._repo = repo\n\n        def planets_between(self, planet1_raw: str, planet2_raw: str) -> tuple[str, ...]:\n            p1_norm = normalize_name(planet1_raw)\n            p2_norm = normalize_name(planet2_raw)\n\n            p1 = self._repo.get_planet_by_name(p1_norm)\n            p2 = self._repo.get_planet_by_name(p2_norm)\n\n            if p1 is None or p2 is None:\n                return ()\n\n            low_order, high_order = sorted((p1.order, p2.order))\n\n            if high_order - low_order <= 1:\n                return ()\n\n            between_planets_names = [\n                p.name for p in self._repo.get_all_planets() \n                if low_order < p.order < high_order\n            ]\n            return tuple(between_planets_names)\n\n    # Controller logic to orchestrate the call\n    repo = PlanetRepository()\n    svc = PlanetService(repo)\n    return svc.planets_between(planet1, planet2)"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    \n    # Define the canonical order of planets.\n    PLANETS = [\n        \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n    ]\n\n    # Create a mapping from normalized planet names to their indices for quick lookup.\n    PLANET_TO_INDEX = {name.title(): i for i, name in enumerate(PLANETS)}\n\n    def _normalize_name(name):\n        # Helper to normalize planet names by stripping whitespace and title-casing.\n        return name.strip().title()\n\n    # Normalize input planet names.\n    norm_planet1 = _normalize_name(planet1)\n    norm_planet2 = _normalize_name(planet2)\n\n    # Return an empty tuple if either normalized planet name is not recognized.\n    if norm_planet1 not in PLANET_TO_INDEX or norm_planet2 not in PLANET_TO_INDEX:\n        return ()\n\n    # Get the indices of the two planets.\n    idx1 = PLANET_TO_INDEX[norm_planet1]\n    idx2 = PLANET_TO_INDEX[norm_planet2]\n\n    # Determine the slice range, ensuring it covers planets strictly between the two inputs.\n    start_idx = min(idx1, idx2) + 1\n    end_idx = max(idx1, idx2)\n\n    # If the calculated range is invalid (e.g., planets are adjacent or the same), return an empty tuple.\n    if start_idx >= end_idx:\n        return ()\n    \n    # Slice the canonical PLANETS list to get the planets in between and convert to a tuple.\n    return tuple(PLANETS[start_idx:end_idx])"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters the input list to include only even-length strings,\n    then sorts them by length (ascending) and alphabetically (ascending) for ties.\n    \"\"\"\n    \n    # Filter out strings with odd lengths\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    \n    # Sort the remaining strings: first by length, then alphabetically for same-length words\n    # Python's sorted function sorts tuples lexicographically, which achieves the desired order.\n    sorted_result = sorted(even_length_strings, key=lambda s: (len(s), s))\n    \n    return sorted_result"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k, \n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n\n    class Combinatorics:\n        \"\"\"Provides combinatoric helper methods for C(n, k).\"\"\"\n        def n_choose_k(self, n_val: int, k_val: int) -> int:\n            if k_val < 0 or k_val > n_val:\n                return 0\n            \n            # Optimization: C(n, k) = C(n, n-k)\n            k_val_effective = min(k_val, n_val - k_val)\n            \n            result = 1\n            for i in range(1, k_val_effective + 1):\n                # Iterative multiplicative formula: C(n,k) = (n * (n-1) * ... * (n-k+1)) / k!\n                # This loop implements C(n, k_effective) = product((n - k_effective + i) / i) for i from 1 to k_effective\n                result = result * (n_val - k_val_effective + i) // i\n            return result\n\n    class SequenceStats:\n        \"\"\"DTO to store counts of elements congruent to 0 or 1 modulo 3.\"\"\"\n        def __init__(self, c0: int, c1: int) -> None:\n            self.count_mod0 = c0\n            self.count_mod1 = c1\n\n    class TriplesService:\n        \"\"\"Encapsulates the core algorithm to compute triple counts.\"\"\"\n        def __init__(self, comb_instance: Combinatorics) -> None:\n            self._comb = comb_instance\n\n        def compute_triples(self, n_val: int) -> int:\n            # Assumes n_val is a non-negative integer as per design context (FR1) and prompt constraints.\n            stats = self._compute_sequence_stats(n_val)\n            # The sum a[i] + a[j] + a[k] is a multiple of 3 if:\n            # 1. All three are 0 (mod 3) -> C(count_mod0, 3)\n            # 2. All three are 1 (mod 3) -> C(count_mod1, 3)\n            return self._comb.n_choose_k(stats.count_mod0, 3) + self._comb.n_choose_k(stats.count_mod1, 3)\n\n        def _compute_sequence_stats(self, n_val: int) -> SequenceStats:\n            # Handles n < 0 gracefully by returning zero counts\n            if n_val < 0:\n                return SequenceStats(0, 0)\n\n            q, r = divmod(n_val, 3)\n\n            # Analyze a[i] = i*i - i + 1 (mod 3) for i from 1 to n_val:\n            # If i % 3 == 0, a[i] % 3 == 0*0 - 0 + 1 = 1\n            # If i % 3 == 1, a[i] % 3 == 1*1 - 1 + 1 = 1\n            # If i % 3 == 2, a[i] % 3 == 2*2 - 2 + 1 = 4 - 2 + 1 = 3 = 0\n\n            # Count of i in [1, n_val] where i % 3 == 0: q\n            # Count of i in [1, n_val] where i % 3 == 1: q + (1 if r >= 1 else 0)\n            # Count of i in [1, n_val] where i % 3 == 2: q + (1 if r >= 2 else 0)\n\n            # count_mod0 refers to a[i] % 3 == 0, which happens when i % 3 == 2\n            count_mod0 = q + (1 if r >= 2 else 0)\n            # count_mod1 refers to a[i] % 3 == 1, which happens when i % 3 == 0 or i % 3 == 1\n            # This is simply the total count of numbers in the sequence a (n_val) minus those that are 0 (mod 3).\n            count_mod1 = n_val - count_mod0\n\n            return SequenceStats(count_mod0, count_mod1)\n\n    # Instantiate the necessary helper classes within the function.\n    comb_instance = Combinatorics()\n    service_instance = TriplesService(comb_instance)\n\n    return service_instance.compute_triples(n)"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Write a function that accepts a list of strings as a parameter,\n    deletes the strings that have odd lengths from it,\n    and returns the resulted list with a sorted order,\n    The list is always a list of strings and never an array of numbers,\n    and it may contain duplicates.\n    The order of the list should be ascending by length of each word, and you\n    should return the list sorted by that rule.\n    If two words have the same length, sort the list alphabetically.\n    The function should return a list of strings in sorted order.\n    You may assume that all words will have the same length.\n    For example:\n    assert list_sort([\"aa\", \"a\", \"aaa\"]) => [\"aa\"]\n    assert list_sort([\"ab\", \"a\", \"aaa\", \"cd\"]) => [\"ab\", \"cd\"]\n    \"\"\"\n    # Filter out strings with odd lengths.\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n\n    # Sort the remaining strings by length, then alphabetically for ties.\n    return sorted(even_length_strings, key=lambda s: (len(s), s))"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n    \"\"\"\n    import math\n\n    def _is_prime(num: int) -> bool:\n        \"\"\"Checks if a number is prime using optimized trial division.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        \n        # Check for divisibility by odd numbers from 3 up to the square root of num.\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    if _is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \"\"\"\n    import math\n\n    total_sum = 0\n    if lst is None:\n        return 0\n\n    for item in lst:\n        try:\n            num = float(item)\n        except (ValueError, TypeError):\n            continue\n\n        if not math.isfinite(num):\n            continue\n\n        if num < 0:\n            continue\n\n        if not num.is_integer():\n            continue\n\n        int_val = int(num)\n        if int_val % 2 != 0:\n            total_sum += int_val * int_val\n            \n    return total_sum"}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"I think we all remember that feeling when the result of some long-awaited\n    event is finally known. The feelings and thoughts you have at that moment are\n    definitely worth noting down and comparing.\n    Your task is to determine if a person correctly guessed the results of a number of matches.\n    You are given two arrays of scores and guesses of equal length, where each index shows a match. \n    Return an array of the same length denoting how far off each guess was. If they have guessed correctly,\n    the value is 0, and if not, the value is the absolute difference between the guess and the score.\n    \n    \n    example:\n\n    compare([1,2,3,4,5,1],[1,2,3,4,2,-2]) -> [0,0,0,0,3,3]\n    compare([0,5,0,0,0,4],[4,1,1,0,0,-2]) -> [4,4,1,0,0,6]\n    \"\"\"\n    \n    result = []\n    for g_score, g_guess in zip(game, guess):\n        if g_score == g_guess:\n            result.append(0)\n        else:\n            result.append(abs(g_score - g_guess))\n    return result"}
