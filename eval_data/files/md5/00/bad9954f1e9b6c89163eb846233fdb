{"task_id": "HumanEval/55", "solution": "import abc\nimport threading\n\nclass InvalidParameterError(ValueError):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    pass\n\nclass FibComputationError(RuntimeError):\n    \"\"\"Exception raised for errors during Fibonacci computation.\"\"\"\n    pass\n\nclass CacheError(RuntimeError):\n    \"\"\"Exception raised for errors during cache operations.\"\"\"\n    pass\n\ndef validate_n(n: int) -> None:\n    \"\"\"This validation function is a no-op given the problem constraints and preconditions.\"\"\"\n    pass\n\nclass CacheRepository(abc.ABC):\n    \"\"\"Abstract base class for cache repositories.\"\"\"\n    @abc.abstractmethod\n    def get(self, n: int) -> str | None:\n        pass\n    @abc.abstractmethod\n    def set(self, n: int, value: str) -> None:\n        pass\n    @abc.abstractmethod\n    def delete(self, n: int) -> None:\n        pass\n    @abc.abstractmethod\n    def clear(self) -> None:\n        pass\n\nclass InMemoryCacheRepository(CacheRepository):\n    \"\"\"An in-memory implementation of the CacheRepository.\"\"\"\n    def __init__(self, max_size: int | None = None):\n        self._store: dict[int, str] = {}\n        self._lock = threading.Lock()\n        self._max_size = max_size\n\n    def get(self, n: int) -> str | None:\n        with self._lock:\n            return self._store.get(n)\n\n    def set(self, n: int, value: str) -> None:\n        with self._lock:\n            self._store[n] = value\n            if self._max_size and len(self._store) > self._max_size:\n                # Simple FIFO eviction if max_size is exceeded.\n                if self._store:\n                    self._store.pop(next(iter(self._store)))\n\n    def delete(self, n: int) -> None:\n        with self._lock:\n            if n in self._store:\n                del self._store[n]\n\n    def clear(self) -> None:\n        with self._lock:\n            self._store.clear()\n\nDEFAULT_CACHE = \"inmemory\"\n\ndef create_cache(name: str = DEFAULT_CACHE, **kwargs) -> CacheRepository:\n    \"\"\"Creates a cache repository instance, defaulting to in-memory.\"\"\"\n    # In this self-contained context, only InMemoryCacheRepository is supported.\n    return InMemoryCacheRepository(**kwargs)\n\nclass FibonacciService:\n    \"\"\"Service to compute Fibonacci numbers with optional caching.\"\"\"\n    def __init__(self, cache: CacheRepository):\n        self._cache = cache\n\n    def compute(self, n: int, use_cache: bool = True) -> int:\n        \"\"\"Computes the n-th Fibonacci number, using the cache if enabled.\"\"\"\n        validate_n(n) # This call is a no-op as per specific instructions.\n\n        if use_cache:\n            try:\n                val_str = self._cache.get(n)\n                if val_str is not None:\n                    return int(val_str)\n            except CacheError:\n                # Cache error, proceed to compute without caching.\n                pass\n            except Exception:\n                # Catch unexpected issues during cache access.\n                pass\n\n        try:\n            value = self._compute_iterative(n)\n        except Exception as e:\n            raise FibComputationError(f\"Internal computation error for n={n}: {e}\")\n\n        if use_cache:\n            try:\n                self._cache.set(n, str(value))\n            except CacheError:\n                # Cache error during set, computation is done, just don't cache.\n                pass\n            except Exception:\n                # Catch unexpected issues during cache write.\n                pass\n        \n        return value\n\n    def _compute_iterative(self, n: int) -> int:\n        \"\"\"Computes the n-th Fibonacci number using an iterative approach.\"\"\"\n        if n == 0:\n            return 0\n        a, b = 0, 1\n        for _ in range(1, n):\n            a, b = b, a + b\n        return b\n\ndef fib(n: int) -> int:\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    cache = create_cache(DEFAULT_CACHE)\n    service = FibonacciService(cache)\n    return service.compute(n)"}
{"task_id": "HumanEval/55", "solution": "import time\nimport threading\nimport logging\nfrom typing import Optional, Tuple, Dict, Any, Protocol\n\n# Set up a basic logger for internal components if not already configured.\n# This ensures logging works even when run as a standalone script.\ntry:\n    if not logging.root.handlers:\n        logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\nexcept Exception:\n    # Fallback if basicConfig fails or is not desired in some environments.\n    pass\n_logger = logging.getLogger(\"fiblib\")\n\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    pass\n\nclass ComputationError(RuntimeError):\n    \"\"\"Exception raised for errors during Fibonacci computation.\"\"\"\n    pass\n\nclass CacheError(RuntimeError):\n    \"\"\"Exception raised for issues with the caching mechanism.\"\"\"\n    pass\n\nDEFAULT_MAX_N = 1_000_000\n\ndef validate_n(n: Any, max_n: int) -> None:\n    \"\"\"\n    Validates the input 'n' for Fibonacci computation.\n    Raises InvalidInputError if 'n' is not a positive integer or exceeds max_n.\n    \"\"\"\n    if not isinstance(n, int):\n        raise InvalidInputError(f\"Input must be an integer, but got type {type(n).__name__}.\")\n    if n < 1:\n        raise InvalidInputError(\"Fibonacci number 'n' must be a positive integer (1-indexed).\")\n    if n > max_n:\n        raise InvalidInputError(f\"Input 'n' ({n}) exceeds the maximum allowed value of {max_n}.\")\n\nclass MathEngine:\n    \"\"\"Provides efficient Fibonacci computation algorithms, specifically fast doubling.\"\"\"\n    def fast_doubling(self, n: int) -> Tuple[int, int]:\n        \"\"\"\n        Computes (F_n, F_{n+1}) for a 0-indexed Fibonacci sequence using fast doubling.\n        The sequence starts F_0 = 0, F_1 = 1, F_2 = 1, F_3 = 2, ...\n        \"\"\"\n        if n == 0:\n            return (0, 1) # Returns (F_0, F_1)\n        \n        a, b = self.fast_doubling(n >> 1) # a = F_k, b = F_{k+1} where k = n // 2\n        \n        # F_{2k} = F_k * (2 * F_{k+1} - F_k)\n        c = a * (2 * b - a)\n        # F_{2k+1} = F_k^2 + F_{k+1}^2\n        d = a * a + b * b\n        \n        if n & 1: # if n is odd, n = 2k + 1\n            # F_n = F_{2k+1} = d\n            # F_{n+1} = F_{2k+2} = F_{2k+1} + F_{2k} = d + c\n            return (d, c + d)\n        else: # if n is even, n = 2k\n            # F_n = F_{2k} = c\n            # F_{n+1} = F_{2k+1} = d\n            return (c, d)\n\n    def fib(self, n: int) -> int:\n        \"\"\"\n        Returns the n-th Fibonacci number using 1-indexed semantics (fib(1)=1, fib(2)=1).\n        This method maps to the 0-indexed sequence correctly using fast_doubling.\n        \"\"\"\n        if n == 1:\n            return 1\n        # fast_doubling(n) returns (F_n, F_{n+1}) where F is 0-indexed.\n        # This correctly corresponds to the 1-indexed F(n).\n        f_n, _ = self.fast_doubling(n)\n        return f_n\n\nclass CacheRepository(Protocol):\n    \"\"\"Protocol defining the interface for cache repositories.\"\"\"\n    def get(self, key: str) -> Optional[int]: ...\n    def set(self, key: str, value: int, ttl: Optional[int] = None) -> None: ...\n    def delete(self, key: str) -> None: ...\n\n\nclass InMemoryCacheRepository:\n    \"\"\"An in-memory cache implementation with optional Time-To-Live (TTL) support.\"\"\"\n    def __init__(self, default_ttl: Optional[int] = None):\n        self.store: Dict[str, Tuple[int, Optional[float]]] = {} # Stores (value, expiry_timestamp)\n        self.default_ttl = default_ttl\n        self.lock = threading.RLock() # Protects access to the store\n\n    def get(self, key: str) -> Optional[int]:\n        \"\"\"Retrieves a value from the cache if not expired.\"\"\"\n        with self.lock:\n            entry = self.store.get(key)\n            if not entry:\n                return None\n            value, expiry = entry\n            if expiry is not None and time.time() > expiry:\n                del self.store[key] # Remove expired entry\n                _logger.debug(f\"Cache expired for key: {key}\")\n                return None\n            _logger.debug(f\"Cache hit for key: {key}\")\n            return value\n\n    def set(self, key: str, value: int, ttl: Optional[int] = None) -> None:\n        \"\"\"Stores a value in the cache with an optional TTL.\"\"\"\n        with self.lock:\n            effective_ttl = ttl if ttl is not None else self.default_ttl\n            expiry = time.time() + effective_ttl if effective_ttl is not None else None\n            self.store[key] = (value, expiry)\n            _logger.debug(f\"Cache set for key: {key} with TTL: {effective_ttl}\")\n\n    def delete(self, key: str) -> None:\n        \"\"\"Deletes an entry from the cache.\"\"\"\n        with self.lock:\n            if key in self.store:\n                del self.store[key]\n                _logger.debug(f\"Cache deleted for key: {key}\")\n\nclass FibService:\n    \"\"\"\n    Orchestrates Fibonacci number computation, handling validation, caching, and delegation\n    to a mathematical engine.\n    \"\"\"\n    def __init__(self, cache_repo: CacheRepository, math_engine: MathEngine, max_n: int):\n        self._cache = cache_repo\n        self._math_engine = math_engine\n        self._max_n = max_n\n        self.logger = _logger\n\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Computes the n-th Fibonacci number. It validates input, checks the cache,\n        computes if a cache miss occurs, and stores the result in the cache.\n        \"\"\"\n        validate_n(n, self._max_n)\n        key = f\"fib:{n}\"\n        \n        cached = None\n        try:\n            cached = self._cache.get(key)\n        except Exception as e:\n            self.logger.warning(f\"Cache get failed for key {key}: {e}. Proceeding without cache.\")\n            cached = None # Ensure cached is None on error\n            \n        if cached is not None:\n            self.logger.info(f\"Fib({n}): Cache hit, value = {cached}\")\n            return cached\n        \n        self.logger.info(f\"Fib({n}): Cache miss, computing value.\")\n        value = self._compute_and_cache(n)\n        self.logger.info(f\"Fib({n}): Computed value = {value}\")\n        return value\n\n    def _compute_and_cache(self, n: int) -> int:\n        \"\"\"Internal helper to compute the Fibonacci value and store it in cache.\"\"\"\n        try:\n            value = self._math_engine.fib(n)\n        except Exception as e:\n            self.logger.error(f\"Computation failed for n={n}: {e}\")\n            raise ComputationError(f\"Failed to compute Fibonacci for n={n}\") from e\n\n        try:\n            self._cache.set(key=f\"fib:{n}\", value=value)\n            self.logger.debug(f\"Successfully cached fib:{n}\")\n        except Exception as e:\n            self.logger.warning(f\"Cache set failed for key fib:{n}: {e}. Result will not be cached.\")\n        \n        return value\n\n# Global instance of FibService to be used by the convenience `fib` function.\n# This ensures that the service and its dependencies (cache, math engine) are\n# initialized once and reused across multiple calls to `fib()`.\n_default_fib_service: Optional[FibService] = None\n\ndef fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    global _default_fib_service\n    if _default_fib_service is None:\n        _default_fib_service = FibService(\n            cache_repo=InMemoryCacheRepository(),\n            math_engine=MathEngine(),\n            max_n=DEFAULT_MAX_N,\n        )\n    return _default_fib_service.compute(n)"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    A list is monotonic if it is either non-decreasing or non-increasing.\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    def _sign_of_diff(a, b):\n        \"\"\"Returns -1 if a < b, 0 if a == b, and 1 if a > b.\"\"\"\n        if a < b:\n            return -1\n        if a > b:\n            return 1\n        return 0\n\n    trend_sign = 0  # 0: unknown, -1: decreasing, 1: increasing\n\n    for i in range(len(l) - 1):\n        a, b = l[i], l[i+1]\n        current_diff_sign = _sign_of_diff(a, b)\n\n        if current_diff_sign != 0:\n            if trend_sign == 0:\n                trend_sign = current_diff_sign\n            elif trend_sign * current_diff_sign < 0:\n                return False\n    return True"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n\n    \"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n    common_elements = set1.intersection(set2)\n    return sorted(list(common_elements))"}
{"task_id": "HumanEval/58", "solution": "from typing import Sequence, Any, List, Set\n\nclass ListUtilsError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass InvalidInputError(ListUtilsError):\n    pass\n\nclass CommonResult:\n    def __init__(self, common: List[Any], count: int) -> None:\n        self.common = common\n        self.count = count\n\nclass SetAdapter:\n    def __init__(self) -> None:\n        pass\n\n    def to_set(self, seq: Sequence[Any]) -> Set[Any]:\n        \"\"\"Convert a sequence to a set, raising InvalidInputError for unhashable elements.\"\"\"\n        try:\n            return set(seq)\n        except TypeError as e:\n            raise InvalidInputError(f\"Unhashable or non-iterable elements: {e}\") from e\n\n    def intersect(self, s1: Set[Any], s2: Set[Any]) -> Set[Any]:\n        \"\"\"Compute the intersection of two sets, raising ListUtilsError if inputs are not sets.\"\"\"\n        if not isinstance(s1, set) or not isinstance(s2, set):\n            raise ListUtilsError(\"intersect expects set objects\")\n        return s1 & s2\n\nclass CommonService:\n    def __init__(self, set_adapter: SetAdapter, sort: bool = True) -> None:\n        self._set_adapter = set_adapter\n        self._sort = sort\n\n    def find_common(self, l1: Sequence[Any], l2: Sequence[Any]) -> CommonResult:\n        \"\"\"Find common elements between two sequences, returning a CommonResult.\"\"\"\n        s1 = self._set_adapter.to_set(l1)\n        s2 = self._set_adapter.to_set(l2)\n        common = self._set_adapter.intersect(s1, s2)\n        lst = list(common)\n        if self._sort:\n            try:\n                lst.sort()\n            except Exception as e:\n                raise ListUtilsError(f\"Sorting failed: {e}\") from e\n        return CommonResult(common=lst, count=len(lst))\n\n    def find_common_sorted(self, l1: Sequence[Any], l2: Sequence[Any]) -> List[Any]:\n        \"\"\"Find common elements and return them as a sorted list.\"\"\"\n        return self.find_common(l1, l2).common\n\ndef common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n\n    \"\"\"\n    _default_service = CommonService(set_adapter=SetAdapter(), sort=True)\n    return _default_service.find_common_sorted(l1, l2)"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    last_factor = 1\n\n    # Remove factors of 2\n    while n % 2 == 0:\n        n //= 2\n        last_factor = 2\n\n    # Try odd factors starting from 3\n    factor = 3\n    while factor * factor <= n:\n        while n % factor == 0:\n            n //= factor\n            last_factor = factor\n        factor += 2\n\n    # If n is still greater than 1, it must be the largest prime factor\n    if n > 1:\n        last_factor = n\n\n    return last_factor"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_factor = 1\n\n    # Divide by 2 until n is odd\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Iterate through odd numbers starting from 3 up to sqrt(n)\n    f = 3\n    while f * f <= n:\n        while n % f == 0:\n            largest_factor = f\n            n //= f\n        f += 2\n\n    # If n is still greater than 1, it must be the largest prime factor\n    if n > 1:\n        largest_factor = n\n\n    return largest_factor"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\"\"\"\n    n = len(l)\n    if n <= 1:\n        return True\n\n    seen_increase = False\n    seen_decrease = False\n\n    for i in range(1, n):\n        prev_val = l[i - 1]\n        curr_val = l[i]\n\n        if prev_val < curr_val:\n            seen_increase = True\n        elif prev_val > curr_val:\n            seen_decrease = True\n\n        # If both an increasing and a decreasing trend are observed, it's not monotonic.\n        if seen_increase and seen_decrease:\n            return False\n\n    # If the loop completes, the list is monotonic (either non-decreasing, non-increasing, or flat).\n    return True"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int):\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    # Computes the sum of integers from 1 to n using the arithmetic series formula.\n    # Assumes n is a non-negative integer as per design context.\n    return n * (n + 1) // 2"}
