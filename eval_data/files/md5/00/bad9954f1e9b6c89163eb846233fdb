{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0  \n   \n    If the input list is empty, return 0.\n    '''\n    total_sum_of_squares = 0\n    for x in lst:\n        num = None\n        if isinstance(x, int):\n            num = x\n        elif isinstance(x, float) and x.is_integer():\n            num = int(x)\n        \n        if num is not None and num >= 0 and num % 2 == 1:\n            total_sum_of_squares += num * num\n            \n    return total_sum_of_squares"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n    \n    \"\"\"\n    import math\n    import datetime\n    import json\n    from collections import deque\n    import logging\n    from dataclasses import dataclass\n    from typing import Any, List\n\n    # Configure basic logging only once for the application.\n    if not hasattr(x_or_y, \"_logger_configured\"):\n        logging.basicConfig(level=logging.WARNING, format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n        x_or_y._logger_configured = True\n\n    # --- Exceptions ---\n    class InvalidInputError(ValueError):\n        def __init__(self, message: str):\n            super().__init__(message)\n            self.message = message\n\n    # --- Models ---\n    @dataclass\n    class SelectionInput:\n        n: int\n        x: Any\n        y: Any\n\n        def to_dict(self) -> dict:\n            return {\"n\": self.n, \"x\": self.x, \"y\": self.y}\n\n    @dataclass\n    class SelectionResult:\n        input: SelectionInput\n        result: Any\n        timestamp: str\n\n        def to_dict(self) -> dict:\n            # Returns raw values; repository or other consumers will handle JSON serialization.\n            return {\n                \"n\": self.input.n,\n                \"x\": self.input.x,\n                \"y\": self.input.y,\n                \"result\": self.result,\n                \"timestamp\": self.timestamp\n            }\n\n    # --- Utils ---\n    class PrimeUtils:\n        @staticmethod\n        def is_prime(n: int) -> bool:\n            # Assumes n is a non-negative integer, as validated by SelectionService.\n            if n < 2:\n                return False\n            if n % 2 == 0:\n                return n == 2\n            if n % 3 == 0:\n                return n == 3\n            i = 5\n            w = 2\n            limit = int(math.isqrt(n))\n            while i <= limit:\n                if n % i == 0:\n                    return False\n                i += w\n                w = 6 - w\n            return True\n\n    # --- Repository ---\n    DEFAULT_HISTORY_LIMIT = 1000\n\n    class HistoryRepository:\n        def append(self, record: SelectionResult) -> None:\n            raise NotImplementedError\n        def list(self, limit: int = 100) -> List[SelectionResult]:\n            raise NotImplementedError\n\n    class InMemoryHistoryRepository(HistoryRepository):\n        def __init__(self, limit: int = DEFAULT_HISTORY_LIMIT):\n            self._limit = limit\n            self._buffer = deque(maxlen=limit)\n\n        def append(self, record: SelectionResult) -> None:\n            self._buffer.append(record)\n\n        def list(self, limit: int = 100) -> List[SelectionResult]:\n            # Returns the 'limit' most recent items from the buffer.\n            return list(self._buffer)[-limit:]\n\n    # --- Services ---\n    class SelectionService:\n        def __init__(self, repo: HistoryRepository = None):\n            self._repo = repo or InMemoryHistoryRepository()\n            self._logger = logging.getLogger(__name__)\n\n        def _validate_input(self, n: int, x: Any, y: Any) -> None:\n            # Validates n as a non-negative integer, raising InvalidInputError if invalid.\n            if not isinstance(n, int):\n                raise InvalidInputError(\"n must be integer\")\n            if n < 0:\n                raise InvalidInputError(\"n must be non-negative\")\n\n        def select_value(self, n: int, x: Any, y: Any) -> Any:\n            self._validate_input(n, x, y)\n            is_prime = PrimeUtils.is_prime(n)\n            selected = x if is_prime else y\n\n            inp = SelectionInput(n=n, x=x, y=y)\n            res = SelectionResult(\n                input=inp,\n                result=selected,\n                timestamp=datetime.datetime.utcnow().isoformat(timespec='milliseconds') + 'Z'\n            )\n\n            try:\n                self._repo.append(res)\n            except Exception as e:\n                # Logs repository errors without interrupting the selection process.\n                self._logger.warning(\"Failed to persist history: %s\", e)\n            return selected\n\n    # --- Controllers ---\n    class APIController:\n        def __init__(self, service: SelectionService):\n            self._service = service\n\n        def x_or_y(self, n: int, x: Any, y: Any) -> Any:\n            return self._service.select_value(n, x, y)\n\n    # Initialize the singleton APIController and SelectionService on the first call\n    # and reuse them for subsequent calls via a function attribute.\n    if not hasattr(x_or_y, \"_api_instance\"):\n        _service = SelectionService(repo=InMemoryHistoryRepository())\n        x_or_y._api_instance = APIController(service=_service)\n\n    _api = x_or_y._api_instance\n    return _api.x_or_y(n, x, y)"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on CAP - SM strength calculation and returns the formatted class and extension name.\"\"\"\n\n    class StrongestExtensionError(Exception):\n        def __init__(self, message: str = \"\"):\n            super().__init__(message)\n            self.message = message\n\n    class InvalidInputError(StrongestExtensionError):\n        pass\n\n    class NoExtensionsError(StrongestExtensionError):\n        pass\n\n    class Extension:\n        def __init__(self, name: str) -> None:\n            self.name: str = name\n\n    class ClassName:\n        def __init__(self, name: str) -> None:\n            self.name: str = name\n\n    class StringUtils:\n        @staticmethod\n        def count_upper(s: str) -> int:\n            return sum(1 for ch in s if ch.isalpha() and ch.isupper())\n\n        @staticmethod\n        def count_lower(s: str) -> int:\n            return sum(1 for ch in s if ch.isalpha() and ch.islower())\n\n        @staticmethod\n        def is_string_list(obj) -> bool:\n            if not isinstance(obj, list):\n                return False\n            return all(isinstance(x, str) for x in obj)\n\n    class ExtensionRepository:\n        def __init__(self, utils: StringUtils = None) -> None:\n            self._utils = utils if utils is not None else StringUtils()\n\n        def validate_and_normalize(self, extensions) -> list[Extension]:\n            if not self._utils.is_string_list(extensions):\n                raise InvalidInputError(\"extensions must be a list of strings\")\n            return [Extension(e) for e in extensions]\n\n        def ensure_non_empty(self, extensions: list[Extension]) -> None:\n            if not extensions:\n                raise NoExtensionsError(\"no extensions provided\")\n\n    class StrengthCalculator:\n        def __init__(self, utils: StringUtils = None) -> None:\n            self._utils = utils if utils is not None else StringUtils()\n\n        def compute_strength(self, extension: Extension) -> int:\n            return self._utils.count_upper(extension.name) - self._utils.count_lower(extension.name)\n\n        def find_strongest(self, class_name: ClassName, extensions: list[Extension]) -> str:\n            if not extensions: # This case should be handled by repository, but as a safeguard.\n                raise NoExtensionsError(\"No extensions to compare.\")\n\n            best_idx = 0\n            best_strength = self.compute_strength(extensions[0])\n\n            for idx, ext in enumerate(extensions[1:], start=1):\n                s = self.compute_strength(ext)\n                if s > best_strength:\n                    best_strength = s\n                    best_idx = idx\n            return f\"{class_name.name}.{extensions[best_idx].name}\"\n\n    class StrongestExtensionController:\n        def __init__(self, repo: ExtensionRepository, calc: StrengthCalculator) -> None:\n            self._repo = repo\n            self._calc = calc\n\n        def find_strongest(self, class_name_str: str, extensions_list: list[str]) -> str:\n            if not isinstance(class_name_str, str):\n                raise InvalidInputError(\"class_name must be a string\")\n\n            exts = self._repo.validate_and_normalize(extensions_list)\n            self._repo.ensure_non_empty(exts)\n            cn = ClassName(class_name_str)\n            return self._calc.find_strongest(cn, exts)\n\n    # Instantiate dependencies\n    string_utils = StringUtils()\n    extension_repository = ExtensionRepository(string_utils)\n    strength_calculator = StrengthCalculator(string_utils)\n    controller = StrongestExtensionController(extension_repository, strength_calculator)\n\n    # Delegate to the controller\n    return controller.find_strongest(class_name, extensions)"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on CAP - SM, returning 'ClassName.StrongestExtensionName'.\n    Ties are broken by choosing the first extension in the list.\n    \"\"\"\n    if not extensions:\n        return f\"{class_name}.\"\n\n    max_strength = -float('inf')\n    strongest_extension_name = \"\"\n\n    for extension_name in extensions:\n        cap_count = 0\n        sm_count = 0\n        for char in extension_name:\n            if char.isalpha():\n                if char.isupper():\n                    cap_count += 1\n                elif char.islower():\n                    sm_count += 1\n        \n        current_strength = cap_count - sm_count\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension_name\n            \n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    n = len(b)\n    if n == 0:\n        return False\n    \n    # Create a doubled string of b (b+b) to find all rotations as substrings within it.\n    # Any cyclic rotation of b will appear as a substring of length n in b_doubled.\n    b_doubled = b + b\n\n    # Check each possible rotation of b against string a.\n    # We iterate through substrings of b_doubled of length n.\n    for i in range(n):\n        rotation = b_doubled[i : i + n]\n        if rotation in a:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"\n    Returns True if the second word or any of its rotations is a substring in the first word.\n    \"\"\"\n    # If the second word 'b' is longer than the first word 'a',\n    # it cannot be a substring of 'a' (nor can any of its rotations).\n    if len(b) > len(a):\n        return False\n\n    # If 'b' is empty, no rotation exists, and an empty string\n    # is not considered a substring for this problem's context based on examples.\n    if len(b) == 0:\n        return False\n\n    # Iterate through all possible cyclic rotations of 'b'\n    for i in range(len(b)):\n        # Create a rotation by splitting 'b' and concatenating the parts\n        rotation = b[i:] + b[:i]\n        \n        # Check if the current rotation is a substring of 'a'\n        if rotation in a:\n            return True\n            \n    # If no rotation of 'b' was found as a substring in 'a', return False\n    return False"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n\n    def is_even(digit: int) -> bool:\n        \"\"\"Checks if a digit is even.\"\"\"\n        return digit % 2 == 0\n\n    def digit_iter(n: int):\n        \"\"\"Yields digits of an integer from left to right.\"\"\"\n        s = str(n)\n        for char_digit in s:\n            yield int(char_digit)\n\n    class DigitCountResult:\n        def __init__(self, even: int, odd: int):\n            self.even = even\n            self.odd = odd\n\n        def to_tuple(self) -> tuple[int, int]:\n            return (self.even, self.odd)\n\n    n_abs = abs(num)\n    even_count = 0\n    odd_count = 0\n\n    for d in digit_iter(n_abs):\n        if is_even(d):\n            even_count += 1\n        else:\n            odd_count += 1\n\n    result = DigitCountResult(even=even_count, odd=odd_count)\n    return result.to_tuple()"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    number = abs(num)\n    if number == 0:\n        return (1, 0)\n\n    even_count = 0\n    odd_count = 0\n\n    while number > 0:\n        digit = number % 10\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n        number //= 10\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    ROMAN_PAIRS = [\n        (1000, \"M\"), (900, \"CM\"), (500, \"D\"), (400, \"CD\"),\n        (100, \"C\"), (90, \"XC\"), (50, \"L\"), (40, \"XL\"),\n        (10, \"X\"), (9, \"IX\"), (5, \"V\"), (4, \"IV\"), (1, \"I\")\n    ]\n\n    result = []\n    remaining = number\n    for val, sym in ROMAN_PAIRS:\n        count = remaining // val\n        if count:\n            result.append(sym * count)\n            remaining -= val * count\n        if remaining == 0:\n            break\n    return \"\".join(result).lower()"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    ROMAN_SYMBOLS = [\n        (1000, \"M\"), (900, \"CM\"), (500, \"D\"), (400, \"CD\"), (100, \"C\"),\n        (90, \"XC\"), (50, \"L\"), (40, \"XL\"), (10, \"X\"), (9, \"IX\"),\n        (5, \"V\"), (4, \"IV\"), (1, \"I\")\n    ]\n\n    result = []\n    remainder = number\n    for value, symbol in ROMAN_SYMBOLS:\n        while remainder >= value:\n            result.append(symbol)\n            remainder -= value\n        if remainder == 0:\n            break\n    return \"\".join(result).lower()"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    best_word = None\n    best_count = -1\n\n    for w in words:\n        current_count = len(set(w))\n        if current_count > best_count:\n            best_count = current_count\n            best_word = w\n        elif current_count == best_count:\n            # Tie-break by lexicographical order (Python's default string comparison)\n            if best_word is None or w < best_word:\n                best_word = w\n\n    return best_word"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Returns the word with the maximum number of unique characters.\n    If multiple strings have the maximum, returns the lexicographically first one.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    best_word = \"\"\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            best_word = word\n        elif current_unique_count == max_unique_count:\n            if word < best_word:  # Lexicographical tie-breaker\n                best_word = word\n    \n    return best_word"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    import math\n\n    # Helper function for floating point comparison with a default tolerance.\n    def _is_close(val1: float, val2: float, tol: float = 1e-9) -> bool:\n        return math.fabs(val1 - val2) <= tol\n\n    # Attempt to convert all inputs to floats.\n    # If conversion fails (e.g., non-numeric strings), return False directly\n    # without raising custom exceptions, as per constraints.\n    try:\n        s_raw = [float(a), float(b), float(c)]\n    except (TypeError, ValueError):\n        return False\n\n    # All sides must be positive.\n    if any(s <= 0 for s in s_raw):\n        return False\n\n    # Sort the sides in ascending order to easily identify the potential hypotenuse.\n    s1, s2, s3 = sorted(s_raw)\n\n    # Check the triangle inequality: the sum of any two sides must be greater than the third.\n    # This also handles degenerate triangles (where s1 + s2 == s3) by returning False,\n    # which is consistent with the example `right_angle_triangle(1, 2, 3) == False`.\n    if s1 + s2 <= s3:\n        return False\n\n    # Apply the Pythagorean theorem (a^2 + b^2 = c^2) using floating point comparison.\n    return _is_close(s1**2 + s2**2, s3**2)"}
{"task_id": "HumanEval/157", "solution": "import math\n\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    '''\n    # Define a default tolerance for floating-point comparisons, as suggested in the design context.\n    DEFAULT_TOLERANCE = 1e-9\n\n    # Sort the sides to easily identify the potential legs and hypotenuse.\n    # The largest side will be the candidate for the hypotenuse.\n    sides = sorted([a, b, c])\n    a_leg = sides[0]\n    b_leg = sides[1]\n    c_hyp = sides[2]\n\n    # Validate that sides are positive and satisfy the triangle inequality.\n    # If these conditions are not met, it cannot be a right-angled triangle (or any triangle).\n    if not (a_leg > 0 and b_leg > 0 and c_hyp > 0):\n        return False\n    if not (a_leg + b_leg > c_hyp): # The other two inequalities are implicitly covered by sorting and positive check\n        return False\n\n    # Apply the Pythagorean theorem: a^2 + b^2 = c^2.\n    # Use math.isclose for robust floating-point comparison, comparing the squares.\n    return math.isclose(a_leg**2 + b_leg**2, c_hyp**2, rel_tol=DEFAULT_TOLERANCE, abs_tol=DEFAULT_TOLERANCE)"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten and remaining after a rabbit's meal.\n    The rabbit eats the minimum of its need or the available remaining carrots.\n    \"\"\"\n    carrots_eaten_now = min(need, remaining)\n    total_eaten = number + carrots_eaten_now\n    remaining_after_meal = remaining - carrots_eaten_now\n    return [total_eaten, remaining_after_meal]"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten and remaining stock after a rabbit's meal.\n    The rabbit eats as many carrots as needed, up to the available remaining stock.\n    \"\"\"\n    carrots_eaten_now = min(need, remaining)\n    total_eaten = number + carrots_eaten_now\n    carrots_left = remaining - carrots_eaten_now\n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n    \n    # Check if the string contains any alphabetic characters\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n            \n    if not has_letters:\n        # If no letters are found, reverse the entire string\n        return s[::-1]\n    else:\n        # If letters are found, reverse the case of letters and keep others as is\n        transformed_chars = []\n        for char in s:\n            if char.isalpha():\n                if char.islower():\n                    transformed_chars.append(char.upper())\n                else:  # char is uppercase\n                    transformed_chars.append(char.lower())\n            else:\n                transformed_chars.append(char)\n        return \"\".join(transformed_chars)"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n    \"\"\"\n\n    # --- AST Node Definitions (internal) ---\n    class _ASTNode:\n        pass\n\n    class _NumberNode(_ASTNode):\n        def __init__(self, value):\n            self.value = value\n\n    class _BinaryOpNode(_ASTNode):\n        def __init__(self, op_token, left, right):\n            self.op_token = op_token\n            self.left = left\n            self.right = right\n\n    # --- Operator Metadata (internal) ---\n    PRECEDENCE = {\n        '**': 3,\n        '*': 2,\n        '//': 2,\n        '+': 1,\n        '-': 1,\n    }\n\n    ASSOCIATIVITY = {\n        '**': 'right',\n        '*': 'left',\n        '//': 'left',\n        '+': 'left',\n        '-': 'left',\n    }\n\n    # --- Utility Functions (internal) ---\n    def _safe_pow(base: int, exponent: int) -> int:\n        return pow(base, exponent)\n\n    def _apply_op(op_token, lhs, rhs):\n        if op_token == '+':\n            return lhs + rhs\n        if op_token == '-':\n            return lhs - rhs\n        if op_token == '*':\n            return lhs * rhs\n        if op_token == '//':\n            return lhs // rhs\n        if op_token == '**':\n            return _safe_pow(lhs, rhs)\n        return 0 # Should not be reached with valid operators\n\n    # --- AST Evaluator (internal) ---\n    def _evaluate_ast(node):\n        if isinstance(node, _NumberNode):\n            return node.value\n        elif isinstance(node, _BinaryOpNode):\n            left_val = _evaluate_ast(node.left)\n            right_val = _evaluate_ast(node.right)\n            return _apply_op(node.op_token, left_val, right_val)\n        return 0 # Should not be reached with valid AST\n\n    # --- AST Builder (internal, Shunting-yard like) ---\n    def _build_ast(operator_list, operand_list):\n        node_stack = []\n        op_stack = []\n\n        # Push the first operand as a NumberNode\n        node_stack.append(_NumberNode(operand_list[0]))\n\n        # Iterate through the remaining operands and operators\n        for i in range(len(operator_list)):\n            current_op_token = operator_list[i]\n            current_operand_value = operand_list[i + 1]\n\n            # Push the current operand as a NumberNode\n            node_stack.append(_NumberNode(current_operand_value))\n\n            # Process operator stack based on precedence and associativity\n            while op_stack:\n                op_on_stack = op_stack[-1]\n                op_on_stack_precedence = PRECEDENCE[op_on_stack]\n                current_op_precedence = PRECEDENCE[current_op_token]\n\n                if op_on_stack_precedence > current_op_precedence or \\\n                   (op_on_stack_precedence == current_op_precedence and ASSOCIATIVITY[op_on_stack] == 'left'):\n                    \n                    op = op_stack.pop()\n                    right = node_stack.pop()\n                    left = node_stack.pop()\n                    node_stack.append(_BinaryOpNode(op, left, right))\n                else:\n                    break\n            \n            op_stack.append(current_op_token)\n\n        # After processing all tokens, flush the remaining operators\n        while op_stack:\n            op = op_stack.pop()\n            right = node_stack.pop()\n            left = node_stack.pop()\n            node_stack.append(_BinaryOpNode(op, left, right))\n\n        return node_stack[0] # The root of the AST\n\n    # --- Main logic of do_algebra ---\n    root_node = _build_ast(operator, operand)\n    result = _evaluate_ast(root_node)\n    return result"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n\n    The basic algebra operations:\n    Addition ( + ) \n    Subtraction ( - ) \n    Multiplication ( * ) \n    Floor division ( // ) \n    Exponentiation ( ** ) \n\n    Example:\n    operator['+', '*', '-']\n    array = [2, 3, 4, 5]\n    result = 2 + 3 * 4 - 5\n    => result = 9\n\n    Note:\n        The length of operator list is equal to the length of operand list minus one.\n        Operand is a list of of non-negative integers.\n        Operator list has at least one operator, and operand list has at least two operands.\n\n    \"\"\"\n    \n    # Define operator precedence and associativity for the Shunting-Yard algorithm.\n    PRECEDENCE = {'**': 4, '*': 3, '//': 3, '+': 2, '-': 2}\n    ASSOCIATIVITY = {'**': 'right', '*': 'left', '//': 'left', '+': 'left', '-': 'left'}\n\n    # Helper function to apply a given operator to two operands.\n    def _apply_operator(op, a, b):\n        if op == '+':\n            return a + b\n        elif op == '-':\n            return a - b\n        elif op == '*':\n            return a * b\n        elif op == '//':\n            return a // b\n        elif op == '**':\n            return a ** b\n\n    # Helper function to convert an infix expression (list of tokens) to Reverse Polish Notation (RPN).\n    def _to_rpn(expression_tokens):\n        output = []\n        op_stack = []\n\n        for token in expression_tokens:\n            if isinstance(token, int):  # Token is an operand\n                output.append(token)\n            else:  # Token is an operator\n                o1 = token\n                while (op_stack and op_stack[-1] in PRECEDENCE and\n                       ((ASSOCIATIVITY[o1] == 'left' and PRECEDENCE[o1] <= PRECEDENCE[op_stack[-1]]) or\n                        (ASSOCIATIVITY[o1] == 'right' and PRECEDENCE[o1] < PRECEDENCE[op_stack[-1]]))):\n                    output.append(op_stack.pop())\n                op_stack.append(o1)\n\n        while op_stack:\n            output.append(op_stack.pop())\n        return output\n\n    # Helper function to evaluate an expression in Reverse Polish Notation (RPN).\n    def _evaluate_rpn(rpn_tokens):\n        eval_stack = []\n        for token in rpn_tokens:\n            if isinstance(token, int):\n                eval_stack.append(token)\n            else:  # Token is an operator\n                b = eval_stack.pop()\n                a = eval_stack.pop()\n                result = _apply_operator(token, a, b)\n                eval_stack.append(result)\n        return eval_stack[0]\n\n    # Build the infix expression token list by interleaving operands and operators.\n    expression_tokens = []\n    for i in range(len(operator)):\n        expression_tokens.append(operand[i])\n        expression_tokens.append(operator[i])\n    expression_tokens.append(operand[len(operator)])  # Add the last operand\n\n    # Convert the infix expression to RPN.\n    rpn_expression = _to_rpn(expression_tokens)\n\n    # Evaluate the RPN expression to get the final result.\n    final_result = _evaluate_rpn(rpn_expression)\n\n    return final_result"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n    \n    # Determine if the string contains any alphabetical characters.\n    contains_letter = any(ch.isalpha() for ch in s)\n\n    if contains_letter:\n        # If letters are present, invert the case of letters and keep non-letters unchanged.\n        return ''.join(ch.swapcase() if ch.isalpha() else ch for ch in s)\n    else:\n        # If no letters are present, reverse the entire string.\n        return s[::-1]"}
{"task_id": "HumanEval/162", "solution": "import hashlib\n\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if text == \"\":\n        return None\n    data = text.encode(\"utf-8\")\n    return hashlib.md5(data).hexdigest()"}
{"task_id": "HumanEval/162", "solution": "import hashlib\n\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n    \n    # \"Even digits\" are defined as single decimal digits: 0, 2, 4, 6, 8.\n    even_digits = [0, 2, 4, 6, 8]\n    \n    result = []\n    for digit in even_digits:\n        if min_val <= digit <= max_val:\n            result.append(digit)\n            \n    return result"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    lower = min(a, b)\n    upper = max(a, b)\n    \n    even_digits_candidates = [0, 2, 4, 6, 8]\n    \n    result = [digit for digit in even_digits_candidates if lower <= digit <= upper]\n    \n    return result"}
