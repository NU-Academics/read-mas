{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is efficiently computed iteratively without recursion.\n    It stores and updates the last four values to calculate the next element.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n\n    # Initialize with the base values: fib4(0), fib4(1), fib4(2), fib4(3)\n    a, b, c, d = 0, 0, 2, 0 # a=fib4(i-4), b=fib4(i-3), c=fib4(i-2), d=fib4(i-1)\n\n    for _ in range(4, n + 1):\n        # Calculate fib4(i)\n        next_fib = a + b + c + d\n        # Shift values for the next iteration\n        a = b\n        b = c\n        c = d\n        d = next_fib\n    \n    return d"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    base_values = {0: 0, 1: 0, 2: 2, 3: 0}\n\n    if n in base_values:\n        return base_values[n]\n\n    # Initialize rolling variables representing fib4(k-4), fib4(k-3), fib4(k-2), fib4(k-1)\n    # starting effectively at k=3 (where d is fib4(3)).\n    a, b, c, d = base_values[0], base_values[1], base_values[2], base_values[3]\n\n    for k in range(4, n + 1):\n        # Calculate the next Fibonacci-like number\n        next_fib4 = d + c + b + a\n        # Shift the values: F(k-4) becomes F(k-3), etc., and F(k) is the new F(k-1)\n        a, b, c, d = b, c, d, next_fib4\n    \n    return d"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n    mid = n // 2\n    if n % 2 == 1:\n        return sorted_l[mid]\n    else:\n        return (sorted_l[mid - 1] + sorted_l[mid]) / 2.0"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    8.0\n    \"\"\"\n    s = sorted(l)\n    n = len(s)\n    mid = n // 2\n\n    if n % 2 == 1:\n        # For odd length lists, the median is the middle element.\n        v = s[mid]\n        return int(v) if float(v).is_integer() else v\n    else:\n        # For even length lists, the median is the average of the two middle elements.\n        a, b = s[mid - 1], s[mid]\n        avg = (a + b) / 2.0\n        return int(avg) if float(avg).is_integer() else avg"}
{"task_id": "HumanEval/48", "solution": "import re\n\ndef is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome.\n    Uses default normalization rules: case-insensitive, ignores whitespace and punctuation.\n    \"\"\"\n    # Normalize the text based on the default configuration:\n    # 1. Convert to lowercase (case-insensitive check)\n    # 2. Remove all whitespace characters\n    # 3. Remove all non-alphanumeric characters (punctuation)\n    \n    normalized_text = text.casefold()\n    normalized_text = re.sub(r\"\\s+\", \"\", normalized_text)\n    normalized_text = re.sub(r\"[^\\w]\", \"\", normalized_text, flags=re.UNICODE)\n    \n    # A string is a palindrome if it reads the same forwards and backwards.\n    return normalized_text == normalized_text[::-1]"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    >>> modp(3, 5)\n    3\n    >>> modp(1101, 101)\n    2\n    >>> modp(0, 101)\n    1\n    >>> modp(3, 11)\n    8\n    >>> modp(100, 101)\n    1\n    \"\"\"\n    # Implements modular exponentiation (binary exponentiation) to efficiently compute (base^exponent) % modulus.\n    # This prevents intermediate numbers from becoming too large.\n    base = 2\n    exponent = n\n    modulus = p\n\n    result = 1 % modulus\n    base %= modulus\n\n    while exponent > 0:\n        if exponent & 1:  # If exponent is odd\n            result = (result * base) % modulus\n        base = (base * base) % modulus\n        exponent >>= 1  # Halve the exponent\n\n    return result"}
{"task_id": "HumanEval/48", "solution": "import unicodedata\nimport re\n\ndef is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome after normalization.\n    Normalization involves case folding, removing non-alphanumeric characters, and applying Unicode NFKC.\n    \"\"\"\n    # Apply Unicode NFKC normalization\n    s = unicodedata.normalize(\"NFKC\", text)\n\n    # Remove non-alphanumeric characters\n    s = re.sub(r'[\\W_]+', '', s, flags=re.UNICODE)\n\n    # Apply case folding for case-insensitive comparison\n    s = s.casefold()\n\n    # Check if the processed string is equal to its reverse\n    return s == s[::-1]"}
