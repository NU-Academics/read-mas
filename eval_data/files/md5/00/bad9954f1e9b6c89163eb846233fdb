{"task_id": "HumanEval/51", "solution": "def remove_vowels(text):\n    \"\"\"\n    remove_vowels is a function that takes string and returns string without vowels.\n    >>> remove_vowels('')\n    ''\n    >>> remove_vowels(\"abcdef\\nghijklm\")\n    'bcdf\\nghjklm'\n    >>> remove_vowels('abcdef')\n    'bcdf'\n    >>> remove_vowels('aaaaa')\n    ''\n    >>> remove_vowels('aaBAA')\n    'B'\n    >>> remove_vowels('zbcd')\n    'zbcd'\n    \"\"\"\n    vowels = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n    # Filter out characters that are present in the vowels set.\n    result_chars = [char for char in text if char not in vowels]\n    # Join the remaining characters to form the new string.\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/52", "solution": "import math\nfrom typing import Sequence, List, Any, Optional\n\nclass InvalidElementError(ValueError):\n    \"\"\"Exception raised for invalid elements in the input list.\"\"\"\n    def __init__(self, index: int, value: Any, message: Optional[str] = None) -> None:\n        super().__init__(message or f\"Element at index {index} ('{value}') is not a valid numeric type or is NaN/infinity.\")\n        self.index = index\n        self.value = value\n\nclass InvalidThresholdError(TypeError):\n    \"\"\"Exception raised for an invalid threshold value.\"\"\"\n    def __init__(self, value: Any, message: Optional[str] = None) -> None:\n        super().__init__(message or f\"Threshold ('{value}') must be a finite numeric value.\")\n        self.value = value\n\nclass ListValidator:\n    \"\"\"Validates and normalizes numeric inputs and thresholds.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def validate_threshold(self, threshold: Any) -> float:\n        \"\"\"Ensures the threshold is a finite numeric value and returns it as a float.\"\"\"\n        try:\n            t = float(threshold)\n        except (TypeError, ValueError):\n            raise InvalidThresholdError(threshold, \"Threshold must be numeric\")\n        if math.isnan(t) or math.isinf(t):\n            raise InvalidThresholdError(threshold, \"Threshold must be finite\")\n        return t\n\n    def validate_numbers(self, numbers: Sequence[Any]) -> List[float]:\n        \"\"\"Validates a sequence of numbers, ensuring each is a finite numeric type, and returns them as a list of floats.\"\"\"\n        if not isinstance(numbers, Sequence) or isinstance(numbers, (str, bytes)):\n            raise TypeError(\"numbers must be a sequence\")\n        out: List[float] = []\n        for i, v in enumerate(numbers):\n            try:\n                fv = float(v)\n            except (TypeError, ValueError):\n                raise InvalidElementError(i, v, \"Element is not numeric\")\n            if math.isnan(fv) or math.isinf(fv):\n                raise InvalidElementError(i, v, \"Element must be finite numeric\")\n            out.append(fv)\n        return out\n\nclass BelowThresholdService:\n    \"\"\"Provides the core logic for checking if all numbers are below a threshold.\"\"\"\n    def __init__(self, validator: ListValidator) -> None:\n        self._validator = validator\n\n    def is_below_threshold(self, numbers: Sequence[Any], threshold: Any) -> bool:\n        \"\"\"Validates inputs and returns True if all numbers are strictly less than the threshold.\"\"\"\n        t = self._validator.validate_threshold(threshold)\n        nums = self._validator.validate_numbers(numbers)\n        for n in nums:\n            if not (n < t):\n                return False\n        return True\n\ndef below_threshold(l: list, t: int):\n    \"\"\"Return True if all numbers in the list l are below threshold t.\n    >>> below_threshold([1, 2, 4, 10], 100)\n    True\n    >>> below_threshold([1, 20, 4, 10], 5)\n    False\n    \"\"\"\n    validator = ListValidator()\n    service = BelowThresholdService(validator)\n    return service.is_below_threshold(l, t)"}
