{"task_id": "HumanEval/3", "solution": "def below_zero(operations: List[int]) -> bool:\n    \"\"\"Detects if a bank account balance, starting at zero, ever falls below zero.\n\n    The function iterates through a list of deposit/withdrawal operations, returning True\n    at the first point the balance becomes negative, otherwise False.\n    \"\"\"\n    balance = 0\n    for op_value in operations:\n        balance += op_value\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "def separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separates a string containing multiple groups of nested parentheses into a list of balanced group strings.\n    Spaces in the input string are ignored.\"\"\"\n    \n    # Simulate NormalizeUtils.normalize_input with ignore_spaces=True\n    normalized = paren_string.strip().replace(\" \", \"\")\n\n    groups = []\n    depth = 0\n    start = None\n\n    for i, ch in enumerate(normalized):\n        if ch == '(':\n            if depth == 0:\n                start = i  # Mark the beginning of a new top-level group\n            depth += 1\n        elif ch == ')':\n            depth -= 1\n            # If depth returns to 0, a top-level group has closed\n            if depth == 0:\n                if start is not None:\n                    groups.append(normalized[start:i+1])\n                    start = None # Reset for the next top-level group\n        # Per instructions, do not raise exceptions for invalid characters or unbalanced parentheses.\n        # Assume valid input structure for the core separation logic.\n\n    return groups"}
{"task_id": "HumanEval/4", "solution": "def mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    total_sum = sum(numbers)\n    count = len(numbers)\n    mean_val = total_sum / count\n    \n    deviations_sum = sum(abs(x - mean_val) for x in numbers)\n    return deviations_sum / count"}
{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    n = len(numbers)\n    if n == 0:\n        return []\n\n    # Calculate the length of the result list: 2*n - 1\n    # Example: [1,2,3] -> [1,D,2,D,3] (len 3 -> len 5)\n    # Example: [1] -> [1] (len 1 -> len 1)\n    result = [0] * (2 * n - 1)\n\n    # Place the original numbers at even indices (0, 2, 4, ...)\n    result[0::2] = numbers\n\n    # Place the delimiter at odd indices (1, 3, 5, ...)\n    # This correctly handles n=1, where (n-1) is 0, creating an empty list for the slice.\n    result[1::2] = [delimeter] * (n - 1)\n\n    return result"}
{"task_id": "HumanEval/6", "solution": "def parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n    \"\"\"\n    result_depths: List[int] = []\n    # Split the input string into groups by any whitespace, filtering out empty tokens.\n    groups = paren_string.split()\n\n    for group_str in groups:\n        current_depth = 0\n        max_group_depth = 0\n        for char in group_str:\n            if char == '(':\n                current_depth += 1\n                # Update max_group_depth immediately after increasing depth.\n                if current_depth > max_group_depth:\n                    max_group_depth = current_depth\n            elif char == ')':\n                current_depth -= 1\n        result_depths.append(max_group_depth)\n\n    return result_depths"}
{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    # Sort the numbers to easily check adjacent elements for closeness.\n    # The design context explicitly mentions a sorting-based O(n log n) algorithm.\n    sorted_numbers = sorted(numbers)\n\n    # Check the absolute difference between adjacent elements after sorting.\n    for i in range(1, len(sorted_numbers)):\n        if (sorted_numbers[i] - sorted_numbers[i-1]) < threshold:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    if not substring:\n        return list(strings)\n\n    result = []\n    for s in strings:\n        if substring in s:\n            result.append(s)\n    return result"}
{"task_id": "HumanEval/2", "solution": "import math\n\ndef safe_floor(number: float) -> int:\n    \"\"\"Uses math.floor to get the integer part of a float.\"\"\"\n    return int(math.floor(number + 0.0))\n\ndef normalize_decimal(decimal: float, epsilon: float = 1e-12) -> float:\n    \"\"\"Corrects floating point inaccuracies, making very small decimals exactly 0.0.\"\"\"\n    if abs(decimal) < epsilon:\n        return 0.0\n    return decimal\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    integer_part = safe_floor(number)\n    decimal_raw = number - integer_part\n    return normalize_decimal(decimal_raw)"}
{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result: List[int] = []\n    current_max: int | None = None\n\n    for number in numbers:\n        if current_max is None or number > current_max:\n            current_max = number\n        result.append(current_max)\n\n    return result"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    n = len(string)\n    for i in range(n):\n        suffix = string[i:]\n        if suffix == suffix[::-1]: # Using the logic of is_palindrome\n            # Found the longest palindromic suffix\n            # The prefix to reverse is string[:i]\n            prefix_to_reverse = string[:i]\n            return string + prefix_to_reverse[::-1]\n    return string"}
{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n    for num in numbers:\n        total_sum += num\n        total_product *= num\n    return total_sum, total_product"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b using the Euclidean algorithm.\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    # Take absolute values to ensure a non-negative result, as per business rules.\n    a = abs(a)\n    b = abs(b)\n\n    # Apply the Euclidean algorithm.\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/14", "solution": "def all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string.\n    \"\"\"\n    return [string[:i] for i in range(1, len(string) + 1)]"}
{"task_id": "HumanEval/11", "solution": "class BitXorError(Exception):\n    pass\n\nclass InvalidBitStringError(BitXorError):\n    pass\n\nclass XORServiceError(BitXorError):\n    pass\n\nVALID_CHARS = {'0', '1'}\nDEFAULT_PAD_CHAR = '0'\n\ndef validate_bitstring(s: str) -> bool:\n    \"\"\"Checks if a string consists only of '0's and '1's.\"\"\"\n    return all(ch in VALID_CHARS for ch in s)\n\ndef pad_left(s: str, target_len: int) -> str:\n    \"\"\"Left-pads a string with '0' to reach the target length.\"\"\"\n    if target_len <= len(s):\n        return s\n    return DEFAULT_PAD_CHAR * (target_len - len(s)) + s\n\nclass BitString:\n    def __init__(self, value: str) -> None:\n        v = value.strip()\n        if not validate_bitstring(v):\n            raise InvalidBitStringError(f\"Invalid bitstring: {value!r}\")\n        self.value: str = v\n\n    def __len__(self) -> int:\n        return len(self.value)\n\n    def pad_left(self, target_len: int) -> 'BitString':\n        if target_len <= len(self):\n            return self\n        padded = pad_left(self.value, target_len)\n        return BitString(padded)\n\n    def as_str(self) -> str:\n        return self.value\n\n    def __repr__(self) -> str:\n        return f\"BitString({self.value!r})\"\n\nclass BitStringFactory:\n    def create(self, raw: str) -> BitString:\n        if not isinstance(raw, str):\n            raise TypeError(\"raw must be a str\")\n        return BitString(raw)\n\nclass XORService:\n    def _xor_chars(self, a_char: str, b_char: str) -> str:\n        \"\"\"Helper to XOR two single bit characters.\"\"\"\n        return '1' if a_char != b_char else '0'\n\n    def xor(self, a: BitString, b: BitString) -> BitString:\n        if not isinstance(a, BitString) or not isinstance(b, BitString):\n            raise TypeError(\"xor expects BitString instances\")\n\n        target = max(len(a), len(b))\n        a_pad = a.pad_left(target)\n        b_pad = b.pad_left(target)\n        res_chars = []\n        for ac, bc in zip(a_pad.as_str(), b_pad.as_str()):\n            res_chars.append(self._xor_chars(ac, bc))\n        return BitString(''.join(res_chars))\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    factory = BitStringFactory()\n    bit_a = factory.create(a)\n    bit_b = factory.create(b)\n\n    service = XORService()\n    result_bitstring = service.xor(bit_a, bit_b)\n\n    return result_bitstring.as_str()"}
