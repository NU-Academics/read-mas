{"task_id": "HumanEval/25", "solution": "def factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    factors = []\n\n    # Handle factor 2\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    # Handle odd factors\n    d = 3\n    # Iterate through odd numbers up to the square root of n.\n    while d * d <= n:\n        while n % d == 0:\n            factors.append(d)\n            n //= d\n        d += 2\n\n    # If n is still greater than 1, it must be a prime factor itself.\n    if n > 1:\n        factors.append(n)\n\n    return factors"}
{"task_id": "HumanEval/26", "solution": "from typing import List\nfrom collections import Counter\n\n\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    counts = Counter(numbers)\n    return [n for n in numbers if counts[n] == 1]"}
{"task_id": "HumanEval/29", "solution": "```python\ndef filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n    >>> filter_by_prefix([], 'a')\n    []\n    >>> filter_by_prefix(['abc', 'bcd', 'cde', 'array'], 'a')\n    ['abc', 'array']\n    \"\"\"\n    if prefix == \"\":\n        return list(strings)\n    return [s for s in strings if s.startswith(prefix)]\n```"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list):\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    return sorted(list(set(l)))"}
{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    max_val = l[0]\n    for v in l[1:]:\n        if v > max_val:\n            max_val = v\n    return max_val"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\n        return []\n\n    # Create a copy of the input list to avoid modifying the original.\n    result_list = list(l)\n\n    # Collect values at indices divisible by three.\n    values_to_sort = []\n    indices_to_replace = []\n    for i in range(len(l)):\n        if i % 3 == 0:\n            values_to_sort.append(l[i])\n            indices_to_replace.append(i)\n\n    # Sort the collected values.\n    values_to_sort.sort()\n\n    # Replace the values in the result_list with the sorted values.\n    for i, sorted_val in zip(indices_to_replace, values_to_sort):\n        result_list[i] = sorted_val\n\n    return result_list"}
{"task_id": "HumanEval/31", "solution": "import math\nimport time\nimport sqlite3\nfrom datetime import datetime, timezone\nfrom collections import OrderedDict\nfrom typing import Any, Optional, Dict\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input.\"\"\"\n    pass\n\nclass StorageError(Exception):\n    \"\"\"Custom exception for storage-related errors.\"\"\"\n    pass\n\nclass NumberCheck:\n    \"\"\"Domain model for a primality check result.\"\"\"\n    def __init__(self, n: int, is_prime: bool, algorithm: str, checked_at: datetime, time_ms: float) -> None:\n        self.n = n\n        self.is_prime = is_prime\n        self.algorithm = algorithm\n        self.checked_at = checked_at\n        self.time_ms = time_ms\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Convert NumberCheck object to a dictionary.\"\"\"\n        return {\n            \"n\": self.n,\n            \"is_prime\": self.is_prime,\n            \"algorithm\": self.algorithm,\n            \"checked_at\": self.checked_at.isoformat(),\n            \"time_ms\": self.time_ms,\n        }\n\ndef now_utc() -> datetime:\n    \"\"\"Return the current UTC datetime.\"\"\"\n    return datetime.now(timezone.utc)\n\ndef time_ms(start: float, end: float) -> float:\n    \"\"\"Calculate duration in milliseconds.\"\"\"\n    return (end - start) * 1000.0\n\nclass TrialDivision:\n    \"\"\"Implements the Trial Division primality test.\"\"\"\n    def is_prime(self, n: int) -> bool:\n        if n < 2:\n            return False\n        if n == 2 or n == 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\nclass MillerRabin:\n    \"\"\"Implements the Miller-Rabin primality test.\"\"\"\n    def __init__(self, default_rounds: int = 5):\n        self.default_rounds = default_rounds\n\n    def _try_composite(self, a: int, d: int, n: int, s: int) -> bool:\n        \"\"\"Helper for Miller-Rabin test.\"\"\"\n        x = pow(a, d, n)\n        if x == 1 or x == n - 1:\n            return False\n        for _ in range(s - 1):\n            x = pow(x, 2, n)\n            if x == n - 1:\n                return False\n        return True\n\n    _deterministic_bases = [\n        (2047, [2]),\n        (1373653, [2, 3]),\n        (25326001, [2, 3, 5]),\n        (3215031751, [2, 3, 5, 7]),\n        (2152302898747, [2, 3, 5, 7, 11]),\n        (3474749660383, [2, 3, 5, 7, 11, 13]),\n        (341550071728321, [2, 3, 5, 7, 11, 13, 17]),\n        (3825123056546413051, [2, 3, 5, 7, 11, 13, 17, 19, 23]),\n    ]\n\n    def is_prime(self, n: int, rounds: Optional[int] = None) -> bool:\n        if n < 2:\n            return False\n        if n == 2 or n == 3:\n            return True\n        if n % 2 == 0:\n            return False\n\n        d = n - 1\n        s = 0\n        while d % 2 == 0:\n            d //= 2\n            s += 1\n\n        bases_to_test = None\n        for limit, bases in self._deterministic_bases:\n            if n <= limit:\n                bases_to_test = bases\n                break\n        \n        if bases_to_test is None:\n            bases_to_test = self._deterministic_bases[-1][1] \n            if rounds is not None:\n                bases_to_test = bases_to_test[:rounds]\n            else:\n                bases_to_test = bases_to_test[:self.default_rounds]\n\n        for a in bases_to_test:\n            if a >= n:\n                continue\n            if self._try_composite(a, d, n, s):\n                return False\n        return True\n\nclass CacheAdapter:\n    \"\"\"In-memory LRU cache for primality check results.\"\"\"\n    def __init__(self, max_size: int = 1024) -> None:\n        self._max_size = max_size\n        self._store: OrderedDict[tuple[int, str], NumberCheck] = OrderedDict()\n\n    def get(self, n: int, algorithm: str) -> Optional[NumberCheck]:\n        \"\"\"Retrieve a cached result.\"\"\"\n        key = (n, algorithm)\n        if key in self._store:\n            self._store.move_to_end(key)\n            return self._store[key]\n        return None\n\n    def set(self, check: NumberCheck) -> None:\n        \"\"\"Store a result in the cache.\"\"\"\n        key = (check.n, check.algorithm)\n        self._store[key] = check\n        self._store.move_to_end(key)\n        if len(self._store) > self._max_size:\n            self._store.popitem(last=False)\n\n    def clear(self) -> None:\n        \"\"\"Clear the cache.\"\"\"\n        self._store.clear()\n\nclass CheckRepository:\n    \"\"\"SQLite repository for persistent storage of primality checks.\"\"\"\n    def __init__(self, db_path: str = 'data/primes.db') -> None:\n        self._db_path = db_path\n        self._conn: Optional[sqlite3.Connection] = None\n\n    def _get_connection(self) -> sqlite3.Connection:\n        \"\"\"Establish and return a database connection.\"\"\"\n        if self._conn is None:\n            import os\n            os.makedirs(os.path.dirname(self._db_path) or '.', exist_ok=True)\n            self._conn = sqlite3.connect(self._db_path)\n            self._conn.row_factory = sqlite3.Row\n        return self._conn\n\n    def migrate(self) -> None:\n        \"\"\"Create the prime_checks table if it doesn't exist.\"\"\"\n        conn = self._get_connection()\n        cursor = conn.cursor()\n        cursor.execute(\"\"\"\n            CREATE TABLE IF NOT EXISTS prime_checks (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                n INTEGER NOT NULL,\n                algorithm TEXT NOT NULL,\n                is_prime INTEGER NOT NULL, -- 0 or 1\n                checked_at TEXT NOT NULL, -- ISO8601 timestamp\n                time_ms REAL NOT NULL,\n                UNIQUE(n, algorithm)\n            );\n        \"\"\")\n        cursor.execute(\"CREATE INDEX IF NOT EXISTS idx_prime_checks_n_algorithm ON prime_checks (n, algorithm);\")\n        cursor.execute(\"CREATE INDEX IF NOT EXISTS idx_prime_checks_checked_at ON prime_checks (checked_at);\")\n        conn.commit()\n\n    def get(self, n: int, algorithm: str) -> Optional[NumberCheck]:\n        \"\"\"Retrieve a primality check result from the repository.\"\"\"\n        conn = self._get_connection()\n        cursor = conn.cursor()\n        try:\n            cursor.execute(\"SELECT n, is_prime, algorithm, checked_at, time_ms FROM prime_checks WHERE n = ? AND algorithm = ?\", (n, algorithm))\n            row = cursor.fetchone()\n            if row:\n                return NumberCheck(\n                    n=row[\"n\"],\n                    is_prime=bool(row[\"is_prime\"]),\n                    algorithm=row[\"algorithm\"],\n                    checked_at=datetime.fromisoformat(row[\"checked_at\"]).replace(tzinfo=timezone.utc),\n                    time_ms=row[\"time_ms\"],\n                )\n            return None\n        except sqlite3.Error as e:\n            if \"no such table\" in str(e).lower():\n                return None\n            raise StorageError(f\"Database error during get: {e}\") from e\n\n    def save(self, check: NumberCheck) -> None:\n        \"\"\"Save a primality check result to the repository.\"\"\"\n        conn = self._get_connection()\n        cursor = conn.cursor()\n        try:\n            cursor.execute(\"\"\"\n                INSERT OR REPLACE INTO prime_checks (n, algorithm, is_prime, checked_at, time_ms)\n                VALUES (?, ?, ?, ?, ?)\n            \"\"\", (check.n, check.algorithm, int(check.is_prime), check.checked_at.isoformat(), check.time_ms))\n            conn.commit()\n        except sqlite3.Error as e:\n            raise StorageError(f\"Database error during save: {e}\") from e\n\n    def __del__(self):\n        \"\"\"Close the database connection when the repository object is destroyed.\"\"\"\n        if self._conn:\n            self._conn.close()\n\nclass PrimalityService:\n    \"\"\"Orchestrates primality checking including caching and algorithm selection.\"\"\"\n    def __init__(self, repo: CheckRepository, cache: CacheAdapter, algorithms: Dict[str, Any], default_alg: str = 'auto') -> None:\n        self._repo = repo\n        self._cache = cache\n        self._algorithms = algorithms\n        self._default_alg = default_alg\n\n    def _choose_algorithm(self, n: int, algorithm: Optional[str]) -> str:\n        \"\"\"Selects an algorithm based on n and user preference.\"\"\"\n        if algorithm and algorithm != \"auto\":\n            if algorithm not in self._algorithms:\n                return \"miller_rabin\" # Fallback to a general algorithm if specified one is unknown.\n            return algorithm\n        \n        if n <= 1_000_000:\n            return \"trial_division\"\n        return \"miller_rabin\"\n\n    def is_prime(self, n: int, algorithm: Optional[str] = None, use_cache: bool = True) -> Dict[str, Any]:\n        \"\"\"Check if a number is prime, using cache and selected algorithm.\"\"\"\n        if n < 2:\n            return {'n': n, 'is_prime': False, 'algorithm': 'direct_check', 'time_ms': 0.0, 'cached': False}\n\n        selected_algorithm_name = self._choose_algorithm(n, algorithm)\n        current_algorithm = self._algorithms[selected_algorithm_name]\n\n        cached_check = None\n        if use_cache:\n            cached_check = self._cache.get(n, selected_algorithm_name)\n            if cached_check:\n                return cached_check.to_dict() | {\"cached\": True}\n\n            try:\n                cached_check = self._repo.get(n, selected_algorithm_name)\n                if cached_check:\n                    self._cache.set(cached_check)\n                    return cached_check.to_dict() | {\"cached\": True}\n            except StorageError:\n                pass # Fail gracefully if repository operations encounter an error.\n\n        start_time = time.perf_counter()\n        is_p = current_algorithm.is_prime(n)\n        end_time = time.perf_counter()\n        duration_ms = time_ms(start_time, end_time)\n\n        result_check = NumberCheck(\n            n=n,\n            is_prime=is_p,\n            algorithm=selected_algorithm_name,\n            checked_at=now_utc(),\n            time_ms=duration_ms,\n        )\n\n        if use_cache:\n            self._cache.set(result_check)\n            try:\n                self._repo.save(result_check)\n            except StorageError:\n                pass # Fail gracefully if repository operations encounter an error.\n\n        return result_check.to_dict() | {\"cached\": False}\n\n\n_repo = CheckRepository()\ntry:\n    _repo.migrate()\nexcept StorageError:\n    pass\n\n_cache = CacheAdapter(max_size=1024)\n_algorithms = {\"trial_division\": TrialDivision(), \"miller_rabin\": MillerRabin()}\n\n_service = PrimalityService(repo=_repo, cache=_cache, algorithms=_algorithms)\n\n\ndef is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    return _service.is_prime(n)[\"is_prime\"]"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    even_values = [l[i] for i in range(0, len(l), 2)]\n    sorted_even_values = sorted(even_values)\n\n    result = list(l)\n    sorted_iter = iter(sorted_even_values)\n\n    for i in range(0, len(result), 2):\n        result[i] = next(sorted_iter)\n\n    return result"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # inverse cycle elements in each group (rotate right). Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\"\"\"\n\n    import os\n    import json\n    import tempfile\n    import threading\n    from typing import Any, Tuple, Iterator, Iterable, Optional\n\n    class InvalidInputError(Exception):\n        \"\"\"Exception raised for invalid input.\"\"\"\n        def __init__(self, message: str) -> None:\n            self.message = message\n            super().__init__(self.message)\n\n    class AppConfig:\n        \"\"\"Application configuration for cache paths and verbosity.\"\"\"\n        def __init__(self, cache_path: Optional[str] = None, verbose: bool = False) -> None:\n            self._cache_path = cache_path\n            self.verbose = verbose\n\n        def resolve_cache_path(self) -> str:\n            \"\"\"Resolves and returns the absolute path for the cache file.\"\"\"\n            if self._cache_path:\n                return self._cache_path\n            cache_dir = os.path.join(tempfile.gettempdir(), \"fizzbuzz_app_cache\")\n            os.makedirs(cache_dir, exist_ok=True)\n            return os.path.join(cache_dir, \".fizzbuzz_cache.json\")\n\n    class CacheRepository:\n        \"\"\"Handles persistence and retrieval of cached results to/from a JSON file.\"\"\"\n        def __init__(self, path: str) -> None:\n            self.path = path\n            self._lock = threading.Lock()\n\n        def get(self, n: int) -> Optional[int]:\n            \"\"\"Retrieves the cached count for n, or None if not found or an error occurs.\"\"\"\n            try:\n                with self._lock:\n                    if not os.path.exists(self.path):\n                        return None\n                    with open(self.path, 'r', encoding='utf-8') as f:\n                        mapping = json.load(f)\n                    return mapping.get(str(n))\n            except Exception:\n                # Cache read errors are non-fatal; proceed without cache.\n                return None\n\n        def set(self, n: int, value: int) -> None:\n            \"\"\"Persists the computed value for n to the cache file using atomic write.\"\"\"\n            try:\n                with self._lock:\n                    mapping = {}\n                    if os.path.exists(self.path):\n                        with open(self.path, 'r', encoding='utf-8') as f:\n                            mapping = json.load(f)\n                    mapping[str(n)] = value\n                    \n                    dirpath = os.path.dirname(self.path) or '.'\n                    os.makedirs(dirpath, exist_ok=True) \n                    \n                    fd, tmp_path = tempfile.mkstemp(dir=dirpath, prefix=\"fizzbuzz_cache_\", suffix=\".json\")\n                    with os.fdopen(fd, 'w', encoding='utf-8') as f:\n                        json.dump(mapping, f)\n                    os.replace(tmp_path, self.path)\n            except Exception:\n                # Cache write errors are non-fatal; computation proceeds without persistence.\n                pass\n\n    class NumberGenerator:\n        \"\"\"Generates numbers divisible by specified divisors within a given limit.\"\"\"\n        def __init__(self, divisors: Tuple[int, ...] = (11, 13)) -> None:\n            self.divisors = divisors\n\n        def generate(self, limit: int) -> Iterator[int]:\n            \"\"\"Yields unique integers x where 0 <= x < limit and divisible by any of the divisors.\"\"\"\n            seen = set()\n            \n            # 0 is divisible by any non-zero integer, include if within limit\n            if 0 < limit and any(d != 0 for d in self.divisors):\n                if 0 not in seen:\n                    seen.add(0)\n                    yield 0\n            \n            for d in self.divisors:\n                if d <= 0: # Avoid infinite loop or division by zero\n                    continue\n                multiple = d \n                while multiple < limit:\n                    if multiple not in seen:\n                        seen.add(multiple)\n                        yield multiple\n                    multiple += d\n\n    class DigitCounter:\n        \"\"\"Counts occurrences of a target digit in integers and sequences of integers.\"\"\"\n        def __init__(self, target_digit: str = '7') -> None:\n            self.target_digit = target_digit\n\n        def count_in_int(self, value: int) -> int:\n            \"\"\"Counts occurrences of the target digit in a single integer.\"\"\"\n            return str(abs(value)).count(self.target_digit)\n\n        def count_in_sequence(self, numbers: Iterable[int]) -> int:\n            \"\"\"Sums the digit counts from an iterable of integers.\"\"\"\n            return sum(self.count_in_int(v) for v in numbers)\n\n    class Validator:\n        \"\"\"Provides static methods for input validation.\"\"\"\n        @staticmethod\n        def validate_positive_int(num_val: Any) -> int:\n            \"\"\"Validates if input is an integer; returns 0 if negative, raises error if not int.\"\"\"\n            if not isinstance(num_val, int):\n                raise InvalidInputError(\"n must be an integer\")\n            if num_val < 0:\n                return 0\n            return num_val\n\n    class FizzBuzzService:\n        \"\"\"Orchestrates computation, caching, number generation, and digit counting.\"\"\"\n        def __init__(self, cache_repo: CacheRepository, generator: NumberGenerator, counter: DigitCounter, config: AppConfig) -> None:\n            self.cache_repo = cache_repo\n            self.generator = generator\n            self.counter = counter\n            self.config = config\n\n        def compute(self, n_val: int) -> int:\n            \"\"\"Computes the total count of the target digit in qualifying numbers.\"\"\"\n            validated_n = Validator.validate_positive_int(n_val)\n            \n            # If validated_n is 0 (original n was <= 0), return 0 immediately.\n            if validated_n == 0:\n                return 0\n\n            cached_count = self.cache_repo.get(validated_n)\n            if cached_count is not None:\n                return cached_count\n\n            qualifying_numbers = self.generator.generate(validated_n)\n            total_sevens = self.counter.count_in_sequence(qualifying_numbers)\n\n            self.cache_repo.set(validated_n, total_sevens)\n            return total_sevens\n\n    # --- Main logic for fizz_buzz function ---\n    config = AppConfig()\n    cache = CacheRepository(config.resolve_cache_path())\n    generator = NumberGenerator((11, 13))\n    counter = DigitCounter('7')\n    service = FizzBuzzService(cache, generator, counter, config)\n\n    return service.compute(n)"}
{"task_id": "HumanEval/32", "solution": "import math\nimport numpy as np\n\n# --- Exception Definitions ---\nclass ValidationError(Exception):\n    \"\"\"Raised when input validation fails.\"\"\"\n    pass\n\nclass InvalidCoefficientsError(ValidationError):\n    \"\"\"Raised when polynomial coefficients are invalid.\"\"\"\n    pass\n\nclass NoRealRootFoundError(Exception):\n    \"\"\"Raised when no real root is found within tolerance.\"\"\"\n    pass\n\n# --- Utils ---\ndef is_real_close(z: complex, tol: float) -> bool:\n    \"\"\"Determine if the imaginary part of a complex number is close to zero.\"\"\"\n    return abs(z.imag) <= tol\n\ndef sample_intervals(start: float, end: float, n: int) -> list[tuple[float, float]]:\n    \"\"\"Partition [start, end] into n intervals.\"\"\"\n    if n <= 0:\n        return []\n    step = (end - start) / n\n    intervals = []\n    for i in range(n):\n        a = start + i * step\n        b = a + step\n        intervals.append((a, b))\n    return intervals\n\n# --- Polynomial Class ---\nclass Polynomial:\n    \"\"\"Represents a polynomial and provides evaluation and derivative methods.\"\"\"\n    def __init__(self, coeffs: list[float]) -> None:\n        self.coeffs = [float(c) for c in coeffs]\n        # Remove trailing zeros for normalization.\n        while len(self.coeffs) > 1 and abs(self.coeffs[-1]) < 1e-15:\n            self.coeffs.pop()\n        \n        if not self.coeffs:\n            raise InvalidCoefficientsError(\"Coefficient list cannot be empty after normalization.\")\n        if all(abs(c) < 1e-15 for c in self.coeffs):\n            raise InvalidCoefficientsError(\"All coefficients are zero, representing the zero polynomial.\")\n\n        self.degree = len(self.coeffs) - 1\n\n    def evaluate(self, x: float) -> float:\n        \"\"\"Evaluates the polynomial at point x using Horner's method.\"\"\"\n        result = 0.0\n        for coeff in reversed(self.coeffs):\n            result = result * x + coeff\n        return result\n\n    def derivative(self) -> 'Polynomial':\n        \"\"\"Returns a new Polynomial object representing the derivative.\"\"\"\n        if self.degree <= 0:\n            return Polynomial([0.0])\n        \n        deriv_coeffs = [i * self.coeffs[i] for i in range(1, len(self.coeffs))]\n        return Polynomial(deriv_coeffs)\n\n# --- Root Solvers ---\nclass CompanionMatrixSolver:\n    \"\"\"Computes all (complex) roots using the companion matrix method with NumPy.\"\"\"\n    DEFAULT_EPS: float = 1e-12\n\n    def find_roots(self, poly: Polynomial) -> list[complex]:\n        \"\"\"Builds the companion matrix and computes eigenvalues.\"\"\"\n        n = poly.degree\n        if n < 0:\n            return []\n        if n == 0:\n            return []\n        if n == 1:\n             return [-poly.coeffs[0] / poly.coeffs[1]]\n\n        A = np.zeros((n, n), dtype=complex)\n        \n        # Fill the subdiagonal with 1s.\n        for i in range(1, n):\n            A[i, i-1] = 1.0\n        \n        # Fill the first row with negative normalized coefficients.\n        lead_coeff = poly.coeffs[-1]\n        for j in range(n):\n            A[0, j] = -poly.coeffs[j] / lead_coeff\n\n        roots = np.linalg.eigvals(A)\n        return list(roots)\n\nclass NewtonSolver:\n    \"\"\"Newton-Raphson solver for a single real root.\"\"\"\n    def find_root(self, poly: Polynomial, initial: float, tol: float = 1e-8, max_iter: int = 100) -> float:\n        \"\"\"Applies Newton's method to find a root.\"\"\"\n        x = float(initial)\n        poly_deriv = poly.derivative()\n        \n        for _ in range(max_iter):\n            f_x = poly.evaluate(x)\n            if abs(f_x) < tol:\n                return x\n            \n            f_prime_x = poly_deriv.evaluate(x)\n            if abs(f_prime_x) < 1e-15:\n                raise RuntimeError(\"Newton-Raphson: Derivative became zero near the root.\")\n            \n            x = x - f_x / f_prime_x\n        \n        raise RuntimeError(\"Newton-Raphson: Max iterations reached without convergence.\")\n\nclass BisectionSolver:\n    \"\"\"Bisection search over a bracket [a, b] where f(a)*f(b) <= 0.\"\"\"\n    def find_root(self, poly: Polynomial, a: float, b: float, tol: float = 1e-8, max_iter: int = 100) -> float:\n        \"\"\"Performs bisection search for a root.\"\"\"\n        fa = poly.evaluate(a)\n        fb = poly.evaluate(b)\n\n        if abs(fa) < tol: return a\n        if abs(fb) < tol: return b\n\n        if fa * fb > 0:\n            raise ValueError(\"Bisection: f(a) and f(b) must have opposite signs or one must be zero.\")\n\n        if fa > fb:\n            a, b = b, a\n            fa, fb = fb, fa\n\n        for _ in range(max_iter):\n            c = (a + b) / 2\n            fc = poly.evaluate(c)\n\n            if abs(fc) < tol:\n                return c\n            \n            if fa * fc < 0:\n                b = c\n                fb = fc\n            else:\n                a = c\n                fa = fc\n        \n        raise RuntimeError(\"Bisection: Max iterations reached without convergence.\")\n\n# Global constants for root finding behavior.\nDEFAULT_TOLERANCE: float = 1e-8\nDEFAULT_MAX_ITER: int = 200\nDEFAULT_SEARCH_BOUND: float = 1000.0\nDEFAULT_SAMPLE_PARTS: int = 100\n\ndef find_zero(xs: list):\n    \"\"\"\n    xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    \"\"\"\n    if not isinstance(xs, list) or not all(isinstance(c, (int, float)) for c in xs):\n        raise ValidationError(\"Coefficients must be a list of numbers.\")\n    if not xs:\n        raise InvalidCoefficientsError(\"Coefficient list cannot be empty.\")\n\n    if len(xs) % 2 != 0:\n        raise ValidationError(\"The list of coefficients must have an even number of elements.\")\n\n    try:\n        poly = Polynomial(xs)\n    except InvalidCoefficientsError as e:\n        raise ValidationError(f\"Invalid polynomial coefficients: {e}\") from e\n\n    companion_solver = CompanionMatrixSolver()\n    try:\n        roots = companion_solver.find_roots(poly)\n        for r in roots:\n            if is_real_close(r, DEFAULT_TOLERANCE):\n                return float(r.real)\n    except Exception:\n        pass\n\n    intervals = sample_intervals(-DEFAULT_SEARCH_BOUND, DEFAULT_SEARCH_BOUND, DEFAULT_SAMPLE_PARTS)\n    bisection_solver = BisectionSolver()\n    \n    for a, b in intervals:\n        try:\n            fa = poly.evaluate(a)\n            fb = poly.evaluate(b)\n            if fa * fb <= 0:\n                return bisection_solver.find_root(poly, a, b, DEFAULT_TOLERANCE, DEFAULT_MAX_ITER)\n        except (ValueError, RuntimeError):\n            continue\n\n    newton_solver = NewtonSolver()\n    seed_attempts = [0.0]\n    seed_attempts.extend([ (i[0] + i[1]) / 2 for i in intervals])\n    seed_attempts.extend([i[0] for i in intervals])\n    seed_attempts.extend([i[1] for i in intervals])\n\n    for val in [-1.0, 1.0, -0.1, 0.1, -10.0, 10.0]:\n        if -DEFAULT_SEARCH_BOUND <= val <= DEFAULT_SEARCH_BOUND and val not in seed_attempts:\n            seed_attempts.append(val)\n    \n    for seed in sorted(list(set(seed_attempts))):\n        try:\n            root = newton_solver.find_root(poly, seed, DEFAULT_TOLERANCE, DEFAULT_MAX_ITER)\n            if abs(poly.evaluate(root)) < DEFAULT_TOLERANCE:\n                return root\n        except RuntimeError:\n            continue\n    \n    raise NoRealRootFoundError(\"Could not find a real root for the given polynomial.\")"}
{"task_id": "HumanEval/41", "solution": "def car_race_collision(n: int):\n    \"\"\"\n    Calculates the total number of head-on collisions between two sets of n cars\n    moving in opposite directions.\n    \"\"\"\n    return n * n"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    sorted_nums = sorted(l)\n\n    for i in range(n - 2):\n        # Skip duplicate values for the first element to avoid duplicate triples\n        if i > 0 and sorted_nums[i] == sorted_nums[i - 1]:\n            continue\n\n        target = -sorted_nums[i]\n        left, right = i + 1, n - 1\n\n        while left < right:\n            current_sum = sorted_nums[left] + sorted_nums[right]\n\n            if current_sum == target:\n                return True\n            elif current_sum < target:\n                left += 1\n            else:\n                right -= 1\n    return False"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    seen_numbers = set()\n    zero_count = 0\n\n    for num in l:\n        if num == 0:\n            zero_count += 1\n            # If two or more zeros are found, they sum to zero and are distinct by index.\n            if zero_count >= 2:\n                return True\n        else:\n            # Check if the negation of the current number has been seen before.\n            if -num in seen_numbers:\n                return True\n            # Add the current number to the set for future checks.\n            seen_numbers.add(num)\n\n    # If no such pair is found after checking all numbers, return False.\n    return False"}
{"task_id": "HumanEval/44", "solution": "```python\ndef change_base(x: int, base: int) -> str:\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if x == 0:\n        return \"0\"\n    \n    digits = []\n    n = x\n    while n > 0:\n        digits.append(str(n % base))\n        n //= base\n    return \"\".join(reversed(digits))\n```"}
{"task_id": "HumanEval/42", "solution": "import uuid\nimport datetime\nfrom dataclasses import dataclass\nfrom typing import List, Dict, Any, Optional\n\nclass InvalidInputError(ValueError):\n    \"\"\"Raised when the overall input structure is invalid.\"\"\"\n    pass\n\nclass InvalidElementError(ValueError):\n    \"\"\"Raised when an individual element in the input is invalid.\"\"\"\n    pass\n\nclass RepositoryError(Exception):\n    \"\"\"Raised when there's an issue with the operation repository.\"\"\"\n    pass\n\n@dataclass\nclass ListModel:\n    \"\"\"A data model for a list of integers.\"\"\"\n    items: List[int]\n\n    @staticmethod\n    def from_list(items: List[int]) -> \"ListModel\":\n        \"\"\"Creates a ListModel from a list of integers.\"\"\"\n        return ListModel(items=list(items))\n\n@dataclass\nclass Operation:\n    \"\"\"Represents a single increment operation for auditing.\"\"\"\n    id: str\n    timestamp: str\n    input: List[int]\n    output: List[int]\n    metadata: Dict[str, Any]\n\n    def to_json(self) -> Dict[str, Any]:\n        \"\"\"Converts the operation to a dictionary for JSON serialization.\"\"\"\n        return {\n            \"id\": self.id,\n            \"timestamp\": self.timestamp,\n            \"input\": self.input,\n            \"output\": self.output,\n            \"metadata\": self.metadata,\n        }\n\nclass OperationRepository:\n    \"\"\"Abstract interface for storing operation records.\"\"\"\n    def record(self, operation: Operation) -> None:\n        raise NotImplementedError\n\n    def list_all(self) -> List[Operation]:\n        raise NotImplementedError\n\nclass InMemoryOperationRepository(OperationRepository):\n    \"\"\"In-memory implementation of OperationRepository.\"\"\"\n    def __init__(self):\n        self._store: List[Operation] = []\n\n    def record(self, operation: Operation) -> None:\n        \"\"\"Records an operation in memory.\"\"\"\n        self._store.append(operation)\n\n    def list_all(self) -> List[Operation]:\n        \"\"\"Retrieves all recorded operations.\"\"\"\n        return self._store[:]\n\nclass InputValidator:\n    \"\"\"Validates raw input and converts it to a ListModel.\"\"\"\n    def __init__(self, max_length: int = 10000):\n        self._max_length = max_length\n\n    def validate(self, raw: Any) -> ListModel:\n        \"\"\"Validates that the input is a list of integers within the max length.\"\"\"\n        if not isinstance(raw, (list, tuple)):\n            raise InvalidInputError(\"Input must be a list or tuple.\")\n        if len(raw) > self._max_length:\n            raise InvalidInputError(f\"Input exceeds maximum length of {self._max_length}.\")\n        items = []\n        for i, v in enumerate(raw):\n            if not isinstance(v, int):\n                raise InvalidElementError(f\"Element at index {i} is not an integer.\")\n            items.append(v)\n        return ListModel.from_list(items)\n\nclass IncrService:\n    \"\"\"Core business logic for incrementing a list.\"\"\"\n    def __init__(self, repository: Optional[OperationRepository] = None, strict_repo: bool = False):\n        self._repository = repository\n        self._strict_repo = strict_repo\n\n    def incr_list(self, input_model: ListModel) -> List[int]:\n        \"\"\"Increments each element in the input model and records the operation.\"\"\"\n        output = [x + 1 for x in input_model.items]\n        op = Operation(\n            id=str(uuid.uuid4()),\n            timestamp=datetime.datetime.utcnow().isoformat() + \"Z\",\n            input=input_model.items,\n            output=output,\n            metadata={}\n        )\n        if self._repository:\n            try:\n                self._repository.record(op)\n            except Exception as e:\n                if self._strict_repo:\n                    raise RepositoryError(\"Repository failed to record operation.\") from e\n        return output\n\nclass IncrController:\n    \"\"\"Orchestrates validation and service calls for incrementing lists.\"\"\"\n    def __init__(self, validator: InputValidator, service: IncrService):\n        self.validator = validator\n        self.service = service\n\n    def handle(self, raw_input: Any) -> List[int]:\n        \"\"\"Handles a raw input, validates it, and performs the increment operation.\"\"\"\n        list_model = self.validator.validate(raw_input)\n        result = self.service.incr_list(list_model)\n        return result\n\ndef incr_list(l: list):\n    \"\"\"Return list with elements incremented by 1.\n    >>> incr_list([1, 2, 3])\n    [2, 3, 4]\n    >>> incr_list([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [6, 4, 6, 3, 4, 4, 10, 1, 124]\n    \"\"\"\n    validator = InputValidator()\n    repository = InMemoryOperationRepository()\n    service = IncrService(repository=repository)\n    controller = IncrController(validator, service)\n    return controller.handle(l)"}
{"task_id": "HumanEval/45", "solution": "```python\ndef triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    return (a * h) / 2.0\n```"}
{"task_id": "HumanEval/39", "solution": "from typing import Iterator, Optional, Dict, List\nimport shelve\nfrom abc import ABC, abstractmethod\n\nclass InvalidParameterError(ValueError):\n    \"\"\"Raised when an invalid parameter is provided.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass ComputationError(RuntimeError):\n    \"\"\"Raised when an unexpected error occurs during computation.\"\"\"\n    def __init__(self, message: str, cause: Exception = None):\n        super().__init__(message)\n        self.cause = cause\n\nclass CacheError(RuntimeError):\n    \"\"\"Raised when a cache operation fails.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass FibonacciGenerator:\n    \"\"\"Generates Fibonacci numbers starting with 1, 1.\"\"\"\n    def __init__(self, start_a: int = 1, start_b: int = 1):\n        self.start_a = start_a\n        self.start_b = start_b\n\n    def generate(self) -> Iterator[int]:\n        a, b = self.start_a, self.start_b\n        yield a\n        yield b\n        while True:\n            a, b = b, a + b\n            yield b\n\n    def get_nth(self, index: int) -> int:\n        \"\"\"Returns the Fibonacci number at a 1-based index.\"\"\"\n        if index < 1:\n            raise InvalidParameterError(\"index must be >= 1\")\n        gen = self.generate()\n        val = next(gen) # Initialize with first value\n        for _ in range(index - 1): # Iterate for remaining (index-1) values\n            val = next(gen)\n        return val\n\nclass PrimalityTester(ABC):\n    \"\"\"Abstract base class for primality testing.\"\"\"\n    @abstractmethod\n    def is_prime(self, n: int) -> bool:\n        raise NotImplementedError\n\nclass MillerRabinPrimalityTester(PrimalityTester):\n    \"\"\"Implements the Miller-Rabin primality test using predefined bases.\"\"\"\n    def __init__(self, bases: List[int] = None):\n        self.bases = bases or [2, 3, 5, 7, 11, 13]\n\n    def is_prime(self, n: int) -> bool:\n        if n < 2:\n            raise ValueError(\"n must be >= 2\")\n        if n in self.bases:\n            return True\n\n        # Small prime trial division to quickly filter composites\n        small_primes = [2, 3, 5, 7, 11, 13, 17, 19, 23]\n        for p in small_primes:\n            if n == p:\n                return True\n            if n % p == 0:\n                return False\n        \n        # Decompose n-1 as d * 2^s\n        d = n - 1\n        s = 0\n        while d % 2 == 0:\n            d //= 2\n            s += 1\n        \n        # Miller-Rabin tests with chosen bases\n        for a in self.bases:\n            if a % n == 0 or a == 0:\n                continue\n            if self._try_composite(a, d, s, n):\n                return False\n        return True\n\n    def _try_composite(self, a: int, d: int, s: int, n: int) -> bool:\n        \"\"\"Helper to check if 'a' is a Miller-Rabin witness for 'n'.\"\"\"\n        x = pow(a, d, n)\n        if x == 1 or x == n - 1:\n            return False\n        for _ in range(s - 1):\n            x = (x * x) % n\n            if x == n - 1:\n                return False\n        return True\n\nclass CacheAdapter:\n    \"\"\"Abstract base class for caching.\"\"\"\n    def get(self, key: str) -> Optional[int]:\n        raise NotImplementedError\n    def set(self, key: str, value: int) -> None:\n        raise NotImplementedError\n\nclass InMemoryCache(CacheAdapter):\n    \"\"\"An in-memory cache implementation.\"\"\"\n    def __init__(self):\n        self._store: Dict[str, int] = {}\n    def get(self, key: str) -> Optional[int]:\n        return self._store.get(key)\n    def set(self, key: str, value: int) -> None:\n        self._store[key] = value\n\ndef to_cache_key(n: int) -> str:\n    \"\"\"Generates a cache key for the n-th prime Fibonacci number.\"\"\"\n    return f\"primefib:{n}\"\n\nclass PrimeFibonacciService:\n    \"\"\"Orchestrates the search for the n-th prime Fibonacci number.\"\"\"\n    def __init__(self, fibonacci: FibonacciGenerator, primality_tester: PrimalityTester, cache: CacheAdapter):\n        self._fibonacci = fibonacci\n        self._primality_tester = primality_tester\n        self._cache = cache\n\n    def find_nth_prime_fibonacci(self, n: int) -> int:\n        if not isinstance(n, int) or n < 1:\n            raise InvalidParameterError(\"n must be an integer >= 1\")\n        \n        key = to_cache_key(n)\n        \n        cached = None\n        try:\n            cached = self._cache.get(key)\n        except Exception: # Cache errors are best-effort, continue without caching.\n            pass\n        \n        if cached is not None:\n            return cached\n        \n        try:\n            count = 0\n            for val in self._fibonacci.generate():\n                if val < 2: # 1 is not prime, skip it.\n                    continue\n                \n                if self._primality_tester.is_prime(val):\n                    count += 1\n                    if count == n:\n                        try:\n                            self._cache.set(key, val)\n                        except Exception:\n                            pass # Cache write is best-effort.\n                        return val\n        except ValueError as ve: # PrimalityTester can raise ValueError for invalid input (e.g., n < 2).\n            raise ComputationError(f\"Primality test failed for a Fibonacci number: {ve}\", cause=ve)\n        except Exception as e:\n            raise ComputationError(\"Failed computing prime Fibonacci due to an unexpected error\", cause=e)\n            \n        raise ComputationError(f\"Could not find the {n}-th prime Fibonacci number. The search might have exhausted without finding enough prime Fibonacci numbers.\")\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    if not isinstance(n, int):\n        raise InvalidParameterError(\"n must be int\")\n    service = PrimeFibonacciService(\n        fibonacci=FibonacciGenerator(),\n        primality_tester=MillerRabinPrimalityTester(),\n        cache=InMemoryCache()\n    )\n    return service.find_nth_prime_fibonacci(n)"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"Computes the n-th element of the Fib4 sequence iteratively.\n    fib4(0)=0, fib4(1)=0, fib4(2)=2, fib4(3)=0, and fib4(n) = fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4) for n >= 4.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n\n    # For n >= 4, use an iterative approach to compute the sequence.\n    # We maintain the last four Fib4 numbers: fib4(i-4), fib4(i-3), fib4(i-2), fib4(i-1).\n    f_n_minus_4 = 0  # Represents fib4(0)\n    f_n_minus_3 = 0  # Represents fib4(1)\n    f_n_minus_2 = 2  # Represents fib4(2)\n    f_n_minus_1 = 0  # Represents fib4(3)\n\n    for _ in range(4, n + 1):\n        current_fib = f_n_minus_1 + f_n_minus_2 + f_n_minus_3 + f_n_minus_4\n        # Shift the values to prepare for the next iteration\n        f_n_minus_4 = f_n_minus_3\n        f_n_minus_3 = f_n_minus_2\n        f_n_minus_2 = f_n_minus_1\n        f_n_minus_1 = current_fib\n\n    return f_n_minus_1"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    >>> modp(3, 5)\n    3\n    >>> modp(1101, 101)\n    2\n    >>> modp(0, 101)\n    1\n    >>> modp(3, 11)\n    8\n    >>> modp(100, 101)\n    1\n    \"\"\"\n\n    class InvalidInputError(ValueError):\n        \"\"\"Raised when input parameters are invalid.\"\"\"\n        pass\n\n    class ComputationError(RuntimeError):\n        \"\"\"Raised when a computation fails unexpectedly.\"\"\"\n        pass\n\n    class InputValidator:\n        \"\"\"Validates input parameters n and p.\"\"\"\n        def validate(self, n: int, p: int) -> None:\n            if not isinstance(n, int) or not isinstance(p, int):\n                raise InvalidInputError(\"Inputs 'n' and 'p' must be integers.\")\n            if n < 0:\n                raise InvalidInputError(\"Exponent 'n' must be a non-negative integer.\")\n            if p <= 1:\n                raise InvalidInputError(\"Modulus 'p' must be an integer greater than 1.\")\n\n    class BuiltinPowAdapter:\n        \"\"\"Uses Python's built-in pow for modular exponentiation.\"\"\"\n        def pow2_mod(self, n: int, p: int) -> int:\n            try:\n                return pow(2, n, p)\n            except (TypeError, ValueError) as e:\n                raise ComputationError(f\"Built-in pow failed: {e}\")\n\n    class ModExpService:\n        \"\"\"Orchestrates modular exponentiation computation.\"\"\"\n        def __init__(self, backend: BuiltinPowAdapter):\n            self._backend = backend\n\n        def compute_raw(self, n: int, p: int) -> int:\n            \"\"\"Computes 2^n mod p using the configured backend.\"\"\"\n            return self._backend.pow2_mod(n, p)\n\n    validator = InputValidator()\n    validator.validate(n, p)\n\n    adapter = BuiltinPowAdapter()\n    service = ModExpService(adapter)\n\n    return service.compute_raw(n, p)"}
{"task_id": "HumanEval/48", "solution": "import re\n\ndef is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    # Normalize the text by converting to lowercase, removing non-alphanumeric characters,\n    # and stripping all whitespace to perform a case-insensitive, space-agnostic check.\n    normalized_text = text.strip().lower()\n    normalized_text = re.sub(r'[^\\w\\s]', '', normalized_text)\n    normalized_text = re.sub(r'\\s+', '', normalized_text)\n\n    # Compare the normalized string with its reverse.\n    return normalized_text == normalized_text[::-1]"}
