 total_sum = 0\n    s_n = str(N)\n    for digit_char in s_n:\n        total_sum += int(digit_char)\n\n    # Convert sum to binary string\n    if total_sum == 0:\n        return \"0\"\n    \n    binary_digits = []\n    temp_num = total_sum\n    while temp_num > 0:\n        binary_digits.append(str(temp_num % 2))\n        temp_num //= 2\n    \n    return \"\".join(reversed(binary_digits))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/87": [{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds integers x in a 2D list and returns a list of (row, column) coordinates.\n    Coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n    class Coordinate:\n        def __init__(self, row: int, col: int):\n            self.row = row\n            self.col = col\n\n        def __lt__(self, other: 'Coordinate') -> bool:\n            if self.row != other.row:\n                return self.row < other.row\n            # Sort by column in descending order for equal rows\n            return self.col > other.col\n\n        def to_tuple(self) -> tuple[int, int]:\n            return (self.row, self.col)\n\n    class CoordinateFinder:\n        def find_and_sort(self, data: list[list[int]], target: int) -> list[tuple[int, int]]:\n            found_coordinates: list[Coordinate] = []\n            for r_idx, row in enumerate(data):\n                for c_idx, element in enumerate(row):\n                    if element == target:\n                        found_coordinates.append(Coordinate(r_idx, c_idx))\n\n            found_coordinates.sort()\n            return [coord.to_tuple() for coord in found_coordinates]\n\n    finder = CoordinateFinder()\n    return finder.find_and_sort(lst, x)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/24": [{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"