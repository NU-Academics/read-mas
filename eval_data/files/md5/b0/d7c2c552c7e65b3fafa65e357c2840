val/91": [{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    Counts sentences starting with the word \"I\". Sentences are delimited by '.', '?' or '!'.\n    The check for \"I\" is case-sensitive and ignores leading/trailing whitespace.\n    \"\"\"\n    SENTENCE_DELIMITERS = ['.', '?', '!']\n    boredom_count = 0\n\n    # Split the text into parts, keeping delimiters\n    import re\n    parts = re.split(r'([.?!])', S)\n\n    sentences = []\n    current_sentence = \"\"\n    for part in parts:\n        if part in SENTENCE_DELIMITERS:\n            if current_sentence.strip():  # Only add if there's actual content\n                sentences.append((current_sentence + part).strip())\n            current_sentence = \"\"\n        else:\n            current_sentence += part\n\n    if current_sentence.strip():  # Add any remaining part as a sentence\n        sentences.append(current_sentence.strip())\n\n    for sentence in sentences:\n        cleaned_sentence = sentence.strip()\n        # Check if the sentence starts with \"I\" followed by a space or a delimiter\n        if cleaned_sentence.startswith(\"I \") or \\\n           cleaned_sentence.startswith(\"I.\") or \\\n           cleaned_sentence.startswith(\"I?\") or \\\n           cleaned_sentence.startswith(\"I!\"):\n            boredom_count += 1\n            \n    return boredom_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/95": [{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower \n    case or all keys are strings in upper case, else return False.\n    \"\"\"\n    if not dict:\n        return False\n\n    # Filter out only the string keys from the dictionary\n    string_keys = [key for key in dict.keys() if isinstance(key, str)]\n\n    # If there are no string keys, and the dictionary is not empty,\n    # it implies all keys are non-strings, which should result in False.\n    if not string_keys:\n        return False\n\n    # Initialize flags to track if all string keys are lower or upper case\n    all_lower = True\n    all_upper = True\n\n    for key in string_keys:\n        if not key.islower():\n            all_lower = False\n        if not key.isupper():\n            all_upper = False\n\n    # Return True if either all string keys are lowercase OR all are uppercase\n    return all_lower or all_upper", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/97": [{"task_id": "HumanEval/97", "solution": "def multiply(a, b):\n    \"\"\"Complete the function that takes two integers and returns\n    the product of their unit digits.\n    Assume the input is always valid.\n    Examples:\n    multiply(148, 412) should return 16.\n    multiply(19, 28) should return 72.\n    multiply(2020, 1851) should return 0.\n    multiply(14,-15) should return 20.\n    \"\"\"\n    unit_digit_a = abs(a) % 10\n    unit_digit_b = abs(b) % 10\n    return unit_digit_a * unit_digit_b", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/93": [{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping case of letters and replacing vowels.\n    Vowels are replaced by the letter 2 places ahead in the alphabet, maintaining original case before final case swap.\n    \"\"\"\n    VOWELS = \"aeiouAEIOU\"\n    ALPHABET_LOWER = \"abcdefghijklmnopqrstuvwxyz\"\n\n    encoded_chars = []\n    for char in message:\n        processed_char = char\n        if char.isalpha():\n            # Step 1: If it's a vowel, replace it, maintaining original case\n            if char in VOWELS:\n                is_upper = char.isupper()\n                char_lower = char.lower()\n                \n                index = ALPHABET_LOWER.find(char_lower)\n                new_index = (index + 2) % len(ALPHABET_LOWER)\n                replaced_char_lower = ALPHABET_LOWER[new_index]\n                \n                processed_char = replaced_char_lower.upper() if is_upper else replaced_char_lower\n            \n            # Step 2: Swap case of the resulting character\n            processed_char = processed_char.swapcase()\n\n        encoded_chars.append(processed_char)\n    \n    return \"\".join(encoded_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/98": [{"task_id": "HumanEval/98", "solution": "def count_upper(s):\n    \"\"\"\n    Given a string s, count the number of uppercase vowels in even indices.\n    \n    For example:\n    count_upper('aBCdEf') returns 1\n    count_upper('abcdefg') returns 0\n    count_upper('dBBE') returns 0\n    \"\"\"\n    UPPERCASE_VOWELS = {'A', 'E', 'I', 'O', 'U'}\n    count = 0\n    for i in range(0, len(s), 2):\n        if s[i] in UPPERCASE_VOWELS:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/36": [{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    \"\"\"\n    total_sevens_count = 0\n    for i in range(1, n):\n        if (i % 11 == 0) or (i % 13 == 0):\n            total_sevens_count += str(i).count('7')\n    return total_sevens_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/101": [{"task_id": "HumanEval/101", "solution": "import re\ndef words_string(s):\n    \"\"\"\n    Splits a string of words separated by commas or spaces into an array of words.\n    Filters out any empty strings resulting from multiple, leading, or trailing delimiters.\n    \"\"\"\n    # Use regular expression to split by one or more commas or spaces,\n    # then filter out any empty strings fro