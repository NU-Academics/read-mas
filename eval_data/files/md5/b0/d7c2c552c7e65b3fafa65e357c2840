eturn txt.split(',')\n    else:\n        return _count_odd_ordered_lowercase(txt)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/128": [{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes of integers multiplied by the product of all signs.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    sign_product = 1\n    magnitude_sum = 0\n    has_zero = False\n\n    for num in arr:\n        magnitude_sum += abs(num)\n        \n        if num == 0:\n            has_zero = True\n        elif num < 0:\n            sign_product *= -1\n            \n    if has_zero:\n        sign_product = 0\n        \n    return sign_product * magnitude_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/119": [{"task_id": "HumanEval/119", "solution": "class BalanceChecker:\n    def get_balance_info(self, s: str) -> tuple[int, int]:\n        \"\"\"\n        Calculates the minimum balance and final balance of a parentheses string.\n        Balance increases for '(' and decreases for ')'.\n        \"\"\"\n        current_balance = 0\n        min_balance = 0\n        for char in s:\n            if char == '(':\n                current_balance += 1\n            elif char == ')':\n                current_balance -= 1\n            min_balance = min(min_balance, current_balance)\n        return min_balance, current_balance\n\n    def is_balanced(self, s: str) -> bool:\n        \"\"\"\n        Checks if a given parentheses string is balanced.\n        \"\"\"\n        min_balance, final_balance = self.get_balance_info(s)\n        return min_balance >= 0 and final_balance == 0\nclass ParenthesesMatcherService:\n    def __init__(self, balance_checker: BalanceChecker):\n        self._balance_checker = balance_checker\n\n    def can_form_balanced_string(self, strings: list[str]) -> bool:\