    Negative numbers are sorted purely by decimal value and appear first.\n    \"\"\"\n\n    def count_set_bits(n: int) -> int:\n        \"\"\"Counts the number of '1's in the binary representation of a non-negative integer.\"\"\"\n        count = 0\n        while n > 0:\n            n &= (n - 1)  # Brian Kernighan's algorithm\n            count += 1\n        return count\n\n    def _custom_sort_key(num: int) -> tuple[int, int]:\n        \"\"\"Generates a sorting key (primary, secondary) for an integer based on the problem's rules.\"\"\"\n        if num < 0:\n            # Negative numbers are grouped first and sorted purely by their decimal value.\n            # A primary key of -1 ensures they come before any bit counts (which start at 0).\n            return (-1, num)\n        else:\n            # Non-negative numbers are sorted by bit count, then by decimal value.\n            return (count_set_bits(num), num)\n\n    if not arr:\n        return []\n\n    return sorted(arr, key=_custom_sort_key)", "base_status": "fail", "plus_status": "pass", "base_fail_tests": [[[-2, -3, -4, -5, -6]]], "plus_fail_tests": []}], "HumanEval/124": [{"task_id": "HumanEval/124", "solution": "DAYS_IN_MONTH = {\n    1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n    4: 30, 6: 30, 9: 30, 11: 30,\n    2: 29\n}\ndef valid_date(date):\n    \"\"\"Validates a given date string according to specific rules and returns True if valid, False otherwise.\"\"\"\n    if not date:\n        return False\n\n    parts = date.split('-')\n    if len(parts) != 3:\n        return False\n\n    # Enforce mm-dd-yyyy length constraints for each part\n    if not (len(parts[0]) == 2 and len(parts[1]) == 2 and len(parts[2]) == 4):\n        return False\n\n    try:\n        month = int(parts[0])\n        day = int(parts[1])\n        # year is parsed but not further validated for range or leap year rules beyond '29' for February\n        year = int(parts[2]) \n    except ValueError:\n        return False\n\n    if not (1 <= month <= 12):\n        return False\n\n    if not (1 <= day):\n        return False\n\n    max_days = DAYS_IN_MONTH.get(month)\n    if max_days is None:\n        return False # Should not happen if month is already validated\n\n    if not (day <= max_days):\n        return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/118": [{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel surrounded by two consonants from the right side of the word, excluding word boundaries.\"\"\"\n    \n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def is_vowel(char):\n        return char.lower() in VOWELS\n\n    def is_consonant(char):\n        return char.isalpha() and not is_vowel(char)\n\n    if len(word) < 3:\n        return \"\"\n\n    # Iterate from right to left, excluding the first and last characters (indices 0 and len-1)\n    # The loop range goes from len(word) - 2 down to 1 (inclusive).\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i-1]\n        right_char = word[i+1]\n\n        if (is_consonant(left_char) and\n                is_vowel(current_char) and\n                is_consonant(right_char)):\n            return current_char\n            \n    return \"\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/126": [{"task_id": "HumanEval/126", "solution": "from collections import Counter\ndef is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n\n    Examples\n    is_sorted([5]) \u279e True\n    is_sorted([1, 2, 3, 4, 5]) \u279e True\n    is_sorted([1, 3, 2, 4, 5]) \u279e False\n    is_sorted([1, 2, 3, 4, 5, 6]) \u279e True\n    is_sorted([