{"task_id": "HumanEval/64", "solution": "class Word:\n    def __init__(self, text: str):\n        self._text = text\n\n    def get_text(self) -> str:\n        return self._text\n\n    def get_length(self) -> int:\n        return len(self._text)\n\n    def get_char(self, index: int) -> str:\n        return self._text[index]\n\n    def is_end_of_word(self, index: int) -> bool:\n        return index == len(self._text) - 1\n\n\nclass VowelRule:\n    def is_standard_vowel(self, char_val: str) -> bool:\n        \"\"\"Checks if a character is a standard vowel (a, e, i, o, u) case-insensitively.\"\"\"\n        return char_val.lower() in ('a', 'e', 'i', 'o', 'u')\n\n    def is_conditional_y_vowel(self, char_val: str, is_end_of_word: bool) -> bool:\n        \"\"\"Checks if 'y' is a vowel when it's the last character of the word.\"\"\"\n        return char_val.lower() == 'y' and is_end_of_word\n\n\nclass VowelCounter:\n    def __init__(self, vowel_rule: VowelRule):\n        self._vowel_rule = vowel_rule\n\n    def count_vowels(self, word: Word) -> int:\n        \"\"\"Counts vowels in a Word object using the provided VowelRule.\"\"\"\n        total_vowels = 0\n        for i in range(word.get_length()):\n            char = word.get_char(i)\n\n            is_vowel = self._vowel_rule.is_standard_vowel(char)\n\n            if not is_vowel:\n                is_end = word.is_end_of_word(i)\n                is_vowel = self._vowel_rule.is_conditional_y_vowel(char, is_end)\n\n            if is_vowel:\n                total_vowels += 1\n        return total_vowels\n\n\ndef vowels_count(s: str) -> int:\n    \"\"\"Counts vowels in the input string s, including conditional 'y' at the end.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    >>> vowels_count(\"rhythm\")\n    1\n    >>> vowels_count(\"Python\")\n    1\n    >>> vowels_count(\"AEIOU\")\n    5\n    >>> vowels_count(\"xyz\")\n    1\n    >>> vowels_count(\"\")\n    0\n    >>> vowels_count(\"a\")\n    1\n    >>> vowels_count(\"y\")\n    1\n    >>> vowels_count(\"b\")\n    0\n    >>> vowels_count(\"hello world\")\n    3\n    \"\"\"\n    word_obj = Word(s)\n    vowel_rule_obj = VowelRule()\n    counter_obj = VowelCounter(vowel_rule_obj)\n    total_vowels = counter_obj.count_vowels(word_obj)\n    return total_vowels"}
{"task_id": "HumanEval/65", "solution": "```python\ndef _get_number_of_digits(n: int) -> int:\n    \"\"\"Helper to get the number of digits in an integer.\n    Handles the case for n=0 correctly.\n    \"\"\"\n    if n == 0:\n        return 1\n    return len(str(abs(n)))\n\ndef _reverse_digits(s: str) -> str:\n    \"\"\"Helper to reverse the digits of a string.\n    This operation creates a new string with characters in reverse order.\n    \"\"\"\n    return s[::-1]\n\ndef _perform_circular_shift(s: str, shift_amount: int) -> str:\n    \"\"\"Helper to perform a circular right shift on a string.\n    The shift amount is normalized to the string's length.\n    \"\"\"\n    num_digits = len(s)\n    actual_shift = shift_amount % num_digits\n    if actual_shift == 0:\n        return s\n    return s[-actual_shift:] + s[:-actual_shift]\n\ndef circular_shift(x: int, shift: int) -> str:\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    str_x = str(x)\n    num_digits = _get_number_of_digits(x)\n\n    if shift > num_digits:\n        result = _reverse_digits(str_x)\n    else:\n        result = _perform_circular_shift(str_x, shift)\n\n    return result\n```"}
{"task_id": "HumanEval/66", "solution": "```python\ndef digitSum(s):\n    \"\"\"Calculates the sum of ASCII codes for all uppercase characters in a string.\n    Returns 0 if the string is empty or contains no uppercase characters.\"\"\"\n    total_sum = 0\n    if not s:\n        return 0\n\n    for char in s:\n        if 'A' <= char <= 'Z':  # Check if character is an uppercase letter\n            total_sum += ord(char)\n\n    return total_sum\n```"}
{"task_id": "HumanEval/67", "solution": "```python\ndef fruit_distribution(s, n):\n    \"\"\"\n    In this task, you will be given a string that represents a number of apples and oranges\n    that are distributed in a basket of fruit this basket contains\n    apples, oranges, and mango fruits. Given the string that represents the total number of\n    the oranges and apples and an integer that represent the total number of the fruits\n    in the basket return the number of the mango fruits in the basket.\n    \"\"\"\n\n    def _parse_fruit_counts(s_input):\n        \"\"\"Parses the input string to extract the number of apples and oranges.\"\"\"\n        # Split the string to separate apples and oranges counts\n        parts = s_input.split(\" apples and \")\n\n        apples_str = parts[0]\n        # Remove \" oranges\" suffix from the second part to get the orange count\n        oranges_str = parts[1].replace(\" oranges\", \"\")\n\n        apples = int(apples_str)\n        oranges = int(oranges_str)\n        return apples, oranges\n\n    # Extract apple and orange counts using the helper function\n    apples_count, oranges_count = _parse_fruit_counts(s)\n\n    # Calculate the sum of known fruits\n    sum_known_fruits = apples_count + oranges_count\n\n    # Calculate the number of mango fruits\n    mango_count = n - sum_known_fruits\n\n    return mango_count\n```"}
{"task_id": "HumanEval/67", "solution": "def _parse_fruit_count(s: str, fruit_name: str) -> int:\n    \"\"\"\n    Parses the input string to extract the numerical count for a specific fruit.\n    It expects the number to precede the fruit_name in the string.\n    \"\"\"\n    parts = s.split()\n    try:\n        fruit_index = parts.index(fruit_name)\n        count_str = parts[fruit_index - 1]\n        return int(count_str)\n    except ValueError:\n        # According to constraints, trust caller's inputs and implement direct logic.\n        # This branch should ideally not be hit with valid inputs as per design.\n        return 0\n\n\ndef fruit_distribution(s: str, n: int) -> int:\n    \"\"\"\n    Calculates the number of mango fruits in a basket.\n    It subtracts the counts of apples and oranges from the total number of fruits.\n    \"\"\"\n    apples_count = _parse_fruit_count(s, \"apples\")\n    oranges_count = _parse_fruit_count(s, \"oranges\")\n\n    mango_count = n - apples_count - oranges_count\n    return mango_count"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even node with the smallest index in an array.\n    Returns [value, index] or [] if no even values or array is empty.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the current value is even\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n            elif value == smallest_even_value:\n                # Resolve ties by prioritizing the smallest index\n                if index < smallest_even_index:\n                    smallest_even_index = index\n\n    # If smallest_even_index is still -1, no even values were found\n    if smallest_even_index == -1:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list) -> list:\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n    \"\"\"\n    # Convert lists to sets for efficient intersection and uniqueness.\n    set1 = set(l1)\n    set2 = set(l2)\n\n    # Find common elements using set intersection.\n    common_elements_set = set1 & set2\n\n    # Convert the resulting set to a list and sort it.\n    common_elements_list = list(common_elements_set)\n    common_elements_list.sort()\n\n    return common_elements_list"}
{"task_id": "HumanEval/68", "solution": "```python\ndef pluck(arr):\n    \"\"\"\n    Finds the smallest even non-negative integer and its first index in an array.\n    Returns [value, index] or an empty list if no even values or an empty array.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for index, number in enumerate(arr):\n        if number % 2 == 0:  # Check if the number is even.\n            if number < smallest_even_value:\n                smallest_even_value = number\n                smallest_even_index = index\n            # If number is equal to smallest_even_value, we ignore it to maintain the first occurrence index.\n\n    if smallest_even_index == -1:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]\n```"}
{"task_id": "HumanEval/70", "solution": "```python\ndef strange_sort_list(lst: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of integers into a strange order by alternately selecting\n    the minimum and maximum values from the remaining elements.\n    \"\"\"\n    mutable_lst = list(lst)  # Create a mutable copy of the input list.\n    result_lst = []          # Initialize an empty list for the sorted elements.\n\n    if not mutable_lst:\n        return []\n\n    is_min_turn = True  # Flag to alternate between picking the minimum and maximum.\n\n    while mutable_lst:\n        if is_min_turn:\n            current_val = min(mutable_lst) # Find the minimum value in the current list.\n        else:\n            current_val = max(mutable_lst) # Find the maximum value in the current list.\n\n        result_lst.append(current_val)\n        mutable_lst.remove(current_val) # Remove the first occurrence of the value.\n        is_min_turn = not is_min_turn   # Toggle the turn for the next iteration.\n\n    return result_lst\n```"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    '''\n    Finds the greatest positive integer whose frequency is greater than or equal to its value.\n    Returns -1 if no such integer exists.\n    '''\n    frequencies = {}\n    # Count the occurrences of each integer in the input list.\n    for num in lst:\n        frequencies[num] = frequencies.get(num, 0) + 1\n\n    qualifying_integers = []\n    # Iterate through unique integers and their frequencies to find qualifying ones.\n    for value, frequency in frequencies.items():\n        # Criteria: value > 0 and frequency >= value. (value > 0 is guaranteed by input spec).\n        if frequency >= value:\n            qualifying_integers.append(value)\n\n    if qualifying_integers:\n        # Return the maximum among the qualifying integers.\n        return max(qualifying_integers)\n    else:\n        # If no integers meet the criteria, return -1.\n        return -1"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than\n    zero, and has a frequency greater than or equal to the value of the integer itself.\n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    import collections\n\n    def _calculate_frequencies(lst):\n        \"\"\"Calculates the frequency of each unique integer in the input list.\n        Returns a dictionary mapping integers to their counts.\n        \"\"\"\n        return collections.Counter(lst)\n\n    def _identify_qualifying_integers(frequencies):\n        \"\"\"Filters integers based on the condition: value > 0 AND frequency >= value.\n        Returns a list of integers that meet the criteria.\n        \"\"\"\n        qualifying = []\n        for value, frequency in frequencies.items():\n            if value > 0 and frequency >= value:\n                qualifying.append(value)\n        return qualifying\n\n    def _determine_result(qualifying_integers):\n        \"\"\"Determines the final result, returning the greatest qualifying integer or -1.\n        If the list is empty, -1 is returned.\n        \"\"\"\n        if not qualifying_integers:\n            return -1\n        return max(qualifying_integers)\n\n    frequencies = _calculate_frequencies(lst)\n    qualifying_integers = _identify_qualifying_integers(frequencies)\n    result = _determine_result(qualifying_integers)\n    return result"}
{"task_id": "HumanEval/71", "solution": "```python\nimport math\n\ndef triangle_area(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Calculates the area of a triangle given its three side lengths.\n    Returns the area rounded to 2 decimal points, or -1 if invalid.\n    \"\"\"\n\n    def _is_valid_triangle_sides(side1: float, side2: float, side3: float) -> bool:\n        \"\"\"\n        Checks if three side lengths are positive and satisfy the triangle inequality.\n        Ensures sides can form a geometrically valid triangle.\n        \"\"\"\n        if side1 <= 0 or side2 <= 0 or side3 <= 0:\n            return False\n        return (side1 + side2 > side3) and \\\n               (side1 + side3 > side2) and \\\n               (side2 + side3 > side1)\n\n    def _calculate_herons_area(side1: float, side2: float, side3: float) -> float:\n        \"\"\"\n        Calculates the area using Heron's formula for a valid triangle.\n        The function assumes that the input sides form a valid triangle.\n        \"\"\"\n        s = (side1 + side2 + side3) / 2\n        # Use max(0.0, ...) to prevent math domain error from tiny negative due to float precision.\n        area_squared_term = s * (s - side1) * (s - side2) * (s - side3)\n        return math.sqrt(max(0.0, area_squared_term))\n\n    def _round_to_two_decimals(area_val: float) -> float:\n        \"\"\"\n        Rounds a given float value to exactly two decimal places.\n        This uses Python's built-in `round()` function.\n        \"\"\"\n        return round(area_val, 2)\n\n    if not _is_valid_triangle_sides(a, b, c):\n        return -1.0\n\n    raw_area = _calculate_herons_area(a, b, c)\n    return _round_to_two_decimals(raw_area)\n```\n"}
{"task_id": "HumanEval/70", "solution": "```python\ndef strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n\n    Examples:\n    strange_sort_list([1, 2, 3, 4]) == [1, 4, 2, 3]\n    strange_sort_list([5, 5, 5, 5]) == [5, 5, 5, 5]\n    strange_sort_list([]) == []\n    '''\n    if not lst:\n        return []\n\n    result = []\n    # Create a mutable copy of the input list.\n    mutable_lst = list(lst)\n    is_min_turn = True\n\n    while mutable_lst:\n        if is_min_turn:\n            # Find and remove the minimum element.\n            current_val = min(mutable_lst)\n            mutable_lst.remove(current_val)\n        else:\n            # Find and remove the maximum element.\n            current_val = max(mutable_lst)\n            mutable_lst.remove(current_val)\n\n        result.append(current_val)\n        # Toggle the turn for the next iteration.\n        is_min_turn = not is_min_turn\n\n    return result\n```"}
{"task_id": "HumanEval/72", "solution": "```python\ndef will_it_fly(q,w):\n    \"\"\"\n    Determines if an object `q` will fly based on two conditions:\n    It must be a palindrome and its sum must not exceed `w`.\n    \"\"\"\n    is_palindrome = (q == q[::-1])\n    total_weight = sum(q)\n    return is_palindrome and (total_weight <= w)\n```"}
{"task_id": "HumanEval/71", "solution": "```python\nimport math\n\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1\n    '''\n    # Validate triangle: all sides positive and satisfy triangle inequality theorem.\n    if not (a > 0 and b > 0 and c > 0 and \\\n            a + b > c and a + c > b and b + c > a):\n        return -1\n\n    # Calculate area using Heron's formula.\n    s = (a + b + c) / 2\n    area = math.sqrt(s * (s - a) * (s - b) * (s - c))\n\n    return round(area, 2)\n```"}
{"task_id": "HumanEval/73", "solution": "```python\ndef smallest_change(arr):\n    \"\"\"\n    Given an array `arr` of integers, find the minimum changes needed to make it palindromic.\n    It counts mismatches between elements at symmetric positions from the array\\'s ends.\n    \"\"\"\n    changes_count = 0\n    n = len(arr)\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            changes_count += 1\n    return changes_count\n```"}
{"task_id": "HumanEval/72", "solution": "def _is_palindrome(q: list) -> bool:\n    \"\"\"Checks if a list is a palindrome by comparing it to its reverse.\n    Returns True if balanced, False otherwise.\"\"\"\n    return q == q[::-1]\n\ndef _calculate_sum(q: list) -> (int | float):\n    \"\"\"Calculates the sum of all elements in the given list.\n    This helper function determines the total weight.\"\"\"\n    return sum(q)\n\ndef will_it_fly(q: list, w: int) -> bool:\n    \"\"\"Determines if an object `q` will fly based on balance and weight.\n    It flies if balanced (palindrome) AND its sum is less than or equal to `w`.\"\"\"\n    is_balanced = _is_palindrome(q)\n    total_weight = _calculate_sum(q)\n\n    return is_balanced and (total_weight <= w)"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int) -> int:\n    \"\"\"Computes the n-th element of the FibFib number sequence using dynamic programming.\n    It handles base cases and iteratively calculates values to avoid redundant computations.\"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    # Initialize a memoization table (list) to store computed values for n > 2.\n    # Pre-populate base cases as per the sequence definition.\n    memo = [0] * (n + 1)\n    memo[0] = 0\n    memo[1] = 0\n    memo[2] = 1\n\n    # Iteratively calculate fibfib(i) for i from 3 up to n.\n    for i in range(3, n + 1):\n        memo[i] = memo[i-1] + memo[i-2] + memo[i-3]\n\n    return memo[n]"}
{"task_id": "HumanEval/74", "solution": "def _calculate_total_char_count(string_list: list[str]) -> int:\n    \"\"\"Calculates the sum of character counts for all strings in a list.\n    An empty list results in a total count of 0.\"\"\"\n    total_chars = 0\n    for s in string_list:\n        total_chars += len(s)\n    return total_chars\n\ndef total_match(lst1: list[str], lst2: list[str]) -> list[str]:\n    \"\"\"\n    Compares two string lists by their total character counts and returns the one with fewer characters.\n    If the counts are equal, the first list (lst1) is returned.\n    \"\"\"\n    total_chars_lst1 = _calculate_total_char_count(lst1)\n    total_chars_lst2 = _calculate_total_char_count(lst2)\n\n    if total_chars_lst1 <= total_chars_lst2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/73", "solution": "```python\ndef smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic.\n    \"\"\"\n    changes_count = 0\n    left = 0\n    right = len(arr) - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes_count += 1\n        left += 1\n        right -= 1\n\n    return changes_count\n```"}
{"task_id": "HumanEval/75", "solution": "```python\ndef _is_prime(n: int) -> bool:\n    \"\"\"Checks if a given integer n is a prime number.\n    Returns True if n is prime, False otherwise.\"\"\"\n    if n < 2:\n        return False\n    i = 2\n    # Check for factors from 2 up to the square root of n.\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 1\n    return True\n\ndef _get_prime_factors(n: int) -> list[int]:\n    \"\"\"Finds all prime factors of a given integer n, including duplicates.\n    This function utilizes _is_prime to verify primality of potential factors.\"\"\"\n    factors = []\n    temp_n = n\n    if temp_n <= 1:\n        return []\n\n    d = 2\n    # Iterate through potential factors, checking for primality before division.\n    while d <= temp_n:\n        if _is_prime(d):\n            while temp_n % d == 0:\n                factors.append(d)\n                temp_n //= d\n        d += 1\n    return factors\n\ndef is_multiply_prime(a: int) -> bool:\n    \"\"\"Returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\"\"\"\n    prime_factors = _get_prime_factors(a)\n    return len(prime_factors) == 3\n```"}
{"task_id": "HumanEval/74", "solution": "```python\ndef total_match(lst1: list[str], lst2: list[str]) -> list[str]:\n    \"\"\"Compares two lists of strings by their total character count. Returns the list with fewer characters, or the first list in case of a tie.\"\"\"\n    sum_chars_lst1 = 0\n    for s in lst1:\n        sum_chars_lst1 += len(s)\n\n    sum_chars_lst2 = 0\n    for s in lst2:\n        sum_chars_lst2 += len(s)\n\n    if sum_chars_lst1 < sum_chars_lst2:\n        return lst1\n    elif sum_chars_lst2 < sum_chars_lst1:\n        return lst2\n    else:\n        return lst1\n```"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Determines if an integer `a` is a perfect cube.\n    It handles positive, negative, and zero inputs by calculating the integer cube root of `|a|` and then cubing it with the correct sign for comparison.\n    '''\n    # Calculate the integer cube root of the absolute value of a.\n    # We round to the nearest integer and convert to int.\n    root_val = int(round(abs(a)**(1/3)))\n\n    # Apply the correct sign to the root for comparison with the original 'a'.\n    if a < 0:\n        check_val = -root_val\n    else:\n        check_val = root_val\n\n    # Check if the cube of the 'check_val' equals the original 'a'.\n    return check_val * check_val * check_val == a"}
{"task_id": "HumanEval/77", "solution": "```python\ndef iscube(a):\n    \"\"\"\n    Checks if an integer 'a' is a cube of some integer number.\n    Returns True if 'a' is a cube, False otherwise.\n    \"\"\"\n    if a == 0:\n        return True\n\n    # Calculate the cube root and round it to the nearest integer.\n    cbrt = round(a**(1/3))\n\n    # Check if the cubed value of the rounded cube root equals the original number.\n    return cbrt * cbrt * cbrt == a\n```"}
{"task_id": "HumanEval/75", "solution": "```python\ndef _is_prime(n: int) -> bool:\n    \"\"\"Returns True if n is prime, False otherwise.\"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef is_multiply_prime(a: int) -> bool:\n    \"\"\"Returns True if a is a product of exactly three prime numbers, False otherwise.\"\"\"\n    prime_factors = []\n    temp_a = a\n\n    # Handle factor 2\n    while temp_a % 2 == 0:\n        prime_factors.append(2)\n        temp_a //= 2\n\n    # Handle odd factors\n    i = 3\n    while i * i <= temp_a:\n        while temp_a % i == 0:\n            prime_factors.append(i)\n            temp_a //= i\n        i += 2\n\n    # Handle remaining factor (if any)\n    if temp_a > 1:\n        prime_factors.append(temp_a)\n\n    return len(prime_factors) == 3\n```"}
{"task_id": "HumanEval/78", "solution": "```python\ndef hex_key(num):\n    \"\"\"Counts prime hexadecimal digits in a string.\n    Prime hex digits are 2, 3, 5, 7, B (11), D (13).\n    \"\"\"\n    if not num:\n        return 0\n\n    prime_count = 0\n    prime_hex_chars = {'2', '3', '5', '7', 'B', 'D'}\n\n    for char in num:\n        if char in prime_hex_chars:\n            prime_count += 1\n\n    return prime_count\n```"}
{"task_id": "HumanEval/76", "solution": "```python\ndef is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n (n**k = x for non-negative integer k).\n    Handles edge cases for n=0, n=1, n=-1, and x=0, x=1 explicitly before iteration.\n    \"\"\"\n\n    # Handle the case where x is 1. Any non-zero number to the power of 0 is 1.\n    # 0**0 is conventionally 1.\n    if x == 1:\n        return True\n\n    # Handle the case where x is 0.\n    # If n is 0, then 0**k = 0 for any k > 0.\n    # If n is not 0, then n**k (for non-negative k) cannot be 0 unless n itself is 0.\n    if x == 0:\n        return n == 0\n\n    # At this point, x is neither 0 nor 1.\n\n    # Handle n = 0.\n    # Since x is not 0 or 1, and 0**k is either 0 (for k>0) or 1 (for k=0),\n    # n=0 cannot produce any other x.\n    if n == 0:\n        return False\n\n    # Handle n = 1.\n    # Since x is not 1, and 1**k is always 1, n=1 cannot produce any other x.\n    if n == 1:\n        return False\n\n    # Handle n = -1.\n    # Since x is not 1, and (-1)**k is either 1 or -1, n=-1 can only produce -1.\n    if n == -1:\n        return x == -1\n\n    # At this point: x is not 0 or 1. n is not 0, 1, or -1.\n\n    # Initialize current_power to n**0, which is 1.\n    # Using float for current_power for generality with numerical inputs.\n    current_power = 1.0\n\n    while True:\n        # Check if current_power equals x. If so, we found an integer k.\n        if current_power == x:\n            return True\n\n        # Determine if we have overshot, undershot, or will never reach x.\n\n        # If n is positive:\n        if n > 0:\n            if n > 1: # current_power grows positively: 1, n, n*n, ...\n                if current_power > x: # If current_power surpassed x without matching (and x must be positive).\n                    return False\n                if x < 0: # A positive base cannot result in a negative x (for non-negative k).\n                    return False\n            elif 0 < n < 1: # current_power shrinks positively: 1, n, n*n, ...\n                if current_power < x: # If current_power became smaller than x (and x is positive) and continues shrinking.\n                    return False\n                if x < 0: # A positive base cannot result in a negative x.\n                    return False\n        # If n is negative (n < -1 or -1 < n < 0):\n        elif n < 0:\n            # Check for magnitude overshoot (abs(n) > 1) or undershoot (abs(n) < 1).\\n\n            # If current_power's magnitude exceeds x's magnitude (and it's not 0), we overshot.\\n\n            if abs(n) > 1 and abs(current_power) > abs(x):\n                return False\n            # If current_power's magnitude becomes smaller than x's magnitude (and x is not 0), we undershot.\\n\n            elif abs(n) < 1 and abs(current_power) < abs(x):\n                return False\n            # If current_power becomes 0.0 (e.g., due to underflow with very small n) and x is not 0.\\n\n            if current_power == 0.0 and x != 0:\n                return False\n\n        # If no match or termination condition met, calculate the next power.\\n\n        current_power *= n\n\n    # This line should ideally not be reached if termination conditions are exhaustive.\\n\n    # It serves as a failsafe if the loop somehow doesn't terminate explicitly.\\n\n    return False\n```"}
