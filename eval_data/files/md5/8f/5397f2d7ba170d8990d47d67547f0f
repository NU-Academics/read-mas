{"task_id": "HumanEval/36", "solution": "```python\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n\n    def _is_divisible_by_11_or_13(num: int) -> bool:\n        \"\"\"Checks if a number is divisible by 11 or 13.\n        Returns True if divisible by either, False otherwise.\n        \"\"\"\n        return num % 11 == 0 or num % 13 == 0\n\n    def _count_digit_7(num: int) -> int:\n        \"\"\"Counts occurrences of the digit '7' in a number.\n        Converts the number to a string to perform counting.\n        \"\"\"\n        return str(num).count('7')\n\n    if n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    total_count = 0\n    for i in range(1, n):\n        if _is_divisible_by_11_or_13(i):\n            total_count += _count_digit_7(i)\n\n    return total_count\n```"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    Processes the string in groups of three, reversing the cyclic shift for full groups.\n    \"\"\"\n    decoded_parts = []\n    n = len(s)\n    for i in range(0, n, 3):\n        group = s[i : i + 3]\n        if len(group) == 3:\n            # If the group is c2c3c1 (represented as group[0], group[1], group[2]),\n            # it should be transformed back to c1c2c3.\n            # This means: group[2] (c1) + group[0] (c2) + group[1] (c3).\n            decoded_group = group[2] + group[0] + group[1]\n            decoded_parts.append(decoded_group)\n        else:\n            # Groups with fewer than three characters remain unchanged.\n            decoded_parts.append(group)\n    return \"\".join(decoded_parts)"}
{"task_id": "HumanEval/37", "solution": "```python\ndef sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    new_list = list(l)\n    even_elements = []\n\n    for i in range(0, len(l), 2):\n        even_elements.append(l[i])\n\n    even_elements.sort()\n\n    even_elements_iterator = 0\n    for i in range(0, len(new_list), 2):\n        new_list[i] = even_elements[even_elements_iterator]\n        even_elements_iterator += 1\n\n    return new_list\n```"}
{"task_id": "HumanEval/39", "solution": "```python\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n\n    def generate_fibonacci_numbers():\n        \"\"\"Generates an infinite sequence of Fibonacci numbers starting from 0, 1, 1, 2, 3...\"\"\"\n        a, b = 0, 1\n        yield a\n        yield b\n        while True:\n            a, b = b, a + b\n            yield b\n\n    def is_prime(num: int) -> bool:\n        \"\"\"Checks if a number is prime using an optimized trial division method.\"\"\"\n        if num < 2:\n            return False\n        if num == 2 or num == 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    prime_fib_count = 0\n    fib_gen = generate_fibonacci_numbers()\n\n    while True:\n        fib_num = next(fib_gen)\n        # Skip 0 and 1, as they are Fibonacci but not prime\n        if fib_num in (0, 1):\n            continue\n        if is_prime(fib_num):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                return fib_num\n\n```"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[2] + group[0] + group[1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
