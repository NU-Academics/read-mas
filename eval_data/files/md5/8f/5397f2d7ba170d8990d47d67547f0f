{"task_id": "HumanEval/84", "solution": "```python\ndef solve(N):\n    \"\"\"Calculates the sum of digits of N and returns its binary string representation.\n    N is an integer where 0 <= N <= 10000.\n    \"\"\"\n    digit_sum = 0\n    n_str = str(N)\n\n    for digit_char in n_str:\n        digit_sum += int(digit_char)\n\n    binary_sum_with_prefix = bin(digit_sum)\n    final_binary_string = binary_sum_with_prefix[2:]\n\n    return final_binary_string\n```"}
{"task_id": "HumanEval/85", "solution": "```python\ndef add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\n\n\n    Examples:\n        add([4, 2, 6, 7]) ==> 2\n    \"\"\"\n    total_sum = 0\n    # The problem states \"non-empty list\", but the design document includes\n    # graceful handling for an empty list by returning 0.\n    # We will adhere to the prompt's implicit assumption of non-empty.\n    # If the list could be empty and 0 should be returned, an 'if not lst: return 0'\n    # would be added here.\n\n    for index, value in enumerate(lst):\n        # Check if the index is odd and the value is even\n        if index % 2 != 0 and value % 2 == 0:\n            total_sum += value\n    return total_sum\n```"}
{"task_id": "HumanEval/78", "solution": "```python\ndef hex_key(num):\n    \"\"\"Counts prime hexadecimal digits in a given string.\n    Identifies '2', '3', '5', '7', 'B', 'D' as prime digits.\"\"\"\n\n    def _is_prime_hex_digit(char_digit):\n        \"\"\"Checks if a single hexadecimal digit is one of the defined primes.\"\"\"\n        prime_hex_digits = {'2', '3', '5', '7', 'B', 'D'}\n        return char_digit in prime_hex_digits\n\n    if not num:\n        return 0\n\n    count = 0\n    for digit in num:\n        if _is_prime_hex_digit(digit):\n            count += 1\n    return count\n```"}
{"task_id": "HumanEval/86", "solution": "```python\ndef anti_shuffle(s):\n    \"\"\"\n    Returns an ordered version of the input string where characters within each word are sorted.\n    Preserves word order and blank spaces.\n    \"\"\"\n    segments = []\n    current_segment_chars = []\n\n    if not s:\n        return \"\"\n\n    # Determine if the first character starts a word or a space sequence.\n    # This handles initial segments correctly, whether they are words or spaces.\n    is_current_segment_word = (s[0] != ' ')\n\n    for char in s:\n        char_is_space = (char == ' ')\n\n        if is_current_segment_word and char_is_space:\n            # Transition from a word segment to a space segment\n            segments.append(\"\".join(current_segment_chars))\n            current_segment_chars = [char]\n            is_current_segment_word = False\n        elif not is_current_segment_word and not char_is_space:\n            # Transition from a space segment to a word segment\n            segments.append(\"\".join(current_segment_chars))\n            current_segment_chars = [char]\n            is_current_segment_word = True\n        else:\n            # Continue accumulating characters for the current segment type\n            current_segment_chars.append(char)\n\n    # After the loop, add the last accumulated segment\n    if current_segment_chars:\n        segments.append(\"\".join(current_segment_chars))\n\n    # Process each identified segment: sort characters for words, keep spaces as is.\n    processed_parts = []\n    for segment_str in segments:\n        # A segment is a word if its first character is not a space.\n        # An empty segment would not occur with the current parsing logic given `if not s` check.\n        if segment_str and segment_str[0] != ' ':\n            processed_parts.append(\"\".join(sorted(segment_str)))\n        else: # It's a space segment\n            processed_parts.append(segment_str)\n\n    return \"\".join(processed_parts)\n```"}
{"task_id": "HumanEval/86", "solution": "import re\n\ndef anti_shuffle(s):\n    \"\"\"\n    Transforms a string by sorting characters within each word while preserving word and space order.\n    Words are sequences of non-space characters; spaces are kept as is.\n    \"\"\"\n    tokens = re.findall(r'(\\S+|\\s+)', s)\n    result_chunks = []\n    for token in tokens:\n        if token.isspace():\n            result_chunks.append(token)\n        else:\n            result_chunks.append(\"\".join(sorted(token)))\n    return \"\".join(result_chunks)"}
{"task_id": "HumanEval/76", "solution": "```python\ndef is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n (x = n^k for non-negative k).\n    Handles edge cases for x, n, and iteratively checks powers.\n    \"\"\"\n    if x == 1:\n        return True\n\n    if n == 0:\n        return x == 0\n\n    if n == 1:\n        return False\n\n    # If x is negative, it cannot be a simple power under this iterative design.\n    # The loop 'while current_power < x' implies positive x for iteration.\n    if x < 0:\n        return False\n\n    current_power = 1\n\n    while current_power < x:\n        current_power *= n\n\n    return current_power == x\n```"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts an array of non-negative integers, returning a new copy.\n    Sorting order (ascending/descending) depends on the parity of the sum of the first and last elements.\n    \"\"\"\n    if not array:\n        return []\n\n    if len(array) == 1:\n        return array.copy()\n\n    # Determine sorting order based on the sum of the first and last elements of the original array\n    first_element = array[0]\n    last_element = array[-1]\n    sum_first_last = first_element + last_element\n\n    # Create a copy of the array to ensure the original is not modified\n    copied_array = array.copy()\n\n    # Sort based on the sum's parity\n    if sum_first_last % 2 != 0:  # Odd sum: sort in ascending order\n        copied_array.sort(reverse=False)\n    else:  # Even sum: sort in descending order\n        copied_array.sort(reverse=True)\n\n    return copied_array"}
{"task_id": "HumanEval/87", "solution": "```python\ndef get_row(lst: list[list[int]], x: int) -> list[tuple[int, int]]:\n    \"\"\"\n    Finds all occurrences of an integer x in a nested list and returns their 0-indexed coordinates.\n    Coordinates are sorted primarily by row ascending, and secondarily by column descending.\n    \"\"\"\n    if not lst:\n        return []\n\n    found_coordinates = []\n    for row_idx, row in enumerate(lst):\n        for col_idx, element in enumerate(row):\n            if element == x:\n                found_coordinates.append((row_idx, col_idx))\n\n    if not found_coordinates:\n        return []\n\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n    return found_coordinates\n```"}
{"task_id": "HumanEval/87", "solution": "```python\ndef get_row(lst, x):\n    \"\"\"\n    You are given a 2 dimensional data, as a nested lists,\n    which is similar to matrix, however, unlike matrices,\n    each row may contain a different number of columns.\n    Given lst, and integer x, find integers x in the list,\n    and return list of tuples, [(x1, y1), (x2, y2) ...] such that\n    each tuple is a coordinate - (row, columns), starting with 0.\n    Sort coordinates initially by rows in ascending order.\n    Also, sort coordinates of the row by columns in descending order.\n    \"\"\"\n    found_coordinates = []\n    for row_index, row in enumerate(lst):\n        for col_index, element in enumerate(row):\n            if element == x:\n                found_coordinates.append((row_index, col_index))\n\n    # Sort primarily by row ascending, and secondarily by column descending.\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n    return found_coordinates\n```"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts a shallow copy of the array based on the parity of the sum of its first and last elements.\n    If the array has less than two elements, a shallow copy is returned without sorting.\n    \"\"\"\n    if len(array) < 2:\n        return array[:]\n\n    arr_copy = array[:]\n    sum_first_last = arr_copy[0] + arr_copy[-1]\n\n    if sum_first_last % 2 == 1:  # Odd sum, sort ascending\n        arr_copy.sort()\n    else:  # Even sum, sort descending\n        arr_copy.sort(reverse=True)\n\n    return arr_copy"}
{"task_id": "HumanEval/89", "solution": "```python\ndef _is_lowercase_alphabetic(char: str) -> bool:\n    \"\"\"Checks if a character is a lowercase alphabetic letter.\"\"\"\n    return 'a' <= char <= 'z'\n\ndef _shift_lowercase_char(char: str, shift_by: int) -> str:\n    \"\"\"Shifts a lowercase alphabetic character by a given amount, with wrapping.\"\"\"\n    start_ord = ord('a')\n    char_pos = ord(char) - start_ord\n    shifted_pos = (char_pos + shift_by) % 26\n    return chr(start_ord + shifted_pos)\n\ndef encrypt(s: str) -> str:\n    \"\"\"Creates a function encrypt that takes a string and returns an encrypted string.\n    Lowercase alphabetic characters are rotated by four places, others are preserved.\n    \"\"\"\n    encrypted_chars = []\n    shift_amount = 4\n    for char in s:\n        if _is_lowercase_alphabetic(char):\n            encrypted_chars.append(_shift_lowercase_char(char, shift_amount))\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)\n```\n"}
{"task_id": "HumanEval/89", "solution": "```python\ndef encrypt(s):\n    \"\"\"Encrypts a string by rotating each lowercase alphabetic character by a fixed shift of four places.\n    Non-alphabetic characters remain unchanged.\"\"\"\n\n    # Helper function to rotate a single lowercase alphabetic character by the specified shift.\n    def _rotate_char(char_to_rotate, shift_amount):\n        start_ord = ord('a')\n        char_ord = ord(char_to_rotate)\n        shifted_ord = start_ord + (char_ord - start_ord + shift_amount) % 26\n        return chr(shifted_ord)\n\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':  # Check if the character is a lowercase alphabetic letter\n            encrypted_chars.append(_rotate_char(char, 4))\n        else:\n            encrypted_chars.append(char)\n\n    return \"\".join(encrypted_chars)\n```"}
