{"task_id": "HumanEval/140", "solution": "```python\nimport re\n\ndef fix_spaces(text):\n    \"\"\"\n    Replaces sequences of spaces in a string with underscores or hyphens.\n    Sequences of 1 or 2 spaces become underscores; more than 2 become a single hyphen.\n    \"\"\"\n    def replacer(match):\n        length = len(match.group(0))\n        if length <= 2:\n            return '_' * length\n        else:\n            return '-'\n\n    return re.sub(r' +', replacer, text)\n```"}
{"task_id": "HumanEval/140", "solution": "```python\nimport re\n\ndef fix_spaces(text):\n    \"\"\"\n    Transforms text: replaces 3+ consecutive spaces with hyphens,\n    then single spaces (including any remaining from sequences of 2) with underscores.\n    \"\"\"\n    # FR1: Replace sequences of three or more consecutive spaces with a single hyphen.\n    processed_text = re.sub(r' {3,}', '-', text)\n\n    # FR2: Replace any remaining single space characters with an underscore.\n    final_text = processed_text.replace(' ', '_')\n\n    return final_text\n```"}
{"task_id": "HumanEval/142", "solution": "```python\ndef sum_squares(lst):\n    \"\"\"\n    Calculates the sum of list entries after transformation: squares if index is a multiple of 3, cubes if index is a multiple of 4 but not 3, otherwise keeps unchanged.\n    For example: [1,2,3] becomes 6; [] becomes 0; [-1,-5,2,-1,-5] becomes -126.\n    \"\"\"\n    total_sum = 0\n    for index, value in enumerate(lst):\n        if index % 3 == 0:\n            transformed_value = value * value\n        elif index % 4 == 0:\n            transformed_value = value * value * value\n        else:\n            transformed_value = value\n        total_sum += transformed_value\n    return total_sum\n```"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions\n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from\n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n    class _ValidationResult:\n        \"\"\"Encapsulates the outcome of a validation as 'Yes' or 'No'.\"\"\"\n        def __init__(self, status: str):\n            self.status = status\n\n    class _FilePart:\n        \"\"\"Abstract base class for file name components.\"\"\"\n        def __init__(self, content: str):\n            self.content = content\n\n    class _BaseName(_FilePart):\n        \"\"\"Represents the base name part of a file name.\"\"\"\n        def is_empty(self) -> bool:\n            \"\"\"Checks if the base name is empty.\"\"\"\n            return not self.content\n\n        def starts_with_letter(self) -> bool:\n            \"\"\"Checks if the base name starts with a Latin alphabet letter.\"\"\"\n            return bool(self.content and self.content[0].isalpha())\n\n    class _Extension(_FilePart):\n        \"\"\"Represents the extension part of a file name.\"\"\"\n        def is_valid(self) -> bool:\n            \"\"\"Checks if the extension is one of the allowed types.\"\"\"\n            return self.content in ['txt', 'exe', 'dll']\n\n    class _DigitCount:\n        \"\"\"Counts digits in a string and checks against a limit.\"\"\"\n        def __init__(self, name_string: str):\n            self.count = sum(1 for char in name_string if char.isdigit())\n\n        def is_within_limit(self, limit: int) -> bool:\n            \"\"\"Determines if the digit count is within the specified limit.\"\"\"\n            return self.count <= limit\n\n    class _DotCount:\n        \"\"\"Counts dots in a string and checks if it's exactly one.\"\"\"\n        def __init__(self, name_string: str):\n            self.count = name_string.count('.')\n\n        def is_exactly_one(self) -> bool:\n            \"\"\"Checks if the dot count is exactly one.\"\"\"\n            return self.count == 1\n\n    class _FileName:\n        \"\"\"Manages the validation of a file name string.\"\"\"\n        def __init__(self, name_string: str):\n            self._name_string = name_string\n            self._digit_count = _DigitCount(name_string)\n            self._dot_count = _DotCount(name_string)\n            self._base_name = None\n            self._extension = None\n\n        def validate(self) -> _ValidationResult:\n            \"\"\"Orchestrates all validation checks for the file name.\"\"\"\n            if not self._dot_count.is_exactly_one():\n                return _ValidationResult('No')\n\n            parts = self._name_string.split('.', 1)\n            self._base_name = _BaseName(parts[0])\n            self._extension = _Extension(parts[1])\n\n            if not self._digit_count.is_within_limit(3):\n                return _ValidationResult('No')\n            if self._base_name.is_empty():\n                return _ValidationResult('No')\n            if not self._base_name.starts_with_letter():\n                return _ValidationResult('No')\n            if not self._extension.is_valid():\n                return _ValidationResult('No')\n\n            return _ValidationResult('Yes')\n\n    file_validator = _FileName(file_name)\n    result = file_validator.validate()\n    return result.status"}
{"task_id": "HumanEval/143", "solution": "```python\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Filters words in a sentence, keeping only those with prime lengths.\n    Words maintain their original order and are space-separated in the output.\n    \"\"\"\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"Determines if a given integer is a prime number.\"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    words = sentence.split(' ')\n    # Filter out any empty strings that might result from multiple spaces or leading/trailing spaces\n    non_empty_words = [word for word in words if word]\n\n    filtered_words = [word for word in non_empty_words if _is_prime(len(word))]\n\n    return \" \".join(filtered_words)\n```"}
{"task_id": "HumanEval/144", "solution": "```python\nclass Fraction:\n    \"\"\"Represents a fraction with a numerator and a denominator.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        self.numerator = numerator\n        self.denominator = denominator\n\n    @classmethod\n    def from_string(cls, fraction_str: str) -> 'Fraction':\n        \"\"\"Parses a string like 'num/den' into a Fraction object.\"\"\"\n        num_str, den_str = fraction_str.split('/')\n        return cls(int(num_str), int(den_str))\n\n    def multiply(self, other: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another fraction.\"\"\"\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Checks if the fraction represents a whole number.\"\"\"\n        return self.numerator % self.denominator == 0\n\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"Determines if the product of two fractions, x and n, is a whole number.\"\"\"\n    fraction1 = Fraction.from_string(x)\n    fraction2 = Fraction.from_string(n)\n    product_fraction = fraction1.multiply(fraction2)\n    return product_fraction.is_whole_number()\n```"}
{"task_id": "HumanEval/144", "solution": "```python\ndef parse_fraction(fraction_str: str) -> tuple[int, int]:\n    \"\"\"Parses a fraction string into its integer numerator and denominator.\n    It splits the string by '/' and converts parts to integers.\n    \"\"\"\n    numerator_str, denominator_str = fraction_str.split('/')\n    numerator = int(numerator_str)\n    denominator = int(denominator_str)\n    return (numerator, denominator)\n\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"Determines if the product of two fractions x and n is a whole number.\n    It parses fraction strings, calculates their product, and checks for whole number result.\n    \"\"\"\n    x_num, x_den = parse_fraction(x)\n    n_num, n_den = parse_fraction(n)\n\n    product_num = x_num * n_num\n    product_den = x_den * n_den\n\n    return product_num % product_den == 0\n```\n"}
{"task_id": "HumanEval/134", "solution": "```python\ndef check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Determines if the last character of a string is an isolated alphabetical character.\n    An isolated letter is one that is either the only character or preceded by a space.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n\n    # If the last character is alphabetical and the string has more than one character,\n    # check the character preceding it.\n    second_to_last_char = txt[-2]\n\n    return second_to_last_char.isspace()\n```"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers based on the sum of their digits.\n    Ties are broken by the original index.\n    \"\"\"\n    if not nums:\n        return []\n\n    def _calculate_digit_sum(n):\n        \"\"\"Calculates the sum of digits for an integer using its absolute value.\"\"\"\n        s = 0\n        n_abs = abs(n)\n        # Handle the case of 0 explicitly, as the loop won't run.\n        if n_abs == 0:\n            return 0\n        while n_abs > 0:\n            s += n_abs % 10\n            n_abs //= 10\n        return s\n\n    # Store (digit_sum, original_index, original_value) tuples for sorting.\n    sortable_items = []\n    for index, value in enumerate(nums):\n        digit_sum = _calculate_digit_sum(value)\n        sortable_items.append((digit_sum, index, value))\n\n    # Sort the items; Python's tuple sorting handles primary and secondary keys naturally.\n    sortable_items.sort()\n\n    # Extract the original values from the sorted list of tuples.\n    result = [item[2] for item in sortable_items]\n\n    return result"}
{"task_id": "HumanEval/146", "solution": "```python\ndef specialFilter(nums):\n    \"\"\"\n    Counts numbers in an array that are greater than 10 and have both\n    an odd first digit and an odd last digit.\n    \"\"\"\n    count = 0\n\n    def is_odd(digit):\n        # Checks if a given digit is odd.\n        return digit % 2 != 0\n\n    def get_first_digit(number):\n        # Extracts the first digit of a number, considering its absolute value.\n        return int(str(abs(number))[0])\n\n    def get_last_digit(number):\n        # Extracts the last digit of a number, considering its absolute value.\n        return abs(number) % 10\n\n    for num in nums:\n        if num > 10:\n            first_digit = get_first_digit(num)\n            last_digit = get_last_digit(num)\n\n            if is_odd(first_digit) and is_odd(last_digit):\n                count += 1\n    return count\n```"}
{"task_id": "HumanEval/146", "solution": "```python\ndef specialFilter(nums):\n    \"\"\"Counts numbers in an array that are greater than 10,\n    and have both odd first and last digits.\n    \"\"\"\n\n    def _is_greater_than_ten(num: int) -> bool:\n        \"\"\"Checks if a number is strictly greater than 10.\"\"\"\n        return num > 10\n\n    def _has_odd_first_digit(num: int) -> bool:\n        \"\"\"Checks if the first digit of a number is odd.\"\"\"\n        s_num = str(abs(num))\n        first_digit = int(s_num[0])\n        return first_digit % 2 != 0\n\n    def _has_odd_last_digit(num: int) -> bool:\n        \"\"\"Checks if the last digit of a number is odd.\"\"\"\n        s_num = str(abs(num))\n        last_digit = int(s_num[-1])\n        return last_digit % 2 != 0\n\n    count = 0\n    for num in nums:\n        if _is_greater_than_ten(num) and \\\n           _has_odd_first_digit(num) and \\\n           _has_odd_last_digit(num):\n            count += 1\n    return count\n```\n"}
{"task_id": "HumanEval/145", "solution": "```python\ndef _calculate_sum_of_digits(n: int) -> int:\n    \"\"\"Calculates the sum of digits for an integer, using its absolute value for negative numbers.\"\"\"\n    abs_n = abs(n)\n    sum_val = 0\n    for digit_char in str(abs_n):\n        sum_val += int(digit_char)\n    return sum_val\n\ndef order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"Sorts a list of integers by the sum of their digits, then by original index.\"\"\"\n    if not nums:\n        return []\n\n    decorated_nums = []\n    for original_index, num in enumerate(nums):\n        sum_of_digits = _calculate_sum_of_digits(num)\n        decorated_nums.append((sum_of_digits, original_index, num))\n\n    decorated_nums.sort()\n\n    sorted_nums = [item[2] for item in decorated_nums]\n    return sorted_nums\n```"}
{"task_id": "HumanEval/147", "solution": "```python\nclass ArrayElement:\n    \"\"\"Represents an element a[i] and stores its calculated value.\"\"\"\n    def __init__(self, i: int):\n        self.index = i\n        self.value = i * i - i + 1\n\nclass Triple:\n    \"\"\"Represents a combination of three ArrayElements.\n    It can calculate their sum and check if the sum is a multiple of 3.\n    \"\"\"\n    def __init__(self, e1: ArrayElement, e2: ArrayElement, e3: ArrayElement):\n        self.element1 = e1\n        self.element2 = e2\n        self.element3 = e3\n\n    def get_sum(self) -> int:\n        \"\"\"Calculates and returns the sum of the values of the three elements.\"\"\"\n        return self.element1.value + self.element2.value + self.element3.value\n\n    def is_sum_multiple_of_three(self) -> bool:\n        \"\"\"Determines if the sum of the elements is a multiple of 3.\"\"\"\n        return (self.get_sum() % 3) == 0\n\ndef get_max_triples(n: int) -> int:\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from an array 'a'\n    such that i < j < k and their sum is a multiple of 3.\n    \"\"\"\n    array_a = []\n    for i in range(1, n + 1):\n        array_a.append(ArrayElement(i))\n\n    count = 0\n    # Iterate through all unique combinations of three distinct indices i, j, k.\n    # Array indices are 0-based for convenience in loops.\n    for i in range(n - 2):\n        for j in range(i + 1, n - 1):\n            for k in range(j + 1, n):\n                triple = Triple(array_a[i], array_a[j], array_a[k])\n                if triple.is_sum_multiple_of_three():\n                    count += 1\n    return count\n```"}
{"task_id": "HumanEval/142", "solution": "```python\ndef sum_squares(lst: list[int]) -> int:\n    \"\"\"\n    Processes a list of integers, applying transformations based on index, and returns their sum.\n    Indexes that are multiples of 3 are squared; multiples of 4 (but not 3) are cubed.\n    \"\"\"\n    running_total = 0\n    for index, value in enumerate(lst):\n        if index % 3 == 0:\n            running_total += value ** 2\n        elif index % 4 == 0:  # Implies index % 3 != 0 due to previous condition\n            running_total += value ** 3\n        else:\n            running_total += value\n    return running_total\n```"}
{"task_id": "HumanEval/143", "solution": "```python\nimport math\n\ndef _is_prime(n: int) -> bool:\n    \"\"\"Checks if a given integer n is a prime number.\n    It performs the standard primality test up to the square root of n.\"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\n\ndef _validate_sentence(sentence: str) -> bool:\n    \"\"\"Validates if the input sentence adheres to length and character constraints.\n    It checks for length between 1 and 100, and ensures only letters or spaces are present.\"\"\"\n    if not (1 <= len(sentence) <= 100):\n        return False\n    for char in sentence:\n        if not (char.isalpha() or char.isspace()):\n            return False\n    return True\n\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Filters words in a sentence, keeping only those with prime lengths.\n    Maintains original word order and separates results by single spaces.\n    \"\"\"\n    if not _validate_sentence(sentence):\n        return \"\"\n\n    words = sentence.split()\n\n    filtered_words = []\n    for word in words:\n        if _is_prime(len(word)):\n            filtered_words.append(word)\n\n    return \" \".join(filtered_words)\n```"}
{"task_id": "HumanEval/149", "solution": "```python\ndef sorted_list_sum(lst):\n    \"\"\"Filters strings by even length and sorts them.\n    Primary sort is by length, secondary is alphabetical for same-length words.\"\"\"\n    filtered_list = [s for s in lst if len(s) % 2 == 0]\n    filtered_list.sort(key=lambda s: (len(s), s))\n    return filtered_list\n```"}
{"task_id": "HumanEval/148", "solution": "```python\n# Module-level constant: Stores the canonical ordered list of planet names by proximity to the Sun.\n_PLANETS_ORDERED = (\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\")\n\n# Module-level constant: Provides a quick lookup for a planet's index given its name.\n_PLANET_TO_INDEX = {planet: i for i, planet in enumerate(_PLANETS_ORDERED)}\n\ndef _get_planet_index(planet_name: str) -> int | None:\n    \"\"\"Retrieves the numerical order (index) of a given planet name, returning None if invalid.\"\"\"\n    return _PLANET_TO_INDEX.get(planet_name)\n\ndef bf(planet1: str, planet2: str) -> tuple[str, ...]:\n    \"\"\"Finds and returns planets located between two specified planets, sorted by proximity to the Sun.\n    Returns an empty tuple if either planet name is incorrect.\"\"\"\n\n    idx1 = _get_planet_index(planet1)\n    idx2 = _get_planet_index(planet2)\n\n    if idx1 is None or idx2 is None:\n        return ()\n\n    min_idx = min(idx1, idx2)\n    max_idx = max(idx1, idx2)\n\n    # Slice _PLANETS_ORDERED to get planets between min_idx and max_idx (exclusive of boundaries).\n    return _PLANETS_ORDERED[min_idx + 1:max_idx]\n```\n"}
{"task_id": "HumanEval/141", "solution": "```python\nfrom dataclasses import dataclass\n\n@dataclass\nclass FileName:\n    \"\"\"Stores parsed components and properties of a file name.\"\"\"\n    full_name: str\n    digit_count: int = 0\n    dot_count: int = 0\n    prefix: str = \"\"\n    suffix: str = \"\"\n\ndef _count_digits(name: str) -> int:\n    \"\"\"Counts the number of digits in the given string.\"\"\"\n    count = 0\n    for char in name:\n        if '0' <= char <= '9':\n            count += 1\n    return count\n\ndef _check_digit_count_limit(digit_count: int) -> bool:\n    \"\"\"Ensures the digit count does not exceed three.\"\"\"\n    return digit_count <= 3\n\ndef _check_dot_count(name: str) -> int:\n    \"\"\"Counts the number of dots in the given string.\"\"\"\n    return name.count('.')\n\ndef _extract_prefix_suffix(name: str) -> tuple[str, str]:\n    \"\"\"Extracts the prefix and suffix assuming exactly one dot exists.\"\"\"\n    parts = name.split('.', 1)\n    return parts[0], parts[1]\n\ndef _check_empty_prefix(prefix: str) -> bool:\n    \"\"\"Checks if the given prefix is empty.\"\"\"\n    return len(prefix) == 0\n\ndef _validate_prefix_starting_char(prefix: str) -> bool:\n    \"\"\"Validates if the prefix starts with a Latin alphabet letter.\"\"\"\n    first_char = prefix[0]\n    return ('a' <= first_char <= 'z') or ('A' <= first_char <= 'Z')\n\ndef _validate_suffix_type(suffix: str) -> bool:\n    \"\"\"Validates if the suffix is one of the allowed types.\"\"\"\n    allowed_suffixes = ['txt', 'exe', 'dll']\n    return suffix in allowed_suffixes\n\ndef file_name_check(file_name: str) -> str:\n    \"\"\"\n    Validates a file name string against predefined rules.\n    Returns 'Yes' if all conditions are met, 'No' otherwise.\n    \"\"\"\n    file_info = FileName(full_name=file_name)\n\n    file_info.digit_count = _count_digits(file_name)\n    if not _check_digit_count_limit(file_info.digit_count):\n        return 'No'\n\n    file_info.dot_count = _check_dot_count(file_name)\n    if file_info.dot_count != 1:\n        return 'No'\n\n    file_info.prefix, file_info.suffix = _extract_prefix_suffix(file_name)\n\n    if _check_empty_prefix(file_info.prefix):\n        return 'No'\n\n    if not _validate_prefix_starting_char(file_info.prefix):\n        return 'No'\n\n    if not _validate_suffix_type(file_info.suffix):\n        return 'No'\n\n    return 'Yes'\n```\n"}
{"task_id": "HumanEval/148", "solution": "PLANETS_ORDER = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\n\ndef _get_planet_index(planet_name: str) -> int | None:\n    # Retrieves the proximity order (index) of a given planet name.\n    # Returns its 0-based index, or None if the name is invalid.\n    try:\n        return PLANETS_ORDER.index(planet_name)\n    except ValueError:\n        return None\n\ndef bf(planet1: str, planet2: str) -> tuple[str, ...]:\n    '''\n    There are eight planets in our solar system: the closerst to the Sun\n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn,\n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2.\n    The function should return a tuple containing all planets whose orbits are\n    located between the orbit of planet1 and the orbit of planet2, sorted by\n    the proximity to the sun.\n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names.\n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n\n    idx1 = _get_planet_index(planet1)\n    idx2 = _get_planet_index(planet2)\n\n    if idx1 is None or idx2 is None:\n        return ()\n\n    # Determine the slice indices for planets strictly between planet1 and planet2\n    start_idx = min(idx1, idx2) + 1\n    end_idx = max(idx1, idx2)\n\n    intermediate_planets = PLANETS_ORDER[start_idx:end_idx]\n\n    return tuple(intermediate_planets)"}
{"task_id": "HumanEval/149", "solution": "```python\ndef sorted_list_sum(lst):\n    \"\"\"Filters a list of strings, retaining only even-length strings.\n    Then sorts the remaining strings by length and then alphabetically.\"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    sorted_result = sorted(even_length_strings, key=lambda s: (len(s), s))\n    return sorted_result\n```"}
{"task_id": "HumanEval/150", "solution": "def is_prime(n):\n    \"\"\"Determines if an integer n is a prime number.\n    A prime number is a natural number greater than 1 that has no positive divisors other than 1 and itself.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n\n    \"\"\"\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/150", "solution": "```python\ndef is_prime(n: int) -> bool:\n    \"\"\"\n    Determines if n is a prime number based on specific rules.\n    Checks for n <= 1, n == 2, even n > 2, and odd divisors up to the square root of n.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef x_or_y(n: int, x: any, y: any) -> any:\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n\n    \"\"\"\n    if is_prime(n):\n        return x\n    else:\n        return y\n```"}
{"task_id": "HumanEval/151", "solution": "```python\ndef _is_integer(value):\n    \"\"\"Checks if the given value is an integer.\"\"\"\n    return isinstance(value, int)\n\ndef _is_negative(value):\n    \"\"\"Determines if a number is negative.\"\"\"\n    return value < 0\n\ndef _is_odd(value):\n    \"\"\"Checks if an integer is odd.\"\"\"\n    return value % 2 != 0\n\ndef _get_square(value):\n    \"\"\"Calculates the square of a number.\"\"\"\n    return value * value\n\ndef double_the_difference(lst):\n    \"\"\"\n    Calculates the sum of squares of odd, non-negative integers in the list.\n    Ignores non-integer or negative values.\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for element in lst:\n        if not _is_integer(element):\n            continue\n        if _is_negative(element):\n            continue\n        if _is_odd(element):\n            square_value = _get_square(element)\n            total_sum += square_value\n    return total_sum\n```"}
{"task_id": "HumanEval/152", "solution": "```python\ndef compare(game,guess):\n    \"\"\"Calculates the absolute difference between corresponding game scores and player guesses.\n    Returns 0 for correct guesses, otherwise the absolute difference.\n    \"\"\"\n    results = []\n    for g_score, p_guess in zip(game, guess):\n        if g_score == p_guess:\n            results.append(0)\n        else:\n            results.append(abs(g_score - p_guess))\n    return results\n```"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n\n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0\n\n    If the input list is empty, return 0.\n    '''\n    total_sum = 0\n\n    if not lst:\n        return 0\n\n    for num in lst:\n        # Ignore numbers that are not integers (e.g., 3.5) while allowing integer-like floats (e.g., 3.0).\n        # This relies on int() conversion and comparison, as isinstance() is forbidden.\n        if num != int(num):\n            continue\n\n        # Ignore numbers that are negative.\n        if num < 0:\n            continue\n\n        # Check if the non-negative, integer-like number is odd.\n        # We convert to int to ensure correct modulo operation on the integer value.\n        if int(num) % 2 != 0:\n            # Square the identified odd number and add it to the running total.\n            # int_value ensures we're squaring the integer representation.\n            int_value = int(num)\n            total_sum += int_value * int_value\n\n    return total_sum"}
{"task_id": "HumanEval/152", "solution": "```python\ndef compare(game, guess):\n    \"\"\"Compares game scores with player guesses and returns an array of differences.\n    Returns 0 for correct guesses and the absolute difference for incorrect ones.\n    \"\"\"\n    differences = []\n    for i in range(len(game)):\n        game_score = game[i]\n        player_guess = guess[i]\n\n        if game_score == player_guess:\n            differences.append(0)\n        else:\n            differences.append(abs(game_score - player_guess))\n\n    return differences\n```"}
{"task_id": "HumanEval/153", "solution": "```python\ndef Strongest_Extension(class_name: str, extensions: list[str]) -> str:\n    \"\"\"\n    Calculates the strength of extensions and returns the strongest one\n    in the format 'ClassName.StrongestExtensionName'.\n    \"\"\"\n\n    def _calculate_strength(extension_name: str) -> int:\n        \"\"\"\n        Calculates the strength of an extension name (CAP - SM).\n        \"\"\"\n        cap_count = 0\n        sm_count = 0\n        for char in extension_name:\n            if 'A' <= char <= 'Z':\n                cap_count += 1\n            elif 'a' <= char <= 'z':\n                sm_count += 1\n        return cap_count - sm_count\n\n    max_strength = float('-inf')\n    strongest_extension_name = \"\"\n\n    for extension_name in extensions:\n        current_strength = _calculate_strength(extension_name)\n\n        # Update if a stronger extension is found.\n        # Tie-breaking is handled implicitly by only updating on '>'\n        # and keeping the first encountered strongest extension.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension_name\n\n    return f\"{class_name}.{strongest_extension_name}\"\n```"}
{"task_id": "HumanEval/155", "solution": "```python\ndef even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Get absolute value to handle negative numbers\n    abs_num = abs(num)\n\n    # Convert the number to a string to iterate through its digits\n    for digit_char in str(abs_num):\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)\n\n```\n"}
{"task_id": "HumanEval/155", "solution": "```python\ndef even_odd_count(num: int) -> tuple[int, int]:\n    \"\"\"Given an integer, return a tuple containing the count of even and odd digits within its absolute value.\n    For example, even_odd_count(-12) returns (1, 1) and even_odd_count(123) returns (1, 2).\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Convert the absolute number to a string to iterate through its digits.\n    abs_num_str = str(abs(num))\n\n    for digit_char in abs_num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)\n```"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a: str, b: str) -> bool:\n    \"\"\"Checks if any cyclic rotation of b is a substring in a.\n    Generates all unique cyclic rotations of b and checks their presence in a.\n    \"\"\"\n\n    n = len(b)\n\n    # Generate all unique cyclic rotations of b\n    # A set is used to store rotations to automatically handle uniqueness.\n    rotations = set()\n    for i in range(n):\n        rotated_b = b[i:] + b[:i]\n        rotations.add(rotated_b)\n\n    # Check if any of the generated rotations are a substring in a\n    for rotation in rotations:\n        if rotation in a:\n            return True\n\n    return False"}
{"task_id": "HumanEval/147", "solution": "```python\ndef _combinations(n: int, k: int) -> int:\n    \"\"\"Calculates nCk (n choose k) specifically for k=3. Returns 0 if n < k.\"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 3:\n        if n < 3:\n            return 0\n        return n * (n - 1) * (n - 2) // 6\n    return 0 # This case should not be reached with the current usage.\n\ndef _generate_array_a(n: int) -> list[int]:\n    \"\"\"\n    Generates and populates the array `a` where `a[i] = i * i - i + 1` for `i` from 1 to `n`.\n    The array is 0-indexed internally, so `arr[j]` corresponds to `a[j+1]`.\n    \"\"\"\n    arr = [0] * n\n    for i in range(1, n + 1):\n        arr[i - 1] = i * i - i + 1\n    return arr\n\ndef _count_valid_triples(arr: list[int]) -> int:\n    \"\"\"\n    Counts unique triples `(a[i], a[j], a[k])` from `arr` such that their sum is a multiple of 3.\n    It optimizes by counting elements modulo 3 and using combinations.\n    \"\"\"\n    rem_counts = [0, 0, 0]  # Store counts of numbers with remainder 0, 1, 2 modulo 3.\n\n    for x in arr:\n        rem_counts[x % 3] += 1\n\n    count = 0\n    n0 = rem_counts[0] # Count of elements with remainder 0 mod 3.\n    n1 = rem_counts[1] # Count of elements with remainder 1 mod 3.\n    # Note: Elements generated by i*i-i+1 will never have a remainder of 2 mod 3.\n\n    # Count triples where all three elements have remainder 0 mod 3.\n    count += _combinations(n0, 3)\n\n    # Count triples where all three elements have remainder 1 mod 3.\n    count += _combinations(n1, 3)\n\n    # Combinations (0,1,2) or (0,0,1), etc., will not sum to 0 mod 3 with only 0 or 1 remainders.\n    return count\n\ndef get_max_triples(n: int) -> int:\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n\n    Example :\n        Input: n = 5\n        Output: 1\n        Explanation:\n        a = [1, 3, 7, 13, 21]\n        The only valid triple is (1, 7, 13).\n    \"\"\"\n    arr = _generate_array_a(n)\n    return _count_valid_triples(arr)\n\n```\n"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name: str, extensions: list[str]) -> str:\n    \"\"\"Calculates the strength of extensions and identifies the strongest one based on CAP-SM.\\n    Returns a formatted string combining the class name and the strongest extension.\\n    \"\"\"\n    max_strength = float('-inf')\n    strongest_extension = \"\"\n\n    for extension in extensions:\n        CAP = 0\n        SM = 0\n        for char in extension:\n            if char.isupper():\n                CAP += 1\n            elif char.islower():\n                SM += 1\n\n        current_strength = CAP - SM\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension = extension\n\n    return f\"{class_name}.{strongest_extension}\""}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"Checks if b or any of its cyclic rotations is a substring in a.\n    Returns True if found, False otherwise.\"\"\"\n\n    def _is_substring(sub, main):\n        \"\"\"Checks if 'sub' is a substring of 'main'.\"\"\"\n        return sub in main\n\n    def _generate_cyclic_rotations(s):\n        \"\"\"Generates all cyclic rotations of string 's'.\"\"\"\n        rotations = []\n        n = len(s)\n        if n == 0:\n            return rotations\n        for i in range(n):\n            rotated_s = s[i:] + s[:i]\n            rotations.append(rotated_s)\n        return rotations\n\n    # Initial Substring Check (FR3)\n    if _is_substring(b, a):\n        return True # Early Exit on Match (FR5)\n\n    # Cyclic Rotation Generation (FR2)\n    rotations_of_b = _generate_cyclic_rotations(b)\n\n    # Rotations Substring Check (FR4)\n    for rotation in rotations_of_b:\n        if _is_substring(rotation, a):\n            return True # Early Exit on Rotation Match (FR5)\n\n    # No Match Found (FR6)\n    return False```"}
{"task_id": "HumanEval/156", "solution": "```python\ndef int_to_mini_roman(number):\n    \"\"\"\n    Converts a positive integer to its lowercase Roman numeral equivalent.\n    Raises ValueError if the number is outside the range 1 to 1000.\n    \"\"\"\n    if not (1 <= number <= 1000):\n        raise ValueError(\"Number out of range. Must be between 1 and 1000, inclusive.\")\n\n    # Define Roman numeral mappings from largest to smallest values.\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n\n    result = []\n    # Greedily build the Roman numeral string.\n    for value, symbol in roman_map:\n        while number >= value:\n            result.append(symbol)\n            number -= value\n\n    return \"\".join(result).lower()\n```"}
{"task_id": "HumanEval/156", "solution": "_ROMAN_MAP = [\n    (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n    (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n    (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n]\n\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    if not (1 <= number <= 1000):\n        raise ValueError(\"Input number must be between 1 and 1000, inclusive.\")\n\n    roman_num = \"\"\n    for value, numeral in _ROMAN_MAP:\n        while number >= value:\n            roman_num += numeral\n            number -= value\n    return roman_num.lower()"}
{"task_id": "HumanEval/158", "solution": "```python\ndef _get_unique_char_count(word: str) -> int:\n    \"\"\"Calculates the number of unique characters in a given word.\"\"\"\n    return len(set(word))\n\ndef find_max(words: list[str]) -> str:\n    \"\"\"\n    Accepts a list of strings and returns the word with the maximum number of unique characters.\n    If multiple strings have the maximum number of unique characters, returns the one which comes first in lexicographical order.\n    \"\"\"\n    if not words:\n        return \"\"\n    if len(words) == 1:\n        return words[0]\n\n    best_word: str = \"\"\n    max_unique_chars: int = -1\n\n    for word in words:\n        current_unique_chars = _get_unique_char_count(word)\n\n        if current_unique_chars > max_unique_chars:\n            max_unique_chars = current_unique_chars\n            best_word = word\n        elif current_unique_chars == max_unique_chars:\n            if word < best_word:\n                best_word = word\n\n    return best_word\n```"}
{"task_id": "HumanEval/158", "solution": "```python\ndef _calculate_unique_chars(word: str) -> int:\n    \"\"\"Calculates the number of unique characters in a given word.\n    It uses a set to efficiently count unique characters.\"\"\"\n    return len(set(word))\n\ndef find_max(words: list[str]) -> str:\n    \"\"\"Finds the word with the maximum number of unique characters.\n    If multiple words share the maximum, the lexicographically smallest is returned.\"\"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = _calculate_unique_chars(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # If unique counts are equal, choose the lexicographically smaller word.\n            if word < result_word:\n                result_word = word\n\n    return result_word\n```"}
{"task_id": "HumanEval/157", "solution": "```python\ndef _is_positive(a: float, b: float, c: float) -> bool:\n    \"\"\"Checks if all three side lengths are positive.\"\"\"\n    return a > 0 and b > 0 and c > 0\n\ndef _satisfies_triangle_inequality(a: float, b: float, c: float) -> bool:\n    \"\"\"Checks if the triangle inequality holds for the three side lengths.\"\"\"\n    return (a + b > c) and (a + c > b) and (b + c > a)\n\ndef _satisfies_pythagorean_theorem(a: float, b: float, c: float, epsilon: float = 1e-9) -> bool:\n    \"\"\"Checks if the Pythagorean theorem holds for any permutation within epsilon tolerance.\"\"\"\n    # Check (a, b) as legs and c as hypotenuse\n    if abs(a*a + b*b - c*c) < epsilon:\n        return True\n    # Check (a, c) as legs and b as hypotenuse\n    if abs(a*a + c*c - b*b) < epsilon:\n        return True\n    # Check (b, c) as legs and a as hypotenuse\n    if abs(b*b + c*c - a*a) < epsilon:\n        return True\n    return False\n\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    if not _is_positive(a, b, c):\n        return False\n    if not _satisfies_triangle_inequality(a, b, c):\n        return False\n    if not _satisfies_pythagorean_theorem(a, b, c):\n        return False\n    return True\n```"}
{"task_id": "HumanEval/159", "solution": "```python\ndef eat(number, need, remaining):\n    \"\"\"\n    Calculates total carrots eaten and remaining stock after a meal.\n    The rabbit eats the lesser of needed or available carrots.\n    \"\"\"\n    actualEatenCarrots = min(need, remaining)\n    totalEatenCarrots = number + actualEatenCarrots\n    carrotsLeft = remaining - actualEatenCarrots\n    return [totalEatenCarrots, carrotsLeft]\n```"}
{"task_id": "HumanEval/157", "solution": "```python\nimport math\n\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    '''\n    # Check if all sides are positive.\n    if not (a > 0 and b > 0 and c > 0):\n        return False\n\n    # Check the triangle inequality theorem.\n    if not ((a + b > c) and (a + c > b) and (b + c > a)):\n        return False\n\n    # Sort sides to easily identify the potential hypotenuse (longest side).\n    sides = sorted([a, b, c])\n    s1, s2, s3 = sides[0], sides[1], sides[2]\n\n    # Apply the Pythagorean theorem with a small tolerance for floating-point precision.\n    epsilon = 1e-9\n    return math.isclose(s1**2 + s2**2, s3**2, rel_tol=epsilon)\n```"}
{"task_id": "HumanEval/160", "solution": "```python\n_OP_PROPERTIES = {\n    '+': {'precedence': 1, 'associativity': 'left'},\n    '-': {'precedence': 1, 'associativity': 'left'},\n    '*': {'precedence': 2, 'associativity': 'left'},\n    '//': {'precedence': 2, 'associativity': 'left'},\n    '**': {'precedence': 3, 'associativity': 'right'}\n}\n\nclass Operator:\n    \"\"\"Encapsulates properties of an algebraic operator.\"\"\"\n    def __init__(self, symbol: str):\n        self.symbol = symbol\n        props = _OP_PROPERTIES.get(symbol)\n        self.precedence = props['precedence']\n        self.associativity = props['associativity']\n\n    @staticmethod\n    def get_precedence(symbol: str) -> int:\n        \"\"\"Returns the precedence level for a given operator symbol.\"\"\"\n        return _OP_PROPERTIES[symbol]['precedence']\n\n    @staticmethod\n    def get_associativity(symbol: str) -> str:\n        \"\"\"Returns the associativity for a given operator symbol.\"\"\"\n        return _OP_PROPERTIES[symbol]['associativity']\n\nclass Operand:\n    \"\"\"A simple data class to represent an integer operand.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass InputValidator:\n    \"\"\"Validates the input operator and operand lists according to specified rules.\"\"\"\n    def validate_inputs(self, operator_symbols: list[str], operand_values: list[int]):\n        \"\"\"Orchestrates input validation checks, raising ValueError for invalid inputs.\"\"\"\n        self._check_lengths(operator_symbols, operand_values)\n        self._check_operand_types_and_values(operand_values)\n        self._check_operator_support(operator_symbols)\n\n    def _check_lengths(self, op_symbols: list[str], op_values: list[int]):\n        \"\"\"Checks list lengths and minimum counts.\"\"\"\n        if not op_symbols:\n            raise ValueError(\"Operator list must not be empty.\")\n        if len(op_values) < 2:\n            raise ValueError(\"Operand list must contain at least two operands.\")\n        if len(op_symbols) != len(op_values) - 1:\n            raise ValueError(\"Length of operator list must be one less than operand list.\")\n\n    def _check_operand_types_and_values(self, op_values: list[int]):\n        \"\"\"Verifies all operands are non-negative integers.\"\"\"\n        for value in op_values:\n            if not isinstance(value, int) or value < 0:\n                raise ValueError(\"All operands must be non-negative integers.\")\n\n    def _check_operator_support(self, op_symbols: list[str]):\n        \"\"\"Checks if all operator symbols are supported.\"\"\"\n        supported_operators = _OP_PROPERTIES.keys()\n        for symbol in op_symbols:\n            if symbol not in supported_operators:\n                raise ValueError(f\"Unsupported operator '{symbol}' found.\")\n\nclass Expression:\n    \"\"\"Manages the algebraic expression, including conversion to RPN and evaluation.\"\"\"\n    def __init__(self, operator_symbols: list[str], operand_values: list[int]):\n        self.elements = self._build_expression_elements(operator_symbols, operand_values)\n\n    def _build_expression_elements(self, operator_symbols: list[str], operand_values: list[int]) -> list:\n        \"\"\"Constructs the infix expression elements by interleaving operands and operators.\"\"\"\n        expression_elements = []\n        for i in range(len(operand_values)):\n            expression_elements.append(Operand(operand_values[i]))\n            if i < len(operator_symbols):\n                expression_elements.append(Operator(operator_symbols[i]))\n        return expression_elements\n\n    def evaluate(self) -> int:\n        \"\"\"Evaluates the expression by converting it to RPN and then computing the result.\"\"\"\n        rpn_tokens = self._shunting_yard(self.elements)\n        result = self._evaluate_rpn(rpn_tokens)\n        return result\n\n    def _shunting_yard(self, elements: list) -> list:\n        \"\"\"Converts an infix expression (elements) to Reverse Polish Notation (RPN).\"\"\"\n        output_queue = []\n        operator_stack = []\n\n        for token in elements:\n            if isinstance(token, Operand):\n                output_queue.append(token)\n            elif isinstance(token, Operator):\n                while (operator_stack and isinstance(operator_stack[-1], Operator) and\n                       ((token.associativity == 'left' and token.precedence <= operator_stack[-1].precedence) or\n                        (token.associativity == 'right' and token.precedence < operator_stack[-1].precedence))):\n                    output_queue.append(operator_stack.pop())\n                operator_stack.append(token)\n\n        while operator_stack:\n            output_queue.append(operator_stack.pop())\n        return output_queue\n\n    def _evaluate_rpn(self, rpn_tokens: list) -> int:\n        \"\"\"Evaluates an expression in Reverse Polish Notation (RPN) using a stack.\"\"\"\n        operand_stack = []\n        for token in rpn_tokens:\n            if isinstance(token, Operand):\n                operand_stack.append(token.value)\n            elif isinstance(token, Operator):\n                val2 = operand_stack.pop()\n                val1 = operand_stack.pop()\n                result = self._apply_operator(token, val1, val2)\n                operand_stack.append(result)\n        return operand_stack[0]\n\n    def _apply_operator(self, op: Operator, val1: int, val2: int) -> int:\n        \"\"\"Applies a given operator to two integer operands and returns the result.\"\"\"\n        if op.symbol == '+':\n            return val1 + val2\n        elif op.symbol == '-':\n            return val1 - val2\n        elif op.symbol == '*':\n            return val1 * val2\n        elif op.symbol == '//':\n            if val2 == 0:\n                raise ValueError(\"Cannot perform floor division by zero.\")\n            return val1 // val2\n        elif op.symbol == '**':\n            return val1 ** val2\n        # No default else needed as operators are validated by InputValidator\n\ndef do_algebra(operator: list[str], operand: list[int]) -> int:\n    \"\"\"\n    Evaluates an algebraic expression constructed from the provided operators and operands.\n    This function validates inputs, builds the expression, and computes its numerical result.\n    \"\"\"\n    validator = InputValidator()\n    validator.validate_inputs(operator, operand)\n\n    expression = Expression(operator, operand)\n    result = expression.evaluate()\n    return result\n```\n"}
{"task_id": "HumanEval/162", "solution": "```python\nimport hashlib\n\ndef string_to_md5(text: str) -> str | None:\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    # Encode the string to UTF-8 bytes and compute its MD5 hash.\n    # The hexdigest() method converts the hash to a lowercase hexadecimal string.\n    md5_hash = hashlib.md5(text.encode('utf-8')).hexdigest()\n    return md5_hash\n```"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Evaluates an algebraic expression constructed from lists of operators and operands.\n    Ensures input lists conform to specified length and operator validity rules.\n    \"\"\"\n\n    def _validate_inputs(ops, ops_list):\n        \"\"\"Validates the input lists for length and operator type.\"\"\"\n        if len(ops) != len(ops_list) - 1:\n            raise ValueError(\"Operator list length must be one less than operand list length.\")\n        if len(ops) < 1 or len(ops_list) < 2:\n            raise ValueError(\"Operator list must have at least one operator, operand list at least two operands.\")\n\n        supported_operators = {'+', '-', '*', '//', '**'}\n        for op in ops:\n            if op not in supported_operators:\n                raise ValueError(f\"Unsupported operator found: {op}. Supported operators are {', '.join(sorted(list(supported_operators)))}.\")\n\n    def _construct_expression_string(ops, ops_list):\n        \"\"\"Constructs the algebraic expression string by interleaving operands and operators.\"\"\"\n        expression_parts = []\n        for i in range(len(ops_list)):\n            expression_parts.append(str(ops_list[i]))\n            if i < len(ops):\n                expression_parts.append(ops[i])\n        return \" \".join(expression_parts)\n\n    def _evaluate_expression_string(expression_string):\n        \"\"\"Evaluates a given algebraic expression string using Python's eval().\"\"\"\n        return int(eval(expression_string))\n\n    _validate_inputs(operator, operand)\n    expression = _construct_expression_string(operator, operand)\n    result = _evaluate_expression_string(expression)\n    return result"}
{"task_id": "HumanEval/161", "solution": "```python\ndef _has_alphabetic_chars(s: str) -> bool:\n    \"\"\"Checks if the string contains any alphabetic characters.\"\"\"\n    for char in s:\n        if char.isalpha():\n            return True\n    return False\n\ndef _process_string_with_letters(s: str) -> str:\n    \"\"\"Processes a string by flipping the case of alphabetic characters.\"\"\"\n    processed_chars = []\n    for char in s:\n        if char.isalpha():\n            if char.islower():\n                processed_chars.append(char.upper())\n            else:\n                processed_chars.append(char.lower())\n        else:\n            processed_chars.append(char)\n    return \"\".join(processed_chars)\n\ndef _reverse_string(s: str) -> str:\n    \"\"\"Reverses the entire input string.\"\"\"\n    return s[::-1]\n\ndef solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa,\n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n    if _has_alphabetic_chars(s):\n        return _process_string_with_letters(s)\n    else:\n        return _reverse_string(s)\n```\n"}
{"task_id": "HumanEval/162", "solution": "import hashlib\n\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n\n    >>> string_to_md5('Hello world') == '3e25960a79dbc69b674cd4ec67a72c62'\n    \"\"\"\n    if not text:\n        return None\n    else:\n        # Encode the text and compute its MD5 hash.\n        encoded_text = text.encode('utf-8')\n        hasher = hashlib.md5()\n        hasher.update(encoded_text)\n        return hasher.hexdigest()"}
{"task_id": "HumanEval/159", "solution": "```python\ndef eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten and remaining after a meal.\n    Returns a list: [total_eaten_carrots, carrots_left_in_stock].\n    \"\"\"\n    actual_carrots_consumed = min(need, remaining)\n    total_eaten_carrots = number + actual_carrots_consumed\n    carrots_left_in_stock = remaining - actual_carrots_consumed\n    return [total_eaten_carrots, carrots_left_in_stock]\n```"}
{"task_id": "HumanEval/163", "solution": "```python\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a and b,\n    in ascending order.\n    \"\"\"\n    even_digits_set = {0, 2, 4, 6, 8}\n\n    start = min(a, b)\n    end = max(a, b)\n\n    found_even_digits = []\n    for num in range(start, end + 1):\n        if num in even_digits_set:\n            found_even_digits.append(num)\n\n    return found_even_digits\n```"}
{"task_id": "HumanEval/161", "solution": "```python\ndef _contains_letters(s: str) -> bool:\n    \"\"\"Checks if the input string contains any alphabetic characters.\"\"\"\n    for char in s:\n        if char.isalpha():\n            return True\n    return False\n\ndef _transform_with_case_swap(s: str) -> str:\n    \"\"\"Swaps the case of alphabetic characters and retains others.\"\"\"\n    transformed_chars = []\n    for char in s:\n        if char.isalpha():\n            transformed_chars.append(char.swapcase())\n        else:\n            transformed_chars.append(char)\n    return \"\".join(transformed_chars)\n\ndef _reverse_string(s: str) -> str:\n    \"\"\"Reverses the entire input string.\"\"\"\n    return s[::-1]\n\ndef solve(s):\n    \"\"\"Transforms the input string by swapping case of letters if present, otherwise reversing it.\"\"\"\n    if _contains_letters(s):\n        return _transform_with_case_swap(s)\n    else:\n        return _reverse_string(s)\n```"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    # 1. Input Validation\n    if not isinstance(a, int) or a <= 0:\n        raise ValueError(\"Input 'a' must be a positive integer.\")\n    if not isinstance(b, int) or b <= 0:\n        raise ValueError(\"Input 'b' must be a positive integer.\")\n\n    # 2. Range Normalization\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    # 3. Find Even Digits\n    even_digits = []\n    for i in range(min_val, max_val + 1):\n        # Check if the number is a single digit (0-9) and even\n        if 0 <= i <= 9 and i % 2 == 0:\n            even_digits.append(i)\n\n    return even_digits"}
