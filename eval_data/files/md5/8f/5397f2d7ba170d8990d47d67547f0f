{"task_id": "HumanEval/4", "solution": "```python\nfrom typing import List\n\n\ndef _calculate_mean(numbers: List[float]) -> float:\n    \"\"\"Computes the arithmetic mean of a list of numbers.\"\"\"\n    return sum(numbers) / len(numbers)\n\n\ndef _calculate_absolute_differences(numbers: List[float], mean: float) -> List[float]:\n    \"\"\"Calculates the absolute differences from the mean for each number.\"\"\"\n    return [abs(num - mean) for num in numbers]\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        return 0.0\n\n    mean_value = _calculate_mean(numbers)\n    absolute_differences = _calculate_absolute_differences(numbers, mean_value)\n\n    return sum(absolute_differences) / len(absolute_differences)\n\n```"}
{"task_id": "HumanEval/4", "solution": "```python\n# mad_calculator/__init__.py\n# (This file is intentionally left empty to mark the directory as a Python package.)\n```\n```python\n# mad_calculator/mad_calculator.py\nfrom typing import List\n\n\ndef _calculate_mean(numbers: List[float]) -> float:\n    \"\"\"Computes the arithmetic mean of a list of floating-point numbers.\n    This helper function sums all numbers and divides by their count.\"\"\"\n    return sum(numbers) / len(numbers)\n\n\ndef _calculate_absolute_differences(numbers: List[float], mean_value: float) -> List[float]:\n    \"\"\"Calculates the absolute difference between each number and a given mean value.\n    It returns a new list containing these absolute differences.\"\"\"\n    return [abs(number - mean_value) for number in numbers]\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"For a given list of input numbers, calculate Mean Absolute Deviation around the mean of this dataset.\n    MAD is the average absolute difference between each element and the mean.\"\"\"\n    mean_value = _calculate_mean(numbers)\n    absolute_differences = _calculate_absolute_differences(numbers, mean_value)\n    return sum(absolute_differences) / len(absolute_differences)\n```"}
{"task_id": "HumanEval/6", "solution": "```python\nfrom typing import List\n\n\ndef _calculate_max_nesting_depth(paren_group: str) -> int:\n    \"\"\"Calculates the maximum nesting depth for a single group of parentheses.\n    It tracks the current depth and updates the maximum encountered.\n    \"\"\"\n    max_depth = 0\n    current_depth = 0\n    for char in paren_group:\n        if char == '(':\n            current_depth += 1\n            max_depth = max(max_depth, current_depth)\n        elif char == ')':\n            current_depth -= 1\n    return max_depth\n\n\ndef _split_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Splits the input string into individual parentheses groups.\n    Groups are separated by spaces, and empty groups are excluded.\n    \"\"\"\n    return paren_string.split()\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    \"\"\"\n    groups = _split_paren_groups(paren_string)\n    result = []\n    for group in groups:\n        result.append(_calculate_max_nesting_depth(group))\n    return result\n```"}
{"task_id": "HumanEval/6", "solution": "```python\nfrom typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    result_depths: List[int] = []\n\n    # Split the input string into individual groups and process each to find its maximum nesting depth.\n    for group in paren_string.split(' '):\n        if not group:\n            continue # Skip empty strings resulting from multiple spaces or an empty input.\n\n        current_depth = 0\n        max_depth = 0\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n        result_depths.append(max_depth)\n\n    return result_depths\n```"}
{"task_id": "HumanEval/7", "solution": "```python\nfrom typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    filtered_results = []\n    for next_string in strings:\n        if substring in next_string:\n            filtered_results.append(next_string)\n    return filtered_results\n```"}
