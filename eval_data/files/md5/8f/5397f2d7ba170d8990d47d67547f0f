{"task_id": "HumanEval/91", "solution": "```python\ndef is_bored(S):\n    \"\"\"\n    Counts the number of boredoms. A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    boredom_count = 0\n    current_sentence = \"\"\n    sentences = []\n    delimiters = ['.', '?', '!']\n\n    # Split the input string into sentences\n    for char in S:\n        current_sentence += char\n        if char in delimiters:\n            if current_sentence.strip():\n                sentences.append(current_sentence.strip())\n            current_sentence = \"\"\n    if current_sentence.strip():\n        sentences.append(current_sentence.strip())\n\n    # Analyze each sentence for boredom\n    for sentence in sentences:\n        # Check if the sentence starts with 'I' and 'I' is a standalone word\n        if sentence.startswith(\"I\") and \\\n           (len(sentence) == 1 or not sentence[1].isalpha()):\n            boredom_count += 1\n\n    return boredom_count\n```"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n\n    Examples\n    any_int(5, 2, 7) \u279e True\n\n    any_int(3, 2, 2) \u279e False\n\n    any_int(3, -2, 1) \u279e True\n\n    any_int(3.6, -2.2, 2) \u279e False\n    '''\n    if not (isinstance(x, int) and isinstance(y, int) and isinstance(z, int)):\n        return False\n\n    return (x + y == z) or (x + z == y) or (y + z == x)"}
{"task_id": "HumanEval/94", "solution": "```python\ndef is_prime(n: int) -> bool:\n    \"\"\"Determines if a given integer n is a prime number.\n    Returns True if n is prime, False otherwise.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    # Check for divisibility from 3 up to the square root of n.\n    for i in range(3, int(n**0.5) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\n\ndef sum_digits(n: int) -> int:\n    \"\"\"Calculates the sum of the digits of a given integer n.\n    The number is converted to a string to easily sum its individual digits.\n    \"\"\"\n    s = 0\n    for digit_char in str(n):\n        s += int(digit_char)\n    return s\n\ndef skjkasdkd(lst: list[int]) -> int:\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    largest_prime = None\n\n    for number in lst:\n        if is_prime(number):\n            if largest_prime is None or number > largest_prime:\n                largest_prime = number\n\n    if largest_prime is None:\n        return 0\n    else:\n        return sum_digits(largest_prime)\n```"}
{"task_id": "HumanEval/93", "solution": "```python\ndef encode(message):\n    \"\"\"\n    Encodes a message by swapping letter cases and shifting vowels two positions ahead.\n    Non-English characters are passed through unchanged.\n    \"\"\"\n\n    def _is_english_letter(char: str) -> bool:\n        \"\"\"Determines if a character is an English alphabet letter.\"\"\"\n        return 'a' <= char <= 'z' or 'A' <= char <= 'Z'\n\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Determines if a character is a vowel (case-insensitive).\"\"\"\n        return char.lower() in ('a', 'e', 'i', 'o', 'u')\n\n    def _get_two_places_ahead(char: str) -> str:\n        \"\"\"Returns the letter two positions ahead in the alphabet, wrapping around.\"\"\"\n        if 'a' <= char <= 'z':\n            return chr(ord('a') + (ord(char) - ord('a') + 2) % 26)\n        elif 'A' <= char <= 'Z':\n            return chr(ord('A') + (ord(char) - ord('A') + 2) % 26)\n        return char # Should not happen if called with English letter\n\n    def _swap_case(char: str) -> str:\n        \"\"\"Swaps the case of an English letter.\"\"\"\n        return char.swapcase()\n\n    encoded_chars = []\n    for char in message:\n        if _is_english_letter(char):\n            processed_char = char\n            if _is_vowel(char):\n                processed_char = _get_two_places_ahead(char)\n\n            final_char = _swap_case(processed_char)\n            encoded_chars.append(final_char)\n        else:\n            encoded_chars.append(char)\n\n    return \"\".join(encoded_chars)\n```"}
{"task_id": "HumanEval/94", "solution": "```python\nimport math\n\ndef _is_prime(n: int) -> bool:\n    \"\"\"Determines if a given integer is a prime number.\n    Returns True if prime, False otherwise, handling numbers less than or equal to 1 as non-prime.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\n\ndef _sum_digits(n: int) -> int:\n    \"\"\"Calculates the sum of the digits of a given integer.\n    It sums the absolute value of digits of 'n'.\n    \"\"\"\n    digit_sum = 0\n    n = abs(n)\n    if n == 0:\n        return 0\n    while n > 0:\n        digit_sum += n % 10\n        n //= 10\n    return digit_sum\n\ndef _find_largest_prime(lst: list[int]) -> int | None:\n    \"\"\"Identifies all prime numbers in a list and returns the largest one.\n    Returns None if no primes are found in the input list.\n    \"\"\"\n    largest_prime = None\n    for num in lst:\n        if _is_prime(num):\n            if largest_prime is None or num > largest_prime:\n                largest_prime = num\n    return largest_prime\n\ndef skjkasdkd(lst: list[int]) -> int:\n    \"\"\"Main entry point: orchestrates finding the largest prime and summing its digits from an input list.\n    Returns 0 if the list is empty or contains no prime numbers.\n    \"\"\"\n    largest_prime_num = _find_largest_prime(lst)\n    if largest_prime_num is None:\n        return 0\n    return _sum_digits(largest_prime_num)\n```"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    Examples:\n    check_dict_case({\"a\":\"apple\", \"b\":\"banana\"}) should return True.\n    check_dict_case({\"a\":\"apple\", \"A\":\"banana\", \"B\":\"banana\"}) should return False.\n    check_dict_case({\"a\":\"apple\", 8:\"banana\", \"a\":\"apple\"}) should return False.\n    check_dict_case({\"Name\":\"John\", \"Age\":\"36\", \"City\":\"Houston\"}) should return False.\n    check_dict_case({\"STATE\":\"NC\", \"ZIP\":\"12345\" }) should return True.\n    \"\"\"\n    if not dict:\n        return False\n\n    all_lower = True\n    all_upper = True\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n\n        if not key.islower():\n            all_lower = False\n        if not key.isupper():\n            all_upper = False\n\n    if all_lower:\n        return True\n    elif all_upper:\n        return True\n    else:\n        return False\n```\n"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(input_dict):\n    \"\"\"\n    Checks if all string keys in a dictionary are uniformly cased (all lowercase or all uppercase).\n    Returns False for empty dictionaries, non-string keys, or mixed-case keys.\n    \"\"\"\n    if not input_dict:\n        return False\n\n    for key in input_dict:\n        if not isinstance(key, str):\n            return False\n\n    is_all_lower = True\n    is_all_upper = True\n\n    for key in input_dict:\n        if not key.islower():\n            is_all_lower = False\n        if not key.isupper():\n            is_all_upper = False\n\n        if not is_all_lower and not is_all_upper:\n            break\n\n    return is_all_lower or is_all_upper\n```"}
{"task_id": "HumanEval/93", "solution": "```python\ndef _swap_case(char_val: str) -> str:\n    \"\"\"Returns the character with its case swapped.\"\"\"\n    return char_val.swapcase()\n\ndef _is_vowel(char_val: str) -> bool:\n    \"\"\"Checks if a character is an English vowel, case-insensitive.\"\"\"\n    vowels = \"aeiouAEIOU\"\n    return char_val in vowels\n\ndef _get_nth_ahead(char_val: str, n: int) -> str:\n    \"\"\"Calculates the character n positions ahead in the English alphabet, preserving case.\"\"\"\n    if 'a' <= char_val <= 'z':\n        start = ord('a')\n        return chr((ord(char_val) - start + n) % 26 + start)\n    elif 'A' <= char_val <= 'Z':\n        start = ord('A')\n        return chr((ord(char_val) - start + n) % 26 + start)\n    return char_val # Non-alphabetic characters are returned as is, though spec assumes only letters.\n\ndef encode(message):\n    \"\"\"\n    Encodes a message by swapping letter cases and shifting vowels two positions ahead.\n    This function processes each character according to the defined encoding rules.\n    \"\"\"\n    result_chars = []\n    for char in message:\n        char_swapped = _swap_case(char)\n        if _is_vowel(char_swapped):\n            char_final = _get_nth_ahead(char_swapped, 2)\n        else:\n            char_final = char_swapped\n        result_chars.append(char_final)\n    return \"\".join(result_chars)\n```"}
{"task_id": "HumanEval/96", "solution": "```python\ndef is_prime(number: int) -> bool:\n    \"\"\"Checks if a given number is prime.\"\"\"\n    if number < 2:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    # Check for factors from 3 up to the square root of number.\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True\n\ndef count_up_to(n: int) -> list[int]:\n    \"\"\"Finds all prime numbers strictly less than n.\"\"\"\n    if n <= 1:\n        return []\n\n    primes = []\n    for number in range(2, n):\n        if is_prime(number):\n            primes.append(number)\n    return primes\n```"}
{"task_id": "HumanEval/96", "solution": "import math\n\ndef _is_prime(num: int) -> bool:\n    \"\"\"Checks if a given number is prime.\n    Optimized by checking divisibility up to its square root.\"\"\"\n    if num < 2:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(num)) + 1, 2):\n        if num % i == 0:\n            return False\n    return True\n\ndef count_up_to(n: int) -> list[int]:\n    \"\"\"Identifies and returns an array of prime numbers strictly less than n.\n    Handles non-negative integer inputs for n.\"\"\"\n    if n <= 1:\n        return []\n\n    primes_list = []\n    for i in range(2, n):\n        if _is_prime(i):\n            primes_list.append(i)\n    return primes_list"}
{"task_id": "HumanEval/97", "solution": "```python\ndef _get_unit_digit(number: int) -> int:\n    \"\"\"Extracts the unit digit from an integer's absolute value.\n    This helper function ensures the unit digit is always positive.\"\"\"\n    return abs(number) % 10\n\ndef multiply(a: int, b: int) -> int:\n    \"\"\"Complete the function that takes two integers and returns\n    the product of their unit digits.\"\"\"\n    unit_digit_a = _get_unit_digit(a)\n    unit_digit_b = _get_unit_digit(b)\n    return unit_digit_a * unit_digit_b\n```"}
