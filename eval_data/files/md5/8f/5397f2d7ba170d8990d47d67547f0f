{"task_id": "HumanEval/127", "solution": "```python\ndef _calculate_intersection_boundaries(interval1, interval2):\n    \"\"\"Calculates the boundaries of the intersection of two intervals.\n    Returns a tuple (start, end) of the potential intersection.\"\"\"\n    start = max(interval1[0], interval2[0])\n    end = min(interval1[1], interval2[1])\n    return (start, end)\n\ndef _is_prime(number):\n    \"\"\"Checks if a given integer is a prime number.\n    Returns True if prime, False otherwise.\"\"\"\n    if number <= 1:\n        return False\n    # Check for factors from 2 up to the square root of the number.\n    for i in range(2, int(number**0.5) + 1):\n        if number % i == 0:\n            return False\n    return True\n\ndef intersection(interval1, interval2):\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two\n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n\n\n    [input/output] samples:\n    intersection((1, 2), (2, 3)) ==> \"NO\"\n    intersection((-1, 1), (0, 4)) ==> \"NO\"\n    intersection((-3, -1), (-5, 5)) ==> \"YES\"\n    \"\"\"\n    intersection_start, intersection_end = _calculate_intersection_boundaries(interval1, interval2)\n\n    if intersection_start > intersection_end:\n        return \"NO\"  # No intersection\n\n    length = intersection_end - intersection_start\n\n    if _is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\"\n```"}
{"task_id": "HumanEval/128", "solution": "```python\ndef _get_magnitude(number):\n    \"\"\"Calculates the absolute value of a number.\"\"\"\n    return abs(number)\n\ndef _get_sign(number):\n    \"\"\"Returns 1 for positive, -1 for negative, and 0 for zero.\"\"\"\n    if number > 0:\n        return 1\n    elif number < 0:\n        return -1\n    else:\n        return 0\n\ndef prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes multiplied by the product of signs.\n    Returns None if the input array is empty.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_magnitudes = 0\n    product_signs = 1\n\n    for number in arr:\n        sum_magnitudes += _get_magnitude(number)\n        product_signs *= _get_sign(number)\n\n    return sum_magnitudes * product_signs\n```"}
{"task_id": "HumanEval/121", "solution": "```python\ndef solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n\n\n    Examples\n    solution([5, 8, 7, 1]) ==> 12\n    solution([3, 3, 3, 3, 3]) ==> 9\n    solution([30, 13, 24, 321]) ==>0\n    \"\"\"\n    current_sum = 0\n    # Iterate through the list, getting both the 0-based index and the element's value.\n    for index, element_value in enumerate(lst):\n        # Check if the current index is even and the element's value is odd.\n        if index % 2 == 0 and element_value % 2 != 0:\n            current_sum += element_value\n    return current_sum\n```"}
{"task_id": "HumanEval/128", "solution": "```python\ndef _get_magnitude(number):\n    \"\"\"\n    Helper to calculate the absolute value (magnitude) of an integer.\n    \"\"\"\n    return abs(number)\n\ndef _get_sign(number):\n    \"\"\"\n    Helper to determine the sign (1, -1, or 0) of an integer.\n    \"\"\"\n    if number > 0:\n        return 1\n    elif number < 0:\n        return -1\n    else:\n        return 0\n\ndef prod_signs(arr):\n    \"\"\"\n    Calculates sum of magnitudes of integers multiplied by product of all signs.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_of_magnitudes = 0\n    product_of_signs = 1\n\n    for number in arr:\n        sum_of_magnitudes += _get_magnitude(number)\n        product_of_signs *= _get_sign(number)\n\n    return sum_of_magnitudes * product_of_signs\n```\n"}
{"task_id": "HumanEval/130", "solution": "```python\ndef tri(n):\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in\n    the last couple centuries. However, what people don't know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8\n    You are given a non-negative integer number n, you have to a return a list of the\n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n    memo = {}\n\n    def _calculate_tribonacci_value(k: int, memo: dict) -> int:\n        if k in memo:\n            return memo[k]\n\n        value: int\n        if k == 0:\n            value = 1\n        elif k == 1:\n            value = 3\n        elif k % 2 == 0:  # k is even and k > 1 (base cases handle 0, 1)\n            value = 1 + k // 2\n        else:  # k is odd and k > 1\n            value = (\n                _calculate_tribonacci_value(k - 1, memo)\n                + _calculate_tribonacci_value(k - 2, memo)\n                + _calculate_tribonacci_value(k + 1, memo)\n            )\n\n        memo[k] = value\n        return value\n\n    result = []\n    for i in range(n + 1):\n        result.append(_calculate_tribonacci_value(i, memo))\n\n    return result\n\n```"}
{"task_id": "HumanEval/123", "solution": "class Number:\n    \"\"\"Encapsulates an integer value and provides utility methods for Collatz rules.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_even(self) -> bool:\n        \"\"\"Checks if the number is even.\"\"\"\n        return self.value % 2 == 0\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the number is odd.\"\"\"\n        return self.value % 2 != 0\n\n    def apply_even_rule(self) -> 'Number':\n        \"\"\"Applies the Collatz even rule: divide by 2.\"\"\"\n        return Number(self.value // 2)\n\n    def apply_odd_rule(self) -> 'Number':\n        \"\"\"Applies the Collatz odd rule: multiply by 3 and add 1.\"\"\"\n        return Number(3 * self.value + 1)\n\n\nclass CollatzSequence:\n    \"\"\"Manages the state and generation of the Collatz sequence.\"\"\"\n    def __init__(self, start_n: int):\n        self.current_number = Number(start_n)\n\n    def generate_next(self) -> None:\n        \"\"\"Generates the next number in the sequence based on Collatz rules.\"\"\"\n        if self.current_number.is_even():\n            self.current_number = self.current_number.apply_even_rule()\n        else:\n            self.current_number = self.current_number.apply_odd_rule()\n\n    def is_terminated(self) -> bool:\n        \"\"\"Checks if the sequence has reached 1, indicating termination.\"\"\"\n        return self.current_number.value == 1\n\n    def get_current_number_value(self) -> int:\n        \"\"\"Returns the integer value of the current number in the sequence.\"\"\"\n        return self.current_number.value\n\n\nclass OddNumbersList:\n    \"\"\"Stores and manages the collection of unique odd numbers.\"\"\"\n    def __init__(self):\n        self.numbers = set()\n\n    def add(self, number: int) -> None:\n        \"\"\"Adds an odd number to the collection, ensuring uniqueness.\"\"\"\n        self.numbers.add(number)\n\n    def get_sorted(self) -> list[int]:\n        \"\"\"Returns the collected odd numbers as a sorted list.\"\"\"\n        return sorted(list(self.numbers))\n\n\ndef get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n\n    The Collatz conjecture is a conjecture in mathematics that concerns a sequence defined\n    as follows: start with any positive integer n. Then each term is obtained from the\n    previous term as follows: if the previous term is even, the next term is one half of\n    the previous term. If the previous term is odd, the next term is 3 times the previous\n    term plus 1. The conjecture is that no matter what value of n, the sequence will always reach 1.\n\n    Note:\n        1. Collatz(1) is [1].\n        2. returned list sorted in increasing order.\n\n    For example:\n    get_odd_collatz(5) returns [1, 5] # The collatz sequence for 5 is [5, 16, 8, 4, 2, 1], so the odd numbers are only 1, and 5.\n    \"\"\"\n    if n == 1:\n        return [1]\n\n    collatz_sequence = CollatzSequence(n)\n    odd_numbers_list = OddNumbersList()\n\n    # Process the initial number 'n'\n    current_val = collatz_sequence.get_current_number_value()\n    if Number(current_val).is_odd():\n        odd_numbers_list.add(current_val)\n\n    # Loop to generate and process subsequent numbers until 1 is reached.\n    # The loop continues as long as the current value is not 1.\n    while current_val != 1:\n        collatz_sequence.generate_next()\n        current_val = collatz_sequence.get_current_number_value()\n        if Number(current_val).is_odd():\n            odd_numbers_list.add(current_val)\n\n    return odd_numbers_list.get_sorted()"}
{"task_id": "HumanEval/129", "solution": "```python\ndef minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically smallest path of length k in a given N x N grid.\n    The grid contains unique integer values from 1 to N*N.\n    \"\"\"\n\n    # --- Exceptions ---\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception for invalid input parameters.\"\"\"\n        def __init__(self, message):\n            self.message = message\n            super().__init__(self.message)\n\n    # --- Grid and Cell Data Models ---\n    class Cell:\n        \"\"\"Represents a single cell within the grid with its coordinates and value.\"\"\"\n        def __init__(self, row, column, value):\n            self.row = row\n            self.column = column\n            self.value = value\n\n        def get_neighbors(self, N):\n            \"\"\"Returns a list of valid adjacent cell coordinates (row, col) within grid boundaries.\"\"\"\n            neighbors = []\n            possible_moves = [(0, 1), (0, -1), (1, 0), (-1, 0)]  # Right, Left, Down, Up\n            for dr, dc in possible_moves:\n                new_row, new_col = self.row + dr, self.column + dc\n                if 0 <= new_row < N and 0 <= new_col < N:\n                    neighbors.append((new_row, new_col))\n            return neighbors\n\n    class Grid:\n        \"\"\"Manages the N x N grid structure and provides access to cells and values.\"\"\"\n        def __init__(self, grid_data):\n            self.N = len(grid_data)\n            self._cells = [[None for _ in range(self.N)] for _ in range(self.N)]\n            for r in range(self.N):\n                for c in range(self.N):\n                    self._cells[r][c] = Cell(r, c, grid_data[r][c])\n\n        def get_value(self, row, col):\n            \"\"\"Retrieves the integer value of the cell at specified coordinates.\"\"\"\n            return self._cells[row][col].value\n\n        def get_cell(self, row, col):\n            \"\"\"Retrieves the Cell object at specified coordinates.\"\"\"\n            return self._cells[row][col]\n\n        def is_valid_coordinate(self, row, col):\n            \"\"\"Checks if the given (row, col) coordinates are within the grid's bounds.\"\"\"\n            return 0 <= row < self.N and 0 <= col < self.N\n\n    # --- Path Data Model ---\n    class Path:\n        \"\"\"Represents a sequence of cell values forming a path, with lexicographical comparison.\"\"\"\n        def __init__(self, initial_values=None):\n            self._values = list(initial_values) if initial_values is not None else []\n            self.length = len(self._values)\n\n        def add_value(self, value):\n            \"\"\"Appends a new cell value to the end of the path.\"\"\"\n            self._values.append(value)\n            self.length += 1\n\n        def get_values(self):\n            \"\"\"Returns the ordered list of integer values that constitute this path.\"\"\"\n            return list(self._values)\n\n        def __lt__(self, other):\n            \"\"\"Compares two Path objects lexicographically.\"\"\"\n            min_len = min(self.length, other.length)\n            for i in range(min_len):\n                if self._values[i] < other._values[i]:\n                    return True\n                if self._values[i] > other._values[i]:\n                    return False\n            return self.length < other.length\n\n        def __eq__(self, other):\n            \"\"\"Checks if two Path objects are identical in their value sequence.\"\"\"\n            return self._values == other._values\n\n        def __ge__(self, other):\n            \"\"\"Helper for pruning: checks if this path is lexicographically greater than or equal to another.\"\"\"\n            return not (self < other)\n\n        def copy(self):\n            \"\"\"Creates and returns a new Path object with the same sequence of values.\"\"\"\n            return Path(list(self._values))\n\n    # --- Input Validation ---\n    class Validator:\n        \"\"\"Performs structural and content validation on the input grid and path length k.\"\"\"\n        def validate_grid(self, grid_data):\n            \"\"\"Ensures grid_data is N x N, N >= 2, and contains unique values 1 to N*N.\"\"\"\n            N = len(grid_data)\n            if N < 2:\n                raise InvalidInputError(\"Grid dimension N must be at least 2.\")\n            for row in grid_data:\n                if len(row) != N:\n                    raise InvalidInputError(\"Grid is not N x N.\")\n\n            seen_values = set()\n            for r in range(N):\n                for c in range(N):\n                    value = grid_data[r][c]\n                    if not (1 <= value <= N * N):\n                        raise InvalidInputError(f\"Grid contains value {value} outside range [1, {N*N}].\")\n                    if value in seen_values:\n                        raise InvalidInputError(f\"Grid contains duplicate value: {value}.\")\n                    seen_values.add(value)\n            if len(seen_values) != N * N:\n                 raise InvalidInputError(\"Grid does not contain N*N unique values.\")\n\n        def validate_k(self, k_val, N_val):\n            \"\"\"Ensures k_val is a positive integer.\"\"\"\n            if not isinstance(k_val, int) or k_val <= 0:\n                raise InvalidInputError(\"Path length k must be a positive integer.\")\n\n    # --- Pathfinding Logic ---\n    class PathFinder:\n        \"\"\"Implements the Depth-First Search algorithm to find the minimum path.\"\"\"\n        def find_minimum_path(self, grid_obj: Grid, k_val: int) -> list[int]:\n            \"\"\"\n            Orchestrates the DFS search across all starting cells to find the lexicographically smallest path.\n            \"\"\"\n            self.grid = grid_obj\n            self.k = k_val\n            self.N = grid_obj.N\n\n            # Initialize min_path with a path guaranteed to be lexicographically larger than any valid path.\n            self.min_path = Path([(self.N * self.N + 1)] * self.k)\n\n            for r_start in range(self.N):\n                for c_start in range(self.N):\n                    start_value = self.grid.get_value(r_start, c_start)\n                    current_path_segment = Path([start_value])\n                    self._dfs_recursive_search(current_path_segment, r_start, c_start)\n\n            return self.min_path.get_values()\n\n        def _dfs_recursive_search(self, current_path_segment: Path, current_r: int, current_c: int):\n            \"\"\"\n            Recursively explores paths using DFS, pruning branches that are already too large.\n            \"\"\"\n            # Pruning condition: if current_path_segment is already lexicographically greater than or equal to min_path.\n            if current_path_segment >= self.min_path:\n                return\n\n            # Base case: if current path segment has reached the target length k.\n            if current_path_segment.length == self.k:\n                if current_path_segment < self.min_path:\n                    self.min_path = current_path_segment.copy()\n                return\n\n            # Recursive step: explore neighbors\n            current_cell = self.grid.get_cell(current_r, current_c)\n            neighbors = current_cell.get_neighbors(self.N)\n\n            for neighbor_r, neighbor_c in neighbors:\n                neighbor_value = self.grid.get_value(neighbor_r, neighbor_c)\n                next_path_segment = current_path_segment.copy()\n                next_path_segment.add_value(neighbor_value)\n                self._dfs_recursive_search(next_path_segment, neighbor_r, neighbor_c)\n\n    # --- Main Application Logic (orchestration within minPath) ---\n    app_validator = Validator()\n\n    # 1. Validate inputs\n    app_validator.validate_grid(grid)\n    N_grid = len(grid)\n    app_validator.validate_k(k, N_grid)\n\n    # 2. Instantiate Grid model\n    grid_instance = Grid(grid)\n\n    # 3. Instantiate PathFinder and execute search\n    path_finder_instance = PathFinder()\n    result_path_values = path_finder_instance.find_minimum_path(grid_instance, k)\n\n    # 4. Return the result\n    return result_path_values\n```"}
{"task_id": "HumanEval/131", "solution": "```python\ndef digits(n):\n    \"\"\"Given a positive integer n, return the product of its odd digits.\n    Returns 0 if all digits are even.\n    \"\"\"\n    product_of_odds = 1\n    has_odd_digit = False\n\n    # Process the integer digit by digit.\n    # We use a copy of n to extract digits.\n    temp_n = n\n    if temp_n == 0: # Handle single digit 0 as a special case if relevant, though spec says positive integer.\n        return 0 # 0 has no odd digits, so product is 0.\n\n    while temp_n > 0:\n        digit = temp_n % 10  # Get the last digit\n        if digit % 2 != 0:   # Check if the digit is odd\n            product_of_odds *= digit\n            has_odd_digit = True\n        temp_n //= 10        # Remove the last digit\n\n    if not has_odd_digit:\n        return 0\n    else:\n        return product_of_odds\n```"}
{"task_id": "HumanEval/130", "solution": "```python\ndef tri(n):\n    \"\"\"Calculates the first n+1 numbers of a Tribonacci-like sequence.\n    The sequence is defined by specific recurrence relations for even and odd indices.\n    \"\"\"\n    if n == 0:\n        return [1]\n\n    sequence = [1, 3] # Initializes tri(0) and tri(1)\n\n    for i in range(2, n + 1):\n        if i % 2 == 0:  # i is an even number\n            current_tri = int(1 + i / 2.0)\n        else:  # i is an odd number\n            # Calculate tri(i + 1) using the even rule, as (i + 1) is even.\n            tri_i_plus_1 = int(1 + (i + 1) / 2.0)\n            current_tri = sequence[i - 1] + sequence[i - 2] + tri_i_plus_1\n        sequence.append(current_tri)\n\n    return sequence\n```"}
{"task_id": "HumanEval/131", "solution": "```python\ndef digits(n: int) -> int:\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\"\"\"\n\n    def _is_odd(digit: int) -> bool:\n        \"\"\"Checks if a digit is odd.\"\"\"\n        return digit % 2 != 0\n\n    def _extract_digits(number: int) -> list[int]:\n        \"\"\"Extracts individual digits from a positive integer.\"\"\"\n        if number == 0:\n            return [0]\n        digits_list = []\n        temp_number = number\n        while temp_number > 0:\n            digits_list.append(temp_number % 10)\n            temp_number //= 10\n        return digits_list[::-1]\n\n    extracted_digits = _extract_digits(n)\n\n    odd_digits = [d for d in extracted_digits if _is_odd(d)]\n\n    if not odd_digits:\n        return 0\n\n    product = 1\n    for digit in odd_digits:\n        product *= digit\n\n    return product\n```"}
{"task_id": "HumanEval/129", "solution": "```python\nclass Cell:\n    \"\"\"Represents a single cell in the grid with its value and coordinates.\"\"\"\n    def __init__(self, value: int, row: int, col: int):\n        self.value = value\n        self.row = row\n        self.col = col\n\n    def __eq__(self, other):\n        if not isinstance(other, Cell):\n            return NotImplemented\n        return self.row == other.row and self.col == other.col and self.value == other.value\n\n    def __hash__(self):\n        return hash((self.row, self.col, self.value))\n\nclass Grid:\n    \"\"\"Manages the N x N grid of cells and provides access to them.\"\"\"\n    def __init__(self, grid_values: list[list[int]]):\n        self._N = len(grid_values)\n        self._cells: list[list[Cell]] = []\n        for r in range(self._N):\n            row_cells = []\n            for c in range(self._N):\n                row_cells.append(Cell(grid_values[r][c], r, c))\n            self._cells.append(row_cells)\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        \"\"\"Returns the Cell object at the given coordinates.\"\"\"\n        return self._cells[row][col]\n\n    def get_value(self, row: int, col: int) -> int:\n        \"\"\"Returns the integer value of the cell at the given coordinates.\"\"\"\n        return self._cells[row][col].value\n\n    def get_N(self) -> int:\n        \"\"\"Returns the dimension N of the grid.\"\"\"\n        return self._N\n\nclass Path:\n    \"\"\"Represents a path of k cells, supporting extension and lexicographical comparison.\"\"\"\n    def __init__(self, initial_cell: Cell, length_k: int):\n        self.length_k = length_k\n        self.cells_traversed: list[Cell] = [initial_cell]\n        self.ordered_values: list[int] = [initial_cell.value]\n\n    def add_cell(self, cell: Cell):\n        \"\"\"Appends a cell to the path.\"\"\"\n        self.cells_traversed.append(cell)\n        self.ordered_values.append(cell.value)\n\n    def is_complete(self) -> bool:\n        \"\"\"Checks if the path has reached length_k cells.\"\"\"\n        return len(self.cells_traversed) == self.length_k\n\n    def __lt__(self, other: 'Path') -> bool:\n        \"\"\"Implements lexicographical comparison between two paths.\"\"\"\n        return self.ordered_values < other.ordered_values\n\n    def copy(self) -> 'Path':\n        \"\"\"Creates a shallow copy of the path for further exploration.\"\"\"\n        new_path = Path(self.cells_traversed[0], self.length_k)\n        new_path.cells_traversed = list(self.cells_traversed)\n        new_path.ordered_values = list(self.ordered_values)\n        return new_path\n\nclass GridValidator:\n    \"\"\"Validates the structural and content integrity of the input grid and path length k.\"\"\"\n\n    @staticmethod\n    def validate_grid_dimensions(grid_values: list[list[int]]) -> int:\n        \"\"\"Validates N >= 2 and returns N.\"\"\"\n        if not grid_values:\n            raise ValueError(\"Grid cannot be empty.\")\n        N = len(grid_values)\n        if N < 2:\n            raise ValueError(\"Grid dimension N must be at least 2.\")\n        for row in grid_values:\n            if len(row) != N:\n                raise ValueError(\"Grid must be N x N.\")\n        return N\n\n    @staticmethod\n    def validate_grid_values(grid: Grid):\n        \"\"\"Validates that values [1, N*N] appear exactly once.\"\"\"\n        N = grid.get_N()\n        expected_values = set(range(1, N * N + 1))\n        actual_values = set()\n        for r in range(N):\n            for c in range(N):\n                value = grid.get_value(r, c)\n                if value in actual_values:\n                    raise ValueError(f\"Duplicate value {value} found in grid.\")\n                actual_values.add(value)\n        if actual_values != expected_values:\n            raise ValueError(\"Grid values must be a permutation of [1, N*N].\")\n\n    @staticmethod\n    def validate_k(k: int):\n        \"\"\"Validates that k is a positive integer.\"\"\"\n        # The problem statement guarantees k is a positive integer,\n        # but the design specifies a validation check.\n        if k <= 0:\n            raise ValueError(\"Path length k must be a positive integer.\")\n\nclass PathFinder:\n    \"\"\"Implements the algorithm to find the lexicographically minimum path of length k.\"\"\"\n\n    def find_min_path(self, grid: Grid, k: int) -> list[int]:\n        \"\"\"Orchestrates path generation and comparison to find the minimum path.\"\"\"\n        all_paths: list[Path] = []\n        N = grid.get_N()\n\n        for r in range(N):\n            for c in range(N):\n                start_cell = grid.get_cell(r, c)\n                paths_from_start = self._generate_paths_from_start(grid, start_cell, k)\n                all_paths.extend(paths_from_start)\n\n        # As per NFR1, a unique minimum path is guaranteed for valid inputs.\n        min_path = all_paths[0]\n        for path in all_paths:\n            if path < min_path:\n                min_path = path\n\n        return min_path.ordered_values\n\n    def _generate_paths_from_start(self, grid: Grid, start_cell: Cell, k: int) -> list[Path]:\n        \"\"\"Generates all paths of length k starting from a given cell.\"\"\"\n        paths_from_start: list[Path] = []\n        initial_path = Path(start_cell, k)\n\n        self._dfs(grid, k, initial_path, paths_from_start)\n        return paths_from_start\n\n    def _dfs(self, grid: Grid, k: int, current_path: Path, all_paths: list[Path]):\n        \"\"\"Recursive Depth-First Search to explore paths.\"\"\"\n        if current_path.is_complete():\n            all_paths.append(current_path)\n            return\n\n        last_cell = current_path.cells_traversed[-1]\n        neighbors_coords = self._get_neighbors_coords(grid, last_cell)\n\n        for r, c in neighbors_coords:\n            neighbor_cell = grid.get_cell(r, c)\n            new_path = current_path.copy()\n            new_path.add_cell(neighbor_cell)\n            self._dfs(grid, k, new_path, all_paths)\n\n    def _get_neighbors_coords(self, grid: Grid, cell: Cell) -> list[tuple[int, int]]:\n        \"\"\"Returns valid adjacent neighbor coordinates for a cell.\"\"\"\n        N = grid.get_N()\n        neighbors = []\n        dr = [-1, 1, 0, 0] # Up, Down, Left, Right\n        dc = [0, 0, -1, 1]\n\n        for i in range(4):\n            new_row, new_col = cell.row + dr[i], cell.col + dc[i]\n            if 0 <= new_row < N and 0 <= new_col < N:\n                neighbors.append((new_row, new_col))\n        return neighbors\n\ndef minPath(grid_values: list[list[int]], k: int) -> list[int]:\n    \"\"\"\n    Finds the lexicographically smallest path of length k in a given N x N grid.\n    Orchestrates input validation and the pathfinding process.\n    \"\"\"\n    # Input Validation\n    _ = GridValidator.validate_grid_dimensions(grid_values)\n    grid_obj = Grid(grid_values)\n    GridValidator.validate_grid_values(grid_obj)\n    GridValidator.validate_k(k)\n\n    # Path Generation, Comparison & Selection\n    path_finder = PathFinder()\n    min_path_values = path_finder.find_min_path(grid_obj, k)\n\n    # System Output\n    return min_path_values\n```"}
{"task_id": "HumanEval/132", "solution": "```python\ndef is_nested(string):\n    \"\"\"\n    Determines if the input string contains a nested bracket subsequence.\n    A nested bracket subsequence is defined as the pattern '[[]]'.\n    \"\"\"\n\n    def _validate_input_string(s: str) -> bool:\n        \"\"\"\n        Checks if the string contains only square bracket characters.\n        Returns True if valid, False otherwise.\n        \"\"\"\n        for char in s:\n            if char not in ('[', ']'):\n                return False\n        return True\n\n    def _find_nested_subsequence(s: str) -> bool:\n        \"\"\"\n        Scans the string to find if the '[[]]' pattern exists as a subsequence.\n        It tracks the presence of opening and closing brackets in order.\n        \"\"\"\n        found_first_open = False\n        found_second_open = False\n        found_first_close = False\n\n        for char in s:\n            if char == '[':\n                if not found_first_open:\n                    found_first_open = True\n                elif found_first_open and not found_second_open:\n                    found_second_open = True\n            elif char == ']':\n                if found_second_open and not found_first_close:\n                    found_first_close = True\n                elif found_first_close:\n                    return True\n        return False\n\n    if not _validate_input_string(string):\n        return False\n\n    return _find_nested_subsequence(string)\n```"}
