{"task_id": "HumanEval/118", "solution": "```python\ndef _is_vowel(char: str) -> bool:\n    # Checks if a character is a vowel (case-sensitive).\n    return char in 'aeiouAEIOU'\n\ndef _is_consonant(char: str) -> bool:\n    # Checks if a character is a consonant (case-sensitive).\n    return char.isalpha() and not _is_vowel(char)\n\ndef get_closest_vowel(word: str) -> str:\n    # Finds the closest vowel from the right, between two consonants, excluding ends.\n    n = len(word)\n    # A vowel cannot be at index 0 or n-1, so search indices from n-2 down to 1.\n    if n < 3:\n        return \"\"\n\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        if _is_vowel(current_char):\n            left_char = word[i - 1]\n            right_char = word[i + 1]\n            if _is_consonant(left_char) and _is_consonant(right_char):\n                return current_char\n    return \"\"\n```"}
{"task_id": "HumanEval/117", "solution": "```python\ndef select_words(s, n):\n    \"\"\"\n    Selects words from a string that contain exactly n consonants.\n    Helper functions are defined internally for consonant counting and vowel checking.\n    \"\"\"\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n        return char.lower() in {'a', 'e', 'i', 'o', 'u'}\n\n    def _count_consonants(word: str) -> int:\n        \"\"\"Counts the number of consonants in a word.\"\"\"\n        consonant_count = 0\n        for char in word:\n            # Assuming input contains only letters and spaces, so char is always a letter here.\n            if not _is_vowel(char):\n                consonant_count += 1\n        return consonant_count\n\n    if not s:\n        return []\n\n    words = s.split()\n    result_list = []\n\n    for word in words:\n        if _count_consonants(word) == n:\n            result_list.append(word)\n\n    return result_list\n```"}
{"task_id": "HumanEval/119", "solution": "```python\ndef match_parens(lst):\n    '''\n    Checks if concatenating two strings of parentheses in any order results in a balanced string.\n    Returns 'Yes' if a balanced string can be formed, 'No' otherwise.\n    '''\n\n    def _is_balanced(s: str) -> bool:\n        \"\"\"\n        Determines if a given string of parentheses is balanced.\n        It maintains a balance counter, ensuring it never drops below zero and ends at zero.\n        \"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    s1 = lst[0]\n    s2 = lst[1]\n\n    # Check the first concatenation: s1 + s2\n    if _is_balanced(s1 + s2):\n        return 'Yes'\n\n    # Check the second concatenation: s2 + s1\n    if _is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'\n```"}
{"task_id": "HumanEval/117", "solution": "```python\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Determines if a character is a vowel, case-insensitive.\n    Checks against 'a', 'e', 'i', 'o', 'u'.\n    \"\"\"\n    return char.lower() in ('a', 'e', 'i', 'o', 'u')\n\ndef _count_consonants(word: str) -> int:\n    \"\"\"Counts the number of consonants in a given word.\n    Uses _is_vowel to identify consonants from alphabetic characters.\n    \"\"\"\n    consonant_count = 0\n    for char in word:\n        if char.isalpha() and not _is_vowel(char):\n            consonant_count += 1\n    return consonant_count\n\ndef select_words(s: str, n: int) -> list[str]:\n    \"\"\"Given a string s and a natural number n, returns a list of words from s\n    that contain exactly n consonants, preserving original order.\n    Returns an empty list if the input string s is empty.\n    \"\"\"\n    if not s:\n        return []\n\n    words = s.split(' ')\n    selected_words = []\n\n    for word in words:\n        if _count_consonants(word) == n:\n            selected_words.append(word)\n\n    return selected_words\n```"}
{"task_id": "HumanEval/119", "solution": "def _is_balanced(s: str) -> bool:\n    \"\"\"Checks if a given string of parentheses is balanced.\"\"\"\n    balance = 0\n    for char in s:\n        if char == '(':\n            balance += 1\n        else: # char == ')'\n            balance -= 1\n        if balance < 0:\n            return False # Unmatched closing parenthesis\n    return balance == 0\n\ndef _validate_input_list(lst: list) -> None:\n    \"\"\"Validates the structure of the input list. (No-op as per critical requirements).\"\"\"\n    pass\n\ndef _validate_string_content(s: str) -> None:\n    \"\"\"Validates that a string contains only parentheses. (No-op as per critical requirements).\"\"\"\n    pass\n\ndef match_parens(lst: list) -> str:\n    \"\"\"\n    Checks if two strings of parentheses can be concatenated in any order\n    to form a balanced parentheses string.\n    \"\"\"\n    _validate_input_list(lst) # Calls the no-op validation function\n\n    string1 = lst[0]\n    string2 = lst[1]\n\n    _validate_string_content(string1) # Calls the no-op validation function\n    _validate_string_content(string2) # Calls the no-op validation function\n\n    # Check concatenation order 1: string1 + string2\n    concat_str1 = string1 + string2\n    is_balanced_1 = _is_balanced(concat_str1)\n\n    # Check concatenation order 2: string2 + string1\n    concat_str2 = string2 + string1\n    is_balanced_2 = _is_balanced(concat_str2)\n\n    if is_balanced_1 or is_balanced_2:\n        return 'Yes'\n    else:\n        return 'No'"}
{"task_id": "HumanEval/118", "solution": "```python\nVOWELS = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is a vowel.\"\"\"\n    return char in VOWELS\n\ndef _is_consonant(char: str) -> bool:\n    \"\"\"Checks if a character is a consonant.\"\"\"\n    # Assumes input contains English letters; if not a vowel, it's a consonant.\n    return not _is_vowel(char)\n\ndef get_closest_vowel(word: str) -> str:\n    \"\"\"You are given a word. Your task is to find the closest vowel that stands between\n    two consonants from the right side of the word (case sensitive).\n\n    Vowels in the beginning and ending doesn't count. Return empty string if you didn't\n    find any vowel met the above condition.\n\n    You may assume that the given string contains English letter only.\n\n    Example:\n    get_closest_vowel(\"yogurt\") ==> \"u\"\n    get_closest_vowel(\"FULL\") ==> \"U\"\n    get_closest_vowel(\"quick\") ==> \"\"\n    get_closest_vowel(\"ab\") ==> \"\"\n    \"\"\"\n    # A qualifying vowel needs a character before and after, so a minimum length of 3 is required.\n    if len(word) < 3:\n        return \"\"\n\n    # Iterate from right to left, excluding the first and last characters of the word.\n    # The valid indices for a potential middle vowel are from len(word) - 2 down to 1.\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        prev_char = word[i-1]\n        next_char = word[i+1]\n\n        # Check if the current character is a vowel surrounded by consonants.\n        if _is_vowel(current_char) and \\\n           _is_consonant(prev_char) and \\\n           _is_consonant(next_char):\n            return current_char\n\n    # Return an empty string if no qualifying vowel is found after checking all positions.\n    return \"\"\n```"}
{"task_id": "HumanEval/120", "solution": "```python\ndef maximum(arr: list[int], k: int) -> list[int]:\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n\n    Example 1:\n\n        Input: arr = [-3, -4, 5], k = 3\n        Output: [-4, -3, 5]\n\n    Example 2:\n\n        Input: arr = [4, -4, 4], k = 2\n        Output: [4, 4]\n\n    Example 3:\n\n        Input: arr = [-3, 2, 1, 2, -1, -2, 1], k = 1\n        Output: [2]\n\n    Note:\n        1. The length of the array will be in the range of [1, 1000].\n        2. The elements in the array will be in the range of [-1000, 1000].\n        3. 0 <= k <= len(arr)\n    \"\"\"\n    if k == 0:\n        return []\n\n    # Sort the entire array in ascending order.\n    arr.sort()\n\n    # The k largest numbers will be the last k elements in the sorted array.\n    # These elements are already in ascending order.\n    return arr[len(arr) - k:]\n```"}
{"task_id": "HumanEval/113", "solution": "```python\nclass DigitString:\n    \"\"\"Encapsulates a digit string, validates its content, and counts its odd digits.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the string contains only digit characters (0-9).\"\"\"\n        return self._value.isdigit()\n\n    def count_odd_digits(self) -> int:\n        \"\"\"Counts occurrences of odd digits (1, 3, 5, 7, 9) in the string.\"\"\"\n        odd_digits = {'1', '3', '5', '7', '9'}\n        count = 0\n        for char in self._value:\n            if char in odd_digits:\n                count += 1\n        return count\n\nclass OddDigitCount:\n    \"\"\"A simple data holder for the count of odd digits.\"\"\"\n    def __init__(self, count: int):\n        self.count = count\n\nclass OutputStringFormatter:\n    \"\"\"Formats the output string based on the odd digit count.\"\"\"\n    def format_output(self, odd_count: OddDigitCount) -> str:\n        \"\"\"Generates the output string in the specified format.\"\"\"\n        count_str = str(odd_count.count)\n        return f\"the number of odd elements {count_str}n the str{count_str}ng {count_str} of the {count_str}nput.\"\n\ndef odd_count(lst: list[str]) -> list[str]:\n    \"\"\"Processes a list of strings to count odd digits and generate formatted output.\n\n    Given a list of strings, each containing only digits, returns a list of formatted strings\n    where 'N' is replaced by the count of odd digits from the corresponding input string.\n    \"\"\"\n    result_list = []\n    formatter = OutputStringFormatter()\n\n    for input_str in lst:\n        digit_string = DigitString(input_str)\n        if digit_string.is_valid():\n            calculated_count = digit_string.count_odd_digits()\n            odd_digit_count_obj = OddDigitCount(calculated_count)\n            formatted_string = formatter.format_output(odd_digit_count_obj)\n            result_list.append(formatted_string)\n        # If the string is invalid, it is skipped as per the sequence diagram's\n        # undefined behavior for invalid strings.\n    return result_list\n```"}
{"task_id": "HumanEval/121", "solution": "```python\ndef solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\"\"\"\n    total_sum = 0\n    for i in range(len(lst)):\n        # Check if the current position (index) is even\n        if i % 2 == 0:\n            # If the position is even, check if the element's value is odd\n            if lst[i] % 2 != 0:\n                total_sum += lst[i]\n    return total_sum\n```"}
