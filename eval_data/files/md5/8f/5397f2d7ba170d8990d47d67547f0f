{"task_id": "HumanEval/123", "solution": "def _generate_collatz_sequence_step(current_term):\n    \"\"\"Calculates the next term in the Collatz sequence.\n    Applies either n/2 or 3n+1 rule based on current_term's parity.\"\"\"\n    if current_term % 2 == 0:\n        return current_term // 2\n    else:\n        return 3 * current_term + 1\n\ndef get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    This function generates the Collatz sequence and collects all odd numbers within it.\n    \"\"\"\n    if n == 1:\n        return [1]\n\n    odd_numbers = set()\n    current_term = n\n\n    while current_term != 1:\n        if current_term % 2 != 0:  # Check if current_term is odd\n            odd_numbers.add(current_term)\n        current_term = _generate_collatz_sequence_step(current_term)\n\n    # Add 1 as it's the termination point and always odd.\n    odd_numbers.add(1)\n\n    sorted_odd_numbers_list = sorted(list(odd_numbers))\n    return sorted_odd_numbers_list"}
{"task_id": "HumanEval/124", "solution": "```python\ndef _is_empty(date_string: str) -> bool:\n    \"\"\"Checks if the input date string is empty.\"\"\"\n    return not date_string\n\ndef _is_format_valid_and_parse(date_string: str) -> tuple[bool, int, int, int]:\n    \"\"\"Validates 'mm-dd-yyyy' format and parses components.\"\"\"\n    if len(date_string) != 10 or date_string[2] != '-' or date_string[5] != '-':\n        return False, 0, 0, 0\n    try:\n        month = int(date_string[0:2])\n        day = int(date_string[3:5])\n        year = int(date_string[6:10])\n        return True, month, day, year\n    except ValueError:\n        return False, 0, 0, 0\n\ndef _is_month_valid(month: int) -> bool:\n    \"\"\"Checks if the month value is within the valid range of 1 to 12.\"\"\"\n    return 1 <= month <= 12\n\ndef _is_day_valid(day: int, month: int) -> bool:\n    \"\"\"Checks if the day is valid for the given month, considering month lengths.\"\"\"\n    if not (1 <= day <= 31):\n        return False\n\n    if month in [1, 3, 5, 7, 8, 10, 12]:\n        return day <= 31\n    elif month in [4, 6, 9, 11]:\n        return day <= 30\n    elif month == 2:\n        return day <= 29\n    return False\n\ndef valid_date(date: str) -> bool:\n    \"\"\"Validates a given date string against specified rules, returning True if valid.\"\"\"\n    if _is_empty(date):\n        return False\n\n    is_format_ok, month, day, year = _is_format_valid_and_parse(date)\n    if not is_format_ok:\n        return False\n\n    if not _is_month_valid(month):\n        return False\n\n    if not _is_day_valid(day, month):\n        return False\n\n    return True\n```"}
{"task_id": "HumanEval/124", "solution": "def _parse_date_components(date_string: str) -> tuple[int, int, int] | None:\n    \"\"\"Attempts to split the date string by '-' and convert parts to integers.\"\"\"\n    try:\n        parts = date_string.split('-')\n        if len(parts) != 3:\n            return None\n        month = int(parts[0])\n        day = int(parts[1])\n        year = int(parts[2])\n        return (month, day, year)\n    except ValueError:\n        return None\n\ndef _is_month_valid(month: int) -> bool:\n    \"\"\"Checks if the month is between 1 and 12.\"\"\"\n    return 1 <= month <= 12\n\ndef _is_day_valid(day: int, month: int) -> bool:\n    \"\"\"Checks if the day is valid for the given month, assuming February has up to 29 days.\"\"\"\n    if month in [1, 3, 5, 7, 8, 10, 12]:\n        return 1 <= day <= 31\n    elif month in [4, 6, 9, 11]:\n        return 1 <= day <= 30\n    elif month == 2:\n        return 1 <= day <= 29\n    return False\n\ndef valid_date(date: str) -> bool:\n    # 1. The date string is not empty.\n    if not date:\n        return False\n\n    # 4. The date should be in the format: mm-dd-yyyy\n    components = _parse_date_components(date)\n    if components is None:\n        return False\n\n    month, day, year = components\n\n    # 3. The months should not be less than 1 or higher than 12.\n    if not _is_month_valid(month):\n        return False\n\n    # 2. Day range validation based on month.\n    if not _is_day_valid(day, month):\n        return False\n\n    # If all checks pass, the date is valid.\n    return True"}
{"task_id": "HumanEval/125", "solution": "```python\nfrom typing import List, Union\n\ndef _has_whitespace(text: str) -> bool:\n    \"\"\"Checks if the text contains any whitespace character.\"\"\"\n    return any(c.isspace() for c in text)\n\ndef _has_comma(text: str) -> bool:\n    \"\"\"Checks if the text contains a comma character.\"\"\"\n    return ',' in text\n\ndef _count_odd_ordered_lowercase_letters(text: str) -> int:\n    \"\"\"Counts lowercase English letters with an odd 0-indexed alphabetical order (a=0, b=1...).\"\"\"\n    count = 0\n    for char in text:\n        if 'a' <= char <= 'z': # Ensure it's an English lowercase letter\n            order = ord(char) - ord('a')\n            if order % 2 != 0:\n                count += 1\n    return count\n\ndef split_words(txt: str) -> Union[List[str], int]:\n    \"\"\"Processes an input string based on prioritized rules: whitespace split, comma split, or odd-ordered lowercase letter count.\"\"\"\n    if _has_whitespace(txt):\n        return txt.split()\n    elif _has_comma(txt):\n        return txt.split(',')\n    else:\n        return _count_odd_ordered_lowercase_letters(txt)\n```"}
{"task_id": "HumanEval/125", "solution": "```python\nfrom typing import Union\n\ndef _has_whitespace(text: str) -> bool:\n    \"\"\"Checks if the input string contains any whitespace characters.\n    Returns True if whitespace is present, False otherwise.\n    \"\"\"\n    return any(c.isspace() for c in text)\n\ndef _has_comma(text: str) -> bool:\n    \"\"\"Checks if the input string contains any comma characters.\n    Returns True if commas are present, False otherwise.\n    \"\"\"\n    return ',' in text\n\ndef _split_by_whitespace(text: str) -> list[str]:\n    \"\"\"Splits the input string into a list of words using whitespace as a delimiter.\n    Handles multiple spaces and strips leading/trailing whitespace.\n    \"\"\"\n    return text.split()\n\ndef _split_by_comma(text: str) -> list[str]:\n    \"\"\"Splits the input string into a list of words using commas as a delimiter.\n    Filters out empty strings and strips whitespace from each resulting word.\n    \"\"\"\n    return [word.strip() for word in text.split(',') if word.strip()]\n\ndef _count_odd_order_lowercase_letters(text: str) -> int:\n    \"\"\"Counts lowercase letters with an odd alphabetical order (a=0, b=1, ...).\n    Iterates through the text and increments a counter for suitable characters.\n    \"\"\"\n    count = 0\n    for char in text:\n        if 'a' <= char <= 'z':\n            # Calculate alphabetical order: 'a'=0, 'b'=1, ..., 'z'=25\n            order = ord(char) - ord('a')\n            if order % 2 != 0:\n                count += 1\n    return count\n\ndef split_words(txt: str) -> Union[list[str], int]:\n    \"\"\"\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',', if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    \"\"\"\n    if _has_whitespace(txt):\n        return _split_by_whitespace(txt)\n    elif _has_comma(txt):\n        return _split_by_comma(txt)\n    else:\n        return _count_odd_order_lowercase_letters(txt)\n```"}
{"task_id": "HumanEval/120", "solution": "def _validate_inputs(arr, k):\n    \"\"\"\n    Validates the input array and k against specified constraints.\n    Raises ValueError for any violated constraint.\n    \"\"\"\n    if not (1 <= len(arr) <= 1000):\n        raise ValueError(\"Array length must be between 1 and 1000.\")\n\n    for x in arr:\n        if not (-1000 <= x <= 1000):\n            raise ValueError(\"Array elements must be between -1000 and 1000.\")\n\n    if not (0 <= k <= len(arr)):\n        raise ValueError(\"Value of k must be between 0 and the length of the array.\")\n\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n\n    Example 1:\n\n        Input: arr = [-3, -4, 5], k = 3\n        Output: [-4, -3, 5]\n\n    Example 2:\n\n        Input: arr = [4, -4, 4], k = 2\n        Output: [4, 4]\n\n    Example 3:\n\n        Input: arr = [-3, 2, 1, 2, -1, -2, 1], k = 1\n        Output: [2]\n\n    Note:\n        1. The length of the array will be in the range of [1, 1000].\n        2. The elements in the array will be in the range of [-1000, 1000].\n        3. 0 <= k <= len(arr)\n    \"\"\"\n    _validate_inputs(arr, k)\n\n    if k == 0:\n        return []\n\n    # Sort the array in ascending order to easily pick the k largest elements.\n    # The last k elements will be the k largest, already sorted ascending.\n    arr.sort()\n    return arr[-k:]"}
