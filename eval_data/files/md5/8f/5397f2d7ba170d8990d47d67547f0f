{"task_id": "HumanEval/50", "solution": "```python\ndef _is_alphabetic(char: str) -> bool:\n    \"\"\"Checks if a character is an alphabet letter.\"\"\"\n    return ('a' <= char <= 'z') or ('A' <= char <= 'Z')\n\ndef _is_uppercase(char: str) -> bool:\n    \"\"\"Checks if a character is an uppercase letter.\"\"\"\n    return 'A' <= char <= 'Z'\n\ndef _get_alphabetical_position(char: str) -> int:\n    \"\"\"Gets the 0-indexed alphabetical position for an alphabetic character.\"\"\"\n    if _is_uppercase(char):\n        return ord(char) - ord('A')\n    else: # Assumed to be lowercase if not uppercase and already checked as alphabetic\n        return ord(char) - ord('a')\n\ndef _apply_shift(char: str, shift_amount: int) -> str:\n    \"\"\"Applies a shift to an alphabetic character, preserving its case.\"\"\"\n    is_upper = _is_uppercase(char)\n    base_ord = ord('A') if is_upper else ord('a')\n\n    current_pos = _get_alphabetical_position(char)\n\n    # Apply shift and wrap around the alphabet. Add 26 to ensure positive result before modulo.\n    new_pos = (current_pos + shift_amount + 26) % 26\n\n    return chr(new_pos + base_ord)\n\ndef decode_shift(s: str) -> str:\n    \"\"\"\n    Takes an encoded string and returns the decoded string.\n    It shifts each alphabetic character back by 5 positions, preserving case.\n    \"\"\"\n    decoded_chars_list = []\n    for char in s:\n        if _is_alphabetic(char):\n            # Decode by shifting back 5 positions\n            shifted_char = _apply_shift(char, -5)\n            decoded_chars_list.append(shifted_char)\n        else:\n            decoded_chars_list.append(char)\n\n    return \"\".join(decoded_chars_list)\n```"}
{"task_id": "HumanEval/50", "solution": "```python\ndef encode_shift(s: str) -> str:\n    \"\"\"\n    Returns encoded string by shifting each lowercase English alphabet character by 5 positions forward.\n    Non-lowercase English alphabet characters are unchanged.\n    \"\"\"\n    encoded_chars = []\n    for char_code in map(ord, s):\n        if ord('a') <= char_code <= ord('z'):\n            shifted_char_code = ((char_code - ord('a') + 5) % 26) + ord('a')\n            encoded_chars.append(chr(shifted_char_code))\n        else:\n            encoded_chars.append(chr(char_code))\n    return \"\".join(encoded_chars)\n\n\ndef decode_shift(s: str) -> str:\n    \"\"\"\n    Decodes a string encoded with encode_shift, shifting each lowercase English alphabet character by 5 positions backward.\n    Non-lowercase English alphabet characters are unchanged.\n    \"\"\"\n    decoded_chars = []\n    for char_code in map(ord, s):\n        if ord('a') <= char_code <= ord('z'):\n            shifted_char_code = ((char_code - ord('a') - 5) % 26) + ord('a')\n            decoded_chars.append(chr(shifted_char_code))\n        else:\n            decoded_chars.append(chr(char_code))\n    return \"\".join(decoded_chars)\n```"}
