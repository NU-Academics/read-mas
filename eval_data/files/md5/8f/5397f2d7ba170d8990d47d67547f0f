{"task_id": "HumanEval/98", "solution": "```python\ndef count_upper(s):\n    \"\"\"\n    Given a string s, count the number of uppercase vowels in even indices.\n\n    For example:\n    count_upper('aBCdEf') returns 1\n    count_upper('abcdefg') returns 0\n    count_upper('dBBE') returns 0\n    \"\"\"\n    count = 0\n    vowels = 'AEIOU' # Define uppercase vowels for easy lookup\n\n    for i in range(len(s)):\n        # Check if the current index is even\n        if i % 2 == 0:\n            char = s[i]\n            # Check if the character at the even index is an uppercase vowel\n            if char in vowels:\n                count += 1\n    return count\n```"}
{"task_id": "HumanEval/99", "solution": "```python\ndef closest_integer(value: str) -> int:\n    \"\"\"\n    Create a function that takes a value (string) representing a number\n    and returns the closest integer to it. If the number is equidistant\n    from two integers, round it away from zero.\n    \"\"\"\n    num = float(value)\n    if num >= 0:\n        # For non-negative numbers, this rounds half up, which is away from zero for X.5.\n        return int(num + 0.5)\n    else:\n        # For negative numbers, this rounds half down, which is away from zero for X.5.\n        return int(num - 0.5)\n```"}
{"task_id": "HumanEval/99", "solution": "```python\nimport math\n\ndef closest_integer(value):\n    '''\n    Create a function that takes a value (string) representing a number\n    and returns the closest integer to it. If the number is equidistant\n    from two integers, round it away from zero.\n\n    Examples:\n    >>> closest_integer(\"10\")\n    10\n    >>> closest_integer(\"15.3\")\n    15\n    >>> closest_integer(\"14.5\")\n    15\n    >>> closest_integer(\"-14.5\")\n    -15\n    >>> closest_integer(\"-15.3\")\n    -15\n    '''\n    num_float = float(value)\n\n    # If the number is already an integer, return it directly\n    if num_float == int(num_float):\n        return int(num_float)\n\n    # Calculate floor and ceiling\n    floor_val = math.floor(num_float)\n    ceil_val = math.ceil(num_float)\n\n    # Calculate distances to floor and ceiling\n    dist_to_floor = abs(num_float - floor_val)\n    dist_to_ceil = abs(num_float - ceil_val)\n\n    # Determine the closest integer based on rules\n    if dist_to_floor < dist_to_ceil:\n        return int(floor_val)\n    elif dist_to_ceil < dist_to_floor:\n        return int(ceil_val)\n    else:  # Equidistant, fractional part is 0.5\n        # Round away from zero\n        if num_float > 0:\n            return int(ceil_val)\n        else:\n            return int(floor_val)\n```"}
{"task_id": "HumanEval/91", "solution": "```python\nimport re\n\ndef is_bored(S):\n    \"\"\"\n    You'll be given a string of words, and your task is to count the number\n    of boredoms. A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n\n    For example:\n    >>> is_bored(\"Hello world\")\n    0\n    >>> is_bored(\"The sky is blue. The sun is shining. I love this weather\")\n    1\n    \"\"\"\n    def _split_into_sentences(text: str, delimiters: str) -> list[str]:\n        \"\"\"Splits a string into sentences using provided delimiters.\n        Filters out empty strings and strips whitespace from each sentence.\n        \"\"\"\n        delimiter_pattern = f\"[{re.escape(delimiters)}]+\"\n        sentences = re.split(delimiter_pattern, text)\n        return [s.strip() for s in sentences if s.strip()]\n\n    def _starts_with_i(sentence: str) -> bool:\n        \"\"\"Checks if a sentence starts with the word 'I' (case-sensitive, whole word).\n        It considers 'I ' or 'I' as starting with the word 'I'.\n        \"\"\"\n        cleaned_sentence = sentence.strip()\n        return cleaned_sentence.startswith(\"I \") or cleaned_sentence == \"I\"\n\n    if not S:\n        return 0\n\n    boredom_count = 0\n    # Fixed delimiters as per problem description and design.\n    sentences = _split_into_sentences(S, \".?!\")\n\n    for sentence in sentences:\n        if _starts_with_i(sentence):\n            boredom_count += 1\n\n    return boredom_count\n\n```"}
