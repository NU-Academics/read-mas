olution": "def lps(input_string: str) -> int:\n    \"\"\"\n    Calculates the length of the longest palindromic subsequence in the given string.\n    Uses dynamic programming to build up the solution from smaller substrings.\n    \"\"\"\n    n = len(input_string)\n\n    # dp[i][j] stores the length of the longest palindromic subsequence\n    # for the substring input_string[i...j].\n    dp = [[0] * n for _ in range(n)]\n\n    # All single characters are palindromic subsequences of length 1.\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the DP table for substrings of increasing lengths.\n    for length in range(2, n + 1):\n        for i in range(n - length + 1):\n            j = i + length - 1\n            if input_string[i] == input_string[j]:\n                # If characters match, they contribute 2 to the LPS.\n                # The remaining length comes from the inner substring.\n                dp[i][j] = 2 + (dp[i + 1][j - 1] if i + 1 <= j - 1 else 0)\n            else:\n                # If characters don't match, take the maximum LPS\n                # by either excluding input_string[i] or input_string[j].\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n    # The result for the entire string is stored at dp[0][n-1].\n    return dp[0][n - 1]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/162": [{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"Calculates the sum of the series (n - 2*i) for i from 0 up to n // 2,\n    including terms where (n - 2*i) is greater than or equal to 0.\n    \"\"\"\n    total_sum = 0\n    for i in range(n // 2 + 1):\n        term = n - 2 * i\n        if term >= 0:\n            total_sum += term\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/123": [{"task_id": "Mbpp/123", "solution": "def _get_proper_divisors_sum(n: int) -> int:\n    \"\"\"\n    C