t string into groups and computes their depths.\"\"\"\n    def parse(self, input_string_obj: InputString) -> List[Group]:\n        processed_groups: List[Group] = []\n        depth_calculator = DepthCalculator()\n\n        if input_string_obj.value == '':\n            return processed_groups\n\n        group_strings = input_string_obj.value.split(' ')\n\n        for i, group_str in enumerate(group_strings):\n            group = Group(value=group_str, index=i)\n            group.maxDepth = depth_calculator.computeMaxDepth(group)\n            processed_groups.append(group)\n        \n        return processed_groups\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    input_string = InputString(paren_string)\n    parser = Parser()\n    \n    groups_with_depths = parser.parse(input_string) \n    \n    result_list = ResultList()\n    for group in groups_with_depths:\n        result_list.append(group.maxDepth)\n    \n    return result_list.as_list()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/4": [{"task_id": "HumanEval/4", "solution": "from typing import List\nfrom dataclasses import dataclass\nclass Statistics:\n    @staticmethod\n    def mean(numbers: List[float]) -> float:\n        # Computes the arithmetic mean of a list of numbers.\n        return sum(numbers) / len(numbers)\nclass MeanAbsoluteDeviation:\n    @staticmethod\n    def compute(numbers: List[float]) -> float:\n        # Calculates the Mean Absolute Deviation for a list of numbers around their mean.\n        mean_value = Statistics.mean(numbers)\n        abs_diffs = [abs(x - mean_value) for x in numbers]\n        mad = sum(abs_diffs) / len(abs_diffs)\n        return mad\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    return MeanAbsoluteDeviation.compute(numbers)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/0": [{"task_id": "HumanEval/0", "solution": "from typing import List\ndef compute(numbers, threshold) -> bool:\n    \"\"\"Perform pairwise closeness check using nested iteration.\"\"\"\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(float(numbers[i]) - float(numbers[j])) < threshold:\n                return True\n    return False\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    validate_input(numbers, threshold)\n    if len(numbers) < 2:\n        return False\n    return compute(numbers, threshold)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1.0, 2.0, 3.9, 4.0, 5.0, 2.2], 0.3]], "plus_fail_tests": [[[1.0, 2.5, 3.0, 4.5, 5.0, 6.5], 0.4]]}], "HumanEval/1": [{"task_id": "HumanEval/1", "solution": "class InputString:\n    \"\"\"Holds raw input and provides a normalized (whitespace-removed) string.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n        self.normalized = \"\"\n\n    def removeWhitespace(self) -> str:\n        \"\"\"Removes all whitespace characters from the raw string and sets self.normalized.\"\"\"\n        self.normalized = \"\".join(char for char in self.raw if not char.isspace())\n        return self.normalized\nclass ParenthesisGroup:\n    \"\"\"Represents a top-level balanced parentheses group with content and position metadata.\"\"\"\n    def __init__(self, content: str, startIndex: int, endIndex: int):\n        self.content = content\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n\n    def isBalanced(self) -> bool:\n        \"\"\"Checks if the group's content is balanced.\"\"\"\n        balance = 0\n        for char in self.content:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\nclass ResultList:\n    \"\"\"Collects and orders ParenthesisGroup content strings.\"\"\"\n    def __init__(self):\n        self.groups: List[str] = []\n\n    def toList(self) -> List[str]:\n        \"\"\"Returns the collected group strings as a list.\"\"\"\n        return self.groups\nclass Parser:\n    \"\"\"Parses a normalized InputString and extracts top-level ParenthesisGroup instances.\"\"\"\n    def __init__(self):\n        self.input_string: InputString = None\n        self.groups: List[ParenthesisGroup] = []\n        self._pos: int = 0\n\n    def parse(self, s: InputString) -> ResultList:\n        \"\"\"Parses the normalized input and produces a ResultList.\"\"\"\n        self.input_string = s\n        self._pos = 0\n        self.extractGroups()\n\n        result_list = ResultList()\n        for group in self.groups:\n            if group.isBalanced():\n                result_list.groups.append(group.content)\n        return result_list\n\n    def extractGroups(self) -> List[ParenthesisGroup]:\n        \"\"\"Scans the normalized string and identifies top-level balanced groups.\"\"\"\n        normalized_str = self.input_string.normalized\n        while self._pos < len(normalized_str):\n            if normalized_str[self._pos] == '(':\n                start_index = self._pos\n                balance = 0\n                temp_pos = self._pos\n                while temp_pos < len(normalized_str):\n                    if normalized_str[temp_pos] == '(':\n                        balance += 1\n                    elif normalized_str[temp_pos] == ')':\n                        balance -= 1\n\n                    if balance == 0:\n                        end_index = temp_pos + 1\n                        content = normalized_str[start_index:end_index]\n                        self.groups.append(ParenthesisGroup(content, start_index, end_index))\n                        self._pos = end_index\n                        break\n                    temp_pos += 1\n                else:  # If a top-level group isn't closed, advance past it\n                    self._pos = temp_pos\n            else:\n                self._pos += 1\n        return self.groups\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    input_str_obj = InputString(raw=paren_string)\n    input_str_obj.removeWhitespace()\n\n    parser = Parser()\n    result_list = parser.parse(input_str_obj)\n\n    return result_list.toList()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/5": [{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/2": [{"task_id": "HumanEval/2", "solution": "from math import floor\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    integer_part: int = floor(number)\n    decimal_part: float = number - integer_part\n    return decimal_part", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/3": [{"task_id": "HumanEval/3", "solution": "from typing import List, Optional, Any\nclass Operation:\n    \"\"\"Holds an operation amount and its sequence index.\"\"\"\n    def __init__(self, amount: int, seq: int) -> None:\n        self.amount = amount\n        self.seq = seq\n\n    def isDeposit(self) -> bool:\n        \"\"\"Checks if the operation is a deposit.\"\"\"\n        return self.amount > 0\n\n    def isWithdrawal(self) -> bool:\n        \"\"\"Checks if the operation is a withdrawal.\"\"\"\n        return self.amount < 0\nclass OperationList:\n    \"\"\"Represents an ordered sequence of Operation objects.\"\"\"\n    def __init__(self, operations: List[Operation]) -> None:\n        self.operations = operations\n        self.index = 0\n\n    @classmethod\n    def from_int_list(cls, values: List[int]) -> 'OperationList':\n        \"\"\"Factory method to create OperationList from a list of integers.\"\"\"\n        operations = [Operation(amount, i) for i, amount in enumerate(values)]\n        return cls(operations)\n\n    def hasNext(self) -> bool:\n        \"\"\"Checks if there are more operations to process.\"\"\"\n        return self.index < len(self.operations)\n\n    def next(self) -> 'Operation':\n        \"\"\"Returns the next operation and advances the index.\"\"\"\n        if not self.hasNext():\n            raise StopIteration(\"No more operations in the list.\")\n        op = self.operations[self.index]\n        self.index += 1\n        return op\nclass Result:\n    \"\"\"Represents the outcome of account processing.\"\"\"\n    def __init__(self, negativeDetected: bool, detectedAtSeq: Optional[int]) -> None:\n        self.negativeDetected = negativeDetected\n        self.detectedAtSeq = detectedAtSeq\n\n    def to_bool(self) -> bool:\n        \"\"\"Adapts the result to a boolean for API consumption.\"\"\"\n        return self.negativeDetected\nclass Account:\n    \"\"\"Manages the account balance and processes operations.\"\"\"\n    def __init__(self) -> None:\n        self._balance: int = 0\n\n    def initialize(self) -> None:\n        \"\"\"Sets the account balance to zero.\"\"\"\n        self._balance = 0\n\n    def applyOperation(self, op: Operation) -> None:\n        \"\"\"Applies a single operation to the account balance.\"\"\"\n        self._balance += op.amount\n\n    def getBalance(self) -> int:\n        \"\"\"Returns the current account balance.\"\"\"\n        return self._balance\n\n    def process(self, op_list: OperationList) -> Result:\n        \"\"\"Processes a list of operations, stopping if balance goes below zero.\"\"\"\n        while op_list.hasNext():\n            op = op_list.next()\n            self.applyOperation(op)\n            if self.getBalance() < 0:\n                return Result(True, op.seq)\n        return Result(False, None)\ndef validate_operations_list(operations: Any) -> List[int]:\n    \"\"\"Validates that input operations are a list or tuple of integers.\"\"\"\n    if not isinstance(operations, (list, tuple)):\n        raise ValueError(\"Input operations must be a list or tuple.\")\n    \n    validated_list: List[int] = []\n    for item in operations:\n        if not isinstance(item, int):\n            raise ValueError(\"All operations must be integers.\")\n        validated_list.append(item)\n    return validated_list\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"\n    Detects if a bank account balance, starting at zero, ever falls below zero.\n    Returns True if balance goes below zero, False otherwise.\n    \"\"\"\n    validated = validate_operations_list(operations)\n    op_list = OperationList.from_int_list(validated)\n    account = Account()\n    account.initialize()\n    result = account.process(op_list)\n    return result.to_bool()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/9": [{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_max_list = []\n    current_max_val = numbers[0]\n\n    for number in numbers:\n        if number > current_max_val:\n            current_max_val = number\n        rolling_max_list.append(current_max_val)\n\n    return rolling_max_list", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/13": [{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    # Ensure numbers are non-negative for the Euclidean algorithm.\n    # The GCD of (a, b) is the same as GCD(|a|, |b|).\n    a = abs(a)\n    b = abs(b)\n\n    # Euclidean algorithm\n    while b:\n        a, b = b, a % b\n    return a", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/8": [{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    sum_acc: int = 0\n    prod_acc: int = 1\n    for x in numbers:\n        sum_acc += x\n        prod_acc *= x\n    return (sum_acc, prod_acc)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/10": [{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    # Find the starting index of the longest palindromic suffix.\n    # This means finding the smallest index `i` such that string[i:] is a palindrome.\n    longest_pal_suffix_start_idx = 0\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            longest_pal_suffix_start_idx = i\n            break\n\n    # The prefix is the portion of the original string before this suffix.\n    prefix = string[:longest_pal_suffix_start_idx]\n\n    # Append the reverse of this prefix to the original string to form the palindrome.\n    return string + prefix[::-1]", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["x"]], "plus_fail_tests": [["race"]]}], "HumanEval/11": [{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n\n    def validate_chars(s: str) -> bool:\n        \"\"\"Returns True if s contains only '0' and '1'; False otherwise.\"\"\"\n        for char in s:\n            if char not in ('0', '1'):\n                return False\n        return True\n\n    def validate_equal_length(a: str, b: str) -> bool:\n        \"\"\"Returns True if len(a) == len(b); False otherwise.\"\"\"\n        return len(a) == len(b)\n\n    def compute_xor(a: str, b: str) -> str:\n        \"\"\"Computes XOR of two equal-length binary strings, returning the result as a string.\"\"\"\n        result_chars = []\n        for i in range(len(a)):\n            if a[i] == b[i]:\n                result_chars.append('0')\n            else:\n                result_chars.append('1')\n        return \"\".join(result_chars)\n\n    if not validate_chars(a) or not validate_chars(b):\n        raise ValueError(\"input contains non-binary characters\")\n\n    if not validate_equal_length(a, b):\n        raise ValueError(\"input strings have differing lengths\")\n\n    return compute_xor(a, b)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/12": [{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    current_longest_str = strings[0]\n    max_length = len(strings[0])\n\n    for s in strings[1:]:\n        if len(s) > max_length:\n            max_length = len(s)\n            current_longest_str = s\n\n    return current_longest_str", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/23": [{"task_id": "HumanEval/23", "solution": "def strlen(string: str) -> int:\n    \"\"\" Return length of given string\n    >>> strlen('')\n    0\n    >>> strlen('abc')\n    3\n    \"\"\"\n    return len(string)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/22": [{"task_id": "HumanEval/22", "solution": "from typing import List, Any\ndef filter_integers(values: List[Any]) -> List[int]:\n    \"\"\" Filter given list of any python values only for integers\n    >>> filter_integers(['a', 3.14, 5])\n    [5]\n    >>> filter_integers([1, 2, 3, 'abc', {}, []])\n    [1, 2, 3]\n    \"\"\"\n    result = []\n    for item in values:\n        if type(item) is int:\n            result.append(item)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/20": [{"task_id": "HumanEval/20", "solution": "from typing import List, Tuple\nfrom dataclasses import dataclass\nclass Result:\n    \"\"\"Converts a NumberPair into an output tuple, ensuring ascending order.\"\"\"\n    def __init__(self, pair: NumberPair) -> None:\n        \"\"\"Initializes with a NumberPair.\"\"\"\n        self.pair = pair\n\n    def to_tuple(self) -> Tuple[float, float]:\n        \"\"\"Returns the numbers as a tuple (smaller, larger).\"\"\"\n        return tuple(sorted((self.pair.first, self.pair.second)))\ndef find