first_word_obj = Word(first_word_str)\n            max_unique_char_count = first_word_obj.compute_unique_count()\n            best_word_value = first_word_str\n            \n            # Iterate from the second word to find the maximum\n            for i in range(1, input_list_obj.size()):\n                word_str = input_list_obj.words[i]\n                current_word_obj = Word(word_str)\n                current_unique_count = current_word_obj.compute_unique_count()\n\n                if current_unique_count > max_unique_char_count:\n                    max_unique_char_count = current_unique_count\n                    best_word_value = word_str\n                elif current_unique_count == max_unique_char_count:\n                    # Apply lexicographical tie-breaker\n                    if word_str < best_word_value:\n                        best_word_value = word_str\n        else:\n            # If the input list is empty, return an empty string as per unspecified behavior\n            best_word_value = \"\"\n\n        final_result = Result(best_word_value)\n        return final_result.value\ndef find_max(words: list[str]) -> str:\n    \"\"\"Finds the word with the maximum number of unique characters.\n    If multiple strings tie, returns the lexicographically smallest.\n    \"\"\"\n    finder = Finder()\n    return finder.find_max(words)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/159": [{"task_id": "HumanEval/159", "solution": "from typing import Any\nclass EatRequest:\n    \"\"\"Immutable carrier for number and need.\"\"\"\n    def __init__(self, number: int, need: int):\n        self.number = number\n        self.need = need\nclass Inventory:\n    \"\"\"Immutable carrier for remaining.\"\"\"\n    def __init__(self, remaining: int):\n        self.remaining = remaining\nclass EatResult:\n    \"\"\"Immutable carrier for total_eaten and remaining_after_meals.\"\"\"\n    def __init__(self, total_eaten: int, remaining_after_meals: int):\n        self.total_eaten = total_eaten\n        self.remaining_after_meals = remaining_after_meals\nclass InputValidator:\n    \"\"\"Stateless validation of number, need, remaining arguments.\"\"\"\n    @staticmethod\n    def validate(number: Any, need: Any, remaining: Any) -> None:\n        _validate_int_range(\"number\", number)\n        _validate_int_range(\"need\", need)\n        _validate_int_range(\"remaining\", remaining)\nclass Calculator:\n    \"\"\"Computes consumed, total_eaten, and remaining_after_meals.\"\"\"\n    def compute(self, request: EatRequest, inventory: Inventory) -> EatResult:\n        consumed = min(request.need, inventory.remaining)\n        total_eaten = request.number + consumed\n        remaining_after_meals = inventory.remaining - consumed\n        return EatResult(total_eaten=total_eaten, remaining_after_meals=remaining_after_meals)\nclass EatService:\n    \"\"\"Orchestrates computation by calling Calculator.\"\"\"\n    def __init__(self):\n        self._calculator = Calculator()\n\n    def eat(self, request: EatRequest, inventory: Inventory) -> EatResult:\n        return self._calculator.compute(request, inventory)\ndef eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n    \n    Example:\n    * eat(5, 6, 10) -> [11, 4]\n    * eat(4, 8, 9) -> [12, 1]\n    * eat(1, 10, 10) -> [11, 0]\n    * eat(2, 11, 5) -> [7, 0]\n    \n    Variables:\n    @number : integer\n        the number of carrots that you have eaten.\n    @need : integer\n        the number of carrots that you need to eat.\n    @remaining : integer\n        the number of remaining carrots thet exist in stock\n    \n    Constrain:\n    * 0 <= number <= 1000\n    * 0 <= need <= 1000\n    * 0 <= remaining <= 1000\n\n    Have fun :)\n    \"\"\"\n    InputValidator.validate(number, need, remaining)\n    request = EatRequest(number=number, need=need)\n    inventory = Inventory(remaining=remaining)\n    service = EatService()\n    result = service.eat(request, inventory)\n    return [result.total_eaten, result.remaining_after_meals]", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[5, 6, 10]], "plus_fail_tests": [[0, 0, 0]]}], "HumanEval/160": [{"task_id": "HumanEval/160", "solution": "from typing import List, Any, Union\nclass OperatorList:\n    \"\"\"Encapsulates a list of operator tokens.\"\"\"\n    def __init__(self, operators: List[str]):\n        self.operators = operators\n\n    def count(self) -> int:\n        \"\"\"Returns the number of operators.\"\"\"\n        return len(self.operators)\nclass OperandList:\n    \"\"\"Encapsulates a list of operand integers.\"\"\"\n    def __init__(self, operands: List[int]):\n        self.operands = operands\n\n    def count(self) -> int:\n        \"\"\"Returns the number of operands.\"\"\"\n        return len(self.operands)\nclass Token:\n    \"\"\"Represents a token in the expression (operand or operator).\"\"\"\n    def __init__(self, type: str, value: Any):\n        self.type = type\n        self.value = value\nclass Expression:\n    \"\"\"Holds the built expression's tokens and infix representation.\"\"\"\n    def __init__(self, tokens: List[Token], infixRepresentation: str):\n        self.tokens = tokens\n        self.infixRepresentation = infixRepresentation\nclass Result:\n    \"\"\"Represents a successful evaluation result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\nclass Error:\n    \"\"\"Represents an error with a code and message.\"\"\"\n    def __init__(self, code: str, message: str):\n        self.code = code\n        self.message = message\nclass Validator:\n    \"\"\"Validates operator and operand lists according to rules.\"\"\"\n    allowed_operators = {'+', '-', '*', '//', '**'}\n\n    def validateCounts(self, operator_list: OperatorList, operand_list: OperandList) -> Union[Result, Error]:\n        \"\"\"Validates the count relationship between operators and operands.\"\"\"\n        if operator_list.count() != operand_list.count() - 1:\n            return Error(code='COUNT_MISMATCH', message='Operator count must be one less than operand count.')\n        if operand_list.count() < 2:\n            return Error(code='MIN_OPERANDS', message='Operand list must have at least two operands.')\n        return Result(value=0)\n\n    def validateOperators(self, operator_list: OperatorList) -> Union[Result, Error]:\n        \"\"\"Validates all operator tokens are allowed strings.\"\"\"\n        for op in operator_list.operators:\n            if not isinstance(op, str) or op not in self.allowed_operators:\n                return Error(code='INVALID_OPERATOR', message=f'Invalid operator token: {op}')\n        return Result(value=0)\n\n    def validateOperands(self, operand_list: OperandList) -> Union[Result, Error]:\n        \"\"\"Validates all operands are non-negative integers.\"\"\"\n        for opnd in operand_list.operands:\n            if not isinstance(opnd, int) or opnd < 0:\n                return Error(code='INVALID_OPERAND', message=f'Operand must be a non-negative integer: {opnd}')\n        return Result(value=0)\nclass ExpressionBuilder:\n    \"\"\"Builds an Expression object by interleaving operands and operators.\"\"\"\n    def build(self, operand_list: OperandList, operator_list: OperatorList) -> Expression:\n        \"\"\"Constructs an Expression from operand and operator lists.\"\"\"\n        tokens: List[Token] = []\n        infix_parts: List[str] = []\n\n        for i in range(operand_list.count()):\n            tokens.append(Token(type='operand', value=operand_list.operands[i]))\n            infix_parts.append(str(operand_list.operands[i]))\n            if i < operator_list.count():\n                tokens.append(Token(type='operator', value=operator_list.operators[i]))\n                infix_parts.append(operator_list.operators[i])\n\n        return Expression(tokens=tokens, infixRepresentation=\" \".join(infix_parts))\nclass Evaluator:\n    \"\"\"Evaluates an Expression token stream respecting operator precedence and associativity.\"\"\"\n    def _apply_operation(self, op: str, val1: int, val2: int) -> Union[int, Error]:\n        \"\"\"Applies a single arithmetic operation.\"\"\"\n        if op == '+':\n            return val1 + val2\n        elif op == '-':\n            return val1 - val2\n        elif op == '*':\n            return val1 * val2\n        elif op == '//':\n            if val2 == 0:\n                return Error(code='DIV_BY_ZERO', message='Division by zero encountered.')\n            return val1 // val2\n        elif op == '**':\n            return val1 ** val2\n        return Error(code='UNKNOWN_OPERATOR', message=f'Unknown operator: {op}')\n\n    def evaluate(self, expression: Expression) -> Union[int, Error]:\n        \"\"\"Evaluates the expression token stream using precedence rules.\"\"\"\n        tokens_list = list(expression.tokens)\n\n        # Pass 1: Exponentiation (right-associative) - process from right-to-left\n        i = len(tokens_list) - 2 \n        while i >= 1: \n            if tokens_list[i].type == 'operator' and tokens_list[i].value == '**':\n                if tokens_list[i-1].type != 'operand' or tokens_list[i+1].type != 'operand':\n                    return Error(code='MALFORMED_EXPRESSION', message='Malformed expression around ** operator.')\n                \n                val1 = tokens_list[i-1].value\n                op_val = tokens_list[i].value\n                val2 = tokens_list[i+1].value\n\n                result = self._apply_operation(op_val, val1, val2)\n                if isinstance(result, Error):\n                    return result\n                \n                tokens_list[i-1:i+2] = [Token(type='operand', value=result)]\n                i -= 1 \n            i -= 1 \n\n        # Pass 2: Multiplication and Floor Division (left-associative) - process from left-to-right\n        i = 1 \n        while i < len(tokens_list) - 1: \n            if tokens_list[i].type == 'operator' and tokens_list[i].value in ['*', '//']:\n                if tokens_list[i-1].type != 'operand' or tokens_list[i+1].type != 'operand':\n                    return Error(code='MALFORMED_EXPRESSION', message='Malformed expression around * or // operator.')\n                \n                val1 = tokens_list[i-1].value\n                op_val = tokens_list[i].value\n                val2 = tokens_list[i+1].value\n\n                result = self._apply_operation(op_val, val1, val2)\n                if isinstance(result, Error):\n                    return result\n                \n                tokens_list[i-1:i+2] = [Token(type='operand', value=result)]\n                i -= 1 \n            else:\n                i += 1\n        \n        # Pass 3: Addition and Subtraction (left-associative) - process from left-to-right\n        i = 1 \n        while i < len(tokens_list) - 1: \n            if tokens_list[i].type == 'operator' and tokens_list[i].value in ['+', '-']:\n                if tokens_list[i-1].type != 'operand' or tokens_list[i+1].type != 'operand':\n                    return Error(code='MALFORMED_EXPRESSION', message='Malformed expression around + or - operator.')\n                \n                val1 = tokens_list[i-1].value\n                op_val = tokens_list[i].value\n                val2 = tokens_list[i+1].value\n\n                result = self._apply_operation(op_val, val1, val2)\n                if isinstance(result, Error):\n                    return result\n                \n                tokens_list[i-1:i+2] = [Token(type='operand', value=result)]\n                i -= 1 \n            else:\n                i += 1\n        \n        if len(tokens_list) != 1 or tokens_list[0].type != 'operand':\n            return Error(code='EVALUATION_ERROR', message='Expression could not be fully evaluated or is malformed.')\n        \n        return tokens_list[0].value\ndef do_algebra(operator: List[str], operand: List[int]) -> Union[int, Error]:\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n\n    The basic algebra operations:\n    Addition ( + ) \n    Subtraction ( - ) \n    Multiplication ( * ) \n    Floor division ( // ) \n    Exponentiation ( ** ) \n\n    Example:\n    operator['+', '*', '-']\n    array = [2, 3, 4, 5]\n    result = 2 + 3 * 4 - 5\n    => result = 9\n\n    Note:\n        The length of operator list is equal to the length of operand list minus one.\n        Operand is a list of of non-negative integers.\n        Operator list has at least one operator, and operand list has at least two operands.\n\n    \"\"\"\n    op_list = OperatorList(operators=operator)\n    od_list = OperandList(operands=operand)\n\n    validator = Validator()\n    \n    res = validator.validateCounts(op_list, od_list)\n    if isinstance(res, Error):\n        return res\n    \n    res = validator.validateOperators(op_list)\n    if isinstance(res, Error):\n        return res\n    \n    res = validator.validateOperands(od_list)\n    if isinstance(res, Error):\n        return res\n    \n    builder = ExpressionBuilder()\n    expr = builder.build(od_list, op_list)\n    \n    evaluator = Evaluator()\n    eval_res = evaluator.evaluate(expr)\n    \n    return eval_res", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/162": [{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n\n    >>> string_to_md5('Hello world') == '3e25960a79dbc69b674cd4ec67a72c62'\n    \"\"\"\n    if not text:\n        return None\n    \n    # Encode the string to bytes using UTF-8 as specified in the design.\n    text_bytes = text.encode('utf-8')\n    \n    # Compute the MD5 hash and return its hexadecimal representation.\n    return hashlib.md5(text_bytes).hexdigest()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/161": [{"task_id": "HumanEval/161", "solution": "class InputString:\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\nclass Character:\n    def __init__(self, value: str, position: int):\n        self.value = value\n        self.position = position\n        if self.value.isalpha():\n            self.caseType = 'upper' if self.value.isupper() else 'lower'\n        else:\n            self.caseType = 'non-letter'\n\n    def isLetter(self) -> bool:\n        return self.value.isalpha()\nclass OutputString:\n    def __init__(self, value: str):\n        self.value = value\nclass Processor:\n    def process(self, input_string: InputString) -> OutputString:\n        if input_string.length() == 0:\n            return OutputString(value=\"\")\n\n        if not self.containsLetter(input_string):\n            return self.reverseString(input_string)\n        else:\n            processed_chars = []\n            for i, char_val in enumerate(input_string.value):\n                char_obj = Character(value=char_val, position=i)\n                if char_obj.isLetter():\n                    transformed_char_obj = self.invertCase(char_obj)\n                    processed_chars.append(transformed_char_obj.value)\n                else:\n                    processed_chars.append(char_obj.value)\n            return OutputString(value=\"\".join(processed_chars))\n\n    def containsLetter(self, input_string: InputString) -> bool:\n        for char_val in input_string.value:\n            if char_val.isalpha():\n                return True\n        return False\n\n    def reverseString(self, input_string: InputString) -> OutputString:\n        return OutputString(value=input_string.value[::-1])\n\n    def invertCase(self, character: Character) -> Character:\n        if character.value.islower():\n            return Character(value=character.value.upper(), position=character.position)\n        elif character.value.isupper():\n            return Character(value=character.value.lower(), position=character.position)\n        else:\n            return Character(value=character.value, position=character.position)\ndef solve(s):\n    \"\"\"\n    Reverses case of letters in a string, or reverses the string if no letters are present.\n    \"\"\"\n    input_obj = InputString(value=s)\n    out_obj = Processor().process(input_obj)\n    return out_obj.value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/163": [{"task_id": "HumanEval/163", "solution": "from typing import List, Set\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid inputs.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\nclass IntegerInput:\n    \"\"\"Encapsulates input integer representation and validation.\"\"\"\n    def __init__(self, value, source: str = 'caller'):\n        self.value = value\n        self.source = source\n\n    def validate(self) -> bool:\n        \"\"\"Validates that the input is an integer greater than zero.\"\"\"\n        return isinstance(self.value, int) and self.value > 0\nclass Range:\n    \"\"\"Computes inclusive numeric Range from two integer inputs and provides membership check.\"\"\"\n    def __init__(self, a: int, b: int):\n        self.min_val = min(a, b)\n        self.max_val = max(a, b)\n\n    def contains(self, n: int) -> bool:\n        \"\"\"Checks if a given number is within the inclusive range.\"\"\"\n        return self.min_val <= n <= self.max_val\nclass EvenDigitSet:\n    \"\"\"Defines the fixed single-digit even set {0,2,4,6,8} and provides filtering by Range.\"\"\"\n    def __init__(self):\n        self.digits: Set[int] = {0, 2, 4, 6, 8}\n\n    def filter(self, rng: Range) -> List[int]:\n        \"\"\"Filters the even digits that fall within the given range.\"\"\"\n        filtered = [digit for digit in self.digits if rng.contains(digit)]\n        return filtered\nclass Result:\n    \"\"\"Encapsulates the output list of digits with ordering semantics and emptiness check.\"\"\"\n    def __init__(self, digits: List[int]):\n        self.digits = sorted(digits) # Ensures ascending order on construction\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the result list is empty.\"\"\"\n        return len(self.digits) == 0\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns the stored digits as a list.\"\"\"\n        return self.digits\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    input_a = IntegerInput(a, 'a')\n    input_b = IntegerInput(b, 'b')\n\n    if not input_a.validate():\n        raise ValidationError(\"Input 'a' must be a positive integer.\")\n    if not input_b.validate():\n        raise ValidationError(\"Input 'b' must be a positive integer.\")\n\n    num_range = Range(input_a.value, input_b.value)\n    even_digit_set = EvenDigitSet()\n    candidate_digits = even_digit_set.filter(num_range)\n\n    result = Result(candidate_digits)\n    return result.to_list()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/94": [{"task_id": "HumanEval/94", "solution": "import math\nclass IntegerElement:\n    \"\"\"Represents one integer element with cached primality metadata and digit extraction.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n        self.isPrime: bool = None\n\n    def digits(self) -> list[int]:\n        \"\"\"Extracts the decimal digits of the integer value.\"\"\"\n        return [int(d) for d in str(self.value)]\nclass PrimeNumber(IntegerElement):\n    \"\"\"Represents an IntegerElement that is known to be prime.\"\"\"\n    def __init__(self, value: int) -> None:\n        super().__init__(value)\n        self.isPrime = True\nclass PrimeChecker:\n    \"\"\"Determines whether an IntegerElement is prime using trial division.\"\"\"\n    def isPrime(self, element: IntegerElement) -> bool:\n        \"\"\"Determines if an IntegerElement's value is prime.\"\"\"\n        n = element.value\n        if n <= 1:\n            element.isPrime = False\n            return False\n        if n == 2:\n            element.isPrime = True\n            return True\n        if n % 2 == 0:\n            element.isPrime = False\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                element.isPrime = False\n                return False\n            i += 2\n        element.isPrime = True\n        return True\nclass PrimeStore:\n    \"\"\"Stores identified PrimeNumber instances for retrieval.\"\"\"\n    def __init__(self) -> None:\n        self._primes: list[PrimeNumber] = []\n\n    def add(self, p: PrimeNumber) -> None:\n        \"\"\"Adds a PrimeNumber instance to the store.\"\"\"\n        self._primes.append(p)\n\n    def getAll(self) -> list[PrimeNumber]:\n        \"\"\"Returns all stored PrimeNumber instances.\"\"\"\n        return self._primes\nclass LargestSelector:\n    \"\"\"Selects the numerically largest PrimeNumber from a list.\"\"\"\n    def selectLargest(self, primes: list[PrimeNumber]) -> PrimeNumber:\n        \"\"\"Selects the numerically largest PrimeNumber from a list.\"\"\"\n        if not primes:\n            raise ValueError(\"No primes found in the list to select the largest from.\")\n        return max(primes, key=lambda p: p.value)\nclass DigitSummer:\n    \"\"\"Computes the decimal (base-10) digit-sum for a PrimeNumber.\"\"\"\n    def sumDigits(self, prime: PrimeNumber) -> int:\n        \"\"\"Computes the sum of the decimal digits of a PrimeNumber.\"\"\"\n        return sum(prime.digits())\ndef skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    prime_checker = PrimeChecker()\n    prime_store = PrimeStore()\n\n    for v in lst:\n        elem = IntegerElement(v)\n        if prime_checker.isPrime(elem):\n            prime_store.add(PrimeNumber(v))\n\n    primes = prime_store.getAll()\n\n    largest_prime = LargestSelector().selectLargest(primes)\n\n    sum_val = DigitSummer().sumDigits(largest_prime)\n\n    return sum_val", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/36": [{"task_id": "HumanEval/36", "solution": "class InputParameter:\n    \"\"\"Holds and validates the input parameter n.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\n    def validate(self) -> None:\n        \"\"\"Performs no validation by default, as per design.\"\"\"\n        pass\nclass IntegerCandidate:\n    \"\"\"Represents an integer k, providing divisibility tests and decimal representation.\"\"\"\n    def __init__(self, k: int):\n        self.k = k\n\n    def is_divisible_by_11_or_13(self) -> bool:\n        \"\"\"Checks if k is divisible by 11 or 13.\"\"\"\n        return (self.k % 11 == 0) or (self.k % 13 == 0)\n\n    def decimal_representation(self) -> str:\n        \"\"\"Returns the decimal string representation of k.\"\"\"\n        return str(self.k)\nclass DigitOccurrenceCounter:\n    \"\"\"Counts occurrences of a specific digit in a decimal string.\"\"\"\n    def __init__(self, digit: int):\n        self.digit = str(digit) # Store as string for direct comparison\n\n    def count_occurrences(self, decimal_repr: str) -> int:\n        \"\"\"Counts how many times the configured digit appears in the given string.\"\"\"\n        return decimal_repr.count(self.digit)\nclass Result:\n    \"\"\"Aggregates and provides the total count of digit occurrences.\"\"\"\n    def __init__(self):\n        self.total_count = 0\n\n    def add(self, count: int) -> None:\n        \"\"\"Adds a count to the total.\"\"\"\n        self.total_count += count\n\n    def to_int(self) -> int:\n        \"\"\"Returns the aggregated total count as an integer.\"\"\"\n        return self.total_count\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    input_param = InputParameter(n)\n    input_param.validate()\n\n    result_aggregator = Result()\n\n    for k in range(0, input_param.n):\n        candidate = IntegerCandidate(k)\n        if candidate.is_divisible_by_11_or_13():\n            decimal_repr = candidate.decimal_representation()\n            counter = DigitOccurrenceCounter(digit=7)\n            occurrences = counter.count_occurrences(decimal_repr)\n            result_aggregator.add(occurrences)\n\n    return result_aggregator.to_int()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "import sys\nclass Error(Exception):\n    \"\"\"\n    Custom error class for validation failures, providing a machine-readable code and message.\n    \"\"\"\n    def __init__(self, code: str, message: str):\n        self.code = code\n        self.message = message\n        super().__init__(f\"[{code}] {message}\")\nclass Cell:\n    \"\"\"\n    Represents a single cell within the grid, storing its value and coordinates.\n    \"\"\"\n    def __init__(self, value: int, row: int, col: int):\n        self.value = value\n        self.row = row\n        self.col = col\n\n    def neighbors(self, grid: 'Grid') -> list['Cell']:\n        \"\"\"\n        Returns a list of valid orthogonal (up, down, left, right) neighbor cells.\n        Neighbor cells must be within the grid boundaries.\n        \"\"\"\n        neighbors_list = []\n        # Define deltas for Up, Down, Left, Right moves\n        deltas = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n        for dr, dc in deltas:\n            n_row, n_col = self.row + dr, self.col + dc\n            # Check if the potential neighbor is within grid bounds\n            if 0 <= n_row < grid.N and 0 <= n_col < grid.N:\n                neighbors_list.append(grid.getCell(n_row, n_col))\n        return neighbors_list\nclass Path:\n    \"\"\"\n    Represents an ordered sequence of cells visited during a path traversal.\n    \"\"\"\n    def __init__(self, cells: list[Cell]):\n        self.cells = cells\n\n    def length(self) -> int:\n        \"\"\"\n        Returns the number of cells in the path.\n        \"\"\"\n        return len(self.cells)\n\n    def values(self) -> list[int]:\n        \"\"\"\n        Returns an ordered list of integer values from the cells in the path.\n        \"\"\"\n        return [cell.value for cell in self.cells]\nclass Grid:\n    \"\"\"\n    Represents the N x N game grid, composed of Cell objects.\n    \"\"\"\n    def __init__(self, raw_grid: list[list[int]]):\n        self.N = len(raw_grid)\n        # Initialize a 2D list to hold Cell objects\n        self.cells: list[list[Cell]] = [[None for _ in range(self.N)] for _ in range(self.N)]\n\n        # Populate the grid with Cell objects from the raw input values\n        for r in range(self.N):\n            for c in range(self.N):\n                self.cells[r][c] = Cell(raw_grid[r][c], r, c)\n\n    def getCell(self, row: int, col: int) -> Cell:\n        \"\"\"\n        Retrieves the Cell object at the specified row and column coordinates.\n        Assumes valid, in-bounds coordinates are provided by internal logic.\n        \"\"\"\n        return self.cells[row][col]\n\n    def containsAllValues(self) -> bool:\n        \"\"\"\n        Checks if the grid contains every integer from 1 to N*N exactly once.\n        \"\"\"\n        expected_values = set(range(1, self.N * self.N + 1))\n        actual_values = set()\n        for r in range(self.N):\n            for c in range(self.N):\n                actual_values.add(self.cells[r][c].value)\n        return actual_values == expected_values\nclass Validator:\n    \"\"\"\n    Provides methods for validating the grid structure, content, and path length k.\n    Raises an Error object on validation failure.\n    \"\"\"\n    def validateGrid(self, grid_obj: Grid) -> None:\n        \"\"\"\n        Validates the properties of the grid object, ensuring it's square (N>=2)\n        and contains unique values from 1 to N*N.\n        \"\"\"\n        if not (grid_obj.N >= 2):\n            raise Error(\"NON_SQUARE_GRID\", \"Grid must have N rows and N columns where N >= 2.\")\n        \n        if not grid_obj.containsAllValues():\n            raise Error(\"INVALID_VALUE_SET\", \"Grid must contain all integers from 1 to N*N exactly once.\")\n\n    def validateK(self, k: int) -> None:\n        \"\"\"\n        Validates that the path length k is a positive integer.\n        \"\"\"\n        if not (k > 0):\n            raise Error(\"INVALID_K\", \"Path length k must be a positive integer.\")\nclass PathFinder:\n    \"\"\"\n    Responsible for finding the lexicographically minimal path of length k in a given grid.\n    \"\"\"\n    def findMinPath(self, grid_obj: Grid, k: int) -> Path:\n        \"\"\"\n        Performs a Depth-First Search (DFS) to explore all paths of length k,\n        starting from every cell, and returns the unique lexicographically minimal path.\n        \"\"\"\n        best_path_cells: list[Cell] = None\n        best_path_values: list[int] = None # Stores values for lexicographical comparison\n\n        # Nested DFS helper function to find paths\n        def dfs(current_path_cells: list[Cell]):\n            nonlocal best_path_cells, best_path_values\n\n            # Base case: if the current path has reached the desired length k\n            if len(current_path_cells) == k:\n                current_values = [cell.value for cell in current_path_cells]\n                # If this is the first path found, or it's lexicographically smaller\n                if best_path_values is None or current_values < best_path_values:\n                    best_path_values = current_values\n                    best_path_cells = list(current_path_cells) # Store a copy to avoid modification issues\n                return\n\n            # Recursive step: extend the current path to neighbors\n            last_cell = current_path_cells[-1]\n            for neighbor in last_cell.neighbors(grid_obj):\n                # Recursively call DFS, appending the neighbor to a new list for the path\n                dfs(current_path_cells + [neighbor])\n\n        # Initiate DFS from every possible starting cell in the grid\n        for r in range(grid_obj.N):\n            for c in range(grid_obj.N):\n                start_cell = grid_obj.getCell(r, c)\n                dfs([start_cell]) # Start DFS with the initial cell in the path\n\n        return Path(best_path_cells)\n\n    def lexCompare(self, p1: Path, p2: Path) -> int:\n        \"\"\"\n        Compares two paths lexicographically based on their cell values.\n        Returns -1 if p1 < p2, 0 if p1 == p2, and 1 if p1 > p2.\n        \"\"\"\n        v1 = p1.values()\n        v2 = p2.values()\n        if v1 < v2:\n            return -1\n        elif v1 == v2:\n            return 0\n        else:\n            return 1\ndef minPath(grid: list[list[int]], k: int) -> list[int]:\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n    \"\"\"\n    \n    # Preliminary check for grid squareness and N>=2 before constructing Grid object\n    N_rows = len(grid)\n    if N_rows < 2:\n        raise Error(\"NON_SQUARE_GRID\", \"Input grid must have at least 2 rows (N >= 2).\")\n    \n    for row in grid:\n        if len(row) != N_rows:\n            raise Error(\"NON_SQUARE_GRID\", \"Input grid must be square (all rows must have the same length as the number of rows).\")\n\n    # Construct the Grid domain object\n    grid_obj = Grid(grid)\n    \n    # Validate the constructed grid and k using the Validator\n    validator = Validator()\n    validator.validateGrid(grid_obj) # Checks N>=2 and containsAllValues\n    validator.validateK(k)\n    \n    # Use the PathFinder to find the minimal path\n    path_finder = PathFinder()\n    min_path_obj = path_finder.findMinPath(grid_obj, k)\n    \n    # Return the list of values from the minimal path\n    return min_path_obj.values()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[12, 13, 10, 1], [9, 3, 15, 6], [5, 16, 14, 4], [11, 8, 7, 2]], 12]], "plus_fail_tests": [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], 15]]}], "HumanEval/130": [{"task_id": "HumanEval/130", "solution": "class InputValidator:\n    \"\"\"Validates input for non-negative integers.\"\"\"\n    def validateNonNegativeInteger(self, n) -> bool:\n        \"\"\"Returns True if n is an integer and non-negative, otherwise False.\"\"\"\n        return isinstance(n, int) and n >= 0\nclass SequenceResult:\n    \"\"\"Holds the generated sequence values.\"\"\"\n    def __init__(self, values: list[int]) -> None:\n        self.values = values\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the sequence.\"\"\"\n        return len(self.values)\nclass SequenceStore:\n    \"\"\"In-memory store for Tribonacci sequence values.\"\"\"\n    def __init__(self) -> None:\n        self._store = {}\n\n    def store(self, index: int, value: int) -> None:\n        \"\"\"Stores a value at a given index.\"\"\"\n        self._store[index] = value\n\n    def get(self, index: int) -> int:\n        \"\"\"Retrieves a value from a given index.\"\"\"\n        return self._store[index]\n\n    def as_list(self, max_index: int) -> list[int]:\n        \"\"\"Returns the stored values as a list up to max_index.\"\"\"\n        return [self._store[i] for i in range(max_index + 1)]\nclass TribonacciService:\n    \"\"\"Implements the Tribonacci sequence generation logic.\"\"\"\n    def __init__(self, validator: InputValidator, store: SequenceStore) -> None:\n        self.validator = validator # Not directly used by service's logic, but part of design contract\n        self.store = store\n\n    def computeValue(self, i: int) -> int:\n        \"\"\"Computes a single Tribonacci value based on its index.\"\"\"\n        if i == 0:\n            return 1\n        elif i == 1:\n            return 3\n        elif i % 2 == 0: # Even index rule\n            return 1 + i // 2\n        else: # Odd index rule\n            val_i_minus_1 = self.store.get(i - 1)\n            val_i_minus_2 = self.store.get(i - 2)\n            # Resolve tri(i+1) using the even-rule on-demand\n            val_i_plus_1_even_rule = 1 + (i + 1) // 2\n            return val_i_minus_1 + val_i_minus_2 + val_i_plus_1_even_rule\n\n    def generateSequence(self, n: int) -> SequenceResult:\n        \"\"\"Generates the Tribonacci sequence up to index n.\"\"\"\n        if n == 0:\n            self.store.store(0, 1)\n            return SequenceResult(self.store.as_list(0))\n\n        # Seed base values\n        self.store.store(0, 1) # tri(0) = 1\n        self.store.store(1, 3) # tri(1) = 3\n\n        # Iterate from 2 to n, computing and storing values\n        for i in range(2, n + 1):\n            value = self.computeValue(i)\n            self.store.store(i, value)\n\n        return SequenceResult(self.store.as_list(n))\ndef tri(n):\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in \n    the last couple centuries. However, what people don't know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8 \n    You are given a non-negative integer number n, you have to a return a list of the \n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n    # As per the function's docstring (\"You are given a non-negative integer number n\")\n    # and completion requirements (\"DO NOT add isinstance() checks or raise exceptions for edge cases\"),\n    # `n` is assumed to be a valid non-negative integer.\n    # The InputValidator and ErrorReport classes are defined as part of the overall design,\n    # but their explicit use for validation and error reporting in this specific function call path is omitted\n    # given the strict constraints about input validity and error handling for the final output.\n\n    # Instantiate core components\n    validator = InputValidator()\n    store = SequenceStore()\n    svc = TribonacciService(validator=validator, store=store)\n\n    # Generate the sequence\n    result = svc.generateSequence(n)\n    \n    return result.values", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/139": [{"task_id": "HumanEval/139", "solution": "class IntegerInput:\n    \"\"\"Represents and validates caller-supplied input n.\"\"\"\n    def __init__(self, value):\n        self.value: int = value\n\n    def is_valid(self) -> bool:\n        \"\"\"Returns True if the value is an integer and greater than 0.\"\"\"\n        return isinstance(self.value, int) and self.value > 0\nclass Result:\n    \"\"\"Container for the computed Brazilian factorial result.\"\"\"\n    def __init__(self, value: int):\n        self.value: int = value\nclass FactorialCalculator:\n    \"\"\"Computes k! for a given integer k >= 0.\"\"\"\n    def factorial(self, k: int) -> int:\n        \"\"\"Returns k! as a Python int.\"\"\"\n        if k < 0:\n            raise ValueError(\"Factorial is not defined for negative numbers.\")\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    input_n = IntegerInput(n)\n    if not input_n.is_valid():\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    calculator = FactorialCalculator()\n    brazilian_factorial_product = 1\n\n    for i in range(1, n + 1):\n        current_factorial = calculator.factorial(i)\n        brazilian_factorial_product *= current_factorial\n\n    final_result = Result(brazilian_factorial_product)\n    return final_result.value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]}}