des\ndef numerical_letter_grade(grades):\n    \"\"\"It is the last week of the semester and the teacher has to give the grades\n    to students. The teacher has been making her own algorithm for grading.\n    The only problem is, she has lost the code she used for grading.\n    She has given you a list of GPAs for some students and you have to write\n    a function that can output a list of letter grades using the following table:\n             GPA       |    Letter grade\n              4.0                A+\n            > 3.7                A\n            > 3.3                A-\n            > 3.0                B+\n            > 2.7                B\n            > 2.3                B-\n            > 2.0                C+\n            > 1.7                C\n            > 1.3                C-\n            > 1.0                D+\n            > 0.7                D\n            > 0.0                D-\n              0.0                E\n\n\n    Example:\n    grade_equation([4.0, 3, 1.7, 2, 3.5]) ==> ['A+', 'B', 'C-', 'C', 'A-']\n    \"\"\"\n    converter = _GradeConverter()\n    return converter.convert_grades(grades)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/86": [{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n\n    For example:\n    anti_shuffle('Hi') returns 'Hi'\n    anti_shuffle('hello') returns 'ehllo'\n    anti_shuffle('Hello World!!!') returns 'Hello !!!Wdlor'\n    \"\"\"\n    if not s:\n        return \"\"\n\n    tokens = s.split(' ')\n    result_tokens = []\n\n    for token in tokens:\n        if token:\n            sorted_chars = sorted(list(token), key=ord)\n            result_tokens.append(\"\".join(sorted_chars))\n        else:\n            result_tokens.append(\"\") # Preserve empty tokens for spaces\n\n    return \" \".join(result_tokens)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/24": [{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    for d in range(n - 1, 0, -1):\n        if n % d == 0:\n            return d", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/87": [{"task_id": "HumanEval/87", "solution": "import collections\nfrom typing import List, Tuple\nclass JaggedList:\n    \"\"\"\n    Domain container for rows built from the raw nested lists input.\n    \"\"\"\n    def __init__(self, raw: List[List[int]]) -> None:\n        self.rows: List[Row] = [Row(raw_row, i) for i, raw_row in enumerate(raw)]\n\n    def __len__(self) -> int:\n        return len(self.rows)\n\n    def get_row(self, index: int) -> 'Row':\n        return self.rows[index]\nclass Row:\n    \"\"\"\n    Represent a single inner list and its column Elements and row index.\n    \"\"\"\n    def __init__(self, raw_row: List[int], index: int) -> None:\n        self.elements: List[Element] = [Element(value, i) for i, value in enumerate(raw_row)]\n        self.index: int = index\n\n    def __len__(self) -> int:\n        return len(self.elements)\n\n    def get_element(self, index: int) -> 'Element':\n        return self.elements[index]\nclass Element:\n    \"\"\"\n    Value object for a cell value and its column index.\n    \"\"\"\n    def __init__(self, value: int, index: int) -> None:\n        self.value: int = value\n        self.index: int = index\nclass Coordinate:\n    \"\"\"\n    Represent a match coordinate (rowIndex, colIndex) and map to tuple output.\n    \"\"\"\n    def __init__(self, rowIndex: int, colIndex: int) -> None:\n        self.rowIndex: int = rowIndex\n        self.colIndex: int = colIndex\n\n    def to_tuple(self) -> Tuple[int,int]:\n        return (self.rowIndex, self.colIndex)\nclass GetRowFunction:\n    \"\"\"\n    Encapsulate validation (minimal), scanning algorithm, coordinate creation, sorting, and return.\n    \"\"\"\n    def __init__(self, lst_raw: List[List[int]], x: int) -> None:\n        self.lst: JaggedList = JaggedList(lst_raw)\n        self.x: int = x\n\n    def execute(self) -> List[Coordinate]:\n        \"\"\"\n        Scans the JaggedList for occurrences of x, creates Coordinates, and returns them sorted.\n        \"\"\"\n        found_coordinates: List[Coordinate] = []\n\n        for row_index in range(len(self.lst)):\n            current_row = self.lst.get_row(row_index)\n            for col_index in range(len(current_row)):\n                current_element = current_row.get_element(col_index)\n                if current_element.value == self.x:\n                    found_coordinates.append(Coordinate(row_index, col_index))\n\n        # Sort coordinates by (rowIndex ASC, colIndex DESC)\n        found_coordinates.sort(key=lambda coord: (coord.rowIndex, -coord.colIndex))\n        return found_coordinates\ndef get_row(lst, x):\n    \"\"\"\n    Finds integers x in the list and returns a list of coordinate tuples (row, column).\n    Coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n    get_row_service = GetRowFunction(lst, x)\n    result_coords = get_row_service.execute()\n    return [coord.to_tuple() for coord in result_coords]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/88": [{"task_id": "HumanEval/88", "solution": "import enum\nfrom typing import List, Optional\nclass InputArray:\n    \"\"\"Represents the input array and provides safe read-only accessors.\"\"\"\n    def __init__(self, values: List[int]):\n        self.values = values\n\n    def length(self) -> int:\n        return len(self.values)\n\n    def get_first(self) -> int:\n        return self.values[0]\n\n    def get_last(self) -> int:\n        return self.values[-1]\nclass ValidationResult:\n    \"\"\"Encapsulates the result of a validation operation.\"\"\"\n    def __init__(self, is_valid: bool, message: str = \"\"):\n        self.is_valid = is_valid\n        self.message = message\nclass SortOrder(enum.Enum):\n    \"\"\"Enumeration for sort order: ASCENDING or DESCENDING.\"\"\"\n    ASCENDING = 1\n    DESCENDING = 2\nclass Validator:\n    \"\"\"Validates that InputArray contains only non-negative integers.\"\"\"\n    def __init__(self):\n        self._result: ValidationResult = ValidationResult(True)\n\n    def validate_non_negative(self, input_array: InputArray) -> bool:\n        for element in input_array.values:\n            if not isinstance(element, int) or element < 0:\n                self._result = ValidationResult(\n                    False, \"Input array must contain only non-negative integers.\"\n                )\n                return False\n        self._result = ValidationResult(True)\n        return True\n\n    def get_result(self) -> ValidationResult:\n        return self._result\nclass Sorter:\n    \"\"\"Determines sort order and performs sorting of a copied array.\"\"\"\n    def determine_order(self, sum_value: int) -> SortOrder:\n        if sum_value % 2 == 1:\n            return SortOrder.ASCENDING\n        else:\n            return SortOrder.DESCENDING\n\n    def sort(self, array_values: List[int], order: SortOrder) -> List[int]:\n        if order == SortOrder.ASCENDING:\n            return sorted(array_values)\n        else: # SortOrder.DESCENDING\n            return sorted(array_values, reverse=True)\ndef sort_array(array: List[int]) -> List[int]:\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n    \"\"\"\n    input_obj = InputArray(array)\n    validator = Validator()\n\n    if not validator.validate_non_negative(input_obj):\n        raise ValueError(validator.get_result().message)\n\n    if input_obj.length() == 0:\n        return []\n\n    sum_value = input_obj.get_first() + input_obj.get_last()\n    sorter = Sorter()\n    order = sorter.determine_order(sum_value)\n\n    return sorter.sort(list(input_obj.values), order)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/89": [{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Create a function encrypt that takes a string as an argument and\n    returns a string encrypted with the alphabet being rotated. \n    The alphabet should be rotated in a manner such that the letters \n    shift down by two multiplied to two places.\n    For example:\n    encrypt('hi') returns 'lm'\n    encrypt('asdfghjkl') returns 'ewhjklnop'\n    encrypt('gf') returns 'kj'\n    encrypt('et') returns 'ix'\n    \"\"\"\n    \n    rotated_chars = []\n    rotation_offset = 4  # Two multiplied by two places = 4\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Calculate the new position, apply modulo 26 for wrap-around,\n            # then convert back to character.\n            start_ord = ord('a')\n            current_pos = ord(char) - start_ord\n            new_pos = (current_pos + rotation_offset) % 26\n            rotated_char = chr(start_ord + new_pos)\n            rotated_chars.append(rotated_char)\n        else:\n            # Preserve characters that are not lowercase English letters.\n            rotated_chars.append(char)\n    return \"\".join(rotated_chars)", "base_status": "pass", "plus_status": "pass"