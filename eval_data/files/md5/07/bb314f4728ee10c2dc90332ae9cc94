he sequence terminates when it reaches 1.\n    \"\"\"\n    if n == 1:\n        return [1]\n\n    sequence = []\n    current = n\n    while current != 1:\n        sequence.append(current)\n        if current % 2 == 0:\n            current //= 2\n        else:\n            current = 3 * current + 1\n    sequence.append(1)\n\n    odd_numbers = sorted(list(set(num for num in sequence if num % 2 != 0)))\n    return odd_numbers", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n: int) -> list[int]:\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the unique odd numbers in its Collatz sequence.\n    The Collatz sequence rule: if even, divide by 2; if odd, multiply by 3 and add 1, until 1 is reached.\n    \"\"\"\n    if n == 1:\n        return [1]\n\n    odd_numbers = set()\n    current = n\n\n    while current != 1:\n        if current % 2 != 0:\n            odd_numbers.add(current)\n        \n        if current % 2 == 0:\n            current = current // 2\n        else:\n            current = 3 * current + 1\n    \n    odd_numbers.add(1) # The sequence always ends with 1, which is odd.\n\n    sorted_odd_numbers = sorted(list(odd_numbers))\n    return sorted_odd_numbers", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/126": [{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n\n    Examples\n    is_sorted([5]) \u279e True\n    is_sorted([1, 2, 3, 4, 5]) \u279e True\n    is_sorted([1, 3, 2, 4, 5]) \u279e False\n    is_sorted([1, 2, 3, 4, 5, 6]) \u279e True\n    is_sorted([1, 2, 3, 4, 5, 6, 7]) \u279e True\n    is_sorted([1, 3, 2, 4, 5, 6, 7]) \u279e False\n    is_sorted([1, 2, 2, 3, 3, 4]) \u279e True\n    is_sorted([1, 2, 2, 2, 3, 4]) \u279e False\n    '''\n    # Handle empty list or list with a single element (FR3).\n    if len(lst) <= 1:\n        return True\n\n    # Check if the list is sorted in ascending order (FR1).\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Count occurrences of each number to check for duplicates (FR2).\n    # Manual counting is used as external utilities are forbidden.\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n\n    # Return False if any number appears more than twice.\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    # If all checks pass, the list is sorted and valid.\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    \"\"\"\n    Checks if the list is sorted in ascending order and has at most one duplicate of any number.\n    Assumes valid input (non-negative integers).\n    \"\"\"\n    # Check for sorted order\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Check for duplicates\n    counts = {}\n    for x in lst:\n        counts[x] = counts.get(x, 0) + 1\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/124": [{"task_id": "HumanEval/124", "solution": "import re\nDAYS_IN_MONTH_31 = [1, 3, 5, 7, 8, 10, 12]\nDAYS_IN_MONTH_30 = [4, 6, 9, 11]\nDAYS_IN_FEBRUARY = [2]\nclass DateValidator:\n    \"\"\"\n    Provides static methods for validating date components.\n    This helper class encapsulates specific date rule logic.\n    \"\"\"\n\n    @staticmethod\n    def is_valid_format(date_string: str) -> tuple[int, int, int] | None:\n        \"\"\"\n        Validates the date string format as 'mm-dd-yyyy' and extracts components.\n        Returns (month, day, year) tuple on success, None otherwise.\n        \"\"\"\n        if not date_string:\n            return None\n        \n        match = re.match(r'^(\\d{2})-(\\d{2})-(\\d{4})$', date_string)\n        if match:\n            month, day, year = int(match.group(1)), int(match.group(2)), int(match.group(3))\n            return month, day, year\n        return None\n\n    @staticmethod\n    def is_valid_month(month: int) -> bool:\n        \"\"\"\n        Checks if the month is within the valid range of 1 to 12.\n        \"\"\"\n        return 1 <= month <= 12\n\n    @staticmethod\n    def is_valid_day(day: int, month: int) -> bool:\n        \"\"\"\n        Validates if the day is within the correct range for its given month.\n        It accounts for months with 31, 30, and up to 29 days for February.\n        \"\"\"\n        if not (1 <= day):\n            return False\n\n        if month in DAYS_IN_MONTH_31:\n            return day <= 31\n        elif month in DAYS_IN_MONTH_30:\n            return day <= 30\n        elif month in DAYS_IN_FEBRUARY:\n            return day <= 29\n        return False # This branch should theoretically not be reached if month is pre-validated.\ndef valid_date(date: str) -> bool:\n    \"\"\"\n    Validates a given date string against predefined rules.\n    Returns True if the date is valid, False otherwise.\n    \"\"\"\n    parsed_date = DateValidator.is_valid_format(date)\n    if parsed_date is None:\n        return False\n\n    month, day, _ = parsed_date\n\n    if not DateValidator.is_valid_month(month):\n        return False\n\n    if not DateValidator.is_valid_day(day, month):\n        return False\n\n    return True", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["06-04-2020\n"]]}, {"task_id": "HumanEval/124", "solution": "import re\nclass _DateValidator:\n    \"\"\"Internal utility class for detailed date component validation.\"\"\"\n\n    MONTH_DAYS = {\n        1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n        4: 30, 6: 30, 9: 30, 11: 30,\n        2: 29\n    }\n\n    @staticmethod\n    def _validate_format(date_string: str) -> tuple[int, int, int] | None:\n        \"\"\"Validates 'mm-dd-yyyy' format and parses components.\"\"\"\n        if not date_string:\n            return None\n        \n        match = re.fullmatch(r'(\\d{2})-(\\d{2})-(\\d{4})', date_string)\n        if not match:\n            return None\n        \n        try:\n            month = int(match.group(1))\n            day = int(match.group(2))\n            year = int(match.group(3))\n            return month, day, year\n        except ValueError:\n            return None\n\n    @staticmethod\n    def _validate_month(month: int) -> bool:\n        \"\"\"Validates if the month is between 1 and 12.\"\"\"\n        return 1 <= month <= 12\n\n    @staticmethod\n    def _validate_day(day: int, month: int) -> bool:\n        \"\"\"Validates if the day is within the valid range for the given month.\"\"\"\n        if not (1 <= day <= _DateValidator.MONTH_DAYS.get(month, 0)):\n            return False\n        return True\ndef valid_date(date: str) -> bool:\n    \"\"\"Validates a date string in 'mm-dd-yyyy' format.\n    Returns True if valid, False otherwise.\"\"\"\n    parsed_date = _DateValidator._validate_format(date)\n    if parsed_date is None:\n        return False\n\n    month, day, year = parsed_date\n\n    if not _DateValidator._validate_month(month):\n        return False\n\n    if not _DateValidator._validate_day(day, month):\n        return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/125": [{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"Splits a string by whitespace or commas, or counts odd-ordered lowercase letters.\n    The splitting priority is whitespace, then commas.\"\"\"\n\n    # Check for whitespace characters first (FR1)\n    # Python's str.split() handles multiple whitespace types and sequences.\n    if any(c.isspace() for c in txt):\n        return txt.split()\n    # If no whitespace, check for commas (FR2)\n    elif ',' in txt:\n        return txt.split(',')\n    # If neither whitespace nor commas are present, count specific lowercase letters (FR3)\n    else:\n        count = 0\n        alphabet_offset = ord('a') # 'a' is 0-indexed\n        for char in txt:\n            if 'a' <= char <= 'z': # Ensure character is a lowercase letter\n                order = ord(char) - alphabet_offset\n                if order % 2 != 0: # Check if its 0-indexed alphabetical order is odd\n                    count += 1\n        return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Splits text by whitespace, then by commas if no whitespace.\n    Otherwise, counts lowercase letters with odd alphabetical order.\n    \"\"\"\n    if any(c.isspace() for c in txt):\n        # If whitespace is present, split by whitespace and filter out empty strings.\n        return [word for word in txt.split() if word]\n    elif ',' in txt:\n        # If no whitespace but commas are present, split by commas and filter out empty strings.\n        return [word for word in txt.split(',') if word]\n    else:\n        # If neither, count lowercase letters with an odd 0-indexed alphabetical order.\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                if (ord(char) - ord('a')) % 2 != 0:\n                    count += 1\n        return count", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["as,words,,a"]]}], "HumanEval/127": [{"task_id": "HumanEval/127", "solution": "import math\nclass IntervalCalculator:\n    \"\"\"Handles operations related to integer intervals.\"\"\"\n    def calculate_intersection(self, interval1: tuple[int, int], interval2: tuple[int, int]) -> tuple[int, int] | None:\n        \"\"\"Determines the intersection of two closed integer intervals.\"\"\"\n        start1, end1 = interval1\n        start2, end2 = interval2\n\n        intersection_start = max(start1, start2)\n        intersection_end = min(end1, end2)\n\n        if intersection_start <= intersection_end:\n            return (intersection_start, intersection_end)\n        else:\n            return None\n\n    def calculate_length(self, interval: tuple[int, int]) -> int:\n        \"\"\"Calculates the length of a given closed integer interval.\"\"\"\n        start, end = interval\n        return end - start + 1\nclass PrimeChecker:\n    \"\"\"Provides a method to check if a given integer is a prime number.\"\"\"\n    def is_prime(self, number: int) -> bool:\n        \"\"\"Determines if the input number is a prime number.\"\"\"\n        if number <= 1:\n            return False\n        if number == 2:\n            return True\n        if number % 2 == 0:\n            return False\n        \n        for i in range(3, int(math.sqrt(number)) + 1, 2):\n            if number % i == 0:\n                return False\n        return True\ndef intersection(interval1, interval2):\n    \"\"\"\n    Determines whether the length of the intersection of two intervals is a prime number.\n    \"\"\"\n    interval_calc = IntervalCalculator()\n    prime_check = PrimeChecker()\n\n    intersected_interval = interval_calc.calculate_intersection(interval1, interval2)\n\n    if intersected_interval is None:\n        return \"NO\"\n    \n    length = interval_calc.calculate_length(intersected_interval)\n\n    if prime_check.is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\"", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[-1, 1], [0, 4]]], "plus_fail_tests": [[[10, 20], [15, 25]]]}, {"task_id": "HumanEval/127", "solution": "import math\nfrom typing import Optional\nclass Interval:\n    def __init__(self, start: int, end: int):\n        self.start = start\n        self.end = end\n\n    def __repr__(self):\n        return f\"Interval({self.start}, {self.end})\"\n\n    def __eq__(self, other):\n        # Compares two Interval objects for equality.\n        if not isinstance(other, Interval):\n            return NotImplemented\n        return self.start == other.start and self.end == other.end\nclass IntervalCalculator:\n    def calculate_intersection(self, interval1: Interval, interval2: Interval) -> Optional[Interval]:\n        \"\"\"Calculates the intersection of two intervals. Returns None if they don't intersect.\"\"\"\n        intersection_start = max(interval1.start, interval2.start)\n        intersection_end = min(interval1.end, interval2.end)\n\n        if intersection_start > intersection_end:\n            return None\n        return Interval(intersection_start, intersection_end)\n\n    def get_length(self, interval: Interval) -> int:\n        \"\"\"Calculates the length of a given interval.\"\"\"\n        return interval.end - interval.start + 1\nclass PrimeChecker:\n    def is_prime(self, number: int) -> bool:\n        \"\"\"Checks if a number is prime using trial division.\"\"\"\n        if number <= 1:\n            return False\n        if number == 2:\n            return True\n        if number % 2 == 0:\n            return False\n        # Only check odd divisors up to the square root of the number.\n        for i in range(3, int(math.sqrt(number)) + 1, 2):\n            if number % i == 0:\n                return False\n        return True\ndef intersection(interval1, interval2):\n    \"\"\"Determines if the length of the intersection of two intervals is a prime number.\n    Returns \"YES\" if prime, \"NO\" otherwise.\"\"\"\n    # Convert input tuples to Interval objects as per design.\n    interval1_obj = Interval(interval1[0], interval1[1])\n    interval2_obj = Interval(interval2[0], interval2[1])\n\n    calculator = IntervalCalculator()\n    prime_checker = PrimeChecker()\n\n    intersection_interval = calculator.calculate_intersection(interval1_obj, interval2_obj)\n\n    if intersection_interval is None:\n        # If intervals do not intersect, return \"NO\".\n        return \"NO\"\n\n    length = calculator.get_length(intersection_interval)\n\n    # Check if the length is a prime number.\n    if prime_checker.is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\"", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[-1, 1], [0, 4]]], "plus_fail_tests": [[[10, 20], [15, 25]]]}], "HumanEval/128": [{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates sum of magnitudes of integers multiplied by product of all signs.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for num in arr:\n        # Determine the sign of the current number based on FR3\n        current_sign = 0\n        if num > 0:\n            current_sign = 1\n        elif num < 0:\n            current_sign = -1\n\n        product_of_signs *= current_sign\n        sum_of_magnitudes += abs(num)\n\n    return sum_of_magnitudes * product_of_signs", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates sum of magnitudes of integers multiplied by product of all signs.\n    Returns None for an empty array as per requirements.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_magnitudes = 0\n    product_of_signs = 1\n\n    for number in arr:\n        sum_magnitudes += abs(number)\n        \n        # Determine the sign for the current number directly.\n        if number > 0:\n            current_sign = 1\n        elif number < 0:\n            current_sign = -1\n        else:\n            current_sign = 0\n        \n        product_of_signs *= current_sign\n\n    return sum_magnitudes * product_of_signs", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "import heapq\nclass Cell:\n    \"\"\"Represents a single cell in the grid with its coordinates and value.\"\"\"\n    def __init__(self, row: int, col: int, value: int) -> None:\n        self._row = row\n        self._col = col\n        self._value = value\n\n    def get_row(self) -> int:\n        return self._row\n\n    def get_col(self) -> int:\n        return self._col\n\n    def get_value(self) -> int:\n        return self._value\nclass Grid:\n    \"\"\"Manages the 2D grid structure, providing access to cells and neighbor information.\"\"\"\n    DIRECTIONS = [(0, 1), (0, -1), (1, 0), (-1, 0)] # Right, Left, Down, Up\n\n    def __init__(self, raw_grid: list[list[int]]) -> None:\n        self._N = len(raw_grid)\n        self._cells = []\n        for r in range(self._N):\n            row_cells = []\n            for c in range(self._N):\n                row_cells.append(Cell(r, c, raw_grid[r][c]))\n            self._cells.append(row_cells)\n\n    def get_N(self) -> int:\n        return self._N\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        return self._cells[row][col]\n\n    def is_valid_coord(self, row: int, col: int) -> bool:\n        return 0 <= row < self._N and 0 <= col < self._N\n\n    def get_neighbors(self, row: int, col: int) -> list[tuple[int, int]]:\n        neighbors = []\n        for dr, dc in Grid.DIRECTIONS:\n            nr, nc = row + dr, col + dc\n            if self.is_valid_coord(nr, nc):\n                neighbors.append((nr, nc))\n        return neighbors\nclass PathFinderService:\n    \"\"\"Implements the core algorithm to find the lexicographically smallest path of length k.\"\"\"\n    def find_min_path(self, raw_grid: list[list[int]], k: int) -> list[int]:\n        grid_obj = Grid(raw_grid)\n        N = grid_obj.get_N()\n        \n        # Priority queue stores tuples: (current_path_values, (last_row, last_col)).\n        # The path_values list is used for lexicographical comparison by heapq.\n        pq = []\n\n        # Initialize with all possible starting cells.\n        for r in range(N):\n            for c in range(N):\n                initial_value = grid_obj.get_cell(r, c).get_value()\n                heapq.heappush(pq, ([initial_value], (r, c)))\n\n        while pq:\n            current_path_values, (r, c) = heapq.heappop(pq)\n\n            if len(current_path_values) == k:\n                return current_path_values\n\n            if len(current_path_values) < k:\n                for nr, nc in grid_obj.get_neighbors(r, c):\n                    neighbor_value = grid_obj.get_cell(nr, nc).get_value()\n                    new_path_values = current_path_values + [neighbor_value]\n                    heapq.heappush(pq, (new_path_values, (nr, nc)))\n        \n        # According to the problem statement, this point should not be reached.\n        return []\ndef minPath(grid: list[list[int]], k: int) -> list[int]:\n    \"\"\"\n    Finds the lexicographically smallest path of length k in the grid.\n    This function delegates the pathfinding logic to a PathFinderService instance.\n    \"\"\"\n    service = PathFinderService()\n    return service.find_min_path(grid, k)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/129", "solution": "import heapq\nfrom typing import List, Tuple\nclass Path:\n    \"\"\"Represents a single path in the grid, including its values and current endpoint.\"\"\"\n    def __init__(self, values: List[int], last_row: int, last_col: int):\n        self._values = values\n        self._last_row = last_row\n        self._last_col = last_col\n\n    def __lt__(self, other: 'Path') -> bool:\n        \"\"\"Implements lexicographical comparison for priority queue.\"\"\"\n        return self._values < other._values\n\n    def extend(self, next_row: int, next_col: int, next_value: int) -> 'Path':\n        \"\"\"Creates a new Path object by extending the current path with a new cell.\"\"\"\n        return Path(self._values + [next_value], next_row, next_col)\n\n    def get_last_position(self) -> Tuple[int, int]:\n        \"\"\"Returns the coordinates of the last cell in the path.\"\"\"\n        return self._last_row, self._last_col\n\n    def get_values(self) -> List[int]:\n        \"\"\"Returns the list of values in the path.\"\"\"\n        return self._values\n\n    def get_length(self) -> int:\n        \"\"\"Returns the current length of the path.\"\"\"\n        return len(self._values)\nclass GridUtils:\n    \"\"\"Provides static utility methods for common grid-related operations.\"\"\"\n    @staticmethod\n    def is_valid_coord(row: int, col: int, N: int) -> bool:\n        \"\"\"Checks if a given (row, col) coordinate is within the grid boundaries.\"\"\"\n        return 0 <= row < N and 0 <= col < N\n\n    @staticmethod\n    def get_neighbors(row: int, col: int, N: int) -> List[Tuple[int, int]]:\n        \"\"\"Returns a list of valid adjacent (up, down, left, right) cell coordinates.\"\"\"\n        neighbors = []\n        moves = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n        \n        for dr, dc in moves:\n            next_row, next_col = row + dr, col + dc\n            if GridUtils.is_valid_coord(next_row, next_col, N):\n                neighbors.append((next_row, next_col))\n        return neighbors\nclass MinPathFinderService:\n    \"\"\"Orchestrates the pathfinding algorithm to discover the lexicographically smallest path.\"\"\"\n    def __init__(self, grid: List[List[int]], k: int):\n        self._grid = grid\n        self._k = k\n        self._N = len(grid)\n\n    def _get_grid_value(self, row: int, col: int) -> int:\