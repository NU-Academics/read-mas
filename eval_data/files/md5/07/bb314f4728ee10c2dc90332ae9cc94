n    \"\"\"\n\n    # Helper function to calculate \"n choose k\" combinations.\n    def _combinations(n_val, k_val):\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0 or k_val == n_val:\n            return 1\n        if k_val > n_val // 2:\n            k_val = n_val - k_val\n        \n        res = 1\n        for i in range(k_val):\n            res = res * (n_val - i) // (i + 1)\n        return res\n\n    # Generate array 'a' where a[i] = i*i - i + 1 for 1 <= i <= n.\n    a = []\n    for i in range(1, n + 1):\n        a.append(i * i - i + 1)\n\n    # Count elements by their remainder modulo 3.\n    # Based on a[i] = i*(i-1)+1, a[i]%3 is 0 if i%3==2, and 1 otherwise.\n    count0 = 0 # Count of numbers in 'a' that are 0 mod 3.\n    count1 = 0 # Count of numbers in 'a' that are 1 mod 3.\n    \n    for x in a:\n        remainder = x % 3\n        if remainder == 0:\n            count0 += 1\n        elif remainder == 1:\n            count1 += 1\n\n    total_valid_triples = 0\n\n    # Triples (x, y, z) whose sum (x + y + z) % 3 == 0.\n    # Case 1: All three elements are 0 mod 3.\n    total_valid_triples += _combinations(count0, 3)\n\n    # Case 2: All three elements are 1 mod 3. (1+1+1)%3 == 0.\n    total_valid_triples += _combinations(count1, 3)\n\n    # Case (0,1,2) is not possible because a[i] never has a remainder of 2 mod 3.\n\n    return total_valid_triples", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/148": [{"task_id": "HumanEval/148", "solution": "PLANETS_ORDER = [\n    \"Mercury\", \"Venus\", \"Earth\", \"Mars\",\n    \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n]\ndef bf(planet1, planet2):\n    \"\"\"\n    Returns a tuple containing all planets whose orbits are located between planet1 and planet2, sorted by proximity to the sun.\n    Returns an empty tuple if planet1 or planet2 are not recognized planet names.\n    \"\"\"\n    try:\n        idx1 = PLANETS_ORDER.