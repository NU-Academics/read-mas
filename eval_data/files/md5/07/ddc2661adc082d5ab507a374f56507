{"task_id": "Mbpp/586", "solution": "def split_Arr(arr, n):\n    \"\"\"\n    Splits a list at the nth element and moves the first part to the end.\n    Returns a new list; does not mutate the input.\n\n    Examples:\n    - split_Arr([1,2,3,4], 2) -> [3,4,1,2]\n    - split_Arr([1,2,3,4], 0) -> [1,2,3,4]\n    - split_Arr([1,2,3,4], -1) -> [4,1,2,3]\n    - split_Arr([1,2,3], 5) -> [1,2,3]\n    - split_Arr([], 0) -> []\n    \"\"\"\n    class Index:\n        \"\"\"Helper to normalize an index, converting negative values based on array length.\"\"\"\n        def __init__(self, value: int):\n            self.value = value\n\n        def normalize(self, arr_len: int) -> int:\n            \"\"\"Normalizes negative indices by adding array length.\"\"\"\n            if self.value >= 0:\n                return self.value\n            else:\n                return arr_len + self.value\n\n    class SplitOperation:\n        \"\"\"Helper to perform the list splitting and rotation using slicing.\"\"\"\n        def split(self, arr: list, n_norm: int) -> list:\n            \"\"\"Splits the list at n_norm, moving the prefix to the end.\"\"\"\n            arr_len = len(arr)\n\n            if n_norm <= 0:\n                return arr.copy()\n            elif n_norm >= arr_len:\n                return arr.copy()\n            else:\n                return arr[n_norm:] + arr[:n_norm]\n\n    # Handle empty list upfront\n    if not arr:\n        return []\n\n    arr_len = len(arr)\n    # Normalize 'n' using the Index helper\n    n_norm = Index(n).normalize(arr_len)\n\n    # Perform the split operation using the SplitOperation helper\n    return SplitOperation().split(arr, n_norm)"}
{"task_id": "Mbpp/585", "solution": "import heapq\nimport abc\n\nclass Validator:\n    \"\"\"Validates input types for dataset and n.\"\"\"\n    @staticmethod\n    def validate_dataset(dataset):\n        if not isinstance(dataset, list):\n            raise TypeError(f\"dataset must be a list; got {type(dataset).__name__}\")\n\n    @staticmethod\n    def validate_n(n):\n        if not isinstance(n, int):\n            raise TypeError(f\"n must be an int; got {type(n).__name__}\")\n\nclass Item:\n    \"\"\"Wraps an item dictionary with its price and original index.\"\"\"\n    def __init__(self, data, price, original_index):\n        self.data = data\n        self.price = price\n        self.original_index = original_index\n\nclass Selector(abc.ABC):\n    \"\"\"Abstract base class for item selection strategies.\"\"\"\n    @abc.abstractmethod\n    def select_top_n(self, items, n):\n        pass\n\nclass HeapSelector(Selector):\n    \"\"\"Selects top n items using a min-heap.\"\"\"\n    def select_top_n(self, items, n):\n        min_heap = []  # Stores (price, original_index, Item) tuples.\n        for item in items:\n            # Maintain a min-heap of size 'n' containing the 'n' most expensive items found so far.\n            # Comparison uses (price, original_index) to handle ties and ensure stability for heap logic.\n            if len(min_heap) < n:\n                heapq.heappush(min_heap, (item.price, item.original_index, item))\n            elif (item.price, item.original_index) > (min_heap[0][0], min_heap[0][1]):\n                heapq.heapreplace(min_heap, (item.price, item.original_index, item))\n\n        # Extract Item objects from the heap and sort them.\n        # The heap itself does not guarantee sorted order; a final sort is needed.\n        result_items = [item_obj for _, _, item_obj in min_heap]\n        result_items.sort(key=lambda it: (-it.price, it.original_index)) # Desc price, asc original_index for stability\n        return result_items\n\nclass SortSelector(Selector):\n    \"\"\"Selects top n items by sorting the entire list.\"\"\"\n    def select_top_n(self, items, n):\n        # Sort by price descending, then original_index ascending for stability.\n        sorted_items = sorted(items, key=lambda it: (-it.price, it.original_index))\n        return sorted_items[:n]\n\ndef expensive_items(dataset, n):\n    \"\"\"\n    expensive_items(dataset, n)\n\n    Parameters\n    - dataset (list[dict]): Input list of item dictionaries. Valid items are those with a 'price' key whose value is an int or float. bool values are treated as non-numeric and are ignored.\n    - n (int): Number of top items to return.\n\n    Returns\n    - list[dict]: New list (shallow copies) containing up to n items ordered descending by price (highest first). The input dataset is not modified.\n\n    Behavior\n    - Raises TypeError if dataset is not a list or n is not an int.\n    - Returns [] if n <= 0.\n    - Filters out items lacking 'price' or with non-numeric price values (only int and float are accepted).\n    - Preserves relative order for equal-priced items (stable ordering).\n    - Uses a heap-based selection (O(m log n)) when n is significantly smaller than the number of valid items m; otherwise uses a full sort (O(m log m)).\n    - Returned items are shallow copies of the original dicts.\n    \"\"\"\n    Validator.validate_dataset(dataset)\n    Validator.validate_n(n)\n\n    if n <= 0:\n        return []\n\n    valid_items = []\n    for idx, d in enumerate(dataset):\n        if not isinstance(d, dict):\n            continue\n        price = d.get('price')\n        # Accept only int or float prices, excluding booleans.\n        if isinstance(price, (int, float)) and not isinstance(price, bool):\n            valid_items.append(Item(data=d, price=price, original_index=idx))\n\n    m = len(valid_items)\n    if m == 0:\n        return []\n\n    # Choose selection strategy based on n relative to m.\n    # Heuristic: use heap if n is less than 1/4th of the number of valid items.\n    if n < max(1, m // 4):\n        selector = HeapSelector()\n    else:\n        selector = SortSelector()\n\n    selected_item_wrappers = selector.select_top_n(valid_items, n)\n\n    # Return a new list of shallow copies of the original dictionaries.\n    return [item_wrapper.data.copy() for item_wrapper in selected_item_wrappers]"}
{"task_id": "Mbpp/591", "solution": "def _validate_input(lst) -> None:\n    if not isinstance(lst, list):\n        raise TypeError(\"swap_List requires a list as input\")\n\ndef _swap_in_place(lst) -> None:\n    # Swaps the elements at index 0 and -1 using tuple assignment.\n    lst[0], lst[-1] = lst[-1], lst[0]\n\ndef swap_List(lst: list) -> list:\n    \"\"\"\n    Signature: def swap_List(lst: list) -> list\n\n    Behavior:\n    - Validates that lst is a Python list; raises TypeError if not.\n    - If len(lst) < 2, returns lst unchanged (same object).\n    - If len(lst) >= 2, swaps the elements at index 0 and -1 in place and returns lst (same object).\n\n    Edge cases:\n    - Empty list ([]) -> returned unchanged (same object).\n    - Single-element list ([x]) -> returned unchanged (same object).\n    - Two-element list ([a, b]) -> becomes [b, a] (same object).\n    - Non-list input -> raises TypeError.\n    - Mutable elements: only references are swapped; no deep copy.\n\n    Complexity:\n    - Time: O(1) (constant time).\n    - Space: O(1) additional space (in-place swap).\n\n    Example:\n    >>> lst = [1, 2, 3]\n    >>> swap_List(lst)\n    [3, 2, 1]\n    \"\"\"\n    _validate_input(lst)\n    if len(lst) < 2:\n        return lst\n    _swap_in_place(lst)\n    return lst"}
{"task_id": "Mbpp/590", "solution": "import math\nimport cmath\nfrom typing import Tuple\n\ndef polar_rect(x: float, y: float) -> Tuple[Tuple[float, float], complex]:\n    \"\"\"\n    Converts rectangular coordinates to polar-like components and a complex value.\n\n    The function computes magnitude, angle, and a complex number based on specific rules.\n    \"\"\"\n    magnitude = math.hypot(x, y)\n    angle = math.atan2(y, x)\n    complex_value = (magnitude - x) * cmath.exp(1j * math.pi)\n    return ((magnitude, angle), complex_value)"}
{"task_id": "Mbpp/589", "solution": "import math\n\ndef _floor_sqrt(n: int) -> int:\n    \"\"\"Computes the largest integer r such that r*r <= n.\n    Assumes n is non-negative.\"\"\"\n    return math.isqrt(n)\n\ndef _ceil_sqrt(n: int) -> int:\n    \"\"\"Computes the smallest integer r such that r*r >= n.\n    Assumes n is non-negative.\"\"\"\n    r = math.isqrt(n)\n    return r if r * r == n else r + 1\n\ndef perfect_squares(start: int, end: int) -> list[int]:\n    \"\"\"Finds all perfect squares within the inclusive integer range [start, end].\n    Uses integer square root computation for efficiency.\"\"\"\n    if not isinstance(start, int) or not isinstance(end, int):\n        raise TypeError(\"start and end must be ints\")\n\n    if start > end:\n        start, end = end, start\n\n    # Perfect squares are non-negative, so adjust the lower bound for sqrt calculation.\n    low_bound_for_sqrt = max(start, 0)\n\n    # Calculate the ceiling of the square root for the effective lower bound.\n    low_root = _ceil_sqrt(low_bound_for_sqrt)\n\n    # Calculate the floor of the square root for the upper bound.\n    # If end is negative, no perfect squares can exist.\n    high_root = _floor_sqrt(end) if end >= 0 else -1\n\n    # If the effective lower root is greater than the upper root, no squares exist.\n    if low_root > high_root:\n        return []\n\n    # Generate perfect squares by squaring integers from low_root to high_root.\n    return [r * r for r in range(low_root, high_root + 1)]"}
{"task_id": "Mbpp/592", "solution": "def sum_Of_product(n):\n    \"\"\"\n    Finds the sum of the product of consecutive binomial coefficients.\n    S(n) = sum_{k=0}^{n-1} C(n, k) * C(n, k+1) for integer n >= 0.\n    \"\"\"\n    import math\n\n    class InputValidator:\n        @staticmethod\n        def validate_non_negative_integer(value) -> None:\n            \"\"\"Validates if the input value is a non-negative integer.\"\"\"\n            if not isinstance(value, int):\n                raise TypeError(\"n must be an integer\")\n            if value < 0:\n                raise ValueError(\"n must be >= 0\")\n\n    class BinomialCalculator:\n        @staticmethod\n        def comb(n_val, k_val) -> int:\n            \"\"\"Calculates the binomial coefficient (n_val choose k_val).\"\"\"\n            return math.comb(n_val, k_val)\n\n    def _closed_form_impl(val_n) -> int:\n        \"\"\"Computes S(n) using the closed-form identity C(2n, n-1).\"\"\"\n        if val_n == 0:\n            return 0\n        return BinomialCalculator.comb(2 * val_n, val_n - 1)\n\n    InputValidator.validate_non_negative_integer(n)\n    return _closed_form_impl(n)"}
{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip: str) -> str:\n    \"\"\"\n    Removes leading zeroes from IP address octets.\n    Preserves non-digit tokens and handles various string formats.\n    \"\"\"\n    tokens = ip.split('.')\n    normalized_tokens = []\n    for token_str in tokens:\n        trimmed_token = token_str.strip()\n        if trimmed_token.isdigit():\n            # Remove leading zeros; if result is empty, use '0'\n            stripped_token = trimmed_token.lstrip('0')\n            if not stripped_token:\n                normalized_tokens.append('0')\n            else:\n                normalized_tokens.append(stripped_token)\n        else:\n            # Preserve non-digit tokens or empty tokens after trim\n            normalized_tokens.append(trimmed_token)\n    return '.'.join(normalized_tokens)"}
