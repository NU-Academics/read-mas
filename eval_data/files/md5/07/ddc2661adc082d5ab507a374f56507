{"task_id": "Mbpp/59", "solution": "def is_octagonal(n: int) -> int:\n    \"\"\"Compute the nth octagonal number.\n\n    Parameters\n    ----------\n    n : int\n        Index of the octagonal number to compute. Must be an integer >= 1.\n\n    Returns\n    -------\n    int\n        The nth octagonal number, computed as O_n = n * (3 * n - 2).\n\n    Raises\n    ------\n    TypeError\n        If n is not an int.\n    ValueError\n        If n < 1.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n\n    # Compute the octagonal number using the closed-form formula.\n    return n * (3 * n - 2)"}
{"task_id": "Mbpp/61", "solution": "import collections\n\ndef count_Substrings(s: str) -> int:\n    \"\"\"Counts substrings whose digit sum equals their length using prefix sums and a frequency map.\n    This runs in O(n) time and O(n) additional space.\n\n    Algorithm:\n    - Maintain running_prefix_sum of digits seen so far.\n    - For each position i (0-based) after adding s[i], compute key = running_prefix_sum - (i+1).\n    - The number of prior prefix positions with the same key equals the number of substrings\n      ending at i whose digit sum equals their length.\n    - Use a frequency dictionary freq mapping key -> count. Initialize freq[0] = 1 to account\n      for substrings that start at index 0.\n\n    Edge cases:\n    - Empty string returns 0.\n    - Non-digit characters are not explicitly validated here; the function expects a digit string.\n    \"\"\"\n    if not s:\n        return 0\n\n    result = 0\n    running_prefix_sum = 0\n    freq = collections.defaultdict(int)\n    freq[0] = 1\n\n    for i, char_digit in enumerate(s):\n        digit = int(char_digit)\n        running_prefix_sum += digit\n        key = running_prefix_sum - (i + 1)\n        result += freq[key]\n        freq[key] += 1\n\n    return result"}
{"task_id": "Mbpp/57", "solution": "def find_Max_Num(digits):\n    \"\"\"\n    Find the largest number that can be formed by concatenating the given list of single digits (0-9).\n\n    Parameters\n    ----------\n    digits : list\n        A list of integers each expected to be in the range 0..9.\n\n    Returns\n    -------\n    int\n        The largest integer formed by concatenating the digits in an order that yields the maximum value.\n        Returns 0 for an empty list or a list containing only zeros.\n\n    Raises\n    ------\n    TypeError\n        If the input is not a list.\n    ValueError\n        If any element is not an int in the range 0..9 (message includes the invalid element index).\n    \"\"\"\n    # Validate input type\n    if not isinstance(digits, list):\n        raise TypeError(\"find_Max_Num: input must be a list\")\n\n    # Validate elements\n    for i, d in enumerate(digits):\n        if not isinstance(d, int) or not (0 <= d <= 9):\n            raise ValueError(f\"find_Max_Num: element at index {i} is not an int in 0..9\")\n\n    # Empty list -> 0\n    if len(digits) == 0:\n        return 0\n\n    # All zeros -> 0\n    all_zero = True\n    for d in digits:\n        if d != 0:\n            all_zero = False\n            break\n    if all_zero:\n        return 0\n\n    # Sort digits in descending order and concatenate\n    ordered = sorted(digits, reverse=True)\n    joined = ''.join(str(d) for d in ordered)\n    return int(joined)"}
{"task_id": "Mbpp/64", "solution": "def subject_marks(subject_list):\n    \"\"\"Sorts a list of tuples by the second element of each tuple in ascending order.\n    Example: assert subject_marks([('English', 88), ('Science', 90), ('Maths', 97), ('Social sciences', 82)])==[('Social sciences', 82), ('English', 88), ('Science', 90), ('Maths', 97)]\n    \"\"\"\n    if not subject_list:\n        return []\n    return list(sorted(subject_list, key=lambda t: t[1]))"}
{"task_id": "Mbpp/63", "solution": "def max_difference(input_list):\n    # Input validation\n    if not isinstance(input_list, list):\n        raise TypeError(\"input_list must be a list\")\n    if len(input_list) == 0:\n        raise ValueError(\"input_list must not be empty\")\n\n    max_diff = None\n    all_integral = True\n\n    for item in input_list:\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise ValueError(\"each item must be a 2-element tuple\")\n        a, b = item\n        if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n            raise TypeError(\"tuple elements must be int or float\")\n\n        diff = b - a\n\n        if max_diff is None or diff > max_diff:\n            max_diff = diff\n\n        if diff != int(diff):\n            all_integral = False\n\n    if all_integral:\n        return int(max_diff)\n    return float(max_diff)"}
{"task_id": "Mbpp/65", "solution": "import numbers\nfrom typing import Any\n\nclass Validator:\n    \"\"\"Utility class for validating types.\"\"\"\n    @staticmethod\n    def is_list(obj: Any) -> bool:\n        \"\"\"Checks if an object is an instance of list.\"\"\"\n        return isinstance(obj, list)\n\n    @staticmethod\n    def is_numeric(obj: Any) -> bool:\n        \"\"\"Checks if an object is a real number (excluding booleans).\"\"\"\n        return isinstance(obj, numbers.Real) and not isinstance(obj, bool)\n\ndef _accumulate(lst: list) -> float:\n    \"\"\"Recursively traverses a list, summing numeric elements.\"\"\"\n    total_sum = 0.0\n    for element in lst:\n        if Validator.is_list(element):\n            total_sum += _accumulate(element)\n        elif Validator.is_numeric(element):\n            total_sum += float(element)\n    return total_sum\n\ndef recursive_list_sum(input_list: list) -> float:\n    \"\"\"\n    Recursively flattens a list and sums all numeric elements (int, float) within it.\n\n    Args:\n        input_list: The list to be flattened and summed, which may contain nested lists.\n\n    Returns:\n        The sum of all numeric elements as a float.\n\n    Raises:\n        TypeError: If the top-level input is not an instance of list.\n\n    Examples:\n        >>> recursive_list_sum([1, 2, [3, 4], [5, 6]])\n        21.0\n        >>> recursive_list_sum([1, [2, 3.5], 'a', None])\n        6.5\n    \"\"\"\n    if not Validator.is_list(input_list):\n        raise TypeError(\"Input must be an instance of list.\")\n\n    return _accumulate(input_list)"}
