{"task_id": "Mbpp/630", "solution": "def get_coordinates(coordinate):\n    \"\"\"\n    Extracts all 3x3 adjacent coordinates of the given coordinate tuple,\n    including the coordinate itself, in row-major order.\n    \"\"\"\n    x, y = coordinate\n    adjacent_coordinates = []\n    for dx in (-1, 0, 1):\n        for dy in (-1, 0, 1):\n            adjacent_coordinates.append([x + dx, y + dy])\n    return adjacent_coordinates"}
{"task_id": "Mbpp/631", "solution": "from typing import Optional\n\ndef is_whitespace(ch: str) -> bool:\n    \"\"\"Return True if ch is whitespace per Python str.isspace().\"\"\"\n    return ch.isspace()\n\ndef replace_spaces(s: Optional[str]) -> Optional[str]:\n    \"\"\"Swap '_' -> ' ' and whitespace -> '_' in a single pass; returns None for None input.\"\"\"\n    if s is None:\n        return None\n    if not s:\n        return ''\n    buffer: list[str] = []\n    for ch in s:\n        if ch == '_':\n            buffer.append(' ')\n        elif is_whitespace(ch):\n            buffer.append('_')\n        else:\n            buffer.append(ch)\n    return ''.join(buffer)"}
{"task_id": "Mbpp/632", "solution": "def move_zero(lst):\n    \"\"\"\n    Moves all numeric zeros to the end of the given list, preserving relative order of non-zero and zero elements.\n    Returns a new list without modifying the original.\n    \"\"\"\n    if lst is None:\n        return []\n\n    def is_zero(element):\n        \"\"\"\n        Determines if an element is a numeric zero (value 0, but not a boolean).\n        \"\"\"\n        return (element == 0) and (type(element) is not bool)\n\n    result = []\n    zero_elements = []\n\n    for element in lst:\n        if is_zero(element):\n            zero_elements.append(element)\n        else:\n            result.append(element)\n\n    result.extend(zero_elements)\n    return result"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(arr, n):\n    \"\"\"\n    Calculates the sum of XOR of all pairs of numbers in the given list using a bitwise approach.\n    This method computes the sum by considering each bit position.\n    \"\"\"\n    if n < 2:\n        return 0\n\n    # Basic validation: ensure arr length matches n\n    if not hasattr(arr, '__len__'):\n        raise TypeError(\"arr must be a sequence with a length\")\n    if len(arr) != n:\n        raise ValueError(\"n must be equal to len(arr)\")\n\n    # Validate elements and find max value\n    max_val = 0\n    for x in arr:\n        if not isinstance(x, int):\n            raise TypeError(\"all elements of arr must be integers\")\n        if x < 0:\n            raise TypeError(\"all elements of arr must be non-negative integers\")\n        if x > max_val:\n            max_val = x\n\n    max_bits = max_val.bit_length()\n    if max_bits == 0:\n        return 0\n\n    total_xor_sum = 0\n\n    for bit_pos in range(max_bits):\n        count1 = 0\n        for num in arr:\n            if (num >> bit_pos) & 1:\n                count1 += 1\n\n        count0 = n - count1\n        total_xor_sum += (count1 * count0 * (1 << bit_pos))\n\n    return total_xor_sum"}
{"task_id": "Mbpp/635", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass InputList:\n    \"\"\"Typed wrapper for the input integer sequence.\"\"\"\n    elements: List[int]\n\n@dataclass\nclass OutputList:\n    \"\"\"Typed wrapper for the output (sorted) integer sequence.\"\"\"\n    elements: List[int]\n\nclass Heap:\n    \"\"\"Encapsulates heap storage and provides heap operations.\"\"\"\n    def __init__(self, storage: List[int]) -> None:\n        # Create a copy of the input list to avoid mutating the original\n        self._storage = storage[:]\n\n    def _parent(self, i: int) -> int:\n        return (i - 1) // 2\n\n    def _left_child(self, i: int) -> int:\n        return 2 * i + 1\n\n    def _right_child(self, i: int) -> int:\n        return 2 * i + 2\n\n    def build_heap(self) -> None:\n        \"\"\"Transforms the internal storage into a max-heap.\"\"\"\n        n = len(self._storage)\n        # Start from the last non-leaf node and heapify upwards\n        for i in range(n // 2 - 1, -1, -1):\n            self.heapify(i, n)\n\n    def heapify(self, i: int, heap_size: int) -> None:\n        \"\"\"Maintains the max-heap property for a subtree rooted at index i.\"\"\"\n        largest = i\n        l = self._left_child(i)\n        r = self._right_child(i)\n\n        # Check if left child exists and is greater than root\n        if l < heap_size and self._storage[l] > self._storage[largest]:\n            largest = l\n\n        # Check if right child exists and is greater than the current largest\n        if r < heap_size and self._storage[r] > self._storage[largest]:\n            largest = r\n\n        # If the largest is not the root, swap and recursively heapify the affected subtree\n        if largest != i:\n            self._storage[i], self._storage[largest] = self._storage[largest], self._storage[i]\n            self.heapify(largest, heap_size)\n\n    def extract_max(self, heap_size: int) -> int:\n        \"\"\"Extracts the maximum element, restores heap property, and returns the max value.\"\"\"\n        if heap_size <= 0:\n            # This should ideally not be reached with proper orchestration in HeapSortFunction\n            # but serves as a safeguard.\n            raise IndexError(\"Cannot extract max from an empty heap portion.\")\n\n        # The maximum element is at the root\n        max_val = self._storage[0]\n\n        # Move the last element of the current heap to the root\n        # and conceptually reduce the heap size by one.\n        self._storage[0] = self._storage[heap_size - 1]\n\n        # Restore the heap property for the remaining heap\n        self.heapify(0, heap_size - 1)\n\n        return max_val\n\nclass HeapSortFunction:\n    \"\"\"Orchestrates heap sort using the Heap class and produces the sorted output.\"\"\"\n    def heap_sort(self, input_list: List[int]) -> List[int]:\n        # Create a Heap instance, which internally copies the input_list\n        heap = Heap(input_list)\n\n        # Build a max-heap from the elements\n        heap.build_heap()\n\n        n = len(heap._storage)\n        collected_elements: List[int] = []\n        current_heap_size = n\n\n        # Extract elements one by one from the heap\n        # The elements are collected in descending order.\n        for _ in range(n):\n            max_val = heap.extract_max(current_heap_size)\n            collected_elements.append(max_val)\n            current_heap_size -= 1\n\n        # Reverse the collected elements to get ascending order\n        collected_elements.reverse()\n        return collected_elements\n\ndef heap_sort(input_list: List[int]) -> List[int]:\n    \"\"\"Sorts a list of integers in ascending order using the heap sort algorithm.\"\"\"\n    sorter = HeapSortFunction()\n    return sorter.heap_sort(input_list)"}
{"task_id": "Mbpp/637", "solution": "from decimal import Decimal, InvalidOperation, ROUND_HALF_EVEN\n\ndef noprofit_noloss(amount_paid, amount_received):\n    \"\"\"\n    Checks if two monetary amounts represent no profit and no loss after normalization.\n    Amounts are normalized to two decimal places using ROUND_HALF_EVEN rounding.\n    \"\"\"\n\n    def _convert_and_quantize(raw_amount, param_name):\n        \"\"\"\n        Converts raw input to Decimal, validates it, and quantizes to two decimal places.\n        \"\"\"\n        decimal_amount = None\n\n        # Validate type and perform initial conversion to Decimal\n        if isinstance(raw_amount, int):\n            decimal_amount = Decimal(raw_amount)\n        elif isinstance(raw_amount, float):\n            # Convert float via string to mitigate binary floating-point artifacts\n            decimal_amount = Decimal(str(raw_amount))\n        elif isinstance(raw_amount, Decimal):\n            decimal_amount = raw_amount\n        elif isinstance(raw_amount, str):\n            try:\n                decimal_amount = Decimal(raw_amount)\n            except InvalidOperation:\n                raise TypeError(\n                    f\"Input for '{param_name}' ('{raw_amount}') is an unparsable string. \"\n                    \"Expected a numeric literal.\"\n                )\n        else:\n            raise TypeError(\n                f\"Unsupported type for '{param_name}': {type(raw_amount).__name__}. \"\n                \"Expected int, float, Decimal, or str.\"\n            )\n\n        # Validate for NaN or infinite values\n        if decimal_amount.is_nan() or not decimal_amount.is_finite():\n            raise ValueError(\n                f\"Input for '{param_name}' ({decimal_amount}) must be a finite number, \"\n                \"not NaN or Infinity.\"\n            )\n\n        # Quantize to two decimal places using ROUND_HALF_EVEN\n        precision = Decimal('0.01')\n        quantized_amount = decimal_amount.quantize(precision, rounding=ROUND_HALF_EVEN)\n        return quantized_amount\n\n    # Process both amounts using the helper\n    quantized_paid = _convert_and_quantize(amount_paid, 'amount_paid')\n    quantized_received = _convert_and_quantize(amount_received, 'amount_received')\n\n    # Compare the normalized and quantized amounts\n    return quantized_paid == quantized_received"}
{"task_id": "Mbpp/639", "solution": "def sample_nam(names: list) -> int:\n    \"\"\"\n    Sums the length of names after removing those starting with a lowercase letter, modifying the list in-place.\n    \"\"\"\n    write_idx = 0\n    total_length = 0\n\n    for read_idx in range(len(names)):\n        current_name = names[read_idx]\n\n        # A name is kept if it's empty OR its first character is not a lowercase letter.\n        # The condition to skip is: name is not empty AND name[0] is lowercase.\n        # So, we keep if NOT (name is not empty AND name[0] is lowercase).\n        if not (current_name and current_name[0].islower()):\n            names[write_idx] = current_name\n            total_length += len(current_name)\n            write_idx += 1\n\n    # Truncate the list to remove the elements that were skipped\n    del names[write_idx:]\n\n    return total_length"}
{"task_id": "Mbpp/641", "solution": "def is_nonagonal(n) -> int:\n    \"\"\"Calculates the nth nonagonal number using the formula (7*n*n - 5*n) // 2.\"\"\"\n    if type(n) is not int:\n        raise TypeError(\"n must be int\")\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n\n    numerator = 7 * n * n - 5 * n\n    result = numerator // 2\n    return result"}
{"task_id": "Mbpp/638", "solution": "import math\n\ndef wind_chill(velocity_kmh, temperature_c):\n    \"\"\"\n    Calculates the wind chill index using the Canadian formula and returns it\n    rounded up to the next integer.\n    \"\"\"\n    # Validate types\n    if not isinstance(velocity_kmh, (int, float)) or not isinstance(temperature_c, (int, float)):\n        raise TypeError(\"velocity_kmh and temperature_c must be int or float\")\n\n    v = float(velocity_kmh)\n    T = float(temperature_c)\n\n    # Validate values\n    if not math.isfinite(v) or not math.isfinite(T):\n        raise ValueError(\"Inputs must be finite numbers\")\n    if v < 0:\n        raise ValueError(\"velocity_kmh must be non-negative\")\n\n    # Canadian wind chill formula\n    v_to_power_0_16 = v ** 0.16\n    W = 13.12 + 0.6215 * T - 11.37 * v_to_power_0_16 + 0.3965 * T * v_to_power_0_16\n\n    # Round up to the next integer as implied by the example\n    return int(math.ceil(W))"}
{"task_id": "Mbpp/720", "solution": "def add_dict_to_tuple(tuple_obj, dict_obj):\n    \"\"\"Adds a dictionary as the last element to a tuple, returning a new tuple.\n\n    Examples:\n    add_dict_to_tuple((1, 2), {'a': 1})  ->  (1, 2, {'a': 1})\n    add_dict_to_tuple((), {'a': 1})       ->  ({'a': 1},)\n    add_dict_to_tuple((1,), {})           ->  (1, {})\n    \"\"\"\n    if not isinstance(tuple_obj, tuple):\n        raise TypeError('tuple_obj must be a tuple')\n    if not isinstance(dict_obj, dict):\n        raise TypeError('dict_obj must be a dict')\n    return tuple_obj + (dict_obj,)"}
{"task_id": "Mbpp/643", "solution": "import re\n\n_PATTERN = re.compile(r'(?<=[A-Za-z0-9_])z(?=[A-Za-z0-9_])')\n\ndef text_match_wordz_middle(input: str) -> bool:\n    \"\"\"\n    Checks if the input string contains a lowercase 'z' that is surrounded by\n    ASCII word characters (A-Z, a-z, 0-9, or underscore).\n    \"\"\"\n    return _PATTERN.search(input) is not None"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(arr: list, k: int) -> list:\n    \"\"\"Reverses the elements of an array from index 0 up to a given position k in-place.\n    The function modifies the original list and returns it.\n    \"\"\"\n    left = 0\n    right = k\n    while left < right:\n        arr[left], arr[right] = arr[right], arr[left]\n        left += 1\n        right -= 1\n    return arr"}
{"task_id": "Mbpp/722", "solution": "def filter_data(students: dict, min_height: float, min_weight: float) -> dict:\n    \"\"\"\n    Filters students based on minimum height and weight criteria.\n    Raises TypeError for invalid top-level inputs; skips invalid student entries.\n    \"\"\"\n    if not isinstance(students, dict):\n        raise TypeError(\"students must be a dict\")\n    if not isinstance(min_height, (int, float)) or not isinstance(min_weight, (int, float)):\n        raise TypeError(\"min_height and min_weight must be numeric (int or float)\")\n\n    result = {}\n    for student_name, student_data in students.items():\n        # Per-entry validation: student_data should be a tuple (height, weight)\n        if not isinstance(student_data, tuple) or len(student_data) != 2:\n            continue\n\n        student_height = student_data[0]\n        student_weight = student_data[1]\n\n        # Ensure height and weight extracted from tuple are numeric\n        if not isinstance(student_height, (int, float)) or not isinstance(student_weight, (int, float)):\n            continue\n\n        if student_height >= min_height and student_weight >= min_weight:\n            result[student_name] = student_data\n\n    return result"}
{"task_id": "Mbpp/721", "solution": "def maxAverageOfPath(matrix):\n    \"\"\"\n    Calculates the maximum average cost of a path from the top-left to the bottom-right cell\n    in a square matrix, moving only right or down.\n    The average is computed as total path cost divided by the number of cells in the path.\n    \"\"\"\n    if not isinstance(matrix, list) or not matrix:\n        raise ValueError(\"matrix must be a non-empty square list of lists\")\n\n    n = len(matrix)\n    for row in matrix:\n        if not isinstance(row, list) or len(row) != n:\n            raise ValueError(\"matrix must be a non-empty square list of lists\")\n\n    # Validate numeric elements\n    for i, row in enumerate(matrix):\n        for j, val in enumerate(row):\n            if not isinstance(val, (int, float)):\n                raise TypeError(f\"matrix elements must be int or float (found {type(val)} at {i},{j})\")\n\n    if n == 1:\n        return float(matrix[0][0])\n\n    # Initialize dp_row with path sums for the first row\n    dp_row = [0] * n\n    dp_row[0] = matrix[0][0]\n    for j in range(1, n):\n        dp_row[j] = dp_row[j - 1] + matrix[0][j]\n\n    # Iterate through the remaining rows\n    for i in range(1, n):\n        # Update the first element of the current dp_row (path from above)\n        dp_row[0] = dp_row[0] + matrix[i][0]\n        # Update the rest of the elements in the current dp_row\n        for j in range(1, n):\n            # dp_row[j] (before assignment) is from above; dp_row[j-1] is from left (current row)\n            dp_row[j] = max(dp_row[j], dp_row[j - 1]) + matrix[i][j]\n\n    # The maximum path sum is in the bottom-right cell of the dp table\n    max_sum = dp_row[n - 1]\n\n    # All paths from top-left to bottom-right have the same length\n    path_length = 2 * n - 1\n\n    return float(max_sum) / path_length"}
{"task_id": "Mbpp/723", "solution": "def count_same_pair(a, b) -> int:\n    \"\"\"Counts indices where corresponding elements in two lists are equal, up to the length of the shorter list.\n    Raises TypeError if inputs are not lists.\n    \"\"\"\n    if not isinstance(a, list) or not isinstance(b, list):\n        raise TypeError(\"count_same_pair expects list inputs\")\n\n    min_len = min(len(a), len(b))\n    count = 0\n    for i in range(min_len):\n        if a[i] == b[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base: int, power: int) -> int:\n    \"\"\"Calculates the sum of all digits of `base` to the specified `power`.\n    This function computes `base**power` and sums the decimal digits of its absolute value.\n    assert power_base_sum(2,100)==115\n    \"\"\"\n    if not isinstance(base, int):\n        raise TypeError(\"base must be int\")\n    if not isinstance(power, int):\n        raise TypeError(\"power must be int\")\n    if power < 0:\n        raise ValueError(\"power must be non-negative\")\n\n    value = pow(base, power)\n\n    n = abs(value)\n    digit_sum = 0\n    if n == 0:\n        return 0\n    while n:\n        digit_sum += n % 10\n        n //= 10\n    return digit_sum"}
{"task_id": "Mbpp/725", "solution": "def extract_quotation(s: str) -> list:\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n    import re\n    pat = getattr(extract_quotation, \"_PATTERN\", None)\n    if pat is None:\n        extract_quotation._PATTERN = re.compile(r'(?<!\\\\)\"((?:\\\\.|[^\"\\\\])*)\"', flags=re.DOTALL)\n        pat = extract_quotation._PATTERN\n    return pat.findall(s)"}
{"task_id": "Mbpp/726", "solution": "import numbers\n\ndef validate_input(t: tuple) -> None:\n    \"\"\"Validate that t is a tuple. Raise TypeError if not.\"\"\"\n    if not isinstance(t, tuple):\n        raise TypeError(\"t must be a tuple\")\n\ndef multiply_elements(t: tuple[numbers.Number, ...]) -> tuple[numbers.Number, ...]:\n    \"\"\"Return tuple of adjacent-element products.\n    This function validates the input is a tuple and returns a new tuple\n    where each element is the product of adjacent elements from the input.\n    \"\"\"\n    validate_input(t)\n    return tuple(a * b for a, b in zip(t, t[1:]))"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list):\n    \"\"\"\n    Removes consecutive duplicate elements from a list, returning a new list.\n    Elements are compared using `==`, and the input list is not modified.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"input_list must be a list\")\n\n    if not input_list:\n        return []\n\n    result = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] != result[-1]:\n            result.append(input_list[i])\n\n    return result"}
{"task_id": "Mbpp/728", "solution": "from typing import Sequence, List, Union\nfrom collections.abc import Sequence as AbcSequence\n\ndef _validate_sequence(x: AbcSequence, name: str) -> None:\n    \"\"\"Checks if input is a sequence (excluding strings) and raises TypeError if not.\"\"\"\n    if not isinstance(x, AbcSequence) or isinstance(x, str):\n        raise TypeError(f\"parameter '{name}' must be a sequence (e.g., list, tuple), not a string.\")\n\ndef _validate_equal_length(a: AbcSequence, b: AbcSequence) -> None:\n    \"\"\"Checks if two sequences have equal length and raises ValueError if not.\"\"\"\n    if len(a) != len(b):\n        raise ValueError(\"sequence lengths differ\")\n\ndef _validate_elements_numeric(a: AbcSequence, b: AbcSequence) -> None:\n    \"\"\"Checks if all elements in both sequences are numeric (int or float) and raises TypeError if not.\"\"\"\n    for i in range(len(a)):\n        if not isinstance(a[i], (int, float)):\n            raise TypeError(\"non-numeric element in parameter 'a'\")\n        if not isinstance(b[i], (int, float)):\n            raise TypeError(\"non-numeric element in parameter 'b'\")\n\ndef sum_list(a: Sequence[float], b: Sequence[float]) -> List[float]:\n    \"\"\"\n    Returns a new list with element-wise sums of two input sequences.\n\n    Parameters:\n      a (Sequence[float]): First input sequence of numeric elements (int or float).\n      b (Sequence[float]): Second input sequence of numeric elements (int or float).\n\n    Returns:\n      List[float]: A new list where result[i] == a[i] + b[i].\n\n    Raises:\n      TypeError: If a or b is not a sequence, or any element is not int or float.\n      ValueError: If len(a) != len(b).\n    \"\"\"\n    _validate_sequence(a, 'a')\n    _validate_sequence(b, 'b')\n    _validate_equal_length(a, b)\n    _validate_elements_numeric(a, b)\n\n    result: List[float] = []\n    for x, y in zip(a, b):\n        result.append(x + y)\n    return result"}
{"task_id": "Mbpp/731", "solution": "import math\n\ndef lateralsurface_cone(r, h):\n    \"\"\"Calculates the lateral surface area of a cone given radius r and height h.\n    The area is computed as pi * r * slant_height, where slant_height = sqrt(r^2 + h^2).\n    \"\"\"\n    slant_height = math.sqrt(r**2 + h**2)\n    area = math.pi * r * slant_height\n    return float(area)"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(arr, target):\n    \"\"\"\n    Finds the index of the first occurrence of a number in a sorted array using an iterative binary search variant.\n    Returns the 0-based index or -1 if the target is not found.\n    \"\"\"\n    if not isinstance(arr, (list, tuple)):\n        raise TypeError(\"arr must be a list or tuple\")\n\n    low = 0\n    high = len(arr) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == target:\n            result = mid\n            high = mid - 1  # Continue searching in the left half for an earlier occurrence\n        elif arr[mid] < target:\n            low = mid + 1\n        else:  # arr[mid] > target\n            high = mid - 1\n    return result"}
{"task_id": "Mbpp/732", "solution": "_TRANSLATION_TABLE = str.maketrans({' ': ':', ',': ':', '.': ':'})\n\ndef replace_specialchar(s: str) -> str:\n    \"\"\"Replaces spaces, commas, or dots with colons in a string.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"replace_specialchar expects a str\")\n    return s.translate(_TRANSLATION_TABLE)"}
{"task_id": "Mbpp/737", "solution": "def check_str(s: str) -> bool:\n    \"\"\"\n    Checks if the string `s` starts with an ASCII vowel (a, e, i, o, u), case-insensitive, using the regex pattern '^[aeiouAEIOU]'.\n    It returns True for a match and False otherwise; this includes empty strings or those with leading whitespace.\n\n    Example:\n        check_str('apple')   # -> True\n        check_str(' banana') # -> False\n        # Non-string inputs will raise a TypeError from the re module.\n    \"\"\"\n    import re\n    PATTERN = '^[aeiouAEIOU]'\n    return bool(re.match(PATTERN, s))"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(arr: list, value) -> int:\n    \"\"\"\n    Locates the left insertion point for a value in a sorted list using binary search.\n    Preconditions: arr must be sorted non-decreasingly, and its elements must be comparable with value.\n    \"\"\"\n    low = 0\n    high = len(arr)\n\n    while low < high:\n        mid = (low + high) // 2\n        if arr[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(n: int) -> int:\n    \"\"\"Toggles bits of the number except the first (MSB) and the last (LSB) bit.\n\n    Args:\n        n: Non-negative integer whose middle bits will be toggled.\n\n    Returns:\n        Integer result after toggling bits 1..bit_length(n)-2.\n\n    Raises:\n        ValueError: If n is not an int or is negative.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    L = n.bit_length()\n    if L <= 2:\n        return n\n\n    # mask_all_lower_than_MSB sets bits 0..L-2\n    mask_all_lower_than_MSB = (1 << (L - 1)) - 1\n    # mask_middle clears bit 0 (LSB) leaving bits 1..L-2 set\n    mask_middle = mask_all_lower_than_MSB & ~1\n\n    return n ^ mask_middle"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(lst):\n    \"\"\"Calculates the sum of products of all contiguous sublists using dynamic programming.\n    For each element x, dp_i = x + x * dp_{i-1} = x * (1 + dp_{i-1}), where dp_i is the sum\n    of products of all subarrays ending at the current element.\n    Time complexity: O(n). Space complexity: O(1).\n    \"\"\"\n    prev_dp = 0\n    total_sum = 0\n    for x in lst:\n        dp_i = x * (1 + prev_dp)\n        total_sum += dp_i\n        prev_dp = dp_i\n    return total_sum"}
{"task_id": "Mbpp/739", "solution": "import math\n\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    The function uses integer-only arithmetic and math.isqrt.\n    \"\"\"\n    if n <= 0:\n        raise ValueError('n must be positive')\n\n    # Calculate the smallest number with n digits, which is 10^(n-1).\n    target = 10 ** (n - 1)\n\n    # Solve k*(k+1)/2 >= target for k using integer square root.\n    # This simplifies to k^2 + k - 2*target >= 0.\n    # The approximate positive root for k^2 + k - 2*target = 0 is (-1 + sqrt(1 + 8*target)) / 2.\n    s = math.isqrt(1 + 8 * target)\n    candidate = (s - 1) // 2\n\n    # Since math.isqrt gives the floor and the candidate is a lower bound,\n    # we might need to increment it once or twice to meet the condition.\n    while (candidate * (candidate + 1)) // 2 < target:\n        candidate += 1\n\n    return candidate"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input: tuple) -> dict:\n    \"\"\"\n    Convert an even-length tuple into a dict by pairing adjacent elements.\n    Raises TypeError if input is not a tuple or ValueError if its length is odd.\n    \"\"\"\n    if not isinstance(input, tuple):\n        raise TypeError(\"input must be a tuple\")\n    if len(input) % 2 != 0:\n        raise ValueError(\"tuple length must be even\")\n\n    result = {}\n    for i in range(0, len(input), 2):\n        key = input[i]\n        value = input[i+1]\n        result[key] = value\n    return result"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(s: str) -> bool:\n    \"\"\"\n    Checks if all characters in the input string are identical, returning True for empty or single-character strings.\n    Raises TypeError if the input is not a string; runs in O(n) time with O(1) additional space.\n    Example: assert all_Characters_Same(\"python\") == False\n    \"\"\"\n    # Validate that the input 's' is a string.\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a str\")\n\n    # Empty or single-character strings are considered to have all characters \"the same\".\n    if len(s) <= 1:\n        return True\n\n    # Compare all subsequent characters to the first character.\n    first_char = s[0]\n    for char in s[1:]:\n        if char != first_char:\n            return False\n    return True"}
{"task_id": "Mbpp/742", "solution": "import math\n\ndef area_tetrahedron(edge_length):\n    \"\"\"\n    Calculates the surface area of a regular tetrahedron given its edge length.\n    The formula used is S = sqrt(3) * a^2, where 'a' is the edge length.\n    \"\"\"\n    surface_area = math.sqrt(3) * (edge_length ** 2)\n    return surface_area"}
{"task_id": "Mbpp/744", "solution": "def check_none(values: tuple) -> bool:\n    \"\"\"Return True if any top-level element of the tuple `values` is None; otherwise, return False.\n    Raises TypeError if `values` is not a tuple.\n    \"\"\"\n    if not isinstance(values, tuple):\n        raise TypeError(\"check_none expects a tuple\")\n    return any(e is None for e in values)"}
{"task_id": "Mbpp/743", "solution": "def rotate_right(lst, k) -> list:\n    \"\"\"Rotates a list to the right by a specified number of items.\n\n    Args:\n        lst (list): The input list to rotate.\n        k (int): The number of positions to rotate to the right.\n\n    Returns:\n        list: A new list with elements rotated to the right.\n\n    Raises:\n        TypeError: If lst is not a list or k is not an integer.\n\n    Examples:\n        >>> rotate_right([1,2,3,4,5], 2)\n        [4, 5, 1, 2, 3]\n        >>> rotate_right([], 3)\n        []\n        >>> rotate_right([1,2,3], 4)\n        [3, 1, 2]\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"lst must be a list\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be int\")\n\n    n = len(lst)\n    if n == 0:\n        return []\n\n    if k <= 0:\n        return lst.copy()\n\n    effective_k = k % n\n    if effective_k == 0:\n        return lst.copy()\n\n    return lst[-effective_k:] + lst[:-effective_k]"}
{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    Numbers containing the digit zero are excluded.\n    \"\"\"\n    if not isinstance(startnum, int) or not isinstance(endnum, int):\n        raise TypeError(\"startnum and endnum must be integers\")\n\n    if startnum > endnum:\n        return []\n\n    result_numbers: list[int] = []\n    for n in range(startnum, endnum + 1):\n        num_abs = abs(n)\n        if num_abs == 0:  # The number 0 contains the digit 0\n            continue\n\n        is_divisible = True\n        for char_digit in str(num_abs):\n            digit = int(char_digit)\n            if digit == 0 or n % digit != 0:\n                is_divisible = False\n                break\n\n        if is_divisible:\n            result_numbers.append(n)\n\n    return result_numbers"}
{"task_id": "Mbpp/750", "solution": "def add_tuple(lst, tpl) -> list:\n    \"\"\"\n    Adds elements of a tuple to a list, returning a new list.\n\n    assert add_tuple([1, 2], (3, 4)) == [1, 2, 3, 4]\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"The first argument must be a list.\")\n    if not isinstance(tpl, tuple):\n        raise TypeError(\"The second argument must be a tuple.\")\n\n    result = list(lst)\n    result.extend(tpl)\n    return result"}
{"task_id": "Mbpp/749", "solution": "def sort_numeric_strings(input_list: list[str]) -> list[int]:\n    \"\"\"\n    Converts a list of numeric strings to integers and returns them sorted numerically.\n    Raises ValueError if any string cannot be parsed into a base-10 integer.\n    \"\"\"\n    if not input_list:\n        return []\n\n    parsed_ints = []\n    for s in input_list:\n        # This implicitly handles parsing (FR2, FR3) and raises ValueError on failure (FR9).\n        parsed_ints.append(int(s))\n\n    # This sorts the list in ascending numeric order (FR5) and returns a new list (FR4, FR6).\n    return sorted(parsed_ints)"}
{"task_id": "Mbpp/748", "solution": "import re\n\ndef capital_words_spaces(s: str) -> str:\n    \"\"\"\n    Inserts spaces before words starting with capital letters, preserving acronyms.\n    Applies two regex substitutions in a specific order to achieve this.\n    \"\"\"\n    # Pattern to split between an uppercase acronym and a following capitalized word\n    # e.g., HTTPServer -> HTTP Server\n    PASS1_PATTERN = r'(?<=[A-Z])(?=[A-Z][a-z])'\n    # Pattern to split where a lowercase, digit, or underscore is followed by an uppercase letter\n    # e.g., myFileName -> my File Name, version1Beta -> version1 Beta\n    PASS2_PATTERN = r'(?<=[a-z0-9_])(?=[A-Z])'\n\n    # Apply the first pass: split acronyms from following words\n    result = re.sub(PASS1_PATTERN, ' ', s)\n    # Apply the second pass: split lower/digit/underscore from following uppercase\n    result = re.sub(PASS2_PATTERN, ' ', result)\n\n    return result"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr) -> bool:\n    \"\"\"Return True if 0-indexed array arr represents a min-heap, else False.\"\"\"\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    # Iterate through all parent nodes\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n and arr[i] > arr[left_child_idx]:\n            return False\n        # Check right child\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n):\n    \"\"\"Calculates the nth Jacobsthal number using an iterative approach.\n    Jacobsthal numbers follow the recurrence Jn = Jn-1 + 2 * Jn-2 with J0=0, J1=1.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be >= 0\")\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    a, b = 0, 1  # a represents J(i-2), b represents J(i-1)\n    for _ in range(2, n + 1):\n        c = b + 2 * a  # Calculate J(i)\n        a, b = b, c\n    return b"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds elements that are common across three lists at the same index.\n    Returns a list of such elements, ordered by their index.\n    \"\"\"\n    min_len = min(len(l1), len(l2), len(l3))\n    result = []\n    for i in range(min_len):\n        if l1[i] == l2[i] == l3[i]:\n            result.append(l1[i])\n    return result"}
{"task_id": "Mbpp/753", "solution": "def min_k(records, k):\n    \"\"\"\n    Finds the k records with the minimum second element from a list of tuples.\n\n    Returns the k tuples with the smallest second elements, ordered ascending by the\n    second element.\n    \"\"\"\n    import heapq\n\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an int\")\n    try:\n        iter(records)\n    except TypeError:\n        raise TypeError(\"records must be an iterable\")\n\n    if k <= 0:\n        return []\n\n    # Use heapq.nsmallest to efficiently find the k smallest items.\n    # It handles empty records and k >= len(records) by returning appropriate lists.\n    selected_items = heapq.nsmallest(k, records, key=lambda item: item[1])\n\n    # Sort the selected items to guarantee ascending order by their second element,\n    # as nsmallest does not guarantee overall sorted order of the k elements.\n    final_result = sorted(selected_items, key=lambda item: item[1])\n\n    return final_result"}
{"task_id": "Mbpp/758", "solution": "def unique_sublists(list_of_sublists: list) -> dict:\n    \"\"\"\n    Counts occurrences of sublists, converting them to tuples for dictionary keys.\n    Returns a dictionary mapping unique sublist-tuples to their counts.\n    \"\"\"\n    counts = {}\n\n    for sublist in list_of_sublists:\n        # Convert the sublist to an immutable tuple to use as a dictionary key.\n        # This operation will raise a TypeError if elements within sublist are unhashable.\n        tuple_key = tuple(sublist)\n\n        # Increment the count for this tuple_key, initializing to 0 if not present.\n        counts[tuple_key] = counts.get(tuple_key, 0) + 1\n\n    return counts"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(list_of_strings) -> int:\n    \"\"\"\n    Count unordered index pairs (i, j) with i < j where list_of_strings[i] == reverse(list_of_strings[j]).\n    - Ignores None and non-string items.\n    - Does not mutate the input.\n    - Returns 0 for empty or all-filtered inputs.\n    \"\"\"\n    valid_strings = _filter_valid_strings(list_of_strings)\n    if not valid_strings:\n        return 0\n    freq = _build_frequency_map(valid_strings)\n    return _count_pairs_from_map(freq)\n\ndef _filter_valid_strings(iterable) -> list[str]:\n    result = []\n    for item in iterable:\n        if isinstance(item, str):\n            result.append(item)\n    return result\n\ndef _build_frequency_map(strings: list[str]) -> dict[str, int]:\n    freq = {}\n    for s in strings:\n        freq[s] = freq.get(s, 0) + 1\n    return freq\n\ndef _count_pairs_from_map(freq: dict[str, int]) -> int:\n    total_pairs = 0\n    processed = set()\n    for s, count_s in freq.items():\n        if s in processed:\n            continue\n\n        r = s[::-1]   # language-appropriate reverse\n\n        if r not in freq:\n            if s == r: # Palindrome with no reverse pair outside itself\n                n = count_s\n                total_pairs += n * (n - 1) // 2\n            processed.add(s)\n        else: # r is in freq\n            count_r = freq[r]\n            if s == r: # Palindrome\n                n = count_s\n                total_pairs += n * (n - 1) // 2\n                processed.add(s)\n            else: # s and r are distinct reverses\n                total_pairs += count_s * count_r\n                processed.add(s)\n                processed.add(r)\n    return total_pairs"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(lst):\n    \"\"\"\n    Finds the second smallest distinct numeric value in a list.\n    Raises TypeError for invalid input or element types, ValueError if insufficient distinct values.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list\")\n\n    min1_set = False\n    min2_set = False\n    min1 = None\n    min2 = None\n\n    for x in lst:\n        # Validate elements according to design context\n        if isinstance(x, bool):\n            raise TypeError(\"All elements must be int or float (bool is not accepted)\")\n        if not isinstance(x, (int, float)):\n            raise TypeError(\"All elements must be int or float (bool is not accepted)\")\n        if isinstance(x, float) and x != x:  # Check for NaN\n            raise TypeError(\"NaN is not an acceptable element\")\n\n        # Update min1 and min2 while enforcing distinctness\n        if not min1_set:\n            min1 = x\n            min1_set = True\n        elif x == min1:\n            # Duplicate of min1, skip\n            continue\n        elif not min2_set:\n            # Second distinct value seen; place appropriately\n            if x < min1:\n                min2 = min1\n                min1 = x\n            else:\n                min2 = x\n            min2_set = True\n        else:\n            # Both min1 and min2 are set; update if x is a new distinct smaller value\n            if x < min1:\n                min2 = min1\n                min1 = x\n            elif min1 < x < min2:\n                min2 = x\n            # If x >= min2 or x == min2 (duplicate), no change; continue implicitly\n\n    # After loop, check if min2 was successfully set\n    if min2_set:\n        return min2\n    else:\n        raise ValueError(\"List must contain at least two distinct numeric values\")"}
{"task_id": "Mbpp/760", "solution": "def unique_Element(numbers: list) -> bool:\n    \"\"\"Checks if a list contains only one distinct numeric element.\n    Returns True if so, False otherwise (including empty lists).\n    assert unique_Element([1,1,1]) == True\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input 'numbers' must be a list.\")\n\n    if not numbers:\n        return False\n\n    first_value = numbers[0]\n    if not isinstance(first_value, (int, float)):\n        raise ValueError(\"All elements in the list must be numbers (int or float).\")\n\n    for i in range(1, len(numbers)):\n        current_element = numbers[i]\n        if not isinstance(current_element, (int, float)):\n            raise ValueError(\"All elements in the list must be numbers (int or float).\")\n        if current_element != first_value:\n            return False\n\n    return True"}
{"task_id": "Mbpp/762", "solution": "def check_monthnumber_number(month_number: int) -> bool:\n    \"\"\"\n    Checks if a given month number (1-12) corresponds to a month with 30 days.\n\n    The function validates `month_number` to be an int (explicitly rejecting bools)\n    and within the 1-12 range, raising TypeError or ValueError for invalid inputs.\n    It returns True for April (4), June (6), September (9), November (11); False otherwise.\n\n    Examples:\n        check_monthnumber_number(4) -> True\n        check_monthnumber_number(2) -> False\n        check_monthnumber_number(11) -> True\n        check_monthnumber_number(13) -> raises ValueError\n        check_monthnumber_number('3') -> raises TypeError\n    \"\"\"\n    _THIRTY_DAY_MONTHS = {4, 6, 9, 11}\n\n    # Validate input type and explicitly reject booleans.\n    if isinstance(month_number, bool):\n        raise TypeError(\"month_number must be int (bool is not accepted)\")\n    if not isinstance(month_number, int):\n        raise TypeError(\"month_number must be an int\")\n\n    # Validate month number range.\n    if not (1 <= month_number <= 12):\n        raise ValueError(\"month_number must be in 1..12\")\n\n    # Check for membership in the set of months with 30 days.\n    return month_number in _THIRTY_DAY_MONTHS"}
{"task_id": "Mbpp/759", "solution": "import re\n\n# Compile the regular expression once when the module is loaded.\n# The pattern requires an optional sign (+/-), zero or more digits,\n# a literal dot, and exactly two digits after the dot.\n_DECIMAL_PATTERN = re.compile(r'^[+-]?[0-9]*\\.[0-9]{2}$')\n\ndef is_decimal(s: str) -> bool:\n    \"\"\"\n    Checks if the given string represents a decimal number with a precision of 2.\n    Returns True for valid formats, False for non-string inputs or malformed strings.\n    \"\"\"\n    if not isinstance(s, str):\n        return False\n    return bool(_DECIMAL_PATTERN.fullmatch(s))"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(s: str) -> int:\n    \"\"\"Counts the number of digit characters in a given string.\n    The function iterates through the string, incrementing a counter for each digit.\n    \"\"\"\n    count = 0\n    for char in s:\n        if char.isdigit():\n            count += 1\n    return count"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list):\n    \"\"\"\n    Returns a list of all pairs of consecutive items in a given list.\n    Handles lists shorter than two elements by returning an empty list.\n    \"\"\"\n    if len(input_list) < 2:\n        return []\n\n    result = []\n    for i in range(len(input_list) - 1):\n        result.append((input_list[i], input_list[i+1]))\n\n    return result"}
{"task_id": "Mbpp/763", "solution": "from typing import Sequence, List, Any, Union\n\ndef _validate_inputs(arr: Sequence[Any], n: int) -> None:\n    \"\"\"\n    Validates the input array and its length according to specified rules.\n    Raises ValueError or TypeError on validation failure.\n    \"\"\"\n    if not isinstance(n, int):\n        # Attempt to get len(arr) for the error message, handle if it fails\n        try:\n            length = len(arr)\n        except TypeError:\n            length = \"unknown\"\n        raise ValueError(f\"n must be an integer equal to len(arr); got n={n!r}, len(arr)={length!r}\")\n\n    try:\n        length = len(arr)\n    except TypeError:\n        raise ValueError(f\"arr does not have a definable length; got n={n!r}\")\n\n    if n != length:\n        raise ValueError(f\"n must be an integer equal to len(arr); got n={n!r}, len(arr)={length!r}\")\n\n    if n < 2:\n        raise ValueError(f\"n must be >= 2; got n={n!r}\")\n\n    for i, value in enumerate(arr):\n        if isinstance(value, bool): # Explicitly reject booleans as non-numeric\n            raise TypeError(f\"arr contains non-numeric element at index {i}: {value!r} (expected int or float, not bool)\")\n        if not isinstance(value, (int, float)):\n            raise TypeError(f\"arr contains non-numeric element at index {i}: {value!r} (expected int or float)\")\n\ndef _make_sorted_copy(arr: Sequence[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\"\n    Creates and returns a shallow list copy of the input sequence, sorted in ascending order.\n    \"\"\"\n    return sorted(list(arr))\n\ndef _compute_min_adjacent_diff(sorted_arr: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the minimum absolute difference between adjacent elements in a sorted array.\n    Returns 0 immediately if any duplicate adjacent values are found.\n    \"\"\"\n    min_diff = float('inf')\n    for i in range(1, len(sorted_arr)):\n        diff = abs(sorted_arr[i] - sorted_arr[i-1])\n        if diff == 0:\n            return 0\n        if diff < min_diff:\n            min_diff = diff\n    return min_diff\n\ndef find_min_diff(arr: Sequence[Union[int, float]], n: int) -> Union[int, float]:\n    \"\"\"\n    Finds the minimum absolute difference between any two elements in a given array.\n    This function validates inputs, sorts a copy, and computes the minimum adjacent difference.\n    \"\"\"\n    _validate_inputs(arr, n)\n    sorted_arr = _make_sorted_copy(arr)\n    return _compute_min_adjacent_diff(sorted_arr)"}
{"task_id": "Mbpp/765", "solution": "def nth_polite_number(n):\n    def _count_polite(x):\n        # Number of polite integers \u2264 x: x - (floor(log2(x)) + 1) == x - x.bit_length()\n        if x < 1:\n            return 0\n        return x - x.bit_length()\n\n    # Validate input\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be an integer >= 1\")\n\n    # Exponential bounding to find an upper bound where count_polite(high) >= n\n    high = 1\n    while _count_polite(high) < n:\n        high <<= 1\n\n    # Binary search in [low, high] for the minimal p with count_polite(p) >= n\n    low = max(1, high >> 1)\n    while low < high:\n        mid = (low + high) // 2\n        if _count_polite(mid) >= n:\n            high = mid\n        else:\n            low = mid + 1\n\n    return low"}
{"task_id": "Mbpp/769", "solution": "import collections\nfrom typing import Iterable, Any\n\ndef _validate_iterable(obj: Any, name: str) -> None:\n    \"\"\"Validates if an object is iterable, raising TypeError if not.\"\"\"\n    try:\n        iter(obj)\n    except TypeError:\n        raise TypeError(f\"{name} must be an iterable.\")\n\ndef _is_hashable(x: Any) -> bool:\n    \"\"\"Checks if an object is hashable.\"\"\"\n    try:\n        hash(x)\n        return True\n    except TypeError:\n        return False\n\ndef Diff(a: Iterable[Any], b: Iterable[Any]) -> list:\n    \"\"\"\n    Computes the multiset difference between two iterables, preserving parity-based ordering.\n    Elements are removed from `a` by matching occurrences in `b` from left-to-right.\n    \"\"\"\n    _validate_iterable(a, 'a')\n    _validate_iterable(b, 'b')\n\n    list_b = list(b)\n\n    hashable_path = True\n    for item_b in list_b:\n        if not _is_hashable(item_b):\n            hashable_path = False\n            break\n\n    if hashable_path:\n        counts = collections.Counter(list_b)\n    else:\n        remaining = list_b.copy()\n\n    kept = []\n    for i, x in enumerate(a):\n        consumed = False\n        if hashable_path:\n            if counts.get(x, 0) > 0:\n                counts[x] -= 1\n                consumed = True\n        else:\n            try:\n                # Find the first occurrence and remove it to simulate multiset subtraction\n                idx_to_remove = remaining.index(x)\n                remaining.pop(idx_to_remove)\n                consumed = True\n            except ValueError:\n                # Element not found in remaining, so it's not consumed\n                pass\n\n        if not consumed:\n            kept.append((i, x))\n\n    evens = []\n    odds = []\n    for i, x in kept:\n        if i % 2 == 0:\n            evens.append(x)\n        else:\n            odds.append(x)\n\n    return evens + odds"}
{"task_id": "Mbpp/767", "solution": "import math\n\n# Default epsilon for float comparisons, as specified in the design context.\nDEFAULT_EPSILON = 1e-9\n\n# Calculate the number of decimal places for rounding based on epsilon.\n# This value is used to canonicalize float keys for consistent dictionary lookup,\n# effectively grouping numbers that are very close due to floating-point inaccuracies.\n# For example, with DEFAULT_EPSILON = 1e-9, log10(1e-9) is -9, so -floor(-9) is 9.\n# Numbers will be rounded to 9 decimal places. If epsilon is non-positive, rounding defaults to 0.\n_float_rounding_decimals = max(0, -math.floor(math.log10(DEFAULT_EPSILON))) if DEFAULT_EPSILON > 0 else 0\n\ndef get_pairs_count(numbers, sum):\n    \"\"\"\n    Counts the number of unordered pairs in a list of numbers whose sum equals the target sum.\n\n    This function uses a hashmap (dictionary) approach to achieve an average O(N) time complexity.\n    It handles both integers and floats, using a configurable epsilon (DEFAULT_EPSILON)\n    for float comparisons by canonicalizing dictionary keys through rounding.\n    \"\"\"\n    # Materialize the input `numbers` iterable into a list. This ensures the collection\n    # can be iterated multiple times (if needed by alternative algorithms, though not by this one),\n    # provides a stable length for checks, and avoids mutating any external iterator/generator.\n    # Per instructions, type validation for elements is omitted and relies on Python's runtime behavior.\n    num_list = list(numbers)\n\n    # If the list contains fewer than two elements, no pairs can be formed.\n    if len(num_list) < 2:\n        return 0\n\n    # Inline helper function to obtain a canonical key for dictionary storage.\n    # Both integers and floats are rounded to a fixed number of decimal places\n    # determined by `_float_rounding_decimals`. For integers, this rounding has\n    # no practical effect (e.g., round(5, 9) results in 5). This approach helps\n    # to manage floating-point inaccuracies when values are used as dictionary keys.\n    def _get_canonical_key(value):\n        # This relies on the input `value` being numeric (int or float) as per\n        # the problem's constraints to not add explicit type checking.\n        return round(value, _float_rounding_decimals)\n\n    counts = {}  # Dictionary to store frequencies of canonicalized numbers encountered so far\n    pair_count = 0  # Initialize the total count of valid pairs\n\n    for num in num_list:\n        canonical_num = _get_canonical_key(num)\n\n        # Calculate the complement needed for the current `num` to reach the `sum`.\n        # The complement is also canonicalized for consistent dictionary lookup.\n        complement = sum - num\n        canonical_complement = _get_canonical_key(complement)\n\n        # If the canonical complement has been seen and counted before, add its frequency\n        # to the total pair count. This method correctly handles cases where numbers\n        # are duplicated in the input list, ensuring each distinct index pair (i < j)\n        # is counted exactly once.\n        if canonical_complement in counts:\n            pair_count += counts[canonical_complement]\n\n        # Increment the count for the current canonical number, preparing for subsequent lookups.\n        counts[canonical_num] = counts.get(canonical_num, 0) + 1\n\n    return pair_count"}
