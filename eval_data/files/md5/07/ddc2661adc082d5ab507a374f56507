{"task_id": "Mbpp/253", "solution": "def count_integer(lst: list) -> int:\n    \"\"\"Counts the number of top-level integer elements in a given list.\n    Only elements whose type is exactly `int` are counted; this excludes booleans and does not traverse nested sequences.\n\n    Example:\n        >>> count_integer([1, 2, 'abc', 1.2])\n        2\n    \"\"\"\n    count = 0\n    for element in lst:\n        if type(element) is int:\n            count += 1\n    return count"}
{"task_id": "Mbpp/255", "solution": "def combinations_colors(items, n):\n    \"\"\"\n    Generates all combinations with repetition of elements from 'items' of length 'n'.\n    Returns a list of tuples, ordered lexicographically by non-decreasing indices.\n    \"\"\"\n\n    class ResultList:\n        \"\"\"Accumulates produced combination tuples.\"\"\"\n        def __init__(self):\n            self.combinations = []\n\n        def append(self, comb):\n            \"\"\"Adds a combination tuple to the result list.\"\"\"\n            self.combinations.append(comb)\n\n    class CombinationGenerator:\n        \"\"\"Generates combinations with repetition using recursive backtracking.\"\"\"\n        def __init__(self, items_ref, n_ref, result_list_ref):\n            self.items = items_ref\n            self.n = n_ref\n            self.result = result_list_ref\n            self.len_items = len(items_ref)\n            self._indices = [0] * n_ref\n\n        def generate(self):\n            \"\"\"Initiates the combination generation process and returns the final list.\"\"\"\n            if self.n == 0:\n                self.result.append(())\n            elif self.len_items > 0:\n                self._backtrack(0, 0)\n            return self.result.combinations\n\n        def _backtrack(self, pos: int, start: int) -> None:\n            \"\"\"\n            Recursive helper to build combinations, enforcing non-decreasing indices.\n            'pos' is the current index in the _indices array; 'start' is the minimum index for item selection.\n            \"\"\"\n            if pos == self.n:\n                # A combination of length 'n' has been formed, convert indices to item tuple.\n                comb = tuple(self.items[idx] for idx in self._indices)\n                self.result.append(comb)\n                return\n\n            for i in range(start, self.len_items):\n                self._indices[pos] = i\n                self._backtrack(pos + 1, i)\n\n    # --- Main logic of combinations_colors function ---\n\n    if n == 0:\n        return [()]\n    if len(items) == 0 and n > 0:\n        return []\n\n    result_list = ResultList()\n    generator = CombinationGenerator(items, n, result_list)\n    return generator.generate()"}
{"task_id": "Mbpp/256", "solution": "def count_Primes_nums(n: (int, float)) -> int:\n    \"\"\"\n    Counts prime numbers less than `n` using an optimized Sieve of Eratosthenes.\n    Accepts ints and floats (floats are truncated toward zero). Raises:\n      - TypeError for non-int/float inputs\n      - ValueError if the truncated value is negative\n\n    Time complexity: O(N log log N), Space complexity: O(N), where N = int(n).\n    \"\"\"\n    if not isinstance(n, (int, float)):\n        raise TypeError(\"Input must be an int or float\")\n\n    limit = int(n)\n    if limit < 0:\n        raise ValueError(\"Input must be non-negative\")\n\n    if limit <= 2:\n        return 0\n\n    sieve = bytearray(limit)  # 0 for potential prime, 1 for composite\n\n    # Sieve of Eratosthenes: mark multiples starting from i*i\n    max_i = int(limit**0.5)\n    for i in range(2, max_i + 1):\n        if sieve[i] == 0:\n            start = i * i\n            if start >= limit:\n                continue\n            step = i\n            length = ((limit - 1) - start) // step + 1\n            sieve[start:limit:step] = b'\\x01' * length\n\n    # Count primes in [2, limit)\n    prime_count = 0\n    for i in range(2, limit):\n        if sieve[i] == 0:\n            prime_count += 1\n\n    return prime_count"}
{"task_id": "Mbpp/259", "solution": "from typing import Sequence, Tuple, Any\n\ndef maximize_elements(seq1: Sequence[Tuple[Any, ...]], seq2: Sequence[Tuple[Any, ...]]) -> Tuple[Tuple[Any, ...], ...]:\n    \"\"\"Computes element-wise maxima of two sequences of equal-length tuples, returning an immutable tuple of tuples.\"\"\"\n    result_outer = []\n    for i in range(len(seq1)):\n        inner1 = seq1[i]\n        inner2 = seq2[i]\n        result_inner = []\n        for j in range(len(inner1)):\n            m = max(inner1[j], inner2[j])\n            result_inner.append(m)\n        result_outer.append(tuple(result_inner))\n    return tuple(result_outer)"}
{"task_id": "Mbpp/262", "solution": "def split_two_parts(lst: list, L: int) -> tuple[list, list]:\n    \"\"\"\n    Splits a list into two parts at a given length L and returns them as a tuple.\n\n    Args:\n        lst: The list to split.\n        L: The length of the first part.\n\n    Returns:\n        A tuple (first_part, second_part) where first_part has length L (or the entire list if L >= len(lst)),\n        and second_part contains the remainder.\n\n    Raises:\n        TypeError: If lst is not a list or L is not an integer.\n        ValueError: If L is negative.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"lst must be of type list\")\n    if not isinstance(L, int):\n        raise TypeError(\"L must be an integer\")\n    if L < 0:\n        raise ValueError(\"L must be non-negative\")\n\n    first_part = lst[:L]\n    second_part = lst[L:]\n    return (first_part, second_part)"}
{"task_id": "Mbpp/260", "solution": "def newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the nth Newman\u2013Shanks\u2013Williams number using matrix exponentiation.\n    The sequence is defined as A(0)=1, A(1)=1, A(n)=2*A(n-1)+A(n-2) for n >= 2.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be int\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n == 0:\n        return 1\n\n    def _matrix_multiply(mat1, mat2):\n        \"\"\"Multiplies two 2x2 matrices represented as (a11, a12, a21, a22) tuples.\"\"\"\n        a, b, c, d = mat1\n        e, f, g, h = mat2\n        return (a * e + b * g, a * f + b * h, c * e + d * g, c * f + d * h)\n\n    def _matrix_identity():\n        \"\"\"Returns the 2x2 identity matrix.\"\"\"\n        return (1, 0, 0, 1)\n\n    def _matrix_base_M():\n        \"\"\"Returns the base matrix M = [[2, 1], [1, 0]] for NSW sequence calculation.\"\"\"\n        return (2, 1, 1, 0)\n\n    def _matrix_pow(matrix, exponent):\n        \"\"\"Computes matrix raised to the power of exponent using exponentiation-by-squaring.\"\"\"\n        result = _matrix_identity()\n        base = matrix\n        e = exponent\n        while e > 0:\n            if e & 1:  # If exponent is odd\n                result = _matrix_multiply(result, base)\n            base = _matrix_multiply(base, base)\n            e >>= 1  # Divide exponent by 2\n        return result\n\n    # For n >= 1, [A(n), A(n-1)]^T = M^(n-1) * [A(1), A(0)]^T\n    # With A(1)=1 and A(0)=1, the base vector is [1, 1]^T.\n    # If M^(n-1) = [[a, b], [c, d]], then A(n) = a*1 + b*1 = a + b.\n    exponent_k = n - 1\n    powered_matrix = _matrix_pow(_matrix_base_M(), exponent_k)\n\n    a, b, _, _ = powered_matrix\n    return a + b"}
{"task_id": "Mbpp/264", "solution": "def dog_age(human_age):\n    \"\"\"\n    Calculates a dog's age in dog's years based on a common formula:\n    - First two human years count as 10.5 dog years each.\n    - Each additional human year counts as 4 dog years.\n    Returns a float. Non-positive inputs return 0.0.\n    \"\"\"\n    if not isinstance(human_age, (int, float)):\n        raise TypeError(\"human_age must be an int or float\")\n    if human_age <= 0:\n        return 0.0\n    if human_age <= 2:\n        return float(human_age) * 10.5\n    return 21.0 + (float(human_age) - 2.0) * 4.0"}
{"task_id": "Mbpp/261", "solution": "from typing import Tuple, Union\n\ndef _validate_is_tuple(obj: object, name: str) -> None:\n    \"\"\"Ensures an input object is exactly an instance of tuple; raises TypeError otherwise.\"\"\"\n    if not isinstance(obj, tuple):\n        raise TypeError(f\"'{name}' must be a tuple.\")\n\ndef _validate_elements_numeric(numerators: tuple, denominators: tuple) -> None:\n    \"\"\"Ensures every element in both tuples is an int or float; raises TypeError on violation.\"\"\"\n    # This check runs up to the length of the shorter tuple if lengths are unequal,\n    # catching non-numeric elements early per fail-fast order.\n    for i, (num, den) in enumerate(zip(numerators, denominators)):\n        if not isinstance(num, (int, float)):\n            raise TypeError(f\"Numerator at index {i} must be an int or float, got {type(num).__name__}.\")\n        if not isinstance(den, (int, float)):\n            raise TypeError(f\"Denominator at index {i} must be an int or float, got {type(den).__name__}.\")\n\ndef _validate_lengths_equal(numerators: tuple, denominators: tuple) -> None:\n    \"\"\"Ensures tuple lengths match; raises ValueError otherwise.\"\"\"\n    if len(numerators) != len(denominators):\n        raise ValueError(\"Input tuples must have equal length.\")\n\ndef _validate_denominators_non_zero(denominators: tuple) -> None:\n    \"\"\"Ensures no denominator equals zero; raises ZeroDivisionError otherwise.\"\"\"\n    for i, den in enumerate(denominators):\n        if den == 0 or den == 0.0:\n            raise ZeroDivisionError(f\"Denominator at index {i} cannot be zero.\")\n\ndef _validate_inputs(numerators: tuple, denominators: tuple) -> None:\n    \"\"\"Orchestrates fail-fast validations in the specified order.\"\"\"\n    _validate_is_tuple(numerators, 'numerators')\n    _validate_is_tuple(denominators, 'denominators')\n    _validate_elements_numeric(numerators, denominators)\n    _validate_lengths_equal(numerators, denominators)\n    _validate_denominators_non_zero(denominators)\n\ndef _is_exact_integer_division(a: int, b: int) -> bool:\n    \"\"\"Returns True when both a and b are integers and a % b == 0.\"\"\"\n    return a % b == 0\n\ndef _compute_results(numerators: tuple, denominators: tuple) -> tuple:\n    \"\"\"Performs element-wise division, applying the exact integer rule, and returns a tuple.\"\"\"\n    results = []\n    for num, den in zip(numerators, denominators):\n        if isinstance(num, int) and isinstance(den, int) and _is_exact_integer_division(num, den):\n            results.append(num // den)\n        else:\n            results.append(num / den)\n    return tuple(results)\n\ndef division_elements(numerators: tuple, denominators: tuple) -> tuple:\n    \"\"\"\n    Public API per SRS. Raises TypeError, ValueError, ZeroDivisionError as specified.\n    Performs element-wise division on two tuples of numbers, with an exact integer division rule.\n    \"\"\"\n    _validate_inputs(numerators, denominators)\n    return _compute_results(numerators, denominators)"}
{"task_id": "Mbpp/266", "solution": "def lateralsurface_cube(side):\n    \"\"\"\n    Computes the lateral surface area of a cube given its side length.\n\n    >>> lateralsurface_cube(2)\n    16.0\n    >>> lateralsurface_cube(1.5)\n    9.0\n    >>> lateralsurface_cube(0)\n    0.0\n    \"\"\"\n    import math\n\n    class ValidationResult:\n        \"\"\"Data carrier for validation outcome.\"\"\"\n        def __init__(self, valid: bool, message: str):\n            self.valid = valid\n            self.message = message\n\n    def _validate_side(s) -> ValidationResult:\n        \"\"\"Performs type, finiteness, and non-negativity checks.\"\"\"\n        if not isinstance(s, (int, float)):\n            return ValidationResult(False, \"TypeError: side must be an int or float\")\n        if not math.isfinite(s):\n            return ValidationResult(False, \"ValueError: side must be finite (not NaN or \u00b1inf)\")\n        if s < 0:\n            return ValidationResult(False, \"ValueError: side must be non-negative\")\n        return ValidationResult(True, \"\")\n\n    def _compute_lateral_surface(s: float) -> float:\n        \"\"\"Computes the lateral surface area using the formula 4 * side**2.\"\"\"\n        return 4.0 * (s ** 2)\n\n    validation_result = _validate_side(side)\n    if not validation_result.valid:\n        if validation_result.message.startswith(\"TypeError\"):\n            raise TypeError(validation_result.message)\n        else:\n            raise ValueError(validation_result.message)\n\n    side_float = float(side)\n    lateral_area = _compute_lateral_surface(side_float)\n\n    # As per design, OVERFLOW_POLICY is 'allow_float', so rely on Python's float behavior.\n    return float(lateral_area)"}
{"task_id": "Mbpp/268", "solution": "def find_star_num(n):\n    \"\"\"\n    Calculates the n'th star number using the formula S(n) = 6 * n * (n - 1) + 1.\n\n    Parameters:\n    - n (int): 1-based index of the star number to compute. Must be an integer >= 1.\n\n    Returns:\n    - int: the n-th star number.\n\n    Raises:\n    - TypeError: if n is not an int.\n    - ValueError: if n < 1.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n    return 6 * n * (n - 1) + 1"}
{"task_id": "Mbpp/265", "solution": "def list_split(lst, n):\n    \"\"\"\n    Splits a list into n sublists, distributing elements by their index modulo n.\n    An element at index `i` in `lst` goes to the sublist at `result[i % n]`.\n\n    Parameters:\n    - lst: list - input list of elements.\n    - n: int - number of sublists to produce (must be > 0).\n\n    Returns:\n    - List[List]: a list containing n sublists.\n\n    Raises:\n    - TypeError: if lst is not a list or n is not an int.\n    - ValueError: if n <= 0.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"lst must be a list\")\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n <= 0:\n        raise ValueError(\"n must be > 0\")\n\n    # Initialize n empty sublists for the result.\n    sublists = [[] for _ in range(n)]\n\n    # Iterate through the original list and distribute elements into the sublists.\n    for i, element in enumerate(lst):\n        sublists[i % n].append(element)\n\n    return sublists"}
{"task_id": "Mbpp/267", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the squares of the first n odd natural numbers using a closed-form formula.\n    Assumes n is a non-negative integer based on prompt constraints.\n    \"\"\"\n    term_a = 2 * n - 1\n    term_b = 2 * n + 1\n    numerator = n * term_a * term_b\n    result = numerator // 3\n    return result"}
{"task_id": "Mbpp/269", "solution": "def ascii_value(char: str) -> int:\n    \"\"\"\n    Finds the ASCII value of a character with validation.\n\n    Signature: ascii_value(char: str) -> int\n    Parameter Validation:\n        - Raises TypeError if `char` is not a str.\n        - Raises ValueError if `len(char)` is not 1.\n        - Raises ValueError if `ord(char)` is outside the ASCII range (0-127).\n    Behavior:\n        - For valid input (single ASCII character), returns its integer ASCII code (0-127).\n    Examples:\n        - ascii_value('A') -> 65\n        - ascii_value('\u20ac') raises ValueError (character ordinal outside ASCII 0..127)\n    Complexity: Time O(1), Space O(1) additional.\n    \"\"\"\n    if not isinstance(char, str):\n        raise TypeError(\"char must be a str\")\n    if len(char) != 1:\n        raise ValueError(\"char must be length 1\")\n\n    code = ord(char)\n    if not (0 <= code <= 127):\n        raise ValueError(\"character ordinal outside ASCII 0..127\")\n\n    return code"}
{"task_id": "Mbpp/272", "solution": "def rear_extract(iterable):\n    \"\"\"\n    Extracts the last element from each tuple in an iterable, returning them as a list.\n    Validates input for iterability and checks that all elements are non-empty tuples.\n    \"\"\"\n    extracted_rears = []\n\n    try:\n        iterator = iter(iterable)\n    except TypeError:\n        raise TypeError(\"Provided argument is not iterable\")\n\n    for item in iterator:\n        if not isinstance(item, tuple):\n            raise ValueError(\"All elements of the iterable must be tuples\")\n\n        if len(item) == 0:\n            raise ValueError(\"Tuples must be non-empty\")\n\n        extracted_rears.append(item[-1])\n\n    return extracted_rears"}
{"task_id": "Mbpp/270", "solution": "def sum_even_and_even_index(numbers):\n    \"\"\"\n    Finds the sum of even numbers at even 0-based positions in a list.\n\n    Parameters:\n    - numbers (list[int]): List of integers.\n\n    Returns:\n    - int: Sum of elements that are even and located at even indices.\n\n    Example:\n    >>> sum_even_and_even_index([5, 6, 12, 1, 18, 8])\n    30\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(numbers):\n        if i % 2 == 0 and num % 2 == 0:\n            total_sum += num\n    return total_sum"}
{"task_id": "Mbpp/271", "solution": "def even_Power_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the first n even natural numbers each raised to the fifth power.\n    Validates n to be an integer greater than or equal to 1, raising ValueError otherwise.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be integer >= 1\")\n\n    # Closed-form formula: S(n) = (32 * n^2 * (n+1)^2 * (2n^2 + 2n - 1)) // 12\n    n_squared = n * n\n    n_plus_1_squared = (n + 1) * (n + 1)\n    term_2n_squared_plus_2n_minus_1 = 2 * n_squared + 2 * n - 1\n\n    numerator = 32 * n_squared * n_plus_1_squared * term_2n_squared_plus_2n_minus_1\n    result = numerator // 12\n\n    return result"}
{"task_id": "Mbpp/273", "solution": "def substract_elements(a: tuple, b: tuple) -> tuple:\n    # NFR6: Time complexity O(n), space complexity O(n), where n = len(a) = len(b).\n    # FR2: Validate input types\n    if not isinstance(a, tuple) or not isinstance(b, tuple):\n        raise TypeError(\"Both inputs must be tuples\")\n\n    # FR3: Validate lengths\n    if len(a) != len(b):\n        raise ValueError(\"Input tuples must have equal length\")\n\n    result_list = []\n    for val_a, val_b in zip(a, b):\n        # FR4: Validate numeric element types\n        if not isinstance(val_a, (int, float)) or not isinstance(val_b, (int, float)):\n            raise TypeError(\"All elements must be int or float\")\n        result_list.append(val_a - val_b)\n\n    return tuple(result_list)"}
{"task_id": "Mbpp/274", "solution": "def even_binomial_Coeff_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of even index binomial coefficients for a non-negative integer n.\n    Uses the identity: sum_{k even} C(n,k) = (2^n + (1-1)^n) / 2, which simplifies to:\n      - 1 when n == 0\n      - 2^(n-1) when n >= 1\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be >= 0\")\n\n    if n == 0:\n        return 1\n    else:\n        return 1 << (n - 1)"}
{"task_id": "Mbpp/277", "solution": "def validate_inputs(data: dict, n: int) -> None:\n    \"\"\"Validates the input dictionary and integer n, raising TypeError for invalid types or non-numeric values.\"\"\"\n    if not isinstance(data, dict):\n        raise TypeError(\"data must be a dict\")\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    for k, v in data.items():\n        if not isinstance(v, (int, float)):\n            raise TypeError(f\"value for key '{k}' is not numeric (int or float)\")\n\ndef filter_entries(data: dict, n: int) -> dict:\n    \"\"\"Filters the dictionary to include only entries with values greater than or equal to n.\"\"\"\n    filtered_dict = {}\n    for k, v in data.items():\n        if v >= n:\n            filtered_dict[k] = v\n    return filtered_dict\n\ndef dict_filter(data: dict, n: int) -> dict:\n    \"\"\"\n    Filters a dictionary to only include entries with values greater than or equal to n.\n    Input validation is performed before filtering.\n    \"\"\"\n    validate_inputs(data, n)\n    return filter_entries(data, n)"}
{"task_id": "Mbpp/279", "solution": "def is_num_decagonal(n: int) -> int:\n    \"\"\"Calculates the nth decagonal number.\n    Raises ValueError if n is not an integer or is less than 1.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be an integer >= 1\")\n\n    decagonal_number = n * (4 * n - 3)\n    return decagonal_number"}
{"task_id": "Mbpp/278", "solution": "from dataclasses import dataclass\nfrom typing import Any\n\n@dataclass\nclass CountResult:\n    \"\"\"Internal data structure to hold the computed count.\"\"\"\n    count: int\n\nclass Validator:\n    \"\"\"Validates the input type for the count_first_elements function.\"\"\"\n    def validate(self, input: Any) -> None:\n        if not isinstance(input, tuple):\n            raise TypeError(\"count_first_elements expects a tuple input\")\n\nclass TupleScanner:\n    \"\"\"Scans a tuple to find the number of elements before the first top-level tuple.\"\"\"\n    def scan_for_first_tuple(self, input_tuple: tuple) -> int:\n        count = 0\n        for element in input_tuple:\n            if isinstance(element, tuple):\n                return count\n            count += 1\n        return count\n\ndef count_first_elements(input_tuple: tuple) -> int:\n    \"\"\"\n    Counts the number of top-level elements that occur before the first top-level tuple element.\n    Assert count_first_elements((1, 5, 7, (4, 6), 10) ) == 3\n    \"\"\"\n    validator = Validator()\n    validator.validate(input_tuple)\n\n    scanner = TupleScanner()\n    return scanner.scan_for_first_tuple(input_tuple)"}
{"task_id": "Mbpp/276", "solution": "import math\nfrom typing import Union, Any\n\nclass Cylinder:\n    \"\"\"Holds sanitized numeric values for radius and height as floats.\"\"\"\n    def __init__(self, radius: float, height: float) -> None:\n        self.radius = radius\n        self.height = height\n\nclass Validator:\n    \"\"\"Validates numeric type and non-negativity of input values.\"\"\"\n    def validate_numeric(self, value: Any, name: str) -> None:\n        \"\"\"\n        Validates if the value is a number (int or float) and not a boolean.\n        Raises TypeError if validation fails.\n        \"\"\"\n        if not isinstance(value, (int, float)) or isinstance(value, bool):\n            raise TypeError(\n                f\"{name} must be a number (int or float), got {value!r} (type {type(value).__name__})\"\n            )\n\n    def validate_non_negative(self, value: float, name: str) -> None:\n        \"\"\"\n        Validates if the numeric value is non-negative.\n        Raises ValueError if validation fails.\n        \"\"\"\n        if value < 0:\n            raise ValueError(\n                f\"{name} must be non-negative, got {value!r} (type {type(value).__name__})\"\n            )\n\nclass VolumeCalculator:\n    \"\"\"Computes the volume of a cylinder using math.pi.\"\"\"\n    def compute_volume(self, c: Cylinder) -> float:\n        \"\"\"\n        Calculates the volume using the formula: pi * radius^2 * height.\n        \"\"\"\n        return math.pi * c.radius * c.radius * c.height\n\ndef volume_cylinder(radius: Union[float, int], height: Union[float, int]) -> float:\n    \"\"\"\n    Calculates the volume of a cylinder given its radius and height.\n\n    Parameters:\n        radius (Union[float, int]): The radius of the cylinder. Must be a non-negative number.\n        height (Union[float, int]): The height of the cylinder. Must be a non-negative number.\n\n    Returns:\n        float: The computed volume of the cylinder. Returns 0.0 if radius or height is zero.\n\n    Raises:\n        TypeError: If radius or height is not a number (int or float), or if it is a boolean.\n                   Message format: \"{name} must be a number (int or float), got {value!r} (type {type(value).__name__})\"\n        ValueError: If radius or height is negative.\n                    Message format: \"{name} must be non-negative, got {value!r} (type {type(value).__name__})\"\n\n    Example:\n        >>> import math\n        >>> math.isclose(volume_cylinder(2, 3), math.pi * 2**2 * 3, rel_tol=1e-12, abs_tol=1e-12)\n        True\n    \"\"\"\n    validator = Validator()\n    calculator = VolumeCalculator()\n\n    validator.validate_numeric(radius, 'radius')\n    validator.validate_numeric(height, 'height')\n\n    # Convert to float early for consistency in subsequent checks and calculation\n    processed_radius = float(radius)\n    processed_height = float(height)\n\n    validator.validate_non_negative(processed_radius, 'radius')\n    validator.validate_non_negative(processed_height, 'height')\n\n    if processed_radius == 0.0 or processed_height == 0.0:\n        return 0.0\n\n    cylinder_data = Cylinder(processed_radius, processed_height)\n    return calculator.compute_volume(cylinder_data)"}
{"task_id": "Mbpp/280", "solution": "def sequential_search(array, element):\n    \"\"\"\n    Search `array` for `element` using sequential (linear) search and return (found, index).\n    Raises TypeError if `array` is not iterable.\n    \"\"\"\n    try:\n        iterator = enumerate(array)\n    except TypeError:\n        raise TypeError(\"sequential_search: 'array' must be an iterable/sequence\") from None\n\n    for i, item in iterator:\n        if item == element:\n            return (True, i)\n    return (False, -1)"}
{"task_id": "Mbpp/281", "solution": "def _try_set(items):\n    \"\"\"Attempt a set-based uniqueness check; may raise TypeError if elements are unhashable.\"\"\"\n    seen = set()\n    for item in items:\n        if item in seen:\n            return False\n        seen.add(item)\n    return True\n\ndef _try_sort_copy(items):\n    \"\"\"Attempt a sorting-based uniqueness check on a shallow copy; may raise TypeError if elements are unorderable.\"\"\"\n    copy = list(items)\n    copy.sort()\n    for i in range(len(copy) - 1):\n        if copy[i] == copy[i+1]:\n            return False\n    return True\n\ndef _naive_check(items):\n    \"\"\"Perform a naive O(n^2) pairwise uniqueness check; always works if elements are comparable with ==.\"\"\"\n    n = len(items)\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            if items[i] == items[j]:\n                return False\n    return True\n\ndef all_unique(items: list) -> bool:\n    \"\"\"\n    Checks if all elements in a list are unique.\n\n    Uses a set-based approach (O(n) avg time, O(n) space) for hashable elements.\n    Falls back to a sorting-based check on a copy (O(n log n) time, O(n) space) for unhashable but orderable elements.\n    Finally, falls back to a naive pairwise comparison (O(n^2) time, O(1) space) for all other cases.\n    The input list is not modified.\n    \"\"\"\n    if len(items) <= 1:\n        return True\n\n    try:\n        return _try_set(items)\n    except TypeError:\n        try:\n            return _try_sort_copy(items)\n        except TypeError:\n            return _naive_check(items)"}
