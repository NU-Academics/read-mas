{"task_id": "Mbpp/564", "solution": "class InputValidator:\n    \"\"\"Validates input array types and length.\"\"\"\n    def validate_types(self, arr, n):\n        if not isinstance(arr, list):\n            raise TypeError('arr must be a list of integers')\n        for x in arr:\n            if not isinstance(x, int):\n                raise TypeError('arr must contain only integers')\n\n    def validate_length(self, arr, n):\n        if len(arr) != n:\n            raise ValueError('n does not match length of arr')\n\nclass FrequencyMap:\n    \"\"\"Builds a frequency dictionary for elements in an array.\"\"\"\n    def __init__(self):\n        self.freq = {}\n\n    def build(self, arr: list[int]) -> None:\n        for x in arr:\n            self.freq[x] = self.freq.get(x, 0) + 1\n\nclass CountPairs:\n    \"\"\"Orchestrates validation, frequency mapping, and pair counting.\"\"\"\n    def __init__(self, arr: list[int], n: int):\n        self.arr = arr\n        self.n = n\n        self._validator = InputValidator()\n        self._freq_map = FrequencyMap()\n\n        self._validator.validate_types(self.arr, self.n)\n        self._validator.validate_length(self.arr, self.n)\n\n    def execute(self) -> int:\n        if self.n <= 1:\n            return 0\n\n        self._freq_map.build(self.arr)\n\n        total_pairs = self.n * (self.n - 1) // 2\n\n        equal_pairs = 0\n        for freq_val in self._freq_map.freq.values():\n            equal_pairs += freq_val * (freq_val - 1) // 2\n\n        unequal_pairs = total_pairs - equal_pairs\n        return unequal_pairs\n\ndef count_Pairs(arr: list[int], n: int) -> int:\n    \"\"\"\n    Counts the number of unordered pairs (i, j) with i < j and arr[i] != arr[j].\n    Raises TypeError or ValueError for invalid inputs; O(n) time, O(d) space.\n    \"\"\"\n    counter = CountPairs(arr, n)\n    return counter.execute()"}
{"task_id": "Mbpp/567", "solution": "def issort_list(lst: list) -> bool:\n    \"\"\"Checks if a list is sorted in non-decreasing order.\n\n    Raises TypeError if the input is not a list or if elements are non-comparable.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"lst must be a list\")\n\n    if len(lst) < 2:\n        return True\n\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i + 1]:\n            return False\n    return True"}
{"task_id": "Mbpp/566", "solution": "def sum_digits(n: int) -> int:\n    \"\"\"Compute the sum of decimal digits of a non-negative integer.\n\n    Parameters:\n        n (int): The non-negative integer.\n\n    Returns:\n        int: The sum of the decimal digits of n.\n\n    Raises:\n        TypeError: If n is not an integer.\n        ValueError: If n is negative.\n\n    Algorithm: Iterative arithmetic (divmod or // and %); no string conversion.\n    Complexity: Time O(d) where d is digit count, Space O(1).\n\n    Examples:\n        >>> sum_digits(345)\n        12\n        >>> assert sum_digits(345) == 12\n        >>> sum_digits(0)\n        0\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n == 0:\n        return 0\n\n    total = 0\n    while n > 0:\n        n, digit = divmod(n, 10)\n        total += digit\n    return total"}
{"task_id": "Mbpp/563", "solution": "import re\nimport codecs\nfrom typing import List\n\ndef extract_values(s: str, unescape: bool = True) -> List[str]:\n    \"\"\"\n    Extracts values between quotation marks from a string.\n    Supports single and double quotes, handles escaped quotes, and unescapes common sequences.\n    \"\"\"\n\n    # Helper function for input validation, as per ErrorHandler design\n    def _validate_input(text) -> None:\n        if not isinstance(text, str):\n            raise TypeError('input must be a str')\n\n    # Helper function for unescaping, as per QuoteExtractor._unescape design\n    def _unescape_content(content: str) -> str:\n        \"\"\"Unescapes common escape sequences; returns original content on error.\"\"\"\n        try:\n            return codecs.decode(content, 'unicode_escape')\n        except Exception:\n            return content\n\n    # Precompile regex pattern (local to function to adhere to \"def\" start output)\n    _COMBINED_PATTERN = re.compile(r\"(['\\\"])((?:\\\\.|(?!\\\\1).)*?)\\1\", re.DOTALL)\n\n    # Validate input type as per design context\n    _validate_input(s)\n\n    if not s:  # Return empty list for empty string or no matches\n        return []\n\n    results: List[str] = []\n    try:\n        for m in _COMBINED_PATTERN.finditer(s):\n            raw = m.group(2)  # Capture group 2 contains inner content without quotes\n            if unescape:\n                val = _unescape_content(raw)\n            else:\n                val = raw\n            results.append(val)\n        return results\n    except re.error as e:  # Handle regex errors as per design context\n        raise RuntimeError(f'regex error: {e}')"}
{"task_id": "Mbpp/568", "solution": "def empty_list(N: int) -> list[dict]:\n    \"\"\"\n    Creates a list of N empty dictionaries.\n    Each dictionary in the list is a distinct instance.\n    \"\"\"\n    return [dict() for _ in range(N)]"}
{"task_id": "Mbpp/572", "solution": "from typing import Any, Dict, List\n\ndef two_unique_nums(input_list: list) -> list:\n    \"\"\"Return a new list containing elements that appear exactly once in input_list.\n\n    Args:\n        input_list (list): The list to analyze. Must be a list instance.\n\n    Returns:\n        list: New list preserving original order of elements whose occurrence count == 1.\n\n    Raises:\n        TypeError: If input_list is not a list instance.\n    \"\"\"\n    _validate_input_list(input_list)\n    counts = _count_occurrences(input_list)\n\n    result: List[Any] = []\n    for item in input_list:\n        if counts[item] == 1:\n            result.append(item)\n\n    return result\n\ndef _validate_input_list(input_list: list) -> None:\n    \"\"\"Validate that input_list is a list instance; raise TypeError otherwise.\"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list instance.\")\n\ndef _count_occurrences(input_list: list) -> Dict[Any, int]:\n    \"\"\"Return a dict mapping value -> occurrence count built in a single traversal.\"\"\"\n    counts: Dict[Any, int] = {}\n    for item in input_list:\n        counts[item] = counts.get(item, 0) + 1\n    return counts"}
{"task_id": "Mbpp/569", "solution": "def sort_sublists(list_of_lists: list[list[str]]) -> list[list[str]]:\n    \"\"\"Sorts each sublist of strings in a list of lists alphabetically.\"\"\"\n    return [sorted(sublist) for sublist in list_of_lists]"}
{"task_id": "Mbpp/573", "solution": "from math import isnan\n\ndef unique_product(numbers: list[float]) -> float:\n    \"\"\"\n    Calculates the product of the unique numbers in a given list.\n    Handles NaN propagation, non-numeric validation, and float arithmetic.\n    \"\"\"\n    # Detect NaN presence first; if any NaN is found, the result is NaN.\n    for x in numbers:\n        if isinstance(x, float) and isnan(x):\n            return float('nan')\n\n    # Validate elements and build a set of unique numeric values.\n    unique_values = set()\n    for x in numbers:\n        if not isinstance(x, (int, float)):\n            raise TypeError(\"non-numeric item in numbers\")\n        unique_values.add(x)\n\n    # Compute the product of the unique values.\n    result = 1.0\n    for v in unique_values:\n        result *= float(v)\n    return result"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n):\n    \"\"\"\n    Computes the last digit of the factorial of a given number n.\n    Handles special cases for n=0 and n >= 10 for efficiency.\n    \"\"\"\n    if n == 0:\n        return 1\n    elif n >= 10:\n        return 0\n    else:  # For 1 <= n <= 9, compute iteratively modulo 10\n        last_digit = 1\n        for i in range(1, n + 1):\n            last_digit = (last_digit * i) % 10\n        return last_digit"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(a: list, b: list, c: list) -> list:\n    \"\"\"Interleaves three lists of the same length into a single flat list.\n    It validates inputs for type and length, raising exceptions if invalid.\n    \"\"\"\n\n    def _validate_inputs(a_in: list, b_in: list, c_in: list) -> None:\n        \"\"\"Helper to validate that inputs are lists and have equal length.\"\"\"\n        if not (isinstance(a_in, list) and isinstance(b_in, list) and isinstance(c_in, list)):\n            raise TypeError(\"inputs must be lists\")\n        if not (len(a_in) == len(b_in) == len(c_in)):\n            raise ValueError(\"input lists must have equal length\")\n\n    _validate_inputs(a, b, c)\n\n    n = len(a)\n    result = []\n    for i in range(n):\n        result.append(a[i])\n        result.append(b[i])\n        result.append(c[i])\n    return result"}
{"task_id": "Mbpp/576", "solution": "SLIDING_THRESHOLD = 64\n\ndef _is_sub_array_sliding(arr, sub_arr):\n    \"\"\"\n    Checks if sub_arr is a contiguous sublist of arr using the sliding window algorithm.\n    Assumes sub_arr is not empty and not longer than arr.\n    \"\"\"\n    n = len(arr)\n    m = len(sub_arr)\n    for i in range(n - m + 1):\n        match = True\n        for j in range(m):\n            if arr[i + j] != sub_arr[j]:\n                match = False\n                break\n        if match:\n            return True\n    return False\n\ndef _build_prefix(sub_arr):\n    \"\"\"\n    Builds the KMP prefix (LPS) array for the given sub_arr.\n    The prefix array stores the lengths of the longest proper prefixes of sub_arr[:i+1]\n    that are also suffixes of sub_arr[:i+1].\n    \"\"\"\n    m = len(sub_arr)\n    prefix = [0] * m\n    j = 0  # length of the previous longest prefix suffix\n    for i in range(1, m):\n        while j > 0 and sub_arr[i] != sub_arr[j]:\n            j = prefix[j - 1]\n        if sub_arr[i] == sub_arr[j]:\n            j += 1\n        prefix[i] = j\n    return prefix\n\ndef _is_sub_array_kmp(arr, sub_arr):\n    \"\"\"\n    Checks if sub_arr is a contiguous sublist of arr using the KMP algorithm.\n    Assumes sub_arr is not empty and not longer than arr.\n    \"\"\"\n    n = len(arr)\n    m = len(sub_arr)\n    prefix = _build_prefix(sub_arr)\n    j = 0  # index for sub_arr\n    for i in range(n):  # index for arr\n        while j > 0 and arr[i] != sub_arr[j]:\n            j = prefix[j - 1]\n        if arr[i] == sub_arr[j]:\n            j += 1\n        if j == m:\n            return True  # Found match\n    return False\n\ndef is_Sub_Array(arr, sub_arr, algorithm='auto'):\n    \"\"\"\n    Checks whether a list is a sublist of another.\n    This function supports 'sliding' window or KMP algorithms, with 'auto' selection.\n    \"\"\"\n    # 1. Non-None validation\n    if arr is None or sub_arr is None:\n        raise ValueError(\"arr and sub_arr must not be None\")\n\n    # 2. Type/sequence-like validation\n    try:\n        n = len(arr)\n        m = len(sub_arr)\n    except TypeError:\n        raise TypeError(\"arr and sub_arr must be sequence-like and support len()\")\n\n    # 3. Corner cases\n    if m == 0:\n        return True\n    if m > n:\n        return False\n\n    # 4. Validate algorithm param\n    if algorithm not in ('auto', 'sliding', 'kmp'):\n        raise TypeError(\"algorithm must be 'auto', 'sliding', or 'kmp'\")\n\n    # 5. Decide algorithm and delegate\n    if algorithm == 'sliding' or (algorithm == 'auto' and m < SLIDING_THRESHOLD):\n        return _is_sub_array_sliding(arr, sub_arr)\n    else:\n        return _is_sub_array_kmp(arr, sub_arr)"}
{"task_id": "Mbpp/579", "solution": "class Validator:\n    @staticmethod\n    def ensure_tuple(obj):\n        \"\"\"Ensures the given object is a tuple, raising TypeError otherwise.\"\"\"\n        if not isinstance(obj, tuple):\n            raise TypeError(\"Argument must be a tuple\")\n\nclass HashIndex:\n    @staticmethod\n    def build_index(iterable):\n        \"\"\"Builds a set from an iterable. Raises TypeError if elements are unhashable.\"\"\"\n        return set(iterable)\n\nclass EqualityScanner:\n    @staticmethod\n    def contains_by_eq(seq, elem):\n        \"\"\"Checks if an element exists in a sequence using equality (==) comparisons.\"\"\"\n        for item in seq:\n            if item == elem:\n                return True\n        return False\n\n    @staticmethod\n    def build_shared_by_eq(a, b):\n        \"\"\"Builds a list of unique elements present in both tuple a and tuple b using equality comparisons.\"\"\"\n        shared = []\n        for x_a in a:\n            if EqualityScanner.contains_by_eq(b, x_a) and not EqualityScanner.contains_by_eq(shared, x_a):\n                shared.append(x_a)\n        return shared\n\nclass ResultTuple:\n    @staticmethod\n    def from_list(lst):\n        \"\"\"Converts a list to an immutable tuple.\"\"\"\n        return tuple(lst)\n\ndef find_dissimilar(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Finds elements present in exactly one of the two input tuples, preserving order and uniqueness.\n    \"\"\"\n    Validator.ensure_tuple(a)\n    Validator.ensure_tuple(b)\n\n    if not a and not b:\n        return ()\n\n    result_list = []\n\n    try:\n        # Attempt hash-based fast path for hashable elements\n        set_a = HashIndex.build_index(a)\n        set_b = HashIndex.build_index(b)\n\n        shared = set_a & set_b\n        seen_out_hashable = set()\n\n        for x in a:\n            if x not in shared and x not in seen_out_hashable:\n                result_list.append(x)\n                seen_out_hashable.add(x)\n\n        for x in b:\n            if x not in shared and x not in seen_out_hashable:\n                result_list.append(x)\n                seen_out_hashable.add(x)\n\n    except TypeError:\n        # Fallback to equality-based path if any element is unhashable\n        shared_equivalents = EqualityScanner.build_shared_by_eq(a, b)\n        seen_out_equality = []\n        result_list = [] # Reset result_list for the fallback path\n\n        for x in a:\n            if not EqualityScanner.contains_by_eq(shared_equivalents, x) and \\\n               not EqualityScanner.contains_by_eq(seen_out_equality, x):\n                result_list.append(x)\n                seen_out_equality.append(x)\n\n        for x in b:\n            if not EqualityScanner.contains_by_eq(shared_equivalents, x) and \\\n               not EqualityScanner.contains_by_eq(seen_out_equality, x):\n                result_list.append(x)\n                seen_out_equality.append(x)\n\n    return ResultTuple.from_list(result_list)"}
{"task_id": "Mbpp/581", "solution": "def surface_Area(base_edge, height):\n    \"\"\"\n    Calculates the surface area of a square pyramid given its base edge and slant height.\n    The second parameter 'height' is interpreted as the slant height.\n    \"\"\"\n    tol = 1e-9\n\n    # Formula: SA = a^2 + 2 * a * h, where a = base_edge, h = slant height.\n    sa = base_edge * base_edge + 2 * base_edge * height\n\n    # Decide return type based on tolerance to an integer.\n    if abs(sa - round(sa)) <= tol:\n        return int(round(sa))\n    else:\n        return float(sa)"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"\n    Computes the nth Catalan number using the multiplicative formula C_n = comb(2n, n) // (n + 1).\n    Iterative multiplicative method avoids large intermediate factorials.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be >= 0\")\n\n    if n == 0:\n        return 1\n\n    result = 1\n    for k in range(1, n + 1):\n        result = result * (n + k) // k\n\n    return result // (n + 1)"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"Recursively extract even integers and non-empty processed nested tuples from a mixed tuple.\n\n    Parameters:\n    - input_tuple (tuple): The top-level tuple to process. Must be a tuple.\n\n    Returns:\n    - tuple: A tuple containing only even integers and non-empty nested tuples (processed similarly),\n             preserving the original order.\n\n    Raises:\n    - TypeError: If the top-level input is not a tuple (\"extract_even: top-level input must be a tuple\").\n\n    Notes:\n    - Non-int, non-tuple elements encountered inside the tuple are ignored.\n    - Empty nested tuples (after removing odd elements) are omitted to avoid producing meaningless empty artifacts.\n\n    Example:\n    >>> extract_even((4, 5, (7, 6, (2, 4)), 6, 8))\n    (4, (6, (2, 4)), 6, 8)\n    \"\"\"\n    def _process(node: tuple) -> list:\n        \"\"\"Recursive helper returning a list of retained elements for a given tuple node.\"\"\"\n        result = []\n        for elem in node:\n            if isinstance(elem, int):\n                if elem % 2 == 0:\n                    result.append(elem)\n            elif isinstance(elem, tuple):\n                child = _process(elem)\n                if child:  # append only non-empty processed child tuples\n                    result.append(tuple(child))\n            # ignore other element types\n        return result\n\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"extract_even: top-level input must be a tuple\")\n\n    retained_list = _process(input_tuple)\n    return tuple(retained_list)"}
