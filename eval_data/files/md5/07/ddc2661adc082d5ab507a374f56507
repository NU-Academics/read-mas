{"task_id": "Mbpp/594", "solution": "def diff_even_odd(values: list) -> int:\n    \"\"\"\n    Finds the difference between the first encountered even integer and the first encountered odd integer in a list.\n\n    The function scans the list from left to right, ignoring elements that are not integers or are booleans.\n    It records the earliest even integer as `first_even` and the earliest odd integer as `first_odd`.\n    As soon as both are found, it returns their difference (`first_even - first_odd`).\n\n    Args:\n        values: A list of elements to scan.\n\n    Returns:\n        The integer result of `first_even - first_odd`.\n\n    Raises:\n        TypeError: If `values` is not a list.\n        ValueError: If no even integer or no odd integer is found in the list.\n\n    Example:\n        assert diff_even_odd([1,3,5,7,4,1,6,8]) == 3\n    \"\"\"\n    if not isinstance(values, list):\n        raise TypeError(\"diff_even_odd expects a list\")\n\n    first_even = None\n    first_odd = None\n\n    for x in values:\n        # Skip elements that are not instances of int or that are booleans (e.g., True, False)\n        if not isinstance(x, int) or isinstance(x, bool):\n            continue\n\n        if x % 2 == 0 and first_even is None:\n            first_even = x\n        elif x % 2 != 0 and first_odd is None:\n            first_odd = x\n\n        if first_even is not None and first_odd is not None:\n            return first_even - first_odd\n\n    if first_even is None:\n        raise ValueError(\"No even integer found in values\")\n    if first_odd is None:\n        raise ValueError(\"No odd integer found in values\")"}
{"task_id": "Mbpp/606", "solution": "import math\n\ndef _validate_input(obj) -> None:\n    \"\"\"\n    Validates that the input is a numeric type (int or float).\n    Raises TypeError if the input is not an instance of int or float.\n    \"\"\"\n    if not isinstance(obj, (int, float)):\n        raise TypeError(\"Input must be a numeric type (int or float).\")\n\ndef _compute_radians(degrees: float) -> float:\n    \"\"\"\n    Converts degrees to radians using the standard conversion formula.\n    It calculates radians as degrees * math.pi / 180.\n    \"\"\"\n    return degrees * math.pi / 180\n\ndef radian_degree(degrees: float) -> float:\n    \"\"\"\n    Converts an angle from degrees to radians.\n\n    This function accepts an angle in degrees and converts it to radians\n    using the formula: radians = degrees * math.pi / 180.\n    It handles special floating-point values (NaN, infinity) according to IEEE-754 semantics.\n\n    Examples:\n    >>> import math\n    >>> radian_degree(180)\n    3.141592653589793\n    >>> radian_degree(90)\n    1.5707963267948966\n\n    Edge cases:\n    - Raises TypeError for non-numeric inputs (e.g., string, list, None).\n    - radian_degree(math.nan) returns math.nan.\n    - radian_degree(math.inf) returns math.inf; radian_degree(-math.inf) returns -math.inf.\n    - Zero (0) and negative degrees (e.g., -180) convert correctly.\n    \"\"\"\n    _validate_input(degrees)\n    return _compute_radians(degrees)"}
{"task_id": "Mbpp/607", "solution": "import re\n\ndef find_literals(pattern, text):\n    \"\"\"\n    Searches a string for a regex pattern, returning the first match as a 3-tuple.\n    Returns (None, -1, -1) if no match is found.\n    \"\"\"\n    if pattern == \"\":\n        return (\"\", 0, 0)\n\n    match = re.search(pattern, text)\n    if match:\n        return (match.group(0), match.start(), match.end())\n    else:\n        return (None, -1, -1)"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(lst, k):\n    \"\"\"Returns a new list with the k'th element (1-based) removed.\n    This function assumes valid inputs and does not mutate the original list.\n    \"\"\"\n    i = k - 1\n    return lst[:i] + lst[i+1:]"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number using the Bell triangle (Aitken's array) algorithm.\n    This implementation uses a rolling-row optimization for O(n) auxiliary memory.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n == 0:\n        return 1\n\n    # Initialize the first row of the Bell triangle (corresponding to Bell(0))\n    previous_row = [1]\n\n    # Build rows from 1 up to n\n    for row_index in range(1, n + 1):\n        # Create a new row of size row_index + 1\n        new_row = [0] * (row_index + 1)\n\n        # The first element of the new row is the last element of the previous row\n        new_row[0] = previous_row[-1]\n\n        # Fill the rest of the new row\n        for j in range(1, row_index + 1):\n            new_row[j] = new_row[j - 1] + previous_row[j - 1]\n\n        # The new_row becomes the previous_row for the next iteration\n        previous_row = new_row\n\n    # After the loop, previous_row contains the nth row of the Bell triangle.\n    # The first element of this row is the nth Bell number.\n    return previous_row[0]"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix, n):\n    \"\"\"\n    Compute the maximum value found in the n-th column (0-based) across the rows of matrix.\n\n    Parameters:\n        matrix: sequence of indexable rows (each row must support __len__ and __getitem__)\n        n: int (column index, 0-based)\n\n    Returns:\n        The maximum element found at index n across all rows. The return type depends on the element types;\n        elements in column n must be comparable using the '>' operator.\n\n    Raises:\n        ValueError: if matrix is empty (message: 'matrix is empty')\n        TypeError: if n is not an int (message: 'column index must be an integer')\n        IndexError: if n < 0 (message: 'column index out of range')\n        IndexError: if a row i is encountered with len(row) <= n (message: 'row {i} has no column {n}')\n        TypeError: may propagate if a row is not indexable or indexing fails\n\n    Complexity:\n        Time: O(R) where R is number of rows\n        Space: O(1) additional space\n    \"\"\"\n    if not matrix:\n        raise ValueError('matrix is empty')\n\n    if not isinstance(n, int):\n        raise TypeError('column index must be an integer')\n\n    if n < 0:\n        raise IndexError('column index out of range')\n\n    # Check bounds for the first row before initializing current_max.\n    if len(matrix[0]) <= n:\n        raise IndexError(f'row 0 has no column {n}')\n\n    current_max = matrix[0][n]\n\n    for i in range(1, len(matrix)):\n        row = matrix[i]\n        # Check bounds for subsequent rows.\n        if len(row) <= n:\n            raise IndexError(f'row {i} has no column {n}')\n\n        if row[n] > current_max:\n            current_max = row[n]\n\n    return current_max"}
{"task_id": "Mbpp/612", "solution": "class PairCollection:\n    \"\"\"Helper class to encapsulate validation logic for lists of pairs.\"\"\"\n    def __init__(self, pairs):\n        self._pairs = pairs\n\n    def validate(self):\n        \"\"\"Validates that each item in _pairs is a list and contains exactly two elements.\"\"\"\n        for item in self._pairs:\n            if not isinstance(item, list):\n                raise TypeError('each item in pairs must be a list')\n            if len(item) != 2:\n                raise ValueError('each sublist must contain exactly two elements')\n        return None\n\ndef merge(pairs):\n    \"\"\"\n    Splits a list of two-element lists into two parallel lists: first elements and second elements.\n    Performs strict validation on input type and structure, returning newly constructed lists.\n    \"\"\"\n    if not isinstance(pairs, list):\n        raise TypeError('pairs must be a list of two-element lists')\n\n    if not pairs:\n        return [[], []]\n\n    pc = PairCollection(pairs)\n    pc.validate()\n\n    firsts_tuple, seconds_tuple = zip(*pairs)\n    return [list(firsts_tuple), list(seconds_tuple)]"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(tuple_of_tuples):\n    \"\"\"\n    Calculates the average value for each inner tuple in a tuple of tuples.\n    \"\"\"\n    if not isinstance(tuple_of_tuples, tuple):\n        raise TypeError(\"average_tuple expects a tuple of tuples\")\n\n    if len(tuple_of_tuples) == 0:\n        return []\n\n    averages_list = []\n    for i, inner in enumerate(tuple_of_tuples):\n        if not isinstance(inner, tuple):\n            raise TypeError(\"average_tuple expects a tuple of tuples\")\n        if len(inner) == 0:\n            raise ValueError(f\"average_tuple: empty inner tuple at index {i}\")\n        s = 0.0\n        count = 0\n        for j, e in enumerate(inner):\n            if not isinstance(e, (int, float)):\n                raise TypeError(f\"average_tuple: non-numeric element at inner index {i}, position {j}: {e}\")\n            s += float(e)\n            count += 1\n        averages_list.append(s / count)\n\n    return averages_list"}
{"task_id": "Mbpp/614", "solution": "import math\n\ndef cummulative_sum(tuple_list):\n    \"\"\"\n    Calculates the cumulative sum of all numeric values (int or float) within a list of tuples.\n    Non-numeric values are ignored.\n    \"\"\"\n    if not isinstance(tuple_list, list):\n        raise TypeError(\"tuple_list must be a list of tuples\")\n\n    for element in tuple_list:\n        if not isinstance(element, tuple):\n            raise TypeError(\"all elements of tuple_list must be tuples\")\n\n    saw_float = False\n    has_numeric = False\n    for current_tuple in tuple_list:\n        for item in current_tuple:\n            if type(item) is int:\n                has_numeric = True\n            elif type(item) is float:\n                has_numeric = True\n                saw_float = True\n\n    if not has_numeric:\n        return 0\n    elif saw_float:\n        numeric_generator = (\n            item\n            for current_tuple in tuple_list\n            for item in current_tuple\n            if type(item) is int or type(item) is float\n        )\n        return math.fsum(numeric_generator)\n    else:\n        total_int_sum = 0\n        for current_tuple in tuple_list:\n            for item in current_tuple:\n                if type(item) is int:\n                    total_int_sum += item\n        return total_int_sum"}
{"task_id": "Mbpp/619", "solution": "def move_num(input_str: str) -> str:\n    \"\"\"\n    Moves all digit characters to the end of the string, preserving relative order.\n    Non-digit characters also maintain their original relative order.\n    \"\"\"\n    if not isinstance(input_str, str):\n        raise TypeError(\"input_str must be of type str\")\n\n    non_digits_chars = []\n    digit_chars = []\n\n    for char in input_str:\n        if '0' <= char <= '9':\n            digit_chars.append(char)\n        else:\n            non_digits_chars.append(char)\n\n    return ''.join(non_digits_chars) + ''.join(digit_chars)"}
{"task_id": "Mbpp/618", "solution": "def div_list(numerators: list[int | float], denominators: list[int | float]) -> list[float]:\n    \"\"\"Divides two lists element-wise and returns a new list of floats.\n\n    Args:\n        numerators: List of numeric values (int or float) as numerators.\n        denominators: List of numeric values (int or float) as denominators.\n\n    Returns:\n        A list of floats where each element is numerators[i] / denominators[i].\n\n    Raises:\n        TypeError: If numerators or denominators is not a list or contains non-numeric elements.\n        ValueError: If the two lists have different lengths.\n        ZeroDivisionError: If any denominator is zero.\n    \"\"\"\n    # Input type checks\n    if not isinstance(numerators, list) or not isinstance(denominators, list):\n        raise TypeError(\"numerators and denominators must be lists\")\n\n    # Element type checks\n    for idx, val in enumerate(numerators):\n        if not isinstance(val, (int, float)):\n            raise TypeError(f\"numerators[{idx}] is not numeric: {val!r}\")\n    for idx, val in enumerate(denominators):\n        if not isinstance(val, (int, float)):\n            raise TypeError(f\"denominators[{idx}] is not numeric: {val!r}\")\n\n    # Length check\n    if len(numerators) != len(denominators):\n        raise ValueError(\n            f\"numerators and denominators must have the same length: {len(numerators)} != {len(denominators)}\"\n        )\n\n    # Zero denominator check\n    for idx, d in enumerate(denominators):\n        if d == 0:\n            raise ZeroDivisionError(f\"denominator at index {idx} is zero\")\n\n    # Perform division\n    result: list[float] = []\n    for i in range(len(numerators)):\n        result.append(numerators[i] / denominators[i])\n    return result"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise modulo on two tuples of the same length.\n    Validates inputs before computation, raising Type, Value, or ZeroDivision errors.\n    \"\"\"\n    # Validate types: both inputs must be tuples\n    if not isinstance(a, tuple) or not isinstance(b, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n\n    # Validate lengths: tuples must have the same length\n    if len(a) != len(b):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n    # Validate divisors: no element in b may be zero\n    for i in range(len(b)):\n        if b[i] == 0:\n            raise ZeroDivisionError(f\"Cannot perform modulo with zero as a divisor at index {i}.\")\n\n    # Validate operands: pre-check compatibility for the modulo operator (%)\n    for i in range(len(a)):\n        try:\n            # Attempt the operation to check compatibility; the result is discarded\n            _ = a[i] % b[i]\n        except TypeError as e:\n            raise TypeError(f\"Elements at index {i} are incompatible for modulo: type {type(a[i]).__name__} and type {type(b[i]).__name__}\") from e\n        except Exception as e:\n            # Catch any other unexpected error during the compatibility test and re-raise as TypeError\n            raise TypeError(f\"An unexpected incompatibility occurred with elements at index {i}: {a[i]}, {b[i]}. Original error: {e}\") from e\n\n    # Perform element-wise modulo and return the result as a new tuple\n    return tuple(a[i] % b[i] for i in range(len(a)))"}
{"task_id": "Mbpp/620", "solution": "from typing import List\n\ndef largest_subset(nums: List[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of a list of numbers where every pair is divisible.\n    Divisibility is checked using absolute values, guarding against division by zero.\n    \"\"\"\n    if not nums:\n        return 0\n\n    n = len(nums)\n    # Store absolute values of original numbers to preserve their identities by original index.\n    abs_values = [abs(x) for x in nums]\n\n    # Create a list of original indices, sorted by their corresponding absolute values.\n    # This ensures elements are processed in an order suitable for dynamic programming,\n    # and duplicates are treated as distinct elements via their unique original indices.\n    sorted_indices = sorted(range(n), key=lambda i: abs_values[i])\n\n    # dp[i] stores the length of the longest divisible subset ending with the element\n    # at sorted_indices[i] (i.e., the i-th element in the sorted sequence).\n    dp = [1] * n\n\n    for i in range(n):\n        current_original_idx = sorted_indices[i]\n        current_abs_val = abs_values[current_original_idx]\n\n        for j in range(i):\n            prev_original_idx = sorted_indices[j]\n            prev_abs_val = abs_values[prev_original_idx] # This is the candidate divisor\n\n            # Check if current_abs_val is divisible by prev_abs_val,\n            # ensuring prev_abs_val is not zero to prevent division-by-zero errors.\n            if prev_abs_val != 0 and current_abs_val % prev_abs_val == 0:\n                dp[i] = max(dp[i], dp[j] + 1)\n\n    # The maximum value in the dp array is the size of the largest divisible subset found.\n    return max(dp)"}
{"task_id": "Mbpp/623", "solution": "def nth_nums(nums: List[float], n: int) -> List[float]:\n    \"\"\"\n    Computes the n-th power of each number in a list.\n    Relies on Python's built-in exponentiation (**) for numeric and error semantics.\n    \"\"\"\n    return [x ** n for x in nums]"}
{"task_id": "Mbpp/624", "solution": "def is_upper(value: str) -> str:\n    \"\"\"Converts the given string to its uppercase equivalent.\n\n    Note: The function name `is_upper` is a legacy name and returns an\n    uppercase string, not a boolean.\n\n    Args:\n        value (str): The string to convert to uppercase.\n\n    Returns:\n        str: A new string that is the uppercase version of the input `value`.\n\n    Raises:\n        TypeError: If `value` is not a string.\n\n    Examples:\n        >>> is_upper(\"person\")\n        \"PERSON\"\n        >>> is_upper(\"hello, world!\")\n        \"HELLO, WORLD!\"\n        >>> is_upper(\"stra\u00dfe\")\n        \"STRASSE\"\n        >>> assert is_upper('hello') == 'HELLO'\n    \"\"\"\n    if not isinstance(value, str):\n        raise TypeError(f\"is_upper: expected str, got {type(value).__name__}\")\n    return value.upper()"}
{"task_id": "Mbpp/622", "solution": "def get_median(arr1, arr2, n):\n    \"\"\"\n    Finds the median of two sorted lists of the same size using a divide-and-conquer approach.\n    This function expects arr1 and arr2 to be sorted and of length n and returns a float.\n    \"\"\"\n    # basic validation\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n    if not hasattr(arr1, \"__len__\") or not hasattr(arr2, \"__len__\"):\n        raise TypeError(\"arr1 and arr2 must be sequence types\")\n    if len(arr1) != n or len(arr2) != n:\n        raise ValueError(\"Lengths of arr1 and arr2 must both equal n\")\n\n    def median_two_sorted_arrays(a, a_start, a_end, b, b_start, b_end):\n        \"\"\"\n        Recursive helper to find the median of two sorted array slices.\n        Indices a_start, a_end, b_start, b_end are inclusive.\n        \"\"\"\n        lenA = a_end - a_start + 1\n        lenB = b_end - b_start + 1\n\n        # Base case for lists of length 1 each\n        if lenA == 1 and lenB == 1:\n            return float((a[a_start] + b[b_start]) / 2.0)\n\n        # Base case for lists of length 2 each\n        if lenA == 2 and lenB == 2:\n            # The median is the average of the maximum of the two smaller elements\n            # and the minimum of the two larger elements from the four combined.\n            max_left = max(a[a_start], b[b_start])\n            min_right = min(a[a_end], b[b_end])\n            return float((max_left + min_right) / 2.0)\n\n        # Calculate midpoints for the current slices\n        i = (a_start + a_end) // 2\n        j = (b_start + b_end) // 2\n        medA = a[i]\n        medB = b[j]\n\n        # If medians are equal, this is the median of the combined list\n        if medA == medB:\n            return float(medA)\n\n        # If medA < medB, discard first half of a and second half of b\n        if medA < medB:\n            # Move a_start to i (inclusive) and b_end to j (inclusive)\n            return median_two_sorted_arrays(a, i, a_end, b, b_start, j)\n        else:  # medA > medB\n            # Move a_end to i (inclusive) and b_start to j (inclusive)\n            return median_two_sorted_arrays(a, a_start, i, b, j, b_end)\n\n    return median_two_sorted_arrays(arr1, 0, n - 1, arr2, 0, n - 1)"}
