{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"\n    Computes the length of the longest palindromic subsequence of the given string.\n    Uses dynamic programming with O(n^2) time and space complexity.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a str\")\n\n    n = len(s)\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    # Helper class for the n x n DP table as per design.\n    class DPTable:\n        def __init__(self, size: int):\n            self.cells = [[0] * size for _ in range(size)]\n            self.n = size\n\n        def set(self, i: int, j: int, val: int) -> None:\n            self.cells[i][j] = val\n\n        def get(self, i: int, j: int) -> int:\n            return self.cells[i][j]\n\n    dp = DPTable(n)\n\n    # All single characters are palindromic subsequences of length 1.\n    for i in range(n):\n        dp.set(i, i, 1)\n\n    # Fill the DP table for substring lengths from 2 to n.\n    for current_len in range(2, n + 1):\n        for i in range(n - current_len + 1):\n            j = i + current_len - 1\n            if s[i] == s[j]:\n                # If characters match, add 2 to the LPS of the inner substring s[i+1...j-1].\n                # If the inner substring is empty (current_len == 2) or single char (current_len == 3),\n                # dp.get(i+1, j-1) would refer to an invalid range or a single character already covered.\n                # The condition i+1 <= j-1 correctly handles this.\n                if i + 1 <= j - 1:\n                    dp.set(i, j, 2 + dp.get(i + 1, j - 1))\n                else:\n                    # For length 2 (e.g., \"aa\") or 3 (e.g., \"aba\" where 'b' is the middle),\n                    # the inner substring is empty or a single character, so just 2.\n                    dp.set(i, j, 2)\n            else:\n                # If characters don't match, take the maximum of LPS excluding s[i] or excluding s[j].\n                dp.set(i, j, max(dp.get(i + 1, j), dp.get(i, j - 1)))\n\n    return dp.get(0, n - 1)"}
{"task_id": "Mbpp/251", "solution": "def insert_element(lst: list, element) -> list:\n    \"\"\"Inserts an element before each item in the input list, returning a new list.\n    This implementation creates a new list (O(N) time, O(N) space) without modifying the original.\"\"\"\n    if not lst:\n        return []\n\n    result = []\n    for item in lst:\n        result.append(element)\n        result.append(item)\n    return result"}
{"task_id": "Mbpp/245", "solution": "def _compute_inc_sums(arr):\n    \"\"\"\n    Computes the maximum sum of a strictly increasing subsequence ending at each index.\n    inc_sums[i] stores the max sum of an increasing subsequence ending with arr[i].\n    \"\"\"\n    n = len(arr)\n    inc_sums = [arr[i] for i in range(n)]\n\n    for i in range(n):\n        for j in range(i):\n            if arr[j] < arr[i]:  # Strict increase\n                candidate = inc_sums[j] + arr[i]\n                if candidate > inc_sums[i]:\n                    inc_sums[i] = candidate\n    return inc_sums\n\ndef _compute_dec_sums(arr):\n    \"\"\"\n    Computes the maximum sum of a strictly decreasing subsequence starting at each index.\n    dec_sums[i] stores the max sum of a decreasing subsequence starting with arr[i].\n    \"\"\"\n    n = len(arr)\n    dec_sums = [arr[i] for i in range(n)]\n\n    for i in range(n - 1, -1, -1):\n        for j in range(n - 1, i, -1):\n            if arr[j] < arr[i]:  # Strict decrease\n                candidate = dec_sums[j] + arr[i]\n                if candidate > dec_sums[i]:\n                    dec_sums[i] = candidate\n    return dec_sums\n\ndef max_sum(arr):\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence for the given array.\n    A sequence is bitonic if it is first strictly increasing and then strictly decreasing.\n    \"\"\"\n    if arr is None:\n        raise ValueError(\"arr must be a list/sequence; None provided.\")\n\n    n = len(arr)\n    if n == 0:\n        return 0\n\n    inc_sums = _compute_inc_sums(arr)\n    dec_sums = _compute_dec_sums(arr)\n\n    # A bitonic subsequence can be formed by combining an increasing subsequence\n    # ending at arr[i] and a decreasing subsequence starting at arr[i].\n    # arr[i] is counted twice, so subtract it once.\n    max_bitonic = arr[0] # Initialize with a valid sum, for example, the first element itself.\n    if n > 0: # Ensure there is at least one element to initialize with.\n        max_bitonic = inc_sums[0] + dec_sums[0] - arr[0]\n\n    for i in range(n):\n        bitonic_sum = inc_sums[i] + dec_sums[i] - arr[i]\n        if bitonic_sum > max_bitonic:\n            max_bitonic = bitonic_sum\n\n    return max_bitonic"}
{"task_id": "Mbpp/252", "solution": "import math\nfrom typing import Any\n\ndef convert(z: Any) -> tuple[float, float]:\n    \"\"\"\n    Converts `z` to polar coordinates (r, theta) using r = math.hypot(real, imag) and theta = math.atan2(imag, real).\n    It supports int, float, complex, and objects with numeric .real/.imag attributes, preserving signed zeros and propagating IEEE-754 special values.\n\n    Examples:\n        convert(1) == (1.0, 0.0)\n    \"\"\"\n    real: float\n    imag: float\n\n    if isinstance(z, (int, float)):\n        real = float(z)\n        imag = 0.0\n    elif isinstance(z, complex):\n        real = float(z.real)\n        imag = float(z.imag)\n    elif hasattr(z, \"real\") and hasattr(z, \"imag\"):\n        try:\n            real = float(z.real)\n            imag = float(z.imag)\n        except (TypeError, ValueError) as e:\n            raise TypeError(\n                f\"Cannot convert .real or .imag attributes to float: {z}\"\n            ) from e\n    else:\n        raise TypeError(\n            f\"Unsupported input type for polar conversion: {type(z)}\"\n        )\n\n    r = math.hypot(real, imag)\n    theta = math.atan2(imag, real)\n\n    return (r, theta)"}
