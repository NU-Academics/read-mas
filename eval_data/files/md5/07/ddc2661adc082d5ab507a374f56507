{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import Iterable, Any, List\n\ndef heap_queue_largest(numbers: Iterable[Any], n: int) -> List[Any]:\n    \"\"\"\n    Finds the n largest integers from a given list of numbers, returned in descending order.\n    Returns a new list; for non-sized iterables, input will be materialized as a list (consuming generators).\n    Raises TypeError if 'n' is not an int or if 'numbers' is not iterable.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError('n must be an int')\n    try:\n        # Try to get an iterator to validate iterability\n        iter(numbers)\n    except TypeError:\n        raise TypeError('numbers must be iterable')\n\n    if n <= 0:\n        return []\n\n    # Materialize to list to allow len() and multiple passes; this will consume generators.\n    sequence = list(numbers)\n    seq_len = len(sequence)\n\n    if n >= seq_len:\n        return sorted(sequence, reverse=True)\n    return heapq.nlargest(n, sequence)"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(a, b) -> bool:\n    \"\"\"Return True iff integers a and b differ at exactly one bit position.\"\"\"\n    xor_result = a ^ b\n    if xor_result == 0:\n        return False\n    # Check if xor_result is a power of two.\n    return (xor_result & (xor_result - 1)) == 0"}
{"task_id": "Mbpp/16", "solution": "import re\n\n_PATTERN = re.compile(r'^([a-z]+)_([a-z]+)$')\n\ndef _is_string(obj: object) -> bool:\n    \"\"\"Helper to check if an object is a string.\"\"\"\n    return isinstance(obj, str)\n\ndef text_lowercase_underscore(text: str) -> bool:\n    \"\"\"\n    Checks if the input string contains sequences of lowercase letters joined with an underscore.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not _is_string(text):\n        raise TypeError(\"text must be a str\")\n    return bool(_PATTERN.fullmatch(text))"}
{"task_id": "Mbpp/14", "solution": "import math\n\nclass ErrorHandler:\n    \"\"\"Handles raising specific types of errors.\"\"\"\n    def raise_type_error(self, msg: str) -> None:\n        \"\"\"Raises a TypeError with the given message.\"\"\"\n        raise TypeError(msg)\n\n    def raise_value_error(self, msg: str) -> None:\n        \"\"\"Raises a ValueError with the given message.\"\"\"\n        raise ValueError(msg)\n\nclass InputValidator:\n    \"\"\"Validates inputs for numeric type, finiteness, and non-negativity.\"\"\"\n    def __init__(self, error_handler: ErrorHandler):\n        self._error_handler = error_handler\n\n    def validate_numeric(self, value, name: str) -> None:\n        \"\"\"Validates if a value is an int or float.\"\"\"\n        if not isinstance(value, (int, float)):\n            self._error_handler.raise_type_error(\n                f\"Input '{name}' must be a numeric type (int or float), but got {type(value).__name__}.\"\n            )\n\n    def validate_finite(self, value, name: str) -> None:\n        \"\"\"Validates if a numeric value is finite and not NaN.\"\"\"\n        if math.isnan(value) or not math.isfinite(value):\n            self._error_handler.raise_value_error(\n                f\"Input '{name}' must be a finite number, but got {value}.\"\n            )\n\n    def validate_non_negative(self, value, name: str) -> None:\n        \"\"\"Validates if a numeric value is non-negative.\"\"\"\n        if value < 0:\n            self._error_handler.raise_value_error(\n                f\"Input '{name}' must be non-negative, but got {value}.\"\n            )\n\nclass TriangularPrism:\n    \"\"\"A data container for the validated dimensions of a triangular prism.\"\"\"\n    def __init__(self, base: float, height: float, length: float):\n        self.base = base\n        self.height = height\n        self.length = length\n\nclass VolumeCalculator:\n    \"\"\"Calculates the volume of a triangular prism.\"\"\"\n    def computeVolume(self, prism: TriangularPrism) -> float:\n        \"\"\"Computes the volume given a TriangularPrism object.\"\"\"\n        return 0.5 * prism.base * prism.height * prism.length\n\ndef find_Volume(base, height, length) -> float:\n    \"\"\"\n    Calculates the volume of a triangular prism.\n    Example: find_Volume(10, 8, 6) returns 240.0.\n    \"\"\"\n    error_handler = ErrorHandler()\n    validator = InputValidator(error_handler)\n    calculator = VolumeCalculator()\n\n    input_params = [\n        ('base', base),\n        ('height', height),\n        ('length', length)\n    ]\n\n    # Validation precedence 1: Type checking for all inputs\n    for name, value in input_params:\n        validator.validate_numeric(value, name)\n\n    # Validation precedence 2: Finiteness and NaN check for all inputs\n    for name, value in input_params:\n        validator.validate_finite(value, name)\n\n    # Validation precedence 3: Non-negativity check for all inputs\n    for name, value in input_params:\n        validator.validate_non_negative(value, name)\n\n    # Validation precedence 4: Zero fast-path\n    if base == 0 or height == 0 or length == 0:\n        return 0.0\n\n    # Validation precedence 5: Cast to float and compute\n    base_f = float(base)\n    height_f = float(height)\n    length_f = float(length)\n\n    prism = TriangularPrism(base_f, height_f, length_f)\n    volume = calculator.computeVolume(prism)\n\n    return volume"}
{"task_id": "Mbpp/17", "solution": "class Validator:\n    \"\"\"Utility class to validate square side length.\"\"\"\n    @staticmethod\n    def validate_side(side):\n        \"\"\"\n        Validates the side length for type and non-negativity.\n        Raises TypeError or ValueError on invalid input.\n        \"\"\"\n        if not isinstance(side, (int, float)):\n            raise TypeError(\"side must be int or float\")\n        if side < 0:\n            raise ValueError(\"side must be non-negative\")\n\nclass Square:\n    \"\"\"Represents a square with a given side and computes its perimeter.\"\"\"\n    def __init__(self, side):\n        \"\"\"Initializes a Square with the given side length.\"\"\"\n        self._side = side\n\n    def perimeter(self):\n        \"\"\"Calculates and returns the perimeter of the square.\"\"\"\n        return 4 * self._side\n\ndef square_perimeter(side):\n    \"\"\"\n    Returns the perimeter of a square given its side length.\n    Input `side` must be a non-negative int or float.\n    \"\"\"\n    Validator.validate_side(side)\n    s = Square(side)\n    return s.perimeter()"}
{"task_id": "Mbpp/19", "solution": "def test_duplicate(nums: list[int]) -> bool:\n    \"\"\"\n    Checks if a collection of integers contains any duplicate element.\n    Raises TypeError if the input collection or its elements are not of expected types.\n    \"\"\"\n    if not isinstance(nums, (list, tuple)):\n        raise TypeError(\"nums must be list or tuple\")\n\n    seen = set()\n    for x in nums:\n        if not isinstance(x, int):\n            raise TypeError(\"all elements must be int\")\n        if x in seen:\n            return True\n        seen.add(x)\n    return False"}
{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(s: str, dirty: str) -> str:\n    \"\"\"Removes characters from the first string which are present in the second string.\"\"\"\n    if s == \"\":\n        return \"\"\n    if dirty == \"\":\n        return s\n\n    dirty_set = set(dirty)\n    result_chars = []\n    for char_s in s:\n        if char_s not in dirty_set:\n            result_chars.append(char_s)\n\n    return ''.join(result_chars)"}
{"task_id": "Mbpp/12", "solution": "def sort_matrix(matrix):\n    \"\"\"\n    Sorts a matrix (list of lists) in ascending order based on the sum of its rows.\n    Uses stable sorting, preserving the original relative order for rows with identical sums.\n    \"\"\"\n\n    rows_with_sums = []\n    for i, row in enumerate(matrix):\n        row_sum = sum(row)\n        # Store (row_sum, original_index, actual_row) to enable stable sorting\n        rows_with_sums.append((row_sum, i, row))\n\n    # Sort primarily by row_sum, and secondarily by original_index for stable tie-breaking.\n    sorted_rows_with_sums = sorted(rows_with_sums, key=lambda x: (x[0], x[1]))\n\n    # Extract the original rows from the sorted list\n    sorted_matrix_result = [item[2] for item in sorted_rows_with_sums]\n\n    return sorted_matrix_result"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(n: int) -> bool:\n    \"\"\"\n    Checks if a given number is a Woodall number.\n\n    A Woodall number is an integer of the form k * 2**k - 1 for some integer k >= 1.\n    Time Complexity: O(k) iterations where k is the minimal k with k*2**k - 1 >= n (typically O(log n)).\n    Space Complexity: O(1) additional memory.\n\n    Examples:\n    is_woodall(1) -> True  (k=1: 1*2 - 1 = 1)\n    is_woodall(7) -> True  (k=2: 2*4 - 1 = 7)\n    is_woodall(23) -> True (k=3: 3*8 - 1 = 23)\n    is_woodall(2) -> False\n    is_woodall(0) -> False (non-positive numbers are not Woodall numbers)\n\n    Edge Cases:\n    Raises TypeError for non-integer inputs, including booleans.\n    \"\"\"\n    if not isinstance(n, int) or isinstance(n, bool):\n        raise TypeError(\"is_woodall expects an int (bool is rejected)\")\n\n    if n < 1:\n        return False\n\n    k = 1\n    pow2 = 2  # This is 2**k for the current k\n\n    while True:\n        candidate = k * pow2 - 1\n        if candidate == n:\n            return True\n        if candidate > n:\n            return False\n\n        k += 1\n        pow2 *= 2  # Efficiently calculate 2**(k) for the next iteration"}
{"task_id": "Mbpp/56", "solution": "def check(n):\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    Raises TypeError if n is not an integer.\n    \"\"\"\n    def validate_type(num_to_check):\n        \"\"\"Ensures the input is an integer, raising TypeError otherwise.\"\"\"\n        if not isinstance(num_to_check, int):\n            raise TypeError(\"n must be an int\")\n\n    def reverse(num_to_reverse):\n        \"\"\"\n        Computes the signed digit-reverse of a number using integer arithmetic.\n        Trailing zeros are dropped, and the sign is preserved.\n        \"\"\"\n        sign = -1 if num_to_reverse < 0 else 1\n        x = abs(num_to_reverse)\n        rev = 0\n        while x > 0:\n            rev = rev * 10 + (x % 10)\n            x //= 10\n        return sign * rev\n\n    validate_type(n)\n    rev = reverse(n)\n    return n == (2 * rev) - 1"}
