{"task_id": "Mbpp/282", "solution": "from typing import Sequence, Union\n\ndef _validate_sequences(a: object, b: object) -> None:\n    \"\"\"Helper to validate if inputs are list or tuple sequences.\"\"\"\n    if not isinstance(a, (list, tuple)) or not isinstance(b, (list, tuple)):\n        raise TypeError(\"Inputs 'a' and 'b' must be sequences (list or tuple).\")\n\ndef _validate_elements(seq: Sequence[object]) -> None:\n    \"\"\"Helper to validate if all sequence elements are int or float.\"\"\"\n    for element in seq:\n        if not isinstance(element, (int, float)):\n            raise TypeError(\"All elements in the sequences must be integers or floats.\")\n\ndef sub_list(a: Sequence[Union[int, float]], b: Sequence[Union[int, float]]) -> list[Union[int, float]]:\n    \"\"\"\n    Subtracts two lists element-wise, returning a new list with the results.\n\n    Parameters:\n    - a: The first input sequence of integers or floats.\n    - b: The second input sequence of integers or floats.\n\n    Returns:\n    - A new list containing the element-wise differences (a[i] - b[i]).\n\n    Raises:\n    - TypeError: If a or b is not a sequence (list/tuple), or any element is not int/float.\n    - ValueError: If the input sequences have different lengths.\n\n    Example:\n    >>> assert sub_list([1, 2, 3], [4, 5, 6]) == [-3, -3, -3]\n    \"\"\"\n    _validate_sequences(a, b)\n    _validate_elements(a)\n    _validate_elements(b)\n\n    if len(a) != len(b):\n        raise ValueError(\"Input sequences must have the same length.\")\n\n    return [a[i] - b[i] for i in range(len(a))]"}
{"task_id": "Mbpp/283", "solution": "def validate(n: int) -> bool:\n    \"\"\"\n    Checks if the frequency of each digit in the integer is less than or equal to the digit itself.\n    Uses arithmetic extraction to count digits and then validates their frequencies.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an int\")\n\n    m = abs(n)\n    counts = [0] * 10\n\n    if m == 0:\n        counts[0] += 1\n    else:\n        while m > 0:\n            digit = m % 10\n            counts[digit] += 1\n            m //= 10\n\n    for d in range(10):\n        if counts[d] > 0 and counts[d] > d:\n            return False\n\n    return True"}
{"task_id": "Mbpp/285", "solution": "def text_match_two_three(s):\n    \"\"\"\n    Checks if the string contains the 'a' character followed by two or three 'b' characters.\n    This function performs a single-pass linear scan to find \"abb\" or \"abbb\" patterns.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string\")\n\n    n = len(s)\n    for i in range(n):\n        if s[i] == 'a':\n            # Check for 'a' followed by three 'b's (\"abbb\")\n            if i + 3 < n and s[i+1] == 'b' and s[i+2] == 'b' and s[i+3] == 'b':\n                return True\n            # Check for 'a' followed by two 'b's (\"abb\")\n            if i + 2 < n and s[i+1] == 'b' and s[i+2] == 'b':\n                return True\n    return False"}
{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"Calculates the sum of squares of the first n even natural numbers using a closed-form formula.\n\n    Args:\n        n (int): Number of first even natural numbers (must be a non-negative int).\n\n    Returns:\n        int: Sum of squares of the first n even natural numbers.\n\n    Examples:\n        >>> square_Sum(0)\n        0\n        >>> square_Sum(1)\n        4\n        >>> square_Sum(2)\n        20\n        >>> square_Sum(3)\n        56\n        >>> square_Sum(5)\n        220\n    \"\"\"\n    # Validate type (explicitly reject bool which is a subclass of int)\n    if type(n) is not int:\n        raise TypeError(\"n must be an int\")\n    # Validate non-negativity\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    # Closed-form formula:\n    # Sum_{k=1..n} (2k)^2 = 4 * Sum_{k=1..n} k^2\n    # Sum_{k=1..n} k^2 = n*(n+1)*(2n+1)/6\n    return 4 * n * (n + 1) * (2 * n + 1) // 6"}
{"task_id": "Mbpp/290", "solution": "def max_length(list_of_lists):\n    \"\"\"Finds the list of maximum length in a list of lists.\n    Returns a tuple (max_len, max_list), where max_list is the first encountered longest sublist.\n    \"\"\"\n    def _validate_outer_type(arg):\n        \"\"\"Raises TypeError if the argument is not a list.\"\"\"\n        if not isinstance(arg, list):\n            raise TypeError(\"outer argument must be a list\")\n\n    _validate_outer_type(list_of_lists)\n\n    max_len = 0\n    max_list = []\n\n    for element in list_of_lists:\n        if isinstance(element, list):\n            current_len = len(element)\n            if current_len > max_len:\n                max_len = current_len\n                max_list = element\n\n    return (max_len, max_list)"}
{"task_id": "Mbpp/292", "solution": "def find(dividend, divisor):\n    \"\"\"Compute floor(dividend / divisor) as int.\n\n    Raises ZeroDivisionError if divisor is 0.\n    \"\"\"\n    import math\n    if divisor == 0:\n        raise ZeroDivisionError(\"division by zero\")\n    quotient = dividend / divisor\n    return int(math.floor(quotient))"}
{"task_id": "Mbpp/286", "solution": "def _kadane(arr, n, num_elements_to_consider):\n    \"\"\"\n    Finds the maximum contiguous subarray sum, handling all-negative arrays.\n    Iterates over elements of `arr` repeated conceptually `num_elements_to_consider` times.\n    \"\"\"\n    overall_max = arr[0 % n]\n    current_max = arr[0 % n]\n\n    for i in range(1, num_elements_to_consider):\n        val = arr[i % n]\n        current_max = max(val, current_max + val)\n        overall_max = max(overall_max, current_max)\n\n    return overall_max\n\ndef _compute_aggregates(arr, n):\n    \"\"\"\n    Computes total sum, maximum prefix sum, and maximum suffix sum of the array.\n    \"\"\"\n    total_sum = 0\n\n    max_prefix_sum = -float('inf')\n    current_prefix_sum = 0\n    for x in arr:\n        current_prefix_sum += x\n        max_prefix_sum = max(max_prefix_sum, current_prefix_sum)\n        total_sum += x\n\n    max_suffix_sum = -float('inf')\n    current_suffix_sum = 0\n    for i in range(n - 1, -1, -1):\n        current_suffix_sum += arr[i]\n        max_suffix_sum = max(max_suffix_sum, current_suffix_sum)\n\n    return total_sum, max_prefix_sum, max_suffix_sum\n\ndef max_sub_array_sum_repeated(arr, n, k):\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in an array formed by\n    repeating the given array `k` times.\n    \"\"\"\n    if k == 1:\n        return _kadane(arr, n, n)\n    else: # k >= 2\n        # Candidate A: Max subarray sum spanning up to two copies of the array.\n        candidate_A = _kadane(arr, n, 2 * n)\n\n        # Compute total sum, max prefix sum, and max suffix sum of the original array.\n        total_sum, max_prefix_sum, max_suffix_sum = _compute_aggregates(arr, n)\n\n        # Candidate B: Max subarray sum involving full middle copies if total_sum is positive.\n        candidate_B = -float('inf')\n        if total_sum > 0:\n            candidate_B = max_prefix_sum + (k - 2) * total_sum + max_suffix_sum\n\n        return max(candidate_A, candidate_B)"}
{"task_id": "Mbpp/293", "solution": "import math\n\ndef otherside_rightangle(a: float, b: float, hypotenuse_provided: bool = False) -> float:\n    \"\"\"Calculates the third side of a right-angled triangle given two sides.\n\n    If hypotenuse_provided is False (default), treats `a` and `b` as legs and returns the hypotenuse.\n    If hypotenuse_provided is True, treats the larger of `a` and `b` as the hypotenuse and returns the other leg.\n\n    Raises:\n        TypeError: if a or b cannot be converted to float\n        ValueError: if any side is negative or if hypotenuse <= leg when hypotenuse_provided is True\n    \"\"\"\n    # Type and value validation\n    try:\n        a_f = float(a)\n        b_f = float(b)\n    except (TypeError, ValueError):\n        raise TypeError(\"a and b must be numeric (int or float)\")\n\n    if a_f < 0 or b_f < 0:\n        raise ValueError(\"side lengths must be non-negative\")\n\n    if not hypotenuse_provided:\n        # Calculate hypotenuse given two legs\n        result = math.sqrt(a_f * a_f + b_f * b_f)\n    else:\n        # Calculate missing leg given hypotenuse and one leg\n        hyp = max(a_f, b_f)\n        leg = min(a_f, b_f)\n        if hyp <= leg:\n            raise ValueError(\"hypotenuse must be greater than leg for a valid right triangle\")\n        result = math.sqrt(hyp * hyp - leg * leg)\n\n    return float(result)"}
{"task_id": "Mbpp/294", "solution": "import math\n\n_SENTINEL = object()\n\ndef max_val(lst):\n    \"\"\"\n    Finds the maximum numeric value in a heterogeneous list, ignoring non-numeric\n    items, booleans, and NaNs, and treating infinities as valid comparands.\n    Raises TypeError if input is not a list, ValueError if no numeric values are found.\n    Example: assert max_val(['Python', 3, 2, 4, 5, 'version']) == 5\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"max_val expects a list\")\n\n    current_max = _SENTINEL\n\n    for element in lst:\n        if isinstance(element, bool):\n            continue\n\n        if isinstance(element, (int, float)):\n            if isinstance(element, float) and math.isnan(element):\n                continue\n\n            if current_max is _SENTINEL:\n                current_max = element\n            else:\n                if element > current_max:\n                    current_max = element\n\n    if current_max is _SENTINEL:\n        raise ValueError(\"No numeric values found in list\")\n\n    return current_max"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr) -> int:\n    \"\"\"Public API: delegates to InversionCounter.get_Inv_Count for inversion counting.\"\"\"\n    class InversionCounter:\n        \"\"\"Internal class to perform inversion counting using a modified merge sort.\"\"\"\n\n        def __init__(self):\n            self._arr_copy = None  # Internal shallow copy of caller's array\n            self._temp = None      # Auxiliary buffer for merging\n            self._n = 0            # Length of the array\n\n        def get_Inv_Count(self, arr_param) -> int:\n            \"\"\"Counts inversions in the given array.\"\"\"\n            self.validate_input(arr_param)\n            n = len(arr_param)\n            if n == 0 or n == 1:\n                return 0\n\n            self._arr_copy = list(arr_param)  # Shallow copy to preserve caller's arr\n            self._n = n\n            self._temp = self.allocate_aux_buffer(n) # May raise MemoryError\n\n            count = self.merge_sort_count(self._arr_copy, self._temp, 0, n - 1)\n            return int(count)\n\n        def validate_input(self, arr_param) -> None:\n            \"\"\"Validates that arr is not None.\"\"\"\n            if arr_param is None:\n                raise TypeError(\"arr must not be None\")\n\n        def allocate_aux_buffer(self, n) -> list:\n            \"\"\"Allocates an auxiliary buffer of size n.\"\"\"\n            return [None] * n  # Python's list allocation can raise MemoryError\n\n        def merge_sort_count(self, arr_copy_param, temp_param, left, right) -> int:\n            \"\"\"Recursively sorts and counts inversions in subarrays.\"\"\"\n            if left >= right:\n                return 0\n\n            mid = left + (right - left) // 2\n            count = 0\n            count += self.merge_sort_count(arr_copy_param, temp_param, left, mid)\n            count += self.merge_sort_count(arr_copy_param, temp_param, mid + 1, right)\n            count += self.merge_count(arr_copy_param, temp_param, left, mid, right)\n            return count\n\n        def merge_count(self, arr_copy_param, temp_param, left, mid, right) -> int:\n            \"\"\"Merges two sorted subarrays and counts cross inversions.\"\"\"\n            i = left\n            j = mid + 1\n            k = left\n            inv_count = 0\n\n            while i <= mid and j <= right:\n                try:\n                    # Elements arr_copy_param[i] and arr_copy_param[j] are being compared.\n                    if arr_copy_param[i] <= arr_copy_param[j]: # 'equal elements not inversions'\n                        temp_param[k] = arr_copy_param[i]\n                        i += 1\n                    else:\n                        # arr_copy_param[i] > arr_copy_param[j] means arr_copy_param[i] and all elements\n                        # from arr_copy_param[i] to arr_copy_param[mid] form inversions with arr_copy_param[j].\n                        temp_param[k] = arr_copy_param[j]\n                        inv_count += (mid - i + 1)\n                        j += 1\n                except TypeError:\n                    # Comparison failures should propagate as TypeError.\n                    raise\n                k += 1\n\n            # Copy remaining elements from the left subarray, if any\n            while i <= mid:\n                temp_param[k] = arr_copy_param[i]\n                i += 1\n                k += 1\n\n            # Copy remaining elements from the right subarray, if any\n            while j <= right:\n                temp_param[k] = arr_copy_param[j]\n                j += 1\n                k += 1\n\n            # Copy the merged elements back to the original arr_copy_param for this segment\n            for idx in range(left, right + 1):\n                arr_copy_param[idx] = temp_param[idx]\n\n            return inv_count\n\n    counter = InversionCounter()\n    return counter.get_Inv_Count(arr)"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(lst):\n    \"\"\"\n    Recursively flattens a nested list into a single-level list.\n    Non-list elements are treated as atomic.\n    \"\"\"\n    result = []\n    for element in lst:\n        if isinstance(element, list):\n            result.extend(flatten_list(element))\n        else:\n            result.append(element)\n    return result"}
{"task_id": "Mbpp/301", "solution": "from typing import Any, Set\nfrom collections.abc import Mapping\n\ndef dict_depth(obj: Mapping[Any, Any]) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of a dictionary-like Mapping.\n    An empty mapping counts as depth 1.\n\n    Raises:\n        TypeError: if the top-level input is not a Mapping.\n        ValueError: if a cycle is detected in mappings by identity.\n    \"\"\"\n    if not isinstance(obj, Mapping):\n        raise TypeError(\"Top-level input must be a Mapping\")\n\n    def _depth(m: Mapping[Any, Any], visited: Set[int]) -> int:\n        \"\"\"Helper to recursively calculate depth and detect cycles.\"\"\"\n        if id(m) in visited:\n            raise ValueError(\"Cycle detected in mapping\")\n\n        visited.add(id(m))\n        max_child_depth = 0\n        for value in m.values():\n            if isinstance(value, Mapping):\n                current_child_depth = _depth(value, visited)\n                if current_child_depth > max_child_depth:\n                    max_child_depth = current_child_depth\n        visited.remove(id(m))\n\n        return 1 + max_child_depth\n\n    return _depth(obj, set())"}
{"task_id": "Mbpp/300", "solution": "def count_binary_seq(n: int) -> int:\n    \"\"\"\n    Count binary sequences of length 2n where the sum of the first n bits\n    equals the sum of the last n bits.\n\n    This count equals binomial(2n, n).\n\n    Raises:\n        TypeError: if n is not an integer.\n        ValueError: if n is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    if n == 0:\n        return 1\n\n    # Compute C(2n, n) using an iterative multiplicative formula to avoid large factorials.\n    result = 1\n    for k in range(1, n + 1):\n        result = result * (n + k) // k\n    return result"}
{"task_id": "Mbpp/299", "solution": "import collections\nimport dataclasses\nfrom typing import List, Tuple, Union, Optional, Dict\n\ndef max_aggregate(records: List[Tuple[str, Union[int, float]]]) -> Tuple[str, Union[int, float]]:\n    \"\"\"\n    Calculates the maximum aggregate from a list of (name, value) tuples.\n\n    Aggregates numeric values by name, identifies the name with the highest total,\n    and returns (name, total). Ties are broken by lexicographically smallest name.\n    The total's type is int if all contributing values for that name were ints,\n    otherwise it's float.\n\n    Args:\n        records: A list of 2-element tuples, where each tuple is (name: str, value: int|float).\n\n    Returns:\n        A tuple (name: str, total: int|float) representing the name with the maximum\n        aggregate total and that total.\n\n    Raises:\n        ValueError: If the input 'records' list is empty.\n        TypeError: If any record is malformed (not a 2-tuple, name not str, or value not int|float).\n    \"\"\"\n\n    # Helper classes for structured aggregation as per design.\n    # Defined inside the function to strictly adhere to \"output starting with `def` line\".\n\n    @dataclasses.dataclass\n    class Result:\n        name: str\n        total: Union[int, float]\n\n    class AggregateEntry:\n        __slots__ = ('name', 'total', 'has_float')\n\n        def __init__(self, name: str):\n            self.name = name\n            self.total: Union[int, float] = 0\n            self.has_float: bool = False\n\n        def add(self, value: Union[int, float]):\n            \"\"\"Adds a value to the total, promoting to float if necessary.\"\"\"\n            if isinstance(value, float) or self.has_float:\n                self.total = float(self.total) + float(value)\n                self.has_float = True\n            else:\n                self.total += value\n\n    class Aggregator:\n        __slots__ = ('aggregates',)\n\n        def __init__(self):\n            self.aggregates: Dict[str, AggregateEntry] = {}\n\n        def aggregate(self, records: List[Tuple[str, Union[int, float]]]):\n            \"\"\"Validates records and populates aggregates.\"\"\"\n            if not records:\n                raise ValueError(\"Input 'records' list cannot be empty.\")\n\n            for record in records:\n                if not isinstance(record, tuple) or len(record) != 2:\n                    raise TypeError(f\"Each record must be a 2-element tuple, but got: {record!r}\")\n\n                name, value = record\n\n                if not isinstance(name, str):\n                    raise TypeError(f\"Name must be a string, but got: {name!r} in record {record!r}\")\n\n                if not isinstance(value, (int, float)):\n                    raise TypeError(f\"Value must be an int or float, but got: {value!r} in record {record!r}\")\n\n                if name not in self.aggregates:\n                    self.aggregates[name] = AggregateEntry(name)\n\n                self.aggregates[name].add(value)\n\n        def select_max(self) -> Result:\n            \"\"\"Selects the name with the maximum aggregate total, with lexicographic tie-breaking.\"\"\"\n            if not self.aggregates:\n                # This should only be reachable if 'records' was empty (caught by ValueError)\n                # or all records were invalid (caught by TypeError), which means this is an\n                # unexpected internal state if previous checks were exhaustive.\n                raise RuntimeError(\"Aggregator.select_max called with no aggregated data.\")\n\n            # Initialize with the first entry found to avoid None/float('-inf') issues.\n            agg_iter = iter(self.aggregates.values())\n            first_entry = next(agg_iter)\n            best_name = first_entry.name\n            best_total = first_entry.total\n\n            # Iterate over the rest of the entries\n            for entry in agg_iter:\n                if entry.total > best_total:\n                    best_total = entry.total\n                    best_name = entry.name\n                elif entry.total == best_total:\n                    # Tie-break lexicographically for equal totals\n                    if entry.name < best_name:\n                        best_name = entry.name\n\n            return Result(name=best_name, total=best_total)\n\n    # Main logic of max_aggregate function\n    aggregator = Aggregator()\n    aggregator.aggregate(records)\n    result = aggregator.select_max()\n\n    return (result.name, result.total)"}
{"task_id": "Mbpp/305", "solution": "from dataclasses import dataclass\n\n# Authoritative set of punctuation characters to be stripped.\nPUNCTUATION_CHARS = \".,;:!?\\\"'()[]{}<>/\\\\-\"\n\n@dataclass\nclass Token:\n    \"\"\"\n    Represents a token with its raw and cleaned string values.\n    Provides a method to check if the cleaned token starts with 'p' or 'P'.\n    \"\"\"\n    raw: str\n    cleaned: str\n\n    def starts_with_p(self) -> bool:\n        \"\"\"Checks if the cleaned token starts with 'p' or 'P' (case-insensitive).\"\"\"\n        return bool(self.cleaned and self.cleaned[0].lower() == 'p')\n\nclass Tokenizer:\n    \"\"\"\n    A utility class to tokenize text based on whitespace.\n    \"\"\"\n    def tokenize(self, text: str) -> list[str]:\n        \"\"\"Splits text into tokens using default whitespace splitting semantics.\"\"\"\n        return text.split()\n\nclass TokenCleaner:\n    \"\"\"\n    A utility class to clean tokens by stripping specified leading/trailing punctuation.\n    \"\"\"\n    def __init__(self, punctuation_chars: str = PUNCTUATION_CHARS):\n        self.punctuation = punctuation_chars\n\n    def clean(self, token: str) -> str:\n        \"\"\"Strips leading and trailing punctuation characters from a token.\"\"\"\n        return token.strip(self.punctuation)\n\ndef _find_two_p_tokens_in_element(element: str, tokenizer: Tokenizer, cleaner: TokenCleaner) -> tuple:\n    \"\"\"\n    Internal helper to find the first two tokens starting with 'p' or 'P' in a single string element.\n    Returns a tuple of the two cleaned tokens or an empty tuple if less than two are found.\n    \"\"\"\n    p_tokens = []\n    raw_tokens = tokenizer.tokenize(element)\n    for raw_token in raw_tokens:\n        cleaned_token = cleaner.clean(raw_token)\n        token_obj = Token(raw=raw_token, cleaned=cleaned_token)\n        if token_obj.starts_with_p():\n            p_tokens.append(token_obj.cleaned)\n            if len(p_tokens) == 2:\n                return (p_tokens[0], p_tokens[1])\n    return ()\n\ndef start_withp(words: list) -> tuple:\n    \"\"\"\n    Returns two words from a list of words starting with 'p' or 'P'.\n    It iterates the input list, skips non-string elements, and returns the first two\n    'p'-starting tokens found within any single string element, preserving case.\n    \"\"\"\n    tokenizer = Tokenizer()\n    cleaner = TokenCleaner()\n    for element in words:\n        if isinstance(element, str):\n            result = _find_two_p_tokens_in_element(element, tokenizer, cleaner)\n            if result:\n                return result\n    return ()"}
{"task_id": "Mbpp/309", "solution": "def maximum(a, b):\n    \"\"\"Return the numerically larger of a and b.\n    Raises TypeError if either argument is not a numeric real value or is None.\n    \"\"\"\n    def _is_numeric(value) -> bool:\n        \"\"\"Checks if a value is an accepted real number and not None.\"\"\"\n        return value is not None and isinstance(value, (int, float))\n\n    if not _is_numeric(a) or not _is_numeric(b):\n        raise TypeError('Both arguments must be numeric and not None')\n\n    if a >= b:\n        return a\n    else:\n        return b"}
{"task_id": "Mbpp/310", "solution": "def string_to_tuple(s: str) -> tuple[str, ...]:\n    \"\"\"Converts a string into a tuple of characters, excluding all whitespace as defined by `str.isspace()`.\n    Non-whitespace characters are preserved in their original order.\n\n    Args:\n        s: The input string.\n\n    Returns:\n        A tuple of single-character strings for each non-whitespace character in s.\n\n    Raises:\n        TypeError: If s is not an instance of str.\n\n    Complexity:\n        Time: O(n), Space: O(n) where n = len(s).\n\n    Implementation plan (one line):\n        Return tuple(ch for ch in s if not ch.isspace()) after validating s is str.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"s must be an instance of str\")\n    return tuple(ch for ch in s if not ch.isspace())"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr, n, i, k):\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence ending with arr[k],\n    where predecessors are selected from arr[0] to arr[i].\n    \"\"\"\n    # Input validation\n    if not isinstance(arr, list):\n        raise ValueError(\"arr must be a list\")\n    if not isinstance(n, int) or n != len(arr):\n        raise ValueError(\"n must be an int equal to len(arr)\")\n    if not (isinstance(i, int) and isinstance(k, int)):\n        raise ValueError(\"i and k must be integers\")\n    if not (0 <= i < n and 0 <= k < n):\n        raise ValueError(\"i and k must be in range [0, n-1]\")\n    if not (k > i):\n        raise ValueError(\"k must be strictly greater than i\")\n\n    # DP initialization for indices 0..i\n    # dp[j] stores the maximum sum of an increasing subsequence ending at arr[j] (using elements up to j)\n    dp = [0] * (i + 1)\n    for j in range(0, i + 1):\n        dp[j] = arr[j]  # Base case: subsequence containing only arr[j]\n        for p in range(0, j):\n            if arr[p] < arr[j]:  # strictly increasing condition\n                candidate = dp[p] + arr[j]\n                if candidate > dp[j]:\n                    dp[j] = candidate\n\n    # Find the best prefix sum dp[j] such that arr[j] < arr[k]\n    best_prefix = None\n    for j in range(0, i + 1):\n        if arr[j] < arr[k]:\n            if best_prefix is None or dp[j] > best_prefix:\n                best_prefix = dp[j]\n\n    # Calculate the final result\n    if best_prefix is None:\n        # No valid predecessor found, the subsequence is just arr[k] itself\n        return int(arr[k])\n    else:\n        # Add arr[k] to the best found prefix sum\n        return int(best_prefix + arr[k])"}
{"task_id": "Mbpp/308", "solution": "def large_product(list1, list2, n):\n    \"\"\"\n    Finds the specified number of largest products from two lists, selecting one factor from each.\n    Returns a list of up to n largest products in non-increasing order.\n    \"\"\"\n    import heapq\n\n    def _large_product_bruteforce_impl(l1, l2, k):\n        \"\"\"Computes all pairwise products, sorts them, and returns the top k.\"\"\"\n        products = [x * y for x in l1 for y in l2]\n        products.sort(reverse=True)\n        return products[:k]\n\n    def _large_product_heap_impl(l1, l2, k):\n        \"\"\"Uses a max-heap to find the k largest products efficiently by traversing a sorted product matrix.\"\"\"\n        if not l1 or not l2:\n            return []\n\n        A = sorted(l1, reverse=True)\n        B = sorted(l2, reverse=True)\n\n        heap = []\n        visited = set()\n\n        # Push the largest product from (A[0], B[0]), using negated value for min-heap behavior.\n        heapq.heappush(heap, (-A[0] * B[0], 0, 0))\n        visited.add((0, 0))\n\n        results = []\n        while heap and len(results) < k:\n            neg_product, i, j = heapq.heappop(heap)\n            results.append(-neg_product)\n\n            # Explore the product with the next element from A.\n            if i + 1 < len(A) and (i + 1, j) not in visited:\n                heapq.heappush(heap, (-A[i + 1] * B[j], i + 1, j))\n                visited.add((i + 1, j))\n\n            # Explore the product with the next element from B.\n            if j + 1 < len(B) and (i, j + 1) not in visited:\n                heapq.heappush(heap, (-A[i] * B[j + 1], i, j + 1))\n                visited.add((i, j + 1))\n        return results\n\n    m = len(list1)\n    p = len(list2)\n\n    if m == 0 or p == 0:\n        return []\n\n    # Choose the brute-force algorithm if n is greater than or equal to total combinations.\n    if n >= m * p:\n        return _large_product_bruteforce_impl(list1, list2, n)\n    else:\n        return _large_product_heap_impl(list1, list2, n)"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    \"\"\"\n    Set the left-most unset bit in the minimal binary representation of n and return result.\n\n    Parameters:\n        n (int): non-negative integer input.\n\n    Returns:\n        int: integer result after setting left-most unset bit, or 1 if n == 0.\n\n    Raises:\n        ValueError: if n < 0.\n\n    Example:\n        assert set_left_most_unset_bit(10) == 14\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    if n == 0:\n        return 1\n    b = n.bit_length()\n    for i in range(b - 1, -1, -1):\n        if ((n >> i) & 1) == 0:\n            return n | (1 << i)\n    # If loop completes, all bits up to b-1 are set. Extend the width by setting bit at index b.\n    return n | (1 << b)"}
{"task_id": "Mbpp/312", "solution": "import math\n\nPI = math.pi\n\nclass Validators:\n    @staticmethod\n    def check_types(radius, height):\n        if not isinstance(radius, (int, float)) or not isinstance(height, (int, float)):\n            raise TypeError(\"radius and height must be int or float.\")\n\n    @staticmethod\n    def check_non_negative(radius, height):\n        if radius < 0 or height < 0:\n            raise ValueError(\"radius and height must be >= 0.\")\n\ndef volume_cone(radius, height):\n    \"\"\"Calculates the volume of a cone using the formula V = (1/3) * \u03c0 * radius^2 * height.\n\n    This function validates input types (must be int or float) and ensures they are non-negative.\n    It handles the edge case where radius or height is zero by returning 0.0.\n\n    Parameters:\n        radius (int | float): The radius of the cone's base. Must be non-negative.\n        height (int | float): The height of the cone. Must be non-negative.\n\n    Returns:\n        float: The computed volume of the cone.\n\n    Raises:\n        TypeError: If either radius or height is not an int or float.\n        ValueError: If either radius or height is negative.\n\n    Examples:\n        >>> volume_cone(1, 3)\n        3.141592653589793\n        >>> volume_cone(0, 5)\n        0.0\n        >>> volume_cone(2.5, 4)\n        26.17993877991494\n    \"\"\"\n    Validators.check_types(radius, height)\n    Validators.check_non_negative(radius, height)\n\n    if radius == 0 or height == 0:\n        return 0.0\n\n    volume = (1.0 / 3.0) * PI * (radius ** 2) * height\n    return float(volume)"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the highest power of 2 that is less than or equal to n.\n\n    Args:\n        n: An integer greater than or equal to 1.\n\n    Returns:\n        The largest power of two (int) <= n.\n\n    Raises:\n        TypeError: If n is not an int.\n        ValueError: If n < 1.\n\n    Examples:\n        >>> highest_Power_of_2(6)\n        4\n        >>> highest_Power_of_2(16)\n        16\n        >>> highest_Power_of_2(10)\n        8\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n    return 1 << (n.bit_length() - 1)"}
{"task_id": "Mbpp/390", "solution": "def add_string(lst, fmt):\n    \"\"\"\n    Applies a format string to each element in an iterable.\n\n    Args:\n        lst: An iterable of elements to format.\n        fmt: The format string to apply to each element.\n\n    Returns:\n        A new list containing the formatted strings.\n    \"\"\"\n    return [fmt.format(x) for x in lst]"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    \"\"\"\n    Computes the n'th Lucas number using an iterative approach.\n\n    The Lucas sequence is defined by L_n = L_{n-1} + L_{n-2} with L_0 = 2 and L_1 = 1.\n    This function has O(n) time complexity and O(1) auxiliary space complexity.\n\n    Args:\n        n: The non-negative integer index of the Lucas number to compute.\n\n    Returns:\n        The n'th Lucas number as an integer.\n\n    Raises:\n        TypeError: If n is not an integer.\n        ValueError: If n is a negative integer.\n\n    Examples:\n        >>> find_lucas(0)\n        2\n        >>> find_lucas(1)\n        1\n        >>> find_lucas(5)\n        11\n        >>> find_lucas(9)\n        76\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be >= 0\")\n\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n\n    # Initialize L0 and L1\n    prev2 = 2  # Represents L_{i-2}\n    prev1 = 1  # Represents L_{i-1}\n\n    # Iterate from L2 up to Ln\n    for _ in range(2, n + 1):\n        current = prev1 + prev2\n        prev2 = prev1\n        prev1 = current\n    return prev1"}
