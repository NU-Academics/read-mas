{"task_id": "Mbpp/68", "solution": "def is_Monotonic(sequence):\n    \"\"\"\n    Checks if a sequence is monotonic (non-decreasing or non-increasing).\n    Raises TypeError if adjacent elements are non-comparable.\n    \"\"\"\n    if len(sequence) <= 1:\n        return True\n\n    seen_increase = False\n    seen_decrease = False\n\n    for i in range(1, len(sequence)):\n        try:\n            if sequence[i] > sequence[i-1]:\n                seen_increase = True\n            elif sequence[i] < sequence[i-1]:\n                seen_decrease = True\n        except TypeError:\n            # Propagate TypeError for non-comparable elements.\n            raise\n\n        if seen_increase and seen_decrease:\n            return False\n\n    return True"}
{"task_id": "Mbpp/71", "solution": "from typing import List, Any\n\nclass InputList:\n    def __init__(self, elements: List[Any]):\n        self.elements = elements\n    def length(self) -> int:\n        return len(self.elements)\n    def copy(self) -> \"InputList\":\n        # Returns a new InputList instance with a shallow copy of the elements.\n        return InputList(self.elements.copy())\n\nclass SortedList:\n    def __init__(self, elements: List[Any]):\n        self.elements = elements\n    def length(self) -> int:\n        return len(self.elements)\n\nclass CombSortService:\n    _shrink_factor: float = 1.3\n\n    def _apply_gap(self, next_gap: int) -> int:\n        # Computes the next gap using the shrink factor, ensuring a minimum gap of 1.\n        gap = int(next_gap / self._shrink_factor)\n        return max(1, gap)\n\n    def _compare(self, a: Any, b: Any) -> bool:\n        # Compares two elements, raising TypeError if comparison is unsupported.\n        try:\n            return a < b\n        except TypeError as e:\n            raise TypeError(f\"Unsupported comparison between elements: {type(a)} and {type(b)}\") from e\n\n    def comb_sort(self, inputList: \"InputList\") -> \"SortedList\":\n        # Performs the comb sort algorithm on the provided InputList.\n        arr = inputList.elements\n        n = inputList.length()\n        gap = n\n        swapped = True\n\n        while gap > 1 or swapped:\n            gap = self._apply_gap(gap)\n            swapped = False\n\n            for i in range(n - gap):\n                if self._compare(arr[i + gap], arr[i]):\n                    arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                    swapped = True\n\n        return SortedList(arr)\n\ndef comb_sort(input_list: List[Any]) -> List[Any]:\n    # Sorts a list of elements using the comb sort algorithm.\n    # Returns a new sorted list without mutating the input.\n    working_input_list = InputList(input_list).copy()\n    service = CombSortService()\n    sorted_wrapper = service.comb_sort(working_input_list)\n    return sorted_wrapper.elements"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n):\n    \"\"\"\n    Computes the Bell number B_n using the Bell triangle method with two-row optimization.\n    B_n represents the number of partitions of a set with n elements.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    if n == 0:\n        return 1\n\n    # Initialize the first row of the Bell triangle (A_0,0)\n    prev_row = [1]\n\n    # Build rows from 1 up to n\n    for i in range(1, n + 1):\n        curr_row = []\n        # The first element of the current row (A_i,0) is the last element of the previous row (A_i-1,i-1)\n        curr_row.append(prev_row[-1])\n        # Fill the rest of the current row using the recurrence A_i,j = A_i-1,j-1 + A_i,j-1\n        for j in range(1, i + 1):\n            top_left = prev_row[j - 1]\n            curr_row.append(curr_row[j - 1] + top_left)\n        prev_row = curr_row\n\n    # After the loop, the first element of prev_row (A_n,0) is the Bell number B_n\n    return prev_row[0]"}
{"task_id": "Mbpp/70", "solution": "def get_equal(collection):\n    \"\"\"\n    Checks if all tuples in an iterable have the same length.\n    Returns True for empty or single-tuple collections.\n\n    Examples:\n    get_equal([]) -> True\n    get_equal([(1,2), (3,4)]) -> True\n    get_equal([(1,), (2,3)]) -> False\n    get_equal([(1,2)]) -> True\n    get_equal(None) -> raises TypeError\n    get_equal([(1,2), \"not a tuple\"]) -> raises TypeError\n\n    Exceptions from len() are propagated.\n    \"\"\"\n    iterator = iter(collection)\n\n    try:\n        first = next(iterator)\n    except StopIteration:\n        return True  # Empty collection\n\n    if not isinstance(first, tuple):\n        raise TypeError(\"All elements in the collection must be tuples.\")\n\n    reference_length = len(first)\n\n    for element in iterator:\n        if not isinstance(element, tuple):\n            raise TypeError(\"All elements in the collection must be tuples.\")\n        if len(element) != reference_length:\n            return False\n\n    return True"}
{"task_id": "Mbpp/72", "solution": "def dif_Square(n):\n    \"\"\"\n    Checks if a number can be represented as the difference of two squares.\n    Returns True iff there exist integers a, b such that a^2 - b^2 == n.\n    \"\"\"\n    def _validate_input(val):\n        if not isinstance(val, int):\n            raise TypeError(\"n must be an int\")\n\n    _validate_input(n)\n    return (n % 4) != 2"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(arr: list, patterns: list) -> bool:\n    \"\"\"\n    Checks if elements in arr follow the sequence defined by patterns, enforcing a bijection.\n    Uses two dictionaries to track forward and reverse mappings in a single pass.\n    \"\"\"\n    if len(arr) != len(patterns):\n        return False\n\n    forward_map = {}  # Maps elements from arr to patterns\n    reverse_map = {}  # Maps elements from patterns to arr\n\n    for arr_elem, pattern_elem in zip(arr, patterns):\n        # Check forward mapping consistency\n        if arr_elem in forward_map:\n            if forward_map[arr_elem] != pattern_elem:\n                return False\n        else:\n            forward_map[arr_elem] = pattern_elem\n\n        # Check reverse mapping consistency\n        if pattern_elem in reverse_map:\n            if reverse_map[pattern_elem] != arr_elem:\n                return False\n        else:\n            reverse_map[pattern_elem] = arr_elem\n\n    return True"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(text: Sequence, pattern: Pattern, cmp: Comparator = DefaultComparator(), diagnostics: bool = False) -> bool:\n    \"\"\"Checks if a list contains the given sublist contiguously using the provided comparator.\"\"\"\n    if text is None or pattern is None:\n        raise ValueError(\"text and pattern must not be None\")\n\n    n = len(text)\n    m = len(pattern)\n\n    # Empty pattern is always a sublist\n    if m == 0:\n        return True\n\n    # Pattern longer than text cannot match\n    if m > n:\n        return False\n\n    # Naive scanning using comparator.equals\n    for i in range(n - m + 1):\n        match = True\n        for j in range(m):\n            if not cmp.equals(text[i + j], pattern[j]):\n                match = False\n                break\n        if match:\n            return True\n\n    return False"}
{"task_id": "Mbpp/75", "solution": "def find_tuples(list_of_tuples, k):\n    \"\"\"\n    Finds tuples from a list where all elements are divisible by k.\n\n    Parameters:\n        list_of_tuples: list of tuple instances; each tuple contains integer elements.\n        k: int (non-zero).\n\n    Returns:\n        list of tuples (subset of input) where every element satisfies element % k == 0.\n\n    Complexity: time O(n * m), additional space proportional to output (worst-case O(n * m)).\n\n    Simple usage examples:\n    - find_tuples([(2,4,6),(3,6)], 2) -> [(2,4,6)]\n    - find_tuples([(0,0),(1,2)], 1) -> [(0,0),(1,2)]\n    - find_tuples([(-2,4), ()], 2) -> [(-2,4), ()]\n    - find_tuples([], 3) -> []\n    \"\"\"\n    result_list = []\n    for t in list_of_tuples:\n        # Empty tuples are treated as satisfying divisibility and are included.\n        if not t:\n            result_list.append(t)\n        else:\n            # Check if all elements in the tuple are divisible by k\n            if all(element % k == 0 for element in t):\n                result_list.append(t)\n    return result_list"}
