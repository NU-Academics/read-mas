{"task_id": "Mbpp/394", "solution": "def _set_based_check(tuple_input) -> bool:\n    \"\"\"Helper to check for distinct elements using a set for hashable elements.\"\"\"\n    seen = set()\n    for item in tuple_input:\n        if item in seen:\n            return False\n        seen.add(item)\n    return True\n\ndef _fallback_equality_check(tuple_input) -> bool:\n    \"\"\"Helper to check for distinct elements using pairwise equality for unhashable or mixed elements.\"\"\"\n    n = len(tuple_input)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if tuple_input[i] == tuple_input[j]:\n                return False\n    return True\n\ndef check_distinct(tuple_input) -> bool:\n    \"\"\"Checks if the given tuple contains no duplicate elements.\"\"\"\n    if not isinstance(tuple_input, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    if len(tuple_input) <= 1:\n        return True\n\n    all_hashable = True\n    for item in tuple_input:\n        try:\n            hash(item)\n        except TypeError:\n            all_hashable = False\n            break\n\n    if all_hashable:\n        return _set_based_check(tuple_input)\n    else:\n        return _fallback_equality_check(tuple_input)"}
{"task_id": "Mbpp/392", "solution": "def get_max_sum(n, memo=None):\n    \"\"\"\n    Calculates the maximum sum f(n) using memoized recursion based on the given equation.\n    f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n    \"\"\"\n    if memo is None:\n        memo = {}\n\n    if n in memo:\n        return memo[n]\n\n    if n <= 1:\n        memo[n] = n\n        return n\n\n    # Recursively calculate the sum of subproblems using floor division\n    sum_of_subproblems = (\n        get_max_sum(n // 2, memo) +\n        get_max_sum(n // 3, memo) +\n        get_max_sum(n // 4, memo) +\n        get_max_sum(n // 5, memo)\n    )\n\n    # Determine the maximum sum for n\n    result = max(sum_of_subproblems, n)\n\n    # Store the result in the memoization cache before returning\n    memo[n] = result\n    return result"}
{"task_id": "Mbpp/395", "solution": "from typing import Optional\nfrom collections import Counter\n\ndef first_non_repeating_character(input_str: str) -> Optional[str]:\n    \"\"\"\n    Finds the first non-repeated character in a given string.\n    Returns None if no non-repeated character is found or if the string is empty.\n    \"\"\"\n    if not isinstance(input_str, str):\n        raise TypeError(\"input_str must be of type str\")\n\n    char_counts = Counter(input_str)\n\n    for char in input_str:\n        if char_counts[char] == 1:\n            return char\n\n    return None"}
{"task_id": "Mbpp/398", "solution": "def sum_of_digits(numbers: list) -> list:\n    \"\"\"\n    Computes the sum of digits for each number in a given list,\n    handling negative numbers by using their absolute value.\n    \"\"\"\n    # Validate input\n    if not isinstance(numbers, list):\n        raise TypeError(\"numbers must be a list\")\n    for i, el in enumerate(numbers):\n        if not isinstance(el, int):\n            raise TypeError(f\"element at index {i} is not an int\")\n\n    result = []\n    for num in numbers:\n        current_sum = 0\n        absolute_num = abs(num)\n\n        if absolute_num == 0:\n            current_sum = 0\n        else:\n            while absolute_num > 0:\n                absolute_num, digit = divmod(absolute_num, 10)\n                current_sum += digit\n        result.append(current_sum)\n    return result"}
{"task_id": "Mbpp/397", "solution": "def median_numbers(a, b, c):\n    \"\"\"Return the median (middle) of three numeric values a, b, c.\n\n    Assumes inputs are comparable numeric types (e.g., int or float).\n    \"\"\"\n    values = (a, b, c)\n    sorted_vals = sorted(values)\n    return sorted_vals[1]"}
