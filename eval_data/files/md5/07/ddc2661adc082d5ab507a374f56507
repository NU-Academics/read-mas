{"task_id": "Mbpp/234", "solution": "from typing import Union\n\ndef _validate_side(side) -> None:\n    \"\"\"Validates the input side for type and non-negativity.\"\"\"\n    if not isinstance(side, (int, float)):\n        raise TypeError(\"side must be an int or float\")\n    if side < 0:\n        raise ValueError(\"side must be non-negative\")\n\ndef _compute_volume(side: Union[int, float]) -> Union[int, float]:\n    \"\"\"Computes the cube of the given side length.\"\"\"\n    return side ** 3\n\ndef volume_cube(side: Union[int, float]) -> Union[int, float]:\n    \"\"\"\n    Calculates the volume of a cube given its side length.\n    Raises TypeError if side is not int/float; ValueError if side < 0.\n    \"\"\"\n    _validate_side(side)\n    return _compute_volume(side)"}
{"task_id": "Mbpp/232", "solution": "import heapq\n\ndef larg_nnum(values, n):\n    \"\"\"\n    Returns a list containing the n largest unique items from the input list, sorted in descending order.\n\n    Parameters:\n    - values (list): list of comparable items\n    - n (int): non-negative integer, number of largest unique items to return\n\n    Returns:\n    - list: up to n largest unique items in descending order\n\n    Raises:\n    - TypeError: if values is not a list or n is not an int\n    - ValueError: if n < 0\n    \"\"\"\n    # Input validation\n    if not isinstance(values, list):\n        raise TypeError(\"values must be a list\")\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if not values or n == 0:\n        return []\n\n    # Deduplicate using a set when possible (handles hashable items).\n    # If items are unhashable, fall back to an order-preserving uniqueness pass.\n    try:\n        unique_items = list(set(values))\n    except TypeError:\n        seen = []\n        for item in values:\n            if item not in seen:\n                seen.append(item)\n        unique_items = seen\n\n    # Ensure items are mutually comparable by attempting a small operation\n    # (sorting the unique items). If they are not comparable, sorting will raise TypeError.\n    try:\n        # We don't need the result; this is just a comparability probe.\n        _ = sorted(unique_items[:min(len(unique_items), 5)])\n    except TypeError as exc:\n        raise TypeError(\"elements are not mutually comparable\") from exc\n\n    if n >= len(unique_items):\n        return sorted(unique_items, reverse=True)\n\n    # Use heapq.nlargest for efficiency; it returns results in descending order.\n    return heapq.nlargest(n, unique_items)"}
{"task_id": "Mbpp/233", "solution": "import math\n\ndef lateralsuface_cylinder(radius, height) -> float:\n    \"\"\"Calculates the lateral surface area of a cylinder. Uses the formula A = 2 * PI * radius * height.\"\"\"\n    if radius == 0 or height == 0:\n        return 0.0\n\n    area = 2.0 * math.pi * float(radius) * float(height)\n    return area"}
{"task_id": "Mbpp/237", "solution": "from typing import Any, List, Tuple, Dict\nfrom collections import Counter\n\ndef _canonicalize(t: Tuple[Any, ...]) -> Tuple[Any, ...]:\n    \"\"\"Returns a canonical representation of a tuple by sorting its elements.\"\"\"\n    return tuple(sorted(t))\n\ndef check_occurences(input_list: List[Tuple[Any, ...]]) -> Dict[Tuple[Any, ...], int]:\n    \"\"\"\n    Counts occurrences of canonical tuple forms in a list of tuples.\n    Tuples are canonicalized by sorting their elements; non-comparable elements will raise TypeError.\n    \"\"\"\n    canonical_counts = Counter()\n    for t in input_list:\n        canonical_form = _canonicalize(t)\n        canonical_counts[canonical_form] += 1\n    return dict(canonical_counts)"}
{"task_id": "Mbpp/235", "solution": "def even_bit_set_number(n):\n    \"\"\"Return int result with 1-indexed-even bits set (0-indexed odd indices).\n\n    Raises TypeError if n is not int; ValueError if n < 0.\n    \"\"\"\n    def _validate_input(val):\n        if not isinstance(val, int):\n            raise TypeError(\"n must be an int\")\n        if val < 0:\n            raise ValueError(\"n must be a non-negative int\")\n\n    def _compute_mask(bit_length):\n        if bit_length <= 1:\n            return 0\n        mask = 0\n        for i in range(1, bit_length, 2):\n            mask |= (1 << i)\n        return mask\n\n    _validate_input(n)\n\n    if n == 0:\n        return 0\n\n    bit_length = n.bit_length()\n    mask = _compute_mask(bit_length)\n    return n | mask"}
{"task_id": "Mbpp/238", "solution": "def number_of_substrings(s: str) -> int:\n    \"\"\"Counts the number of non-empty substrings of a given string using an O(1) arithmetic formula.\n    Substrings are counted by position, and len(s) is used for Unicode code-point count.\n\n    Examples:\n        >>> number_of_substrings(\"abc\")\n        6\n        >>> number_of_substrings(\"\")\n        0\n        >>> number_of_substrings(\"a\")\n        1\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a str\")\n\n    n = len(s)\n    # The formula n * (n + 1) // 2 calculates the sum of integers from 1 to n,\n    # representing the number of substrings by length.\n    return n * (n + 1) // 2"}
{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m, n):\n    # Validate inputs\n    if not (isinstance(m, int) and isinstance(n, int)):\n        raise ValueError(\"m and n must be integers\")\n    if m < 1 or n < 1:\n        raise ValueError(\"m and n must be >= 1\")\n\n    # Quick cases\n    if n == 1:\n        return m\n    # If the smallest possible sequence (1,2,4,...) exceeds m, no sequences exist.\n    if (1 << (n - 1)) > m:\n        return 0\n\n    # counts[x] = number of sequences of the current length starting with value x\n    counts = [0] * (m + 1)\n    for x in range(1, m + 1):\n        counts[x] = 1\n\n    # Iterate n-1 times to reach sequences of length n\n    for _ in range(2, n + 1):\n        # suffix sums: suff[x] = sum_{y=x..m} counts[y]\n        suff = [0] * (m + 2)\n        for x in range(m, 0, -1):\n            suff[x] = counts[x] + suff[x + 1]\n\n        new_counts = [0] * (m + 1)\n        for x in range(1, m + 1):\n            idx = 2 * x\n            if idx <= m:\n                new_counts[x] = suff[idx]\n        counts = new_counts\n\n    return sum(counts[1:])"}
{"task_id": "Mbpp/240", "solution": "def replace_list(list1, list2):\n    \"\"\"\n    Replaces the last element of the first list with the elements of the second list.\n    Returns a new list without modifying the input lists.\n    \"\"\"\n    if not isinstance(list1, list) or not isinstance(list2, list):\n        raise TypeError(\"Both arguments must be lists\")\n    if len(list1) == 0:\n        return list(list2)\n    if len(list2) == 0:\n        return list1[:-1]\n    return list1[:-1] + list2"}
