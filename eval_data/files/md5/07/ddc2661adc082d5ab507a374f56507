{"task_id": "Mbpp/104", "solution": "from typing import Iterable, List\n\ndef sort_sublists(data: Iterable[Iterable[str]]) -> List[List[str]]:\n    \"\"\"Sorts each sublist of strings lexicographically, returning a new list of lists.\n    Guarantees no mutation of inputs and raises TypeError for non-string or None elements.\n    \"\"\"\n    result: List[List[str]] = []\n    for sub_iterable in data:\n        current_sublist = list(sub_iterable)  # Create a new list from the sub-iterable\n\n        # Validate elements in the current sublist before sorting\n        for item in current_sublist:\n            if item is None or not isinstance(item, str):\n                raise TypeError(f\"All elements must be str and not None; found {type(item).__name__}\")\n\n        # Sort the current sublist and append the sorted version to the result\n        sorted_sublist = sorted(current_sublist)\n        result.append(sorted_sublist)\n\n    return result"}
{"task_id": "Mbpp/105", "solution": "from typing import Iterable, Any\nfrom collections.abc import Iterable as _IterableCheck\n\ndef count(values: Iterable[Any]) -> int:\n    \"\"\"Counts native bool True values in an iterable, ignoring truthy non-booleans.\n    Raises TypeError if the input is not iterable.\n    \"\"\"\n    if not isinstance(values, _IterableCheck):\n        raise TypeError(\"Input must be an iterable.\")\n\n    true_count = 0\n    for element in values:\n        if element is True:\n            true_count += 1\n    return true_count"}
{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int, method: str = 'auto') -> int:\n    \"\"\"Computes the Eulerian number a(n, m) using specified or auto-selected method.\"\"\"\n\n    # --- InputValidator.validate(n, m) ---\n    # Check types: n and m must be integers, explicitly rejecting booleans.\n    if type(n) is not int or type(m) is not int:\n        raise TypeError(\"n and m must be int\")\n    # Check ranges for valid Eulerian number inputs.\n    if n < 0:\n        raise ValueError(\"n must be >= 0\")\n    if n == 0 and m != 0:\n        raise ValueError(\"for n == 0, m must be 0\")\n    if n > 0 and (m < 0 or m >= n):\n        raise ValueError(\"for n > 0, require 0 <= m < n\")\n\n    # --- EulerianCalculator._choose_method(n, m, method) ---\n    chosen_method: str\n    if method == 'dp':\n        chosen_method = 'dp'\n    elif method == 'formula':\n        chosen_method = 'formula'\n    elif method == 'auto':\n        # Auto-selection heuristic: formula is preferred for large n with small m.\n        if m <= 64 and n >= 64:\n            chosen_method = 'formula'\n        else:\n            chosen_method = 'dp'\n    else:\n        raise ValueError(\"method must be 'dp', 'formula', or 'auto'\")\n\n    # --- Algorithm Dispatch ---\n    if chosen_method == 'dp':\n        # --- DPMethod.compute(n, m) ---\n        # Base case for the Eulerian triangle a(0,0) = 1.\n        if n == 0 and m == 0:\n            return 1\n\n        # Initialize the previous row for recurrence. 'prev' stores a(i-1, k) values.\n        # The base row (i=0) only has a(0,0)=1, and a(0,k)=0 for k>0.\n        prev = [0] * (m + 1)\n        prev[0] = 1\n\n        # Iterate from row i=1 up to n.\n        for i in range(1, n + 1):\n            # 'cur' stores a(i, k) values, computed up to column m.\n            cur_max_col = min(i - 1, m) # Eulerian numbers a(i,k) are non-zero for 0 <= k < i.\n            cur = [0] * (cur_max_col + 1)\n\n            # Apply the recurrence relation: a(i,j) = (i-j)*a(i-1,j-1) + (j+1)*a(i-1,j).\n            for j in range(len(cur)):\n                term1 = (i - j) * (prev[j-1] if j - 1 >= 0 else 0)\n                term2 = (j + 1) * (prev[j] if j < len(prev) else 0)\n                cur[j] = term1 + term2\n            prev = cur # Current row becomes the previous row for the next iteration.\n\n        return prev[m] # Return a(n, m) from the final computed row.\n\n    else: # chosen_method == 'formula'\n        # --- FormulaMethod.compute(n, m) ---\n        total = 0\n\n        # --- BinomialCalculator.comb(n, k) ---\n        # Define an inline helper for binomial coefficients.\n        _math_comb_func = None\n        try:\n            import math\n            _math_comb_func = math.comb\n        except (ImportError, AttributeError): # math.comb is available from Python 3.8\n            pass\n\n        def _comb(n_comb: int, k_comb: int) -> int:\n            \"\"\"Calculates C(n_comb, k_comb) using math.comb or an iterative fallback.\"\"\"\n            if k_comb < 0 or k_comb > n_comb:\n                return 0\n            if _math_comb_func:\n                return _math_comb_func(n_comb, k_comb)\n\n            # Iterative multiplicative fallback for C(n, k).\n            k_comb = min(k_comb, n_comb - k_comb) # Use symmetry C(n,k) = C(n, n-k) for efficiency.\n            res = 1\n            for i in range(k_comb):\n                res = res * (n_comb - i) // (i + 1)\n            return res\n\n        # Apply the inclusion-exclusion formula: a(n,m) = sum_{k=0}^{m+1} (-1)^k * C(n+1,k) * (m+1-k)^n.\n        for k in range(m + 2): # Loop from k=0 up to m+1.\n            c = _comb(n + 1, k)\n            power = pow(m + 1 - k, n) # Uses built-in fast integer exponentiation.\n            term = ((-1) ** k) * c * power\n            total += term\n\n        return total"}
{"task_id": "Mbpp/108", "solution": "def merge_sorted_list(list1, list2, list3):\n    \"\"\"\n    Merges three lists into a single sorted list without modifying the input lists.\n    The combined list is sorted in non-decreasing order.\n    \"\"\"\n    combined_list = list1 + list2 + list3\n    return sorted(combined_list)"}
{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(s, n):\n  \"\"\"\n  Calculates the number of odd-valued rotations among the first n left-rotations of a binary string s.\n  A rotation is odd if its least-significant bit is '1'.\n  \"\"\"\n  # Input validation is omitted as per instructions.\n\n  if n == 0:\n    return 0\n\n  L = len(s)\n  ones_in_s = 0\n  for ch in s:\n    if ch == '1':\n      ones_in_s += 1\n\n  q = n // L\n  r = n % L\n\n  ones_in_remainder = 0\n  if r > 0:\n    # Rotation 0's LSB is s[L-1]\n    if s[L - 1] == '1':\n      ones_in_remainder += 1\n    # Rotations 1 to r-1. LSB for rotation k is s[(k-1)%L].\n    # For k=1, LSB is s[0]. For k=r-1, LSB is s[r-2].\n    for i in range(0, r - 1):\n      if s[i] == '1':\n        ones_in_remainder += 1\n\n  total = q * ones_in_s + ones_in_remainder\n  return total"}
{"task_id": "Mbpp/113", "solution": "def check_integer(input_str: str) -> bool:\n    \"\"\"\n    Checks if a string represents an integer, allowing an optional leading sign and ASCII digits.\n    Handles trimming whitespace and non-string inputs (by allowing errors as per specific constraints).\n    \"\"\"\n    import re\n    INTEGER_REGEX = r'^[+-]?[0-9]+$'\n\n    # Explicitly omitting isinstance check as per \"DO NOT add isinstance() checks\" constraint,\n    # which implies non-string inputs might raise errors instead of returning False gracefully.\n    trimmed = input_str.strip()\n\n    if not trimmed:\n        return False\n\n    return re.fullmatch(INTEGER_REGEX, trimmed) is not None"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_lists):\n    try:\n        nested_lists_iter = iter(nested_lists)\n    except TypeError:\n        raise TypeError(\"nested_lists must be iterable\")\n\n    try:\n        first_inner = next(nested_lists_iter)\n    except StopIteration:\n        return set()\n\n    try:\n        running_set = set(first_inner)\n    except TypeError:\n        raise TypeError(\"All elements of nested_lists must be iterable\")\n\n    if not running_set:\n        return set()\n\n    for inner in nested_lists_iter:\n        try:\n            current_inner_set = set(inner)\n        except TypeError:\n            raise TypeError(\"All elements of nested_lists must be iterable\")\n\n        if not current_inner_set:\n            return set()\n\n        running_set &= current_inner_set\n\n        if not running_set:\n            return set()\n\n    return running_set"}
{"task_id": "Mbpp/118", "solution": "def string_to_list(input_string: str) -> list[str]:\n    \"\"\"Converts a string to a list of strings, splitting on the space character.\n    Preserves empty tokens for consecutive, leading, and trailing spaces.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"input_string must be a string\")\n\n    if input_string == \"\":\n        return [\"\"]\n\n    result: list[str] = []\n    current_word_chars: list[str] = []\n\n    for char in input_string:\n        if char == \" \":\n            result.append(\"\".join(current_word_chars))\n            current_word_chars = []\n        else:\n            current_word_chars.append(char)\n\n    result.append(\"\".join(current_word_chars))\n    return result"}
{"task_id": "Mbpp/116", "solution": "def tuple_to_int(input_tuple):\n    \"\"\"\n    Converts a tuple of positive integers into a single integer by concatenating their decimal representations.\n    Performs strict input validation for type, emptiness, and element validity.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n    if len(input_tuple) == 0:\n        raise ValueError(\"Tuple must not be empty.\")\n\n    def _count_digits(n):\n        \"\"\"Returns the number of base-10 digits for a positive integer n.\"\"\"\n        count = 0\n        if n == 0:  # Although design says elements are > 0, this is a robust helper.\n            return 1\n        temp_n = n\n        while temp_n > 0:\n            temp_n //= 10\n            count += 1\n        return count\n\n    result = 0\n    for element in input_tuple:\n        if isinstance(element, bool):\n            raise ValueError(\"Boolean values are not allowed; elements must be integers.\")\n        if not isinstance(element, int):\n            raise ValueError(\"Elements of the tuple must be integers.\")\n        if element <= 0:\n            raise ValueError(\"Elements of the tuple must be positive integers (> 0).\")\n\n        digits = _count_digits(element)\n        result = result * (10 ** digits) + element\n    return result"}
{"task_id": "Mbpp/119", "solution": "from typing import List\n\ndef search(nums: List[int]) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where all other elements appear exactly twice.\n    Assumes the input list is sorted and contains exactly one unique element.\n    \"\"\"\n    low = 0\n    high = len(nums) - 1\n\n    while low < high:\n        mid = (low + high) // 2\n\n        # Ensure 'mid' points to an even index to compare pairs consistently.\n        if mid % 2 == 1:\n            mid -= 1\n\n        # If nums[mid] == nums[mid + 1], the unique element is in the right half.\n        if nums[mid] == nums[mid + 1]:\n            low = mid + 2\n        else:\n            high = mid\n\n    return nums[low]"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(list_of_pairs):\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n\n    Args:\n        list_of_pairs (list|tuple): Iterable of 2-element iterables (list/tuple) containing numeric elements (int or float).\n\n    Returns:\n        int|float: The maximum absolute product among all pairs.\n\n    Raises:\n        TypeError: If top-level input is not a list/tuple, any item is not a list/tuple of length 2,\n                   or elements are not int/float.\n        ValueError: If the input collection is empty.\n    \"\"\"\n    if not isinstance(list_of_pairs, (list, tuple)):\n        raise TypeError(\"list_of_pairs must be a list or tuple\")\n\n    if len(list_of_pairs) == 0:\n        raise ValueError(\"list_of_pairs must be non-empty\")\n\n    running_max = None\n\n    for item in list_of_pairs:\n        if not isinstance(item, (list, tuple)) or len(item) != 2:\n            raise TypeError(\"each item must be a list or tuple of length 2\")\n\n        a, b = item[0], item[1]\n\n        if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n            raise TypeError(\"pair elements must be int or float\")\n\n        abs_product = abs(a * b)\n\n        if running_max is None or abs_product > running_max:\n            running_max = abs_product\n\n    return running_max"}
{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(n):\n    \"\"\"\n    Calculate the sum of all amicable numbers from 1 to n (inclusive).\n\n    Args:\n        n (int): Upper bound of the range (inclusive). Must be an integer.\n\n    Returns:\n        int: Sum of amicable numbers in 1..n. Returns 0 for n < 1.\n\n    Raises:\n        TypeError: If n is not an integer.\n\n    Complexity:\n        Time: O(n log n) for the sieve precomputation plus occasional O(sqrt(b)) for partners > n.\n        Space: O(n).\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 1:\n        return 0\n\n    def sum_proper_divisors_inline(num):\n        \"\"\"Return sum of proper divisors of num (excluding num). O(sqrt(num)).\"\"\"\n        if num == 1:\n            return 0\n        s = 1\n        r = int(num**0.5)\n        for i in range(2, r + 1):\n            if num % i == 0:\n                s += i\n                j = num // i\n                if j != i:\n                    s += j\n        return s\n\n    # Sieve-like precompute of sum of proper divisors for 1..n\n    sums = [0] * (n + 1)\n    for d in range(1, n // 2 + 1):\n        for m in range(d * 2, n + 1, d):\n            sums[m] += d\n\n    total_amicable_sum = 0\n    for k in range(1, n + 1):\n        b = sums[k]\n        if b == k:\n            continue  # exclude perfect numbers\n        if b <= n:\n            b_sum = sums[b]\n        else:\n            b_sum = sum_proper_divisors_inline(b)\n        if b_sum == k:\n            total_amicable_sum += k\n\n    return total_amicable_sum"}
{"task_id": "Mbpp/124", "solution": "import math\n\ndef angle_complex(*args) -> float:\n    \"\"\"Calculates the angle (argument) of a complex number in radians.\n    Handles single complex argument or two arguments (real, imag) where imag may be complex.\n    \"\"\"\n    real_part = 0.0\n    imag_part = 0.0\n\n    if len(args) == 1:\n        z = args[0]\n        if not isinstance(z, complex):\n            raise TypeError(\"Expected 1 complex or 2 args (real: int/float, imag: int/float/complex)\")\n        real_part = float(z.real)\n        imag_part = float(z.imag)\n    elif len(args) == 2:\n        real_arg = args[0]\n        imag_arg = args[1]\n\n        if not isinstance(real_arg, (int, float)):\n            raise TypeError(\"Expected 1 complex or 2 args (real: int/float, imag: int/float/complex)\")\n        real_part = float(real_arg)\n\n        if isinstance(imag_arg, complex):\n            imag_part = float(imag_arg.imag)\n        elif isinstance(imag_arg, (int, float)):\n            imag_part = float(imag_arg)\n        else:\n            raise TypeError(\"Expected 1 complex or 2 args (real: int/float, imag: int/float/complex)\")\n    else:\n        raise TypeError(\"Expected 1 complex or 2 args (real: int/float, imag: int/float/complex)\")\n\n    if real_part == 0.0 and imag_part == 0.0:\n        return 0.0\n    else:\n        return math.atan2(imag_part, real_part)"}
{"task_id": "Mbpp/127", "solution": "def multiply_int(a, b) -> int:\n    \"\"\"\n    Multiplies two integers, returning their product.\n\n    This function performs integer multiplication. Python's `int` type handles\n    arbitrary precision, so arithmetic overflow does not raise OverflowError;\n    results automatically adjust to required precision.\n\n    Parameters:\n        a (int): The first integer operand.\n        b (int): The second integer operand.\n\n    Returns:\n        int: The product of a and b.\n\n    Examples:\n        >>> multiply_int(10, 20)\n        200\n        >>> multiply_int(0, 42)\n        0\n        >>> multiply_int(-5, 7)\n        -35\n        >>> multiply_int(2**100, 2**50)\n        1329227995784915872903807060280344576\n    \"\"\"\n    if a == 0 or b == 0:\n        return 0\n    return a * b"}
{"task_id": "Mbpp/125", "solution": "def find_length(s: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s in any substring.\n    Uses Kadane's algorithm by mapping '0' to +1 and '1' to -1.\n    \"\"\"\n    if not s:\n        return 0\n\n    # Validate input contains only '0' and '1'\n    for ch in s:\n        if ch not in ('0', '1'):\n            raise ValueError(\"Input string must contain only '0' and '1' characters\")\n\n    # Map '0' to +1 and '1' to -1 for Kadane's algorithm.\n    # Initialize current_max and max_so_far with the first element's value.\n    first_val = 1 if s[0] == '0' else -1\n    current_max = first_val\n    max_so_far = first_val\n\n    # Iterate through the rest of the string starting from the second character.\n    for i in range(1, len(s)):\n        val = 1 if s[i] == '0' else -1\n        current_max = max(val, current_max + val)\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/126", "solution": "import math\n\ndef sum(a: int, b: int) -> int:\n    \"\"\"Calculates the sum of common positive divisors of two integers.\n    Raises:\n        TypeError: if either input is not an int.\n        ValueError: if both inputs are zero (common divisors undefined).\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise TypeError(\"Inputs must be integers.\")\n\n    if a == 0 and b == 0:\n        raise ValueError(\"Common divisors for (0, 0) are undefined.\")\n\n    abs_a = abs(a)\n    abs_b = abs(b)\n\n    # Calculate the greatest common divisor. math.gcd(0, N) returns N.\n    # The case (0, 0) is already handled, so g will be >= 1 here.\n    g = math.gcd(abs_a, abs_b)\n\n    total_sum_of_divisors = 0\n    # Iterate up to the square root of g to find all divisors.\n    # math.isqrt is used for efficient integer square root.\n    sqrt_g = int(math.isqrt(g))\n    for i in range(1, sqrt_g + 1):\n        if g % i == 0:\n            total_sum_of_divisors += i\n            complementary_divisor = g // i\n            if complementary_divisor != i:\n                total_sum_of_divisors += complementary_divisor\n    return total_sum_of_divisors"}
{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix) -> bool:\n    \"\"\"\n    Determines if a given square matrix is a magic square.\n    Checks for shape, element types, value range/uniqueness, and sum consistency across rows, columns, and diagonals.\n    \"\"\"\n\n    def validate_shape(matrix) -> bool:\n        \"\"\"Ensures the input is a non-empty square list-of-lists.\"\"\"\n        if type(matrix) is not list or not matrix:\n            return False\n        n = len(matrix)\n        for row in matrix:\n            if type(row) is not list or len(row) != n:\n                return False\n        return True\n\n    def validate_integers(matrix) -> bool:\n        \"\"\"Ensures every element in the matrix is an integer.\"\"\"\n        n = len(matrix)\n        for i in range(n):\n            for j in range(n):\n                if type(matrix[i][j]) is not int:\n                    return False\n        return True\n\n    def validate_range_and_uniqueness(matrix) -> bool:\n        \"\"\"Ensures elements are exactly 1 to n^2, each appearing once.\"\"\"\n        n = len(matrix)\n        expected_size = n * n\n        seen_elements = set()\n        for i in range(n):\n            for j in range(n):\n                element = matrix[i][j]\n                seen_elements.add(element)\n\n        expected_values = set(range(1, expected_size + 1))\n        return seen_elements == expected_values\n\n    def compute_target_sum(matrix) -> int:\n        \"\"\"Calculates the target sum from the first row.\"\"\"\n        return sum(matrix[0])\n\n    def verify_sums(matrix, target) -> bool:\n        \"\"\"Verifies row, column, and diagonal sums match the target.\"\"\"\n        n = len(matrix)\n\n        # Check row sums\n        for i in range(n):\n            if sum(matrix[i]) != target:\n                return False\n\n        # Check column sums\n        for j in range(n):\n            col_sum = 0\n            for i in range(n):\n                col_sum += matrix[i][j]\n            if col_sum != target:\n                return False\n\n        # Check main diagonal sum\n        main_diag_sum = 0\n        for i in range(n):\n            main_diag_sum += matrix[i][i]\n        if main_diag_sum != target:\n            return False\n\n        # Check anti-diagonal sum\n        anti_diag_sum = 0\n        for i in range(n):\n            anti_diag_sum += matrix[i][n - 1 - i]\n        if anti_diag_sum != target:\n            return False\n\n        return True\n\n    if not validate_shape(matrix):\n        return False\n    if not validate_integers(matrix):\n        return False\n    if not validate_range_and_uniqueness(matrix):\n        return False\n\n    target = compute_target_sum(matrix)\n    return verify_sums(matrix, target)"}
{"task_id": "Mbpp/128", "solution": "import string\nfrom typing import Iterable, List, Union\n\nPUNCTUATION_CHARS = set(\".,!?:;'\\\"()[]{}-\")\n\ndef validate_n(n) -> None:\n    \"\"\"Raise TypeError if n is not an int.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer.\")\n\ndef tokenize(words: Union[str, Iterable[str]]) -> List[str]:\n    \"\"\"If words is str, split on whitespace; else iterate over words and cast each element to str.\"\"\"\n    if isinstance(words, str):\n        return words.split()\n    else:\n        return [str(token) for token in words]\n\ndef trim_punctuation(token: str) -> str:\n    \"\"\"Return token with leading/trailing characters in PUNCTUATION_CHARS removed.\"\"\"\n    start = 0\n    end = len(token) - 1\n    while start <= end and token[start] in PUNCTUATION_CHARS:\n        start += 1\n    while start <= end and token[end] in PUNCTUATION_CHARS:\n        end -= 1\n    return token[start:end+1]\n\ndef filter_tokens(tokens: List[str], n: int) -> List[str]:\n    \"\"\"Trim tokens and return list of trimmed tokens whose length > n, preserving order.\"\"\"\n    result = []\n    for raw_token in tokens:\n        trimmed_token = trim_punctuation(raw_token)\n        if len(trimmed_token) > n:\n            result.append(trimmed_token)\n    return result\n\ndef long_words(n: int, words: Union[str, Iterable[str]]) -> List[str]:\n    \"\"\"Finds words longer than n characters from a given list of words.\n\n    Trims leading/trailing common punctuation from tokens before measuring length.\n    Preserves the original order of tokens in the returned list.\n\n    Args:\n        n: The minimum length threshold. Words must be strictly longer than n.\n        words: A string (to be split by whitespace) or an iterable of strings.\n\n    Returns:\n        A list of strings, where each string is a trimmed word longer than n.\n\n    Raises:\n        TypeError: If n is not an integer.\n\n    Examples:\n        >>> long_words(3, \"python is a programming language\")\n        ['python', 'programming', 'language']\n        >>> long_words(4, [\"apple\", \"banana,\", \"cat!\", \"dog\"])\n        ['apple', 'banana']\n        >>> long_words(5, \"Hello, world! This-is an example.\")\n        ['Hello', 'world', 'example']\n        >>> try:\n        ...     long_words(\"a\", \"words\")\n        ... except TypeError as e:\n        ...     print(e)\n        n must be an integer.\n    \"\"\"\n    validate_n(n)\n    token_list = tokenize(words)\n    return filter_tokens(token_list, n)"}
{"task_id": "Mbpp/130", "solution": "from typing import TypeVar, Sequence, Dict\nfrom collections import Counter\n\nT = TypeVar('T')\n\ndef _first_seen_indices(items: Sequence[T]) -> Dict[T, int]:\n    \"\"\"Creates a mapping from item to its first encountered index in the sequence.\n    Used for stable tie-breaking among non-comparable items.\"\"\"\n    first_seen: Dict[T, int] = {}\n    for i, item in enumerate(items):\n        if item not in first_seen:\n            first_seen[item] = i\n    return first_seen\n\ndef max_occurrences(items: Sequence[T]) -> T:\n    \"\"\"Finds the item with the maximum frequency in a given sequence.\n    Handles tie-breaking using natural ordering or earliest appearance.\"\"\"\n    try:\n        counts = Counter(items)\n    except TypeError as e:\n        # Catches cases where 'items' is not iterable or contains unhashable elements.\n        raise TypeError(f\"Input sequence must contain hashable elements: {e}\") from e\n\n    if not counts:\n        # Handles the case where 'items' was an empty sequence.\n        raise ValueError(\"Input sequence cannot be empty.\")\n\n    max_count = max(counts.values())\n    tied_items = [item for item, count in counts.items() if count == max_count]\n\n    try:\n        # Attempt to use natural ordering for tie-breaking (e.g., min() for numbers).\n        winner = min(tied_items)\n    except TypeError:\n        # Fallback to earliest-occurrence tie-break if items are not mutually comparable.\n        first_seen = _first_seen_indices(items)\n        winner = min(tied_items, key=lambda item: first_seen[item])\n\n    return winner"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels in the input string, treating 'y' as a consonant.\n    Vowels include 'a', 'e', 'i', 'o', 'u' in both cases.\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\n    def is_vowel(ch: str) -> bool:\n        return ch in VOWELS\n\n    chars = list(s)\n    left = 0\n    right = len(chars) - 1\n\n    while left < right:\n        while left < right and not is_vowel(chars[left]):\n            left += 1\n\n        while left < right and not is_vowel(chars[right]):\n            right -= 1\n\n        if left < right:\n            chars[left], chars[right] = chars[right], chars[left]\n            left += 1\n            right -= 1\n\n    return ''.join(chars)"}
{"task_id": "Mbpp/132", "solution": "def tup_string(tup) -> str:\n    \"\"\"Convert a tuple of single-character strings to a concatenated string. Returns an empty string for an empty tuple.\"\"\"\n    return \"\".join(tup)"}
{"task_id": "Mbpp/133", "solution": "def sum_negativenum(numbers):\n    \"\"\"\n    Calculates the sum of negative numbers from an iterable of numbers.\n    It performs validation, raising TypeError for non-iterable input or non-numeric elements.\n    \"\"\"\n    from decimal import Decimal\n\n    try:\n        iterator = iter(numbers)\n    except TypeError:\n        raise TypeError(\"sum_negativenum: 'numbers' must be an iterable\")\n\n    total = 0\n    for x in iterator:\n        if not isinstance(x, (int, float, Decimal)):\n            raise TypeError(\"sum_negativenum: all elements must be numeric (int, float, Decimal)\")\n        if x < 0:\n            total += x\n    return total"}
