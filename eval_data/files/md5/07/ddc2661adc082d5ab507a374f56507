{"task_id": "Mbpp/2", "solution": "def similar_elements(a, b):\n    \"\"\"\n    Finds shared elements from two iterables, preserving order from the first iterable.\n    Each shared element is returned only once.\n    \"\"\"\n    def _validate_iterable(x):\n        \"\"\"Raises TypeError if the given object is not iterable.\"\"\"\n        try:\n            iter(x)\n        except TypeError:\n            raise TypeError(f\"Argument '{x}' is not iterable.\")\n\n    def _build_lookup(iterable):\n        \"\"\"Builds a set of unique elements from an iterable for efficient lookups.\"\"\"\n        return set(iterable)\n\n    _validate_iterable(a)\n    _validate_iterable(b)\n\n    # To preserve order from 'a' and process 'a' in a streaming fashion,\n    # the lookup set must be built from 'b'.\n    lookup_b = _build_lookup(b)\n\n    # If the lookup set from 'b' is empty, no elements can be shared.\n    if not lookup_b:\n        return []\n\n    result = []\n    # Use a set to track elements already added to the result to ensure uniqueness.\n    seen_in_result = set()\n\n    for item_a in a:\n        if item_a in lookup_b and item_a not in seen_in_result:\n            result.append(item_a)\n            seen_in_result.add(item_a)\n\n    return result"}
{"task_id": "Mbpp/7", "solution": "def find_char_long(text):\n    import re\n\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a str\")\n\n    pattern = re.compile(r\"\\w+\", flags=re.UNICODE)\n    return [m.group(0) for m in pattern.finditer(text) if len(m.group(0)) >= 4]"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    Uses the KMP prefix function to determine the minimal rotation period.\n    \"\"\"\n    n = len(s)\n    if n == 0:\n        return 0\n\n    # Compute the KMP prefix function (pi array)\n    pi = [0] * n\n    j = 0  # length of the longest proper prefix of s[0..i] that is also a suffix of s[0..i]\n    for i in range(1, n):\n        while j > 0 and s[i] != s[j]:\n            j = pi[j - 1]\n        if s[i] == s[j]:\n            j += 1\n        pi[i] = j\n\n    # The length of the smallest repeating unit (period) is n - pi[n-1].\n    # If n is perfectly divisible by this period, then that period is the answer.\n    # Otherwise, the string itself is the smallest repeating unit.\n    period = n - pi[n - 1]\n\n    if n % period == 0:\n        return period\n    else:\n        return n"}
{"task_id": "Mbpp/3", "solution": "import math\n\ndef _is_divisible(n, d):\n    \"\"\"\n    Checks if n is divisible by d.\n    This is a module-private helper function.\n    \"\"\"\n    return n % d == 0\n\ndef is_not_prime(n):\n    \"\"\"\n    Identifies non-prime numbers. Returns True if n is not prime, False if n is prime.\n    Assumes n is an integer.\n    \"\"\"\n    if n <= 1:\n        return True\n    if n == 2:\n        return False\n    if n % 2 == 0:\n        return True\n\n    limit = math.isqrt(n)\n    for d in range(3, limit + 1, 2):\n        if _is_divisible(n, d):\n            return True\n\n    return False"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(s: str, ch: str) -> str:\n    \"\"\"\n    Remove the first and last occurrence of character ch from string s.\n\n    Args:\n        s (str): input string\n        ch (str): single-character string to remove\n\n    Returns:\n        str: resulting string after removal\n\n    Raises:\n        TypeError: if s or ch are not instances of str\n        ValueError: if len(ch) != 1\n    \"\"\"\n    if not isinstance(s, str) or not isinstance(ch, str):\n        raise TypeError(\"s and ch must be str\")\n    if len(ch) != 1:\n        raise ValueError(\"ch must be a single character (len == 1)\")\n\n    if s == \"\":\n        return s\n\n    first = None\n    last = None\n\n    for i, c in enumerate(s):\n        if c == ch:\n            if first is None:\n                first = i\n            last = i\n\n    if first is None:\n        return s  # no occurrence\n    elif first == last:\n        return s[:first] + s[first + 1:]  # single occurrence\n    else:\n        return s[:first] + s[first + 1:last] + s[last + 1:]  # remove both first and last"}
