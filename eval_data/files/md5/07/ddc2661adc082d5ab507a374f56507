{"task_id": "Mbpp/77", "solution": "def is_Diff(number):\n    \"\"\"\n    Checks if an integer is divisible by 11 using the alternating-sum rule.\n    The rule sums digits with alternating signs, starting with + for the least significant digit.\n    Returns True for 0, handles negative numbers by taking their absolute value.\n    assert is_Diff(12345) == False\n    \"\"\"\n    if not isinstance(number, int):\n        raise TypeError(\"is_Diff expects an int\")\n\n    n = abs(number)\n\n    if n == 0:\n        return True\n\n    def _alt_sum(val: int) -> int:\n        \"\"\"\n        Computes the decimal-digit alternating sum for a non-negative integer.\n        Starts with a positive sign for the least significant digit.\n        \"\"\"\n        current_sum = 0\n        sign = 1  # Start with + for the least-significant digit\n        while val > 0:\n            digit = val % 10\n            current_sum += sign * digit\n            sign = -sign\n            val //= 10\n        return current_sum\n\n    alternating_sum = _alt_sum(n)\n    return (alternating_sum % 11) == 0"}
{"task_id": "Mbpp/82", "solution": "import math\nfrom typing import Any\n\ndef volume_sphere(radius: Any) -> float:\n    \"\"\"\n    Computes the volume of a sphere given its radius using the formula V = (4/3) * \u03c0 * r^3.\n\n    Parameters:\n    - radius: int, float, or numeric string representing the radius.\n\n    Returns:\n    - float: volume of the sphere.\n\n    Raises:\n    - TypeError: if radius is not a number or numeric string.\n    - ValueError: if radius is negative, NaN, or infinite.\n    \"\"\"\n    try:\n        parsed_radius = float(radius)\n    except (ValueError, TypeError) as e:\n        raise TypeError(\"radius must be a number or numeric string\") from e\n\n    if math.isnan(parsed_radius):\n        raise ValueError(\"radius cannot be NaN\")\n    if not math.isfinite(parsed_radius):\n        raise ValueError(\"radius cannot be infinite\")\n    if parsed_radius < 0:\n        raise ValueError(\"radius cannot be negative\")\n\n    if parsed_radius == 0:\n        return 0.0\n\n    volume = (4.0 / 3.0) * math.pi * (parsed_radius ** 3)\n    return volume"}
{"task_id": "Mbpp/85", "solution": "import math\nfrom typing import Union\n\ndef surfacearea_sphere(radius: Union[int, float]) -> float:\n    \"\"\"Calculates the surface area of a sphere given its radius.\"\"\"\n    if not isinstance(radius, (int, float)):\n        raise TypeError(\"radius must be a numeric value (int or float).\")\n\n    if radius < 0:\n        raise ValueError(\"radius cannot be negative.\")\n\n    # Convert radius to float for consistent computation and return type.\n    r_float = float(radius)\n\n    # Compute surface area using the formula: 4 * pi * radius^2.\n    area = 4 * math.pi * (r_float ** 2)\n\n    return area"}
