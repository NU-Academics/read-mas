{"task_id": "Mbpp/137", "solution": "def zero_count(arr: list[int]) -> float:\n    \"\"\"Calculates the ratio of zeroes to non-zeroes in a list of integers.\n\n    Args:\n        arr: A list of integers. Must be non-empty.\n\n    Returns:\n        The ratio (zero_count / non_zero_count) as a float. If non_zero_count == 0\n        and the list is non-empty (all zeros), returns float('inf').\n\n    Raises:\n        TypeError: If `arr` is not a list or any element is not an int.\n        ValueError: If `arr` is an empty list.\n\n    Complexity:\n        Time: O(n)\n        Space: O(1)\n\n    Example:\n        >>> zero_count([0, 1, 0, 2])\n        1.0\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"arr must be a list of integers\")\n    if len(arr) == 0:\n        raise ValueError(\"arr must be non-empty\")\n\n    zeroes = 0\n    non_zeroes = 0\n\n    for x in arr:\n        if not isinstance(x, int):\n            raise TypeError(\"all elements of arr must be integers\")\n        if x == 0:\n            zeroes += 1\n        else:\n            non_zeroes += 1\n\n    if non_zeroes == 0:\n        return float('inf')\n    return float(zeroes) / float(non_zeroes)"}
{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(n) -> bool:\n    \"\"\"\n    Checks if a number can be represented as a sum of non-zero powers of two (2^k, k>=0).\n    Any positive integer can be represented in this way through its binary decomposition.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"is_Sum_Of_Powers_Of_Two: n must be int\")\n    if n <= 0:\n        return False\n    # For any positive integer, its binary decomposition is a sum of powers of two.\n    return True"}
{"task_id": "Mbpp/140", "solution": "from collections.abc import Iterable\n\ndef _is_iterable_but_not_str_bytes(obj) -> bool:\n    \"\"\"Returns True if obj is an Iterable but not a string or bytes object.\"\"\"\n    return isinstance(obj, Iterable) and not isinstance(obj, (str, bytes))\n\ndef extract_singly(outer_iterable):\n    \"\"\"\n    Flattens a one-level nested iterable into a set of unique items, treating strings/bytes atomically,\n    and raises TypeError if outer_iterable is not iterable.\n\n    This pure function operates in O(N) time and O(U) space.\n    Example: assert set(extract_singly([(3, 4, 5), (4, 5, 7), (1, 4)])) == set([3, 4, 5, 7, 1])\n    \"\"\"\n    if not isinstance(outer_iterable, Iterable):\n        raise TypeError(\"outer_iterable must be an iterable.\")\n\n    result_set = set()\n    for item in outer_iterable:\n        if _is_iterable_but_not_str_bytes(item):\n            for element in item:\n                result_set.add(element)\n        else:\n            result_set.add(item)\n    return result_set"}
{"task_id": "Mbpp/141", "solution": "def pancake_sort(items, in_place=False, key=None):\n    \"\"\"\n    Sorts a list of elements using the pancake sort algorithm.\n    \"\"\"\n    # Internal helper to reverse a prefix of the list in-place.\n    def _flip(arr, k):\n        # Reverses elements from index 0 to k (inclusive).\n        arr[:k + 1] = arr[:k + 1][::-1]\n\n    # Internal helper to find the index of the maximum element in a prefix.\n    def _find_max_index(arr, n, current_key):\n        # Finds the index of the maximum element in arr[0...n-1] using current_key for comparison.\n        max_idx = 0\n        max_val = current_key(arr[0]) if current_key else arr[0]\n        for i in range(1, n):\n            val = current_key(arr[i]) if current_key else arr[i]\n            if val > max_val:\n                max_val = val\n                max_idx = i\n        return max_idx\n\n    # Prepare the working list based on the in_place flag.\n    if not in_place:\n        work = list(items)\n    else:\n        # If in_place is True, operate directly on the provided list.\n        # If items is not a mutable list, operations on `work` will fail later.\n        if not isinstance(items, list):\n            raise TypeError(\"in_place=True requires a mutable list\")\n        work = items\n\n    n = len(work)\n\n    # Perform pancake sort.\n    for curr_size in range(n, 1, -1):\n        # Find index of the maximum element in the current prefix (0 to curr_size-1).\n        max_idx = _find_max_index(work, curr_size, key)\n\n        # If the maximum element is not already at its correct position.\n        if max_idx != curr_size - 1:\n            # Bring the maximum element to the front if it's not already there.\n            if max_idx != 0:\n                _flip(work, max_idx)\n            # Flip the entire prefix to move the maximum element to its final sorted position.\n            _flip(work, curr_size - 1)\n\n    return work"}
{"task_id": "Mbpp/145", "solution": "import math\nfrom decimal import Decimal\nfrom typing import Any, Optional, Iterable\n\ndef _is_nan(value: Any) -> bool:\n    \"\"\"\n    Checks if a numeric value is NaN, handling floats and Decimal types.\n    \"\"\"\n    if isinstance(value, float):\n        return math.isnan(value)\n    if isinstance(value, Decimal):\n        return value.is_nan()\n    return False\n\nclass MinMaxTracker:\n    \"\"\"\n    Helper class to track the minimum, maximum, and count of elements in a stream.\n    \"\"\"\n    def __init__(self) -> None:\n        self._min: Optional[Any] = None\n        self._max: Optional[Any] = None\n        self._count: int = 0\n\n    def update(self, element: Any) -> None:\n        self._count += 1\n        if self._count == 1:\n            self._min = element\n            self._max = element\n        else:\n            try:\n                if element < self._min: # type: ignore [operator]\n                    self._min = element\n                if element > self._max: # type: ignore [operator]\n                    self._max = element\n            except TypeError:\n                raise TypeError(\"Elements in the array do not support numeric comparison.\")\n\n    def result(self) -> Any:\n        if self._count <= 1:\n            return 0\n        try:\n            return abs(self._max - self._min) # type: ignore [operator]\n        except TypeError:\n            raise TypeError(\"Elements in the array do not support numeric subtraction.\")\n\ndef max_Abs_Diff(arr: Iterable[Any]) -> Any:\n    \"\"\"\n    Finds the maximum absolute difference between any two elements in an array.\n\n    Returns 0 for empty or single-element inputs. Raises TypeError for\n    incompatible element types or ValueError for NaN elements.\n    Examples: max_Abs_Diff([1, 3, 2]) == 2, max_Abs_Diff([]) == 0.\n    \"\"\"\n    tracker = MinMaxTracker()\n    for x in arr:\n        if _is_nan(x):\n            raise ValueError(\"Input array contains NaN values.\")\n        tracker.update(x)\n    return tracker.result()"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(a, b, c):\n    \"\"\"Counts items identical at the same position across three lists.\"\"\"\n    min_length = min(len(a), len(b), len(c))\n    count = 0\n    for i in range(min_length):\n        if a[i] == b[i] == c[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_str: str) -> int:\n    \"\"\"\n    Counts characters whose 1-based string position matches their 1-based alphabet position (a=1, z=26), case-insensitively.\n    Non-alphabetic characters are ignored.\n    \"\"\"\n    count = 0\n    for i, ch in enumerate(input_str):\n        lower_ch = ch.lower()\n        if 'a' <= lower_ch <= 'z':\n            alphabet_pos = ord(lower_ch) - ord('a') + 1\n            string_pos = i + 1\n            if alphabet_pos == string_pos:\n                count += 1\n    return count"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum (n - 2*i) from i=0 to n // 2 using a closed-form solution.\n    This provides an O(1) time complexity calculation.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    m = n // 2\n    return (m + 1) * (n - m)"}
{"task_id": "Mbpp/160", "solution": "def extended_gcd(a: int, b: int) -> tuple[int, int, int]:\n    \"\"\"\n    Computes gcd(a,b) and B\u00e9zout coefficients s,t such that a*s + b*t == g.\n    Ensures g >= 0.\n    \"\"\"\n    x, last_x = 0, 1\n    y, last_y = 1, 0\n    while b != 0:\n        quotient = a // b\n        a, b = b, a % b\n        x, last_x = last_x - quotient * x, x\n        y, last_y = last_y - quotient * y, y\n\n    # Ensure gcd (a) is non-negative. If not, adjust signs of s and t.\n    if a < 0:\n        a = -a\n        last_x = -last_x\n        last_y = -last_y\n\n    return a, last_x, last_y # a is gcd, last_x is s, last_y is t\n\ndef handle_edge_cases(a: int, b: int, n: int) -> tuple[int,int] | None:\n    \"\"\"\n    Handles degenerate cases where a == 0 and/or b == 0, returning a solution or None.\n    If a and b are both non-zero, this function should not be called.\n    \"\"\"\n    if a == 0 and b == 0:\n        if n == 0:\n            return (0, 0) # 0*x + 0*y = 0, any (x,y) works, (0,0) is a canonical choice\n        else:\n            return None # 0*x + 0*y = n (n != 0) has no solution\n    elif a == 0: # b != 0 implied here\n        if n % b == 0:\n            return (0, n // b) # 0*x + b*y = n implies y = n/b\n        else:\n            return None # b does not divide n\n    elif b == 0: # a != 0 implied here\n        if n % a == 0:\n            return (n // a, 0) # a*x + 0*y = n implies x = n/a\n        else:\n            return None # a does not divide n\n    return None # Should not be reached if called correctly (a or b is zero).\n                # Added for type hint completeness, though logic implies it's never called for a!=0 and b!=0.\n\ndef _canonicalize_x(x0: int, b: int, g: int) -> int:\n    \"\"\"\n    Returns the canonical representative x in 0 <= x < m, where m = abs(b // g).\n    Assumes b != 0 and g != 0.\n    \"\"\"\n    m = abs(b // g)\n    return x0 % m\n\ndef find_solution(a: int, b: int, n: int) -> tuple[int,int] | None:\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple (x,y),\n    or returns None if no solution exists.\n    \"\"\"\n    # Handle edge cases where a or b is zero.\n    if a == 0 or b == 0:\n        return handle_edge_cases(a, b, n)\n\n    # General case: a != 0 and b != 0\n    g, s, t = extended_gcd(a, b)\n\n    # A solution exists if and only if n is divisible by g (gcd(a,b))\n    if n % g != 0:\n        return None\n\n    # Compute a particular solution (x0, y0)\n    k = n // g\n    x0 = s * k\n    y0 = t * k\n\n    # Canonicalize x to be in the range [0, |b/g| - 1]\n    x = _canonicalize_x(x0, b, g)\n\n    # Compute the corresponding y for the canonical x\n    y = (n - a * x) // b\n\n    return (x, y)"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(lst: list, elements: list) -> list:\n    \"\"\"\n    Return a new list containing items from `lst` with all occurrences of any\n    element listed in `elements` removed.\n\n    This function does not modify `lst` or `elements` and preserves the order\n    of retained items.\n    \"\"\"\n    H = set()\n    U = []\n    for e in elements:\n        try:\n            H.add(e)\n        except TypeError:\n            U.append(e)\n    return [x for x in lst if (x not in H and all(x != u for u in U))]"}
{"task_id": "Mbpp/168", "solution": "def frequency(number, lst) -> int:\n    \"\"\"Counts the occurrences of a number in a list.\n\n    This function iterates through the list and increments a counter each time the\n    target number is found using Python's equality (==) operator.\n    \"\"\"\n    count = 0\n    for element in lst:\n        if element == number:\n            count += 1\n    return count"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(nums):\n    \"\"\"Counts pairs of integers in a list whose XOR is even.\n\n    XOR of two integers is even iff both integers have the same parity\n    (both even or both odd). This function counts evens and odds and\n    returns C(evens, 2) + C(odds, 2).\n\n    Args:\n        nums: Iterable of integers.\n\n    Returns:\n        int: Number of unordered pairs (i < j) where nums[i] ^ nums[j] is even.\n\n    Raises:\n        TypeError: If any element in nums is not an int.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for num in nums:\n        if not isinstance(num, int):\n            raise TypeError(\"All elements must be integers\")\n        if num % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # C(n, 2) = n * (n - 1) // 2\n    pairs = (even_count * (even_count - 1) // 2) + (odd_count * (odd_count - 1) // 2)\n    return pairs"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"Return the smallest power of two greater than or equal to n. For n == 0, it returns 1.\"\"\"\n    if n == 0:\n        return 1\n    return 1 << ((n - 1).bit_length())"}
{"task_id": "Mbpp/172", "solution": "def count_occurance(input: str) -> int:\n    \"\"\"Counts literal, case-sensitive occurrences of 'std' in the input string, including overlapping matches.\"\"\"\n    n = len(input)\n    if n < 3:\n        return 0\n\n    count = 0\n    for i in range(n - 2):\n        if input[i] == 's' and input[i+1] == 't' and input[i+2] == 'd':\n            count += 1\n    return count"}
{"task_id": "Mbpp/171", "solution": "def perimeter_pentagon(side_length: float) -> float:\n    \"\"\"\n    Calculates the perimeter of a regular pentagon from its side length.\n\n    Validates the input and returns 5 times the side length as a float.\n\n    Raises:\n        TypeError: if side_length is not an int or float.\n        ValueError: if side_length is NaN, infinite, or negative.\n    \"\"\"\n    from typing import Any\n    import math\n\n    def _validate_side_length(s_len: Any) -> None:\n        if not isinstance(s_len, (int, float)):\n            raise TypeError(\"side_length must be an int or float\")\n        if not math.isfinite(s_len):\n            raise ValueError(\"side_length must be finite and not NaN\")\n        if s_len < 0:\n            raise ValueError(\"side_length must be non-negative\")\n\n    _validate_side_length(side_length)\n    return float(5 * side_length)"}
{"task_id": "Mbpp/170", "solution": "from typing import Sequence, Union\n\ndef _validate_indices(start: int, end: int) -> None:\n    \"\"\"Raises TypeError if start or end are not integers.\"\"\"\n    if not isinstance(start, int) or not isinstance(end, int):\n        raise TypeError(\"Indices 'start' and 'end' must be integers.\")\n\ndef _normalize_index(idx: int, length: int) -> int:\n    \"\"\"Normalizes a negative index by adding the list length.\"\"\"\n    if idx < 0:\n        return idx + length\n    return idx\n\ndef _compute_sum(lst: Sequence[Union[int, float]], start: int, end: int) -> Union[int, float]:\n    \"\"\"Calculates the sum of list elements from start to end inclusive.\"\"\"\n    current_sum: Union[int, float] = 0\n    for i in range(start, end + 1):\n        current_sum += lst[i]\n    return current_sum\n\ndef sum_range_list(lst: Sequence[Union[int, float]], start: int, end: int) -> Union[int, float]:\n    \"\"\"\n    Calculates the sum of numbers in a list within a specified inclusive range.\n    Raises TypeError for non-integer indices and IndexError for out-of-bounds indices.\n    \"\"\"\n    _validate_indices(start, end)\n\n    length = len(lst)\n\n    normalized_start = _normalize_index(start, length)\n    normalized_end = _normalize_index(end, length)\n\n    # Validate normalized indices are within list bounds [0, length-1]\n    if not (0 <= normalized_start < length) or not (0 <= normalized_end < length):\n        raise IndexError(\"List index out of range.\")\n\n    # If the normalized start index is greater than the normalized end index, return 0 for an empty inclusive range.\n    if normalized_start > normalized_end:\n        return 0\n\n    return _compute_sum(lst, normalized_start, normalized_end)"}
{"task_id": "Mbpp/222", "solution": "def check_type(items: tuple) -> bool:\n    \"\"\"\n    Checks if all elements in the tuple `items` have the exact same data type using `type()`.\n\n    Returns True for empty and single-element tuples.\n    \"\"\"\n    if len(items) <= 1:\n        return True\n    first_type = type(items[0])\n    for elem in items[1:]:\n        if type(elem) != first_type:\n            return False\n    return True"}
{"task_id": "Mbpp/223", "solution": "def is_majority(arr, n, element):\n    \"\"\"\n    Checks if an element is a majority element in a sorted array.\n    A majority element occurs more than n/2 times.\n    \"\"\"\n    def find_first_occurrence(arr, n, element):\n        \"\"\"\n        Finds the first (leftmost) occurrence of the element using binary search.\n        Returns its index or -1 if not found.\n        \"\"\"\n        left, right = 0, n - 1\n        result = -1\n        while left <= right:\n            mid = left + (right - left) // 2\n            if arr[mid] == element:\n                result = mid\n                right = mid - 1  # Continue searching in the left half for the first occurrence\n            elif arr[mid] < element:\n                left = mid + 1\n            else:  # arr[mid] > element\n                right = mid - 1\n        return result\n\n    if n == 0:\n        return False\n\n    # Find the first occurrence of the element\n    first_occurrence_idx = find_first_occurrence(arr, n, element)\n\n    # If the element is not found, it cannot be a majority element\n    if first_occurrence_idx == -1:\n        return False\n\n    # Check if the element at index `first_occurrence_idx + n//2` is also the same element.\n    # If it is, then there are at least n//2 + 1 occurrences.\n    check_index = first_occurrence_idx + (n // 2)\n\n    # Ensure check_index is within array bounds and the element at check_index is indeed `element`\n    if check_index < n and arr[check_index] == element:\n        return True\n    else:\n        return False"}
{"task_id": "Mbpp/226", "solution": "def odd_values_string(s: str) -> str:\n    \"\"\"Return a new string containing characters from s at even indices (0-based: 0, 2, 4, ...).\n    Validates input type and uses string slicing for extraction.\"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a str\")\n    return s[0::2]"}
{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(n: int) -> int:\n    \"\"\"Counts the number of set bits (1s) in the binary representation of a non-negative integer.\n\n    This function implements Brian Kernighan's algorithm, which has a time complexity of O(k)\n    where k is the number of set bits. An alternative is a simple bit-checking loop (O(b)\n    where b is the bit length of n).\n\n    Args:\n        n (int): A non-negative integer.\n\n    Returns:\n        int: The count of set bits in n.\n\n    Raises:\n        TypeError: If n is not an integer.\n        ValueError: If n is a negative integer.\n\n    Examples:\n        >>> count_Set_Bits(2)\n        1\n        >>> count_Set_Bits(0)\n        0\n        >>> count_Set_Bits(2**10 - 1)\n        10\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n == 0:\n        return 0\n\n    count = 0\n    # Brian Kernighan's algorithm repeatedly clears the least-significant set bit.\n    while n > 0:\n        n &= (n - 1)\n        count += 1\n    return count"}
{"task_id": "Mbpp/227", "solution": "def min_of_three(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Finds the minimum of three numbers using pairwise comparisons.\n    Assumes valid numeric inputs (int or float) as per prompt requirements.\n    \"\"\"\n    minimum = a\n    if b < minimum:\n        minimum = b\n    if c < minimum:\n        minimum = c\n    return minimum"}
