{"task_id": "Mbpp/84", "solution": "def sequence(n: int) -> int:\n    \"\"\"\n    Calculates the nth number in the Newman-Conway sequence using an iterative approach with memoization.\n    Raises TypeError if n is not an integer or ValueError if n is less than 1.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n\n    if n == 1 or n == 2:\n        return 1\n\n    # Initialize memoization array (1-based indexing)\n    # memo[0] is unused, memo[1] to memo[n] store sequence values\n    memo = [0] * (n + 1)\n    memo[1] = 1\n    memo[2] = 1\n\n    for k in range(3, n + 1):\n        prev_term_index = memo[k - 1]\n        memo[k] = memo[prev_term_index] + memo[k - prev_term_index]\n\n    return memo[n]"}
{"task_id": "Mbpp/86", "solution": "def centered_hexagonal_number(n):\n    \"\"\"Calculates the nth centered hexagonal number using the formula C(n) = 3 * n * (n - 1) + 1.\"\"\"\n    p = n * (n - 1)\n    q = 3 * p\n    result = q + 1\n    return result"}
{"task_id": "Mbpp/87", "solution": "def merge_dictionaries_three(a: dict, b: dict, c: dict) -> dict:\n    \"\"\"Merges three dictionaries into a new dictionary, with later arguments overriding earlier ones.\n\n    Example:\n        a = { \"R\": \"Red\", \"B\": \"Black\", \"P\": \"Pink\" }\n        b = { \"G\": \"Green\", \"W\": \"White\" }\n        c = { \"O\": \"Orange\", \"W\": \"White\", \"B\": \"Black\" }\n        merge_dictionaries_three(a, b, c) == { \"R\": \"Red\", \"B\": \"Black\", \"P\": \"Pink\", \"G\": \"Green\", \"W\": \"White\", \"O\": \"Orange\" }\n    \"\"\"\n    if not isinstance(a, dict) or not isinstance(b, dict) or not isinstance(c, dict):\n        raise TypeError(\"All inputs must be dict\")\n\n    merged_dict = {}\n    merged_dict.update(a)\n    merged_dict.update(b)\n    merged_dict.update(c)\n    return merged_dict"}
{"task_id": "Mbpp/88", "solution": "def freq_count(lst) -> dict:\n    \"\"\"\n    Calculates the frequency of each element in a list, returning the results as a dictionary.\n    Each distinct element from the list becomes a key, and its count becomes the value.\n    \"\"\"\n    counts = {}\n    for element in lst:\n        counts[element] = counts.get(element, 0) + 1\n    return counts"}
{"task_id": "Mbpp/91", "solution": "def find_substring(substring: str, strings: list[str]) -> bool:\n    \"\"\"\n    Checks if a substring is present in any string within a list of strings.\n\n    Validates input types and searches for the given substring, returning True on the first match.\n    Example: find_substring(\"ack\", [\"red\", \"black\"]) returns True.\n    \"\"\"\n    if not isinstance(substring, str):\n        raise TypeError(\"substring must be a str\")\n    if not isinstance(strings, list):\n        raise TypeError(\"strings must be a list\")\n\n    for idx, s in enumerate(strings):\n        if not isinstance(s, str):\n            raise TypeError(f\"element at index {idx} is not a str\")\n        if substring in s:\n            return True\n    return False"}
{"task_id": "Mbpp/90", "solution": "def len_log(words):\n    \"\"\"\n    Finds the length of the longest string representation of elements in an iterable.\n    Converts each element to a string using str() before computing its length.\n    \"\"\"\n    it = iter(words)\n    max_len = 0\n    for element in it:\n        s = str(element)\n        l = len(s)\n        if l > max_len:\n            max_len = l\n    return max_len"}
{"task_id": "Mbpp/92", "solution": "def is_undulating(n: int) -> bool:\n    \"\"\"Checks if a number is undulating: digits alternate between two distinct values and length >= 3.\n\n    Args:\n        n (int): The input integer. Non-integer types are not supported.\n\n    Returns:\n        bool: True if n is undulating, False otherwise.\n\n    Examples:\n        assert is_undulating(1212121) == True\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"is_undulating expects an int\")\n\n    m = abs(n)\n    s = str(m)\n\n    if len(s) < 3:\n        return False\n\n    first_digit = s[0]\n    second_digit = s[1]\n\n    if first_digit == second_digit:\n        return False\n\n    for i, ch in enumerate(s[2:], start=2):\n        expected = first_digit if i % 2 == 0 else second_digit\n        if ch != expected:\n            return False\n\n    return True"}
{"task_id": "Mbpp/89", "solution": "import math\nimport sys\nimport numbers\nfrom decimal import Decimal, getcontext\nfrom typing import Union\n\n\ndef _float_predecessor(n: float) -> float:\n    \"\"\"Computes the closest smaller float than n, handling infinities and NaNs.\"\"\"\n    if math.isnan(n):\n        raise ValueError(\"closest_num: NaN is not a valid input\")\n    if n == float('inf'):\n        return sys.float_info.max\n    if n == float('-inf'):\n        raise ValueError(\"closest_num: -inf has no smaller representable value\")\n    return math.nextafter(n, -math.inf)\n\n\ndef _int_predecessor(n: int) -> int:\n    \"\"\"Computes the closest smaller integer than n.\"\"\"\n    return n - 1\n\n\ndef _decimal_predecessor(n: Decimal) -> Decimal:\n    \"\"\"Computes the closest smaller Decimal than n, prioritizing specific API or subtracting quantum.\"\"\"\n    # Check for Decimal-provided predecessor APIs (e.g., for custom Decimal types).\n    if hasattr(n, 'next_minus') and callable(getattr(n, 'next_minus')):\n        return n.next_minus()\n    # If no specific API, compute the least-significant quantum based on the number's own exponent (scale).\n    # This ensures the predecessor respects the original number's precision.\n    quantum = Decimal(1).scaleb(n.as_tuple().exponent)\n    return n - quantum\n\n\ndef _other_predecessor(n: numbers.Real) -> Union[numbers.Real, float]:\n    \"\"\"Handles other numbers.Real types, calling predecessor API if present or falling back to float.\"\"\"\n    # Check for specific predecessor methods in a preferred order on the object itself.\n    if hasattr(n, 'next_minus') and callable(getattr(n, 'next_minus')):\n        return n.next_minus()\n    if hasattr(n, 'prev') and callable(getattr(n, 'prev')):\n        return n.prev()\n    # If no specific predecessor method is found, convert to float and use float predecessor.\n    return _float_predecessor(float(n))\n\n\ndef closest_num(n: numbers.Real) -> numbers.Real:\n    \"\"\"\n    Finds the closest strictly smaller numeric value than n.\n    Handles int, float, Decimal, and other numbers.Real types, raising TypeError for invalid inputs and ValueError for unrepresentable results.\n    \"\"\"\n    if isinstance(n, bool):\n        raise TypeError(\"boolean values are not accepted for closest_num\")\n    if not isinstance(n, numbers.Real):\n        raise TypeError(\"closest_num: input must be an instance of numbers.Real\")\n\n    if isinstance(n, float):\n        return _float_predecessor(n)\n    if isinstance(n, int):\n        return _int_predecessor(n)\n    if isinstance(n, Decimal):\n        return _decimal_predecessor(n)\n    # For any other numbers.Real subclass\n    return _other_predecessor(n)"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(lst):\n    \"\"\"\n    Returns the first value of the tuple with the smallest second value in a list of tuples.\n    On ties, the first occurrence wins.\n\n    Parameters:\n    - lst: sequence of tuples where each tuple has length >= 2.\n\n    Returns:\n    - The element at index 0 of the tuple whose index 1 value is minimal.\n\n    Raises:\n    - ValueError: if lst is empty.\n    - TypeError: if any element is not a tuple or has length < 2.\n    - Any exception raised when comparing second elements is propagated.\n    \"\"\"\n    if len(lst) == 0:\n        raise ValueError(\"lst must not be empty\")\n\n    iterator = iter(lst)\n    first_elem = next(iterator)\n\n    if not isinstance(first_elem, tuple) or len(first_elem) < 2:\n        raise TypeError(\"each element of lst must be a tuple of length >= 2\")\n\n    current_min_first = first_elem[0]\n    current_min_second = first_elem[1]\n\n    for element in iterator:\n        if not isinstance(element, tuple) or len(element) < 2:\n            raise TypeError(\"each element of lst must be a tuple of length >= 2\")\n        # comparison may raise and should propagate\n        if element[1] < current_min_second:\n            current_min_second = element[1]\n            current_min_first = element[0]\n\n    return current_min_first"}
{"task_id": "Mbpp/95", "solution": "from typing import List, Any\n\ndef Find_Min_Length(list_of_lists: List[List[Any]]) -> int:\n    \"\"\"Finds the length of the smallest list within a list of lists.\n    It performs input validation and then computes the minimum length.\n    \"\"\"\n    # Validate the outer argument type\n    if not isinstance(list_of_lists, list):\n        raise TypeError(\"outer argument must be a list\")\n\n    # Validate the outer list is not empty\n    if not list_of_lists:\n        raise ValueError(\"outer list must not be empty\")\n\n    # Validate each element in the outer list is itself a list\n    for idx, inner in enumerate(list_of_lists):\n        if not isinstance(inner, list):\n            raise TypeError(f\"element at index {idx} is not a list; value={repr(inner)}\")\n\n    # Compute the minimum length of inner lists\n    min_len = float('inf')\n    for inner_list in list_of_lists:\n        length = len(inner_list)\n        if length < min_len:\n            min_len = length\n        if min_len == 0:\n            break  # Early exit if the smallest possible length (0) is found\n\n    return int(min_len)"}
{"task_id": "Mbpp/93", "solution": "import math\n\ndef power(a: int | float, b: int | float) -> int | float:\n    \"\"\"\n    Calculates the value of 'a' raised to the power 'b'.\n\n    Handles integer and float bases and exponents, including special cases like\n    0**0=1 and negative exponents. Raises TypeError for invalid input types,\n    ValueError for domain errors (e.g., negative base with non-integer float\n    exponent), ZeroDivisionError for 0 to a negative power, and OverflowError\n    for results exceeding float limits.\n\n    Examples:\n        power(3, 4) == 81\n        power(2, -2) == 0.25\n        power(0, 0) == 1\n        power(2.0, 0.5) approx 1.414\n    \"\"\"\n\n    def _validate_inputs(a_val: object, b_val: object) -> None:\n        \"\"\"Validates that both operands are of type int or float.\"\"\"\n        if not isinstance(a_val, (int, float)) or not isinstance(b_val, (int, float)):\n            raise TypeError(\"Operands 'a' and 'b' must be of type int or float.\")\n\n    def _select_strategy(a_val: int | float, b_val: int | float) -> str:\n        \"\"\"Selects computation strategy based on exponent type.\"\"\"\n        if isinstance(b_val, int):\n            return 'integer'\n        return 'float'\n\n    def _is_integer_valued(num: float) -> bool:\n        \"\"\"Checks if a float value is an exact integer.\"\"\"\n        return num == int(num)\n\n    def _fast_pow(base: int | float, exp_int: int) -> int | float:\n        \"\"\"\n        Computes base**exp_int using exponentiation by squaring.\n        Assumes exp_int is non-negative.\n        \"\"\"\n        result: int | float = 1\n        current_base: int | float = base\n\n        while exp_int > 0:\n            if exp_int % 2 == 1:\n                result *= current_base\n            current_base *= current_base\n            exp_int //= 2\n\n        return result\n\n    def _integer_exponent_strategy_compute(a_val: int | float, b_val_int: int) -> int | float:\n        \"\"\"Handles integer exponent computation.\"\"\"\n        if b_val_int >= 0:\n            return _fast_pow(a_val, b_val_int)\n        else:  # b_val_int < 0\n            if a_val == 0:\n                raise ZeroDivisionError(\"Cannot raise 0 to a negative power.\")\n            positive_result = _fast_pow(a_val, -b_val_int)\n            return 1.0 / positive_result\n\n    def _float_exponent_strategy_compute(a_val: int | float, b_val_float: float) -> float:\n        \"\"\"Handles float exponent computation using math.log and math.exp.\"\"\"\n        if a_val < 0 and not _is_integer_valued(b_val_float):\n            raise ValueError(\"Cannot raise a negative base to a non-integer float power.\")\n\n        if a_val == 0:\n            if b_val_float > 0:\n                return 0.0\n            raise ZeroDivisionError(\"Cannot raise 0 to a negative power.\")\n\n        try:\n            ln_abs = math.log(abs(a_val))\n            result = math.exp(b_val_float * ln_abs)\n        except OverflowError:\n            raise OverflowError(\"Result too large to be represented as float.\")\n\n        if not math.isfinite(result):\n            raise OverflowError(\"Result too large or undefined to be represented as float.\")\n\n        return float(result)\n\n    _validate_inputs(a, b)\n\n    if b == 0:\n        return 1\n\n    strategy = _select_strategy(a, b)\n\n    if strategy == 'integer':\n        result = _integer_exponent_strategy_compute(a, int(b))\n\n        if isinstance(a, int) and isinstance(b, int) and b >= 0:\n            return int(result)\n        else:\n            return float(result)\n    elif strategy == 'float':\n        return _float_exponent_strategy_compute(a, float(b))\n\n    raise RuntimeError(\"Unexpected computation strategy.\")"}
{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"Calculates the number of positive integer divisors for a given integer n.\n    Handles type and value validation as specified in the design context.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n == 0:\n        raise ValueError(\"n must be non-zero\")\n\n    m = abs(n)\n    count = 0\n    # Calculate the integer square root to set the upper limit for trial division.\n    limit = int(m**0.5)\n\n    for i in range(1, limit + 1):\n        if m % i == 0:\n            if i * i == m:\n                count += 1  # If i is a divisor and i*i equals m, count it once\n            else:\n                count += 2  # Otherwise, i and m//i are two distinct divisors\n\n    return count"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(n):\n    \"\"\"\n    Converts a non-negative decimal integer to its binary equivalent using repeated division by 2,\n    then reversing the remainders. Time complexity: O(log n). Space complexity: O(log n).\n\n    Examples:\n        decimal_to_binary(0) -> \"0\"\n        decimal_to_binary(5) -> \"101\"\n        decimal_to_binary(10) -> \"1010\"\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an int.\")\n    if n < 0:\n        raise ValueError(\"Input must be non-negative.\")\n\n    if n == 0:\n        return \"0\"\n\n    binary_digits = []\n    while n > 0:\n        binary_digits.append(str(n & 1))\n        n >>= 1\n\n    return \"\".join(reversed(binary_digits))"}
{"task_id": "Mbpp/97", "solution": "def frequency_lists(lists):\n    \"\"\"\n    Calculates the frequency of each element in a flattened list of lists.\n\n    Parameters:\n    - lists: an iterable of iterables (e.g., list of lists/tuples)\n\n    Returns:\n    - dict mapping element -> frequency (int)\n\n    Note: This implementation flattens exactly one level and relies on elements\n    being hashable. If unhashable elements are present, a TypeError will be raised\n    by the underlying dict operations.\n    \"\"\"\n    def _flatten_once(seq_of_seqs):\n        for sub_seq in seq_of_seqs:\n            for item in sub_seq:\n                yield item\n\n    counts = {}\n    for element in _flatten_once(lists):\n        counts[element] = counts.get(element, 0) + 1\n    return counts"}
{"task_id": "Mbpp/98", "solution": "from typing import Iterable\n\ndef multiply_num(numbers: Iterable[float | int]) -> float:\n    \"\"\"\n    Multiplies all numbers in an iterable and divides the product by the list's length.\n\n    Args:\n        numbers: An iterable of integers or floats.\n\n    Returns:\n        The product of numbers divided by their count, as a float.\n\n    Raises:\n        TypeError: If 'numbers' is not an iterable, or if any element is not an int or float.\n        ValueError: If the 'numbers' iterable is empty.\n\n    Example:\n        multiply_num((8, 2, 3, -1, 7)) -> -67.2\n    \"\"\"\n    try:\n        numbers_list = list(numbers)\n    except TypeError:\n        raise TypeError(\"numbers must be an iterable\")\n\n    if not numbers_list:  # Check if the list is empty\n        raise ValueError(\"numbers iterable is empty\")\n\n    product: float = 1.0\n    for element in numbers_list:\n        if not isinstance(element, (int, float)):\n            raise TypeError(\"all elements must be int or float\")\n        product *= float(element)\n\n    result = float(product) / float(len(numbers_list))\n    return result"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(input_str: str) -> str:\n    \"\"\"Converts a snake_case string to PascalCase.\n\n    Segments are lowercased and then capitalized, ignoring empty segments.\n    \"\"\"\n    if not isinstance(input_str, str):\n        raise TypeError(\"input_str must be a str\")\n\n    if input_str == \"\":\n        return \"\"\n\n    if \"_\" in input_str:\n        segments = input_str.split(\"_\")\n        normalized_segments = []\n        for segment in segments:\n            if segment:  # Ignore empty segments from leading/trailing/consecutive underscores\n                normalized_segments.append(segment.lower().capitalize())\n        return \"\".join(normalized_segments)\n    else:\n        # If no underscores, only capitalize the first character\n        return input_str[0].upper() + input_str[1:]"}
{"task_id": "Mbpp/101", "solution": "class IndexValidator:\n    \"\"\"Helper class for validating input parameters.\"\"\"\n    @staticmethod\n    def ensure_int(k):\n        \"\"\"Ensures k is an integer.\"\"\"\n        if not isinstance(k, int):\n            raise TypeError(\"k must be an integer\")\n\n    @staticmethod\n    def ensure_ge_one(k):\n        \"\"\"Ensures k is greater than or equal to one.\"\"\"\n        if k < 1:\n            raise ValueError(\"k must be >= 1\")\n\n    @staticmethod\n    def ensure_indexable(arr):\n        \"\"\"Ensures arr is an indexable sequence.\"\"\"\n        if arr is None or not hasattr(arr, '__len__') or not hasattr(arr, '__getitem__'):\n            raise TypeError(\"arr must be an indexable sequence\")\n\n    @staticmethod\n    def ensure_in_range(arr, k):\n        \"\"\"Ensures k is within the bounds of arr's length.\"\"\"\n        if k > len(arr):\n            raise IndexError(\"k is out of range\")\n\nclass KthElementFunction:\n    \"\"\"Orchestrates validation and retrieval of the k-th element.\"\"\"\n    __doc__ = \"\"\"\nkth_element(arr, k)\n\nFinds the k-th element in the given 1-based indexed array.\n\nParameters:\n    arr: An indexable sequence (must implement __len__ and __getitem__).\n    k: An integer representing the 1-based index of the element to find.\n\nReturns:\n    The element at the 1-based index k (i.e., arr[k-1]).\n\nRaises:\n    TypeError: If k is not an integer (\"k must be an integer\").\n    ValueError: If k is less than 1 (\"k must be >= 1\").\n    TypeError: If arr is not an indexable sequence (\"arr must be an indexable sequence\").\n    IndexError: If k is out of range (k > len(arr)) (\"k is out of range\").\n\nComplexity:\n    O(1) additional space; O(1) time for builtin O(1)-indexing sequences; may be O(k) for sequences with non-constant indexing.\n\nExamples:\n    kth_element([10, 20, 30], 1) -> 10\n    kth_element([10, 20, 30], 3) -> 30\n\nEdge Cases:\n    kth_element([], 1) -> raises IndexError(\"k is out of range\")\n    kth_element(None, 1) -> raises TypeError(\"arr must be an indexable sequence\")\n    kth_element([1,2], 2.0) -> raises TypeError(\"k must be an integer\")\n    kth_element([1,2], 0) -> raises ValueError(\"k must be >= 1\")\n    kth_element([1,2], 3) -> raises IndexError(\"k is out of range\")\n\"\"\"\n\n    @staticmethod\n    def validate_inputs(arr, k):\n        \"\"\"Validates the input array and index using IndexValidator.\"\"\"\n        IndexValidator.ensure_int(k)\n        IndexValidator.ensure_ge_one(k)\n        IndexValidator.ensure_indexable(arr)\n        IndexValidator.ensure_in_range(arr, k)\n\n    @staticmethod\n    def get_element(arr, k):\n        \"\"\"Retrieves the element at the 1-based index k.\"\"\"\n        return arr[k - 1]\n\n    @staticmethod\n    def kth_element(arr, k):\n        \"\"\"Main entry point for finding the k-th element.\"\"\"\n        KthElementFunction.validate_inputs(arr, k)\n        return KthElementFunction.get_element(arr, k)\n\ndef kth_element(arr, k):\n    \"\"\"\n    Finds the k-th element in the given 1-based indexed array.\n    Refer to KthElementFunction.__doc__ for detailed documentation.\n    \"\"\"\n    return KthElementFunction.kth_element(arr, k)\n\nkth_element.__doc__ = KthElementFunction.__doc__"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome of a specified integer, returned as an integer.\n    Handles negative inputs by returning 0, and single-digit numbers directly.\n    \"\"\"\n\n    # Helper function to convert a list of digits to an integer.\n    def _digits_to_int(digits_list):\n        if not digits_list:\n            return 0\n        return int(\"\".join(map(str, digits_list)))\n\n    # Helper function to compare a list of digits (candidate) with an integer (original).\n    # Returns 1 if candidate > original, -1 if candidate < original, 0 if candidate == original.\n    def _compare_digits_to_int(candidate_digits, original_int):\n        candidate_val = _digits_to_int(candidate_digits)\n        if candidate_val > original_int:\n            return 1\n        elif candidate_val < original_int:\n            return -1\n        else:\n            return 0\n\n    # Handle negative inputs per design assumption (FR-05, BR-004).\n    if n < 0:\n        return 0\n\n    # Handle single-digit numbers (0-8) per design (FR-06, BR-005).\n    if 0 <= n <= 8:\n        return n + 1\n\n    # Convert n to a list of digits for manipulation.\n    digits = [int(d) for d in str(n)]\n    L = len(digits)\n\n    # Handle all-9s inputs (e.g., 9, 99, 999) per design (FR-07, BR-006).\n    # This also covers n=9 which should return 11.\n    if all(d == 9 for d in digits):\n        # Result is '1' followed by L-1 zeros and then '1' (e.g., 99 -> 101).\n        return int('1' + '0' * (L - 1) + '1')\n\n    # Core algorithm: string-based mirroring.\n    mid = L // 2\n    is_odd = (L % 2 == 1)\n\n    # 1. Create a first candidate palindrome by mirroring the left half to the right half.\n    candidate_digits = list(digits)  # Work on a copy initially.\n    for i in range(mid):\n        candidate_digits[L - 1 - i] = candidate_digits[i]\n\n    # 2. Compare this candidate with the original number n.\n    # If candidate_val > n, this is the smallest strictly greater palindrome.\n    if _compare_digits_to_int(candidate_digits, n) == 1:\n        return _digits_to_int(candidate_digits)\n\n    # 3. If candidate_val <= n, we need to increment the \"pivot\" part\n    #    (middle for odd length, left half's last digit for even length) and then re-mirror.\n\n    # Determine the index to start incrementing from.\n    # For even length: last digit of the left half.\n    # For odd length: the middle digit.\n    increment_start_idx = mid - 1 if not is_odd else mid\n\n    # Perform increment with carry propagation on the left half (and middle for odd).\n    # The `digits` list is modified in place here.\n    carry = 1\n    i = increment_start_idx\n    while i >= 0 and carry > 0:\n        new_digit_val = digits[i] + carry\n        digits[i] = new_digit_val % 10\n        carry = new_digit_val // 10\n        i -= 1\n\n    # If there's a carry left over after processing all digits to the left (i.e., `i < 0` and `carry > 0`),\n    # it means the number of digits has effectively increased. This scenario is typically covered\n    # by the initial all-9s check (e.g., 99 -> 101). However, if somehow this branch is reached\n    # for a non-all-9s number where the leftmost part becomes all 9s and increments to 10.\n    # For example, if the left half was [9] and incremented to [1,0] (new length).\n    # This logic handles that implicit length growth as per design.\n    if carry > 0:\n        digits.insert(0, 1)  # Prepend '1'.\n        L += 1  # Update length.\n        mid = L // 2  # Recalculate mid for new length.\n        is_odd = (L % 2 == 1)  # Recalculate if odd/even.\n\n    # Re-mirror the (potentially incremented and resized) left half to form the final palindrome.\n    for i in range(mid):\n        digits[L - 1 - i] = digits[i]\n\n    return _digits_to_int(digits)"}
