{"task_id": "Mbpp/406", "solution": "def find_Parity(number):\n    \"\"\"Determines if the parity of a given number is odd.\n    Expects an exact integer type; returns True for odd, False for even, and raises TypeError for non-integer inputs.\n    Example: assert find_Parity(5) is True\n    \"\"\"\n    if type(number) is not int:\n        raise TypeError(\"Input must be an exact integer type.\")\n    return (number % 2) != 0"}
{"task_id": "Mbpp/404", "solution": "import math\nfrom decimal import Decimal\nfrom fractions import Fraction\n\ndef minimum(a: object, b: object) -> object:\n    \"\"\"\n    Finds the minimum of two objects, handling NaN, infinities, and incomparable types.\n    \"\"\"\n\n    def _is_nan(obj: object) -> bool:\n        \"\"\"Detects if an object represents NaN (float or Decimal).\"\"\"\n        if isinstance(obj, float):\n            return math.isnan(obj)\n        if isinstance(obj, Decimal):\n            return obj.is_nan()\n        return False\n\n    def _is_numeric(obj: object) -> bool:\n        \"\"\"Heuristic to check if an object is a common numeric type.\"\"\"\n        return isinstance(obj, (int, float, Decimal, Fraction))\n\n    a_is_numeric = _is_numeric(a)\n    b_is_numeric = _is_numeric(b)\n\n    a_is_nan_val = _is_nan(a)\n    b_is_nan_val = _is_nan(b)\n\n    # 1. NaN handling as per design:\n    if a_is_nan_val and b_is_nan_val:\n        return a\n    if a_is_nan_val and b_is_numeric and not b_is_nan_val:\n        return b\n    if b_is_nan_val and a_is_numeric and not a_is_nan_val:\n        return a\n\n    # 2. Otherwise, attempt comparison:\n    # Try a <= b\n    comparison_ab_conclusive = False\n    comparison_ab_result = None\n\n    try:\n        raw_compare_result = (a <= b)\n        if isinstance(raw_compare_result, bool):\n            comparison_ab_result = raw_compare_result\n            comparison_ab_conclusive = True\n    except Exception:\n        # Any exception during comparison means it failed to be conclusive\n        pass\n\n    if comparison_ab_conclusive:\n        if comparison_ab_result is True:\n            return a\n        else:  # comparison_ab_result is False\n            return b\n    else:  # a <= b was not conclusive (NotImplemented, non-boolean, or raised exception)\n        # Attempt b <= a\n        comparison_ba_conclusive = False\n        comparison_ba_result = None\n        try:\n            raw_compare_result_rev = (b <= a)\n            if isinstance(raw_compare_result_rev, bool):\n                comparison_ba_result = raw_compare_result_rev\n                comparison_ba_conclusive = True\n        except Exception:\n            # Any exception during comparison means it failed to be conclusive\n            pass\n\n        if comparison_ba_conclusive:\n            if comparison_ba_result is True:\n                return b\n            else:  # comparison_ba_result is False\n                return a\n        else:\n            # Both a <= b and b <= a failed to yield a conclusive boolean result\n            # or raised an exception.\n            raise TypeError(f\"Incomparable types: {type(a)} and {type(b)}\")"}
{"task_id": "Mbpp/409", "solution": "def min_product_tuple(input_list):\n    \"\"\"\n    Computes the minimum product of 2-element numeric tuples in the input list.\n    Raises TypeError or ValueError for invalid inputs as per design.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"input must be a list\")\n    if len(input_list) == 0:\n        raise ValueError(\"input list must not be empty\")\n\n    current_min = None\n\n    for item in input_list:\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise TypeError(\"each item must be a 2-element tuple\")\n        a, b = item\n        if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n            raise TypeError(\"tuple elements must be numeric (int or float)\")\n        product = a * b\n        if current_min is None or product < current_min:\n            current_min = product\n\n    return current_min"}
{"task_id": "Mbpp/412", "solution": "from typing import List\n\ndef remove_odd(numbers: List[int]) -> List[int]:\n    \"\"\"\n    Removes odd numbers from a given list of integers, returning a new list\n    containing only the even numbers in their original relative order.\n\n    Raises:\n        TypeError: If `numbers` is not a list.\n        TypeError: If any element in `numbers` is not an integer.\n\n    Examples:\n        >>> remove_odd([1, 2, 3, 4])\n        [2, 4]\n        >>> remove_odd([])\n        []\n        >>> remove_odd([0, -2, 3])\n        [0, -2]\n        >>> remove_odd((1, 2))\n        Traceback (most recent call last):\n            ...\n        TypeError: numbers must be a list\n        >>> remove_odd([1, 'a', 3])\n        Traceback (most recent call last):\n            ...\n        TypeError: all elements of numbers must be int\n\n    Time complexity: O(n), where n is the number of elements in the input list.\n    Space complexity: O(n) additional space for the returned list in the worst case.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"numbers must be a list\")\n\n    for element in numbers:\n        if not isinstance(element, int):\n            raise TypeError(\"all elements of numbers must be int\")\n\n    even_numbers = []\n    for number in numbers:\n        if number % 2 == 0:\n            even_numbers.append(number)\n\n    return even_numbers"}
{"task_id": "Mbpp/410", "solution": "def min_val(iterable):\n    \"\"\"\n    Finds the minimum numeric value in a given heterogeneous list.\n    It treats ints, floats, and bools as numeric, parses numeric strings, and ignores other types.\n    \"\"\"\n\n    class NumericParser:\n        \"\"\"Parses strings to numeric values, returning success status and the parsed number.\"\"\"\n        def parse(self, s: str) -> (bool, float):\n            try:\n                num = float(s)\n                return True, num\n            except ValueError:\n                return False, 0.0  # Return a dummy value when parsing fails\n\n    found_numeric = False\n    min_value_slot = None\n    integer_only = True\n\n    try:\n        iterator = iter(iterable)\n    except TypeError:\n        raise TypeError(\"min_val: argument is not iterable\")\n\n    parser = NumericParser()\n\n    for el in iterator:\n        current_val = None\n\n        if isinstance(el, bool):\n            current_val = 1 if el else 0\n            # Booleans are treated as integers (0 or 1).\n        elif isinstance(el, int):\n            current_val = el\n            # Integers are processed directly.\n        elif isinstance(el, float):\n            current_val = el\n            integer_only = False  # Presence of a float forces the return type to float.\n        elif isinstance(el, str):\n            success, number = parser.parse(el)\n            if not success:\n                continue  # Ignore strings that cannot be parsed into numbers.\n            current_val = number\n            # If the parsed numeric string represents a non-integer float, set integer_only to False.\n            if not current_val.is_integer():\n                integer_only = False\n        else:\n            continue  # Ignore all other types of elements.\n\n        if current_val is not None:\n            if not found_numeric or current_val < min_value_slot:\n                min_value_slot = float(current_val)  # Store values as float for consistent comparison.\n            found_numeric = True\n\n    if not found_numeric:\n        raise ValueError(\"min_val: no numeric values found in the iterable\")\n\n    if integer_only:\n        return int(min_value_slot)\n    else:\n        return float(min_value_slot)"}
{"task_id": "Mbpp/413", "solution": "import collections.abc\n\ndef extract_nth_element(list_of_tuples, n):\n    \"\"\"\n    Extracts the nth element from each tuple in a given list of tuples, with robust validation.\n    Raises TypeError or IndexError for invalid inputs or out-of-range access.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n is not an integer\")\n\n    if not isinstance(list_of_tuples, collections.abc.Iterable):\n        raise TypeError(\"list_of_tuples must be an iterable of tuples\")\n\n    result = []\n    for i, tuple_i in enumerate(list_of_tuples):\n        if not isinstance(tuple_i, tuple):\n            raise TypeError(f\"element at index {i} is not a tuple\")\n\n        len_tuple = len(tuple_i)\n        # Resolve target_index as per design, handling negative n explicitly.\n        if n >= 0:\n            target_index = n\n        else:\n            target_index = len_tuple + n\n\n        if target_index < 0 or target_index >= len_tuple:\n            raise IndexError(f\"tuple at index {i} is too short\")\n\n        result.append(tuple_i[target_index])\n\n    return result"}
{"task_id": "Mbpp/418", "solution": "from typing import Any, Optional, List\n\ndef Find_Max(items: List[Any]) -> Optional[Any]:\n    \"\"\"\n    Find_Max(items: list[Any]) -> Optional[Any]\n\n    Parameters\n    - items: list[Any] -- the list to inspect. Must be a Python list instance.\n\n    Returns\n    - Optional[Any] -- the first element with maximum len(element) among elements\n      that support len(); returns None if items is empty.\n\n    Raises\n    - TypeError -- if items is not a list, or if items contains no elements that\n      support len().\n\n    Behavior\n    - Validates input with isinstance(items, list).\n    - Performs a single left-to-right scan, using len() on elements that do not\n      raise TypeError. Elements that raise on len() are ignored.\n    - Tracks current maximum length and first-seen element with that length; updates\n      only when a strictly larger length is found to preserve stability on ties.\n    - Does not mutate the input list or its elements.\n    - Complexity: O(n) time, O(1) extra space.\n    \"\"\"\n    if not isinstance(items, list):\n        raise TypeError(\"items must be a list\")\n\n    if len(items) == 0:\n        return None\n\n    best_elem: Optional[Any] = None\n    best_len: int = -1\n    found_length_capable: bool = False\n\n    for elem in items:\n        try:\n            l = len(elem)\n        except TypeError:\n            continue\n\n        found_length_capable = True\n        if l > best_len:\n            best_len = l\n            best_elem = elem\n\n    if not found_length_capable:\n        raise TypeError(\"no length-capable elements found in items\")\n\n    return best_elem"}
{"task_id": "Mbpp/415", "solution": "import math\nfrom typing import List, Tuple\n\ndef max_Product(arr: List[int]) -> Tuple[int, int]:\n    \"\"\"\n    Finds a pair with the highest product from a given array of integers.\n    The function performs a single pass to identify the two largest and two smallest elements.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"input is not a list\")\n    if len(arr) < 2:\n        raise ValueError(\"need at least two elements\")\n    for e in arr:\n        if not isinstance(e, int):\n            raise TypeError(\"element is not an integer\")\n\n    max1 = float('-inf')\n    max2 = float('-inf')\n    min1 = float('inf')\n    min2 = float('inf')\n\n    for x in arr:\n        # Update largest two numbers\n        if x >= max1:\n            max2 = max1\n            max1 = x\n        elif x > max2:\n            max2 = x\n\n        # Update smallest two numbers\n        if x <= min1:\n            min2 = min1\n            min1 = x\n        elif x < min2:\n            min2 = x\n\n    product_max_pair = max1 * max2\n    product_min_pair = min1 * min2\n\n    if product_max_pair >= product_min_pair:\n        result_pair = (max1, max2)\n    else:\n        result_pair = (min1, min2)\n\n    return tuple(sorted(result_pair))"}
{"task_id": "Mbpp/424", "solution": "def extract_rear(input_tuple: tuple) -> list:\n    \"\"\"Extracts the last character of each string in the input tuple, handling empty strings.\"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError('argument must be tuple')\n\n    result = []\n    for element in input_tuple:\n        if not isinstance(element, str):\n            raise TypeError('tuple elements must be strings')\n\n        if element == \"\":\n            result.append(\"\")\n        else:\n            result.append(element[-1])\n\n    return result"}
{"task_id": "Mbpp/421", "solution": "def concatenate_tuple(tuple_input, delimiter='-') -> str:\n    \"\"\"Joins elements of a tuple into a string, separated by a delimiter. Each element and the delimiter are converted to strings.\"\"\"\n    if not isinstance(tuple_input, tuple):\n        raise TypeError('first argument must be a tuple')\n    if not tuple_input:\n        return ''\n    delim_str = str(delimiter)\n    element_strs = [str(e) for e in tuple_input]\n    return delim_str.join(element_strs)"}
{"task_id": "Mbpp/426", "solution": "def validate_input(iterable) -> None:\n    \"\"\"Validates that the input is an iterable and not None.\n\n    Raises TypeError if the input is None or not iterable.\n    \"\"\"\n    if iterable is None:\n        raise TypeError(\"iterable must be an iterable and not None\")\n    try:\n        iter(iterable)\n    except TypeError:\n        raise TypeError(\"iterable must be an iterable and not None\")\n\ndef filter_oddnumbers(iterable):\n    \"\"\"Filters an iterable, returning a list of only the odd integer elements.\n\n    Booleans are excluded, and order is preserved.\n\n    Args:\n        iterable: Any Python iterable (e.g., list, tuple, set, range, generator).\n\n    Returns:\n        A list containing only the odd integer elements from the input iterable.\n\n    Examples:\n        >>> filter_oddnumbers([1, 2, 3, 4, 5])\n        [1, 3, 5]\n        >>> filter_oddnumbers((i for i in range(6)))\n        [1, 3, 5]\n        >>> filter_oddnumbers([True, 1, False, 3])\n        [1, 3]\n        >>> filter_oddnumbers([])\n        []\n    \"\"\"\n    validate_input(iterable)\n\n    odd_numbers = []\n    for item in iterable:\n        # Check for bool explicitly as bool is a subclass of int.\n        if isinstance(item, bool):\n            continue\n        if isinstance(item, int) and item % 2 != 0:\n            odd_numbers.append(item)\n    return odd_numbers"}
{"task_id": "Mbpp/425", "solution": "def count_element_in_list(outer_list, element):\n    \"\"\"\n    Counts the number of sublists within outer_list that contain a particular element.\n    Non-list outer_list inputs raise TypeError. Non-iterable sublists or None are skipped.\n    \"\"\"\n    if not isinstance(outer_list, list):\n        raise TypeError(\"outer_list must be a list\")\n\n    count = 0\n    for sublist in outer_list:\n        try:\n            if element in sublist:\n                count += 1\n        except TypeError:\n            # Catches TypeError for non-iterable sublists (e.g., None, int, float)\n            # or for custom objects where 'in' is not defined or raises errors.\n            continue\n    return count"}
{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n: int) -> float:\n    if not isinstance(n, int):\n        raise TypeError(\"n must be int\")\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n\n    t = n * (n + 1) // 2\n    sum_cubes = t * t\n    average = sum_cubes / n\n\n    return average"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n):\n    \"\"\"Calculates the sum of the cubes of the first n even natural numbers.\n\n    Uses the closed-form formula: sum_{k=1..n} (2k)^3 = 2 * (n * (n + 1))**2\n\n    Args:\n        n (int): number of first even natural numbers (must be a non-negative integer)\n\n    Returns:\n        int: the sum of cubes of the first n even natural numbers\n\n    Raises:\n        TypeError: if n is not an int\n        ValueError: if n is negative\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    return 2 * (n * (n + 1))**2"}
{"task_id": "Mbpp/419", "solution": "def round_and_sum(numbers: list[float | int]) -> int:\n    \"\"\"\n    Rounds numbers in a list, sums them, and multiplies by list length, then prints and returns the result.\n    Raises TypeError if any element is not int or float.\n    \"\"\"\n    if not numbers:\n        print(0)\n        return 0\n\n    # Validate that all elements are int or float\n    for x in numbers:\n        if not isinstance(x, (int, float)):\n            raise TypeError(\"All elements must be int or float\")\n\n    # Perform streaming accumulation of rounded numbers\n    total_sum = 0\n    for num in numbers:\n        total_sum += int(round(num))\n\n    list_length = len(numbers)\n    final_result = total_sum * list_length\n\n    print(final_result)\n    return final_result"}
{"task_id": "Mbpp/414", "solution": "def overlapping(seq1, seq2):\n    \"\"\"\n    Checks if any value in seq1 exists in seq2.\n    Uses hash-based checks where possible, falling back to pairwise comparison for unhashable items.\n    \"\"\"\n    list_seq2 = []\n    set_for_hash_check = None\n    can_use_hash_for_seq2 = True\n\n    # Step 1: Prepare seq2. Materialize it into a list for potential nested-loop fallback.\n    # Also attempt to build a set for efficient hash-based checks.\n    if isinstance(seq2, (set, frozenset)):\n        list_seq2 = list(seq2)  # Materialize for potential nested loop fallback if seq1 items are unhashable\n        set_for_hash_check = seq2  # Use original set directly for hash checks\n    else:\n        temp_set = set()\n        for y in seq2:\n            list_seq2.append(y)\n            try:\n                temp_set.add(y)\n            except TypeError:\n                can_use_hash_for_seq2 = False\n        set_for_hash_check = temp_set\n\n    # Step 2: Iterate seq1 and check for overlaps with prepared seq2.\n    seq1_iterator = iter(seq1)\n\n    # Flag to indicate if we've committed to nested-loop for the rest of seq1.\n    # This happens if seq2 had unhashable elements, or an x from seq1 is found to be unhashable.\n    use_nested_loop_fallback = not can_use_hash_for_seq2\n\n    for x in seq1_iterator:\n        if use_nested_loop_fallback:\n            # We are already in nested-loop mode (either seq2 had unhashables, or a previous x from seq1 was unhashable)\n            for y in list_seq2:\n                if x == y:\n                    return True\n        else:\n            # Try hash-based check using set_for_hash_check\n            try:\n                if x in set_for_hash_check:\n                    return True\n            except TypeError:\n                # Current x from seq1 is unhashable. Switch to nested-loop mode for current x and all subsequent xs.\n                use_nested_loop_fallback = True\n                for y in list_seq2:\n                    if x == y:\n                        return True\n    return False"}
{"task_id": "Mbpp/427", "solution": "import re\nfrom datetime import datetime\n\n_ISO_DATE_RE = re.compile(r'^\\d{4}-\\d{2}-\\d{2}$')\n\ndef _validate_type(date_str: object) -> None:\n    \"\"\"Validates that the input is a string.\"\"\"\n    if not isinstance(date_str, str):\n        raise TypeError(f\"date_str must be str, got: {repr(date_str)}\")\n\ndef _validate_regex(date_str: str) -> None:\n    \"\"\"Validates that the date string matches the YYYY-MM-DD format regex.\"\"\"\n    if not _ISO_DATE_RE.match(date_str):\n        raise ValueError(f\"Invalid date format: {date_str}\")\n\ndef _parse(date_str: str) -> datetime:\n    \"\"\"Parses the date string into a datetime object, validating calendrical correctness.\"\"\"\n    try:\n        return datetime.strptime(date_str, '%Y-%m-%d')\n    except ValueError:\n        raise ValueError(f\"Invalid date: {date_str}\")\n\ndef _format(dt: datetime) -> str:\n    \"\"\"Formats a datetime object into the DD-MM-YYYY string format.\"\"\"\n    return dt.strftime('%d-%m-%Y')\n\ndef change_date_format(date_str: str) -> str:\n    \"\"\"Converts a date string from 'YYYY-MM-DD' to 'DD-MM-YYYY' format.\n    Ensures input type and format are valid, and the date is calendrically correct.\n\n    Examples:\n    - change_date_format('2023-01-05') -> '05-01-2023'\n    - change_date_format('2020-02-29') -> '29-02-2020'  # valid leap-year\n    - change_date_format('2019-02-29') -> raises ValueError(\"Invalid date: 2019-02-29\")\n    - change_date_format('23-1-5') -> raises ValueError(\"Invalid date format: 23-1-5\")\n    - change_date_format(20230105) -> raises TypeError(\"date_str must be str, got: 20230105\")\n    \"\"\"\n    _validate_type(date_str)\n    _validate_regex(date_str)\n    dt = _parse(date_str)\n    return _format(dt)"}
{"task_id": "Mbpp/429", "solution": "def and_tuples(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Computes the elementwise bitwise AND of corresponding integer elements from two tuples.\n\n    Parameters:\n        a (tuple): The first tuple of integers.\n        b (tuple): The second tuple of integers.\n\n    Returns:\n        tuple: A new tuple where each element is the bitwise AND of the corresponding elements from a and b.\n\n    Raises:\n        TypeError: If a or b is not a tuple, or if any element in a or b is not an integer.\n        ValueError: If a and b do not have the same length.\n\n    Examples:\n        >>> and_tuples((1, 2), (3, 0)) == (1 & 3, 2 & 0) # Expected (1, 0)\n        True\n        >>> and_tuples((10, 4, 6, 9), (5, 2, 3, 3)) == (0, 0, 2, 1)\n        True\n    \"\"\"\n    if not isinstance(a, tuple):\n        raise TypeError(\"a must be a tuple\")\n    if not isinstance(b, tuple):\n        raise TypeError(\"b must be a tuple\")\n\n    if len(a) != len(b):\n        raise ValueError(\"a and b must have the same length\")\n\n    result = []\n    for i in range(len(a)):\n        val_a = a[i]\n        val_b = b[i]\n\n        if not isinstance(val_a, int):\n            raise TypeError(\"a must be a tuple of ints\")\n        if not isinstance(val_b, int):\n            raise TypeError(\"b must be a tuple of ints\")\n\n        result.append(val_a & val_b)\n\n    return tuple(result)"}
{"task_id": "Mbpp/433", "solution": "import math\n\ndef check_greater(arr, num):\n    \"\"\"Check whether num is strictly greater than every element in arr.\n\n    Returns True iff for every element e in arr, num > e.\n    Returns True for an empty arr (vacuous truth).\n    If num is NaN or any element in arr is NaN, returns False.\n\n    Parameters:\n    - arr: iterable of numeric values\n    - num: numeric value\n\n    Examples:\n    >>> check_greater([1, 2, 3], 4)\n    True\n    >>> check_greater([1, 2, 3], 3)\n    False\n    >>> check_greater([], 0)\n    True\n    >>> check_greater([1, 2, float('nan')], 5)\n    False\n    \"\"\"\n    def _is_nan(val):\n        try:\n            return math.isnan(val)\n        except TypeError:\n            return False\n\n    if _is_nan(num):\n        return False\n\n    for element in arr:\n        if _is_nan(element):\n            return False\n        if num <= element:\n            return False\n\n    return True"}
{"task_id": "Mbpp/432", "solution": "class Parameter:\n    \"\"\"Lightweight holder for parameter metadata.\"\"\"\n    def __init__(self, name, value):\n        self.name = name\n        self.value = value\n        self.type_name = type(value).__name__\n\nclass Validator:\n    \"\"\"Encapsulates validation logic.\"\"\"\n    def validate_numeric(self, param: Parameter) -> None:\n        \"\"\"Raises TypeError if param.value is not int or float.\"\"\"\n        if not isinstance(param.value, (int, float)):\n            raise TypeError(f\"'{param.name}' must be numeric (int or float), but got {param.type_name}.\")\n\n    def validate_non_negative(self, param: Parameter) -> None:\n        \"\"\"Raises ValueError if param.value < 0.\"\"\"\n        if param.value < 0:\n            raise ValueError(f\"'{param.name}' must be non-negative, but got {param.value}.\")\n\nclass Result:\n    \"\"\"Container for computed median value.\"\"\"\n    def __init__(self, median: float):\n        self.median = float(median)\n\ndef median_trapezium(a, b, c) -> float:\n    \"\"\"\n    Calculates the median length (mid-segment) of a trapezium using the formula (a + b) / 2.\n    Inputs 'a', 'b', and 'c' must be numeric (int or float). 'a' and 'b' must also be non-negative.\n    'c' is validated but not used in the computation.\n    Raises TypeError if any input is non-numeric, ValueError if 'a' or 'b' are negative.\n    Returns the median length as a float.\n    Examples:\n    >>> median_trapezium(15, 25, 35)\n    20.0\n    >>> assert median_trapezium(15,25,35) == 20\n    \"\"\"\n    validator = Validator()\n\n    param_a = Parameter('a', a)\n    param_b = Parameter('b', b)\n    param_c = Parameter('c', c)\n\n    validator.validate_numeric(param_a)\n    validator.validate_numeric(param_b)\n    validator.validate_numeric(param_c)\n\n    validator.validate_non_negative(param_a)\n    validator.validate_non_negative(param_b)\n\n    median_value = (param_a.value + param_b.value) / 2\n    result = Result(median_value)\n    return result.median"}
{"task_id": "Mbpp/436", "solution": "def neg_nos(numbers: list) -> list:\n    \"\"\"\n    Returns a new list containing only the negative numbers from the input list, preserving their order.\n    The function filters for numbers strictly less than zero.\n\n    Note: This implementation assumes `numbers` is an iterable of comparable numeric types.\n    \"\"\"\n    negative_numbers = []\n    for number in numbers:\n        if number < 0:\n            negative_numbers.append(number)\n    return negative_numbers"}
{"task_id": "Mbpp/428", "solution": "def shell_sort(array, gapSequence='knuth', in_place=True) -> list:\n    \"\"\"Sorts an array using the Shell Sort algorithm.\n\n    Shell sort is an in-place comparison sort that uses a sequence of gaps\n    to sort elements far apart, then reduces the gap until it's 1 (standard insertion sort).\n    It is not a stable sort; the relative order of equal elements is not guaranteed.\n\n    Args:\n        array (list): The list of elements to be sorted. Must be indexable and elements comparable.\n        gapSequence (str, optional): The sequence of gaps to use.\n                                     'knuth' (default) uses 3*h + 1 sequence.\n                                     'half' uses n // 2, then successive halving.\n        in_place (bool, optional): If True (default), sorts the array in-place and returns it.\n                                   If False, returns a new sorted list (shallow copy).\n\n    Returns:\n        list: The sorted list. Either the original array (if in_place=True) or a new list.\n\n    Raises:\n        TypeError: If `array` is not an indexable sequence or its elements are not mutually comparable.\n        ValueError: If an unknown `gapSequence` is provided.\n\n    Complexity (approximate, depends on gap sequence):\n        'knuth': Time: O(N log^2 N) to O(N^(4/3)) on average. Space: O(1) (in-place).\n        'half': Time: O(N^2) in worst-case. Space: O(1) (in-place).\n\n    Examples:\n        >>> shell_sort([3, 1, 4, 2])\n        [1, 2, 3, 4]\n        >>> shell_sort([12, 23, 4, 5, 3, 2, 12, 81, 56, 95])\n        [2, 3, 4, 5, 12, 12, 23, 56, 81, 95]\n    \"\"\"\n\n    class Validator:\n        \"\"\"Handles input array and element comparability validation.\"\"\"\n        def validate_array(self, arr):\n            \"\"\"Checks if the array is indexable and supports length queries.\"\"\"\n            try:\n                n = len(arr)\n                if n > 0:\n                    _ = arr[0]  # Attempt to access an element to ensure indexability.\n            except TypeError:\n                raise TypeError(f\"shell_sort expects an indexable sequence (e.g., list); got {type(arr)}.\")\n            return True\n\n        def validate_elements_comparable(self, arr):\n            \"\"\"Checks if elements within the array are mutually comparable.\"\"\"\n            n = len(arr)\n            if n <= 1:\n                return True\n            try:\n                # Attempt a comparison between the first two elements.\n                _ = arr[0] < arr[1]\n            except (TypeError, Exception) as e:\n                raise TypeError(f\"Elements are not mutually comparable; shell_sort requires elements that support '<'/'<=' (encountered: {e}).\")\n            return True\n\n    class ShellSortInternal:\n        \"\"\"Encapsulates the Shell Sort algorithm logic, gap generation, and gapped insertion.\"\"\"\n        def _generate_gaps_knuth(self, n):\n            \"\"\"Generates Knuth sequence gaps (1, 4, 13, 40, ...).\"\"\"\n            gaps = []\n            h = 1\n            while h < n:\n                gaps.append(h)\n                h = 3 * h + 1\n            return gaps # Gaps are generated in ascending order.\n\n        def _generate_gaps_half(self, n):\n            \"\"\"Generates gaps by repeatedly halving the array length (n//2, n//4, ...).\"\"\"\n            gaps = []\n            gap = n // 2\n            while gap > 0:\n                gaps.append(gap)\n                gap //= 2\n            return gaps # Gaps are generated in descending order.\n\n        def _insertion_with_gap(self, arr, start, gap):\n            \"\"\"Performs gapped insertion sort on a sub-array defined by start and gap.\"\"\"\n            for i in range(start + gap, len(arr), gap):\n                temp = arr[i]\n                j = i\n                while j >= gap and arr[j - gap] > temp:\n                    arr[j] = arr[j - gap]\n                    j -= gap\n                arr[j] = temp\n\n        def _sort_array_with_gaps(self, arr, gap_sequence_type):\n            \"\"\"Orchestrates gap generation and multiple gapped insertion passes.\"\"\"\n            n = len(arr)\n            gaps = []\n            if gap_sequence_type == 'knuth':\n                gaps = self._generate_gaps_knuth(n)\n                gap_iterator = reversed(gaps) # Iterate gaps in reverse order from largest to smallest.\n            elif gap_sequence_type == 'half':\n                gaps = self._generate_gaps_half(n)\n                gap_iterator = gaps # Iterate gaps as generated (already descending).\n            else:\n                raise ValueError(f\"Invalid gapSequence: '{gap_sequence_type}'. Must be 'knuth' or 'half'.\")\n\n            for gap in gap_iterator:\n                for start in range(gap):\n                    self._insertion_with_gap(arr, start, gap)\n            return arr\n\n    # --- Main shell_sort function execution ---\n    validator = Validator()\n    validator.validate_array(array)\n\n    n = len(array)\n    if n <= 1:\n        # For empty or single-element arrays, return the original reference.\n        # This handles both in_place=True and in_place=False for trivial cases.\n        return array\n\n    validator.validate_elements_comparable(array)\n\n    # Prepare the array to be sorted based on the in_place flag.\n    arr_to_sort = list(array) if not in_place else array\n\n    shell_sorter = ShellSortInternal()\n    return shell_sorter._sort_array_with_gaps(arr_to_sort, gapSequence)"}
{"task_id": "Mbpp/435", "solution": "def last_Digit(n):\n    \"\"\"\n    Finds the last decimal digit of a given number, handling integers, floats, and negative values.\n    Floats are truncated towards zero before finding the last digit.\n    \"\"\"\n    integer_part = int(n)\n    absolute_integer_part = abs(integer_part)\n    return absolute_integer_part % 10"}
