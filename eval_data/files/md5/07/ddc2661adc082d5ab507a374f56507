{"task_id": "Mbpp/430", "solution": "def parabola_directrix(a, b, c):\n    \"\"\"\n    Calculates the y-coordinate of the directrix for a parabola y = a*x^2 + b*x + c.\n\n    Mathematical derivation (summary):\n    - Complete the square: y = a(x + b/(2a))^2 + (c - b^2/(4a))\n      Vertex: (h, k) where h = -b/(2a), k = c - b^2/(4a)\n    - For parabola in form (x - h)^2 = 4p(y - k), focal length p = 1/(4a)\n    - Directrix is the horizontal line y = k - p\n      => y = c - b^2/(4a) - 1/(4a)\n\n    Behavior:\n    - If a == 0, raises DegenerateParabolaError since the curve is not a parabola.\n    - Preserves exact Fraction arithmetic if all inputs are fractions.Fraction.\n    - Otherwise computes using normal numeric types (int/float) and returns a numeric result (usually float).\n\n    Time complexity: O(1)\n    Space complexity: O(1)\n    \"\"\"\n    class DegenerateParabolaError(Exception):\n        \"\"\"Exception raised for degenerate parabola (a == 0).\"\"\"\n        def __init__(self, message: str):\n            super().__init__(message)\n\n    if a == 0:\n        raise DegenerateParabolaError(\"a == 0: not a parabola\")\n\n    # Try to preserve exactness for Fraction inputs\n    try:\n        from fractions import Fraction\n        if isinstance(a, Fraction) and isinstance(b, Fraction) and isinstance(c, Fraction):\n            four_a = Fraction(4) * a\n            b_squared = b * b\n            k = c - b_squared / four_a\n            p = Fraction(1) / four_a\n            directrix_y = k - p\n            return directrix_y\n    except Exception:\n        # If Fraction isn't available or any unexpected issue occurs, fall back to numeric path\n        pass\n\n    # Numeric (float/int) computation\n    four_a = 4 * a\n    b_squared = b * b\n\n    k = c - b_squared / four_a\n    p = 1 / four_a\n\n    directrix_y = k - p\n\n    return directrix_y"}
{"task_id": "Mbpp/439", "solution": "from typing import List\n\ndef multiple_to_single(nums: List[int]) -> int:\n    \"\"\"Joins a list of integers into a single integer by concatenating their decimal representations.\n    Returns 0 for an empty list.\n\n    Validation:\n    - nums must be a list\n    - all elements must be int and non-negative\n    \"\"\"\n    if not isinstance(nums, list):\n        raise TypeError(\"nums must be a list of int\")\n\n    if not nums:\n        return 0\n\n    string_parts = []\n    for element in nums:\n        if not isinstance(element, int):\n            raise TypeError(\"all elements of nums must be int\")\n        if element < 0:\n            raise ValueError(\"all elements of nums must be non-negative\")\n        string_parts.append(str(element))\n\n    concatenated_string = \"\".join(string_parts)\n    return int(concatenated_string)"}
{"task_id": "Mbpp/441", "solution": "import math\n\nclass InputValidator:\n    def _is_numeric(self, size):\n        return isinstance(size, (int, float))\n\n    def validate_size(self, size):\n        if not self._is_numeric(size):\n            raise TypeError(\"Size must be an int or float.\")\n        if not math.isfinite(size):\n            raise ValueError(\"Size must be a finite number.\")\n        if size < 0:\n            raise ValueError(\"Size cannot be negative.\")\n\nclass SurfaceAreaCalculator:\n    def surfacearea_cube(self, size):\n        return 6 * size ** 2\n\ndef surfacearea_cube(size):\n    InputValidator().validate_size(size)\n    return SurfaceAreaCalculator().surfacearea_cube(size)"}
{"task_id": "Mbpp/447", "solution": "def cube_nums(numbers: list) -> list:\n    \"\"\"\n    Computes the cube of each element in a list of numbers.\n\n    Raises TypeError if the input is not a list or contains non-numeric elements.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"numbers must be a list of int/float\")\n\n    def _is_numeric(value) -> bool:\n        \"\"\"Checks if a value is an instance of int or float.\"\"\"\n        return isinstance(value, (int, float))\n\n    cubed_numbers = []\n    for num in numbers:\n        if not _is_numeric(num):\n            raise TypeError(\"all elements must be int or float\")\n        cubed_numbers.append(num ** 3)\n\n    return cubed_numbers"}
{"task_id": "Mbpp/450", "solution": "def extract_string(strings, size) -> list:\n    \"\"\"\n    Extracts strings of a specified size from a list, ignoring non-string elements.\n    Raises TypeError or ValueError for invalid input types or values.\n    \"\"\"\n    if not isinstance(strings, list):\n        raise TypeError(\"strings must be a list\")\n    if not isinstance(size, int):\n        raise TypeError(\"size must be an int\")\n    if size < 0:\n        raise ValueError(\"size must be non-negative\")\n\n    result = []\n    for item in strings:\n        if isinstance(item, str) and len(item) == size:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/440", "solution": "import re\n\ndef find_adverb_position(sentence):\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    An adverb is heuristically defined as an alphabetic token ending with \"ly\".\n    \"\"\"\n    # Regex to find contiguous ASCII alphabetic characters.\n    pattern = r\"[A-Za-z]+\"\n\n    for match in re.finditer(pattern, sentence):\n        token_text = match.group()\n        start = match.start()\n        end = match.end()\n\n        token_lower = token_text.lower()\n\n        # Apply the heuristic: check if the lowercased token ends with \"ly\".\n        if token_lower.endswith('ly'):\n            # Return the start index, end index, and the lowercased adverb.\n            return (start, end, token_lower)\n\n    # If no adverb is found after checking all tokens, return the sentinel value.\n    return (-1, -1, '')"}
{"task_id": "Mbpp/446", "solution": "def count_Occurrence(tuple_input, list_input):\n    \"\"\"\n    Count total occurrences of all elements in list_input within tuple_input.\n    Returns the sum of counts for each distinct element from list_input.\n    \"\"\"\n    if not list_input:\n        return 0\n\n    to_count = set(list_input)\n    total = 0\n    for item in tuple_input:\n        if item in to_count:\n            total += 1\n    return total"}
{"task_id": "Mbpp/445", "solution": "def index_multiplication(a, b):\n    \"\"\"\n    Performs index-wise multiplication of tuple elements in two tuple-of-tuples.\n    Returns a new tuple-of-tuples with the per-position products.\n    \"\"\"\n    def _validate_outer_is_tuple(obj, name):\n        if not isinstance(obj, tuple):\n            raise TypeError(f\"{name} must be a tuple of tuples\")\n\n    def _validate_outer_elements_are_tuples(obj, name):\n        for element in obj:\n            if not isinstance(element, tuple):\n                raise TypeError(f\"every element of {name} must be a tuple\")\n\n    def _validate_outer_lengths_match(input_a, input_b):\n        if len(input_a) != len(input_b):\n            raise ValueError(\"outer tuple lengths differ\")\n\n    def _validate_inner_lengths_match(input_a, input_b):\n        for i in range(len(input_a)):\n            if len(input_a[i]) != len(input_b[i]):\n                raise ValueError(f\"inner tuple lengths differ at index {i}\")\n\n    def _compute_products(input_a, input_b):\n        return tuple(\n            tuple(input_a[i][j] * input_b[i][j] for j in range(len(input_a[i])))\n            for i in range(len(input_a))\n        )\n\n    _validate_outer_is_tuple(a, 'a')\n    _validate_outer_is_tuple(b, 'b')\n    _validate_outer_elements_are_tuples(a, 'a')\n    _validate_outer_elements_are_tuples(b, 'b')\n    _validate_outer_lengths_match(a, b)\n    _validate_inner_lengths_match(a, b)\n    return _compute_products(a, b)"}
{"task_id": "Mbpp/448", "solution": "def cal_sum(n):\n    \"\"\"Calculates the sum of Perrin numbers up to n, S(n) = sum_{k=0..n} P(k).\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    P0 = 3\n    P1 = 0\n    P2 = 2\n\n    if n == 0:\n        return P0\n    if n == 1:\n        return P0 + P1\n    if n == 2:\n        return P0 + P1 + P2\n\n    total = P0 + P1 + P2\n    a = P0  # P(k-3)\n    b = P1  # P(k-2)\n    c = P2  # P(k-1)\n\n    for k in range(3, n + 1):\n        nextP = b + a  # P(k) = P(k-2) + P(k-3)\n        total += nextP\n        a, b, c = b, c, nextP\n\n    return total"}
{"task_id": "Mbpp/451", "solution": "def remove_whitespaces(s) -> str:\n    \"\"\"Removes all Unicode whitespace characters from the given string.\n    assert remove_whitespaces(' Google    Flutter ') == 'GoogleFlutter'\n    \"\"\"\n    if s is None:\n        raise TypeError(\"remove_whitespaces: input cannot be None\")\n\n    return ''.join([char for char in s if not char.isspace()])"}
{"task_id": "Mbpp/453", "solution": "def sumofFactors(n: int) -> int:\n    \"\"\"\n    Calculates the sum of even factors of a given positive integer n.\n    Raises TypeError if n is not an int, ValueError if n < 1.\n    \"\"\"\n    from math import isqrt\n\n    class _Validator:\n        \"\"\"Internal utility for validating function inputs.\"\"\"\n        @staticmethod\n        def validate_type(n_val):\n            if not isinstance(n_val, int):\n                raise TypeError(\"Input must be an integer.\")\n\n        @staticmethod\n        def validate_range(n_val):\n            if n_val < 1:\n                raise ValueError(\"Input must be a positive integer (>= 1).\")\n\n    class _DivisorCalculator:\n        \"\"\"Internal utility for summing divisors.\"\"\"\n        @staticmethod\n        def sum_divisors(m_val: int) -> int:\n            s = 0\n            # Iterate up to the square root of m to find divisors.\n            for i in range(1, isqrt(m_val) + 1):\n                if m_val % i == 0:\n                    j = m_val // i\n                    s += i\n                    if j != i:\n                        s += j\n            return s\n\n    _Validator.validate_type(n)\n    _Validator.validate_range(n)\n\n    # If n is odd or n is 1, it has no even factors.\n    if n % 2 != 0 or n == 1:\n        return 0\n\n    # For an even number n, its even factors are 2 times the factors of n/2.\n    # So, sum of even factors of n = 2 * (sum of all factors of n/2).\n    m = n // 2\n    sum_of_m_divisors = _DivisorCalculator.sum_divisors(m)\n\n    return 2 * sum_of_m_divisors"}
{"task_id": "Mbpp/454", "solution": "import re\n\n# Module-level constants as per design\nPATTERN: str = r\"\\b\\w*z\\w*\\b\"\nFLAGS: int = 0  # Case-sensitive matching\n\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"\n    Checks if the input string contains at least one whole word with a lowercase 'z'.\n    The matching is case-sensitive and uses regex word boundaries.\n    \"\"\"\n    if not text:\n        return False\n\n    match = re.search(PATTERN, text, FLAGS)\n    return bool(match)"}
{"task_id": "Mbpp/457", "solution": "def Find_Min(list_of_sublists):\n    \"\"\"\n    Finds the sublist with the minimum length from a list of sublists.\n    Returns the first such sublist if multiple have the minimum length, or [] if the input is empty.\n    \"\"\"\n    if not list_of_sublists:\n        return []\n\n    min_ref = list_of_sublists[0]\n    min_len = len(min_ref)\n\n    for i in range(1, len(list_of_sublists)):\n        current_sublist = list_of_sublists[i]\n        current_len = len(current_sublist)\n\n        if current_len < min_len:\n            min_len = current_len\n            min_ref = current_sublist\n\n    return min_ref"}
{"task_id": "Mbpp/456", "solution": "from typing import List\n\ndef reverse_string_list(input_list: List[str]) -> List[str]:\n    \"\"\"\n    Reverses each string in a given list of string values.\n    Validates input types and returns a new list with reversed strings.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"input_list must be a list\")\n\n    reversed_strings = []\n    for i, s in enumerate(input_list):\n        if not isinstance(s, str):\n            raise TypeError(f\"element at index {i} is not a string\")\n        reversed_strings.append(s[::-1])\n    return reversed_strings"}
{"task_id": "Mbpp/455", "solution": "class InputValidator:\n    @staticmethod\n    def validate_type(month_number):\n        \"\"\"Validates that month_number is an integer.\"\"\"\n        if not isinstance(month_number, int):\n            raise TypeError(f\"month_number must be int; got {type(month_number).__name__}\")\n\n    @staticmethod\n    def validate_range(month_number: int):\n        \"\"\"Validates that month_number is within the range 1-12.\"\"\"\n        if not (1 <= month_number <= 12):\n            raise ValueError(f\"month_number must be in 1..12 inclusive; got {month_number}\")\n\nclass MonthChecker:\n    MONTHS_31 = {1, 3, 5, 7, 8, 10, 12}\n\n    @staticmethod\n    def _is_31_day(month_number: int) -> bool:\n        \"\"\"Checks if the given month number corresponds to a 31-day month.\"\"\"\n        return month_number in MonthChecker.MONTHS_31\n\ndef check_monthnumb_number(month_number: int) -> bool:\n    \"\"\"\n    Checks if the given month number corresponds to a 31-day month in the Gregorian calendar.\n    Raises TypeError if month_number is not an int, or ValueError if not in 1..12.\n    \"\"\"\n    InputValidator.validate_type(month_number)\n    InputValidator.validate_range(month_number)\n    return MonthChecker._is_31_day(month_number)"}
{"task_id": "Mbpp/459", "solution": "def remove_uppercase(input_str: str) -> str:\n    \"\"\"\n    Remove all characters from input_str for which c.isupper() is True.\n    It preserves the relative order of the remaining characters.\n    \"\"\"\n    return ''.join(ch for ch in input_str if not ch.isupper())"}
{"task_id": "Mbpp/458", "solution": "import math\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation failures.\"\"\"\n    pass\n\nclass NumericValidator:\n    \"\"\"Provides static methods for numeric validation.\"\"\"\n    @staticmethod\n    def isNumeric(value):\n        \"\"\"Checks if a value is an int or float.\"\"\"\n        return isinstance(value, (int, float))\n\n    @staticmethod\n    def isFinite(value):\n        \"\"\"Checks if a numeric value is finite (not NaN or Infinity).\"\"\"\n        return math.isfinite(value)\n\n    @staticmethod\n    def isNonNegative(value):\n        \"\"\"Checks if a numeric value is non-negative.\"\"\"\n        return value >= 0\n\n    @staticmethod\n    def validateDimensions(length, width):\n        \"\"\"Validates length and width for numeric, finite, and non-negative properties.\"\"\"\n        if length is None or width is None:\n            raise ValidationError(\"Missing parameter: length or width must be provided.\")\n\n        if not NumericValidator.isNumeric(length):\n            raise ValidationError(f\"Non-numeric value for parameter: length (got {type(length).__name__}).\")\n        if not NumericValidator.isNumeric(width):\n            raise ValidationError(f\"Non-numeric value for parameter: width (got {type(width).__name__}).\")\n\n        if not NumericValidator.isFinite(length):\n            raise ValidationError(f\"Non-finite value for parameter: length (got {length}).\")\n        if not NumericValidator.isFinite(width):\n            raise ValidationError(f\"Non-finite value for parameter: width (got {width}).\")\n\n        if not NumericValidator.isNonNegative(length):\n            raise ValidationError(f\"Negative dimension for parameter: length (got {length}).\")\n        if not NumericValidator.isNonNegative(width):\n            raise ValidationError(f\"Negative dimension for parameter: width (got {width}).\")\n\nclass Rectangle:\n    \"\"\"Represents a rectangle and computes its area.\"\"\"\n    def __init__(self, length, width):\n        self.length = length\n        self.width = width\n\n    def area(self):\n        \"\"\"Calculates the area of the rectangle.\"\"\"\n        return self.length * self.width\n\ndef rectangle_area(length, width):\n    \"\"\"\n    Calculates the area of a rectangle given its length and width.\n    Validates inputs and raises ValidationError on invalid dimensions.\n    \"\"\"\n    NumericValidator.validateDimensions(length, width)\n    rectangle = Rectangle(length, width)\n    return rectangle.area()"}
{"task_id": "Mbpp/460", "solution": "from typing import Iterable, Any, List\n\ndef _first_element_or_raise(inner: Iterable) -> Any:\n    \"\"\"Returns the first element of an iterable, or raises ValueError if empty.\"\"\"\n    inner_iter = iter(inner)\n    try:\n        return next(inner_iter)\n    except StopIteration:\n        raise ValueError(\"Encountered an empty inner iterable.\")\n\ndef Extract(iterables: Iterable[Iterable]) -> list:\n    \"\"\"\n    Extracts the first element from each sublist (inner iterable) in an iterable of iterables.\n\n    Args:\n        iterables: An iterable where each element is itself an iterable.\n\n    Returns:\n        A concrete list containing the first element of each inner iterable.\n\n    Raises:\n        TypeError: If the 'iterables' parameter is not an iterable.\n        ValueError: If any of the inner iterables are empty.\n    \"\"\"\n    try:\n        _ = iter(iterables)\n    except TypeError:\n        raise TypeError(\"Expected an iterable of iterables for parameter 'iterables'.\")\n\n    return [_first_element_or_raise(inner) for inner in iterables]"}
{"task_id": "Mbpp/465", "solution": "def drop_empty(d: dict) -> dict:\n    \"\"\"Drops items from a dictionary where values are considered empty.\n    Values are empty if None or if they support len() and len() == 0.\n    \"\"\"\n    if not isinstance(d, dict):\n        raise TypeError(\"drop_empty: input must be dict\")\n\n    def is_empty(value) -> bool:\n        \"\"\"Helper to determine if a value is empty (None or has length 0).\"\"\"\n        if value is None:\n            return True\n        try:\n            return len(value) == 0\n        except TypeError:\n            # Values without __len__ (e.g., numbers, booleans) are not considered empty.\n            return False\n\n    result = {}\n    for key, value in d.items():\n        if not is_empty(value):\n            result[key] = value\n    return result"}
{"task_id": "Mbpp/462", "solution": "def combinations_list(input_list):\n    if not isinstance(input_list, list):\n        raise TypeError(\"input_list must be a list\")\n\n    n = len(input_list)\n    result = []\n    # The empty subset is always the first element.\n    result.append([])\n\n    # Iterate through each element to consider it as the highest-indexed element in a new group of subsets.\n    for h in range(n):\n        limit = 1 << h  # Calculates 2^h, which is the number of possible masks for elements with index less than h.\n        # Iterate through all possible bitmasks 'm' for elements with indices from 0 to h-1.\n        for m in range(limit):\n            subset_s = []\n            # Add the element at index 'h' first, as it's the highest index for this group.\n            subset_s.append(input_list[h])\n            # Iterate through elements with indices from h-1 down to 0, adding them if their corresponding bit in 'm' is set.\n            for i in range(h - 1, -1, -1):\n                if ((m >> i) & 1) == 1:\n                    subset_s.append(input_list[i])\n            result.append(subset_s)\n\n    return result"}
{"task_id": "Mbpp/463", "solution": "from typing import Union\n\nNumber = Union[int, float]\n\ndef max_subarray_product(arr: list[Number]) -> Number:\n    \"\"\"Finds the maximum product of a contiguous subarray in the given array.\n    Uses a single-pass dynamic approach tracking current max and min products.\n    Raises ValueError for empty input.\n\n    Time complexity: O(n)\n    Space complexity: O(1)\n    \"\"\"\n    if not arr:\n        raise ValueError(\"input list must be non-empty\")\n\n    if len(arr) == 1:\n        return arr[0]\n\n    curr_max = arr[0]\n    curr_min = arr[0]\n    global_max = arr[0]\n    has_float = isinstance(arr[0], float)\n\n    for x in arr[1:]:\n        # Track if any float is encountered for return type preservation.\n        if isinstance(x, float):\n            has_float = True\n\n        # Preserve previous curr_max to compute curr_min correctly.\n        temp_curr_max = curr_max\n\n        # Consider current element alone, or extend previous subarray by multiplying.\n        curr_max = max(x, temp_curr_max * x, curr_min * x)\n        curr_min = min(x, temp_curr_max * x, curr_min * x)\n\n        # Update the global maximum product found so far.\n        global_max = max(global_max, curr_max)\n\n    return float(global_max) if has_float else global_max"}
{"task_id": "Mbpp/470", "solution": "import numbers\n\ndef add_pairwise(values: tuple) -> tuple:\n    \"\"\"\n    Computes the pairwise sum of neighboring numeric elements from the input tuple.\n    Raises TypeError for invalid input type or non-numeric elements; returns an empty tuple if there are fewer than two elements.\n    \"\"\"\n    if not isinstance(values, tuple):\n        raise TypeError(\"Input 'values' must be a tuple.\")\n\n    for element in values:\n        if not isinstance(element, numbers.Number):\n            raise TypeError(\"All elements in the input tuple must be numeric.\")\n\n    if len(values) < 2:\n        return ()\n\n    results = []\n    for i in range(len(values) - 1):\n        results.append(values[i] + values[i+1])\n\n    return tuple(results)"}
{"task_id": "Mbpp/468", "solution": "def max_product(array):\n    \"\"\"Compute and return maximum product of elements of any strictly increasing subsequence of 'array'.\n    Returns None if array is empty.\n    \"\"\"\n    if not array:\n        return None\n\n    n = len(array)\n    dp = list(array)  # dp[i] stores the maximum product of an increasing subsequence ending at array[i]\n\n    for i in range(n):\n        for j in range(i):\n            if array[j] < array[i]:\n                # If array[i] can extend the subsequence ending at array[j]\n                # Then dp[i] can be the product of that subsequence (dp[j]) multiplied by array[i]\n                dp[i] = max(dp[i], dp[j] * array[i])\n\n    return max(dp)"}
{"task_id": "Mbpp/472", "solution": "from typing import List\n\ndef check_Consecutive(lst: List[int]) -> bool:\n    \"\"\"Check if a list of integers contains consecutive numbers without duplicates.\n\n    Args:\n        lst: A Python list of integers.\n\n    Returns:\n        True if lst contains consecutive integers (order-independent) with no duplicates.\n        False if lst is empty or not consecutive.\n\n    Raises:\n        TypeError: If lst is not of type list, or any element in lst is not an int.\n    \"\"\"\n    if type(lst) is not list:\n        raise TypeError(\"lst must be of type list\")\n\n    n = len(lst)\n\n    if n == 0:\n        return False\n\n    if n == 1:\n        if not isinstance(lst[0], int):\n            raise TypeError(\"all elements of lst must be int\")\n        return True\n\n    seen = set()\n    min_val = None\n    max_val = None\n\n    for e in lst:\n        if not isinstance(e, int):\n            raise TypeError(\"all elements of lst must be int\")\n        if e in seen:\n            return False  # Duplicates detected\n        seen.add(e)\n\n        if min_val is None or e < min_val:\n            min_val = e\n        if max_val is None or e > max_val:\n            max_val = e\n\n    return (max_val - min_val + 1) == n"}
{"task_id": "Mbpp/471", "solution": "from typing import Iterable\n\ndef find_remainder(arr: Iterable[int], n: int) -> int:\n    \"\"\"Finds the product of array elements modulo n and returns a value in [0, n-1].\n\n    Parameters:\n    - arr: Iterable[int] -- iterable of integers (list, tuple, generator, etc.)\n    - n: int -- positive modulus\n\n    Returns:\n    - int: (product of elements in arr) % n\n\n    Notes:\n    - Treats empty iterable as product = 1 (returns 1 % n).\n    - Short-circuits and returns 0 immediately if any element % n == 0.\n    - Elements are reduced modulo n before multiplication to avoid large intermediates.\n    \"\"\"\n    def _modular_multiply(acc: int, val: int, n: int) -> int:\n        return (acc * val) % n\n\n    def reduce_element(x: int, n: int) -> int:\n        return x % n\n\n    acc = 1 % n\n\n    for element in arr:\n        current_element_mod_n = reduce_element(element, n)\n        if current_element_mod_n == 0:\n            return 0\n        acc = _modular_multiply(acc, current_element_mod_n, n)\n\n    return acc"}
{"task_id": "Mbpp/473", "solution": "def tuple_intersection(collection_a: Iterable[Tuple[Any, ...]], collection_b: Iterable[Tuple[Any, ...]]) -> List[Tuple[Any, ...]]:\n    \"\"\"\n    Finds the intersection of tuples from two collections, treating tuples as unordered multisets.\n    Returns a list of representative tuples from collection_a, ordered by their first appearance\n    in collection_a, that have an equivalent tuple in collection_b.\n    \"\"\"\n    # Validate inputs and build lookup from collection_a: normalized_key -> first-seen representative\n    a_lookup: Dict[Tuple[Any, ...], Tuple[Any, ...]] = {}\n    try:\n        for item_a in collection_a:\n            if not isinstance(item_a, tuple):\n                raise TypeError(\"All elements of collection_a must be tuples\")\n            normalized_key_a = tuple(sorted(item_a))\n            if normalized_key_a not in a_lookup:\n                a_lookup[normalized_key_a] = item_a\n    except TypeError:\n        raise\n    except Exception as exc:\n        raise TypeError(\"Failed to normalize tuples in collection_a\") from exc\n\n    # Build set of normalized keys from collection_b\n    b_keys_set: Set[Tuple[Any, ...]] = set()\n    try:\n        for item_b in collection_b:\n            if not isinstance(item_b, tuple):\n                raise TypeError(\"All elements of collection_b must be tuples\")\n            normalized_key_b = tuple(sorted(item_b))\n            b_keys_set.add(normalized_key_b)\n    except TypeError:\n        raise\n    except Exception as exc:\n        raise TypeError(\"Failed to normalize tuples in collection_b\") from exc\n\n    # Accumulate results in deterministic order based on first appearance in collection_a\n    result: List[Tuple[Any, ...]] = []\n    seen_in_result: Set[Tuple[Any, ...]] = set()\n\n    try:\n        for item_a in collection_a:\n            # item_a validated in the first pass; reuse normalization\n            normalized_key_a = tuple(sorted(item_a))\n            if normalized_key_a in b_keys_set and normalized_key_a not in seen_in_result:\n                representative = a_lookup[normalized_key_a]\n                result.append(representative)\n                seen_in_result.add(normalized_key_a)\n    except Exception as exc:\n        raise TypeError(\"Failed during intersection computation\") from exc\n\n    return result"}
{"task_id": "Mbpp/474", "solution": "def replace_char(s: str, old: str, new: str) -> str:\n    \"\"\"Replaces all occurrences of a character in a string with another character.\"\"\"\n    # Short-circuit if old and new characters are the same.\n    if old == new:\n        return s\n\n    # Return an empty string if the input string is empty.\n    if not s:\n        return \"\"\n\n    result_chars = []\n    for char in s:\n        if char == old:\n            result_chars.append(new)\n        else:\n            result_chars.append(char)\n\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/475", "solution": "from typing import List, Tuple, Any\nimport numbers\n\ndef sort_counter(counter: dict) -> List[Tuple[Any, numbers.Number]]:\n    \"\"\"Sorts a dictionary by its values in descending order, preserving original insertion order for ties.\n\n    Args:\n        counter (dict): The dictionary to be sorted.\n\n    Returns:\n        List[Tuple[Any, numbers.Number]]: A list of (key, value) tuples sorted by value descending.\n\n    Raises:\n        TypeError: If `counter` is not a dict or if any value in `counter` is not a numeric type.\n\n    Complexity: Time: O(n log n), Space: O(n) where n is the number of items in the dictionary.\n    Examples:\n        assert sort_counter({'Math':81, 'Physics':83, 'Chemistry':87})==[('Chemistry', 87), ('Physics', 83), ('Math', 81)]\n        assert sort_counter({'a': 2, 'b': 1}) == [('a', 2), ('b', 1)]\n        assert sort_counter({'x': 5, 'y': 5, 'z': 1}) == [('x', 5), ('y', 5), ('z', 1)]\n        assert sort_counter({}) == []\n    \"\"\"\n    if not isinstance(counter, dict):\n        raise TypeError(\"counter must be a dict\")\n\n    for v in counter.values():\n        if not isinstance(v, numbers.Number):\n            raise TypeError(\"all values must be numeric\")\n\n    # Create a list of (key, value) tuples from the dictionary items.\n    # This ensures a stable sort and does not mutate the original dictionary.\n    items = list(counter.items())\n\n    # Sort the items by value in descending order.\n    # Python's built-in sorted() is stable, preserving the original order for equal values.\n    result = sorted(items, key=lambda item: item[1], reverse=True)\n\n    return result"}
{"task_id": "Mbpp/476", "solution": "class Validator:\n    @staticmethod\n    def get_iterator_or_raise(values):\n        \"\"\"Returns an iterator for the given values, or raises TypeError if not iterable.\"\"\"\n        try:\n            return iter(values)\n        except TypeError:\n            raise TypeError(\"big_sum expects an iterable\")\n\n    @staticmethod\n    def require_first_element(iterator):\n        \"\"\"Returns the first element from an iterator, or raises ValueError if the iterator is empty.\"\"\"\n        try:\n            return next(iterator)\n        except StopIteration:\n            raise ValueError(\"big_sum requires at least one element\")\n\n    @staticmethod\n    def raise_addable_error():\n        \"\"\"Raises a TypeError indicating elements are not addable.\"\"\"\n        raise TypeError(\"elements are not addable\")\n\ndef big_sum(values):\n    \"\"\"\n    Finds the sum of the largest and smallest value in a given array.\n    \"\"\"\n    iterator = Validator.get_iterator_or_raise(values)\n    first = Validator.require_first_element(iterator)\n\n    min_val = max_val = first\n\n    for x in iterator:\n        if x < min_val:\n            min_val = x\n        if x > max_val:\n            max_val = x\n\n    try:\n        return min_val + max_val\n    except TypeError:\n        Validator.raise_addable_error()"}
{"task_id": "Mbpp/477", "solution": "def is_lower(s):\n    \"\"\"\n    is_lower(s)\n\n    Return a lowercase copy of the input string using Python's Unicode-aware str.lower().\n\n    Parameters\n    - s (str): Input string to convert to lowercase. Must be an instance of str; passing None or a non-str type will raise TypeError.\n\n    Returns\n    - str: A new string equal to s.lower(). The function does not mutate the input object.\n\n    Raises\n    - TypeError: If s is None or not an instance of str.\n\n    Examples\n    - assert is_lower('Hello') == 'hello'\n    - assert is_lower('123!@#AbC') == '123!@#abc'\n\n    Complexity\n    - Time: O(n) where n == len(s)\n    - Auxiliary space: O(1) excluding the returned string\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError('s must be a str')\n    return s.lower()"}
{"task_id": "Mbpp/478", "solution": "def remove_lowercase(s: str) -> str:\n    result_chars = []\n    i = 0\n    n = len(s)\n\n    while i < n:\n        char = s[i]\n        # Check if the current character is an ASCII lowercase letter.\n        if 'a' <= char <= 'z':\n            # Skip this entire contiguous run of lowercase letters.\n            while i < n and 'a' <= s[i] <= 'z':\n                i += 1\n        else:\n            result_chars.append(char)\n            i += 1\n\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/554", "solution": "def Split(numbers: list[int]) -> list[int]:\n    \"\"\"Filters a list of integers, returning a new list containing only the odd ones while preserving their order.\n    It assumes the input 'numbers' is a list where all elements are integers.\"\"\"\n\n    result = []\n    for num in numbers:\n        if num % 2 != 0:\n            result.append(num)\n    return result"}
{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"Calculates (sum_{k=1}^n k^3) - (sum_{k=1}^n k) using closed-form arithmetic.\n\n    It computes the sum of the first n natural numbers (S1 = n*(n+1)//2)\n    and returns S1 * (S1 - 1).\n\n    Note: This implementation assumes `n` is an integer >= 0. It does not\n    perform explicit type or range validation; callers should validate\n    inputs if needed.\n\n    Example:\n        difference(3) -> 30\n    \"\"\"\n    s1 = n * (n + 1) // 2\n    return s1 * (s1 - 1)"}
{"task_id": "Mbpp/479", "solution": "import math\nimport numbers\n\ndef first_Digit(number):\n    \"\"\"\n    Finds the first digit of a given number. Supports int, float, and numbers.Real.\n    Returns the most significant digit (0-9) after handling absolute value and scaling.\n\n    Examples:\n    >>> first_Digit(123)\n    1\n    >>> first_Digit(0.00456)\n    4\n    >>> first_Digit(-45.6)\n    4\n    >>> first_Digit(0)\n    0\n    \"\"\"\n    # Validate input type and finiteness as specified in design context.\n    if not isinstance(number, numbers.Real):\n        raise TypeError(\"Input must be a real number.\")\n\n    if math.isnan(number):\n        raise ValueError(\"Input cannot be NaN.\")\n    if math.isinf(number):\n        raise ValueError(\"Input cannot be infinite.\")\n\n    # Handle zero explicitly as required by design.\n    if number == 0:\n        return 0\n\n    # Use absolute value as specified in design.\n    num_abs = abs(number)\n\n    # Normalize the number into the range [1.0, 10.0) using iterative scaling.\n    while num_abs >= 10.0:\n        num_abs /= 10.0\n\n    while num_abs < 1.0:\n        num_abs *= 10.0\n\n    # Extract the integer part which is the first digit.\n    return int(num_abs)"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr, n) -> int:\n    \"\"\"Counts the number of pairs (i, j) in arr such that arr[i] XOR arr[j] is odd.\n    A XOR B is odd if one number is even and the other is odd.\"\"\"\n    if n < 2:\n        return 0\n\n    even_count = 0\n    odd_count = 0\n\n    for x in arr:\n        if x % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return even_count * odd_count"}
