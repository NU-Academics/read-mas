{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(a, b):\n    \"\"\"\n    Calculates the sum of per-digit absolute differences between two integers.\n    Digits are aligned by the least significant digit, and shorter numbers are\n    padded with leading zeros.\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise TypeError(\"Inputs must be integers.\")\n\n    a_abs = abs(a)\n    b_abs = abs(b)\n\n    # Helper to extract digits with LSB at index 0\n    def _extract_digits_lsb_first(num_val):\n        if num_val == 0:\n            return [0]\n        digits = []\n        while num_val > 0:\n            digits.append(num_val % 10)\n            num_val //= 10\n        return digits\n\n    digits_a = _extract_digits_lsb_first(a_abs)\n    digits_b = _extract_digits_lsb_first(b_abs)\n\n    len_a = len(digits_a)\n    len_b = len(digits_b)\n    max_len = max(len_a, len_b)\n\n    # Pad shorter digit lists with zeros on the higher-order side\n    if len_a < max_len:\n        digits_a.extend([0] * (max_len - len_a))\n    if len_b < max_len:\n        digits_b.extend([0] * (max_len - len_b))\n\n    total_distance = 0\n    for i in range(max_len):\n        total_distance += abs(digits_a[i] - digits_b[i])\n\n    return total_distance"}
{"task_id": "Mbpp/560", "solution": "def union_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Computes the union of elements from two tuples, deduplicates them, and returns them in sorted order.\n    It attempts hash-based deduplication first, falling back to a list-based method if elements are unhashable.\n    \"\"\"\n    # Validate inputs are tuples\n    if not isinstance(a, tuple) or not isinstance(b, tuple):\n        raise TypeError(\"Both inputs must be tuples\")\n\n    unique_elements = []\n    try:\n        # Attempt hash-based deduplication using sets for efficiency\n        unique_elements = list(set(a) | set(b))\n    except TypeError:\n        # Fallback for unhashable elements\n        for item in a:\n            if item not in unique_elements:\n                unique_elements.append(item)\n        for item in b:\n            if item not in unique_elements:\n                unique_elements.append(item)\n\n    # Sort the unique elements. Python's sorted() raises TypeError for incomparable types.\n    try:\n        sorted_unique = sorted(unique_elements)\n    except TypeError as e:\n        raise TypeError(f\"Elements in tuples are not mutually comparable for sorting: {e}\") from e\n\n    return tuple(sorted_unique)"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(input_list: list | None) -> int:\n    \"\"\"Finds the length of the longest top-level element that implements __len__.\n    Returns 0 for None input, an empty list, or if no top-level elements are sized.\n    \"\"\"\n    if input_list is None:\n        return 0\n\n    max_len = 0\n    for element in input_list:\n        if hasattr(element, '__len__'):\n            current_len = len(element)\n            if current_len > max_len:\n                max_len = current_len\n    return max_len"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr, n):\n    \"\"\"\n    Finds the sum of the largest contiguous sublist using Kadane's algorithm.\n    Validates inputs and computes the maximum subarray sum in O(n) time and O(1) space.\n\n    Parameters:\n    - arr: sequence of numeric values (int or float), must be non-empty.\n    - n: expected length of arr (int).\n\n    Returns:\n    - Numeric maximum contiguous subarray sum (int or float).\n\n    Raises:\n    - ValueError: on invalid inputs (n not int, arr not sequence, empty arr, length mismatch, non-numeric elements).\n    \"\"\"\n\n    class _Validator:\n        \"\"\"Internal class to validate input parameters for the maximum subarray sum function.\"\"\"\n        def validate(self, arr_param, n_param):\n            \"\"\"Validates the input array and its expected length, raising ValueError for invalid inputs.\"\"\"\n            if not isinstance(n_param, int):\n                raise ValueError(\"n must be an integer\")\n            if not hasattr(arr_param, '__len__'):\n                raise ValueError(\"arr must be a sequence\")\n            if len(arr_param) == 0:\n                raise ValueError(\"arr must be a non-empty sequence\")\n            if len(arr_param) != n_param:\n                raise ValueError(\"n must equal len(arr)\")\n            for x in arr_param:\n                if not isinstance(x, (int, float)):\n                    raise ValueError(\"arr must contain only numeric (int/float) elements\")\n\n    class _KadaneAlgorithm:\n        \"\"\"Internal class implementing Kadane's algorithm to find the maximum contiguous subarray sum.\"\"\"\n        def compute(self, arr_param):\n            \"\"\"Computes the maximum contiguous subarray sum from a given numeric array.\"\"\"\n            # Initialize current_sum and max_sum with the first element for correct handling of single-element and all-negative arrays.\n            current_sum = arr_param[0]\n            max_sum = arr_param[0]\n\n            for x in arr_param[1:]:\n                current_sum = max(x, current_sum + x)\n                max_sum = max(max_sum, current_sum)\n            return max_sum\n\n    validator = _Validator()\n    validator.validate(arr, n)\n\n    kadane_alg = _KadaneAlgorithm()\n    result = kadane_alg.compute(arr)\n    return result"}
