e, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n\n    Note:\n    * don't change the given array.\n\n    Examples:\n    * sort_array([]) => []\n    * sort_array([5]) => [5]\n    * sort_array([2, 4, 3, 0, 1, 5]) => [0, 1, 2, 3, 4, 5]\n    * sort_array([2, 4, 3, 0, 1, 5, 6]) => [6, 5, 4, 3, 2, 1, 0]\n    \"\"\"\n    if not array:\n        return []\n    \n    if len(array) == 1:\n        return list(array) # Return a copy as per 'don't change the given array' note\n\n    first_val = array[0]\n    last_val = array[-1]\n    \n    sum_first_last = first_val + last_val\n    \n    # Create a copy to sort, as per the requirement \"don't change the given array\"\n    array_copy = list(array)\n    \n    if sum_first_last % 2 != 0:  # Sum is odd, sort ascending\n        array_copy.sort()\n    else:  # Sum is even, sort descending\n        array_copy.sort(reverse=True)\n        \n    return array_copy", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/94": [{"task_id": "HumanEval/94", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"Determines if a given number is prime.\n    Numbers less than or equal to 1 are not prime.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\ndef sum_digits(n: int) -> int:\n    \"\"\"Calculates sum of all digits in a number.\n    Handles non-negative integers.\n    \"\"\"\n    digit_sum = 0\n    # Ensure n is non-negative for summation logic\n    n = abs(n) \n    while n > 0:\n        digit_sum += n % 10\n        n //= 10\n    return digit_sum\ndef skjkasdkd(lst: list[int]) -> int:\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    largest_prime = 0 \n\n    for num in lst:\n        if is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n    \n    return sum_digits(largest_prime)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/15": [{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    >>> string_sequence(0)\n    '0'\n    >>> string_sequence(5)\n    '0 1 2 3 4 5'\n    \"\"\"\n    return ' '.join(map(str, range(n + 1)))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/130": [{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in \n    the last couple centuries. However, what people don't know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8 \n    You are given a non-negative integer number n, you have to a return a list of the \n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n    \n    if n < 0:\n        return []\n\n    memo = {}\n\n    def _is_even(num):\n        \"\"\"Checks if a number is even.\"\"\"\n        return num % 2 == 0\n\n    def _calculate_value(index):\n        \"\"\"Calculates a single Tribonacci value using memoization.\"\"\"\n        if index in memo:\n            return memo[index]\n\n        if index == 0:\n            result = 1.0 # tri(0) = 1 per design context\n        elif index == 1:\n            result = 3.0\n        elif _is_even(index):\n            result = 1.0 + index / 2.0\n        else:  # index is odd\n            # tri(n) = tri(n - 1) + tri(n - 2) + tri(n + 1)\n            val_n_minus_1 = _calculate_value(index - 1)\n            val_n_minus_2 = _calculate_value(index - 2)\n            val_n_plus_1 = _calculate_value(index + 1)\n\n            result = val_n_minus_1 + val_n_minus_2 + val_n_plus_1\n        \n        memo[index] = result\n        return result\n\n    trib_sequence = []\n    for i in range(n + 1):\n        trib_sequence.append(_calculate_value(i))\n\n    return trib_sequence", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/83": [{"task_id": "HumanEval/83", "solution": "class InputValidator:\n    @staticmethod\n    def validate_positive_integer(n: int) -> bool:\n        \"\"\"Validate n is positive integer > 0\"\"\"\n        return n > 0\n\n    @staticmethod\n    def check_range(n: int) -> bool:\n        \"\"\"Check n is within safe integer limits\"\"\"\n        return True\nclass MathematicalCalculator:\n    @staticmethod\n    def power(base: int, exponent: int) -> int:\n        \"\"\"Calculate base raised to exponent power\"\"\"\n        return base ** exponent\n\n    @staticmethod\n    def apply_inclusion_exclusion(start_count: int, end_count: int, both_count: int) -> int:\n        \"\"\"Apply inclusion-exclusion principle: start + end - both\"\"\"\n        return start_count + end_count - both_count\nclass DigitCounter:\n    def __init__(self, calculator: MathematicalCalculator):\n        \"\"\"Initialize with mathematical calculator dependency\"\"\"\n        self._calculator = calculator\n\n    def count_starting_with_1(self, n: int) -> int:\n        \"\"\"Count n-digit numbers starting with 1\"\"\"\n        return self._calculator.power(10, n - 1)\n\n    def count_ending_with_1(self, n: int) -> int:\n        \"\"\"Count n-digit numbers ending with 1\"\"\"\n        if n == 1:\n            return 0  # For n=1, numbers are 1-9. Only '1' ends with 1. Handled by main function's special case.\n        return 9 * self._calculator.power(10, n - 2)\n\n    def count_both_start_and_end(self, n: int) -> int:\n        \"\"\"Count n-digit numbers both starting and ending with 1\"\"\"\n        if n == 1:\n            return 1 # Only '1' is both starting and ending with 1 for n=1.\n        return self._calculator.power(10, n - 2)\nclass ResultHandler:\n    @staticmethod\n    def format_result(count: int) -> int:\n        \"\"\"Format and validate final result\"\"\"\n        return count\n\n    @staticmethod\n    def validate_result(count: int) -> bool:\n        \"\"\"Validate result is non-negative integer\"\"\"\n        return count >= 0\ndef starts_one_ends(n: int) -> int:\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    input_validator = InputValidator()\n    math_calculator = MathematicalCalculator()\n    digit_counter = DigitCounter(math_calculator)\n    result_handler = ResultHandler()\n\n    # Input validation (n is positive integer as per problem description)\n    if not input_validator.validate_positive_integer(n):\n        # Assuming valid input as per problem statement, or an error would be raised.\n        # For simplicity and adherence to 'return int', we proceed assuming N is positive.\n        pass\n\n    # Special case for n=1 (single-digit numbers: 1-9)\n    # Only '1' satisfies the condition (starts with 1 AND ends with 1).\n    if n == 1:\n        return result_handler.format_result(1)\n\n    # General case for n > 1\n    count_starts_with_1 = digit_counter.count_starting_with_1(n)\n    count_ends_with_1 = digit_counter.count_ending_with_1(n)\n    count_both_start_and_end = digit_counter.count_both_start_and_end(n)\n\n    # Apply the Inclusion-Exclusion Principle: |A U B| = |A| + |B| - |A intersection B|\n    total_count = math_calculator.apply_inclusion_exclusion(\n        count_starts_with_1,\n        count_ends_with_1,\n        count_both_start_and_end\n    )\n\n    return result_handler.format_result(total_count)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "from typing import List\nclass Position:\n    \"\"\"Represents a position (row, column) in the grid.\"\"\"\n    def __init__(self, row: int, col: int):\n        self._row = row\n        self._column = col\n\n    def get_row(self) -> int:\n        return self._row\n\n    def get_column(self) -> int:\n        return self._column\n\n    def get_neighbors(self, grid_size: int) -> List['Position']:\n        \"\"\"Calculates valid adjacent positions within the grid boundaries.\"\"\"\n        neighbors = []\n        possible_moves = [\n            (-1, 0), (1, 0), (0, -1), (0, 1) # Up, Down, Left, Right\n        ]\n        \n        for dr, dc in possible_moves:\n            new_row, new_col = self._row + dr, self._column + dc\n            if 0 <= new_row < grid_size and 0 <= new_col < grid_size:\n                neighbors.append(Position(new_row, new_col))\n        return neighbors\n\n    def __eq__(self, other: object) -> bool:\n        \"\"\"Compares two Position objects for equality.\"\"\"\n        if not isinstance(other, Position):\n            return NotImplemented\n        return self._row == other._row and self._column == other._column\n    \n    def __hash__(self) -> int:\n        \"\"\"Returns a hash for the Position object.\"\"\"\n        return hash((self._row, self._column))\nclass Grid:\n    \"\"\"Manages the grid structure, values, and provides access to cell information.\"\"\"\n    def __init__(self, grid_data: List[List[int]]):\n        self._cells_values = grid_data\n        self._rows = len(grid_data)\n        self._columns = len(grid_data[0]) if self._rows > 0 else 0\n        # Problem guarantees valid input, so explicit validation calls are omitted.\n\n    def validate_dimensions(self) -> bool:\n        \"\"\"Ensures the grid has N >= 2 rows and columns.\"\"\"\n        return self._rows >= 2 and self._columns == self._rows\n\n    def validate_values(self) -> bool:\n        \"\"\"Ensures values from 1 to N*N appear exactly once.\"\"\"\n        expected_values = set(range(1, self._rows * self._columns + 1))\n        actual_values = set()\n        for r in range(self._rows):\n            for c in range(self._columns):\n                actual_values.add(self._cells_values[r][c])\n        return expected_values == actual_values\n\n    def get_cell(self, row: int, col: int) -> int:\n        \"\"\"Returns the value of the cell at the given row and column.\"\"\"\n        return self._cells_values[row][col]\n\n    def get_neighbors(self, row: int, col: int) -> List[Position]:\n        \"\"\"Returns a list of valid neighbor positions for a given cell.\"\"\"\n        current_pos = Position(row, col)\n        return current_pos.get_neighbors(self.get_size())\n\n    def get_size(self) -> int:\n        \"\"\"Returns the dimension N of the N x N grid.\"\"\"\n        return self._rows\nclass Path:\n    \"\"\"Stores path information and provides lexicographic comparison.\"\"\"\n    def __init__(self):\n        self._values: List[int] = []\n        self._positions: List[Position] = []\n\n    def add_cell(self, value: int, position: Position):\n        \"\"\"Adds a cell's value and position to the path.\"\"\"\n        self._values.append(value)\n        self._positions.append(position)\n\n    def get_values(self) -> List[int]:\n        \"\"\"Returns the list of cell values in the path.\"\"\"\n        return self._values\n\n    def get_length(self) -> int:\n        \"\"\"Returns the current length of the path.\"\"\"\n        return len(self._values)\n\n    def is_lexicographically_smaller(self, other: 'Path') -> bool:\n        \"\"\"Compares this path with another path lexicographically.\"\"\"\n        return self._values < other._values\n\n    def copy(self) -> 'Path':\n        \"\"\"Creates a new Path object with copies of the current path's values and positions.\"\"\"\n        new_path = Path()\n        new_path._values = list(self._values)\n        new_path._positions = list(self._positions)\n        return new_path\nclass PathFinder:\n    \"\"\"Finds the lexicographically minimum path of a given length in a grid.\"\"\"\n    def __init__(self, grid: Grid, k: int):\n        self._grid = grid\n        self._path_length = k\n\n    def find_minimum_path(self) -> List[int]:\n        \"\"\"Iterates through all possible starting cells and finds the minimum path.\"\"\"\n        min_path: Path = None\n        \n        N = self._grid.get_size()\n        \n        for r in range(N):\n            for c in range(N):\n                start_pos = Position(r, c)\n                all_paths_from_start = self._generate_all_paths(start_pos, Path(), self._path_length)\n                \n                for current_path in all_paths_from_start:\n                    if min_path is None:\n                        min_path = current_path\n                    elif current_path.is_lexicographically_smaller(min_path):\n                        min_path = current_path\n        \n        return min_path.get_values() # Problem guarantees a unique answer, so min_path will not be None.\n\n    def _is_valid_move(self, from_pos: Position, to_pos: Position) -> bool:\n        \"\"\"Validates if moving from from_pos to to_pos is possible (i.e., they are neighbors).\"\"\"\n        neighbors = from_pos.get_neighbors(self._grid.get_size())\n        return to_pos in neighbors\n\n    def _generate_all_paths(self, current_pos: Position, current_path_prefix: Path, remaining_steps: int) -> List[Path]:\n        \"\"\"Recursively generates all paths of length k starting from a given position.\"\"\"\n        current_value = self._grid.get_cell(current_pos.get_row(), current_pos.get_column())\n        \n        path_with_current = current_path_prefix.copy()\n        path_with_current.add_cell(current_value, current_pos)\n\n        if remaining_steps == 1:\n            return [path_with_current]\n\n        all_paths_from_here = []\n        for neighbor_pos in current_pos.get_neighbors(self._grid.get_size()):\n            # The _is_valid_move check is implicitly handled by iterating through valid neighbors.\n            sub_paths = self._generate_all_paths(neighbor_pos, path_with_current, remaining_steps - 1)\n            all_paths_from_here.extend(sub_paths)\n        \n        return all_paths_from_here\ndef minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n    \"\"\"\n    grid_obj = Grid(grid)\n    pathfinder = PathFinder(grid_obj, k)\n    return pathfinder.find_minimum_path()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[12, 13, 10, 1], [9, 3, 15, 6], [5, 16, 14, 4], [11, 8, 7, 2]], 12]], "plu