tests": [[[]]]}], "Mbpp/301": [{"task_id": "Mbpp/301", "solution": "def dict_depth(data: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of a dictionary.\n    The depth of an empty dictionary {} is 1, and 1 + the max depth of any nested dictionary.\n    \"\"\"\n    max_nested_depth = 0\n    for value in data.values():\n        if isinstance(value, dict):\n            # Recursively find the depth of nested dictionaries\n            max_nested_depth = max(max_nested_depth, dict_depth(value))\n\n    # The current dictionary level plus the maximum depth found in its nested dictionaries\n    return 1 + max_nested_depth", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/301", "solution": "def dict_depth(data: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting level of dictionary data structures.\n    Returns 0 for an empty dictionary, and 1 for a flat dictionary.\n    \"\"\"\n    # CRITICAL: Input type validation (isinstance) and error raising for 'data' are omitted\n    # as per critical requirements, trusting the caller's input.\n\n    max_current_depth = 0\n    if data:\n        # An non-empty dictionary itself constitutes one level of depth.\n        max_current_depth = 1\n\n        for value in data.values():\n            # FR6: Only dictionary values contribute to further nesting depth.\n            if isinstance(value, dict):\n                # Recursively calculate the depth of nested dictionaries.\n                # Add 1 to account for the current dictionary level being traversed.\n                max_current_depth = max(max_current_depth, 1 + dict_depth(value))\n\n    return max_current_depth", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[{"a": 1, "b": {"c": {"d": {}}}}]], "plus_fail_tests": [[{}]]}], "Mbpp/306": [{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Calculates the maximum sum of an increasing subsequence from prefix until ith index\n    and also including a given kth element which is after i (k > i).\n    All prefix elements in the subsequence must be strictly less than arr[k].\n    \"\"\"\n    if not arr:\n        raise ValueError(\"Input array cannot be empty.\")\n    if n != len(arr):\n        raise ValueError(f\"Provided length n ({n}) does not match array length ({len(arr)}).\")\n    if not (0 <= i < n):\n        raise IndexError(f\"Index i ({i}) is out of bounds for array of length {n}.\")\n    if not (0 <= k < n):\n        raise IndexError(f\"Index k ({k}) is out of bounds for array of length {n}.\")\n    if k <= i:\n        raise ValueError(f\"Index k ({k}) must be greater than index i ({i}).\")\n\n    # dp[j] stores the maximum sum of an increasing subsequence ending at arr[j]\n    # within the prefix arr[0...i].\n    dp = [0] * (i + 1)\n    for j in range(i + 1):\n        dp[j] = arr[j]  # Initialize with the element itself\n        for p in range(j):\n            if arr[p] < arr[j]:\n                dp[j] = max(dp[j], dp[p] + arr[j])\n\n    max_prefix_sum = 0\n    # Find the maximum sum from dp[j] where arr[j] is strictly less than arr[k].\n    for j in range(i + 1):\n        if arr[j] < arr[k]:\n            max_prefix_sum = max(max_prefix_sum, dp[j])\n\n    return max_prefix_sum + arr[k]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"Calculates the maximum sum of an increasing subsequence ending with arr[k].\n    Preceding elements must be from arr[0...i] and strictly less than arr[k].\n    \"\"\"\n    dp = [0] * (i + 1)\n    max_sum_prefix_elements = 0\n\n    for j in range(i + 1):\n        if arr[j] < arr[k]:\n            dp[j] = arr[j]\n            for p in range(j):\n                if arr[p] < arr[j] and arr[p] < arr[k]:\n     