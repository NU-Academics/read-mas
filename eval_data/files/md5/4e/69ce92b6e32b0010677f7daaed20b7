        found_numeric = True\n            elif item > max_numeric:\n                max_numeric = item\n    return max_numeric", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[["3.14", false, 7.5]]]}], "Mbpp/296": [{"task_id": "Mbpp/296", "solution": "def _merge_and_count(left: list, right: list) -> tuple[int, list]:\n    \"\"\"Merges two sorted lists and counts inversions between them.\"\"\"\n    merged_list = []\n    inversions = 0\n    i, j = 0, 0\n    while i < len(left) and j < len(right):\n        if left[i] <= right[j]:\n            merged_list.append(left[i])\n            i += 1\n        else:\n            merged_list.append(right[j])\n            inversions += (len(left) - i)\n            j += 1\n    merged_list.extend(left[i:])\n    merged_list.extend(right[j:])\n    return inversions, merged_list\ndef _merge_sort_and_count(arr: list, start: int, end: int) -> tuple[int, list]:\n    \"\"\"Recursively sorts a sub-array and counts inversions within it.\"\"\"\n    if start >= end:\n        return 0, [arr[start]] if start == end else []\n\n    mid = (start + end) // 2\n    left_inversions, left_sorted = _merge_sort_and_count(arr, start, mid)\n    right_inversions, right_sorted = _merge_sort_and_count(arr, mid + 1, end)\n\n    merge_inversions, merged_sorted = _merge_and_count(left_sorted, right_sorted)\n\n    total_inversions = left_inversions + right_inversions + merge_inversions\n    return total_inversions, merged_sorted\ndef get_Inv_Count(arr: list) -> int:\n    \"\"\"Counts inversions in an array using a modified merge sort algorithm.\"\"\"\n    if not arr:\n        return 0\n    inversions, _ = _merge_sort_and_count(arr, 0, len(arr) - 1)\n    return inversions", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr):\n    \"\"\"\n    Counts the total number of inversions in a given array of integers.\n    An inversion is a pair (i, j) such that i < j and arr[i] > arr[j].\n    \"\"\"\n\n    def _merge_sort_and_count(current_arr):\n        \"\"\"\n        Recursively sorts the array and counts inversions within it.\n        Returns the sorted array and the inversion count.\n        \"\"\"\n        n = len(current_arr)\n        if n <= 1:\n            return current_arr, 0\n\n        mid = n // 2\n        left_half, left_inversions = _merge_sort_and_count(current_arr[:mid])\n        right_half, right_inversions = _merge_sort_and_count(current_arr[mid:])\n\n        merged_array, merge_inversions = _merge_and_count(left_half, right_half)\n\n        total_inversions = left_inversions + right_inversions + merge_inversions\n        return merged_array, total_inversions\n\n    def _merge_and_count(left, right):\n        \"\"\"\n        Merges two sorted arrays and counts inversions between them.\n        Returns the merged sorted array and inversions from the merge step.\n        \"\"\"\n        merged = []\n        inversions = 0\n        i, j = 0, 0\n\n        while i < len(left) and j < len(right):\n            if left[i] <= right[j]:\n                merged.append(left[i])\n                i += 1\n            else:\n                merged.append(right[j])\n                # If left[i] > right[j], all remaining elements in left (from i onwards)\n                # form an inversion with right[j].\n                inversions += (len(left) - i)\n                j += 1\n\n        merged.extend(left[i:])\n        merged.extend(right[j:])\n\n        return merged, inversions\n\n    _, total_inversions = _merge_sort_and_count(arr)\n    return total_inversions", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/297": [{"task_id": "Mbpp/297", "solution": "def flatten_list(nested_list: list) -> list:\n    \"\"\"Flattens a nested list into a single-level list, preserving order.\n    Only list elements are flattened; other iterables are treated as atomic.\"\"\"\n\n    flattened = []\n    for item in nested_list:\n        if isinstance(item, list):\n            flattened.extend(flatten_list(item))\n        else:\n            flattened.append(item)\n    return flattened", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/297", "solution": "def flatten_list(nested_list: list) -> list:\n    \"\"\"\n    Recursively flattens a nested list structure into a single-dimension list.\n    Elements from nested lists are extracted to the top level, preserving order.\n    \"\"\"\n    result = []\n    for item in nested_list:\n        if isinstance(item, list):\n            result.extend(flatten_list(item))\n        else:\n            result.append(item)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/299": [{"task_id": "Mbpp/299", "solution": "def max_aggregate(scores: list[tuple[str, int]]) -> tuple[str | None, int]:\n    \"\"\"Calculates the sum of scores for each name and finds the name with the highest total.\n    Returns (None, 0) if the input list of scores is empty.\"\"\"\n\n    if not scores:\n        return (None, 0)\n\n    aggregated_scores = {}\n    for name, score in scores:\n        aggregated_scores[name] = aggregated_scores.get(name, 0) + score\n\n    highest_name = None\n    highest_score = -float('inf')\n\n    for name, total_score in aggregated_scores.items():\n        if total_score > highest_score:\n            highest_score = total_score\n            highest_name = name\n\n    return (highest_name, highest_score)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/299", "solution": "from collections import defaultdict\nfrom typing import List, Tuple, Optional\ndef max_aggregate(data: List[Tuple[str, int]]) -> Tuple[Optional[str], int]:\n    \"\"\"\n    Calculates the sum of scores for each unique name and returns the name and total score of the individual with the highest aggregate.\n    Returns (None, 0) if the input list is empty.\n    \"\"\"\n    if not data:\n        return (None, 0)\n\n    aggregated_scores = defaultdict(int)\n    for name, score in data:\n        aggregated_scores[name] += score\n\n    max_name: Optional[str] = None\n    max_score: int = 0\n\n    # Find the name with the highest aggregate score. If there's a tie, the first one encountered will be chosen.\n    for name, score in aggregated_scores.items():\n        if max_name is None or score > max_score:\n            max_score = score\n            max_name = name\n\n    return (max_name, max_score)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/300": [{"task_id": "Mbpp/300", "solution": "def count_binary_seq(n: int) -> int:\n    \"\"\"Calculates the count of binary sequences of length 2n where the sum of the first n bits equals the sum of the last n bits.\n    This count is mathematically equivalent to C(2n, n).\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n\n    N = 2 * n\n    K = n\n\n    # Binomial coefficient C(N, K) calculation using an iterative approach.\n    # Optimization: C(N, K) == C(N, N - K)\n    if K > N // 2:\n        K = N - K\n\n    res = 1\n    for i in range(K):\n        res = res * (N - i) // (i + 1)\n\n    return res", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[50]]}, {"task_id": "Mbpp/300", "solution": "import math\ndef combinations(n: int, k: int) -> int:\n    \"\"\"Calculates nCk, the number of ways to choose k items from n.\n    Assumes k is between 0 and n, inclusive.\"\"\"\n    return math.comb(n, k)\ndef count_binary_seq(n: int) -> int:\n    \"\"\"Counts binary sequences of length 2n where sum of first n bits equals sum of last n bits.\n    Thi