rix[0][0]\n\n    # Fill the first row of the DP table\n    for j in range(1, n):\n        dp[0][j] = matrix[0][j] + dp[0][j-1]\n\n    # Fill the first column of the DP table\n    for i in range(1, n):\n        dp[i][0] = matrix[i][0] + dp[i-1][0]\n\n    # Fill the rest of the DP table\n    for i in range(1, n):\n        for j in range(1, n):\n            dp[i][j] = matrix[i][j] + max(dp[i-1][j], dp[i][j-1])\n\n    max_sum = dp[n-1][n-1]\n    path_length = 2 * n - 1\n\n    return float(max_sum) / path_length", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/721", "solution": "from typing import List, Optional\nclass Cell:\n    def __init__(self, row: int, col: int, cost: int) -> None:\n        self.row = row\n        self.col = col\n        self.cost = cost\nclass Path:\n    def __init__(self, initial_cells: Optional[List[Cell]] = None) -> None:\n        self._cells: List[Cell] = []\n        self._total_cost: float = 0.0\n        self._num_cells: int = 0\n        if initial_cells:\n            for cell in initial_cells:\n                self.add_cell(cell)\n\n    # Adds a Cell to the path, updating total cost and cell count.\n    def add_cell(self, cell: Cell) -> None:\n        self._cells.append(cell)\n        self._total_cost += cell.cost\n        self._num_cells += 1\n\n    # Removes the last Cell, updating total cost and cell count for backtracking.\n    def remove_last_cell(self) -> None:\n        if self._cells:\n            removed_cell = self._cells.pop()\n            self._total_cost -= removed_cell.cost\n            self._num_cells -= 1\n\n    # Calculates and returns the average cost of the path. Returns 0.0 if no cells.\n    def get_average(self) -> float:\n        return self._total_cost / self._num_cells if self._num_cells > 0 else 0.0\n\n    # Returns a copy of the list of cells in the path.\n    def get_cells(self) -> List[Cell]:\n        return list(self._cells)\nclass PathCalculator:\n    def __init__(self) -> None:\n        self._matrix: List[List[int]] = []\n        self._N: int = 0\n\n    # Initiates pathfinding to find all paths from top-left to bottom-right.\n    def find_all_paths(self, matrix: List[List[int]]) -> List[Path]:\n        self._matrix = matrix\n        self._N = len(matrix)\n        all_paths: List[Path] = []\n        if self._N == 0:\n            return []\n\n        start_cell = Cell(0, 0, self._matrix[0][0])\n        self._dfs(0, 0, Path([start_cell]), all_paths)\n        return all_paths\n\n    # Recursive Depth-First Search to explore paths.\n    def _dfs(self, row: int, col: int, current_path: Path, all_paths: List[Path]) -> None:\n        if row == self._N - 1 and col == self._N - 1:\n            all_paths.append(Path(current_path.get_cells()))\n            return\n\n        # Move Right\n        if col + 1 < self._N:\n            next_cell = Cell(row, col + 1, self._matrix[row][col + 1])\n            current_path.add_cell(next_cell)\n            self._dfs(row, col + 1, current_path, all_paths)\n            current_path.remove_last_cell()\n\n        # Move Down\n        if row + 1 < self._N:\n            next_cell = Cell(row + 1, col, self._matrix[row + 1][col])\n            current_path.add_cell(next_cell)\n            self._dfs(row + 1, col, current_path, all_paths)\n            current_path.remove_last_cell()\nclass MatrixPathFinder:\n    def __init__(self) -> None:\n        self._path_calculator = PathCalculator()\n\n    # Public API method to find the maximum average path cost.\n    def find_max_average_path(self, matrix: List[List[int]]) -> float:\n        all_paths = self._path_calculator.find_all_paths(matrix)\n\n        max_average = 0.0\n        for path in all_paths:\n            current_average = path.get_average()\n            if current_average > max_average:\n                max_average = current_average\n        return max_average\ndef maxAverageOfPath(matrix: List[List[int]]) -> float:\n    \"\"\"Calculates the maximum average cost of a path in a square matrix.\n    Paths start top-left, end bottom-right, moving only right or down.\n    \"\"\"\n    finder = MatrixPathFinder()\n    return finder.find_max_average_path(matrix)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[[0, 0, 0], [0, 0, 0], [0, 0, -1]]]]}], "Mbpp/725": [{"task_id": "Mbpp/725", "solution": "import re\ndef extract_quotation(text: str) -> list[str]:\n    \"\"\"Extracts all substrings enclosed in double quotation marks from the input string.\n    It processes the string to find matched pairs of double quotes and captures their contents.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input must be a string.\")\n    return re.findall(r'\"([^\"]*)\"', text)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/725", "solution": "import re\ndef extract_quotation(input_string: str) -> list[str]:\n    \"\"\"\n    Extracts all substrings found between double quotation marks in the given string.\n\n    Args:\n        input_string: The string from which to extract quoted values.\n\n    Returns:\n        A list of extracted strings. Returns an empty list if no quoted strings\n        are found.\n\n    Raises:\n        TypeError: If input_string is not of type str.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    return re.findall(r'\\\"([^\\\"]*)\\\"', input_string)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/726": [{"task_id": "Mbpp/726", "solution": "def multiply_elements(data_tuple: tuple) -> tuple:\n    \"\"\"Calculates the product of adjacent elements in a tuple.\n    Returns a new tuple with the products.\n    \"\"\"\n    result = []\n    for i in range(len(data_tuple) - 1):\n        result.append(data_t