]}, {"task_id": "HumanEval/147", "solution": "from typing import List\ndef get_max_triples(n):\n    \"\"\"\n    Given a positive integer `n`, create an array `a` where `a[i] = i*i - i + 1` for `1 <= i <= n`.\n    Return the count of triples `(a[i], a[j], a[k])` with `i < j < k` such that their sum is a multiple of 3.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    # Generate the array 'a' where a[x] = (x+1)*(x+1) - (x+1) + 1 for 0-indexed x.\n    arr = [(x + 1) * (x + 1) - (x + 1) + 1 for x in range(n)]\n\n    # Calculate remainders when each element of arr is divided by 3.\n    remainders = [val % 3 for val in arr]\n\n    # Pre-compute suffix_counts where suffix_counts[r][idx] stores the number of\n    # elements a[k] with k >= idx such that a[k] % 3 == r.\n    suffix_counts = [[0] * (n + 1) for _ in range(3)]\n    for r in range(3):\n        for idx in range(n - 1, -1, -1):\n            suffix_counts[r][idx] = suffix_counts[r][idx + 1]\n            if remainders[idx] == r:\n                suffix_counts[r][idx] += 1\n\n    total_triples_count = 0\n    # Iterate for i from 0 to n-3.\n    for i in range(n - 2):\n        rem_i = remainders[i]\n        # Iterate for j from i+1 to n-2.\n        for j in range(i + 1, n - 1):\n            rem_j = remainders[j]\n\n            # Determine the required remainder for a[k] such that (rem_i + rem_j + rem_k) % 3 == 0.\n            target_rem_k = (3 - (rem_i + rem_j) % 3) % 3\n\n            # Add the count of k's (where k > j) that have the target_rem_k.\n            total_triples_count += suffix_counts[target_rem_k][j + 1]\n\n    return total_triples_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/149": [{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst: list[str]) -> list[str]:\n    \"\"\"Filters a list of strings to retain only even-length strings.\n    It then sorts them by length (ascending), and alphabetically (ascending) for equal-length 