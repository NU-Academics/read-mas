Eval/10": [{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Appends the reverse of the prefix that comes before the longest palindromic suffix.\n    \"\"\"\n    if not string:\n        return \"\"\n\n    longest_palindromic_postfix_len = 0\n    # Iterate from the start to find the longest palindromic suffix.\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            longest_palindromic_postfix_len = len(suffix)\n            break\n\n    prefix_to_reverse = string[:-longest_palindromic_postfix_len]\n    return string + prefix_to_reverse[::-1]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome.\n    It compares the string with its reverse.\n    \"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    It identifies the longest palindromic postfix and appends the reverse of the preceding prefix.\n    \"\"\"\n    if not string:\n        return \"\"\n\n    # Find the longest palindromic postfix\n    longest_palindromic_postfix_index = 0\n    for i in range(len(string)):\n        postfix = string[i:]\n        if is_palindrome(postfix):\n            longest_palindromic_postfix_index = i\n            break\n\n    # The prefix that comes before the palindromic suffix\n    prefix_to_reverse = string[:longest_palindromic_postfix_index]\n\n    # Append the reverse of this prefix to the original string\n    return string + prefix_to_reverse[::-1]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/13": [{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\"Return the greatest common divisor of two integers a and b.\n    This implementation uses the Euclidean algorithm.\"\"\"\n    a = abs(a)\n    b = abs(b)\n\n    while b:\n        a, b = b, a % b\n    return a", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\"Returns the greatest common divisor of two integers a and b.\n    Handles negative inputs and special cases for zero.\n    \"\"\"\n    if a == 0 and b == 0:\n        return 0\n\n    abs_a = abs(a)\n    abs_b = abs(b)\n\n    while abs_b:\n        abs_a, abs_b = abs_b, abs_a % abs_b\n    return abs_a", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/14": [{"task_id": "HumanEval/14", "solution": "from typing import List\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\"Return list of all prefixes from shortest to longest of the input string.\n    Handles empty strings by returning an empty list.\n    \"\"\"\n    return [string[0:i+1] for i in range(len(string))]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/14", "solution": "from typing import List\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    prefixes = []\n    for i in range(1, len(string) + 1):\n        prefixes.append(string[:i])\n    return prefixes", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/17": [{"task_id": "HumanEval/17", "solution": "from typing import List\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\" Input to this function is a string representing musical notes in a special ASCII format.\n    Your task is to parse this string and return list of integers corresponding to how many beats does each\n    not last.\n\n    Here is a legend:\n    'o' - whole note, lasts four beats\n    'o|' - half note, lasts two beats\n    '.|' - quater note, lasts one beat\n\n    >>> parse_music('o o| .| o| o| .| .| .| .| o o')\n    [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]\n    \"\"\"\n    NOTE_BEAT_MAP = {\n        'o': 4,   # whole note\n        'o|': 2,  # half note\n        '.|': 1   # quarter note\n    }\n\n    if not music_string:\n        return []\n\n    notes = music_string.split(' ')\n    beat_durations: List[int] = []\n\n    for note in notes:\n        # Unrecognized notes are skipped as exceptions are forbidden per critical requirement.\n        if note in NOTE_BEAT_MAP:\n            beat_durations.append(NOTE_BEAT_MAP[note])\n    return beat_durations", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/17", "solution": "from typing import List\nclass MusicParserException(Exception):\n    \"\"\"Base exception for music parser errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass InvalidNoteError(MusicParserException):\n    \"\"\"Exception raised for an unrecognized note symbol.\"\"\"\n    def __init__(self, message: str, note_symbol: str, position: int):\n        super().__init__(message)\n        self.note_symbol = note_symbol\n        self.position = position\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\" Input to this function is a string representing musical notes in a special ASCII format.\n    Your task is to parse this string and return list of integers corresponding to how many beats does each\n    not last.\n\n    Here is a legend:\n    'o' - whole note, lasts four beats\n    'o|' - half note, lasts two beats\n    '.|' - quater note, lasts one beat\n\n    >>> parse_music('o o| .| o| o| .| .| .| .| o o')\n    [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]\n    \"\"\"\n\n    # Note mapping based on business rules, prioritizing longer symbols for greedy matching.\n    NOTE_MAP = {\n        'o|': 2, # Half note\n        '.|': 1, # Quarter note\n        'o': 4,  # Whole note\n    }\n\n    # Sort symbols by length in descending order to ensure greedy matching.\n    sorted_note_symbols = sorted(NOTE_MAP.keys(), key=len, reverse=True)\n\n    beats: List[int] = []\n    i = 0\n    while i < len(music_string):\n        # Skip any whitespace characters as per the doctest example\n        if music_string[i].isspace():\n            i += 1\n            continue\n\n        matched = False\n        for symbol in sorted_note_symbols:\n            if music_string.startswith(symbol, i):\n                beats.append(NOTE_MAP[symbol])\n                i += len(symbol)\n                matched = True\n                break\n\n        if not matched:\n            # If it's not a space and not a recognized note, then it's an invalid symbol.\n            unrecognized_start = i\n            unrecognized_end = i + 1\n            # Find the longest possible unrecognized sequence for better error reporting\n            # Stop if we hit whitespace or a known note symbol\n            while unrecognized_end <= len(music_string) and \\\n                  not music_string[unrecognized_end-1].isspace() and \\\n                  not any(music_string.startswith(s, unrecognized_end) for s in sorted_note_symbols):\n                unrecognized_end += 1\n\n            unrecognized_symbol = music_string[unrecognized_start:unrecognized_end]\n            raise InvalidNoteError(\n                f\"Unrecognized note symbol '{unrecognized_symbol}' at position {unrecognized_start}.\",\n                unrecognized_symbol,\n                unrecognized_start\n            )\n\n    return beats", "base_status": "pass", "plus_status": "p