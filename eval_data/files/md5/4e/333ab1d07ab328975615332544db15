n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n        return max_depth\n\n    if not paren_string.strip():\n        return []\n\n    groups = paren_string.split(' ')\n    result = []\n    for group in groups:\n        result.append(_calculate_group_depth(group))\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/6", "solution": "from typing import List\nclass ParenthesesParser:\n    \"\"\"\n    A utility class to calculate the deepest nesting level of parentheses\n    within a single string group.\n    \"\"\"\n    def calculate_depth(self, group_string: str) -> int:\n        current_depth = 0\n        max_depth = 0\n        for char in group_string:\n            if char == '(':\n                current_depth += 1\n            elif char == ')':\n                # Only decrement if current_depth > 0 to avoid negative depth.\n                if current_depth > 0:\n                    current_depth -= 1\n            max_depth = max(max_depth, current_depth)\n        return max_depth\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"\n    Parses a string with space-separated parenthesis groups to find the deepest nesting level for each.\n    Returns a list of integers representing these maximum depths.\n    \"\"\"\n    if not paren_string:\n        return []\n\n    results: List[int] = []\n    parser = ParenthesesParser()\n    groups = paren_string.split(' ')\n\n    for group in groups:\n        if group: # Process non-empty groups only, as per design specification.\n            results.append(parser.calculate_depth(group))\n    return results", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/7": [{"task_id": "HumanEval/7", "solution": "from typing import List\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]