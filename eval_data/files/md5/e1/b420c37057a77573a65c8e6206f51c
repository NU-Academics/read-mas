{"task_id": "HumanEval/29", "solution": "from typing import List\ndef filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\"\n    Filters a list of strings, returning only those that start with a given prefix.\n\n    This function iterates through the input list of strings and checks if each string\n    begins with the specified prefix. The comparison is case-sensitive.\n    The relative order of the matching strings is preserved in the output list.\n\n    Args:\n        strings: A list of string objects to be filtered.\n        prefix: The string prefix to match against.\n\n    Returns:\n        A new list containing all strings from the input 'strings' list that\n        begin with the specified 'prefix'. Returns an empty list if no matches\n        are found or if the input 'strings' list is empty.\n        If 'prefix' is an empty string (''), a copy of the original 'strings'\n        list is returned, as all strings technically start with an empty prefix.\n\n    Examples:\n        >>> filter_by_prefix(['apple', 'banana', 'apricot', 'grape'], 'ap')\n        ['apple', 'apricot']\n        >>> filter_by_prefix(['hello', 'world', 'heat'], 'h')\n        ['hello', 'heat']\n        >>> filter_by_prefix(['cat', 'dog', 'cow'], 'z')\n        []\n        >>> filter_by_prefix([], 'a')\n        []\n        >>> filter_by_prefix(['test', 'toast'], '')\n        ['test', 'toast']\n        >>> filter_by_prefix(['Python', 'pythonic'], 'python') # Case-sensitive\n        ['pythonic']\n    \"\"\"\n    return [s for s in strings if s.startswith(prefix)]"}
{"task_id": "HumanEval/30", "solution": "import logging\nfrom typing import List, Union, Dict, Any\nfrom fastapi import FastAPI, HTTPException, status, Request\nfrom fastapi.exceptions import RequestValidationError\nfrom pydantic import BaseModel, Field\ndef get_positive(numbers_list: List[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\"\n    Filters a list of numbers, returning a new list containing only those\n    numbers that are strictly positive (i.e., greater than zero).\n    \"\"\"\n    return [num for num in numbers_list if num > 0]"}
{"task_id": "HumanEval/31", "solution": "import math\ndef is_prime(n: int) -> bool:\n    \"\"\"\n    Checks if a given integer n is a prime number.\n\n    Args:\n        n: An integer.\n\n    Returns:\n        True if n is prime, False otherwise.\n    \"\"\"\n    # FR2: Handle n <= 1 (0, 1, and negative numbers are not prime)\n    if n <= 1:\n        return False\n    # FR3: Handle n == 2 (2 is the smallest prime number)\n    if n == 2:\n        return True\n    # FR4: Handle even numbers > 2 (all other even numbers are not prime)\n    if n % 2 == 0:\n        return False\n\n    # FR5, FR6, FR7: Optimized divisibility check for odd numbers >= 3\n    # We only need to check for divisors up to the square root of n.\n    # We can skip even numbers as they are already handled by the n % 2 check.\n    # The limit is calculated as int(sqrt(n)) + 1 to ensure the range includes\n    # the integer part of the square root if it's a perfect square.\n    limit = int(math.sqrt(n)) + 1\n    for i in range(3, limit, 2):  # Iterate through odd numbers starting from 3\n        if n % i == 0:\n            return False  # n is divisible by i, so it's not prime\n\n    return True  # No divisors found, so n is prime"}
{"task_id": "HumanEval/32", "solution": "import math\nfrom scipy.optimize import brentq\ndef poly(coefficients: list[float], x_value: float) -> float:\n    \"\"\"\n    Evaluates a polynomial at a given x_value using Horner's method.\n\n    Args:\n        coefficients (list[float]): Coefficients of the polynomial, where\n                                    coefficients[i] is the coefficient of x^i.\n        x_value (float): The point at which to evaluate the polynomial.\n\n    Returns:\n        float: The value of the polynomial at x_value.\n    \"\"\"\n    result = 0.0\n    # Evaluate polynomial using Horner's method:\n    # P(x) = c0 + c1*x + c2*x^2 + ... + cn*x^n\n    # can be written as P(x) = c0 + x*(c1 + x*(c2 + ... + x*(cn-1 + x*cn)...))\n    # Or, P(x) = (...((cn * x + cn-1) * x + cn-2) * x + ...) + c0\n    # Iterating from highest degree coefficient to lowest for the Horner's scheme:\n    for coeff in reversed(coefficients):\n        result = result * x_value + coeff\n    return result\ndef find_zero(xs: list[float]) -> float:\n    \"\"\"\n    Finds a real root of a polynomial using Brent's method.\n\n    The polynomial coefficients are given in `xs` where `xs[i]` is the\n    coefficient of x^i. The function is guaranteed to receive `xs` with an\n    even number of coefficients (meaning an odd-degree polynomial), and the\n    largest non-zero coefficient ensures a solution exists.\n\n    Args:\n        xs (list[float]): Coefficients of the polynomial.\n\n    Returns:\n        float: A single float representing a root of the polynomial.\n    \"\"\"\n\n    # Define a small tolerance for initial zero checks to account for float precision\n    initial_zero_tolerance = 1e-9\n\n    # 1. Handle Trivial Cases and find an initial bracket [a, b]\n    a = -1.0\n    b = 1.0\n    max_doubling_iterations = 100  # Safety guard to prevent infinite loops\n    max_abs_bound = 1e12  # Max absolute value for bracket limits\n\n    for _ in range(max_doubling_iterations):\n        f_a = poly(xs, a)\n        f_b = poly(xs, b)\n\n        # Check for roots directly at bracket edges or at origin\n        if math.isclose(f_a, 0.0, abs_tol=initial_zero_tolerance):\n            return a\n        if math.isclose(f_b, 0.0, abs_tol=initial_zero_tolerance):\n            return b\n\n        # If poly(xs, 0.0) was exactly 0.0, it would be caught by either f_a or f_b if a=0 or b=0.\n        # But if the initial [-1, 1] range doesn't contain 0, it's good to check again.\n        if a < 0 and b > 0 and math.isclose(poly(xs, 0.0), 0.0, abs_tol=initial_zero_tolerance):\n             return 0.0\n\n\n        # Check if a valid bracket is found (function values have opposite signs)\n        if f_a * f_b < 0:\n            break  # Found a bracket\n\n        # Expand the interval symmetrically\n        a *= 2.0\n        b *= 2.0\n\n        # Safety check for excessively large bounds to prevent numerical issues\n        if abs(a) > max_abs_bound or abs(b) > max_abs_bound:\n            # The problem guarantees a solution, so a bracket should always be found\n            # within reasonable bounds. This break acts as a safeguard.\n            break\n\n    # 2. Apply Brent's Method\n    # Utilizing scipy.optimize.brentq for its robustness and efficiency.\n    # The parameters xtol, rtol, and maxiter are set as per design recommendations.\n    root = brentq(lambda x_val: poly(xs, x_val), a, b, xtol=1e-12, rtol=4e-16, maxiter=500)\n\n    # 3. Return Result\n    return root"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list) -> list:\n    \"\"\"\n    Sorts elements of a list at indices divisible by three,\n    while leaving other elements in their original positions.\n\n    Args:\n        l: A Python list whose elements must be comparable.\n\n    Returns:\n        A new list where elements at indices divisible by three are sorted\n        in ascending order, and all other elements remain unchanged.\n    \"\"\"\n    # FR-2: The function SHALL return a new list l'.\n    # Initialize a new list as a shallow copy of the input list.\n    l_prime = list(l)\n\n    # FR-4: For all indices i in l such that i % 3 == 0, the corresponding\n    # elements l[i] SHALL be extracted into a temporary sublist.\n    # We also need to keep track of their original indices.\n    divisible_by_three_values = []\n    divisible_by_three_indices = []\n\n    # Iterate through the original list to identify elements and their indices\n    # that are divisible by three.\n    for i in range(len(l)):\n        if i % 3 == 0:\n            divisible_by_three_values.append(l[i])\n            divisible_by_three_indices.append(i)\n\n    # FR-4: This temporary sublist SHALL be sorted in ascending order.\n    divisible_by_three_values.sort()\n\n    # FR-4: The sorted elements from the temporary sublist SHALL then be placed\n    # back into l' at their original indices that were divisible by three,\n    # maintaining their relative order from the sorted sublist.\n    # FR-3: For any index i in l such that i % 3 != 0, the element l'[i] SHALL\n    # be identical to l[i]. (This is handled implicitly because l_prime starts\n    # as a copy and only elements at divisible_by_three_indices are changed).\n    for j in range(len(divisible_by_three_indices)):\n        index_to_update = divisible_by_three_indices[j]\n        sorted_value = divisible_by_three_values[j]\n        l_prime[index_to_update] = sorted_value\n\n    return l_prime"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list) -> list:\n    \"\"\"\n    Returns a new list containing only the unique elements from the input list,\n    sorted in ascending order.\n\n    Args:\n        l: The input list from which to extract unique elements.\n           Elements in the list must be hashable and comparable.\n\n    Returns:\n        A new list containing unique elements from `l`, sorted in ascending order.\n\n    Example:\n        >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n        [0, 2, 3, 5, 9, 123]\n        >>> unique([])\n        []\n        >>> unique([1, 1, 1])\n        [1]\n        >>> unique(['b', 'a', 'b', 'c'])\n        ['a', 'b', 'c']\n    \"\"\"\n    # Convert the list to a set to get unique elements.\n    # Sets inherently store only unique elements, handling duplicates efficiently.\n    unique_elements_set = set(l)\n\n    # Convert the set back to a list and sort it.\n    # The sorted() function returns a new sorted list from an iterable,\n    # ensuring the original input list 'l' is not modified.\n    sorted_unique_list = sorted(unique_elements_set)\n\n    return sorted_unique_list"}
{"task_id": "HumanEval/35", "solution": "import typing\ndef max_element(l: list) -> typing.Union[int, float]:\n    \"\"\"\n    Finds the maximum numerical element within a given list.\n\n    This function iterates through the elements of a list to determine\n    the largest numerical value. It supports lists containing integers\n    and floats, including positive, negative, and mixed values.\n    It provides robust error handling for invalid inputs.\n\n    Args:\n        l (list): The input list, expected to contain only numeric elements\n                  (integers or floats).\n\n    Returns:\n        int or float: The single maximum numerical element found in the list.\n\n    Raises:\n        TypeError:\n            - If 'l' is not an instance of list.\n            - If any element within 'l' is not an int or float.\n        ValueError:\n            - If 'l' is an empty list.\n    \"\"\"\n    # REQ-002: If 'l' is not an instance of list, raise a TypeError.\n    if not isinstance(l, list):\n        raise TypeError(\"Input 'l' must be a list.\")\n\n    # REQ-003: If 'l' is an empty list, raise a ValueError.\n    if not l:  # Checks if the list is empty (len(l) == 0)\n        raise ValueError(\"List 'l' cannot be empty.\")\n\n    # REQ-004 & REQ-005 (initialization):\n    # Initialize current_max with the first element of the list.\n    current_max = l[0]\n\n    # REQ-005 (initial element check):\n    # Check if the first element is numeric (int or float).\n    if not isinstance(current_max, (int, float)):\n        raise TypeError(\n            f\"List elements must be numeric. Found type {type(current_max).__name__} at index 0.\"\n        )\n\n    # REQ-004 & REQ-005 (iteration):\n    # Iterate through the rest of the list starting from the second element.\n    # The algorithm should not use the built-in max() function (Constraint 1.2.5).\n    for element in l[1:]:\n        # REQ-005: If 'l' contains any non-numeric element, raise a TypeError.\n        if not isinstance(element, (int, float)):\n            raise TypeError(\n                f\"List elements must be numeric. Found type {type(element).__name__}.\"\n            )\n        # Compare current element with current_max and update if larger.\n        if element > current_max:\n            current_max = element\n\n    # REQ-006: Return the single maximum numerical element.\n    return current_max"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int) -> int:\n    \"\"\"\n    Calculates the total number of times the digit '7' appears in integers less than\n    a given input n that are divisible by either 11 or 13.\n\n    Args:\n        n: The upper bound (exclusive) for the range of integers to check.\n           Integers k are checked such that 1 <= k < n.\n\n    Returns:\n        The accumulated total count of '7's.\n    \"\"\"\n    total_sevens_count = 0\n\n    # Iterate through all positive integers k such that 1 <= k < n.\n    # range(1, n) generates numbers from 1 up to n-1.\n    # If n is 0 or 1, the range will be empty, and the loop won't execute,\n    # correctly returning 0.\n    for k in range(1, n):\n        # Determine if k is divisible by 11 OR k is divisible by 13.\n        if k % 11 == 0 or k % 13 == 0:\n            # Convert k to its string representation.\n            k_str = str(k)\n            # Count occurrences of '7' in the string.\n            sevens_in_k = k_str.count('7')\n            \n            # Add this count to the running total.\n            total_sevens_count += sevens_in_k\n            \n    # Return the accumulated total count of '7's.\n    return total_sevens_count"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list) -> list:\n    \"\"\"\n    Sorts elements at even indices of a list while preserving elements at odd indices.\n\n    The original list is not modified. A new list is returned.\n\n    Args:\n        l: The input list.\n\n    Returns:\n        A new list where elements at even indices are sorted in ascending order\n        and elements at odd indices retain their original values and positions.\n\n    Examples:\n        >>> sort_even([1, 2, 3])\n        [1, 2, 3]\n        >>> sort_even([5, 6, 3, 4])\n        [3, 6, 5, 4]\n        >>> sort_even([])\n        []\n        >>> sort_even([10])\n        [10]\n        >>> sort_even([10, 1, 8, 3, 6])\n        [6, 1, 8, 3, 10]\n    \"\"\"\n    if not l:\n        return []\n\n    even_elements = []\n    for i in range(len(l)):\n        if i % 2 == 0:\n            even_elements.append(l[i])\n\n    even_elements.sort()\n\n    result_list = [None] * len(l)\n    even_sorted_idx = 0\n\n    for i in range(len(l)):\n        if i % 2 == 0:\n            result_list[i] = even_elements[even_sorted_idx]\n            even_sorted_idx += 1\n        else:\n            result_list[i] = l[i]\n\n    return result_list"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str) -> str:\n    \"\"\"\n    Decodes a string previously encoded by encode_cyclic.\n    \"\"\"\n    groups = []\n    # Step 1: Splitting the String into Groups\n    # Use a list comprehension to split the string into groups of 3 characters.\n    # The last group may have fewer than 3 characters.\n    groups = [s[i:i+3] for i in range(0, len(s), 3)]\n\n    decoded_groups = []\n    # Step 2: Processing Each Group (Reverse Cyclic Shift)\n    for group in groups:\n        if len(group) == 3:\n            # For a 3-character group (c2, c3, c1),\n            # reverse the cyclic shift to get (c1, c2, c3).\n            # c1 is group[2], c2 is group[0], c3 is group[1].\n            decoded_group = group[2] + group[0] + group[1]\n            decoded_groups.append(decoded_group)\n        else:\n            # Groups with fewer than 3 characters remain unchanged.\n            decoded_groups.append(group)\n\n    # Step 3: Joining the Processed Groups\n    # Concatenate all processed (decoded) groups to form the final string.\n    return \"\".join(decoded_groups)"}
{"task_id": "HumanEval/39", "solution": "import math\ndef is_prime(num: int) -> bool:\n    if num <= 1:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:  # All other even numbers are not prime\n        return False\n    \n    # Check for divisors from 3 up to sqrt(num), only odd numbers\n    for i in range(3, int(math.sqrt(num)) + 1, 2):\n        if num % i == 0:\n            return False\n            \n    return True\ndef prime_fib(n: int) -> int:\n    count = 0\n    a = 0\n    b = 1\n\n    while True:\n        fib_num = a + b\n        a = b\n        b = fib_num\n\n        if fib_num < 2:  # 0 and 1 are not prime\n            continue\n        \n        if is_prime(fib_num):\n            count = count + 1\n            if count == n:\n                return fib_num"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list) -> bool:\n    \"\"\"\n    Determines if there exist three distinct elements within a given list of integers\n    that sum to zero.\n\n    The function searches for three elements at different indices (i, j, k)\n    such that l[i] + l[j] + l[k] == 0.\n\n    Args:\n        l: A list of integers.\n\n    Returns:\n        True if such a triplet exists, False otherwise.\n    \"\"\"\n    n = len(l)\n\n    # FR2: If the list contains fewer than three elements, it's impossible to form a triplet.\n    if n < 3:\n        return False\n\n    # Sort the list to efficiently use the two-pointer technique.\n    # This takes O(N log N) time.\n    sorted_l = sorted(l)\n\n    # FR2: Iterate through the list with the first pointer 'i' for the first element of the triplet.\n    # We only need to iterate up to n-3 because we need at least two elements\n    # (left_pointer, right_pointer) after 'i'.\n    # This outer loop runs N times.\n    for i in range(n - 2):\n        # Skip duplicate elements for the first pointer to avoid redundant calculations.\n        # This optimization is mainly for performance, not strictly for correctness\n        # for \"any\" triplet, but it helps.\n        if i > 0 and sorted_l[i] == sorted_l[i - 1]:\n            continue\n\n        # Initialize the two pointers for the remaining sub-array.\n        # left_pointer starts immediately after 'i'.\n        left_pointer = i + 1\n        # right_pointer starts at the end of the list.\n        right_pointer = n - 1\n\n        # The target sum for the two pointers (left_pointer, right_pointer)\n        # is the negative of the current element at 'i'.\n        target_sum_for_two_pointers = 0 - sorted_l[i]\n\n        # Use the two-pointer technique to find two elements that sum to target_sum_for_two_pointers.\n        # This inner loop runs N times in the worst case.\n        while left_pointer < right_pointer:\n            current_sum_of_two = sorted_l[left_pointer] + sorted_l[right_pointer]\n\n            # FR2: If a triplet that sums to zero is found.\n            # The indices i, left_pointer, and right_pointer are guaranteed to be distinct\n            # due to how they are initialized and moved (i < left_pointer < right_pointer).\n            if current_sum_of_two == target_sum_for_two_pointers:\n                # Found a triplet (sorted_l[i], sorted_l[left_pointer], sorted_l[right_pointer])\n                # that sums to zero.\n                # FR3: Return True as per requirements.\n                return True\n            # Adjust pointers based on the sum:\n            # If the current sum is too small, move left_pointer to increase the sum.\n            elif current_sum_of_two < target_sum_for_two_pointers:\n                left_pointer += 1\n            # If the current sum is too large, move right_pointer to decrease the sum.\n            else:  # current_sum_of_two > target_sum_for_two_pointers\n                right_pointer -= 1\n\n    # FR2: If the loops complete without finding any triplet that sums to zero,\n    # FR3: return False.\n    return False"}
{"task_id": "HumanEval/41", "solution": "def car_race_collision(n: int) -> int:\n    \"\"\"\n    Calculates the number of collisions between n cars moving left-to-right\n    and n cars moving right-to-left.\n\n    Args:\n        n: The number of cars in each direction (non-negative integer).\n\n    Returns:\n        The total number of collisions.\n\n    Raises:\n        TypeError: If n is not an integer.\n        ValueError: If n is a negative integer.\n    \"\"\"\n    # Input Validation (as per SRS 4.1.5 and System Design 4.1.3)\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Number of cars 'n' cannot be negative.\")\n\n    # Calculation (as per SRS 4.1.4 and System Design 4.1.3)\n    # Each of the 'n' cars moving L->R will collide with each of the 'n' cars moving R->L.\n    # Since cars pass through each other without affecting trajectory, the total collisions\n    # are simply the product of the number of cars in each opposing set.\n    total_collisions = n * n\n\n    # Return Value (as per SRS 4.1.4 and System Design 4.1.3)\n    return total_collisions"}
{"task_id": "HumanEval/42", "solution": "def incr_list(l: list) -> list:\n    \"\"\"\n    Increments each element of a list of numbers by 1 and returns a new list.\n\n    The original list remains unmodified.\n\n    Args:\n        l: A list of numbers (int or float).\n\n    Returns:\n        A new list with each element incremented by 1.\n\n    Examples:\n        >>> incr_list([1, 2, 3])\n        [2, 3, 4]\n        >>> incr_list([5, 3, 5, 2, 3, 3, 9, 0, 123])\n        [6, 4, 6, 3, 4, 4, 10, 1, 124]\n        >>> incr_list([])\n        []\n        >>> incr_list([0.5, -1.0])\n        [1.5, 0.0]\n    \"\"\"\n    return [x + 1 for x in l]"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l: list[int]) -> bool:\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n\n    Args:\n        l (list[int]): A list of integers.\n\n    Returns:\n        bool: True if there are two distinct elements that sum to zero,\n              False otherwise.\n    \"\"\"\n    # FR-4: Handle lists with fewer than two elements.\n    if len(l) < 2:\n        return False\n\n    # Initialize a set to store numbers encountered so far.\n    # This enables O(1) average time complexity for lookups,\n    # satisfying NFR-1 and NFR-2.\n    seen_elements = set()\n\n    for num in l:\n        # Calculate the complement needed to sum to zero.\n        complement = -num\n\n        # Check if the complement has been seen before.\n        # If 'complement' is in 'seen_elements', it means we've previously encountered\n        # an element that, when summed with the current 'num', results in zero.\n        # Since 'num' is currently being processed and 'complement' was processed\n        # earlier, they are distinct elements (i.e., at different indices).\n        # This logic holds for num=0 too: if the first 0 is added, the second 0\n        # will find its complement (0) in the set, correctly returning True for [0, 0].\n        if complement in seen_elements:\n            return True\n        \n        # Add the current number to the set of seen elements.\n        seen_elements.add(num)\n    \n    # If the loop completes, no such pair was found.\n    return False"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int) -> str:\n    \"\"\"\n    Converts a non-negative integer from base 10 to its string representation\n    in a specified target base (2-9).\n\n    Args:\n        x: The non-negative integer to be converted.\n        base: The target base for conversion (an integer from 2 to 9).\n\n    Returns:\n        A string representing the number x in the specified base.\n\n    Raises:\n        ValueError: If x is negative or base is outside the range [2, 9].\n    \"\"\"\n    if not isinstance(x, int) or x < 0:\n        raise ValueError(\"Input 'x' must be a non-negative integer.\")\n    if not isinstance(base, int) or not (2 <= base < 10):\n        raise ValueError(\"Input 'base' must be an integer between 2 (inclusive) and 9 (inclusive).\")\n\n    if x == 0:\n        return \"0\"\n\n    digits_in_reverse_order = []\n    \n    current_x = x\n    while current_x > 0:\n        remainder = current_x % base\n        digits_in_reverse_order.append(remainder)\n        current_x = current_x // base\n\n    # The digits were collected in reverse order (least significant first).\n    # Reverse the list to get them in correct order (most significant first).\n    digits_in_reverse_order.reverse()\n\n    # Convert integer digits to string and concatenate.\n    result_string = \"\".join(str(digit) for digit in digits_in_reverse_order)\n    \n    return result_string"}
{"task_id": "HumanEval/45", "solution": "from typing import Union\ndef triangle_area(a: Union[int, float], h: Union[int, float]) -> float:\n    \"\"\"\n    Calculates the area of a triangle given its base and height.\n\n    Args:\n        a (Union[int, float]): The length of the base of the triangle.\n        h (Union[int, float]): The height of the triangle.\n\n    Returns:\n        float: The calculated area of the triangle.\n\n    Raises:\n        TypeError: If 'a' or 'h' are not numeric types (int or float).\n        ValueError: If 'a' or 'h' are negative.\n    \"\"\"\n    if not isinstance(a, (int, float)) or not isinstance(h, (int, float)):\n        raise TypeError(\"Base and height must be numeric values.\")\n\n    if a < 0 or h < 0:\n        raise ValueError(\"Base and height must be non-negative values.\")\n\n    area = 0.5 * a * h\n    return float(area)"}
{"task_id": "HumanEval/46", "solution": "import collections\ndef fib4(n: int) -> int:\n    \"\"\"\n    Computes the n-th element of the Fib4 number sequence iteratively.\n\n    The Fib4 sequence is defined as:\n    - fib4(0) = 0\n    - fib4(1) = 0\n    - fib4(2) = 2\n    - fib4(3) = 0\n    - fib4(n) = fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4) for n > 3\n\n    Args:\n        n (int): The index of the Fib4 number to compute.\n                 Must be a non-negative integer.\n\n    Returns:\n        int: The n-th Fib4 number.\n\n    Raises:\n        TypeError: If n is not an integer.\n        ValueError: If n is a negative integer.\n    \"\"\"\n    # 3.1.2 Input Validation\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    # 3.1.3 Base Cases Handling\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n\n    # 3.1.4 Iterative Calculation Logic (for n > 3)\n    # Using a deque to maintain a sliding window of the last four Fib4 numbers.\n    # This allows O(1) space complexity.\n    # The deque is initialized with fib4(0), fib4(1), fib4(2), fib4(3).\n    # At any point in the loop for 'i', the deque will contain\n    # [fib4(i-4), fib4(i-3), fib4(i-2), fib4(i-1)]\n    q = collections.deque([0, 0, 2, 0]) # Corresponds to fib4(0), fib4(1), fib4(2), fib4(3)\n\n    # Iterate from the 4th term up to the n-th term\n    for _ in range(4, n + 1):\n        next_fib = sum(q)  # Calculate the next Fib4 number\n        q.popleft()        # Remove the oldest Fib4 number (fib4(i-4))\n        q.append(next_fib) # Add the new Fib4 number (fib4(i))\n\n    # 3.1.5 Return Value\n    # After the loop, the last element in the deque is fib4(n).\n    return q[-1]"}
{"task_id": "HumanEval/47", "solution": "def median(l: list) -> float:\n    \"\"\"\n    Calculates the median of a list of numbers.\n\n    Args:\n        l: A list of numeric types (int, float).\n\n    Returns:\n        The calculated median value as a float.\n\n    Raises:\n        TypeError: If the input is not a list or contains non-numeric elements\n                   that cause sorting or arithmetic operations to fail.\n        ValueError: If the input list is empty.\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n    if not l:\n        raise ValueError(\"Input list cannot be empty.\")\n    \n    sorted_l = sorted(l) \n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        median_value = sorted_l[n // 2]\n    else:\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        median_value = (mid1 + mid2) / 2.0\n    \n    return float(median_value)"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str) -> bool:\n    \"\"\"\n    Checks if given string is a palindrome.\n    Assumes case-sensitive and character-sensitive comparison.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input must be a string.\")\n    \n    if not text:\n        return True\n        \n    return text == text[::-1]"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int) -> int:\n    \"\"\"\n    Calculates (2^n) % p efficiently using modular exponentiation by squaring.\n\n    Args:\n        n (int): The exponent (must be a non-negative integer).\n        p (int): The modulus (must be a positive integer).\n\n    Returns:\n        int: The result of (2^n) % p, where 0 <= result < p.\n\n    Raises:\n        TypeError: If n or p are not integers.\n        ValueError: If n is negative or p is non-positive.\n    \"\"\"\n    # 3.2 Input Validation\n    if not isinstance(n, int):\n        raise TypeError(f\"Input 'n' must be an integer, but got {type(n).__name__}.\")\n    if not isinstance(p, int):\n        raise TypeError(f\"Input 'p' must be an integer, but got {type(p).__name__}.\")\n\n    if n < 0:\n        raise ValueError(f\"Input 'n' must be non-negative, but got {n}.\")\n    if p <= 0:\n        raise ValueError(f\"Input 'p' must be positive, but got {p}.\")\n\n    # 3.1 Algorithm: Edge Cases\n    if p == 1:\n        return 0  # Any number modulo 1 is 0\n\n    if n == 0:\n        return 1  # 2^0 = 1, and 1 % p = 1 (since p > 1 checked above)\n\n    # 3.1 Algorithm: Initialization\n    result = 1\n    current_base = 2 % p # Base is 2, always keep current_base < p\n\n    # 3.1 Algorithm: Iterative Calculation (Exponentiation by Squaring)\n    # The loop processes 'n' bit by bit, from LSB to MSB\n    while n > 0:\n        # If the current bit of n is 1 (n is odd)\n        if n % 2 == 1:\n            result = (result * current_base) % p\n        \n        # Square the base for the next bit\n        current_base = (current_base * current_base) % p\n        \n        # Move to the next bit of n (integer division by 2)\n        n //= 2\n        \n    return result"}
{"task_id": "HumanEval/50", "solution": "def decode_shift(s: str) -> str:\n    \"\"\"\n    Decodes a string that has been shifted by 5 positions forward in the alphabet\n    by shifting each character 5 positions backward.\n\n    Assumes the input string contains only lowercase English alphabet characters ('a'-'z').\n    \"\"\"\n    decoded_chars = []\n    for ch in s:\n        # Calculate its 0-indexed position relative to 'a'\n        char_pos = ord(ch) - ord('a')\n\n        # Shift this position backward by 5, and apply the modulo 26 operation to handle wrapping\n        # Python's % operator handles negative numbers correctly for wrap-around.\n        decoded_pos = (char_pos - 5) % 26\n\n        # Convert the decoded_pos back to its ASCII ordinal value by adding ord('a')\n        decoded_ord = decoded_pos + ord('a')\n\n        # Convert the decoded_ord back to a character\n        decoded_char = chr(decoded_ord)\n\n        # Append the decoded character to the list\n        decoded_chars.append(decoded_char)\n\n    # Join the characters in decoded_chars list to form the final string\n    return \"\".join(decoded_chars)"}
{"task_id": "HumanEval/51", "solution": "def remove_vowels(text: str) -> str:\n    \"\"\"\n    Removes all occurrences of vowels (both lowercase and uppercase) from an input string.\n\n    Args:\n        text: The input string from which vowels will be removed.\n\n    Returns:\n        A new string containing only the non-vowel characters from the input string,\n        maintaining their original order.\n    \"\"\"\n    # Define the set of vowels for efficient O(1) average-case lookup\n    vowels_set = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\n    # Use a list to accumulate non-vowel characters efficiently\n    result_chars = []\n\n    # Iterate through each character in the input text\n    for char in text:\n        # If the character is not a vowel, add it to the result list\n        if char not in vowels_set:\n            result_chars.append(char)\n\n    # Join the characters in the list to form the final string\n    # This is generally more efficient than repeated string concatenation\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/52", "solution": "def below_threshold(l: list, t: int) -> bool:\n    \"\"\"\n    Determines if all numeric elements within a given list are strictly less than\n    a specified integer threshold.\n\n    Args:\n        l: A list of numbers (integers or floats).\n        t: An integer representing the threshold value.\n\n    Returns:\n        True if every number 'x' in 'l' satisfies 'x < t'.\n        False if at least one number 'x' in 'l' satisfies 'x >= t'.\n    \"\"\"\n    for num in l:\n        if num >= t:\n            return False\n    return True"}
{"task_id": "HumanEval/53", "solution": "def add(x: int, y: int) -> int:\n    \"\"\"\n    Adds two integer numbers.\n    :param x: The first integer.\n    :param y: The second integer.\n    :return: The sum of x and y.\n    \"\"\"\n    return x + y"}
{"task_id": "HumanEval/54", "solution": "def same_chars(s0: str, s1: str) -> bool:\n    \"\"\"\n    Determines if two input strings contain the exact same set of unique characters,\n    regardless of their order or frequency. Character comparison is case-sensitive.\n\n    Args:\n        s0: The first input string.\n        s1: The second input string.\n\n    Returns:\n        True if the unique set of characters from s0 is identical to the unique set\n        of characters from s1, False otherwise.\n    \"\"\"\n    char_set_0 = set(s0)\n    char_set_1 = set(s1)\n    return char_set_0 == char_set_1"}
{"task_id": "HumanEval/55", "solution": "def fib(n: int) -> int:\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    \n    if n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n    \n    if n == 1:\n        return 1\n    elif n == 2:\n        return 1\n    \n    a, b = 1, 1  # F(1), F(2)\n    for _ in range(3, n + 1):\n        a, b = b, a + b\n        \n    return b"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\"\n    Determines if a given string of '<' and '>' characters has correctly matched\n    and nested brackets.\n\n    Args:\n        brackets: A string composed solely of '<' and '>' characters.\n\n    Returns:\n        True if the brackets are correctly matched and nested, False otherwise.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n        \n        # If balance ever drops below zero, it means a closing bracket\n        # appeared without a matching opening bracket.\n        if balance < 0:\n            return False\n            \n    # After iterating through the entire string, if balance is 0,\n    # all brackets are correctly matched. Otherwise, there are\n    # unmatched opening brackets.\n    return balance == 0"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list) -> bool:\n    \"\"\"\n    Determines if a list is monotonically increasing or decreasing.\n\n    A list is monotonic if it is either entirely non-decreasing or entirely non-increasing.\n    Empty lists and single-element lists are considered monotonic.\n\n    Args:\n        l: The input list of comparable elements.\n\n    Returns:\n        True if the list is monotonic (increasing or decreasing), False otherwise.\n\n    Raises:\n        TypeError: If elements in the list are not comparable.\n    \"\"\"\n    # Handle edge cases: empty or single-element lists are monotonic\n    if len(l) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    # Iterate from the second element to compare with the previous\n    for i in range(1, len(l)):\n        # Check if the increasing condition is violated\n        if l[i] < l[i-1]:\n            is_increasing = False\n        # Check if the decreasing condition is violated\n        if l[i] > l[i-1]:\n            is_decreasing = False\n\n        # Optimization: if both conditions are violated, it's not monotonic\n        if not is_increasing and not is_decreasing:\n            return False\n\n    # If we finished the loop, return true if either condition holds\n    return is_increasing or is_decreasing"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list) -> list:\n    \"\"\"\n    Identifies and returns sorted, unique common elements between two input lists.\n\n    Args:\n        l1: The first list of elements.\n        l2: The second list of elements.\n\n    Returns:\n        A new list containing elements present in both input lists,\n        ensuring uniqueness and ascending sort order.\n    \"\"\"\n    # 1. Convert input lists to sets for efficient uniqueness and intersection.\n    set1 = set(l1)\n    set2 = set(l2)\n\n    # 2. Find the intersection of the two sets to get common unique elements.\n    common_elements_set = set1.intersection(set2)\n\n    # 3. Convert the set of common elements back into a list.\n    result_list = list(common_elements_set)\n\n    # 4. Sort the list of common elements in ascending order.\n    result_list.sort()\n\n    # 5. Return the final sorted list.\n    return result_list"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n.\"\"\"\n    largest_factor = 1\n\n    # Step 1: Handle factor 2\n    # Divide by 2 until n is odd. 2 is the only even prime,\n    # so we handle it separately for efficiency.\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Step 2: Handle odd factors starting from 3\n    # Iterate with odd numbers (i) from 3 up to sqrt(n).\n    # We check i*i <= n instead of i <= sqrt(n) to avoid floating-point operations.\n    # As n is reduced, the upper bound for i effectively shrinks.\n    i = 3\n    while i * i <= n:\n        # If i divides n, then i is a prime factor.\n        # Keep dividing n by i until it's no longer divisible.\n        while n % i == 0:\n            largest_factor = i\n            n //= i\n        i += 2  # Move to the next odd number\n\n    # Step 3: Handle the remaining n\n    # After all divisions, if n is still greater than 1,\n    # it means the remaining n is itself a prime number (and must be the largest).\n    # This covers cases where the largest prime factor is greater than sqrt(original_n).\n    if n > 1:\n        largest_factor = n\n\n    return largest_factor"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int) -> int:\n    \"\"\"\n    Calculates the sum of all positive integers from 1 up to and including a given integer n.\n\n    Args:\n        n (int): The upper limit of the integers to be summed.\n\n    Returns:\n        int: The sum of integers from 1 to n, or 0 if n is less than 1.\n\n    Raises:\n        TypeError: If n is not an integer.\n    \"\"\"\n    # NFR4: Error Handling - gracefully handle invalid input types for n\n    # FR1: Input Acceptance - n must be an integer\n    if not isinstance(n, int):\n        raise TypeError(\"\\'n\\' must be an integer.\")\n\n    # FR3: Handling Non-Positive Inputs - if n is less than 1, return 0\n    if n < 1:\n        return 0\n\n    # FR2: Sum Calculation - calculate the sum of all integers from 1 to n\n    # NFR1: Performance - use the mathematical formula for efficiency (O(1))\n    # FR4: Output - return the calculated sum as an integer\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\"\n    Checks if a string of '(' and ')' has correctly matched opening and closing brackets.\n\n    Args:\n        brackets (str): The input string containing only '(' and ')' characters.\n\n    Returns:\n        bool: True if every opening bracket has a corresponding closing bracket, False otherwise.\n    \"\"\"\n    # Initialize a counter for open brackets.\n    # This counter effectively simulates a stack for a single type of bracket.\n    open_brackets_count = 0\n\n    # Iterate through each character in the input string.\n    for char in brackets:\n        if char == '(':\n            # If an opening bracket is found, increment the counter.\n            open_brackets_count += 1\n        elif char == ')':\n            # If a closing bracket is found, decrement the counter.\n            open_brackets_count -= 1\n\n        # Critical check: If the counter ever goes negative, it means a closing\n        # bracket appeared without a corresponding opening bracket. This is an error.\n        if open_brackets_count < 0:\n            return False\n\n    # After iterating through the entire string, the bracketing is correct\n    # only if the counter is zero (meaning all opening brackets have been closed).\n    return open_brackets_count == 0"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list) -> list:\n    \"\"\"\n    Calculates the coefficients of the symbolic derivative of a polynomial.\n\n    The input polynomial P(x) is represented by a list `xs` where `xs[i]`\n    is the coefficient of x^i.\n    For example, [3, 1, 2] represents 3 + 1x + 2x^2.\n\n    The derivative of a polynomial P(x) = a_0 + a_1*x + a_2*x^2 + ... + a_n*x^n\n    is P'(x) = a_1 + 2*a_2*x + ... + n*a_n*x^(n-1).\n\n    Args:\n        xs: A list of numerical coefficients where xs[i] is the coefficient of x^i.\n            Coefficients can be integers or floating-point numbers.\n\n    Returns:\n        A list of numerical coefficients representing the derivative polynomial P'(x).\n        The output list's elements are `output_list[j]` corresponds to the\n        coefficient of x^j in the derivative.\n        Returns an empty list for constant polynomials or empty input.\n    \"\"\"\n    # FR4.1, FR4.2: Handle empty input or single-element input (constant polynomial).\n    # In both cases, the derivative is 0, represented by an empty list of coefficients.\n    if len(xs) < 2:\n        return []\n\n    # Initialize an empty list for derivative coefficients.\n    derived_coeffs = []\n\n    # FR3: The derivative of the constant term (xs[0]*x^0) is 0 and is skipped.\n    # FR2: Iterate from the second coefficient (index 1) to apply the rule:\n    # d/dx (xs[i]*x^i) = (xs[i]*i)*x^(i-1).\n    # This new coefficient (xs[i]*i) belongs to the (i-1)-th term in the derivative polynomial.\n    for i in range(1, len(xs)):\n        # Calculate the new coefficient for x^(i-1)\n        coefficient = xs[i] * i\n        derived_coeffs.append(coefficient)\n\n    return derived_coeffs"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int) -> int:\n    \"\"\"\n    Calculates the n-th element of the fibfib number sequence.\n\n    The fibfib sequence is defined as:\n    fibfib(0) = 0\n    fibfib(1) = 0\n    fibfib(2) = 1\n    fibfib(n) = fibfib(n-1) + fibfib(n-2) + fibfib(n-3) for n > 2.\n\n    Args:\n        n (int): The non-negative integer index of the fibfib sequence element to calculate.\n\n    Returns:\n        int: The value of fibfib(n).\n\n    Raises:\n        TypeError: If n is not an integer.\n        ValueError: If n is a negative integer.\n    \"\"\"\n    # Input Validation\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    # Base Cases\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    # Optimized Tabulation (O(1) space)\n    # Initialize variables for fibfib(0), fibfib(1), fibfib(2)\n    a = 0  # Represents fibfib(i-3)\n    b = 0  # Represents fibfib(i-2)\n    c = 1  # Represents fibfib(i-1)\n\n    # Iterate from the 3rd element up to n\n    for _ in range(3, n + 1):\n        next_val = a + b + c  # fibfib(i) = fibfib(i-1) + fibfib(i-2) + fibfib(i-3)\n        a = b                 # Shift: old fibfib(i-2) becomes new fibfib(i-3)\n        b = c                 # Shift: old fibfib(i-1) becomes new fibfib(i-2)\n        c = next_val          # Current calculated fibfib(i) becomes new fibfib(i-1)\n\n    return c  # c now holds fibfib(n)"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    >>> vowels_count(\"\")\n    0\n    >>> vowels_count(\"shhh\")\n    0\n    >>> vowels_count(\"rhythm\")\n    1\n    >>> vowels_count(\"AEIOUaeiou\")\n    10\n    >>> vowels_count(\"beautiful\")\n    5\n    >>> vowels_count(\"happy\")\n    2\n    >>> vowels_count(\"fly\")\n    1\n    >>> vowels_count(\"sky\")\n    1\n    >>> vowels_count(\"typical\")\n    2\n    >>> vowels_count(\"system\")\n    1\n    >>> vowels_count(\"python\")\n    2\n    >>> vowels_count(\"y\")\n    1\n    >>> vowels_count(\"Y\")\n    1\n    >>> vowels_count(\"h3ll0 w0rld!\")\n    2\n    >>> vowels_count(\"Pyth0n 1s fUn\")\n    3\n    >>> vowels_count(\"supercalifragilisticexpialidocious\")\n    12\n    >>> vowels_count(\"yearly\")\n    3\n    >>> vowels_count(\"symmetry\")\n    3\n    >>> vowels_count(\"myths\")\n    0\n    \"\"\"\n    s = s.lower()\n    count = 0\n    vowels = ['a', 'e', 'i', 'o', 'u']\n    for i, char in enumerate(s):\n        if char in vowels:\n            count += 1\n        elif char == 'y' and i == len(s) - 1:\n            count += 1\n    return count"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x: int, shift: int) -> str:\n    \"\"\"\n    Circular shifts the digits of an integer 'x' to the right by 'shift' positions.\n    If 'shift' is greater than the number of digits in 'x', the digits are returned in reverse order.\n\n    Args:\n        x (int): The integer whose digits are to be shifted.\n        shift (int): The number of positions to shift to the right.\n\n    Returns:\n        str: A string representing the shifted or reversed digits.\n    \"\"\"\n\n    # 1. Convert the integer x to its string representation\n    s = str(x)\n    \n    # 2. Get the number of digits (length of the string)\n    n = len(s)\n\n    # 3. Handle the special condition: If shift > number of digits\n    if shift > n:\n        # Return digits in reverse order\n        return s[::-1]\n    \n    # 4. Handle normal circular shift\n    else:\n        # Calculate the effective shift amount.\n        # This ensures correct behavior if shift == n (results in 0 effective_shift),\n        # or if shift is 0.\n        effective_shift = shift % n\n\n        # Perform the right circular shift\n        # Take the last `effective_shift` characters and append the first `n - effective_shift` characters.\n        shifted_s = s[n - effective_shift:] + s[:n - effective_shift]\n        \n        return shifted_s"}
{"task_id": "HumanEval/66", "solution": "def digitSum(input_string):\n    \"\"\"\n    Calculates the sum of ASCII values of only the uppercase characters within an input string.\n\n    Args:\n        input_string (str): The string to process.\n\n    Returns:\n        int: The total sum of the ASCII values of uppercase characters.\n    \"\"\"\n    sum_ascii_codes = 0\n\n    for char in input_string:\n        if char.isupper():\n            sum_ascii_codes += ord(char)\n\n    return sum_ascii_codes"}
{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s: str, n: int) -> int:\n    \"\"\"\n    Calculates the number of mangoes in a fruit basket based on total fruits\n    and a given count of apples and oranges from a string.\n\n    Args:\n        s: A string adhering to the format \"X apples and Y oranges\",\n           where X and Y are non-negative integers.\n        n: The total number of fruits (apples, oranges, and mangoes) in the basket.\n\n    Returns:\n        The calculated number of mangoes.\n\n    Raises:\n        ValueError: If the input string 's' does not conform to the expected format.\n    \"\"\"\n    # 3.2 String Parser Sub-component (Internal Logic)\n    # Define a regular expression pattern to capture apple and orange counts.\n    # The pattern ensures that only digits are extracted for X and Y.\n    pattern = r\"(\\d+) apples and (\\d+) oranges\"\n    match = re.match(pattern, s)\n\n    if not match:\n        # NFR4: Error Handling - Raise ValueError for invalid string format.\n        # This covers cases where the string does not match the expected structure\n        # or contains non-numerical values where digits are expected.\n        raise ValueError(\"Invalid fruit string format. Expected 'X apples and Y oranges'.\")\n\n    # Extract captured groups and convert them to integers.\n    # match.group(1) corresponds to apples_count, match.group(2) to oranges_count.\n    # The `\\d+` in the regex guarantees that these groups will be valid digit strings for int() conversion.\n    apples_count = int(match.group(1))\n    oranges_count = int(match.group(2))\n\n    # 3.3 Arithmetic Calculator Sub-component (Internal Logic)\n    # Calculate the sum of known fruits (apples and oranges).\n    total_known_fruits = apples_count + oranges_count\n\n    # Calculate mangoes_count by subtracting known fruits from the total (FR2).\n    # As per the design, negative results are returned directly without specific error handling,\n    # as the problem statement only requires the arithmetic result.\n    mangoes_count = n - total_known_fruits\n\n    return mangoes_count"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Identifies and returns the smallest even-valued node and its index\n    from a given array of non-negative integers.\n\n    Args:\n        arr (list): A list of non-negative integers.\n\n    Returns:\n        list: A list [value, index] where 'value' is the smallest even integer\n              and 'index' is its first occurrence's position.\n              Returns an empty list [] if no even numbers are found or\n              if the input array is empty.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_val = float('inf')\n    smallest_even_idx = -1\n\n    for i, current_value in enumerate(arr):\n        # Check if the current value is even\n        if current_value % 2 == 0:\n            # If current_value is smaller than the smallest_even_val found so far,\n            # update smallest_even_val and its index.\n            # This also implicitly handles the requirement to return the first\n            # occurrence's index if values are equal, as the update only happens\n            # for strictly smaller values.\n            if current_value < smallest_even_val:\n                smallest_even_val = current_value\n                smallest_even_idx = i\n\n    # After iterating through the entire array, check if any even number was found.\n    if smallest_even_idx == -1:\n        # No even numbers were found in the array\n        return []\n    else:\n        # Return the smallest even value and its first occurrence's index\n        return [smallest_even_val, smallest_even_idx]"}
{"task_id": "HumanEval/69", "solution": "import collections\ndef search(lst: list[int]) -> int:\n    \"\"\"\n    Identifies the greatest integer X in a list such that its frequency\n    in the list is greater than or equal to X itself.\n\n    Args:\n        lst: A non-empty list of positive integers.\n\n    Returns:\n        The greatest integer X that satisfies frequency(X) >= X.\n        Returns -1 if no such integer exists in the list.\n    \"\"\"\n    # FR1: Input Acceptance - Assumed valid as per SRS (non-empty, positive integers).\n\n    # FR2: Frequency Calculation\n    # Uses collections.Counter for efficient O(N) frequency counting.\n    # Space complexity is O(U), where U is the number of unique elements.\n    counts = collections.Counter(lst)\n\n    # FR4, FR5: Greatest Integer Selection and No Match Handling\n    # Initialize to -1 as per FR5 (No Match Handling).\n    greatest_qualifying_value = -1\n\n    # Sort unique numbers in descending order.\n    # This strategy is key for efficiency (NFR1, NFR4) because the first number\n    # encountered that meets the condition will automatically be the greatest.\n    # Time complexity for sorting unique keys is O(U log U).\n    # Space complexity for storing unique keys is O(U).\n    unique_numbers_sorted_desc = sorted(counts.keys(), reverse=True)\n\n    # FR3: Condition Evaluation\n    # Iterate through the unique numbers from largest to smallest.\n    # In the worst case, this loop runs O(U) times.\n    for candidate_num in unique_numbers_sorted_desc:\n        freq = counts[candidate_num]\n        if freq >= candidate_num:\n            # If the condition is met, this `candidate_num` is the greatest\n            # because we are iterating in descending order.\n            greatest_qualifying_value = candidate_num\n            break  # FR4: Found the greatest, no need to check smaller numbers.\n\n    # FR6: Output Type - Returns a single integer.\n    # Returns the identified greatest qualifying value, or -1 if none was found.\n    return greatest_qualifying_value"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of integers in a strange order:\n    minimum, then maximum of remaining, then minimum of remaining, and so on.\n\n    Args:\n        lst: The input list of integers.\n\n    Returns:\n        A new list of integers sorted in the strange order.\n    \"\"\"\n    sorted_lst = sorted(lst)\n    result = []\n    left = 0\n    right = len(sorted_lst) - 1\n    is_min_turn = True\n\n    while left <= right:\n        if is_min_turn:\n            result.append(sorted_lst[left])\n            left += 1\n        else:\n            result.append(sorted_lst[right])\n            right -= 1\n        is_min_turn = not is_min_turn\n\n    return result"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Calculates the area of a triangle given the lengths of its three sides.\n\n    The function validates the input sides against geometric rules (positive sides,\n    triangle inequality theorem). If the sides form a valid triangle, it computes\n    and returns its area, rounded to two decimal places. Otherwise, it indicates\n    an invalid triangle by returning -1.0.\n\n    Uses Heron's formula for area calculation:\n    s = (a + b + c) / 2 (semi-perimeter)\n    Area = sqrt(s * (s - a) * (s - b) * (s - c))\n\n    Args:\n        a (float): The length of the first side of the triangle.\n        b (float): The length of the second side of the triangle.\n        c (float): The length of the third side of the triangle.\n\n    Returns:\n        float: The calculated area of the triangle, rounded to two decimal places,\n               or -1.0 if the input sides do not form a valid triangle.\n    \"\"\"\n    # FR.2 - Positive Side Length Validation\n    # If any side is less than or equal to zero, the triangle is invalid.\n    if a <= 0 or b <= 0 or c <= 0:\n        return -1.0\n\n    # FR.3 - Triangle Inequality Theorem Validation\n    # The sum of any two sides must be strictly greater than the third side.\n    # This also covers degenerate triangles (where a + b = c) by using '<=' check.\n    if (a + b <= c) or \\\n       (a + c <= b) or \\\n       (b + c <= a):\n        return -1.0\n\n    # FR.4 - Area Calculation (Valid Triangle)\n    # 1. Calculate the semi-perimeter (s)\n    s = (a + b + c) / 2\n\n    # 2. Calculate the area using Heron's formula\n    # Area = sqrt(s * (s - a) * (s - b) * (s - c))\n    # The product under the square root will always be non-negative due to\n    # prior validation of the triangle inequality.\n    product = s * (s - a) * (s - b) * (s - c)\n    area = math.sqrt(product)\n\n    # FR.5 - Area Rounding\n    # Round the calculated area to two decimal points.\n    rounded_area = round(area, 2)\n\n    # FR.7 - Valid Triangle Output\n    return rounded_area"}
{"task_id": "HumanEval/73", "solution": "from typing import List\ndef smallest_change(arr: List[int]) -> int:\n    changes_needed = 0\n    N = len(arr)\n    left = 0\n    right = N - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes_needed += 1\n        left += 1\n        right -= 1\n\n    return changes_needed"}
{"task_id": "HumanEval/74", "solution": "from typing import List\ndef total_match(lst1: List[str], lst2: List[str]) -> List[str]:\n    \"\"\"\n    Compares two lists of strings based on their total character count\n    and returns the list with the fewer characters, or the first list\n    if character counts are equal.\n\n    Args:\n        lst1: The first list of strings.\n        lst2: The second list of strings.\n\n    Returns:\n        A reference to either lst1 or lst2 based on the comparison logic.\n    \"\"\"\n    sum_chars_lst1 = 0\n    for s in lst1:\n        sum_chars_lst1 += len(s)\n\n    sum_chars_lst2 = 0\n    for s in lst2:\n        sum_chars_lst2 += len(s)\n\n    if sum_chars_lst1 <= sum_chars_lst2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a: int) -> bool:\n    \"\"\"\n    Determines if a given integer 'a' is the product of exactly three prime numbers.\n    Prime factors are counted with multiplicity.\n\n    Args:\n        a: An integer less than 100.\n\n    Returns:\n        True if 'a' is the product of exactly three prime numbers, False otherwise.\n    \"\"\"\n    # 1. Input Validation and Edge Cases\n    # FR-1: The function shall accept one integer argument, 'a'.\n    # Constraints: 'a' must be an integer.\n    if not isinstance(a, int):\n        return False\n\n    # FR-4: The function shall handle inputs 'a <= 1' by returning 'False'.\n    # Constraints: Input integer 'a' must be strictly less than 100 (a < 100).\n    if a < 2 or a >= 100:\n        return False\n\n    prime_factors = []\n    temp_a = a\n    d = 2\n\n    # 2. Prime Factorization\n    # Iterate 'd' from 2 upwards to find prime factors.\n    # The loop condition 'd * d <= temp_a' is an optimization, as any factor\n    # larger than sqrt(temp_a) must have a corresponding factor smaller than sqrt(temp_a).\n    while d * d <= temp_a:\n        # Inner loop to find all occurrences of the current prime factor 'd'.\n        while temp_a % d == 0:\n            prime_factors.append(d)\n            temp_a //= d\n            # Early Exit Optimization (FR-7):\n            # If at any point we find more than 3 prime factors,\n            # we can immediately return False as 'a' cannot be a multiply prime.\n            if len(prime_factors) > 3:\n                return False\n        d += 1\n\n    # 3. Handling Remaining Factor\n    # If after the loop, 'temp_a' is still greater than 1, it means 'temp_a' itself\n    # is a prime number (the largest prime factor of the original 'a').\n    if temp_a > 1:\n        prime_factors.append(temp_a)\n\n    # 4. Final Count Check (FR-2, FR-3, FR-5, FR-6, FR-8)\n    # Return True if the total number of prime factors (including multiplicity) is exactly 3.\n    # Otherwise, return False.\n    # This covers:\n    #   - FR-2: Returns True if 'a' is the product of exactly three prime numbers.\n    #   - FR-3: Returns False if 'a' is not the product of exactly three prime numbers.\n    #   - FR-5: Handles inputs that are prime numbers themselves (e.g., 7 -> [7], len=1 -> False).\n    #   - FR-6: Handles inputs that are products of fewer than three prime numbers (e.g., 10 -> [2,5], len=2 -> False).\n    #   - FR-8: Handles composite numbers that are products of three prime numbers (e.g., 30 -> [2,3,5], len=3 -> True; 8 -> [2,2,2], len=3 -> True).\n    return len(prime_factors) == 3"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x: int, n: int) -> bool:\n    \"\"\"\n    Checks if a number x is a simple integer power of n (i.e., n**k = x for some integer k).\n\n    This function determines if x can be expressed as n raised to an integer power.\n    It handles special cases for x=0, x=1, n=0, and n=1, and provides robust\n    input validation.\n\n    Args:\n        x: The number to check. Must be a non-negative integer.\n        n: The base number. Must be a non-negative integer.\n\n    Returns:\n        True if x is an integer power of n, False otherwise.\n\n    Raises:\n        TypeError: If x or n are not integers.\n        ValueError: If x or n are negative.\n\n    Examples:\n        is_simple_power(1, 4)  => True  (4^0 = 1)\n        is_simple_power(2, 2)  => True  (2^1 = 2)\n        is_simple_power(8, 2)  => True  (2^3 = 8)\n        is_simple_power(3, 2)  => False\n        is_simple_power(3, 1)  => False\n        is_simple_power(5, 3)  => False\n        is_simple_power(0, 0)  => True  (0^k = 0 for k > 0)\n        is_simple_power(0, 5)  => False\n        is_simple_power(1, 0)  => True  (0^0 = 1)\n        is_simple_power(4, 0)  => False\n    \"\"\"\n    # 1. Input Validation\n    if not isinstance(x, int):\n        raise TypeError(f\"x must be an integer, but got {type(x).__name__}\")\n    if not isinstance(n, int):\n        raise TypeError(f\"n must be an integer, but got {type(n).__name__}\")\n    if x < 0:\n        raise ValueError(f\"x must be a non-negative integer, but got {x}\")\n    if n < 0:\n        raise ValueError(f\"n must be a non-negative integer, but got {n}\")\n\n    # 2. Handle x = 0 (FR1)\n    if x == 0:\n        if n == 0:\n            return True  # FR1.1: 0 is considered 0^k for k>0 (e.g. 0^1=0)\n        else:  # n > 0\n            return False # FR1.2: n^k cannot be 0 if n > 0\n\n    # 3. Handle x = 1 (FR2)\n    # At this point, x must be 1 or greater\n    if x == 1:\n        # FR2: For any non-negative n, n^0 = 1 (including 0^0 = 1, 1^0 = 1)\n        return True\n\n    # At this point, x > 1\n\n    # 4. Handle special n values when x > 1 (FR3, FR4)\n    if n == 1:\n        # FR3: 1^k is always 1, and x > 1, so x cannot be a power of 1\n        return False\n    if n == 0:\n        # FR4: 0^k can only be 0 or 1, and x > 1, so x cannot be a power of 0\n        return False\n\n    # 5. General Case (x > 1, n > 1) (FR5)\n    # Check if x can be repeatedly divided by n until it becomes 1\n    current_x = x\n    while current_x > 1:\n        if current_x % n != 0:\n            return False  # Not perfectly divisible by n\n        current_x //= n\n    \n    # If the loop completes, current_x has been reduced to 1,\n    # meaning x was a simple power of n.\n    return True"}
{"task_id": "HumanEval/77", "solution": "def iscube(a: int) -> bool:\n    \"\"\"\n    Determines whether a given integer 'a' is a perfect cube of another integer.\n\n    Args:\n        a: The integer to check.\n\n    Returns:\n        True if 'a' is a perfect cube, False otherwise.\n    \"\"\"\n    if a == 0:\n        return True\n\n    # Work with the absolute value for binary search.\n    # If abs(a) is a perfect cube, then 'a' is also a perfect cube\n    # (since the cube root will have the same sign as 'a').\n    val = abs(a)\n\n    # Binary search for the integer cube root of 'val'.\n    # The cube root 'x' of 'val' must satisfy x^3 = val.\n    # The search range for 'x' can be from 0 up to 'val' itself.\n    # For any x > 1, x^3 > x. If x > val, then x^3 will be much larger than val.\n    # So, 'val' is a safe upper bound for the cube root.\n    low = 0\n    high = val\n\n    while low <= high:\n        mid = (low + high) // 2\n\n        # Calculate the cube of mid. Python's integers handle arbitrary precision.\n        mid_cubed = mid * mid * mid\n\n        if mid_cubed == val:\n            return True  # Found an integer 'mid' whose cube is 'val'\n        elif mid_cubed < val:\n            low = mid + 1  # The cube root is larger, search in the upper half\n        else:  # mid_cubed > val\n            high = mid - 1 # The cube root is smaller, search in the lower half\n\n    return False  # No integer cube root found within the search range"}
{"task_id": "HumanEval/78", "solution": "def hex_key(num: str) -> int:\n    \"\"\"\n    Counts the number of hexadecimal digits in a string that correspond to prime numbers.\n\n    Args:\n        num: A string representing a hexadecimal number. Assumed to be valid\n             hexadecimal (0-9, A-F) and uppercase for A-F.\n\n    Returns:\n        An integer representing the total count of prime hexadecimal digits found.\n    \"\"\"\n    # Define the set of hexadecimal digits whose decimal equivalents are prime.\n    # Prime numbers: 2, 3, 5, 7, 11 (B), 13 (D)\n    prime_hex_digits = {'2', '3', '5', '7', 'B', 'D'}\n\n    prime_count = 0\n    for digit in num:\n        if digit in prime_hex_digits:\n            prime_count += 1\n\n    return prime_count"}
{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal: int) -> str:\n    \"\"\"\n    Converts a non-negative decimal integer into its binary string representation,\n    prepended and appended with the string 'db'.\n\n    Args:\n        decimal: A non-negative integer to be converted.\n\n    Returns:\n        A string representing the binary conversion with 'db' prefix and suffix.\n    \"\"\"\n    binary_str_with_prefix = bin(decimal)\n    clean_binary_str = binary_str_with_prefix[2:]\n    final_output_str = 'db' + clean_binary_str + 'db'\n    return final_output_str"}
{"task_id": "HumanEval/80", "solution": "def is_happy(s: str) -> bool:\n    \"\"\"\n    Determines if a given string is a \"happy string\" based on specific criteria.\n\n    A string is considered happy if:\n    1. Its length is at least 3.\n    2. Every 3 consecutive characters within it are distinct.\n\n    Character comparison is case-sensitive (e.g., 'a' and 'A' are distinct).\n\n    Args:\n        s: The string to be evaluated.\n\n    Returns:\n        True if the string s is happy, False otherwise.\n\n    Raises:\n        TypeError: If the input 's' is not a string.\n    \"\"\"\n    # NFR-003 (Error Handling): Check input type\n    if not isinstance(s, str):\n        raise TypeError(\"Input 's' must be a string.\")\n\n    n = len(s)\n\n    # REQ-003 (Length Constraint): If length < 3, it cannot be a happy string\n    if n < 3:\n        return False\n\n    # REQ-004 (Triplet Iteration), NFR-001 (Time Complexity):\n    # Iterate through all consecutive triplets using a sliding window.\n    # The loop goes up to n - 2, ensuring s[i+2] is always a valid index.\n    for i in range(n - 2):\n        char1 = s[i]\n        char2 = s[i + 1]\n        char3 = s[i + 2]\n\n        # REQ-005 (Distinctness Check):\n        # Use a set to efficiently check if the three characters are distinct.\n        # If the size of the set is not 3, it means there are duplicate characters.\n        if len({char1, char2, char3}) != 3:\n            # REQ-006 (Early Exit on Non-Distinct):\n            # As soon as one non-distinct triplet is found, the string is not happy.\n            return False\n\n    # REQ-007 (Success Condition):\n    # If the loop completes, it means all triplets were distinct.\n    return True"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades: list[float | int]) -> list[str]:\n    \"\"\"\n    Converts a list of numerical Grade Point Averages (GPAs) into a corresponding\n    list of letter grades based on a predefined grading scale.\n\n    Args:\n        grades: A list of numerical values (float or int) representing GPAs.\n\n    Returns:\n        A list of strings, where each string is the corresponding letter grade.\n    \"\"\"\n\n    def _convert_single_gpa(gpa: float | int) -> str:\n        \"\"\"\n        Helper function to convert a single numerical GPA to its letter grade\n        according to the specified grading scale.\n        \"\"\"\n        if gpa == 4.0:\n            return 'A+'\n        elif gpa > 3.7:\n            return 'A'\n        elif gpa > 3.3:\n            return 'A-'\n        elif gpa > 3.0:\n            return 'B+'\n        elif gpa > 2.7:\n            return 'B'\n        elif gpa > 2.3:\n            return 'B-'\n        elif gpa > 2.0:\n            return 'C+'\n        elif gpa > 1.7:\n            return 'C'\n        elif gpa > 1.3:\n            return 'C-'\n        elif gpa > 1.0:\n            return 'D+'\n        elif gpa > 0.7:\n            return 'D'\n        elif gpa > 0.0:\n            return 'D-'\n        else:  # Covers gpa <= 0.0, including gpa == 0.0 and negative values\n            return 'E'\n\n    # Apply the conversion to each GPA in the input list using the helper function\n    letter_grades = [_convert_single_gpa(gpa) for gpa in grades]\n    return letter_grades"}
{"task_id": "HumanEval/82", "solution": "def _is_prime(n: int) -> bool:\n    \"\"\"\n    Checks if a given integer n is a prime number.\n\n    Args:\n        n: The integer to check for primality.\n\n    Returns:\n        True if n is prime, False otherwise.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\ndef prime_length(string: str) -> bool:\n    \"\"\"\n    Checks if the length of the input string is a prime number.\n\n    Args:\n        string: The input string.\n\n    Returns:\n        True if the length of the string is prime, False otherwise.\n    \"\"\"\n    length = len(string)\n    return _is_prime(length)"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n: int) -> int:\n    \"\"\"\n    Counts the number of n-digit positive integers that start or end with 1.\n\n    Args:\n        n (int): The number of digits. Must be a positive integer (n >= 1).\n\n    Returns:\n        int: The count of n-digit positive integers satisfying the condition.\n\n    Raises:\n        TypeError: If n is not an integer.\n        ValueError: If n is less than 1.\n    \"\"\"\n    # 1. Input Validation\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer.\")\n    if n < 1:\n        raise ValueError(\"n must be a positive integer (n >= 1).\")\n\n    # 2. Base Case n = 1\n    # For n=1, the only 1-digit positive integer starting or ending with 1 is '1'.\n    if n == 1:\n        return 1\n\n    # 3. General Case n > 1\n    # Apply Principle of Inclusion-Exclusion: |A U B| = |A| + |B| - |A intersection B|\n\n    # Calculate numbers starting with 1 (Set A)\n    # The first digit is fixed as '1'. The remaining n-1 digits can be any of 0-9.\n    # This gives 1 * 10^(n-1) numbers.\n    count_starts_with_1 = 10**(n - 1)\n\n    # Calculate numbers ending with 1 (Set B)\n    # The last digit is fixed as '1'.\n    # The first digit can be any of 1-9 (9 options, as it cannot be 0 for an n-digit number).\n    # The n-2 middle digits (if n > 2) can be any of 0-9.\n    # This gives 9 * 10^(n-2) numbers.\n    count_ends_with_1 = 9 * (10**(n - 2))\n\n    # Calculate numbers starting AND ending with 1 (Set A intersection B)\n    # The first digit is '1', the last digit is '1'.\n    # The n-2 middle digits (if n > 2) can be any of 0-9.\n    # This gives 1 * 10^(n-2) numbers.\n    count_starts_and_ends_with_1 = 10**(n - 2)\n\n    # Apply the Inclusion-Exclusion Principle\n    total_count = count_starts_with_1 + count_ends_with_1 - count_starts_and_ends_with_1\n    \n    return total_count"}
{"task_id": "HumanEval/84", "solution": "def solve(N: int) -> str:\n    \"\"\"\n    Calculates the total sum of the decimal digits of N and\n    returns its binary representation as a string.\n\n    Args:\n        N: A non-negative integer within the range [0, 10000].\n\n    Returns:\n        A string representing the binary equivalent of the sum of N's digits.\n    \"\"\"\n    # Step 1: Calculate Sum of Digits\n    sum_of_digits = 0\n    current_N = N  # Use a temporary variable to avoid modifying N\n\n    # Handle the special case where N is 0.\n    # The while loop naturally handles this if sum_of_digits is initialized to 0.\n    if current_N == 0:\n        sum_of_digits = 0\n    else:\n        while current_N > 0:\n            digit = current_N % 10\n            sum_of_digits += digit\n            current_N //= 10\n\n    # Step 2: Convert Sum to Binary String\n    # Utilize Python's built-in bin() function, then slice to remove \"0b\" prefix.\n    binary_string = bin(sum_of_digits)[2:]\n\n    return binary_string"}
{"task_id": "HumanEval/85", "solution": "def add(lst: list[int]) -> int:\n    \"\"\"\n    Sums elements from a list of integers where the element's index is odd\n    and its value is even.\n\n    Args:\n        lst: A non-empty list of integers.\n\n    Returns:\n        An integer representing the calculated sum.\n    \"\"\"\n    total = 0\n\n    for index, element in enumerate(lst):\n        # Check if index is odd AND element's value is even\n        if index % 2 != 0 and element % 2 == 0:\n            total += element\n\n    return total"}
{"task_id": "HumanEval/86", "solution": "import re\ndef anti_shuffle(s: str) -> str:\n    \"\"\"\n    Takes a string and returns an ordered version of it.\n    An ordered version of a string is one where all words (separated by space)\n    are replaced by a new word where all the characters are arranged in\n    ascending order based on ASCII value.\n    The order of words and blank spaces in the sentence is kept.\n\n    Args:\n        s (str): The input string.\n\n    Returns:\n        str: The anti-shuffled version of the input string.\n\n    Examples:\n        >>> anti_shuffle('Hi')\n        'Hi'\n        >>> anti_shuffle('hello')\n        'ehllo'\n        >>> anti_shuffle('Hello World!!!')\n        'Hello !!!Wdlor'\n        >>> anti_shuffle('')\n        ''\n        >>> anti_shuffle('   ')\n        '   '\n    \"\"\"\n    # Helper function to sort characters within a word\n    def sort_word_chars(match_obj):\n        word = match_obj.group(0)\n        return \"\".join(sorted(word))\n\n    # Use re.sub with a replacement function to sort characters in each \"word\"\n    # '\\S+' matches one or more non-whitespace characters (a word including punctuation)\n    return re.sub(r'\\S+', sort_word_chars, s)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst: list[list[int]], x: int) -> list[tuple[int, int]]:\n    \"\"\"\n    Finds occurrences of integer x in a 2D irregular list and returns\n    their 0-indexed coordinates (row, column), sorted first by row (ascending)\n    and then by column (descending) for elements within the same row.\n    \"\"\"\n    found_coordinates = []\n\n    for row_idx, row in enumerate(lst):\n        for col_idx, element in enumerate(row):\n            if element == x:\n                found_coordinates.append((row_idx, col_idx))\n\n    # Sort primarily by row_idx in ascending order (coord[0])\n    # and secondarily by col_idx in descending order (-coord[1]).\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return found_coordinates"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array: list) -> list:\n    \"\"\"\n    Sorts an array of non-negative integers based on the parity of the sum of\n    its first and last elements.\n\n    The array is sorted in ascending order if the sum of the first and last\n    elements is odd.\n    The array is sorted in descending order if the sum of the first and last\n    elements is even.\n\n    The original array is not modified; a sorted copy is returned.\n\n    Args:\n        array (list): A list of non-negative integers.\n\n    Returns:\n        list: A new list containing the sorted elements according to the rules.\n\n    Examples:\n        >>> sort_array([])\n        []\n        >>> sort_array([5])\n        [5]\n        >>> sort_array([2, 4, 3, 0, 1, 5]) # 2+5=7 (odd) -> ascending\n        [0, 1, 2, 3, 4, 5]\n        >>> sort_array([2, 4, 3, 0, 1, 5, 6]) # 2+6=8 (even) -> descending\n        [6, 5, 4, 3, 2, 1, 0]\n    \"\"\"\n    # FR-2: Create a shallow copy of the input array\n    copied_array = list(array)\n\n    # FR-3, FR-4: Handle edge cases: empty or single-element array\n    if not copied_array or len(copied_array) <= 1:\n        return copied_array  # Already a copy, return as is.\n\n    # Get first and last elements for sum calculation\n    first_element = copied_array[0]\n    last_element = copied_array[len(copied_array) - 1]\n\n    # Calculate the sum of first and last elements\n    sum_of_ends = first_element + last_element\n\n    # FR-5, FR-6: Determine sort order based on sum parity\n    if sum_of_ends % 2 != 0:  # Sum is odd\n        # Sort in ascending order\n        copied_array.sort(reverse=False)\n    else:  # Sum is even\n        # Sort in descending order\n        copied_array.sort(reverse=True)\n\n    # FR-7: Return the sorted copy\n    return copied_array"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s: str) -> str:\n    \"\"\"\n    Encrypts a string using a rotational cipher with a fixed shift of 4.\n\n    Alphabetic characters are shifted four positions down the English alphabet,\n    wrapping around from 'z' to 'a' (or 'Z' to 'A'). Case is preserved.\n    Non-alphabetic characters remain unchanged.\n\n    Args:\n        s: The input string to be encrypted.\n\n    Returns:\n        A new string representing the encrypted version of the input string.\n    \"\"\"\n    encrypted_chars = []\n    SHIFT = 4\n\n    for char in s:\n        if 'a' <= char <= 'z':  # Check if lowercase alphabetic\n            # Calculate the zero-based index (0-25)\n            offset = ord(char) - ord('a')\n            # Apply shift with wrap-around using modulo 26\n            shifted_offset = (offset + SHIFT) % 26\n            # Convert back to character\n            encrypted_char = chr(shifted_offset + ord('a'))\n            encrypted_chars.append(encrypted_char)\n        elif 'A' <= char <= 'Z':  # Check if uppercase alphabetic\n            # Calculate the zero-based index (0-25)\n            offset = ord(char) - ord('A')\n            # Apply shift with wrap-around using modulo 26\n            shifted_offset = (offset + SHIFT) % 26\n            # Convert back to character\n            encrypted_char = chr(shifted_offset + ord('A'))\n            encrypted_chars.append(encrypted_char)\n        else:\n            # Non-alphabetic characters remain unchanged\n            encrypted_chars.append(char)\n            \n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst: list[int]) -> int | None:\n    # 1. Handle Empty List (F2)\n    if not lst:\n        return None\n\n    # 2. Remove Duplicates and Sort (F4)\n    # Convert list to a set to get unique elements, then convert back to a list\n    # and sort it.\n    unique_elements = sorted(list(set(lst)))\n\n    # 3. Check for Insufficient Unique Elements (F3)\n    # If, after removing duplicates, there are less than 2 elements,\n    # a \"second smallest\" does not exist.\n    if len(unique_elements) < 2:\n        return None\n\n    # 4. Return Second Smallest (F4)\n    # The sorted list will have the smallest element at index 0,\n    # and the second smallest at index 1.\n    return unique_elements[1]"}
{"task_id": "HumanEval/91", "solution": "import re\ndef is_bored(S: str) -> int:\n    \"\"\"\n    Counts \"boredom\" sentences within a given text string.\n    A \"boredom\" is defined as a sentence that starts with the word \"I\".\n\n    Args:\n        S: The input text string to be analyzed.\n\n    Returns:\n        An integer representing the total count of sentences that start with \"I\".\n    \"\"\"\n    boredom_count = 0\n\n    # Handle empty input string immediately\n    if not S:\n        return 0\n\n    # Split the input string into sentence fragments using specified delimiters.\n    # The regex r'[.?!]' splits by '.', '?', or '!'.\n    sentence_fragments = re.split(r'[.?!]', S)\n\n    for fragment in sentence_fragments:\n        # Clean leading/trailing whitespace from the fragment\n        cleaned_sentence = fragment.strip()\n\n        # Ignore empty fragments (e.g., resulting from consecutive delimiters or trailing delimiters)\n        if not cleaned_sentence:\n            continue\n\n        # Check if the cleaned sentence starts with the capitalized \"I\"\n        if cleaned_sentence.startswith(\"I\"):\n            # A \"boredom\" sentence starts with \"I\" which is either:\n            # 1. The entire sentence is just \"I\" (e.g., \"I!\")\n            # 2. \"I\" followed by a space (e.g., \"I am here.\")\n            if len(cleaned_sentence) == 1:\n                boredom_count += 1\n            elif len(cleaned_sentence) > 1 and cleaned_sentence[1] == ' ':\n                boredom_count += 1\n\n    return boredom_count"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z) -> bool:\n    \"\"\"\n    Checks if all three input parameters are integers and if any one of the numbers\n    is equal to the sum of the other two.\n\n    Args:\n        x: The first input parameter. Can be of any type.\n        y: The second input parameter. Can be of any type.\n        z: The third input parameter. Can be of any type.\n\n    Returns:\n        True if all inputs are strictly integers AND at least one number is the\n        sum of the other two.\n        False otherwise (e.g., if any input is not an integer, or if all are\n        integers but no sum condition is met).\n    \"\"\"\n    # FR.2: Type Validation - check if all parameters are strictly integers.\n    # If any parameter is not an integer, immediately return False.\n    if not isinstance(x, int):\n        return False\n    if not isinstance(y, int):\n        return False\n    if not isinstance(z, int):\n        return False\n\n    # FR.3 & FR.4: Sum Condition Check - if all parameters are integers,\n    # check if any one number is equal to the sum of the other two.\n    # Return True as soon as any condition is met.\n    if x == y + z:\n        return True\n    if y == x + z:\n        return True\n    if z == x + y:\n        return True\n\n    # FR.5: Return False in all other cases.\n    # This point is reached if all inputs were integers but none of the\n    # sum conditions (FR.3) were met.\n    return False"}
{"task_id": "HumanEval/93", "solution": "def encode(message: str) -> str:\n    \"\"\"\n    Encodes a given message string by applying two main transformations:\n    1. Swaps the case of all alphabetic characters.\n    2. Replaces specific vowels (a, e, i, o, u, case-insensitive) with\n       the letter two places ahead in the English alphabet, preserving case.\n       Non-alphabetic characters (like spaces) are passed through unchanged.\n\n    Assumptions:\n    - The input 'message' will only contain letters (A-Z, a-z) and spaces.\n\n    Parameters:\n        message (str): The input string to be encoded.\n\n    Returns:\n        str: The transformed and encoded string.\n\n    Examples:\n        >>> encode('test')\n        'TGST'\n        >>> encode('This is a message')\n        'tHKS KS C MGSSCGG'\n    \"\"\"\n    result_chars = []\n\n    LOWERCASE_VOWELS = {'a', 'e', 'i', 'o', 'u'}\n    VOWEL_REPLACEMENT_MAP = {\n        'a': 'c',\n        'e': 'g',\n        'i': 'k',\n        'o': 'q',\n        'u': 'w'\n    }\n\n    for char in message:\n        if not char.isalpha():\n            result_chars.append(char)\n        else:\n            swapped_char = char.swapcase()\n\n            is_swapped_char_uppercase = swapped_char.isupper()\n            swapped_char_lower = swapped_char.lower()\n\n            if swapped_char_lower in LOWERCASE_VOWELS:\n                replacement_char_lower = VOWEL_REPLACEMENT_MAP[swapped_char_lower]\n                if is_swapped_char_uppercase:\n                    final_char = replacement_char_lower.upper()\n                else:\n                    final_char = replacement_char_lower\n                result_chars.append(final_char)\n            else:\n                result_chars.append(swapped_char)\n\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/94", "solution": "import math\nfrom typing import List\ndef is_prime(n: int) -> bool:\n    \"\"\"\n    Determines if a given integer n is a prime number using trial division up to sqrt(n).\n    Implements FR-01 and follows NFR-01 (performance).\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:  # All other even numbers greater than 2 are not prime\n        return False\n\n    # Check for odd divisors from 3 up to sqrt(n)\n    # The upper bound is `int(math.sqrt(n)) + 1` to include `sqrt(n)` itself if it's an integer.\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\ndef sum_digits(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the individual digits of a given non-negative integer.\n    Implements FR-02. As per the problem context, n will be a prime number (positive integer > 1).\n    \"\"\"\n    digit_sum = 0\n    \n    # In this problem's context, 'n' will always be a positive integer (a prime number > 1).\n    # Thus, no explicit handling for n=0 or negative n is required based on the specification's flow.\n    \n    while n > 0:\n        digit_sum += n % 10\n        n //= 10\n    return digit_sum\ndef skjkasdkd(lst: List[int]) -> int:\n    \"\"\"\n    Identifies the largest prime number within a given list of integers and\n    returns the sum of its digits.\n    This is the main orchestration function (FR-03).\n    Assumes the input list will always contain at least one prime number greater than 1\n    as per the General Constraints and FR-03's note on undefined behavior.\n    \"\"\"\n    largest_prime_found = -1  # Initialize to a value indicating no prime has been found yet\n                              # (primes are > 1, so -1 ensures any prime will be larger)\n\n    for num in lst:\n        if is_prime(num):\n            if num > largest_prime_found:\n                largest_prime_found = num\n    \n    # According to SRS FR-03 and System Design, it is assumed that `largest_prime_found`\n    # will contain a valid prime number (> 1) after the loop completes.\n    \n    return sum_digits(largest_prime_found)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(data_dict: dict) -> bool:\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower \n    case or all keys are strings in upper case, else return False.\n    The function should return False if the given dictionary is empty.\n    \"\"\"\n    if not data_dict:\n        return False\n\n    is_all_lower = True\n    is_all_upper = True\n\n    for key in data_dict:\n        if not isinstance(key, str):\n            return False\n        \n        # Update flags based on the current key's casing\n        # If is_all_lower was already False, it remains False. Otherwise, it depends on key.islower().\n        is_all_lower = is_all_lower and key.islower()\n        # Similarly for is_all_upper\n        is_all_upper = is_all_upper and key.isupper()\n\n    # The result is True if ALL keys were lower OR ALL keys were upper.\n    # If there was a mix (e.g., some lower, some upper), both flags will be False.\n    # If keys had mixed characters (e.g., \"Name\"), both flags will be False.\n    return is_all_lower or is_all_upper"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n: int) -> list[int]:\n    \"\"\"\n    Identifies and returns all prime numbers strictly less than a given non-negative integer n.\n\n    This function implements the algorithm described in the System Design Document,\n    utilizing a nested helper function `is_prime` for primality testing.\n    The overall time complexity is O(n * sqrt(n)).\n\n    Args:\n        n: A non-negative integer.\n\n    Returns:\n        A list of integers, representing the prime numbers p such that 1 < p < n,\n        sorted in ascending order. Returns an empty list if no such primes exist.\n    \"\"\"\n    primes_list = []\n\n    # REQ-004: Handle edge cases where n is 0, 1, or 2.\n    # No primes are strictly less than or equal to 2.\n    if n <= 2:\n        return primes_list\n\n    def is_prime(num: int) -> bool:\n        \"\"\"\n        Helper function to efficiently determine if a given integer is a prime number.\n        Implements the detailed algorithm from System Design 3.2.\n        \"\"\"\n        # Base Cases:\n        # Numbers less than 2 are not prime by definition.\n        if num < 2:\n            return False\n        # 2 is the only even prime number.\n        if num == 2:\n            return True\n        # All other even numbers (greater than 2) are not prime.\n        if num % 2 == 0:\n            return False\n\n        # Check for odd divisors starting from 3 up to the square root of num.\n        # This is an optimization as per the System Design (Detailed Design 3.2, step 3).\n        divisor = 3\n        # The loop continues as long as divisor * divisor is less than or equal to num.\n        # If num has a divisor larger than its square root, it must also have one smaller.\n        while (divisor * divisor) <= num:\n            if num % divisor == 0:\n                return False  # Found a divisor, so 'num' is not prime\n            divisor += 2  # Increment by 2 to check only odd divisors\n\n        return True  # No divisors were found, so 'num' is prime\n\n    # REQ-002: Iterate through integers from 2 up to n-1 (exclusive of n)\n    # and check their primality using the helper function.\n    for i in range(2, n):\n        if is_prime(i):\n            primes_list.append(i)  # If prime, add to the list\n\n    # REQ-003: The list is naturally sorted in ascending order as primes are found sequentially.\n    return primes_list"}
{"task_id": "HumanEval/97", "solution": "def multiply(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the product of the unit digits of two given integers.\n\n    The unit digit for any integer n is obtained by calculating the\n    absolute value of n modulo 10 (i.e., |n % 10|).\n\n    Args:\n        a: The first integer.\n        b: The second integer.\n\n    Returns:\n        The product of the unit digits of a and b.\n    \"\"\"\n    # Extract unit digit of 'a'\n    # Use abs() to handle negative numbers consistently across languages\n    # For Python, -15 % 10 yields 5, so abs() will just return 5.\n    # For C/Java, -15 % 10 yields -5, so abs() will return 5.\n    unit_digit_a = abs(a % 10)\n\n    # Extract unit digit of 'b'\n    unit_digit_b = abs(b % 10)\n\n    # Calculate the product of the unit digits\n    product = unit_digit_a * unit_digit_b\n\n    return product"}
{"task_id": "HumanEval/98", "solution": "def count_upper(s: str) -> int:\n    count = 0\n    UPPER_VOWELS = {'A', 'E', 'I', 'O', 'U'}\n\n    for i, char in enumerate(s):\n        if i % 2 == 0:\n            if char in UPPER_VOWELS:\n                count += 1\n    return count"}
{"task_id": "HumanEval/99", "solution": "import math\ndef closest_integer(value: str) -> int:\n    \"\"\"\n    Calculates the closest integer to a given number string,\n    implementing a specific \"round away from zero\" rule for values ending in .5.\n\n    Parameters:\n        value (str): A string representation of a number (e.g., \"14.5\", \"-3.14\").\n\n    Returns:\n        int: The closest integer to the input number, rounded away from zero for .5 cases.\n\n    Raises:\n        ValueError: If the input 'value' string cannot be converted to a float.\n    \"\"\"\n    try:\n        # Convert string to float\n        float_val = float(value)\n    except ValueError:\n        # Re-raise ValueError for invalid numerical strings\n        raise ValueError(\"Input must be a valid numerical string.\")\n\n    # Determine the sign of the float_val.\n    # math.copysign(1.0, x) returns 1.0 if x >= 0, and -1.0 if x < 0.\n    # This handles positive and negative zero correctly for the rounding logic.\n    sign = math.copysign(1.0, float_val)\n\n    # Apply the adjusted rounding logic:\n    # Adding 0.5 * sign effectively shifts numbers ending in .5 away from zero\n    # (e.g., 14.5 becomes 15.0, -14.5 becomes -15.0)\n    # and positions other numbers correctly for integer truncation.\n    rounded_val_adjusted = float_val + (0.5 * sign)\n\n    # Truncate the decimal part to get the integer.\n    return int(rounded_val_adjusted)"}
{"task_id": "HumanEval/100", "solution": "def make_a_pile(n: int) -> list[int]:\n    pile_levels = []\n    current_stones = n\n\n    for _ in range(n):\n        pile_levels.append(current_stones)\n        current_stones += 2\n\n    return pile_levels"}
{"task_id": "HumanEval/101", "solution": "import re\ndef words_string(s: str) -> list[str]:\n    \"\"\"\n    Parses a given string into a list of words based on specified delimiters.\n\n    Words are separated by one or more occurrences of commas (',') or spaces (' ').\n    Empty strings resulting from the splitting process are filtered out.\n\n    Args:\n        s: The input string to be parsed. This must be a string.\n\n    Returns:\n        A list of strings, where each string is an extracted word.\n        If the input string is empty or contains only delimiters, an empty list is returned.\n\n    Raises:\n        TypeError: If the input 's' is not a string.\n    \"\"\"\n    # REQ-FUNC-001: Input Handling - 's' is expected to be a string.\n    # The 're' module's split function will implicitly raise a TypeError\n    # if 's' is not a string, which satisfies this requirement.\n\n    # REQ-FUNC-002: Word Splitting Logic\n    # Define a regular expression pattern to match one or more\n    # occurrences of either a comma or a space.\n    # The '+' quantifier ensures that multiple consecutive delimiters\n    # (e.g., \",,\" or \"   \") are treated as a single separator.\n    delimiter_pattern = r'[, ]+'\n\n    # Split the input string using the defined delimiter pattern.\n    # re.split returns a list of strings. It can include empty strings\n    # if delimiters appear at the beginning or end of the string, or\n    # if there are empty groups between matches (though the '+' quantifier\n    # for delimiters minimizes this between actual words).\n    words = re.split(delimiter_pattern, s)\n\n    # REQ-FUNC-003: Empty Word Filtering\n    # Use a list comprehension to filter out any empty strings that might\n    # result from the splitting process (e.g., from leading/trailing delimiters\n    # or if the input string was empty or contained only delimiters).\n    # An empty string is considered falsy in Python, so 'if word' effectively filters it out.\n    filtered_words = [word for word in words if word]\n\n    # REQ-FUNC-004: Output Format\n    # Return the final list of non-empty words.\n    return filtered_words"}
{"task_id": "HumanEval/102", "solution": "def choose_num(x: int, y: int) -> int:\n    \"\"\"\n    Identifies the biggest even integer within a given positive integer range [x, y].\n\n    Args:\n        x: The lower bound of the range (positive integer, x >= 1).\n        y: The upper bound of the range (positive integer, y >= 1).\n\n    Returns:\n        The largest even number in [x, y], or -1 if no such number exists.\n    \"\"\"\n    # 1. Check Range Validity:\n    # If y < x, the range is invalid. Return -1 immediately.\n    if y < x:\n        return -1\n\n    # 2. Determine Candidate:\n    # Initialize a variable, candidate_even, to y.\n    candidate_even = y\n    \n    # If candidate_even is odd (candidate_even % 2 != 0), decrement it by 1\n    # (candidate_even = y - 1). This ensures candidate_even is the largest\n    # potential even number less than or equal to y.\n    if candidate_even % 2 != 0:\n        candidate_even -= 1\n\n    # 3. Validate Candidate against Lower Bound:\n    # If candidate_even is greater than or equal to x (candidate_even >= x),\n    # then candidate_even is the biggest even number within the [x, y] range.\n    # Return candidate_even.\n    if candidate_even >= x:\n        return candidate_even\n    # Otherwise (candidate_even < x), it means that the largest potential even number\n    # (which was y or y-1) falls below the lower bound x. Therefore, no even number\n    # exists within the valid range [x, y]. Return -1.\n    else:\n        return -1"}
{"task_id": "HumanEval/103", "solution": "def rounded_avg(n: int, m: int) -> str | int:\n    \"\"\"\n    Calculates the average of integers from n to m (inclusive),\n    rounds the result to the nearest integer using 'half to even' rule,\n    and converts it to its binary string representation.\n\n    Args:\n        n: A positive integer, representing the start of the range.\n        m: A positive integer, representing the end of the range.\n\n    Returns:\n        -1 (int) if n > m.\n        A string representing the binary format (e.g., \"0b101\") otherwise.\n    \"\"\"\n    # F.AVG.1 - Input Validation\n    if n > m:\n        return -1\n\n    # F.AVG.2 - Average Calculation\n    # Using 2.0 ensures float division to preserve precision for rounding.\n    average_float = (n + m) / 2.0\n\n    # F.AVG.3 - Rounding\n    # Python's built-in round() function implements \"round half to even\" for .5 values.\n    rounded_average_int = round(average_float)\n\n    # F.AVG.4 - Binary Conversion\n    # The bin() function returns the binary string with a \"0b\" prefix.\n    binary_string = bin(rounded_average_int)\n\n    return binary_string"}
{"task_id": "HumanEval/104", "solution": "def has_no_even_digits(n: int) -> bool:\n    \"\"\"\n    Determines if a given positive integer contains only odd digits.\n\n    This helper function iteratively checks each digit of the number\n    using arithmetic operations (modulo and integer division).\n\n    Args:\n        n: A positive integer (n > 0).\n\n    Returns:\n        True if all digits of n are odd, False otherwise.\n    \"\"\"\n    # The SRS specifies positive integers, so n will always be > 0.\n    # However, if 0 were possible, it's an even digit.\n    # The loop `while n > 0` correctly handles any positive integer.\n    while n > 0:\n        digit = n % 10  # Get the last digit\n        if digit % 2 == 0:  # Check if the digit is even\n            return False  # Found an even digit, so return False immediately\n        n //= 10  # Remove the last digit\n    return True  # All digits were checked and found to be odd\ndef unique_digits(x: list[int]) -> list[int]:\n    \"\"\"\n    Filters a list of positive integers, retaining only those numbers\n    that do not contain any even digits, and returns the filtered list\n    sorted in increasing order.\n\n    Args:\n        x: A list of positive integers. Each integer n must satisfy n > 0.\n\n    Returns:\n        A new list containing only numbers from the input list whose\n        digits are all odd. The returned list is sorted in ascending order.\n        Returns an empty list if no numbers satisfy the criteria or if\n        the input list is empty.\n    \"\"\"\n    filtered_numbers = []\n\n    # Iterate through each number in the input list\n    for number in x:\n        # Use the helper function to check if the current number\n        # consists entirely of odd digits.\n        if has_no_even_digits(number):\n            filtered_numbers.append(number)\n\n    # Sort the collected numbers in increasing order as required.\n    filtered_numbers.sort()\n\n    return filtered_numbers"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Filters an array of integers, keeping only numbers between 1 and 9 (inclusive).\n    It then sorts these numbers in ascending order, reverses them, and converts\n    each number to its English word representation.\n\n    Args:\n        arr (list[int]): An array of integers.\n\n    Returns:\n        list[str]: An array of strings, where each string is the word representation\n                   of a processed digit. Returns an empty list if no valid\n                   digits are found or if the input array is empty.\n    \"\"\"\n    DIGIT_WORDS = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    filtered_numbers = []\n    for number in arr:\n        # FR2: Filtering Integers (1 <= n <= 9)\n        if 1 <= number <= 9:\n            filtered_numbers.append(number)\n\n    # FR6: Empty Array Handling\n    if not filtered_numbers:\n        return []\n\n    # FR3: Sorting Filtered Integers (ascending)\n    filtered_numbers.sort()\n\n    # FR4: Reversing Sorted Integers (descending)\n    filtered_numbers.reverse()\n\n    result_words = []\n    # FR5: Digit-to-Word Conversion\n    for number in filtered_numbers:\n        result_words.append(DIGIT_WORDS[number])\n\n    # FR7: Output Format\n    return result_words"}
{"task_id": "HumanEval/106", "solution": "def calculate_factorial(k: int) -> int:\n    \"\"\"\n    Computes the factorial of a given non-negative integer k.\n\n    Args:\n        k: A non-negative integer.\n\n    Returns:\n        The factorial of k (k!).\n\n    Raises:\n        TypeError: If k is not an integer.\n        ValueError: If k is a negative integer.\n    \"\"\"\n    if not isinstance(k, int):\n        raise TypeError(\"Input for factorial must be an integer.\")\n    if k < 0:\n        raise ValueError(\"Factorial is not defined for negative numbers.\")\n\n    if k == 0:\n        return 1\n\n    fact = 1\n    for j in range(1, k + 1):\n        fact *= j\n    return fact\ndef calculate_sum_up_to(k: int) -> int:\n    \"\"\"\n    Computes the sum of all positive integers from 1 up to a given non-negative integer k.\n\n    Args:\n        k: A non-negative integer.\n\n    Returns:\n        The sum of integers from 1 to k (1 + 2 + ... + k).\n\n    Raises:\n        TypeError: If k is not an integer.\n        ValueError: If k is a negative integer.\n    \"\"\"\n    if not isinstance(k, int):\n        raise TypeError(\"Input for sum must be an integer.\")\n    if k < 0:\n        raise ValueError(\"Sum from 1 to k is not defined for negative k.\")\n\n    if k == 0:\n        return 0\n\n    # Using the arithmetic series formula: k * (k + 1) / 2\n    return k * (k + 1) // 2\ndef f(n: int) -> list[int]:\n    \"\"\"\n    Generates a list of numbers based on specific mathematical rules applied\n    to each conceptual index 'i' (starting from 1) up to the input parameter 'n'.\n\n    For each index 'i':\n    - If 'i' is an even number, the corresponding list element is the factorial of 'i' (i!).\n    - If 'i' is an odd number, the corresponding list element is the sum of integers\n      from 1 to 'i' (1 + 2 + ... + i).\n\n    Args:\n        n: A non-negative integer representing the desired number of elements\n           in the output list.\n\n    Returns:\n        A list of integers generated according to the specified rules.\n\n    Raises:\n        TypeError: If n is not an integer.\n        ValueError: If n is a negative integer.\n\n    Examples:\n        >>> f(0)\n        []\n        >>> f(1)\n        [1]\n        >>> f(5)\n        [1, 2, 6, 24, 15]\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    result_list = []\n\n    for i in range(1, n + 1):  # Conceptual index i from 1 to n (inclusive)\n        if i % 2 == 0:  # i is an even number\n            result_list.append(calculate_factorial(i))\n        else:  # i is an odd number\n            result_list.append(calculate_sum_up_to(i))\n\n    return result_list"}
{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n: int) -> tuple[int, int]:\n    \"\"\"\n    Calculates the number of even and odd integer palindromes\n    within the range [1, n], inclusive.\n\n    Args:\n        n: A positive integer representing the upper bound of the range.\n           Constraint: 1 <= n <= 10^3.\n\n    Returns:\n        A tuple (even_count, odd_count) where even_count is the number\n        of even palindromes and odd_count is the number of odd palindromes.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for i in range(1, n + 1):\n        s = str(i)\n        if s == s[::-1]:  # Check if it's a palindrome\n            if i % 2 == 0:  # Check if it's an even number\n                even_count += 1\n            else:  # It's an odd number\n                odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/108", "solution": "def _calculate_signed_digit_sum(n: int) -> int:\n    \"\"\"\n    Calculates the signed digit sum of a single integer according to the specified rules.\n    \n    For positive numbers (or zero), it's the sum of its absolute digits.\n    For negative numbers, the first digit (after the minus sign) is treated as negative,\n    and all subsequent digits are positive.\n    \"\"\"\n    total_sum = 0\n    s = str(n)\n\n    if n < 0:\n        # For negative numbers, the first digit after the minus sign is negative.\n        # Example: -123 -> s = \"-123\". s[1] is '1'.\n        total_sum = -int(s[1])\n        # All subsequent digits are positive.\n        for digit_char in s[2:]:\n            total_sum += int(digit_char)\n    else:\n        # For positive numbers (and zero), all digits are positive.\n        for digit_char in s:\n            total_sum += int(digit_char)\n            \n    return total_sum\ndef count_nums(arr: list[int]) -> int:\n    \"\"\"\n    Counts the number of elements in an array whose signed digit sum is strictly greater than zero.\n\n    Args:\n        arr: A list of integers.\n\n    Returns:\n        The total count of numbers in the list whose signed digit sum is strictly greater than 0.\n    \"\"\"\n    count = 0\n    \n    # If arr is empty, the loop won't execute, and 0 will be returned,\n    # satisfying REQ-005.\n    for number in arr:\n        signed_sum = _calculate_signed_digit_sum(number)\n        if signed_sum > 0:\n            count += 1\n            \n    return count"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"\n    Determines if a given array (list) of unique integers can be sorted in non-decreasing\n    order by performing a series of right-shift operations.\n\n    A right-shift operation moves the last element to the first position, and all other\n    elements shift one position to the right. E.g., [1, 2, 3] becomes [3, 1, 2].\n\n    Args:\n        arr (list): A list of unique, comparable elements (e.g., integers).\n\n    Returns:\n        bool: True if the array can be sorted by right shifts, False otherwise.\n    \"\"\"\n    # FR1: Handle Empty Array\n    if not arr:\n        return True\n\n    # FR2: Generate Sorted Array\n    sorted_arr = sorted(arr)\n\n    # FR3: Cyclic Shift Check\n    # If arr can be sorted by right shifts, then arr must be a cyclic permutation\n    # of sorted_arr. This means arr (as a tuple) must appear as a contiguous\n    # sub-sequence within sorted_arr concatenated with itself.\n    original_tuple = tuple(arr)\n    sorted_tuple = tuple(sorted_arr)\n    \n    # Concatenate the sorted tuple with itself to easily check for cyclic shifts.\n    # For example, if sorted_tuple is (1, 2, 3), concatenated_sorted becomes (1, 2, 3, 1, 2, 3).\n    # Now, any cyclic shift of (1, 2, 3) (e.g., (3, 1, 2), (2, 3, 1)) will be a sub-tuple\n    # within concatenated_sorted.\n    concatenated_sorted = sorted_tuple + sorted_tuple\n    \n    # Check if the original array (as a tuple) is present as a sub-tuple\n    # in the concatenated sorted array.\n    return original_tuple in concatenated_sorted"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1: list[int], lst2: list[int]) -> str:\n    \"\"\"\n    Determines if it's possible to exchange elements between lst1 and lst2\n    such that lst1 becomes a list containing only even numbers.\n\n    The function counts the number of odd elements in lst1 that need to be replaced\n    and the number of even elements in lst2 that are available for replacement.\n    If the count of available even numbers in lst2 is greater than or equal to\n    the count of odd numbers in lst1, it returns \"YES\"; otherwise, \"NO\".\n\n    Args:\n        lst1: A non-empty list of integers.\n        lst2: A non-empty list of integers.\n\n    Returns:\n        \"YES\" if lst1 can be made all even, \"NO\" otherwise.\n    \"\"\"\n    odds_in_lst1 = 0\n    for number in lst1:\n        if number % 2 != 0:\n            odds_in_lst1 += 1\n\n    evens_in_lst2 = 0\n    for number in lst2:\n        if number % 2 == 0:\n            evens_in_lst2 += 1\n\n    if evens_in_lst2 >= odds_in_lst1:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/111", "solution": "import collections\ndef histogram(input_string: str) -> dict:\n    \"\"\"\n    Processes a string of space-separated lowercase letters and returns a dictionary\n    containing only those letters that have the maximum repetition count.\n\n    Args:\n        input_string: A string of space-separated lowercase letters, or an empty string.\n\n    Returns:\n        A dictionary where keys are letters and values are their counts,\n        filtered to include only letters with the maximum repetition count.\n        Returns an empty dictionary if the input string is empty or contains no letters.\n    \"\"\"\n    # REQ-008: Handle empty input string\n    if not input_string:\n        return {}\n\n    # REQ-002: Split the input string into a list of letters.\n    # Using split() without arguments handles multiple spaces and discards empty strings,\n    # which aligns with counting actual 'letters' rather than empty tokens from multiple spaces.\n    letters_list = input_string.split()\n\n    # If splitting results in an empty list (e.g., input was just spaces like '   '),\n    # return an empty dictionary as there are no letters to count.\n    if not letters_list:\n        return {}\n\n    # REQ-003: Count letter frequencies using collections.Counter for efficiency.\n    all_counts = collections.Counter(letters_list)\n\n    # REQ-004: Find the maximum repetition count among all unique letters.\n    # We've already ensured letters_list is not empty, so all_counts will not be empty here.\n    max_count = max(all_counts.values())\n\n    # REQ-005, REQ-006, REQ-007: Construct the output dictionary.\n    # It includes only letters whose counts match the maximum repetition count.\n    # Multiple letters sharing the same maximum count will all be included.\n    result_dict = {}\n    for letter, count in all_counts.items():\n        if count == max_count:\n            result_dict[letter] = count\n\n    return result_dict"}
{"task_id": "HumanEval/112", "solution": "def is_palindrome(text: str) -> bool:\n    \"\"\"\n    Determines if a given string is a palindrome.\n    An empty string or a string with a single character is considered a palindrome.\n    \"\"\"\n    return text == text[::-1]\ndef reverse_delete(s: str, c: str) -> tuple[str, bool]:\n    \"\"\"\n    Processes two input strings: deletes specific characters from the first string\n    based on the second, and then determines if the resulting string is a palindrome.\n\n    Args:\n        s: The primary input string from which characters will be deleted.\n        c: The second input string, containing characters to be deleted from s.\n\n    Returns:\n        A tuple (modified_string, is_palindrome_status).\n        - modified_string: The string resulting from deleting characters in c from s.\n        - is_palindrome_status: True if modified_string is a palindrome, False otherwise.\n    \"\"\"\n    # FR2, FR3, NFR1: Efficient character deletion\n    # Convert 'c' to a set for O(1) average time complexity lookups.\n    chars_to_delete_set = set(c)\n    \n    # Use a list to build the filtered string for efficiency (avoiding repeated string concatenations)\n    filtered_chars_list = []\n    for char_s in s:\n        if char_s not in chars_to_delete_set:\n            filtered_chars_list.append(char_s)\n            \n    modified_string = \"\".join(filtered_chars_list)\n    \n    # FR4: Palindrome Check\n    is_palindrome_status = is_palindrome(modified_string)\n    \n    # FR5: Output Format\n    return (modified_string, is_palindrome_status)"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst: list[str]) -> list[str]:\n    \"\"\"\n    Given a list of strings, where each string consists of only digits,\n    returns a list. Each element i of the output is \"the number of odd\n    elements Xn the strXng X of the Xnput.\" where X is the count of\n    odd digits in the i'th string of the input.\n\n    Args:\n        lst (list[str]): A list of strings, each containing only digits.\n\n    Returns:\n        list[str]: A list of formatted strings, each describing the count of\n                   odd digits in the corresponding input string.\n\n    Examples:\n        >>> odd_count(['1234567'])\n        [\"the number of odd elements 4n the str4ng 4 of the 4nput.\"]\n        >>> odd_count(['3',\"11111111\"])\n        [\"the number of odd elements 1n the str1ng 1 of the 1nput.\",\n         \"the number of odd elements 8n the str8ng 8 of the 8nput.\"]\n        >>> odd_count(['24680'])\n        [\"the number of odd elements 0n the str0ng 0 of the 0nput.\"]\n    \"\"\"\n    result_list = []\n\n    for input_string in lst:\n        current_string_odd_count = 0\n\n        for char_digit in input_string:\n            digit = int(char_digit)\n            if digit % 2 != 0:\n                current_string_odd_count += 1\n\n        count_str = str(current_string_odd_count)\n\n        formatted_output_string = (\n            \"the number of odd elements {}n the str{}ng {} of the {}nput.\".format(\n                count_str, count_str, count_str, count_str\n            )\n        )\n        result_list.append(formatted_output_string)\n\n    return result_list"}
{"task_id": "HumanEval/114", "solution": "from typing import List\nclass MinSubArraySumAlgorithm:\n    @staticmethod\n    def find_min_sum(nums: List[int]) -> int:\n        \"\"\"\n        Implements Kadane's algorithm variant to find the minimum sub-array sum.\n        Assumes nums is a non-empty list of integers.\n        Time Complexity: O(N)\n        Space Complexity: O(1)\n        \"\"\"\n        min_so_far = nums[0]      # Tracks the overall minimum sub-array sum found\n        current_min = nums[0]     # Tracks the minimum sub-array sum ending at the current position\n\n        for i in range(1, len(nums)):\n            num = nums[i]\n            # The minimum sub-array ending at `num` is either `num` itself,\n            # or `num` added to the minimum sub-array ending at the previous position.\n            current_min = min(num, current_min + num)\n            \n            # Update the overall minimum sum found\n            min_so_far = min(min_so_far, current_min)\n\n        return min_so_far\nclass MinSubArraySumService:\n    def calculate_min_sum(self, nums: List[int]) -> int:\n        \"\"\"\n        Calculates the minimum sum of any non-empty sub-array.\n\n        Args:\n            nums: A non-empty list of integers.\n\n        Returns:\n            The minimum sum of a non-empty sub-array.\n\n        Raises:\n            ValueError: If nums is empty or contains non-integer elements.\n        \"\"\"\n        if not isinstance(nums, list) or not nums:\n            raise ValueError(\"Input 'nums' must be a non-empty list.\")\n        if not all(isinstance(x, int) for x in nums):\n            raise ValueError(\"All elements in 'nums' must be integers.\")\n\n        # Delegate to core algorithm\n        return MinSubArraySumAlgorithm.find_min_sum(nums)\ndef minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array\n    of nums.\n    Example\n    minSubArraySum([2, 3, 4, 1, 2, 4]) == 1\n    minSubArraySum([-1, -2, -3]) == -6\n    \"\"\"\n    service = MinSubArraySumService()\n    return service.calculate_min_sum(nums)"}
{"task_id": "HumanEval/115", "solution": "import math\ndef max_fill(grid: list[list[int]], capacity: int) -> int:\n    \"\"\"\n    Calculates the total number of times buckets need to be lowered to empty all wells.\n\n    Args:\n        grid: A rectangular grid where each inner list represents a well.\n              '1' indicates a unit of water, '0' indicates no water.\n              Constraints: 1 <= len(grid) <= 100, 1 <= len(grid[0]) <= 100.\n              Each grid[i][j] is 0 or 1.\n        capacity: The maximum amount of water a bucket can hold per operation.\n                  Constraint: 1 <= capacity <= 10.\n\n    Returns:\n        The total number of bucket operations required.\n    \"\"\"\n    total_bucket_operations = 0\n\n    # FR1: Water Unit Counting per Well\n    for well in grid:\n        water_units_in_well = sum(well) \n\n        # FR2: Bucket Operations Calculation per Well\n        # FR4: Zero Water Wells\n        if water_units_in_well > 0:\n            operations_for_well = math.ceil(water_units_in_well / capacity)\n        else:\n            operations_for_well = 0 # No operations needed if well is empty\n        \n        # FR3: Total Bucket Operations Summation\n        total_bucket_operations += operations_for_well\n        \n    # FR6: Return Value\n    return total_bucket_operations"}
{"task_id": "HumanEval/116", "solution": "def _count_set_bits(n: int) -> int:\n    \"\"\"\n    Counts the number of '1's in the binary representation of a non-negative integer.\n    Uses Brian Kernighan's algorithm.\n    \"\"\"\n    count = 0\n    # Handle zero explicitly, although the loop handles it correctly\n    if n == 0:\n        return 0\n    # Ensure n is non-negative for this specific logic as per SRS.\n    # The calling function `sort_array` guarantees non-negative input for this helper.\n    if n < 0:\n        raise ValueError(\"Input to _count_set_bits must be non-negative.\")\n        \n    while n > 0:\n        n &= (n - 1)  # This clears the least significant set bit\n        count += 1\n    return count\ndef sort_array(arr: list[int]) -> list[int]:\n    \"\"\"\n    Sorts an array of integers based on custom logic:\n    1. Negative numbers are sorted numerically ascending.\n    2. Non-negative numbers are sorted primarily by the count of '1's in their\n       binary representation (ascending), then by their decimal value (ascending).\n    3. The final list is composed of sorted negative numbers followed by sorted\n       non-negative numbers.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n    if not arr:\n        return []\n\n    negative_numbers: list[int] = []\n    non_negative_numbers: list[int] = []\n\n    # 1. Separation and initial type checking\n    for item in arr:\n        if not isinstance(item, int):\n            raise TypeError(f\"All elements in 'arr' must be integers. Found: {type(item)}\")\n        if item < 0:\n            negative_numbers.append(item)\n        else:\n            non_negative_numbers.append(item)\n\n    # 2. Sort negative numbers (simple ascending)\n    negative_numbers.sort()\n\n    # 3. Sort non-negative numbers (by bit count then decimal value)\n    # The key function returns a tuple: (number_of_ones, original_value)\n    # Python's sort will correctly sort tuples lexicographically.\n    non_negative_numbers.sort(key=lambda x: (_count_set_bits(x), x))\n\n    # 4. Combine the sorted lists\n    return negative_numbers + non_negative_numbers"}
{"task_id": "HumanEval/117", "solution": "def select_words(s: str, n: int) -> list[str]:\n    \"\"\"\n    Identifies and returns a list of words from a given string that contain\n    a specific number of consonants.\n\n    Args:\n        s (str): The input string from which words are to be selected.\n        n (int): A natural number representing the exact count of consonants\n                 required in the selected words.\n\n    Returns:\n        list[str]: A list of words from the input string 's' that contain\n                   exactly 'n' consonants, in their original order.\n    \"\"\"\n    VOWELS_SET = {'a', 'e', 'i', 'o', 'u'}\n    \n    # FR3: Handle empty or whitespace-only input string\n    if not s.strip():\n        return []\n\n    result_words = []\n    \n    # FR4: Split the input string into individual words based on whitespace.\n    # s.split() correctly handles multiple spaces and leading/trailing spaces.\n    words = s.split()\n\n    # Iterate through each extracted word\n    for word in words:\n        consonant_count = 0\n        \n        # FR9: Convert word to lowercase for case-insensitive consonant/vowel checks\n        lower_word = word.lower()\n        \n        # Iterate through each character in the word\n        for char in lower_word:\n            # FR6: Check if character is an alphabetic character\n            if char.isalpha():\n                # FR6: Check if character is a consonant (not a vowel)\n                if char not in VOWELS_SET:\n                    consonant_count += 1\n        \n        # FR7: Filter by exact consonant count\n        # FR8: Append the original word (not the lowercase version) to maintain order\n        if consonant_count == n:\n            result_words.append(word)\n            \n    # FR2: Return the list of selected words\n    return result_words"}
{"task_id": "HumanEval/119", "solution": "def get_balance_info(s: str) -> tuple[int, int]:\n    \"\"\"\n    Calculates the minimum prefix balance and total balance for a given string of parentheses.\n\n    Args:\n        s: A string of parentheses.\n\n    Returns:\n        A tuple (min_prefix_balance, total_balance).\n    \"\"\"\n    current_balance = 0\n    min_prefix_balance = 0\n    for char in s:\n        if char == '(':\n            current_balance += 1\n        elif char == ')':\n            current_balance -= 1\n        min_prefix_balance = min(min_prefix_balance, current_balance)\n    return (min_prefix_balance, current_balance)\ndef check_balanced_concat(info1: tuple[int, int], info2: tuple[int, int]) -> bool:\n    \"\"\"\n    Determines if two strings, represented by their balance information, can form\n    a balanced string when concatenated in a specific order (first_string_info + second_string_info).\n\n    Args:\n        info1: A tuple (min_bal1, total_bal1) for the first string.\n        info2: A tuple (min_bal2, total_bal2) for the second string.\n\n    Returns:\n        True if the concatenated string is balanced, False otherwise.\n    \"\"\"\n    min_bal1, total_bal1 = info1\n    min_bal2, total_bal2 = info2\n\n    # Condition 1 (Total Balance): The total balance of the concatenated string must be zero.\n    if total_bal1 + total_bal2 != 0:\n        return False\n\n    # Condition 2 (Prefix of first string): The first string itself must not become\n    # negative at any point.\n    if min_bal1 < 0:\n        return False\n\n    # Condition 3 (Transition from first to second string): The balance maintained\n    # by the first string must be sufficient to cover any internal deficits in the\n    # second string when they are joined.\n    if total_bal1 + min_bal2 < 0:\n        return False\n\n    return True\ndef match_parens(lst: list[str]) -> str:\n    \"\"\"\n    Checks if concatenating two given parenthesis strings in either order results\n    in a balanced string.\n\n    Args:\n        lst: A list containing two strings s1 and s2.\n\n    Returns:\n        'Yes' if either s1+s2 or s2+s1 forms a balanced string, 'No' otherwise.\n    \"\"\"\n    s1 = lst[0]\n    s2 = lst[1]\n\n    info1 = get_balance_info(s1)\n    info2 = get_balance_info(s2)\n\n    # Check s1 + s2\n    if check_balanced_concat(info1, info2):\n        return 'Yes'\n\n    # Check s2 + s1\n    if check_balanced_concat(info2, info1):\n        return 'Yes'\n\n    return 'No'"}
{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Identifies and returns the k largest numbers from a given array of integers,\n    presented as a sorted list in ascending order.\n\n    Args:\n        arr (list[int]): The input array of integers.\n        k (int): A non-negative integer representing the number of maximum\n                 elements to retrieve.\n\n    Returns:\n        list[int]: A new list containing the k largest values from arr,\n                   sorted in ascending order.\n    \"\"\"\n    # FR-2: Handle the edge case where k is 0\n    if k == 0:\n        return []\n\n    # NFR-1, FR-2, FR-4: Sort the entire array in ascending order.\n    # This places the largest elements at the end and naturally sorts them.\n    # Python's sorted() function creates a new list, fulfilling O(N) space.\n    sorted_arr = sorted(arr)\n\n    # FR-2, FR-3: Extract the last k elements.\n    # These are the k largest, and they are already sorted in ascending order.\n    # The slice starts at (length_of_array - k) and goes to the end.\n    result = sorted_arr[len(sorted_arr) - k:]\n\n    # FR-4: The result is already sorted due to the initial sort.\n    return result"}
{"task_id": "HumanEval/121", "solution": "def solution(lst: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of all odd elements located at even positions\n    within a given non-empty list of integers.\n\n    An even position is an index i where i % 2 == 0 (0-based indexing).\n    An odd element is an integer n where n % 2 != 0.\n\n    Args:\n        lst: A non-empty list of integers.\n\n    Returns:\n        An integer representing the sum of odd elements found at even positions.\n    \"\"\"\n    total_sum = 0\n    for i, element in enumerate(lst):\n        # Check if the current index is an even position\n        if i % 2 == 0:\n            # If the position is even, check if the element itself is odd\n            if element % 2 != 0:\n                total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/122", "solution": "from typing import List\ndef add_elements(arr: List[int], k: int) -> int:\n    \"\"\"\n    Calculates the sum of elements from the first k elements of an array\n    that have at most two digits (i.e., between 0 and 99, inclusive).\n\n    Args:\n        arr: A non-empty list of integers.\n             Constraints: 1 <= len(arr) <= 100.\n        k: An integer representing the number of initial elements to consider.\n           Constraints: 1 <= k <= len(arr).\n\n    Returns:\n        An integer representing the accumulated sum of qualifying elements.\n    \"\"\"\n    current_sum = 0\n    # Iterate through the first k elements of the array\n    for i in range(k):\n        element = arr[i]\n        # Check if the element has at most two digits (0 to 99)\n        if 0 <= element <= 99:\n            current_sum += element\n    return current_sum"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n: int) -> list[int]:\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n\n    The Collatz conjecture is a conjecture in mathematics that concerns a sequence defined\n    as follows: start with any positive integer n. Then each term is obtained from the \n    previous term as follows: if the previous term is even, the next term is one half of \n    the previous term. If the previous term is odd, the next term is 3 times the previous\n    term plus 1. The conjecture is that no matter what value of n, the sequence will always reach 1.\n\n    Note: \n        1. Collatz(1) is [1].\n        2. returned list sorted in increasing order.\n\n    For example:\n    get_odd_collatz(5) returns [1, 5] # The collatz sequence for 5 is [5, 16, 8, 4, 2, 1], so the odd numbers are only 1, and 5.\n    \"\"\"\n    \n    odd_numbers_set = set() \n    current_n = n\n\n    while current_n != 1:\n        if current_n % 2 != 0: # Check if odd\n            odd_numbers_set.add(current_n) \n            current_n = (3 * current_n) + 1 \n        else: # Even\n            current_n = current_n // 2 \n            \n    # After loop, current_n is 1. Ensure 1 is always in the set as it's the final odd number.\n    odd_numbers_set.add(1) \n\n    sorted_odd_numbers = sorted(list(odd_numbers_set))\n    \n    return sorted_odd_numbers"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date_string: str) -> bool:\n    \"\"\"\n    Validates a date string according to the mm-dd-yyyy format and specific rules.\n\n    Args:\n        date_string: The date string to validate (e.g., '01-15-2023').\n\n    Returns:\n        True if the date string is valid, False otherwise.\n    \"\"\"\n    # REQ-DATE-002: Check for empty or None string\n    if date_string is None or len(date_string) == 0:\n        return False\n\n    # REQ-DATE-003: Check format length and separators\n    if len(date_string) != 10:\n        return False\n    if date_string[2] != '-' or date_string[5] != '-':\n        return False\n\n    # Split the string into components\n    parts = date_string.split('-')\n\n    # This check guards against unexpected splits, though length/hyphen checks should cover most cases\n    if len(parts) != 3:\n        return False\n\n    # REQ-DATE-004: Attempt to parse components as integers\n    try:\n        month = int(parts[0])\n        day = int(parts[1])\n        year = int(parts[2])  # REQ-DATE-009: Year has no specific range beyond being a valid int\n    except ValueError:  # Catches non-numeric parts\n        return False\n\n    # REQ-DATE-005: Validate month range\n    if month < 1 or month > 12:\n        return False\n\n    # REQ-DATE-006, REQ-DATE-007, REQ-DATE-008: Validate day range based on month\n    max_days_in_month = 0\n    \n    # Months with 31 days\n    DAYS_IN_MONTH_31 = {1, 3, 5, 7, 8, 10, 12}\n    # Months with 30 days\n    DAYS_IN_MONTH_30 = {4, 6, 9, 11}\n    # February\n    FEBRUARY_MONTH = 2\n\n    if month in DAYS_IN_MONTH_31:\n        max_days_in_month = 31\n    elif month in DAYS_IN_MONTH_30:\n        max_days_in_month = 30\n    elif month == FEBRUARY_MONTH:\n        max_days_in_month = 29  # Fixed to 29 days max, no leap year check (Design Constraint)\n    else:\n        # This case should ideally not be reached if month is already validated 1-12.\n        # Defensive programming: if it were reached, it indicates an invalid month value\n        return False\n\n    if day < 1 or day > max_days_in_month:\n        return False\n\n    # REQ-DATE-010: All checks passed\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt: str):\n    \"\"\"\n    Processes an input string by applying a series of conditional splitting rules\n    or, as a fallback, counting specific characters based on their ordinal values.\n\n    Args:\n        txt (str): The input string to process. Must be of type 'str'.\n\n    Returns:\n        list[str] or int:\n            - A list of strings if splitting by whitespace (FR-02) or comma (FR-03).\n            - An integer count if counting odd ordinal lowercase English letters (FR-04).\n\n    Raises:\n        TypeError: If 'txt' is not a string, may be raised by string methods.\n    \"\"\"\n    # FR-02: Whitespace Splitting Logic\n    # Check if the input string contains any whitespace characters.\n    # The any() function combined with a generator expression is efficient as it\n    # short-circuits as soon as the first whitespace character is found.\n    if any(char.isspace() for char in txt):\n        # Split by any sequence of whitespace characters.\n        # str.split() without arguments handles multiple internal whitespaces\n        # and discards empty strings resulting from leading/trailing whitespace.\n        return txt.split()\n\n    # FR-03: Comma Splitting Logic (Fallback)\n    # If no whitespace was found, check if the string contains a comma character.\n    if ',' in txt:\n        # Split by the comma character.\n        # str.split(',') preserves empty strings resulting from leading/trailing\n        # commas or multiple internal commas.\n        return txt.split(',')\n\n    # FR-04: Odd Ordinal Lowercase Letter Counting Logic (Fallback)\n    # If neither whitespace nor comma was found, iterate through the string\n    # and count lowercase English letters with an odd ordinal value relative to 'a'=0.\n    odd_ordinal_count = 0\n    ord_a = ord('a') # Ordinal value of 'a' to calculate relative ordinals.\n\n    for char in txt:\n        # Check if the character is a lowercase English letter ('a' through 'z').\n        # This check is explicit for ASCII lowercase English letters as per SRS.\n        if 'a' <= char <= 'z':\n            # Calculate the ordinal value relative to 'a'.\n            relative_ordinal = ord(char) - ord_a\n            # If the relative ordinal value is odd, increment the count.\n            if relative_ordinal % 2 != 0:\n                odd_ordinal_count += 1\n\n    return odd_ordinal_count"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst: list[int]) -> bool:\n    \"\"\"\n    Checks if a list of non-negative integers is sorted in ascending order\n    and ensures that no number appears more than twice.\n\n    Args:\n        lst: A list of non-negative integers (e.g., [0, 1, 2, 2, 3]).\n\n    Returns:\n        True if the list is sorted in ascending order and all numbers\n        appear at most twice; False otherwise.\n    \"\"\"\n    # Edge Case Handling: An empty list or a list with a single element\n    # is always considered sorted and trivially satisfies the duplicate constraint.\n    if len(lst) <= 1:\n        return True\n\n    # Initialize a frequency map to store counts of each number.\n    counts = {}\n    \n    # Add the first element to the frequency map.\n    # We know lst has at least two elements at this point.\n    counts[lst[0]] = 1\n\n    # Iterate through the list starting from the second element\n    # to perform both ascending order and duplicate count checks.\n    for i in range(1, len(lst)):\n        current_num = lst[i]\n        prev_num = lst[i - 1]\n\n        # FR1: Ascending Order Check\n        # If the current number is less than the previous number,\n        # the list is not sorted in ascending order.\n        if current_num < prev_num:\n            return False\n\n        # FR2: Duplicate Count Update & Check\n        # Increment the count for the current number.\n        # Use .get() with a default of 0 for numbers encountered for the first time.\n        counts[current_num] = counts.get(current_num, 0) + 1\n\n        # If any number appears three or more times, the constraint is violated.\n        if counts[current_num] > 2:\n            return False\n\n    # If the loop completes, it means both ascending order and duplicate count\n    # constraints are satisfied for the entire list.\n    return True"}
{"task_id": "HumanEval/127", "solution": "import math\ndef _calculate_intersection_length(interval1, interval2):\n    \"\"\"\n    Calculates the length of the intersection of two closed integer intervals.\n\n    Args:\n        interval1 (tuple): A tuple (start, end) representing the first closed interval.\n        interval2 (tuple): A tuple (start, end) representing the second closed interval.\n\n    Returns:\n        int: The length of the intersection. If intervals do not intersect, returns 0.\n    \"\"\"\n    s1, e1 = interval1\n    s2, e2 = interval2\n\n    max_start = max(s1, s2)\n    min_end = min(e1, e2)\n\n    # If max_start > min_end, intervals do not overlap or touch, length is 0.\n    # Otherwise, length is min_end - max_start.\n    length = max(0, min_end - max_start)\n    return length\ndef _is_prime(n):\n    \"\"\"\n    Determines if a given non-negative integer is a prime number.\n\n    Args:\n        n (int): The non-negative integer to check for primality.\n\n    Returns:\n        bool: True if n is prime, False otherwise.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:  # Check for even numbers > 2\n        return False\n\n    # Check for odd divisors from 3 up to sqrt(n)\n    # Using int(math.sqrt(n)) + 1 to ensure the loop includes the ceiling value if n is a perfect square\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    \n    return True\ndef intersection(interval1, interval2):\n    \"\"\"\n    Determines if the length of the intersection of two intervals is a prime number.\n\n    Args:\n        interval1 (tuple): A tuple (start, end) representing the first closed interval.\n        interval2 (tuple): A tuple (start, end) representing the second closed interval.\n\n    Returns:\n        str: \"YES\" if the length of the intersection is a prime number, \"NO\" otherwise.\n    \"\"\"\n    length = _calculate_intersection_length(interval1, interval2)\n    if _is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr: list[int]) -> int | None:\n    \"\"\"\n    Calculates the sum of magnitudes of integers multiplied by the product of all signs.\n\n    Args:\n        arr: A list of integers.\n\n    Returns:\n        The computed integer result, or None if the input array is empty.\n    \"\"\"\n    # F.1: Handling of Empty Array\n    if not arr:\n        return None\n\n    sum_magnitudes = 0  # F.2: Initializer for sum of absolute values\n    product_signs = 1   # F.3: Initializer for product of signs (multiplicative identity)\n\n    for number in arr:\n        # F.2: Accumulate sum of magnitudes\n        sum_magnitudes += abs(number)\n\n        # F.3: Determine and accumulate product of signs\n        current_sign = 0\n        if number > 0:\n            current_sign = 1\n        elif number < 0:\n            current_sign = -1\n        # If number is 0, current_sign remains 0\n\n        product_signs *= current_sign\n\n        # As per the design, the loop must complete to ensure sum_magnitudes\n        # is fully calculated, even if product_signs has already turned zero.\n        # An early exit here `if product_signs == 0:` would be an optimization\n        # for overall 0 result but would violate the requirement to calculate\n        # the full sum_magnitudes first.\n\n    # F.4: Final Calculation\n    return sum_magnitudes * product_signs"}
{"task_id": "HumanEval/129", "solution": "import heapq\nimport collections\nfrom typing import List, Tuple, Dict\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Identifies the lexicographically smallest path of a given length k within an N x N grid,\n    where each cell contains a unique integer.\n\n    Args:\n        grid: An N x N list of lists representing the grid.\n        k: The desired length of the path.\n\n    Returns:\n        A list of integers representing the lexicographically smallest path of length k.\n    \"\"\"\n    N = len(grid)\n    \n    # priority_queue: min-heap storing (path_tuple, current_row, current_col, current_length)\n    priority_queue: List[Tuple[Tuple[int, ...], int, int, int]] = []\n    \n    # best_paths_at_length: Dict[length, Dict[(row, col), path_tuple]]\n    # Stores the lexicographically smallest path found so far to reach (row, col) at a specific length.\n    best_paths_at_length: Dict[int, Dict[Tuple[int, int], Tuple[int, ...]]] = collections.defaultdict(dict)\n    \n    # Directions for moving to adjacent cells (right, left, down, up)\n    directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n\n    # Seed the Priority Queue: Any cell can be a starting point.\n    for r in range(N):\n        for c in range(N):\n            initial_value = grid[r][c]\n            initial_path_tuple = (initial_value,)\n            initial_length = 1\n            \n            heapq.heappush(priority_queue, (initial_path_tuple, r, c, initial_length))\n            best_paths_at_length[initial_length][(r, c)] = initial_path_tuple\n\n    # Main Loop (Path Exploration)\n    while priority_queue:\n        current_path_tuple, r, c, length = heapq.heappop(priority_queue)\n\n        # Pruning Check: If a lexicographically smaller path has already been found\n        # and processed for this state (length, r, c), this current path is suboptimal.\n        # This check is essential for efficiency in Dijkstra-like algorithms.\n        if current_path_tuple > best_paths_at_length[length][(r, c)]:\\\n            continue\n\n        # Goal Check: If the current path has the desired length k, it's the answer.\n        if length == k:\n            return list(current_path_tuple)\n\n        # Expand Path (if length < k): Explore neighbors\n        if length < k: # This condition is technically redundant with the goal check above, but emphasizes intent.\n            for dr, dc in directions:\n                nr, nc = r + dr, c + dc\n\n                # Boundary Check: Ensure neighbor is within grid boundaries\n                if 0 <= nr < N and 0 <= nc < N:\n                    new_value = grid[nr][nc]\n                    new_path_tuple = current_path_tuple + (new_value,)\n                    new_length = length + 1\n\n                    # Update Best Paths and Enqueue:\n                    # Retrieve the existing best path for (nr, nc) at new_length.\n                    existing_best_path = best_paths_at_length[new_length].get((nr, nc))\n\n                    # If no path to this state yet, or if the new path is lexicographically better\n                    if existing_best_path is None or new_path_tuple < existing_best_path:\n                        best_paths_at_length[new_length][(nr, nc)] = new_path_tuple\n                        heapq.heappush(priority_queue, (new_path_tuple, nr, nc, new_length))\n    \n    # This part should ideally not be reached if k is always achievable as per problem constraints.\n    # If it is reached, it implies no path of length k was found.\n    return []"}
{"task_id": "HumanEval/130", "solution": "def _calculate_tri(k, memo):\n    # 1. Memoization Check\n    if k in memo:\n        return memo[k]\n\n    # 2. Base Cases\n    if k == 0:\n        memo[0] = 1  # Derived from even rule: 1 + 0/2 = 1\n    elif k == 1:\n        memo[1] = 3  # Given in problem description\n    # 3. Even k\n    elif k % 2 == 0:\n        memo[k] = 1 + k // 2\n    # 4. Odd k\n    else:  # k % 2 != 0 and k > 1\n        # Recursively calculate dependencies, memoization will handle cycles/redundancy\n        val_k_minus_1 = _calculate_tri(k - 1, memo)\n        val_k_minus_2 = _calculate_tri(k - 2, memo)\n        val_k_plus_1 = _calculate_tri(k + 1, memo) # Critical dependency\n        memo[k] = val_k_minus_1 + val_k_minus_2 + val_k_plus_1\n\n    # 5. Return Value\n    return memo[k]\ndef tri(n):\n    # Input validation (as specified in Detailed Design)\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    # 1. Initialize Memoization\n    memo = {}\n\n    # 2. Result List\n    result = []\n\n    # 3. Populate Result List\n    # We need to compute tri(0) up to tri(n)\n    for i in range(n + 1):\n        result.append(_calculate_tri(i, memo))\n\n    # 4. Return\n    return result"}
{"task_id": "HumanEval/131", "solution": "def digits(n: int) -> int:\n    \"\"\"\n    Calculates the product of all odd digits in a given positive integer.\n    If no odd digits are found, it returns 0.\n\n    Args:\n        n: A positive integer.\n\n    Returns:\n        An integer representing the product of its odd digits,\n        or 0 if all digits are even.\n    \"\"\"\n    product = 1\n    found_odd_digit = False\n\n    # Convert the integer to a string to easily iterate through its digits\n    n_str = str(n)\n\n    for digit_char in n_str:\n        digit_val = int(digit_char)\n        # Check if the digit is odd\n        if digit_val % 2 != 0:\n            product *= digit_val\n            found_odd_digit = True\n\n    # If no odd digits were found, return 0 as per FR2\n    if not found_odd_digit:\n        return 0\n    else:\n        return product"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string: str) -> bool:\n    \"\"\"\n    Determines if a given string, consisting solely of square brackets,\n    contains a valid subsequence of brackets where at least one bracket\n    in that subsequence is considered \"nested\".\n\n    A minimal nested sequence requires the pattern `[[]]`. This function\n    checks for the existence of four characters string[idx1], string[idx2],\n    string[idx3], string[idx4] such that idx1 < idx2 < idx3 < idx4 and\n    string[idx1] == '[', string[idx2] == '[', string[idx3] == ']',\n    string[idx4] == ']'.\n\n    Args:\n        string: The input string containing only '[' and ']'.\n\n    Returns:\n        True if such a nested subsequence exists, False otherwise.\n    \"\"\"\n    \n    # Find the first opening bracket '[' (idx1)\n    idx1 = string.find('[')\n    if idx1 == -1:\n        return False\n\n    # Find the second opening bracket '[' (idx2) after idx1\n    idx2 = string.find('[', idx1 + 1)\n    if idx2 == -1:\n        return False\n\n    # Find the first closing bracket ']' (idx3) after idx2\n    idx3 = string.find(']', idx2 + 1)\n    if idx3 == -1:\n        return False\n\n    # Find the second closing bracket ']' (idx4) after idx3\n    idx4 = string.find(']', idx3 + 1)\n    if idx4 == -1:\n        return False\n\n    # If all four indices are found in the correct increasing order,\n    # it means a '[[]]' subsequence exists.\n    return True"}
{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst: list) -> int:\n    \"\"\"\n    Calculates the sum of squares of ceiling-rounded numbers in a list.\n\n    Args:\n        lst (list): A list of numbers (integers or floats).\n\n    Returns:\n        int: The sum of the squares of the ceiling-rounded numbers.\n             Returns 0 for an empty list.\n    \"\"\"\n    total_sum = 0\n    for number in lst:\n        rounded_number = math.ceil(number)\n        # math.ceil returns a float. We convert to int before squaring\n        # to ensure operations are on integer values as per conceptual design,\n        # though Python can handle float squares correctly.\n        squared_value = int(rounded_number) ** 2\n        total_sum += squared_value\n    return total_sum"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt: str) -> bool:\n    \"\"\"\n    Determines if the last character of a given string is an alphabetical character\n    and is considered \"isolated\" (not part of a multi-character word).\n\n    Args:\n        txt: The input string to be analyzed.\n\n    Returns:\n        True: If the last character is an isolated alphabetical character.\n        False: Otherwise.\n    \"\"\"\n    # FR-002: Handling Empty String\n    if not txt:\n        return False\n\n    # Retrieve Last Character\n    last_char = txt[-1]\n\n    # FR-003: Last Character Type Check\n    if not last_char.isalpha():\n        return False\n\n    # FR-004: Single Character String Check\n    if len(txt) == 1:\n        return True\n\n    # For strings with more than one character:\n    # Retrieve the character immediately preceding the last character.\n    char_before_last = txt[-2]\n\n    # FR-005: Isolated Last Letter Check\n    if char_before_last == ' ':\n        return True\n    # FR-006: Non-Isolated Last Letter Check\n    else:\n        return False"}
{"task_id": "HumanEval/135", "solution": "from typing import List, Union\ndef can_arrange(arr: List[Union[int, float]]) -> int:\n    \"\"\"\n    Finds the largest index i such that arr[i] < arr[i-1].\n\n    Args:\n        arr: A list of numbers (integers or floats).\n             The list is guaranteed not to contain duplicate values.\n\n    Returns:\n        The largest index i where arr[i] is strictly less than arr[i-1].\n        Returns -1 if no such element exists (e.g., the array is sorted\n        non-decreasingly, or has fewer than two elements).\n    \"\"\"\n    # Handle edge cases where the list has fewer than two elements,\n    # making it impossible to satisfy the arr[i-1] condition.\n    if len(arr) < 2:\n        return -1\n\n    # Iterate from the second-to-last element down to the second element (index 1).\n    # This ensures that i-1 is always a valid index (at least 0).\n    # By iterating from right to left, the first 'i' found will be the largest.\n    for i in range(len(arr) - 1, 0, -1):\n        # Check if the current element is strictly less than its preceding element.\n        if arr[i] < arr[i-1]:\n            # If the condition is met, this is the largest such index, so return it.\n            return i\n\n    # If the loop completes without finding any such index, it means\n    # no element arr[i] is strictly less than arr[i-1] anywhere in the list.\n    # This includes cases where the list is sorted in non-decreasing order.\n    return -1"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst: list) -> tuple:\n    \"\"\"\n    Finds the largest negative and smallest positive integers in a list.\n\n    Args:\n        lst: A list of integers.\n\n    Returns:\n        A tuple (a, b) where a is the largest negative integer and b is the \n        smallest positive integer. If no negative integers are found, a is None.\n        If no positive integers are found, b is None.\n    \"\"\"\n    largest_neg = None\n    smallest_pos = None\n\n    for num in lst:\n        if num < 0:\n            # If it's the first negative or a larger negative (closer to 0)\n            if largest_neg is None or num > largest_neg:\n                largest_neg = num\n        elif num > 0:\n            # If it's the first positive or a smaller positive (closer to 0)\n            if smallest_pos is None or num < smallest_pos:\n                smallest_pos = num\n        # If num == 0, it's ignored as per requirements\n\n    return (largest_neg, smallest_pos)"}
{"task_id": "HumanEval/137", "solution": "def _convert_to_comparable_float(value):\n    \"\"\"\n    Converts a value (int, float, or string representing a real number)\n    to a float for numerical comparison.\n    Handles both '.' and ',' as decimal separators for strings.\n\n    Args:\n        value (int | float | str): The input value.\n\n    Returns:\n        float: The float representation of the value.\n\n    Raises:\n        TypeError: If the input value is not an int, float, or str.\n        ValueError: If a string cannot be converted to a float.\n    \"\"\"\n    if isinstance(value, (int, float)):\n        return float(value)\n    elif isinstance(value, str):\n        # Replace comma with dot for consistent float conversion\n        cleaned_string = value.replace(\",\", \".\")\n        return float(cleaned_string)\n    else:\n        raise TypeError(\n            f\"Unsupported input type for comparison: {type(value)}. \"\n            \"Expected int, float, or str.\"\n        )\ndef compare_one(a, b):\n    \"\"\"\n    Compares two input values (integers, floats, or strings representing\n    real numbers) and returns the numerically larger one in its original type,\n    or None if they are numerically equal.\n\n    Args:\n        a (int | float | str): The first value to compare.\n        b (int | float | str): The second value to compare.\n\n    Returns:\n        int | float | str | None: The larger value in its original type,\n                                 or None if values are numerically equal.\n\n    Raises:\n        TypeError: If an input value has an unsupported type.\n        ValueError: If a string input cannot be converted to a float.\n    \"\"\"\n    # Convert both inputs to comparable float representations\n    numeric_a = _convert_to_comparable_float(a)\n    numeric_b = _convert_to_comparable_float(b)\n\n    # Perform the numerical comparison\n    if numeric_a > numeric_b:\n        return a\n    elif numeric_b > numeric_a:\n        return b\n    else:  # numeric_a == numeric_b\n        return None"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n: int) -> bool:\n    \"\"\"\n    Determines if a given integer n can be expressed as the sum of exactly four\n    positive even integers.\n\n    Args:\n        n: The input integer.\n\n    Returns:\n        True if n can be expressed as the sum of four positive even integers,\n        False otherwise.\n    \"\"\"\n    # The minimum sum of four positive even integers is 2 + 2 + 2 + 2 = 8.\n    # If n is less than 8, it cannot be formed by summing four positive even numbers.\n    if n < 8:\n        return False\n\n    # The sum of any four even numbers must always be an even number.\n    # If n is an odd number, it cannot be formed by summing four even numbers.\n    if n % 2 != 0:\n        return False\n\n    # If n is an even number and n is 8 or greater, it is always possible\n    # to express n as the sum of four positive even numbers.\n    # For example, 2 + 2 + 2 + (n - 6).\n    # Since n is even, (n - 6) will be even.\n    # Since n >= 8, (n - 6) >= 2, making it a positive even number.\n    return True"}
{"task_id": "HumanEval/139", "solution": "import math\ndef special_factorial(n: int) -> int:\n    \"\"\"\n    Calculates the Brazilian factorial, defined as n! * (n-1)! * (n-2)! * ... * 1!.\n\n    Args:\n        n (int): A positive integer.\n\n    Returns:\n        int: The calculated Brazilian factorial of n.\n\n    Raises:\n        TypeError: If n is not an integer.\n        ValueError: If n is not a positive integer (n <= 0).\n    \"\"\"\n    # 1. Input Validation\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"Input must be a positive integer (n > 0).\")\n\n    # 2. Initialization\n    brazilian_factorial_result = 1\n\n    # 3. Iteration\n    # Loop with a counter i ranging from n down to 1 (inclusive).\n    for i in range(n, 0, -1):\n        # Calculate the standard factorial of i.\n        current_factorial = math.factorial(i)\n        # Multiply brazilian_factorial_result by current_factorial.\n        brazilian_factorial_result *= current_factorial\n\n    # 4. Return\n    return brazilian_factorial_result"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(text: str) -> str:\n    \"\"\"\n    Transforms a given string by replacing specific patterns of spaces with underscores or hyphens.\n\n    Rules:\n    - Single space characters (' ') are replaced with an underscore ('_').\n    - Sequences of exactly two consecutive space characters ('  ') are replaced by two underscores ('__').\n    - Sequences of three or more consecutive space characters ('   ', '    ', etc.) are replaced by a single hyphen ('-').\n\n    Args:\n        text: The input string to be processed.\n\n    Returns:\n        The transformed string.\n    \"\"\"\n    result_chars = []\n    i = 0\n    n = len(text)\n\n    while i < n:\n        if text[i] != ' ':\n            result_chars.append(text[i])\n            i += 1\n        else:  # Current character is a space\n            space_count = 0\n            j = i\n            while j < n and text[j] == ' ':\n                space_count += 1\n                j += 1\n            \n            # Apply replacement rules based on space_count\n            if space_count > 2:\n                result_chars.append('-')\n            else:  # space_count is 1 or 2\n                for _ in range(space_count):\n                    result_chars.append('_')\n            \n            # Move the main pointer past the processed spaces\n            i = j\n            \n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name: str) -> str:\n    \"\"\"\n    Validates a file name based on a predefined set of rules.\n\n    Args:\n        file_name (str): The string representing the file name to be validated.\n\n    Returns:\n        str: 'Yes' if the file_name meets all specified validation criteria,\n             'No' if the file_name fails any of the specified validation criteria.\n    \"\"\"\n\n    # Check for empty file name as it cannot satisfy rules like \"pre-dot not empty\"\n    if not file_name:\n        return 'No'\n\n    # F.3.2: The `file_name` SHALL contain EXACTLY one dot ('.').\n    dot_count = file_name.count('.')\n    if dot_count != 1:\n        return 'No'\n\n    dot_index = file_name.find('.')\n\n    name_part = file_name[:dot_index]\n    extension_part = file_name[dot_index + 1:]\n\n    # F.3.3.1: The substring before the dot SHALL NOT be empty.\n    if not name_part:\n        return 'No'\n\n    # F.3.3.2: The substring before the dot SHALL start with a letter from the Latin alphabet.\n    # Latin Alphabet: 'a'-'z' and 'A'-'Z'.\n    if not name_part[0].isalpha():\n        return 'No'\n\n    # F.3.4.1: The substring after the dot (file extension) SHALL be one of 'txt', 'exe', or 'dll'.\n    valid_extensions = ['txt', 'exe', 'dll']\n    if extension_part not in valid_extensions:\n        return 'No'\n\n    # F.3.1: The `file_name` SHALL NOT contain more than three digits ('0'-'9').\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':  # Equivalent to char.isdigit() for ASCII digits\n            digit_count += 1\n\n    if digit_count > 3:\n        return 'No'\n\n    # If all checks pass, the file name is valid.\n    return 'Yes'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst: list[int]) -> int:\n    \"\"\"\n    Processes a list of integers, applying specific transformations to elements\n    based on their index, and then returns the sum of the (transformed or original) elements.\n\n    - If the index 'i' is a multiple of 3, the element is squared.\n    - Else, if the index 'i' is a multiple of 4, the element is cubed.\n    - Otherwise, the element remains unchanged.\n\n    The original input list remains immutable.\n\n    Args:\n        lst: A list of integers.\n\n    Returns:\n        An integer representing the sum of all transformed or unchanged elements.\n        Returns 0 if the input list is empty.\n    \"\"\"\n    total_sum = 0\n\n    for i, num in enumerate(lst):\n        current_value_for_sum = num  # Default to no change\n\n        if i % 3 == 0:\n            current_value_for_sum = num * num\n        elif i % 4 == 0:  # This condition is only checked if i % 3 != 0\n            current_value_for_sum = num * num * num\n        \n        total_sum += current_value_for_sum\n\n    return total_sum"}
{"task_id": "HumanEval/143", "solution": "import math\ndef is_prime(n: int) -> bool:\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\ndef words_in_sentence(sentence: str) -> str:\n    prime_length_words = []\n    \n    words = sentence.split(' ')\n    \n    for word in words:\n        word_length = len(word)\n        \n        if is_prime(word_length):\n            prime_length_words.append(word)\n            \n    return ' '.join(prime_length_words)"}
{"task_id": "HumanEval/144", "solution": "def gcd(a, b):\n    \"\"\"\n    Calculates the Greatest Common Divisor (GCD) of two non-negative integers\n    using the Euclidean algorithm.\n    \"\"\"\n    while b:\n        a, b = b, a % b\n    return a\ndef parse_fraction(fraction_str):\n    \"\"\"\n    Converts a string representation of a fraction into its constituent\n    numerator and denominator as integers.\n    \"\"\"\n    parts = fraction_str.split('/')\n    numerator = int(parts[0])\n    denominator = int(parts[1])\n    return (numerator, denominator)\ndef multiply_fractions(frac1, frac2):\n    \"\"\"\n    Multiplies two fractions and returns the simplified product.\n    frac1 and frac2 are tuples of (numerator, denominator).\n    \"\"\"\n    num1, den1 = frac1\n    num2, den2 = frac2\n\n    raw_product_numerator = num1 * num2\n    raw_product_denominator = den1 * den2\n\n    # Simplify the product fraction using GCD to prevent potential overflow\n    # and ensure the whole number check is efficient.\n    common_divisor = gcd(raw_product_numerator, raw_product_denominator)\n\n    simplified_numerator = raw_product_numerator // common_divisor\n    simplified_denominator = raw_product_denominator // common_divisor\n    \n    return (simplified_numerator, simplified_denominator)\ndef is_whole_number(fraction):\n    \"\"\"\n    Determines if a given fraction (represented as a tuple of numerator and denominator)\n    evaluates to a whole number.\n    \"\"\"\n    numerator, denominator = fraction\n    return numerator % denominator == 0\ndef simplify(x, n):\n    \"\"\"\n    Determines if the product of two fractional string representations \n    evaluates to a whole number.\n\n    Args:\n        x (str): The first fraction string in \"numerator/denominator\" format.\n        n (str): The second fraction string in \"numerator/denominator\" format.\n\n    Returns:\n        bool: True if the product is a whole number, False otherwise.\n    \"\"\"\n    # FR1: Fraction Parsing\n    x_parsed = parse_fraction(x)\n    n_parsed = parse_fraction(n)\n\n    # FR2: Fraction Multiplication (with simplification)\n    product_fraction = multiply_fractions(x_parsed, n_parsed)\n\n    # FR3: Whole Number Determination\n    # FR4: Boolean Output\n    return is_whole_number(product_fraction)"}
{"task_id": "HumanEval/145", "solution": "def _calculate_sum_digits(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the absolute value of the digits of an integer.\n\n    For example:\n    >>> _calculate_sum_digits(123) == 6\n    >>> _calculate_sum_digits(-45) == 9\n    >>> _calculate_sum_digits(0) == 0\n    \"\"\"\n    s = 0\n    n_abs = abs(n)\n    if n_abs == 0:\n        return 0\n    # Iteratively sum digits\n    while n_abs > 0:\n        s += n_abs % 10\n        n_abs //= 10\n    return s\ndef order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of integers in ascending order according to the sum of their digits.\n    If there are several items with similar sum of their digits,\n    order them based on their index in the original list.\n\n    Args:\n        nums: A list of integers to be sorted.\n\n    Returns:\n        A new list of integers sorted according to the specified rules.\n        The original input list `nums` is not modified.\n\n    For example:\n    >>> order_by_points([1, 11, -1, -11, -12]) == [-1, -11, 1, -12, 11]\n    >>> order_by_points([]) == []\n    >>> order_by_points([10, 1, 100]) == [1, 10, 100] # sum=1 for all, sorted by index\n    \"\"\"\n    if not nums:\n        return []\n\n    # Step 1: Pair each number with its original index to preserve order for tie-breaking.\n    # Format: [(value, original_index), ...]\n    items_with_index = [(value, i) for i, value in enumerate(nums)]\n\n    # Step 2 & 3: Sort the list using a custom key.\n    # The key function returns a tuple: (sum_of_digits, original_index).\n    # Python's `sorted` will use this tuple for comparisons, sorting primarily\n    # by sum_of_digits and secondarily by original_index, both in ascending order.\n    sorted_items = sorted(\n        items_with_index,\n        key=lambda item: (_calculate_sum_digits(item[0]), item[1])\n    )\n\n    # Step 4: Extract the original values from the sorted list of tuples\n    # to form the final result.\n    result = [item[0] for item in sorted_items]\n\n    return result"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums: list) -> int:\n    \"\"\"\n    Filters an array of numbers and counts elements that meet specific criteria.\n\n    A number is considered \"special\" if:\n    1. It is strictly greater than 10.\n    2. Its first digit (when represented as a positive integer string) is odd.\n    3. Its last digit (when represented as a positive integer string) is odd.\n\n    Args:\n        nums: A list of numbers (integers or floats).\n\n    Returns:\n        An integer representing the count of special numbers in the input list.\n    \"\"\"\n    special_count = 0\n    for num in nums:\n        # F3: Number Value Check - Must be strictly greater than 10\n        if num <= 10:\n            continue\n\n        # Convert the number to a string to easily access its digits.\n        # This handles both integers and floats as per assumption.\n        num_str = str(num)\n\n        # F4: First Digit Odd Check\n        # The first character of the string represents the first digit.\n        # The SRS implies positive numbers for digit checks because of \"greater than 10\".\n        first_digit_char = num_str[0]\n        try:\n            first_digit = int(first_digit_char)\n        except ValueError:\n            # This handles cases like floats where num_str could be \"12.0\" and first_digit_char is '1'\n            # or if num was extremely large/small and its string representation started with 'e' or similar.\n            # Based on the SRS, we assume valid numerical input where the first char is a digit.\n            # However, for robustness, a non-digit first character should lead to skipping.\n            continue \n\n        if first_digit % 2 == 0:  # If the first digit is even\n            continue\n\n        # F5: Last Digit Odd Check\n        # The last character of the string represents the last digit.\n        last_digit_char = num_str[-1]\n        try:\n            last_digit = int(last_digit_char)\n        except ValueError:\n            # Similar robustness for last digit. If num is 15.0, last_digit_char would be '0'.\n            # If num is 15.7, last_digit_char would be '7'.\n            continue\n\n        if last_digit % 2 == 0:  # If the last digit is even\n            continue\n\n        # F6: All conditions met, increment the counter\n        special_count += 1\n\n    # F7: Return the total count\n    return special_count"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n: int) -> int:\n    \"\"\"\n    Calculates the number of unique ordered triples (a[i], a[j], a[k]) from an\n    integer array 'a' (where a[x] = x*x - x + 1) such that i < j < k and their\n    sum a[i] + a[j] + a[k] is a multiple of 3.\n\n    The calculation is optimized to O(1) time complexity by leveraging modular\n    arithmetic properties of a[x] and counting combinations.\n\n    Args:\n        n (int): The upper bound for array indices (1 <= x <= n).\n                 Must be a positive integer (n >= 1).\n\n    Returns:\n        int: The total count of valid triples. Returns 0 if n < 3.\n    \"\"\"\n\n    # Helper function to calculate combinations k choose 3\n    # k * (k-1) * (k-2) / (3 * 2 * 1)\n    def _combinations_k_3(k: int) -> int:\n        if k < 3:\n            return 0\n        return (k * (k - 1) * (k - 2)) // 6\n\n    # Edge case: If n is less than 3, it's impossible to form a triple (i, j, k)\n    # with i < j < k.\n    if n < 3:\n        return 0\n\n    # Step 3: Count indices x (1 <= x <= n) based on x % 3\n    # Let q be the quotient and r be the remainder when n is divided by 3.\n    q = n // 3\n    r = n % 3\n\n    # Count of x such that x % 3 == 0\n    count_i_mod_0 = q\n    # Count of x such that x % 3 == 1\n    count_i_mod_1 = q + (1 if r >= 1 else 0)\n    # Count of x such that x % 3 == 2\n    count_i_mod_2 = q + (1 if r >= 2 else 0)\n\n    # Step 4: Map index counts to a[x] counts modulo 3\n    # Based on the analysis:\n    #   a[x] % 3 == 0 when x % 3 == 2\n    #   a[x] % 3 == 1 when x % 3 == 0 or x % 3 == 1\n\n    # C0: Count of a[x] values such that a[x] % 3 == 0\n    C0 = count_i_mod_2\n    # C1: Count of a[x] values such that a[x] % 3 == 1\n    C1 = count_i_mod_0 + count_i_mod_1\n\n    # Step 5: Calculate Combinations\n    # A triple (a[i], a[j], a[k]) sums to a multiple of 3 only if all three\n    # elements have a remainder of 0 when divided by 3, OR all three have\n    # a remainder of 1 when divided by 3.\n    # Therefore, we calculate combinations of 3 from C0 and combinations of 3 from C1.\n    total_triples = _combinations_k_3(C0) + _combinations_k_3(C1)\n\n    return total_triples"}
{"task_id": "HumanEval/148", "solution": "PLANETS = (\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\")\ndef bf(planet1: str, planet2: str) -> tuple:\n    \"\"\"\n    Identifies planets located strictly between two given planets in our solar system,\n    returning them sorted by their proximity to the Sun.\n\n    Args:\n        planet1 (str): The name of the first planet.\n        planet2 (str): The name of the second planet.\n\n    Returns:\n        tuple: A tuple of strings containing the names of planets whose orbits are\n               strictly between `planet1` and `planet2`, sorted from closest to\n               furthest from the Sun. Returns an empty tuple `()` if either\n               `planet1` or `planet2` is not a recognized planet name.\n    \"\"\"\n    if planet1 not in PLANETS or planet2 not in PLANETS:\n        return ()\n\n    idx1 = PLANETS.index(planet1)\n    idx2 = PLANETS.index(planet2)\n\n    start_bound = min(idx1, idx2)\n    end_bound = max(idx1, idx2)\n\n    # Strictly between the planets, so adjust indices\n    slice_start_index = start_bound + 1\n    slice_end_index = end_bound\n\n    intermediate_planets_list = PLANETS[slice_start_index:slice_end_index]\n    \n    return tuple(intermediate_planets_list)"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst: list) -> int:\n    \"\"\"\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd, positive integers.\n    Ignore numbers that are negative, zero, even, or not integers (e.g., floats, strings).\n\n    Args:\n        lst: A list of numbers (or mixed types).\n\n    Returns:\n        An integer, the sum of squares of qualifying numbers.\n        Returns 0 if the input list is empty or contains no qualifying numbers.\n\n    Examples:\n        double_the_difference([1, 3, 2, 0]) == 10\n        double_the_difference([-1, -2, 0]) == 0\n        double_the_difference([9, -2]) == 81\n        double_the_difference([0]) == 0\n        double_the_difference([]) == 0\n        double_the_difference([True, 5, \"hello\"]) == 26  (True is 1, so 1*1 + 5*5 = 26)\n    \"\"\"\n    sum_of_squares = 0\n\n    for element in lst:\n        # FR-3, FR-4: Check if element is an integer. Includes True (1) and False (0).\n        if not isinstance(element, int):\n            continue\n\n        # FR-5, FR-6: Check if element is positive.\n        if element <= 0:\n            continue\n\n        # FR-7, FR-8: Check if element is odd.\n        if element % 2 == 0:  # If even\n            continue\n\n        # FR-9: If all checks pass (integer, positive, odd), calculate its square and add to sum.\n        sum_of_squares += (element * element)\n\n    # FR-10: Return the final sum.\n    return sum_of_squares"}
{"task_id": "HumanEval/152", "solution": "def compare(game: list, guess: list) -> list:\n    \"\"\"\n    Compares two lists of numerical scores element-wise and calculates the \n    absolute difference between corresponding elements.\n\n    Args:\n        game: A list of numerical values (integers or floats) representing actual scores.\n        guess: A list of numerical values (integers or floats) representing guessed scores.\n               Both lists are assumed to be of equal length and contain numerical values.\n\n    Returns:\n        A new list where each element is the absolute difference between the \n        corresponding elements in the 'game' and 'guess' lists.\n    \"\"\"\n    result_list = []\n    # According to SRS FR3, game and guess lists are guaranteed to be of equal length.\n    n = len(game)\n\n    for i in range(n):\n        game_score = game[i]\n        guess_score = guess[i]\n        difference = abs(game_score - guess_score)\n        result_list.append(difference)\n\n    return result_list"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name: str, extensions: list[str]) -> str:\n    \"\"\"\n    Identifies the strongest extension from a given list based on a calculated\n    'strength' metric and returns the class name concatenated with the\n    strongest extension.\n\n    The strength of an extension string is calculated as:\n    Strength = (Count of Uppercase letters) - (Count of lowercase letters)\n\n    If multiple extensions have the same highest strength, the first one\n    encountered in the 'extensions' list is chosen (tie-breaking rule).\n\n    If the 'extensions' list is empty, the function returns the 'class_name'\n    as is.\n\n    Args:\n        class_name (str): The base class name.\n        extensions (list[str]): A list of potential extension names.\n\n    Returns:\n        str: A string formatted as 'class_name + strongest_extension_name'.\n             If the extensions list is empty, returns 'class_name'.\n    \"\"\"\n    if not extensions:\n        return class_name\n\n    max_strength = float('-inf')\n    strongest_extension = \"\"\n\n    for extension_name in extensions:\n        cap_count = 0\n        sm_count = 0\n        for char in extension_name:\n            if char.isupper():\n                cap_count += 1\n            elif char.islower():\n                sm_count += 1\n        \n        current_strength = cap_count - sm_count\n\n        # Compare and update strongest extension\n        # Tie-breaking: if current_strength == max_strength, the existing\n        # strongest_extension (which was found earlier) is preserved.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension = extension_name\n    \n    return class_name + strongest_extension"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a: str, b: str) -> bool:\n    \"\"\"\n    Checks if the second word (b) or any of its rotations is a substring in the first word (a).\n\n    Args:\n        a (str): The main string to search within.\n        b (str): The pattern string whose rotations are to be searched for.\n\n    Returns:\n        bool: True if a rotation of b is found in a, False otherwise.\n    \"\"\"\n    # Edge Case 1: If the length of b is greater than the length of a,\n    # it's impossible for b or any of its rotations to be a substring of a.\n    if len(b) > len(a):\n        return False\n\n    # Edge Case 2: If b is an empty string, an empty string is considered\n    # a substring of any string (including an empty string a).\n    if not b:  # Equivalent to len(b) == 0\n        return True\n\n    # Generate Rotations and Search:\n    # Create a doubled version of b by concatenating b with itself.\n    # This doubled string contains all possible cyclic rotations of b\n    # as substrings of length len(b).\n    b_doubled = b + b\n\n    # Iterate to extract each unique cyclic rotation of b.\n    # There are exactly len(b) unique rotations.\n    for i in range(len(b)):\n        # Extract a substring of b_doubled of length len(b) starting at index i.\n        # This extracted substring represents one cyclic rotation of b.\n        current_rotation = b_doubled[i : i + len(b)]\n\n        # Check if current_rotation is a substring of a.\n        # Python's 'in' operator performs efficient substring search.\n        if current_rotation in a:\n            # If any rotation is found, immediately return True.\n            return True\n\n    # If the loop completes without finding any rotation of b as a substring in a,\n    # then no match was found.\n    return False"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"\n    Calculates the count of even and odd digits within a given integer.\n\n    For any negative integer input, the function considers the absolute value\n    of the number when counting digits.\n\n    Args:\n        num: An integer.\n\n    Returns:\n        A tuple (even_count, odd_count), where even_count is the total number\n        of even digits and odd_count is the total number of odd digits found\n        in the input number's absolute value.\n\n    Raises:\n        TypeError: If the input 'num' is not an integer.\n    \"\"\"\n    # F.5: Input Type Validation\n    if not isinstance(num, int):\n        raise TypeError(\"Input must be an integer.\")\n\n    # F.4: Handle Zero Input\n    if num == 0:\n        return (1, 0)  # 0 is an even digit\n\n    # F.2: Handle Absolute Value\n    absolute_num = abs(num)\n\n    even_count = 0\n    odd_count = 0\n\n    # Convert to string for digit iteration. This handles large numbers easily.\n    num_str = str(absolute_num)\n\n    # F.1: Calculate Even and Odd Digit Counts\n    for char_digit in num_str:\n        digit = int(char_digit)  # Convert character back to integer digit\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # F.3: Return Format\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(num: int) -> str:\n    \"\"\"\n    Converts a positive integer (1-1000) into its equivalent lowercase Roman numeral representation.\n\n    Args:\n        num: A positive integer between 1 and 1000, inclusive.\n\n    Returns:\n        A string representing the lowercase Roman numeral equivalent of `num`.\n\n    Raises:\n        TypeError: If the input argument is not an integer.\n        ValueError: If the input integer is outside the range [1, 1000].\n    \"\"\"\n    if not isinstance(num, int):\n        raise TypeError(\"Input must be an integer.\")\n    if not (1 <= num <= 1000):\n        raise ValueError(\"Input must be between 1 and 1000.\")\n\n    roman_map = [\n        (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n        (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n        (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'), (1, 'i')\n    ]\n\n    result = []\n    current_num = num\n\n    for value, symbol in roman_map:\n        while current_num >= value:\n            result.append(symbol)\n            current_num -= value\n    \n    return \"\".join(result)"}
{"task_id": "HumanEval/157", "solution": "from typing import Union\ndef right_angle_triangle(a: Union[int, float], b: Union[int, float], c: Union[int, float]) -> bool:\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    \"\"\"\n    # Place sides in a list and sort to easily identify the shortest two and the longest side\n    sides = sorted([a, b, c])\n    \n    # Assign sorted sides to s1, s2, s3 where s3 is the longest side (hypotenuse)\n    s1, s2, s3 = sides[0], sides[1], sides[2]\n    \n    # Apply the Pythagorean theorem: s1^2 + s2^2 = s3^2\n    # For floating-point numbers, direct equality comparison can be problematic due to precision.\n    # However, based on the design document's explicit decision (\"Given the examples are integers,\n    # direct equality `==` will be used\"), we proceed with direct comparison.\n    # If high precision float inputs were a critical use case, an epsilon comparison would be necessary.\n    return s1**2 + s2**2 == s3**2"}
{"task_id": "HumanEval/158", "solution": "from typing import List\ndef find_max(words: List[str]) -> str:\n    \"\"\"\n    Identifies a single string from a list based on specific criteria related to \n    unique characters and lexicographical order.\n\n    The function first prioritizes strings with the highest count of unique \n    characters. If multiple strings share the same maximum count of unique \n    characters, it then uses lexicographical order as a tie-breaker, selecting \n    the string that appears earliest alphabetically.\n\n    Args:\n        words: A list of strings to be evaluated.\n\n    Returns:\n        A single string from the input list that meets the selection criteria.\n        Returns an empty string \"\" if the input list is empty.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    best_word: str = \"\" # Initialize with an empty string for type hint, will be set on first iteration\n    max_unique_chars_count: int = -1\n\n    # Using an explicit flag for the first word to ensure `best_word` is initialized correctly\n    # with the first valid candidate and `max_unique_chars_count` reflects its unique char count.\n    # This also naturally handles the single element list case.\n    is_first_word = True\n\n    for current_word in words:\n        current_unique_chars_count = len(set(current_word))\n\n        if is_first_word:\n            best_word = current_word\n            max_unique_chars_count = current_unique_chars_count\n            is_first_word = False\n        elif current_unique_chars_count > max_unique_chars_count:\n            # Found a new best word based on a higher unique character count\n            max_unique_chars_count = current_unique_chars_count\n            best_word = current_word\n        elif current_unique_chars_count == max_unique_chars_count:\n            # Tie-breaking: if counts are equal, choose the lexicographically smaller word\n            if current_word < best_word:\n                best_word = current_word\n\n    return best_word"}
{"task_id": "HumanEval/160", "solution": "from typing import List\ndef _get_precedence(op: str) -> int:\n    \"\"\"\n    Returns the precedence level of an operator. Higher number means higher precedence.\n    \"\"\"\n    if op == '**':\n        return 3\n    elif op in ('*', '//'):\n        return 2\n    elif op in ('+', '-'):\n        return 1\n    # Per SRS, input operators are guaranteed to be valid.\n    return 0 # Should not be reached\ndef _apply_operation(op: str, val1: int, val2: int) -> int:\n    \"\"\"\n    Applies the given operation to two integer operands.\n    val1 is the left operand, val2 is the right operand.\n    \"\"\"\n    if op == '+':\n        return val1 + val2\n    elif op == '-':\n        return val1 - val2\n    elif op == '*':\n        return val1 * val2\n    elif op == '//':\n        # Floor division. Per SRS, potential ZeroDivisionError propagates naturally.\n        return val1 // val2\n    elif op == '**':\n        return val1 ** val2\n    # Per SRS, input operators are guaranteed to be valid.\n    return 0\ndef do_algebra(operator: List[str], operand: List[int]) -> int:\n    \"\"\"\n    Evaluates an algebraic expression constructed from a list of operators and operands.\n    Applies standard operator precedence and left-to-right evaluation for same-precedence operators.\n\n    Args:\n        operator: A list of strings, each representing one of the supported operators.\n                  Constraints: len(operator) == len(operand) - 1, at least one operator.\n        operand: A list of non-negative integers.\n                 Constraints: at least two operands.\n\n    Returns:\n        A single integer representing the evaluated result of the expression.\n    \"\"\"\n    operand_stack: List[int] = []\n    operator_stack: List[str] = []\n\n    # Push the first operand onto the operand_stack.\n    # Constraints guarantee at least two operands, so operand[0] is safe.\n    operand_stack.append(operand[0])\n\n    # Process each operator and its subsequent operand.\n    # Constraints guarantee len(operator) == len(operand) - 1.\n    for j in range(len(operator)):\n        current_op = operator[j]\n        # Push the next operand onto operand_stack.\n        operand_stack.append(operand[j+1])\n\n        # While there are operators on the stack and the top operator\n        # has higher or equal precedence than the current operator,\n        # perform the operation. This handles precedence and left-to-right associativity.\n        while operator_stack and _get_precedence(operator_stack[-1]) >= _get_precedence(current_op):\n            op = operator_stack.pop()\n            val2 = operand_stack.pop() # Right operand\n            val1 = operand_stack.pop() # Left operand\n            result = _apply_operation(op, val1, val2)\n            operand_stack.append(result)\n        \n        # Push the current operator onto the operator_stack.\n        operator_stack.append(current_op)\n\n    # After processing all inputs, evaluate any remaining operators in the operator_stack.\n    # These will be processed in order of decreasing precedence (or left-to-right for same).\n    while operator_stack:\n        op = operator_stack.pop()\n        val2 = operand_stack.pop()\n        val1 = operand_stack.pop()\n        result = _apply_operation(op, val1, val2)\n        operand_stack.append(result)\n\n    # The final result is the single element remaining in the operand_stack.\n    return operand_stack[0]"}
{"task_id": "HumanEval/161", "solution": "def solve(s: str) -> str:\n    \"\"\"\n    Transforms a string based on specific character-casing and string-reversal rules.\n\n    Args:\n        s: The input string to be transformed.\n\n    Returns:\n        The transformed string.\n    \"\"\"\n\n    def _is_ascii_letter(char: str) -> bool:\n        \"\"\"\n        Determines if a character is an ASCII letter (a-z or A-Z).\n        This strictly adheres to the SRS definition of \"letter\".\n        \"\"\"\n        return ('a' <= char <= 'z') or ('A' <= char <= 'Z')\n\n    has_letters = False\n    # First Pass: Check if the string contains any ASCII letters\n    for char in s:\n        if _is_ascii_letter(char):\n            has_letters = True\n            break  # Found at least one letter, no need to check further\n\n    if has_letters:\n        # Rule 1: String contains at least one letter - reverse case of letters\n        result_chars = []\n        for char in s:\n            if _is_ascii_letter(char):\n                if 'a' <= char <= 'z':  # It's a lowercase ASCII letter\n                    result_chars.append(char.upper())\n                else:  # It's an uppercase ASCII letter\n                    result_chars.append(char.lower())\n            else:\n                # Non-letter characters remain unchanged\n                result_chars.append(char)\n        return \"\".join(result_chars)\n    else:\n        # Rule 2: String contains no letters - reverse the entire string\n        return s[::-1]"}
{"task_id": "HumanEval/162", "solution": "import hashlib\nfrom typing import Optional\ndef string_to_md5(text: str) -> Optional[str]:\n    \"\"\"\n    Computes the MD5 hash of a string and returns it as a hexadecimal string.\n\n    If the input string `text` is empty, the function returns `None`.\n\n    Args:\n        text (str): The input string to hash.\n\n    Returns:\n        Optional[str]: The MD5 hash as a 32-character hexadecimal string,\n                       or None if the input string is empty.\n\n    Examples:\n        >>> string_to_md5('Hello world')\n        '3e25960a79dbc69b674cd4ec67a72c62'\n        >>> string_to_md5('') is None\n        True\n        >>> string_to_md5('Python')\n        '2f81cf80e5b773c33076c117d353633e'\n    \"\"\"\n    if not text:  # Checks for empty string\n        return None\n    \n    # Encode the string to bytes using UTF-8 before hashing\n    bytes_text = text.encode('utf-8')\n    \n    # Create an MD5 hash object\n    hasher = hashlib.md5()\n    \n    # Feed the encoded bytes to the hasher\n    hasher.update(bytes_text)\n    \n    # Retrieve the hexadecimal representation of the computed hash digest\n    hex_digest = hasher.hexdigest()\n    \n    return hex_digest"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a: int, b: int) -> list[int]:\n    \"\"\"\n    Given two positive integers a and b, return the even integers between a\n    and b (inclusive), in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => [10, 12, 14]\n    generate_integers(5, 7) => [6]\n    generate_integers(11, 11) => []\n    \"\"\"\n    # 1. Determine the inclusive range\n    start_range = min(a, b)\n    end_range = max(a, b)\n\n    # 2. Initialize an empty list to store even numbers\n    even_numbers = []\n\n    # 3. Iterate through the range\n    # The range function in Python excludes the end value, so we use end_range + 1\n    for number in range(start_range, end_range + 1):\n        # 4. Check if the current number is even\n        if number % 2 == 0:\n            # 5. Add even number to the list\n            even_numbers.append(number)\n\n    # 6. Return the collected even numbers (already in ascending order due to iteration)\n    return even_numbers"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\"\n    Performs a character-wise binary XOR operation on two input strings.\n\n    Args:\n        a: The first binary string, consisting only of '0's and '1's.\n        b: The second binary string, consisting only of '0's and '1's.\n\n    Returns:\n        A binary string representing the XOR result of a and b.\n\n    Raises:\n        ValueError: If input strings contain characters other than '0' or '1',\n                    or if their lengths are not equal.\n    \"\"\"\n    # 1. Input Validation\n\n    # 1.1 Check if input strings contain only '0's and '1's.\n    valid_chars = {'0', '1'}\n    if not all(char in valid_chars for char in a):\n        raise ValueError(\"Input string 'a' must contain only '0's and '1's.\")\n    if not all(char in valid_chars for char in b):\n        raise ValueError(\"Input string 'b' must contain only '0's and '1's.\")\n\n    # 1.2 Check if lengths are equal.\n    if len(a) != len(b):\n        raise ValueError(\"Input strings 'a' and 'b' must have the same length.\")\n\n    # 2. Core Logic - Perform XOR operation\n    result_chars = []\n    # Iterate through strings character by character\n    for i in range(len(a)):\n        char_a = a[i]\n        char_b = b[i]\n\n        # Convert characters to integers (0 or 1)\n        int_a = int(char_a)\n        int_b = int(char_b)\n\n        # Perform integer XOR\n        xor_result_int = int_a ^ int_b\n\n        # Convert XOR result back to character ('0' or '1')\n        result_chars.append(str(xor_result_int))\n\n    # 3. Output Generation\n    # Join the list of characters to form the final result string\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\"\n    Counts the occurrences of a substring in a string, including overlapping cases.\n\n    Args:\n        string: The main string to search within.\n        substring: The substring to count.\n\n    Returns:\n        The number of times the substring appears, including overlaps.\n    \"\"\"\n    count = 0\n    start_index = 0\n    len_string = len(string)\n    len_substring = len(substring)\n\n    # Edge Case Handling as per design:\n    # 1. Empty substring\n    # 2. Substring longer than the main string\n    if len_substring == 0 or len_substring > len_string:\n        return 0\n\n    # Iterative Search\n    while True:\n        # Use str.find to search for the substring from the current start_index\n        found_index = string.find(substring, start_index)\n\n        # If substring is not found, break the loop\n        if found_index == -1:\n            break\n        else:\n            # If found, increment the count\n            count += 1\n            # Crucially, update start_index to look for the next occurrence\n            # starting one character after the beginning of the current match.\n            # This enables detection of overlapping occurrences.\n            start_index = found_index + 1\n\n    return count"}
{"task_id": "HumanEval/25", "solution": "from typing import List\ndef factorize(n: int) -> List[int]:\n    \"\"\"\n    Returns a list of prime factors of a given integer n,\n    ordered from smallest to largest, with each factor listed\n    according to its multiplicity.\n\n    Args:\n        n (int): The integer to be factorized.\n\n    Returns:\n        List[int]: A list containing the prime factors of n.\n                   Returns an empty list for 0, 1, and negative integers.\n    \"\"\"\n    factors = []\n\n    # Handle edge cases for n <= 1 (including 0, 1, and negative numbers)\n    if n <= 1:\n        return factors\n\n    # Factor out 2s\n    # Smallest prime factor is 2. Handle it separately for efficiency.\n    d = 2\n    while n % d == 0:\n        factors.append(d)\n        n //= d\n\n    # Factor out odd numbers\n    # Start checking from 3 and increment by 2 (3, 5, 7, ...)\n    # Optimization: only check divisors up to sqrt(n)\n    d = 3\n    while d * d <= n:\n        while n % d == 0:\n            factors.append(d)\n            n //= d\n        d += 2 # Move to the next odd number\n\n    # Handle the remaining prime factor\n    # If n is still greater than 1, it must be a prime number itself\n    # (larger than the square root of the original n)\n    if n > 1:\n        factors.append(n)\n\n    return factors"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q, w):\n    \"\"\"\n    Determines if an object represented by a list `q` will fly.\n    An object flies if it is balanced (q is palindromic) and its total weight\n    (sum of elements in q) does not exceed the maximum allowed weight `w`.\n\n    Args:\n        q (list): A list of numeric elements (int or float) representing the object.\n        w (int or float): The maximum possible weight the object can have to fly.\n\n    Returns:\n        bool: True if the object will fly, False otherwise.\n    \"\"\"\n    # FR2: Check if q is palindromic\n    # FR2.1, FR2.2: Handles empty and single-element lists correctly as palindromic\n    is_balanced = True\n    left = 0\n    right = len(q) - 1\n    while left < right:\n        if q[left] != q[right]:\n            is_balanced = False\n            break\n        left += 1\n        right -= 1\n\n    # FR3: Calculate the sum of all numeric elements in q\n    # FR3.1: Python's built-in sum() correctly returns 0 for an empty list\n    total_weight = sum(q)\n\n    # FR4: Compare the calculated sum with the maximum weight w\n    weight_ok = (total_weight <= w)\n\n    # FR5, FR6: Return True if both conditions are met, False otherwise\n    return is_balanced and weight_ok"}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word: str) -> str:\n    VOWELS = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\n    def is_vowel_local(char: str) -> bool:\n        return char in VOWELS\n\n    def is_consonant_local(char: str) -> bool:\n        # Assuming char is an English letter as per SRS assumption.\n        # The .isalpha() check is included as per the detailed design\n        # for robustness, although for valid inputs it might be redundant\n        # if input is strictly only English letters.\n        return char.isalpha() and not is_vowel_local(char)\n\n    n = len(word)\n    # Iterate from the second-to-last character (index n-2)\n    # down to the second character (index 1), inclusive.\n    # This ensures that for any 'i', i-1 and i+1 are valid indices.\n    # If n < 3, the range will be empty, and the loop won't execute,\n    # correctly leading to an empty string return.\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i - 1]\n        right_char = word[i + 1]\n\n        if is_vowel_local(current_char) and \\\n           is_consonant_local(left_char) and \\\n           is_consonant_local(right_char):\n            return current_char\n\n    return \"\""}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst: list[str]) -> list[str]:\n    \"\"\"\n    Processes a list of strings by filtering out strings with odd lengths,\n    and then sorting the remaining strings based on specific criteria.\n\n    Args:\n        lst: A list of strings.\n\n    Returns:\n        A new list containing strings from the input that have an even length,\n        sorted primarily by length (ascending) and secondarily by alphabetical\n        order (ascending).\n    \"\"\"\n    even_length_strings = []\n    for s in lst:\n        if len(s) % 2 == 0:\n            even_length_strings.append(s)\n\n    # Sort primarily by length (ascending), then alphabetically (ascending)\n    # Python's tuple comparison handles this automatically.\n    # (len(s), s) creates a tuple, and `sorted` will compare the first\n    # element of the tuple, then the second if the first are equal.\n    sorted_result = sorted(even_length_strings, key=lambda s: (len(s), s))\n\n    return sorted_result"}
{"task_id": "HumanEval/150", "solution": "def is_prime(num: int) -> bool:\n    \"\"\"\n    Determines if a given integer is a prime number.\n\n    Args:\n        num (int): The integer to check for primality.\n\n    Returns:\n        bool: True if num is prime, False otherwise.\n    \"\"\"\n    # FR2.1: n less than or equal to 1 SHALL be considered not prime.\n    if num <= 1:\n        return False\n    # FR2.2: n equal to 2 SHALL be considered prime.\n    # FR2.3: n equal to 3 SHALL be considered prime.\n    if num == 2 or num == 3:\n        return True\n    \n    # Handle even numbers and multiples of 3 for num > 3\n    if num % 2 == 0 or num % 3 == 0:\n        return False\n    \n    # FR2.4: For n > 3, the system SHALL check for divisibility by numbers up to the square root of n.\n    # Optimized loop for divisors (checking numbers of the form 6k \u00b1 1)\n    i = 5\n    # Loop while i * i <= num (checking divisors up to the square root of num)\n    while i * i <= num:\n        if num % i == 0 or num % (i + 2) == 0:\n            return False\n        i += 6 # Increment by 6 to skip multiples of 2 and 3\n            \n    return True\ndef x_or_y(n: int, x: any, y: any) -> any:\n    \"\"\"\n    Determines if an integer n is a prime number and returns x if prime,\n    or y otherwise.\n\n    Args:\n        n (int): An integer to be checked for primality.\n        x (any): A value to be returned if n is prime.\n        y (any): A value to be returned if n is not prime.\n\n    Returns:\n        any: Either x (if n is prime) or y (if n is not prime).\n    \"\"\"\n    # FR1: Input Parameters are handled by the function signature.\n    # FR2: Primality Determination is handled by the is_prime helper function.\n    if is_prime(n):\n        # FR3: Prime Number Return Value\n        return x\n    else:\n        # FR4: Non-Prime Number Return Value\n        return y"}
{"task_id": "HumanEval/159", "solution": "def eat(number: int, need: int, remaining: int) -> list[int]:\n    \"\"\"\n    Simulates a rabbit eating carrots, calculating the total number of carrots\n    consumed after a meal and the remaining stock.\n\n    Args:\n        number (int): The number of carrots the rabbit has already eaten.\n                      (Constraint: 0 <= number <= 1000)\n        need (int): The number of additional carrots the rabbit needs to eat\n                    for the current meal.\n                    (Constraint: 0 <= need <= 1000)\n        remaining (int): The number of carrots currently available in stock.\n                         (Constraint: 0 <= remaining <= 1000)\n\n    Returns:\n        list[int]: A list containing two integers:\n                   [total_eaten, carrots_left]\n                   - total_eaten: The cumulative number of carrots eaten by the rabbit\n                                  after the meal.\n                   - carrots_left: The number of carrots remaining in stock after the meal.\n    \"\"\"\n    # FR.1: Calculate Carrots Eaten in Current Meal\n    # The rabbit eats either what it needs or what is remaining, whichever is less.\n    carrots_eaten_this_meal = min(need, remaining)\n\n    # FR.2: Calculate Total Eaten Carrots\n    # Add the carrots eaten in this meal to the cumulative total.\n    total_eaten = number + carrots_eaten_this_meal\n\n    # FR.3: Calculate Remaining Carrots in Stock\n    # Subtract the carrots eaten in this meal from the current stock.\n    carrots_left = remaining - carrots_eaten_this_meal\n\n    # FR.4: Return Result Array\n    # Return the calculated values as a list.\n    return [total_eaten, carrots_left]"}
