{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\"\n    Calculates the largest integer divisor of a given number n,\n    strictly smaller than n.\n\n    Args:\n        n: An integer greater than 1.\n\n    Returns:\n        The largest divisor of n that is strictly smaller than n.\n\n    Raises:\n        TypeError: If n is not an integer.\n        ValueError: If n is less than or equal to 1.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n <= 1:\n        raise ValueError(\"Input 'n' must be greater than 1.\")\n\n    # Iterate from 2 up to the square root of n (inclusive).\n    # If a factor 'i' is found, then n // i is the corresponding larger factor.\n    # Since we are searching for the *smallest* factor 'i' (starting from 2),\n    # the corresponding 'n // i' will be the *largest* factor of n (excluding n itself).\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            return n // i\n\n    # If the loop completes, it means no factors were found between 2 and sqrt(n).\n    # This implies that n is a prime number. For prime numbers, the largest divisor\n    # strictly smaller than n is 1.\n    return 1"}
{"task_id": "HumanEval/26", "solution": "from typing import List\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\"\n    Removes elements that occur more than once from a list of integers,\n    maintaining the original order of the remaining unique elements.\n\n    Args:\n        numbers: A list of integers.\n\n    Returns:\n        A new list containing only elements that appeared exactly once in the\n        input list, preserving their original relative order.\n\n    Example:\n        >>> remove_duplicates([1, 2, 3, 2, 4])\n        [1, 3, 4]\n        >>> remove_duplicates([])\n        []\n        >>> remove_duplicates([1, 1, 1])\n        []\n        >>> remove_duplicates([5, 6, 7])\n        [5, 6, 7]\n    \"\"\"\n    counts = {}\n    for number in numbers:\n        counts[number] = counts.get(number, 0) + 1\n\n    result_list = []\n    for number in numbers:\n        if counts[number] == 1:\n            result_list.append(number)\n\n    return result_list"}
{"task_id": "HumanEval/27", "solution": "def flip_case(input_string: str) -> str:\n    result_chars = []\n    for char in input_string:\n        if char.isalpha():\n            if char.islower():\n                result_chars.append(char.upper())\n            else:  # char is uppercase\n                result_chars.append(char.lower())\n        else:  # not alphabetic\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
