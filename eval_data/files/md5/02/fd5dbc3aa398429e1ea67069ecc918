{"task_id": "HumanEval/50", "solution": "class Alphabet:\n    _LOWER_START: int = ord('a')\n    _LOWER_END: int = ord('z')\n    _UPPER_START: int = ord('A')\n    _UPPER_END: int = ord('Z')\n    _ALPHABET_SIZE: int = 26\n\n    @classmethod\n    def calculate_decoded_char(cls, original_char: str, shift_amount: int) -> str:\n        \"\"\"\n        Calculates the decoded character by shifting it backward by shift_amount, handling wrapping within its respective alphabet.\n        \"\"\"\n        char_ord = ord(original_char)\n        if cls._LOWER_START <= char_ord <= cls._LOWER_END:\n            start_ord = cls._LOWER_START\n        elif cls._UPPER_START <= char_ord <= cls._UPPER_END:\n            start_ord = cls._UPPER_START\n        else:\n            return original_char  # Should not happen if called only for alphabetic characters\n\n        current_pos_in_alphabet = char_ord - start_ord\n        # Apply the backward shift, using modulo for wrapping. Python's % handles negative numbers correctly for this use case.\n        new_pos_in_alphabet = (current_pos_in_alphabet - shift_amount) % cls._ALPHABET_SIZE\n        decoded_ord = start_ord + new_pos_in_alphabet\n        return chr(decoded_ord)\nclass Character:\n    \"\"\"\n    Encapsulates a single character and provides methods for type checking and delegating decoding logic.\n    \"\"\"\n    def __init__(self, char_value: str):\n        self._value: str = char_value\n\n    def is_alphabetic(self) -> bool:\n        \"\"\"Returns True if the character is an alphabet letter, False otherwise.\"\"\"\n        return self._value.isalpha()\n\n    def is_lowercase(self) -> bool:\n        \"\"\"Returns True if the character is a lowercase letter, False otherwise.\"\"\"\n        return self._value.islower()\n\n    def is_uppercase(self) -> bool:\n        \"\"\"Returns True if the character is an uppercase letter, False otherwise.\"\"\"\n        return self._value.isupper()\n\n    def decode(self, shift_amount: int) -> str:\n        \"\"\"\n        Decodes the character by shifting it backward by shift_amount, using Alphabet for wrapping logic,\n        and returns the decoded character as a string.\n        \"\"\"\n        if self.is_alphabetic():\n            return Alphabet.calculate_decoded_char(self._value, shift_amount)\n        return self._value\ndef decode_shift(s: str):\n    \"\"\"\n    takes as input string encoded with encode_shift function. Returns decoded string.\n    \"\"\"\n    decoded_chars = []\n    for char in s:\n        char_obj = Character(char)\n        decoded_chars.append(char_obj.decode(5))\n    return \"\".join(decoded_chars)"}
{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n\n    a, b = 0, 1\n    for _ in range(n - 1):\n        a, b = b, a + b\n    return b"}
