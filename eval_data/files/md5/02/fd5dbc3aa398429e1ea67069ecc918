{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n\n    def fibonacci_sequence():\n        \"\"\"Yields an infinite sequence of Fibonacci numbers starting from 0, 1, 1, 2...\"\"\"\n        a, b = 0, 1\n        while True:\n            yield a\n            a, b = b, a + b\n\n    def is_prime(number: int) -> bool:\n        \"\"\"Checks if a given number is prime.\"\"\"\n        if number < 2:\n            return False\n        i = 2\n        while i * i <= number:\n            if number % i == 0:\n                return False\n            i += 1\n        return True\n\n    fib_gen = fibonacci_sequence()\n    prime_count = 0\n    current_fib_prime = 0\n\n    # Skip the initial Fibonacci numbers (0, 1, 1) as they are not prime or part of the desired sequence's start.\n    next(fib_gen) # Skips 0\n    next(fib_gen) # Skips 1\n    next(fib_gen) # Skips 1\n\n    while prime_count < n:\n        fib_num = next(fib_gen)\n        if is_prime(fib_num):\n            prime_count += 1\n            current_fib_prime = fib_num\n\n    return current_fib_prime"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if x == 0:\n        return '0'\n\n    res = []\n    while x > 0:\n        res.append(str(x % base))\n        x //= base\n    return ''.join(res[::-1])"}
