{"task_id": "Mbpp/739", "solution": "def calculate_triangular_number(k: int) -> int:\n    \"\"\"\n    Calculates the k-th triangular number using the formula T(k) = k*(k+1)/2.\n    \"\"\"\n    return k * (k + 1) // 2\ndef count_digits(number: int) -> int:\n    \"\"\"\n    Counts the number of digits in a given non-negative integer.\n    \"\"\"\n    # For triangular numbers, the input 'number' will always be positive.\n    return len(str(number))\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    Assumes n is a valid positive integer based on design context.\n    \"\"\"\n    # The design specifies calling validate_input, but due to output constraints\n    # (no exceptions, specific return type), we assume valid 'n' as per problem setup.\n    # If not validate_input(n):\n    #     # In a real scenario, this would handle invalid input (e.g., raise ValueError or return a sentinel).\n    #     # As per constraints, we proceed assuming n is valid.\n    #     pass\n\n    k = 1\n    while True:\n        triangular_num = calculate_triangular_number(k)\n        num_digits = count_digits(triangular_num)\n        \n        if num_digits == n:\n            return k\n        \n        k += 1"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(arr: list[int], target: int) -> int:\n    \"\"\"\n    Find the leftmost insertion point for target in sorted array.\n    Uses binary search to achieve O(log n) time complexity.\n    \"\"\"\n    low = 0\n    high = len(arr)\n\n    while low < high:\n        mid = low + (high - low) // 2\n        if arr[mid] < target:\n            low = mid + 1\n        else: # arr[mid] >= target\n            high = mid\n            \n    return low"}
{"task_id": "Mbpp/739", "solution": "def find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with exactly n digits.\n    Assumes n is a positive integer.\n    \"\"\"\n\n    def _calculate_triangular_number(k: int) -> int:\n        \"\"\"Calculates the k-th triangular number.\"\"\"\n        return k * (k + 1) // 2\n\n    def _count_digits(number: int) -> int:\n        \"\"\"Counts the number of digits in an integer.\"\"\"\n        return len(str(number))\n\n    k = 1\n    while True:\n        triangular_value = _calculate_triangular_number(k)\n        digit_count = _count_digits(triangular_value)\n\n        if digit_count == n:\n            return k\n        k += 1"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(array, target):\n    \"\"\"\n    Locates the leftmost insertion point for a specified value in a sorted array.\n    Uses binary search to find the position to maintain sorted order.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    ans = len(array)  # Default insertion point if target is greater than all elements\n\n    while low <= high:\n        mid = (low + high) // 2\n        if array[mid] >= target:\n            # mid could be the insertion point, or target is further left\n            ans = mid\n            high = mid - 1\n        else:\n            # target is in the right half\n            low = mid + 1\n            \n    return ans"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input_tuple: tuple) -> dict:\n    \"\"\"Converts a tuple to a key-value dictionary using adjacent elements.\"\"\"\n    if len(input_tuple) % 2 != 0:\n        raise ValueError(\"Input tuple must have an even number of elements.\")\n\n    result_dict = {}\n    for i in range(0, len(input_tuple), 2):\n        key = input_tuple[i]\n        value = input_tuple[i+1]\n        result_dict[key] = value\n    return result_dict"}
