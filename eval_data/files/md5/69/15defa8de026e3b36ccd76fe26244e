{"task_id": "Mbpp/759", "solution": "def is_decimal(input_string: str) -> bool:\n    \"\"\"\n    Checks if a given string represents a decimal number with exactly two decimal places.\n    The string must contain only digits and a single decimal point.\n    \"\"\"\n    if not input_string:\n        return False\n\n    # Ensure there is exactly one decimal point\n    if input_string.count('.') != 1:\n        return False\n\n    parts = input_string.split('.')\n    integer_part = parts[0]\n    fractional_part = parts[1]\n\n    # The fractional part must have exactly two digits\n    if len(fractional_part) != 2:\n        return False\n    if not fractional_part.isdigit():\n        return False\n\n    # The integer part must consist only of digits, or be empty (e.g., '.11')\n    if not integer_part.isdigit() and integer_part != '':\n        return False\n\n    return True"}
{"task_id": "Mbpp/759", "solution": "def is_decimal(input_string: str) -> bool:\n    \"\"\"\n    Checks if the given string represents a decimal number with exactly 2 decimal places.\n    Handles basic numeric validation and precision requirements.\n    \"\"\"\n    if input_string.count('.') != 1:\n        return False\n\n    parts = input_string.split('.')\n    integer_part = parts[0]\n    decimal_part = parts[1]\n\n    if not integer_part or not integer_part.isdigit():\n        return False\n\n    if len(decimal_part) != 2 or not decimal_part.isdigit():\n        return False\n\n    return True"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(strings: list[str]) -> int:\n    \"\"\"\n    Counts the number of pairs of reverse strings in the given string list.\n    A pair (s1, s2) is counted if s1 is the reverse of s2.\n    Palindromes form a pair with themselves if two or more instances exist.\n    \"\"\"\n    \n    def _reverse_string(s: str) -> str:\n        \"\"\"Returns the reverse of the input string.\"\"\"\n        return s[::-1]\n\n    pair_count = 0\n    \n    # Create a frequency map for all strings to handle duplicates\n    string_counts = {}\n    for s in strings:\n        string_counts[s] = string_counts.get(s, 0) + 1\n\n    # Iterate through a copy of the keys to safely modify the dictionary during iteration.\n    # We process each unique string once.\n    for s in list(string_counts.keys()):\n        # If the string 's' has already been fully used up in a pair, skip it.\n        if string_counts.get(s, 0) == 0:\n            continue\n\n        reversed_s = _reverse_string(s)\n\n        if s == reversed_s:  # 's' is a palindrome\n            # Palindromes form pairs with themselves if there are multiple instances.\n            # E.g., for [\"madam\", \"madam\"], one pair is counted.\n            pair_count += string_counts[s] // 2\n            # Mark the string as fully used since all its possible pairs (with itself) are counted.\n            string_counts[s] = 0\n        else:  # 's' is not a palindrome\n            # Check if its reverse 'reversed_s' exists in the counts and is available.\n            if string_counts.get(reversed_s, 0) > 0:\n                # The number of pairs is limited by the minimum available count of 's' and 'reversed_s'.\n                num_matching_pairs = min(string_counts[s], string_counts[reversed_s])\n                pair_count += num_matching_pairs\n                # Mark both 's' and 'reversed_s' as fully used as their pairs are now counted.\n                string_counts[s] = 0\n                string_counts[reversed_s] = 0\n                \n    return pair_count"}
