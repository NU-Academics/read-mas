{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array: list) -> bool:\n    \"\"\"\n    Checks if the given array is monotonic (non-decreasing or non-increasing).\n    An empty array or a single-element array is considered monotonic.\n    \"\"\"\n    if len(array) <= 1:\n        return True\n\n    is_non_decreasing = True\n    is_non_increasing = True\n\n    for i in range(len(array) - 1):\n        if array[i] > array[i+1]:\n            is_non_decreasing = False\n        if array[i] < array[i+1]:\n            is_non_increasing = False\n        \n        # Optimization: if both conditions are already false, no need to continue\n        if not is_non_decreasing and not is_non_increasing:\n            return False\n\n    return is_non_decreasing or is_non_increasing"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list, sublist):\n    \"\"\"\n    Checks if a sublist is present as a contiguous sequence within the main list.\n    Handles edge cases for empty lists according to specification.\n    \"\"\"\n    n = len(main_list)\n    m = len(sublist)\n\n    if m == 0:\n        return True  # An empty sublist is always considered a sublist.\n\n    if n == 0:\n        return False # A non-empty sublist cannot be in an empty main list.\n\n    if m > n:\n        return False # A sublist cannot be longer than the main list.\n\n    for i in range(n - m + 1):\n        # Compare the slice of main_list with the sublist\n        match = True\n        for j in range(m):\n            if main_list[i + j] != sublist[j]:\n                match = False\n                break\n        if match:\n            return True\n\n    return False"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list, sublist):\n    \"\"\"\n    Checks if a list contains the given sublist as a contiguous subsequence.\n    This function handles empty list edge cases and performs exact element matching.\n    \"\"\"\n\n    def _handle_edge_cases(main, sub):\n        # An empty sublist is considered a sublist of any list.\n        if not sub:\n            return True, True\n        # A non-empty sublist cannot be found in an empty main list.\n        if not main:\n            return True, False\n        return False, None\n\n    def _find_contiguous_match(main, sub):\n        len_main = len(main)\n        len_sub = len(sub)\n\n        # If the sublist is longer than the main list, it cannot be a contiguous sublist.\n        if len_sub > len_main:\n            return False\n\n        # Iterate through the main list to find a matching starting point for the sublist.\n        for i in range(len_main - len_sub + 1):\n            if main[i : i + len_sub] == sub:\n                return True\n        return False\n\n    # First, handle specific edge cases related to empty lists.\n    is_edge_case, result = _handle_edge_cases(main_list, sublist)\n    if is_edge_case:\n        return result\n\n    # If not an edge case, proceed with the main contiguous matching logic.\n    return _find_contiguous_match(main_list, sublist)"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(input_list: list) -> list:\n    \"\"\"\n    Sorts a list of elements using the comb sort algorithm.\n    Returns a new sorted list in ascending order.\n    \"\"\"\n    arr = list(input_list) # Create a copy to maintain original list integrity\n    n = len(arr)\n    gap = n\n    swapped = True\n    shrink_factor = 1.3\n\n    while gap > 1 or swapped:\n        # Calculate the next gap value\n        gap = int(gap / shrink_factor)\n        if gap < 1:\n            gap = 1\n\n        swapped = False\n        # Perform a modified bubble sort pass for the current gap\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i] # Swap elements\n                swapped = True\n\n    return arr"}
