{"task_id": "Mbpp/573", "solution": "def unique_product(input_list: list) -> int:\n    \"\"\"\n    Calculates the product of the unique numbers in a given list.\n    \"\"\"\n    def _extract_unique_numbers(numbers_list: list) -> set:\n        \"\"\"Extracts unique numbers from a list using a set.\"\"\"\n        return set(numbers_list)\n\n    def _calculate_product(unique_nums: set) -> int:\n        \"\"\"Calculates the product of numbers in a set.\"\"\"\n        product = 1\n        for num in unique_nums:\n            product *= num\n        return product\n\n    unique_numbers = _extract_unique_numbers(input_list)\n    return _calculate_product(unique_numbers)"}
{"task_id": "Mbpp/573", "solution": "def unique_product(numbers):\n    \"\"\"\n    Calculates the product of unique numbers in a given list.\n    Orchestrates extraction of unique numbers and their product calculation.\n    \"\"\"\n    def _get_unique_numbers(nums):\n        \"\"\"Extracts unique numbers from a list using a set for efficient deduplication.\"\"\"\n        return list(set(nums))\n\n    def _calculate_product(nums):\n        \"\"\"Calculates the mathematical product of all numbers in a list.\"\"\"\n        product = 1\n        for num in nums:\n            product *= num\n        return product\n\n    unique_nums = _get_unique_numbers(numbers)\n    return _calculate_product(unique_nums)"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list, sub_list):\n    \"\"\"\n    Check if sub_list is a contiguous sublist of main_list.\n    Returns True if sub_list is found, False otherwise.\n    \"\"\"\n    n = len(main_list)\n    m = len(sub_list)\n\n    if m == 0:\n        return True\n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        if main_list[i : i + m] == sub_list:\n            return True\n    return False"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list, sub_list):\n    \"\"\"\n    Checks if `sub_list` is a contiguous sublist of `main_list`.\n    Returns True if `sub_list` is found, False otherwise.\n    \"\"\"\n    len_main = len(main_list)\n    len_sub = len(sub_list)\n\n    # An empty sublist is considered a sublist of any list.\n    if len_sub == 0:\n        return True\n\n    # If the sublist is longer than the main list, it cannot be a sublist.\n    if len_sub > len_main:\n        return False\n\n    # Iterate through the main_list to find a potential starting point for the sub_list.\n    for i in range(len_main - len_sub + 1):\n        # Assume a match for the current segment\n        match = True\n        # Check each element of the sub_list against the corresponding segment in main_list.\n        for j in range(len_sub):\n            if main_list[i + j] != sub_list[j]:\n                match = False\n                break  # Mismatch found, move to the next starting position in main_list.\n        \n        if match:\n            return True  # Entire sub_list matched the current segment.\n\n    return False  # No matching contiguous sublist was found."}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Finds the last digit of the factorial of a given non-negative integer.\n    For n >= 5, the last digit of n! is always 0 due to the factors 2 and 5.\n    \"\"\"\n    if n >= 5:\n        return 0\n    elif n == 0:\n        return 1\n    elif n == 1:\n        return 1\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 6\n    elif n == 4:\n        return 4"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Calculates the last digit of the factorial of a given number.\n    Optimizes for n >= 10, returning 0 directly.\n    \"\"\"\n\n    def calculate_factorial_local(number: int) -> int:\n        \"\"\"Computes the factorial of a non-negative integer.\"\"\"\n        if number == 0 or number == 1:\n            return 1\n        result = 1\n        for i in range(2, number + 1):\n            result *= i\n        return result\n\n    def extract_last_digit_local(number: int) -> int:\n        \"\"\"Extracts the last digit of a number.\"\"\"\n        return number % 10\n\n    # According to NFR-002 and the LargeNumberOptimizer, for n >= 10, the result is 0.\n    # For negative inputs, factorial is undefined. We assume n is a non-negative integer\n    # as is standard for factorial problems, and no error handling is permitted.\n    if n >= 10:\n        return 0\n    \n    # For n less than 10 (i.e., 0 to 9), calculate the factorial and find its last digit.\n    # This covers cases like 0!, 1!, ..., 9!.\n    # (e.g., 5! = 120, last digit 0; 9! = 362880, last digit 0).\n    factorial_value = calculate_factorial_local(n)\n    return extract_last_digit_local(factorial_value)"}
