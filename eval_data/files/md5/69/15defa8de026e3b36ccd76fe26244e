{"task_id": "Mbpp/721", "solution": "from typing import List\ndef maxAverageOfPath(matrix: List[List[float]]) -> float:\n    \"\"\"\n    Finds the path from top-left to bottom-right with the maximum average cost.\n    Movement is restricted to right or down.\n    \"\"\"\n    N = len(matrix)\n    if N == 0:\n        return 0.0 # Handle empty matrix case.\n\n    # All paths from (0,0) to (N-1,N-1) moving only right or down\n    # will always have a constant number of cells: (N-1) down + (N-1) right + 1 start cell.\n    path_length = 2 * N - 1\n\n    max_avg_found = -float('inf')\n\n    # Recursive DFS function to explore all valid paths.\n    # current_row, current_col: current cell coordinates.\n    # current_sum: sum of costs of cells in the path leading to current_row, current_col (inclusive).\n    def _dfs(current_row: int, current_col: int, current_sum: float):\n        nonlocal max_avg_found\n\n        # Add the cost of the current cell to the path sum.\n        current_sum += matrix[current_row][current_col]\n\n        # Base case: If the bottom-right cell is reached.\n        if current_row == N - 1 and current_col == N - 1:\n            current_avg = current_sum / path_length\n            max_avg_found = max(max_avg_found, current_avg)\n            return\n\n        # Explore moving right.\n        if current_col + 1 < N:\n            _dfs(current_row, current_col + 1, current_sum)\n\n        # Explore moving down.\n        if current_row + 1 < N:\n            _dfs(current_row + 1, current_col, current_sum)\n\n    # Start the depth-first search from the top-left cell (0,0) with an initial sum of 0.0.\n    _dfs(0, 0, 0.0)\n\n    return max_avg_found"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base, power):\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    Handles large numbers using Python's arbitrary precision integers.\n    \"\"\"\n    # Calculate the power: base raised to the power\n    power_result = base ** power\n    \n    # Convert the numerical result to a string to easily access individual digits\n    string_representation = str(power_result)\n    \n    # Sum all individual digits by converting each character back to an integer\n    digit_sum = 0\n    for char_digit in string_representation:\n        digit_sum += int(char_digit)\n        \n    return digit_sum"}
{"task_id": "Mbpp/721", "solution": "from typing import List, Tuple\ndef is_square(matrix: List[List[float]]) -> bool:\n    \"\"\"Check if matrix is square.\"\"\"\n    if not matrix:\n        return True\n    n = len(matrix)\n    for row in matrix:\n        if not isinstance(row, list) or len(row) != n:\n            return False\n    return True\ndef contains_numeric_values(matrix: List[List[float]]) -> bool:\n    \"\"\"Verify all values are numeric.\"\"\"\n    if not matrix:\n        return True\n    for row in matrix:\n        for val in row:\n            if not isinstance(val, (int, float)):\n                return False\n    return True\ndef validate_matrix(matrix: List[List[float]]) -> bool:\n    \"\"\"Complete matrix validation.\"\"\"\n    if not isinstance(matrix, list):\n        return False\n    if not is_square(matrix):\n        return False\n    if not contains_numeric_values(matrix):\n        return False\n    return True\ndef calculate_path_cost(path: List[Tuple[int, int]], matrix: List[List[float]]) -> float:\n    \"\"\"Calculate total cost for given path.\"\"\"\n    total_cost = 0.0\n    for r, c in path:\n        total_cost += matrix[r][c]\n    return total_cost\ndef calculate_path_average(total_cost: float, path_length: int) -> float:\n    \"\"\"Calculate average cost per cell.\"\"\"\n    if path_length == 0:\n        return 0.0\n    return total_cost / path_length\ndef find_maximum_average(averages: List[float]) -> float:\n    \"\"\"Find maximum value from list of averages.\"\"\"\n    if not averages:\n        return 0.0\n    return max(averages)\nclass PathFinder:\n    \"\"\"Core path finding logic with movement constraints.\"\"\"\n    def __init__(self, matrix: List[List[float]]):\n        \"\"\"Initialize with validated matrix.\"\"\"\n        self._matrix = matrix\n        self._size = len(matrix)\n        self._all_paths = []\n\n    def validate_movement(self, from_pos: Tuple[int, int], to_pos: Tuple[int, int]) -> bool:\n        \"\"\"Validate movement is right or down only.\"\"\"\n        from_r, from_c = from_pos\n        to_r, to_c = to_pos\n        return (to_r == from_r + 1 and to_c == from_c) or \\\n               (to_r == from_r and to_c == from_c + 1)\n\n    def _generate_paths_recursive(self, current_path: List[Tuple[int, int]], row: int, col: int) -> None:\n        \"\"\"Helper to recursively generate all paths.\"\"\"\n        # Base case: Reached bottom-right cell\n        if row == self._size - 1 and col == self._size - 1:\n            self._all_paths.append(list(current_path))\n            return\n\n        # Move Down\n        if row + 1 < self._size:\n            current_path.append((row + 1, col))\n            self._generate_paths_recursive(current_path, row + 1, col)\n            current_path.pop() # Backtrack\n\n        # Move Right\n        if col + 1 < self._size:\n            current_path.append((row, col + 1))\n            self._generate_paths_recursive(current_path, row, col + 1)\n            current_path.pop() # Backtrack\n\n    def find_all_paths(self) -> List[List[Tuple[int, int]]]:\n        \"\"\"Generate all valid paths from (0,0) to (N-1,N-1).\"\"\"\n        if not self._matrix:\n            return []\n        \n        start_cell = (0, 0)\n        initial_path = [start_cell]\n        self._generate_paths_recursive(initial_path, 0, 0)\n        return self._all_paths\ndef maxAverageOfPath(matrix: List[List[float]]) -> float:\n    \"\"\"\n    Main algorithm function returning maximum average path.\n    Orchestrates validation, path finding, and average calculation.\n    \"\"\"\n    if not validate_matrix(matrix):\n        return 0.0\n\n    n = len(matrix)\n    if n == 0:\n        return 0.0\n\n    path_finder = PathFinder(matrix)\n    all_paths = path_finder.find_all_paths()\n\n    if not all_paths:\n        return 0.0\n\n    all_averages = []\n    for path in all_paths:\n        total_cost = calculate_path_cost(path, matrix)\n        path_length = len(path)\n        avg = calculate_path_average(total_cost, path_length)\n        all_averages.append(avg)\n\n    return find_maximum_average(all_averages)"}
