{"task_id": "Mbpp/237", "solution": "def check_occurences(list_of_tuples: list[tuple]) -> dict[tuple, int]:\n    \"\"\"\n    Counts occurrences of tuples in a list, treating (a, b) and (b, a) as equivalent.\n    Normalizes tuples by sorting their elements before counting.\n    \"\"\"\n    \n    def normalize_tuple(tpl: tuple) -> tuple:\n        \"\"\"\n        Sorts the elements within a tuple to create a canonical representation.\n        \"\"\"\n        return tuple(sorted(tpl))\n\n    occurrence_counts = {}\n    for tpl in list_of_tuples:\n        normalized_tpl = normalize_tuple(tpl)\n        occurrence_counts[normalized_tpl] = occurrence_counts.get(normalized_tpl, 0) + 1\n    return occurrence_counts"}
{"task_id": "Mbpp/235", "solution": "def even_bit_set_number(number: int) -> int:\n    \"\"\"\n    Sets all even-positioned bits (0, 2, 4, 6, etc.) to 1 in the given number.\n    Odd-positioned bits are preserved unchanged.\n    \"\"\"\n    # A mask with 1s at all even positions (0, 2, 4, ...) and 0s at all odd positions.\n    # For practical purposes, a 64-bit mask is typically sufficient.\n    # Python integers have arbitrary precision, so the mask extends as needed.\n    # This mask pattern is 0x55...55 in hexadecimal.\n    # Example for 8 bits: 01010101 (85 decimal)\n    # Example for 64 bits: 0x5555555555555555\n    \n    # We construct a sufficiently large mask by iterating through common bit positions.\n    # For numbers potentially larger than 64 bits, the mask implicitly extends due to Python's arbitrary-precision integers\n    # as the OR operation with a smaller mask only affects the lower bits.\n    # To cover a typical range of integers, a mask covering up to 64 bits is usually adequate.\n    mask = 0\n    # Iterate through even bit positions up to a practical limit (e.g., 62 for 64-bit coverage)\n    for i in range(0, 64, 2):\n        mask |= (1 << i)\n        \n    return number | mask"}
{"task_id": "Mbpp/238", "solution": "def number_of_substrings(input_string: str) -> int:\n    \"\"\"\n    Counts the total number of non-empty substrings in the given string.\n    It iterates through all possible start and end indices to generate and count each substring.\n    \"\"\"\n    count = 0\n    n = len(input_string)\n\n    # Iterate through all possible starting positions (i)\n    for i in range(n):\n        # Iterate through all possible ending positions (j) from the current start\n        for j in range(i, n):\n            # Each pair (i, j) defines a unique non-empty substring input_string[i:j+1]\n            count += 1\n    return count"}
{"task_id": "Mbpp/237", "solution": "def normalize_tuple(input_tuple):\n    \"\"\"\n    Normalize tuple by sorting elements in ascending order.\n    Returns a tuple with elements sorted in ascending order.\n    \"\"\"\n    return tuple(sorted(input_tuple))\ndef check_occurences(tuple_list):\n    \"\"\"\n    Count occurrences of normalized tuples in input list.\n    Returns a dictionary mapping normalized tuples to occurrence counts.\n    \"\"\"\n    occurrence_counts = {}\n    for original_tuple in tuple_list:\n        normalized_tuple = normalize_tuple(original_tuple)\n        occurrence_counts[normalized_tuple] = occurrence_counts.get(normalized_tuple, 0) + 1\n    return occurrence_counts"}
{"task_id": "Mbpp/235", "solution": "def even_bit_set_number(number: int) -> int:\n    \"\"\"\n    Sets all even-positioned bits (0, 2, 4, etc.) of a given number to 1.\n    A mask of 1s at even positions up to 64 bits is used.\n    \"\"\"\n    # Create a mask with 1s at all even bit positions (0, 2, 4, ...)\n    # For a 64-bit integer, this mask is 0x5555555555555555 (binary 0101...0101).\n    # Bit 0 is even, Bit 2 is even, Bit 4 is even, etc.\n    even_bits_mask = 0x5555555555555555\n\n    # Use a bitwise OR operation to set these bits in the number.\n    # Bits at odd positions remain unchanged, while '0's at even positions become '1's.\n    return number | even_bits_mask"}
{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the number of sequences of length n, where each element is a positive integer,\n    greater than or equal to twice the previous element, and less than or equal to m.\n    \"\"\"\n    # dp[i][j] stores the number of sequences of length i that end with value j.\n    # Initialize dp table with zeros. Rows represent sequence length, columns represent the last element's value.\n    dp = [[0] * (m + 1) for _ in range(n + 1)]\n\n    # Base case: For sequences of length 1, any positive integer j up to m is a valid sequence.\n    for j in range(1, m + 1):\n        dp[1][j] = 1\n\n    # Fill the DP table for sequence lengths from 2 up to n.\n    for i in range(2, n + 1):\n        # Calculate prefix sums for dp[i-1] to efficiently find the sum of previous elements.\n        # prefix_sum_prev_length[k] will store sum(dp[i-1][x] for x in 1 to k).\n        prefix_sum_prev_length = [0] * (m + 1)\n        for k_val in range(1, m + 1):\n            prefix_sum_prev_length[k_val] = prefix_sum_prev_length[k_val - 1] + dp[i - 1][k_val]\n\n        # For each possible last element 'j' in the current sequence of length 'i'.\n        for j in range(1, m + 1):\n            # The previous element must be less than or equal to j // 2.\n            max_prev_val = j // 2\n            if max_prev_val >= 1:  # Only consider if there are valid previous elements\n                # The number of sequences of length 'i' ending with 'j' is the sum\n                # of sequences of length 'i-1' ending with any value k from 1 to max_prev_val.\n                dp[i][j] = prefix_sum_prev_length[max_prev_val]\n\n    # The total number of sequences of length n is the sum of all dp[n][j] values for valid j.\n    total_sequences = sum(dp[n][j] for j in range(1, m + 1))\n    return total_sequences"}
{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the number of sequences of length n,\n    where each element is a positive integer, greater than or equal to twice\n    the previous element, and less than or equal to m.\n    \"\"\"\n    # dp[i][j] will store the number of sequences of length 'i' ending with 'j'.\n    # Initialize dp table with zeros. Rows represent sequence length (up to n),\n    # columns represent the last element's value (up to m).\n    dp = [[0] * (m + 1) for _ in range(n + 1)]\n\n    # Base case: For sequences of length 1, any positive integer from 1 to m is valid.\n    for j in range(1, m + 1):\n        dp[1][j] = 1\n\n    # Fill the DP table for lengths from 2 up to n.\n    for i in range(2, n + 1):\n        # Calculate prefix sums for dp[i-1] to efficiently sum previous elements.\n        # prefix_sums_prev_length[k] will store sum(dp[i-1][1]...dp[i-1][k])\n        prefix_sums_prev_length = [0] * (m + 1)\n        for k_val in range(1, m + 1):\n            prefix_sums_prev_length[k_val] = prefix_sums_prev_length[k_val - 1] + dp[i - 1][k_val]\n\n        # For each possible last element 'j' in a sequence of length 'i':\n        for j in range(1, m + 1):\n            # The previous element 'k' must satisfy 2 * k <= j, meaning k <= j / 2.\n            # We need to sum up dp[i-1][k] for all valid k.\n            # The maximum possible value for 'k' is floor(j / 2).\n            max_prev_k = j // 2\n\n            # If there's at least one valid previous element (k >= 1), sum their counts.\n            # Otherwise, dp[i][j] remains 0.\n            if max_prev_k >= 1:\n                dp[i][j] = prefix_sums_prev_length[max_prev_k]\n            # No need for an else, as it's already 0.\n\n    # The total number of sequences of length n is the sum of all\n    # counts for sequences of length n ending with any valid value up to m.\n    total_sequences = sum(dp[n])\n\n    return total_sequences"}
