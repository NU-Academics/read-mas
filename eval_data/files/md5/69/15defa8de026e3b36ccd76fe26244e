{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"\n    Main entry point for undulating number validation.\n    Checks if a positive integer has an alternating pattern of exactly two distinct digits.\n    \"\"\"\n\n    def _extract_digits(n: int) -> list[int]:\n        \"\"\"Extract individual digits from number into list.\"\"\"\n        if n == 0:\n            return [0]\n        digits = []\n        while n > 0:\n            digits.append(n % 10)\n            n //= 10\n        return digits[::-1] # Reverse to get correct order\n\n    def _count_distinct_digits(digits_list: list[int]) -> int:\n        \"\"\"Count unique digits in digit list.\"\"\"\n        return len(set(digits_list))\n\n    def _check_alternation(digits_list: list[int]) -> bool:\n        \"\"\"\n        Verify an alternating pattern between two digits.\n        Ensures no consecutive identical digits and strict ABABA... pattern.\n        \"\"\"\n        if len(digits_list) < 2:\n            return False # Should be handled by main function but as a safeguard\n\n        for i in range(1, len(digits_list)):\n            # Rule 1: No consecutive identical digits\n            if digits_list[i] == digits_list[i-1]:\n                return False\n            # Rule 2: Strict alternation, A == C in ABC pattern (A B A B A)\n            if i >= 2 and digits_list[i] != digits_list[i-2]:\n                return False\n        return True\n\n    if number <= 0:\n        return False\n\n    digits = _extract_digits(number)\n\n    if len(digits) < 2:\n        return False\n\n    if _count_distinct_digits(digits) != 2:\n        return False\n\n    return _check_alternation(digits)"}
{"task_id": "Mbpp/92", "solution": "def extract_digits(number: int) -> list[int]:\n    \"\"\"Converts an integer to a list of its digits from left to right.\"\"\"\n    return [int(d) for d in str(number)]\ndef validate_minimum_digits(number: int) -> bool:\n    \"\"\"Checks if the number has at least 3 digits.\"\"\"\n    return len(str(number)) >= 3\ndef count_distinct_digits(digits: list[int]) -> int:\n    \"\"\"Counts the number of distinct digits in a list.\"\"\"\n    return len(set(digits))\ndef check_alternating_pattern(digits: list[int]) -> bool:\n    \"\"\"Verifies that no two consecutive digits are the same.\"\"\"\n    for i in range(len(digits) - 1):\n        if digits[i] == digits[i+1]:\n            return False\n    return True\ndef is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks whether the given number is undulating.\n    An undulating number alternates between exactly two different digits and has at least 3 digits.\n    \"\"\"\n    if not validate_minimum_digits(number):\n        return False\n    \n    digits = extract_digits(number)\n    \n    if count_distinct_digits(digits) != 2:\n        return False\n        \n    if not check_alternating_pattern(digits):\n        return False\n        \n    return True"}
