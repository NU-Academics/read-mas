{"task_id": "Mbpp/294", "solution": "def max_val(input_list: list):\n    \"\"\"\n    Finds the maximum numeric value in a heterogeneous list, ignoring non-numeric elements.\n    \"\"\"\n    # Filter the list to include only integer and float values for comparison.\n    numeric_values = [item for item in input_list if isinstance(item, (int, float))]\n\n    # Return the maximum value from the filtered numeric list.\n    # This will raise a ValueError if no numeric values are found in the input_list.\n    return max(numeric_values)"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr: list) -> int:\n    \"\"\"\n    Counts the number of inversions in an array.\n    An inversion occurs when a larger element appears before a smaller element.\n    \"\"\"\n    inv_count = 0\n    n = len(arr)\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            if arr[i] > arr[j]:\n                inv_count += 1\n    return inv_count"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(array):\n    \"\"\"Counts inversions in an array using a nested loop approach.\n\n    An inversion occurs when array[i] > array[j] and i < j.\n    \"\"\"\n    n = len(array)\n    inv_count = 0\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            if array[i] > array[j]:\n                inv_count += 1\n    return inv_count"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(nested_list: list) -> list:\n    \"\"\"\n    Flattens a nested list structure into a single-dimensional list.\n    \"\"\"\n    flattened_result = []\n\n    def _is_list(element: any) -> bool:\n        \"\"\"Determines if an element is a list type.\"\"\"\n        return isinstance(element, list)\n\n    def _process_element(element: any, result: list) -> None:\n        \"\"\"Processes individual elements and handles recursive flattening.\"\"\"\n        if _is_list(element):\n            for item in element:\n                _process_element(item, result)\n        else:\n            result.append(element)\n\n    for element in nested_list:\n        _process_element(element, flattened_result)\n\n    return flattened_result"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(nested_list: list) -> list:\n    \"\"\"\n    Flatten a nested list structure into a single-level list.\n    \"\"\"\n    flattened = []\n    for item in nested_list:\n        if isinstance(item, list):\n            flattened.extend(flatten_list(item))\n        else:\n            flattened.append(item)\n    return flattened"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(tuple_list):\n    \"\"\"\n    Calculates the maximum aggregate from a list of name-value tuples.\n    Aggregates values by name and returns the name with the highest total and its sum.\n    \"\"\"\n    aggregated_data = {}\n    for name, value in tuple_list:\n        aggregated_data[name] = aggregated_data.get(name, 0) + value\n\n    if not aggregated_data:\n        return None  # Or a suitable default for an empty list\n\n    max_name = None\n    max_total = -float('inf')\n\n    for name, total in aggregated_data.items():\n        if total > max_total:\n            max_total = total\n            max_name = name\n            \n    return (max_name, max_total)"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(tuple_list):\n    \"\"\"\n    Calculates the maximum aggregate sum for names from a list of name-value tuples.\n    Returns the name with the highest total sum and its sum.\n    \"\"\"\n    aggregates = {}\n    for name, value in tuple_list:\n        aggregates[name] = aggregates.get(name, 0) + value\n\n    max_name = None\n    max_sum = -float('inf') # Initialize with a very small number to ensure any sum is greater\n\n    for name, current_sum in aggregates.items():\n        if current_sum > max_sum:\n            max_sum = current_sum\n            max_name = name\n\n    return (max_name, max_sum)"}
