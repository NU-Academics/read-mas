{"task_id": "Mbpp/643", "solution": "def text_match_wordz_middle(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string contains 'z', except at the start and end of any word.\n    Word boundaries are defined by non-alphabetic characters.\n    \"\"\"\n\n    def _is_alphabetic(char: str) -> bool:\n        \"\"\"Returns True if the character is an English alphabet letter, False otherwise.\"\"\"\n        return 'a' <= char.lower() <= 'z'\n\n    def _parse_words(text: str) -> list[str]:\n        \"\"\"Extracts alphabetic words from the input text.\"\"\"\n        words = []\n        current_word_chars = []\n        for char in text:\n            if _is_alphabetic(char):\n                current_word_chars.append(char)\n            else:\n                if current_word_chars:\n                    words.append(\"\".join(current_word_chars))\n                    current_word_chars = []\n        if current_word_chars:  # Add the last word if the text ends with an alphabetic sequence\n            words.append(\"\".join(current_word_chars))\n        return words\n\n    def _check_word_for_middle_z(word: str) -> bool:\n        \"\"\"Checks if a single word contains 'z' in any position other than its first or last.\"\"\"\n        if len(word) >= 3:\n            # Check characters from the second to the second-to-last\n            return 'z' in word[1:-1]\n        return False\n\n    words = _parse_words(input_string)\n    for word in words:\n        if _check_word_for_middle_z(word):\n            return True\n    return False"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(array: list, position: int) -> list:\n    \"\"\"Reverses elements of an array from index 0 up to a given position (exclusive).\n\n    Returns a new array with the first K elements reversed and the remaining elements unchanged.\n    \"\"\"\n    reversed_prefix = array[:position][::-1]\n    remaining_suffix = array[position:]\n    return reversed_prefix + remaining_suffix"}
