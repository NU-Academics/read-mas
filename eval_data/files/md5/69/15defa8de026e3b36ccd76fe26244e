{"task_id": "Mbpp/71", "solution": "def comb_sort(input_list):\n    \"\"\"Sorts a list of elements using the comb sort algorithm, returning a new sorted list.\"\"\"\n    arr = list(input_list)  # Create a copy to maintain immutability of the original list\n    n = len(arr)\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        # Calculate the next gap value\n        gap = int(gap / shrink_factor)\n        if gap < 1:\n            gap = 1\n\n        swapped = False  # Reset swapped flag for this pass\n\n        # Perform a modified bubble sort for the current gap\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True  # A swap occurred in this pass, so the list might not be fully sorted yet\n\n    return arr"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(array1, array2):\n    \"\"\"\n    Checks if two arrays follow the same structural pattern.\n    Compares element relationships at corresponding positions to determine sequence patterns.\n    \"\"\"\n    if len(array1) != len(array2):\n        return False\n\n    def _generate_pattern_sequence(arr):\n        \"\"\"Generates a canonical pattern sequence for a given array.\"\"\"\n        memo = {}\n        pattern_list = []\n        next_available_index = 0\n        for item in arr:\n            if item not in memo:\n                memo[item] = next_available_index\n                next_available_index += 1\n            pattern_list.append(memo[item])\n        return pattern_list\n\n    pattern_seq1 = _generate_pattern_sequence(array1)\n    pattern_seq2 = _generate_pattern_sequence(array2)\n\n    return pattern_seq1 == pattern_seq2"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(array1, array2):\n    \"\"\"\n    Checks if two arrays follow the same structural pattern.\n    Compares generated pattern sequences for equivalence.\n    \"\"\"\n    if len(array1) != len(array2):\n        return False\n\n    def _create_pattern_map(arr):\n        \"\"\"\n        Helper function to generate a list of pattern indices from an array.\n        Maps unique elements to new indices, returning the sequence of these indices.\n        \"\"\"\n        element_to_id = {}\n        pattern_sequence = []\n        next_id = 0\n        for element in arr:\n            if element not in element_to_id:\n                element_to_id[element] = next_id\n                next_id += 1\n            pattern_sequence.append(element_to_id[element])\n        return pattern_sequence\n\n    def _compare_pattern_maps(map1, map2):\n        \"\"\"\n        Helper function to compare two generated pattern maps (lists of indices).\n        \"\"\"\n        return map1 == map2\n\n    # Generate pattern maps (sequences of indices) for both arrays\n    pattern_map1 = _create_pattern_map(array1)\n    pattern_map2 = _create_pattern_map(array2)\n\n    # Compare the generated pattern maps\n    return _compare_pattern_maps(pattern_map1, pattern_map2)"}
{"task_id": "Mbpp/75", "solution": "def find_tuples(tuple_list, k):\n    \"\"\"\n    Finds tuples where all elements are divisible by k from a list of tuples.\n    Raises ValueError if k is zero.\n    \"\"\"\n    # Inline helper to check if a single element is divisible by the given divisor.\n    def _is_element_divisible(element, divisor):\n        return element % divisor == 0\n\n    # Inline helper to check if all elements in a tuple are divisible by the given divisor.\n    def _is_tuple_divisible(tuple_data, divisor):\n        for element in tuple_data:\n            if not _is_element_divisible(element, divisor):\n                return False\n        return True\n\n    # Validate that the divisor k is not zero, as per design.\n    if k == 0:\n        raise ValueError(\"Divisor k cannot be zero.\")\n\n    result_tuples = []\n    for current_tuple in tuple_list:\n        # Check if the entire tuple qualifies based on divisibility.\n        if _is_tuple_divisible(current_tuple, k):\n            result_tuples.append(current_tuple)\n\n    return result_tuples"}
