{"task_id": "Mbpp/3", "solution": "def is_not_prime(number) -> bool:\n    \"\"\"\n    Determine if a number is not prime.\n\n    Returns False if number is prime, True if number is not prime.\n    \"\"\"\n    n = int(number)\n\n    # Prime numbers are integers. If the number has a fractional part, it's not prime.\n    if n != number:\n        return True\n\n    # Numbers less than or equal to 1 are not prime.\n    if n <= 1:\n        return True\n    \n    # 2 is the only even prime number.\n    if n == 2:\n        return False\n    \n    # All other even numbers are not prime.\n    if n % 2 == 0:\n        return True\n    \n    # Check for divisors from 3 up to the square root of n, incrementing by 2.\n    # If a divisor is found, n is not prime.\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return True\n        i += 2\n            \n    # If no divisors were found, the number is prime.\n    return False"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1, num2):\n    \"\"\"\n    Checks if two numbers differ at exactly one bit position.\n    This is determined by XORing the numbers and counting the set bits in the result.\n    \"\"\"\n    xor_result = num1 ^ num2\n    # Count the number of set bits (1s) in the XOR result\n    set_bits_count = bin(xor_result).count('1')\n    return set_bits_count == 1"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1, num2):\n    \"\"\"\n    Checks if two numbers differ at exactly one bit position.\n    It uses XOR to find differing bits and then counts the set bits.\n    \"\"\"\n    xor_result = num1 ^ num2\n    count = 0\n    while xor_result > 0:\n        xor_result &= (xor_result - 1)  # Clear the least significant set bit\n        count += 1\n    return count == 1"}
{"task_id": "Mbpp/3", "solution": "import math\ndef is_not_prime(number: int) -> bool:\n    \"\"\"\n    Determines if the input number is not prime.\n    \"\"\"\n    return not _is_prime(number)\ndef _is_prime(number: int) -> bool:\n    \"\"\"\n    Helper function to determine if number is prime.\n    \"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    \n    # Check for factors from 3 up to the square root of the number\n    # Increment by 2 to only check odd numbers\n    for i in range(3, int(math.sqrt(number)) + 1, 2):\n        if number % i == 0:\n            return False\n            \n    return True"}
