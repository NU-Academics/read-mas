{"task_id": "Mbpp/780", "solution": "def find_combinations(tuple_list: list) -> list:\n    \"\"\"\n    Compute element-wise sums for all possible pairs of tuples from the input list.\n    Each tuple is paired with every subsequent tuple in the list.\n    \"\"\"\n    results = []\n    n = len(tuple_list)\n    for i in range(n):\n        for j in range(i + 1, n):\n            # Sum the first elements and the second elements of the pair\n            sum_first = tuple_list[i][0] + tuple_list[j][0]\n            sum_second = tuple_list[i][1] + tuple_list[j][1]\n            results.append((sum_first, sum_second))\n    return results"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list) -> list[list]:\n    \"\"\"\n    Packs consecutive duplicates of list elements into sublists.\n    Groups identical, consecutively appearing elements together.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = []\n    current_group = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] == current_group[-1]:\n            current_group.append(input_list[i])\n        else:\n            result.append(current_group)\n            current_group = [input_list[i]]\n    \n    result.append(current_group)  # Add the last group\n\n    return result"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list):\n    \"\"\"\n    Packs consecutive duplicates of list elements into sublists.\n    \"\"\"\n    if not input_list:\n        return []\n\n    packed_list = []\n    current_sublist = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] == current_sublist[-1]:\n            current_sublist.append(input_list[i])\n        else:\n            packed_list.append(current_sublist)\n            current_sublist = [input_list[i]]\n\n    packed_list.append(current_sublist)  # Append the last sublist\n    return packed_list"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks if the count of divisors of a positive integer 'n' is even.\n    Returns True if the divisor count is even, False otherwise.\n    \"\"\"\n    def _calculate_divisor_count(num: int) -> int:\n        \"\"\"Counts the total number of divisors for a given positive integer.\"\"\"\n        if num == 1:\n            return 1\n        \n        count = 0\n        i = 1\n        while i * i <= num:\n            if num % i == 0:\n                # If divisors are equal, count only one\n                if i * i == num:\n                    count += 1\n                else:\n                    # Otherwise count both\n                    count += 2\n            i += 1\n        return count\n\n    def _is_even(val: int) -> bool:\n        \"\"\"Determines if a given integer is even.\"\"\"\n        return val % 2 == 0\n\n    num_divisors = _calculate_divisor_count(n)\n    return _is_even(num_divisors)"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(number: int) -> bool:\n    \"\"\"\n    Checks if the count of divisors for a given integer is even.\n    \"\"\"\n    def _calculate_divisor_count(n: int) -> int:\n        \"\"\"Calculates the total number of divisors for a positive integer.\"\"\"\n        count = 0\n        i = 1\n        while i * i <= n:\n            if n % i == 0:\n                if i * i == n:\n                    count += 1\n                else:\n                    count += 2\n            i += 1\n        return count\n\n    def _is_even(c: int) -> bool:\n        \"\"\"Checks if a given count is an even number.\"\"\"\n        return c % 2 == 0\n\n    total_divisors = _calculate_divisor_count(number)\n    return _is_even(total_divisors)"}
{"task_id": "Mbpp/780", "solution": "def find_combinations(tuple_list):\n    \"\"\"\n    Finds combinations of sums with tuples in the given tuple list.\n    Calculates all pairwise sums (excluding self-pairing) and returns unique results\n    in order of their first appearance.\n    \"\"\"\n    \n    result_list = []\n    seen_sums = set()\n    n = len(tuple_list)\n\n    # Iterates through all possible ordered pairs (tuple_list[i], tuple_list[j])\n    # where i != j, ensuring both (A,B) and (B,A) are considered for sums.\n    for i in range(n):\n        for j in range(n):\n            if i != j:  # Exclude self-pairing as per design context\n                t1 = tuple_list[i]\n                t2 = tuple_list[j]\n                \n                # Perform element-wise addition of two tuples\n                current_sum = (t1[0] + t2[0], t1[1] + t2[1])\n                \n                # Add to result_list only if the sum hasn't been seen before,\n                # preserving the order of first appearance as shown in the example.\n                if current_sum not in seen_sums:\n                    seen_sums.add(current_sum)\n                    result_list.append(current_sum)\n                    \n    return result_list"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(array):\n    \"\"\"\n    Calculates the sum of all elements in all odd-length subarrays of the given array.\n    \"\"\"\n    total_sum = 0\n    n = len(array)\n\n    for i in range(n):\n        for j in range(i, n):\n            # subarray is array[i:j+1]\n            subarray_length = j - i + 1\n            if subarray_length % 2 == 1:\n                # Sum elements of the current odd-length subarray\n                for k in range(i, j + 1):\n                    total_sum += array[k]\n    return total_sum"}
{"task_id": "Mbpp/782", "solution": "from typing import List\ndef odd_length_sum(array: List[int]) -> int:\n    \"\"\"\n    Calculate the sum of all odd-length subarrays.\n    Iterates through all subarrays, checks their length, and sums elements if length is odd.\n    \"\"\"\n    total_sum = 0\n    n = len(array)\n\n    for i in range(n):\n        for j in range(i, n):\n            # Calculate the length of the current subarray\n            current_length = j - i + 1\n            \n            # Check if the length is odd\n            if current_length % 2 == 1:\n                # Sum elements of the odd-length subarray\n                for k in range(i, j + 1):\n                    total_sum += array[k]\n    \n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "from typing import List\ndef find_first_even(input_list: List[int]) -> int:\n    \"\"\"Helper function to find first even number in list.\"\"\"\n    for num in input_list:\n        if num % 2 == 0:\n            return num\n    # The problem implies such numbers will always be found based on the assert.\n    # No exception handling for missing numbers as per instructions.\ndef find_first_odd(input_list: List[int]) -> int:\n    \"\"\"Helper function to find first odd number in list.\"\"\"\n    for num in input_list:\n        if num % 2 != 0:\n            return num\n    # The problem implies such numbers will always be found based on the assert.\n    # No exception handling for missing numbers as per instructions.\ndef calculate_product(even: int, odd: int) -> int:\n    \"\"\"Helper function to calculate product of two numbers.\"\"\"\n    return even * odd\ndef mul_even_odd(input_list: List[int]) -> int:\n    \"\"\"Main function to find product of first even and odd numbers.\"\"\"\n    first_even = find_first_even(input_list)\n    first_odd = find_first_odd(input_list)\n    return calculate_product(first_even, first_odd)"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the product of the first even and first odd number in a list.\n    Assumes at least one even and one odd number are present.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n\n        # If both are found, we can stop early\n        if first_even is not None and first_odd is not None:\n            break\n\n    # As per requirements, we assume both will be found for valid inputs.\n    return first_even * first_odd"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(string_input: str) -> tuple:\n    \"\"\"\n    Convert a string representation of a tuple containing integers\n    into an actual integer tuple.\n    \"\"\"\n    if not (string_input.startswith('(') and string_input.endswith(')')):\n        raise ValueError(\"Invalid tuple format: Must start with '(' and end with ')'\")\n\n    content = string_input[1:-1].strip()\n\n    if not content:\n        return ()\n\n    str_values = [s.strip() for s in content.split(',')]\n\n    int_values = []\n    for s_val in str_values:\n        try:\n            int_values.append(int(s_val))\n        except ValueError:\n            raise ValueError(f\"Invalid tuple format: Cannot convert '{s_val}' to an integer\")\n\n    return tuple(int_values)"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(tuple_str: str) -> tuple:\n    \"\"\"\n    Converts a string representation of an integer tuple to an actual integer tuple.\n    Assumes the input string is correctly formatted as '(int1, int2, ...)'.\n    \"\"\"\n    # Remove leading and trailing parentheses\n    inner_str = tuple_str[1:-1]\n\n    # Handle empty tuple case (e.g., \"()\")\n    if not inner_str.strip():\n        return ()\n\n    # Split the string by comma and strip whitespace from each element\n    str_elements = [s.strip() for s in inner_str.split(',')]\n\n    # Convert each string element to an integer\n    int_elements = [int(s) for s in str_elements]\n\n    # Convert the list of integers to a tuple\n    return tuple(int_elements)"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(array: list, target: any) -> int:\n    \"\"\"\n    Locates the rightmost insertion point for a specified value in a sorted array.\n    Uses binary search to achieve O(log n) time complexity.\n    \"\"\"\n    low = 0\n    high = len(array)\n\n    while low < high:\n        mid = low + (high - low) // 2\n        if array[mid] <= target:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
