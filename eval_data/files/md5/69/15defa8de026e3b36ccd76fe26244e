{"task_id": "Mbpp/397", "solution": "def median_numbers(num1, num2, num3):\n    \"\"\"\n    Finds the median of three numbers.\n    The median is the middle value when the numbers are sorted.\n    \"\"\"\n    min_val = min(num1, num2, num3)\n    max_val = max(num1, num2, num3)\n    # The sum of the three numbers minus the min and max gives the median.\n    median_val = num1 + num2 + num3 - min_val - max_val\n    return float(median_val)"}
{"task_id": "Mbpp/395", "solution": "def first_non_repeating_character(input_string: str) -> str | None:\n    \"\"\"\n    Finds the first non-repeated character in a given string.\n    Returns None if all characters are repeated or the string is empty.\n    \"\"\"\n    def _count_characters(s: str) -> dict[str, int]:\n        \"\"\"Counts occurrences of each character in the input string.\"\"\"\n        counts = {}\n        for char in s:\n            counts[char] = counts.get(char, 0) + 1\n        return counts\n\n    def _find_first_unique(s: str, char_counts: dict[str, int]) -> str | None:\n        \"\"\"Finds the first character with a count of 1, preserving order.\"\"\"\n        for char in s:\n            if char_counts[char] == 1:\n                return char\n        return None\n\n    if not input_string:\n        return None\n\n    char_counts = _count_characters(input_string)\n    return _find_first_unique(input_string, char_counts)"}
{"task_id": "Mbpp/397", "solution": "def median_numbers(num1: float, num2: float, num3: float) -> float:\n    \"\"\"Calculate and return the median of three numbers as a float.\"\"\"\n    \n    # The median of three numbers is the one that is not the minimum and not the maximum.\n    # We can find it by summing all three numbers and subtracting the minimum and maximum.\n    return float(num1 + num2 + num3 - min(num1, num2, num3) - max(num1, num2, num3))"}
