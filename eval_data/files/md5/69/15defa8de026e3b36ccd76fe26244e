{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number using dynamic programming based on Bell's triangle.\n    The Bell number B(n) is the number of partitions of a set of n elements.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Initialize a 2D list to store Bell's triangle values.\n    # bell_triangle[i][j] stores the j-th element of the i-th row.\n    bell_triangle = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # Base case for Bell's triangle.\n    bell_triangle[0][0] = 1\n\n    # Fill the Bell's triangle row by row.\n    for i in range(1, n + 1):\n        # The first element of the current row is the last element of the previous row.\n        bell_triangle[i][0] = bell_triangle[i - 1][i - 1]\n        # Fill the rest of the elements in the current row.\n        for j in range(1, i + 1):\n            # Each subsequent element is the sum of the element to its left\n            # and the element above and to its left from the previous row.\n            bell_triangle[i][j] = bell_triangle[i][j - 1] + bell_triangle[i - 1][j - 1]\n\n    # The nth Bell number is the first element of the nth row.\n    return bell_triangle[n][0]"}
{"task_id": "Mbpp/607", "solution": "import re\nfrom typing import Tuple\ndef find_literals(text: str, pattern: str) -> Tuple[str, int, int]:\n    \"\"\"\n    Search for first occurrence of regex pattern in text.\n\n    Returns:\n        Tuple containing (matched_substring, start_index, end_index)\n    \"\"\"\n    match_obj = re.search(pattern, text)\n    if not match_obj:\n        raise ValueError(\"No match found for the given pattern in the text.\")\n\n    matched_substring = match_obj.group(0)\n    start_index = match_obj.start()\n    end_index = match_obj.end()\n\n    return (matched_substring, start_index, end_index)"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number using the Bell triangle dynamic programming method.\n    The Bell number B(n) represents the number of partitions of a set of n elements.\n    \"\"\"\n    # Initialize the Bell triangle with B(0) = 1.\n    # bell_triangle[i] stores the elements of the i-th row (0-indexed).\n    # The nth Bell number B(n) will be the first element of bell_triangle[n].\n    bell_triangle = [[1]]\n\n    # Generate rows of the Bell triangle up to the nth row.\n    for i in range(1, n + 1):\n        # The first element of the current row is the last element of the previous row.\n        current_row = [bell_triangle[i - 1][-1]]\n        \n        # Populate the remaining elements of the current row.\n        # Each subsequent element is the sum of the element to its left in the current row\n        # and the element directly above and to its left in the previous row.\n        for j in range(1, i + 1):\n            current_row.append(current_row[j - 1] + bell_triangle[i - 1][j - 1])\n        \n        bell_triangle.append(current_row)\n    \n    # The nth Bell number B(n) is the first element of the nth row (0-indexed).\n    return bell_triangle[n][0]"}
{"task_id": "Mbpp/607", "solution": "import re\ndef find_literals(input_string: str, pattern: str) -> tuple[str, int, int]:\n    \"\"\"\n    Search for regex pattern in string and return match with indices.\n    Returns (None, -1, -1) if no match found.\n    \"\"\"\n    match = re.search(pattern, input_string)\n    if match:\n        return (match.group(0), match.start(), match.end())\n    else:\n        return (None, -1, -1)"}
