{"task_id": "Mbpp/643", "solution": "import string\ndef _parse_words(input_string: str) -> list[str]:\n    \"\"\"Parse input string into individual words, treating punctuation as separators.\"\"\"\n    temp_string = input_string\n    for char in string.punctuation:\n        temp_string = temp_string.replace(char, ' ')\n    words = [word for word in temp_string.split() if word]\n    return words\ndef _has_middle_z(word: str) -> bool:\n    \"\"\"Check if a single word has 'z' in a middle position.\"\"\"\n    if len(word) < 3:\n        return False\n    # Check for 'z' from the second character to the second-to-last character\n    for i in range(1, len(word) - 1):\n        if word[i] == 'z':\n            return True\n    return False\ndef text_match_wordz_middle(input_string: str) -> bool:\n    \"\"\"Checks if the input string contains 'z' in the middle of any word.\"\"\"\n    words = _parse_words(input_string)\n    for word in words:\n        if _has_middle_z(word):\n            return True\n    return False"}
