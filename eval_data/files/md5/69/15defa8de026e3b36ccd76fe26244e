{"task_id": "Mbpp/725", "solution": "def extract_quotation(input_string: str) -> list[str]:\n    \"\"\"\n    Extracts all values enclosed within double quotation marks from the given string.\n    Returns a list of extracted strings in order of appearance.\n    \"\"\"\n    extracted_values = []\n    start_search_index = 0\n\n    while True:\n        # Find the first opening double quote\n        opening_quote_index = input_string.find('\"', start_search_index)\n\n        if opening_quote_index == -1:\n            # No more opening quotes found, terminate the loop\n            break\n\n        # Find the closing double quote after the opening one\n        # Start searching from the character immediately after the opening quote\n        closing_quote_index = input_string.find('\"', opening_quote_index + 1)\n\n        if closing_quote_index == -1:\n            # An opening quote was found but no matching closing quote\n            # Advance start_search_index past the unmatched quote and continue\n            start_search_index = opening_quote_index + 1\n            continue\n\n        # Extract the content between the quotes\n        content = input_string[opening_quote_index + 1:closing_quote_index]\n        extracted_values.append(content)\n\n        # Update start_search_index to continue searching after the current closing quote\n        start_search_index = closing_quote_index + 1\n\n    return extracted_values"}
{"task_id": "Mbpp/725", "solution": "def extract_quotation(input_string: str) -> list[str]:\n    \"\"\"\n    Extracts all text values enclosed within double quotation marks from the input string.\n    Processes the string character by character to build a list of quoted segments.\n    \"\"\"\n    extracted_values = []\n    in_quote = False\n    current_quotation = []\n\n    for char in input_string:\n        if char == '\"':\n            if in_quote:\n                # Closing quote found, add the captured content\n                extracted_values.append(\"\".join(current_quotation))\n                current_quotation = []  # Reset for the next quote\n            in_quote = not in_quote  # Toggle the state\n        elif in_quote:\n            # Inside quotes, append character to current quotation\n            current_quotation.append(char)\n\n    return extracted_values"}
