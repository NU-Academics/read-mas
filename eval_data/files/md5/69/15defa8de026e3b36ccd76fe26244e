{"task_id": "Mbpp/290", "solution": "def max_length(lists: list[list]) -> tuple[int, list]:\n    \"\"\"\n    Finds the list with the maximum length in a list of lists.\n    Returns a tuple containing the maximum length and the first longest list found.\n    \"\"\"\n    max_len = 0\n    longest_list = []\n\n    for sublist in lists:\n        current_len = len(sublist)\n        if current_len > max_len:\n            max_len = current_len\n            longest_list = sublist\n            \n    return (max_len, longest_list)"}
{"task_id": "Mbpp/290", "solution": "def max_length(list_of_lists: list[list]) -> tuple:\n    \"\"\"\n    Find the list with maximum length from a list of lists.\n    Returns a tuple containing the maximum length and the longest list itself.\n    \"\"\"\n    max_len = 0\n    longest_list = []\n\n    for sublist in list_of_lists:\n        current_len = len(sublist)\n        if current_len > max_len:\n            max_len = current_len\n            longest_list = sublist\n\n    return (max_len, longest_list)"}
{"task_id": "Mbpp/286", "solution": "def max_sub_array_sum_repeated(array, length, repetition_count):\n    \"\"\"\n    Finds the largest sum of a contiguous array in the modified array formed by repeating the given array k times.\n    Handles edge cases for empty arrays or zero repetitions and optimizes for non-negative total array sums.\n    \"\"\"\n\n    # Handle edge cases where the array is empty or repetition count is zero.\n    if length == 0 or repetition_count == 0:\n        return 0\n\n    # Helper function to compute the maximum contiguous subarray sum using Kadane's algorithm.\n    def kadane_algorithm(arr):\n        if not arr:\n            return 0\n        max_so_far = arr[0]\n        current_max = arr[0]\n        for i in range(1, len(arr)):\n            current_max = max(arr[i], current_max + arr[i])\n            max_so_far = max(max_so_far, current_max)\n        return max_so_far\n\n    # Helper function to compute the maximum sum of a prefix subarray.\n    def compute_max_prefix_sum(arr):\n        if not arr: return 0\n        max_p_sum = -float('inf')\n        current_sum = 0\n        for num in arr:\n            current_sum += num\n            max_p_sum = max(max_p_sum, current_sum)\n        return max_p_sum\n\n    # Helper function to compute the maximum sum of a suffix subarray.\n    def compute_max_suffix_sum(arr):\n        if not arr: return 0\n        max_s_sum = -float('inf')\n        current_sum = 0\n        for num in reversed(arr):\n            current_sum += num\n            max_s_sum = max(max_s_sum, current_sum)\n        return max_s_sum\n\n    total_array_sum = sum(array)\n    max_kadane_single = kadane_algorithm(array)\n\n    # If repetition_count is 1, the problem reduces to standard Kadane's on the original array.\n    if repetition_count == 1:\n        return max_kadane_single\n\n    # If the total sum of the array is negative, repeating it more than twice will never increase the maximum sum.\n    # The maximum sum will either be contained within one copy or span across two concatenated copies.\n    if total_array_sum < 0:\n        return kadane_algorithm(array + array)\n    else:\n        # If the total sum of the array is non-negative, repeating it can increase the overall sum.\n        # The maximum sum could be:\n        # 1. A subarray entirely within a single copy (max_kadane_single).\n        # 2. A subarray formed by a suffix of the first array, (repetition_count - 2) full arrays,\n        #    and a prefix of the last array.\n        max_p_sum = compute_max_prefix_sum(array)\n        max_s_sum = compute_max_suffix_sum(array)\n\n        # Calculate the maximum sum that spans across multiple array repetitions.\n        # This includes the suffix of the first array, the full sums of (repetition_count - 2) middle arrays,\n        # and the prefix of the last array.\n        max_cross_boundary_sum = max_p_sum + max_s_sum + (repetition_count - 2) * total_array_sum\n        \n        # The overall maximum sum is the greater of the sum found within a single array\n        # or the sum found by spanning across multiple arrays.\n        return max(max_kadane_single, max_cross_boundary_sum)"}
