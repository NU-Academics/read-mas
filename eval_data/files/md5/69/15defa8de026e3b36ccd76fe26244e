{"task_id": "Mbpp/454", "solution": "import string\ndef text_match_wordz(input_string: str) -> bool:\n    \"\"\"\n    Checks if any word in the input string contains the character 'z'.\n    Handles punctuation and performs case-sensitive matching for 'z'.\n    \"\"\"\n\n    def _extract_words(text: str) -> list[str]:\n        \"\"\"Helper to extract words from text, removing punctuation.\"\"\"\n        cleaned_text = ''.join([' ' if c in string.punctuation else c for c in text])\n        return [word for word in cleaned_text.split() if word]\n\n    def _contains_z_word(words: list[str]) -> bool:\n        \"\"\"Helper to check if 'z' exists in any of the provided words.\"\"\"\n        for word in words:\n            if 'z' in word:\n                return True\n        return False\n\n    words = _extract_words(input_string)\n    return _contains_z_word(words)"}
{"task_id": "Mbpp/454", "solution": "import re\ndef text_match_wordz(input_string: str) -> bool:\n    \"\"\"\n    Checks if the input string contains any word that includes the character 'z'.\n    Punctuation marks are treated as word separators.\n    \"\"\"\n\n    def _parse_words(text: str) -> list[str]:\n        \"\"\"Splits text into words, treating non-alphanumeric characters as separators.\"\"\"\n        # Use regex to split by one or more non-word characters (\\W)\n        # and filter out any empty strings that may result from multiple delimiters.\n        words = [word for word in re.split(r'\\W+', text) if word]\n        return words\n\n    def _contains_z(word: str) -> bool:\n        \"\"\"Checks if a word contains the case-sensitive character 'z'.\"\"\"\n        return 'z' in word\n\n    words_in_text = _parse_words(input_string)\n    for word in words_in_text:\n        if _contains_z(word):\n            return True\n    return False"}
