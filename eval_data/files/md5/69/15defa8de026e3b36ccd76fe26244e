{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers: list) -> int:\n    \"\"\"\n    Finds the first even and first odd number in a list and returns their absolute difference.\n    Assumes the list will contain both an even and an odd number based on the problem description.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        \n        # Optimization: if both are found, no need to continue iterating\n        if first_even is not None and first_odd is not None:\n            break\n            \n    # The problem constraints and test case imply that both will be found.\n    # If they could be missing, explicit error handling or default values would be needed.\n    return abs(first_even - first_odd)"}
{"task_id": "Mbpp/597", "solution": "def find_kth(array1: list, array2: list, k: int) -> int:\n    \"\"\"\n    Finds the kth smallest element from two given sorted arrays.\n    \"\"\"\n    \n    # Ensure array1 is the shorter array for optimized binary search range.\n    if len(array1) > len(array2):\n        array1, array2 = array2, array1\n\n    m, n = len(array1), len(array2)\n\n    # Define the search space for partitionX (number of elements taken from array1)\n    # low: min elements to take from array1 (if k is large, array2 might not have enough)\n    # high: max elements to take from array1 (cannot take more than k, nor more than m)\n    low = max(0, k - n)\n    high = min(k, m)\n\n    while low <= high:\n        partitionX = (low + high) // 2\n        partitionY = k - partitionX\n\n        # Determine boundary elements for array1\n        # If partitionX is 0, nothing is on the left side, so max_left_X is -infinity\n        # If partitionX is m, nothing is on the right side, so min_right_X is +infinity\n        max_left_X = array1[partitionX - 1] if partitionX > 0 else float('-inf')\n        min_right_X = array1[partitionX] if partitionX < m else float('inf')\n\n        # Determine boundary elements for array2\n        # Similar logic for array2\n        max_left_Y = array2[partitionY - 1] if partitionY > 0 else float('-inf')\n        min_right_Y = array2[partitionY] if partitionY < n else float('inf')\n\n        # Check if the partitions are correct\n        # Condition 1: max element on the left side of X <= min element on the right side of Y\n        # Condition 2: max element on the left side of Y <= min element on the right side of X\n        if max_left_X <= min_right_Y and max_left_Y <= min_right_X:\n            # Found the correct partition\n            # The kth element is the maximum of the elements on the left side of the partition\n            return max(max_left_X, max_left_Y)\n        elif max_left_X > min_right_Y:\n            # We have taken too many elements from array1, need to reduce partitionX\n            high = partitionX - 1\n        else: # max_left_Y > min_right_X\n            # We have taken too few elements from array1, need to increase partitionX\n            low = partitionX + 1\n\n    # This part should ideally not be reached if k is valid and arrays are sorted.\n    # It signifies an error condition or invalid k, which is not handled by exceptions per instructions.\n    return -1 # Or raise an error, but not allowed by instructions. Assume valid inputs always find a solution."}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(number: int) -> bool:\n    \"\"\"\n    Checks if a number is an Armstrong number.\n    An Armstrong number is equal to the sum of its own digits each raised to the power of the number of digits.\n    \"\"\"\n    original_number = number\n    # Convert the number to a string to easily get its length and individual digits.\n    num_str = str(number)\n    num_digits = len(num_str)\n    \n    calculated_sum = 0\n    for digit_char in num_str:\n        digit = int(digit_char)\n        calculated_sum += digit ** num_digits\n        \n    return calculated_sum == original_number"}
{"task_id": "Mbpp/597", "solution": "from typing import List\ndef handle_edge_cases(array1: List[int], array2: List[int], k: int) -> bool:\n    \"\"\"Check for invalid k values. Returns False if k is invalid.\"\"\"\n    total_len = len(array1) + len(array2)\n    if k <= 0 or k > total_len:\n        return False\n    return True\ndef binary_search_kth(array1: List[int], array2: List[int], k: int) -> int:\n    \"\"\"Core binary search algorithm for finding kth element.\"\"\"\n    # Ensure array1 is the smaller array to optimize binary search range\n    if len(array1) > len(array2):\n        return binary_search_kth(array2, array1, k)\n\n    m, n = len(array1), len(array2)\n\n    # Handle edge case where array1 (the shorter one) is empty\n    if m == 0:\n        return array2[k-1]\n\n    # Binary search for partition in array1\n    # low represents the number of elements taken from array1\n    low = max(0, k - n)  # Minimum elements from array1 needed if array2 is full\n    high = min(m, k)     # Maximum elements from array1 possible or k in total\n\n    while low <= high:\n        partitionX = (low + high) // 2\n        partitionY = k - partitionX\n\n        # Determine elements at the boundaries of partitions\n        maxLeftX = float('-inf') if partitionX == 0 else array1[partitionX - 1]\n        minRightX = float('inf') if partitionX == m else array1[partitionX]\n\n        maxLeftY = float('-inf') if partitionY == 0 else array2[partitionY - 1]\n        minRightY = float('inf') if partitionY == n else array2[partitionY]\n\n        if maxLeftX <= minRightY and maxLeftY <= minRightX:\n            # Found the correct partition\n            return max(maxLeftX, maxLeftY)\n        elif maxLeftX > minRightY:\n            # We took too many elements from array1, shift partitionX to the left\n            high = partitionX - 1\n        else: # maxLeftY > minRightX\n            # We took too few elements from array1, shift partitionX to the right\n            low = partitionX + 1\n    \n    # This part should ideally not be reached if inputs are valid and logic is correct.\n    raise Exception(\"Algorithm failed to find kth element.\")\ndef find_kth(array1: List[int], array2: List[int], k: int) -> int:\n    \"\"\"Main function to find kth smallest element from two sorted arrays.\"\"\"\n    validate_sorted_arrays(array1, array2)\n\n    if not handle_edge_cases(array1, array2, k):\n        raise ValueError(\"k exceeds total array length or is non-positive.\")\n    \n    return binary_search_kth(array1, array2, k)"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(number: int) -> bool:\n    \"\"\"Checks if a given number is an Armstrong number.\"\"\"\n\n    def extract_digits(n: int) -> list:\n        \"\"\"Extracts individual digits from an integer.\"\"\"\n        return [int(d) for d in str(n)]\n\n    def count_digits(n: int) -> int:\n        \"\"\"Counts the total number of digits in an integer.\"\"\"\n        return len(str(n))\n\n    def calculate_power_sum(digits_list: list, power_val: int) -> int:\n        \"\"\"Calculates the sum of each digit raised to the specified power.\"\"\"\n        total_sum = 0\n        for digit in digits_list:\n            total_sum += digit ** power_val\n        return total_sum\n\n    digits = extract_digits(number)\n    num_digits = count_digits(number)\n    calculated_sum = calculate_power_sum(digits, num_digits)\n\n    return number == calculated_sum"}
