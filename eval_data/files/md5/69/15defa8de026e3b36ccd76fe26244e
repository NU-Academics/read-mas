{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) for i from 0 up to n // 2,\n    including terms only if they are positive.\n    \"\"\"\n    total_sum = 0\n    # Iterate through i values from 0 up to n // 2 (inclusive).\n    for i in range(n // 2 + 1):\n        term = n - 2 * i\n        # Add the term to the sum only if it's strictly positive.\n        # If a term is non-positive, subsequent terms will also be non-positive,\n        # so we can stop further calculations.\n        if term > 0:\n            total_sum += term\n        else:\n            break\n    return total_sum"}
{"task_id": "Mbpp/160", "solution": "def gcd(a: int, b: int) -> int:\n    \"\"\"Calculates the greatest common divisor of two integers using the Euclidean algorithm.\n    The result is always non-negative.\n    \"\"\"\n    a, b = abs(a), abs(b)\n    while b:\n        a, b = b, a % b\n    return a\ndef extended_euclidean(a: int, b: int) -> tuple[int, int, int]:\n    \"\"\"Applies the Extended Euclidean Algorithm to find g, x, y such that ax + by = g.\n    Here, g is the GCD of a and b. This implementation assumes a, b are non-negative.\n    \"\"\"\n    if a == 0:\n        return b, 0, 1\n    g, x1, y1 = extended_euclidean(b % a, a)\n    x = y1 - (b // a) * x1\n    y = x1\n    return g, x, y\ndef find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Finds integer solutions (x, y) for the linear Diophantine equation ax + by = n.\n    Returns (x, y) as a tuple if a solution exists, otherwise returns None.\n    \"\"\"\n    # Special case: when both a and b are zero\n    if a == 0 and b == 0:\n        if n == 0:\n            return (0, 0) # 0*x + 0*y = 0 has infinite solutions, (0,0) is a canonical one\n        else:\n            return None # 0*x + 0*y = n (n != 0) has no solution\n\n    common_divisor = gcd(a, b)\n\n    # A solution exists only if n is divisible by the greatest common divisor of a and b\n    if n % common_divisor != 0:\n        return None\n\n    # Calculate the scaling factor for Bezout coefficients\n    k = n // common_divisor\n\n    # Determine signs to adjust coefficients from extended_euclidean (which uses abs values)\n    sign_a = 1 if a >= 0 else -1\n    sign_b = 1 if b >= 0 else -1\n\n    # Call Extended Euclidean Algorithm on absolute values of a and b\n    # This gives g_bezout, x0_temp, y0_temp such that abs(a)*x0_temp + abs(b)*y0_temp = g_bezout\n    g_bezout, x0_temp, y0_temp = extended_euclidean(abs(a), abs(b))\n\n    # Adjust x0_temp and y0_temp based on the original signs of a and b\n    # This gives x0, y0 such that a*x0 + b*y0 = g_bezout\n    x0_normalized = x0_temp * sign_a\n    y0_normalized = y0_temp * sign_b\n    \n    # Scale x0_normalized and y0_normalized by 'k' to find a particular solution for ax + by = n\n    x_particular = x0_normalized * k\n    y_particular = y0_normalized * k\n\n    # Normalize the particular solution to find a specific (often \"smallest non-negative x\") solution.\n    # The general solution form is:\n    # x = x_particular + (b/g)*t\n    # y = y_particular - (a/g)*t\n    \n    # Coefficients for 't'\n    b_prime = b // common_divisor\n    a_prime = a // common_divisor\n\n    x_final = x_particular\n    y_final = y_particular\n\n    if b_prime != 0:\n        # Find 't' to shift x_particular into a canonical range (e.g., smallest non-negative x).\n        # This specific calculation ensures that one of the coordinates is in a predictable range.\n        t_adjust = - (x_particular // b_prime)\n        x_final = x_particular + b_prime * t_adjust\n        y_final = y_particular - a_prime * t_adjust\n    # If b_prime is 0 (i.e., b=0), then x is uniquely determined by ax=n, and y can be anything.\n    # The extended_euclidean for (abs(a), 0) naturally gives y0=0, resulting in y_particular=0.\n    # No further adjustment is typically needed for this canonical (x, 0) solution.\n\n    return (x_final, y_final)"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n):\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) from i=0 to n // 2,\n    including only positive terms.\n    \"\"\"\n    total_sum = 0\n    # Iterate 'i' from 0 up to n // 2 (inclusive)\n    for i in range(n // 2 + 1):\n        term = n - 2 * i\n        # Only add the term if it is strictly greater than 0\n        if term > 0:\n            total_sum += term\n        # The design context implies stopping addition if term <= 0.\n        # However, the loop range is fixed to n // 2 + 1.\n        # The 'if term > 0' condition correctly implements this.\n        # If an early break is desired, it would be:\n        # else:\n        #     break\n        # But the problem description \"until n-x =< 0\" and \"continue calculation until the term (n - 2*i) becomes less than or equal to 0\"\n        # can be interpreted as either stopping the loop or just not adding the non-positive terms.\n        # The example (6) -> 12 confirms that terms become 6, 4, 2, 0. The 0 term is not added.\n        # If it meant to break, it wouldn't change the outcome for n=6, but for other 'n' it might.\n        # The current `if term > 0` approach covers this gracefully within the fixed loop range.\n    return total_sum"}
{"task_id": "Mbpp/165", "solution": "def normalize_case(char: str) -> str:\n    \"\"\"Converts a character to lowercase.\"\"\"\n    return char.lower()\ndef get_alphabet_position(char: str) -> int:\n    \"\"\"Returns the 1-based position of a character in the alphabet.\"\"\"\n    # Assumes char is a single lowercase alphabetic character.\n    return ord(char) - ord('a') + 1\ndef is_alphabetic(char: str) -> bool:\n    \"\"\"Validates if a character is an alphabetic letter.\"\"\"\n    return char.isalpha()\ndef matches_position(char: str, string_position: int) -> bool:\n    \"\"\"Determines if a character matches its expected alphabet position.\"\"\"\n    normalized_char = normalize_case(char)\n    alphabet_pos = get_alphabet_position(normalized_char)\n    # string_position is 0-based, alphabet_pos is 1-based.\n    return alphabet_pos == (string_position + 1)\ndef count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in a string that occur at the same position\n    as in the English alphabet (case insensitive).\n    \"\"\"\n    count = 0\n    for i, char in enumerate(input_string):\n        if is_alphabetic(char):\n            if matches_position(char, i):\n                count += 1\n    return count"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a, b, n):\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple,\n    or returns None if no solution exists.\n    \"\"\"\n\n    def _gcd(num1, num2):\n        # Calculate the greatest common divisor, ensuring it's non-negative.\n        num1 = abs(num1)\n        num2 = abs(num2)\n        while num2:\n            num1, num2 = num2, num1 % num2\n        return num1\n\n    def _extended_euclidean_pos(a_pos, b_pos):\n        # Solves a_pos*x + b_pos*y = gcd(a_pos, b_pos) for non-negative a_pos, b_pos.\n        # Returns (g, x, y) where g is gcd, and x, y are Bezout coefficients.\n        x0, x1 = 1, 0\n        y0, y1 = 0, 1\n\n        while b_pos != 0:\n            q = a_pos // b_pos\n            a_pos, b_pos = b_pos, a_pos % b_pos\n            x0, x1 = x1, x0 - q * x1\n            y0, y1 = y1, y0 - q * y1\n        \n        return (a_pos, x0, y0)\n\n    # Handle the special case where both coefficients are zero.\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    g = _gcd(a, b)\n\n    # If n is not divisible by gcd(a,b), no integer solution exists.\n    if n % g != 0:\n        return None\n\n    # Calculate Bezout coefficients for abs(a) and abs(b)\n    _, x_abs, y_abs = _extended_euclidean_pos(abs(a), abs(b))\n\n    # Adjust Bezout coefficients for original signs of a and b\n    x_bezout = x_abs\n    if a < 0:\n        x_bezout = -x_bezout\n    \n    y_bezout = y_abs\n    if b < 0:\n        y_bezout = -y_bezout\n    \n    # Scale Bezout coefficients to find a particular solution for ax + by = n\n    k_scale = n // g\n    x_p = x_bezout * k_scale\n    y_p = y_bezout * k_scale\n\n    # Handle cases where one coefficient is zero, which results in a unique x or y.\n    if b == 0: # Equation is a*x = n. x is unique (n/a). y can be anything, return 0.\n        return (x_p, 0)\n    if a == 0: # Equation is b*y = n. y is unique (n/b). x can be anything, return 0.\n        return (0, y_p)\n\n    # Adjust the particular solution (x_p, y_p) to a canonical form,\n    # specifically finding the smallest non-negative x value.\n    # The general solution is (x_p + (b/g)*t, y_p - (a/g)*t).\n    # We find 't' such that x is minimal non-negative.\n    \n    b_div_g = b // g\n    a_div_g = a // g\n\n    # `t_shift` moves x to the desired range, e.g., smallest non-negative x.\n    # The `//` operator handles negative numbers consistently for this adjustment.\n    t_shift = -(x_p // b_div_g)\n    \n    x_final = x_p + b_div_g * t_shift\n    y_final = y_p - a_div_g * t_shift\n\n    return (x_final, y_final)"}
{"task_id": "Mbpp/165", "solution": "def is_alphabetic(char: str) -> bool:\n    \"\"\"Determines if a character is alphabetic.\"\"\"\n    return char.isalpha()\ndef normalize_case(char: str) -> str:\n    \"\"\"Converts character to lowercase for comparison.\"\"\"\n    return char.lower()\ndef get_alphabet_char(position: int) -> str:\n    \"\"\"Returns the expected alphabet character for a given 0-based position.\"\"\"\n    # 'a' is ASCII 97. Adding the position gives the ASCII for the corresponding letter.\n    return chr(ord('a') + position)\ndef count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in a string that occur at the same position in the string\n    as in the English alphabet (case insensitive).\n    \"\"\"\n    count = 0\n    for i, char in enumerate(input_string):\n        if is_alphabetic(char):\n            # The English alphabet has 26 letters (0-25).\n            if 0 <= i < 26:\n                normalized_char = normalize_case(char)\n                expected_char = get_alphabet_char(i)\n                if normalized_char == expected_char:\n                    count += 1\n    return count"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(numbers: list[int]) -> int:\n    \"\"\"\n    Counts the number of pairs of integers in a list that XOR to an even number.\n    An XOR operation results in an even number if and only if both operands\n    have the same parity (both even or both odd).\n    \"\"\"\n    odd_count = 0\n    even_count = 0\n\n    # Count the number of odd and even integers in the list.\n    for num in numbers:\n        if num % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # Pairs of two even numbers always XOR to an even number.\n    # The number of such pairs is nC2 = n * (n - 1) / 2.\n    even_xor_pairs = (even_count * (even_count - 1)) // 2\n\n    # Pairs of two odd numbers always XOR to an even number.\n    # The number of such pairs is nC2 = n * (n - 1) / 2.\n    odd_xor_pairs = (odd_count * (odd_count - 1)) // 2\n\n    # The total count is the sum of these two types of pairs.\n    return even_xor_pairs + odd_xor_pairs"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Handles n=0 by returning 1.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Decrement n to correctly handle cases where n is already a power of 2.\n    n -= 1\n\n    # Fill in all bits to the right of the most significant bit.\n    n |= n >> 1\n    n |= n >> 2\n    n |= n >> 4\n    n |= n >> 8\n    n |= n >> 16\n    # For 64-bit numbers, n |= n >> 32 would also be included.\n\n    # Add 1 to get the next power of 2.\n    return n + 1"}
