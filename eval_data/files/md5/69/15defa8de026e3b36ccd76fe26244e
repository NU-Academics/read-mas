{"task_id": "Mbpp/564", "solution": "def count_Pairs(list: list[int], length: int) -> int:\n    \"\"\"\n    Counts the number of possible unordered pairs from a list of integers\n    where both elements in each pair are unequal.\n    \"\"\"\n    n = len(list)\n    unequal_pairs_count = 0\n\n    # Iterate through all unique unordered pairs of indices (i, j) where i < j\n    for i in range(n):\n        for j in range(i + 1, n):\n            # If the elements at these indices are not equal, increment the count\n            if list[i] != list[j]:\n                unequal_pairs_count += 1\n    return unequal_pairs_count"}
{"task_id": "Mbpp/564", "solution": "def count_Pairs(numbers: list[int], length: int) -> int:\n    \"\"\"\n    Counts the number of possible unordered pairs where both elements are unequal.\n    Duplicate values at different indices are treated as separate elements.\n    \"\"\"\n\n    def _validate_input(numbers_list: list[int], expected_length: int) -> bool:\n        \"\"\"Checks if the actual length of the list matches the expected_length parameter.\"\"\"\n        # As per design, this function confirms length consistency.\n        return len(numbers_list) == expected_length\n\n    def _count_unequal_pairs(numbers_list: list[int]) -> int:\n        \"\"\"Implements the core logic to count unordered pairs of unequal elements.\"\"\"\n        count = 0\n        n = len(numbers_list)\n        # Iterate through all unique unordered pairs (i, j) where i < j.\n        for i in range(n):\n            for j in range(i + 1, n):\n                if numbers_list[i] != numbers_list[j]:\n                    count += 1\n        return count\n\n    # Handle edge cases for empty or single-element lists directly.\n    if len(numbers) < 2:\n        return 0\n\n    # Validate the input length against the provided 'length' parameter.\n    # The design context implies _validate_input would return True for consistent inputs.\n    # For valid cases, this check ensures the length parameter is correctly passed.\n    if not _validate_input(numbers, length):\n        # If length parameter is inconsistent, we return 0 as a safe default\n        # per constraints (no exceptions, no explicit error handling method).\n        return 0\n\n    # If the list is valid and long enough, proceed with counting.\n    return _count_unequal_pairs(numbers)"}
{"task_id": "Mbpp/566", "solution": "def sum_digits(number: int) -> int:\n    \"\"\"\n    Calculate the sum of digits in a non-negative integer.\n\n    Args:\n        number (int): Non-negative integer input\n\n    Returns:\n        int: Sum of all individual digits\n    \"\"\"\n    total_sum = 0\n    # Handle the case for 0 explicitly, as the loop won't run for it.\n    if number == 0:\n        return 0\n    \n    while number > 0:\n        digit = number % 10  # Get the last digit\n        total_sum += digit  # Add it to the total sum\n        number //= 10       # Remove the last digit\n\n    return total_sum"}
