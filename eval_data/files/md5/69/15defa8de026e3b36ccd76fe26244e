{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth power of the first n odd natural numbers.\n    \"\"\"\n\n    def _generate_odd_numbers(count: int) -> list[int]:\n        \"\"\"Generates a list containing the first 'count' odd natural numbers.\"\"\"\n        return [(2 * i - 1) for i in range(1, count + 1)]\n\n    def _calculate_fourth_power(number: int) -> int:\n        \"\"\"Calculates the fourth power of a given number.\"\"\"\n        return number ** 4\n\n    total_sum = 0\n    odd_numbers = _generate_odd_numbers(n)\n    for odd_num in odd_numbers:\n        total_sum += _calculate_fourth_power(odd_num)\n    return total_sum"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculate the sum of fourth powers of the first n odd natural numbers.\n    \"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        odd_number = 2 * i - 1\n        total_sum += odd_number ** 4\n    return total_sum"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(source_string: str, search_substring: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Finds the first occurrence and position of a substring within a string.\n    Returns a tuple (substring, start_index, end_index) or None if not found.\n    \"\"\"\n\n    def validate_inputs(source_string: str, search_substring: str) -> bool:\n        \"\"\"\n        Validates the input parameters, ensuring the search substring is not empty.\n        Returns True if inputs are valid for searching, False otherwise.\n        \"\"\"\n        if not search_substring:\n            return False\n        return True\n\n    def find_substring_position(source_string: str, search_substring: str) -> int:\n        \"\"\"\n        Finds the starting index of the first occurrence of the search_substring.\n        Returns the index if found, otherwise -1.\n        \"\"\"\n        return source_string.find(search_substring)\n\n    def calculate_end_position(start_position: int, substring_length: int) -> int:\n        \"\"\"\n        Calculates the exclusive end position based on the start position and substring length.\n        \"\"\"\n        return start_position + substring_length\n\n    if not validate_inputs(source_string, search_substring):\n        return None\n\n    start_pos = find_substring_position(source_string, search_substring)\n\n    if start_pos == -1:\n        return None\n    else:\n        end_pos = calculate_end_position(start_pos, len(search_substring))\n        return (search_substring, start_pos, end_pos)"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets, parentheses, and braces.\n    Uses a stack-based approach for O(n) time and space complexity.\n    \"\"\"\n    bracket_pairs = {\n        '(': ')',\n        '[': ']',\n        '{': '}'\n    }\n    opening_brackets = set(bracket_pairs.keys())\n    closing_brackets = set(bracket_pairs.values())\n    \n    stack = []\n\n    for char in expression:\n        if char in opening_brackets:\n            stack.append(char)\n        elif char in closing_brackets:\n            if not stack:\n                return False  # Closing bracket with no corresponding opening bracket\n            \n            last_open = stack.pop()\n            if bracket_pairs[last_open] != char:\n                return False  # Mismatched brackets\n\n    return not stack  # True if stack is empty (all brackets matched), False otherwise"}
{"task_id": "Mbpp/772", "solution": "def remove_length(text: str, k: int) -> str:\n    \"\"\"\n    Removes all words with exactly k characters from the input string.\n    The remaining words are joined back with single spaces, preserving their order.\n    \"\"\"\n    words = text.split()\n    filtered_words = [word for word in words if len(word) != k]\n    return ' '.join(filtered_words)"}
{"task_id": "Mbpp/771", "solution": "class BracketStack:\n    \"\"\"A stack data structure for tracking unmatched opening brackets.\"\"\"\n    def __init__(self):\n        self._stack = []\n\n    def push(self, bracket: str) -> None:\n        \"\"\"Adds a bracket to the top of the stack.\"\"\"\n        self._stack.append(bracket)\n\n    def pop(self) -> str:\n        \"\"\"Removes and returns the top bracket from the stack.\"\"\"\n        return self._stack.pop()\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the stack is empty.\"\"\"\n        return len(self._stack) == 0\n\n    def peek(self) -> str:\n        \"\"\"Returns the top bracket without removing it.\"\"\"\n        return self._stack[-1]\nclass BracketValidator:\n    \"\"\"Provides bracket type identification and matching logic.\"\"\"\n    def __init__(self):\n        self._opening_brackets = {'(', '[', '{'}\n        self._closing_brackets = {')', ']', '}'}\n        self._bracket_pairs = {'(': ')', '[': ']', '{': '}'}\n\n    def is_opening_bracket(self, char: str) -> bool:\n        \"\"\"Checks if a character is an opening bracket.\"\"\"\n        return char in self._opening_brackets\n\n    def is_closing_bracket(self, char: str) -> bool:\n        \"\"\"Checks if a character is a closing bracket.\"\"\"\n        return char in self._closing_brackets\n\n    def matches_bracket_pair(self, opening: str, closing: str) -> bool:\n        \"\"\"Checks if an opening and closing bracket form a valid pair.\"\"\"\n        return self._bracket_pairs.get(opening) == closing\ndef check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets.\n    It uses a stack to keep track of opening brackets and a validator for matching.\n    \"\"\"\n    stack = BracketStack()\n    validator = BracketValidator()\n\n    for char in expression:\n        if validator.is_opening_bracket(char):\n            stack.push(char)\n        elif validator.is_closing_bracket(char):\n            if stack.is_empty():\n                return False\n            opening_bracket = stack.pop()\n            if not validator.matches_bracket_pair(opening_bracket, char):\n                return False\n    \n    return stack.is_empty()"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(source_string: str, substring: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Finds the first occurrence of a substring within a string and returns its position.\n    Returns None if the substring is not found.\n    \"\"\"\n    start_index = source_string.find(substring)\n\n    if start_index == -1:\n        return None\n    else:\n        end_index = start_index + len(substring)\n        return (substring, start_index, end_index)"}
