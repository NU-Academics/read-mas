{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Finds the maximum consecutive run of uppercase characters in the given string.\n    Iterates through the string, tracking the current and maximum uppercase runs.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n\n    for char in input_string:\n        if char.isupper():\n            current_run += 1\n            max_run = max(max_run, current_run)\n        else:\n            current_run = 0\n            \n    return max_run"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Find the maximum run of consecutive uppercase characters in a string.\n\n    Args:\n        input_string (str): The string to analyze.\n\n    Returns:\n        int: Length of the longest consecutive uppercase sequence.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in input_string:\n        if char.isupper():\n            current_run += 1\n        else:\n            max_run = max(max_run, current_run)\n            current_run = 0\n    max_run = max(max_run, current_run) # Check one last time for a run at the end of the string\n    return max_run"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(list_of_lists):\n    \"\"\"\n    Returns the list with the highest sum of elements.\n    \"\"\"\n    if not list_of_lists:\n        return []\n\n    max_list = None\n    max_sum = -float('inf')\n\n    for sublist in list_of_lists:\n        current_sum = sum(sublist)\n        if current_sum > max_sum:\n            max_sum = current_sum\n            max_list = sublist\n    return max_list"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(list_of_lists):\n    \"\"\"\n    Returns the list with the highest sum of elements from a list of lists.\n    It identifies the list by comparing the sum of their numeric elements.\n    \"\"\"\n    return max(list_of_lists, key=sum)"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(numbers):\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    Returns True if the product is even, False otherwise.\n    \"\"\"\n    if not numbers:\n        # The product of an empty list is 1 (multiplicative identity), which is odd.\n        return False\n\n    product = 1\n    for num in numbers:\n        product *= num\n        # Optimization: if the product becomes 0 at any point, it will remain 0 and is even.\n        if product == 0:\n            return True\n            \n    # Check if the final product is even. This handles integers and floats that result in integer values.\n    return product % 2 == 0"}
{"task_id": "Mbpp/804", "solution": "from typing import List, Union\nNumber = Union[int, float]\ndef _validate_input(numbers: List) -> bool:\n    \"\"\"Validate input list.\"\"\"\n    # Per instructions, no isinstance() checks or exceptions for element types.\n    return True\ndef _calculate_product(numbers: List[Number]) -> Number:\n    \"\"\"Calculate the product of all numbers in the list.\"\"\"\n    product: Number = 1\n    for num in numbers:\n        product *= num\n    return product\ndef _is_even(product: Number) -> bool:\n    \"\"\"Check if a number is even.\"\"\"\n    return product % 2 == 0\ndef is_product_even(numbers: List[Number]) -> bool:\n    \"\"\"\n    Check whether the product of numbers in a list is even.\n\n    Args:\n        numbers: List of numeric values\n\n    Returns:\n        bool: True if product is even, False otherwise\n    \"\"\"\n    if not numbers:\n        return True\n\n    _validate_input(numbers)\n\n    product = _calculate_product(numbers)\n\n    return _is_even(product)"}
