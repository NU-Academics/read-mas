{"task_id": "Mbpp/103", "solution": "def _factorial(k: int) -> int:\n    \"\"\"Calculates the factorial of a non-negative integer.\"\"\"\n    if k < 0:\n        return 0\n    res = 1\n    for i in range(1, k + 1):\n        res *= i\n    return res\ndef _combinations(n_val: int, k_val: int) -> int:\n    \"\"\"Calculates the binomial coefficient C(n, k).\"\"\"\n    if k_val < 0 or k_val > n_val:\n        return 0\n    if k_val == 0 or k_val == n_val:\n        return 1\n    \n    # Optimization for k > n_val // 2\n    if k_val > n_val // 2:\n        k_val = n_val - k_val\n    \n    # Calculate using factorials as per design context\n    num = _factorial(n_val)\n    den = _factorial(k_val) * _factorial(n_val - k_val)\n    return num // den\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number a(n, m) using the direct summation formula.\n    This function leverages helper functions for factorial and combinations.\n    \"\"\"\n    # The standard formula for A(n,m) implicitly handles boundary conditions\n    # like A(n,m)=0 for m < 0 or m >= n (for n>0), and A(0,0)=1.\n    \n    total_sum = 0\n    # The formula is: A(n, m) = sum_{k=0 to m} (-1)^k * C(n+1, k) * (m - k + 1)^n\n    for k in range(m + 1):\n        term = ((-1)**k) * _combinations(n + 1, k) * ((m - k + 1)**n)\n        total_sum += term\n    return total_sum"}
