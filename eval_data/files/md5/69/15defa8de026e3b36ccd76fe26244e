{"task_id": "Mbpp/141", "solution": "def pancake_sort(arr: list) -> list:\n    \"\"\"\n    Sorts a list of elements using the pancake sort algorithm.\n    Returns a new sorted list in ascending order.\n    \"\"\"\n\n    def find_max_index(arr: list, n: int) -> int:\n        \"\"\"\n        Finds the index of the maximum element within the first n elements of the list.\n        \"\"\"\n        max_idx = 0\n        for i in range(1, n):\n            if arr[i] > arr[max_idx]:\n                max_idx = i\n        return max_idx\n\n    def flip(arr: list, i: int) -> None:\n        \"\"\"\n        Reverses elements from index 0 up to index i (inclusive) in the list.\n        \"\"\"\n        start = 0\n        end = i\n        while start < end:\n            arr[start], arr[end] = arr[end], arr[start]\n            start += 1\n            end -= 1\n\n    working_arr = list(arr)  # Create a working copy as per design\n    n = len(working_arr)\n\n    # Iterate from the largest unsorted portion down to 1 element\n    for current_size in range(n, 1, -1):\n        # Find index of the maximum element in the current unsorted portion (0 to current_size-1)\n        max_idx = find_max_index(working_arr, current_size)\n\n        # If the maximum element is not already at the end of the current unsorted portion\n        if max_idx != current_size - 1:\n            # Move the maximum element to the beginning if it's not already there\n            if max_idx != 0:\n                flip(working_arr, max_idx)\n\n            # Move the maximum element from the beginning to its correct sorted position\n            flip(working_arr, current_size - 1)\n\n    return working_arr"}
{"task_id": "Mbpp/141", "solution": "def pancake_sort(elements: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of integers using the pancake sort algorithm.\n    Returns a new list with elements sorted in ascending order.\n    \"\"\"\n    arr = list(elements)  # Work on a copy to preserve the original list\n\n    def _flip(arr_to_flip: list[int], index: int) -> None:\n        \"\"\"Reverses elements from index 0 to 'index' (inclusive) in the given list.\"\"\"\n        start = 0\n        while start < index:\n            arr_to_flip[start], arr_to_flip[index] = arr_to_flip[index], arr_to_flip[start]\n            start += 1\n            index -= 1\n\n    def _find_max_index(arr_to_search: list[int], size: int) -> int:\n        \"\"\"Finds the index of the maximum element within the first 'size' elements.\"\"\"\n        max_val = arr_to_search[0]\n        max_idx = 0\n        for i in range(1, size):\n            if arr_to_search[i] > max_val:\n                max_val = arr_to_search[i]\n                max_idx = i\n        return max_idx\n\n    n = len(arr)\n    for current_size in range(n, 1, -1):\n        # Find index of the maximum element in the current subarray arr[0...current_size-1]\n        max_index = _find_max_index(arr, current_size)\n\n        # If the maximum element is not already at its correct position\n        if max_index != current_size - 1:\n            # Move the maximum element to the front if it's not already there\n            _flip(arr, max_index)\n            # Move the maximum element to its final sorted position\n            _flip(arr, current_size - 1)\n\n    return arr"}
