{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal: int) -> str:\n    \"\"\"\n    Converts a decimal number to its binary string representation.\n    The output string will not have leading zeros, unless the input is 0.\n    \"\"\"\n    if decimal == 0:\n        return '0'\n\n    binary_string = ''\n    while decimal > 0:\n        remainder = decimal % 2\n        binary_string = str(remainder) + binary_string\n        decimal //= 2\n    return binary_string"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome greater than the input integer.\n    It iteratively checks numbers starting from n + 1 until a palindrome is found.\n    \"\"\"\n    def is_palindrome(num: int) -> bool:\n        \"\"\"Checks if an integer is a palindrome.\"\"\"\n        s = str(num)\n        return s == s[::-1]\n\n    candidate = n + 1\n    while True:\n        if is_palindrome(candidate):\n            return candidate\n        candidate += 1"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome greater than the input integer n.\n    It increments n and checks for palindrome property using helper functions.\n    \"\"\"\n\n    def reverse_number(num: int) -> int:\n        \"\"\"Reverses the digits of an integer.\"\"\"\n        reversed_num = 0\n        original_num = num\n        while original_num > 0:\n            digit = original_num % 10\n            reversed_num = reversed_num * 10 + digit\n            original_num //= 10\n        return reversed_num\n\n    def is_palindrome(num: int) -> bool:\n        \"\"\"Checks if a number is a palindrome by comparing it with its reverse.\"\"\"\n        if num < 0:\n            return False  # Negative numbers are not considered palindromes in this context\n        return num == reverse_number(num)\n\n    candidate = n + 1\n    while True:\n        if is_palindrome(candidate):\n            return candidate\n        candidate += 1"}
