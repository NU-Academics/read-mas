{"task_id": "Mbpp/244", "solution": "import math\ndef next_Perfect_Square(n: float) -> int:\n    \"\"\"\n    Calculates the smallest perfect square strictly greater than a given number.\n    It computes the integer part of the square root and adds one to find the root of the next perfect square.\n    \"\"\"\n    # Calculate the square root of the input number.\n    s = math.sqrt(n)\n    # The next_root is derived by taking the integer part of the square root and adding 1.\n    # This correctly handles both perfect and non-perfect squares to find the root for the next greater perfect square.\n    next_root = int(s) + 1\n    return next_root * next_root"}
{"task_id": "Mbpp/244", "solution": "import math\ndef next_Perfect_Square(number):\n    \"\"\"\n    Finds the smallest perfect square greater than a given number.\n    It calculates the floor of the square root, increments it, and squares the result.\n    \"\"\"\n    root_floor = math.floor(math.sqrt(number))\n    next_root = root_floor + 1\n    return next_root * next_root"}
{"task_id": "Mbpp/245", "solution": "def max_sum(array: list[int]) -> int:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence in the given array.\n    A sequence is bitonic if it is first increasing and then decreasing.\n    \"\"\"\n    n = len(array)\n    if n < 3:\n        # A bitonic subsequence typically requires at least 3 elements\n        # to have both an increasing and a decreasing part.\n        return 0\n\n    # Calculate LIS (Longest Increasing Subsequence Sum) ending at each index.\n    # lis_sums[i] stores the maximum sum of an increasing subsequence ending with array[i].\n    lis_sums = list(array)\n    for i in range(1, n):\n        for j in range(i):\n            if array[i] > array[j]:\n                lis_sums[i] = max(lis_sums[i], lis_sums[j] + array[i])\n\n    # Calculate LDS (Longest Decreasing Subsequence Sum) starting at each index.\n    # lds_sums[i] stores the maximum sum of a decreasing subsequence starting with array[i].\n    lds_sums = list(array)\n    for i in range(n - 2, -1, -1):\n        for j in range(n - 1, i, -1):\n            if array[i] > array[j]:\n                lds_sums[i] = max(lds_sums[i], lds_sums[j] + array[i])\n\n    max_bitonic_sum = 0\n    # Combine LIS and LDS sums to find the maximum bitonic subsequence sum.\n    # For a bitonic sequence with array[i] as the peak, lis_sums[i] and lds_sums[i]\n    # both include array[i]. We subtract array[i] once to avoid double counting.\n    # The conditions ensure that there is an actual increasing part (lis_sums[i] > array[i])\n    # and an actual decreasing part (lds_sums[i] > array[i]).\n    for i in range(n):\n        if lis_sums[i] > array[i] and lds_sums[i] > array[i]:\n            max_bitonic_sum = max(max_bitonic_sum, lis_sums[i] + lds_sums[i] - array[i])\n            \n    return max_bitonic_sum"}
{"task_id": "Mbpp/245", "solution": "def max_sum(array: list[int]) -> int:\n    \"\"\"Finds the maximum sum of a bitonic subsequence in the given array.\"\"\"\n    n = len(array)\n    if n == 0:\n        return 0\n\n    def find_increasing_sum(arr: list[int]) -> list[int]:\n        \"\"\"Calculates maximum increasing subsequence sum ending at each position.\"\"\"\n        m = len(arr)\n        inc_dp = list(arr)\n        for i in range(1, m):\n            for j in range(i):\n                if arr[i] > arr[j]:\n                    inc_dp[i] = max(inc_dp[i], inc_dp[j] + arr[i])\n        return inc_dp\n\n    def find_decreasing_sum(arr: list[int]) -> list[int]:\n        \"\"\"Calculates maximum decreasing subsequence sum starting at each position.\"\"\"\n        m = len(arr)\n        dec_dp = list(arr)\n        for i in range(m - 2, -1, -1):\n            for j in range(i + 1, m):\n                if arr[i] > arr[j]:\n                    dec_dp[i] = max(dec_dp[i], dec_dp[j] + arr[i])\n        return dec_dp\n\n    def calculate_max_bitonic_sum(inc_sums: list[int], dec_sums: list[int], original_arr: list[int]) -> int:\n        \"\"\"Combines increasing and decreasing sums to find maximum bitonic sum.\"\"\"\n        max_val = 0\n        m = len(original_arr)\n        for i in range(m):\n            # A bitonic subsequence with original_arr[i] as its peak.\n            # original_arr[i] is included in both inc_sums[i] and dec_sums[i],\n            # so it is subtracted once to get the correct total sum.\n            current_sum = inc_sums[i] + dec_sums[i] - original_arr[i]\n            max_val = max(max_val, current_sum)\n        return max_val\n\n    inc_sums = find_increasing_sum(array)\n    dec_sums = find_decreasing_sum(array)\n\n    return calculate_max_bitonic_sum(inc_sums, dec_sums, array)"}
