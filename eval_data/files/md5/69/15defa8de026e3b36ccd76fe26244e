{"task_id": "Mbpp/445", "solution": "def index_multiplication(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs index-wise multiplication of tuple elements.\n\n    Multiplies corresponding elements from nested tuples in the two input tuples.\n    \"\"\"\n    result = []\n    for sub_tuple1, sub_tuple2 in zip(tuple1, tuple2):\n        # Multiply the first elements and the second elements separately\n        multiplied_first = sub_tuple1[0] * sub_tuple2[0]\n        multiplied_second = sub_tuple1[1] * sub_tuple2[1]\n        result.append((multiplied_first, multiplied_second))\n    return tuple(result)"}
{"task_id": "Mbpp/440", "solution": "import string\ndef _clean_word(word: str) -> str:\n    \"\"\"Removes leading/trailing punctuation from a word.\"\"\"\n    return word.strip(string.punctuation)\ndef _is_adverb(word: str) -> bool:\n    \"\"\"Checks if a cleaned word ends with '-ly' (case-insensitive).\"\"\"\n    return word.lower().endswith('ly')\ndef _find_word_positions(sentence: str, word: str, index: int) -> tuple:\n    \"\"\"Calculates the start and end positions of a word given its start index.\"\"\"\n    # 'word' is the adverb text to be returned, 'index' is its starting position in 'sentence'.\n    return (index, index + len(word))\ndef find_adverb_position(sentence: str) -> tuple:\n    \"\"\"\n    Find the first adverb and its positions in a given sentence.\n    Returns (start_position, end_position, adverb_text) or None if no adverb found.\n    \"\"\"\n    words_and_indices = []\n    in_word = False\n    word_start = -1\n\n    # Manually iterate to find words (sequences of non-space characters)\n    # and their exact start indices in the original sentence.\n    for i, char in enumerate(sentence):\n        if char.isspace():\n            if in_word:\n                words_and_indices.append((sentence[word_start:i], word_start))\n                in_word = False\n        else: # not a space\n            if not in_word:\n                word_start = i\n                in_word = True\n    # Add the last word if the sentence does not end with a space\n    if in_word:\n        words_and_indices.append((sentence[word_start:len(sentence)], word_start))\n\n    for original_word_with_punct, original_word_start_idx in words_and_indices:\n        cleaned_adverb_text = _clean_word(original_word_with_punct)\n\n        if _is_adverb(cleaned_adverb_text):\n            # Calculate the true starting position of the *cleaned adverb* within the original sentence.\n            # E.g., for original_word_with_punct \"!!clearly!!\", cleaned_adverb_text is \"clearly\".\n            # The 'find' method gives the offset within original_word_with_punct.\n            offset_of_cleaned_in_original_word = original_word_with_punct.find(cleaned_adverb_text)\n\n            if offset_of_cleaned_in_original_word != -1:\n                start_pos_for_cleaned_adverb = original_word_start_idx + offset_of_cleaned_in_original_word\n                start_pos, end_pos = _find_word_positions(sentence, cleaned_adverb_text, start_pos_for_cleaned_adverb)\n                return (start_pos, end_pos, cleaned_adverb_text)\n\n    return None"}
{"task_id": "Mbpp/440", "solution": "import string\nimport re\ndef find_adverb_position(sentence: str) -> tuple | None:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    Returns a tuple (start_position, end_position, adverb_text) or None if no adverb is found.\n    \"\"\"\n\n    def _tokenize_sentence(text: str) -> list[tuple[str, int]]:\n        \"\"\"Splits text into tokens, preserving original form and tracking start indices.\"\"\"\n        tokens_with_indices = []\n        for match in re.finditer(r'\\S+', text): # Match sequences of non-whitespace characters\n            tokens_with_indices.append((match.group(0), match.start()))\n        return tokens_with_indices\n\n    def _clean_adverb_text(word: str) -> str:\n        \"\"\"Removes leading/trailing punctuation from a word.\"\"\"\n        return word.strip(string.punctuation)\n\n    def _is_adverb(word_text: str) -> bool:\n        \"\"\"Checks if a word is an adverb using common suffixes and a predefined list.\"\"\"\n        cleaned_word = _clean_adverb_text(word_text).lower()\n\n        COMMON_ADVERBS = {\n            \"very\", \"often\", \"always\", \"never\", \"sometimes\", \"here\", \"there\", \"now\", \"then\",\n            \"soon\", \"late\", \"early\", \"fast\", \"well\", \"hard\", \"rather\", \"quite\", \"almost\",\n            \"just\", \"already\", \"still\", \"yet\", \"ago\", \"today\", \"tomorrow\", \"yesterday\",\n            \"away\", \"back\", \"down\", \"in\", \"out\", \"up\", \"much\", \"more\", \"most\", \"less\", \"least\",\n            \"else\"\n        }\n\n        ADVERB_SUFFIXES = [\"ly\", \"ward\", \"wards\", \"wise\"]\n\n        if cleaned_word in COMMON_ADVERBS:\n            return True\n\n        for suffix in ADVERB_SUFFIXES:\n            if cleaned_word.endswith(suffix) and len(cleaned_word) > len(suffix):\n                return True\n        return False\n\n    def _calculate_positions(original_sentence: str, word: str, word_index: int) -> tuple[int, int]:\n        \"\"\"\n        Calculates the start and end positions of the cleaned adverb within the original sentence.\n        `original_sentence` parameter is kept for signature compliance but not directly used for calculation.\n        \"\"\"\n        cleaned_adverb = _clean_adverb_text(word)\n        \n        # Find the starting index of the cleaned adverb within its original token (`word`).\n        # This accounts for potential leading punctuation (e.g., \"!!adverb\").\n        relative_start_in_token = word.find(cleaned_adverb)\n        \n        # Calculate the absolute start position in the original sentence.\n        start_pos = word_index + relative_start_in_token\n        \n        # Calculate the absolute end position in the original sentence.\n        end_pos = start_pos + len(cleaned_adverb)\n        \n        return start_pos, end_pos\n\n    def _handle_no_adverb():\n        \"\"\"Returns None when no adverb is found.\"\"\"\n        return None\n\n    # Main orchestration logic\n    tokenized_sentence = _tokenize_sentence(sentence)\n\n    for word_text, start_index in tokenized_sentence:\n        if _is_adverb(word_text):\n            start_pos, end_pos = _calculate_positions(sentence, word_text, start_index)\n            cleaned_adverb = _clean_adverb_text(word_text)\n            return (start_pos, end_pos, cleaned_adverb)\n\n    return _handle_no_adverb()"}
