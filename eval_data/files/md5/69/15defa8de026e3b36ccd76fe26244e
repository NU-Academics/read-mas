{"task_id": "Mbpp/96", "solution": "import math\ndef divisor(n: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer.\n    Handles negative inputs by using their absolute value.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    # Work with the absolute value of n to count positive divisors.\n    num = abs(n)\n\n    count = 0\n    # Iterate from 1 up to the square root of num (inclusive) for efficiency.\n    for i in range(1, int(math.sqrt(num)) + 1):\n        if num % i == 0:\n            if i * i == num:\n                # If 'i' is the square root, it's one divisor.\n                count += 1\n            else:\n                # Otherwise, 'i' and 'num // i' are two distinct divisors.\n                count += 2\n    return count"}
{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"\n    Calculates the number of divisors for a given positive integer.\n    Includes 1 and the number itself in the count.\n    \"\"\"\n    count = 0\n    for i in range(1, n + 1):\n        if n % i == 0:\n            count += 1\n    return count"}
{"task_id": "Mbpp/97", "solution": "from collections import Counter\nfrom typing import List, Any, Dict\ndef frequency_lists(list_of_lists: List[List[Any]]) -> Dict[Any, int]:\n    \"\"\"\n    Calculates the frequency of each element in a flattened list of lists.\n    Returns the frequencies as a dictionary.\n    \"\"\"\n    flattened_list = [item for sublist in list_of_lists for item in sublist]\n    return dict(Counter(flattened_list))"}
