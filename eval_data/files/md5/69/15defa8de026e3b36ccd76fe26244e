{"task_id": "Mbpp/9", "solution": "def _find_period(s: str) -> int:\n    \"\"\"Calculates the length of the string's smallest repeating unit (period).\"\"\"\n    # Concatenate the string with itself and find the first occurrence of the original\n    # string starting from the second character. Its index is the period.\n    double_s = s + s\n    return double_s.find(s, 1)\ndef find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    \"\"\"\n    # The number of single character rotations required to return the string to its\n    # original state is equal to the length of its smallest repeating unit (period).\n    return _find_period(s)"}
{"task_id": "Mbpp/11", "solution": "def find_first_occurrence(text: str, char: str) -> int:\n    \"\"\"Finds the first occurrence of a character in a string.\"\"\"\n    return text.find(char)\ndef find_last_occurrence(text: str, char: str) -> int:\n    \"\"\"Finds the last occurrence of a character in a string.\"\"\"\n    return text.rfind(char)\ndef remove_character_at_positions(text: str, positions: list) -> str:\n    \"\"\"Removes characters from a string at specified positions.\"\"\"\n    if not positions:\n        return text\n\n    # Convert to a list of characters to allow efficient removal by index\n    char_list = list(text)\n\n    # Sort positions in reverse order to prevent index shifts when removing multiple characters\n    sorted_positions = sorted(positions, reverse=True)\n\n    for pos in sorted_positions:\n        if 0 <= pos < len(char_list):\n            char_list.pop(pos)\n\n    return \"\".join(char_list)\ndef remove_Occ(input_string: str, target_char: str) -> str:\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    If only one occurrence exists, that single instance is removed.\n    \"\"\"\n    first_idx = find_first_occurrence(input_string, target_char)\n    last_idx = find_last_occurrence(input_string, target_char)\n\n    if first_idx == -1:\n        # Character not found, return the original string\n        return input_string\n    elif first_idx == last_idx:\n        # Only one occurrence, remove that single instance\n        return remove_character_at_positions(input_string, [first_idx])\n    else:\n        # Multiple occurrences, remove both the first and last\n        return remove_character_at_positions(input_string, [first_idx, last_idx])"}
