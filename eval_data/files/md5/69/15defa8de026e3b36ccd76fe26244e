{"task_id": "Mbpp/260", "solution": "import math\ndef _is_prime(number: int) -> bool:\n    \"\"\"Checks if a given number is prime using trial division.\"\"\"\n    if number < 2:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(number)) + 1, 2):\n        if number % i == 0:\n            return False\n    return True\ndef _generate_nsw_sequence(limit: int) -> list[int]:\n    \"\"\"Generates the first 'limit' terms of the Newman-Shanks-Williams sequence (S_0 to S_{limit-1}).\"\"\"\n    if limit <= 0:\n        return []\n    if limit == 1:\n        return [1]\n\n    sequence = [1, 1]  # S_0 = 1, S_1 = 1\n    for i in range(2, limit):\n        next_val = 2 * sequence[i-1] + sequence[i-2]\n        sequence.append(next_val)\n    return sequence\ndef _get_nth_prime(primes: list[int], n_input: int) -> int:\n    \"\"\"\n    Extracts the corresponding NSW prime based on the specific problem indexing.\n    Given newman_prime(3) == 7, and a list of primes [7, 17, 41, ...],\n    n_input=3 maps to index 0 (7). This implies index = n_input - 3.\n    \"\"\"\n    # Assuming n_input >= 3 based on the problem statement and design constraints.\n    return primes[n_input - 3]\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the nth Newman\u2013Shanks\u2013Williams prime number.\n    According to the specific requirement, newman_prime(3) == 7.\n    \"\"\"\n    # The design context indicates \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n    # for the output, so input validation is conceptually skipped in the final code.\n\n    # 1. Generate a sufficiently long list of Newman-Shanks-Williams numbers.\n    # The design context suggests a limit of 50 terms (S_0 to S_49).\n    all_nsw_numbers = _generate_nsw_sequence(50)\n\n    # 2. Filter the generated numbers to find the relevant primes.\n    # Based on newman_prime(3) == 7 and the design's sequence diagram showing\n    # _get_nth_prime([7, 41, ...], 3), the primes considered for indexing start from 7 (S_3).\n    # This means S_2=3 is explicitly excluded from the list of NSW primes being indexed.\n    # Also, S_0=1 and S_1=1 are not primes.\n    final_nsw_primes = []\n    for num in all_nsw_numbers:\n        # Only consider numbers that could be part of the [7, 17, 41, ...] sequence.\n        # This implies ignoring 1 and 3 as relevant NSW primes for the nth indexing.\n        if num >= 7 and _is_prime(num):\n            final_nsw_primes.append(num)\n        # To ensure we have enough primes for larger 'n' if the initial limit was insufficient\n        # (though not expected for the given problem context).\n        # We need at least (n - 3 + 1) = (n - 2) primes in the final_nsw_primes list.\n        if len(final_nsw_primes) >= n - 2 and n >= 3:\n            break\n        elif n < 3: # To handle cases like n=1 or n=2, if they were expected to be valid later,\n                    # this would need more robust handling. For now, following n=3 implies min n.\n            if len(final_nsw_primes) >= 1: # just collect at least one prime.\n                break\n\n\n    # 3. Retrieve the nth prime based on the specific indexing rule.\n    # As derived, for newman_prime(3) == 7 and final_nsw_primes starting with 7,\n    # the index is n - 3.\n    return _get_nth_prime(final_nsw_primes, n)"}
