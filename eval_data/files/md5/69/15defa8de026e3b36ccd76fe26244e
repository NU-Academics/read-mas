{"task_id": "Mbpp/305", "solution": "def start_withp(input_list: list) -> tuple:\n    \"\"\"\n    Returns two words from a list of strings that start with lowercase 'p'.\n    \"\"\"\n\n    def split_words(string_list: list) -> list:\n        \"\"\"Extracts all individual words from a list of strings.\"\"\"\n        all_words = []\n        for s in string_list:\n            all_words.extend(s.split())\n        return all_words\n\n    def filter_p_words(words: list) -> list:\n        \"\"\"Filters a list of words, keeping only those starting with lowercase 'p'.\"\"\"\n        p_words = []\n        for word in words:\n            if word.startswith('p'):\n                p_words.append(word)\n        return p_words\n\n    def create_result_tuple(filtered_words: list) -> tuple:\n        \"\"\"Creates a tuple from the first two words in the list.\"\"\"\n        return (filtered_words[0], filtered_words[1])\n\n    all_words = split_words(input_list)\n    p_words = filter_p_words(all_words)\n    result_tuple = create_result_tuple(p_words)\n    return result_tuple"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(dictionary):\n    \"\"\"\n    Calculates the maximum nesting depth of a dictionary.\n    The depth starts from 1 for the top-level dictionary.\n    \"\"\"\n    # Initialize maximum depth found at the current level to 1.\n    # This accounts for the current dictionary itself.\n    max_current_level_depth = 1\n\n    # Iterate over all values in the dictionary.\n    for value in dictionary.values():\n        # If a value is itself a dictionary, recursively find its depth.\n        if isinstance(value, dict):\n            # The depth of a nested dictionary is 1 (for the current level)\n            # plus its own calculated depth.\n            nested_depth = 1 + dict_depth(value)\n            # Update the overall maximum depth if the nested depth is greater.\n            max_current_level_depth = max(max_current_level_depth, nested_depth)\n\n    return max_current_level_depth"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(dictionary: dict) -> int:\n    \"\"\"\n    Calculate the maximum depth of nested dictionaries.\n    The outermost dictionary is counted as level 1.\n    \"\"\"\n\n    def _is_dict(value) -> bool:\n        \"\"\"Checks if a given value is a dictionary.\"\"\"\n        return isinstance(value, dict)\n\n    def _traverse_dict(obj: dict, current_depth: int) -> int:\n        \"\"\"Recursively traverses the dictionary to find the maximum depth.\"\"\"\n        max_depth_found = current_depth\n\n        for value in obj.values():\n            if _is_dict(value):\n                max_depth_found = max(max_depth_found, _traverse_dict(value, current_depth + 1))\n        return max_depth_found\n\n    return _traverse_dict(dictionary, 1)"}
{"task_id": "Mbpp/305", "solution": "def _extract_all_words(input_list: list[str]) -> list[str]:\n    \"\"\"Extract all words from all strings in the input list.\"\"\"\n    return [word for s in input_list for word in s.split()]\ndef _filter_words_starting_with_p(words: list[str]) -> list[str]:\n    \"\"\"Filter words that start with 'p' (case-insensitive to match the example).\"\"\"\n    return [word for word in words if word.lower().startswith('p')]\ndef start_withp(input_list: list[str]) -> tuple[str, str]:\n    \"\"\"Return exactly two words starting with 'p' from input list.\"\"\"\n    all_words = _extract_all_words(input_list)\n    p_words = _filter_words_starting_with_p(all_words)\n    return (p_words[0], p_words[1])"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(array: list[int], length: int, i: int, k: int) -> int:\n    \"\"\"\n    Find maximum sum of increasing subsequence from prefix until ith index\n    and including element at kth index where k > i.\n    \"\"\"\n    # dp[j] stores the maximum sum of an increasing subsequence ending at index j\n    # within the prefix 0...i.\n    dp = [0] * (i + 1)\n\n    # Initialize dp array for the prefix 0 to i\n    for j in range(i + 1):\n        dp[j] = array[j]\n\n    # Compute maximum sum increasing subsequence for each element in the prefix 0 to i\n    for j in range(1, i + 1):\n        for prev_j in range(j):\n            if array[j] > array[prev_j]:\n                dp[j] = max(dp[j], dp[prev_j] + array[j])\n\n    # Find the maximum sum from dp[j] that can precede array[k]\n    # This means array[j] must be strictly less than array[k]\n    max_prefix_sum = 0\n    for j in range(i + 1):\n        if array[j] < array[k]:\n            max_prefix_sum = max(max_prefix_sum, dp[j])\n\n    # The total maximum sum is the best prefix sum plus the required element array[k]\n    return max_prefix_sum + array[k]"}
