{"task_id": "Mbpp/799", "solution": "def left_rotate(number: int, d: int) -> int:\n    \"\"\"\n    Rotates the bits of a 32-bit number to the left by d positions.\n    Bits that are shifted off the left end wrap around to the right end.\n    \"\"\"\n    BITS = 32\n    # Normalize d to be within the 0 to BITS-1 range\n    d %= BITS\n\n    # Perform the left shift and wrap-around combined\n    # (number << d) shifts bits to the left\n    # (number >> (BITS - d)) shifts the \"overflow\" bits back to the right\n    # The result is masked to ensure it fits within 32 bits\n    return ((number << d) | (number >> (BITS - d))) & ((1 << BITS) - 1)"}
{"task_id": "Mbpp/800", "solution": "def remove_all_spaces(input_string: str) -> str:\n    \"\"\"\n    Remove all whitespace characters from the input string.\n    It builds a new string by filtering out whitespace characters.\n    \"\"\"\n    return \"\".join(char for char in input_string if not char.isspace())"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(number: int, d: int) -> int:\n    \"\"\"\n    Rotates the bits of a 32-bit number left by d positions.\n    Bits shifted off the left end re-enter on the right.\n    \"\"\"\n    BIT_LENGTH = 32\n    # Normalize the rotation count to be within [0, BIT_LENGTH-1]\n    d = d % BIT_LENGTH\n\n    # Perform the left shift, and OR it with the bits that wrap around\n    # The final result is masked to ensure it remains a 32-bit integer.\n    result = ((number << d) | (number >> (BIT_LENGTH - d)))\n    \n    # Mask the result to ensure it stays within 32 bits, as Python integers have arbitrary precision.\n    mask = (1 << BIT_LENGTH) - 1\n    return result & mask"}
{"task_id": "Mbpp/800", "solution": "def remove_all_spaces(input_string: str) -> str:\n    \"\"\"\n    Removes all whitespace characters from the given string.\n    Iterates through the string and builds a new string with only non-whitespace characters.\n    \"\"\"\n    result = []\n    for char in input_string:\n        if not char.isspace():\n            result.append(char)\n    return \"\".join(result)"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a, b, c):\n    \"\"\"\n    Counts the number of equal integers among three given inputs.\n    Returns 3 if all are equal, 2 if exactly two are equal, and 0 otherwise.\n    \"\"\"\n    if a == b == c:\n        return 3\n    elif a == b or a == c or b == c:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a, b, c):\n    \"\"\"Counts the number of equal integers among three given values.\n\n    Returns 3 if all are equal, 2 if exactly two are equal, and 0 otherwise.\"\"\"\n    if a == b and b == c:\n        return 3\n    elif a == b or a == c or b == c:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/803", "solution": "import math\ndef is_perfect_square(number):\n    \"\"\"\n    Checks if the given number is a perfect square.\n    Returns True for perfect squares, False otherwise.\n    \"\"\"\n    if number < 0:\n        return False\n    \n    # Calculate the square root of the number\n    sqrt_val = math.sqrt(number)\n    \n    # A number is a perfect square if its square root is an integer.\n    # Check if the square root is an integer (allowing for minor floating point inaccuracies).\n    return sqrt_val == int(sqrt_val + 0.5) or sqrt_val == int(sqrt_val - 0.5)"}
{"task_id": "Mbpp/803", "solution": "import math\nfrom typing import Union\ndef is_perfect_square(number: Union[int, float]) -> bool:\n    \"\"\"\n    Check if a given number is a perfect square.\n    Returns True if the number is a perfect square, False otherwise.\n    \"\"\"\n    if number < 0:\n        return False\n\n    sqrt_val = math.sqrt(number)\n    \n    # Round the square root to the nearest integer.\n    # Then square this candidate root and compare it to the original number.\n    candidate_root = round(sqrt_val)\n    \n    return candidate_root * candidate_root == number"}
