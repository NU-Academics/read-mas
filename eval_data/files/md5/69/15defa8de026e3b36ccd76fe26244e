{"task_id": "Mbpp/748", "solution": "def _identify_capital_letters(text: str) -> list[int]:\n    \"\"\"Identifies positions of capital letters in the input string.\"\"\"\n    capital_positions = []\n    for i, char in enumerate(text):\n        if 'A' <= char <= 'Z':\n            capital_positions.append(i)\n    return capital_positions\ndef _is_word_boundary(text: str, position: int) -> bool:\n    \"\"\"Determines if a capital letter at given position starts a new word.\"\"\"\n    # The first character of the string should never have a preceding space.\n    if position == 0:\n        return False\n    # A space is needed if the character before the current capital letter is lowercase.\n    return text[position-1].islower()\ndef _insert_spaces(text: str, positions: list[int]) -> str:\n    \"\"\"Inserts spaces before specified positions in the string.\"\"\"\n    if not positions:\n        return text\n\n    result_parts = []\n    last_idx = 0\n    # Positions are assumed to be sorted ascending.\n    for pos in positions:\n        result_parts.append(text[last_idx:pos])\n        result_parts.append(' ')\n        last_idx = pos\n    \n    result_parts.append(text[last_idx:]) # Append any remaining part of the string.\n    return \"\".join(result_parts)\ndef capital_words_spaces(input_string: str) -> str:\n    \"\"\"\n    Puts spaces between words starting with capital letters in a given string.\n    \"\"\"\n    if not input_string:\n        return \"\"\n    \n    capital_indices = _identify_capital_letters(input_string)\n    \n    space_insertion_points = []\n    for idx in capital_indices:\n        # Check if the capital letter at `idx` should be preceded by a space.\n        # This implicitly skips the first character as per design.\n        if _is_word_boundary(input_string, idx):\n            space_insertion_points.append(idx)\n            \n    return _insert_spaces(input_string, space_insertion_points)"}
{"task_id": "Mbpp/751", "solution": "from typing import List\ndef check_min_heap(array: List[int]) -> bool:\n    \"\"\"\n    Check if the given array represents a valid min heap.\n    Compares parent nodes with their children to ensure the min heap property holds.\n    \"\"\"\n    n = len(array)\n\n    # An empty array or an array with a single element is considered a valid min heap.\n    if n <= 1:\n        return True\n\n    # Iterate only through parent nodes. The last parent node is at index (n // 2) - 1.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n and array[i] > array[left_child_idx]:\n            return False\n\n        # Check right child\n        if right_child_idx < n and array[i] > array[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr: list[int]) -> bool:\n    \"\"\"\n    Checks if the given array represents a valid min heap.\n    Iterates through non-leaf nodes to ensure parent values are less than or equal to their children.\n    \"\"\"\n    n = len(arr)\n\n    # An array with 0 or 1 element is always a min heap\n    if n <= 1:\n        return True\n\n    # The last non-leaf node is at index (n // 2) - 1\n    # We only need to check nodes that have children\n    for i in range(n // 2 - 1, -1, -1):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n and arr[i] > arr[left_child_idx]:\n            return False\n\n        # Check right child (if it exists)\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth Jacobsthal number.\n    Uses an iterative approach based on the recurrence relation J(n) = J(n-1) + 2*J(n-2).\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1 or n == 2:\n        return 1\n    \n    # Initialize variables for J(n-2) and J(n-1)\n    # At loop iteration i, prev2 holds J(i-2) and prev1 holds J(i-1)\n    prev2 = 1  # Corresponds to J(1) if starting the sequence calculation from J(3)\n    prev1 = 1  # Corresponds to J(2) if starting the sequence calculation from J(3)\n    \n    # Calculate Jacobsthal numbers iteratively from J(3) up to J(n)\n    for _ in range(3, n + 1):\n        current = prev1 + 2 * prev2\n        prev2 = prev1\n        prev1 = current\n        \n    return current"}
{"task_id": "Mbpp/753", "solution": "def min_k(tuple_list, k):\n    \"\"\"\n    Finds the k records with the minimum second element values from a list of tuples.\n    Returns the k smallest tuples, sorted in ascending order by their second element.\n    \"\"\"\n    sorted_list = sorted(tuple_list, key=lambda x: x[1])\n    return sorted_list[:k]"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth Jacobsthal number using an iterative approach.\n    Handles base cases J(0)=0, J(1)=1 and the recurrence J(n) = J(n-1) + 2*J(n-2).\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    a, b = 0, 1  # J(0), J(1)\n    for _ in range(2, n + 1):\n        a, b = b, a + 2 * b\n    return b"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds elements common to three lists at the same index.\n    Returns a list of such common elements.\n    \"\"\"\n    min_length = min(len(l1), len(l2), len(l3))\n    common_elements = []\n    for i in range(min_length):\n        if l1[i] == l2[i] and l2[i] == l3[i]:\n            common_elements.append(l1[i])\n    return common_elements"}
{"task_id": "Mbpp/753", "solution": "def min_k(records, k):\n    \"\"\"\n    Finds the minimum k records from a list of tuples based on their second element.\n    The returned list is sorted in ascending order by the second element.\n    \"\"\"\n    # Sort the records by their second element (index 1) in ascending order.\n    sorted_records = sorted(records, key=lambda x: x[1])\n\n    # Select the first k elements from the sorted list.\n    # Python slicing handles cases where k might be greater than the list length\n    # by returning all available elements.\n    return sorted_records[:k]"}
