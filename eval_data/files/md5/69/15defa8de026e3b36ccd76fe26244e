{"task_id": "Mbpp/589", "solution": "import math\ndef perfect_squares(start: int, end: int) -> list[int]:\n    \"\"\"\n    Finds perfect squares within a given range [start, end].\n    Returns a sorted list of perfect squares.\n    \"\"\"\n    squares = []\n    # Ensure start is non-negative since we're looking for squares\n    current_num = max(1, start) \n    \n    # We can optimize by iterating through square roots instead of numbers.\n    # Find the smallest integer whose square is >= start.\n    # Find the largest integer whose square is <= end.\n    \n    # Calculate the smallest integer whose square is >= start\n    # math.ceil(math.sqrt(start)) gives the starting square root candidate\n    # We need to handle cases where start is 1 or 0\n    start_sqrt_candidate = math.ceil(math.sqrt(max(0, start)))\n    \n    # Iterate through potential square roots\n    # The squares will be sorted naturally\n    for i in range(int(start_sqrt_candidate), int(math.floor(math.sqrt(end))) + 1):\n        square = i * i\n        if square >= start and square <= end:\n            squares.append(square)\n            \n    return squares"}
{"task_id": "Mbpp/589", "solution": "def perfect_squares(start: int, end: int) -> list[int]:\n    \"\"\"\n    Finds perfect squares within a given inclusive range.\n    Returns a list of perfect squares in ascending order.\n    \"\"\"\n    if end < start:\n        return []\n\n    perfect_squares_list = []\n    \n    # Calculate the minimum potential integer root to check.\n    # We consider 0 as the lower bound for roots to ensure non-negative squares.\n    min_root = int(max(0, start)**0.5)\n    \n    # Calculate the maximum potential integer root to check.\n    max_root = int(end**0.5)\n\n    # Iterate through potential integer roots and check their squares.\n    for i in range(min_root, max_root + 1):\n        square = i * i\n        if start <= square <= end:\n            perfect_squares_list.append(square)\n            \n    return perfect_squares_list"}
{"task_id": "Mbpp/590", "solution": "import math\ndef polar_rect(r: float, theta: float) -> tuple[tuple[float, float], complex]:\n    \"\"\"\n    Converts polar coordinates (r, theta) to rectangular coordinates (x, y),\n    returning both magnitude/phase and complex number representations.\n    \"\"\"\n    # Calculate rectangular coordinates from polar input (r, theta)\n    x = r * math.cos(theta)\n    y = r * math.sin(theta)\n\n    # Calculate magnitude and phase for the resulting rectangular coordinates\n    magnitude = math.sqrt(x**2 + y**2)\n    phase = math.atan2(y, x)\n\n    # Create the complex number representation\n    complex_num = complex(x, y)\n\n    return ((magnitude, phase), complex_num)"}
{"task_id": "Mbpp/591", "solution": "def swap_List(input_list):\n    \"\"\"\n    Interchanges the first and last elements in a list, returning a new list.\n    Middle elements remain in their original positions.\n    \"\"\"\n    list_length = len(input_list)\n\n    if list_length <= 1:\n        # For empty or single-element lists, no swapping is possible, return a copy.\n        return input_list[:]\n    else:\n        # Extract the first, last, and middle segments of the list.\n        first_element = input_list[0]\n        last_element = input_list[-1]\n        middle_elements = input_list[1:-1]\n\n        # Construct a new list with the last element first, followed by middle, then first.\n        return [last_element] + middle_elements + [first_element]"}
{"task_id": "Mbpp/591", "solution": "def swap_List(input_list: list) -> list:\n    \"\"\"\n    Interchanges the first and last elements in a list and returns a new list.\n    Handles lists with less than two elements by returning a copy of the original.\n    \"\"\"\n    if len(input_list) < 2:\n        return list(input_list)\n\n    first_element = input_list[0]\n    last_element = input_list[-1]\n    middle_elements = input_list[1:-1]\n\n    return [last_element] + middle_elements + [first_element]"}
{"task_id": "Mbpp/592", "solution": "import math\ndef _calculate_binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"\n    Calculates the binomial coefficient C(n, k).\n    Returns n! / (k! * (n-k)!)\n    \"\"\"\n    if k < 0 or k > n:\n        return 0\n    return math.factorial(n) // (math.factorial(k) * math.factorial(n - k))\ndef _get_consecutive_products(n: int) -> int:\n    \"\"\"\n    Calculates the sum of products of consecutive binomial coefficients C(n,k) * C(n, k+1).\n    Iterates from k=0 to n-1.\n    \"\"\"\n    total_sum = 0\n    for k in range(n):\n        coeff_k = _calculate_binomial_coefficient(n, k)\n        coeff_k_plus_1 = _calculate_binomial_coefficient(n, k + 1)\n        total_sum += coeff_k * coeff_k_plus_1\n    return total_sum\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Finds the sum of the product of consecutive binomial coefficients for a given n.\n    This function delegates the calculation to a helper function.\n    \"\"\"\n    return _get_consecutive_products(n)"}
{"task_id": "Mbpp/590", "solution": "import math\ndef polar_rect(radius: float, angle: float) -> tuple:\n    \"\"\"\n    Convert polar coordinates to rectangular coordinates.\n\n    Returns:\n        Tuple containing: (polar representation, rectangular complex representation)\n    \"\"\"\n    # Calculate polar representation\n    magnitude = radius\n    polar_angle = angle\n\n    # Calculate rectangular complex number\n    real_part = radius * math.cos(angle)\n    imaginary_part = radius * math.sin(angle)\n    complex_number = complex(real_part, imaginary_part)\n\n    # Construct output tuple\n    polar_representation = (magnitude, polar_angle)\n\n    return (polar_representation, complex_number)"}
{"task_id": "Mbpp/592", "solution": "def _calculate_binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"Calculates individual binomial coefficient C(n,k) using an iterative method.\"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n\n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\ndef _calculate_consecutive_products(n: int) -> list[int]:\n    \"\"\"Calculates products of consecutive binomial coefficients C(n,k) * C(n,k+1).\"\"\"\n    products = []\n    for k in range(n):\n        coeff_k = _calculate_binomial_coefficient(n, k)\n        coeff_k_plus_1 = _calculate_binomial_coefficient(n, k + 1)\n        products.append(coeff_k * coeff_k_plus_1)\n    return products\ndef _sum_products(products: list[int]) -> int:\n    \"\"\"Sums all calculated products in a list.\"\"\"\n    return sum(products)\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the product of consecutive binomial coefficients for a given integer n.\n    It orchestrates the calculation of coefficients, their products, and the final sum.\n    \"\"\"\n    if n < 0:\n        return 0 # No consecutive products for negative n.\n        \n    products_list = _calculate_consecutive_products(n)\n    total_sum = _sum_products(products_list)\n    return total_sum"}
