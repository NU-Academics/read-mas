{"task_id": "Mbpp/123", "solution": "import math\ndef find_proper_divisors(number: int) -> list[int]:\n    \"\"\"\n    Finds all proper divisors of a given number.\n    Proper divisors are positive divisors excluding the number itself.\n    \"\"\"\n    if number <= 1:\n        return []\n    divs = [1]\n    for i in range(2, int(math.sqrt(number)) + 1):\n        if number % i == 0:\n            divs.append(i)\n            if i * i != number:\n                divs.append(number // i)\n    return divs\ndef sum_of_proper_divisors(number: int) -> int:\n    \"\"\"\n    Calculates the sum of all proper divisors of a number.\n    Returns 0 if the number is 1 or less.\n    \"\"\"\n    return sum(find_proper_divisors(number))\ndef is_amicable_pair(a: int, b: int) -> bool:\n    \"\"\"\n    Checks if two numbers form an amicable pair.\n    An amicable pair (a, b) consists of two different numbers\n    such that the sum of proper divisors of a is b and the sum of proper divisors of b is a.\n    \"\"\"\n    if a == b or a <= 1 or b <= 1:\n        return False\n    return sum_of_proper_divisors(a) == b and sum_of_proper_divisors(b) == a\ndef find_amicable_numbers(limit: int) -> list[int]:\n    \"\"\"\n    Finds all amicable numbers within the range from 1 to the specified limit.\n    It identifies pairs (a, b) where both a and b are within the limit.\n    \"\"\"\n    amicable_set = set()\n    for n in range(1, limit + 1):\n        sum_d_n = sum_of_proper_divisors(n)\n\n        # Check conditions for a potential amicable pair (n, sum_d_n)\n        # We ensure n < sum_d_n to avoid processing pairs twice (e.g., (220, 284) and (284, 220))\n        # and also to avoid self-amicable numbers (perfect numbers where sum_d_n == n).\n        if n < sum_d_n and sum_d_n <= limit and n > 1:\n             if is_amicable_pair(n, sum_d_n):\n                amicable_set.add(n)\n                amicable_set.add(sum_d_n)\n    return sorted(list(amicable_set))\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"\n    Calculates the sum of all amicable numbers from 1 up to a specified limit.\n    \"\"\"\n    amicable_nums = find_amicable_numbers(limit)\n    return sum(amicable_nums)"}
{"task_id": "Mbpp/125", "solution": "def find_length(binary_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s in any substring.\n    Iterates through all substrings, counts 0s and 1s, and tracks the maximum absolute difference.\n    \"\"\"\n    n = len(binary_string)\n    max_diff = 0\n\n    if n == 0:\n        return 0\n\n    for i in range(n):\n        for j in range(i, n):\n            # Current substring\n            substring = binary_string[i : j + 1]\n            \n            # Count 0s and 1s in the substring\n            zero_count = 0\n            one_count = 0\n            for char in substring:\n                if char == '0':\n                    zero_count += 1\n                else: # char == '1'\n                    one_count += 1\n            \n            # Calculate the absolute difference\n            current_diff = abs(zero_count - one_count)\n            \n            # Update the maximum difference found\n            if current_diff > max_diff:\n                max_diff = current_diff\n                \n    return max_diff"}
