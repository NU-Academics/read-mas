{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(num: int) -> int:\n    \"\"\"\n    Sets the leftmost unset bit in the binary representation of the input integer.\n\n    If num is 0, the leftmost unset bit is at position 0, so it returns 1.\n    \"\"\"\n    if num == 0:\n        return 1\n\n    # Find the position of the most significant bit (leftmost set bit).\n    # For example, 10 (1010_2) has bit_length 4, so msb_pos is 3.\n    msb_pos = num.bit_length() - 1\n\n    # Iterate from the MSB position downwards to find the first (leftmost) unset bit.\n    for i in range(msb_pos, -1, -1):\n        # Check if the i-th bit is unset (0)\n        if not ((num >> i) & 1):\n            # If unset, set this bit and return the new number.\n            return num | (1 << i)\n\n    # If the loop completes, it means all bits from msb_pos down to 0 are set (e.g., num = 7 (0111_2)).\n    # In this case, the leftmost unset bit is at position msb_pos + 1.\n    return num | (1 << (msb_pos + 1))"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(number: int) -> int:\n    \"\"\"Sets the leftmost unset bit in an integer to 1.\"\"\"\n\n    def _find_leftmost_unset_bit(num: int) -> int:\n        \"\"\"Locates the position of the leftmost unset bit.\"\"\"\n        if num == 0:\n            return 0  # The 0th bit is the leftmost unset bit for 0.\n\n        # Iterate from the highest bit present in the number (bit_length - 1) down to 0.\n        # If no unset bit is found, the leftmost unset bit is at position num.bit_length().\n        for pos in range(num.bit_length() - 1, -1, -1):\n            if not ((num >> pos) & 1):  # Check if the bit at 'pos' is 0\n                return pos\n        \n        # If all bits up to bit_length() - 1 are set (e.g., 7 which is 0111),\n        # the leftmost unset bit is at the next position (e.g., position 3 for 7).\n        return num.bit_length()\n\n    def _set_bit_at_position(num: int, position: int) -> int:\n        \"\"\"Sets a specific bit position to 1.\"\"\"\n        return num | (1 << position)\n\n    position_to_set = _find_leftmost_unset_bit(number)\n    return _set_bit_at_position(number, position_to_set)"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"Find the highest power of 2 that is less than or equal to n.\n    Returns 0 if n is less than or equal to 0, otherwise computes the highest power of 2.\n    \"\"\"\n    if n <= 0:\n        return 0\n\n    power = 1\n    # Iterate to find the highest power of 2\n    # The loop continues as long as the next power of 2 is less than or equal to n.\n    # Using bit shift (<< 1) for efficient multiplication by 2.\n    while (power << 1) <= n:\n        power <<= 1\n    return power"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    \"\"\"Calculates the n'th Lucas number using an iterative approach.\n\n    Handles base cases L(0)=2, L(1)=1, and computes L(n) = L(n-1) + L(n-2) for n > 1.\n    \"\"\"\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n\n    a, b = 2, 1  # L(0), L(1)\n    for _ in range(2, n + 1):\n        a, b = b, a + b\n    return b"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the highest power of 2 that is less than or equal to n.\n    Assumes n is a positive integer greater than or equal to 1.\n    \"\"\"\n    # The highest power of 2 less than or equal to n can be found by\n    # determining the position of the most significant bit of n.\n    # n.bit_length() gives the number of bits required to represent n,\n    # so (n.bit_length() - 1) is the index of the most significant bit.\n    # Shifting 1 left by this amount gives 2 to that power.\n    return 1 << (n.bit_length() - 1)"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    \"\"\"\n    Calculates the n'th Lucas number using an iterative approach.\n    Handles base cases L(0)=2, L(1)=1 and applies the recurrence L(n)=L(n-1)+L(n-2).\n    \"\"\"\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n\n    a, b = 2, 1  # a represents L(i-2), b represents L(i-1)\n    for _ in range(2, n + 1):\n        a, b = b, a + b\n    return b"}
