{"task_id": "Mbpp/619", "solution": "def move_num(input_string: str) -> str:\n    \"\"\"\n    Moves all numeric characters to the end of the given string,\n    preserving the order of both numeric and non-numeric characters.\n    \"\"\"\n\n    def is_numeric(char: str) -> bool:\n        \"\"\"Checks if a character is a digit.\"\"\"\n        return '0' <= char <= '9'\n\n    def extract_non_numeric_chars(input_str: str) -> str:\n        \"\"\"Extracts all non-numeric characters while preserving their order.\"\"\"\n        non_numeric_chars = []\n        for char in input_str:\n            if not is_numeric(char):\n                non_numeric_chars.append(char)\n        return \"\".join(non_numeric_chars)\n\n    def extract_numeric_chars(input_str: str) -> str:\n        \"\"\"Extracts all numeric characters while preserving their order.\"\"\"\n        numeric_chars = []\n        for char in input_str:\n            if is_numeric(char):\n                numeric_chars.append(char)\n        return \"\".join(numeric_chars)\n\n    def concatenate_parts(non_numeric: str, numeric: str) -> str:\n        \"\"\"Combines the non-numeric part with the numeric part.\"\"\"\n        return non_numeric + numeric\n\n    non_numeric_part = extract_non_numeric_chars(input_string)\n    numeric_part = extract_numeric_chars(input_string)\n    return concatenate_parts(non_numeric_part, numeric_part)"}
{"task_id": "Mbpp/619", "solution": "def extract_numeric_chars(input_str: str) -> str:\n    \"\"\"Extracts all numeric characters from a string, preserving their order.\"\"\"\n    numeric_chars = []\n    for char in input_str:\n        if char.isdigit():\n            numeric_chars.append(char)\n    return \"\".join(numeric_chars)\ndef extract_non_numeric_chars(input_str: str) -> str:\n    \"\"\"Extracts all non-numeric characters from a string, preserving their order.\"\"\"\n    non_numeric_chars = []\n    for char in input_str:\n        if not char.isdigit():\n            non_numeric_chars.append(char)\n    return \"\".join(non_numeric_chars)\ndef concatenate_parts(non_numeric: str, numeric: str) -> str:\n    \"\"\"Concatenates the non-numeric part followed by the numeric part.\"\"\"\n    return non_numeric + numeric\ndef move_num(input_string: str) -> str:\n    \"\"\"\n    Moves all numeric characters to the end of the given string.\n    The relative order of both numeric and non-numeric characters is preserved.\n    \"\"\"\n    non_numeric_part = extract_non_numeric_chars(input_string)\n    numeric_part = extract_numeric_chars(input_string)\n    return concatenate_parts(non_numeric_part, numeric_part)"}
{"task_id": "Mbpp/620", "solution": "import itertools\ndef largest_subset(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of numbers where every pair is divisible.\n    A pair (a, b) is divisible if a % b == 0 or b % a == 0.\n    \"\"\"\n\n    def is_divisible(a: int, b: int) -> bool:\n        \"\"\"\n        Checks if two integers have a divisibility relationship (a divides b or b divides a).\n        Handles zero appropriately based on common mathematical conventions.\n        \"\"\"\n        if a == 0 and b == 0:\n            return True\n        if b == 0:\n            return False\n        if a == 0:\n            return True\n        \n        return (a % b == 0) or (b % a == 0)\n\n    def validate_subset(subset: list[int]) -> bool:\n        \"\"\"\n        Validates if all unique pairs in a given subset satisfy the divisibility criteria.\n        A subset with 0 or 1 element is always considered valid.\n        \"\"\"\n        if len(subset) < 2:\n            return True\n        \n        for num1, num2 in itertools.combinations(subset, 2):\n            if not is_divisible(num1, num2):\n                return False\n        return True\n\n    def generate_subsets(numbers_list: list[int], size: int) -> itertools.combinations:\n        \"\"\"\n        Generates all possible subsets of a given size from a list of numbers.\n        \"\"\"\n        return itertools.combinations(numbers_list, size)\n\n    if not numbers:\n        return 0\n\n    # Sorting numbers is not strictly required but can make debugging consistent.\n    sorted_numbers = sorted(numbers)\n\n    # Iterate from the largest possible subset size down to 1.\n    # The first valid subset found will be the largest.\n    for size in range(len(sorted_numbers), 0, -1):\n        for subset_tuple in generate_subsets(sorted_numbers, size):\n            current_subset = list(subset_tuple)\n            if validate_subset(current_subset):\n                return size\n    \n    # This line is reached if the input 'numbers' was empty (handled above)\n    # or if no subset of size >= 1 was found (which is impossible as size 1 subsets are always valid).\n    return 0"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1, list2, size):\n    \"\"\"\n    Calculates the median of two sorted lists of equal size.\n    Merges the two lists and then finds the median from the combined sorted list.\n    \"\"\"\n\n    # Helper function to merge two sorted lists\n    def merge_sorted_lists(l1, l2):\n        merged = []\n        i, j = 0, 0\n        n1, n2 = len(l1), len(l2)\n\n        while i < n1 and j < n2:\n            if l1[i] <= l2[j]:\n                merged.append(l1[i])\n                i += 1\n            else:\n                merged.append(l2[j])\n                j += 1\n\n        # Append remaining elements\n        while i < n1:\n            merged.append(l1[i])\n            i += 1\n        while j < n2:\n            merged.append(l2[j])\n            j += 1\n        return merged\n\n    # Helper function to calculate median from a single sorted list\n    def calculate_median(sorted_list):\n        n = len(sorted_list)\n        if n % 2 == 1:\n            # Odd number of elements, median is the middle element\n            return float(sorted_list[n // 2])\n        else:\n            # Even number of elements, median is the average of the two middle elements\n            mid1 = sorted_list[n // 2 - 1]\n            mid2 = sorted_list[n // 2]\n            return (float(mid1) + float(mid2)) / 2.0\n\n    # Merge the two input lists\n    merged_list = merge_sorted_lists(list1, list2)\n\n    # Calculate and return the median from the merged list\n    return calculate_median(merged_list)"}
{"task_id": "Mbpp/622", "solution": "def merge_sorted_lists(list1: list[int], list2: list[int]) -> list[int]:\n    \"\"\"Merge two sorted lists maintaining order.\"\"\"\n    merged_list = []\n    i, j = 0, 0\n    len1, len2 = len(list1), len(list2)\n\n    while i < len1 and j < len2:\n        if list1[i] < list2[j]:\n            merged_list.append(list1[i])\n            i += 1\n        else:\n            merged_list.append(list2[j])\n            j += 1\n\n    while i < len1:\n        merged_list.append(list1[i])\n        i += 1\n\n    while j < len2:\n        merged_list.append(list2[j])\n        j += 1\n\n    return merged_list\ndef calculate_median(merged_list: list[int]) -> float:\n    \"\"\"Calculate median from a single sorted list.\"\"\"\n    n = len(merged_list)\n    if n % 2 == 1:\n        return float(merged_list[n // 2])\n    else:\n        mid1 = merged_list[n // 2 - 1]\n        mid2 = merged_list[n // 2]\n        return (float(mid1 + mid2)) / 2.0\ndef get_median(list1: list[int], list2: list[int], size: int) -> float:\n    \"\"\"Calculate median from two sorted lists of equal size.\"\"\"\n    merged = merge_sorted_lists(list1, list2)\n    return calculate_median(merged)"}
