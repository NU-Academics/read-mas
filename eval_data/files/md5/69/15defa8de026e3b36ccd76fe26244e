{"task_id": "Mbpp/632", "solution": "def move_zero(input_list):\n    \"\"\"\n    Moves all zeroes to the end of the given list while preserving\n    the relative order of non-zero elements.\n    \"\"\"\n    non_zeros = []\n    zero_count = 0\n\n    for element in input_list:\n        if element == 0:\n            zero_count += 1\n        else:\n            non_zeros.append(element)\n\n    non_zeros.extend([0] * zero_count)\n    return non_zeros"}
{"task_id": "Mbpp/632", "solution": "def move_zero(input_list: list) -> list:\n    \"\"\"Moves all zeroes to the end of the list, preserving the order of non-zero elements.\"\"\"\n    non_zero_elements = []\n    zero_count = 0\n    for element in input_list:\n        if element != 0:\n            non_zero_elements.append(element)\n        else:\n            zero_count += 1\n    non_zero_elements.extend([0] * zero_count)\n    return non_zero_elements"}
{"task_id": "Mbpp/631", "solution": "def replace_spaces(input_string: str) -> str:\n    \"\"\"\n    Replaces whitespaces with underscores and vice versa in the given string.\n    This function performs a bidirectional swap between ' ' and '_'.\n    \"\"\"\n    # Use a temporary character unlikely to be in the string to facilitate swapping\n    temp_char = '\\0'\n\n    # Step 1: Replace all spaces with the temporary character\n    s_temp = input_string.replace(' ', temp_char)\n    \n    # Step 2: Replace all underscores with spaces\n    s_modified = s_temp.replace('_', ' ')\n    \n    # Step 3: Replace the temporary characters with underscores\n    final_string = s_modified.replace(temp_char, '_')\n    \n    return final_string"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers: list, count: int) -> int:\n    \"\"\"\n    Calculates the sum of XOR of all unique pairs of numbers in the given list.\n    Orchestrates input validation, pair generation, and XOR sum calculation.\n    \"\"\"\n    # Validate input parameters, though error handling is constrained.\n    # We proceed assuming valid input as per problem statement and example.\n    _validate_input(numbers, count)\n\n    # Generate all unique pairs from the numbers list.\n    pairs = _generate_pairs(numbers)\n\n    # Calculate the sum of XORs for all generated pairs.\n    total_xor_sum = _calculate_xor_sum(pairs)\n\n    return total_xor_sum\ndef _validate_input(numbers: list, count: int) -> bool:\n    \"\"\"\n    Validates input parameters: checks if the list length matches the count.\n    No exceptions are raised due to problem constraints, simply returns boolean.\n    \"\"\"\n    return len(numbers) == count\ndef _generate_pairs(numbers: list) -> list[tuple[int, int]]:\n    \"\"\"\n    Generates all unique pairs of numbers from the input list.\n    Each pair (a, b) ensures a comes before b in the original list.\n    \"\"\"\n    generated_pairs = []\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            generated_pairs.append((numbers[i], numbers[j]))\n    return generated_pairs\ndef _calculate_xor_sum(pairs: list[tuple[int, int]]) -> int:\n    \"\"\"\n    Calculates the XOR for each pair and sums all the results.\n    \"\"\"\n    total_sum = 0\n    for num1, num2 in pairs:\n        total_sum += (num1 ^ num2)\n    return total_sum"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers: list[int], count: int) -> int:\n    \"\"\"\n    Calculates the sum of XORs of all unique pairs in the given list of numbers.\n    The count parameter is assumed to match the length of the numbers list.\n    \"\"\"\n    total_xor_sum = 0\n    n = len(numbers)\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            total_xor_sum += (numbers[i] ^ numbers[j])\n\n    return total_xor_sum"}
{"task_id": "Mbpp/635", "solution": "def heap_sort(arr: list) -> list:\n    \"\"\"\n    Sorts a list of integers using the heap sort algorithm.\n    Returns a new list with elements sorted in ascending order.\n    \"\"\"\n    n = len(arr)\n    # Create a copy to avoid modifying the original list in place\n    # if the caller expects a new list, fulfilling FR-005 and FR-002.\n    # This design choice aligns with the sequence diagram: 'arr = input_list.copy()'\n    current_arr = list(arr)\n\n    def _swap(arr_internal: list, i: int, j: int) -> None:\n        \"\"\"Swaps two elements in the array.\"\"\"\n        arr_internal[i], arr_internal[j] = arr_internal[j], arr_internal[i]\n\n    def _heapify(arr_internal: list, n_internal: int, i: int) -> None:\n        \"\"\"\n        Maintains the max-heap property for a subtree rooted at index i.\n        n_internal is the current size of the heap.\n        \"\"\"\n        largest = i  # Initialize largest as root\n        left = 2 * i + 1  # left child\n        right = 2 * i + 2  # right child\n\n        # See if left child of root exists and is greater than root\n        if left < n_internal and arr_internal[left] > arr_internal[largest]:\n            largest = left\n\n        # See if right child of root exists and is greater than current largest\n        if right < n_internal and arr_internal[right] > arr_internal[largest]:\n            largest = right\n\n        # Change root, if needed\n        if largest != i:\n            _swap(arr_internal, i, largest)\n            # Heapify the root.\n            _heapify(arr_internal, n_internal, largest)\n\n    def _build_max_heap(arr_internal: list, n_internal: int) -> None:\n        \"\"\"Constructs a max heap from the input array.\"\"\"\n        # Build a maxheap. The last non-leaf node is at index n_internal // 2 - 1.\n        for i in range(n_internal // 2 - 1, -1, -1):\n            _heapify(arr_internal, n_internal, i)\n\n    # Build a maxheap from the array\n    _build_max_heap(current_arr, n)\n\n    # One by one extract elements\n    for i in range(n - 1, 0, -1):\n        # Move current root to end\n        _swap(current_arr, i, 0)\n        # Call _heapify on the reduced heap\n        _heapify(current_arr, i, 0)\n\n    return current_arr"}
{"task_id": "Mbpp/635", "solution": "def heap_sort(input_list: list) -> list:\n    \"\"\"Sorts the given list using the heap sort algorithm.\"\"\"\n\n    def heapify(arr: list, n: int, i: int) -> None:\n        \"\"\"Maintains the max-heap property for a subtree rooted at given index.\"\"\"\n        largest = i\n        left_child = 2 * i + 1\n        right_child = 2 * i + 2\n\n        if left_child < n and arr[left_child] > arr[largest]:\n            largest = left_child\n\n        if right_child < n and arr[right_child] > arr[largest]:\n            largest = right_child\n\n        if largest != i:\n            arr[i], arr[largest] = arr[largest], arr[i]\n            heapify(arr, n, largest)\n\n    def build_max_heap(arr: list) -> None:\n        \"\"\"Builds a max heap from an unsorted array.\"\"\"\n        n = len(arr)\n        for i in range(n // 2 - 1, -1, -1):\n            heapify(arr, n, i)\n\n    def extract_max(arr: list, heap_size: int) -> None:\n        \"\"\"Moves max element to end of current heap and heapifies the remaining part.\"\"\"\n        arr[0], arr[heap_size - 1] = arr[heap_size - 1], arr[0]\n        heapify(arr, heap_size - 1, 0)\n\n    arr = list(input_list)\n    n = len(arr)\n\n    build_max_heap(arr)\n\n    for i in range(n - 1, 0, -1):\n        extract_max(arr, i + 1)\n\n    return arr"}
