{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"\n    Count substrings where the sum of digits equals the substring length.\n    Iterates all substrings and checks if their digit sum matches their length.\n    \"\"\"\n    count = 0\n    n = len(s)\n\n    for i in range(n):\n        current_sum = 0\n        for j in range(i, n):\n            # current_length = j - i + 1\n            current_sum += int(s[j])\n            if current_sum == (j - i + 1):\n                count += 1\n    return count"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts substrings where the sum of digits equals the substring's length.\n    \"\"\"\n    def _generate_substrings(s: str):\n        \"\"\"Generates all possible substrings from the input string.\"\"\"\n        n = len(s)\n        for i in range(n):\n            for j in range(i, n):\n                yield s[i : j + 1]\n\n    def _calculate_digit_sum(substring: str) -> int:\n        \"\"\"Calculates the sum of digits in a given substring.\"\"\"\n        return sum(int(digit) for digit in substring)\n\n    def _is_valid_substring(substring: str) -> bool:\n        \"\"\"Checks if a substring's digit sum equals its length.\"\"\"\n        return _calculate_digit_sum(substring) == len(substring)\n\n    count = 0\n    for substring in _generate_substrings(s):\n        if _is_valid_substring(substring):\n            count += 1\n    return count"}
