{"task_id": "Mbpp/119", "solution": "def search(array: list) -> int:\n    \"\"\"\n    Find the element that appears only once in a sorted array.\n\n    Args:\n        array (list): Sorted list of integers where all elements\n                     except one appear exactly twice\n\n    Returns:\n        int: The element that appears only once\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n\n    while low < high:\n        mid = low + (high - low) // 2\n\n        # Ensure 'mid' is at an even index to consistently compare `array[mid]` with `array[mid+1]`.\n        # If 'mid' is odd, decrement it to point to the start of a potential pair.\n        if mid % 2 == 1:\n            mid -= 1\n\n        # Now 'mid' is guaranteed to be an even index.\n        # Check if array[mid] and array[mid+1] form a pair.\n        if array[mid] == array[mid + 1]:\n            # If they form a pair, it means all elements before `mid` are also paired.\n            # The unique element must be in the right half of the array.\n            # We advance 'low' past this pair.\n            low = mid + 2\n        else:\n            # If they do not form a pair, it means `array[mid]` is either the unique element\n            # or it is part of an unpaired segment, implying the unique element is at or to its left.\n            # We narrow the search to the left half, including 'mid'.\n            high = mid\n\n    # When the loop terminates, 'low' and 'high' will point to the index of the unique element.\n    return array[low]"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(tuple_list):\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples.\n    Iterates through the list, calculates the absolute product for each tuple,\n    and returns the highest absolute product found.\n    \"\"\"\n    max_abs_product = 0.0\n\n    for item_tuple in tuple_list:\n        # Calculate the absolute product of the two numbers in the current tuple.\n        current_abs_product = abs(item_tuple[0] * item_tuple[1])\n        # Update the maximum absolute product if the current one is greater.\n        if current_abs_product > max_abs_product:\n            max_abs_product = current_abs_product\n            \n    return max_abs_product"}
{"task_id": "Mbpp/119", "solution": "def search(array: list) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where all other elements appear in pairs.\n    Uses binary search to efficiently locate the unique element.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n\n    while low < high:\n        mid = (low + high) // 2\n\n        if mid % 2 == 0:  # Mid is an even index\n            # If array[mid] is equal to array[mid+1], it means the pair is formed\n            # correctly, and the unique element must be to the right of this pair.\n            if array[mid] == array[mid + 1]:\n                low = mid + 2\n            # Otherwise, array[mid] is either the unique element or its pair is broken\n            # to its left. So, the unique element is at or to the left of mid.\n            else:\n                high = mid\n        else:  # Mid is an odd index\n            # If array[mid] is equal to array[mid-1], it means the pair is formed\n            # correctly, and the unique element must be to the right of this pair.\n            if array[mid] == array[mid - 1]:\n                low = mid + 1\n            # Otherwise, array[mid] is either the unique element or its pair is broken\n            # to its left. So, the unique element is at or to the left of mid.\n            else:\n                high = mid\n\n    return array[low]"}
{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of all amicable numbers from 1 up to a specified number.\n    \"\"\"\n\n    def calculate_divisor_sum(number: int) -> int:\n        \"\"\"\n        Calculates the sum of proper divisors for a given number.\n        Proper divisors are all positive divisors except the number itself.\n        \"\"\"\n        if number <= 1:\n            return 0\n        s = 1  # 1 is always a divisor\n        for i in range(2, int(number**0.5) + 1):\n            if number % i == 0:\n                s += i\n                if i * i != number:\n                    s += number // i\n        return s\n\n    amicable_set = set()\n    for a in range(1, n + 1):\n        # Calculate sum of proper divisors for 'a'\n        b = calculate_divisor_sum(a)\n\n        # Check if 'b' is a potential amicable partner\n        # It must be within the limit and not equal to 'a'\n        if 1 <= b <= n and b != a:\n            # Calculate sum of proper divisors for 'b'\n            d_b = calculate_divisor_sum(b)\n\n            # If d_b == a, then (a, b) is an amicable pair\n            if d_b == a:\n                amicable_set.add(a)\n                amicable_set.add(b)\n\n    return sum(amicable_set)"}
