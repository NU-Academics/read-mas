{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary_string: str, rotations: int) -> int:\n    \"\"\"\n    Finds the number of odd decimal values obtained by rotating a binary string.\n    Each rotation generates a new binary string, which is converted to decimal and checked for oddness.\n    \"\"\"\n\n    def rotate_left(s: str) -> str:\n        \"\"\"Rotates a string one position to the left.\"\"\"\n        if not s:\n            return s\n        return s[1:] + s[0]\n\n    def binary_to_decimal(binary_str: str) -> int:\n        \"\"\"Converts a binary string to its decimal integer equivalent.\"\"\"\n        return int(binary_str, 2)\n\n    def is_odd(number: int) -> bool:\n        \"\"\"Checks if a given integer is an odd number.\"\"\"\n        return number % 2 != 0\n\n    odd_count = 0\n    current_string = binary_string\n\n    for _ in range(rotations):\n        decimal_value = binary_to_decimal(current_string)\n        if is_odd(decimal_value):\n            odd_count += 1\n        current_string = rotate_left(current_string)\n\n    return odd_count"}
{"task_id": "Mbpp/109", "solution": "class InputValidator:\n    \"\"\"Validates input parameters for the main function.\"\"\"\n    def validate_binary_string(self, binary_string: str) -> bool:\n        \"\"\"Checks if the string is a valid binary string.\"\"\"\n        return bool(binary_string) and all(c in '01' for c in binary_string)\n\n    def validate_rotation_count(self, count: int) -> bool:\n        \"\"\"Checks if the rotation count is non-negative.\"\"\"\n        return count >= 0\n\n    def validate_inputs(self, binary_string: str, count: int) -> bool:\n        \"\"\"Validates both the binary string and the rotation count.\"\"\"\n        return self.validate_binary_string(binary_string) and self.validate_rotation_count(count)\nclass RotationProcessor:\n    \"\"\"Handles binary string rotation operations.\"\"\"\n    def rotate_left(self, binary_string: str, positions: int) -> str:\n        \"\"\"Rotates a binary string to the left by a given number of positions.\"\"\"\n        if not binary_string:\n            return \"\"\n        n = len(binary_string)\n        actual_positions = positions % n\n        return binary_string[actual_positions:] + binary_string[:actual_positions]\n\n    def generate_rotations(self, binary_string: str, count: int) -> list[str]:\n        \"\"\"Generates a list of rotated binary strings up to the specified count.\"\"\"\n        rotations_list = []\n        current_string = binary_string\n        for i in range(min(count, len(binary_string))): # Generate unique rotations up to string length\n            rotations_list.append(current_string)\n            current_string = self.rotate_left(current_string, 1)\n        \n        # If count > len(binary_string), the rotations will repeat.\n        # The problem statement's example '011001', 6 implies generating 6 rotations\n        # even if the string length is 6. So we need to ensure 'count' rotations are returned.\n        # This implies that for count > len(binary_string), rotations will repeat.\n        # For '011001', len is 6, count is 6. min(count, len(binary_string)) gives 6,\n        # so it correctly generates 6 distinct rotations.\n        \n        # The prompt test `odd_Equivalent(\"011001\", 6) == 3` expects exactly 6 rotations,\n        # which means generating rotations for `i` from 0 up to `count-1`.\n        # The current implementation generates `len(binary_string)` unique rotations.\n        # If `count` is larger than `len(binary_string)`, it should wrap around.\n        # Example: \"01\", 3 rotations -> [\"01\", \"10\", \"01\"]\n        \n        # Re-evaluating based on typical \"rotate N times\" interpretation:\n        if not binary_string:\n            return []\n        \n        all_rotations = []\n        current_rotation = binary_string\n        for _ in range(count):\n            all_rotations.append(current_rotation)\n            current_rotation = self.rotate_left(current_rotation, 1)\n        return all_rotations\nclass DecimalConverter:\n    \"\"\"Converts binary strings to decimal and determines odd status.\"\"\"\n    def binary_to_decimal(self, binary_string: str) -> int:\n        \"\"\"Converts a binary string to its decimal integer equivalent.\"\"\"\n        if not binary_string:\n            return 0\n        return int(binary_string, 2)\n\n    def is_odd(self, decimal_value: int) -> bool:\n        \"\"\"Checks if a decimal value is odd.\"\"\"\n        return decimal_value % 2 != 0\n\n    def process_rotations(self, rotations: list[str]) -> list[int]:\n        \"\"\"Converts a list of binary strings to a list of their decimal equivalents.\"\"\"\n        return [self.binary_to_decimal(rot_str) for rot_str in rotations]\nclass OddCounter:\n    \"\"\"Counts odd values from a list of decimal integers.\"\"\"\n    def count_odd_values(self, decimal_values: list[int]) -> int:\n        \"\"\"Counts how many numbers in a list are odd.\"\"\"\n        converter = DecimalConverter() # Use an instance to call is_odd\n        return sum(1 for val in decimal_values if converter.is_odd(val))\ndef odd_Equivalent(binary_string: str, rotations: int) -> int:\n    \"\"\"\n    Finds the number of numbers with an odd value when rotating a binary string\n    the given number of times.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.validate_inputs(binary_string, rotations):\n        # The design context doesn't specify how to handle invalid inputs gracefully\n        # if not raising exceptions. Returning 0 or an error state might be an option.\n        # Given the problem's focus and the assert, we'll assume valid inputs or\n        # default to 0 for simplicity if inputs are invalid.\n        return 0 \n\n    rotation_processor = RotationProcessor()\n    decimal_converter = DecimalConverter()\n    odd_counter = OddCounter()\n\n    rotated_strings = rotation_processor.generate_rotations(binary_string, rotations)\n    decimal_values = decimal_converter.process_rotations(rotated_strings)\n    \n    return odd_counter.count_odd_values(decimal_values)"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_lists: list) -> list:\n    \"\"\"\n    Finds elements common to all sublists within a given list of lists.\n    Utilizes set intersection for efficient processing.\n    \"\"\"\n    if not nested_lists:\n        return []\n\n    # Initialize common_elements with the set of the first sublist\n    common_elements = set(nested_lists[0])\n\n    # Iterate through the rest of the sublists and perform intersection\n    for sublist in nested_lists[1:]:\n        common_elements.intersection_update(set(sublist))\n\n    return list(common_elements)"}
{"task_id": "Mbpp/113", "solution": "def check_integer(input_string: str) -> bool:\n    \"\"\"\n    Check if a string represents a valid integer.\n\n    Args:\n        input_string (str): The string to validate\n\n    Returns:\n        bool: True if string represents valid integer, False otherwise\n    \"\"\"\n    s = input_string.strip()\n\n    if not s:\n        return False\n\n    start_index = 0\n    if s[0] == '-' or s[0] == '+':\n        start_index = 1\n\n    if len(s) == start_index:  # String is just a sign or empty after sign removal\n        return False\n\n    for i in range(start_index, len(s)):\n        if not '0' <= s[i] <= '9':  # Check if character is a digit\n            return False\n\n    return True"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_lists):\n    \"\"\"\n    Finds common elements across all sublists in a list of lists.\n    Utilizes set operations for efficient intersection calculation.\n    \"\"\"\n\n    def _find_intersection(lists):\n        \"\"\"Calculates the intersection of all sets derived from the input lists.\"\"\"\n        if not lists:\n            return set()\n        \n        common_elements = set(lists[0])\n        for sublist in lists[1:]:\n            common_elements.intersection_update(set(sublist))\n        return common_elements\n\n    def _convert_to_list(result_set):\n        \"\"\"Converts a set of elements into a list.\"\"\"\n        return list(result_set)\n\n    common_set = _find_intersection(nested_lists)\n    result_list = _convert_to_list(common_set)\n    return result_list"}
{"task_id": "Mbpp/116", "solution": "def tuple_to_int(input_tuple: tuple) -> int:\n    \"\"\"\n    Converts a tuple of positive integers into a single integer by concatenating their digits.\n    Returns 0 for an empty tuple.\n    \"\"\"\n    if not input_tuple:\n        return 0\n\n    # Convert each integer to a string and join them\n    concatenated_str = \"\".join(str(num) for num in input_tuple)\n    \n    # Convert the resulting string back to an integer\n    return int(concatenated_str)"}
{"task_id": "Mbpp/113", "solution": "def check_integer(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string represents an integer.\n    Handles positive, negative integers, and zero; rejects empty, whitespace-only, and non-numeric strings.\n    \"\"\"\n\n    def _is_digit_char(char: str) -> bool:\n        \"\"\"Helper to check if a single character is a numeric digit.\"\"\"\n        return '0' <= char <= '9'\n\n    # The design context defines _is_whitespace_char but implies any non-digit/non-sign is invalid.\n    # Therefore, explicit _is_whitespace_char is not strictly needed if _is_digit_char\n    # and sign checks cover all valid characters and any other character makes it invalid.\n\n    n = len(input_string)\n\n    if n == 0:\n        return False\n\n    start_index = 0\n    if input_string[0] == '-' or input_string[0] == '+':\n        start_index = 1\n\n    # If the string contains only a sign (e.g., \"+\", \"-\")\n    if start_index == n:\n        return False\n\n    # Check all characters from start_index onwards\n    for i in range(start_index, n):\n        if not _is_digit_char(input_string[i]):\n            return False\n\n    return True"}
{"task_id": "Mbpp/116", "solution": "def tuple_to_int(input_tuple: tuple) -> int:\n    \"\"\"\n    Converts a tuple of positive integers into a single integer by concatenating their digits.\n    Returns 0 for an empty input tuple.\n    \"\"\"\n    if not input_tuple:\n        return 0\n\n    string_parts = [str(num) for num in input_tuple]\n    concatenated_string = \"\".join(string_parts)\n    return int(concatenated_string)"}
