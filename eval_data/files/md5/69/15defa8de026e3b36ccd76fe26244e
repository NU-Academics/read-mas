{"task_id": "Mbpp/462", "solution": "def combinations_list(input_list):\n    \"\"\"\n    Generates all possible combinations (subsets) of elements from a given list\n    in binary counting order, including the empty set.\n    \"\"\"\n    n = len(input_list)\n    total_combinations = 1 << n  # This is 2^n\n\n    result = []\n    for i in range(total_combinations):\n        current_combination = []\n        for j in range(n):\n            # Check if the j-th bit of i is set\n            if (i >> j) & 1:\n                # Prepend the element to maintain the specific order shown in the example\n                current_combination.insert(0, input_list[j])\n        result.append(current_combination)\n    return result"}
{"task_id": "Mbpp/459", "solution": "def remove_uppercase(input_string: str) -> str:\n    \"\"\"\n    Remove all contiguous uppercase substrings from the input string.\n    This function identifies and removes all sequences of uppercase letters.\n    \"\"\"\n\n    def _identify_uppercase_substrings(s: str) -> list:\n        \"\"\"\n        Identify positions of uppercase character sequences.\n        Returns a list of (start_pos, end_pos) tuples.\n        \"\"\"\n        uppercase_positions = []\n        in_uppercase_sequence = False\n        start_index = -1\n\n        for i, char in enumerate(s):\n            if char.isupper():\n                if not in_uppercase_sequence:\n                    start_index = i\n                    in_uppercase_sequence = True\n            else:\n                if in_uppercase_sequence:\n                    uppercase_positions.append((start_index, i))\n                    in_uppercase_sequence = False\n        \n        # If an uppercase sequence ends at the very end of the string\n        if in_uppercase_sequence:\n            uppercase_positions.append((start_index, len(s)))\n            \n        return uppercase_positions\n\n    def _build_result_string(original_string: str, uppercase_positions: list) -> str:\n        \"\"\"\n        Build the result string by excluding characters within identified uppercase positions.\n        \"\"\"\n        result_chars = []\n        current_index = 0\n\n        for start, end in uppercase_positions:\n            # Append characters from the original string up to the start of the current uppercase substring\n            result_chars.extend(original_string[current_index:start])\n            # Advance current_index past the excluded uppercase substring\n            current_index = end\n        \n        # Append any remaining characters after the last uppercase substring\n        result_chars.extend(original_string[current_index:])\n        \n        return \"\".join(result_chars)\n\n    if not input_string:\n        return \"\"\n\n    uppercase_ranges = _identify_uppercase_substrings(input_string)\n    \n    # If no uppercase substrings are found, return the original string\n    if not uppercase_ranges:\n        return input_string\n        \n    return _build_result_string(input_string, uppercase_ranges)"}
{"task_id": "Mbpp/462", "solution": "def combinations_list(input_list: list) -> list:\n    \"\"\"\n    Generate all possible combinations of elements in the input list.\n    Each combination is formed by iterating through bits, prepending elements to maintain the specific order.\n    \"\"\"\n    n = len(input_list)\n    result = []\n\n    # Iterate from 0 to 2^n - 1 to generate all possible bitmasks\n    for i in range(1 << n):\n        current_combination = []\n        # For each bitmask, check which elements to include in the current combination\n        for j in range(n):\n            # If the j-th bit of i is set, include the j-th element from input_list\n            if (i >> j) & 1:\n                # Prepend the element to current_combination to achieve the desired output order\n                current_combination.insert(0, input_list[j])\n        result.append(current_combination)\n\n    return result"}
