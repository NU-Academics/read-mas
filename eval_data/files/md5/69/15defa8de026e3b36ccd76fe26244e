{"task_id": "Mbpp/463", "solution": "def max_subarray_product(arr):\n    \"\"\"\n    Find the maximum product of any contiguous subarray.\n\n    Args:\n        arr (list): Input array of numbers\n\n    Returns:\n        int: Maximum product value\n    \"\"\"\n    if not arr:\n        return 0\n\n    max_so_far = arr[0]\n    current_max_prod = arr[0]\n    current_min_prod = arr[0]\n\n    for num in arr[1:]:\n        # If the current number is negative, swapping current_max_prod and current_min_prod\n        # ensures that we correctly calculate the new max and min products.\n        # A small negative multiplied by a negative number can become a large positive.\n        if num < 0:\n            current_max_prod, current_min_prod = current_min_prod, current_max_prod\n\n        # Update current_max_prod and current_min_prod considering the current number.\n        # The new max/min product can either be the number itself or the product of the number\n        # with the previous max/min product ending at the current position.\n        current_max_prod = max(num, current_max_prod * num)\n        current_min_prod = min(num, current_min_prod * num)\n\n        # Update the overall maximum product found across all subarrays.\n        max_so_far = max(max_so_far, current_max_prod)\n\n    return max_so_far"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(arr: list[int]) -> int:\n    \"\"\"\n    Finds the maximum product of a contiguous subarray in the given array.\n    This implementation uses a modified Kadane's algorithm to efficiently\n    handle positive numbers, negative numbers, and zero values.\n    \"\"\"\n    if not arr:\n        return 0  # An empty array has a maximum product of 0.\n\n    # Initialize max_so_far (the global maximum product found)\n    # current_max (the maximum product ending at the current position)\n    # current_min (the minimum product ending at the current position,\n    #              needed because a negative number multiplied by another\n    #              negative can yield a large positive product)\n    max_so_far = arr[0]\n    current_max = arr[0]\n    current_min = arr[0]\n\n    for i in range(1, len(arr)):\n        num = arr[i]\n\n        # Store the current_max before it's updated, as it's needed for\n        # calculating the new current_min.\n        temp_current_max = current_max\n\n        # The new current_max can be:\n        # 1. The number itself (starting a new subarray)\n        # 2. The product of num with the previous current_max\n        # 3. The product of num with the previous current_min (if num is negative)\n        current_max = max(num, temp_current_max * num, current_min * num)\n\n        # Similarly, the new current_min can be:\n        # 1. The number itself\n        # 2. The product of num with the previous current_max\n        # 3. The product of num with the previous current_min\n        current_min = min(num, temp_current_max * num, current_min * num)\n\n        # Update the overall maximum product found so far\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Calculates the pairwise addition of neighboring elements in the given tuple.\n    Returns a new tuple containing these sums.\n    \"\"\"\n    if len(input_tuple) < 2:\n        return ()\n\n    result_list = []\n    for i in range(len(input_tuple) - 1):\n        result_list.append(input_tuple[i] + input_tuple[i+1])\n    return tuple(result_list)"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(array, n):\n    \"\"\"\n    Calculates the product of array elements modulo n, preventing overflow.\n    \"\"\"\n    product = 1\n    for element in array:\n        product = (product * element) % n\n    return product"}
