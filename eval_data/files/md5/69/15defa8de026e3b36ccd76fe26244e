{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Removes uneven elements from the nested mixed tuple, preserving structure and even integers.\n    \"\"\"\n\n    def _is_even(number: int) -> bool:\n        \"\"\"Determines if an integer is even.\"\"\"\n        return number % 2 == 0\n\n    def _process_element(element):\n        \"\"\"Processes individual elements, handling recursion for nested tuples.\"\"\"\n        if isinstance(element, tuple):\n            return extract_even(element)\n        elif isinstance(element, int):\n            if _is_even(element):\n                return element\n            else:\n                return None\n        else:\n            return element\n\n    filtered_elements = []\n    for item in input_tuple:\n        processed_item = _process_element(item)\n        if processed_item is not None:\n            filtered_elements.append(processed_item)\n\n    return tuple(filtered_elements)"}
{"task_id": "Mbpp/581", "solution": "import math\ndef surface_Area(baseEdge, height):\n    \"\"\"\n    Calculates the surface area of a square pyramid given its base edge and slant height.\n    Note: The 'height' parameter is interpreted as the slant height to satisfy the assertion surface_Area(3,4) == 33.\n    \"\"\"\n    # Calculate the area of the square base\n    base_area = baseEdge * baseEdge\n\n    # Calculate the lateral surface area (sum of the areas of the 4 triangular faces)\n    # The area of one triangular face is 0.5 * baseEdge * slant_height.\n    # Since the 'height' parameter is interpreted as the slant height, we use it directly.\n    lateral_area = 4 * (0.5 * baseEdge * height)\n    \n    # The total surface area is the sum of the base area and the lateral surface area\n    total_surface_area = base_area + lateral_area\n    \n    return total_surface_area"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"\n    Computes the nth Catalan number using the formula C_n = (2n)! / ((n+1)! * n!).\n    An inline factorial helper is used for the calculation.\n    \"\"\"\n    def factorial(k: int) -> int:\n        # Helper function to compute the factorial of a non-negative integer.\n        # This is used for calculating the binomial coefficients within the Catalan formula.\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    # The nth Catalan number C_n is given by the formula: C_n = (2n)! / ((n+1)! * n!)\n    return factorial(2 * n) // (factorial(n + 1) * factorial(n))"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Recursively removes odd integers from a nested tuple, preserving its structure.\n    Non-integer, non-tuple elements are preserved as is.\n    \"\"\"\n\n    def is_integer(element: any) -> bool:\n        \"\"\"Checks if an element is an integer.\"\"\"\n        return isinstance(element, int)\n\n    def is_tuple(element: any) -> bool:\n        \"\"\"Checks if an element is a tuple.\"\"\"\n        return isinstance(element, tuple)\n\n    def _is_even(number: int) -> bool:\n        \"\"\"Determines if a given integer is even.\"\"\"\n        return number % 2 == 0\n\n    def _process_element(element: any) -> any:\n        \"\"\"Processes a single element, applying filtering or recursion.\"\"\"\n        if is_tuple(element):\n            return extract_even(element)\n        elif is_integer(element):\n            return element if _is_even(element) else None\n        else:\n            return element  # Preserve elements that are not integers or tuples\n\n    result = []\n    for item in input_tuple:\n        processed_item = _process_element(item)\n        if processed_item is not None:\n            result.append(processed_item)\n\n    return tuple(result)"}
