{"task_id": "Mbpp/137", "solution": "def _count_zeros(array: list[int]) -> int:\n    \"\"\"Count number of zero values in array.\"\"\"\n    count = 0\n    for x in array:\n        if x == 0:\n            count += 1\n    return count\ndef _count_non_zeros(array: list[int]) -> int:\n    \"\"\"Count number of non-zero values in array.\"\"\"\n    count = 0\n    for x in array:\n        if x != 0:\n            count += 1\n    return count\ndef _calculate_ratio(zero_count: int, non_zero_count: int) -> float:\n    \"\"\"Calculate ratio of zero_count to non_zero_count.\"\"\"\n    if non_zero_count == 0:\n        return 0.0\n    return float(zero_count) / non_zero_count\ndef zero_count(array: list[int]) -> float:\n    \"\"\"Calculate ratio of zero values to non-zero values in integer array.\"\"\"\n    zeros = _count_zeros(array)\n    non_zeros = _count_non_zeros(array)\n    return _calculate_ratio(zeros, non_zeros)"}
