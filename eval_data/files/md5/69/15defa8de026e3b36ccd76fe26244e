{"task_id": "Mbpp/555", "solution": "def sum_of_numbers(n: int) -> int:\n    \"\"\"Calculates the sum of the first n natural numbers.\"\"\"\n    return n * (n + 1) // 2\ndef sum_of_cubes(n: int) -> int:\n    \"\"\"Calculates the sum of cubes of the first n natural numbers.\"\"\"\n    # The sum of cubes is the square of the sum of numbers.\n    sum_n = sum_of_numbers(n)\n    return sum_n ** 2\ndef difference(n: int) -> int:\n    \"\"\"\n    Finds the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    sum_cubes = sum_of_cubes(n)\n    sum_nums = sum_of_numbers(n)\n    return sum_cubes - sum_nums"}
{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    sum_of_naturals = n * (n + 1) // 2\n    sum_of_cubes = sum_of_naturals * sum_of_naturals\n    return sum_of_cubes - sum_of_naturals"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(array, size):\n    \"\"\"\n    Counts the number of pairs in an array whose XOR value is odd.\n    A pair (a, b) has an odd XOR value if one number is odd and the other is even.\n    \"\"\"\n    odd_xor_pair_count = 0\n\n    # Iterate through all unique pairs (num1, num2) in the array.\n    for i in range(size):\n        for j in range(i + 1, size):\n            num1 = array[i]\n            num2 = array[j]\n\n            # Calculate the XOR sum of the pair.\n            xor_result = num1 ^ num2\n\n            # Check if the XOR result is odd.\n            # An integer is odd if its least significant bit is 1.\n            if (xor_result % 2) != 0:\n                odd_xor_pair_count += 1\n\n    return odd_xor_pair_count"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(array: list[int], size: int) -> int:\n    \"\"\"\n    Counts the number of pairs in an array whose XOR value is odd.\n    An XOR operation results in an odd value if and only if one operand is odd and the other is even.\n    \"\"\"\n    odd_count = 0\n    even_count = 0\n\n    for num in array:\n        if num % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # The number of pairs with an odd XOR sum is the product of odd_count and even_count.\n    return odd_count * even_count"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string: str) -> str:\n    \"\"\"\n    Toggle the case of all alphabetic characters in the input string.\n    \"\"\"\n    toggled_chars = []\n    for char in input_string:\n        if char.isalpha():\n            if char.islower():\n                toggled_chars.append(char.upper())\n            else:  # char is uppercase\n                toggled_chars.append(char.lower())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string):\n    \"\"\"\n    Toggles the case of all alphabetic characters in a string, preserving non-alphabetic characters.\n    \"\"\"\n    toggled_chars = []\n    for char in input_string:\n        if char.isupper():\n            toggled_chars.append(char.lower())\n        elif char.islower():\n            toggled_chars.append(char.upper())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of per-digit absolute differences between two integers.\n    Handles integers of different lengths by treating missing digits as zero.\n    \"\"\"\n\n    def _extract_digits(number: int) -> list[int]:\n        \"\"\"\n        Extracts individual digits from an integer, from least to most significant.\n        \"\"\"\n        if number == 0:\n            return [0]\n        \n        # Take absolute value to handle potential negative inputs as digit values\n        number = abs(number)\n        digits = []\n        while number > 0:\n            digits.append(number % 10)\n            number //= 10\n        return digits\n\n    def _align_digit_lists(digits1: list[int], digits2: list[int]) -> tuple:\n        \"\"\"\n        Aligns digit lists of different lengths by zero-padding the shorter list.\n        \"\"\"\n        len1 = len(digits1)\n        len2 = len(digits2)\n        \n        if len1 > len2:\n            digits2.extend([0] * (len1 - len2))\n        elif len2 > len1:\n            digits1.extend([0] * (len2 - len1))\n            \n        return digits1, digits2\n\n    def _calculate_differences(digits1: list[int], digits2: list[int]) -> list[int]:\n        \"\"\"\n        Computes absolute differences between corresponding digit positions of two aligned lists.\n        \"\"\"\n        differences = []\n        for i in range(len(digits1)):\n            differences.append(abs(digits1[i] - digits2[i]))\n        return differences\n\n    # Extract digits for both numbers\n    digits1 = _extract_digits(num1)\n    digits2 = _extract_digits(num2)\n\n    # Align the digit lists by padding with zeros if they have different lengths\n    aligned_digits1, aligned_digits2 = _align_digit_lists(digits1, digits2)\n\n    # Calculate absolute differences for each corresponding digit\n    differences = _calculate_differences(aligned_digits1, aligned_digits2)\n    \n    # Sum all the calculated differences\n    return sum(differences)"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of per-digit absolute differences between two integers.\n    Missing digits are treated as zero.\n    \"\"\"\n    def _extract_digits(number: int) -> list[int]:\n        \"\"\"Converts an integer to a list of its digits, least significant first.\"\"\"\n        # Ensure positive number for digit extraction\n        number = abs(number)\n        if number == 0:\n            return [0]\n        return [int(d) for d in str(number)[::-1]]\n\n    def _calculate_differences(digits1: list[int], digits2: list[int]) -> int:\n        \"\"\"Calculates the sum of absolute differences between corresponding digits.\"\"\"\n        total_sum = 0\n        max_len = max(len(digits1), len(digits2))\n\n        for i in range(max_len):\n            digit1 = digits1[i] if i < len(digits1) else 0\n            digit2 = digits2[i] if i < len(digits2) else 0\n            total_sum += abs(digit1 - digit2)\n        return total_sum\n\n    abs_num1 = abs(num1)\n    abs_num2 = abs(num2)\n\n    digits1 = _extract_digits(abs_num1)\n    digits2 = _extract_digits(abs_num2)\n\n    return _calculate_differences(digits1, digits2)"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr: list[int], length: int) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist in the given list using Kadane's algorithm.\n    Assumes the input list 'arr' is non-empty and its length matches the 'length' parameter.\n    \"\"\"\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, length):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr: list[int], n: int) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist in the given list using Kadane's algorithm.\n    This implementation handles empty lists and lists with all negative numbers correctly.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, n):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/560", "solution": "def union_elements(tuple1, tuple2):\n    \"\"\"\n    Finds the union of elements from two tuples, returning them in sorted order.\n    Duplicates are automatically removed during the union operation.\n    \"\"\"\n    combined_elements = tuple1 + tuple2\n    unique_elements = set(combined_elements)\n    sorted_unique_elements = sorted(list(unique_elements))\n    return tuple(sorted_unique_elements)"}
