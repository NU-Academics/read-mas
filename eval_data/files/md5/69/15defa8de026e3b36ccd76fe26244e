{"task_id": "Mbpp/772", "solution": "def remove_length(input_string: str, k: int) -> str:\n    \"\"\"Removes all words of a specific length from the given string.\n\n    This function parses the string, filters words by length, and reconstructs the string.\n    \"\"\"\n\n    def split_words(text: str) -> list[str]:\n        \"\"\"Splits an input string into a list of words.\"\"\"\n        return text.split()\n\n    def filter_by_length(words: list[str], length_to_remove: int) -> list[str]:\n        \"\"\"Filters a list of words, removing those that match the specified length.\"\"\"\n        return [word for word in words if len(word) != length_to_remove]\n\n    def join_words(words: list[str]) -> str:\n        \"\"\"Joins a list of words into a single string with single-space separation.\"\"\"\n        return \" \".join(words)\n\n    words = split_words(input_string)\n    filtered_words = filter_by_length(words, k)\n    result_string = join_words(filtered_words)\n    \n    return result_string"}
{"task_id": "Mbpp/775", "solution": "def odd_position(input_list: list) -> bool:\n    \"\"\"\n    Checks if every element at an odd index position in the given list is an odd number.\n    Returns True if all such elements are odd, False otherwise.\n    \"\"\"\n    for i in range(len(input_list)):\n        # Check if the current index is odd\n        if i % 2 == 1:\n            # If the index is odd, check if the element at that index is also odd\n            if input_list[i] % 2 == 0:\n                # If an odd index contains an even number, the condition is not met\n                return False\n    # If the loop completes, all odd indices contained odd numbers\n    return True"}
{"task_id": "Mbpp/777", "solution": "def find_sum(input_list: list) -> int:\n    \"\"\"\n    Calculates the sum of non-repeated elements in the given list.\n    An element is considered non-repeated if it appears exactly once.\n    \"\"\"\n    if not input_list:\n        return 0\n\n    # Element Counter: Count frequency of each element\n    element_counts = {}\n    for element in input_list:\n        element_counts[element] = element_counts.get(element, 0) + 1\n\n    # Non-Repeated Filter and Sum Calculator: Identify and sum elements with frequency 1\n    total_sum = 0\n    for element, count in element_counts.items():\n        if count == 1:\n            total_sum += element\n\n    return total_sum"}
