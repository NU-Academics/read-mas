{"task_id": "Mbpp/763", "solution": "def find_min_diff(array, length):\n    \"\"\"\n    Calculate minimum absolute difference between any two distinct elements.\n    It sorts the array and then finds the minimum difference between adjacent elements.\n    \"\"\"\n    sorted_array = sorted(array)\n    min_diff = float('inf')\n\n    for i in range(1, length):\n        min_diff = min(min_diff, sorted_array[i] - sorted_array[i-1])\n\n    return min_diff"}
{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    \"\"\"Returns the nth polite number.\n    This function finds polite numbers by checking if a number is not a power of two\n    and can be expressed as a sum of two or more consecutive positive integers.\"\"\"\n\n    # Helper function: Checks if a number is a power of 2.\n    def is_power_of_two(num: int) -> bool:\n        \"\"\"Checks if number is power of 2.\"\"\"\n        return num > 0 and (num & (num - 1)) == 0\n\n    # Helper function: Finds consecutive integers that sum to num.\n    def find_consecutive_sum(num: int) -> list[int]:\n        \"\"\"Finds consecutive integers that sum to num.\"\"\"\n        # Iterate for the number of terms 'k', starting from 2\n        # The sum of k consecutive positive integers starting from 'a' is:\n        # num = a + (a+1) + ... + (a+k-1) = k*a + k*(k-1)/2\n        # We solve for 'a': k*a = num - k*(k-1)/2\n        # For 'a' to be a positive integer (a >= 1), the right side must be\n        # positive and divisible by 'k'.\n        \n        # The maximum 'k' can be estimated from k*(k+1)/2 <= num,\n        # which implies k is approximately sqrt(2*num).\n        for k in range(2, int((2 * num)**0.5) + 2):\n            numerator = num - k * (k - 1) // 2\n            \n            # Check if numerator is positive and divisible by k\n            if numerator > 0 and numerator % k == 0:\n                a = numerator // k\n                # 'a' must be a positive integer (>= 1) as per definition\n                if a >= 1:\n                    # Found a valid sequence. Return it.\n                    return list(range(a, a + k))\n        return None # No such sequence found\n\n    # Helper function: Checks if a number can be expressed as sum of consecutive integers.\n    def is_polite_number(num: int) -> bool:\n        \"\"\"Checks if a number can be expressed as a sum of two or more consecutive positive integers.\"\"\"\n        # This function directly uses find_consecutive_sum to verify the property.\n        return find_consecutive_sum(num) is not None\n\n    polite_count = 0\n    candidate = 1 # Start checking numbers from 1\n\n    while True:\n        # A polite number must satisfy two conditions:\n        # 1. It must NOT be a power of 2.\n        # 2. It must be expressible as the sum of two or more consecutive positive integers.\n        if not is_power_of_two(candidate):\n            if is_polite_number(candidate):\n                polite_count += 1\n                if polite_count == n:\n                    return candidate\n        candidate += 1"}
{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number.\n    A polite number is a positive integer that is not a power of 2.\n    \"\"\"\n    polite_count = 0\n    current_num = 1\n\n    while True:\n        # A number is polite if and only if it is not a power of 2.\n        # A number 'x' is a power of 2 if x > 0 and (x & (x - 1)) == 0.\n        # Since current_num starts at 1 and increments, it's always > 0.\n        if (current_num & (current_num - 1)) != 0:  # current_num is not a power of 2\n            polite_count += 1\n            if polite_count == n:\n                return current_num\n        current_num += 1"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list, target_sum: int) -> int:\n    \"\"\"\n    Counts pairs of numbers whose sum equals target_sum, treating duplicates by index.\n    Iterates through all unique pairs (i, j) where i < j and checks their sum.\n    \"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n    return count"}
{"task_id": "Mbpp/766", "solution": "from typing import List, Tuple\ndef pair_wise(input_list: List) -> List[Tuple]:\n    \"\"\"\n    Return a list of all pairs of consecutive items in a given list.\n    Handles lists with fewer than two elements by returning an empty list.\n    \"\"\"\n    result_pairs = []\n    # Iterate from the first element up to the second-to-last element\n    for i in range(len(input_list) - 1):\n        result_pairs.append((input_list[i], input_list[i+1]))\n    return result_pairs"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers, sum_):\n    \"\"\"\n    Counts the number of pairs in a list whose sum equals the target sum.\n    Each pair from different positions is considered distinct.\n    \"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == sum_:\n                count += 1\n    return count"}
{"task_id": "Mbpp/766", "solution": "from typing import List, Tuple\ndef pair_wise(input_list: List) -> List[Tuple]:\n    \"\"\"\n    Returns a list of all pairs of consecutive items in the given list.\n    Handles inputs with fewer than two items by returning an empty list.\n    \"\"\"\n    if len(input_list) < 2:\n        return []\n\n    result = []\n    for i in range(len(input_list) - 1):\n        result.append((input_list[i], input_list[i+1]))\n    return result"}
