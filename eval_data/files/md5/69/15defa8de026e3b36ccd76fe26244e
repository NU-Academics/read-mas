{"task_id": "Mbpp/126", "solution": "def sum(num1, num2):\n    \"\"\"\n    Calculates the sum of common divisors of two given numbers.\n    \"\"\"\n    def calculate_divisors(number):\n        \"\"\"\n        Finds all positive divisors for a given number.\n        \"\"\"\n        divs = []\n        for i in range(1, number + 1):\n            if number % i == 0:\n                divs.append(i)\n        return divs\n\n    def find_common_divisors(divisors1, divisors2):\n        \"\"\"\n        Identifies common divisors from two lists of divisors.\n        \"\"\"\n        set1 = set(divisors1)\n        set2 = set(divisors2)\n        return list(set1.intersection(set2))\n\n    def sum_divisors(divisors):\n        \"\"\"\n        Sums all numbers in a given list of divisors.\n        \"\"\"\n        return sum(divisors)\n\n    divs1 = calculate_divisors(num1)\n    divs2 = calculate_divisors(num2)\n    common_divs = find_common_divisors(divs1, divs2)\n    return sum_divisors(common_divs)"}
{"task_id": "Mbpp/125", "solution": "def find_length(binary_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s in any substring.\n    This is solved by converting '0' to 1 and '1' to -1, then applying Kadane's algorithm.\n    \"\"\"\n    max_difference = 0\n    current_difference = 0\n\n    for char in binary_string:\n        if char == '0':\n            current_difference += 1\n        else:  # char == '1'\n            current_difference -= 1\n        \n        # If the current sum of differences becomes negative, reset it to 0.\n        # A negative prefix would only reduce the sum of subsequent positive differences.\n        if current_difference < 0:\n            current_difference = 0\n        \n        # Update the maximum difference found across all substrings.\n        max_difference = max(max_difference, current_difference)\n            \n    return max_difference"}
{"task_id": "Mbpp/128", "solution": "def long_words(n: int, text: str) -> list[str]:\n    \"\"\"\n    Finds words from a given text string that are longer than n characters.\n    Splits the text by spaces and filters words based on length.\n    \"\"\"\n    words = text.split(' ')\n    long_filtered_words = [word for word in words if len(word) > n]\n    return long_filtered_words"}
{"task_id": "Mbpp/128", "solution": "def long_words(n: int, text: str) -> list[str]:\n    \"\"\"\n    Finds words longer than n characters from a given text string.\n    Splits the text into words, then filters them by length.\n    \"\"\"\n    def _split_text(text_to_split: str) -> list[str]:\n        \"\"\"Splits the input text into individual words.\"\"\"\n        return text_to_split.split()\n\n    def _filter_by_length(words_list: list[str], threshold: int) -> list[str]:\n        \"\"\"Filters a list of words, returning those longer than the threshold.\"\"\"\n        return [word for word in words_list if len(word) > threshold]\n\n    words = _split_text(text)\n    long_filtered_words = _filter_by_length(words, n)\n    return long_filtered_words"}
{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix: list[list[int]]) -> bool:\n    \"\"\"\n    Determines if a given two-dimensional matrix is a magic square.\n    A magic square has all its row, column, and main diagonal sums equal.\n    \"\"\"\n\n    def _is_square(m: list[list[int]]) -> bool:\n        \"\"\"Checks if the matrix is square and non-empty.\"\"\"\n        if not m:\n            return False\n        n = len(m)\n        for row in m:\n            if len(row) != n:\n                return False\n        return True\n\n    def _calculate_row_sums(m: list[list[int]]) -> list[int]:\n        \"\"\"Calculates the sum of each row in the matrix.\"\"\"\n        return [sum(row) for row in m]\n\n    def _calculate_column_sums(m: list[list[int]]) -> list[int]:\n        \"\"\"Calculates the sum of each column in the matrix.\"\"\"\n        n = len(m)\n        col_sums = [0] * n\n        for r_idx in range(n):\n            for c_idx in range(n):\n                col_sums[c_idx] += m[r_idx][c_idx]\n        return col_sums\n\n    def _calculate_main_diagonal_sum(m: list[list[int]]) -> int:\n        \"\"\"Calculates the sum of the main diagonal (top-left to bottom-right).\"\"\"\n        n = len(m)\n        main_diag_sum = 0\n        for i in range(n):\n            main_diag_sum += m[i][i]\n        return main_diag_sum\n\n    def _calculate_anti_diagonal_sum(m: list[list[int]]) -> int:\n        \"\"\"Calculates the sum of the anti-diagonal (top-right to bottom-left).\"\"\"\n        n = len(m)\n        anti_diag_sum = 0\n        for i in range(n):\n            anti_diag_sum += m[i][n - 1 - i]\n        return anti_diag_sum\n\n    def _compare_all_sums(row_sums: list[int], col_sums: list[int], main_diag: int, anti_diag: int) -> bool:\n        \"\"\"Compares all calculated sums to ensure they are equal.\"\"\"\n        if not row_sums:  # Should not happen if _is_square returns True for a valid matrix\n            return False\n\n        expected_sum = row_sums[0]\n        \n        # Check all row sums\n        if any(s != expected_sum for s in row_sums):\n            return False\n        \n        # Check all column sums\n        if any(s != expected_sum for s in col_sums):\n            return False\n            \n        # Check diagonal sums\n        if main_diag != expected_sum or anti_diag != expected_sum:\n            return False\n            \n        return True\n\n    # Main logic for magic square test\n    if not _is_square(matrix):\n        return False\n    \n    row_sums = _calculate_row_sums(matrix)\n    col_sums = _calculate_column_sums(matrix)\n    main_diag_sum = _calculate_main_diagonal_sum(matrix)\n    anti_diag_sum = _calculate_anti_diagonal_sum(matrix)\n\n    return _compare_all_sums(row_sums, col_sums, main_diag_sum, anti_diag_sum)"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(input_list: list):\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    It applies first-occurrence tie-breaking rules if frequencies are equal.\n    \"\"\"\n    if not input_list:\n        return None\n\n    frequencies = {}\n    max_freq = 0\n    max_item = None\n\n    for item in input_list:\n        # Increment frequency count for the current item\n        frequencies[item] = frequencies.get(item, 0) + 1\n        current_freq = frequencies[item]\n\n        # Update max_freq and max_item only if the current item's frequency\n        # is strictly greater than the current maximum frequency.\n        # This naturally handles first-occurrence tie-breaking.\n        if current_freq > max_freq:\n            max_freq = current_freq\n            max_item = item\n            \n    return max_item"}
{"task_id": "Mbpp/130", "solution": "def _count_frequencies(input_list: list) -> dict:\n    \"\"\"Counts the frequency of each item in the list.\"\"\"\n    frequency_map = {}\n    for item in input_list:\n        frequency_map[item] = frequency_map.get(item, 0) + 1\n    return frequency_map\ndef _find_max_frequency_item(frequency_dict: dict) -> int:\n    \"\"\"Finds the item with the maximum frequency from a frequency dictionary.\"\"\"\n    max_item = None\n    max_frequency = -1\n\n    for item, frequency in frequency_dict.items():\n        if frequency > max_frequency:\n            max_frequency = frequency\n            max_item = item\n    return max_item\ndef max_occurrences(input_list: list) -> int:\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    Raises ValueError if the input list is empty.\n    \"\"\"\n    if not input_list:\n        raise ValueError(\"Input list cannot be empty\")\n\n    frequency_map = _count_frequencies(input_list)\n    most_frequent_item = _find_max_frequency_item(frequency_map)\n    return most_frequent_item"}
{"task_id": "Mbpp/131", "solution": "VOWEL_SET = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\ndef _identify_vowels(input_string: str) -> list[tuple[str, int]]:\n    \"\"\"Extracts vowels and their original indices from the input string.\"\"\"\n    vowel_info = []\n    for i, char in enumerate(input_string):\n        if char in VOWEL_SET:\n            vowel_info.append((char, i))\n    return vowel_info\ndef _reverse_vowel_positions(vowel_chars: list) -> list:\n    \"\"\"Reverses the order of vowel characters in a list.\"\"\"\n    return vowel_chars[::-1]\ndef _reconstruct_string(original_string: str, vowel_indices: list, reversed_vowel_chars: list) -> str:\n    \"\"\"Reconstructs the string by placing reversed vowels back into their original positions.\"\"\"\n    char_list = list(original_string)\n    for i in range(len(vowel_indices)):\n        original_index = vowel_indices[i]\n        char_list[original_index] = reversed_vowel_chars[i]\n    return \"\".join(char_list)\ndef reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels of a given string (where y is not a vowel).\n    Consonants remain in their original positions.\n    \"\"\"\n    identified_vowels = _identify_vowels(s)\n\n    if len(identified_vowels) <= 1:\n        return s\n\n    vowel_chars = [item[0] for item in identified_vowels]\n    vowel_indices = [item[1] for item in identified_vowels]\n\n    reversed_vowel_chars = _reverse_vowel_positions(vowel_chars)\n\n    result = _reconstruct_string(s, vowel_indices, reversed_vowel_chars)\n    return result"}
{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix):\n    \"\"\"\n    Checks if a given matrix is a magic square.\n    A magic square is a square matrix where the sum of each row, each column,\n    and both main diagonals is the same.\n    \"\"\"\n\n    def _validate_input(mat):\n        # Check if the matrix is a list and not empty.\n        if not isinstance(mat, list) or not mat:\n            return False\n\n        n = len(mat)\n        # Check if it's a square matrix (n x n) and all rows are lists.\n        for row in mat:\n            if not isinstance(row, list) or len(row) != n:\n                return False\n            # Check if elements are numeric. Without isinstance, we rely on sum() later.\n            # If any element is not summable, sum() will raise an error.\n            # The design context implies valid numeric inputs for calculation,\n            # so we focus on structural validity here.\n        return True\n\n    def _calculate_row_sums(mat):\n        return [sum(row) for row in mat]\n\n    def _calculate_column_sums(mat):\n        n = len(mat)\n        column_sums = []\n        for j in range(n):\n            current_column_sum = 0\n            for i in range(n):\n                current_column_sum += mat[i][j]\n            column_sums.append(current_column_sum)\n        return column_sums\n\n    def _calculate_main_diagonal_sum(mat):\n        n = len(mat)\n        main_diag_sum = 0\n        for i in range(n):\n            main_diag_sum += mat[i][i]\n        return main_diag_sum\n\n    def _calculate_anti_diagonal_sum(mat):\n        n = len(mat)\n        anti_diag_sum = 0\n        for i in range(n):\n            anti_diag_sum += mat[i][n - 1 - i]\n        return anti_diag_sum\n\n    def _compare_all_sums(row_sums, column_sums, main_diag_sum, anti_diag_sum):\n        if not row_sums:  # Should be caught by validation, but as a safeguard\n            return False\n\n        magic_constant = row_sums[0]\n\n        # Check all row sums\n        for s in row_sums:\n            if s != magic_constant:\n                return False\n\n        # Check all column sums\n        for s in column_sums:\n            if s != magic_constant:\n                return False\n\n        # Check main diagonal sum\n        if main_diag_sum != magic_constant:\n            return False\n\n        # Check anti-diagonal sum\n        if anti_diag_sum != magic_constant:\n            return False\n\n        return True\n\n    if not _validate_input(matrix):\n        return False\n\n    row_sums = _calculate_row_sums(matrix)\n    column_sums = _calculate_column_sums(matrix)\n    main_diag_sum = _calculate_main_diagonal_sum(matrix)\n    anti_diag_sum = _calculate_anti_diagonal_sum(matrix)\n\n    return _compare_all_sums(row_sums, column_sums, main_diag_sum, anti_diag_sum)"}
{"task_id": "Mbpp/131", "solution": "def _is_vowel(char: str) -> bool:\n    \"\"\"Determines if a character is a vowel (a, e, i, o, u) case-insensitively, excluding 'y'.\"\"\"\n    return char.lower() in \"aeiou\"\ndef _extract_vowels(text: str) -> list[tuple[str, int]]:\n    \"\"\"Extracts vowels and their positions from a string.\"\"\"\n    vowels_with_pos = []\n    for i, char in enumerate(text):\n        if _is_vowel(char):\n            vowels_with_pos.append((char, i))\n    return vowels_with_pos\ndef _reconstruct_string(original: str, vowel_info: list[tuple[str, int]]) -> str:\n    \"\"\"Reconstructs the string by placing specified vowels at their original positions.\"\"\"\n    char_list = list(original)\n    for vowel_char, original_index in vowel_info:\n        char_list[original_index] = vowel_char\n    return \"\".join(char_list)\ndef reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels in a given string, preserving consonants and case.\n    'y' is not considered a vowel.\n    \"\"\"\n    # Extract all vowels along with their original indices\n    extracted_vowels = _extract_vowels(s)\n\n    # If there are 0 or 1 vowels, no reversal is needed\n    if len(extracted_vowels) <= 1:\n        return s\n\n    # Separate the vowel characters and their original indices\n    vowel_chars_only = [v[0] for v in extracted_vowels]\n    original_vowel_indices = [v[1] for v in extracted_vowels]\n\n    # Reverse the order of the vowel characters\n    reversed_vowel_chars = vowel_chars_only[::-1]\n\n    # Combine the reversed vowel characters with their original indices\n    # This forms the list of (reversed_vowel, original_index) for reconstruction\n    reconstruction_vowel_info = []\n    for i in range(len(reversed_vowel_chars)):\n        reconstruction_vowel_info.append((reversed_vowel_chars[i], original_vowel_indices[i]))\n\n    # Reconstruct the string using the original string and the new vowel placements\n    return _reconstruct_string(s, reconstruction_vowel_info)"}
