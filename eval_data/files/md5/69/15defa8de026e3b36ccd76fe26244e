{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Catalan number using the formula C(n) = (2n)! / ((n+1)! * n!).\n    \"\"\"\n    def _factorial(k: int) -> int:\n        \"\"\"Helper to calculate factorial of a non-negative integer k.\"\"\"\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    # C(n) = (2n)! / ((n+1)! * n!)\n    numerator = _factorial(2 * n)\n    denominator = _factorial(n + 1) * _factorial(n)\n\n    return numerator // denominator"}
{"task_id": "Mbpp/585", "solution": "def _has_required_fields(item: dict) -> bool:\n    \"\"\"Check if item has required name and price fields.\"\"\"\n    return 'name' in item and 'price' in item and isinstance(item['price'], (int, float))\ndef _validate_dataset(dataset: list) -> bool:\n    \"\"\"Validate that dataset is a list of properly formatted items.\"\"\"\n    if not isinstance(dataset, list):\n        return False\n    for item in dataset:\n        if not isinstance(item, dict) or not _has_required_fields(item):\n            return False\n    return True\ndef _validate_n(n: int) -> bool:\n    \"\"\"Validate that n is a positive integer.\"\"\"\n    return isinstance(n, int) and n > 0\ndef _validate_inputs(dataset: list, n: int) -> bool:\n    \"\"\"Internal validation helper.\"\"\"\n    return _validate_dataset(dataset) and _validate_n(n)\ndef _sort_by_price_desc(items: list) -> list:\n    \"\"\"Sort items by price in descending order.\"\"\"\n    return sorted(items, key=lambda x: x['price'], reverse=True)\ndef _extract_top_n(sorted_items: list, n: int) -> list:\n    \"\"\"Extract the top n items from sorted list.\"\"\"\n    return sorted_items[:n]\ndef expensive_items(dataset: list, n: int) -> list:\n    \"\"\"Find the n most expensive items in the dataset.\"\"\"\n    if not _validate_inputs(dataset, n):\n        return []\n\n    if not dataset:\n        return []\n\n    sorted_items = _sort_by_price_desc(dataset)\n    return _extract_top_n(sorted_items, n)"}
