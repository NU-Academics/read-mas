{"task_id": "Mbpp/4", "solution": "import heapq\ndef heap_queue_largest(numbers: list, n: int) -> list:\n    \"\"\"\n    Finds the n largest integers from a list of numbers and returns them in descending order.\n    It uses a min-heap to efficiently keep track of the n largest elements encountered.\n    \"\"\"\n    if n <= 0 or not numbers:\n        return []\n\n    min_heap = []\n    for num in numbers:\n        if len(min_heap) < n:\n            heapq.heappush(min_heap, num)\n        elif num > min_heap[0]:\n            heapq.heapreplace(min_heap, num)\n\n    # The min_heap now contains the n largest elements.\n    # Sort them in descending order to match the requirement.\n    min_heap.sort(reverse=True)\n    return min_heap"}
{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import List, Union\ndef heap_queue_largest(numbers: List[Union[int, float]], n: int) -> List[int]:\n    \"\"\"\n    Finds the n largest integers from a list of numbers, returned in descending order.\n    Utilizes Python's heapq module for efficient extraction.\n    \"\"\"\n    # Use heapq.nlargest to efficiently get the n largest elements.\n    # This handles cases where n > len(numbers) by returning all elements.\n    largest_elements = heapq.nlargest(n, numbers)\n\n    # Sort the extracted elements in descending order.\n    # heapq.nlargest does not guarantee a specific order among the largest elements.\n    return sorted(largest_elements, reverse=True)"}
