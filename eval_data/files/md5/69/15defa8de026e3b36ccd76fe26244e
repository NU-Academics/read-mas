{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array: list, target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array using binary search.\n    Returns -1 if the target is not found.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            result = mid\n            high = mid - 1  # Try to find an earlier occurrence in the left half\n        elif array[mid] < target:\n            low = mid + 1\n        else:  # array[mid] > target\n            high = mid - 1\n    return result"}
{"task_id": "Mbpp/732", "solution": "def replace_specialchar(input_string: str) -> str:\n    \"\"\"\n    Replaces all occurrences of spaces, commas, or dots with a colon.\n    This is achieved through a series of optimized string replacements.\n    \"\"\"\n    # Replace spaces with colons\n    modified_string = input_string.replace(' ', ':')\n    # Replace commas with colons in the modified string\n    modified_string = modified_string.replace(',', ':')\n    # Replace dots with colons in the further modified string\n    modified_string = modified_string.replace('.', ':')\n    return modified_string"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array: list[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array.\n    Uses a binary search algorithm to achieve O(log n) time complexity.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            result = mid  # Store potential result\n            high = mid - 1  # Continue searching in the left half for an earlier occurrence\n        elif array[mid] < target:\n            low = mid + 1  # Target is in the right half\n        else:  # array[mid] > target\n            high = mid - 1  # Target is in the left half\n\n    return result"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(input_list: list) -> int:\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists of a given list.\n    Orchestrates sublist generation, product calculation, and sum aggregation.\n    \"\"\"\n\n    def generate_sublists(lst: list) -> list:\n        \"\"\"Generates all possible contiguous sublists from the input list.\"\"\"\n        sublists = []\n        n = len(lst)\n        for i in range(n):\n            for j in range(i, n):\n                sublists.append(lst[i : j + 1])\n        return sublists\n\n    def calculate_product(sublist: list) -> int:\n        \"\"\"Calculates the product of elements in a single sublist.\"\"\"\n        if not sublist:\n            return 0  # Product of an empty list is 1 mathematically, but for sums over empty sublists, 0 is safer.\n                      # However, generate_sublists won't create empty sublists for non-empty input.\n        product = 1\n        for item in sublist:\n            product *= item\n        return product\n\n    def sum_products(products: list) -> int:\n        \"\"\"Sums all the calculated product values.\"\"\"\n        return sum(products)\n\n    all_sublists = generate_sublists(input_list)\n    products_of_sublists = [calculate_product(sub) for sub in all_sublists]\n    total_sum = sum_products(products_of_sublists)\n\n    return total_sum"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(input_list: list) -> int:\n    \"\"\"Calculates the sum of products of all possible contiguous sublists (subarrays).\n    This includes single-element sublists.\n    \"\"\"\n    total_sum_of_products = 0\n    n = len(input_list)\n\n    # Iterate through all possible starting points for sublists\n    for i in range(n):\n        current_sublist_product = 1\n        # Iterate through all possible ending points for sublists starting at i\n        for j in range(i, n):\n            # The sublist is input_list[i : j+1]\n            # Efficiently update the product for the current contiguous sublist\n            current_sublist_product *= input_list[j]\n            # Add the product of the current sublist to the total sum\n            total_sum_of_products += current_sublist_product\n\n    return total_sum_of_products"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"\n    Toggles all bits of the number except the most significant (first) and least significant (last) bit.\n    \"\"\"\n    def _get_bit_length(num: int) -> int:\n        \"\"\"Calculates the number of bits required to represent the integer.\"\"\"\n        if num == 0:\n            return 0\n        return num.bit_length()\n\n    def _create_toggle_mask(bit_length: int) -> int:\n        \"\"\"Generates a bitmask to toggle middle bits given the total bit length.\"\"\"\n        if bit_length <= 2:\n            return 0  # No middle bits to toggle for 0, 1, or 2 bits\n        # The mask should have 1s for bits from position 1 to bit_length - 2 (0-indexed).\n        # (1 << (bit_length - 1)) creates a number like 100...0 (bit_length bits long)\n        # Subtracting 1 makes it 011...1 (bit_length - 1 ones)\n        # Subtracting another 1 effectively removes the last '1', leaving 011...10\n        # Example: bit_length = 4 -> (1 << 3) - 2 = 8 - 2 = 6 (binary 0110)\n        return (1 << (bit_length - 1)) - 2\n\n    if number < 0:\n        # The problem implies positive integers by example (9 -> 15).\n        # For negative numbers, bitwise operations might behave differently\n        # depending on the signed representation. We will assume positive integers.\n        # If negative numbers were to be handled, a fixed-width two's complement\n        # interpretation would be required, which is out of scope of the example.\n        pass # Or raise an error if specifically disallowed.\n\n    bit_length = _get_bit_length(number)\n    toggle_mask = _create_toggle_mask(bit_length)\n\n    return number ^ toggle_mask"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"Toggles bits of the number except the first (MSB) and the last (LSB) bit.\"\"\"\n\n    def get_bit_length(num_val: int) -> int:\n        \"\"\"Calculates the number of bits in the binary representation.\"\"\"\n        if num_val == 0:\n            return 1\n        return num_val.bit_length()\n\n    def create_toggle_mask(bit_len_val: int) -> int:\n        \"\"\"Creates a bitmask to toggle middle bits, excluding the first and last.\"\"\"\n        if bit_len_val <= 2:\n            return 0  # No middle bits to toggle\n\n        mask = 0\n        # Iterate from the second bit (index 1) to the second-to-last bit (index bit_len_val - 2)\n        for i in range(1, bit_len_val - 1):\n            mask |= (1 << i)\n        return mask\n\n    total_bits = get_bit_length(number)\n    toggle_mask = create_toggle_mask(total_bits)\n    return number ^ toggle_mask"}
