{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize the last four Fib4 numbers: fib4(0), fib4(1), fib4(2), fib4(3)\n    # These values are needed to compute fib4(4) and subsequent numbers.\n    last_four = [0, 0, 2, 0]\n\n    for i in range(4, n + 1):\n        # Calculate the next Fib4 number using the sum of the last four.\n        next_fib4 = last_four[3] + last_four[2] + last_four[1] + last_four[0]\n        # Shift the values in the list to keep the last four for the next iteration.\n        last_four[0] = last_four[1]\n        last_four[1] = last_four[2]\n        last_four[2] = last_four[3]\n        last_four[3] = next_fib4\n    \n    return last_four[3]"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    return text == text[::-1]"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p using binary exponentiation (exponentiation by squaring).\"\"\"\n    if n == 0:\n        return 1 % p\n\n    result = 1\n    base = 2 % p\n    exponent = n\n\n    while exponent > 0:\n        if exponent % 2 == 1:\n            result = (result * base) % p\n        base = (base * base) % p\n        exponent //= 2\n    return result"}
{"task_id": "HumanEval/50", "solution": "def decode_shift(s: str):\n    \"\"\"\n    takes as input string encoded with encode_shift function. Returns decoded string.\n    \"\"\"\n    decoded_chars = []\n    SHIFT_AMOUNT = 5\n    ALPHABET_SIZE = 26\n    ORD_A = ord('a')\n\n    for ch in s:\n        if 'a' <= ch <= 'z':\n            # Calculate the 0-indexed position relative to 'a'\n            # Shift backward by SHIFT_AMOUNT\n            # Add ALPHABET_SIZE before modulo to handle negative results correctly\n            # Convert back to character using ord('a') as base\n            shifted_ord = ((ord(ch) - SHIFT_AMOUNT - ORD_A + ALPHABET_SIZE) % ALPHABET_SIZE) + ORD_A\n            decoded_chars.append(chr(shifted_ord))\n        else:\n            decoded_chars.append(ch)\n    return \"\".join(decoded_chars)"}
