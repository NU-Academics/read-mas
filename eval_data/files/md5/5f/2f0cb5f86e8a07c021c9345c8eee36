{"task_id": "HumanEval/39", "solution": "from typing import Iterator\nclass FibonacciGenerator:\n    def __init__(self):\n        self._a = 0\n        self._b = 1\n\n    def generate_sequence(self) -> Iterator[int]:\n        \"\"\"Generates an infinite sequence of Fibonacci numbers.\"\"\"\n        while True:\n            yield self._a\n            self._a, self._b = self._b, self._a + self._b\nclass PrimeChecker:\n    def is_prime(self, num: int) -> bool:\n        \"\"\"Checks if a number is prime.\"\"\"\n        if num < 2:\n            return False\n        i = 2\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 1\n        return True\nclass PrimeFibonacciCalculator:\n    def __init__(self, fib_generator: FibonacciGenerator, prime_checker: PrimeChecker):\n        self._fib_generator = fib_generator\n        self._prime_checker = prime_checker\n\n    def find_nth_prime_fib(self, n: int) -> int:\n        \"\"\"Finds the n-th number that is a Fibonacci number and also prime.\"\"\"\n        prime_fib_count = 0\n        for fib_num in self._fib_generator.generate_sequence():\n            if fib_num <= 1: # Skip 0 and 1, as they are not considered prime in this context.\n                continue\n            if self._prime_checker.is_prime(fib_num):\n                prime_fib_count += 1\n                if prime_fib_count == n:\n                    return fib_num\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    fib_generator = FibonacciGenerator()\n    prime_checker = PrimeChecker()\n    calculator = PrimeFibonacciCalculator(fib_generator, prime_checker)\n    return calculator.find_nth_prime_fib(n)"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    if len(l) < 2:\n        return False\n\n    seen_numbers = set()\n    for num in l:\n        complement = -num\n        if complement in seen_numbers:\n            return True\n        seen_numbers.add(num)\n    return False"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    res = []\n    while x > 0:\n        remainder = x % base\n        res.append(str(remainder))\n        x //= base\n    return \"\".join(reversed(res))"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    # Sort the array to efficiently find triplets using the two-pointer approach.\n    sorted_l = sorted(l)\n\n    for i in range(n - 2):\n        # Skip duplicate elements for 'i' to avoid redundant checks.\n        if i > 0 and sorted_l[i] == sorted_l[i-1]:\n            continue\n\n        left = i + 1\n        right = n - 1\n\n        while left < right:\n            current_sum = sorted_l[i] + sorted_l[left] + sorted_l[right]\n\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n            else: # current_sum > 0\n                right -= 1\n    return False"}
{"task_id": "HumanEval/42", "solution": "def incr_list(l: list):\n    \"\"\"Return list with elements incremented by 1.\n    >>> incr_list([1, 2, 3])\n    [2, 3, 4]\n    >>> incr_list([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [6, 4, 6, 3, 4, 4, 10, 1, 124]\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n\n    incremented_list = []\n    for item in l:\n        if not isinstance(item, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n        incremented_list.append(item + 1)\n    return incremented_list"}
