{"task_id": "HumanEval/25", "solution": "def factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    \"\"\"\n    factors: List[int] = []\n    current_n = n\n\n    # Handle factor 2\n    d = 2\n    while current_n % d == 0:\n        factors.append(d)\n        current_n //= d\n\n    # Handle odd factors starting from 3\n    d = 3\n    while d * d <= current_n:\n        while current_n % d == 0:\n            factors.append(d)\n            current_n //= d\n        d += 2\n\n    # If current_n is still greater than 1, it is the remaining prime factor\n    if current_n > 1:\n        factors.append(current_n)\n\n    return factors"}
{"task_id": "HumanEval/29", "solution": "def filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n    \"\"\"\n    return [s for s in strings if s.startswith(prefix)]"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    # Check for factors from 3 up to the square root of n, only odd numbers.\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\n        return []\n\n    indices_to_sort = []\n    values_to_sort = []\n\n    for i, item in enumerate(l):\n        if i % 3 == 0:\n            indices_to_sort.append(i)\n            values_to_sort.append(item)\n\n    values_to_sort.sort()\n\n    result_list = list(l)\n\n    for i, sorted_val in zip(indices_to_sort, values_to_sort):\n        result_list[i] = sorted_val\n\n    return result_list"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list):\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    return sorted(list(set(l)))"}
{"task_id": "HumanEval/35", "solution": "class EmptyListError(Exception):\n    \"\"\"Custom exception raised when an operation requires a non-empty list but receives an empty one.\"\"\"\n    def __init__(self, message=\"Input list cannot be empty.\"):\n        self.message = message\n        super().__init__(self.message)\nclass MaxFinder:\n    \"\"\"A utility class to find the maximum element in a list.\"\"\"\n    @staticmethod\n    def find_max(data: list) -> any:\n        \"\"\"Returns the maximum element in the list, raising EmptyListError if the list is empty.\"\"\"\n        if not data:\n            raise EmptyListError()\n        return max(data)\ndef max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    return MaxFinder.find_max(l)"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\"\"\"\n    total_sevens_count = 0\n    target_digit_char = '7'\n\n    for i in range(1, n):\n        if (i % 11 == 0) or (i % 13 == 0):\n            total_sevens_count += str(i).count(target_digit_char)\n\n    return total_sevens_count"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    even_indexed_elements = [l[i] for i in range(0, len(l), 2)]\n    even_indexed_elements.sort()\n\n    result = l[:]\n    even_sorted_idx = 0\n    for i in range(0, len(l), 2):\n        result[i] = even_indexed_elements[even_sorted_idx]\n        even_sorted_idx += 1\n    return result"}
{"task_id": "HumanEval/30", "solution": "def get_positive(l: list):\n    \"\"\"Return only positive numbers in the list.\n    >>> get_positive([-1, 2, -4, 5, 6])\n    [2, 5, 6]\n    >>> get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    [5, 3, 2, 3, 9, 123, 1]\n    \"\"\"\n    positive_numbers = []\n    for item in l:\n        if isinstance(item, (int, float)) and item > 0:\n            positive_numbers.append(item)\n    return positive_numbers"}
{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    if len(xs) % 2 != 0:\n        raise ValueError(\"find_zero only takes polynomials with an even number of coefficients.\")\n\n    # Handle linear polynomial explicitly for accuracy and to prevent division by zero for the highest degree coefficient.\n    if len(xs) == 2:\n        c0, c1 = xs\n        if c1 == 0:\n            raise RuntimeError(\"Cannot find zero for a constant polynomial (coefficient of x is zero).\")\n        return -c0 / c1\n\n    # For higher degree polynomials, use a simple iterative numerical search within a predefined range.\n    tolerance = 1e-6\n    max_iterations = 1000\n    \n    # Search range from -10.0 to 10.0, as indicated in the design context for common roots.\n    x_min, x_max = -10.0, 10.0 \n    step = (x_max - x_min) / max_iterations\n    \n    current_x = x_min\n    # Iterate through the range, checking for a point where the polynomial's value is approximately zero.\n    while current_x <= x_max:\n        value = poly(xs, current_x)\n        if abs(value) < tolerance:\n            return current_x\n        current_x += step\n    \n    # If no zero is found within the specified range and tolerance after all iterations, raise an error.\n    raise RuntimeError(\"Failed to find a zero point within the search range and tolerance.\")"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # inverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
