{"task_id": "HumanEval/4", "solution": "from typing import List\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    total = 0.0\n    count = 0\n    for i, x in enumerate(numbers):\n        if not isinstance(x, (int, float)):\n            raise TypeError(f\"Element at index {i} is not numeric: {type(x).__name__}\")\n        fx = float(x)\n        total += fx\n        count += 1\n\n    if count == 0:\n        raise ValueError(\"Input sequence cannot be empty.\")\n    if count == 1:\n        return 0.0\n\n    mean = total / count\n\n    mad_sum = 0.0\n    for x in numbers:\n        mad_sum += abs(float(x) - mean)\n\n    return mad_sum / count"}
{"task_id": "HumanEval/12", "solution": "def longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    longest_string: Optional[str] = None\n    max_length = -1  # Initialize with -1 to handle empty strings correctly and ensure None for empty list.\n\n    for s in strings:\n        if len(s) > max_length:\n            max_length = len(s)\n            longest_string = s\n\n    return longest_string"}
{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\"Compute the sum and product of the given integers in a single pass.\n    Empty input yields (0, 1).\n    \"\"\"\n    total = 0\n    product = 1\n    for n in numbers:\n        total += n\n        product *= n\n    return total, product"}
{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    max_so_far = None\n    result = []\n    for n in numbers:\n        if max_so_far is None or n > max_so_far:\n            max_so_far = n\n        result.append(max_so_far)\n    return result"}
{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of\n    >>> count_distinct_characters('xyzXYZ')\n    3\n    >>> count_distinct_characters('Jerry')\n    4\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string\")\n    return len(set(string.lower()))"}
{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    if not isinstance(strings, list):\n        raise TypeError(\"strings must be a list of strings\")\n    if not isinstance(substring, str):\n        raise TypeError(\"substring must be a string\")\n    if any(not isinstance(s, str) for s in strings):\n        raise TypeError(\"all elements of strings must be strings\")\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/6", "solution": "def parse_nested_parens(paren_string: str) -> \"List[int]\":\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    if not isinstance(paren_string, str):\n        raise TypeError(\"Input 'paren_string' must be a string.\")\n\n    def _validate_group(group):\n        balance = 0\n        for ch in group:\n            if ch == '(':\n                balance += 1\n            elif ch == ')':\n                balance -= 1\n            else:\n                raise ValueError(f\"Invalid character '{ch}' found in group: '{group}'. Only '(' and ')' are allowed.\")\n            if balance < 0:\n                raise ValueError(f\"Unbalanced parentheses: ')' appeared before '('. Group: '{group}'.\")\n        if balance != 0:\n            raise ValueError(f\"Unbalanced parentheses: Mismatched '(' and ')' count. Group: '{group}'.\")\n\n    def _compute_depth(group):\n        current_depth = 0\n        max_depth = 0\n        for ch in group:\n            if ch == '(':\n                current_depth += 1\n            elif ch == ')':\n                current_depth -= 1\n            max_depth = max(max_depth, current_depth)\n        return max_depth\n\n    tokens = paren_string.split()\n    depths = []\n    for token in tokens:\n        _validate_group(token)\n        depths.append(_compute_depth(token))\n    return depths"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Splits an input string into top-level balanced groups of parentheses.\n    Ignores whitespace and non-parenthesis characters, returning a list of groups.\"\"\"\n    if not isinstance(paren_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    # Remove whitespace and filter for only '(' and ')'\n    cleaned_parens = \"\".join(c for c in paren_string if c in \"()\")\n\n    if not cleaned_parens:\n        return []\n\n    groups: List[str] = []\n    current_group_chars: List[str] = []\n    depth = 0\n\n    for char in cleaned_parens:\n        if char == '(':\n            if depth == 0:\n                # Start a new potential top-level group\n                current_group_chars = []\n            depth += 1\n            current_group_chars.append(char)\n        elif char == ')':\n            if depth == 0:\n                # Stray closing parenthesis at top level, ignore\n                continue\n            depth -= 1\n            current_group_chars.append(char)\n            if depth == 0:\n                # End of a top-level group\n                groups.append(\"\".join(current_group_chars))\n\n    return groups"}
