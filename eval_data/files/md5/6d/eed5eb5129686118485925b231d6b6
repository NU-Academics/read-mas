{"task_id": "HumanEval/49", "solution": "from collections import OrderedDict\nimport threading\nfrom typing import Optional, Tuple\nclass InvalidExponentError(ValueError):\n    def __init__(self, message: str):\n        super().__init__(message)\nclass InvalidModulusError(ValueError):\n    def __init__(self, message: str):\n        super().__init__(message)\nclass Config:\n    CACHE_ENABLED: bool = True\n    CACHE_SIZE: int = 1024\n    VERSION: str = \"0.1.0\"\n    CLI_DEFAULT_JSON: bool = False\nclass LRUCache:\n    def __init__(self, max_size: int = 1024):\n        self.max_size = max_size\n        self.store: OrderedDict[Tuple[int, int], int] = OrderedDict()\n        self.lock = threading.Lock()\n\n    def get(self, key: Tuple[int, int]) -> Optional[int]:\n        with self.lock:\n            try:\n                value = self.store.pop(key)\n                self.store[key] = value\n                return value\n            except KeyError:\n                return None\n\n    def put(self, key: Tuple[int, int], value: int) -> None:\n        with self.lock:\n            if key in self.store:\n                self.store.pop(key)\n            self.store[key] = value\n            if len(self.store) > self.max_size:\n                self.store.popitem(last=False)\nclass InputValidator:\n    def validate(self, n: int, p: int) -> None:\n        if not isinstance(n, int):\n            raise InvalidExponentError(\"n must be an integer.\")\n        if not isinstance(p, int):\n            raise InvalidModulusError(\"p must be an integer.\")\n        if n < 0:\n            raise InvalidExponentError(\"n must be >= 0.\")\n        if p <= 1:\n            raise InvalidModulusError(\"p must be > 1.\")\nclass ModularExponentiator:\n    def __init__(self, cache: Optional[LRUCache] = None):\n        self.cache = cache \n\n    def calculate(self, n: int, p: int) -> Tuple[int, bool]:\n        \"\"\"Calculates 2^n mod p, potentially using a cache, and returns the result and cache status.\"\"\"\n        key = (n, p)\n        is_cached = False\n        \n        if self.cache:\n            v = self.cache.get(key)\n            if v is not None:\n                is_cached = True\n                return v, is_cached\n        \n        result = self._pow_mod(2, n, p)\n        \n        if self.cache:\n            self.cache.put(key, result)\n        \n        return result, is_cached\n\n    def _pow_mod(self, base: int, exponent: int, modulus: int) -> int:\n        \"\"\"Computes (base^exponent) % modulus using exponentiation by squaring.\"\"\"\n        result = 1\n        base %= modulus\n        while exponent > 0:\n            if exponent & 1:\n                result = (result * base) % modulus\n            base = (base * base) % modulus\n            exponent >>= 1\n        return result\nclass APIController:\n    _shared_lru_cache: Optional[LRUCache] = None\n\n    def __init__(self, \n                 validator: Optional[InputValidator] = None, \n                 modular_exponentiator_factory=None):\n        self.validator = validator or InputValidator()\n        \n        if APIController._shared_lru_cache is None and Config.CACHE_ENABLED:\n            APIController._shared_lru_cache = LRUCache(Config.CACHE_SIZE)\n        \n        self._modular_exponentiator_factory = modular_exponentiator_factory or \\\n                                              (lambda cache_instance: ModularExponentiator(cache=cache_instance))\n\n    def compute(self, n: int, p: int, use_cache: Optional[bool] = None) -> dict:\n        \"\"\"\n        Validates inputs, computes 2^n mod p, and returns result with cache status.\n        'use_cache' parameter overrides global Config.CACHE_ENABLED for this specific call.\n        \"\"\"\n        self.validator.validate(n, p)\n\n        cache_for_this_call: Optional[LRUCache] = None\n        if use_cache is None:\n            if Config.CACHE_ENABLED and APIController._shared_lru_cache:\n                cache_for_this_call = APIController._shared_lru_cache\n        elif use_cache is True:\n            if APIController._shared_lru_cache is None:\n                APIController._shared_lru_cache = LRUCache(Config.CACHE_SIZE)\n            cache_for_this_call = APIController._shared_lru_cache\n\n        exponentiator = self._modular_exponentiator_factory(cache_instance=cache_for_this_call)\n        \n        result, is_cached = exponentiator.calculate(n, p)\n        \n        return {\"result\": result, \"cached\": is_cached}\ndef modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    >>> modp(3, 5)\n    3\n    >>> modp(1101, 101)\n    2\n    >>> modp(0, 101)\n    1\n    >>> modp(3, 11)\n    8\n    >>> modp(100, 101)\n    1\n    \"\"\"\n    controller = APIController()\n    result = controller.compute(n, p)[\"result\"]\n    return result"}
