r(planet2_name)\n\n            if order1 is None or order2 is None:\n                return ()\n\n            # Ensure order1 is smaller than order2 for consistent iteration.\n            start_order = min(order1, order2)\n            end_order = max(order1, order2)\n\n            between_planets = []\n            for planet in self._planets_data:\n                if start_order < planet.order_from_sun < end_order:\n                    between_planets.append(planet.name)\n            \n            return tuple(between_planets)\n\n    # Instantiate the SolarSystem once to reuse its data.\n    _solar_system = SolarSystem()\n    return _solar_system.get_planets_between(planet1, planet2)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/147": [{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from array 'a' where i < j < k\n    and their sum is a multiple of 3.\n    \"\"\"\n    \n    def _combinations(n_val, k_val):\n        \"\"\"Calculates n choose k, the number of combinations.\"\"\"\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0 or k_val == n_val:\n            return 1\n        if k_val > n_val // 2:\n            k_val = n_val - k_val\n        \n        res = 1\n        for i in range(k_val):\n            res = res * (n_val - i) // (i + 1)\n        return res\n\n    def _calculate_element_mod_3(i_val):\n        \"\"\"Determines (i*i - i + 1) % 3.\"\"\"\n        # a[i] = i*i - i + 1\n        # If i % 3 == 0: a[i] % 3 = (0*0 - 0 + 1) % 3 = 1\n        # If i % 3 == 1: a[i] % 3 = (1*1 - 1 + 1) % 3 = 1\n        # If i % 3 == 2: a[i] % 3 = (2*2 - 2 + 1) % 3 = 3 % 3 = 0\n        if i_val % 3 == 2:\n            return 0\n        return 1\n\n    def _count_remainders(num):\n        \"\"\"Counts elements with remainder 0 and 1 modulo 3.\"\"\"\n        count_mod_0 = 0\n        count_mod_1 = 0\n        for i_val in range(1, num + 1):\n            if _calculate_element_mod_3(i_val) == 0:\n                count_mod_0 += 1\n            else:\n                count_mod_1 += 1\n        return count_mod_0, count_mod_1\n\n    count_mod_0, count_mod_1 = _count_remainders(n)\n\n    # For a[i] + a[j] + a[k] to be a multiple of 3, and since a[x] can only be 0 or 1 mod 3,\n    # the remainders must be either (0, 0, 0) or (1, 1, 1).\n    \n    triples_000 = _combinations(count_mod_0, 3)\n    triples_111 = _combinations(count_mod_1, 3)\n\n    return triples_000 + triples_111", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/150": [{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n    \n    \"\"\"\n    def is_prime(num):\n        \"\"\"Checks if a given integer `num` is a prime number.\"\"\"\n        if num <= 1:\n            return False\n        if num == 2:\n            return True\n        # Iterate from 2 up to the square root of num\n        i = 2\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 1\n        return True\n\n    if is_prime(n):\n        return x\n    else:\n        return y", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/151": [{"task_id": "HumanEval/151", "solution": "def _is_non_negative_integer(num):\n    \"\"\"Checks if a value is a non-negative integer.\"\"\"\n    return isinstance(num, int) and num >= 0\ndef _is_odd(num):\n    \"\"\"Checks if an integer is odd.\"\"\"\n    return num % 2 != 0\ndef double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0  \n   \n    If the input list is empty, return 0.\n    '''\n    total_sum = 0\n    \n    if not lst:\n        return 0\n\n    for item in lst:\n        if _is_non_negative_integer(item):\n            if _is_odd(item):\n                total_sum += item * item\n                \n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/152": [{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"Compares two arrays of scores and guesses, returning an array of absolute differences.\n    A value of 0 indicates a correct guess.\n    \"\"\"\n    differences = []\n    for i in range(len(game)):\n        game_score = game[i]\n        player_guess = guess[i]\n\n        if game_score == player_guess:\n            differences.append(0)\n        else:\n            differences.append(abs(game_score - player_guess))\n\n    return differences", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/154": [{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"Checks if the second word or any of its rotations is a substring in the first word.\"\"\"\n    if not b:\n        return False\n\n    b_len = len(b)\n    for i in range(b_len):\n        rotation = b[i:] + b[:i]\n        if rotation in a:\n            return True\n\n    return False", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["", ""]]}], "HumanEval/153": [{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension based on CAP (uppercase count) - SM (lowercase count).\n    Returns a formatted string 'ClassName.StrongestExtensionName'.\n    In case of a tie, the first extension in the list is chosen.\n    \"\"\"\n    class Extension:\n        \"\"\"\n        Encapsulates an extension's name and calculates its strength.\n        Strength is CAP - SM.\n        \"\"\"\n        def __init__(self, name: str):\n            self.name = name\n            self._cap_count = 0\n            self._sm_count = 0\n            for char in name:\n                if char.isupper():\n                    self._cap_count += 1\n                elif char.islower():\n                    self._sm_count += 1\n            self.strength = self._cap_count - self._sm_count\n\n        def get_strength(self) -> int:\n            \"\"\"Returns the calculated strength of the extension.\"\"\"\n            return self.strength\n\n    max_strength = -float('inf')\n    strongest_ext_name = None\n\n    for ext_name in extensions:\n        current_extension = Extension(ext_name)\n        current_strength = current_extension.get_strength()\n\n        # Update if the current extension is strictly stronger.\n        # If strengths are equal, the first one encountered (already stored) wins.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_ext_name = ext_name\n    \n    return f\"{class_name}.{strongest_ext_name}\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/155": [{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Process the absolute value of the number to count digits.\n    abs_num_str = str(abs(num))\n\n    for digit_char in abs_num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/156": [{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    if not (1 <= number <= 1000):\n        raise ValueError(\"Input number must be between 1 and 1000, inclusive.\")\n\n    roman_map = [\n        (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n        (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n        (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'),\n        (1, 'i')\n    ]\n\n    result = []\n    temp_num = number\n\n    for value, numeral in roman_map:\n        while temp_num >= value:\n            result.append(numeral)\n            temp_num -= value\n\n    return \"\".join(result)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/158": [{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Returns the word with the maximum number of unique characters.\n    If there's a tie, the lexicographically smallest word is returned.\n    \"\"\"\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            if word < result_word:\n                result_word = word\n    return result_word", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/159": [{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten and the carrots left