aise ValueError(\"Unsupported operator found. Only '+', '-', '*', '//', '**' are allowed.\")\n        if any(not isinstance(num, int) or num < 0 for num in operand):\n            raise ValueError(\"All elements in operand list must be non-negative integers.\")\n        if len(operand) < 2:\n            raise ValueError(\"Operand list must have at least two operands.\")\n\n    def _construct_expression_string(operator, operand):\n        \"\"\"Builds the algebraic expression string by interleaving operands and operators.\"\"\"\n        expression = str(operand[0])\n        for i in range(len(operator)):\n            expression += \" \" + operator[i] + \" \" + str(operand[i+1])\n        return expression\n\n    def _evaluate_expression_string(expression_string):\n        \"\"\"Evaluates the constructed algebraic expression string.\"\"\"\n        return int(eval(expression_string))\n\n    _validate_inputs(operator, operand)\n    expression_string = _construct_expression_string(operator, operand)\n    result = _evaluate_expression_string(expression_string)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/157": [{"task_id": "HumanEval/157", "solution": "class Triangle:\n    \"\"\"Encapsulates triangle properties and provides a method to check if it is right-angled.\"\"\"\n    def __init__(self, a: float, b: float, c: float):\n        \"\"\"Initializes the triangle with three side lengths.\"\"\"\n        self._side_a = a\n        self._side_b = b\n        self._side_c = c\n\n    def is_right_angled(self) -> bool:\n        \"\"\"Determines if the triangle is right-angled using the Pythagorean theorem.\"\"\"\n        sides = sorted([self._side_a, self._side_b, self._side_c])\n        s1, s2, s3 = sides[0], sides[1], sides[2]\n        # Use a small epsilon for floating-point comparison\n        epsilon = 1e-9\n        return abs(s1*s1 + s2*s2 - s3*s3) < epsilon\ndef right_angle_triangle(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    \"\"\"\n    triangle = Triangle(a, b, c)\n    return triangle.is_right_angled()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/161": [{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n\n    def _is_letter(char):\n        \"\"\"Checks if a character is an alphabetic letter.\"\"\"\n        return 'a' <= char <= 'z' or 'A' <= char <= 'Z'\n\n    def _reverse_char_case(char):\n        \"\"\"Reverses the case of a single letter character.\"\"\"\n        if 'a' <= char <= 'z':\n            return char.upper()\n        elif 'A' <= char <= 'Z':\n            return char.lower()\n        return char\n\n    def _contains_letters(s_str):\n        \"\"\"Checks if the input string contains any alphabetic letters.\"\"\"\n        for char in s_str:\n            if _is_letter(char):\n                return True\n        return False\n\n    def _reverse_string(s_str):\n        \"\"\"Reverses the order of characters in an entire string.\"\"\"\n        return s_str[::-1]\n\n    if not s:\n        return \"\"\n\n    if not _contains_letters(s):\n        return _reverse_string(s)\n    else:\n        result_chars = []\n        for char in s:\n            if _is_letter(char):\n                result_chars.append(_reverse_char_case(char))\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)", "base_status": "pass", "plus_status": "fail", "base_fail_test