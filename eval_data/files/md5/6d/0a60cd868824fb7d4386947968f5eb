ass _Triangle:\n    \"\"\"Encapsulates triangle side lengths, provides methods for validation and area calculation.\"\"\"\n    def __init__(self, a: float, b: float, c: float):\n        self._side_a = a\n        self._side_b = b\n        self._side_c = c\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the sides form a valid triangle based on positivity and triangle inequality.\"\"\"\n        # Sides must be positive\n        if not (self._side_a > 0 and self._side_b > 0 and self._side_c > 0):\n            return False\n        # Sum of any two sides must be strictly greater than the third side\n        return (self._side_a + self._side_b > self._side_c and\n                self._side_a + self._side_c > self._side_b and\n                self._side_b + self._side_c > self._side_a)\n\n    def calculate_area(self) -> float:\n        \"\"\"Calculates the area using Heron's formula, rounded to two decimal places.\"\"\"\n        s = (self._side_a + self._side_b + self._side_c) / 2\n        area_squared = s * (s - self._side_a) * (s - self._side_b) * (s - self._side_c)\n        area = math.sqrt(area_squared)\n        return round(area, 2)\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    triangle = _Triangle(a, b, c)\n    if triangle.is_valid():\n        return triangle.calculate_area()\n    else:\n        return -1", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/77": [{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Write a function that takes an integer a and returns True \n    if this ingeger is a cube o