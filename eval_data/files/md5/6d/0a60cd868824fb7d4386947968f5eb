 Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    even_single_digits = [2, 4, 6, 8]\n    result = []\n\n    for digit in even_single_digits:\n        if min_val <= digit <= max_val:\n            result.append(digit)\n\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/15": [{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    \"\"\"\n    if n >= 0:\n        numbers = [str(i) for i in range(n + 1)]\n    else:\n        numbers = [str(i) for i in range(0, n - 1, -1)]\n\n    result_string = ' '.join(numbers)\n    return result_string", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/130": [{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the Tribonacci sequence up to the nth term based on specific recurrence relations.\n    Returns a list of the first n + 1 numbers of the sequence, starting from tri(0).\n    \"\"\"\n    memo = {}\n\n    # Determine the maximum index needed for calculation.\n    # If n is odd, tri(n) depends on tri(n + 1), so we need to calculate up to n + 1.\n    max_calc_index = n + 1 if n % 2 != 0 else n\n\n    # Step 1: Calculate base cases (tri(0), tri(1)) and all even terms up to max_calc_index.\n    for i in range(max_calc_index + 1):\n        if i == 0:\n            memo[0] = 1.0\n        elif i == 1:\n            memo[1] = 3.0\n        elif i % 2 == 0:  # n is even and n > 0\n            memo[i] = 1 + i / 2\n\n    # Step 2: Calculate all odd terms (where i > 1) using memoized values.\n    for i in range(2, n + 1):\n        if i % 2 != 0:  # n is odd and n > 1\n            memo[i] = memo[i - 1] + memo[i - 2] + memo[i + 1]\n\n    # Extract the sequence from tri(0) to tri(n) inclusive.\n    return [memo[i] for i in range(n + 1)]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n\n    class Cell:\n        def __init__(self, value: int, row: int, col: int):\n            self.value = value\n            self.row = row\n            self.col = col\n\n        def get_neighbors_coords(self, grid_N: int) -> list[tuple[int, int]]:\n            \"\"\"Returns the (row, col) coordinates of valid adjacent neighbors.\"\"\"\n            neighbors = []\n            directions = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n            for dr, dc in directions:\n                n_row, n_col = self.row + dr, self.col + dc\n                if 0 <= n_row < grid_N and 0 <= n_col < grid_N:\n                    neighbors.append((n_row, n_col))\n            return neighbors\n\n    class Grid:\n        def __init__(self, grid_values: list[list[int]]):\n            self.N = len(grid_values)\n            self._cells: list[list[Cell]] = []\n            for r in range(self.N):\n                row_cells = []\n                for c in range(self.N):\n                    row_cells.append(Cell(grid_values[r][c], r, c))\n                self._cells.append(row_cells)\n\n        def get_cell(self, row: int, col: int) -> Cell:\n            \"\"\"Returns the Cell object at the specified row and column.\"\"\"\n            return self._cells[row][col]\n\n    class Path:\n        def __init__(self, cells: list[Cell]):\n            self.sequence_of_cells = cells\n            self.length = len(cells)\n\n        def get_values(self) -> list[int]:\n            \"\"\"Returns an ordered list of integer values from the cells in the path.\"\"\"\n            return [cell.value for cell in self.sequence_of_cells]\n\n        def __lt__(self, other_path: 'Path') -> bool:\n            \"\"\"Implements lexicographical comparison between two paths.\"\"\"\n            self_values = self.get_values()\n            other_values = other_path.get_values()\n            return self_values < other_values\n\n    class PathfindingSolver:\n        def __init__(self, grid: Grid, k: int):\n            self._grid = grid\n            self._k = k\n            self._min_path: Path | None = None\n\n        def find_min_path(self) -> Path:\n            \"\"\"Executes the pathfinding algorithm and returns the lexicographically smallest path.\"\"\"\n            N = self._grid.N\n            for r in range(N):\n                for c in range(N):\n                    start_cell = self._grid.get_cell(r, c)\n                    self._dfs(start_cell, [start_cell])\n            return self._min_path\n\n        def _dfs(self, current_cell: Cell, current_path_cells: list[Cell]) -> None:\n            \"\"\"Recursively explores paths using depth-first search to find the minimum path.\"\"\"\n            if len(current_path_cells) == self._k:\n                new_path = Path(current_path_cells)\n                if self._min_path is None or new_path < self._min_path:\n                    self._min_path = new_path\n                return\n\n            if len(current_path_cells) > self._k:\n                return\n\n            for nr, nc in current_cell.get_neighbors_coords(self._grid.N):\n                neighbor_cell = self._grid.get_cell(nr, nc)\n                self._dfs(neighbor_cell, current_path_cells + [neighbor_cell])\n\n    grid_obj = Grid(grid)\n    solver = PathfindingSolver(grid_obj, k)\n    min_path_found = solver.find_min_path()\n    return min_path_found.get_values()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[12, 13, 10, 1], [9, 3, 15, 6], [5, 16, 14, 4], [11, 8, 7, 2]], 12]], "plus_fail_tests": [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], 15]]}], "HumanEval/83": [{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        # For n=1, the only 1-digit number is 1, which starts and ends with 1.\n        return 1\n    else:\n        # Count of n-digit numbers starting with 1: first digit is 1, remaining n-1 digits can be 0-9.\n        count_starts = 10**(n - 1)\n\n        # Count of n-digit numbers ending with 1: last digit is 1. First digit can be 1-9 (9 options), remaining n-2 digits can be 0-9.\n        count_ends = 9 * (10**(n - 2))\n\n        # Count of n-digit numbers starting AND ending with 1: first digit is 1, last digit is 1. Remaining n-2 digits can be 0-9.\n        count_both = 10**(n - 2)\n\n        # Apply the inclusion-exclusion principle: P(A or B) = P(A) + P(B) - P(A and B).\n        return count_starts + count_ends - count_both", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/139": [{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    def factorial(k):\n        \"\"\"Helper function to calculate the standard factorial of k.\"\"\"\n        if k == 0:\n            return 1\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    special_fact_product = 1\n    for i in range(1, n + 1):\n        special_fact_product *= factorial(i)\n    return special_fact_product", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]}}