{"task_id": "Mbpp/88", "solution": "from collections import Counter\nfrom typing import List, Any, Dict\n\ndef freq_count(input_list: List[Any]) -> Dict[Any, int]:\n    \"\"\"\n    Calculates the frequency of all elements in a list, returned as a dictionary.\n    Keys are unique elements and values are their corresponding frequencies.\n    \"\"\"\n    return dict(Counter(input_list))"}
{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is undulating. An undulating number has at least two digits\n    and its digits strictly alternate between two distinct values.\n    \"\"\"\n    str_number = str(number)\n\n    if len(str_number) < 2:\n        return False\n\n    first_digit = int(str_number[0])\n    second_digit = int(str_number[1])\n\n    if first_digit == second_digit:\n        return False\n\n    for i in range(2, len(str_number)):\n        current_digit = int(str_number[i])\n        if i % 2 == 0:  # Even index, should match first_digit\n            if current_digit != first_digit:\n                return False\n        else:  # Odd index, should match second_digit\n            if current_digit != second_digit:\n                return False\n\n    return True"}
{"task_id": "Mbpp/93", "solution": "class PowerCalculation:\n    \"\"\"\n    Encapsulates the business logic for calculating 'a' to the power 'b'.\n    Handles specific cases for exponents 0 and 1.\n    \"\"\"\n    def __init__(self, base: float, exponent: float):\n        self._base = base\n        self._exponent = exponent\n        self._result = 0.0\n\n    def calculatePower(self) -> float:\n        \"\"\"\n        Computes the power of the stored base and exponent.\n        Applies business rules for exponents 0, 1, and base 1.\n        \"\"\"\n        if self._exponent == 0:\n            self._result = 1.0\n        elif self._exponent == 1:\n            self._result = self._base\n        elif self._base == 1:\n            self._result = 1.0\n        else:\n            current_result = 1.0\n            for _ in range(int(self._exponent)):\n                current_result *= self._base\n            self._result = current_result\n        return self._result\n\n    def get_result(self) -> float:\n        \"\"\"\n        Returns the calculated result.\n        \"\"\"\n        return self._result\n\ndef power(a: float, b: float) -> float:\n    \"\"\"\n    Calculates 'a' raised to the power 'b' by delegating to PowerCalculation.\n    \"\"\"\n    calculator = PowerCalculation(a, b)\n    return calculator.calculatePower()"}
{"task_id": "Mbpp/95", "solution": "import math\nfrom typing import List, Any\n\ndef Find_Min_Length(list_of_lists: List[List[Any]]) -> int:\n    \"\"\"\n    Finds the length of the smallest list in a list of lists.\n    Returns math.inf if the input list_of_lists is empty.\n    \"\"\"\n    if not list_of_lists:\n        return math.inf\n\n    lengths = [len(inner_list) for inner_list in list_of_lists]\n    return min(lengths)"}
