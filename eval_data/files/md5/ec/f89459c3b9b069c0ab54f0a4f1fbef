{"task_id": "Mbpp/82", "solution": "import math\n\ndef volume_sphere(radius: float) -> float:\n    \"\"\"\n    Calculates the volume of a sphere given its radius using the formula V = (4/3)\u03c0r\u00b3.\n    It uses math.pi for the constant \u03c0.\n    \"\"\"\n    return (4/3) * math.pi * (radius**3)"}
{"task_id": "Mbpp/84", "solution": "def sequence(n: int) -> int:\n    \"\"\"\n    Calculates the nth number of the Newman-Conway sequence using dynamic programming.\n    The sequence is defined as P(1)=1, P(2)=1, and P(n) = P(P(n-1)) + P(n - P(n-1)) for n > 2.\n    \"\"\"\n    if n == 1:\n        return 1\n    if n == 2:\n        return 1\n\n    # p_values[i] will store the (i)th Newman-Conway number.\n    # We use a 1-based index for convenience, so p_values[0] is unused.\n    p_values = [0] * (n + 1)\n    p_values[1] = 1\n    p_values[2] = 1\n\n    for i in range(3, n + 1):\n        p_values[i] = p_values[p_values[i - 1]] + p_values[i - p_values[i - 1]]\n\n    return p_values[n]"}
{"task_id": "Mbpp/77", "solution": "def is_Diff(number: int) -> bool:\n    \"\"\"\n    Determines if a given number is divisible by 11.\n    The check is based on the alternating sum of its digits.\n    \"\"\"\n    number_str = str(abs(number))\n    alternating_sum = 0\n    for i, digit_char in enumerate(reversed(number_str)):\n        digit = int(digit_char)\n        if i % 2 == 0:  # Odd positions from the right (0-indexed) are added\n            alternating_sum += digit\n        else:  # Even positions from the right (0-indexed) are subtracted\n            alternating_sum -= digit\n    return alternating_sum % 11 == 0"}
{"task_id": "Mbpp/74", "solution": "import collections\n\nclass PatternMapping:\n    \"\"\"\n    Encapsulates the logic for managing bidirectional one-to-one mapping between elements.\n    Ensures consistency for forward and backward mappings.\n    \"\"\"\n    def __init__(self):\n        self._forward_map = {}\n        self._backward_map = {}\n\n    def establish_or_verify_mapping(self, element1: str, element2: str) -> bool:\n        \"\"\"\n        Establishes a new mapping or verifies an existing one for a pair of elements.\n        Returns True if consistent, False otherwise.\n        \"\"\"\n        # Case 1: element1 already in _forward_map\n        if element1 in self._forward_map:\n            if self._forward_map[element1] != element2:\n                return False\n        # Case 2: element2 already in _backward_map\n        if element2 in self._backward_map:\n            if self._backward_map[element2] != element1:\n                return False\n\n        # Case 3: Neither element has an existing mapping or existing mappings are consistent\n        self._forward_map[element1] = element2\n        self._backward_map[element2] = element1\n        return True\n\ndef is_samepatterns(sequence1: list[str], sequence2: list[str]) -> bool:\n    \"\"\"\n    Checks if two input sequences follow the same pattern based on a consistent one-to-one element mapping.\n    \"\"\"\n    if len(sequence1) != len(sequence2):\n        return False\n\n    pattern_mapper = PatternMapping()\n\n    for i in range(len(sequence1)):\n        if not pattern_mapper.establish_or_verify_mapping(sequence1[i], sequence2[i]):\n            return False\n\n    return True"}
