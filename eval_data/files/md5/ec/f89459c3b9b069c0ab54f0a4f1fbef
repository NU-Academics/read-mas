{"task_id": "Mbpp/66", "solution": "def pos_count(numbers: list) -> int:\n    \"\"\"\n    Counts the number of positive numbers in a given list.\n    A number is considered positive if its value is strictly greater than zero.\n    \"\"\"\n    positive_numbers_count = 0\n    for number in numbers:\n        if number > 0:\n            positive_numbers_count += 1\n    return positive_numbers_count"}
{"task_id": "Mbpp/63", "solution": "from typing import List, Tuple, Union\n\nclass Pair:\n    \"\"\"Represents a single pair of numerical values.\"\"\"\n    def __init__(self, val1: Union[int, float], val2: Union[int, float]):\n        if not isinstance(val1, (int, float)) or not isinstance(val2, (int, float)):\n            raise ValueError(\"Pair values must be numerical.\")\n        self.value1 = val1\n        self.value2 = val2\n\nclass TupleListProcessor:\n    \"\"\"Processes a list of Pair objects to find the maximum absolute difference.\"\"\"\n    def __init__(self, input_tuples: List[Tuple[Union[int, float], Union[int, float]]]):\n        if not isinstance(input_tuples, list):\n            raise TypeError(\"Input must be a list.\")\n\n        self._pairs: List[Pair] = []\n        for i, tpl in enumerate(input_tuples):\n            if not isinstance(tpl, tuple) or len(tpl) != 2:\n                raise ValueError(f\"Element at index {i} is not a tuple of two elements: {tpl}\")\n            try:\n                self._pairs.append(Pair(tpl[0], tpl[1]))\n            except ValueError as e:\n                raise ValueError(f\"Invalid numerical values in tuple at index {i}: {tpl}. {e}\")\n\n    def findMaxDifference(self) -> Union[int, float]:\n        \"\"\"Computes and returns the maximum absolute difference (FR2, FR3, FR4).\"\"\"\n        if not self._pairs:\n            return 0.0\n\n        max_diff = 0.0\n        for pair in self._pairs:\n            diff = abs(pair.value1 - pair.value2)\n            if diff > max_diff:\n                max_diff = diff\n        return max_diff\n\ndef max_difference(tuple_list: List[Tuple[Union[int, float], Union[int, float]]]) -> Union[int, float]:\n    \"\"\"\n    Finds the maximum absolute difference between available pairs in the given tuple list.\n    Returns the largest absolute difference found, or 0.0 if the input list is empty.\n    \"\"\"\n    processor = TupleListProcessor(tuple_list)\n    return processor.findMaxDifference()"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(input_list: list) -> (int | float):\n    \"\"\"\n    Flattens a nested list and sums all its numeric elements.\n\n    Args:\n        input_list: The list to be flattened and summed. Can contain numbers and other lists.\n\n    Returns:\n        The total sum of all numeric elements in the flattened list.\n    \"\"\"\n    total_sum = 0\n    for item in input_list:\n        if isinstance(item, list):\n            total_sum += recursive_list_sum(item)\n        elif isinstance(item, (int, float)):\n            total_sum += item\n    return total_sum"}
{"task_id": "Mbpp/67", "solution": "import math\nfrom typing import Dict\n\n_bell_cache: Dict[int, int] = {0: 1}\n\ndef _combinations(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient 'n choose k'.\"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n    return math.comb(n, k)\n\ndef bell_number(n: int) -> int:\n    \"\"\"Calculates the n-th Bell number B(n) using a recurrence relation and memoization.\"\"\"\n    if n in _bell_cache:\n        return _bell_cache[n]\n\n    if n == 0:\n        return 1\n\n    result = 0\n    for k in range(n):\n        term = _combinations(n - 1, k) * bell_number(k)\n        result += term\n\n    _bell_cache[n] = result\n    return result"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list: list, sub_list: list) -> bool:\n    \"\"\"\n    Checks if `sub_list` is a contiguous sublist of `main_list`.\n    Returns True if `sub_list` is found contiguously and in order within `main_list`, False otherwise.\n    \"\"\"\n    if not sub_list:\n        return True\n    if len(sub_list) > len(main_list):\n        return False\n\n    for i in range(len(main_list) - len(sub_list) + 1):\n        if main_list[i : i + len(sub_list)] == sub_list:\n            return True\n    return False"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(input_list: list) -> list:\n    \"\"\"\n    Sorts a list of elements in ascending order using the Comb Sort algorithm.\n    The Comb Sort algorithm is an improvement over Bubble Sort and the original input list is not modified.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    # Create a mutable copy to avoid modifying the original list\n    arr = input_list[:]\n    n = len(arr)\n\n    if n <= 1:\n        return arr\n\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        if gap > 1:\n            gap = int(gap / shrink_factor)\n            if gap < 1:\n                gap = 1\n\n        swapped = False\n        i = 0\n        while i + gap < n:\n            try:\n                if arr[i] > arr[i + gap]:\n                    arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                    swapped = True\n            except TypeError as e:\n                raise TypeError(f\"Elements in the list are not comparable: {e}\") from e\n            i += 1\n\n    return arr"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array: list) -> bool:\n    \"\"\"\n    Checks if the given array is monotonic (either entirely increasing or entirely decreasing).\n    An array with less than two elements is considered monotonic.\n    \"\"\"\n    if len(array) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(1, len(array)):\n        if array[i] < array[i-1]:\n            is_increasing = False\n        if array[i] > array[i-1]:\n            is_decreasing = False\n\n    return is_increasing or is_decreasing"}
{"task_id": "Mbpp/70", "solution": "def get_equal(list_of_tuples: list[tuple]) -> bool:\n    \"\"\"\n    Determines if all tuples in the given list have equal length.\n    Returns True if the list is empty, contains only one tuple, or if all tuples have identical lengths.\n    \"\"\"\n    if not list_of_tuples or len(list_of_tuples) == 1:\n        return True\n\n    first_tuple_length = len(list_of_tuples[0])\n    for i in range(1, len(list_of_tuples)):\n        if len(list_of_tuples[i]) != first_tuple_length:\n            return False\n\n    return True"}
