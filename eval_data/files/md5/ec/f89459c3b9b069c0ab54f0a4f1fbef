{"task_id": "Mbpp/8", "solution": "def square_nums(numbers: list[float | int]) -> list[float | int]:\n    \"\"\"\n    Calculates the square of each number in the input list.\n    Returns a new list containing the square of each corresponding input number.\n    \"\"\"\n    return [num * num for num in numbers]"}
{"task_id": "Mbpp/6", "solution": "def _count_set_bits(n: int) -> int:\n    \"\"\"\n    Counts the number of set bits (1s) in a non-negative integer.\n    \"\"\"\n    count = 0\n    while n != 0:\n        n &= (n - 1)\n        count += 1\n    return count\n\ndef differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks whether two numbers differ at exactly one bit position.\n    \"\"\"\n    xor_result = num1 ^ num2\n    set_bit_count = _count_set_bits(xor_result)\n    return set_bit_count == 1"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(input_string: str) -> int:\n    \"\"\"\n    Calculates the minimum number of rotations (greater than 0)\n    required for the input string to return to its original form.\n    \"\"\"\n    n = len(input_string)\n    if n == 0:\n        return 0\n\n    for rotations in range(1, n + 1):\n        rotated_string = input_string[rotations:] + input_string[:rotations]\n        if rotated_string == input_string:\n            return rotations"}
{"task_id": "Mbpp/7", "solution": "def find_char_long(text: str, min_length: int = 4) -> list[str]:\n    \"\"\"\n    Finds all words in a string that are at least 'min_length' characters long.\n    Words are separated by spaces.\n    \"\"\"\n    if not text:\n        return []\n\n    words = text.split(' ')\n    filtered_words = [word for word in words if len(word) >= min_length]\n\n    return filtered_words"}
{"task_id": "Mbpp/3", "solution": "import math\n\ndef is_not_prime(n: int) -> bool:\n    \"\"\"\n    Determines if an integer n is a non-prime number.\n    Returns True if n is non-prime, False otherwise (prime or <= 1).\n    \"\"\"\n    if n <= 1:\n        return False\n    # Check for divisors from 2 up to the square root of n.\n    for i in range(2, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            return True # Found a divisor, so n is not prime\n    return False # No divisors found, so n is prime"}
{"task_id": "Mbpp/4", "solution": "import heapq\n\ndef _find_and_sort_largest(list_of_numbers: list, n: int) -> list:\n    \"\"\"Finds the 'n' largest numbers using a heap and returns them in descending order.\"\"\"\n    return heapq.nlargest(n, list_of_numbers)\n\ndef heap_queue_largest(list_of_numbers: list, n: int) -> list:\n    \"\"\"\n    Finds the n largest integers from a given list of numbers, returned in descending order.\n    This function assumes valid inputs as per problem constraints.\n    \"\"\"\n    return _find_and_sort_largest(list_of_numbers, n)"}
{"task_id": "Mbpp/2", "solution": "from typing import Iterable, Any, Set\n\ndef similar_elements(list1: Iterable[Any], list2: Iterable[Any]) -> Set[Any]:\n    \"\"\"\n    Finds unique elements common to both input iterables.\n    Converts inputs to sets for efficient intersection.\n    \"\"\"\n    set1 = set(list1)\n    set2 = set(list2)\n    return set1.intersection(set2)"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, char_to_remove: str) -> str:\n    \"\"\"Removes the first and last occurrence of a given character from the string.\n    If the character appears fewer than two times, the original string is returned.\n    \"\"\"\n    first_index = input_string.find(char_to_remove)\n    last_index = input_string.rfind(char_to_remove)\n\n    # If the specified character appears fewer than two times, no characters shall be removed.\n    # This covers cases where char is not found or found only once.\n    if first_index == -1 or first_index == last_index:\n        return input_string\n\n    # Construct the new string by slicing, excluding first and last occurrences.\n    result_string = (\n        input_string[:first_index] +\n        input_string[first_index + 1:last_index] +\n        input_string[last_index + 1:]\n    )\n\n    return result_string"}
{"task_id": "Mbpp/14", "solution": "def find_Volume(base, height, length):\n    \"\"\"\n    Calculates the volume of a triangular prism.\n    Assumes all inputs are positive numerical values.\n    \"\"\"\n    area_of_triangle = 0.5 * base * height\n    volume = area_of_triangle * length\n    return volume"}
{"task_id": "Mbpp/12", "solution": "def sort_matrix(matrix: list[list[int | float]]) -> list[list[int | float]]:\n    \"\"\"Sorts a matrix by the sum of its rows in ascending order.\n\n    Args:\n        matrix: A list of lists of numbers (int or float).\n\n    Returns:\n        A new matrix with rows sorted by their sums.\n    \"\"\"\n\n    def _get_row_sum(row: list[int | float]) -> int | float:\n        \"\"\"Calculates the sum of elements in a single row.\"\"\"\n        return sum(row)\n\n    # Pair each row with its sum\n    rows_with_sums = []\n    for row in matrix:\n        row_sum = _get_row_sum(row)\n        rows_with_sums.append((row_sum, row))\n\n    # Sort based on the row sum\n    rows_with_sums.sort(key=lambda x: x[0])\n\n    # Extract the sorted rows\n    sorted_matrix = [row for _, row in rows_with_sums]\n\n    return sorted_matrix"}
{"task_id": "Mbpp/17", "solution": "def square_perimeter(side_length: float) -> float:\n    \"\"\"Calculates the perimeter of a square.\n\n    Raises ValueError if side_length is negative.\n    \"\"\"\n    if side_length < 0:\n        raise ValueError(\"Side length cannot be negative.\")\n    return side_length * 4"}
{"task_id": "Mbpp/16", "solution": "import re\n\ndef text_lowercase_underscore(input_string: str) -> bool:\n    \"\"\"\n    Checks if the input string contains sequences of lowercase letters joined by an underscore.\n    Returns True if a match is found, False otherwise.\n    \"\"\"\n    pattern = r\"[a-z]+_[a-z]+\"\n    return bool(re.search(pattern, input_string))"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is a Woodall number.\n    A Woodall number is of the form n * 2^n - 1 for some natural number n (n >= 1).\n    \"\"\"\n    if number < 1:\n        return False\n\n    n = 1\n    while True:\n        current_woodall = n * (2**n) - 1\n        if current_woodall == number:\n            return True\n        elif current_woodall > number:\n            return False\n        n += 1"}
{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(primary_string: str, character_set_string: str) -> str:\n    \"\"\"Removes characters from the first string which are present in the second string.\"\"\"\n    chars_to_remove = set(character_set_string)\n    result_chars = []\n    for char in primary_string:\n        if char not in chars_to_remove:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/19", "solution": "def test_duplicate(arr: list[int]) -> bool:\n    \"\"\"\n    Checks if the given array of integers contains any duplicate elements.\n    Returns True if duplicates are found, False otherwise.\n    \"\"\"\n    seen = set()\n    for item in arr:\n        if item in seen:\n            return True\n        seen.add(item)\n    return False"}
{"task_id": "Mbpp/56", "solution": "def _calculate_reverse(number: int) -> int:\n    \"\"\"\n    Calculates the integer reverse of a given number.\n    Handles single-digit numbers and numbers ending in zero.\n    \"\"\"\n    is_negative = number < 0\n    num_str = str(abs(number))\n    reversed_str = num_str[::-1]\n    reversed_int = int(reversed_str)\n    return -reversed_int if is_negative else reversed_int\n\ndef check(number: int) -> bool:\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    The number N must satisfy the property N = (2 * Reverse(N)) - 1.\n    \"\"\"\n    reversed_number = _calculate_reverse(number)\n    return number == (2 * reversed_number) - 1"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"Counts substrings in 's' where the sum of digits equals the substring's length.\n\n    Iterates through all possible substrings and checks the condition.\n    \"\"\"\n    count = 0\n    n = len(s)\n\n    for i in range(n):\n        current_sum = 0\n        for j in range(i, n):\n            # The substring is s[i:j+1]\n            # Its length is (j + 1) - i\n            current_sum += int(s[j])\n            if current_sum == (j - i + 1):\n                count += 1\n    return count"}
{"task_id": "Mbpp/58", "solution": "def opposite_Signs(int1, int2):\n    \"\"\"\n    Checks if two integers have opposite signs.\n    Returns True if one is positive and the other is negative, False otherwise.\n    \"\"\"\n    return (int1 > 0 and int2 < 0) or (int1 < 0 and int2 > 0)"}
{"task_id": "Mbpp/57", "solution": "import functools\n\ndef find_Max_Num(digits: list[int]) -> int:\n    \"\"\"Arranges a list of digits to form the largest possible numerical value.\n\n    Args:\n        digits: A list of integers, where each integer represents a digit (0-9) or a number.\n\n    Returns:\n        The largest possible numerical value as an integer.\n    \"\"\"\n    # Convert all digits/numbers to their string representations for custom sorting.\n    str_digits = [str(d) for d in digits]\n\n    # Handle the case of an empty input list by returning 0.\n    if not str_digits:\n        return 0\n\n    # Define a custom comparison function for sorting.\n    # It determines the order of two string digits 'a' and 'b' by comparing 'a+b' and 'b+a'.\n    def compare_digits_as_strings(a, b):\n        if int(a + b) > int(b + a):\n            return -1  # 'a' should come before 'b'\n        elif int(a + b) < int(b + a):\n            return 1   # 'b' should come before 'a'\n        else:\n            return 0   # 'a' and 'b' are equivalent in order\n\n    # Sort the string digits using the custom comparison.\n    # functools.cmp_to_key adapts a comparison function (like old-style cmp) to a key function.\n    sorted_str_digits = sorted(str_digits, key=functools.cmp_to_key(compare_digits_as_strings))\n\n    # Join the sorted digit strings to form the largest number string.\n    largest_num_str = \"\".join(sorted_str_digits)\n\n    # Convert the resulting string to an integer. `int()` handles leading zeros appropriately.\n    return int(largest_num_str)"}
{"task_id": "Mbpp/59", "solution": "def is_octagonal(n):\n    \"\"\"Calculates the nth octagonal number.\n    The formula used is n * (3n - 2).\n    \"\"\"\n    return n * (3 * n - 2)"}
{"task_id": "Mbpp/62", "solution": "def smallest_num(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the smallest number in a list of integers.\n    Assumes the input list is non-empty and contains comparable numerical values.\n    \"\"\"\n    min_value = numbers[0]\n    for num in numbers:\n        if num < min_value:\n            min_value = num\n    return min_value"}
