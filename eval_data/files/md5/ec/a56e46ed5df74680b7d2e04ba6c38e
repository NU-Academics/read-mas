{"task_id": "HumanEval/0", "solution": "from __future__ import annotations\n\nfrom typing import List\n\n__all__ = [\"has_close_elements\"]\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"\n    Determine if any two distinct numbers in ``numbers`` are closer to each other\n    than ``threshold``.\n\n    The algorithm first sorts the input list, then only adjacent elements\n    need to be checked, giving *O(n log n)* time complexity and *O(1)*\n    additional space when the input is sorted in place.\n\n    Parameters\n    ----------\n    numbers : List[float]\n        A sequence of numeric values to examine. The list may contain duplicates.\n    threshold : float\n        The maximum allowed distance between two numbers to be considered\n        \"close\".\n\n    Returns\n    -------\n    bool\n        ``True`` if any two distinct numbers are separated by less than\n        ``threshold``; otherwise ``False``.\n\n    Raises\n    ------\n    ValueError\n        If ``threshold`` is negative. A negative threshold has no meaningful\n        interpretation for distance comparison.\n\n    Notes\n    -----\n    - The function treats any pair ``(a, b)`` with `a != b` as a candidate.\n      If the list contains duplicate values and `threshold > 0`,\n      the function will always return ``True`` because the distance between\n      identical numbers is zero.\n    - For an empty list or a single-element list the result is ``False`` as\n      there are no pairs to compare.\n\n    Examples\n    --------\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if threshold < 0:\n        raise ValueError(\"threshold must be non\u2011negative\")\n\n    if len(numbers) < 2:\n        return False\n\n    # Work with a sorted copy to avoid mutating the caller's list\n    sorted_numbers = sorted(numbers)\n\n    for i in range(1, len(sorted_numbers)):\n        if abs(sorted_numbers[i] - sorted_numbers[i - 1]) < threshold:\n            return True\n\n    return False\n"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Input to this function is a string containing multiple groups of nested parentheses.\n    Separate those groups into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other.\n    Ignore any spaces in the input string.\n    \n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    groups: List[str] = []\n    current: List[str] = []\n    depth = 0\n\n    for ch in paren_string:\n        if ch == \" \":\n            continue\n        if ch == \"(\":\n            depth += 1\n            current.append(ch)\n        elif ch == \")\":\n            depth -= 1\n            current.append(ch)\n            if depth == 0:\n                groups.append(\"\".join(current))\n                current = []\n        else:\n            # Unexpected character: ignore or raise error\n            continue\n\n    return groups"}
{"task_id": "HumanEval/2", "solution": "# src/domain/policy.py\nfrom enum import Enum\n\nclass TruncationPolicy(Enum):\n    BEFORE_DECIMAL = \"before_decimal\"\n    AFTER_DECIMAL   = \"after_decimal\"\n    SIGNIFICANT     = \"significant_digits\"\n\n# src/domain/exceptions.py\nclass TruncationServiceError(Exception):\n    \"\"\"Base exception for the truncation service.\"\"\"\n    pass\n\nclass InvalidNumberError(TruncationServiceError):\n    \"\"\"Raised when a value cannot be converted to a Decimal number.\"\"\"\n    pass\n\nclass UnsupportedPolicyError(TruncationServiceError):\n    \"\"\"Raised when an unsupported truncation policy is provided.\"\"\"\n    pass\n\nclass InvalidPrecisionError(TruncationServiceError):\n    \"\"\"Raised when the precision value is invalid.\"\"\"\n    pass\n\n# src/domain/strategy.py\nfrom abc import ABC, abstractmethod\nfrom decimal import Decimal\nfrom domain.policy import TruncationPolicy\nfrom domain.exceptions import UnsupportedPolicyError, InvalidPrecisionError\n\nclass TruncationStrategy(ABC):\n    @abstractmethod\n    def truncate(self, value: Decimal, precision: int) -> Decimal:\n        \"\"\"Trims the given Decimal value to the specified precision.\"\"\"\n        ...\n\nclass BeforeDecimalStrategy(TruncationStrategy):\n    def truncate(self, value: Decimal, precision: int) -> Decimal:\n        \"\"\"\n        Trims digits before the decimal point to the given length.\n        Example: 1234.56, precision=2 -> 34.56\n                 1234.56, precision=0 -> 0.56\n        \"\"\"\n        if precision < 0:\n            raise InvalidPrecisionError(\"Precision for BEFORE_DECIMAL must be non-negative.\")\n        return value % (Decimal(10) ** precision)\n\nclass AfterDecimalStrategy(TruncationStrategy):\n    def truncate(self, value: Decimal, precision: int) -> Decimal:\n        \"\"\"\n        Trims digits after the decimal point to the given length.\n        Example: 123.456, precision=2 -> 123.45\n        \"\"\"\n        if precision < 0:\n            raise InvalidPrecisionError(\"Precision for AFTER_DECIMAL must be non-negative.\")\n        return value.quantize(Decimal(10) ** -precision, rounding=Decimal.ROUND_DOWN)\n\nclass SignificantDigitsStrategy(TruncationStrategy):\n    def truncate(self, value: Decimal, precision: int) -> Decimal:\n        \"\"\"\n        Retains the specified number of significant digits overall.\n        Example: 123.456, precision=3 -> 123\n                 0.0012345, precision=3 -> 0.00123\n        \"\"\"\n        if precision <= 0:\n            raise InvalidPrecisionError(\"Precision for SIGNIFICANT_DIGITS must be positive.\")\n        if value == Decimal('0'):\n            return Decimal('0')\n        adjusted_exponent = value.adjusted()\n        target_quantizer_exponent = adjusted_exponent - (precision - 1)\n        quantizer = Decimal('1E') ** target_quantizer_exponent\n        return value.quantize(quantizer, rounding=Decimal.ROUND_DOWN)\n\nclass StrategyFactory:\n    def create(self, policy: TruncationPolicy) -> TruncationStrategy:\n        \"\"\"Factory method to create a concrete TruncationStrategy based on the policy.\"\"\"\n        if policy == TruncationPolicy.BEFORE_DECIMAL:\n            return BeforeDecimalStrategy()\n        if policy == TruncationPolicy.AFTER_DECIMAL:\n            return AfterDecimalStrategy()\n        if policy == TruncationPolicy.SIGNIFICANT:\n            return SignificantDigitsStrategy()\n        raise UnsupportedPolicyError(f\"Unsupported truncation policy: {policy.value}\")\n\n# src/domain/models.py\nfrom decimal import Decimal, InvalidOperation\nfrom typing import Union\nfrom domain.exceptions import InvalidNumberError\n\nclass Number:\n    \"\"\"\n    Encapsulates a numeric value using Python's Decimal type for precise arithmetic.\n    Instances are immutable and thread-safe.\n    \"\"\"\n    def __init__(self, value: Union[str, int, float, Decimal]):\n        try:\n            self._value = Decimal(str(value))\n        except InvalidOperation as e:\n            raise InvalidNumberError(f\"Cannot convert '{value}' to a Decimal number.\") from e\n\n    @property\n    def value(self) -> Decimal:\n        \"\"\"Returns the underlying Decimal value.\"\"\"\n        return self._value\n\n    def to_str(self) -> str:\n        \"\"\"\n        Converts the Decimal value to a string representation.\n        Uses '.6g' format specifier, which means general format,\n        rounded to 6 significant digits.\n        \"\"\"\n        return format(self._value, \".6g\")\n\n    def __str__(self) -> str:\n        return str(self._value)\n\n    def __repr__(self) -> str:\n        return f\"Number(value='{self._value}')\"\n\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, Number):\n            return NotImplemented\n        return self._value == other._value\n\n    def __hash__(self) -> int:\n        return hash(self._value)\n\n# src/application/validators.py\nfrom domain.exceptions import InvalidPrecisionError\n\ndef validate_precision(precision: int):\n    \"\"\"\n    Validates that the precision value is an integer.\n    Specific strategies handle additional constraints (e.g., >0 for SIGNIFICANT).\n    \"\"\"\n    if not isinstance(precision, int):\n        raise InvalidPrecisionError(\"Precision must be an integer.\")\n    # Strategies will handle non-negative or positive constraints specific to their logic.\n\n# src/application/services.py\nfrom domain.policy import TruncationPolicy\nfrom domain.strategy import StrategyFactory, TruncationStrategy\nfrom domain.models import Number\nfrom application.validators import validate_precision\nfrom infrastructure.logger import Logger\nfrom domain.exceptions import TruncationServiceError\n\nclass TruncationService:\n    \"\"\"\n    Orchestrates the truncation process. It validates input,\n    selects the appropriate truncation strategy via a factory,\n    and returns a new immutable Number object.\n    \"\"\"\n    def __init__(self, factory: StrategyFactory, logger: Logger = None):\n        self._factory = factory\n        self._logger = logger if logger else Logger()\n\n    def truncate(self, number: Number, policy: TruncationPolicy, precision: int) -> Number:\n        \"\"\"\n        Truncates a given number based on the specified policy and precision.\n\n        Args:\n            number: The Number entity to be truncated.\n            policy: The TruncationPolicy enum indicating the truncation mode.\n            precision: An integer representing the precision for truncation.\n\n        Returns:\n            A new Number entity with the truncated value.\n\n        Raises:\n            InvalidPrecisionError: If the precision is not valid for the given policy.\n            UnsupportedPolicyError: If the policy is not recognized.\n            InvalidNumberError: If the input number value is invalid (raised by Number constructor).\n            TruncationServiceError: For any other unexpected errors during truncation.\n        \"\"\"\n        self._logger.log_info(\n            f\"Attempting to truncate number {number.value} with policy {policy.value} and precision {precision}\"\n        )\n        validate_precision(precision)\n        try:\n            strategy: TruncationStrategy = self._factory.create(policy)\n            truncated_value = strategy.truncate(number.value, precision)\n            result_number = Number(truncated_value)\n            self._logger.log_info(f\"Successfully truncated to: {result_number.value}\")\n            return result_number\n        except TruncationServiceError:\n            raise\n        except Exception as e:\n            self._logger.log_error(f\"Unexpected error during truncation: {e}\")\n            raise TruncationServiceError(f\"An unexpected error occurred during truncation: {e}\") from e\n\n# src/infrastructure/logger.py\nimport logging\n\nlogging.basicConfig(level=logging.INFO, format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n\nclass Logger:\n    \"\"\"A simple wrapper for Python's logging module, providing basic info and error logging.\"\"\"\n    def __init__(self, name: str = \"truncate_service\"):\n        self._logger = logging.getLogger(name)\n\n    def log_info(self, msg: str):\n        \"\"\"Logs an informational message.\"\"\"\n        self._logger.info(msg)\n\n    def log_warning(self, msg: str):\n        \"\"\"Logs a warning message.\"\"\"\n        self._logger.warning(msg)\n\n    def log_error(self, msg: str):\n        \"\"\"Logs an error message.\"\"\"\n        self._logger.error(msg)\n\n    def log_debug(self, msg: str):\n        \"\"\"Logs a debug message.\"\"\"\n        self._logger.debug(msg)\n\n# src/api/truncate.py\nfrom application.services import TruncationService\nfrom domain.models import Number\nfrom domain.policy import TruncationPolicy\nfrom domain.strategy import StrategyFactory\nfrom infrastructure.logger import Logger\nfrom decimal import Decimal\n\n_strategy_factory = StrategyFactory()\n_logger = Logger()\n_truncation_service = TruncationService(factory=_strategy_factory, logger=_logger)\n\ndef truncate(value: str | int | float | Decimal, policy: TruncationPolicy, precision: int) -> Number:\n    \"\"\"\n    Public API function to truncate a numeric value based on a given policy and precision.\n\n    This function serves as the entry point for clients, handling initial\n    conversion to the domain's Number object and delegating to the\n    TruncationService.\n\n    Args:\n        value: The numeric value to truncate (can be string, int, float, or Decimal).\n        policy: The TruncationPolicy enum (BEFORE_DECIMAL, AFTER_DECIMAL, SIGNIFICANT).\n        precision: The integer precision to apply.\n\n    Returns:\n        A Number object containing the truncated Decimal value.\n\n    Raises:\n        InvalidNumberError: If the input 'value' cannot be parsed into a Decimal.\n        InvalidPrecisionError: If the 'precision' is invalid for the chosen policy.\n        UnsupportedPolicyError: If the 'policy' is not recognized.\n        TruncationServiceError: Base exception for any other unexpected errors during truncation.\n    \"\"\"\n    _logger.log_info(f\"API call received: value='{value}', policy='{policy.value}', precision={precision}\")\n    num = Number(value)\n    return _truncation_service.truncate(num, policy, precision)"}
