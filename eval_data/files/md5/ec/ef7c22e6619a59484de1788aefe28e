{"task_id": "Mbpp/74", "solution": "import collections\nfrom typing import List, Any, Dict\nclass Sequence:\n    \"\"\"Wrapper for the sequence input, providing length and indexed access.\"\"\"\n    def __init__(self, elements: List[Any]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\n\n    def __getitem__(self, index: int) -> Any:\n        return self.elements[index]\nclass Pattern:\n    \"\"\"Wrapper for the pattern input, providing length and indexed access.\"\"\"\n    def __init__(self, tokens: List[Any]) -> None:\n        self.tokens = tokens\n\n    def length(self) -> int:\n        return len(self.tokens)\n\n    def __getitem__(self, index: int) -> Any:\n        return self.tokens[index]\nclass Mapping:\n    \"\"\"Maintains bidirectional mapping between sequence elements and pattern tokens.\"\"\"\n    def __init__(self) -> None:\n        self.elementToToken: Dict[Any, Any] = {}\n        self.tokenToElement: Dict[Any, Any] = {}\n\n    def addMapping(self, element: Any, token: Any) -> bool:\n        \"\"\"Adds mapping; returns False if a conflict exists, True otherwise.\"\"\"\n        # Check element->token consistency\n        if element in self.elementToToken and self.elementToToken[element] != token:\n            return False\n        # Check token->element consistency\n        if token in self.tokenToElement and self.tokenToElement[token] != element:\n            return False\n\n        self.elementToToken[element] = token\n        self.tokenToElement[token] = element\n        return True\n\n    def consistent(self, element: Any, token: Any) -> bool:\n        \"\"\"Returns True if existing mapping(s) are consistent (or absent).\"\"\"\n        if element in self.elementToToken and self.elementToToken[element] != token:\n            return False\n        if token in self.tokenToElement and self.tokenToElement[token] != element:\n            return False\n        return True\nclass Validator:\n    \"\"\"Orchestrates validation, checks lengths, iterates positions, and uses Mapping.\"\"\"\n    def __init__(self) -> None:\n        self._mapping: Mapping = Mapping()\n\n    def is_samepatterns(self, seq: Sequence, pattern: Pattern) -> bool:\n        \"\"\"Checks lengths, iterates indices, checks/adds mappings, and returns final boolean.\"\"\"\n        if not self._validate_lengths(seq, pattern):\n            return False\n\n        for i in range(seq.length()):\n            if not self._validate_pair(i, seq, pattern):\n                return False\n        return True\n\n    def _validate_lengths(self, seq: Sequence, pattern: Pattern) -> bool:\n        \"\"\"Returns False if lengths differ.\"\"\"\n        return seq.length() == pattern.length()\n\n    def _validate_pair(self, index: int, seq: Sequence, pattern: Pattern) -> bool:\n        \"\"\"Evaluates pair at index using Mapping.consistent and Mapping.addMapping.\"\"\"\n        element = seq[index]\n        token = pattern[index]\n\n        if not self._mapping.consistent(element, token):\n            return False\n        \n        # If consistent or new, add the mapping\n        return self._mapping.addMapping(element, token)\ndef is_samepatterns(seq: List[Any], pattern: List[Any]) -> bool:\n    \"\"\"\n    Checks whether the sequence follows the given pattern.\n    Applies bijective consistency for element-to-token and token-to-element mappings.\n    \"\"\"\n    seq_obj = Sequence(seq)\n    pattern_obj = Pattern(pattern)\n    validator = Validator()\n    return validator.is_samepatterns(seq_obj, pattern_obj)"}
{"task_id": "Mbpp/79", "solution": "class Word:\n    \"\"\"Represents a word and provides its length.\"\"\"\n    def __init__(self, text: str):\n        self.text: str = text\n    def length(self) -> int:\n        \"\"\"Returns the length of the word's text.\"\"\"\n        return len(self.text)\nclass WordLengthChecker:\n    \"\"\"Determines if a word's length is odd.\"\"\"\n    def word_len(self, word: str) -> bool:\n        \"\"\"Checks if the length of the given word is odd.\"\"\"\n        w = Word(text=word)\n        n = w.length()\n        is_odd = (n % 2 == 1)\n        return is_odd\ndef word_len(word: str) -> bool:\n    \"\"\"Checks whether the length of the word is odd.\n    Returns True if the length is odd, False otherwise.\n    \"\"\"\n    checker = WordLengthChecker()\n    return checker.word_len(word)"}
