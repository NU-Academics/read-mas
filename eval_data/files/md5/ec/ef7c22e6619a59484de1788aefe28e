{"task_id": "Mbpp/585", "solution": "from typing import List, Mapping, Optional\nfrom collections.abc import Iterable\ndef _is_mapping(obj: object) -> bool:\n    \"\"\"Detect whether obj supports mapping-like access.\"\"\"\n    return isinstance(obj, Mapping)\ndef _parse_price(value: object) -> Optional[float]:\n    \"\"\"Convert value to float for price comparison, or return None if non-numeric.\"\"\"\n    if isinstance(value, (int, float)):\n        return float(value)\n    if isinstance(value, str):\n        try:\n            return float(value)\n        except ValueError:\n            return None\n    return None\ndef _filter_valid_items(dataset: Iterable[Mapping]) -> List[Mapping]:\n    \"\"\"Return a list of item mappings with 'name' and numeric 'price'.\"\"\"\n    valid_items = []\n    for item in dataset:\n        if not _is_mapping(item):\n            continue\n\n        name = item.get('name')\n        if not name:\n            continue\n\n        price_value = item.get('price')\n        price = _parse_price(price_value)\n        if price is None:\n            continue\n\n        valid_items.append(item)\n    return valid_items\ndef _sort_items_desc(items: List[Mapping]) -> List[Mapping]:\n    \"\"\"Return a new list sorted by numeric price in descending order.\"\"\"\n    return sorted(items, key=lambda item: _parse_price(item.get('price')) or -float('inf'), reverse=True)\ndef _select_top_n(items: List[Mapping], n: int) -> List[Mapping]:\n    \"\"\"Return a new list with up to n items from the start of the list.\"\"\"\n    return items[:n]\ndef expensive_items(dataset: Iterable[Mapping], n: int) -> List[Mapping]:\n    \"\"\"Find the n most expensive items in a dataset.\"\"\"\n    _validate_inputs(dataset, n)\n\n    if n == 0:\n        return []\n\n    valid_items = _filter_valid_items(dataset)\n\n    if not valid_items:\n        return []\n\n    sorted_items = _sort_items_desc(valid_items)\n\n    result = _select_top_n(sorted_items, n)\n    return result"}
{"task_id": "Mbpp/589", "solution": "import math\nfrom typing import List\ndef perfect_squares(start: int, end: int) -> List[int]:\n    \"\"\"\n    Finds perfect squares within a given inclusive range [start, end].\n    Returns a sorted list of perfect squares.\n    \"\"\"\n    if start > end:\n        return []\n\n    # Ensure start is not negative for sqrt, perfect squares are non-negative.\n    # If start is negative, the first possible square is 0 (0*0).\n    effective_start = max(0, start) \n\n    # Calculate the integer roots of the range boundaries.\n    lower_root = math.ceil(math.sqrt(effective_start))\n    upper_root = math.floor(math.sqrt(end))\n\n    squares = []\n    # Iterate through roots and collect their squares.\n    for k in range(int(lower_root), int(upper_root) + 1):\n        squares.append(k * k)\n    \n    return squares"}
{"task_id": "Mbpp/591", "solution": "def swap_List(input_list):\n    \"\"\"\n    Interchanges the first and last elements in a list.\n    Returns the list unchanged if its length is less than 2 to avoid side effects on the original list.\n    \"\"\"\n    list_len = len(input_list)\n    if list_len < 2:\n        return input_list\n    \n    modified_list = list(input_list) # Create a copy to avoid modifying the original list\n    \n    modified_list[0], modified_list[list_len - 1] = modified_list[list_len - 1], modified_list[0]\n    \n    return modified_list"}
{"task_id": "Mbpp/592", "solution": "def sum_Of_product(n):\n    \"\"\"Calculates the sum of products of consecutive binomial coefficients C(n,k) * C(n,k+1).\"\"\"\n    if n == 0:\n        return 0\n\n    binomial_coefficients = list(_iter_binomials(n))\n\n    total_sum = 0\n    for k in range(n):\n        total_sum += binomial_coefficients[k] * binomial_coefficients[k+1]\n\n    return total_sum"}
{"task_id": "Mbpp/593", "solution": "class Octet:\n    \"\"\"Represents a single octet of an IPv4 address.\"\"\"\n    def __init__(self, rawValue: str):\n        self.rawValue = rawValue\n\n    def removeLeadingZeros(self) -> str:\n        \"\"\"Removes leading '0' characters from the raw octet value.\"\"\"\n        return self.rawValue.lstrip('0')\n\n    def isZero(self) -> bool:\n        \"\"\"Checks if the octet represents a numerical zero.\"\"\"\n        return int(self.rawValue) == 0\nclass IPv4Address:\n    \"\"\"Represents an IPv4 address and handles its parsing and normalization.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n        self._octets = []\n\n    def split(self) -> list:\n        \"\"\"Splits the raw IP string into Octet instances.\"\"\"\n        raw_octet_strings = self.raw.split('.')\n        self._octets = [Octet(os) for os in raw_octet_strings]\n        return self._octets\n\n    def normalize(self) -> str:\n        \"\"\"Normalizes the IPv4 address by removing leading zeros from octets.\"\"\"\n        self.split() # Ensure octets are parsed\n        normalized_parts = []\n        for octet_obj in self._octets:\n            stripped_value = octet_obj.removeLeadingZeros()\n            # Preserve a single '0' for octets that become empty after stripping.\n            normalized_parts.append(stripped_value if stripped_value else '0')\n        return '.'.join(normalized_parts)\nclass RemoveZeroIPFunction:\n    \"\"\"Orchestrates the IPv4 address leading zero removal.\"\"\"\n    @classmethod\n    def removezero_ip(cls, input: str) -> str:\n        \"\"\"Removes leading zeros from an IPv4 address string.\"\"\"\n        ipv4_address = IPv4Address(input)\n        return ipv4_address.normalize()\ndef removezero_ip(input: str) -> str:\n    \"\"\"\n    Removes leading zeroes from an ip address string.\n    Delegates to RemoveZeroIPFunction for core logic.\n    \"\"\"\n    return RemoveZeroIPFunction.removezero_ip(input)"}
{"task_id": "Mbpp/590", "solution": "import math\nfrom dataclasses import dataclass\nfrom typing import Tuple, Union\nclass Validator:\n    \"\"\"Handles input validation and unit conversion.\"\"\"\n    @staticmethod\n    def validate_numbers(*args) -> None:\n        for a in args:\n            if not isinstance(a, (int, float)):\n                raise TypeError(\"r and theta must be numeric\")\n\n    @staticmethod\n    def prepare_theta(theta: float, degrees: bool) -> float:\n        if degrees:\n            return math.radians(theta)\n        return theta\nclass Converter:\n    \"\"\"Performs coordinate conversions and canonicalization.\"\"\"\n    @staticmethod\n    def toRectangular(p: PolarCoordinate) -> RectangularCoordinate:\n        r, theta = p.r, p.theta\n        if r == 0:\n            r2 = 0.0\n            theta2 = 0.0\n        elif r < 0:\n            r2 = -r\n            theta2 = theta + math.pi\n        else:\n            r2 = r\n            theta2 = theta\n        x = r2 * math.cos(theta2)\n        y = r2 * math.sin(theta2)\n        return RectangularCoordinate(x, y)\n\n    @staticmethod\n    def toComplex(p: PolarCoordinate) -> ComplexNumber:\n        rect = Converter.toRectangular(p)\n        return ComplexNumber(complex(rect.x, rect.y))\n\n    @staticmethod\n    def toPolar(rect: RectangularCoordinate) -> PolarCoordinate:\n        x, y = rect.x, rect.y\n        r = math.hypot(x, y)\n        if r == 0.0:\n            theta = 0.0\n        else:\n            theta = math.atan2(y, x)\n        return PolarCoordinate(r, theta)\ndef polar_rect(r, theta, *, as_complex=False, degrees=False) -> Tuple[ Tuple[float, float], Union[ Tuple[float, float], complex ] ]:\n    \"\"\"\n    Converts polar coordinates (r, theta) to rectangular coordinates (x, y).\n    Optionally returns the rectangular coordinates as a complex number or handles degrees for theta.\n    \"\"\"\n    Validator.validate_numbers(r, theta)\n    theta2 = Validator.prepare_theta(theta, degrees)\n    \n    p_in = PolarCoordinate(r, theta2)\n    rect = Converter.toRectangular(p_in)\n    \n    if as_complex:\n        rectangular_result = Converter.toComplex(p_in).value\n    else:\n        rectangular_result = (rect.x, rect.y)\n    \n    # Canonicalize the polar result based on the *computed* rectangular coordinates\n    polar_result = Converter.toPolar(RectangularCoordinate(rect.x, rect.y))\n    \n    return ((polar_result.r, polar_result.theta), rectangular_result)"}
