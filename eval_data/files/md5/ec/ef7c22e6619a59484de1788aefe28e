{"task_id": "Mbpp/478", "solution": "from dataclasses import dataclass\nfrom typing import Iterator, Iterable\ndef _is_lowercase(ch: str) -> bool:\n    \"\"\"Character-level predicate that returns True if ch is considered lowercase per host semantics.\"\"\"\n    return ch.islower()\ndef _collect_substrings(s: str) -> Iterator[Substring]:\n    \"\"\"Scans s and yields contiguous substring runs based on character lowercase classification.\"\"\"\n    if not s:\n        return\n\n    current_start = 0\n    current_char_is_lower = _is_lowercase(s[0])\n\n    for i in range(1, len(s)):\n        char = s[i]\n        char_is_lower = _is_lowercase(char)\n\n        if char_is_lower != current_char_is_lower:\n            yield Substring(current_start, i, s[current_start:i])\n            current_start = i\n            current_char_is_lower = char_is_lower\n    \n    if current_start < len(s):\n        yield Substring(current_start, len(s), s[current_start:len(s)])\ndef _assemble_output(substrings: Iterable[Substring]) -> OutputString:\n    \"\"\"Builds the output string by concatenating retained substring texts.\"\"\"\n    result_parts = []\n    for sub in substrings:\n        if not sub.is_lowercase():\n            result_parts.append(sub.text)\n    return OutputString(\"\".join(result_parts))\ndef remove_lowercase(s: str) -> str:\n    \"\"\"\n    Removes all contiguous substrings composed solely of lowercase letters from the given string.\n    Preserves the original order and case of any characters not removed.\n    \"\"\"\n    if not s:\n        return \"\"\n\n    substrings_iterator = _collect_substrings(s)\n    output_obj = _assemble_output(substrings_iterator)\n    return output_obj.value"}
{"task_id": "Mbpp/554", "solution": "def isOdd(value):\n    \"\"\"Checks if a given integer value is odd.\"\"\"\n    return value % 2 != 0\ndef Split(integers):\n    \"\"\"\n    Filters a list of integers, returning a new list containing only the odd ones.\n    Raises TypeError if the input is not a list or contains non-integer elements.\n    \"\"\"\n    validateInput(integers)\n    result = []\n    for item in integers:\n        if isOdd(item):\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/555", "solution": "class Result:\n    \"\"\"A container for sum results and their difference.\"\"\"\n    def __init__(self, sum_cubes: int, sum_linear: int) -> None:\n        self.sum_cubes = sum_cubes\n        self.sum_linear = sum_linear\n        self.difference = self.sum_cubes - self.sum_linear\nclass NaturalNumberSequence:\n    \"\"\"Generates a sequence of the first n natural numbers.\"\"\"\n    def __init__(self, n: int) -> None:\n        self.n = n\n\n    def generate(self) -> list:\n        return list(range(1, self.n + 1))\nclass SumCalculator:\n    \"\"\"Calculates sums of a sequence, including sums of cubes.\"\"\"\n    def sum_cubes(self, seq: list) -> int:\n        return sum(x**3 for x in seq)\n\n    def sum_linear(self, seq: list) -> int:\n        return sum(seq)\nclass DifferenceFunction:\n    \"\"\"Orchestrates sequence generation, sum calculations, and result composition.\"\"\"\n    def __init__(self, n: int) -> None:\n        self.n = n\n\n    def compute(self) -> int:\n        sequence_generator = NaturalNumberSequence(self.n)\n        natural_numbers_seq = sequence_generator.generate()\n\n        calculator = SumCalculator()\n        sum_of_cubes = calculator.sum_cubes(natural_numbers_seq)\n        sum_of_linear = calculator.sum_linear(natural_numbers_seq)\n\n        result_container = Result(sum_of_cubes, sum_of_linear)\n        return result_container.difference\ndef difference(n: int) -> int:\n    \"\"\"\n    Finds the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    diff_func = DifferenceFunction(n)\n    return diff_func.compute()"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr, n):\n    \"\"\"Return the count of unordered pairs (i,j) with 0 <= i < j < n and arr[i] XOR arr[j] is odd.\n    Normalizes n to n_eff = min(n, len(arr)) and returns 0 for n_eff <= 1.\n    \"\"\"\n    n_eff = min(n, len(arr))\n    if n_eff <= 1:\n        return 0\n\n    odd_count = 0\n    for v in arr[:n_eff]:\n        if v % 2 != 0:\n            odd_count += 1\n            \n    even_count = n_eff - odd_count\n    \n    return odd_count * even_count"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input):\n    \"\"\"\n    Toggles the case of ASCII alphabetic characters in a string.\n    Non-alphabetic characters remain unchanged.\n    \"\"\"\n    if not input:\n        return \"\"\n\n    toggled_chars = []\n    for char in input:\n        if 'a' <= char <= 'z':\n            toggled_chars.append(char.upper())\n        elif 'A' <= char <= 'Z':\n            toggled_chars.append(char.lower())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(list_of_sublists):\n    \"\"\"Return an int equal to the length of the longest sublist in list_of_sublists.\n    Returns 0 if list_of_sublists is empty.\n    \"\"\"\n    max_length = 0\n    for sublist in list_of_sublists:\n        if len(sublist) > max_length:\n            max_length = len(sublist)\n    return max_length"}
{"task_id": "Mbpp/559", "solution": "class ValidationError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\nclass InputList:\n    def __init__(self, values, length):\n        self._raw_values = values\n        self._raw_length = length\n        self.values = []\n        self.effective_N = 0\n\n    def validate(self) -> None:\n        \"\"\"Validates that values is a list/sequence of integers and length is an integer.\n        Raises ValidationError on invalid types or N out of range.\n        \"\"\"\n        if not isinstance(self._raw_values, (list, tuple)):\n            raise ValidationError(\"Input 'list_of_integers' must be a list or tuple.\")\n        if not all(isinstance(x, int) for x in self._raw_values):\n            raise ValidationError(\"All elements in 'list_of_integers' must be integers.\")\n\n        if not isinstance(self._raw_length, int):\n            raise ValidationError(\"Input 'N' must be an integer.\")\n\n        # Policy for N-range: N must be non-negative. Clamp N to len(values) if too large.\n        if self._raw_length < 0:\n            raise ValidationError(\"Input 'N' must be a non-negative integer.\")\n\n        self.values = list(self._raw_values)\n        self.effective_N = min(self._raw_length, len(self.values))\nclass Result:\n    def __init__(self, sum: int):\n        self.sum = sum\nclass MaxSubArrayCalculator:\n    def max_sub_array_sum(self, values: list, N: int) -> int:\n        \"\"\"Public method that computes the maximum contiguous-sum for values[0..N-1].\"\"\"\n        result_sum = self._kadane(values, N)\n        return Result(result_sum).sum\n\n    def _kadane(self, values: list, N: int) -> int:\n        \"\"\"Private helper implementing Kadane-style algorithm restricted to first N elements.\"\"\"\n        if N <= 0:\n            return 0\n\n        arr_prefix = values[:N]\n\n        if not arr_prefix:\n            return 0\n\n        max_so_far = arr_prefix[0]\n        current_max = arr_prefix[0]\n\n        for i in range(1, len(arr_prefix)):\n            current_max = max(arr_prefix[i], current_max + arr_prefix[i])\n            max_so_far = max(max_so_far, current_max)\n        \n        return max_so_far\ndef max_sub_array_sum(list_of_integers, N):\n    \"\"\"Public API per FR1. Validates inputs and returns int sum.\n    Raises: ValidationError on invalid types/inputs.\n    \"\"\"\n    input_list_obj = InputList(list_of_integers, N)\n    input_list_obj.validate()\n\n    calculator = MaxSubArrayCalculator()\n    return calculator.max_sub_array_sum(input_list_obj.values, input_list_obj.effective_N)"}
{"task_id": "Mbpp/558", "solution": "class IntegerNumber:\n    \"\"\"Encapsulates an integer and provides digit extraction.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n        self._digits = None\n\n    def extract_digits(self) -> list[int]:\n        \"\"\"Extracts digits from the integer, LSB-first.\"\"\"\n        if self._digits is not None:\n            return self._digits\n\n        if self.value == 0:\n            self._digits = [0]\n            return self._digits\n\n        digits = []\n        n = abs(self.value)\n        while n > 0:\n            digits.append(n % 10)\n            n //= 10\n        self._digits = digits\n        return self._digits\nclass DigitPair:\n    \"\"\"Represents two aligned digits and computes their absolute difference.\"\"\"\n    def __init__(self, position: int, a_value: int, b_value: int):\n        self.position = position\n        self.a_value = a_value\n        self.b_value = b_value\n\n    def difference(self) -> int:\n        \"\"\"Returns the absolute difference between the paired digits.\"\"\"\n        return abs(self.a_value - self.b_value)\nclass Result:\n    \"\"\"Aggregates and holds the final sum of differences.\"\"\"\n    def __init__(self, sum_value: int):\n        self.sum = sum_value\nclass DigitDistanceFunction:\n    \"\"\"Orchestrates digit distance computation between two integers.\"\"\"\n    def compute(self, a: int, b: int) -> int:\n        \"\"\"Computes the sum of per-digit absolute differences.\"\"\"\n        _validate_integer(a)\n        _validate_integer(b)\n\n        int_a = IntegerNumber(a)\n        int_b = IntegerNumber(b)\n\n        digits_a = int_a.extract_digits()\n        digits_b = int_b.extract_digits()\n\n        max_len = max(len(digits_a), len(digits_b))\n\n        # Pad shorter list with zeros\n        padded_digits_a = digits_a + [0] * (max_len - len(digits_a))\n        padded_digits_b = digits_b + [0] * (max_len - len(digits_b))\n\n        total_difference = 0\n        for i in range(max_len):\n            digit_pair = DigitPair(i, padded_digits_a[i], padded_digits_b[i])\n            total_difference += digit_pair.difference()\n\n        result = Result(total_difference)\n        return result.sum\ndef digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"\n    Finds the sum of the per-digit difference between two integers.\n    The function aligns digits by LSB, pads the shorter number with zeros, and sums absolute differences.\n    \"\"\"\n    dd_function = DigitDistanceFunction()\n    return dd_function.compute(a, b)"}
{"task_id": "Mbpp/560", "solution": "from typing import Any, Tuple, List\nfrom dataclasses import dataclass\nclass ElementSet:\n    def __init__(self):\n        self._elements: set = set()\n\n    def add(self, elem: object) -> None:\n        self._elements.add(elem)\n\n    def to_sorted_list(self) -> list:\n        return sorted(list(self._elements))\n\n    def to_tuple(self) -> tuple:\n        return tuple(self.to_sorted_list())\ndef union_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Finds the union of elements from two tuples, removes duplicates,\n    sorts them, and returns the result as a tuple.\n    \"\"\"\n    input_a = InputTuple(a)\n    input_b = InputTuple(b)\n\n    element_set = ElementSet()\n\n    for elem in input_a.elements:\n        element_set.add(elem)\n    for elem in input_b.elements:\n        element_set.add(elem)\n\n    sorted_elements_list = element_set.to_sorted_list()\n\n    result_tuple_wrapper = ResultTuple(tuple(sorted_elements_list))\n    return result_tuple_wrapper.elements"}
{"task_id": "Mbpp/563", "solution": "import re\nfrom typing import List\ndef extract_values(input_string: str) -> List[str]:\n    \"\"\"\n    Extracts values enclosed in double quotation marks from a string.\n    Returns an ordered list of the inner contents of these quoted substrings.\n    \"\"\"\n    # Use a regular expression to find all non-greedy matches of content within double quotes.\n    # The pattern r'\"(.*?)\"' captures anything (including empty string) between two double quotes.\n    # re.findall returns a list of all captured groups.\n    return re.findall(r'\"(.*?)\"', input_string)"}
