{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(input_list):\n    \"\"\"\n    Flattens a list and sums all of its numeric elements, handling nested lists and circular references.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    # visited set tracks object IDs of lists currently in the recursion stack to detect cycles.\n    visited = set()\n    return _recursive_sum_impl(input_list, visited)\ndef _recursive_sum_impl(obj, visited):\n    \"\"\"\n    Internal helper for recursive traversal, summing, and cycle detection.\n    \"\"\"\n    if isinstance(obj, (int, float)):\n        return obj\n    elif isinstance(obj, list):\n        obj_id = id(obj)\n        if obj_id in visited:\n            raise ValueError(\"Circular reference detected.\")\n        \n        visited.add(obj_id) # Mark list as being processed\n\n        current_sum = 0\n        for item in obj:\n            current_sum += _recursive_sum_impl(item, visited)\n        \n        visited.remove(obj_id) # Unmark list after processing its contents (backtracking)\n        \n        return current_sum\n    else:\n        # Non-numeric, non-list elements are ignored (contribute 0 to the sum)\n        return 0"}
{"task_id": "Mbpp/63", "solution": "import numbers\nfrom typing import Iterable, Tuple, List\nclass TuplePair:\n    \"\"\"Typed holder for a pair (a, b) with method to compute absolute difference.\"\"\"\n    def __init__(self, a: numbers.Number, b: numbers.Number) -> None:\n        self.a = a\n        self.b = b\n\n    def difference(self) -> numbers.Number:\n        \"\"\"Computes the absolute difference between a and b.\"\"\"\n        return abs(self.a - self.b)\nclass Result:\n    \"\"\"Container for numeric result value.\"\"\"\n    def __init__(self, value: numbers.Number) -> None:\n        self.value = value\ndef max_difference(pairs: Iterable[Tuple[numbers.Number, numbers.Number]]) -> numbers.Number:\n    \"\"\"\n    Finds the maximum difference between available pairs in the given tuple list.\n    The input collection and its tuples are not mutated.\n    \"\"\"\n    # Convert the iterable to a list first. This ensures it's fully consumed once\n    # (handling generators) and provides a re-iterable collection for validation\n    # and subsequent computation.\n    materialized_pairs = list(pairs)\n\n    validate_input(materialized_pairs)\n\n    max_diff_value = 0.0  # Absolute differences are non-negative.\n\n    for a, b in materialized_pairs:\n        current_pair = TuplePair(a, b)\n        diff = current_pair.difference()\n        if diff > max_diff_value:\n            max_diff_value = diff\n    \n    result_dto = Result(value=max_diff_value)\n    return result_dto.value"}
{"task_id": "Mbpp/61", "solution": "from typing import List\nclass InputString:\n    \"\"\"Represents the input string, providing validation and simple accessors.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the input string contains only decimal digits.\"\"\"\n        return self.value.isdigit()\nclass Substring:\n    \"\"\"Represents a contiguous substring, providing sum and length computations.\"\"\"\n    def __init__(self, original_string: str, start: int, end: int):\n        self.start = start\n        self.end = end\n        self.digits: List[int] = [int(d) for d in original_string[start:end]]\n\n    def sum(self) -> int:\n        \"\"\"Returns the sum of digits in the substring.\"\"\"\n        return sum(self.digits)\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the substring.\"\"\"\n        return self.end - self.start\nclass SubstringCounter:\n    \"\"\"Orchestrates validation and counting of substrings with sum of digits equal to length.\"\"\"\n\n    @staticmethod\n    def validate_input(s: str) -> bool:\n        \"\"\"Validates that the input string 's' contains only decimal digits.\"\"\"\n        input_str = InputString(s)\n        return input_str.is_valid()\n\n    @staticmethod\n    def compute_count(s: str) -> int:\n        \"\"\"Enumerates substrings and computes the total count.\"\"\"\n        count = 0\n        n = len(s)\n        for start in range(n):\n            for end in range(start + 1, n + 1):\n                sub = Substring(s, start, end)\n                if sub.sum() == sub.length():\n                    count += 1\n        return count\n\n    @staticmethod\n    def count_Substrings(s: str) -> int:\n        \"\"\"Primary operation returning the integer count after validation.\"\"\"\n        if not SubstringCounter.validate_input(s):\n            return 0\n        return SubstringCounter.compute_count(s)\ndef count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts the number of substrings with the sum of digits equal to their length.\n    Delegates to SubstringCounter for core logic.\n    \"\"\"\n    return SubstringCounter.count_Substrings(s)"}
{"task_id": "Mbpp/70", "solution": "def get_equal(list_of_tuples) -> bool:\n    \"\"\"Return True iff every element in list_of_tuples has the same length.\"\"\"\n    if not list_of_tuples:\n        return True\n\n    first_length = len(list_of_tuples[0])\n    for item in list_of_tuples[1:]:\n        if len(item) != first_length:\n            return False\n    return True"}
{"task_id": "Mbpp/66", "solution": "def pos_count(numbers: list) -> int:\n    \"\"\"Return the count of elements strictly greater than 0 in numbers.\n\n    Args:\n        numbers: list of numeric values (int or float) -- precondition: a list is provided; behavior for non-numeric items is not specified by the SRS.\n\n    Returns:\n        int: number of elements > 0\n    \"\"\"\n    count = 0\n    for number in numbers:\n        if number > 0:\n            count += 1\n    return count"}
{"task_id": "Mbpp/67", "solution": "class Error(Exception):\n    \"\"\"\n    Represents errors for invalid input or computation failures.\n    Derives from Exception to provide a domain-specific exception type.\n    \"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\nclass InputValidator:\n    \"\"\"\n    Validates that input n is an integer and is >= 0.\n    Raises Error if validation fails.\n    \"\"\"\n    def validate(self, n):\n        if not isinstance(n, int) or n < 0:\n            raise Error(\"invalid n: must be int >= 0\")\nclass BellNumberResult:\n    \"\"\"\n    Represents a successful result container holding the computed integer Bell number.\n    \"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def __int__(self) -> int:\n        return self.value\nclass BellNumberCalculator:\n    \"\"\"\n    Computes the nth Bell number given validated input.\n    Uses dynamic programming for Stirling numbers of the second kind via Bell triangle.\n    \"\"\"\n    def bell_number(self, n) -> BellNumberResult:\n        computed_value = self._computeBell(n)\n        return BellNumberResult(computed_value)\n\n    def _computeBell(self, n: int) -> int:\n        # Base case for B(0)\n        if n == 0:\n            return 1\n\n        # Compute Stirling numbers of the second kind S(i, j) using dynamic programming.\n        # S(i, j) = S(i-1, j-1) + j * S(i-1, j)\n        # The nth Bell number B(n) is the sum of S(n, k) for k from 0 to n.\n        \n        dp = [[0 for _ in range(n + 1)] for _ in range(n + 1)]\n\n        # Base case S(0, 0) = 1\n        dp[0][0] = 1\n\n        for i in range(1, n + 1):\n            for j in range(1, i + 1):\n                dp[i][j] = dp[i-1][j-1] + j * dp[i-1][j]\n        \n        # B(n) is the sum of the last row of Stirling numbers\n        bell_n = sum(dp[n])\n        return bell_n\ndef bell_number(n):\n    \"\"\"\n    Calculates the nth Bell number, which is the number of ways to partition a set of size n.\n    Validates input and returns an integer result, or raises an Error for invalid inputs.\n    \"\"\"\n    InputValidator().validate(n)\n    calculator = BellNumberCalculator()\n    result_obj = calculator.bell_number(n)\n    return int(result_obj)"}
{"task_id": "Mbpp/71", "solution": "class CombSortError(Exception):\n    \"\"\"Custom exception for Comb Sort errors.\"\"\"\n    pass\ndef validate_elements(lst):\n    \"\"\"\n    Validates the input list for None and mutual comparability of elements.\n    Raises CombSortError if the list is None or elements are not comparable.\n    \"\"\"\n    if lst is None:\n        raise CombSortError(\"input list is None\")\n\n    if not lst:\n        return True\n\n    # Check for mutual comparability by attempting pairwise comparisons.\n    for i in range(len(lst) - 1):\n        try:\n            _ = lst[i] > lst[i+1]\n            _ = lst[i] < lst[i+1]\n        except TypeError:\n            raise CombSortError(\"elements not mutually comparable\")\n    return True\ndef comb_sort(lst):\n    \"\"\"\n    Sorts a list of elements in ascending order using the Comb Sort algorithm.\n    Validates input for None and mutual comparability before sorting.\n    \"\"\"\n    validate_elements(lst)\n\n    n = len(lst)\n    if n == 0:\n        return []\n\n    arr = list(lst)  # Create a mutable copy of the list\n\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        gap = int(gap / shrink_factor)\n        if gap < 1:\n            gap = 1\n\n        swapped = False\n\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n\n    return arr"}
{"task_id": "Mbpp/68", "solution": "from typing import List, Any\nclass Comparator:\n    \"\"\"Utility class for comparing two elements.\"\"\"\n    @staticmethod\n    def compare(a: Any, b: Any) -> int:\n        \"\"\"\n        Compares two elements and returns an integer indicating their relative order.\n        Returns negative if a < b, zero if a == b, positive if a > b.\n        \"\"\"\n        if a < b:\n            return -1\n        elif a == b:\n            return 0\n        else:\n            return 1\nclass Array:\n    \"\"\"Lightweight wrapper around a list to map to the domain model.\"\"\"\n    def __init__(self, elements: List[Any]):\n        self._elements = elements\n\n    def elements(self) -> List[Any]:\n        \"\"\"Returns the wrapped list of elements.\"\"\"\n        return self._elements\nclass Result:\n    \"\"\"Holds monotonicity check outcome and a mode label.\"\"\"\n    def __init__(self, is_monotonic: bool, mode: str):\n        self.is_monotonic = is_monotonic\n        self.mode = mode\nclass MonotonicChecker:\n    \"\"\"Encapsulates domain logic to determine monotonicity.\"\"\"\n    def is_Monotonic(self, array: List[Any]) -> bool:\n        \"\"\"Determines if the given array is monotonic (non-decreasing or non-increasing).\"\"\"\n        wrapped_array = Array(array)\n        elements = wrapped_array.elements()\n\n        is_non_decreasing = self._check_non_decreasing(elements)\n        if is_non_decreasing:\n            result = Result(True, \"non-decreasing\")\n        else:\n            is_non_increasing = self._check_non_increasing(elements)\n            if is_non_increasing:\n                result = Result(True, \"non-increasing\")\n            else:\n                result = Result(False, \"neither\")\n        \n        return result.is_monotonic\n\n    def _check_non_decreasing(self, elements: List[Any]) -> bool:\n        \"\"\"Checks if the array is non-decreasing (each element >= previous).\"\"\"\n        if len(elements) <= 1:\n            return True\n        for i in range(1, len(elements)):\n            if Comparator.compare(elements[i], elements[i-1]) < 0:\n                return False\n        return True\n\n    def _check_non_increasing(self, elements: List[Any]) -> bool:\n        \"\"\"Checks if the array is non-increasing (each element <= previous).\"\"\"\n        if len(elements) <= 1:\n            return True\n        for i in range(1, len(elements)):\n            if Comparator.compare(elements[i], elements[i-1]) > 0:\n                return False\n        return True\ndef is_Monotonic(array: List[Any]) -> bool:\n    \"\"\"\n    Checks whether the given array is monotonic (entirely non-decreasing OR entirely non-increasing).\n    Equal adjacent elements are permitted.\n    assert is_Monotonic([6, 5, 4, 4]) == True\n    \"\"\"\n    checker = MonotonicChecker()\n    return checker.is_Monotonic(array)"}
{"task_id": "Mbpp/69", "solution": "from typing import Sequence, Any\ndef is_sublist(main_list: Sequence[Any], sublist: Sequence[Any]) -> bool:\n    \"\"\"Checks if a list contains the given sublist as a contiguous subsequence.\n    Returns False if sublist is longer than main_list; otherwise, performs a sliding window search.\n    \"\"\"\n    len_main = len(main_list)\n    len_sub = len(sublist)\n\n    if len_sub > len_main:\n        return False\n\n    for i in range(len_main - len_sub + 1):\n        match = True\n        for k in range(len_sub):\n            if main_list[i + k] != sublist[k]:\n                match = False\n                break\n        if match:\n            return True\n\n    return False"}
