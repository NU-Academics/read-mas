{"task_id": "Mbpp/745", "solution": "from typing import List, Iterator\nclass Digit:\n    \"\"\"Represents an individual decimal digit.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_zero(self) -> bool:\n        \"\"\"Returns True if the digit's value is 0.\"\"\"\n        return self.value == 0\nclass Number:\n    \"\"\"Represents a candidate integer and provides digit-related operations.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def digits(self) -> List[int]:\n        \"\"\"Returns a list of decimal digits for the number.\"\"\"\n        return [int(d) for d in str(self.value)]\n\n    def contains_zero(self) -> bool:\n        \"\"\"Returns True if any decimal digit in the number is zero.\"\"\"\n        for digit_val in self.digits():\n            if Digit(digit_val).is_zero():\n                return True\n        return False\n\n    def divisible_by_all_digits(self) -> bool:\n        \"\"\"Returns True if the number is divisible by all its non-zero digits.\"\"\"\n        for digit_val in self.digits():\n            if Digit(digit_val).is_zero(): \n                continue \n            if self.value % digit_val != 0:\n                return False\n        return True\nclass NumberRange:\n    \"\"\"Represents an inclusive integer range and provides iteration and validation.\"\"\"\n    def __init__(self, start: int, end: int) -> None:\n        self.start = start\n        self.end = end\n\n    def is_valid(self) -> bool:\n        \"\"\"Returns True if the start of the range is less than or equal to the end.\"\"\"\n        return self.start <= self.end\n\n    def __iter__(self) -> Iterator[Number]:\n        \"\"\"Yields Number objects for each integer value in the inclusive range.\"\"\"\n        for i in range(self.start, self.end + 1):\n            yield Number(i)\nclass ResultList:\n    \"\"\"Collects candidate integers and provides them in sorted order.\"\"\"\n    def __init__(self) -> None:\n        self._results: List[int] = []\n\n    def append(self, n: int) -> None:\n        \"\"\"Adds a number to the internal list of results.\"\"\"\n        self._results.append(n)\n\n    def get_sorted(self) -> List[int]:\n        \"\"\"Returns a new list containing the collected numbers, sorted ascending.\"\"\"\n        return sorted(self._results)\nclass DivisibleByDigitsFunction:\n    \"\"\"Coordinates validation, iteration, filtering, and result construction.\"\"\"\n    def __init__(self, startnum: int, endnum: int) -> None:\n        self.startnum = startnum\n        self.endnum = endnum\n        self._range = NumberRange(startnum, endnum)\n        self._result = ResultList()\n\n    def execute(self) -> List[int]:\n        \"\"\"Executes the main algorithm to find divisible numbers within the range.\"\"\"\n        if not self._range.is_valid():\n            return []\n\n        for number_obj in self._range:\n            if not number_obj.contains_zero():\n                if number_obj.divisible_by_all_digits():\n                    self._result.append(number_obj.value)\n        \n        return self._result.get_sorted()\ndef divisible_by_digits(startnum: int, endnum: int) -> List[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    Numbers containing zero as a digit are excluded.\n    \"\"\"\n    fn = DivisibleByDigitsFunction(startnum, endnum)\n    return fn.execute()"}
{"task_id": "Mbpp/749", "solution": "import typing\nfrom typing import List\nclass NumericString:\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def toInteger(self) -> int:\n        \"\"\"Convert stored string to int using base-10 interpretation.\"\"\"\n        return int(self.value, 10)\nclass IntegerValue:\n    def __init__(self, value: int) -> None:\n        self.value = value\nclass InputList:\n    def __init__(self, items: List[str]) -> None:\n        \"\"\"Wraps each raw string into NumericString and populates self.items.\"\"\"\n        self.items = [NumericString(item) for item in items]\nclass OutputList:\n    def __init__(self, values: List[int]) -> None:\n        \"\"\"Initialize items as List[IntegerValue].\"\"\"\n        self.items = [IntegerValue(value) for value in values]\n\n    def to_list(self) -> List[int]:\n        \"\"\"Return raw ints.\"\"\"\n        return [item.value for item in self.items]\nclass Sorter:\n    def sort_numeric_strings(self, input_list_obj: InputList) -> OutputList:\n        \"\"\"Convert each string to int, sort ascending, return OutputList.\"\"\"\n        parsed_integers = [ns.toInteger() for ns in input_list_obj.items]\n        parsed_integers.sort()\n        return OutputList(parsed_integers)\n    \n    # parseString is not used in the final design as NumericString.toInteger() handles parsing.\n    # It's kept as a placeholder if design changes require a separate Sorter parsing method.\n    def parseString(self, s: str) -> int:\n        \"\"\"Parse a single string to int using base-10 interpretation.\"\"\"\n        return int(s, 10)\ndef sort_numeric_strings(input: List[str]) -> List[int]:\n    \"\"\"Sorts a given list of strings of numbers numerically.\"\"\"\n    if not input:\n        return []\n    \n    input_list_obj = InputList(input)\n    sorter = Sorter()\n    output_list_obj = sorter.sort_numeric_strings(input_list_obj)\n    \n    return output_list_obj.to_list()"}
{"task_id": "Mbpp/750", "solution": "from typing import Any, List, Tuple\ndef add_tuple(input_list: List[Any], input_tuple: Tuple[Any, ...]) -> List[Any]:\n    \"\"\"\n    Accepts a list and a tuple and returns a new list with elements of input_list\n    followed by elements of input_tuple, preserving order.\n    \"\"\"\n    return list(input_list) + list(input_tuple)"}
{"task_id": "Mbpp/753", "solution": "def min_k(records, k):\n    \"\"\"\n    Finds the minimum k records from a list of tuples, sorted by their second element.\n    If k is non-positive or records is empty, an empty list is returned.\n    \"\"\"\n    if k <= 0 or not records:\n        return []\n\n    # Sort the records list. Python's Timsort (used by sorted()) is stable,\n    # preserving the original order for elements with equal keys.\n    # We sort based on the second element of each tuple (the numeric value).\n    sorted_records = sorted(records, key=lambda record: record[1])\n\n    # Return the first k elements from the sorted list.\n    # If k is larger than the number of available records, it will return all records.\n    return sorted_records[:k]"}
{"task_id": "Mbpp/748", "solution": "class Validator:\n    @staticmethod\n    def validate_type(input_obj) -> None:\n        \"\"\"\n        Raises TypeError if the input object is not a string.\n        \"\"\"\n        if not isinstance(input_obj, str):\n            raise TypeError(\"Input must be a string.\")\nclass WordBoundaryDetector:\n    @staticmethod\n    def is_word_start(prev_char: str, curr_char: str) -> bool:\n        \"\"\"\n        Determines if curr_char marks the start of a new capitalized word,\n        assuming it's not the very first character of the string.\n        \"\"\"\n        return curr_char.isupper() and not prev_char.isupper()\nclass SpaceInserter:\n    @staticmethod\n    def build_output(input_str: str) -> str:\n        \"\"\"\n        Constructs the output string, inserting spaces at detected word boundaries.\n        \"\"\"\n        if not input_str:\n            return \"\"\n\n        result_chars = [input_str[0]]\n\n        for i in range(1, len(input_str)):\n            prev_char = input_str[i - 1]\n            curr_char = input_str[i]\n\n            if WordBoundaryDetector.is_word_start(prev_char, curr_char) and not prev_char.isspace():\n                result_chars.append(' ')\n            result_chars.append(curr_char)\n        \n        return \"\".join(result_chars)\ndef capital_words_spaces(input: str) -> str:\n    \"\"\"\n    Puts spaces between words starting with capital letters in a given string.\n    \"\"\"\n    Validator.validate_type(input)\n    return SpaceInserter.build_output(input)"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr):\n    \"\"\"Return True if arr is a min-heap under 0-based indexing, else False.\n\n    Elements must be comparable. Empty arrays are considered valid min-heaps.\n    \"\"\"\n    n = len(arr)\n\n    if n == 0:\n        return True\n\n    # Iterate only through parent nodes\n    # The last parent node is at index (n // 2) - 1 for 0-based indexing\n    # or floor((n - 2) / 2) as specified in the design.\n    # range(start, end) goes up to end-1, so we need +1 for the upper bound.\n    for i in range(0, (n // 2)): # This is equivalent to range(0, floor((n-2)/2) + 1) for n >= 2. Handles n=0, n=1 correctly too.\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n:\n            if not (arr[i] <= arr[left_child_idx]):\n                return False\n\n        # Check right child\n        if right_child_idx < n:\n            if not (arr[i] <= arr[right_child_idx]):\n                return False\n\n    return True"}
{"task_id": "Mbpp/752", "solution": "class JacobsthalNumber:\n    \"\"\"A value container for a computed Jacobsthal number.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\nclass Validation:\n    \"\"\"Stateless utility to validate input for Jacobsthal number calculation.\"\"\"\n    @staticmethod\n    def is_non_negative_integer(n) -> bool:\n        \"\"\"Returns True if n is an integer and n >= 0, otherwise False.\"\"\"\n        return isinstance(n, int) and n >= 0\nclass JacobsthalCalculator:\n    \"\"\"Computes the nth Jacobsthal number using an iterative approach.\"\"\"\n    def jacobsthal_num(self, n: int) -> JacobsthalNumber:\n        if n == 0:\n            return JacobsthalNumber(0)\n        if n == 1:\n            return JacobsthalNumber(1)\n\n        prev2 = 0  # Represents J(i-2)\n        prev = 1   # Represents J(i-1)\n        current = 0 # Placeholder for J(i)\n\n        for _ in range(2, n + 1):\n            current = prev + 2 * prev2\n            prev2 = prev\n            prev = current\n        \n        return JacobsthalNumber(current)\ndef jacobsthal_num(n):\n    \"\"\"\n    Finds the nth Jacobsthal number.\n    Raises ValueError if n is not a non-negative integer.\n    \"\"\"\n    if not Validation.is_non_negative_integer(n):\n        raise ValueError(\"n must be a non-negative integer\")\n    \n    calculator = JacobsthalCalculator()\n    return calculator.jacobsthal_num(n).value"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds elements that appear in all three lists under the same index.\n    Returns a list of such common elements in ascending index order.\n    \"\"\"\n    \n    min_len = min(len(l1), len(l2), len(l3))\n    result = []\n    \n    for i in range(min_len):\n        if l1[i] == l2[i] == l3[i]:\n            result.append(l1[i])\n            \n    return result"}
{"task_id": "Mbpp/755", "solution": "from typing import List, Union\nclass ValidationError(Exception):\n    \"\"\"Exception raised for input validation errors.\"\"\"\n    pass\ndef validateMinLength(numbers: List[Union[int, float]], min: int) -> bool:\n    \"\"\"Returns True if the list length is greater than or equal to min, else False.\"\"\"\n    return len(numbers) >= min\ndef sortNonDecreasing(numbers: List[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\"Returns a new list sorted in non-decreasing order.\"\"\"\n    return sorted(numbers)\ndef selectIndex(numbers: List[Union[int, float]], index: int) -> Union[int, float]:\n    \"\"\"Returns the element at the specified index.\"\"\"\n    return numbers[index]\ndef second_smallest(numbers: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Finds the second smallest number in a list after validating its length.\n    Raises ValidationError if the input list has fewer than two numbers.\n    \"\"\"\n    if not validateMinLength(numbers, 2):\n        raise ValidationError('Input must contain at least two numbers')\n    \n    sorted_numbers = sortNonDecreasing(numbers)\n    return selectIndex(sorted_numbers, 1)"}
{"task_id": "Mbpp/759", "solution": "import re\nDECIMAL_PATTERN: str = '^\\\\d+\\\\.\\\\d{2}$'\n_COMPILED_PATTERN: re.Pattern = re.compile(DECIMAL_PATTERN)\ndef is_decimal(input: str) -> bool:\n    \"\"\"\n    Checks if the given string is a decimal number with exactly two decimal places.\n    Matches strings like '123.11' but not '123' or '123.1'.\n    \"\"\"\n    return _COMPILED_PATTERN.fullmatch(input) is not None"}
{"task_id": "Mbpp/758", "solution": "def unique_sublists(input_list):\n    \"\"\"\n    Counts occurrences of sublists, converting them to tuples as dictionary keys.\n    Returns a dictionary mapping each unique tuple (converted sublist) to its count.\n    \"\"\"\n    counts = {}\n    for sublist in input_list:\n        key = tuple(sublist)\n        counts[key] = counts.get(key, 0) + 1\n    return counts"}
{"task_id": "Mbpp/757", "solution": "import collections\nclass StringItem:\n    \"\"\"Represent a single string and provide a reverse() helper.\"\"\"\n    def __init__(self, index: int, value: str) -> None:\n        self.index = index\n        self.value = value\n\n    def reverse(self) -> str:\n        \"\"\"Return character-by-character reversal (case-sensitive).\"\"\"\n        return self.value[::-1]\nclass StringList:\n    \"\"\"Container for StringItem objects representing input.\"\"\"\n    def __init__(self, values: list[str]) -> None:\n        self.items: list[StringItem] = [StringItem(i, value) for i, value in enumerate(values)]\nclass ReversePairCounter:\n    \"\"\"Encapsulate validation and counting algorithm.\"\"\"\n    def __init__(self) -> None:\n        self.string_list: StringList | None = None\n\n    def count_reverse_pairs(self, strings: list) -> int:\n        \"\"\"\n        Validate input, construct a StringList, iterate unordered pairs,\n        compare values, and return the total count.\n        \"\"\"\n        if not isinstance(strings, list):\n            raise TypeError(\"Input must be a list.\")\n        if not all(isinstance(s, str) for s in strings):\n            raise TypeError(\"All elements in the list must be strings.\")\n\n        self.string_list = StringList(strings)\n        count = 0\n        n = len(self.string_list.items)\n\n        for i in range(n - 1):\n            for j in range(i + 1, n):\n                item_i = self.string_list.items[i]\n                item_j = self.string_list.items[j]\n\n                if item_i.value == item_j.reverse():\n                    count += 1\n                elif item_j.value == item_i.reverse():\n                    count += 1\n        return count\ndef count_reverse_pairs(strings: list) -> int:\n    \"\"\"\n    Counts pairs of reverse strings in the given list.\n    Delegates counting to ReversePairCounter and returns the integer count.\n    \"\"\"\n    counter = ReversePairCounter()\n    return counter.count_reverse_pairs(strings)"}
{"task_id": "Mbpp/762", "solution": "class Month:\n    def __init__(self, number: int):\n        # Stores the month number. Assumes inputs 1..12 per design.\n        self.number: int = number\n    def has30Days(self) -> bool:\n        \"\"\"Return True if month is one of 4,6,9,11, otherwise False.\"\"\"\n        return self.number in {4, 6, 9, 11}\nclass Result:\n    def __init__(self, value: bool):\n        # Stores the boolean outcome of the check.\n        self.value: bool = value\nclass MonthChecker:\n    def check_monthnumber_number(self, monthNumber: int) -> bool:\n        \"\"\"Evaluate monthNumber and return True if it has 30 days per SRS.\"\"\"\n        month = Month(monthNumber)\n        has_30_days = month.has30Days()\n        result_obj = Result(has_30_days)\n        return result_obj.value\ndef check_monthnumber_number(monthNumber: int) -> bool:\n    \"\"\"Public API required by FR1: delegate to MonthChecker and return boolean result.\"\"\"\n    checker = MonthChecker()\n    return checker.check_monthnumber_number(monthNumber)"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(sequence, n):\n    \"\"\"\n    Finds the minimum difference between any two elements among the first n elements\n    of a given sequence.\n    \"\"\"\n    validate_input(sequence, n)\n\n    arr = list(sequence[:n])\n    arr.sort()\n\n    min_diff = float('inf')\n    for i in range(1, len(arr)):\n        current_diff = abs(arr[i] - arr[i-1])\n        if current_diff < min_diff:\n            min_diff = current_diff\n            \n    return min_diff"}
{"task_id": "Mbpp/760", "solution": "from typing import List, Union\ndef count_distinct(numbers: list) -> int:\n    \"\"\"Return count of distinct elements in numbers.\"\"\"\n    return len(set(numbers))\ndef unique_Element(numbers: list) -> bool:\n    \"\"\"Return True if the provided list contains only one distinct element (empty or single-element -> True).\"\"\"\n    if len(numbers) <= 1:\n        return True\n    distinct_count = count_distinct(numbers)\n    return distinct_count <= 1"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(s: str) -> int:\n    \"\"\"Count ASCII digits in s.\n\n    Args:\n        s: input string (must be type 'str').\n\n    Returns:\n        int: number of ASCII digit characters '0'..'9' in s (>= 0).\n\n    Raises:\n        TypeError: if s is not an instance of 'str'.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    count = 0\n    for char_code in s:\n        if '0' <= char_code <= '9':\n            count += 1\n    return count"}
{"task_id": "Mbpp/766", "solution": "from typing import List, Tuple\ndef pair_wise(lst: list) -> list:\n    \"\"\"Return a list of 2-tuples of consecutive items from lst.\n\n    Args:\n        lst (list): input list; SRS expects a Python list.\n\n    Returns:\n        list: list of 2-tuples (first, second) for consecutive elements.\n\n    Behavior per SRS:\n    - If len(lst) < 2 returns [] (FR4).\n    - Does not modify lst (FR6).\n    - Runs in O(n) time and O(1) auxiliary space excluding output (NFR2, NFR3).\n    - Deterministic: same input -> same output (NFR4).\n    \"\"\"\n    output_pairs = []\n    for i in range(len(lst) - 1):\n        output_pairs.append((lst[i], lst[i+1]))\n    return output_pairs"}
{"task_id": "Mbpp/765", "solution": "class Error:\n    def __init__(self, message: str):\n        self.message = message\nclass ErrorHandler:\n    def createValidationError(self, msg: str) -> Error:\n        return Error(msg)\n_error_handler_instance = ErrorHandler()\nclass InputValidator:\n    def __init__(self, error_handler: ErrorHandler):\n        self._error_handler = error_handler\n\n    def validatePositiveInteger(self, n: int) -> None:\n        \"\"\"\n        Validates that n is a positive integer.\n        Raises ValueError if validation fails.\n        \"\"\"\n        if not isinstance(n, int) or n <= 0:\n            error = self._error_handler.createValidationError(\"n must be a positive integer\")\n            raise ValueError(error.message)\nclass PoliteNumberService:\n    @staticmethod\n    def isRepresentable(x: int) -> bool:\n        \"\"\"\n        Determines if x can be expressed as a sum of two or more consecutive positive integers.\n        A positive integer is polite if and only if it is not a power of 2.\n        \"\"\"\n        if x <= 0:\n            return False\n        return (x & (x - 1)) != 0\n\n    def __init__(self, input_validator, polite_number_sequence):\n        self._input_validator = input_validator\n        self._polite_number_sequence = polite_number_sequence\n\n    def getNthPolite(self, n: int) -> int:\n        \"\"\"\n        Orchestrates validation and retrieves the nth polite number.\n        \"\"\"\n        self._input_validator.validatePositiveInteger(n)\n        return self._polite_number_sequence.nth(n)\nclass PoliteNumberSequence:\n    def __init__(self, is_representable_func):\n        self._cache: list[int] = []\n        self._last_checked: int = 0\n        self._is_representable = is_representable_func\n\n    def nth(self, n: int) -> int:\n        \"\"\"\n        Ensures the cache contains at least n polite numbers and returns the nth.\n        \"\"\"\n        self.generateUpTo(n)\n        return self._cache[n - 1]\n\n    def generateUpTo(self, n: int) -> None:\n        \"\"\"\n        Generates polite numbers until the cache length is at least n.\n        \"\"\"\n        while len(self._cache) < n:\n            self._last_checked += 1\n            if self._is_representable(self._last_checked):\n                self._cache.append(self._last_checked)\n_input_validator_instance = InputValidator(_error_handler_instance)\n_polite_number_sequence_instance = PoliteNumberSequence(PoliteNumberService.isRepresentable)\n_polite_number_service_instance = PoliteNumberService(\n    _input_validator_instance,\n    _polite_number_sequence_instance\n)\ndef is_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number (1-based).\n    A polite number is a positive integer not expressible as a power of 2.\n    \"\"\"\n    return _polite_number_service_instance.getNthPolite(n)"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(nums, sum):\n    \"\"\"\n    Counts the number of pairs whose sum is equal to 'sum'.\n    Treats elements at different indices as distinct.\n    \"\"\"\n    if len(nums) < 2:\n        return 0\n\n    count = 0\n    seen = {}\n\n    for value in nums:\n        complement = sum - value\n        if complement in seen:\n            count += seen[complement]\n        seen[value] = seen.get(value, 0) + 1\n            \n    return count"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1, list2):\n    \"\"\"\n    Computes the difference between two lists, returning elements from list1 not present in list2,\n    preserving the relative order of elements from list1.\n    \"\"\"\n    set2 = set(list2)\n    \n    result = []\n    for item in list1:\n        if item not in set2:\n            result.append(item)\n            \n    return result"}
{"task_id": "Mbpp/770", "solution": "class InputValidator:\n    \"\"\"Validates input parameters for type and value constraints.\"\"\"\n    def validate_integer(self, n) -> None:\n        if not isinstance(n, int):\n            raise TypeError(\"n must be an int\")\n\n    def validate_non_negative(self, n) -> None:\n        if n < 1:\n            raise ValueError(\"n must be >= 1\")\nclass OddNumberSequence:\n    \"\"\"Provides methods to get odd numbers.\"\"\"\n    def get_kth(self, k: int) -> int:\n        return 2 * k - 1\nclass Result:\n    \"\"\"A container for the final integer result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\ndef odd_num_sum(n: int) -> int:\n    \"\"\"\n    Finds the sum of the fourth power of the first n odd natural numbers.\n    Validates input and computes the sum S(n) = sum_{k=1..n} (2*k - 1)^4.\n    \"\"\"\n    validator = InputValidator()\n    validator.validate_integer(n)\n    validator.validate_non_negative(n)\n\n    total_sum = 0\n    odd_seq_generator = OddNumberSequence()\n\n    for k in range(1, n + 1):\n        odd_num = odd_seq_generator.get_kth(k)\n        total_sum += odd_num ** 4\n    \n    result_container = Result(total_sum)\n    return result_container.value"}
{"task_id": "Mbpp/771", "solution": "from typing import List, Optional\nclass BracketToken:\n    \"\"\"Represents a bracket token encountered while parsing.\"\"\"\n    def __init__(self, symbol: str, kind: str, type: str, position: int):\n        self.symbol = symbol\n        self.kind = kind\n        self.type = type\n        self.position = position\nclass Stack:\n    \"\"\"LIFO stack type used by the matcher.\"\"\"\n    def __init__(self):\n        self._items: List[BracketToken] = []\n\n    def push(self, token: BracketToken) -> None:\n        self._items.append(token)\n\n    def pop(self) -> BracketToken:\n        return self._items.pop()\n\n    def peek(self) -> Optional[BracketToken]:\n        if not self._items:\n            return None\n        return self._items[-1]\n\n    def is_empty(self) -> bool:\n        return len(self._items) == 0\ndef parse_to_tokens(expression: str) -> List[BracketToken]:\n    \"\"\"Scans input string and produces list of BracketToken instances, ignoring non-bracket characters.\"\"\"\n    tokens: List[BracketToken] = []\n    bracket_map = {\n        '(': {'kind': 'opening', 'type': 'paren'}, ')': {'kind': 'closing', 'type': 'paren'},\n        '[': {'kind': 'opening', 'type': 'square'}, ']': {'kind': 'closing', 'type': 'square'},\n        '{': {'kind': 'opening', 'type': 'curly'}, '}': {'kind': 'closing', 'type': 'curly'},\n    }\n\n    for i, char in enumerate(expression):\n        if char in bracket_map:\n            info = bracket_map[char]\n            tokens.append(BracketToken(char, info['kind'], info['type'], i))\n    return tokens\ndef _is_matching(opening_symbol: str, closing_symbol: str) -> bool:\n    \"\"\"Checks if the given opening and closing bracket symbols form a matching pair.\"\"\"\n    return (opening_symbol == '(' and closing_symbol == ')') or \\\n           (opening_symbol == '[' and closing_symbol == ']') or \\\n           (opening_symbol == '{' and closing_symbol == '}')\ndef check_expression(expression: str) -> bool:\n    \"\"\"Checks if the given expression has balanced brackets.\"\"\"\n    if not expression:\n        return True\n\n    bracket_tokens = parse_to_tokens(expression)\n    s = Stack()\n\n    for token in bracket_tokens:\n        if token.kind == 'opening':\n            s.push(token)\n        else:  # closing bracket\n            if s.is_empty():\n                return False  # Closing bracket without a corresponding opening bracket\n            \n            opening_token = s.pop()\n            if not _is_matching(opening_token.symbol, token.symbol):\n                return False  # Mismatched bracket types\n\n    return s.is_empty()  # If stack is empty, all opening brackets were matched"}
{"task_id": "Mbpp/772", "solution": "def _tokenize(s):\n    \"\"\"Splits the input string into a list of words by whitespace.\"\"\"\n    return s.split()\ndef _filter_words(words, k):\n    \"\"\"Filters out words of length k from a list of words, preserving order.\"\"\"\n    return [word for word in words if len(word) != k]\ndef _join_words(words):\n    \"\"\"Joins a list of words into a single string with single spaces.\"\"\"\n    return \" \".join(words)\ndef remove_length(s, k):\n    \"\"\"\n    Removes all words with length k from the given string.\n    Normalizes whitespace and preserves word order.\n    \"\"\"\n    _validate_inputs(s, k)\n    words = _tokenize(s)\n    filtered_words = _filter_words(words, k)\n    result_string = _join_words(filtered_words)\n    return result_string"}
{"task_id": "Mbpp/773", "solution": "class MatchResult:\n    \"\"\"\n    Immutable container for a substring match result.\n    Provides a method to convert the result to a tuple format.\n    \"\"\"\n    def __init__(self, matched_substring: str, start_index: int, end_index: int) -> None:\n        self.matched_substring = matched_substring\n        self.start_index = start_index\n        self.end_index = end_index\n\n    def as_tuple(self) -> tuple[str, int, int]:\n        \"\"\"Returns the match result as a tuple (matched_substring, start_index, end_index).\"\"\"\n        return (self.matched_substring, self.start_index, self.end_index)\nclass StringSearch:\n    \"\"\"\n    Encapsulates the logic for finding the first occurrence of a substring.\n    \"\"\"\n    def __init__(self, source_string: str, substring_to_find: str) -> None:\n        self.source_string = source_string\n        self.substring_to_find = substring_to_find\n\n    def occurrence_substring(self) -> MatchResult | None:\n        \"\"\"\n        Finds the first occurrence of the substring in the source string.\n        Returns a MatchResult object if found, otherwise None.\n        \"\"\"\n        index = self.source_string.find(self.substring_to_find)\n        if index >= 0:\n            end_index = index + len(self.substring_to_find)\n            return MatchResult(self.substring_to_find, index, end_index)\n        else:\n            return None\ndef occurance_substring(source_string: str, substring_to_find: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Finds the first occurrence and position of the substring within a string.\n    Returns None if there is no match.\n    \"\"\"\n    string_search_instance = StringSearch(source_string, substring_to_find)\n    result = string_search_instance.occurrence_substring()\n\n    if result is None:\n        return None\n    return result.as_tuple()"}
{"task_id": "Mbpp/777", "solution": "import collections\ndef find_sum(input_list: list[int]) -> int:\n    \"\"\"Computes the sum of elements that appear exactly once in the input list.\"\"\"\n    if not input_list:\n        return 0\n\n    counts = collections.Counter(input_list)\n    total_sum = 0\n    for element, count in counts.items():\n        if count == 1:\n            total_sum += element\n    return total_sum"}
{"task_id": "Mbpp/775", "solution": "def is_odd(value):\n    \"\"\"\n    Checks if an integer value is odd.\n    \"\"\"\n    return value % 2 != 0\ndef odd_position(lst):\n    \"\"\"\n    Checks if every odd-indexed element in a list is an odd number.\n    Returns True if all elements at odd indices are odd, False otherwise.\n    \"\"\"\n    validate_input(lst)\n    # Iterate through odd indices (1, 3, 5, ...)\n    for i in range(1, len(lst), 2):\n        if not is_odd(lst[i]):\n            return False\n    return True"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list) -> list:\n    \"\"\"\n    Pack consecutive duplicates of a given list elements into sublists.\n\n    Behavior requirements:\n    - Accepts a list of elements and returns a list of sublists (each inner list contains one or more consecutive equal elements).\n    - Must not mutate input_list.\n    - Deterministic: same input => same output.\n    - If input_list is empty, return an empty list [].\n\n    Parameters:\n    - input_list: list (elements of any type that implement value equality ==)\n\n    Returns:\n    - list of lists: each inner list contains one or more elements that were consecutive and equal in input_list.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = []\n    current_group = [input_list[0]]\n\n    for item in input_list[1:]:\n        if item == current_group[-1]:\n            current_group.append(item)\n        else:\n            result.append(current_group)\n            current_group = [item]\n            \n    result.append(current_group) # Append the last collected group\n    return result"}
{"task_id": "Mbpp/782", "solution": "def _sum_by_contribution(nums: list[int]) -> int:\n    \"\"\"Internal helper implementing the numeric computation using a contribution-based approach.\n    It sums the product of each element with the number of odd-length subarrays it belongs to.\"\"\"\n    n = len(nums)\n    total_sum = 0\n    for i in range(n):\n        # Calculate the count of start positions 'j' (left distances 'l') such that 'l = i - j' is even/odd.\n        # 'l' ranges from 0 to 'i'.\n        num_even_left_distances = (i // 2) + 1\n        num_odd_left_distances = ((i + 1) // 2)\n        \n        # Calculate the count of end positions 'k' (right distances 'r') such that 'r = k - i' is even/odd.\n        # 'r' ranges from 0 to (n - 1 - i).\n        num_even_right_distances = ((n - 1 - i) // 2) + 1\n        num_odd_right_distances = (((n - 1 - i) + 1) // 2)\n\n        # An odd-length subarray has length (l + 1 + r). For this to be odd, (l + r) must be even.\n        # (l + r) is even if both 'l' and 'r' are even, or both 'l' and 'r' are odd.\n        count_odd_length_subarrays_for_element = (num_even_left_distances * num_even_right_distances) + \\\n                                                  (num_odd_left_distances * num_odd_right_distances)\n        \n        total_sum += nums[i] * count_odd_length_subarrays_for_element\n        \n    return total_sum\ndef odd_length_sum(input_list: list[int]) -> int:\n    \"\"\"Computes and returns the sum of all elements across every contiguous subarray of odd length.\n    It leverages an internal helper for the contribution-based calculation.\"\"\"\n    return _sum_by_contribution(input_list)"}
{"task_id": "Mbpp/781", "solution": "from dataclasses import dataclass\nfrom typing import List\nimport math\nclass DivisorCalculator:\n    def count_divisors(self, n: int) -> int:\n        \"\"\"Return the number of positive divisors of n.\"\"\"\n        count = 0\n        # Iterate from 1 up to the square root of n\n        for i in range(1, math.isqrt(n) + 1):\n            if n % i == 0:\n                # If i divides n, then n/i also divides n\n                if i * i == n:\n                    # If i is the square root, it's counted once\n                    count += 1\n                else:\n                    # Otherwise, i and n/i are distinct divisors\n                    count += 2\n        return count\n\n    def is_count_even(self, n: int) -> bool:\n        \"\"\"Return True if number of positive divisors of n is even.\"\"\"\n        return self.count_divisors(n) % 2 == 0\ndef count_divisors(n):\n    \"\"\"Public API per SRS: returns True when number of positive divisors of n is even, False otherwise.\n\n    Validation: ensures n is int and n >= 1 (see Optional / Justification).\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\n    calculator = DivisorCalculator()\n    return calculator.is_count_even(n)"}
{"task_id": "Mbpp/784", "solution": "first_odd = None\nfirst_even = None\n\nif not isinstance(input_list, list):\n    raise TypeError(\"input_list must be a list of integers\")\n\nfor element in input_list:\n    if not isinstance(element, int):\n        raise TypeError(\"all elements of input_list must be integers\")\n    if first_odd is None and element % 2 != 0:\n        first_odd = element\n    if first_even is None and element % 2 == 0:\n        first_even = element\n    if first_odd is not None and first_even is not None:\n        break\n\nif first_odd is None or first_even is None:\n    raise ValueError(\"input_list must contain at least one odd and one even integer\")\n\nreturn first_odd * first_even"}
{"task_id": "Mbpp/780", "solution": "class Tuple2:\n    \"\"\"Domain representation of a 2-element integer tuple.\"\"\"\n    def __init__(self, a: int, b: int) -> None:\n        self.a = a\n        self.b = b\n\n    def isValid(self) -> bool:\n        \"\"\"Indicates if the tuple elements are considered valid.\"\"\"\n        return True\n\n    def to_tuple(self) -> tuple[int, int]:\n        \"\"\"Converts the Tuple2 instance to a standard Python tuple.\"\"\"\n        return (self.a, self.b)\nclass InputList:\n    \"\"\"Domain wrapper for the caller-provided sequence; exposes length and index access.\"\"\"\n    def __init__(self, raw_list: list[tuple[int, int]]) -> None:\n        self._raw_list = raw_list\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the input list.\"\"\"\n        return len(self._raw_list)\n\n    def __getitem__(self, index: int) -> Tuple2:\n        \"\"\"Returns the element at the given index as a Tuple2.\"\"\"\n        raw_tuple = self._raw_list[index]\n        return Tuple2(raw_tuple[0], raw_tuple[1])\nclass Combination:\n    \"\"\"Domain representation of the element-wise sum of two Tuple2 instances.\"\"\"\n    def __init__(self, a_sum: int, b_sum: int, pair_indices: tuple[int, int] | None = None) -> None:\n        self.a_sum = a_sum\n        self.b_sum = b_sum\n        self.pair_indices = pair_indices\n\n    @classmethod\n    def from_(cls, tuple1: Tuple2, tuple2: Tuple2, indices: tuple[int, int] | None = None) -> 'Combination':\n        \"\"\"Creates a Combination from two Tuple2 instances by summing their elements.\"\"\"\n        a_sum = tuple1.a + tuple2.a\n        b_sum = tuple1.b + tuple2.b\n        return cls(a_sum, b_sum, indices)\n\n    def to_tuple(self) -> tuple[int, int]:\n        \"\"\"Converts the Combination instance to a standard Python tuple.\"\"\"\n        return (self.a_sum, self.b_sum)\nclass Validator:\n    \"\"\"Validates InputList and each Tuple2 per SRS.\"\"\"\n    def validateList(self, input_list: InputList) -> None:\n        \"\"\"Per strict interpretation of constraints, this method performs no validation.\"\"\"\n        pass\n\n    def validateTuple(self, tuple2: Tuple2) -> bool:\n        \"\"\"Per strict interpretation of constraints, this method assumes validity.\"\"\"\n        return tuple2.isValid()\nclass CombinationGenerator:\n    \"\"\"Generates combinations and orders them by index.\"\"\"\n    def generate(self, input_list: InputList) -> list[Combination]:\n        \"\"\"Generates all unique ordered-pair combinations from the input list.\"\"\"\n        combinations = []\n        n = input_list.length()\n        if n < 2:\n            return []\n\n        for i in range(n - 1):\n            tuple1 = input_list[i]\n            for j in range(i + 1, n):\n                tuple2 = input_list[j]\n                combination = Combination.from_(tuple1, tuple2, indices=(i + 1, j + 1))\n                combinations.append(combination)\n        return combinations\ndef find_combinations(input_list: list[tuple[int, int]]) -> list[tuple[int, int]]:\n    \"\"\"\n    Finds combinations of sums with tuples in the given tuple list, following a specific design.\n    It wraps input, performs (potential) validation, and generates ordered element-wise sums.\n    \"\"\"\n    wrapped = InputList(input_list)\n    validator = Validator()\n    validator.validateList(wrapped)\n\n    generator = CombinationGenerator()\n    combinations = generator.generate(wrapped)\n\n    return [c.to_tuple() for c in combinations]"}
{"task_id": "Mbpp/785", "solution": "import re\nclass TupleString:\n    \"\"\"Data holder for the raw input string.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\nclass IntegerTuple:\n    \"\"\"Data holder for the output tuple of integers.\"\"\"\n    def __init__(self, values: tuple[int]):\n        self.values = values\nclass Parser:\n    \"\"\"Stateless component for parsing tuple strings into integer tuples.\"\"\"\n\n    _TOKEN_PATTERN = re.compile(r'\\(|\\)|,|[^(),\\s]+')\n\n    @staticmethod\n    def tuple_str_int(s: str) -> tuple:\n        \"\"\"\n        Parses a tuple string into an integer tuple.\n        Delegates to private methods for tokenization, validation, and conversion.\n        \"\"\"\n        # Consumes TupleString as per design, even if not directly used later.\n        _ = TupleString(raw=s)\n\n        tokens = Parser._tokenize(s)\n        Parser._validate_tokens(tokens)\n        \n        # Creates IntegerTuple as per design, but returns its values to match API signature.\n        integer_tuple_obj = IntegerTuple(values=Parser._to_ints(tokens))\n        return integer_tuple_obj.values\n\n    @staticmethod\n    def _tokenize(raw: str) -> list[str]:\n        \"\"\"\n        Produces token strings (numbers, commas, parentheses), ignoring surrounding whitespace.\n        \"\"\"\n        # Finds all matches for explicit delimiters or sequences of non-delimiter/non-whitespace characters.\n        tokens = Parser._TOKEN_PATTERN.findall(raw)\n        return tokens\n\n    @staticmethod\n    def _validate_tokens(tokens: list[str]) -> None:\n        \"\"\"\n        Ensures the token sequence matches the grammar: '(' NUMBER (',' NUMBER)* ')'.\n        Raises ValueError for invalid formats.\n        \"\"\"\n        if not tokens:\n            raise ValueError(\"Input cannot be empty.\")\n\n        # A valid minimal tuple string is \"(N)\".\n        if len(tokens) < 3:\n            raise ValueError(\"Input must be a parenthesized list of integers.\")\n\n        # Check for correct opening and closing parentheses.\n        if tokens[0] != '(' or tokens[-1] != ')':\n            raise ValueError(\"Input must be a parenthesized list of integers.\")\n\n        # Extract content between parentheses for validation.\n        content_tokens = tokens[1:-1]\n\n        # Handle empty tuple \"()\", which is considered invalid per the grammar `NUMBER (',' NUMBER)*`.\n        if not content_tokens:\n            raise ValueError(\"Tuple must contain at least one integer.\")\n\n        # The content must have an odd number of elements (N, or N,C,N, or N,C,N,C,N...).\n        if len(content_tokens) % 2 == 0:\n            raise ValueError(\"Malformed tuple content: odd number of elements (integer followed by comma) expected.\")\n\n        # Validate the alternating pattern: number, comma, number...\n        for i, token in enumerate(content_tokens):\n            if i % 2 == 0:  # Expected integer string\n                try:\n                    int(token) # Check if it's a valid integer.\n                except ValueError:\n                    raise ValueError(f\"Invalid integer token found: '{token}'\")\n            else:  # Expected comma\n                if token != ',':\n                    raise ValueError(f\"Expected ',' but found '{token}'\")\n\n    @staticmethod\n    def _to_ints(tokens: list[str]) -> tuple[int]:\n        \"\"\"\n        Converts numeric tokens (extracted from the validated sequence) to integers.\n        \"\"\"\n        int_values = []\n        # Numeric tokens are at odd indices of the original token list: tokens[1], tokens[3], ...\n        for i in range(1, len(tokens) - 1, 2):\n            int_values.append(int(tokens[i]))\n        return tuple(int_values)\ndef tuple_str_int(s: str) -> tuple:\n    \"\"\"\n    Converts a string representation of a tuple (e.g., \"(7, 8, 9)\") to an actual tuple of integers.\n    \"\"\"\n    return Parser.tuple_str_int(s)"}
