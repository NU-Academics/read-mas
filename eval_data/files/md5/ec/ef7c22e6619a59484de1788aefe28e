{"task_id": "Mbpp/20", "solution": "from typing import Optional\nclass CheckResult:\n    \"\"\"Encapsulates the result of a Woodall number check.\"\"\"\n    def __init__(self, isWoodall: bool, matchingK: Optional[int]) -> None:\n        self.isWoodall = isWoodall\n        self.matchingK = matchingK\nclass WoodallCandidate:\n    \"\"\"Computes a Woodall candidate for a given k.\"\"\"\n    @staticmethod\n    def compute(k: int) -> int:\n        return k * (2**k) - 1\nclass WoodallChecker:\n    \"\"\"Orchestrates the sequential generation of candidates and decides membership.\"\"\"\n    def is_woodall(self, x: int) -> bool:\n        result = self._generate_candidates_until(x)\n        return result.isWoodall\n\n    def _generate_candidates_until(self, x: int) -> CheckResult:\n        \"\"\"Generates Woodall candidates until a match is found or exceeded.\"\"\"\n        k = 1\n        while True:\n            candidate_value = WoodallCandidate.compute(k)\n            if candidate_value == x:\n                return CheckResult(isWoodall=True, matchingK=k)\n            elif candidate_value > x:\n                return CheckResult(isWoodall=False, matchingK=None)\n            k += 1\ndef is_woodall(x: int) -> bool:\n    \"\"\"\n    Checks if the given number is a Woodall number.\n    A Woodall number is of the form k * 2^k - 1 for integer k >= 1.\n    \"\"\"\n    checker = WoodallChecker()\n    return checker.is_woodall(x)"}
