{"task_id": "Mbpp/12", "solution": "from typing import List, Any\nclass ValidationError(Exception):\n    \"\"\"Custom exception for invalid matrix input.\"\"\"\n    pass\nclass Validator:\n    \"\"\"Validates matrix input for correct structure and element types.\"\"\"\n    def validate(self, matrix: Any) -> None:\n        if not isinstance(matrix, list):\n            raise ValidationError(\"Input must be a list.\")\n        for i, row in enumerate(matrix):\n            if not isinstance(row, list):\n                raise ValidationError(f\"Row {i} must be a list.\")\n            for j, element in enumerate(row):\n                if not isinstance(element, (int, float)):\n                    raise ValidationError(f\"Element at [{i}][{j}] must be a number.\")\nclass Row:\n    \"\"\"Represents a single row of numeric elements, preserving its original index.\"\"\"\n    def __init__(self, elements: List[float], index: int) -> None:\n        self.elements = elements\n        self.index = index\n\n    def sum(self) -> float:\n        \"\"\"Calculates the sum of elements in the row.\"\"\"\n        return float(sum(self.elements))\nclass Matrix:\n    \"\"\"A domain container for a list of Row objects.\"\"\"\n    def __init__(self, rows: List['Row']) -> None:\n        self.rows = rows\n\n    def get_row_sums(self) -> List[float]:\n        \"\"\"Returns a list of sums for each row in the matrix.\"\"\"\n        return [row.sum() for row in self.rows]\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the matrix contains no rows.\"\"\"\n        return not self.rows\n\n    def get_rows_as_lists(self) -> List[List[float]]:\n        \"\"\"Converts the internal Row objects back to a list of lists.\"\"\"\n        return [row.elements for row in self.rows]\nclass SortService:\n    \"\"\"Sorts Matrix rows based on their sums in ascending order.\"\"\"\n    def sort_by_row_sum(self, matrix: 'Matrix') -> 'Matrix':\n        \"\"\"Sorts the matrix's rows by their sum, maintaining stable order for equal sums.\"\"\"\n        if matrix.is_empty():\n            return Matrix(rows=[])\n\n        rows_with_sums_and_indices = [\n            (row.sum(), row.index, row) for row in matrix.rows\n        ]\n\n        rows_with_sums_and_indices.sort(key=lambda x: x[0])\n\n        sorted_rows = [item[2] for item in rows_with_sums_and_indices]\n\n        return Matrix(rows=sorted_rows)\nclass Result:\n    \"\"\"A wrapper class to hold the sorted Matrix for returning to the caller.\"\"\"\n    def __init__(self, matrix: 'Matrix') -> None:\n        self.matrix = matrix\n\n    def matrix_as_lists(self) -> List[List[float]]:\n        \"\"\"Returns the contained Matrix as a standard list of lists.\"\"\"\n        return self.matrix.get_rows_as_lists()\ndef sort_matrix(matrix: List[List[float]]) -> List[List[float]]:\n    \"\"\"Sorts a given matrix in ascending order according to the sum of its rows.\"\"\"\n    validator = Validator()\n    validator.validate(matrix)\n\n    domain_rows = [Row(elements=row, index=i) for i, row in enumerate(matrix)]\n    domain_matrix = Matrix(rows=domain_rows)\n\n    sorted_domain_matrix = SortService().sort_by_row_sum(domain_matrix)\n\n    result = Result(sorted_domain_matrix)\n    return result.matrix_as_lists()"}
