{"task_id": "Mbpp/116", "solution": "from typing import List\nclass IntegerElement:\n    \"\"\"Encapsulates a single integer element.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def decimal_digits(self) -> int:\n        \"\"\"Returns the number of decimal digits in the integer value.\"\"\"\n        return len(str(self.value))\nclass InputTuple:\n    \"\"\"Wraps a raw tuple and exposes its elements as IntegerElement objects.\"\"\"\n    def __init__(self, raw_tuple: tuple) -> None:\n        self.elements: List[IntegerElement] = [IntegerElement(value) for value in raw_tuple]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the tuple.\"\"\"\n        return len(self.elements)\nclass OutputInteger:\n    \"\"\"Represents the resulting concatenated integer.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def repr(self) -> str:\n        \"\"\"Returns the decimal string representation of the integer value.\"\"\"\n        return str(self.value)\nclass TupleConverter:\n    \"\"\"Converts a tuple of positive integers into a single integer.\"\"\"\n    def tuple_to_int(self, input_tuple: tuple) -> int:\n        \"\"\"Public entry point to validate and convert a tuple to a concatenated integer.\"\"\"\n        self._validate(input_tuple)\n        \n        input_tuple_obj = InputTuple(input_tuple)\n        \n        elements_for_concat = [ie.value for ie in input_tuple_obj.elements]\n        \n        concatenated_value = self._concatenate(elements_for_concat)\n        \n        output_int_obj = OutputInteger(concatenated_value)\n        return output_int_obj.value\n\n    def _validate(self, input_tuple: tuple) -> None:\n        \"\"\"Validates the input tuple and its elements.\"\"\"\n        if not isinstance(input_tuple, tuple):\n            raise TypeError(\"Input must be a tuple.\")\n        if not input_tuple:\n            raise ValueError(\"Input tuple cannot be empty.\")\n        for element in input_tuple:\n            if not isinstance(element, int):\n                raise ValueError(\"All elements in the tuple must be integers.\")\n            if element <= 0:\n                raise ValueError(\"All elements in the tuple must be positive integers.\")\n\n    def _concatenate(self, elements: List[int]) -> int:\n        \"\"\"Concatenates decimal string representations of elements into a single integer.\"\"\"\n        str_elements = [str(e) for e in elements]\n        return int(\"\".join(str_elements))\ndef tuple_to_int(input_tuple: tuple) -> int:\n    \"\"\"\n    Converts a tuple of positive integers into a single integer by concatenating their string representations.\n    Raises TypeError if input is not a tuple; raises ValueError for empty tuple or invalid elements.\n    \"\"\"\n    return TupleConverter().tuple_to_int(input_tuple)"}
{"task_id": "Mbpp/119", "solution": "from typing import List\nfrom collections import Counter\ndef _is_sorted(nums: List[int]) -> bool:\n    \"\"\"Checks if the list is sorted in non-decreasing order.\"\"\"\n    if not nums:\n        return True\n    for i in range(len(nums) - 1):\n        if nums[i] > nums[i+1]:\n            return False\n    return True\ndef search(nums: List[int]) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where all other\n    elements appear exactly twice.\n    \"\"\"\n    if not _is_sorted(nums):\n        raise ValueError(\"Input list must be sorted in non-decreasing order.\")\n    \n    _validate_multiplicity(nums)\n\n    low, high = 0, len(nums) - 1\n\n    while low < high:\n        mid = (low + high) // 2\n        \n        # If mid is even\n        if mid % 2 == 0:\n            if nums[mid] == nums[mid + 1]:\n                low = mid + 2\n            else:\n                high = mid\n        # If mid is odd\n        else: # mid % 2 != 0\n            if nums[mid] == nums[mid - 1]:\n                low = mid + 1\n            else:\n                high = mid\n                \n    return nums[low]"}
{"task_id": "Mbpp/120", "solution": "class Validator:\n    def is_list(self, obj):\n        # As per design, \"list (or iterable)\" - checking for list or tuple covers the typical containers\n        # expected for structured data like lists of tuples.\n        return isinstance(obj, (list, tuple))\n\n    def is_tuple_of_length_2(self, t):\n        return isinstance(t, tuple) and len(t) == 2\n\n    def elements_are_numeric(self, t):\n        # Assumes t is a 2-element tuple\n        return isinstance(t[0], (int, float)) and isinstance(t[1], (int, float))\n\n    def validate(self, input_tuples):\n        if not self.is_list(input_tuples):\n            raise ValueError(\"Input must be a list or tuple of 2-element numeric tuples.\")\n\n        for item in input_tuples:\n            if not self.is_tuple_of_length_2(item):\n                raise ValueError(\"All elements in the input list must be 2-element tuples.\")\n            if not self.elements_are_numeric(item):\n                raise ValueError(\"All tuple elements must be numeric (int or float).\")\nclass TuplePair:\n    def __init__(self, a, b):\n        self.a = a\n        self.b = b\n\n    def product(self):\n        return self.a * self.b\n\n    def abs_product(self):\n        return abs(self.product())\nclass MaxProductFunction:\n    def __init__(self, input_tuples):\n        self.input_tuples = input_tuples\n\n    def compute(self):\n        return self.find_max_abs_product()\n\n    def find_max_abs_product(self):\n        if not self.input_tuples:\n            return 0\n\n        max_abs_prod = 0\n        for t in self.input_tuples:\n            pair = TuplePair(t[0], t[1])\n            current_abs_prod = pair.abs_product()\n            if current_abs_prod > max_abs_prod:\n                max_abs_prod = current_abs_prod\n        return max_abs_prod\ndef max_product_tuple(input_tuples):\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    Returns 0 for an empty input list. Raises ValueError for invalid input.\n    \"\"\"\n    validator = Validator()\n    validator.validate(input_tuples)\n\n    processor = MaxProductFunction(input_tuples)\n    result_value = processor.compute()\n    \n    return result_value"}
{"task_id": "Mbpp/124", "solution": "import math\nclass AngleCalculator:\n    \"\"\"\n    Calculates the argument (angle) of a complex number.\n    \"\"\"\n    def angle_complex(self, complex_input) -> float:\n        \"\"\"\n        Extracts real and imaginary parts and computes the angle.\n        \"\"\"\n        real = complex_input.real\n        imag = complex_input.imag\n        return self._compute(real, imag)\n\n    def _compute(self, real: float, imag: float) -> float:\n        \"\"\"\n        Uses math.atan2 to compute the angle in radians.\n        \"\"\"\n        return math.atan2(imag, real)\ndef angle_complex(complex_input) -> float:\n    \"\"\"\n    Calculates the angle (argument) of a complex number in radians.\n    \"\"\"\n    calculator = AngleCalculator()\n    return calculator.angle_complex(complex_input)"}
