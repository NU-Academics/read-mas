{"task_id": "Mbpp/471", "solution": "from typing import List\ndef find_remainder(array: List[int], n: int) -> int:\n    \"\"\"\n    Computes the product of array elements modulo n, applying modular reduction at each step.\n    Returns an integer r such that 0 <= r < n.\n    \"\"\"\n    product_mod_n = 1 % n\n    for num in array:\n        product_mod_n = (product_mod_n * num) % n\n    return product_mod_n"}
{"task_id": "Mbpp/468", "solution": "from dataclasses import dataclass\nfrom typing import List, Union\nclass MaxProductFunction:\n    \"\"\"Encapsulates validation and computation for finding the maximum product of an increasing subsequence.\"\"\"\n\n    def validate(self, arr: list) -> bool:\n        \"\"\"\n        Checks if the input `arr` is a non-empty list containing only numeric values.\n        Returns True if valid, False otherwise.\n        \"\"\"\n        if not isinstance(arr, list):\n            return False\n        if not arr:  # An empty list cannot form a subsequence of length >= 1.\n            return False\n        for x in arr:\n            if not isinstance(x, (int, float)):\n                return False\n        return True\n\n    def compute(self, arr: List[float]) -> Product:\n        \"\"\"\n        Computes the maximum product of an increasing subsequence using dynamic programming.\n        This method assumes `arr` is a validated, non-empty list of floats.\n        \"\"\"\n        n = len(arr)\n        # max_prod[i] stores the maximum product of an increasing subsequence ending at arr[i].\n        # Initialize with single-element subsequences.\n        max_prod = list(arr)\n\n        for i in range(n):\n            for j in range(i):\n                if arr[j] < arr[i]:\n                    candidate = max_prod[j] * arr[i]\n                    if candidate > max_prod[i]:\n                        max_prod[i] = candidate\n\n        # The overall maximum product is the maximum value in max_prod.\n        return Product(value=max(max_prod))\n\n    def max_product(self, arr: List[Union[int, float]]) -> float:\n        \"\"\"\n        Validates the input array and computes the maximum product of an increasing subsequence.\n        Raises ValueError if the input is invalid.\n        \"\"\"\n        if not self.validate(arr):\n            raise ValueError(\"Input must be a non-empty list of numeric values.\")\n\n        # Convert all elements to float before passing to the computation method.\n        float_arr = [float(x) for x in arr]\n        product_result = self.compute(float_arr)\n        return product_result.value\ndef max_product(arr: List[Union[int, float]]) -> float:\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of an increasing subsequence of that array.\n    This function delegates to an internal MaxProductFunction for validation and computation.\n    \"\"\"\n    mpf = MaxProductFunction()\n    return mpf.max_product(arr)"}
{"task_id": "Mbpp/472", "solution": "def is_list(obj):\n    \"\"\"Return True if obj is a built-in list instance; else False.\"\"\"\n    return isinstance(obj, list)\ndef elements_are_ints(lst):\n    \"\"\"Return True if every element in lst is an int instance; else False.\"\"\"\n    return all(isinstance(x, int) for x in lst)\ndef check_Consecutive(lst):\n    \"\"\"Validate input, sort, and return True if sorted elements are consecutive integers (adj diffs == 1).\n\n    Raises:\n        TypeError: if lst is not a list or contains non-int elements.\n    Returns:\n        bool: True if consecutive, False otherwise.\n    \"\"\"\n    if not is_list(lst):\n        raise TypeError(\"Input must be a list.\")\n    if not elements_are_ints(lst):\n        raise TypeError(\"All elements in the list must be integers.\")\n\n    if len(lst) < 2:\n        return False\n\n    sorted_list = sorted(lst)\n\n    for i in range(len(sorted_list) - 1):\n        if sorted_list[i+1] - sorted_list[i] != 1:\n            return False\n            \n    return True"}
