{"task_id": "Mbpp/564", "solution": "def _compute_k(input_list, n):\n    \"\"\"\n    Computes k as the minimum of n and the length of input_list.\n    \"\"\"\n    return min(n, len(input_list))\ndef _build_frequency_map(seq):\n    \"\"\"\n    Builds a dictionary mapping value -> count for elements in seq.\n    \"\"\"\n    freq_map = {}\n    for item in seq:\n        freq_map[item] = freq_map.get(item, 0) + 1\n    return freq_map\ndef _count_unequal_pairs_from_freq(freq_map, k):\n    \"\"\"\n    Computes the number of unordered unequal pairs using frequency map and k.\n    \"\"\"\n    # Total possible pairs from k elements: C(k, 2)\n    total_pairs = k * (k - 1) // 2 if k > 1 else 0\n\n    # Pairs with same values: sum of C(count, 2) for each value\n    same_value_pairs = 0\n    for count in freq_map.values():\n        same_value_pairs += count * (count - 1) // 2\n\n    return total_pairs - same_value_pairs\ndef count_Pairs(input_list, n):\n    \"\"\"\n    Counts the number of possible unordered pairs where both elements are unequal\n    among the first k = min(n, len(input_list)) elements.\n    \"\"\"\n    _validate_inputs(input_list, n)\n\n    k = _compute_k(input_list, n)\n\n    if k <= 1:\n        return 0\n\n    seq = input_list[:k]\n    freq = _build_frequency_map(seq)\n    \n    return _count_unequal_pairs_from_freq(freq, k)"}
{"task_id": "Mbpp/567", "solution": "def issort_list(input_list: list) -> bool:\n    \"\"\"\n    Return True if input_list is sorted in ascending (non-decreasing) order; otherwise return False.\n    Must not modify input_list.\n    \"\"\"\n    if len(input_list) <= 1:\n        return True\n\n    for i in range(len(input_list) - 1):\n        if input_list[i] > input_list[i+1]:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/572", "solution": "def two_unique_nums(input_list: list) -> list:\n    \"\"\"Return list of elements that occur exactly once in input_list, preserving input order.\"\"\"\n\n    def _frequency_counter(input_list: list) -> dict:\n        \"\"\"Return a dict mapping each value in input_list to its occurrence count.\"\"\"\n        freq_map = {}\n        for item in input_list:\n            freq_map[item] = freq_map.get(item, 0) + 1\n        return freq_map\n\n    def _filter_unique_preserve_order(input_list: list, freq_map: dict) -> list:\n        \"\"\"Return a list of values from input_list whose frequency in freq_map is exactly 1, preserving order.\"\"\"\n        output_list = []\n        for item in input_list:\n            if freq_map[item] == 1:\n                output_list.append(item)\n        return output_list\n\n    freq_map = _frequency_counter(input_list)\n    return _filter_unique_preserve_order(input_list, freq_map)"}
