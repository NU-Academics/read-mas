{"task_id": "Mbpp/75", "solution": "def find_tuples(list_of_tuples, k):\n    \"\"\"\n    Finds tuples where all elements are divisible by k from a list of tuples.\n    This function filters the input list and returns a new list containing only the matching tuples.\n    \"\"\"\n    def _tuple_all_divisible(tpl, k_val):\n        \"\"\"\n        Checks if all elements within a given tuple are perfectly divisible by k_val.\n        Returns True if all elements are divisible, False otherwise.\n        \"\"\"\n        for element in tpl:\n            if element % k_val != 0:\n                return False\n        return True\n\n    result_tuples = []\n    for current_tuple in list_of_tuples:\n        if _tuple_all_divisible(current_tuple, k):\n            result_tuples.append(current_tuple)\n            \n    return result_tuples"}
{"task_id": "Mbpp/80", "solution": "def tetrahedral_number(n: int) -> int:\n    \"\"\"Return the nth tetrahedral number as an int.\"\"\"\n    return n * (n + 1) * (n + 2) // 6"}
{"task_id": "Mbpp/85", "solution": "import math\nclass MathLibrary:\n    \"\"\"Provides the value of pi from the math library.\"\"\"\n    pi: float = math.pi\nclass Calculation:\n    \"\"\"Encapsulates the formula for sphere surface area.\"\"\"\n    def compute_surface_area(self, radius: float) -> float:\n        \"\"\"Calculates the surface area using 4 * pi * radius^2.\"\"\"\n        return 4 * MathLibrary.pi * radius ** 2\nclass Sphere:\n    \"\"\"Represents a sphere with its radius and surface area.\"\"\"\n    def __init__(self, radius: float) -> None:\n        self.radius = radius\n        self.surface_area = 0.0\ndef surfacearea_sphere(radius):\n    \"\"\"Calculates the surface area of a sphere given its radius.\"\"\"\n    sphere = Sphere(radius)\n    calc = Calculation()\n    surface_area = calc.compute_surface_area(radius)\n    sphere.surface_area = surface_area\n    return surface_area"}
{"task_id": "Mbpp/82", "solution": "import math\nclass NumericInput:\n    def __init__(self, value):\n        self.value = value\n    def validate(self) -> bool:\n        # returns True if self.value is int/float and not a bool; else False\n        return isinstance(self.value, (int, float)) and not isinstance(self.value, bool)\nclass Sphere:\n    def __init__(self, radius: float):\n        self.radius: float = radius\n        self.volume: float = 0.0\n    def computeVolume(self) -> None:\n        # computes self.volume = 4.0/3.0 * math.pi * self.radius ** 3\n        self.volume = (4.0 / 3.0) * math.pi * (self.radius ** 3)\nclass VolumeResult:\n    def __init__(self, value: float, units: str = None):\n        self.value = value\n        self.units = units\nclass ErrorHandler:\n    @staticmethod\n    def raise_invalid_input(message: str):\n        raise ValueError(message)\nclass VolumeCalculator:\n    @staticmethod\n    def computeSphere(radius) -> Sphere:\n        # returns Sphere instance with computed volume\n        sphere = Sphere(radius)\n        sphere.computeVolume()\n        return sphere\n\n    @staticmethod\n    def volume_sphere(radius) -> float:\n        # Can directly compute or construct Sphere and return computed float volume\n        sphere = VolumeCalculator.computeSphere(radius)\n        result = VolumeResult(value=sphere.volume)\n        return result.value\ndef volume_sphere(radius):\n    \"\"\"Public API required by FR1. Accepts numeric radius (int or float) and returns float volume.\"\"\"\n    validator = NumericInput(radius)\n    if not validator.validate():\n        ErrorHandler.raise_invalid_input('radius must be numeric (int or float)')\n    return VolumeCalculator.volume_sphere(radius)"}
{"task_id": "Mbpp/84", "solution": "from typing import Dict, Optional\nclass InvalidInputError(Exception):\n    \"\"\"\n    Exception raised for invalid input to the sequence function.\n    Contains a message detailing the invalid input.\n    \"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\nclass SequenceCache:\n    \"\"\"\n    Caches computed Newman-Conway sequence values to avoid re-computation.\n    Stores results in an internal dictionary.\n    \"\"\"\n    def __init__(self):\n        self._store: Dict[int, int] = {}\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a cached value for n, if present.\"\"\"\n        return self._store.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a computed value for n in the cache.\"\"\"\n        self._store[n] = value\nclass InputValidator:\n    \"\"\"\n    Validates input for the Newman-Conway sequence function.\n    Ensures n is an integer and n >= 1.\n    \"\"\"\n    def validate(self, n: int) -> None:\n        \"\"\"Raises InvalidInputError if n is not an integer or n < 1.\"\"\"\n        if not isinstance(n, int):\n            raise InvalidInputError(\"Input must be an integer.\")\n        if n < 1:\n            raise InvalidInputError(\"Input must be a positive integer (n >= 1).\")\nclass NewmanConwayCalculator:\n    \"\"\"\n    Calculates the nth Newman-Conway number using memoization.\n    Implements the recurrence relation a(n) = a(a(n-1)) + a(n - a(n-1)).\n    \"\"\"\n    def __init__(self, cache: SequenceCache):\n        self._cache = cache\n\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Computes the nth Newman-Conway number, utilizing the cache.\n        Handles base cases a(1)=1, a(2)=1 and the recurrence for n > 2.\n        \"\"\"\n        cached_value = self._cache.get(n)\n        if cached_value is not None:\n            return cached_value\n\n        if n == 1 or n == 2:\n            value = 1\n        else:\n            # a(n) = a(a(n-1)) + a(n - a(n-1))\n            a_n_minus_1 = self.compute(n - 1)\n            term1 = self.compute(a_n_minus_1)\n            term2 = self.compute(n - a_n_minus_1)\n            value = term1 + term2\n\n        self._cache.set(n, value)\n        return value\nclass SequenceFunction:\n    \"\"\"\n    Public facade for the Newman-Conway sequence calculation.\n    Orchestrates input validation and sequence computation.\n    \"\"\"\n    def __init__(self):\n        self._validator = InputValidator()\n        self._cache = SequenceCache()\n        self._calculator = NewmanConwayCalculator(self._cache)\n\n    def sequence(self, n: int) -> int:\n        \"\"\"\n        Finds the nth number in the Newman-Conway sequence.\n        Validates input and delegates computation to the NewmanConwayCalculator.\n        \"\"\"\n        self._validator.validate(n)\n        return self._calculator.compute(n)\ndef sequence(n: int) -> int:\n    \"\"\"\n    Finds the nth number in the Newman-Conway sequence.\n    This is the public API entry point for the sequence.\n    \"\"\"\n    return SequenceFunction().sequence(n)"}
