{"task_id": "Mbpp/414", "solution": "class OverlapChecker:\n    def overlapping(self, seq1, seq2) -> bool:\n        \"\"\"Implements BR2-BR5; called by module-level overlapping.\"\"\"\n        # Per FR4: Return False when either seq1 or seq2 is empty\n        if not seq1 or not seq2:\n            return False\n\n        # Per FR2 / BR2: Return True if at least one element in seq1 equals (==) an element in seq2\n        # Per BR5: Uses Python's == semantics for comparisons\n        for item1 in seq1:\n            # This loop effectively implements \"compare element.value == any in seq2\"\n            # by checking if item1 (a conceptual Element's value) exists in seq2.\n            # This relies on Python's 'in' operator using == for comparison.\n            if item1 in seq2:\n                return True\n\n        # Per FR3: Return False if no elements in seq1 equal any element in seq2\n        return False\ndef overlapping(seq1, seq2) -> bool:\n    \"\"\"Public API per FR1: return True if any element in seq1 equals (==) any element in seq2; False otherwise. Returns False when either sequence is empty.\"\"\"\n    checker = OverlapChecker()\n    return checker.overlapping(seq1, seq2)"}
{"task_id": "Mbpp/415", "solution": "def max_Product(values: list[int]) -> tuple[int, int]:\n    \"\"\"\n    Finds a pair with the highest product from a given array of integers.\n    The function validates input length, considers all integer types, handles duplicates,\n    and uses a deterministic tie-breaker for equal maximal products.\n    \"\"\"\n\n    class IntegerList:\n        \"\"\"Encapsulates a list of integers and provides validation.\"\"\"\n        def __init__(self, values: list[int]):\n            self.values = values\n\n        def validate_min_length(self, min_length: int) -> None:\n            \"\"\"Validates if the list has at least a minimum required length.\"\"\"\n            if len(self.values) < min_length:\n                raise ValueError(f\"Input list must contain at least {min_length} integers.\")\n\n    class Pair:\n        \"\"\"Represents a pair of integers and provides product calculation.\"\"\"\n        def __init__(self, a: int, b: int):\n            self.a = a\n            self.b = b\n\n        def product(self) -> int:\n            \"\"\"Calculates the product of the two integers in the pair.\"\"\"\n            return self.a * self.b\n\n        def as_tuple(self) -> tuple[int, int]:\n            \"\"\"Returns the pair as a tuple (a, b).\"\"\"\n            return (self.a, self.b)\n\n    class ProductCalculator:\n        \"\"\"Generates candidate pairs and selects the pair with the maximal product.\"\"\"\n        def generate_candidate_pairs(self, values: list[int]) -> list[Pair]:\n            \"\"\"Generates all possible pairs of integers from the input list, including duplicates.\"\"\"\n            pairs = []\n            n = len(values)\n            for i in range(n):\n                for j in range(i, n):\n                    pairs.append(Pair(values[i], values[j]))\n            return pairs\n\n        def select_max_pair(self, pairs: list[Pair]) -> Pair:\n            \"\"\"Selects the pair with the maximal product, applying deterministic tie-breaking.\"\"\"\n            best_pair = pairs[0]\n\n            for current_pair in pairs[1:]:\n                current_product = current_pair.product()\n                best_product = best_pair.product()\n\n                if current_product > best_product:\n                    best_pair = current_pair\n                elif current_product == best_product:\n                    # Apply deterministic tie-breaker: compare sorted elements lexicographically.\n                    current_sorted_elements = tuple(sorted(current_pair.as_tuple()))\n                    best_sorted_elements = tuple(sorted(best_pair.as_tuple()))\n\n                    if current_sorted_elements < best_sorted_elements:\n                        best_pair = current_pair\n            return best_pair\n\n    class ResultFormatter:\n        \"\"\"Formats a Pair into the final ascending tuple.\"\"\"\n        def sort_ascending(self, pair: Pair) -> tuple[int, int]:\n            \"\"\"Sorts the integers in the pair ascending and returns as a tuple.\"\"\"\n            return tuple(sorted(pair.as_tuple()))\n\n    class MaxProductFunction:\n        \"\"\"Orchestrates the process of finding the highest product pair.\"\"\"\n        def max_Product(self, values: list[int]) -> tuple[int, int]:\n            \"\"\"Finds the pair with the highest product from the given array of integers.\"\"\"\n            integer_list = IntegerList(values)\n            integer_list.validate_min_length(2)\n\n            product_calculator = ProductCalculator()\n            candidate_pairs = product_calculator.generate_candidate_pairs(values)\n\n            best_pair = product_calculator.select_max_pair(candidate_pairs)\n\n            result_formatter = ResultFormatter()\n            return result_formatter.sort_ascending(best_pair)\n\n    return MaxProductFunction().max_Product(values)"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the cube sum of the first n even natural numbers.\n    Utilizes a closed-form formula for O(1) computation.\n    \"\"\"\n    _validate_input(n)\n\n    if n == 0:\n        return 0\n\n    # The closed-form formula for the sum of cubes of the first n even natural numbers is 2 * n^2 * (n+1)^2.\n    result = 2 * (n ** 2) * ((n + 1) ** 2)\n    return result"}
{"task_id": "Mbpp/419", "solution": "import math\nfrom typing import List\ndef round_half_up(value: float) -> int:\n    \"\"\"Rounds a float to the nearest integer, with .5 rounding up (towards positive infinity).\"\"\"\n    return math.floor(value + 0.5)\ndef _sum_rounded(numbers: List[float]) -> int:\n    \"\"\"Rounds each number in a list using round_half_up and returns their sum.\"\"\"\n    return sum(round_half_up(num) for num in numbers)\ndef _multiply_sum_by_length(sum_value: int, length: int) -> int:\n    \"\"\"Multiplies a sum by a given length.\"\"\"\n    return sum_value * length\ndef round_and_sum(numbers: List[float]) -> int:\n    \"\"\"\n    Rounds every number of a given list, sums them,\n    multiplies the total sum by the list length, and prints the result.\n    \"\"\"\n    total_sum = _sum_rounded(numbers)\n    list_length = len(numbers)\n    final_product = _multiply_sum_by_length(total_sum, list_length)\n    _print_result(final_product)\n    return final_product"}
{"task_id": "Mbpp/418", "solution": "class InputList:\n    \"\"\"A lightweight wrapper for the input list.\"\"\"\n    def __init__(self, elements):\n        self.elements = elements\n\n    def get_elements(self):\n        return self.elements\nclass Validator:\n    \"\"\"Validates the top-level input list and its elements.\"\"\"\n    def validate_list(self, input_list):\n        if not isinstance(input_list, list):\n            raise TypeError(\"Input must be a list.\")\n\n    def validate_elements(self, elements):\n        for element in elements:\n            try:\n                len(element)\n            except TypeError:\n                raise TypeError(f\"Element '{element}' does not support len().\")\ndef _compute_max(elements):\n    \"\"\"\n    Finds the element with the maximum length from a non-empty list.\n    Assumes elements are validated and support len(), returning the first-occurrence tie-break.\n    \"\"\"\n    max_element = elements[0]\n    max_length = len(elements[0])\n\n    for element in elements[1:]:\n        current_length = len(element)\n        if current_length > max_length:\n            max_length = current_length\n            max_element = element\n    return max_element\ndef Find_Max(input_list):\n    \"\"\"\n    Finds the element of a list having maximum length, validating input and handling empty lists.\n    Raises TypeError for invalid input, returns None for empty lists.\n    \"\"\"\n    validator = Validator()\n    validator.validate_list(input_list)\n\n    # The design specifies wrapping the input list, though validation and computation\n    # proceed on the raw list obtained from the wrapper.\n    input_list_wrapper = InputList(input_list)\n    elements_to_process = input_list_wrapper.get_elements()\n\n    validator.validate_elements(elements_to_process)\n\n    if not elements_to_process:\n        return None\n    else:\n        return _compute_max(elements_to_process)"}
{"task_id": "Mbpp/421", "solution": "def concatenate_tuple(t) -> str:\n    \"\"\"\n    Concatenate each element of the tuple t by '-' after converting each element to str.\n\n    Raises:\n        TypeError: if t is not a tuple.\n    \"\"\"\n    if not isinstance(t, tuple):\n        raise TypeError(\"Input must be a tuple\")\n    strings = [str(e) for e in t]\n    return '-'.join(strings)"}
