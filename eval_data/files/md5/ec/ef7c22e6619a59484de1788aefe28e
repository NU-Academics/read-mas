{"task_id": "Mbpp/473", "solution": "from dataclasses import dataclass\nfrom typing import List, Tuple, Set\ndef normalizeTuple(t: Tuple) -> TupleKey:\n    \"\"\"Produces a canonical, order-insensitive key for tuple t by sorting its elements.\"\"\"\n    return TupleKey(canonical_elements=tuple(sorted(t)))\ndef tuple_intersection(list1: List[Tuple], list2: List[Tuple]) -> Set[Tuple]:\n    \"\"\"\n    Finds the tuple intersection of elements in the given tuple lists, irrespective of their order.\n    Matched tuples in the output use the element ordering from the first input list.\n    \"\"\"\n    if not list1 or not list2:\n        return set()\n\n    # Map canonical key to the first-occurrence tuple from list1 to preserve its order and handle duplicates.\n    list1_canonical_map: dict[TupleKey, Tuple] = {}\n    for t1 in list1:\n        key1 = normalizeTuple(t1)\n        if key1 not in list1_canonical_map:\n            list1_canonical_map[key1] = t1\n\n    # Create a set of canonical keys from list2 for efficient lookup.\n    list2_canonical_keys: Set[TupleKey] = {normalizeTuple(t2) for t2 in list2}\n\n    # Find the intersection and collect results using the ResultSet wrapper.\n    result_set_wrapper = ResultSet()\n    for canonical_key, original_tuple_from_list1 in list1_canonical_map.items():\n        if canonical_key in list2_canonical_keys:\n            result_set_wrapper.add(original_tuple_from_list1)\n\n    return result_set_wrapper.to_set()"}
{"task_id": "Mbpp/474", "solution": "def replace_char(input_string: str, old_char: str, new_char: str) -> str:\n    \"\"\"\n    Replaces every occurrence of old_char with new_char in input_string.\n    Raises ValueError if old_char or new_char are not single-character strings.\n    \"\"\"\n    _validate_single_char(old_char, new_char)\n\n    if not input_string:\n        return \"\"\n\n    result_chars = []\n    for char in input_string:\n        if char == old_char:\n            result_chars.append(new_char)\n        else:\n            result_chars.append(char)\n\n    return \"\".join(result_chars)"}
