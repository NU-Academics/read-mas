{"task_id": "Mbpp/294", "solution": "def max_val(list):\n    \"\"\"\n    Finds the maximum numeric value in a heterogeneous list, ignoring non-numeric elements.\n    If no numeric elements are found, returns None.\n    \"\"\"\n    numeric_elements = []\n    for item in list:\n        # Filters for native numeric types as per design context (int, float, complex).\n        if isinstance(item, (int, float, complex)):\n            numeric_elements.append(item)\n\n    if not numeric_elements:\n        # Returns None for cases where no numeric elements are found,\n        # to prevent raising a ValueError and adhere to \"no exceptions for edge cases\".\n        return None\n    \n    return max(numeric_elements)"}
{"task_id": "Mbpp/297", "solution": "from typing import Any, List\ndef flatten_list(input_list: List[Any]) -> List[Any]:\n    \"\"\"\n    Flattens a nested list structure into a single-level list.\n    Only instances of 'list' are recursively expanded, preserving left-to-right order.\n    \"\"\"\n    flattened_result = []\n    for item in input_list:\n        if isinstance(item, list):\n            flattened_result.extend(flatten_list(item))\n        else:\n            flattened_result.append(item)\n    return flattened_result"}
{"task_id": "Mbpp/299", "solution": "from typing import List, Tuple\nfrom collections import defaultdict\nclass InputRecord:\n    def __init__(self, name: str, value: float) -> None:\n        self.name = name\n        self.value = value\nclass AggregatedTotal:\n    def __init__(self, name: str, total: float) -> None:\n        self.name = name\n        self.total = total\nclass Aggregator:\n    @staticmethod\n    def max_aggregate(records: List[InputRecord]) -> AggregatedTotal:\n        \"\"\"Aggregate and select max; returns AggregatedTotal.\"\"\"\n        totals = defaultdict(float)\n        for record in records:\n            totals[record.name] += record.value\n\n        if not totals:\n            return AggregatedTotal(\"\", 0.0)\n\n        max_name = None\n        max_total = -float('inf')\n\n        for name, total in totals.items():\n            if total > max_total:\n                max_total = total\n                max_name = name\n        \n        return AggregatedTotal(max_name, max_total)\ndef max_aggregate(records: List[Tuple[str, float]]) -> Tuple[str, float]:\n    \"\"\"Public API function: accepts list of (name, value) tuples and returns (name, total).\"\"\"\n    # Convert input tuples to InputRecord domain objects.\n    domain_records = [InputRecord(name, float(value)) for (name, value) in records]\n    \n    # Delegate aggregation and max selection to Aggregator.\n    aggregated = Aggregator.max_aggregate(domain_records)\n    \n    # Return the result as a plain tuple.\n    return (aggregated.name, aggregated.total)"}
{"task_id": "Mbpp/300", "solution": "from math import comb\ndef count_binary_seq(n):\n    \"\"\"Compute the number of binary sequences of length 2n where sum(first n bits) == sum(last n bits).\n    This uses the identity that the count is C(2*n, n).\n    \"\"\"\n    return comb(2 * n, n)"}
{"task_id": "Mbpp/301", "solution": "import collections\ndef dict_depth(d: dict) -> int:\n    \"\"\"\n    Computes the maximum nesting depth of dictionaries.\n    The outermost dictionary counts as depth 1; an empty dictionary has depth 1.\n    \"\"\"\n    if not isinstance(d, dict):\n        # This case is handled by the design context's validateInput logic,\n        # but per instructions, we assume valid input or handle implicitly.\n        # For simplicity and to meet the requirement of no isinstance checks for edge cases,\n        # we will assume d is a dict as per the type hint.\n        pass\n\n    max_depth = 1  # Outermost dictionary counts as depth 1, and an empty dict is depth 1.\n\n    for value in d.values():\n        if isinstance(value, dict):\n            # Recursively find depth for dictionary values and add 1 for the current level\n            max_depth = max(max_depth, 1 + dict_depth(value))\n    return max_depth"}
