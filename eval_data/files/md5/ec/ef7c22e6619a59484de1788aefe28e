{"task_id": "Mbpp/255", "solution": "import itertools\ndef combinations_colors(elements, n):\n    \"\"\"\n    Generates all combinations (with repetition) of the elements of the list.\n    Returns a list with a tuple for each combination.\n    \"\"\"\n    # The design context indicates this function should delegate to CombinationsGenerator.\n    # However, since the request is to *not* use helper classes/functions not defined inline,\n    # and not to create external classes, the implementation must be self-contained.\n    # The standard library's itertools.combinations_with_replacement fulfills the core logic.\n    return [tuple(combo) for combo in itertools.combinations_with_replacement(elements, n)]"}
{"task_id": "Mbpp/252", "solution": "import math\nfrom dataclasses import dataclass\nclass MathUtils:\n    @staticmethod\n    def sqrt(x: float) -> float:\n        return math.sqrt(x)\n\n    @staticmethod\n    def atan2(y: float, x: float) -> float:\n        return math.atan2(y, x)\nclass Converter:\n    @staticmethod\n    def convert(input) -> (float, float):\n        \"\"\"Converts a complex number or numeric input to polar coordinates.\"\"\"\n        ci = ComplexInput.from_value(input)\n        r = MathUtils.sqrt(ci.re * ci.re + ci.im * ci.im)\n        theta = MathUtils.atan2(ci.im, ci.re)\n        pc = PolarCoordinate(r=float(r), theta=float(theta))\n        return pc.to_tuple()\ndef convert(input) -> (float, float):\n    \"\"\"\n    Converts a complex number (or int/float) to polar coordinates (r, theta).\n    \"\"\"\n    return Converter.convert(input)"}
{"task_id": "Mbpp/256", "solution": "import math\ndef count_Primes_nums(number):\n    \"\"\"Accepts a single argument 'number' (non-negative). Returns an int count of primes p where p < number.\n\n    If number < 2, returns 0. Otherwise, computes the count of primes using the Sieve of Eratosthenes.\n    \"\"\"\n    if number < 2:\n        return 0\n\n    # Determine the exclusive upper limit for the sieve.\n    # To count primes p < number, the sieve needs to cover integers up to floor(number-epsilon).\n    # For example, for 5.7, primes are 2, 3, 5. So the sieve needs to run up to 6 (exclusive).\n    # For 5, primes are 2, 3. So the sieve needs to run up to 5 (exclusive).\n    limit = int(math.ceil(number))\n\n    if limit <= 2:\n        return 0\n\n    is_prime = [True] * limit\n    is_prime[0] = is_prime[1] = False\n\n    for p in range(2, int(math.sqrt(limit)) + 1):\n        if is_prime[p]:\n            for multiple in range(p * p, limit, p):\n                is_prime[multiple] = False\n\n    count = 0\n    for i in range(2, limit):\n        if is_prime[i]:\n            count += 1\n\n    return count"}
{"task_id": "Mbpp/257", "solution": "from typing import Any, Tuple\nclass InputValidator:\n    \"\"\"Provides static methods for input validation.\"\"\"\n    @staticmethod\n    def is_numeric(x: Any) -> bool:\n        \"\"\"Checks if the input is an integer or a float.\"\"\"\n        return isinstance(x, (int, float))\nclass SwapFunction:\n    \"\"\"Encapsulates the core logic for swapping two numbers.\"\"\"\n    @staticmethod\n    def swap_numbers(a: Any, b: Any) -> Tuple[Any, Any]:\n        \"\"\"Returns a tuple with the second number then the first.\"\"\"\n        return (b, a)\ndef swap_numbers(a, b) -> tuple:\n    \"\"\"\n    Validates inputs as numeric and returns a tuple with the second number and then the first.\n    Raises TypeError if either input is not numeric.\n    \"\"\"\n    if not InputValidator.is_numeric(a) or not InputValidator.is_numeric(b):\n        raise TypeError(\"Inputs must be numeric (int or float).\")\n    return SwapFunction.swap_numbers(a, b)"}
{"task_id": "Mbpp/259", "solution": "from dataclasses import dataclass\nfrom typing import Tuple, Any\ndef _compute_elementwise_maxima(tuple1: Tuple[Tuple[int | float, int | float], ...], tuple2: Tuple[Tuple[int | float, int | float], ...]) -> Tuple[Tuple[int | float, int | float], ...]:\n    \"\"\"Computes the element-wise maximum for corresponding 2-tuples.\"\"\"\n    result_list = []\n    for i in range(len(tuple1)):\n        max_first = max(tuple1[i][0], tuple2[i][0])\n        max_second = max(tuple1[i][1], tuple2[i][1])\n        result_list.append((max_first, max_second))\n    return tuple(result_list)\ndef maximize_elements(tuple1: Tuple[Tuple[Any, Any], ...], tuple2: Tuple[Tuple[Any, Any], ...]) -> Tuple[Tuple[int | float, int | float], ...]:\n    \"\"\"\n    Maximizes elements of two tuples of 2-tuples, returning a new tuple with element-wise maxima.\n    Includes comprehensive validation for input length, element shape, and numeric types.\n    \"\"\"\n    _validate_equal_length(tuple1, tuple2)\n    _validate_elements_are_pairs_and_numeric(tuple1, tuple2)\n    return _compute_elementwise_maxima(tuple1, tuple2)"}
{"task_id": "Mbpp/264", "solution": "class AgeConversionConstants:\n    \"\"\"Conversion factors for calculating dog's age.\"\"\"\n    first_two_years_factor: float = 10.5\n    subsequent_year_factor: float = 4.0\nclass DogAgeCalculator:\n    \"\"\"Handles the core logic for calculating a dog's age.\"\"\"\n    def __init__(self, constants: AgeConversionConstants = AgeConversionConstants):\n        self._constants = constants\n\n    def dog_age(self, human_years: float) -> float:\n        \"\"\"\n        Computes dog years from human years.\n        This method assumes valid numeric input as per explicit instructions.\n        \"\"\"\n        if human_years <= 2:\n            dog_years = human_years * self._constants.first_two_years_factor\n        else:\n            dog_years = (2 * self._constants.first_two_years_factor) + \\\n                        ((human_years - 2) * self._constants.subsequent_year_factor)\n        return float(dog_years)\ndef dog_age(human_years: float) -> float:\n    \"\"\"\n    Calculates a dog's age in dog's years.\n    The first two human years count as 10.5 dog years each, and subsequent years count as 4.\n    \"\"\"\n    calc = DogAgeCalculator()\n    return calc.dog_age(human_years)"}
{"task_id": "Mbpp/262", "solution": "def split_two_parts(input_list, L):\n    \"\"\"\n    Splits a list into two parts based on a given length L.\n    Validates inputs and returns a tuple of two lists.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise ValueError(\"input_list must be a list.\")\n    if not isinstance(L, int):\n        raise ValueError(\"L must be an integer.\")\n    if not (0 <= L <= len(input_list)):\n        raise ValueError(f\"L must be between 0 and the length of the list ({len(input_list)}), inclusive.\")\n\n    first_part = input_list[0:L]\n    second_part = input_list[L:]\n\n    return (first_part, second_part)"}
{"task_id": "Mbpp/260", "solution": "import math\nfrom typing import List\nclass NewmanShanksWilliamsSequence:\n    \"\"\"Generates and caches Newman-Shanks-Williams sequence terms.\"\"\"\n    _cache: List[int]\n\n    def __init__(self):\n        # The sequence starts S_1 = 1, S_2 = 1 (1-based indexing).\n        # Internal cache uses 0-based indexing: _cache[0] for S_1, _cache[1] for S_2.\n        self._cache = [1, 1] \n\n    def get_term(self, k: int) -> int:\n        \"\"\"Retrieves the k-th term (1-based index) of the NSW sequence, generating if needed.\"\"\"\n        # Due to constraints, assuming k is a valid positive integer.\n        if k <= 0: # This case should be handled by validation, but omitted per instructions.\n            return 0 # Placeholder for invalid input.\n\n        # If k is already in the cache, return it.\n        if k <= len(self._cache):\n            return self._cache[k - 1]\n\n        # Generate terms until k-th term is reached.\n        for i in range(len(self._cache), k):\n            # S_n = 2 * S_{n-1} + S_{n-2}.\n            # The next term in the sequence is S_{i+1}, which corresponds to _cache[i].\n            # It's calculated from S_i (_cache[i-1]) and S_{i-1} (_cache[i-2]).\n            next_term = 2 * self._cache[i - 1] + self._cache[i - 2]\n            self._cache.append(next_term)\n            \n        return self._cache[k - 1]\nclass PrimeChecker:\n    \"\"\"Determines if a given integer is prime.\"\"\"\n\n    def is_prime(self, x: int) -> bool:\n        \"\"\"Checks if a number x is prime using trial division.\"\"\"\n        if x < 2:\n            return False\n        if x == 2:\n            return True\n        if x % 2 == 0:\n            return False\n        # Check for odd divisors up to the square root of x.\n        for i in range(3, int(math.sqrt(x)) + 1, 2):\n            if x % i == 0:\n                return False\n        return True\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Finds a Newman-Shanks-Williams prime number based on the input n.\n    The function returns the (n+1)-th term of the NSW sequence (S_{n+1}).\n    This specific mapping satisfies the acceptance test newman_prime(3) == 7, as S_4 = 7.\n    \"\"\"\n    # Instantiate required components as per design, adhering to \"inline helper\" constraint.\n    sequence_generator = NewmanShanksWilliamsSequence()\n    prime_checker = PrimeChecker() # PrimeChecker is instantiated but not explicitly used for filtering\n                                  # because handling non-prime results is omitted per instructions.\n\n    # The problem description and test case imply that for input n, we return the S_{n+1} term.\n    # For n=3, this means we seek S_{3+1} = S_4. S_4 is 7, which matches the test.\n    target_sequence_index = n + 1\n    \n    result_term = sequence_generator.get_term(target_sequence_index)\n    \n    # Although the problem asks for a \"prime number\", and result_term will be 7 for n=3 (which is prime),\n    # explicit primality checking and error handling for non-prime results is omitted due to\n    # the constraint \"Do NOT add isinstance() checks or raise exceptions for edge cases\".\n    # It is assumed that inputs 'n' will lead to a prime S_{n+1}.\n    \n    return result_term"}
{"task_id": "Mbpp/265", "solution": "def list_split(lst, n):\n    \"\"\"\n    Splits a list into n sublists, distributing elements every nth position.\n    Each sublist i contains elements at original positions i, i+n, i+2n, etc.\n    \"\"\"\n    result = [[] for _ in range(n)]\n    for idx, elem in enumerate(lst):\n        result[idx % n].append(elem)\n    return result"}
{"task_id": "Mbpp/266", "solution": "import math\nclass InputValidator:\n    \"\"\"Provides utility methods for validating numeric inputs.\"\"\"\n    def isNumeric(self, val: object) -> bool:\n        \"\"\"Checks if a value is an integer or a float.\"\"\"\n        return isinstance(val, (int, float))\n\n    def isFiniteNumber(self, val: float) -> bool:\n        \"\"\"Checks if a float value is finite (not NaN, Inf, or -Inf).\"\"\"\n        return not (math.isinf(val) or math.isnan(val))\nclass Cube:\n    \"\"\"Represents a cube and stores its side length.\"\"\"\n    _side: float\n\n    def setSide(self, side: float) -> None:\n        \"\"\"Sets the side length of the cube.\"\"\"\n        self._side = side\n\n    def getSide(self) -> float:\n        \"\"\"Returns the side length of the cube.\"\"\"\n        return self._side\nclass LateralSurfaceCalculator:\n    \"\"\"Calculates the lateral surface area of a cube.\"\"\"\n    def calculate(self, side: float) -> float:\n        \"\"\"Computes the lateral surface area using 4 * side * side.\"\"\"\n        return 4 * side * side\nclass Result:\n    \"\"\"A data transfer object to hold the calculated lateral surface area.\"\"\"\n    lateralArea: float\n\n    def __init__(self, lateral_area: float):\n        \"\"\"Initializes the Result with the lateral area.\"\"\"\n        self.lateralArea = lateral_area\ndef lateralsurface_cube(side: float) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cube given its side length.\n    Raises ValueError for non-numeric or non-finite side lengths.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.isNumeric(side):\n        raise ValueError(\"Invalid input: side must be a numeric value.\")\n    \n    side_float = float(side) # Ensure float type for isFiniteNumber check\n    if not validator.isFiniteNumber(side_float):\n        raise ValueError(\"Invalid input: side must be a finite number.\")\n\n    cube_entity = Cube()\n    cube_entity.setSide(side_float)\n\n    calculator = LateralSurfaceCalculator()\n    calculated_area = calculator.calculate(side_float)\n\n    result_dto = Result(calculated_area)\n    return result_dto.lateralArea"}
{"task_id": "Mbpp/267", "solution": "def generate_first_n(n: int) -> list[int]:\n    \"\"\"Generate the first n odd natural numbers as a list of ints.\"\"\"\n    odd_numbers = []\n    for k in range(1, n + 1):\n        odd_numbers.append(2 * k - 1)\n    return odd_numbers\ndef square_Sum(n: int) -> int:\n    \"\"\"Compute sum_{k=1..n} (2k - 1)^2 and return as int.\"\"\"\n    odd_numbers = generate_first_n(n)\n    sum_of_squares = 0\n    for num in odd_numbers:\n        sum_of_squares += num * num\n    return sum_of_squares"}
{"task_id": "Mbpp/261", "solution": "from typing import Tuple, Sequence, Union, Any\nclass ValidationError(Exception):\n    def __init__(self, message: str, code: str) -> None:\n        super().__init__(message)\n        self.code = code\nNumber = Union[int, float]\ndef _is_numeric(value: Any) -> bool:\n    return isinstance(value, (int, float))\nclass TupleOperand:\n    def __init__(self, elements: Sequence[Number]) -> None:\n        self._elements: Tuple[Number, ...] = tuple(elements)\n\n    @property\n    def elements(self) -> Tuple[Number, ...]:\n        return self._elements\n\n    def length(self) -> int:\n        return len(self._elements)\nclass ResultTuple:\n    def __init__(self, elements: Sequence[Number]) -> None:\n        self._elements: Tuple[Number, ...] = tuple(elements)\n\n    def as_tuple(self) -> Tuple[Number, ...] :\n        return self._elements\ndef _validate_tuple_operand(name: str, value: Any) -> TupleOperand:\n    if not isinstance(value, (tuple, list)):\n        raise ValidationError(f\"operand '{name}' must be a tuple or sequence, got {type(value).__name__}\", code=\"TYPE_ERROR\")\n\n    validated_elements = []\n    for i, el in enumerate(value):\n        if not _is_numeric(el):\n            raise ValidationError(f\"non-numeric element at index {i} in operand '{name}'\", code=\"TYPE_ERROR\")\n        validated_elements.append(el)\n    return TupleOperand(validated_elements)\ndef _assemble_result(a: TupleOperand, b: TupleOperand) -> ResultTuple:\n    results = []\n    for i in range(a.length()):\n        results.append(a.elements[i] / b.elements[i])\n    return ResultTuple(results)\ndef division_elements(tuple_a: Any, tuple_b: Any) -> ResultTuple:\n    \"\"\"\n    Performs element-wise division on two tuples.\n    Validates inputs, checks for length mismatch and division by zero.\n    \"\"\"\n    a = _validate_tuple_operand('tuple_a', tuple_a)\n    b = _validate_tuple_operand('tuple_b', tuple_b)\n    _validate_lengths(a, b)\n    _check_no_zero(b)\n    return _assemble_result(a, b)"}
{"task_id": "Mbpp/268", "solution": "class InputValidator:\n    \"\"\"Validates the input index for star number calculation.\"\"\"\n    def is_valid_index(self, n) -> bool:\n        \"\"\"Checks if n is an integer and n is greater than or equal to 1.\"\"\"\n        return isinstance(n, int) and n >= 1\n\n    def validate_index(self, n) -> None:\n        \"\"\"Raises ValueError if n is not a valid index.\"\"\"\n        if not self.is_valid_index(n):\n            raise ValueError(\"Input 'n' must be an integer greater than or equal to 1.\")\nclass StarNumberCalculator:\n    \"\"\"Computes the n'th star number.\"\"\"\n    def find_star_num(self, n: int) -> int:\n        \"\"\"Calculates S_n using the formula 6 * n * (n - 1) + 1.\"\"\"\n        return 6 * n * (n - 1) + 1\ndef find_star_num(n: int) -> int:\n    \"\"\"\n    Finds the n'th star number.\n    Validates input 'n' and calculates the star number using the formula S_n = 6 * n * (n - 1) + 1.\n    \"\"\"\n    validator = InputValidator()\n    calculator = StarNumberCalculator()\n\n    validator.validate_index(n)\n    return calculator.find_star_num(n)"}
