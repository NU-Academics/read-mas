{"task_id": "Mbpp/251", "solution": "from typing import List, Any\ndef insert_element(input_list: List[Any], element: Any) -> List[Any]:\n    \"\"\"Return a new list where `element` is inserted immediately before each item of `input_list`.\n\n    Parameters:\n    - input_list: list (the input list to transform)\n    - element: any (the value to insert before each element)\n\n    Returns:\n    - list: resulting interleaved list\n    \"\"\"\n    result = []\n    for item in input_list:\n        result.append(element)\n        result.append(item)\n    return result"}
{"task_id": "Mbpp/245", "solution": "from typing import List\ndef max_sum(arr: List[int]) -> int:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence for the given array.\n    A sequence is bitonic if it is first strictly increasing and then strictly decreasing.\n    \"\"\"\n    n = len(arr)\n\n    if n == 0:\n        return 0\n\n    # computeLISsums: lis_sums[i] stores the maximum sum of an increasing subsequence ending with arr[i].\n    lis_sums = [0] * n\n    for i in range(n):\n        lis_sums[i] = arr[i]\n        for j in range(i):\n            if arr[i] > arr[j]:\n                lis_sums[i] = max(lis_sums[i], lis_sums[j] + arr[i])\n\n    # computeLDSsums: lds_sums[i] stores the maximum sum of a decreasing subsequence starting with arr[i].\n    lds_sums = [0] * n\n    for i in range(n - 1, -1, -1):\n        lds_sums[i] = arr[i]\n        for j in range(n - 1, i, -1): # Iterate from n-1 down to i+1\n            if arr[i] > arr[j]:\n                lds_sums[i] = max(lds_sums[i], lds_sums[j] + arr[i])\n    \n    # combineLISLDS: Iterate through each element as a potential peak of a bitonic subsequence.\n    # The peak element arr[i] is counted once by subtracting it from the sum of LIS[i] and LDS[i].\n    # Initialize with negative infinity to correctly handle arrays with negative numbers,\n    # or the case where a single element is the maximum sum (e.g., [42] returns 42).\n    max_bitonic_sum = float('-inf')\n\n    for i in range(n):\n        current_candidate_sum = lis_sums[i] + lds_sums[i] - arr[i]\n        max_bitonic_sum = max(max_bitonic_sum, current_candidate_sum)\n    \n    return max_bitonic_sum"}
{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"\n    Calculates the length of the longest palindromic subsequence in the given string using dynamic programming.\n    \"\"\"\n    n = len(s)\n\n    # Handle empty string case: an empty string has an LPS of length 0.\n    if n == 0:\n        return 0\n\n    # dp[i][j] will store the length of the longest palindromic subsequence\n    # for the substring s[i...j].\n    dp = [[0] * n for _ in range(n)]\n\n    # All single characters are palindromic subsequences of length 1.\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the DP table for substrings of increasing length.\n    # The outer loop iterates `i` from n-1 down to 0, and the inner loop\n    # iterates `j` from i+1 to n-1. This order ensures that dependencies\n    # (dp[i+1][j-1], dp[i+1][j], dp[i][j-1]) are already computed.\n    for i in range(n - 1, -1, -1):\n        for j in range(i + 1, n):\n            if s[i] == s[j]:\n                # If characters s[i] and s[j] match, they can form part of the LPS.\n                # The length is 2 (for s[i] and s[j]) plus the LPS of the inner\n                # substring s[i+1...j-1]. If j == i + 1, the inner substring is empty,\n                # and its LPS length is effectively 0, so dp[i][j] becomes 2.\n                dp[i][j] = 2 if i + 1 > j - 1 else dp[i+1][j-1] + 2\n            else:\n                # If s[i] and s[j] don't match, the LPS of s[i...j] is the maximum of:\n                # 1. LPS of s[i+1...j] (excluding s[i])\n                # 2. LPS of s[i...j-1] (excluding s[j])\n                dp[i][j] = max(dp[i+1][j], dp[i][j-1])\n\n    # The result for the entire string s[0...n-1] is stored in dp[0][n-1].\n    return dp[0][n-1]"}
