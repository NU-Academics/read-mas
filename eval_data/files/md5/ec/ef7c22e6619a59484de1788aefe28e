{"task_id": "Mbpp/422", "solution": "from typing import List\nclass ErrorCondition:\n    \"\"\"Represents an error condition with a type and message.\"\"\"\n    def __init__(self, type: str, message: str):\n        self.type = type\n        self.message = message\nclass InputValidator:\n    \"\"\"Validates if 'n' is a positive integer.\"\"\"\n    def validate(self, n: int) -> bool:\n        \"\"\"Raises ValueError if n is not an integer or n < 1.\"\"\"\n        if not isinstance(n, int):\n            error = ErrorCondition(\"TypeError\", \"Input 'n' must be an integer.\")\n            raise ValueError(error.message)\n        if n < 1:\n            error = ErrorCondition(\"ValueError\", \"Input 'n' must be a natural number (n >= 1).\")\n            raise ValueError(error.message)\n        return True\nclass NaturalNumberSequence:\n    \"\"\"Generates a sequence of natural numbers from 1 to 'end'.\"\"\"\n    def __init__(self, end: int):\n        self.start = 1\n        self.end = end\n\n    def generate(self) -> List[int]:\n        \"\"\"Returns a list of natural numbers from 1 to 'end'.\"\"\"\n        return list(range(self.start, self.end + 1))\nclass CubeCalculation:\n    \"\"\"Computes the cube of a given integer.\"\"\"\n    def compute(self, x: int) -> int:\n        \"\"\"Returns the cube of x (x**3).\"\"\"\n        return x ** 3\nclass AverageComputation:\n    \"\"\"Computes the arithmetic mean of a list of numeric values.\"\"\"\n    def compute(self, values: List[int]) -> float:\n        \"\"\"Returns the average of the given list of values.\"\"\"\n        if not values:\n            return 0.0 # Should not occur if n >= 1\n        return sum(values) / len(values)\ndef find_Average_Of_Cube(n: int) -> float:\n    \"\"\"Validates input n, computes cubes of 1..n, and returns their average.\n\n    Raises:\n        ValueError: if n is not an integer or n < 1.\n    \"\"\"\n    validator = InputValidator()\n    validator.validate(n)\n\n    seq_generator = NaturalNumberSequence(end=n)\n    natural_numbers = seq_generator.generate()\n\n    cube_calc = CubeCalculation()\n    cubes = [cube_calc.compute(x) for x in natural_numbers]\n\n    avg_comp = AverageComputation()\n    average = avg_comp.compute(cubes)\n\n    return average"}
{"task_id": "Mbpp/425", "solution": "import collections.abc\ndef _is_iterable_of_iterables(obj):\n    \"\"\"\n    Checks if an object is an iterable (excluding str/bytes) and contains only iterables (excluding str/bytes).\n    Used for input validation of the top-level list_of_sublists argument.\n    \"\"\"\n    if not isinstance(obj, collections.abc.Iterable) or isinstance(obj, (str, bytes)):\n        return False\n    \n    for item in obj:\n        if not isinstance(item, collections.abc.Iterable) or isinstance(item, (str, bytes)):\n            return False\n    return True\ndef count_element_in_list(list_of_sublists, search_element):\n    \"\"\"\n    Counts the number of sublists containing a particular element.\n    Raises TypeError if list_of_sublists is not an iterable of iterables (excluding str/bytes).\n    \"\"\"\n    if not _is_iterable_of_iterables(list_of_sublists):\n        raise TypeError(\"list_of_sublists must be an iterable of iterables (excluding str/bytes)\")\n\n    count = 0\n    for sublist in list_of_sublists:\n        if search_element in sublist:\n            count += 1\n    return count"}
{"task_id": "Mbpp/426", "solution": "from typing import Iterable, List\ndef filter_oddnumbers(seq: Iterable[int]) -> List[int]:\n    \"\"\"Return a new list containing only the odd integers from seq, preserving original order.\"\"\"\n    result = []\n    for x in seq:\n        if x % 2 != 0:\n            result.append(x)\n    return result"}
{"task_id": "Mbpp/428", "solution": "def _generate_gap_sequence(n: int) -> list[int]:\n    \"\"\"Generates a descending list of gaps for Shell sort using Shell's original sequence (n/2, n/4, ...).\"\"\"\n    gaps = []\n    gap = n // 2\n    while gap > 0:\n        gaps.append(gap)\n        gap //= 2\n    return gaps\ndef shell_sort(arr: list[int]) -> list[int]:\n    \"\"\"Sorts the given array using the Shell sort algorithm and returns a new sorted list.\"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n\n    working_arr = list(arr) # Create a copy to sort in-place without modifying the original.\n    gaps = _generate_gap_sequence(n)\n\n    for gap in gaps:\n        _gapped_insertion_sort(working_arr, gap)\n\n    return working_arr"}
{"task_id": "Mbpp/427", "solution": "import re\nclass ErrorHandler:\n    \"\"\"Handles raising deterministic ValueErrors for invalid input.\"\"\"\n    def raise_invalid_format_error(self, msg: str) -> None:\n        raise ValueError(msg)\nclass DateConverter:\n    \"\"\"Performs validation and conversion of date strings.\"\"\"\n    def change_date_format(self, date_str: str) -> str:\n        \"\"\"Converts date string from 'yyyy-mm-dd' to 'dd-mm-yyyy' format.\"\"\"\n        if not self.validate_format(date_str):\n            ErrorHandler().raise_invalid_format_error(\"Invalid date format: expected yyyy-mm-dd\")\n        \n        year, month, day = date_str.split('-')\n        return f\"{day}-{month}-{year}\"\n\n    def validate_format(self, date_str: str) -> bool:\n        \"\"\"Checks if the date string matches the 'yyyy-mm-dd' pattern.\"\"\"\n        pattern = r'^\\d{4}-\\d{2}-\\d{2}$'\n        return re.match(pattern, date_str) is not None\ndef change_date_format(date_str: str) -> str:\n    \"\"\"\n    Converts a date string from 'yyyy-mm-dd' format to 'dd-mm-yyyy' format.\n    Raises ValueError if the input format is invalid.\n    \"\"\"\n    return DateConverter().change_date_format(date_str)"}
