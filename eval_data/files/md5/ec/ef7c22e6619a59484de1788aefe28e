{"task_id": "Mbpp/786", "solution": "import math\ndef right_insertion(sorted_list, value):\n    \"\"\"\n    Locates the right insertion point for a specified value in sorted order.\n    Assumes `sorted_list` is sorted in non-decreasing order; behavior is undefined if violated.\n    \"\"\"\n    left, right = 0, len(sorted_list) - 1\n    \n    while left <= right:\n        mid = (left + right) // 2\n        if sorted_list[mid] <= value:\n            left = mid + 1\n        else:\n            right = mid - 1\n            \n    return left"}
{"task_id": "Mbpp/790", "solution": "def even_position(input_list):\n    \"\"\"\n    Checks if every element at an even index (0, 2, 4, ...) in the given list is an even number.\n    Returns True if all even-indexed elements are even, False otherwise.\n    \"\"\"\n    for i in range(len(input_list)):\n        if i % 2 == 0:  # Check if the current index is even\n            if input_list[i] % 2 != 0:  # Check if the number at this even index is odd\n                return False\n    return True"}
{"task_id": "Mbpp/792", "solution": "def count_list(collection):\n    \"\"\"Return the number of immediate/top-level elements of collection that are Python lists.\n\n    Raises TypeError if collection is not iterable.\n    \"\"\"\n    try:\n        iterator = iter(collection)\n    except TypeError:\n        raise TypeError('count_list expects an iterable collection')\n    count = 0\n    for element in iterator:\n        if isinstance(element, list):\n            count += 1\n    return count"}
{"task_id": "Mbpp/791", "solution": "def remove_nested(input_tuple):\n    \"\"\"\n    Removes top-level tuple elements from the given tuple.\n    It returns a new tuple containing only non-tuple top-level elements, preserving their original order.\n    \"\"\"\n    filtered_elements = []\n    for element in input_tuple:\n        if not isinstance(element, tuple):\n            filtered_elements.append(element)\n    return tuple(filtered_elements)"}
{"task_id": "Mbpp/793", "solution": "from typing import List\ndef last(array: List[int], target: int) -> int:\n    \"\"\"\n    Finds the last (rightmost) position of an element in a sorted array using a binary search variant.\n    Returns the index of the last occurrence, or -1 if the target is not found.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            result = mid  # Store this as a potential answer\n            low = mid + 1 # Search in the right half for a later occurrence\n        elif array[mid] < target:\n            low = mid + 1 # Target must be in the right half\n        else: # array[mid] > target\n            high = mid - 1 # Target must be in the left half\n            \n    return result"}
{"task_id": "Mbpp/794", "solution": "class InputString:\n    \"\"\"A value object for encapsulating the input string.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def __repr__(self) -> str:\n        return f\"InputString(value='{self.value}')\"\nclass MatchResult:\n    \"\"\"A value object representing the outcome of a match operation.\"\"\"\n    def __init__(self, is_match: bool) -> None:\n        self.is_match = is_match\n\n    def __bool__(self) -> bool:\n        return self.is_match\n\n    def __repr__(self) -> str:\n        return f\"MatchResult(is_match={self.is_match})\"\nclass TextMatcher:\n    \"\"\"Encapsulates the logic for matching a string that starts with 'a' and ends with 'b'.\"\"\"\n    def __init__(self, name: str = \"text_starta_endb\", pattern: str = \"^a.*b$\") -> None:\n        self.name = name\n        self.pattern = pattern\n\n    def match(self, input: InputString) -> MatchResult:\n        if len(input.value) < 2:\n            return MatchResult(is_match=False)\n        \n        starts_with_a = input.value[0] == 'a'\n        ends_with_b = input.value[-1] == 'b'\n        \n        return MatchResult(is_match=starts_with_a and ends_with_b)\ndef text_starta_endb(input_string):\n    \"\"\"\n    Checks if a string starts with 'a' and ends with 'b'.\n    The substring between 'a' and 'b' can be anything, including empty.\n    \"\"\"\n    input_obj = InputString(value=input_string)\n    matcher = TextMatcher()\n    match_result = matcher.match(input_obj)\n    return match_result.is_match"}
{"task_id": "Mbpp/796", "solution": "from typing import Mapping\nimport numbers\ndef return_sum(input_dict: Mapping) -> numbers.Number:\n    \"\"\"Accepts exactly one parameter (a dictionary) and returns numeric total.\n    Raises TypeError if input is not a dictionary; returns 0 for empty dictionary.\n    \"\"\"\n    _validate_input(input_dict)\n    total = 0\n    for v in input_dict.values():\n        total += v\n    return total"}
{"task_id": "Mbpp/797", "solution": "class Number:\n    \"\"\"Represents an integer value with natural and odd properties.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the number is odd.\"\"\"\n        return self.value % 2 != 0\n\n    def is_natural(self) -> bool:\n        \"\"\"Checks if the number is a natural number (>= 1).\"\"\"\n        return self.value >= 1\nclass Range:\n    \"\"\"Represents an inclusive integer range [start, end].\"\"\"\n    def __init__(self, start: int, end: int) -> None:\n        self.start = start\n        self.end = end\n\n    def is_empty(self) -> bool:\n        \"\"\"Determines if the range is empty (start > end).\"\"\"\n        return self.start > self.end\nclass Result:\n    \"\"\"A simple container for an accumulated sum.\"\"\"\n    def __init__(self, sum_value: int = 0) -> None:\n        self.sum = sum_value\nclass SumFunction:\n    \"\"\"Orchestrates the calculation of the sum of odd natural numbers in a range.\"\"\"\n    def __init__(self, l: int, r: int) -> None:\n        self.l = l\n        self.r = r\n        self.result = 0 # Initialized to 0, consistent with Result class\n\n    def validate_inputs(self) -> None:\n        \"\"\"Ensures inputs adhere to type contracts. No explicit checks or raises based on design constraints.\"\"\"\n        pass # The design specifies no isinstance() or exceptions.\n\n    def compute_sum(self) -> int:\n        \"\"\"Calculates the sum of odd natural numbers within the specified range.\"\"\"\n        current_range = Range(self.l, self.r)\n        if current_range.is_empty():\n            return 0\n\n        total_sum = Result()\n        for n in range(current_range.start, current_range.end + 1):\n            number_obj = Number(n)\n            if number_obj.is_natural() and number_obj.is_odd():\n                total_sum.sum += n\n        return total_sum.sum\ndef sum_in_range(l: int, r: int) -> int:\n    \"\"\"Return the sum of all odd natural numbers within inclusive range [l, r].\"\"\"\n    sum_calculator = SumFunction(l, r)\n    sum_calculator.validate_inputs()\n    return sum_calculator.compute_sum()"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(value, d):\n    \"\"\"\n    Performs a left bit rotation on a 32-bit unsigned integer.\n    The input value is masked to 32 bits, and the rotation count is normalized.\n    \"\"\"\n    MASK = 0xFFFFFFFF\n    BIT_LENGTH = 32\n\n    # Mask input to ensure it's treated as a 32-bit unsigned integer\n    value_masked = value & MASK\n\n    # Normalize the rotation count to be within 0-31\n    d_mod = d % BIT_LENGTH\n\n    if d_mod == 0:\n        # No rotation needed, return the masked value\n        result = value_masked\n    else:\n        # Perform the left rotation:\n        # 1. Shift left by d_mod bits\n        # 2. Shift right by (32 - d_mod) bits to get the wrapped portion\n        # 3. Combine with bitwise OR and mask to keep it within 32 bits\n        result = ((value_masked << d_mod) | (value_masked >> (BIT_LENGTH - d_mod))) & MASK\n\n    return result"}
{"task_id": "Mbpp/800", "solution": "def remove_all_spaces(input: str) -> str:\n    \"\"\"Return a copy of input with all whitespace characters removed.\n\n    Args:\n        input (str): The input string from which whitespace will be removed.\n\n    Returns:\n        str: The input string with all characters for which str.isspace() is True removed, preserving order of other characters.\n    \"\"\"\n    return \"\".join(char for char in input if not char.isspace())"}
{"task_id": "Mbpp/798", "solution": "def _sum(lst):\n    \"\"\"Compute and return the arithmetic sum of integer elements in lst. Returns 0 if lst is empty.\"\"\"\n    total = 0\n    for x in lst:\n        total += x\n    return total"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"\n    Counts the number of equal numbers among three given integers.\n    Returns 3 if all are equal, 2 if exactly two are equal, and 0 if all are different.\n    \"\"\"\n    if a == b and b == c:\n        return 3\n    elif a == b or a == c or b == c:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/803", "solution": "import math\ndef is_perfect_square(n: int) -> bool:\n    \"\"\"\n    Checks if the given integer n is a perfect square.\n    Negative numbers are not considered perfect squares.\n    \"\"\"\n    if n < 0:\n        return False\n    \n    # Calculate the integer square root.\n    # math.isqrt() is efficient for non-negative integers.\n    root = math.isqrt(n)\n    \n    # A number is a perfect square if the square of its integer square root equals the number itself.\n    return root * root == n"}
{"task_id": "Mbpp/805", "solution": "from typing import List, Union\nNumber = Union[int, float]\ndef max_sum_list(lists: List[List[Number]]) -> List[Number]:\n    \"\"\"Return the inner list with the highest sum of numeric elements. In case of ties, the first encountered inner list with the maximal sum is returned.\"\"\"\n    if not lists:\n        raise ValueError(\"Input outer list is empty; behavior unspecified in SRS\")\n    max_list = lists[0]\n    max_sum = sum(max_list)\n    for inner in lists[1:]:\n        s = sum(inner)\n        if s > max_sum:\n            max_sum = s\n            max_list = inner\n    return max_list"}
{"task_id": "Mbpp/804", "solution": "from typing import List\ndef is_product_even(numbers: List[int]) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    Assumes numbers is a List[int].\n    \"\"\"\n    for x in numbers:\n        if x % 2 == 0:\n            return True\n    return False"}
{"task_id": "Mbpp/806", "solution": "from typing import Optional\nclass _UppercaseRun:\n    \"\"\"Represents a contiguous run of uppercase characters.\"\"\"\n    def __init__(self, start_index: int) -> None:\n        self._start_index = start_index\n        self._end_index = start_index\n\n    def extend(self) -> None:\n        \"\"\"Increments the end index to extend the run.\"\"\"\n        self._end_index += 1\n\n    def length(self) -> int:\n        \"\"\"Returns the current length of the run.\"\"\"\n        return self._end_index - self._start_index + 1\nclass _Result:\n    \"\"\"Maintains the maximum run length found so far.\"\"\"\n    def __init__(self) -> None:\n        self._max_run_length = 0\n\n    def update_if_greater(self, candidate: int) -> None:\n        \"\"\"Updates the maximum run length if the candidate is greater.\"\"\"\n        if candidate > self._max_run_length:\n            self._max_run_length = candidate\n\n    def value(self) -> int:\n        \"\"\"Returns the stored maximum run length.\"\"\"\n        return self._max_run_length\ndef max_run_uppercase(s: str) -> int:\n    \"\"\"\n    Finds the maximum run of uppercase characters in the given string.\n    The function scans the string once, tracking the current and maximum run lengths.\n    \"\"\"\n    result = _Result()\n    current_run: Optional[_UppercaseRun] = None\n\n    for i, ch in enumerate(s):\n        if 'A' <= ch <= 'Z':  # Check for ASCII uppercase\n            if current_run is None:\n                current_run = _UppercaseRun(i)\n            else:\n                current_run.extend()\n        else:\n            if current_run is not None:\n                result.update_if_greater(current_run.length())\n                current_run = None\n    \n    # After the loop, if there's an ongoing run, update the result\n    if current_run is not None:\n        result.update_if_greater(current_run.length())\n            \n    return result.value()"}
{"task_id": "Mbpp/808", "solution": "from typing import Tuple\nclass TupleInput:\n    def __init__(self, elements: tuple):\n        \"\"\"Initializes TupleInput with a tuple of elements.\"\"\"\n        self.elements: tuple = elements\nclass KValue:\n    def __init__(self, value: int):\n        \"\"\"Initializes KValue with an integer value.\"\"\"\n        self.value: int = value\nclass CheckKService:\n    def check_K(self, tuple_input: TupleInput, k_value: KValue) -> bool:\n        \"\"\"\n        Checks if k_value is present in tuple_input's elements.\n        Returns True on the first match, otherwise False.\n        \"\"\"\n        for element in tuple_input.elements:\n            if element == k_value.value:\n                return True\n        return False\ndef check_K(tuple_of_integers: tuple, k: int) -> bool:\n    \"\"\"\n    Checks if the given tuple contains the integer k.\n    Delegates the core membership logic to CheckKService.\n    \"\"\"\n    tuple_input = TupleInput(tuple_of_integers)\n    k_value = KValue(k)\n    service = CheckKService()\n    return service.check_K(tuple_input, k_value)"}
{"task_id": "Mbpp/807", "solution": "def first_odd(nums):\n    \"\"\"\n    Finds the first odd number in a given list of numbers.\n    Iterates through the list and returns the first number for which num % 2 != 0; otherwise, returns None.\n    \"\"\"\n    for num in nums:\n        # Python's native 'for' loop will raise TypeError if 'nums' is not iterable.\n        # The '%' operator will raise TypeError if 'num' is not a numeric type.\n        # This fulfills the requirement to raise TypeError for invalid inputs without explicit isinstance checks.\n        if num % 2 != 0:\n            return num\n    return None"}
{"task_id": "Mbpp/809", "solution": "def _compare_pair(a_elem, b_elem) -> bool:\n    \"\"\"\n    Compares if b_elem is strictly less than a_elem.\n    This comparison naturally propagates TypeError if elements are non-comparable.\n    \"\"\"\n    return b_elem < a_elem\ndef _compare_elements(a: tuple, b: tuple) -> bool:\n    \"\"\"\n    Compares corresponding elements of two tuples using strict less-than.\n    Returns False immediately if any comparison is false, or True if all are true.\n    \"\"\"\n    for i in range(len(a)):\n        if not _compare_pair(a[i], b[i]):\n            return False\n    return True\ndef check_smaller(a: tuple, b: tuple) -> bool:\n    \"\"\"\n    Checks if each element of the second tuple is strictly smaller than\n    its corresponding element in the first tuple.\n    Raises TypeError for non-tuple inputs or non-comparable elements,\n    and ValueError for tuples of different lengths.\n    \"\"\"\n    _validate_is_tuple(a, 'a')\n    _validate_is_tuple(b, 'b')\n    _validate_same_length(a, b)\n    return _compare_elements(a, b)"}
