{"task_id": "Mbpp/603", "solution": "from typing import List\nclass InputParameter:\n    \"\"\"Validates that n is an integer, raising TypeError if not.\"\"\"\n    def __init__(self, n) -> None:\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        self.n = n\n\n    def is_integer(self) -> bool:\n        \"\"\"Checks if the stored parameter is an integer.\"\"\"\n        return isinstance(self.n, int)\nclass LudicSequence:\n    \"\"\"Manages the in-memory sequence of Ludic numbers.\"\"\"\n    def __init__(self) -> None:\n        self.numbers: List[int] = []\n\n    def add(self, num: int) -> None:\n        \"\"\"Adds a number to the Ludic sequence.\"\"\"\n        self.numbers.append(num)\n\n    def as_list(self) -> List[int]:\n        \"\"\"Returns the stored Ludic numbers as an ascending list.\"\"\"\n        return self.numbers\nclass LudicCalculator:\n    \"\"\"Coordinates the generation of Ludic numbers.\"\"\"\n    def get_ludic(self, n: int) -> List[int]:\n        \"\"\"Validates input and generates the Ludic sequence up to n.\"\"\"\n        # InputParameter validates and raises TypeError if n is not an integer.\n        # If instantiation succeeds, n is guaranteed to be an integer.\n        InputParameter(n) \n        return self._generate_sequence(n)\n\n    def _generate_sequence(self, n: int) -> List[int]:\n        \"\"\"Generates Ludic numbers up to n using a sieve-like method.\"\"\"\n        ludic_sequence = LudicSequence()\n        \n        if n < 1:\n            return ludic_sequence.as_list()\n\n        candidates = list(range(1, n + 1))\n        \n        while candidates:\n            l = candidates[0]\n            ludic_sequence.add(l)\n            candidates.pop(0)\n\n            if l == 1:\n                # The number 1 is Ludic but does not eliminate other numbers based on position.\n                continue\n\n            # Remove every l-th number from the remaining candidates list.\n            # We iterate backwards to avoid issues with index shifting during removal.\n            indices_to_remove = []\n            current_idx = l - 1 # Corresponds to the 1-indexed l-th element\n            while current_idx < len(candidates):\n                indices_to_remove.append(current_idx)\n                current_idx += l\n\n            for idx in sorted(indices_to_remove, reverse=True):\n                candidates.pop(idx)\n        \n        return ludic_sequence.as_list()\ndef get_ludic(n: int) -> List[int]:\n    \"\"\"\n    Returns all Ludic numbers smaller than or equal to a given integer n.\n    Raises TypeError if n is not an integer.\n    \"\"\"\n    calculator = LudicCalculator()\n    return calculator.get_ludic(n)"}
{"task_id": "Mbpp/604", "solution": "def reverse_words(input_str: str) -> str:\n    \"\"\"Reverse words separated by space character and return single-space-joined string.\"\"\"\n    words = input_str.split(' ')\n    filtered_words = [word for word in words if word]\n    reversed_words = filtered_words[::-1]\n    return ' '.join(reversed_words)"}
{"task_id": "Mbpp/608", "solution": "class ValidationRule:\n    \"\"\"Provides predicates for input validation.\"\"\"\n    def is_integer(self, n) -> bool:\n        \"\"\"Checks if n is an integer.\"\"\"\n        return isinstance(n, int)\n\n    def is_non_negative(self, n: int) -> bool:\n        \"\"\"Checks if n is non-negative.\"\"\"\n        return n >= 0\nclass BellNumberCalculator:\n    \"\"\"Calculates Bell numbers and handles input validation.\"\"\"\n    def bell_Number(self, n: int) -> int:\n        \"\"\"\n        Validates input and computes the nth Bell number.\n        Returns the nth Bell number as an integer.\n        \"\"\"\n        self.validate_input(n)\n        return self.compute_bell(n)\n\n    def validate_input(self, n) -> None:\n        \"\"\"\n        Uses ValidationRule to check type and non-negativity.\n        Raises TypeError or ValueError accordingly.\n        \"\"\"\n        v = ValidationRule()\n        if not v.is_integer(n):\n            raise TypeError('n must be an int')\n        if not v.is_non_negative(n):\n            raise ValueError('n must be non-negative')\n\n    def compute_bell(self, n: int) -> int:\n        \"\"\"\n        Internal computation returning the nth Bell number using Stirling numbers of the second kind.\n        \"\"\"\n        if n == 0:\n            return 1\n\n        stirling_triangle = [[0] * (n + 1) for _ in range(n + 1)]\n        stirling_triangle[0][0] = 1\n\n        for i in range(1, n + 1):\n            for j in range(1, i + 1):\n                stirling_triangle[i][j] = stirling_triangle[i-1][j-1] + j * stirling_triangle[i-1][j]\n        \n        return sum(stirling_triangle[n][j] for j in range(n + 1))\ndef bell_Number(n) -> int:\n    \"\"\"\n    Computes the nth Bell number.\n    Delegates validation and computation to BellNumberCalculator.\n    \"\"\"\n    calc = BellNumberCalculator()\n    return calc.bell_Number(n)"}
{"task_id": "Mbpp/607", "solution": "import re\nfrom dataclasses import dataclass\ndef find_literals(input_string: str, pattern: str):\n    \"\"\"\n    Searches a string for the first regex pattern match, returning the matching substring,\n    its start index, and its end index. Returns None if no match is found.\n    \"\"\"\n    compiled_pattern = re.compile(pattern)\n    match = compiled_pattern.search(input_string)\n\n    if match:\n        start_index, end_index = match.span()\n        matched_substring = input_string[start_index:end_index]\n        return (matched_substring, start_index, end_index)\n    else:\n        return None"}
{"task_id": "Mbpp/610", "solution": "def validate_index(k, length):\n    \"\"\"Return True if k is int and 1 <= k <= length, else False.\"\"\"\n    return isinstance(k, int) and (1 <= k <= length)\ndef remove_at_index(input_list, k):\n    \"\"\"Return new list with 1-based k'th element removed; order preserved.\"\"\"\n    idx_0based = k - 1\n    return input_list[:idx_0based] + input_list[idx_0based + 1:]\ndef remove_kth_element(input_list, k):\n    \"\"\"Return a new list equal to input_list with the 1-based k'th element removed.\n\n    Raises TypeError if k is not int, or IndexError if k is out of range.\n    \"\"\"\n    length = len(input_list)\n    \n    if not validate_index(k, length):\n        if not isinstance(k, int):\n            raise TypeError(\"k must be an integer.\")\n        else: # k is an int but out of valid range\n            raise IndexError(\"k is out of the valid 1-based range for the list.\")\n\n    return remove_at_index(input_list, k)"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix, n):\n    \"\"\"\n    Returns the maximum value from the n-th column of a matrix.\n    The matrix is represented as a list of lists.\n    \"\"\"\n    column_values = [row[n] for row in matrix]\n    return max(column_values)"}
{"task_id": "Mbpp/612", "solution": "def merge(input_list):\n    \"\"\"\n    Transforms a list of 2-element sublists into a list of two lists:\n    the first containing all first elements, and the second containing all second elements.\n    \"\"\"\n    if not input_list:\n        return [[], []]\n    \n    first_elements = []\n    second_elements = []\n    for sublist in input_list:\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n        \n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/614", "solution": "from typing import List, Tuple\ndef cummulative_sum(list_of_tuples: List[Tuple[int, ...]]) -> int:\n    \"\"\"\n    Calculates the cumulative sum of all integers present in a list of tuples.\n    Iterates through each tuple and sums its integer elements.\n    \"\"\"\n    total: int = 0\n    for tup in list_of_tuples:\n        for value in tup:\n            total += value\n    return total"}
{"task_id": "Mbpp/615", "solution": "def _average_of_inner(inner_tuple):\n    \"\"\"\n    Calculates the arithmetic mean of a tuple of numbers.\n    Assumes the input tuple is non-empty and contains only numeric values.\n    \"\"\"\n    return float(sum(inner_tuple) / len(inner_tuple))\ndef average_tuple(input_tuple_of_tuples):\n    \"\"\"\n    Computes the average value for each inner tuple in a tuple of tuples.\n    Assumes all inputs are valid as per output constraints.\n    \"\"\"\n    _validate_input(input_tuple_of_tuples)\n    averages = []\n    for inner_tuple in input_tuple_of_tuples:\n        averages.append(_average_of_inner(inner_tuple))\n    return averages"}
