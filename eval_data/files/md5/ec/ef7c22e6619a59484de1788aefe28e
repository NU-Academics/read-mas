{"task_id": "Mbpp/410", "solution": "from typing import Any, Iterator, Union\nclass Element:\n    def __init__(self, raw_value: Any):\n        self._raw_value = raw_value\n\n    def is_numeric(self) -> bool:\n        \"\"\"Determines if the raw value is numeric (int or float).\"\"\"\n        # Follows design note: bool is subclass of int, classification follows Python types.\n        return isinstance(self._raw_value, (int, float))\n\n    def to_numeric(self) -> Union[int, float]:\n        \"\"\"Converts the element to its numeric value if numeric, otherwise raises ValueError.\"\"\"\n        if self.is_numeric():\n            return self._raw_value\n        raise ValueError(\"Element is not numeric.\")\nclass NumericElement(Element):\n    def __init__(self, raw_value: Union[int, float]):\n        super().__init__(raw_value)\n        self._value = raw_value\n\n    def is_numeric(self) -> bool:\n        return True\n\n    def to_numeric(self) -> Union[int, float]:\n        return self._value\nclass NonNumericElement(Element):\n    def __init__(self, raw_value: Any):\n        super().__init__(raw_value)\n        self._value = raw_value\n\n    def is_numeric(self) -> bool:\n        return False\n\n    def to_numeric(self) -> Union[int, float]:\n        raise ValueError(\"Non-numeric element cannot be converted to numeric.\")\nclass ListInput:\n    def __init__(self, elements: list):\n        self._elements = elements\n\n    def validate_input(self) -> bool:\n        \"\"\"Returns True if the internal elements is a Python list.\"\"\"\n        return isinstance(self._elements, list)\n\n    def __iter__(self) -> Iterator[Element]:\n        \"\"\"Yields Element instances (NumericElement or NonNumericElement) for each raw item.\"\"\"\n        for item in self._elements:\n            # \"Element classification follows Python types per the design notes.\"\n            # This means bools (subclass of int) are considered numeric.\n            if isinstance(item, (int, float)):\n                yield NumericElement(item)\n            else:\n                yield NonNumericElement(item)\nclass MinValueResult:\n    def __init__(self, value: Union[int, float]):\n        self._value = value\n\n    def value(self) -> Union[int, float]:\n        \"\"\"Returns the encapsulated minimum numeric value.\"\"\"\n        return self._value\ndef min_val(input_list: list) -> Union[int, float]:\n    \"\"\"\n    Finds the minimum numeric value in a given heterogeneous list, ignoring non-numeric elements.\n    \"\"\"\n    min_numeric_value = None\n\n    list_input_wrapper = ListInput(input_list)\n\n    for element in list_input_wrapper:\n        if element.is_numeric():\n            current_numeric_value = element.to_numeric()\n            if min_numeric_value is None or current_numeric_value < min_numeric_value:\n                min_numeric_value = current_numeric_value\n\n    # Per design, behavior for no numeric elements is unspecified,\n    # and the example assertion guarantees a numeric result.\n    result = MinValueResult(min_numeric_value)\n    return result.value()"}
{"task_id": "Mbpp/412", "solution": "from typing import List\ndef remove_odd(input_list: List[int]) -> List[int]:\n    \"\"\"Return a new list containing only even integers from input_list in original order.\"\"\"\n    even_numbers = []\n    for number in input_list:\n        if number % 2 == 0:\n            even_numbers.append(number)\n    return even_numbers"}
