{"task_id": "Mbpp/277", "solution": "class Result:\n    \"\"\"A data holder for filtered_entries dictionary.\"\"\"\n    def __init__(self, filtered_entries: dict):\n        self.filtered_entries = filtered_entries\nclass DictFilter:\n    \"\"\"Encapsulates the logic for filtering dictionary entries.\"\"\"\n    def filter(self, input_dict: dict, n: int) -> Result:\n        \"\"\"Filters dictionary entries based on value greater than or equal to n.\"\"\"\n        filtered_entries = {}\n        for key, value in input_dict.items():\n            if value >= n:\n                filtered_entries[key] = value\n        return Result(filtered_entries)\ndef dict_filter(input_dict: dict, n: int) -> dict:\n    \"\"\"\n    Filters a dictionary to include only entries with values greater than or equal to n.\n    Returns a new dictionary, leaving the input dictionary unchanged.\n    \"\"\"\n    if not isinstance(input_dict, dict) or not isinstance(n, int):\n        raise TypeError(\"input_dict must be a dict and n must be an int\")\n\n    result = DictFilter().filter(input_dict, n)\n    return result.filtered_entries"}
{"task_id": "Mbpp/281", "solution": "def all_unique(input_list):\n    \"\"\"Return True if all elements in input_list are unique, else False.\n    Equality comparisons use Python's == semantics; True for an empty list.\n    \"\"\"\n    seen = []\n    for item in input_list:\n        if item in seen:\n            return False\n        seen.append(item)\n    return True"}
{"task_id": "Mbpp/278", "solution": "def _is_tuple(obj) -> bool:\n    \"\"\"Internal helper to check if an object is a tuple.\"\"\"\n    return type(obj) is tuple\ndef count_first_elements(input_tuple):\n    \"\"\"\n    Counts elements before the first top-level tuple element in the given tuple.\n    Raises TypeError if the input is not a tuple.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    for i, element in enumerate(input_tuple):\n        if _is_tuple(element):\n            return i\n    return len(input_tuple)"}
{"task_id": "Mbpp/279", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception for validation errors.\"\"\"\n    def __init__(self, message: str, code: int = 400):\n        super().__init__(message)\n        self.message = message\n        self.code = code\nclass InputValidator:\n    \"\"\"Validator for input 'n' based on specified constraints.\"\"\"\n    @staticmethod\n    def validateInteger(n):\n        \"\"\"Validates if 'n' is an integer.\"\"\"\n        if not isinstance(n, int):\n            raise ValidationError(\"n must be an integer\", code=400)\n\n    @staticmethod\n    def validateMinValue(n):\n        \"\"\"Validates if 'n' is greater than or equal to 1.\"\"\"\n        if n < 1:\n            raise ValidationError(\"n must be an integer >= 1\", code=400)\nclass DecagonalNumber:\n    \"\"\"Encapsulates decagonal number data and computation.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n        self.value = None\n\n    def computeValue(self) -> int:\n        \"\"\"Computes the decagonal number using the formula D_n = 4*n*n - 3*n.\"\"\"\n        self.value = 4 * self.n * self.n - 3 * self.n\n        return self.value\nclass IsNumDecagonalFunction:\n    \"\"\"Coordinates validation and computation for decagonal numbers.\"\"\"\n    @staticmethod\n    def is_num_decagonal(n):\n        \"\"\"Validates input and computes the nth decagonal number.\"\"\"\n        InputValidator.validateInteger(n)\n        InputValidator.validateMinValue(n)\n        dn = DecagonalNumber(n)\n        return dn.computeValue()\ndef is_num_decagonal(n):\n    \"\"\"Validate and compute the nth decagonal number. Returns int D_n or raises ValidationError.\"\"\"\n    return IsNumDecagonalFunction.is_num_decagonal(n)"}
{"task_id": "Mbpp/280", "solution": "from typing import Any, Iterable, Tuple\ndef _is_iterable(obj: Any) -> bool:\n    \"\"\"Checks if an object is iterable.\"\"\"\n    try:\n        iter(obj)\n        return True\n    except TypeError:\n        return False\ndef sequential_search(array: Iterable[Any], element: Any) -> Tuple[bool, int]:\n    \"\"\"\n    Performs a linear search for an element in an array.\n    Returns (True, index) if found, otherwise (False, -1).\n    \"\"\"\n    if not _is_iterable(array):\n        raise TypeError(\"array must be an iterable\")\n\n    for i, item in enumerate(array):\n        if item == element:\n            return (True, i)\n\n    return (False, -1)"}
{"task_id": "Mbpp/282", "solution": "class SubList:\n    def execute(self, a: list, b: list) -> list:\n        # Computes element-wise subtraction for overlapping indices.\n        result = []\n        min_len = min(len(a), len(b))\n        for i in range(min_len):\n            result.append(a[i] - b[i])\n        return result\ndef sub_list(a: list, b: list) -> list:\n    # Public API to subtract two lists element-wise, delegating to SubList.\n    sub_list_instance = SubList()\n    return sub_list_instance.execute(a, b)"}
{"task_id": "Mbpp/283", "solution": "import collections\nimport math\ndef validate(integer: int) -> bool:\n    \"\"\"Return True iff for every digit d in integer's decimal digits, count(d) <= d.\"\"\"\n    def parse_digits(n: int) -> list[int]:\n        \"\"\"Return list of decimal digits for integer n. Uses abs(n); n==0 -> [0].\"\"\"\n        if n == 0:\n            return [0]\n        digits = []\n        n = abs(n)\n        while n > 0:\n            digits.append(n % 10)\n            n //= 10\n        return digits\n\n    def count_digit_frequencies(digits: list[int]) -> dict[int, int]:\n        \"\"\"Return mapping digit -> count for digits list.\"\"\"\n        return collections.Counter(digits)\n\n    def counts_satisfy_constraint(counts: dict[int, int]) -> bool:\n        \"\"\"Return True iff for every digit d in counts, counts[d] <= d.\"\"\"\n        for digit, count in counts.items():\n            if count > digit:\n                return False\n        return True\n\n    digits = parse_digits(integer)\n    counts = count_digit_frequencies(digits)\n    return counts_satisfy_constraint(counts)"}
