{"task_id": "Mbpp/139", "solution": "import math\nimport numbers\ndef circle_circumference(radius):\n    \"\"\"\n    Calculates the circumference of a circle given its radius.\n\n    Raises TypeError if radius is not numeric, ValueError if radius is negative.\n    \"\"\"\n    if not isinstance(radius, numbers.Real):\n        raise TypeError(\"radius must be a numeric type\")\n    if radius < 0:\n        raise ValueError(\"radius must be non-negative\")\n\n    result = 2 * math.pi * radius\n    return float(result)"}
{"task_id": "Mbpp/140", "solution": "class _UniqueAggregator:\n    \"\"\"Helper class to aggregate unique numbers from nested iterables.\"\"\"\n    def __init__(self):\n        self._items = set()\n\n    def add_iterable(self, iterable):\n        \"\"\"Adds all items from an iterable to the internal set.\"\"\"\n        for item in iterable:\n            self._items.add(item)\n\n    def result(self) -> set:\n        \"\"\"Returns a set containing all unique aggregated items.\"\"\"\n        return set(self._items)\ndef extract_singly(iterables):\n    \"\"\"\n    Accept an iterable of iterables of numbers and return a set of all unique numbers.\n    Each nested iterable's elements are added to a single set, ensuring uniqueness.\n    \"\"\"\n    aggregator = _UniqueAggregator()\n    for nested in iterables:\n        aggregator.add_iterable(nested)\n    return aggregator.result()"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(a, b, c) -> int:\n    \"\"\"Count indices i where a[i] == b[i] == c[i].\n    Validate inputs support len() and indexing; otherwise raise TypeError.\n    Returns integer count.\n    \"\"\"\n    for arg_name, arg_value in [(\"a\", a), (\"b\", b), (\"c\", c)]:\n        if not hasattr(arg_value, '__len__') or not hasattr(arg_value, '__getitem__'):\n            raise TypeError(f\"Input '{arg_name}' must be a sequence supporting len() and indexing.\")\n\n    min_len = min(len(a), len(b), len(c))\n    count = 0\n\n    for i in range(min_len):\n        if a[i] == b[i] == c[i]:\n            count += 1\n            \n    return count"}
{"task_id": "Mbpp/141", "solution": "class Element:\n    \"\"\"Encapsulates a single atomic sortable value.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def __lt__(self, other):\n        if isinstance(other, Element):\n            return self.value < other.value\n        return self.value < other # Allow comparison with native types\n\n    def __eq__(self, other):\n        if isinstance(other, Element):\n            return self.value == other.value\n        return self.value == other # Allow comparison with native types\n\n    def __repr__(self):\n        return f\"Element({self.value})\"\nclass List:\n    \"\"\"Represents an input ordered collection of Element instances.\"\"\"\n    def __init__(self, elements: 'list'):\n        # Ensure elements are Element objects\n        self.elements = [e if isinstance(e, Element) else Element(e) for e in elements]\n\n    def to_native(self) -> list:\n        \"\"\"Returns a list of the underlying element values.\"\"\"\n        return [e.value for e in self.elements]\n\n    def __len__(self):\n        return len(self.elements)\n\n    def __getitem__(self, index):\n        return self.elements[index]\n\n    def __repr__(self):\n        return f\"List({self.to_native()})\"\nclass SortedList:\n    \"\"\"Represents a sorted output collection of Element instances.\"\"\"\n    def __init__(self, elements: 'list[Element]'):\n        self.elements = elements\n\n    def to_native(self) -> list:\n        \"\"\"Returns a list of the underlying element values.\"\"\"\n        return [e.value for e in self.elements]\n\n    def __eq__(self, other) -> bool:\n        \"\"\"Compares SortedList with another SortedList or a native list based on element values.\"\"\"\n        if isinstance(other, SortedList):\n            return self.to_native() == other.to_native()\n        elif isinstance(other, list):\n            return self.to_native() == other\n        return NotImplemented\n\n    def __repr__(self):\n        return f\"SortedList({self.to_native()})\"\ndef _find_max_index(arr: list[Element], n: int) -> int:\n    \"\"\"Returns the index of the maximum element in arr[0:n].\"\"\"\n    max_idx = 0\n    for i in range(1, n):\n        if arr[i] > arr[max_idx]:\n            max_idx = i\n    return max_idx\ndef pancake_sort(inputList: List | list) -> SortedList:\n    \"\"\"\n    Sorts a list of elements using the pancake sort algorithm.\n    Returns a new SortedList instance with elements in non-decreasing order.\n    \"\"\"\n    if isinstance(inputList, List):\n        # Create a deep copy of elements to sort, operating on Element objects\n        elements_to_sort = [Element(e.value) for e in inputList.elements]\n    else: # Assume it's a native list (e.g., [15, 79, ...])\n        elements_to_sort = [Element(e) for e in inputList]\n\n    n = len(elements_to_sort)\n\n    # Handle edge cases for empty or single-element lists\n    if n <= 1:\n        return SortedList(elements_to_sort)\n\n    # Perform pancake sorting\n    for curr_size in range(n, 1, -1):\n        # Find index of the maximum element in the current unsorted portion\n        max_idx = _find_max_index(elements_to_sort, curr_size)\n\n        # If the maximum element is not already at its correct position\n        if max_idx != curr_size - 1:\n            # Flip to bring the maximum element to the front\n            _flip(elements_to_sort, max_idx)\n            # Flip to move the maximum element to its final sorted position\n            _flip(elements_to_sort, curr_size - 1)\n\n    return SortedList(elements_to_sort)"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(source: list, removal: list) -> list:\n    \"\"\"Removes all elements from the source list that are present in the removal list.\n    Preserves the original order of the remaining elements.\"\"\"\n    \n    result = []\n    for s in source:\n        should_remove = False\n        for r in removal:\n            if s == r:\n                should_remove = True\n                break\n        if not should_remove:\n            result.append(s)\n    return result"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(sequence):\n    \"\"\"\n    Finds the maximum absolute difference between any two elements in a given sequence.\n    This is achieved by calculating the absolute difference between the maximum and minimum elements.\n    \"\"\"\n    min_val = min(sequence)\n    max_val = max(sequence)\n    return abs(max_val - min_val)"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n):\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) for i from 0 to n // 2.\n    For example, sum_series(6) calculates 6 + (6-2) + (6-4) + (6-6) = 6 + 4 + 2 + 0 = 12.\n    \"\"\"\n    total_sum = 0\n    for i in range(n // 2 + 1):  # Iterate from i=0 to n // 2 inclusive\n        total_sum += (n - 2 * i)\n    return total_sum"}
{"task_id": "Mbpp/160", "solution": "from typing import Optional, Tuple\nclass ExtendedGCD:\n    \"\"\"\n    Utility class for the Extended Euclidean Algorithm.\n    \"\"\"\n    @staticmethod\n    def compute(a: int, b: int) -> Tuple[int, int, int]:\n        \"\"\"\n        Computes gcd(a, b) and Bezout coefficients x, y such that a*x + b*y == gcd(a,b).\n        Handles zero and negative integers, returning gcd >= 0.\n        \"\"\"\n        if b == 0:\n            return (abs(a), 1 if a >= 0 else -1, 0)\n        else:\n            gcd, x_prime, y_prime = ExtendedGCD.compute(b, a % b)\n            x = y_prime\n            y = x_prime - (a // b) * y_prime\n            return (gcd, x, y)\nclass Solution:\n    \"\"\"Immutable value object representing a particular solution (x, y).\"\"\"\n    def __init__(self, x: int, y: int):\n        self.x = x\n        self.y = y\nclass LinearDiophantineEquation:\n    \"\"\"\n    Encapsulates a linear Diophantine equation ax + by = n.\n    Determines solvability and computes one solution.\n    \"\"\"\n    def __init__(self, a: int, b: int, n: int):\n        self.a = a\n        self.b = b\n        self.n = n\n\n    def hasSolution(self) -> bool:\n        \"\"\"Returns True iff gcd(a, b) divides n.\"\"\"\n        gcd_val, _, _ = ExtendedGCD.compute(self.a, self.b)\n        \n        if gcd_val == 0:\n            return self.n == 0\n        \n        return self.n % gcd_val == 0\n\n    def computeOneSolution(self) -> Solution:\n        \"\"\"\n        Computes one particular solution (x, y) to ax + by = n.\n        Assumes hasSolution() is True. Normalizes to match acceptance criteria.\n        \"\"\"\n        gcd_val, x0_bezout, y0_bezout = ExtendedGCD.compute(self.a, self.b)\n\n        if gcd_val == 0: # Implies a=0, b=0, and n must be 0 from hasSolution()\n            return Solution(x0_bezout, y0_bezout)\n        \n        factor = self.n // gcd_val\n        x_particular = x0_bezout * factor\n        y_particular = y0_bezout * factor\n\n        # Normalize the solution to obtain a canonical form (e.g., smallest non-negative x),\n        # as required by the specific acceptance test find_solution(2, 3, 7) == (2, 1).\n        if self.b != 0:\n            # step_x_abs represents the period of x values for solutions.\n            step_x_abs = abs(self.b // gcd_val)\n            \n            # Adjust x_particular to be within the range [0, step_x_abs - 1]\n            x_sol = x_particular % step_x_abs\n            \n            # Calculate the corresponding y_sol\n            y_sol = (self.n - self.a * x_sol) // self.b\n            \n            return Solution(x_sol, y_sol)\n        elif self.a != 0: # If b is 0 but a is not (and gcd_val is not 0)\n            x_sol = self.n // self.a\n            y_sol = 0 # Any y is valid, choose 0 for simplicity.\n            return Solution(x_sol, y_sol)\n        else: # This branch should be unreachable if hasSolution() and gcd_val == 0 are handled.\n            return Solution(x_particular, y_particular)\ndef find_solution(a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n    \"\"\"\n    Returns integers x and y that satisfy ax + by = n as a tuple,\n    or returns None if no solution exists.\n    \"\"\"\n    equation = LinearDiophantineEquation(a, b, n)\n\n    if not equation.hasSolution():\n        return None\n    else:\n        solution = equation.computeOneSolution()\n        return (solution.x, solution.y)"}
