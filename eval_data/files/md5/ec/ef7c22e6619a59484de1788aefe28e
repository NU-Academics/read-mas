{"task_id": "Mbpp/618", "solution": "from typing import List, Iterable\nfrom numbers import Number\nclass LengthMismatchError(Exception):\n    \"\"\"Exception raised when input lists have different lengths.\"\"\"\n    def __init__(self, message: str = \"Input lists must have the same length.\") -> None:\n        super().__init__(message)\nclass NonNumericError(Exception):\n    \"\"\"Exception raised when a non-numeric element is found in a list.\"\"\"\n    def __init__(self, message: str = \"All list elements must be numeric.\") -> None:\n        super().__init__(message)\nclass DivisionResult:\n    \"\"\"A domain class to hold the results of element-wise division.\"\"\"\n    def __init__(self, values: List[float]) -> None:\n        self._values = values\n\n    def as_list(self) -> List[float]:\n        \"\"\"Returns the division results as a plain list of floats.\"\"\"\n        return self._values\nclass ListValidator:\n    \"\"\"Provides stateless validation utilities for lists.\"\"\"\n    def validate_length(self, a: List[Number], b: List[Number]) -> None:\n        \"\"\"Validates that two lists have the same length.\"\"\"\n        if len(a) != len(b):\n            raise LengthMismatchError(\"Input lists must have the same length.\")\n\n    def validate_numeric(self, a: Iterable[Number], b: Iterable[Number]) -> None:\n        \"\"\"Validates that all elements in the given iterables are numeric.\"\"\"\n        for element in a:\n            if not isinstance(element, Number):\n                raise NonNumericError(f\"Element '{element}' in the first list is not numeric.\")\n        for element in b:\n            if not isinstance(element, Number):\n                raise NonNumericError(f\"Element '{element}' in the second list is not numeric.\")\ndef div_list(a: List[Number], b: List[Number]) -> List[float]:\n    \"\"\"\n    Performs element-wise division of two lists after validating their length and content.\n    Returns a list of float division results or raises an error on validation failure.\n    \"\"\"\n    validator = ListValidator()\n    validator.validate_length(a, b)\n    validator.validate_numeric(a, b)\n\n    results = [float(val_a) / float(val_b) for val_a, val_b in zip(a, b)]\n\n    division_result = DivisionResult(results)\n    return division_result.as_list()"}
{"task_id": "Mbpp/619", "solution": "def _is_ascii_digit(ch: str) -> bool:\n    \"\"\"Checks if a character is an ASCII digit ('0'-'9').\"\"\"\n    return '0' <= ch <= '9'\ndef move_num(input: str) -> str:\n    \"\"\"Moves all numeric characters to the end of the string, preserving relative order.\"\"\"\n    non_digits = []\n    digits = []\n    for char in input:\n        if _is_ascii_digit(char):\n            digits.append(char)\n        else:\n            non_digits.append(char)\n    return \"\".join(non_digits) + \"\".join(digits)"}
{"task_id": "Mbpp/622", "solution": "def get_median(A: list, B: list, n: int) -> float:\n    \"\"\"\n    Finds the median of two sorted lists of the same size n.\n    The median is the average of the n-th and (n+1)-th elements from the combined sorted lists.\n    \"\"\"\n    i = 0  # Pointer for list A\n    j = 0  # Pointer for list B\n    count = 0  # Count of elements merged so far\n    prev = 0  # Stores the (count-1)-th merged element\n    curr = 0  # Stores the count-th merged element\n\n    # Iterate until we find the (n+1)-th element in the merged sequence\n    while count <= n:\n        prev = curr\n        if i < n and j < n:\n            if A[i] <= B[j]:\n                curr = A[i]\n                i += 1\n            else:\n                curr = B[j]\n                j += 1\n        elif i < n:  # List B is exhausted\n            curr = A[i]\n            i += 1\n        else:  # List A is exhausted\n            curr = B[j]\n            j += 1\n        count += 1\n\n    # The median is the average of the n-th (prev) and (n+1)-th (curr) elements\n    return (float(prev) + float(curr)) / 2.0"}
{"task_id": "Mbpp/620", "solution": "from typing import List\nclass IntegerElement:\n    \"\"\"Domain model for an individual integer element.\"\"\"\n    def __init__(self, id: int, value: int) -> None:\n        self.id = id\n        self.value = value\nclass IntegerList:\n    \"\"\"Collection holder for integer elements, supporting length and sorting.\"\"\"\n    def __init__(self, values: List[int]) -> None:\n        self.elements = [IntegerElement(i, value) for i, value in enumerate(values)]\n\n    def length(self) -> int:\n        return len(self.elements)\n\n    def sort(self) -> None:\n        \"\"\"Sorts elements by their value in ascending order.\"\"\"\n        self.elements.sort(key=lambda x: x.value)\nclass DivisibilityRelation:\n    \"\"\"Stateless encapsulation of the divisibility rule.\"\"\"\n    def is_divisible(self, a: IntegerElement, b: IntegerElement) -> bool:\n        # Checks if b is divisible by a (b.value % a.value == 0).\n        # Per design, if a.value == 0, ZeroDivisionError is allowed to propagate.\n        return b.value % a.value == 0\nclass Subset:\n    \"\"\"Container for a candidate divisible subset.\"\"\"\n    def __init__(self, elements: List[IntegerElement]) -> None:\n        self.elements = elements\n\n    def size(self) -> int:\n        return len(self.elements)\nclass DivisibilityGraph:\n    \"\"\"Builds and exposes divisibility relations among nodes, and derives candidate subsets.\"\"\"\n    def __init__(self) -> None:\n        self.nodes: List[IntegerElement] = []\n        self.edges: List[List[int]] = [] # Stored as index pairs (src_idx, dest_idx)\n\n    def build(self, integer_list: IntegerList) -> None:\n        \"\"\"Populates nodes and edges from the given integer list.\"\"\"\n        self.nodes = integer_list.elements\n        self.edges = []\n        \n        relation = DivisibilityRelation()\n        n = len(self.nodes)\n        for i in range(n):\n            for j in range(n):\n                if i != j and relation.is_divisible(self.nodes[i], self.nodes[j]):\n                    self.edges.append([i, j])\n\n    def get_connected_subsets(self) -> List[Subset]:\n        \"\"\"\n        Computes the longest divisible subsequences (chains) using dynamic programming.\n        Returns a list of Subset objects representing these maximal chains.\n        \"\"\"\n        n = len(self.nodes)\n        if n == 0:\n            return []\n\n        # dp[i] = length of the longest divisible subset ending with self.nodes[i]\n        dp = [1] * n\n        # subsets_at_end[i] = the actual list of IntegerElements for the longest chain ending at self.nodes[i]\n        subsets_at_end = [[self.nodes[i]] for i in range(n)]\n\n        for i in range(n):\n            for j in range(i):\n                if self.nodes[i].value % self.nodes[j].value == 0:\n                    if dp[j] + 1 > dp[i]:\n                        dp[i] = dp[j] + 1\n                        subsets_at_end[i] = subsets_at_end[j] + [self.nodes[i]]\n        \n        max_len = 0\n        if n > 0:\n            max_len = max(dp)\n            \n        result_subsets = []\n        for i in range(n):\n            if dp[i] == max_len:\n                result_subsets.append(Subset(subsets_at_end[i]))\n        \n        return result_subsets\nclass LargestSubsetCalculator:\n    \"\"\"Calculates the size of the largest divisible subset.\"\"\"\n    def largest_subset(self, integer_list: IntegerList) -> int:\n        if integer_list.length() == 0:\n            return 0\n        if integer_list.length() == 1:\n            return 1\n        \n        # Sort the integer list to enable the dynamic programming approach.\n        integer_list.sort()\n        \n        graph = DivisibilityGraph()\n        graph.build(integer_list)\n        \n        candidate_subsets = graph.get_connected_subsets()\n        \n        max_size = 0\n        for subset in candidate_subsets:\n            max_size = max(max_size, subset.size())\n            \n        return max_size\ndef largest_subset(list_of_integers: List[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of numbers where every pair is divisible.\n    The divisibility rule is b % a == 0.\n    \"\"\"\n    integer_list = IntegerList(list_of_integers)\n    calculator = LargestSubsetCalculator()\n    return calculator.largest_subset(integer_list)"}
