{"task_id": "Mbpp/271", "solution": "def even_Power_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the first n even natural numbers, each raised to the fifth power.\n    \"\"\"\n\n    class EvenNumber:\n        \"\"\"Represents an even number and can compute its power.\"\"\"\n        def __init__(self, index: int):\n            self.index: int = index\n            self.value: int = 2 * index\n            self.powerValue: int | None = None\n\n        def toPower(self, exp: int) -> int:\n            if self.powerValue is None:\n                self.powerValue = self.value ** exp\n            return self.powerValue\n\n    class EvenNumberSequence:\n        \"\"\"Generates a sequence of EvenNumber objects.\"\"\"\n        def __init__(self, n: int):\n            self.n: int = n\n\n        def generate(self) -> list[EvenNumber]:\n            return [EvenNumber(i) for i in range(1, self.n + 1)]\n\n    class PowerOperation:\n        \"\"\"Applies a power operation to an EvenNumber.\"\"\"\n        def __init__(self, exp: int = 5):\n            self.exp: int = exp\n\n        def apply(self, e: EvenNumber) -> int:\n            return e.toPower(self.exp)\n\n    class SumResult:\n        \"\"\"Accumulates a total sum.\"\"\"\n        def __init__(self, total: int = 0):\n            self.total: int = total\n\n        def add(self, v: int) -> None:\n            self.total += v\n\n        def as_int(self) -> int:\n            return self.total\n\n    class FunctionCall:\n        \"\"\"Orchestrates the validation and execution of the sum calculation.\"\"\"\n        def __init__(self, n_val: int):\n            self.n: int = n_val\n\n        def validate_input(self):\n            # The public function even_Power_Sum handles TypeError.\n            pass\n\n        def execute(self) -> SumResult:\n            if self.n <= 0:\n                return SumResult(total=0)\n\n            even_numbers_sequence = EvenNumberSequence(self.n)\n            even_numbers = even_numbers_sequence.generate()\n            \n            power_op = PowerOperation(exp=5)\n            sum_result = SumResult(total=0)\n\n            for even_num in even_numbers:\n                powered_value = power_op.apply(even_num)\n                sum_result.add(powered_value)\n            \n            return sum_result\n\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n\n    function_call = FunctionCall(n)\n    function_call.validate_input() # This now only passes, as type check is external.\n    result = function_call.execute()\n    return result.as_int()"}
{"task_id": "Mbpp/273", "solution": "from typing import Tuple\ndef _compute_result(a: Tuple, b: Tuple) -> Tuple:\n    \"\"\"Compute and return tuple(a[i] - b[i] for i in range(len(a))).\"\"\"\n    return tuple(a[i] - b[i] for i in range(len(a)))\ndef substract_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"Public API: substract_elements(first_tuple: tuple, second_tuple: tuple) -> tuple\n    Validates inputs and returns tuple of element-wise subtraction results.\n    \"\"\"\n    _validate_types(a, b)\n    _validate_lengths(a, b)\n    _validate_element_types(a, b)\n    return _compute_result(a, b)"}
{"task_id": "Mbpp/274", "solution": "import math\ndef _binomial_coefficient(n, k):\n    \"\"\"Computes the binomial coefficient C(n, k) using exact integer arithmetic.\"\"\"\n    if not (0 <= k <= n):\n        return 0\n    # Optimize calculation using C(n, k) = C(n, n-k)\n    if k > n // 2:\n        k = n - k\n    return math.factorial(n) // (math.factorial(k) * math.factorial(n - k))\ndef _sum_even_index_coeffs(n):\n    \"\"\"Sums C(n, k) for all even k from 0 to n.\"\"\"\n    total_sum = 0\n    for k in range(0, n + 1, 2):  # Iterate only over even k\n        total_sum += _binomial_coefficient(n, k)\n    return total_sum\ndef even_binomial_Coeff_Sum(n):\n    \"\"\"\n    Finds the sum of even index binomial coefficients for a positive integer n.\n    This function first validates n, then sums C(n, k) for even k from 0 to n.\n    \"\"\"\n    _validate_positive_integer(n)\n    return _sum_even_index_coeffs(n)"}
