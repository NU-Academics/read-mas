{"task_id": "Mbpp/722", "solution": "def filter_data(students, min_height, min_weight):\n    \"\"\"\n    Filters a dictionary of students, returning only those whose height is strictly above min_height\n    and whose weight is greater than or equal to min_weight.\n    \"\"\"\n    filtered_students = {}\n    for name, (height, weight) in students.items():\n        if height > min_height and weight >= min_weight:\n            filtered_students[name] = (height, weight)\n    return filtered_students"}
{"task_id": "Mbpp/721", "solution": "class Matrix:\n    \"\"\"Represents an N x N matrix and provides cell access.\"\"\"\n    def __init__(self, data: list[list[float]]):\n        self.data = data\n        self.N = len(data) if data else 0\n\n    def getCell(self, row: int, col: int) -> float:\n        \"\"\"Returns the cost of the cell at the given row and column.\"\"\"\n        return float(self.data[row][col])\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation errors.\"\"\"\n    pass\nclass ValidationService:\n    \"\"\"Service for validating matrix input.\"\"\"\n    @staticmethod\n    def isValidSquareMatrix(matrix_obj: Matrix) -> bool:\n        \"\"\"\n        Validates if the provided Matrix object represents a non-empty square matrix\n        with numeric entries. Raises ValidationError on failure.\n        \"\"\"\n        data = matrix_obj.data\n        N = matrix_obj.N\n\n        if not data:\n            raise ValidationError(\"Matrix cannot be empty.\")\n        if N <= 0:\n             raise ValidationError(\"Matrix dimension N must be greater than 0.\")\n\n        if len(data) != N:\n            raise ValidationError(f\"Matrix is not square: expected {N} rows, got {len(data)}.\")\n\n        for r_idx, row in enumerate(data):\n            if not isinstance(row, list):\n                raise ValidationError(f\"Matrix row {r_idx} is not a list.\")\n            if len(row) != N:\n                raise ValidationError(f\"Matrix row {r_idx} has length {len(row)}, expected {N}.\")\n            for c_idx, entry in enumerate(row):\n                if not isinstance(entry, (int, float)):\n                    raise ValidationError(f\"Matrix cell [{r_idx}][{c_idx}] has non-numeric value: {entry}.\")\n        return True\nclass PathCalculator:\n    \"\"\"Calculates maximum path sums and averages using dynamic programming.\"\"\"\n    @staticmethod\n    def computeMaxSum(matrix_obj: Matrix) -> float:\n        \"\"\"\n        Computes the maximum path sum from top-left to bottom-right\n        moving only right or down, using dynamic programming.\n        \"\"\"\n        N = matrix_obj.N\n        if N == 0:\n            return 0.0\n\n        dp = [[0.0 for _ in range(N)] for _ in range(N)]\n\n        dp[0][0] = matrix_obj.getCell(0, 0)\n\n        for j in range(1, N):\n            dp[0][j] = dp[0][j-1] + matrix_obj.getCell(0, j)\n\n        for i in range(1, N):\n            dp[i][0] = dp[i-1][0] + matrix_obj.getCell(i, 0)\n\n        for i in range(1, N):\n            for j in range(1, N):\n                dp[i][j] = matrix_obj.getCell(i, j) + max(dp[i-1][j], dp[i][j-1])\n\n        return dp[N-1][N-1]\n\n    @staticmethod\n    def computeMaxAverage(matrix_obj: Matrix) -> float:\n        \"\"\"\n        Computes the maximum average path from top-left to bottom-right.\n        \"\"\"\n        max_sum = PathCalculator.computeMaxSum(matrix_obj)\n        N = matrix_obj.N\n        if N == 0:\n            return 0.0\n        path_length = 2 * N - 1\n        return max_sum / path_length\ndef maxAverageOfPath(matrix: list[list[float]]) -> float:\n    \"\"\"\n    Given a square matrix, finds a path from top-left to bottom-right\n    moving only right or down with the maximum average cost.\n    \"\"\"\n    m = Matrix(data=matrix)\n    ValidationService.isValidSquareMatrix(m)\n    avg = PathCalculator.computeMaxAverage(m)\n    return avg"}
{"task_id": "Mbpp/723", "solution": "def _is_list_like(obj):\n    \"\"\"\n    Checks if an object is list-like by having __len__ and __getitem__.\n    This helper is part of the design, though its validation effect is curtailed by completion requirements.\n    \"\"\"\n    return hasattr(obj, '__len__') and hasattr(obj, '__getitem__')\nclass Validator:\n    \"\"\"\n    Validates input preconditions (list-like types and equal lengths).\n    Due to completion requirements, actual error raising for validation is bypassed.\n    \"\"\"\n    def validate_length(self, listA, listB):\n        \"\"\"\n        Returns True if inputs meet implied criteria, bypassing explicit validation error raising.\n        The problem definition assumes inputs are valid, per completion requirements.\n        \"\"\"\n        # Explicit validation checks and error raising are forbidden by completion requirements.\n        # The design requires calling this, so it must return True to allow flow to continue.\n        # _is_list_like is called to maintain design structure, but its result is ignored for validation failure.\n        _is_list_like(listA)\n        _is_list_like(listB)\n        return True\nclass Counter:\n    \"\"\"\n    Compares elements at corresponding indices using equality semantics and counts matches.\n    \"\"\"\n    def count_matches(self, listA, listB):\n        \"\"\"\n        Returns an integer count of indices where listA[i] == listB[i].\n        Iterates deterministically over the lists.\n        \"\"\"\n        match_count = 0\n        for i in range(len(listA)):\n            if listA[i] == listB[i]:\n                match_count += 1\n        return match_count\nclass CountFunction:\n    \"\"\"\n    Public API wrapper that orchestrates validation and counting logic.\n    It utilizes separate Validator and Counter components.\n    \"\"\"\n    def __init__(self):\n        self.validator = Validator()\n        self.counter = Counter()\n\n    def count_same_pair(self, listA, listB):\n        \"\"\"\n        Orchestrates validation (bypassed) and counting to return the match count.\n        This method serves as the internal entry point for the counting logic.\n        \"\"\"\n        self.validator.validate_length(listA, listB)\n        return self.counter.count_matches(listA, listB)\ndef count_same_pair(listA, listB):\n    \"\"\"\n    The input is defined as two lists of the same length. Counts indices where the lists have the same values.\n    This function is the public API entry point, using CountFunction for internal logic.\n    \"\"\"\n    count_func_instance = CountFunction()\n    return count_func_instance.count_same_pair(listA, listB)"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base, power):\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    \"\"\"\n    \n    # Compute base ** power using Python's arbitrary-precision integers.\n    power_result = base ** power\n\n    # Compute the sum of all decimal digits of the exponentiation result.\n    # Convert the number to a string to iterate over its digits, then convert each digit back to an int.\n    digit_sum = sum(int(digit) for digit in str(power_result))\n\n    return digit_sum"}
{"task_id": "Mbpp/725", "solution": "from typing import List\nclass InputString:\n    \"\"\"Encapsulates the raw input string and its length.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n        self.length = len(text)\nclass QuotedSubstring:\n    \"\"\"Represents a single extracted quoted substring and its indices.\"\"\"\n    def __init__(self, value: str, start_index: int, end_index: int):\n        self.value = value\n        self.start_index = start_index\n        self.end_index = end_index\nclass ExtractionResult:\n    \"\"\"Aggregates extracted substrings and provides an empty check.\"\"\"\n    def __init__(self, substrings: List[str]):\n        self.substrings = substrings\n\n    def is_empty(self) -> bool:\n        return not self.substrings\ndef _collect_quoted_substrings(text: str) -> List[QuotedSubstring]:\n    \"\"\"Scans the text for complete pairs of double quotes and collects QuotedSubstring objects.\"\"\"\n    found_substrings: List[QuotedSubstring] = []\n    start_scan_index = 0\n    text_length = len(text)\n\n    while start_scan_index < text_length:\n        open_quote_idx = text.find('\"', start_scan_index)\n        if open_quote_idx == -1:\n            break\n\n        close_quote_idx = text.find('\"', open_quote_idx + 1)\n        if close_quote_idx == -1:\n            break\n\n        value = text[open_quote_idx + 1 : close_quote_idx]\n        found_substrings.append(QuotedSubstring(value, open_quote_idx, close_quote_idx))\n\n        start_scan_index = close_quote_idx + 1\n\n    return found_substrings\ndef extract_quotation(input: str) -> List[str]:\n    \"\"\"Extracts values between quotation marks \" \" of the given string.\"\"\"\n    input_obj = InputString(input)\n    \n    quoted_parts = _collect_quoted_substrings(input_obj.text)\n    \n    extracted_values = [part.value for part in quoted_parts]\n    \n    result_obj = ExtractionResult(extracted_values)\n    return result_obj.substrings"}
{"task_id": "Mbpp/726", "solution": "from typing import Tuple\nimport numbers\ndef multiply_elements(input: Tuple[numbers.Number, ...]) -> Tuple[numbers.Number, ...]:\n    \"\"\"\n    Calculates the product of adjacent elements in a tuple of numbers.\n    The output tuple will have one less element than the input tuple.\n    \"\"\"\n    result = []\n    for i in range(len(input) - 1):\n        result.append(input[i] * input[i+1])\n    return tuple(result)"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list: list) -> list:\n    \"\"\"Returns a new list where runs of adjacent equal elements (using ==) are collapsed to a single element.\n    Args: input_list (list): input Python list.\n    Returns: list: collapsed list (empty list for empty input).\n    \"\"\"\n    result = []\n    for item in input_list:\n        if not result or item != result[-1]:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/728", "solution": "import numbers\nfrom typing import List\ndef sum_list(listA: List[numbers.Number], listB: List[numbers.Number]) -> List[numbers.Number]:\n    \"\"\"\n    Computes the element-wise sum of two lists of numbers.\n    Assumes input lists are of equal length and contain numeric values.\n    \"\"\"\n    return [a + b for a, b in zip(listA, listB)]"}
{"task_id": "Mbpp/731", "solution": "from math import sqrt, pi\nclass LateralSurfaceCalculator:\n    def lateralsurface_cone(self, r: float, h: float) -> float:\n        \"\"\"Calculates the lateral surface area of a cone.\"\"\"\n        slant_height = sqrt(r * r + h * h)\n        lateral_area = pi * r * slant_height\n        return lateral_area\ndef lateralsurface_cone(r, h):\n    \"\"\"Compute lateral surface of a right circular cone.\n    Args: r: numeric radius, h: numeric height\n    Returns: float: lateral surface area (square units)\n    \"\"\"\n    return LateralSurfaceCalculator().lateralsurface_cone(r, h)"}
{"task_id": "Mbpp/732", "solution": "class ReplacementRule:\n    \"\"\"Value object encapsulating replacement mapping.\"\"\"\n    def __init__(self, match_chars: set[str], replacement: str) -> None:\n        self.match_chars = match_chars\n        self.replacement = replacement\nclass ReplaceSpecialCharFunction:\n    \"\"\"Encapsulates transformation logic.\"\"\"\n    def __init__(self, rule: ReplacementRule) -> None:\n        self.rule = rule\n\n    def execute(self, input_str_value: str) -> str:\n        \"\"\"Iterates characters, replacing matches with the rule's replacement.\"\"\"\n        output_chars = []\n        for char in input_str_value:\n            if char in self.rule.match_chars:\n                output_chars.append(self.rule.replacement)\n            else:\n                output_chars.append(char)\n        return \"\".join(output_chars)\ndef replace_specialchar(input_string: str) -> str:\n    \"\"\"\n    Replaces all occurrences of spaces, commas, or dots with a colon.\n    Each occurrence is replaced individually.\n    \"\"\"\n    default_rule = ReplacementRule(match_chars={' ', ',', '.'}, replacement=':')\n    replacement_engine = ReplaceSpecialCharFunction(rule=default_rule)\n    transformed_string = replacement_engine.execute(input_string)\n    return transformed_string"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(input_list):\n    \"\"\"\n    Public API: validate and compute sum of products of all contiguous subarrays.\n    This function has an O(n^2) time complexity for generating and processing subarrays.\n    \"\"\"\n\n    def validate_input(lst):\n        \"\"\"Raise TypeError if input_list is not a list or contains non-numeric elements.\"\"\"\n        if not isinstance(lst, list):\n            raise TypeError(\"Input must be a list.\")\n        for item in lst:\n            if not isinstance(item, (int, float)):\n                raise TypeError(\"All elements in the list must be numeric (int or float).\")\n\n    def generate_subarrays(lst):\n        \"\"\"Yield contiguous subarrays: for i in range(n): for j in range(i,n): yield input_list[i:j+1]\"\"\"\n        n = len(lst)\n        for i in range(n):\n            for j in range(i, n):\n                yield lst[i : j + 1]\n\n    def product(subarray):\n        \"\"\"Return the multiplication product of elements in subarray.\"\"\"\n        if not subarray:\n            return 1  # Product of an empty list is 1 for consistency in multiplication\n        res = 1\n        for x in subarray:\n            res *= x\n        return res\n\n    def sum_products(subarrays_generator):\n        \"\"\"Accumulate product(subarray) for each subarray and return the sum.\"\"\"\n        total_sum = 0\n        for sub in subarrays_generator:\n            total_sum += product(sub)\n        return total_sum\n\n    validate_input(input_list)\n\n    if not input_list:\n        return 0\n\n    return sum_products(generate_subarrays(input_list))"}
{"task_id": "Mbpp/733", "solution": "from typing import List\ndef find_first_occurrence(arr: List[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array.\n    Uses an iterative binary search to achieve O(log n) time complexity.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == target:\n            result = mid\n            high = mid - 1  # Search in the left half for an earlier occurrence\n        elif arr[mid] < target:\n            low = mid + 1\n        else:  # arr[mid] > target\n            high = mid - 1\n            \n    return result"}
{"task_id": "Mbpp/736", "solution": "class InsertionError(Exception):\n    \"\"\"Custom exception for errors during insertion operations.\"\"\"\n    def __init__(self, code: str, message: str):\n        self.code = code\n        self.message = message\n        super().__init__(f\"[{code}] {message}\")\ndef left_insertion(sorted_sequence, value) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in sorted order using binary search.\n    Raises InsertionError if value is not comparable with sequence elements.\n    \"\"\"\n    low = 0\n    high = len(sorted_sequence)\n\n    while low < high:\n        mid = (low + high) // 2\n        try:\n            if sorted_sequence[mid] < value:\n                low = mid + 1\n            else:\n                high = mid\n        except TypeError as e:\n            raise InsertionError(\n                code=\"NOT_COMPARABLE\",\n                message=f\"Value '{value}' is not comparable with sequence element '{sorted_sequence[mid]}': {e}\"\n            ) from e\n    return low"}
{"task_id": "Mbpp/735", "solution": "class IntegerInput:\n    \"\"\"Encapsulates integer input and provides bit-length utility.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def get_bit_length(self) -> int:\n        \"\"\"Returns the number of bits required to represent the integer.\"\"\"\n        return self.value.bit_length()\nclass BitLocator:\n    \"\"\"Computes MSB and LSB indices for a validated integer.\"\"\"\n    @staticmethod\n    def find_msb_index(n: int) -> int:\n        \"\"\"Finds the index of the most significant set bit.\"\"\"\n        if n == 0:\n            return -1\n        return n.bit_length() - 1\n\n    @staticmethod\n    def find_lsb_index(n: int) -> int:\n        \"\"\"Finds the index of the least significant set bit.\"\"\"\n        if n == 0:\n            return -1\n        index = 0\n        while (n & 1) == 0:\n            n >>= 1\n            index += 1\n        return index\nclass BitMask:\n    \"\"\"Computes a mask with 1s exactly for bits strictly between msb and lsb indices.\"\"\"\n    @staticmethod\n    def compute_middle_mask(msb: int, lsb: int) -> int:\n        \"\"\"Generates a mask with ones between the MSB and LSB (exclusive).\"\"\"\n        if msb <= lsb or (msb - lsb <= 1):\n            return 0\n        \n        # Create a mask of all 1s up to (msb-1)\n        mask_up_to_msb_minus_1 = (1 << msb) - 1\n        # Create a mask of all 1s up to (lsb)\n        mask_up_to_lsb = (1 << (lsb + 1)) - 1\n        \n        # XORing these two masks results in 1s for bits strictly between lsb and msb.\n        return mask_up_to_msb_minus_1 ^ mask_up_to_lsb\ndef toggle_middle_bits(n: int) -> int:\n    \"\"\"Toggles bits of the number except the first and the last bit.\"\"\"\n    input_obj = IntegerInput(n)\n    bit_length = input_obj.get_bit_length()\n\n    if bit_length < 3:\n        return n\n\n    msb_index = BitLocator.find_msb_index(n)\n    lsb_index = BitLocator.find_lsb_index(n)\n    \n    mask = BitMask.compute_middle_mask(msb_index, lsb_index)\n\n    return n ^ mask"}
{"task_id": "Mbpp/737", "solution": "import re\nclass StringInput:\n    \"\"\"A container for the input string.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\nclass RegexPattern:\n    \"\"\"Holds the regex pattern for vowel-at-start.\"\"\"\n    def __init__(self, pattern: str) -> None:\n        self.pattern = pattern\nclass CheckResult:\n    \"\"\"A value object representing the boolean result.\"\"\"\n    def __init__(self, isVowel: bool) -> None:\n        self.isVowel = isVowel\nclass VowelChecker:\n    \"\"\"Applies regex to the first character to determine if it's a vowel.\"\"\"\n    def __init__(self, pattern: RegexPattern) -> None:\n        self.pattern = pattern\n\n    def check_str(self, input: StringInput) -> CheckResult:\n        \"\"\"Checks if the string starts with a vowel using the stored regex pattern.\"\"\"\n        match = re.match(self.pattern.pattern, input.value)\n        return CheckResult(isVowel=bool(match))\ndef check_str(s: str) -> bool:\n    \"\"\"\n    Checks if the given string is starting with a vowel using regex.\n    \"\"\"\n    string_input = StringInput(s)\n    vowel_regex = RegexPattern(r\"^[aeiouAEIOU]\")\n    checker = VowelChecker(vowel_regex)\n    result = checker.check_str(string_input)\n    return result.isVowel"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input: tuple) -> dict:\n    \"\"\"Convert adjacent elements of input tuple into a dict.\n\n    Raises ValueError if len(input) is odd.\n    \"\"\"\n    n = len(input)\n    if n % 2 != 0:\n        raise ValueError(\"input tuple length must be even\")\n\n    mapping = {}\n    for i in range(0, n, 2):\n        mapping[input[i]] = input[i+1]\n    return mapping"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(input_string):\n    \"\"\"Return True iff all characters in input_string are identical.\n\n    Raises:\n        TypeError: if input_string is not an instance of str.\n    Returns:\n        bool: True if all characters are the same (including empty string), otherwise False.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    if len(input_string) <= 1:\n        return True\n\n    first_char = input_string[0]\n    for char in input_string[1:]:\n        if char != first_char:\n            return False\n    return True"}
{"task_id": "Mbpp/743", "solution": "def rotate_right(lst, k):\n    \"\"\"Return a list with elements of lst rotated to the right by k positions.\n    Raises ValueError if k is negative.\n    \"\"\"\n    if k < 0:\n        raise ValueError(\"Rotation amount k must be non-negative.\")\n\n    n = len(lst)\n\n    if n == 0:\n        return []\n\n    # Normalize k to be within [0, n-1]\n    k = k % n\n\n    if k == 0:\n        return lst[:]  # Return a shallow copy if no rotation is needed\n\n    # Split the list into two parts and concatenate them\n    # The last k elements move to the beginning\n    # The first (n - k) elements follow\n    return lst[n - k:] + lst[:n - k]"}
{"task_id": "Mbpp/739", "solution": "import math\ndef compute_T(k: int) -> int:\n    \"\"\"Computes the k-th triangular number.\"\"\"\n    return k * (k + 1) // 2\ndef digits_count(value: int) -> int:\n    \"\"\"Returns the number of decimal digits for a positive integer value.\"\"\"\n    if value <= 0:\n        raise ValueError(\"Value must be positive to count digits.\")\n    return int(math.log10(value)) + 1\ndef find_Index(n: int) -> int:\n    \"\"\"Finds the index of the smallest triangular number with n digits.\"\"\"\n    \n    # The smallest n-digit number is 10^(n-1).\n    # The largest (n-1)-digit number is 10^(n-1) - 1.\n    # We are looking for the smallest k such that T_k >= 10^(n-1).\n    # T_k approx k^2/2. So k^2/2 approx 10^(n-1).\n    # k approx sqrt(2 * 10^(n-1)). This gives a good starting point.\n    \n    # Calculate the lower bound for a number with n digits\n    lower_bound_value = 10**(n - 1)\n\n    # Estimate starting k\n    # k*(k+1)/2 >= 10^(n-1)\n    # k^2 approx 2 * 10^(n-1)\n    # k approx sqrt(2 * 10^(n-1))\n    \n    # Using float for initial estimation, then convert to int\n    k_estimate = int(math.sqrt(2 * lower_bound_value))\n    \n    # Start checking from k_estimate - a few values, to ensure we don't miss.\n    # A safe lower bound for k_start would be k_estimate - 5, ensuring k is at least 1.\n    k = max(1, k_estimate - 5) \n\n    while True:\n        triangular_num = compute_T(k)\n        \n        # Check if the current triangular number has at least n digits.\n        # This is an optimization: if triangular_num is too small, its digit count\n        # will definitely be less than n.\n        if triangular_num >= lower_bound_value:\n            num_digits = digits_count(triangular_num)\n            if num_digits == n:\n                return k\n        \n        k += 1"}
{"task_id": "Mbpp/742", "solution": "from math import sqrt\nclass Tetrahedron:\n    def __init__(self, side_length: float):\n        self.side_length: float = side_length\n        self.area: float = 0.0\n\n    def compute_area(self) -> float:\n        \"\"\"Computes the surface area of the tetrahedron.\"\"\"\n        self.area = sqrt(3.0) * (self.side_length ** 2)\n        return self.area\nclass CalculationService:\n    def area_tetrahedron(self, side: float) -> float:\n        \"\"\"Delegates to the Tetrahedron domain object to compute area.\"\"\"\n        t = Tetrahedron(side)\n        return t.compute_area()\ndef area_tetrahedron(side: float) -> float:\n    \"\"\"Calculates the surface area of a regular tetrahedron given its side length.\"\"\"\n    return CalculationService().area_tetrahedron(side)"}
