{"task_id": "Mbpp/87", "solution": "def merge_dictionaries_three(dict_a: dict, dict_b: dict, dict_c: dict) -> dict:\n    \"\"\"Merges three dictionaries into a single dictionary, preserving first-seen values for duplicate keys.\"\"\"\n\n    def _validate_inputs(args: tuple) -> None:\n        \"\"\"Validates that all arguments in the tuple are dictionary instances.\"\"\"\n        for arg in args:\n            if not isinstance(arg, dict):\n                raise TypeError(\"All inputs must be dictionary instances.\")\n\n    def _collect_key_value_pairs(dicts: tuple) -> list:\n        \"\"\"Collects all key-value pairs from the input dictionaries in order.\"\"\"\n        all_pairs = []\n        for d in dicts:\n            all_pairs.extend(d.items())\n        return all_pairs\n\n    def _compose_result(pairs: list) -> dict:\n        \"\"\"Composes a dictionary from a list of key-value pairs, applying first-seen value resolution for duplicates.\"\"\"\n        result = {}\n        for key, value in pairs:\n            if key not in result:\n                result[key] = value\n        return result\n\n    _validate_inputs((dict_a, dict_b, dict_c))\n    collected_pairs = _collect_key_value_pairs((dict_a, dict_b, dict_c))\n    final_result = _compose_result(collected_pairs)\n    return final_result"}
{"task_id": "Mbpp/93", "solution": "from typing import Optional\nclass NumericValue:\n    \"\"\"Coerces and validates numeric inputs to float.\n    Raises TypeError if conversion to float fails.\n    \"\"\"\n    def __init__(self, value) -> None:\n        try:\n            self._value = float(value)\n        except (ValueError, TypeError) as e:\n            raise TypeError(f\"Value '{value}' cannot be converted to a float.\") from e\n\n    def isNumeric(self) -> bool:\n        \"\"\"Indicates whether the underlying value is numeric (float).\"\"\"\n        return True\n\n    def as_float(self) -> float:\n        \"\"\"Returns the underlying float value.\"\"\"\n        return self._value\nclass PowerFunction:\n    \"\"\"Encapsulates the exponentiation operation.\"\"\"\n    def __init__(self, a: float, b: float) -> None:\n        self._a = a\n        self._b = b\n        self._result: Optional[float] = None\n\n    def compute(self) -> float:\n        \"\"\"Computes _a ** _b, stores the result, and returns it.\"\"\"\n        self._result = self._a ** self._b\n        return self._result\ndef power(a, b) -> float:\n    \"\"\"Calculates the value of 'a' to the power 'b'.\"\"\"\n    a_numeric = NumericValue(a)\n    b_numeric = NumericValue(b)\n\n    a_float = a_numeric.as_float()\n    b_float = b_numeric.as_float()\n\n    power_calculator = PowerFunction(a_float, b_float)\n    result = power_calculator.compute()\n\n    return result"}
{"task_id": "Mbpp/91", "solution": "def find_substring(values: list[str], search: str) -> bool:\n    \"\"\"Public API implementing FR-1. Returns True if search is substring of any entry in values.\"\"\"\n    for item in values:\n        if search in item:\n            return True\n    return False"}
{"task_id": "Mbpp/94", "solution": "from typing import Any, List, Tuple\ndef index_minimum(tuples: List[Tuple[Any, float]]) -> Any:\n    \"\"\"\n    Given a list of tuples, returns the first value of the tuple with the smallest second value.\n    Assumes the input list is not empty and tuples are well-formed as per the type hint.\n    \"\"\"\n    if not tuples:\n        # As per design, behavior for empty lists is unspecified and not imposed.\n        # This implementation will return None for an empty list or raise an error\n        # if the first tuple is accessed without a check. Let's assume non-empty for now.\n        # Following the design context's lack of error handling, we can proceed assuming valid input.\n        pass # The problem statement implies valid input based on the example.\n\n    # Initialize with the first tuple's values\n    min_second_value = tuples[0][1]\n    result_first_value = tuples[0][0]\n\n    # Iterate through the rest of the tuples\n    for first_value, second_value in tuples[1:]:\n        if second_value < min_second_value:\n            min_second_value = second_value\n            result_first_value = first_value\n\n    return result_first_value"}
{"task_id": "Mbpp/92", "solution": "from typing import Union\nclass InputValidator:\n    \"\"\"\n    Validates raw input types and string formats.\n    \"\"\"\n    @staticmethod\n    def validate_type(raw_value) -> None:\n        \"\"\"\n        Validates if raw_value is an int or a digit-only string.\n        Raises TypeError if invalid.\n        \"\"\"\n        if isinstance(raw_value, int):\n            return\n        elif isinstance(raw_value, str):\n            InputValidator.validate_digit_string(raw_value)\n        else:\n            raise TypeError(\"Input must be an integer or a digit-only string.\")\n\n    @staticmethod\n    def validate_digit_string(s: str) -> None:\n        \"\"\"\n        Validates if a string contains only digit characters.\n        Raises TypeError if not.\n        \"\"\"\n        if not s.isdigit():\n            raise TypeError(\"String input must contain only digit characters (0-9).\")\nclass NumberInput:\n    \"\"\"\n    Represents raw input and handles normalization to a digit string.\n    \"\"\"\n    def __init__(self, raw_value: Union[int, str]) -> None:\n        self.raw_value = raw_value\n        self.normalized_digits: str = \"\"\n\n    def normalize(self) -> str:\n        \"\"\"\n        Normalizes the raw input to an absolute-value decimal digit string,\n        stripping leading zeros.\n        \"\"\"\n        if isinstance(self.raw_value, int):\n            self.normalized_digits = str(abs(self.raw_value))\n        else: # isinstance(self.raw_value, str)\n            temp_digits = self.raw_value.lstrip('0')\n            self.normalized_digits = \"0\" if not temp_digits else temp_digits\n        return self.normalized_digits\nclass DigitSequence:\n    \"\"\"\n    Holds a normalized digit string and its length.\n    \"\"\"\n    def __init__(self, digits: str) -> None:\n        self.digits: str = digits\n        self.length: int = len(digits)\nclass UndulatingChecker:\n    \"\"\"\n    Evaluates a DigitSequence to determine if it is undulating.\n    \"\"\"\n    def is_undulating(self, number_input: NumberInput) -> bool:\n        \"\"\"\n        Checks if the normalized number represented by NumberInput is undulating.\n        \"\"\"\n        digit_sequence = DigitSequence(number_input.normalized_digits)\n        return self.check_alternation(digit_sequence)\n\n    def check_alternation(self, digit_sequence: DigitSequence) -> bool:\n        \"\"\"\n        Performs a single-pass scan to check for the undulating pattern.\n        \"\"\"\n        digits = digit_sequence.digits\n        length = digit_sequence.length\n\n        if length < 2:\n            return False\n\n        first_digit = digits[0]\n        second_digit = None\n\n        for i in range(1, length):\n            current_char = digits[i]\n            prev_char = digits[i-1]\n\n            if current_char == prev_char:\n                return False\n\n            if i == 1:\n                second_digit = current_char\n            else:\n                expected_char = first_digit if i % 2 == 0 else second_digit\n                if current_char != expected_char:\n                    return False\n\n        return True\ndef is_undulating(number: Union[int, str]) -> bool:\n    \"\"\"\n    Checks if a number is undulating, meaning its digits alternate between\n    exactly two distinct digits (e.g., 1212121).\n    Raises TypeError for invalid input types or non-digit strings.\n    \"\"\"\n    InputValidator.validate_type(number)\n    num_input = NumberInput(number)\n    num_input.normalize()\n    \n    checker = UndulatingChecker()\n    return checker.is_undulating(num_input)"}
{"task_id": "Mbpp/95", "solution": "def _validate_list_of_lists(list_of_lists):\n    \"\"\"\n    Validates the input list_of_lists to ensure it's not empty and all its elements are lists.\n    Raises ValueError or TypeError on invalid input.\n    \"\"\"\n    if not list_of_lists:\n        raise ValueError('input must contain at least one inner list')\n\n    for item in list_of_lists:\n        if not isinstance(item, list):\n            raise TypeError('all elements of outer list must be lists')\n    return None\ndef Find_Min_Length(list_of_lists):\n    \"\"\"\n    Finds the length of the smallest list within a given list of lists.\n    Validates input and raises exceptions for invalid structures.\n    \"\"\"\n    _validate_list_of_lists(list_of_lists)\n\n    # After validation, list_of_lists is guaranteed to have at least one element\n    # and all its elements are lists.\n    min_length = len(list_of_lists[0])\n\n    # Iterate from the second element onwards, as the first element's length\n    # is already our initial minimum.\n    for inner_list in list_of_lists[1:]:\n        current_length = len(inner_list)\n        if current_length < min_length:\n            min_length = current_length\n\n    return min_length"}
{"task_id": "Mbpp/96", "solution": "def count_divisors(n):\n    \"\"\"\n    Counts the number of positive divisors for a given non-negative integer n.\n    Operates on the absolute value of n.\n    \"\"\"\n    n = abs(n)\n    if n == 0:\n        # As per design, behavior for n=0 is an unresolved requirement gap.\n        # This implementation returns 0 as a default, though other policies might be adopted.\n        return 0 \n    \n    count = 0\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count\ndef divisor(n):\n    \"\"\"\n    Finds the number of positive divisors for a given integer n.\n    Validates input type and computes divisors for the absolute value of n.\n    \"\"\"\n    validate_input(n)\n    return count_divisors(n)"}
{"task_id": "Mbpp/97", "solution": "from collections import defaultdict\nfrom typing import Any, Iterator, Dict, Iterable\nclass Element:\n    \"\"\"Domain helper encapsulating value and hashability check.\"\"\"\n    def __init__(self, value: Any):\n        self.value = value\n\n    def is_hashable(self) -> bool:\n        \"\"\"Returns True if the element value is hashable.\"\"\"\n        try:\n            hash(self.value)\n            return True\n        except TypeError:\n            return False\nclass ListOfLists:\n    \"\"\"Domain helper encapsulating outer list and is_valid check.\"\"\"\n    def __init__(self, sublists: Any):\n        self.sublists = sublists\n\n    def is_valid(self) -> bool:\n        \"\"\"Returns True if the outer container is a list and each item is a list.\"\"\"\n        return isinstance(self.sublists, list) and all(isinstance(item, list) for item in self.sublists)\nclass Validator:\n    \"\"\"Validates that outer structure is a list of lists and that elements are hashable.\"\"\"\n    @staticmethod\n    def validate_input(list_of_lists: Any) -> None:\n        \"\"\"Raises TypeError on invalid input; otherwise returns None.\"\"\"\n        lol_checker = ListOfLists(list_of_lists)\n        if not lol_checker.is_valid():\n            raise TypeError(\"Input must be a list of lists.\")\n\n        for sublist in list_of_lists:\n            for element_value in sublist:\n                element_checker = Element(element_value)\n                if not element_checker.is_hashable():\n                    raise TypeError(f\"Elements in sublists must be hashable. Found unhashable element: {element_value}\")\nclass Flattener:\n    \"\"\"Stateless component that iterates each sublist and yields each element.\"\"\"\n    @staticmethod\n    def flatten(sublists: Iterable[list]) -> Iterator[Any]:\n        \"\"\"Yields elements from each sublist preserving multiplicity.\"\"\"\n        for sublist in sublists:\n            for element in sublist:\n                yield element\nclass FrequencyCounter:\n    \"\"\"Accumulates counts for elements streamed by Flattener.\"\"\"\n    def __init__(self):\n        self.counts: Dict[Any, int] = defaultdict(int)\n\n    def increment(self, element: Any) -> None:\n        \"\"\"Increments the count for an element.\"\"\"\n        self.counts[element] += 1\n\n    def get_results(self) -> Dict[Any, int]:\n        \"\"\"Returns the internal counts mapping as a plain dictionary.\"\"\"\n        return dict(self.counts)\ndef frequency_lists(list_of_lists: Any) -> Dict[Any, int]:\n    \"\"\"\n    Finds the frequency of each element in a flattened list of lists, returned in a dictionary.\n    Validates input and raises TypeError for invalid structures or unhashable elements.\n    \"\"\"\n    Validator.validate_input(list_of_lists)\n\n    if not list_of_lists:\n        return {}\n\n    counter = FrequencyCounter()\n    for element in Flattener.flatten(list_of_lists):\n        counter.increment(element)\n\n    return counter.get_results()"}
