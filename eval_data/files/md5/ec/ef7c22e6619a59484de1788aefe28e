{"task_id": "Mbpp/172", "solution": "PATTERN = \"std\"\ndef count_occurance(input_string):\n    \"\"\"\n    Counts non-overlapping, case-sensitive occurrences of 'std' in the given string.\n    Validates input type and returns the total count.\n    \"\"\"\n    _validate_input(input_string)\n\n    count = 0\n    index = 0\n    pattern_length = len(PATTERN)\n\n    while True:\n        found_index = input_string.find(PATTERN, index)\n        if found_index != -1:\n            count += 1\n            index = found_index + pattern_length\n        else:\n            break\n    \n    return count"}
{"task_id": "Mbpp/170", "solution": "from typing import Sequence, Union\ndef sum_range_list(lst: Sequence[Union[int, float]], start_index: int, end_index: int) -> Union[int, float]:\n    \"\"\"\n    Calculates the sum of numbers in a list within a specified inclusive range of indices.\n    The function directly computes the sum for the given slice.\n    \"\"\"\n    # Python slicing lst[start:end_exclusive] includes elements from start up to (but not including) end_exclusive.\n    # To include end_index, the slice should go up to end_index + 1.\n    return sum(lst[start_index : end_index + 1])"}
{"task_id": "Mbpp/222", "solution": "def check_type(input_tuple) -> bool:\n    \"\"\"\n    Accepts a tuple and returns True if all elements have the same Python type, otherwise False.\n    Does not modify the input tuple.\n    \"\"\"\n    if not input_tuple:\n        return True\n\n    first_type = type(input_tuple[0])\n    for element in input_tuple:\n        if type(element) is not first_type:\n            return False\n    return True"}
{"task_id": "Mbpp/223", "solution": "def is_majority(sorted_array: list, n: int, element: int) -> bool:\n    \"\"\"\n    Checks if the given element is a majority element in the first `n` elements of a sorted array.\n    A majority element occurs more than n/2 times.\n    \"\"\"\n    count = 0\n    # Iterate through the first 'n' elements of the array\n    # Ensure we don't go out of bounds of the actual array length\n    for i in range(min(n, len(sorted_array))):\n        if sorted_array[i] == element:\n            count += 1\n    \n    return count > (n / 2)"}
