{"task_id": "Mbpp/165", "solution": "class AlphabetMapping:\n    \"\"\"Maps alphabetic characters to 1-based positions (a/A=1..z/Z=26).\"\"\"\n    def letterToPosition(self, char_c: str) -> int:\n        if 'a' <= char_c.lower() <= 'z':\n            return ord(char_c.lower()) - ord('a') + 1\n        return 0\nclass PositionEvaluator:\n    \"\"\"Evaluates letter-ness and whether a char matches an alphabet position.\"\"\"\n    def __init__(self, alphabet_mapping: AlphabetMapping):\n        self._alphabet_mapping = alphabet_mapping\n\n    def isLetter(self, char_c: str) -> bool:\n        return 'a' <= char_c.lower() <= 'z'\n\n    def matchesAlphabetPosition(self, char_c: str, pos: int) -> bool:\n        if not self.isLetter(char_c):\n            return False\n        if pos > 26:\n            return False\n        return self._alphabet_mapping.letterToPosition(char_c) == pos\nclass InputString:\n    \"\"\"Encapsulates the input string and provides 1-based indexing.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\n\n    def charAt(self, pos: int) -> str:\n        # pos is 1-based, string indexing is 0-based\n        return self.value[pos - 1]\nclass MatchCounter:\n    \"\"\"Iterates over InputString and counts matching characters.\"\"\"\n    def __init__(self, position_evaluator: PositionEvaluator):\n        self._position_evaluator = position_evaluator\n\n    def countMatches(self, input_string: InputString) -> int:\n        match_count = 0\n        for i in range(1, input_string.length() + 1): # 1-based iteration\n            char_c = input_string.charAt(i)\n            if self._position_evaluator.matchesAlphabetPosition(char_c, i):\n                match_count += 1\n        return match_count\nclass CountCharPositionService:\n    \"\"\"Orchestrates the counting of characters at alphabet positions.\"\"\"\n    def __init__(self):\n        self._alphabet_mapping = AlphabetMapping()\n        self._position_evaluator = PositionEvaluator(self._alphabet_mapping)\n        self._match_counter = MatchCounter(self._position_evaluator)\n\n    def countCharPosition(self, input_str: str) -> int:\n        input_string_obj = InputString(input_str)\n        return self._match_counter.countMatches(input_string_obj)\ndef count_char_position(input: str) -> int:\n    \"\"\"\n    Counts characters in a string that occur at the same position as in the English alphabet.\n    The comparison is case-insensitive, and positions greater than 26 are excluded.\n    \"\"\"\n    service = CountCharPositionService()\n    return service.countCharPosition(input)"}
{"task_id": "Mbpp/166", "solution": "from typing import List\ndef combinations_2(n: int) -> int:\n    \"\"\"Calculates combinations of n items taken 2 at a time.\"\"\"\n    if n < 2:\n        return 0\n    return n * (n - 1) // 2\nclass FindEvenPair:\n    \"\"\"\n    Encapsulates the core logic for counting pairs that XOR to an even number\n    by tallying parities and applying the combinations_2 formula.\n    \"\"\"\n    def __init__(self, input_list: List[int]) -> None:\n        self.input_list = input_list\n\n    def execute(self) -> int:\n        \"\"\"Executes the pair counting algorithm based on parity grouping.\"\"\"\n        even_count = 0\n        odd_count = 0\n        for num in self.input_list:\n            if num % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n\n        result = combinations_2(even_count) + combinations_2(odd_count)\n        return result\ndef find_even_pair(input_list: List[int]) -> int:\n    \"\"\"\n    Counts pairs of integers in a list that XOR to an even number.\n    Pairs XOR to an even number if both integers have the same parity.\n    \"\"\"\n    if len(input_list) < 2:\n        return 0\n\n    pair_finder = FindEvenPair(input_list)\n    return pair_finder.execute()"}
{"task_id": "Mbpp/167", "solution": "from dataclasses import dataclass\ndef validate_integer(n) -> bool:\n    \"\"\"Checks if the input is an integer.\"\"\"\n    return isinstance(n, int)\ndef next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Handles input validation and special cases for n=0 and negative n.\n    \"\"\"\n    if not validate_integer(n):\n        raise TypeError(\"n must be an int\")\n\n    if n <= 0:\n        return 1\n\n    # Check if n is already a power of 2\n    if (n & (n - 1)) == 0:\n        return n\n    else:\n        # Find the smallest power of 2 greater than n\n        power = 1\n        while power < n:\n            power <<= 1\n        return power"}
