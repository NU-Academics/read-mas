{"task_id": "Mbpp/232", "solution": "from typing import Sequence, List\nfrom numbers import Number\ndef _distinct_sorted_desc(input_list: Sequence[Number]) -> List[Number]:\n    \"\"\"Extracts distinct numeric values from input_list and returns them sorted in descending order.\"\"\"\n    distinct_elements = set(input_list)\n    sorted_distinct = sorted(list(distinct_elements), reverse=True)\n    return sorted_distinct\ndef _select_top_n(sorted_values: List[Number], n: int) -> List[Number]:\n    \"\"\"Selects the top n items from a list of sorted values.\"\"\"\n    if n <= 0:\n        return []\n    return sorted_values[:n]\ndef larg_nnum(input_list: Sequence, n: int) -> List[Number]:\n    \"\"\"\n    Returns a list containing the n largest distinct numeric items from the input list.\n    Handles input validation and various edge cases for n and the input list.\n    \"\"\"\n    _validate_inputs(input_list, n)\n\n    if n <= 0:\n        return []\n\n    distinct_sorted = _distinct_sorted_desc(input_list)\n\n    return _select_top_n(distinct_sorted, n)"}
{"task_id": "Mbpp/230", "solution": "class Validator:\n    \"\"\"Validates input parameters for the replacement operation.\"\"\"\n    def validateTypes(self, input_str, replacement):\n        \"\"\"Ensures input_str is a string and replacement is a single-character string.\"\"\"\n        if not isinstance(input_str, str):\n            raise ValueError(\"Input must be a string.\")\n        if not isinstance(replacement, str) or len(replacement) != 1:\n            raise ValueError(\"Replacement character must be a single-character string.\")\n        return True\nclass ReplaceBlankFunction:\n    \"\"\"Encapsulates the logic for replacing blank spaces in a string.\"\"\"\n    def __init__(self, input_string, replacement_char):\n        self._input_string = input_string\n        self._replacement_char = replacement_char\n        validator = Validator()\n        validator.validateTypes(input_string, replacement_char)\n\n    def execute(self):\n        \"\"\"Performs the replacement of spaces with the specified character.\"\"\"\n        result_chars = []\n        for char in self._input_string:\n            if char == ' ':\n                result_chars.append(self._replacement_char)\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)\ndef replace_blank(input_string, replacement_char):\n    \"\"\"\n    Replaces blank spaces in the input string with the specified character.\n    It returns a new string with the replacements.\n    \"\"\"\n    replacer = ReplaceBlankFunction(input_string, replacement_char)\n    return replacer.execute()"}
{"task_id": "Mbpp/233", "solution": "import math\ndef compute(radius: [int, float], height: [int, float]) -> float:\n    \"\"\"\n    Computes the lateral surface area of a cylinder using the formula 2 * pi * radius * height.\n    Assumes numeric inputs.\n    \"\"\"\n    return 2 * math.pi * radius * height\ndef lateralsuface_cylinder(radius: [int, float], height: [int, float]) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cylinder, validating input types.\n    Raises TypeError if radius or height are not numeric.\n    \"\"\"\n    if not isinstance(radius, (int, float)):\n        raise TypeError(\"Radius must be a numeric value (int or float).\")\n    if not isinstance(height, (int, float)):\n        raise TypeError(\"Height must be a numeric value (int or float).\")\n    \n    return compute(float(radius), float(height))"}
{"task_id": "Mbpp/235", "solution": "def _generate_even_mask(bit_length: int) -> int:\n    \"\"\"Generate mask with 1s at even positions (2,4,6,... up to bit_length).\"\"\"\n    mask = 0\n    for i in range(2, bit_length + 1, 2):\n        mask |= (1 << (i - 1))\n    return mask\ndef even_bit_set_number(n: int) -> int:\n    \"\"\"Return integer with all even-positioned bits set to 1; LSB is position 1.\"\"\"\n    if n == 0:\n        return 0\n    \n    bit_length = n.bit_length()\n    mask = _generate_even_mask(bit_length)\n    return n | mask"}
{"task_id": "Mbpp/237", "solution": "class NormalizedPair:\n    \"\"\"Represents a canonical (x,y) pair where x <= y.\"\"\"\n    def __init__(self, x: int, y: int):\n        self._x = x\n        self._y = y\n\n    def asTuple(self) -> tuple:\n        \"\"\"Returns the pair as a standard Python tuple.\"\"\"\n        return (self._x, self._y)\nclass TuplePair:\n    \"\"\"Encapsulates an input pair and offers normalization.\"\"\"\n    def __init__(self, a: int, b: int):\n        self._a = a\n        self._b = b\n\n    def normalize(self) -> NormalizedPair:\n        \"\"\"Normalizes the pair to ascending order and returns a NormalizedPair.\"\"\"\n        if self._a <= self._b:\n            return NormalizedPair(self._a, self._b)\n        else:\n            return NormalizedPair(self._b, self._a)\nclass OccurrenceDictionary:\n    \"\"\"Stores internal map of normalized tuples to counts.\"\"\"\n    def __init__(self):\n        self._map: dict[tuple, int] = {}\n\n    def increment(self, key_pair: NormalizedPair):\n        \"\"\"Increments the count for the given normalized key.\"\"\"\n        key_tuple = key_pair.asTuple()\n        self._map[key_tuple] = self._map.get(key_tuple, 0) + 1\n\n    def to_dict(self) -> dict:\n        \"\"\"Returns the internal mapping.\"\"\"\n        return self._map\nclass CheckOccurrences:\n    \"\"\"Orchestrates processing and collects results.\"\"\"\n    def __init__(self):\n        self._occurrences = OccurrenceDictionary()\n\n    def check_occurences(self, inputList: list[tuple]) -> dict:\n        \"\"\"Processes the list of tuples, normalizes, and aggregates counts.\"\"\"\n        for raw_tuple in inputList:\n            tuple_pair = TuplePair(raw_tuple[0], raw_tuple[1])\n            normalized_pair = tuple_pair.normalize()\n            self._occurrences.increment(normalized_pair)\n        return self._occurrences.to_dict()\ndef check_occurences(inputList: list[tuple]) -> dict:\n    \"\"\"\n    Takes a list of tuples and returns a dictionary mapping each unique normalized tuple\n    to its occurrence count. Tuples are normalized to ascending order (e.g., (3,1) becomes (1,3)).\n    assert check_occurences([(3, 1), (1, 3), (2, 5), (5, 2), (6, 3)] ) == {(1, 3): 2, (2, 5): 2, (3, 6): 1}\n    \"\"\"\n    orchestrator = CheckOccurrences()\n    return orchestrator.check_occurences(inputList)"}
{"task_id": "Mbpp/238", "solution": "def number_of_substrings(s: str) -> int:\n    \"\"\"Return count of non-empty substrings for input string s.\n\n    Uses integer arithmetic n*(n+1)//2, where n is the length of the string.\n    \"\"\"\n    n = len(s)\n    return n * (n + 1) // 2"}
{"task_id": "Mbpp/240", "solution": "def replace_list(list1, list2):\n    \"\"\"Replaces the last element of the first list with the elements of the second list, returning a new list.\n    Ensures immutability of input lists and handles empty first lists by returning a copy of the second.\n    \"\"\"\n    if not isinstance(list1, list) or not isinstance(list2, list):\n        raise TypeError(\"Both list1 and list2 must be instances of list.\")\n\n    if not list1:\n        return list(list2)\n    else:\n        return list1[:-1] + list(list2)"}
{"task_id": "Mbpp/242", "solution": "class InputString:\n    def __init__(self, value: str):\n        self.value: str = value\n    def length(self) -> int:\n        return len(self.value)\nclass Result:\n    def __init__(self, totalCharacters: int):\n        self.totalCharacters: int = totalCharacters\ndef count_charac(input_string: str) -> int:\n    \"\"\"Return total number of characters in input_string, including whitespace.\n\n    The count includes all characters present in the string.\n    \"\"\"\n    input_obj = InputString(input_string)\n    char_count = input_obj.length()\n    _ = Result(char_count) # For traceability, as per design\n    return char_count"}
{"task_id": "Mbpp/239", "solution": "class SequenceCounter:\n    \"\"\"\n    Computes number of valid sequences using deterministic DP/recursion with memoization.\n    It counts sequences of exact length starting from a given value.\n    \"\"\"\n    def __init__(self) -> None:\n        self._memo = {}\n\n    def countSequences(self, m: int, n: int) -> int:\n        \"\"\"\n        Public entry to count sequences of length n with elements in [1, m].\n        It sums counts from all possible starting values.\n        \"\"\"\n        total_sequences = 0\n        for start_value in range(1, m + 1):\n            # For each possible first element, count sequences of remaining length n-1\n            total_sequences += self._countFromStart(start_value, n - 1, m)\n        return total_sequences\n\n    def _countFromStart(self, current_value: int, remaining_length: int, m: int) -> int:\n        \"\"\"\n        Recursively computes number of valid sequence continuations.\n        The key for memoization is (current_value, remaining_length).\n        \"\"\"\n        memo_key = (current_value, remaining_length)\n        if memo_key in self._memo:\n            return self._memo[memo_key]\n\n        # Base case: If no more elements are needed, this path constitutes one valid sequence.\n        if remaining_length == 0:\n            return 1\n\n        count = 0\n        # Iterate over possible next elements, which must be >= 2 * current_value and <= m\n        min_next_value = current_value * 2\n        for next_value in range(min_next_value, m + 1):\n            count += self._countFromStart(next_value, remaining_length - 1, m)\n\n        self._memo[memo_key] = count\n        return count\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Finds the number of possible sequences of length n, such that each element is a positive integer\n    and is greater than or equal to twice the previous element but less than or equal to m.\n    \"\"\"\n    counter = SequenceCounter()\n    return counter.countSequences(m, n)"}
{"task_id": "Mbpp/244", "solution": "import math\ndef next_Perfect_Square(n: int) -> int:\n    \"\"\"Return the smallest perfect square strictly greater than n.\n\n    Preconditions: n is an int (per SRS).\n    Postconditions: returns integer m where exists k in Z: m == k*k and m > n.\n    \"\"\"\n    # Calculate the integer square root (floor) of n.\n    # For a perfect square p, this gives sqrt(p).\n    # For a non-perfect square n, this gives floor(sqrt(n)).\n    # The next perfect square will be (k+1)^2.\n    k = math.isqrt(n)\n    return (k + 1) ** 2"}
