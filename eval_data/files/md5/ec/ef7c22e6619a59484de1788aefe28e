{"task_id": "Mbpp/594", "solution": "from typing import List\ndef find_first_even(elements: List[int]) -> int:\n    \"\"\"Finds the first even number in the list.\"\"\"\n    for e in elements:\n        if e % 2 == 0:\n            return e\n    # Based on prompt, assume valid input where an even number is always found.\ndef find_first_odd(elements: List[int]) -> int:\n    \"\"\"Finds the first odd number in the list.\"\"\"\n    for e in elements:\n        if e % 2 != 0:\n            return e\n    # Based on prompt, assume valid input where an odd number is always found.\ndef diff_even_odd(elements: List[int]) -> int:\n    \"\"\"\n    Finds the difference of the first even and first odd number of a given list.\n    Assumes the list contains at least one even and one odd number.\n    \"\"\"\n    first_even = find_first_even(elements)\n    first_odd = find_first_odd(elements)\n    return first_even - first_odd"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n):\n    \"\"\"Calculates the sum and average of the first n natural numbers.\n    The sum is an integer and the average is a float.\"\"\"\n    sum_val = n * (n + 1) // 2\n    avg_val = sum_val / n\n    return (sum_val, avg_val)"}
{"task_id": "Mbpp/598", "solution": "from typing import List\nclass Number:\n    \"\"\"Encapsulates an integer value and provides methods for digit decomposition.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def digitCount(self) -> int:\n        \"\"\"Returns the count of digits in the number (0 has 1 digit).\"\"\"\n        if self.value == 0:\n            return 1\n        return len(str(abs(self.value)))\n\n    def extractDigits(self) -> List[int]:\n        \"\"\"Returns a list of digits in most-significant to least-significant order.\"\"\"\n        if self.value == 0:\n            return [0]\n        digits_str = str(abs(self.value))\n        return [int(d) for d in digits_str]\nclass ArmstrongChecker:\n    \"\"\"Provides methods to check if a number is an Armstrong number and compute its digit power sum.\"\"\"\n    def is_armstrong(self, number: 'Number') -> bool:\n        \"\"\"Checks if the given Number object represents an Armstrong number.\"\"\"\n        return self.computeDigitPowerSum(number) == number.value\n\n    def computeDigitPowerSum(self, number: 'Number') -> int:\n        \"\"\"Computes the sum of each digit raised to the power of the total digit count.\"\"\"\n        digits = number.extractDigits()\n        k = number.digitCount()\n        return sum(digit ** k for digit in digits)\ndef armstrong_number(n) -> bool:\n    \"\"\"Checks whether the given number is an Armstrong number.\n    Raises TypeError if input is not an integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"input must be int\")\n\n    number_obj = Number(value=n)\n    checker = ArmstrongChecker()\n    return checker.is_armstrong(number_obj)"}
{"task_id": "Mbpp/597", "solution": "from typing import List\ndef compute_kth(arr1: List[int], arr2: List[int], k: int) -> int:\n    \"\"\"Compute and return the k-th smallest element (1-based) from two sorted arrays.\"\"\"\n    m, n = len(arr1), len(arr2)\n    i, j = 0, 0\n    result = -1 \n\n    for _ in range(k):\n        if i < m and (j >= n or arr1[i] <= arr2[j]):\n            result = arr1[i]\n            i += 1\n        elif j < n: \n            result = arr2[j]\n            j += 1\n    return result\ndef find_kth(arr1: List[int], arr2: List[int], k: int) -> int:\n    \"\"\"Public API. Validates inputs and returns the k-th smallest element (1-based k).\"\"\"\n    validate_inputs(arr1, arr2, k)\n    return compute_kth(arr1, arr2, k)"}
{"task_id": "Mbpp/600", "solution": "def is_Even(number: int) -> bool:\n    \"\"\"Return True if `number` is even, False otherwise.\n    Precondition: `number` is an integer.\n    \"\"\"\n    return (number % 2) == 0"}
{"task_id": "Mbpp/602", "solution": "def first_repeated_char(s: str) -> str:\n    \"\"\"Return the first repeated character in s as a one-character string.\n    'First' is defined by the earliest index of the character's first occurrence among all characters that appear more than once.\n    \"\"\"\n    first_indices = {}\n    repeated_chars_set = set()\n\n    for i, char in enumerate(s):\n        if char not in first_indices:\n            first_indices[char] = i\n        else:\n            repeated_chars_set.add(char)\n\n    min_first_index = float('inf')\n    result_char = ''\n\n    for char in repeated_chars_set:\n        if first_indices[char] < min_first_index:\n            min_first_index = first_indices[char]\n            result_char = char\n\n    return result_char"}
{"task_id": "Mbpp/605", "solution": "import math\nclass InputValidator:\n    def isInteger(self, obj) -> bool:\n        \"\"\"Checks if the given object is an integer.\"\"\"\n        return isinstance(obj, int)\n\n    def isInRange(self, n: int) -> bool:\n        \"\"\"Checks if the integer n is greater than or equal to 2.\"\"\"\n        return n >= 2\nclass PrimeChecker:\n    def isPrime(self, n: int) -> bool:\n        \"\"\"Checks if the given integer n is a prime number.\"\"\"\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\ndef prime_num(n) -> bool:\n    \"\"\"\n    Checks if the given integer is a prime number.\n    Returns False for non-integer inputs or integers less than 2.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.isInteger(n):\n        return False\n    if not validator.isInRange(n):\n        return False\n\n    checker = PrimeChecker()\n    return checker.isPrime(n)"}
