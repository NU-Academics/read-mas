{"task_id": "Mbpp/566", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for invalid input to sum_digits function.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        return self.message\nclass InputNumber:\n    \"\"\"Encapsulates an input value and provides validation methods.\"\"\"\n    def __init__(self, value) -> None:\n        self.value = value\n\n    def is_integer(self) -> bool:\n        \"\"\"Checks if the encapsulated value is an integer.\"\"\"\n        return isinstance(self.value, int)\n\n    def is_non_negative(self) -> bool:\n        \"\"\"Checks if the encapsulated integer value is non-negative.\"\"\"\n        return self.value >= 0\nclass DigitExtractor:\n    \"\"\"Extracts base-10 digits from a positive integer.\"\"\"\n    def extract_digits(self, n: int) -> list[int]:\n        \"\"\"Returns a list of digits for the given positive integer.\"\"\"\n        digits = []\n        temp_n = n\n        while temp_n > 0:\n            digits.append(temp_n % 10)\n            temp_n //= 10\n        return digits[::-1]\nclass Summation:\n    \"\"\"Sums a list of integer digits.\"\"\"\n    def sum(self, digits: list[int]) -> int:\n        \"\"\"Computes the sum of a list of integers.\"\"\"\n        total = 0\n        for digit in digits:\n            total += digit\n        return total\ndef sum_digits(n: int) -> int:\n    \"\"\"Calculates the sum of the digits of a non-negative integer.\"\"\"\n    input_num = InputNumber(n)\n\n    if not input_num.is_integer():\n        raise ValidationError(f\"Input must be an integer, but received type {type(n).__name__}.\")\n\n    if not input_num.is_non_negative():\n        raise ValidationError(\"Input must be a non-negative integer.\")\n\n    if n == 0:\n        return 0\n\n    digit_extractor = DigitExtractor()\n    digits = digit_extractor.extract_digits(n)\n\n    summation = Summation()\n    return summation.sum(digits)"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(source, sub):\n    \"\"\"\n    Checks if 'sub' is a contiguous sublist of 'source'.\n    Raises TypeError if 'source' or 'sub' are not lists.\n    \"\"\"\n    if not isinstance(source, list) or not isinstance(sub, list):\n        raise TypeError(\"Both 'source' and 'sub' must be lists.\")\n\n    if not sub:\n        return True\n    if not source and sub:\n        return False\n\n    n = len(source)\n    m = len(sub)\n\n    for i in range(0, n - m + 1):\n        if source[i:i + m] == sub:\n            return True\n    return False"}
{"task_id": "Mbpp/573", "solution": "class UniqueNumber:\n    \"\"\"Represents a single distinct numeric value.\"\"\"\n    def __init__(self, value: 'number'):\n        self.value = value\n\n    def get(self) -> 'number':\n        \"\"\"Returns the numeric value.\"\"\"\n        return self.value\nclass NumberList:\n    \"\"\"Lightweight container for input elements, holding UniqueNumber instances.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = [UniqueNumber(e) for e in elements]\n\n    def as_list(self) -> list:\n        \"\"\"Returns the stored elements' values as a list of numbers.\"\"\"\n        return [un.get() for un in self.elements]\nclass Product:\n    \"\"\"Represents the computed product result.\"\"\"\n    def __init__(self, value: 'number'):\n        self.value = value\n\n    def get(self) -> 'number':\n        \"\"\"Returns the numeric product value.\"\"\"\n        return self.value\ndef compute_product(unique_values: list) -> 'number':\n    \"\"\"Computes the product of unique numeric values.\"\"\"\n    product = 1\n    for value in unique_values:\n        product *= value\n    return product\ndef unique_product(numbers: list) -> 'number':\n    \"\"\"\n    Calculates the product of the unique numbers in a given list.\n    \"\"\"\n    # Input validation is skipped as per the specific instruction to\n    # \"DO NOT add isinstance() checks or raise exceptions for edge cases\".\n    # validate_input(numbers) # This call is omitted.\n\n    number_list_obj = NumberList(numbers)\n    raw_numbers_from_list = number_list_obj.as_list()\n    \n    unique_numbers_set = set(raw_numbers_from_list)\n    unique_numbers_list = list(unique_numbers_set)\n\n    result_value = compute_product(unique_numbers_list)\n\n    final_product_obj = Product(result_value)\n    return final_product_obj.get()"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n):\n    \"\"\"Return the last decimal digit of n! as an int (0..9).\"\"\"\n    \n    if n >= 5:\n        return 0\n    \n    # Pre-calculated last digits for n! where n < 5\n    # 0! = 1, last digit 1\n    # 1! = 1, last digit 1\n    # 2! = 2, last digit 2\n    # 3! = 6, last digit 6\n    # 4! = 24, last digit 4\n    last_digits_map = {\n        0: 1,\n        1: 1,\n        2: 2,\n        3: 6,\n        4: 4\n    }\n    \n    return last_digits_map[n]"}
{"task_id": "Mbpp/578", "solution": "class ValidationError(ValueError):\n    \"\"\"Exception raised for validation errors in input lists.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef interleave_lists(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Raises ValidationError if input lists have different lengths.\n    \"\"\"\n    len1 = len(list1)\n    len2 = len(list2)\n    len3 = len(list3)\n\n    if not (len1 == len2 == len3):\n        raise ValidationError(\"Input lists must have the same length\")\n\n    result = []\n    for i in range(len1):\n        result.append(list1[i])\n        result.append(list2[i])\n        result.append(list3[i])\n\n    return result"}
{"task_id": "Mbpp/579", "solution": "from typing import Tuple\ndef find_dissimilar(t1: Tuple, t2: Tuple) -> Tuple:\n    \"\"\"\n    Finds elements present in exactly one of the two input tuples, preserving order.\n    Elements from t1 are listed first, followed by elements from t2.\n    \"\"\"\n    result_elements = []\n\n    # Create sets for efficient membership testing.\n    # These sets store unique elements for fast lookups (average O(1)).\n    set_t1 = set(t1)\n    set_t2 = set(t2)\n\n    # Iterate through t1 to find elements not in t2.\n    # This preserves the original order and duplicates from t1.\n    for element in t1:\n        if element not in set_t2:\n            result_elements.append(element)\n\n    # Iterate through t2 to find elements not in t1.\n    # This preserves the original order and duplicates from t2.\n    for element in t2:\n        if element not in set_t1:\n            result_elements.append(element)\n\n    return tuple(result_elements)"}
{"task_id": "Mbpp/580", "solution": "from typing import Any, Tuple\nclass Element:\n    \"\"\"Wrapper to provide element inspection helpers.\"\"\"\n    def __init__(self, value: Any):\n        self.value = value\n\n    def is_integer(self) -> bool:\n        \"\"\"Checks if the element is an integer.\"\"\"\n        return isinstance(self.value, int)\n\n    def is_tuple(self) -> bool:\n        \"\"\"Checks if the element is a tuple.\"\"\"\n        return isinstance(self.value, tuple)\nclass TupleProcessor:\n    \"\"\"Recursively traverses tuples and constructs output tuples, preserving order.\"\"\"\n    def process(self, t: tuple) -> tuple:\n        \"\"\"Processes a tuple, filtering odd integers and recursing into nested tuples.\"\"\"\n        result_elements = []\n        for item in t:\n            element = Element(item)\n            processed_sub_elements = self.process_element(element)\n            result_elements.extend(processed_sub_elements)\n        return tuple(result_elements)\n\n    def process_element(self, element: 'Element') -> tuple:\n        \"\"\"Processes a single element, returning a tuple of zero or more elements for composition.\"\"\"\n        if element.is_integer():\n            if element.value % 2 == 0:\n                return (element.value,)  # Keep even integer\n            else:\n                return ()  # Remove odd integer\n        elif element.is_tuple():\n            return (self.process(element.value),)  # Recurse into nested tuple\n        else:\n            # Preserve other types as-is, as they are not \"uneven elements\" to be removed.\n            return (element.value,)\nclass ExtractEven:\n    \"\"\"Fa\u00e7ade for orchestrating the tuple processing.\"\"\"\n    def __init__(self):\n        self._processor = TupleProcessor()\n\n    def extract_even(self, input_tuple: tuple) -> tuple:\n        \"\"\"Delegates tuple processing to the TupleProcessor.\"\"\"\n        return self._processor.process(input_tuple)\ndef extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"Public entry point to remove odd integers from a nested mixed tuple.\"\"\"\n    facade = ExtractEven()\n    return facade.extract_even(input_tuple)"}
{"task_id": "Mbpp/581", "solution": "class SurfaceAreaCalculator:\n    \"\"\"Calculates the surface area of a square pyramid.\"\"\"\n    def calculate(self, base_edge, slant_height):\n        # Formula: surface_area = base_edge**2 + 2 * base_edge * height\n        return base_edge**2 + 2 * base_edge * slant_height\ndef surface_Area(base_edge, height):\n    \"\"\"\n    Calculates the surface area of a square pyramid given its base edge and slant height.\n    The 'height' parameter is interpreted as the slant height for this calculation.\n    \"\"\"\n    calculator = SurfaceAreaCalculator()\n    # Per instructions, input validation (isinstance checks and exception raising)\n    # is omitted from this function's implementation.\n    surface_area_value = calculator.calculate(base_edge, height)\n    return surface_area_value"}
{"task_id": "Mbpp/583", "solution": "import datetime\nclass ErrorLog:\n    def __init__(self, id: int, message: str, timestamp: str):\n        self.id = id\n        self.message = message\n        self.timestamp = timestamp\nclass ErrorStore:\n    _entries: list[ErrorLog] = []\n    _next_id: int = 1\n\n    @classmethod\n    def log(cls, message: str) -> ErrorLog:\n        timestamp = datetime.datetime.now().isoformat()\n        log_entry = ErrorLog(cls._next_id, message, timestamp)\n        cls._entries.append(log_entry)\n        cls._next_id += 1\n        return log_entry\n\n    @classmethod\n    def get_all(cls) -> list[ErrorLog]:\n        return list(cls._entries)\nclass InputValidator:\n    def is_non_negative_integer(self, value) -> bool:\n        \"\"\"Checks if the given value is a non-negative integer.\"\"\"\n        return isinstance(value, int) and value >= 0\nclass CatalanCalculator:\n    def _binomial_coefficient(self, n: int, k: int) -> int:\n        \"\"\"Calculates binomial coefficient C(n, k) efficiently.\"\"\"\n        if k < 0 or k > n:\n            return 0\n        if k == 0 or k == n:\n            return 1\n        if k > n // 2:\n            k = n - k\n        \n        res = 1\n        for i in range(k):\n            res = res * (n - i) // (i + 1)\n        return res\n\n    def compute_by_formula(self, n: int) -> int:\n        \"\"\"Computes the nth Catalan number using the closed-form binomial formula C_n = C(2n, n) / (n + 1).\"\"\"\n        if n == 0:\n            return 1\n        \n        binom_2n_n = self._binomial_coefficient(2 * n, n)\n        return binom_2n_n // (n + 1)\n\n    def compute_by_dp(self, n: int) -> int:\n        \"\"\"Computes the nth Catalan number using dynamic programming (recurrence relation).\"\"\"\n        if n == 0:\n            return 1\n        \n        catalan = [0] * (n + 1)\n        catalan[0] = 1\n        \n        for i in range(1, n + 1):\n            for j in range(i):\n                catalan[i] += catalan[j] * catalan[i - j - 1]\n        \n        return catalan[n]\n\n    def catalan_number(self, n: int) -> int:\n        \"\"\"\n        Public method of CatalanCalculator, delegates to formula-based computation.\n        Formula-based computation is preferred for efficiency.\n        \"\"\"\n        return self.compute_by_formula(n)\ndef catalan_number(n):\n    \"\"\"\n    Computes the nth Catalan number.\n    Validates input and logs errors for invalid calls.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.is_non_negative_integer(n):\n        ErrorStore.log(f\"Invalid input for catalan_number: {n}. Must be a non-negative integer.\")\n        raise ValueError(\"Input must be a non-negative integer.\")\n    \n    calculator = CatalanCalculator()\n    value = calculator.catalan_number(n)\n    return value"}
